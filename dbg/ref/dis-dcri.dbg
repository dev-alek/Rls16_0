      153   ~
      154   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      155   procedure discfgru-check :
      156   define input parameter p-table-name as character no-undo .
      157   define input parameter p-templ-rl-root as integer no-undo .
      158   define input parameter p-time-templ-rl-root as integer no-undo .
      159   define input parameter p-pos-type as character no-undo .
      160   define output parameter p-disnct-role as character no-undo .
      161   define buffer buf_dis-cfg-rule for ub.dis-cfg-rule.
      162     do
      163     on error undo, return error return-value
      164     :
      165       find first buf_dis-cfg-rule no-lock where
      166               buf_dis-cfg-rule.table-name = p-table-name
      167           and buf_dis-cfg-rule.templ-rl-root = p-templ-rl-root
      168           and (p-time-templ-rl-root = ? or  buf_dis-cfg-rule.time-templ-rl-root = p-time-templ-rl-root)
      169           and buf_dis-cfg-rule.pos-type = p-pos-type no-error.
      170       if not available buf_dis-cfg-rule
      171       or p-pos-type = "":U
      172       then do:
      173          return error substitute("Для места использования типа &1 не определен тип скидки с шаблоном &2 &3"
      174                                  ,entry (lookup (p-pos-type, 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,r-keeper,InfoKiosk,pricecheck-Servis+,Emulator-NKT-IBM,MARIA,-,bo,Autotank':U), 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,R-KEEPER,InfoKiosk,Прайс-чекер Servis+,Emulator-NKT-IBM,MARIA,Накладная,Бэкофис,Autotank':U)
      175                                  , p-templ-rl-root
      176                                  , (if p-time-templ-rl-root = ?
      177                                     then '':U
      178                                     else substitute("с расписанием типа &1", p-time-templ-rl-root)
      179                                     )
      180                                  ).
      181       end.
      182       assign
      183       p-disnct-role = buf_dis-cfg-rule.discnt-role
      184       .
      185     end.
      186   end procedure.
      187   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      188   FUNCTION get-region RETURNS CHARACTER
      189     ( input parhost-code as integer, input parobj-type as character, input parobj-code as integer ) :
      190     define variable par-region as character no-undo.
      191     if parhost-code = 0 and
      192          parobj-type = "":U and
      193          parobj-code = 0 then do:
      194          par-region = "Глобально".
      195          return par-region.
      196       end.
      197       if parobj-type = 'орг':U then do:
      198          par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(parhost-code).
      199          return par-region.
      200       end.
      201       if parobj-type = 'регион':U
      202       then do:
      203          par-region = fill(chr(32), 2) + "Регион" + chr(32) + string(parobj-code).
      204          return par-region.
      205       end.
      206       par-region = fill(chr(32), 4) + parobj-type + chr(32) + string(parobj-code).
      207       return par-region.
      208   END FUNCTION.
      209   FUNCTION get-objregion RETURNS CHARACTER
      210     (  input parobj-type as character, input parobj-code as integer ) :
      211     define variable par-region as character no-undo.
      212     if  parobj-type = "":U and
      213         parobj-code = 0
      214     then do:
      215        par-region = "Глобально".
      216     end.
      217     else if parobj-type = 'орг':U
      218     then do:
      219        par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(parobj-code).
      220     end.
      221     else if parobj-type = 'регион':U
      222     then do:
      223        par-region = fill(chr(32), 2) + "Регион" + chr(32) + string(parobj-code).
      224     end.
      225     else
      226        par-region = fill(chr(32), 4) + parobj-type + chr(32) + string(parobj-code).
      227     return par-region.
      228   END FUNCTION.
      229   procedure disdcrul-name :
      230   define buffer buf_dis-rule for ub.dis-rule.
      231   do
      232     on error undo, return error
      233     :
      234     define input  parameter p-templ-rl-root  as integer no-undo .
      235     define output parameter p-label          as character no-undo .
      236     find first buf_dis-rule no-lock where
      237               buf_dis-rule.rule-num = p-templ-rl-root no-error.
      238     if available buf_dis-rule then do:
      239       if buf_dis-rule.rule-num > 0 then
      240       p-label = buf_dis-rule.des.
      241     end.
      242     else do:
      243       p-label = substitute("Неизвестный тип правила скидки &1", p-templ-rl-root).
      244     end.
      245   end.
      246   end procedure.
      247   function disdcrul-get-disc-label returns character ( input p-templ-rl-root as integer):
      248   define variable v-rule-label as character no-undo .
      249   run disdcrul-name in this-procedure ( input p-templ-rl-root
      250                                        ,output v-rule-label) no-error.
      251   return v-rule-label.
      252   end function.
      253   function disdcrul-get-disc-role-label returns character ( input p-discnt-role as character):
      254   define variable v-rule-label as character no-undo .
      255   return entry (lookup (p-discnt-role, 'debet-pay-pcnt-disc,debet-pay-abs-disc,debet-pay-qnty-disc,debet-pay-sum-disc,debet-pay-free-disc,dc-d-pcnt,dc-cash-d-pcnt,credit-pay-pcnt-disc,credit-pay-abs-disc,credit-pay-qnty-disc,credit-pay-sum-disc,credit-pay-free-disc':u) + 1, ',' + '% Скидка при оплате топлива по дебет.ведомости,ABS Скидка при оплате топлива по дебет.ведомости,Скидка на кол-во при оплате топлива по дебет.ведомости,Скидка на сумму при оплате топлива по дебет.ведомости,Своб скидка при оплате топлива по дебет.ведомости,% скидка на товар по ДК,% скидка на итог чека по ДК,% Скидка при оплате топлива по кредит.ведомости,Abs Скидка при оплате топлива по кредит.ведомости,Скидка на кол-во при оплате топлива по кредит.ведомости,Скидка на сумму при оплате топлива по кредит.ведомости,Своб Скидка на сумму при оплате топлива по кредит.ведомости':u).
      256   end function.
      257   procedure disdcrul-write :
      258     do
      259     on error undo, return error
      260     :
      261       define input parameter p-d-card         like ub.dis-dc-rule.d-card     no-undo .
      262       define input parameter p-host-code      like ub.dis-dc-rule.host-code  no-undo .
      263       define input parameter p-obj-type       like ub.dis-dc-rule.obj-type   no-undo .
      264       define input parameter p-obj-code       like ub.dis-dc-rule.obj-code   no-undo .
      265       define input parameter p-pos-type       like ub.dis-dc-rule.pos-type   no-undo .
      266       define input parameter p-discnt-role    like ub.dis-dc-rule.discnt-role no-undo .
      267       define input parameter p-templ-rl-root  like ub.dis-dc-rule.templ-rl-root  no-undo .
      268       define input parameter p-time-templ-rl-root  like ub.dis-dc-rule.time-templ-rl-root  no-undo .
      269       define input parameter p-rule-num       like ub.dis-dc-rule.rule-num    no-undo .
      270       define input parameter p-nonunique      like ub.dis-dc-rule.nonunique   no-undo .
      271       define buffer buf_dis-rule for ub.dis-rule.
      272       define buffer buf_dis-dc-rule for ub.dis-dc-rule .
      273       define buffer lock_dis-dc-rule for ub.dis-dc-rule .
      274       define variable v-label          as character no-undo .
      275       define variable v-discnt-role as character no-undo .
      276       run discfgru-check in this-procedure (
      277                                             input 'dis-dc-rule':U
      278                                            ,input p-templ-rl-root
      279                                            ,input p-time-templ-rl-root
      280                                            ,input p-pos-type
      281                                            ,output v-discnt-role
      282                                             ) no-error .
      283       if error-status :error then do:
      284         undo, return error return-value .
      285       end.
      286       if p-discnt-role = ? then do:
      287         p-discnt-role = v-discnt-role.
      288       end.
      289       if p-discnt-role <> v-discnt-role then do:
      290         undo, return error substitute("ДК &1 Фирма &2 &3&4 место использ. &5 скидка типа &6&7не может быть по шаблону &8 и расписанию &9"
      291                                 ,p-d-card
      292                                 ,p-host-code
      293                                 ,p-obj-type
      294                                 ,p-obj-code
      295                                 ,p-pos-type
      296                                 ,entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u)
      297                                 ,chr(10)
      298                                 ,p-templ-rl-root
      299                                 ,p-rule-num).
      300       end.
      301       if p-pos-type = ? then do:
      302   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      303   define variable v-param-type5 as character no-undo .
      304   define variable v-value-date5 as date no-undo .
      305   define variable v-value-decimal5 as decimal no-undo .
      306   define variable v-value-integer5 as INTEGER no-undo .
      307   define variable v-value-logical5 AS LOGICAL no-undo .
      308   define variable v-tth5 as handle no-undo .
      309   run adm/shattri.p (
      310       input "get":U
      311       ,input  p-obj-type
      312       ,input  p-obj-code
      313       ,input  'cd-sending':U
      314       ,input  'dflt-cd':U
      315       ,output p-pos-type
      316       ,output v-value-date5
      317       ,output v-value-decimal5
      318       ,output v-value-integer5
      319       ,output v-value-logical5
      320       ,output v-param-type5
      321       ,INPUT-OUTPUT table-handle v-tth5
      322       )  .
      323   delete object v-tth5 no-error.
      324       end.
      325       find first buf_dis-rule no-lock where
      326                 buf_dis-rule.rule-num = p-rule-num no-error.
      327       if not available buf_Dis-rule then do:
      328         undo, return error substitute("ДК &1 Фирма &2 &3&4 место использ. &5 скидка типа &6&7не найдено правило скидки &8"
      329                                 ,p-d-card
      330                                 ,p-host-code
      331                                 ,p-obj-type
      332                                 ,p-obj-code
      333                                 ,p-pos-type
      334                                 ,entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u)
      335                                 ,chr(10)
      336                                 ,p-rule-num).
      337       end.
      338       if buf_dis-rule.root <> yes then do:
      339         undo, return error substitute("ДК &1 Фирма &2 &3&4 место использ. &5 скидка типа &6&7правило скидки &8 - некорневое"
      340                                 ,p-d-card
      341                                 ,p-host-code
      342                                 ,p-obj-type
      343                                 ,p-obj-code
      344                                 ,p-pos-type
      345                                 ,entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u)
      346                                 ,chr(10)
      347                                 ,p-rule-num).
      348       end.
      349       if not (p-host-code = buf_dis-rule.host-code
      350           and p-obj-type = buf_dis-rule.obj-type
      351           and p-obj-code = buf_dis-rule.obj-code)
      352       then do:
      353         undo, return error (substitute("ДК &1 Фирма &2 &3&4 место использ. &5 скидка типа &6&7правило скидки &8 - некорневое"
      354                                 ,p-d-card
      355                                 ,p-host-code
      356                                 ,p-obj-type
      357                                 ,p-obj-code
      358                                 ,p-pos-type
      359                                 ,entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u)
      360                                 ,chr(10)
      361                                 )
      362                             +
      363                             substitute("Правило скидки &1 определено для &2&3" +
      364                                        "а привязка к ДК для &4"
      365                                        ,buf_dis-rule.rule-num
      366                                        ,get-region( buf_Dis-rule.host-code, buf_dis-rule.obj-type, buf_Dis-rule.obj-code)
      367                                        ,chr(10)
      368                                        ,get-region( p-host-code, p-obj-type, p-obj-code)
      369                                        ))
      370                                 .
      371       end.
      372       find first buf_dis-dc-rule exclusive-lock where
      373                  buf_dis-dc-rule.d-card  = p-d-card
      374              AND buf_dis-dc-rule.obj-type  = p-obj-type
      375              AND buf_dis-dc-rule.host-code = p-host-code
      376              AND buf_dis-dc-rule.obj-code  = p-obj-code
      377              AND buf_dis-dc-rule.pos-type  = p-pos-type
      378              AND buf_dis-dc-rule.discnt-role = p-discnt-role
      379              and buf_dis-dc-rule.nonunique = p-nonunique
      380              no-error .
      381       if not available buf_dis-dc-rule then do:
      382         create buf_dis-dc-rule .
      383         assign
      384         buf_dis-dc-rule.d-card  = p-d-card
      385         buf_dis-dc-rule.host-code  = p-host-code
      386         buf_dis-dc-rule.obj-type  = p-obj-type
      387         buf_dis-dc-rule.obj-code  = p-obj-code
      388         buf_dis-dc-rule.pos-type = p-pos-type
      389         buf_dis-dc-rule.discnt-role = v-discnt-role
      390         buf_dis-dc-rule.rule-num = p-rule-num
      391         buf_dis-dc-rule.nonunique = p-nonunique
      392         no-error
      393         .
      394       end.
      395       ASSIGN
      396       buf_dis-dc-rule.time-templ-rl-root = p-time-templ-rl-root
      397       buf_dis-dc-rule.rule-num = p-rule-num
      398       buf_dis-dc-rule.rl-root = buf_Dis-rule.rl-root
      399       buf_dis-dc-rule.templ-rl-root = p-templ-rl-root
      400       buf_dis-dc-rule.nonunique = p-nonunique
      401       no-error.
      402     end.
      403   end procedure.
      404   procedure disdcrul-edit :
      405   define input parameter p-mode as character no-undo .
      406   define input parameter p-d-card   like ub.dis-dc-rule.d-card no-undo .
      407   define input parameter p-host-code like ub.dis-dc-rule.host-code no-undo .
      408   define input parameter p-obj-type like ub.dis-dc-rule.obj-type no-undo .
      409   define input parameter p-obj-code like ub.dis-dc-rule.obj-code no-undo .
      410   define input parameter p-pos-type like ub.dis-dc-rule.pos-type no-undo .
      411   define input parameter p-discnt-role like ub.dis-dc-rule.discnt-role no-undo .
      412   define input parameter p-templ-rl-root like ub.dis-dc-rule.templ-rl-root no-undo .
      413   define input parameter p-time-templ-rl-root like ub.dis-dc-rule.time-templ-rl-root no-undo .
      414   define input parameter p-cfg-nonunique as character no-undo .
      415   define input parameter p-check as integer no-undo .
      416   define input-output parameter p-rule-num as integer no-undo .
      417   define input-output parameter p-NONUNIQUE like ub.dis-cfg-rule.NONUNIQUE no-undo .
      418   define output parameter p-setted as logical no-undo .
      419   DEFINE VARIABLE v-value as character no-undo .
      420   define variable v-sts as integer no-undo .
      421   define variable v-rid-list as character no-undo .
      422   DEFINE VARIABLE v-rule-num as integer no-undo .
      423   define variable v-cd-dr-correct  as logical no-undo .
      424   define variable jj as integer no-undo .
      425   define variable conf-par as character no-undo .
      426   define variable conf-attr as character no-undo .
      427   define variable par-type as character no-undo .
      428   define variable dflt-cd as character no-undo .
      429   define variable v-cd-list as character no-undo .
      430   define variable v-is-time-rule as logical no-undo .
      431   define variable v-label as character no-undo .
      432   define variable v-nonunique as character no-undo .
      433   define variable v-mode as character no-undo .
      434   define buffer buf_dis-rule for ub.dis-rule.
      435   define buffer buf_dis-time-rule for ub.dis-time-rule .
      436   define buffer term_dis-rule for ub.dis-rule.
      437   define buffer buf_dis-dc-rule for ub.dis-dc-rule.
      438   define buffer buf_dis-cfg-rule for ub.dis-cfg-rule.
      439   define buffer buf_temp-odisc for temp-odisc.
      440   assign
      441   v-rule-num = p-rule-num.
      442   v-sts = integer('0':U).
      443   if v-rule-num <> 0
      444   and v-rule-num <> ?
      445   then do:
      446     find first buf_dis-rule no-lock where
      447               buf_dis-rule.rule-num = v-rule-num no-error .
      448     if error-status:error then do:
      449       message
      450       "Ошибка при поиске правила с номером" v-rule-num
      451       view-as alert-box error .
      452       return .
      453     end.
      454     assign
      455     v-rid-list = string(recid(buf_dis-rule))
      456     .
      457   end.
      458   run disdcrul-name in this-procedure (
      459                                 input p-templ-rl-root
      460                                 ,output v-label) no-error.
      461   if p-pos-type = ?
      462   or p-pos-type = '':U then do:
      463   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      464   define variable v-param-type6 as character no-undo .
      465   define variable v-value-date6 as date no-undo .
      466   define variable v-value-decimal6 as decimal no-undo .
      467   define variable v-value-integer6 as INTEGER no-undo .
      468   define variable v-value-logical6 AS LOGICAL no-undo .
      469   define variable v-tth6 as handle no-undo .
      470   run adm/shattri.p (
      471       input "get":U
      472       ,input  p-obj-type
      473       ,input  p-obj-code
      474       ,input  'cd-sending':U
      475       ,input  'dflt-cd':U
      476       ,output dflt-cd
      477       ,output v-value-date6
      478       ,output v-value-decimal6
      479       ,output v-value-integer6
      480       ,output v-value-logical6
      481       ,output v-param-type6
      482       ,INPUT-OUTPUT table-handle v-tth6
      483       )  .
      484   delete object v-tth6 no-error.
      485   end.
      486   else do:
      487     dflt-cd = p-pos-type.
      488   end.
      489   v-mode =  ('dis-dc-rule':U + "=" + p-discnt-role).
      490   run ref/dis-ruls.w (
      491               input parparentproc
      492               ,input p-host-code
      493               ,input p-obj-type
      494               ,input p-obj-code
      495               ,input "b-add,b-sel":U
      496               ,input v-mode
      497               ,input p-templ-rl-root
      498               ,input p-time-templ-rl-root
      499               ,input 0
      500               ,input-output v-sts
      501               ,input-output v-rid-list ) no-error .
      502   do
      503   on error undo, return error return-value
      504   :
      505     if v-rid-list <> "":U then do:
      506       find first buf_dis-rule exclusive-lock where
      507                   recid(buf_dis-rule) = integer(v-rid-list) no-wait no-error .
      508       if not available buf_dis-rule
      509       then do:
      510         message
      511         "Ошибка при поиске правила с recid" v-rid-list
      512         view-as alert-box error .
      513         return .
      514       end.
      515       if buf_dis-rule.sts <> integer('0':U) then do:
      516         message
      517         "Правило скидки имеет статус" entry (lookup (string(buf_dis-rule.sts), '0,1,2,99,98':U), 'исп,не-исп,детализ,удаление,запр.удал':U) skip
      518         "Нельзя привязать к нему скидку на ДК"
      519         view-as alert-box error .
      520         return .
      521       end.
      522       find first buf_dis-cfg-rule no-lock where
      523                buf_dis-cfg-rule.templ-rl-root =  buf_dis-rule.templ-rl-root
      524            and buf_dis-cfg-rule.time-templ-rl-root = (if buf_dis-rule.time-templ-rl-root = 0
      525                                                       then 0
      526                                                       else buf_dis-rule.time-templ-rl-root)
      527           and buf_dis-cfg-rule.pos-type = dflt-cd
      528           and buf_Dis-cfg-rule.table-name = 'dis-dc-rule':U
      529           no-error.
      530       if available buf_dis-cfg-rule then do:
      531         assign
      532         v-cd-dr-correct = yes
      533         .
      534       end.
      535       if not v-cd-dr-correct
      536       then do:
      537         message
      538         substitute("Правило скидки &1 неприменимо для касс &2.&3" +
      539                   "(АРМ АДМИНИСТРАТОР-Магазины(Фирмы)-Параметры-Общие опции коммуникации с кассами)"
      540                   ,buf_dis-rule.rule-num
      541                   ,dflt-cd
      542                   ,chr(10)
      543                   )
      544         view-as alert-box error .
      545         undo, return error .
      546       end.
      547       assign
      548       v-nonunique = if p-cfg-nonunique = '':U
      549                     then '':U
      550                     else string(buffer buf_Dis-rule:handle:buffer-field(p-cfg-nonunique):buffer-value).
      551       if p-check = 0
      552       or p-check = 2
      553       then do:
      554         find first buf_dis-dc-rule no-lock where
      555                     buf_dis-dc-rule.obj-type = p-obj-type
      556                 and buf_dis-dc-rule.obj-code = p-obj-code
      557                 and buf_dis-dc-rule.host-code = p-host-code
      558                 and buf_dis-dc-rule.d-card = p-d-card
      559                 and buf_dis-dc-rule.pos-type = p-pos-type
      560                 and buf_dis-dc-rule.discnt-role = p-discnt-role
      561                 and buf_dis-dc-rule.nonunique = v-nonunique no-error .
      562         if available buf_dis-dc-rule
      563         and p-mode <> 'ИЗМЕНЕНИЕ':U
      564         then do:
      565           message
      566           "Скидка такого типа на данную ДК уже существует"
      567           view-as alert-box error .
      568           return error.
      569         end.
      570       end.
      571       if p-check = 1
      572       or p-check = 2
      573       then do:
      574         find first buf_temp-odisc no-lock where
      575                     buf_temp-odisc.obj-type = p-obj-type
      576                 and buf_temp-odisc.obj-code = p-obj-code
      577                 and buf_temp-odisc.host-code = p-host-code
      578                 and buf_temp-odisc.d-card = p-d-card
      579                 and buf_temp-odisc.pos-type = p-pos-type
      580                 and buf_temp-odisc.templ-rl-root = p-templ-rl-root
      581                 and buf_temp-odisc.nonunique = v-nonunique no-error .
      582         if available buf_temp-odisc
      583         and buf_temp-odisc.rule-num <> 0
      584         and p-mode <> 'ИЗМЕНЕНИЕ':U
      585         then do:
      586           message
      587           "Скидка такого типа на данную ДК уже существует"
      588           view-as alert-box error .
      589           return error.
      590         end.
      591       end.
      592       if p-rule-num <> buf_dis-rule.rule-num then do:
      593         assign
      594         p-setted = yes
      595         p-rule-num = buf_dis-rule.rule-num
      596         p-nonunique = v-nonunique
      597         .
      598       end.
      599     end.
      600   end.
      601   end procedure.
      602   define variable updated as logical no-undo.
      603   DEFINE VARIABLE added  as logical no-undo .
      604   define variable add-option as CHARACTER no-undo.
      605   define variable ini-title as char no-undo.
      606   define variable temp-doc-rec as recid no-undo.
      607   define variable dops as character no-undo.
      608   define variable dopst as character no-undo.
      609   define variable v-tab-order as character no-undo .
      610   DEFINE VARIABLE dflt-cd AS CHARACTER NO-UNDO.
      611   define variable loc-glob as logical no-undo .
      612   define variable loc-firm as logical no-undo .
      613   define variable loc-object as logical no-undo .
      614   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      615   define variable send-ref as logical no-undo.
      616   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
      617     (input  'send-ref'
      618     ,input  0
      619     ,input  ''
      620     ,input  0
      621     ,input  ''
      622     ,input  ''
      623     ,input  ''
      624     ,input  no
      625     ,output dops
      626     ,output dopst
      627     ) no-error .
      628     send-ref = (IF error-status:error or dops <> "yes" then no else yes).
      629   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      630   define new shared temp-table dc-list no-undo like ub.dis-card
      631     field to-del as logical
      632     field order-num as integer
      633     field fdec as decimal
      634     field fint as integer
      635     field flog as logical
      636     field fchar as character
      637     index pi  is primary unique d-card
      638     index cn      card-num
      639     index cli cli-type cli-code
      640     index host-dscnt  emitent-host-code status_ d-pcnt
      641     index host-type  emitent-host-code type d-pcnt
      642     index oi order-num
      643     .
      644   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      645   define  new shared  temp-table dc-list-hist no-undo
      646   field list-table as character
      647   field id as integer
      648   field line as integer
      649   field hist-mode as character
      650   field des as character
      651   field num-recs as integer
      652   field option_ as character
      653   field item_ as character
      654   field status_ as character
      655   field num-add as integer
      656   field num-ignored as integer
      657   field done as logical
      658   field err_ as logical
      659   field err-mes as character
      660   index pi is primary
      661   id
      662   line
      663   index isdone
      664   done
      665   .
      666   DEFINE MENU MENU-b-add
      667          MENU-ITEM m_pos-type     LABEL "m_pos-type"
      668          MENU-ITEM m_no-pos       LABEL "По накладной"
      669          MENU-ITEM m_bo           LABEL "Бэкофис"      .
      670   DEFINE BUTTON b-add
      671        LABEL "&Добавить":L
      672        SIZE 10 BY 1 TOOLTIP "Добавить скидку ДК".
      673   DEFINE BUTTON b-chg
      674        LABEL "&Изменить":L
      675        SIZE 10 BY 1 TOOLTIP "Изменить скидку ДК".
      676   DEFINE BUTTON b-del
      677        LABEL "&Удалить":L
      678        SIZE 10 BY 1 TOOLTIP "Удалитиь  скидку ДК".
      679   DEFINE BUTTON B-exit AUTO-GO
      680        LABEL "&Ввод"
      681        SIZE 10 BY 1 TOOLTIP "Выход с сохранением".
      682   DEFINE BUTTON b-help
      683        LABEL "Помо&щь":L
      684        SIZE 3 BY 1.
      685   DEFINE BUTTON B-lookup
      686        LABEL "&Просмотр"
      687        SIZE 10 BY 1.
      688   DEFINE BUTTON b-quit AUTO-END-KEY
      689        LABEL "&Отмена":L
      690        SIZE 10 BY 1 TOOLTIP "Выход из режима".
      691   DEFINE VARIABLE card-cli-code AS INTEGER FORMAT ">>>>>>>>>":U INITIAL 0
      692         VIEW-AS TEXT
      693        SIZE 9.6 BY 1
      694        BGCOLOR 3 FGCOLOR 15  NO-UNDO.
      695   DEFINE VARIABLE card-cli-name AS CHARACTER FORMAT "X(60)":U
      696         VIEW-AS TEXT
      697        SIZE 61.6 BY 1
      698        BGCOLOR 3 FGCOLOR 15  NO-UNDO.
      699   DEFINE VARIABLE card-cli-type AS CHARACTER FORMAT "X(3)":U
      700         VIEW-AS TEXT
      701        SIZE 3.8 BY 1
      702        BGCOLOR 3 FGCOLOR 15  NO-UNDO.
      703   DEFINE VARIABLE card-emitent AS INTEGER FORMAT ">>,>>9":U INITIAL 0
      704        LABEL "Эмитент"
      705         VIEW-AS TEXT
      706        SIZE 16.4 BY 1
      707        BGCOLOR 3 FGCOLOR 15  NO-UNDO.
      708   DEFINE VARIABLE card-type AS CHARACTER FORMAT "X(16)":U
      709        LABEL "Тип карты"
      710         VIEW-AS TEXT
      711        SIZE 16.4 BY 1
      712        BGCOLOR 3 FGCOLOR 15  NO-UNDO.
      713   DEFINE VARIABLE f-d-card AS CHARACTER FORMAT "X(19)":U
      714         VIEW-AS TEXT
      715        SIZE 20 BY 1
      716        BGCOLOR 3 FGCOLOR 15  NO-UNDO.
      717   DEFINE QUERY br-dis-dc FOR
      718         temp-odisc SCROLLING.
      719   DEFINE BROWSE br-dis-dc
      720     QUERY br-dis-dc DISPLAY
      721         temp-odisc.templ-rl-root COLUMN-LABEL "" FORMAT ">9":U
      722   disdcrul-get-disc-label(temp-odisc.templ-rl-root) COLUMN-LABEL 'Тип скидки' FORMAT "X(255)":U WIDTH 50
      723   temp-odisc.rule-num COLUMN-LABEL "№ правила" FORMAT ">>>>>>>>9":U
      724   temp-odisc.rl-root COLUMN-LABEL "№ корн.!правила" FORMAT ">>>>>>>>9":U
      725   get-region(temp-odisc.host-code, temp-odisc.obj-type, temp-odisc.obj-code) COLUMN-LABEL "Действует" FORMAT "X(12)":U
      726   entry (lookup (temp-odisc.pos-type, 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,r-keeper,InfoKiosk,pricecheck-Servis+,Emulator-NKT-IBM,MARIA,-,bo,Autotank':U), 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,R-KEEPER,InfoKiosk,Прайс-чекер Servis+,Emulator-NKT-IBM,MARIA,Накладная,Бэкофис,Autotank':U) FORMAT "X(20)":U COLUMn-LABEL "Место использ."
      727       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 17.
      728   DEFINE FRAME Dialog-Frame
      729        B-exit AT ROW 1 COL 1
      730        b-quit AT ROW 1 COL 11
      731        b-add AT ROW 1 COL 21
      732        B-lookup AT ROW 1 COL 31
      733        b-chg AT ROW 1 COL 41
      734        b-del AT ROW 1 COL 51
      735        b-help AT ROW 1 COL 95
      736        br-dis-dc AT ROW 5 COL 1
      737        card-cli-name AT ROW 2 COL 2 NO-LABEL
      738        f-d-card AT ROW 3.3 COL 1.8 NO-LABEL
      739        card-cli-type AT ROW 3.3 COL 24.5 NO-LABEL
      740        card-cli-code AT ROW 3.3 COL 30 NO-LABEL
      741        card-type AT ROW 3.3 COL 40
      742        card-emitent AT ROW 3.3 COL 70 WIDGET-ID 2
      743        SPACE(3.60) SKIP(17.89)
      744       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      745            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      746            TITLE "Скидки ДК".
      747   ASSIGN
      748          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      749          FRAME Dialog-Frame:HIDDEN           = TRUE.
      750   ASSIGN
      751          b-add:POPUP-MENU IN FRAME Dialog-Frame       = MENU MENU-b-add:HANDLE.
      752   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      753   DO:
      754     APPLY "END-ERROR":U TO SELF.
      755   END.
      756   ON CHOOSE OF b-add IN FRAME Dialog-Frame
      757   DO:
      758     if p-pos-type <> '':U then do:
      759       if add-option = '':U then do:
      760         run gbl/pop-up.p ( input self:handle, input no) no-error.
      761       end.
      762       if add-option = '':U then return no-apply.
      763     end.
      764     run proc-add-chg in this-procedure ( input yes, input add-option ) no-error.
      765     if error-status:error then do:
      766       add-option = '':U.
      767       return no-apply.
      768     end.
      769     add-option = '':U.
      770   END.
      771   ON CHOOSE OF b-chg IN FRAME Dialog-Frame
      772   DO:
      773     if not avail temp-odisc then return no-apply.
      774     run proc-add-chg in this-procedure ( input no, input temp-odisc.pos-type) no-error .
      775     if error-status:error then return no-apply.
      776     OPEN QUERY br-dis-dc FOR EACH temp-odisc NO-LOCK.
      777   END.
      778   ON CHOOSE OF b-del IN FRAME Dialog-Frame
      779   DO:
      780   define variable loc#log as logical no-undo.
      781   define variable jj as integer no-undo .
      782   define variable v-rule-label as character no-undo .
      783     if not avail temp-odisc then return no-apply.
      784       run disdcrul-name in this-procedure
      785         (input  temp-odisc.templ-rl-root
      786         ,output v-rule-label
      787         ) no-error .
      788       if error-status :error then do:
      789         return no-apply .
      790       end.
      791     loc#log = no.
      792     message
      793     substitute("Вы уверены, что хотите удалить скидку &1 (место использ &2) для карты &3"
      794              ,temp-odisc.templ-rl-root
      795              ,entry (lookup (temp-odisc.pos-type, 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,r-keeper,InfoKiosk,pricecheck-Servis+,Emulator-NKT-IBM,MARIA,-,bo,Autotank':U), 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,R-KEEPER,InfoKiosk,Прайс-чекер Servis+,Emulator-NKT-IBM,MARIA,Накладная,Бэкофис,Autotank':U)
      796              ,p-d-card)
      797             view-as alert-box QUESTIOn buttons YES-NO update loc#log.
      798     if NOT loc#log then return no-apply.
      799     delete temp-odisc.
      800     updated = yes.
      801    OPEN QUERY br-dis-dc FOR EACH temp-odisc NO-LOCK.
      802   END.
      803   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
      804   DO:
      805     RUN proc-save IN THIS-PROCEDURE NO-ERROR.
      806     IF ERROR-STATUS:ERROR THEN DO:
      807        RETURN NO-APPLY.
      808     END.
      809   END.
      810   ON CHOOSE OF B-lookup IN FRAME Dialog-Frame
      811   DO:
      812     if not avail temp-odisc then return no-apply.
      813     RUN proc-b-lookup IN THIS-PROCEDURE NO-ERROR.
      814     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
      815   END.
      816   ON MOUSE-SELECT-DBLCLICK OF br-dis-dc IN FRAME Dialog-Frame
      817   DO:
      818     if not avail temp-odisc then return no-apply.
      819     RUN proc-b-lookup IN THIS-PROCEDURE NO-ERROR.
      820     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
      821   END.
      822   ON RETURN OF br-dis-dc IN FRAME Dialog-Frame
      823   DO:
      824     if not avail temp-odisc then return no-apply.
      825     RUN proc-b-lookup IN THIS-PROCEDURE NO-ERROR.
      826     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
      827   END.
      828   ON VALUE-CHANGED OF br-dis-dc IN FRAME Dialog-Frame
      829   DO:
      830     IF v-cntxt-db-num > 0
      831     AND (temp-odisc.obj-type = '':U
      832     OR temp-odisc.host-code = 0) THEN DO:
      833        DISABLE
      834        b-chg
      835        with FRAME Dialog-Frame.
      836     END.
      837     ELSE DO:
      838         enable
      839         b-chg WHEN (p-mode <> 'ПРОСМОТР':U)
      840         with FRAME Dialog-Frame.
      841     END.
      842   END.
      843   ON CHOOSE OF MENU-ITEM m_bo
      844   DO:
      845       add-option = 'bo':U.
      846     run proc-add-chg in this-procedure ( input yes, input add-option ) no-error.
      847     if error-status:error then do:
      848       add-option = '':U.
      849       return no-apply.
      850     end.
      851     add-option = '':U.
      852   END.
      853   ON CHOOSE OF MENU-ITEM m_no-pos
      854   DO:
      855     add-option = '-':U.
      856     run proc-add-chg in this-procedure ( input yes, input add-option ) no-error.
      857     if error-status:error then do:
      858       add-option = '':U.
      859       return no-apply.
      860     end.
      861     add-option = '':U.
      862   END.
      863   ON CHOOSE OF MENU-ITEM m_pos-type
      864   DO:
      865     add-option = dflt-cd.
      866     run proc-add-chg in this-procedure ( input yes, input add-option ) no-error.
      867     if error-status:error then do:
      868       add-option = '':U.
      869       return no-apply.
      870     end.
      871     add-option = '':U.
      872   END.
      873   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      874   on help of frame Dialog-Frame
      875   do:
      876     run gbl/app_help.p
      877       (input this-procedure :file-name
      878       ,input ''
      879       ,input ?
      880       ) no-error.
      881     if error-status :error then do:
      882       message
      883         "Ошибка при вызове помощи"
      884         error-status :get-message(1)
      885         view-as alert-box .
      886     end.
      887   end.
      888   run minbtn-set in this-procedure .
      889   on choose of b-help in frame Dialog-Frame
      890   do:
      891     apply "help":u to frame Dialog-Frame .
      892   end.
      893   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      894   procedure minbtn-set :
      895       do
      896           on error undo, return error return-value
      897           :
      898           define variable ii              as integer       no-undo .
      899           define variable fh              as widget-handle no-undo .
      900           define variable hh              as widget-handle no-undo .
      901           define variable v-h             as handle        extent 4 no-undo .
      902           define variable v-name-button   as character     no-undo .
      903           define variable v-help-old-x    as decimal       no-undo .
      904           define variable v-help-old-y    as decimal       no-undo .
      905           define variable v-help-old-size as decimal       no-undo .
      906           define variable v-frame-width   as decimal       no-undo .
      907           define variable jj              as integer       no-undo .
      908           do
      909               on error undo, return error
      910               :
      911               assign
      912                   v-frame-width = frame Dialog-Frame:width - 0.3
      913                   fh            = frame Dialog-Frame:first-child
      914                   hh            = fh:first-child
      915                   ii            = 1
      916                   .
      917               do while valid-handle(hh):
      918                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      919                   do:
      920                       case lc(hh:name) :
      921                           when "b-help" then
      922                               do:
      923                                   hh:load-image-up("cmp/b-help.bmp":u) .
      924                                   hh:load-image-down("cmp/b-help.bmp":u) .
      925                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      926                                   hh:TOOLTIP = "Помощь" .
      927                                   v-help-old-x = hh:column .
      928                                   v-help-old-y = hh:row    .
      929                                   v-help-old-size = hh:width .
      930                                   hh:width-chars = 2.5 .
      931                               end.
      932                           when "b-print" then
      933                               do:
      934                                   hh:load-image("cmp/b-print.bmp":u) .
      935                                   hh:TOOLTIP = "Печать" .
      936                                   v-h[ii] = hh:handle .
      937                                   ii = ii + 1 .
      938                                   hh:width-chars = 3 .
      939                               end.
      940                           when "b-history" or
      941                           when "b-hist" then
      942                               do:
      943                                   hh:load-image("cmp/b-hist.bmp":u) .
      944                                   hh:TOOLTIP = "История" .
      945                                   v-h[ii] = hh:handle .
      946                                   ii = ii + 1 .
      947                                   hh:width-chars = 3 .
      948                               end.
      949                           when "b-sch" then
      950                               do:
      951                                   hh:load-image("cmp/b-sch.bmp":u) .
      952                                   hh:TOOLTIP = "Установка Фильтра" .
      953                                   v-h[ii] = hh:handle .
      954                                   ii = ii + 1 .
      955                                   hh:width-chars = 3 .
      956                               end.
      957                           when "b-hist-user" then
      958                               do:
      959                                   hh:load-image("cmp/b-hist.bmp":u) .
      960                                   hh:TOOLTIP = "История пользователя" .
      961                                   ii = ii + 1 .
      962                               end.
      963                       end case.
      964                   end.
      965                   hh = hh:next-sibling.
      966               end.
      967               b-help:column = v-frame-width - b-help:width-chars.
      968               jj = 0.
      969               repeat ii = 4 to 1 by -1 :
      970                   if valid-handle (v-h[ii] ) then
      971                   do:
      972                       jj  = jj + 1 .
      973                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      974                       v-h[ii]:row    = v-help-old-y .
      975                   end.
      976               end.
      977           end.
      978       end.
      979   end procedure.
      980   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      981   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      982   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      983   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      984   define variable v-diasize-current-frame-width  as decimal   no-undo .
      985   define variable v-diasize-current-frame-height as decimal   no-undo .
      986   define variable v-diasize-change-size          as logical   no-undo .
      987   define variable v-diasize-resize-button        as handle    no-undo .
      988   define variable v-diasize-wndmax               as logical   no-undo .
      989   define variable v-diasize-wndstore             as logical   no-undo .
      990   define variable v-diasize-proc-name            as character no-undo .
      991   define variable v-diasize-browse-handle        as handle    no-undo .
      992   define variable v-diasize-browse-number        as integer   no-undo .
      993   define variable v-diasize-need-full-display    as logical   no-undo init false .
      994   define temp-table temp-diasize-handle no-undo
      995     field handle-value  as handle
      996     field save-position as decimal
      997     index xpk is primary unique handle-value
      998     .
      999   define temp-table temp-browse-handle no-undo
     1000     field browse-type   as character
     1001     field browse-number as integer
     1002     field browse-handle as handle
     1003     field original-size as decimal
     1004     index xpk is primary unique browse-type browse-number
     1005     index xie browse-type browse-handle
     1006   .
     1007   procedure diasize_change-height :
     1008     define input  parameter p-change-value  as decimal   no-undo .
     1009     define input  parameter p-move-resize   as logical   no-undo .
     1010     define variable v-field-group-handle    as handle    no-undo .
     1011     define variable v-object-handle         as handle    no-undo .
     1012     define variable v-frame-height          as decimal   no-undo .
     1013     define variable v-frame-virtual-height  as decimal   no-undo .
     1014     define variable v-browse-height         as decimal   no-undo .
     1015     define variable v-window-height         as decimal   no-undo .
     1016     define variable v-window-virtual-height as decimal   no-undo .
     1017     define variable v-change-sign           as integer   no-undo .
     1018     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1019     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1020     if p-change-value > 0
     1021     then do:
     1022       if frame Dialog-Frame :height + p-change-value
     1023           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1024       then do:
     1025         assign
     1026           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1027                           - (frame Dialog-Frame :height-chars)
     1028         .
     1029         if p-change-value <= 0
     1030         then do:
     1031           run diasize_position-resize-button in this-procedure .
     1032           return .
     1033         end.
     1034       end.
     1035     end.
     1036     if p-change-value < 0
     1037     then do:
     1038       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1039       then do:
     1040         assign
     1041           p-change-value = v-diasize-orig-frame-height
     1042                          - (frame Dialog-Frame :height-chars)
     1043         .
     1044         if p-change-value >= 0
     1045         then do:
     1046           run diasize_position-resize-button in this-procedure .
     1047           return .
     1048         end.
     1049       end.
     1050     end.
     1051     if p-change-value >= 0
     1052     then do:
     1053       assign
     1054         v-change-sign = 1
     1055       .
     1056     end.
     1057     else do:
     1058       assign
     1059         v-change-sign = -1
     1060       .
     1061     end.
     1062     assign
     1063       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1064     .
     1065     if p-change-value = 0
     1066     then do:
     1067       run diasize_position-resize-button in this-procedure .
     1068       return .
     1069     end.
     1070     move_block:
     1071     do
     1072     on error undo move_block, retry move_block
     1073     :
     1074       if retry
     1075       then do:
     1076         do
     1077         on error undo move_block, leave move_block
     1078         :
     1079           if p-change-value > 0
     1080           then do:
     1081             for each buf_temp-diasize-handle
     1082             on error undo, next
     1083             :
     1084               assign
     1085                 v-object-handle = buf_temp-diasize-handle.handle-value
     1086               .
     1087               if v-object-handle <> v-diasize-resize-button
     1088               then do:
     1089                 assign
     1090                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1091                 .
     1092               end.
     1093             end.
     1094             assign
     1095               v-diasize-browse-handle :height = v-browse-height
     1096             .
     1097             for each buf_temp-browse-handle
     1098               where buf_temp-browse-handle.browse-type = 'height':u
     1099             on error undo, next
     1100             :
     1101               assign
     1102                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1103               .
     1104             end.
     1105             assign
     1106               frame Dialog-Frame :height = v-frame-height
     1107             .
     1108             if frame Dialog-Frame :scrollable = true
     1109             then do:
     1110               assign
     1111                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1112               .
     1113             end.
     1114             run diasize_position-resize-button in this-procedure .
     1115           end.
     1116           else do:
     1117             if frame Dialog-Frame :scrollable = true
     1118             then do:
     1119               assign
     1120                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1121               .
     1122             end.
     1123             assign
     1124               frame Dialog-Frame :height = v-frame-height
     1125             .
     1126             assign
     1127               v-diasize-browse-handle :height = v-browse-height
     1128             .
     1129             for each buf_temp-browse-handle
     1130               where buf_temp-browse-handle.browse-type = 'height':u
     1131             on error undo, next
     1132             :
     1133               assign
     1134                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1135               .
     1136             end.
     1137             for each buf_temp-diasize-handle
     1138             on error undo, next
     1139             :
     1140               assign
     1141                 v-object-handle = buf_temp-diasize-handle.handle-value
     1142               .
     1143               if v-object-handle <> v-diasize-resize-button
     1144               then do:
     1145                 assign
     1146                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1147                 .
     1148               end.
     1149             end.
     1150             run diasize_position-resize-button in this-procedure .
     1151           end.
     1152           assign
     1153             v-diasize-change-size = false
     1154           .
     1155           leave move_block .
     1156         end.
     1157       end.
     1158       assign
     1159         v-diasize-need-full-display = true
     1160       .
     1161       if v-diasize-change-size = false
     1162       then do:
     1163         assign
     1164           v-diasize-change-size = true
     1165         .
     1166       end.
     1167       else do:
     1168         return .
     1169       end.
     1170       assign
     1171         v-frame-height = frame Dialog-Frame :height
     1172         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1173         v-browse-height = v-diasize-browse-handle :height
     1174       .
     1175       for each buf_temp-browse-handle
     1176         where buf_temp-browse-handle.browse-type = 'height':u
     1177       :
     1178         assign
     1179           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1180         .
     1181       end.
     1182       for each buf_temp-diasize-handle
     1183       :
     1184         delete buf_temp-diasize-handle .
     1185       end.
     1186       assign
     1187         v-field-group-handle = frame Dialog-Frame :first-child
     1188       .
     1189       do while valid-handle(v-field-group-handle)
     1190       :
     1191         assign
     1192           v-object-handle = v-field-group-handle :first-child
     1193         .
     1194         do while valid-handle(v-object-handle)
     1195         :
     1196           if  v-object-handle <> v-diasize-browse-handle :handle
     1197           and can-query(v-object-handle, "row")
     1198           and can-query(v-object-handle, "height")
     1199           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1200           then do:
     1201             find first buf_temp-browse-handle
     1202               where buf_temp-browse-handle.browse-type   = 'height':u
     1203                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1204               no-error .
     1205             if available buf_temp-browse-handle
     1206             then do:
     1207             end.
     1208             else do:
     1209               create buf_temp-diasize-handle .
     1210               assign
     1211                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1212                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1213               .
     1214             end.
     1215           end.
     1216           assign
     1217             v-object-handle = v-object-handle :next-sibling
     1218           .
     1219         end.
     1220         assign
     1221           v-field-group-handle = v-field-group-handle :next-sibling
     1222         .
     1223       end.
     1224       do with frame Dialog-Frame
     1225       :
     1226         hide v-diasize-resize-button .
     1227         assign
     1228           v-diasize-resize-button :row    = 1
     1229           v-diasize-resize-button :column = 1
     1230         .
     1231       end.
     1232       if p-change-value > 0
     1233       then do:
     1234         if frame Dialog-Frame :scrollable = true
     1235         then do:
     1236           assign
     1237             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1238             no-error .
     1239           if error-status :error
     1240           or error-status :get-message(1) <> ""
     1241           then do:
     1242             undo move_block, retry move_block .
     1243           end.
     1244         end.
     1245         assign
     1246           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1247           no-error .
     1248         if error-status :error
     1249         or error-status :get-message(1) <> ""
     1250         then do:
     1251           undo move_block, retry move_block .
     1252         end.
     1253         assign
     1254           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1255           no-error .
     1256         if error-status :error
     1257         or error-status :get-message(1) <> ""
     1258         then do:
     1259           undo move_block, retry move_block .
     1260         end.
     1261         for each buf_temp-browse-handle
     1262           where buf_temp-browse-handle.browse-type = 'height':u
     1263         on error undo move_block, retry move_block
     1264         :
     1265           assign
     1266             buf_temp-browse-handle.browse-handle :height
     1267               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1268             no-error .
     1269           if error-status :error
     1270           or error-status :get-message(1) <> ""
     1271           then do:
     1272             undo move_block, retry move_block .
     1273           end.
     1274         end.
     1275         for each buf_temp-diasize-handle
     1276         on error undo move_block, retry move_block
     1277         :
     1278           assign
     1279             v-object-handle = buf_temp-diasize-handle.handle-value
     1280           .
     1281           if v-object-handle <> v-diasize-resize-button
     1282           then do:
     1283             assign
     1284               v-object-handle :row = v-object-handle :row + p-change-value
     1285               no-error .
     1286             if error-status :error
     1287             or error-status :get-message(1) <> ""
     1288             then do:
     1289               undo move_block, retry move_block .
     1290             end.
     1291           end.
     1292         end.
     1293       end.
     1294       else do:
     1295         for each buf_temp-diasize-handle
     1296         on error undo move_block, retry move_block
     1297         :
     1298           assign
     1299             v-object-handle = buf_temp-diasize-handle.handle-value
     1300           .
     1301           if v-object-handle <> v-diasize-resize-button
     1302           then do:
     1303             assign
     1304               v-object-handle :row = v-object-handle :row + p-change-value
     1305               no-error .
     1306             if error-status :error
     1307             or error-status :get-message(1) <> ""
     1308             then do:
     1309               undo move_block, retry move_block .
     1310             end.
     1311           end.
     1312         end.
     1313         assign
     1314           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1315           no-error .
     1316         if error-status :error
     1317         or error-status :get-message(1) <> ""
     1318         then do:
     1319           undo move_block, retry move_block .
     1320         end.
     1321         for each buf_temp-browse-handle
     1322           where buf_temp-browse-handle.browse-type = 'height':u
     1323         on error undo move_block, retry move_block
     1324         :
     1325           assign
     1326             buf_temp-browse-handle.browse-handle :height
     1327               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1328             no-error .
     1329           if error-status :error
     1330           or error-status :get-message(1) <> ""
     1331           then do:
     1332             undo move_block, retry move_block .
     1333           end.
     1334         end.
     1335         assign
     1336           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1337           no-error .
     1338         if error-status :error
     1339         or error-status :get-message(1) <> ""
     1340         then do:
     1341           undo move_block, retry move_block .
     1342         end.
     1343         if frame Dialog-Frame :scrollable = true
     1344         then do:
     1345           assign
     1346             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1347             no-error .
     1348           if error-status :error
     1349           or error-status :get-message(1) <> ""
     1350           then do:
     1351             undo move_block, retry move_block .
     1352           end.
     1353         end.
     1354       end.
     1355       if p-move-resize = true
     1356       then do:
     1357         run diasize_position-resize-button in this-procedure .
     1358       end.
     1359       if v-diasize-wndstore = true
     1360       then do:
     1361         if connected("ub") = true
     1362         then do:
     1363           define variable v-cntxt-db-num        as integer   no-undo .
     1364           define variable v-cntxt-userid        as character no-undo .
     1365           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1366                                             , OUTPUT v-cntxt-userid
     1367                                             ) .
     1368           run gbl/wndsizew.p
     1369             (input  v-cntxt-db-num
     1370             ,input  v-cntxt-userid
     1371             ,input  v-diasize-proc-name
     1372             ,input  'height':u
     1373             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1374             ) .
     1375         end.
     1376       end.
     1377     end.
     1378     assign
     1379       v-diasize-change-size = false
     1380     .
     1381   end procedure.
     1382   procedure diasize_set-height :
     1383     define input  parameter p-new-height  as decimal   no-undo .
     1384     define input  parameter p-move-resize as logical   no-undo .
     1385     do
     1386     on error undo, return error return-value
     1387     :
     1388       run diasize_change-height in this-procedure
     1389         (input  (p-new-height - frame Dialog-Frame :height)
     1390         ,input  p-move-resize
     1391         ) .
     1392     end.
     1393   end procedure.
     1394   procedure diasize_change-width :
     1395     define input  parameter p-change-value as decimal   no-undo .
     1396     define input  parameter p-move-resize  as logical   no-undo .
     1397     define variable v-field-group-handle   as handle    no-undo .
     1398     define variable v-object-handle        as handle    no-undo .
     1399     define variable v-frame-width          as decimal   no-undo .
     1400     define variable v-frame-virtual-width  as decimal   no-undo .
     1401     define variable v-browse-width         as decimal   no-undo .
     1402     define variable v-window-width         as decimal   no-undo .
     1403     define variable v-window-virtual-width as decimal   no-undo .
     1404     define variable v-change-sign          as integer   no-undo .
     1405     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1406     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1407     if p-change-value > 0
     1408     then do:
     1409       if frame Dialog-Frame :width + p-change-value >
     1410           session :width-chars
     1411       then do:
     1412         assign
     1413           p-change-value = session :width-chars - frame Dialog-Frame :width
     1414         .
     1415         if p-change-value <= 0
     1416         then do:
     1417           run diasize_position-resize-button in this-procedure .
     1418           return .
     1419         end.
     1420       end.
     1421     end.
     1422     if p-change-value < 0
     1423     then do:
     1424       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1425       then do:
     1426         assign
     1427           p-change-value = v-diasize-orig-frame-width
     1428                          - frame Dialog-Frame :width
     1429         .
     1430         if p-change-value >= 0
     1431         then do:
     1432           run diasize_position-resize-button in this-procedure .
     1433           return .
     1434         end.
     1435       end.
     1436     end.
     1437     if p-change-value >= 0
     1438     then do:
     1439       assign
     1440         v-change-sign = 1
     1441       .
     1442     end.
     1443     else do:
     1444       assign
     1445         v-change-sign = -1
     1446       .
     1447     end.
     1448     assign
     1449       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1450     .
     1451     if p-change-value = 0
     1452     then do:
     1453       run diasize_position-resize-button in this-procedure .
     1454       return .
     1455     end.
     1456     move_block:
     1457     do
     1458     on error undo move_block, leave move_block
     1459     :
     1460       if retry
     1461       then do:
     1462         do
     1463         on error undo move_block, leave move_block
     1464         :
     1465           if p-change-value > 0
     1466           then do:
     1467             for each buf_temp-diasize-handle
     1468             on error undo, next
     1469             :
     1470               assign
     1471                 v-object-handle = buf_temp-diasize-handle.handle-value
     1472               .
     1473               if v-object-handle <> v-diasize-resize-button
     1474               then do:
     1475                 assign
     1476                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1477                 .
     1478               end.
     1479             end.
     1480             assign
     1481               v-diasize-browse-handle :width = v-browse-width
     1482             .
     1483             for each buf_temp-browse-handle
     1484               where buf_temp-browse-handle.browse-type = 'width':u
     1485             on error undo, next
     1486             :
     1487               assign
     1488                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1489               .
     1490             end.
     1491             assign
     1492               frame Dialog-Frame :width = v-frame-width
     1493             .
     1494             if frame Dialog-Frame :scrollable = true
     1495             then do:
     1496               assign
     1497                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1498               .
     1499             end.
     1500             run diasize_position-resize-button in this-procedure .
     1501           end.
     1502           else do:
     1503             if frame Dialog-Frame :scrollable = true
     1504             then do:
     1505               assign
     1506                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1507               .
     1508             end.
     1509             assign
     1510               frame Dialog-Frame :width = v-frame-width
     1511             .
     1512             for each buf_temp-browse-handle
     1513               where buf_temp-browse-handle.browse-type = 'width':u
     1514             on error undo, next
     1515             :
     1516               assign
     1517                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1518               .
     1519             end.
     1520             assign
     1521               v-diasize-browse-handle :width = v-browse-width
     1522             .
     1523             for each buf_temp-diasize-handle
     1524             on error undo, next
     1525             :
     1526               assign
     1527                 v-object-handle = buf_temp-diasize-handle.handle-value
     1528               .
     1529               if v-object-handle <> v-diasize-resize-button
     1530               then do:
     1531                 assign
     1532                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1533                 .
     1534               end.
     1535             end.
     1536             run diasize_position-resize-button in this-procedure .
     1537           end.
     1538           assign
     1539             v-diasize-change-size = false
     1540           .
     1541           leave move_block .
     1542         end.
     1543       end.
     1544       assign
     1545         v-diasize-need-full-display = true
     1546       .
     1547       if v-diasize-change-size = false
     1548       then do:
     1549         assign
     1550           v-diasize-change-size = true
     1551         .
     1552       end.
     1553       else do:
     1554         return .
     1555       end.
     1556       assign
     1557         v-frame-width = frame Dialog-Frame :width
     1558         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1559         v-browse-width = v-diasize-browse-handle :width
     1560       .
     1561       for each buf_temp-browse-handle
     1562         where buf_temp-browse-handle.browse-type = 'width':u
     1563       :
     1564         assign
     1565           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1566         .
     1567       end.
     1568       for each buf_temp-diasize-handle
     1569       :
     1570         delete buf_temp-diasize-handle .
     1571       end.
     1572       assign
     1573         v-field-group-handle = frame Dialog-Frame :first-child
     1574       .
     1575       do while valid-handle(v-field-group-handle)
     1576       :
     1577         assign
     1578           v-object-handle = v-field-group-handle :first-child
     1579         .
     1580         do while valid-handle(v-object-handle)
     1581         :
     1582           if  v-object-handle <> v-diasize-browse-handle :handle
     1583           and v-object-handle <> v-diasize-resize-button
     1584           and can-query(v-object-handle, "row")
     1585           and can-query(v-object-handle, "height")
     1586           and ( v-object-handle :col + v-object-handle :width
     1587                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1588               )
     1589           then do:
     1590             find first buf_temp-browse-handle
     1591               where buf_temp-browse-handle.browse-type   = 'width':u
     1592                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1593               no-error .
     1594             if available buf_temp-browse-handle
     1595             then do:
     1596             end.
     1597             else do:
     1598               create buf_temp-diasize-handle .
     1599               assign
     1600                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1601                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1602               .
     1603             end.
     1604           end.
     1605           assign
     1606             v-object-handle = v-object-handle :next-sibling
     1607           .
     1608         end.
     1609         assign
     1610           v-field-group-handle = v-field-group-handle :next-sibling
     1611         .
     1612       end.
     1613       do with frame Dialog-Frame
     1614       :
     1615         hide v-diasize-resize-button .
     1616         v-diasize-resize-button :row = 1.
     1617         v-diasize-resize-button :column = 1.
     1618       end.
     1619       if p-change-value > 0
     1620       then do:
     1621         if frame Dialog-Frame :scrollable = true
     1622         then do:
     1623           assign
     1624             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1625             no-error .
     1626           if error-status :error
     1627           or error-status :get-message(1) <> ""
     1628           then do:
     1629             undo move_block, retry move_block.
     1630           end.
     1631         end.
     1632         assign
     1633           frame Dialog-Frame :width = v-frame-width + p-change-value
     1634           no-error .
     1635         if error-status :error
     1636         or error-status :get-message(1) <> ""
     1637         then do:
     1638           undo move_block, retry move_block.
     1639         end.
     1640         assign
     1641           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1642         no-error .
     1643         if error-status :error
     1644         or error-status :get-message(1) <> ""
     1645         then do:
     1646           undo move_block, retry move_block.
     1647         end.
     1648         for each buf_temp-browse-handle
     1649           where buf_temp-browse-handle.browse-type = 'width':u
     1650         on error undo move_block, retry move_block
     1651         :
     1652           assign
     1653             buf_temp-browse-handle.browse-handle :width
     1654               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1655             no-error .
     1656           if error-status :error
     1657           or error-status :get-message(1) <> ""
     1658           then do:
     1659             undo move_block, retry move_block .
     1660           end.
     1661         end.
     1662         for each buf_temp-diasize-handle
     1663         on error undo move_block, retry move_block
     1664         :
     1665           assign
     1666             v-object-handle = buf_temp-diasize-handle.handle-value
     1667           .
     1668           if v-object-handle <> v-diasize-resize-button
     1669           then do:
     1670             assign
     1671               v-object-handle :col = v-object-handle :col + p-change-value
     1672               no-error .
     1673             if error-status :error
     1674             or error-status :get-message(1) <> ""
     1675             then do:
     1676               undo move_block, retry move_block .
     1677             end.
     1678           end.
     1679         end.
     1680       end.
     1681       else do:
     1682         for each buf_temp-diasize-handle
     1683         on error undo move_block, retry move_block
     1684         :
     1685           assign
     1686             v-object-handle = buf_temp-diasize-handle.handle-value
     1687           .
     1688           if v-object-handle <> v-diasize-resize-button
     1689           then do:
     1690             assign
     1691               v-object-handle :col = v-object-handle :col + p-change-value
     1692               no-error .
     1693             if error-status :error
     1694             or error-status :get-message(1) <> ""
     1695             then do:
     1696               undo move_block, retry move_block .
     1697             end.
     1698           end.
     1699         end.
     1700         for each buf_temp-browse-handle
     1701           where buf_temp-browse-handle.browse-type = 'width':u
     1702         on error undo move_block, retry move_block
     1703         :
     1704           assign
     1705             buf_temp-browse-handle.browse-handle :width
     1706               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1707             no-error .
     1708           if error-status :error
     1709           or error-status :get-message(1) <> ""
     1710           then do:
     1711             undo move_block, retry move_block .
     1712           end.
     1713         end.
     1714         assign
     1715           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1716           no-error .
     1717         if error-status :error
     1718         or error-status :get-message(1) <> ""
     1719         then do:
     1720           undo move_block, retry move_block.
     1721         end.
     1722         assign
     1723           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1724         no-error .
     1725         if error-status :error
     1726         or error-status :get-message(1) <> ""
     1727         then do:
     1728           undo move_block, retry move_block.
     1729         end.
     1730         if frame Dialog-Frame :scrollable = true
     1731         then do:
     1732           assign
     1733             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1734           no-error .
     1735           if error-status :error
     1736           or error-status :get-message(1) <> ""
     1737           then do:
     1738             undo move_block, retry move_block.
     1739           end.
     1740         end.
     1741       end.
     1742       if p-move-resize
     1743       then do:
     1744         run diasize_position-resize-button in this-procedure .
     1745       end.
     1746       if v-diasize-wndstore = true
     1747       then do:
     1748         if connected("ub") = true
     1749         then do:
     1750           define variable v-cntxt-db-num        as integer   no-undo .
     1751           define variable v-cntxt-userid        as character no-undo .
     1752           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1753                                             , OUTPUT v-cntxt-userid
     1754                                             ) .
     1755           run gbl/wndsizew.p
     1756             (input  v-cntxt-db-num
     1757             ,input  v-cntxt-userid
     1758             ,input  v-diasize-proc-name
     1759             ,input  'width':u
     1760             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1761             ) .
     1762         end.
     1763       end.
     1764     end.
     1765     assign
     1766       v-diasize-change-size = false
     1767     .
     1768   end procedure.
     1769   procedure diasize_set-width :
     1770     define input  parameter p-new-width  as decimal   no-undo .
     1771     define input  parameter p-move-resize as logical   no-undo .
     1772     do
     1773     on error undo, return error return-value
     1774     :
     1775       run diasize_change-width in this-procedure
     1776         (input  (p-new-width - frame Dialog-Frame :width)
     1777         ,input  p-move-resize
     1778         ) .
     1779     end.
     1780   end procedure.
     1781   procedure diasize_position-resize-button :
     1782     do with frame Dialog-Frame
     1783     :
     1784       hide v-diasize-resize-button .
     1785       assign
     1786         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1787                     - 1
     1788                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1789         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1790                     - 1
     1791                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1792       .
     1793       view v-diasize-resize-button .
     1794     end.
     1795   end procedure.
     1796   on alt-right anywhere
     1797   do:
     1798     run diasize_change-width in this-procedure
     1799       (input 1
     1800       ,input true
     1801       ) .
     1802     return no-apply .
     1803   end.
     1804   on alt-left anywhere
     1805   do:
     1806     run diasize_change-width in this-procedure
     1807       (input -1
     1808       ,input true
     1809       ) .
     1810     return no-apply .
     1811   end.
     1812   on alt-down anywhere
     1813   do:
     1814     run diasize_change-height in this-procedure
     1815       (input 1
     1816       ,input true
     1817       ) .
     1818     return no-apply .
     1819   end.
     1820   on alt-up anywhere
     1821   do:
     1822     run diasize_change-height in this-procedure
     1823       (input -1
     1824       ,input true
     1825       ) .
     1826     return no-apply .
     1827   end.
     1828   on alt-enter of frame Dialog-Frame
     1829   do:
     1830     run diasize_maximize in this-procedure
     1831       (input  ?
     1832       ).
     1833     return no-apply .
     1834   end.
     1835   procedure diasize_end-move :
     1836     do
     1837     on error undo, return error return-value
     1838     :
     1839       define variable v-row-delta as decimal   no-undo .
     1840       define variable v-col-delta as decimal   no-undo .
     1841       define variable v-new-row as decimal   no-undo .
     1842       define variable v-new-col as decimal   no-undo .
     1843       assign
     1844         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1845         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1846       .
     1847       assign
     1848         v-row-delta = v-new-row - frame Dialog-Frame :height
     1849         v-col-delta = v-new-col - frame Dialog-Frame :width
     1850       .
     1851       run diasize_change-height in this-procedure
     1852         (input v-row-delta
     1853         ,input true
     1854         ) .
     1855       run diasize_change-width in this-procedure
     1856         (input v-col-delta
     1857         ,input true
     1858         ) .
     1859     end.
     1860   end procedure.
     1861   procedure diasize_maximize :
     1862     define input  parameter p-action as logical   no-undo .
     1863     do
     1864     on error undo, return error return-value
     1865     :
     1866       if p-action = ?
     1867       then do:
     1868         if v-diasize-need-maximize = true
     1869         then do:
     1870           assign
     1871             p-action = true
     1872           .
     1873         end.
     1874         else do:
     1875           assign
     1876             p-action = false
     1877           .
     1878         end.
     1879       end.
     1880       if p-action = true
     1881       then do:
     1882         run diasize_change-height in this-procedure
     1883           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1884               - frame Dialog-Frame :height-chars
     1885           ,input true
     1886           ) .
     1887         run diasize_change-width in this-procedure
     1888           (input session :width-chars
     1889               - frame Dialog-Frame :width-chars
     1890           ,input true
     1891           ) .
     1892         assign
     1893           v-diasize-need-maximize = false
     1894         .
     1895       end.
     1896       else do:
     1897         run diasize_change-width in this-procedure
     1898           (input v-diasize-orig-frame-width
     1899               - frame Dialog-Frame :width-chars
     1900           ,input true
     1901           ) .
     1902         run diasize_change-height in this-procedure
     1903           (input v-diasize-orig-frame-height
     1904               - frame Dialog-Frame :height-chars
     1905           ,input true
     1906           ) .
     1907         assign
     1908           v-diasize-need-maximize = true
     1909         .
     1910       end.
     1911     end.
     1912   end procedure.
     1913   procedure diasize_restore-orig-size :
     1914     do
     1915     on error undo, return error return-value
     1916     :
     1917       assign
     1918         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1919         v-diasize-current-frame-height = frame Dialog-Frame :height
     1920       .
     1921       run diasize_set-height in this-procedure
     1922         (input  v-diasize-orig-frame-height
     1923         ,input  true
     1924         ) .
     1925       run diasize_set-width in this-procedure
     1926         (input  v-diasize-orig-frame-width
     1927         ,input  true
     1928         ) .
     1929     end.
     1930   end procedure.
     1931   procedure diasize_restore-current-size :
     1932     do
     1933     on error undo, return error return-value
     1934     :
     1935       run diasize_set-height in this-procedure
     1936         (input  v-diasize-current-frame-height
     1937         ,input  true
     1938         ) .
     1939       run diasize_set-width in this-procedure
     1940         (input  v-diasize-current-frame-width
     1941         ,input  true
     1942         ) .
     1943     end.
     1944   end procedure.
     1945   procedure diasize_set-browse-handle :
     1946     define input  parameter p-browse-handle as handle   no-undo .
     1947     define buffer buf_temp-browse-handle for temp-browse-handle .
     1948     do
     1949     on error undo, return error return-value
     1950     :
     1951       assign
     1952         v-diasize-browse-handle = p-browse-handle
     1953       .
     1954       for each buf_temp-browse-handle
     1955       on error undo, return error return-value
     1956       :
     1957         delete buf_temp-browse-handle .
     1958       end.
     1959     end.
     1960   end procedure.
     1961   procedure diasize_add_browse :
     1962     define input  parameter p-browse-type   as character no-undo .
     1963     define input  parameter p-browse-handle as handle    no-undo .
     1964     define buffer buf_temp-browse-handle for temp-browse-handle .
     1965     do
     1966     on error undo, return error return-value
     1967     :
     1968       assign
     1969         v-diasize-browse-number = v-diasize-browse-number + 1
     1970       .
     1971       create buf_temp-browse-handle .
     1972       assign
     1973         buf_temp-browse-handle.browse-type   = p-browse-type
     1974         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1975         buf_temp-browse-handle.browse-handle = p-browse-handle
     1976       .
     1977     end.
     1978   end procedure.
     1979   procedure diasize_init :
     1980     define variable v-default-value    as logical   no-undo .
     1981     define variable v-restore-saved    as logical   no-undo .
     1982     define variable v-resize-value-str as character no-undo .
     1983     do
     1984     on error undo, return error return-value
     1985     :
     1986       do with frame Dialog-Frame
     1987       :
     1988         assign
     1989           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1990           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1991           v-diasize-browse-handle     = browse br-dis-dc :handle
     1992         .
     1993         create button v-diasize-resize-button
     1994         assign
     1995           parent        = frame Dialog-Frame :first-child
     1996           label         = "s"
     1997           height-pixels = 16
     1998           width-pixels  = 16
     1999           visible       = true
     2000           sensitive     = true
     2001           movable       = true
     2002           triggers:
     2003             on end-move persistent run diasize_end-move in this-procedure .
     2004           end triggers.
     2005         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2006         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2007         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2008         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2009         assign
     2010           v-diasize-wndmax = false
     2011         .
     2012         if connected("ub") = true
     2013         then do:
     2014           define variable v-cntxt-db-num        as integer   no-undo .
     2015           define variable v-cntxt-userid        as character no-undo .
     2016           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2017                                             , OUTPUT v-cntxt-userid
     2018                                             ) .
     2019           run gbl/wndpar_r.p
     2020             (input  v-cntxt-db-num
     2021             ,input  v-cntxt-userid
     2022             ,input  'wndmax':U
     2023             ,output v-diasize-wndmax
     2024             ,output v-default-value
     2025             ) .
     2026         end.
     2027         assign
     2028           v-diasize-wndstore = false
     2029         .
     2030         if connected("ub") = true
     2031         then do:
     2032           run gbl/wndpar_r.p
     2033             (input  v-cntxt-db-num
     2034             ,input  v-cntxt-userid
     2035             ,input  'wndstore':U
     2036             ,output v-diasize-wndstore
     2037             ,output v-default-value
     2038             ) .
     2039         end.
     2040         assign
     2041           v-diasize-proc-name = entry(1, program-name(2), '.')
     2042         .
     2043         if v-diasize-wndstore = true
     2044         then do:
     2045           assign
     2046             v-restore-saved = false
     2047           .
     2048           if connected("ub") = true
     2049           then do:
     2050             run gbl/wndsizer.p
     2051               (input  v-cntxt-db-num
     2052               ,input  v-cntxt-userid
     2053               ,input  v-diasize-proc-name
     2054               ,input  'height':u
     2055               ,output v-resize-value-str
     2056               ) .
     2057             if v-resize-value-str <> '':U
     2058             then do:
