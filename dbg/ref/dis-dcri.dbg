     2122   procedure get-context :
     2123      define output parameter p-db-num as integer          no-undo.
     2124      define output parameter p-user-id as character        no-undo.
     2125      define variable v-login               as character    no-undo.
     2126      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2127      define buffer buf_user-login  for ub.user-login .
     2128      do
     2129      on error undo, return error
     2130      :
     2131            FIND FIRST buf_sys-ctrl no-lock.
     2132            ASSIGN
     2133               v-login = USERID("ub")
     2134               p-db-num = buf_sys-ctrl.db-num
     2135            .
     2136            FIND FIRST buf_user-login
     2137                 WHERE buf_user-login.db-num = p-db-num
     2138                   AND buf_user-login.user-login = v-login
     2139                 no-lock
     2140                 no-error
     2141                 .
     2142            IF AVAILABLE buf_user-login
     2143            THEN DO:
     2144               assign
     2145                  p-user-id = buf_user-login.user-id
     2146               .
     2147            END.
     2148      end.
