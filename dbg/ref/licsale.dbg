      825     define buffer buf_temp-browse-handle  for temp-browse-handle .
      826     if p-change-value > 0
      827     then do:
      828       if frame f-alc-sale-lic :width + p-change-value >
      829           session :width-chars
      830       then do:
      831         assign
      832           p-change-value = session :width-chars - frame f-alc-sale-lic :width
      833         .
      834         if p-change-value <= 0
      835         then do:
      836           run diasize_position-resize-button in this-procedure .
      837           return .
      838         end.
      839       end.
      840     end.
      841     if p-change-value < 0
      842     then do:
      843       if frame f-alc-sale-lic :width + p-change-value < v-diasize-orig-frame-width
      844       then do:
      845         assign
      846           p-change-value = v-diasize-orig-frame-width
      847                          - frame f-alc-sale-lic :width
      848         .
      849         if p-change-value >= 0
      850         then do:
      851           run diasize_position-resize-button in this-procedure .
      852           return .
      853         end.
      854       end.
      855     end.
      856     if p-change-value >= 0
      857     then do:
      858       assign
      859         v-change-sign = 1
      860       .
      861     end.
      862     else do:
      863       assign
      864         v-change-sign = -1
      865       .
      866     end.
      867     assign
      868       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      869     .
      870     if p-change-value = 0
      871     then do:
      872       run diasize_position-resize-button in this-procedure .
      873       return .
      874     end.
