      809         ,input  p-move-resize
      810         ) .
      811     end.
      812   end procedure.
      813   procedure diasize_change-width :
      814     define input  parameter p-change-value as decimal   no-undo .
      815     define input  parameter p-move-resize  as logical   no-undo .
