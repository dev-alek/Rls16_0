        1   define input  parameter parparentproc  as widget-handle no-undo .
        2   define variable vss-revision    as character no-undo init "$Revision$":U .
        3   define variable vss-author      as character no-undo init "$Author$":U .
        4   define variable vss-date        as character no-undo init "$Date$":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        6   define variable vss-archive     as character no-undo init "$Archive$":U .
        7   define variable vss-description as character no-undo init "Справочник лицензий на продажу алкогольной продукции".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   define new global shared variable g#library  as handle no-undo .
       67   define new global shared variable g#library2 as handle no-undo .
       68   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       69     define variable v-cntxt-db-num        as integer   no-undo .
       70     define variable v-cntxt-userid        as character no-undo .
       71     define variable v-cntxt-level         as character no-undo .
       72     define variable v-cntxt-host-code-obj as integer   no-undo .
       73     define variable v-cntxt-obj-type      as character no-undo .
       74     define variable v-cntxt-obj-code      as integer   no-undo .
       75     define variable v-cntxt-db-num-obj    as integer   no-undo .
       76     define variable v-cntxt-is-admin      as logical   no-undo .
       77   procedure proc-alt-shift-f2:
       78     if not ibs.th.gbl.gbl-var:rcode
       79   then
       80     run gbl\inidebug.p .
       81   end.
       82   procedure proc-alt-shift-f3:
       83     run gbl/prvssinf.p
       84       ( input this-procedure
       85       ) .
       86   end.
       87   define variable v-inform-launched as logical no-undo initial false .
       88   procedure proc-alt-shift-f4:
       89     define variable v-action as character no-undo .
       90     if v-inform-launched = false then do:
       91       assign
       92         v-inform-launched = true
       93       .
       94       run gbl/d-inform.w
       95         (  input self
       96         ,  input this-procedure
       97         , output v-action
       98         ) no-error .
       99       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      100       assign
      101         v-inform-launched = false
      102       .
      103     end.
      104   end.
      105   procedure proc-alt-f1:
      106     run gbl/corrhelp.p
      107       (input this-procedure
      108       ) .
      109   end .
      110   on alt-shift-f2 anywhere do:
      111     run proc-alt-shift-f2.
      112   end.
      113   on alt-shift-f3 anywhere do:
      114     run proc-alt-shift-f3 in this-procedure .
      115   end.
      116   on alt-shift-f4 anywhere do:
      117     run proc-alt-shift-f4 in this-procedure.
      118   end.
      119   on alt-f1 anywhere do:
      120     run proc-alt-f1 in this-procedure .
      121   end.
      122   define variable log-res as log no-undo.
      123   define variable rr as recid no-undo.
      124   define variable v-log as logical   no-undo .
      125   define variable RowID-list as  character no-undo .
      126   define variable v-ok    as logical      no-undo.
      127   DEFINE variable p-cli-type     LIKE ub.alc-sale-lic.cli-type no-undo.
      128   DEFINE variable p-cli-code     LIKE ub.alc-sale-lic.cli-code no-undo.
      129   define stream ListStream .
      130   define variable sort-column-name as character no-undo .
      131   define buffer buf_alc-sale-lic for ub.alc-sale-lic.
      132   define buffer host_clients for ub.clients.
      133   DEFINE BUTTON b-add
      134        LABEL "&Добавить":L
      135        SIZE 10 BY 1.
      136   DEFINE BUTTON b-del
      137        LABEL "&Удалить"
      138        SIZE 10 BY 1.
      139   DEFINE BUTTON b-exit AUTO-GO
      140        LABEL "&Выход ":L
      141        SIZE 10 BY 1.
      142   DEFINE BUTTON b-help
      143        LABEL "Помо&щь":L
      144        SIZE 10 BY 1.
      145   DEFINE BUTTON b-hist
      146        LABEL "Ис&тория"
      147        SIZE 10 BY 1.
      148   DEFINE BUTTON b-print
      149        LABEL "Пе&чать"
      150        SIZE 3 BY .95.
      151   DEFINE BUTTON b-upd
      152        LABEL "&Изменить":L
      153        SIZE 10 BY 1.
      154   DEFINE QUERY br-alc-sale-lic FOR
      155         buf_alc-sale-lic SCROLLING.
      156   DEFINE BROWSE br-alc-sale-lic
      157     QUERY br-alc-sale-lic NO-LOCK DISPLAY
      158         buf_alc-sale-lic.date-from COLUMN-LABEL "c" FORMAT "99/99/9999":U
      159         buf_alc-sale-lic.date-to COLUMN-LABEL "по" FORMAT "99/99/9999":U
      160         buf_alc-sale-lic.number FORMAT "x(16)":U
      161         buf_alc-sale-lic.seria FORMAT "x(16)":U
      162         buf_alc-sale-lic.date-get FORMAT "99/99/9999":U
      163         buf_alc-sale-lic.who-are-got FORMAT "x(30)":U
      164         IF buf_alc-sale-lic.all-type > 0 THEN "+" ELSE "-" COLUMN-LABEL "На все типы"
      165       WITH SEPARATORS SIZE 54.6 BY 18.48
      166            BGCOLOR 15 FGCOLOR 0 .
      167   DEFINE FRAME f-alc-sale-lic
      168        b-exit AT ROW 1 COL 1
      169        b-print AT ROW 1 COL 33 WIDGET-ID 2
      170        b-hist AT ROW 1 COL 36
      171        b-help AT ROW 1 COL 46
      172        b-add AT ROW 2 COL 1
      173        b-upd AT ROW 2 COL 11
      174        b-del AT ROW 2 COL 21
      175        br-alc-sale-lic AT ROW 3.25 COL 1.63
      176        SPACE(0.11) SKIP(0.28)
      177       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      178            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      179            TITLE "Лицензии на продажу алкогольной продукции":L.
      180   ASSIGN
      181          FRAME f-alc-sale-lic:SCROLLABLE       = FALSE.
      182   ASSIGN
      183          br-alc-sale-lic:NUM-LOCKED-COLUMNS IN FRAME f-alc-sale-lic     = 3.
      184   ON CHOOSE OF b-add IN FRAME f-alc-sale-lic
      185   DO:
      186    assign
      187      rr = ?
      188    .
      189    run ref/licsalei.w ( parParentProc , 'ДОБАВЛЕНИЕ':U, input-output rr ).
      190    if rr <> ? then
      191       do:
      192           run refresh-query in this-procedure no-error.
      193            IF ERROR-STATUS:ERROR THEN DO:
      194               MESSAGE
      195                  "Пользователь не создан" skip
      196                  vss-workfile vss-revision vss-description skip
      197                  error-status :get-message(1) skip
      198                  return-value skip
      199               view-as alert-box error .
      200               undo, return NO-APPLY .
      201            END.
      202           reposition br-alc-sale-lic to recid rr.
      203           log-res  = br-alc-sale-lic:select-focused-row( ).
      204       end.
      205   END.
      206   ON CHOOSE OF b-del IN FRAME f-alc-sale-lic
      207   DO:
      208   define variable g-log as logical   no-undo .
      209   define variable v-recid as integer no-undo .
      210   define variable ii as integer no-undo .
      211   define buffer del_alc-sale-lic for ub.alc-sale-lic.
      212   if available buf_alc-sale-lic then do:
      213      message substitute("Удалить лицензию серия &1 №&2 ?", buf_alc-sale-lic.seria, buf_alc-sale-lic.number)
      214               view-as alert-box question
      215               buttons yes-no
      216               update g-log.
      217               if g-log = false then return no-apply.
      218      do transaction
      219         :
      220         find first del_alc-sale-lic
      221            where recid(del_alc-sale-lic)  = recid(buf_alc-sale-lic)
      222            exclusive-lock no-error .
      223         if available del_alc-sale-lic then do:
      224            delete del_alc-sale-lic.
      225         end.
      226      end.
      227   end.
      228   run refresh-query in this-procedure.
      229   END.
      230   ON CHOOSE OF b-hist IN FRAME f-alc-sale-lic
      231   DO:
      232      if available buf_alc-sale-lic THEN do:
      233         run ref/licsaleh.w
      234         ( input parParentProc ,
      235           input buf_alc-sale-lic.alc-sale-lic-code,
      236           input buf_alc-sale-lic.create-user-db-num
      237           ).
      238      end.
      239   END.
      240   ON CHOOSE OF b-print IN FRAME f-alc-sale-lic
      241   DO:
      242       run ref/p-licsa.p(input parparentproc, input p-cli-type, input p-cli-code).
      243   END.
      244   ON CHOOSE OF b-upd IN FRAME f-alc-sale-lic
      245   DO:
      246      if not available buf_alc-sale-lic
      247      then do:
      248         return no-apply.
      249      end.
      250      rr = recid( buf_alc-sale-lic ).
      251      run ref/licsalei.w ( parParentProc
      252                        , 'ИЗМЕНЕНИЕ':U
      253                        , input-output rr
      254                        ) .
      255      run refresh-query in this-procedure.
      256      reposition br-alc-sale-lic to recid rr .
      257    END.
      258   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME f-alc-sale-lic:PARENT eq ?
      259   THEN FRAME f-alc-sale-lic:PARENT = ACTIVE-WINDOW.
      260   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      261     run mainmenu_getcntxt in parparentproc
      262       (output v-cntxt-db-num
      263       ,output v-cntxt-userid
      264       ,output v-cntxt-level
      265       ,output v-cntxt-host-code-obj
      266       ,output v-cntxt-obj-type
      267       ,output v-cntxt-obj-code
      268       ,output v-cntxt-db-num-obj
      269       ,output v-cntxt-is-admin
      270       ) .
      271   define variable vss-include-info2 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      272   do:
      273     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      274       (input  v-cntxt-db-num
      275       ,input  v-cntxt-userid
      276       ,input  0
      277       ,input  'actn_lic-sale-lookup':U
      278       ,input  'object':U
      279       ,input  0
      280       ,input  v-cntxt-obj-type
      281       ,input  v-cntxt-obj-code
      282       ,input  0
      283       ,input  0
      284       ,input  0
      285       ,input  TRUE
      286       ,output v-ok
      287       )  .
      288   end.
      289       IF NOT v-ok then do:
      290          return.
      291       end.
      292   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      293   on help of frame f-alc-sale-lic
      294   do:
      295     run gbl/app_help.p
      296       (input this-procedure :file-name
      297       ,input ''
      298       ,input ?
      299       ) no-error.
      300     if error-status :error then do:
      301       message
      302         "Ошибка при вызове помощи"
      303         error-status :get-message(1)
      304         view-as alert-box .
      305     end.
      306   end.
      307   run minbtn-set in this-procedure .
      308   on choose of b-help in frame f-alc-sale-lic
      309   do:
      310     apply "help":u to frame f-alc-sale-lic .
      311   end.
      312   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      313   procedure minbtn-set :
      314       do
      315           on error undo, return error return-value
      316           :
      317           define variable ii              as integer       no-undo .
      318           define variable fh              as widget-handle no-undo .
      319           define variable hh              as widget-handle no-undo .
      320           define variable v-h             as handle        extent 4 no-undo .
      321           define variable v-name-button   as character     no-undo .
      322           define variable v-help-old-x    as decimal       no-undo .
      323           define variable v-help-old-y    as decimal       no-undo .
      324           define variable v-help-old-size as decimal       no-undo .
      325           define variable v-frame-width   as decimal       no-undo .
      326           define variable jj              as integer       no-undo .
      327           do
      328               on error undo, return error
      329               :
      330               assign
      331                   v-frame-width = frame f-alc-sale-lic:width - 0.3
      332                   fh            = frame f-alc-sale-lic:first-child
      333                   hh            = fh:first-child
      334                   ii            = 1
      335                   .
      336               do while valid-handle(hh):
      337                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      338                   do:
      339                       case lc(hh:name) :
      340                           when "b-help" then
      341                               do:
      342                                   hh:load-image-up("cmp/b-help.bmp":u) .
      343                                   hh:load-image-down("cmp/b-help.bmp":u) .
      344                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      345                                   hh:TOOLTIP = "Помощь" .
      346                                   v-help-old-x = hh:column .
      347                                   v-help-old-y = hh:row    .
      348                                   v-help-old-size = hh:width .
      349                                   hh:width-chars = 2.5 .
      350                               end.
      351                           when "b-print" then
      352                               do:
      353                                   hh:load-image("cmp/b-print.bmp":u) .
      354                                   hh:TOOLTIP = "Печать" .
      355                                   v-h[ii] = hh:handle .
      356                                   ii = ii + 1 .
      357                                   hh:width-chars = 3 .
      358                               end.
      359                           when "b-history" or
      360                           when "b-hist" then
      361                               do:
      362                                   hh:load-image("cmp/b-hist.bmp":u) .
      363                                   hh:TOOLTIP = "История" .
      364                                   v-h[ii] = hh:handle .
      365                                   ii = ii + 1 .
      366                                   hh:width-chars = 3 .
      367                               end.
      368                           when "b-sch" then
      369                               do:
      370                                   hh:load-image("cmp/b-sch.bmp":u) .
      371                                   hh:TOOLTIP = "Установка Фильтра" .
      372                                   v-h[ii] = hh:handle .
      373                                   ii = ii + 1 .
      374                                   hh:width-chars = 3 .
      375                               end.
      376                           when "b-hist-user" then
      377                               do:
      378                                   hh:load-image("cmp/b-hist.bmp":u) .
      379                                   hh:TOOLTIP = "История пользователя" .
      380                                   ii = ii + 1 .
      381                               end.
      382                       end case.
      383                   end.
      384                   hh = hh:next-sibling.
      385               end.
      386               b-help:column = v-frame-width - b-help:width-chars.
      387               jj = 0.
      388               repeat ii = 4 to 1 by -1 :
      389                   if valid-handle (v-h[ii] ) then
      390                   do:
      391                       jj  = jj + 1 .
      392                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      393                       v-h[ii]:row    = v-help-old-y .
      394                   end.
      395               end.
      396           end.
      397       end.
      398   end procedure.
      399   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      400   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      401   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      402   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      403   define variable v-diasize-current-frame-width  as decimal   no-undo .
      404   define variable v-diasize-current-frame-height as decimal   no-undo .
      405   define variable v-diasize-change-size          as logical   no-undo .
      406   define variable v-diasize-resize-button        as handle    no-undo .
      407   define variable v-diasize-wndmax               as logical   no-undo .
      408   define variable v-diasize-wndstore             as logical   no-undo .
      409   define variable v-diasize-proc-name            as character no-undo .
      410   define variable v-diasize-browse-handle        as handle    no-undo .
      411   define variable v-diasize-browse-number        as integer   no-undo .
      412   define variable v-diasize-need-full-display    as logical   no-undo init false .
      413   define temp-table temp-diasize-handle no-undo
      414     field handle-value  as handle
      415     field save-position as decimal
      416     index xpk is primary unique handle-value
      417     .
      418   define temp-table temp-browse-handle no-undo
      419     field browse-type   as character
      420     field browse-number as integer
      421     field browse-handle as handle
      422     field original-size as decimal
      423     index xpk is primary unique browse-type browse-number
      424     index xie browse-type browse-handle
      425   .
      426   procedure diasize_change-height :
      427     define input  parameter p-change-value  as decimal   no-undo .
      428     define input  parameter p-move-resize   as logical   no-undo .
      429     define variable v-field-group-handle    as handle    no-undo .
      430     define variable v-object-handle         as handle    no-undo .
      431     define variable v-frame-height          as decimal   no-undo .
      432     define variable v-frame-virtual-height  as decimal   no-undo .
      433     define variable v-browse-height         as decimal   no-undo .
      434     define variable v-window-height         as decimal   no-undo .
      435     define variable v-window-virtual-height as decimal   no-undo .
      436     define variable v-change-sign           as integer   no-undo .
      437     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      438     define buffer buf_temp-browse-handle  for temp-browse-handle .
      439     if p-change-value > 0
      440     then do:
      441       if frame f-alc-sale-lic :height + p-change-value
      442           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      443       then do:
      444         assign
      445           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      446                           - (frame f-alc-sale-lic :height-chars)
      447         .
      448         if p-change-value <= 0
      449         then do:
      450           run diasize_position-resize-button in this-procedure .
      451           return .
      452         end.
      453       end.
      454     end.
      455     if p-change-value < 0
      456     then do:
      457       if frame f-alc-sale-lic :height + p-change-value < v-diasize-orig-frame-height
      458       then do:
      459         assign
      460           p-change-value = v-diasize-orig-frame-height
      461                          - (frame f-alc-sale-lic :height-chars)
      462         .
      463         if p-change-value >= 0
      464         then do:
      465           run diasize_position-resize-button in this-procedure .
      466           return .
      467         end.
      468       end.
      469     end.
      470     if p-change-value >= 0
      471     then do:
      472       assign
      473         v-change-sign = 1
      474       .
      475     end.
      476     else do:
      477       assign
      478         v-change-sign = -1
      479       .
      480     end.
      481     assign
      482       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      483     .
      484     if p-change-value = 0
      485     then do:
      486       run diasize_position-resize-button in this-procedure .
      487       return .
      488     end.
      489     move_block:
      490     do
      491     on error undo move_block, retry move_block
      492     :
      493       if retry
      494       then do:
      495         do
      496         on error undo move_block, leave move_block
      497         :
      498           if p-change-value > 0
      499           then do:
      500             for each buf_temp-diasize-handle
      501             on error undo, next
      502             :
      503               assign
      504                 v-object-handle = buf_temp-diasize-handle.handle-value
      505               .
      506               if v-object-handle <> v-diasize-resize-button
      507               then do:
      508                 assign
      509                   v-object-handle :row = buf_temp-diasize-handle.save-position
      510                 .
      511               end.
      512             end.
      513             assign
      514               v-diasize-browse-handle :height = v-browse-height
      515             .
      516             for each buf_temp-browse-handle
      517               where buf_temp-browse-handle.browse-type = 'height':u
      518             on error undo, next
      519             :
      520               assign
      521                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      522               .
      523             end.
      524             assign
      525               frame f-alc-sale-lic :height = v-frame-height
      526             .
      527             if frame f-alc-sale-lic :scrollable = true
      528             then do:
      529               assign
      530                 frame f-alc-sale-lic :virtual-height = v-frame-virtual-height
      531               .
      532             end.
      533             run diasize_position-resize-button in this-procedure .
      534           end.
      535           else do:
