     1160       end.
     1161       if p-move-resize
     1162       then do:
     1163         run diasize_position-resize-button in this-procedure .
     1164       end.
     1165       if v-diasize-wndstore = true
     1166       then do:
     1167         if connected("ub") = true
     1168         then do:
     1169           define variable v-cntxt-db-num        as integer   no-undo .
     1170           define variable v-cntxt-userid        as character no-undo .
     1171           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1172                                             , OUTPUT v-cntxt-userid
     1173                                             ) .
     1174           run gbl/wndsizew.p
     1175             (input  v-cntxt-db-num
     1176             ,input  v-cntxt-userid
     1177             ,input  v-diasize-proc-name
     1178             ,input  'width':u
     1179             ,input  string(frame f-alc-sale-lic :width - v-diasize-orig-frame-width)
     1180             ) .
     1181         end.
     1182       end.
     1183     end.
     1184     assign
     1185       v-diasize-change-size = false
     1186     .
     1187   end procedure.
     1188   procedure diasize_set-width :
     1189     define input  parameter p-new-width  as decimal   no-undo .
     1190     define input  parameter p-move-resize as logical   no-undo .
     1191     do
     1192     on error undo, return error return-value
     1193     :
     1194       run diasize_change-width in this-procedure
     1195         (input  (p-new-width - frame f-alc-sale-lic :width)
     1196         ,input  p-move-resize
     1197         ) .
     1198     end.
     1199   end procedure.
     1200   procedure diasize_position-resize-button :
     1201     do with frame f-alc-sale-lic
     1202     :
     1203       hide v-diasize-resize-button .
     1204       assign
     1205         v-diasize-resize-button :row = frame f-alc-sale-lic :height - v-diasize-resize-button :height
     1206                     - 1
     1207                     - (frame f-alc-sale-lic :border-bottom-pixels / session :pixels-per-row)
     1208         v-diasize-resize-button :col = frame f-alc-sale-lic :width - v-diasize-resize-button :width
     1209                     - 1
     1210                     - (frame f-alc-sale-lic :border-right-pixels / session :pixels-per-column)
     1211       .
     1212       view v-diasize-resize-button .
     1213     end.
     1214   end procedure.
     1215   on alt-right anywhere
     1216   do:
     1217     run diasize_change-width in this-procedure
     1218       (input 1
     1219       ,input true
     1220       ) .
     1221     return no-apply .
     1222   end.
     1223   on alt-left anywhere
     1224   do:
     1225     run diasize_change-width in this-procedure
     1226       (input -1
     1227       ,input true
     1228       ) .
     1229     return no-apply .
     1230   end.
     1231   on alt-down anywhere
     1232   do:
     1233     run diasize_change-height in this-procedure
     1234       (input 1
     1235       ,input true
     1236       ) .
     1237     return no-apply .
     1238   end.
     1239   on alt-up anywhere
     1240   do:
     1241     run diasize_change-height in this-procedure
     1242       (input -1
     1243       ,input true
     1244       ) .
     1245     return no-apply .
     1246   end.
     1247   on alt-enter of frame f-alc-sale-lic
     1248   do:
     1249     run diasize_maximize in this-procedure
     1250       (input  ?
     1251       ).
     1252     return no-apply .
     1253   end.
     1254   procedure diasize_end-move :
     1255     do
     1256     on error undo, return error return-value
     1257     :
     1258       define variable v-row-delta as decimal   no-undo .
     1259       define variable v-col-delta as decimal   no-undo .
     1260       define variable v-new-row as decimal   no-undo .
     1261       define variable v-new-col as decimal   no-undo .
     1262       assign
     1263         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1264         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1265       .
     1266       assign
     1267         v-row-delta = v-new-row - frame f-alc-sale-lic :height
     1268         v-col-delta = v-new-col - frame f-alc-sale-lic :width
     1269       .
     1270       run diasize_change-height in this-procedure
     1271         (input v-row-delta
     1272         ,input true
     1273         ) .
     1274       run diasize_change-width in this-procedure
     1275         (input v-col-delta
     1276         ,input true
     1277         ) .
     1278     end.
     1279   end procedure.
     1280   procedure diasize_maximize :
     1281     define input  parameter p-action as logical   no-undo .
     1282     do
     1283     on error undo, return error return-value
     1284     :
     1285       if p-action = ?
     1286       then do:
     1287         if v-diasize-need-maximize = true
     1288         then do:
     1289           assign
     1290             p-action = true
     1291           .
     1292         end.
     1293         else do:
     1294           assign
     1295             p-action = false
     1296           .
     1297         end.
     1298       end.
     1299       if p-action = true
     1300       then do:
     1301         run diasize_change-height in this-procedure
     1302           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1303               - frame f-alc-sale-lic :height-chars
     1304           ,input true
     1305           ) .
     1306         run diasize_change-width in this-procedure
     1307           (input session :width-chars
     1308               - frame f-alc-sale-lic :width-chars
     1309           ,input true
     1310           ) .
     1311         assign
     1312           v-diasize-need-maximize = false
     1313         .
     1314       end.
     1315       else do:
     1316         run diasize_change-width in this-procedure
     1317           (input v-diasize-orig-frame-width
     1318               - frame f-alc-sale-lic :width-chars
     1319           ,input true
     1320           ) .
     1321         run diasize_change-height in this-procedure
     1322           (input v-diasize-orig-frame-height
     1323               - frame f-alc-sale-lic :height-chars
     1324           ,input true
     1325           ) .
     1326         assign
     1327           v-diasize-need-maximize = true
     1328         .
     1329       end.
     1330     end.
     1331   end procedure.
     1332   procedure diasize_restore-orig-size :
     1333     do
     1334     on error undo, return error return-value
     1335     :
     1336       assign
     1337         v-diasize-current-frame-width  = frame f-alc-sale-lic :width
     1338         v-diasize-current-frame-height = frame f-alc-sale-lic :height
     1339       .
     1340       run diasize_set-height in this-procedure
     1341         (input  v-diasize-orig-frame-height
     1342         ,input  true
     1343         ) .
     1344       run diasize_set-width in this-procedure
     1345         (input  v-diasize-orig-frame-width
     1346         ,input  true
     1347         ) .
     1348     end.
     1349   end procedure.
     1350   procedure diasize_restore-current-size :
     1351     do
     1352     on error undo, return error return-value
     1353     :
     1354       run diasize_set-height in this-procedure
     1355         (input  v-diasize-current-frame-height
     1356         ,input  true
     1357         ) .
     1358       run diasize_set-width in this-procedure
     1359         (input  v-diasize-current-frame-width
     1360         ,input  true
     1361         ) .
     1362     end.
     1363   end procedure.
     1364   procedure diasize_set-browse-handle :
     1365     define input  parameter p-browse-handle as handle   no-undo .
     1366     define buffer buf_temp-browse-handle for temp-browse-handle .
     1367     do
     1368     on error undo, return error return-value
     1369     :
     1370       assign
     1371         v-diasize-browse-handle = p-browse-handle
     1372       .
     1373       for each buf_temp-browse-handle
     1374       on error undo, return error return-value
     1375       :
     1376         delete buf_temp-browse-handle .
     1377       end.
     1378     end.
     1379   end procedure.
     1380   procedure diasize_add_browse :
     1381     define input  parameter p-browse-type   as character no-undo .
     1382     define input  parameter p-browse-handle as handle    no-undo .
     1383     define buffer buf_temp-browse-handle for temp-browse-handle .
     1384     do
     1385     on error undo, return error return-value
     1386     :
     1387       assign
     1388         v-diasize-browse-number = v-diasize-browse-number + 1
     1389       .
     1390       create buf_temp-browse-handle .
     1391       assign
     1392         buf_temp-browse-handle.browse-type   = p-browse-type
     1393         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1394         buf_temp-browse-handle.browse-handle = p-browse-handle
     1395       .
     1396     end.
     1397   end procedure.
     1398   procedure diasize_init :
     1399     define variable v-default-value    as logical   no-undo .
     1400     define variable v-restore-saved    as logical   no-undo .
     1401     define variable v-resize-value-str as character no-undo .
     1402     do
     1403     on error undo, return error return-value
     1404     :
     1405       do with frame f-alc-sale-lic
     1406       :
     1407         assign
     1408           v-diasize-orig-frame-height = frame f-alc-sale-lic :height
     1409           v-diasize-orig-frame-width  = frame f-alc-sale-lic :width
     1410           v-diasize-browse-handle     = browse br-alc-sale-lic :handle
     1411         .
     1412         create button v-diasize-resize-button
     1413         assign
     1414           parent        = frame f-alc-sale-lic :first-child
     1415           label         = "s"
     1416           height-pixels = 16
     1417           width-pixels  = 16
     1418           visible       = true
     1419           sensitive     = true
     1420           movable       = true
     1421           triggers:
     1422             on end-move persistent run diasize_end-move in this-procedure .
     1423           end triggers.
     1424         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1425         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1426         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1427         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1428         assign
     1429           v-diasize-wndmax = false
     1430         .
     1431         if connected("ub") = true
     1432         then do:
     1433           define variable v-cntxt-db-num        as integer   no-undo .
     1434           define variable v-cntxt-userid        as character no-undo .
     1435           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1436                                             , OUTPUT v-cntxt-userid
     1437                                             ) .
     1438           run gbl/wndpar_r.p
     1439             (input  v-cntxt-db-num
     1440             ,input  v-cntxt-userid
     1441             ,input  'wndmax':U
     1442             ,output v-diasize-wndmax
     1443             ,output v-default-value
     1444             ) .
     1445         end.
     1446         assign
     1447           v-diasize-wndstore = false
     1448         .
     1449         if connected("ub") = true
     1450         then do:
     1451           run gbl/wndpar_r.p
     1452             (input  v-cntxt-db-num
     1453             ,input  v-cntxt-userid
     1454             ,input  'wndstore':U
     1455             ,output v-diasize-wndstore
     1456             ,output v-default-value
     1457             ) .
     1458         end.
     1459         assign
     1460           v-diasize-proc-name = entry(1, program-name(2), '.')
     1461         .
     1462         if v-diasize-wndstore = true
     1463         then do:
     1464           assign
     1465             v-restore-saved = false
     1466           .
     1467           if connected("ub") = true
     1468           then do:
     1469             run gbl/wndsizer.p
     1470               (input  v-cntxt-db-num
     1471               ,input  v-cntxt-userid
     1472               ,input  v-diasize-proc-name
     1473               ,input  'height':u
     1474               ,output v-resize-value-str
     1475               ) .
     1476             if v-resize-value-str <> '':U
     1477             then do:
     1478               run diasize_change-height in this-procedure
     1479                 (input  integer(v-resize-value-str)
     1480                 ,input  true
     1481                 ) .
     1482               assign
     1483                 v-restore-saved = true
     1484               .
     1485             end.
     1486           end.
     1487           if connected("ub") = true
     1488           then do:
     1489             run gbl/wndsizer.p
     1490               (input  v-cntxt-db-num
     1491               ,input  v-cntxt-userid
     1492               ,input  v-diasize-proc-name
     1493               ,input  'width':u
     1494               ,output v-resize-value-str
     1495               ) .
     1496             if v-resize-value-str <> '':U
     1497             then do:
     1498               run diasize_change-width in this-procedure
     1499                 (input  integer(v-resize-value-str)
     1500                 ,input  true
     1501                 ) .
     1502               assign
     1503                 v-restore-saved = true
     1504               .
     1505             end.
     1506           end.
     1507           if v-restore-saved <> true
     1508           then do:
     1509             if v-diasize-wndmax = true
     1510             then do:
     1511               run diasize_maximize in this-procedure
     1512                 (input  true
     1513                 ) .
     1514             end.
     1515           end.
     1516         end.
     1517         else do:
     1518           if v-diasize-wndmax = true
     1519           then do:
     1520             run diasize_maximize in this-procedure
     1521               (input  true
     1522               ) .
     1523           end.
     1524         end.
     1525       end.
     1526     end.
     1527   end procedure.
     1528   procedure diasize_need-full-display :
     1529     define output parameter p-need-full-display as logical   no-undo .
     1530     do
     1531     on error undo, return error return-value
     1532     :
     1533       assign
     1534         p-need-full-display = v-diasize-need-full-display
     1535       .
     1536       assign
     1537         v-diasize-need-full-display = false
     1538       .
     1539     end.
     1540   end procedure.
     1541   procedure get-context :
     1542      define output parameter p-db-num as integer          no-undo.
     1543      define output parameter p-user-id as character        no-undo.
     1544      define variable v-login               as character    no-undo.
     1545      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1546      define buffer buf_user-login  for ub.user-login .
     1547      do
     1548      on error undo, return error
     1549      :
     1550            FIND FIRST buf_sys-ctrl no-lock.
     1551            ASSIGN
     1552               v-login = USERID("ub")
     1553               p-db-num = buf_sys-ctrl.db-num
     1554            .
     1555            FIND FIRST buf_user-login
     1556                 WHERE buf_user-login.db-num = p-db-num
     1557                   AND buf_user-login.user-login = v-login
     1558                 no-lock
     1559                 no-error
     1560                 .
     1561            IF AVAILABLE buf_user-login
     1562            THEN DO:
     1563               assign
     1564                  p-user-id = buf_user-login.user-id
     1565               .
     1566            END.
     1567      end.
     1568   end procedure.
     1569       run diasize_init in this-procedure .
     1570   ON WINDOW-CLOSE OF FRAME f-alc-sale-lic APPLY "END-ERROR":U TO SELF.
     1571   MAIN-BLOCK:
     1572   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1573      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1574       assign
     1575         p-cli-type = 'орг':U
     1576         p-cli-code = v-cntxt-host-code-obj
     1577       .
     1578       run enable_ui.
     1579       run post_enable_ui in this-procedure.
     1580       WAIT-FOR GO OF FRAME f-alc-sale-lic.
     1581   END.
     1582   run disable_ui.
     1583   PROCEDURE disable_UI :
     1584     HIDE FRAME f-alc-sale-lic.
     1585   END PROCEDURE.
     1586   PROCEDURE enable_UI :
     1587       ENABLE
     1588           br-alc-sale-lic
     1589           b-exit
     1590           b-add
     1591           b-upd
     1592           b-del
     1593           b-hist
     1594           b-help
     1595           b-print
     1596           WITH FRAME  f-alc-sale-lic.
     1597       if available buf_alc-sale-lic then
     1598           log-res  = br-alc-sale-lic:select-focused-row( ) in frame f-alc-sale-lic.
     1599        run refresh-query in this-procedure.
     1600   END PROCEDURE.
     1601   PROCEDURE post_enable_UI :
     1602   do
     1603   on error undo, return error
     1604   :
     1605   define variable vss-include-info6 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1606   do:
     1607     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1608       (input  v-cntxt-db-num
     1609       ,input  v-cntxt-userid
     1610       ,input  0
     1611       ,input  'actn_lic-sale-update':U
     1612       ,input  'object':U
     1613       ,input  0
     1614       ,input  v-cntxt-obj-type
     1615       ,input  v-cntxt-obj-code
     1616       ,input  0
     1617       ,input  0
     1618       ,input  0
     1619       ,input  false
     1620       ,output v-ok
     1621       )  .
     1622   end.
     1623       IF NOT v-ok then do:
     1624         DISABLE
     1625            b-add
     1626            b-upd
     1627            b-del
     1628         WITH FRAME  f-alc-sale-lic.
     1629       end.
     1630   end.
     1631   END PROCEDURE.
     1632   PROCEDURE refresh-query :
     1633   if p-cli-type = ?
     1634   or p-cli-code = ?
     1635   then do:
     1636    OPEN QUERY br-alc-sale-lic FOR EACH buf_alc-sale-lic NO-LOCK.
     1637   end.
     1638   else do:
     1639    OPEN QUERY br-alc-sale-lic FOR EACH buf_alc-sale-lic
     1640         WHERE buf_alc-sale-lic.cli-type = p-cli-type
     1641           AND buf_alc-sale-lic.cli-code = p-cli-code NO-LOCK.
     1642   end.
     1643   END PROCEDURE.
