        1   DEFINE TEMP-TABLE tt_ext-classif
        2     field Key#_Two    as integer
        3     field CharKey_One as character
        4     field CharKey_Two as character
        5     field CharKey_Three as character
        6     index pi CharKey_One
        7     .
        8   define input        parameter parparentproc as widget-handle no-undo .
        9   define input        parameter ref-mode      as character     no-undo .
       10   define input-output parameter rid           as recid         no-undo.
       11   define variable vss-revision    as character no-undo init "$Revision$":U .
       12   define variable vss-author      as character no-undo init "$Author$":U .
       13   define variable vss-date        as character no-undo init "$Date$":U .
       14   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       15   define variable vss-archive     as character no-undo init "$Archive$":U .
       16   define variable vss-description as character no-undo init "Форма редактирования основания документа".
       17   procedure vss-get-info :
       18     define output parameter p-vss-revision    like vss-revision    no-undo .
       19     define output parameter p-vss-author      like vss-author      no-undo .
       20     define output parameter p-vss-date        like vss-date        no-undo .
       21     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       22     define output parameter p-vss-archive     like vss-archive     no-undo .
       23     define output parameter p-vss-description like vss-description no-undo .
       24     assign
       25       p-vss-revision    = vss-revision
       26       p-vss-author      = vss-author
       27       p-vss-date        = vss-date
       28       p-vss-workfile    = vss-workfile
       29       p-vss-archive     = vss-archive
       30       p-vss-description = vss-description
       31     .
       32   end procedure.
       33   procedure vss-get-parameters :
       34     define output parameter p-vss-parameters as character no-undo .
       35   end procedure.
       36   define new global shared variable g#vssrevis-logger as handle    no-undo .
       37   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       38   define variable v-vssrevis-logger                   as handle    no-undo .
       39   procedure vss-logevent :
       40     define input  parameter p-extra-paramters as character no-undo .
       41     define variable v-vssrevis-parameters as character no-undo .
       42     do
       43     on error undo, return error return-value
       44     :
       45       if  valid-handle(v-vssrevis-logger)
       46       and v-vssrevis-logger :get-signature("logevent") <> ""
       47       then do:
       48         run vss-get-parameters in this-procedure
       49           (output v-vssrevis-parameters
       50           ).
       51         run logevent in v-vssrevis-logger
       52           (input vss-workfile
       53           ,input vss-revision
       54           ,input v-vssrevis-parameters
       55           ,input p-extra-paramters
       56           ).
       57       end.
       58     end.
       59   end procedure.
       60   assign
       61     v-vssrevis-logger = g#vssrevis-logger
       62   .
       63   if  valid-handle(v-vssrevis-logger)
       64   and v-vssrevis-logger :get-signature("logevent") <> ""
       65   then do:
       66     assign
       67       v-vssrevis-logevent = true
       68     .
       69     run vss-logevent in this-procedure (input vss-description) .
       70   end.
       71   define new global shared variable g#language as character no-undo .
       72   if g#language <> '' and g#language <> 'rus':U then do:
       73     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       74   end.
       75   procedure proc-alt-shift-f2:
       76     if not ibs.th.gbl.gbl-var:rcode
       77   then
       78     run gbl\inidebug.p .
       79   end.
       80   procedure proc-alt-shift-f3:
       81     run gbl/prvssinf.p
       82       ( input this-procedure
       83       ) .
       84   end.
       85   define variable v-inform-launched as logical no-undo initial false .
       86   procedure proc-alt-shift-f4:
       87     define variable v-action as character no-undo .
       88     if v-inform-launched = false then do:
       89       assign
       90         v-inform-launched = true
       91       .
       92       run gbl/d-inform.w
       93         (  input self
       94         ,  input this-procedure
       95         , output v-action
       96         ) no-error .
       97       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       98       assign
       99         v-inform-launched = false
      100       .
      101     end.
      102   end.
      103   procedure proc-alt-f1:
      104     run gbl/corrhelp.p
      105       (input this-procedure
      106       ) .
      107   end .
      108   on alt-shift-f2 anywhere do:
      109     run proc-alt-shift-f2.
      110   end.
      111   on alt-shift-f3 anywhere do:
      112     run proc-alt-shift-f3 in this-procedure .
      113   end.
      114   on alt-shift-f4 anywhere do:
      115     run proc-alt-shift-f4 in this-procedure.
      116   end.
      117   on alt-f1 anywhere do:
      118     run proc-alt-f1 in this-procedure .
      119   end.
      120   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      121   define buffer buf_ext-classif for ub.ext-classif .
      122   define buffer buf2_ext-classif for ub.ext-classif .
      123   define buffer buf_ext-classif1 for ub.ext-classif .
      124   DEFINE BUTTON b-cancel AUTO-END-KEY
      125     LABEL "&Отмена"
      126     SIZE 10 BY 1.
      127   DEFINE BUTTON b-OK AUTO-GO
      128     LABEL "&Ввод "
      129     SIZE 10 BY 1.
      130   DEFINE FRAME d-rvd-reason
      131     b-OK AT ROW 1 COL 1
      132     b-cancel AT ROW 1 COL 11
      133     tt_ext-classif.CharKey_One AT ROW 3 COL 4 format "X(64)"
      134       LABEL "Код"
      135       VIEW-AS FILL-IN
      136       SIZE 10 BY 1
      137     tt_ext-classif.Key#_Two AT ROW 3 COL 21
      138       LABEL "Тип"
      139       view-as combo-box inner-lines 2
      140       list-item-pairs "РГС",0,"ТРК",1
      141       DROP-DOWN-LIST
      142       size 7 by 1
      143     tt_ext-classif.CharKey_Two AT ROW 4.1 COL 4 format "X(255)"
      144       LABEL "Основание/причина"
      145       VIEW-AS fill-in
      146       SIZE 50 BY 1
      147     tt_ext-classif.CharKey_Three AT ROW 5.1 COL 4 format "X(255)"
      148       LABEL "Описание"
      149       VIEW-AS fill-in
      150       SIZE 59 BY 1
      151     SPACE(1) SKIP(1)
      152     WITH VIEW-AS DIALOG-BOX
      153     SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      154     TITLE "Основание".
      155   ASSIGN
      156     FRAME d-rvd-reason:SCROLLABLE = FALSE.
      157   ON CHOOSE OF b-OK IN FRAME d-rvd-reason
      158   DO:
      159     assign
      160       tt_ext-classif.Key#_Two
      161       tt_ext-classif.CharKey_One
      162       tt_ext-classif.CharKey_Two
      163       tt_ext-classif.CharKey_Three
      164     .
      165     if ref-mode = 'ДОБАВЛЕНИЕ':U
      166     then do :
      167       find first buf_ext-classif1 no-lock where buf_ext-classif1.CharKey_One = tt_ext-classif.CharKey_One
      168                                       and buf_ext-classif1.classif-subject = 'rvd-reason':U
      169                                       and buf_ext-classif1.classif-name = 'rvd-reason':U
      170                                       no-error .
      171       if available buf_ext-classif1 then
      172       do:
      173         message substitute( "Причина изменения режима ввода данных с кодом &1 уже существует!", tt_ext-classif.CharKey_One )
      174         view-as alert-box .
      175         return no-apply .
      176       end.
      177       create buf_ext-classif .
      178       assign
      179         buf_ext-classif.Key#_One        = 0
      180         buf_ext-classif.classif-subject = 'rvd-reason':U
      181         buf_ext-classif.classif-name    = 'rvd-reason':U
      182         buf_ext-classif.db-num          = 0
      183         buf_ext-classif.key#_three      = 0
      184         buf_ext-classif.nonunique       = 0
      185       .
      186     end .
      187     else do :
      188       find first buf_ext-classif1 no-lock where buf_ext-classif1.CharKey_One = tt_ext-classif.CharKey_One
      189                                       and buf_ext-classif1.classif-subject = 'rvd-reason':U
      190                                       and buf_ext-classif1.classif-name = 'rvd-reason':U
      191                                       and recid( buf_ext-classif1 ) <> rid
      192                                       no-error .
      193       if available buf_ext-classif1 then
      194       do:
      195         message substitute( "Причина изменения режима ввода данных с кодом &1 уже существует!", tt_ext-classif.CharKey_One )
      196         view-as alert-box .
      197         return no-apply .
      198       end.
      199       find first buf2_ext-classif exclusive-lock where recid( buf2_ext-classif ) = rid .
      200       create buf_ext-classif .
      201       buffer-copy buf2_ext-classif to buf_ext-classif
      202       assign buf_ext-classif.charkey_one = "-1" .
      203       delete buf2_ext-classif .
      204     end .
      205     assign
      206       buf_ext-classif.Key#_Two    = tt_ext-classif.Key#_Two
      207       buf_ext-classif.charkey_one = tt_ext-classif.CharKey_One
      208       buf_ext-classif.charkey_two = tt_ext-classif.CharKey_Two
      209       buf_ext-classif.charkey_three = tt_ext-classif.CharKey_Three
      210       buf_ext-classif.uniq-key-rec = 'rvd-reason':U + chr(3)
      211                                    + buf_ext-classif.charkey_one
      212     .
      213     rid = recid( buf_ext-classif ) .
      214     release buf_ext-classif .
      215   END.
      216   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME d-rvd-reason:PARENT eq ?
      217     THEN FRAME d-rvd-reason:PARENT = ACTIVE-WINDOW.
      218   ON WINDOW-CLOSE OF FRAME d-rvd-reason
      219     APPLY "END-ERROR":U TO SELF.
      220   MAIN-BLOCK:
      221   DO ON ERROR UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      222     ON END-KEY  UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      223     ON STOP     UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      224     empty temp-table tt_ext-classif .
      225     define variable v-code as integer no-undo .
      226     define variable v-max-code as integer no-undo .
      227     create tt_ext-classif.
      228     if ref-mode = 'ДОБАВЛЕНИЕ':U then
      229     do:
      230       assign
      231         rid = ?
      232       .
      233       v-max-code = 0 .
      234       for each buf_ext-classif no-lock where buf_ext-classif.classif-subject = 'rvd-reason':U
      235                                          and buf_ext-classif.classif-name = 'rvd-reason':U
      236                                          :
      237         v-code = integer(buf_ext-classif.CharKey_One) no-error .
      238         if not error-status:error
      239         then do :
      240           v-max-code = max(v-max-code, v-code) .
      241         end .
      242       end .
      243       v-max-code = v-max-code + 1 .
      244       assign
      245         tt_ext-classif.CharKey_One = string(v-max-code) .
      246       .
      247     end.
      248     else
      249     do:
      250       find first buf2_ext-classif exclusive-lock
      251         where recid( buf2_ext-classif ) = rid
      252         .
      253       assign
      254         tt_ext-classif.Key#_Two    = buf2_ext-classif.Key#_Two
      255         tt_ext-classif.CharKey_One = buf2_ext-classif.CharKey_One
      256         tt_ext-classif.CharKey_Two = buf2_ext-classif.CharKey_Two
      257         tt_ext-classif.CharKey_Three = buf2_ext-classif.CharKey_Three
      258       .
      259     end.
      260     RUN enable_UI.
      261     WAIT-FOR GO OF FRAME d-rvd-reason .
      262   END.
      263   RUN disable_UI.
      264   PROCEDURE disable_UI :
      265     HIDE FRAME d-rvd-reason.
      266   END PROCEDURE.
      267   PROCEDURE enable_UI :
      268     DISPLAY
      269       tt_ext-classif.Key#_Two
      270       tt_ext-classif.CharKey_One
      271       tt_ext-classif.CharKey_Two
      272       tt_ext-classif.CharKey_Three
      273     WITH FRAME d-rvd-reason.
      274     ENABLE
      275       b-OK
      276       b-cancel
      277       tt_ext-classif.Key#_Two
      278       tt_ext-classif.CharKey_One
      279       tt_ext-classif.CharKey_Two
      280       tt_ext-classif.CharKey_Three
      281     WITH FRAME d-rvd-reason.
      282   END PROCEDURE.
