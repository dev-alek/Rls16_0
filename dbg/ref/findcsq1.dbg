       12   define input parameter p-obj-type  like ub.fin-doc.obj-type no-undo .
       13   define input parameter p-obj-code  like ub.fin-doc.obj-code no-undo .
       14   define input parameter p-status_ like ub.fin-doc.status_ no-undo.
       15   define input parameter p-fin-doc-type like ub.fin-doc.fin-doc-type no-undo.
       16   define input parameter p-fin-ext-doc-type like ub.fin-doc.fin-ext-doc-type no-undo.
       17   define input parameter p-start-date   like ub.fin-doc.doc-date no-undo .
       18   define input parameter p-end-date   like ub.fin-doc.doc-date no-undo .
       19   define input parameter p-trn-doc-code like ub.fin-doc.trn-doc-code no-undo.
       20   define input parameter p-receiver-type like ub.fin-doc.receiver-type no-undo.
       21   define input parameter p-receiver-code like ub.fin-doc.receiver-code no-undo.
       22   define input parameter p-receiver-r-schet like ub.fin-doc.receiver-r-schet no-undo.
       23   define input parameter p-payer-type like ub.fin-doc.payer-type no-undo.
       24   define input parameter p-payer-code like ub.fin-doc.payer-code no-undo.
       25   define input parameter p-payer-r-schet like ub.fin-doc.payer-r-schet no-undo.
       26   define input parameter p-curr-code like ub.fin-doc.curr-code no-undo.
       27   define input parameter p-receiver-code-schet like ub.fin-doc.receiver-code-schet no-undo.
       28   define input parameter p-payer-code-schet like ub.fin-doc.payer-code-schet no-undo.
       29   define input parameter p-contract-code like ub.fin-doc.contract-code no-undo.
       30   define input parameter p-cor-acc like ub.fin-doc.cor-acc no-undo.
       31   define input parameter p-cor-acc1 like ub.fin-doc.cor-acc1 no-undo.
       32   define input parameter p-an-uchet-code like ub.fin-doc.an-uchet-code no-undo.
       33   define input parameter p-cel-nazn-code like ub.fin-doc.cel-nazn-code no-undo.
       34   define input-output param p-rid-list    as  character no-undo .
       35   define input parameter filter-point as character no-undo .
       36   define input parameter filter-point0 as character no-undo .
       37   define input parameter sort-column-name as character no-undo .
       38   define output parameter p-filter-name   as character  no-undo .
       39   define input-output parameter v-doc-rec as recid no-undo .
       40   define variable  vss-revision    as character no-undo init "$Revision$":U .
       41   define variable  vss-author      as character no-undo init "$Author$":U .
       42   define variable  vss-date        as character no-undo init "$Date$":U .
       43   define variable  vss-workfile    as character no-undo init "$Workfile$":U .
       44   define variable  vss-archive     as character no-undo init "$Archive$":U .
       45   define variable  vss-description as character no-undo init "Список банков  - открытие запроса".
       46   procedure vss-get-info :
       47     define output parameter p-vss-revision    like vss-revision    no-undo .
       48     define output parameter p-vss-author      like vss-author      no-undo .
       49     define output parameter p-vss-date        like vss-date        no-undo .
       50     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       51     define output parameter p-vss-archive     like vss-archive     no-undo .
       52     define output parameter p-vss-description like vss-description no-undo .
       53     assign
       54       p-vss-revision    = vss-revision
       55       p-vss-author      = vss-author
       56       p-vss-date        = vss-date
       57       p-vss-workfile    = vss-workfile
       58       p-vss-archive     = vss-archive
       59       p-vss-description = vss-description
       60     .
       61   end procedure.
       62   procedure vss-get-parameters :
       63     define output parameter p-vss-parameters as character no-undo .
       64   end procedure.
       65   define new global shared variable g#vssrevis-logger as handle    no-undo .
       66   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       67   define variable v-vssrevis-logger                   as handle    no-undo .
       68   procedure vss-logevent :
       69     define input  parameter p-extra-paramters as character no-undo .
       70     define variable v-vssrevis-parameters as character no-undo .
       71     do
       72     on error undo, return error return-value
       73     :
       74       if  valid-handle(v-vssrevis-logger)
       75       and v-vssrevis-logger :get-signature("logevent") <> ""
       76       then do:
       77         run vss-get-parameters in this-procedure
       78           (output v-vssrevis-parameters
       79           ).
       80         run logevent in v-vssrevis-logger
       81           (input vss-workfile
       82           ,input vss-revision
       83           ,input v-vssrevis-parameters
       84           ,input p-extra-paramters
       85           ).
       86       end.
       87     end.
       88   end procedure.
       89   assign
       90     v-vssrevis-logger = g#vssrevis-logger
       91   .
       92   if  valid-handle(v-vssrevis-logger)
       93   and v-vssrevis-logger :get-signature("logevent") <> ""
       94   then do:
       95     assign
       96       v-vssrevis-logevent = true
       97     .
       98     run vss-logevent in this-procedure (input vss-description) .
       99   end.
      100   define new global shared variable g#language as character no-undo .
      101   if g#language <> '' and g#language <> 'rus':U then do:
      102     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      103   end.
      104   define new global shared variable g#library  as handle no-undo .
      105   define new global shared variable g#library2 as handle no-undo .
      106   define   shared variable g#auto as logical no-undo.
      107   define   shared variable g#news as logical no-undo.
      108   define   shared variable g#oxml as logical no-undo.
      109   define   shared variable g#esys as logical no-undo.
      110   define   shared variable g#news-source-db as integer no-undo.
      111   define   shared variable g#esys-source-esys as integer no-undo.
      112   define   shared variable g#db-num as integer   no-undo .
      113   define   shared variable g#userid as character no-undo .
      114   define   shared variable g#passwd as character no-undo .
      115   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      116   define variable v-waitfram-action01         as character   no-undo .
      117   define variable v-waitfram-action02         as character   no-undo .
      118   define variable v-waitfram-action03         as character   no-undo .
      119   define variable mWaitFramTextBeg            as character   no-undo.
      120   define variable mWaitFramTextEnd            as character   no-undo.
      121   define variable mWaitFramView               as logical     no-undo.
      122   define variable mWaitProcEvent              as logical     no-undo init yes.
      123   define variable mWaitFramInterval           as integer     no-undo init 1 .
      124   define variable mWaitFramStop               as logical     no-undo.
      125   define variable mWaitFramStopUser           as logical     no-undo.
      126   define variable mWaitFramStopTimeOut        as logical     no-undo.
      127   define variable mWaitFramStartProc          as datetime-tz no-undo.
      128   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      129   define button B-WaitFramStop auto-end-key
      130        label "Стоп"
      131        size 10 by 1 tooltip "Остоновить процесс".
      132   define button B-viewProcInfo
      133        label "Информация"
      134        size 15 by 1 tooltip "Информация о процесс".
      135   define frame waitfram
      136     v-waitfram-action01 format "x(72)" no-label skip
      137     v-waitfram-action02 format "x(72)" no-label skip
      138     v-waitfram-action03 format "x(72)" no-label skip
      139     B-viewProcInfo
      140     B-WaitFramStop at row 4 col 30
      141     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      142     .
      143   define new global shared variable mBatchMode as logical no-undo init ?.
      144   define variable mFramBachModHandle as handle no-undo.
      145   mFramBachModHandle = frame waitfram:handle.
      146   define variable mFameOldVis as logical no-undo.
      147   define variable mVisCUrentVin as logical no-undo.
      148   if session:batch-mode
      149   then
      150      mBatchMode = yes.
      151   if mBatchMode = ? then do:
      152     mVisCUrentVin = current-window:visible.
      153     mFameOldVis = mFramBachModHandle:visible.
      154     mFramBachModHandle:visible  = yes.
      155     mBatchMode = mFramBachModHandle:visible ne yes.
      156     mFramBachModHandle:visible = mFameOldVis.
      157     current-window:visible = mVisCUrentVin.
      158   end.
      159    if  log-manager:logfile-name ne ?
      160     then DO:
      161         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      162         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      163         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      164     end.
      165   on choose of B-WaitFramStop in frame waitfram
      166   do:
      167     mWaitFramStop = yes.
      168     mWaitFramStopUser = yes.
      169   end.
      170   function waitfram-check-timeout returns logical():
      171      define variable vtime as int64 no-undo.
      172      if mWaitFramStopTimeOut
      173      then
      174         return yes.
      175      vtime = ( now - mWaitFramStartProc ) / 1000 .
      176      if     mWaitFramTimeOut ne ?
      177         and mWaitFramTimeOut ne 0
      178         and mWaitFramTimeOut lt vtime
      179      then do:
      180         mWaitFramStopTimeOut = yes.
      181      end.
      182      return mWaitFramStopTimeOut.
      183   end.
      184   procedure waitfram-hide :
      185     if not session:batch-mode
      186     then do
      187     on error undo, return error return-value
      188     :
      189       pause 0 before-hide .
      190       if not mBatchMode then
      191         hide frame waitfram .
      192     if     not mWaitFramView
      193        and mWaitProcEvent
      194     then
      195       process events .
      196     end.
      197   end procedure.
      198   procedure waitfram-show :
      199     define input  parameter p-message as character no-undo .
      200     define variable v-left-margin as integer   no-undo .
      201     if not session:batch-mode
      202     then do
      203     on error undo, return error return-value
      204     :
      205       if length(p-message) <= 70 then do:
      206         assign
      207           v-left-margin = integer((70 - length(p-message)) / 2)
      208         .
      209         assign
      210           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      211         .
      212         assign
      213           v-waitfram-action01 = " "
      214           v-waitfram-action02 = " "
      215                                    + fill(" ", v-left-margin)
      216                                    + p-message
      217           v-waitfram-action03 = " "
      218         .
      219       end.
      220       else do:
      221         define variable vRindex1 as integer no-undo.
      222         define variable vRindex2 as integer no-undo.
      223         vRindex1 = r-index(p-message," ",70).
      224         if vRindex1 = 0
      225         then
      226            vRindex1 = 70.
      227         if length(p-message)  <= vRindex1 + 70 then do:
      228           assign
      229             v-waitfram-action01 = " "
      230             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      231             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      232           .
      233         end.
      234         else do:
      235           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      236           if vRindex2 <= vRindex1
      237           then
      238              vRindex2 = vRindex1 + 70.
      239           assign
      240             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      241             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      242             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      243           .
      244         end.
      245       end.
      246       B-viewProcInfo:visible   in frame waitfram = no.
      247       B-viewProcInfo:sensitive in frame waitfram = no.
      248       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      249       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      250       if  (   mWaitFramView
      251          or  mWaitProcEvent)
      252          and not mBatchMode
      253       then
      254          display
      255             v-waitfram-action01 skip
      256             v-waitfram-action02 skip
      257             v-waitfram-action03 skip
      258          with frame waitfram .
      259       if     mWaitFramView
      260          then do:
      261             if     mWaitFramInterval ne ?
      262                and not mBatchMode
      263             then
      264                wait-for go of frame waitfram pause mWaitFramInterval.
      265          end.
      266          else
      267             if     mWaitProcEvent
      268                and not mBatchMode
      269             then
      270                process events .
      271     end.
      272   end procedure.
      273      procedure waitfram-show-this:
      274         define input  parameter iInterval as int64 no-undo.
      275         define variable vtime as int64 no-undo.
      276         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      277         mWaitFramInterval = iInterval.
      278         run waitfram-show (substitute("&1&2 &3&4" ,
      279                                       mWaitFramTextBeg ,
      280                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      281                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      282                                       mWaitFramTextEnd
      283                                      )
      284                           ).
      285      end.
      286      procedure WaitFramRunPause:
      287         define input  parameter iInterval as dec no-undo.
      288         define variable vStart  as datetime-tz no-undo.
      289         define variable vend    as datetime-tz no-undo.
      290         define variable vint as int64 no-undo.
      291         define variable vOk as logical no-undo.
      292         vStart = now.
      293         vend   = vStart.
      294         publish "WaitFramPause" (iInterval,output vOk).
      295         vend   =  now.
      296         vint = vend - vStart.
      297         vint = iInterval - vint / 1000.
      298         if     not mWaitFramStop
      299            and (   vint > 0
      300                 or (    not vOk
      301                     and iInterval eq ?
      302                     )
      303                 )
      304         then
      305            run waitfram-show-this (iInterval).
      306         vend   =  now.
      307         vint = vend - vStart.
      308         vint = iInterval - vint / 1000.
      309         if     not mWaitFramStop
      310            and vint > 0
      311         then do:
      312            run gbl/pause.p (vint * 1000).
      313         end.
      314         if iInterval ne ?
      315         then
      316            publish "WaitFramStop".
      317         waitfram-check-timeout().
      318      end.
      319      procedure WaitFramWaitFor:
      320         define input  parameter iInterval as dec no-undo.
      321         assign
      322            mWaitFramStartProc   = now
      323            mWaitFramStopUser    = no
      324            mWaitFramStopTimeOut = no
      325         .
      326         block-wait:
      327         do while not mWaitFramStop:
      328            run WaitFramRunPause (iInterval).
      329            if  waitfram-check-timeout()
      330            then do:
      331               leave block-wait.
      332            end.
      333         end.
      334         run waitfram-hide.
      335      end.
      336   procedure waitfram-join :
      337     define input  parameter p-line-1  as character no-undo .
      338     define input  parameter p-line-2  as character no-undo .
      339     define input  parameter p-line-3  as character no-undo .
      340     define output parameter p-message as character no-undo .
      341     do
      342     on error undo, return error return-value
      343     :
      344       assign
      345         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      346                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      347                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      348       .
      349     end.
      350   end procedure.
      351   function waitfram-join-function returns character
      352     (input p-line-1 as character
      353     ,input p-line-2 as character
      354     ,input p-line-3 as character
      355     ).
      356     define variable v-message as character no-undo .
      357     run waitfram-join in this-procedure
      358       (input  p-line-1
      359       ,input  p-line-2
      360       ,input  p-line-3
      361       ,output v-message
      362       ) .
      363     return v-message .
      364   end function .
      365   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      366   define variable v-fltopend-rowid as rowid extent 18 no-undo .
      367   procedure fltopend_fltopend :
      368   define input parameter p-parent-handle as handle no-undo .
      369   define input parameter p-qh as handle no-undo .
      370   define input parameter p-flt-open-open-query  as character no-undo .
      371   define input parameter p-where-cond as character no-undo .
      372   define input parameter p-use-indFIRST-query-tail as character no-undo .
      373   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      374   define input parameter p-indexed-reposition as character no-undo .
      375     do
      376     on error undo, return error
      377     :
      378   define variable v-prepare-string as character no-undo .
      379   define variable glog as logical no-undo .
      380   assign
      381   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      382                      p-where-cond + chr(32)  +
      383                      p-use-indFIRST-query-tail + chr(32) +
      384                      p-use-ind-sort-clmn-by + chr(32) +
      385                      p-indexed-reposition
      386   .
      387   assign
      388   glog = p-qh:query-prepare(v-prepare-string) no-error .
      389   if not glog
      390   or error-status:error then do:
      391     message error-status:get-message(1) view-as alert-box .
      392     undo, return error .
      393   end.
      394   assign
      395   glog = p-qh:query-open no-error .
      396   if not glog
      397   or error-status:error then do:
      398     message error-status:get-message(1) view-as alert-box .
      399     undo, return error .
      400   end.
      401     end.
      402   end procedure.
      403   procedure fltopend_fltfindd :
      404   define input parameter p-parent-handle as handle no-undo .
      405   define input parameter p-qh as handle no-undo .
      406   define input parameter p-rowid as rowid no-undo .
      407   define input parameter p-next as logical no-undo .
      408   define input parameter p-lock as integer no-undo .
      409   define input parameter p-bh as handle no-undo .
      410   define input parameter p-where-cond as character no-undo .
      411   define input parameter p-use-index-phrase as character no-undo .
      412   define variable glog as logical no-undo .
      413   define variable v-qh as handle no-undo .
      414   define variable v-bh as handle no-undo .
      415   define variable v-recid as recid no-undo .
      416   define variable v-prepare-string as character no-undo .
      417   do
      418   on error undo, return error
      419   on stop undo, return error
      420   :
      421     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
      422     create buffer v-bh for table p-bh buffer-name p-bh:name.
      423     create query v-qh.
      424     v-qh:set-buffers(v-bh).
      425     v-prepare-string = substitute("for each &1 &2 &3"
      426                                     ,v-bh:name
      427                                     ,p-where-cond
      428                                     ,p-use-index-phrase).
      429     glog = v-qh:query-prepare(v-prepare-string) no-error.
      430     if not glog then do:
      431       delete object v-qh.
      432       delete object v-bh.
      433       undo, return error .
      434     end.
      435     glog = v-qh:query-open no-error .
      436     if not glog then do:
      437       delete object v-qh.
      438       delete object v-bh.
      439       undo, return error .
      440     end.
      441     if p-next then do:
      442       v-qh:reposition-to-rowid(p-rowid) no-error .
      443       glog = v-qh:get-next( p-lock) no-error .
      444       glog = v-qh:get-next( p-lock) no-error .
      445       if not glog or v-qh:query-off-end = yes then do:
      446         glog = v-qh:get-first( p-lock) no-error .
      447       end.
      448     end.
      449     else do:
      450       glog = v-qh:get-first( p-lock) no-error .
      451     end.
      452     v-recid = v-bh:recid no-error .
      453     delete object v-qh.
      454     delete object v-bh.
      455     return string(v-recid) .
      456   end.
      457   end procedure.
      458   procedure fltopend_fltfindq :
      459   define input parameter p-parent-handle as handle no-undo .
      460   define input parameter p-qh as handle no-undo .
      461   define input parameter p-next as logical no-undo .
      462   define input parameter p-lock as integer no-undo .
      463   define input parameter p-flt-open-open-query  as character no-undo .
      464   define input parameter p-where-cond as character no-undo .
      465   define input parameter p-use-indFIRST-query-tail as character no-undo .
      466   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      467   define input parameter p-indexed-reposition as character no-undo .
      468   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
      469   define variable glog as logical no-undo .
      470   define variable v-qh as handle no-undo .
      471   define variable v-bh as handle no-undo extent 18.
      472   define variable v-rowid as rowid no-undo extent 18.
      473   define variable v-ii as integer no-undo .
      474   define variable v-prepare-string as character no-undo .
      475   do
      476   on error undo, return error
      477   on stop undo, return error
      478   :
      479     create query v-qh.
      480     do v-ii = 1 to p-qh:num-buffers:
      481       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
      482       assign
      483       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
      484       no-error.
      485       v-qh:add-buffer(v-bh[v-ii]).
      486     end.
      487     assign
      488     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      489                       p-where-cond + chr(32)  +
      490                       p-use-indFIRST-query-tail + chr(32) +
      491                       p-use-ind-sort-clmn-by + chr(32) +
      492                       p-indexed-reposition
      493     .
      494     glog = v-qh:query-prepare( v-prepare-string) no-error .
      495     if not glog then do:
      496       delete object v-qh.
      497       do v-ii = 1 to p-qh:num-buffers:
      498         delete object v-bh[v-ii].
      499       end.
      500       undo, return error .
      501     end.
      502     glog = v-qh:query-open no-error .
      503     if not glog then do:
      504       delete object v-qh.
      505       do v-ii = 1 to p-qh:num-buffers:
      506         delete object v-bh[v-ii].
      507       end.
      508       undo, return error .
      509     end.
      510     if p-next then do:
      511       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
      512       glog = v-qh:get-next( p-lock) no-error .
      513       glog = v-qh:get-next( p-lock) no-error .
      514       if not glog or v-qh:query-off-end = yes then do:
      515         glog = v-qh:get-first( p-lock) no-error .
      516       end.
      517     end.
      518     else do:
      519       glog = v-qh:get-first( p-lock) no-error .
      520     end.
      521     do v-ii = 1 to p-qh:num-buffers:
      522       assign
      523       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
      524       no-error.
      525     end.
      526     delete object v-qh.
      527     do v-ii = 1 to p-qh:num-buffers:
      528       delete object v-bh[v-ii].
      529     end.
      530   end.
      531   end procedure.
