     3213   define variable  where-phrase-33     as character no-undo .
     3214   define variable  sort-phrase-33      as character no-undo .
     3215   define variable  where-phrase-rus-33 as character no-undo .
     3216   define variable  sort-phrase-rus-33  as character no-undo .
     3217     run waitfram-show in this-procedure
     3218       (input "ЖДИТЕ ..."
     3219       ).
     3220   run gbl/flt-get.p
     3221     (input filter-point
     3222     ,output flt-rec-33
     3223     ,output filter-name-33
     3224     ,output where-phrase-33
     3225     ,output sort-phrase-33
     3226     ,output where-phrase-rus-33
     3227     ,output sort-phrase-rus-33
     3228     ).
     3229   if p-open-query then do:
     3230       run set-filter-name in this-procedure
     3231         (INPUT filter-name-33
     3232         ) no-error .
     3233     assign
     3234       l-filter-open-33 = false
     3235     .
     3236     if flt-rec-33 <> ?
     3237       or sort-column-phrase > ""
     3238     then do:
     3239       define variable  parameter-2-33 as character no-undo .
     3240       define variable  parameter-3-33 as character no-undo .
     3241       define variable  parameter-4-33 as character no-undo .
     3242       define variable  parameter-5-33 as character no-undo .
     3243       define variable  parameter-6-33 as character no-undo .
     3244       define variable  parameter-7-33 as character no-undo .
     3245         assign
     3246         parameter-3-33 =
     3247                                 "FOR EACH X_fin-doc"
     3248         parameter-4-33 =
     3249           (
     3250             if (" X_fin-doc.host-code = p-curr-host-code                             AND X_fin-doc.curr-code = p-curr-code                             AND X_fin-doc.cel-nazn-code = p-cel-nazn-code " + " " + where-phrase-33) <> ""
     3251             then  substitute('X_fin-doc.host-code = &1                             AND X_fin-doc.curr-code = &2                             AND X_fin-doc.cel-nazn-code = &3', p-curr-host-code, p-curr-code, p-cel-nazn-code ) + " " + where-phrase-33
     3252             else "true"
     3253           )
     3254         parameter-5-33 = (" " + "" + " " + "")
     3255         parameter-6-33 = if sort-phrase-33 = ''
     3256                              then
     3257           (
     3258           " " + " use-index idoc-date " +
     3259             " " + sort-column-phrase +
     3260           " " + "  "
     3261           )
     3262                              else
     3263           (
     3264           " " + " use-index idoc-date " +
     3265             " " + sort-column-phrase +
     3266           " " + sort-phrase-33
     3267           )
     3268         parameter-7-33 =
     3269           " indexed-reposition  "
     3270       .
     3271       do
     3272       on stop undo, leave
     3273       on error undo, leave
     3274       :
     3275         assign
     3276           l-disable-where-33 =
     3277             (" X_fin-doc.host-code = p-curr-host-code                             AND X_fin-doc.curr-code = p-curr-code                             AND X_fin-doc.cel-nazn-code = p-cel-nazn-code " + " " + where-phrase-33 = "")
     3278         .
     3279         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     3280                             ,input query br-fin-doc:handle
     3281                             ,input parameter-3-33
     3282                             ,input parameter-4-33
     3283                             ,input parameter-5-33
     3284                             ,input parameter-6-33
     3285                             ,input parameter-7-33
     3286                             )
     3287         .
     3288         assign
     3289           l-filter-open-33 = true
     3290         .
     3291       end.
     3292       if l-filter-open-33 = false then do:
     3293         message
     3294           "Ошибка при фильтрации / сортировке" skip
     3295           "Будут показаны записи без учета фильтра" skip
     3296           view-as alert-box .
     3297       end.
     3298       else do:
     3299           assign
     3300             l-query-was-opened = true
     3301           .
     3302       end.
     3303     end.
     3304     if l-filter-open-33 = false then do:
     3305       OPEN QUERY br-fin-doc FOR EACH X_fin-doc
     3306         where  X_fin-doc.host-code = p-curr-host-code                             AND X_fin-doc.curr-code = p-curr-code                             AND X_fin-doc.cel-nazn-code = p-cel-nazn-code
     3307          use-index idoc-date
     3308         indexed-reposition
     3309     .
     3310         assign
     3311           l-query-was-opened = true
     3312         .
     3313     end.
     3314   end.
     3315   else do:
     3316     assign
     3317       v-doc-rec = recid( X_fin-doc )
     3318     .
     3319     do
     3320     on stop undo, leave
     3321     on error undo, leave
     3322     :
     3323       if query br-fin-doc:handle:get-buffer-handle(1) = (buffer X_fin-doc:handle) then do:
     3324         assign
     3325         parameter-2-33 = (if p-find-next then "true":u else "false":u )
     3326         parameter-4-33 =
     3327           "where ":u +  substitute('X_fin-doc.host-code = &1                             AND X_fin-doc.curr-code = &2                             AND X_fin-doc.cel-nazn-code = &3', p-curr-host-code, p-curr-code, p-cel-nazn-code ) + " ":u + where-phrase-33 + " ":u + p-find-condition + " " + ""
     3328         parameter-5-33 = " use-index idoc-date "
     3329       .
     3330         run fltopend_fltfindd in this-procedure  (
     3331                             input this-procedure:handle
     3332                             ,input query br-fin-doc:handle
     3333                             ,input rowid(X_fin-doc)
     3334                             ,input logical(parameter-2-33)
     3335                             ,input no-lock
     3336                             ,input (buffer X_fin-doc:handle)
     3337                             ,input parameter-4-33
     3338                             ,input parameter-5-33
     3339                             ) no-error.
     3340         .
     3341         assign
     3342           v-doc-rec = integer(return-value)
     3343           v-fltopend-rowid[1] = ?
     3344         .
     3345       end.
     3346       else do:
     3347         assign
     3348         parameter-2-33 = (if p-find-next then "true":u else "false":u )
     3349         parameter-3-33 =  "FOR EACH X_fin-doc"
     3350         parameter-4-33 =
     3351           (
     3352             if (" X_fin-doc.host-code = p-curr-host-code                             AND X_fin-doc.curr-code = p-curr-code                             AND X_fin-doc.cel-nazn-code = p-cel-nazn-code " + " " + where-phrase-33) <> ""
     3353             then  substitute('X_fin-doc.host-code = &1                             AND X_fin-doc.curr-code = &2                             AND X_fin-doc.cel-nazn-code = &3', p-curr-host-code, p-curr-code, p-cel-nazn-code ) + " " + where-phrase-33
     3354             else "true"
     3355           )
     3356         parameter-5-33 = (" " + "" + " " + "" + " " + p-find-condition)
     3357         parameter-6-33 = if sort-phrase-33 = ''
     3358                              then
     3359           (
     3360           " " + " use-index idoc-date " +
     3361             " " + sort-column-phrase +
     3362           " " + "  "
     3363           )
     3364                              else
     3365           (
     3366           " " + " use-index idoc-date " +
     3367             " " + sort-column-phrase +
     3368           " " + sort-phrase-33
     3369           )
     3370         parameter-7-33 =
     3371           " indexed-reposition  "
     3372       .
     3373         run fltopend_fltfindq in this-procedure  (
     3374                             input this-procedure:handle
     3375                             ,input query br-fin-doc:handle
     3376                             ,input logical(parameter-2-33)
     3377                             ,input no-lock
     3378                             ,input parameter-3-33
     3379                             ,input parameter-4-33
     3380                             ,input parameter-5-33
     3381                             ,input parameter-6-33
     3382                             ,input parameter-7-33
     3383                             ,output v-fltopend-rowid
     3384                             ) no-error.
     3385         .
     3386         v-doc-rec = ?.
     3387       end.
     3388       assign
     3389         l-query-was-opened = true
     3390       .
     3391     end.
     3392   end.
     3393     run waitfram-hide in this-procedure .
     3394           end.
     3395         END CASE.
     3396       END.
     3397   END CASE.
     3398     end.
     3399   end procedure.
