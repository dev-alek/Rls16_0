        1   DEFINE BUFFER locked_c-dis-card-mask FOR ub.c-dis-card-mask.
        2   DEFINE BUFFER LOCKED_dis-card-mask FOR ub.dis-card-mask.
        3   DEFINE BUFFER locked_dis-card-type FOR ub.dis-card-type.
        4   DEFINE TEMP-TABLE tt-c-dis-card-mask NO-UNDO LIKE ub.c-dis-card-mask.
        5   DEFINE TEMP-TABLE tt-dis-card-mask NO-UNDO LIKE ub.dis-card-mask.
        6   DEFINE BUFFER X_clients FOR ub.clients.
        7   DEFINE BUFFER X_clients_dctype FOR ub.clients.
        8   DEFINE BUFFER X_curr_clients FOR ub.clients.
        9   DEFINE BUFFER X_sysconf FOR ub.sysconf.
       10   define input parameter parparentproc as widget-handle no-undo .
       11   define input parameter p-mode           AS CHARACTER             no-undo .
       12   define input parameter p-mask-num       like ub.c-dis-card-mask.mask-num no-undo .
       13   define input parameter p-chip-num       like ub.c-dis-card-mask.chip-num no-undo .
       14   define input parameter p-corr-user-db-num   like ub.c-dis-card-mask.corr-user-db-num no-undo .
       15   define INPUT-OUTPUT parameter p-doc-rec AS recid no-undo .
       16   DEF VAR vss-revision    AS CHAR NO-UNDO INIT "$Revision$":U.
       17   DEF VAR vss-author      AS CHAR NO-UNDO INIT "$Author$":U.
       18   DEF VAR vss-date        AS CHAR NO-UNDO INIT "$Date$":U.
       19   DEF VAR vss-workfile    AS CHAR NO-UNDO INIT "$Workfile$":U.
       20   DEF VAR vss-archive     AS CHAR NO-UNDO INIT "$Archive$":U.
       21   DEF VAR vss-description AS CHAR NO-UNDO INIT "История маски дисконтной карты":U.
       22   procedure vss-get-info :
       23     define output parameter p-vss-revision    like vss-revision    no-undo .
       24     define output parameter p-vss-author      like vss-author      no-undo .
       25     define output parameter p-vss-date        like vss-date        no-undo .
       26     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       27     define output parameter p-vss-archive     like vss-archive     no-undo .
       28     define output parameter p-vss-description like vss-description no-undo .
       29     assign
       30       p-vss-revision    = vss-revision
       31       p-vss-author      = vss-author
       32       p-vss-date        = vss-date
       33       p-vss-workfile    = vss-workfile
       34       p-vss-archive     = vss-archive
       35       p-vss-description = vss-description
       36     .
       37   end procedure.
       38   procedure vss-get-parameters :
       39     define output parameter p-vss-parameters as character no-undo .
       40   end procedure.
       41   define new global shared variable g#vssrevis-logger as handle    no-undo .
       42   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       43   define variable v-vssrevis-logger                   as handle    no-undo .
       44   procedure vss-logevent :
       45     define input  parameter p-extra-paramters as character no-undo .
       46     define variable v-vssrevis-parameters as character no-undo .
       47     do
       48     on error undo, return error return-value
       49     :
       50       if  valid-handle(v-vssrevis-logger)
       51       and v-vssrevis-logger :get-signature("logevent") <> ""
       52       then do:
       53         run vss-get-parameters in this-procedure
       54           (output v-vssrevis-parameters
       55           ).
       56         run logevent in v-vssrevis-logger
       57           (input vss-workfile
       58           ,input vss-revision
       59           ,input v-vssrevis-parameters
       60           ,input p-extra-paramters
       61           ).
       62       end.
       63     end.
       64   end procedure.
       65   assign
       66     v-vssrevis-logger = g#vssrevis-logger
       67   .
       68   if  valid-handle(v-vssrevis-logger)
       69   and v-vssrevis-logger :get-signature("logevent") <> ""
       70   then do:
       71     assign
       72       v-vssrevis-logevent = true
       73     .
       74     run vss-logevent in this-procedure (input vss-description) .
       75   end.
       76   define new global shared variable g#language as character no-undo .
       77   if g#language <> '' and g#language <> 'rus':U then do:
       78     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       79   end.
       80   procedure proc-alt-shift-f2:
       81     if not ibs.th.gbl.gbl-var:rcode
       82   then
       83     run gbl\inidebug.p .
       84   end.
       85   procedure proc-alt-shift-f3:
       86     run gbl/prvssinf.p
       87       ( input this-procedure
       88       ) .
       89   end.
       90   define variable v-inform-launched as logical no-undo initial false .
       91   procedure proc-alt-shift-f4:
       92     define variable v-action as character no-undo .
       93     if v-inform-launched = false then do:
       94       assign
       95         v-inform-launched = true
       96       .
       97       run gbl/d-inform.w
       98         (  input self
       99         ,  input this-procedure
      100         , output v-action
      101         ) no-error .
      102       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      103       assign
      104         v-inform-launched = false
      105       .
      106     end.
      107   end.
      108   procedure proc-alt-f1:
      109     run gbl/corrhelp.p
      110       (input this-procedure
      111       ) .
      112   end .
      113   on alt-shift-f2 anywhere do:
      114     run proc-alt-shift-f2.
      115   end.
      116   on alt-shift-f3 anywhere do:
      117     run proc-alt-shift-f3 in this-procedure .
      118   end.
      119   on alt-shift-f4 anywhere do:
      120     run proc-alt-shift-f4 in this-procedure.
      121   end.
      122   on alt-f1 anywhere do:
      123     run proc-alt-f1 in this-procedure .
      124   end.
      125   DEFINE VARIABLE v-tab-order AS CHARACTER NO-UNDO.
      126   DEFINE VARIABLE v-db-num LIKE ub.db.db-num NO-UNDO.
      127   DEFINE VARIABLE v-last-code LIKE ub.c-dis-card-mask.mask-num NO-UNDO.
      128   DEFINE BUTTON B-exit AUTO-GO
      129        LABEL "&Ввод"
      130        SIZE 10 BY 1
      131        BGCOLOR 8 .
      132   DEFINE BUTTON B-Help
      133        LABEL "Помо&щь"
      134        SIZE 10 BY 1
      135        BGCOLOR 8 .
      136   DEFINE BUTTON b-quit AUTO-END-KEY
      137        LABEL "&Отмена"
      138        SIZE 10 BY 1
      139        BGCOLOR 8 .
      140   DEFINE VARIABLE CB-CC-run AS CHARACTER FORMAT "X(256)":U
      141        LABEL "Алгоритм КЦ"
      142        VIEW-AS COMBO-BOX INNER-LINES 5
      143        LIST-ITEM-PAIRS "item 1","Item 1"
      144        DROP-DOWN-LIST
      145        SIZE 30 BY 1 NO-UNDO.
      146   DEFINE VARIABLE f-cli-name AS CHARACTER FORMAT "X(256)":U
      147         VIEW-AS TEXT
      148        SIZE 46.5 BY .67 NO-UNDO.
      149   DEFINE VARIABLE f-emitent-name AS CHARACTER FORMAT "X(256)":U
      150         VIEW-AS TEXT
      151        SIZE 50.5 BY .67 NO-UNDO.
      152   DEFINE VARIABLE RS-cli-mask AS CHARACTER
      153        VIEW-AS RADIO-SET HORIZONTAL
      154        RADIO-BUTTONS
      155             "Маска КОРОТКОГО №", "cli-mask",
      156   "Определенный контрагент", "cli-code"
      157        SIZE 51 BY 1.27 NO-UNDO.
      158   DEFINE VARIABLE RS-region AS INTEGER
      159        VIEW-AS RADIO-SET HORIZONTAL
      160        RADIO-BUTTONS
      161             "Глобально", 0,
      162   "Фирма", 1,
      163   "Объект", 2
      164        SIZE 63 BY 1 NO-UNDO.
      165   DEFINE QUERY Dialog-Frame FOR
      166         tt-c-dis-card-mask SCROLLING.
      167   DEFINE FRAME Dialog-Frame
      168        B-exit AT ROW 1 COL 1
      169        b-quit AT ROW 1 COL 11
      170        B-Help AT ROW 1 COL 54.9
      171        tt-c-dis-card-mask.use-on AT ROW 3.27 COL 67.5 NO-LABEL
      172             VIEW-AS RADIO-SET VERTICAL
      173             RADIO-BUTTONS
      174                       "Использовать на кассе и в TH", 0,
      175   "Использовать ТОЛЬКО на кассе", 1,
      176   "Использовать ТОЛЬКО в TH", 2
      177             SIZE 31.5 BY 2.27
      178        tt-c-dis-card-mask.type AT ROW 3.77 COL 18 COLON-ALIGNED
      179             LABEL "Тип карты"
      180             VIEW-AS FILL-IN
      181             SIZE 12 BY 1
      182        tt-c-dis-card-mask.mask-num AT ROW 3.77 COL 47.5 COLON-ALIGNED
      183             LABEL "Номер маски"
      184             VIEW-AS FILL-IN
      185             SIZE 13 BY 1
      186        tt-c-dis-card-mask.emitent-host-code AT ROW 5 COL 18 COLON-ALIGNED
      187             LABEL "Эмитент карты"
      188             VIEW-AS FILL-IN
      189             SIZE 7 BY 1
      190        RS-region AT ROW 6.5 COL 20.5 NO-LABEL
      191        tt-c-dis-card-mask.rank AT ROW 8.5 COL 79 COLON-ALIGNED
      192             LABEL "Ранг(приоритет при поиске)"
      193             VIEW-AS FILL-IN
      194             SIZE 7 BY 1
      195        tt-c-dis-card-mask.mask AT ROW 8.77 COL 14.5 COLON-ALIGNED
      196             LABEL "Маска карты"
      197             VIEW-AS FILL-IN
      198             SIZE 26 BY 1
      199        RS-cli-mask AT ROW 10.27 COL 43.5 NO-LABEL
      200        tt-c-dis-card-mask.cli-type AT ROW 12.27 COL 16.5 NO-LABEL
      201             VIEW-AS RADIO-SET HORIZONTAL
      202             RADIO-BUTTONS
      203                       "Item 1", "1":U,
      204   "Item 2", "2":U
      205             SIZE 14 BY 1
      206        tt-c-dis-card-mask.cli-code AT ROW 12.27 COL 29.5 COLON-ALIGNED NO-LABEL
      207             VIEW-AS FILL-IN
      208             SIZE 16 BY 1
      209        tt-c-dis-card-mask.cli-mask AT ROW 14.27 COL 19 COLON-ALIGNED
      210             LABEL "Маска КОРОТКОГО №"
      211             VIEW-AS FILL-IN
      212             SIZE 18 BY 1
      213        CB-CC-run AT ROW 14.27 COL 67 COLON-ALIGNED
      214        f-emitent-name AT ROW 5.27 COL 37 COLON-ALIGNED NO-LABEL
      215        f-cli-name AT ROW 12.5 COL 50.5 COLON-ALIGNED NO-LABEL
      216        "Контрагент" VIEW-AS TEXT
      217             SIZE 13.5 BY 1.27 AT ROW 12 COL 2
      218        "Метод поиска контрагента по маске карты" VIEW-AS TEXT
      219             SIZE 39.5 BY 1.27 AT ROW 10.27 COL 2.5
      220        "Область действия" VIEW-AS TEXT
      221             SIZE 17.5 BY 1 AT ROW 6.5 COL 2.5
      222        SPACE(79.24) SKIP(8.28)
      223       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      224            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      225            TITLE "История маски дисконтной карты"
      226            DEFAULT-BUTTON B-exit CANCEL-BUTTON b-quit.
      227   ASSIGN
      228          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      229          FRAME Dialog-Frame:HIDDEN           = TRUE.
      230   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      231   DO:
      232     APPLY "END-ERROR":U TO SELF.
      233   END.
      234   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      235   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      236   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      237   on help of frame Dialog-Frame
      238   do:
      239     run gbl/app_help.p
      240       (input this-procedure :file-name
      241       ,input ''
      242       ,input ?
      243       ) no-error.
      244     if error-status :error then do:
      245       message
      246         "Ошибка при вызове помощи"
      247         error-status :get-message(1)
      248         view-as alert-box .
      249     end.
      250   end.
      251   run minbtn-set in this-procedure .
      252   on choose of b-help in frame Dialog-Frame
      253   do:
      254     apply "help":u to frame Dialog-Frame .
      255   end.
      256   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      257   procedure minbtn-set :
      258       do
      259           on error undo, return error return-value
      260           :
      261           define variable ii              as integer       no-undo .
      262           define variable fh              as widget-handle no-undo .
      263           define variable hh              as widget-handle no-undo .
      264           define variable v-h             as handle        extent 4 no-undo .
      265           define variable v-name-button   as character     no-undo .
      266           define variable v-help-old-x    as decimal       no-undo .
      267           define variable v-help-old-y    as decimal       no-undo .
      268           define variable v-help-old-size as decimal       no-undo .
      269           define variable v-frame-width   as decimal       no-undo .
      270           define variable jj              as integer       no-undo .
      271           do
      272               on error undo, return error
      273               :
      274               assign
      275                   v-frame-width = frame Dialog-Frame:width - 0.3
      276                   fh            = frame Dialog-Frame:first-child
      277                   hh            = fh:first-child
      278                   ii            = 1
      279                   .
      280               do while valid-handle(hh):
      281                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      282                   do:
      283                       case lc(hh:name) :
      284                           when "b-help" then
      285                               do:
      286                                   hh:load-image-up("cmp/b-help.bmp":u) .
      287                                   hh:load-image-down("cmp/b-help.bmp":u) .
      288                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      289                                   hh:TOOLTIP = "Помощь" .
      290                                   v-help-old-x = hh:column .
      291                                   v-help-old-y = hh:row    .
      292                                   v-help-old-size = hh:width .
      293                                   hh:width-chars = 2.5 .
      294                               end.
      295                           when "b-print" then
      296                               do:
      297                                   hh:load-image("cmp/b-print.bmp":u) .
      298                                   hh:TOOLTIP = "Печать" .
      299                                   v-h[ii] = hh:handle .
      300                                   ii = ii + 1 .
      301                                   hh:width-chars = 3 .
      302                               end.
      303                           when "b-history" or
      304                           when "b-hist" then
      305                               do:
      306                                   hh:load-image("cmp/b-hist.bmp":u) .
      307                                   hh:TOOLTIP = "История" .
      308                                   v-h[ii] = hh:handle .
      309                                   ii = ii + 1 .
      310                                   hh:width-chars = 3 .
      311                               end.
      312                           when "b-sch" then
      313                               do:
      314                                   hh:load-image("cmp/b-sch.bmp":u) .
      315                                   hh:TOOLTIP = "Установка Фильтра" .
      316                                   v-h[ii] = hh:handle .
      317                                   ii = ii + 1 .
      318                                   hh:width-chars = 3 .
      319                               end.
      320                           when "b-hist-user" then
      321                               do:
      322                                   hh:load-image("cmp/b-hist.bmp":u) .
      323                                   hh:TOOLTIP = "История пользователя" .
      324                                   ii = ii + 1 .
      325                               end.
      326                       end case.
      327                   end.
      328                   hh = hh:next-sibling.
      329               end.
      330               b-help:column = v-frame-width - b-help:width-chars.
      331               jj = 0.
      332               repeat ii = 4 to 1 by -1 :
      333                   if valid-handle (v-h[ii] ) then
      334                   do:
      335                       jj  = jj + 1 .
      336                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      337                       v-h[ii]:row    = v-help-old-y .
      338                   end.
      339               end.
      340           end.
      341       end.
      342   end procedure.
      343   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      344   ON TAB ANYWHERE
      345   DO:
      346   define variable ii as integer no-undo .
      347   define variable fh as widget-handle no-undo .
      348   define variable hh as widget-handle no-undo .
      349   define variable v-next-widget-name as character no-undo .
      350   if v-tab-order <> '' then do:
      351     if self:type = "TOGGLE-BOX" then
      352     self:BGCOLOR = ?.
      353     assign
      354     ii = lookup(self:name, v-tab-order).
      355     assign
      356     ii = ii + 1
      357     v-next-widget-name = entry(ii, v-tab-order)
      358     no-error .
      359     if error-status:error then do:
      360       assign
      361       ii = 1
      362       v-next-widget-name = entry( ii, v-tab-order)
      363       .
      364     end.
      365     assign
      366     fh = frame Dialog-Frame:first-child
      367     hh = fh:first-child
      368     .
      369     do while valid-handle(hh):
      370       if hh:name = v-next-widget-name then do:
      371         if hh:sensitive  = yes
      372         AND hh:visible = yes then do:
      373           APPLY "ENTRY" to hh.
      374           return no-apply.
      375         end.
      376         else do:
      377           APPLY "TAB" to hh.
      378           return no-apply.
      379         end.
      380       end.
      381       hh = hh:next-sibling.
      382     end.
      383   end.
      384   END.
      385   ON BACK-TAB ANYWHERE
      386   DO:
      387   define variable ii as integer no-undo .
      388   define variable fh as widget-handle no-undo .
      389   define variable hh as widget-handle no-undo .
      390   define variable v-next-widget-name as character no-undo .
      391   if v-tab-order <> '' then do:
      392     assign
      393     ii = lookup(self:name, v-tab-order).
      394     .
      395     assign
      396     ii = (if ii = 1
      397           then  num-entries(v-tab-order)
      398           else ii - 1
      399           )
      400     v-next-widget-name = entry(ii, v-tab-order)
      401     .
      402     assign
      403     fh = frame Dialog-Frame:first-child
      404     hh = fh:first-child
      405     .
      406     do while valid-handle(hh):
      407       if hh:name = v-next-widget-name then do:
      408         if hh:sensitive  = yes
      409         AND hh:visible = yes then do:
      410           APPLY "ENTRY" to hh.
      411           return no-apply.
      412         end.
      413         else do:
      414         APPLY "BACK-TAB" to hh.
      415         return no-apply.
      416         end.
      417       end.
      418       hh = hh:next-sibling.
      419     end.
      420     end.
      421   END.
      422   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      423   ON RETURN ANYWHERE
      424   DO:
      425   define variable ii as integer no-undo .
      426   define variable fh as widget-handle no-undo .
      427   define variable hh as widget-handle no-undo .
      428   define variable v-next-widget-name as character no-undo .
      429     if v-tab-order <> '' then do:
      430       assign
      431       ii = lookup(self:name, v-tab-order).
      432       if ii = num-entries(v-tab-order) then do:
      433           APPLY 'CHOOSE' TO b-exit in frame Dialog-Frame.
      434           return no-apply.
      435       end.
      436       if self:type <> "BUTTON" and
      437         self:type <> "EDITOR"  then do:
      438         run proc-move-forward in this-procedure .
      439         return no-apply.
      440       end.
      441       if self:type = "BUTTON" then do:
      442         APPLY "CHOOSE" to self.
      443       end.
      444       if self:type = "TOGGLE-BOX" then
      445       self:BGCOLOR = ?.
      446       assign
      447       ii = ii + 1
      448       v-next-widget-name = entry(ii, v-tab-order)
      449       no-error .
      450       if error-status:error then do:
      451         assign
      452         ii = 1
      453         v-next-widget-name = entry( ii, v-tab-order)
      454         .
      455       end.
      456       assign
      457       fh = frame Dialog-Frame:first-child
      458       hh = fh:first-child
      459       .
      460       do while valid-handle(hh):
      461         if hh:name = v-next-widget-name then do:
      462           if hh:sensitive  = yes
      463           AND hh:visible = yes then do:
      464             if hh:type = "TOGGLE-BOX":U then do:
      465               assign
      466               hh:BGcolor = 1
      467               .
      468             end.
      469             APPLY "ENTRY" to hh.
      470             return no-apply.
      471           end.
      472           else do:
      473             APPLY "TAB" to hh.
      474             return no-apply.
      475           end.
      476         end.
      477         hh = hh:next-sibling.
      478       end.
      479     end.
      480   END.
      481   procedure proc-move-forward :
      482   define variable ii as integer no-undo .
      483   define variable fh as widget-handle no-undo .
      484   define variable hh as widget-handle no-undo .
      485   define variable v-next-widget-name as character no-undo .
      486   do
      487   on error undo, return error
      488   :
      489     if v-tab-order <> '' then do:
      490       if self:type = "TOGGLE-BOX" then
      491       self:BGCOLOR = ?.
      492       assign
      493       ii = lookup(self:name, v-tab-order).
      494       assign
      495       ii = ii + 1
      496       v-next-widget-name = entry(ii, v-tab-order)
      497       no-error .
      498       if error-status:error then do:
      499         assign
      500         ii = 1
      501         v-next-widget-name = entry( ii, v-tab-order)
      502         .
      503       end.
      504       assign
      505       fh = frame Dialog-Frame:first-child
      506       hh = fh:first-child
      507       .
      508       do while valid-handle(hh):
      509         if hh:name = v-next-widget-name then do:
      510           if hh:sensitive  = yes
      511           AND hh:visible = yes then do:
      512             if hh:type = "TOGGLE-BOX":U then do:
      513               assign
      514               hh:BGcolor = 1
      515               .
      516             end.
      517             APPLY "ENTRY" to hh.
      518             return.
      519           end.
      520           else do:
      521             assign
      522             ii = ii + 1
      523             v-next-widget-name = entry(ii, v-tab-order)
      524             no-error .
      525             if error-status:error then do:
      526               assign
      527               ii = 1
      528               v-next-widget-name = entry( ii, v-tab-order)
      529               .
      530             end.
      531           end.
      532         end.
      533         hh = hh:next-sibling.
      534       end.
      535     end.
      536   end.
      537   end procedure.
      538   MAIN-BLOCK:
      539   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      540      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      541    if p-mode  <> 'ПРОСМОТР':U
      542    then do:
      543       message
      544       vss-workfile vss-revision vss-description skip
      545       "Неверное значение параметров вызова p-mode"  p-mode
      546       view-as alert-box ERROR.
      547       undo, return error.
      548    end.
      549   for each tt-c-dis-card-mask:
      550     delete tt-c-dis-card-mask.
      551   end.
      552     if p-mode = 'ПРОСМОТР':U then do:
      553       find first locked_c-dis-card-mask no-lock where
      554                         recid(locked_c-dis-card-mask) = p-doc-rec no-error .
      555       if not avail locked_c-dis-card-mask then do:
      556         find first locked_c-dis-card-mask no-lock where
      557                     locked_c-dis-card-mask.mask-num = p-mask-num
      558                 AND locked_c-dis-card-mask.corr-user-db-num = p-corr-user-db-num
      559                 AND locked_c-dis-card-mask.chip-num = p-chip-num
      560                 no-error .
      561       end.
      562       if not available locked_c-dis-card-mask then do:
      563         message
      564         vss-workfile vss-revision vss-description skip
      565         "Не найдена запись ИСТОРИИ МАСКИ ДИСКОНТНОЙ КАРТЫ"
      566         view-as alert-box error .
      567         undo, return error.
      568       end.
      569       create tt-c-dis-card-mask.
      570       buffer-copy locked_c-dis-card-mask to tt-c-dis-card-mask.
      571       if LOCKED_c-dis-card-mask.cc-run > 0 then
      572       cb-cc-run = string(LOCKED_c-dis-card-mask.cc-run).
      573       else
      574       cb-cc-run = '':U
      575       .
      576      end.
      577      IF p-mode = 'ПРОСМОТР':U THEN DO:
      578          FIND FIRST locked_dis-card-type  no-lock WHERE
      579                     locked_dis-card-type.emitent-host-code = locked_c-dis-card-mask.emitent-host-code
      580               AND   LOCKED_dis-card-type.TYPE = LOCKED_c-dis-card-mask.TYPE NO-ERROR.
      581     END.
      582     find first X_curr_clients no-lock where
      583               X_curr_clients.obj-type = locked_c-dis-card-mask.obj-type
      584          AND X_curr_clients.obj-code = locked_c-dis-card-mask.obj-code no-error.
      585     find first X_sysconf no-lock where
      586               X_sysconf.host-code = locked_c-dis-card-mask.host-code no-error.
      587     RUN Myenable.
      588     WAIT-FOR GO OF FRAME Dialog-Frame.
      589   END.
      590   RUN disable_UI.
      591   PROCEDURE disable_UI :
      592     HIDE FRAME Dialog-Frame.
      593   END PROCEDURE.
      594   PROCEDURE enable_UI :
      595     OPEN QUERY Dialog-Frame FOR EACH tt-c-dis-card-mask SHARE-LOCK.
      596     GET FIRST Dialog-Frame.
      597     DISPLAY RS-region RS-cli-mask CB-CC-run f-emitent-name f-cli-name
      598         WITH FRAME Dialog-Frame.
      599     IF AVAILABLE tt-c-dis-card-mask THEN
      600       DISPLAY tt-c-dis-card-mask.use-on tt-c-dis-card-mask.type
      601             tt-c-dis-card-mask.mask-num tt-c-dis-card-mask.emitent-host-code
      602             tt-c-dis-card-mask.rank tt-c-dis-card-mask.mask
      603             tt-c-dis-card-mask.cli-type tt-c-dis-card-mask.cli-code
      604             tt-c-dis-card-mask.cli-mask
      605         WITH FRAME Dialog-Frame.
      606     ENABLE B-exit b-quit B-Help tt-c-dis-card-mask.use-on RS-region
      607            tt-c-dis-card-mask.rank tt-c-dis-card-mask.mask RS-cli-mask CB-CC-run
      608            f-emitent-name f-cli-name
      609         WITH FRAME Dialog-Frame.
      610     VIEW FRAME Dialog-Frame.
      611   END PROCEDURE.
      612   PROCEDURE MyEnable :
      613   IF tt-c-dis-card-mask.cli-code <> 0 THEN DO:
      614       FIND FIRST X_clients  NO-LOCK WHERE
      615                 X_clients.obj-type = tt-c-dis-card-mask.cli-type
      616           AND    X_clients.obj-code = tt-c-dis-card-mask.cli-code.
      617   END.
      618   IF tt-c-dis-card-mask.emitent-host-code <> 0 THEN DO:
      619     FIND FIRST X_clients_dctype  NO-LOCK WHERE
      620                     X_clients_dctype.obj-type = 'орг':U
      621               AND    X_clients_dctype.obj-code = tt-c-dis-card-mask.emitent-host-code.
      622   END.
      623   ASSIGN
      624   v-tab-order = "b-exit,b-quit,b-help"
      625   tt-c-dis-card-mask.cli-type:RADIO-BUTTONS IN FRAME Dialog-Frame = "Орг" + chr(44) + 'орг':U + chr(44) +
      626                                                                      "Чел" + chr(44) + 'чел':U
      627   RS-cli-mask = IF tt-c-dis-card-mask.cli-code > 0 THEN "cli-code":U ELSE "cli-mask":U
      628   Rs-region:RADIO-BUTTONS IN FRAME Dialog-Frame =
      629   "Глобально" + chr(44) + "0":U + chr(44) +
      630   ("Фирма" + chr(32) + STRING(tt-c-dis-card-mask.host-code)) + chr(44) + "1":U + chr(44) +
      631   ("Объект" + chr(32) + tt-c-dis-card-mask.obj-type + STRING(tt-c-dis-card-mask.obj-code)) + chr(44) + "2":U
      632   Rs-region = IF tt-c-dis-card-mask.host-code = 0
      633               THEN 0
      634               ELSE ( IF tt-c-dis-card-mask.obj-code = 0
      635                      THEN 1
      636                      ELSE 2
      637                     )
      638   f-emitent-name = IF p-mode = 'ДОБАВЛЕНИЕ':U
      639                    THEN "":U
      640                   ELSE (IF tt-c-dis-card-mask.emitent-host-code = 0
      641                         THEN "Глобально"
      642                         ELSE X_clients_dctype.obj-name
      643                       )
      644   cb-cc-run:LIST-ITEM-PAIRS  in frame Dialog-Frame =  "Не используется" + chr(44) + '0':U + chr(44) +
      645                                                         "Методу Luhna" + chr(44) + '1':U.
      646   if p-mode = 'ПРОСМОТР':U then do:
      647     assign
      648     b-quit:label = "&Выход"
      649     .
      650     hide
      651     b-exit in frame Dialog-Frame.
      652   end.
      653   DISPLAY
      654   b-quit
      655   b-help
      656   RS-region
      657   RS-cli-mask
      658   f-emitent-name
      659   f-cli-name
      660   WITH FRAME Dialog-Frame .
      661   Enable
      662   b-quit
      663   b-help
      664   with frame Dialog-Frame .
      665   IF AVAILABLE tt-c-dis-card-mask THEN
      666   DISPLAY
      667   tt-c-dis-card-mask.type
      668   tt-c-dis-card-mask.emitent-host-code
      669   tt-c-dis-card-mask.mask-num
      670   tt-c-dis-card-mask.rank
      671   tt-c-dis-card-mask.mask
      672   tt-c-dis-card-mask.cli-type
      673   tt-c-dis-card-mask.cli-code
      674   tt-c-dis-card-mask.cli-mask
      675   tt-c-dis-card-mask.use-on
      676   cb-cc-run
      677   WITH FRAME Dialog-Frame .
      678   VIEW FRAME Dialog-Frame .
      679   END PROCEDURE.
