        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision: c188d6f80d33, 2331, rls $":U .
        3   define variable vss-author      as character no-undo init "$Author: druban $":U .
        4   define variable vss-date        as character no-undo init "$Date: Ср июн 10 21:13:32 2020 +0300 $":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile: hdd.p $":U .
        6   define variable vss-archive     as character no-undo init "$Archive: ref/hdd.p $":U .
        7   define variable vss-description as character no-undo init "".
        8   SESSION:ERROR-STACK-TRACE=YES.
        9   define input  parameter parparentproc as handle no-undo .
       10   define input  parameter pdb-num   as integer no-undo .
       11   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       12   define temp-table userobjs_temp-user-obj no-undo
       13     field obj-type as character
       14     field obj-code as integer
       15     index xpk is primary unique obj-type obj-code
       16     .
       17   procedure userobjs_clear :
       18     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
       19     do
       20     on error undo, return error return-value
       21     :
       22       for each buf_userobjs_temp-user-obj
       23       on error undo, return error return-value
       24       :
       25         delete buf_userobjs_temp-user-obj .
       26       end.
       27     end.
       28   end .
       29   procedure userobjs_object-count :
       30     define output parameter p-total-count as integer   no-undo .
       31     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
       32     do
       33     on error undo, return error return-value
       34     :
       35       assign
       36         p-total-count = 0
       37       .
       38       for each buf_userobjs_temp-user-obj
       39       on error undo, return error return-value
       40       :
       41         assign
       42           p-total-count = p-total-count + 1
       43         .
       44       end.
       45     end.
       46   end.
       47   procedure userobjs_append :
       48      define input  parameter p-obj-type as character no-undo .
       49      define input  parameter p-obj-code as integer   no-undo .
       50     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
       51     do
       52     on error undo, return error return-value
       53     :
       54       find first buf_userobjs_temp-user-obj
       55         where buf_userobjs_temp-user-obj.obj-type = p-obj-type
       56           and buf_userobjs_temp-user-obj.obj-code = p-obj-code
       57         no-error .
       58       if not available buf_userobjs_temp-user-obj
       59       then do:
       60         create buf_userobjs_temp-user-obj .
       61         assign
       62           buf_userobjs_temp-user-obj.obj-type = p-obj-type
       63           buf_userobjs_temp-user-obj.obj-code = p-obj-code
       64         .
       65       end.
       66     end.
       67   end.
       68   procedure userobjs_object-exist :
       69     define output parameter p-object-exist as logical   no-undo .
       70     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
       71     do
       72     on error undo, return error return-value
       73     :
       74       find first buf_userobjs_temp-user-obj
       75         no-error .
       76       if not available buf_userobjs_temp-user-obj
       77       then do:
       78         assign
       79           p-object-exist = false
       80         .
       81       end.
       82       else do:
       83         assign
       84           p-object-exist = true
       85         .
       86       end.
       87     end.
       88   end.
       89   procedure userobjs_transfer :
       90     define input  parameter p-callback-handle as handle no-undo .
       91     define variable vss-description as character no-undo init "userobjs_transfer: Передача списка объектов".
       92     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
       93     do
       94     on error undo, return error return-value
       95     :
       96       if valid-handle(p-callback-handle) <> true
       97       then do:
       98         message
       99           vss-workfile vss-revision vss-description skip
      100           "Ошибка задания входных параметров" skip
      101           "Неизвестный указатель на процедуру" skip
      102           view-as alert-box error .
      103         undo, return error return-value .
      104       end.
      105       if p-callback-handle :get-signature("userobjs_append") = ""
      106       then do:
      107         message
      108           vss-workfile vss-revision vss-description skip
      109           "Ошибка задания входных параметров" skip
      110           substitute("В процедуре &1 не найдена внутренняя процедура userobjs_append"
      111                     ,p-callback-handle :file-name
      112                     ) skip
      113           view-as alert-box error .
      114         undo, return error return-value .
      115       end.
      116       for each buf_userobjs_temp-user-obj
      117       on error undo, return error return-value
      118       :
      119         run userobjs_append in p-callback-handle
      120           (input  buf_userobjs_temp-user-obj.obj-type
      121           ,input  buf_userobjs_temp-user-obj.obj-code
      122           ) .
      123       end.
      124     end.
      125   end procedure.
      126   procedure userobjs_select-one :
      127      define input  parameter parparentproc     as widget-handle no-undo .
      128      define input  parameter p-db-num          as integer   no-undo .
      129      define input  parameter p-user-id         as character no-undo .
      130      define input  parameter p-host-code-obj   as integer   no-undo .
      131      define input  parameter p-obj-type        as character no-undo .
      132      define input  parameter p-obj-code        as integer   no-undo .
      133      define output parameter p-user-select     as logical   no-undo .
      134      define output parameter p-select-obj-type as character no-undo .
      135      define output parameter p-select-obj-code as character no-undo .
      136     do
      137     on error undo, return error return-value
      138     :
      139       run gbl/userobjs.w
      140         (input  parparentproc
      141         ,input  this-procedure :handle
      142         ,input  p-db-num
      143         ,input  p-user-id
      144         ,input  p-host-code-obj
      145         ,input  p-obj-type
      146         ,input  p-obj-code
      147         ,INPUT  "b-sel"
      148         ,output p-user-select
      149         ,output p-select-obj-type
      150         ,output p-select-obj-code
      151         ) .
      152     end.
      153   end.
      154   procedure userobjs_select-many :
      155     define input  parameter parparentproc   as widget-handle no-undo .
      156     define input  parameter p-db-num        as integer   no-undo .
      157     define input  parameter p-user-id       as character no-undo .
      158     define input  parameter p-host-code-obj as integer   no-undo .
      159     define input  parameter p-obj-type      as character no-undo .
      160     define input  parameter p-obj-code      as integer   no-undo .
      161     define output parameter p-user-select   as logical   no-undo .
      162     define variable v-select-obj-type as character no-undo .
      163     define variable v-select-obj-code as integer   no-undo .
      164     do
      165     on error undo, return error return-value
      166     :
      167       run gbl/userobjs.w
      168         (input  parparentproc
      169         ,input  this-procedure :handle
      170         ,input  p-db-num
      171         ,input  p-user-id
      172         ,input  p-host-code-obj
      173         ,input  p-obj-type
      174         ,input  p-obj-code
      175         ,INPUT  "b-sel,b-mark"
      176         ,output p-user-select
      177         ,output v-select-obj-type
      178         ,output v-select-obj-code
      179         ) .
      180     end.
      181   end.
      182   procedure thobjs :
      183      define input        parameter parparentproc     as widget-handle no-undo .
      184      define input        parameter i-bttns           as character     no-undo .
      185      define input        parameter i-list-mode       as character     no-undo.
      186      define input        parameter i-obj-type        as character     no-undo.
      187      define input        parameter i-db-num          as integer       no-undo.
      188      define input        parameter i-host-code       as integer       no-undo.
      189      define input-output parameter p-rid-list        as character     no-undo .
      190   run ref/thobjs.p
      191           ( input parparentproc
      192            ,input  this-procedure :handle
      193           , input i-bttns
      194           , input i-list-mode
      195           , input i-obj-type
      196           , input i-db-num
      197           , input i-host-code
      198           , input-output p-rid-list ) no-error .
      199   end.
      200   define variable v-listact-brw as class ref.HDD_browse no-undo .
      201   v-listact-brw = new ref.HDD_browse (pdb-num).
      202   v-listact-brw:parparentproc = parparentproc .
      203   v-listact-brw:p-callback-handle = this-procedure :handle .
      204   wait-for  v-listact-brw:ShowDialog() .
      205   define variable v-err-msg as character no-undo .
      206   catch exAppErrors as class Progress.Lang.AppError :
      207     v-err-msg = exAppErrors:ReturnValue .
      208     if v-err-msg > "" then .
      209     else
      210     do :
      211       v-err-msg = exAppErrors:GetMessage(1) .
      212       if v-err-msg > "" then .
      213       else v-err-msg = "AppError в модуле c:\tester\Rls_16_0\rc_160_rus\cmpdir\src\ref\hdd.p" .
      214     end .
      215     message v-err-msg  view-as alert-box.
      216   end catch .
      217   catch exProErrors as class Progress.Lang.ProError :
      218     v-err-msg = exProErrors:GetMessage(1) .
      219     if v-err-msg > "" then .
      220     else v-err-msg = "ProError в модуле c:\tester\Rls_16_0\rc_160_rus\cmpdir\src\ref\hdd.p" .
      221     message "ProError" skip(1) v-err-msg  view-as alert-box.
      222   end catch .
      223   catch exAnyErrors as class Progress.Lang.Error:
      224     v-err-msg = "Unexpected error в модуле c:\tester\Rls_16_0\rc_160_rus\cmpdir\src\ref\hdd.p " + exAnyErrors:GetMessage(1).
      225     message "LangError" skip(1) v-err-msg  view-as alert-box.
      226   end catch .
      227   finally:
      228     SESSION:ERROR-STACK-TRACE=no.
      229     if valid-object(v-listact-brw) then delete object v-listact-brw no-error .
      230   end finally.
