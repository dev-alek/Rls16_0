        1   block-level on error undo, throw.
        2   define input parameter p-silent as logical no-undo .
        3   define input parameter p-rid as recid no-undo .
        4   define input parameter p-child-grp-behavior as character no-undo .
        5   define input parameter p-child-gds-behavior as character no-undo .
        6   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        7   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        8   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        9   define variable vss-workfile    as character no-undo init "$Workfile: gdsgrp03.p $":U .
       10   define variable vss-archive     as character no-undo init "$Archive: ref/gdsgrp03.p $":U .
       11   define variable vss-description as character no-undo init "Удаление группы товара".
       12   procedure vss-get-info :
       13     define output parameter p-vss-revision    like vss-revision    no-undo .
       14     define output parameter p-vss-author      like vss-author      no-undo .
       15     define output parameter p-vss-date        like vss-date        no-undo .
       16     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       17     define output parameter p-vss-archive     like vss-archive     no-undo .
       18     define output parameter p-vss-description like vss-description no-undo .
       19     assign
       20       p-vss-revision    = vss-revision
       21       p-vss-author      = vss-author
       22       p-vss-date        = vss-date
       23       p-vss-workfile    = vss-workfile
       24       p-vss-archive     = vss-archive
       25       p-vss-description = vss-description
       26     .
       27   end procedure.
       28   procedure vss-get-parameters :
       29     define output parameter p-vss-parameters as character no-undo .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define new global shared variable g#language as character no-undo .
       67   if g#language <> '' and g#language <> 'rus':U then do:
       68     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       69   end.
       70   define new global shared variable g#library  as handle no-undo .
       71   define new global shared variable g#library2 as handle no-undo .
       72   define   shared variable g#auto as logical no-undo.
       73   define   shared variable g#news as logical no-undo.
       74   define   shared variable g#oxml as logical no-undo.
       75   define   shared variable g#esys as logical no-undo.
       76   define   shared variable g#news-source-db as integer no-undo.
       77   define   shared variable g#esys-source-esys as integer no-undo.
       78   define   shared variable g#db-num as integer   no-undo .
       79   define   shared variable g#userid as character no-undo .
       80   define   shared variable g#passwd as character no-undo .
       81   define variable vss-include-info0 as character format "X(65)" no-undo
       82   initial "@(#)$Workfile$ $Revision$".
       83   define temp-table temp_grplib_grp no-undo
       84       field sel           as character
       85       field nabor         as character
       86       field full-name     as character
       87       field print-code    as character
       88       field sort-name     as character
       89       field node-code     as integer
       90       field upper-code    as integer
       91       field calc-method   as character
       92       field round-method  as character
       93       field increase-pc   as decimal
       94       field min-marg      as character
       95       field max-marg      as character
       96       field cli-type      as character
       97       field cli-code      as integer
       98       field notcorr      as character
       99       field name          as character
      100       field level         as integer
      101       field mark          as character
      102       index pi is primary unique sort-name
      103       index fn full-name
      104       index nc is unique node-code
      105       index sl sel
      106       index uc upper-code
      107   .
      108   define temp-table temp_grplib_found-grp no-undo
      109       field full-name   as character
      110       field sort-name   as character
      111       field node-code   as integer
      112       field level       as integer
      113       field is-terminal as logical
      114       index pi is primary unique sort-name
      115       index fn full-name
      116       index lv level
      117       index it is-terminal
      118   .
      119   define temp-table temp_found-result-nodelist no-undo
      120       field node-code     as recid
      121       field processed     as logical
      122       field sort-name     as character
      123       field full-name     as character
      124       index pi is primary unique node-code
      125       index ps processed
      126   .
      127   define variable v-grplib-not-fill-extra-info        as logical      no-undo.
      128   define variable v-grplib-no-warning-grp-amount      as logical      no-undo.
      129   define variable v-grplib-grp-amount-for-load        as integer      no-undo.
      130   procedure grplib-get-parameters :
      131   define input parameter p-store-type     as character        no-undo.
      132   define input parameter p-store-code     as integer          no-undo.
      133   do
      134   on error undo, return error
      135   :
      136       assign
      137           v-grplib-not-fill-extra-info = no
      138       .
      139   end.
      140   end procedure.
      141   procedure grplib-get-sort-name :
      142   do
      143   on error undo, return error
      144   :
      145   define input parameter p-node-code  as integer      no-undo.
      146   define output parameter p-sort-name as character    no-undo.
      147       define variable v-upper-code    as integer           no-undo.
      148       define buffer buf_gds-grp       for ub.gds-grp.
      149       define buffer buf_upper_gds-grp for ub.gds-grp.
      150       find first buf_gds-grp no-lock
      151            where buf_gds-grp.node-code = p-node-code
      152       no-error.
      153       if not available buf_gds-grp
      154       then do:
      155           undo, return error "grplib-get-sort-name: Не найдена группа товаров с кодом " + string( p-node-code ).
      156       end.
      157       assign
      158           p-sort-name  = ""
      159           v-upper-code = 1
      160       .
      161       do while buf_gds-grp.upper-code <> 0
      162       on error undo, return error "grplib-get-sort-name: Ошибка составления полного имени группы"
      163       :
      164           assign
      165               p-sort-name  = buf_gds-grp.node-name
      166                            + (if p-sort-name <> "" then chr(2) else "")
      167                            + p-sort-name
      168               v-upper-code = buf_gds-grp.upper-code
      169           .
      170           find first buf_gds-grp no-lock
      171                where buf_gds-grp.node-code = v-upper-code
      172           no-error.
      173           if not available buf_gds-grp
      174           then do:
      175               undo, return error "grplib-get-sort-name: Не найдена группа товаров с кодом "
      176                                   + string( v-upper-code )
      177                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
      178           end.
      179       end.
      180   end.
      181   end procedure.
      182   define variable vss-include-info1 as character format "X(65)" no-undo
      183   initial "@(#)$Workfile$ $Revision$".
      184   procedure grplib-get-full-name :
      185      define input parameter p-node-code  as integer      no-undo.
      186      define output parameter p-full-name as character    no-undo.
      187      do
      188   on error undo, return error
      189   :
      190       define variable v-upper-code    as integer           no-undo.
      191       define buffer buf_gds-grp       for ub.gds-grp.
      192       define buffer buf_upper_gds-grp for ub.gds-grp.
      193       find first buf_gds-grp no-lock
      194            where buf_gds-grp.node-code = p-node-code
      195       no-error.
      196       if not available buf_gds-grp
      197       then do:
      198           undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
      199       end.
      200       assign
      201           p-full-name  = ""
      202           v-upper-code = 1
      203       .
      204       do while buf_gds-grp.upper-code <> 0
      205       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
      206       :
      207           assign
      208               p-full-name  = buf_gds-grp.node-name
      209                            + (if p-full-name <> "" then chr(47) else "")
      210                            + p-full-name
      211               v-upper-code = buf_gds-grp.upper-code
      212           .
      213           find first buf_gds-grp no-lock
      214                where buf_gds-grp.node-code = v-upper-code
      215           no-error.
      216           if not available buf_gds-grp
      217           then do:
      218               undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом "
      219                                   + string( v-upper-code )
      220                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
      221           end.
      222       end.
      223       assign
      224       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
      225       .
      226   end.
      227   end .
      228   procedure grplib-get-node-from-full-name :
      229   define input parameter p-full-name as character no-undo .
      230   define output parameter p-node-code as integer no-undo .
      231   define variable v-ii as integer no-undo .
      232   define variable v-upper-code as integer no-undo .
      233   define variable v-root-code as integer no-undo .
      234   define variable v-entry as character no-undo .
      235   define buffer buf_gds-grp       for ub.gds-grp.
      236   do
      237   on error undo, return error
      238   :
      239     find first buf_gds-grp no-lock
      240         where buf_gds-grp.upper-code = 0
      241     no-error .
      242     if not available buf_gds-grp
      243     then do:
      244         undo, return error substitute("Не найдена корневая группа товаров (upper-code = 0)").
      245     end.
      246     else do:
      247       assign
      248       v-root-code = buf_gds-grp.node-code
      249       .
      250     end.
      251     v-upper-code = v-root-code.
      252     do v-ii = 1 to num-entries(p-full-name, chr(47)):
      253       assign
      254       v-entry = entry(v-ii, p-full-name, chr(47)).
      255       if v-entry = '' then leave.
      256       find first buf_gds-grp no-lock where
      257                 buf_gds-grp.node-name = v-entry
      258             and buf_gds-grp.upper-code = v-upper-code
      259             no-error.
      260       if not available buf_gds-grp then do:
      261         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
      262       end.
      263       else do:
      264         p-node-code = buf_gds-grp.node-code.
      265         v-upper-code = buf_gds-grp.node-code.
      266       end.
      267     end.
      268   end.
      269   end .
      270   procedure grplib-get-root-code :
      271   do
      272   on error undo, return error
      273   :
      274   define output parameter p-root-code as integer      no-undo.
      275       define buffer buf_gds-grp       for ub.gds-grp.
      276       find first buf_gds-grp no-lock
      277           where buf_gds-grp.upper-code = 0
      278       no-error .
      279       if not available buf_gds-grp
      280       then do:
      281           undo, return error .
      282       end.
      283       else do:
      284           assign
      285               p-root-code = buf_gds-grp.node-code
      286           .
      287       end.
      288   end.
      289   end procedure.
      290   procedure grplib-find-grp-by-full-name :
      291   do
      292   on error undo, return error
      293   :
      294   define input parameter p-search-name  as character    no-undo.
      295   define input parameter p-fill-path    as logical      no-undo.
      296   define output parameter p-found       as logical      no-undo.
      297       define variable v-upper-code    as integer          no-undo.
      298       define variable v-counter       as integer           no-undo.
      299       define variable v-level         as integer           no-undo.
      300       define variable v-full-name     as character         no-undo.
      301       define variable v-sort-name     as character         no-undo.
      302       define buffer buf_gds-grp       for ub.gds-grp.
      303       assign
      304           p-search-name = replace( p-search-name, chr(47), chr(2) )
      305       .
      306       run grplib-get-root-code ( output v-upper-code ) no-error .
      307       if error-status :error
      308       then do:
      309           undo, return error "grplib-expand-name: Ошибка при поиске корневого узла".
      310       end.
      311       assign
      312           v-full-name  = ""
      313           v-level      = num-entries( p-search-name, chr(2) )
      314       .
      315       for each temp_grplib_found-grp
      316       :
      317           delete temp_grplib_found-grp.
      318       end.
      319       start-name-analyze:
      320       do v-counter = 1 to v-level
      321       :
      322           if v-counter < v-level
      323           then do:
      324               find first buf_gds-grp no-lock
      325                    where buf_gds-grp.upper-code = v-upper-code
      326                      and buf_gds-grp.node-name  = entry( v-counter, p-search-name, chr(2) )
      327               no-error .
      328               if not available buf_gds-grp
      329               then do:
      330                   assign
      331                       v-full-name  = p-search-name
      332                       v-sort-name  = p-search-name
      333                   .
      334                   return error "grplib-expand-name: не найдена группа " + entry( v-level, p-search-name, chr(2) ).
      335               end.
      336               else do:
      337                   assign
      338                       v-full-name = v-full-name + ( if v-full-name = "" then "" else chr(47) )        + buf_gds-grp.node-name
      339                       v-sort-name = v-sort-name + ( if v-sort-name = "" then "" else chr(2) ) + buf_gds-grp.node-name
      340                       v-upper-code = buf_gds-grp.node-code
      341                   .
      342                   if p-fill-path = yes
      343                   then do:
      344                       create temp_grplib_found-grp.
      345                       assign
      346                           temp_grplib_found-grp.full-name = v-full-name + chr(47)
      347                           temp_grplib_found-grp.sort-name = v-sort-name
      348                           temp_grplib_found-grp.node-code = v-upper-code
      349                           temp_grplib_found-grp.level     = v-counter
      350                       .
      351                   end.
      352               end.
      353           end.
      354           else do:
      355               for each buf_gds-grp no-lock
      356                  where buf_gds-grp.upper-code = v-upper-code
      357                    and buf_gds-grp.node-name begins entry( v-counter, p-search-name, chr(2) )
      358               :
      359                   assign
      360                       p-found = yes
      361                   .
      362                   create temp_grplib_found-grp.
      363                   assign
      364                       temp_grplib_found-grp.full-name = v-full-name
      365                                                           + (if v-full-name = "" then "" else chr(47) )
      366                                                           + buf_gds-grp.node-name + chr(47)
      367                       temp_grplib_found-grp.sort-name = v-sort-name
      368                                                           + ( if v-sort-name = "" then "" else chr(2) )
      369                                                           + buf_gds-grp.node-name
      370                       temp_grplib_found-grp.node-code = buf_gds-grp.node-code
      371                       temp_grplib_found-grp.level     = v-level
      372                   .
      373               end.
      374               if p-found = no
      375               then do:
      376                   assign
      377                       v-full-name  = p-search-name
      378                       v-sort-name  = p-search-name
      379                   .
      380                   for each temp_grplib_found-grp
      381                   :
      382                       delete temp_grplib_found-grp.
      383                   end.
      384                   assign
      385                       p-found = no
      386                   .
      387               end.
      388           end.
      389       end.
      390   end.
      391   end procedure.
      392   procedure grplib-find-all-subgroup :
      393   do
      394   on error undo, return error
      395   :
      396   define input parameter p-start-node-code    as integer      no-undo.
      397   define input parameter p-terminal-only      as logical      no-undo.
      398       define variable v-start-full-name   as character     no-undo.
      399       define variable v-start-sort-name   as character     no-undo.
      400       define variable v-not-found         as logical       no-undo.
      401       define variable v-is-terminal       as logical       no-undo.
      402       define buffer buf_gds-grp           for ub.gds-grp.
      403       create temp_found-result-nodelist.
      404       assign
      405           temp_found-result-nodelist.node-code = p-start-node-code
      406           temp_found-result-nodelist.processed = no
      407       .
      408       run grplib-get-full-name in this-procedure (
      409             input p-start-node-code
      410           , output v-start-full-name
      411       ).
      412       run grplib-get-full-name in this-procedure (
      413             input p-start-node-code
      414           , output v-start-sort-name
      415       ).
      416       process-nodes:
      417       do while yes
      418       :
      419           find first temp_found-result-nodelist
      420                where temp_found-result-nodelist.node-code = p-start-node-code
      421           .
      422           assign
      423               temp_found-result-nodelist.processed = yes
      424           .
      425           for each buf_gds-grp no-lock
      426              where buf_gds-grp.upper-code = p-start-node-code
      427           on error undo, return error
      428           :
      429               run grplib-is-terminal in this-procedure (
      430                     input buf_gds-grp.node-code
      431                   , output v-is-terminal
      432               ).
      433               if v-is-terminal = yes
      434               then do:
      435                   create temp_grplib_found-grp.
      436                   assign
      437                       temp_grplib_found-grp.full-name   = right-trim(v-start-full-name, chr(47)) +
      438                                                           chr(47) + buf_gds-grp.node-name + chr(47)
      439                       temp_grplib_found-grp.sort-name   = right-trim(v-start-sort-name, chr(2)) +
      440                                                           chr(2) + buf_gds-grp.node-name + chr(2)
      441                       temp_grplib_found-grp.node-code   = buf_gds-grp.node-code
      442                       temp_grplib_found-grp.is-terminal = yes
      443                   .
      444               end.
      445               else do:
      446                   create temp_found-result-nodelist.
      447                   assign
      448                       temp_found-result-nodelist.node-code = buf_gds-grp.node-code
      449                       temp_found-result-nodelist.full-name = right-trim(v-start-full-name, chr(47)) +
      450                                                              chr(47) + buf_gds-grp.node-name + chr(47)
      451                       temp_found-result-nodelist.sort-name = right-trim(v-start-sort-name, chr(2)) +
      452                                                              chr(2) + buf_gds-grp.node-name + chr(2)
      453                       temp_found-result-nodelist.processed = no
      454                   .
      455                   if p-terminal-only = no
      456                   then do:
      457                       create temp_grplib_found-grp.
      458                       assign
      459                           temp_grplib_found-grp.full-name   = right-trim(v-start-full-name, chr(47)) +
      460                                                               chr(47) + buf_gds-grp.node-name + chr(47)
      461                           temp_grplib_found-grp.sort-name   = right-trim(v-start-sort-name, chr(2)) +
      462                                                               chr(2) + buf_gds-grp.node-name + chr(2)
      463                           temp_grplib_found-grp.node-code   = buf_gds-grp.node-code
      464                           temp_grplib_found-grp.is-terminal = no
      465                       .
      466                   end.
      467               end.
      468           end.
      469           find first temp_found-result-nodelist
      470                where temp_found-result-nodelist.processed = no
      471           no-error.
      472           if not available temp_found-result-nodelist
      473           then do:
      474               leave process-nodes.
      475           end.
      476           else do:
      477               assign
      478                   p-start-node-code = temp_found-result-nodelist.node-code
      479                   v-start-full-name = temp_found-result-nodelist.full-name
      480                   v-start-sort-name = temp_found-result-nodelist.sort-name
      481               .
      482           end.
      483       end.
      484   end.
      485   end procedure.
      486   procedure grplib-expand-name :
      487   define input parameter p-start-name as character        no-undo.
      488   define output parameter p-end-name  as character        no-undo.
      489       define variable v-is-terminal   as logical      no-undo.
      490       define variable v-found         as character    no-undo.
      491       define buffer buf_temp_grplib_found-grp     for temp_grplib_found-grp.
      492   do
      493   for buf_temp_grplib_found-grp
      494   on error undo, return error
      495   :
      496       run grplib-find-grp-by-full-name in this-procedure (
      497             input p-start-name
      498           , input no
      499           , output v-found
      500       ) no-error.
      501       run grplib-get-max-substring in this-procedure (
      502                   input length( p-start-name )
      503                 , output p-end-name
      504       ) no-error .
      505       if error-status :error
      506       then do:
      507           assign
      508               p-end-name = ""
      509           .
      510       end.
      511       else do:
      512           find first temp_grplib_found-grp
      513               where temp_grplib_found-grp.full-name = p-end-name
      514           no-error.
      515           if available temp_grplib_found-grp
      516           then do:
      517               find first buf_temp_grplib_found-grp
      518                   where buf_temp_grplib_found-grp.full-name begins p-end-name
      519                   and recid( buf_temp_grplib_found-grp ) <> recid( temp_grplib_found-grp )
      520               no-error.
      521               if not available buf_temp_grplib_found-grp
      522               then do:
      523                   run grplib-is-terminal in this-procedure (
      524                       input temp_grplib_found-grp.node-code
      525                       , output v-is-terminal
      526                   ).
      527               end.
      528           end.
      529       end.
      530   end.
      531   end procedure.
      532   procedure grplib-get-max-substring :
      533   do
      534   on error undo, return error
      535   :
      536   define input parameter p-min-substring-length   as integer      no-undo.
      537   define output parameter p-substring             as character    no-undo.
      538           define variable v-char-counter  as integer           no-undo.
      539           define variable v-current-char  as character         no-undo.
      540           define variable v-names-counter  as integer           no-undo.
      541           define variable v-base-string   as character         no-undo.
      542           assign
      543               v-char-counter  = p-min-substring-length
      544           .
      545           find first temp_grplib_found-grp no-error.
      546           if not available temp_grplib_found-grp
      547           then do:
      548               undo, return error "grplib-get-max-substring: Нет строк для вычисления общей подстроки".
      549           end.
      550           else do:
      551               assign
      552                   v-base-string  = temp_grplib_found-grp.full-name
      553                   v-char-counter = 0
      554               .
      555               counter-block:
      556               do while yes
      557               on error undo, return error "grplib-get-max-substring: Ошибка вычисления продолжения имени группы."
      558               :
      559                   assign
      560                       v-char-counter  = v-char-counter + 1
      561                       v-current-char  = substring( v-base-string, v-char-counter, 1 )
      562                       v-names-counter = 0
      563                   .
      564                   compare-block:
      565                   for each temp_grplib_found-grp
      566                   :
      567                       assign
      568                           v-names-counter = v-names-counter + 1
      569                       .
      570                       if v-names-counter = 1
      571                       then do:
      572                           next compare-block.
      573                       end.
      574                       if substring( temp_grplib_found-grp.full-name, v-char-counter, 1 ) <> v-current-char
      575                       then do:
      576                           leave counter-block.
      577                       end.
      578                   end.
      579                   if v-names-counter = 1
      580                   then do:
      581                       assign
      582                           p-substring = v-base-string
      583                       .
      584                       return.
      585                   end.
      586               end.
      587               assign
      588                   p-substring = substring( v-base-string, 1, v-char-counter - 1 )
      589               .
      590           end.
      591   end.
      592   end procedure.
      593   procedure grplib-is-terminal :
      594   do
      595   on error undo, return error "Ошибка процедуры grplib-is-terminal"
      596   :
      597   define input parameter p-node-code      as integer      no-undo.
      598   define output parameter p-is-terminal   as logical      no-undo.
      599       define buffer buf_gds-grp       for ub.gds-grp.
      600       find first buf_gds-grp no-lock
      601           where buf_gds-grp.upper-code = p-node-code
      602       no-error .
      603       if not available buf_gds-grp
      604       then do:
      605           assign
      606               p-is-terminal = yes
      607           .
      608       end.
      609       else do:
      610           assign
      611               p-is-terminal = no
      612           .
      613       end.
      614   end.
      615   end procedure.
      616   procedure grplib-have-goods :
      617   do
      618   on error undo, return error
      619   :
      620   define input parameter p-node-code      as integer      no-undo.
      621   define output parameter p-have-goods   as logical      no-undo.
      622       define buffer buf_goods         for ub.goods.
      623       find first buf_goods no-lock
      624            where buf_goods.grp-code = p-node-code
      625       no-error .
      626       if available buf_goods
      627       then do:
      628           assign
      629               p-have-goods = yes
      630           .
      631       end.
      632       else do:
      633           assign
      634               p-have-goods = no
      635           .
      636       end.
      637   end.
      638   end procedure.
      639   procedure grplib-find-by-substring :
      640   do
      641   on error undo, return error
      642   :
      643   define input parameter p-start-code         as integer      no-undo.
      644   define input parameter p-full-search-string as character    no-undo.
      645   define output parameter p-found-code        as integer      no-undo.
      646   define output parameter p-full-name         as character    no-undo.
      647       define variable v-start-code     as integer           no-undo.
      648       define variable v-found          as logical  init no  no-undo.
      649       define buffer buf_gds-grp       for ub.gds-grp.
      650       search-grp:
      651       for each buf_gds-grp no-lock
      652           where buf_gds-grp.node-code > p-start-code
      653       :
      654           if index( buf_gds-grp.node-name, p-full-search-string ) <> 0
      655           then do:
      656               assign
      657                   p-found-code = buf_gds-grp.node-code
      658                   v-found      = yes
      659               .
      660               run grplib-get-full-name in this-procedure (
      661                     input p-found-code
      662                   , output p-full-name
      663               ) no-error .
      664               if error-status :error
      665               then do:
      666                   undo, return error "grplib-find-by-substring: Ошибка вычисления полного имени группы." + chr(10) + return-value.
      667               end.
      668               leave search-grp.
      669           end.
      670       end.
      671       if v-found = yes
      672       then do:
      673       end.
      674       else do:
      675           assign
      676               p-full-name  = ""
      677               p-found-code = 0
      678           .
      679       end.
      680   end.
      681   end procedure.
      682   procedure grplib-analyze-grp-name :
      683   do
      684   on error undo, return error
      685   :
      686   define input parameter p-grp-name       as character            no-undo.
      687   define input parameter p-upper-code     as integer              no-undo.
      688   define output parameter p-error-message as character init ""    no-undo.
      689       define variable v-char-list     as character    no-undo.
      690       define variable v-char-counter  as integer      no-undo.
      691       define variable v-full-name     as character    no-undo.
      692       if p-grp-name = "" then do:
      693           assign
      694               p-error-message = "Название группы не может быть пустым.".
      695           .
      696       end.
      697       else do:
      698           assign
      699               v-char-list = "47,92,58,63,34,60,62,171,187,183"
      700           .
      701           do v-char-counter = 1 to num-entries( v-char-list )
      702           :
      703               if index( p-grp-name, chr( integer( entry( v-char-counter, v-char-list ) ) ) ) <> 0
      704               then do:
      705                   assign
      706                       p-error-message = 'Название группы не может содержать символы /\:*?"<>|«»·'
      707                   .
      708                   return.
      709               end.
      710           end.
      711           if p-upper-code > 0
      712           then do:
      713               run grplib-get-full-name in this-procedure (
      714                     input p-upper-code
      715                   , output v-full-name
      716               ) no-error .
      717               if error-status :error
      718               then do:
      719                   undo, return error "grplib-analyze-grp-name: Не удалось вычислить полное имя группы." + chr(10) + return-value.
      720               end.
      721               if length( v-full-name ) + 1 + length( p-grp-name ) > 350
      722               then do:
      723                   assign
      724                       p-error-message = 'Полное название группы не может содержать более 350 символов.'
      725                   .
      726               end.
      727           end.
      728       end.
      729   end.
      730   end procedure.
      731   procedure grplib-get-lvl-num :
      732   define input parameter p-node-code  as integer      no-undo.
      733   define output parameter p-lvl-num   as integer      no-undo.
      734       define variable v-full-name    as character    no-undo.
      735   do
      736   on error undo, return error
      737   :
      738       run grplib-get-full-name in this-procedure (
      739             input p-node-code
      740           , output v-full-name
      741       ).
      742       assign
      743           p-lvl-num = num-entries( v-full-name, chr(47) ) - 1
      744       .
      745       if p-lvl-num = -1
      746       then do:
      747           assign
      748               p-lvl-num = 0
      749           .
      750       end.
      751   end.
      752   end procedure.
      753   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      754   procedure grp-obj-write :
      755   do
      756   on error undo, return error
      757   :
      758   define input parameter p-node-code  like ub.gds-grp-obj.node-code      no-undo.
      759   define input parameter p-host-code  as integer                          no-undo.
      760   define input parameter p-obj-type   like ub.clients.obj-type            no-undo.
      761   define input parameter p-obj-code   like ub.clients.obj-code            no-undo.
      762   define input parameter p-min-increase like ub.gds-grp-obj.min-increase  no-undo.
      763   define input parameter p-max-increase like ub.gds-grp-obj.max-increase  no-undo.
      764   define input parameter p-increase-pc like ub.gds-grp-obj.increase-pc  no-undo.
      765   define input parameter p-calc-method like ub.gds-grp-obj.calc-method no-undo .
      766   define input parameter p-round-method like ub.gds-grp-obj.round-method no-undo .
      767   define input parameter p-round-coef like ub.gds-grp-obj.round-coef no-undo .
      768   define input parameter p-cli-type   like ub.clients.obj-type            no-undo.
      769   define input parameter p-cli-code   like ub.clients.obj-code            no-undo.
      770   define buffer buf_gds-grp-obj for ub.gds-grp-obj.
      771       find first buf_gds-grp-obj exclusive-lock
      772            where buf_gds-grp-obj.node-code  = p-node-code
      773              and buf_gds-grp-obj.host-code  = p-host-code
      774              and buf_gds-grp-obj.obj-type   = p-obj-type
      775              and buf_gds-grp-obj.obj-code   = p-obj-code
      776       no-error.
      777       if not available buf_gds-grp-obj
      778       then do:
      779           create buf_gds-grp-obj.
      780           assign
      781                   buf_gds-grp-obj.node-code  = p-node-code
      782                   buf_gds-grp-obj.host-code  = p-host-code
      783                   buf_gds-grp-obj.obj-type   = p-obj-type
      784                   buf_gds-grp-obj.obj-code   = p-obj-code
      785           .
      786       end.
      787       assign
      788       buf_gds-grp-obj.min-increase = p-min-increase
      789       buf_gds-grp-obj.max-increase = p-max-increase
      790       buf_gds-grp-obj.increase-pc = p-increase-pc
      791       buf_gds-grp-obj.calc-method = p-calc-method
      792       buf_gds-grp-obj.round-method = p-round-method
      793       buf_gds-grp-obj.round-coef = p-round-coef
      794       buf_gds-grp-obj.cli-type   = p-cli-type
      795       buf_gds-grp-obj.cli-code   = p-cli-code
      796       .
      797   end.
      798   end procedure.
      799   procedure grp-obj-margin-value :
      800   do
      801   on error undo, return error
      802   :
      803   define input parameter p-node-code as integer      no-undo.
      804   define input parameter p-obj-type  as character    no-undo.
      805   define input parameter p-obj-code  as integer      no-undo.
      806   define output parameter p-min-value as decimal      no-undo init ?.
      807   define output parameter p-max-value as decimal      no-undo init ?.
      808   define output parameter p-increase-pc as decimal      no-undo init ?.
      809   define output parameter p-round-method as character no-undo init "":U.
      810   define output parameter p-base as decimal no-undo init ?.
      811   define output parameter p-range-margin     as integer      no-undo.
      812   define output parameter p-exists-margin    as logical      no-undo.
      813   define output parameter p-range-increase     as integer      no-undo.
      814   define output parameter p-exists-increase    as logical      no-undo.
      815   define output parameter p-range-rmethod     as integer no-undo .
      816   define output parameter p-exists-rmethod    as logical no-undo .
      817   define variable v-host-code as integer      no-undo.
      818   DEFINE VARIABLE v-found as logical no-undo .
      819   DEFINE VARIABLE v-exists as logical no-undo .
      820   DEFINE VARIABLE v-range as integer no-undo .
      821   DEFINE VARIABLE jj as integer no-undo .
      822   DEFINE VARIABLE v-margin-found as logical no-undo .
      823   DEFINE VARIABLE v-increase-found as logical no-undo .
      824   DEFINE VARIABLE v-min-value as decimal      no-undo.
      825   DEFINE VARIABLE v-max-value as decimal      no-undo.
      826   DEFINE VARIABLE v-increase-pc as decimal      no-undo.
      827   define variable v-round-method as character no-undo .
      828   define variable v-base as decimal no-undo .
      829   define variable v-print-code as character no-undo .
      830   define buffer buf_gds-grp for ub.gds-grp.
      831   find first buf_gds-grp no-lock where
      832              buf_gds-grp.node-code = p-node-code no-error .
      833   if not avail buf_gds-grp and p-node-code <> 0 then do:
      834     message
      835       vss-workfile vss-revision vss-description
      836       skip "Не удалось найти группу товаров с кодом" p-node-code
      837       view-as alert-box error .
      838     undo, return error .
      839   end.
      840   if p-obj-type <> '' then do:
      841   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      842   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      843     (input  p-obj-type
      844     ,input  p-obj-code
      845     ,output v-host-code
      846     ) no-error .
      847     if error-status :error
      848     then do:
      849         message
      850           vss-workfile vss-revision vss-description
      851           skip "Не удалось найти фирму объекта"
      852           skip p-obj-type p-obj-code
      853           skip return-value
      854           skip trim(error-status :get-message(1))
      855               trim(error-status :get-message(2))
      856               trim(error-status :get-message(3))
      857               trim(error-status :get-message(4))
      858               trim(error-status :get-message(5))
      859         view-as alert-box error.
      860         undo, return error .
      861     end.
      862   end.
      863   define buffer buf_gds-grp-obj      for ub.gds-grp-obj.
      864   do while v-found = no and jj < 2:
      865     if v-range <> 3 then do:
      866       find first buf_gds-grp-obj no-lock
      867           where buf_gds-grp-obj.node-code = p-node-code
      868             and buf_gds-grp-obj.host-code = v-host-code
      869             and buf_gds-grp-obj.obj-type  = p-obj-type
      870             and buf_gds-grp-obj.obj-code  = p-obj-code
      871       no-error .
      872     end.
      873     if v-range = 3 or not available buf_gds-grp-obj
      874     then do:
      875        if v-range <> 2 then do:
      876           find first buf_gds-grp-obj no-lock
      877               where buf_gds-grp-obj.node-code = p-node-code
      878                 and buf_gds-grp-obj.host-code = v-host-code
      879                 and buf_gds-grp-obj.obj-type  = ""
      880                 and buf_gds-grp-obj.obj-code  = 0
      881           no-error .
      882         end.
      883         if v-range = 2 or not available buf_gds-grp-obj
      884         then do:
      885             if v-range <> 1 then do:
      886               find first buf_gds-grp-obj no-lock
      887                   where buf_gds-grp-obj.node-code = p-node-code
      888                   and buf_gds-grp-obj.host-code = 0
      889                   and buf_gds-grp-obj.obj-type  = ""
      890                   and buf_gds-grp-obj.obj-code  = 0
      891               no-error .
      892             end.
      893             if v-range = 1 or not available buf_gds-grp-obj
      894             then do:
      895                 assign
      896                     v-exists = no
      897                 .
      898             end.
      899             else do:
      900                 assign
      901                     v-exists = yes
      902                     v-range = 1
      903                 .
      904             end.
      905         end.
      906         else do:
      907             assign
      908                 v-exists = yes
      909                 v-range  = 2
      910             .
      911         end.
      912     end.
      913     else do:
      914         assign
      915             v-exists = yes
      916             v-range  = 3
      917         .
      918     end.
      919     if available buf_gds-grp-obj
      920     then do:
      921       assign
      922       v-min-value    = buf_gds-grp-obj.min-increase
      923       v-max-value    = buf_gds-grp-obj.max-increase
      924       v-increase-pc  = buf_gds-grp-obj.increase-pc
      925       v-round-method = buf_gds-grp-obj.round-method
      926       v-base         = buf_gds-grp-obj.round-coef
      927       .
      928       assign
      929       p-exists-margin = (if v-min-value <> ? and v-max-value <> ? and p-min-value = ?
      930                           then yes
      931                           else p-exists-margin)
      932       p-range-margin = if p-exists-margin and p-min-value = ?
      933                         then v-range
      934                         else p-range-margin
      935       p-min-value   =  if p-exists-margin and  p-min-value = ?
      936                         then v-min-value
      937                         else p-min-value
      938       p-max-value   =  if p-exists-margin and  p-max-value = ?
      939                         then v-max-value
      940                         else p-max-value
      941       p-exists-increase = (if v-increase-pc <> ? and p-increase-pc = ?
      942                           then yes
      943                           else p-exists-increase)
      944       p-range-increase = if p-exists-increase and p-increase-pc = ?
      945                         then v-range
      946                         else p-range-increase
      947       p-increase-pc = (if p-exists-increase and p-increase-pc = ?
      948                         then v-increase-pc
      949                         else p-increase-pc)
      950       p-exists-rmethod = if v-round-method <> "":U and p-round-method = "":U
      951                           then yes
      952                           else p-exists-rmethod
      953       p-range-rmethod = (if p-exists-rmethod and p-round-method = "":U
      954                           then v-range
      955                           else p-range-rmethod)
      956       p-round-method  = (if p-exists-rmethod and p-round-method = "":U
      957                           then v-round-method
      958                           else p-round-method)
      959       p-base          = (if p-exists-rmethod and p-base = ?
      960                           then v-base
      961                           else p-base)
      962       v-found =  (p-exists-margin and p-exists-increase and p-exists-rmethod) or (v-range <= 1)
      963       jj = jj + 1
      964       .
      965     end.
      966     else do:
      967       assign
      968       v-found =  (p-exists-margin and p-exists-increase and p-exists-rmethod ) or (v-range <= 1)
      969       jj = jj + 1
      970       .
      971     end.
      972   end.
      973   end.
      974   end procedure.
      975   procedure grp-obj-income-cli-value :
      976   do
      977   on error undo, return error
      978   :
      979   define input parameter p-node-code as integer      no-undo.
      980   define input parameter p-obj-type  as character    no-undo.
      981   define input parameter p-obj-code  as integer      no-undo.
      982   define output parameter p-cli-type as character    no-undo init ?.
      983   define output parameter p-cli-code as integer      no-undo init ?.
      984   define output parameter p-range-income-cli     as integer      no-undo.
      985   define output parameter p-exists-income-cli    as logical      no-undo.
      986   define variable v-host-code as integer      no-undo.
      987   DEFINE VARIABLE v-found as logical no-undo .
      988   DEFINE VARIABLE v-exists as logical no-undo .
      989   DEFINE VARIABLE v-range as integer no-undo .
      990   DEFINE VARIABLE jj as integer no-undo .
      991   DEFINE VARIABLE v-income-cli-found as logical no-undo .
      992   DEFINE VARIABLE v-cli-type-value as char      no-undo.
      993   DEFINE VARIABLE v-cli-code-value as int      no-undo.
      994   define buffer buf_gds-grp for ub.gds-grp.
      995   find first buf_gds-grp no-lock where
      996              buf_gds-grp.node-code = p-node-code no-error .
      997   if not avail buf_gds-grp and p-node-code <> 0 then do:
      998     message
      999       vss-workfile vss-revision vss-description
     1000       skip "Не удалось найти группу товаров с кодом" p-node-code
     1001       view-as alert-box error .
     1002     undo, return error .
     1003   end.
     1004   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1005   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1006     (input  p-obj-type
     1007     ,input  p-obj-code
     1008     ,output v-host-code
     1009     ) no-error .
     1010   if error-status :error
     1011   then do:
     1012       message
     1013         vss-workfile vss-revision vss-description
     1014         skip "Не удалось найти фирму объекта"
     1015         skip p-obj-type p-obj-code
     1016         skip return-value
     1017         skip trim(error-status :get-message(1))
     1018              trim(error-status :get-message(2))
     1019              trim(error-status :get-message(3))
     1020              trim(error-status :get-message(4))
     1021              trim(error-status :get-message(5))
     1022       view-as alert-box error.
     1023       undo, return error .
     1024   end.
     1025   define buffer buf_gds-grp-obj      for ub.gds-grp-obj.
     1026   do while v-found = no and jj < 2:
     1027     if v-range <> 3 then do:
     1028       find first buf_gds-grp-obj no-lock
     1029           where buf_gds-grp-obj.node-code = p-node-code
     1030             and buf_gds-grp-obj.host-code = v-host-code
     1031             and buf_gds-grp-obj.obj-type  = p-obj-type
     1032             and buf_gds-grp-obj.obj-code  = p-obj-code
     1033       no-error .
     1034     end.
     1035     if v-range = 3 or not available buf_gds-grp-obj
     1036     then do:
     1037        if v-range <> 2 then do:
     1038           find first buf_gds-grp-obj no-lock
     1039               where buf_gds-grp-obj.node-code = p-node-code
     1040                 and buf_gds-grp-obj.host-code = v-host-code
     1041                 and buf_gds-grp-obj.obj-type  = ""
     1042                 and buf_gds-grp-obj.obj-code  = 0
     1043           no-error .
     1044         end.
     1045         if v-range = 2 or not available buf_gds-grp-obj
     1046         then do:
     1047             if v-range <> 1 then do:
     1048               find first buf_gds-grp-obj no-lock
     1049                   where buf_gds-grp-obj.node-code = p-node-code
     1050                   and buf_gds-grp-obj.host-code = 0
     1051                   and buf_gds-grp-obj.obj-type  = ""
     1052                   and buf_gds-grp-obj.obj-code  = 0
     1053               no-error .
     1054             end.
     1055             if v-range = 1 or not available buf_gds-grp-obj
     1056             then do:
     1057                 assign
     1058                     v-exists = no
     1059                 .
     1060             end.
     1061             else do:
     1062                 assign
     1063                     v-exists = yes
     1064                     v-range = 1
     1065                 .
     1066             end.
     1067         end.
     1068         else do:
     1069             assign
     1070                 v-exists = yes
     1071                 v-range  = 2
     1072             .
     1073         end.
     1074     end.
     1075     else do:
     1076         assign
     1077             v-exists = yes
     1078             v-range  = 3
     1079         .
     1080     end.
     1081     if available buf_gds-grp-obj
     1082     then do:
     1083       assign
     1084       v-cli-type-value    = buf_gds-grp-obj.cli-type
     1085       v-cli-code-value    = buf_gds-grp-obj.cli-code
     1086       .
     1087       assign
     1088       p-exists-income-cli = (if v-cli-type-value <> ? and v-cli-code-value <> ? and p-cli-type = ?
     1089                           then yes
     1090                           else p-exists-income-cli)
     1091       p-range-income-cli = if p-exists-income-cli and p-cli-type = ?
     1092                         then v-range
     1093                         else p-range-income-cli
     1094       p-cli-type   =  if p-exists-income-cli and  p-cli-type = ?
     1095                         then v-cli-type-value
     1096                         else p-cli-type
     1097       p-cli-code   =  if p-exists-income-cli and  p-cli-code = ?
     1098                         then v-cli-code-value
     1099                         else p-cli-code
     1100       v-found =  (p-exists-income-cli ) or (v-range <= 1)
     1101       jj = jj + 1
     1102       .
     1103     end.
     1104     else do:
     1105       assign
     1106       v-found =  (p-exists-income-cli  ) or (v-range <= 1)
     1107       jj = jj + 1
     1108       .
     1109     end.
     1110   end.
     1111   end.
     1112   end procedure.
     1113     define NEW SHARED temp-table  tt-tax no-undo
     1114   field tax-code    like ub.tax.tax-code
     1115   FIELD individual  like ub.tax.individual
     1116   FIELD tax-name    like ub.tax.tax-name format "X(12)" column-label "Налог"
     1117   field rate-code   like ub.tax-rate.rate-code
     1118   FIELD rate-name   like ub.tax-rate.rate-name FORMAT "X(12)"
     1119   FIELD tax-type    like ub.tax.tax-type
     1120   field rate-value  like ub.tax-rate-value.rate-value
     1121   FIELD tax-rate-gds-rc  as recid
     1122   FIELD to-cashdesk like ub.tax.to-cashdesk
     1123   FIELD fact-date like ub.tax-rate-value.fact-date
     1124   FIELD fact-order like ub.tax-rate-value.fact-order
     1125   FIELD next-order like ub.tax-rate-value.fact-order
     1126   FIELD corr-user-name like ub.tax-rate-gds.corr-user-name
     1127   FIELD corr-user-db-num   like ub.tax-rate-gds.corr-user-db-num
     1128   FIELD corr-date like ub.tax-rate-gds.corr-date
     1129   FIELD corr-time like ub.tax-rate-gds.corr-time
     1130   index tax-code is unique primary tax-code fact-order descending rate-code.
     1131   DEFINE VARIABLE v-full-name as character no-undo .
     1132   DEFINE VARIABLE v-error-message as character no-undo .
     1133   DEFINE VARIABLE v-node-code like ub.gds-grp.node-code no-undo .
     1134   define variable v-answer as logical no-undo .
     1135   define variable v-root-code as integer no-undo .
     1136   define variable v-counter as integer no-undo .
     1137   define variable v-upper-code as integer no-undo .
     1138   define variable v-is-terminal as logical no-undo .
     1139   define variable v-have-goods as logical no-undo .
     1140   define buffer upper_gds-grp  for ub.gds-grp.
     1141   define buffer buf_gds-grp for ub.gds-grp.
     1142   define buffer buf2_gds-grp for ub.gds-grp.
     1143   define buffer buf_same_gds-grp for ub.gds-grp.
     1144   main-block:
     1145   do
     1146   on error undo, return error
     1147   :
     1148     if g#db-num <> 0 then do:
     1149       message
     1150       vss-workfile vss-revision vss-description skip
     1151       "Нельзя удалять группы клиентов в УБД"
     1152       view-as alert-box error .
     1153       undo main-block, return error .
     1154     end.
     1155     find first buf_gds-grp exclusive-lock where
     1156               recid(buf_gds-grp) = p-rid no-error .
     1157     if not avail buf_gds-grp then do:
     1158       assign
     1159       v-error-message = substitute("Не найдена группа товаров, которую предполагается удалить (recid=&1)", p-rid).
     1160       run err-mess in this-procedure ( input-output v-error-message).
     1161       undo main-block, return error (if p-silent then v-error-message else "node-code").
     1162     end.
     1163     run grplib-get-root-code in this-procedure ( output v-root-code ) no-error.
     1164     if buf_gds-grp.node-code = v-root-code
     1165     then do:
     1166       v-error-message = "Нельзя удалить корневую группу.".
     1167       run err-mess in this-procedure ( input-output v-error-message).
     1168       undo main-block, return error (if p-silent then v-error-message else "").
     1169     end.
     1170     if buf_gds-grp.upper-code = v-root-code then do:
     1171       assign
     1172           v-counter = v-counter + 1
     1173       .
     1174       count-first-level-grp:
     1175       for each buf2_gds-grp no-lock
     1176           where buf2_gds-grp.upper-code = v-root-code
     1177       :
     1178         assign
     1179             v-counter = v-counter + 1
     1180         .
     1181         if v-counter > 1
     1182         then do:
     1183             leave count-first-level-grp.
     1184         end.
     1185         else do:
     1186           v-error-message = "Нельзя удалить последнюю группу первого уровня.".
     1187           run err-mess in this-procedure ( input-output v-error-message).
     1188           undo main-block, return error (if p-silent then v-error-message else "").
     1189         end.
     1190       end.
     1191     end.
     1192     assign
     1193     v-upper-code    = buf_gds-grp.upper-code
     1194     v-answer        = no
     1195     .
     1196     run grplib-is-terminal in this-procedure ( input buf_gds-grp.node-code, output v-is-terminal ) no-error.
     1197     if error-status :error
     1198     then do:
     1199       v-error-message = substitute("Ошибка при определении терминальности группы:&1&2&1&3"
     1200                                     , chr(10)
     1201                                     , error-status:get-message(1)
     1202                                     , return-value ).
     1203       run err-mess in this-procedure ( input-output v-error-message).
     1204       undo main-block, return error (if p-silent then v-error-message else "").
     1205     end.
     1206     if v-is-terminal = no
     1207     then do:
     1208       for each buf2_gds-grp
     1209       where buf2_gds-grp.upper-code = v-upper-code
     1210         and buf2_gds-grp.node-code <> buf_gds-grp.node-code
     1211       :
     1212         find first buf_same_gds-grp no-lock
     1213             where buf_same_gds-grp.upper-code  = buf_gds-grp.node-code
     1214             and buf_same_gds-grp.node-name   = buf2_gds-grp.node-name
     1215         no-error.
     1216         if available buf_same_gds-grp
     1217         then do:
     1218           v-error-message = substitute("Одна из подгрупп удаляемой группы имеет название:&1&2&1-"  +
     1219                                       "такое же, как одна из соседних к удаляемой групп.&1-" +
     1220                                       "После удаления получились бы 2 группы на одном уровне, имеющие одинаковые названия, что запрещено."
     1221                                         , chr(10)
     1222                                         , buf_gds-grp.node-name
     1223                                       ).
     1224         end.
     1225       end.
     1226       if p-silent then do:
     1227         if p-child-grp-behavior = "up" then do:
     1228           v-answer = yes.
     1229         end.
     1230         else do:
     1231           v-error-message = substitute("В удаляемой группе есть подгруппы").
     1232           run err-mess in this-procedure ( input-output v-error-message).
     1233           undo main-block, return error (if p-silent then v-error-message else "").
     1234         end.
     1235       end.
     1236       else do:
     1237         if p-child-grp-behavior = "up" then do:
     1238           message
     1239           substitute("Текущая группа будет удалена.&1" +
     1240                       "Ее подгруппы будут перенесены в вышестоящую группу.&1&1" +
     1241                     "Слить группу с вышестоящей?"
     1242                     , chr(10))
     1243           view-as alert-box question buttons yes-no update v-answer.
     1244         end.
     1245         else do:
     1246           v-error-message = substitute("В удаляемой группе есть подгруппы").
     1247           run err-mess in this-procedure ( input-output v-error-message).
     1248           undo main-block, return error (if p-silent then v-error-message else "").
     1249         end.
     1250       end.
     1251     end.
     1252     if v-is-terminal = yes
     1253     then do:
     1254       run grplib-have-goods in this-procedure (
     1255             input buf_gds-grp.node-code
     1256           , output v-have-goods
     1257       ) no-error .
     1258       if error-status :error
     1259       then do:
     1260         v-error-message = substitute("Ошибка определения наличия товаров в группе.&1&2&1&3"
     1261                                     ,chr(10)
     1262                                     , error-status:get-message(1)
     1263                                     ,return-value).
     1264         run err-mess in this-procedure ( input-output v-error-message).
     1265         undo main-block, return error (if p-silent then v-error-message else "").
     1266       end.
     1267       if v-have-goods = yes
     1268       then do:
     1269         if p-child-gds-behavior = "up" then do:
     1270           find first buf2_gds-grp no-lock
     1271                 where buf2_gds-grp.upper-code = v-upper-code
     1272                   and buf2_gds-grp.node-code <> buf_gds-grp.node-code
     1273           no-error .
     1274           if available buf2_gds-grp
     1275           then do:
     1276             v-error-message = substitute("В одной группе не могут быть одновременно подгруппы и товары.&1" +
     1277                                             "Эта группа не может быть слита с вышестоящей."
     1278                                             , chr(10)).
     1279             run err-mess in this-procedure ( input-output v-error-message).
     1280             undo main-block, return error (if p-silent then v-error-message else "").
     1281           end.
     1282           if  p-silent then do:
     1283             v-answer = yes.
     1284           end.
     1285           else do:
     1286             message
     1287             "Текущая группа будет удалена." skip
     1288             "Товары будут перенесены в вышестоящую группу." skip (1)
     1289             "Слить группу с вышестоящей?"
     1290             view-as alert-box question buttons yes-no update v-answer.
     1291           end.
     1292         end.
     1293         else do:
     1294           v-error-message = substitute("В удаляемой группе есть товары").
     1295           run err-mess in this-procedure ( input-output v-error-message).
     1296           undo main-block, return error (if p-silent then v-error-message else "").
     1297         end.
     1298       end.
     1299       else do:
     1300         if p-silent then do:
     1301           v-answer = yes.
     1302         end.
     1303         else do:
     1304           message
     1305           "Удалить группу ? Вы уверены ?"
     1306           view-as alert-box question buttons yes-no update v-answer.
     1307         end.
     1308       end.
     1309     end.
     1310     if not v-answer
     1311     then do:
     1312        return 'no-apply'.
     1313     end.
     1314     delete-from-base:
     1315     do
     1316     ON ERROR UNDO delete-from-base, return no-apply
     1317     ON stop UNDO delete-from-base, return no-apply:
     1318       delete buf_gds-grp no-error.
     1319       if error-status:error then do:
     1320         v-error-message = substitute("Ошибка при удалении из БД:&1&2&1&3"
     1321                                     , chr(10)
     1322                                     , error-status:get-message(1)
     1323                                     , return-value
     1324                                     ).
     1325       end.
     1326     end.
     1327     find first buf_gds-grp no-lock
     1328           where buf_gds-grp.node-code = v-upper-code
     1329     no-error.
     1330     if not available buf_gds-grp
     1331     then do:
     1332       v-error-message = substitute("После удаления не найдена вышестоящая группа с вн.кодом &1"
     1333                                    , v-upper-code).
     1334       run err-mess in this-procedure ( input-output v-error-message).
     1335       undo main-block, return error (if p-silent then v-error-message else "").
     1336     end.
     1337   end.
     1338   PROCEDURE err-mess:
     1339     DEFINE INPUT-OUTPUT PARAMETER p-mess as character No-UNDO.
     1340     CASE p-silent:
     1341       when yes then do:
     1342         assign
     1343         p-mess = substitute("Группа c внутр. №: &1 (&2):&3&4"
     1344                            , buf_gds-grp.node-code
     1345                            , buf_gds-grp.node-name
     1346                            , chr(10)
     1347                            , p-mess)
     1348         .
     1349       end.
     1350       when no then do:
     1351         message
     1352         p-mess
     1353         view-as alert-box error .
     1354       end.
     1355     end.
     1356   END PROCEDURE.
