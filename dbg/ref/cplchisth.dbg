     2996     if (can-query (self, "sensitive")
     2997        and
     2998        self :sensitive = true
     2999        )
     3000     or (can-query (self, "read-only")
     3001        and
     3002        self :read-only = false
     3003        )
     3004     then do:
     3005       if self :handle <> focus :handle
     3006       then do:
     3007         apply "entry":u to self .
