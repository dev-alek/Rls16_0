     2761   procedure diasize_init :
     2762     define variable v-default-value    as logical   no-undo .
     2763     define variable v-restore-saved    as logical   no-undo .
     2764     define variable v-resize-value-str as character no-undo .
     2765     do
     2766     on error undo, return error return-value
     2767     :
     2768       do with frame Dialog-Frame
     2769       :
     2770         assign
     2771           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2772           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2773           v-diasize-browse-handle     = browse br-plc-hist :handle
     2774         .
     2775         create button v-diasize-resize-button
     2776         assign
     2777           parent        = frame Dialog-Frame :first-child
     2778           label         = "s"
     2779           height-pixels = 16
     2780           width-pixels  = 16
     2781           visible       = true
     2782           sensitive     = true
     2783           movable       = true
     2784           triggers:
     2785             on end-move persistent run diasize_end-move in this-procedure .
     2786           end triggers.
     2787         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2788         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2789         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2790         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2791         assign
     2792           v-diasize-wndmax = false
     2793         .
     2794         if connected("ub") = true
     2795         then do:
     2796           define variable v-cntxt-db-num        as integer   no-undo .
     2797           define variable v-cntxt-userid        as character no-undo .
     2798           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2799                                             , OUTPUT v-cntxt-userid
     2800                                             ) .
     2801           run gbl/wndpar_r.p
     2802             (input  v-cntxt-db-num
     2803             ,input  v-cntxt-userid
     2804             ,input  'wndmax':U
     2805             ,output v-diasize-wndmax
     2806             ,output v-default-value
     2807             ) .
     2808         end.
     2809         assign
     2810           v-diasize-wndstore = false
     2811         .
     2812         if connected("ub") = true
     2813         then do:
     2814           run gbl/wndpar_r.p
     2815             (input  v-cntxt-db-num
     2816             ,input  v-cntxt-userid
     2817             ,input  'wndstore':U
     2818             ,output v-diasize-wndstore
     2819             ,output v-default-value
     2820             ) .
     2821         end.
     2822         assign
     2823           v-diasize-proc-name = entry(1, program-name(2), '.')
     2824         .
     2825         if v-diasize-wndstore = true
     2826         then do:
     2827           assign
     2828             v-restore-saved = false
     2829           .
     2830           if connected("ub") = true
     2831           then do:
     2832             run gbl/wndsizer.p
     2833               (input  v-cntxt-db-num
     2834               ,input  v-cntxt-userid
     2835               ,input  v-diasize-proc-name
     2836               ,input  'height':u
     2837               ,output v-resize-value-str
     2838               ) .
     2839             if v-resize-value-str <> '':U
     2840             then do:
     2841               run diasize_change-height in this-procedure
     2842                 (input  integer(v-resize-value-str)
     2843                 ,input  true
     2844                 ) .
     2845               assign
     2846                 v-restore-saved = true
     2847               .
     2848             end.
     2849           end.
     2850           if connected("ub") = true
     2851           then do:
     2852             run gbl/wndsizer.p
     2853               (input  v-cntxt-db-num
     2854               ,input  v-cntxt-userid
     2855               ,input  v-diasize-proc-name
     2856               ,input  'width':u
     2857               ,output v-resize-value-str
     2858               ) .
     2859             if v-resize-value-str <> '':U
     2860             then do:
     2861               run diasize_change-width in this-procedure
     2862                 (input  integer(v-resize-value-str)
     2863                 ,input  true
     2864                 ) .
     2865               assign
     2866                 v-restore-saved = true
     2867               .
     2868             end.
     2869           end.
     2870           if v-restore-saved <> true
     2871           then do:
     2872             if v-diasize-wndmax = true
     2873             then do:
     2874               run diasize_maximize in this-procedure
     2875                 (input  true
     2876                 ) .
     2877             end.
     2878           end.
     2879         end.
     2880         else do:
     2881           if v-diasize-wndmax = true
     2882           then do:
     2883             run diasize_maximize in this-procedure
     2884               (input  true
     2885               ) .
     2886           end.
     2887         end.
     2888       end.
     2889     end.
     2890   end procedure.
     2891   procedure diasize_need-full-display :
     2892     define output parameter p-need-full-display as logical   no-undo .
     2893     do
     2894     on error undo, return error return-value
     2895     :
