     2964        )
     2965     or (can-query (self, "read-only")
     2966        and
     2967        self :read-only = false
     2968        )
     2969     then do:
     2970       assign
     2971         self :screen-value = ?
     2972       .
     2973     end.
     2974     return no-apply.
     2975   end.
