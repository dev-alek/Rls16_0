      122     run proc-alt-shift-f3 in this-procedure .
      123   end.
      124   on alt-shift-f4 anywhere do:
      125     run proc-alt-shift-f4 in this-procedure.
      126   end.
      127   on alt-f1 anywhere do:
      128     run proc-alt-f1 in this-procedure .
      129   end.
      130   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      131   define variable c-point  as character no-undo .
      132   define variable tbl      as character no-undo .
      133   define variable join-tbl as character no-undo .
      134   define variable fld      as character no-undo .
      135   define variable lab      as character no-undo .
      136   define variable spr      as character no-undo .
      137   define variable dim      as character no-undo .
      138   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      139   procedure cur-time :
      140      define output parameter p-today as date      no-undo .
      141      define output parameter p-time  as integer   no-undo .
      142     do
      143     on error undo, return error
      144     :
      145       define variable v-date1 as date      no-undo .
      146       define variable v-date2 as date      no-undo .
      147       define variable v-time  as integer   no-undo .
      148       assign
      149         v-date1 = today
      150         v-time  = time
      151         v-date2 = today
      152       .
      153       if v-date1 <> v-date2
      154       then do:
      155         assign
      156           v-date1 = today
      157           v-time  = v-time
      158         .
      159       end.
      160       assign
      161         p-today = v-date1
      162         p-time  = v-time
      163       .
      164     end.
      165   end.
      166   function cur-time-date returns character
      167   :
      168     return string(today, '99/99/9999':U) .
      169   end.
      170   function cur-time-mjd returns decimal
      171   :
      172     define variable v-date as date      no-undo .
      173     define variable v-time as integer   no-undo .
      174     run cur-time in this-procedure
      175       (output v-date
      176       ,output v-time
      177       ) .
      178     return integer(v-date) - 2400002 + (v-time / 86400) .
      179   end.
      180   function cur-time-get-ending-index returns integer
      181   (input p-number as integer
      182   )
      183   :
      184     if p-number < 0
      185     or p-number = ?
      186     then do:
      187       return 1 .
      188     end.
      189     define variable v-rest as integer   no-undo .
      190     assign
      191       p-number = p-number modulo 100
      192     .
      193     if p-number < 20
      194     then do:
      195       assign
      196         v-rest = p-number
      197       .
      198     end.
      199     else do:
      200       assign
      201         v-rest = p-number modulo 10
      202       .
      203     end.
      204     case v-rest :
      205       when 1
      206       then do:
      207         return 2 .
      208       end.
      209       when 2 or
      210       when 3 or
      211       when 4
      212       then do:
      213         return 3 .
      214       end.
      215       otherwise do:
      216         return 1 .
      217       end.
      218     end case .
      219   end.
      220   procedure cur-time-mjd-to-date :
      221      define input  parameter i-mjd-diff as decimal no-undo.
      222      define output parameter o-Date     as date    no-undo.
      223      define output parameter o-Time     as integer no-undo.
      224      define variable v-day-number as integer   no-undo .
      225      if    i-mjd-diff < 0
      226         or i-mjd-diff = ?
      227      then do:
      228         return "?" .
      229      end.
      230      assign
      231         v-day-number = truncate(i-mjd-diff,0).
      232         o-Date = date(v-day-number + 2400002).
      233         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      234     .
      235   end.
      236   function cur-time-mjd-to-string returns character
      237   (input p-mjd-diff as decimal
      238   )
      239   :
      240     define variable v-day-number as integer   no-undo .
      241     define variable v-seconds    as integer   no-undo .
      242     define variable v-hour       as integer   no-undo .
      243     define variable v-min        as integer   no-undo .
      244     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      245     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      246     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      247     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      248     if p-mjd-diff < 0
      249     or p-mjd-diff = ?
      250     then do:
      251       return "?" .
      252     end.
      253     assign
      254       v-day-number = integer(truncate(p-mjd-diff,0))
      255       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      256     .
      257     if v-seconds > 86400
      258     then do:
      259       assign
      260         v-seconds = 86400 - 1
      261       .
      262     end.
      263     if v-seconds < 0
      264     then do:
      265       assign
      266         v-seconds = 0
      267       .
      268     end.
      269     assign
      270       v-hour = truncate(v-seconds / 3600, 0)
      271     .
      272     assign
      273       v-seconds = v-seconds modulo 3600
      274     .
      275     assign
      276       v-min = truncate(v-seconds / 60, 0)
      277     .
      278     assign
      279       v-seconds = v-seconds modulo 60
      280     .
      281     return
      282         (if v-day-number <> 0
      283           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      284           else ""
      285         )
      286       + (if v-day-number <> 0 or v-hour <> 0
      287           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      288           else ""
      289         )
      290       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      291           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      292           else ""
      293         )
      294       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      295       .
      296   end.
      297   function cur-time-string returns character
      298   :
      299     define variable v-date as date      no-undo .
      300     define variable v-time as integer   no-undo .
      301     run cur-time in this-procedure
      302       (output v-date
      303       ,output v-time
      304       ) .
      305     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      306   end.
      307   function cur-time-string-sec returns character
      308   :
      309     define variable v-date as date      no-undo .
      310     define variable v-time as integer   no-undo .
      311     run cur-time in this-procedure
      312       (output v-date
      313       ,output v-time
      314       ) .
      315     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      316   end.
      317   function cur-time-custom  returns character
      318   (input p-prefix as character
      319   ,input p-date-format as character
      320   ,input p-delimiter as character
      321   ,input p-time-format as character
      322   ,input p-suffix as character
      323   )
      324   :
      325     define variable v-date as date      no-undo .
      326     define variable v-time as integer   no-undo .
      327     run cur-time in this-procedure
      328       (output v-date
      329       ,output v-time
      330       ) .
      331     return
      332       p-prefix
      333       + string(v-date, p-date-format)
      334       + p-delimiter
      335       + string(v-time, p-time-format)
      336       + p-suffix
      337       .
      338   end.
      339   function cur-time-print  returns character
      340   :
      341     define variable v-date as date      no-undo .
      342     define variable v-time as integer   no-undo .
      343     run cur-time in this-procedure
      344       (output v-date
      345       ,output v-time
      346       ) .
      347     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      348   end.
      349   function cur-time-datetime returns datetime
      350   :
      351     define variable v-char as character no-undo .
      352     define variable v-datetime as datetime no-undo .
      353     v-char = cur-time-string().
      354     v-datetime = datetime(v-char).
      355     return  v-datetime.
      356   end.
      357   function cur-time-string-msec returns character
      358   :
      359     define variable v-date as datetime  no-undo .
      360     v-date = now.
      361     return string(v-date) .
      362   end.
      363   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      364   define new shared variable PrintCopiesCounter as integer   no-undo initial 1 .
      365   define new shared variable RepPathName        as character no-undo .
      366   define new shared variable PrintRubl          as logical   no-undo .
      367   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      368   define variable v-waitfram-action01         as character   no-undo .
      369   define variable v-waitfram-action02         as character   no-undo .
      370   define variable v-waitfram-action03         as character   no-undo .
      371   define variable mWaitFramTextBeg            as character   no-undo.
      372   define variable mWaitFramTextEnd            as character   no-undo.
      373   define variable mWaitFramView               as logical     no-undo.
      374   define variable mWaitProcEvent              as logical     no-undo init yes.
      375   define variable mWaitFramInterval           as integer     no-undo init 1 .
      376   define variable mWaitFramStop               as logical     no-undo.
      377   define variable mWaitFramStopUser           as logical     no-undo.
      378   define variable mWaitFramStopTimeOut        as logical     no-undo.
      379   define variable mWaitFramStartProc          as datetime-tz no-undo.
      380   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      381   define button B-WaitFramStop auto-end-key
      382        label "Стоп"
      383        size 10 by 1 tooltip "Остоновить процесс".
      384   define button B-viewProcInfo
      385        label "Информация"
      386        size 15 by 1 tooltip "Информация о процесс".
      387   define frame waitfram
      388     v-waitfram-action01 format "x(72)" no-label skip
      389     v-waitfram-action02 format "x(72)" no-label skip
      390     v-waitfram-action03 format "x(72)" no-label skip
      391     B-viewProcInfo
      392     B-WaitFramStop at row 4 col 30
      393     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      394     .
      395   define new global shared variable mBatchMode as logical no-undo init ?.
      396   define variable mFramBachModHandle as handle no-undo.
      397   mFramBachModHandle = frame waitfram:handle.
      398   define variable mFameOldVis as logical no-undo.
      399   define variable mVisCUrentVin as logical no-undo.
      400   if session:batch-mode
      401   then
      402      mBatchMode = yes.
      403   if mBatchMode = ? then do:
      404     mVisCUrentVin = current-window:visible.
      405     mFameOldVis = mFramBachModHandle:visible.
      406     mFramBachModHandle:visible  = yes.
      407     mBatchMode = mFramBachModHandle:visible ne yes.
      408     mFramBachModHandle:visible = mFameOldVis.
      409     current-window:visible = mVisCUrentVin.
      410   end.
      411    if  log-manager:logfile-name ne ?
      412     then DO:
      413         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      414         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      415         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      416     end.
      417   on choose of B-WaitFramStop in frame waitfram
      418   do:
      419     mWaitFramStop = yes.
      420     mWaitFramStopUser = yes.
      421   end.
      422   function waitfram-check-timeout returns logical():
      423      define variable vtime as int64 no-undo.
      424      if mWaitFramStopTimeOut
      425      then
      426         return yes.
      427      vtime = ( now - mWaitFramStartProc ) / 1000 .
      428      if     mWaitFramTimeOut ne ?
      429         and mWaitFramTimeOut ne 0
      430         and mWaitFramTimeOut lt vtime
      431      then do:
      432         mWaitFramStopTimeOut = yes.
      433      end.
      434      return mWaitFramStopTimeOut.
      435   end.
      436   procedure waitfram-hide :
      437     if not session:batch-mode
      438     then do
      439     on error undo, return error return-value
      440     :
      441       pause 0 before-hide .
      442       if not mBatchMode then
      443         hide frame waitfram .
      444     if     not mWaitFramView
      445        and mWaitProcEvent
      446     then
      447       process events .
      448     end.
      449   end procedure.
      450   procedure waitfram-show :
      451     define input  parameter p-message as character no-undo .
      452     define variable v-left-margin as integer   no-undo .
      453     if not session:batch-mode
      454     then do
      455     on error undo, return error return-value
      456     :
      457       if length(p-message) <= 70 then do:
      458         assign
      459           v-left-margin = integer((70 - length(p-message)) / 2)
      460         .
      461         assign
      462           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      463         .
      464         assign
      465           v-waitfram-action01 = " "
      466           v-waitfram-action02 = " "
      467                                    + fill(" ", v-left-margin)
      468                                    + p-message
      469           v-waitfram-action03 = " "
      470         .
      471       end.
      472       else do:
      473         define variable vRindex1 as integer no-undo.
      474         define variable vRindex2 as integer no-undo.
      475         vRindex1 = r-index(p-message," ",70).
      476         if vRindex1 = 0
      477         then
      478            vRindex1 = 70.
      479         if length(p-message)  <= vRindex1 + 70 then do:
      480           assign
      481             v-waitfram-action01 = " "
      482             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      483             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      484           .
      485         end.
      486         else do:
      487           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      488           if vRindex2 <= vRindex1
      489           then
      490              vRindex2 = vRindex1 + 70.
      491           assign
      492             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      493             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      494             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      495           .
      496         end.
      497       end.
      498       B-viewProcInfo:visible   in frame waitfram = no.
      499       B-viewProcInfo:sensitive in frame waitfram = no.
      500       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      501       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      502       if  (   mWaitFramView
      503          or  mWaitProcEvent)
      504          and not mBatchMode
      505       then
      506          display
      507             v-waitfram-action01 skip
      508             v-waitfram-action02 skip
      509             v-waitfram-action03 skip
      510          with frame waitfram .
      511       if     mWaitFramView
      512          then do:
      513             if     mWaitFramInterval ne ?
      514                and not mBatchMode
      515             then
      516                wait-for go of frame waitfram pause mWaitFramInterval.
      517          end.
      518          else
      519             if     mWaitProcEvent
      520                and not mBatchMode
      521             then
      522                process events .
      523     end.
      524   end procedure.
      525      procedure waitfram-show-this:
      526         define input  parameter iInterval as int64 no-undo.
      527         define variable vtime as int64 no-undo.
      528         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      529         mWaitFramInterval = iInterval.
      530         run waitfram-show (substitute("&1&2 &3&4" ,
      531                                       mWaitFramTextBeg ,
      532                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      533                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      534                                       mWaitFramTextEnd
      535                                      )
      536                           ).
      537      end.
      538      procedure WaitFramRunPause:
      539         define input  parameter iInterval as dec no-undo.
      540         define variable vStart  as datetime-tz no-undo.
      541         define variable vend    as datetime-tz no-undo.
      542         define variable vint as int64 no-undo.
      543         define variable vOk as logical no-undo.
      544         vStart = now.
      545         vend   = vStart.
      546         publish "WaitFramPause" (iInterval,output vOk).
      547         vend   =  now.
      548         vint = vend - vStart.
      549         vint = iInterval - vint / 1000.
      550         if     not mWaitFramStop
      551            and (   vint > 0
      552                 or (    not vOk
      553                     and iInterval eq ?
      554                     )
      555                 )
      556         then
      557            run waitfram-show-this (iInterval).
      558         vend   =  now.
      559         vint = vend - vStart.
      560         vint = iInterval - vint / 1000.
      561         if     not mWaitFramStop
      562            and vint > 0
      563         then do:
      564            run gbl/pause.p (vint * 1000).
      565         end.
      566         if iInterval ne ?
      567         then
      568            publish "WaitFramStop".
      569         waitfram-check-timeout().
      570      end.
      571      procedure WaitFramWaitFor:
      572         define input  parameter iInterval as dec no-undo.
      573         assign
      574            mWaitFramStartProc   = now
      575            mWaitFramStopUser    = no
      576            mWaitFramStopTimeOut = no
      577         .
      578         block-wait:
      579         do while not mWaitFramStop:
      580            run WaitFramRunPause (iInterval).
      581            if  waitfram-check-timeout()
      582            then do:
      583               leave block-wait.
      584            end.
      585         end.
      586         run waitfram-hide.
      587      end.
      588   procedure waitfram-join :
      589     define input  parameter p-line-1  as character no-undo .
      590     define input  parameter p-line-2  as character no-undo .
      591     define input  parameter p-line-3  as character no-undo .
      592     define output parameter p-message as character no-undo .
      593     do
      594     on error undo, return error return-value
      595     :
      596       assign
      597         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      598                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      599                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      600       .
      601     end.
      602   end procedure.
      603   function waitfram-join-function returns character
      604     (input p-line-1 as character
      605     ,input p-line-2 as character
      606     ,input p-line-3 as character
      607     ).
      608     define variable v-message as character no-undo .
      609     run waitfram-join in this-procedure
      610       (input  p-line-1
      611       ,input  p-line-2
      612       ,input  p-line-3
      613       ,output v-message
      614       ) .
      615     return v-message .
      616   end function .
