     1070   FUNCTION get-all-fields returns character (p-file-name as character ):
     1071   define variable v-dop as character no-undo .
     1072     find first _file no-lock where _file._file-name = p-file-name no-error .
     1073     if not available _file then return "":U.
     1074     for each _field no-lock where
     1075              _field._file-recid = recid(_file) :
     1076       assign
     1077       v-dop = v-dop + _field._field-name + chr(44)
     1078       .
     1079     end.
     1080     return trim(v-dop).
     1081   END FUNCTION.
     1082   PROCEDURE proc-full-temp-changes :
     1083     define input  parameter p-hst-handle as handle    no-undo .
     1084     define input  parameter p-main-table as character no-undo .
     1085     define input  parameter p-field-list as character no-undo .
     1086     define input  parameter p-label-form as character no-undo .
     1087     define variable h-new-buf         as handle    no-undo .
     1088     define variable h-main-buf        as handle    no-undo .
     1089     define variable h-for-comp        as handle    no-undo .
     1090     define variable v-inform          as character no-undo .
     1091     define variable v-ind             as integer   no-undo .
     1092     define variable v-idx-field-qnty  as integer   no-undo .
     1093     define variable v-num-entries     as integer   no-undo .
     1094     define variable fh                as handle    no-undo .
     1095     define variable fh-main           as handle    no-undo .
     1096     define variable fh-old            as handle    no-undo .
     1097     define variable fh-new            as handle    no-undo .
     1098     define variable v-field-name      as character no-undo .
     1099     define variable v-field-lvl       as character no-undo .
     1100     define variable v-field-form      as character no-undo .
     1101     define variable v-search-exp      as character no-undo .
     1102     define variable v-srch-main       as character no-undo .
     1103     define variable v-word-link       as character no-undo .
     1104     define variable v-av-chip-num     as logical   no-undo .
     1105     define variable v-main-pi-fld-lst as character no-undo .
     1106     define variable v-main-fld-lst    as character no-undo .
     1107     define variable v-delim-list      as character no-undo .
     1108     define variable v-label           as character no-undo .
     1109     define variable v-old-value       as character no-undo case-sensitive.
     1110     define variable v-new-value       as character no-undo case-sensitive.
     1111     define variable v-chg-fields as character no-undo.
     1112     for each temp-changes:
     1113       delete temp-changes.
     1114     end.
     1115     if not p-hst-handle:available then do:
     1116       return .
     1117     end.
     1118     create buffer h-new-buf  for table p-hst-handle .
     1119     create buffer h-main-buf for table p-main-table .
     1120     assign
     1121       v-inform = h-main-buf:index-information(1)
     1122       v-ind    = 2
     1123     .
     1124     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1125     on error undo, return error
     1126     :
     1127       assign
     1128         v-inform = h-main-buf:index-information( v-ind )
     1129         v-ind    = v-ind + 1
     1130       .
     1131     end.
     1132     if v-inform = ?
     1133       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1134       or entry( 3, v-inform, ",":U ) <> "1":U
     1135     then do:
     1136       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, h-main-buf:name ).
     1137     end.
     1138     assign
     1139       v-idx-field-qnty = num-entries( v-inform ) - 4
     1140     .
     1141     if v-idx-field-qnty < 2 then do:
     1142       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, h-main-buf:name ).
     1143     end.
     1144     assign
     1145       v-srch-main   = "where":U
     1146       v-word-link   = "":U
     1147       v-av-chip-num = false
     1148       v-delim-list  = "":U
     1149     .
     1150     do v-ind = 1 to v-idx-field-qnty by 2
     1151     on error undo, return error
     1152     :
     1153       assign
     1154         v-field-name      = entry( 4 + v-ind, v-inform, ",":U )
     1155         fh                = p-hst-handle:buffer-field( v-field-name )
     1156         fh-main           = h-main-buf:buffer-field( v-field-name )
     1157         v-srch-main       = substitute( "&1 &2 &3.&4 =", v-srch-main, v-word-link, fh-main:table, v-field-name )
     1158         v-main-pi-fld-lst = v-main-pi-fld-lst + v-delim-list + v-field-name
     1159       .
     1160       if fh:data-type ="character":U then do:
     1161         assign
     1162           v-srch-main = substitute( '&1 "&2"', v-srch-main, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
     1163         .
     1164       end.
     1165       else do:
     1166         assign
     1167           v-srch-main = substitute( "&1 &2", v-srch-main, fh:buffer-value() )
     1168         .
     1169       end.
     1170       if v-delim-list = "":U then do:
     1171         assign
     1172           v-delim-list = ",":U
     1173         .
     1174       end.
     1175       if v-word-link = "":U then do:
     1176         assign
     1177           v-word-link = "and":U
     1178         .
     1179       end.
     1180     end.
     1181     assign
     1182       v-delim-list  = "":U
     1183     .
     1184     do v-ind = 1 to h-main-buf:num-fields
     1185     on error undo, return error
     1186     :
     1187       assign
     1188         fh-main      = h-main-buf:buffer-field( v-ind )
     1189         v-field-name = fh-main:name
     1190       .
     1191         assign
     1192           v-main-fld-lst = v-main-fld-lst + v-delim-list + v-field-name
     1193         .
     1194         if v-delim-list = "":U then do:
     1195           assign
     1196             v-delim-list = ",":U
     1197           .
     1198         end.
     1199     end.
     1200     assign
     1201       v-inform = p-hst-handle:index-information(1)
     1202       v-ind    = 2
     1203     .
     1204     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1205     on error undo, return error
     1206     :
     1207       assign
     1208         v-inform = p-hst-handle:index-information( v-ind )
     1209         v-ind    = v-ind + 1
     1210       .
     1211     end.
     1212     if v-inform = ?
     1213       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1214       or entry( 3, v-inform, ",":U ) <> "1":U
     1215     then do:
     1216       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, p-hst-handle:name ).
     1217     end.
     1218     assign
     1219       v-idx-field-qnty = num-entries( v-inform ) - 4
     1220     .
     1221     if v-idx-field-qnty < 2 then do:
     1222       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, p-hst-handle:name ).
     1223     end.
     1224     assign
     1225       v-search-exp  = "where":U
     1226       v-word-link   = "":U
     1227       v-av-chip-num = false
     1228     .
     1229     do v-ind = 1 to v-idx-field-qnty by 2
     1230     on error undo, return error
     1231     :
     1232       assign
     1233         v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     1234         fh           = p-hst-handle:buffer-field( v-field-name )
     1235         v-search-exp = substitute( "&1 &2 &3.&4", v-search-exp, v-word-link, fh:table, v-field-name )
     1236       .
     1237       if v-field-name = "chip-num":U then do:
     1238         assign
     1239           v-search-exp  = substitute( "&1 >", v-search-exp )
     1240           v-av-chip-num = true
     1241         .
     1242       end.
     1243       else do:
     1244         assign
     1245           v-search-exp = substitute( "&1 =", v-search-exp )
     1246         .
     1247       end.
     1248       if fh:data-type ="character":U then do:
     1249         assign
     1250           v-search-exp = substitute( '&1 "&2"', v-search-exp, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
     1251         .
     1252       end.
     1253       else do:
     1254         assign
     1255           v-search-exp = substitute( '&1 &2', v-search-exp, fh:buffer-value() )
     1256         .
     1257       end.
     1258       if v-word-link = "":U then do:
     1259         assign
     1260           v-word-link = "and":U
     1261         .
     1262       end.
     1263     end.
     1264     if v-av-chip-num = false then do:
     1265       message
     1266         vss-workfile vss-revision vss-description skip
     1267         substitute( "Таблица &2 не содержит поля chip-num.", vss-workfile, p-hst-handle:name ) skip
     1268         "Использование данной процедуры невозможно!" skip
     1269         view-as alert-box error .
     1270       return error .
     1271     end.
     1272     h-new-buf:find-first( v-search-exp, no-lock ) no-error .
     1273     if not h-new-buf:available then do:
     1274       h-main-buf:find-first( v-srch-main, no-lock ) no-error .
     1275       if not h-main-buf:available then do:
     1276         assign
     1277           h-for-comp = ?
     1278         .
     1279       end.
     1280       else do:
     1281         assign
     1282           h-for-comp = h-main-buf
     1283         .
     1284       end.
     1285     end.
     1286     else do:
     1287       assign
     1288         h-for-comp = h-new-buf
     1289       .
     1290     end.
     1291     assign
     1292       v-num-entries = num-entries( v-main-fld-lst, ",":U )
     1293     .
     1294     do v-ind = 1 to v-num-entries
     1295     on error undo, return error return-value
     1296     :
     1297       assign
     1298         v-field-name = entry( v-ind, v-main-fld-lst )
     1299         fh-old       = p-hst-handle:buffer-field( v-field-name )
     1300         v-old-value  = fh-old:buffer-value()
     1301         v-label      = trim( fh-old:label )
     1302       .
     1303       if ( trim( p-field-list ) <> "":U
     1304            and lookup( v-field-name, p-field-list ) > 0
     1305          )
     1306          or trim( p-field-list ) = "":U
     1307       then do:
     1308         if h-for-comp <> ? then do:
     1309           assign
     1310             fh-new      = h-for-comp:buffer-field( v-field-name )
     1311             v-new-value = fh-new:buffer-value()
     1312           .
     1313         end.
     1314         else do:
     1315           assign
     1316             v-new-value = "":U
     1317           .
     1318         end.
     1319         if v-old-value <> v-new-value
     1320         then do:
     1321           create temp-changes.
     1322           assign
     1323             temp-changes.t_name = p-main-table
     1324             temp-changes.f_name = v-field-name
     1325             temp-changes.l_name = replace( v-label, "&":U, "":U )
     1326             temp-changes.v_old  = trim( v-old-value )
     1327             temp-changes.v_new  = trim( v-new-value )
     1328             temp-changes.num_   = 0
     1329             temp-changes.fNotChange = v-old-value eq v-new-value
     1330           .
     1331         end.
     1332       end.
     1333     end.
     1334     assign
     1335       v-num-entries = num-entries( p-label-form, chr(8) )
     1336     .
     1337     do v-ind = 1 to v-num-entries
     1338     on error undo, return error return-value
     1339     :
     1340       if num-entries( entry( v-ind, p-label-form, chr(8) ), chr(4) ) = 3 then do:
     1341         assign
     1342           v-field-name = entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1343           v-field-lvl  = entry( 2, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1344           v-field-form = entry( 3, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1345         .
     1346         find first temp-changes
     1347           where temp-changes.f_name = v-field-name
     1348           no-error .
     1349         if available temp-changes then do:
     1350           if trim( v-field-lvl ) <> "":U then do:
     1351             assign
     1352               temp-changes.l_name = v-field-lvl
     1353             .
     1354           end.
     1355           if trim( v-field-form ) <> "":U then do:
     1356             assign
     1357               temp-changes.v_old = dynamic-function( v-field-form, temp-changes.v_old )
     1358             .
     1359             if h-for-comp <> ? then do:
     1360               assign
     1361                 temp-changes.v_new = dynamic-function( v-field-form, temp-changes.v_new )
     1362               .
     1363             end.
     1364           end.
     1365         end.
     1366       end.
     1367       else do:
     1368         message
     1369           vss-workfile vss-revision vss-description skip
     1370           "Ошибка! Список должен содержать три поля с разделителем delim-par!" skip
     1371           substitute( "список для поля '&1': '&2'"
     1372                       ,entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1373                       ,entry( v-ind, p-label-form, chr(8) )
     1374                     ) skip
     1375           substitute( "полный список: &2", p-label-form ) skip
     1376           view-as alert-box error .
     1377       end.
     1378     end.
     1379     delete object h-new-buf .
     1380     delete object h-main-buf .
     1381   END PROCEDURE.
     1382   FUNCTION get-action RETURNS CHARACTER
     1383     ( p-action as integer )  FORWARD.
     1384   FUNCTION get-place RETURNS CHARACTER
     1385     ( p-obj-type as character, p-obj-code as integer, p-pl-code as integer )  FORWARD.
     1386   FUNCTION get-subject RETURNS CHARACTER
     1387     ( p-subject as character )  FORWARD.
     1388   DEFINE BUTTON B-Help
     1389        LABEL "Помо&щь"
     1390        SIZE 3 BY 1
     1391        BGCOLOR 8 .
     1392   DEFINE BUTTON B-lookup
     1393        LABEL "&Просмотр"
     1394        SIZE 10 BY 1.
     1395   DEFINE BUTTON B-mark
     1396        LABEL "&*"
     1397        SIZE 3 BY 1.
     1398   DEFINE BUTTON b-pl-gds-rest
     1399        LABEL "&Остатки"
     1400        SIZE 10 BY 1.
     1401   DEFINE BUTTON B-print
     1402        LABEL "Пе&чать"
     1403        SIZE 3 BY 1.
     1404   DEFINE BUTTON b-quit AUTO-END-KEY
     1405        LABEL "&Выход"
     1406        SIZE 10 BY 1
     1407        BGCOLOR 8 .
     1408   DEFINE BUTTON B-sch
     1409        LABEL "&Фильтр"
     1410        SIZE 3 BY 1.
     1411   DEFINE BUTTON b-sel AUTO-GO
     1412        LABEL "Вы&бор"
     1413        SIZE 10 BY 1
     1414        BGCOLOR 8 .
     1415   DEFINE VARIABLE mark-num AS CHARACTER FORMAT "X(256)":U
     1416         VIEW-AS TEXT
     1417        SIZE 6 BY 1
     1418        FGCOLOR 4  NO-UNDO.
     1419   DEFINE VARIABLE sch-corr-date AS DATE FORMAT "99/99/9999":U
     1420        LABEL "Дате изменения"
     1421        VIEW-AS FILL-IN
     1422        SIZE 11 BY 1 NO-UNDO.
     1423   DEFINE VARIABLE sch-corr-user-name AS CHARACTER FORMAT "X(9)":U
     1424        LABEL "пользователю"
     1425        VIEW-AS FILL-IN
     1426        SIZE 12 BY 1 TOOLTIP "Поиск первой записи - <ВВОД>; поиск следующей - <CTRL-J>" NO-UNDO.
     1427   DEFINE VARIABLE sch-pl-code AS INTEGER FORMAT ">>>>>>9":U INITIAL 0
     1428        LABEL "коду скл.места"
     1429        VIEW-AS FILL-IN
     1430        SIZE 8 BY 1 TOOLTIP "Поиск первой записи - <ВВОД>; поиск следующей - <CTRL-J>" NO-UNDO.
     1431   DEFINE QUERY BR-changes FOR
     1432         temp-changes SCROLLING.
     1433   DEFINE QUERY br-plc-hist FOR
     1434         X_c-plc-hist SCROLLING.
     1435   DEFINE BROWSE BR-changes
     1436     QUERY BR-changes DISPLAY
     1437         temp-changes.l_name COLUMn-LABEL "Изменилось" format "X(40)"
     1438   temp-changes.v_old COLUMn-LABEL "Было" format "X(70)"
     1439   temp-changes.v_new COLUMn-LABEL "Стало" format "X(70)"
     1440       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 7.25.
     1441   DEFINE BROWSE br-plc-hist
     1442     QUERY br-plc-hist NO-LOCK DISPLAY
     1443         mark-string(recid(X_c-plc-hist), v-rid-list) COLUMN-LABEL "*" FORMAT "X(1)":U
     1444         X_c-plc-hist.pl-code COLUMN-LABEL "Код скл.места" FORMAT "999999999":U
     1445         X_c-plc-hist.corr-date FORMAT "99/99/9999":U
     1446         string(X_c-plc-hist.corr-time, "HH:MM:SS":U) COLUMN-LABEL "Время изм." FORMAT "X(8)":U
     1447         usrfulnf(X_c-plc-hist.corr-user-name) FORMAT "X(18)":U
     1448         get-action(X_c-plc-hist.action) COLUMN-LABEL "Действие" FORMAT "X(10)":U
     1449         X_c-plc-hist.corr-user-db-num FORMAT ">>>>9":U
     1450         if v-find then get-place(X_c-plc-hist.obj-type, X_c-plc-hist.obj-code, X_c-plc-hist.pl-code) else "":U COLUMN-LABEL "Назв. складского места" FORMAT "X(25)":U
     1451         get-subject(X_c-plc-hist.subject) COLUMN-LABEL "Предмет изменений" FORMAT "X(15)":U
     1452         X_c-plc-hist.obj-type + string(X_c-plc-hist.obj-code) COLUMN-LABEL "Объект" FORMAT "X(8)":U
     1453     ENABLE
     1454         X_c-plc-hist.corr-DATE
     1455       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 11.46.
     1456   DEFINE FRAME Dialog-Frame
     1457        b-quit AT ROW 1 COL 1
     1458        B-mark AT ROW 1 COL 11
     1459        b-sel AT ROW 1 COL 21
     1460        b-pl-gds-rest AT ROW 1 COL 55
     1461        B-print AT ROW 1 COL 89
     1462        B-sch AT ROW 1 COL 92
     1463        B-Help AT ROW 1 COL 95
     1464        B-lookup AT ROW 1.04 COL 45
     1465        br-plc-hist AT ROW 2 COL 1
     1466        sch-corr-date AT ROW 13.63 COL 85.75 COLON-ALIGNED
     1467        sch-pl-code AT ROW 13.67 COL 56.13 COLON-ALIGNED
     1468        sch-corr-user-name AT ROW 13.71 COL 22.5 COLON-ALIGNED
     1469        BR-changes AT ROW 14.79 COL 1
     1470        mark-num AT ROW 1 COL 12.5 COLON-ALIGNED NO-LABEL
     1471        "ПОИСК ПО" VIEW-AS TEXT
     1472             SIZE 8.38 BY 1 AT ROW 13.63 COL 1.38
     1473             FGCOLOR 4
     1474        SPACE(89.48) SKIP(7.44)
     1475       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1476            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1477            TITLE "Полная история по складскому месту"
     1478            CANCEL-BUTTON b-quit.
     1479   ASSIGN
     1480          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1481          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1482   ASSIGN
     1483          br-plc-hist:COLUMN-RESIZABLE IN FRAME Dialog-Frame       = TRUE.
     1484   ON GO OF FRAME Dialog-Frame
     1485   DO:
     1486     p-rid-list = v-rid-list.
     1487   END.
     1488   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1489   DO:
     1490     APPLY "END-ERROR":U TO SELF.
     1491   END.
     1492   ON CHOOSE OF B-lookup IN FRAME Dialog-Frame
     1493   DO:
     1494     DEFINE VARIABLE v-rec AS RECID NO-UNDO.
     1495     DEFINE BUFFER buf_c-place FOR ub.c-place.
     1496     DEFINE BUFFER buf_c-pl-gds FOR ub.c-pl-gds.
     1497     DEFINE BUFFER buf_c-pl-gds-pump FOR ub.c-pl-gds-pump.
     1498     DEFINE BUFFER buf_c-pl-pump FOR ub.c-pl-pump.
     1499     DEFINE BUFFER buf_c-pl-pump-nozzle FOR ub.c-pl-pump-nozzle.
     1500       IF AVAILABLE X_c-plc-hist THEN DO:
     1501       CASE X_c-plc-hist.subject:
     1502         WHEN 'place':U THEN DO:
     1503           find first buf_c-place no-lock where
     1504                  buf_c-place.obj-type = p-obj-type
     1505              AND buf_c-place.obj-code = p-obj-code
     1506              AND buf_c-place.pl-code = X_c-plc-hist.pl-code
     1507              AND buf_c-place.chip-num = X_c-plc-hist.chip-num
     1508              AND buf_c-place.corr-user-db-num = X_c-plc-hist.corr-user-db-num
     1509              no-error .
     1510              ASSIGN v-rec = RECID(buf_c-place).
     1511               run str/c-placea.w (
     1512                              INPUT 'ПРОСМОТР':U
     1513                             ,INPUT-OUTPUT v-rec) NO-ERROR.
     1514           END.
     1515         WHEN 'pl-gds':U THEN DO:
     1516           find first buf_c-pl-gds no-lock where
     1517                  buf_c-pl-gds.obj-type = p-obj-type
     1518              AND buf_c-pl-gds.obj-code = p-obj-code
     1519              AND buf_c-pl-gds.pl-code = X_c-plc-hist.pl-code
     1520              AND buf_c-pl-gds.chip-num = X_c-plc-hist.chip-num
     1521              AND buf_c-pl-gds.corr-user-db-num = X_c-plc-hist.corr-user-db-num
     1522              no-error .
     1523              ASSIGN v-rec = RECID(buf_c-pl-gds).
     1524               run str/cpl-gdsa.w (
     1525                              INPUT 'ПРОСМОТР':U
     1526                             ,INPUT-OUTPUT v-rec) NO-ERROR.
     1527         END.
     1528       END CASE.
     1529     END.
     1530   END.
     1531   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
     1532   DO:
     1533   define variable loc#log as logical no-undo .
     1534     if available X_c-plc-hist then do:
     1535   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1536   define variable v-str-recid14 as character no-undo .
     1537   define variable v-num-entry14 as integer   no-undo .
     1538   assign
     1539     v-str-recid14 = trim( string( recid( X_c-plc-hist ) , "->>>>>>>>>>>9":U ) )
     1540     v-num-entry14 = lookup( v-str-recid14 , v-rid-list )
     1541   .
     1542   if v-num-entry14 > 0 then do:
     1543     assign
     1544       entry( v-num-entry14, v-rid-list ) = "":U
     1545       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1546     .
     1547   end.
     1548   else do:
     1549     assign
     1550       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid14
     1551     .
     1552   end.
     1553       loc#log = br-plc-hist:refresh() .
     1554       if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
     1555           loc#log = br-plc-hist:select-next-row ().
     1556           apply "VALUE-CHANGED" to br-plc-hist in frame Dialog-Frame.
     1557       end.
     1558       if num-entries( v-rid-list ) = 0
     1559       then
     1560           hide mark-num in frame Dialog-Frame.
     1561       else
     1562           disp num-entries( v-rid-list ) @ mark-num with frame Dialog-Frame.
     1563     end.
     1564     apply "entry" to br-plc-hist in frame Dialog-Frame.
     1565   END.
     1566   ON CHOOSE OF b-pl-gds-rest IN FRAME Dialog-Frame
     1567   DO:
     1568     if not available X_c-plc-hist then return no-apply.
     1569     if p-mode = 'subject':U
     1570     and p-subject = 'pl-gds':U then do:
     1571       run ref/cplgdsob.w (
     1572                     input parparentproc
     1573                     ,input 'one':U
     1574                     ,input X_c-plc-hist.obj-type
     1575                     ,input X_c-plc-hist.obj-code
     1576                     ,input X_c-plc-hist.pl-code
     1577                     ,input X_c-plc-hist.gds-code
     1578                     ) no-error .
     1579     end.
     1580     else do:
     1581       run ref/cplgdsob.w (
     1582                     input parparentproc
     1583                     ,input 'place':U
     1584                     ,input X_c-plc-hist.obj-type
     1585                     ,input X_c-plc-hist.obj-code
     1586                     ,input X_c-plc-hist.pl-code
     1587                     ,input 0
     1588                     ) no-error .
     1589     end.
     1590   END.
     1591   ON CHOOSE OF B-print IN FRAME Dialog-Frame
     1592   DO:
     1593       run proc-b-print in this-procedure no-error.
     1594     if error-status:error then return no-apply.
     1595   END.
     1596   ON CHOOSE OF B-sch IN FRAME Dialog-Frame
     1597   DO:
     1598       run proc-b-sch in this-procedure no-error.
     1599     if error-status:error then return no-apply.
     1600   END.
     1601   ON CHOOSE OF b-sel IN FRAME Dialog-Frame
     1602   DO:
     1603     if ( available X_c-plc-hist ) then do:
     1604       if ( v-rid-list = "" ) or b-mark:sensitive = no
     1605       then
     1606       v-rid-list = string( recid( X_c-plc-hist ) ) .
     1607     end.
     1608   END.
     1609   ON MOUSE-SELECT-DBLCLICK OF br-plc-hist IN FRAME Dialog-Frame
     1610   DO:
     1611        run proc-br-plc-hist in this-procedure no-error.
     1612     if error-status:error then return no-apply.
     1613   END.
     1614   ON RETURN OF br-plc-hist IN FRAME Dialog-Frame
     1615   DO:
     1616       run proc-br-plc-hist in this-procedure no-error.
     1617     if error-status:error then return no-apply.
     1618   END.
     1619   ON VALUE-CHANGED OF br-plc-hist IN FRAME Dialog-Frame
     1620   DO:
     1621     run proc-view-changes in this-procedure no-error.
     1622   END.
     1623   ON CTRL-J OF sch-corr-date IN FRAME Dialog-Frame
     1624   DO:
     1625      run proc-find-corr-date in this-procedure ( input yes, input frame Dialog-Frame sch-corr-date) no-error.
     1626     if error-status:error then return no-apply.
     1627   END.
     1628   ON RETURN OF sch-corr-date IN FRAME Dialog-Frame
     1629   DO:
     1630     run proc-find-corr-date in this-procedure ( input no, input frame Dialog-Frame sch-corr-date) no-error.
     1631     if error-status:error then return no-apply.
     1632   END.
     1633   ON CTRL-J OF sch-corr-user-name IN FRAME Dialog-Frame
     1634   DO:
     1635     run proc-find-user in this-procedure ( input yes, input frame Dialog-Frame sch-corr-user-name) no-error.
     1636     if error-status:error then return no-apply.
     1637   END.
     1638   ON RETURN OF sch-corr-user-name IN FRAME Dialog-Frame
     1639   DO:
     1640     run proc-find-user in this-procedure ( input no, input frame Dialog-Frame sch-corr-user-name) no-error.
     1641     if error-status:error then return no-apply.
     1642   END.
     1643   ON CTRL-J OF sch-pl-code IN FRAME Dialog-Frame
     1644   DO:
     1645     run proc-find-pl-code in this-procedure ( input yes, input frame Dialog-Frame sch-pl-code) no-error.
     1646     if error-status:error then return no-apply.
     1647   END.
     1648   ON RETURN OF sch-pl-code IN FRAME Dialog-Frame
     1649   DO:
     1650     run proc-find-pl-code in this-procedure ( input no, input frame Dialog-Frame sch-pl-code) no-error.
     1651     if error-status:error then return no-apply.
     1652   END.
     1653   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1654   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1655   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1656   on help of frame Dialog-Frame
     1657   do:
     1658     run gbl/app_help.p
     1659       (input this-procedure :file-name
     1660       ,input ''
     1661       ,input ?
     1662       ) no-error.
     1663     if error-status :error then do:
     1664       message
     1665         "Ошибка при вызове помощи"
     1666         error-status :get-message(1)
     1667         view-as alert-box .
     1668     end.
     1669   end.
     1670   run minbtn-set in this-procedure .
     1671   on choose of b-help in frame Dialog-Frame
     1672   do:
     1673     apply "help":u to frame Dialog-Frame .
     1674   end.
     1675   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1676   procedure minbtn-set :
     1677       do
     1678           on error undo, return error return-value
     1679           :
     1680           define variable ii              as integer       no-undo .
     1681           define variable fh              as widget-handle no-undo .
     1682           define variable hh              as widget-handle no-undo .
     1683           define variable v-h             as handle        extent 4 no-undo .
     1684           define variable v-name-button   as character     no-undo .
     1685           define variable v-help-old-x    as decimal       no-undo .
     1686           define variable v-help-old-y    as decimal       no-undo .
     1687           define variable v-help-old-size as decimal       no-undo .
     1688           define variable v-frame-width   as decimal       no-undo .
     1689           define variable jj              as integer       no-undo .
     1690           do
     1691               on error undo, return error
     1692               :
     1693               assign
     1694                   v-frame-width = frame Dialog-Frame:width - 0.3
     1695                   fh            = frame Dialog-Frame:first-child
     1696                   hh            = fh:first-child
     1697                   ii            = 1
     1698                   .
     1699               do while valid-handle(hh):
     1700                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1701                   do:
     1702                       case lc(hh:name) :
     1703                           when "b-help" then
     1704                               do:
     1705                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1706                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1707                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1708                                   hh:TOOLTIP = "Помощь" .
     1709                                   v-help-old-x = hh:column .
     1710                                   v-help-old-y = hh:row    .
     1711                                   v-help-old-size = hh:width .
     1712                                   hh:width-chars = 2.5 .
     1713                               end.
     1714                           when "b-print" then
     1715                               do:
     1716                                   hh:load-image("cmp/b-print.bmp":u) .
     1717                                   hh:TOOLTIP = "Печать" .
     1718                                   v-h[ii] = hh:handle .
     1719                                   ii = ii + 1 .
     1720                                   hh:width-chars = 3 .
     1721                               end.
     1722                           when "b-history" or
     1723                           when "b-hist" then
     1724                               do:
     1725                                   hh:load-image("cmp/b-hist.bmp":u) .
     1726                                   hh:TOOLTIP = "История" .
     1727                                   v-h[ii] = hh:handle .
     1728                                   ii = ii + 1 .
     1729                                   hh:width-chars = 3 .
     1730                               end.
     1731                           when "b-sch" then
     1732                               do:
     1733                                   hh:load-image("cmp/b-sch.bmp":u) .
     1734                                   hh:TOOLTIP = "Установка Фильтра" .
     1735                                   v-h[ii] = hh:handle .
     1736                                   ii = ii + 1 .
     1737                                   hh:width-chars = 3 .
     1738                               end.
     1739                           when "b-hist-user" then
     1740                               do:
     1741                                   hh:load-image("cmp/b-hist.bmp":u) .
     1742                                   hh:TOOLTIP = "История пользователя" .
     1743                                   ii = ii + 1 .
     1744                               end.
     1745                       end case.
     1746                   end.
     1747                   hh = hh:next-sibling.
     1748               end.
     1749               b-help:column = v-frame-width - b-help:width-chars.
     1750               jj = 0.
     1751               repeat ii = 4 to 1 by -1 :
     1752                   if valid-handle (v-h[ii] ) then
     1753                   do:
     1754                       jj  = jj + 1 .
     1755                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1756                       v-h[ii]:row    = v-help-old-y .
     1757                   end.
     1758               end.
     1759           end.
     1760       end.
     1761   end procedure.
     1762   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1763   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1764   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1765   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1766   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1767   define variable v-diasize-current-frame-height as decimal   no-undo .
     1768   define variable v-diasize-change-size          as logical   no-undo .
     1769   define variable v-diasize-resize-button        as handle    no-undo .
     1770   define variable v-diasize-wndmax               as logical   no-undo .
     1771   define variable v-diasize-wndstore             as logical   no-undo .
     1772   define variable v-diasize-proc-name            as character no-undo .
     1773   define variable v-diasize-browse-handle        as handle    no-undo .
     1774   define variable v-diasize-browse-number        as integer   no-undo .
     1775   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1776   define temp-table temp-diasize-handle no-undo
     1777     field handle-value  as handle
     1778     field save-position as decimal
     1779     index xpk is primary unique handle-value
     1780     .
     1781   define temp-table temp-browse-handle no-undo
     1782     field browse-type   as character
     1783     field browse-number as integer
     1784     field browse-handle as handle
     1785     field original-size as decimal
     1786     index xpk is primary unique browse-type browse-number
     1787     index xie browse-type browse-handle
     1788   .
     1789   procedure diasize_change-height :
     1790     define input  parameter p-change-value  as decimal   no-undo .
     1791     define input  parameter p-move-resize   as logical   no-undo .
     1792     define variable v-field-group-handle    as handle    no-undo .
     1793     define variable v-object-handle         as handle    no-undo .
     1794     define variable v-frame-height          as decimal   no-undo .
     1795     define variable v-frame-virtual-height  as decimal   no-undo .
     1796     define variable v-browse-height         as decimal   no-undo .
     1797     define variable v-window-height         as decimal   no-undo .
     1798     define variable v-window-virtual-height as decimal   no-undo .
     1799     define variable v-change-sign           as integer   no-undo .
     1800     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1801     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1802     if p-change-value > 0
     1803     then do:
     1804       if frame Dialog-Frame :height + p-change-value
     1805           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1806       then do:
     1807         assign
     1808           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1809                           - (frame Dialog-Frame :height-chars)
     1810         .
     1811         if p-change-value <= 0
     1812         then do:
     1813           run diasize_position-resize-button in this-procedure .
     1814           return .
     1815         end.
     1816       end.
     1817     end.
     1818     if p-change-value < 0
     1819     then do:
     1820       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1821       then do:
     1822         assign
     1823           p-change-value = v-diasize-orig-frame-height
     1824                          - (frame Dialog-Frame :height-chars)
     1825         .
     1826         if p-change-value >= 0
     1827         then do:
     1828           run diasize_position-resize-button in this-procedure .
     1829           return .
     1830         end.
     1831       end.
     1832     end.
     1833     if p-change-value >= 0
     1834     then do:
     1835       assign
     1836         v-change-sign = 1
     1837       .
     1838     end.
     1839     else do:
     1840       assign
     1841         v-change-sign = -1
     1842       .
     1843     end.
     1844     assign
     1845       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1846     .
     1847     if p-change-value = 0
     1848     then do:
     1849       run diasize_position-resize-button in this-procedure .
     1850       return .
     1851     end.
     1852     move_block:
     1853     do
     1854     on error undo move_block, retry move_block
     1855     :
     1856       if retry
     1857       then do:
     1858         do
     1859         on error undo move_block, leave move_block
     1860         :
     1861           if p-change-value > 0
     1862           then do:
     1863             for each buf_temp-diasize-handle
     1864             on error undo, next
     1865             :
     1866               assign
     1867                 v-object-handle = buf_temp-diasize-handle.handle-value
     1868               .
     1869               if v-object-handle <> v-diasize-resize-button
     1870               then do:
     1871                 assign
     1872                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1873                 .
     1874               end.
     1875             end.
     1876             assign
     1877               v-diasize-browse-handle :height = v-browse-height
     1878             .
     1879             for each buf_temp-browse-handle
     1880               where buf_temp-browse-handle.browse-type = 'height':u
     1881             on error undo, next
     1882             :
     1883               assign
     1884                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1885               .
     1886             end.
     1887             assign
     1888               frame Dialog-Frame :height = v-frame-height
     1889             .
     1890             if frame Dialog-Frame :scrollable = true
     1891             then do:
     1892               assign
     1893                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1894               .
     1895             end.
     1896             run diasize_position-resize-button in this-procedure .
     1897           end.
     1898           else do:
     1899             if frame Dialog-Frame :scrollable = true
     1900             then do:
     1901               assign
     1902                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1903               .
     1904             end.
     1905             assign
     1906               frame Dialog-Frame :height = v-frame-height
     1907             .
     1908             assign
     1909               v-diasize-browse-handle :height = v-browse-height
     1910             .
     1911             for each buf_temp-browse-handle
     1912               where buf_temp-browse-handle.browse-type = 'height':u
     1913             on error undo, next
     1914             :
     1915               assign
     1916                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1917               .
     1918             end.
     1919             for each buf_temp-diasize-handle
     1920             on error undo, next
     1921             :
     1922               assign
     1923                 v-object-handle = buf_temp-diasize-handle.handle-value
     1924               .
     1925               if v-object-handle <> v-diasize-resize-button
     1926               then do:
     1927                 assign
     1928                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1929                 .
     1930               end.
     1931             end.
     1932             run diasize_position-resize-button in this-procedure .
     1933           end.
     1934           assign
     1935             v-diasize-change-size = false
     1936           .
     1937           leave move_block .
     1938         end.
     1939       end.
     1940       assign
     1941         v-diasize-need-full-display = true
     1942       .
     1943       if v-diasize-change-size = false
     1944       then do:
     1945         assign
     1946           v-diasize-change-size = true
     1947         .
     1948       end.
     1949       else do:
     1950         return .
     1951       end.
     1952       assign
     1953         v-frame-height = frame Dialog-Frame :height
     1954         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1955         v-browse-height = v-diasize-browse-handle :height
     1956       .
     1957       for each buf_temp-browse-handle
     1958         where buf_temp-browse-handle.browse-type = 'height':u
     1959       :
     1960         assign
     1961           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1962         .
     1963       end.
     1964       for each buf_temp-diasize-handle
     1965       :
     1966         delete buf_temp-diasize-handle .
     1967       end.
     1968       assign
     1969         v-field-group-handle = frame Dialog-Frame :first-child
     1970       .
     1971       do while valid-handle(v-field-group-handle)
     1972       :
     1973         assign
     1974           v-object-handle = v-field-group-handle :first-child
     1975         .
     1976         do while valid-handle(v-object-handle)
     1977         :
     1978           if  v-object-handle <> v-diasize-browse-handle :handle
     1979           and can-query(v-object-handle, "row")
     1980           and can-query(v-object-handle, "height")
     1981           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1982           then do:
     1983             find first buf_temp-browse-handle
     1984               where buf_temp-browse-handle.browse-type   = 'height':u
     1985                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1986               no-error .
     1987             if available buf_temp-browse-handle
     1988             then do:
     1989             end.
     1990             else do:
     1991               create buf_temp-diasize-handle .
     1992               assign
     1993                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1994                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1995               .
     1996             end.
     1997           end.
     1998           assign
     1999             v-object-handle = v-object-handle :next-sibling
     2000           .
     2001         end.
     2002         assign
     2003           v-field-group-handle = v-field-group-handle :next-sibling
     2004         .
     2005       end.
     2006       do with frame Dialog-Frame
     2007       :
     2008         hide v-diasize-resize-button .
     2009         assign
     2010           v-diasize-resize-button :row    = 1
     2011           v-diasize-resize-button :column = 1
     2012         .
     2013       end.
     2014       if p-change-value > 0
     2015       then do:
     2016         if frame Dialog-Frame :scrollable = true
     2017         then do:
     2018           assign
     2019             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2020             no-error .
     2021           if error-status :error
     2022           or error-status :get-message(1) <> ""
     2023           then do:
     2024             undo move_block, retry move_block .
     2025           end.
     2026         end.
     2027         assign
     2028           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2029           no-error .
     2030         if error-status :error
     2031         or error-status :get-message(1) <> ""
     2032         then do:
     2033           undo move_block, retry move_block .
     2034         end.
     2035         assign
     2036           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2037           no-error .
     2038         if error-status :error
     2039         or error-status :get-message(1) <> ""
     2040         then do:
     2041           undo move_block, retry move_block .
     2042         end.
     2043         for each buf_temp-browse-handle
     2044           where buf_temp-browse-handle.browse-type = 'height':u
     2045         on error undo move_block, retry move_block
     2046         :
     2047           assign
     2048             buf_temp-browse-handle.browse-handle :height
     2049               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2050             no-error .
     2051           if error-status :error
     2052           or error-status :get-message(1) <> ""
     2053           then do:
     2054             undo move_block, retry move_block .
     2055           end.
     2056         end.
     2057         for each buf_temp-diasize-handle
     2058         on error undo move_block, retry move_block
     2059         :
     2060           assign
     2061             v-object-handle = buf_temp-diasize-handle.handle-value
     2062           .
     2063           if v-object-handle <> v-diasize-resize-button
     2064           then do:
     2065             assign
     2066               v-object-handle :row = v-object-handle :row + p-change-value
     2067               no-error .
     2068             if error-status :error
     2069             or error-status :get-message(1) <> ""
     2070             then do:
     2071               undo move_block, retry move_block .
     2072             end.
     2073           end.
     2074         end.
     2075       end.
     2076       else do:
     2077         for each buf_temp-diasize-handle
     2078         on error undo move_block, retry move_block
     2079         :
     2080           assign
     2081             v-object-handle = buf_temp-diasize-handle.handle-value
     2082           .
     2083           if v-object-handle <> v-diasize-resize-button
     2084           then do:
     2085             assign
     2086               v-object-handle :row = v-object-handle :row + p-change-value
     2087               no-error .
     2088             if error-status :error
     2089             or error-status :get-message(1) <> ""
     2090             then do:
     2091               undo move_block, retry move_block .
     2092             end.
     2093           end.
     2094         end.
     2095         assign
     2096           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2097           no-error .
     2098         if error-status :error
     2099         or error-status :get-message(1) <> ""
     2100         then do:
     2101           undo move_block, retry move_block .
     2102         end.
     2103         for each buf_temp-browse-handle
     2104           where buf_temp-browse-handle.browse-type = 'height':u
     2105         on error undo move_block, retry move_block
     2106         :
     2107           assign
     2108             buf_temp-browse-handle.browse-handle :height
     2109               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2110             no-error .
     2111           if error-status :error
     2112           or error-status :get-message(1) <> ""
     2113           then do:
     2114             undo move_block, retry move_block .
     2115           end.
     2116         end.
     2117         assign
     2118           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2119           no-error .
     2120         if error-status :error
     2121         or error-status :get-message(1) <> ""
     2122         then do:
     2123           undo move_block, retry move_block .
     2124         end.
     2125         if frame Dialog-Frame :scrollable = true
     2126         then do:
     2127           assign
     2128             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2129             no-error .
     2130           if error-status :error
     2131           or error-status :get-message(1) <> ""
     2132           then do:
     2133             undo move_block, retry move_block .
     2134           end.
     2135         end.
     2136       end.
     2137       if p-move-resize = true
     2138       then do:
     2139         run diasize_position-resize-button in this-procedure .
     2140       end.
     2141       if v-diasize-wndstore = true
     2142       then do:
     2143         if connected("ub") = true
     2144         then do:
     2145           define variable v-cntxt-db-num        as integer   no-undo .
     2146           define variable v-cntxt-userid        as character no-undo .
     2147           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2148                                             , OUTPUT v-cntxt-userid
     2149                                             ) .
     2150           run gbl/wndsizew.p
     2151             (input  v-cntxt-db-num
     2152             ,input  v-cntxt-userid
     2153             ,input  v-diasize-proc-name
     2154             ,input  'height':u
     2155             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     2156             ) .
     2157         end.
     2158       end.
     2159     end.
     2160     assign
     2161       v-diasize-change-size = false
     2162     .
     2163   end procedure.
     2164   procedure diasize_set-height :
     2165     define input  parameter p-new-height  as decimal   no-undo .
     2166     define input  parameter p-move-resize as logical   no-undo .
     2167     do
     2168     on error undo, return error return-value
     2169     :
     2170       run diasize_change-height in this-procedure
     2171         (input  (p-new-height - frame Dialog-Frame :height)
     2172         ,input  p-move-resize
     2173         ) .
     2174     end.
     2175   end procedure.
     2176   procedure diasize_change-width :
     2177     define input  parameter p-change-value as decimal   no-undo .
     2178     define input  parameter p-move-resize  as logical   no-undo .
     2179     define variable v-field-group-handle   as handle    no-undo .
     2180     define variable v-object-handle        as handle    no-undo .
     2181     define variable v-frame-width          as decimal   no-undo .
     2182     define variable v-frame-virtual-width  as decimal   no-undo .
     2183     define variable v-browse-width         as decimal   no-undo .
     2184     define variable v-window-width         as decimal   no-undo .
     2185     define variable v-window-virtual-width as decimal   no-undo .
     2186     define variable v-change-sign          as integer   no-undo .
     2187     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2188     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2189     if p-change-value > 0
     2190     then do:
     2191       if frame Dialog-Frame :width + p-change-value >
     2192           session :width-chars
     2193       then do:
     2194         assign
     2195           p-change-value = session :width-chars - frame Dialog-Frame :width
     2196         .
     2197         if p-change-value <= 0
     2198         then do:
     2199           run diasize_position-resize-button in this-procedure .
     2200           return .
     2201         end.
     2202       end.
     2203     end.
     2204     if p-change-value < 0
     2205     then do:
     2206       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     2207       then do:
     2208         assign
     2209           p-change-value = v-diasize-orig-frame-width
     2210                          - frame Dialog-Frame :width
     2211         .
     2212         if p-change-value >= 0
     2213         then do:
     2214           run diasize_position-resize-button in this-procedure .
     2215           return .
     2216         end.
     2217       end.
     2218     end.
     2219     if p-change-value >= 0
     2220     then do:
     2221       assign
     2222         v-change-sign = 1
     2223       .
     2224     end.
     2225     else do:
     2226       assign
     2227         v-change-sign = -1
     2228       .
     2229     end.
     2230     assign
     2231       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2232     .
     2233     if p-change-value = 0
     2234     then do:
     2235       run diasize_position-resize-button in this-procedure .
     2236       return .
     2237     end.
     2238     move_block:
     2239     do
     2240     on error undo move_block, leave move_block
     2241     :
     2242       if retry
     2243       then do:
     2244         do
     2245         on error undo move_block, leave move_block
     2246         :
     2247           if p-change-value > 0
     2248           then do:
     2249             for each buf_temp-diasize-handle
     2250             on error undo, next
     2251             :
     2252               assign
     2253                 v-object-handle = buf_temp-diasize-handle.handle-value
     2254               .
     2255               if v-object-handle <> v-diasize-resize-button
     2256               then do:
     2257                 assign
     2258                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2259                 .
     2260               end.
     2261             end.
     2262             assign
     2263               v-diasize-browse-handle :width = v-browse-width
     2264             .
     2265             for each buf_temp-browse-handle
     2266               where buf_temp-browse-handle.browse-type = 'width':u
     2267             on error undo, next
     2268             :
     2269               assign
     2270                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2271               .
     2272             end.
     2273             assign
     2274               frame Dialog-Frame :width = v-frame-width
     2275             .
     2276             if frame Dialog-Frame :scrollable = true
     2277             then do:
     2278               assign
     2279                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2280               .
     2281             end.
     2282             run diasize_position-resize-button in this-procedure .
     2283           end.
     2284           else do:
     2285             if frame Dialog-Frame :scrollable = true
     2286             then do:
     2287               assign
     2288                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2289               .
     2290             end.
     2291             assign
     2292               frame Dialog-Frame :width = v-frame-width
     2293             .
     2294             for each buf_temp-browse-handle
     2295               where buf_temp-browse-handle.browse-type = 'width':u
     2296             on error undo, next
     2297             :
     2298               assign
     2299                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2300               .
     2301             end.
     2302             assign
     2303               v-diasize-browse-handle :width = v-browse-width
     2304             .
     2305             for each buf_temp-diasize-handle
     2306             on error undo, next
     2307             :
     2308               assign
     2309                 v-object-handle = buf_temp-diasize-handle.handle-value
     2310               .
     2311               if v-object-handle <> v-diasize-resize-button
     2312               then do:
     2313                 assign
     2314                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2315                 .
     2316               end.
     2317             end.
     2318             run diasize_position-resize-button in this-procedure .
     2319           end.
     2320           assign
     2321             v-diasize-change-size = false
     2322           .
     2323           leave move_block .
     2324         end.
     2325       end.
     2326       assign
     2327         v-diasize-need-full-display = true
     2328       .
     2329       if v-diasize-change-size = false
     2330       then do:
     2331         assign
     2332           v-diasize-change-size = true
     2333         .
     2334       end.
     2335       else do:
     2336         return .
     2337       end.
     2338       assign
     2339         v-frame-width = frame Dialog-Frame :width
     2340         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     2341         v-browse-width = v-diasize-browse-handle :width
     2342       .
     2343       for each buf_temp-browse-handle
     2344         where buf_temp-browse-handle.browse-type = 'width':u
     2345       :
     2346         assign
     2347           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2348         .
     2349       end.
     2350       for each buf_temp-diasize-handle
     2351       :
     2352         delete buf_temp-diasize-handle .
     2353       end.
     2354       assign
     2355         v-field-group-handle = frame Dialog-Frame :first-child
     2356       .
     2357       do while valid-handle(v-field-group-handle)
     2358       :
     2359         assign
     2360           v-object-handle = v-field-group-handle :first-child
     2361         .
     2362         do while valid-handle(v-object-handle)
     2363         :
     2364           if  v-object-handle <> v-diasize-browse-handle :handle
     2365           and v-object-handle <> v-diasize-resize-button
     2366           and can-query(v-object-handle, "row")
     2367           and can-query(v-object-handle, "height")
     2368           and ( v-object-handle :col + v-object-handle :width
     2369                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2370               )
     2371           then do:
     2372             find first buf_temp-browse-handle
     2373               where buf_temp-browse-handle.browse-type   = 'width':u
     2374                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2375               no-error .
     2376             if available buf_temp-browse-handle
     2377             then do:
     2378             end.
     2379             else do:
     2380               create buf_temp-diasize-handle .
     2381               assign
     2382                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2383                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2384               .
     2385             end.
     2386           end.
     2387           assign
     2388             v-object-handle = v-object-handle :next-sibling
     2389           .
     2390         end.
     2391         assign
     2392           v-field-group-handle = v-field-group-handle :next-sibling
     2393         .
     2394       end.
     2395       do with frame Dialog-Frame
     2396       :
     2397         hide v-diasize-resize-button .
     2398         v-diasize-resize-button :row = 1.
     2399         v-diasize-resize-button :column = 1.
     2400       end.
     2401       if p-change-value > 0
     2402       then do:
     2403         if frame Dialog-Frame :scrollable = true
     2404         then do:
     2405           assign
     2406             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2407             no-error .
     2408           if error-status :error
     2409           or error-status :get-message(1) <> ""
     2410           then do:
     2411             undo move_block, retry move_block.
     2412           end.
     2413         end.
     2414         assign
     2415           frame Dialog-Frame :width = v-frame-width + p-change-value
     2416           no-error .
     2417         if error-status :error
     2418         or error-status :get-message(1) <> ""
     2419         then do:
     2420           undo move_block, retry move_block.
     2421         end.
     2422         assign
     2423           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2424         no-error .
     2425         if error-status :error
     2426         or error-status :get-message(1) <> ""
     2427         then do:
     2428           undo move_block, retry move_block.
     2429         end.
     2430         for each buf_temp-browse-handle
     2431           where buf_temp-browse-handle.browse-type = 'width':u
     2432         on error undo move_block, retry move_block
     2433         :
     2434           assign
     2435             buf_temp-browse-handle.browse-handle :width
     2436               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2437             no-error .
     2438           if error-status :error
     2439           or error-status :get-message(1) <> ""
     2440           then do:
     2441             undo move_block, retry move_block .
     2442           end.
     2443         end.
     2444         for each buf_temp-diasize-handle
     2445         on error undo move_block, retry move_block
     2446         :
     2447           assign
     2448             v-object-handle = buf_temp-diasize-handle.handle-value
     2449           .
     2450           if v-object-handle <> v-diasize-resize-button
     2451           then do:
     2452             assign
     2453               v-object-handle :col = v-object-handle :col + p-change-value
     2454               no-error .
     2455             if error-status :error
     2456             or error-status :get-message(1) <> ""
     2457             then do:
     2458               undo move_block, retry move_block .
     2459             end.
     2460           end.
     2461         end.
     2462       end.
     2463       else do:
     2464         for each buf_temp-diasize-handle
     2465         on error undo move_block, retry move_block
     2466         :
     2467           assign
     2468             v-object-handle = buf_temp-diasize-handle.handle-value
     2469           .
     2470           if v-object-handle <> v-diasize-resize-button
     2471           then do:
     2472             assign
     2473               v-object-handle :col = v-object-handle :col + p-change-value
     2474               no-error .
     2475             if error-status :error
     2476             or error-status :get-message(1) <> ""
     2477             then do:
     2478               undo move_block, retry move_block .
     2479             end.
     2480           end.
     2481         end.
     2482         for each buf_temp-browse-handle
     2483           where buf_temp-browse-handle.browse-type = 'width':u
     2484         on error undo move_block, retry move_block
     2485         :
     2486           assign
     2487             buf_temp-browse-handle.browse-handle :width
     2488               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2489             no-error .
     2490           if error-status :error
     2491           or error-status :get-message(1) <> ""
     2492           then do:
     2493             undo move_block, retry move_block .
     2494           end.
     2495         end.
     2496         assign
     2497           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2498           no-error .
     2499         if error-status :error
     2500         or error-status :get-message(1) <> ""
     2501         then do:
     2502           undo move_block, retry move_block.
     2503         end.
     2504         assign
     2505           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2506         no-error .
     2507         if error-status :error
     2508         or error-status :get-message(1) <> ""
     2509         then do:
     2510           undo move_block, retry move_block.
     2511         end.
     2512         if frame Dialog-Frame :scrollable = true
     2513         then do:
     2514           assign
     2515             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2516           no-error .
     2517           if error-status :error
     2518           or error-status :get-message(1) <> ""
     2519           then do:
     2520             undo move_block, retry move_block.
     2521           end.
     2522         end.
     2523       end.
     2524       if p-move-resize
     2525       then do:
     2526         run diasize_position-resize-button in this-procedure .
     2527       end.
     2528       if v-diasize-wndstore = true
     2529       then do:
     2530         if connected("ub") = true
     2531         then do:
     2532           define variable v-cntxt-db-num        as integer   no-undo .
     2533           define variable v-cntxt-userid        as character no-undo .
     2534           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2535                                             , OUTPUT v-cntxt-userid
     2536                                             ) .
     2537           run gbl/wndsizew.p
     2538             (input  v-cntxt-db-num
     2539             ,input  v-cntxt-userid
     2540             ,input  v-diasize-proc-name
     2541             ,input  'width':u
     2542             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2543             ) .
     2544         end.
     2545       end.
     2546     end.
     2547     assign
     2548       v-diasize-change-size = false
     2549     .
     2550   end procedure.
     2551   procedure diasize_set-width :
     2552     define input  parameter p-new-width  as decimal   no-undo .
     2553     define input  parameter p-move-resize as logical   no-undo .
     2554     do
     2555     on error undo, return error return-value
     2556     :
     2557       run diasize_change-width in this-procedure
     2558         (input  (p-new-width - frame Dialog-Frame :width)
     2559         ,input  p-move-resize
     2560         ) .
     2561     end.
     2562   end procedure.
     2563   procedure diasize_position-resize-button :
     2564     do with frame Dialog-Frame
     2565     :
     2566       hide v-diasize-resize-button .
     2567       assign
     2568         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2569                     - 1
     2570                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2571         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2572                     - 1
     2573                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2574       .
     2575       view v-diasize-resize-button .
     2576     end.
     2577   end procedure.
     2578   on alt-right anywhere
     2579   do:
     2580     run diasize_change-width in this-procedure
     2581       (input 1
     2582       ,input true
     2583       ) .
     2584     return no-apply .
     2585   end.
     2586   on alt-left anywhere
     2587   do:
     2588     run diasize_change-width in this-procedure
     2589       (input -1
     2590       ,input true
     2591       ) .
     2592     return no-apply .
     2593   end.
     2594   on alt-down anywhere
     2595   do:
     2596     run diasize_change-height in this-procedure
     2597       (input 1
     2598       ,input true
     2599       ) .
     2600     return no-apply .
     2601   end.
     2602   on alt-up anywhere
     2603   do:
     2604     run diasize_change-height in this-procedure
     2605       (input -1
     2606       ,input true
     2607       ) .
     2608     return no-apply .
     2609   end.
     2610   on alt-enter of frame Dialog-Frame
     2611   do:
     2612     run diasize_maximize in this-procedure
     2613       (input  ?
     2614       ).
     2615     return no-apply .
     2616   end.
     2617   procedure diasize_end-move :
     2618     do
     2619     on error undo, return error return-value
     2620     :
     2621       define variable v-row-delta as decimal   no-undo .
     2622       define variable v-col-delta as decimal   no-undo .
     2623       define variable v-new-row as decimal   no-undo .
     2624       define variable v-new-col as decimal   no-undo .
     2625       assign
     2626         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2627         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2628       .
     2629       assign
     2630         v-row-delta = v-new-row - frame Dialog-Frame :height
     2631         v-col-delta = v-new-col - frame Dialog-Frame :width
     2632       .
     2633       run diasize_change-height in this-procedure
     2634         (input v-row-delta
     2635         ,input true
     2636         ) .
     2637       run diasize_change-width in this-procedure
     2638         (input v-col-delta
     2639         ,input true
     2640         ) .
     2641     end.
     2642   end procedure.
     2643   procedure diasize_maximize :
     2644     define input  parameter p-action as logical   no-undo .
     2645     do
     2646     on error undo, return error return-value
     2647     :
     2648       if p-action = ?
     2649       then do:
     2650         if v-diasize-need-maximize = true
     2651         then do:
     2652           assign
     2653             p-action = true
     2654           .
     2655         end.
     2656         else do:
     2657           assign
     2658             p-action = false
     2659           .
     2660         end.
     2661       end.
     2662       if p-action = true
     2663       then do:
     2664         run diasize_change-height in this-procedure
     2665           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2666               - frame Dialog-Frame :height-chars
     2667           ,input true
     2668           ) .
     2669         run diasize_change-width in this-procedure
     2670           (input session :width-chars
     2671               - frame Dialog-Frame :width-chars
     2672           ,input true
     2673           ) .
     2674         assign
     2675           v-diasize-need-maximize = false
     2676         .
     2677       end.
     2678       else do:
     2679         run diasize_change-width in this-procedure
     2680           (input v-diasize-orig-frame-width
     2681               - frame Dialog-Frame :width-chars
     2682           ,input true
     2683           ) .
     2684         run diasize_change-height in this-procedure
     2685           (input v-diasize-orig-frame-height
     2686               - frame Dialog-Frame :height-chars
     2687           ,input true
     2688           ) .
     2689         assign
     2690           v-diasize-need-maximize = true
     2691         .
     2692       end.
     2693     end.
     2694   end procedure.
     2695   procedure diasize_restore-orig-size :
     2696     do
     2697     on error undo, return error return-value
     2698     :
     2699       assign
     2700         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2701         v-diasize-current-frame-height = frame Dialog-Frame :height
     2702       .
     2703       run diasize_set-height in this-procedure
     2704         (input  v-diasize-orig-frame-height
     2705         ,input  true
     2706         ) .
     2707       run diasize_set-width in this-procedure
     2708         (input  v-diasize-orig-frame-width
     2709         ,input  true
     2710         ) .
     2711     end.
     2712   end procedure.
     2713   procedure diasize_restore-current-size :
     2714     do
     2715     on error undo, return error return-value
     2716     :
     2717       run diasize_set-height in this-procedure
     2718         (input  v-diasize-current-frame-height
     2719         ,input  true
     2720         ) .
     2721       run diasize_set-width in this-procedure
     2722         (input  v-diasize-current-frame-width
     2723         ,input  true
     2724         ) .
     2725     end.
     2726   end procedure.
     2727   procedure diasize_set-browse-handle :
     2728     define input  parameter p-browse-handle as handle   no-undo .
     2729     define buffer buf_temp-browse-handle for temp-browse-handle .
     2730     do
     2731     on error undo, return error return-value
     2732     :
     2733       assign
     2734         v-diasize-browse-handle = p-browse-handle
     2735       .
     2736       for each buf_temp-browse-handle
     2737       on error undo, return error return-value
     2738       :
     2739         delete buf_temp-browse-handle .
     2740       end.
     2741     end.
     2742   end procedure.
     2743   procedure diasize_add_browse :
     2744     define input  parameter p-browse-type   as character no-undo .
     2745     define input  parameter p-browse-handle as handle    no-undo .
