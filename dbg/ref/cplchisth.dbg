     3012       assign
     3013         self :screen-value = string(v-curr-sv-date) .
     3014       .
     3015     end.
     3016     return no-apply.
     3017   end.
     3018   on ctrl-b of sch-corr-date in frame Dialog-Frame
     3019   do:
     3020     if (can-query (self, "sensitive")
     3021        and
     3022        self :sensitive = true
     3023        )
     3024     or (can-query (self, "read-only")
     3025        and
     3026        self :read-only = false
     3027        )
     3028     then do:
     3029       if self :handle <> focus :handle
