     5107   PROCEDURE proc-b-print :
     5108   define variable date_string     as      char    no-undo.
     5109   define variable Line                as      char    no-undo.
     5110   define variable for-time as char.
     5111   define variable accum-count as integer.
     5112   define variable v-doc-rec as recid no-undo.
     5113   define variable v-prod as character no-undo .
     5114   define variable v-subject-chr as character no-undo .
     5115   define variable v-upd-time as character no-undo .
     5116   define variable v-obj as character no-undo .
     5117   define variable v-action-chr as character no-undo .
     5118   DEFINE VARIABLE v-for-user-name AS CHARACTER NO-UNDO.
     5119   DEFINE FRAME HistoryList
     5120   X_c-plc-hist.pl-code COLUMN-LABEL "Код скл.места"
     5121   v-action-chr FORMAT "X(10)" COLUMn-LABEL "Действие"
     5122   v-pl-name COLUMN-LABEL "Назв. складского места" FORMAT "X(20)"
     5123   v-subject-chr COLUMN-LABEL "Предмет изменений" FORMAT "X(20)"
     5124   X_c-plc-hist.corr-date
     5125   v-upd-time COLUMN-LABEL "Время изм." FORMAT "X(8)"
     5126   v-for-user-name  column-label "Изменил" format "X(18)"
     5127   X_c-plc-hist.corr-user-db-num
     5128   v-obj COLUMN-LABEL "Объект" FORMAT "X(8)"
     5129   HEADER  date_string AT 5 format "X(35)"
     5130   string( "Страница " ) format "X(9)" AT 115 PAGE-NUMBER(PrnLibStream) AT 125 FORMAT ">>9" SKIP
     5131   Line format "X(195)" AT 1
     5132   with width 232 down stream-io use-text    .
     5133   Line = fill("-", 195).
     5134   date_string = cur-time-print() .
     5135   assign
     5136   v-doc-rec = recid( X_c-plc-hist ).
     5137   DO WHILE available X_c-plc-hist :
     5138         GET prev br-plc-hist.
     5139   END.
     5140   run prn-lib-open-stream  in this-procedure (
     5141                                                input parparentProc
     5142                                               ,input 43
     5143                                               ,input yes
     5144                                               ,input no
     5145                                               ).
     5146   PUT  STREAM PrnLibStream
     5147   SPACE(25) ( frame Dialog-Frame:title )
     5148   format "x(90)" SKIP(1) .
     5149   FORM HEADER
     5150   Line format "X(180)" AT 1 SKIP
     5151   "Продолжение - на следующей странице" AT 30 SKIP
     5152   with FRAME BottomFrame width 232 PAGE-BOTTOM NO-LABELS NO-BOX .
     5153   VIEW  STREAM PrnLibStream FRAME BottomFrame .
     5154   FORM with FRAME HistoryList  .
     5155   run waitfram-show in this-procedure (  input "Ждите...").
     5156     GET next br-plc-hist.
     5157       DO WHILE available X_c-plc-hist :
     5158         Display STREAM PrnLibStream
     5159         X_c-plc-hist.pl-code
     5160         get-action(X_c-plc-hist.action) @ v-action-chr
     5161         (if v-find then get-place(X_c-plc-hist.obj-type, X_c-plc-hist.obj-code, X_c-plc-hist.pl-code) else "":U )
     5162         @ v-pl-name
     5163         get-subject(X_c-plc-hist.subject) @ v-subject-chr
     5164         X_c-plc-hist.corr-date
     5165         string(X_c-plc-hist.corr-time, "HH:MM:SS":U) @ v-upd-time
     5166         usrfulnf(X_c-plc-hist.corr-user-name) @ v-for-user-name
     5167         X_c-plc-hist.corr-user-db-num
     5168         X_c-plc-hist.obj-type + string(X_c-plc-hist.obj-code) @ v-obj
     5169         with FRAME HistoryList .
     5170     DOWN STREAM PrnLibStream 1 with FRAME HistoryList  .
     5171     assign
     5172     accum-count = accum-count + 1
     5173     .
     5174     GET next br-plc-hist.
     5175   END.
     5176   UNDERLINE  STREAM PrnLibStream
     5177   X_c-plc-hist.pl-code
     5178   v-action-chr
     5179   v-pl-name
     5180   v-subject-chr
     5181   X_c-plc-hist.corr-date
     5182   v-upd-time
     5183   v-for-user-name
     5184   X_c-plc-hist.corr-user-db-num
     5185   v-obj
     5186   with FRAME HistoryList .
     5187   DISPLAY STREAM PrnLibStream
     5188   "ИТОГО"  @ X_c-plc-hist.pl-code
     5189   string(accum-count)  @ v-action-chr
     5190   with frame HistoryList.
     5191   HIDE  STREAM PrnLibStream FRAME BottomFrame .
     5192   HIDE  STREAM PrnLibStream FRAME CheckList.
     5193   output  STREAM PrnLibStream CLOSE.
     5194   run waitfram-hide in this-procedure.
     5195   run prn-lib-prn-file in this-procedure (
     5196                                             input parparentproc
     5197                                             ,input 8
     5198                                             ).
     5199   reposition br-plc-hist to recid v-doc-rec no-error.
     5200   apply "entry" to br-plc-hist in frame Dialog-Frame.
     5201   END PROCEDURE.
     5202   PROCEDURE proc-b-sch :
     5203   assign
     5204     tbl = 'c-plc-hist'
     5205     join-tbl = 'X_c-plc-hist'
     5206     fld = ""
     5207     lab = ""
     5208     spr = ""
     5209     dim = '0'
     5210     .
     5211   run fltfield-add in this-procedure('obj-type*obj-code', 'Объект', '',
     5212   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5213   run fltfield-add in this-procedure('pl-code', 'Код складского места', '',
     5214   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5215   run fltfield-add in this-procedure('corr-date', '', '',
     5216   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5217   run fltfield-add in this-procedure('corr-time', 'Время корр.', 'time',
     5218   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5219   run fltfield-add in this-procedure('corr-user-db-num', '', '',
     5220   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5221   run fltfield-add in this-procedure('corr-user-name', 'Изменил', 'usr',
     5222   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5223   run fltfield-add in this-procedure('subject', 'Предмет изменения', 'plc-hist-subject',
     5224   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5225   run fltfield-add in this-procedure('action', 'Действие', 'hist-action',
     5226   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5227   Filter-Block:
     5228   DO ON STOP    UNDO Filter-Block, LEAVE Filter-Block
     5229       ON ERROR   UNDO Filter-Block, LEAVE Filter-Block
     5230       ON END-KEY UNDO Filter-Block, LEAVE Filter-Block :
     5231     run gbl/filter.w ( INPUT parparentproc
     5232                       ,INPUT (filter-point + chr(4) + filter-label + chr(4) + 'yes':U)
     5233                       ,INPUT tbl
     5234                       ,INPUT join-tbl
     5235                       ,INPUT fld
     5236                       ,INPUT lab
     5237                       ,INPUT spr
     5238                       ,INPUT dim ).
     5239     RUN OpenBr in this-procedure ( input yes, input no, input '':U).
     5240   END.
     5241   END PROCEDURE.
     5242   PROCEDURE proc-br-plc-hist :
     5243   define variable vss-include-info42 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5244   if b-sel:sensitive in frame Dialog-Frame then dO:
     5245       if b-mark:sensitive then do:
     5246           apply "choose" to b-mark in frame Dialog-Frame.
     5247       end.
     5248       else do:
     5249           apply "choose" to b-sel in frame Dialog-Frame.
     5250       end.
     5251   end.
     5252   else do:
     5253       if b-lookup:sensitive then
     5254       apply "choose" to b-lookup in frame Dialog-Frame.
     5255   end.
     5256   END PROCEDURE.
     5257   PROCEDURE proc-find-corr-date :
     5258   define input parameter p-next as logical no-undo.
     5259   define input parameter p-date like ub.fin-doc.doc-date no-undo.
     5260   define variable v-date-chr as character no-undo.
     5261   if p-date = ? then return .
     5262   display
     5263   0 @ sch-pl-code
     5264   "":U @ sch-corr-user-name
     5265   with frame Dialog-Frame.
     5266   assign
     5267   v-date-chr = string(day(p-date)) + chr(47) +
     5268                    string(month(p-date)) + chr(47) +
     5269                    string(year(p-date)).
     5270          run OpenBr in this-procedure
     5271           (input false
     5272           ,input true
     5273           ,input substitute("and X_c-plc-hist.corr-date = &1 "
     5274             , v-date-chr)
     5275           ).
     5276         apply "entry":u to sch-corr-date in frame Dialog-Frame.
     5277   END PROCEDURE.
     5278   PROCEDURE proc-find-pl-code :
     5279   define input parameter p-next as logical no-undo.
     5280   define input parameter p-pl-code like ub.c-plc-hist.pl-code no-undo.
     5281   define variable v-pl-code as character no-undo.
     5282   assign
     5283   sch-corr-date = ?.
     5284   display
     5285   "":U @ sch-corr-user-name
     5286   sch-corr-date
     5287   with frame Dialog-Frame.
     5288   assign
     5289   v-pl-code = string(p-pl-code).
     5290   run OpenBr in this-procedure
     5291       (input false
     5292       ,input p-next
     5293       ,input substitute("and X_c-plc-hist.pl-code = &1 "
     5294         , v-pl-code)
     5295       ).
     5296   apply "entry":u to sch-pl-code in frame Dialog-Frame .
     5297   END PROCEDURE.
     5298   PROCEDURE proc-find-user :
     5299   define input parameter p-next as logical no-undo.
     5300   define input parameter p-user like ub.c-plc-hist.corr-user-name no-undo.
     5301   assign
     5302   sch-corr-date = ?.
     5303   display
     5304   sch-corr-date
     5305   0 @ sch-pl-code
     5306   with frame Dialog-Frame.
     5307   p-user = chr(34) + p-user + chr(34).
     5308   run OpenBr in this-procedure
     5309       (input false
     5310       ,input p-next
     5311       ,input substitute("and X_c-plc-hist.corr-user-name = &1 "
     5312         , p-user)
     5313       ).
     5314   apply "entry":u to sch-corr-user-name in frame Dialog-Frame .
     5315   END PROCEDURE.
     5316   PROCEDURE proc-view-changes :
     5317   define variable v-description as character no-undo .
     5318   for each temp-changes:
     5319       delete temp-changes.
     5320   END.
     5321   if not available X_c-plc-hist then do:
     5322     Open QUery br-changes for each temp-changes.
     5323     return.
     5324   end.
     5325   run ref/cplchisv.p (
     5326                      input X_c-plc-hist.obj-type
     5327                     ,input X_c-plc-hist.obj-code
     5328                     ,input X_c-plc-hist.pl-code
     5329                     ,input X_c-plc-hist.chip-num
     5330                     ,input X_c-plc-hist.corr-user-db-num
     5331                     ,input X_c-plc-hist.subject
     5332                     ,input X_c-plc-hist.action
     5333                     ,input no
     5334                     ,output v-description
     5335                  ) no-error .
     5336   Open QUery br-changes for each temp-changes.
     5337   assign
     5338   br-changes:title in frame Dialog-Frame = v-description
     5339   .
     5340   END PROCEDURE.
     5341   FUNCTION get-action RETURNS CHARACTER
     5342     ( p-action as integer ) :
     5343     define variable dops as character no-undo.
     5344   assign dops = entry (lookup (trim(string(p-action)), '99,1,2,3,4,9,51,79':U), 'Удаление,Создание,Изменение,Коррекция,Восстановление,Смена_кода,Смена_артик,Выключ.':U) no-error.
     5345   RETURN dops.
     5346   END FUNCTION.
     5347   FUNCTION get-place RETURNS CHARACTER
     5348     ( p-obj-type as character, p-obj-code as integer, p-pl-code as integer ) :
     5349   define buffer buf_place for ub.place.
     5350   find first buf_place no-lock where
     5351             buf_place.obj-type = p-obj-type
     5352        AND  buf_place.obj-code = p-obj-code
     5353        AND  buf_place.pl-code = p-pl-code no-error.
     5354   if not available buf_place then do:
     5355       return "!!! Неизвестное складское место!!!".
     5356   end.
     5357     RETURN buf_place.pl-name.
     5358   END FUNCTION.
     5359   FUNCTION get-subject RETURNS CHARACTER
     5360     ( p-subject as character ) :
     5361     RETURN entry (lookup (p-subject, 'place,pl-gds,pl-gds-pump,pl-pump,pl-pump-nozzle,place-attr':U), 'Складское место,Товар на складском месте,Товар на ТРК,Резервуар/ТРК,Резервуар/ТРК/Пистолет,Атрибут Скл. места':U).
     5362   END FUNCTION.
