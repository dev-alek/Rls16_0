     2904   procedure get-context :
     2905      define output parameter p-db-num as integer          no-undo.
     2906      define output parameter p-user-id as character        no-undo.
     2907      define variable v-login               as character    no-undo.
     2908      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2909      define buffer buf_user-login  for ub.user-login .
     2910      do
     2911      on error undo, return error
     2912      :
     2913            FIND FIRST buf_sys-ctrl no-lock.
     2914            ASSIGN
     2915               v-login = USERID("ub")
     2916               p-db-num = buf_sys-ctrl.db-num
     2917            .
     2918            FIND FIRST buf_user-login
     2919                 WHERE buf_user-login.db-num = p-db-num
     2920                   AND buf_user-login.user-login = v-login
     2921                 no-lock
     2922                 no-error
     2923                 .
     2924            IF AVAILABLE buf_user-login
     2925            THEN DO:
     2926               assign
     2927                  p-user-id = buf_user-login.user-id
     2928               .
     2929            END.
     2930      end.
     2931   end procedure.
