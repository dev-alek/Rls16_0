        1   DEFINE BUFFER find_c-plc-hist FOR c-plc-hist.
        2   DEFINE BUFFER X_c-plc-hist FOR c-plc-hist.
        3   DEFINE BUFFER X_clients FOR clients.
        4   DEFINE BUFFER X_curr-sysconf FOR sysconf.
        5   DEFINE BUFFER X_goods FOR goods.
        6   DEFINE BUFFER X_place FOR place.
        7   DEFINE BUFFER X_sysconf FOR sysconf.
        8   DEFINE INPUT     PARAMETER parParentProc  AS WIDGET-HANDLE NO-UNDO.
        9   define input parameter bttns  as char   no-undo .
       10   define input parameter p-mode  as char   no-undo .
       11   define input parameter p-obj-type like ub.c-plc-hist.obj-type no-undo.
       12   define input parameter p-obj-code like ub.c-plc-hist.obj-code no-undo.
       13   define input parameter p-pl-code  like ub.c-plc-hist.pl-code no-undo .
       14   define input parameter p-gds-code like ub.c-plc-hist.gds-code no-undo .
       15   define input parameter p-pump-code like ub.c-plc-hist.pump-code no-undo .
       16   define input parameter p-nozzle-code like ub.c-plc-hist.nozzle-code no-undo .
       17   define input parameter p-subject  like ub.c-plc-hist.subject no-undo .
       18   define input-output param p-rid-list    as  char no-undo .
       19   define variable vss-revision    AS CHAR NO-UNDO INIT "$Revision$":U.
       20   define variable vss-author      AS CHAR NO-UNDO INIT "$Author$":U.
       21   define variable vss-date        AS CHAR NO-UNDO INIT "$Date$":U.
       22   define variable vss-workfile    AS CHAR NO-UNDO INIT "$Workfile$":U.
       23   define variable vss-archive     AS CHAR NO-UNDO INIT "$Archive$":U.
       24   define variable vss-description AS CHAR NO-UNDO INIT "Список полной истории складского места":U.
       25   procedure vss-get-info :
       26     define output parameter p-vss-revision    like vss-revision    no-undo .
       27     define output parameter p-vss-author      like vss-author      no-undo .
       28     define output parameter p-vss-date        like vss-date        no-undo .
       29     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       30     define output parameter p-vss-archive     like vss-archive     no-undo .
       31     define output parameter p-vss-description like vss-description no-undo .
       32     assign
       33       p-vss-revision    = vss-revision
       34       p-vss-author      = vss-author
       35       p-vss-date        = vss-date
       36       p-vss-workfile    = vss-workfile
       37       p-vss-archive     = vss-archive
       38       p-vss-description = vss-description
       39     .
       40   end procedure.
       41   procedure vss-get-parameters :
       42     define output parameter p-vss-parameters as character no-undo .
       43   end procedure.
       44   define new global shared variable g#vssrevis-logger as handle    no-undo .
       45   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       46   define variable v-vssrevis-logger                   as handle    no-undo .
       47   procedure vss-logevent :
       48     define input  parameter p-extra-paramters as character no-undo .
       49     define variable v-vssrevis-parameters as character no-undo .
       50     do
       51     on error undo, return error return-value
       52     :
       53       if  valid-handle(v-vssrevis-logger)
       54       and v-vssrevis-logger :get-signature("logevent") <> ""
       55       then do:
       56         run vss-get-parameters in this-procedure
       57           (output v-vssrevis-parameters
       58           ).
       59         run logevent in v-vssrevis-logger
       60           (input vss-workfile
       61           ,input vss-revision
       62           ,input v-vssrevis-parameters
       63           ,input p-extra-paramters
       64           ).
       65       end.
       66     end.
       67   end procedure.
       68   assign
       69     v-vssrevis-logger = g#vssrevis-logger
       70   .
       71   if  valid-handle(v-vssrevis-logger)
       72   and v-vssrevis-logger :get-signature("logevent") <> ""
       73   then do:
       74     assign
       75       v-vssrevis-logevent = true
       76     .
       77     run vss-logevent in this-procedure (input vss-description) .
       78   end.
       79   define new global shared variable g#language as character no-undo .
       80   if g#language <> '' and g#language <> 'rus':U then do:
       81     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       82   end.
       83   define new global shared variable g#library  as handle no-undo .
       84   define new global shared variable g#library2 as handle no-undo .
       85   procedure proc-alt-shift-f2:
       86     if not ibs.th.gbl.gbl-var:rcode
       87   then
       88     run gbl\inidebug.p .
       89   end.
       90   procedure proc-alt-shift-f3:
       91     run gbl/prvssinf.p
       92       ( input this-procedure
       93       ) .
       94   end.
       95   define variable v-inform-launched as logical no-undo initial false .
       96   procedure proc-alt-shift-f4:
       97     define variable v-action as character no-undo .
       98     if v-inform-launched = false then do:
       99       assign
      100         v-inform-launched = true
      101       .
      102       run gbl/d-inform.w
      103         (  input self
      104         ,  input this-procedure
      105         , output v-action
      106         ) no-error .
      107       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      108       assign
      109         v-inform-launched = false
      110       .
      111     end.
      112   end.
      113   procedure proc-alt-f1:
      114     run gbl/corrhelp.p
      115       (input this-procedure
      116       ) .
      117   end .
