        1   DEFINE BUFFER locked_currency FOR ub.currency.
        2   DEFINE TEMP-TABLE tt-currency NO-UNDO LIKE ub.currency.
        3   DEFINE  INPUT        PARAMETER parparentproc AS WIDGET-HANDLE NO-UNDO.
        4   define  input        parameter p-mode as char  no-undo.
        5   define  input        parameter p-curr-code like ub.currency.curr-code no-undo .
        6   define  input-output parameter p-rid   as   recid  init ? no-undo.
        7   define variable vss-revision    as character no-undo init "$Revision$":U .
        8   define variable vss-author      as character no-undo init "$Author$":U .
        9   define variable vss-date        as character no-undo init "$Date$":U .
       10   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       11   define variable vss-archive     as character no-undo init "$Archive$":U .
       12   define variable vss-description as character no-undo init "карточка валюты".
       13   procedure vss-get-info :
       14     define output parameter p-vss-revision    like vss-revision    no-undo .
       15     define output parameter p-vss-author      like vss-author      no-undo .
       16     define output parameter p-vss-date        like vss-date        no-undo .
       17     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       18     define output parameter p-vss-archive     like vss-archive     no-undo .
       19     define output parameter p-vss-description like vss-description no-undo .
       20     assign
       21       p-vss-revision    = vss-revision
       22       p-vss-author      = vss-author
       23       p-vss-date        = vss-date
       24       p-vss-workfile    = vss-workfile
       25       p-vss-archive     = vss-archive
       26       p-vss-description = vss-description
       27     .
       28   end procedure.
       29   procedure vss-get-parameters :
       30     define output parameter p-vss-parameters as character no-undo .
       31   end procedure.
       32   define new global shared variable g#vssrevis-logger as handle    no-undo .
       33   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       34   define variable v-vssrevis-logger                   as handle    no-undo .
       35   procedure vss-logevent :
       36     define input  parameter p-extra-paramters as character no-undo .
       37     define variable v-vssrevis-parameters as character no-undo .
       38     do
       39     on error undo, return error return-value
       40     :
       41       if  valid-handle(v-vssrevis-logger)
       42       and v-vssrevis-logger :get-signature("logevent") <> ""
       43       then do:
       44         run vss-get-parameters in this-procedure
       45           (output v-vssrevis-parameters
       46           ).
       47         run logevent in v-vssrevis-logger
       48           (input vss-workfile
       49           ,input vss-revision
       50           ,input v-vssrevis-parameters
       51           ,input p-extra-paramters
       52           ).
       53       end.
       54     end.
       55   end procedure.
       56   assign
       57     v-vssrevis-logger = g#vssrevis-logger
       58   .
       59   if  valid-handle(v-vssrevis-logger)
       60   and v-vssrevis-logger :get-signature("logevent") <> ""
       61   then do:
       62     assign
       63       v-vssrevis-logevent = true
       64     .
       65     run vss-logevent in this-procedure (input vss-description) .
       66   end.
       67   define new global shared variable g#language as character no-undo .
       68   if g#language <> '' and g#language <> 'rus':U then do:
       69     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       70   end.
       71   define new global shared variable g#library  as handle no-undo .
       72   define new global shared variable g#library2 as handle no-undo .
       73   procedure proc-alt-shift-f2:
       74     if not ibs.th.gbl.gbl-var:rcode
       75   then
       76     run gbl\inidebug.p .
       77   end.
       78   procedure proc-alt-shift-f3:
       79     run gbl/prvssinf.p
       80       ( input this-procedure
       81       ) .
       82   end.
       83   define variable v-inform-launched as logical no-undo initial false .
       84   procedure proc-alt-shift-f4:
       85     define variable v-action as character no-undo .
       86     if v-inform-launched = false then do:
       87       assign
       88         v-inform-launched = true
       89       .
       90       run gbl/d-inform.w
       91         (  input self
       92         ,  input this-procedure
       93         , output v-action
       94         ) no-error .
       95       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       96       assign
       97         v-inform-launched = false
       98       .
       99     end.
      100   end.
      101   procedure proc-alt-f1:
      102     run gbl/corrhelp.p
      103       (input this-procedure
      104       ) .
      105   end .
      106   on alt-shift-f2 anywhere do:
      107     run proc-alt-shift-f2.
      108   end.
      109   on alt-shift-f3 anywhere do:
      110     run proc-alt-shift-f3 in this-procedure .
      111   end.
      112   on alt-shift-f4 anywhere do:
      113     run proc-alt-shift-f4 in this-procedure.
      114   end.
      115   on alt-f1 anywhere do:
      116     run proc-alt-f1 in this-procedure .
      117   end.
      118   define variable v-db-num like ub.db.db-num no-undo .
      119   DEFINE BUTTON B-exit AUTO-GO
      120        LABEL "&Ввод"
      121        SIZE 10 BY 1
      122        BGCOLOR 8 .
      123   DEFINE BUTTON B-Help
      124        LABEL "Помо&щь"
      125        SIZE 10 BY 1
      126        BGCOLOR 8 .
      127   DEFINE BUTTON B-hist
      128        LABEL "Ис&тория"
      129        SIZE 10 BY 1.
      130   DEFINE BUTTON b-quit AUTO-END-KEY
      131        LABEL "&Отмена"
      132        SIZE 10 BY 1
      133        BGCOLOR 8 .
      134   DEFINE VARIABLE f-okv-code-chr AS CHARACTER FORMAT "X(3)":U
      135        LABEL "Буквенный код"
      136        VIEW-AS FILL-IN
      137        SIZE 4 BY 1 NO-UNDO.
      138   DEFINE QUERY Dialog-Frame FOR
      139         tt-currency SCROLLING.
      140   DEFINE FRAME Dialog-Frame
      141        B-exit AT ROW 1 COL 1
      142        b-quit AT ROW 1 COL 11
      143        B-hist AT ROW 1 COL 31
      144        B-Help AT ROW 1 COL 54.9
      145        tt-currency.curr-abbr AT ROW 3.63 COL 47.9 COLON-ALIGNED
      146             LABEL "Аббревиатура"
      147             VIEW-AS FILL-IN
      148             SIZE 7.6 BY 1
      149        tt-currency.curr-code AT ROW 3.67 COL 28.4 COLON-ALIGNED
      150             LABEL "Код валюты"
      151             VIEW-AS FILL-IN
      152             SIZE 3.3 BY 1
      153        tt-currency.okv-code AT ROW 4.97 COL 28 COLON-ALIGNED
      154             LABEL "Код Общерос.Классиф.Валют"
      155             VIEW-AS FILL-IN
      156             SIZE 8.1 BY 1
      157        f-okv-code-chr AT ROW 5 COL 55 COLON-ALIGNED WIDGET-ID 2
      158        tt-currency.curr-name AT ROW 6.3 COL 17.6 COLON-ALIGNED
      159             LABEL "Название"
      160             VIEW-AS FILL-IN
      161             SIZE 41 BY 1
      162        tt-currency.curr-name-one AT ROW 7.57 COL 27.4 COLON-ALIGNED
      163             LABEL "один/одна..."
      164             VIEW-AS FILL-IN
      165             SIZE 41 BY 1 TOOLTIP "Укажите название в единственном числе"
      166        tt-currency.curr-name-three AT ROW 8.8 COL 27.5 COLON-ALIGNED
      167             LABEL "три..."
      168             VIEW-AS FILL-IN
      169             SIZE 41 BY 1 TOOLTIP "Укажите спряжение для числительных 2-4"
      170        tt-currency.curr-name-five AT ROW 9.93 COL 27.5 COLON-ALIGNED
      171             LABEL "пять..."
      172             VIEW-AS FILL-IN
      173             SIZE 41 BY 1 TOOLTIP "Укажите спряженеи для числительных пять и т.д."
      174        tt-currency.curr-eng-name AT ROW 11.07 COL 1.1
      175             LABEL "Название (англ.)"
      176             VIEW-AS FILL-IN
      177             SIZE 41 BY 1
      178        tt-currency.curr-eng-name-one AT ROW 12.3 COL 28 COLON-ALIGNED
      179             LABEL "one..."
      180             VIEW-AS FILL-IN
      181             SIZE 41 BY 1 TOOLTIP "Укажите название в единственном числе"
      182        tt-currency.curr-eng-name-three AT ROW 13.37 COL 28 COLON-ALIGNED
      183             LABEL "three..."
      184             VIEW-AS FILL-IN
      185             SIZE 41 BY 1 TOOLTIP "Укажите спряжение для числительных 2-4"
      186        tt-currency.curr-eng-name-five AT ROW 14.5 COL 28.1 COLON-ALIGNED
      187             LABEL "five..."
      188             VIEW-AS FILL-IN
      189             SIZE 41 BY 1 TOOLTIP "Укажите спряженеи для числительных пять и т.д."
      190        tt-currency.part-name AT ROW 15.7 COL 23.8 COLON-ALIGNED
      191             LABEL "Название дробной части"
      192             VIEW-AS FILL-IN
      193             SIZE 36 BY 1
      194        tt-currency.part-name-one AT ROW 16.8 COL 28 COLON-ALIGNED
      195             LABEL "один/одна..."
      196             VIEW-AS FILL-IN
      197             SIZE 41 BY 1 TOOLTIP "Укажите название в единственном числе"
      198        tt-currency.part-name-three AT ROW 17.87 COL 28 COLON-ALIGNED
      199             LABEL "три..."
      200             VIEW-AS FILL-IN
      201             SIZE 41 BY 1 TOOLTIP "Укажите спряжение для числительных 2-4"
      202        tt-currency.part-name-five AT ROW 19 COL 28.1 COLON-ALIGNED
      203             LABEL "пять..."
      204             VIEW-AS FILL-IN
      205             SIZE 41 BY 1 TOOLTIP "Укажите спряженеи для числительных пять и т.д."
      206        tt-currency.part-abbr AT ROW 20.2 COL 28.3 COLON-ALIGNED
      207             LABEL "Сокращение дробной части"
      208             VIEW-AS FILL-IN
      209             SIZE 6.6 BY 1
      210        SPACE(39.72) SKIP(0.83)
      211       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      212            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      213            TITLE "Валюта"
      214            DEFAULT-BUTTON B-exit CANCEL-BUTTON b-quit.
      215   ASSIGN
      216          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      217          FRAME Dialog-Frame:HIDDEN           = TRUE.
      218   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      219   DO:
      220     APPLY "END-ERROR":U TO SELF.
      221   END.
      222   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
      223   DO:
      224     run proc-save in this-procedure no-error.
      225     if error-status:error then return no-apply.
      226   END.
      227   ON CHOOSE OF B-hist IN FRAME Dialog-Frame
      228   DO:
      229       define variable v-rid-list as character no-undo.
      230       run ref/ccurrenc.w
      231                   (
      232                    input parParentProc
      233                   ,input "":U
      234                   ,input "one":U
      235                   ,input tt-currency.curr-code
      236                   ,input-output v-rid-list
      237                                 ).
      238   END.
      239   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      240   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      241   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      242   on help of frame Dialog-Frame
      243   do:
      244     run gbl/app_help.p
      245       (input this-procedure :file-name
      246       ,input ''
      247       ,input ?
      248       ) no-error.
      249     if error-status :error then do:
      250       message
      251         "Ошибка при вызове помощи"
      252         error-status :get-message(1)
      253         view-as alert-box .
      254     end.
      255   end.
      256   run minbtn-set in this-procedure .
      257   on choose of b-help in frame Dialog-Frame
      258   do:
      259     apply "help":u to frame Dialog-Frame .
      260   end.
      261   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      262   procedure minbtn-set :
      263       do
      264           on error undo, return error return-value
      265           :
      266           define variable ii              as integer       no-undo .
      267           define variable fh              as widget-handle no-undo .
      268           define variable hh              as widget-handle no-undo .
      269           define variable v-h             as handle        extent 4 no-undo .
      270           define variable v-name-button   as character     no-undo .
      271           define variable v-help-old-x    as decimal       no-undo .
      272           define variable v-help-old-y    as decimal       no-undo .
      273           define variable v-help-old-size as decimal       no-undo .
      274           define variable v-frame-width   as decimal       no-undo .
      275           define variable jj              as integer       no-undo .
      276           do
      277               on error undo, return error
      278               :
      279               assign
      280                   v-frame-width = frame Dialog-Frame:width - 0.3
      281                   fh            = frame Dialog-Frame:first-child
      282                   hh            = fh:first-child
      283                   ii            = 1
      284                   .
      285               do while valid-handle(hh):
      286                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      287                   do:
      288                       case lc(hh:name) :
      289                           when "b-help" then
      290                               do:
      291                                   hh:load-image-up("cmp/b-help.bmp":u) .
      292                                   hh:load-image-down("cmp/b-help.bmp":u) .
      293                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      294                                   hh:TOOLTIP = "Помощь" .
      295                                   v-help-old-x = hh:column .
      296                                   v-help-old-y = hh:row    .
      297                                   v-help-old-size = hh:width .
      298                                   hh:width-chars = 2.5 .
      299                               end.
      300                           when "b-print" then
      301                               do:
      302                                   hh:load-image("cmp/b-print.bmp":u) .
      303                                   hh:TOOLTIP = "Печать" .
      304                                   v-h[ii] = hh:handle .
      305                                   ii = ii + 1 .
      306                                   hh:width-chars = 3 .
      307                               end.
      308                           when "b-history" or
      309                           when "b-hist" then
      310                               do:
      311                                   hh:load-image("cmp/b-hist.bmp":u) .
      312                                   hh:TOOLTIP = "История" .
      313                                   v-h[ii] = hh:handle .
      314                                   ii = ii + 1 .
      315                                   hh:width-chars = 3 .
      316                               end.
      317                           when "b-sch" then
      318                               do:
      319                                   hh:load-image("cmp/b-sch.bmp":u) .
      320                                   hh:TOOLTIP = "Установка Фильтра" .
      321                                   v-h[ii] = hh:handle .
      322                                   ii = ii + 1 .
      323                                   hh:width-chars = 3 .
      324                               end.
      325                           when "b-hist-user" then
      326                               do:
      327                                   hh:load-image("cmp/b-hist.bmp":u) .
      328                                   hh:TOOLTIP = "История пользователя" .
      329                                   ii = ii + 1 .
      330                               end.
      331                       end case.
      332                   end.
      333                   hh = hh:next-sibling.
      334               end.
      335               b-help:column = v-frame-width - b-help:width-chars.
      336               jj = 0.
      337               repeat ii = 4 to 1 by -1 :
      338                   if valid-handle (v-h[ii] ) then
      339                   do:
      340                       jj  = jj + 1 .
      341                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      342                       v-h[ii]:row    = v-help-old-y .
      343                   end.
      344               end.
      345           end.
      346       end.
      347   end procedure.
      348   MAIN-BLOCK:
      349   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      350      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      351    if p-mode  <> 'ДОБАВЛЕНИЕ':U
      352    and p-mode <> 'ИЗМЕНЕНИЕ':U
      353    and p-mode <> 'ПРОСМОТР':U
      354    then do:
      355       message
      356       vss-workfile vss-revision vss-description skip
      357       "Неверное значение параметров вызова p-mode"  p-mode
      358       view-as alert-box ERROR.
      359       undo, return error.
      360    end.
      361   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      362   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
      363     (output v-db-num
      364     )  .
      365    if p-mode <> 'ПРОСМОТР':U then do:
      366       if v-db-num <> 0
      367       then do:
      368         message
      369         vss-workfile vss-revision vss-description skip
      370         "Неверное значение параметров вызова p-mode - нельзя изменять/добавлять записи ВАЛЮТЫ в УБД"
      371         view-as alert-box ERROR.
      372         undo, return error.
      373       end.
      374     end.
      375     for each tt-currency:
      376       delete tt-currency.
      377     end.
      378     if p-mode = 'ИЗМЕНЕНИЕ':U
      379     or p-mode = 'ПРОСМОТР':U then do:
      380       if p-mode = 'ИЗМЕНЕНИЕ':U then do:
      381         find first locked_currency EXclusive-lock where
      382                      recid(locked_currency) = p-rid no-wait no-error.
      383         if locked locked_currency then do:
      384           message
      385           vss-workfile vss-revision vss-description skip
      386            "Запись ВАЛЮТЫ занята"
      387           view-as alert-box error .
      388           undo, return error.
      389         end.
      390       end.
      391       else do:
      392         find first locked_currency no-lock where
      393                          recid(locked_currency) = p-rid no-error .
      394         if not avail locked_currency then do:
      395           find first locked_currency where
      396                     locKed_currency.curr-code = p-curr-code no-error .
      397         end.
      398       end.
      399       if not available locked_currency then do:
      400         message
      401         vss-workfile vss-revision vss-description skip
      402         "Не найдена запись ВАЛЮТЫ"
      403         view-as alert-box error .
      404         undo, return error.
      405       end.
      406       create tt-currency.
      407       buffer-copy locked_currency to tt-currency.
      408     end.
      409     if p-mode = 'ДОБАВЛЕНИЕ':U then do:
      410       create tt-currency.
      411     end.
      412     RUN MYenable.
      413     WAIT-FOR GO OF FRAME Dialog-Frame.
      414   END.
      415   RUN disable_UI.
      416   PROCEDURE disable_UI :
      417     HIDE FRAME Dialog-Frame.
      418   END PROCEDURE.
      419   PROCEDURE enable_UI :
      420     DISPLAY f-okv-code-chr
      421         WITH FRAME Dialog-Frame.
      422     IF AVAILABLE tt-currency THEN
      423       DISPLAY tt-currency.okv-code tt-currency.curr-name tt-currency.curr-name-one
      424             tt-currency.curr-name-three tt-currency.curr-name-five
      425             tt-currency.curr-eng-name tt-currency.curr-eng-name-one
      426             tt-currency.curr-eng-name-three tt-currency.curr-eng-name-five
      427             tt-currency.part-name tt-currency.part-name-one
      428             tt-currency.part-name-three tt-currency.part-name-five
      429             tt-currency.part-abbr
      430         WITH FRAME Dialog-Frame.
      431     ENABLE B-exit b-quit B-hist B-Help tt-currency.curr-abbr
      432            tt-currency.curr-code tt-currency.okv-code f-okv-code-chr
      433            tt-currency.curr-name tt-currency.curr-name-one
      434            tt-currency.curr-name-three tt-currency.curr-name-five
      435            tt-currency.curr-eng-name tt-currency.curr-eng-name-one
      436            tt-currency.curr-eng-name-three tt-currency.curr-eng-name-five
      437            tt-currency.part-name tt-currency.part-name-one
      438            tt-currency.part-name-three tt-currency.part-name-five
      439            tt-currency.part-abbr
      440         WITH FRAME Dialog-Frame.
      441     VIEW FRAME Dialog-Frame.
      442   END PROCEDURE.
      443   PROCEDURE MyEnable :
      444   if num-entries(tt-currency.curr-eng-name, chr(4)) > 1 then do:
      445     f-okv-code-chr = entry(2, tt-currency.curr-eng-name, chr(4)).
      446     tt-currency.curr-eng-name = entry(2, tt-currency.curr-eng-name, chr(4)).
      447   end.
      448   IF AVAILABLE
      449   tt-currency THEN
      450   DISPLAY
      451   f-okv-code-chr
      452   tt-currency.okv-code
      453   tt-currency.curr-abbr
      454   tt-currency.curr-code
      455   tt-currency.curr-name
      456   tt-currency.curr-name-one
      457   tt-currency.curr-name-three
      458   tt-currency.curr-name-five
      459   tt-currency.curr-eng-name
      460   tt-currency.curr-eng-name-one
      461   tt-currency.curr-eng-name-three
      462   tt-currency.curr-eng-name-five
      463   tt-currency.part-name
      464   tt-currency.part-name-one
      465   tt-currency.part-name-three
      466   tt-currency.part-name-five
      467   tt-currency.part-abbr
      468   WITH FRAME Dialog-Frame.
      469   if p-mode = 'ПРОСМОТР':U then do:
      470     assign
      471     b-quit:label = "&Выход".
      472     ENABLE
      473     b-quit
      474     B-Help
      475     with frame Dialog-Frame .
      476     hide
      477     b-exit in frame Dialog-Frame .
      478   end.
      479   else do:
      480     ENABLE
      481     B-exit
      482     b-quit
      483     b-hist WHEN p-mode <> 'ДОБАВЛЕНИЕ':U
      484     B-Help
      485     f-okv-code-chr
      486     tt-currency.curr-abbr when p-mode = 'ДОБАВЛЕНИЕ':U
      487     tt-currency.curr-code when p-mode = 'ДОБАВЛЕНИЕ':U
      488     tt-currency.okv-code
      489     tt-currency.curr-name
      490     tt-currency.curr-name-one
      491     tt-currency.curr-name-three
      492     tt-currency.curr-name-five
      493     tt-currency.curr-eng-name
      494     tt-currency.curr-eng-name-one
      495     tt-currency.curr-eng-name-three
      496     tt-currency.curr-eng-name-five
      497     tt-currency.part-name
      498     tt-currency.part-name-one
      499     tt-currency.part-name-three
      500     tt-currency.part-name-five
      501     tt-currency.part-abbr
      502     WITH FRAME Dialog-Frame .
      503   end.
      504   VIEW FRAME Dialog-Frame .
      505   END PROCEDURE.
      506   PROCEDURE proc-save :
      507   define variable glog as logical no-undo .
      508   if tt-currency.curr-eng-name:screen-value in frame Dialog-Frame = ""  then do:
      509     message
      510     "Вы уверены, что для данной валюты НЕ НУЖНО вводить АНГЛИЙСКОE НАЗВАНИЕ?"
      511     view-as alert-box QUESTION buttons YES-NO update glog.
      512     if not glog then do:
      513         apply "ENTRY":U to tt-currency.curr-eng-name.
      514         return error.
      515     end.
      516   end.
      517   if tt-currency.part-abbr:screen-value = "" OR
      518      tt-currency.part-name:screen-value  = "" then do:
      519     message
      520     "Вы уверены, что у данной валюты НЕТ ДРОБНОЙ ЧАСТИ?"
      521     view-as alert-box QUESTION buttons YES-NO update glog.
      522     if not glog then do:
      523       apply "ENTRY":U  to tt-currency.part-name.
      524       return error.
      525     end.
      526   end.
      527   assign
      528   frame Dialog-Frame
      529   f-okv-code-chr
      530   tt-currency.curr-code
      531   tt-currency.curr-abbr
      532   tt-currency.part-abbr
      533   tt-currency.curr-name
      534   tt-currency.curr-name-one
      535   tt-currency.curr-name-three
      536   tt-currency.curr-name-five
      537   tt-currency.curr-eng-name
      538   tt-currency.curr-eng-name-one
      539   tt-currency.curr-eng-name-three
      540   tt-currency.curr-eng-name-five
      541   tt-currency.part-name
      542   tt-currency.part-name-one
      543   tt-currency.part-name-three
      544   tt-currency.part-name-five
      545   tt-currency.okv-code
      546   .
      547   run ref/currenc1.p (
      548    input-output p-rid
      549   ,input p-mode
      550   ,input false
      551   ,input tt-currency.curr-code
      552   ,input tt-currency.curr-abbr
      553   ,input tt-currency.part-abbr
      554   ,input tt-currency.curr-name
      555   ,input tt-currency.curr-name-one
      556   ,input tt-currency.curr-name-three
      557   ,input tt-currency.curr-name-five
      558   ,input tt-currency.curr-eng-name
      559   ,input tt-currency.curr-eng-name-one
      560   ,input tt-currency.curr-eng-name-three
      561   ,input tt-currency.curr-eng-name-five
      562   ,input tt-currency.part-name
      563   ,input tt-currency.part-name-one
      564   ,input tt-currency.part-name-three
      565   ,input tt-currency.part-name-five
      566   ,input tt-currency.okv-code
      567   ,input f-okv-code-chr
      568   ) no-error .
      569   if error-status:error then do:
      570   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      571   define variable fh as widget-handle no-undo .
      572   define variable hh as widget-handle no-undo .
      573   define variable rv as character no-undo .
      574   assign
      575   rv = entry(1, return-value , chr(4)).
      576   if rv <> "":U then do:
      577     assign
      578     fh = frame Dialog-Frame:first-child
      579     hh = fh:first-child
      580     .
      581     do while valid-handle(hh):
      582       if hh:name = rv then do:
      583         APPLY "ENTRY" to hh.
      584         undo ,
      585         return error.
      586       end.
      587       hh = hh:next-sibling.
      588     end.
      589   end.
      590     undo, return error.
      591   end.
      592   END PROCEDURE.
