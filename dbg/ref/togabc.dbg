      451         VIEW-AS TEXT
      452        SIZE 1.5 BY .67 NO-UNDO.
      453   DEFINE VARIABLE T-AX AS LOGICAL INITIAL no
      454        LABEL ""
      455        VIEW-AS TOGGLE-BOX
      456        SIZE 2.5 BY .83 NO-UNDO.
      457   DEFINE VARIABLE T-AY AS LOGICAL INITIAL no
      458        LABEL ""
      459        VIEW-AS TOGGLE-BOX
      460        SIZE 2.5 BY .83 NO-UNDO.
      461   DEFINE VARIABLE T-AZ AS LOGICAL INITIAL no
      462        LABEL ""
      463        VIEW-AS TOGGLE-BOX
      464        SIZE 2.5 BY .83 NO-UNDO.
      465   DEFINE VARIABLE T-BX AS LOGICAL INITIAL no
      466        LABEL ""
      467        VIEW-AS TOGGLE-BOX
      468        SIZE 2.5 BY .83 NO-UNDO.
      469   DEFINE VARIABLE T-BY AS LOGICAL INITIAL no
      470        LABEL ""
      471        VIEW-AS TOGGLE-BOX
      472        SIZE 2.5 BY .83 NO-UNDO.
      473   DEFINE VARIABLE T-BZ AS LOGICAL INITIAL no
      474        LABEL ""
      475        VIEW-AS TOGGLE-BOX
      476        SIZE 2.5 BY .83 NO-UNDO.
      477   DEFINE VARIABLE T-CY AS LOGICAL INITIAL no
      478        LABEL ""
      479        VIEW-AS TOGGLE-BOX
      480        SIZE 2.5 BY .83 NO-UNDO.
      481   DEFINE VARIABLE T-CZ AS LOGICAL INITIAL no
      482        LABEL ""
      483        VIEW-AS TOGGLE-BOX
      484        SIZE 2.5 BY .83 NO-UNDO.
      485   DEFINE VARIABLE T-DX AS LOGICAL INITIAL no
      486        LABEL ""
      487        VIEW-AS TOGGLE-BOX
      488        SIZE 2.5 BY .83 NO-UNDO.
      489   DEFINE VARIABLE T-DY AS LOGICAL INITIAL no
      490        LABEL ""
      491        VIEW-AS TOGGLE-BOX
      492        SIZE 2.5 BY .83 NO-UNDO.
      493   DEFINE VARIABLE T-DZ AS LOGICAL INITIAL no
      494        LABEL ""
      495        VIEW-AS TOGGLE-BOX
      496        SIZE 2.5 BY .83 NO-UNDO.
      497   DEFINE VARIABLE T-EX AS LOGICAL INITIAL no
      498        LABEL ""
      499        VIEW-AS TOGGLE-BOX
      500        SIZE 2.5 BY .83 NO-UNDO.
      501   DEFINE VARIABLE T-EY AS LOGICAL INITIAL no
      502        LABEL ""
      503        VIEW-AS TOGGLE-BOX
      504        SIZE 2.5 BY .83 NO-UNDO.
      505   DEFINE VARIABLE T-EZ AS LOGICAL INITIAL no
      506        LABEL ""
      507        VIEW-AS TOGGLE-BOX
      508        SIZE 2.5 BY .83 NO-UNDO.
      509   DEFINE VARIABLE T-FY AS LOGICAL INITIAL no
      510        LABEL ""
      511        VIEW-AS TOGGLE-BOX
      512        SIZE 2.5 BY .83 NO-UNDO.
      513   DEFINE VARIABLE T-FZ AS LOGICAL INITIAL no
      514        LABEL ""
      515        VIEW-AS TOGGLE-BOX
      516        SIZE 2.5 BY .83 NO-UNDO.
      517   DEFINE VARIABLE T-CX  AS LOGICAL INITIAL no
      518        LABEL ""
      519        VIEW-AS TOGGLE-BOX
      520        SIZE 2.5 BY .83 NO-UNDO.
      521   DEFINE VARIABLE T-FX  AS LOGICAL INITIAL no
      522        LABEL ""
      523        VIEW-AS TOGGLE-BOX
      524        SIZE 2.5 BY .83 NO-UNDO.
      525   DEFINE FRAME Dialog-Frame
      526        b-exit AT ROW 1 COL 1
      527        B-quit AT ROW 1 COL 11
      528        B-Help AT ROW 1 COL 21
      529        T-AX AT ROW 4.25 COL 11
      530        T-AY AT ROW 4.25 COL 16
      531        T-AZ AT ROW 4.25 COL 21
      532        T-BX AT ROW 6.25 COL 11
      533        T-BY AT ROW 6.25 COL 16
      534        T-BZ AT ROW 6.25 COL 21
      535        T-CX  AT ROW 8.25 COL 11
      536        T-CY AT ROW 8.25 COL 16
      537        T-CZ AT ROW 8.25 COL 21
      538        T-DX AT ROW 10.25 COL 11
      539        T-DY AT ROW 10.25 COL 16
      540        T-DZ AT ROW 10.25 COL 21
      541        T-EX AT ROW 12.25 COL 11
      542        T-EY AT ROW 12.25 COL 16
      543        T-EZ AT ROW 12.25 COL 21
      544        T-FX  AT ROW 14.25 COL 11
      545        T-FY AT ROW 14.25 COL 16
      546        T-FZ AT ROW 14.25 COL 21
      547        X AT ROW 3 COL 11 NO-LABEL
      548        Y AT ROW 3 COL 16.5 NO-LABEL
      549        Z AT ROW 3 COL 21.5 NO-LABEL
      550        A AT ROW 4.25 COL 8 NO-LABEL
      551        B AT ROW 6.25 COL 8 NO-LABEL
      552        C AT ROW 8.25 COL 8 NO-LABEL
      553        D AT ROW 10.25 COL 8 NO-LABEL
      554        E AT ROW 12.25 COL 8 NO-LABEL
      555        F AT ROW 14.25 COL 8 NO-LABEL
      556        SPACE(21.87) SKIP(2.20)
      557       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      558            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      559            TITLE "Выбор групп"
      560            DEFAULT-BUTTON b-exit CANCEL-BUTTON B-quit.
      561   ASSIGN
      562          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      563          FRAME Dialog-Frame:HIDDEN           = TRUE.
      564   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      565   DO:
      566     APPLY "END-ERROR":U TO SELF.
      567   END.
      568   ON CHOOSE OF B-quit IN FRAME Dialog-Frame
      569   DO:
      570     p-list = "".
      571   END.
      572   ON CHOOSE OF b-exit IN FRAME Dialog-Frame
      573   DO:
      574   p-list = "" .
      575   assign
      576   t-ax
      577   T-AY
      578   T-AZ
      579   T-BX
      580   T-BY
      581   T-BZ
      582   T-CX
      583   T-CY
      584   T-CZ
      585   T-DX
      586   T-DY
      587   T-DZ
      588   T-EX
      589   T-EY
      590   T-EZ
      591   T-FX
      592   T-FY
      593   T-FZ
      594   .
      595   case caps(p-type) :
      596   when "ABCXYZ" then do:
      597     if t-ax = true then p-list = p-list + "AX," .
      598     if T-AY = true then p-list = p-list + "AY," .
      599     if T-AZ = true then p-list = p-list + "AZ," .
      600     if T-BX = true then p-list = p-list + "BX," .
      601     if T-BY = true then p-list = p-list + "BY," .
      602     if T-BZ = true then p-list = p-list + "BZ," .
      603     if T-CX = true then p-list = p-list + "CX," .
      604     if T-CY = true then p-list = p-list + "CY," .
      605     if T-CZ = true then p-list = p-list + "CZ," .
      606     if T-DX = true then p-list = p-list + "DX," .
      607     if T-DY = true then p-list = p-list + "DY," .
      608     if T-DZ = true then p-list = p-list + "DZ," .
      609     if T-EX = true then p-list = p-list + "EX," .
      610     if T-EY = true then p-list = p-list + "EY," .
      611     if T-EZ = true then p-list = p-list + "EZ," .
      612     if T-FX = true then p-list = p-list + "FX," .
      613     if T-FY = true then p-list = p-list + "FY," .
      614     if T-FZ = true then p-list = p-list + "FZ," .
      615   end.
      616   when "ABC" then do:
      617     if t-ax = true then p-list = p-list + "A," .
      618     if T-BX = true then p-list = p-list + "B," .
      619     if T-CX = true then p-list = p-list + "C," .
      620     if T-DX = true then p-list = p-list + "D," .
      621     if T-EX = true then p-list = p-list + "E," .
      622     if T-FX = true then p-list = p-list + "F," .
      623   end.
      624   when "XYZ" then do:
      625     if t-ax = true then p-list = p-list + "X," .
      626     if T-AY = true then p-list = p-list + "Y," .
      627     if T-AZ = true then p-list = p-list + "Z," .
      628   end.
      629   end case.
      630    p-list = trim(p-list, ",").
      631    if p-list = ""  then do:
      632       message "Ни чего не выбрано !" .
      633       return no-apply.
      634    end.
      635    message "выбраны группы" p-list .
      636   END.
      637   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      638   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      639   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      640   on help of frame Dialog-Frame
      641   do:
      642     run gbl/app_help.p
      643       (input this-procedure :file-name
      644       ,input ''
      645       ,input ?
      646       ) no-error.
      647     if error-status :error then do:
      648       message
      649         "Ошибка при вызове помощи"
      650         error-status :get-message(1)
      651         view-as alert-box .
      652     end.
      653   end.
      654   run minbtn-set in this-procedure .
      655   on choose of b-help in frame Dialog-Frame
      656   do:
      657     apply "help":u to frame Dialog-Frame .
      658   end.
      659   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      660   procedure minbtn-set :
      661       do
      662           on error undo, return error return-value
      663           :
      664           define variable ii              as integer       no-undo .
      665           define variable fh              as widget-handle no-undo .
      666           define variable hh              as widget-handle no-undo .
      667           define variable v-h             as handle        extent 4 no-undo .
      668           define variable v-name-button   as character     no-undo .
      669           define variable v-help-old-x    as decimal       no-undo .
      670           define variable v-help-old-y    as decimal       no-undo .
      671           define variable v-help-old-size as decimal       no-undo .
      672           define variable v-frame-width   as decimal       no-undo .
      673           define variable jj              as integer       no-undo .
      674           do
      675               on error undo, return error
      676               :
      677               assign
      678                   v-frame-width = frame Dialog-Frame:width - 0.3
      679                   fh            = frame Dialog-Frame:first-child
      680                   hh            = fh:first-child
      681                   ii            = 1
      682                   .
      683               do while valid-handle(hh):
      684                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      685                   do:
      686                       case lc(hh:name) :
      687                           when "b-help" then
      688                               do:
      689                                   hh:load-image-up("cmp/b-help.bmp":u) .
      690                                   hh:load-image-down("cmp/b-help.bmp":u) .
      691                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      692                                   hh:TOOLTIP = "Помощь" .
      693                                   v-help-old-x = hh:column .
      694                                   v-help-old-y = hh:row    .
      695                                   v-help-old-size = hh:width .
      696                                   hh:width-chars = 2.5 .
      697                               end.
      698                           when "b-print" then
      699                               do:
      700                                   hh:load-image("cmp/b-print.bmp":u) .
      701                                   hh:TOOLTIP = "Печать" .
      702                                   v-h[ii] = hh:handle .
      703                                   ii = ii + 1 .
      704                                   hh:width-chars = 3 .
      705                               end.
      706                           when "b-history" or
      707                           when "b-hist" then
      708                               do:
      709                                   hh:load-image("cmp/b-hist.bmp":u) .
      710                                   hh:TOOLTIP = "История" .
      711                                   v-h[ii] = hh:handle .
      712                                   ii = ii + 1 .
      713                                   hh:width-chars = 3 .
      714                               end.
      715                           when "b-sch" then
      716                               do:
      717                                   hh:load-image("cmp/b-sch.bmp":u) .
      718                                   hh:TOOLTIP = "Установка Фильтра" .
      719                                   v-h[ii] = hh:handle .
      720                                   ii = ii + 1 .
      721                                   hh:width-chars = 3 .
      722                               end.
      723                           when "b-hist-user" then
      724                               do:
      725                                   hh:load-image("cmp/b-hist.bmp":u) .
      726                                   hh:TOOLTIP = "История пользователя" .
      727                                   ii = ii + 1 .
      728                               end.
      729                       end case.
      730                   end.
      731                   hh = hh:next-sibling.
      732               end.
      733               b-help:column = v-frame-width - b-help:width-chars.
      734               jj = 0.
      735               repeat ii = 4 to 1 by -1 :
      736                   if valid-handle (v-h[ii] ) then
      737                   do:
      738                       jj  = jj + 1 .
      739                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      740                       v-h[ii]:row    = v-help-old-y .
      741                   end.
      742               end.
      743           end.
      744       end.
      745   end procedure.
      746   MAIN-BLOCK:
      747   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      748      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      749     run my-enable.
      750     WAIT-FOR GO OF FRAME Dialog-Frame.
      751   END.
      752   run disable_ui.
      753   PROCEDURE disable_UI :
      754     HIDE FRAME Dialog-Frame.
      755   END PROCEDURE.
      756   PROCEDURE enable_UI :
      757     DISPLAY T-AX T-AY T-AZ T-BX T-BY T-BZ T-CX  T-CY T-CZ T-DX T-DY T-DZ T-EX T-EY T-EZ T-FX  T-FY T-FZ X Y Z A B C D E F
      758         WITH FRAME Dialog-Frame.
      759     ENABLE b-exit B-quit B-Help T-AX T-AY T-AZ T-BX T-BY T-BZ T-CX  T-CY
      760            T-CZ T-DX T-DY T-DZ T-EX T-EY T-EZ T-FX  T-FY T-FZ X Y Z A B C D E
      761            F
      762         WITH FRAME Dialog-Frame.
      763     VIEW FRAME Dialog-Frame.
      764   END PROCEDURE.
      765   PROCEDURE my-enable :
      766    ENABLE b-exit B-quit B-Help WITH FRAME Dialog-Frame.
      767       CASE caps(p-type):
      768           WHEN "ABC" THEN DO:
      769               DISPLAY T-AX  T-BX T-CX  T-DX T-EX T-FX  A B C D E F WITH FRAME Dialog-Frame.
      770               ENABLE  T-AX  T-BX T-CX  T-DX T-EX T-FX  A B C D E F WITH FRAME Dialog-Frame.
      771           END.
      772           WHEN "XYZ" THEN DO:
      773               DISPLAY T-AX T-AY T-AZ X Y Z  WITH FRAME Dialog-Frame.
      774               ENABLE  T-AX T-AY T-AZ X Y Z  WITH FRAME Dialog-Frame.
      775           END.
      776           WHEN "ABCXYZ" THEN DO:
      777               DISPLAY T-AX T-AY T-AZ T-BX T-BY T-BZ T-CX  T-CY T-CZ T-DX T-DY T-DZ T-EX
      778               T-EY T-EZ T-FX  T-FY T-FZ X Y Z A B C D E F
      779               WITH FRAME Dialog-Frame.
      780               ENABLE  T-AX T-AY T-AZ T-BX T-BY T-BZ T-CX  T-CY
      781               T-CZ T-DX T-DY T-DZ T-EX T-EY T-EZ T-FX  T-FY T-FZ X Y Z A B C D E
      782               F WITH FRAME Dialog-Frame.
      783           END.
      784       END CASE.
      785   define variable par-type as character no-undo .
      786   define variable par-abc-type as character no-undo .
      787   define variable  v-value-date    as date   no-undo .
      788   define variable  v-value-decimal as decimal   no-undo .
      789   define variable  v-value-integer as integer   no-undo .
      790   define variable  v-value-logical as logical   no-undo .
      791   define variable v-found as logical   no-undo .
      792   run thbjattr_value in this-procedure  (
      793     input   "",
      794     input   0 ,
      795     input   'abc-global':U ,
      796     input   'abc-type'  ,
      797     output  par-abc-type ,
      798     output  v-value-date      ,
      799     output  v-value-decimal   ,
      800     output  v-value-integer   ,
      801     output  v-value-logical   ,
      802     output  par-type            ,
      803     output  v-found
      804     ) no-error
      805     .
      806     if error-status :error or v-found = false then do:
      807         message "Нет настроек Ассортиментной политики !!!." view-as alert-box information .
      808         return error return-value .
      809     end.
      810      case par-abc-type :
      811         when 'ABC':U  then do:
      812            hide T-DX T-EX T-FX
      813                 T-DY T-EY T-FY
      814                 T-DZ T-EZ T-FZ
      815                 D E F in frame dialog-frame.
      816         end.
      817         when 'ABCD':U  then do:
      818            hide T-EX T-FX T-EY T-FY T-EZ T-FZ E F in frame dialog-frame.
      819         end.
      820         when 'ABCDE':U  then do:
      821            hide  T-FX  T-FY T-FZ F in frame dialog-frame.
      822         end.
      823      end case.
      824     VIEW FRAME Dialog-Frame.
      825   END PROCEDURE.
