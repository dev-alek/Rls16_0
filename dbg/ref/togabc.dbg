        1   define input  parameter p-type as character no-undo .
        2   define output parameter p-list as character no-undo .
        3   define variable vss-revision    as character no-undo init "$Revision$":U .
        4   define variable vss-author      as character no-undo init "$Author$":U .
        5   define variable vss-date        as character no-undo init "$Date$":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        7   define variable vss-archive     as character no-undo init "$Archive$":U .
        8   define variable vss-description as character no-undo init "Выбор групп".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   define new global shared variable g#library  as handle no-undo .
       68   define new global shared variable g#library2 as handle no-undo .
       69   define   shared variable g#auto as logical no-undo.
       70   define   shared variable g#news as logical no-undo.
       71   define   shared variable g#oxml as logical no-undo.
       72   define   shared variable g#esys as logical no-undo.
       73   define   shared variable g#news-source-db as integer no-undo.
       74   define   shared variable g#esys-source-esys as integer no-undo.
       75   define   shared variable g#db-num as integer   no-undo .
       76   define   shared variable g#userid as character no-undo .
       77   define   shared variable g#passwd as character no-undo .
       78   procedure proc-alt-shift-f2:
       79     if not ibs.th.gbl.gbl-var:rcode
       80   then
       81     run gbl\inidebug.p .
       82   end.
       83   procedure proc-alt-shift-f3:
       84     run gbl/prvssinf.p
       85       ( input this-procedure
       86       ) .
       87   end.
       88   define variable v-inform-launched as logical no-undo initial false .
       89   procedure proc-alt-shift-f4:
       90     define variable v-action as character no-undo .
       91     if v-inform-launched = false then do:
       92       assign
       93         v-inform-launched = true
       94       .
       95       run gbl/d-inform.w
       96         (  input self
       97         ,  input this-procedure
       98         , output v-action
       99         ) no-error .
      100       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      101       assign
      102         v-inform-launched = false
      103       .
      104     end.
      105   end.
      106   procedure proc-alt-f1:
      107     run gbl/corrhelp.p
      108       (input this-procedure
      109       ) .
      110   end .
      111   on alt-shift-f2 anywhere do:
      112     run proc-alt-shift-f2.
      113   end.
      114   on alt-shift-f3 anywhere do:
      115     run proc-alt-shift-f3 in this-procedure .
      116   end.
      117   on alt-shift-f4 anywhere do:
      118     run proc-alt-shift-f4 in this-procedure.
      119   end.
      120   on alt-f1 anywhere do:
      121     run proc-alt-f1 in this-procedure .
      122   end.
      123   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      124   define new global shared variable g#attr-lib  as handle no-undo .
      125   define variable v-attr-lib-variable as handle no-undo .
      126   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      127   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
      128   procedure thbjattr_code :
      129      define input  parameter p-upper-code     as character no-undo .
      130      define input  parameter p-code           as character no-undo .
      131      define output parameter p-label          as character no-undo .
      132      define output parameter p-user-can-edit  as logical   no-undo .
      133      define output parameter p-output-display as logical   no-undo .
      134      define output parameter p-other          as character no-undo .
      135      define output parameter p-prop-list      as character no-undo .
      136      define output parameter p-prop-type-list as character no-undo .
      137      define output parameter p-prop-label-list as character no-undo .
      138      define output parameter p-global          as logical no-undo .
      139      define output parameter p-host           as logical no-undo .
      140      define output parameter p-shop           as logical no-undo .
      141      define output parameter p-store          as logical no-undo .
      142      define output parameter p-db             as logical no-undo .
      143      define variable p-region as logical no-undo.
      144      run thbjattr_code_reg in this-procedure (
      145                                               p-upper-code,
      146                                               p-code,
      147                                               output p-label,
      148                                               output p-user-can-edit,
      149                                               output p-output-display,
      150                                               output p-other,
      151                                               output p-prop-list,
      152                                               output p-prop-type-list,
      153                                               output p-prop-label-list,
      154                                               output p-global,
      155                                               output p-host,
      156                                               output p-shop,
      157                                               output p-store,
      158                                               output p-db,
      159                                               output p-region
      160                                               ).
      161   end procedure.
      162   procedure thbjattr_code_reg :
      163   define input  parameter p-upper-code     as character no-undo .
      164   define input  parameter p-code           as character no-undo .
      165   define output parameter p-label          as character no-undo .
      166   define output parameter p-user-can-edit  as logical   no-undo .
      167   define output parameter p-output-display as logical   no-undo .
      168   define output parameter p-other          as character no-undo .
      169   define output parameter p-prop-list      as character no-undo .
      170   define output parameter p-prop-type-list as character no-undo .
      171   define output parameter p-prop-label-list as character no-undo .
      172   define output parameter p-global          as logical no-undo .
      173   define output parameter p-host           as logical no-undo .
      174   define output parameter p-shop           as logical no-undo .
      175   define output parameter p-store          as logical no-undo .
      176   define output parameter p-db             as logical no-undo .
      177   define output parameter p-region         as logical no-undo .
      178   do
      179   on error undo, return error return-value
      180   :
      181       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run thbjattr_code in g#attr-lib
      182       (input  p-upper-code
      183       ,input  p-code
      184       ,output p-label
      185       ,output p-user-can-edit
      186       ,output p-output-display
      187       ,output p-other
      188       ,output p-prop-list
      189       ,output p-prop-type-list
      190       ,output p-prop-label-list
      191       ,output p-global
      192       ,output p-host
      193       ,output p-shop
      194       ,output p-store
      195       ,output p-db
      196       ,output p-region
      197       ) no-error .
      198     if error-status :error
      199     then do:
      200       undo, return error substitute( "&1. &2&3&4", vss-include-info0, return-value, chr(10), error-status :get-message (1)).
      201     end.
      202   end.
      203   end procedure.
