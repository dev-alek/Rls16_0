     1709   define variable v-limit-l as decimal no-undo .
     1710   define variable v-quota-period as character no-undo .
     1711   define variable v-quota as decimal no-undo .
     1712   define variable v-cc as integer no-undo .
     1713   DEFINE VARIABLE v-account-type AS INTEGER NO-UNDO.
     1714   define variable v-pay-code as integer no-undo .
     1715   define variable v-cdpay-code as integer no-undo .
     1716   define variable v-jj as integer no-undo .
     1717   define variable v-entry as character no-undo .
     1718   define variable v-ext-product-code as integer no-undo .
     1719   define variable v-discount-value as decimal no-undo .
     1720   define variable v-dis-kat as integer no-undo .
     1721   define variable v-dis-kat-type as character no-undo .
     1722   define temp-table ext-product-code no-undo
     1723   field ext-code as integer
     1724   field gds-code as integer
     1725   index pi is unique primary
     1726   ext-code.
     1727   define buffer buf_dis-card for ub.dis-card.
     1728   define buffer buf2_dis-card for ub.dis-card.
     1729   define buffer bufg_ext-classif for ub.ext-classif.
     1730   define buffer bufc_ext-classif for ub.ext-classif.
     1731   define buffer buf_dis-gds-rule for ub.dis-gds-rule.
     1732   define buffer buf0_stop-list for ub.stop-list.
     1733   define buffer buf_stop-list-line for ub.stop-list-line.
     1734   define buffer buf_dis-card-type  for ub.dis-card-type.
     1735   define buffer buf_Dis-card-property for ub.dis-card-property.
     1736   define buffer buf_clients for ub.clients.
     1737   define buffer buf_dis-rule for ub.dis-rule.
     1738   define buffer term_dis-rule for ub.dis-rule.
     1739   define buffer buf_shop for ub.shop.
     1740   define temp-table temp-imp no-undo
     1741   field src-d-card as character
     1742   field d-card as character
     1743   field product-code as integer
     1744   field quota as decimal
     1745   field car-name as character
     1746   field car-number as character
