     1682   define variable v-txt-file-name2        as character no-undo .
     1683   define variable v-txt-file-name-no-ext2 as character no-undo .
     1684   define variable v-txt-file-name-ext2    as character no-undo .
     1685   define variable v-found as logical no-undo .
     1686   define variable v-resource-id as character no-undo .
     1687   define variable v-line-num as integer no-undo .
     1688   define variable v-gds-code as integer no-undo .
     1689   define variable v-field-list as character no-undo .
     1690   define variable v-value-list as character no-undo .
     1691   define variable v-status           as character no-undo .
     1692   define variable v-stop-list-mess as character no-undo .
     1693   define variable v-value as character no-undo .
     1694   define variable v-type as character no-undo .
     1695   define variable v-stop-status as integer no-undo .
     1696   DEFINE VARIABLE v-today as date no-undo .
     1697   DEFINE VARIABLE v-time as integer no-undo .
     1698   define variable v-doc-date as date no-undo .
     1699   define variable v-fact-date as date no-undo .
     1700   define variable v-fact-time as integer no-undo .
     1701   define variable v-status_ as character no-undo .
