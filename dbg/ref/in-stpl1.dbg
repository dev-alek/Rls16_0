     1748   field stop-list-flag as integer
     1749   field ext-cli-code as integer
     1750   field lim-kr as decimal
     1751   field cli-stop-list-flag as integer
     1752   field account-type as integer
     1753   index pi is unique primary
     1754   src-d-card
     1755   index imain d-card
     1756   .
     1757   define temp-table temp-ext-discounts no-undo
     1758   field ext-cli-code as integer
     1759   field ext-code as integer
     1760   field discnt-value like ub.dis-rule.discnt-value
     1761   index pi
     1762   is unique primary
     1763   ext-cli-code
     1764   ext-code
     1765   .
     1766   define temp-table temp-discounts no-undo
     1767   field obj-type like ub.dis-rule.obj-type
     1768   field obj-code like ub.dis-rule.obj-code
     1769   field gds-code like ub.goods.gds-code
     1770   field pos-type as character
     1771   field ext-code as integer
     1772   field dis-kat  like ub.dis-rule.dis-kat
     1773   field discnt-value like ub.dis-rule.discnt-value
     1774   field value-type like ub.dis-rule.value-type
     1775   index pi is unique primary
     1776   gds-code
     1777   obj-type
     1778   obj-code
     1779   pos-type
     1780   dis-kat
     1781   index iobj
     1782   obj-type
     1783   obj-code
     1784   index ikat
     1785   dis-kat
     1786   ext-code
     1787   .
     1788   assign
     1789   file-name            = entry(1, p-parameter, chr(4))
     1790   p-stop-list-code     = entry(2, p-parameter, chr(4))
     1791   p-mode               = entry(3, p-parameter, chr(4))
     1792   v-close              = logical(entry(4, p-parameter, chr(4)))
     1793   no-error
     1794   .
     1795   if error-status:error then do:
     1796     run write-log-and-file in p-log-handle (
     1797           input 1
     1798         , input log-file-name
     1799         , input 1
     1800         , input substitute("Ошибка входных параметров &1:&2&3&4"
     1801                            , p-parameter
     1802                            , chr(10)
     1803                            , error-status:get-message(1)
     1804                            , return-value
     1805                            )).
     1806     assign
     1807     v-view-log = yes.
     1808   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1809   if v-view-log
     1810   and not g#news
     1811   and not g#auto
     1812   then do:
     1813     message
     1814     '!!!При импорте информации произошли ошибки!!!'  skip
     1815     "!!!Внимательно прочитайте Log-file!!"
     1816     view-as alert-box error .
     1817        define variable v-user-action15   as character no-undo .
     1818     define variable v-printed15       as logical   no-undo .
     1819     run gbl/prnfilen.w
     1820       (input  ('!!!При импорте информации произошли ошибки!!!')
     1821       ,input  0
     1822       ,input  (string("./":U) + 'in-stpl1.txt')
     1823       ,input  7
     1824       ,output v-user-action15
     1825       ,output v-printed15
     1826       ) .
     1827   end.
     1828   if v-view-log = true
     1829   and (g#news
     1830   or g#auto)
     1831   and valid-handle(p-parent-handle) and lookup("cb_set-view-log", p-parent-handle:internal-entries) > 0
     1832   then do:
     1833      run cb_set-view-log in p-parent-handle ( input yes).
     1834   end.
     1835   if not v-view-log and search("cdviewlg_do-not-delete-log-file.txt") = ? then do:
     1836     OS-DELETE value(string("./":U) + 'in-stpl1.txt').
     1837   end.
     1838                           return.
     1839   end.
     1840   if NOT g#db-num = 0 then do:
     1841     run write-log-and-file in p-log-handle (
     1842           input 1
