     1008     ,input  0
     1009     ,input  '':U
     1010     ,input  0
     1011     ,input  buf_dis-card.type
     1012     ,input  '':U
     1013     ,input  '':U
     1014     ,input  buf_dis-card.emitent-host-code
     1015     ,input  (if buf_Dis-card-property.dt-code > 0 then 0 else -1)
     1016     ,input  0
     1017     ,input  'hist-from-prim'
     1018     ,output v-send
     1019     ) no-error .
     1020         end.
     1021       end.
     1022     end.
     1023     if v-send >= 0 then do:
     1024       run cur-time in this-procedure(output v-date, output v-time).
     1025       if p-action = integer('1':U) then do:
     1026         create buf_c-dis-card-property.
     1027         assign
     1028         buf_c-dis-card-property.d-card            = p-d-card
     1029         buf_c-dis-card-property.card-num          = p-card-num
     1030         buf_c-dis-card-property.host-code         = p-host-code
     1031         buf_c-dis-card-property.obj-type          = p-obj-type
     1032         buf_c-dis-card-property.obj-code          = p-obj-code
     1033         buf_c-dis-card-property.dt-code           = p-dt-code
     1034         buf_c-dis-card-property.node-code         = p-node-code
     1035         buf_c-dis-card-property.dtm-code         = p-dtm-code
     1036         buf_c-dis-card-property.main-card         = p-main-card
     1037         buf_c-dis-card-property.first-main-card   = p-first-main-card
     1038         buf_c-dis-card-property.first-card        = p-first-card
     1039         buf_c-dis-card-property.chip-num          = (if p-chip-num = 0
     1040                                                      then next-value (s-dc-chip, ub)
     1041                                                      else p-chip-num)
     1042         buf_c-dis-card-property.corr-time         = (if p-corr-time = ?
     1043                                                      then v-time
     1044                                                      else p-corr-time)
     1045         buf_c-dis-card-property.corr-user-db-num  = g#db-num
     1046         buf_c-dis-card-property.corr-user-name    = if g#news then (chr(4) +  'СПН':U) else g#userid
     1047         buf_c-dis-card-property.corr-date         = (if p-corr-date = ?
     1048                                                      then v-date
     1049                                                      else p-corr-date)
     1050         .
     1051       end.
     1052       else do:
     1053         create buf_c-dis-card-property.
     1054         buffer-copy buf_dis-card-property to buf_c-dis-card-property
     1055         assign
     1056         buf_c-dis-card-property.d-card             = buf_dis-card-property.d-card
     1057         buf_c-dis-card-property.card-num           = buf_dis-card-property.card-num
     1058         buf_c-dis-card-property.dt-code             = buf_dis-card-property.dt-code
     1059         buf_c-dis-card-property.main-card          = buf_dis-card-property.main-card
     1060         buf_c-dis-card-property.first-main-card    = buf_dis-card-property.first-main-card
     1061         buf_c-dis-card-property.first-card         = buf_dis-card-property.first-card
     1062         buf_c-dis-card-property.host-code          = buf_dis-card-property.host-code
     1063         buf_c-dis-card-property.obj-type          = p-obj-type
     1064         buf_c-dis-card-property.obj-code          = p-obj-code
     1065         buf_c-dis-card-property.node-code         = p-node-code
     1066         buf_c-dis-card-property.dtm-code         = p-dtm-code
     1067         buf_c-dis-card-property.chip-num           = (if p-chip-num = 0
     1068                                                       then next-value (s-dc-chip, ub)
     1069                                                       else p-chip-num)
     1070         buf_c-dis-card-property.corr-time          = (if p-corr-time = ?
     1071                                                       then v-time
     1072                                                       else p-corr-time)
     1073         buf_c-dis-card-property.corr-user-db-num   = g#db-num
     1074               buf_c-dis-card-property.corr-user-name    = (if g#news
     1075                                                      then (chr(4) +  'СПН':U)
     1076                                                      else (if g#esys
     1077                                                            then (chr(4) +  'ВС':U)
     1078                                                            else g#userid
     1079                                                            )
     1080                                                      )
     1081         buf_c-dis-card-property.corr-date          = (if p-corr-date = ?
     1082                                                       then v-date
     1083                                                       else p-corr-date)
     1084         .
     1085         run gen-key-rec in this-procedure (
     1086                                             input 'dis-card-property':U
     1087                                           ,input buffer buf_dis-card-property:handle
     1088                                           ,output v-uniq-key-rec).
     1089       end.
     1090       if p-chip-num = 0   then do:
     1091         create buf_c-dc-hist.
     1092         buffer-copy buf_c-dis-card-property to buf_c-dc-hist
     1093         assign
     1094         buf_c-dc-hist.action =  p-action
     1095         buf_c-dc-hist.subject = 'dis-card-property':U
     1096         buf_c-dc-hist.is-news = g#news
     1097         buf_c-dc-hist.source-type = p-source-type
     1098         buf_c-dc-hist.source-ref = p-source-ref
     1099         buf_c-dc-hist.uniq-key-rec = v-uniq-key-rec
     1100         .
     1101       end.
     1102       assign
     1103       p-chip-num = buf_c-dis-card-property.chip-num
     1104       p-corr-date = buf_c-dis-card-property.corr-date
     1105       p-corr-time = buf_c-dis-card-property.corr-time
     1106       .
     1107       run disproph_send-nws in this-procedure (
     1108                                                 buffer buf_c-dis-card-property
     1109                                                ,buffer buf_c-dc-hist
     1110                                                ,buffer buf_dis-card
     1111                                                 ).
     1112       end.
     1113     end.
     1114   end procedure.
     1115   procedure disproph_send-nws :
     1116   define parameter buffer buf_c-dis-card-property for ub.c-dis-card-property.
     1117   define parameter buffer buf_c-dc-hist for ub.c-dc-hist.
     1118   define parameter buffer buf_Dis-card for ub.dis-card.
     1119   define variable v-dh-hn as integer no-undo .
     1120   main-block:
     1121   do
     1122   on error undo, return error return-value
     1123   :
     1124     if g#news
     1125     and g#db-num > 0
     1126     and buf_c-dis-card-property.corr-user-db-num <> g#db-num
     1127     then return.
     1128     if g#db-num = 0
     1129     or (g#news
     1130         and g#db-num > 0
     1131         and buf_c-dis-card-property.corr-user-name = (chr(4) +  'СПН':U)
     1132         )
     1133     then do:
     1134       if not available buf_dis-card then do:
     1135         find first buf_dis-card no-lock where
     1136                   buf_Dis-card.d-card = buf_c-dis-card-property.d-card no-error.
     1137       end.
     1138       if not available buf_dis-card then do:
     1139         assign
     1140         v-dh-hn = integer('0':U).
     1141       end.
     1142       else do:
     1143   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1144   if (valid-handle(g#lib-nws) <> true) then do:   run nws/lib-nws.p persistent no-error .   if error-status :error or (valid-handle(g#lib-nws) <> true) then do:     message       "Error starting nws/lib-nws.p" skip       g#lib-nws skip       g#lib-nws :type skip       g#lib-nws :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-nws_get-hn-option in g#lib-nws
     1145     (input  g#db-num
     1146     ,input  'dis-card-property':U
     1147     ,input  0
     1148     ,input  '':U
     1149     ,input  0
     1150     ,input  buf_dis-card.type
     1151     ,input  '':U
     1152     ,input  '':U
     1153     ,input  buf_dis-card.emitent-host-code
     1154     ,input  (if buf_c-dis-card-property.dt-code > 0 then 0 else -1)
     1155     ,input  0
     1156     ,input  'hist-to-nws'
     1157     ,output v-dh-hn
     1158     ) no-error .
     1159       end.
     1160       if v-dh-hn >= 0 then do:
     1161         run str/callnews.p (
     1162           input 'c-dis-card-property':U
     1163           ,input (buffer buf_c-dis-card-property:handle)
     1164           ) no-error .
     1165         if error-status:error then do:
     1166           undo main-block,  return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1) ).
     1167         end.
     1168         if available buf_c-dc-hist then do:
     1169           run str/callnews.p (
     1170             input 'c-dc-hist':U
     1171             ,input (buffer buf_c-dc-hist:handle)
     1172             ) no-error .
     1173           if error-status:error then do:
     1174             undo main-block,  return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1) ).
     1175           end.
     1176         end.
     1177       end.
     1178     end.
     1179   end.
     1180   end procedure.
     1181   procedure discprop-node-code :
     1182   define input parameter p-dtm-code as integer no-undo .
     1183   define input parameter p-node-code as integer no-undo .
     1184   define output parameter p-data-type as character no-undo .
     1185   define output parameter p-format as character no-undo .
     1186   define output parameter p-label as character no-undo .
     1187   define output parameter p-range as integer no-undo .
     1188   define output parameter p-rw-option as character no-undo .
     1189   define buffer buf_prop-map for ub.prop-map.
     1190   define buffer buf_prop-head for ub.prop-head.
     1191   do
     1192   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1193   :
     1194   find first buf_prop-head no-lock where
     1195             buf_prop-head.dtm-code = p-dtm-code no-error .
     1196   if available buf_prop-head then do:
     1197     if p-node-code > 0 then do:
     1198       find first buf_prop-map no-lock where
     1199                 buf_prop-map.dtm-code = p-dtm-code
     1200             and buf_prop-map.node-code = p-node-code no-error .
     1201       if available buf_prop-map then do:
     1202         assign
     1203         p-data-type = buf_prop-map.node-value-type
     1204         p-format = buf_prop-map.node-format
     1205         p-label = buf_prop-map.node-label
     1206         p-rw-option = buf_prop-map.rw-option
     1207         .
     1208       end.
     1209     end.
     1210     if buf_prop-head.storage-place  = "":U
     1211     and buf_prop-head.storage-place-host  > "":U
     1212     and buf_prop-head.storage-place-obj  > "":U then do:
     1213       p-range =  12.
     1214     end.
     1215     if buf_prop-head.storage-place  > "":U
     1216     and buf_prop-head.storage-place-host  > "":U
     1217     and buf_prop-head.storage-place-obj  > "":U then do:
     1218       p-range =  3.
     1219     end.
     1220     if buf_prop-head.storage-place  > "":U
     1221     and buf_prop-head.storage-place-host  > "":U
     1222     and buf_prop-head.storage-place-obj  = "":U then do:
     1223       p-range =  2.
     1224     end.
     1225     if buf_prop-head.storage-place  = "":U
     1226     and buf_prop-head.storage-place-host  > "":U
     1227     and buf_prop-head.storage-place-obj  = "":U then do:
     1228       p-range =  1.
     1229     end.
     1230     if buf_prop-head.storage-place  > "":U
     1231     and buf_prop-head.storage-place-host  = "":U
     1232     and buf_prop-head.storage-place-obj  = "":U then do:
     1233       p-range =  0.
     1234     end.
     1235   end.
     1236   end.
     1237   end procedure.
     1238   procedure discprop-initial:
     1239   define input parameter p-dtm-code as integer no-undo .
     1240   define input parameter p-node-code as integer no-undo .
     1241   define output parameter p-init-value-character as character no-undo .
     1242   define output parameter p-init-value-date as date no-undo .
     1243   define output parameter p-init-value-decimal as decimal no-undo .
     1244   define output parameter p-init-value-integer as integer no-undo .
     1245   define output parameter p-init-value-logical as logical no-undo .
     1246   define buffer buf_prop-map for ub.prop-map.
     1247   find first buf_prop-map no-lock where
     1248             buf_prop-map.dtm-code = p-dtm-code
     1249         and buf_prop-map.node-code = p-node-code no-error.
     1250   if not available buf_prop-map then return error substitute("Не найдено свойство &1 для объекта &2"
     1251                                                               , p-node-code
     1252                                                               , p-dtm-code).
     1253   assign
     1254   p-init-value-character = buf_prop-map.init-value-character
     1255   p-init-value-date = buf_prop-map.init-value-date
     1256   p-init-value-decimal = buf_prop-map.init-value-decimal
     1257   p-init-value-integer = buf_prop-map.init-value-integer
     1258   p-init-value-logical = buf_prop-map.init-value-logical
     1259   .
     1260   end procedure.
     1261   Function discprop-usercanedit returns logical (  input p-dtm-code as integer, input p-db-num as integer):
     1262   define buffer buf_attr-prop for ub.attr-prop.
     1263   find first buf_attr-prop no-lock where
     1264             buf_attr-prop.table-name = 'dis-card-property':U
     1265         and buf_attr-prop.templ-rl-root = p-dtm-code
     1266         and buf_attr-prop.upper-prop-code = "UserCanEdit"
     1267         and buf_attr-prop.prop-code = (if p-db-num = 0 then 'DB0' else 'DBR':U) no-error.
     1268   if not available buf_attr-prop
     1269   or logical(buf_attr-prop.property-value) = no then do:
     1270     return no.
     1271   end.
     1272   return yes.
     1273   end function.
     1274   procedure discprop-edit :
     1275   define input parameter p-dtm-code-node-name as character no-undo .
     1276   define output parameter p-edit-menu-section-num as integer no-undo .
     1277   define buffer buf_attr-prop for ub.attr-prop.
     1278   do
     1279   on error undo, return error return-value
     1280   :
     1281     find first buf_attr-prop no-lock where
     1282             buf_attr-prop.table-name = 'dis-card-property':U
     1283        and  buf_attr-prop.templ-rl-root = integer(entry(1, p-dtm-code-node-name, chr(4)))
     1284        and  buf_attr-prop.upper-prop-code = "ManualEdit":U
     1285        and  buf_attr-prop.prop-code = "SectionNum":U no-error .
     1286     if available buf_attr-prop then do:
     1287       assign
     1288       p-edit-menu-section-num = integer(buf_attr-prop.property-value).
     1289     end.
     1290   end.
     1291   end procedure.
     1292   procedure discprop-node-name :
     1293   define input parameter p-dtm-code-node-name as character no-undo .
     1294   define output parameter p-tool-tip as character no-undo .
     1295   define output parameter p-node-label as character no-undo .
     1296   define buffer buf_prop-map for ub.prop-map.
     1297   define buffer buf_prop-head for ub.prop-head.
     1298   do
     1299   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1300   :
     1301     find first buf_prop-head no-lock where
     1302               buf_prop-head.dtm-code = integer(entry(1, p-dtm-code-node-name, chr(4) )) no-error .
     1303     assign
     1304     p-tool-tip   = if available buf_prop-head
     1305                    then buf_prop-head.prop-des
     1306                    else entry(1, p-dtm-code-node-name, chr(4) )
     1307     p-node-label = (if available buf_prop-head
     1308                     then buf_prop-head.prop-label
     1309                     else '':U)
     1310     .
     1311     if entry(2, p-dtm-code-node-name, chr(4) ) <> "" then do:
     1312       find first buf_prop-map no-lock where
     1313                 buf_prop-map.dtm-code = integer(entry(1, p-dtm-code-node-name, chr(4) ))
     1314           and  buf_prop-map.node-code = integer(entry(2, p-dtm-code-node-name, chr(4) )) no-error.
     1315       if available buf_prop-map then do:
     1316         assign
     1317         p-tool-tip   = buf_prop-map.node-description
     1318         p-node-label = (if available buf_prop-head
     1319                         then buf_prop-head.prop-label
     1320                         else '':U) + ":" + buf_prop-map.node-label
     1321         .
     1322       end.
     1323     end.
     1324   end.
     1325   end procedure.
     1326   procedure discprop-write :
     1327   define input parameter p-d-card          like ub.dis-card-property.d-card     no-undo .
     1328   define input parameter p-host-code       like ub.dis-card-property.host-code  no-undo .
     1329   define input parameter p-obj-type        like ub.dis-card-property.obj-type   no-undo .
     1330   define input parameter p-obj-code        like ub.dis-card-property.obj-code   no-undo .
     1331   define input parameter p-dtm-code        like ub.dis-card-property.dtm-code   no-undo .
     1332   define input parameter p-node-code       like ub.dis-card-property.node-code  no-undo .
     1333   define input parameter p-dt-code         like ub.dis-card-property.dt-code    no-undo .
     1334   define input parameter p-sum-id          like ub.dis-card-property.sum-id     no-undo .
     1335   define input parameter p-value-character like ub.dis-card-property.property-value-character no-undo .
     1336   define input parameter p-value-date      like ub.dis-card-property.property-value-date no-undo .
     1337   define input parameter p-value-decimal   like ub.dis-card-property.property-value-decimal no-undo .
     1338   define input parameter p-value-integer   like ub.dis-card-property.property-value-integer no-undo .
     1339   define input parameter p-value-logical   like ub.dis-card-property.property-value-logical no-undo .
     1340   define input parameter p-source-type     as character no-undo .
     1341   define input parameter p-source-ref      as character no-undo .
     1342   define input-output parameter p-chip-num as integer no-undo .
     1343   define input-output parameter p-corr-date as date no-undo .
     1344   define input-output parameter p-corr-time as integer no-undo .
     1345   do
     1346   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1347   :
     1348     define buffer buf_dis-card-property for ub.dis-card-property .
     1349     define buffer buf_dis-card for ub.dis-card.
     1350     define buffer buf_prop-ref for ub.prop-ref.
     1351     define variable v-data-type      as character no-undo .
     1352     define variable v-data-type-1    as character no-undo .
     1353     define variable v-format         as character no-undo .
     1354     define variable v-label          as character no-undo .
     1355     define variable v-range          as integer   no-undo .
     1356     define variable v-rw-option      as character no-undo .
     1357     run discprop-node-code in this-procedure
     1358       (
     1359        input  p-dtm-code
     1360       ,input  p-node-code
     1361       ,output v-data-type
     1362       ,output v-format
     1363       ,output v-label
     1364       ,output v-range
     1365       ,output v-rw-option
     1366       ) no-error .
     1367     if error-status :error then do:
     1368       undo, return error return-value .
     1369     end.
     1370     v-data-type-1 = entry(1, v-data-type).
     1371     if p-dt-code = ? then do:
     1372       find buf_prop-ref no-lock where
     1373           buf_prop-ref.dtm-code = p-dtm-code
     1374       and buf_prop-ref.sum-id = p-sum-id no-error.
     1375       if not available buf_prop-ref then do:
     1376         undo, return error substitute("Неопределен или неоднозначен ИТОГ/СРЕЗ для объекта-операнда &1 &2"
     1377                                       ,p-dtm-code
     1378                                       ,p-sum-id).
     1379       end.
     1380       assign
     1381       p-dt-code = buf_prop-ref.dt-code.
     1382     end.
     1383     if discprop-usercanedit ( input p-dtm-code, input g#db-num)  = no then do:
     1384       undo, return error "Нельзя редактировать свойство в данной БД".
     1385     end.
     1386     run discprop-check in this-procedure (
     1387                                             input v-range
     1388                                           ,input p-d-card
     1389                                           ,input p-host-code
     1390                                           ,input p-obj-type
     1391                                           ,input p-obj-code
     1392                                           ,input p-dtm-code
     1393                                           ,input p-node-code
     1394                                           ,input p-dt-code
     1395                                         ) no-error .
     1396     if error-status:error then undo,  return error return-value .
     1397     find first buf_dis-card-property exclusive-lock
     1398       where buf_dis-card-property.d-card    = p-d-card
     1399         and buf_dis-card-property.host-code = p-host-code
     1400         and buf_dis-card-property.obj-type  = p-obj-type
     1401         and buf_dis-card-property.obj-code  = p-obj-code
     1402         and buf_dis-card-property.dt-code = p-dt-code
     1403         and buf_dis-card-property.node-code = p-node-code
     1404       no-error .
     1405       find first buf_dis-card no-lock where
     1406                   buf_dis-card.d-card = p-d-card.
     1407     if not available buf_dis-card-property then do:
     1408       create buf_dis-card-property .
     1409       assign
     1410         buf_dis-card-property.d-card    = p-d-card
     1411         buf_dis-card-property.host-code = p-host-code
     1412         buf_dis-card-property.obj-type  = p-obj-type
     1413         buf_dis-card-property.obj-code  = p-obj-code
     1414         buf_dis-card-property.dt-code = p-dt-code
     1415         buf_dis-card-property.node-code = p-node-code
     1416         buf_dis-card-property.dtm-code = p-dtm-code
     1417         buf_dis-card-property.sum-id   = p-sum-id
     1418         buf_dis-card-property.card-num  = buf_dis-card.card-num
     1419         buf_dis-card-property.main-card  = buf_dis-card.main-card
     1420         buf_dis-card-property.first-card  = buf_dis-card.first-card
     1421         buf_dis-card-property.first-main-card  = buf_dis-card.first-main-card
     1422       .
     1423     end.
     1424     else do:
     1425       if (v-data-type-1 = 'character':U
     1426       and buf_dis-card-property.property-value-character = p-value-character)
     1427       or  (v-data-type-1 = 'date':U
     1428           and buf_dis-card-property.property-value-date = p-value-date)
     1429       or  (v-data-type-1 = 'decimal':U
     1430           and buf_dis-card-property.property-value-decimal = p-value-decimal)
     1431       or  (v-data-type-1 = 'integer':U
     1432           and buf_dis-card-property.property-value-integer = p-value-integer)
     1433       or  (v-data-type-1 = 'logical':U
     1434           and buf_dis-card-property.property-value-logical = p-value-logical)
     1435       then return.
     1436     end.
     1437     run disproph_write-dis-card-property-proc  in this-procedure (
     1438             buffer buf_dis-card-property
     1439             ,buffer Buf_dis-card
     1440             ,input p-d-card
     1441             ,input p-dt-code
     1442             ,input p-host-code
     1443             ,input p-obj-type
     1444             ,input p-obj-code
     1445             ,input p-dtm-code
     1446             ,input buf_dis-card.card-num
     1447             ,input buf_dis-card.main-card
     1448             ,input buf_dis-card.first-card
     1449             ,input buf_dis-card.first-main-card
     1450             ,input p-node-code
     1451             ,input (if new(buf_dis-card-property) then integer('1':U) else integer('2':U))
     1452             ,input p-source-type
     1453             ,input p-source-ref
     1454             ,input-output p-chip-num
     1455             ,input-output p-corr-date
     1456             ,input-output p-corr-time
     1457             ).
     1458     assign
     1459     buf_dis-card-property.property-value-character = (if v-data-type-1 = 'character':U
     1460                                                       then p-value-character
     1461                                                       else buf_dis-card-property.property-value-character)
     1462     buf_dis-card-property.property-value-date      = (if v-data-type-1 = 'date':U
     1463                                                       then p-value-date
     1464                                                       else buf_dis-card-property.property-value-date)
     1465     buf_dis-card-property.property-value-decimal   = (if v-data-type-1 = 'decimal':U
     1466                                                       then p-value-decimal
     1467                                                       else buf_dis-card-property.property-value-decimal)
     1468     buf_dis-card-property.property-value-integer   = (if v-data-type-1 = 'integer':U
     1469                                                       then p-value-integer
     1470                                                       else buf_dis-card-property.property-value-integer)
     1471     buf_dis-card-property.property-value-logical   = (if v-data-type-1 = 'logical':U
     1472                                                       then p-value-logical
     1473                                                       else buf_dis-card-property.property-value-logical)
     1474     buf_dis-card-property.trg-param = (if p-source-type = '':U then '':U else 'no-hist':U)
     1475     .
     1476     release buf_dis-card-property no-error .
     1477     if error-status:error then do:
     1478       return error return-value .
     1479     end.
     1480   end.
     1481   end procedure.
     1482   procedure discprop-delete :
     1483   define input parameter p-d-card    like ub.dis-card-property.d-card     no-undo .
     1484   define input parameter p-host-code like ub.dis-card-property.host-code  no-undo .
     1485   define input parameter p-obj-type  like ub.dis-card-property.obj-type   no-undo .
     1486   define input parameter p-obj-code  like ub.dis-card-property.obj-code   no-undo .
     1487   define input parameter p-dtm-code  like ub.dis-card-property.dtm-code   no-undo .
     1488   define input parameter p-node-code like ub.dis-card-property.node-code  no-undo .
     1489   define input parameter p-dt-code   like ub.dis-card-property.dt-code    no-undo .
     1490   define input parameter p-source-type as character no-undo .
     1491   define input parameter p-source-ref as character no-undo .
     1492   define output parameter p-deleted  as logical no-undo.
     1493   define input-output parameter p-chip-num as integer no-undo .
     1494   define input-output parameter p-corr-date as date no-undo .
     1495   define input-output parameter p-corr-time as integer no-undo .
     1496   do
     1497   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1498   :
     1499   define buffer buf_dis-card-property for ub.dis-card-property .
     1500   define buffer buf_dis-card for ub.dis-card.
     1501   define variable v-data-type      as character no-undo .
     1502   define variable v-format         as character no-undo .
     1503   define variable v-label          as character no-undo .
     1504   define variable v-range          as integer   no-undo .
     1505   define variable v-rw-option      as character   no-undo .
     1506     run discprop-node-code in this-procedure
     1507       (input  p-dtm-code
     1508       ,input  p-node-code
     1509       ,output v-data-type
     1510       ,output v-format
     1511       ,output v-label
     1512       ,output v-range
     1513       ,output v-rw-option
     1514       ) no-error .
     1515     if error-status :error then do:
     1516       undo, return error return-value .
     1517     end.
     1518     find first buf_dis-card-property exclusive-lock
     1519       where buf_dis-card-property.d-card    = p-d-card
     1520         and buf_dis-card-property.host-code = p-host-code
     1521         and buf_dis-card-property.obj-type  = p-obj-type
     1522         and buf_dis-card-property.obj-code  = p-obj-code
     1523         and buf_dis-card-property.dt-code = p-dt-code
     1524         and buf_dis-card-property.node-code = p-node-code
     1525       no-error NO-WAIT.
     1526     if not available buf_dis-card-property then do:
     1527       p-deleted = no.
     1528     end.
     1529     else do:
     1530       run disproph_write-dis-card-property-proc  in this-procedure (
     1531            buffer buf_dis-card-property
     1532           ,buffer buf_dis-card
     1533           ,input buf_dis-card-property.d-card
     1534           ,input buf_dis-card-property.dt-code
     1535           ,input buf_dis-card-property.host-code
     1536           ,input buf_dis-card-property.obj-type
     1537           ,input buf_dis-card-property.obj-code
     1538           ,input buf_dis-card-property.dtm-code
     1539           ,input buf_dis-card-property.card-num
     1540           ,input buf_dis-card-property.main-card
     1541           ,input buf_dis-card-property.first-card
     1542           ,input buf_dis-card-property.first-main-card
     1543           ,input buf_dis-card-property.node-code
     1544           ,input integer('99':U)
     1545           ,input p-source-type
     1546           ,input p-source-ref
     1547           ,input-output p-chip-num
     1548           ,input-output p-corr-date
     1549           ,input-output p-corr-time
     1550            ).
     1551       buf_dis-card-property.trg-param = (if p-source-type = '':U then '':U else 'no-hist':U).
     1552       delete buf_dis-card-property no-error .
     1553       if error-status:error then do:
     1554         return error return-value.
     1555       end.
     1556       p-deleted = yes.
     1557     end.
     1558   end.
     1559   end procedure.
     1560   procedure discprop-check :
     1561   define input parameter p-range  as integer no-undo .
     1562   define input parameter p-d-card like ub.dis-card-property.d-card no-undo .
     1563   define input parameter p-host-code like ub.dis-card-property.host-code no-undo .
     1564   define input parameter p-obj-type like ub.dis-card-property.obj-type no-undo .
     1565   define input parameter p-obj-code like ub.dis-card-property.obj-code no-undo .
     1566   define input parameter p-dtm-code like ub.dis-card-property.dtm-code no-undo .
     1567   define input parameter p-node-code like ub.dis-card-property.node-code no-undo .
     1568   define input parameter p-dt-code like ub.dis-card-property.dt-code no-undo .
     1569   define variable v-message as character no-undo .
     1570   define buffer buf_sysconf for ub.sysconf.
     1571   define buffer buf_clients for ub.clients.
     1572   define buffer buf_dis-card for ub.dis-card.
     1573   define buffer buf_attr-prop for ub.attr-prop.
     1574   do
     1575   on error undo, return error return-value
     1576   :
     1577     if p-host-code > 0 then do:
     1578       FIND FIRST buf_sysconf No-LOCK WHERE
     1579                 buf_sysconf.host-code = p-host-code No-ERROR.
     1580       IF NOT AVAIL buf_sysconf THEN DO:
     1581         v-message = substitute("Не найдена фирма &1", p-host-code).
     1582         RETURN ERROR v-message.
     1583       END.
     1584     end.
     1585     if p-obj-type <> "":U or
     1586         p-obj-code <> 0 then do:
     1587       find first buf_clients No-LOCK WHERE
     1588                 buf_clients.obj-type = p-obj-type AND
     1589                 buf_clients.obj-code = p-obj-code no-error .
     1590       if not available buf_clients then do:
     1591         v-message = substitute("Не найден объект &1&2", p-obj-type, p-obj-code).
     1592         RETURN ERROR v-message.
     1593       end.
     1594     end.
     1595     else if NOT (p-obj-type = "":U and p-obj-code = 0) then do:
     1596       v-message = substitute("Неверные значения параметров p-obj-type/p-obj-code и/или p-host-code: &1&2 &3"
     1597                               , p-obj-type
     1598                               , p-obj-code
     1599                               , p-host-code).
     1600       RETURN ERROR v-message.
     1601     end.
     1602     if p-d-card <> "":U then do:
     1603       find first buf_dis-card No-LOCK WHERE
     1604                   buf_dis-card.d-card = p-d-card No-ERROR.
     1605       if not avail buf_dis-card then do:
     1606         v-message =substitute("Не найдена ДК").
     1607         return error  v-message.
     1608       end.
     1609       if buf_dis-card.emitent-host-code <> 0
     1610       and p-host-code <> buf_dis-card.emitent-host-code then do:
     1611         v-message = substitute("Для фирменной карты свойство можно ввести только с привязкой к фирме-эмитенту").
     1612         return error v-message.
     1613       end.
     1614       if buf_dis-card.emitent-host-code = 0
     1615       and p-range = 1
     1616       and p-host-code <> 0 then do:
     1617         v-message = substitute("Для свойство с ОБЛАСТЬЮ ДЕЙСТВИЯ СОГЛАСНО КОДУ ЭМИТЕНТА&1" +
     1618                               "для ГЛОБАЛЬНОЙ карты можно ввести только ГЛОБАЛЬНОЕ свойство"
     1619                                 , chr(10)
     1620                               ).
     1621         return error v-message.
     1622       end.
     1623     end.
     1624   end.
     1625   end procedure.
     1626   define stream InStream.
     1627   define variable log-file-name                as character      no-undo init "in-stpl1.txt".
     1628   define variable v-view-log                   as logical        no-undo .
