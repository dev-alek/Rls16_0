        1   block-level on error undo, throw.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define input parameter p-parent-handle  as widget-handle no-undo .
        4   define input parameter p-log-handle  as handle no-undo .
        5   define input parameter p-parameter   as character no-undo .
        6   define variable file-name as char.
        7   define variable p-stop-list-code as character no-undo .
        8   define variable p-mode as character no-undo .
        9   define buffer buf_cli-person for ub.clients.
       10   define variable vss-revision    as character no-undo init "$Revision: fe7a405e2efa, 1410, rls $":U .
       11   define variable vss-author      as character no-undo init "$Author: SMMolotkov $":U .
       12   define variable vss-date        as character no-undo init "$Date: Thu Jun 28 15:24:34 2018 +0300 $":U .
       13   define variable vss-workfile    as character no-undo init "$Workfile: in-stpl1.p $":U .
       14   define variable vss-archive     as character no-undo init "$Archive: ref/in-stpl1.p $":U .
       15   define variable vss-description as character no-undo init "Утилита закачки стоплистов по формату СИБНЕФТЬ".
       16   procedure vss-get-info :
       17     define output parameter p-vss-revision    like vss-revision    no-undo .
       18     define output parameter p-vss-author      like vss-author      no-undo .
       19     define output parameter p-vss-date        like vss-date        no-undo .
       20     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       21     define output parameter p-vss-archive     like vss-archive     no-undo .
       22     define output parameter p-vss-description like vss-description no-undo .
       23     assign
       24       p-vss-revision    = vss-revision
       25       p-vss-author      = vss-author
       26       p-vss-date        = vss-date
       27       p-vss-workfile    = vss-workfile
       28       p-vss-archive     = vss-archive
       29       p-vss-description = vss-description
       30     .
       31   end procedure.
       32   procedure vss-get-parameters :
       33     define output parameter p-vss-parameters as character no-undo .
       34   end procedure.
       35   define new global shared variable g#vssrevis-logger as handle    no-undo .
       36   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       37   define variable v-vssrevis-logger                   as handle    no-undo .
       38   procedure vss-logevent :
       39     define input  parameter p-extra-paramters as character no-undo .
       40     define variable v-vssrevis-parameters as character no-undo .
       41     do
       42     on error undo, return error return-value
       43     :
       44       if  valid-handle(v-vssrevis-logger)
       45       and v-vssrevis-logger :get-signature("logevent") <> ""
       46       then do:
       47         run vss-get-parameters in this-procedure
       48           (output v-vssrevis-parameters
       49           ).
       50         run logevent in v-vssrevis-logger
       51           (input vss-workfile
       52           ,input vss-revision
       53           ,input v-vssrevis-parameters
       54           ,input p-extra-paramters
       55           ).
       56       end.
       57     end.
       58   end procedure.
       59   assign
       60     v-vssrevis-logger = g#vssrevis-logger
       61   .
       62   if  valid-handle(v-vssrevis-logger)
       63   and v-vssrevis-logger :get-signature("logevent") <> ""
       64   then do:
       65     assign
       66       v-vssrevis-logevent = true
       67     .
       68     run vss-logevent in this-procedure (input vss-description) .
       69   end.
       70   define new global shared variable g#language as character no-undo .
       71   if g#language <> '' and g#language <> 'rus':U then do:
       72     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       73   end.
       74   define new global shared variable g#library  as handle no-undo .
       75   define new global shared variable g#library2 as handle no-undo .
       76   define   shared variable g#auto as logical no-undo.
       77   define   shared variable g#news as logical no-undo.
       78   define   shared variable g#oxml as logical no-undo.
       79   define   shared variable g#esys as logical no-undo.
       80   define   shared variable g#news-source-db as integer no-undo.
       81   define   shared variable g#esys-source-esys as integer no-undo.
       82   define   shared variable g#db-num as integer   no-undo .
       83   define   shared variable g#userid as character no-undo .
       84   define   shared variable g#passwd as character no-undo .
       85   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       86   procedure cur-time :
       87      define output parameter p-today as date      no-undo .
       88      define output parameter p-time  as integer   no-undo .
       89     do
       90     on error undo, return error
       91     :
       92       define variable v-date1 as date      no-undo .
       93       define variable v-date2 as date      no-undo .
       94       define variable v-time  as integer   no-undo .
       95       assign
       96         v-date1 = today
       97         v-time  = time
       98         v-date2 = today
       99       .
      100       if v-date1 <> v-date2
      101       then do:
      102         assign
      103           v-date1 = today
      104           v-time  = v-time
      105         .
      106       end.
      107       assign
      108         p-today = v-date1
      109         p-time  = v-time
      110       .
      111     end.
      112   end.
      113   function cur-time-date returns character
      114   :
      115     return string(today, '99/99/9999':U) .
      116   end.
      117   function cur-time-mjd returns decimal
      118   :
      119     define variable v-date as date      no-undo .
      120     define variable v-time as integer   no-undo .
      121     run cur-time in this-procedure
      122       (output v-date
      123       ,output v-time
      124       ) .
      125     return integer(v-date) - 2400002 + (v-time / 86400) .
      126   end.
      127   function cur-time-get-ending-index returns integer
      128   (input p-number as integer
      129   )
      130   :
      131     if p-number < 0
      132     or p-number = ?
      133     then do:
      134       return 1 .
      135     end.
      136     define variable v-rest as integer   no-undo .
      137     assign
      138       p-number = p-number modulo 100
      139     .
      140     if p-number < 20
      141     then do:
      142       assign
      143         v-rest = p-number
      144       .
      145     end.
      146     else do:
      147       assign
      148         v-rest = p-number modulo 10
      149       .
      150     end.
      151     case v-rest :
      152       when 1
      153       then do:
      154         return 2 .
      155       end.
      156       when 2 or
      157       when 3 or
      158       when 4
      159       then do:
      160         return 3 .
      161       end.
      162       otherwise do:
      163         return 1 .
      164       end.
      165     end case .
      166   end.
      167   procedure cur-time-mjd-to-date :
      168      define input  parameter i-mjd-diff as decimal no-undo.
      169      define output parameter o-Date     as date    no-undo.
      170      define output parameter o-Time     as integer no-undo.
      171      define variable v-day-number as integer   no-undo .
      172      if    i-mjd-diff < 0
      173         or i-mjd-diff = ?
      174      then do:
      175         return "?" .
      176      end.
      177      assign
      178         v-day-number = truncate(i-mjd-diff,0).
      179         o-Date = date(v-day-number + 2400002).
      180         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      181     .
      182   end.
      183   function cur-time-mjd-to-string returns character
      184   (input p-mjd-diff as decimal
      185   )
      186   :
      187     define variable v-day-number as integer   no-undo .
      188     define variable v-seconds    as integer   no-undo .
      189     define variable v-hour       as integer   no-undo .
      190     define variable v-min        as integer   no-undo .
      191     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      192     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      193     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      194     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      195     if p-mjd-diff < 0
      196     or p-mjd-diff = ?
      197     then do:
      198       return "?" .
      199     end.
      200     assign
      201       v-day-number = integer(truncate(p-mjd-diff,0))
      202       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      203     .
      204     if v-seconds > 86400
      205     then do:
      206       assign
      207         v-seconds = 86400 - 1
      208       .
      209     end.
      210     if v-seconds < 0
      211     then do:
      212       assign
      213         v-seconds = 0
      214       .
      215     end.
      216     assign
      217       v-hour = truncate(v-seconds / 3600, 0)
      218     .
      219     assign
      220       v-seconds = v-seconds modulo 3600
      221     .
      222     assign
      223       v-min = truncate(v-seconds / 60, 0)
      224     .
      225     assign
      226       v-seconds = v-seconds modulo 60
      227     .
      228     return
      229         (if v-day-number <> 0
      230           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      231           else ""
      232         )
      233       + (if v-day-number <> 0 or v-hour <> 0
      234           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      235           else ""
      236         )
      237       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      238           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      239           else ""
      240         )
      241       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      242       .
      243   end.
      244   function cur-time-string returns character
      245   :
      246     define variable v-date as date      no-undo .
      247     define variable v-time as integer   no-undo .
      248     run cur-time in this-procedure
      249       (output v-date
      250       ,output v-time
      251       ) .
      252     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      253   end.
      254   function cur-time-string-sec returns character
      255   :
      256     define variable v-date as date      no-undo .
      257     define variable v-time as integer   no-undo .
      258     run cur-time in this-procedure
      259       (output v-date
      260       ,output v-time
      261       ) .
      262     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      263   end.
      264   function cur-time-custom  returns character
      265   (input p-prefix as character
      266   ,input p-date-format as character
      267   ,input p-delimiter as character
      268   ,input p-time-format as character
      269   ,input p-suffix as character
      270   )
      271   :
      272     define variable v-date as date      no-undo .
      273     define variable v-time as integer   no-undo .
      274     run cur-time in this-procedure
      275       (output v-date
      276       ,output v-time
      277       ) .
      278     return
      279       p-prefix
      280       + string(v-date, p-date-format)
      281       + p-delimiter
      282       + string(v-time, p-time-format)
      283       + p-suffix
      284       .
      285   end.
      286   function cur-time-print  returns character
      287   :
      288     define variable v-date as date      no-undo .
      289     define variable v-time as integer   no-undo .
      290     run cur-time in this-procedure
      291       (output v-date
      292       ,output v-time
      293       ) .
      294     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      295   end.
      296   function cur-time-datetime returns datetime
      297   :
      298     define variable v-char as character no-undo .
      299     define variable v-datetime as datetime no-undo .
      300     v-char = cur-time-string().
      301     v-datetime = datetime(v-char).
      302     return  v-datetime.
      303   end.
      304   function cur-time-string-msec returns character
      305   :
      306     define variable v-date as datetime  no-undo .
      307     v-date = now.
      308     return string(v-date) .
      309   end.
      310   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      311     define variable v-cntxt-db-num        as integer   no-undo .
      312     define variable v-cntxt-userid        as character no-undo .
      313     define variable v-cntxt-level         as character no-undo .
      314     define variable v-cntxt-host-code-obj as integer   no-undo .
      315     define variable v-cntxt-obj-type      as character no-undo .
      316     define variable v-cntxt-obj-code      as integer   no-undo .
      317     define variable v-cntxt-db-num-obj    as integer   no-undo .
      318     define variable v-cntxt-is-admin      as logical   no-undo .
      319   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      320   function ean-13 returns character ( input p-code as character
      321                                      ,input DC-PFX as character):
      322   define variable Dc-frmt as character no-undo INIT "ean13".
      323   define variable FULL-B-CODE as character no-undo .
      324   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      325     define variable tmp-str3  as character no-undo.
      326     define variable tmp-num3  as character no-undo.
      327     define variable i3        as integer   no-undo.
      328     define variable sum3      as integer   no-undo.
      329     define variable len-code3 as integer   no-undo.
      330     define variable varcont3  as logical   initial yes no-undo.
      331     CASE Dc-frmt :
      332       WHEN "EAN13" THEN do:
      333         assign
      334           tmp-str3 = string( p-code, "999999999999" )
      335         .
      336       end.
      337       WHEN "EAN8" THEN do:
      338         assign
      339           tmp-str3 = string( p-code, "9999999" )
      340         .
      341       end.
      342       OTHERWISE DO:
      343           message "Неизвестный тип генерации бар-кода процедурой bc-gnrti.i: " Dc-frmt " ."
      344           view-as alert-box error.
      345           return error.
      346       END.
      347     END CASE.
      348     if varcont3 = yes then do:
      349       if integer( substring( tmp-str3, 1, length( Dc-pfx ) ) ) <> 0
      350       then do:
      351         message
      352           "Невозможно сформировать бар-код" SKIP
      353           "для товара с кодом: " p-code
      354           view-as alert-box error title "подрезание кода".
      355         return error.
      356       end.
      357       else do:
      358         assign
      359           full-b-code = Dc-pfx + substring( tmp-str3, length( Dc-pfx ) + 1, length( tmp-str3 ) - length( Dc-pfx ) )
      360           len-code3    = length( full-b-code )
      361         .
      362         define variable v-sum-char3 as character no-undo .
      363         assign
      364           sum3 = 0
      365         .
      366         do i3 = 1 to len-code3 by 2
      367         :
      368           assign
      369             v-sum-char3 = substr(full-b-code, len-code3 - i3 + 1, 1)
      370           .
      371           if v-sum-char3 < "0"
      372           or v-sum-char3 > "9"
      373           then do:
      374             message
      375               "Невозможно сформировать бар-код" skip
      376               "для товара с кодом: " p-code skip
      377               view-as alert-box error title "подсчет контрольной суммы".
      378             return error.
      379           end.
      380           assign
      381             sum3 = sum3 + integer(v-sum-char3)
      382           .
      383         end.
      384         if varcont3 = yes then do:
      385           assign
      386             sum3 = sum3 * 3
      387           .
      388           do i3 = 2 to len-code3 by 2
      389           :
      390             assign
      391               v-sum-char3 = substr(full-b-code, len-code3 - i3 + 1, 1)
      392             .
      393             if v-sum-char3 < "0"
      394             or v-sum-char3 > "9"
      395             then do:
      396               message
      397                 "Невозможно сформировать бар-код" skip
      398                 "для товара с кодом: " p-code skip
      399                 view-as alert-box error title "подсчет контрольной суммы".
      400               return error.
      401             end.
      402             assign
      403               sum3 = sum3 + integer(v-sum-char3)
      404             .
      405           end.
      406           if varcont3 = yes then do:
      407              if sum3 mod 10 = 0 then do:
      408                assign
      409                  full-b-code = full-b-code + '0'
      410                .
      411              end.
      412              else do:
      413                assign
      414                  full-b-code = full-b-code + string(10 - sum3 mod 10)
      415                .
      416              end.
      417           end.
      418         end.
      419       end.
      420     end.
      421   return full-b-code .
      422   end function.
      423   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      424   def var vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      425   procedure gen-key-rec :
      426     define input  parameter p-tbl-name    as character no-undo.
      427     define input  parameter p-bh_tbl-name as handle    no-undo.
      428     define output parameter p-key-rec     as character no-undo.
      429     do
      430     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      431     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      432     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      433     :
      434       define variable fh               as handle    no-undo .
      435       define variable v-ok             as logical   no-undo .
      436       define variable v-inform         as character no-undo .
      437       define variable v-ind            as integer   no-undo .
      438       define variable v-idx-field-qnty as integer   no-undo .
      439       if p-tbl-name = ?
      440         or p-tbl-name = "":U
      441       then do:
      442         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info5 ).
      443       end.
      444       if not p-bh_tbl-name:available then do:
      445         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info5, p-tbl-name ).
      446       end.
      447       assign
      448         p-key-rec = p-tbl-name
      449         v-inform  = p-bh_tbl-name:index-information(1)
      450         v-ind     = 2
      451       .
      452       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      453       on error undo, return error
      454       :
      455         assign
      456           v-inform = p-bh_tbl-name:index-information( v-ind )
      457           v-ind    = v-ind + 1
      458         .
      459       end.
      460       if v-inform = ?
      461         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      462         or entry( 3, v-inform, ",":U ) <> "1":U
      463       then do:
      464         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info5, p-tbl-name ).
      465       end.
      466       else do:
      467         assign
      468           v-idx-field-qnty = num-entries( v-inform ) - 4
      469         .
      470         if v-idx-field-qnty < 2 then do:
      471           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info5, v-inform, p-tbl-name ).
      472         end.
      473         do v-ind = 1 to v-idx-field-qnty by 2
      474         on error undo, return error
      475         :
      476           assign
      477             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      478             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      479           .
      480         end.
      481       end.
      482       if p-key-rec = ? then do:
      483         assign
      484           p-key-rec = "":U
      485         .
      486         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info5, p-tbl-name ).
      487       end.
      488     end.
      489     return.
      490   end procedure.
      491   procedure gen-where-keyr-tab :
      492     define input  parameter i-tableSerach as character no-undo.
      493     define input  parameter i-tablekey   as character  no-undo.
      494     define input  parameter p-key-rec    as character  no-undo.
      495     define input  parameter p-key-handle as handle     no-undo .
      496     define input  parameter p-db-name    as character  no-undo .
      497     define input  parameter p-tt-handle  as handle     no-undo .
      498     define output parameter o-Where      as character  no-undo.
      499     do
      500     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      501     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      502     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      503     :
      504       define variable v-full-tbl-name  as character no-undo .
      505       define variable bh_tbl-name      as handle    no-undo .
      506       define variable fh_key           as handle    no-undo .
      507       define variable fh_search        as handle    no-undo .
      508       define variable v-field-num      as integer   no-undo .
      509       define variable v-count-fld      as integer   no-undo .
      510       define variable v-inform         as character no-undo .
      511       define variable v-ind            as integer   no-undo .
      512       define variable v-idx-field-qnty as integer   no-undo .
      513       define variable v-field-name     as character no-undo .
      514       define variable v-field-val      as character no-undo .
      515       define variable v-word-link      as character no-undo .
      516       define variable vTable           as character no-undo.
      517       define variable bh_tbl-key       as handle    no-undo .
      518       assign
      519         p-key-rec = trim( p-key-rec )
      520       .
      521       if p-key-handle <> ? then do:
      522         if not valid-handle(p-key-handle)
      523            or p-key-handle:type <> "buffer"
      524         then do:
      525           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info5 ).
      526         end.
      527         if num-entries( p-key-rec, chr(3) ) > 1
      528           or p-key-rec = ?
      529           or p-key-rec = "":U
      530         then do:
      531           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info5, p-key-rec ).
      532         end.
      533       end.
      534       else do:
      535         if p-key-rec = ?
      536           or p-key-rec = "":U
      537         then do:
      538           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info5 ).
      539         end.
      540       end.
      541       assign
      542         vTable = entry( 1 , p-key-rec, chr(3) )
      543       .
      544       if p-tt-handle <> ?
      545         and ( not valid-handle(p-tt-handle)
      546               or p-tt-handle:type <> "buffer"
      547             )
      548       then do:
      549         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info5, vTable, chr(10) ).
      550       end.
      551       if p-tt-handle = ? then do:
      552         assign
      553           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      554         .
      555         create buffer bh_tbl-name for table v-full-tbl-name .
      556       end.
      557       else do:
      558         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      559       end.
      560       assign
      561         v-inform = bh_tbl-name:index-information(1)
      562         v-ind    = 2
      563       .
      564       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      565       on error undo, return error
      566       :
      567         assign
      568           v-inform = bh_tbl-name:index-information( v-ind )
      569           v-ind    = v-ind + 1
      570         .
      571       end.
      572       if v-inform = ?
      573         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      574         or entry( 3, v-inform, ",":U ) <> "1":U
      575       then do:
      576         delete object bh_tbl-name no-error.
      577         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info5, vTable ).
      578       end.
      579       assign
      580         v-idx-field-qnty = num-entries( v-inform ) - 4
      581       .
      582       if v-idx-field-qnty < 2 then do:
      583         delete object bh_tbl-name no-error.
      584         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info5, v-inform, vTable ).
      585       end.
      586       assign
      587         o-where     = "where":U
      588         v-word-link = "":U
      589         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      590         v-count-fld = 0
      591       .
      592       if i-tablekey ne "" and i-tablekey ne ?
      593       then do:
      594         assign
      595           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      596         .
      597         create buffer bh_tbl-key for table v-full-tbl-name .
      598       end.
      599       if i-tableSerach ne "" and i-tableSerach ne ?
      600       then do:
      601         delete object bh_tbl-name no-error.
      602         assign
      603           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      604         .
      605         create buffer bh_tbl-name for table v-full-tbl-name .
      606       end.
      607       block_where:
      608       do v-ind = 1 to v-idx-field-qnty by 2
      609       on error undo, return error
      610       :
      611         assign
      612           v-count-fld = v-count-fld + 1
      613         .
      614         if p-key-handle = ?
      615           and v-count-fld > v-field-num
      616         then do:
      617           leave block_where.
      618         end.
      619         define variable VfieldKeyTable as handle no-undo.
      620         assign
      621           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      622           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      623         .
      624         if     bh_tbl-key ne ?
      625         then do:
      626            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      627            if VfieldKeyTable eq ?
      628            then next block_where.
      629         end.
      630         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      631         then
      632            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      633         else
      634            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      635         if p-key-handle = ? then do:
      636           assign
      637             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      638           .
      639         end.
      640         else do:
      641           assign
      642             fh_key = p-key-handle:buffer-field( v-field-name )
      643           .
      644           if fh_key = ?
      645             or not valid-handle( fh_key )
      646           then do:
      647             delete object bh_tbl-name.
      648             if     bh_tbl-key ne ?
      649             then
      650                delete object bh_tbl-key.
      651             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info5, p-key-handle:name, v-field-name ).
      652           end.
      653           assign
      654             v-field-val = fh_key:buffer-value
      655           .
      656         end.
      657         if fh_search:data-type ="character":U then do:
      658           assign
      659             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      660             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      661             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      662             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      663             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      664             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      665             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      666             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      667             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      668             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      669             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      670             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      671             v-field-val = substitute( '"&1"', v-field-val )
      672           .
      673         end.
      674         assign
      675           o-where = substitute( "&1 &2", o-where, v-field-val )
      676         .
      677         if v-word-link = "":U then do:
      678           assign
      679             v-word-link = "and":U
      680           .
      681         end.
      682       end.
      683       delete object bh_tbl-name.
      684       if     bh_tbl-key ne ?
      685       then
      686          delete object bh_tbl-key.
      687       if p-key-handle = ?
      688         and v-count-fld <> v-field-num
      689       then do:
      690         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info5, vTable ).
      691       end.
      692     end.
      693   end procedure.
      694   procedure gen-hn-keyr-tab :
      695     define input  parameter i-tableSerach as character no-undo.
      696     define input  parameter i-tablekey   as character no-undo.
      697     define input  parameter p-key-rec    as character no-undo.
      698     define input  parameter p-key-handle as handle    no-undo .
      699     define input  parameter p-db-name    as character no-undo .
      700     define input  parameter p-tt-handle  as handle    no-undo .
      701     define input  parameter p-stts-lock  as integer   no-undo .
      702     define output parameter o-hn         as handle    no-undo.
      703     define variable v-full-tbl-name as character no-undo.
      704     define variable v-where         as character no-undo.
      705     define variable bh_tbl-name     as handle    no-undo.
      706     define variable vTable          as character no-undo.
      707     do
      708     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      709     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      710     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      711         run gen-where-keyr-tab(i-tableSerach,
      712                                i-tablekey,
      713                                p-key-rec,
      714                                p-key-handle,
      715                                p-db-name,
      716                                p-tt-handle,
      717                                output v-where).
      718         if i-tableSerach ne "" and i-tableSerach ne ?
      719         then do:
      720            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      721            create buffer bh_tbl-name for table v-full-tbl-name .
      722         end.
      723         else do:
      724            if p-tt-handle = ? then do:
      725               assign
      726                  vTable = entry( 1 , p-key-rec, chr(3) )
      727               .
      728               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      729               create buffer bh_tbl-name for table v-full-tbl-name .
      730            end.
      731            else do:
      732               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      733            end.
      734         end.
      735         if p-tt-handle = ? then do:
      736            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      737         end.
      738         else do:
      739            bh_tbl-name:find-first( v-where ) no-error .
      740         end.
      741         o-hn = bh_tbl-name.
      742      end.
      743   end procedure.
      744   procedure gen-hn-keyr :
      745     define input  parameter p-key-rec    as character no-undo.
      746     define input  parameter p-key-handle as handle    no-undo .
      747     define input  parameter p-db-name    as character no-undo .
      748     define input  parameter p-tt-handle  as handle    no-undo .
      749     define input  parameter p-stts-lock  as integer   no-undo .
      750     define output parameter o-hn         as handle    no-undo.
      751     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      752   end.
      753   procedure gen-row-keyr :
      754     define input  parameter p-key-rec    as character no-undo.
      755     define input  parameter p-key-handle as handle    no-undo .
      756     define input  parameter p-db-name    as character no-undo .
      757     define input  parameter p-tt-handle  as handle    no-undo .
      758     define input  parameter p-stts-lock  as integer   no-undo .
      759     define output parameter p-tbl-row    as rowid     no-undo.
      760     define output parameter p-tbl-name   as character no-undo.
      761     define variable vHn as handle no-undo.
      762       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      763       p-tbl-row = if vHn:available then vHn:rowid else ?.
      764       p-tbl-name =  vHn:table.
      765       delete object vHn no-error.
      766     if p-tbl-row = ? then do:
      767       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info5, p-tbl-name, p-key-rec ).
      768     end.
      769     else do:
      770       return.
      771     end.
      772   end procedure.
      773   procedure gen-key-fv :
      774     define input  parameter p-key-rec    as character no-undo .
      775     define output parameter p-field-list as character no-undo .
      776     define output parameter p-value-list as character no-undo.
      777     do
      778     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      779     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      780     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      781     :
      782       define variable v-full-tbl-name  as character no-undo .
      783       define variable bh_tbl-name      as handle    no-undo .
      784       define variable v-tbl-name       as character no-undo .
      785       define variable v-field-num      as integer   no-undo .
      786       define variable v-count-fld      as integer   no-undo .
      787       define variable v-inform         as character no-undo .
      788       define variable v-ind            as integer   no-undo .
      789       define variable v-idx-field-qnty as integer   no-undo .
      790       define variable v-delim-key      as character no-undo .
      791       if p-key-rec = ?
      792         or p-key-rec = "":U
      793       then do:
      794         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info5 ).
      795       end.
      796       assign
      797         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      798         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      799       .
      800       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      801       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info5 ).
      802       assign
      803         v-inform = bh_tbl-name:index-information(1)
      804         v-ind    = 2
      805       .
      806       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      807       on error undo, return error
      808       :
      809         assign
      810           v-inform = bh_tbl-name:index-information( v-ind )
      811           v-ind    = v-ind + 1
      812         .
      813       end.
      814       if v-inform = ?
      815         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      816         or entry( 3, v-inform, ",":U ) <> "1":U
      817       then do:
      818         delete object bh_tbl-name no-error.
      819         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info5, v-tbl-name ).
      820       end.
      821       assign
      822         v-idx-field-qnty = num-entries( v-inform ) - 4
      823       .
      824       if v-idx-field-qnty < 2 then do:
      825         delete object bh_tbl-name no-error.
      826         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info5, v-inform, v-tbl-name ).
      827       end.
      828       assign
      829         p-field-list = "":U
      830         p-value-list = "":U
      831         v-delim-key  = "":U
      832         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      833         v-count-fld  = 0
      834       .
      835       block_where:
      836       do v-ind = 1 to v-idx-field-qnty by 2
      837       on error undo, return error
      838       :
      839         assign
      840           v-count-fld = v-count-fld + 1
      841         .
      842         if v-count-fld > v-field-num then do:
      843           leave block_where.
      844         end.
      845         assign
      846           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      847           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      848         .
      849         if v-ind = 1 then do:
      850           assign
      851             v-delim-key = chr(3)
      852           .
      853         end.
      854       end.
      855       delete object bh_tbl-name.
      856       if v-count-fld <> v-field-num then do:
      857         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info5, v-tbl-name ).
      858       end.
      859     end.
      860   end procedure.
      861   procedure gen-key-field :
      862     define input  parameter p-table      as character no-undo .
      863     define output parameter p-field-list as character no-undo .
      864     do
      865     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      866     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      867     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      868     :
      869       define variable v-full-tbl-name  as character no-undo .
      870       define variable bh_tbl-name      as handle    no-undo .
      871       define variable v-tbl-name       as character no-undo .
      872       define variable v-field-num      as integer   no-undo .
      873       define variable v-count-fld      as integer   no-undo .
      874       define variable v-inform         as character no-undo .
      875       define variable v-ind            as integer   no-undo .
      876       define variable v-idx-field-qnty as integer   no-undo .
      877       define variable v-delim-key      as character no-undo .
      878       if p-table = ?
      879         or p-table = "":U
      880       then do:
      881         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info5 ).
      882       end.
      883       assign
      884         v-tbl-name      = p-table
      885         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      886       .
      887       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      888       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info5 ).
      889       assign
      890         v-inform = bh_tbl-name:index-information(1)
      891         v-ind    = 2
      892       .
      893       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      894       on error undo, return error
      895       :
      896         assign
      897           v-inform = bh_tbl-name:index-information( v-ind )
      898           v-ind    = v-ind + 1
      899         .
      900       end.
      901       if v-inform = ?
      902         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      903         or entry( 3, v-inform, ",":U ) <> "1":U
      904       then do:
      905         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info5, v-tbl-name ).
      906       end.
      907       assign
      908         v-idx-field-qnty = num-entries( v-inform ) - 4
      909       .
      910       if v-idx-field-qnty < 2 then do:
      911         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info5, v-inform, v-tbl-name ).
      912       end.
      913       assign
      914         p-field-list = "":U
      915         v-delim-key  = "":U
      916         v-count-fld  = 0
      917       .
      918       block_where:
      919       do v-ind = 1 to v-idx-field-qnty by 2
      920       on error undo, return error
      921       :
      922         assign
      923           v-count-fld = v-count-fld + 1
      924         .
      925         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      926         if v-ind = 1 then do:
      927           assign
      928             v-delim-key = chr(3)
      929           .
      930         end.
      931       end.
      932       delete object bh_tbl-name.
      933     end.
      934   end procedure.
      935   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      936   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      937   define variable v-disprop-menu-section-num as integer no-undo .
      938   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      939   def var vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      940   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      941   define new global shared variable g#lib-nws as handle no-undo .
      942   procedure disproph_write-dis-card-property-proc  :
      943   define parameter buffer buf_dis-card-property for ub.dis-card-property .
      944   define parameter buffer buf_dis-card for ub.dis-card.
      945   define input parameter p-d-card      like ub.dis-card-property.d-card no-undo .
      946   define input parameter p-dt-code      like ub.dis-card-property.dt-code no-undo .
      947   define input parameter p-host-code   like ub.dis-card-property.host-code no-undo .
      948   define input parameter p-obj-type    like ub.dis-card-property.obj-type no-undo .
      949   define input parameter p-obj-code    like ub.dis-card-property.obj-code no-undo .
      950   define input parameter p-dtm-code    like ub.dis-card-property.dtm-code no-undo .
      951   define input parameter p-card-num    like ub.dis-card-property.card-num  no-undo .
      952   define input parameter p-main-card   like ub.dis-card-property.main-card  no-undo .
      953   define input parameter p-first-card  like ub.dis-card-property.first-card  no-undo .
      954   define input parameter p-first-main-card  like ub.dis-card-property.first-main-card  no-undo .
      955   define input parameter p-node-code   like ub.dis-card-property.node-code no-undo .
      956   define input parameter p-action      as integer no-undo .
      957   define input parameter p-source-type like ub.c-dc-hist.source-type no-undo .
      958   define input parameter p-source-ref  like ub.c-dc-hist.source-ref no-undo .
      959   define input-output parameter p-chip-num as integer no-undo .
      960   define input-output parameter p-corr-date as date no-undo .
      961   define input-output parameter p-corr-time as integer no-undo .
      962   define variable v-date as date      no-undo.
      963   define variable v-time  as integer   no-undo.
      964   define variable v-uniq-key-rec as character no-undo .
      965   define variable v-send as integer no-undo .
      966   define buffer buf_c-dc-hist for ub.c-dc-hist.
      967   define buffer buf_c-dis-card-property for ub.c-dis-card-property.
      968     main-block:
      969     do
      970     on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      971     on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      972     on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      973     :
      974       if not available buf_dis-card-property and not p-action = integer('1':U) then do:
      975         message
      976           vss-workfile vss-revision vss-description skip
      977           "Ошибка задания входных параметров" skip
      978           "Не определена запись СВОЙСТВА ДК" skip
      979           view-as alert-box error .
      980         undo, return error .
      981       end.
      982     v-send = integer('0':U).
      983     if not p-action = integer('1':U) then do:
      984       if available buf_dis-card then do:
      985         if g#news then do:
      986   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      987   if (valid-handle(g#lib-nws) <> true) then do:   run nws/lib-nws.p persistent no-error .   if error-status :error or (valid-handle(g#lib-nws) <> true) then do:     message       "Error starting nws/lib-nws.p" skip       g#lib-nws skip       g#lib-nws :type skip       g#lib-nws :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-nws_get-hn-option in g#lib-nws
      988     (input  g#db-num
