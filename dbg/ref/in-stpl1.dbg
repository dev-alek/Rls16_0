     2572         NEXT _stroka2.
     2573       end.
     2574       find first buf_dis-card-type no-lock where
     2575               buf_dis-card-type.emitent-host-code = buf_dis-card.emitent-host-code
     2576         and  buf_dis-card-type.type = buf_dis-card.type no-error.
     2577       if not available buf_dis-card-type then do:
     2578         my-mess = substitute("!!!Не удалось определить тип ДК для ДК &1", buf_dis-card.d-card).
     2579         run err-write2 in this-procedure ( input-output my-mess).
     2580         NEXT _stroka2.
     2581       end.
     2582       v-pay-code = buf_dis-card-type.pay-code.
     2583       if temp-imp.product-code = ?
