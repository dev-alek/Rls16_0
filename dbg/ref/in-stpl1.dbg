     3070   PROCEDURE err-write:
     3071     DEFINE INPUT-OUTPUT PARAMETER mess as char No-UNDO.
     3072     seek STREAM Instream to my-seek1.
     3073     import stream InStream unformatted
     3074     s.
     3075     v-global-err = yes.
     3076     run write-log-and-file in p-log-handle (
     3077           input 1
     3078         , input log-file-name
     3079         , input 1
     3080         , input mess + chr(10) + s).
     3081     assign
     3082     v-view-log = yes.
     3083     mess = "".
     3084     seek STREAM Instream to my-seek2.
     3085   END PROCEDURE.
     3086   PROCEDURE err-write2:
     3087     DEFINE INPUT-OUTPUT PARAMETER mess as char No-UNDO.
     3088     v-global-err = yes.
     3089     mess = substitute("&1&2Счет &3"
     3090                       ,mess
     3091                       ,chr(10)
     3092                       ,temp-imp.src-d-card
     3093                       ).
     3094     run write-log-and-file in p-log-handle (
     3095           input 1
     3096         , input log-file-name
     3097         , input 1
     3098         , input mess).
     3099     assign
     3100     v-view-log = yes.
     3101     mess = "".
     3102   END PROCEDURE.
     3103   PROCEDURE err-write3:
