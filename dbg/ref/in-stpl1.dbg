     2556           NEXT _stroka2.
     2557         end.
     2558         assign
     2559         temp-imp.d-card = full-d-card.
     2560         FIND FIRST buf_dis-card NO-LOCK WHERE
     2561                     buf_dis-card.d-card = temp-imp.d-card NO-ERROR.
     2562         if not available buf_dis-card then do:
     2563           my-mess = substitute("!!!Нет дисконтной карты с номером &1"
     2564                                 , temp-imp.d-card).
     2565           run err-write2 in this-procedure ( input-output my-mess).
