     2449                   input 1
     2450                 , input log-file-name
     2451                 , input 1
     2452                 , input my-mess).
     2453             v-view-log = yes.
     2454   define variable vss-include-info33 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
