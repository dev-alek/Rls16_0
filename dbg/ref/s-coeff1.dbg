        1   block-level on error undo, throw.
        2   define input parameter p-mode            as character no-undo .
        3   define input parameter p-gds-code        like ub.s-coeff.gds-code no-undo .
        4   define input parameter p-host-code       like ub.s-coeff.host-code no-undo .
        5   define input parameter p-obj-type        like ub.s-coeff.obj-type no-undo .
        6   define input parameter p-obj-code        like ub.s-coeff.obj-code no-undo .
        7   define temp-table tt0-s-coeff no-undo like ub.s-coeff.
        8   DEFINE INPUT PARAMETER TABLE FOR tt0-s-coeff.
        9   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       10   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       11   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       12   define variable vss-workfile    as character no-undo init "$Workfile: s-coeff1.p $":U .
       13   define variable vss-archive     as character no-undo init "$Archive: ref/s-coeff1.p $":U .
       14   define variable vss-description as character no-undo init "Сохранение изменеий сезонных коэффициентов товара".
       15   procedure vss-get-info :
       16     define output parameter p-vss-revision    like vss-revision    no-undo .
       17     define output parameter p-vss-author      like vss-author      no-undo .
       18     define output parameter p-vss-date        like vss-date        no-undo .
       19     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       20     define output parameter p-vss-archive     like vss-archive     no-undo .
       21     define output parameter p-vss-description like vss-description no-undo .
       22     assign
       23       p-vss-revision    = vss-revision
       24       p-vss-author      = vss-author
       25       p-vss-date        = vss-date
       26       p-vss-workfile    = vss-workfile
       27       p-vss-archive     = vss-archive
       28       p-vss-description = vss-description
       29     .
       30   end procedure.
       31   procedure vss-get-parameters :
       32     define output parameter p-vss-parameters as character no-undo .
       33   end procedure.
       34   define new global shared variable g#vssrevis-logger as handle    no-undo .
       35   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       36   define variable v-vssrevis-logger                   as handle    no-undo .
       37   procedure vss-logevent :
       38     define input  parameter p-extra-paramters as character no-undo .
       39     define variable v-vssrevis-parameters as character no-undo .
       40     do
       41     on error undo, return error return-value
       42     :
       43       if  valid-handle(v-vssrevis-logger)
       44       and v-vssrevis-logger :get-signature("logevent") <> ""
       45       then do:
       46         run vss-get-parameters in this-procedure
       47           (output v-vssrevis-parameters
       48           ).
       49         run logevent in v-vssrevis-logger
       50           (input vss-workfile
       51           ,input vss-revision
       52           ,input v-vssrevis-parameters
       53           ,input p-extra-paramters
       54           ).
       55       end.
       56     end.
       57   end procedure.
       58   assign
       59     v-vssrevis-logger = g#vssrevis-logger
       60   .
       61   if  valid-handle(v-vssrevis-logger)
       62   and v-vssrevis-logger :get-signature("logevent") <> ""
       63   then do:
       64     assign
       65       v-vssrevis-logevent = true
       66     .
       67     run vss-logevent in this-procedure (input vss-description) .
       68   end.
       69   define new global shared variable g#language as character no-undo .
       70   if g#language <> '' and g#language <> 'rus':U then do:
       71     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       72   end.
       73   define variable v-recid as recid no-undo .
       74   define variable v-err-mess as character no-undo .
       75   define buffer buf_goods for ub.goods.
       76   define buffer buf_s-coeff for ub.s-coeff.
       77   _main:
       78   do
       79   on error undo, return error return-value
       80   :
       81     find first buf_goods no-lock where buf_goods.gds-code = p-gds-code no-error .
       82     if not available buf_goods then do:
       83       undo, return error substitute("&1 &2 &3&4Не найден товар с кодом &5"
       84                                    , vss-workfile
       85                                    , vss-revision
       86                                    , vss-description
       87                                    , chr(10)
       88                                    , p-gds-code).
       89     end.
       90     FOR EACH tt0-s-coeff:
       91         find FIRST buf_s-coeff WHERE
       92                   buf_s-coeff.gds-code = p-gds-code
       93               AND buf_s-coeff.host-code = tt0-s-coeff.host-code
       94               AND buf_s-coeff.obj-type  = tt0-s-coeff.obj-type
       95               AND buf_s-coeff.obj-code  = tt0-s-coeff.obj-code
       96               AND buf_s-coeff.s-date  = tt0-s-coeff.s-date  no-error.
       97       IF not available buf_s-coeff
       98       or buf_s-coeff.coeff-value <> tt0-s-coeff.coeff-value   THEN DO:
       99         if available buf_s-coeff then v-recid = recid(buf_s-coeff).
      100         run ref/scoeff01.p (
      101                                 input-output v-recid
      102                                 ,input (if available buf_s-coeff then 'ИЗМЕНЕНИЕ':U else 'ДОБАВЛЕНИЕ':U)
      103                                 ,input p-gds-code
      104                                 ,input tt0-s-coeff.host-code
      105                                 ,input tt0-s-coeff.obj-type
      106                                 ,input tt0-s-coeff.obj-code
      107                                 ,input tt0-s-coeff.s-date
      108                                 ,input tt0-s-coeff.coeff-value
      109                                 ) no-error.
      110         IF ERROR-STATUS:ERROR THEN DO:
      111           assign
      112           v-err-mess = substitute("Ошибка при сохранении сезонного коэффициента товара &1 фирма &2 объект &3 дата &4:&5&6 &7"
      113                                   , p-gds-code
      114                                   , tt0-s-coeff.host-code
      115                                   , (tt0-s-coeff.obj-type + string(tt0-s-coeff.obj-code))
      116                                   , (string(day(tt0-s-coeff.s-date)) + chr(47) + string(month(tt0-s-coeff.s-date)))
      117                                   , chr(10)
      118                                   ,error-status:get-message(1)
      119                                   ,return-value).
      120           undo _main, return error v-err-mess.
      121         END.
      122       END.
      123     END.
      124     if p-mode <> 'ДОБАВЛЕНИЕ':U then do:
      125       FOR EACH buf_s-coeff where buf_s-coeff.gds-code = p-gds-code:
      126           FIND FIRST tt0-s-coeff NO-LOCK WHERE
      127               tt0-s-coeff.gds-code = p-gds-code
      128           AND tt0-s-coeff.host-code = buf_s-coeff.host-code
      129           AND tt0-s-coeff.obj-type  = buf_s-coeff.obj-type
      130           AND tt0-s-coeff.obj-code  = buf_s-coeff.obj-code
      131           AND tt0-s-coeff.s-date  = buf_s-coeff.s-date  no-error.
      132         IF NOT AVAILABLE tt0-s-coeff THEN DO:
      133           if buf_s-coeff.host-code = 0
      134           AND buf_s-coeff.obj-type = "":U
      135           AND buf_s-coeff.obj-code = 0
      136           AND buf_s-coeff.s-date = 01/01/1996 then next.
      137           delete buf_s-coeff no-error.
      138           IF error-status:error
      139           THEN DO:
      140             assign
      141             v-err-mess = substitute("Ошибка при удалении сезонного коэффициента товара &1 фирма &2 объект &3 дата &4:&5&6 &7"
      142                                     , p-gds-code
      143                                     , buf_s-coeff.host-code
      144                                     , (tt0-s-coeff.obj-type + string(tt0-s-coeff.obj-code))
      145                                     , (string(day(tt0-s-coeff.s-date)) + chr(47) + string(month(tt0-s-coeff.s-date)))
      146                                     , chr(10)
      147                                     ,error-status:get-message(1)
      148                                     ,return-value
      149                                     ).
      150             undo _main, return error v-err-mess.
      151           END.
      152         END.
      153       END.
      154     end.
      155   end.
