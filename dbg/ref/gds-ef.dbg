        1   DEFINE NEW SHARED BUFFER Buf_ext-classif FOR ub.ext-classif.
        2   DEFINE NEW SHARED BUFFER Buf_goods FOR ub.goods.
        3   define input  parameter parParentProc AS WIDGET-HANDLE NO-UNDO.
        4   DEFINE INPUT PARAMETER bttns AS character NO-UNDO.
        5   define input  parameter p-list-mode  as character no-undo .
        6   define output parameter p-rid-list as character no-undo .
        7   define variable vss-revision    as character no-undo init "$Revision$":U .
        8   define variable vss-author      as character no-undo init "$Author$":U .
        9   define variable vss-date        as character no-undo init "$Date$":U .
       10   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       11   define variable vss-archive     as character no-undo init "$Archive$":U .
       12   define variable vss-description as character no-undo init "Типы топлива для внешней системы EASYFUEL".
       13   procedure vss-get-info :
       14     define output parameter p-vss-revision    like vss-revision    no-undo .
       15     define output parameter p-vss-author      like vss-author      no-undo .
       16     define output parameter p-vss-date        like vss-date        no-undo .
       17     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       18     define output parameter p-vss-archive     like vss-archive     no-undo .
       19     define output parameter p-vss-description like vss-description no-undo .
       20     assign
       21       p-vss-revision    = vss-revision
       22       p-vss-author      = vss-author
       23       p-vss-date        = vss-date
       24       p-vss-workfile    = vss-workfile
       25       p-vss-archive     = vss-archive
       26       p-vss-description = vss-description
       27     .
       28   end procedure.
       29   procedure vss-get-parameters :
       30     define output parameter p-vss-parameters as character no-undo .
       31   end procedure.
       32   define new global shared variable g#vssrevis-logger as handle    no-undo .
       33   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       34   define variable v-vssrevis-logger                   as handle    no-undo .
       35   procedure vss-logevent :
       36     define input  parameter p-extra-paramters as character no-undo .
       37     define variable v-vssrevis-parameters as character no-undo .
       38     do
       39     on error undo, return error return-value
       40     :
       41       if  valid-handle(v-vssrevis-logger)
       42       and v-vssrevis-logger :get-signature("logevent") <> ""
       43       then do:
       44         run vss-get-parameters in this-procedure
       45           (output v-vssrevis-parameters
       46           ).
       47         run logevent in v-vssrevis-logger
       48           (input vss-workfile
       49           ,input vss-revision
       50           ,input v-vssrevis-parameters
       51           ,input p-extra-paramters
       52           ).
       53       end.
       54     end.
       55   end procedure.
       56   assign
       57     v-vssrevis-logger = g#vssrevis-logger
       58   .
       59   if  valid-handle(v-vssrevis-logger)
       60   and v-vssrevis-logger :get-signature("logevent") <> ""
       61   then do:
       62     assign
       63       v-vssrevis-logevent = true
       64     .
       65     run vss-logevent in this-procedure (input vss-description) .
       66   end.
       67   define new global shared variable g#language as character no-undo .
       68   if g#language <> '' and g#language <> 'rus':U then do:
       69     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       70   end.
       71   define new global shared variable g#library  as handle no-undo .
       72   define new global shared variable g#library2 as handle no-undo .
       73   define   shared variable g#auto as logical no-undo.
       74   define   shared variable g#news as logical no-undo.
       75   define   shared variable g#oxml as logical no-undo.
       76   define   shared variable g#esys as logical no-undo.
       77   define   shared variable g#news-source-db as integer no-undo.
       78   define   shared variable g#esys-source-esys as integer no-undo.
       79   define   shared variable g#db-num as integer   no-undo .
       80   define   shared variable g#userid as character no-undo .
       81   define   shared variable g#passwd as character no-undo .
       82   procedure proc-alt-shift-f2:
       83     if not ibs.th.gbl.gbl-var:rcode
       84   then
       85     run gbl\inidebug.p .
       86   end.
       87   procedure proc-alt-shift-f3:
       88     run gbl/prvssinf.p
       89       ( input this-procedure
       90       ) .
       91   end.
       92   define variable v-inform-launched as logical no-undo initial false .
       93   procedure proc-alt-shift-f4:
       94     define variable v-action as character no-undo .
       95     if v-inform-launched = false then do:
       96       assign
       97         v-inform-launched = true
       98       .
       99       run gbl/d-inform.w
      100         (  input self
      101         ,  input this-procedure
      102         , output v-action
      103         ) no-error .
      104       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      105       assign
      106         v-inform-launched = false
      107       .
      108     end.
      109   end.
      110   procedure proc-alt-f1:
      111     run gbl/corrhelp.p
      112       (input this-procedure
      113       ) .
      114   end .
      115   on alt-shift-f2 anywhere do:
      116     run proc-alt-shift-f2.
      117   end.
      118   on alt-shift-f3 anywhere do:
      119     run proc-alt-shift-f3 in this-procedure .
      120   end.
      121   on alt-shift-f4 anywhere do:
      122     run proc-alt-shift-f4 in this-procedure.
      123   end.
      124   on alt-f1 anywhere do:
      125     run proc-alt-f1 in this-procedure .
      126   end.
      127   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      128   define new shared variable PrintCopiesCounter as integer   no-undo initial 1 .
      129   define new shared variable RepPathName        as character no-undo .
      130   define new shared variable PrintRubl          as logical   no-undo .
      131   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      132   define variable v-waitfram-action01         as character   no-undo .
      133   define variable v-waitfram-action02         as character   no-undo .
      134   define variable v-waitfram-action03         as character   no-undo .
      135   define variable mWaitFramTextBeg            as character   no-undo.
      136   define variable mWaitFramTextEnd            as character   no-undo.
      137   define variable mWaitFramView               as logical     no-undo.
      138   define variable mWaitProcEvent              as logical     no-undo init yes.
      139   define variable mWaitFramInterval           as integer     no-undo init 1 .
      140   define variable mWaitFramStop               as logical     no-undo.
      141   define variable mWaitFramStopUser           as logical     no-undo.
      142   define variable mWaitFramStopTimeOut        as logical     no-undo.
      143   define variable mWaitFramStartProc          as datetime-tz no-undo.
      144   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      145   define button B-WaitFramStop auto-end-key
      146        label "Стоп"
      147        size 10 by 1 tooltip "Остоновить процесс".
      148   define button B-viewProcInfo
      149        label "Информация"
      150        size 15 by 1 tooltip "Информация о процесс".
      151   define frame waitfram
      152     v-waitfram-action01 format "x(72)" no-label skip
      153     v-waitfram-action02 format "x(72)" no-label skip
      154     v-waitfram-action03 format "x(72)" no-label skip
      155     B-viewProcInfo
      156     B-WaitFramStop at row 4 col 30
      157     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      158     .
      159   define new global shared variable mBatchMode as logical no-undo init ?.
      160   define variable mFramBachModHandle as handle no-undo.
      161   mFramBachModHandle = frame waitfram:handle.
      162   define variable mFameOldVis as logical no-undo.
      163   define variable mVisCUrentVin as logical no-undo.
      164   if session:batch-mode
      165   then
      166      mBatchMode = yes.
      167   if mBatchMode = ? then do:
      168     mVisCUrentVin = current-window:visible.
      169     mFameOldVis = mFramBachModHandle:visible.
      170     mFramBachModHandle:visible  = yes.
      171     mBatchMode = mFramBachModHandle:visible ne yes.
      172     mFramBachModHandle:visible = mFameOldVis.
      173     current-window:visible = mVisCUrentVin.
      174   end.
      175    if  log-manager:logfile-name ne ?
      176     then DO:
      177         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      178         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      179         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      180     end.
      181   on choose of B-WaitFramStop in frame waitfram
      182   do:
      183     mWaitFramStop = yes.
      184     mWaitFramStopUser = yes.
      185   end.
      186   function waitfram-check-timeout returns logical():
      187      define variable vtime as int64 no-undo.
      188      if mWaitFramStopTimeOut
      189      then
      190         return yes.
      191      vtime = ( now - mWaitFramStartProc ) / 1000 .
      192      if     mWaitFramTimeOut ne ?
      193         and mWaitFramTimeOut ne 0
      194         and mWaitFramTimeOut lt vtime
      195      then do:
      196         mWaitFramStopTimeOut = yes.
      197      end.
      198      return mWaitFramStopTimeOut.
      199   end.
      200   procedure waitfram-hide :
      201     if not session:batch-mode
      202     then do
      203     on error undo, return error return-value
      204     :
      205       pause 0 before-hide .
      206       if not mBatchMode then
      207         hide frame waitfram .
      208     if     not mWaitFramView
      209        and mWaitProcEvent
      210     then
      211       process events .
      212     end.
      213   end procedure.
      214   procedure waitfram-show :
      215     define input  parameter p-message as character no-undo .
      216     define variable v-left-margin as integer   no-undo .
      217     if not session:batch-mode
      218     then do
      219     on error undo, return error return-value
      220     :
      221       if length(p-message) <= 70 then do:
      222         assign
      223           v-left-margin = integer((70 - length(p-message)) / 2)
      224         .
      225         assign
      226           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      227         .
      228         assign
      229           v-waitfram-action01 = " "
      230           v-waitfram-action02 = " "
      231                                    + fill(" ", v-left-margin)
      232                                    + p-message
      233           v-waitfram-action03 = " "
      234         .
      235       end.
      236       else do:
      237         define variable vRindex1 as integer no-undo.
      238         define variable vRindex2 as integer no-undo.
      239         vRindex1 = r-index(p-message," ",70).
      240         if vRindex1 = 0
      241         then
      242            vRindex1 = 70.
      243         if length(p-message)  <= vRindex1 + 70 then do:
      244           assign
      245             v-waitfram-action01 = " "
      246             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      247             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      248           .
      249         end.
      250         else do:
      251           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      252           if vRindex2 <= vRindex1
      253           then
      254              vRindex2 = vRindex1 + 70.
      255           assign
      256             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      257             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      258             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      259           .
      260         end.
      261       end.
      262       B-viewProcInfo:visible   in frame waitfram = no.
      263       B-viewProcInfo:sensitive in frame waitfram = no.
      264       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      265       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      266       if  (   mWaitFramView
      267          or  mWaitProcEvent)
      268          and not mBatchMode
      269       then
      270          display
      271             v-waitfram-action01 skip
      272             v-waitfram-action02 skip
      273             v-waitfram-action03 skip
      274          with frame waitfram .
      275       if     mWaitFramView
      276          then do:
      277             if     mWaitFramInterval ne ?
      278                and not mBatchMode
      279             then
      280                wait-for go of frame waitfram pause mWaitFramInterval.
      281          end.
      282          else
      283             if     mWaitProcEvent
      284                and not mBatchMode
      285             then
      286                process events .
      287     end.
      288   end procedure.
      289      procedure waitfram-show-this:
      290         define input  parameter iInterval as int64 no-undo.
      291         define variable vtime as int64 no-undo.
      292         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      293         mWaitFramInterval = iInterval.
      294         run waitfram-show (substitute("&1&2 &3&4" ,
      295                                       mWaitFramTextBeg ,
      296                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      297                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      298                                       mWaitFramTextEnd
      299                                      )
      300                           ).
      301      end.
      302      procedure WaitFramRunPause:
      303         define input  parameter iInterval as dec no-undo.
      304         define variable vStart  as datetime-tz no-undo.
      305         define variable vend    as datetime-tz no-undo.
      306         define variable vint as int64 no-undo.
      307         define variable vOk as logical no-undo.
      308         vStart = now.
      309         vend   = vStart.
      310         publish "WaitFramPause" (iInterval,output vOk).
      311         vend   =  now.
      312         vint = vend - vStart.
      313         vint = iInterval - vint / 1000.
      314         if     not mWaitFramStop
      315            and (   vint > 0
      316                 or (    not vOk
      317                     and iInterval eq ?
      318                     )
      319                 )
      320         then
      321            run waitfram-show-this (iInterval).
      322         vend   =  now.
      323         vint = vend - vStart.
      324         vint = iInterval - vint / 1000.
      325         if     not mWaitFramStop
      326            and vint > 0
      327         then do:
      328            run gbl/pause.p (vint * 1000).
      329         end.
      330         if iInterval ne ?
      331         then
      332            publish "WaitFramStop".
      333         waitfram-check-timeout().
      334      end.
      335      procedure WaitFramWaitFor:
      336         define input  parameter iInterval as dec no-undo.
      337         assign
      338            mWaitFramStartProc   = now
      339            mWaitFramStopUser    = no
      340            mWaitFramStopTimeOut = no
      341         .
      342         block-wait:
      343         do while not mWaitFramStop:
      344            run WaitFramRunPause (iInterval).
      345            if  waitfram-check-timeout()
      346            then do:
      347               leave block-wait.
      348            end.
      349         end.
      350         run waitfram-hide.
      351      end.
      352   procedure waitfram-join :
      353     define input  parameter p-line-1  as character no-undo .
      354     define input  parameter p-line-2  as character no-undo .
      355     define input  parameter p-line-3  as character no-undo .
      356     define output parameter p-message as character no-undo .
      357     do
      358     on error undo, return error return-value
      359     :
      360       assign
      361         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      362                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      363                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      364       .
      365     end.
      366   end procedure.
      367   function waitfram-join-function returns character
      368     (input p-line-1 as character
      369     ,input p-line-2 as character
      370     ,input p-line-3 as character
      371     ).
      372     define variable v-message as character no-undo .
      373     run waitfram-join in this-procedure
      374       (input  p-line-1
      375       ,input  p-line-2
      376       ,input  p-line-3
      377       ,output v-message
      378       ) .
      379     return v-message .
      380   end function .
      381   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      382   define  stream PrnLibStream.
      383   procedure prn-lib-prn-file :
      384     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      385     define input parameter p-DIsabledoptions as integer no-undo .
      386     define variable v-report-name as character no-undo .
      387     define variable v-user-action as character no-undo .
      388     define variable v-printed     as logical   no-undo .
      389     define variable v-exist       as logical   no-undo .
      390     do
      391       on error undo, return error
      392       :
      393       run prn-lib-get-report-name  in this-procedure (
      394         input parParentProc
      395         ,output v-report-name
      396         ).
      397   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      398   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      399     (input  v-report-name
      400     ,input  2
      401     ,output v-exist
      402     )  .
      403       if NOT v-exist then
      404       DO:
      405         Message
      406           "Нет заданий на печать ! "
      407           view-as alert-box .
      408         Return  .
      409       End.
      410       run gbl/prnfilen.w
      411         (input  ""
      412         ,input  p-DisabledOptions
      413         ,input  string(v-report-name )
      414         ,input  7
      415         ,output v-user-action
      416         ,output v-printed
      417         ) .
      418       if v-printed then
      419       do:
      420         return "YES" .
      421       end.
      422       else
      423       do:
      424         return "NO" .
      425       end.
      426     end.
      427   end procedure.
      428   procedure prn-lib-open-stream :
      429     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      430     define input parameter p-page-size    as integer no-undo .
      431     define input parameter p-is-stream    as logical no-undo .
      432     define input parameter p-append       as logical no-undo .
      433     define variable v-report-name as character no-undo .
      434     do
      435       on error undo, return error
      436       :
      437       run prn-lib-get-report-name  in this-procedure (
      438         input parParentProc
      439         ,output v-report-name
      440         ).
      441       if p-is-stream then
      442       do:
      443         if p-append then
      444         do:
      445           output stream PrnLibStream to value( v-report-name )
      446             page-size value(p-page-size) append .
      447         end.
      448         if not p-append then
      449         do:
      450           output stream PrnLibStream to value( v-report-name )
      451             page-size value(p-page-size) .
      452         end.
      453       end.
      454       if not p-is-stream then
      455       do:
      456         if p-append then
      457         do:
      458           output to value( v-report-name )
      459             page-size value(p-page-size) append .
      460         end.
      461         if not p-append then
      462         do:
      463           output to value( v-report-name )
      464             page-size value(p-page-size) .
      465         end.
      466       end.
      467     end.
      468   end procedure.
      469   procedure prn-lib-open-exp :
      470     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      471     define input parameter p-is-stream    as logical no-undo .
      472     define input parameter p-is-append    as logical no-undo .
      473     define output parameter p-ReportFileName as char init "report" no-undo.
      474     define output parameter p-process as logical no-undo .
      475     define variable glog as logical no-undo .
      476     do
      477       on error undo, return error
      478       :
      479       SYSTEM-DIALOG GET-FILE p-ReportFileName
      480         TITLE      "Укажите путь"
      481         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      482         ASK-OVERWRITE
      483         CREATE-TEST-FILE
      484         SAVE-AS
      485         USE-FILENAME
      486         DEFAULT-EXTENSION "txt"
      487         UPDATE glog
      488         .
      489       if not glog then  return.
      490       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      491       if p-is-stream then
      492       do:
      493         if p-is-append then
      494         do:
      495           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      496         end.
      497         else
      498         do:
      499           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      500         end.
      501       end.
      502       else
      503       do:
      504         if p-is-append then
      505         do:
      506           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      507         end.
      508         else
      509         do:
      510           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      511         end.
      512       end.
      513       p-process = yes.
      514     end.
      515   end procedure.
      516   procedure prn-lib-get-report-name :
      517     define input parameter parParentProc  as widget-handle no-undo.
      518     define output parameter p-report-name as character no-undo .
      519     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      520   end procedure.
      521   procedure prn-lib-reportviewer-report-name :
      522     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      523     define input parameter p-report-name-html as character no-undo .
      524     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      525   end procedure.
      526   procedure prn-lib-reportviewer :
      527     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      528     define input parameter p-report-name-html as character no-undo .
      529     define input parameter p-param        as character no-undo .
      530     define variable v-excel           as character no-undo init 'TRUE' .
      531     define variable v-value-character as character no-undo .
      532     define variable v-value-integer   as character no-undo .
      533     define variable v-value-date      as date      no-undo .
      534     define variable v-value-decimal   as decimal   no-undo .
      535     define variable rep-excel         as logical   no-undo .
      536     define variable excel-string      as character no-undo .
      537     define variable v-param-type      as character no-undo .
      538     define variable v-tth             as handle    no-undo .
      539     run adm/shattri.p (
      540       input "get":U
      541       ,input  ""
      542       ,input  0
      543       ,input  'report-glob':U
      544       ,input  'rep-excel':U
      545       ,output v-value-character
      546       ,output v-value-date
      547       ,output v-value-decimal
      548       ,output v-value-integer
      549       ,output rep-excel
      550       ,output v-param-type
      551       ,INPUT-OUTPUT table-handle v-tth
      552       )  .
      553     if rep-excel then v-excel = "TRUE" .
      554     else v-excel = "FALSE" .
      555     if p-param eq ""
      556     then
      557        p-param = "EXCEL:" + v-excel.
      558     else
      559        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      560     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      561   end procedure.
      562   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      563   procedure cur-time :
      564      define output parameter p-today as date      no-undo .
      565      define output parameter p-time  as integer   no-undo .
      566     do
      567     on error undo, return error
      568     :
      569       define variable v-date1 as date      no-undo .
      570       define variable v-date2 as date      no-undo .
      571       define variable v-time  as integer   no-undo .
      572       assign
      573         v-date1 = today
      574         v-time  = time
      575         v-date2 = today
      576       .
      577       if v-date1 <> v-date2
      578       then do:
      579         assign
      580           v-date1 = today
      581           v-time  = v-time
      582         .
      583       end.
      584       assign
      585         p-today = v-date1
      586         p-time  = v-time
      587       .
      588     end.
      589   end.
      590   function cur-time-date returns character
      591   :
      592     return string(today, '99/99/9999':U) .
      593   end.
      594   function cur-time-mjd returns decimal
      595   :
      596     define variable v-date as date      no-undo .
      597     define variable v-time as integer   no-undo .
      598     run cur-time in this-procedure
      599       (output v-date
      600       ,output v-time
      601       ) .
      602     return integer(v-date) - 2400002 + (v-time / 86400) .
      603   end.
      604   function cur-time-get-ending-index returns integer
      605   (input p-number as integer
      606   )
      607   :
      608     if p-number < 0
      609     or p-number = ?
      610     then do:
      611       return 1 .
      612     end.
      613     define variable v-rest as integer   no-undo .
      614     assign
      615       p-number = p-number modulo 100
      616     .
      617     if p-number < 20
      618     then do:
      619       assign
      620         v-rest = p-number
      621       .
      622     end.
      623     else do:
      624       assign
      625         v-rest = p-number modulo 10
      626       .
      627     end.
      628     case v-rest :
      629       when 1
      630       then do:
      631         return 2 .
      632       end.
      633       when 2 or
      634       when 3 or
      635       when 4
      636       then do:
      637         return 3 .
      638       end.
      639       otherwise do:
      640         return 1 .
      641       end.
      642     end case .
      643   end.
      644   procedure cur-time-mjd-to-date :
      645      define input  parameter i-mjd-diff as decimal no-undo.
      646      define output parameter o-Date     as date    no-undo.
      647      define output parameter o-Time     as integer no-undo.
      648      define variable v-day-number as integer   no-undo .
      649      if    i-mjd-diff < 0
      650         or i-mjd-diff = ?
      651      then do:
      652         return "?" .
      653      end.
      654      assign
      655         v-day-number = truncate(i-mjd-diff,0).
      656         o-Date = date(v-day-number + 2400002).
      657         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      658     .
      659   end.
      660   function cur-time-mjd-to-string returns character
      661   (input p-mjd-diff as decimal
      662   )
      663   :
      664     define variable v-day-number as integer   no-undo .
      665     define variable v-seconds    as integer   no-undo .
      666     define variable v-hour       as integer   no-undo .
      667     define variable v-min        as integer   no-undo .
      668     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      669     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      670     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      671     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      672     if p-mjd-diff < 0
      673     or p-mjd-diff = ?
      674     then do:
      675       return "?" .
      676     end.
      677     assign
      678       v-day-number = integer(truncate(p-mjd-diff,0))
      679       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      680     .
      681     if v-seconds > 86400
      682     then do:
      683       assign
      684         v-seconds = 86400 - 1
      685       .
      686     end.
      687     if v-seconds < 0
      688     then do:
      689       assign
      690         v-seconds = 0
      691       .
      692     end.
      693     assign
      694       v-hour = truncate(v-seconds / 3600, 0)
      695     .
      696     assign
      697       v-seconds = v-seconds modulo 3600
      698     .
      699     assign
      700       v-min = truncate(v-seconds / 60, 0)
      701     .
      702     assign
      703       v-seconds = v-seconds modulo 60
      704     .
      705     return
      706         (if v-day-number <> 0
      707           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      708           else ""
      709         )
      710       + (if v-day-number <> 0 or v-hour <> 0
      711           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      712           else ""
      713         )
      714       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      715           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      716           else ""
      717         )
      718       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      719       .
      720   end.
      721   function cur-time-string returns character
      722   :
      723     define variable v-date as date      no-undo .
      724     define variable v-time as integer   no-undo .
      725     run cur-time in this-procedure
      726       (output v-date
      727       ,output v-time
      728       ) .
      729     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      730   end.
      731   function cur-time-string-sec returns character
      732   :
      733     define variable v-date as date      no-undo .
      734     define variable v-time as integer   no-undo .
      735     run cur-time in this-procedure
      736       (output v-date
      737       ,output v-time
      738       ) .
      739     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      740   end.
      741   function cur-time-custom  returns character
      742   (input p-prefix as character
      743   ,input p-date-format as character
      744   ,input p-delimiter as character
      745   ,input p-time-format as character
      746   ,input p-suffix as character
      747   )
      748   :
      749     define variable v-date as date      no-undo .
      750     define variable v-time as integer   no-undo .
      751     run cur-time in this-procedure
      752       (output v-date
      753       ,output v-time
      754       ) .
      755     return
      756       p-prefix
      757       + string(v-date, p-date-format)
      758       + p-delimiter
      759       + string(v-time, p-time-format)
      760       + p-suffix
      761       .
      762   end.
      763   function cur-time-print  returns character
      764   :
      765     define variable v-date as date      no-undo .
      766     define variable v-time as integer   no-undo .
      767     run cur-time in this-procedure
      768       (output v-date
      769       ,output v-time
      770       ) .
      771     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      772   end.
      773   function cur-time-datetime returns datetime
      774   :
      775     define variable v-char as character no-undo .
      776     define variable v-datetime as datetime no-undo .
      777     v-char = cur-time-string().
      778     v-datetime = datetime(v-char).
      779     return  v-datetime.
      780   end.
      781   function cur-time-string-msec returns character
      782   :
      783     define variable v-date as datetime  no-undo .
      784     v-date = now.
      785     return string(v-date) .
      786   end.
      787   define new global shared variable g#lib-trn  as handle no-undo .
      788   define new global shared variable g#lib-trn2 as handle no-undo .
      789   define new global shared variable g#lib-trn3 as handle no-undo .
      790   define new global shared variable g#lib-trn4 as handle no-undo .
      791   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      792     define variable v-cntxt-db-num        as integer   no-undo .
      793     define variable v-cntxt-userid        as character no-undo .
      794     define variable v-cntxt-level         as character no-undo .
      795     define variable v-cntxt-host-code-obj as integer   no-undo .
      796     define variable v-cntxt-obj-type      as character no-undo .
      797     define variable v-cntxt-obj-code      as integer   no-undo .
      798     define variable v-cntxt-db-num-obj    as integer   no-undo .
      799     define variable v-cntxt-is-admin      as logical   no-undo .
      800   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      801     run mainmenu_getcntxt in parparentproc
      802       (output v-cntxt-db-num
      803       ,output v-cntxt-userid
      804       ,output v-cntxt-level
      805       ,output v-cntxt-host-code-obj
      806       ,output v-cntxt-obj-type
      807       ,output v-cntxt-obj-code
      808       ,output v-cntxt-db-num-obj
      809       ,output v-cntxt-is-admin
      810       ) .
      811   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      812   def var vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      813   procedure gen-key-rec :
      814     define input  parameter p-tbl-name    as character no-undo.
      815     define input  parameter p-bh_tbl-name as handle    no-undo.
      816     define output parameter p-key-rec     as character no-undo.
      817     do
      818     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      819     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      820     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      821     :
      822       define variable fh               as handle    no-undo .
      823       define variable v-ok             as logical   no-undo .
      824       define variable v-inform         as character no-undo .
      825       define variable v-ind            as integer   no-undo .
      826       define variable v-idx-field-qnty as integer   no-undo .
      827       if p-tbl-name = ?
      828         or p-tbl-name = "":U
      829       then do:
      830         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info8 ).
      831       end.
      832       if not p-bh_tbl-name:available then do:
      833         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info8, p-tbl-name ).
      834       end.
      835       assign
      836         p-key-rec = p-tbl-name
      837         v-inform  = p-bh_tbl-name:index-information(1)
      838         v-ind     = 2
      839       .
      840       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      841       on error undo, return error
      842       :
      843         assign
      844           v-inform = p-bh_tbl-name:index-information( v-ind )
      845           v-ind    = v-ind + 1
      846         .
      847       end.
      848       if v-inform = ?
      849         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      850         or entry( 3, v-inform, ",":U ) <> "1":U
      851       then do:
      852         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info8, p-tbl-name ).
      853       end.
      854       else do:
      855         assign
      856           v-idx-field-qnty = num-entries( v-inform ) - 4
      857         .
      858         if v-idx-field-qnty < 2 then do:
      859           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info8, v-inform, p-tbl-name ).
      860         end.
      861         do v-ind = 1 to v-idx-field-qnty by 2
      862         on error undo, return error
      863         :
      864           assign
      865             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      866             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      867           .
      868         end.
      869       end.
      870       if p-key-rec = ? then do:
      871         assign
      872           p-key-rec = "":U
      873         .
      874         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info8, p-tbl-name ).
      875       end.
      876     end.
      877     return.
      878   end procedure.
      879   procedure gen-where-keyr-tab :
      880     define input  parameter i-tableSerach as character no-undo.
      881     define input  parameter i-tablekey   as character  no-undo.
      882     define input  parameter p-key-rec    as character  no-undo.
      883     define input  parameter p-key-handle as handle     no-undo .
      884     define input  parameter p-db-name    as character  no-undo .
      885     define input  parameter p-tt-handle  as handle     no-undo .
      886     define output parameter o-Where      as character  no-undo.
      887     do
      888     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      889     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      890     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      891     :
      892       define variable v-full-tbl-name  as character no-undo .
      893       define variable bh_tbl-name      as handle    no-undo .
      894       define variable fh_key           as handle    no-undo .
      895       define variable fh_search        as handle    no-undo .
      896       define variable v-field-num      as integer   no-undo .
      897       define variable v-count-fld      as integer   no-undo .
      898       define variable v-inform         as character no-undo .
      899       define variable v-ind            as integer   no-undo .
      900       define variable v-idx-field-qnty as integer   no-undo .
      901       define variable v-field-name     as character no-undo .
      902       define variable v-field-val      as character no-undo .
      903       define variable v-word-link      as character no-undo .
      904       define variable vTable           as character no-undo.
      905       define variable bh_tbl-key       as handle    no-undo .
      906       assign
      907         p-key-rec = trim( p-key-rec )
      908       .
      909       if p-key-handle <> ? then do:
      910         if not valid-handle(p-key-handle)
      911            or p-key-handle:type <> "buffer"
      912         then do:
      913           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info8 ).
      914         end.
      915         if num-entries( p-key-rec, chr(3) ) > 1
      916           or p-key-rec = ?
      917           or p-key-rec = "":U
      918         then do:
      919           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info8, p-key-rec ).
      920         end.
      921       end.
      922       else do:
      923         if p-key-rec = ?
      924           or p-key-rec = "":U
      925         then do:
      926           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info8 ).
      927         end.
      928       end.
      929       assign
      930         vTable = entry( 1 , p-key-rec, chr(3) )
      931       .
      932       if p-tt-handle <> ?
      933         and ( not valid-handle(p-tt-handle)
      934               or p-tt-handle:type <> "buffer"
      935             )
      936       then do:
      937         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info8, vTable, chr(10) ).
      938       end.
      939       if p-tt-handle = ? then do:
      940         assign
      941           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      942         .
      943         create buffer bh_tbl-name for table v-full-tbl-name .
      944       end.
      945       else do:
      946         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      947       end.
      948       assign
      949         v-inform = bh_tbl-name:index-information(1)
      950         v-ind    = 2
      951       .
      952       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      953       on error undo, return error
      954       :
      955         assign
      956           v-inform = bh_tbl-name:index-information( v-ind )
      957           v-ind    = v-ind + 1
      958         .
      959       end.
      960       if v-inform = ?
      961         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      962         or entry( 3, v-inform, ",":U ) <> "1":U
      963       then do:
      964         delete object bh_tbl-name no-error.
      965         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info8, vTable ).
      966       end.
      967       assign
      968         v-idx-field-qnty = num-entries( v-inform ) - 4
      969       .
      970       if v-idx-field-qnty < 2 then do:
      971         delete object bh_tbl-name no-error.
      972         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info8, v-inform, vTable ).
      973       end.
      974       assign
      975         o-where     = "where":U
      976         v-word-link = "":U
      977         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      978         v-count-fld = 0
      979       .
      980       if i-tablekey ne "" and i-tablekey ne ?
      981       then do:
      982         assign
      983           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      984         .
      985         create buffer bh_tbl-key for table v-full-tbl-name .
      986       end.
      987       if i-tableSerach ne "" and i-tableSerach ne ?
      988       then do:
      989         delete object bh_tbl-name no-error.
      990         assign
      991           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      992         .
      993         create buffer bh_tbl-name for table v-full-tbl-name .
      994       end.
      995       block_where:
      996       do v-ind = 1 to v-idx-field-qnty by 2
      997       on error undo, return error
      998       :
      999         assign
     1000           v-count-fld = v-count-fld + 1
     1001         .
     1002         if p-key-handle = ?
     1003           and v-count-fld > v-field-num
     1004         then do:
     1005           leave block_where.
     1006         end.
     1007         define variable VfieldKeyTable as handle no-undo.
     1008         assign
     1009           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     1010           fh_search    = bh_tbl-name:buffer-field( v-field-name )
     1011         .
     1012         if     bh_tbl-key ne ?
     1013         then do:
     1014            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
     1015            if VfieldKeyTable eq ?
     1016            then next block_where.
     1017         end.
     1018         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
     1019         then
     1020            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
     1021         else
     1022            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
     1023         if p-key-handle = ? then do:
     1024           assign
     1025             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
     1026           .
     1027         end.
     1028         else do:
     1029           assign
     1030             fh_key = p-key-handle:buffer-field( v-field-name )
     1031           .
     1032           if fh_key = ?
     1033             or not valid-handle( fh_key )
     1034           then do:
     1035             delete object bh_tbl-name.
     1036             if     bh_tbl-key ne ?
     1037             then
     1038                delete object bh_tbl-key.
     1039             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info8, p-key-handle:name, v-field-name ).
     1040           end.
     1041           assign
     1042             v-field-val = fh_key:buffer-value
     1043           .
     1044         end.
     1045         if fh_search:data-type ="character":U then do:
     1046           assign
     1047             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
     1048             v-field-val = replace( v-field-val, '"':U, '~~"':U )
     1049             v-field-val = replace( v-field-val, "'":U, "~~'":U )
     1050             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
     1051             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
     1052             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
     1053             v-field-val = replace( v-field-val, chr(10), '~~n':U )
     1054             v-field-val = replace( v-field-val, chr(9), '~~t':U )
     1055             v-field-val = replace( v-field-val, chr(13), '~~r':U )
     1056             v-field-val = replace( v-field-val, chr(27), '~~E':U )
     1057             v-field-val = replace( v-field-val, chr(8), '~~b':U )
     1058             v-field-val = replace( v-field-val, chr(12), '~~f':U )
     1059             v-field-val = substitute( '"&1"', v-field-val )
     1060           .
     1061         end.
     1062         assign
     1063           o-where = substitute( "&1 &2", o-where, v-field-val )
     1064         .
     1065         if v-word-link = "":U then do:
     1066           assign
     1067             v-word-link = "and":U
     1068           .
     1069         end.
     1070       end.
     1071       delete object bh_tbl-name.
     1072       if     bh_tbl-key ne ?
     1073       then
     1074          delete object bh_tbl-key.
     1075       if p-key-handle = ?
     1076         and v-count-fld <> v-field-num
     1077       then do:
     1078         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info8, vTable ).
     1079       end.
     1080     end.
     1081   end procedure.
     1082   procedure gen-hn-keyr-tab :
     1083     define input  parameter i-tableSerach as character no-undo.
     1084     define input  parameter i-tablekey   as character no-undo.
     1085     define input  parameter p-key-rec    as character no-undo.
     1086     define input  parameter p-key-handle as handle    no-undo .
     1087     define input  parameter p-db-name    as character no-undo .
     1088     define input  parameter p-tt-handle  as handle    no-undo .
     1089     define input  parameter p-stts-lock  as integer   no-undo .
     1090     define output parameter o-hn         as handle    no-undo.
     1091     define variable v-full-tbl-name as character no-undo.
     1092     define variable v-where         as character no-undo.
     1093     define variable bh_tbl-name     as handle    no-undo.
     1094     define variable vTable          as character no-undo.
     1095     do
     1096     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1097     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     1098     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
     1099         run gen-where-keyr-tab(i-tableSerach,
     1100                                i-tablekey,
     1101                                p-key-rec,
     1102                                p-key-handle,
     1103                                p-db-name,
     1104                                p-tt-handle,
     1105                                output v-where).
     1106         if i-tableSerach ne "" and i-tableSerach ne ?
     1107         then do:
     1108            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
     1109            create buffer bh_tbl-name for table v-full-tbl-name .
     1110         end.
     1111         else do:
     1112            if p-tt-handle = ? then do:
     1113               assign
     1114                  vTable = entry( 1 , p-key-rec, chr(3) )
     1115               .
     1116               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
     1117               create buffer bh_tbl-name for table v-full-tbl-name .
     1118            end.
     1119            else do:
     1120               create buffer bh_tbl-name for table p-tt-handle:table-handle .
     1121            end.
     1122         end.
     1123         if p-tt-handle = ? then do:
     1124            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
     1125         end.
     1126         else do:
     1127            bh_tbl-name:find-first( v-where ) no-error .
     1128         end.
     1129         o-hn = bh_tbl-name.
     1130      end.
     1131   end procedure.
     1132   procedure gen-hn-keyr :
     1133     define input  parameter p-key-rec    as character no-undo.
     1134     define input  parameter p-key-handle as handle    no-undo .
     1135     define input  parameter p-db-name    as character no-undo .
     1136     define input  parameter p-tt-handle  as handle    no-undo .
     1137     define input  parameter p-stts-lock  as integer   no-undo .
     1138     define output parameter o-hn         as handle    no-undo.
     1139     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
     1140   end.
     1141   procedure gen-row-keyr :
     1142     define input  parameter p-key-rec    as character no-undo.
     1143     define input  parameter p-key-handle as handle    no-undo .
     1144     define input  parameter p-db-name    as character no-undo .
     1145     define input  parameter p-tt-handle  as handle    no-undo .
     1146     define input  parameter p-stts-lock  as integer   no-undo .
     1147     define output parameter p-tbl-row    as rowid     no-undo.
     1148     define output parameter p-tbl-name   as character no-undo.
     1149     define variable vHn as handle no-undo.
     1150       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
     1151       p-tbl-row = if vHn:available then vHn:rowid else ?.
     1152       p-tbl-name =  vHn:table.
     1153       delete object vHn no-error.
     1154     if p-tbl-row = ? then do:
     1155       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info8, p-tbl-name, p-key-rec ).
     1156     end.
     1157     else do:
     1158       return.
     1159     end.
     1160   end procedure.
     1161   procedure gen-key-fv :
     1162     define input  parameter p-key-rec    as character no-undo .
     1163     define output parameter p-field-list as character no-undo .
     1164     define output parameter p-value-list as character no-undo.
     1165     do
     1166     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1167     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1168     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1169     :
     1170       define variable v-full-tbl-name  as character no-undo .
     1171       define variable bh_tbl-name      as handle    no-undo .
     1172       define variable v-tbl-name       as character no-undo .
     1173       define variable v-field-num      as integer   no-undo .
     1174       define variable v-count-fld      as integer   no-undo .
     1175       define variable v-inform         as character no-undo .
     1176       define variable v-ind            as integer   no-undo .
     1177       define variable v-idx-field-qnty as integer   no-undo .
     1178       define variable v-delim-key      as character no-undo .
     1179       if p-key-rec = ?
     1180         or p-key-rec = "":U
     1181       then do:
     1182         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info8 ).
     1183       end.
     1184       assign
     1185         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
     1186         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1187       .
     1188       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1189       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info8 ).
     1190       assign
     1191         v-inform = bh_tbl-name:index-information(1)
     1192         v-ind    = 2
     1193       .
     1194       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1195       on error undo, return error
     1196       :
     1197         assign
     1198           v-inform = bh_tbl-name:index-information( v-ind )
     1199           v-ind    = v-ind + 1
     1200         .
     1201       end.
     1202       if v-inform = ?
     1203         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1204         or entry( 3, v-inform, ",":U ) <> "1":U
     1205       then do:
     1206         delete object bh_tbl-name no-error.
     1207         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info8, v-tbl-name ).
     1208       end.
     1209       assign
     1210         v-idx-field-qnty = num-entries( v-inform ) - 4
     1211       .
     1212       if v-idx-field-qnty < 2 then do:
     1213         delete object bh_tbl-name no-error.
     1214         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info8, v-inform, v-tbl-name ).
     1215       end.
     1216       assign
     1217         p-field-list = "":U
     1218         p-value-list = "":U
     1219         v-delim-key  = "":U
     1220         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
     1221         v-count-fld  = 0
     1222       .
     1223       block_where:
     1224       do v-ind = 1 to v-idx-field-qnty by 2
     1225       on error undo, return error
     1226       :
     1227         assign
     1228           v-count-fld = v-count-fld + 1
     1229         .
     1230         if v-count-fld > v-field-num then do:
     1231           leave block_where.
     1232         end.
     1233         assign
     1234           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
     1235           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
     1236         .
     1237         if v-ind = 1 then do:
     1238           assign
     1239             v-delim-key = chr(3)
     1240           .
     1241         end.
     1242       end.
     1243       delete object bh_tbl-name.
     1244       if v-count-fld <> v-field-num then do:
     1245         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info8, v-tbl-name ).
     1246       end.
     1247     end.
     1248   end procedure.
     1249   procedure gen-key-field :
     1250     define input  parameter p-table      as character no-undo .
     1251     define output parameter p-field-list as character no-undo .
     1252     do
     1253     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1254     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1255     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1256     :
     1257       define variable v-full-tbl-name  as character no-undo .
     1258       define variable bh_tbl-name      as handle    no-undo .
     1259       define variable v-tbl-name       as character no-undo .
     1260       define variable v-field-num      as integer   no-undo .
     1261       define variable v-count-fld      as integer   no-undo .
     1262       define variable v-inform         as character no-undo .
     1263       define variable v-ind            as integer   no-undo .
     1264       define variable v-idx-field-qnty as integer   no-undo .
     1265       define variable v-delim-key      as character no-undo .
     1266       if p-table = ?
     1267         or p-table = "":U
     1268       then do:
     1269         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info8 ).
     1270       end.
     1271       assign
     1272         v-tbl-name      = p-table
     1273         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1274       .
     1275       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1276       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info8 ).
     1277       assign
     1278         v-inform = bh_tbl-name:index-information(1)
     1279         v-ind    = 2
     1280       .
     1281       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1282       on error undo, return error
     1283       :
     1284         assign
     1285           v-inform = bh_tbl-name:index-information( v-ind )
     1286           v-ind    = v-ind + 1
     1287         .
     1288       end.
     1289       if v-inform = ?
     1290         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1291         or entry( 3, v-inform, ",":U ) <> "1":U
     1292       then do:
     1293         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info8, v-tbl-name ).
     1294       end.
     1295       assign
     1296         v-idx-field-qnty = num-entries( v-inform ) - 4
     1297       .
     1298       if v-idx-field-qnty < 2 then do:
     1299         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info8, v-inform, v-tbl-name ).
     1300       end.
     1301       assign
     1302         p-field-list = "":U
     1303         v-delim-key  = "":U
     1304         v-count-fld  = 0
     1305       .
     1306       block_where:
     1307       do v-ind = 1 to v-idx-field-qnty by 2
     1308       on error undo, return error
     1309       :
     1310         assign
     1311           v-count-fld = v-count-fld + 1
     1312         .
     1313         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
     1314         if v-ind = 1 then do:
     1315           assign
     1316             v-delim-key = chr(3)
     1317           .
     1318         end.
     1319       end.
     1320       delete object bh_tbl-name.
     1321     end.
     1322   end procedure.
     1323   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1324   define variable v-fltopend-rowid as rowid extent 18 no-undo .
     1325   procedure fltopend_fltopend :
     1326   define input parameter p-parent-handle as handle no-undo .
     1327   define input parameter p-qh as handle no-undo .
     1328   define input parameter p-flt-open-open-query  as character no-undo .
     1329   define input parameter p-where-cond as character no-undo .
     1330   define input parameter p-use-indFIRST-query-tail as character no-undo .
     1331   define input parameter p-use-ind-sort-clmn-by as character no-undo .
     1332   define input parameter p-indexed-reposition as character no-undo .
     1333     do
     1334     on error undo, return error
     1335     :
     1336   define variable v-prepare-string as character no-undo .
     1337   define variable glog as logical no-undo .
     1338   assign
     1339   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     1340                      p-where-cond + chr(32)  +
     1341                      p-use-indFIRST-query-tail + chr(32) +
     1342                      p-use-ind-sort-clmn-by + chr(32) +
     1343                      p-indexed-reposition
     1344   .
     1345   assign
     1346   glog = p-qh:query-prepare(v-prepare-string) no-error .
     1347   if not glog
     1348   or error-status:error then do:
     1349     message error-status:get-message(1) view-as alert-box .
     1350     undo, return error .
     1351   end.
     1352   assign
     1353   glog = p-qh:query-open no-error .
     1354   if not glog
     1355   or error-status:error then do:
     1356     message error-status:get-message(1) view-as alert-box .
     1357     undo, return error .
     1358   end.
     1359     end.
     1360   end procedure.
     1361   procedure fltopend_fltfindd :
     1362   define input parameter p-parent-handle as handle no-undo .
     1363   define input parameter p-qh as handle no-undo .
     1364   define input parameter p-rowid as rowid no-undo .
     1365   define input parameter p-next as logical no-undo .
     1366   define input parameter p-lock as integer no-undo .
     1367   define input parameter p-bh as handle no-undo .
     1368   define input parameter p-where-cond as character no-undo .
     1369   define input parameter p-use-index-phrase as character no-undo .
     1370   define variable glog as logical no-undo .
     1371   define variable v-qh as handle no-undo .
     1372   define variable v-bh as handle no-undo .
     1373   define variable v-recid as recid no-undo .
     1374   define variable v-prepare-string as character no-undo .
     1375   do
     1376   on error undo, return error
     1377   on stop undo, return error
     1378   :
     1379     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
     1380     create buffer v-bh for table p-bh buffer-name p-bh:name.
     1381     create query v-qh.
     1382     v-qh:set-buffers(v-bh).
     1383     v-prepare-string = substitute("for each &1 &2 &3"
     1384                                     ,v-bh:name
     1385                                     ,p-where-cond
     1386                                     ,p-use-index-phrase).
     1387     glog = v-qh:query-prepare(v-prepare-string) no-error.
     1388     if not glog then do:
     1389       delete object v-qh.
     1390       delete object v-bh.
     1391       undo, return error .
     1392     end.
     1393     glog = v-qh:query-open no-error .
     1394     if not glog then do:
     1395       delete object v-qh.
     1396       delete object v-bh.
     1397       undo, return error .
     1398     end.
     1399     if p-next then do:
     1400       v-qh:reposition-to-rowid(p-rowid) no-error .
     1401       glog = v-qh:get-next( p-lock) no-error .
     1402       glog = v-qh:get-next( p-lock) no-error .
     1403       if not glog or v-qh:query-off-end = yes then do:
     1404         glog = v-qh:get-first( p-lock) no-error .
     1405       end.
     1406     end.
     1407     else do:
     1408       glog = v-qh:get-first( p-lock) no-error .
     1409     end.
     1410     v-recid = v-bh:recid no-error .
     1411     delete object v-qh.
     1412     delete object v-bh.
     1413     return string(v-recid) .
     1414   end.
     1415   end procedure.
     1416   procedure fltopend_fltfindq :
     1417   define input parameter p-parent-handle as handle no-undo .
     1418   define input parameter p-qh as handle no-undo .
     1419   define input parameter p-next as logical no-undo .
     1420   define input parameter p-lock as integer no-undo .
     1421   define input parameter p-flt-open-open-query  as character no-undo .
     1422   define input parameter p-where-cond as character no-undo .
     1423   define input parameter p-use-indFIRST-query-tail as character no-undo .
     1424   define input parameter p-use-ind-sort-clmn-by as character no-undo .
     1425   define input parameter p-indexed-reposition as character no-undo .
     1426   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
     1427   define variable glog as logical no-undo .
     1428   define variable v-qh as handle no-undo .
     1429   define variable v-bh as handle no-undo extent 18.
     1430   define variable v-rowid as rowid no-undo extent 18.
     1431   define variable v-ii as integer no-undo .
     1432   define variable v-prepare-string as character no-undo .
     1433   do
     1434   on error undo, return error
     1435   on stop undo, return error
     1436   :
     1437     create query v-qh.
     1438     do v-ii = 1 to p-qh:num-buffers:
     1439       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
     1440       assign
     1441       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
     1442       no-error.
     1443       v-qh:add-buffer(v-bh[v-ii]).
     1444     end.
     1445     assign
     1446     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     1447                       p-where-cond + chr(32)  +
     1448                       p-use-indFIRST-query-tail + chr(32) +
     1449                       p-use-ind-sort-clmn-by + chr(32) +
     1450                       p-indexed-reposition
     1451     .
     1452     glog = v-qh:query-prepare( v-prepare-string) no-error .
     1453     if not glog then do:
     1454       delete object v-qh.
     1455       do v-ii = 1 to p-qh:num-buffers:
     1456         delete object v-bh[v-ii].
     1457       end.
     1458       undo, return error .
     1459     end.
     1460     glog = v-qh:query-open no-error .
     1461     if not glog then do:
     1462       delete object v-qh.
     1463       do v-ii = 1 to p-qh:num-buffers:
     1464         delete object v-bh[v-ii].
     1465       end.
     1466       undo, return error .
     1467     end.
     1468     if p-next then do:
     1469       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
     1470       glog = v-qh:get-next( p-lock) no-error .
     1471       glog = v-qh:get-next( p-lock) no-error .
     1472       if not glog or v-qh:query-off-end = yes then do:
     1473         glog = v-qh:get-first( p-lock) no-error .
     1474       end.
     1475     end.
     1476     else do:
     1477       glog = v-qh:get-first( p-lock) no-error .
     1478     end.
     1479     do v-ii = 1 to p-qh:num-buffers:
     1480       assign
     1481       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
     1482       no-error.
     1483     end.
     1484     delete object v-qh.
     1485     do v-ii = 1 to p-qh:num-buffers:
     1486       delete object v-bh[v-ii].
     1487     end.
     1488   end.
     1489   end procedure.
     1490   define variable p-sts   as integer   no-undo .
     1491   define variable v-log as logical   no-undo .
     1492   define variable v-key-rec as character no-undo .
     1493   define variable mark-str  as character no-undo.
     1494   define variable v-doc-rec as recid no-undo.
     1495   define variable filter-point as character no-undo init "Типы топлива для внешней системы EASYFUEL" .
     1496   define variable filter-point0 as character no-undo init "Типы топлива для внешней системы EASYFUEL" .
     1497   define variable sort-column-name as character no-undo .
     1498   define variable v-db-num LIKE ub.db.db-num no-undo.
     1499   define variable v-type as character no-undo .
     1500   define variable p-mark as character no-undo .
     1501   define variable gds-rec as recid no-undo .
     1502   define variable varschartic like ub.price-list.artic initial " " no-undo.
     1503   define variable v-rid-list    as character no-undo.
     1504   FUNCTION mark-string RETURNS CHARACTER
     1505   ( BUFFER loc-table FOR ub.ext-classif, input mark-list as CHARACTER )  FORWARD.
     1506   DEFINE BUTTON B-add
     1507        LABEL "&Добавить"
     1508        SIZE 10 BY 1.
     1509   DEFINE BUTTON B-del
     1510        LABEL "&Удалить"
     1511        SIZE 10 BY 1.
     1512   DEFINE BUTTON B-Help
     1513        LABEL "Помо&щь"
     1514        SIZE 3 BY 1
     1515        BGCOLOR 8 .
     1516   DEFINE BUTTON B-lookup  NO-CONVERT-3D-COLORS
     1517        LABEL ""
     1518        SIZE 10 BY 1.
     1519   DEFINE BUTTON B-mark
     1520        LABEL "&*"
     1521        SIZE 3 BY 1.
     1522   DEFINE BUTTON B-print
     1523        LABEL "Пе&чать"
     1524        SIZE 3 BY 1.
     1525   DEFINE BUTTON b-quit AUTO-END-KEY
     1526        LABEL "&Выход"
     1527        SIZE 10 BY 1
     1528        BGCOLOR 8 .
     1529   DEFINE BUTTON B-sel AUTO-GO
     1530        LABEL "Вы&бор"
     1531        SIZE 10 BY 1.
     1532   DEFINE VARIABLE FILL-IN-7 AS CHARACTER FORMAT "X(256)":U INITIAL "Поиск:"
     1533         VIEW-AS TEXT
     1534        SIZE 6 BY 1
     1535        FGCOLOR 4  NO-UNDO.
     1536   DEFINE VARIABLE mark-num AS CHARACTER FORMAT "X(256)":U
     1537         VIEW-AS TEXT
     1538        SIZE 2.5 BY 1
     1539        FGCOLOR 4  NO-UNDO.
     1540   DEFINE VARIABLE sch-artic AS CHARACTER FORMAT "X(256)":U
     1541        VIEW-AS FILL-IN
     1542        SIZE 14 BY 1 TOOLTIP "Поиск по артиклу" NO-UNDO.
     1543   DEFINE VARIABLE sch-code AS INTEGER FORMAT ">>>>>>>>>>>>9":U INITIAL 0
     1544        VIEW-AS FILL-IN
     1545        SIZE 10.5 BY 1 TOOLTIP "Поиск по коду" NO-UNDO.
     1546   DEFINE VARIABLE sch-name AS CHARACTER FORMAT "X(256)":U
     1547        VIEW-AS FILL-IN
     1548        SIZE 37.5 BY 1 TOOLTIP "Поиск по началу Наименования" NO-UNDO.
     1549   DEFINE VARIABLE a-n-c AS INTEGER INITIAL 1
     1550        VIEW-AS RADIO-SET HORIZONTAL
     1551        RADIO-BUTTONS
     1552             "А", 1,
     1553   "Н", 2,
     1554   "К", 3
     1555        SIZE 12 BY 1 TOOLTIP "Поиск товара по Артиклу, Названию , Коду" NO-UNDO.
     1556   DEFINE QUERY BROWSE-ext-goods FOR
     1557         Buf_ext-classif,
     1558         Buf_goods SCROLLING.
     1559   DEFINE BROWSE BROWSE-ext-goods
     1560     QUERY BROWSE-ext-goods NO-LOCK DISPLAY
     1561         mark-string(buffer buf_ext-classif , p-rid-list) @ p-mark COLUMN-LABEL "*" FORMAT "x(1)":U
     1562         Buf_goods.artic FORMAT "X(16)":U
     1563         Buf_goods.gds-code FORMAT ">>>>>>>>>9":U COLUMN-LABEL "Код"
     1564         Buf_goods.gds-name FORMAT "X(40)":U
     1565         Buf_ext-classif.Key#_One COLUMN-LABEL "Код EASYFUEL" FORMAT ">>>>>>>>9":U
     1566       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 17.5 FIT-LAST-COLUMN.
     1567   DEFINE FRAME Dialog-Frame
     1568        b-quit AT ROW 1 COL 1
     1569        B-mark AT ROW 1 COL 11
     1570        B-sel AT ROW 1 COL 17.3
     1571        B-add AT ROW 1 COL 27.3
     1572        B-del AT ROW 1 COL 37.4
     1573        B-lookup AT ROW 1 COL 47.5 WIDGET-ID 2
     1574        B-print AT ROW 1 COL 92
     1575        B-Help AT ROW 1 COL 95
     1576        a-n-c AT ROW 3 COL 9.5 NO-LABEL
     1577        sch-artic AT ROW 3 COL 20.5 COLON-ALIGNED NO-LABEL
     1578        sch-code AT ROW 3 COL 20.5 COLON-ALIGNED NO-LABEL
     1579        sch-name AT ROW 3 COL 20.5 COLON-ALIGNED NO-LABEL
     1580        BROWSE-ext-goods AT ROW 4 COL 1
     1581        mark-num AT ROW 1 COL 12 COLON-ALIGNED NO-LABEL
     1582        FILL-IN-7 AT ROW 2.97 COL 2.5 NO-LABEL
     1583        SPACE(90.59) SKIP(17.82)
     1584       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1585            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1586            TITLE "Типы топлива для EasyFuel".
     1587   ASSIGN
     1588          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1589          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1590   ASSIGN
     1591          B-lookup:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     1592   ASSIGN
     1593          BROWSE-ext-goods:NUM-LOCKED-COLUMNS IN FRAME Dialog-Frame     = 1.
     1594   ASSIGN
     1595          sch-code:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     1596   ASSIGN
     1597          sch-name:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     1598   ON GO OF FRAME Dialog-Frame
     1599   DO:
     1600     p-rid-list = v-rid-list.
     1601   END.
     1602   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1603   OR ENDKEY OF FRAME Dialog-Frame DO:
     1604       run gbl/markqwa.p
     1605          ( input b-mark:sensitive
     1606          , input p-rid-list ) no-error.
     1607       if error-status:error then return no-apply.
     1608       APPLY "END-ERROR":U TO SELF.
     1609   END.
     1610   ON VALUE-CHANGED OF a-n-c IN FRAME Dialog-Frame
     1611   DO:
     1612     ASSIGN a-n-c .
     1613     case a-n-c  :
     1614     when 1 then do:
     1615       enable sch-artic with frame Dialog-Frame .
     1616       hide sch-name sch-code in frame Dialog-Frame .
     1617     end.
     1618     when 2 then do:
     1619       enable sch-name with frame Dialog-Frame .
     1620       hide sch-artic sch-code in frame Dialog-Frame .
     1621     end.
     1622     when 3  then do:
     1623       enable sch-code with frame Dialog-Frame .
     1624       hide sch-name sch-artic in frame Dialog-Frame .
     1625     end.
     1626     end case.
     1627   END.
     1628   ON CHOOSE OF B-add IN FRAME Dialog-Frame
     1629   DO:
     1630     define variable loc#log as logical no-undo.
     1631     define variable loc-doc-rec as recid no-undo .
     1632     run proc-add (output loc-doc-rec) .
     1633     if loc-doc-rec <> ? THEN DO:
     1634         run openbr in this-procedure .
     1635     END.
     1636     apply "value-changed" to BROWSE-ext-goods in frame Dialog-Frame.
     1637   END.
     1638   ON CHOOSE OF B-del IN FRAME Dialog-Frame
     1639   DO:
     1640   define variable is-many as logical   no-undo .
     1641   is-many = false .
     1642   if num-entries(p-rid-list) > 0 then do:
     1643      message "Удалять выделенные записи ?"
     1644      view-as alert-box question
     1645      Buttons yes-no update v-logq as log.
     1646      if v-logq = false then return .
     1647      is-many = true .
     1648   end.
     1649     run proc-b-del in this-procedure ( p-rid-list , is-many ) no-error.
     1650     if error-status:error then return no-apply.
     1651   END.
     1652   ON CHOOSE OF B-lookup IN FRAME Dialog-Frame
     1653   DO:
     1654   if not available buf_goods then return no-apply.
     1655   run str/showgds.p ( input parparentproc
     1656                      ,input ?
     1657                      ,input buf_goods.gds-code
     1658                      ,input 'ПРОСМОТР':U) no-error.
     1659   END.
     1660   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
     1661   DO:
     1662     define variable loc#log as logical no-undo .
     1663     if AVAILABLE Buf_ext-classif  then do:
     1664   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1665   define variable v-str-recid12 as character no-undo .
     1666   define variable v-num-entry12 as integer   no-undo .
     1667   assign
     1668     v-str-recid12 = trim( string( recid( Buf_ext-classif ) , "->>>>>>>>>>>9":U ) )
     1669     v-num-entry12 = lookup( v-str-recid12 , p-rid-list )
     1670   .
     1671   if v-num-entry12 > 0 then do:
     1672     assign
     1673       entry( v-num-entry12, p-rid-list ) = "":U
     1674       p-rid-list = trim( replace( p-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1675     .
     1676   end.
     1677   else do:
     1678     assign
     1679       p-rid-list = p-rid-list + ( if p-rid-list = "":U then "":U else chr(44) ) + v-str-recid12
     1680     .
     1681   end.
     1682       loc#log = BROWSE-ext-goods:refresh() .
     1683       if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
     1684           loc#log = BROWSE-ext-goods:select-next-row ().
     1685           apply "VALUE-CHANGED" to BROWSE-ext-goods in frame Dialog-Frame.
     1686       end.
     1687       if num-entries( p-rid-list ) = 0
     1688       then
     1689           hide mark-num in frame Dialog-Frame.
     1690       else
     1691           disp num-entries( p-rid-list ) @ mark-num with frame Dialog-Frame.
     1692     end.
     1693     apply "display" to BROWSE-ext-goods in frame Dialog-Frame.
     1694   END.
     1695   ON CHOOSE OF B-print IN FRAME Dialog-Frame
     1696   DO:
     1697     run proc-b-print in this-procedure no-error.
     1698     if error-status:error then do:
     1699       return no-apply.
     1700     end.
     1701   END.
     1702   ON CHOOSE OF B-sel IN FRAME Dialog-Frame
     1703   DO:
     1704      IF  v-rid-list = ""
     1705      or b-mark:sensitive in frame Dialog-Frame = no
     1706      THEN DO:
     1707         IF AVAILABLE buf_ext-classif THEN v-rid-list = string(RECID(buf_ext-classif)).
     1708     END.
     1709   END.
     1710   ON CTRL-J OF sch-artic IN FRAME Dialog-Frame
     1711   DO:
     1712     run proc-find-artic in this-procedure ( yes, input frame Dialog-Frame sch-artic) no-error.
     1713     if error-status:error then return no-apply.
     1714   END.
     1715   ON RETURN OF sch-artic IN FRAME Dialog-Frame
     1716   DO:
     1717     run proc-find-artic in this-procedure ( no , input frame Dialog-Frame sch-artic ) no-error.
     1718     return no-apply.
     1719   END.
     1720   ON CTRL-J OF sch-code IN FRAME Dialog-Frame
     1721   DO:
     1722     run proc-find-code in this-procedure ( yes, input frame Dialog-Frame sch-code) no-error.
     1723     if error-status:error then return no-apply.
     1724   END.
     1725   ON RETURN OF sch-code IN FRAME Dialog-Frame
     1726   DO:
     1727     run proc-find-code in this-procedure ( no, input frame Dialog-Frame sch-code) no-error.
     1728     return no-apply.
     1729   END.
     1730   ON CTRL-J OF sch-name IN FRAME Dialog-Frame
     1731   DO:
     1732     run proc-find-name in this-procedure ( yes, input frame Dialog-Frame sch-name) no-error.
     1733     if error-status:error then return no-apply.
     1734   END.
     1735   ON RETURN OF sch-name IN FRAME Dialog-Frame
     1736   DO:
     1737     run proc-find-name in this-procedure ( no, input frame Dialog-Frame sch-name ) no-error.
     1738     return no-apply.
     1739   END.
     1740   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1741   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1742   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1743   on help of frame Dialog-Frame
     1744   do:
     1745     run gbl/app_help.p
     1746       (input this-procedure :file-name
     1747       ,input ''
     1748       ,input ?
     1749       ) no-error.
     1750     if error-status :error then do:
     1751       message
     1752         "Ошибка при вызове помощи"
     1753         error-status :get-message(1)
     1754         view-as alert-box .
     1755     end.
     1756   end.
     1757   run minbtn-set in this-procedure .
     1758   on choose of b-help in frame Dialog-Frame
     1759   do:
     1760     apply "help":u to frame Dialog-Frame .
     1761   end.
     1762   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1763   procedure minbtn-set :
     1764       do
     1765           on error undo, return error return-value
     1766           :
     1767           define variable ii              as integer       no-undo .
     1768           define variable fh              as widget-handle no-undo .
     1769           define variable hh              as widget-handle no-undo .
     1770           define variable v-h             as handle        extent 4 no-undo .
     1771           define variable v-name-button   as character     no-undo .
     1772           define variable v-help-old-x    as decimal       no-undo .
     1773           define variable v-help-old-y    as decimal       no-undo .
     1774           define variable v-help-old-size as decimal       no-undo .
     1775           define variable v-frame-width   as decimal       no-undo .
     1776           define variable jj              as integer       no-undo .
     1777           do
     1778               on error undo, return error
     1779               :
     1780               assign
     1781                   v-frame-width = frame Dialog-Frame:width - 0.3
     1782                   fh            = frame Dialog-Frame:first-child
     1783                   hh            = fh:first-child
     1784                   ii            = 1
     1785                   .
     1786               do while valid-handle(hh):
     1787                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1788                   do:
     1789                       case lc(hh:name) :
     1790                           when "b-help" then
     1791                               do:
     1792                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1793                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1794                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1795                                   hh:TOOLTIP = "Помощь" .
     1796                                   v-help-old-x = hh:column .
     1797                                   v-help-old-y = hh:row    .
     1798                                   v-help-old-size = hh:width .
     1799                                   hh:width-chars = 2.5 .
     1800                               end.
     1801                           when "b-print" then
     1802                               do:
     1803                                   hh:load-image("cmp/b-print.bmp":u) .
     1804                                   hh:TOOLTIP = "Печать" .
     1805                                   v-h[ii] = hh:handle .
     1806                                   ii = ii + 1 .
     1807                                   hh:width-chars = 3 .
     1808                               end.
     1809                           when "b-history" or
     1810                           when "b-hist" then
     1811                               do:
     1812                                   hh:load-image("cmp/b-hist.bmp":u) .
     1813                                   hh:TOOLTIP = "История" .
     1814                                   v-h[ii] = hh:handle .
     1815                                   ii = ii + 1 .
     1816                                   hh:width-chars = 3 .
     1817                               end.
     1818                           when "b-sch" then
     1819                               do:
     1820                                   hh:load-image("cmp/b-sch.bmp":u) .
     1821                                   hh:TOOLTIP = "Установка Фильтра" .
     1822                                   v-h[ii] = hh:handle .
     1823                                   ii = ii + 1 .
     1824                                   hh:width-chars = 3 .
     1825                               end.
     1826                           when "b-hist-user" then
     1827                               do:
     1828                                   hh:load-image("cmp/b-hist.bmp":u) .
     1829                                   hh:TOOLTIP = "История пользователя" .
     1830                                   ii = ii + 1 .
     1831                               end.
     1832                       end case.
     1833                   end.
     1834                   hh = hh:next-sibling.
     1835               end.
     1836               b-help:column = v-frame-width - b-help:width-chars.
     1837               jj = 0.
     1838               repeat ii = 4 to 1 by -1 :
     1839                   if valid-handle (v-h[ii] ) then
     1840                   do:
     1841                       jj  = jj + 1 .
     1842                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1843                       v-h[ii]:row    = v-help-old-y .
     1844                   end.
     1845               end.
     1846           end.
     1847       end.
     1848   end procedure.
     1849   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1850   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1851   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1852   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1853   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1854   define variable v-diasize-current-frame-height as decimal   no-undo .
     1855   define variable v-diasize-change-size          as logical   no-undo .
     1856   define variable v-diasize-resize-button        as handle    no-undo .
     1857   define variable v-diasize-wndmax               as logical   no-undo .
     1858   define variable v-diasize-wndstore             as logical   no-undo .
     1859   define variable v-diasize-proc-name            as character no-undo .
     1860   define variable v-diasize-browse-handle        as handle    no-undo .
     1861   define variable v-diasize-browse-number        as integer   no-undo .
     1862   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1863   define temp-table temp-diasize-handle no-undo
     1864     field handle-value  as handle
     1865     field save-position as decimal
     1866     index xpk is primary unique handle-value
     1867     .
     1868   define temp-table temp-browse-handle no-undo
     1869     field browse-type   as character
     1870     field browse-number as integer
     1871     field browse-handle as handle
     1872     field original-size as decimal
     1873     index xpk is primary unique browse-type browse-number
     1874     index xie browse-type browse-handle
     1875   .
     1876   procedure diasize_change-height :
     1877     define input  parameter p-change-value  as decimal   no-undo .
     1878     define input  parameter p-move-resize   as logical   no-undo .
     1879     define variable v-field-group-handle    as handle    no-undo .
     1880     define variable v-object-handle         as handle    no-undo .
     1881     define variable v-frame-height          as decimal   no-undo .
     1882     define variable v-frame-virtual-height  as decimal   no-undo .
     1883     define variable v-browse-height         as decimal   no-undo .
     1884     define variable v-window-height         as decimal   no-undo .
     1885     define variable v-window-virtual-height as decimal   no-undo .
     1886     define variable v-change-sign           as integer   no-undo .
     1887     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1888     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1889     if p-change-value > 0
     1890     then do:
     1891       if frame Dialog-Frame :height + p-change-value
     1892           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1893       then do:
     1894         assign
     1895           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1896                           - (frame Dialog-Frame :height-chars)
     1897         .
     1898         if p-change-value <= 0
     1899         then do:
     1900           run diasize_position-resize-button in this-procedure .
     1901           return .
     1902         end.
     1903       end.
     1904     end.
     1905     if p-change-value < 0
     1906     then do:
     1907       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1908       then do:
     1909         assign
     1910           p-change-value = v-diasize-orig-frame-height
     1911                          - (frame Dialog-Frame :height-chars)
     1912         .
     1913         if p-change-value >= 0
     1914         then do:
     1915           run diasize_position-resize-button in this-procedure .
     1916           return .
     1917         end.
     1918       end.
     1919     end.
     1920     if p-change-value >= 0
     1921     then do:
     1922       assign
     1923         v-change-sign = 1
     1924       .
     1925     end.
     1926     else do:
     1927       assign
     1928         v-change-sign = -1
     1929       .
     1930     end.
     1931     assign
     1932       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1933     .
     1934     if p-change-value = 0
     1935     then do:
     1936       run diasize_position-resize-button in this-procedure .
     1937       return .
     1938     end.
     1939     move_block:
     1940     do
     1941     on error undo move_block, retry move_block
     1942     :
     1943       if retry
     1944       then do:
     1945         do
     1946         on error undo move_block, leave move_block
     1947         :
     1948           if p-change-value > 0
     1949           then do:
     1950             for each buf_temp-diasize-handle
     1951             on error undo, next
     1952             :
     1953               assign
     1954                 v-object-handle = buf_temp-diasize-handle.handle-value
     1955               .
     1956               if v-object-handle <> v-diasize-resize-button
     1957               then do:
     1958                 assign
     1959                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1960                 .
     1961               end.
     1962             end.
     1963             assign
     1964               v-diasize-browse-handle :height = v-browse-height
     1965             .
     1966             for each buf_temp-browse-handle
     1967               where buf_temp-browse-handle.browse-type = 'height':u
     1968             on error undo, next
     1969             :
     1970               assign
     1971                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1972               .
     1973             end.
     1974             assign
     1975               frame Dialog-Frame :height = v-frame-height
     1976             .
     1977             if frame Dialog-Frame :scrollable = true
     1978             then do:
     1979               assign
     1980                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1981               .
     1982             end.
     1983             run diasize_position-resize-button in this-procedure .
     1984           end.
     1985           else do:
     1986             if frame Dialog-Frame :scrollable = true
     1987             then do:
     1988               assign
     1989                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1990               .
     1991             end.
     1992             assign
     1993               frame Dialog-Frame :height = v-frame-height
     1994             .
     1995             assign
     1996               v-diasize-browse-handle :height = v-browse-height
     1997             .
     1998             for each buf_temp-browse-handle
     1999               where buf_temp-browse-handle.browse-type = 'height':u
     2000             on error undo, next
     2001             :
     2002               assign
     2003                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2004               .
     2005             end.
     2006             for each buf_temp-diasize-handle
     2007             on error undo, next
     2008             :
     2009               assign
     2010                 v-object-handle = buf_temp-diasize-handle.handle-value
     2011               .
     2012               if v-object-handle <> v-diasize-resize-button
     2013               then do:
     2014                 assign
     2015                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2016                 .
     2017               end.
     2018             end.
     2019             run diasize_position-resize-button in this-procedure .
     2020           end.
     2021           assign
     2022             v-diasize-change-size = false
     2023           .
     2024           leave move_block .
     2025         end.
     2026       end.
     2027       assign
     2028         v-diasize-need-full-display = true
     2029       .
     2030       if v-diasize-change-size = false
     2031       then do:
     2032         assign
     2033           v-diasize-change-size = true
     2034         .
     2035       end.
     2036       else do:
     2037         return .
     2038       end.
     2039       assign
     2040         v-frame-height = frame Dialog-Frame :height
     2041         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     2042         v-browse-height = v-diasize-browse-handle :height
     2043       .
     2044       for each buf_temp-browse-handle
     2045         where buf_temp-browse-handle.browse-type = 'height':u
     2046       :
     2047         assign
