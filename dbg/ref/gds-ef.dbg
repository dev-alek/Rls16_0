     2650   procedure diasize_position-resize-button :
     2651     do with frame Dialog-Frame
     2652     :
     2653       hide v-diasize-resize-button .
     2654       assign
     2655         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2656                     - 1
     2657                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2658         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2659                     - 1
     2660                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2661       .
     2662       view v-diasize-resize-button .
     2663     end.
     2664   end procedure.
     2665   on alt-right anywhere
     2666   do:
     2667     run diasize_change-width in this-procedure
     2668       (input 1
     2669       ,input true
     2670       ) .
     2671     return no-apply .
     2672   end.
     2673   on alt-left anywhere
     2674   do:
     2675     run diasize_change-width in this-procedure
     2676       (input -1
     2677       ,input true
     2678       ) .
     2679     return no-apply .
     2680   end.
     2681   on alt-down anywhere
     2682   do:
     2683     run diasize_change-height in this-procedure
     2684       (input 1
     2685       ,input true
     2686       ) .
     2687     return no-apply .
     2688   end.
     2689   on alt-up anywhere
     2690   do:
     2691     run diasize_change-height in this-procedure
     2692       (input -1
     2693       ,input true
     2694       ) .
     2695     return no-apply .
     2696   end.
     2697   on alt-enter of frame Dialog-Frame
     2698   do:
     2699     run diasize_maximize in this-procedure
     2700       (input  ?
     2701       ).
     2702     return no-apply .
     2703   end.
     2704   procedure diasize_end-move :
     2705     do
     2706     on error undo, return error return-value
     2707     :
     2708       define variable v-row-delta as decimal   no-undo .
     2709       define variable v-col-delta as decimal   no-undo .
     2710       define variable v-new-row as decimal   no-undo .
     2711       define variable v-new-col as decimal   no-undo .
     2712       assign
     2713         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2714         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2715       .
     2716       assign
     2717         v-row-delta = v-new-row - frame Dialog-Frame :height
     2718         v-col-delta = v-new-col - frame Dialog-Frame :width
     2719       .
     2720       run diasize_change-height in this-procedure
     2721         (input v-row-delta
     2722         ,input true
     2723         ) .
     2724       run diasize_change-width in this-procedure
     2725         (input v-col-delta
     2726         ,input true
     2727         ) .
     2728     end.
     2729   end procedure.
     2730   procedure diasize_maximize :
     2731     define input  parameter p-action as logical   no-undo .
     2732     do
     2733     on error undo, return error return-value
     2734     :
     2735       if p-action = ?
     2736       then do:
     2737         if v-diasize-need-maximize = true
     2738         then do:
     2739           assign
     2740             p-action = true
     2741           .
     2742         end.
     2743         else do:
     2744           assign
     2745             p-action = false
     2746           .
     2747         end.
     2748       end.
     2749       if p-action = true
     2750       then do:
     2751         run diasize_change-height in this-procedure
     2752           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2753               - frame Dialog-Frame :height-chars
     2754           ,input true
     2755           ) .
     2756         run diasize_change-width in this-procedure
     2757           (input session :width-chars
     2758               - frame Dialog-Frame :width-chars
     2759           ,input true
     2760           ) .
     2761         assign
     2762           v-diasize-need-maximize = false
     2763         .
     2764       end.
     2765       else do:
     2766         run diasize_change-width in this-procedure
     2767           (input v-diasize-orig-frame-width
     2768               - frame Dialog-Frame :width-chars
     2769           ,input true
     2770           ) .
     2771         run diasize_change-height in this-procedure
     2772           (input v-diasize-orig-frame-height
     2773               - frame Dialog-Frame :height-chars
     2774           ,input true
     2775           ) .
     2776         assign
     2777           v-diasize-need-maximize = true
     2778         .
     2779       end.
     2780     end.
     2781   end procedure.
     2782   procedure diasize_restore-orig-size :
     2783     do
     2784     on error undo, return error return-value
     2785     :
     2786       assign
     2787         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2788         v-diasize-current-frame-height = frame Dialog-Frame :height
     2789       .
     2790       run diasize_set-height in this-procedure
     2791         (input  v-diasize-orig-frame-height
     2792         ,input  true
     2793         ) .
     2794       run diasize_set-width in this-procedure
     2795         (input  v-diasize-orig-frame-width
     2796         ,input  true
     2797         ) .
     2798     end.
     2799   end procedure.
     2800   procedure diasize_restore-current-size :
     2801     do
     2802     on error undo, return error return-value
     2803     :
     2804       run diasize_set-height in this-procedure
     2805         (input  v-diasize-current-frame-height
     2806         ,input  true
     2807         ) .
     2808       run diasize_set-width in this-procedure
     2809         (input  v-diasize-current-frame-width
     2810         ,input  true
     2811         ) .
     2812     end.
     2813   end procedure.
     2814   procedure diasize_set-browse-handle :
     2815     define input  parameter p-browse-handle as handle   no-undo .
     2816     define buffer buf_temp-browse-handle for temp-browse-handle .
     2817     do
     2818     on error undo, return error return-value
     2819     :
     2820       assign
     2821         v-diasize-browse-handle = p-browse-handle
     2822       .
     2823       for each buf_temp-browse-handle
     2824       on error undo, return error return-value
     2825       :
     2826         delete buf_temp-browse-handle .
     2827       end.
     2828     end.
     2829   end procedure.
     2830   procedure diasize_add_browse :
     2831     define input  parameter p-browse-type   as character no-undo .
     2832     define input  parameter p-browse-handle as handle    no-undo .
     2833     define buffer buf_temp-browse-handle for temp-browse-handle .
     2834     do
     2835     on error undo, return error return-value
     2836     :
     2837       assign
     2838         v-diasize-browse-number = v-diasize-browse-number + 1
     2839       .
     2840       create buf_temp-browse-handle .
     2841       assign
     2842         buf_temp-browse-handle.browse-type   = p-browse-type
     2843         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2844         buf_temp-browse-handle.browse-handle = p-browse-handle
     2845       .
     2846     end.
     2847   end procedure.
     2848   procedure diasize_init :
     2849     define variable v-default-value    as logical   no-undo .
     2850     define variable v-restore-saved    as logical   no-undo .
     2851     define variable v-resize-value-str as character no-undo .
     2852     do
     2853     on error undo, return error return-value
     2854     :
     2855       do with frame Dialog-Frame
     2856       :
     2857         assign
     2858           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2859           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2860           v-diasize-browse-handle     = browse BROWSE-ext-goods :handle
     2861         .
     2862         create button v-diasize-resize-button
     2863         assign
     2864           parent        = frame Dialog-Frame :first-child
     2865           label         = "s"
     2866           height-pixels = 16
     2867           width-pixels  = 16
     2868           visible       = true
     2869           sensitive     = true
     2870           movable       = true
     2871           triggers:
     2872             on end-move persistent run diasize_end-move in this-procedure .
     2873           end triggers.
     2874         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2875         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2876         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2877         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2878         assign
     2879           v-diasize-wndmax = false
     2880         .
     2881         if connected("ub") = true
     2882         then do:
     2883           define variable v-cntxt-db-num        as integer   no-undo .
     2884           define variable v-cntxt-userid        as character no-undo .
     2885           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2886                                             , OUTPUT v-cntxt-userid
     2887                                             ) .
     2888           run gbl/wndpar_r.p
     2889             (input  v-cntxt-db-num
     2890             ,input  v-cntxt-userid
     2891             ,input  'wndmax':U
     2892             ,output v-diasize-wndmax
     2893             ,output v-default-value
     2894             ) .
     2895         end.
     2896         assign
     2897           v-diasize-wndstore = false
     2898         .
     2899         if connected("ub") = true
     2900         then do:
     2901           run gbl/wndpar_r.p
     2902             (input  v-cntxt-db-num
     2903             ,input  v-cntxt-userid
     2904             ,input  'wndstore':U
     2905             ,output v-diasize-wndstore
     2906             ,output v-default-value
     2907             ) .
     2908         end.
     2909         assign
     2910           v-diasize-proc-name = entry(1, program-name(2), '.')
     2911         .
     2912         if v-diasize-wndstore = true
     2913         then do:
     2914           assign
     2915             v-restore-saved = false
     2916           .
     2917           if connected("ub") = true
     2918           then do:
     2919             run gbl/wndsizer.p
     2920               (input  v-cntxt-db-num
     2921               ,input  v-cntxt-userid
     2922               ,input  v-diasize-proc-name
     2923               ,input  'height':u
     2924               ,output v-resize-value-str
     2925               ) .
     2926             if v-resize-value-str <> '':U
     2927             then do:
     2928               run diasize_change-height in this-procedure
     2929                 (input  integer(v-resize-value-str)
     2930                 ,input  true
     2931                 ) .
     2932               assign
     2933                 v-restore-saved = true
     2934               .
     2935             end.
     2936           end.
     2937           if connected("ub") = true
     2938           then do:
     2939             run gbl/wndsizer.p
     2940               (input  v-cntxt-db-num
     2941               ,input  v-cntxt-userid
     2942               ,input  v-diasize-proc-name
     2943               ,input  'width':u
     2944               ,output v-resize-value-str
     2945               ) .
     2946             if v-resize-value-str <> '':U
     2947             then do:
     2948               run diasize_change-width in this-procedure
     2949                 (input  integer(v-resize-value-str)
     2950                 ,input  true
     2951                 ) .
     2952               assign
     2953                 v-restore-saved = true
     2954               .
     2955             end.
     2956           end.
     2957           if v-restore-saved <> true
     2958           then do:
     2959             if v-diasize-wndmax = true
     2960             then do:
     2961               run diasize_maximize in this-procedure
     2962                 (input  true
     2963                 ) .
     2964             end.
     2965           end.
     2966         end.
     2967         else do:
     2968           if v-diasize-wndmax = true
     2969           then do:
     2970             run diasize_maximize in this-procedure
     2971               (input  true
     2972               ) .
     2973           end.
     2974         end.
     2975       end.
     2976     end.
     2977   end procedure.
     2978   procedure diasize_need-full-display :
     2979     define output parameter p-need-full-display as logical   no-undo .
     2980     do
     2981     on error undo, return error return-value
     2982     :
     2983       assign
     2984         p-need-full-display = v-diasize-need-full-display
     2985       .
     2986       assign
     2987         v-diasize-need-full-display = false
     2988       .
     2989     end.
     2990   end procedure.
     2991   procedure get-context :
     2992      define output parameter p-db-num as integer          no-undo.
     2993      define output parameter p-user-id as character        no-undo.
     2994      define variable v-login               as character    no-undo.
     2995      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2996      define buffer buf_user-login  for ub.user-login .
     2997      do
     2998      on error undo, return error
     2999      :
     3000            FIND FIRST buf_sys-ctrl no-lock.
     3001            ASSIGN
     3002               v-login = USERID("ub")
     3003               p-db-num = buf_sys-ctrl.db-num
     3004            .
     3005            FIND FIRST buf_user-login
     3006                 WHERE buf_user-login.db-num = p-db-num
     3007                   AND buf_user-login.user-login = v-login
     3008                 no-lock
     3009                 no-error
     3010                 .
     3011            IF AVAILABLE buf_user-login
     3012            THEN DO:
     3013               assign
     3014                  p-user-id = buf_user-login.user-id
     3015               .
     3016            END.
     3017      end.
     3018   end procedure.
     3019       run diasize_init in this-procedure .
     3020   def var sort-labelBROWSE-ext-goods   as character no-undo .
     3021   def var sort-clmnBROWSE-ext-goods    as handle    no-undo .
     3022   def var cur-clmnBROWSE-ext-goods     as handle    no-undo .
     3023   def var cur-clmn-locBROWSE-ext-goods as integer   no-undo .
     3024   def var re-queryBROWSE-ext-goods     as logical   initial no no-undo .
     3025   on start-search, ctrl-o of BROWSE-ext-goods in frame Dialog-Frame do:
     3026      run sort-brBROWSE-ext-goods
     3027        (input (if available buf_ext-classif
     3028                then recid(buf_ext-classif)
     3029                else ?
     3030               )
     3031        ).
     3032   end.
     3033   PROCEDURE sort-brBROWSE-ext-goods :
     3034     define input parameter p-recid as recid no-undo .
     3035     if re-queryBROWSE-ext-goods = no then do:
     3036       assign
     3037          cur-clmnBROWSE-ext-goods = BROWSE-ext-goods:current-column in frame Dialog-Frame
     3038       .
     3039       if sort-clmnBROWSE-ext-goods <> ? then sort-clmnBROWSE-ext-goods:column-fgcolor = 0.
     3040       if cur-clmnBROWSE-ext-goods = sort-clmnBROWSE-ext-goods then do:
     3041         assign
     3042            sort-labelBROWSE-ext-goods = ""
     3043            sort-clmnBROWSE-ext-goods = ?
     3044         .
     3045        end.
     3046        else do:
     3047          assign
     3048            sort-labelBROWSE-ext-goods = cur-clmnBROWSE-ext-goods:label
     3049            sort-clmnBROWSE-ext-goods  = cur-clmnBROWSE-ext-goods
     3050            sort-clmnBROWSE-ext-goods:column-fgcolor = 4
     3051          .
     3052        end.
     3053      end.
     3054     assign
     3055       cur-clmn-locBROWSE-ext-goods = 1
     3056     .
     3057     def var column-handle as handle no-undo .
     3058     column-handle = BROWSE-ext-goods:first-column.
     3059     do while valid-handle(column-handle) :
     3060       if column-handle = cur-clmnBROWSE-ext-goods then do:
     3061         leave .
     3062       end.
     3063       column-handle = column-handle:NEXT-COLUMN.
     3064       assign
     3065         cur-clmn-locBROWSE-ext-goods = cur-clmn-locBROWSE-ext-goods + 1
     3066       .
     3067     end.
     3068     case sort-labelBROWSE-ext-goods:
     3069           when '*'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1mark-string&1, recid(buf_ext-classif), &1&2&1)', chr(34), p-rid-list)     .     run OpenBr.   . END.
     3070           when 'Артикул'  then DO:    assign       sort-column-name = "Buf_goods.artic"     .     run OpenBr.   . END.
     3071           when 'Код'  then DO:    assign       sort-column-name = "Buf_goods.gds-code"     .     run OpenBr.   . END.
     3072           when 'Название'  then DO:    assign       sort-column-name = "Buf_goods.gds-name"     .     run OpenBr.   . END.
     3073           when 'Код EASYFUEL'  then DO:    assign       sort-column-name = "Buf_ext-classif.Key#_One"     .     run OpenBr.   . END.
     3074       otherwise do:
     3075         assign
     3076           sort-column-name = ""
     3077         .
     3078         run OpenBr.
     3079         if sort-labelBROWSE-ext-goods <> "" then do:
     3080           assign
     3081             cur-clmnBROWSE-ext-goods:column-fgcolor = 0
     3082           .
     3083         end.
     3084         assign
     3085           cur-clmn-locBROWSE-ext-goods = ?
     3086         .
     3087       end.
     3088     end case.
     3089     if p-recid <> ? then do:
     3090       reposition BROWSE-ext-goods to recid p-recid no-error.
     3091       apply "value-changed" to BROWSE-ext-goods in frame Dialog-Frame.
     3092     end.
     3093     apply "entry" to BROWSE-ext-goods in frame Dialog-Frame.
     3094   END PROCEDURE.
     3095   procedure re-open-query-srt-clmnBROWSE-ext-goods:
     3096   if cur-clmnBROWSE-ext-goods = ? then do:
     3097      run OpenBr.
     3098   end.
     3099   else do:
     3100      assign re-queryBROWSE-ext-goods = yes.
     3101      run sort-brBROWSE-ext-goods
     3102        (input (if available buf_ext-classif
     3103                then recid(buf_ext-classif)
     3104                else ?
     3105               )
     3106        ).
     3107      assign re-queryBROWSE-ext-goods = no.
     3108   end.
     3109   end.
     3110   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3111   do:
     3112     BROWSE-ext-goods :SET-REPOSITIONED-ROW(5, "CONDITIONAL") .
     3113   end.
     3114   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3115   on F9 of frame Dialog-Frame anywhere do:
     3116     run init-gds-rec.
     3117     if gds-rec = ? then
     3118       return no-apply.
     3119     run ref/gds-form.w ( input parParentProc
     3120                         ,input 'ПРОСМОТР':U
     3121                         ,input ?
     3122                         ,input ?
     3123                         ,input ?
     3124                         ,input-output gds-rec).
     3125     apply "entry" to BROWSE-ext-goods in frame Dialog-Frame.
     3126     return no-apply.
     3127   end.
     3128   MAIN-BLOCK:
     3129   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     3130      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     3131   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3132   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
     3133     (output v-db-num
     3134     )  .
     3135     run myenable in this-procedure .
     3136     hide mark-num in frame Dialog-Frame .
     3137     if v-doc-rec <> ? then
     3138     reposition BROWSE-ext-goods to recid v-doc-rec no-error.
     3139     apply "row-display" to BROWSE-ext-goods in frame Dialog-Frame.
     3140     WAIT-FOR GO OF FRAME Dialog-Frame focus BROWSE-ext-goods.
     3141   END.
     3142   run disable_ui in this-procedure .
     3143   PROCEDURE add-str :
     3144   define input-output parameter p-doc-rec   as recid no-undo.
     3145   define input parameter p-mode             as character no-undo .
     3146   define parameter buffer buf_goods for ub.goods.
     3147   define input parameter p-accor-code         as integer   no-undo .
     3148   do
     3149   on error undo, return error return-value
     3150   :
     3151     run gen-key-rec in this-procedure (
     3152         input  'goods':U
     3153         ,input  buffer buf_goods:handle
     3154         ,output v-key-rec ).
     3155     if p-mode = 'ДОБАВЛЕНИЕ':U then do:
     3156       run ref/extclas1.p ( INPUT 'ДОБАВЛЕНИЕ':U
     3157                           ,INPUT NO
     3158                           ,INPUT-OUTPUT p-doc-rec
     3159                           ,INPUT 'goods':U
     3160                           ,INPUT 'exp-easyfuel-talon-gds-code':U
     3161                           ,input (-1)
     3162                           ,input p-accor-code
     3163                           ,input 0
     3164                           ,input 0
     3165                           ,input '':U
     3166                           ,input '':U
     3167                           ,input '':U
     3168                           ,input 0
     3169                           ,input v-key-rec ) no-error.
     3170       if error-status:error then do:
     3171         undo, return error .
     3172       end.
     3173     end.
     3174   end.
     3175   END PROCEDURE.
     3176   PROCEDURE disable_UI :
     3177     HIDE FRAME Dialog-Frame.
     3178   END PROCEDURE.
     3179   PROCEDURE enable_UI :
     3180     DISPLAY a-n-c sch-artic mark-num FILL-IN-7
     3181         WITH FRAME Dialog-Frame.
     3182     ENABLE b-quit B-mark B-sel B-add B-del B-print B-Help a-n-c sch-artic
     3183            BROWSE-ext-goods mark-num FILL-IN-7
     3184         WITH FRAME Dialog-Frame.
     3185     VIEW FRAME Dialog-Frame.
     3186     OPEN QUERY BROWSE-ext-goods FOR EACH Buf_ext-classif       WHERE Buf_ext-classif.classif-subject = 'goods':U         AND Buf_ext-classif.classif-name = 'exp-easyfuel-talon-gds-code':U NO-LOCK,               first Buf_goods where              Buf_goods.gds-code = int(entry(2,       ub.Buf_ext-classif.uniq-key-rec,        chr(3))) NO-LOCK INDEXED-REPOSITION.
     3187   END PROCEDURE.
     3188   PROCEDURE init-gds-rec :
     3189   if available buf_goods then do:
     3190      gds-rec = recid (buf_goods) .
     3191   end.
     3192   END PROCEDURE.
     3193   PROCEDURE myenable :
     3194   define variable v-db-num like ub.db.db-num no-undo .
     3195   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3196   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
     3197     (output v-db-num
     3198     )  .
     3199   DISPLAY mark-num
     3200   WITH FRAME Dialog-Frame.
     3201   ENABLE
     3202   b-quit
     3203   B-mark when transaction = false
     3204   B-sel when LOOKUP("b-sel":U, bttns) > 0
     3205   B-add when LOOKUP("b-add":U, bttns) > 0 and v-cntxt-db-num = 0 and transaction = false
     3206   B-del when LOOKUP("b-add":U, bttns) > 0 and v-cntxt-db-num = 0 and transaction = false
     3207   B-print
     3208   B-Help
     3209   BROWSE-ext-goods
     3210   mark-num
     3211   a-n-c
     3212   sch-artic
     3213   with FRAME Dialog-Frame.
     3214   VIEW FRAME Dialog-Frame.
     3215   run openbr in this-procedure no-error.
     3216   IF ERROR-STATUS:ERROR  THEN RETURN error.
     3217   END PROCEDURE.
     3218   PROCEDURE openBr :
     3219   define variable p-open-query     as logical   no-undo init true .
     3220   def var l-query-was-opened as logical no-undo .
     3221   define variable doc-rec  as recid     no-undo .
     3222   define variable  p-find-next      as logical   no-undo .
     3223   define variable  p-find-condition as character no-undo .
     3224   def var sort-column-phrase as character no-undo .
     3225   case sort-column-name :
     3226     when "" then do:
     3227       assign
     3228         sort-column-phrase = ""
     3229       .
     3230     end.
     3231     otherwise do:
     3232       assign
     3233         sort-column-phrase = "by " + sort-column-name
     3234       .
     3235     end.
     3236   end case.
     3237   define variable title0 as character no-undo init "Типы топлива для внешней системы EASYFUEL" .
     3238       if p-open-query then do:
     3239         frame Dialog-Frame:TITLE = title0  .
     3240       end.
     3241   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3242   define variable  l-disable-where-21  as logical   no-undo .
     3243   define variable  l-filter-open-21    as logical   .
     3244   define variable  flt-rec-21       as recid     no-undo .
     3245   define variable  filter-name-21      as character no-undo .
     3246   define variable  where-phrase-21     as character no-undo .
     3247   define variable  sort-phrase-21      as character no-undo .
     3248   define variable  where-phrase-rus-21 as character no-undo .
     3249   define variable  sort-phrase-rus-21  as character no-undo .
     3250     run waitfram-show in this-procedure
     3251       (input "ЖДИТЕ ..."
     3252       ).
     3253   run gbl/flt-get.p
     3254     (input filter-point
     3255     ,output flt-rec-21
     3256     ,output filter-name-21
     3257     ,output where-phrase-21
     3258     ,output sort-phrase-21
     3259     ,output where-phrase-rus-21
     3260     ,output sort-phrase-rus-21
     3261     ).
     3262   if p-open-query then do:
     3263     assign
     3264       l-filter-open-21 = false
     3265     .
     3266     if flt-rec-21 <> ?
     3267       or sort-column-phrase > ""
     3268     then do:
     3269       define variable  parameter-2-21 as character no-undo .
     3270       define variable  parameter-3-21 as character no-undo .
     3271       define variable  parameter-4-21 as character no-undo .
     3272       define variable  parameter-5-21 as character no-undo .
     3273       define variable  parameter-6-21 as character no-undo .
     3274       define variable  parameter-7-21 as character no-undo .
     3275         assign
     3276         parameter-3-21 =
     3277                                 "FOR EACH Buf_ext-classif"
     3278         parameter-4-21 =
     3279           (
     3280             if ("  Buf_ext-classif.classif-subject = 'goods':U  AND                      Buf_ext-classif.classif-name = 'exp-easyfuel-talon-gds-code':U  " + " " + where-phrase-21) <> ""
     3281             then substitute(' Buf_ext-classif.classif-subject = &1&2&1  AND                  Buf_ext-classif.classif-name = &1&2&1 '  , chr(34), 'goods':U ,  'exp-easyfuel-talon-gds-code':U) + " " + where-phrase-21
     3282             else "true"
     3283           )
     3284         parameter-5-21 = (" " + "" + " " + substitute( ', first buf_goods no-lock where                                      buf_goods.gds-code = integer(entry(2,buf_ext-classif.uniq-key-rec,&1&2&1 )) '                                     , chr(34), chr(3) ))
     3285         parameter-6-21 = if sort-phrase-21 = ''
     3286                              then
     3287           (
     3288           " " + " " +
     3289             " " + sort-column-phrase +
     3290           " " + " "
     3291           )
     3292                              else
     3293           (
     3294           " " + " " +
     3295             " " + sort-column-phrase +
     3296           " " + sort-phrase-21
     3297           )
     3298         parameter-7-21 =
     3299           " indexed-reposition  "
     3300       .
     3301       do
     3302       on stop undo, leave
     3303       on error undo, leave
     3304       :
     3305         assign
     3306           l-disable-where-21 =
     3307             ("  Buf_ext-classif.classif-subject = 'goods':U  AND                      Buf_ext-classif.classif-name = 'exp-easyfuel-talon-gds-code':U  " + " " + where-phrase-21 = "")
     3308         .
     3309         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     3310                             ,input query BROWSE-ext-goods:handle
     3311                             ,input parameter-3-21
     3312                             ,input parameter-4-21
     3313                             ,input parameter-5-21
     3314                             ,input parameter-6-21
     3315                             ,input parameter-7-21
     3316                             )
     3317         .
     3318         assign
     3319           l-filter-open-21 = true
     3320         .
     3321       end.
     3322       if l-filter-open-21 = false then do:
     3323         message
     3324           "Ошибка при фильтрации / сортировке" skip
     3325           "Будут показаны записи без учета фильтра" skip
     3326           view-as alert-box .
     3327       end.
     3328       else do:
     3329           assign
     3330             l-query-was-opened = true
     3331           .
     3332       end.
     3333     end.
     3334     if l-filter-open-21 = false then do:
     3335       OPEN QUERY BROWSE-ext-goods FOR EACH Buf_ext-classif
     3336         where   Buf_ext-classif.classif-subject = 'goods':U  AND                      Buf_ext-classif.classif-name = 'exp-easyfuel-talon-gds-code':U
     3337       , first buf_goods no-lock where                                    buf_goods.gds-code = integer(entry(2,buf_ext-classif.uniq-key-rec, chr(3)))
     3338         indexed-reposition
     3339     .
     3340         assign
     3341           l-query-was-opened = true
     3342         .
     3343     end.
     3344   end.
     3345   else do:
     3346     assign
     3347       doc-rec = recid( buf_ext-classif )
     3348     .
     3349     do
     3350     on stop undo, leave
     3351     on error undo, leave
     3352     :
     3353       if query BROWSE-ext-goods:handle:get-buffer-handle(1) = (buffer Buf_ext-classif:handle) then do:
     3354         assign
     3355         parameter-2-21 = (if p-find-next then "true":u else "false":u )
     3356         parameter-4-21 =
     3357           "where ":u + substitute(' Buf_ext-classif.classif-subject = &1&2&1  AND                  Buf_ext-classif.classif-name = &1&2&1 '  , chr(34), 'goods':U ,  'exp-easyfuel-talon-gds-code':U) + " ":u + where-phrase-21 + " ":u + p-find-condition + " " + ""
     3358         parameter-5-21 = " "
     3359       .
     3360         run fltopend_fltfindd in this-procedure  (
     3361                             input this-procedure:handle
     3362                             ,input query BROWSE-ext-goods:handle
     3363                             ,input rowid(buf_ext-classif)
     3364                             ,input logical(parameter-2-21)
     3365                             ,input no-lock
     3366                             ,input (buffer buf_ext-classif:handle)
     3367                             ,input parameter-4-21
     3368                             ,input parameter-5-21
     3369                             ) no-error.
     3370         .
     3371         assign
     3372           doc-rec = integer(return-value)
     3373           v-fltopend-rowid[1] = ?
     3374         .
     3375       end.
     3376       else do:
     3377         assign
     3378         parameter-2-21 = (if p-find-next then "true":u else "false":u )
     3379         parameter-3-21 =  "FOR EACH Buf_ext-classif"
     3380         parameter-4-21 =
     3381           (
     3382             if ("  Buf_ext-classif.classif-subject = 'goods':U  AND                      Buf_ext-classif.classif-name = 'exp-easyfuel-talon-gds-code':U  " + " " + where-phrase-21) <> ""
     3383             then substitute(' Buf_ext-classif.classif-subject = &1&2&1  AND                  Buf_ext-classif.classif-name = &1&2&1 '  , chr(34), 'goods':U ,  'exp-easyfuel-talon-gds-code':U) + " " + where-phrase-21
     3384             else "true"
     3385           )
     3386         parameter-5-21 = (" " + "" + " " + substitute( ', first buf_goods no-lock where                                      buf_goods.gds-code = integer(entry(2,buf_ext-classif.uniq-key-rec,&1&2&1 )) '                                     , chr(34), chr(3) ) + " " + p-find-condition)
     3387         parameter-6-21 = if sort-phrase-21 = ''
     3388                              then
     3389           (
     3390           " " + " " +
     3391             " " + sort-column-phrase +
     3392           " " + " "
     3393           )
     3394                              else
     3395           (
     3396           " " + " " +
     3397             " " + sort-column-phrase +
     3398           " " + sort-phrase-21
     3399           )
     3400         parameter-7-21 =
     3401           " indexed-reposition  "
     3402       .
     3403         run fltopend_fltfindq in this-procedure  (
     3404                             input this-procedure:handle
     3405                             ,input query BROWSE-ext-goods:handle
     3406                             ,input logical(parameter-2-21)
     3407                             ,input no-lock
     3408                             ,input parameter-3-21
     3409                             ,input parameter-4-21
     3410                             ,input parameter-5-21
     3411                             ,input parameter-6-21
     3412                             ,input parameter-7-21
     3413                             ,output v-fltopend-rowid
     3414                             ) no-error.
     3415         .
     3416         doc-rec = ?.
     3417       end.
     3418       assign
     3419         l-query-was-opened = true
     3420       .
     3421     end.
     3422   end.
     3423     run waitfram-hide in this-procedure .
     3424   APPLY "VALUE-CHANGED" TO BROWSE-ext-goods in frame Dialog-Frame.
     3425   END PROCEDURE.
     3426   PROCEDURE proc-add :
     3427   define output parameter p-doc-rec as recid no-undo .
     3428   define variable v-rid-list as character no-undo .
     3429   define variable v-value-integer as integer no-undo .
     3430   define variable v-ok as logical no-undo .
     3431   run ref/petrlref.p ( input parparentproc
     3432                   ,input "b-sel"
     3433                   ,output v-rid-list) no-error.
     3434   if error-status :error then do:
     3435   message
     3436     vss-workfile vss-revision vss-description skip
     3437     error-status :get-message(1) skip
     3438     return-value skip
     3439     view-as alert-box error
     3440     .
     3441   end.
     3442   if v-rid-list = '':u then return.
     3443   run waitfram-show in this-procedure  ("Добавление товаров  ... " ) .
     3444   find first buf_goods no-lock where
     3445           recid(buf_goods) = integer(v-rid-list) no-error.
     3446   if available buf_goods then do:
     3447     run gbl/d-integer.w (
     3448          input ?
     3449         ,input (
     3450         'title=':u + substitute("Добавление кода топлива для товара &1 &2&3"
     3451                                 ,buf_goods.artic
     3452                                 ,buf_goods.prod-type
     3453                                 ,buf_goods.prod-code
     3454                                 ) + '\':u
     3455       + 'text1=':u + "Код топлива EasyFuel" + '\':u
     3456       + 'format=' + ">>>>>>>>9" + '\':u
     3457       + 'fillin_row=2\':u
     3458       + 'fillin_col=30\':u
     3459       + 'fillin_width=10\':u
     3460       + 'fillin_height=1\':u
     3461       + 'max-chars=60\':u
     3462       + 'readonly=no' + '\':u)
     3463       , input-output v-value-integer
     3464       , output v-ok
     3465           ).
     3466     if not v-ok then return error.
     3467     run add-str in this-procedure
     3468     (   input-output p-doc-rec
     3469       ,input 'ДОБАВЛЕНИЕ':U
     3470       ,buffer buf_goods
     3471       ,input v-value-integer
     3472     ).
     3473   end.
     3474   run waitfram-hide in this-procedure .
     3475   END PROCEDURE.
     3476   PROCEDURE proc-b-del :
     3477   define input  parameter p-recid as character no-undo .
     3478   define input  parameter p-model as logical   no-undo .
     3479   define variable loc#log as logical no-undo.
     3480   define variable v-log as logical   no-undo .
     3481   define variable loc-doc-rec as recid no-undo.
     3482   define variable ii as integer   no-undo .
     3483   if not available buf_ext-classif then return error.
     3484   do
     3485   on error undo, return error
     3486   on stop undo, return error
     3487   :
     3488     assign
     3489       loc-doc-rec = RECID(buf_ext-classif)
     3490     .
     3491     if p-model = false then do:
     3492       run ref/extclas3.p ( input no
     3493                           ,input loc-doc-rec) .
     3494     end.
     3495     else do:
     3496       _trans:
     3497       do transaction:
     3498         repeat ii = 1 to num-entries(p-recid) :
     3499           run ref/extclas3.p ( input yes
     3500                               ,input integer(entry(ii, p-recid))) no-error .
     3501           if error-status:error then do:
     3502             message
     3503             error-status:get-message(1) skip
     3504             return-value
     3505             view-as alert-box error .
     3506             undo _trans, return error .
     3507           end.
     3508         end.
     3509       end.
     3510       p-recid = "" .
     3511       p-rid-list = "" .
     3512     end.
     3513     run openbr in this-procedure .
     3514     REPOSITION BROWSE-ext-goods to recid loc-doc-rec No-error.
     3515     if available buf_ext-classif then do:
     3516       loc#log = BROWSE-ext-goods:select-focused-row( ) IN FRAME Dialog-Frame.
     3517       loc#log = BROWSE-ext-goods:refresh() .
     3518     end.
     3519     APPLY "display" TO BROWSE-ext-goods.
     3520   end.
     3521   END PROCEDURE.
     3522   PROCEDURE proc-b-print :
     3523   define variable v-doc-rec as recid no-undo .
     3524   define variable accum-count as integer.
     3525   define variable date_string     as      character    no-undo.
     3526   define variable Line            as      character    no-undo.
     3527   define variable v-time-cr as character no-undo .
     3528   define variable v-time-up as character no-undo .
     3529   define variable v-st      as character no-undo .
     3530   DEFINE FRAME ext-list
     3531         Buf_goods.artic FORMAT "X(16)":U
     3532         Buf_goods.gds-code COLUMN-LABEL "Код" FORMAT ">>>>>>>>>9":U
     3533         Buf_goods.gds-name FORMAT "X(30)":U
     3534         Buf_ext-classif.Key#_One COLUMN-LABEL "Код EASYFUEL" FORMAT ">>>>>>>>9":U
     3535   HEADER  date_string AT 5 format "X(35)"
     3536    string( "Страница " ) format "X(9)" AT 115 PAGE-NUMBER(PrnLibStream) AT 125 FORMAT ">>9" SKIP
     3537   Line format "X(195)" AT 1
     3538   with width 232 down stream-io use-text    .
     3539   Line = fill("-", 195).
     3540   date_string = cur-time-print() .
     3541   run prn-lib-open-stream  in this-procedure (
     3542                                                input parParentProc
     3543                                               ,input 43
     3544                                               ,input yes
     3545                                               ,input no
     3546                                               ).
     3547   PUT  STREAM PrnLibStream
     3548   SPACE(25) ( frame Dialog-Frame:title )
     3549   format "x(90)" SKIP(1) .
     3550   FORM HEADER
     3551   Line format "X(195)" AT 1 SKIP
     3552   "Продолжение - на следующей странице" AT 30 SKIP
     3553   with FRAME BottomFrame width 232 PAGE-BOTTOM NO-LABELS NO-BOX .
     3554   VIEW  STREAM PrnLibStream FRAME BottomFrame .
     3555   FORM with FRAME ext-list  .
     3556   run waitfram-show in this-procedure ("Ждите...").
     3557   v-doc-rec = recid(buf_ext-classif).
     3558   DO WHILE available buf_ext-classif :
     3559     GET prev BROWSE-ext-goods.
     3560   END.
     3561   GET next BROWSE-ext-goods.
     3562   DO WHILE available buf_ext-classif :
     3563     Display STREAM PrnLibStream
     3564               Buf_goods.artic
     3565               Buf_goods.gds-code
     3566               Buf_goods.gds-name
     3567               Buf_ext-classif.Key#_One
     3568    with FRAME ext-list .
     3569     DOWN STREAM PrnLibStream 1
     3570     with FRAME ext-list  .
     3571     assign
     3572     accum-count = accum-count + 1
     3573     .
     3574     GET next BROWSE-ext-goods.
     3575   END.
     3576   UNDERLINE  STREAM PrnLibStream
     3577       Buf_goods.artic
     3578       Buf_goods.gds-code
     3579       Buf_goods.gds-name
     3580       Buf_ext-classif.Key#_One
     3581   with FRAME ext-list .
     3582   DISPLAY STREAM PrnLibStream
     3583   "ИТОГО"     @ Buf_goods.artic
     3584   accum-count @ Buf_goods.gds-name
     3585   with frame ext-list.
     3586   HIDE  STREAM PrnLibStream FRAME BottomFrame .
     3587   HIDE  STREAM PrnLibStream FRAME ext-list.
     3588   output  STREAM PrnLibStream CLOSE.
     3589   REPOSITION BROWSE-ext-goods to recid v-doc-rec no-error.
     3590   APPLY "display" to BROWSE-ext-goods.
     3591   run waitfram-hide in this-procedure .
     3592   run prn-lib-prn-file in this-procedure (
     3593                                             input parParentProc
     3594                                             ,input 8
     3595                                             ).
     3596   END PROCEDURE.
     3597   PROCEDURE proc-br :
     3598   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3599   if b-sel:sensitive in frame Dialog-Frame then dO:
     3600       if b-mark:sensitive then do:
     3601           apply "choose" to b-mark in frame Dialog-Frame.
     3602       end.
     3603       else do:
     3604           apply "choose" to b-sel in frame Dialog-Frame.
     3605       end.
     3606   end.
     3607   else do:
     3608       if b-lookup:sensitive then
     3609       apply "choose" to b-lookup in frame Dialog-Frame.
     3610   end.
     3611   END PROCEDURE.
     3612   PROCEDURE proc-find-artic :
     3613   define input parameter par-next as logical no-undo.
     3614   define input parameter pardoc-code as character no-undo.
     3615   define buffer buff_ext-classif for ub.ext-classif.
     3616   define variable doc-rec as recid no-undo.
     3617     doc-rec = ? .
     3618     find first  Buff_ext-classif no-lock where
     3619                 Buff_ext-classif.db-num = -1
     3620             and Buff_ext-classif.classif-subject   = 'goods':U
     3621             AND Buff_ext-classif.classif-name  = 'exp-easyfuel-talon-gds-code':U
     3622             and can-find(first  buf_goods no-lock where
     3623                                 buf_goods.gds-code =  int(entry(2,Buff_ext-classif.uniq-key-rec, chr(3))) and
     3624                                 buf_goods.artic = pardoc-code
     3625                                 )
     3626             no-error  .
     3627     if available Buff_ext-classif then
     3628     doc-rec = recid (Buff_ext-classif) .
     3629     reposition BROWSE-ext-goods to recid doc-rec no-error .
     3630     if not error-status :error then do:
     3631        apply "VALUE-CHANGED" to  BROWSE-ext-goods  in frame Dialog-Frame.
     3632     end.
     3633     else do:
     3634          message " Запись не найдена " view-as alert-box information .
     3635     end.
     3636   END PROCEDURE.
     3637   PROCEDURE proc-find-code :
     3638   define input parameter par-next as logical no-undo.
     3639   define input parameter pardoc-code as INTEGER no-undo.
     3640   define buffer buff_ext-classif for ub.ext-classif.
     3641   define variable doc-rec as recid no-undo.
     3642     doc-rec = ? .
     3643     find first  Buff_ext-classif no-lock where
     3644                 Buff_ext-classif.db-num = -1
     3645             and Buff_ext-classif.nonunique   = pardoc-code
     3646             and Buff_ext-classif.classif-subject   = 'goods':U
     3647             AND Buff_ext-classif.classif-name  = 'exp-easyfuel-talon-gds-code':U
     3648             and can-find(first  buf_goods no-lock where
     3649                                 buf_goods.gds-code =  int(entry(2,Buff_ext-classif.uniq-key-rec, chr(3))) and
     3650                                 buf_goods.gds-code = pardoc-code
     3651                                 )
     3652             no-error  .
     3653     if available Buff_ext-classif then
     3654     doc-rec = recid (Buff_ext-classif) .
     3655     reposition BROWSE-ext-goods to recid doc-rec no-error .
     3656     if not error-status :error then do:
     3657        apply "VALUE-CHANGED" to  BROWSE-ext-goods  in frame Dialog-Frame.
     3658     end.
     3659     else do:
     3660          message " Запись не найдена " view-as alert-box information .
     3661     end.
     3662   END PROCEDURE.
     3663   PROCEDURE proc-find-name :
     3664   define input parameter par-next as logical no-undo.
     3665   define input parameter pardoc-code as character no-undo .
     3666   define buffer buff_ext-classif for ub.ext-classif.
     3667   define variable doc-rec as recid no-undo.
     3668     doc-rec = ? .
     3669     find first  Buff_ext-classif no-lock where
     3670                 Buff_ext-classif.db-num = -1
     3671             and Buff_ext-classif.classif-subject   = 'goods':U
     3672             AND Buff_ext-classif.classif-name  = 'exp-easyfuel-talon-gds-code':U
     3673             and can-find(first  buf_goods no-lock where
     3674                                 buf_goods.gds-code = int (entry(2,Buff_ext-classif.uniq-key-rec, chr(3))) and
     3675                                 buf_goods.gds-name begins pardoc-code
     3676                                 )
     3677             no-error  .
     3678     if available Buff_ext-classif then
     3679     doc-rec = recid (Buff_ext-classif) .
     3680     reposition BROWSE-ext-goods to recid doc-rec no-error .
     3681     if not error-status :error then do:
     3682        apply "VALUE-CHANGED" to  BROWSE-ext-goods  in frame Dialog-Frame.
     3683     end.
     3684     else do:
     3685          message " Запись не найдена " view-as alert-box information .
     3686     end.
     3687   END PROCEDURE.
     3688   FUNCTION mark-string RETURNS CHARACTER
     3689   ( BUFFER loc-table FOR ub.ext-classif, input mark-list as CHARACTER ) :
     3690   RETURN ( IF LOOKUP( STRING( RECID( loc-table ) ), mark-list ) > 0 THEN "*" ELSE "":U ).
     3691   END FUNCTION.
