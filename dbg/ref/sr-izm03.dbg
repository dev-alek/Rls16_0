        1   BLOCK-LEVEL ON ERROR UNDO, THROW.
        2   define input parameter p-node-code             as integer no-undo .
        3   define variable vss-revision    as character no-undo init "$Revision$":U .
        4   define variable vss-author      as character no-undo init "$Author$":U .
        5   define variable vss-date        as character no-undo init "$Date$":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        7   define variable vss-archive     as character no-undo init "$Archive$":U .
        8   define variable vss-description as character no-undo init "Удаление средств измерения из базы данных".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   procedure placelib_write-attr:
       68   define input  parameter p-code     like ub.place-attr.attr-code .
       69   define input  parameter p-obj-code like ub.place-attr.obj-code .
       70   define input  parameter p-obj-type like ub.place-attr.obj-type .
       71   define input  parameter p-pl-code  like ub.place-attr.pl-code .
       72   define input  parameter p-value    like ub.place-attr.attr-value .
       73   define output parameter p-ok       as logical.
       74   define buffer buf_place-attr for ub.place-attr .
       75     do on error undo, return error return-value :
       76        p-ok = false.
       77        find first buf_place-attr exclusive-lock where buf_place-attr.attr-code   = p-code
       78                                                   and buf_place-attr.obj-code    = p-obj-code
       79                                                   and buf_place-attr.obj-type    = p-obj-type
       80                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
       81        if not available buf_place-attr then do :
       82           create buf_place-attr.
       83           assign
       84             buf_place-attr.attr-code   = p-code
       85             buf_place-attr.attr-value  = p-value
       86             buf_place-attr.obj-code    = p-obj-code
       87             buf_place-attr.obj-type    = p-obj-type
       88             buf_place-attr.pl-code     = p-pl-code
       89           .
       90           p-ok = true.
       91        end.
       92        else do:
       93           buf_place-attr.attr-value  = p-value .
       94           p-ok = true.
       95        end.
       96     end.
       97   end.
       98   procedure placelib_get-attr:
       99   define input  parameter  p-code     like ub.place-attr.attr-code .
      100   define input  parameter  p-obj-code like ub.place-attr.obj-code .
      101   define input  parameter  p-obj-type like ub.place-attr.obj-type .
      102   define input  parameter  p-pl-code  like ub.place-attr.pl-code .
      103   define output parameter  p-value    like ub.place-attr.attr-value .
      104   define output parameter  p-ok       as logical.
      105   define buffer buf_place-attr for ub.place-attr .
      106     do on error undo, return error return-value :
      107        p-ok = false.
      108        find first buf_place-attr no-lock where buf_place-attr.attr-code   = p-code
      109                                                   and buf_place-attr.obj-code    = p-obj-code
      110                                                   and buf_place-attr.obj-type    = p-obj-type
      111                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
      112        if available buf_place-attr then do :
      113          p-value = buf_place-attr.attr-value.
      114          p-ok = true.
      115        end.
      116        else do :
      117          p-ok = false.
      118        end.
      119     end.
      120   end.
      121   procedure placelib_del-attr:
      122   define input parameter  p-code     like ub.place-attr.attr-code .
      123   define input parameter  p-obj-code like ub.place-attr.obj-code .
      124   define input parameter  p-obj-type like ub.place-attr.obj-type .
      125   define input parameter  p-pl-code  like ub.place-attr.pl-code .
      126   define input parameter  p-value    like ub.place-attr.attr-value .
      127   define output parameter p-ok       as logical.
      128   define buffer buf_place-attr for ub.place-attr .
      129     do on error undo, return error return-value :
      130        p-ok = false.
      131        find first buf_place-attr exclusive-lock where buf_place-attr.attr-code   = p-code
      132                                                   and buf_place-attr.obj-code    = p-obj-code
      133                                                   and buf_place-attr.obj-type    = p-obj-type
      134                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
      135        if available buf_place-attr then do :
      136           delete buf_place-attr.
      137           p-ok = true.
      138        end.
      139     end.
      140   end.
      141   define variable v-s-node as character no-undo .
      142   define buffer buf_place-attr    for ub.place-attr .
      143   define buffer buf_doc-line-attr for ub.doc-line-attr .
      144   define buffer buf_sr-izmerenia  for ub.sr-izmerenia .
      145     v-s-node = string(p-node-code) .
      146     find first buf_place-attr no-lock
      147          where buf_place-attr.attr-code  = "place-SI"
      148            and buf_place-attr.attr-value = v-s-node no-error .
      149     if available buf_place-attr then do:
      150       undo, throw new Progress.Lang.AppError(
      151         substitute("&1 &2 &3&4Ошибка удаления. Средство измерения с ид.[&5] используется в резервуаре [&6] на объекте [&7 &8]"
      152                   , vss-workfile, vss-revision, vss-description, chr(10)
      153                   , v-s-node, buf_place-attr.pl-code, buf_place-attr.obj-type, buf_place-attr.obj-code
      154                   )
      155       ) .
      156     end.
      157     find first buf_doc-line-attr no-lock
      158          where buf_doc-line-attr.attr-code  = "place-SI"
      159            and buf_doc-line-attr.attr-value = v-s-node no-error .
      160     if available buf_doc-line-attr then do:
      161       undo, throw new Progress.Lang.AppError(
      162         substitute("&1 &2 &3&4Ошибка удаления. Средство измерения с ид.[&5] у товара [&6] в документе [&7]"
      163                   , vss-workfile, vss-revision, vss-description, chr(10)
      164                   , v-s-node, buf_doc-line-attr.gds-code, buf_doc-line-attr.doc-code
      165                   )
      166       ) .
      167     end.
      168     find first buf_sr-izmerenia exclusive-lock where buf_sr-izmerenia.node-code = p-node-code no-error no-wait .
      169     if locked(buf_sr-izmerenia) then do:
      170       undo, throw new Progress.Lang.AppError(
      171         substitute("&1 &2 &3&4Запись о средстве измерения с кодом [&5] занята другим пользователем",
      172                      vss-workfile, vss-revision, vss-description, chr(10),
      173                      p-node-code )
      174       ) .
      175     end .
      176     if not available buf_sr-izmerenia then do:
      177       undo, throw new Progress.Lang.AppError(
      178           substitute("&1 &2 &3&4Запись о средстве измерения с кодом [&5] отсутствует",
      179                      vss-workfile, vss-revision, vss-description, chr(10),
      180                      p-node-code )
      181       ) .
      182     end .
      183     delete buf_sr-izmerenia .
