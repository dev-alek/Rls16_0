     3190           .
     3191       end.
     3192     end.
     3193     if l-filter-open-23 = false then do:
     3194       OPEN QUERY br-delivtypecndk FOR EACH X_c-deliv-type-cond-keep
     3195         where  TRUE
     3196         indexed-reposition
     3197     .
     3198         assign
     3199           l-query-was-opened = true
     3200         .
     3201     end.
     3202   end.
     3203   else do:
