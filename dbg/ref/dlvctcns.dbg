     3075   PROCEDURE OpenBr :
     3076   define input  parameter p-open-query     as logical   no-undo .
     3077   define input  parameter p-find-next      as logical   no-undo .
     3078   define input  parameter p-find-condition as character no-undo .
     3079   define variable l-query-was-opened as logical no-undo .
     3080   define variable title0 as character no-undo.
     3081   title0 = "Список истории возможностей доставки по условиям хранения" + chr(32).
     3082   run waitfram-show in this-procedure ("Ждите...").
     3083   define variable sort-column-phrase as character no-undo .
     3084   case sort-column-name :
     3085     when "" then do:
     3086       assign
     3087         sort-column-phrase = ""
     3088       .
     3089     end.
     3090     otherwise do:
     3091       assign
     3092         sort-column-phrase = "by " + sort-column-name
     3093       .
     3094     end.
     3095   end case.
     3096   define variable l-open-query as logical   no-undo .
     3097     CASE p-mode :
     3098       WHEN 'все':U        THEN DO:
     3099        filter-point = filter-point0 + p-mode.
     3100   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3101   define variable  l-disable-where-23  as logical   no-undo .
     3102   define variable  l-filter-open-23    as logical   .
     3103   define variable  flt-rec-23       as recid     no-undo .
     3104   define variable  filter-name-23      as character no-undo .
     3105   define variable  where-phrase-23     as character no-undo .
     3106   define variable  sort-phrase-23      as character no-undo .
     3107   define variable  where-phrase-rus-23 as character no-undo .
     3108   define variable  sort-phrase-rus-23  as character no-undo .
     3109     run waitfram-show in this-procedure
     3110       (input "ЖДИТЕ ..."
     3111       ).
     3112   run gbl/flt-get.p
     3113     (input filter-point
     3114     ,output flt-rec-23
     3115     ,output filter-name-23
     3116     ,output where-phrase-23
     3117     ,output sort-phrase-23
     3118     ,output where-phrase-rus-23
     3119     ,output sort-phrase-rus-23
     3120     ).
     3121   if p-open-query then do:
     3122     assign
     3123       l-filter-open-23 = false
     3124     .
     3125     if flt-rec-23 <> ?
     3126       or sort-column-phrase > ""
     3127     then do:
     3128       define variable  parameter-2-23 as character no-undo .
     3129       define variable  parameter-3-23 as character no-undo .
     3130       define variable  parameter-4-23 as character no-undo .
     3131       define variable  parameter-5-23 as character no-undo .
     3132       define variable  parameter-6-23 as character no-undo .
     3133       define variable  parameter-7-23 as character no-undo .
     3134         assign
     3135         parameter-3-23 =
     3136                                 "FOR EACH X_c-deliv-type-cond-keep"
     3137         parameter-4-23 =
     3138           (
     3139             if (" TRUE " + " " + where-phrase-23) <> ""
     3140             then " TRUE " + " " + where-phrase-23
     3141             else "true"
     3142           )
     3143         parameter-5-23 = (" " + "" + " " + "")
     3144         parameter-6-23 = if sort-phrase-23 = ''
     3145                              then
     3146           (
     3147           " " + "  " +
     3148             " " + sort-column-phrase +
     3149           " " + "  "
     3150           )
     3151                              else
     3152           (
     3153           " " + "  " +
     3154             " " + sort-column-phrase +
     3155           " " + sort-phrase-23
     3156           )
     3157         parameter-7-23 =
     3158           " indexed-reposition  "
     3159       .
     3160       do
     3161       on stop undo, leave
     3162       on error undo, leave
     3163       :
     3164         assign
     3165           l-disable-where-23 =
     3166             (" TRUE " + " " + where-phrase-23 = "")
     3167         .
     3168         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     3169                             ,input QUERY br-delivtypecndk:handle
     3170                             ,input parameter-3-23
     3171                             ,input parameter-4-23
     3172                             ,input parameter-5-23
     3173                             ,input parameter-6-23
     3174                             ,input parameter-7-23
     3175                             )
     3176         .
     3177         assign
     3178           l-filter-open-23 = true
     3179         .
     3180       end.
     3181       if l-filter-open-23 = false then do:
     3182         message
     3183           "Ошибка при фильтрации / сортировке" skip
     3184           "Будут показаны записи без учета фильтра" skip
     3185           view-as alert-box .
     3186       end.
     3187       else do:
