     1053   FUNCTION get-all-fields returns character (p-file-name as character ):
     1054   define variable v-dop as character no-undo .
     1055     find first _file no-lock where _file._file-name = p-file-name no-error .
     1056     if not available _file then return "":U.
     1057     for each _field no-lock where
     1058              _field._file-recid = recid(_file) :
     1059       assign
     1060       v-dop = v-dop + _field._field-name + chr(44)
     1061       .
     1062     end.
     1063     return trim(v-dop).
     1064   END FUNCTION.
