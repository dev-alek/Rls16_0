     3209     on error undo, leave
     3210     :
     3211       if QUERY br-delivtypecndk:handle:get-buffer-handle(1) = (buffer X_c-deliv-type-cond-keep:handle) then do:
     3212         assign
     3213         parameter-2-23 = (if p-find-next then "true":u else "false":u )
     3214         parameter-4-23 =
     3215           "where ":u + " TRUE " + " ":u + where-phrase-23 + " ":u + p-find-condition + " " + ""
     3216         parameter-5-23 = "  "
     3217       .
     3218         run fltopend_fltfindd in this-procedure  (
     3219                             input this-procedure:handle
