     3756           assign
     3757             l-query-was-opened = true
     3758           .
     3759       end.
     3760     end.
     3761     if l-filter-open-29 = false then do:
     3762       OPEN QUERY br-delivtypecndk FOR EACH X_c-deliv-type-cond-keep
     3763         where          X_c-deliv-type-cond-keep.cond-keep-code  = p-cond-keep-code            AND X_c-deliv-type-cond-keep.deliv-type-code  = p-deliv-type-code
     3764         indexed-reposition
     3765     .
     3766         assign
     3767           l-query-was-opened = true
     3768         .
     3769     end.
     3770   end.
     3771   else do:
     3772     assign
     3773       v-doc-rec = recid( X_c-deliv-type-cond-keep )
     3774     .
     3775     do
     3776     on stop undo, leave
     3777     on error undo, leave
     3778     :
     3779       if QUERY br-delivtypecndk:handle:get-buffer-handle(1) = (buffer X_c-deliv-type-cond-keep:handle) then do:
     3780         assign
     3781         parameter-2-29 = (if p-find-next then "true":u else "false":u )
     3782         parameter-4-29 =
     3783           "where ":u +  substitute(' X_c-deliv-type-cond-keep.cond-keep-code  = &1            AND X_c-deliv-type-cond-keep.deliv-type-code  = &2 ', p-cond-keep-code, p-deliv-type-code )    + " ":u + where-phrase-29 + " ":u + p-find-condition + " " + ""
     3784         parameter-5-29 = "  "
     3785       .
     3786         run fltopend_fltfindd in this-procedure  (
     3787                             input this-procedure:handle
     3788                             ,input QUERY br-delivtypecndk:handle
     3789                             ,input rowid(X_c-deliv-type-cond-keep)
     3790                             ,input logical(parameter-2-29)
     3791                             ,input no-lock
     3792                             ,input (buffer X_c-deliv-type-cond-keep:handle)
     3793                             ,input parameter-4-29
     3794                             ,input parameter-5-29
     3795                             ) no-error.
     3796         .
     3797         assign
     3798           v-doc-rec = integer(return-value)
     3799           v-fltopend-rowid[1] = ?
     3800         .
     3801       end.
     3802       else do:
     3803         assign
     3804         parameter-2-29 = (if p-find-next then "true":u else "false":u )
     3805         parameter-3-29 =  "FOR EACH X_c-deliv-type-cond-keep"
     3806         parameter-4-29 =
     3807           (
     3808             if ("         X_c-deliv-type-cond-keep.cond-keep-code  = p-cond-keep-code            AND X_c-deliv-type-cond-keep.deliv-type-code  = p-deliv-type-code                        " + " " + where-phrase-29) <> ""
     3809             then  substitute(' X_c-deliv-type-cond-keep.cond-keep-code  = &1            AND X_c-deliv-type-cond-keep.deliv-type-code  = &2 ', p-cond-keep-code, p-deliv-type-code )    + " " + where-phrase-29
     3810             else "true"
     3811           )
     3812         parameter-5-29 = (" " + "" + " " + "" + " " + p-find-condition)
     3813         parameter-6-29 = if sort-phrase-29 = ''
     3814                              then
     3815           (
     3816           " " + "  " +
     3817             " " + sort-column-phrase +
     3818           " " + "  "
     3819           )
     3820                              else
     3821           (
     3822           " " + "  " +
     3823             " " + sort-column-phrase +
     3824           " " + sort-phrase-29
     3825           )
     3826         parameter-7-29 =
     3827           " indexed-reposition  "
     3828       .
     3829         run fltopend_fltfindq in this-procedure  (
     3830                             input this-procedure:handle
     3831                             ,input QUERY br-delivtypecndk:handle
     3832                             ,input logical(parameter-2-29)
     3833                             ,input no-lock
     3834                             ,input parameter-3-29
     3835                             ,input parameter-4-29
     3836                             ,input parameter-5-29
     3837                             ,input parameter-6-29
     3838                             ,input parameter-7-29
     3839                             ,output v-fltopend-rowid
     3840                             ) no-error.
     3841         .
     3842         v-doc-rec = ?.
     3843       end.
     3844       assign
     3845         l-query-was-opened = true
     3846       .
     3847     end.
     3848   end.
     3849     run waitfram-hide in this-procedure .
     3850     END.
     3851   END CASE.
     3852   if not p-open-query then
     3853   REPOSITION br-delivtypecndk to recid v-doc-rec No-ERROR.
     3854   if not p-open-query and v-fltopend-rowid[1] <> ? then
     3855   query br-delivtypecndk:handle:reposition-to-rowid(v-fltopend-rowid) No-ERROR.
     3856   run waitfram-hide in this-procedure.
     3857   APPLY "VALUE-CHANGED" TO br-delivtypecndk in frame Dialog-Frame.
     3858   APPLY "ENTRY" TO br-delivtypecndk.
     3859   END PROCEDURE.
     3860   PROCEDURE proc-br-delivtypecndk :
     3861   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3862   if b-sel:sensitive in frame Dialog-Frame then dO:
     3863       if b-mark:sensitive then do:
     3864           apply "choose" to b-mark in frame Dialog-Frame.
     3865       end.
     3866       else do:
     3867           apply "choose" to b-sel in frame Dialog-Frame.
     3868       end.
     3869   end.
     3870   else do:
     3871       if b-lookup:sensitive then
     3872       apply "choose" to b-lookup in frame Dialog-Frame.
     3873   end.
     3874   END PROCEDURE.
     3875   PROCEDURE proc-view-changes :
     3876   for each temp-changes:
     3877       delete temp-changes.
     3878   END.
     3879   if not available X_c-deliv-type-cond-keep then do:
     3880     Open QUery br-changes for each temp-changes.
     3881     return.
     3882   end.
     3883   define variable v-label-param as character no-undo .
     3884   v-label-param =
     3885     "des" + chr(4) + "Описание" + chr(4) + "" + chr(8)
     3886    + "deliv-type-code" + chr(4) + "Внутр.код типа доставки" + chr(4) + "" + chr(8)
     3887    + "cond-keep-code" + chr(4) + "Внутр.код условий хранения" + chr(4) + "" + chr(8)
     3888    + "sts" + chr(4) + "Статус" + chr(4) + ""  .
     3889    run proc-full-temp-changes in this-procedure (
     3890                                                input  buffer X_c-deliv-type-cond-keep:handle
     3891                                               ,input  'deliv-type-cond-keep':U
     3892                                               ,input  "des,deliv-type-code,cond-keep-code,sts"
     3893                                               ,input  v-label-param).
     3894   Open QUery br-changes for each temp-changes.
     3895   END PROCEDURE.
     3896   FUNCTION get-cndk RETURNS CHARACTER
     3897     ( INPUT p-cond-keep-code AS INTEGER) :
     3898   DEFINE BUFFER loc_condition-keeping FOR ub.condition-keeping.
     3899   FIND FIRST loc_condition-keeping NO-LOCK WHERE
     3900             loc_condition-keeping.cond-keep-code = p-cond-keep-code NO-ERROR.
     3901   IF AVAILABLE loc_condition-keeping THEN RETURN loc_condition-keeping.cond-keep-name.
     3902     RETURN "Неизв.условия хранения".
     3903   END FUNCTION.
     3904   FUNCTION get-type RETURNS CHARACTER
     3905   ( INPUT p-deliv-type-code AS INTEGER) :
     3906   DEFINE BUFFER loc_delivery-type FOR ub.delivery-type.
     3907   FIND FIRST loc_delivery-type NO-LOCK WHERE
     3908             loc_delivery-type.deliv-type-code = p-deliv-type-code NO-ERROR.
     3909   IF AVAILABLE loc_delivery-type THEN RETURN loc_delivery-type.deliv-type-name.
     3910     RETURN "Неизв.тип доставки".
     3911   END FUNCTION.
