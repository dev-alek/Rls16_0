     4048   .
     4049   Filter-Block:
     4050   DO ON STOP    UNDO Filter-Block, LEAVE Filter-Block
     4051     ON ERROR   UNDO Filter-Block, LEAVE Filter-Block
     4052     ON END-KEY UNDO Filter-Block, LEAVE Filter-Block :
     4053   run gbl/filter.w ( INPUT parparentproc
     4054                    , INPUT (filter-point + chr(4) + filter-label)
     4055                    , INPUT tbl
     4056                    , INPUT join-tbl
     4057                    , INPUT fld
     4058                    , INPUT lab
     4059                    , INPUT spr
     4060                    , INPUT dim ).
     4061   Run fill-table in this-procedure.
     4062   RUN OpenBr in this-procedure ( input  yes, input no, input '':U).
     4063   END.
     4064   END PROCEDURE.
     4065   PROCEDURE reposition-goods :
     4066   define input  parameter p-direction   as character no-undo .
     4067   define output parameter p-recid as recid no-undo .
     4068   DEFINE BUFFER buf_goods FOR ub.goods.
     4069     case p-direction :
     4070       when "first":U
     4071       then do:
     4072         get first br-pbc.
     4073       end.
     4074       when "last":U
     4075       then do:
     4076         get last br-pbc.
     4077       end.
     4078       when "prev":U
     4079       then do:
     4080         get prev br-pbc.
     4081         if not available temp-goods then do:
     4082           message
     4083           "Это первый товар списка"
     4084           view-as alert-box.
     4085         end.
     4086       end.
     4087       when "next":U
     4088       then do:
     4089         get next BR-pbc.
     4090         if not available temp-goods then do:
     4091           message
     4092           "Это последний товар списка"
     4093           view-as alert-box.
     4094         end.
     4095       end.
     4096     end case .
     4097       find first buf_goods No-LOCK WHERE
     4098                    buf_goods.gds-code = temp-goods.gds-code no-error.
     4099       if not avail buf_goods then do:
     4100          p-recid = ?.
     4101       END.
     4102     assign
     4103     p-recid = recid(buf_goods)
     4104     .
     4105     run reposition-query in this-procedure
     4106       (input recid(temp-goods)
     4107       ).
     4108   END PROCEDURE.
     4109   PROCEDURE reposition-query :
     4110   define input parameter p-recid as recid no-undo .
     4111   if p-recid <> ?
     4112   then do:
     4113     reposition BR-pbc to recid p-recid no-error.
     4114   end.
     4115   do with frame Dialog-Frame:
     4116     apply "entry":u to browse BR-pbc .
     4117     apply "VALUE-CHANGED":u to browse BR-pbc .
     4118   end.
     4119   END PROCEDURE.
     4120   PROCEDURE sel-cur-obj :
     4121     define variable s-t as char no-undo.
     4122     define variable s-c as integer no-undo.
     4123     define variable v-user-select as logical   no-undo .
     4124     define variable v-obj-type    as character no-undo .
     4125     define variable v-obj-code    as integer   no-undo .
     4126     assign
     4127       s-t = varobj-type
     4128       s-c = varobj-code
     4129     .
     4130   define variable vss-include-info34 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4131   run userobjs_select-one in this-procedure
     4132     (input  parparentproc
     4133     ,input  v-cntxt-db-num
     4134     ,input  v-cntxt-userid
     4135     ,input  parhost-code
     4136     ,input  parobj-type
     4137     ,input  parobj-code
     4138     ,output v-user-select
     4139     ,output v-obj-type
     4140     ,output v-obj-code
     4141     )  .
     4142     if v-user-select = true
     4143     then do:
     4144       run obj-on in this-procedure
     4145         (input v-obj-type
     4146         ,input v-obj-code
     4147         ) no-error.
     4148       if error-status:error then do:
     4149         run obj-on (s-t, s-c) no-error.
     4150         if error-status:error
     4151         then do:
     4152           return error.
     4153         end.
     4154       end.
     4155     end.
     4156   END PROCEDURE.
     4157   FUNCTION get-price RETURNS DECIMAL
     4158     ( input parobj-type as character, input parobj-code as integer, parb-code as integer ) :
     4159   define variable v-doc-num like ub.price-doc.doc-num no-undo.
     4160   define variable v-price-sale like ub.price-list.price-sale no-undo.
     4161   define variable v-road-tax like ub.price-list.road-tax no-undo.
     4162   define variable v-excise like ub.price-list.excise no-undo.
     4163   define variable vss-include-info35 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4164   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     4165     (input  parobj-type
     4166     ,input  parobj-code
     4167     ,input  parb-code
     4168     ,input  0
     4169     ,input  0
     4170     ,output v-doc-num
     4171     ,output v-price-sale
     4172     ,output v-road-tax
     4173     ,output v-excise
     4174     ) no-error .
     4175       return v-price-sale.
     4176   END FUNCTION.
