     4026   run fltfield-add in this-procedure('gds-type', 'Услуга-товар', '',
     4027   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4028   run fltfield-add in this-procedure('tnved', 'Код ТНВЭД', '',
     4029   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
