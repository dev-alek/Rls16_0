     3895   temp-goods.prod-type COLUMn-LABEL "":U
     3896   temp-goods.prod-code COLUMN-LABEL "Пр-ль"
     3897   prod_clients.obj-name COLUMN-LABEL "Название произв-ля" format "X(20)"
     3898   HEADER  date_string AT 5 format "X(35)"
     3899   v-header-base-curr        format "X(20)"
     3900   string( "Страница " ) format "X(9)" AT 115 PAGE-NUMBER(Prnlibstream) AT 125 FORMAT ">>9" SKIP
     3901   Line format "X(195)" AT 1
     3902   with width 232 down stream-io use-text    .
     3903   if not available temp-goods then do:
     3904       return.
     3905   end.
     3906   var-rec = recid(temp-goods).
     3907   Line = fill("-", 195).
     3908   date_string = cur-time-print() .
     3909   run prn-lib-open-stream  in this-procedure (
     3910                                                input parParentProc
     3911                                               ,input 43
     3912                                               ,input yes
     3913                                               ,input no
     3914                                               ).
     3915   PUT  STREAM Prnlibstream
     3916   SPACE(25) ( frame Dialog-Frame:title )
     3917   format "x(90)" SKIP(1) .
     3918   FORM HEADER
     3919   Line format "X(195)" AT 1 SKIP
     3920   "Продолжение - на следующей странице" AT 30 SKIP
     3921   with FRAME BottomFrame width 232 PAGE-BOTTOM NO-LABELS NO-BOX .
     3922   VIEW  STREAM Prnlibstream FRAME BottomFrame .
     3923   FORM with FRAME locsslist  .
     3924   run waitfram-show in this-procedure ("Ждите...").
     3925   DO WHILE available temp-goods :
     3926     GET prev br-pbc.
     3927   END.
     3928   GET next br-pbc.
     3929    DO WHILE available temp-goods :
     3930           FIND prod_clients NO-LOCK WHERE
     3931                   prod_clients.obj-type = temp-goods.prod-type AND
     3932                   prod_clients.obj-code = temp-goods.prod-code NO-ERROR.
     3933     Display STREAM Prnlibstream
     3934     temp-goods.gds-code
     3935       temp-goods.artic
     3936       temp-goods.gds-name FORMAT "X(20)"
     3937       temp-scaleable.b-str
     3938       temp-scaleable.is-global
     3939       temp-scaleable.unit-cli
     3940       temp-goods.prod-type
     3941       temp-goods.prod-code
     3942       (if avail prod_clients then prod_clients.obj-name else "":U ) @ prod_clients.obj-name
     3943       temp-scaleable.price-sale
     3944     with FRAME locssList .
     3945     DOWN STREAM Prnlibstream 1
     3946     with FRAME locsslist  .
     3947     assign
     3948     accum-count = accum-count + 1
     3949       .
     3950     GET next br-pbc.
     3951     END.
     3952     UNDERLINE  STREAM Prnlibstream
     3953       temp-goods.gds-code
     3954       temp-goods.artic
     3955       temp-goods.gds-name FORMAT "X(20)"
     3956       temp-scaleable.b-str
     3957       temp-scaleable.is-global
     3958           temp-scaleable.unit-cli
     3959       temp-goods.prod-type
     3960       temp-goods.prod-code
     3961       prod_clients.obj-name
     3962       temp-scaleable.price-sale
     3963     with FRAME locsslist .
     3964     DISPLAY STREAM Prnlibstream
     3965     ("ИТОГО" + chr(32) + string(accum-count))  @ temp-goods.gds-name
     3966     with frame locsslist.
     3967   HIDE  STREAM Prnlibstream FRAME BottomFrame .
     3968   HIDE  STREAM Prnlibstream FRAME locssList.
     3969   output  STREAM Prnlibstream CLOSE.
     3970   REPOSITION br-pbc to recid var-rec.
     3971   APPLY "ENTRY" to br-pbc.
     3972   run waitfram-hide in this-procedure .
     3973   run prn-lib-prn-file in this-procedure (
     3974                                             input parParentProc
     3975                                             ,input 8
     3976                                             ).
     3977   END PROCEDURE.
