     3320       define variable  parameter-4-27 as character no-undo .
     3321       define variable  parameter-5-27 as character no-undo .
     3322       define variable  parameter-6-27 as character no-undo .
     3323       define variable  parameter-7-27 as character no-undo .
     3324         assign
     3325         parameter-3-27 =
