      827   procedure prn-lib-reportviewer :
      828     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      829     define input parameter p-report-name-html as character no-undo .
      830     define input parameter p-param        as character no-undo .
      831     define variable v-excel           as character no-undo init 'TRUE' .
      832     define variable v-value-character as character no-undo .
      833     define variable v-value-integer   as character no-undo .
      834     define variable v-value-date      as date      no-undo .
      835     define variable v-value-decimal   as decimal   no-undo .
      836     define variable rep-excel         as logical   no-undo .
      837     define variable excel-string      as character no-undo .
      838     define variable v-param-type      as character no-undo .
      839     define variable v-tth             as handle    no-undo .
      840     run adm/shattri.p (
      841       input "get":U
      842       ,input  ""
      843       ,input  0
      844       ,input  'report-glob':U
      845       ,input  'rep-excel':U
      846       ,output v-value-character
      847       ,output v-value-date
      848       ,output v-value-decimal
      849       ,output v-value-integer
      850       ,output rep-excel
      851       ,output v-param-type
      852       ,INPUT-OUTPUT table-handle v-tth
      853       )  .
      854     if rep-excel then v-excel = "TRUE" .
