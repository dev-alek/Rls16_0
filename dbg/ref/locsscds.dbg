      908   procedure userobjs_append :
      909      define input  parameter p-obj-type as character no-undo .
      910      define input  parameter p-obj-code as integer   no-undo .
      911     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      912     do
      913     on error undo, return error return-value
      914     :
      915       find first buf_userobjs_temp-user-obj
      916         where buf_userobjs_temp-user-obj.obj-type = p-obj-type
      917           and buf_userobjs_temp-user-obj.obj-code = p-obj-code
      918         no-error .
      919       if not available buf_userobjs_temp-user-obj
      920       then do:
      921         create buf_userobjs_temp-user-obj .
      922         assign
      923           buf_userobjs_temp-user-obj.obj-type = p-obj-type
      924           buf_userobjs_temp-user-obj.obj-code = p-obj-code
      925         .
      926       end.
      927     end.
