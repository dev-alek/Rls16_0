     1067   define variable v-fltopend-rowid as rowid extent 18 no-undo .
     1068   procedure fltopend_fltopend :
     1069   define input parameter p-parent-handle as handle no-undo .
     1070   define input parameter p-qh as handle no-undo .
     1071   define input parameter p-flt-open-open-query  as character no-undo .
     1072   define input parameter p-where-cond as character no-undo .
     1073   define input parameter p-use-indFIRST-query-tail as character no-undo .
     1074   define input parameter p-use-ind-sort-clmn-by as character no-undo .
     1075   define input parameter p-indexed-reposition as character no-undo .
     1076     do
     1077     on error undo, return error
     1078     :
     1079   define variable v-prepare-string as character no-undo .
     1080   define variable glog as logical no-undo .
     1081   assign
     1082   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     1083                      p-where-cond + chr(32)  +
     1084                      p-use-indFIRST-query-tail + chr(32) +
     1085                      p-use-ind-sort-clmn-by + chr(32) +
     1086                      p-indexed-reposition
     1087   .
     1088   assign
     1089   glog = p-qh:query-prepare(v-prepare-string) no-error .
     1090   if not glog
     1091   or error-status:error then do:
     1092     message error-status:get-message(1) view-as alert-box .
     1093     undo, return error .
     1094   end.
     1095   assign
     1096   glog = p-qh:query-open no-error .
     1097   if not glog
     1098   or error-status:error then do:
     1099     message error-status:get-message(1) view-as alert-box .
     1100     undo, return error .
     1101   end.
     1102     end.
     1103   end procedure.
     1104   procedure fltopend_fltfindd :
     1105   define input parameter p-parent-handle as handle no-undo .
     1106   define input parameter p-qh as handle no-undo .
     1107   define input parameter p-rowid as rowid no-undo .
     1108   define input parameter p-next as logical no-undo .
     1109   define input parameter p-lock as integer no-undo .
     1110   define input parameter p-bh as handle no-undo .
     1111   define input parameter p-where-cond as character no-undo .
     1112   define input parameter p-use-index-phrase as character no-undo .
     1113   define variable glog as logical no-undo .
     1114   define variable v-qh as handle no-undo .
     1115   define variable v-bh as handle no-undo .
     1116   define variable v-recid as recid no-undo .
     1117   define variable v-prepare-string as character no-undo .
     1118   do
     1119   on error undo, return error
     1120   on stop undo, return error
     1121   :
     1122     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
     1123     create buffer v-bh for table p-bh buffer-name p-bh:name.
     1124     create query v-qh.
     1125     v-qh:set-buffers(v-bh).
     1126     v-prepare-string = substitute("for each &1 &2 &3"
     1127                                     ,v-bh:name
     1128                                     ,p-where-cond
     1129                                     ,p-use-index-phrase).
     1130     glog = v-qh:query-prepare(v-prepare-string) no-error.
     1131     if not glog then do:
     1132       delete object v-qh.
     1133       delete object v-bh.
     1134       undo, return error .
     1135     end.
     1136     glog = v-qh:query-open no-error .
     1137     if not glog then do:
     1138       delete object v-qh.
     1139       delete object v-bh.
     1140       undo, return error .
     1141     end.
     1142     if p-next then do:
     1143       v-qh:reposition-to-rowid(p-rowid) no-error .
     1144       glog = v-qh:get-next( p-lock) no-error .
     1145       glog = v-qh:get-next( p-lock) no-error .
     1146       if not glog or v-qh:query-off-end = yes then do:
     1147         glog = v-qh:get-first( p-lock) no-error .
     1148       end.
     1149     end.
     1150     else do:
     1151       glog = v-qh:get-first( p-lock) no-error .
     1152     end.
     1153     v-recid = v-bh:recid no-error .
     1154     delete object v-qh.
     1155     delete object v-bh.
     1156     return string(v-recid) .
     1157   end.
     1158   end procedure.
     1159   procedure fltopend_fltfindq :
     1160   define input parameter p-parent-handle as handle no-undo .
     1161   define input parameter p-qh as handle no-undo .
     1162   define input parameter p-next as logical no-undo .
     1163   define input parameter p-lock as integer no-undo .
     1164   define input parameter p-flt-open-open-query  as character no-undo .
     1165   define input parameter p-where-cond as character no-undo .
     1166   define input parameter p-use-indFIRST-query-tail as character no-undo .
     1167   define input parameter p-use-ind-sort-clmn-by as character no-undo .
     1168   define input parameter p-indexed-reposition as character no-undo .
     1169   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
     1170   define variable glog as logical no-undo .
     1171   define variable v-qh as handle no-undo .
     1172   define variable v-bh as handle no-undo extent 18.
     1173   define variable v-rowid as rowid no-undo extent 18.
     1174   define variable v-ii as integer no-undo .
     1175   define variable v-prepare-string as character no-undo .
     1176   do
     1177   on error undo, return error
     1178   on stop undo, return error
     1179   :
     1180     create query v-qh.
     1181     do v-ii = 1 to p-qh:num-buffers:
     1182       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
     1183       assign
     1184       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
     1185       no-error.
     1186       v-qh:add-buffer(v-bh[v-ii]).
     1187     end.
     1188     assign
     1189     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     1190                       p-where-cond + chr(32)  +
     1191                       p-use-indFIRST-query-tail + chr(32) +
     1192                       p-use-ind-sort-clmn-by + chr(32) +
     1193                       p-indexed-reposition
     1194     .
     1195     glog = v-qh:query-prepare( v-prepare-string) no-error .
     1196     if not glog then do:
     1197       delete object v-qh.
     1198       do v-ii = 1 to p-qh:num-buffers:
     1199         delete object v-bh[v-ii].
     1200       end.
     1201       undo, return error .
     1202     end.
     1203     glog = v-qh:query-open no-error .
     1204     if not glog then do:
     1205       delete object v-qh.
     1206       do v-ii = 1 to p-qh:num-buffers:
     1207         delete object v-bh[v-ii].
     1208       end.
     1209       undo, return error .
     1210     end.
     1211     if p-next then do:
     1212       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
     1213       glog = v-qh:get-next( p-lock) no-error .
     1214       glog = v-qh:get-next( p-lock) no-error .
     1215       if not glog or v-qh:query-off-end = yes then do:
     1216         glog = v-qh:get-first( p-lock) no-error .
     1217       end.
     1218     end.
     1219     else do:
     1220       glog = v-qh:get-first( p-lock) no-error .
     1221     end.
     1222     do v-ii = 1 to p-qh:num-buffers:
     1223       assign
     1224       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
     1225       no-error.
     1226     end.
     1227     delete object v-qh.
     1228     do v-ii = 1 to p-qh:num-buffers:
     1229       delete object v-bh[v-ii].
     1230     end.
     1231   end.
     1232   end procedure.
     1233   DEFINE VARIABLE varempty-code like ub.gds-prt.node-code no-undo .
     1234   DEFINE VARIABLE filter-point as character no-undo init "locsscds" .
     1235   DEFINE VARIABLE filter-point0 as character no-undo init "locsscds" .
     1236   DEFINE VARIABLE filter-label as character no-undo init "Взвешивамые коды" .
     1237   DEFINE VARIABLE filter-label0 as character no-undo init "Взвешивамые коды" .
     1238   define variable v-rid-list as character no-undo .
     1239   DEFINE VARIABLE sort-column-name as character no-undo .
     1240   DEFINE VARIABLE varhost-code like ub.sysconf.host-code no-undo.
     1241   define variable gds-rec as recid no-undo .
     1242   define variable v-doc-rec as recid no-undo .
