     1274        LABEL "Вы&бор"
     1275        SIZE 10 BY 1.
     1276   DEFINE BUTTON r-obj
     1277        IMAGE-UP FILE "btn-down-arrow":U
     1278        IMAGE-DOWN FILE "btn-down-arrow":U
     1279        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
     1280        LABEL "Btn 3"
     1281        SIZE 3 BY .87 TOOLTIP "Выбор объекта".
     1282   DEFINE VARIABLE mark-num AS CHARACTER FORMAT "X(256)":U
     1283         VIEW-AS TEXT
     1284        SIZE 6 BY 1
     1285        FGCOLOR 4  NO-UNDO.
     1286   DEFINE VARIABLE var-prod AS CHARACTER FORMAT "X(12)":U
     1287         VIEW-AS TEXT
     1288        SIZE 8.9 BY .67 NO-UNDO.
     1289   DEFINE VARIABLE var-prod-name AS CHARACTER FORMAT "X(256)":U
     1290         VIEW-AS TEXT
     1291        SIZE 41.1 BY .67 NO-UNDO.
     1292   DEFINE VARIABLE varobj-code AS INTEGER FORMAT ">>>>9":U INITIAL 0
     1293         VIEW-AS TEXT
     1294        SIZE 8.9 BY .67
     1295        FGCOLOR 4  NO-UNDO.
     1296   DEFINE VARIABLE varobj-type AS CHARACTER FORMAT "X(3)":U
     1297        LABEL "Объект"
     1298         VIEW-AS TEXT
     1299        SIZE 5.4 BY .67
     1300        FGCOLOR 4  NO-UNDO.
     1301   DEFINE VARIABLE Rs-sort AS INTEGER INITIAL 1
     1302        VIEW-AS RADIO-SET HORIZONTAL
     1303        RADIO-BUTTONS
     1304             "Код товара", 1,
     1305   "Взвешиваемый код", 2,
     1306   "Название товара", 3,
     1307   "Артикул", 4
     1308        SIZE 61.9 BY .97 NO-UNDO.
     1309   DEFINE VARIABLE T-object AS LOGICAL INITIAL no
     1310        LABEL "Объект"
     1311        VIEW-AS TOGGLE-BOX
     1312        SIZE 20.6 BY 1 NO-UNDO.
     1313   DEFINE QUERY BR-pbc FOR  temp-goods ,temp-scaleable SCROLLING.
     1314   DEFINE BROWSE BR-pbc
     1315     QUERY BR-pbc NO-LOCK DISPLAY
     1316         mark-string( temp-scaleable.prod-bc-rec, v-rid-list ) COLUMN-LABEL "*" FORMAT "X(1)"
     1317         temp-goods.gds-code
     1318         temp-scaleable.b-str FORMAT "X(10)" COLUMN-LABEL "Доп.БК"
     1319         temp-scaleable.is-global FORMAT "+/" COLUMN-LABEL "Глоб"
     1320         temp-scaleable.unit-cli COLUMn-LABEL "Ед!изм"
     1321         temp-goods.gds-name
     1322         temp-scaleable.price-sale COLUMN-LABEL "Цена на объекте" FORMAT ">>>,>>>,>>9.99"
     1323         temp-goods.artic
     1324       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 18.97.
     1325   DEFINE FRAME Dialog-Frame
     1326        b-quit AT ROW 1 COL 1
     1327        B-mark AT ROW 1 COL 11
     1328        B-sel AT ROW 1 COL 20
     1329        B-add AT ROW 1 COL 30
     1330        B-del AT ROW 1 COL 40
     1331        B-gds AT ROW 1 COL 50
     1332        B-sch AT ROW 1 COL 89
     1333        B-print AT ROW 1 COL 92
     1334        B-Help AT ROW 1 COL 95
     1335        Rs-sort AT ROW 2.2 COL 14.6 NO-LABEL
     1336        T-object AT ROW 2.27 COL 78
     1337        r-obj AT ROW 3.67 COL 93.8
     1338        BR-pbc AT ROW 4.63 COL 1
     1339        mark-num AT ROW 1 COL 12 COLON-ALIGNED NO-LABEL
     1340        varobj-code AT ROW 3.67 COL 81.9 COLON-ALIGNED NO-LABEL
     1341        var-prod AT ROW 3.77 COL 16.1 NO-LABEL
     1342        var-prod-name AT ROW 3.77 COL 26 NO-LABEL
     1343        varobj-type AT ROW 3.77 COL 75.1 COLON-ALIGNED
     1344        "Производитель:" VIEW-AS TEXT
     1345             SIZE 15.3 BY .77 AT ROW 3.67 COL 1
     1346             FGCOLOR 1
     1347        "Сортировка:" VIEW-AS TEXT
     1348             SIZE 12.1 BY 1 AT ROW 2.2 COL 1.8
     1349             FGCOLOR 4
     1350        SPACE(85.10) SKIP(20.40)
     1351       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1352            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1353            TITLE "Взвешиваемые товары/ДОПБК"
     1354            CANCEL-BUTTON b-quit.
     1355   ASSIGN
     1356          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1357          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1358   ON GO OF FRAME Dialog-Frame
     1359   DO:
     1360     p-rid-list = v-rid-list.
     1361   END.
     1362   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1363   DO:
     1364     APPLY "END-ERROR":U TO SELF.
     1365   END.
     1366   ON CHOOSE OF B-add IN FRAME Dialog-Frame
     1367   DO:
     1368    DEFINE VARIABLE loc-rid-list as character no-undo .
     1369     run ref/gds-ref.p ( parparentproc
     1370                    ,"b-sel,b-mark,b-add"
     1371                    ,?
     1372                    ,?
     1373                    ,?
     1374                    ,?
     1375                    ,?
     1376                    ,?
     1377                    ,?
     1378                    ,parobj-type
     1379                    ,parobj-code
     1380                    ,?
     1381                    , output loc-rid-list).
     1382     Run fill-table in this-procedure.
     1383     RUn openbr in this-procedure ( input yes, input no, input '':U).
     1384     APPLY "Value-changed" to br-pbc.
     1385     APPLY "entry" to br-pbc.
     1386   END.
     1387   ON CHOOSE OF B-del IN FRAME Dialog-Frame
     1388   DO:
     1389    define variable glog as logical no-undo .
     1390     define buffer buf_temp-scaleable for temp-scaleable.
     1391   define variable vss-include-info13 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1392   do:
     1393     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1394       (input  v-cntxt-db-num
     1395       ,input  v-cntxt-userid
     1396       ,input  0
     1397       ,input  'actn_alt-barcode_preparation':U
     1398       ,input  'global':U
     1399       ,input  0
     1400       ,input  '':U
     1401       ,input  0
     1402       ,input  0
     1403       ,input  temp-goods.grp-code
     1404       ,input  0
     1405       ,input  true
     1406       ,output glog
     1407       )  .
     1408   end.
     1409   if not glog then return no-apply.
     1410    message
     1411    "Вы действительно хотите удалить взвешимаемый код" temp-scaleable.b-str SKIP
     1412    "для товара" temp-goods.artic temp-goods.prod-type temp-goods.prod-code
     1413    view-as alert-box QUESTION buttons YES-NO update glog.
     1414    if not glog then return no-apply.
     1415       find first ub.prod-bc exclusive-lock where
     1416                   recid(ub.prod-bc) = temp-scaleable.prod-bc-rec No-wait No-error.
     1417        if not avail ub.prod-bc then do:
     1418           message "К сожалению в настоящий момент запись не доступна"
     1419           view-as alert-box ERROR.
     1420           return no-apply.
     1421        end.
     1422   del-bc1:
     1423   do on stop undo del-bc1, return no-apply on error undo del-bc1, return no-apply:
     1424     if prod-bc.bc-on AND send-ref then
     1425           run str/diallog.w ( parparentproc
     1426                       , this-procedure
     1427                       , 'str/s-prodbc.p':U
     1428                       , string(recid(prod-bc)) + chr(4) + "D":U
     1429                       , yes
     1430                       , '':U
     1431                       , 'Удаление ДопБК с кассы') .
     1432       delete prod-bc.
     1433       delete temp-scaleable.
     1434       find first buf_temp-scaleable no-lock where buf_temp-scaleable.b-code = temp-goods.gds-code no-error.
     1435       if not avail buf_temp-scaleable then delete temp-goods.
     1436     end.
     1437     RUn openbr in this-procedure ( input yes, input no, input '':U).
     1438     APPLY "Value-changed" to br-pbc.
     1439     APPLY "entry" to br-pbc.
     1440   END.
     1441   ON CHOOSE OF B-gds IN FRAME Dialog-Frame
     1442   DO:
     1443    define variable v-gds-rec as recid no-undo .
     1444     if available temp-goods then do:
     1445       find first ub.goods No-LOCK WHERE
     1446                    ub.goods.gds-code = temp-goods.gds-code no-error.
     1447       if not avail ub.goods then return no-apply.
     1448       v-gds-rec = recid(goods).
     1449       run ref/gds-form.w ( input parparentproc
     1450                       ,input 'ПРОСМОТР':U
     1451                       ,input parobj-type
     1452                       ,input parobj-code
     1453                       ,input this-procedure:handle
     1454                       ,input-output v-gds-rec
     1455                       ).
     1456       apply "entry" to br-pbc in frame Dialog-Frame.
     1457     end.
     1458   END.
     1459   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
     1460   DO:
     1461   define variable v-num-entry as integer no-undo .
     1462   define variable glog as logical no-undo .
     1463     if available temp-scaleable then do:
     1464       assign
     1465         v-num-entry = lookup(string( temp-scaleable.prod-bc-rec), v-rid-list ).
     1466       if v-num-entry > 0 then do:
     1467         assign
     1468           entry(v-num-entry, v-rid-list) = "":U
     1469           v-rid-list = replace( v-rid-list, chr(44) + chr(44), chr(44)) .
     1470       end.
     1471       else do:
     1472         assign
     1473           v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + string( temp-scaleable.prod-bc-rec ) .
     1474       end.
     1475       glog = br-pbc:refresh() .
     1476       if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
     1477           glog = br-pbc:select-next-row ().
     1478           apply "Value-changed" to br-pbc in frame Dialog-Frame.
     1479       end.
     1480       if num-entries( v-rid-list ) = 0
     1481       then
     1482           hide mark-num in frame Dialog-Frame.
     1483       else
     1484           disp num-entries( v-rid-list ) @ mark-num with frame Dialog-Frame.
     1485     end.
     1486     apply "entry" to br-pbc in frame Dialog-Frame.
     1487   END.
     1488   ON CHOOSE OF B-print IN FRAME Dialog-Frame
     1489   DO:
     1490     run proc-b-print in this-procedure no-error.
     1491     if error-status:error then return no-apply.
     1492   END.
     1493   ON CHOOSE OF B-sch IN FRAME Dialog-Frame
     1494   DO:
     1495   run proc-b-sch no-error.
     1496   if error-status:error then return no-apply.
     1497   END.
     1498   ON CHOOSE OF B-sel IN FRAME Dialog-Frame
     1499   DO:
     1500         if ( available temp-scaleable ) AND ( v-rid-list = "" ) then
     1501       v-rid-list = string( temp-scaleable.prod-bc-rec  ) .
     1502   END.
     1503   ON VALUE-CHANGED OF BR-pbc IN FRAME Dialog-Frame
     1504   DO:
     1505     if available temp-goods then do:
     1506       var-prod = temp-goods.prod-type + string(temp-goods.prod-code).
     1507       find first ub.clients no-lock where
     1508                    ub.clients.obj-type = temp-goods.prod-type and
     1509                    ub.clients.obj-code = temp-goods.prod-code no-error.
     1510       if available ub.clients then do:
     1511           assign
     1512           var-prod-name = ub.clients.obj-name.
     1513       end.
     1514       else do:
     1515           var-prod-name = "":U.
     1516       end.
     1517     end.
     1518     else do:
     1519       assign
     1520       var-prod = "":U
     1521       var-prod-name = "":U.
     1522     end.
     1523     display
     1524     var-prod
     1525     var-prod-name
     1526     with frame Dialog-Frame
     1527     .
     1528   END.
     1529   ON CHOOSE OF r-obj IN FRAME Dialog-Frame
     1530   DO:
     1531     run sel-cur-obj  in this-procedure no-error.
     1532     if error-status:error then return no-apply.
     1533   END.
     1534   ON VALUE-CHANGED OF Rs-sort IN FRAME Dialog-Frame
     1535   DO:
     1536     assign
     1537     rs-sort.
     1538     assign
     1539     par-mode = string(rs-sort).
     1540      RUn openbr in this-procedure ( input yes, input no, input '':U).
     1541   END.
     1542   ON VALUE-CHANGED OF T-object IN FRAME Dialog-Frame
     1543   DO:
     1544      assign
     1545     T-object.
     1546     run MyEnable.
     1547   END.
     1548   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1549   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1550   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1551   on help of frame Dialog-Frame
     1552   do:
     1553     run gbl/app_help.p
     1554       (input this-procedure :file-name
     1555       ,input ''
     1556       ,input ?
     1557       ) no-error.
     1558     if error-status :error then do:
     1559       message
     1560         "Ошибка при вызове помощи"
     1561         error-status :get-message(1)
     1562         view-as alert-box .
     1563     end.
     1564   end.
     1565   run minbtn-set in this-procedure .
     1566   on choose of b-help in frame Dialog-Frame
     1567   do:
     1568     apply "help":u to frame Dialog-Frame .
     1569   end.
     1570   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1571   procedure minbtn-set :
     1572       do
     1573           on error undo, return error return-value
     1574           :
     1575           define variable ii              as integer       no-undo .
     1576           define variable fh              as widget-handle no-undo .
     1577           define variable hh              as widget-handle no-undo .
     1578           define variable v-h             as handle        extent 4 no-undo .
     1579           define variable v-name-button   as character     no-undo .
     1580           define variable v-help-old-x    as decimal       no-undo .
     1581           define variable v-help-old-y    as decimal       no-undo .
     1582           define variable v-help-old-size as decimal       no-undo .
     1583           define variable v-frame-width   as decimal       no-undo .
     1584           define variable jj              as integer       no-undo .
     1585           do
     1586               on error undo, return error
     1587               :
     1588               assign
     1589                   v-frame-width = frame Dialog-Frame:width - 0.3
     1590                   fh            = frame Dialog-Frame:first-child
     1591                   hh            = fh:first-child
     1592                   ii            = 1
     1593                   .
     1594               do while valid-handle(hh):
     1595                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1596                   do:
     1597                       case lc(hh:name) :
     1598                           when "b-help" then
     1599                               do:
     1600                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1601                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1602                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1603                                   hh:TOOLTIP = "Помощь" .
     1604                                   v-help-old-x = hh:column .
     1605                                   v-help-old-y = hh:row    .
     1606                                   v-help-old-size = hh:width .
     1607                                   hh:width-chars = 2.5 .
     1608                               end.
     1609                           when "b-print" then
     1610                               do:
     1611                                   hh:load-image("cmp/b-print.bmp":u) .
     1612                                   hh:TOOLTIP = "Печать" .
     1613                                   v-h[ii] = hh:handle .
     1614                                   ii = ii + 1 .
     1615                                   hh:width-chars = 3 .
     1616                               end.
     1617                           when "b-history" or
     1618                           when "b-hist" then
     1619                               do:
     1620                                   hh:load-image("cmp/b-hist.bmp":u) .
     1621                                   hh:TOOLTIP = "История" .
     1622                                   v-h[ii] = hh:handle .
     1623                                   ii = ii + 1 .
     1624                                   hh:width-chars = 3 .
     1625                               end.
     1626                           when "b-sch" then
     1627                               do:
     1628                                   hh:load-image("cmp/b-sch.bmp":u) .
     1629                                   hh:TOOLTIP = "Установка Фильтра" .
     1630                                   v-h[ii] = hh:handle .
     1631                                   ii = ii + 1 .
     1632                                   hh:width-chars = 3 .
     1633                               end.
     1634                           when "b-hist-user" then
     1635                               do:
     1636                                   hh:load-image("cmp/b-hist.bmp":u) .
     1637                                   hh:TOOLTIP = "История пользователя" .
     1638                                   ii = ii + 1 .
     1639                               end.
     1640                       end case.
     1641                   end.
     1642                   hh = hh:next-sibling.
     1643               end.
     1644               b-help:column = v-frame-width - b-help:width-chars.
     1645               jj = 0.
     1646               repeat ii = 4 to 1 by -1 :
     1647                   if valid-handle (v-h[ii] ) then
     1648                   do:
     1649                       jj  = jj + 1 .
     1650                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1651                       v-h[ii]:row    = v-help-old-y .
     1652                   end.
     1653               end.
     1654           end.
     1655       end.
     1656   end procedure.
     1657   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1658   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1659   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1660   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1661   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1662   define variable v-diasize-current-frame-height as decimal   no-undo .
     1663   define variable v-diasize-change-size          as logical   no-undo .
     1664   define variable v-diasize-resize-button        as handle    no-undo .
     1665   define variable v-diasize-wndmax               as logical   no-undo .
     1666   define variable v-diasize-wndstore             as logical   no-undo .
     1667   define variable v-diasize-proc-name            as character no-undo .
     1668   define variable v-diasize-browse-handle        as handle    no-undo .
     1669   define variable v-diasize-browse-number        as integer   no-undo .
     1670   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1671   define temp-table temp-diasize-handle no-undo
     1672     field handle-value  as handle
     1673     field save-position as decimal
     1674     index xpk is primary unique handle-value
     1675     .
     1676   define temp-table temp-browse-handle no-undo
     1677     field browse-type   as character
     1678     field browse-number as integer
     1679     field browse-handle as handle
     1680     field original-size as decimal
     1681     index xpk is primary unique browse-type browse-number
     1682     index xie browse-type browse-handle
     1683   .
     1684   procedure diasize_change-height :
     1685     define input  parameter p-change-value  as decimal   no-undo .
     1686     define input  parameter p-move-resize   as logical   no-undo .
     1687     define variable v-field-group-handle    as handle    no-undo .
     1688     define variable v-object-handle         as handle    no-undo .
     1689     define variable v-frame-height          as decimal   no-undo .
     1690     define variable v-frame-virtual-height  as decimal   no-undo .
     1691     define variable v-browse-height         as decimal   no-undo .
     1692     define variable v-window-height         as decimal   no-undo .
     1693     define variable v-window-virtual-height as decimal   no-undo .
     1694     define variable v-change-sign           as integer   no-undo .
     1695     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1696     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1697     if p-change-value > 0
     1698     then do:
     1699       if frame Dialog-Frame :height + p-change-value
     1700           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1701       then do:
     1702         assign
     1703           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1704                           - (frame Dialog-Frame :height-chars)
     1705         .
     1706         if p-change-value <= 0
     1707         then do:
     1708           run diasize_position-resize-button in this-procedure .
     1709           return .
     1710         end.
     1711       end.
     1712     end.
     1713     if p-change-value < 0
     1714     then do:
     1715       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1716       then do:
     1717         assign
     1718           p-change-value = v-diasize-orig-frame-height
     1719                          - (frame Dialog-Frame :height-chars)
     1720         .
     1721         if p-change-value >= 0
     1722         then do:
     1723           run diasize_position-resize-button in this-procedure .
     1724           return .
     1725         end.
     1726       end.
     1727     end.
     1728     if p-change-value >= 0
     1729     then do:
     1730       assign
     1731         v-change-sign = 1
     1732       .
     1733     end.
     1734     else do:
     1735       assign
     1736         v-change-sign = -1
     1737       .
     1738     end.
     1739     assign
     1740       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1741     .
     1742     if p-change-value = 0
     1743     then do:
     1744       run diasize_position-resize-button in this-procedure .
     1745       return .
     1746     end.
     1747     move_block:
     1748     do
     1749     on error undo move_block, retry move_block
     1750     :
     1751       if retry
     1752       then do:
     1753         do
     1754         on error undo move_block, leave move_block
     1755         :
     1756           if p-change-value > 0
     1757           then do:
     1758             for each buf_temp-diasize-handle
     1759             on error undo, next
     1760             :
     1761               assign
     1762                 v-object-handle = buf_temp-diasize-handle.handle-value
     1763               .
     1764               if v-object-handle <> v-diasize-resize-button
     1765               then do:
     1766                 assign
     1767                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1768                 .
     1769               end.
     1770             end.
     1771             assign
     1772               v-diasize-browse-handle :height = v-browse-height
     1773             .
     1774             for each buf_temp-browse-handle
     1775               where buf_temp-browse-handle.browse-type = 'height':u
     1776             on error undo, next
     1777             :
     1778               assign
     1779                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1780               .
     1781             end.
     1782             assign
     1783               frame Dialog-Frame :height = v-frame-height
     1784             .
     1785             if frame Dialog-Frame :scrollable = true
     1786             then do:
     1787               assign
     1788                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1789               .
     1790             end.
     1791             run diasize_position-resize-button in this-procedure .
     1792           end.
     1793           else do:
     1794             if frame Dialog-Frame :scrollable = true
     1795             then do:
     1796               assign
     1797                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1798               .
     1799             end.
     1800             assign
     1801               frame Dialog-Frame :height = v-frame-height
     1802             .
     1803             assign
     1804               v-diasize-browse-handle :height = v-browse-height
     1805             .
     1806             for each buf_temp-browse-handle
     1807               where buf_temp-browse-handle.browse-type = 'height':u
     1808             on error undo, next
     1809             :
     1810               assign
     1811                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1812               .
     1813             end.
     1814             for each buf_temp-diasize-handle
     1815             on error undo, next
     1816             :
     1817               assign
     1818                 v-object-handle = buf_temp-diasize-handle.handle-value
     1819               .
     1820               if v-object-handle <> v-diasize-resize-button
     1821               then do:
     1822                 assign
     1823                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1824                 .
     1825               end.
     1826             end.
     1827             run diasize_position-resize-button in this-procedure .
     1828           end.
     1829           assign
     1830             v-diasize-change-size = false
     1831           .
     1832           leave move_block .
     1833         end.
     1834       end.
     1835       assign
     1836         v-diasize-need-full-display = true
     1837       .
     1838       if v-diasize-change-size = false
     1839       then do:
     1840         assign
     1841           v-diasize-change-size = true
     1842         .
     1843       end.
     1844       else do:
     1845         return .
     1846       end.
     1847       assign
     1848         v-frame-height = frame Dialog-Frame :height
     1849         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1850         v-browse-height = v-diasize-browse-handle :height
     1851       .
     1852       for each buf_temp-browse-handle
     1853         where buf_temp-browse-handle.browse-type = 'height':u
     1854       :
     1855         assign
     1856           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1857         .
     1858       end.
     1859       for each buf_temp-diasize-handle
     1860       :
     1861         delete buf_temp-diasize-handle .
     1862       end.
     1863       assign
     1864         v-field-group-handle = frame Dialog-Frame :first-child
     1865       .
     1866       do while valid-handle(v-field-group-handle)
     1867       :
     1868         assign
     1869           v-object-handle = v-field-group-handle :first-child
     1870         .
     1871         do while valid-handle(v-object-handle)
     1872         :
     1873           if  v-object-handle <> v-diasize-browse-handle :handle
     1874           and can-query(v-object-handle, "row")
     1875           and can-query(v-object-handle, "height")
     1876           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1877           then do:
     1878             find first buf_temp-browse-handle
     1879               where buf_temp-browse-handle.browse-type   = 'height':u
     1880                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1881               no-error .
     1882             if available buf_temp-browse-handle
     1883             then do:
     1884             end.
     1885             else do:
     1886               create buf_temp-diasize-handle .
     1887               assign
     1888                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1889                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1890               .
     1891             end.
     1892           end.
     1893           assign
     1894             v-object-handle = v-object-handle :next-sibling
     1895           .
     1896         end.
     1897         assign
     1898           v-field-group-handle = v-field-group-handle :next-sibling
     1899         .
     1900       end.
     1901       do with frame Dialog-Frame
     1902       :
     1903         hide v-diasize-resize-button .
     1904         assign
     1905           v-diasize-resize-button :row    = 1
     1906           v-diasize-resize-button :column = 1
     1907         .
     1908       end.
     1909       if p-change-value > 0
     1910       then do:
     1911         if frame Dialog-Frame :scrollable = true
     1912         then do:
     1913           assign
     1914             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1915             no-error .
     1916           if error-status :error
     1917           or error-status :get-message(1) <> ""
     1918           then do:
     1919             undo move_block, retry move_block .
     1920           end.
     1921         end.
     1922         assign
     1923           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1924           no-error .
     1925         if error-status :error
     1926         or error-status :get-message(1) <> ""
     1927         then do:
     1928           undo move_block, retry move_block .
     1929         end.
     1930         assign
     1931           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1932           no-error .
     1933         if error-status :error
     1934         or error-status :get-message(1) <> ""
     1935         then do:
     1936           undo move_block, retry move_block .
     1937         end.
     1938         for each buf_temp-browse-handle
     1939           where buf_temp-browse-handle.browse-type = 'height':u
     1940         on error undo move_block, retry move_block
     1941         :
     1942           assign
     1943             buf_temp-browse-handle.browse-handle :height
     1944               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1945             no-error .
     1946           if error-status :error
     1947           or error-status :get-message(1) <> ""
     1948           then do:
     1949             undo move_block, retry move_block .
     1950           end.
     1951         end.
     1952         for each buf_temp-diasize-handle
     1953         on error undo move_block, retry move_block
     1954         :
     1955           assign
     1956             v-object-handle = buf_temp-diasize-handle.handle-value
     1957           .
     1958           if v-object-handle <> v-diasize-resize-button
     1959           then do:
     1960             assign
     1961               v-object-handle :row = v-object-handle :row + p-change-value
     1962               no-error .
     1963             if error-status :error
     1964             or error-status :get-message(1) <> ""
     1965             then do:
     1966               undo move_block, retry move_block .
     1967             end.
     1968           end.
     1969         end.
     1970       end.
     1971       else do:
     1972         for each buf_temp-diasize-handle
     1973         on error undo move_block, retry move_block
     1974         :
     1975           assign
     1976             v-object-handle = buf_temp-diasize-handle.handle-value
     1977           .
     1978           if v-object-handle <> v-diasize-resize-button
     1979           then do:
     1980             assign
     1981               v-object-handle :row = v-object-handle :row + p-change-value
     1982               no-error .
     1983             if error-status :error
     1984             or error-status :get-message(1) <> ""
     1985             then do:
     1986               undo move_block, retry move_block .
     1987             end.
     1988           end.
     1989         end.
     1990         assign
     1991           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1992           no-error .
     1993         if error-status :error
     1994         or error-status :get-message(1) <> ""
     1995         then do:
     1996           undo move_block, retry move_block .
     1997         end.
     1998         for each buf_temp-browse-handle
     1999           where buf_temp-browse-handle.browse-type = 'height':u
     2000         on error undo move_block, retry move_block
     2001         :
     2002           assign
     2003             buf_temp-browse-handle.browse-handle :height
     2004               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2005             no-error .
     2006           if error-status :error
     2007           or error-status :get-message(1) <> ""
     2008           then do:
     2009             undo move_block, retry move_block .
     2010           end.
     2011         end.
     2012         assign
     2013           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2014           no-error .
     2015         if error-status :error
     2016         or error-status :get-message(1) <> ""
     2017         then do:
     2018           undo move_block, retry move_block .
     2019         end.
     2020         if frame Dialog-Frame :scrollable = true
     2021         then do:
     2022           assign
     2023             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2024             no-error .
     2025           if error-status :error
     2026           or error-status :get-message(1) <> ""
     2027           then do:
     2028             undo move_block, retry move_block .
     2029           end.
     2030         end.
     2031       end.
     2032       if p-move-resize = true
     2033       then do:
     2034         run diasize_position-resize-button in this-procedure .
     2035       end.
     2036       if v-diasize-wndstore = true
     2037       then do:
     2038         if connected("ub") = true
     2039         then do:
     2040           define variable v-cntxt-db-num        as integer   no-undo .
     2041           define variable v-cntxt-userid        as character no-undo .
     2042           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2043                                             , OUTPUT v-cntxt-userid
     2044                                             ) .
     2045           run gbl/wndsizew.p
     2046             (input  v-cntxt-db-num
     2047             ,input  v-cntxt-userid
     2048             ,input  v-diasize-proc-name
     2049             ,input  'height':u
     2050             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     2051             ) .
     2052         end.
     2053       end.
     2054     end.
     2055     assign
     2056       v-diasize-change-size = false
     2057     .
     2058   end procedure.
     2059   procedure diasize_set-height :
     2060     define input  parameter p-new-height  as decimal   no-undo .
     2061     define input  parameter p-move-resize as logical   no-undo .
     2062     do
     2063     on error undo, return error return-value
     2064     :
     2065       run diasize_change-height in this-procedure
     2066         (input  (p-new-height - frame Dialog-Frame :height)
     2067         ,input  p-move-resize
     2068         ) .
     2069     end.
     2070   end procedure.
     2071   procedure diasize_change-width :
     2072     define input  parameter p-change-value as decimal   no-undo .
     2073     define input  parameter p-move-resize  as logical   no-undo .
     2074     define variable v-field-group-handle   as handle    no-undo .
     2075     define variable v-object-handle        as handle    no-undo .
     2076     define variable v-frame-width          as decimal   no-undo .
     2077     define variable v-frame-virtual-width  as decimal   no-undo .
     2078     define variable v-browse-width         as decimal   no-undo .
     2079     define variable v-window-width         as decimal   no-undo .
     2080     define variable v-window-virtual-width as decimal   no-undo .
     2081     define variable v-change-sign          as integer   no-undo .
     2082     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2083     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2084     if p-change-value > 0
     2085     then do:
     2086       if frame Dialog-Frame :width + p-change-value >
     2087           session :width-chars
     2088       then do:
     2089         assign
     2090           p-change-value = session :width-chars - frame Dialog-Frame :width
     2091         .
     2092         if p-change-value <= 0
     2093         then do:
     2094           run diasize_position-resize-button in this-procedure .
     2095           return .
     2096         end.
     2097       end.
     2098     end.
     2099     if p-change-value < 0
     2100     then do:
     2101       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     2102       then do:
     2103         assign
     2104           p-change-value = v-diasize-orig-frame-width
     2105                          - frame Dialog-Frame :width
     2106         .
     2107         if p-change-value >= 0
     2108         then do:
     2109           run diasize_position-resize-button in this-procedure .
     2110           return .
     2111         end.
     2112       end.
     2113     end.
     2114     if p-change-value >= 0
     2115     then do:
     2116       assign
     2117         v-change-sign = 1
     2118       .
     2119     end.
     2120     else do:
     2121       assign
     2122         v-change-sign = -1
     2123       .
     2124     end.
     2125     assign
     2126       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2127     .
     2128     if p-change-value = 0
     2129     then do:
     2130       run diasize_position-resize-button in this-procedure .
     2131       return .
     2132     end.
     2133     move_block:
     2134     do
     2135     on error undo move_block, leave move_block
     2136     :
     2137       if retry
     2138       then do:
     2139         do
     2140         on error undo move_block, leave move_block
     2141         :
     2142           if p-change-value > 0
     2143           then do:
     2144             for each buf_temp-diasize-handle
     2145             on error undo, next
     2146             :
     2147               assign
     2148                 v-object-handle = buf_temp-diasize-handle.handle-value
     2149               .
     2150               if v-object-handle <> v-diasize-resize-button
     2151               then do:
     2152                 assign
     2153                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2154                 .
     2155               end.
     2156             end.
     2157             assign
     2158               v-diasize-browse-handle :width = v-browse-width
     2159             .
     2160             for each buf_temp-browse-handle
     2161               where buf_temp-browse-handle.browse-type = 'width':u
     2162             on error undo, next
     2163             :
     2164               assign
     2165                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2166               .
     2167             end.
     2168             assign
     2169               frame Dialog-Frame :width = v-frame-width
     2170             .
     2171             if frame Dialog-Frame :scrollable = true
     2172             then do:
     2173               assign
     2174                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2175               .
     2176             end.
     2177             run diasize_position-resize-button in this-procedure .
     2178           end.
     2179           else do:
     2180             if frame Dialog-Frame :scrollable = true
     2181             then do:
     2182               assign
     2183                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2184               .
     2185             end.
     2186             assign
     2187               frame Dialog-Frame :width = v-frame-width
     2188             .
     2189             for each buf_temp-browse-handle
     2190               where buf_temp-browse-handle.browse-type = 'width':u
     2191             on error undo, next
     2192             :
     2193               assign
     2194                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2195               .
     2196             end.
     2197             assign
     2198               v-diasize-browse-handle :width = v-browse-width
     2199             .
     2200             for each buf_temp-diasize-handle
     2201             on error undo, next
     2202             :
     2203               assign
     2204                 v-object-handle = buf_temp-diasize-handle.handle-value
     2205               .
     2206               if v-object-handle <> v-diasize-resize-button
     2207               then do:
     2208                 assign
     2209                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2210                 .
     2211               end.
     2212             end.
     2213             run diasize_position-resize-button in this-procedure .
     2214           end.
     2215           assign
     2216             v-diasize-change-size = false
     2217           .
     2218           leave move_block .
     2219         end.
     2220       end.
     2221       assign
     2222         v-diasize-need-full-display = true
     2223       .
     2224       if v-diasize-change-size = false
     2225       then do:
     2226         assign
     2227           v-diasize-change-size = true
     2228         .
     2229       end.
     2230       else do:
     2231         return .
     2232       end.
     2233       assign
     2234         v-frame-width = frame Dialog-Frame :width
     2235         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     2236         v-browse-width = v-diasize-browse-handle :width
     2237       .
     2238       for each buf_temp-browse-handle
     2239         where buf_temp-browse-handle.browse-type = 'width':u
     2240       :
     2241         assign
     2242           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2243         .
     2244       end.
     2245       for each buf_temp-diasize-handle
     2246       :
     2247         delete buf_temp-diasize-handle .
     2248       end.
     2249       assign
     2250         v-field-group-handle = frame Dialog-Frame :first-child
     2251       .
     2252       do while valid-handle(v-field-group-handle)
     2253       :
     2254         assign
     2255           v-object-handle = v-field-group-handle :first-child
     2256         .
     2257         do while valid-handle(v-object-handle)
     2258         :
     2259           if  v-object-handle <> v-diasize-browse-handle :handle
     2260           and v-object-handle <> v-diasize-resize-button
     2261           and can-query(v-object-handle, "row")
     2262           and can-query(v-object-handle, "height")
     2263           and ( v-object-handle :col + v-object-handle :width
     2264                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2265               )
     2266           then do:
     2267             find first buf_temp-browse-handle
     2268               where buf_temp-browse-handle.browse-type   = 'width':u
     2269                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2270               no-error .
     2271             if available buf_temp-browse-handle
     2272             then do:
     2273             end.
     2274             else do:
     2275               create buf_temp-diasize-handle .
     2276               assign
     2277                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2278                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2279               .
     2280             end.
     2281           end.
     2282           assign
     2283             v-object-handle = v-object-handle :next-sibling
     2284           .
     2285         end.
     2286         assign
     2287           v-field-group-handle = v-field-group-handle :next-sibling
     2288         .
     2289       end.
     2290       do with frame Dialog-Frame
     2291       :
     2292         hide v-diasize-resize-button .
     2293         v-diasize-resize-button :row = 1.
     2294         v-diasize-resize-button :column = 1.
     2295       end.
     2296       if p-change-value > 0
     2297       then do:
     2298         if frame Dialog-Frame :scrollable = true
     2299         then do:
     2300           assign
     2301             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2302             no-error .
     2303           if error-status :error
     2304           or error-status :get-message(1) <> ""
     2305           then do:
     2306             undo move_block, retry move_block.
     2307           end.
     2308         end.
     2309         assign
     2310           frame Dialog-Frame :width = v-frame-width + p-change-value
     2311           no-error .
     2312         if error-status :error
     2313         or error-status :get-message(1) <> ""
     2314         then do:
     2315           undo move_block, retry move_block.
     2316         end.
     2317         assign
     2318           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2319         no-error .
     2320         if error-status :error
     2321         or error-status :get-message(1) <> ""
     2322         then do:
     2323           undo move_block, retry move_block.
     2324         end.
     2325         for each buf_temp-browse-handle
     2326           where buf_temp-browse-handle.browse-type = 'width':u
     2327         on error undo move_block, retry move_block
     2328         :
     2329           assign
     2330             buf_temp-browse-handle.browse-handle :width
     2331               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2332             no-error .
     2333           if error-status :error
     2334           or error-status :get-message(1) <> ""
     2335           then do:
     2336             undo move_block, retry move_block .
     2337           end.
     2338         end.
     2339         for each buf_temp-diasize-handle
     2340         on error undo move_block, retry move_block
     2341         :
     2342           assign
     2343             v-object-handle = buf_temp-diasize-handle.handle-value
     2344           .
     2345           if v-object-handle <> v-diasize-resize-button
     2346           then do:
     2347             assign
     2348               v-object-handle :col = v-object-handle :col + p-change-value
     2349               no-error .
     2350             if error-status :error
     2351             or error-status :get-message(1) <> ""
     2352             then do:
     2353               undo move_block, retry move_block .
     2354             end.
     2355           end.
     2356         end.
     2357       end.
     2358       else do:
     2359         for each buf_temp-diasize-handle
     2360         on error undo move_block, retry move_block
     2361         :
     2362           assign
     2363             v-object-handle = buf_temp-diasize-handle.handle-value
     2364           .
     2365           if v-object-handle <> v-diasize-resize-button
     2366           then do:
     2367             assign
     2368               v-object-handle :col = v-object-handle :col + p-change-value
     2369               no-error .
     2370             if error-status :error
     2371             or error-status :get-message(1) <> ""
     2372             then do:
     2373               undo move_block, retry move_block .
     2374             end.
     2375           end.
     2376         end.
     2377         for each buf_temp-browse-handle
     2378           where buf_temp-browse-handle.browse-type = 'width':u
     2379         on error undo move_block, retry move_block
     2380         :
     2381           assign
     2382             buf_temp-browse-handle.browse-handle :width
     2383               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2384             no-error .
     2385           if error-status :error
     2386           or error-status :get-message(1) <> ""
     2387           then do:
     2388             undo move_block, retry move_block .
     2389           end.
     2390         end.
     2391         assign
     2392           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2393           no-error .
     2394         if error-status :error
     2395         or error-status :get-message(1) <> ""
     2396         then do:
     2397           undo move_block, retry move_block.
     2398         end.
     2399         assign
     2400           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2401         no-error .
     2402         if error-status :error
     2403         or error-status :get-message(1) <> ""
     2404         then do:
     2405           undo move_block, retry move_block.
     2406         end.
     2407         if frame Dialog-Frame :scrollable = true
     2408         then do:
     2409           assign
     2410             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2411           no-error .
     2412           if error-status :error
     2413           or error-status :get-message(1) <> ""
     2414           then do:
     2415             undo move_block, retry move_block.
     2416           end.
     2417         end.
     2418       end.
     2419       if p-move-resize
     2420       then do:
     2421         run diasize_position-resize-button in this-procedure .
     2422       end.
     2423       if v-diasize-wndstore = true
     2424       then do:
     2425         if connected("ub") = true
     2426         then do:
     2427           define variable v-cntxt-db-num        as integer   no-undo .
     2428           define variable v-cntxt-userid        as character no-undo .
     2429           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2430                                             , OUTPUT v-cntxt-userid
     2431                                             ) .
     2432           run gbl/wndsizew.p
     2433             (input  v-cntxt-db-num
     2434             ,input  v-cntxt-userid
     2435             ,input  v-diasize-proc-name
     2436             ,input  'width':u
     2437             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2438             ) .
     2439         end.
     2440       end.
     2441     end.
     2442     assign
     2443       v-diasize-change-size = false
     2444     .
     2445   end procedure.
     2446   procedure diasize_set-width :
     2447     define input  parameter p-new-width  as decimal   no-undo .
     2448     define input  parameter p-move-resize as logical   no-undo .
     2449     do
     2450     on error undo, return error return-value
     2451     :
     2452       run diasize_change-width in this-procedure
     2453         (input  (p-new-width - frame Dialog-Frame :width)
     2454         ,input  p-move-resize
     2455         ) .
     2456     end.
     2457   end procedure.
     2458   procedure diasize_position-resize-button :
     2459     do with frame Dialog-Frame
     2460     :
     2461       hide v-diasize-resize-button .
     2462       assign
     2463         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2464                     - 1
     2465                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2466         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2467                     - 1
     2468                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2469       .
     2470       view v-diasize-resize-button .
     2471     end.
     2472   end procedure.
     2473   on alt-right anywhere
     2474   do:
     2475     run diasize_change-width in this-procedure
     2476       (input 1
     2477       ,input true
     2478       ) .
     2479     return no-apply .
     2480   end.
     2481   on alt-left anywhere
     2482   do:
     2483     run diasize_change-width in this-procedure
     2484       (input -1
     2485       ,input true
     2486       ) .
     2487     return no-apply .
     2488   end.
     2489   on alt-down anywhere
     2490   do:
     2491     run diasize_change-height in this-procedure
     2492       (input 1
     2493       ,input true
     2494       ) .
     2495     return no-apply .
     2496   end.
     2497   on alt-up anywhere
     2498   do:
     2499     run diasize_change-height in this-procedure
     2500       (input -1
     2501       ,input true
     2502       ) .
     2503     return no-apply .
     2504   end.
     2505   on alt-enter of frame Dialog-Frame
     2506   do:
     2507     run diasize_maximize in this-procedure
     2508       (input  ?
     2509       ).
     2510     return no-apply .
     2511   end.
     2512   procedure diasize_end-move :
     2513     do
     2514     on error undo, return error return-value
     2515     :
     2516       define variable v-row-delta as decimal   no-undo .
     2517       define variable v-col-delta as decimal   no-undo .
     2518       define variable v-new-row as decimal   no-undo .
     2519       define variable v-new-col as decimal   no-undo .
     2520       assign
     2521         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2522         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2523       .
     2524       assign
     2525         v-row-delta = v-new-row - frame Dialog-Frame :height
     2526         v-col-delta = v-new-col - frame Dialog-Frame :width
     2527       .
     2528       run diasize_change-height in this-procedure
     2529         (input v-row-delta
     2530         ,input true
     2531         ) .
     2532       run diasize_change-width in this-procedure
     2533         (input v-col-delta
     2534         ,input true
     2535         ) .
     2536     end.
     2537   end procedure.
     2538   procedure diasize_maximize :
     2539     define input  parameter p-action as logical   no-undo .
     2540     do
     2541     on error undo, return error return-value
     2542     :
     2543       if p-action = ?
     2544       then do:
     2545         if v-diasize-need-maximize = true
     2546         then do:
     2547           assign
     2548             p-action = true
     2549           .
     2550         end.
     2551         else do:
     2552           assign
     2553             p-action = false
     2554           .
     2555         end.
     2556       end.
     2557       if p-action = true
     2558       then do:
     2559         run diasize_change-height in this-procedure
     2560           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2561               - frame Dialog-Frame :height-chars
     2562           ,input true
     2563           ) .
     2564         run diasize_change-width in this-procedure
     2565           (input session :width-chars
     2566               - frame Dialog-Frame :width-chars
     2567           ,input true
     2568           ) .
     2569         assign
     2570           v-diasize-need-maximize = false
     2571         .
     2572       end.
     2573       else do:
     2574         run diasize_change-width in this-procedure
     2575           (input v-diasize-orig-frame-width
     2576               - frame Dialog-Frame :width-chars
     2577           ,input true
     2578           ) .
     2579         run diasize_change-height in this-procedure
     2580           (input v-diasize-orig-frame-height
     2581               - frame Dialog-Frame :height-chars
     2582           ,input true
     2583           ) .
     2584         assign
     2585           v-diasize-need-maximize = true
     2586         .
     2587       end.
     2588     end.
     2589   end procedure.
     2590   procedure diasize_restore-orig-size :
     2591     do
     2592     on error undo, return error return-value
     2593     :
     2594       assign
     2595         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2596         v-diasize-current-frame-height = frame Dialog-Frame :height
     2597       .
     2598       run diasize_set-height in this-procedure
     2599         (input  v-diasize-orig-frame-height
     2600         ,input  true
     2601         ) .
     2602       run diasize_set-width in this-procedure
     2603         (input  v-diasize-orig-frame-width
     2604         ,input  true
     2605         ) .
     2606     end.
     2607   end procedure.
     2608   procedure diasize_restore-current-size :
     2609     do
     2610     on error undo, return error return-value
     2611     :
     2612       run diasize_set-height in this-procedure
     2613         (input  v-diasize-current-frame-height
     2614         ,input  true
     2615         ) .
     2616       run diasize_set-width in this-procedure
     2617         (input  v-diasize-current-frame-width
     2618         ,input  true
     2619         ) .
     2620     end.
     2621   end procedure.
     2622   procedure diasize_set-browse-handle :
     2623     define input  parameter p-browse-handle as handle   no-undo .
     2624     define buffer buf_temp-browse-handle for temp-browse-handle .
     2625     do
     2626     on error undo, return error return-value
     2627     :
     2628       assign
     2629         v-diasize-browse-handle = p-browse-handle
     2630       .
     2631       for each buf_temp-browse-handle
     2632       on error undo, return error return-value
     2633       :
     2634         delete buf_temp-browse-handle .
     2635       end.
     2636     end.
     2637   end procedure.
     2638   procedure diasize_add_browse :
     2639     define input  parameter p-browse-type   as character no-undo .
     2640     define input  parameter p-browse-handle as handle    no-undo .
     2641     define buffer buf_temp-browse-handle for temp-browse-handle .
     2642     do
     2643     on error undo, return error return-value
     2644     :
     2645       assign
     2646         v-diasize-browse-number = v-diasize-browse-number + 1
     2647       .
     2648       create buf_temp-browse-handle .
     2649       assign
     2650         buf_temp-browse-handle.browse-type   = p-browse-type
     2651         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2652         buf_temp-browse-handle.browse-handle = p-browse-handle
     2653       .
     2654     end.
     2655   end procedure.
     2656   procedure diasize_init :
     2657     define variable v-default-value    as logical   no-undo .
     2658     define variable v-restore-saved    as logical   no-undo .
     2659     define variable v-resize-value-str as character no-undo .
     2660     do
     2661     on error undo, return error return-value
     2662     :
     2663       do with frame Dialog-Frame
     2664       :
     2665         assign
     2666           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2667           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2668           v-diasize-browse-handle     = browse BR-pbc :handle
     2669         .
     2670         create button v-diasize-resize-button
     2671         assign
     2672           parent        = frame Dialog-Frame :first-child
     2673           label         = "s"
     2674           height-pixels = 16
     2675           width-pixels  = 16
     2676           visible       = true
     2677           sensitive     = true
     2678           movable       = true
     2679           triggers:
     2680             on end-move persistent run diasize_end-move in this-procedure .
     2681           end triggers.
     2682         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2683         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2684         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2685         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2686         assign
     2687           v-diasize-wndmax = false
     2688         .
     2689         if connected("ub") = true
     2690         then do:
     2691           define variable v-cntxt-db-num        as integer   no-undo .
     2692           define variable v-cntxt-userid        as character no-undo .
     2693           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2694                                             , OUTPUT v-cntxt-userid
     2695                                             ) .
     2696           run gbl/wndpar_r.p
     2697             (input  v-cntxt-db-num
     2698             ,input  v-cntxt-userid
     2699             ,input  'wndmax':U
     2700             ,output v-diasize-wndmax
     2701             ,output v-default-value
     2702             ) .
     2703         end.
     2704         assign
     2705           v-diasize-wndstore = false
     2706         .
     2707         if connected("ub") = true
     2708         then do:
     2709           run gbl/wndpar_r.p
     2710             (input  v-cntxt-db-num
     2711             ,input  v-cntxt-userid
     2712             ,input  'wndstore':U
     2713             ,output v-diasize-wndstore
     2714             ,output v-default-value
     2715             ) .
     2716         end.
     2717         assign
     2718           v-diasize-proc-name = entry(1, program-name(2), '.')
     2719         .
     2720         if v-diasize-wndstore = true
     2721         then do:
     2722           assign
     2723             v-restore-saved = false
     2724           .
     2725           if connected("ub") = true
     2726           then do:
     2727             run gbl/wndsizer.p
     2728               (input  v-cntxt-db-num
     2729               ,input  v-cntxt-userid
     2730               ,input  v-diasize-proc-name
     2731               ,input  'height':u
     2732               ,output v-resize-value-str
     2733               ) .
     2734             if v-resize-value-str <> '':U
     2735             then do:
     2736               run diasize_change-height in this-procedure
     2737                 (input  integer(v-resize-value-str)
     2738                 ,input  true
     2739                 ) .
     2740               assign
     2741                 v-restore-saved = true
     2742               .
     2743             end.
     2744           end.
     2745           if connected("ub") = true
     2746           then do:
     2747             run gbl/wndsizer.p
     2748               (input  v-cntxt-db-num
     2749               ,input  v-cntxt-userid
     2750               ,input  v-diasize-proc-name
     2751               ,input  'width':u
     2752               ,output v-resize-value-str
     2753               ) .
     2754             if v-resize-value-str <> '':U
     2755             then do:
     2756               run diasize_change-width in this-procedure
     2757                 (input  integer(v-resize-value-str)
     2758                 ,input  true
     2759                 ) .
     2760               assign
     2761                 v-restore-saved = true
     2762               .
     2763             end.
     2764           end.
     2765           if v-restore-saved <> true
     2766           then do:
     2767             if v-diasize-wndmax = true
     2768             then do:
     2769               run diasize_maximize in this-procedure
     2770                 (input  true
     2771                 ) .
     2772             end.
     2773           end.
     2774         end.
     2775         else do:
     2776           if v-diasize-wndmax = true
     2777           then do:
     2778             run diasize_maximize in this-procedure
     2779               (input  true
     2780               ) .
     2781           end.
     2782         end.
     2783       end.
     2784     end.
     2785   end procedure.
     2786   procedure diasize_need-full-display :
     2787     define output parameter p-need-full-display as logical   no-undo .
     2788     do
     2789     on error undo, return error return-value
     2790     :
     2791       assign
     2792         p-need-full-display = v-diasize-need-full-display
     2793       .
     2794       assign
     2795         v-diasize-need-full-display = false
     2796       .
     2797     end.
     2798   end procedure.
     2799   procedure get-context :
     2800      define output parameter p-db-num as integer          no-undo.
     2801      define output parameter p-user-id as character        no-undo.
     2802      define variable v-login               as character    no-undo.
     2803      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2804      define buffer buf_user-login  for ub.user-login .
     2805      do
     2806      on error undo, return error
     2807      :
     2808            FIND FIRST buf_sys-ctrl no-lock.
     2809            ASSIGN
     2810               v-login = USERID("ub")
     2811               p-db-num = buf_sys-ctrl.db-num
     2812            .
     2813            FIND FIRST buf_user-login
     2814                 WHERE buf_user-login.db-num = p-db-num
     2815                   AND buf_user-login.user-login = v-login
     2816                 no-lock
     2817                 no-error
     2818                 .
     2819            IF AVAILABLE buf_user-login
     2820            THEN DO:
     2821               assign
     2822                  p-user-id = buf_user-login.user-id
     2823               .
     2824            END.
     2825      end.
     2826   end procedure.
     2827       run diasize_init in this-procedure .
     2828   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2829   on F9 of frame Dialog-Frame anywhere do:
