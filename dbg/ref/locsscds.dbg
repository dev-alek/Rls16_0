     3020   PROCEDURE obj-on :
     3021   def input param o-type as character no-undo .
     3022   def input param o-code as integer   no-undo .
     3023   define variable v-object-available as logical   no-undo .
     3024   define variable vss-include-info23 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3025   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run usobjava in g#library2
     3026     (input  v-cntxt-db-num
     3027     ,input  0
     3028     ,input  v-cntxt-userid
     3029     ,input  o-type
     3030     ,input  o-code
     3031     ,output v-object-available
     3032     ) no-error .
     3033   if error-status :error
     3034   then do:
     3035     message
     3036       vss-workfile vss-revision vss-description skip
     3037       "Ошибка при вызове процедуры gbl/usobjava.i" skip
     3038       error-status :get-message(1) skip
     3039       return-value skip
     3040       view-as alert-box error .
     3041     undo, return no-apply .
     3042   end.
     3043   if v-object-available <> true
     3044   then do:
     3045     message
     3046       "Объект недоступен для пользователя." skip
     3047       "База данных" v-cntxt-db-num skip
     3048       "Идентификатор пользователя" v-cntxt-userid skip
     3049       "Объект" o-type o-code skip
     3050       view-as alert-box error.
     3051     return error.
     3052   end.
     3053   do transaction
     3054      on error undo, return error
     3055      on stop undo, return error:
     3056     assign
     3057       varobj-type = o-type
     3058       varobj-code = o-code
     3059     .
     3060   end.
     3061   display
     3062   varobj-type
     3063   varobj-code
     3064   with frame Dialog-Frame.
     3065   run MyEnable.
     3066   END PROCEDURE.
     3067   PROCEDURE OpenBr :
     3068   define input  parameter p-open-query     as logical   no-undo .
     3069   define input  parameter p-find-next      as logical   no-undo .
     3070   define input  parameter p-find-condition as character no-undo .
     3071   define variable l-query-was-opened as logical no-undo .
     3072   define variable title0 as character no-undo.
     3073   title0 = "Взвешиваемые коды".
     3074   run waitfram-show in this-procedure ("Ждите...").
     3075   define variable sort-column-phrase as character no-undo .
     3076   case sort-column-name :
     3077   when "" then do:
     3078   assign
     3079     sort-column-phrase = ""
     3080   .
     3081   end.
     3082   otherwise do:
     3083   assign
     3084     sort-column-phrase = "by " + sort-column-name
     3085   .
     3086   end.
     3087   end case.
     3088   define variable l-open-query as logical   no-undo .
     3089   filter-point = filter-point0  .
     3090   CASE par-mode :
     3091   WHEN "1":U  THEN DO:
     3092     assign
     3093       frame Dialog-Frame:title = title0 + chr(32) + varobj-type + chr(32) + string(varobj-code)
     3094       filter-label = substitute("&1", filter-label0)
     3095       .
     3096   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3097   define variable  l-disable-where-25  as logical   no-undo .
     3098   define variable  l-filter-open-25    as logical   .
     3099   define variable  flt-rec-25       as recid     no-undo .
     3100   define variable  filter-name-25      as character no-undo .
     3101   define variable  where-phrase-25     as character no-undo .
     3102   define variable  sort-phrase-25      as character no-undo .
     3103   define variable  where-phrase-rus-25 as character no-undo .
     3104   define variable  sort-phrase-rus-25  as character no-undo .
     3105     run waitfram-show in this-procedure
     3106       (input "ЖДИТЕ ..."
     3107       ).
     3108   run gbl/flt-get.p
     3109     (input filter-point
     3110     ,output flt-rec-25
     3111     ,output filter-name-25
     3112     ,output where-phrase-25
     3113     ,output sort-phrase-25
     3114     ,output where-phrase-rus-25
     3115     ,output sort-phrase-rus-25
     3116     ).
     3117   if p-open-query then do:
     3118       run set-filter-name in this-procedure
     3119         (INPUT filter-name-25
     3120         ) no-error .
     3121     assign
     3122       l-filter-open-25 = false
     3123     .
     3124     if flt-rec-25 <> ?
     3125       or sort-column-phrase > ""
     3126     then do:
     3127       define variable  parameter-2-25 as character no-undo .
     3128       define variable  parameter-3-25 as character no-undo .
     3129       define variable  parameter-4-25 as character no-undo .
     3130       define variable  parameter-5-25 as character no-undo .
     3131       define variable  parameter-6-25 as character no-undo .
     3132       define variable  parameter-7-25 as character no-undo .
     3133         assign
     3134         parameter-3-25 =
     3135                                 "FOR EACH temp-goods"
     3136         parameter-4-25 =
     3137           (
     3138             if (" TRUE " + " " + where-phrase-25) <> ""
     3139             then " TRUE " + " " + where-phrase-25
     3140             else "true"
     3141           )
     3142         parameter-5-25 = (" " + "" + " " + ", EACH temp-scaleable WHERE temp-scaleable.b-code = temp-goods.gds-code NO-LOCK")
     3143         parameter-6-25 = if sort-phrase-25 = ''
     3144                              then
     3145           (
     3146           " " + " " +
     3147             " " + sort-column-phrase +
     3148           " " + "  "
     3149           )
     3150                              else
     3151           (
     3152           " " + " " +
     3153             " " + sort-column-phrase +
     3154           " " + sort-phrase-25
     3155           )
     3156         parameter-7-25 =
     3157           "   "
     3158       .
     3159       do
     3160       on stop undo, leave
     3161       on error undo, leave
     3162       :
     3163         assign
     3164           l-disable-where-25 =
     3165             (" TRUE " + " " + where-phrase-25 = "")
     3166         .
     3167         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     3168                             ,input QUERY BR-pbc:handle
     3169                             ,input parameter-3-25
     3170                             ,input parameter-4-25
     3171                             ,input parameter-5-25
     3172                             ,input parameter-6-25
     3173                             ,input parameter-7-25
     3174                             )
     3175         .
     3176         assign
     3177           l-filter-open-25 = true
     3178         .
     3179       end.
     3180       if l-filter-open-25 = false then do:
     3181         message
     3182           "Ошибка при фильтрации / сортировке" skip
     3183           "Будут показаны записи без учета фильтра" skip
     3184           view-as alert-box .
     3185       end.
     3186       else do:
     3187           assign
     3188             l-query-was-opened = true
     3189           .
     3190       end.
     3191     end.
     3192     if l-filter-open-25 = false then do:
     3193       OPEN QUERY BR-pbc FOR EACH temp-goods
     3194         where  TRUE
     3195       , EACH temp-scaleable WHERE temp-scaleable.b-code = temp-goods.gds-code NO-LOCK
     3196     .
     3197         assign
     3198           l-query-was-opened = true
     3199         .
     3200     end.
     3201   end.
     3202   else do:
     3203     assign
     3204       v-doc-rec = recid( temp-goods )
     3205     .
     3206     do
     3207     on stop undo, leave
     3208     on error undo, leave
     3209     :
     3210       if QUERY BR-pbc:handle:get-buffer-handle(1) = (buffer temp-goods:handle) then do:
     3211         assign
     3212         parameter-2-25 = (if p-find-next then "true":u else "false":u )
     3213         parameter-4-25 =
     3214           "where ":u + " TRUE " + " ":u + where-phrase-25 + " ":u + p-find-condition + " " + ""
     3215         parameter-5-25 = " "
     3216       .
     3217         run fltopend_fltfindd in this-procedure  (
     3218                             input this-procedure:handle
     3219                             ,input QUERY BR-pbc:handle
     3220                             ,input rowid(temp-goods)
     3221                             ,input logical(parameter-2-25)
     3222                             ,input no-lock
     3223                             ,input (buffer temp-goods:handle)
     3224                             ,input parameter-4-25
     3225                             ,input parameter-5-25
     3226                             ) no-error.
     3227         .
     3228         assign
     3229           v-doc-rec = integer(return-value)
     3230           v-fltopend-rowid[1] = ?
     3231         .
     3232       end.
     3233       else do:
     3234         assign
     3235         parameter-2-25 = (if p-find-next then "true":u else "false":u )
     3236         parameter-3-25 =  "FOR EACH temp-goods"
     3237         parameter-4-25 =
     3238           (
     3239             if (" TRUE " + " " + where-phrase-25) <> ""
     3240             then " TRUE " + " " + where-phrase-25
     3241             else "true"
     3242           )
     3243         parameter-5-25 = (" " + "" + " " + ", EACH temp-scaleable WHERE temp-scaleable.b-code = temp-goods.gds-code NO-LOCK" + " " + p-find-condition)
     3244         parameter-6-25 = if sort-phrase-25 = ''
     3245                              then
     3246           (
     3247           " " + " " +
     3248             " " + sort-column-phrase +
     3249           " " + "  "
     3250           )
     3251                              else
     3252           (
     3253           " " + " " +
     3254             " " + sort-column-phrase +
     3255           " " + sort-phrase-25
     3256           )
     3257         parameter-7-25 =
     3258           "   "
     3259       .
     3260         run fltopend_fltfindq in this-procedure  (
     3261                             input this-procedure:handle
     3262                             ,input QUERY BR-pbc:handle
     3263                             ,input logical(parameter-2-25)
     3264                             ,input no-lock
     3265                             ,input parameter-3-25
     3266                             ,input parameter-4-25
     3267                             ,input parameter-5-25
     3268                             ,input parameter-6-25
     3269                             ,input parameter-7-25
     3270                             ,output v-fltopend-rowid
     3271                             ) no-error.
     3272         .
     3273         v-doc-rec = ?.
     3274       end.
     3275       assign
     3276         l-query-was-opened = true
     3277       .
     3278     end.
     3279   end.
     3280     run waitfram-hide in this-procedure .
     3281   END.
     3282   WHEN "2":U  THEN DO:
     3283       assign
     3284       frame Dialog-Frame:title = title0 + chr(32) + varobj-type + chr(32) + string(varobj-code)
     3285       filter-label = substitute("&1", filter-label0)
     3286       .
     3287   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
