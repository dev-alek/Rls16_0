     2994     Rs-SOrt
     2995     b-quit
     2996     b-add
     2997     b-del
     2998     B-mark when lookup("b-mark":U, bttns) > 0
     2999     B-sel when lookup("b-sel":U, bttns) > 0
     3000     B-gds
     3001     B-sch
     3002     B-print
     3003     B-Help
     3004     BR-pbc
     3005     mark-num
     3006     var-prod
     3007     var-prod-name
     3008     r-obj
     3009     T-object
