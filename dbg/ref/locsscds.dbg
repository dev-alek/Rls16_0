     1244   DEFINE buffer TEMP-SCALEABLE for TEMP0-SCALEABLE.
     1245   FUNCTION get-price RETURNS DECIMAL
     1246     ( input parobj-type as character, input parobj-code as integer, parb-code as integer )  FORWARD.
     1247   DEFINE BUTTON B-add
     1248        LABEL "&Добавить"
     1249        SIZE 10 BY 1.
     1250   DEFINE BUTTON B-del
     1251        LABEL "&Удалить"
     1252        SIZE 10 BY 1.
     1253   DEFINE BUTTON B-gds
     1254        LABEL "&Товар"
     1255        SIZE 10 BY 1.
     1256   DEFINE BUTTON B-Help
     1257        LABEL "Помо&щь"
     1258        SIZE 3 BY 1
     1259        BGCOLOR 8 .
     1260   DEFINE BUTTON B-mark
     1261        LABEL "&*"
     1262        SIZE 3 BY 1.
     1263   DEFINE BUTTON B-print
     1264        LABEL "Пе&чать"
     1265        SIZE 3 BY 1.
     1266   DEFINE BUTTON b-quit AUTO-END-KEY
     1267        LABEL "&Выход"
     1268        SIZE 10 BY 1
     1269        BGCOLOR 8 .
