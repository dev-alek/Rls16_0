      931     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      932     do
      933     on error undo, return error return-value
      934     :
      935       find first buf_userobjs_temp-user-obj
      936         no-error .
      937       if not available buf_userobjs_temp-user-obj
      938       then do:
      939         assign
      940           p-object-exist = false
      941         .
      942       end.
      943       else do:
