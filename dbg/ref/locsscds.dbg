      946         .
      947       end.
      948     end.
      949   end.
      950   procedure userobjs_transfer :
      951     define input  parameter p-callback-handle as handle no-undo .
      952     define variable vss-description as character no-undo init "userobjs_transfer: Передача списка объектов".
      953     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      954     do
      955     on error undo, return error return-value
      956     :
      957       if valid-handle(p-callback-handle) <> true
      958       then do:
      959         message
      960           vss-workfile vss-revision vss-description skip
      961           "Ошибка задания входных параметров" skip
      962           "Неизвестный указатель на процедуру" skip
      963           view-as alert-box error .
      964         undo, return error return-value .
      965       end.
      966       if p-callback-handle :get-signature("userobjs_append") = ""
      967       then do:
      968         message
      969           vss-workfile vss-revision vss-description skip
      970           "Ошибка задания входных параметров" skip
      971           substitute("В процедуре &1 не найдена внутренняя процедура userobjs_append"
      972                     ,p-callback-handle :file-name
      973                     ) skip
      974           view-as alert-box error .
      975         undo, return error return-value .
      976       end.
      977       for each buf_userobjs_temp-user-obj
      978       on error undo, return error return-value
      979       :
      980         run userobjs_append in p-callback-handle
      981           (input  buf_userobjs_temp-user-obj.obj-type
      982           ,input  buf_userobjs_temp-user-obj.obj-code
      983           ) .
      984       end.
      985     end.
      986   end procedure.
