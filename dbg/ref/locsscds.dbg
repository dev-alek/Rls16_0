     2866   MAIN-BLOCK:
     2867   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2868      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2869   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2870     run mainmenu_getcntxt in parparentproc
     2871       (output v-cntxt-db-num
     2872       ,output v-cntxt-userid
     2873       ,output v-cntxt-level
     2874       ,output v-cntxt-host-code-obj
     2875       ,output v-cntxt-obj-type
     2876       ,output v-cntxt-obj-code
     2877       ,output v-cntxt-db-num-obj
     2878       ,output v-cntxt-is-admin
     2879       ) .
     2880     FIND FIRST obj_clients No-LOCK WHERE
     2881                         obj_clients.obj-type = parobj-type AND
     2882                         obj_clients.obj-code = parobj-code
     2883                           no-error
     2884                         .
     2885     if not available obj_clients or
     2886         NOT (parobj-type = 'маг':U or parobj-type = 'скл':U) then do:
     2887           message
     2888           vss-workfile vss-revision vss-description skip
     2889           "Неверное значение параметра parobj-type/parobj-code" parobj-type parobj-code
     2890           view-as alert-box.
     2891           return error.
     2892       end.
     2893     FIND FIRST ub.sysconf No-LOCK WHERE
     2894                         ub.sysconf.host-code = parhost-code no-error.
     2895     if not available ub.sysconf then do:
     2896           message
     2897           vss-workfile vss-revision vss-description skip
     2898           "Неверное значение параметра parhost-code" parhost-code
     2899           view-as alert-box.
     2900           return error.
     2901       end.
     2902       varempty-code = ?.
