      729   procedure prn-lib-open-stream :
      730     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      731     define input parameter p-page-size    as integer no-undo .
      732     define input parameter p-is-stream    as logical no-undo .
      733     define input parameter p-append       as logical no-undo .
      734     define variable v-report-name as character no-undo .
      735     do
      736       on error undo, return error
      737       :
      738       run prn-lib-get-report-name  in this-procedure (
      739         input parParentProc
      740         ,output v-report-name
      741         ).
      742       if p-is-stream then
      743       do:
      744         if p-append then
      745         do:
      746           output stream PrnLibStream to value( v-report-name )
      747             page-size value(p-page-size) append .
      748         end.
      749         if not p-append then
      750         do:
      751           output stream PrnLibStream to value( v-report-name )
      752             page-size value(p-page-size) .
      753         end.
      754       end.
      755       if not p-is-stream then
      756       do:
      757         if p-append then
      758         do:
      759           output to value( v-report-name )
      760             page-size value(p-page-size) append .
      761         end.
      762         if not p-append then
      763         do:
      764           output to value( v-report-name )
      765             page-size value(p-page-size) .
      766         end.
      767       end.
      768     end.
      769   end procedure.
      770   procedure prn-lib-open-exp :
      771     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      772     define input parameter p-is-stream    as logical no-undo .
      773     define input parameter p-is-append    as logical no-undo .
      774     define output parameter p-ReportFileName as char init "report" no-undo.
      775     define output parameter p-process as logical no-undo .
      776     define variable glog as logical no-undo .
      777     do
      778       on error undo, return error
      779       :
      780       SYSTEM-DIALOG GET-FILE p-ReportFileName
      781         TITLE      "Укажите путь"
      782         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      783         ASK-OVERWRITE
      784         CREATE-TEST-FILE
      785         SAVE-AS
      786         USE-FILENAME
      787         DEFAULT-EXTENSION "txt"
      788         UPDATE glog
      789         .
      790       if not glog then  return.
      791       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      792       if p-is-stream then
      793       do:
      794         if p-is-append then
      795         do:
      796           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      797         end.
      798         else
      799         do:
      800           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      801         end.
      802       end.
      803       else
      804       do:
      805         if p-is-append then
      806         do:
      807           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      808         end.
      809         else
      810         do:
      811           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      812         end.
      813       end.
      814       p-process = yes.
      815     end.
      816   end procedure.
