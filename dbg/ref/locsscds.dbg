     2915   RUN disable_UI.
     2916   PROCEDURE disable_UI :
     2917     HIDE FRAME Dialog-Frame.
     2918   END PROCEDURE.
     2919   PROCEDURE enable_UI :
     2920     DISPLAY Rs-sort T-object mark-num varobj-code var-prod var-prod-name
     2921             varobj-type
     2922         WITH FRAME Dialog-Frame.
     2923     ENABLE b-quit B-mark B-sel B-add B-del B-gds B-sch B-print B-Help Rs-sort
     2924            T-object r-obj BR-pbc mark-num varobj-code var-prod var-prod-name
     2925            varobj-type
     2926         WITH FRAME Dialog-Frame.
     2927     VIEW FRAME Dialog-Frame.
     2928   END PROCEDURE.
     2929   PROCEDURE fill-table :
     2930   for each temp-scaleable:
     2931       delete temp-scaleable.
     2932   end.
     2933   for each temp-goods:
     2934       delete temp-goods.
     2935   end.
     2936   _goods:
     2937   FOR EACH ub.goods NO-LOCK,
     2938         EACH ub.units WHERE ub.units.unit-name = ub.goods.unit-base AND
     2939                         LOOKUP('вес':U, ub.units.type) > 0 NO-LOCK,
     2940         EACH ub.bar-code WHERE ub.bar-code.gds-code = ub.goods.gds-code AND
     2941                         ub.bar-code.unit-cli <> ub.goods.unit-base AND
     2942                         ub.bar-code.part-code = "":U and
     2943                         ub.bar-code.node-code = varempty-code NO-LOCK,
     2944         EACH ub.bar_units where ub.bar_units.unit-name = ub.bar-code.unit-cli and
     2945                         bar_units.type = 'дро':U NO-LOCK,
     2946         EACH ub.prod-bc WHERE ub.prod-bc.b-code = ub.bar-code.b-code NO-LOCK
     2947         On error undo, return error
     2948         :
     2949         IF t-object then do:
     2950                   FIND FIRST ub.gds-obj No-LOCK WHERE
     2951                                    ub.gds-obj.gds-code = ub.goods.gds-code and
     2952                                    ub.gds-obj.obj-type = varobj-type AND
     2953                                    ub.gds-obj.obj-code = varobj-code No-ERROR.
     2954                       if not avail ub.gds-obj then NEXT _goods.
     2955                 end.
     2956         FIND FIRST temp-goods no-lock where
     2957                    temp-goods.gds-code = ub.goods.gds-code no-error .
     2958         if not avail temp-goods then do:
     2959           create temp-goods.
     2960           buffer-copy goods to temp-goods.
     2961         end.
     2962        create temp-scaleable.
     2963       assign
     2964       temp-scaleable.b-code = ub.goods.gds-code
     2965       temp-scaleable.b-str  = ub.prod-bc.b-str
     2966       temp-scaleable.prod-bc-rec = recid(ub.prod-bc)
     2967           temp-scaleable.unit-cli  = ub.bar-code.unit-cli
     2968       .
     2969   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2970   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prodbcat in g#library
     2971     (buffer ub.prod-bc
     2972     ,input  'global=request':u
     2973     ,output temp-scaleable.is-global
     2974     ) no-error .
     2975       temp-scaleable.price-sale = get-price(varobj-type, varobj-code, ub.bar-code.b-code).
     2976   End.
     2977   END PROCEDURE.
     2978   PROCEDURE get-gds-rec :
     2979   DEFINE BUFFER loc_goods for ub.goods.
     2980   FIND FIRST loc_goods No-LOCK WHERE
     2981                       loc_goods.gds-code = temp-goods.gds-code no-error.
     2982   if available loc_goods then gds-rec = recid(loc_goods).
     2983   else gds-rec = ?.
     2984   END PROCEDURE.
     2985   PROCEDURE MyEnable :
     2986    DISPLAY
     2987    mark-num
     2988    var-prod
     2989    var-prod-name
     2990    varobj-code
     2991    varobj-type
     2992    WITH FRAME Dialog-Frame.
