      143   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      144   procedure cur-time :
      145      define output parameter p-today as date      no-undo .
      146      define output parameter p-time  as integer   no-undo .
      147     do
      148     on error undo, return error
      149     :
      150       define variable v-date1 as date      no-undo .
      151       define variable v-date2 as date      no-undo .
      152       define variable v-time  as integer   no-undo .
      153       assign
      154         v-date1 = today
      155         v-time  = time
      156         v-date2 = today
      157       .
      158       if v-date1 <> v-date2
      159       then do:
      160         assign
      161           v-date1 = today
      162           v-time  = v-time
      163         .
      164       end.
      165       assign
      166         p-today = v-date1
      167         p-time  = v-time
      168       .
      169     end.
      170   end.
      171   function cur-time-date returns character
      172   :
      173     return string(today, '99/99/9999':U) .
      174   end.
      175   function cur-time-mjd returns decimal
      176   :
      177     define variable v-date as date      no-undo .
      178     define variable v-time as integer   no-undo .
      179     run cur-time in this-procedure
      180       (output v-date
      181       ,output v-time
      182       ) .
      183     return integer(v-date) - 2400002 + (v-time / 86400) .
      184   end.
      185   function cur-time-get-ending-index returns integer
      186   (input p-number as integer
      187   )
      188   :
      189     if p-number < 0
      190     or p-number = ?
      191     then do:
      192       return 1 .
      193     end.
      194     define variable v-rest as integer   no-undo .
      195     assign
      196       p-number = p-number modulo 100
      197     .
      198     if p-number < 20
      199     then do:
      200       assign
      201         v-rest = p-number
      202       .
      203     end.
      204     else do:
      205       assign
      206         v-rest = p-number modulo 10
      207       .
      208     end.
      209     case v-rest :
      210       when 1
      211       then do:
      212         return 2 .
      213       end.
      214       when 2 or
      215       when 3 or
      216       when 4
      217       then do:
      218         return 3 .
      219       end.
      220       otherwise do:
      221         return 1 .
      222       end.
      223     end case .
      224   end.
      225   procedure cur-time-mjd-to-date :
      226      define input  parameter i-mjd-diff as decimal no-undo.
      227      define output parameter o-Date     as date    no-undo.
      228      define output parameter o-Time     as integer no-undo.
      229      define variable v-day-number as integer   no-undo .
      230      if    i-mjd-diff < 0
      231         or i-mjd-diff = ?
      232      then do:
      233         return "?" .
      234      end.
      235      assign
      236         v-day-number = truncate(i-mjd-diff,0).
      237         o-Date = date(v-day-number + 2400002).
      238         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      239     .
      240   end.
      241   function cur-time-mjd-to-string returns character
      242   (input p-mjd-diff as decimal
      243   )
      244   :
      245     define variable v-day-number as integer   no-undo .
      246     define variable v-seconds    as integer   no-undo .
      247     define variable v-hour       as integer   no-undo .
      248     define variable v-min        as integer   no-undo .
      249     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      250     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      251     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      252     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      253     if p-mjd-diff < 0
      254     or p-mjd-diff = ?
      255     then do:
      256       return "?" .
      257     end.
      258     assign
      259       v-day-number = integer(truncate(p-mjd-diff,0))
      260       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      261     .
      262     if v-seconds > 86400
      263     then do:
      264       assign
      265         v-seconds = 86400 - 1
      266       .
      267     end.
      268     if v-seconds < 0
      269     then do:
      270       assign
      271         v-seconds = 0
      272       .
      273     end.
      274     assign
      275       v-hour = truncate(v-seconds / 3600, 0)
      276     .
      277     assign
      278       v-seconds = v-seconds modulo 3600
      279     .
      280     assign
      281       v-min = truncate(v-seconds / 60, 0)
      282     .
      283     assign
      284       v-seconds = v-seconds modulo 60
      285     .
      286     return
      287         (if v-day-number <> 0
      288           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      289           else ""
      290         )
      291       + (if v-day-number <> 0 or v-hour <> 0
      292           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      293           else ""
      294         )
      295       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      296           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      297           else ""
      298         )
      299       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      300       .
      301   end.
      302   function cur-time-string returns character
      303   :
      304     define variable v-date as date      no-undo .
      305     define variable v-time as integer   no-undo .
      306     run cur-time in this-procedure
      307       (output v-date
      308       ,output v-time
      309       ) .
      310     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      311   end.
      312   function cur-time-string-sec returns character
      313   :
      314     define variable v-date as date      no-undo .
      315     define variable v-time as integer   no-undo .
      316     run cur-time in this-procedure
      317       (output v-date
      318       ,output v-time
      319       ) .
      320     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      321   end.
      322   function cur-time-custom  returns character
      323   (input p-prefix as character
      324   ,input p-date-format as character
      325   ,input p-delimiter as character
      326   ,input p-time-format as character
      327   ,input p-suffix as character
      328   )
      329   :
      330     define variable v-date as date      no-undo .
      331     define variable v-time as integer   no-undo .
      332     run cur-time in this-procedure
      333       (output v-date
      334       ,output v-time
      335       ) .
      336     return
      337       p-prefix
      338       + string(v-date, p-date-format)
      339       + p-delimiter
      340       + string(v-time, p-time-format)
      341       + p-suffix
      342       .
      343   end.
      344   function cur-time-print  returns character
      345   :
      346     define variable v-date as date      no-undo .
      347     define variable v-time as integer   no-undo .
      348     run cur-time in this-procedure
      349       (output v-date
      350       ,output v-time
      351       ) .
      352     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      353   end.
      354   function cur-time-datetime returns datetime
      355   :
      356     define variable v-char as character no-undo .
      357     define variable v-datetime as datetime no-undo .
      358     v-char = cur-time-string().
      359     v-datetime = datetime(v-char).
      360     return  v-datetime.
      361   end.
      362   function cur-time-string-msec returns character
      363   :
      364     define variable v-date as datetime  no-undo .
      365     v-date = now.
      366     return string(v-date) .
      367   end.
      368   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      369   define new shared variable PrintCopiesCounter as integer   no-undo initial 1 .
      370   define new shared variable RepPathName        as character no-undo .
      371   define new shared variable PrintRubl          as logical   no-undo .
      372   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      373   procedure fltfield-clear :
      374     define output parameter loc-fld as character no-undo.
      375     define output parameter loc-lab as character no-undo .
      376     define output parameter loc-spr as character no-undo .
      377     define output parameter loc-dim as character no-undo .
      378     assign
      379       loc-fld = ""
      380       loc-lab = ""
      381       loc-spr = ""
      382       loc-dim = "0"
      383     .
      384   end procedure .
      385   procedure fltfield-add :
      386     define input        parameter par-fld as character no-undo.
      387     define input        parameter par-lab as character no-undo .
      388     define input        parameter par-spr as character no-undo .
      389     define input-output parameter loc-fld as character no-undo.
      390     define input-output parameter loc-lab as character no-undo .
      391     define input-output parameter loc-spr as character no-undo .
      392     define input-output parameter loc-dim as character no-undo .
      393     do
      394     on error undo, return error
      395     :
      396       assign
      397       loc-fld = if loc-dim = '0'
      398                 then par-fld
      399                 else (loc-fld + chr(44) + par-fld)
      400       loc-lab = if loc-dim = '0'
      401                 then par-lab
      402                 else (loc-lab + chr(44) + par-lab)
      403       loc-spr = if loc-dim = '0'
      404                 then par-spr
      405                 else (loc-spr + chr(44) + par-spr)
      406       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
      407                 string(integer(if num-entries(loc-dim) > 1
      408                               then entry(2, loc-dim)
      409                               else entry(1, loc-dim)
      410                               ) + 1)
      411       no-error
      412       .
      413     end.
      414   end procedure.
      415   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      416   define variable send-ref as logical no-undo.
      417     define variable dops as character no-undo format "X(250)".
      418     define variable dopst as character no-undo format "X(1)".
      419   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
      420     (input  'send-ref'
      421     ,input  0
      422     ,input  ''
      423     ,input  0
      424     ,input  ''
      425     ,input  ''
      426     ,input  ''
      427     ,input  no
      428     ,output dops
      429     ,output dopst
      430     ) no-error .
      431     send-ref = (IF error-status:error or dops <> "yes" then no else yes).
      432   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      433   define variable v-waitfram-action01         as character   no-undo .
      434   define variable v-waitfram-action02         as character   no-undo .
      435   define variable v-waitfram-action03         as character   no-undo .
      436   define variable mWaitFramTextBeg            as character   no-undo.
      437   define variable mWaitFramTextEnd            as character   no-undo.
      438   define variable mWaitFramView               as logical     no-undo.
      439   define variable mWaitProcEvent              as logical     no-undo init yes.
      440   define variable mWaitFramInterval           as integer     no-undo init 1 .
      441   define variable mWaitFramStop               as logical     no-undo.
      442   define variable mWaitFramStopUser           as logical     no-undo.
      443   define variable mWaitFramStopTimeOut        as logical     no-undo.
      444   define variable mWaitFramStartProc          as datetime-tz no-undo.
      445   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      446   define button B-WaitFramStop auto-end-key
      447        label "Стоп"
      448        size 10 by 1 tooltip "Остоновить процесс".
      449   define button B-viewProcInfo
      450        label "Информация"
      451        size 15 by 1 tooltip "Информация о процесс".
      452   define frame waitfram
      453     v-waitfram-action01 format "x(72)" no-label skip
      454     v-waitfram-action02 format "x(72)" no-label skip
      455     v-waitfram-action03 format "x(72)" no-label skip
      456     B-viewProcInfo
      457     B-WaitFramStop at row 4 col 30
      458     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      459     .
      460   define new global shared variable mBatchMode as logical no-undo init ?.
      461   define variable mFramBachModHandle as handle no-undo.
      462   mFramBachModHandle = frame waitfram:handle.
      463   define variable mFameOldVis as logical no-undo.
      464   define variable mVisCUrentVin as logical no-undo.
      465   if session:batch-mode
      466   then
      467      mBatchMode = yes.
      468   if mBatchMode = ? then do:
      469     mVisCUrentVin = current-window:visible.
      470     mFameOldVis = mFramBachModHandle:visible.
      471     mFramBachModHandle:visible  = yes.
      472     mBatchMode = mFramBachModHandle:visible ne yes.
      473     mFramBachModHandle:visible = mFameOldVis.
      474     current-window:visible = mVisCUrentVin.
      475   end.
      476    if  log-manager:logfile-name ne ?
      477     then DO:
      478         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      479         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      480         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      481     end.
      482   on choose of B-WaitFramStop in frame waitfram
      483   do:
      484     mWaitFramStop = yes.
      485     mWaitFramStopUser = yes.
      486   end.
      487   function waitfram-check-timeout returns logical():
      488      define variable vtime as int64 no-undo.
      489      if mWaitFramStopTimeOut
      490      then
      491         return yes.
      492      vtime = ( now - mWaitFramStartProc ) / 1000 .
      493      if     mWaitFramTimeOut ne ?
      494         and mWaitFramTimeOut ne 0
      495         and mWaitFramTimeOut lt vtime
      496      then do:
      497         mWaitFramStopTimeOut = yes.
      498      end.
      499      return mWaitFramStopTimeOut.
      500   end.
      501   procedure waitfram-hide :
      502     if not session:batch-mode
      503     then do
      504     on error undo, return error return-value
      505     :
      506       pause 0 before-hide .
      507       if not mBatchMode then
      508         hide frame waitfram .
      509     if     not mWaitFramView
      510        and mWaitProcEvent
      511     then
      512       process events .
      513     end.
      514   end procedure.
      515   procedure waitfram-show :
      516     define input  parameter p-message as character no-undo .
      517     define variable v-left-margin as integer   no-undo .
      518     if not session:batch-mode
      519     then do
      520     on error undo, return error return-value
      521     :
      522       if length(p-message) <= 70 then do:
      523         assign
      524           v-left-margin = integer((70 - length(p-message)) / 2)
      525         .
      526         assign
      527           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      528         .
      529         assign
      530           v-waitfram-action01 = " "
      531           v-waitfram-action02 = " "
      532                                    + fill(" ", v-left-margin)
      533                                    + p-message
      534           v-waitfram-action03 = " "
      535         .
      536       end.
      537       else do:
      538         define variable vRindex1 as integer no-undo.
      539         define variable vRindex2 as integer no-undo.
      540         vRindex1 = r-index(p-message," ",70).
      541         if vRindex1 = 0
      542         then
      543            vRindex1 = 70.
      544         if length(p-message)  <= vRindex1 + 70 then do:
      545           assign
      546             v-waitfram-action01 = " "
      547             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      548             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      549           .
      550         end.
      551         else do:
      552           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      553           if vRindex2 <= vRindex1
      554           then
      555              vRindex2 = vRindex1 + 70.
      556           assign
      557             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      558             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      559             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      560           .
      561         end.
      562       end.
      563       B-viewProcInfo:visible   in frame waitfram = no.
      564       B-viewProcInfo:sensitive in frame waitfram = no.
      565       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      566       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      567       if  (   mWaitFramView
      568          or  mWaitProcEvent)
      569          and not mBatchMode
      570       then
      571          display
      572             v-waitfram-action01 skip
      573             v-waitfram-action02 skip
      574             v-waitfram-action03 skip
      575          with frame waitfram .
      576       if     mWaitFramView
      577          then do:
      578             if     mWaitFramInterval ne ?
      579                and not mBatchMode
      580             then
      581                wait-for go of frame waitfram pause mWaitFramInterval.
      582          end.
      583          else
      584             if     mWaitProcEvent
      585                and not mBatchMode
      586             then
      587                process events .
      588     end.
      589   end procedure.
      590      procedure waitfram-show-this:
      591         define input  parameter iInterval as int64 no-undo.
      592         define variable vtime as int64 no-undo.
      593         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      594         mWaitFramInterval = iInterval.
      595         run waitfram-show (substitute("&1&2 &3&4" ,
      596                                       mWaitFramTextBeg ,
      597                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      598                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      599                                       mWaitFramTextEnd
      600                                      )
      601                           ).
      602      end.
      603      procedure WaitFramRunPause:
      604         define input  parameter iInterval as dec no-undo.
      605         define variable vStart  as datetime-tz no-undo.
      606         define variable vend    as datetime-tz no-undo.
      607         define variable vint as int64 no-undo.
      608         define variable vOk as logical no-undo.
      609         vStart = now.
      610         vend   = vStart.
      611         publish "WaitFramPause" (iInterval,output vOk).
      612         vend   =  now.
      613         vint = vend - vStart.
      614         vint = iInterval - vint / 1000.
      615         if     not mWaitFramStop
      616            and (   vint > 0
      617                 or (    not vOk
      618                     and iInterval eq ?
      619                     )
      620                 )
      621         then
      622            run waitfram-show-this (iInterval).
      623         vend   =  now.
      624         vint = vend - vStart.
      625         vint = iInterval - vint / 1000.
      626         if     not mWaitFramStop
      627            and vint > 0
      628         then do:
      629            run gbl/pause.p (vint * 1000).
      630         end.
      631         if iInterval ne ?
      632         then
      633            publish "WaitFramStop".
      634         waitfram-check-timeout().
      635      end.
      636      procedure WaitFramWaitFor:
      637         define input  parameter iInterval as dec no-undo.
      638         assign
      639            mWaitFramStartProc   = now
      640            mWaitFramStopUser    = no
      641            mWaitFramStopTimeOut = no
      642         .
      643         block-wait:
      644         do while not mWaitFramStop:
      645            run WaitFramRunPause (iInterval).
      646            if  waitfram-check-timeout()
      647            then do:
      648               leave block-wait.
      649            end.
      650         end.
      651         run waitfram-hide.
      652      end.
      653   procedure waitfram-join :
      654     define input  parameter p-line-1  as character no-undo .
      655     define input  parameter p-line-2  as character no-undo .
      656     define input  parameter p-line-3  as character no-undo .
      657     define output parameter p-message as character no-undo .
      658     do
      659     on error undo, return error return-value
      660     :
      661       assign
      662         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      663                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      664                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      665       .
      666     end.
      667   end procedure.
      668   function waitfram-join-function returns character
      669     (input p-line-1 as character
      670     ,input p-line-2 as character
      671     ,input p-line-3 as character
      672     ).
      673     define variable v-message as character no-undo .
      674     run waitfram-join in this-procedure
      675       (input  p-line-1
      676       ,input  p-line-2
      677       ,input  p-line-3
      678       ,output v-message
      679       ) .
      680     return v-message .
      681   end function .
      682   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      683   define  stream PrnLibStream.
      684   procedure prn-lib-prn-file :
      685     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      686     define input parameter p-DIsabledoptions as integer no-undo .
