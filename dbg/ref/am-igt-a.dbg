      366   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      367   procedure cur-time :
      368      define output parameter p-today as date      no-undo .
      369      define output parameter p-time  as integer   no-undo .
      370     do
      371     on error undo, return error
      372     :
      373       define variable v-date1 as date      no-undo .
      374       define variable v-date2 as date      no-undo .
      375       define variable v-time  as integer   no-undo .
      376       assign
      377         v-date1 = today
      378         v-time  = time
      379         v-date2 = today
      380       .
      381       if v-date1 <> v-date2
      382       then do:
      383         assign
      384           v-date1 = today
      385           v-time  = v-time
      386         .
      387       end.
      388       assign
      389         p-today = v-date1
      390         p-time  = v-time
      391       .
      392     end.
      393   end.
      394   function cur-time-date returns character
      395   :
      396     return string(today, '99/99/9999':U) .
      397   end.
      398   function cur-time-mjd returns decimal
      399   :
      400     define variable v-date as date      no-undo .
      401     define variable v-time as integer   no-undo .
      402     run cur-time in this-procedure
      403       (output v-date
      404       ,output v-time
      405       ) .
      406     return integer(v-date) - 2400002 + (v-time / 86400) .
      407   end.
      408   function cur-time-get-ending-index returns integer
      409   (input p-number as integer
      410   )
      411   :
      412     if p-number < 0
      413     or p-number = ?
      414     then do:
      415       return 1 .
      416     end.
      417     define variable v-rest as integer   no-undo .
      418     assign
      419       p-number = p-number modulo 100
      420     .
      421     if p-number < 20
      422     then do:
      423       assign
      424         v-rest = p-number
      425       .
      426     end.
      427     else do:
      428       assign
      429         v-rest = p-number modulo 10
      430       .
      431     end.
      432     case v-rest :
      433       when 1
      434       then do:
      435         return 2 .
      436       end.
      437       when 2 or
      438       when 3 or
      439       when 4
      440       then do:
      441         return 3 .
      442       end.
      443       otherwise do:
      444         return 1 .
      445       end.
      446     end case .
      447   end.
      448   procedure cur-time-mjd-to-date :
      449      define input  parameter i-mjd-diff as decimal no-undo.
      450      define output parameter o-Date     as date    no-undo.
      451      define output parameter o-Time     as integer no-undo.
      452      define variable v-day-number as integer   no-undo .
      453      if    i-mjd-diff < 0
      454         or i-mjd-diff = ?
      455      then do:
      456         return "?" .
      457      end.
      458      assign
      459         v-day-number = truncate(i-mjd-diff,0).
      460         o-Date = date(v-day-number + 2400002).
      461         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      462     .
      463   end.
      464   function cur-time-mjd-to-string returns character
      465   (input p-mjd-diff as decimal
      466   )
      467   :
      468     define variable v-day-number as integer   no-undo .
      469     define variable v-seconds    as integer   no-undo .
      470     define variable v-hour       as integer   no-undo .
      471     define variable v-min        as integer   no-undo .
      472     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      473     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      474     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      475     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      476     if p-mjd-diff < 0
      477     or p-mjd-diff = ?
      478     then do:
      479       return "?" .
      480     end.
      481     assign
      482       v-day-number = integer(truncate(p-mjd-diff,0))
      483       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      484     .
      485     if v-seconds > 86400
      486     then do:
      487       assign
      488         v-seconds = 86400 - 1
      489       .
      490     end.
      491     if v-seconds < 0
      492     then do:
      493       assign
      494         v-seconds = 0
      495       .
      496     end.
      497     assign
      498       v-hour = truncate(v-seconds / 3600, 0)
      499     .
      500     assign
      501       v-seconds = v-seconds modulo 3600
      502     .
      503     assign
      504       v-min = truncate(v-seconds / 60, 0)
      505     .
      506     assign
      507       v-seconds = v-seconds modulo 60
      508     .
      509     return
      510         (if v-day-number <> 0
      511           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      512           else ""
      513         )
      514       + (if v-day-number <> 0 or v-hour <> 0
      515           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      516           else ""
      517         )
      518       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      519           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      520           else ""
      521         )
      522       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      523       .
      524   end.
      525   function cur-time-string returns character
      526   :
      527     define variable v-date as date      no-undo .
      528     define variable v-time as integer   no-undo .
      529     run cur-time in this-procedure
      530       (output v-date
      531       ,output v-time
      532       ) .
      533     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      534   end.
      535   function cur-time-string-sec returns character
      536   :
      537     define variable v-date as date      no-undo .
      538     define variable v-time as integer   no-undo .
      539     run cur-time in this-procedure
      540       (output v-date
      541       ,output v-time
      542       ) .
      543     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      544   end.
      545   function cur-time-custom  returns character
      546   (input p-prefix as character
      547   ,input p-date-format as character
      548   ,input p-delimiter as character
      549   ,input p-time-format as character
      550   ,input p-suffix as character
      551   )
      552   :
      553     define variable v-date as date      no-undo .
      554     define variable v-time as integer   no-undo .
      555     run cur-time in this-procedure
      556       (output v-date
      557       ,output v-time
      558       ) .
      559     return
      560       p-prefix
      561       + string(v-date, p-date-format)
      562       + p-delimiter
      563       + string(v-time, p-time-format)
      564       + p-suffix
      565       .
      566   end.
      567   function cur-time-print  returns character
      568   :
      569     define variable v-date as date      no-undo .
      570     define variable v-time as integer   no-undo .
      571     run cur-time in this-procedure
      572       (output v-date
      573       ,output v-time
      574       ) .
      575     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      576   end.
      577   function cur-time-datetime returns datetime
      578   :
      579     define variable v-char as character no-undo .
      580     define variable v-datetime as datetime no-undo .
      581     v-char = cur-time-string().
      582     v-datetime = datetime(v-char).
      583     return  v-datetime.
      584   end.
      585   function cur-time-string-msec returns character
      586   :
      587     define variable v-date as datetime  no-undo .
      588     v-date = now.
      589     return string(v-date) .
      590   end.
      591   define new global shared variable g#lib-Matrix  as handle no-undo .
      592   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      593   procedure gds-ind1 :
      594   main-block:
      595     do
      596   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      597   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      598   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      599     :
      600   define input-output parameter p-doc-rec  as recid no-undo.
      601   define input  parameter p-gds-code                   like  ub.gds-obj-prop.gds-code no-undo.
      602   define input  parameter p-obj-type                   like  ub.gds-obj-prop.obj-type no-undo.
      603   define input  parameter p-obj-code                   like  ub.gds-obj-prop.obj-code no-undo.
      604   define input  parameter p-gdop-igt                   like  ub.gds-obj-prop.gdop-igt no-undo.
      605   define input  parameter p-gdop-assort-min            like  ub.gds-obj-prop.gdop-assort-min  no-undo.
      606   define input  parameter p-gdop-min-stock             like  ub.gds-obj-prop.gdop-min-stock   no-undo.
      607   define input  parameter p-grop-level-always-presence like  ub.gds-obj-prop.grop-level-always-presence  no-undo.
      608   define input  parameter p-grop-max-stock             like  ub.gds-obj-prop.grop-max-stock              no-undo.
      609   define input  parameter p-grop-min-order             like  ub.gds-obj-prop.grop-min-order              no-undo.
      610   define buffer bufs_gds-obj-prop for ub.gds-obj-prop.
      611   define variable v-db-num like ub.db.db-num no-undo .
      612   define variable v-db-num-obj like ub.db.db-num no-undo .
      613   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      614   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
      615     (output v-db-num
      616     )  .
      617   define variable v-date as date no-undo .
      618   define variable v-time as integer no-undo .
      619   run cur-time in this-procedure(output v-date, output v-time).
      620     find first bufs_gds-obj-prop exclusive-lock where
      621               bufs_gds-obj-prop.gds-code          = p-gds-code   and
      622               bufs_gds-obj-prop.obj-type          = p-obj-type   and
      623               bufs_gds-obj-prop.obj-code          = p-obj-code  no-error .
      624       if not available bufs_gds-obj-prop then do:
      625           create bufs_gds-obj-prop.
      626           assign
      627               bufs_gds-obj-prop.gds-code           = p-gds-code
      628               bufs_gds-obj-prop.grop-date-update   = v-date
      629               bufs_gds-obj-prop.grop-time-update   = v-time
      630               bufs_gds-obj-prop.grop-db-num-update = v-db-num
      631               bufs_gds-obj-prop.obj-type           = p-obj-type
      632               bufs_gds-obj-prop.obj-code           = p-obj-code
      633           no-error .
      634           if error-status :error then message "Ошибка при создании записи" error-status :error error-status :get-message(1) .
      635       end.
      636   if  p-gdop-igt                     <> ? then    bufs_gds-obj-prop.gdop-igt                   = p-gdop-igt.
      637   if  p-gdop-assort-min              <> ? then    bufs_gds-obj-prop.gdop-assort-min            = p-gdop-assort-min.
      638   if  p-gdop-min-stock               <> ? then    bufs_gds-obj-prop.gdop-min-stock             = p-gdop-min-stock  .
      639   if  p-grop-level-always-presence   <> ? then    bufs_gds-obj-prop.grop-level-always-presence = p-grop-level-always-presence.
      640   if  p-grop-max-stock               <> ? then    bufs_gds-obj-prop.grop-max-stock             = p-grop-max-stock           .
      641   if  p-grop-min-order               <> ? then    bufs_gds-obj-prop.grop-min-order             = p-grop-min-order           .
      642         p-doc-rec = recid(bufs_gds-obj-prop)    .
      643   end.
      644   end procedure.
      645   FUNCTION Get-Date-Attr RETURN DATE (BUFFER buf_Gds-OP FOR ub.gds-obj-prop) FORWARD.
      646   DEFINE BUFFER buf_AM            FOR ub.Assortment-Matrix.
      647   DEFINE BUFFER buf_AM-goods      FOR ub.Assortment-Matrix-Goods.
      648   DEFINE BUFFER buf_Gds-OP        FOR ub.Gds-obj-prop.
      649   DEFINE BUFFER buf_Gds-OP-Attr   FOR ub.Gds-obj-prop-attr.
      650   DEFINE BUFFER buf_Goods         FOR ub.Goods.
      651   DEFINE BUFFER buf_Clients       FOR ub.Clients.
      652   DEFINE VARIABLE v-Character   AS CHARACTER  NO-UNDO .
      653   DEFINE VARIABLE v-Date        AS DATE       NO-UNDO .
      654   DEFINE VARIABLE v-Decimal     AS DECIMAL    NO-UNDO .
      655   DEFINE VARIABLE v-iInteger    AS INTEGER    NO-UNDO .
      656   DEFINE VARIABLE v-Logical     AS LOGICAL    NO-UNDO .
      657   DEFINE VARIABLE v-Param-Type  AS CHARACTER  NO-UNDO .
      658   DEFINE VARIABLE v-iSrokNewToOsn    AS INTEGER     NO-UNDO INITIAL 0.
      659   DEFINE VARIABLE v-iSrokNaVyvToDel  AS INTEGER     NO-UNDO INITIAL 0.
      660   DEFINE VARIABLE iCountToOsn   AS INTEGER    NO-UNDO INITIAL 0.
      661   DEFINE VARIABLE iCountToDel   AS INTEGER    NO-UNDO INITIAL 0.
      662   DEFINE VARIABLE cListIgt      AS CHARACTER  NO-UNDO INITIAL "".
      663   DEFINE VARIABLE dtDateAttr    AS DATE       NO-UNDO INITIAL ?.
      664   DEFINE VARIABLE i             AS INTEGER    NO-UNDO INITIAL 0.
      665   DEFINE VARIABLE v-Sts         AS INTEGER    NO-UNDO INITIAL 0.
      666   DEFINE VARIABLE iTmpRecId     AS RECID      NO-UNDO INITIAL ?.
      667   DEFINE VARIABLE iTimeBeg      AS INTEGER    NO-UNDO INITIAL 0.
      668   DEFINE VARIABLE iTimeEnd      AS INTEGER    NO-UNDO INITIAL 0.
      669   ASSIGN
      670      iTimeBeg = TIME.
      671   Label-clietns:
      672   FOR EACH buf_Clients WHERE
      673            buf_Clients.Db-num = p-Db-num
      674       NO-LOCK:
      675       EMPTY TEMP-TABLE thbjattr_thbj-attr .
      676       RUN adm/shattri.p (
      677               INPUT  "get":U,
      678               INPUT  buf_Clients.Obj-type,
      679               INPUT  buf_Clients.Obj-Code,
      680               INPUT  'Ass-obj':U,
      681               INPUT  'ass-srokiztdel':U ,
      682               OUTPUT v-Character,
      683               OUTPUT v-Date,
      684               OUTPUT v-Decimal,
      685               OUTPUT v-iSrokNaVyvToDel,
      686               OUTPUT v-Logical,
      687               OUTPUT v-Param-Type,
      688               INPUT-OUTPUT TABLE thbjattr_thbj-attr
      689           ) NO-ERROR.
      690       IF ERROR-STATUS:ERROR THEN DO:
      691          ASSIGN
      692             v-iSrokNaVyvToDel = 0.
      693       END.
      694       EMPTY TEMP-TABLE thbjattr_thbj-attr .
      695       RUN adm/shattri.p (
      696               INPUT  "get":U,
      697               INPUT  buf_Clients.Obj-type,
      698               INPUT  buf_Clients.Obj-Code,
      699               INPUT  'Ass-obj':U,
      700               INPUT  'ass-num-days-igt':U ,
      701               OUTPUT v-Character,
      702               OUTPUT v-Date,
      703               OUTPUT v-Decimal,
      704               OUTPUT v-iSrokNewToOsn,
      705               OUTPUT v-Logical,
      706               OUTPUT v-Param-Type,
      707               INPUT-OUTPUT TABLE thbjattr_thbj-attr
      708           ) NO-ERROR.
      709       IF ERROR-STATUS:ERROR THEN DO:
      710          ASSIGN
      711             v-iSrokNewToOsn = 0.
      712       END.
      713       IF v-iSrokNaVyvToDel = 0 AND v-iSrokNewToOsn = 0 THEN DO:
      714          NEXT Label-clietns.
      715       END.
      716       ASSIGN
      717          cListIgt = ""
      718          cListIgt = cListIgt + (IF v-iSrokNaVyvToDel = 0 THEN "" ELSE 'На вывод из ассортимента':U)
      719          cListIgt = cListIgt + (IF cListIgt <> "" AND v-iSrokNewToOsn <> 0  THEN "," ELSE "") +
      720                                (IF v-iSrokNewToOsn = 0  THEN "" ELSE 'Новинка':U).
      721       Label-do:
      722       DO i = 1 TO NUM-ENTRIES(cListIgt):
      723          Label-Gds-Op:
      724          FOR EACH buf_Gds-OP WHERE
      725                   buf_Gds-OP.Obj-type  = buf_Clients.Obj-type
      726               AND buf_Gds-OP.Obj-code  = buf_Clients.Obj-code
      727               AND buf_Gds-OP.Gdop-igt  = ENTRY(i, cListIgt)
      728              NO-LOCK,
      729              FIRST buf_AM-goods WHERE
      730                    buf_AM-goods.Obj-type    = buf_Gds-OP.Obj-type
      731                AND buf_AM-goods.Obj-code    = buf_Gds-OP.Obj-code
      732                AND buf_AM-goods.Gds-code    = buf_Gds-OP.Gds-code
      733                AND buf_AM-goods.Asmg-Status = 0
      734              NO-LOCK,
      735              FIRST buf_AM WHERE
      736                    buf_AM.Asmt-id     = buf_Am-goods.Asmt-id
      737                AND buf_AM.Db-num      = buf_Clients.Db-num
      738                AND buf_AM.Asmt-Status = 0
      739                AND buf_AM.Asmt-type   = 'Объект':U
      740              NO-LOCK:
      741              ASSIGN
      742                 dtDateAttr = Get-Date-Attr(BUFFER buf_Gds-OP).
      743              IF dtDateAttr = ? THEN DO:
      744                 NEXT Label-gds-op.
      745              END.
      746              IF ENTRY(i, cListIgt) = 'На вывод из ассортимента':U AND (TODAY - dtDateAttr >= v-iSrokNaVyvToDel) THEN DO:
      747                 ASSIGN
      748                    v-sts = ? .
      749   if (valid-handle(g#lib-Matrix) <> true) then do:   run ref/gds-mat1.p persistent no-error .   if error-status :error or (valid-handle(g#lib-Matrix) <> true) then do:     message       "Error starting library.p" skip       g#lib-Matrix skip       g#lib-Matrix :type skip       g#lib-Matrix :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run main_gds-mat2 in g#lib-Matrix
      750    (input this-procedure
      751    ,input recid(buf_AM-Goods)
      752    ,input-output v-Sts
      753    ,input false
      754     ) no-error .
      755                 IF ERROR-STATUS:ERROR THEN DO:
      756                    RUN write-to-log in p-Log-handle(
      757                       chr(10) + PROGRAM-NAME(1) + " " + ERROR-STATUS:GET-MESSAGE(1) + " " + RETURN-VALUE
      758                        ).
      759                    NEXT Label-gds-op.
      760                 END.
      761                 IF (RETURN-VALUE <> ? AND RETURN-VALUE <> "")  THEN DO:
      762                    NEXT Label-gds-op.
      763                 END.
      764                 ASSIGN
      765                    iCountToDel = iCountToDel + 1.
      766              END.
      767              IF ENTRY(i, cListIgt) = 'Новинка':U AND (TODAY - dtDateAttr >= v-iSrokNewToOsn) THEN DO:
      768                 ASSIGN
      769                    iTmpRecId = RECID(buf_Gds-OP).
      770                 RUN gds-ind1 (
      771                     input-output iTmpRecId,
      772                     buf_Gds-OP.gds-code,
      773                     buf_Gds-OP.obj-type,
      774                     buf_Gds-OP.obj-code,
      775                     'Основная группа':U,
      776                     ?,
      777                     ?,
      778                     ?,
      779                     ?,
      780                     ?
      781                     ) NO-ERROR.
      782                 IF ERROR-STATUS:ERROR THEN DO:
      783                    RUN write-to-log in p-Log-handle(
      784                       chr(10) + PROGRAM-NAME(1) + " " + ERROR-STATUS:GET-MESSAGE(1) + " " + RETURN-VALUE
      785                        ).
      786                    NEXT Label-gds-op.
      787                 END.
      788                 ASSIGN
      789                    iCountToOsn = iCountToOsn + 1.
      790              END.
      791          END.
      792       END.
      793   END.
      794   ASSIGN
      795      iTimeEnd = TIME.
      796   IF iTimeEnd < iTimeBeg THEN DO:
      797      ASSIGN
      798         iTimeEnd = iTimeEnd + (24 * 60 * 60).
      799   END.
      800   RUN write-to-log in p-Log-handle(
      801       chr(10) +
      802       "Количество товаров выведенных из ассортиментных матриц = " + STRING(iCountToDel)   + chr(10) +
      803       'Количество товаров переведенных в "Основную группу"    = ' + STRING(iCountToOsn)   + chr(10) +
      804       "Время работы процедуры " + PROGRAM-NAME(1) + " = "  + STRING(iTimeEnd - iTimeBeg, "HH:MM:SS" ) + chr(10) +
      805       ""
      806       ).
      807   RETURN.
      808   FUNCTION Get-Date-Attr RETURN DATE (BUFFER buf_Gds-OP FOR ub.gds-obj-prop):
      809      DEFINE VARIABLE dtRet AS DATE NO-UNDO INITIAL ?.
      810      DEFINE BUFFER buf_Gds-OP-attr FOR ub.gds-obj-prop-Attr.
      811      FIND FIRST buf_Gds-OP-attr WHERE
      812                 buf_gds-OP-attr.gds-code  = buf_gds-OP.gds-code
      813             AND buf_gds-op-attr.obj-code  = buf_gds-OP.obj-code
      814             AND buf_gds-op-attr.obj-type  = buf_gds-op.obj-type
      815             AND buf_gds-op-attr.attr-code = 'CorrIztDel':U
      816           NO-LOCK NO-ERROR.
      817      IF AVAILABLE buf_gds-op-attr THEN DO:
      818         ASSIGN
      819            dtRet = DATE(buf_gds-op-attr.Attr-value)
      820            NO-ERROR.
      821         IF ERROR-STATUS:ERROR THEN DO:
      822            ASSIGN dtRet = ?.
      823         END.
      824      END.
      825      RETURN (dtRet).
      826   END FUNCTION.
