        1   define input-output  parameter p-gen-marg    as character   no-undo .
        2   define input-output  parameter p-gen-marg-parts  as character   no-undo .
        3   define input-output  parameter p-objfirst    as integer     no-undo .
        4   define input-output  parameter p-objsecond   as integer     no-undo .
        5   define input-output  parameter p-pr-nakl     as logical     no-undo .
        6   define input  parameter p-ext-doc-type as character no-undo .
        7   define variable vss-revision    as character no-undo init "$Revision$":U .
        8   define variable vss-author      as character no-undo init "$Author$":U .
        9   define variable vss-date        as character no-undo init "$Date$":U .
       10   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       11   define variable vss-archive     as character no-undo init "$Archive$":U .
       12   define variable vss-description as character no-undo init "Параметры настройки автопереоценки".
       13   procedure vss-get-info :
       14     define output parameter p-vss-revision    like vss-revision    no-undo .
       15     define output parameter p-vss-author      like vss-author      no-undo .
       16     define output parameter p-vss-date        like vss-date        no-undo .
       17     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       18     define output parameter p-vss-archive     like vss-archive     no-undo .
       19     define output parameter p-vss-description like vss-description no-undo .
       20     assign
       21       p-vss-revision    = vss-revision
       22       p-vss-author      = vss-author
       23       p-vss-date        = vss-date
       24       p-vss-workfile    = vss-workfile
       25       p-vss-archive     = vss-archive
       26       p-vss-description = vss-description
       27     .
       28   end procedure.
       29   procedure vss-get-parameters :
       30     define output parameter p-vss-parameters as character no-undo .
       31   end procedure.
       32   define new global shared variable g#vssrevis-logger as handle    no-undo .
       33   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       34   define variable v-vssrevis-logger                   as handle    no-undo .
       35   procedure vss-logevent :
       36     define input  parameter p-extra-paramters as character no-undo .
       37     define variable v-vssrevis-parameters as character no-undo .
       38     do
       39     on error undo, return error return-value
       40     :
       41       if  valid-handle(v-vssrevis-logger)
       42       and v-vssrevis-logger :get-signature("logevent") <> ""
       43       then do:
       44         run vss-get-parameters in this-procedure
       45           (output v-vssrevis-parameters
       46           ).
       47         run logevent in v-vssrevis-logger
       48           (input vss-workfile
       49           ,input vss-revision
       50           ,input v-vssrevis-parameters
       51           ,input p-extra-paramters
       52           ).
       53       end.
       54     end.
       55   end procedure.
       56   assign
       57     v-vssrevis-logger = g#vssrevis-logger
       58   .
       59   if  valid-handle(v-vssrevis-logger)
       60   and v-vssrevis-logger :get-signature("logevent") <> ""
       61   then do:
       62     assign
       63       v-vssrevis-logevent = true
       64     .
       65     run vss-logevent in this-procedure (input vss-description) .
       66   end.
       67   define new global shared variable g#language as character no-undo .
       68   if g#language <> '' and g#language <> 'rus':U then do:
       69     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       70   end.
       71   procedure proc-alt-shift-f2:
       72     if not ibs.th.gbl.gbl-var:rcode
       73   then
       74     run gbl\inidebug.p .
       75   end.
       76   procedure proc-alt-shift-f3:
       77     run gbl/prvssinf.p
       78       ( input this-procedure
       79       ) .
       80   end.
       81   define variable v-inform-launched as logical no-undo initial false .
       82   procedure proc-alt-shift-f4:
       83     define variable v-action as character no-undo .
       84     if v-inform-launched = false then do:
       85       assign
       86         v-inform-launched = true
       87       .
       88       run gbl/d-inform.w
       89         (  input self
       90         ,  input this-procedure
       91         , output v-action
       92         ) no-error .
       93       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       94       assign
       95         v-inform-launched = false
       96       .
       97     end.
       98   end.
       99   procedure proc-alt-f1:
      100     run gbl/corrhelp.p
      101       (input this-procedure
      102       ) .
      103   end .
      104   on alt-shift-f2 anywhere do:
      105     run proc-alt-shift-f2.
      106   end.
      107   on alt-shift-f3 anywhere do:
      108     run proc-alt-shift-f3 in this-procedure .
      109   end.
      110   on alt-shift-f4 anywhere do:
      111     run proc-alt-shift-f4 in this-procedure.
      112   end.
      113   on alt-f1 anywhere do:
      114     run proc-alt-f1 in this-procedure .
      115   end.
      116   DEFINE BUTTON B-Cancel AUTO-END-KEY
      117        LABEL "&Отмена"
      118        SIZE 10 BY 1
      119        BGCOLOR 8 .
      120   DEFINE BUTTON B-Help
      121        LABEL "&Help"
      122        SIZE 10 BY 1
      123        BGCOLOR 8 .
      124   DEFINE BUTTON B-OK AUTO-GO
      125        LABEL "&Ввод"
      126        SIZE 10 BY 1
      127        BGCOLOR 8 .
      128   DEFINE VARIABLE gen-marg AS CHARACTER
      129        VIEW-AS RADIO-SET VERTICAL
      130        RADIO-BUTTONS
      131             "Нет           (No-margin)", "No-margin",
      132   "До прихода    (Before-margin)", "Before-margin",
      133   "После прихода (After-margin)", "After-margin"
      134        SIZE 32.75 BY 2.5 NO-UNDO.
      135   DEFINE VARIABLE gen-marg-parts AS CHARACTER
      136        VIEW-AS RADIO-SET VERTICAL
      137        RADIO-BUTTONS
      138             "Нет           (No-margin)", "No-margin",
      139   "После прихода (After-margin)", "After-margin"
      140        SIZE 32.75 BY 1.5 NO-UNDO.
      141   DEFINE VARIABLE objfirst AS INTEGER
      142        VIEW-AS RADIO-SET VERTICAL
      143        RADIO-BUTTONS
      144             "только по текущему объекту", 0,
      145   "по всей группе распространения", 1
      146        SIZE 50 BY 1.96 NO-UNDO.
      147   DEFINE VARIABLE objsecond AS INTEGER
      148        VIEW-AS RADIO-SET VERTICAL
      149        RADIO-BUTTONS
      150             "только по текущему объекту", 0,
      151   "по всей группе распространения", 1
      152        SIZE 50 BY 1.63 NO-UNDO.
      153   DEFINE VARIABLE pr-nakl AS LOGICAL INITIAL no
      154        LABEL "Назначать продажную цену прямо в документе прихода"
      155        VIEW-AS TOGGLE-BOX
      156        SIZE 56 BY .83 NO-UNDO.
      157   DEFINE FRAME Dialog-Frame
      158        B-OK AT ROW 1 COL 1
      159        B-Cancel AT ROW 1 COL 11
      160        B-Help AT ROW 1 COL 56
      161        gen-marg AT ROW 3 COL 3.38 NO-LABEL WIDGET-ID 2
      162        gen-marg-parts AT ROW 6.75 COL 3.38 NO-LABEL WIDGET-ID 22
      163        objfirst AT ROW 9.29 COL 3.38 NO-LABEL WIDGET-ID 10
      164        objsecond AT ROW 12.88 COL 3.38 NO-LABEL WIDGET-ID 14
      165        pr-nakl AT ROW 15.92 COL 3.38 WIDGET-ID 20
      166        "Тип автопереоценки" VIEW-AS TEXT
      167             SIZE 19 BY .67 AT ROW 2.25 COL 2 WIDGET-ID 6
      168             FGCOLOR 4
      169        "Способ формирования автопереоценки по новому товару" VIEW-AS TEXT
      170             SIZE 52 BY .67 AT ROW 8.54 COL 2 WIDGET-ID 8
      171             FGCOLOR 4
      172        "Способ формирования автопереоценки по НЕ новому товару" VIEW-AS TEXT
      173             SIZE 59 BY .67 AT ROW 12.13 COL 2 WIDGET-ID 18
      174             FGCOLOR 4
      175        "Автопереоценка по ПАРТИЯМ " VIEW-AS TEXT
      176             SIZE 28.5 BY .67 AT ROW 6 COL 2 WIDGET-ID 26
      177             FGCOLOR 4
      178        SPACE(36.99) SKIP(12.86)
      179       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      180            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      181            TITLE "<insert dialog title>"
      182            DEFAULT-BUTTON B-OK CANCEL-BUTTON B-Cancel WIDGET-ID 100.
      183   ASSIGN
      184          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      185          FRAME Dialog-Frame:HIDDEN           = TRUE.
      186   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      187   DO:
      188     APPLY "END-ERROR":U TO SELF.
      189   END.
      190   ON CHOOSE OF B-Help IN FRAME Dialog-Frame
      191   OR HELP OF FRAME Dialog-Frame
      192   DO:
      193   END.
      194   ON CHOOSE OF B-OK IN FRAME Dialog-Frame
      195   DO:
      196     assign
      197       gen-marg
      198       gen-marg-parts
      199       objfirst
      200       objsecond
      201       pr-nakl
      202       .
      203     assign
      204       p-gen-marg       = gen-marg
      205       p-gen-marg-parts = gen-marg-parts
      206       p-objfirst       = objfirst
      207       p-objsecond      = objsecond
      208       p-pr-nakl        = pr-nakl
      209       .
      210   END.
      211   ON VALUE-CHANGED OF gen-marg IN FRAME Dialog-Frame
      212   DO:
      213   assign gen-marg .
      214     if gen-marg <> 'before-margin':U then do:
      215       hide pr-nakl .
      216     end.
      217     else do:
      218       display pr-nakl with frame Dialog-Frame.
      219     end.
      220   END.
      221   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      222   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      223   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      224   on help of frame Dialog-Frame
      225   do:
      226     run gbl/app_help.p
      227       (input this-procedure :file-name
      228       ,input ''
      229       ,input ?
      230       ) no-error.
      231     if error-status :error then do:
      232       message
      233         "Ошибка при вызове помощи"
      234         error-status :get-message(1)
      235         view-as alert-box .
      236     end.
      237   end.
      238   run minbtn-set in this-procedure .
      239   on choose of b-help in frame Dialog-Frame
      240   do:
      241     apply "help":u to frame Dialog-Frame .
      242   end.
      243   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      244   procedure minbtn-set :
      245       do
      246           on error undo, return error return-value
      247           :
      248           define variable ii              as integer       no-undo .
      249           define variable fh              as widget-handle no-undo .
      250           define variable hh              as widget-handle no-undo .
      251           define variable v-h             as handle        extent 4 no-undo .
      252           define variable v-name-button   as character     no-undo .
      253           define variable v-help-old-x    as decimal       no-undo .
      254           define variable v-help-old-y    as decimal       no-undo .
      255           define variable v-help-old-size as decimal       no-undo .
      256           define variable v-frame-width   as decimal       no-undo .
      257           define variable jj              as integer       no-undo .
      258           do
      259               on error undo, return error
      260               :
      261               assign
      262                   v-frame-width = frame Dialog-Frame:width - 0.3
      263                   fh            = frame Dialog-Frame:first-child
      264                   hh            = fh:first-child
      265                   ii            = 1
      266                   .
      267               do while valid-handle(hh):
      268                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      269                   do:
      270                       case lc(hh:name) :
      271                           when "b-help" then
      272                               do:
      273                                   hh:load-image-up("cmp/b-help.bmp":u) .
      274                                   hh:load-image-down("cmp/b-help.bmp":u) .
      275                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      276                                   hh:TOOLTIP = "Помощь" .
      277                                   v-help-old-x = hh:column .
      278                                   v-help-old-y = hh:row    .
      279                                   v-help-old-size = hh:width .
      280                                   hh:width-chars = 2.5 .
      281                               end.
      282                           when "b-print" then
      283                               do:
      284                                   hh:load-image("cmp/b-print.bmp":u) .
      285                                   hh:TOOLTIP = "Печать" .
      286                                   v-h[ii] = hh:handle .
      287                                   ii = ii + 1 .
      288                                   hh:width-chars = 3 .
      289                               end.
      290                           when "b-history" or
      291                           when "b-hist" then
      292                               do:
      293                                   hh:load-image("cmp/b-hist.bmp":u) .
      294                                   hh:TOOLTIP = "История" .
      295                                   v-h[ii] = hh:handle .
      296                                   ii = ii + 1 .
      297                                   hh:width-chars = 3 .
      298                               end.
      299                           when "b-sch" then
      300                               do:
      301                                   hh:load-image("cmp/b-sch.bmp":u) .
      302                                   hh:TOOLTIP = "Установка Фильтра" .
      303                                   v-h[ii] = hh:handle .
      304                                   ii = ii + 1 .
      305                                   hh:width-chars = 3 .
      306                               end.
      307                           when "b-hist-user" then
      308                               do:
      309                                   hh:load-image("cmp/b-hist.bmp":u) .
      310                                   hh:TOOLTIP = "История пользователя" .
      311                                   ii = ii + 1 .
      312                               end.
      313                       end case.
      314                   end.
      315                   hh = hh:next-sibling.
      316               end.
      317               b-help:column = v-frame-width - b-help:width-chars.
      318               jj = 0.
      319               repeat ii = 4 to 1 by -1 :
      320                   if valid-handle (v-h[ii] ) then
      321                   do:
      322                       jj  = jj + 1 .
      323                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      324                       v-h[ii]:row    = v-help-old-y .
      325                   end.
      326               end.
      327           end.
      328       end.
      329   end procedure.
      330   MAIN-BLOCK:
      331   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      332      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK :
      333      assign
      334      gen-marg:radio-buttons in frame Dialog-Frame =
      335      "Нет           (No-margin)" + chr(44) +  'no-margin':U + chr(44) +
      336      "До прихода    (Before-margin)" + chr(44) +  'before-margin':U + chr(44) +
      337      "После прихода (After-margin)"  + chr(44) +  'after-margin':U
      338      .
      339      assign
      340      gen-marg-parts:radio-buttons in frame Dialog-Frame =
      341      "Нет           (No-margin)" + chr(44) + 'no-margin':U + chr(44) +
      342      "После прихода (After-margin)" + chr(44) + 'after-margin':U
      343      .
      344       assign
      345         gen-marg       = p-gen-marg
      346         gen-marg-parts = p-gen-marg-parts
      347         objfirst       = p-objfirst
      348         objsecond      = p-objsecond
      349         pr-nakl        = p-pr-nakl
      350         .
      351      assign frame Dialog-Frame:title = "Параметры настройки автопереоценки по " +
      352             entry( lookup( p-ext-doc-type, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U ), 'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U )
      353             .
      354     RUN enable_UI.
      355     WAIT-FOR GO OF FRAME Dialog-Frame.
      356   END.
      357   RUN disable_UI.
      358   PROCEDURE disable_UI :
      359     HIDE FRAME Dialog-Frame.
      360   END PROCEDURE.
      361   PROCEDURE enable_UI :
      362     DISPLAY gen-marg gen-marg-parts objfirst objsecond pr-nakl
      363         WITH FRAME Dialog-Frame.
      364     ENABLE B-OK B-Cancel B-Help gen-marg gen-marg-parts objfirst objsecond
      365            pr-nakl
      366         WITH FRAME Dialog-Frame.
      367     assign gen-marg.
      368     if gen-marg <> 'before-margin':U then do:
      369       hide pr-nakl .
      370     end.
      371     VIEW FRAME Dialog-Frame.
      372   END PROCEDURE.
