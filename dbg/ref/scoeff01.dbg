        1   block-level on error undo, throw.
        2   define input-output parameter par-rid as recid no-undo .
        3   define input parameter par-mode as character no-undo .
        4   define input parameter p-gds-code like ub.s-coeff.gds-code no-undo .
        5   define input parameter p-host-code like ub.s-coeff.host-code no-undo .
        6   define input parameter p-obj-type like ub.s-coeff.obj-type no-undo .
        7   define input parameter p-obj-code like ub.s-coeff.obj-code no-undo .
        8   define input parameter p-s-date like ub.s-coeff.s-date no-undo .
        9   define input parameter p-coeff-value like ub.s-coeff.coeff-value no-undo .
       10   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       11   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       12   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       13   define variable vss-workfile    as character no-undo init "$Workfile: scoeff01.p $":U .
       14   define variable vss-archive     as character no-undo init "$Archive: ref/scoeff01.p $":U .
       15   define variable vss-description as character no-undo init "Сезонный коэффициент для товара".
       16   procedure vss-get-info :
       17     define output parameter p-vss-revision    like vss-revision    no-undo .
       18     define output parameter p-vss-author      like vss-author      no-undo .
       19     define output parameter p-vss-date        like vss-date        no-undo .
       20     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       21     define output parameter p-vss-archive     like vss-archive     no-undo .
       22     define output parameter p-vss-description like vss-description no-undo .
       23     assign
       24       p-vss-revision    = vss-revision
       25       p-vss-author      = vss-author
       26       p-vss-date        = vss-date
       27       p-vss-workfile    = vss-workfile
       28       p-vss-archive     = vss-archive
       29       p-vss-description = vss-description
       30     .
       31   end procedure.
       32   procedure vss-get-parameters :
       33     define output parameter p-vss-parameters as character no-undo .
       34   end procedure.
       35   define new global shared variable g#vssrevis-logger as handle    no-undo .
       36   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       37   define variable v-vssrevis-logger                   as handle    no-undo .
       38   procedure vss-logevent :
       39     define input  parameter p-extra-paramters as character no-undo .
       40     define variable v-vssrevis-parameters as character no-undo .
       41     do
       42     on error undo, return error return-value
       43     :
       44       if  valid-handle(v-vssrevis-logger)
       45       and v-vssrevis-logger :get-signature("logevent") <> ""
       46       then do:
       47         run vss-get-parameters in this-procedure
       48           (output v-vssrevis-parameters
       49           ).
       50         run logevent in v-vssrevis-logger
       51           (input vss-workfile
       52           ,input vss-revision
       53           ,input v-vssrevis-parameters
       54           ,input p-extra-paramters
       55           ).
       56       end.
       57     end.
       58   end procedure.
       59   assign
       60     v-vssrevis-logger = g#vssrevis-logger
       61   .
       62   if  valid-handle(v-vssrevis-logger)
       63   and v-vssrevis-logger :get-signature("logevent") <> ""
       64   then do:
       65     assign
       66       v-vssrevis-logevent = true
       67     .
       68     run vss-logevent in this-procedure (input vss-description) .
       69   end.
       70   define new global shared variable g#language as character no-undo .
       71   if g#language <> '' and g#language <> 'rus':U then do:
       72     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       73   end.
       74   define new global shared variable g#library  as handle no-undo .
       75   define new global shared variable g#library2 as handle no-undo .
       76   define   shared variable g#auto as logical no-undo.
       77   define   shared variable g#news as logical no-undo.
       78   define   shared variable g#oxml as logical no-undo.
       79   define   shared variable g#esys as logical no-undo.
       80   define   shared variable g#news-source-db as integer no-undo.
       81   define   shared variable g#esys-source-esys as integer no-undo.
       82   define   shared variable g#db-num as integer   no-undo .
       83   define   shared variable g#userid as character no-undo .
       84   define   shared variable g#passwd as character no-undo .
       85   define variable var-entry as character no-undo .
       86   define variable v-db-num like ub.db.db-num no-undo .
       87   define buffer buf_clients for ub.clients.
       88   define buffer buf_sysconf for ub.sysconf.
       89   define buffer buf_s-coeff for ub.s-coeff.
       90   if par-mode <> 'ДОБАВЛЕНИЕ':U AND par-mode <> 'ИЗМЕНЕНИЕ':U then do:
       91     message
       92     vss-workfile vss-revision vss-description skip
       93     "Неверный параметр par-mode - " par-mode
       94     view-as alert-box error .
       95     return error '':u.
       96   end.
       97   if p-gds-code = 0
       98   or not can-find(first ub.goods no-lock where
       99                         ub.goods.gds-code = p-gds-code)
      100   then do:
      101     assign
      102     var-entry = "gds-code":U
      103     .
      104     message
      105     vss-workfile vss-revision vss-description skip
      106     "Укажите товар"
      107     view-as alert-box error .
      108     return error var-entry.
      109   end.
      110   if p-host-code <> 0 then do:
      111     find first buf_sysconf no-lock where
      112                 buf_sysconf.host-code = p-host-code no-error .
      113     if not available buf_sysconf then do:
      114       assign
      115       var-entry = "host-code":U
      116       .
      117       message
      118       vss-workfile vss-revision vss-description skip
      119       "Укажите фирму"
      120       view-as alert-box error .
      121       return error var-entry.
      122     end.
      123   end.
      124   if p-obj-type <> "":u
      125   or p-obj-code <> 0 then do:
      126     find first buf_clients no-lock where
      127               buf_clients.obj-type = p-obj-type
      128         AND  buf_clients.obj-code = p-obj-code no-error .
      129     if not available buf_clients
      130     then do:
      131       assign
      132       var-entry = "obj-code":U
      133       .
      134       message
      135       vss-workfile vss-revision vss-description skip
      136       "Укажите объект"
      137       view-as alert-box error .
      138       return error var-entry.
      139     end.
      140     if LOOKUP(p-obj-type, ('маг':U + chr(44) + 'скл':U)) = 0 then do:
      141       assign
      142       var-entry = "obj-type":U
      143       .
      144       message
      145       vss-workfile vss-revision vss-description skip
      146       "Объект может быть только " 'маг':U "или"
      147       view-as alert-box error .
      148       return error var-entry.
      149     end.
      150   end.
      151   if p-coeff-value >= 100 then do:
      152     message
      153     "Значение сезонного коэффициента не может быть больше или равно 100"
      154     view-as alert-box error .
      155     assign
      156     var-entry = "obj-type":U
      157     .
      158     return error var-entry.
      159   end.
      160   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      161   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
      162     (output v-db-num
      163     )  .
      164   _main:
      165   do
      166   on error undo _main, return error
      167   :
      168     CASE par-mode:
      169       when 'ДОБАВЛЕНИЕ':U then do:
      170         find first buf_s-coeff no-lock where
      171                    buf_s-coeff.gds-code = p-gds-code
      172                AND buf_s-coeff.host-code = p-host-code
      173                AND buf_s-coeff.obj-type = p-obj-type
      174                AND buf_s-coeff.obj-code = p-obj-code
      175                AND buf_s-coeff.s-date = p-s-date
      176                no-error .
      177         if available buf_s-coeff then do:
      178           assign
      179           var-entry = "p-gds-code"
      180           .
      181           message
      182           "Для товара" p-gds-code skip
      183           "уже определен сезонный коэффициент" skip
      184           "фирма" p-host-code "объект" p-obj-type p-obj-code "дата" string(string(DAY(p-s-date)) + chr(47) + string(Month(p-s-date)))
      185           view-as alert-box error .
      186           return error var-entry.
      187         end.
      188         create ub.s-coeff.
      189       end.
      190       when 'ИЗМЕНЕНИЕ':U then do:
      191         find first ub.s-coeff exclusive-lock where
      192                   recid(ub.s-coeff) = par-rid no-error .
      193         if not available ub.s-coeff
      194         then do:
      195           assign
      196           var-entry = "gds-code":U
      197           .
      198           message
      199           "Не определен сезонный коэффициент для товара" p-gds-code skip
      200           "фирма" p-host-code "объект" p-obj-type p-obj-code "дата" string(string(DAY(p-s-date)) + chr(47) + string(Month(p-s-date)))
      201           view-as alert-box error .
      202           return error var-entry.
      203         end.
      204         IF ub.s-coeff.host-code <> p-host-code
      205         OR ub.s-coeff.obj-type <> p-obj-type
      206         OR ub.s-coeff.obj-code <> p-obj-code
      207         then do:
      208           assign
      209           var-entry = "obj-code":U
      210           .
      211           message
      212           "Нельзя изменить фирму и/или объект, для которого определен сезонный коэффициент"  skip
      213           "товар" p-gds-code skip
      214           "фирма" p-host-code "объект" p-obj-type p-obj-code "дата" string(string(DAY(p-s-date)) + chr(47) + string(Month(p-s-date)))
      215           view-as alert-box error .
      216           return error var-entry.
      217         end.
      218         IF ub.s-coeff.gds-code <> p-gds-code
      219         then do:
      220           assign
      221           var-entry = "gds-code":U
      222           .
      223           message
      224           "Нельзя изменить товар, для которого определен сезонный коэффициент"  skip
      225           "группа" p-gds-code skip
      226           "фирма" p-host-code "объект" p-obj-type p-obj-code "дата" string(string(DAY(p-s-date)) + chr(47) + string(Month(p-s-date)))
      227           view-as alert-box error .
      228           return error var-entry.
      229         end.
      230       end.
      231     END CASE.
      232     assign
      233     ub.s-coeff.gds-code = p-gds-code
      234     ub.s-coeff.host-code = p-host-code
      235     ub.s-coeff.obj-type = p-obj-type
      236     ub.s-coeff.obj-code = p-obj-code
      237     ub.s-coeff.s-date = p-s-date
      238     ub.s-coeff.coeff-value = p-coeff-value
      239     ub.s-coeff.credate = today
      240     ub.s-coeff.creid = G#userid
      241     par-rid = recid(ub.s-coeff)
      242     .
      243     release ub.s-coeff no-error .
      244     if error-status:error then do:
      245       message
      246       "Ошибка при сохранении записи СЕЗОННОГО КОЭФФИЦИЕНТА"
      247       "товар" p-gds-code skip
      248       "фирма" p-host-code "объект" p-obj-type p-obj-code "дата" string(string(DAY(p-s-date)) + chr(47) + string(Month(p-s-date))) skip
      249       ERROR-STATUS:GET-message(1) skip
      250       return-value
      251        view-as alert-box error.
      252     undo, return error "":U.
      253    end.
      254   end.
