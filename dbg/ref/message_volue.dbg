      629     ghADMProps:ADD-NEW-FIELD('DataTargetEvents':U, 'CHARACTER':U, 0, ?,
      630        'updateState,rowObjectState,fetchBatch,LinkState':U).
      631     ghADMProps:ADD-NEW-FIELD('LogicalObjectName':U, 'CHARACTER':U).
      632     ghADMProps:ADD-NEW-FIELD('PhysicalObjectName':U, 'CHARACTER':U, ?, ?, "":U).
      633     ghADMProps:ADD-NEW-FIELD('LogicalVersion':U, 'CHARACTER':U).
      634     ghADMProps:ADD-NEW-FIELD('PhysicalVersion':U, 'CHARACTER':U, ?, ?, "":U).
      635     ghADMProps:ADD-NEW-FIELD('DynamicObject':U, 'LOGICAL':U).
