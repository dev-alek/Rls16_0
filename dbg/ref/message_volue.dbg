      574   FUNCTION getObjectType RETURNS CHARACTER IN SUPER.
      575     IF VALID-HANDLE(gshRepositoryManager) THEN
      576     DO:
      577       IF TRUE THEN
      578       DO:
      579         IF NOT
      580         DYNAMIC-FUNC('prepareInstance':U IN gshRepositoryManager,
      581                             STRING(THIS-PROCEDURE) + ',':U + STRING(FRAME gDialog:HANDLE),SOURCE-PROCEDURE)
      582         then
      583         DO:
      584           STOP.
      585         END.
      586         ASSIGN
      587           ghADMPropsBuf      = WIDGET-HANDLE(ENTRY(1, THIS-PROCEDURE:ADM-DATA, CHR(1))).
      588           glADMLoadFromRepos = VALID-HANDLE(ghADMPropsBUF).
      589       END.
      590     END.
      591    IF NOT VALID-HANDLE(WIDGET-HANDLE(ENTRY(1,THIS-PROCEDURE:ADM-DATA,CHR(1)))) THEN
      592    DO:
      593     CREATE TEMP-TABLE ghADMProps.
      594     ghADMProps:UNDO    = FALSE.
      595     ghADMProps:ADD-NEW-FIELD('ObjectName':U, 'CHAR':U, 0, ?, '':U).
