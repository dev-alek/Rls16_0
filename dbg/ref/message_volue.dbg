      774   DEFINE VARIABLE ghContainer AS HANDLE NO-UNDO.
      775   ghContainer = FRAME gDialog:HANDLE.
      776       IF NOT glADMLoadFromRepos THEN
      777         RUN start-super-proc ("adm2/smart.p":U).
      778       DEFINE VARIABLE cObjectName AS CHARACTER  NO-UNDO.
      779       DEFINE VARIABLE iStart      AS INTEGER    NO-UNDO.
      780     IF NOT VALID-HANDLE(WIDGET-HANDLE(ENTRY(1,THIS-PROCEDURE:ADM-DATA,CHR(1)))) THEN
      781     DO:
      782       ghADMProps:TEMP-TABLE-PREPARE('ADMProps':U).
      783       ghADMPropsBuf = ghADMProps:DEFAULT-BUFFER-HANDLE.
      784       ghADMPropsBuf:BUFFER-CREATE().
      785       THIS-PROCEDURE:ADM-DATA = STRING(ghADMPropsBuf) + CHR(1) + CHR(1).
      786       cObjectName =  'LogicalObjectName,PhysicalObjectName,DynamicObject,RunAttribute,HideOnInit,DisableOnInit,ObjectLayout':U.
      787   ASSIGN
      788      ghProp = WIDGET-H(ENTRY(1,TARGET-PROCEDURE:ADM-DATA,CHR(1)))
      789      glADMOk = IF ghProp:NAME = 'ADMProps':U OR (ghProp:AVAIL AND ghProp:BUFFER-FIELD('Target':U):BUFFER-VALUE = TARGET-PROCEDURE) THEN TRUE
      790                ELSE ghProp:FIND-FIRST('WHERE Target = WIDGET-H("':U + STRING(TARGET-PROCEDURE) + '")':U)
      791     ghProp:BUFFER-FIELD('InstanceProperties':U):BUFFER-VALUE = cObjectName
      792    .
      793       ASSIGN cObjectName = REPLACE(THIS-PROCEDURE:FILE-NAME, "~\":U, "~/":U)
      794              iStart = R-INDEX(cObjectName, "~/":U) + 1
      795              cObjectName =
      796                   IF R-INDEX(THIS-PROCEDURE:FILE-NAME, ".":U) <= iStart THEN
      797                      SUBSTR(cObjectName, iStart)
      798                   ELSE
      799                      SUBSTR(cObjectName,
      800                             iStart,
      801                             R-INDEX(THIS-PROCEDURE:FILE-NAME, ".":U) - iStart).
      802   ASSIGN
      803      ghProp = WIDGET-H(ENTRY(1,TARGET-PROCEDURE:ADM-DATA,CHR(1)))
      804      glADMOk = IF ghProp:NAME = 'ADMProps':U OR (ghProp:AVAIL AND ghProp:BUFFER-FIELD('Target':U):BUFFER-VALUE = TARGET-PROCEDURE) THEN TRUE
      805                ELSE ghProp:FIND-FIRST('WHERE Target = WIDGET-H("':U + STRING(TARGET-PROCEDURE) + '")':U)
      806     ghProp:BUFFER-FIELD('ObjectName':U):BUFFER-VALUE = cObjectName
      807    .
      808   ASSIGN
      809      ghProp = WIDGET-H(ENTRY(1,TARGET-PROCEDURE:ADM-DATA,CHR(1)))
      810      glADMOk = IF ghProp:NAME = 'ADMProps':U OR (ghProp:AVAIL AND ghProp:BUFFER-FIELD('Target':U):BUFFER-VALUE = TARGET-PROCEDURE) THEN TRUE
      811                ELSE ghProp:FIND-FIRST('WHERE Target = WIDGET-H("':U + STRING(TARGET-PROCEDURE) + '")':U)
      812     ghProp:BUFFER-FIELD('ContainerHandle':U):BUFFER-VALUE = FRAME gDialog:HANDLE
      813    .
      814     END.
      815     ELSE DO:
      816   ASSIGN
      817      ghProp = WIDGET-H(ENTRY(1,TARGET-PROCEDURE:ADM-DATA,CHR(1)))
      818      glADMOk = IF ghProp:NAME = 'ADMProps':U OR (ghProp:AVAIL AND ghProp:BUFFER-FIELD('Target':U):BUFFER-VALUE = TARGET-PROCEDURE) THEN TRUE
      819                ELSE ghProp:FIND-FIRST('WHERE Target = WIDGET-H("':U + STRING(TARGET-PROCEDURE) + '")':U)
      820     ghProp:BUFFER-FIELD('ObjectType':U):BUFFER-VALUE = 'SmartDialog':U
      821     ghProp:BUFFER-FIELD('ContainerType':U):BUFFER-VALUE = 'DIALOG-BOX':U
      822     ghProp:BUFFER-FIELD('PhysicalVersion':U):BUFFER-VALUE = '':U
      823     ghProp:BUFFER-FIELD('PhysicalObjectName':U):BUFFER-VALUE = (IF '':U <> '':U THEN '':U ELSE THIS-PROCEDURE:FILE-NAME)
      824       .
      825     END.
      826   PROCEDURE adm-clone-props :
      827     DEFINE VARIABLE hReposBuffer AS HANDLE     NO-UNDO.
      828     DEFINE VARIABLE hPropTable   AS HANDLE     NO-UNDO.
      829     DEFINE VARIABLE hBuffer      AS HANDLE     NO-UNDO.
      830     DEFINE VARIABLE hTable       AS HANDLE     NO-UNDO.
      831     hReposBuffer = WIDGET-H(ENTRY(1,THIS-PROCEDURE:ADM-DATA,CHR(1))).
      832     IF VALID-HANDLE(hReposBuffer) AND hReposBuffer:NAME <> 'ADMProps':U THEN
      833     DO:
      834       hReposBuffer:FIND-FIRST('WHERE Target = WIDGET-H("':U + STRING(THIS-PROCEDURE) + '")':U)
      835       NO-ERROR.
      836       IF hReposBuffer:AVAIL THEN
      837       DO:
      838         CREATE TEMP-TABLE hPropTable.
      839         hPropTable:CREATE-LIKE(hReposBuffer).
      840         hPropTable:TEMP-TABLE-PREPARE('ADMProps':U).
      841         hBuffer = hPropTable:DEFAULT-BUFFER-HANDLE.
      842         hBuffer:BUFFER-CREATE().
      843         hBuffer:BUFFER-COPY(hReposBuffer).
      844         dynamic-function("deleteProperties":U IN TARGET-PROCEDURE)
      845    .
      846         THIS-PROCEDURE:ADM-DATA = STRING(hBuffer) + CHR(1) + CHR(1).
      847       END.
      848     END.
      849   END PROCEDURE.
      850   PROCEDURE start-super-proc :
      851     DEFINE INPUT PARAMETER pcProcName AS CHARACTER  NO-UNDO.
      852     DEFINE VARIABLE        hProc      AS HANDLE     NO-UNDO.
      853     hProc = SESSION:FIRST-PROCEDURE.
      854     DO WHILE VALID-HANDLE(hProc) AND hProc:FILE-NAME NE pcProcName:
      855       hProc = hProc:NEXT-SIBLING.
      856     END.
      857     IF NOT VALID-HANDLE(hProc) THEN
      858       RUN VALUE(pcProcName) PERSISTENT SET hProc.
      859     THIS-PROCEDURE:ADD-SUPER-PROCEDURE(hProc, SEARCH-TARGET).
      860     RETURN.
      861   END PROCEDURE.
      862     DEFINE VARIABLE cAppService          AS CHARACTER  NO-UNDO.
      863     DEFINE VARIABLE cASDivision          AS CHARACTER  NO-UNDO.
      864     DEFINE VARIABLE cServerOperatingMode AS CHARACTER  NO-UNDO.
      865     IF NOT glADMLoadFromRepos THEN
      866       RUN start-super-proc("adm2/appserver.p":U).
      867    cAppService = DYNAMIC-FUNC('getAppService':U IN TARGET-PROCEDURE)
      868    .
      869     IF SESSION:REMOTE THEN
      870     DO:
      871       ASSIGN cAppService          = '':U
      872              cASDivision          = 'Server':U
      873              cServerOperatingMode = CAPS(SESSION:SERVER-OPERATING-MODE).
      874     END.
      875     ELSE IF cAppService = '':U THEN
      876       ASSIGN cAppService  = '':U.
      877     IF cASDivision = '':U THEN
      878        cServerOperatingMode = 'NONE':U.
      879     ELSE
      880      DYNAMIC-FUNC('setASDivision':U IN TARGET-PROCEDURE,cASDivision)
      881    .
      882   ASSIGN
      883      ghProp = WIDGET-H(ENTRY(1,TARGET-PROCEDURE:ADM-DATA,CHR(1)))
      884      glADMOk = IF ghProp:NAME = 'ADMProps':U OR (ghProp:AVAIL AND ghProp:BUFFER-FIELD('Target':U):BUFFER-VALUE = TARGET-PROCEDURE) THEN TRUE
      885                ELSE ghProp:FIND-FIRST('WHERE Target = WIDGET-H("':U + STRING(TARGET-PROCEDURE) + '")':U)
      886     ghProp:BUFFER-FIELD('ServerOperatingMode':U):BUFFER-VALUE = cServerOperatingMode
      887    .
      888      DYNAMIC-FUNC('setAppService':U IN TARGET-PROCEDURE,cAppService)
      889    .
      890   DEFINE VARIABLE cFields AS CHARACTER NO-UNDO.
      891   IF NOT glADMLoadFromRepos THEN
      892     RUN start-super-proc ("adm2/visual.p":U).
      893     cFields =  REPLACE("Btn_OK":U, " ":U, ",":U).
      894   ASSIGN
      895      ghProp = WIDGET-H(ENTRY(1,TARGET-PROCEDURE:ADM-DATA,CHR(1)))
      896      glADMOk = IF ghProp:NAME = 'ADMProps':U OR (ghProp:AVAIL AND ghProp:BUFFER-FIELD('Target':U):BUFFER-VALUE = TARGET-PROCEDURE) THEN TRUE
      897                ELSE ghProp:FIND-FIRST('WHERE Target = WIDGET-H("':U + STRING(TARGET-PROCEDURE) + '")':U)
      898     ghProp:BUFFER-FIELD('EnabledObjFlds':U):BUFFER-VALUE = cFields
      899    .
      900     IF VALID-HANDLE(gshSessionManager) THEN
      901     DO:
      902       ON HELP OF FRAME gDialog ANYWHERE
      903         RUN contextHelp IN gshSessionManager (INPUT THIS-PROCEDURE, INPUT FOCUS).
      904     END.
      905     ON CTRL-PAGE-UP OF FRAME gDialog ANYWHERE DO:
      906       RUN processAction IN TARGET-PROCEDURE (INPUT "CTRL-PAGE-UP":U).
      907     END.
      908     ON CTRL-PAGE-DOWN OF FRAME gDialog ANYWHERE DO:
      909       RUN processAction IN TARGET-PROCEDURE (INPUT "CTRL-PAGE-DOWN":U).
      910     END.
      911   IF NOT glADMLoadFromRepos THEN
      912   DO:
      913     RUN start-super-proc("adm2/containr.p":U).
      914     RUN modifyListProperty IN TARGET-PROCEDURE
      915                            (TARGET-PROCEDURE,
      916                             'Add':U,
      917                             'ContainerSourceEvents':U,
      918                             'initializeDataObjects':U).
      919     IF  CAN-DO(dynamic-function("getSupportedLinks":U IN TARGET-PROCEDURE)
      920    ,'data-target':U)
      921     AND CAN-DO(dynamic-function("getSupportedLinks":U IN TARGET-PROCEDURE)
      922    ,'data-source':U) THEN
      923       RUN modifyListProperty IN TARGET-PROCEDURE
      924                              (TARGET-PROCEDURE,
      925                               'Add':U,
      926                               'ContainerSourceEvents':U,
      927                               'buildDataRequest':U).
      928     IF NOT CAN-DO(dynamic-function("getSupportedLinks":U IN TARGET-PROCEDURE)
      929    ,'containertoolbar-target':U) THEN
      930       RUN modifyListProperty IN TARGET-PROCEDURE
      931                             (TARGET-PROCEDURE,
      932                              'Add':U,
      933                              'SupportedLinks':U,
      934                              'ContainerToolbar-Target':U).
      935   END.
      936   PAUSE 0 BEFORE-HIDE.
      937   ASSIGN
      938      ghProp = WIDGET-H(ENTRY(1,TARGET-PROCEDURE:ADM-DATA,CHR(1)))
      939      glADMOk = IF ghProp:NAME = 'ADMProps':U OR (ghProp:AVAIL AND ghProp:BUFFER-FIELD('Target':U):BUFFER-VALUE = TARGET-PROCEDURE) THEN TRUE
      940                ELSE ghProp:FIND-FIRST('WHERE Target = WIDGET-H("':U + STRING(TARGET-PROCEDURE) + '")':U)
      941     ghProp:BUFFER-FIELD('WindowFrameHandle':U):BUFFER-VALUE = FRAME gDialog:handle
      942    .
      943   ASSIGN
      944      ghProp = WIDGET-H(ENTRY(1,TARGET-PROCEDURE:ADM-DATA,CHR(1)))
      945      glADMOk = IF ghProp:NAME = 'ADMProps':U OR (ghProp:AVAIL AND ghProp:BUFFER-FIELD('Target':U):BUFFER-VALUE = TARGET-PROCEDURE) THEN TRUE
      946                ELSE ghProp:FIND-FIRST('WHERE Target = WIDGET-H("':U + STRING(TARGET-PROCEDURE) + '")':U)
      947     ghProp:BUFFER-FIELD('DataContainer':U):BUFFER-VALUE = TRUE
      948    .
      949   ASSIGN
      950          FRAME gDialog:SCROLLABLE       = FALSE
      951          FRAME gDialog:HIDDEN           = TRUE.
      952   ASSIGN
      953          mes:AUTO-RESIZE IN FRAME gDialog      = TRUE.
      954   ON WINDOW-CLOSE OF FRAME gDialog
      955   DO:
      956       APPLY "END-ERROR":U TO SELF.
      957     END.
      958   DEFINE VARIABLE iStartPage AS INTEGER NO-UNDO.
      959   IF THIS-PROCEDURE:PERSISTENT THEN
      960   DO:
      961     MESSAGE "A SmartDialog is not intended to be run " + CHR(10) +
      962       "Persistent or to be placed in another ":U + CHR(10) +
      963       "SmartObject at AppBuilder design time."
      964       VIEW-AS ALERT-BOX ERROR.
      965     RUN disable_UI.
      966     DELETE PROCEDURE THIS-PROCEDURE.
      967     RETURN.
      968   END.
      969   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME gDialog:PARENT eq ?
      970     THEN FRAME gDialog:PARENT = ACTIVE-WINDOW.
      971   RUN createObjects.
      972   MAIN-BLOCK:
      973   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      974     ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      975     RUN initializeObject.
      976     WAIT-FOR GO OF FRAME gDialog focus Btn_OK.
      977   END.
      978   RUN destroyObject.
      979   PROCEDURE adm-create-objects :
      980   END PROCEDURE.
      981   PROCEDURE disable_UI :
      982     HIDE FRAME gDialog.
      983   END PROCEDURE.
      984   PROCEDURE enable_UI :
      985           mes = "Слив запрещен! Объем по ТТН " + p-1 + " л превышает свободный объем резервуара " + p-2 + ". " + chr(10) +
      986             "Проверьте введенные данные из ТТН или значение фактического объема в резервуаре".
      987     DISPLAY mes
      988       WITH FRAME gDialog.
      989     ENABLE Btn_OK
      990         WITH FRAME gDialog.
      991     VIEW FRAME gDialog.
      992   END PROCEDURE.
