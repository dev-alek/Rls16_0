      732     ghADMProps:ADD-NEW-FIELD('RunMultiple':U, 'LOGICAL':U, 0, ?, NO).
      733     ghADMProps:ADD-NEW-FIELD('WaitForObject':U, 'HANDLE':U).
      734     ghADMProps:ADD-NEW-FIELD('DynamicSDOProcedure':U, 'CHAR':U, 0, ?,
