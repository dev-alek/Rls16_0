      651   FUNCTION getObjectType RETURNS CHARACTER
      652     ( ) :
      653     DEFINE VARIABLE cType AS CHARACTER NO-UNDO.
      654   ASSIGN
      655    ghProp = WIDGET-H(ENTRY(1,TARGET-PROCEDURE:ADM-DATA,CHR(1)))
      656    glADMOk = IF ghProp:NAME = 'ADMProps':U OR (ghProp:AVAIL AND ghProp:BUFFER-FIELD('Target':U):BUFFER-VALUE = TARGET-PROCEDURE) THEN TRUE
      657             ELSE ghProp:FIND-FIRST('WHERE Target = WIDGET-H("':U + STRING(TARGET-PROCEDURE) + '")':U)
      658    cType = ghProp:BUFFER-FIELD('ObjectType':U):BUFFER-VALUE
      659     NO-ERROR.
      660     RETURN cType.
      661   END FUNCTION.
      662   IF NOT VALID-HANDLE(WIDGET-HANDLE(ENTRY(1,THIS-PROCEDURE:ADM-DATA,CHR(1)))) THEN
      663   DO:
      664     ghADMProps:ADD-NEW-FIELD('AppService':U, 'CHAR':U, 0, ?, '':U).
