     1135   DEFINE BUTTON btn_cancel AUTO-END-KEY
     1136        LABEL "Отменить"
     1137        SIZE 15 BY 1.13
     1138        BGCOLOR 8 .
     1139        DEFINE BUTTON b-system
     1140        IMAGE-UP FILE "btn-down-arrow":U
     1141        IMAGE-DOWN FILE "btn-down-arrow":U
     1142        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
     1143        LABEL ""
     1144        SIZE 3 BY .89.
     1145        DEFINE BUTTON b-goods
     1146        IMAGE-UP FILE "btn-down-arrow":U
     1147        IMAGE-DOWN FILE "btn-down-arrow":U
     1148        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
     1149        TOOLTIP "Нажмите, чтобы выбрать из справочника товаров"
     1150        LABEL ""
     1151        SIZE 3 BY .89.
     1152     DEFINE BUTTON b-goods-much
     1153        IMAGE-UP FILE "btn-down-arrow":U
     1154        IMAGE-DOWN FILE "btn-down-arrow":U
     1155        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
     1156        TOOLTIP "Нажмите, чтобы выбрать ~"Сезон ДТ~""
     1157        LABEL ""
     1158        SIZE 3 BY .89.
     1159   DEFINE BUTTON btn_save AUTO-GO
     1160        LABEL "Добавить"
     1161        SIZE 15 BY 1.13
     1162        BGCOLOR 8 .
     1163   DEFINE VARIABLE code_goods as  character FORMAT "X(256)":U
     1164        LABEL "Код товара"
     1165        VIEW-AS FILL-IN
     1166        SIZE 20 BY 1 NO-UNDO.
     1167   DEFINE VARIABLE name_goods as  character FORMAT "X(256)":U
     1168       LABEL "Имя товара"
     1169        VIEW-AS FILL-IN
     1170        SIZE 25 BY 1 NO-UNDO.
     1171   DEFINE VARIABLE code_system AS CHARACTER FORMAT "X(256)":U
     1172        LABEL "Код внешней системы"
     1173        VIEW-AS FILL-IN
     1174        SIZE 20 BY 1 NO-UNDO.
     1175   DEFINE VARIABLE code_vnesh AS CHARACTER FORMAT "X(256)":U
     1176        LABEL "Код товара во внешней системе"
     1177        VIEW-AS FILL-IN
     1178        SIZE 20 BY 1 NO-UNDO.
     1179   DEFINE FRAME Dialog-Frame
     1180       code_system AT ROW 5.5 COL 35 COLON-ALIGNED WIDGET-ID 2
     1181       code_vnesh at row 8 col 35 COLON-ALIGNED WIDGET-ID 6
     1182       btn_save AT ROW 2 COL 2.5
     1183       btn_cancel AT ROW 2 COL 59
     1184       b-system AT ROW 5.5 COL 55 COLON-ALIGNED WIDGET-ID 8
     1185       code_goods AT ROW 6.75 COL 35 COLON-ALIGNED WIDGET-ID 4
     1186       b-goods AT ROW 6.75 COL 55 COLON-ALIGNED WIDGET-ID 10
     1187       name_goods at row 6.75 col 58 COLON-ALIGNED no-label
     1188       b-goods-much at row 6.75 COL 83 COLON-ALIGNED WIDGET-ID 12
     1189       SPACE(12.12) SKIP(4.53)
     1190       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1191       SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1192       TITLE "Добавление записи в  справочник соответствий товаров ТН во ВС "
     1193       DEFAULT-BUTTON btn_save CANCEL-BUTTON btn_cancel WIDGET-ID 100.
     1194   ASSIGN
     1195          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1196          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1197   ASSIGN
     1198     b-goods-much:HIDDEN IN FRAME Dialog-Frame           = TRUE
     1199     name_goods:HIDDEN IN FRAME Dialog-Frame             = TRUE
     1200     name_goods:READ-ONLY IN FRAME Dialog-Frame          = TRUE
     1201   .
     1202   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1203       DO:
     1204           APPLY "END-ERROR":U TO SELF.
     1205       END.
     1206   ON CHOOSE OF btn_save IN FRAME Dialog-Frame
     1207       DO:
     1208           assign code_vnesh
     1209               code_goods
     1210               code_system.
     1211           v-value-character = code_vnesh.
     1212           if code_system = "" then
     1213           do:
     1214               message "Не введен код ВС" view-as alert-box.
     1215               return no-apply.
     1216           end.
     1217           if code_goods = ""  then
     1218           do:
     1219               message "Не введен код товара" view-as alert-box.
     1220               return no-apply.
     1221           end.
     1222           if code_vnesh = "" then
     1223           do:
     1224               message "Не введен код товара во ВС" view-as alert-box.
     1225               return no-apply.
     1226           end.
     1227           repeat i = 1 to num-entries (code_goods) :
     1228               find first buf_goods  no-lock where  buf_goods.gds-code =  integer(entry(i, code_goods)) no-error.
     1229               if  error-status:error then
     1230               do:
     1231                   message "Товар с кодом " entry (i, code_goods) " не найден!" view-as alert-box.
     1232                   return no-apply.
     1233               end.
     1234           end.
     1235               repeat i = 1 to num-entries (code_goods) :
     1236                   run gen-key-rec IN THIS-PROCEDURE ( input 'goods':U
     1237                       ,input (buffer buf_goods:handle)
     1238                       ,output v-uniq-key-rec).
     1239                   run ref/extclas1.p (
     1240                       INPUT 'ДОБАВЛЕНИЕ':U
     1241                       ,INPUT NO
     1242                       ,INPUT-OUTPUT v-rid
     1243                       ,INPUT 'goods':U
     1244                       ,INPUT 'exp-esys-gds-code':U
     1245                       ,input 0
     1246                       ,input entry (i, code_goods)
     1247                       ,input code_system
     1248                       ,input integer(codeDtSeason)
     1249                       ,input v-value-character
     1250                       ,input '':U
     1251                       ,input ''
     1252                       ,input 0
     1253                       ,input v-uniq-key-rec ) no-error.
     1254                   if error-status:error then
     1255                   do:
     1256                       if error-status:get-message(1) = "" then
     1257                           message "Ошибка добавления записи в справочник!" view-as alert-box .
     1258                       else
     1259                           message error-status:get-message(1) view-as alert-box .
     1260                       undo, return no-apply .
     1261                   end.
     1262               end.
     1263       end.
     1264   ON CHOOSE OF b-system IN FRAME Dialog-Frame
     1265       DO:
     1266           run bge/oxmlexts.p (
     1267               input parparentproc,
     1268               input 2,
     1269               input substitute("esys-type > &1", '0':U),
     1270               input "",
     1271               output v-rid-list,
     1272               output v-ok).
     1273           if v-rid-list = "" or v-ok <> true then message "Не была выбрана внешняя система." view-as alert-box.
     1274           if v-ok = true then
     1275           do:
     1276               run gen-row-keyr in this-procedure
     1277                   ( input v-rid-list
     1278                   ,input ?
     1279                   ,input "ub"
     1280                   ,input ?
     1281                   ,input no-lock
     1282                   ,output v-tbl-row
     1283                   ,output v-tbl-name
     1284                   ).
     1285               find first buf_ext-system no-lock where
     1286                   rowid(buf_ext-system) = v-tbl-row.
     1287           end.
     1288           else
     1289           do:
     1290               undo, return no-apply .
     1291           end.
     1292           code_system:screen-value =  entry(2,v-rid-list,chr(3)) no-error.
     1293       end.
     1294   ON CHOOSE OF b-goods IN FRAME Dialog-Frame
     1295       DO:
     1296           define variable canSetDtSeason as logical no-undo.
     1297           assign code_goods .
     1298           run ref/gds-ref.p (parparentproc, 'b-sel', ?, ?, ?, ?, ?, ?, ?, v-cntxt-obj-type, v-cntxt-obj-code, ?, output v-list) no-error.
     1299           if error-status:error or v-list = ? or v-list = "" then
     1300           do:
     1301               message "Ошибка при выборе товара для добавления в справочник." view-as alert-box.
     1302               return no-apply.
     1303           end.
     1304           v-ok = false.
     1305           for first ub.goods no-lock where recid(ub.goods) =  integer(v-list):
     1306               assign
     1307                   code_goods:screen-value = string(goods.gds-code)
     1308                   code_goods:tooltip      = goods.gds-name
     1309               no-error.
     1310               run gds-attr_check-can-set-dt-seasons in this-procedure
     1311                 (goods.gds-code, output canSetDtSeason).
     1312               if canSetDtSeason then
     1313               do:
     1314                 assign
     1315                   b-goods-much:visible = true
     1316                   name_goods:visible = true
     1317                   name_goods = ""
     1318                 .
     1319                 enable name_goods b-goods-much with frame Dialog-Frame.
     1320               end.
     1321               else do:
     1322                 assign
     1323                   b-goods-much:visible = false
     1324                   name_goods:visible = false
     1325                   codeDtSeason = ""
     1326                 .
     1327               end.
     1328           end.
     1329       end.
     1330   ON CHOOSE OF b-goods-much IN FRAME Dialog-Frame
     1331       DO:
     1332         define variable rid            as recid no-undo .
     1333         define buffer buf_code       for ub.code.
     1334         run ref/dtseasons.p
     1335           (input  parparentproc
     1336           , ?
     1337           ,output rid
     1338           ) no-error.
     1339         if rid <> ? then
     1340         do:
     1341           find first buf_code no-lock where
     1342                      recid(buf_code) = rid no-error .
     1343           if not avail buf_code then return no-apply.
     1344           assign
     1345             codeDtSeason = buf_code.code
     1346             name_goods = buf_code.codename
     1347           .
     1348         end.
     1349         else
     1350         do:
     1351           assign
     1352             codeDtSeason = ""
     1353             name_goods = ""
     1354           .
     1355         end.
     1356         display name_goods with frame Dialog-Frame.
     1357       END.
     1358   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1359   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1360   MAIN-BLOCK:
     1361   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1362      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1363     RUN enable_UI.
     1364     WAIT-FOR GO OF FRAME Dialog-Frame.
     1365   END.
     1366   RUN disable_UI.
     1367   PROCEDURE disable_UI :
     1368     HIDE FRAME Dialog-Frame.
     1369   END PROCEDURE.
     1370   PROCEDURE enable_UI :
     1371     DISPLAY code_system code_goods b-system b-goods code_vnesh
     1372         WITH FRAME Dialog-Frame.
     1373     ENABLE btn_save btn_cancel code_system code_goods b-system b-goods code_vnesh
     1374         WITH FRAME Dialog-Frame.
     1375     VIEW FRAME Dialog-Frame.
     1376   END PROCEDURE.
