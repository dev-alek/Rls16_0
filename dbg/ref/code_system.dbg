        1   define variable vss-revision    as character no-undo init "$Revision$":U .
        2   define variable vss-author      as character no-undo init "$Author$":U .
        3   define variable vss-date        as character no-undo init "$Date$":U .
        4   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        5   define variable vss-archive     as character no-undo init "$Archive$":U .
        6   define variable vss-description as character no-undo init "Диалог создания записей в справочнике товаров во внешней системе ".
        7   define input  parameter parparentproc as widget-handle no-undo.
        8   define output parameter  v-rid as recid no-undo .
        9   define variable char-gds-code as character no-undo.
       10       DEFINE VARIABLE v-rid-list AS CHARACTER NO-UNDO.
       11      define variable ref-list as char no-undo.
       12       DEFINE VARIABLE v-ok AS logical NO-UNDO.
       13       define variable v-esys-id as integer no-undo .
       14       define variable v-value-character as character no-undo init "".
       15       define variable v-uniq-key-rec as character no-undo .
       16       define variable v-esys-uniq-key-rec as character no-undo .
       17       define variable v-tbl-row as rowid no-undo .
       18       define variable v-tbl-name as character no-undo .
       19       define buffer buf_goods for ub.goods.
       20       define buffer buf_ext-system for ub.ext-system.
       21       define variable cursorr  as integer no-undo init 0.
       22       define variable code_goods_name as character no-undo.
       23       define variable v-list      as character no-undo.
       24       define variable p-goods-gds  as integer no-undo.
       25       define variable p-name-goods as char no-undo.
       26       define variable codeDtSeason as character no-undo.
       27       define variable i as integer   no-undo .
       28   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       29   define new global shared variable g#language as character no-undo .
       30   if g#language <> '' and g#language <> 'rus':U then do:
       31     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       32   end.
       33   def var vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       34   procedure gen-key-rec :
       35     define input  parameter p-tbl-name    as character no-undo.
       36     define input  parameter p-bh_tbl-name as handle    no-undo.
       37     define output parameter p-key-rec     as character no-undo.
       38     do
       39     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
       40     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
       41     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
       42     :
       43       define variable fh               as handle    no-undo .
       44       define variable v-ok             as logical   no-undo .
       45       define variable v-inform         as character no-undo .
       46       define variable v-ind            as integer   no-undo .
       47       define variable v-idx-field-qnty as integer   no-undo .
       48       if p-tbl-name = ?
       49         or p-tbl-name = "":U
       50       then do:
       51         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info1 ).
       52       end.
       53       if not p-bh_tbl-name:available then do:
       54         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info1, p-tbl-name ).
       55       end.
       56       assign
       57         p-key-rec = p-tbl-name
       58         v-inform  = p-bh_tbl-name:index-information(1)
       59         v-ind     = 2
       60       .
       61       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
       62       on error undo, return error
       63       :
       64         assign
       65           v-inform = p-bh_tbl-name:index-information( v-ind )
       66           v-ind    = v-ind + 1
       67         .
       68       end.
       69       if v-inform = ?
       70         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
       71         or entry( 3, v-inform, ",":U ) <> "1":U
       72       then do:
       73         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info1, p-tbl-name ).
       74       end.
       75       else do:
       76         assign
       77           v-idx-field-qnty = num-entries( v-inform ) - 4
       78         .
       79         if v-idx-field-qnty < 2 then do:
       80           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, p-tbl-name ).
       81         end.
       82         do v-ind = 1 to v-idx-field-qnty by 2
       83         on error undo, return error
       84         :
       85           assign
       86             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
       87             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
       88           .
       89         end.
       90       end.
       91       if p-key-rec = ? then do:
       92         assign
       93           p-key-rec = "":U
       94         .
       95         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info1, p-tbl-name ).
       96       end.
       97     end.
       98     return.
       99   end procedure.
      100   procedure gen-where-keyr-tab :
      101     define input  parameter i-tableSerach as character no-undo.
      102     define input  parameter i-tablekey   as character  no-undo.
      103     define input  parameter p-key-rec    as character  no-undo.
      104     define input  parameter p-key-handle as handle     no-undo .
      105     define input  parameter p-db-name    as character  no-undo .
      106     define input  parameter p-tt-handle  as handle     no-undo .
      107     define output parameter o-Where      as character  no-undo.
      108     do
      109     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      110     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      111     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      112     :
      113       define variable v-full-tbl-name  as character no-undo .
      114       define variable bh_tbl-name      as handle    no-undo .
      115       define variable fh_key           as handle    no-undo .
      116       define variable fh_search        as handle    no-undo .
      117       define variable v-field-num      as integer   no-undo .
      118       define variable v-count-fld      as integer   no-undo .
      119       define variable v-inform         as character no-undo .
      120       define variable v-ind            as integer   no-undo .
      121       define variable v-idx-field-qnty as integer   no-undo .
      122       define variable v-field-name     as character no-undo .
      123       define variable v-field-val      as character no-undo .
      124       define variable v-word-link      as character no-undo .
      125       define variable vTable           as character no-undo.
      126       define variable bh_tbl-key       as handle    no-undo .
      127       assign
      128         p-key-rec = trim( p-key-rec )
      129       .
      130       if p-key-handle <> ? then do:
      131         if not valid-handle(p-key-handle)
      132            or p-key-handle:type <> "buffer"
      133         then do:
      134           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info1 ).
      135         end.
      136         if num-entries( p-key-rec, chr(3) ) > 1
      137           or p-key-rec = ?
      138           or p-key-rec = "":U
      139         then do:
      140           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info1, p-key-rec ).
      141         end.
      142       end.
      143       else do:
      144         if p-key-rec = ?
      145           or p-key-rec = "":U
      146         then do:
      147           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info1 ).
      148         end.
      149       end.
      150       assign
      151         vTable = entry( 1 , p-key-rec, chr(3) )
      152       .
      153       if p-tt-handle <> ?
      154         and ( not valid-handle(p-tt-handle)
      155               or p-tt-handle:type <> "buffer"
      156             )
      157       then do:
      158         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info1, vTable, chr(10) ).
      159       end.
      160       if p-tt-handle = ? then do:
      161         assign
      162           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      163         .
      164         create buffer bh_tbl-name for table v-full-tbl-name .
      165       end.
      166       else do:
      167         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      168       end.
      169       assign
      170         v-inform = bh_tbl-name:index-information(1)
      171         v-ind    = 2
      172       .
      173       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      174       on error undo, return error
      175       :
      176         assign
      177           v-inform = bh_tbl-name:index-information( v-ind )
      178           v-ind    = v-ind + 1
      179         .
      180       end.
      181       if v-inform = ?
      182         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      183         or entry( 3, v-inform, ",":U ) <> "1":U
      184       then do:
      185         delete object bh_tbl-name no-error.
      186         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info1, vTable ).
      187       end.
      188       assign
      189         v-idx-field-qnty = num-entries( v-inform ) - 4
      190       .
      191       if v-idx-field-qnty < 2 then do:
      192         delete object bh_tbl-name no-error.
      193         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, vTable ).
      194       end.
      195       assign
      196         o-where     = "where":U
      197         v-word-link = "":U
      198         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      199         v-count-fld = 0
      200       .
      201       if i-tablekey ne "" and i-tablekey ne ?
      202       then do:
      203         assign
      204           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      205         .
      206         create buffer bh_tbl-key for table v-full-tbl-name .
      207       end.
      208       if i-tableSerach ne "" and i-tableSerach ne ?
      209       then do:
      210         delete object bh_tbl-name no-error.
      211         assign
      212           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      213         .
      214         create buffer bh_tbl-name for table v-full-tbl-name .
      215       end.
      216       block_where:
      217       do v-ind = 1 to v-idx-field-qnty by 2
      218       on error undo, return error
      219       :
      220         assign
      221           v-count-fld = v-count-fld + 1
      222         .
      223         if p-key-handle = ?
      224           and v-count-fld > v-field-num
      225         then do:
      226           leave block_where.
      227         end.
      228         define variable VfieldKeyTable as handle no-undo.
      229         assign
      230           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      231           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      232         .
      233         if     bh_tbl-key ne ?
      234         then do:
      235            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      236            if VfieldKeyTable eq ?
      237            then next block_where.
      238         end.
      239         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      240         then
      241            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      242         else
      243            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      244         if p-key-handle = ? then do:
      245           assign
      246             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      247           .
      248         end.
      249         else do:
      250           assign
      251             fh_key = p-key-handle:buffer-field( v-field-name )
      252           .
      253           if fh_key = ?
      254             or not valid-handle( fh_key )
      255           then do:
      256             delete object bh_tbl-name.
      257             if     bh_tbl-key ne ?
      258             then
      259                delete object bh_tbl-key.
      260             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info1, p-key-handle:name, v-field-name ).
      261           end.
      262           assign
      263             v-field-val = fh_key:buffer-value
      264           .
      265         end.
      266         if fh_search:data-type ="character":U then do:
      267           assign
      268             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      269             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      270             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      271             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      272             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      273             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      274             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      275             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      276             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      277             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      278             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      279             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      280             v-field-val = substitute( '"&1"', v-field-val )
      281           .
      282         end.
      283         assign
      284           o-where = substitute( "&1 &2", o-where, v-field-val )
      285         .
      286         if v-word-link = "":U then do:
      287           assign
      288             v-word-link = "and":U
      289           .
      290         end.
      291       end.
      292       delete object bh_tbl-name.
      293       if     bh_tbl-key ne ?
      294       then
      295          delete object bh_tbl-key.
      296       if p-key-handle = ?
      297         and v-count-fld <> v-field-num
      298       then do:
      299         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info1, vTable ).
      300       end.
      301     end.
      302   end procedure.
      303   procedure gen-hn-keyr-tab :
      304     define input  parameter i-tableSerach as character no-undo.
      305     define input  parameter i-tablekey   as character no-undo.
      306     define input  parameter p-key-rec    as character no-undo.
      307     define input  parameter p-key-handle as handle    no-undo .
      308     define input  parameter p-db-name    as character no-undo .
      309     define input  parameter p-tt-handle  as handle    no-undo .
      310     define input  parameter p-stts-lock  as integer   no-undo .
      311     define output parameter o-hn         as handle    no-undo.
      312     define variable v-full-tbl-name as character no-undo.
      313     define variable v-where         as character no-undo.
      314     define variable bh_tbl-name     as handle    no-undo.
      315     define variable vTable          as character no-undo.
      316     do
      317     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      318     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      319     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      320         run gen-where-keyr-tab(i-tableSerach,
      321                                i-tablekey,
      322                                p-key-rec,
      323                                p-key-handle,
      324                                p-db-name,
      325                                p-tt-handle,
      326                                output v-where).
      327         if i-tableSerach ne "" and i-tableSerach ne ?
      328         then do:
      329            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      330            create buffer bh_tbl-name for table v-full-tbl-name .
      331         end.
      332         else do:
      333            if p-tt-handle = ? then do:
      334               assign
      335                  vTable = entry( 1 , p-key-rec, chr(3) )
      336               .
      337               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      338               create buffer bh_tbl-name for table v-full-tbl-name .
      339            end.
      340            else do:
      341               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      342            end.
      343         end.
      344         if p-tt-handle = ? then do:
      345            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      346         end.
      347         else do:
      348            bh_tbl-name:find-first( v-where ) no-error .
      349         end.
      350         o-hn = bh_tbl-name.
      351      end.
      352   end procedure.
      353   procedure gen-hn-keyr :
      354     define input  parameter p-key-rec    as character no-undo.
      355     define input  parameter p-key-handle as handle    no-undo .
      356     define input  parameter p-db-name    as character no-undo .
      357     define input  parameter p-tt-handle  as handle    no-undo .
      358     define input  parameter p-stts-lock  as integer   no-undo .
      359     define output parameter o-hn         as handle    no-undo.
      360     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      361   end.
      362   procedure gen-row-keyr :
      363     define input  parameter p-key-rec    as character no-undo.
      364     define input  parameter p-key-handle as handle    no-undo .
      365     define input  parameter p-db-name    as character no-undo .
      366     define input  parameter p-tt-handle  as handle    no-undo .
      367     define input  parameter p-stts-lock  as integer   no-undo .
      368     define output parameter p-tbl-row    as rowid     no-undo.
      369     define output parameter p-tbl-name   as character no-undo.
      370     define variable vHn as handle no-undo.
      371       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      372       p-tbl-row = if vHn:available then vHn:rowid else ?.
      373       p-tbl-name =  vHn:table.
      374       delete object vHn no-error.
      375     if p-tbl-row = ? then do:
      376       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info1, p-tbl-name, p-key-rec ).
      377     end.
      378     else do:
      379       return.
      380     end.
      381   end procedure.
      382   procedure gen-key-fv :
      383     define input  parameter p-key-rec    as character no-undo .
      384     define output parameter p-field-list as character no-undo .
      385     define output parameter p-value-list as character no-undo.
      386     do
      387     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      388     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      389     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      390     :
      391       define variable v-full-tbl-name  as character no-undo .
      392       define variable bh_tbl-name      as handle    no-undo .
      393       define variable v-tbl-name       as character no-undo .
      394       define variable v-field-num      as integer   no-undo .
      395       define variable v-count-fld      as integer   no-undo .
      396       define variable v-inform         as character no-undo .
      397       define variable v-ind            as integer   no-undo .
      398       define variable v-idx-field-qnty as integer   no-undo .
      399       define variable v-delim-key      as character no-undo .
      400       if p-key-rec = ?
      401         or p-key-rec = "":U
      402       then do:
      403         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info1 ).
      404       end.
      405       assign
      406         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      407         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      408       .
      409       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      410       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info1 ).
      411       assign
      412         v-inform = bh_tbl-name:index-information(1)
      413         v-ind    = 2
      414       .
      415       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      416       on error undo, return error
      417       :
      418         assign
      419           v-inform = bh_tbl-name:index-information( v-ind )
      420           v-ind    = v-ind + 1
      421         .
      422       end.
      423       if v-inform = ?
      424         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      425         or entry( 3, v-inform, ",":U ) <> "1":U
      426       then do:
      427         delete object bh_tbl-name no-error.
      428         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info1, v-tbl-name ).
      429       end.
      430       assign
      431         v-idx-field-qnty = num-entries( v-inform ) - 4
      432       .
      433       if v-idx-field-qnty < 2 then do:
      434         delete object bh_tbl-name no-error.
      435         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, v-tbl-name ).
      436       end.
      437       assign
      438         p-field-list = "":U
      439         p-value-list = "":U
      440         v-delim-key  = "":U
      441         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      442         v-count-fld  = 0
      443       .
      444       block_where:
      445       do v-ind = 1 to v-idx-field-qnty by 2
      446       on error undo, return error
      447       :
      448         assign
      449           v-count-fld = v-count-fld + 1
      450         .
      451         if v-count-fld > v-field-num then do:
      452           leave block_where.
      453         end.
      454         assign
      455           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      456           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      457         .
      458         if v-ind = 1 then do:
      459           assign
      460             v-delim-key = chr(3)
      461           .
      462         end.
      463       end.
      464       delete object bh_tbl-name.
      465       if v-count-fld <> v-field-num then do:
      466         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info1, v-tbl-name ).
      467       end.
      468     end.
      469   end procedure.
      470   procedure gen-key-field :
      471     define input  parameter p-table      as character no-undo .
      472     define output parameter p-field-list as character no-undo .
      473     do
      474     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      475     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      476     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      477     :
      478       define variable v-full-tbl-name  as character no-undo .
      479       define variable bh_tbl-name      as handle    no-undo .
      480       define variable v-tbl-name       as character no-undo .
      481       define variable v-field-num      as integer   no-undo .
      482       define variable v-count-fld      as integer   no-undo .
      483       define variable v-inform         as character no-undo .
      484       define variable v-ind            as integer   no-undo .
      485       define variable v-idx-field-qnty as integer   no-undo .
      486       define variable v-delim-key      as character no-undo .
      487       if p-table = ?
      488         or p-table = "":U
      489       then do:
      490         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info1 ).
      491       end.
      492       assign
      493         v-tbl-name      = p-table
      494         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      495       .
      496       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      497       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info1 ).
      498       assign
      499         v-inform = bh_tbl-name:index-information(1)
      500         v-ind    = 2
      501       .
      502       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      503       on error undo, return error
      504       :
      505         assign
      506           v-inform = bh_tbl-name:index-information( v-ind )
      507           v-ind    = v-ind + 1
      508         .
      509       end.
      510       if v-inform = ?
      511         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      512         or entry( 3, v-inform, ",":U ) <> "1":U
      513       then do:
      514         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info1, v-tbl-name ).
      515       end.
      516       assign
      517         v-idx-field-qnty = num-entries( v-inform ) - 4
      518       .
      519       if v-idx-field-qnty < 2 then do:
      520         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, v-tbl-name ).
      521       end.
      522       assign
      523         p-field-list = "":U
      524         v-delim-key  = "":U
      525         v-count-fld  = 0
      526       .
      527       block_where:
      528       do v-ind = 1 to v-idx-field-qnty by 2
      529       on error undo, return error
      530       :
      531         assign
      532           v-count-fld = v-count-fld + 1
      533         .
      534         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      535         if v-ind = 1 then do:
      536           assign
      537             v-delim-key = chr(3)
      538           .
      539         end.
      540       end.
      541       delete object bh_tbl-name.
      542     end.
      543   end procedure.
      544   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      545     define variable v-cntxt-db-num        as integer   no-undo .
