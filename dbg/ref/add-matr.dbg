      101   procedure correct-message :
      102   define input  parameter p-longchar as longchar no-undo .
      103   define variable v-longchar as longchar no-undo .
      104   define variable v-err-ext  as logical  no-undo .
      105     do
      106     on error undo, return error return-value
      107     :
      108      run get-long-message in this-procedure  (output v-longchar ).
      109       v-longchar = v-longchar + p-longchar.
      110       v-err-ext  = true .
      111       run set-long-message  in this-procedure  (input v-longchar,  input v-err-ext ).
      112     end.
      113   end procedure.
      114   define variable v-longchar as longchar no-undo .
      115   define variable v-err-ext as logical   no-undo .
      116   procedure get-long-message  :
      117   define output parameter p-longchar  as longchar no-undo .
      118     do
      119     on error undo, return error return-value
      120     :
      121        p-longchar = v-longchar .
      122     end.
      123   end procedure.
      124   procedure set-long-message :
      125   define input  parameter  p-longchar as longchar   no-undo .
      126   define input  parameter  p-err-ext as logical   no-undo .
      127     do
      128     on error undo, return error return-value
      129     :
      130       v-longchar  =  p-longchar .
      131       v-err-ext   =  p-err-ext  .
      132     end.
      133   end procedure.
