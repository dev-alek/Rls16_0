      314   FUNCTION indicator-life-gds-n RETURNS CHARACTER ( input p-rec as recid ) FORWARD.
      315   DEFINE VARIABLE v-gl-iProc-Otkl AS DECIMAL NO-UNDO INITIAL 0.
      316   DEFINE VARIABLE v-gl-lAM-Is-Obj         AS LOGICAL NO-UNDO INITIAL FALSE.
      317   DEFINE VARIABLE v-gl-iAM-Gds-All        AS INTEGER NO-UNDO INITIAL 0.
      318   DEFINE VARIABLE v-gl-iAM-Sbl-Gds-All    AS INTEGER NO-UNDO INITIAL 0.
      319   DEFINE VARIABLE v-gl-iAM-Gds-Vyv        AS INTEGER NO-UNDO INITIAL 0.
      320   DEFINE VARIABLE v-gl-lAM-Ref-Shablon    AS LOGICAL NO-UNDO INITIAL FALSE.
      321   DEFINE VARIABLE v-gl-dAM-Proc-Otkl      AS DECIMAL NO-UNDO INITIAL 0.
      322   DEFINE VARIABLE v-gl-dAM-Proc-Otkl-Ras  AS DECIMAL NO-UNDO INITIAL 0.
      323   FUNCTION Is-Gds-In-AssMatr RETURN LOGICAL(
      324      p-Gds-code AS INTEGER,
      325      p-Asmt-id  AS INTEGER,
      326      p-Db-num   AS INTEGER):
      327      DEFINE BUFFER buf_Gds FOR Ub.Assortment-matrix-goods.
      328      RETURN CAN-FIND(FIRST buf_Gds WHERE
      329                            buf_Gds.Asmt-id     = p-Asmt-id
      330                        AND buf_Gds.Db-num      = p-Db-num
      331                        AND buf_Gds.Gds-code    = p-Gds-code
      332                        AND buf_Gds.Asmg-status = INTEGER('0':U)
      333                      NO-LOCK).
      334   END FUNCTION.
      335   PROCEDURE Get-Delta-Gds-2-Matrix:
      336      DEFINE PARAMETER BUFFER buf_AM-1 FOR ub.Assortment-matrix.
      337      DEFINE PARAMETER BUFFER buf_AM-2 FOR ub.Assortment-matrix.
      338      DEFINE OUTPUT PARAMETER iDelta AS INTEGER NO-UNDO INITIAL 0.
      339      DEFINE BUFFER buf_Gds-1 FOR ub.Assortment-matrix-goods.
      340      DEFINE BUFFER buf_Gds-2 FOR ub.Assortment-matrix-goods.
      341      FOR EACH buf_Gds-1 WHERE
      342               buf_Gds-1.Asmt-id = buf_AM-1.Asmt-id
      343           AND buf_Gds-1.Db-num  = buf_AM-1.Db-num
      344           AND buf_Gds-1.Asmg-status = INTEGER('0':U)
      345          NO-LOCK:
      346          IF NOT CAN-FIND(FIRST buf_Gds-2 WHERE
      347                                buf_Gds-2.Asmt-id     = buf_AM-2.Asmt-id
      348                            AND buf_Gds-2.Db-num      = buf_AM-2.Db-num
      349                            AND buf_Gds-2.Gds-code    = buf_Gds-1.Gds-code
      350                            AND buf_Gds-2.Asmg-status = INTEGER('0':U)
      351                            NO-LOCK) THEN DO:
      352             ASSIGN
      353                iDelta = iDelta + 1.
      354          END.
      355      END.
      356      RETURN.
      357   END PROCEDURE.
      358   PROCEDURE Cntrl-AM-Add-1:
      359      DEFINE INPUT PARAMETER iDelta  AS INTEGER   NO-UNDO.
      360      DEFINE OUTPUT PARAMETER cError AS CHARACTER NO-UNDO INITIAL "".
      361      IF v-gl-iProc-Otkl = 0      THEN RETURN.
      362      IF NOT v-gl-lAM-Is-Obj      THEN RETURN.
      363      IF NOT v-gl-lAM-Ref-Shablon THEN RETURN.
      364      RUN Calc-Proc-Otkl IN THIS-PROCEDURE(iDelta).
      365      IF iDelta = 0 THEN DO:
      366         IF v-gl-dAM-Proc-Otkl >= v-gl-iProc-Otkl THEN DO:
      367            cError = "В данной матрице процент отклонения товаров от шаблона (=" + STRING(v-gl-dAM-Proc-Otkl) + ")" + chr(10) +
      368                     " больше допустимого (=" + STRING( v-gl-iProc-Otkl) +  ")." + chr(10) +
      369                     "Добавление товаров невозможно !".
      370         END.
      371      END. ELSE DO:
      372         IF v-gl-dAM-Proc-Otkl-Ras >= v-gl-iProc-Otkl THEN DO:
      373            cError = "В данной матрице будущий расчетный процент отклонения товаров от шаблона (=" + STRING(v-gl-dAM-Proc-Otkl-Ras) + ")" + chr(10) +
      374                     " больше допустимого (=" + STRING( v-gl-iProc-Otkl ) +  ")." + chr(10) +
      375                     " Добавление товаров невозможно !".
      376         END.
      377      END.
      378      RETURN.
      379   END PROCEDURE.
      380   PROCEDURE Get-Gl-Param-Proc-Otkl:
      381      DEFINE INPUT PARAMETER   p-Asmt-Id AS INTEGER    NO-UNDO.
      382      DEFINE INPUT PARAMETER   p-Db-num  AS INTEGER    NO-UNDO.
      383      DEFINE OUTPUT PARAMETER  cError    AS CHARACTER  NO-UNDO INITIAL "".
      384      DEFINE BUFFER buf_AM   FOR ub.Assortment-Matrix.
      385      FIND FIRST buf_AM WHERE
      386                 buf_AM.asmt-id = p-Asmt-id
      387             AND buf_AM.db-num  = p-Db-num
      388           NO-LOCK NO-ERROR.
      389      IF NOT AVAILABLE buf_AM THEN DO:
      390         cError = PROGRAM-NAME(1) +  ":Не найдена АМ id=" + STRING(p-Asmt-id) + " db-num=" + STRING(p-Db-num).
      391         RETURN.
      392      END.
      393      RUN Get-Gl-Set-Proc-Otkl IN THIS-PROCEDURE(
      394          buf_AM.obj-type,
      395          buf_AM.obj-code
      396          ).
      397      RUN Get-Gl-Param-AM-All in THIS-PROCEDURE(
      398          buf_AM.Asmt-id,
      399          buf_AM.db-num
      400          ).
      401      RETURN.
      402   END PROCEDURE.
      403   PROCEDURE Get-Gl-Param-AM-All:
      404      DEFINE INPUT PARAMETER   p-Asmt-Id AS INTEGER    NO-UNDO.
      405      DEFINE INPUT PARAMETER   p-Db-num  AS INTEGER    NO-UNDO.
      406      DEFINE VARIABLE lIsAmObj    AS LOGICAL    NO-UNDO INITIAL FALSE.
      407      DEFINE VARIABLE iSh-Asmt-id AS INTEGER    NO-UNDO INITIAL 0.
      408      DEFINE VARIABLE iSh-Db-num  AS INTEGER    NO-UNDO INITIAL 0.
      409      DEFINE VARIABLE cSh-Type    AS CHARACTER  NO-UNDO INITIAL "".
      410      DEFINE VARIABLE cError      AS CHARACTER  NO-UNDO INITIAL "".
      411      DEFINE VARIABLE dAmt        AS DECIMAL    EXTENT 2  NO-UNDO INITIAL 0.
      412      DEFINE VARIABLE cMode       AS CHARACTER  NO-UNDO INITIAL "".
      413      ASSIGN
      414         v-gl-iAM-Gds-All     = 0
      415         v-gl-iAM-Sbl-Gds-All = 0
      416         v-gl-iAM-Gds-Vyv     = 0
      417         v-gl-dAM-Proc-Otkl   = 0
      418         v-gl-lAM-Ref-Shablon = FALSE
      419         .
      420      RUN Get-Param-AM IN THIS-PROCEDURE (
      421          p-Asmt-id,
      422          p-Db-num,
      423          OUTPUT lIsAmObj,
      424          OUTPUT iSh-Asmt-id,
      425          OUTPUT iSh-Db-num,
      426          OUTPUT cSh-Type,
      427          OUTPUT cError
      428          ).
      429      IF cError <> "" THEN DO:
      430         MESSAGE
      431            PROGRAM-NAME(1) ":" SKIP
      432            "Такого быть не должно !!!" SKIP
      433            cError SKIP
      434            VIEW-AS ALERT-BOX INFO BUTTONS OK.
      435         RETURN.
      436      END.
      437      ASSIGN
      438         cMode                 = (IF lIsAmObj THEN "IL_GDS":U ELSE "")
      439         v-gl-lAM-Ref-Shablon  = (IF iSh-Asmt-id = 0 THEN FALSE ELSE TRUE)
      440         .
      441      RUN Get-Param-AM-Gds IN THIS-PROCEDURE(
      442          p-Asmt-Id,
      443          p-Db-num,
      444          '0':U,
      445          cMode,
      446          OUTPUT dAmt
      447          ).
      448      ASSIGN
      449         v-gl-iAM-Gds-All = dAmt[1]
      450         v-gl-iAM-Gds-Vyv = (IF lIsAmObj THEN dAmt[2] ELSE 0)
      451         .
      452       IF NOT v-gl-lAM-Ref-Shablon THEN DO:
      453          RETURN.
      454       END.
      455      RUN Get-Param-AM-Gds IN THIS-PROCEDURE(
      456          iSh-Asmt-id,
      457          iSh-Db-num,
      458          '0':U,
      459          "",
      460          OUTPUT dAmt
      461          ).
      462      ASSIGN
      463         v-gl-iAM-Sbl-Gds-All = dAmt[1].
      464      RUN Calc-Proc-Otkl IN THIS-PROCEDURE(0).
      465      RETURN.
      466   END PROCEDURE.
      467   PROCEDURE Get-Param-AM-Gds:
      468      DEFINE INPUT PARAMETER   p-Asmt-Id AS INTEGER    NO-UNDO.
      469      DEFINE INPUT PARAMETER   p-Db-num  AS INTEGER    NO-UNDO.
      470      DEFINE INPUT PARAMETER   p-Stat    AS INTEGER    NO-UNDO.
      471      DEFINE INPUT PARAMETER   p-Mode    AS CHARACTER  NO-UNDO.
      472      DEFINE OUTPUT PARAMETER  o-dAmt    AS DECIMAL    EXTENT 2 NO-UNDO INITIAL 0.
      473      DEFINE BUFFER buf_AM-goods FOR ub.Assortment-matrix-goods.
      474      FOR EACH buf_AM-goods WHERE
      475               buf_AM-goods.Asmt-id      = p-Asmt-Id
      476           AND buf_AM-goods.Db-num       = p-Db-num
      477           AND buf_AM-goods.asmg-status  = p-Stat
      478          NO-LOCK:
      479          ASSIGN
      480             o-dAmt[1] = o-dAmt[1] + 1.
      481          IF CAN-DO("IL_GDS":U, p-Mode) THEN DO:
      482             IF Indicator-life-gds-n(recid(buf_AM-goods)) = 'На вывод из ассортимента':U THEN DO:
      483                ASSIGN
      484                   o-dAmt[2] = o-dAmt[2] + 1.
      485             END.
      486          END.
      487      END.
      488      RETURN.
      489   END PROCEDURE.
      490   PROCEDURE Get-Param-AM:
      491      DEFINE INPUT  PARAMETER  p-Asmt-id   AS INTEGER   NO-UNDO.
      492      DEFINE INPUT  PARAMETER  p-Db-num    AS INTEGER   NO-UNDO.
      493      DEFINE OUTPUT PARAMETER  lIsObj      AS LOGICAL   NO-UNDO INITIAL FALSE.
      494      DEFINE OUTPUT PARAMETER  o-Asmt-id   AS INTEGER   NO-UNDO INITIAL 0.
      495      DEFINE OUTPUT PARAMETER  o-Db-Num    AS INTEGER   NO-UNDO INITIAL 0.
      496      DEFINE OUTPUT PARAMETER  v-Type      AS CHARACTER NO-UNDO INITIAL "".
      497      DEFINE OUTPUT PARAMETER  cError      AS CHARACTER NO-UNDO INITIAL "".
      498      DEFINE VARIABLE v-value AS  CHARACTER NO-UNDO INITIAL "".
      499      DEFINE BUFFER buf_AM   FOR ub.Assortment-Matrix.
      500      DEFINE BUFFER buf_AM-2 FOR ub.Assortment-Matrix.
      501      ASSIGN
      502         v-gl-lAM-Is-Obj = FALSE.
      503      FIND FIRST buf_AM WHERE
      504                 buf_AM.asmt-id = p-Asmt-id
      505             AND buf_AM.db-num  = p-Db-num
      506           NO-LOCK NO-ERROR.
      507      IF NOT AVAILABLE buf_AM THEN DO:
      508         cError = "Не найдена АМ id=" + STRING(p-Asmt-id) + " db-num=" + STRING(p-Db-num).
      509         RETURN.
      510      END.
      511      IF buf_AM.asmt-type <> 'Объект':U THEN DO:
      512         RETURN.
      513      END. ELSE DO:
      514         ASSIGN
      515            lIsObj           = TRUE
      516            v-gl-lAM-Is-Obj  = TRUE
      517            .
      518      END.
      519      run assmatat-value (
      520          input buf_AM.asmt-id
      521         ,input buf_AM.db-num
      522         ,input 'RootShablon':U
      523         ,output v-value
      524         ,output v-type
      525         ) .
      526      IF v-value = "" OR v-value = ? THEN DO:
      527         RETURN.
      528      END.
      529      ASSIGN
      530         o-Asmt-id = INTEGER(ENTRY(1, v-value, chr(4)))
      531         o-Db-num  = INTEGER(ENTRY(2, v-value, chr(4)))
      532         NO-ERROR.
      533      IF ERROR-STATUS:ERROR THEN DO:
      534         cError = PROGRAM-NAME(1) + ":" + ERROR-STATUS:GET-MESSAGE(1).
      535         RETURN.
      536      END.
      537      FIND FIRST buf_AM-2 WHERE
      538                 buf_AM-2.asmt-id = o-Asmt-id
      539             AND buf_AM-2.db-num  = o-Db-num
      540           NO-LOCK NO-ERROR.
      541      IF NOT AVAILABLE buf_AM-2 THEN DO:
      542         cError = "Не найден шаблон АМ id=" + STRING(o-Asmt-id) + " db-num=" + STRING(o-Db-num).
      543         RETURN.
      544      END.
      545      RETURN.
      546   END PROCEDURE.
      547   PROCEDURE Get-Gl-Set-Proc-Otkl:
      548      DEFINE INPUT PARAMETER  cObj-type AS CHARACTER NO-UNDO.
      549      DEFINE INPUT PARAMETER  iObj-code AS INTEGER   NO-UNDO.
      550      DEFINE VARIABLE v-Character   AS CHARACTER  NO-UNDO .
      551      DEFINE VARIABLE v-Date        AS DATE       NO-UNDO .
      552      DEFINE VARIABLE v-Decimal     AS DECIMAL    NO-UNDO .
      553      DEFINE VARIABLE v-Integer     AS INTEGER    NO-UNDO .
      554      DEFINE VARIABLE v-Logical     AS LOGICAL    NO-UNDO .
      555      DEFINE VARIABLE v-Param-Type  AS CHARACTER  NO-UNDO .
      556      ASSIGN
      557         v-gl-iProc-Otkl = 0
      558         .
      559      EMPTY TEMP-TABLE thbjattr_thbj-attr .
      560      RUN adm/shattri.p (
      561              INPUT  "get":U,
      562              INPUT  cObj-type,
      563              INPUT  iObj-code,
      564              INPUT  'Ass-obj':U,
      565              INPUT  'ass-proc-matr-shabl':U ,
      566              OUTPUT v-Character,
      567              OUTPUT v-Date,
      568              OUTPUT v-Decimal,
      569              OUTPUT v-Integer,
      570              OUTPUT v-Logical,
      571              OUTPUT v-Param-Type,
      572              INPUT-OUTPUT TABLE thbjattr_thbj-attr
      573          ) NO-ERROR.
      574      IF ERROR-STATUS:ERROR THEN DO:
      575         ASSIGN
      576            v-Integer  = 0
      577            v-Decimal  = 0.
      578      END. ELSE DO:
      579         ASSIGN
      580            v-gl-iProc-Otkl = v-Integer
      581            .
      582      END.
      583      RETURN.
      584   END PROCEDURE.
      585   PROCEDURE Calc-Proc-Otkl:
      586      DEFINE INPUT PARAMETER iDeltaGds AS INTEGER NO-UNDO.
      587      DEFINE VARIABLE iTmp AS INTEGER NO-UNDO INITIAL 0.
      588      ASSIGN
      589         v-gl-dAM-Proc-Otkl     = 0
      590         v-gl-dAM-Proc-Otkl-Ras = 0
      591         .
      592      IF NOT v-gl-lAM-Ref-Shablon THEN DO:
      593         RETURN.
      594      END.
      595      IF v-gl-iAM-Sbl-Gds-All = 0 THEN DO:
      596         ASSIGN
      597            v-gl-dAM-Proc-Otkl     = 999999
      598            v-gl-dAM-Proc-Otkl-Ras = 999999
      599            .
      600         RETURN.
      601      END.
      602      ASSIGN
      603         iTmp = (v-gl-iAM-Gds-All - v-gl-iAM-Sbl-Gds-All)
      604         v-gl-dAM-Proc-Otkl     = ROUND(iTmp * 100 / v-gl-iAM-Sbl-Gds-All, 2)
      605         v-gl-dAM-Proc-Otkl-Ras = ROUND((iTmp + iDeltaGds)  * 100 / v-gl-iAM-Sbl-Gds-All, 2)
      606         .
      607      RETURN.
      608   END PROCEDURE.
      609   FUNCTION indicator-life-gds-n RETURNS CHARACTER
      610   ( input p-rec as recid ) :
      611   define buffer buf_matrix-goods for ub.assortment-matrix-goods .
      612   define variable v-gdop-min-stock              as decimal   no-undo .
      613   define variable v-grop-max-stock              as decimal   no-undo .
      614   define variable v-grop-level-always-presence  as decimal   no-undo .
      615   define variable v-grop-min-order              as decimal   no-undo .
      616   define variable v-assort-min                  as LOGICAL   NO-UNDO.
      617   DEFINE variable v-indicator-life-gds          as CHARACTER NO-UNDO.
      618   find first buf_matrix-goods no-lock where recid (buf_matrix-goods) = p-rec no-error .
      619   if error-status :error then return '' .
      620   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      621   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjpr in g#library
      622     (input  buf_Matrix-goods.obj-type
      623     ,input  buf_Matrix-goods.obj-code
      624     ,input  ?
      625     ,input  ?
      626     ,input  ?
      627     ,input  buf_Matrix-goods.gds-code
      628     ,output v-assort-min
      629     ,output v-indicator-life-gds
      630     ,output v-gdop-min-stock
      631     ,output v-grop-max-stock
      632     ,output v-grop-level-always-presence
      633     ,output v-grop-min-order
      634     )  .
      635     return v-indicator-life-gds.
      636   end function.
      637   define variable  p-obj-type    like ub.clients.obj-type no-undo .
      638   define variable  p-obj-code    like ub.clients.obj-code no-undo .
      639   define variable  p-mode        as character   no-undo .
      640   define variable  p-sts         as integer   no-undo .
      641   define variable  p-rid-list    as  character no-undo .
      642   define variable v-db-num       as integer   no-undo .
      643   define variable v-kol          as integer   no-undo .
      644   define variable p-without-obj-host-code as integer   no-undo .
      645   DEFINE VARIABLE cError  as CHARACTER NO-UNDO INITIAL "".
      646   DEFINE VARIABLE iDelta  as INTEGER   NO-UNDO INITIAL 0.
      647   v-err-ext = false  .
      648   v-longchar = "".
      649   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      650   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
      651     (output v-db-num
      652     )  .
      653   p-sts = integer ('0':U) .
      654   if v-db-num <> 0 then do :
      655      if not can-find ( first assortment-matrix no-lock where  assortment-matrix.asmt-status = integer ('0':U) and
      656                                                               assortment-matrix.db-num = v-db-num )  then return .
      657   end.
      658   else do:
      659      if not can-find ( first assortment-matrix no-lock where  assortment-matrix.asmt-status = integer ('0':U))  then return .
      660   end.
      661   define variable v-log as logical   no-undo .
      662   define variable vss-include-info8 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      663   do:
      664     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      665       (input  v-cntxt-db-num
      666       ,input  v-cntxt-userid
      667       ,input  0
      668       ,input  'actn_assort-matr-gds_add-def':U
      669       ,input  'global':U
      670       ,input  0
      671       ,input  '':U
      672       ,input  0
      673       ,input  0
      674       ,input  0
      675       ,input  0
      676       ,input  false
      677       ,output v-log
      678       )  .
      679   end.
      680    if not v-log then return  .
      681    p-without-obj-host-code = v-cntxt-host-code-obj .
      682    p-obj-type              = v-cntxt-obj-type .
      683    p-obj-code              = v-cntxt-obj-code .
      684   run ref/assmatr.w (
      685     input parParentProc
      686    ,input "b-sel,b-mark"
      687    ,input p-obj-type
      688    ,input p-obj-code
      689    ,input p-mode
      690    ,input p-sts
      691    ,input-output p-rid-list    ) no-error .
      692    if error-status :error then
      693    message
      694      vss-workfile vss-revision vss-description skip
      695      error-status :get-message(1) skip
      696      return-value skip
      697      "Список Ассортиментных матриц - assmatr.w"
      698      view-as alert-box error
      699    .
      700    v-kol = num-entries (p-rid-list).
      701   if v-kol = 0  then do:
      702   message "Не выбрана ни одна ассортиментная матрица !"
      703     "Внести товар в Ассортиментную матрицу можно в одноименном справочнике ."
      704     view-as alert-box information .
      705     return .
      706   end.
      707   define variable v-i as integer   no-undo .
      708   define buffer buf_assortment-matrix for assortment-matrix.
      709   define variable p-doc-rec  as recid no-undo .
      710   repeat v-i = 1 to v-kol :
      711     find first  buf_assortment-matrix no-lock where recid(buf_assortment-matrix) = integer (entry(v-i,p-rid-list )) no-error .
      712     if available buf_assortment-matrix then do:
      713     if buf_assortment-matrix.asmt-status <> integer ('0':U)   then do: message substitute("АМ &1 - удалена , в нее добавлять товар нельзя !" ,  buf_assortment-matrix.asmt-name , buf_assortment-matrix.db-num-obj ) view-as alert-box information . next. end.
      714     if v-db-num <> 0 and
      715        (( buf_assortment-matrix.asmt-type = 'Объект':U     and buf_assortment-matrix.db-num-obj         <> v-db-num ) or
      716         ( buf_assortment-matrix.asmt-type = 'Шаблон':U and buf_assortment-matrix.asmt-db-num-create <> v-db-num ))
      717         then do:
      718           message substitute("АМ &1 чужой БД &2 , в нее добавлять товар нельзя !" ,  buf_assortment-matrix.asmt-name , buf_assortment-matrix.db-num-obj ) view-as alert-box information .
      719           next.
      720         end.
      721         IF NOT Is-Gds-In-AssMatr(p-gds-code,
      722                                  buf_assortment-matrix.asmt-id,
      723                                  buf_assortment-matrix.db-num) THEN DO:
      724            RUN Get-Gl-Param-Proc-Otkl in THIS-PROCEDURE(
      725                buf_assortment-matrix.asmt-id,
      726                buf_assortment-matrix.db-num,
      727                OUTPUT cError
      728                ).
      729            if cError <> "" THEN DO:
      730                v-err-ext = true .
      731                v-longchar = v-longchar +
      732                             PROGRAM-NAME(1) + ":" + cError +
      733                             substitute("&1 &2 &3 " ,  buf_assortment-matrix.asmt-name , buf_assortment-matrix.db-num-obj, chr(10))
      734                             .
      735                NEXT.
      736            END.
      737            RUN Cntrl-AM-Add-1 IN THIS-PROCEDURE(
      738               1,
      739               OUTPUT cError
      740               ).
      741            if cError <> "" THEN DO:
      742                v-err-ext = true .
      743                v-longchar = v-longchar +
      744                             PROGRAM-NAME(1) + ":" + cError +
      745                             substitute("&1 &2 &3 " ,  buf_assortment-matrix.asmt-name , buf_assortment-matrix.db-num-obj, chr(10))
      746                             .
      747                NEXT.
      748            END.
      749         END.
      750   if (valid-handle(g#lib-Matrix) <> true) then do:   run ref/gds-mat1.p persistent no-error .   if error-status :error or (valid-handle(g#lib-Matrix) <> true) then do:     message       "Error starting library.p" skip       g#lib-Matrix skip       g#lib-Matrix :type skip       g#lib-Matrix :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run main_gds-mat1 in g#lib-Matrix
      751    (input this-procedure
      752    ,input-output p-doc-rec
      753    ,input 'ДОБАВЛЕНИЕ':U
      754    ,input buf_assortment-matrix.asmt-id
      755    ,input buf_assortment-matrix.db-num
      756    ,input p-gds-code
      757    ,input ''
      758     ) no-error .
      759             if error-status :error then do:
      760              v-err-ext = true .
      761              v-longchar = v-longchar + return-value + chr(10) .
      762             end.
      763     end.
      764   end.
      765   if v-err-ext = true  then do:
      766   define variable v-ok as logical   no-undo .
      767     run gbl/d-longchar.w (
      768           ?,
      769           'Editor_row=2\':u
      770         + 'title=При добавлении в Ассортиментные матрицы\':u
      771         + 'Editor_col=1\':u
      772         + 'Editor_width=96\':u
      773         + 'Editor_height=21\':u
      774         + 'readonly=yes\':u
      775       ,input-output v-longchar
      776       ,output v-ok ) no-error .
      777       v-longchar = "" .
      778   if (valid-handle(g#lib-Matrix) <> true) then do:   run ref/gds-mat1.p persistent no-error .   if error-status :error or (valid-handle(g#lib-Matrix) <> true) then do:     message       "Error starting library.p" skip       g#lib-Matrix skip       g#lib-Matrix :type skip       g#lib-Matrix :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run clear-longmess in g#lib-Matrix
      779      .
      780   end.
