      564     .
      565   define new global shared variable mBatchMode as logical no-undo init ?.
      566   define variable mFramBachModHandle as handle no-undo.
      567   mFramBachModHandle = frame waitfram:handle.
      568   define variable mFameOldVis as logical no-undo.
