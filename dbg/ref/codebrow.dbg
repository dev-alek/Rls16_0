      570   if session:batch-mode
      571   then
      572      mBatchMode = yes.
      573   if mBatchMode = ? then do:
      574     mVisCUrentVin = current-window:visible.
      575     mFameOldVis = mFramBachModHandle:visible.
      576     mFramBachModHandle:visible  = yes.
      577     mBatchMode = mFramBachModHandle:visible ne yes.
      578     mFramBachModHandle:visible = mFameOldVis.
      579     current-window:visible = mVisCUrentVin.
      580   end.
      581    if  log-manager:logfile-name ne ?
      582     then DO:
      583         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      584         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      585         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      586     end.
      587   on choose of B-WaitFramStop in frame waitfram
      588   do:
      589     mWaitFramStop = yes.
      590     mWaitFramStopUser = yes.
      591   end.
      592   function waitfram-check-timeout returns logical():
      593      define variable vtime as int64 no-undo.
      594      if mWaitFramStopTimeOut
      595      then
      596         return yes.
      597      vtime = ( now - mWaitFramStartProc ) / 1000 .
      598      if     mWaitFramTimeOut ne ?
      599         and mWaitFramTimeOut ne 0
      600         and mWaitFramTimeOut lt vtime
      601      then do:
      602         mWaitFramStopTimeOut = yes.
      603      end.
      604      return mWaitFramStopTimeOut.
      605   end.
      606   procedure waitfram-hide :
      607     if not session:batch-mode
      608     then do
      609     on error undo, return error return-value
      610     :
      611       pause 0 before-hide .
      612       if not mBatchMode then
      613         hide frame waitfram .
      614     if     not mWaitFramView
      615        and mWaitProcEvent
      616     then
      617       process events .
      618     end.
      619   end procedure.
      620   procedure waitfram-show :
      621     define input  parameter p-message as character no-undo .
      622     define variable v-left-margin as integer   no-undo .
      623     if not session:batch-mode
      624     then do
      625     on error undo, return error return-value
      626     :
      627       if length(p-message) <= 70 then do:
      628         assign
      629           v-left-margin = integer((70 - length(p-message)) / 2)
      630         .
      631         assign
      632           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      633         .
      634         assign
      635           v-waitfram-action01 = " "
      636           v-waitfram-action02 = " "
      637                                    + fill(" ", v-left-margin)
      638                                    + p-message
      639           v-waitfram-action03 = " "
      640         .
      641       end.
      642       else do:
      643         define variable vRindex1 as integer no-undo.
      644         define variable vRindex2 as integer no-undo.
      645         vRindex1 = r-index(p-message," ",70).
      646         if vRindex1 = 0
      647         then
      648            vRindex1 = 70.
      649         if length(p-message)  <= vRindex1 + 70 then do:
      650           assign
      651             v-waitfram-action01 = " "
      652             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      653             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      654           .
      655         end.
      656         else do:
      657           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      658           if vRindex2 <= vRindex1
      659           then
      660              vRindex2 = vRindex1 + 70.
      661           assign
      662             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      663             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      664             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      665           .
      666         end.
      667       end.
      668       B-viewProcInfo:visible   in frame waitfram = no.
      669       B-viewProcInfo:sensitive in frame waitfram = no.
      670       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      671       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      672       if  (   mWaitFramView
      673          or  mWaitProcEvent)
      674          and not mBatchMode
      675       then
      676          display
      677             v-waitfram-action01 skip
      678             v-waitfram-action02 skip
      679             v-waitfram-action03 skip
      680          with frame waitfram .
      681       if     mWaitFramView
      682          then do:
      683             if     mWaitFramInterval ne ?
      684                and not mBatchMode
      685             then
      686                wait-for go of frame waitfram pause mWaitFramInterval.
      687          end.
      688          else
      689             if     mWaitProcEvent
      690                and not mBatchMode
      691             then
      692                process events .
      693     end.
      694   end procedure.
      695      procedure waitfram-show-this:
      696         define input  parameter iInterval as int64 no-undo.
      697         define variable vtime as int64 no-undo.
      698         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      699         mWaitFramInterval = iInterval.
      700         run waitfram-show (substitute("&1&2 &3&4" ,
      701                                       mWaitFramTextBeg ,
      702                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      703                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      704                                       mWaitFramTextEnd
      705                                      )
      706                           ).
      707      end.
      708      procedure WaitFramRunPause:
      709         define input  parameter iInterval as dec no-undo.
      710         define variable vStart  as datetime-tz no-undo.
      711         define variable vend    as datetime-tz no-undo.
      712         define variable vint as int64 no-undo.
      713         define variable vOk as logical no-undo.
      714         vStart = now.
      715         vend   = vStart.
      716         publish "WaitFramPause" (iInterval,output vOk).
      717         vend   =  now.
      718         vint = vend - vStart.
      719         vint = iInterval - vint / 1000.
      720         if     not mWaitFramStop
      721            and (   vint > 0
      722                 or (    not vOk
      723                     and iInterval eq ?
      724                     )
      725                 )
      726         then
      727            run waitfram-show-this (iInterval).
      728         vend   =  now.
      729         vint = vend - vStart.
      730         vint = iInterval - vint / 1000.
      731         if     not mWaitFramStop
      732            and vint > 0
      733         then do:
      734            run gbl/pause.p (vint * 1000).
      735         end.
      736         if iInterval ne ?
      737         then
      738            publish "WaitFramStop".
      739         waitfram-check-timeout().
      740      end.
      741      procedure WaitFramWaitFor:
      742         define input  parameter iInterval as dec no-undo.
      743         assign
      744            mWaitFramStartProc   = now
      745            mWaitFramStopUser    = no
      746            mWaitFramStopTimeOut = no
      747         .
      748         block-wait:
      749         do while not mWaitFramStop:
      750            run WaitFramRunPause (iInterval).
      751            if  waitfram-check-timeout()
      752            then do:
      753               leave block-wait.
      754            end.
      755         end.
      756         run waitfram-hide.
      757      end.
      758   procedure waitfram-join :
      759     define input  parameter p-line-1  as character no-undo .
      760     define input  parameter p-line-2  as character no-undo .
      761     define input  parameter p-line-3  as character no-undo .
      762     define output parameter p-message as character no-undo .
      763     do
      764     on error undo, return error return-value
      765     :
      766       assign
      767         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      768                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      769                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      770       .
      771     end.
      772   end procedure.
      773   function waitfram-join-function returns character
      774     (input p-line-1 as character
      775     ,input p-line-2 as character
      776     ,input p-line-3 as character
      777     ).
      778     define variable v-message as character no-undo .
      779     run waitfram-join in this-procedure
      780       (input  p-line-1
      781       ,input  p-line-2
      782       ,input  p-line-3
      783       ,output v-message
      784       ) .
      785     return v-message .
      786   end function .
      787   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      788   FUNCTION mark-string RETURNS CHARACTER
      789     ( input p-recid as recid, input mark-list as character  ) :
      790     RETURN ( IF LOOKUP( STRING( p-recid), mark-list ) > 0 THEN '*' ELSE '':U ).
      791   END FUNCTION.
      792   function getstatus return char
      793      (iStatus as integer  ):
      794      define variable vStatus as character no-undo.
      795         vStatus = entry (lookup (string(iStatus), '0,1,50,99':U), 'тек,удал,блок,удаление':U) no-error.
      796      return vStatus.
      797   end.
      798   function getproceditEx return character
      799      (ibuffertt  as handle,
      800       iProcDefut as character):
      801      define variable oProc as character no-undo.
      802      define variable vparent     as character no-undo.
      803      define variable vcode       as character no-undo.
      804      define variable vLastdelim  as integer no-undo.
      805      define buffer code for code.
      806      if     ibuffertt::procedit ne ""
      807         and ibuffertt::procedit ne  ?
      808      then
      809         oProc = ibuffertt::procedit.
      810      else do:
      811         assign
      812            vLastdelim = r-index(ibuffertt::parent,chr(4))
      813            vparent    = if vLastdelim eq 0 then "" else substring(ibuffertt::parent,1,vLastdelim - 1)
      814            vcode      = if vLastdelim eq 0 then ibuffertt::parent else substring(ibuffertt::parent,vLastdelim + 1)
      815         .
      816         find first code where Code.parent eq vparent
      817                            and code.code  eq vcode
      818         no-lock no-error.
      819         block-code:
      820         do while available code and code.code ne "":
      821            if     code.procedit ne ?
      822               and code.procedit ne ""
      823            then do:
      824               oProc = code.procedit.
      825               leave block-code.
      826            end.
      827            assign
      828               vLastdelim = r-index(Code.parent,chr(4))
      829               vparent    = if vLastdelim eq 0 then "" else substring(Code.parent,1,vLastdelim - 1)
      830               vcode      = if vLastdelim eq 0 then Code.parent else substring(Code.parent,vLastdelim + 1)
      831            .
      832            find first code where Code.parent eq vparent
      833                               and code.code  eq vcode
      834            no-lock no-error.
      835         end.
      836      end.
      837      if    oProc eq ""
      838         or oProc eq ?
      839      then
      840         oProc = iProcDefut.
      841      return oProc.
      842   end.
      843   function getprocedit return character
      844      (ibuffertt  as handle):
      845      return getproceditEx(ibuffertt,"").
      846   end.
      847    define  temp-table tmprecid
      848       field Frecid as recid init ?
      849       field fnum as character
      850       field fTable as character
      851    index num  fnum Frecid
      852    index itable is primary unique fTable Frecid
      853    .
      854   define variable fSelect as logical no-undo format "*/" column-label "".
      855   function isSelect return logical
      856       (iBuffer as handle  ):
      857       define buffer tmprecid for tmprecid.
      858       if iBuffer:available
      859       then
      860          find first tmprecid where tmprecid.fTable = iBuffer:TABLE
      861                                and tmprecid.Frecid = iBuffer:recid
      862          no-lock no-error.
      863       return available tmprecid.
      864    end.
      865   function setSelect return logical
      866       (iBuffer as handle  ):
      867       define buffer tmprecid for tmprecid.
      868       if iBuffer:available
      869       then do:
      870          find first tmprecid where tmprecid.fTable = iBuffer:TABLE
      871                                and tmprecid.Frecid = iBuffer:recid
      872          no-lock no-error.
      873          if available tmprecid
      874          then
      875             delete tmprecid.
      876          else do:
      877             create tmprecid.
      878             assign
      879                tmprecid.fTable = iBuffer:TABLE
      880                tmprecid.Frecid = iBuffer:recid
      881             .
      882          end.
      883       end.
      884       return available tmprecid.
      885    end.
      886    procedure rid-keep :
      887        run gbl/rid-keep.p (input table tmprecid) no-error.
      888    end.
      889    procedure rid-rest :
      890         run gbl/rid-rest.p (output table tmprecid) no-error.
      891    end.
      892   define variable log-res     as log       no-undo.
      893   define variable ri          as recid     no-undo.
      894   define variable v-rid       as recid     no-undo .
      895   define variable v-db-num like ub.db.db-num no-undo .
      896   define variable MaxLevel as integer no-undo.
      897   function endLevel returns logical():
      898      return MaxLevel ne 0 and num-entries(iparent,chr(4))  eq  MaxLevel  .
      899   end.
      900   define variable startlevel as integer no-undo.
      901   startlevel = num-entries(iparent,chr(4)) .
      902   define variable mParent as character no-undo.
      903   if    iparent eq ""
      904      or iparent eq ?
      905   then
      906      mparent = icode.
      907   else
      908      mparent = iparent + chr(4) + icode.
      909   DEFINE BUTTON b-add
      910        LABEL "&Добавить":L
      911        SIZE 10 BY 1.
      912   DEFINE BUTTON b-chiled
      913        LABEL "&Открыть"
      914        SIZE 10 BY 1.
      915   DEFINE BUTTON b-del
      916        LABEL "&Удалить":L
      917        SIZE 10 BY 1.
      918   DEFINE BUTTON b-exit
      919        LABEL "&Выход ":L
      920        SIZE 10 BY 1.
      921   DEFINE BUTTON b-help
      922        LABEL "Помо&щь":L
      923        SIZE 3 BY 1.
      924   DEFINE BUTTON b-sel AUTO-GO
      925        LABEL "Вы&бор ":L
      926        SIZE 10 BY 1.
      927   DEFINE BUTTON b-upd
      928        LABEL "&Изменить":L
      929        SIZE 10 BY 1.
      930   DEFINE BUTTON b-look
      931        LABEL "&Просмотр":L
      932        SIZE 10 BY 1.
      933   DEFINE BUTTON b-hist
      934      LABEL "Ис&тория"
      935      SIZE 3 BY 1.
      936   define variable mSearch   as character       format "x(60)":U
      937      label "Поиск"
      938      view-as fill-in
      939      size 60 by 1 no-undo.
      940   define menu POPUP-MENU-b-hist
      941       menu-item mHistOne     label "История этой записи"
      942       menu-item mHistChiled  label "История потомков"
      943   .
      944   DEFINE QUERY BROWSE-Code FOR
      945         Code SCROLLING.
      946   DEFINE BROWSE BROWSE-Code
      947     QUERY BROWSE-Code NO-LOCK DISPLAY
      948         isSelect(buffer code:handle) @ fSelect
      949         Code.code FORMAT "x(20)":U
      950         Code.CodeName FORMAT "x(60)":U WIDTH 54.13
      951       WITH NO-ROW-MARKERS SEPARATORS SIZE 100 BY 25 ROW-HEIGHT-CHARS .67 FIT-LAST-COLUMN.
      952   DEFINE FRAME f-c-p
      953        b-exit AT ROW 1 COL 1
      954        b-sel AT ROW 1 COL 14
      955        b-add AT ROW 1 COL 24
      956        b-del AT ROW 1 COL 34 WIDGET-ID 2
      957        b-upd AT ROW 1 COL 44
      958        b-look AT ROW 1 COL 54
      959        b-help AT ROW 1 COL 81
      960        b-chiled AT ROW 1 COL 64 WIDGET-ID 10
      961        b-hist  AT ROW 1 COL 74
      962        mSearch AT ROW 2.5 col 1.2
      963        BROWSE-Code AT ROW 4 COL 1 WIDGET-ID 300
      964       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      965            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      966            TITLE iTitle.
      967   ASSIGN
      968          FRAME f-c-p:SCROLLABLE       = FALSE.
      969   on choose of menu-item mHistOne
      970   do:
      971      define variable v-rid-list as character no-undo.
      972      if avail Code then
      973      do:
      974         run ref/ccode.w (
      975                   Code.parent,
      976                   Code.code,
      977                   parparentproc,
      978                   0,
      979                   "",
      980                   0,
      981                   "",
      982                   "one",
      983                   ?,
      984                   "",
      985                   "" ,
      986                   v-cntxt-db-num,
      987                   ?,
      988                   input-output v-rid-list ) .
      989      end.
      990   end.
      991   on choose of menu-item mHistChiled
      992   do:
      993      define variable v-rid-list as character no-undo.
      994      if avail Code then
      995      do:
      996         run ref/ccode.w (
      997                   Code.parent,
      998                   Code.code,
      999                   parparentproc,
     1000                   0,
     1001                   "",
     1002                   0,
     1003                   "",
     1004                   "parentBeg",
     1005                   ?,
     1006                   "",
     1007                   "" ,
     1008                   v-cntxt-db-num,
     1009                   ?,
     1010                   input-output v-rid-list ) .
     1011      end.
     1012   end.
     1013   ON go OF FRAME f-c-p
     1014   do:
     1015   end.
     1016   ON choose OF b-exit IN FRAME f-c-p
     1017   do:
     1018      define variable vView as logical no-undo.
     1019      run PrevLevel(output vView).
     1020      if vView
     1021      then do:
     1022         OPEN QUERY BROWSE-Code FOR EACH code       where code.parent = mParent NO-LOCK INDEXED-REPOSITION.
     1023         apply "ENTRY" to BROWSE-Code.
     1024      end.
     1025      else
     1026         APPLY "GO" TO FRAME f-c-p.
     1027      return.
     1028   end.
     1029   ON choose OF b-add IN FRAME f-c-p
     1030   do:
     1031      define buffer b-code for code.
     1032      define variable vRec as recid no-undo.
     1033      define variable v-ok as logical no-undo.
     1034      define variable vProcNextLevel as character no-undo init "ref/codefrm.w".
     1035      define variable vparent as character no-undo.
     1036      define variable vcode as character no-undo.
     1037      if available code
     1038      then assign
     1039         vparent = Code.parent
     1040         vcode   = code.code
     1041         .
     1042      else  assign
     1043            vparent = mparent
     1044            vcode    = entry(num-entries(vparent,chr(4)),vparent,chr(4))
     1045            entry(num-entries(vparent,chr(4)),vparent,chr(4)) = ""
     1046            vparent = substring (vparent,1,length(vparent) - 1)
     1047      no-error.
     1048      find first b-code where b-code.parent eq vParent
     1049                          and b-code.code   eq vcode
     1050      no-lock no-error.
     1051      vProcNextLevel = getproceditEx(buffer b-code:handle,vProcNextLevel).
     1052      run value(vProcNextLevel) (
     1053                               input parparentproc
     1054                             , input 'ДОБАВЛЕНИЕ':U
     1055                             , input b-code.parent
     1056                             , input-output ri).
     1057      if ri <> ? then  do:
     1058               OPEN QUERY BROWSE-Code FOR EACH code       where code.parent = mParent NO-LOCK INDEXED-REPOSITION.
     1059               reposition BROWSE-Code to recid ri.
     1060               apply "ENTRY" to BROWSE-Code.
     1061      end.
     1062   end.
     1063   ON choose OF b-look IN FRAME f-c-p
     1064   do:
     1065      define variable vRec as recid no-undo.
     1066      define variable v-ok as logical no-undo.
     1067      define variable vProcNextLevel as character no-undo init "ref/codefrm.w".
     1068      if not avail code then return.
     1069      vRec = recid(code).
     1070      vProcNextLevel = getproceditEx(buffer code:handle,vProcNextLevel).
     1071      run value(vProcNextLevel)
     1072      (
     1073                               input parparentproc
     1074                             , input 'ПРОСМОТР':U
     1075                             , input mParent
     1076                             , input-output vRec).
     1077      if ri <> ? then  do:
     1078               OPEN QUERY BROWSE-Code FOR EACH code       where code.parent = mParent NO-LOCK INDEXED-REPOSITION.
     1079               reposition BROWSE-Code to recid ri.
     1080               apply "ENTRY" to BROWSE-Code.
     1081      end.
     1082   end.
     1083   ON choose OF b-chiled IN FRAME f-c-p
     1084   do:
     1085     run nextlevel.
     1086   end.
     1087   ON MOUSE-SELECT-DBLCLICK OF BROWSE-Code IN FRAME f-c-p
     1088   OR RETURN OF b-chiled IN FRAME f-c-p
     1089   DO:
     1090     apply "choose" to b-chiled in frame f-c-p.
     1091   END.
     1092   ON choose OF b-del IN FRAME f-c-p
     1093   do:
     1094      define buffer b1-code for code.
     1095      if not avail code then return.
     1096   define variable v-ok as logical no-undo.
     1097      message "Удалить запись группу параметров " code.code " (" code.codename ")?"
     1098         view-as alert-box question
     1099         buttons yes-no
     1100         title "Удаление"
     1101         update v-ok .
     1102      if not v-ok then return no-apply.
     1103      do on error undo, return
     1104      on stop undo, return:
     1105         find first b1-code of code exclusive-lock no-wait no-error.
     1106         if locked b1-code then do:
     1107            message
     1108               vss-workfile vss-revision vss-description skip
     1109               "Группа занята"
     1110            view-as alert-box error .
     1111            undo, return.
     1112         end.
     1113         if not available b1-code then do:
     1114            message
     1115               vss-workfile vss-revision vss-description skip
     1116               "Не найдена запись группы"
     1117            view-as alert-box error .
     1118            undo, return.
     1119         end.
     1120         delete b1-code.
     1121         OPEN QUERY BROWSE-Code FOR EACH code       where code.parent = mParent NO-LOCK INDEXED-REPOSITION.
     1122         apply "ENTRY" to BROWSE-Code.
     1123      end.
     1124   end.
     1125   ON choose OF b-sel IN FRAME f-c-p
     1126   do:
     1127      if not avail code then return.
     1128      setSelect(buffer code:handle).
     1129      BROWSE-Code:refresh ().
     1130   end.
     1131   ON choose OF b-upd IN FRAME f-c-p
     1132   do:
     1133      define variable vRec as recid no-undo.
     1134      if not avail code then return.
     1135      define variable v-ok as logical no-undo.
     1136      vRec = recid(code).
     1137      define variable vProcNextLevel as character no-undo init "ref/codefrm.w".
     1138      vProcNextLevel = getproceditEx(buffer code:handle,vProcNextLevel).
     1139      run value(vProcNextLevel)
     1140      (
     1141                               input parparentproc
     1142                             , input 'ИЗМЕНЕНИЕ':U
     1143                             , input Code.parent
     1144                             , input-output vRec).
     1145            OPEN QUERY BROWSE-Code FOR EACH code       where code.parent = mParent NO-LOCK INDEXED-REPOSITION.
     1146            reposition BROWSE-Code to recid vRec.
     1147            apply "ENTRY" to BROWSE-Code.
     1148         end.
     1149   on ENTER of mSearch in frame f-c-p
     1150   do:
     1151         define buffer buf-code-search for ub.code.
     1152      assign
     1153        msearch
     1154      .
     1155      define variable vRec as recid no-undo init ?.
     1156      block-code:
     1157      for each buf-code-search where (buf-code-search.parent = mParent and buf-code-search.code     begins msearch)
     1158                                 or (buf-code-search.parent = mParent and buf-code-search.CodeName begins msearch)
     1159      no-lock:
     1160         vRec = recid(buf-code-search).
     1161         leave block-code.
     1162      end.
     1163         if vRec eq ?
     1164      then do:
     1165         message "Запись не найдена"
     1166         view-as alert-box.
     1167      end.
     1168      else do:
     1169         reposition BROWSE-Code to recid vRec no-error .
     1170         apply "ENTRY" to BROWSE-Code.
     1171      end.
     1172   end.
     1173   if valid-handle(active-window) and frame f-c-p:PARENT eq ?
     1174     then frame f-c-p:PARENT = active-window.
     1175   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1176   on help of frame f-c-p
     1177   do:
     1178     run gbl/app_help.p
     1179       (input this-procedure :file-name
     1180       ,input ''
     1181       ,input ?
     1182       ) no-error.
     1183     if error-status :error then do:
     1184       message
     1185         "Ошибка при вызове помощи"
     1186         error-status :get-message(1)
     1187         view-as alert-box .
     1188     end.
     1189   end.
     1190   run minbtn-set in this-procedure .
     1191   on choose of b-help in frame f-c-p
     1192   do:
     1193     apply "help":u to frame f-c-p .
     1194   end.
     1195   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1196   procedure minbtn-set :
     1197       do
     1198           on error undo, return error return-value
     1199           :
     1200           define variable ii              as integer       no-undo .
     1201           define variable fh              as widget-handle no-undo .
     1202           define variable hh              as widget-handle no-undo .
     1203           define variable v-h             as handle        extent 4 no-undo .
     1204           define variable v-name-button   as character     no-undo .
     1205           define variable v-help-old-x    as decimal       no-undo .
     1206           define variable v-help-old-y    as decimal       no-undo .
     1207           define variable v-help-old-size as decimal       no-undo .
     1208           define variable v-frame-width   as decimal       no-undo .
     1209           define variable jj              as integer       no-undo .
     1210           do
     1211               on error undo, return error
     1212               :
     1213               assign
     1214                   v-frame-width = frame f-c-p:width - 0.3
     1215                   fh            = frame f-c-p:first-child
     1216                   hh            = fh:first-child
     1217                   ii            = 1
     1218                   .
     1219               do while valid-handle(hh):
     1220                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1221                   do:
     1222                       case lc(hh:name) :
     1223                           when "b-help" then
     1224                               do:
     1225                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1226                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1227                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1228                                   hh:TOOLTIP = "Помощь" .
     1229                                   v-help-old-x = hh:column .
     1230                                   v-help-old-y = hh:row    .
     1231                                   v-help-old-size = hh:width .
     1232                                   hh:width-chars = 2.5 .
     1233                               end.
     1234                           when "b-print" then
     1235                               do:
     1236                                   hh:load-image("cmp/b-print.bmp":u) .
     1237                                   hh:TOOLTIP = "Печать" .
     1238                                   v-h[ii] = hh:handle .
     1239                                   ii = ii + 1 .
     1240                                   hh:width-chars = 3 .
     1241                               end.
     1242                           when "b-history" or
     1243                           when "b-hist" then
     1244                               do:
     1245                                   hh:load-image("cmp/b-hist.bmp":u) .
     1246                                   hh:TOOLTIP = "История" .
     1247                                   v-h[ii] = hh:handle .
     1248                                   ii = ii + 1 .
     1249                                   hh:width-chars = 3 .
     1250                               end.
     1251                           when "b-sch" then
     1252                               do:
     1253                                   hh:load-image("cmp/b-sch.bmp":u) .
     1254                                   hh:TOOLTIP = "Установка Фильтра" .
     1255                                   v-h[ii] = hh:handle .
     1256                                   ii = ii + 1 .
     1257                                   hh:width-chars = 3 .
     1258                               end.
     1259                           when "b-hist-user" then
     1260                               do:
     1261                                   hh:load-image("cmp/b-hist.bmp":u) .
     1262                                   hh:TOOLTIP = "История пользователя" .
     1263                                   ii = ii + 1 .
     1264                               end.
     1265                       end case.
     1266                   end.
     1267                   hh = hh:next-sibling.
     1268               end.
     1269               b-help:column = v-frame-width - b-help:width-chars.
     1270               jj = 0.
     1271               repeat ii = 4 to 1 by -1 :
     1272                   if valid-handle (v-h[ii] ) then
     1273                   do:
     1274                       jj  = jj + 1 .
     1275                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1276                       v-h[ii]:row    = v-help-old-y .
     1277                   end.
     1278               end.
     1279           end.
     1280       end.
     1281   end procedure.
     1282   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1283   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1284   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1285   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1286   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1287   define variable v-diasize-current-frame-height as decimal   no-undo .
     1288   define variable v-diasize-change-size          as logical   no-undo .
     1289   define variable v-diasize-resize-button        as handle    no-undo .
     1290   define variable v-diasize-wndmax               as logical   no-undo .
     1291   define variable v-diasize-wndstore             as logical   no-undo .
     1292   define variable v-diasize-proc-name            as character no-undo .
     1293   define variable v-diasize-browse-handle        as handle    no-undo .
     1294   define variable v-diasize-browse-number        as integer   no-undo .
     1295   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1296   define temp-table temp-diasize-handle no-undo
     1297     field handle-value  as handle
     1298     field save-position as decimal
     1299     index xpk is primary unique handle-value
     1300     .
     1301   define temp-table temp-browse-handle no-undo
     1302     field browse-type   as character
     1303     field browse-number as integer
     1304     field browse-handle as handle
     1305     field original-size as decimal
     1306     index xpk is primary unique browse-type browse-number
     1307     index xie browse-type browse-handle
     1308   .
     1309   procedure diasize_change-height :
     1310     define input  parameter p-change-value  as decimal   no-undo .
     1311     define input  parameter p-move-resize   as logical   no-undo .
     1312     define variable v-field-group-handle    as handle    no-undo .
     1313     define variable v-object-handle         as handle    no-undo .
     1314     define variable v-frame-height          as decimal   no-undo .
     1315     define variable v-frame-virtual-height  as decimal   no-undo .
     1316     define variable v-browse-height         as decimal   no-undo .
     1317     define variable v-window-height         as decimal   no-undo .
     1318     define variable v-window-virtual-height as decimal   no-undo .
     1319     define variable v-change-sign           as integer   no-undo .
     1320     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1321     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1322     if p-change-value > 0
     1323     then do:
     1324       if frame f-c-p :height + p-change-value
     1325           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1326       then do:
     1327         assign
     1328           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1329                           - (frame f-c-p :height-chars)
     1330         .
     1331         if p-change-value <= 0
     1332         then do:
     1333           run diasize_position-resize-button in this-procedure .
     1334           return .
     1335         end.
     1336       end.
     1337     end.
     1338     if p-change-value < 0
     1339     then do:
     1340       if frame f-c-p :height + p-change-value < v-diasize-orig-frame-height
     1341       then do:
     1342         assign
     1343           p-change-value = v-diasize-orig-frame-height
     1344                          - (frame f-c-p :height-chars)
     1345         .
     1346         if p-change-value >= 0
     1347         then do:
     1348           run diasize_position-resize-button in this-procedure .
     1349           return .
     1350         end.
     1351       end.
     1352     end.
     1353     if p-change-value >= 0
     1354     then do:
     1355       assign
     1356         v-change-sign = 1
     1357       .
     1358     end.
     1359     else do:
     1360       assign
     1361         v-change-sign = -1
     1362       .
     1363     end.
     1364     assign
     1365       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1366     .
     1367     if p-change-value = 0
     1368     then do:
     1369       run diasize_position-resize-button in this-procedure .
     1370       return .
     1371     end.
     1372     move_block:
     1373     do
     1374     on error undo move_block, retry move_block
     1375     :
     1376       if retry
     1377       then do:
     1378         do
     1379         on error undo move_block, leave move_block
     1380         :
     1381           if p-change-value > 0
     1382           then do:
     1383             for each buf_temp-diasize-handle
     1384             on error undo, next
     1385             :
     1386               assign
     1387                 v-object-handle = buf_temp-diasize-handle.handle-value
     1388               .
     1389               if v-object-handle <> v-diasize-resize-button
     1390               then do:
     1391                 assign
     1392                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1393                 .
     1394               end.
     1395             end.
     1396             assign
     1397               v-diasize-browse-handle :height = v-browse-height
     1398             .
     1399             for each buf_temp-browse-handle
     1400               where buf_temp-browse-handle.browse-type = 'height':u
     1401             on error undo, next
     1402             :
     1403               assign
     1404                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1405               .
     1406             end.
     1407             assign
     1408               frame f-c-p :height = v-frame-height
     1409             .
     1410             if frame f-c-p :scrollable = true
     1411             then do:
     1412               assign
     1413                 frame f-c-p :virtual-height = v-frame-virtual-height
     1414               .
     1415             end.
     1416             run diasize_position-resize-button in this-procedure .
     1417           end.
     1418           else do:
     1419             if frame f-c-p :scrollable = true
     1420             then do:
     1421               assign
     1422                 frame f-c-p :virtual-height = v-frame-virtual-height
     1423               .
     1424             end.
     1425             assign
     1426               frame f-c-p :height = v-frame-height
     1427             .
     1428             assign
     1429               v-diasize-browse-handle :height = v-browse-height
     1430             .
     1431             for each buf_temp-browse-handle
     1432               where buf_temp-browse-handle.browse-type = 'height':u
     1433             on error undo, next
     1434             :
     1435               assign
     1436                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1437               .
     1438             end.
     1439             for each buf_temp-diasize-handle
     1440             on error undo, next
     1441             :
     1442               assign
     1443                 v-object-handle = buf_temp-diasize-handle.handle-value
     1444               .
     1445               if v-object-handle <> v-diasize-resize-button
     1446               then do:
     1447                 assign
     1448                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1449                 .
     1450               end.
     1451             end.
     1452             run diasize_position-resize-button in this-procedure .
     1453           end.
     1454           assign
     1455             v-diasize-change-size = false
     1456           .
     1457           leave move_block .
     1458         end.
     1459       end.
     1460       assign
     1461         v-diasize-need-full-display = true
     1462       .
     1463       if v-diasize-change-size = false
     1464       then do:
     1465         assign
     1466           v-diasize-change-size = true
     1467         .
     1468       end.
     1469       else do:
     1470         return .
     1471       end.
     1472       assign
     1473         v-frame-height = frame f-c-p :height
     1474         v-frame-virtual-height = frame f-c-p :virtual-height
     1475         v-browse-height = v-diasize-browse-handle :height
     1476       .
     1477       for each buf_temp-browse-handle
     1478         where buf_temp-browse-handle.browse-type = 'height':u
     1479       :
     1480         assign
     1481           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1482         .
     1483       end.
     1484       for each buf_temp-diasize-handle
     1485       :
     1486         delete buf_temp-diasize-handle .
     1487       end.
     1488       assign
     1489         v-field-group-handle = frame f-c-p :first-child
     1490       .
     1491       do while valid-handle(v-field-group-handle)
     1492       :
     1493         assign
     1494           v-object-handle = v-field-group-handle :first-child
     1495         .
     1496         do while valid-handle(v-object-handle)
     1497         :
     1498           if  v-object-handle <> v-diasize-browse-handle :handle
     1499           and can-query(v-object-handle, "row")
     1500           and can-query(v-object-handle, "height")
     1501           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1502           then do:
     1503             find first buf_temp-browse-handle
     1504               where buf_temp-browse-handle.browse-type   = 'height':u
     1505                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1506               no-error .
     1507             if available buf_temp-browse-handle
     1508             then do:
     1509             end.
     1510             else do:
     1511               create buf_temp-diasize-handle .
     1512               assign
     1513                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1514                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1515               .
     1516             end.
     1517           end.
     1518           assign
     1519             v-object-handle = v-object-handle :next-sibling
     1520           .
     1521         end.
     1522         assign
     1523           v-field-group-handle = v-field-group-handle :next-sibling
     1524         .
     1525       end.
     1526       do with frame f-c-p
     1527       :
     1528         hide v-diasize-resize-button .
     1529         assign
     1530           v-diasize-resize-button :row    = 1
     1531           v-diasize-resize-button :column = 1
     1532         .
     1533       end.
     1534       if p-change-value > 0
     1535       then do:
     1536         if frame f-c-p :scrollable = true
     1537         then do:
     1538           assign
     1539             frame f-c-p :virtual-height = frame f-c-p :virtual-height + p-change-value
     1540             no-error .
     1541           if error-status :error
     1542           or error-status :get-message(1) <> ""
     1543           then do:
     1544             undo move_block, retry move_block .
     1545           end.
     1546         end.
     1547         assign
     1548           frame f-c-p :height = frame f-c-p :height + p-change-value
     1549           no-error .
     1550         if error-status :error
     1551         or error-status :get-message(1) <> ""
     1552         then do:
     1553           undo move_block, retry move_block .
     1554         end.
     1555         assign
     1556           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1557           no-error .
     1558         if error-status :error
     1559         or error-status :get-message(1) <> ""
     1560         then do:
     1561           undo move_block, retry move_block .
     1562         end.
     1563         for each buf_temp-browse-handle
     1564           where buf_temp-browse-handle.browse-type = 'height':u
     1565         on error undo move_block, retry move_block
     1566         :
     1567           assign
     1568             buf_temp-browse-handle.browse-handle :height
     1569               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1570             no-error .
     1571           if error-status :error
     1572           or error-status :get-message(1) <> ""
     1573           then do:
     1574             undo move_block, retry move_block .
     1575           end.
     1576         end.
     1577         for each buf_temp-diasize-handle
     1578         on error undo move_block, retry move_block
     1579         :
     1580           assign
     1581             v-object-handle = buf_temp-diasize-handle.handle-value
     1582           .
     1583           if v-object-handle <> v-diasize-resize-button
     1584           then do:
     1585             assign
     1586               v-object-handle :row = v-object-handle :row + p-change-value
     1587               no-error .
     1588             if error-status :error
     1589             or error-status :get-message(1) <> ""
     1590             then do:
     1591               undo move_block, retry move_block .
     1592             end.
     1593           end.
     1594         end.
     1595       end.
     1596       else do:
     1597         for each buf_temp-diasize-handle
     1598         on error undo move_block, retry move_block
     1599         :
     1600           assign
     1601             v-object-handle = buf_temp-diasize-handle.handle-value
     1602           .
     1603           if v-object-handle <> v-diasize-resize-button
     1604           then do:
     1605             assign
     1606               v-object-handle :row = v-object-handle :row + p-change-value
     1607               no-error .
     1608             if error-status :error
     1609             or error-status :get-message(1) <> ""
     1610             then do:
     1611               undo move_block, retry move_block .
     1612             end.
     1613           end.
     1614         end.
     1615         assign
     1616           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1617           no-error .
     1618         if error-status :error
     1619         or error-status :get-message(1) <> ""
     1620         then do:
     1621           undo move_block, retry move_block .
     1622         end.
     1623         for each buf_temp-browse-handle
     1624           where buf_temp-browse-handle.browse-type = 'height':u
     1625         on error undo move_block, retry move_block
     1626         :
     1627           assign
     1628             buf_temp-browse-handle.browse-handle :height
     1629               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1630             no-error .
     1631           if error-status :error
     1632           or error-status :get-message(1) <> ""
     1633           then do:
     1634             undo move_block, retry move_block .
     1635           end.
     1636         end.
     1637         assign
     1638           frame f-c-p :height = frame f-c-p :height + p-change-value
     1639           no-error .
     1640         if error-status :error
     1641         or error-status :get-message(1) <> ""
     1642         then do:
     1643           undo move_block, retry move_block .
     1644         end.
     1645         if frame f-c-p :scrollable = true
     1646         then do:
     1647           assign
     1648             frame f-c-p :virtual-height = frame f-c-p :virtual-height + p-change-value
     1649             no-error .
     1650           if error-status :error
     1651           or error-status :get-message(1) <> ""
     1652           then do:
     1653             undo move_block, retry move_block .
     1654           end.
     1655         end.
     1656       end.
     1657       if p-move-resize = true
     1658       then do:
     1659         run diasize_position-resize-button in this-procedure .
     1660       end.
     1661       if v-diasize-wndstore = true
     1662       then do:
     1663         if connected("ub") = true
     1664         then do:
     1665           define variable v-cntxt-db-num        as integer   no-undo .
     1666           define variable v-cntxt-userid        as character no-undo .
     1667           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1668                                             , OUTPUT v-cntxt-userid
     1669                                             ) .
     1670           run gbl/wndsizew.p
     1671             (input  v-cntxt-db-num
     1672             ,input  v-cntxt-userid
     1673             ,input  v-diasize-proc-name
     1674             ,input  'height':u
     1675             ,input  string(frame f-c-p :height - v-diasize-orig-frame-height)
     1676             ) .
     1677         end.
     1678       end.
     1679     end.
     1680     assign
     1681       v-diasize-change-size = false
     1682     .
     1683   end procedure.
     1684   procedure diasize_set-height :
     1685     define input  parameter p-new-height  as decimal   no-undo .
     1686     define input  parameter p-move-resize as logical   no-undo .
     1687     do
     1688     on error undo, return error return-value
     1689     :
     1690       run diasize_change-height in this-procedure
     1691         (input  (p-new-height - frame f-c-p :height)
     1692         ,input  p-move-resize
     1693         ) .
     1694     end.
     1695   end procedure.
     1696   procedure diasize_change-width :
     1697     define input  parameter p-change-value as decimal   no-undo .
     1698     define input  parameter p-move-resize  as logical   no-undo .
     1699     define variable v-field-group-handle   as handle    no-undo .
     1700     define variable v-object-handle        as handle    no-undo .
     1701     define variable v-frame-width          as decimal   no-undo .
     1702     define variable v-frame-virtual-width  as decimal   no-undo .
     1703     define variable v-browse-width         as decimal   no-undo .
     1704     define variable v-window-width         as decimal   no-undo .
     1705     define variable v-window-virtual-width as decimal   no-undo .
     1706     define variable v-change-sign          as integer   no-undo .
     1707     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1708     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1709     if p-change-value > 0
     1710     then do:
     1711       if frame f-c-p :width + p-change-value >
     1712           session :width-chars
     1713       then do:
     1714         assign
     1715           p-change-value = session :width-chars - frame f-c-p :width
     1716         .
     1717         if p-change-value <= 0
     1718         then do:
     1719           run diasize_position-resize-button in this-procedure .
     1720           return .
     1721         end.
     1722       end.
     1723     end.
     1724     if p-change-value < 0
     1725     then do:
     1726       if frame f-c-p :width + p-change-value < v-diasize-orig-frame-width
     1727       then do:
     1728         assign
     1729           p-change-value = v-diasize-orig-frame-width
     1730                          - frame f-c-p :width
     1731         .
     1732         if p-change-value >= 0
     1733         then do:
     1734           run diasize_position-resize-button in this-procedure .
     1735           return .
     1736         end.
     1737       end.
     1738     end.
     1739     if p-change-value >= 0
     1740     then do:
     1741       assign
     1742         v-change-sign = 1
     1743       .
     1744     end.
     1745     else do:
     1746       assign
     1747         v-change-sign = -1
     1748       .
     1749     end.
     1750     assign
     1751       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1752     .
     1753     if p-change-value = 0
     1754     then do:
     1755       run diasize_position-resize-button in this-procedure .
     1756       return .
     1757     end.
     1758     move_block:
     1759     do
     1760     on error undo move_block, leave move_block
     1761     :
     1762       if retry
     1763       then do:
     1764         do
     1765         on error undo move_block, leave move_block
     1766         :
     1767           if p-change-value > 0
     1768           then do:
     1769             for each buf_temp-diasize-handle
     1770             on error undo, next
     1771             :
     1772               assign
     1773                 v-object-handle = buf_temp-diasize-handle.handle-value
     1774               .
     1775               if v-object-handle <> v-diasize-resize-button
     1776               then do:
     1777                 assign
     1778                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1779                 .
     1780               end.
     1781             end.
     1782             assign
     1783               v-diasize-browse-handle :width = v-browse-width
     1784             .
     1785             for each buf_temp-browse-handle
     1786               where buf_temp-browse-handle.browse-type = 'width':u
     1787             on error undo, next
     1788             :
     1789               assign
     1790                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1791               .
     1792             end.
     1793             assign
     1794               frame f-c-p :width = v-frame-width
     1795             .
     1796             if frame f-c-p :scrollable = true
     1797             then do:
     1798               assign
     1799                 frame f-c-p :virtual-width = v-frame-virtual-width
     1800               .
     1801             end.
     1802             run diasize_position-resize-button in this-procedure .
     1803           end.
     1804           else do:
     1805             if frame f-c-p :scrollable = true
     1806             then do:
     1807               assign
     1808                 frame f-c-p :virtual-width = v-frame-virtual-width
     1809               .
     1810             end.
     1811             assign
     1812               frame f-c-p :width = v-frame-width
     1813             .
     1814             for each buf_temp-browse-handle
     1815               where buf_temp-browse-handle.browse-type = 'width':u
     1816             on error undo, next
     1817             :
     1818               assign
     1819                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1820               .
     1821             end.
     1822             assign
     1823               v-diasize-browse-handle :width = v-browse-width
     1824             .
     1825             for each buf_temp-diasize-handle
     1826             on error undo, next
     1827             :
     1828               assign
     1829                 v-object-handle = buf_temp-diasize-handle.handle-value
     1830               .
     1831               if v-object-handle <> v-diasize-resize-button
     1832               then do:
     1833                 assign
     1834                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1835                 .
     1836               end.
     1837             end.
     1838             run diasize_position-resize-button in this-procedure .
     1839           end.
     1840           assign
     1841             v-diasize-change-size = false
     1842           .
     1843           leave move_block .
     1844         end.
     1845       end.
     1846       assign
     1847         v-diasize-need-full-display = true
     1848       .
     1849       if v-diasize-change-size = false
     1850       then do:
     1851         assign
     1852           v-diasize-change-size = true
     1853         .
     1854       end.
     1855       else do:
     1856         return .
     1857       end.
     1858       assign
     1859         v-frame-width = frame f-c-p :width
     1860         v-frame-virtual-width = frame f-c-p :virtual-width
     1861         v-browse-width = v-diasize-browse-handle :width
     1862       .
     1863       for each buf_temp-browse-handle
     1864         where buf_temp-browse-handle.browse-type = 'width':u
     1865       :
     1866         assign
     1867           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1868         .
     1869       end.
     1870       for each buf_temp-diasize-handle
     1871       :
     1872         delete buf_temp-diasize-handle .
     1873       end.
     1874       assign
     1875         v-field-group-handle = frame f-c-p :first-child
     1876       .
     1877       do while valid-handle(v-field-group-handle)
     1878       :
     1879         assign
     1880           v-object-handle = v-field-group-handle :first-child
     1881         .
     1882         do while valid-handle(v-object-handle)
     1883         :
     1884           if  v-object-handle <> v-diasize-browse-handle :handle
     1885           and v-object-handle <> v-diasize-resize-button
     1886           and can-query(v-object-handle, "row")
     1887           and can-query(v-object-handle, "height")
     1888           and ( v-object-handle :col + v-object-handle :width
     1889                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1890               )
     1891           then do:
     1892             find first buf_temp-browse-handle
     1893               where buf_temp-browse-handle.browse-type   = 'width':u
     1894                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1895               no-error .
     1896             if available buf_temp-browse-handle
     1897             then do:
     1898             end.
     1899             else do:
     1900               create buf_temp-diasize-handle .
     1901               assign
     1902                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1903                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1904               .
     1905             end.
     1906           end.
     1907           assign
     1908             v-object-handle = v-object-handle :next-sibling
     1909           .
     1910         end.
     1911         assign
     1912           v-field-group-handle = v-field-group-handle :next-sibling
     1913         .
     1914       end.
     1915       do with frame f-c-p
     1916       :
     1917         hide v-diasize-resize-button .
     1918         v-diasize-resize-button :row = 1.
     1919         v-diasize-resize-button :column = 1.
     1920       end.
     1921       if p-change-value > 0
     1922       then do:
     1923         if frame f-c-p :scrollable = true
     1924         then do:
     1925           assign
     1926             frame f-c-p :virtual-width = frame f-c-p :virtual-width + p-change-value
     1927             no-error .
     1928           if error-status :error
     1929           or error-status :get-message(1) <> ""
     1930           then do:
     1931             undo move_block, retry move_block.
     1932           end.
     1933         end.
     1934         assign
     1935           frame f-c-p :width = v-frame-width + p-change-value
     1936           no-error .
     1937         if error-status :error
     1938         or error-status :get-message(1) <> ""
     1939         then do:
     1940           undo move_block, retry move_block.
     1941         end.
     1942         assign
     1943           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1944         no-error .
     1945         if error-status :error
     1946         or error-status :get-message(1) <> ""
     1947         then do:
     1948           undo move_block, retry move_block.
     1949         end.
     1950         for each buf_temp-browse-handle
     1951           where buf_temp-browse-handle.browse-type = 'width':u
     1952         on error undo move_block, retry move_block
     1953         :
     1954           assign
     1955             buf_temp-browse-handle.browse-handle :width
     1956               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1957             no-error .
     1958           if error-status :error
     1959           or error-status :get-message(1) <> ""
     1960           then do:
     1961             undo move_block, retry move_block .
     1962           end.
     1963         end.
     1964         for each buf_temp-diasize-handle
     1965         on error undo move_block, retry move_block
     1966         :
     1967           assign
     1968             v-object-handle = buf_temp-diasize-handle.handle-value
     1969           .
     1970           if v-object-handle <> v-diasize-resize-button
     1971           then do:
     1972             assign
     1973               v-object-handle :col = v-object-handle :col + p-change-value
     1974               no-error .
     1975             if error-status :error
     1976             or error-status :get-message(1) <> ""
     1977             then do:
     1978               undo move_block, retry move_block .
     1979             end.
     1980           end.
     1981         end.
     1982       end.
     1983       else do:
     1984         for each buf_temp-diasize-handle
     1985         on error undo move_block, retry move_block
     1986         :
     1987           assign
     1988             v-object-handle = buf_temp-diasize-handle.handle-value
     1989           .
     1990           if v-object-handle <> v-diasize-resize-button
     1991           then do:
     1992             assign
     1993               v-object-handle :col = v-object-handle :col + p-change-value
     1994               no-error .
     1995             if error-status :error
     1996             or error-status :get-message(1) <> ""
     1997             then do:
     1998               undo move_block, retry move_block .
     1999             end.
     2000           end.
     2001         end.
     2002         for each buf_temp-browse-handle
     2003           where buf_temp-browse-handle.browse-type = 'width':u
     2004         on error undo move_block, retry move_block
     2005         :
     2006           assign
     2007             buf_temp-browse-handle.browse-handle :width
     2008               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2009             no-error .
     2010           if error-status :error
     2011           or error-status :get-message(1) <> ""
     2012           then do:
     2013             undo move_block, retry move_block .
     2014           end.
     2015         end.
     2016         assign
     2017           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2018           no-error .
     2019         if error-status :error
     2020         or error-status :get-message(1) <> ""
     2021         then do:
     2022           undo move_block, retry move_block.
     2023         end.
     2024         assign
     2025           frame f-c-p :width = frame f-c-p :width + p-change-value
     2026         no-error .
     2027         if error-status :error
     2028         or error-status :get-message(1) <> ""
     2029         then do:
     2030           undo move_block, retry move_block.
     2031         end.
     2032         if frame f-c-p :scrollable = true
     2033         then do:
     2034           assign
     2035             frame f-c-p :virtual-width = frame f-c-p :virtual-width + p-change-value
     2036           no-error .
     2037           if error-status :error
     2038           or error-status :get-message(1) <> ""
     2039           then do:
     2040             undo move_block, retry move_block.
     2041           end.
     2042         end.
     2043       end.
     2044       if p-move-resize
     2045       then do:
     2046         run diasize_position-resize-button in this-procedure .
     2047       end.
     2048       if v-diasize-wndstore = true
     2049       then do:
     2050         if connected("ub") = true
     2051         then do:
     2052           define variable v-cntxt-db-num        as integer   no-undo .
     2053           define variable v-cntxt-userid        as character no-undo .
     2054           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2055                                             , OUTPUT v-cntxt-userid
     2056                                             ) .
     2057           run gbl/wndsizew.p
     2058             (input  v-cntxt-db-num
     2059             ,input  v-cntxt-userid
     2060             ,input  v-diasize-proc-name
     2061             ,input  'width':u
     2062             ,input  string(frame f-c-p :width - v-diasize-orig-frame-width)
     2063             ) .
     2064         end.
     2065       end.
     2066     end.
     2067     assign
     2068       v-diasize-change-size = false
     2069     .
     2070   end procedure.
     2071   procedure diasize_set-width :
     2072     define input  parameter p-new-width  as decimal   no-undo .
     2073     define input  parameter p-move-resize as logical   no-undo .
     2074     do
     2075     on error undo, return error return-value
     2076     :
     2077       run diasize_change-width in this-procedure
     2078         (input  (p-new-width - frame f-c-p :width)
     2079         ,input  p-move-resize
     2080         ) .
     2081     end.
     2082   end procedure.
     2083   procedure diasize_position-resize-button :
     2084     do with frame f-c-p
     2085     :
     2086       hide v-diasize-resize-button .
     2087       assign
     2088         v-diasize-resize-button :row = frame f-c-p :height - v-diasize-resize-button :height
     2089                     - 1
     2090                     - (frame f-c-p :border-bottom-pixels / session :pixels-per-row)
     2091         v-diasize-resize-button :col = frame f-c-p :width - v-diasize-resize-button :width
     2092                     - 1
     2093                     - (frame f-c-p :border-right-pixels / session :pixels-per-column)
     2094       .
     2095       view v-diasize-resize-button .
     2096     end.
     2097   end procedure.
     2098   on alt-right anywhere
     2099   do:
     2100     run diasize_change-width in this-procedure
     2101       (input 1
     2102       ,input true
     2103       ) .
     2104     return no-apply .
     2105   end.
     2106   on alt-left anywhere
     2107   do:
     2108     run diasize_change-width in this-procedure
     2109       (input -1
     2110       ,input true
     2111       ) .
     2112     return no-apply .
     2113   end.
     2114   on alt-down anywhere
     2115   do:
     2116     run diasize_change-height in this-procedure
     2117       (input 1
     2118       ,input true
     2119       ) .
     2120     return no-apply .
     2121   end.
     2122   on alt-up anywhere
     2123   do:
     2124     run diasize_change-height in this-procedure
     2125       (input -1
     2126       ,input true
     2127       ) .
     2128     return no-apply .
     2129   end.
     2130   on alt-enter of frame f-c-p
     2131   do:
     2132     run diasize_maximize in this-procedure
     2133       (input  ?
     2134       ).
     2135     return no-apply .
     2136   end.
     2137   procedure diasize_end-move :
     2138     do
     2139     on error undo, return error return-value
     2140     :
     2141       define variable v-row-delta as decimal   no-undo .
     2142       define variable v-col-delta as decimal   no-undo .
     2143       define variable v-new-row as decimal   no-undo .
     2144       define variable v-new-col as decimal   no-undo .
     2145       assign
     2146         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2147         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2148       .
     2149       assign
     2150         v-row-delta = v-new-row - frame f-c-p :height
     2151         v-col-delta = v-new-col - frame f-c-p :width
     2152       .
     2153       run diasize_change-height in this-procedure
     2154         (input v-row-delta
     2155         ,input true
     2156         ) .
     2157       run diasize_change-width in this-procedure
     2158         (input v-col-delta
     2159         ,input true
     2160         ) .
     2161     end.
     2162   end procedure.
     2163   procedure diasize_maximize :
     2164     define input  parameter p-action as logical   no-undo .
     2165     do
     2166     on error undo, return error return-value
     2167     :
     2168       if p-action = ?
     2169       then do:
     2170         if v-diasize-need-maximize = true
     2171         then do:
     2172           assign
     2173             p-action = true
     2174           .
     2175         end.
     2176         else do:
     2177           assign
     2178             p-action = false
     2179           .
     2180         end.
     2181       end.
     2182       if p-action = true
     2183       then do:
     2184         run diasize_change-height in this-procedure
     2185           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2186               - frame f-c-p :height-chars
     2187           ,input true
     2188           ) .
     2189         run diasize_change-width in this-procedure
     2190           (input session :width-chars
     2191               - frame f-c-p :width-chars
     2192           ,input true
     2193           ) .
     2194         assign
     2195           v-diasize-need-maximize = false
     2196         .
     2197       end.
     2198       else do:
     2199         run diasize_change-width in this-procedure
     2200           (input v-diasize-orig-frame-width
     2201               - frame f-c-p :width-chars
     2202           ,input true
     2203           ) .
     2204         run diasize_change-height in this-procedure
     2205           (input v-diasize-orig-frame-height
     2206               - frame f-c-p :height-chars
     2207           ,input true
     2208           ) .
     2209         assign
     2210           v-diasize-need-maximize = true
     2211         .
     2212       end.
     2213     end.
     2214   end procedure.
     2215   procedure diasize_restore-orig-size :
     2216     do
     2217     on error undo, return error return-value
     2218     :
     2219       assign
     2220         v-diasize-current-frame-width  = frame f-c-p :width
     2221         v-diasize-current-frame-height = frame f-c-p :height
     2222       .
     2223       run diasize_set-height in this-procedure
     2224         (input  v-diasize-orig-frame-height
     2225         ,input  true
     2226         ) .
     2227       run diasize_set-width in this-procedure
     2228         (input  v-diasize-orig-frame-width
     2229         ,input  true
     2230         ) .
     2231     end.
     2232   end procedure.
     2233   procedure diasize_restore-current-size :
     2234     do
     2235     on error undo, return error return-value
     2236     :
     2237       run diasize_set-height in this-procedure
     2238         (input  v-diasize-current-frame-height
     2239         ,input  true
     2240         ) .
     2241       run diasize_set-width in this-procedure
     2242         (input  v-diasize-current-frame-width
     2243         ,input  true
     2244         ) .
     2245     end.
     2246   end procedure.
     2247   procedure diasize_set-browse-handle :
     2248     define input  parameter p-browse-handle as handle   no-undo .
     2249     define buffer buf_temp-browse-handle for temp-browse-handle .
     2250     do
     2251     on error undo, return error return-value
     2252     :
     2253       assign
     2254         v-diasize-browse-handle = p-browse-handle
     2255       .
     2256       for each buf_temp-browse-handle
     2257       on error undo, return error return-value
     2258       :
     2259         delete buf_temp-browse-handle .
     2260       end.
     2261     end.
     2262   end procedure.
     2263   procedure diasize_add_browse :
     2264     define input  parameter p-browse-type   as character no-undo .
     2265     define input  parameter p-browse-handle as handle    no-undo .
     2266     define buffer buf_temp-browse-handle for temp-browse-handle .
     2267     do
     2268     on error undo, return error return-value
     2269     :
     2270       assign
     2271         v-diasize-browse-number = v-diasize-browse-number + 1
     2272       .
     2273       create buf_temp-browse-handle .
     2274       assign
     2275         buf_temp-browse-handle.browse-type   = p-browse-type
     2276         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2277         buf_temp-browse-handle.browse-handle = p-browse-handle
     2278       .
     2279     end.
     2280   end procedure.
     2281   procedure diasize_init :
     2282     define variable v-default-value    as logical   no-undo .
     2283     define variable v-restore-saved    as logical   no-undo .
     2284     define variable v-resize-value-str as character no-undo .
     2285     do
     2286     on error undo, return error return-value
     2287     :
     2288       do with frame f-c-p
     2289       :
     2290         assign
     2291           v-diasize-orig-frame-height = frame f-c-p :height
     2292           v-diasize-orig-frame-width  = frame f-c-p :width
     2293           v-diasize-browse-handle     = browse BROWSE-Code :handle
     2294         .
     2295         create button v-diasize-resize-button
     2296         assign
     2297           parent        = frame f-c-p :first-child
     2298           label         = "s"
     2299           height-pixels = 16
     2300           width-pixels  = 16
     2301           visible       = true
     2302           sensitive     = true
     2303           movable       = true
     2304           triggers:
     2305             on end-move persistent run diasize_end-move in this-procedure .
     2306           end triggers.
     2307         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2308         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2309         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2310         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2311         assign
     2312           v-diasize-wndmax = false
     2313         .
     2314         if connected("ub") = true
     2315         then do:
     2316           define variable v-cntxt-db-num        as integer   no-undo .
     2317           define variable v-cntxt-userid        as character no-undo .
     2318           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2319                                             , OUTPUT v-cntxt-userid
     2320                                             ) .
     2321           run gbl/wndpar_r.p
     2322             (input  v-cntxt-db-num
     2323             ,input  v-cntxt-userid
     2324             ,input  'wndmax':U
     2325             ,output v-diasize-wndmax
     2326             ,output v-default-value
     2327             ) .
     2328         end.
     2329         assign
     2330           v-diasize-wndstore = false
     2331         .
     2332         if connected("ub") = true
     2333         then do:
     2334           run gbl/wndpar_r.p
     2335             (input  v-cntxt-db-num
     2336             ,input  v-cntxt-userid
     2337             ,input  'wndstore':U
     2338             ,output v-diasize-wndstore
     2339             ,output v-default-value
     2340             ) .
     2341         end.
     2342         assign
     2343           v-diasize-proc-name = entry(1, program-name(2), '.')
     2344         .
     2345         if v-diasize-wndstore = true
     2346         then do:
     2347           assign
     2348             v-restore-saved = false
     2349           .
     2350           if connected("ub") = true
     2351           then do:
     2352             run gbl/wndsizer.p
     2353               (input  v-cntxt-db-num
     2354               ,input  v-cntxt-userid
     2355               ,input  v-diasize-proc-name
     2356               ,input  'height':u
     2357               ,output v-resize-value-str
     2358               ) .
     2359             if v-resize-value-str <> '':U
     2360             then do:
     2361               run diasize_change-height in this-procedure
     2362                 (input  integer(v-resize-value-str)
     2363                 ,input  true
     2364                 ) .
     2365               assign
     2366                 v-restore-saved = true
     2367               .
     2368             end.
     2369           end.
     2370           if connected("ub") = true
     2371           then do:
     2372             run gbl/wndsizer.p
     2373               (input  v-cntxt-db-num
     2374               ,input  v-cntxt-userid
     2375               ,input  v-diasize-proc-name
     2376               ,input  'width':u
     2377               ,output v-resize-value-str
     2378               ) .
     2379             if v-resize-value-str <> '':U
     2380             then do:
     2381               run diasize_change-width in this-procedure
     2382                 (input  integer(v-resize-value-str)
     2383                 ,input  true
     2384                 ) .
     2385               assign
     2386                 v-restore-saved = true
     2387               .
     2388             end.
     2389           end.
     2390           if v-restore-saved <> true
     2391           then do:
     2392             if v-diasize-wndmax = true
     2393             then do:
     2394               run diasize_maximize in this-procedure
     2395                 (input  true
     2396                 ) .
     2397             end.
     2398           end.
     2399         end.
     2400         else do:
     2401           if v-diasize-wndmax = true
     2402           then do:
     2403             run diasize_maximize in this-procedure
     2404               (input  true
     2405               ) .
     2406           end.
     2407         end.
     2408       end.
     2409     end.
     2410   end procedure.
     2411   procedure diasize_need-full-display :
     2412     define output parameter p-need-full-display as logical   no-undo .
     2413     do
     2414     on error undo, return error return-value
     2415     :
     2416       assign
     2417         p-need-full-display = v-diasize-need-full-display
     2418       .
     2419       assign
     2420         v-diasize-need-full-display = false
     2421       .
     2422     end.
     2423   end procedure.
     2424   procedure get-context :
     2425      define output parameter p-db-num as integer          no-undo.
     2426      define output parameter p-user-id as character        no-undo.
     2427      define variable v-login               as character    no-undo.
     2428      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2429      define buffer buf_user-login  for ub.user-login .
     2430      do
     2431      on error undo, return error
     2432      :
     2433            FIND FIRST buf_sys-ctrl no-lock.
     2434            ASSIGN
     2435               v-login = USERID("ub")
     2436               p-db-num = buf_sys-ctrl.db-num
     2437            .
     2438            FIND FIRST buf_user-login
     2439                 WHERE buf_user-login.db-num = p-db-num
     2440                   AND buf_user-login.user-login = v-login
     2441                 no-lock
     2442                 no-error
     2443                 .
     2444            IF AVAILABLE buf_user-login
     2445            THEN DO:
     2446               assign
     2447                  p-user-id = buf_user-login.user-id
     2448               .
     2449            END.
     2450      end.
     2451   end procedure.
     2452       run diasize_init in this-procedure .
     2453   on window-close of frame f-c-p
     2454     apply "END-ERROR":U to self.
     2455   MAIN-BLOCK:
     2456   do on error   undo MAIN-BLOCK, leave MAIN-BLOCK
     2457     on end-key undo MAIN-BLOCK, leave MAIN-BLOCK:
     2458     if imode eq 'ВЫБОР':U
     2459     then
     2460        run rid-rest no-error.
     2461   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2462     run mainmenu_getcntxt in parparentproc
     2463       (output v-cntxt-db-num
     2464       ,output v-cntxt-userid
     2465       ,output v-cntxt-level
     2466       ,output v-cntxt-host-code-obj
     2467       ,output v-cntxt-obj-type
     2468       ,output v-cntxt-obj-code
     2469       ,output v-cntxt-db-num-obj
     2470       ,output v-cntxt-is-admin
     2471       ) .
     2472   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2473   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
     2474     (output v-db-num
     2475     )  .
     2476     run enable_UI in this-procedure .
     2477     wait-for go of frame f-c-p focus BROWSE-Code.
     2478     if imode eq 'ВЫБОР':U
     2479     then
     2480        run rid-keep no-error.
     2481   end.
     2482   run disable_UI in this-procedure .
     2483   PROCEDURE disable_UI :
     2484     HIDE FRAME f-c-p.
     2485   END PROCEDURE.
     2486   PROCEDURE enable_UI :
     2487     enable
     2488       msearch
     2489       BROWSE-Code
     2490       b-exit
     2491       b-chiled
     2492       b-sel
     2493       when imode eq 'ВЫБОР':U
     2494       b-add
     2495       when imode eq 'ИЗМЕНЕНИЕ':U
     2496       b-del
     2497       when imode eq 'ИЗМЕНЕНИЕ':U
     2498       b-upd
     2499       when imode eq 'ИЗМЕНЕНИЕ':U
     2500       b-help
     2501       b-look
     2502       b-hist
     2503       with frame f-c-p.
     2504      b-hist:POPUP-MENU in frame f-c-p = menu POPUP-MENU-b-hist:HANDLE.
     2505      b-hist:MENU-MOUSE = 1.
     2506     fselect                :visible in browse BROWSE-Code = imode eq 'ВЫБОР':U.
     2507     OPEN QUERY BROWSE-Code FOR EACH code       where code.parent = mParent NO-LOCK INDEXED-REPOSITION.
     2508   end procedure.
     2509   PROCEDURE NextLevel:
     2510      if available  code
     2511      then do:
     2512         if code.procview ne ""
     2513         then do:
     2514            if imode eq 'ВЫБОР':U
     2515            then
     2516               run rid-keep no-error.
     2517            run value( code.procview) (  input parparentproc
     2518                                       , input imode
     2519                                       , input Code.parent
     2520                                       , input Code.code
     2521                                       , input Code.CodeName)no-error.
     2522            if error-status:error
     2523            then
     2524               message "Ошибка при выполнение процедуры " code.procview skip
     2525                       error-status:get-message (1) skip
     2526                       return-value
     2527               view-as alert-box.
     2528            if imode eq 'ВЫБОР':U
     2529            then
     2530               run rid-rest no-error.
     2531         end.
     2532         else do:
     2533            if not endLevel ()
     2534            then
     2535               assign
     2536                  mparent  = code.parent + chr(4) + code.code
     2537                  mparent  = left-trim(mparent,chr(4))
     2538               .
     2539            OPEN QUERY BROWSE-Code FOR EACH code       where code.parent = mParent NO-LOCK INDEXED-REPOSITION.
     2540         end.
     2541      end.
     2542   end.
     2543   PROCEDURE PrevLevel:
     2544      define output parameter oView as logical no-undo.
     2545      if mparent ne ""
     2546      then do:
     2547         assign
     2548            entry(num-entries(mparent,chr(4)),mparent,chr(4)) = ""
     2549            mparent = substring (mparent,1,length(mParent) - 1)
     2550         no-error.
     2551         if mparent ne "" and num-entries(mparent,chr(4)) le  startlevel
     2552         then do:
     2553            if imode eq 'ВЫБОР':U
     2554            then do:
     2555               for each tmprecid:
     2556                  delete tmprecid.
     2557               end.
     2558               run gbl/rid-keep.p (input table tmprecid) no-error.
     2559            end.
     2560            oView = no.
     2561            return.
     2562         end.
     2563         else do:
     2564               OPEN QUERY BROWSE-Code FOR EACH code       where code.parent = mParent NO-LOCK INDEXED-REPOSITION.
     2565               oView = yes.
     2566               return.
     2567            end.
     2568         end.
     2569      end.
