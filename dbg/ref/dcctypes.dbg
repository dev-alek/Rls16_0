     4487   PROCEDURE proc-b-sch :
     4488   assign
     4489     tbl = 'c-dis-card-type'
     4490     join-tbl = 'X_c-dis-card-type'
     4491     fld = ""
     4492     lab = ""
     4493     spr = ""
     4494     dim = '0'
     4495     .
     4496   run fltfield-add in this-procedure('type', 'Тип ДК', '',
     4497   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4498   run fltfield-add in this-procedure('emitent-host-code', 'Эмитент', '',
     4499   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4500   run fltfield-add in this-procedure('obj-type*obj-code', 'Объект', '',
     4501   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4502   run fltfield-add in this-procedure('corr-date', '', '',
     4503   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4504   run fltfield-add in this-procedure('corr-time', 'Время корр.', 'time',
     4505   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4506   run fltfield-add in this-procedure('corr-user-db-num', '', '',
     4507   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4508   run fltfield-add in this-procedure('corr-user-name', 'Изменил', 'usr',
     4509   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4510   run fltfield-add in this-procedure('subject', 'Предмет изменения', 'dc-type-hist-subject',
     4511   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4512   run fltfield-add in this-procedure('action', 'Действие', 'hist-action',
     4513   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4514   Filter-Block:
     4515   DO ON STOP    UNDO Filter-Block, LEAVE Filter-Block
     4516       ON ERROR   UNDO Filter-Block, LEAVE Filter-Block
     4517       ON END-KEY UNDO Filter-Block, LEAVE Filter-Block :
     4518     run gbl/filter.w ( INPUT parparentproc
     4519                       ,INPUT (filter-point + chr(4) +
     4520                                 filter-label0 + chr(4) +
     4521                                 string(yes))
     4522                       ,INPUT tbl
     4523                       ,INPUT join-tbl
     4524                       ,INPUT fld
     4525                       ,INPUT lab
     4526                       ,INPUT spr
     4527                       ,INPUT dim ).
     4528     run OpenBr in this-procedure ( input yes, input no, input '':U, input v-corr-user-db-num).
     4529   END.
     4530   END PROCEDURE.
     4531   PROCEDURE proc-view-changes :
     4532   define variable v-description as character no-undo .
     4533   for each temp-changes:
     4534       delete temp-changes.
     4535   END.
     4536   if not available X_c-dis-card-type then do:
     4537     Open QUery br-changes for each temp-changes.
     4538     return.
     4539   end.
     4540   run ref/cdcthisv.p (
     4541                      input X_c-dis-card-type.emitent-host-code
     4542                     ,input X_c-dis-card-type.type
     4543                     ,input X_c-dis-card-type.chip-num
     4544                     ,input X_c-dis-card-type.corr-user-db-num
     4545                     ,input X_c-dis-card-type.obj-type
     4546                     ,input X_c-dis-card-type.obj-code
     4547                     ,input X_c-dis-card-type.host-code
     4548                     ,input X_c-dis-card-type.subject
     4549                     ,input X_c-dis-card-type.action
     4550                     ,input no
     4551                     ,output v-description
     4552                  ) no-error .
     4553   Open QUery br-changes for each temp-changes.
     4554   assign
     4555   br-changes:title in frame Dialog-Frame = v-description
     4556   .
     4557   END PROCEDURE.
     4558   FUNCTION get-action RETURNS CHARACTER
     4559     ( p-action as integer ) :
     4560     define variable dops as character no-undo.
     4561   assign dops = entry (lookup (trim(string(p-action)), '99,1,2,3,4,9,51,79':U), 'Удаление,Создание,Изменение,Коррекция,Восстановление,Смена_кода,Смена_артик,Выключ.':U) no-error.
     4562   RETURN dops.
     4563   END FUNCTION.
     4564   FUNCTION get-emitent RETURNS CHARACTER
     4565     ( input par-emitent-host-code  as integer) :
     4566   if par-emitent-host-code = 0 then return "Глобальная".
     4567   find first ub.clients no-lock where
     4568               ub.clients.obj-type = 'орг':U and
     4569               ub.clients.obj-code = par-emitent-host-code no-error.
     4570   if not avail ub.clients then return "?".
     4571   else return ub.clients.obj-name.
     4572   END FUNCTION.
     4573   FUNCTION get-mark RETURNS CHARACTER
     4574     ( par-rid as recid, pardc-type-rid as character  ) :
     4575   if lookup(string(par-rid), pardc-type-rid) > 0 then return "*":U.
     4576     RETURN "".
     4577   END FUNCTION.
