      957     define variable v-cntxt-db-num-obj    as integer   no-undo .
      958     define variable v-cntxt-is-admin      as logical   no-undo .
      959   define variable filter-point as character no-undo init "dcctypes" .
      960   define variable filter-point0 as character no-undo init "dcctypes" .
      961   define variable filter-label0 as character no-undo init "Список полной истории типа ДК" .
      962   define variable filter-label as character no-undo init "Список полной истории типа ДК" .
