        1   DEFINE BUFFER X_c-dis-card-type FOR ub.c-dis-card-type.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   DEFINE INPUT PARAMETER BTTNS AS CHAR NO-UNDO.
        4   DEFINE INPUT PARAMETER rid# As recid NO-UNDO.
        5   DEFINE INPUT PARAMETER p-emitent-host-code like ub.sysconf.host-code no-undo.
        6   DEFINE INPUT PARAMETER p-host-code like ub.sysconf.host-code no-undo.
        7   DEFINE INPUT PARAMETER p-obj-type like ub.clients.obj-type no-undo.
        8   DEFINE INPUT PARAMETER p-obj-code like ub.clients.obj-code no-undo.
        9   define input parameter p-type like ub.c-dis-card-type.type no-undo .
       10   define input parameter p-mode as character no-undo .
       11   define input parameter p-subject as character no-undo .
       12   DEFINE OUTPUT PARAMETER p-rid-list As char NO-UNDO.
       13   define variable vss-revision    as character no-undo init "$Revision$":u .
       14   define variable vss-author      as character no-undo init "$Author$":u .
       15   define variable vss-date        as character no-undo init "$Date$":u .
       16   define variable vss-workfile    as character no-undo init "$Workfile$":u .
       17   define variable vss-archive     as character no-undo init "$Archive$":u .
       18   define variable vss-description as character no-undo init "Справочник истории типов дисконтных карт " .
       19   procedure vss-get-info :
       20     define output parameter p-vss-revision    like vss-revision    no-undo .
       21     define output parameter p-vss-author      like vss-author      no-undo .
       22     define output parameter p-vss-date        like vss-date        no-undo .
       23     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       24     define output parameter p-vss-archive     like vss-archive     no-undo .
       25     define output parameter p-vss-description like vss-description no-undo .
       26     assign
       27       p-vss-revision    = vss-revision
       28       p-vss-author      = vss-author
       29       p-vss-date        = vss-date
       30       p-vss-workfile    = vss-workfile
       31       p-vss-archive     = vss-archive
       32       p-vss-description = vss-description
       33     .
       34   end procedure.
       35   procedure vss-get-parameters :
       36     define output parameter p-vss-parameters as character no-undo .
       37   end procedure.
       38   define new global shared variable g#vssrevis-logger as handle    no-undo .
       39   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       40   define variable v-vssrevis-logger                   as handle    no-undo .
       41   procedure vss-logevent :
       42     define input  parameter p-extra-paramters as character no-undo .
       43     define variable v-vssrevis-parameters as character no-undo .
       44     do
       45     on error undo, return error return-value
       46     :
       47       if  valid-handle(v-vssrevis-logger)
       48       and v-vssrevis-logger :get-signature("logevent") <> ""
       49       then do:
       50         run vss-get-parameters in this-procedure
       51           (output v-vssrevis-parameters
       52           ).
       53         run logevent in v-vssrevis-logger
       54           (input vss-workfile
       55           ,input vss-revision
       56           ,input v-vssrevis-parameters
       57           ,input p-extra-paramters
       58           ).
       59       end.
       60     end.
       61   end procedure.
       62   assign
       63     v-vssrevis-logger = g#vssrevis-logger
       64   .
       65   if  valid-handle(v-vssrevis-logger)
       66   and v-vssrevis-logger :get-signature("logevent") <> ""
       67   then do:
       68     assign
       69       v-vssrevis-logevent = true
       70     .
       71     run vss-logevent in this-procedure (input vss-description) .
       72   end.
       73   define new global shared variable g#language as character no-undo .
       74   if g#language <> '' and g#language <> 'rus':U then do:
       75     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       76   end.
       77   define new global shared variable g#library  as handle no-undo .
       78   define new global shared variable g#library2 as handle no-undo .
       79   procedure proc-alt-shift-f2:
       80     if not ibs.th.gbl.gbl-var:rcode
       81   then
       82     run gbl\inidebug.p .
       83   end.
       84   procedure proc-alt-shift-f3:
       85     run gbl/prvssinf.p
       86       ( input this-procedure
       87       ) .
       88   end.
       89   define variable v-inform-launched as logical no-undo initial false .
       90   procedure proc-alt-shift-f4:
       91     define variable v-action as character no-undo .
       92     if v-inform-launched = false then do:
       93       assign
       94         v-inform-launched = true
       95       .
       96       run gbl/d-inform.w
       97         (  input self
       98         ,  input this-procedure
       99         , output v-action
      100         ) no-error .
      101       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      102       assign
      103         v-inform-launched = false
      104       .
      105     end.
      106   end.
      107   procedure proc-alt-f1:
      108     run gbl/corrhelp.p
      109       (input this-procedure
      110       ) .
      111   end .
      112   on alt-shift-f2 anywhere do:
      113     run proc-alt-shift-f2.
      114   end.
      115   on alt-shift-f3 anywhere do:
      116     run proc-alt-shift-f3 in this-procedure .
      117   end.
      118   on alt-shift-f4 anywhere do:
      119     run proc-alt-shift-f4 in this-procedure.
      120   end.
      121   on alt-f1 anywhere do:
      122     run proc-alt-f1 in this-procedure .
      123   end.
      124   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      125   define variable c-point  as character no-undo .
      126   define variable tbl      as character no-undo .
      127   define variable join-tbl as character no-undo .
      128   define variable fld      as character no-undo .
      129   define variable lab      as character no-undo .
      130   define variable spr      as character no-undo .
      131   define variable dim      as character no-undo .
      132   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      133   procedure fltfield-clear :
      134     define output parameter loc-fld as character no-undo.
      135     define output parameter loc-lab as character no-undo .
      136     define output parameter loc-spr as character no-undo .
      137     define output parameter loc-dim as character no-undo .
      138     assign
      139       loc-fld = ""
      140       loc-lab = ""
      141       loc-spr = ""
      142       loc-dim = "0"
      143     .
      144   end procedure .
      145   procedure fltfield-add :
      146     define input        parameter par-fld as character no-undo.
      147     define input        parameter par-lab as character no-undo .
      148     define input        parameter par-spr as character no-undo .
      149     define input-output parameter loc-fld as character no-undo.
      150     define input-output parameter loc-lab as character no-undo .
      151     define input-output parameter loc-spr as character no-undo .
      152     define input-output parameter loc-dim as character no-undo .
      153     do
      154     on error undo, return error
      155     :
      156       assign
      157       loc-fld = if loc-dim = '0'
      158                 then par-fld
      159                 else (loc-fld + chr(44) + par-fld)
      160       loc-lab = if loc-dim = '0'
      161                 then par-lab
      162                 else (loc-lab + chr(44) + par-lab)
      163       loc-spr = if loc-dim = '0'
      164                 then par-spr
      165                 else (loc-spr + chr(44) + par-spr)
      166       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
      167                 string(integer(if num-entries(loc-dim) > 1
      168                               then entry(2, loc-dim)
      169                               else entry(1, loc-dim)
      170                               ) + 1)
      171       no-error
      172       .
      173     end.
      174   end procedure.
      175   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      176   function usrfulnf returns character ( input p-user-id as character):
      177   define variable v-user-name as character no-undo .
      178   define variable vss-include-info3 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      179   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run usrfulnm in g#library
      180     (input  p-user-id
      181     ,output v-user-name
      182     ) no-error .
      183   if error-status:error
      184   or v-user-name = ""
      185   then do:
      186     return p-user-id.
      187   end.
      188   else do:
      189     return v-user-name.
      190   end.
      191   end function.
      192   define variable ri as recid no-undo.
      193   define variable v-doc-rec as recid no-undo.
      194   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      195   FUNCTION mark-string RETURNS CHARACTER
      196     ( input p-recid as recid, input mark-list as character  ) :
      197     RETURN ( IF LOOKUP( STRING( p-recid), mark-list ) > 0 THEN '*' ELSE '':U ).
      198   END FUNCTION.
      199   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      200   define NEW SHARED temp-table temp-changes no-undo
      201   field f_name as character
      202   field l_name as character
      203   field v_old as character
      204   field v_new as character
      205   field t_name as character
      206   field num_ as integer
      207   field uniq-key-rec as character
      208   field action as integer
      209   field fNotChange as logical
      210   index pi is unique primary
      211   num_
      212   t_name
      213   f_name
      214   index
      215   Chan
      216   fnotChange
      217   t_name
      218   f_name
      219   index imain uniq-key-rec
      220   .
      221   FUNCTION get-all-fields returns character (p-file-name as character ):
      222   define variable v-dop as character no-undo .
      223     find first _file no-lock where _file._file-name = p-file-name no-error .
      224     if not available _file then return "":U.
      225     for each _field no-lock where
      226              _field._file-recid = recid(_file) :
      227       assign
      228       v-dop = v-dop + _field._field-name + chr(44)
      229       .
      230     end.
      231     return trim(v-dop).
      232   END FUNCTION.
      233   PROCEDURE proc-full-temp-changes :
      234     define input  parameter p-hst-handle as handle    no-undo .
      235     define input  parameter p-main-table as character no-undo .
      236     define input  parameter p-field-list as character no-undo .
      237     define input  parameter p-label-form as character no-undo .
      238     define variable h-new-buf         as handle    no-undo .
      239     define variable h-main-buf        as handle    no-undo .
      240     define variable h-for-comp        as handle    no-undo .
      241     define variable v-inform          as character no-undo .
      242     define variable v-ind             as integer   no-undo .
      243     define variable v-idx-field-qnty  as integer   no-undo .
      244     define variable v-num-entries     as integer   no-undo .
      245     define variable fh                as handle    no-undo .
      246     define variable fh-main           as handle    no-undo .
      247     define variable fh-old            as handle    no-undo .
      248     define variable fh-new            as handle    no-undo .
      249     define variable v-field-name      as character no-undo .
      250     define variable v-field-lvl       as character no-undo .
      251     define variable v-field-form      as character no-undo .
      252     define variable v-search-exp      as character no-undo .
      253     define variable v-srch-main       as character no-undo .
      254     define variable v-word-link       as character no-undo .
      255     define variable v-av-chip-num     as logical   no-undo .
      256     define variable v-main-pi-fld-lst as character no-undo .
      257     define variable v-main-fld-lst    as character no-undo .
      258     define variable v-delim-list      as character no-undo .
      259     define variable v-label           as character no-undo .
      260     define variable v-old-value       as character no-undo case-sensitive.
      261     define variable v-new-value       as character no-undo case-sensitive.
      262     define variable v-chg-fields as character no-undo.
      263     for each temp-changes:
      264       delete temp-changes.
      265     end.
      266     if not p-hst-handle:available then do:
      267       return .
      268     end.
      269     create buffer h-new-buf  for table p-hst-handle .
      270     create buffer h-main-buf for table p-main-table .
      271     assign
      272       v-inform = h-main-buf:index-information(1)
      273       v-ind    = 2
      274     .
      275     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      276     on error undo, return error
      277     :
      278       assign
      279         v-inform = h-main-buf:index-information( v-ind )
      280         v-ind    = v-ind + 1
      281       .
      282     end.
      283     if v-inform = ?
      284       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      285       or entry( 3, v-inform, ",":U ) <> "1":U
      286     then do:
      287       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, h-main-buf:name ).
      288     end.
      289     assign
      290       v-idx-field-qnty = num-entries( v-inform ) - 4
      291     .
      292     if v-idx-field-qnty < 2 then do:
      293       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, h-main-buf:name ).
      294     end.
      295     assign
      296       v-srch-main   = "where":U
      297       v-word-link   = "":U
      298       v-av-chip-num = false
      299       v-delim-list  = "":U
      300     .
      301     do v-ind = 1 to v-idx-field-qnty by 2
      302     on error undo, return error
      303     :
      304       assign
      305         v-field-name      = entry( 4 + v-ind, v-inform, ",":U )
      306         fh                = p-hst-handle:buffer-field( v-field-name )
      307         fh-main           = h-main-buf:buffer-field( v-field-name )
      308         v-srch-main       = substitute( "&1 &2 &3.&4 =", v-srch-main, v-word-link, fh-main:table, v-field-name )
      309         v-main-pi-fld-lst = v-main-pi-fld-lst + v-delim-list + v-field-name
      310       .
      311       if fh:data-type ="character":U then do:
      312         assign
      313           v-srch-main = substitute( '&1 "&2"', v-srch-main, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
      314         .
      315       end.
      316       else do:
      317         assign
      318           v-srch-main = substitute( "&1 &2", v-srch-main, fh:buffer-value() )
      319         .
      320       end.
      321       if v-delim-list = "":U then do:
      322         assign
      323           v-delim-list = ",":U
      324         .
      325       end.
      326       if v-word-link = "":U then do:
      327         assign
      328           v-word-link = "and":U
      329         .
      330       end.
      331     end.
      332     assign
      333       v-delim-list  = "":U
      334     .
      335     do v-ind = 1 to h-main-buf:num-fields
      336     on error undo, return error
      337     :
      338       assign
      339         fh-main      = h-main-buf:buffer-field( v-ind )
      340         v-field-name = fh-main:name
      341       .
      342         assign
      343           v-main-fld-lst = v-main-fld-lst + v-delim-list + v-field-name
      344         .
      345         if v-delim-list = "":U then do:
      346           assign
      347             v-delim-list = ",":U
      348           .
      349         end.
      350     end.
      351     assign
      352       v-inform = p-hst-handle:index-information(1)
      353       v-ind    = 2
      354     .
      355     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      356     on error undo, return error
      357     :
      358       assign
      359         v-inform = p-hst-handle:index-information( v-ind )
      360         v-ind    = v-ind + 1
      361       .
      362     end.
      363     if v-inform = ?
      364       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      365       or entry( 3, v-inform, ",":U ) <> "1":U
      366     then do:
      367       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, p-hst-handle:name ).
      368     end.
      369     assign
      370       v-idx-field-qnty = num-entries( v-inform ) - 4
      371     .
      372     if v-idx-field-qnty < 2 then do:
      373       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, p-hst-handle:name ).
      374     end.
      375     assign
      376       v-search-exp  = "where":U
      377       v-word-link   = "":U
      378       v-av-chip-num = false
      379     .
      380     do v-ind = 1 to v-idx-field-qnty by 2
      381     on error undo, return error
      382     :
      383       assign
      384         v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      385         fh           = p-hst-handle:buffer-field( v-field-name )
      386         v-search-exp = substitute( "&1 &2 &3.&4", v-search-exp, v-word-link, fh:table, v-field-name )
      387       .
      388       if v-field-name = "chip-num":U then do:
      389         assign
      390           v-search-exp  = substitute( "&1 >", v-search-exp )
      391           v-av-chip-num = true
      392         .
      393       end.
      394       else do:
      395         assign
      396           v-search-exp = substitute( "&1 =", v-search-exp )
      397         .
      398       end.
      399       if fh:data-type ="character":U then do:
      400         assign
      401           v-search-exp = substitute( '&1 "&2"', v-search-exp, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
      402         .
      403       end.
      404       else do:
      405         assign
      406           v-search-exp = substitute( '&1 &2', v-search-exp, fh:buffer-value() )
      407         .
      408       end.
      409       if v-word-link = "":U then do:
      410         assign
      411           v-word-link = "and":U
      412         .
      413       end.
      414     end.
      415     if v-av-chip-num = false then do:
      416       message
      417         vss-workfile vss-revision vss-description skip
      418         substitute( "Таблица &2 не содержит поля chip-num.", vss-workfile, p-hst-handle:name ) skip
      419         "Использование данной процедуры невозможно!" skip
      420         view-as alert-box error .
      421       return error .
      422     end.
      423     h-new-buf:find-first( v-search-exp, no-lock ) no-error .
      424     if not h-new-buf:available then do:
      425       h-main-buf:find-first( v-srch-main, no-lock ) no-error .
      426       if not h-main-buf:available then do:
      427         assign
      428           h-for-comp = ?
      429         .
      430       end.
      431       else do:
      432         assign
      433           h-for-comp = h-main-buf
      434         .
      435       end.
      436     end.
      437     else do:
      438       assign
      439         h-for-comp = h-new-buf
      440       .
      441     end.
      442     assign
      443       v-num-entries = num-entries( v-main-fld-lst, ",":U )
      444     .
      445     do v-ind = 1 to v-num-entries
      446     on error undo, return error return-value
      447     :
      448       assign
      449         v-field-name = entry( v-ind, v-main-fld-lst )
      450         fh-old       = p-hst-handle:buffer-field( v-field-name )
      451         v-old-value  = fh-old:buffer-value()
      452         v-label      = trim( fh-old:label )
      453       .
      454       if ( trim( p-field-list ) <> "":U
      455            and lookup( v-field-name, p-field-list ) > 0
      456          )
      457          or trim( p-field-list ) = "":U
      458       then do:
      459         if h-for-comp <> ? then do:
      460           assign
      461             fh-new      = h-for-comp:buffer-field( v-field-name )
      462             v-new-value = fh-new:buffer-value()
      463           .
      464         end.
      465         else do:
      466           assign
      467             v-new-value = "":U
      468           .
      469         end.
      470         if v-old-value <> v-new-value
      471         then do:
      472           create temp-changes.
      473           assign
      474             temp-changes.t_name = p-main-table
      475             temp-changes.f_name = v-field-name
      476             temp-changes.l_name = replace( v-label, "&":U, "":U )
      477             temp-changes.v_old  = trim( v-old-value )
      478             temp-changes.v_new  = trim( v-new-value )
      479             temp-changes.num_   = 0
      480             temp-changes.fNotChange = v-old-value eq v-new-value
      481           .
      482         end.
      483       end.
      484     end.
      485     assign
      486       v-num-entries = num-entries( p-label-form, chr(8) )
      487     .
      488     do v-ind = 1 to v-num-entries
      489     on error undo, return error return-value
      490     :
      491       if num-entries( entry( v-ind, p-label-form, chr(8) ), chr(4) ) = 3 then do:
      492         assign
      493           v-field-name = entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
      494           v-field-lvl  = entry( 2, entry( v-ind, p-label-form, chr(8) ), chr(4) )
      495           v-field-form = entry( 3, entry( v-ind, p-label-form, chr(8) ), chr(4) )
      496         .
      497         find first temp-changes
      498           where temp-changes.f_name = v-field-name
      499           no-error .
      500         if available temp-changes then do:
      501           if trim( v-field-lvl ) <> "":U then do:
      502             assign
      503               temp-changes.l_name = v-field-lvl
      504             .
      505           end.
      506           if trim( v-field-form ) <> "":U then do:
      507             assign
      508               temp-changes.v_old = dynamic-function( v-field-form, temp-changes.v_old )
      509             .
      510             if h-for-comp <> ? then do:
      511               assign
      512                 temp-changes.v_new = dynamic-function( v-field-form, temp-changes.v_new )
      513               .
      514             end.
      515           end.
      516         end.
      517       end.
      518       else do:
      519         message
      520           vss-workfile vss-revision vss-description skip
      521           "Ошибка! Список должен содержать три поля с разделителем delim-par!" skip
      522           substitute( "список для поля '&1': '&2'"
      523                       ,entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
      524                       ,entry( v-ind, p-label-form, chr(8) )
      525                     ) skip
      526           substitute( "полный список: &2", p-label-form ) skip
      527           view-as alert-box error .
      528       end.
      529     end.
      530     delete object h-new-buf .
      531     delete object h-main-buf .
      532   END PROCEDURE.
      533   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      534   define variable v-waitfram-action01         as character   no-undo .
      535   define variable v-waitfram-action02         as character   no-undo .
      536   define variable v-waitfram-action03         as character   no-undo .
      537   define variable mWaitFramTextBeg            as character   no-undo.
      538   define variable mWaitFramTextEnd            as character   no-undo.
      539   define variable mWaitFramView               as logical     no-undo.
      540   define variable mWaitProcEvent              as logical     no-undo init yes.
      541   define variable mWaitFramInterval           as integer     no-undo init 1 .
      542   define variable mWaitFramStop               as logical     no-undo.
      543   define variable mWaitFramStopUser           as logical     no-undo.
      544   define variable mWaitFramStopTimeOut        as logical     no-undo.
      545   define variable mWaitFramStartProc          as datetime-tz no-undo.
      546   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      547   define button B-WaitFramStop auto-end-key
      548        label "Стоп"
      549        size 10 by 1 tooltip "Остоновить процесс".
      550   define button B-viewProcInfo
      551        label "Информация"
      552        size 15 by 1 tooltip "Информация о процесс".
      553   define frame waitfram
      554     v-waitfram-action01 format "x(72)" no-label skip
      555     v-waitfram-action02 format "x(72)" no-label skip
      556     v-waitfram-action03 format "x(72)" no-label skip
      557     B-viewProcInfo
      558     B-WaitFramStop at row 4 col 30
      559     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      560     .
      561   define new global shared variable mBatchMode as logical no-undo init ?.
      562   define variable mFramBachModHandle as handle no-undo.
      563   mFramBachModHandle = frame waitfram:handle.
      564   define variable mFameOldVis as logical no-undo.
      565   define variable mVisCUrentVin as logical no-undo.
      566   if session:batch-mode
      567   then
      568      mBatchMode = yes.
      569   if mBatchMode = ? then do:
      570     mVisCUrentVin = current-window:visible.
      571     mFameOldVis = mFramBachModHandle:visible.
      572     mFramBachModHandle:visible  = yes.
      573     mBatchMode = mFramBachModHandle:visible ne yes.
      574     mFramBachModHandle:visible = mFameOldVis.
      575     current-window:visible = mVisCUrentVin.
      576   end.
      577    if  log-manager:logfile-name ne ?
      578     then DO:
      579         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      580         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      581         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      582     end.
      583   on choose of B-WaitFramStop in frame waitfram
      584   do:
      585     mWaitFramStop = yes.
      586     mWaitFramStopUser = yes.
      587   end.
      588   function waitfram-check-timeout returns logical():
      589      define variable vtime as int64 no-undo.
      590      if mWaitFramStopTimeOut
      591      then
      592         return yes.
      593      vtime = ( now - mWaitFramStartProc ) / 1000 .
      594      if     mWaitFramTimeOut ne ?
      595         and mWaitFramTimeOut ne 0
      596         and mWaitFramTimeOut lt vtime
      597      then do:
      598         mWaitFramStopTimeOut = yes.
      599      end.
      600      return mWaitFramStopTimeOut.
      601   end.
      602   procedure waitfram-hide :
      603     if not session:batch-mode
      604     then do
      605     on error undo, return error return-value
      606     :
      607       pause 0 before-hide .
      608       if not mBatchMode then
      609         hide frame waitfram .
      610     if     not mWaitFramView
      611        and mWaitProcEvent
      612     then
      613       process events .
      614     end.
      615   end procedure.
      616   procedure waitfram-show :
      617     define input  parameter p-message as character no-undo .
      618     define variable v-left-margin as integer   no-undo .
      619     if not session:batch-mode
      620     then do
      621     on error undo, return error return-value
      622     :
      623       if length(p-message) <= 70 then do:
      624         assign
      625           v-left-margin = integer((70 - length(p-message)) / 2)
      626         .
      627         assign
      628           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      629         .
      630         assign
      631           v-waitfram-action01 = " "
      632           v-waitfram-action02 = " "
      633                                    + fill(" ", v-left-margin)
      634                                    + p-message
      635           v-waitfram-action03 = " "
      636         .
      637       end.
      638       else do:
      639         define variable vRindex1 as integer no-undo.
      640         define variable vRindex2 as integer no-undo.
      641         vRindex1 = r-index(p-message," ",70).
      642         if vRindex1 = 0
      643         then
      644            vRindex1 = 70.
      645         if length(p-message)  <= vRindex1 + 70 then do:
      646           assign
      647             v-waitfram-action01 = " "
      648             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      649             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      650           .
      651         end.
      652         else do:
      653           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      654           if vRindex2 <= vRindex1
      655           then
      656              vRindex2 = vRindex1 + 70.
      657           assign
      658             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      659             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      660             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      661           .
      662         end.
      663       end.
      664       B-viewProcInfo:visible   in frame waitfram = no.
      665       B-viewProcInfo:sensitive in frame waitfram = no.
      666       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      667       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      668       if  (   mWaitFramView
      669          or  mWaitProcEvent)
      670          and not mBatchMode
      671       then
      672          display
      673             v-waitfram-action01 skip
      674             v-waitfram-action02 skip
      675             v-waitfram-action03 skip
      676          with frame waitfram .
      677       if     mWaitFramView
      678          then do:
      679             if     mWaitFramInterval ne ?
      680                and not mBatchMode
      681             then
      682                wait-for go of frame waitfram pause mWaitFramInterval.
      683          end.
      684          else
      685             if     mWaitProcEvent
      686                and not mBatchMode
      687             then
      688                process events .
      689     end.
      690   end procedure.
      691      procedure waitfram-show-this:
      692         define input  parameter iInterval as int64 no-undo.
      693         define variable vtime as int64 no-undo.
      694         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      695         mWaitFramInterval = iInterval.
      696         run waitfram-show (substitute("&1&2 &3&4" ,
      697                                       mWaitFramTextBeg ,
      698                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      699                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      700                                       mWaitFramTextEnd
      701                                      )
      702                           ).
      703      end.
      704      procedure WaitFramRunPause:
      705         define input  parameter iInterval as dec no-undo.
      706         define variable vStart  as datetime-tz no-undo.
      707         define variable vend    as datetime-tz no-undo.
      708         define variable vint as int64 no-undo.
      709         define variable vOk as logical no-undo.
      710         vStart = now.
      711         vend   = vStart.
      712         publish "WaitFramPause" (iInterval,output vOk).
      713         vend   =  now.
      714         vint = vend - vStart.
      715         vint = iInterval - vint / 1000.
      716         if     not mWaitFramStop
      717            and (   vint > 0
      718                 or (    not vOk
      719                     and iInterval eq ?
      720                     )
      721                 )
      722         then
      723            run waitfram-show-this (iInterval).
      724         vend   =  now.
      725         vint = vend - vStart.
      726         vint = iInterval - vint / 1000.
      727         if     not mWaitFramStop
      728            and vint > 0
      729         then do:
      730            run gbl/pause.p (vint * 1000).
      731         end.
      732         if iInterval ne ?
      733         then
      734            publish "WaitFramStop".
      735         waitfram-check-timeout().
      736      end.
      737      procedure WaitFramWaitFor:
      738         define input  parameter iInterval as dec no-undo.
      739         assign
      740            mWaitFramStartProc   = now
      741            mWaitFramStopUser    = no
      742            mWaitFramStopTimeOut = no
      743         .
      744         block-wait:
      745         do while not mWaitFramStop:
      746            run WaitFramRunPause (iInterval).
      747            if  waitfram-check-timeout()
      748            then do:
      749               leave block-wait.
      750            end.
      751         end.
      752         run waitfram-hide.
      753      end.
      754   procedure waitfram-join :
      755     define input  parameter p-line-1  as character no-undo .
      756     define input  parameter p-line-2  as character no-undo .
      757     define input  parameter p-line-3  as character no-undo .
      758     define output parameter p-message as character no-undo .
      759     do
      760     on error undo, return error return-value
      761     :
      762       assign
      763         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      764                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      765                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      766       .
      767     end.
      768   end procedure.
      769   function waitfram-join-function returns character
      770     (input p-line-1 as character
      771     ,input p-line-2 as character
      772     ,input p-line-3 as character
      773     ).
      774     define variable v-message as character no-undo .
      775     run waitfram-join in this-procedure
      776       (input  p-line-1
      777       ,input  p-line-2
      778       ,input  p-line-3
      779       ,output v-message
      780       ) .
      781     return v-message .
      782   end function .
      783   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      784   define variable v-fltopend-rowid as rowid extent 18 no-undo .
      785   procedure fltopend_fltopend :
      786   define input parameter p-parent-handle as handle no-undo .
      787   define input parameter p-qh as handle no-undo .
      788   define input parameter p-flt-open-open-query  as character no-undo .
      789   define input parameter p-where-cond as character no-undo .
      790   define input parameter p-use-indFIRST-query-tail as character no-undo .
      791   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      792   define input parameter p-indexed-reposition as character no-undo .
      793     do
      794     on error undo, return error
      795     :
      796   define variable v-prepare-string as character no-undo .
      797   define variable glog as logical no-undo .
      798   assign
      799   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      800                      p-where-cond + chr(32)  +
      801                      p-use-indFIRST-query-tail + chr(32) +
      802                      p-use-ind-sort-clmn-by + chr(32) +
      803                      p-indexed-reposition
      804   .
      805   assign
      806   glog = p-qh:query-prepare(v-prepare-string) no-error .
      807   if not glog
      808   or error-status:error then do:
      809     message error-status:get-message(1) view-as alert-box .
      810     undo, return error .
      811   end.
      812   assign
      813   glog = p-qh:query-open no-error .
      814   if not glog
      815   or error-status:error then do:
      816     message error-status:get-message(1) view-as alert-box .
      817     undo, return error .
      818   end.
      819     end.
      820   end procedure.
      821   procedure fltopend_fltfindd :
      822   define input parameter p-parent-handle as handle no-undo .
      823   define input parameter p-qh as handle no-undo .
      824   define input parameter p-rowid as rowid no-undo .
      825   define input parameter p-next as logical no-undo .
      826   define input parameter p-lock as integer no-undo .
      827   define input parameter p-bh as handle no-undo .
      828   define input parameter p-where-cond as character no-undo .
      829   define input parameter p-use-index-phrase as character no-undo .
      830   define variable glog as logical no-undo .
      831   define variable v-qh as handle no-undo .
      832   define variable v-bh as handle no-undo .
      833   define variable v-recid as recid no-undo .
      834   define variable v-prepare-string as character no-undo .
      835   do
      836   on error undo, return error
      837   on stop undo, return error
      838   :
      839     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
      840     create buffer v-bh for table p-bh buffer-name p-bh:name.
      841     create query v-qh.
      842     v-qh:set-buffers(v-bh).
      843     v-prepare-string = substitute("for each &1 &2 &3"
      844                                     ,v-bh:name
      845                                     ,p-where-cond
      846                                     ,p-use-index-phrase).
      847     glog = v-qh:query-prepare(v-prepare-string) no-error.
      848     if not glog then do:
      849       delete object v-qh.
      850       delete object v-bh.
      851       undo, return error .
      852     end.
      853     glog = v-qh:query-open no-error .
      854     if not glog then do:
      855       delete object v-qh.
      856       delete object v-bh.
      857       undo, return error .
      858     end.
      859     if p-next then do:
      860       v-qh:reposition-to-rowid(p-rowid) no-error .
      861       glog = v-qh:get-next( p-lock) no-error .
      862       glog = v-qh:get-next( p-lock) no-error .
      863       if not glog or v-qh:query-off-end = yes then do:
      864         glog = v-qh:get-first( p-lock) no-error .
      865       end.
      866     end.
      867     else do:
      868       glog = v-qh:get-first( p-lock) no-error .
      869     end.
      870     v-recid = v-bh:recid no-error .
      871     delete object v-qh.
      872     delete object v-bh.
      873     return string(v-recid) .
      874   end.
      875   end procedure.
      876   procedure fltopend_fltfindq :
      877   define input parameter p-parent-handle as handle no-undo .
      878   define input parameter p-qh as handle no-undo .
      879   define input parameter p-next as logical no-undo .
      880   define input parameter p-lock as integer no-undo .
      881   define input parameter p-flt-open-open-query  as character no-undo .
      882   define input parameter p-where-cond as character no-undo .
      883   define input parameter p-use-indFIRST-query-tail as character no-undo .
      884   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      885   define input parameter p-indexed-reposition as character no-undo .
      886   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
      887   define variable glog as logical no-undo .
      888   define variable v-qh as handle no-undo .
      889   define variable v-bh as handle no-undo extent 18.
      890   define variable v-rowid as rowid no-undo extent 18.
      891   define variable v-ii as integer no-undo .
      892   define variable v-prepare-string as character no-undo .
      893   do
      894   on error undo, return error
      895   on stop undo, return error
      896   :
      897     create query v-qh.
      898     do v-ii = 1 to p-qh:num-buffers:
      899       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
      900       assign
      901       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
      902       no-error.
      903       v-qh:add-buffer(v-bh[v-ii]).
      904     end.
      905     assign
      906     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      907                       p-where-cond + chr(32)  +
      908                       p-use-indFIRST-query-tail + chr(32) +
      909                       p-use-ind-sort-clmn-by + chr(32) +
      910                       p-indexed-reposition
      911     .
      912     glog = v-qh:query-prepare( v-prepare-string) no-error .
      913     if not glog then do:
      914       delete object v-qh.
      915       do v-ii = 1 to p-qh:num-buffers:
      916         delete object v-bh[v-ii].
      917       end.
      918       undo, return error .
      919     end.
      920     glog = v-qh:query-open no-error .
      921     if not glog then do:
      922       delete object v-qh.
      923       do v-ii = 1 to p-qh:num-buffers:
      924         delete object v-bh[v-ii].
      925       end.
      926       undo, return error .
      927     end.
      928     if p-next then do:
      929       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
      930       glog = v-qh:get-next( p-lock) no-error .
      931       glog = v-qh:get-next( p-lock) no-error .
      932       if not glog or v-qh:query-off-end = yes then do:
      933         glog = v-qh:get-first( p-lock) no-error .
      934       end.
      935     end.
      936     else do:
      937       glog = v-qh:get-first( p-lock) no-error .
      938     end.
      939     do v-ii = 1 to p-qh:num-buffers:
      940       assign
      941       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
      942       no-error.
      943     end.
      944     delete object v-qh.
      945     do v-ii = 1 to p-qh:num-buffers:
      946       delete object v-bh[v-ii].
      947     end.
      948   end.
      949   end procedure.
      950   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      951     define variable v-cntxt-db-num        as integer   no-undo .
