     1008         mark-string(recid(X_c-dis-card-type), v-rid-list) COLUMN-LABEL "*" FORMAT "X(1)":U
     1009   X_c-dis-card-type.type COLUMN-LABEL "Тип" FORMAT "X(8)":U
     1010   X_c-dis-card-type.emitent-host-code COLUMN-LABEL "Код!эмитента" FORMAT ">>>>>99999":U
     1011   X_c-dis-card-type.corr-user-db-num COLUMN-LABEL "БД" FORMAT ">>>>9":U
     1012   X_c-dis-card-type.corr-date COLUMN-LABEL "Дата корр" FORMAT "99/99/9999":U
     1013   get-emitent(X_c-dis-card-type.emitent-host-code) COLUMN-LABEL "Эмитент" FORMAT "X(15)":U
     1014   usrfulnf(X_c-dis-card-type.corr-user-name) COLUMN-LABEL "Изменил" FORMAT "X(18)":U
     1015   get-action(X_c-dis-card-type.action) COLUMN-LABEL "Действие" FORMAT "X(10)":U
     1016   entry (lookup (X_c-dis-card-type.subject, 'dis-card-type,dis-card-type-attr,dis-card-mask,rp-by-call,rule-by-call,rule-call-param,dis-dct-rule,hist-nws-option':U), 'Тип диск.карты,Аттр.типа диск.карты,Маска диск.карты,Привязка профайла к месту,Вызов правила,Параметры вызова правил,Скидки на типы ДК,Опции созд. ист. и маршрут.':U) COLUMN-LABEL "Предмет изменений" FORMAT "X(35)":U
     1017   string(if X_c-dis-card-type.host-code = 0
     1018   then "Глобально"
     1019   else (if X_c-dis-card-type.obj-code = 0
     1020   then ("Фирма" + chr(32) +                          string(X_c-dis-card-type.host-code))
     1021    else (X_c-dis-card-type.obj-type +                            string(X_c-dis-card-type.obj-code))
     1022   )) COLUMN-LABEL "Область!действия" FORMAT "X(15)":U
     1023   string(X_c-dis-card-type.corr-time, "HH:MM":U) COLUMN-LABEL "Время корр"
     1024   X_c-dis-card-type.chip-num
     1025       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 8.79.
     1026   DEFINE FRAME Dialog-Frame
     1027        B-exit AT ROW 1 COL 1.13
     1028        B-mark AT ROW 1 COL 11
     1029        B-sel AT ROW 1 COL 14
     1030        b-sch AT ROW 1 COL 92 WIDGET-ID 8
     1031        B-Help AT ROW 1 COL 95
     1032        v-corr-user-db-num AT ROW 2.33 COL 19 COLON-ALIGNED WIDGET-ID 6
     1033        BR-dctype AT ROW 3.46 COL 1
     1034        BR-changes AT ROW 13 COL 1
     1035        mark-num AT ROW 2.17 COL 2.88 NO-LABEL
     1036        SPACE(86.24) SKIP(18.89)
     1037       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1038            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1039            TITLE "История типов дисконтных карт"
     1040            DEFAULT-BUTTON B-exit.
     1041   ASSIGN
     1042          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1043          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1044   ASSIGN
     1045          BR-dctype:COLUMN-RESIZABLE IN FRAME Dialog-Frame       = TRUE.
     1046   ON GO OF FRAME Dialog-Frame
     1047   DO:
     1048     p-rid-list = v-rid-list.
     1049   END.
     1050   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1051   DO:
     1052     APPLY "END-ERROR":U TO SELF.
     1053   END.
     1054   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
     1055   DO:
     1056   DEFINE VARIABLE loc#log as logical no-undo.
     1057       if available X_c-dis-card-type then do:
     1058   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1059   define variable v-str-recid11 as character no-undo .
     1060   define variable v-num-entry11 as integer   no-undo .
     1061   assign
     1062     v-str-recid11 = trim( string( recid( X_c-dis-card-type ) , "->>>>>>>>>>>9":U ) )
     1063     v-num-entry11 = lookup( v-str-recid11 , v-rid-list )
     1064   .
     1065   if v-num-entry11 > 0 then do:
     1066     assign
     1067       entry( v-num-entry11, v-rid-list ) = "":U
     1068       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1069     .
     1070   end.
     1071   else do:
     1072     assign
     1073       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid11
     1074     .
     1075   end.
     1076         loc#log = br-dctype:refresh() .
     1077         if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
     1078             loc#log = br-dctype:select-next-row ().
     1079             apply "iteration-changed" to br-dctype in frame Dialog-Frame.
     1080         end.
     1081         if num-entries( v-rid-list ) = 0
     1082         then
     1083             hide mark-num in frame Dialog-Frame.
     1084         else
     1085             disp num-entries( v-rid-list ) @ mark-num with frame Dialog-Frame.
     1086       end.
     1087       apply "entry" to br-dctype in frame Dialog-Frame.
     1088   END.
     1089   ON CHOOSE OF b-sch IN FRAME Dialog-Frame
     1090   DO:
     1091         run proc-b-sch in this-procedure no-error.
     1092     if error-status:error then return no-apply.
     1093   END.
     1094   ON CHOOSE OF B-sel IN FRAME Dialog-Frame
     1095   DO:
     1096       if available X_c-dis-card-type and  v-rid-list = "" then do:
     1097          v-rid-list = string(recid( X_c-dis-card-type)).
     1098       end.
     1099   END.
     1100   ON VALUE-CHANGED OF BR-dctype IN FRAME Dialog-Frame
     1101   DO:
     1102     run proc-view-changes in this-procedure no-error.
     1103   END.
     1104   ON RETURN OF v-corr-user-db-num IN FRAME Dialog-Frame
     1105   DO:
     1106     assign
     1107     v-corr-user-db-num
     1108     .
     1109     RUn OpenBR IN THIS-PROCEDURE ( INPUT yes, INPUT no, INPUT '':U, INPUT v-corr-user-db-num).
     1110   END.
     1111   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1112   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1113   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1114   on help of frame Dialog-Frame
     1115   do:
     1116     run gbl/app_help.p
     1117       (input this-procedure :file-name
     1118       ,input ''
     1119       ,input ?
     1120       ) no-error.
     1121     if error-status :error then do:
     1122       message
     1123         "Ошибка при вызове помощи"
     1124         error-status :get-message(1)
     1125         view-as alert-box .
     1126     end.
     1127   end.
     1128   run minbtn-set in this-procedure .
     1129   on choose of b-help in frame Dialog-Frame
     1130   do:
     1131     apply "help":u to frame Dialog-Frame .
     1132   end.
     1133   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1134   procedure minbtn-set :
     1135       do
     1136           on error undo, return error return-value
     1137           :
     1138           define variable ii              as integer       no-undo .
     1139           define variable fh              as widget-handle no-undo .
     1140           define variable hh              as widget-handle no-undo .
     1141           define variable v-h             as handle        extent 4 no-undo .
     1142           define variable v-name-button   as character     no-undo .
     1143           define variable v-help-old-x    as decimal       no-undo .
     1144           define variable v-help-old-y    as decimal       no-undo .
     1145           define variable v-help-old-size as decimal       no-undo .
     1146           define variable v-frame-width   as decimal       no-undo .
     1147           define variable jj              as integer       no-undo .
     1148           do
     1149               on error undo, return error
     1150               :
     1151               assign
     1152                   v-frame-width = frame Dialog-Frame:width - 0.3
     1153                   fh            = frame Dialog-Frame:first-child
     1154                   hh            = fh:first-child
     1155                   ii            = 1
     1156                   .
     1157               do while valid-handle(hh):
     1158                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1159                   do:
     1160                       case lc(hh:name) :
     1161                           when "b-help" then
     1162                               do:
     1163                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1164                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1165                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1166                                   hh:TOOLTIP = "Помощь" .
     1167                                   v-help-old-x = hh:column .
     1168                                   v-help-old-y = hh:row    .
     1169                                   v-help-old-size = hh:width .
     1170                                   hh:width-chars = 2.5 .
     1171                               end.
     1172                           when "b-print" then
     1173                               do:
     1174                                   hh:load-image("cmp/b-print.bmp":u) .
     1175                                   hh:TOOLTIP = "Печать" .
     1176                                   v-h[ii] = hh:handle .
     1177                                   ii = ii + 1 .
     1178                                   hh:width-chars = 3 .
     1179                               end.
     1180                           when "b-history" or
     1181                           when "b-hist" then
     1182                               do:
     1183                                   hh:load-image("cmp/b-hist.bmp":u) .
     1184                                   hh:TOOLTIP = "История" .
     1185                                   v-h[ii] = hh:handle .
     1186                                   ii = ii + 1 .
     1187                                   hh:width-chars = 3 .
     1188                               end.
     1189                           when "b-sch" then
     1190                               do:
     1191                                   hh:load-image("cmp/b-sch.bmp":u) .
     1192                                   hh:TOOLTIP = "Установка Фильтра" .
     1193                                   v-h[ii] = hh:handle .
     1194                                   ii = ii + 1 .
     1195                                   hh:width-chars = 3 .
     1196                               end.
     1197                           when "b-hist-user" then
     1198                               do:
     1199                                   hh:load-image("cmp/b-hist.bmp":u) .
     1200                                   hh:TOOLTIP = "История пользователя" .
     1201                                   ii = ii + 1 .
     1202                               end.
     1203                       end case.
     1204                   end.
     1205                   hh = hh:next-sibling.
     1206               end.
     1207               b-help:column = v-frame-width - b-help:width-chars.
     1208               jj = 0.
     1209               repeat ii = 4 to 1 by -1 :
     1210                   if valid-handle (v-h[ii] ) then
     1211                   do:
     1212                       jj  = jj + 1 .
     1213                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1214                       v-h[ii]:row    = v-help-old-y .
     1215                   end.
     1216               end.
     1217           end.
     1218       end.
     1219   end procedure.
     1220   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1221   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1222   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1223   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1224   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1225   define variable v-diasize-current-frame-height as decimal   no-undo .
     1226   define variable v-diasize-change-size          as logical   no-undo .
     1227   define variable v-diasize-resize-button        as handle    no-undo .
     1228   define variable v-diasize-wndmax               as logical   no-undo .
     1229   define variable v-diasize-wndstore             as logical   no-undo .
     1230   define variable v-diasize-proc-name            as character no-undo .
     1231   define variable v-diasize-browse-handle        as handle    no-undo .
     1232   define variable v-diasize-browse-number        as integer   no-undo .
     1233   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1234   define temp-table temp-diasize-handle no-undo
     1235     field handle-value  as handle
     1236     field save-position as decimal
     1237     index xpk is primary unique handle-value
     1238     .
     1239   define temp-table temp-browse-handle no-undo
     1240     field browse-type   as character
     1241     field browse-number as integer
     1242     field browse-handle as handle
     1243     field original-size as decimal
     1244     index xpk is primary unique browse-type browse-number
     1245     index xie browse-type browse-handle
     1246   .
     1247   procedure diasize_change-height :
     1248     define input  parameter p-change-value  as decimal   no-undo .
     1249     define input  parameter p-move-resize   as logical   no-undo .
     1250     define variable v-field-group-handle    as handle    no-undo .
     1251     define variable v-object-handle         as handle    no-undo .
     1252     define variable v-frame-height          as decimal   no-undo .
     1253     define variable v-frame-virtual-height  as decimal   no-undo .
     1254     define variable v-browse-height         as decimal   no-undo .
     1255     define variable v-window-height         as decimal   no-undo .
     1256     define variable v-window-virtual-height as decimal   no-undo .
     1257     define variable v-change-sign           as integer   no-undo .
     1258     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1259     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1260     if p-change-value > 0
     1261     then do:
     1262       if frame Dialog-Frame :height + p-change-value
     1263           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1264       then do:
     1265         assign
     1266           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1267                           - (frame Dialog-Frame :height-chars)
     1268         .
     1269         if p-change-value <= 0
     1270         then do:
     1271           run diasize_position-resize-button in this-procedure .
     1272           return .
     1273         end.
     1274       end.
     1275     end.
     1276     if p-change-value < 0
     1277     then do:
     1278       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1279       then do:
     1280         assign
     1281           p-change-value = v-diasize-orig-frame-height
     1282                          - (frame Dialog-Frame :height-chars)
     1283         .
     1284         if p-change-value >= 0
     1285         then do:
     1286           run diasize_position-resize-button in this-procedure .
     1287           return .
     1288         end.
     1289       end.
     1290     end.
     1291     if p-change-value >= 0
     1292     then do:
     1293       assign
     1294         v-change-sign = 1
     1295       .
     1296     end.
     1297     else do:
     1298       assign
     1299         v-change-sign = -1
     1300       .
     1301     end.
     1302     assign
     1303       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1304     .
     1305     if p-change-value = 0
     1306     then do:
     1307       run diasize_position-resize-button in this-procedure .
     1308       return .
     1309     end.
     1310     move_block:
     1311     do
     1312     on error undo move_block, retry move_block
     1313     :
     1314       if retry
     1315       then do:
     1316         do
     1317         on error undo move_block, leave move_block
     1318         :
     1319           if p-change-value > 0
     1320           then do:
     1321             for each buf_temp-diasize-handle
     1322             on error undo, next
     1323             :
     1324               assign
     1325                 v-object-handle = buf_temp-diasize-handle.handle-value
     1326               .
     1327               if v-object-handle <> v-diasize-resize-button
     1328               then do:
     1329                 assign
     1330                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1331                 .
     1332               end.
     1333             end.
     1334             assign
     1335               v-diasize-browse-handle :height = v-browse-height
     1336             .
     1337             for each buf_temp-browse-handle
     1338               where buf_temp-browse-handle.browse-type = 'height':u
     1339             on error undo, next
     1340             :
     1341               assign
     1342                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1343               .
     1344             end.
     1345             assign
     1346               frame Dialog-Frame :height = v-frame-height
     1347             .
     1348             if frame Dialog-Frame :scrollable = true
     1349             then do:
     1350               assign
     1351                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1352               .
     1353             end.
     1354             run diasize_position-resize-button in this-procedure .
     1355           end.
     1356           else do:
     1357             if frame Dialog-Frame :scrollable = true
     1358             then do:
     1359               assign
     1360                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1361               .
     1362             end.
     1363             assign
     1364               frame Dialog-Frame :height = v-frame-height
     1365             .
     1366             assign
     1367               v-diasize-browse-handle :height = v-browse-height
     1368             .
     1369             for each buf_temp-browse-handle
     1370               where buf_temp-browse-handle.browse-type = 'height':u
     1371             on error undo, next
     1372             :
     1373               assign
     1374                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1375               .
     1376             end.
     1377             for each buf_temp-diasize-handle
     1378             on error undo, next
     1379             :
     1380               assign
     1381                 v-object-handle = buf_temp-diasize-handle.handle-value
     1382               .
     1383               if v-object-handle <> v-diasize-resize-button
     1384               then do:
     1385                 assign
     1386                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1387                 .
     1388               end.
     1389             end.
     1390             run diasize_position-resize-button in this-procedure .
     1391           end.
     1392           assign
     1393             v-diasize-change-size = false
     1394           .
     1395           leave move_block .
     1396         end.
     1397       end.
     1398       assign
     1399         v-diasize-need-full-display = true
     1400       .
     1401       if v-diasize-change-size = false
     1402       then do:
     1403         assign
     1404           v-diasize-change-size = true
     1405         .
     1406       end.
     1407       else do:
     1408         return .
     1409       end.
     1410       assign
     1411         v-frame-height = frame Dialog-Frame :height
     1412         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1413         v-browse-height = v-diasize-browse-handle :height
     1414       .
     1415       for each buf_temp-browse-handle
     1416         where buf_temp-browse-handle.browse-type = 'height':u
     1417       :
     1418         assign
     1419           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1420         .
     1421       end.
     1422       for each buf_temp-diasize-handle
     1423       :
     1424         delete buf_temp-diasize-handle .
     1425       end.
     1426       assign
     1427         v-field-group-handle = frame Dialog-Frame :first-child
     1428       .
     1429       do while valid-handle(v-field-group-handle)
     1430       :
     1431         assign
     1432           v-object-handle = v-field-group-handle :first-child
     1433         .
     1434         do while valid-handle(v-object-handle)
     1435         :
     1436           if  v-object-handle <> v-diasize-browse-handle :handle
     1437           and can-query(v-object-handle, "row")
     1438           and can-query(v-object-handle, "height")
     1439           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1440           then do:
     1441             find first buf_temp-browse-handle
     1442               where buf_temp-browse-handle.browse-type   = 'height':u
     1443                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1444               no-error .
     1445             if available buf_temp-browse-handle
     1446             then do:
     1447             end.
     1448             else do:
     1449               create buf_temp-diasize-handle .
     1450               assign
     1451                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1452                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1453               .
     1454             end.
     1455           end.
     1456           assign
     1457             v-object-handle = v-object-handle :next-sibling
     1458           .
     1459         end.
     1460         assign
     1461           v-field-group-handle = v-field-group-handle :next-sibling
     1462         .
     1463       end.
     1464       do with frame Dialog-Frame
     1465       :
     1466         hide v-diasize-resize-button .
     1467         assign
     1468           v-diasize-resize-button :row    = 1
     1469           v-diasize-resize-button :column = 1
     1470         .
     1471       end.
     1472       if p-change-value > 0
     1473       then do:
     1474         if frame Dialog-Frame :scrollable = true
     1475         then do:
     1476           assign
     1477             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1478             no-error .
     1479           if error-status :error
     1480           or error-status :get-message(1) <> ""
     1481           then do:
     1482             undo move_block, retry move_block .
     1483           end.
     1484         end.
     1485         assign
     1486           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1487           no-error .
     1488         if error-status :error
     1489         or error-status :get-message(1) <> ""
     1490         then do:
     1491           undo move_block, retry move_block .
     1492         end.
     1493         assign
     1494           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1495           no-error .
     1496         if error-status :error
     1497         or error-status :get-message(1) <> ""
     1498         then do:
     1499           undo move_block, retry move_block .
     1500         end.
     1501         for each buf_temp-browse-handle
     1502           where buf_temp-browse-handle.browse-type = 'height':u
     1503         on error undo move_block, retry move_block
     1504         :
     1505           assign
     1506             buf_temp-browse-handle.browse-handle :height
     1507               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1508             no-error .
     1509           if error-status :error
     1510           or error-status :get-message(1) <> ""
     1511           then do:
     1512             undo move_block, retry move_block .
     1513           end.
     1514         end.
     1515         for each buf_temp-diasize-handle
     1516         on error undo move_block, retry move_block
     1517         :
     1518           assign
     1519             v-object-handle = buf_temp-diasize-handle.handle-value
     1520           .
     1521           if v-object-handle <> v-diasize-resize-button
     1522           then do:
     1523             assign
     1524               v-object-handle :row = v-object-handle :row + p-change-value
     1525               no-error .
     1526             if error-status :error
     1527             or error-status :get-message(1) <> ""
     1528             then do:
     1529               undo move_block, retry move_block .
     1530             end.
     1531           end.
     1532         end.
     1533       end.
     1534       else do:
     1535         for each buf_temp-diasize-handle
     1536         on error undo move_block, retry move_block
     1537         :
     1538           assign
     1539             v-object-handle = buf_temp-diasize-handle.handle-value
     1540           .
     1541           if v-object-handle <> v-diasize-resize-button
     1542           then do:
     1543             assign
     1544               v-object-handle :row = v-object-handle :row + p-change-value
     1545               no-error .
     1546             if error-status :error
     1547             or error-status :get-message(1) <> ""
     1548             then do:
     1549               undo move_block, retry move_block .
     1550             end.
     1551           end.
     1552         end.
     1553         assign
     1554           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1555           no-error .
     1556         if error-status :error
     1557         or error-status :get-message(1) <> ""
     1558         then do:
     1559           undo move_block, retry move_block .
     1560         end.
     1561         for each buf_temp-browse-handle
     1562           where buf_temp-browse-handle.browse-type = 'height':u
     1563         on error undo move_block, retry move_block
     1564         :
     1565           assign
     1566             buf_temp-browse-handle.browse-handle :height
     1567               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1568             no-error .
     1569           if error-status :error
     1570           or error-status :get-message(1) <> ""
     1571           then do:
     1572             undo move_block, retry move_block .
     1573           end.
     1574         end.
     1575         assign
     1576           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1577           no-error .
     1578         if error-status :error
     1579         or error-status :get-message(1) <> ""
     1580         then do:
     1581           undo move_block, retry move_block .
     1582         end.
     1583         if frame Dialog-Frame :scrollable = true
     1584         then do:
     1585           assign
     1586             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1587             no-error .
     1588           if error-status :error
     1589           or error-status :get-message(1) <> ""
     1590           then do:
     1591             undo move_block, retry move_block .
     1592           end.
     1593         end.
     1594       end.
     1595       if p-move-resize = true
     1596       then do:
     1597         run diasize_position-resize-button in this-procedure .
     1598       end.
     1599       if v-diasize-wndstore = true
     1600       then do:
     1601         if connected("ub") = true
     1602         then do:
     1603           define variable v-cntxt-db-num        as integer   no-undo .
     1604           define variable v-cntxt-userid        as character no-undo .
     1605           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1606                                             , OUTPUT v-cntxt-userid
     1607                                             ) .
     1608           run gbl/wndsizew.p
     1609             (input  v-cntxt-db-num
     1610             ,input  v-cntxt-userid
     1611             ,input  v-diasize-proc-name
     1612             ,input  'height':u
     1613             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1614             ) .
     1615         end.
     1616       end.
     1617     end.
     1618     assign
     1619       v-diasize-change-size = false
     1620     .
     1621   end procedure.
     1622   procedure diasize_set-height :
     1623     define input  parameter p-new-height  as decimal   no-undo .
     1624     define input  parameter p-move-resize as logical   no-undo .
     1625     do
     1626     on error undo, return error return-value
     1627     :
     1628       run diasize_change-height in this-procedure
     1629         (input  (p-new-height - frame Dialog-Frame :height)
     1630         ,input  p-move-resize
     1631         ) .
     1632     end.
     1633   end procedure.
     1634   procedure diasize_change-width :
     1635     define input  parameter p-change-value as decimal   no-undo .
     1636     define input  parameter p-move-resize  as logical   no-undo .
     1637     define variable v-field-group-handle   as handle    no-undo .
     1638     define variable v-object-handle        as handle    no-undo .
     1639     define variable v-frame-width          as decimal   no-undo .
     1640     define variable v-frame-virtual-width  as decimal   no-undo .
     1641     define variable v-browse-width         as decimal   no-undo .
     1642     define variable v-window-width         as decimal   no-undo .
     1643     define variable v-window-virtual-width as decimal   no-undo .
     1644     define variable v-change-sign          as integer   no-undo .
     1645     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1646     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1647     if p-change-value > 0
     1648     then do:
     1649       if frame Dialog-Frame :width + p-change-value >
     1650           session :width-chars
     1651       then do:
     1652         assign
     1653           p-change-value = session :width-chars - frame Dialog-Frame :width
     1654         .
     1655         if p-change-value <= 0
     1656         then do:
     1657           run diasize_position-resize-button in this-procedure .
     1658           return .
     1659         end.
     1660       end.
     1661     end.
     1662     if p-change-value < 0
     1663     then do:
     1664       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1665       then do:
     1666         assign
     1667           p-change-value = v-diasize-orig-frame-width
     1668                          - frame Dialog-Frame :width
     1669         .
     1670         if p-change-value >= 0
     1671         then do:
     1672           run diasize_position-resize-button in this-procedure .
     1673           return .
     1674         end.
     1675       end.
     1676     end.
     1677     if p-change-value >= 0
     1678     then do:
     1679       assign
     1680         v-change-sign = 1
     1681       .
     1682     end.
     1683     else do:
     1684       assign
     1685         v-change-sign = -1
     1686       .
     1687     end.
     1688     assign
     1689       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1690     .
     1691     if p-change-value = 0
     1692     then do:
     1693       run diasize_position-resize-button in this-procedure .
     1694       return .
     1695     end.
     1696     move_block:
     1697     do
     1698     on error undo move_block, leave move_block
     1699     :
     1700       if retry
     1701       then do:
     1702         do
     1703         on error undo move_block, leave move_block
     1704         :
     1705           if p-change-value > 0
     1706           then do:
     1707             for each buf_temp-diasize-handle
     1708             on error undo, next
     1709             :
     1710               assign
     1711                 v-object-handle = buf_temp-diasize-handle.handle-value
     1712               .
     1713               if v-object-handle <> v-diasize-resize-button
     1714               then do:
     1715                 assign
     1716                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1717                 .
     1718               end.
     1719             end.
     1720             assign
     1721               v-diasize-browse-handle :width = v-browse-width
     1722             .
     1723             for each buf_temp-browse-handle
     1724               where buf_temp-browse-handle.browse-type = 'width':u
     1725             on error undo, next
     1726             :
     1727               assign
     1728                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1729               .
     1730             end.
     1731             assign
     1732               frame Dialog-Frame :width = v-frame-width
     1733             .
     1734             if frame Dialog-Frame :scrollable = true
     1735             then do:
     1736               assign
     1737                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1738               .
     1739             end.
     1740             run diasize_position-resize-button in this-procedure .
     1741           end.
     1742           else do:
     1743             if frame Dialog-Frame :scrollable = true
     1744             then do:
     1745               assign
     1746                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1747               .
     1748             end.
     1749             assign
     1750               frame Dialog-Frame :width = v-frame-width
     1751             .
     1752             for each buf_temp-browse-handle
     1753               where buf_temp-browse-handle.browse-type = 'width':u
     1754             on error undo, next
     1755             :
     1756               assign
     1757                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1758               .
     1759             end.
     1760             assign
     1761               v-diasize-browse-handle :width = v-browse-width
     1762             .
     1763             for each buf_temp-diasize-handle
     1764             on error undo, next
     1765             :
     1766               assign
     1767                 v-object-handle = buf_temp-diasize-handle.handle-value
     1768               .
     1769               if v-object-handle <> v-diasize-resize-button
     1770               then do:
     1771                 assign
     1772                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1773                 .
     1774               end.
     1775             end.
     1776             run diasize_position-resize-button in this-procedure .
     1777           end.
     1778           assign
     1779             v-diasize-change-size = false
     1780           .
     1781           leave move_block .
     1782         end.
     1783       end.
     1784       assign
     1785         v-diasize-need-full-display = true
     1786       .
     1787       if v-diasize-change-size = false
     1788       then do:
     1789         assign
     1790           v-diasize-change-size = true
     1791         .
     1792       end.
     1793       else do:
     1794         return .
     1795       end.
     1796       assign
     1797         v-frame-width = frame Dialog-Frame :width
     1798         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1799         v-browse-width = v-diasize-browse-handle :width
     1800       .
     1801       for each buf_temp-browse-handle
     1802         where buf_temp-browse-handle.browse-type = 'width':u
     1803       :
     1804         assign
     1805           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1806         .
     1807       end.
     1808       for each buf_temp-diasize-handle
     1809       :
     1810         delete buf_temp-diasize-handle .
     1811       end.
     1812       assign
     1813         v-field-group-handle = frame Dialog-Frame :first-child
     1814       .
     1815       do while valid-handle(v-field-group-handle)
     1816       :
     1817         assign
     1818           v-object-handle = v-field-group-handle :first-child
     1819         .
     1820         do while valid-handle(v-object-handle)
     1821         :
     1822           if  v-object-handle <> v-diasize-browse-handle :handle
     1823           and v-object-handle <> v-diasize-resize-button
     1824           and can-query(v-object-handle, "row")
     1825           and can-query(v-object-handle, "height")
     1826           and ( v-object-handle :col + v-object-handle :width
     1827                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1828               )
     1829           then do:
     1830             find first buf_temp-browse-handle
     1831               where buf_temp-browse-handle.browse-type   = 'width':u
     1832                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1833               no-error .
     1834             if available buf_temp-browse-handle
     1835             then do:
     1836             end.
     1837             else do:
     1838               create buf_temp-diasize-handle .
     1839               assign
     1840                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1841                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1842               .
     1843             end.
     1844           end.
     1845           assign
     1846             v-object-handle = v-object-handle :next-sibling
     1847           .
     1848         end.
     1849         assign
     1850           v-field-group-handle = v-field-group-handle :next-sibling
     1851         .
     1852       end.
     1853       do with frame Dialog-Frame
     1854       :
     1855         hide v-diasize-resize-button .
     1856         v-diasize-resize-button :row = 1.
     1857         v-diasize-resize-button :column = 1.
     1858       end.
     1859       if p-change-value > 0
     1860       then do:
     1861         if frame Dialog-Frame :scrollable = true
     1862         then do:
     1863           assign
     1864             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1865             no-error .
     1866           if error-status :error
     1867           or error-status :get-message(1) <> ""
     1868           then do:
     1869             undo move_block, retry move_block.
     1870           end.
     1871         end.
     1872         assign
     1873           frame Dialog-Frame :width = v-frame-width + p-change-value
     1874           no-error .
     1875         if error-status :error
     1876         or error-status :get-message(1) <> ""
     1877         then do:
     1878           undo move_block, retry move_block.
     1879         end.
     1880         assign
     1881           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1882         no-error .
     1883         if error-status :error
     1884         or error-status :get-message(1) <> ""
     1885         then do:
     1886           undo move_block, retry move_block.
     1887         end.
     1888         for each buf_temp-browse-handle
     1889           where buf_temp-browse-handle.browse-type = 'width':u
     1890         on error undo move_block, retry move_block
     1891         :
     1892           assign
     1893             buf_temp-browse-handle.browse-handle :width
     1894               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1895             no-error .
     1896           if error-status :error
     1897           or error-status :get-message(1) <> ""
     1898           then do:
     1899             undo move_block, retry move_block .
     1900           end.
     1901         end.
     1902         for each buf_temp-diasize-handle
     1903         on error undo move_block, retry move_block
     1904         :
     1905           assign
     1906             v-object-handle = buf_temp-diasize-handle.handle-value
     1907           .
     1908           if v-object-handle <> v-diasize-resize-button
     1909           then do:
     1910             assign
     1911               v-object-handle :col = v-object-handle :col + p-change-value
     1912               no-error .
     1913             if error-status :error
     1914             or error-status :get-message(1) <> ""
     1915             then do:
     1916               undo move_block, retry move_block .
     1917             end.
     1918           end.
     1919         end.
     1920       end.
     1921       else do:
     1922         for each buf_temp-diasize-handle
     1923         on error undo move_block, retry move_block
     1924         :
     1925           assign
     1926             v-object-handle = buf_temp-diasize-handle.handle-value
     1927           .
     1928           if v-object-handle <> v-diasize-resize-button
     1929           then do:
     1930             assign
     1931               v-object-handle :col = v-object-handle :col + p-change-value
     1932               no-error .
     1933             if error-status :error
     1934             or error-status :get-message(1) <> ""
     1935             then do:
     1936               undo move_block, retry move_block .
     1937             end.
     1938           end.
     1939         end.
     1940         for each buf_temp-browse-handle
     1941           where buf_temp-browse-handle.browse-type = 'width':u
     1942         on error undo move_block, retry move_block
     1943         :
     1944           assign
     1945             buf_temp-browse-handle.browse-handle :width
     1946               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1947             no-error .
     1948           if error-status :error
     1949           or error-status :get-message(1) <> ""
     1950           then do:
     1951             undo move_block, retry move_block .
     1952           end.
     1953         end.
     1954         assign
     1955           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1956           no-error .
     1957         if error-status :error
     1958         or error-status :get-message(1) <> ""
     1959         then do:
     1960           undo move_block, retry move_block.
     1961         end.
     1962         assign
     1963           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1964         no-error .
     1965         if error-status :error
     1966         or error-status :get-message(1) <> ""
     1967         then do:
     1968           undo move_block, retry move_block.
     1969         end.
     1970         if frame Dialog-Frame :scrollable = true
     1971         then do:
     1972           assign
     1973             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1974           no-error .
     1975           if error-status :error
     1976           or error-status :get-message(1) <> ""
     1977           then do:
     1978             undo move_block, retry move_block.
     1979           end.
     1980         end.
     1981       end.
     1982       if p-move-resize
     1983       then do:
     1984         run diasize_position-resize-button in this-procedure .
     1985       end.
     1986       if v-diasize-wndstore = true
     1987       then do:
     1988         if connected("ub") = true
     1989         then do:
     1990           define variable v-cntxt-db-num        as integer   no-undo .
     1991           define variable v-cntxt-userid        as character no-undo .
     1992           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1993                                             , OUTPUT v-cntxt-userid
     1994                                             ) .
     1995           run gbl/wndsizew.p
     1996             (input  v-cntxt-db-num
     1997             ,input  v-cntxt-userid
     1998             ,input  v-diasize-proc-name
     1999             ,input  'width':u
     2000             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2001             ) .
     2002         end.
     2003       end.
     2004     end.
     2005     assign
     2006       v-diasize-change-size = false
     2007     .
     2008   end procedure.
     2009   procedure diasize_set-width :
     2010     define input  parameter p-new-width  as decimal   no-undo .
     2011     define input  parameter p-move-resize as logical   no-undo .
     2012     do
     2013     on error undo, return error return-value
     2014     :
     2015       run diasize_change-width in this-procedure
     2016         (input  (p-new-width - frame Dialog-Frame :width)
     2017         ,input  p-move-resize
     2018         ) .
     2019     end.
     2020   end procedure.
     2021   procedure diasize_position-resize-button :
     2022     do with frame Dialog-Frame
     2023     :
     2024       hide v-diasize-resize-button .
     2025       assign
     2026         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2027                     - 1
     2028                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2029         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2030                     - 1
     2031                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2032       .
     2033       view v-diasize-resize-button .
     2034     end.
     2035   end procedure.
     2036   on alt-right anywhere
     2037   do:
     2038     run diasize_change-width in this-procedure
     2039       (input 1
     2040       ,input true
     2041       ) .
     2042     return no-apply .
     2043   end.
     2044   on alt-left anywhere
     2045   do:
     2046     run diasize_change-width in this-procedure
     2047       (input -1
     2048       ,input true
     2049       ) .
     2050     return no-apply .
     2051   end.
     2052   on alt-down anywhere
     2053   do:
     2054     run diasize_change-height in this-procedure
     2055       (input 1
     2056       ,input true
     2057       ) .
     2058     return no-apply .
     2059   end.
     2060   on alt-up anywhere
     2061   do:
     2062     run diasize_change-height in this-procedure
     2063       (input -1
     2064       ,input true
     2065       ) .
     2066     return no-apply .
     2067   end.
     2068   on alt-enter of frame Dialog-Frame
     2069   do:
     2070     run diasize_maximize in this-procedure
     2071       (input  ?
     2072       ).
     2073     return no-apply .
     2074   end.
     2075   procedure diasize_end-move :
     2076     do
     2077     on error undo, return error return-value
     2078     :
     2079       define variable v-row-delta as decimal   no-undo .
     2080       define variable v-col-delta as decimal   no-undo .
     2081       define variable v-new-row as decimal   no-undo .
     2082       define variable v-new-col as decimal   no-undo .
     2083       assign
     2084         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2085         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2086       .
     2087       assign
     2088         v-row-delta = v-new-row - frame Dialog-Frame :height
     2089         v-col-delta = v-new-col - frame Dialog-Frame :width
     2090       .
     2091       run diasize_change-height in this-procedure
     2092         (input v-row-delta
     2093         ,input true
     2094         ) .
     2095       run diasize_change-width in this-procedure
     2096         (input v-col-delta
     2097         ,input true
     2098         ) .
     2099     end.
     2100   end procedure.
     2101   procedure diasize_maximize :
     2102     define input  parameter p-action as logical   no-undo .
     2103     do
     2104     on error undo, return error return-value
     2105     :
     2106       if p-action = ?
     2107       then do:
     2108         if v-diasize-need-maximize = true
     2109         then do:
     2110           assign
     2111             p-action = true
     2112           .
     2113         end.
     2114         else do:
     2115           assign
     2116             p-action = false
     2117           .
     2118         end.
     2119       end.
     2120       if p-action = true
     2121       then do:
     2122         run diasize_change-height in this-procedure
     2123           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2124               - frame Dialog-Frame :height-chars
     2125           ,input true
     2126           ) .
     2127         run diasize_change-width in this-procedure
     2128           (input session :width-chars
     2129               - frame Dialog-Frame :width-chars
     2130           ,input true
     2131           ) .
     2132         assign
     2133           v-diasize-need-maximize = false
     2134         .
     2135       end.
     2136       else do:
     2137         run diasize_change-width in this-procedure
     2138           (input v-diasize-orig-frame-width
     2139               - frame Dialog-Frame :width-chars
     2140           ,input true
     2141           ) .
     2142         run diasize_change-height in this-procedure
     2143           (input v-diasize-orig-frame-height
     2144               - frame Dialog-Frame :height-chars
     2145           ,input true
     2146           ) .
     2147         assign
     2148           v-diasize-need-maximize = true
     2149         .
     2150       end.
     2151     end.
     2152   end procedure.
     2153   procedure diasize_restore-orig-size :
     2154     do
     2155     on error undo, return error return-value
     2156     :
     2157       assign
     2158         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2159         v-diasize-current-frame-height = frame Dialog-Frame :height
     2160       .
     2161       run diasize_set-height in this-procedure
     2162         (input  v-diasize-orig-frame-height
     2163         ,input  true
     2164         ) .
     2165       run diasize_set-width in this-procedure
     2166         (input  v-diasize-orig-frame-width
     2167         ,input  true
     2168         ) .
     2169     end.
     2170   end procedure.
     2171   procedure diasize_restore-current-size :
     2172     do
     2173     on error undo, return error return-value
     2174     :
     2175       run diasize_set-height in this-procedure
     2176         (input  v-diasize-current-frame-height
     2177         ,input  true
     2178         ) .
     2179       run diasize_set-width in this-procedure
     2180         (input  v-diasize-current-frame-width
     2181         ,input  true
     2182         ) .
     2183     end.
     2184   end procedure.
     2185   procedure diasize_set-browse-handle :
     2186     define input  parameter p-browse-handle as handle   no-undo .
     2187     define buffer buf_temp-browse-handle for temp-browse-handle .
     2188     do
     2189     on error undo, return error return-value
     2190     :
     2191       assign
     2192         v-diasize-browse-handle = p-browse-handle
     2193       .
     2194       for each buf_temp-browse-handle
     2195       on error undo, return error return-value
     2196       :
     2197         delete buf_temp-browse-handle .
     2198       end.
     2199     end.
     2200   end procedure.
     2201   procedure diasize_add_browse :
     2202     define input  parameter p-browse-type   as character no-undo .
     2203     define input  parameter p-browse-handle as handle    no-undo .
     2204     define buffer buf_temp-browse-handle for temp-browse-handle .
     2205     do
     2206     on error undo, return error return-value
     2207     :
     2208       assign
     2209         v-diasize-browse-number = v-diasize-browse-number + 1
     2210       .
     2211       create buf_temp-browse-handle .
     2212       assign
     2213         buf_temp-browse-handle.browse-type   = p-browse-type
     2214         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2215         buf_temp-browse-handle.browse-handle = p-browse-handle
     2216       .
     2217     end.
     2218   end procedure.
     2219   procedure diasize_init :
     2220     define variable v-default-value    as logical   no-undo .
     2221     define variable v-restore-saved    as logical   no-undo .
     2222     define variable v-resize-value-str as character no-undo .
     2223     do
     2224     on error undo, return error return-value
     2225     :
     2226       do with frame Dialog-Frame
     2227       :
     2228         assign
     2229           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2230           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2231           v-diasize-browse-handle     = browse BR-dctype :handle
     2232         .
     2233         create button v-diasize-resize-button
     2234         assign
     2235           parent        = frame Dialog-Frame :first-child
     2236           label         = "s"
     2237           height-pixels = 16
     2238           width-pixels  = 16
     2239           visible       = true
     2240           sensitive     = true
     2241           movable       = true
     2242           triggers:
     2243             on end-move persistent run diasize_end-move in this-procedure .
     2244           end triggers.
     2245         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2246         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2247         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2248         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2249         assign
     2250           v-diasize-wndmax = false
     2251         .
     2252         if connected("ub") = true
     2253         then do:
     2254           define variable v-cntxt-db-num        as integer   no-undo .
     2255           define variable v-cntxt-userid        as character no-undo .
     2256           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2257                                             , OUTPUT v-cntxt-userid
     2258                                             ) .
     2259           run gbl/wndpar_r.p
     2260             (input  v-cntxt-db-num
     2261             ,input  v-cntxt-userid
     2262             ,input  'wndmax':U
     2263             ,output v-diasize-wndmax
     2264             ,output v-default-value
     2265             ) .
     2266         end.
     2267         assign
     2268           v-diasize-wndstore = false
     2269         .
     2270         if connected("ub") = true
     2271         then do:
     2272           run gbl/wndpar_r.p
     2273             (input  v-cntxt-db-num
     2274             ,input  v-cntxt-userid
     2275             ,input  'wndstore':U
     2276             ,output v-diasize-wndstore
     2277             ,output v-default-value
     2278             ) .
     2279         end.
     2280         assign
     2281           v-diasize-proc-name = entry(1, program-name(2), '.')
     2282         .
     2283         if v-diasize-wndstore = true
     2284         then do:
     2285           assign
     2286             v-restore-saved = false
     2287           .
     2288           if connected("ub") = true
     2289           then do:
     2290             run gbl/wndsizer.p
     2291               (input  v-cntxt-db-num
     2292               ,input  v-cntxt-userid
     2293               ,input  v-diasize-proc-name
     2294               ,input  'height':u
     2295               ,output v-resize-value-str
     2296               ) .
     2297             if v-resize-value-str <> '':U
     2298             then do:
     2299               run diasize_change-height in this-procedure
     2300                 (input  integer(v-resize-value-str)
     2301                 ,input  true
     2302                 ) .
     2303               assign
     2304                 v-restore-saved = true
     2305               .
     2306             end.
     2307           end.
     2308           if connected("ub") = true
     2309           then do:
     2310             run gbl/wndsizer.p
     2311               (input  v-cntxt-db-num
     2312               ,input  v-cntxt-userid
     2313               ,input  v-diasize-proc-name
     2314               ,input  'width':u
     2315               ,output v-resize-value-str
     2316               ) .
     2317             if v-resize-value-str <> '':U
     2318             then do:
     2319               run diasize_change-width in this-procedure
     2320                 (input  integer(v-resize-value-str)
     2321                 ,input  true
     2322                 ) .
     2323               assign
     2324                 v-restore-saved = true
     2325               .
     2326             end.
     2327           end.
     2328           if v-restore-saved <> true
     2329           then do:
     2330             if v-diasize-wndmax = true
     2331             then do:
     2332               run diasize_maximize in this-procedure
     2333                 (input  true
     2334                 ) .
     2335             end.
     2336           end.
     2337         end.
     2338         else do:
     2339           if v-diasize-wndmax = true
     2340           then do:
     2341             run diasize_maximize in this-procedure
     2342               (input  true
     2343               ) .
     2344           end.
     2345         end.
     2346       end.
     2347     end.
     2348   end procedure.
     2349   procedure diasize_need-full-display :
     2350     define output parameter p-need-full-display as logical   no-undo .
     2351     do
     2352     on error undo, return error return-value
     2353     :
     2354       assign
     2355         p-need-full-display = v-diasize-need-full-display
     2356       .
     2357       assign
     2358         v-diasize-need-full-display = false
     2359       .
     2360     end.
     2361   end procedure.
     2362   procedure get-context :
     2363      define output parameter p-db-num as integer          no-undo.
     2364      define output parameter p-user-id as character        no-undo.
     2365      define variable v-login               as character    no-undo.
     2366      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2367      define buffer buf_user-login  for ub.user-login .
     2368      do
     2369      on error undo, return error
     2370      :
     2371            FIND FIRST buf_sys-ctrl no-lock.
     2372            ASSIGN
     2373               v-login = USERID("ub")
     2374               p-db-num = buf_sys-ctrl.db-num
     2375            .
     2376            FIND FIRST buf_user-login
     2377                 WHERE buf_user-login.db-num = p-db-num
     2378                   AND buf_user-login.user-login = v-login
     2379                 no-lock
     2380                 no-error
     2381                 .
     2382            IF AVAILABLE buf_user-login
     2383            THEN DO:
     2384               assign
     2385                  p-user-id = buf_user-login.user-id
     2386               .
     2387            END.
     2388      end.
     2389   end procedure.
     2390   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2391   on f5 of frame Dialog-Frame anywhere
     2392   do:
     2393     v-doc-rec = recid(X_c-dis-card-type). run OpenBr in this-procedure  ( input yes, input no, input '':U, input v-corr-user-db-num). reposition br-dctype to recid v-doc-rec no-error. v-doc-rec = ?.               apply 'value-changed' to br-dctype.
     2394       apply "VALUE-CHANGED" to BR-changes.
     2395   end.
     2396   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2397   do:
     2398     BR-changes :SET-REPOSITIONED-ROW(5, "CONDITIONAL") .
     2399   end.
     2400   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2401   procedure set-filter-name :
     2402   define input parameter p-filter-name as character no-undo .
     2403     do with frame Dialog-Frame:
     2404       if p-filter-name > "" then do:
     2405         assign
     2406           frame Dialog-Frame:title
     2407             = frame Dialog-Frame:title + "   ФИЛЬТР: " + p-filter-name.
     2408         .
     2409         assign
     2410           b-sch :tooltip = "Установлен фильтр " + p-filter-name
     2411         .
     2412       end.
     2413       else do:
     2414         assign
     2415           b-sch :tooltip = ""
     2416         .
     2417       end.
     2418     end.
     2419   end procedure.
     2420   MAIN-BLOCK:
     2421   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2422      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2423   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2424     run mainmenu_getcntxt in parparentproc
     2425       (output v-cntxt-db-num
     2426       ,output v-cntxt-userid
     2427       ,output v-cntxt-level
     2428       ,output v-cntxt-host-code-obj
     2429       ,output v-cntxt-obj-type
     2430       ,output v-cntxt-obj-code
     2431       ,output v-cntxt-db-num-obj
     2432       ,output v-cntxt-is-admin
     2433       ) .
     2434     RUN Myenable in this-procedure .
     2435     Run OpenBR in this-procedure  ( input yes, input no, input '':U, input v-corr-user-db-num).
     2436     HIDE mark-num in frame Dialog-Frame .
     2437     run diasize_add_browse in this-procedure
     2438       (input  'width':u
     2439       ,input  browse br-changes :handle
     2440       ) .
     2441     run diasize_init in this-procedure .
     2442     WAIT-FOR GO OF FRAME Dialog-Frame.
     2443   END.
     2444   RUN disable_UI.
     2445   PROCEDURE disable_UI :
     2446     HIDE FRAME Dialog-Frame.
     2447   END PROCEDURE.
     2448   PROCEDURE enable_UI :
     2449     DISPLAY v-corr-user-db-num mark-num
     2450         WITH FRAME Dialog-Frame.
     2451     ENABLE B-exit B-mark B-sel b-sch B-Help v-corr-user-db-num BR-dctype
     2452            BR-changes mark-num
     2453         WITH FRAME Dialog-Frame.
     2454     VIEW FRAME Dialog-Frame.
     2455   END PROCEDURE.
     2456   PROCEDURE MyEnable :
     2457   define variable v-h as handle no-undo.
     2458   v-h = br-dctype:fIRST-COLUMN IN FRAME Dialog-Frame
     2459   .
     2460   DO while valid-handle(v-h) :
     2461     if v-h:LABEL = "Предмет изменений" then do:
     2462       v-h:RESIZABLE = YES.
     2463       leave.
     2464     end.
     2465     ELSE DO:
     2466       v-h = v-h:NEXT-COLUMN.
     2467     END.
     2468   END.
     2469   v-corr-user-db-num = v-cntxt-db-num.
     2470   assign
     2471   br-changes:title in frame Dialog-Frame = "":U
     2472   temp-changes.l_name:resizable in browse br-changes = true
     2473   temp-changes.v_old:resizable in browse br-changes = true
     2474   temp-changes.v_new:resizable in browse br-changes = true
     2475   temp-changes.l_name:width in browse br-changes = 30
     2476   temp-changes.v_old:width in browse br-changes = 40
     2477   temp-changes.v_new:width in browse br-changes = 40
     2478   .
     2479   display
     2480   v-cntxt-db-num @ v-corr-user-db-num
     2481   with frame Dialog-Frame .
     2482   ENABLE
     2483   B-exit
     2484   b-sel when lookup("b-sel":U, bttns) > 0
     2485   b-mark when lookup("b-mark":U, bttns) > 0
     2486   B-Help
     2487   BR-dctype
     2488   BR-changes
     2489   b-sch
     2490   v-corr-user-db-num
     2491   WITH FRAME Dialog-Frame.
     2492   VIEW FRAME Dialog-Frame.
     2493   END PROCEDURE.
     2494   PROCEDURE OpenBr :
     2495   define input  parameter p-open-query     as logical   no-undo .
     2496   define input  parameter p-find-next      as logical   no-undo .
     2497   define input  parameter p-find-condition as character no-undo .
     2498   define input  parameter p-db-num like ub.c-dis-card-type.corr-user-db-num no-undo .
     2499   define variable l-query-was-opened as logical no-undo .
     2500   define variable title0 as character no-undo.
     2501   title0 = "Список полной типа ДК" + chr(32).
     2502   run waitfram-show in this-procedure ("Ждите...").
     2503   define variable sort-column-phrase as character no-undo .
     2504   case sort-column-name :
     2505     when "" then do:
     2506       assign
     2507         sort-column-phrase = ""
     2508       .
     2509     end.
     2510     otherwise do:
     2511       assign
     2512         sort-column-phrase = "by " + sort-column-name
     2513       .
     2514     end.
     2515   end case.
     2516   define variable l-open-query as logical   no-undo .
     2517   CASE p-db-num :
     2518     when ? then do:
     2519       CASE p-mode :
     2520           WHEN 'все':U        THEN DO:
     2521           ASSIGN
     2522           filter-point = filter-point0 + p-mode
     2523           filter-label = substitute("&1", filter-label0)
     2524           .
     2525   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2526   define variable  l-disable-where-20  as logical   no-undo .
     2527   define variable  l-filter-open-20    as logical   .
     2528   define variable  flt-rec-20       as recid     no-undo .
     2529   define variable  filter-name-20      as character no-undo .
     2530   define variable  where-phrase-20     as character no-undo .
     2531   define variable  sort-phrase-20      as character no-undo .
     2532   define variable  where-phrase-rus-20 as character no-undo .
     2533   define variable  sort-phrase-rus-20  as character no-undo .
     2534     run waitfram-show in this-procedure
     2535       (input "ЖДИТЕ ..."
     2536       ).
     2537   run gbl/flt-get.p
     2538     (input filter-point
     2539     ,output flt-rec-20
     2540     ,output filter-name-20
     2541     ,output where-phrase-20
     2542     ,output sort-phrase-20
     2543     ,output where-phrase-rus-20
     2544     ,output sort-phrase-rus-20
     2545     ).
     2546   if p-open-query then do:
     2547       run set-filter-name in this-procedure
     2548         (INPUT filter-name-20
     2549         ) no-error .
     2550     assign
     2551       l-filter-open-20 = false
     2552     .
     2553     if flt-rec-20 <> ?
     2554       or sort-column-phrase > ""
     2555     then do:
     2556       define variable  parameter-2-20 as character no-undo .
     2557       define variable  parameter-3-20 as character no-undo .
     2558       define variable  parameter-4-20 as character no-undo .
     2559       define variable  parameter-5-20 as character no-undo .
     2560       define variable  parameter-6-20 as character no-undo .
     2561       define variable  parameter-7-20 as character no-undo .
     2562         assign
     2563         parameter-3-20 =
     2564                                 "FOR EACH X_c-dis-card-type"
     2565         parameter-4-20 =
     2566           (
     2567             if (" TRUE " + " " + where-phrase-20) <> ""
     2568             then " TRUE " + " " + where-phrase-20
     2569             else "true"
     2570           )
     2571         parameter-5-20 = (" " + "" + " " + "")
     2572         parameter-6-20 = if sort-phrase-20 = ''
     2573                              then
     2574           (
     2575           " " + "  " +
     2576             " " + sort-column-phrase +
     2577           " " + "  "
     2578           )
     2579                              else
     2580           (
     2581           " " + "  " +
     2582             " " + sort-column-phrase +
     2583           " " + sort-phrase-20
     2584           )
     2585         parameter-7-20 =
     2586           " indexed-reposition  "
     2587       .
     2588       do
     2589       on stop undo, leave
     2590       on error undo, leave
     2591       :
     2592         assign
     2593           l-disable-where-20 =
     2594             (" TRUE " + " " + where-phrase-20 = "")
     2595         .
     2596         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     2597                             ,input QUERY br-dctype:handle
     2598                             ,input parameter-3-20
     2599                             ,input parameter-4-20
     2600                             ,input parameter-5-20
     2601                             ,input parameter-6-20
     2602                             ,input parameter-7-20
     2603                             )
     2604         .
     2605         assign
     2606           l-filter-open-20 = true
     2607         .
     2608       end.
     2609       if l-filter-open-20 = false then do:
     2610         message
     2611           "Ошибка при фильтрации / сортировке" skip
     2612           "Будут показаны записи без учета фильтра" skip
     2613           view-as alert-box .
     2614       end.
     2615       else do:
     2616           assign
     2617             l-query-was-opened = true
     2618           .
     2619       end.
     2620     end.
     2621     if l-filter-open-20 = false then do:
     2622       OPEN QUERY br-dctype FOR EACH X_c-dis-card-type
     2623         where  TRUE
     2624         indexed-reposition
     2625     .
     2626         assign
     2627           l-query-was-opened = true
     2628         .
     2629     end.
     2630   end.
     2631   else do:
     2632     assign
     2633       v-doc-rec = recid( X_c-dis-card-type )
     2634     .
     2635     do
     2636     on stop undo, leave
     2637     on error undo, leave
     2638     :
     2639       if QUERY br-dctype:handle:get-buffer-handle(1) = (buffer X_c-dis-card-type:handle) then do:
     2640         assign
     2641         parameter-2-20 = (if p-find-next then "true":u else "false":u )
     2642         parameter-4-20 =
     2643           "where ":u + " TRUE " + " ":u + where-phrase-20 + " ":u + p-find-condition + " " + ""
     2644         parameter-5-20 = "  "
     2645       .
     2646         run fltopend_fltfindd in this-procedure  (
     2647                             input this-procedure:handle
     2648                             ,input QUERY br-dctype:handle
     2649                             ,input rowid(X_c-dis-card-type)
     2650                             ,input logical(parameter-2-20)
     2651                             ,input no-lock
     2652                             ,input (buffer X_c-dis-card-type:handle)
     2653                             ,input parameter-4-20
     2654                             ,input parameter-5-20
     2655                             ) no-error.
     2656         .
     2657         assign
     2658           v-doc-rec = integer(return-value)
     2659           v-fltopend-rowid[1] = ?
     2660         .
     2661       end.
     2662       else do:
     2663         assign
     2664         parameter-2-20 = (if p-find-next then "true":u else "false":u )
     2665         parameter-3-20 =  "FOR EACH X_c-dis-card-type"
     2666         parameter-4-20 =
     2667           (
     2668             if (" TRUE " + " " + where-phrase-20) <> ""
     2669             then " TRUE " + " " + where-phrase-20
     2670             else "true"
     2671           )
     2672         parameter-5-20 = (" " + "" + " " + "" + " " + p-find-condition)
     2673         parameter-6-20 = if sort-phrase-20 = ''
     2674                              then
     2675           (
     2676           " " + "  " +
     2677             " " + sort-column-phrase +
     2678           " " + "  "
     2679           )
     2680                              else
     2681           (
     2682           " " + "  " +
     2683             " " + sort-column-phrase +
     2684           " " + sort-phrase-20
     2685           )
     2686         parameter-7-20 =
     2687           " indexed-reposition  "
     2688       .
     2689         run fltopend_fltfindq in this-procedure  (
     2690                             input this-procedure:handle
     2691                             ,input QUERY br-dctype:handle
     2692                             ,input logical(parameter-2-20)
     2693                             ,input no-lock
     2694                             ,input parameter-3-20
     2695                             ,input parameter-4-20
     2696                             ,input parameter-5-20
     2697                             ,input parameter-6-20
     2698                             ,input parameter-7-20
     2699                             ,output v-fltopend-rowid
     2700                             ) no-error.
     2701         .
     2702         v-doc-rec = ?.
     2703       end.
     2704       assign
     2705         l-query-was-opened = true
     2706       .
     2707     end.
     2708   end.
     2709     run waitfram-hide in this-procedure .
     2710           END.
     2711           WHEN 'фирма':U THEN DO:
     2712             assign
     2713             filter-point = filter-point0 + p-mode
     2714             filter-label = substitute("&1 Фирма", filter-label0)
     2715            frame Dialog-Frame :title = SUBSTITUTE("&1 Эмитент &2 Тип &3 Фирма &4"
     2716                                        ,title0
     2717                                       , p-emitent-host-code
     2718                                       , p-type
     2719                                       , p-host-code)
     2720            .
     2721   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2722   define variable  l-disable-where-22  as logical   no-undo .
     2723   define variable  l-filter-open-22    as logical   .
     2724   define variable  flt-rec-22       as recid     no-undo .
     2725   define variable  filter-name-22      as character no-undo .
     2726   define variable  where-phrase-22     as character no-undo .
     2727   define variable  sort-phrase-22      as character no-undo .
     2728   define variable  where-phrase-rus-22 as character no-undo .
     2729   define variable  sort-phrase-rus-22  as character no-undo .
     2730     run waitfram-show in this-procedure
     2731       (input "ЖДИТЕ ..."
     2732       ).
     2733   run gbl/flt-get.p
     2734     (input filter-point
     2735     ,output flt-rec-22
     2736     ,output filter-name-22
     2737     ,output where-phrase-22
     2738     ,output sort-phrase-22
     2739     ,output where-phrase-rus-22
     2740     ,output sort-phrase-rus-22
     2741     ).
     2742   if p-open-query then do:
     2743       run set-filter-name in this-procedure
     2744         (INPUT filter-name-22
     2745         ) no-error .
     2746     assign
     2747       l-filter-open-22 = false
     2748     .
     2749     if flt-rec-22 <> ?
     2750       or sort-column-phrase > ""
     2751     then do:
     2752       define variable  parameter-2-22 as character no-undo .
     2753       define variable  parameter-3-22 as character no-undo .
     2754       define variable  parameter-4-22 as character no-undo .
     2755       define variable  parameter-5-22 as character no-undo .
     2756       define variable  parameter-6-22 as character no-undo .
