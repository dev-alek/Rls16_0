        1   block-level on error undo, throw.
        2   define input parameter p-doc-rec as recid no-undo.
        3   define variable vss-revision    as character no-undo init "$Revision: 8e9f7b2574c4, 2516, test $":U .
        4   define variable vss-author      as character no-undo init "$Author: DRuban $":U .
        5   define variable vss-date        as character no-undo init "$Date: Вт авг 04 12:57:16 2020 +0300 $":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile: cashdsk3.p $":U .
        7   define variable vss-archive     as character no-undo init "$Archive: ref/cashdsk3.p $":U .
        8   define variable vss-description as character no-undo init "Процедура удаления кассы".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   define new global shared variable g#library  as handle no-undo .
       68   define new global shared variable g#library2 as handle no-undo .
       69   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       70   define variable v-waitfram-action01         as character   no-undo .
       71   define variable v-waitfram-action02         as character   no-undo .
       72   define variable v-waitfram-action03         as character   no-undo .
       73   define variable mWaitFramTextBeg            as character   no-undo.
       74   define variable mWaitFramTextEnd            as character   no-undo.
       75   define variable mWaitFramView               as logical     no-undo.
       76   define variable mWaitProcEvent              as logical     no-undo init yes.
       77   define variable mWaitFramInterval           as integer     no-undo init 1 .
       78   define variable mWaitFramStop               as logical     no-undo.
       79   define variable mWaitFramStopUser           as logical     no-undo.
       80   define variable mWaitFramStopTimeOut        as logical     no-undo.
       81   define variable mWaitFramStartProc          as datetime-tz no-undo.
       82   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
       83   define button B-WaitFramStop auto-end-key
       84        label "Стоп"
       85        size 10 by 1 tooltip "Остоновить процесс".
       86   define button B-viewProcInfo
       87        label "Информация"
       88        size 15 by 1 tooltip "Информация о процесс".
       89   define frame waitfram
       90     v-waitfram-action01 format "x(72)" no-label skip
       91     v-waitfram-action02 format "x(72)" no-label skip
       92     v-waitfram-action03 format "x(72)" no-label skip
       93     B-viewProcInfo
       94     B-WaitFramStop at row 4 col 30
       95     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
       96     .
       97   define new global shared variable mBatchMode as logical no-undo init ?.
       98   define variable mFramBachModHandle as handle no-undo.
       99   mFramBachModHandle = frame waitfram:handle.
      100   define variable mFameOldVis as logical no-undo.
      101   define variable mVisCUrentVin as logical no-undo.
      102   if session:batch-mode
      103   then
      104      mBatchMode = yes.
      105   if mBatchMode = ? then do:
      106     mVisCUrentVin = current-window:visible.
      107     mFameOldVis = mFramBachModHandle:visible.
      108     mFramBachModHandle:visible  = yes.
      109     mBatchMode = mFramBachModHandle:visible ne yes.
      110     mFramBachModHandle:visible = mFameOldVis.
      111     current-window:visible = mVisCUrentVin.
      112   end.
      113    if  log-manager:logfile-name ne ?
      114     then DO:
      115         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      116         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      117         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      118     end.
      119   on choose of B-WaitFramStop in frame waitfram
      120   do:
      121     mWaitFramStop = yes.
      122     mWaitFramStopUser = yes.
      123   end.
      124   function waitfram-check-timeout returns logical():
      125      define variable vtime as int64 no-undo.
      126      if mWaitFramStopTimeOut
      127      then
      128         return yes.
      129      vtime = ( now - mWaitFramStartProc ) / 1000 .
      130      if     mWaitFramTimeOut ne ?
      131         and mWaitFramTimeOut ne 0
      132         and mWaitFramTimeOut lt vtime
      133      then do:
      134         mWaitFramStopTimeOut = yes.
      135      end.
      136      return mWaitFramStopTimeOut.
      137   end.
      138   procedure waitfram-hide :
      139     if not session:batch-mode
      140     then do
      141     on error undo, return error return-value
      142     :
      143       pause 0 before-hide .
      144       if not mBatchMode then
      145         hide frame waitfram .
      146     if     not mWaitFramView
      147        and mWaitProcEvent
      148     then
      149       process events .
      150     end.
      151   end procedure.
      152   procedure waitfram-show :
      153     define input  parameter p-message as character no-undo .
      154     define variable v-left-margin as integer   no-undo .
      155     if not session:batch-mode
      156     then do
      157     on error undo, return error return-value
      158     :
      159       if length(p-message) <= 70 then do:
      160         assign
      161           v-left-margin = integer((70 - length(p-message)) / 2)
      162         .
      163         assign
      164           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      165         .
      166         assign
      167           v-waitfram-action01 = " "
      168           v-waitfram-action02 = " "
      169                                    + fill(" ", v-left-margin)
      170                                    + p-message
      171           v-waitfram-action03 = " "
      172         .
      173       end.
      174       else do:
      175         define variable vRindex1 as integer no-undo.
      176         define variable vRindex2 as integer no-undo.
      177         vRindex1 = r-index(p-message," ",70).
      178         if vRindex1 = 0
      179         then
      180            vRindex1 = 70.
      181         if length(p-message)  <= vRindex1 + 70 then do:
      182           assign
      183             v-waitfram-action01 = " "
      184             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      185             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      186           .
      187         end.
      188         else do:
      189           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      190           if vRindex2 <= vRindex1
      191           then
      192              vRindex2 = vRindex1 + 70.
      193           assign
      194             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      195             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      196             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      197           .
      198         end.
      199       end.
      200       B-viewProcInfo:visible   in frame waitfram = no.
      201       B-viewProcInfo:sensitive in frame waitfram = no.
      202       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      203       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      204       if  (   mWaitFramView
      205          or  mWaitProcEvent)
      206          and not mBatchMode
      207       then
      208          display
      209             v-waitfram-action01 skip
      210             v-waitfram-action02 skip
      211             v-waitfram-action03 skip
      212          with frame waitfram .
      213       if     mWaitFramView
      214          then do:
      215             if     mWaitFramInterval ne ?
      216                and not mBatchMode
      217             then
      218                wait-for go of frame waitfram pause mWaitFramInterval.
      219          end.
      220          else
      221             if     mWaitProcEvent
      222                and not mBatchMode
      223             then
      224                process events .
      225     end.
      226   end procedure.
      227      procedure waitfram-show-this:
      228         define input  parameter iInterval as int64 no-undo.
      229         define variable vtime as int64 no-undo.
      230         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      231         mWaitFramInterval = iInterval.
      232         run waitfram-show (substitute("&1&2 &3&4" ,
      233                                       mWaitFramTextBeg ,
      234                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      235                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      236                                       mWaitFramTextEnd
      237                                      )
      238                           ).
      239      end.
      240      procedure WaitFramRunPause:
      241         define input  parameter iInterval as dec no-undo.
      242         define variable vStart  as datetime-tz no-undo.
      243         define variable vend    as datetime-tz no-undo.
      244         define variable vint as int64 no-undo.
      245         define variable vOk as logical no-undo.
      246         vStart = now.
      247         vend   = vStart.
      248         publish "WaitFramPause" (iInterval,output vOk).
      249         vend   =  now.
      250         vint = vend - vStart.
      251         vint = iInterval - vint / 1000.
      252         if     not mWaitFramStop
      253            and (   vint > 0
      254                 or (    not vOk
      255                     and iInterval eq ?
      256                     )
      257                 )
      258         then
      259            run waitfram-show-this (iInterval).
      260         vend   =  now.
      261         vint = vend - vStart.
      262         vint = iInterval - vint / 1000.
      263         if     not mWaitFramStop
      264            and vint > 0
      265         then do:
      266            run gbl/pause.p (vint * 1000).
      267         end.
      268         if iInterval ne ?
      269         then
      270            publish "WaitFramStop".
      271         waitfram-check-timeout().
      272      end.
      273      procedure WaitFramWaitFor:
      274         define input  parameter iInterval as dec no-undo.
      275         assign
      276            mWaitFramStartProc   = now
      277            mWaitFramStopUser    = no
      278            mWaitFramStopTimeOut = no
      279         .
      280         block-wait:
      281         do while not mWaitFramStop:
      282            run WaitFramRunPause (iInterval).
      283            if  waitfram-check-timeout()
      284            then do:
      285               leave block-wait.
      286            end.
      287         end.
      288         run waitfram-hide.
      289      end.
      290   procedure waitfram-join :
      291     define input  parameter p-line-1  as character no-undo .
      292     define input  parameter p-line-2  as character no-undo .
      293     define input  parameter p-line-3  as character no-undo .
      294     define output parameter p-message as character no-undo .
      295     do
      296     on error undo, return error return-value
      297     :
      298       assign
      299         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      300                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      301                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      302       .
      303     end.
      304   end procedure.
      305   function waitfram-join-function returns character
      306     (input p-line-1 as character
      307     ,input p-line-2 as character
      308     ,input p-line-3 as character
      309     ).
      310     define variable v-message as character no-undo .
      311     run waitfram-join in this-procedure
      312       (input  p-line-1
      313       ,input  p-line-2
      314       ,input  p-line-3
      315       ,output v-message
      316       ) .
      317     return v-message .
      318   end function .
      319   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      320   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      321   procedure cur-time :
      322      define output parameter p-today as date      no-undo .
      323      define output parameter p-time  as integer   no-undo .
      324     do
      325     on error undo, return error
      326     :
      327       define variable v-date1 as date      no-undo .
      328       define variable v-date2 as date      no-undo .
      329       define variable v-time  as integer   no-undo .
      330       assign
      331         v-date1 = today
      332         v-time  = time
      333         v-date2 = today
      334       .
      335       if v-date1 <> v-date2
      336       then do:
      337         assign
      338           v-date1 = today
      339           v-time  = v-time
      340         .
      341       end.
      342       assign
      343         p-today = v-date1
      344         p-time  = v-time
      345       .
      346     end.
      347   end.
      348   function cur-time-date returns character
      349   :
      350     return string(today, '99/99/9999':U) .
      351   end.
      352   function cur-time-mjd returns decimal
      353   :
      354     define variable v-date as date      no-undo .
      355     define variable v-time as integer   no-undo .
      356     run cur-time in this-procedure
      357       (output v-date
      358       ,output v-time
      359       ) .
      360     return integer(v-date) - 2400002 + (v-time / 86400) .
      361   end.
      362   function cur-time-get-ending-index returns integer
      363   (input p-number as integer
      364   )
      365   :
      366     if p-number < 0
      367     or p-number = ?
      368     then do:
      369       return 1 .
      370     end.
      371     define variable v-rest as integer   no-undo .
      372     assign
      373       p-number = p-number modulo 100
      374     .
      375     if p-number < 20
      376     then do:
      377       assign
      378         v-rest = p-number
      379       .
      380     end.
      381     else do:
      382       assign
      383         v-rest = p-number modulo 10
      384       .
      385     end.
      386     case v-rest :
      387       when 1
      388       then do:
      389         return 2 .
      390       end.
      391       when 2 or
      392       when 3 or
      393       when 4
      394       then do:
      395         return 3 .
      396       end.
      397       otherwise do:
      398         return 1 .
      399       end.
      400     end case .
      401   end.
      402   procedure cur-time-mjd-to-date :
      403      define input  parameter i-mjd-diff as decimal no-undo.
      404      define output parameter o-Date     as date    no-undo.
      405      define output parameter o-Time     as integer no-undo.
      406      define variable v-day-number as integer   no-undo .
      407      if    i-mjd-diff < 0
      408         or i-mjd-diff = ?
      409      then do:
      410         return "?" .
      411      end.
      412      assign
      413         v-day-number = truncate(i-mjd-diff,0).
      414         o-Date = date(v-day-number + 2400002).
      415         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      416     .
      417   end.
      418   function cur-time-mjd-to-string returns character
      419   (input p-mjd-diff as decimal
      420   )
      421   :
      422     define variable v-day-number as integer   no-undo .
      423     define variable v-seconds    as integer   no-undo .
      424     define variable v-hour       as integer   no-undo .
      425     define variable v-min        as integer   no-undo .
      426     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      427     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      428     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      429     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      430     if p-mjd-diff < 0
      431     or p-mjd-diff = ?
      432     then do:
      433       return "?" .
      434     end.
      435     assign
      436       v-day-number = integer(truncate(p-mjd-diff,0))
      437       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      438     .
      439     if v-seconds > 86400
      440     then do:
      441       assign
      442         v-seconds = 86400 - 1
      443       .
      444     end.
      445     if v-seconds < 0
      446     then do:
      447       assign
      448         v-seconds = 0
      449       .
      450     end.
      451     assign
      452       v-hour = truncate(v-seconds / 3600, 0)
      453     .
      454     assign
      455       v-seconds = v-seconds modulo 3600
      456     .
      457     assign
      458       v-min = truncate(v-seconds / 60, 0)
      459     .
      460     assign
      461       v-seconds = v-seconds modulo 60
      462     .
      463     return
      464         (if v-day-number <> 0
      465           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      466           else ""
      467         )
      468       + (if v-day-number <> 0 or v-hour <> 0
      469           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      470           else ""
      471         )
      472       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      473           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      474           else ""
      475         )
      476       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      477       .
      478   end.
      479   function cur-time-string returns character
      480   :
      481     define variable v-date as date      no-undo .
      482     define variable v-time as integer   no-undo .
      483     run cur-time in this-procedure
      484       (output v-date
      485       ,output v-time
      486       ) .
      487     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      488   end.
      489   function cur-time-string-sec returns character
      490   :
      491     define variable v-date as date      no-undo .
      492     define variable v-time as integer   no-undo .
      493     run cur-time in this-procedure
      494       (output v-date
      495       ,output v-time
      496       ) .
      497     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      498   end.
      499   function cur-time-custom  returns character
      500   (input p-prefix as character
      501   ,input p-date-format as character
      502   ,input p-delimiter as character
      503   ,input p-time-format as character
      504   ,input p-suffix as character
      505   )
      506   :
      507     define variable v-date as date      no-undo .
      508     define variable v-time as integer   no-undo .
      509     run cur-time in this-procedure
      510       (output v-date
      511       ,output v-time
      512       ) .
      513     return
      514       p-prefix
      515       + string(v-date, p-date-format)
      516       + p-delimiter
      517       + string(v-time, p-time-format)
      518       + p-suffix
      519       .
      520   end.
      521   function cur-time-print  returns character
      522   :
      523     define variable v-date as date      no-undo .
      524     define variable v-time as integer   no-undo .
      525     run cur-time in this-procedure
      526       (output v-date
      527       ,output v-time
      528       ) .
      529     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      530   end.
      531   function cur-time-datetime returns datetime
      532   :
      533     define variable v-char as character no-undo .
      534     define variable v-datetime as datetime no-undo .
      535     v-char = cur-time-string().
      536     v-datetime = datetime(v-char).
      537     return  v-datetime.
      538   end.
      539   function cur-time-string-msec returns character
      540   :
      541     define variable v-date as datetime  no-undo .
      542     v-date = now.
      543     return string(v-date) .
      544   end.
      545   procedure cp-attr-code :
      546     do
      547     on error undo, return error
      548     :
      549       define input  parameter p-code           as character no-undo .
      550       define output parameter p-type           as character no-undo .
      551       define output parameter p-format         as character no-undo .
      552       define output parameter p-label          as character no-undo .
      553       define output parameter p-range          as integer   no-undo .
      554       define output parameter p-user-can-edit  as logical   no-undo .
      555       define output parameter p-output-display as logical   no-undo .
      556       define output parameter p-other          as character no-undo .
      557       case p-code :
      558               when 'paycard-export-prefix':U then do:     assign     p-label = "Префиксы платежных карт (для выгрузки в XML)"     p-type = 'C':U      p-format = "X(19)"     p-label = "Префиксы платежных карт (для выгрузки в XML)"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=paycard-prefix':u      .   end.
      559               when 'grp-code':U then do:     assign     p-label = "Группа платежа"     p-type = 'C':U      p-format = "X(45)"     p-label = "Группа платежа"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=grp-code':u      .   end.
      560               when 'is-use':U then do:     assign     p-label = "Используется"     p-type = 'C':U      p-format = "X(255)"     p-label = "Используется"     p-range = 4     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=is-use':u      .   end.
      561               when 'dop-doc':U then do:     assign     p-label = "Дополнительный документ"     p-type = 'C':U      p-format = "X(255)"     p-label = "Дополнительный документ"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=dop-doc':u      .   end.
      562               when 'paycard-all-prefix':U then do:     assign     p-label = "Префиксы платежных карт (для разбора чеков и т.д.)"     p-type = 'C':U      p-format = "X(19)"     p-label = "Префиксы платежных карт (для разбора чеков и т.д.)"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=paycard-prefix':u      .   end.
      563               when 'paycard-edit-prefix':U then do:     assign     p-label = "Префиксы платежных карт, разрешенных для редактирования"     p-type = 'C':U      p-format = "X(19)"     p-label = "Префиксы платежных карт, разрешенных для редактирования"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=paycard-prefix':u      .   end.
      564               when 'form_km3':U then do:     assign     p-label = "Формировать КМ-3 по чекам возврата"     p-type = 'L':U      p-format = "+/-"     p-label = "Формировать КМ-3 по чекам возврата"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = '':u      .   end.
      565               when 'bal_malina':U then do:     assign     p-label = "Оплата баллами Малина"     p-type = 'L':U      p-format = "+/-"     p-label = "Оплата баллами Малина"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = '':u      .   end.
      566               when 'max_proc_sum':U then do:     assign     p-label = "Максимальный % порог от суммы"     p-type = 'D':U      p-format = ">>9.99"     p-label = "Максимальный % порог от суммы"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = '':u      .   end.
      567               when 'mask_card_kup':U then do:     assign     p-label = "Маска карты\купона"     p-type = 'C':U      p-format = "x(129)"     p-label = "Маска карты\купона"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = '':u      .   end.
      568         otherwise do:
      569           undo, return error substitute("неизвестный атрибут типа кассового платежа &1", p-code ).
      570         end.
      571       end.
      572     end.
      573   end procedure.
      574   procedure cp-attr-tooltip :
      575     do
      576     on error undo, return error
      577     :
      578       define input  parameter p-code    as character no-undo .
      579       define output parameter p-tooltip as character no-undo .
      580       define output parameter p-label   as character no-undo .
      581       case p-code :
      582               when 'paycard-export-prefix':U then do:     assign     p-tooltip = "Префиксы платежных карт (для выгрузки в XML)"     p-label = "Префиксы платежных карт (для выгрузки в XML)" .   end.
      583               when 'grp-code':U then do:     assign     p-tooltip = "Группа платежа"     p-label = "Группа платежа" .   end.
      584               when 'is-use':U then do:     assign     p-tooltip = "Используется"     p-label = "Используется" .   end.
      585               when 'dop-doc':U then do:     assign     p-tooltip = "Дополнительный документ"     p-label = "Дополнительный документ" .   end.
      586               when 'paycard-all-prefix':U then do:     assign     p-tooltip = "Префиксы платежных карт (для разбора чеков и т.д.)"     p-label = "Префиксы платежных карт (для разбора чеков и т.д.)" .   end.
      587               when 'paycard-edit-prefix':U then do:     assign     p-tooltip = "Префиксы платежных карт, разрешенных для редактировани"     p-label = "Префиксы платежных карт, разрешенных для редактирования" .   end.
      588               when 'form_km3':U then do:     assign     p-tooltip = "Формировать КМ-3 по чекам возврата"     p-label = "Формировать КМ-3 по чекам возврата" .   end.
      589               when 'bal_malina':U then do:     assign     p-tooltip = "Оплата баллами Малина"     p-label = "Оплата баллами Малина" .   end.
      590               when 'max_proc_sum':U then do:     assign     p-tooltip = "Максимальный % порог от суммы"     p-label = "Максимальный % порог от суммы" .   end.
      591               when 'mask_card_kup':U then do:     assign     p-tooltip = "Маска карты\купона"     p-label = "Маска карты\купона" .   end.
      592         otherwise do:
      593           undo, return error substitute("неизвестный атрибут типа кассового платежа &1", p-code) .
      594         end.
      595       end.
      596     end.
      597   end procedure.
      598   procedure cp-attr-value :
      599     do
      600     on error undo, return error
      601     :
      602       define input parameter p-cdpay-code   like ub.cash-pay-attr.cdpay-code     no-undo .
      603       define input parameter p-curr-code    like ub.cash-pay-attr.curr-code      no-undo .
      604       define input parameter p-host-code    like ub.cash-pay-attr.host-code      no-undo .
      605       define input parameter p-obj-type     like ub.cash-pay-attr.obj-type       no-undo .
      606       define input parameter p-obj-code     like ub.cash-pay-attr.obj-code       no-undo .
      607       define input  parameter p-code        like ub.cash-pay-attr.attr-code      no-undo .
      608       define output parameter p-value       like ub.cash-pay-attr.attr-value    no-undo .
      609       define output parameter p-type        as character no-undo .
      610       define buffer buf_cash-pay-attr for ub.cash-pay-attr .
      611       define variable v-format         as character no-undo .
      612       define variable v-label          as character no-undo .
      613       define variable v-range          as integer   no-undo .
      614       define variable v-user-can-edit  as logical   no-undo .
      615       define variable v-output-display as logical   no-undo .
      616       define variable v-other          as character no-undo .
      617       run cp-attr-code in this-procedure
      618         (input  p-code
      619         ,output p-type
      620         ,output v-format
      621         ,output v-label
      622         ,output v-range
      623         ,output v-user-can-edit
      624         ,output v-output-display
      625         ,output v-other
      626         ) no-error .
      627       if error-status :error then do:
      628         undo, return error return-value .
      629       end.
      630       find first buf_cash-pay-attr no-lock
      631         where buf_cash-pay-attr.cdpay-code = p-cdpay-code
      632           and buf_cash-pay-attr.curr-code  = p-curr-code
      633           and buf_cash-pay-attr.host-code  = p-host-code
      634           and buf_cash-pay-attr.obj-type   = p-obj-type
      635           and buf_cash-pay-attr.obj-code   = p-obj-code
      636           and buf_cash-pay-attr.attr-code  = p-code
      637         no-error .
      638       if avail buf_cash-pay-attr then do:
      639         assign
      640           p-value =  buf_cash-pay-attr.attr-value
      641         .
      642       end.
      643       else do:
      644         assign
      645           p-value = if p-type = 'L':U then "no":U else ""
      646         .
      647       end.
      648     end.
      649   end procedure.
      650   procedure cp-attr-write :
      651     do
      652     on error undo, return error
      653     :
      654       define input parameter p-cdpay-code   like ub.cash-pay-attr.cdpay-code     no-undo .
      655       define input parameter p-curr-code    like ub.cash-pay-attr.curr-code      no-undo .
      656       define input parameter p-host-code    like ub.cash-pay-attr.host-code      no-undo .
      657       define input parameter p-obj-type     like ub.cash-pay-attr.obj-type       no-undo .
      658       define input parameter p-obj-code     like ub.cash-pay-attr.obj-code       no-undo .
      659       define input parameter p-code     like ub.cash-pay-attr.attr-code  no-undo .
      660       define input parameter p-value    like ub.cash-pay-attr.attr-value no-undo .
      661       define buffer buf_cash-pay-attr for ub.cash-pay-attr .
      662       define buffer last_cash-pay-attr for ub.cash-pay-attr .
      663       define variable v-type           as character no-undo .
      664       define variable v-format         as character no-undo .
      665       define variable v-label          as character no-undo .
      666       define variable v-range          as integer   no-undo .
      667       define variable v-user-can-edit  as logical   no-undo .
      668       define variable v-output-display as logical   no-undo .
      669       define variable v-other          as character no-undo .
      670       run cp-attr-code in this-procedure
      671         (input  p-code
      672         ,output v-type
      673         ,output v-format
      674         ,output v-label
      675         ,output v-range
      676         ,output v-user-can-edit
      677         ,output v-output-display
      678         ,output v-other
      679         ) no-error .
      680       if error-status :error then do:
      681         undo, return error return-value .
      682       end.
      683       find first buf_cash-pay-attr exclusive-lock
      684         where buf_cash-pay-attr.cdpay-code = p-cdpay-code
      685           and buf_cash-pay-attr.curr-code  = p-curr-code
      686           and buf_cash-pay-attr.host-code  = p-host-code
      687           and buf_cash-pay-attr.obj-type   = p-obj-type
      688           and buf_cash-pay-attr.obj-code   = p-obj-code
      689           and buf_cash-pay-attr.attr-code = p-code
      690         no-error .
      691       if not available buf_cash-pay-attr then do:
      692         create buf_cash-pay-attr .
      693         assign
      694         buf_cash-pay-attr.cdpay-code = p-cdpay-code
      695         buf_cash-pay-attr.curr-code  = p-curr-code
      696         buf_cash-pay-attr.host-code  = p-host-code
      697         buf_cash-pay-attr.obj-type   = p-obj-type
      698         buf_cash-pay-attr.obj-code   = p-obj-code
      699         buf_cash-pay-attr.attr-code = p-code
      700         .
      701       end.
      702       assign
      703         buf_cash-pay-attr.attr-value = p-value
      704       .
      705       release buf_cash-pay-attr no-error .
      706       if error-status:error then do:
      707         undo, return error return-value .
      708       end.
      709     end.
      710   end procedure.
      711   procedure cp-attr-exist :
      712     do
      713     on error undo, return error
      714     :
      715       define input parameter p-cdpay-code   like ub.cash-pay-attr.cdpay-code     no-undo .
      716       define input parameter p-curr-code    like ub.cash-pay-attr.curr-code      no-undo .
      717       define input parameter p-host-code    like ub.cash-pay-attr.host-code      no-undo .
      718       define input parameter p-obj-type     like ub.cash-pay-attr.obj-type       no-undo .
      719       define input parameter p-obj-code     like ub.cash-pay-attr.obj-code       no-undo .
      720       define input parameter p-code     like ub.cash-pay-attr.attr-code  no-undo .
      721       define output parameter p-exist   as logical  no-undo .
      722       define buffer buf_cash-pay-attr for ub.cash-pay-attr .
      723       define variable v-type           as character no-undo .
      724       define variable v-format         as character no-undo .
      725       define variable v-label          as character no-undo .
      726       define variable v-range          as integer   no-undo .
      727       define variable v-user-can-edit  as logical   no-undo .
      728       define variable v-output-display as logical   no-undo .
      729       define variable v-other          as character no-undo .
      730       run cp-attr-code in this-procedure
      731         (input  p-code
      732         ,output v-type
      733         ,output v-format
      734         ,output v-label
      735         ,output v-range
      736         ,output v-user-can-edit
      737         ,output v-output-display
      738         ,output v-other
      739         ) no-error .
      740       if error-status :error then do:
      741         undo, return error return-value .
      742       end.
      743       find first buf_cash-pay-attr exclusive-lock
      744         where buf_cash-pay-attr.cdpay-code = p-cdpay-code
      745           and buf_cash-pay-attr.curr-code  = p-curr-code
      746           and buf_cash-pay-attr.host-code  = p-host-code
      747           and buf_cash-pay-attr.obj-type   = p-obj-type
      748           and buf_cash-pay-attr.obj-code   = p-obj-code
      749           and buf_cash-pay-attr.attr-code = p-code
      750         no-error .
      751       if  available buf_cash-pay-attr then do:
      752         p-exist = yes.
      753       end.
      754     end.
      755   end procedure.
      756   procedure cp-attr-delete :
      757     do
      758     on error undo, return error
      759     :
      760       define input parameter p-cdpay-code   like ub.cash-pay-attr.cdpay-code     no-undo .
      761       define input parameter p-curr-code    like ub.cash-pay-attr.curr-code      no-undo .
      762       define input parameter p-host-code    like ub.cash-pay-attr.host-code      no-undo .
      763       define input parameter p-obj-type     like ub.cash-pay-attr.obj-type       no-undo .
      764       define input parameter p-obj-code     like ub.cash-pay-attr.obj-code       no-undo .
      765       define input parameter p-code     like ub.cash-pay-attr.attr-code  no-undo .
      766       define output parameter p-deleted  as logical no-undo.
      767       define buffer buf_cash-pay-attr for ub.cash-pay-attr .
      768       define variable v-type           as character no-undo .
      769       define variable v-format         as character no-undo .
      770       define variable v-label          as character no-undo .
      771       define variable v-range          as integer   no-undo .
      772       define variable v-user-can-edit  as logical   no-undo .
      773       define variable v-output-display as logical   no-undo .
      774       define variable v-other          as character no-undo .
      775       run cp-attr-code in this-procedure
      776         (input  p-code
      777         ,output v-type
      778         ,output v-format
      779         ,output v-label
      780         ,output v-range
      781         ,output v-user-can-edit
      782         ,output v-output-display
      783         ,output v-other
      784         ) no-error .
      785       if error-status :error then do:
      786         undo, return error return-value .
      787       end.
      788       find first buf_cash-pay-attr exclusive-lock
      789         where buf_cash-pay-attr.cdpay-code = p-cdpay-code
      790           and buf_cash-pay-attr.curr-code  = p-curr-code
      791           and buf_cash-pay-attr.host-code  = p-host-code
      792           and buf_cash-pay-attr.obj-type   = p-obj-type
      793           and buf_cash-pay-attr.obj-code   = p-obj-code
      794           and buf_cash-pay-attr.attr-code = p-code
      795         no-error NO-WAIT.
      796       if not available buf_cash-pay-attr then do:
      797         p-deleted = no.
      798       end.
      799       else do:
      800         delete buf_cash-pay-attr no-error .
      801         if error-status:error then do:
      802           undo, return error return-value .
      803         end.
      804         p-deleted = yes.
      805       end.
      806     end.
      807   end procedure.
      808   procedure cp-attr-news :
      809     do
      810     on error undo, return error
      811     :
      812       define input  parameter p-code           as character no-undo .
      813       define output parameter p-news           as logical   no-undo .
      814       case p-code :
      815               when 'paycard-export-prefix':U then do:     assign     p-news = true.   end.
      816               when 'grp-code':U then do:     assign     p-news = true.   end.
      817               when 'is-use':U then do:     assign     p-news = true.   end.
      818               when 'dop-doc':U then do:     assign     p-news = true.   end.
      819               when 'paycard-all-prefix':U then do:     assign     p-news = true.   end.
      820               when 'paycard-edit-prefix':U then do:     assign     p-news = true.   end.
      821               when 'form_km3':U then do:     assign     p-news = false.   end.
      822               when 'bal_malina':U then do:     assign     p-news = false.   end.
      823               when 'max_proc_sum':U then do:     assign     p-news = true.   end.
      824               when 'mask_card_kup':U then do:     assign     p-news = true.   end.
      825         otherwise do:
      826           p-news = no.
      827         end.
      828       end.
      829     end.
      830   end procedure.
      831   procedure cp-attr-hist :
      832     do
      833     on error undo, return error
      834     :
      835       define input  parameter p-code           as character no-undo .
      836       define output parameter p-hist           as logical   no-undo .
      837       case p-code :
      838               when 'paycard-export-prefix':U then do:     assign     p-hist = true.   end.
      839               when 'paycard-all-prefix':U then do:     assign     p-hist = true.   end.
      840               when 'paycard-edit-prefix':U then do:     assign     p-hist = true.   end.
      841               when 'form_km3':U then do:     assign     p-hist = true.   end.
      842               when 'bal_malina':U then do:     assign     p-hist = true.   end.
      843               when 'max_proc_sum':U then do:     assign     p-hist = true.   end.
      844               when 'mask_card_kup':U then do:     assign     p-hist = true.   end.
      845         otherwise do:
      846           p-hist = no.
      847         end.
      848       end.
      849     end.
      850   end procedure.
      851   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      852   procedure wth-lib_cur-stock-place:
      853   define input  parameter parobj-type like ub.clients.obj-type   no-undo.
      854   define input  parameter parobj-code like ub.clients.obj-code   no-undo.
      855   define input  parameter parw-p-code like ub.wth-pobj.w-p-code  no-undo.
      856   define input  parameter parwth-code like ub.wth-pobj.wth-code  no-undo.
      857   define output parameter parstock    like ub.wth-pobj.income-pl no-undo.
      858   define buffer bf_wth-pobj for ub.wth-pobj.
      859   find first bf_wth-pobj where bf_wth-pobj.obj-type = parobj-type and
      860                                bf_wth-pobj.obj-code = parobj-code and
      861                                bf_wth-pobj.w-p-code = parw-p-code and
      862                                bf_wth-pobj.wth-code = parwth-code no-lock no-error.
      863   if available bf_wth-pobj then assign parstock = bf_wth-pobj.income-pl - bf_wth-pobj.incass-pl.
      864                            else assign parstock = 0.
      865   end procedure.
      866   procedure wth-lib_cur-stock-obj:
      867   define input  parameter parobj-type like ub.clients.obj-type   no-undo.
      868   define input  parameter parobj-code like ub.clients.obj-code   no-undo.
      869   define input  parameter parwth-code like ub.wth-obj.wth-code   no-undo.
      870   define output parameter parstock    like ub.wth-obj.income     no-undo.
      871   define buffer bf_wth-obj for ub.wth-obj.
      872   find first bf_wth-obj where bf_wth-obj.obj-type = parobj-type and
      873                               bf_wth-obj.obj-code = parobj-code and
      874                               bf_wth-obj.wth-code = parwth-code no-lock no-error.
      875   if available bf_wth-obj then assign parstock = bf_wth-obj.income - bf_wth-obj.incass.
      876                           else assign parstock = 0.
      877   end.
      878   FUNCTION wth-lib_cur-stock-obj-func RETURNS DECIMAL (INPUT parobj-type AS CHARACTER,
      879                                                        INPUT parobj-code AS INTEGER,
      880                                                        INPUT parwth-code AS INTEGER):
      881   define buffer bf_wth-obj for ub.wth-obj.
      882   find first bf_wth-obj where bf_wth-obj.obj-type = parobj-type and
      883                               bf_wth-obj.obj-code = parobj-code and
      884                               bf_wth-obj.wth-code = parwth-code no-lock no-error.
      885   if available bf_wth-obj then return (bf_wth-obj.income - bf_wth-obj.incass).
      886                           else return 0.00.
      887   end function.
      888   FUNCTION wth-lib_cur-stock-host-func RETURNS DECIMAL (INPUT parhost-code AS INTEGER,
      889                                                         INPUT parwth-code  AS INTEGER):
      890   define buffer bf_wth-obj for ub.wth-obj.
      891   define variable v-stock like ub.wth-obj.income no-undo.
      892   for each bf_wth-obj no-lock where bf_wth-obj.host-code = parhost-code and
      893                                     bf_wth-obj.wth-code = parwth-code :
      894     v-stock = v-stock +  bf_wth-obj.income - bf_wth-obj.incass.
      895   end.
      896   return v-stock.
      897   end function.
      898   procedure wth-lib_full-inf-shift:
      899   define input  parameter parobj-type     like ub.clients.obj-type      no-undo.        define input  parameter parobj-code     like ub.clients.obj-code      no-undo.        define input  parameter parwth-code     like ub.wth-line.wth-code     no-undo.        define input  parameter parshift-date   like ub.shift-obj.shift-date  no-undo.                        define input  parameter parshift-num    like ub.shift-obj.shift-num   no-undo.                                                              define output parameter parstock-start  like ub.wth-line.income       no-undo.        define output parameter parstock-end    like ub.wth-line.income       no-undo.        define output parameter parincome       like ub.wth-line.income       no-undo.        define output parameter parincome-cassa like ub.wth-line.income-cassa no-undo.        define output parameter parincome-other like ub.wth-line.income-other no-undo.        define output parameter parincass       like ub.wth-line.incass       no-undo.        define output parameter parincass-bank  like ub.wth-line.incass-bank  no-undo.        define output parameter parincass-other like ub.wth-line.incass-other no-undo.        define output parameter parincass-cassa like ub.wth-line.incass-cassa no-undo.        define buffer cur_wth-line   for ub.wth-line.                                         define buffer start_wth-line for ub.wth-line.                                         find last cur_wth-line where cur_wth-line.obj-type   = parobj-type   and                                        cur_wth-line.obj-code   = parobj-code   and                                                                                                       cur_wth-line.wth-code   = parwth-code   and                                        cur_wth-line.shift-date = parshift-date and                        cur_wth-line.shift-num  = parshift-num  and                                                                     cur_wth-line.status_  