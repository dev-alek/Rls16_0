      914   define input  parameter parobj-type     like ub.clients.obj-type      no-undo.        define input  parameter parobj-code     like ub.clients.obj-code      no-undo.        define input  parameter parwth-code     like ub.wth-line.wth-code     no-undo.        define input parameter parw-p-code   like ub.wth-line.w-p-code     no-undo.                        define input parameter parshift-date like ub.shift-obj.shift-date  no-undo.                                                              define output parameter parstock-start  like ub.wth-line.income       no-undo.        define output parameter parstock-end    like ub.wth-line.income       no-undo.        define output parameter parincome       like ub.wth-line.income       no-undo.        define output parameter parincome-cassa like ub.wth-line.income-cassa no-undo.        define output parameter parincome-other like ub.wth-line.income-other no-undo.        define output parameter parincass       like ub.wth-line.incass       no-undo.        define output parameter parincass-bank  like ub.wth-line.incass-bank  no-undo.        define output parameter parincass-other like ub.wth-line.incass-other no-undo.        define output parameter parincass-cassa like ub.wth-line.incass-cassa no-undo.        define buffer cur_wth-line   for ub.wth-line.                                         define buffer start_wth-line for ub.wth-line.                                         find last cur_wth-line where cur_wth-line.obj-type   = parobj-type   and                                        cur_wth-line.obj-code   = parobj-code   and                                        cur_wth-line.w-p-code   = parw-p-code and                                                               cur_wth-line.wth-code   = parwth-code   and                                        cur_wth-line.shift-date = parshift-date   and                                                                     cur_wth-line.status_    = 'факт':U       use-index                                  stat-sd-pl no-lock no-error.                     find last start_wth-line where start_wth-line.obj-type   = parobj-type         and                                start_wth-line.obj-code   = parobj-code         and                                start_wth-line.w-p-code = parw-p-code and                                                             start_wth-line.wth-code   = parwth-code         and                                start_wth-line.shift-date < parshift-date and                                                                   start_wth-line.status_ = 'факт':U                                                   use-index stat-sd-pl no-lock no-error.         if not available start_wth-line then do:                                              if not available cur_wth-line then do:                                                 assign                                                                                parstock-start   = 0                                                                  parstock-end     = 0                                                                  parincome        = 0                                                                  parincome-cassa  = 0                                                                  parincome-other  = 0                                                                  parincass        = 0                                                                  parincass-bank   = 0                                                                  parincass-other  = 0.                                                                 parincass-cassa  = 0.                                                              end.                                                                               else do:                                                                              assign parstock-start   = 0               parstock-end     = cur_wth-line.income-pl - cur_wth-line.incass-pl              parincome        = cur_wth-line.income-pl                     parincome-cassa  = cur_wth-line.income-cassa-pl               parincome-other  = cur_wth-line.income-other-pl               parincass        = cur_wth-line.incass-pl                     parincass-bank   = cur_wth-line.incass-bank-pl                parincass-other  = cur_wth-line.incass-other-pl.              parincass-cassa  = cur_wth-line.incass-cassa-pl.                                                                                       end.                                                                            end.                                                                               else do:                                                                              if available cur_wth-line then do:                                                    assign                                                                             parstock-start   = start_wth-line.income-pl     - start_wth-line.incass-pl               parstock-end     = cur_wth-line.income-pl       - cur_wth-line.incass-pl                 parincome        = cur_wth-line.income-pl       - start_wth-line.income-pl               parincome-cassa  = cur_wth-line.income-cassa-pl - start_wth-line.income-cassa-pl         parincome-other  = cur_wth-line.income-other-pl - start_wth-line.income-other-pl         parincass        = cur_wth-line.incass-pl       - start_wth-line.incass-pl               parincass-bank   = cur_wth-line.incass-bank-pl  - start_wth-line.incass-bank-pl          parincass-other  = cur_wth-line.incass-other-pl - start_wth-line.incass-other-pl.        parincass-cassa  = cur_wth-line.incass-cassa-pl - start_wth-line.incass-cassa-pl.     end.                                                                               else do:                                                                              assign                                                                             parstock-start   = start_wth-line.income-pl - start_wth-line.incass-pl                   parstock-end     = parstock-start                                                  parincome        = 0                                                               parincome-cassa  = 0                                                               parincome-other  = 0                                                               parincass        = 0                                                               parincass-bank   = 0                                                               parincass-other  = 0.                                                              parincass-cassa  = 0.                                                           end.                                                                            end.
      915   end procedure.
      916   procedure wth-lib_full-inf-calend-date:
      917   define input  parameter parobj-type     like ub.clients.obj-type      no-undo.        define input  parameter parobj-code     like ub.clients.obj-code      no-undo.        define input  parameter parwth-code     like ub.wth-line.wth-code     no-undo.        define input  parameter parfact-date    like ub.wth-line.fact-date    no-undo.                                                              define output parameter parstock-start  like ub.wth-line.income       no-undo.        define output parameter parstock-end    like ub.wth-line.income       no-undo.        define output parameter parincome       like ub.wth-line.income       no-undo.        define output parameter parincome-cassa like ub.wth-line.income-cassa no-undo.        define output parameter parincome-other like ub.wth-line.income-other no-undo.        define output parameter parincass       like ub.wth-line.incass       no-undo.        define output parameter parincass-bank  like ub.wth-line.incass-bank  no-undo.        define output parameter parincass-other like ub.wth-line.incass-other no-undo.        define output parameter parincass-cassa like ub.wth-line.incass-cassa no-undo.        define buffer cur_wth-line   for ub.wth-line.                                         define buffer start_wth-line for ub.wth-line.                                         find last cur_wth-line where cur_wth-line.obj-type   = parobj-type   and                                        cur_wth-line.obj-code   = parobj-code   and                                                                                                       cur_wth-line.wth-code   = parwth-code   and                                        cur_wth-line.fact-date  = parfact-date  and                                                                     cur_wth-line.status_    = 'факт':U       use-index                                  stat-cld no-lock no-error.                     find last start_wth-line where start_wth-line.obj-type   = parobj-type         and                                start_wth-line.obj-code   = parobj-code         and                                                                                             start_wth-line.wth-code   = parwth-code         and                                start_wth-line.fact-date  < parfact-date   and                                                                   start_wth-line.status_ = 'факт':U                                                   use-index stat-cld no-lock no-error.         if not available start_wth-line then do:                                              if not available cur_wth-line then do:                                                 assign                                                                                parstock-start   = 0                                                                  parstock-end     = 0                                                                  parincome        = 0                                                                  parincome-cassa  = 0                                                                  parincome-other  = 0                                                                  parincass        = 0                                                                  parincass-bank   = 0                                                                  parincass-other  = 0.                                                                 parincass-cassa  = 0.                                                              end.                                                                               else do:                                                                              assign parstock-start   = 0               parstock-end     = cur_wth-line.income - cur_wth-line.incass              parincome        = cur_wth-line.income                     parincome-cassa  = cur_wth-line.income-cassa               parincome-other  = cur_wth-line.income-other               parincass        = cur_wth-line.incass                     parincass-bank   = cur_wth-line.incass-bank                parincass-other  = cur_wth-line.incass-other.              parincass-cassa  = cur_wth-line.incass-cassa.                                                                                       end.                                                                            end.                                                                               else do:                                                                              if available cur_wth-line then do:                                                    assign                                                                             parstock-start   = start_wth-line.income     - start_wth-line.incass               parstock-end     = cur_wth-line.income       - cur_wth-line.incass                 parincome        = cur_wth-line.income       - start_wth-line.income               parincome-cassa  = cur_wth-line.income-cassa - start_wth-line.income-cassa         parincome-other  = cur_wth-line.income-other - start_wth-line.income-other         parincass        = cur_wth-line.incass       - start_wth-line.incass               parincass-bank   = cur_wth-line.incass-bank  - start_wth-line.incass-bank          parincass-other  = cur_wth-line.incass-other - start_wth-line.incass-other.        parincass-cassa  = cur_wth-line.incass-cassa - start_wth-line.incass-cassa.     end.                                                                               else do:                                                                              assign                                                                             parstock-start   = start_wth-line.income - start_wth-line.incass                   parstock-end     = parstock-start                                                  parincome        = 0                                                               parincome-cassa  = 0                                                               parincome-other  = 0                                                               parincass        = 0                                                               parincass-bank   = 0                                                               parincass-other  = 0.                                                              parincass-cassa  = 0.                                                           end.                                                                            end.
      918   end procedure.
      919   procedure wth-lib_full-inf-calend-date-place:
      920   define input  parameter parobj-type     like ub.clients.obj-type      no-undo.        define input  parameter parobj-code     like ub.clients.obj-code      no-undo.        define input  parameter parwth-code     like ub.wth-line.wth-code     no-undo.        define input parameter parw-p-code  like ub.wth-line.w-p-code  no-undo.                        define input parameter parfact-date like ub.wth-line.fact-date no-undo.                                                              define output parameter parstock-start  like ub.wth-line.income       no-undo.        define output parameter parstock-end    like ub.wth-line.income       no-undo.        define output parameter parincome       like ub.wth-line.income       no-undo.        define output parameter parincome-cassa like ub.wth-line.income-cassa no-undo.        define output parameter parincome-other like ub.wth-line.income-other no-undo.        define output parameter parincass       like ub.wth-line.incass       no-undo.        define output parameter parincass-bank  like ub.wth-line.incass-bank  no-undo.        define output parameter parincass-other like ub.wth-line.incass-other no-undo.        define output parameter parincass-cassa like ub.wth-line.incass-cassa no-undo.        define buffer cur_wth-line   for ub.wth-line.                                         define buffer start_wth-line for ub.wth-line.                                         find last cur_wth-line where cur_wth-line.obj-type   = parobj-type   and                                        cur_wth-line.obj-code   = parobj-code   and                                        cur_wth-line.w-p-code   = parw-p-code and                                                               cur_wth-line.wth-code   = parwth-code   and                                        cur_wth-line.fact-date  = parfact-date  and                                                                     cur_wth-line.status_    = 'факт':U       use-index                                  stat-cld-pl no-lock no-error.                     find last start_wth-line where start_wth-line.obj-type   = parobj-type         and                                start_wth-line.obj-code   = parobj-code         and                                start_wth-line.w-p-code = parw-p-code and                                                             start_wth-line.wth-code   = parwth-code         and                                start_wth-line.fact-date  < parfact-date   and                                                                   start_wth-line.status_ = 'факт':U                                                   use-index stat-cld-pl no-lock no-error.         if not available start_wth-line then do:                                              if not available cur_wth-line then do:                                                 assign                                                                                parstock-start   = 0                                                                  parstock-end     = 0                                                                  parincome        = 0                                                                  parincome-cassa  = 0                                                                  parincome-other  = 0                                                                  parincass        = 0                                                                  parincass-bank   = 0                                                                  parincass-other  = 0.                                                                 parincass-cassa  = 0.                                                              end.                                                                               else do:                                                                              assign parstock-start   = 0               parstock-end     = cur_wth-line.income-pl - cur_wth-line.incass-pl              parincome        = cur_wth-line.income-pl                     parincome-cassa  = cur_wth-line.income-cassa-pl               parincome-other  = cur_wth-line.income-other-pl               parincass        = cur_wth-line.incass-pl                     parincass-bank   = cur_wth-line.incass-bank-pl                parincass-other  = cur_wth-line.incass-other-pl.              parincass-cassa  = cur_wth-line.incass-cassa-pl.                                                                                       end.                                                                            end.                                                                               else do:                                                                              if available cur_wth-line then do:                                                    assign                                                                             parstock-start   = start_wth-line.income-pl     - start_wth-line.incass-pl               parstock-end     = cur_wth-line.income-pl       - cur_wth-line.incass-pl                 parincome        = cur_wth-line.income-pl       - start_wth-line.income-pl               parincome-cassa  = cur_wth-line.income-cassa-pl - start_wth-line.income-cassa-pl         parincome-other  = cur_wth-line.income-other-pl - start_wth-line.income-other-pl         parincass        = cur_wth-line.incass-pl       - start_wth-line.incass-pl               parincass-bank   = cur_wth-line.incass-bank-pl  - start_wth-line.incass-bank-pl          parincass-other  = cur_wth-line.incass-other-pl - start_wth-line.incass-other-pl.        parincass-cassa  = cur_wth-line.incass-cassa-pl - start_wth-line.incass-cassa-pl.     end.                                                                               else do:                                                                              assign                                                                             parstock-start   = start_wth-line.income-pl - start_wth-line.incass-pl                   parstock-end     = parstock-start                                                  parincome        = 0                                                               parincome-cassa  = 0                                                               parincome-other  = 0                                                               parincass        = 0                                                               parincass-bank   = 0                                                               parincass-other  = 0.                                                              parincass-cassa  = 0.                                                           end.                                                                            end.
      921   end procedure.
      922   FUNCTION get-curr RETURNS CHARACTER
      923     (buffer loc-wealth for ub.wealth ) :
      924   define buffer buf_currency for ub.currency.
      925   if loc-wealth.curr-code = ? or loc-wealth.is-money = no then
      926   return loc-wealth.unit-base.
      927   FIND FIRST buf_currency no-lock where
      928             buf_currency.curr-code = loc-wealth.curr-code No-ERROR.
      929   if avail buf_currency then
      930     RETURN buf_currency.curr-abbr.
      931   else return "".
      932   END FUNCTION.
      933   define variable var-stock like ub.wth-pobj.income-pl no-undo .
      934   define variable v-rid as recid no-undo .
      935   define variable v-value as character no-undo .
      936   define variable v-type as character no-undo .
      937   define variable v-entry as integer no-undo .
      938   define variable v-host-code like ub.sysconf.host-code  no-undo .
      939   DEFINE VARIABLE parstock like ub.wth-pobj.income-pl no-undo .
      940   define variable l-shift-on as logical no-undo.
      941   define variable v-shift-date as date no-undo.
      942   define variable v-shift-num as integer no-undo.
      943   define variable v-shift-name as character no-undo.
      944   define variable v-log-del as logical no-undo .
      945   define variable v-cd-list as character no-undo .
      946   define variable cas-shft as logical no-undo .
      947   define variable glog as logical no-undo .
      948   define variable v-param-type as character no-undo .
      949   define variable v-value-character as character no-undo .
      950   define variable v-value-date as date no-undo .
      951   define variable v-value-decimal as decimal no-undo .
      952   define variable v-value-integer as INTEGER no-undo .
      953   define variable v-value-logical AS LOGICAL no-undo .
      954   define variable v-tth as handle no-undo .
      955   define buffer buf_cash-desk  for ub.cash-desk.
      956   define buffer buf_cash-pay-attr for ub.cash-pay-attr.
      957   define buffer buf_shift-cash for ub.shift-cash.
      958   define buffer buf_chk-doc for ub.chk-doc.
      959   define buffer buf_inkas for ub.inkas.
      960   define buffer man_cash-desk for ub.cash-desk .
      961   define buffer mar_cash-desk for ub.cash-desk.
      962   _main:
      963   do
      964   on error undo _main, return error return-value
      965   :
      966     find first buf_cash-desk exclusive-lock where
      967                 recid(buf_cash-desk) = p-doc-rec No-ERROR.
      968     if not avail buf_cash-desk then return error substitute("Не найдена касса с recid &1", p-doc-rec).
      969     for each buf_chk-doc no-lock where
      970             buf_chk-doc.obj-type = 'маг':U
      971         AND buf_chk-doc.obj-code = buf_cash-desk.obj-code
      972         and buf_chk-doc.out-code = ?
      973         and buf_chk-doc.pay-desk = buf_cash-desk.cash-num:
      974       undo _main, return error substitute("На объекте &1 имеются чеки по кассе, не привязанные к продаже&2Удалить кассу &3 маг &1 &4 невозможно"
      975                       ,buf_cash-desk.obj-code
      976                       , chr(10)
      977                       , buf_cash-desk.cash-num
      978                       , buf_cash-desk.pos-type).
      979     end.
      980     for each buf_inkas no-lock where
      981             buf_inkas.obj-type = 'маг':U
      982         and buf_inkas.obj-code = buf_cash-desk.obj-code,
      983        first buf_chk-doc no-lock where
      984             buf_chk-doc.obj-type = 'маг':U
      985         AND buf_chk-doc.obj-code = buf_cash-desk.obj-code
      986         and buf_chk-doc.out-code = buf_inkas.inkas-code
      987         and buf_chk-doc.pay-desk = buf_cash-desk.cash-num
      988      break
      989      by buf_inkas.obj-type
      990      by buf_inkas.obj-code
      991      by buf_inkas.status_:
      992       if first-of(buf_inkas.status_) then do:
      993         if buf_inkas.status_ <> 'факт':U
      994         and buf_inkas.status_ <> 'запрос':U then do:
      995           undo _main, return error substitute("На объекте &1 имеются чеки по кассе, привязанные к незакрытой продаже&2Удалить кассу &3 маг &1 &4 невозможно"
      996                           ,buf_cash-desk.obj-code
      997                           , chr(10)
      998                           , buf_cash-desk.cash-num
      999                           , buf_cash-desk.pos-type).
     1000         end.
     1001       end.
     1002     end.
     1003   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1004   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1005     (input  'маг':U
     1006     ,input  buf_cash-desk.obj-code
     1007     ,input  'shift-on=request'
     1008     ,output l-shift-on
     1009     )  .
     1010   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1011   define variable v-param-type5 as character no-undo .
     1012   define variable v-value-character5 as character no-undo .
     1013   define variable v-value-date5 as date no-undo .
     1014   define variable v-value-decimal5 as decimal no-undo .
     1015   define variable v-value-integer5 as INTEGER no-undo .
     1016   define variable v-tth5 as handle no-undo .
     1017   run adm/shattri.p (
     1018       input "get":U
     1019       ,input  'маг':U
     1020       ,input  buf_cash-desk.obj-code
     1021       ,input  'get-chk':U
     1022       ,input  'cas-shft':U
     1023       ,output v-value-character5
     1024       ,output v-value-date5
     1025       ,output v-value-decimal5
     1026       ,output v-value-integer5
     1027       ,output cas-shft
     1028       ,output v-param-type5
     1029       ,INPUT-OUTPUT table-handle v-tth5
     1030       )  .
     1031   delete object v-tth5.
     1032     if cas-shft then do:
     1033       find last buf_shift-cash No-LOCK WHERE
     1034                         buf_shift-cash.obj-type = 'маг':U AND
     1035                         buf_shift-cash.obj-code = buf_cash-desk.obj-code AND
     1036                         buf_shift-cash.cash-num = buf_cash-desk.cash-num  no-error .
     1037       if available buf_shift-cash
     1038       and  buf_shift-cash.status_ <> 'зкр':U  then do:
     1039         undo _main, return error substitute("Последняя смена по кассе НЕ ЗАКРЫТА&2Удалить кассу &3 маг &1 &4 невозможно"
     1040                         ,buf_cash-desk.obj-code
     1041                         , chr(10)
     1042                         , buf_cash-desk.cash-num
     1043                         , buf_cash-desk.pos-type).
     1044       end.
     1045     end.
     1046     if l-shift-on then do:
     1047   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1048   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curshift in g#library
     1049     (input  'маг':U
     1050     ,input  buf_cash-desk.obj-code
     1051     ,output v-shift-date
     1052     ,output v-shift-num
     1053     ,output v-shift-name
     1054     ) no-error .
     1055       if not error-status:error and v-shift-num > 0 then do:
     1056          undo _main, return error substitute("На объекте &1 открыта смена&2Удалить кассу &3 маг &1 &4 невозможно"
     1057                           ,buf_cash-desk.obj-code
     1058                           , chr(10)
     1059                           , buf_cash-desk.cash-num
     1060                           , buf_cash-desk.pos-type).
     1061       end.
     1062     end.
     1063     if buf_cash-desk.is-del = no then do:
     1064       find first ub.wth-place No-LOCK WHERE
     1065                   ub.wth-place.obj-type = 'маг':U AND
     1066                   ub.wth-place.obj-code = buf_cash-desk.obj-code AND
     1067                   ub.wth-place.cash-desk = buf_cash-desk.cash-num No-ERROR.
     1068       if avail ub.wth-place then do:
     1069         find first ub.wth-line No-LOCK WHERE
     1070                   ub.wth-line.obj-type = 'маг':U and
     1071                   ub.wth-line.obj-code = buf_cash-desk.obj-code and
     1072                   ub.wth-line.w-p-code = wth-place.w-p-code No-ERROR.
     1073         if avail ub.wth-line then do:
     1074           message
     1075           substitute("Нельзя удалить кассу &1 маг &2 &3- по МХ МЦ, привязанному к данной кассе&4" +
     1076                                     "есть движение МЦ&4"  +
     1077                                     "Касса будет помечена, как удаленная логически"
     1078                                     , buf_cash-desk.cash-num
     1079                                     , buf_cash-desk.obj-code
     1080                                     , buf_Cash-desk.pos-type
     1081                                     , chr(10) )
     1082           view-as alert-box QUESTION buttons YES-NO update v-log-del.
     1083           if not v-log-del then undo _main, return.
     1084         end.
     1085       end.
     1086     end.
     1087     if buf_cash-desk.is-del = yes then do:
     1088       if  cas-shft
     1089       then
     1090          find first buf_shift-cash No-LOCK WHERE
     1091               buf_shift-cash.cash-num = buf_cash-desk.cash-num AND
     1092               buf_shift-cash.obj-code = buf_cash-desk.obj-code AND
     1093               buf_shift-cash.obj-type = 'маг':U no-error .
     1094       if cas-shft and available buf_shift-cash
     1095       then do:
     1096          message
     1097             substitute("Касса &1 помечена как удаленная и на ней есть смены. Хотите востановить кассу ?"
     1098                   , buf_cash-desk.cash-num
     1099                   , chr(10)
     1100                   )
     1101          view-as alert-box QUESTION buttons YES-NO update glog.
     1102          if not glog then undo _main, return .
     1103       end.
     1104       else if available buf_shift-cash then do:
     1105          message
     1106             substitute("Вы действительно хотите ОКОНЧАТЕЛЬНО удалить кассу &1?&2(Данная касса уже ЛОГИЧЕСКИ удалена)"
     1107                   , buf_cash-desk.cash-num
     1108                   , chr(10)
     1109                   )
     1110             view-as alert-box QUESTION buttons YES-NO update glog.
     1111          if not glog then undo _main, return .
     1112       end.
     1113     end.
     1114     for each ub.wth-pobj No-LOCK WHERE
     1115               ub.wth-pobj.obj-type = 'маг':U AND
     1116               ub.wth-pobj.obj-code = buf_cash-desk.obj-code AND
     1117               ub.wth-pobj.w-p-code = wth-place.w-p-code
     1118               :
     1119       run wth-lib_cur-stock-place in this-procedure (
     1120                                                         input 'маг':U
     1121                                                       ,input buf_cash-desk.obj-code
     1122                                                       ,input wth-place.w-p-code
     1123                                                       ,input ub.wth-pobj.wth-code
     1124                                                       ,output var-stock) no-error .
     1125       if var-stock <> 0 then do:
     1126         message
     1127         substitute("&1&2" +
     1128                     "Нельзя удалить кассу &3 маг &4 &5&2" +
     1129                     "было движение по соответствующему МХ МЦ или остаток МЦ с кодом &6 на нем <> 0&2" +
     1130                     "Касса будет помечена, как удаленная логически"
     1131                     , substitute("&1 &2 &3", vss-workfile, vss-revision ,vss-description )
     1132                     ,chr(10)
     1133                     , buf_cash-desk.cash-num
     1134                     , buf_Cash-desk.obj-code
     1135                     , buf_Cash-desk.pos-type
     1136                     , wth-pobj.wth-code)
     1137         view-as alert-box QUESTION buttons YES-NO update v-log-del .
     1138         if not v-log-del then undo _main, return.
     1139       end.
     1140     END.
     1141     if buf_cash-desk.is-del = yes
     1142     then
     1143        v-log-del = yes.
     1144     else if cas-shft then do:
     1145       find first buf_shift-cash No-LOCK WHERE
     1146               buf_shift-cash.cash-num = buf_cash-desk.cash-num AND
     1147               buf_shift-cash.obj-code = buf_cash-desk.obj-code AND
     1148               buf_shift-cash.obj-type = 'маг':U no-error .
     1149       if available buf_shift-cash then do:
     1150         assign
     1151         v-log-del = yes.
     1152         message
     1153         substitute("Нельзя удалить кассу &1 маг &2 &3- имеются смены на данной кассе&4" +
     1154                     "Касса будет помечена, как удаленная логически"
     1155                     , buf_cash-desk.cash-num
     1156                     , buf_cash-desk.obj-code
     1157                     , buf_Cash-desk.pos-type
     1158                     , chr(10) )
     1159         view-as alert-box QUESTION buttons YES-NO update v-log-del .
     1160         if not v-log-del then undo _main, return.
     1161       end.
     1162     end.
     1163     if buf_cash-desk.pos-type = 'MARIA':U
     1164     and buf_cash-desk.autonomy = integer('2':U)
     1165     and  can-find(first ub.cash-desk where
     1166                         ub.cash-desk.obj-code = buf_cash-desk.obj-code
     1167                     and ub.cash-desk.pos-type  = buf_cash-desk.pos-type
     1168                     and ub.cash-desk.autonomy  = integer('1':U)
     1169                     and ub.cash-desk.is-del  = no
     1170                     ) then do:
     1171       message
     1172       substitute("Нельзя изменить/удалить кассовый менеджер &1&2" +
     1173                   "На объекте еще имеются подчиненные кассы этого типа"
     1174                   , 'MARIA':U
     1175                   , chr(10))
     1176       view-as alert-box error .
     1177       undo, return error ''.
     1178     end.
     1179     if v-log-del = yes
     1180     then do:
     1181         v-rid = recid(buf_cash-desk).
     1182         run ref/cashdsk1.p (
     1183                       input-output v-rid
     1184                       ,input 'ИЗМЕНЕНИЕ':U
     1185                       ,input buf_cash-desk.db-num
     1186                       ,input buf_cash-desk.obj-code
     1187                       ,input buf_cash-desk.pos-type
     1188                       ,input buf_cash-desk.cash-num
     1189                       ,input buf_cash-desk.autonomy
     1190                       ,input buf_cash-desk.addr-path
     1191                       ,input no
     1192                       ,input buf_cash-desk.cash-os
     1193                       ,input yes
     1194                       ,input buf_cash-desk.remote
     1195                       ,input buf_cash-desk.version
     1196                       ,input buf_cash-desk.registration-code
     1197                       ,input buf_cash-desk.serial-code
     1198                       ,input buf_cash-desk.fr-type
     1199                       ,input ?
     1200                       ) no-error .
     1201                       if error-status:error then do:
     1202                         undo _main, return error substitute("&1&2&3", error-status:get-message(1) , chr(10), return-value ).
     1203                       end.
     1204     end.
     1205     else do:
     1206   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1207   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1208     (input  'маг':U
     1209     ,input  buf_cash-desk.obj-code
     1210     ,output v-host-code
     1211     )  .
     1212       for each buf_cash-pay-attr no-lock where
     1213               buf_cash-pay-attr.host-code = v-host-code
     1214           AND buf_cash-pay-attr.obj-type = 'маг':U
     1215           AND buf_cash-pay-attr.obj-code = buf_cash-desk.obj-code
     1216           AND buf_cash-pay-attr.attr-code = 'is-use':U:
     1217         run cp-attr-value  in this-procedure (
     1218                                               input buf_cash-pay-attr.cdpay-code
     1219                                             , input buf_cash-pay-attr.curr-code
     1220                                             , input buf_cash-pay-attr.host-code
     1221                                             , input buf_cash-pay-attr.obj-type
     1222                                             , input buf_cash-pay-attr.obj-code
     1223                                             , input buf_cash-pay-attr.attr-code
     1224                                             , output v-value
     1225                                             , output v-type) no-error .
     1226         if not error-status:error
     1227         and v-value <> '':U then do:
     1228           assign v-entry = lookup(string(buf_cash-desk.cash-num) + chr(44) + buf_cash-desk.pos-type, v-value, chr(4) ).
     1229           if v-entry > 0 then do:
     1230             assign
     1231             entry(v-entry, v-value, chr(4)) =  '':U
     1232             v-value = replace(v-value, ( chr(4) + chr(4) ), chr(4) )
     1233             .
     1234             run  cp-attr-write  in this-procedure (
     1235                                               input buf_cash-pay-attr.cdpay-code
     1236                                             , input buf_cash-pay-attr.curr-code
     1237                                             , input buf_cash-pay-attr.host-code
     1238                                             , input buf_cash-pay-attr.obj-type
     1239                                             , input buf_cash-pay-attr.obj-code
     1240                                             , input buf_cash-pay-attr.attr-code
     1241                                             , input v-value) no-error .
     1242             if error-status:error then do:
     1243               undo _main, return error
     1244                 substitute('Ошибка при попытке обновить атрибут типа кассового платежа, использующий ссылку&1' +
     1245                           'на кассу &2 маг &3 &4&1' +
     1246                           '&5&1&6'
     1247                         , chr(10)
     1248                         , buf_cash-desk.cash-num
     1249                         , buf_cash-desk.obj-code
     1250                         , buf_cash-desk.pos-type
     1251                         , error-status:get-message(1)
     1252                         , return-value ).
     1253             end.
     1254           end.
     1255         end.
     1256       end.
     1257       if buf_cash-desk.pos-type = 'MARIA':U
     1258       and buf_cash-desk.autonomy = integer('1':U)
     1259       then do:
     1260         find first man_cash-desk exclusive-lock where
     1261                   man_cash-desk.obj-code = buf_cash-desk.obj-code
     1262               and man_cash-desk.pos-type = buf_cash-desk.pos-type
     1263               and man_cash-desk.autonomy = integer('2':U) .
     1264         for each mar_cash-desk where
     1265                 mar_cash-desk.obj-code = buf_cash-desk.obj-code
     1266               and mar_cash-desk.pos-type = buf_cash-desk.pos-type
     1267               and mar_cash-desk.autonomy = integer('1':U)
     1268               and mar_cash-desk.is-del   = no:
     1269           if mar_cash-desk.cash-num = buf_cash-desk.cash-num then next.
     1270           assign
     1271           v-cd-list = v-cd-list + (if v-cd-list = '':U then '':U else chr(44)) + string(mar_cash-desk.cash-num).
     1272         end.
     1273         man_cash-desk.addr-path = v-cd-list.
     1274       end.
     1275       run waitfram-show in this-procedure ( input "Ждите...").
     1276       if not cas-shft then do:
     1277         for each buf_shift-cash where
     1278               buf_shift-cash.cash-num = buf_cash-desk.cash-num
     1279             AND buf_shift-cash.obj-code = buf_cash-desk.obj-code
     1280             AND buf_shift-cash.obj-type = 'маг':U
     1281         on error undo _main, return error
     1282         on stop undo _main, return error :
     1283           delete buf_shift-cash.
     1284         end.
     1285       end.
     1286       run waitfram-hide in this-procedure .
     1287       delete buf_cash-desk no-error .
     1288       if error-status:error then undo _main,
     1289       return error substitute("&1&2&3", error-status:get-message(1) , chr(10), return-value ).
     1290     end.
     1291   end.
