     1371   define variable log-file-name as character no-undo init "process-thref.txt".
     1372   define variable v-save-int as integer no-undo .
     1373   define variable v-charkey_one as character no-undo .
     1374   define variable v-charkey_one-2 as character no-undo .
     1375   define variable v-num-dc as integer no-undo .
     1376   define variable v-is-empty as logical no-undo .
     1377   define variable v-rec-ord_ as integer no-undo .
     1378   define variable v-param-name as character no-undo .
     1379   define variable v-xsd-file as character no-undo .
     1380   define variable v-cont-handle as handle no-undo .
     1381   define buffer buf_rule-by-call for ub.rule-by-call.
     1382   define buffer buf_temp-pers-proc  for temp-pers-proc.
     1383   define buffer buf_db for ub.db.
     1384   define buffer buf_sysconf for ub.sysconf.
     1385   define buffer buf_rule-call-param for ub.rule-call-param.
     1386   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1387   def var vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1388   define NEW SHARED temp-table temp-cmd no-undo
     1389   field cmd-code as integer
     1390   field db-list as character
     1391   index pi is unique primary
     1392   db-list
     1393   index icmd
     1394   cmd-code
     1395   .
     1396   define NEW SHARED temp-table temp-smart-route no-undo
     1397   field key-field as character
     1398   field db-num as integer
     1399   index pi is unique primary
     1400   key-field
     1401   db-num
     1402   .
     1403   define NEW SHARED temp-table temp-no-route no-undo
     1404   field rec-ord as integer
     1405   field db-num as integer
     1406   index pi is unique primary
     1407   db-num
     1408   rec-ord
     1409   index iro
     1410   rec-ord
     1411   .
     1412   define NEW SHARED temp-table temp-smart-link no-undo
     1413   field uniq-key-rec as character
     1414   field key-field as character
     1415   field rec-ord as integer
     1416   field is-smart as logical
     1417   index pi is unique primary
     1418   key-field
     1419   uniq-key-rec
     1420   rec-ord
     1421   index iu
     1422   uniq-key-rec
     1423   index iro
     1424   rec-ord
     1425   .
     1426   define NEW SHARED temp-table temp-nws-outline no-undo
     1427   like ub.nws-outline.
     1428   procedure create-smart-route :
     1429   define input parameter p-key-field as character no-undo .
     1430   define input parameter p-db-num as integer no-undo .
     1431   define buffer buf_temp-smart-route for temp-smart-route.
     1432     do
     1433     on error undo, return error
     1434     :
     1435       find first buf_temp-smart-route where
     1436                 buf_temp-smart-route.key-field = p-key-field
     1437             and buf_temp-smart-route.db-num = p-db-num no-error.
     1438       if not available buf_temp-smart-route then do:
     1439         create buf_temp-smart-route.
     1440         assign
     1441         buf_temp-smart-route.key-field = p-key-field
     1442         buf_temp-smart-route.db-num = p-db-num
     1443         .
     1444       end.
     1445     end.
     1446   end procedure.
     1447   procedure create-smart-route-link :
     1448   define input parameter p-tbl-name as character no-undo .
     1449   define input parameter p-bh_tbl-name as handle no-undo .
     1450   define input parameter p-key-field as character no-undo .
     1451   define input parameter p-rec-ord as integer no-undo .
     1452   define input parameter p-is-smart as logical no-undo .
     1453   define variable v-key-rec as character no-undo .
     1454   define buffer buf_temp-smart-link for temp-smart-link.
     1455     do
     1456     on error undo, return error
     1457     :
     1458       run gen-key-rec in this-procedure ( input p-tbl-name
     1459                                          ,input p-bh_tbl-name
     1460                                          ,output v-key-rec     ).
     1461      find first buf_temp-smart-link where
     1462                 buf_temp-smart-link.uniq-key-rec = v-key-rec
     1463              and buf_temp-smart-link.key-field = p-key-field
     1464              and buf_temp-smart-link.rec-ord = p-rec-ord
     1465              no-error .
     1466      if not available buf_temp-smart-link then do:
     1467        create buf_temp-smart-link.
     1468        assign
     1469        buf_temp-smart-link.uniq-key-rec = v-key-rec
     1470        buf_temp-smart-link.key-field = p-key-field
     1471        buf_temp-smart-link.rec-ord = p-rec-ord
     1472        buf_temp-smart-link.is-smart = p-is-smart
     1473        .
     1474      end.
     1475     end.
     1476   end procedure.
     1477   procedure create-nws-outline :
     1478   define input parameter p-cmd-proc-handle as handle no-undo .
     1479   define input parameter p-cmd-code as integer no-undo .
     1480   define input parameter p-outline-type as character no-undo .
     1481   define input parameter p-charkey_one as character no-undo .
     1482   define input parameter p-charkey_two as character no-undo .
     1483   define input parameter p-charkey_three as character no-undo .
     1484   define input parameter p-key#_one as integer no-undo .
     1485   define input parameter p-key#_two as integer no-undo .
     1486   define input parameter p-key#_three as integer no-undo .
     1487   define variable v-no-id as integer no-undo .
     1488   define variable v-rec-ord as integer no-undo .
     1489     do
     1490     on error undo, return error return-value
     1491     :
     1492       find last temp-nws-outline use-index pi no-error .
     1493       v-no-id = (if available temp-nws-outline
     1494                  then (temp-nws-outline.no-id  + 1)
     1495                  else 1).
     1496       create temp-nws-outline.
     1497       assign
     1498       temp-nws-outline.charkeY_one = p-charkey_one
     1499       temp-nws-outline.charkeY_two = p-charkey_two
     1500       temp-nws-outline.charkeY_three = p-charkey_three
     1501       temp-nws-outline.key#_one = p-key#_one
     1502       temp-nws-outline.key#_two = p-key#_two
     1503       temp-nws-outline.key#_three = p-key#_three
     1504       temp-nws-outline.no-id = v-no-id
     1505       temp-nws-outline.outline-type = p-outline-type
     1506       .
     1507                                   run add-dump in p-cmd-proc-handle                                                                           (input p-cmd-code                                                                                         ,input 'nws-outline':U                                                                                          ,input '+update'                                                                                         ,input (buffer temp-nws-outline:handle)                                                                                    ,input ''                                                                                         ,output v-rec-ord                                                                                         ) no-error .                                                                                               if error-status :error                                                                                       then do:                                                                                                     delete procedure p-cmd-proc-handle .                                                                        undo , return error substitute("&1 &2 &3&4Ошибка при добавлении записи &5 в команду с кодом &6&4&8&4&9&4"                                       ,vss-workfile                                                                                                ,vss-revision                                                                                                ,vss-description                                                                                             ,chr(10)                                                                                               ,'nws-outline':U                                                                                                ,p-cmd-code                                                                                               ,error-status:get-message(1)                                                                                 ,return-value                                                                                                ) .                                                                    end.
     1508       run  create-smart-route in this-procedure (
     1509                                                   input ('nws-outline':U + chr(4) + string(temp-nws-outline.no-id))
     1510                                                  ,input -1).
     1511       run create-smart-route-link in this-procedure (
     1512                                                      input 'nws-outline':U
     1513                                                     ,input (buffer temp-nws-outline:handle)
     1514                                                     ,input ('nws-outline':U + chr(4) + string(temp-nws-outline.no-id))
     1515                                                     ,input v-rec-ord
     1516                                                     ,input no
     1517                                                     ).
     1518     end.
     1519   end procedure.
     1520   procedure create-no-route :
     1521   define input parameter p-rec-ord as integer no-undo .
     1522   define input parameter p-db-num as integer no-undo .
     1523   define buffer buf_temp-no-route for temp-no-route.
     1524   do
     1525   on error undo, return error
     1526   :
     1527      find first buf_temp-no-route where
     1528                 buf_temp-no-route.rec-ord = p-rec-ord
     1529              and buf_temp-no-route.db-num = p-db-num no-error .
     1530      if not available buf_temp-no-route then do:
     1531        create buf_temp-no-route.
     1532        assign
     1533        buf_temp-no-route.rec-ord = p-rec-ord
     1534        buf_temp-no-route.db-num = p-db-num
     1535        .
     1536      end.
     1537   end.
     1538   end procedure.
     1539   procedure clear-from-rec-ord :
     1540   define input parameter p-rec-ord as integer no-undo .
     1541   define buffer buf_temp-no-route for temp-no-route.
     1542   define buffer buf_temp-smart-link for temp-smart-link.
     1543   do
     1544   on error undo, return error
     1545   :
     1546   for each buf_temp-no-route where
     1547           buf_temp-no-route.rec-ord > p-rec-ord:
     1548     delete buf_temp-no-route.
     1549   end.
     1550   for each buf_temp-smart-link where
     1551           buf_temp-smart-link.rec-ord > p-rec-ord:
     1552      delete buf_temp-smart-link.
     1553   end.
     1554   end.
     1555   end procedure.
     1556   define buffer buf_temp-cmd  for temp-cmd.
     1557   define buffer buf1_temp-cmd  for temp-cmd.
     1558   define buffer buf_temp-smart-route  for temp-smart-route.
     1559   define buffer buf_temp-smart-link  for temp-smart-link.
     1560   define buffer buf_temp-nws-outline for temp-nws-outline.
     1561   define buffer buf_temp-no-route for temp-no-route.
     1562   if transaction
     1563   and p-process = 'xml-esys-import':U
     1564   then do:
     1565     message
     1566       vss-workfile vss-revision vss-description skip
     1567       substitute("Вызов процедуры в действующей транзакции недопустим") skip
     1568       view-as alert-box error .
     1569     return error substitute( "&1. Вызов процедуры в действующей транзакции недопустим", vss-workfile ) .
     1570   end.
     1571   _main:
     1572   do
     1573   on error  undo _main, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1574   on stop   undo _main, return error substitute( "&1. stop", vss-workfile )
     1575   on endkey undo _main, return error substitute( "&1. endkey", vss-workfile )
     1576   :
     1577   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1578   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1579     (output v-curr-r-b
     1580     )  .
     1581     if not p-save
     1582           then do:
     1583       message
     1584       substitute("Неверное значение параметра p-save = &1,&2" +
     1585                  "в ситуации когда p-process = &3"
     1586                  , p-save
     1587                  , chr(10)
     1588                  , p-process)
     1589       view-as alert-box error .
     1590       undo _main, return error .
     1591     end.
     1592     v-save-int = (if p-save
     1593                   then 0
     1594                   else -1).
     1595     CASE p-process:
     1596       when 'batchwork-export':U
     1597       or
     1598       when 'batchwork-routing':U
     1599       or when "recipe-xml-file-import":U
     1600       then do:
     1601         if not g#auto then do:
     1602   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1603     run mainmenu_getcntxt in parparentproc
     1604       (output v-cntxt-db-num
     1605       ,output v-cntxt-userid
     1606       ,output v-cntxt-level
     1607       ,output v-cntxt-host-code-obj
     1608       ,output v-cntxt-obj-type
     1609       ,output v-cntxt-obj-code
     1610       ,output v-cntxt-db-num-obj
     1611       ,output v-cntxt-is-admin
     1612       ) .
     1613         end.
     1614         run cur-time in this-procedure ( output v-today, output v-time).
     1615         assign
     1616         v-obj-type = v-cntxt-obj-type
     1617         v-obj-code = v-cntxt-obj-code
     1618         v-host-code = v-cntxt-host-code-obj
     1619         v-doc-date = v-today
     1620         v-fact-date = v-today
     1621         v-doc-code = entry(1, p-doc-code, chr(4))
     1622         v-process-file-name =  entry(2, p-doc-code, chr(4))
     1623         v-profile-id = p-profile-id
     1624         .
     1625         assign
     1626         v-codex-id-list = string(p-codex-id)
     1627         v-ruleset-id-list[1] = string(p-ruleset-id)
     1628         v-ruleset-id-list[2] = ''
     1629         .
     1630       end.
     1631       when 'xml-esys-import':U then do:
     1632         run cur-time in this-procedure ( output v-today, output v-time).
     1633         assign
     1634         v-obj-type = v-cntxt-obj-type
     1635         v-obj-code = v-cntxt-obj-code
     1636         v-host-code = v-cntxt-host-code-obj
     1637         v-doc-date = v-today
     1638         v-fact-date = v-today
     1639         v-doc-code = entry(1, p-doc-code, chr(4))
     1640         v-process-file-name =  entry(2, p-doc-code, chr(4)) +
     1641                                 chr(4) + entry(3, p-doc-code, chr(4))
     1642                                 + chr(4) + entry(4, p-doc-code, chr(4))
     1643                                 + chr(4) + entry(5, p-doc-code, chr(4))
     1644         v-profile-id = p-profile-id
     1645         v-cont-handle = p-parent-handle
     1646         v-param-name = entry(6, p-doc-code, chr(4))
     1647         v-xsd-file = entry(7, p-doc-code, chr(4))
     1648         .
     1649         assign
     1650         v-codex-id-list = string(p-codex-id)
     1651         v-ruleset-id-list[1] = string(p-ruleset-id)
     1652         v-ruleset-id-list[2] = ''
     1653         .
     1654       end.
     1655     END CASE.
     1656     _codex:
     1657     do v-jj = 1 to num-entries(v-codex-id-list):
     1658       if entry(v-jj, v-codex-id-list) = '':U then next _codex.
     1659       v-codex-id = integer(entry(v-jj, v-codex-id-list)).
     1660       do v-ii = 1 to num-entries(v-ruleset-id-list[v-jj]):
     1661           if entry(v-ii, v-ruleset-id-list[v-jj]) = '':U then next.
     1662           v-ruleset-id = integer(entry(v-ii, v-ruleset-id-list[v-jj])).
     1663         _rule-by-call:
     1664         for each buf_rule-by-call no-lock where
     1665                   buf_rule-by-call.call_id = p-uniq-key-rec
     1666             and buf_rule-by-call.can-calc = yes
     1667             and buf_rule-by-call.codex_id = v-codex-id
     1668             and buf_rule-by-call.ruleset_id = v-ruleset-id
     1669         by buf_rule-by-call.call_Id
     1670         by buf_rule-by-call.codex_id
     1671         by buf_rule-by-call.ruleset_id
     1672         by buf_rule-by-call.order_id
     1673         on error  undo _main, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1674         on stop   undo _main, return error substitute( "&1. stop", vss-workfile )
     1675         on endkey undo _main, return error substitute( "&1. endkey", vss-workfile ) :
     1676           if p-process = 'xml-esys-import':U
     1677           and buf_rule-by-call.ruleset_id = 4
     1678           then do:
     1679             find first buf_rule-call-param no-lock where
     1680                       buf_rule-call-param.call_id = buf_rule-by-call.call_id
     1681                   and buf_rule-call-param.codex_id = buf_rule-by-call.codex_id
     1682                   and buf_rule-call-param.ruleset_id = buf_rule-by-call.ruleset_id
     1683                   and buf_rule-call-param.order_id = buf_rule-by-call.order_id
     1684                   and buf_rule-call-param.param-name = v-param-name
     1685                   and buf_rule-call-param.param-value-character = v-xsd-file no-error.
     1686             if not available buf_rule-call-param then next _rule-by-call.
     1687           end.
     1688           v-proc-name = "rul/" + string(buf_rule-by-call.rule_id, '999999999') + '.p'.
     1689           run value(v-proc-name)  (
     1690                                                                 input parparentproc
     1691                                                               ,input this-procedure:handle
     1692                                                               ,input p-log-handle
     1693                                                               ,input v-cont-handle
     1694                                                               ,input v-codex-id
     1695                                                               ,input v-ruleset-id
     1696                                                               ,input buf_rule-by-call.call_id
     1697                                                               ,input buf_rule-by-call.order_id
     1698                                                               ,input buf_rule-by-call.rule_id
     1699                                                               ,input buf_rule-by-call.profile
     1700                                                               ,input buf_rule-by-call.is_dynamic
     1701                                                               ,input v-doc-type
     1702                                                               ,input v-host-code
     1703                                                               ,input v-obj-type
     1704                                                               ,input v-obj-code
     1705                                                               ,input v-doc-code
     1706                                                               ,input v-process-file-name
     1707                                                               ,input v-save-int
     1708                                                               ,input v-curr-r-b
     1709                                                               ,input v-cmd-proc-handle
     1710                                                               ,input 0
     1711                                                               ) .
     1712           if v-stop-leave-status > '' then do:
     1713             undo _main, return error substitute("&1&2Процесс обработки данных справочников&2" +
     1714                                                 "&3&2&4"
     1715                                                 ,vss-workfile
     1716                                                 ,chr(10)
     1717                                                 , error-status:get-message(1)
     1718                                                 , return-value
     1719                                                   ).
     1720           end.
     1721         end.
     1722       end.
     1723     end.
     1724   end.
     1725   procedure set-num-rec :
     1726   define input parameter p-num-rec as integer no-undo .
     1727   define input parameter p-num-rec-calc-err as integer no-undo .
     1728   define input parameter p-num-rec-value-err as integer no-undo .
     1729   define input parameter p-num-rec-ok as integer no-undo .
     1730   define input parameter p-display as logical no-undo .
     1731   define variable v-ok as logical no-undo .
     1732   do
     1733   on error undo, return error
     1734   :
     1735     if not (p-process = 'batch-card-recalc':U) then do:
     1736       return.
     1737     end.
     1738     run set-num-rec in p-parent-handle ( input p-num-rec
     1739                                         ,input p-num-rec-calc-err
     1740                                         ,input p-num-rec-value-err
     1741                                         ,input p-num-rec-ok
     1742                                         ,buffer buf_rule-by-call
     1743                                         ,input p-display
     1744                                         ).
     1745   end.
     1746   end procedure.
     1747   procedure set-stop-leave-status :
     1748   define input parameter p-stop-leave-status as character no-undo .
     1749   do
     1750   on error undo, return error
     1751   :
     1752     assign
     1753     v-stop-leave-status = p-stop-leave-status.
     1754   end.
     1755   end procedure.
