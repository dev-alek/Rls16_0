     1350   define variable v-fact-date as date no-undo .
     1351   define variable v-curr-r-b as character no-undo .
     1352   define variable v-id as integer no-undo .
     1353   define variable v-proc-handle as handle no-undo .
     1354   define variable v-proc-name as character no-undo .
     1355   define variable v-ruleset-id as integer no-undo .
     1356   define variable v-ruleset-id-list as character no-undo extent 3.
     1357   define variable v-codex-id as integer no-undo .
     1358   define variable v-codex-in-db as integer no-undo .
     1359   define variable v-ii as integer no-undo .
     1360   define variable v-jj as integer no-undo .
     1361   define variable sign as integer no-undo .
     1362   define variable v-codex-id-list as character no-undo .
     1363   DEFINE VARIABLE v-today as date no-undo .
     1364   DEFINE VARIABLE v-time as integer no-undo .
     1365   define variable v-calc-chr as character no-undo .
     1366   define variable v-can-run as logical no-undo .
     1367   define variable v-doc-code as character no-undo .
     1368   define variable v-doc-type as character no-undo .
     1369   define variable v-process-file-name as character no-undo .
