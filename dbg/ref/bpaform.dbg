        1   block-level on error undo, throw.
        2   define input  parameter iChange as character no-undo.
        3   define input  parameter i-id as integer  no-undo.
        4       define variable v-listact-brw as class ibs.th.ref.bpa.BPA_form no-undo .
        5       v-listact-brw = new ibs.th.ref.bpa.BPA_form ( iChange, i-id
        6         ).
        7       subscribe   to "getNextseq"     anywhere run-procedure "local-getNextseq".
        8       wait-for  v-listact-brw:ShowDialog() .
        9       unsubscribe to "getNextseq".
       10    define variable mSeqSave as integer no-undo init ?.
       11     procedure local-getNextseq:
       12        define input  parameter iseqnamehist    as character no-undo.
       13        define input  parameter idb-name_schema as character no-undo.
       14        define output parameter oSeq            as int64 no-undo.
       15        if iseqnamehist ne "s-c-operserv-chip-num"
       16        then
       17           oSeq = ?.
       18        else if mSeqSave = ?
       19        then
       20           assign
       21              mSeqSave = dynamic-next-value (iseqnamehist, idb-name_schema)
       22              oSeq     = mSeqSave
       23           .
       24        else
       25           oSeq = mSeqSave.
       26    end.
       27    define variable v-err-msg as character no-undo .
       28    catch exAppErrors as class Progress.Lang.AppError :
       29      v-err-msg = exAppErrors:ReturnValue .
       30      if v-err-msg > "" then .
       31      else
       32      do :
       33        v-err-msg = exAppErrors:GetMessage(1) .
       34        if v-err-msg > "" then .
       35        else v-err-msg = "AppError в модуле c:\tester\Rls_16_0\rc_160_rus\cmpdir\src\ref\bpaform.p" .
       36      end .
       37      message v-err-msg  view-as alert-box.
       38    end catch .
       39    catch exProErrors as class Progress.Lang.ProError :
       40      v-err-msg = exProErrors:GetMessage(1) .
       41      if v-err-msg > "" then .
       42      else v-err-msg = "ProError в модуле c:\tester\Rls_16_0\rc_160_rus\cmpdir\src\ref\bpaform.p" .
       43      message "ProError" skip(1) v-err-msg  view-as alert-box.
       44    end catch .
       45    catch exAnyErrors as class Progress.Lang.Error:
       46      v-err-msg = "Unexpected error в модуле c:\tester\Rls_16_0\rc_160_rus\cmpdir\src\ref\bpaform.p " + exAnyErrors:GetMessage(1).
       47      message "LangError" skip(1) v-err-msg  view-as alert-box.
       48    end catch .
       49    finally:
       50      if valid-object(v-listact-brw) then delete object v-listact-brw no-error .
       51    end finally.
