        1   block-level on error undo, throw.
        2   define input  parameter p-new as logical   no-undo .
        3   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        4   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        5   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile: chg-amin.p $":U .
        7   define variable vss-archive     as character no-undo init "$Archive: ref/chg-amin.p $":U .
        8   define variable vss-description as character no-undo init "Процедура изменения Amin".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   define new global shared variable g#library  as handle no-undo .
       68   define new global shared variable g#library2 as handle no-undo .
       69   define   shared variable g#auto as logical no-undo.
       70   define   shared variable g#news as logical no-undo.
       71   define   shared variable g#oxml as logical no-undo.
       72   define   shared variable g#esys as logical no-undo.
       73   define   shared variable g#news-source-db as integer no-undo.
       74   define   shared variable g#esys-source-esys as integer no-undo.
       75   define   shared variable g#db-num as integer   no-undo .
       76   define   shared variable g#userid as character no-undo .
       77   define   shared variable g#passwd as character no-undo .
       78   procedure proc-alt-shift-f2:
       79     if not ibs.th.gbl.gbl-var:rcode
       80   then
       81     run gbl\inidebug.p .
       82   end.
       83   procedure proc-alt-shift-f3:
       84     run gbl/prvssinf.p
       85       ( input this-procedure
       86       ) .
       87   end.
       88   define variable v-inform-launched as logical no-undo initial false .
       89   procedure proc-alt-shift-f4:
       90     define variable v-action as character no-undo .
       91     if v-inform-launched = false then do:
       92       assign
       93         v-inform-launched = true
       94       .
       95       run gbl/d-inform.w
       96         (  input self
       97         ,  input this-procedure
       98         , output v-action
       99         ) no-error .
      100       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      101       assign
      102         v-inform-launched = false
      103       .
      104     end.
      105   end.
      106   procedure proc-alt-f1:
      107     run gbl/corrhelp.p
      108       (input this-procedure
      109       ) .
      110   end .
      111   on alt-shift-f2 anywhere do:
      112     run proc-alt-shift-f2.
      113   end.
      114   on alt-shift-f3 anywhere do:
      115     run proc-alt-shift-f3 in this-procedure .
      116   end.
      117   on alt-shift-f4 anywhere do:
      118     run proc-alt-shift-f4 in this-procedure.
      119   end.
      120   on alt-f1 anywhere do:
      121     run proc-alt-f1 in this-procedure .
      122   end.
      123   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      124   define variable v-waitfram-action01         as character   no-undo .
      125   define variable v-waitfram-action02         as character   no-undo .
      126   define variable v-waitfram-action03         as character   no-undo .
      127   define variable mWaitFramTextBeg            as character   no-undo.
      128   define variable mWaitFramTextEnd            as character   no-undo.
      129   define variable mWaitFramView               as logical     no-undo.
      130   define variable mWaitProcEvent              as logical     no-undo init yes.
      131   define variable mWaitFramInterval           as integer     no-undo init 1 .
      132   define variable mWaitFramStop               as logical     no-undo.
      133   define variable mWaitFramStopUser           as logical     no-undo.
      134   define variable mWaitFramStopTimeOut        as logical     no-undo.
      135   define variable mWaitFramStartProc          as datetime-tz no-undo.
      136   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      137   define button B-WaitFramStop auto-end-key
      138        label "Стоп"
      139        size 10 by 1 tooltip "Остоновить процесс".
      140   define button B-viewProcInfo
      141        label "Информация"
      142        size 15 by 1 tooltip "Информация о процесс".
      143   define frame waitfram
      144     v-waitfram-action01 format "x(72)" no-label skip
      145     v-waitfram-action02 format "x(72)" no-label skip
      146     v-waitfram-action03 format "x(72)" no-label skip
      147     B-viewProcInfo
      148     B-WaitFramStop at row 4 col 30
      149     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      150     .
      151   define new global shared variable mBatchMode as logical no-undo init ?.
      152   define variable mFramBachModHandle as handle no-undo.
      153   mFramBachModHandle = frame waitfram:handle.
      154   define variable mFameOldVis as logical no-undo.
      155   define variable mVisCUrentVin as logical no-undo.
      156   if session:batch-mode
      157   then
      158      mBatchMode = yes.
      159   if mBatchMode = ? then do:
      160     mVisCUrentVin = current-window:visible.
      161     mFameOldVis = mFramBachModHandle:visible.
      162     mFramBachModHandle:visible  = yes.
      163     mBatchMode = mFramBachModHandle:visible ne yes.
      164     mFramBachModHandle:visible = mFameOldVis.
      165     current-window:visible = mVisCUrentVin.
      166   end.
      167    if  log-manager:logfile-name ne ?
      168     then DO:
      169         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      170         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      171         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      172     end.
      173   on choose of B-WaitFramStop in frame waitfram
      174   do:
      175     mWaitFramStop = yes.
      176     mWaitFramStopUser = yes.
      177   end.
      178   function waitfram-check-timeout returns logical():
      179      define variable vtime as int64 no-undo.
      180      if mWaitFramStopTimeOut
      181      then
      182         return yes.
      183      vtime = ( now - mWaitFramStartProc ) / 1000 .
      184      if     mWaitFramTimeOut ne ?
      185         and mWaitFramTimeOut ne 0
      186         and mWaitFramTimeOut lt vtime
      187      then do:
      188         mWaitFramStopTimeOut = yes.
      189      end.
      190      return mWaitFramStopTimeOut.
      191   end.
      192   procedure waitfram-hide :
      193     if not session:batch-mode
      194     then do
      195     on error undo, return error return-value
      196     :
      197       pause 0 before-hide .
      198       if not mBatchMode then
      199         hide frame waitfram .
      200     if     not mWaitFramView
      201        and mWaitProcEvent
      202     then
      203       process events .
      204     end.
      205   end procedure.
      206   procedure waitfram-show :
      207     define input  parameter p-message as character no-undo .
      208     define variable v-left-margin as integer   no-undo .
      209     if not session:batch-mode
      210     then do
      211     on error undo, return error return-value
      212     :
      213       if length(p-message) <= 70 then do:
      214         assign
      215           v-left-margin = integer((70 - length(p-message)) / 2)
      216         .
      217         assign
      218           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      219         .
      220         assign
      221           v-waitfram-action01 = " "
      222           v-waitfram-action02 = " "
      223                                    + fill(" ", v-left-margin)
      224                                    + p-message
      225           v-waitfram-action03 = " "
      226         .
      227       end.
      228       else do:
      229         define variable vRindex1 as integer no-undo.
      230         define variable vRindex2 as integer no-undo.
      231         vRindex1 = r-index(p-message," ",70).
      232         if vRindex1 = 0
      233         then
      234            vRindex1 = 70.
      235         if length(p-message)  <= vRindex1 + 70 then do:
      236           assign
      237             v-waitfram-action01 = " "
      238             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      239             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      240           .
      241         end.
      242         else do:
      243           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      244           if vRindex2 <= vRindex1
      245           then
      246              vRindex2 = vRindex1 + 70.
      247           assign
      248             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      249             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      250             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      251           .
      252         end.
      253       end.
      254       B-viewProcInfo:visible   in frame waitfram = no.
      255       B-viewProcInfo:sensitive in frame waitfram = no.
      256       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      257       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      258       if  (   mWaitFramView
      259          or  mWaitProcEvent)
      260          and not mBatchMode
      261       then
      262          display
      263             v-waitfram-action01 skip
      264             v-waitfram-action02 skip
      265             v-waitfram-action03 skip
      266          with frame waitfram .
      267       if     mWaitFramView
      268          then do:
      269             if     mWaitFramInterval ne ?
      270                and not mBatchMode
      271             then
      272                wait-for go of frame waitfram pause mWaitFramInterval.
      273          end.
      274          else
      275             if     mWaitProcEvent
      276                and not mBatchMode
      277             then
      278                process events .
      279     end.
      280   end procedure.
      281      procedure waitfram-show-this:
      282         define input  parameter iInterval as int64 no-undo.
      283         define variable vtime as int64 no-undo.
      284         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      285         mWaitFramInterval = iInterval.
      286         run waitfram-show (substitute("&1&2 &3&4" ,
      287                                       mWaitFramTextBeg ,
      288                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      289                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      290                                       mWaitFramTextEnd
      291                                      )
      292                           ).
      293      end.
      294      procedure WaitFramRunPause:
      295         define input  parameter iInterval as dec no-undo.
      296         define variable vStart  as datetime-tz no-undo.
      297         define variable vend    as datetime-tz no-undo.
      298         define variable vint as int64 no-undo.
      299         define variable vOk as logical no-undo.
      300         vStart = now.
      301         vend   = vStart.
      302         publish "WaitFramPause" (iInterval,output vOk).
      303         vend   =  now.
      304         vint = vend - vStart.
      305         vint = iInterval - vint / 1000.
      306         if     not mWaitFramStop
      307            and (   vint > 0
      308                 or (    not vOk
      309                     and iInterval eq ?
      310                     )
      311                 )
      312         then
      313            run waitfram-show-this (iInterval).
      314         vend   =  now.
      315         vint = vend - vStart.
      316         vint = iInterval - vint / 1000.
      317         if     not mWaitFramStop
      318            and vint > 0
      319         then do:
      320            run gbl/pause.p (vint * 1000).
      321         end.
      322         if iInterval ne ?
      323         then
      324            publish "WaitFramStop".
      325         waitfram-check-timeout().
      326      end.
      327      procedure WaitFramWaitFor:
      328         define input  parameter iInterval as dec no-undo.
      329         assign
      330            mWaitFramStartProc   = now
      331            mWaitFramStopUser    = no
      332            mWaitFramStopTimeOut = no
      333         .
      334         block-wait:
      335         do while not mWaitFramStop:
      336            run WaitFramRunPause (iInterval).
      337            if  waitfram-check-timeout()
      338            then do:
      339               leave block-wait.
      340            end.
      341         end.
      342         run waitfram-hide.
      343      end.
      344   procedure waitfram-join :
      345     define input  parameter p-line-1  as character no-undo .
      346     define input  parameter p-line-2  as character no-undo .
      347     define input  parameter p-line-3  as character no-undo .
      348     define output parameter p-message as character no-undo .
      349     do
      350     on error undo, return error return-value
      351     :
      352       assign
      353         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      354                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      355                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      356       .
      357     end.
      358   end procedure.
      359   function waitfram-join-function returns character
      360     (input p-line-1 as character
      361     ,input p-line-2 as character
      362     ,input p-line-3 as character
      363     ).
      364     define variable v-message as character no-undo .
      365     run waitfram-join in this-procedure
      366       (input  p-line-1
      367       ,input  p-line-2
      368       ,input  p-line-3
      369       ,output v-message
      370       ) .
      371     return v-message .
      372   end function .
      373   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      374   procedure cur-time :
      375      define output parameter p-today as date      no-undo .
      376      define output parameter p-time  as integer   no-undo .
      377     do
      378     on error undo, return error
      379     :
      380       define variable v-date1 as date      no-undo .
      381       define variable v-date2 as date      no-undo .
      382       define variable v-time  as integer   no-undo .
      383       assign
      384         v-date1 = today
      385         v-time  = time
      386         v-date2 = today
      387       .
      388       if v-date1 <> v-date2
      389       then do:
      390         assign
      391           v-date1 = today
      392           v-time  = v-time
      393         .
      394       end.
      395       assign
      396         p-today = v-date1
      397         p-time  = v-time
      398       .
      399     end.
      400   end.
      401   function cur-time-date returns character
      402   :
      403     return string(today, '99/99/9999':U) .
      404   end.
      405   function cur-time-mjd returns decimal
      406   :
      407     define variable v-date as date      no-undo .
      408     define variable v-time as integer   no-undo .
      409     run cur-time in this-procedure
      410       (output v-date
      411       ,output v-time
      412       ) .
      413     return integer(v-date) - 2400002 + (v-time / 86400) .
      414   end.
      415   function cur-time-get-ending-index returns integer
      416   (input p-number as integer
      417   )
      418   :
      419     if p-number < 0
      420     or p-number = ?
      421     then do:
      422       return 1 .
      423     end.
      424     define variable v-rest as integer   no-undo .
      425     assign
      426       p-number = p-number modulo 100
      427     .
      428     if p-number < 20
      429     then do:
      430       assign
      431         v-rest = p-number
      432       .
      433     end.
      434     else do:
      435       assign
      436         v-rest = p-number modulo 10
      437       .
      438     end.
      439     case v-rest :
      440       when 1
      441       then do:
      442         return 2 .
      443       end.
      444       when 2 or
      445       when 3 or
      446       when 4
      447       then do:
      448         return 3 .
      449       end.
      450       otherwise do:
      451         return 1 .
      452       end.
      453     end case .
      454   end.
      455   procedure cur-time-mjd-to-date :
      456      define input  parameter i-mjd-diff as decimal no-undo.
      457      define output parameter o-Date     as date    no-undo.
      458      define output parameter o-Time     as integer no-undo.
      459      define variable v-day-number as integer   no-undo .
      460      if    i-mjd-diff < 0
      461         or i-mjd-diff = ?
      462      then do:
      463         return "?" .
      464      end.
      465      assign
      466         v-day-number = truncate(i-mjd-diff,0).
      467         o-Date = date(v-day-number + 2400002).
      468         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      469     .
      470   end.
      471   function cur-time-mjd-to-string returns character
      472   (input p-mjd-diff as decimal
      473   )
      474   :
      475     define variable v-day-number as integer   no-undo .
      476     define variable v-seconds    as integer   no-undo .
      477     define variable v-hour       as integer   no-undo .
      478     define variable v-min        as integer   no-undo .
      479     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      480     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      481     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      482     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      483     if p-mjd-diff < 0
      484     or p-mjd-diff = ?
      485     then do:
      486       return "?" .
      487     end.
      488     assign
      489       v-day-number = integer(truncate(p-mjd-diff,0))
      490       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      491     .
      492     if v-seconds > 86400
      493     then do:
      494       assign
      495         v-seconds = 86400 - 1
      496       .
      497     end.
      498     if v-seconds < 0
      499     then do:
      500       assign
      501         v-seconds = 0
      502       .
      503     end.
      504     assign
      505       v-hour = truncate(v-seconds / 3600, 0)
      506     .
      507     assign
      508       v-seconds = v-seconds modulo 3600
      509     .
      510     assign
      511       v-min = truncate(v-seconds / 60, 0)
      512     .
      513     assign
      514       v-seconds = v-seconds modulo 60
      515     .
      516     return
      517         (if v-day-number <> 0
      518           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      519           else ""
      520         )
      521       + (if v-day-number <> 0 or v-hour <> 0
      522           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      523           else ""
      524         )
      525       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      526           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      527           else ""
      528         )
      529       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      530       .
      531   end.
      532   function cur-time-string returns character
      533   :
      534     define variable v-date as date      no-undo .
      535     define variable v-time as integer   no-undo .
      536     run cur-time in this-procedure
      537       (output v-date
      538       ,output v-time
      539       ) .
      540     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      541   end.
      542   function cur-time-string-sec returns character
      543   :
      544     define variable v-date as date      no-undo .
      545     define variable v-time as integer   no-undo .
      546     run cur-time in this-procedure
      547       (output v-date
      548       ,output v-time
      549       ) .
      550     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      551   end.
      552   function cur-time-custom  returns character
      553   (input p-prefix as character
      554   ,input p-date-format as character
      555   ,input p-delimiter as character
      556   ,input p-time-format as character
      557   ,input p-suffix as character
      558   )
      559   :
      560     define variable v-date as date      no-undo .
      561     define variable v-time as integer   no-undo .
      562     run cur-time in this-procedure
      563       (output v-date
      564       ,output v-time
      565       ) .
      566     return
      567       p-prefix
      568       + string(v-date, p-date-format)
      569       + p-delimiter
      570       + string(v-time, p-time-format)
      571       + p-suffix
      572       .
      573   end.
      574   function cur-time-print  returns character
      575   :
      576     define variable v-date as date      no-undo .
      577     define variable v-time as integer   no-undo .
      578     run cur-time in this-procedure
      579       (output v-date
      580       ,output v-time
      581       ) .
      582     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      583   end.
      584   function cur-time-datetime returns datetime
      585   :
      586     define variable v-char as character no-undo .
      587     define variable v-datetime as datetime no-undo .
      588     v-char = cur-time-string().
      589     v-datetime = datetime(v-char).
      590     return  v-datetime.
      591   end.
      592   function cur-time-string-msec returns character
      593   :
      594     define variable v-date as datetime  no-undo .
      595     v-date = now.
      596     return string(v-date) .
      597   end.
      598   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      599   def
      600    shared
      601   temp-table  obj-list no-undo
      602     field obj-type like ub.clients.obj-type
      603     field obj-code like ub.clients.obj-code
      604     field obj-name like ub.clients.obj-name
      605     field obj-id   as integer
      606     field db-num   as integer
      607     index pi is primary unique obj-id
      608     index ie1 obj-type obj-code
      609     index ie2 obj-name
      610   .
      611   procedure create_obj-list :
      612      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      613      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      614      do
      615      on error undo, return error return-value
      616      :
      617         define buffer cli-obj for ub.clients .
      618         define variable p-var as integer no-undo .
      619         define buffer buf_obj-list for obj-list .
      620         find last buf_obj-list  use-index pi no-error .
      621         if available buf_obj-list
      622         then
      623            p-var = buf_obj-list.obj-id + 1.
      624         else
      625            p-var = 1.
      626         find first cli-obj where
      627                   cli-obj.obj-type = p-obj-type
      628               and cli-obj.obj-code = p-obj-code
      629         no-lock no-error.
      630         if available cli-obj
      631         then do:
      632            create buf_obj-list.
      633            assign
      634               buf_obj-list.obj-id   = p-var
      635               buf_obj-list.obj-code = cli-obj.obj-code
      636               buf_obj-list.obj-type = cli-obj.obj-type
      637               buf_obj-list.obj-name = cli-obj.obj-name
      638               buf_obj-list.db-num   = cli-obj.db-num
      639            .
      640         end.
      641      end.
      642   end.
      643   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
