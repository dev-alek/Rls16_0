      679   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      680   procedure gds-ind1 :
      681   main-block:
      682     do
      683   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      684   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      685   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      686     :
      687   define input-output parameter p-doc-rec  as recid no-undo.
      688   define input  parameter p-gds-code                   like  ub.gds-obj-prop.gds-code no-undo.
      689   define input  parameter p-obj-type                   like  ub.gds-obj-prop.obj-type no-undo.
      690   define input  parameter p-obj-code                   like  ub.gds-obj-prop.obj-code no-undo.
      691   define input  parameter p-gdop-igt                   like  ub.gds-obj-prop.gdop-igt no-undo.
      692   define input  parameter p-gdop-assort-min            like  ub.gds-obj-prop.gdop-assort-min  no-undo.
      693   define input  parameter p-gdop-min-stock             like  ub.gds-obj-prop.gdop-min-stock   no-undo.
      694   define input  parameter p-grop-level-always-presence like  ub.gds-obj-prop.grop-level-always-presence  no-undo.
      695   define input  parameter p-grop-max-stock             like  ub.gds-obj-prop.grop-max-stock              no-undo.
      696   define input  parameter p-grop-min-order             like  ub.gds-obj-prop.grop-min-order              no-undo.
      697   define buffer bufs_gds-obj-prop for ub.gds-obj-prop.
      698   define variable v-db-num like ub.db.db-num no-undo .
      699   define variable v-db-num-obj like ub.db.db-num no-undo .
      700   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      701   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
      702     (output v-db-num
      703     )  .
      704   define variable v-date as date no-undo .
      705   define variable v-time as integer no-undo .
      706   run cur-time in this-procedure(output v-date, output v-time).
      707     find first bufs_gds-obj-prop exclusive-lock where
      708               bufs_gds-obj-prop.gds-code          = p-gds-code   and
      709               bufs_gds-obj-prop.obj-type          = p-obj-type   and
      710               bufs_gds-obj-prop.obj-code          = p-obj-code  no-error .
      711       if not available bufs_gds-obj-prop then do:
      712           create bufs_gds-obj-prop.
      713           assign
      714               bufs_gds-obj-prop.gds-code           = p-gds-code
      715               bufs_gds-obj-prop.grop-date-update   = v-date
      716               bufs_gds-obj-prop.grop-time-update   = v-time
      717               bufs_gds-obj-prop.grop-db-num-update = v-db-num
      718               bufs_gds-obj-prop.obj-type           = p-obj-type
      719               bufs_gds-obj-prop.obj-code           = p-obj-code
      720           no-error .
      721           if error-status :error then message "Ошибка при создании записи" error-status :error error-status :get-message(1) .
      722       end.
      723   if  p-gdop-igt                     <> ? then    bufs_gds-obj-prop.gdop-igt                   = p-gdop-igt.
      724   if  p-gdop-assort-min              <> ? then    bufs_gds-obj-prop.gdop-assort-min            = p-gdop-assort-min.
      725   if  p-gdop-min-stock               <> ? then    bufs_gds-obj-prop.gdop-min-stock             = p-gdop-min-stock  .
      726   if  p-grop-level-always-presence   <> ? then    bufs_gds-obj-prop.grop-level-always-presence = p-grop-level-always-presence.
      727   if  p-grop-max-stock               <> ? then    bufs_gds-obj-prop.grop-max-stock             = p-grop-max-stock           .
      728   if  p-grop-min-order               <> ? then    bufs_gds-obj-prop.grop-min-order             = p-grop-min-order           .
      729         p-doc-rec = recid(bufs_gds-obj-prop)    .
      730   end.
      731   end procedure.
      732    define variable v-log as logical   no-undo .
      733   define variable vss-include-info7 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      734   do:
      735     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      736       (input  g#db-num
      737       ,input  g#userid
      738       ,input  0
      739       ,input  'actn_assort-izt_update':U
      740       ,input  'global':U
      741       ,input  0
      742       ,input  '':U
      743       ,input  0
      744       ,input  0
      745       ,input  0
      746       ,input  0
      747       ,input  true
      748       ,output v-log
      749       )  .
      750   end.
      751    if not v-log then return  .
      752   define buffer buf_gds-obj-prop for ub.gds-obj-prop .
      753   define buffer buf_gds-obj      for ub.gds-obj .
      754   define variable v-i as integer   no-undo .
      755   define variable Temp1 as integer   no-undo .
      756   define variable v-gds-prop-recid as recid no-undo .
      757   define variable v-num as integer no-undo init 1.
      758   for each obj-list :
      759       run waitfram-show ("Объект " + obj-list.obj-name ) .
      760       v-i = 0.
      761       for each gds-list :
      762           v-i = v-i + 1 .
      763   If Integer(1) = 0 Then Temp1  = 100  .
      764                         Else Temp1 = Integer(1) .
      765        IF ( v-i modulo Temp1 = 0 ) AND ( v-i >= Temp1 ) then
      766            RUN waitfram-show( "Обработано строк : " + string( v-i )) .
      767           find first buf_gds-obj-prop no-lock  where
      768                      buf_gds-obj-prop.gds-code = gds-list.gds-code and
      769                      buf_gds-obj-prop.obj-code = obj-list.obj-code and
      770                      buf_gds-obj-prop.obj-type = obj-list.obj-type no-error .
      771              if not available buf_gds-obj-prop then
      772              do:
      773                   find first buf_gds-obj no-lock  where
      774                             buf_gds-obj.gds-code = gds-list.gds-code and
      775                             buf_gds-obj.obj-code = obj-list.obj-code and
      776                             buf_gds-obj.obj-type = obj-list.obj-type no-error .
      777                             if available buf_gds-obj then do:
      778                                 run gds-ind1
      779                                     (input-output v-gds-prop-recid
      780                                     ,buf_gds-obj.gds-code
      781                                     ,buf_gds-obj.obj-type
      782                                     ,buf_gds-obj.obj-code
      783                                     ,?
      784                                     ,p-new
      785                                     ,?
      786                                     ,?
      787                                     ,?
      788                                     ,?
      789                                     )  .
      790                             end.
      791                             else next.
      792              end.
      793              else do:
      794                   run gds-ind1
      795                       (input-output v-gds-prop-recid
      796                       ,buf_gds-obj-prop.gds-code
      797                       ,buf_gds-obj-prop.obj-type
      798                       ,buf_gds-obj-prop.obj-code
      799                       ,?
      800                       ,p-new
      801                       ,?
      802                       ,?
      803                       ,?
      804                       ,?
      805                       )  .
      806               end.
      807         end.
      808    end.
      809   run waitfram-hide.
