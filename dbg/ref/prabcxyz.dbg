      372   def
      373   new shared
      374   temp-table  obj-list no-undo
      375     field obj-type like ub.clients.obj-type
      376     field obj-code like ub.clients.obj-code
      377     field obj-name like ub.clients.obj-name
      378     field obj-id   as integer
