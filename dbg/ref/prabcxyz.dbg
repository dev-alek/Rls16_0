     1418         VIEW-AS TEXT
     1419        SIZE 53.25 BY .67
     1420        FGCOLOR 1  NO-UNDO.
     1421   DEFINE RECTANGLE RECT-1
     1422        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     1423        SIZE 55.13 BY 4.46.
     1424   DEFINE FRAME InfoFrame
     1425        StopBtn AT ROW 4.25 COL 21.75
     1426        RecordsString AT ROW 1.21 COL 2 NO-LABEL
     1427        RecordsString2 AT ROW 1.96 COL 2 NO-LABEL
     1428        RecordsString3 AT ROW 2.58 COL 2 NO-LABEL
     1429        RecordsDone AT ROW 3.42 COL 24.88 COLON-ALIGNED
     1430        RECT-1 AT ROW 1 COL 1
     1431       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1432            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1433            TITLE "Процесс"
     1434            DEFAULT-BUTTON StopBtn CANCEL-BUTTON StopBtn.
     1435   define variable mFrameView      as logical   no-undo init yes.
     1436     define variable mFramHandle as handle no-undo.
     1437     mFramHandle = frame InfoFrame:handle.
     1438     if  log-manager:logfile-name ne ?
     1439     then DO:
     1440         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1441         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1442         log-manager:write-message("visible-frame-mod=" + string(mFramHandle:visible), "frameRepError").
     1443     end.
     1444     mFrameView = not session:batch-mode and mFramHandle:visible.
     1445     if mFrameView
     1446     then do:
     1447       ASSIGN
     1448          FRAME InfoFrame:HIDDEN                           = TRUE
     1449          StopBtn:sensitive IN FRAME InfoFrame             = TRUE.
     1450     end.
     1451   ON CHOOSE OF StopBtn IN FRAME InfoFrame
     1452   DO:
     1453     IF not StopProcessing THEN
     1454       Message "Вы действительно хотите прервать" SKIP
     1455               "процесс проверки?" view-as alert-box QUESTION BUTTONS yes-no
     1456                 UPDATE StopProcessing.
     1457     IF StopProcessing THEN do:
     1458        if mFrameView
     1459        then do:
     1460           HIDE FRAME InfoFrame.
     1461        end.
     1462     End.
     1463   END.
     1464   assign v-account = ( if integer( 25 ) = 0 then 100 else integer( 25 ) ).
     1465     if  log-manager:logfile-name ne ?
     1466     then DO:
     1467         log-manager:write-message("ON mFrameView=" + string(mFrameView), "frameRepError").
     1468     end.
     1469     if not session:batch-mode then
     1470     do:
     1471       VIEW FRAME InfoFrame.
     1472       mFrameView = true.
     1473     end.
     1474      v-button-stop = false .
     1475         if mFrameView
     1476         then do:
     1477         if v-button-stop then view STOPBTN in frame InfoFrame.
     1478                          else Hide STOPBTN in frame InfoFrame.
     1479         end.
     1480   v-ind = 0    .
     1481       Output stream Macr_Excel  close .
     1482       num#str# = 0 .
     1483       run gbl/_tmpfile.p ("wb", ".txt", output v-file-name) .
     1484       output stream macr_excel to value(v-file-name)   .
     1485       v-ind = v-ind + 1.
     1486    run get-report-num  in parParentProc(output g#report-num).
     1487       define stream  Stream-rpt .
     1488       p-file-name =  string( session:temp-directory +
     1489                     "rpt" + string( g#report-num ) + ".txt" ) .
     1490       output stream stream-rpt to value(p-file-name)   .
     1491       output stream stream-rpt close  .
     1492     run PrintTitul in this-procedure .
     1493     for each temp-str :  delete temp-str.  end.
     1494     run make-tt in this-procedure .
     1495     for each temp-str no-lock :
     1496          run print-line in this-procedure .
     1497     end.
     1498     run PrintPodval in this-procedure .
     1499     run paramls-write in this-procedure
     1500       ( input "file"
     1501       , input string(v-ind)
     1502       , input v-file-name
     1503       ) .
     1504   Output stream Macr_Excel  close .
     1505   if mFrameView
     1506   then do:
     1507      HIDE FRAME InfoFrame.
     1508   end.
     1509       run paramls-write in this-procedure
     1510           (input "charcol"
     1511           ,input ""
     1512           ,input "1,3,4,5,6"
     1513           ) .
     1514     run end-proc in this-procedure .
     1515     run rep/runexcel.p ( p-file-name ).
     1516   procedure print-line :
     1517     do on error undo, return error return-value :
     1518   define variable v-color as integer   no-undo .
     1519   num#str# = num#str# + 1.
     1520   num#col# = 1.
     1521   run macr_excel_char ( temp-str.artic     , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1522   run macr_excel_char ( temp-str.gds-code  , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1523   run macr_excel_char ( temp-str.gds-name  , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1524   run macr_excel_char ( temp-str.acc_min   , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1525   run macr_excel_char ( temp-str.acc_matr  , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1526   run macr_excel_char ( temp-str.izt       , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1527   for each temp-abc  :
     1528         if  temp-abc.type = "ABC"  then do:
     1529           find first ub.abc-analysis-goods no-lock where
     1530                     ub.abc-analysis-goods.abc-id = temp-abc.id and
     1531                     ub.abc-analysis-goods.db-num = temp-abc.db-num and
     1532                     ub.abc-analysis-goods.gds-code = temp-STR.gds-code no-error .
     1533                 if available ub.abc-analysis-goods then do:
     1534                   run macr_excel_char ( ub.abc-analysis-goods.abcg-abc                , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1535                   run macr_excel_DEC ( ub.abc-analysis-goods.abcg-prcnt-for-estimate , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1536                   run macr_excel_DEC ( ub.abc-analysis-goods.abcg-sum-for-estimate   , num#str# , num#col#   ) .
     1537                   if ub.abc-analysis-goods.abcg-abc = "A" then
     1538                     assign
     1539                       v-color = 3
     1540                     .
     1541                   if ub.abc-analysis-goods.abcg-abc = "C" then
     1542                     assign
     1543                       v-color = 0
     1544                     .
     1545                   if ub.abc-analysis-goods.abcg-abc = "B" then
     1546                     assign
     1547                         v-color = 41
     1548                     .
     1549                   if ub.abc-analysis-goods.abcg-abc = "D" then
     1550                     assign
     1551                       v-color = 14
     1552                     .
     1553                   if ub.abc-analysis-goods.abcg-abc = "E" then
     1554                     assign
     1555                       v-color = 13
     1556                     .
     1557                   if ub.abc-analysis-goods.abcg-abc = "F" then
     1558                     assign
     1559                         v-color = 48
     1560                     .
     1561               end.
     1562               ELSE do:
     1563                   num#col# = num#col# + 3 .
     1564                   end.
     1565               put  stream macr_excel unformatted
     1566                     substitute('select("r&1c&2:r&3c&4 ")' , num#str# , num#col# - 2 , num#str# , num#col# ) + chr(10)
     1567                     substitute('font.properties(,,,,,,,,,&1,,,)', v-color ) + chr(10) .
     1568                 assign    num#col# = num#col# + 1 .
     1569     end.
     1570     if  temp-abc.type = "XYZ"  then do:
     1571           find first ub.xyz-analysis-goods no-lock where
     1572                     ub.xyz-analysis-goods.XYZ-id = temp-abc.id and
     1573                     ub.xyz-analysis-goods.db-num = temp-abc.db-num and
     1574                     ub.xyz-analysis-goods.gds-code = temp-STR.gds-code no-error .
     1575           if available ub.xyz-analysis-goods then do:
     1576             num#col# = 10.
     1577             run macr_excel_char ( ub.xyz-analysis-goods.XYZg-XYZ               , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1578             run macr_excel_DEC ( ub.xyz-analysis-goods.XYZg-prcnt-for-estimate , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1579             run macr_excel_DEC ( ub.xyz-analysis-goods.XYZg-sum-for-estimate   , num#str# , num#col#   ) .
     1580             if ub.xyz-analysis-goods.XYZg-XYZ = "X" then
     1581               assign
     1582                 v-color = 3
     1583               .
     1584             if ub.xyz-analysis-goods.XYZg-XYZ = "Z" then
     1585               assign
     1586                 v-color = 0
     1587               .
     1588             if ub.xyz-analysis-goods.XYZg-XYZ = "Y" then
     1589               assign
     1590                   v-color = 41
     1591               .
     1592               put  stream macr_excel unformatted
     1593                     substitute('select("r&1c&2:r&3c&4 ")' , num#str# , num#col# - 2 , num#str# , num#col# ) + chr(10)
     1594                     substitute('font.properties(,,,,,,,,,&1,,,)', v-color ) + chr(10) .
     1595         end.
     1596     end.
     1597   end.
     1598     end.
     1599   end procedure.
     1600   procedure print-all-itog :
     1601   end procedure.
     1602   procedure PrintTitul :
     1603     do  on error undo, return error return-value  :
     1604     define variable cc as integer no-undo .
     1605     define variable tt as integer no-undo .
     1606       num#str# = num#str# + 1.
     1607       num#col# = 2.
     1608       cc = num#str# .
     1609       run macr_excel_char ( "Сопоставление ABC и XYZ анализов"  , num#str# , num#col#   ) .
     1610       num#str# = num#str# + 1.
     1611       num#col# = 2.
     1612       run macr_excel_char ("Печать " + cur-time-date()  , num#str# , num#col#   ) .
     1613       run macr_cell_format
     1614           ( 12     ,
     1615             true   ,
     1616             false  ,
     1617             ?      ,
     1618             cc     ,
     1619             2      ,
     1620             num#str# ,
     1621             2 ) .
     1622       run pshap in this-procedure .
     1623        num#str# = num#str# + 1.
     1624       num#col# = 1.
     1625       run macr_excel_char ( "Артикул товара"   , num#str# , num#col#   ) .
     1626       run macr_cell_size ( 10 , ? , num#str# , num#col# , ?, ? ) .
     1627       num#col# = 2.
     1628       run macr_excel_char ( "Код"   , num#str# , num#col#   ) .
     1629       run macr_cell_size ( 10 , ? , num#str# , num#col# , ?, ? ) .
     1630       num#col# = 3.
     1631       run macr_excel_char ( "Наименование товара"   , num#str# , num#col#   ) .
     1632       run macr_cell_size ( 25 , ? , num#str# , num#col# , ?, ? ) .
     1633       num#col# = 4.
     1634       run macr_excel_char ( "Ассортиментный минимум"   , num#str# , num#col#   ) .
     1635       run macr_cell_size ( 10 , ? , num#str# , num#col# , ?, ? ) .
     1636       num#col# = 5.
     1637       run macr_excel_char ( "Ассортиментная матрица"   , num#str# , num#col#   ) .
     1638       run macr_cell_size ( 10 , ? , num#str# , num#col# , ?, ? ) .
     1639       num#col# = 6.
     1640       run macr_excel_char ( "ИЖТ"   , num#str# , num#col#   ) .
     1641       run macr_cell_size ( 15 , ? , num#str# , num#col# , ?, ? ) .
     1642       for each temp-abc :
     1643           num#col# = num#col# + 1.
     1644           run macr_excel_char ( "Анализ " + string(temp-abc.type) , num#str# , num#col#   ) .
     1645           run macr_cell_size ( 10 , ? , num#str# , num#col# , ?, ? ) .
     1646           num#col# = num#col# + 1.
     1647           run macr_excel_char (  "%"  , num#str# , num#col#   ) .
     1648           run macr_cell_size ( 5 , ? , num#str# , num#col# , ?, ? ) .
     1649           num#col# = num#col# + 1.
     1650           run macr_excel_char ( "Сумма по критерию"  , num#str# , num#col#   ) .
     1651           run macr_cell_size ( 15 , ? , num#str# , num#col# , ?, ? ) .
     1652           if temp-abc.nn modulo 2 = 0 then do:
     1653               run macr_cell_format
     1654               ( 10    ,
     1655                 true  ,
     1656                 false  ,
     1657                 33    ,
     1658                 num#str# ,
     1659                 num#col# - 2 ,
     1660                 num#str# ,
     1661                 num#col# ) .
     1662           end.
     1663           else do:
     1664               run macr_cell_format
     1665               ( 10    ,
     1666                 true  ,
     1667                 false  ,
     1668                 34    ,
     1669                 num#str# ,
     1670                 num#col# - 2 ,
     1671                 num#str# ,
     1672                 num#col# ) .
     1673           end.
     1674       end.
     1675       run macr_cell_format
     1676       ( 10    ,
     1677         true  ,
     1678         false  ,
     1679         ?    ,
     1680         num#str# ,
     1681         1 ,
     1682         num#str# ,
     1683         14 ) .
     1684        put  stream macr_excel unformatted
     1685          substitute('select("r&1c&2:r&3c&4 ")' , num#str# , 1 , num#str# ,  num#col# ) + chr(10)  +
     1686          'BORDER( 2 , 2 , 2 , 2 , 2 , ,0,0,0,0,0) '  + chr(10) +
     1687          'ALIGNMENT(3 , , 4 , 4 ,)'  + chr(10)
     1688          .
     1689     end.
     1690   end procedure.
     1691   procedure PrintPodval :
     1692     do on error undo, return error return-value  :
     1693       num#str# = num#str# + 3.
     1694       num#col# = 1.
     1695       run macr_excel_char ( "Исполнитель"   , num#str# , num#col#   ) .
     1696       num#col# = 3.
     1697       run macr_excel_char ( p-user-name  , num#str# , num#col#   ) .
     1698     end.
     1699   end procedure.
     1700   procedure make-tt :
     1701     do
     1702     on error undo, return error return-value
     1703     :
     1704   define buffer buf_abc-analysis-goods for ub.abc-analysis-goods.
     1705   define buffer buf_goods for ub.goods.
     1706   define variable  v-izt      as character no-undo .
     1707   define variable  v-acc-mat as character no-undo .
     1708   define variable  v-Amin    as character no-undo .
     1709   for each temp-abc where temp-abc.type  = "ABC" :
     1710     for each buf_abc-analysis-goods no-lock where
     1711              buf_abc-analysis-goods.abc-id = temp-abc.id  and
     1712              buf_abc-analysis-goods.db-num = temp-abc.db-num :
     1713       if not can-find ( first temp-str where temp-str.gds-code  = buf_abc-analysis-goods.gds-code) then do:
     1714           find first buf_goods no-lock where buf_goods.gds-code =  buf_abc-analysis-goods.gds-code no-error .
     1715           create temp-str .
     1716           run prt-goods-abc (
     1717                 input buf_goods.gds-code
     1718               , output v-izt
     1719               , output v-acc-mat
     1720               , output v-Amin      ).
     1721           assign
     1722               temp-str.gds-code = buf_abc-analysis-goods.gds-code
     1723               temp-str.artic    = buf_goods.artic
     1724               temp-str.gds-name = buf_goods.gds-name
     1725               temp-str.acc_min  = v-Amin
     1726               temp-str.acc_matr = v-acc-mat
     1727               temp-str.izt      = v-izt
     1728           .
     1729       end.
     1730     end.
     1731   end.
     1732   for each temp-abc where temp-abc.type  = "XYZ" :
     1733     for each buf_XYZ-analysis-goods no-lock where
     1734              buf_XYZ-analysis-goods.XYZ-id = temp-abc.id  and
     1735              buf_XYZ-analysis-goods.db-num = temp-abc.db-num :
     1736       if not can-find ( first temp-str where temp-str.gds-code  = buf_XYZ-analysis-goods.gds-code) then do:
     1737           find first buf_goods no-lock where buf_goods.gds-code =  buf_XYZ-analysis-goods.gds-code no-error .
     1738           create temp-str .
     1739           run prt-goods-xyz (
     1740                 input buf_goods.gds-code
     1741               , output v-izt
     1742               , output v-acc-mat
     1743               , output v-Amin      ).
     1744           assign
     1745               temp-str.gds-code = buf_XYZ-analysis-goods.gds-code
     1746               temp-str.artic    = buf_goods.artic
     1747               temp-str.gds-name = buf_goods.gds-name
     1748               temp-str.acc_min  = v-Amin
     1749               temp-str.acc_matr = v-acc-mat
     1750               temp-str.izt      = v-izt
     1751           .
     1752       end.
     1753     end.
     1754   end.
     1755     end.
     1756    end procedure.
     1757   procedure pshap :
     1758     do
     1759     on error undo, return error return-value
     1760     :
     1761     define variable tt as integer   no-undo .
     1762       num#str# = num#str# + 1.
     1763       num#col# = 1.
     1764       tt = num#str# .
     1765       for each temp-abc :
     1766           run macr_excel_char ( "Анализ " + string(temp-abc.type )                , num#str# , num#col#   ) .
     1767               run macr_cell_format
     1768               ( 10    ,
     1769                 true  ,
     1770                 false  ,
     1771                 ?    ,
     1772                 num#str# ,
     1773                 num#col#  ,
     1774                 num#str# ,
     1775                 num#col# ) .
     1776           num#str# = num#str# + 1.
     1777           run macr_excel_char ( temp-abc.name               , num#str# , num#col#   ) . num#str# = num#str# + 1.
     1778           if temp-abc.des <> "" then do:  run macr_excel_char ( temp-abc.des                , num#str# , num#col#   ) . num#str# = num#str# + 1. end.
     1779           run macr_excel_char ( temp-abc.name-cral          , num#str# , num#col#   ) . num#str# = num#str# + 1.
     1780           run macr_excel_char ((if temp-abc.type= "XYZ" then "X=" else "A=") + string( temp-abc.A )                 , num#str# , num#col#   ) . num#str# = num#str# + 1.
     1781           run macr_excel_char ((if temp-abc.type= "XYZ" then "Y=" else "B=") + string( temp-abc.B )                 , num#str# , num#col#   ) . num#str# = num#str# + 1.
     1782           run macr_excel_char ((if temp-abc.type= "XYZ" then "Z=" else "C=") + string( temp-abc.C )                 , num#str# , num#col#   ) . num#str# = num#str# + 1.
     1783           if temp-abc.D > 0 then do:  run macr_excel_char ( "D=" + string(temp-abc.D )   , num#str# , num#col#   ) .    num#str# = num#str# + 1. end.
     1784           if temp-abc.E > 0 then do:  run macr_excel_char ( "E=" + string(temp-abc.E )   , num#str# , num#col#   ) .    num#str# = num#str# + 1. end.
     1785           if temp-abc.F > 0 then do:  run macr_excel_char ( "F=" + string(temp-abc.F )   , num#str# , num#col#   ) .    num#str# = num#str# + 1. end.
     1786           run macr_excel_char ( "создан : " + string(temp-abc.date-cr , "99/99/9999")            , num#str# , num#col#   ) . num#str# = num#str# + 1.
     1787           run macr_excel_char ( temp-abc.period             , num#str# , num#col#   ) .  num#str# = num#str# + 1.
     1788           run macr_excel_char ( temp-abc.ext-doc-type       , num#str# , num#col#   ) .  num#str# = num#str# + 1.
     1789           run macr_excel_char ( temp-abc.obj                , num#str# , num#col#   ) .  num#str# = num#str# + 1.
     1790       end.
     1791     end.
     1792   end procedure.
     1793   def var vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1794   procedure macr_excel_char :
     1795    do
     1796    on error undo, return error return-value
     1797    :
     1798    define input parameter  p-val as character no-undo .
     1799    define input parameter  p-row as integer no-undo .
     1800    define input parameter  p-col as integer no-undo .
     1801    if p-val = ? then p-val = "" .
     1802       put stream macr_excel unformatted
     1803             substitute('formula(&3,"r&1c&2")', p-row , p-col , format-excel-text-macr ( p-val) ) + chr(10)  .
     1804    end.
     1805   end procedure.
     1806   procedure macr_excel_char_with_format :
     1807    do
     1808    on error undo, return error return-value
     1809    :
     1810    define input parameter  p-val as character no-undo .
     1811    define input parameter  p-row as integer no-undo .
     1812    define input parameter  p-col as integer no-undo .
     1813    if p-val = ? then p-val = "" .
     1814       put stream macr_excel unformatted
     1815             substitute('select("r&1c&2")', p-row , p-col ) + chr(10) .
     1816       put stream macr_excel unformatted 'format.number("@")' + chr(10) .
     1817       put stream macr_excel unformatted
     1818             substitute('formula(&3,"r&1c&2")', p-row , p-col , format-excel-text-macr ( p-val) ) + chr(10)  .
     1819    end.
     1820   end procedure.
     1821   procedure macr_excel_cell_format :
     1822    do
     1823    on error undo, return error return-value
     1824    :
     1825    define input parameter  p-val    as character no-undo .
     1826    define input parameter  p-row    as integer   no-undo .
     1827    define input parameter  p-col    as integer   no-undo .
     1828    define input parameter  p-format as character no-undo .
     1829    if p-val = ? then p-val = "" .
     1830       put stream macr_excel unformatted
     1831             substitute('select("r&1c&2")', p-row , p-col ) + chr(10) .
     1832       put stream macr_excel unformatted substitute('format.number("&1")', p-format) + chr(10) .
     1833       put stream macr_excel unformatted
     1834             substitute('formula(&3,"r&1c&2")', p-row , p-col , format-excel-text-macr ( p-val) ) + chr(10)  .
     1835    end.
     1836   end procedure.
     1837   procedure macr_excel_sum :
     1838    do
     1839    on error undo, return error return-value
     1840    :
     1841    define input parameter  p-row as integer no-undo .
     1842    define input parameter  p-col as integer no-undo .
     1843    define input parameter  p-row1 as integer no-undo .
     1844    define input parameter  p-col1 as integer no-undo .
     1845    define input parameter  p-row2 as integer no-undo .
     1846    define input parameter  p-col2 as integer no-undo .
     1847       put stream macr_excel unformatted
     1848             substitute('formula("=sum(r&3c&4:r&5c&6)","r&1c&2")', p-row , p-col , p-row1 , p-col1 ,p-row2 , p-col2 ) + chr(10)  .
     1849    end.
     1850   end procedure.
     1851   procedure macr_excel_dec :
     1852    do
     1853    on error undo, return error return-value
     1854    :
     1855    define input parameter  p-val as character no-undo .
     1856    define input parameter  p-row as integer   no-undo .
     1857    define input parameter  p-col as integer   no-undo .
     1858     if p-val = ? then p-val =  "" .
     1859      put  stream macr_excel unformatted
     1860           substitute('formula(&3,"r&1c&2")', p-row , p-col ,  p-val )  + chr(10) .
     1861    end.
     1862   end procedure.
     1863   procedure macr_cell_format :
     1864    do
     1865    on error undo, return error return-value
     1866    :
     1867    define input parameter  p-size   as integer   no-undo .
     1868    define input parameter  p-bold   as logical   no-undo .
     1869    define input parameter  p-italic as logical   no-undo .
     1870    define input parameter  p-color  as integer   no-undo .
     1871    define input parameter  p-row    as integer   no-undo .
     1872    define input parameter  p-col    as integer   no-undo .
     1873    define input parameter  p-row-2  as integer   no-undo .
     1874    define input parameter  p-col-2  as integer   no-undo .
     1875     if p-size = ? then p-size = 10 .
     1876     if p-bold = ? then p-bold = false .
     1877     if p-italic = ? then p-italic = false .
     1878     if p-row-2 = ? then p-row-2 = p-row .
     1879     if p-col-2 = ? then p-col-2 = p-col .
     1880     put  stream macr_excel unformatted
     1881      substitute('select("r&1c&2:r&3c&4 ")' , p-row , p-col , p-row-2 , p-col-2 ) + chr(10) .
     1882     if p-color <> ? then do:
     1883        put  stream macr_excel unformatted
     1884          substitute('patterns(1,,&1,true)', p-color ) + chr(10)  .
     1885     end.
     1886     put  stream macr_excel unformatted
     1887          substitute('format.font(,&1,&2,&3)' , p-size,
     1888                                           string ( p-bold  , "true/false" ) ,
     1889                                           string ( p-italic , "true/false" )
     1890                                           ) + chr(10) .
     1891    end.
     1892   end procedure.
     1893   procedure macr_cell_size :
     1894    do
     1895    on error undo, return error return-value
     1896    :
     1897    define input parameter  p-w   as integer   no-undo .
     1898    define input parameter  p-l   as integer   no-undo .
     1899    define input parameter  p-row    as integer   no-undo .
     1900    define input parameter  p-col    as integer   no-undo .
     1901    define input parameter  p-row-2  as integer   no-undo .
     1902    define input parameter  p-col-2  as integer   no-undo .
     1903     if p-row-2 = ? then p-row-2 = p-row .
     1904     if p-col-2 = ? then p-col-2 = p-col .
     1905     if p-w = ? then    p-w = 0 .
     1906     if p-l = ? then    p-l = 0 .
     1907    define variable s-w as character no-undo .
     1908    define variable s-l as character no-undo .
     1909    if p-w = 0 then s-w = "" .
     1910               else s-w = string(p-w)  .
     1911    if p-l = 0 then s-l = "" .
     1912               else s-l = string(p-l)  .
     1913   put  stream macr_excel unformatted
     1914        substitute('select("r&1c&2:r&3c&4 ")' , p-row , p-col , p-row-2 , p-col-2 )  skip .
     1915   put  stream macr_excel unformatted
     1916        substitute('COLUMN.WIDTH(&1,,,,)' , s-w  )  skip.
     1917   put  stream macr_excel unformatted
     1918        'FORMAT.TEXT(2,2,0,,,,,)'  skip.
     1919    end.
     1920   end procedure.
     1921   procedure proc-print-header :
     1922    do
     1923    on error undo, return error return-value
     1924    :
     1925      find first sheetf .
     1926        sheetf.excel-row-heder =  num-entries( c-str ,chr(10)) + 1.
     1927        sheetf.excel-row-title =  num-entries( sheetf.excel-column-lable , chr(10) ).
     1928        var-1 =  num#str# .
     1929        repeat c-c = 1 to sheetf.excel-row-title :
     1930        num#str# = num#str# + 1 .
     1931        p-var = num-entries( entry (c-c, sheetf.excel-column-lable, chr(10)) , chr(44) ) .
     1932        do c-i = 1 to p-var :
     1933           str--1 = entry( c-i, entry (c-c,sheetf.excel-column-lable, chr(10)) , chr(44)) .
     1934           str--2 = integer(entry( c-i, sheetf.sizes )) .
     1935           num#col# = c-i .
     1936           run macr_excel_char_with_format ( str--1  , num#str# , num#col#  ) .
     1937           run macr_cell_size ( str--2 , ? , num#str# , num#col# , ?, ? ) .
     1938        end.
     1939       c-i = 0.
     1940       end.
     1941       run macr_cell_format (
     1942           10       ,
     1943           true     ,
     1944           false    ,
     1945           35       ,
     1946           var-1 + 1,
     1947           1        ,
     1948           num#str# ,
     1949           num#col# )
     1950           .
     1951     put  stream macr_excel unformatted
     1952          substitute('select("r&1c&2:r&3c&4 ")' , var-1 + 1 , 1 , num#str# ,  num#col# ) + chr(10)  +
     1953          'ALIGNMENT(3 , , 4 , 4 ,)'  + chr(10)
     1954          .
     1955    end.
     1956   end procedure.
     1957   procedure end-proc :
     1958    do
     1959    on error undo, return error return-value
     1960    :
     1961     v-file-name = ( string( session:temp-directory + "rpt" + string( g#report-num ) ) + ".t-t").
     1962     OUTPUT to VALUE (v-file-name) .
     1963     for each temp-param :
     1964       export  temp-param  .
     1965     end.
     1966    end.
     1967   end procedure.
