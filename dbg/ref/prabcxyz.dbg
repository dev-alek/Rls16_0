      384   procedure create_obj-list :
      385      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      386      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      387      do
      388      on error undo, return error return-value
      389      :
      390         define buffer cli-obj for ub.clients .
      391         define variable p-var as integer no-undo .
      392         define buffer buf_obj-list for obj-list .
      393         find last buf_obj-list  use-index pi no-error .
      394         if available buf_obj-list
      395         then
      396            p-var = buf_obj-list.obj-id + 1.
      397         else
      398            p-var = 1.
      399         find first cli-obj where
      400                   cli-obj.obj-type = p-obj-type
      401               and cli-obj.obj-code = p-obj-code
      402         no-lock no-error.
      403         if available cli-obj
      404         then do:
      405            create buf_obj-list.
      406            assign
      407               buf_obj-list.obj-id   = p-var
      408               buf_obj-list.obj-code = cli-obj.obj-code
      409               buf_obj-list.obj-type = cli-obj.obj-type
      410               buf_obj-list.obj-name = cli-obj.obj-name
      411               buf_obj-list.db-num   = cli-obj.db-num
      412            .
      413         end.
      414      end.
      415   end.
