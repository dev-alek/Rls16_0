     1286      find first  buf_criterion-analysis no-lock where buf_criterion-analysis.cral-id = buf_abc-analysis.cral-id no-error .
     1287      if not available buf_criterion-analysis  then next.
     1288       create temp-abc.
     1289       assign
     1290       temp-abc.type         = "ABC"
     1291       temp-abc.nn           = var-i
     1292       temp-abc.id           = buf_abc-analysis.abc-id
     1293       temp-abc.db-num       = buf_abc-analysis.db-num
     1294       temp-abc.name         = buf_abc-analysis.abc-name
     1295       temp-abc.des          = buf_abc-analysis.abc-des
