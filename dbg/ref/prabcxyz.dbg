      824   def var vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      825   define temp-table temp-param no-undo   field param-code     as character   field param-sub-code as character   field param-value    as character   index xpk is primary unique param-code param-sub-code   .
      826   procedure paramls-clear :
      827     define buffer buf_temp-param for temp-param .
      828     do
      829     on error undo, return error return-value
      830     :
      831       for each buf_temp-param
      832       on error undo, return error
      833       :
      834         delete buf_temp-param .
      835       end.
      836     end.
      837   end procedure.
      838   procedure paramls-write :
      839     define input  parameter p-code     as character no-undo .
      840     define input  parameter p-sub-code as character no-undo .
      841     define input  parameter p-value    as character no-undo .
      842     define buffer buf_temp-param for temp-param .
      843     do
      844     on error undo, return error return-value
      845     :
      846       find first buf_temp-param
      847         where buf_temp-param.param-code     = p-code
      848           and buf_temp-param.param-sub-code = p-sub-code
      849         no-error .
      850       if not available buf_temp-param then do:
      851         create buf_temp-param .
      852         assign
      853           buf_temp-param.param-code     = p-code
      854           buf_temp-param.param-sub-code = p-sub-code
      855         .
      856       end.
      857       assign
      858         buf_temp-param.param-value = p-value
      859       .
      860     end.
      861   end procedure.
      862   procedure paramls-read :
      863     define input  parameter p-code          as character no-undo .
      864     define input  parameter p-sub-code      as character no-undo .
      865     define input  parameter p-default-value as character no-undo .
      866     define output parameter p-value         as character no-undo .
      867     define buffer buf_temp-param for temp-param .
      868     do
      869     on error undo, return error return-value
      870     :
      871       find first buf_temp-param
      872         where buf_temp-param.param-code     = p-code
      873           and buf_temp-param.param-sub-code = p-sub-code
      874         no-error .
      875       if available buf_temp-param then do:
      876         assign
      877           p-value = buf_temp-param.param-value
      878         .
      879       end.
      880       else do:
      881         assign
      882           p-value = p-default-value
      883         .
      884       end.
      885     end.
      886   end procedure.
      887   procedure paramls-append :
      888     define input  parameter p-code     as character no-undo .
      889     define input  parameter p-sub-code as character no-undo .
      890     define input  parameter p-value    as character no-undo .
      891     define buffer buf_temp-param for temp-param .
      892     do
      893     on error undo, return error return-value
      894     :
      895       find first buf_temp-param
      896            where buf_temp-param.param-code     = p-code
      897              and buf_temp-param.param-sub-code = p-sub-code
      898         no-error .
      899       if not available buf_temp-param then do:
      900         create buf_temp-param .
      901         assign
      902           buf_temp-param.param-code     = p-code
      903           buf_temp-param.param-sub-code = p-sub-code
      904           buf_temp-param.param-value    = p-value
      905         .
      906       end.
      907       else do:
      908           assign
      909               buf_temp-param.param-value = buf_temp-param.param-value + ",":U + p-value
      910           .
      911       end.
      912     end.
      913   end procedure.
      914   function excel-format-dec-to-char returns char (input p-dec as decimal ).
      915     if num-entries(string(p-dec), '.') = 2
      916       then return( entry(1, string(p-dec), '.') + v-delim + entry(2, string(p-dec), '.')) .
      917       else return( string(p-dec)) .
      918   end function.
      919   function format-point-to-comma returns char (input orig as char ) .
      920   define variable rtext as character no-undo .
      921   define variable strt as integer no-undo .
      922   define variable leng as integer no-undo .
      923   assign rtext = orig .
      924   repeat:
      925     strt =  index(rtext,'.').
      926     if strt = 0 then leave.
      927     leng = 1.
      928     substring(rtext,strt,leng,"character") = v-delim .
      929   end.
      930   return rtext.
      931   end function.
      932   function format-excel-text returns char ( input start-text as char ) :
      933   def var  i    as int no-undo.
      934   def var  ch   as char no-undo.
      935   def var  n    as int no-undo.
      936   def var  ipos as int no-undo.
      937     n = num-entries(trim(start-text), chr(10)) - 1 .
      938     do i = 1 to n :
      939       ipos = index( start-text, chr(10)).
      940       if ipos > 0 then
      941         substr( start-text, ipos, 1 ) = ' '.
      942     end.
      943     n = num-entries(trim(start-text), chr(13)) - 1 .
      944     do i = 1 to n :
      945       ipos = index( start-text, chr(13)).
      946       if ipos > 0 then
      947         substr( start-text, ipos, 1 ) = ' '.
      948     end.
      949     if index( start-text, '"' ) = 0 then
      950       start-text =  '="'   + trim( start-text) + '"'   .
      951       else do:
      952         n = num-entries(trim(start-text), '"') - 1.
      953         do i = 1 to n :
      954           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
      955         end.
      956         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
      957         start-text = '="'  + ch  + '"' .
      958       end.
      959     return start-text.
      960   end.
      961   function excel-sum returns char (input p-dec as decimal ).
      962     return(format-excel-text(excel-format-dec-to-char(round(p-dec,2)))) .
      963   end function.
      964   function excel-qnty returns char (input p-dec as decimal ).
      965     return(format-excel-text(excel-format-dec-to-char(round(p-dec,3)))) .
      966   end function.
      967   function format-excel-text-macr returns char ( input start-text as char ) :
      968   def var  i    as int no-undo.
      969   def var  ch   as char no-undo.
      970   def var  n    as int no-undo.
      971   def var  ipos as int no-undo.
      972     n = num-entries(trim(start-text), chr(10)) - 1 .
      973     do i = 1 to n :
      974       ipos = index( start-text, chr(10)).
      975       if ipos > 0 then
      976         substring( start-text, ipos , 1 ) = ' '.
      977     end.
      978     n = num-entries(trim(start-text), chr(13)) - 1 .
      979     do i = 1 to n :
      980       ipos = index( start-text, chr(13)).
      981       if ipos > 0 then
      982         substring( start-text, ipos, 1 ) = ' '.
      983     end.
      984     if index( start-text, '"' ) = 0 then
      985       start-text =  '"'   + trim( start-text) + '"'   .
      986       else do:
      987         n = num-entries(trim(start-text), '"') - 1.
      988         do i = 1 to n :
      989           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
      990         end.
      991         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
      992         start-text = '"'  + ch  + '"' .
      993       end.
      994     n = num-entries(trim(start-text), chr(10)) - 1 .
      995     do i = 1 to n :
      996       ipos = index( start-text, chr(10)).
      997       if ipos > 0 then
      998         substring( start-text, ipos , 1 ) = ' '.
      999     end.
     1000       if num-entries(trim(start-text), chr(10)) > 1 then  message num-entries(trim(start-text), chr(10)) start-text.
     1001     return start-text.
     1002   end.
     1003   def var vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1004   function func-get-name-from-ext-type   returns char
     1005     ( p-ext-type as character   ,
     1006       p-caps     as logical ).
     1007   define variable v-ext-name as character no-undo .
     1008   run get-name-from-ext-type in this-procedure (
     1009       input p-ext-type  ,
     1010       input p-caps  ,
     1011       output v-ext-name )
     1012       no-error .
     1013       if error-status :error then do:
     1014          assign
     1015            v-ext-name = p-ext-type
     1016          .
     1017       end.
     1018    return (v-ext-name) .
     1019   end.
     1020   procedure get-name-from-ext-type :
     1021    do
     1022    on error undo, return error return-value
     1023    :
     1024   define input  parameter p-ext-type as character no-undo .
     1025   define input  parameter p-caps     as logical no-undo   .
     1026   define output parameter p-ext-name as character no-undo .
     1027   define variable v-num as integer no-undo .
     1028     if lookup ( p-ext-type , 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U ) = 0 then do :
     1029       message
     1030         vss-include-info10 skip
     1031         "Неправильно задано значение входящего параметра! "
     1032         "Нет такого типа документов " p-ext-type
     1033         view-as alert-box error .
     1034         undo, return error .
     1035     end.
     1036     v-num      = lookup ( p-ext-type , 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U ) .
     1037     p-ext-name = entry  ( v-num , 'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U ) .
     1038     if p-caps  = true then do :
     1039        p-ext-name = caps(substring(p-ext-name,1,1) ) + substring(p-ext-name, 2 , length (p-ext-name) - 1 ) .
     1040     end .
