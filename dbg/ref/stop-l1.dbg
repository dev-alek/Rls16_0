        1   block-level on error undo, throw.
        2   define input parameter p-silent as logical no-undo .
        3   define output parameter p-stop-list-code as character no-undo .
        4   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        5   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        6   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile: stop-l1.p $":U .
        8   define variable vss-archive     as character no-undo init "$Archive: ref/stop-l1.p $":U .
        9   define variable vss-description as character no-undo init "Создание нового стоплиста ДК".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   define new global shared variable g#library  as handle no-undo .
       69   define new global shared variable g#library2 as handle no-undo .
       70   define   shared variable g#auto as logical no-undo.
       71   define   shared variable g#news as logical no-undo.
       72   define   shared variable g#oxml as logical no-undo.
       73   define   shared variable g#esys as logical no-undo.
       74   define   shared variable g#news-source-db as integer no-undo.
       75   define   shared variable g#esys-source-esys as integer no-undo.
       76   define   shared variable g#db-num as integer   no-undo .
       77   define   shared variable g#userid as character no-undo .
       78   define   shared variable g#passwd as character no-undo .
       79   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       80   procedure cur-time :
       81      define output parameter p-today as date      no-undo .
       82      define output parameter p-time  as integer   no-undo .
       83     do
       84     on error undo, return error
       85     :
       86       define variable v-date1 as date      no-undo .
       87       define variable v-date2 as date      no-undo .
       88       define variable v-time  as integer   no-undo .
       89       assign
       90         v-date1 = today
       91         v-time  = time
       92         v-date2 = today
       93       .
       94       if v-date1 <> v-date2
       95       then do:
       96         assign
       97           v-date1 = today
       98           v-time  = v-time
       99         .
      100       end.
      101       assign
      102         p-today = v-date1
      103         p-time  = v-time
      104       .
      105     end.
      106   end.
      107   function cur-time-date returns character
      108   :
      109     return string(today, '99/99/9999':U) .
      110   end.
      111   function cur-time-mjd returns decimal
      112   :
      113     define variable v-date as date      no-undo .
      114     define variable v-time as integer   no-undo .
      115     run cur-time in this-procedure
      116       (output v-date
      117       ,output v-time
      118       ) .
      119     return integer(v-date) - 2400002 + (v-time / 86400) .
      120   end.
      121   function cur-time-get-ending-index returns integer
      122   (input p-number as integer
      123   )
      124   :
      125     if p-number < 0
      126     or p-number = ?
      127     then do:
      128       return 1 .
      129     end.
      130     define variable v-rest as integer   no-undo .
      131     assign
      132       p-number = p-number modulo 100
      133     .
      134     if p-number < 20
      135     then do:
      136       assign
      137         v-rest = p-number
      138       .
      139     end.
      140     else do:
      141       assign
      142         v-rest = p-number modulo 10
      143       .
      144     end.
      145     case v-rest :
      146       when 1
      147       then do:
      148         return 2 .
      149       end.
      150       when 2 or
      151       when 3 or
      152       when 4
      153       then do:
      154         return 3 .
      155       end.
      156       otherwise do:
      157         return 1 .
      158       end.
      159     end case .
      160   end.
      161   procedure cur-time-mjd-to-date :
      162      define input  parameter i-mjd-diff as decimal no-undo.
      163      define output parameter o-Date     as date    no-undo.
      164      define output parameter o-Time     as integer no-undo.
      165      define variable v-day-number as integer   no-undo .
      166      if    i-mjd-diff < 0
      167         or i-mjd-diff = ?
      168      then do:
      169         return "?" .
      170      end.
      171      assign
      172         v-day-number = truncate(i-mjd-diff,0).
      173         o-Date = date(v-day-number + 2400002).
      174         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      175     .
      176   end.
      177   function cur-time-mjd-to-string returns character
      178   (input p-mjd-diff as decimal
      179   )
      180   :
      181     define variable v-day-number as integer   no-undo .
      182     define variable v-seconds    as integer   no-undo .
      183     define variable v-hour       as integer   no-undo .
      184     define variable v-min        as integer   no-undo .
      185     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      186     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      187     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      188     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      189     if p-mjd-diff < 0
      190     or p-mjd-diff = ?
      191     then do:
      192       return "?" .
      193     end.
      194     assign
      195       v-day-number = integer(truncate(p-mjd-diff,0))
      196       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      197     .
      198     if v-seconds > 86400
      199     then do:
      200       assign
      201         v-seconds = 86400 - 1
      202       .
      203     end.
      204     if v-seconds < 0
      205     then do:
      206       assign
      207         v-seconds = 0
      208       .
      209     end.
      210     assign
      211       v-hour = truncate(v-seconds / 3600, 0)
      212     .
      213     assign
      214       v-seconds = v-seconds modulo 3600
      215     .
      216     assign
      217       v-min = truncate(v-seconds / 60, 0)
      218     .
      219     assign
      220       v-seconds = v-seconds modulo 60
      221     .
      222     return
      223         (if v-day-number <> 0
      224           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      225           else ""
      226         )
      227       + (if v-day-number <> 0 or v-hour <> 0
      228           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      229           else ""
      230         )
      231       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      232           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      233           else ""
      234         )
      235       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      236       .
      237   end.
      238   function cur-time-string returns character
      239   :
      240     define variable v-date as date      no-undo .
      241     define variable v-time as integer   no-undo .
      242     run cur-time in this-procedure
      243       (output v-date
      244       ,output v-time
      245       ) .
      246     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      247   end.
      248   function cur-time-string-sec returns character
      249   :
      250     define variable v-date as date      no-undo .
      251     define variable v-time as integer   no-undo .
      252     run cur-time in this-procedure
      253       (output v-date
      254       ,output v-time
      255       ) .
      256     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      257   end.
      258   function cur-time-custom  returns character
      259   (input p-prefix as character
      260   ,input p-date-format as character
      261   ,input p-delimiter as character
      262   ,input p-time-format as character
      263   ,input p-suffix as character
      264   )
      265   :
      266     define variable v-date as date      no-undo .
      267     define variable v-time as integer   no-undo .
      268     run cur-time in this-procedure
      269       (output v-date
      270       ,output v-time
      271       ) .
      272     return
      273       p-prefix
      274       + string(v-date, p-date-format)
      275       + p-delimiter
      276       + string(v-time, p-time-format)
      277       + p-suffix
      278       .
      279   end.
      280   function cur-time-print  returns character
      281   :
      282     define variable v-date as date      no-undo .
      283     define variable v-time as integer   no-undo .
      284     run cur-time in this-procedure
      285       (output v-date
      286       ,output v-time
      287       ) .
      288     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      289   end.
      290   function cur-time-datetime returns datetime
      291   :
      292     define variable v-char as character no-undo .
      293     define variable v-datetime as datetime no-undo .
      294     v-char = cur-time-string().
      295     v-datetime = datetime(v-char).
      296     return  v-datetime.
      297   end.
      298   function cur-time-string-msec returns character
      299   :
      300     define variable v-date as datetime  no-undo .
      301     v-date = now.
      302     return string(v-date) .
      303   end.
      304   DEFINE VARIABLE v-today as date no-undo .
      305   DEFINE VARIABLE v-time as integer no-undo .
      306   define variable v-doc-date as date no-undo .
      307   define variable v-fact-date as date no-undo .
      308   define variable v-status_ as character no-undo .
      309   define variable v-fact-time as integer no-undo .
      310   define variable v-mess as character no-undo .
      311   define buffer buf_stop-list for ub.stop-list.
      312   main-block:
      313   do
      314   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      315   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      316   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      317   :
      318     if g#db-num > 0 then do:
      319       undo, return error "Нельзя создавать стоплисты в УБД".
      320     end.
      321     find last buf_stop-list no-lock where
      322            buf_stop-list.classif-type = 'dis-card':U
      323             no-error .
      324     if not available buf_stop-list then do:
      325       p-stop-list-code = STRING(1, "999999999").
      326     end.
      327     ELSE DO:
      328         if buf_stop-list.status_ <> 'факт':U then do:
      329           v-mess =
      330           substitute("Предыдущий стоплист &1 не закрыт до статуса &2&3Добавление невозможно"
      331                     ,buf_stop-list.stop-list-code
      332                     ,'факт':U
      333                     ,chr(10)).
      334           if not p-silent then do:
      335             message v-mess
      336             view-as alert-box error .
      337           end.
      338           undo, return error (if p-silent = yes then v-mess else '':U).
      339         end.
      340         p-stop-list-code = STRING(next-value(s-stop-list, ub), "999999999").
      341     END.
      342     run cur-time in this-procedure ( output v-today, output v-time).
      343     assign
      344     v-doc-date = v-today
      345     v-fact-date = ?
      346     v-fact-time = 0
      347     v-status_ = '':U
      348     .
      349     create buf_stop-list.
      350     assign
      351     buf_stop-list.classif-type = 'dis-card':U
      352     buf_stop-list.stop-list-code = p-stop-list-code
      353     buf_stop-list.doc-date = v-doc-date
      354     buf_stop-list.status_ = 'новый':U
      355     .
      356     release buf_stop-list no-error.
      357     if error-status:error then do:
      358       v-mess =  substitute("Ошибка при записи шапки стоплиста &1&2" +
      359                               "&3&2&4"
      360                               ,p-stop-list-code
      361                               ,chr(10)
      362                               ,error-status:get-message(1)
      363                               ,return-value ).
      364       if not p-silent then do:
      365         message v-mess
      366         view-as alert-box error .
      367       end.
      368       undo, return error (if p-silent = yes then v-mess else '':U).
      369     end.
      370   end.
