        1   DEFINE BUFFER x-criterion-analysis FOR ub.criterion-analysis.
        2   define input  parameter parParentProc AS WIDGET-HANDLE NO-UNDO.
        3   define input  parameter bttns         as char   no-undo  .
        4   define input  parameter p-mode        as char   no-undo .
        5   define output parameter p-rid-list    as  char no-undo .
        6   define variable vss-revision    as character no-undo init "$Revision$":U .
        7   define variable vss-author      as character no-undo init "$Author$":U .
        8   define variable vss-date        as character no-undo init "$Date$":U .
        9   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       10   define variable vss-archive     as character no-undo init "$Archive$":U .
       11   define variable vss-description as character no-undo init "Критерии анализа".
       12   procedure vss-get-info :
       13     define output parameter p-vss-revision    like vss-revision    no-undo .
       14     define output parameter p-vss-author      like vss-author      no-undo .
       15     define output parameter p-vss-date        like vss-date        no-undo .
       16     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       17     define output parameter p-vss-archive     like vss-archive     no-undo .
       18     define output parameter p-vss-description like vss-description no-undo .
       19     assign
       20       p-vss-revision    = vss-revision
       21       p-vss-author      = vss-author
       22       p-vss-date        = vss-date
       23       p-vss-workfile    = vss-workfile
       24       p-vss-archive     = vss-archive
       25       p-vss-description = vss-description
       26     .
       27   end procedure.
       28   procedure vss-get-parameters :
       29     define output parameter p-vss-parameters as character no-undo .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define new global shared variable g#language as character no-undo .
       67   if g#language <> '' and g#language <> 'rus':U then do:
       68     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       69   end.
       70   define new global shared variable g#library  as handle no-undo .
       71   define new global shared variable g#library2 as handle no-undo .
       72   define   shared variable g#auto as logical no-undo.
       73   define   shared variable g#news as logical no-undo.
       74   define   shared variable g#oxml as logical no-undo.
       75   define   shared variable g#esys as logical no-undo.
       76   define   shared variable g#news-source-db as integer no-undo.
       77   define   shared variable g#esys-source-esys as integer no-undo.
       78   define   shared variable g#db-num as integer   no-undo .
       79   define   shared variable g#userid as character no-undo .
       80   define   shared variable g#passwd as character no-undo .
       81   procedure proc-alt-shift-f2:
       82     if not ibs.th.gbl.gbl-var:rcode
       83   then
       84     run gbl\inidebug.p .
       85   end.
       86   procedure proc-alt-shift-f3:
       87     run gbl/prvssinf.p
       88       ( input this-procedure
       89       ) .
       90   end.
       91   define variable v-inform-launched as logical no-undo initial false .
       92   procedure proc-alt-shift-f4:
       93     define variable v-action as character no-undo .
       94     if v-inform-launched = false then do:
       95       assign
       96         v-inform-launched = true
       97       .
       98       run gbl/d-inform.w
       99         (  input self
      100         ,  input this-procedure
      101         , output v-action
      102         ) no-error .
      103       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      104       assign
      105         v-inform-launched = false
      106       .
      107     end.
      108   end.
      109   procedure proc-alt-f1:
      110     run gbl/corrhelp.p
      111       (input this-procedure
      112       ) .
      113   end .
      114   on alt-shift-f2 anywhere do:
      115     run proc-alt-shift-f2.
      116   end.
      117   on alt-shift-f3 anywhere do:
      118     run proc-alt-shift-f3 in this-procedure .
      119   end.
      120   on alt-shift-f4 anywhere do:
      121     run proc-alt-shift-f4 in this-procedure.
      122   end.
      123   on alt-f1 anywhere do:
      124     run proc-alt-f1 in this-procedure .
      125   end.
      126   define variable p-mark as character no-undo .
      127   define variable ok# as logical   no-undo .
      128   FUNCTION mark-string RETURNS CHARACTER
      129   ( BUFFER loc-table FOR x-criterion-analysis, input mark-list as CHARACTER )  FORWARD.
      130   DEFINE BUTTON B-act
      131        LABEL "&Активен"
      132        SIZE 12 BY 1.
      133   DEFINE BUTTON B-Help
      134        LABEL "Помо&щь"
      135        SIZE 14 BY 1
      136        BGCOLOR 8 .
      137   DEFINE BUTTON B-mark
      138        LABEL "&*"
      139        SIZE 3 BY 1.
      140   DEFINE BUTTON B-not-act
      141        LABEL "&Не активен"
      142        SIZE 14 BY 1.
      143   DEFINE BUTTON B-print
      144        LABEL "Пе&чать"
      145        SIZE 12 BY 1.
      146   DEFINE BUTTON b-quit AUTO-END-KEY
      147        LABEL "&Выход"
      148        SIZE 10 BY 1
      149        BGCOLOR 8 .
      150   DEFINE BUTTON B-sel AUTO-GO
      151        LABEL "Вы&бор"
      152        SIZE 10 BY 1.
      153   DEFINE VARIABLE mark-num AS CHARACTER FORMAT "X(256)":U
      154         VIEW-AS TEXT
      155        SIZE 3 BY 1
      156        FGCOLOR 4  NO-UNDO.
      157   DEFINE QUERY BROWSE-5 FOR
      158         x-criterion-analysis SCROLLING.
      159   DEFINE QUERY Dialog-Frame FOR
      160         x-criterion-analysis SCROLLING.
      161   DEFINE BROWSE BROWSE-5
      162     QUERY BROWSE-5 NO-LOCK DISPLAY
      163         mark-string(buffer x-criterion-analysis , p-rid-list) @ p-mark COLUMN-LABEL "*" FORMAT "x(1)":U
      164         x-criterion-analysis.cral-id COLUMN-LABEL "Код" FORMAT ">>9":U
      165         x-criterion-analysis.cral-name COLUMN-LABEL "Название" FORMAT "X(35)":U
      166         IF (x-criterion-analysis.cral-status = 0 ) THEN ("Активен") ELSE ("Не активен") COLUMN-LABEL "Статус" FORMAT "x(10)":U
      167     ENABLE
      168         x-criterion-analysis.cral-id
      169       WITH NO-ROW-MARKERS SEPARATORS SIZE 57 BY 14.25 EXPANDABLE.
      170   DEFINE FRAME Dialog-Frame
      171        BROWSE-5 AT ROW 3 COL 1.5
      172        B-sel AT ROW 1 COL 17
      173        b-quit AT ROW 1 COL 1
      174        B-mark AT ROW 1 COL 11
      175        B-act AT ROW 1 COL 32.5
      176        B-not-act AT ROW 1 COL 44.5
      177        B-print AT ROW 2 COL 32.5
      178        B-Help AT ROW 2 COL 44.5
      179        ub.x-criterion-analysis.cral-des AT ROW 17.5 COL 1.5 NO-LABEL
      180             VIEW-AS EDITOR SCROLLBAR-VERTICAL
      181             SIZE 57 BY 4
      182        mark-num AT ROW 1 COL 12 COLON-ALIGNED NO-LABEL
      183        SPACE(41.50) SKIP(19.70)
      184       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      185            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      186            TITLE "Критерии анализа"
      187            DEFAULT-BUTTON B-sel.
      188   ASSIGN
      189          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      190          FRAME Dialog-Frame:HIDDEN           = TRUE.
      191   ASSIGN
      192          x-criterion-analysis.cral-id:COLUMN-READ-ONLY IN BROWSE BROWSE-5 = TRUE.
      193   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      194   DO:
      195     APPLY "END-ERROR":U TO SELF.
      196   END.
      197   ON CHOOSE OF B-act IN FRAME Dialog-Frame
      198   DO:
      199   find current x-criterion-analysis exclusive-lock no-error .
      200   if available x-criterion-analysis then do:
      201     x-criterion-analysis.cral-status = 0 .
      202     ok# = BROWSE-5:refresh() .
      203   end.
      204   END.
      205   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
      206   DO:
      207     define variable loc#log as logical no-undo .
      208     if AVAILABLE x-criterion-analysis  then do:
      209   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      210   define variable v-str-recid1 as character no-undo .
      211   define variable v-num-entry1 as integer   no-undo .
      212   assign
      213     v-str-recid1 = trim( string( recid( x-criterion-analysis ) , "->>>>>>>>>>>9":U ) )
      214     v-num-entry1 = lookup( v-str-recid1 , p-rid-list )
      215   .
      216   if v-num-entry1 > 0 then do:
      217     assign
      218       entry( v-num-entry1, p-rid-list ) = "":U
      219       p-rid-list = trim( replace( p-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
      220     .
      221   end.
      222   else do:
      223     assign
      224       p-rid-list = p-rid-list + ( if p-rid-list = "":U then "":U else chr(44) ) + v-str-recid1
      225     .
      226   end.
      227       loc#log = BROWSE-5:refresh() .
      228       if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
      229           loc#log = BROWSE-5:select-next-row ().
      230           apply "VALUE-CHANGED" to BROWSE-5 in frame Dialog-Frame.
      231       end.
      232       if num-entries( p-rid-list ) = 0
      233       then
      234           hide mark-num in frame Dialog-Frame.
      235       else
      236           disp num-entries( p-rid-list ) @ mark-num with frame Dialog-Frame.
      237     end.
      238     apply "entry" to BROWSE-5 in frame Dialog-Frame.
      239   END.
      240   ON CHOOSE OF B-not-act IN FRAME Dialog-Frame
      241   DO:
      242   find current x-criterion-analysis exclusive-lock no-error .
      243   if available x-criterion-analysis then do:
      244     x-criterion-analysis.cral-status = 1 .
      245     ok# = BROWSE-5:refresh() .
      246   end.
      247   END.
      248   ON CHOOSE OF B-print IN FRAME Dialog-Frame
      249   DO:
      250     run proc-b-print in this-procedure no-error.
      251     if error-status:error then do:
      252       return no-apply.
      253     end.
      254   END.
      255   ON CHOOSE OF B-sel IN FRAME Dialog-Frame
      256   DO:
      257      IF  p-rid-list = "" THEN DO:
      258         IF AVAILABLE x-criterion-analysis  THEN p-rid-list = string(RECID(x-criterion-analysis )).
      259     END.
      260   END.
      261   ON MOUSE-SELECT-DBLCLICK OF BROWSE-5 IN FRAME Dialog-Frame
      262   DO:
      263     APPLY "CHOOSE":U TO B-sel in frame Dialog-Frame.
      264   END.
      265   ON VALUE-CHANGED OF BROWSE-5 IN FRAME Dialog-Frame
      266   DO:
      267     IF AVAILABLE x-criterion-analysis THEN
      268        DISPLAY x-criterion-analysis.cral-des WITH FRAME Dialog-Frame.
      269   END.
      270   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      271   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      272   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      273   on help of frame Dialog-Frame
      274   do:
      275     run gbl/app_help.p
      276       (input this-procedure :file-name
      277       ,input ''
      278       ,input ?
      279       ) no-error.
      280     if error-status :error then do:
      281       message
      282         "Ошибка при вызове помощи"
      283         error-status :get-message(1)
      284         view-as alert-box .
      285     end.
      286   end.
      287   run minbtn-set in this-procedure .
      288   on choose of b-help in frame Dialog-Frame
      289   do:
      290     apply "help":u to frame Dialog-Frame .
      291   end.
      292   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      293   procedure minbtn-set :
      294       do
      295           on error undo, return error return-value
      296           :
      297           define variable ii              as integer       no-undo .
      298           define variable fh              as widget-handle no-undo .
      299           define variable hh              as widget-handle no-undo .
      300           define variable v-h             as handle        extent 4 no-undo .
      301           define variable v-name-button   as character     no-undo .
      302           define variable v-help-old-x    as decimal       no-undo .
      303           define variable v-help-old-y    as decimal       no-undo .
      304           define variable v-help-old-size as decimal       no-undo .
      305           define variable v-frame-width   as decimal       no-undo .
      306           define variable jj              as integer       no-undo .
      307           do
      308               on error undo, return error
      309               :
      310               assign
      311                   v-frame-width = frame Dialog-Frame:width - 0.3
      312                   fh            = frame Dialog-Frame:first-child
      313                   hh            = fh:first-child
      314                   ii            = 1
      315                   .
      316               do while valid-handle(hh):
      317                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      318                   do:
      319                       case lc(hh:name) :
      320                           when "b-help" then
      321                               do:
      322                                   hh:load-image-up("cmp/b-help.bmp":u) .
      323                                   hh:load-image-down("cmp/b-help.bmp":u) .
      324                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      325                                   hh:TOOLTIP = "Помощь" .
      326                                   v-help-old-x = hh:column .
      327                                   v-help-old-y = hh:row    .
      328                                   v-help-old-size = hh:width .
      329                                   hh:width-chars = 2.5 .
      330                               end.
      331                           when "b-print" then
      332                               do:
      333                                   hh:load-image("cmp/b-print.bmp":u) .
      334                                   hh:TOOLTIP = "Печать" .
      335                                   v-h[ii] = hh:handle .
      336                                   ii = ii + 1 .
      337                                   hh:width-chars = 3 .
      338                               end.
      339                           when "b-history" or
      340                           when "b-hist" then
      341                               do:
      342                                   hh:load-image("cmp/b-hist.bmp":u) .
      343                                   hh:TOOLTIP = "История" .
      344                                   v-h[ii] = hh:handle .
      345                                   ii = ii + 1 .
      346                                   hh:width-chars = 3 .
      347                               end.
      348                           when "b-sch" then
      349                               do:
      350                                   hh:load-image("cmp/b-sch.bmp":u) .
      351                                   hh:TOOLTIP = "Установка Фильтра" .
      352                                   v-h[ii] = hh:handle .
      353                                   ii = ii + 1 .
      354                                   hh:width-chars = 3 .
      355                               end.
      356                           when "b-hist-user" then
      357                               do:
      358                                   hh:load-image("cmp/b-hist.bmp":u) .
      359                                   hh:TOOLTIP = "История пользователя" .
      360                                   ii = ii + 1 .
      361                               end.
      362                       end case.
      363                   end.
      364                   hh = hh:next-sibling.
      365               end.
      366               b-help:column = v-frame-width - b-help:width-chars.
      367               jj = 0.
      368               repeat ii = 4 to 1 by -1 :
      369                   if valid-handle (v-h[ii] ) then
      370                   do:
      371                       jj  = jj + 1 .
      372                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      373                       v-h[ii]:row    = v-help-old-y .
      374                   end.
      375               end.
      376           end.
      377       end.
      378   end procedure.
      379   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      380   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      381   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      382   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      383   define variable v-diasize-current-frame-width  as decimal   no-undo .
      384   define variable v-diasize-current-frame-height as decimal   no-undo .
      385   define variable v-diasize-change-size          as logical   no-undo .
      386   define variable v-diasize-resize-button        as handle    no-undo .
      387   define variable v-diasize-wndmax               as logical   no-undo .
      388   define variable v-diasize-wndstore             as logical   no-undo .
      389   define variable v-diasize-proc-name            as character no-undo .
      390   define variable v-diasize-browse-handle        as handle    no-undo .
      391   define variable v-diasize-browse-number        as integer   no-undo .
      392   define variable v-diasize-need-full-display    as logical   no-undo init false .
      393   define temp-table temp-diasize-handle no-undo
      394     field handle-value  as handle
      395     field save-position as decimal
      396     index xpk is primary unique handle-value
      397     .
      398   define temp-table temp-browse-handle no-undo
      399     field browse-type   as character
      400     field browse-number as integer
      401     field browse-handle as handle
      402     field original-size as decimal
      403     index xpk is primary unique browse-type browse-number
      404     index xie browse-type browse-handle
      405   .
      406   procedure diasize_change-height :
      407     define input  parameter p-change-value  as decimal   no-undo .
      408     define input  parameter p-move-resize   as logical   no-undo .
      409     define variable v-field-group-handle    as handle    no-undo .
      410     define variable v-object-handle         as handle    no-undo .
      411     define variable v-frame-height          as decimal   no-undo .
      412     define variable v-frame-virtual-height  as decimal   no-undo .
      413     define variable v-browse-height         as decimal   no-undo .
      414     define variable v-window-height         as decimal   no-undo .
      415     define variable v-window-virtual-height as decimal   no-undo .
      416     define variable v-change-sign           as integer   no-undo .
      417     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      418     define buffer buf_temp-browse-handle  for temp-browse-handle .
      419     if p-change-value > 0
      420     then do:
      421       if frame Dialog-Frame :height + p-change-value
      422           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      423       then do:
      424         assign
      425           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      426                           - (frame Dialog-Frame :height-chars)
      427         .
      428         if p-change-value <= 0
      429         then do:
      430           run diasize_position-resize-button in this-procedure .
      431           return .
      432         end.
      433       end.
      434     end.
      435     if p-change-value < 0
      436     then do:
      437       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      438       then do:
      439         assign
      440           p-change-value = v-diasize-orig-frame-height
      441                          - (frame Dialog-Frame :height-chars)
      442         .
      443         if p-change-value >= 0
      444         then do:
      445           run diasize_position-resize-button in this-procedure .
      446           return .
      447         end.
      448       end.
      449     end.
      450     if p-change-value >= 0
      451     then do:
      452       assign
      453         v-change-sign = 1
      454       .
      455     end.
      456     else do:
      457       assign
      458         v-change-sign = -1
      459       .
      460     end.
      461     assign
      462       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      463     .
      464     if p-change-value = 0
      465     then do:
      466       run diasize_position-resize-button in this-procedure .
      467       return .
      468     end.
      469     move_block:
      470     do
      471     on error undo move_block, retry move_block
      472     :
      473       if retry
      474       then do:
      475         do
      476         on error undo move_block, leave move_block
      477         :
      478           if p-change-value > 0
      479           then do:
      480             for each buf_temp-diasize-handle
      481             on error undo, next
      482             :
      483               assign
      484                 v-object-handle = buf_temp-diasize-handle.handle-value
      485               .
      486               if v-object-handle <> v-diasize-resize-button
      487               then do:
      488                 assign
      489                   v-object-handle :row = buf_temp-diasize-handle.save-position
      490                 .
      491               end.
      492             end.
      493             assign
      494               v-diasize-browse-handle :height = v-browse-height
      495             .
      496             for each buf_temp-browse-handle
      497               where buf_temp-browse-handle.browse-type = 'height':u
      498             on error undo, next
      499             :
      500               assign
      501                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      502               .
      503             end.
      504             assign
      505               frame Dialog-Frame :height = v-frame-height
      506             .
      507             if frame Dialog-Frame :scrollable = true
      508             then do:
      509               assign
      510                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      511               .
      512             end.
      513             run diasize_position-resize-button in this-procedure .
      514           end.
      515           else do:
      516             if frame Dialog-Frame :scrollable = true
      517             then do:
      518               assign
      519                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      520               .
      521             end.
      522             assign
      523               frame Dialog-Frame :height = v-frame-height
      524             .
      525             assign
      526               v-diasize-browse-handle :height = v-browse-height
      527             .
      528             for each buf_temp-browse-handle
      529               where buf_temp-browse-handle.browse-type = 'height':u
      530             on error undo, next
      531             :
      532               assign
      533                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      534               .
      535             end.
      536             for each buf_temp-diasize-handle
      537             on error undo, next
      538             :
      539               assign
      540                 v-object-handle = buf_temp-diasize-handle.handle-value
      541               .
      542               if v-object-handle <> v-diasize-resize-button
      543               then do:
      544                 assign
      545                   v-object-handle :row = buf_temp-diasize-handle.save-position
      546                 .
      547               end.
      548             end.
      549             run diasize_position-resize-button in this-procedure .
      550           end.
      551           assign
      552             v-diasize-change-size = false
      553           .
      554           leave move_block .
      555         end.
      556       end.
      557       assign
      558         v-diasize-need-full-display = true
      559       .
      560       if v-diasize-change-size = false
      561       then do:
      562         assign
      563           v-diasize-change-size = true
      564         .
      565       end.
      566       else do:
      567         return .
      568       end.
      569       assign
      570         v-frame-height = frame Dialog-Frame :height
      571         v-frame-virtual-height = frame Dialog-Frame :virtual-height
      572         v-browse-height = v-diasize-browse-handle :height
      573       .
      574       for each buf_temp-browse-handle
      575         where buf_temp-browse-handle.browse-type = 'height':u
      576       :
      577         assign
      578           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
      579         .
      580       end.
      581       for each buf_temp-diasize-handle
      582       :
      583         delete buf_temp-diasize-handle .
      584       end.
      585       assign
      586         v-field-group-handle = frame Dialog-Frame :first-child
      587       .
      588       do while valid-handle(v-field-group-handle)
      589       :
      590         assign
      591           v-object-handle = v-field-group-handle :first-child
      592         .
      593         do while valid-handle(v-object-handle)
      594         :
      595           if  v-object-handle <> v-diasize-browse-handle :handle
      596           and can-query(v-object-handle, "row")
      597           and can-query(v-object-handle, "height")
      598           and ( v-object-handle :row > v-diasize-browse-handle :row )
      599           then do:
      600             find first buf_temp-browse-handle
      601               where buf_temp-browse-handle.browse-type   = 'height':u
      602                 and buf_temp-browse-handle.browse-handle = v-object-handle
      603               no-error .
      604             if available buf_temp-browse-handle
      605             then do:
      606             end.
      607             else do:
      608               create buf_temp-diasize-handle .
      609               assign
      610                 buf_temp-diasize-handle.handle-value  = v-object-handle
      611                 buf_temp-diasize-handle.save-position = v-object-handle :row
      612               .
      613             end.
      614           end.
      615           assign
      616             v-object-handle = v-object-handle :next-sibling
      617           .
      618         end.
      619         assign
      620           v-field-group-handle = v-field-group-handle :next-sibling
      621         .
      622       end.
      623       do with frame Dialog-Frame
      624       :
      625         hide v-diasize-resize-button .
      626         assign
      627           v-diasize-resize-button :row    = 1
      628           v-diasize-resize-button :column = 1
      629         .
      630       end.
      631       if p-change-value > 0
      632       then do:
      633         if frame Dialog-Frame :scrollable = true
      634         then do:
      635           assign
      636             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      637             no-error .
      638           if error-status :error
      639           or error-status :get-message(1) <> ""
      640           then do:
      641             undo move_block, retry move_block .
      642           end.
      643         end.
      644         assign
      645           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      646           no-error .
