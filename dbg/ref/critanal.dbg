      804     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      805     define buffer buf_temp-browse-handle  for temp-browse-handle .
      806     if p-change-value > 0
      807     then do:
      808       if frame Dialog-Frame :width + p-change-value >
      809           session :width-chars
      810       then do:
      811         assign
      812           p-change-value = session :width-chars - frame Dialog-Frame :width
      813         .
      814         if p-change-value <= 0
      815         then do:
      816           run diasize_position-resize-button in this-procedure .
      817           return .
      818         end.
      819       end.
      820     end.
      821     if p-change-value < 0
      822     then do:
      823       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
      824       then do:
      825         assign
      826           p-change-value = v-diasize-orig-frame-width
      827                          - frame Dialog-Frame :width
      828         .
      829         if p-change-value >= 0
      830         then do:
      831           run diasize_position-resize-button in this-procedure .
      832           return .
      833         end.
      834       end.
      835     end.
      836     if p-change-value >= 0
      837     then do:
      838       assign
      839         v-change-sign = 1
      840       .
      841     end.
      842     else do:
      843       assign
      844         v-change-sign = -1
      845       .
      846     end.
      847     assign
      848       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      849     .
      850     if p-change-value = 0
      851     then do:
      852       run diasize_position-resize-button in this-procedure .
      853       return .
      854     end.
