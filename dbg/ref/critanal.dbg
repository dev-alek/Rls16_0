     1179   end procedure.
     1180   procedure diasize_position-resize-button :
     1181     do with frame Dialog-Frame
     1182     :
     1183       hide v-diasize-resize-button .
     1184       assign
     1185         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1186                     - 1
     1187                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1188         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1189                     - 1
     1190                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1191       .
     1192       view v-diasize-resize-button .
     1193     end.
     1194   end procedure.
     1195   on alt-right anywhere
     1196   do:
     1197     run diasize_change-width in this-procedure
     1198       (input 1
     1199       ,input true
     1200       ) .
     1201     return no-apply .
     1202   end.
     1203   on alt-left anywhere
     1204   do:
     1205     run diasize_change-width in this-procedure
     1206       (input -1
     1207       ,input true
     1208       ) .
     1209     return no-apply .
     1210   end.
     1211   on alt-down anywhere
     1212   do:
     1213     run diasize_change-height in this-procedure
     1214       (input 1
     1215       ,input true
     1216       ) .
     1217     return no-apply .
     1218   end.
     1219   on alt-up anywhere
     1220   do:
     1221     run diasize_change-height in this-procedure
     1222       (input -1
     1223       ,input true
     1224       ) .
     1225     return no-apply .
     1226   end.
     1227   on alt-enter of frame Dialog-Frame
     1228   do:
     1229     run diasize_maximize in this-procedure
     1230       (input  ?
     1231       ).
     1232     return no-apply .
     1233   end.
     1234   procedure diasize_end-move :
     1235     do
     1236     on error undo, return error return-value
     1237     :
     1238       define variable v-row-delta as decimal   no-undo .
     1239       define variable v-col-delta as decimal   no-undo .
     1240       define variable v-new-row as decimal   no-undo .
     1241       define variable v-new-col as decimal   no-undo .
     1242       assign
     1243         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1244         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1245       .
     1246       assign
     1247         v-row-delta = v-new-row - frame Dialog-Frame :height
     1248         v-col-delta = v-new-col - frame Dialog-Frame :width
     1249       .
     1250       run diasize_change-height in this-procedure
     1251         (input v-row-delta
     1252         ,input true
     1253         ) .
     1254       run diasize_change-width in this-procedure
     1255         (input v-col-delta
     1256         ,input true
     1257         ) .
     1258     end.
     1259   end procedure.
     1260   procedure diasize_maximize :
     1261     define input  parameter p-action as logical   no-undo .
     1262     do
     1263     on error undo, return error return-value
     1264     :
     1265       if p-action = ?
     1266       then do:
     1267         if v-diasize-need-maximize = true
     1268         then do:
     1269           assign
     1270             p-action = true
     1271           .
     1272         end.
     1273         else do:
     1274           assign
     1275             p-action = false
     1276           .
     1277         end.
     1278       end.
     1279       if p-action = true
     1280       then do:
     1281         run diasize_change-height in this-procedure
     1282           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1283               - frame Dialog-Frame :height-chars
     1284           ,input true
     1285           ) .
     1286         run diasize_change-width in this-procedure
     1287           (input session :width-chars
     1288               - frame Dialog-Frame :width-chars
     1289           ,input true
     1290           ) .
     1291         assign
     1292           v-diasize-need-maximize = false
     1293         .
     1294       end.
     1295       else do:
     1296         run diasize_change-width in this-procedure
     1297           (input v-diasize-orig-frame-width
     1298               - frame Dialog-Frame :width-chars
     1299           ,input true
     1300           ) .
     1301         run diasize_change-height in this-procedure
     1302           (input v-diasize-orig-frame-height
     1303               - frame Dialog-Frame :height-chars
     1304           ,input true
     1305           ) .
     1306         assign
     1307           v-diasize-need-maximize = true
     1308         .
     1309       end.
     1310     end.
     1311   end procedure.
     1312   procedure diasize_restore-orig-size :
     1313     do
     1314     on error undo, return error return-value
     1315     :
     1316       assign
     1317         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1318         v-diasize-current-frame-height = frame Dialog-Frame :height
     1319       .
     1320       run diasize_set-height in this-procedure
     1321         (input  v-diasize-orig-frame-height
     1322         ,input  true
     1323         ) .
     1324       run diasize_set-width in this-procedure
     1325         (input  v-diasize-orig-frame-width
     1326         ,input  true
     1327         ) .
     1328     end.
     1329   end procedure.
     1330   procedure diasize_restore-current-size :
     1331     do
     1332     on error undo, return error return-value
     1333     :
     1334       run diasize_set-height in this-procedure
     1335         (input  v-diasize-current-frame-height
     1336         ,input  true
     1337         ) .
     1338       run diasize_set-width in this-procedure
     1339         (input  v-diasize-current-frame-width
     1340         ,input  true
     1341         ) .
     1342     end.
     1343   end procedure.
     1344   procedure diasize_set-browse-handle :
     1345     define input  parameter p-browse-handle as handle   no-undo .
     1346     define buffer buf_temp-browse-handle for temp-browse-handle .
     1347     do
     1348     on error undo, return error return-value
     1349     :
     1350       assign
     1351         v-diasize-browse-handle = p-browse-handle
     1352       .
     1353       for each buf_temp-browse-handle
     1354       on error undo, return error return-value
     1355       :
     1356         delete buf_temp-browse-handle .
     1357       end.
     1358     end.
     1359   end procedure.
     1360   procedure diasize_add_browse :
     1361     define input  parameter p-browse-type   as character no-undo .
     1362     define input  parameter p-browse-handle as handle    no-undo .
     1363     define buffer buf_temp-browse-handle for temp-browse-handle .
     1364     do
     1365     on error undo, return error return-value
     1366     :
     1367       assign
     1368         v-diasize-browse-number = v-diasize-browse-number + 1
     1369       .
     1370       create buf_temp-browse-handle .
     1371       assign
     1372         buf_temp-browse-handle.browse-type   = p-browse-type
     1373         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1374         buf_temp-browse-handle.browse-handle = p-browse-handle
     1375       .
     1376     end.
     1377   end procedure.
     1378   procedure diasize_init :
     1379     define variable v-default-value    as logical   no-undo .
     1380     define variable v-restore-saved    as logical   no-undo .
     1381     define variable v-resize-value-str as character no-undo .
     1382     do
     1383     on error undo, return error return-value
     1384     :
     1385       do with frame Dialog-Frame
     1386       :
     1387         assign
     1388           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1389           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1390           v-diasize-browse-handle     = browse BROWSE-5 :handle
     1391         .
     1392         create button v-diasize-resize-button
     1393         assign
     1394           parent        = frame Dialog-Frame :first-child
     1395           label         = "s"
     1396           height-pixels = 16
     1397           width-pixels  = 16
     1398           visible       = true
     1399           sensitive     = true
     1400           movable       = true
     1401           triggers:
     1402             on end-move persistent run diasize_end-move in this-procedure .
     1403           end triggers.
     1404         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1405         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1406         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1407         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1408         assign
     1409           v-diasize-wndmax = false
     1410         .
     1411         if connected("ub") = true
     1412         then do:
     1413           define variable v-cntxt-db-num        as integer   no-undo .
     1414           define variable v-cntxt-userid        as character no-undo .
     1415           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1416                                             , OUTPUT v-cntxt-userid
     1417                                             ) .
     1418           run gbl/wndpar_r.p
     1419             (input  v-cntxt-db-num
     1420             ,input  v-cntxt-userid
     1421             ,input  'wndmax':U
     1422             ,output v-diasize-wndmax
     1423             ,output v-default-value
     1424             ) .
     1425         end.
     1426         assign
     1427           v-diasize-wndstore = false
     1428         .
     1429         if connected("ub") = true
     1430         then do:
     1431           run gbl/wndpar_r.p
     1432             (input  v-cntxt-db-num
     1433             ,input  v-cntxt-userid
     1434             ,input  'wndstore':U
     1435             ,output v-diasize-wndstore
     1436             ,output v-default-value
     1437             ) .
     1438         end.
     1439         assign
     1440           v-diasize-proc-name = entry(1, program-name(2), '.')
     1441         .
     1442         if v-diasize-wndstore = true
     1443         then do:
     1444           assign
     1445             v-restore-saved = false
     1446           .
     1447           if connected("ub") = true
     1448           then do:
     1449             run gbl/wndsizer.p
     1450               (input  v-cntxt-db-num
     1451               ,input  v-cntxt-userid
     1452               ,input  v-diasize-proc-name
     1453               ,input  'height':u
     1454               ,output v-resize-value-str
     1455               ) .
     1456             if v-resize-value-str <> '':U
     1457             then do:
     1458               run diasize_change-height in this-procedure
     1459                 (input  integer(v-resize-value-str)
     1460                 ,input  true
     1461                 ) .
     1462               assign
     1463                 v-restore-saved = true
     1464               .
     1465             end.
     1466           end.
     1467           if connected("ub") = true
     1468           then do:
     1469             run gbl/wndsizer.p
     1470               (input  v-cntxt-db-num
     1471               ,input  v-cntxt-userid
     1472               ,input  v-diasize-proc-name
     1473               ,input  'width':u
     1474               ,output v-resize-value-str
     1475               ) .
     1476             if v-resize-value-str <> '':U
     1477             then do:
     1478               run diasize_change-width in this-procedure
     1479                 (input  integer(v-resize-value-str)
     1480                 ,input  true
     1481                 ) .
     1482               assign
     1483                 v-restore-saved = true
     1484               .
     1485             end.
     1486           end.
     1487           if v-restore-saved <> true
     1488           then do:
     1489             if v-diasize-wndmax = true
     1490             then do:
     1491               run diasize_maximize in this-procedure
     1492                 (input  true
     1493                 ) .
     1494             end.
     1495           end.
     1496         end.
     1497         else do:
     1498           if v-diasize-wndmax = true
     1499           then do:
     1500             run diasize_maximize in this-procedure
     1501               (input  true
     1502               ) .
     1503           end.
     1504         end.
     1505       end.
     1506     end.
     1507   end procedure.
     1508   procedure diasize_need-full-display :
     1509     define output parameter p-need-full-display as logical   no-undo .
     1510     do
     1511     on error undo, return error return-value
     1512     :
     1513       assign
     1514         p-need-full-display = v-diasize-need-full-display
     1515       .
     1516       assign
     1517         v-diasize-need-full-display = false
     1518       .
     1519     end.
     1520   end procedure.
     1521   procedure get-context :
     1522      define output parameter p-db-num as integer          no-undo.
     1523      define output parameter p-user-id as character        no-undo.
     1524      define variable v-login               as character    no-undo.
     1525      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1526      define buffer buf_user-login  for ub.user-login .
     1527      do
     1528      on error undo, return error
     1529      :
     1530            FIND FIRST buf_sys-ctrl no-lock.
     1531            ASSIGN
     1532               v-login = USERID("ub")
     1533               p-db-num = buf_sys-ctrl.db-num
     1534            .
     1535            FIND FIRST buf_user-login
     1536                 WHERE buf_user-login.db-num = p-db-num
     1537                   AND buf_user-login.user-login = v-login
     1538                 no-lock
     1539                 no-error
     1540                 .
     1541            IF AVAILABLE buf_user-login
     1542            THEN DO:
     1543               assign
     1544                  p-user-id = buf_user-login.user-id
     1545               .
     1546            END.
     1547      end.
     1548   end procedure.
     1549       run diasize_init in this-procedure .
     1550   MAIN-BLOCK:
     1551   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1552      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1553     x-criterion-analysis.cral-id:READ-ONLY IN browse BROWSE-5      = TRUE.
     1554     run enable_ui.
     1555     run my_enable .
     1556     wait-for go of frame Dialog-Frame focus BROWSE-5 .
     1557   end.
     1558   run disable_ui.
     1559   PROCEDURE disable_UI :
     1560     HIDE FRAME Dialog-Frame.
     1561   END PROCEDURE.
     1562   PROCEDURE enable_UI :
     1563     OPEN QUERY Dialog-Frame FOR EACH x-criterion-analysis SHARE-LOCK.
     1564     GET FIRST Dialog-Frame.
     1565     DISPLAY mark-num
     1566         WITH FRAME Dialog-Frame.
     1567     IF AVAILABLE x-criterion-analysis THEN
     1568       DISPLAY x-criterion-analysis.cral-des
     1569         WITH FRAME Dialog-Frame.
     1570     ENABLE BROWSE-5 b-quit B-act B-not-act B-print B-Help
     1571            x-criterion-analysis.cral-des mark-num
     1572         WITH FRAME Dialog-Frame.
     1573     VIEW FRAME Dialog-Frame.
     1574     OPEN QUERY BROWSE-5 FOR EACH x-criterion-analysis NO-LOCK INDEXED-REPOSITION.
     1575   END PROCEDURE.
     1576   PROCEDURE my_enable :
     1577   DISPLAY mark-num
     1578         WITH FRAME Dialog-Frame.
     1579     IF AVAILABLE x-criterion-analysis THEN
     1580       DISPLAY x-criterion-analysis.cral-des
     1581         WITH FRAME Dialog-Frame.
     1582   x-criterion-analysis.cral-des:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
     1583     ENABLE b-quit
     1584             B-mark  when LOOKUP("b-mark":U, bttns) > 0
     1585             B-sel   when LOOKUP("b-sel":U, bttns) > 0
     1586             B-act
     1587             B-not-act
     1588             B-print
     1589             B-Help
     1590             BROWSE-5
     1591             x-criterion-analysis.cral-des
     1592         WITH FRAME Dialog-Frame.
     1593   END PROCEDURE.
     1594   FUNCTION mark-string RETURNS CHARACTER
     1595   ( BUFFER loc-table FOR x-criterion-analysis, input mark-list as CHARACTER ) :
     1596   RETURN ( IF LOOKUP( STRING( RECID( loc-table ) ), mark-list ) > 0 THEN "*" ELSE "":U ).
     1597   END FUNCTION.
     1598   PROCEDURE proc-b-print :
     1599     message "Не используется"  .
     1600   END PROCEDURE.
