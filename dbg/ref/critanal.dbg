     1168   procedure diasize_set-width :
     1169     define input  parameter p-new-width  as decimal   no-undo .
     1170     define input  parameter p-move-resize as logical   no-undo .
     1171     do
     1172     on error undo, return error return-value
     1173     :
     1174       run diasize_change-width in this-procedure
     1175         (input  (p-new-width - frame Dialog-Frame :width)
     1176         ,input  p-move-resize
     1177         ) .
