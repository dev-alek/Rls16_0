      785     on error undo, return error return-value
      786     :
      787       run diasize_change-height in this-procedure
      788         (input  (p-new-height - frame Dialog-Frame :height)
      789         ,input  p-move-resize
      790         ) .
      791     end.
      792   end procedure.
      793   procedure diasize_change-width :
      794     define input  parameter p-change-value as decimal   no-undo .
      795     define input  parameter p-move-resize  as logical   no-undo .
