        1   block-level on error undo, throw.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define input parameter par-recid as recid no-undo.
        4   define input parameter p-silent                       as logical no-undo .
        5   define input parameter p-has-right-to-restore         as logical no-undo .
        6   define input parameter p-mode2    as character no-undo .
        7   define input parameter p-source-type as character no-undo .
        8   define input parameter p-source-ref as character no-undo .
        9   define input parameter p-curr-obj-type  like ub.clients.obj-type no-undo .
       10   define input parameter p-curr-obj-code  like ub.clients.obj-code no-undo .
       11   define input-output parameter par-status_ as character no-undo .
       12   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       13   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       14   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       15   define variable vss-workfile    as character no-undo init "$Workfile: dcardi02.p $":U .
       16   define variable vss-archive     as character no-undo init "$Archive: ref/dcardi02.p $":U .
       17   define variable vss-description as character no-undo init "Изменение статуса дисконтной карты".
       18   procedure vss-get-info :
       19     define output parameter p-vss-revision    like vss-revision    no-undo .
       20     define output parameter p-vss-author      like vss-author      no-undo .
       21     define output parameter p-vss-date        like vss-date        no-undo .
       22     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       23     define output parameter p-vss-archive     like vss-archive     no-undo .
       24     define output parameter p-vss-description like vss-description no-undo .
       25     assign
       26       p-vss-revision    = vss-revision
       27       p-vss-author      = vss-author
       28       p-vss-date        = vss-date
       29       p-vss-workfile    = vss-workfile
       30       p-vss-archive     = vss-archive
       31       p-vss-description = vss-description
       32     .
       33   end procedure.
       34   procedure vss-get-parameters :
       35     define output parameter p-vss-parameters as character no-undo .
       36   end procedure.
       37   define new global shared variable g#vssrevis-logger as handle    no-undo .
       38   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       39   define variable v-vssrevis-logger                   as handle    no-undo .
       40   procedure vss-logevent :
       41     define input  parameter p-extra-paramters as character no-undo .
       42     define variable v-vssrevis-parameters as character no-undo .
       43     do
       44     on error undo, return error return-value
       45     :
       46       if  valid-handle(v-vssrevis-logger)
       47       and v-vssrevis-logger :get-signature("logevent") <> ""
       48       then do:
       49         run vss-get-parameters in this-procedure
       50           (output v-vssrevis-parameters
       51           ).
       52         run logevent in v-vssrevis-logger
       53           (input vss-workfile
       54           ,input vss-revision
       55           ,input v-vssrevis-parameters
       56           ,input p-extra-paramters
       57           ).
       58       end.
       59     end.
       60   end procedure.
       61   assign
       62     v-vssrevis-logger = g#vssrevis-logger
       63   .
       64   if  valid-handle(v-vssrevis-logger)
       65   and v-vssrevis-logger :get-signature("logevent") <> ""
       66   then do:
       67     assign
       68       v-vssrevis-logevent = true
       69     .
       70     run vss-logevent in this-procedure (input vss-description) .
       71   end.
       72   define new global shared variable g#language as character no-undo .
       73   if g#language <> '' and g#language <> 'rus':U then do:
       74     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       75   end.
       76   define new global shared variable g#library  as handle no-undo .
       77   define new global shared variable g#library2 as handle no-undo .
       78   define   shared variable g#auto as logical no-undo.
       79   define   shared variable g#news as logical no-undo.
       80   define   shared variable g#oxml as logical no-undo.
       81   define   shared variable g#esys as logical no-undo.
       82   define   shared variable g#news-source-db as integer no-undo.
       83   define   shared variable g#esys-source-esys as integer no-undo.
       84   define   shared variable g#db-num as integer   no-undo .
       85   define   shared variable g#userid as character no-undo .
       86   define   shared variable g#passwd as character no-undo .
       87   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       88   procedure discardh_write-dis-card-proc  :
       89   define parameter buffer buf_dis-card for ub.dis-card .
       90   define input parameter p-source-type like ub.c-dc-hist.source-type no-undo .
       91   define input parameter p-source-ref  like ub.c-dc-hist.source-ref no-undo .
       92   define variable v-date as date      no-undo.
       93   define variable v-time  as integer   no-undo.
       94   define buffer buf_c-dc-hist for ub.c-dc-hist.
       95   define buffer buf_c-dis-card for ub.c-dis-card.
       96     do
       97     on error undo, return error
       98     :
       99       if not available buf_dis-card then do:
      100         message
      101           vss-workfile vss-revision vss-description skip
      102           "Ошибка задания входных параметров" skip
      103           "Не определена ДК" skip
      104           view-as alert-box error .
      105         undo, return error .
      106       end.
      107       run cur-time in this-procedure(output v-date, output v-time).
      108       create buf_c-dis-card.
      109       buffer-copy buf_dis-card to buf_c-dis-card
      110       assign
      111       buf_c-dis-card.d-card             = buf_dis-card.d-card
      112       buf_c-dis-card.card-num           = buf_dis-card.card-num
      113       buf_c-dis-card.chip-num           = next-value (s-dc-chip, ub)
      114       buf_c-dis-card.corr-time          = v-time
      115       buf_c-dis-card.corr-user-db-num   = g#db-num
      116       buf_c-dis-card.corr-user-name     = (if g#news
      117                                            then (chr(4) +  'СПН':U)
      118                                            else (if g#esys
      119                                                  then (chr(4) +  'ВС':U)
      120                                                  else g#userid
      121                                                 )
      122                                            )
      123       buf_c-dis-card.corr-date          = v-date
      124       .
      125       create buf_c-dc-hist.
      126       buffer-copy buf_c-dis-card to buf_c-dc-hist
      127       assign
      128       buf_c-dc-hist.action =  integer('2':U)
      129       buf_c-dc-hist.subject = 'dis-card':U
      130       buf_c-dc-hist.host-code =  buf_dis-card.emitent-host-code
      131       buf_c-dc-hist.is-news = g#news
      132       buf_c-dc-hist.source-type = p-source-type
      133       buf_c-dc-hist.source-ref = p-source-ref
      134       .
      135       if not ( g#db-num > 0 )
      136       or (g#news
      137           and ( g#db-num > 0 )
      138           and buf_c-dis-card.corr-user-name = (chr(4) +  'СПН':U)
      139           )
      140       then do:
      141         run str/callnews.p
      142           (input 'c-dis-card':U
      143           ,input (buffer buf_c-dis-card:handle)
      144           ).
      145         run str/callnews.p
      146           (input 'c-dc-hist':U
      147           ,input (buffer buf_c-dc-hist:handle)
      148           ).
      149       end.
      150     end.
      151   end procedure.
      152   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      153   procedure cur-time :
      154      define output parameter p-today as date      no-undo .
      155      define output parameter p-time  as integer   no-undo .
      156     do
      157     on error undo, return error
      158     :
      159       define variable v-date1 as date      no-undo .
      160       define variable v-date2 as date      no-undo .
      161       define variable v-time  as integer   no-undo .
      162       assign
      163         v-date1 = today
      164         v-time  = time
      165         v-date2 = today
      166       .
      167       if v-date1 <> v-date2
      168       then do:
      169         assign
      170           v-date1 = today
      171           v-time  = v-time
      172         .
      173       end.
      174       assign
      175         p-today = v-date1
      176         p-time  = v-time
      177       .
      178     end.
      179   end.
      180   function cur-time-date returns character
      181   :
      182     return string(today, '99/99/9999':U) .
      183   end.
      184   function cur-time-mjd returns decimal
      185   :
      186     define variable v-date as date      no-undo .
      187     define variable v-time as integer   no-undo .
      188     run cur-time in this-procedure
      189       (output v-date
      190       ,output v-time
      191       ) .
      192     return integer(v-date) - 2400002 + (v-time / 86400) .
      193   end.
      194   function cur-time-get-ending-index returns integer
      195   (input p-number as integer
      196   )
      197   :
      198     if p-number < 0
      199     or p-number = ?
      200     then do:
      201       return 1 .
      202     end.
      203     define variable v-rest as integer   no-undo .
      204     assign
      205       p-number = p-number modulo 100
      206     .
      207     if p-number < 20
      208     then do:
      209       assign
      210         v-rest = p-number
      211       .
      212     end.
      213     else do:
      214       assign
      215         v-rest = p-number modulo 10
      216       .
      217     end.
      218     case v-rest :
      219       when 1
      220       then do:
      221         return 2 .
      222       end.
      223       when 2 or
      224       when 3 or
      225       when 4
      226       then do:
      227         return 3 .
      228       end.
      229       otherwise do:
      230         return 1 .
      231       end.
      232     end case .
      233   end.
      234   procedure cur-time-mjd-to-date :
      235      define input  parameter i-mjd-diff as decimal no-undo.
      236      define output parameter o-Date     as date    no-undo.
      237      define output parameter o-Time     as integer no-undo.
      238      define variable v-day-number as integer   no-undo .
      239      if    i-mjd-diff < 0
      240         or i-mjd-diff = ?
      241      then do:
      242         return "?" .
      243      end.
      244      assign
      245         v-day-number = truncate(i-mjd-diff,0).
      246         o-Date = date(v-day-number + 2400002).
      247         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      248     .
      249   end.
      250   function cur-time-mjd-to-string returns character
      251   (input p-mjd-diff as decimal
      252   )
      253   :
      254     define variable v-day-number as integer   no-undo .
      255     define variable v-seconds    as integer   no-undo .
      256     define variable v-hour       as integer   no-undo .
      257     define variable v-min        as integer   no-undo .
      258     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      259     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      260     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      261     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      262     if p-mjd-diff < 0
      263     or p-mjd-diff = ?
      264     then do:
      265       return "?" .
      266     end.
      267     assign
      268       v-day-number = integer(truncate(p-mjd-diff,0))
      269       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      270     .
      271     if v-seconds > 86400
      272     then do:
      273       assign
      274         v-seconds = 86400 - 1
      275       .
      276     end.
      277     if v-seconds < 0
      278     then do:
      279       assign
      280         v-seconds = 0
      281       .
      282     end.
      283     assign
      284       v-hour = truncate(v-seconds / 3600, 0)
      285     .
      286     assign
      287       v-seconds = v-seconds modulo 3600
      288     .
      289     assign
      290       v-min = truncate(v-seconds / 60, 0)
      291     .
      292     assign
      293       v-seconds = v-seconds modulo 60
      294     .
      295     return
      296         (if v-day-number <> 0
      297           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      298           else ""
      299         )
      300       + (if v-day-number <> 0 or v-hour <> 0
      301           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      302           else ""
      303         )
      304       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      305           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      306           else ""
      307         )
      308       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      309       .
      310   end.
      311   function cur-time-string returns character
      312   :
      313     define variable v-date as date      no-undo .
      314     define variable v-time as integer   no-undo .
      315     run cur-time in this-procedure
      316       (output v-date
      317       ,output v-time
      318       ) .
      319     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      320   end.
      321   function cur-time-string-sec returns character
      322   :
      323     define variable v-date as date      no-undo .
      324     define variable v-time as integer   no-undo .
      325     run cur-time in this-procedure
      326       (output v-date
      327       ,output v-time
      328       ) .
      329     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      330   end.
      331   function cur-time-custom  returns character
      332   (input p-prefix as character
      333   ,input p-date-format as character
      334   ,input p-delimiter as character
      335   ,input p-time-format as character
      336   ,input p-suffix as character
      337   )
      338   :
      339     define variable v-date as date      no-undo .
      340     define variable v-time as integer   no-undo .
      341     run cur-time in this-procedure
      342       (output v-date
      343       ,output v-time
      344       ) .
      345     return
      346       p-prefix
      347       + string(v-date, p-date-format)
      348       + p-delimiter
      349       + string(v-time, p-time-format)
      350       + p-suffix
      351       .
      352   end.
      353   function cur-time-print  returns character
      354   :
      355     define variable v-date as date      no-undo .
      356     define variable v-time as integer   no-undo .
      357     run cur-time in this-procedure
      358       (output v-date
      359       ,output v-time
      360       ) .
      361     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      362   end.
      363   function cur-time-datetime returns datetime
      364   :
      365     define variable v-char as character no-undo .
      366     define variable v-datetime as datetime no-undo .
      367     v-char = cur-time-string().
      368     v-datetime = datetime(v-char).
      369     return  v-datetime.
      370   end.
      371   function cur-time-string-msec returns character
      372   :
      373     define variable v-date as datetime  no-undo .
      374     v-date = now.
      375     return string(v-date) .
      376   end.
      377   DEFINE VARIABLE loc#log as logical no-undo .
      378   DEFINE BUFFER bf-dis-card for ub.dis-card.
      379   DEFINE VARIABLE choice as logical no-undo .
      380   DEFINE VARIABLE varold-status_ like ub.dis-card.status_ no-undo .
      381   define variable v-mess as character no-undo .
      382   define variable v-dop-d-card as character no-undo .
      383   define variable ii as integer no-undo .
      384   define temp-table tt0-dis-card-property no-undo like ub.dis-card-property.
      385   define buffer buf_dis-card for ub.dis-card.
      386   _main:
      387   do
      388   on error undo, return error return-value
      389   :
      390   FIND FIRST bf-dis-card exclusive-lock WHERE
      391              recid(bf-dis-card) = par-recid No-ERROR.
      392   if not avail bf-dis-card then return error.
      393   if bf-dis-card.status_ = 'неисп':U
      394   or bf-dis-card.status_ = 'смкли':U then do:
      395     v-mess = substitute("Нельзя изменять карту в статусе &1", bf-dis-card.status_).
      396     run err-mess in this-procedure ( input-output v-mess).
      397   end.
      398   varold-status_ = bf-dis-card.status_.
      399   IF 'удал':U =  bf-dis-card.status_ then do:
      400       if par-status_ = 'удал':U then do:
      401          return.
      402       end.
      403       if not p-has-right-to-restore then do:
      404         v-mess = substitute("У Вас нет прав на изменение статуса удаленной карты!").
      405         run err-mess in this-procedure ( input-output v-mess).
      406         par-status_ = "".
      407         undo _main, return error (if p-silent then v-mess else '':U).
      408       end.
      409       find first buf_dis-card no-lock where
      410                 buf_dis-card.sourced-card = bf-dis-card.d-card no-error.
      411       if available buf_Dis-card then do:
      412         v-mess = substitute("К данной карте имеется перевыпущенная карта - восстановление запрещено").
      413         run err-mess in this-procedure ( input-output v-mess).
      414         par-status_ = "".
      415         undo _main, return error (if p-silent then v-mess else '':U).
      416       end.
      417   end.
      418   CASE par-status_:
      419     WHEN 'тек':U then do:
      420       if 'тек':U = bf-dis-card.status_  then do:
      421         v-mess = substitute("Карта уже имеет статус ТЕКУЩИЙ!").
      422         run err-mess in this-procedure ( input-output v-mess).
      423         par-status_ = "".
      424         undo _main, return error (if p-silent then v-mess else '':U).
      425       end.
      426       else do:
      427         assign
      428         v-dop-d-card = left-trim(bf-dis-card.d-card, "0") .
      429         DO II = 1  to (19 - length(v-dop-d-card)) + 1:
      430           if can-find(first ub.dis-card no-lock where
      431                           ub.dis-card.d-card = v-dop-d-card
      432                           and ub.dis-card.status_ <> 'удал':U
      433                           and ub.dis-card.d-card <> bf-dis-card.d-card
      434                           ) then do:
      435             assign
      436             v-mess = substitute("Уже есть глобальная НЕУДАЛЕННАЯ дисконтная карта&1 с номером &2 - совпадает с &3 с точностью до лидирующих нулей"
      437                         , (if bf-dis-card.emitent-host-code = 0
      438                           then "":U
      439                           else substitute(" на фирме &1", bf-dis-card.emitent-host-code))
      440                           ,v-dop-d-card
      441                           ,bf-dis-card.d-card
      442                           ).
      443             run err-mess in this-procedure ( input-output v-mess).
      444             par-status_ = "":U.
      445             undo _main, return error (if p-silent then v-mess else '':U).
      446           end.
      447           assign
      448           v-dop-d-card = "0" + v-dop-d-card
      449           .
      450         end.
      451         assign
      452          choice = yes.
      453       end.
      454     end.
      455     WHEN 'блок':U then do:
      456       if 'блок':U = bf-dis-card.status_   then do:
      457         v-mess = substitute("Карта уже блокирована!").
      458         run err-mess in this-procedure ( input-output v-mess).
      459         par-status_ = "".
      460         undo _main, return error (if p-silent then v-mess else '':U).
      461       end.
      462       else do:
      463         if not p-silent then do:
      464           choice = FALSE .
      465           message "На блокированной карте не будут автоматически пересчитываться скидки." skip
      466                   "Продолжить ?"
      467           view-as alert-box WARNING
      468           buttons OK-Cancel update choice .
      469         end.
      470         else do:
      471           choice = yes.
      472         end.
      473       end.
      474     end.
      475     WHEN 'удал':U then do:
      476      if not p-silent then do:
      477         choice = FALSE .
      478         message substitute("ВЫ уверены, что хотите удалить карту &1?&2"
      479                            , bf-dis-card.d-card
      480                            , chr(10)
      481                           )
      482         view-as alert-box WARNING
      483         buttons OK-Cancel update choice .
      484       end.
      485       else do:
      486         choice = yes.
      487       end.
      488     end.
      489   END CASE.
      490   if not choice then do:
      491     v-mess = substitute("Отмена пользователем при изменении статуса ДИСКОНТНОЙ КАРТЫ").
      492     run err-mess( input-output v-mess).
      493     undo _main, return error (if p-silent then v-mess else '':U).
      494   end.
      495   if choice then do:
      496     run ref/dcardi01.p (
      497                    input parparentproc
      498                   ,input this-procedure
      499                   ,input ?
      500                   ,input ?
      501                   ,input no
      502                   ,input-output par-recid
      503                   ,input 'ИЗМЕНЕНИЕ':U
      504                   ,input p-mode2
      505                   ,input p-curr-obj-type
      506                   ,input p-curr-obj-code
      507                   ,input bf-dis-card.d-card
      508                   ,input bf-dis-card.emitent-host-code
      509                   ,input bf-dis-card.cli-type
      510                   ,input bf-dis-card.cli-code
      511                   ,input par-status_ + chr(4) + string(if p-has-right-to-restore then yes else no)
      512                   ,input bf-dis-card.type
      513                   ,input bf-dis-card.d-pcnt
      514                   ,input bf-dis-card.cash-d-pcnt
      515                   ,input bf-dis-card.category
      516                   ,input bf-dis-card.d-pcnt-method
      517                   ,input bf-dis-card.credit-card
      518                   ,input bf-dis-card.lim-kr
      519                   ,input bf-dis-card.debet-card
      520                   ,input bf-dis-card.staff-card
      521                   ,input bf-dis-card.issue-date
      522                   ,input bf-dis-card.issue-code
      523                   ,input bf-dis-card.valid-from
      524                   ,input bf-dis-card.valid-date
      525                   ,input bf-dis-card.sourced-card
      526                   ,input bf-dis-card.cli-message
      527                   ,input bf-dis-card.mask-card
      528                   ,input bf-dis-card.main-card
      529                   ,input bf-dis-card.is-subsid
      530                   ,INPUT no
      531                   ,INPUT table tt0-dis-card-property
      532                    ) no-error .
      533   end.
      534   if error-status:error then do:
      535     v-mess = substitute("Ошибка при удалении ДИСКОНТНОЙ КАРТЫ&1&2&3&4"
      536                              ,error-status:get-message(1)
      537                              , chr(10)
      538                              ,return-value
      539                              ,chr(10)).
      540     run err-mess in this-procedure ( input-output v-mess).
      541     undo _main, return error (if p-silent then v-mess else '':U).
      542   end.
      543   par-status_ = "".
      544   end.
      545   PROCEDURE err-mess:
      546     DEFINE INPUT-output PARAMETER p-mess as character No-UNDO.
      547     CASE p-silent:
      548       when yes then do:
      549         p-mess =  substitute("Карта №&1: эмитент: &2 тип: &3&4&5"
      550                              , bf-dis-card.d-card
      551                              , bf-dis-card.emitent-host-code
      552                              , bf-dis-card.type
      553                              , chr(10)
      554                              , p-mess
      555                              ).
      556       end.
      557       otherwise do:
      558         message
      559         p-mess
      560         view-as alert-box error .
      561       end.
      562     end.
      563   END PROCEDURE.
