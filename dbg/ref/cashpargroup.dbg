     1641           .
     1642           leave move_block .
     1643         end.
     1644       end.
     1645       assign
     1646         v-diasize-need-full-display = true
     1647       .
     1648       if v-diasize-change-size = false
     1649       then do:
     1650         assign
     1651           v-diasize-change-size = true
     1652         .
     1653       end.
     1654       else do:
     1655         return .
     1656       end.
     1657       assign
     1658         v-frame-width = frame f-c-p :width
     1659         v-frame-virtual-width = frame f-c-p :virtual-width
     1660         v-browse-width = v-diasize-browse-handle :width
     1661       .
     1662       for each buf_temp-browse-handle
     1663         where buf_temp-browse-handle.browse-type = 'width':u
     1664       :
