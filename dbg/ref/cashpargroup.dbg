      994   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      995   procedure minbtn-set :
      996       do
      997           on error undo, return error return-value
      998           :
      999           define variable ii              as integer       no-undo .
     1000           define variable fh              as widget-handle no-undo .
     1001           define variable hh              as widget-handle no-undo .
     1002           define variable v-h             as handle        extent 4 no-undo .
     1003           define variable v-name-button   as character     no-undo .
     1004           define variable v-help-old-x    as decimal       no-undo .
     1005           define variable v-help-old-y    as decimal       no-undo .
     1006           define variable v-help-old-size as decimal       no-undo .
     1007           define variable v-frame-width   as decimal       no-undo .
     1008           define variable jj              as integer       no-undo .
     1009           do
     1010               on error undo, return error
     1011               :
     1012               assign
     1013                   v-frame-width = frame f-c-p:width - 0.3
     1014                   fh            = frame f-c-p:first-child
     1015                   hh            = fh:first-child
     1016                   ii            = 1
     1017                   .
     1018               do while valid-handle(hh):
     1019                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1020                   do:
     1021                       case lc(hh:name) :
     1022                           when "b-help" then
     1023                               do:
     1024                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1025                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1026                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1027                                   hh:TOOLTIP = "Помощь" .
     1028                                   v-help-old-x = hh:column .
     1029                                   v-help-old-y = hh:row    .
     1030                                   v-help-old-size = hh:width .
     1031                                   hh:width-chars = 2.5 .
     1032                               end.
     1033                           when "b-print" then
     1034                               do:
     1035                                   hh:load-image("cmp/b-print.bmp":u) .
     1036                                   hh:TOOLTIP = "Печать" .
     1037                                   v-h[ii] = hh:handle .
     1038                                   ii = ii + 1 .
     1039                                   hh:width-chars = 3 .
     1040                               end.
     1041                           when "b-history" or
     1042                           when "b-hist" then
     1043                               do:
     1044                                   hh:load-image("cmp/b-hist.bmp":u) .
     1045                                   hh:TOOLTIP = "История" .
     1046                                   v-h[ii] = hh:handle .
     1047                                   ii = ii + 1 .
     1048                                   hh:width-chars = 3 .
     1049                               end.
     1050                           when "b-sch" then
     1051                               do:
     1052                                   hh:load-image("cmp/b-sch.bmp":u) .
     1053                                   hh:TOOLTIP = "Установка Фильтра" .
     1054                                   v-h[ii] = hh:handle .
     1055                                   ii = ii + 1 .
     1056                                   hh:width-chars = 3 .
     1057                               end.
     1058                           when "b-hist-user" then
     1059                               do:
     1060                                   hh:load-image("cmp/b-hist.bmp":u) .
     1061                                   hh:TOOLTIP = "История пользователя" .
     1062                                   ii = ii + 1 .
     1063                               end.
     1064                       end case.
     1065                   end.
     1066                   hh = hh:next-sibling.
     1067               end.
     1068               b-help:column = v-frame-width - b-help:width-chars.
     1069               jj = 0.
     1070               repeat ii = 4 to 1 by -1 :
     1071                   if valid-handle (v-h[ii] ) then
     1072                   do:
     1073                       jj  = jj + 1 .
     1074                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1075                       v-h[ii]:row    = v-help-old-y .
     1076                   end.
     1077               end.
     1078           end.
     1079       end.
     1080   end procedure.
