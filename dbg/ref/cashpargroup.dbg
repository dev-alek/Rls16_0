      853   Types = new ibs.th.str.cash.CashDevice().
      854   define variable mParent as character no-undo.
      855   if    iparent eq ""
      856      or iparent eq ?
      857   then
      858      mparent = icode.
      859   else
      860      mparent = iparent + chr(4) + icode.
      861   FUNCTION getName RETURNS CHARACTER
      862      ( iCode as char) FORWARD.
      863   DEFINE BUTTON b-exit AUTO-GO
      864        LABEL "&Выход ":L
      865        SIZE 10 BY 1.
      866   DEFINE BUTTON b-chiled
      867        LABEL "&Открыть":L
      868        SIZE 10 BY 1.
      869   define button b-hist
      870        label "Ис&тория":L
      871        size 10 by 1.
      872   DEFINE BUTTON b-help
      873        LABEL "Помо&щь":L
      874        SIZE 3 BY 1.
      875   define menu POPUP-MENU-b-hist
      876       menu-item mHistOne     label "История этой записи"
      877       menu-item mHistChiled  label "История потомков"
      878   .
      879   DEFINE QUERY BROWSE-Code FOR
      880         buf-code-sign,
      881         buf-code-sec SCROLLING.
      882   DEFINE BROWSE BROWSE-Code
      883     QUERY BROWSE-Code NO-LOCK DISPLAY
      884         buf-code-sign.code FORMAT "x(1)":U column-label "Код"
      885         buf-code-sign.CodeName FORMAT "x(25)":U column-label "Признак исполнения"
      886         buf-code-sec.code FORMAT "x(3)":U column-label "Код"
      887         buf-code-sec.CodeName FORMAT "x(60)":U column-label "Наименование источника"
      888       WITH NO-ROW-MARKERS SEPARATORS SIZE 100.63 BY 20 ROW-HEIGHT-CHARS .67 FIT-LAST-COLUMN.
      889   DEFINE FRAME f-c-p
      890        b-exit AT ROW 1 COL 1
      891        b-chiled AT ROW 1 COL 13.63
      892        b-hist AT ROW 1 col 64
      893         b-help AT ROW 1 COL 71
      894        BROWSE-Code AT ROW 2.75 COL 1 WIDGET-ID 200
      895        SPACE(0.00) SKIP(0.07)
      896       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      897            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      898            TITLE "Эталонные наборы параметров АРМ Кассира":L.
      899   ASSIGN
      900          FRAME f-c-p:SCROLLABLE       = FALSE.
      901   on choose of menu-item mHistOne
      902   do:
      903      define variable v-rid-list as character no-undo.
      904      if avail buf-code-sec then
      905      do:
      906         run ref/ccode.w (
      907                   buf-code-sec.parent,
      908                   buf-code-sec.code,
      909                   parparentproc,
      910                   0,
      911                   "",
      912                   0,
      913                   "",
      914                   "one",
      915                   ?,
      916                   "",
      917                   "" ,
      918                   v-cntxt-db-num,
      919                   ?,
      920                   input-output v-rid-list ) .
      921      end.
      922   end.
      923   on choose of menu-item mHistChiled
