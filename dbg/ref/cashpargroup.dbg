     1440         or error-status :get-message(1) <> ""
     1441         then do:
     1442           undo move_block, retry move_block .
     1443         end.
     1444         if frame f-c-p :scrollable = true
     1445         then do:
     1446           assign
     1447             frame f-c-p :virtual-height = frame f-c-p :virtual-height + p-change-value
     1448             no-error .
     1449           if error-status :error
     1450           or error-status :get-message(1) <> ""
     1451           then do:
     1452             undo move_block, retry move_block .
     1453           end.
     1454         end.
     1455       end.
     1456       if p-move-resize = true
     1457       then do:
     1458         run diasize_position-resize-button in this-procedure .
     1459       end.
     1460       if v-diasize-wndstore = true
     1461       then do:
     1462         if connected("ub") = true
     1463         then do:
     1464           define variable v-cntxt-db-num        as integer   no-undo .
     1465           define variable v-cntxt-userid        as character no-undo .
     1466           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1467                                             , OUTPUT v-cntxt-userid
     1468                                             ) .
     1469           run gbl/wndsizew.p
     1470             (input  v-cntxt-db-num
     1471             ,input  v-cntxt-userid
     1472             ,input  v-diasize-proc-name
     1473             ,input  'height':u
     1474             ,input  string(frame f-c-p :height - v-diasize-orig-frame-height)
     1475             ) .
     1476         end.
     1477       end.
     1478     end.
     1479     assign
     1480       v-diasize-change-size = false
     1481     .
     1482   end procedure.
     1483   procedure diasize_set-height :
     1484     define input  parameter p-new-height  as decimal   no-undo .
     1485     define input  parameter p-move-resize as logical   no-undo .
     1486     do
     1487     on error undo, return error return-value
     1488     :
     1489       run diasize_change-height in this-procedure
     1490         (input  (p-new-height - frame f-c-p :height)
     1491         ,input  p-move-resize
     1492         ) .
     1493     end.
     1494   end procedure.
     1495   procedure diasize_change-width :
     1496     define input  parameter p-change-value as decimal   no-undo .
     1497     define input  parameter p-move-resize  as logical   no-undo .
     1498     define variable v-field-group-handle   as handle    no-undo .
     1499     define variable v-object-handle        as handle    no-undo .
     1500     define variable v-frame-width          as decimal   no-undo .
     1501     define variable v-frame-virtual-width  as decimal   no-undo .
     1502     define variable v-browse-width         as decimal   no-undo .
     1503     define variable v-window-width         as decimal   no-undo .
     1504     define variable v-window-virtual-width as decimal   no-undo .
     1505     define variable v-change-sign          as integer   no-undo .
     1506     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1507     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1508     if p-change-value > 0
     1509     then do:
     1510       if frame f-c-p :width + p-change-value >
     1511           session :width-chars
     1512       then do:
     1513         assign
     1514           p-change-value = session :width-chars - frame f-c-p :width
     1515         .
     1516         if p-change-value <= 0
     1517         then do:
     1518           run diasize_position-resize-button in this-procedure .
     1519           return .
     1520         end.
     1521       end.
     1522     end.
     1523     if p-change-value < 0
     1524     then do:
     1525       if frame f-c-p :width + p-change-value < v-diasize-orig-frame-width
     1526       then do:
     1527         assign
     1528           p-change-value = v-diasize-orig-frame-width
     1529                          - frame f-c-p :width
     1530         .
     1531         if p-change-value >= 0
     1532         then do:
     1533           run diasize_position-resize-button in this-procedure .
     1534           return .
     1535         end.
     1536       end.
     1537     end.
     1538     if p-change-value >= 0
     1539     then do:
     1540       assign
     1541         v-change-sign = 1
     1542       .
     1543     end.
     1544     else do:
     1545       assign
     1546         v-change-sign = -1
     1547       .
     1548     end.
     1549     assign
     1550       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1551     .
     1552     if p-change-value = 0
     1553     then do:
     1554       run diasize_position-resize-button in this-procedure .
     1555       return .
     1556     end.
     1557     move_block:
     1558     do
     1559     on error undo move_block, leave move_block
     1560     :
     1561       if retry
     1562       then do:
     1563         do
     1564         on error undo move_block, leave move_block
     1565         :
     1566           if p-change-value > 0
     1567           then do:
     1568             for each buf_temp-diasize-handle
     1569             on error undo, next
     1570             :
     1571               assign
     1572                 v-object-handle = buf_temp-diasize-handle.handle-value
     1573               .
     1574               if v-object-handle <> v-diasize-resize-button
     1575               then do:
     1576                 assign
     1577                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1578                 .
     1579               end.
     1580             end.
     1581             assign
     1582               v-diasize-browse-handle :width = v-browse-width
     1583             .
     1584             for each buf_temp-browse-handle
     1585               where buf_temp-browse-handle.browse-type = 'width':u
     1586             on error undo, next
     1587             :
     1588               assign
     1589                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1590               .
     1591             end.
