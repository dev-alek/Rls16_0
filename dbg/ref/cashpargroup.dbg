      932                   0,
      933                   "",
      934                   0,
      935                   "",
      936                   "parentBeg",
      937                   ?,
      938                   "",
      939                   "" ,
      940                   v-cntxt-db-num,
      941                   ?,
      942                   input-output v-rid-list ) .
      943      end.
      944   end.
      945   ON GO OF FRAME f-c-p
      946   DO:
      947   END.
      948   ON CHOOSE OF b-chiled IN FRAME f-c-p
      949   DO:
      950         define buffer b-code for code.
      951         if not avail buf-code-sec then return.
      952            define variable vProcNextLevel as character no-undo .
      953            vProcNextLevel = if buf-code-sec.code eq "2"
      954                             then "ref/cashpagroup2.w"
      955                             else "ref/codelay.p".
      956            define variable vListRecId as character no-undo.
      957            run value(vProcNextLevel) (
      958                                     input parparentproc
      959                                   , input imode
      960                                   , input buf-code-sec.parent
      961                                   , input buf-code-sec.code
      962                                   , input ?
      963                                   ).
      964      END.
      965   on mouse-select-dblclick of BROWSE-Code in frame f-c-p
      966   or return of b-chiled in frame f-c-p
      967   do:
      968     apply "choose" to b-chiled in frame f-c-p.
      969   end.
      970   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME f-c-p:PARENT eq ?
      971      THEN FRAME f-c-p:PARENT = ACTIVE-WINDOW.
      972   ON WINDOW-CLOSE OF FRAME f-c-p
      973      APPLY "END-ERROR":U TO SELF.
      974   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      975   on help of frame f-c-p
      976   do:
