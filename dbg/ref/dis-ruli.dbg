     3549       tt-dis-rule.deckey_two
     3550       tt-dis-rule.deckey_three
     3551       tt-dis-rule.time-rule-num
     3552       b-time-rule-lookup
     3553       b-dis-time-rule
     3554       tt-dis-rule.discnt-value
     3555       f-d-pcnt
     3556       f-sale-qnty
     3557       F-price-brutto
     3558       f-price-discnt
     3559       f-price-netto
     3560       f-sum-brutto
     3561       f-sum-discnt
     3562       f-sum-netto
     3563       in FRAME Dialog-Frame.
     3564     END.
     3565   END CASE.
     3566   END PROCEDURE.
     3567   PROCEDURE enable_UI :
     3568     OPEN QUERY Dialog-Frame FOR EACH tt-dis-rule SHARE-LOCK,       EACH locked_dis-rule WHERE TRUE  SHARE-LOCK.
     3569     GET FIRST Dialog-Frame.
     3570     DISPLAY s-discnt-type f-pos-type s-subject-type f-d-pcnt f-price-discnt t-flag
     3571             f-price-netto f-sum-discnt f-sum-netto F-region F-price-brutto
     3572             f-sale-qnty f-sum-brutto
     3573         WITH FRAME Dialog-Frame.
     3574     IF AVAILABLE tt-dis-rule THEN
     3575       DISPLAY tt-dis-rule.des tt-dis-rule.value-type tt-dis-rule.doc-qnty
     3576             tt-dis-rule.tot-sum tt-dis-rule.dis-kat tt-dis-rule.time-rule-num
     3577             tt-dis-rule.CharKey_One tt-dis-rule.Deckey_one tt-dis-rule.Key#_One
     3578             tt-dis-rule.CharKey_Two tt-dis-rule.Deckey_two tt-dis-rule.Key#_Two
     3579             tt-dis-rule.CharKey_Three tt-dis-rule.Deckey_three
     3580             tt-dis-rule.Key#_Three tt-dis-rule.discnt-value tt-dis-rule.rule-num
     3581         WITH FRAME Dialog-Frame.
     3582     ENABLE B-exit b-quit B-time-rule-lookup B-hist B-Help tt-dis-rule.des
     3583            tt-dis-rule.value-type f-pos-type B-add B-del BR-term-dr
     3584            BR-gds-rule-attr f-d-pcnt f-price-discnt t-flag f-price-netto
     3585            tt-dis-rule.doc-qnty f-sum-discnt f-sum-netto tt-dis-rule.tot-sum
     3586            tt-dis-rule.dis-kat tt-dis-rule.time-rule-num B-dis-time-rule
     3587            tt-dis-rule.CharKey_One tt-dis-rule.Deckey_one tt-dis-rule.Key#_One
     3588            tt-dis-rule.CharKey_Two tt-dis-rule.Deckey_two tt-dis-rule.Key#_Two
     3589            tt-dis-rule.CharKey_Three tt-dis-rule.Deckey_three
     3590            tt-dis-rule.Key#_Three tt-dis-rule.discnt-value B-exit-1 B-quit-1
     3591            tt-dis-rule.rule-num F-region F-price-brutto f-sale-qnty
     3592         WITH FRAME Dialog-Frame.
     3593     VIEW FRAME Dialog-Frame.
     3594     OPEN QUERY BR-gds-rule-attr FOR EACH temp-gds-rule-attr .
     3595   END PROCEDURE.
     3596   PROCEDURE fill-main-table :
     3597   if p-mode = 'ИЗМЕНЕНИЕ':U
     3598   or p-mode = 'ПРОСМОТР':U
     3599   or (p-mode = 'ДОБАВЛЕНИЕ':U and v-is-copy)
     3600   then do:
     3601     find first locked_dis-rule no-lock where
     3602             recid(locked_dis-rule) = p-recid no-error .
     3603     if not available locked_dis-rule then do:
     3604       message
     3605       vss-workfile vss-revision vss-description skip
     3606       "Не найдена запись ПРАВИЛО СКИДОК с номером" p-rule-num
     3607       view-as alert-box error .
     3608       undo, return error.
     3609     end.
     3610     if locked_dis-rule.root = no then do:
     3611       message
     3612       substitute("Невозможен просмотр не корневого правила &1", p-rule-num)
     3613       view-as alert-box error .
     3614       undo, return error .
     3615     end.
     3616     if p-mode = 'ИЗМЕНЕНИЕ':U then do:
     3617       find first locked_dis-rule EXclusive-lock where
     3618                     recid(locked_dis-rule) = p-recid no-wait no-error.
     3619       if locked locked_dis-rule then do:
     3620         message
     3621         vss-workfile vss-revision vss-description skip
     3622           "Запись ПРАВИЛО СКИДОК занята"
     3623         view-as alert-box error .
     3624         undo, return error.
     3625       end.
     3626     end.
     3627     else do:
     3628       find first locked_dis-rule no-lock where
     3629                         recid(locked_dis-rule) = p-recid no-error .
     3630       if not avail locked_dis-rule then do:
     3631         find first locked_dis-rule no-lock where
     3632                     locked_dis-rule.rule-num = p-rule-num no-error .
     3633       end.
     3634     end.
     3635     if locked_dis-rule.rule-num <= 99999
     3636     and p-mode = 'ИЗМЕНЕНИЕ':U then do:
     3637       message
     3638       vss-workfile vss-revision vss-description skip
     3639       "Нельзя редактировать ШАБЛОНЫ СКИДОК"
     3640       view-as alert-box error .
     3641       undo, return error.
     3642     end.
     3643     create tt-dis-rule.
     3644     buffer-copy locked_dis-rule to tt-dis-rule
     3645     .
     3646      if p-mode = 'ДОБАВЛЕНИЕ':U
     3647      and v-is-copy = yes then do:
     3648       assign
     3649       tt-dis-rule.rule-num = locked_dis-rule.templ-rl-root
     3650       tt-dis-rule.host-code = p-host-code
     3651       tt-dis-rule.obj-type = p-obj-type
     3652       tt-dis-rule.obj-code = p-obj-code
     3653       .
     3654      end.
     3655      if is-good-mode and locked_dis-rule.templ-rl-root= 91 then
     3656      do:
     3657         for each buf_dis-gds-rule no-lock
     3658             where buf_dis-gds-rule.rule-num = locked_dis-rule.rule-num
     3659               and buf_dis-gds-rule.gds-code = X_bar-code.gds-code
     3660               and buf_dis-gds-rule.nonunique = string(X_bar-code.b-code)
     3661               and buf_dis-gds-rule.pos-type = 'NCR-AS@R':U,
     3662             each  buf_dis-gds-rule-attr no-lock where
     3663                   buf_dis-gds-rule-attr.gds-code = buf_dis-gds-rule.gds-code
     3664               AND buf_dis-gds-rule-attr.obj-type = buf_dis-gds-rule.obj-type
     3665               AND buf_dis-gds-rule-attr.obj-code = buf_dis-gds-rule.obj-code
     3666               AND buf_dis-gds-rule-attr.pos-type = buf_dis-gds-rule.pos-type
     3667               AND buf_dis-gds-rule-attr.discnt-role = buf_dis-gds-rule.discnt-role
     3668               and buf_dis-gds-rule-attr.nonunique = buf_dis-gds-rule.nonunique:
     3669            create temp-gds-rule-attr.
     3670            assign
     3671              temp-gds-rule-attr.attr-code = buf_dis-gds-rule-attr.attr-code
     3672              temp-gds-rule-attr.b-str = entry(1,buf_dis-gds-rule-attr.attr-value,',')
     3673              temp-gds-rule-attr.type-rec = entry(2,buf_dis-gds-rule-attr.attr-value,',')
     3674              temp-gds-rule-attr.r-id = rowid(buf_dis-gds-rule-attr)
     3675             .
     3676         end.
     3677      end.
     3678     end.
     3679   else do:
     3680         FIND FIRST template_dis-rule NO-LOCK WHERE
     3681                     template_dis-rule.rule-num = p-templ-rl-root .
     3682         create tt-dis-rule.
     3683         BUFFER-COPY template_dis-rule TO tt-dis-rule
     3684         ASSIGN
     3685         tt-dis-rule.upper-rule-num = template_dis-rule.rule-num
     3686         tt-dis-rule.templ-rl-root  = template_dis-rule.rule-num
     3687         tt-dis-rule.root        = yes
     3688         tt-dis-rule.host-code = p-host-code
     3689         tt-dis-rule.obj-type = p-obj-type
     3690         tt-dis-rule.obj-code = p-obj-code
     3691         tt-dis-rule.des = trim(template_dis-rule.des, "@":U)
     3692         tt-dis-rule.lvl-num = 1
     3693         .
     3694   end.
     3695   END PROCEDURE.
     3696   PROCEDURE fill-tables :
     3697   define variable v-ii as integer no-undo .
     3698   DEFINE BUFFER buf_tt0-term_dis-rule FOR tt0-term_dis-rule.
     3699   DEFINE BUFFER buf_dis-rule FOR ub.dis-rule.
     3700   IF p-mode = 'ДОБАВЛЕНИЕ':U AND tt-dis-rule.is-term = no and not v-is-copy then  RETURN.
     3701   IF tt-dis-rule.time-rule-num <> 0 THEN
     3702   FIND FIRST X_dis-time-rule WHERE X_dis-time-rule.time-rule-num = tt-dis-rule.time-rule-num NO-ERROR.
     3703   FOR EACH buf_tt0-term_dis-rule:
     3704       DELETE buf_tt0-term_dis-rule.
     3705   END.
     3706   run ref/dcr-pos.p (
     3707                      input p-mode
     3708                     ,input no
     3709                     ,input p-templ-rl-root
     3710                     ,input tt-dis-rule.host-code
     3711                     ,input tt-dis-rule.obj-type
     3712                     ,input tt-dis-rule.obj-code
     3713                     ,input tt-dis-rule.sts
     3714                     ,input tt-dis-rule.rule-num
     3715                     ,output v-pos-type) no-error.
     3716   if error-status:error then do:
     3717     message
     3718     error-status:get-message(1) skip
     3719     return-value
     3720     view-as alert-box error .
     3721     undo,  return error.
     3722   end.
     3723   assign
     3724   v-dis-kat-tree   = lookup("dis-kat":U, v-tree) > 0
     3725   v-doc-qnty-tree  = lookup("doc-qnty":U, v-tree) > 0
     3726   v-tot-sum-tree   = lookup("tot-sum":U,  v-tree) > 0
     3727   v-time-rule-num-tree = lookup("time-rule-num":U, v-tree) > 0
     3728   v-charkey_one-tree = lookup("charkey_one":U, v-tree) > 0
     3729   v-charkey_two-tree = lookup("charkey_two":U, v-tree) > 0
     3730   v-charkey_three-tree = lookup("charkey_three":U, v-tree) > 0
     3731   v-deckey_one-tree = lookup("deckey_one":U, v-tree) > 0
     3732   v-deckey_two-tree = lookup("deckey_two":U, v-tree) > 0
     3733   v-deckey_three-tree = lookup("deckey_three":U, v-tree) > 0
     3734   v-key#_one-tree = lookup("key#_one":U, v-tree) > 0
     3735   v-key#_two-tree = lookup("key#_two":U, v-tree) > 0
     3736   v-key#_three-tree = lookup("key_#three":U, v-tree) > 0
     3737   .
     3738   v-ii = 0.
     3739   if tt-dis-rule.is-term = no then do:
     3740     FOR EACH buf_dis-rule NO-LOCK WHERE
     3741             buf_dis-rule.upper-rule-num = (if v-is-copy then p-rule-num else tt-dis-rule.rule-num):
     3742       v-ii = v-ii + 1.
     3743       CREATE buf_tt0-term_dis-rule.
     3744       BUFFER-COPY buf_dis-rule
     3745       except rule-num upper-rule-num
     3746       TO buf_tt0-term_dis-rule
     3747       ASSIGN
     3748       buf_tt0-term_dis-rule.rule-num = (if v-is-copy then v-ii else buf_dis-rule.rule-num)
     3749       buf_tt0-term_dis-rule.upper-rule-num = (if v-is-copy then abs(tt-dis-rule.rule-num) else buf_dis-rule.upper-rule-num)
     3750       buf_tt0-term_dis-rule.doc-qnty = (IF lookup("discnt-value":U, v-level-2) = 0
     3751                                         THEN 0
     3752                                         ELSE buf_dis-rule.discnt-value)
     3753       buf_tt0-term_dis-rule.doc-qnty = (IF lookup("doc-qnty":U, v-level-2) = 0
     3754                                         THEN 0
     3755                                         ELSE buf_dis-rule.doc-qnty)
     3756       buf_tt0-term_dis-rule.dis-kat = (IF lookup("dis-kat":U, v-level-2) = 0
     3757                                             THEN 0
     3758                                             ELSE buf_dis-rule.dis-kat)
     3759       buf_tt0-term_dis-rule.tot-sum = (IF lookup("tot-sum":U, v-level-2) = 0
     3760                                             THEN 0
     3761                                             ELSE buf_dis-rule.tot-sum)
     3762       buf_tt0-term_dis-rule.time-rule-num = (IF lookup("time-rule-num":U, v-level-2) = 0
     3763                                             THEN 0
     3764                                             ELSE buf_dis-rule.time-rule-num)
     3765       buf_tt0-term_dis-rule.charkey_one = (IF lookup("charkey_one":U, v-level-2) = 0
     3766                                             THEN "":U
     3767                                             ELSE buf_dis-rule.charkey_one)
     3768       buf_tt0-term_dis-rule.charkey_two = (IF lookup("charkey_two":U, v-level-2) = 0
     3769                                             THEN "":U
     3770                                             ELSE buf_dis-rule.charkey_two)
     3771       buf_tt0-term_dis-rule.charkey_three = (IF lookup("charkey_three":U, v-level-2) = 0
     3772                                             THEN "":U
     3773                                             ELSE buf_dis-rule.charkey_three)
     3774       buf_tt0-term_dis-rule.deckey_one = (IF lookup("deckey_one":U, v-level-2) = 0
     3775                                             THEN 0
     3776                                             ELSE buf_dis-rule.deckey_one)
     3777       buf_tt0-term_dis-rule.deckey_two = (IF lookup("deckey_two":U, v-level-2) = 0
     3778                                             THEN 0
     3779                                             ELSE buf_dis-rule.deckey_two)
     3780       buf_tt0-term_dis-rule.deckey_three = (IF lookup("deckey_three":U, v-level-2) = 0
     3781                                             THEN 0
     3782                                             ELSE buf_dis-rule.deckey_three)
     3783       buf_tt0-term_dis-rule.key#_one = (IF lookup("key#_one":U, v-level-2) = 0
     3784                                             THEN 0
     3785                                             ELSE buf_dis-rule.key#_one)
     3786       buf_tt0-term_dis-rule.key#_two = (IF lookup("key#_two":U, v-level-2) = 0
     3787                                             THEN 0
     3788                                             ELSE buf_dis-rule.key#_two)
     3789       buf_tt0-term_dis-rule.key#_three = (IF lookup("key#_three":U, v-level-2) = 0
     3790                                             THEN 0
     3791                                             ELSE buf_dis-rule.key#_three)
     3792       .
     3793       create tt-bc-dis-rule.
     3794       assign
     3795       tt-bc-dis-rule.rule-num = (if p-mode = 'ДОБАВЛЕНИЕ':U
     3796                                  then (if v-is-copy
     3797                                        then v-ii
     3798                                        else - buf_dis-rule.rule-num )
     3799                                  else  buf_dis-rule.rule-num)
     3800       tt-bc-dis-rule.price-brutto = v-price-sale
     3801       f-price-brutto = tt-bc-dis-rule.price-brutto
     3802       .
     3803       if buf_dis-rule.tot-sum = - 1 then do:                                                                                                                                                                 CASE buf_dis-rule.value-type:                                                                                         WHEN INTEGER('1':U) THEN DO:                                                                         ASSIGN                                                                                                         tt-bc-dis-rule.d-pcnt      = buf_dis-rule.discnt-value                                                        tt-bc-dis-rule.price-discnt = tt-bc-dis-rule.price-brutto * buf_dis-rule.discnt-value / 100                      tt-bc-dis-rule.price-netto = tt-bc-dis-rule.price-brutto - tt-bc-dis-rule.price-discnt                         tt-bc-dis-rule.sum-brutto = ABS(tt-bc-dis-rule.price-brutto * buf_dis-rule.doc-qnty)                         tt-bc-dis-rule.sum-netto = ABS(tt-bc-dis-rule.price-netto * buf_dis-rule.doc-qnty)                           tt-bc-dis-rule.sum-discnt = ABS(tt-bc-dis-rule.price-discnt * buf_dis-rule.doc-qnty).                      END.                                                                                                            WHEN INTEGER('2':U) THEN DO:                                                                            ASSIGN                                                                                                          tt-bc-dis-rule.price-discnt = buf_dis-rule.discnt-value                                                       tt-bc-dis-rule.price-netto = tt-bc-dis-rule.price-brutto - tt-bc-dis-rule.price-discnt                          tt-bc-dis-rule.d-pcnt       = 100 * (1 - tt-bc-dis-rule.price-netto / tt-bc-dis-rule.price-brutto)              tt-bc-dis-rule.sum-brutto = ABS(tt-bc-dis-rule.price-brutto * buf_dis-rule.doc-qnty)                          tt-bc-dis-rule.sum-netto = ABS(tt-bc-dis-rule.price-netto * buf_dis-rule.doc-qnty)                            tt-bc-dis-rule.sum-discnt = ABS(tt-bc-dis-rule.price-discnt * buf_dis-rule.doc-qnty).                     END.                                                                                                            WHEN INTEGER('3':U) THEN DO:                                                                             ASSIGN                                                                                                          tt-bc-dis-rule.price-netto = buf_dis-rule.discnt-value                                                        tt-bc-dis-rule.price-discnt = tt-bc-dis-rule.price-brutto - tt-bc-dis-rule.price-netto                          tt-bc-dis-rule.sum-brutto = ABS(tt-bc-dis-rule.price-brutto * buf_dis-rule.doc-qnty)                          tt-bc-dis-rule.sum-netto = ABS(tt-bc-dis-rule.price-netto * buf_dis-rule.doc-qnty)                            tt-bc-dis-rule.sum-discnt = ABS(tt-bc-dis-rule.price-discnt * buf_dis-rule.doc-qnty).                     END.                                                                                                       END CASE.                                                                                                   end.                                                                                                           else do:                                                                                                                                                                                  assign  tt-bc-dis-rule.sale-qnty = truncate(buf_dis-rule.tot-sum / tt-bc-dis-rule.price-brutto, v-meas).      CASE buf_dis-rule.value-type:                                                                                         WHEN INTEGER('1':U) THEN DO:                                                                         ASSIGN                                                                                                         tt-bc-dis-rule.price-discnt = tt-bc-dis-rule.price-brutto * buf_dis-rule.discnt-value / 100                      tt-bc-dis-rule.d-pcnt      = buf_dis-rule.discnt-value                                                       tt-bc-dis-rule.price-netto = tt-bc-dis-rule.price-brutto - tt-bc-dis-rule.price-discnt                         tt-bc-dis-rule.sum-brutto = tt-bc-dis-rule.price-brutto * tt-bc-dis-rule.sale-qnty                             tt-bc-dis-rule.sum-netto = tt-bc-dis-rule.price-netto * tt-bc-dis-rule.sale-qnty                               tt-bc-dis-rule.sum-discnt = tt-bc-dis-rule.price-discnt * tt-bc-dis-rule.sale-qnty .                          END.                                                                                                            WHEN INTEGER('2':U) THEN DO:                                                                            ASSIGN                                                                                                          tt-bc-dis-rule.price-discnt = buf_dis-rule.discnt-value                                                       tt-bc-dis-rule.price-netto = tt-bc-dis-rule.price-brutto - tt-bc-dis-rule.price-discnt                          tt-bc-dis-rule.d-pcnt       = 100 * (1 - tt-bc-dis-rule.price-netto / tt-bc-dis-rule.price-brutto)              tt-bc-dis-rule.sum-brutto = tt-bc-dis-rule.price-brutto * tt-bc-dis-rule.sale-qnty                              tt-bc-dis-rule.sum-netto = tt-bc-dis-rule.price-netto * tt-bc-dis-rule.sale-qnty                                tt-bc-dis-rule.sum-discnt = tt-bc-dis-rule.price-discnt * tt-bc-dis-rule.sale-qnty .                        END.                                                                                                            WHEN INTEGER('3':U) THEN DO:                                                                             ASSIGN                                                                                                          tt-bc-dis-rule.price-netto = buf_dis-rule.discnt-value                                                        tt-bc-dis-rule.price-discnt = tt-bc-dis-rule.price-brutto - tt-bc-dis-rule.price-netto                          tt-bc-dis-rule.sum-brutto = tt-bc-dis-rule.price-brutto * tt-bc-dis-rule.sale-qnty                              tt-bc-dis-rule.sum-netto = tt-bc-dis-rule.price-netto * tt-bc-dis-rule.sale-qnty                                tt-bc-dis-rule.sum-discnt = tt-bc-dis-rule.price-discnt * tt-bc-dis-rule.sale-qnty .                        END.                                                                                                       END CASE.                                                                                                   end.
     3804     END.
     3805   end.
     3806   else do:
     3807     FOR EACH buf_dis-rule NO-LOCK WHERE
     3808             buf_dis-rule.rule-num = (if v-is-copy then p-rule-num else tt-dis-rule.rule-num):
     3809       create tt-bc-dis-rule.
     3810       assign
     3811       tt-bc-dis-rule.rule-num = (if p-mode = 'ДОБАВЛЕНИЕ':U
     3812                                  then (if v-is-copy
     3813                                        then - p-rule-num
     3814                                        else - buf_dis-rule.rule-num)
     3815                                   else buf_dis-rule.rule-num)
     3816       tt-bc-dis-rule.price-brutto = v-price-sale
     3817       .
     3818       if buf_dis-rule.tot-sum = - 1 then do:                                                                                                                                                                 CASE buf_dis-rule.value-type:                                                                                         WHEN INTEGER('1':U) THEN DO:                                                                         ASSIGN                                                                                                         tt-bc-dis-rule.d-pcnt      = buf_dis-rule.discnt-value                                                        tt-bc-dis-rule.price-discnt = tt-bc-dis-rule.price-brutto * buf_dis-rule.discnt-value / 100                      tt-bc-dis-rule.price-netto = tt-bc-dis-rule.price-brutto - tt-bc-dis-rule.price-discnt                         tt-bc-dis-rule.sum-brutto = ABS(tt-bc-dis-rule.price-brutto * buf_dis-rule.doc-qnty)                         tt-bc-dis-rule.sum-netto = ABS(tt-bc-dis-rule.price-netto * buf_dis-rule.doc-qnty)                           tt-bc-dis-rule.sum-discnt = ABS(tt-bc-dis-rule.price-discnt * buf_dis-rule.doc-qnty).                      END.                                                                                                            WHEN INTEGER('2':U) THEN DO:                                                                            ASSIGN                                                                                                          tt-bc-dis-rule.price-discnt = buf_dis-rule.discnt-value                                                       tt-bc-dis-rule.price-netto = tt-bc-dis-rule.price-brutto - tt-bc-dis-rule.price-discnt                          tt-bc-dis-rule.d-pcnt       = 100 * (1 - tt-bc-dis-rule.price-netto / tt-bc-dis-rule.price-brutto)              tt-bc-dis-rule.sum-brutto = ABS(tt-bc-dis-rule.price-brutto * buf_dis-rule.doc-qnty)                          tt-bc-dis-rule.sum-netto = ABS(tt-bc-dis-rule.price-netto * buf_dis-rule.doc-qnty)                            tt-bc-dis-rule.sum-discnt = ABS(tt-bc-dis-rule.price-discnt * buf_dis-rule.doc-qnty).                     END.                                                                                                            WHEN INTEGER('3':U) THEN DO:                                                                             ASSIGN                                                                                                          tt-bc-dis-rule.price-netto = buf_dis-rule.discnt-value                                                        tt-bc-dis-rule.price-discnt = tt-bc-dis-rule.price-brutto - tt-bc-dis-rule.price-netto                          tt-bc-dis-rule.sum-brutto = ABS(tt-bc-dis-rule.price-brutto * buf_dis-rule.doc-qnty)                          tt-bc-dis-rule.sum-netto = ABS(tt-bc-dis-rule.price-netto * buf_dis-rule.doc-qnty)                            tt-bc-dis-rule.sum-discnt = ABS(tt-bc-dis-rule.price-discnt * buf_dis-rule.doc-qnty).                     END.                                                                                                       END CASE.                                                                                                   end.                                                                                                           else do:                                                                                                                                                                                  assign  tt-bc-dis-rule.sale-qnty = truncate(buf_dis-rule.tot-sum / tt-bc-dis-rule.price-brutto, v-meas).      CASE buf_dis-rule.value-type:                                                                                         WHEN INTEGER('1':U) THEN DO:                                                                         ASSIGN                                                                                                         tt-bc-dis-rule.price-discnt = tt-bc-dis-rule.price-brutto * buf_dis-rule.discnt-value / 100                      tt-bc-dis-rule.d-pcnt      = buf_dis-rule.discnt-value                                                       tt-bc-dis-rule.price-netto = tt-bc-dis-rule.price-brutto - tt-bc-dis-rule.price-discnt                         tt-bc-dis-rule.sum-brutto = tt-bc-dis-rule.price-brutto * tt-bc-dis-rule.sale-qnty                             tt-bc-dis-rule.sum-netto = tt-bc-dis-rule.price-netto * tt-bc-dis-rule.sale-qnty                               tt-bc-dis-rule.sum-discnt = tt-bc-dis-rule.price-discnt * tt-bc-dis-rule.sale-qnty .                          END.                                                                                                            WHEN INTEGER('2':U) THEN DO:                                                                            ASSIGN                                                                                                          tt-bc-dis-rule.price-discnt = buf_dis-rule.discnt-value                                                       tt-bc-dis-rule.price-netto = tt-bc-dis-rule.price-brutto - tt-bc-dis-rule.price-discnt                          tt-bc-dis-rule.d-pcnt       = 100 * (1 - tt-bc-dis-rule.price-netto / tt-bc-dis-rule.price-brutto)              tt-bc-dis-rule.sum-brutto = tt-bc-dis-rule.price-brutto * tt-bc-dis-rule.sale-qnty                              tt-bc-dis-rule.sum-netto = tt-bc-dis-rule.price-netto * tt-bc-dis-rule.sale-qnty                                tt-bc-dis-rule.sum-discnt = tt-bc-dis-rule.price-discnt * tt-bc-dis-rule.sale-qnty .                        END.                                                                                                            WHEN INTEGER('3':U) THEN DO:                                                                             ASSIGN                                                                                                          tt-bc-dis-rule.price-netto = buf_dis-rule.discnt-value                                                        tt-bc-dis-rule.price-discnt = tt-bc-dis-rule.price-brutto - tt-bc-dis-rule.price-netto                          tt-bc-dis-rule.sum-brutto = tt-bc-dis-rule.price-brutto * tt-bc-dis-rule.sale-qnty                              tt-bc-dis-rule.sum-netto = tt-bc-dis-rule.price-netto * tt-bc-dis-rule.sale-qnty                                tt-bc-dis-rule.sum-discnt = tt-bc-dis-rule.price-discnt * tt-bc-dis-rule.sale-qnty .                        END.                                                                                                       END CASE.                                                                                                   end.
     3819       if is-good-mode then do:
     3820         assign
     3821         f-price-brutto = tt-bc-dis-rule.price-brutto
     3822         f-price-netto = tt-bc-dis-rule.price-netto
     3823         f-price-discnt = tt-bc-dis-rule.price-discnt
     3824         f-d-pcnt = tt-bc-dis-rule.d-pcnt
     3825         f-sum-brutto = tt-bc-dis-rule.sum-brutto
     3826         f-sum-netto = tt-bc-dis-rule.sum-netto
     3827         f-sum-discnt = tt-bc-dis-rule.sum-discnt
     3828         f-sale-qnty = tt-bc-dis-rule.sale-qnty
     3829         .
     3830       end.
     3831       leave.
     3832     end.
     3833   end.
     3834   END PROCEDURE.
     3835   PROCEDURE MyEnable :
     3836   define variable ii AS INTEGER NO-UNDO.
     3837   define variable v-lookup-dtr1 AS CHARACTER NO-UNDO.
     3838   define variable v-lookup-dtr2 AS CHARACTER NO-UNDO.
     3839   define variable v-dop as character no-undo .
     3840   define variable v-entry as character no-undo .
     3841   define variable jj as integer no-undo .
     3842   DEFINE VARIABLE v-list-items AS CHARACTER NO-UNDO.
     3843   DEFINE VARIABLE v-ii         AS INTEGER   NO-UNDO.
     3844   DEFINE VARIABLE v-h AS handle NO-UNDO.
     3845   define buffer buf_temp-drt-prop for temp-drt-prop.
     3846   v-h = br-term-dr:FIRST-COLUMN IN FRAME Dialog-Frame.
     3847   DO while valid-handle(v-h) :
     3848     find first buf_temp-drt-prop no-lock where
     3849               buf_temp-drt-prop.templ-rl-root = p-templ-rl-root
     3850           and buf_temp-drt-prop.upper-prop-code = v-h:name
     3851           and buf_temp-drt-prop.prop-code = "column-label" no-error.
     3852     if available buf_temp-drt-prop then do:
     3853       assign
     3854       v-h:label = buf_temp-drt-prop.property-value.
     3855     end.
     3856     if v-h:LABEL = "Тип" then do:
     3857       v-h:RESIZABLE = YES.
     3858       v-h:visible = (v-value-type = integer('9':U)).
     3859     end.
     3860     v-h = v-h:NEXT-COLUMN.
     3861   END.
     3862   v-list-items = "":U + chr(44) + "":U.
     3863   DO v-ii = 1 TO NUM-ENTRIES('IBM-XML,Autotank,IBM,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,r-keeper,MARIA,-,bo':U):
     3864       ASSIGN
     3865       v-list-items = v-list-items +  chr(44) +
     3866                      ENTRY(v-ii, 'IBM-XML,Autotank,IBM,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,R-KEEPER,MARIA,Накладная,Бэкофис':U) + chr(44) +
     3867                      ENTRY(v-ii, 'IBM-XML,Autotank,IBM,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,r-keeper,MARIA,-,bo':U).
     3868   END.
     3869   assign
     3870   f-pos-type:list-item-pairs in frame Dialog-Frame = v-list-items.
     3871   ASSIGN
     3872   tt-bc-dis-rule.d-pcnt:VISIBLE IN BROWSE br-term-dr = NO
     3873   tt-bc-dis-rule.sum-brutto:VISIBLE IN BROWSE br-term-dr = no
     3874   tt-bc-dis-rule.sum-discnt:VISIBLE IN BROWSE br-term-dr = no
     3875   tt-bc-dis-rule.sum-netto:VISIBLE IN BROWSE br-term-dr = no
     3876   tt-bc-dis-rule.price-brutto:VISIBLE IN BROWSE br-term-dr = NO
     3877   tt-bc-dis-rule.price-discnt:VISIBLE IN BROWSE br-term-dr = NO
     3878   tt-bc-dis-rule.price-netto:VISIBLE IN BROWSE br-term-dr = NO
     3879   tt-bc-dis-rule.sale-qnty:VISIBLE IN BROWSE br-term-dr = no
     3880   tt0-term_dis-rule.discnt-value:visible IN BROWSE BR-term-dr = false
     3881   tt0-term_dis-rule.doc-qnty:VISIBLE IN BROWSE BR-term-dr = FALSE
     3882   tt0-term_dis-rule.tot-sum:VISIBLE IN BROWSE BR-term-dr = FALSE
     3883   tt0-term_dis-rule.dis-kat:VISIBLE IN BROWSE BR-term-dr = FALSE
     3884   tt0-term_dis-rule.time-rule-num:VISIBLE IN BROWSE BR-term-dr = FALSE
     3885   tt0-term_dis-rule.discnt-value:COLUMN-READ-ONLY IN BROWSE BR-term-dr = TRUE
     3886   tt0-term_dis-rule.charkey_one:VISIBLE IN BROWSE BR-term-dr = FALSE
     3887   tt0-term_dis-rule.charkey_two:VISIBLE IN BROWSE BR-term-dr = FALSE
     3888   tt0-term_dis-rule.charkey_three:VISIBLE IN BROWSE BR-term-dr = FALSE
     3889   tt0-term_dis-rule.deckey_one:VISIBLE IN BROWSE BR-term-dr = FALSE
     3890   tt0-term_dis-rule.deckey_two:VISIBLE IN BROWSE BR-term-dr = FALSE
     3891   tt0-term_dis-rule.deckey_three:VISIBLE IN BROWSE BR-term-dr = FALSE
     3892   tt0-term_dis-rule.key#_one:VISIBLE IN BROWSE BR-term-dr = FALSE
     3893   tt0-term_dis-rule.key#_two:VISIBLE IN BROWSE BR-term-dr = FALSE
     3894   tt0-term_dis-rule.key#_three:VISIBLE IN BROWSE BR-term-dr = FALSE
     3895   tt-bc-dis-rule.d-pcnt:auto-resize IN BROWSE br-term-dr = yes
     3896   tt-bc-dis-rule.sum-brutto:auto-resize IN BROWSE br-term-dr = yes
     3897   tt-bc-dis-rule.sum-discnt:auto-resize IN BROWSE br-term-dr = yes
     3898   tt-bc-dis-rule.sum-netto:auto-resize IN BROWSE br-term-dr = yes
     3899   tt-bc-dis-rule.price-brutto:auto-resize IN BROWSE br-term-dr = yes
     3900   tt-bc-dis-rule.price-discnt:auto-resize IN BROWSE br-term-dr = yes
     3901   tt-bc-dis-rule.price-netto:auto-resize IN BROWSE br-term-dr = yes
     3902   tt-bc-dis-rule.sale-qnty:auto-resize IN BROWSE br-term-dr = yes
     3903   tt0-term_dis-rule.discnt-value:auto-resize IN BROWSE BR-term-dr = true
     3904   tt0-term_dis-rule.doc-qnty:auto-resize IN BROWSE BR-term-dr = true
     3905   tt0-term_dis-rule.tot-sum:auto-resize IN BROWSE BR-term-dr = true
     3906   tt0-term_dis-rule.dis-kat:auto-resize IN BROWSE BR-term-dr = true
     3907   tt0-term_dis-rule.time-rule-num:auto-resize IN BROWSE BR-term-dr = true
     3908   tt0-term_dis-rule.charkey_one:auto-resize IN BROWSE BR-term-dr = true
