      659   ON CHOOSE OF B-add IN FRAME Dialog-Frame
      660   DO:
      661   define variable vss-include-info2 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      662   if lookup(self :type
      663            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      664            ) = 0
      665   then do:
      666     message
      667       "$Workfile$"
      668       "Указанному интерфейсному элементу фокус не может быть передан" skip
      669       "Интерфейсный элемент" self :name  skip
      670       "Тип" self :type  skip
      671       "Процедура" this-procedure :file-name skip
      672       view-as alert-box .
      673   end.
      674   else do:
      675     apply "entry":u to self  .
      676     if focus :handle <> self :handle  then do:
      677       return no-apply .
      678     end.
      679   end.
      680     IF b-exit-1:VISIBLE IN FRAME Dialog-Frame THEN DO:
      681         BELL.
      682         RETURN NO-APPLY.
      683     END.
      684     RUN proc-b-add IN THIS-PROCEDURE NO-ERROR.
      685     IF ERROR-STATUS:ERROR THEN do:
      686         RETURN NO-APPLY.
      687     END.
      688   END.
