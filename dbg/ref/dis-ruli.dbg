     4203   PROCEDURE OpenBr-term-dr :
     4204   define variable v-h as widget-handle no-undo .
     4205   v-h = br-term-dr:FIRST-COLUMN IN FRAME Dialog-Frame.
     4206   if p-templ-rl-root = 80 then do:
     4207     OPEN QUERY BR-term-dr
     4208       FOR  EACH tt0-term_dis-rule WHERE
     4209               tt0-term_dis-rule.upper-rule-num = tt-dis-rule.rule-num,
     4210       FIRST tt-bc-dis-rule NO-LOCK WHERE tt-bc-dis-rule.rule-num = tt0-term_dis-rule.rule-num
     4211     BY tt0-term_dis-rule.discnt-value
     4212     BY tt0-term_dis-rule.dis-kat
     4213     .
     4214   end.
     4215   else do:
     4216   OPEN QUERY BR-term-dr
     4217     FOR  EACH tt0-term_dis-rule WHERE
     4218              tt0-term_dis-rule.upper-rule-num = tt-dis-rule.rule-num,
     4219     FIRST tt-bc-dis-rule NO-LOCK WHERE tt-bc-dis-rule.rule-num = tt0-term_dis-rule.rule-num
     4220   BY tt0-term_dis-rule.doc-qnty
     4221   BY tt0-term_dis-rule.tot-sum
     4222   BY tt0-term_dis-rule.dis-kat
     4223   BY tt0-term_dis-rule.time-rule-num
     4224   .
     4225   end.
     4226   if available tt0-term_dis-rule
     4227   and v-start-br-term-dr-format
     4228   then do:
     4229     v-start-br-term-dr-format = no.
     4230     DO while valid-handle(v-h) :
     4231       find first buf_temp-drt-prop no-lock where
     4232                 buf_temp-drt-prop.templ-rl-root = p-templ-rl-root
     4233             and buf_temp-drt-prop.upper-prop-code = v-h:name
     4234             and buf_temp-drt-prop.prop-code = "format":U no-error.
     4235       if available buf_temp-drt-prop then do:
     4236         assign
     4237         v-h:format = buf_temp-drt-prop.property-value.
     4238       end.
     4239       v-h = v-h:NEXT-COLUMN.
     4240     END.
     4241   end.
     4242   END PROCEDURE.
     4243   PROCEDURE proc-b-add :
     4244   define variable choice as integer no-undo .
     4245   IF v-tree = "":U THEN RETURN ERROR.
     4246   if v-value-type = integer('9':U) then do:
     4247     run gbl/d-askw.w ( input "Рекомендация"
     4248                 ,input  ("Выберите тип скидки" + chr(10)
     4249                         + "(% или Abs или Фиксированная цена)")
     4250                 ,input "|"
     4251                 ,input "%|Abs|Фиксированная цена|Отмена"
     4252                 ,input "|||"
     4253                 ,input 1
     4254                 ,input 4
     4255                 ,output choice).
     4256     if choice = 4 then do:
     4257       undo, return error .
     4258     end.
     4259     case choice:
     4260       when 1 then do:
     4261         v-term-value-type = integer('1':U).
     4262       end.
     4263       when 2 then do:
     4264         v-term-value-type = integer('2':U).
     4265       end.
     4266       when 3 then do:
     4267         v-term-value-type = integer('3':U).
     4268       end.
     4269     end case.
     4270   end.
     4271   IF tt-dis-rule.discnt-value:SENSITIVE IN FRAME Dialog-Frame THEN
     4272   ASSIGN
     4273   tt-dis-rule.discnt-value
     4274   .
