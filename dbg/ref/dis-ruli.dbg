     1307   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1308   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1309   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1310   on help of frame Dialog-Frame
     1311   do:
     1312     run gbl/app_help.p
     1313       (input this-procedure :file-name
     1314       ,input ''
     1315       ,input ?
     1316       ) no-error.
     1317     if error-status :error then do:
     1318       message
     1319         "Ошибка при вызове помощи"
     1320         error-status :get-message(1)
     1321         view-as alert-box .
     1322     end.
     1323   end.
     1324   run minbtn-set in this-procedure .
     1325   on choose of b-help in frame Dialog-Frame
     1326   do:
     1327     apply "help":u to frame Dialog-Frame .
     1328   end.
     1329   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1330   procedure minbtn-set :
     1331       do
     1332           on error undo, return error return-value
     1333           :
     1334           define variable ii              as integer       no-undo .
     1335           define variable fh              as widget-handle no-undo .
     1336           define variable hh              as widget-handle no-undo .
     1337           define variable v-h             as handle        extent 4 no-undo .
     1338           define variable v-name-button   as character     no-undo .
     1339           define variable v-help-old-x    as decimal       no-undo .
     1340           define variable v-help-old-y    as decimal       no-undo .
     1341           define variable v-help-old-size as decimal       no-undo .
     1342           define variable v-frame-width   as decimal       no-undo .
     1343           define variable jj              as integer       no-undo .
     1344           do
     1345               on error undo, return error
     1346               :
     1347               assign
     1348                   v-frame-width = frame Dialog-Frame:width - 0.3
     1349                   fh            = frame Dialog-Frame:first-child
     1350                   hh            = fh:first-child
     1351                   ii            = 1
     1352                   .
     1353               do while valid-handle(hh):
     1354                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1355                   do:
     1356                       case lc(hh:name) :
     1357                           when "b-help" then
     1358                               do:
     1359                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1360                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1361                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1362                                   hh:TOOLTIP = "Помощь" .
     1363                                   v-help-old-x = hh:column .
     1364                                   v-help-old-y = hh:row    .
     1365                                   v-help-old-size = hh:width .
     1366                                   hh:width-chars = 2.5 .
     1367                               end.
     1368                           when "b-print" then
     1369                               do:
     1370                                   hh:load-image("cmp/b-print.bmp":u) .
     1371                                   hh:TOOLTIP = "Печать" .
     1372                                   v-h[ii] = hh:handle .
     1373                                   ii = ii + 1 .
     1374                                   hh:width-chars = 3 .
     1375                               end.
     1376                           when "b-history" or
     1377                           when "b-hist" then
     1378                               do:
     1379                                   hh:load-image("cmp/b-hist.bmp":u) .
     1380                                   hh:TOOLTIP = "История" .
     1381                                   v-h[ii] = hh:handle .
     1382                                   ii = ii + 1 .
     1383                                   hh:width-chars = 3 .
     1384                               end.
     1385                           when "b-sch" then
     1386                               do:
     1387                                   hh:load-image("cmp/b-sch.bmp":u) .
     1388                                   hh:TOOLTIP = "Установка Фильтра" .
     1389                                   v-h[ii] = hh:handle .
     1390                                   ii = ii + 1 .
     1391                                   hh:width-chars = 3 .
     1392                               end.
     1393                           when "b-hist-user" then
     1394                               do:
     1395                                   hh:load-image("cmp/b-hist.bmp":u) .
     1396                                   hh:TOOLTIP = "История пользователя" .
     1397                                   ii = ii + 1 .
     1398                               end.
     1399                       end case.
     1400                   end.
     1401                   hh = hh:next-sibling.
     1402               end.
     1403               b-help:column = v-frame-width - b-help:width-chars.
     1404               jj = 0.
     1405               repeat ii = 4 to 1 by -1 :
     1406                   if valid-handle (v-h[ii] ) then
     1407                   do:
     1408                       jj  = jj + 1 .
     1409                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1410                       v-h[ii]:row    = v-help-old-y .
     1411                   end.
     1412               end.
     1413           end.
     1414       end.
     1415   end procedure.
     1416   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1417   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1418   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1419   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1420   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1421   define variable v-diasize-current-frame-height as decimal   no-undo .
     1422   define variable v-diasize-change-size          as logical   no-undo .
     1423   define variable v-diasize-resize-button        as handle    no-undo .
     1424   define variable v-diasize-wndmax               as logical   no-undo .
     1425   define variable v-diasize-wndstore             as logical   no-undo .
     1426   define variable v-diasize-proc-name            as character no-undo .
     1427   define variable v-diasize-browse-handle        as handle    no-undo .
     1428   define variable v-diasize-browse-number        as integer   no-undo .
     1429   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1430   define temp-table temp-diasize-handle no-undo
     1431     field handle-value  as handle
     1432     field save-position as decimal
     1433     index xpk is primary unique handle-value
     1434     .
     1435   define temp-table temp-browse-handle no-undo
     1436     field browse-type   as character
     1437     field browse-number as integer
     1438     field browse-handle as handle
     1439     field original-size as decimal
     1440     index xpk is primary unique browse-type browse-number
     1441     index xie browse-type browse-handle
     1442   .
     1443   procedure diasize_change-height :
     1444     define input  parameter p-change-value  as decimal   no-undo .
     1445     define input  parameter p-move-resize   as logical   no-undo .
     1446     define variable v-field-group-handle    as handle    no-undo .
     1447     define variable v-object-handle         as handle    no-undo .
     1448     define variable v-frame-height          as decimal   no-undo .
     1449     define variable v-frame-virtual-height  as decimal   no-undo .
     1450     define variable v-browse-height         as decimal   no-undo .
     1451     define variable v-window-height         as decimal   no-undo .
     1452     define variable v-window-virtual-height as decimal   no-undo .
     1453     define variable v-change-sign           as integer   no-undo .
     1454     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1455     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1456     if p-change-value > 0
     1457     then do:
     1458       if frame Dialog-Frame :height + p-change-value
     1459           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1460       then do:
     1461         assign
     1462           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1463                           - (frame Dialog-Frame :height-chars)
     1464         .
     1465         if p-change-value <= 0
     1466         then do:
     1467           run diasize_position-resize-button in this-procedure .
     1468           return .
     1469         end.
     1470       end.
     1471     end.
     1472     if p-change-value < 0
     1473     then do:
     1474       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1475       then do:
     1476         assign
     1477           p-change-value = v-diasize-orig-frame-height
     1478                          - (frame Dialog-Frame :height-chars)
     1479         .
     1480         if p-change-value >= 0
     1481         then do:
     1482           run diasize_position-resize-button in this-procedure .
     1483           return .
     1484         end.
     1485       end.
     1486     end.
     1487     if p-change-value >= 0
     1488     then do:
     1489       assign
     1490         v-change-sign = 1
     1491       .
     1492     end.
     1493     else do:
     1494       assign
     1495         v-change-sign = -1
     1496       .
     1497     end.
     1498     assign
     1499       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1500     .
     1501     if p-change-value = 0
     1502     then do:
     1503       run diasize_position-resize-button in this-procedure .
     1504       return .
     1505     end.
     1506     move_block:
     1507     do
     1508     on error undo move_block, retry move_block
     1509     :
     1510       if retry
     1511       then do:
     1512         do
     1513         on error undo move_block, leave move_block
     1514         :
     1515           if p-change-value > 0
     1516           then do:
     1517             for each buf_temp-diasize-handle
     1518             on error undo, next
     1519             :
     1520               assign
     1521                 v-object-handle = buf_temp-diasize-handle.handle-value
     1522               .
     1523               if v-object-handle <> v-diasize-resize-button
     1524               then do:
     1525                 assign
     1526                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1527                 .
     1528               end.
     1529             end.
     1530             assign
     1531               v-diasize-browse-handle :height = v-browse-height
     1532             .
     1533             for each buf_temp-browse-handle
     1534               where buf_temp-browse-handle.browse-type = 'height':u
     1535             on error undo, next
     1536             :
     1537               assign
     1538                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1539               .
     1540             end.
     1541             assign
     1542               frame Dialog-Frame :height = v-frame-height
     1543             .
     1544             if frame Dialog-Frame :scrollable = true
     1545             then do:
     1546               assign
     1547                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1548               .
     1549             end.
     1550             run diasize_position-resize-button in this-procedure .
     1551           end.
     1552           else do:
     1553             if frame Dialog-Frame :scrollable = true
     1554             then do:
     1555               assign
     1556                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1557               .
     1558             end.
     1559             assign
     1560               frame Dialog-Frame :height = v-frame-height
     1561             .
     1562             assign
     1563               v-diasize-browse-handle :height = v-browse-height
     1564             .
     1565             for each buf_temp-browse-handle
     1566               where buf_temp-browse-handle.browse-type = 'height':u
     1567             on error undo, next
     1568             :
     1569               assign
     1570                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1571               .
     1572             end.
     1573             for each buf_temp-diasize-handle
     1574             on error undo, next
     1575             :
     1576               assign
     1577                 v-object-handle = buf_temp-diasize-handle.handle-value
     1578               .
     1579               if v-object-handle <> v-diasize-resize-button
     1580               then do:
     1581                 assign
     1582                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1583                 .
     1584               end.
     1585             end.
     1586             run diasize_position-resize-button in this-procedure .
     1587           end.
     1588           assign
     1589             v-diasize-change-size = false
     1590           .
     1591           leave move_block .
     1592         end.
     1593       end.
     1594       assign
     1595         v-diasize-need-full-display = true
     1596       .
     1597       if v-diasize-change-size = false
     1598       then do:
     1599         assign
     1600           v-diasize-change-size = true
     1601         .
     1602       end.
     1603       else do:
     1604         return .
     1605       end.
     1606       assign
     1607         v-frame-height = frame Dialog-Frame :height
     1608         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1609         v-browse-height = v-diasize-browse-handle :height
     1610       .
     1611       for each buf_temp-browse-handle
     1612         where buf_temp-browse-handle.browse-type = 'height':u
     1613       :
     1614         assign
     1615           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1616         .
     1617       end.
     1618       for each buf_temp-diasize-handle
     1619       :
     1620         delete buf_temp-diasize-handle .
     1621       end.
     1622       assign
     1623         v-field-group-handle = frame Dialog-Frame :first-child
     1624       .
     1625       do while valid-handle(v-field-group-handle)
     1626       :
     1627         assign
     1628           v-object-handle = v-field-group-handle :first-child
     1629         .
     1630         do while valid-handle(v-object-handle)
     1631         :
     1632           if  v-object-handle <> v-diasize-browse-handle :handle
     1633           and can-query(v-object-handle, "row")
     1634           and can-query(v-object-handle, "height")
     1635           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1636           then do:
     1637             find first buf_temp-browse-handle
     1638               where buf_temp-browse-handle.browse-type   = 'height':u
     1639                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1640               no-error .
     1641             if available buf_temp-browse-handle
     1642             then do:
     1643             end.
     1644             else do:
     1645               create buf_temp-diasize-handle .
     1646               assign
     1647                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1648                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1649               .
     1650             end.
     1651           end.
     1652           assign
     1653             v-object-handle = v-object-handle :next-sibling
     1654           .
     1655         end.
     1656         assign
     1657           v-field-group-handle = v-field-group-handle :next-sibling
     1658         .
     1659       end.
     1660       do with frame Dialog-Frame
     1661       :
     1662         hide v-diasize-resize-button .
     1663         assign
     1664           v-diasize-resize-button :row    = 1
     1665           v-diasize-resize-button :column = 1
     1666         .
     1667       end.
     1668       if p-change-value > 0
     1669       then do:
     1670         if frame Dialog-Frame :scrollable = true
     1671         then do:
     1672           assign
     1673             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1674             no-error .
     1675           if error-status :error
     1676           or error-status :get-message(1) <> ""
     1677           then do:
     1678             undo move_block, retry move_block .
     1679           end.
     1680         end.
     1681         assign
     1682           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1683           no-error .
     1684         if error-status :error
     1685         or error-status :get-message(1) <> ""
     1686         then do:
     1687           undo move_block, retry move_block .
     1688         end.
     1689         assign
     1690           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1691           no-error .
     1692         if error-status :error
     1693         or error-status :get-message(1) <> ""
     1694         then do:
     1695           undo move_block, retry move_block .
     1696         end.
     1697         for each buf_temp-browse-handle
     1698           where buf_temp-browse-handle.browse-type = 'height':u
     1699         on error undo move_block, retry move_block
     1700         :
     1701           assign
     1702             buf_temp-browse-handle.browse-handle :height
     1703               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1704             no-error .
     1705           if error-status :error
     1706           or error-status :get-message(1) <> ""
     1707           then do:
     1708             undo move_block, retry move_block .
     1709           end.
     1710         end.
     1711         for each buf_temp-diasize-handle
     1712         on error undo move_block, retry move_block
     1713         :
     1714           assign
     1715             v-object-handle = buf_temp-diasize-handle.handle-value
     1716           .
     1717           if v-object-handle <> v-diasize-resize-button
     1718           then do:
     1719             assign
     1720               v-object-handle :row = v-object-handle :row + p-change-value
     1721               no-error .
     1722             if error-status :error
     1723             or error-status :get-message(1) <> ""
     1724             then do:
     1725               undo move_block, retry move_block .
     1726             end.
     1727           end.
     1728         end.
     1729       end.
     1730       else do:
     1731         for each buf_temp-diasize-handle
     1732         on error undo move_block, retry move_block
     1733         :
     1734           assign
     1735             v-object-handle = buf_temp-diasize-handle.handle-value
     1736           .
     1737           if v-object-handle <> v-diasize-resize-button
     1738           then do:
     1739             assign
     1740               v-object-handle :row = v-object-handle :row + p-change-value
     1741               no-error .
     1742             if error-status :error
     1743             or error-status :get-message(1) <> ""
     1744             then do:
     1745               undo move_block, retry move_block .
     1746             end.
     1747           end.
     1748         end.
     1749         assign
     1750           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1751           no-error .
     1752         if error-status :error
     1753         or error-status :get-message(1) <> ""
     1754         then do:
     1755           undo move_block, retry move_block .
     1756         end.
     1757         for each buf_temp-browse-handle
     1758           where buf_temp-browse-handle.browse-type = 'height':u
     1759         on error undo move_block, retry move_block
     1760         :
     1761           assign
     1762             buf_temp-browse-handle.browse-handle :height
     1763               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1764             no-error .
     1765           if error-status :error
     1766           or error-status :get-message(1) <> ""
     1767           then do:
     1768             undo move_block, retry move_block .
     1769           end.
     1770         end.
     1771         assign
     1772           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1773           no-error .
     1774         if error-status :error
     1775         or error-status :get-message(1) <> ""
     1776         then do:
     1777           undo move_block, retry move_block .
     1778         end.
     1779         if frame Dialog-Frame :scrollable = true
     1780         then do:
     1781           assign
     1782             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1783             no-error .
     1784           if error-status :error
     1785           or error-status :get-message(1) <> ""
     1786           then do:
     1787             undo move_block, retry move_block .
     1788           end.
     1789         end.
     1790       end.
     1791       if p-move-resize = true
     1792       then do:
     1793         run diasize_position-resize-button in this-procedure .
     1794       end.
     1795       if v-diasize-wndstore = true
     1796       then do:
     1797         if connected("ub") = true
     1798         then do:
     1799           define variable v-cntxt-db-num        as integer   no-undo .
     1800           define variable v-cntxt-userid        as character no-undo .
     1801           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1802                                             , OUTPUT v-cntxt-userid
     1803                                             ) .
     1804           run gbl/wndsizew.p
     1805             (input  v-cntxt-db-num
     1806             ,input  v-cntxt-userid
     1807             ,input  v-diasize-proc-name
     1808             ,input  'height':u
     1809             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1810             ) .
     1811         end.
     1812       end.
     1813     end.
     1814     assign
     1815       v-diasize-change-size = false
     1816     .
     1817   end procedure.
     1818   procedure diasize_set-height :
     1819     define input  parameter p-new-height  as decimal   no-undo .
     1820     define input  parameter p-move-resize as logical   no-undo .
     1821     do
     1822     on error undo, return error return-value
     1823     :
     1824       run diasize_change-height in this-procedure
     1825         (input  (p-new-height - frame Dialog-Frame :height)
     1826         ,input  p-move-resize
     1827         ) .
     1828     end.
     1829   end procedure.
     1830   procedure diasize_change-width :
     1831     define input  parameter p-change-value as decimal   no-undo .
     1832     define input  parameter p-move-resize  as logical   no-undo .
     1833     define variable v-field-group-handle   as handle    no-undo .
     1834     define variable v-object-handle        as handle    no-undo .
     1835     define variable v-frame-width          as decimal   no-undo .
     1836     define variable v-frame-virtual-width  as decimal   no-undo .
     1837     define variable v-browse-width         as decimal   no-undo .
     1838     define variable v-window-width         as decimal   no-undo .
     1839     define variable v-window-virtual-width as decimal   no-undo .
     1840     define variable v-change-sign          as integer   no-undo .
     1841     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1842     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1843     if p-change-value > 0
     1844     then do:
     1845       if frame Dialog-Frame :width + p-change-value >
     1846           session :width-chars
     1847       then do:
     1848         assign
     1849           p-change-value = session :width-chars - frame Dialog-Frame :width
     1850         .
     1851         if p-change-value <= 0
     1852         then do:
     1853           run diasize_position-resize-button in this-procedure .
     1854           return .
     1855         end.
     1856       end.
     1857     end.
     1858     if p-change-value < 0
     1859     then do:
     1860       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1861       then do:
     1862         assign
     1863           p-change-value = v-diasize-orig-frame-width
     1864                          - frame Dialog-Frame :width
     1865         .
     1866         if p-change-value >= 0
     1867         then do:
     1868           run diasize_position-resize-button in this-procedure .
     1869           return .
     1870         end.
     1871       end.
     1872     end.
     1873     if p-change-value >= 0
     1874     then do:
     1875       assign
     1876         v-change-sign = 1
     1877       .
     1878     end.
     1879     else do:
     1880       assign
     1881         v-change-sign = -1
     1882       .
     1883     end.
     1884     assign
     1885       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1886     .
     1887     if p-change-value = 0
     1888     then do:
     1889       run diasize_position-resize-button in this-procedure .
     1890       return .
     1891     end.
     1892     move_block:
     1893     do
     1894     on error undo move_block, leave move_block
     1895     :
     1896       if retry
     1897       then do:
     1898         do
     1899         on error undo move_block, leave move_block
     1900         :
     1901           if p-change-value > 0
     1902           then do:
     1903             for each buf_temp-diasize-handle
     1904             on error undo, next
     1905             :
     1906               assign
     1907                 v-object-handle = buf_temp-diasize-handle.handle-value
     1908               .
     1909               if v-object-handle <> v-diasize-resize-button
     1910               then do:
     1911                 assign
     1912                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1913                 .
     1914               end.
     1915             end.
     1916             assign
     1917               v-diasize-browse-handle :width = v-browse-width
     1918             .
     1919             for each buf_temp-browse-handle
     1920               where buf_temp-browse-handle.browse-type = 'width':u
     1921             on error undo, next
     1922             :
     1923               assign
     1924                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1925               .
     1926             end.
     1927             assign
     1928               frame Dialog-Frame :width = v-frame-width
     1929             .
     1930             if frame Dialog-Frame :scrollable = true
     1931             then do:
     1932               assign
     1933                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1934               .
     1935             end.
     1936             run diasize_position-resize-button in this-procedure .
     1937           end.
     1938           else do:
     1939             if frame Dialog-Frame :scrollable = true
     1940             then do:
     1941               assign
     1942                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1943               .
     1944             end.
     1945             assign
     1946               frame Dialog-Frame :width = v-frame-width
     1947             .
     1948             for each buf_temp-browse-handle
     1949               where buf_temp-browse-handle.browse-type = 'width':u
     1950             on error undo, next
     1951             :
     1952               assign
     1953                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1954               .
     1955             end.
     1956             assign
     1957               v-diasize-browse-handle :width = v-browse-width
     1958             .
     1959             for each buf_temp-diasize-handle
     1960             on error undo, next
     1961             :
     1962               assign
     1963                 v-object-handle = buf_temp-diasize-handle.handle-value
     1964               .
     1965               if v-object-handle <> v-diasize-resize-button
     1966               then do:
     1967                 assign
     1968                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1969                 .
     1970               end.
     1971             end.
     1972             run diasize_position-resize-button in this-procedure .
     1973           end.
     1974           assign
     1975             v-diasize-change-size = false
     1976           .
     1977           leave move_block .
     1978         end.
     1979       end.
     1980       assign
     1981         v-diasize-need-full-display = true
     1982       .
     1983       if v-diasize-change-size = false
     1984       then do:
     1985         assign
     1986           v-diasize-change-size = true
     1987         .
     1988       end.
     1989       else do:
     1990         return .
     1991       end.
     1992       assign
     1993         v-frame-width = frame Dialog-Frame :width
     1994         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1995         v-browse-width = v-diasize-browse-handle :width
     1996       .
     1997       for each buf_temp-browse-handle
     1998         where buf_temp-browse-handle.browse-type = 'width':u
     1999       :
     2000         assign
     2001           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2002         .
     2003       end.
     2004       for each buf_temp-diasize-handle
     2005       :
     2006         delete buf_temp-diasize-handle .
     2007       end.
     2008       assign
     2009         v-field-group-handle = frame Dialog-Frame :first-child
     2010       .
     2011       do while valid-handle(v-field-group-handle)
     2012       :
     2013         assign
     2014           v-object-handle = v-field-group-handle :first-child
     2015         .
     2016         do while valid-handle(v-object-handle)
     2017         :
     2018           if  v-object-handle <> v-diasize-browse-handle :handle
     2019           and v-object-handle <> v-diasize-resize-button
     2020           and can-query(v-object-handle, "row")
     2021           and can-query(v-object-handle, "height")
     2022           and ( v-object-handle :col + v-object-handle :width
     2023                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2024               )
     2025           then do:
     2026             find first buf_temp-browse-handle
     2027               where buf_temp-browse-handle.browse-type   = 'width':u
     2028                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2029               no-error .
     2030             if available buf_temp-browse-handle
     2031             then do:
     2032             end.
     2033             else do:
     2034               create buf_temp-diasize-handle .
     2035               assign
     2036                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2037                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2038               .
     2039             end.
     2040           end.
     2041           assign
     2042             v-object-handle = v-object-handle :next-sibling
     2043           .
     2044         end.
     2045         assign
     2046           v-field-group-handle = v-field-group-handle :next-sibling
     2047         .
     2048       end.
     2049       do with frame Dialog-Frame
     2050       :
     2051         hide v-diasize-resize-button .
     2052         v-diasize-resize-button :row = 1.
     2053         v-diasize-resize-button :column = 1.
     2054       end.
     2055       if p-change-value > 0
     2056       then do:
     2057         if frame Dialog-Frame :scrollable = true
     2058         then do:
     2059           assign
     2060             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2061             no-error .
     2062           if error-status :error
     2063           or error-status :get-message(1) <> ""
     2064           then do:
     2065             undo move_block, retry move_block.
     2066           end.
     2067         end.
     2068         assign
     2069           frame Dialog-Frame :width = v-frame-width + p-change-value
     2070           no-error .
     2071         if error-status :error
     2072         or error-status :get-message(1) <> ""
     2073         then do:
     2074           undo move_block, retry move_block.
     2075         end.
     2076         assign
     2077           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2078         no-error .
     2079         if error-status :error
     2080         or error-status :get-message(1) <> ""
     2081         then do:
     2082           undo move_block, retry move_block.
     2083         end.
     2084         for each buf_temp-browse-handle
     2085           where buf_temp-browse-handle.browse-type = 'width':u
     2086         on error undo move_block, retry move_block
     2087         :
     2088           assign
     2089             buf_temp-browse-handle.browse-handle :width
     2090               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2091             no-error .
     2092           if error-status :error
     2093           or error-status :get-message(1) <> ""
     2094           then do:
     2095             undo move_block, retry move_block .
     2096           end.
     2097         end.
     2098         for each buf_temp-diasize-handle
     2099         on error undo move_block, retry move_block
     2100         :
     2101           assign
     2102             v-object-handle = buf_temp-diasize-handle.handle-value
     2103           .
     2104           if v-object-handle <> v-diasize-resize-button
     2105           then do:
     2106             assign
     2107               v-object-handle :col = v-object-handle :col + p-change-value
     2108               no-error .
     2109             if error-status :error
     2110             or error-status :get-message(1) <> ""
     2111             then do:
     2112               undo move_block, retry move_block .
     2113             end.
     2114           end.
     2115         end.
     2116       end.
     2117       else do:
     2118         for each buf_temp-diasize-handle
     2119         on error undo move_block, retry move_block
     2120         :
     2121           assign
     2122             v-object-handle = buf_temp-diasize-handle.handle-value
     2123           .
     2124           if v-object-handle <> v-diasize-resize-button
     2125           then do:
     2126             assign
     2127               v-object-handle :col = v-object-handle :col + p-change-value
     2128               no-error .
     2129             if error-status :error
     2130             or error-status :get-message(1) <> ""
     2131             then do:
     2132               undo move_block, retry move_block .
     2133             end.
     2134           end.
     2135         end.
     2136         for each buf_temp-browse-handle
     2137           where buf_temp-browse-handle.browse-type = 'width':u
     2138         on error undo move_block, retry move_block
     2139         :
     2140           assign
     2141             buf_temp-browse-handle.browse-handle :width
     2142               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2143             no-error .
     2144           if error-status :error
     2145           or error-status :get-message(1) <> ""
     2146           then do:
     2147             undo move_block, retry move_block .
     2148           end.
     2149         end.
     2150         assign
     2151           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2152           no-error .
     2153         if error-status :error
     2154         or error-status :get-message(1) <> ""
     2155         then do:
     2156           undo move_block, retry move_block.
     2157         end.
     2158         assign
     2159           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2160         no-error .
     2161         if error-status :error
     2162         or error-status :get-message(1) <> ""
     2163         then do:
     2164           undo move_block, retry move_block.
     2165         end.
     2166         if frame Dialog-Frame :scrollable = true
     2167         then do:
     2168           assign
     2169             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2170           no-error .
     2171           if error-status :error
     2172           or error-status :get-message(1) <> ""
     2173           then do:
     2174             undo move_block, retry move_block.
     2175           end.
     2176         end.
     2177       end.
     2178       if p-move-resize
     2179       then do:
     2180         run diasize_position-resize-button in this-procedure .
     2181       end.
     2182       if v-diasize-wndstore = true
     2183       then do:
     2184         if connected("ub") = true
     2185         then do:
     2186           define variable v-cntxt-db-num        as integer   no-undo .
     2187           define variable v-cntxt-userid        as character no-undo .
     2188           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2189                                             , OUTPUT v-cntxt-userid
     2190                                             ) .
     2191           run gbl/wndsizew.p
     2192             (input  v-cntxt-db-num
     2193             ,input  v-cntxt-userid
     2194             ,input  v-diasize-proc-name
     2195             ,input  'width':u
     2196             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2197             ) .
     2198         end.
     2199       end.
     2200     end.
     2201     assign
     2202       v-diasize-change-size = false
     2203     .
     2204   end procedure.
     2205   procedure diasize_set-width :
     2206     define input  parameter p-new-width  as decimal   no-undo .
     2207     define input  parameter p-move-resize as logical   no-undo .
     2208     do
     2209     on error undo, return error return-value
     2210     :
     2211       run diasize_change-width in this-procedure
     2212         (input  (p-new-width - frame Dialog-Frame :width)
     2213         ,input  p-move-resize
     2214         ) .
     2215     end.
     2216   end procedure.
     2217   procedure diasize_position-resize-button :
     2218     do with frame Dialog-Frame
     2219     :
     2220       hide v-diasize-resize-button .
     2221       assign
     2222         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2223                     - 1
     2224                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2225         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2226                     - 1
     2227                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2228       .
     2229       view v-diasize-resize-button .
     2230     end.
     2231   end procedure.
     2232   on alt-right anywhere
     2233   do:
     2234     run diasize_change-width in this-procedure
     2235       (input 1
     2236       ,input true
     2237       ) .
     2238     return no-apply .
     2239   end.
     2240   on alt-left anywhere
     2241   do:
     2242     run diasize_change-width in this-procedure
     2243       (input -1
     2244       ,input true
     2245       ) .
     2246     return no-apply .
     2247   end.
     2248   on alt-down anywhere
     2249   do:
     2250     run diasize_change-height in this-procedure
     2251       (input 1
     2252       ,input true
     2253       ) .
     2254     return no-apply .
     2255   end.
     2256   on alt-up anywhere
     2257   do:
     2258     run diasize_change-height in this-procedure
     2259       (input -1
     2260       ,input true
     2261       ) .
     2262     return no-apply .
     2263   end.
     2264   on alt-enter of frame Dialog-Frame
     2265   do:
     2266     run diasize_maximize in this-procedure
     2267       (input  ?
     2268       ).
     2269     return no-apply .
     2270   end.
     2271   procedure diasize_end-move :
     2272     do
     2273     on error undo, return error return-value
     2274     :
     2275       define variable v-row-delta as decimal   no-undo .
     2276       define variable v-col-delta as decimal   no-undo .
     2277       define variable v-new-row as decimal   no-undo .
     2278       define variable v-new-col as decimal   no-undo .
     2279       assign
     2280         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2281         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2282       .
     2283       assign
     2284         v-row-delta = v-new-row - frame Dialog-Frame :height
     2285         v-col-delta = v-new-col - frame Dialog-Frame :width
     2286       .
     2287       run diasize_change-height in this-procedure
     2288         (input v-row-delta
     2289         ,input true
     2290         ) .
     2291       run diasize_change-width in this-procedure
     2292         (input v-col-delta
     2293         ,input true
     2294         ) .
     2295     end.
     2296   end procedure.
     2297   procedure diasize_maximize :
     2298     define input  parameter p-action as logical   no-undo .
     2299     do
     2300     on error undo, return error return-value
     2301     :
     2302       if p-action = ?
     2303       then do:
     2304         if v-diasize-need-maximize = true
     2305         then do:
     2306           assign
     2307             p-action = true
     2308           .
     2309         end.
     2310         else do:
     2311           assign
     2312             p-action = false
     2313           .
     2314         end.
     2315       end.
     2316       if p-action = true
     2317       then do:
     2318         run diasize_change-height in this-procedure
     2319           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2320               - frame Dialog-Frame :height-chars
     2321           ,input true
     2322           ) .
     2323         run diasize_change-width in this-procedure
     2324           (input session :width-chars
     2325               - frame Dialog-Frame :width-chars
     2326           ,input true
     2327           ) .
     2328         assign
     2329           v-diasize-need-maximize = false
     2330         .
     2331       end.
     2332       else do:
     2333         run diasize_change-width in this-procedure
     2334           (input v-diasize-orig-frame-width
     2335               - frame Dialog-Frame :width-chars
     2336           ,input true
     2337           ) .
     2338         run diasize_change-height in this-procedure
     2339           (input v-diasize-orig-frame-height
     2340               - frame Dialog-Frame :height-chars
     2341           ,input true
     2342           ) .
     2343         assign
     2344           v-diasize-need-maximize = true
     2345         .
     2346       end.
     2347     end.
     2348   end procedure.
     2349   procedure diasize_restore-orig-size :
     2350     do
     2351     on error undo, return error return-value
     2352     :
     2353       assign
     2354         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2355         v-diasize-current-frame-height = frame Dialog-Frame :height
     2356       .
     2357       run diasize_set-height in this-procedure
     2358         (input  v-diasize-orig-frame-height
     2359         ,input  true
     2360         ) .
     2361       run diasize_set-width in this-procedure
     2362         (input  v-diasize-orig-frame-width
     2363         ,input  true
     2364         ) .
     2365     end.
     2366   end procedure.
     2367   procedure diasize_restore-current-size :
     2368     do
     2369     on error undo, return error return-value
     2370     :
     2371       run diasize_set-height in this-procedure
     2372         (input  v-diasize-current-frame-height
     2373         ,input  true
     2374         ) .
     2375       run diasize_set-width in this-procedure
     2376         (input  v-diasize-current-frame-width
     2377         ,input  true
     2378         ) .
     2379     end.
     2380   end procedure.
     2381   procedure diasize_set-browse-handle :
     2382     define input  parameter p-browse-handle as handle   no-undo .
     2383     define buffer buf_temp-browse-handle for temp-browse-handle .
     2384     do
     2385     on error undo, return error return-value
     2386     :
     2387       assign
     2388         v-diasize-browse-handle = p-browse-handle
     2389       .
     2390       for each buf_temp-browse-handle
     2391       on error undo, return error return-value
     2392       :
     2393         delete buf_temp-browse-handle .
     2394       end.
     2395     end.
     2396   end procedure.
     2397   procedure diasize_add_browse :
     2398     define input  parameter p-browse-type   as character no-undo .
     2399     define input  parameter p-browse-handle as handle    no-undo .
     2400     define buffer buf_temp-browse-handle for temp-browse-handle .
     2401     do
     2402     on error undo, return error return-value
     2403     :
     2404       assign
     2405         v-diasize-browse-number = v-diasize-browse-number + 1
     2406       .
     2407       create buf_temp-browse-handle .
     2408       assign
     2409         buf_temp-browse-handle.browse-type   = p-browse-type
     2410         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2411         buf_temp-browse-handle.browse-handle = p-browse-handle
     2412       .
     2413     end.
     2414   end procedure.
     2415   procedure diasize_init :
     2416     define variable v-default-value    as logical   no-undo .
     2417     define variable v-restore-saved    as logical   no-undo .
     2418     define variable v-resize-value-str as character no-undo .
     2419     do
     2420     on error undo, return error return-value
     2421     :
     2422       do with frame Dialog-Frame
     2423       :
     2424         assign
     2425           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2426           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2427           v-diasize-browse-handle     = browse BR-gds-rule-attr :handle
     2428         .
     2429         create button v-diasize-resize-button
     2430         assign
     2431           parent        = frame Dialog-Frame :first-child
     2432           label         = "s"
     2433           height-pixels = 16
     2434           width-pixels  = 16
     2435           visible       = true
     2436           sensitive     = true
     2437           movable       = true
     2438           triggers:
     2439             on end-move persistent run diasize_end-move in this-procedure .
     2440           end triggers.
     2441         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2442         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2443         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2444         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2445         assign
     2446           v-diasize-wndmax = false
     2447         .
     2448         if connected("ub") = true
     2449         then do:
     2450           define variable v-cntxt-db-num        as integer   no-undo .
     2451           define variable v-cntxt-userid        as character no-undo .
     2452           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2453                                             , OUTPUT v-cntxt-userid
     2454                                             ) .
     2455           run gbl/wndpar_r.p
     2456             (input  v-cntxt-db-num
     2457             ,input  v-cntxt-userid
     2458             ,input  'wndmax':U
     2459             ,output v-diasize-wndmax
     2460             ,output v-default-value
     2461             ) .
     2462         end.
     2463         assign
     2464           v-diasize-wndstore = false
     2465         .
     2466         if connected("ub") = true
     2467         then do:
     2468           run gbl/wndpar_r.p
     2469             (input  v-cntxt-db-num
     2470             ,input  v-cntxt-userid
     2471             ,input  'wndstore':U
     2472             ,output v-diasize-wndstore
     2473             ,output v-default-value
     2474             ) .
     2475         end.
     2476         assign
     2477           v-diasize-proc-name = entry(1, program-name(2), '.')
     2478         .
     2479         if v-diasize-wndstore = true
     2480         then do:
     2481           assign
     2482             v-restore-saved = false
     2483           .
     2484           if connected("ub") = true
     2485           then do:
     2486             run gbl/wndsizer.p
     2487               (input  v-cntxt-db-num
     2488               ,input  v-cntxt-userid
     2489               ,input  v-diasize-proc-name
     2490               ,input  'height':u
     2491               ,output v-resize-value-str
     2492               ) .
     2493             if v-resize-value-str <> '':U
     2494             then do:
     2495               run diasize_change-height in this-procedure
     2496                 (input  integer(v-resize-value-str)
     2497                 ,input  true
     2498                 ) .
     2499               assign
     2500                 v-restore-saved = true
     2501               .
     2502             end.
     2503           end.
     2504           if connected("ub") = true
     2505           then do:
     2506             run gbl/wndsizer.p
     2507               (input  v-cntxt-db-num
     2508               ,input  v-cntxt-userid
     2509               ,input  v-diasize-proc-name
     2510               ,input  'width':u
     2511               ,output v-resize-value-str
     2512               ) .
     2513             if v-resize-value-str <> '':U
     2514             then do:
     2515               run diasize_change-width in this-procedure
     2516                 (input  integer(v-resize-value-str)
     2517                 ,input  true
     2518                 ) .
     2519               assign
     2520                 v-restore-saved = true
     2521               .
     2522             end.
     2523           end.
     2524           if v-restore-saved <> true
     2525           then do:
     2526             if v-diasize-wndmax = true
     2527             then do:
     2528               run diasize_maximize in this-procedure
     2529                 (input  true
     2530                 ) .
     2531             end.
     2532           end.
     2533         end.
     2534         else do:
     2535           if v-diasize-wndmax = true
     2536           then do:
     2537             run diasize_maximize in this-procedure
     2538               (input  true
     2539               ) .
     2540           end.
     2541         end.
     2542       end.
     2543     end.
     2544   end procedure.
     2545   procedure diasize_need-full-display :
     2546     define output parameter p-need-full-display as logical   no-undo .
     2547     do
     2548     on error undo, return error return-value
     2549     :
     2550       assign
     2551         p-need-full-display = v-diasize-need-full-display
     2552       .
     2553       assign
     2554         v-diasize-need-full-display = false
     2555       .
     2556     end.
     2557   end procedure.
     2558   procedure get-context :
     2559      define output parameter p-db-num as integer          no-undo.
     2560      define output parameter p-user-id as character        no-undo.
     2561      define variable v-login               as character    no-undo.
     2562      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2563      define buffer buf_user-login  for ub.user-login .
     2564      do
     2565      on error undo, return error
     2566      :
     2567            FIND FIRST buf_sys-ctrl no-lock.
     2568            ASSIGN
     2569               v-login = USERID("ub")
     2570               p-db-num = buf_sys-ctrl.db-num
     2571            .
     2572            FIND FIRST buf_user-login
     2573                 WHERE buf_user-login.db-num = p-db-num
     2574                   AND buf_user-login.user-login = v-login
     2575                 no-lock
     2576                 no-error
     2577                 .
     2578            IF AVAILABLE buf_user-login
     2579            THEN DO:
     2580               assign
     2581                  p-user-id = buf_user-login.user-id
     2582               .
     2583            END.
     2584      end.
     2585   end procedure.
     2586       run diasize_init in this-procedure .
     2587   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2588   ON TAB ANYWHERE
     2589   DO:
     2590   define variable ii as integer no-undo .
     2591   define variable fh as widget-handle no-undo .
     2592   define variable hh as widget-handle no-undo .
     2593   define variable v-next-widget-name as character no-undo .
     2594   if v-tab-order <> '' then do:
     2595     if self:type = "TOGGLE-BOX" then
     2596     self:BGCOLOR = ?.
     2597     assign
     2598     ii = lookup(self:name, v-tab-order).
     2599     assign
     2600     ii = ii + 1
     2601     v-next-widget-name = entry(ii, v-tab-order)
     2602     no-error .
     2603     if error-status:error then do:
     2604       assign
     2605       ii = 1
     2606       v-next-widget-name = entry( ii, v-tab-order)
     2607       .
     2608     end.
     2609     assign
     2610     fh = frame Dialog-Frame:first-child
     2611     hh = fh:first-child
     2612     .
     2613     do while valid-handle(hh):
     2614       if hh:name = v-next-widget-name then do:
     2615         if hh:sensitive  = yes
     2616         AND hh:visible = yes then do:
     2617           if hh:type = "TOGGLE-BOX":U then do:
     2618             assign
     2619             hh:BGcolor = 1
     2620             .
     2621           end.
     2622           APPLY "ENTRY" to hh.
     2623           return no-apply.
     2624         end.
     2625         else do:
     2626           APPLY "TAB" to hh.
     2627           return no-apply.
     2628         end.
     2629       end.
     2630       hh = hh:next-sibling.
     2631     end.
     2632   end.
     2633   END.
     2634   ON BACK-TAB ANYWHERE
     2635   DO:
     2636   define variable ii as integer no-undo .
     2637   define variable fh as widget-handle no-undo .
     2638   define variable hh as widget-handle no-undo .
     2639   define variable v-next-widget-name as character no-undo .
     2640   if v-tab-order <> '' then do:
     2641     assign
     2642     ii = lookup(self:name, v-tab-order).
     2643     .
     2644     assign
     2645     ii = (if ii = 1
     2646           then  num-entries(v-tab-order)
     2647           else ii - 1
     2648           )
     2649     v-next-widget-name = entry(ii, v-tab-order)
     2650     .
     2651     assign
     2652     fh = frame Dialog-Frame:first-child
     2653     hh = fh:first-child
     2654     .
     2655     do while valid-handle(hh):
     2656       if hh:name = v-next-widget-name then do:
     2657         if hh:sensitive  = yes
     2658         AND hh:visible = yes then do:
     2659           if hh:type = "TOGGLE-BOX":U then do:
     2660             assign
     2661             hh:BGcolor = 1
     2662             .
     2663           end.
     2664           APPLY "ENTRY" to hh.
     2665           return no-apply.
     2666         end.
     2667         else do:
     2668         APPLY "BACK-TAB" to hh.
     2669         return no-apply.
     2670         end.
     2671       end.
     2672       hh = hh:next-sibling.
     2673     end.
     2674     end.
     2675   END.
     2676   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2677   ON RETURN ANYWHERE
     2678   DO:
     2679   define variable ii as integer no-undo .
     2680   define variable fh as widget-handle no-undo .
     2681   define variable hh as widget-handle no-undo .
     2682   define variable v-next-widget-name as character no-undo .
     2683     if v-tab-order <> '' then do:
     2684       assign
     2685       ii = lookup(self:name, v-tab-order).
     2686       if ii = num-entries(v-tab-order) then do:
     2687           APPLY 'CHOOSE' TO b-exit in frame Dialog-Frame.
     2688           return no-apply.
     2689       end.
     2690       if self:type <> "BUTTON" and
     2691         self:type <> "EDITOR"  then do:
     2692         run proc-move-forward in this-procedure .
     2693         return no-apply.
     2694       end.
     2695       if self:type = "BUTTON" then do:
     2696         APPLY "CHOOSE" to self.
     2697       end.
     2698       if self:type = "TOGGLE-BOX" then
     2699       self:BGCOLOR = ?.
     2700       assign
     2701       ii = ii + 1
     2702       v-next-widget-name = entry(ii, v-tab-order)
     2703       no-error .
     2704       if error-status:error then do:
     2705         assign
     2706         ii = 1
     2707         v-next-widget-name = entry( ii, v-tab-order)
     2708         .
     2709       end.
     2710       assign
     2711       fh = frame Dialog-Frame:first-child
     2712       hh = fh:first-child
     2713       .
     2714       do while valid-handle(hh):
     2715         if hh:name = v-next-widget-name then do:
     2716           if hh:sensitive  = yes
     2717           AND hh:visible = yes then do:
     2718             if hh:type = "TOGGLE-BOX":U then do:
     2719               assign
     2720               hh:BGcolor = 1
     2721               .
     2722             end.
     2723             APPLY "ENTRY" to hh.
     2724             return no-apply.
     2725           end.
     2726           else do:
     2727             APPLY "TAB" to hh.
     2728             return no-apply.
     2729           end.
     2730         end.
     2731         hh = hh:next-sibling.
     2732       end.
     2733     end.
     2734   END.
     2735   procedure proc-move-forward :
     2736   define variable ii as integer no-undo .
     2737   define variable fh as widget-handle no-undo .
     2738   define variable hh as widget-handle no-undo .
     2739   define variable v-next-widget-name as character no-undo .
     2740   do
     2741   on error undo, return error
     2742   :
     2743     if v-tab-order <> '' then do:
     2744       if self:type = "TOGGLE-BOX" then
     2745       self:BGCOLOR = ?.
     2746       assign
     2747       ii = lookup(self:name, v-tab-order).
     2748       assign
     2749       ii = ii + 1
     2750       v-next-widget-name = entry(ii, v-tab-order)
     2751       no-error .
     2752       if error-status:error then do:
     2753         assign
     2754         ii = 1
     2755         v-next-widget-name = entry( ii, v-tab-order)
     2756         .
     2757       end.
     2758       assign
     2759       fh = frame Dialog-Frame:first-child
     2760       hh = fh:first-child
     2761       .
     2762       do while valid-handle(hh):
     2763         if hh:name = v-next-widget-name then do:
     2764           if hh:sensitive  = yes
     2765           AND hh:visible = yes then do:
     2766             if hh:type = "TOGGLE-BOX":U then do:
     2767               assign
     2768               hh:BGcolor = 1
     2769               .
     2770             end.
     2771             APPLY "ENTRY" to hh.
     2772             return.
     2773           end.
     2774           else do:
     2775             assign
     2776             ii = ii + 1
     2777             v-next-widget-name = entry(ii, v-tab-order)
     2778             no-error .
     2779             if error-status:error then do:
     2780               assign
     2781               ii = 1
     2782               v-next-widget-name = entry( ii, v-tab-order)
     2783               .
     2784             end.
     2785           end.
     2786         end.
     2787         hh = hh:next-sibling.
     2788       end.
     2789     end.
     2790   end.
     2791   end procedure.
     2792   def var vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2793   procedure disrules-override-labels :
     2794   define input parameter p-templ-rl-root like ub.dis-rule.templ-rl-root no-undo .
     2795   define variable ii as integer no-undo .
     2796   define variable fh as widget-handle no-undo .
     2797   define variable hh as widget-handle no-undo .
     2798   define buffer buf_temp-drt-prop for temp-drt-prop.
     2799   define buffer buf_drt-prop for ub.drt-prop.
     2800   define buffer bufformat_temp-drt-prop for ub.drt-prop.
     2801   do
     2802   on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     2803   on stop   undo, return error substitute( "&1. stop", vss-workfile )
     2804   on endkey undo, return error substitute( "&1. endkey", vss-workfile )
     2805   :
     2806     if not can-find(first temp-drt-prop) then do:
     2807       run disrules-fill-properties in this-procedure ( input p-templ-rl-root).
     2808     end.
     2809     if can-find(first buf_temp-drt-prop no-lock where
     2810                       buf_temp-drt-prop.templ-rl-root = p-templ-rl-root
     2811                   and buf_temp-drt-prop.prop-code = "Label"
     2812                   ) then do:
     2813       for each buf_temp-drt-prop no-lock where
     2814                       buf_temp-drt-prop.templ-rl-root = p-templ-rl-root
     2815                   and buf_temp-drt-prop.prop-code = "Label":U:
     2816         assign
     2817         fh = frame Dialog-Frame:first-child
     2818         hh = fh:first-child
     2819         .
     2820         do while valid-handle(hh):
     2821           if index(hh:name, buf_temp-drt-prop.upper-prop-code) > 0
     2822           and (index(hh:name, buf_temp-drt-prop.upper-prop-code) + length(buf_temp-drt-prop.upper-prop-code) - 1 =
     2823                length(hh:name))
     2824           then do:
     2825             assign
     2826             hh:label = buf_temp-drt-prop.property-value
     2827             .
     2828           end.
     2829           hh = hh:next-sibling.
     2830         end.
     2831       end.
     2832       for each buf_temp-drt-prop no-lock where
     2833                       buf_temp-drt-prop.templ-rl-root = p-templ-rl-root
     2834                   and buf_temp-drt-prop.prop-code = "Column-Label":U:
     2835         assign
     2836         fh = browse BR-term-dr:first-column
     2837         .
     2838         do while valid-handle(fh):
     2839           if index(fh:name, buf_temp-drt-prop.upper-prop-code) > 0 then do:
     2840             assign
     2841             fh:label = buf_temp-drt-prop.property-value
     2842             .
     2843           end.
     2844           fh = fh:next-column.
     2845         end.
     2846       end.
     2847     end.
     2848   end.
     2849   end procedure.
     2850   ~
     2851   MAIN-BLOCK:
     2852   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2853      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2854     IF p-mode <> 'ДОБАВЛЕНИЕ':U
     2855     and p-mode <> 'ПРОСМОТР':U
     2856     and p-mode <> 'ИЗМЕНЕНИЕ':U
     2857     and p-mode <> 'КОПИРОВАНИЕ':U
     2858     THEN DO:
     2859         MESSAGE
     2860         vss-workfile vss-revision vss-description skip
     2861         "Неверное значение параметра p-mode" p-mode
     2862         VIEW-AS ALERT-BOX ERROR.
     2863         UNDO, RETURN ERROR.
     2864     END.
     2865     IF p-mode <> 'ДОБАВЛЕНИЕ':U THEN DO:
     2866     END.
     2867     if p-mode = 'КОПИРОВАНИЕ':U then do:
     2868       v-is-copy = yes.
     2869       p-mode = 'ДОБАВЛЕНИЕ':U.
     2870     end.
     2871     for each tt-dis-rule:
     2872       delete tt-dis-rule.
     2873     end.
     2874     for each tt0-term_dis-rule:
     2875       delete tt0-term_dis-rule.
     2876     end.
     2877     run dr-code  in this-procedure (
     2878        input  p-templ-rl-root
     2879       ,output v-des
     2880       ,output v-discnt-type
     2881       ,output v-subject-type
     2882       ,output v-value-type
     2883       ,output v-level-1
     2884       ,output v-level-2
     2885       ,output v-global
     2886       ,output v-host
     2887       ,output v-object
     2888       ,output v-output-display
     2889       ,output v-tree
     2890       ,output v-other
     2891                                  ) no-error .
     2892     IF ERROR-STATUS:ERROR THEN DO:
     2893       MESSAGE
     2894       vss-workfile vss-revision vss-description skip
     2895       "Неверное значение параметра p-templ-rl-root" p-templ-rl-root SKIP
     2896        error-status:get-message(1) SKIP
     2897        RETURN-VALUE
     2898       VIEW-AS ALERT-BOX ERROR.
     2899       UNDO, RETURN ERROR.
     2900     END.
     2901     v-term-value-type = v-value-type.
     2902     run disrules-fill-properties in this-procedure ( input p-templ-rl-root).
     2903     if can-find(first temp-drt-prop where
     2904                      temp-drt-prop.templ-rl-root = p-templ-rl-root
     2905                  and temp-drt-prop.prop-code = "CalcGoodsPrice":U
     2906                  and temp-drt-prop.upper-prop-code = "":U
     2907                  and temp-drt-prop.property-value  = "no") then do:
     2908       assign
     2909       p-b-code = 0
     2910       .
     2911     end.
     2912     IF p-b-code <> 0  THEN DO:
     2913       IF v-subject-type <> INTEGER('1':U) THEN DO:
     2914           MESSAGE
     2915               vss-workfile vss-revision vss-description skip
     2916               "Неверное значение параметра p-b-code" p-b-code SKIP
     2917                error-status:get-message(1) SKIP
     2918                RETURN-VALUE
     2919               VIEW-AS ALERT-BOX ERROR.
     2920               UNDO, RETURN ERROR.
     2921       END.
     2922       FIND FIRST X_bar-code NO-LOCK WHERE
     2923                   X_bar-code.b-code = p-b-code NO-ERROR.
     2924       IF NOT AVAILABLE X_bar-code THEN DO:
     2925         MESSAGE
     2926           vss-workfile vss-revision vss-description skip
     2927           "Неверное значение параметра p-b-code" p-b-code SKIP
     2928            error-status:get-message(1) SKIP
     2929            RETURN-VALUE
     2930           VIEW-AS ALERT-BOX ERROR.
     2931           UNDO, RETURN ERROR.
     2932        END.
     2933        FIND FIRST X_goods NO-LOCK WHERE X_goods.gds-code = X_bar-code.gds-code NO-ERROR.
     2934        IF NOT AVAILABLE X_goods THEN DO:
     2935       MESSAGE
     2936           vss-workfile vss-revision vss-description skip
     2937           "Неверное значение параметра p-b-code" p-b-code SKIP
     2938            error-status:get-message(1) SKIP
     2939            RETURN-VALUE
     2940           VIEW-AS ALERT-BOX ERROR.
     2941           UNDO, RETURN ERROR.
     2942        END.
     2943       ASSIGN
     2944       is-good-mode = YES.
     2945       find first buf_units no-lock where
     2946                  buf_units.unit-name = X_goods.unit-base no-error.
     2947       if available buf_units then do:
     2948         assign
     2949         v-meas = if( LOOKUP('шту':U, buf_units.type) > 0 or LOOKUP('сер':U, buf_units.type) > 0 )
     2950                  then 0
     2951                  else v-meas.
     2952       end.
     2953   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2954   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     2955     (input  p-obj-type
     2956     ,input  p-obj-code
     2957     ,input  p-b-code
     2958     ,input  0
     2959     ,input  0
     2960     ,output v-doc-num
     2961     ,output v-price-sale
     2962     ,output v-road-tax
     2963     ,output v-excise
     2964     ) no-error .
     2965     END.
     2966     run fill-main-table in this-procedure.
     2967     if p-upper-rule-num > 99999 then do:
     2968       assign
     2969       v-tree = "":U.
     2970     end.
     2971     RUN fill-tables IN THIS-PROCEDURE NO-ERROR.
     2972     IF ERROR-STATUS:ERROR THEN UNDO, RETURN ERROR.
     2973     RUN Myenable in this-procedure .
     2974     WAIT-FOR GO OF FRAME Dialog-Frame.
     2975   END.
     2976   RUN disable_UI.
     2977   PROCEDURE check-time-rule :
     2978   define buffer buf_dis-time-rule for ub.dis-time-rule.
     2979   find first buf_dis-time-rule no-lock where
     2980                 buf_dis-time-rule.time-rule-num = input frame Dialog-Frame tt-dis-rule.time-rule-num
     2981            no-error.
     2982   if not available buf_dis-time-rule then do:
     2983     if input frame Dialog-Frame tt-dis-rule.time-rule-num <> ?  then
     2984       message "Неправильный номер расписания" .
     2985     apply "entry" to tt-dis-rule.time-rule-num in frame Dialog-Frame.
     2986     return error.
     2987   end.
     2988   find first X_dis-time-rule no-lock where recid(X_dis-time-rule) = recid(buf_dis-time-rule).
     2989   assign
     2990   tt-dis-rule.time-rule-num = buf_dis-time-rule.time-rule-num
     2991   tt-dis-rule.time-templ-rl-root = buf_dis-time-rule.templ-rl-root
     2992   .
     2993   display
     2994   tt-dis-rule.time-rule-num
     2995   with frame Dialog-Frame.
     2996   END PROCEDURE.
     2997   PROCEDURE disable_UI :
     2998     HIDE FRAME Dialog-Frame.
     2999   END PROCEDURE.
     3000   PROCEDURE display-hide-fields :
     3001   DEFINE INPUT PARAMETER p-tree AS CHARACTER NO-UNDO.
     3002   DEFINE INPUT PARAMETER p-main AS LOGICAL NO-UNDO.
     3003   DEFINE INPUT PARAMETER p-display-hide AS integer NO-UNDO.
     3004   hide br-gds-rule-attr in frame Dialog-Frame.
     3005   CASE p-display-hide:
     3006     WHEN 1 THEN DO:
     3007       IF p-main THEN DO:
     3008         IF lookup("dis-kat", v-level-1) > 0 THEN DO:
     3009            DISPLAY
     3010            tt-dis-rule.dis-kat
     3011            WITH FRAME Dialog-Frame.
     3012            ENABLE
     3013            tt-dis-rule.dis-kat WHEN p-mode <> 'ПРОСМОТР':U
     3014            WITH FRAME Dialog-Frame.
     3015         END.
     3016         else do:
     3017           hide
     3018           tt-dis-rule.dis-kat
     3019           in FRAME Dialog-Frame.
     3020         end.
     3021         IF lookup("doc-qnty":U, v-level-1) > 0 THEN DO:
     3022           DISPLAY
     3023           tt-dis-rule.doc-qnty
     3024           WITH FRAME Dialog-Frame.
     3025           ENABLE
     3026           tt-dis-rule.doc-qnty WHEN p-mode <> 'ПРОСМОТР':U
     3027           WITH FRAME Dialog-Frame.
     3028           IF is-good-mode  THEN DO:
     3029             if available locked_dis-rule
     3030             and locked_dis-rule.templ-rl-root <> 91 then
     3031             do:
     3032              DISPLAY
     3033               f-sum-brutto
     3034               f-sum-discnt
     3035               f-sum-netto
     3036               WITH FRAME Dialog-Frame.
     3037              ENABLE
     3038               f-sum-brutto WHEN p-mode <> 'ПРОСМОТР':U
     3039               f-sum-discnt WHEN p-mode <> 'ПРОСМОТР':U
     3040               f-sum-netto WHEN p-mode <> 'ПРОСМОТР':U
     3041               WITH FRAME Dialog-Frame.
     3042             end.
     3043           END.
     3044         END.
     3045         else do:
     3046           hide
     3047           tt-dis-rule.doc-qnty
     3048           in FRAME Dialog-Frame.
     3049           IF is-good-mode THEN DO:
     3050             HIDE
     3051             f-sum-brutto
     3052             f-sum-discnt
     3053             f-sum-netto
     3054             IN FRAME Dialog-Frame.
     3055           END.
     3056         end.
     3057         IF lookup("tot-sum":U, v-level-1) > 0 THEN DO:
     3058           DISPLAY
     3059           tt-dis-rule.tot-sum
     3060           WITH FRAME Dialog-Frame.
     3061           ENABLE
     3062           tt-dis-rule.tot-sum WHEN p-mode <> 'ПРОСМОТР':U
     3063           WITH FRAME Dialog-Frame.
     3064           IF is-good-mode THEN DO:
     3065             DISPLAY
     3066             f-sum-brutto
     3067             f-sum-discnt
     3068             f-sum-netto
     3069             f-sale-qnty
     3070             WITH FRAME Dialog-Frame.
     3071             ENABLE
     3072             f-sum-brutto WHEN p-mode <> 'ПРОСМОТР':U
     3073             f-sum-discnt WHEN p-mode <> 'ПРОСМОТР':U
     3074             f-sum-netto WHEN p-mode <> 'ПРОСМОТР':U
     3075             f-sale-qnty WHEN p-mode <> 'ПРОСМОТР':U
     3076             WITH FRAME Dialog-Frame.
     3077           END.
     3078         END.
     3079         else do:
     3080           hide
     3081           tt-dis-rule.tot-sum
     3082           in FRAME Dialog-Frame.
     3083           IF is-good-mode THEN DO:
     3084             IF lookup("doc-qnty", v-level-1) = 0  THEN
     3085             HIDE
     3086             f-sum-brutto
     3087             f-sum-discnt
     3088             f-sum-netto
     3089             IN FRAME Dialog-Frame.
     3090             HIDE
     3091             f-sale-qnty
     3092             IN FRAME Dialog-Frame.
     3093           END.
     3094         end.
     3095         IF lookup("time-rule-num":U, v-level-1) > 0 THEN DO:
     3096           ASSIGN
     3097           b-time-rule-lookup:ROW = 1
     3098           b-time-rule-lookup:column = b-hist:COLUMN - 10
     3099           .
     3100           DISPLAY
     3101           tt-dis-rule.time-rule-num
     3102           b-dis-time-rule
     3103           b-time-rule-lookup
     3104           WITH FRAME Dialog-Frame.
     3105           ENABLE
     3106           tt-dis-rule.time-rule-num WHEN p-mode <> 'ПРОСМОТР':U
     3107           b-dis-time-rule WHEN p-mode <> 'ПРОСМОТР':U
     3108           b-time-rule-LOOKUP
     3109           WITH FRAME Dialog-Frame.
     3110         END.
     3111         else do:
     3112           hide
     3113           tt-dis-rule.time-rule-num
     3114           b-dis-time-rule
     3115           b-time-rule-lookup
     3116           in FRAME Dialog-Frame.
     3117         END.
     3118         IF lookup("key#_one":U, v-level-1) > 0 THEN DO:
     3119            DISPLAY
     3120            tt-dis-rule.key#_one
     3121            WITH FRAME Dialog-Frame.
     3122            ENABLE
     3123            tt-dis-rule.key#_one WHEN p-mode <> 'ПРОСМОТР':U
     3124            WITH FRAME Dialog-Frame.
     3125         END.
     3126         else do:
     3127           hide
     3128           tt-dis-rule.key#_one
     3129           in FRAME Dialog-Frame.
     3130         end.
     3131         IF lookup("key#_two":U, v-level-1) > 0 THEN DO:
     3132            DISPLAY
     3133            tt-dis-rule.key#_two
     3134            WITH FRAME Dialog-Frame.
     3135            ENABLE
     3136            tt-dis-rule.key#_two WHEN p-mode <> 'ПРОСМОТР':U
     3137            WITH FRAME Dialog-Frame.
     3138         END.
     3139         else do:
     3140           hide
     3141           tt-dis-rule.key#_two
     3142           in FRAME Dialog-Frame.
     3143         end.
     3144         IF lookup("key#_three":U, v-level-1) > 0 THEN DO:
     3145            DISPLAY
     3146            tt-dis-rule.key#_three
     3147            WITH FRAME Dialog-Frame.
     3148            ENABLE
     3149            tt-dis-rule.key#_three WHEN p-mode <> 'ПРОСМОТР':U
     3150            WITH FRAME Dialog-Frame.
     3151         END.
     3152         else do:
     3153           hide
     3154           tt-dis-rule.key#_three
     3155           in FRAME Dialog-Frame.
     3156         end.
     3157         IF lookup("charkey_one":U, v-level-1) > 0 THEN DO:
     3158            DISPLAY
     3159            tt-dis-rule.charkey_one
     3160            WITH FRAME Dialog-Frame.
     3161            ENABLE
     3162            tt-dis-rule.charkey_one WHEN p-mode <> 'ПРОСМОТР':U
     3163            WITH FRAME Dialog-Frame.
     3164         END.
     3165         else do:
