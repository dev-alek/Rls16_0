     3487           view tt-dis-rule.discnt-value
     3488           in FRAME Dialog-Frame.
     3489           ENABLE
     3490           tt-dis-rule.discnt-value WHEN p-mode <> 'ПРОСМОТР':U
     3491           WITH FRAME Dialog-Frame.
     3492           IF is-good-mode
     3493           and (v-term-value-type = integer('1':U)
     3494                or
     3495                v-term-value-type = integer('2':U)
     3496                or
     3497                v-term-value-type = integer('3':U))
     3498           THEN DO:
     3499             DISPLAY
     3500             f-price-brutto
     3501             f-price-discnt
     3502             f-price-netto
     3503             WITH FRAME Dialog-Frame.
     3504             ENABLE
     3505             f-price-discnt WHEN p-mode <> 'ПРОСМОТР':U
     3506             f-price-netto  WHEN p-mode <> 'ПРОСМОТР':U
     3507             WITH FRAME Dialog-Frame.
