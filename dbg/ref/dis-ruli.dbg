     4415   PROCEDURE proc-b-del :
     4416   DEFINE BUFFER buf_tt0-term_dis-rule FOR tt0-term_dis-rule.
     4417   DEFINE BUFFER buf_tt-bc-dis-rule    FOR tt-bc-dis-rule.
     4418   IF v-tree = "":U THEN RETURN ERROR.
     4419   IF NOT AVAILABLE tt0-term_dis-rule THEN RETURN.
     4420   FIND first buf_tt0-term_dis-rule WHERE RECID(buf_tt0-term_dis-rule) = RECID(tt0-term_dis-rule).
     4421   FIND first buf_tt-bc-dis-rule WHERE RECID(buf_tt-bc-dis-rule) = RECID(tt-bc-dis-rule).
     4422   DELETE buf_tt0-term_dis-rule.
     4423   DELETE buf_tt-bc-dis-rule.
     4424   RUN rename-term_dis-rule in this-procedure .
     4425   RUN openbr-term-dr in this-procedure .
     4426   END PROCEDURE.
     4427   PROCEDURE proc-b-dis-time-rule :
     4428   define variable v-time-rule-num like ub.dis-rule.time-rule-num no-undo .
     4429   DEFINE VARIABLE v-sts AS INTEGER NO-UNDO INIT -1.
     4430   DEFINE VARIABLE v-rid-list AS character NO-UNDO  .
     4431   DEFINE BUFFER buf_dis-time-rule FOR ub.dis-time-rule .
     4432   define variable vss-include-info28 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4433   if lookup(self :type
     4434            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     4435            ) = 0
     4436   then do:
     4437     message
     4438       "$Workfile$"
     4439       "Указанному интерфейсному элементу фокус не может быть передан" skip
     4440       "Интерфейсный элемент" self :name  skip
     4441       "Тип" self :type  skip
     4442       "Процедура" this-procedure :file-name skip
     4443       view-as alert-box .
     4444   end.
     4445   else do:
     4446     apply "entry":u to self  .
     4447     if focus :handle <> self :handle  then do:
     4448       return no-apply .
     4449     end.
     4450   end.
     4451   if input frame Dialog-Frame tt-dis-rule.time-rule-num <> 0
     4452   and input frame Dialog-Frame tt-dis-rule.time-rule-num <> ? then do:
     4453     find first buf_dis-time-rule no-lock where
     4454               buf_dis-time-rule.time-rule-num = input frame Dialog-Frame tt-dis-rule.time-rule-num no-error .
     4455     if available buf_dis-time-rule then do:
     4456       assign
     4457       v-rid-list = string(recid(buf_dis-time-rule)).
     4458     end.
     4459   end.
     4460   run ref/dist-rls.w (
     4461                   input parparentproc
     4462                 ,input "b-sel,b-add"
     4463                 ,input ( if p-mode = 'ДОБАВЛЕНИЕ':U then 'dis-rule':U else ("rule-num" + chr(44) + 'ИЗМЕНЕНИЕ':U))
     4464                 ,input (if p-mode = 'ДОБАВЛЕНИЕ':U then tt-dis-rule.templ-rl-root else tt-dis-rule.rule-num)
     4465                 ,input ( if p-mode = 'ДОБАВЛЕНИЕ':U then 0 else tt-dis-rule.time-templ-rl-root)
     4466                 ,input ( if p-mode = 'ДОБАВЛЕНИЕ':U then v-pos-type else '')
     4467                 ,input-output v-sts
     4468                 ,input-output v-rid-list) no-error .
     4469   IF v-rid-list = "":U THEN RETURN ERROR.
     4470   FIND FIRST buf_dis-time-rule NO-LOCK WHERE
     4471             RECID(buf_dis-time-rule) = INTEGER(ENTRY(1, v-rid-list)) NO-ERROR.
     4472   if error-status:error
     4473     then  do:
     4474     return error.
     4475   end.
     4476   ASSIGN
     4477   v-time-rule-num = buf_dis-time-rule.time-rule-num.
     4478   find first X_dis-time-rule no-lock where
     4479             X_dis-time-rule.time-rule-num = v-time-rule-num NO-ERROR.
     4480         .
     4481   assign
     4482   tt-dis-rule.time-rule-num =  X_dis-time-rule.time-rule-num
     4483   tt-dis-rule.time-templ-rl-root = X_dis-time-rule.templ-rl-root
     4484   .
     4485   display
     4486   tt-dis-rule.time-rule-num
     4487   with frame Dialog-Frame.
     4488   END PROCEDURE.
     4489   PROCEDURE proc-b-exit-1 :
     4490   DEFINE VARIABLE v-doc-qnty LIKE ub.dis-rule.doc-qnty NO-UNDO.
     4491   DEFINE VARIABLE v-dis-kat LIKE ub.dis-rule.dis-kat NO-UNDO.
     4492   DEFINE VARIABLE v-tot-sum LIKE ub.dis-rule.tot-sum NO-UNDO.
     4493   DEFINE VARIABLE v-time-rule-num LIKE ub.dis-rule.time-rule-num NO-UNDO.
     4494   define variable v-charkey_one like ub.dis-rule.charkey_one no-undo .
     4495   define variable v-charkey_two like ub.dis-rule.charkey_two no-undo .
     4496   define variable v-charkey_three like ub.dis-rule.charkey_three no-undo .
     4497   define variable v-deckey_one like ub.dis-rule.deckey_one no-undo .
     4498   define variable v-deckey_two like ub.dis-rule.deckey_two no-undo .
     4499   define variable v-deckey_three like ub.dis-rule.deckey_three no-undo .
     4500   define variable v-key#_one like ub.dis-rule.key#_one no-undo .
     4501   define variable v-key#_two like ub.dis-rule.key#_two no-undo .
     4502   define variable v-key#_three like ub.dis-rule.key#_three no-undo .
     4503   DEFINE VARIABLE v-discnt-value LIKE ub.dis-rule.discnt-value NO-UNDO.
     4504   DEFINE VARIABLE ii AS INTEGER NO-UNDO.
     4505   DEFINE VARIABLE v-rule-num LIKE ub.dis-rule.rule-num NO-UNDO.
     4506   DEFINE VARIABLE v-dub AS LOGICAL NO-UNDO.
     4507   DEFINE BUFFER buf_tt0-term_dis-rule FOR tt0-term_dis-rule.
     4508   IF v-tree = "":U  THEN RETURN ERROR.
     4509   ASSIGN
     4510   v-doc-qnty = tt-dis-rule.doc-qnty
     4511   v-dis-kat = tt-dis-rule.dis-kat
     4512   v-tot-sum = tt-dis-rule.tot-sum
     4513   v-time-rule-num = tt-dis-rule.time-rule-num
     4514   v-charkey_one = tt-dis-rule.charkey_one
     4515   v-charkey_two = tt-dis-rule.charkey_two
     4516   v-charkey_three = tt-dis-rule.charkey_three
     4517   v-deckey_one = tt-dis-rule.deckey_one
     4518   v-deckey_two = tt-dis-rule.deckey_two
     4519   v-deckey_three = tt-dis-rule.deckey_three
     4520   v-key#_one = tt-dis-rule.key#_one
     4521   v-key#_two = tt-dis-rule.key#_two
     4522   v-key#_three = tt-dis-rule.key#_three
     4523   .
     4524   IF tt-dis-rule.doc-qnty:SENSITIVE IN FRAME Dialog-Frame THEN DO:
     4525     ASSIGN
     4526     v-doc-qnty = INPUT FRAME Dialog-Frame tt-dis-rule.doc-qnty
     4527     .
     4528   END.
     4529   IF tt-dis-rule.dis-kat:SENSITIVE IN FRAME Dialog-Frame THEN DO:
     4530     ASSIGN
     4531     v-dis-kat = INPUT FRAME Dialog-Frame tt-dis-rule.dis-kat
     4532     .
     4533   END.
     4534   IF tt-dis-rule.tot-sum:SENSITIVE IN FRAME Dialog-Frame THEN DO:
     4535     ASSIGN
     4536     v-tot-sum = INPUT FRAME Dialog-Frame tt-dis-rule.tot-sum
     4537     .
     4538   END.
     4539   IF tt-dis-rule.time-rule-num:SENSITIVE IN FRAME Dialog-Frame THEN DO:
     4540     ASSIGN
     4541     v-time-rule-num = INPUT FRAME Dialog-Frame tt-dis-rule.time-rule-num
     4542     .
     4543   END.
     4544   IF tt-dis-rule.discnt-value:SENSITIVE IN FRAME Dialog-Frame THEN DO:
     4545     ASSIGN
     4546     v-discnt-value = INPUT FRAME Dialog-Frame tt-dis-rule.discnt-value
     4547     .
     4548   END.
     4549   IF tt-dis-rule.charkey_one:SENSITIVE IN FRAME Dialog-Frame THEN DO:
     4550     ASSIGN
     4551     v-charkey_one = INPUT FRAME Dialog-Frame tt-dis-rule.charkey_one
     4552     .
     4553   END.
     4554   IF tt-dis-rule.charkey_two:SENSITIVE IN FRAME Dialog-Frame THEN DO:
     4555     ASSIGN
     4556     v-charkey_two = INPUT FRAME Dialog-Frame tt-dis-rule.charkey_two
     4557     .
     4558   END.
     4559   IF tt-dis-rule.charkey_three:SENSITIVE IN FRAME Dialog-Frame THEN DO:
     4560     ASSIGN
     4561     v-charkey_three = INPUT FRAME Dialog-Frame tt-dis-rule.charkey_three
     4562     .
     4563   END.
     4564   IF tt-dis-rule.deckey_one:SENSITIVE IN FRAME Dialog-Frame THEN DO:
     4565     ASSIGN
     4566     v-deckey_one = INPUT FRAME Dialog-Frame tt-dis-rule.deckey_one
     4567     .
     4568   END.
     4569   IF tt-dis-rule.deckey_two:SENSITIVE IN FRAME Dialog-Frame THEN DO:
     4570     ASSIGN
     4571     v-deckey_two = INPUT FRAME Dialog-Frame tt-dis-rule.deckey_two
     4572     .
     4573   END.
     4574   IF tt-dis-rule.deckey_three:SENSITIVE IN FRAME Dialog-Frame THEN DO:
     4575     ASSIGN
     4576     v-deckey_three = INPUT FRAME Dialog-Frame tt-dis-rule.deckey_three
     4577     .
     4578   END.
     4579   IF tt-dis-rule.key#_one:SENSITIVE IN FRAME Dialog-Frame THEN DO:
     4580     ASSIGN
     4581     v-key#_one = INPUT FRAME Dialog-Frame tt-dis-rule.key#_one
     4582     .
     4583   END.
     4584   IF tt-dis-rule.key#_two:SENSITIVE IN FRAME Dialog-Frame THEN DO:
     4585     ASSIGN
     4586     v-key#_two = INPUT FRAME Dialog-Frame tt-dis-rule.key#_two
     4587     .
     4588   END.
     4589   IF tt-dis-rule.key#_three:SENSITIVE IN FRAME Dialog-Frame THEN DO:
     4590     ASSIGN
     4591     v-key#_three = INPUT FRAME Dialog-Frame tt-dis-rule.key#_three
     4592     .
     4593   END.
     4594   define variable v-entry-entry as character no-undo .
     4595   define variable v-entry as character no-undo .
     4596   define variable v-entry-list as character no-undo .
     4597   define variable v-new-entry as character no-undo .
     4598   define variable nn as integer no-undo .
     4599   do nn = 1 to num-entries(v-tree):
     4600     v-entry-entry = '':U.
     4601     case entry(nn, v-tree):
     4602       when "dis-kat" then do:
     4603         if v-dis-kat <> -1
     4604         then do:
     4605           v-entry-entry = string(v-dis-kat).
     4606         end.
     4607       end.
     4608       when "doc-qnty" then do:
     4609         if v-doc-qnty <> -1
     4610         then do:
     4611           v-entry-entry = string(v-doc-qnty).
     4612         end.
     4613       end.
     4614       when "tot-sum" then do:
     4615         if v-tot-sum <> -1
     4616         then do:
     4617           v-entry-entry = string(v-tot-sum).
     4618         end.
     4619       end.
     4620       when "time-rule-num" then do:
     4621         if v-time-rule-num <> -1
     4622         then do:
     4623           v-entry-entry = string(v-time-rule-num).
     4624         end.
     4625       end.
     4626       when "key#_one" then do:
     4627         if v-key#_one <> ?
     4628         then do:
     4629           v-entry-entry = string(v-key#_one).
     4630         end.
     4631       end.
     4632       when "key#_two" then do:
     4633         if v-key#_two <> ?
     4634         then do:
     4635           v-entry-entry = string(v-key#_two).
     4636         end.
     4637       end.
     4638       when "key#_three" then do:
     4639         if v-key#_three <> ?
     4640         then do:
     4641           v-entry-entry = string(v-key#_three).
     4642         end.
     4643       end.
     4644       when "charkey_one" then do:
     4645         if v-charkey_one <> ?
     4646         then do:
     4647           v-entry-entry = string(v-charkey_one).
     4648         end.
     4649       end.
     4650       when "charkey_two" then do:
     4651         if v-charkey_two <> ?
     4652         then do:
     4653           v-entry-entry = string(v-charkey_two).
     4654         end.
     4655       end.
     4656       when "charkey_three" then do:
     4657         if v-charkey_three <> ?
     4658         then do:
     4659           v-entry-entry = string(v-charkey_three).
     4660         end.
     4661       end.
     4662       when "deckey_one" then do:
     4663         if v-deckey_one <> ?
     4664         then do:
     4665           v-entry-entry = string(v-deckey_one).
     4666         end.
     4667       end.
     4668       when "deckey_two" then do:
     4669         if v-deckey_two <> ?
     4670         then do:
     4671           v-entry-entry = string(v-deckey_two).
     4672         end.
     4673       end.
     4674       when "deckey_three" then do:
     4675         if v-deckey_three <> ?
     4676         then do:
     4677           v-entry-entry = string(v-deckey_three).
     4678         end.
     4679       end.
     4680     end case.
     4681     v-new-entry = v-new-entry +
     4682               (if v-new-entry = '':U then "" else chr(4)) + v-entry-entry.
     4683   end.
     4684   _dub:
     4685   FOR EACH buf_tt0-term_dis-rule WHERE
     4686           buf_tt0-term_dis-rule.upper-rule-num = tt-dis-rule.rule-num:
     4687     ASSIGN
     4688     v-rule-num = max(buf_tt0-term_dis-rule.rule-num, v-rule-num)
     4689     .
     4690     v-entry = '':U.
     4691     do nn = 1 to num-entries(v-tree):
     4692       assign
     4693       v-entry-entry = string(buffer buf_tt0-term_dis-rule:buffer-field(entry(nn, v-tree)):buffer-value)
     4694       .
     4695       assign
     4696       v-entry = v-entry +
     4697                 (if v-entry = '':U then "" else chr(4)) + v-entry-entry.
     4698       v-entry-list = v-entry-list + (if v-entry-list = '':U then "" else chr(3)) + v-entry.
     4699       if lookup(v-new-entry, v-entry-list, chr(3)) > 0 then do:
     4700         assign
     4701         v-dub = yes
     4702         .
     4703         MESSAGE
     4704         substitute("Уже есть такое подправило с той же областью действия или параметрами")
     4705         VIEW-AS ALERT-BOX.
     4706         LEAVE _dub.
     4707       end.
     4708     end.
     4709   END.
     4710   IF v-dub THEN UNDO, RETURN ERROR.
     4711   CREATE buf_tt0-term_dis-rule.
     4712   BUFFER-COPY tt-dis-rule
     4713   EXCEPT rule-num
     4714       upper-rule-num des
     4715       lvl-num
     4716       is-term
     4717       root
     4718   TO buf_tt0-term_dis-rule
     4719   ASSIGN
     4720   buf_tt0-term_dis-rule.rule-num = v-rule-num + 1
     4721   buf_tt0-term_dis-rule.upper-rule-num = tt-dis-rule.rule-num
     4722   buf_tt0-term_dis-rule.doc-qnty = (IF v-doc-qnty = - 1 THEN 0 ELSE v-doc-qnty)
     4723   buf_tt0-term_dis-rule.dis-kat = (IF v-dis-kat = - 1 THEN 0 ELSE v-dis-kat)
     4724   buf_tt0-term_dis-rule.tot-sum = (IF v-tot-sum = -1 THEN 0 ELSE v-tot-sum)
     4725   buf_tt0-term_dis-rule.time-rule-num = (IF v-time-rule-num = 0 THEN 0 ELSE v-time-rule-num)
     4726   buf_tt0-term_dis-rule.key#_one = (IF v-key#_one = ? THEN 0 ELSE v-key#_one)
     4727   buf_tt0-term_dis-rule.key#_two = (IF v-key#_two = ? THEN 0 ELSE v-key#_two)
     4728   buf_tt0-term_dis-rule.key#_three = (IF v-key#_three = ? THEN 0 ELSE v-key#_three)
     4729   buf_tt0-term_dis-rule.charkey_one = (IF v-charkey_one = ? THEN "":U ELSE v-charkey_one)
     4730   buf_tt0-term_dis-rule.charkey_two = (IF v-charkey_two = ? THEN "":U ELSE v-charkey_two)
     4731   buf_tt0-term_dis-rule.charkey_three = (IF v-charkey_three = ? THEN "":U ELSE v-charkey_three)
     4732   buf_tt0-term_dis-rule.deckey_one = (IF v-deckey_one = ? THEN 0 ELSE v-deckey_one)
     4733   buf_tt0-term_dis-rule.deckey_two = (IF v-deckey_two = ? THEN 0 ELSE v-deckey_two)
     4734   buf_tt0-term_dis-rule.deckey_three = (IF v-deckey_three = ? THEN 0 ELSE v-deckey_three)
     4735   buf_tt0-term_dis-rule.discnt-value = v-discnt-value
     4736   buf_tt0-term_dis-rule.sts   = INTEGER('2':U)
     4737   buf_tt0-term_dis-rule.root   = no
     4738   buf_tt0-term_dis-rule.is-term   = yes
     4739   buf_tt0-term_dis-rule.lvl-num   = tt-dis-rule.lvl-num + 1
     4740   buf_tt0-term_dis-rule.value-type = v-term-value-type
     4741   .
     4742   CREATE tt-bc-dis-rule.
     4743   ASSIGN
     4744   tt-bc-dis-rule.rule-num = v-rule-num + 1
     4745   tt-bc-dis-rule.price-brutto = f-price-netto
     4746   tt-bc-dis-rule.price-discnt = INPUT FRAME Dialog-Frame f-price-discnt
     4747   tt-bc-dis-rule.price-netto = INPUT FRAME Dialog-Frame f-price-netto
     4748   tt-bc-dis-rule.sum-brutto = INPUT FRAME Dialog-Frame f-sum-brutto
     4749   tt-bc-dis-rule.sum-discnt = INPUT FRAME Dialog-Frame f-sum-discnt
     4750   tt-bc-dis-rule.sum-netto = INPUT FRAME Dialog-Frame f-sum-netto
     4751   tt-bc-dis-rule.d-pcnt = INPUT FRAME Dialog-Frame f-d-pcnt
     4752   tt-bc-dis-rule.sale-qnty = INPUT FRAME Dialog-Frame f-sale-qnty
     4753   .
     4754   RELEASE buf_tt0-term_dis-rule.
     4755   RELEASE tt-bc-dis-rule.
     4756   RUN display-hide-fields IN THIS-PROCEDURE(v-tree, NO, 0).
     4757   HIDE
     4758   b-exit-1
     4759   IN FRAME Dialog-Frame
     4760   b-quit-1
     4761   IN FRAME Dialog-Frame.
     4762   RUN rename-term_dis-rule in this-procedure .
     4763   RUN openbr-term-dr in this-procedure .
     4764   RUN display-hide-fields IN THIS-PROCEDURE(v-tree, yes, 1).
     4765   if p-mode <> 'ПРОСМОТР':U
     4766   then
     4767   enable
     4768   b-exit
     4769   with frame Dialog-Frame .
     4770   END PROCEDURE.
     4771   PROCEDURE proc-b-quit-1 :
     4772   RUN display-hide-fields IN THIS-PROCEDURE ( v-tree, NO , 0 ).
     4773   HIDE
     4774   b-exit-1
     4775   IN FRAME Dialog-Frame
     4776   b-quit-1
     4777   IN FRAME Dialog-Frame.
     4778   if p-mode <> 'ПРОСМОТР':U
     4779   then
     4780   enable
     4781   b-exit
     4782   with frame Dialog-Frame .
     4783   END PROCEDURE.
     4784   PROCEDURE proc-save :
     4785   DEFINE VARIABLE v-log AS LOGICAL NO-UNDO.
     4786   DEFINE VARIABLE v-dub-rule-num LIKE ub.dis-rule.rule-num NO-UNDO.
     4787   if p-mode = 'ПРОСМОТР':U then do:
     4788       return error.
     4789   end.
     4790   if not available tt-dis-rule then do:
     4791       create tt-dis-rule.
     4792   end.
     4793   assign frame Dialog-Frame
     4794   tt-dis-rule.des
     4795   .
     4796   IF v-tree = "":U THEN DO:
     4797     IF tt-dis-rule.discnt-value:SENSITIVE IN FRAME Dialog-Frame THEN
     4798     ASSIGN
     4799     tt-dis-rule.discnt-value
     4800     .
     4801     IF tt-dis-rule.dis-kat:SENSITIVE IN FRAME Dialog-Frame THEN
     4802       ASSIGN
     4803     tt-dis-rule.dis-kat
     4804       .
     4805     IF tt-dis-rule.doc-qnty:SENSITIVE IN FRAME Dialog-Frame THEN
     4806       ASSIGN
     4807     tt-dis-rule.doc-qnty
     4808       .
     4809     IF tt-dis-rule.tot-sum:SENSITIVE IN FRAME Dialog-Frame THEN
