     4831     tt-dis-rule.key#_two
     4832       .
     4833     IF tt-dis-rule.key#_three:SENSITIVE IN FRAME Dialog-Frame THEN
     4834       ASSIGN
     4835     tt-dis-rule.key#_three
     4836       .
     4837     IF tt-dis-rule.charkey_one:SENSITIVE IN FRAME Dialog-Frame THEN
     4838       ASSIGN
     4839     tt-dis-rule.charkey_one
     4840       .
     4841     IF tt-dis-rule.charkey_two:SENSITIVE IN FRAME Dialog-Frame THEN
     4842       ASSIGN
     4843     tt-dis-rule.charkey_two
     4844       .
     4845     IF tt-dis-rule.charkey_three:SENSITIVE IN FRAME Dialog-Frame THEN
     4846       ASSIGN
     4847     tt-dis-rule.charkey_three
     4848       .
     4849     IF tt-dis-rule.deckey_one:SENSITIVE IN FRAME Dialog-Frame THEN
     4850       ASSIGN
     4851     tt-dis-rule.deckey_one
     4852       .
     4853     IF tt-dis-rule.deckey_two:SENSITIVE IN FRAME Dialog-Frame THEN
     4854       ASSIGN
     4855     tt-dis-rule.deckey_two
     4856       .
     4857     IF tt-dis-rule.deckey_three:SENSITIVE IN FRAME Dialog-Frame THEN
     4858       ASSIGN
     4859     tt-dis-rule.deckey_three
     4860       .
     4861   END.
     4862   ELSE DO:
     4863     IF tt-dis-rule.discnt-value:VISIBLE IN FRAME Dialog-Frame THEN
     4864     ASSIGN
     4865     tt-dis-rule.discnt-value
     4866     .
     4867     IF tt-dis-rule.dis-kat:VISIBLE  IN FRAME Dialog-Frame THEN
     4868       ASSIGN
     4869     tt-dis-rule.dis-kat
     4870       .
     4871     IF tt-dis-rule.doc-qnty:VISIBLE  IN FRAME Dialog-Frame THEN
     4872       ASSIGN
     4873     tt-dis-rule.doc-qnty
     4874       .
     4875     IF tt-dis-rule.tot-sum:VISIBLE  IN FRAME Dialog-Frame THEN
     4876       ASSIGN
     4877     tt-dis-rule.tot-sum
     4878       .
     4879     IF tt-dis-rule.time-rule-num:VISIBLE  IN FRAME Dialog-Frame THEN do:
     4880       ASSIGN
     4881       tt-dis-rule.time-rule-num
     4882       .
     4883     end.
     4884     else do:
     4885       if lookup("time-rule-num", v-level-1) = 0 then do:
     4886         assign
     4887         tt-dis-rule.time-rule-num = 0
     4888         tt-dis-rule.time-templ-rl-root = 0
     4889         .
     4890       end.
     4891     end.
     4892     IF tt-dis-rule.key#_one:VISIBLE  IN FRAME Dialog-Frame THEN
     4893       ASSIGN
     4894     tt-dis-rule.key#_one
     4895       .
     4896     IF tt-dis-rule.key#_two:VISIBLE  IN FRAME Dialog-Frame THEN
     4897       ASSIGN
     4898     tt-dis-rule.key#_two
     4899       .
     4900     IF tt-dis-rule.key#_three:VISIBLE  IN FRAME Dialog-Frame THEN
     4901       ASSIGN
     4902     tt-dis-rule.key#_three
     4903       .
     4904     IF tt-dis-rule.charkey_one:VISIBLE  IN FRAME Dialog-Frame THEN
     4905       ASSIGN
     4906     tt-dis-rule.charkey_one
     4907       .
     4908     IF tt-dis-rule.charkey_two:VISIBLE  IN FRAME Dialog-Frame THEN
     4909       ASSIGN
     4910     tt-dis-rule.charkey_two
     4911       .
     4912     IF tt-dis-rule.charkey_three:VISIBLE  IN FRAME Dialog-Frame THEN
     4913       ASSIGN
     4914     tt-dis-rule.charkey_three
     4915       .
     4916     IF tt-dis-rule.deckey_one:VISIBLE  IN FRAME Dialog-Frame THEN
     4917       ASSIGN
     4918     tt-dis-rule.deckey_one
     4919       .
     4920     IF tt-dis-rule.deckey_two:VISIBLE  IN FRAME Dialog-Frame THEN
     4921       ASSIGN
     4922     tt-dis-rule.deckey_two
     4923       .
     4924     IF tt-dis-rule.deckey_three:VISIBLE  IN FRAME Dialog-Frame THEN
     4925       ASSIGN
     4926     tt-dis-rule.deckey_three
     4927       .
     4928     ASSIGN
     4929     tt-dis-rule.discnt-value = 0
     4930     .
     4931   END.
     4932   if v-value-type = integer('4':U) then do:
     4933     assign
     4934     rs-radio-integer
     4935     tt-dis-rule.discnt-value = rs-radio-integer
     4936     .
     4937   end.
     4938   if v-value-type = integer('7':U) then do:
     4939     assign
     4940     t-flag
     4941     tt-dis-rule.discnt-value = (if t-flag then 1 else 0)
     4942     .
     4943   end.
     4944   if (p-templ-rl-root = 73
     4945   or p-templ-rl-root = 74) then do:
     4946    define variable glog as logical no-undo init yes.
     4947   _tt:
     4948     for each tt0-term_dis-rule :
     4949       if tt0-term_dis-rule.key#_one = 0 then do:
     4950         message
     4951         "Вы не определили тип кассового платежа, при котором будет действовать скидка!" skip
     4952         "В этом случае скидка будет срабатывать при любом типе кассового платежа!" skip
     4953         "Сохранять правило?"
     4954         view-as alert-box warning buttons yes-no update glog.
     4955         leave _tt.
     4956       end.
     4957     end.
     4958     if not glog then return  error.
     4959   end.
     4960   run ref/diffdisr.p ( input p-mode
     4961                 , INPUT TABLE tt-dis-rule
     4962                 , INPUT TABLE tt0-term_dis-rule
     4963                 , OUTPUT v-dub-rule-num) NO-ERROR.
     4964   IF ERROR-STATUS:ERROR
     4965   OR v-dub-rule-num <> 0 THEN DO:
     4966      IF is-good-mode THEN DO:
     4967          MESSAGE
     4968           substitute("В системе уже существует точно такое же правило скидок (правило № &1)", v-dub-rule-num) SKIP
     4969           VIEW-AS ALERT-BOX ERROR.
     4970           undo, RETURN ERROR.
     4971       END.
     4972      ELSE DO:
     4973          MESSAGE
     4974           substitute("В системе уже существует точно такое же правило скидок (правило № &1)", v-dub-rule-num) SKIP
     4975           "Вы уверены, что хотите создать еще одно такое же правило?"
     4976           VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE v-log.
     4977           IF NOT v-log THEN undo, RETURN ERROR.
     4978     END.
     4979   END.
     4980   run ref/dis-rul1.p (
     4981   input (IF p-mode = 'ДОБАВЛЕНИЕ':U THEN ? ELSE tt-dis-rule.rule-num )
     4982   ,input v-pos-type
     4983   ,input p-templ-rl-root
     4984   ,input p-templ-rl-root
     4985   ,input tt-dis-rule.des
     4986   ,input tt-dis-rule.dis-kat
     4987   ,input tt-dis-rule.discnt-type
     4988   ,input tt-dis-rule.doc-qnty
     4989   ,input tt-dis-rule.tot-sum
     4990   ,input tt-dis-rule.charkey_one
     4991   ,input tt-dis-rule.charkey_two
     4992   ,input tt-dis-rule.charkey_three
     4993   ,input tt-dis-rule.deckey_one
     4994   ,input tt-dis-rule.deckey_two
     4995   ,input tt-dis-rule.deckey_three
     4996   ,input tt-dis-rule.key#_one
     4997   ,input tt-dis-rule.key#_two
     4998   ,input tt-dis-rule.key#_three
     4999   ,input tt-dis-rule.subject-type
     5000   ,input tt-dis-rule.time-templ-rl-root
     5001   ,input tt-dis-rule.time-rule-num
     5002   ,input tt-dis-rule.upper-rule-num
     5003   ,input tt-dis-rule.value-type
     5004   ,input tt-dis-rule.host-code
     5005   ,INPUT tt-dis-rule.obj-type
     5006   ,INPUT tt-dis-rule.obj-code
     5007   ,INPUT tt-dis-rule.discnt-value
     5008   ,input table tt0-term_dis-rule
     5009   ,input-output p-recid
     5010   ,input p-mode
     5011   ,input NO
     5012   ) NO-ERROR.
     5013   if error-status:error then do:
     5014   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5015   define variable fh as widget-handle no-undo .
     5016   define variable hh as widget-handle no-undo .
     5017   define variable rv as character no-undo .
     5018   assign
     5019   rv = entry(1, return-value , chr(4)).
     5020   if rv <> "":U then do:
     5021     assign
     5022     fh = frame Dialog-Frame:first-child
     5023     hh = fh:first-child
     5024     .
     5025     do while valid-handle(hh):
     5026       if hh:name = rv then do:
     5027         APPLY "ENTRY" to hh.
     5028         undo ,
     5029         return error.
     5030       end.
     5031       hh = hh:next-sibling.
     5032     end.
     5033   end.
     5034     undo, return error.
     5035   end.
     5036   END PROCEDURE.
     5037   PROCEDURE proc-time-rule-lookup :
     5038   DEFINE INPUT PARAMETER p-tree AS CHARACTER NO-UNDO.
     5039   DEFINE VARIABLE loc-doc-rec AS RECID NO-UNDO.
     5040   IF lookup("time-rule-num", v-level-1) > 0
     5041   or lookup("time-rule-num", v-level-2) > 0
     5042   tHEN DO:
     5043     IF lookup("time-rule-num":U, v-level-1) > 0 THEN DO:
     5044           run ref/dis-timi.w (
     5045                      input parParentProc
     5046                     ,input 'ПРОСМОТР':U
     5047                     ,input 0
     5048                     ,input tt-dis-rule.time-rule-num
     5049                     ,input 0
     5050                     ,input-output loc-doc-rec
     5051                     ) no-error .
     5052     END.
     5053     ELSE DO:
     5054      IF AVAILABLE tt0-term_dis-rule THEN DO:
     5055        run ref/dis-timi.w (
     5056                      input parParentProc
     5057                     ,input 'ПРОСМОТР':U
     5058                     ,input 0
     5059                     ,input tt0-term_dis-rule.time-rule-num
     5060                     ,input 0
     5061                     ,input-output loc-doc-rec
     5062                     ) no-error .
     5063       END.
     5064     END.
     5065   END.
     5066   END PROCEDURE.
     5067   PROCEDURE recalc :
     5068   DEFINE INPUT PARAMETER p-price-brutto LIKE ub.gds-obj.price-sale NO-UNDO.
     5069   DEFINE INPUT PARAMETER p-main AS CHARACTER NO-UNDO.
     5070   DEFINE INPUT PARAMETER p-discnt-value LIKE ub.dis-rule.discnt-value NO-UNDO.
     5071   DEFINE INPUT PARAMETER p-doc-qnty LIKE ub.dis-rule.doc-qnty NO-UNDO.
     5072   DEFINE INPUT PARAMETER p-tot-sum LIKE ub.dis-rule.tot-sum NO-UNDO.
     5073   ASSIGN
     5074   f-sum-brutto = ABS(p-price-brutto * p-doc-qnty)
     5075   f-sale-qnty = truncate(p-tot-sum / p-price-brutto, v-meas).
     5076   IF tt-dis-rule.tot-sum:VISIBLE IN FRAME Dialog-Frame = NO   THEN DO:
     5077                                                                                  ~
     5078   CASE p-main:
     5079       WHEN "price-discnt" THEN DO:
     5080           ASSIGN
     5081           f-price-netto = p-price-brutto - f-price-discnt
     5082           f-d-pcnt       = 100 * (1 - f-price-netto / p-price-brutto)
     5083           f-sum-netto = ABS(f-price-netto * p-doc-qnty)
     5084           f-sum-discnt = ABS(f-price-discnt * p-doc-qnty)
     5085           .
     5086       END.
     5087       WHEN "price-netto" THEN DO:
     5088           ASSIGN
     5089           f-price-discnt = p-price-brutto - f-price-netto
     5090           f-d-pcnt       = 100 * (1 - f-price-netto / p-price-brutto)
     5091           f-sum-netto = ABS(f-price-netto * p-doc-qnty)
     5092           f-sum-discnt = ABS(f-price-discnt * p-doc-qnty)
     5093           .
     5094       END.
     5095       WHEN "d-pcnt" THEN DO:
     5096           ASSIGN
     5097           f-price-discnt = p-price-brutto - p-price-brutto * f-d-pcnt / 100
     5098           f-price-netto  = p-price-brutto - f-price-discnt
     5099           f-sum-netto = ABS(f-price-netto * p-doc-qnty)
     5100           f-sum-discnt = ABS(f-price-discnt * p-doc-qnty)
     5101           .
     5102       END.
     5103       WHEN "sum-netto" THEN DO:
     5104           ASSIGN
     5105           f-price-netto = f-sum-netto / p-doc-qnty
     5106           f-sum-discnt = f-sum-brutto - f-sum-netto
     5107           f-d-pcnt       = 100 * (1 - f-price-netto / p-price-brutto)
     5108           f-price-discnt = p-price-brutto - f-price-netto
     5109           .
     5110       END.
     5111       WHEN "sum-discnt" THEN DO:
     5112           ASSIGN
     5113           f-sum-netto = f-sum-brutto - f-sum-discnt
     5114           f-price-netto = f-sum-netto / p-doc-qnty
     5115           f-price-discnt = (f-sum-brutto - f-sum-netto) / p-doc-qnty
     5116           f-d-pcnt = 100 * (1 - f-price-netto / p-price-brutto)  .
     5117       END.
     5118       WHEN "discnt-value" THEN DO:
     5119           CASE v-term-value-type:
     5120               WHEN  integer('1':U)THEN DO:
     5121                   ASSIGN
     5122                   f-d-pcnt = p-discnt-value
     5123                   f-price-discnt = p-price-brutto * f-d-pcnt / 100
     5124                   f-price-netto  = p-price-brutto - f-price-discnt
     5125                   f-sum-netto = ABS(f-price-netto * p-doc-qnty)
     5126                   f-sum-discnt = ABS(f-price-discnt * p-doc-qnty)
     5127                   .
     5128               END.
     5129               WHEN  integer('2':U)THEN DO:
     5130                   ASSIGN
     5131                   f-price-discnt = f-price-brutto -  p-discnt-value
     5132                   f-price-netto = p-price-brutto - f-price-discnt
     5133                   f-d-pcnt       = 100 * (1 - f-price-netto / p-price-brutto)
     5134                   f-sum-netto = ABS(f-price-netto * p-doc-qnty)
     5135                   f-sum-discnt = ABS(f-price-discnt * p-doc-qnty).
     5136                   .
     5137               END.
     5138               WHEN  integer('3':U)THEN DO:
     5139                   ASSIGN
     5140                   f-price-netto = p-discnt-value
     5141                   f-price-discnt = p-price-brutto - f-price-netto
     5142                   f-d-pcnt       = 100 * (1 - f-price-netto / p-price-brutto)
     5143                   f-sum-netto = ABS(f-price-netto * p-doc-qnty)
     5144                   f-sum-discnt = ABS(f-price-discnt * p-doc-qnty).
     5145                  .
     5146               END.
     5147           END CASE.
     5148       END.
     5149     END CASE.
     5150     IF p-main <> "discnt-value" THEN DO:
     5151       CASE v-term-value-type:
     5152         WHEN  integer('1':U) THEN DO:
     5153           p-discnt-value = f-d-pcnt.
     5154         END.
     5155         WHEN  integer('2':U) THEN DO:
     5156             p-discnt-value = f-price-brutto - f-price-netto.
     5157         END.
     5158         WHEN  integer('3':U) THEN DO:
     5159             p-discnt-value = f-price-netto.
     5160         END.
     5161       END CASE.
     5162     END.
     5163   END.
     5164   ELSE DO:
     5165     CASE p-main:
     5166                                                                              ~
     5167       WHEN "price-discnt" THEN DO:
     5168           ASSIGN
     5169           f-price-netto = p-price-brutto - f-price-discnt
     5170           f-d-pcnt       = 100 * (1 - f-price-netto / p-price-brutto)
     5171           f-sum-netto = ABS(f-price-netto * f-sale-qnty)
     5172           f-sum-discnt = ABS(f-price-discnt * p-doc-qnty).
     5173       END.
     5174       WHEN "price-netto" THEN DO:
     5175           ASSIGN
     5176           f-price-discnt = p-price-brutto - f-price-netto
     5177           f-d-pcnt       = 100 * (1 - f-price-netto / p-price-brutto)
     5178           f-sum-netto = ABS(f-price-netto * f-sale-qnty)
     5179           f-sum-discnt = ABS(f-price-discnt * f-sale-qnty).
     5180       END.
     5181       WHEN "d-pcnt" THEN DO:
     5182           ASSIGN
     5183           f-price-discnt = p-price-brutto - p-price-brutto * f-d-pcnt / 100
     5184           f-price-netto  = p-price-brutto - f-price-discnt
     5185           f-sum-netto = ABS(f-price-netto * f-sale-qnty)
     5186           f-sum-discnt = ABS(f-price-discnt * f-sale-qnty)
     5187           .
     5188       END.
     5189       WHEN "sum-netto" THEN DO:
     5190           ASSIGN
     5191           f-price-netto = f-sum-netto / p-doc-qnty
     5192           f-sum-discnt = f-sum-brutto - f-sum-netto
     5193           f-d-pcnt       = 100 * (1 - f-price-netto / p-price-brutto)
     5194           f-price-discnt = p-price-brutto - f-price-netto
     5195           .
     5196       END.
     5197       WHEN "sum-discnt" THEN DO:
     5198           ASSIGN
     5199           f-sum-netto = f-sum-brutto - f-sum-discnt
     5200           f-price-netto = f-sum-netto / f-sale-qnty
     5201           f-price-discnt = (f-sum-brutto - f-sum-netto) / p-doc-qnty
     5202           f-d-pcnt = 100 * (1 - f-price-netto / p-price-brutto)  .
     5203       END.
     5204       WHEN "discnt-value" THEN DO:
     5205         CASE v-term-value-type:
     5206           WHEN  integer('1':U)THEN DO:
     5207             ASSIGN
     5208             f-d-pcnt = p-discnt-value
     5209             f-price-discnt = p-price-brutto * f-d-pcnt / 100
     5210             f-price-netto  = p-price-brutto - f-price-discnt
     5211             f-sum-netto = ABS(f-price-netto * f-sale-qnty)
     5212             f-sum-discnt = ABS(f-price-discnt * f-sale-qnty)
     5213             .
     5214           END.
     5215           WHEN  integer('2':U)THEN DO:
     5216             ASSIGN
     5217             f-price-discnt = f-price-brutto -  p-discnt-value
     5218             f-price-netto = p-price-brutto - f-price-discnt
     5219             f-d-pcnt       = 100 * (1 - f-price-netto / p-price-brutto)
     5220             f-sum-netto = ABS(f-price-netto * f-sale-qnty)
     5221             f-sum-discnt = ABS(f-price-discnt * f-sale-qnty).
     5222             .
     5223           END.
     5224           WHEN  integer('3':U)THEN DO:
     5225             ASSIGN
     5226             f-price-netto = p-discnt-value
     5227             f-price-discnt = p-price-brutto - f-price-netto
     5228             f-d-pcnt       = 100 * (1 - f-price-netto / p-price-brutto)
     5229             f-sum-netto = ABS(f-price-netto * f-sale-qnty)
     5230             f-sum-discnt = ABS(f-price-discnt * f-sale-qnty).
     5231             .
     5232           END.
     5233         END CASE.
     5234       END.
     5235     END CASE.
     5236     IF p-main <> "discnt-value" THEN DO:
     5237       CASE v-term-value-type:
     5238         WHEN  integer('1':U) THEN DO:
     5239           p-discnt-value = f-d-pcnt.
     5240         END.
     5241         WHEN  integer('2':U) THEN DO:
     5242             p-discnt-value = f-price-brutto - f-price-netto.
     5243         END.
     5244         WHEN  integer('3':U) THEN DO:
     5245             p-discnt-value = f-price-netto.
     5246         END.
     5247       END CASE.
     5248     END.
     5249   END.
     5250   DISPLAY
     5251   f-d-pcnt WHEN (v-term-value-type <> INTEGER('1':U)) AND f-d-pcnt:VISIBLE IN FRAME Dialog-Frame
     5252   f-price-discnt when f-price-discnt:VISIBLE IN FRAME Dialog-Frame
     5253   f-price-netto when f-price-netto:VISIBLE IN FRAME Dialog-Frame
     5254   f-sale-qnty WHEN f-sale-qnty:VISIBLE IN FRAME Dialog-Frame = yes
     5255   f-sum-discnt WHEN f-sum-discnt:VISIBLE IN FRAME Dialog-Frame
     5256   f-sum-netto  WHEN f-sum-netto:VISIBLE IN FRAME Dialog-Frame
     5257   f-sum-brutto WHEN f-sum-brutto:VISIBLE IN FRAME Dialog-Frame
     5258   WITH FRAME Dialog-Frame.
     5259   display
     5260   p-discnt-value @ tt-dis-rule.discnt-value
     5261   WITH FRAME Dialog-Frame.
     5262   END PROCEDURE.
     5263   PROCEDURE rename-term_dis-rule :
     5264   DEFINE VARIABLE v-doc-qnty LIKE ub.dis-rule.doc-qnty NO-UNDO.
     5265   DEFINE VARIABLE v-dis-kat LIKE ub.dis-rule.dis-kat NO-UNDO.
     5266   DEFINE VARIABLE v-tot-sum LIKE ub.dis-rule.tot-sum NO-UNDO.
     5267   DEFINE VARIABLE v-time-rule-num LIKE ub.dis-rule.time-rule-num NO-UNDO.
     5268   define variable v-charkey_one like ub.dis-rule.charkey_one no-undo .
     5269   define variable v-charkey_two like ub.dis-rule.charkey_two no-undo .
     5270   define variable v-charkey_three like ub.dis-rule.charkey_three no-undo .
     5271   define variable v-deckey_one like ub.dis-rule.deckey_one no-undo .
     5272   define variable v-deckey_two like ub.dis-rule.deckey_two no-undo .
     5273   define variable v-deckey_three like ub.dis-rule.deckey_three no-undo .
