     4811     tt-dis-rule.tot-sum
     4812       .
     4813     IF tt-dis-rule.time-rule-num:SENSITIVE IN FRAME Dialog-Frame THEN
     4814       ASSIGN
     4815     tt-dis-rule.time-rule-num
     4816       .
     4817     else do:
     4818       if lookup("time-rule-num", v-level-1) = 0 then do:
     4819         assign
     4820         tt-dis-rule.time-rule-num = 0
     4821         tt-dis-rule.time-templ-rl-root = 0
     4822         .
     4823       end.
     4824     end.
     4825     IF tt-dis-rule.key#_one:SENSITIVE IN FRAME Dialog-Frame THEN
