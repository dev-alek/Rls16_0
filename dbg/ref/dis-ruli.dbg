      789   ON CHOOSE OF B-time-rule-lookup IN FRAME Dialog-Frame
      790   DO:
      791     RUN proc-time-rule-lookup IN THIS-PROCEDURE (V-TREE) NO-ERROR.
      792     IF ERROR-STATUS:ERROR  THEN RETURN NO-APPLY.
      793   END.
      794   ON RETURN OF BR-gds-rule-attr IN FRAME Dialog-Frame
      795   DO:
      796     def var v-upd as char no-undo .
      797     IF AVAIL TEMP-GDS-RULE-ATTR then
      798     do:
      799       if temp-gds-rule-attr.type-rec = "A" then
      800       do:
      801         assign
      802         v-upd = "D"
      803         .
      804       end.
      805       else
      806       do:
      807         assign
      808         v-upd = "A"
      809         .
      810       end.
      811       find buf_dis-gds-rule-attr where
      812           rowid(buf_dis-gds-rule-attr) = temp-gds-rule-attr.r-id
      813           exclusive-lock no-error.
      814       if avail buf_dis-gds-rule-attr then
      815       do:
      816         find current temp-gds-rule-attr no-error.
      817         if avail temp-gds-rule-attr then
      818         do:
      819           assign
      820             temp-gds-rule-attr.type-rec = v-upd
      821             buf_dis-gds-rule-attr.attr-value = temp-gds-rule-attr.b-str + "," + v-upd
      822              .
      823           find current temp-gds-rule-attr no-lock no-error.
      824           find current buf_dis-gds-rule-attr no-lock .
      825           browse BR-gds-rule-attr:refresh().
      826         end.
      827       end.
      828     end.
      829   END.
      830   ON VALUE-CHANGED OF BR-term-dr IN FRAME Dialog-Frame
      831   DO:
      832     IF AVAILABLE tt0-term_dis-rule
      833     AND tt0-term_dis-rule.time-rule-num > 0
      834     AND lookup("time-rule-num", v-level-2) > 0 THEN DO:
      835        ENABLE
      836        b-time-rule-lookup
      837        WITH FRAME Dialog-Frame.
      838     END.
      839     if available tt0-term_dis-rule then do:
      840       assign
      841       v-term-value-type = tt0-term_dis-rule.value-type.
      842     end.
      843     else do:
      844       assign
      845       v-term-value-type = v-value-type.
      846     end.
      847   END.
