      116   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      117     define variable v-cntxt-db-num        as integer   no-undo .
      118     define variable v-cntxt-userid        as character no-undo .
      119     define variable v-cntxt-level         as character no-undo .
      120     define variable v-cntxt-host-code-obj as integer   no-undo .
      121     define variable v-cntxt-obj-type      as character no-undo .
      122     define variable v-cntxt-obj-code      as integer   no-undo .
      123     define variable v-cntxt-db-num-obj    as integer   no-undo .
      124     define variable v-cntxt-is-admin      as logical   no-undo .
      125   define variable v-message    as character    no-undo.
      126   define buffer buf_cd-events      for ub.cd-events .
      127   DEFINE BUTTON b-exit AUTO-GO
      128        LABEL "&Ввод"
      129        SIZE 10 BY 1
      130        BGCOLOR 8 .
      131   DEFINE BUTTON b-help
      132        LABEL "Помо&щь"
      133        SIZE 10 BY 1
      134        BGCOLOR 8 .
      135   DEFINE BUTTON b-quit AUTO-END-KEY
      136        LABEL "&Отмена"
      137        SIZE 10 BY 1
      138        BGCOLOR 8 .
      139   DEFINE VARIABLE cb-type AS CHARACTER FORMAT "X(256)":U INITIAL "U"
      140        LABEL "Тип"
      141        VIEW-AS COMBO-BOX INNER-LINES 3
      142        LIST-ITEM-PAIRS "Запрос пользователя","U",
      143                        "Реакция системы","S",
      144                        "Ошибка","E"
      145        DROP-DOWN-LIST
      146        SIZE 25 BY 1 NO-UNDO.
      147   DEFINE VARIABLE v-level AS INTEGER FORMAT ">9":U INITIAL 0
      148        LABEL "Уровень"
      149        VIEW-AS COMBO-BOX INNER-LINES 3
      150        LIST-ITEM-PAIRS "Низкий",0,
      151                        "Средний",1,
      152                        "Высокий",2
      153        DROP-DOWN-LIST
      154        SIZE 10.63 BY 1 NO-UNDO.
      155   DEFINE VARIABLE ed-description AS CHARACTER
      156        VIEW-AS EDITOR SCROLLBAR-VERTICAL
      157        SIZE 42.25 BY 4 TOOLTIP "Описание" NO-UNDO.
      158   DEFINE VARIABLE v-event-id AS INTEGER FORMAT ">>>9":U INITIAL 0
      159        LABEL "Идентификатор"
      160        VIEW-AS FILL-IN
      161        SIZE 14 BY 1 NO-UNDO.
      162   DEFINE VARIABLE v-name AS CHARACTER FORMAT "X(30)":U
      163        LABEL "Название"
      164        VIEW-AS FILL-IN
      165        SIZE 42.13 BY 1 NO-UNDO.
      166   DEFINE FRAME Dialog-Frame
      167        b-exit AT ROW 1 COL 1
      168        b-quit AT ROW 1 COL 11
      169        b-help AT ROW 1.25 COL 49.25
      170        v-event-id AT ROW 2.5 COL 15.38 COLON-ALIGNED WIDGET-ID 16
      171        v-name AT ROW 3.92 COL 15.38 COLON-ALIGNED WIDGET-ID 4
      172        cb-type AT ROW 5.38 COL 32.38 COLON-ALIGNED WIDGET-ID 10
      173        v-level AT ROW 5.42 COL 15.38 COLON-ALIGNED WIDGET-ID 18
      174        ed-description AT ROW 6.88 COL 17.25 NO-LABEL WIDGET-ID 12
      175        "Описание" VIEW-AS TEXT
      176             SIZE 8 BY .67 AT ROW 7 COL 7.5 WIDGET-ID 14
      177        SPACE(45.87) SKIP(3.82)
      178       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      179            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      180            TITLE "Событие на кассе"
      181            DEFAULT-BUTTON b-exit CANCEL-BUTTON b-quit WIDGET-ID 100.
      182   ASSIGN
      183          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      184          FRAME Dialog-Frame:HIDDEN           = TRUE.
      185   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      186   DO:
      187     APPLY "END-ERROR":U TO SELF.
      188   END.
      189   ON CHOOSE OF b-exit IN FRAME Dialog-Frame
      190   DO:
      191      ASSIGN
      192       v-event-id
      193       v-name
      194       v-level
      195       cb-type
      196       ed-description
      197       v-message = "":U
      198      .
      199      RUN chk-event IN THIS-PROCEDURE  ( INPUT v-event-id
      200                                       , OUTPUT v-message
      201                                       ) .
      202      IF v-message <> "":U
      203      THEN DO:
      204         message
      205            v-message
      206            skip
      207         view-as alert-box information.
      208         RETURN NO-APPLY .
      209      END.
      210      RUN save-event IN THIS-PROCEDURE ( INPUT v-event-id
      211                                       , INPUT v-name
      212                                       , INPUT v-level
      213                                       , INPUT cb-type
      214                                       , INPUT ed-description
      215                                       , OUTPUT p-ok
      216                                       ) NO-ERROR.
      217      IF NOT p-ok
      218      OR ERROR-STATUS:ERROR
      219      THEN DO:
      220         IF p-id = 0
      221         THEN DO:
      222            message
      223               "Ошибка создания записи"
      224               skip RETURN-VALUE
      225               skip ERROR-STATUS:get-message(1)
      226            view-as alert-box information.
      227         END.
      228         ELSE DO:
      229            message
      230               "Ошибка изменения записи"
      231               skip RETURN-VALUE
      232               skip ERROR-STATUS:get-message(1)
      233            view-as alert-box information.
      234         END.
      235      END.
      236      ELSE DO:
      237         ASSIGN
      238            p-id = v-event-id
      239         .
      240      END.
      241   END.
      242   ON CHOOSE OF b-help IN FRAME Dialog-Frame
      243   OR HELP OF FRAME Dialog-Frame
      244   DO:
      245     MESSAGE "Help for File: c:\tester\Rls_16_0\rc_160_rus\cmpdir\src\ref\cdevened.w" VIEW-AS ALERT-BOX INFORMATION.
      246   END.
      247   ON LEAVE OF v-event-id IN FRAME Dialog-Frame
      248   DO:
      249      ASSIGN
      250         v-event-id
      251         v-message = "":U
      252      .
      253      RUN chk-event IN THIS-PROCEDURE  ( INPUT v-event-id
      254                                       , OUTPUT v-message
      255                                       ) .
      256      IF v-message <> "":U
      257      THEN DO:
      258         message
      259            v-message
      260            skip
      261         view-as alert-box information.
      262         RETURN NO-APPLY .
      263      END.
      264   END.
      265   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      266   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      267   MAIN-BLOCK:
      268   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      269      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      270   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      271     run mainmenu_getcntxt in parparentproc
      272       (output v-cntxt-db-num
      273       ,output v-cntxt-userid
      274       ,output v-cntxt-level
      275       ,output v-cntxt-host-code-obj
      276       ,output v-cntxt-obj-type
      277       ,output v-cntxt-obj-code
      278       ,output v-cntxt-db-num-obj
      279       ,output v-cntxt-is-admin
      280       ) .
      281   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      282   on help of frame Dialog-Frame
      283   do:
      284     run gbl/app_help.p
      285       (input this-procedure :file-name
      286       ,input ''
      287       ,input ?
      288       ) no-error.
      289     if error-status :error then do:
      290       message
      291         "Ошибка при вызове помощи"
      292         error-status :get-message(1)
      293         view-as alert-box .
      294     end.
      295   end.
      296   run minbtn-set in this-procedure .
      297   on choose of b-help in frame Dialog-Frame
      298   do:
      299     apply "help":u to frame Dialog-Frame .
      300   end.
      301   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      302   procedure minbtn-set :
      303       do
      304           on error undo, return error return-value
      305           :
      306           define variable ii              as integer       no-undo .
      307           define variable fh              as widget-handle no-undo .
      308           define variable hh              as widget-handle no-undo .
      309           define variable v-h             as handle        extent 4 no-undo .
      310           define variable v-name-button   as character     no-undo .
      311           define variable v-help-old-x    as decimal       no-undo .
      312           define variable v-help-old-y    as decimal       no-undo .
      313           define variable v-help-old-size as decimal       no-undo .
      314           define variable v-frame-width   as decimal       no-undo .
      315           define variable jj              as integer       no-undo .
      316           do
      317               on error undo, return error
      318               :
      319               assign
      320                   v-frame-width = frame Dialog-Frame:width - 0.3
      321                   fh            = frame Dialog-Frame:first-child
      322                   hh            = fh:first-child
      323                   ii            = 1
      324                   .
      325               do while valid-handle(hh):
      326                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      327                   do:
      328                       case lc(hh:name) :
      329                           when "b-help" then
      330                               do:
      331                                   hh:load-image-up("cmp/b-help.bmp":u) .
      332                                   hh:load-image-down("cmp/b-help.bmp":u) .
      333                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      334                                   hh:TOOLTIP = "Помощь" .
      335                                   v-help-old-x = hh:column .
      336                                   v-help-old-y = hh:row    .
      337                                   v-help-old-size = hh:width .
      338                                   hh:width-chars = 2.5 .
      339                               end.
      340                           when "b-print" then
      341                               do:
      342                                   hh:load-image("cmp/b-print.bmp":u) .
      343                                   hh:TOOLTIP = "Печать" .
      344                                   v-h[ii] = hh:handle .
      345                                   ii = ii + 1 .
      346                                   hh:width-chars = 3 .
      347                               end.
      348                           when "b-history" or
      349                           when "b-hist" then
      350                               do:
      351                                   hh:load-image("cmp/b-hist.bmp":u) .
      352                                   hh:TOOLTIP = "История" .
      353                                   v-h[ii] = hh:handle .
      354                                   ii = ii + 1 .
      355                                   hh:width-chars = 3 .
      356                               end.
      357                           when "b-sch" then
      358                               do:
      359                                   hh:load-image("cmp/b-sch.bmp":u) .
      360                                   hh:TOOLTIP = "Установка Фильтра" .
      361                                   v-h[ii] = hh:handle .
      362                                   ii = ii + 1 .
      363                                   hh:width-chars = 3 .
      364                               end.
      365                           when "b-hist-user" then
      366                               do:
      367                                   hh:load-image("cmp/b-hist.bmp":u) .
      368                                   hh:TOOLTIP = "История пользователя" .
      369                                   ii = ii + 1 .
      370                               end.
      371                       end case.
      372                   end.
      373                   hh = hh:next-sibling.
      374               end.
      375               b-help:column = v-frame-width - b-help:width-chars.
      376               jj = 0.
      377               repeat ii = 4 to 1 by -1 :
      378                   if valid-handle (v-h[ii] ) then
      379                   do:
      380                       jj  = jj + 1 .
      381                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      382                       v-h[ii]:row    = v-help-old-y .
      383                   end.
      384               end.
      385           end.
      386       end.
      387   end procedure.
      388      if p-id <> 0
      389      THEN DO:
      390         assign
      391            v-message = "":U
      392         .
      393         RUN init-event in THIS-PROCEDURE ( INPUT p-id
      394                                          , OUTPUT v-name
      395                                          , OUTPUT v-level
      396                                          , OUTPUT cb-type
      397                                          , OUTPUT ed-description
      398                                          , OUTPUT v-message
      399                                          ) .
      400         IF v-message <> "":U
      401         THEN DO:
      402            message
      403               v-message
      404               skip
      405            view-as alert-box information.
      406            RETURN.
      407         END.
      408         ASSIGN
      409            v-event-id = p-id
      410         .
      411      END.
      412      ELSE DO:
      413         define buffer bf_cd-events      for ub.cd-events .
      414         FIND LAST bf_cd-events
      415              USE-INDEX PI
      416              NO-LOCK
      417              .
      418         ASSIGN
      419            v-event-id = bf_cd-events.event-id + 1
      420         .
      421         RELEASE bf_cd-events.
      422      END.
      423      RUN enable_UI.
      424      IF p-id <> 0
      425      THEN DISABLE  v-event-id WITH FRAME Dialog-Frame.
      426      WAIT-FOR GO OF FRAME Dialog-Frame focus v-name.
      427   END.
      428   RUN disable_UI.
      429   PROCEDURE chk-event :
      430   define input parameter p-e-id      as integer          no-undo.
      431   define output parameter p-message as character        no-undo.
      432   define buffer bf_cd-events      for ub.cd-events .
      433      IF CAN-FIND (FIRST bf_cd-events
      434                   WHERE bf_cd-events.event-id = p-e-id
      435                   no-lock
      436                   )
      437      THEN DO:
      438         ASSIGN
      439            p-message = "Уже есть запись с таким идентификатором"
      440         .
      441      END.
      442   END PROCEDURE.
      443   PROCEDURE disable_UI :
      444     HIDE FRAME Dialog-Frame.
      445   END PROCEDURE.
      446   PROCEDURE enable_UI :
      447     DISPLAY v-event-id v-name cb-type v-level ed-description
      448         WITH FRAME Dialog-Frame.
      449     ENABLE b-exit b-quit b-help v-event-id v-name cb-type v-level ed-description
      450         WITH FRAME Dialog-Frame.
      451     VIEW FRAME Dialog-Frame.
      452   END PROCEDURE.
      453   PROCEDURE init-event :
      454   define input parameter p-e-id      as integer          no-undo.
      455   define output parameter p-name   as character        no-undo.
      456   define output parameter p-level  as integer          no-undo.
      457   define output parameter p-type   as character        no-undo.
      458   define output parameter p-desc   as character        no-undo.
      459   define output parameter p-message as character        no-undo.
      460   do
      461   TRANSACTION
      462   on error undo, return error
      463   :
      464      FIND FIRST buf_cd-events
      465           WHERE buf_cd-events.event-id = p-e-id
      466           EXCLUSIVE-LOCK
      467           NO-ERROR
      468           .
      469      IF LOCKED buf_cd-events
      470      THEN DO:
      471         ASSIGN
      472            p-message = "Запись редактируется другим пользователем"
      473         .
      474         RETURN .
      475      END.
      476      ASSIGN
      477         p-name  = buf_cd-events.event-name
      478         p-level = buf_cd-events.event-level
      479         p-type  = buf_cd-events.event-type
      480         p-desc  = buf_cd-events.event-description
      481      .
      482   end.
      483   END PROCEDURE.
      484   PROCEDURE save-event :
      485   define input parameter p-e-id     as integer          no-undo.
      486   define input parameter p-name   as character        no-undo.
      487   define input parameter p-level  as integer          no-undo.
      488   define input parameter p-type   as character        no-undo.
      489   define input parameter p-desc   as character        no-undo.
      490   define output parameter p-ok    as logical          no-undo.
      491      IF NOT AVAILABLE buf_cd-events
      492      THEN DO:
      493         CREATE buf_cd-events.
      494         ASSIGN
      495            buf_cd-events.event-id = p-id
      496         .
      497      END.
      498      ASSIGN
      499         buf_cd-events.event-id          = p-e-id
      500         buf_cd-events.event-name        = p-name
      501         buf_cd-events.event-level       = p-level
      502         buf_cd-events.event-type        = p-type
      503         buf_cd-events.event-description = p-desc
      504         p-ok                            = TRUE
      505      .
      506   END PROCEDURE.
