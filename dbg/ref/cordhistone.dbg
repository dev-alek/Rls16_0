     4561                           .
     4562                       end.
     4563                       when chr(2)
     4564                       then do:
     4565                           assign
     4566                               p-out-string = p-out-string + " ":U
     4567                           .
     4568                       end.
     4569                       when chr(3)
     4570                       then do:
     4571                           assign
     4572                               p-out-string = p-out-string + " ":U
     4573                           .
     4574                       end.
     4575                       when chr(4)
     4576                       then do:
     4577                           assign
     4578                               p-out-string = p-out-string + " ":U
     4579                           .
     4580                       end.
     4581                       when chr(5)
     4582                       then do:
     4583                           assign
     4584                               p-out-string = p-out-string + " ":U
     4585                           .
     4586                       end.
     4587                       when chr(6)
     4588                       then do:
     4589                           assign
     4590                               p-out-string = p-out-string + " ":U
     4591                           .
     4592                       end.
     4593                       when chr(7)
     4594                       then do:
     4595                           assign
     4596                               p-out-string = p-out-string + " ":U
     4597                           .
     4598                       end.
     4599                       when chr(8)
     4600                       then do:
     4601                           assign
     4602                               p-out-string = p-out-string + " ":U
     4603                           .
     4604                       end.
     4605                       when chr(9)
     4606                       then do:
     4607                           assign
     4608                               p-out-string = p-out-string + " ":U
     4609                           .
     4610                       end.
     4611                       when chr(29)
     4612                       then do:
     4613                           assign
     4614                               p-out-string = p-out-string + " ":U
     4615                           .
     4616                       end.
     4617                       when chr(10)
     4618                       then do:
     4619                           assign
     4620                               p-out-string = p-out-string + " ":U
     4621                           .
     4622                       end.
     4623                       when chr(13)
     4624                       then do:
     4625                           assign
     4626                               p-out-string = p-out-string + " ":U
     4627                           .
     4628                       end.
     4629                       otherwise do:
     4630                           assign
     4631                               p-out-string = p-out-string + v-current-char
     4632                           .
     4633                       end.
     4634                   end case.
     4635               end.
     4636           end.
     4637       end case.
     4638   end.
     4639   end .
     4640   procedure xmlchar-decode :
     4641   define input parameter p-in-string      as character        no-undo.
     4642   define output parameter p-out-string    as character        no-undo.
     4643       define variable v-position      as integer      no-undo.
     4644       define variable v-last-position as integer      no-undo.
     4645       define variable v-temp-integer  as integer      no-undo.
     4646       define variable v-current-char  as character    no-undo.
     4647       define variable v-next-char     as character    no-undo.
     4648       define variable v-success       as logical      no-undo.
     4649   do
     4650   on error undo, return error
     4651   :
     4652       assign
     4653           p-out-string = "":U
     4654           v-position   = 0
     4655       .
     4656       replace-cycle:
     4657       do while yes
     4658       on error undo, return error
     4659       :
     4660           assign
     4661               v-last-position = index( p-in-string, "&":U, v-position + 1 )
     4662           .
     4663           if v-last-position <= v-position
     4664           then do:
     4665               if v-position = 0
     4666               then do:
     4667                   assign
     4668                       p-out-string = p-in-string
     4669                   .
     4670               end.
     4671               else do:
     4672                   assign
     4673                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
     4674                   .
     4675               end.
     4676               leave replace-cycle.
     4677           end.
     4678           else do:
     4679               assign
     4680                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
     4681                   v-position      = v-last-position
     4682                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
     4683               .
     4684               if v-current-char = "#":U
     4685               then do:
     4686                   assign
     4687                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
     4688                   .
     4689                   if v-last-position > 0
     4690                   then do:
     4691                       run xmlchar-read-integer in this-procedure
     4692                        (
     4693                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
     4694                           , output v-temp-integer
     4695                           , output v-success
     4696                       ).
     4697                       if v-success = yes
     4698                       and v-temp-integer >= 1
     4699                       and v-temp-integer <= 255
     4700                       then do:
     4701                           assign
     4702                               p-out-string = p-out-string + chr( v-temp-integer )
     4703                               v-position   = v-last-position + 1
     4704                           .
     4705                       end.
     4706                       else do:
     4707                           assign
     4708                               p-out-string = p-out-string + "&":U
     4709                               v-position   = v-position   + 1
     4710                           .
     4711                       end.
     4712                   end.
     4713                   else do:
     4714                       assign
     4715                           p-out-string = p-out-string + "&":U
     4716                           v-position   = v-position   + 1
     4717                       .
     4718                   end.
     4719               end.
     4720               else do:
     4721                   case substring( p-in-string, v-position + 1, 3 )
     4722                   :
     4723                       when "lt;":U
     4724                       then do:
     4725                           assign
     4726                               p-out-string = p-out-string + "<":U
     4727                               v-position   = v-position   + 3
     4728                           .
     4729                       end.
     4730                       when "gt;":U
     4731                       then do:
     4732                           assign
     4733                               p-out-string = p-out-string + ">":U
     4734                               v-position   = v-position   + 3
     4735                           .
     4736                       end.
     4737                       otherwise do:
     4738                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
     4739                           then do:
     4740                               assign
     4741                                   p-out-string = p-out-string + "&":U
     4742                                   v-position   = v-position   + 4
     4743                               .
     4744                           end.
     4745                           else do:
     4746                               case substring( p-in-string, v-position + 1, 5 )
     4747                               :
     4748                                   when "quot;":U
     4749                                   then do:
     4750                                       assign
     4751                                           p-out-string = p-out-string + '"':U
     4752                                           v-position   = v-position   + 5
     4753                                       .
     4754                                   end.
     4755                                   when "apos;":U
     4756                                   then do:
     4757                                       assign
     4758                                           p-out-string = p-out-string + "'":U
     4759                                           v-position   = v-position   + 5
     4760                                       .
     4761                                   end.
     4762                                   otherwise do:
     4763                                       assign
     4764                                           p-out-string = p-out-string + "&":U
     4765                                       .
     4766                                   end.
     4767                               end case.
     4768                           end.
     4769                       end.
     4770                   end case.
     4771               end.
     4772           end.
     4773       end.
     4774   end.
     4775   end .
     4776   procedure xmlchar-read-integer :
     4777   define input parameter p-input-string      as character        no-undo.
     4778   define output parameter p-output-integer   as integer          no-undo.
     4779   define output parameter p-success       as logical          no-undo.
     4780   do
     4781   on error undo, return error
     4782   :
     4783       assign
     4784           p-output-integer = integer( p-input-string )
     4785       no-error.
     4786       if error-status :error
     4787       then do:
     4788           assign
     4789               p-success           = no
     4790               p-output-integer    = 0
     4791           .
     4792       end.
     4793       else do:
     4794           assign
     4795               p-success           = yes
     4796           .
     4797       end.
     4798   end.
     4799   end.
     4800   define variable mMRCCode  as logical    no-undo.
     4801   define variable mTypeMark as character  no-undo.
     4802   function IS-NeedMark returns logical
     4803   ( input ib-code as integer  ,
     4804     input ib-str as character ):
     4805      define buffer buf_prod-bc-attr for ub.prod-bc-attr.
     4806      find first buf_prod-bc-attr where buf_prod-bc-attr.b-code eq ib-code
     4807                                    and buf_prod-bc-attr.b-str  eq ib-str
     4808                                    and buf_prod-bc-attr.attr-code eq 'mark':U
     4809        no-lock no-error.
     4810      return if available buf_prod-bc-attr then logical(buf_prod-bc-attr.attr-value) else no .
     4811   end.
     4812   function repTegforDm return char
     4813   (iDM as char ):
     4814       define variable vTeglist as character no-undo init "01,02,11,13,17,21,8005,37".
     4815       define variable vteg as character no-undo.
     4816       define variable oDM as character no-undo.
     4817       define variable vi as integer no-undo.
     4818       oDM = iDm.
     4819       do vi = 1 to num-entries(vTeglist):
     4820          vTeg = entry(vi,vTeglist).
     4821          oDM = replace(oDM,"(" + vTeg + ")",vTeg).
     4822       end.
     4823       return oDM.
     4824   end.
     4825   function repSpecSimbforDm return char
     4826   (iDM as char ):
     4827       define variable oDM as character no-undo.
     4828     run
     4829       xmlchar-decode(iDM, output oDM).
     4830     return repTegforDm (oDM).
     4831   end.
     4832   function CheckGtin return logical
     4833   (iGtin as char):
     4834      define variable bar_code as character no-undo.
     4835      define variable vGtin as logical no-undo init "yes".
     4836      if length(iGtin) eq 14
     4837      then do:
     4838         bar_code = substr (iGtin, 1, length (iGtin) - 1).
     4839         run str/chk-sum.p
     4840          (input-output bar_code ) no-error .
     4841         if iGtin ne  bar_code
     4842         then
     4843            vGtin = no.
     4844      end.
     4845      else
     4846         vGtin = no.
     4847      return vgtin.
     4848   end.
     4849   function repSpecSimbforXlm return char
     4850   (iDM as char ):
     4851       iDM = replace(iDM,chr(29),"").
     4852       return iDM.
     4853   end.
     4854   function getGtinByDM return char
     4855   (IDM as char):
     4856      define variable VTXT as char no-undo.
     4857      define variable vGtin as char no-undo.
     4858      vTXt = IdM.
     4859      vGtin = IDM.
     4860      if    length(vtxt) > 14
     4861      then do:
     4862         if   vtxt begins "(01)"
     4863                or vtxt begins "(02)"
     4864         then
     4865            vGtin = substring(vtxt,5,14).
     4866         else if   (vtxt begins "01"
     4867                or vtxt begins "02" )
     4868                and (   (    substring(iDm,17,2) eq "21"
     4869                         and length(vtxt) >= 21)
     4870                     or substring(iDm,17,2) eq "37"
     4871                     or substring(iDm,17,4) eq "(37)" )
     4872         then do:
     4873            vGtin = substring(vtxt,3,14).
     4874            if not checkGtin(vGtin)
     4875            then
     4876               vGtin = substring(vtxt,1,14).
     4877         end.
     4878         else if     length(vtxt) eq 14 + 7 + 4 + 4
     4879             or length(vtxt) eq 14 + 7 + 4
     4880             or length(vtxt) eq 14 + 7
     4881         then
     4882            vGtin = substring(vtxt,1,14).
     4883      end.
     4884      if not checkGtin(vGtin)
     4885      then
     4886         vGtin = "".
     4887      return vgtin.
     4888   end.
     4889   function getGdsCodeByGtin return int
     4890   (iGtin as char):
     4891      define buffer prod-bc  for ub.prod-bc.
     4892      define buffer bar-code for ub.bar-code.
     4893      find first prod-bc where prod-bc.b-str eq iGtin  and prod-bc.bc-on no-lock no-error.
     4894      find first bar-code where bar-code.b-code eq prod-bc.b-code no-lock no-error.
     4895      return if avail bar-code then bar-code.gds-code else ?.
     4896   end.
     4897   function getQntyCodeByGtin return decimal
     4898   (iGtin as char):
     4899      define buffer prod-bc  for ub.prod-bc.
     4900      define buffer bar-code for ub.bar-code.
     4901      find first prod-bc where prod-bc.b-str eq iGtin no-lock no-error.
     4902      find first bar-code where bar-code.b-code eq prod-bc.b-code no-lock no-error.
     4903      return if avail bar-code then bar-code.cli-base-rate else ?.
     4904   end.
     4905   function getGdsCodeByDM return int
     4906   (iDm as char):
     4907      define variable vGtin as char no-undo.
     4908      define buffer prod-bc for ub.prod-bc.
     4909      vGtin  = getGtinByDM (IDM ).
     4910      return getGdsCodeByGtin (vGtin).
     4911   end.
     4912   function ChekTypeMarkByGds return logical
     4913   (iGds-code as integer ):
     4914      define buffer goods-attr for ub.goods-attr.
     4915      find first goods-attr where goods-attr.gds-code   = iGds-code
     4916                              and goods-attr.attr-code  = 'mark-type':U
     4917      no-lock no-error.
     4918      if available goods-attr
     4919      then do:
     4920         mTypeMark = goods-attr.attr-value.
     4921         return goods-attr.attr-value = objsrv:Env:Marking:Types:tabak:NameProp
     4922           .
     4923      end.
     4924      else
     4925         return no.
     4926   end.
     4927   function ChekTypeMarkByDm return logical
     4928   (iDM as char ):
     4929      return ChekTypeMarkByGds(getGdsCodeByDM(idm)).
     4930   end.
     4931   function ChekTypeMarkByGtin return logical
     4932   (iGtin as char ):
     4933      return ChekTypeMarkByGds(getGdsCodeByGtin(iGtin)).
     4934   end.
     4935   function GetNextElement return character
     4936     (input iAllTeg        as logical
     4937     ,output oteg          as character
     4938     ,output otegval       as character
     4939     ,input-output pstr    as character
     4940      ):
     4941        define variable vlistElem   as character no-undo init "00,01,02,21,17,11,13,(01),(02),(21),(17),(11),(13)".
     4942        define variable vlistleng   as character no-undo init "27,14,14,13,06,06,06,0014,0014,0013,0006,0006,0006".
     4943        define variable vlistElemDop   as character no-undo init ",37,(37),(8005),8005,93,(93)".
     4944        define variable vlistlengDop   as character no-undo init ",08,0008,000006,0006,04,0004".
     4945        define variable vTeg as character no-undo.
     4946        define variable vLength as integer no-undo.
     4947        define variable vi as integer no-undo.
     4948        define variable vj as integer no-undo.
     4949        define buffer code for ub.code.
     4950        find first code where Code.parent eq "MarkType"
     4951                          and Code.CodeValue   eq mTypeMark
     4952                          no-lock no-error.
     4953        if     available code
     4954           and Code.misc1 ne ""
     4955           and Code.misc1 ne ?
     4956        then do:
     4957           integer (Code.misc1) no-error.
     4958           if not error-status:error
     4959           then
     4960             entry (4,vlistleng) = Code.misc1.
     4961        end.
     4962        if iAllTeg
     4963        then
     4964           assign
     4965              vlistElem     = vlistElem    + vlistElemDop
     4966              vlistleng     = vlistleng    + vlistlengDop
     4967           .
     4968        else if mMRCCode
     4969        then
     4970           assign
     4971              vlistElem     = vlistElem    + ",(8005),8005"
     4972              vlistleng     = vlistleng    + ",000006,0006"
     4973           .
     4974       block-elem:
     4975       do vi = 1 to num-entries(vlistElem):
     4976          vTeg = entry(vi,vlistElem).
     4977          if pstr begins vTeg
     4978          then do:
     4979             if    vTeg eq "21"
     4980             then
     4981                vLength = index(pstr,chr(29)) - 2 no-error.
     4982             if vLength  <= 0
     4983             then
     4984                vLength = int(entry(vi,vlistleng)).
     4985             otegval = substring (pstr,length(vteg) + 1, vLength).
     4986             oteg = replace(replace(vteg,")",""),"(","").
     4987             vTeg = vteg + otegval.
     4988             otegval = replace(otegval,chr(29),"").
     4989             oteg = replace(replace(oteg,")",""),"(","").
     4990             pstr = substring (pstr,length(vTeg)+ 1).
     4991             vTeg = replace(vTeg,chr(29),"").
     4992             leave block-elem.
     4993          end.
     4994          else
     4995             vTeg = "".
     4996       end.
     4997       return vteg.
     4998   end.
     4999   function GetCodeIdent return character
     5000   (iDm as char):
     5001      define variable Velement   as character no-undo init "first".
     5002      define variable oCodeIdent as character no-undo.
     5003      define variable vteg as character no-undo.
     5004      define variable vtegval as character no-undo.
     5005      define variable vGtin as character no-undo.
     5006      define buffer marking for ub.marking.
     5007      for first marking no-lock where
     5008                marking.mark eq iDm
     5009            and marking.unit-ext = "LEVEL2"
     5010      :
     5011        return iDm.
     5012      end.
     5013      vGtin  = getGtinByDM (iDm ).
     5014      ChekTypeMarkByDm(idm).
     5015      if iDm begins 'tech_':U
     5016      then
     5017         oCodeIdent = iDm.
     5018      else if length(iDm) < 21
     5019      then do:
     5020         find first marking where marking.mark eq idm
     5021         no-lock no-error.
     5022         oCodeIdent = if available marking then marking.mark else  ?.
     5023      end.
     5024      else if     length(iDm) eq 29
     5025         and not iDm begins "01"
     5026         and not iDm begins "02"
     5027      then
     5028         oCodeIdent = substring(iDm,1,if mMRCCode then 25 else 21 ).
     5029      else  if     length(iDm) >= 24
     5030               and (  iDm begins "01"
     5031                   or iDm begins "02")
     5032               and  substring(iDm,17,2) ne "21"
     5033      then do:
     5034         if checkGtin(substring(iDm,1,14)) and ( (length(idm) eq 25 and substring(iDm,22,1) eq "A")
     5035                                                   or (length(idm) eq 29 and substring(iDm,22,1) eq "A"))
     5036         then
     5037            oCodeIdent = substring(iDm,1,if mMRCCode then 25 else 21).
     5038         else
     5039            oCodeIdent = iDM.
     5040      end.
     5041      else  if     (   length(iDm) eq 25
     5042                    or length(iDm) eq 21)
     5043               and (not iDm begins "01"
     5044               and  not iDm begins "02")
     5045      then
     5046         oCodeIdent = substring(iDm,1,21).
     5047      else if vGtin = substring(iDm,1,14) and checkGtin(substring(iDm,1,14)) and ( length(idm) eq 21 or (length(idm) eq 25 and substring(iDm,22,1) eq "A"))
     5048      then
     5049         oCodeIdent = substring(iDm,1,21).
     5050      else do while Velement ne "" and idm ne "":
     5051         Velement = GetNextElement(no,output vteg, output vtegval, input-output idm).
     5052         oCodeIdent = oCodeIdent + Velement.
     5053      end.
     5054      return oCodeIdent.
     5055   end.
     5056   function GetTegCod return character
     5057   (icodeIdent as char, iTeg as char):
     5058      define variable Velement   as character no-undo init "first".
     5059      define variable oTeg as character no-undo init ?.
     5060      define variable vteg as character no-undo.
     5061      define variable vtegval as character no-undo.
     5062      if     ((length(icodeIdent) eq 21
     5063         and not icodeIdent begins "01"
     5064         and not icodeIdent begins "02")
     5065         or
     5066             ( length(icodeIdent) eq 25
     5067               and not icodeIdent begins "01"
     5068               and not icodeIdent begins "02"))
     5069      then do:
     5070         if iTeg eq "01" or iTeg eq "02"
     5071         then
     5072            oTeg = substring(icodeIdent,1,21).
     5073         else  if  iTeg eq "21"
     5074         then
     5075            oTeg = substring(icodeIdent,15,7).
     5076      end.
     5077      else do:
     5078         ChekTypeMarkByDm(icodeIdent).
     5079         block-teg:
     5080            do while Velement ne "" and icodeIdent ne "":
     5081            Velement = GetNextElement(yes,output vteg, output vtegval, input-output icodeIdent).
     5082            if    Velement begins iTeg
     5083               or Velement begins "(" + iTeg + ")"
     5084            then do:
     5085               oTeg = vtegval.
     5086               leave block-teg.
     5087            end.
     5088         end.
     5089      end.
     5090      return oTeg.
     5091   end.
     5092   function isOAD return logical
     5093   (icodeIdent as character):
     5094      return length(icodeIdent) > 18 and GetTegCod(icodeIdent,"37") ne ? and GetTegCod(icodeIdent,"02") ne ?.
     5095   end.
     5096   function isMark return logical
     5097   (icodeIdent as character):
     5098      define buffer buf_marking for ub.marking.
     5099      return can-find(first buf_marking where buf_marking.mark begins icodeIdent) or
     5100             (length(icodeIdent) > 20 and not isOAD(icodeIdent)).
     5101   end.
     5102   function addBracketForCode return character
     5103   (icodeIdent as char):
     5104      define variable Velement   as character no-undo init "first".
     5105      define variable oTeg as character no-undo.
     5106      define variable vteg as character no-undo.
     5107      define variable vtegval as character no-undo.
     5108      define buffer marking for ub.marking.
     5109      find first marking no-lock where
     5110                 marking.mark begins icodeIdent no-error.
     5111      if    not ChekTypeMarkByDm(icodeIdent)
     5112         or length(icodeIdent) le 24
     5113         or (avail marking and marking.unit-ext = "LEVEL2")
     5114      then
     5115         oTeg = icodeIdent.
     5116      else do:
     5117         if (  icodeIdent begins "01"
     5118            or icodeIdent begins "02"
     5119            ) and CheckGtin(substring (icodeIdent,3,14))
     5120            and substring (icodeIdent,17,2) eq "21"
     5121         then do:
     5122            mMRCCode = yes.
     5123            ChekTypeMarkByDm(icodeIdent).
     5124            block-teg:
     5125            do while Velement ne "" and icodeIdent ne "":
     5126               Velement = GetNextElement(no,output vteg, output vtegval, input-output icodeIdent).
     5127               if vteg ne ""
     5128               then
     5129                  oTeg = oTeg + "(" + vteg + ")" + vtegval .
     5130            end.
     5131            mMRCCode = no.
     5132         end.
     5133         else do:
     5134            oTeg = icodeIdent.
     5135         end.
     5136      end.
     5137      return oTeg.
     5138   end.
     5139   function getlevelByCodId return int
     5140   (iCode as char):
     5141      define variable vLength as int no-undo.
     5142      define variable vLevel  as int no-undo.
     5143      if not ChekTypeMarkByDM (icode) then return ?.
     5144      vLength = length(iCode).
     5145      if    vLength eq 18
     5146         or vLength eq 20
     5147      then
     5148         Vlevel = 4.
     5149      else if vLength eq 21
     5150      then
     5151         Vlevel = 1.
     5152      else if vLength eq 25
     5153      then do:
     5154         if  iCode begins "01"
     5155         then
     5156            Vlevel = 3.
     5157         else
     5158            Vlevel = 1.
     5159      end.
     5160      else if     vLength >= 26
     5161              and vLength <= 46
     5162      then do:
     5163         if    substring(iCode,17,2) eq "11"
     5164            or substring(iCode,17,2) eq "13"
     5165            or (    substring(iCode,17,2) eq "21"
     5166                and vLength >= 33
     5167                and substring(iCode,26,4) ne "8005")
     5168         then
     5169            Vlevel = 4.
     5170         else if    vLength eq 31
     5171                 or vLength eq 38
     5172                 or vLength eq 39
     5173                 or vLength eq 45
     5174         then
     5175            Vlevel = 1.
     5176         else if    vLength eq 35
     5177                 or vLength eq 43
     5178         then
     5179            Vlevel = 3.
     5180         else
     5181            Vlevel = ?.
     5182      end.
     5183      else
     5184         Vlevel = ?.
     5185      return Vlevel.
     5186   end.
     5187   function getLevelMotpBycodid return character
     5188   (iDm as char):
     5189      define variable vLevel as integer no-undo.
     5190      define variable vList as character no-undo init "Unit,kin,Level1,Level2,Level3,Level4,Level5".
     5191      vLevel = getlevelByCodId(iDm).
     5192      if    vLevel eq ?
     5193         or vLevel < 1
     5194         or vLevel > 6
     5195      then
     5196         return ?.
     5197      else
     5198         return entry(vlevel,vList).
     5199   end.
     5200   function getLevelUTDByLevelMotp return character
     5201   (iUnit as char):
     5202      define variable vLevel as integer no-undo.
     5203      define variable vListMOTP    as character no-undo init "Unit,kin,Level1,Level2,Level3,Level4,Level5".
     5204      define variable vListutd as character no-undo init "КИ,КИН,КИГУ,КИТУ".
     5205      vLevel = lookup(iUnit,vListMOTP).
     5206      if    vLevel eq ?
     5207         or vLevel < 1
     5208         or vLevel > 4
     5209      then
     5210         return ?.
     5211      else
     5212         return entry(vlevel,vListutd).
     5213   end.
     5214   function getLevelMotpByDM return character
     5215   (iDm as char):
     5216      return getLevelMotpByCodId(GetCodeIdent(iDm)).
     5217   end.
     5218   function getLevelUTDByCodId return character
     5219   (iDm as char):
     5220      define variable vLevel as integer no-undo.
     5221      define variable vList as character no-undo init "КИ,КИН,КИГУ,КИТУ".
     5222      vLevel = getlevelByCodId(iDm).
     5223      if    vLevel eq ?
     5224         or vLevel < 1
     5225         or vLevel > 4
     5226      then
     5227         return ?.
     5228      else
     5229         return entry(vlevel,vList).
     5230   end.
     5231   function getLevelUTDByDM return character
     5232   (iDm as char):
     5233      return getLevelUTDByCodId(GetCodeIdent(iDm)).
     5234   end.
     5235   define variable mNotMarkQnty as logical no-undo.
     5236   function getQntyUTDByCodId return decimal
     5237   (iDM as char):
     5238      define variable vLevel as integer no-undo.
     5239      define variable vList as character no-undo init "1,5,10,500".
     5240      define variable vGtin as character no-undo.
     5241      define variable vqnty as decimal no-undo init ?.
     5242      vqnty = dec(GetTegCod(iDM,"37")) no-error.
     5243      if vqnty eq ?
     5244      then do:
     5245         if not mNotMarkQnty
     5246         then do:
     5247            define buffer marking for ub.marking.
     5248            define variable vCodident as character no-undo.
     5249            vCodident = GetCodeIdent(idm).
     5250            find first marking where marking.mark begins vCodident no-lock no-error.
     5251            if     available marking
     5252               and marking.box-qnty ne ?
     5253            then
     5254               return marking.box-qnty.
     5255         end.
     5256         vGtin = getGtinByDm(iDM).
     5257         if ChekTypeMarkByGtin (vGtin)
     5258         then do:
     5259            vLevel = getlevelByCodId(iDM).
     5260            if     vLevel >= 1
     5261               and vLevel <= 4
     5262            then
     5263               vqnty = int(entry(vlevel,vList)).
     5264         end.
     5265         else
     5266            vqnty = getQntyCodeByGtin(vgtin).
     5267      end.
     5268      return vqnty.
     5269   end.
     5270   function getQntyUTDByDM return decimal
     5271   (iDm as char):
     5272      define variable vDM as character no-undo.
     5273      if     length (iDm) ne 25
     5274         and length (iDm) ne 29
     5275         and substring (iDm,length (iDm) - 6 + 1, 2 ) eq "93"
     5276      then
     5277         vDM = substring (iDm,1,length (iDm) - 6 ).
     5278      else
     5279         vDM = substring (iDm,1,length (iDm) - 4 ).
     5280      return getQntyUTDByCodId(vDM).
     5281   end.
     5282   function getMRC4 return decimal
     5283   (iMRC as char):
     5284      define variable oMrc     as decimal no-undo init ?.
     5285      define variable vAlphabet as character no-undo init "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789!~"%&'*+-./_,:;=<>?".
     5286      define variable vi       as integer no-undo.
     5287      define variable vfound   as integer no-undo.
     5288      define variable vposStart   as integer no-undo.
     5289      do:
     5290      OMRc = 0.
     5291      do vi = 1 to 4:
     5292         define variable vsimb as character no-undo.
     5293         vsimb = substring(iMRC,vi,1).
     5294         vposStart = if keycode("Z") < keycode(vsimb) then 27 else 1.
     5295         vfound = index(vAlphabet,vsimb,vposStart) - 1.
     5296         if vfound > 0
     5297         then
     5298            OMRc = OMRc + exp (80,(4 - vi) ) * vfound  .
     5299         end.
     5300         OMRc = OMRc / 100.
     5301      end.
     5302      return OMRc.
     5303   end.
     5304   function getMRCByDM return decimal
     5305   (iDm as char):
     5306      define variable vMRC     as character no-undo.
     5307      define variable oMrc     as decimal no-undo init ?.
     5308      define variable Velement as character no-undo init "empty".
     5309      define variable vteg as character no-undo.
     5310      define variable vtegval as character no-undo.
     5311      if    length(idm) eq 14 + 7 + 4 + 4
     5312         or length(idm) eq 14 + 7 + 4
     5313      then do:
     5314         vMRC = substring(idm,22,4).
     5315         omrc = getMRC4(vMRC).
     5316      end.
     5317      else do:
     5318          ChekTypeMarkByDm(iDm).
     5319          block-mrc:
     5320          do while Velement ne "" and idm ne "":
     5321             Velement = GetNextElement(yes,output vteg, output vtegval, input-output idm).
     5322             if Velement begins "8005"
     5323             then do:
     5324                vMRC = substring(Velement,5,6).
     5325                leave block-mrc.
     5326             end.
     5327             else if Velement begins "(8005)"
     5328             then do:
     5329                vMRC = substring(Velement,7,6).
     5330                leave block-mrc.
     5331             end.
     5332          end.
     5333          if vMRC ne ""
     5334          then
     5335             OMRc = dec(vmrc) / 100 no-error.
     5336      end.
     5337      return OMRc.
     5338   end.
     5339   function MoveDate return Date
     5340   (idate as date,
     5341    iMonth as int64):
     5342      define variable vMonth   as int64 no-undo.
     5343      define variable vYear    as int64 no-undo.
     5344      define variable vDateNew as date  no-undo.
     5345       define variable vDay     as int64 no-undo.
     5346       vMonth = month(iDate) + iMonth.
     5347       vYear =  year(iDate).
     5348       if vMonth <= 0
     5349       then assign
     5350          vMonth = vMonth + 12
     5351           vYear  = vYear - 1
     5352       .
     5353       else if vMonth > 12
     5354       then assign
     5355          vMonth = vMonth - 12
     5356           vYear  = vYear + 1
     5357       .
     5358       vDateNew = date(vMonth,day(iDate),vYear) no-error.
     5359       do while error-status:error eq yes:
     5360          VDay = vDay + 1.
     5361          vDateNew = date(vMonth,day(iDate) - vDay,vYear) no-error.
     5362       end.
     5363       if VDay > 0
     5364       then
     5365          vDateNew + 1.
     5366       return vDateNew.
     5367   end.
     5368   procedure checkEMRC:
     5369   define input  parameter iDm as character no-undo.
     5370   define output parameter vok as logical   no-undo init yes.
     5371      define variable v-value-emrc as character no-undo.
     5372      define variable v-type-emrc  as character no-undo.
     5373      define variable vDateIso     as character no-undo.
     5374      define variable vMRC         as decimal no-undo.
     5375      define variable vqnty        as decimal no-undo.
     5376      define variable vPrice       as decimal no-undo.
     5377      define variable vparent      as character no-undo.
     5378      define variable vgds-code    as integer no-undo.
     5379      define buffer code for ub.code.
     5380      vMRC = getMRCByDM(iDm).
     5381      if vMRC > 0
     5382      then do:
     5383         vgds-code = getGdsCodeByDM(iDm).
     5384         vqnty     = getQntyUTDByDM(iDm).
     5385               if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     5386            (
     5387             input   vgds-code
     5388            ,input   'emrc-type':U
     5389            ,output   v-value-emrc
     5390            ,output   v-type-emrc
     5391          ) no-error.
     5392          if     v-value-emrc ne ""
     5393             and v-value-emrc ne ?
     5394          then do:
     5395             vDateIso = iso-date(today).
     5396             vPrice = vMRC / vqnty.
     5397             vparent ="emc" + chr(4) + v-value-emrc.
     5398             find last code where Code.parent      eq vparent
     5399                              and Code.code        le vDateIso
     5400                              and code.status_  eq 0
     5401             no-lock no-error.
     5402             if not available code or ( vPrice  >= dec(Code.CodeValue))
     5403             then
     5404                vOk = true .
     5405             else do:
     5406                 define variable vText      as character no-undo.
     5407                 define variable vDate      as date no-undo.
     5408                 define variable vDateLast  as character no-undo.
     5409                 define variable vDateFirst as character no-undo.
     5410                 define variable vDate3     as date no-undo.
     5411                 vdate = date(code.misc1).
     5412                 vDateLast = code.misc1.
     5413                 vDate3 = MoveDate(today, - 3 ).
     5414                 vText =  substitute ("ТОВАР ИМЕЕТ ОГРАНИЧЕННЫЙ СРОК РЕАЛИЗАЦИИ. Если товар произведен после &2, то его приемка и продажа запрещена.",
     5415                                      string(vDate3  , "99/99/9999"),
     5416                                      string(vDate   , "99/99/9999")
     5417                                      ).
     5418                 vdateIso = iso-date(vdate3).
     5419                 find last code  where Code.parent      eq vparent
     5420                                   and Code.code        le vDateIso
     5421                                   and code.status_  eq 0 no-lock no-error.
     5422                 if available code
     5423                 then
     5424                    vDateIso = code.code.
     5425                 vDateFirst = vDateIso.
     5426                 vDateLast = iso-date(vdate).
     5427                 define variable vGood as logical no-undo.
     5428                 define variable vDateSale as date no-undo.
     5429                 define buffer bcode for code.
     5430                 for last code where Code.parent   eq vparent
     5431                                 and code.status_  eq 0
     5432                                 and code.code     < vDateLast
     5433                                 and code.code     >= vDateFirst
     5434                 no-lock:
     5435                    find first bcode where bCode.parent   eq vparent
     5436                                       and bcode.status_  eq 0
     5437                                       and bcode.code     > code.code no-lock no-error.
     5438                    if available bcode
     5439                    then do:
     5440                       if vPrice < dec(Code.CodeValue)
     5441                       then
     5442                          vText = vtext + substitute ("&1Если товар произведен с &2 до &3, ТО ЕГО ПРИЕМКА И ПРОДАЖА ЗАПРЕЩЕНА",
     5443                                                     chr(10),
     5444                                                     string(    date( code.misc1)       ,"99/99/9999"),
     5445                                                     string(    date(bcode.misc1)       ,"99/99/9999")
     5446                                                     ).
     5447                       else do:
     5448                          vGood = yes.
     5449                          vDateSale = MoveDate(date(bcode.misc1), 3) - 1.
     5450                          vText = vtext + substitute ("&1Если товар произведен до &3, то продажа разрешена до &4.~Осталось &5 дней.",
     5451                                                     chr(10),
     5452                                                     string(    date( code.misc1)         ,"99/99/9999"),
     5453                                                     string(    date(bcode.misc1)         ,"99/99/9999"),
     5454                                                     string(         vDateSale            ,"99/99/9999"),
     5455                                                     string(vDateSale - today)
     5456                                                     ).
     5457                       end.
     5458                    end.
     5459                 end.
     5460                 if vgood
     5461                 then do:
     5462                    define variable choice as integer no-undo .
     5463                    run gbl/d-askw.w (input "Уточнение"
     5464                           ,input  vText
     5465                           ,input "|"
     5466                           ,input "Принять|Вернуть"
     5467                           ,input "Принять данный товар|Вернуть товар постащику"
     5468                           ,input 1
     5469                           ,input 2
     5470                           ,output choice) no-error.
     5471                    vok = choice eq 1.
     5472                 end.
     5473                 else
     5474                    vok =false.
     5475             end.
     5476          end.
     5477      end.
     5478   end.
     5479   function addGs2Mark return character
     5480   (iMark as char):
     5481      define variable vDM   as character no-undo.
     5482      define variable vIdx  as integer   no-undo.
     5483      if index(iMark,chr(29),1) > 0
     5484      then return iMark.
     5485      if substring(iMark,26,4) = "8005" then
     5486      do:
     5487        vIdx = index(iMark,"93",26 + 4 + 5).
     5488        if vIdx > 1 then do:
     5489          vDM = substitute("&1&4&2&4&3",
     5490                           substring(iMark,1,25),
     5491                           substring(iMark,26,vIdx - 25 - 1),
     5492                           substring(iMark,vIdx),
     5493                           chr(29)) no-error.
     5494          vIdx = index(vDm,"240",vIdx + 4).
     5495          if vIdx > 0 then
     5496          do:
     5497            vDM = substitute("&1&3&2",
     5498                             substring(vDm,1,vIdx - 1),
     5499                             substring(vDm,vIdx),
     5500                             chr(29)) no-error.
     5501          end.
     5502        end.
     5503        else
     5504          vDM = substitute("&1&3&2",
     5505                           substring(iMark,1,25),
     5506                           substring(iMark,26),
     5507                           chr(29)) no-error.
     5508      end.
     5509      else if substring(iMark,32,2) = "91" then
     5510      do:
     5511        vIdx = index(iMark,"92",32).
     5512        if vIdx > 1 then
     5513          vDM = substitute("&1&4&2&4&3",
     5514                           substring(iMark,1,31),
     5515                           substring(iMark,32,vIdx - 31 - 1),
     5516                           substring(iMark,vIdx),
     5517                           chr(29)) no-error.
     5518        else
     5519          vDM = substitute("&1&3&2",
     5520                           substring(iMark,1,31),
     5521                           substring(iMark,32),
     5522                           chr(29)) no-error.
     5523      end.
     5524      else if substring(iMark,39,2) = "91" then
     5525      do:
     5526        vIdx = index(iMark,"92",38).
     5527        if vIdx > 1 then
     5528          vDM = substitute("&1&4&2&4&3",
     5529                           substring(iMark,1,38),
     5530                           substring(iMark,39,vIdx - 38 - 1),
     5531                           substring(iMark,vIdx),
     5532                           chr(29)) no-error.
     5533        else
     5534          vDM = substitute("&1&3&2",
     5535                           substring(iMark,1,38),
     5536                           substring(iMark,39),
     5537                           chr(29)) no-error.
     5538      end.
     5539      else if substring(iMark,25,2) = "93" then
     5540      do:
     5541        vIdx = index(iMark,"92",25).
     5542        if vIdx > 1 then
     5543          vDM = substitute("&1&4&2&4&3",
     5544                           substring(iMark,1,24),
     5545                           substring(iMark,25,vIdx - 24 - 1),
     5546                           substring(iMark,vIdx),
     5547                           chr(29)) no-error.
     5548        else
     5549          vIdx = index(iMark,"3103",25).
     5550          if vIdx > 0 then
     5551          vDM = substitute("&1&4&2&4&3",
     5552                           substring(iMark,1,24),
     5553                           substring(iMark,25,vIdx - 24 - 1),
     5554                           substring(iMark,vIdx),
     5555                           chr(29)) no-error.
     5556          else
     5557            vDM = substitute("&1&3&2",
     5558                             substring(iMark,1,24),
     5559                             substring(iMark,25),
     5560                             chr(29)) no-error.
     5561      end.
     5562      else if substring(iMark,32,2) = "93" then
     5563      do:
     5564        vDM = substitute("&1&3&2",
     5565              substring(iMark,1,31),
     5566              substring(iMark,32),
     5567              chr(29)) no-error.
     5568      end.
     5569      return if vDM <> "" then vDm else iMark.
     5570   end.
     5571   def var vss-include-info34 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5572   procedure gen-key-rec :
     5573     define input  parameter p-tbl-name    as character no-undo.
     5574     define input  parameter p-bh_tbl-name as handle    no-undo.
     5575     define output parameter p-key-rec     as character no-undo.
     5576     do
     5577     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     5578     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
     5579     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
     5580     :
     5581       define variable fh               as handle    no-undo .
     5582       define variable v-ok             as logical   no-undo .
     5583       define variable v-inform         as character no-undo .
     5584       define variable v-ind            as integer   no-undo .
     5585       define variable v-idx-field-qnty as integer   no-undo .
     5586       if p-tbl-name = ?
     5587         or p-tbl-name = "":U
     5588       then do:
     5589         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info34 ).
     5590       end.
     5591       if not p-bh_tbl-name:available then do:
     5592         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info34, p-tbl-name ).
     5593       end.
     5594       assign
     5595         p-key-rec = p-tbl-name
     5596         v-inform  = p-bh_tbl-name:index-information(1)
     5597         v-ind     = 2
     5598       .
     5599       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     5600       on error undo, return error
     5601       :
     5602         assign
     5603           v-inform = p-bh_tbl-name:index-information( v-ind )
     5604           v-ind    = v-ind + 1
     5605         .
     5606       end.
     5607       if v-inform = ?
     5608         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     5609         or entry( 3, v-inform, ",":U ) <> "1":U
     5610       then do:
     5611         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info34, p-tbl-name ).
     5612       end.
     5613       else do:
     5614         assign
     5615           v-idx-field-qnty = num-entries( v-inform ) - 4
     5616         .
     5617         if v-idx-field-qnty < 2 then do:
     5618           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info34, v-inform, p-tbl-name ).
     5619         end.
     5620         do v-ind = 1 to v-idx-field-qnty by 2
     5621         on error undo, return error
     5622         :
     5623           assign
     5624             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
     5625             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
     5626           .
     5627         end.
     5628       end.
     5629       if p-key-rec = ? then do:
     5630         assign
     5631           p-key-rec = "":U
     5632         .
     5633         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info34, p-tbl-name ).
     5634       end.
     5635     end.
     5636     return.
     5637   end procedure.
     5638   procedure gen-where-keyr-tab :
     5639     define input  parameter i-tableSerach as character no-undo.
     5640     define input  parameter i-tablekey   as character  no-undo.
     5641     define input  parameter p-key-rec    as character  no-undo.
     5642     define input  parameter p-key-handle as handle     no-undo .
     5643     define input  parameter p-db-name    as character  no-undo .
     5644     define input  parameter p-tt-handle  as handle     no-undo .
     5645     define output parameter o-Where      as character  no-undo.
     5646     do
     5647     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     5648     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     5649     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
     5650     :
     5651       define variable v-full-tbl-name  as character no-undo .
     5652       define variable bh_tbl-name      as handle    no-undo .
     5653       define variable fh_key           as handle    no-undo .
     5654       define variable fh_search        as handle    no-undo .
     5655       define variable v-field-num      as integer   no-undo .
     5656       define variable v-count-fld      as integer   no-undo .
     5657       define variable v-inform         as character no-undo .
     5658       define variable v-ind            as integer   no-undo .
     5659       define variable v-idx-field-qnty as integer   no-undo .
     5660       define variable v-field-name     as character no-undo .
     5661       define variable v-field-val      as character no-undo .
     5662       define variable v-word-link      as character no-undo .
     5663       define variable vTable           as character no-undo.
     5664       define variable bh_tbl-key       as handle    no-undo .
     5665       assign
     5666         p-key-rec = trim( p-key-rec )
     5667       .
     5668       if p-key-handle <> ? then do:
     5669         if not valid-handle(p-key-handle)
     5670            or p-key-handle:type <> "buffer"
     5671         then do:
     5672           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info34 ).
     5673         end.
     5674         if num-entries( p-key-rec, chr(3) ) > 1
     5675           or p-key-rec = ?
     5676           or p-key-rec = "":U
     5677         then do:
     5678           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info34, p-key-rec ).
     5679         end.
     5680       end.
     5681       else do:
     5682         if p-key-rec = ?
     5683           or p-key-rec = "":U
     5684         then do:
     5685           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info34 ).
     5686         end.
     5687       end.
     5688       assign
     5689         vTable = entry( 1 , p-key-rec, chr(3) )
     5690       .
     5691       if p-tt-handle <> ?
     5692         and ( not valid-handle(p-tt-handle)
     5693               or p-tt-handle:type <> "buffer"
     5694             )
     5695       then do:
     5696         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info34, vTable, chr(10) ).
     5697       end.
     5698       if p-tt-handle = ? then do:
     5699         assign
     5700           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
     5701         .
     5702         create buffer bh_tbl-name for table v-full-tbl-name .
     5703       end.
     5704       else do:
     5705         create buffer bh_tbl-name for table p-tt-handle:table-handle .
     5706       end.
     5707       assign
     5708         v-inform = bh_tbl-name:index-information(1)
     5709         v-ind    = 2
     5710       .
     5711       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     5712       on error undo, return error
     5713       :
     5714         assign
     5715           v-inform = bh_tbl-name:index-information( v-ind )
     5716           v-ind    = v-ind + 1
     5717         .
     5718       end.
     5719       if v-inform = ?
     5720         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     5721         or entry( 3, v-inform, ",":U ) <> "1":U
     5722       then do:
     5723         delete object bh_tbl-name no-error.
     5724         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info34, vTable ).
     5725       end.
     5726       assign
     5727         v-idx-field-qnty = num-entries( v-inform ) - 4
     5728       .
     5729       if v-idx-field-qnty < 2 then do:
     5730         delete object bh_tbl-name no-error.
     5731         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info34, v-inform, vTable ).
     5732       end.
     5733       assign
     5734         o-where     = "where":U
     5735         v-word-link = "":U
     5736         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
     5737         v-count-fld = 0
     5738       .
     5739       if i-tablekey ne "" and i-tablekey ne ?
     5740       then do:
     5741         assign
     5742           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
     5743         .
     5744         create buffer bh_tbl-key for table v-full-tbl-name .
     5745       end.
     5746       if i-tableSerach ne "" and i-tableSerach ne ?
     5747       then do:
     5748         delete object bh_tbl-name no-error.
     5749         assign
     5750           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
     5751         .
     5752         create buffer bh_tbl-name for table v-full-tbl-name .
     5753       end.
     5754       block_where:
     5755       do v-ind = 1 to v-idx-field-qnty by 2
     5756       on error undo, return error
     5757       :
     5758         assign
     5759           v-count-fld = v-count-fld + 1
     5760         .
     5761         if p-key-handle = ?
     5762           and v-count-fld > v-field-num
     5763         then do:
     5764           leave block_where.
     5765         end.
     5766         define variable VfieldKeyTable as handle no-undo.
     5767         assign
     5768           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     5769           fh_search    = bh_tbl-name:buffer-field( v-field-name )
     5770         .
     5771         if     bh_tbl-key ne ?
     5772         then do:
     5773            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
     5774            if VfieldKeyTable eq ?
     5775            then next block_where.
     5776         end.
     5777         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
     5778         then
     5779            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
     5780         else
     5781            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
     5782         if p-key-handle = ? then do:
     5783           assign
     5784             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
     5785           .
     5786         end.
     5787         else do:
     5788           assign
     5789             fh_key = p-key-handle:buffer-field( v-field-name )
     5790           .
     5791           if fh_key = ?
     5792             or not valid-handle( fh_key )
     5793           then do:
     5794             delete object bh_tbl-name.
     5795             if     bh_tbl-key ne ?
     5796             then
     5797                delete object bh_tbl-key.
     5798             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info34, p-key-handle:name, v-field-name ).
     5799           end.
     5800           assign
     5801             v-field-val = fh_key:buffer-value
     5802           .
     5803         end.
     5804         if fh_search:data-type ="character":U then do:
     5805           assign
     5806             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
     5807             v-field-val = replace( v-field-val, '"':U, '~~"':U )
     5808             v-field-val = replace( v-field-val, "'":U, "~~'":U )
     5809             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
     5810             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
     5811             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
     5812             v-field-val = replace( v-field-val, chr(10), '~~n':U )
     5813             v-field-val = replace( v-field-val, chr(9), '~~t':U )
     5814             v-field-val = replace( v-field-val, chr(13), '~~r':U )
     5815             v-field-val = replace( v-field-val, chr(27), '~~E':U )
     5816             v-field-val = replace( v-field-val, chr(8), '~~b':U )
     5817             v-field-val = replace( v-field-val, chr(12), '~~f':U )
     5818             v-field-val = substitute( '"&1"', v-field-val )
     5819           .
     5820         end.
     5821         assign
     5822           o-where = substitute( "&1 &2", o-where, v-field-val )
     5823         .
     5824         if v-word-link = "":U then do:
     5825           assign
     5826             v-word-link = "and":U
     5827           .
     5828         end.
     5829       end.
     5830       delete object bh_tbl-name.
     5831       if     bh_tbl-key ne ?
     5832       then
     5833          delete object bh_tbl-key.
     5834       if p-key-handle = ?
     5835         and v-count-fld <> v-field-num
     5836       then do:
     5837         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info34, vTable ).
     5838       end.
     5839     end.
     5840   end procedure.
     5841   procedure gen-hn-keyr-tab :
     5842     define input  parameter i-tableSerach as character no-undo.
     5843     define input  parameter i-tablekey   as character no-undo.
     5844     define input  parameter p-key-rec    as character no-undo.
     5845     define input  parameter p-key-handle as handle    no-undo .
     5846     define input  parameter p-db-name    as character no-undo .
     5847     define input  parameter p-tt-handle  as handle    no-undo .
     5848     define input  parameter p-stts-lock  as integer   no-undo .
     5849     define output parameter o-hn         as handle    no-undo.
     5850     define variable v-full-tbl-name as character no-undo.
     5851     define variable v-where         as character no-undo.
     5852     define variable bh_tbl-name     as handle    no-undo.
     5853     define variable vTable          as character no-undo.
     5854     do
     5855     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     5856     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     5857     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
     5858         run gen-where-keyr-tab(i-tableSerach,
     5859                                i-tablekey,
     5860                                p-key-rec,
     5861                                p-key-handle,
     5862                                p-db-name,
     5863                                p-tt-handle,
     5864                                output v-where).
     5865         if i-tableSerach ne "" and i-tableSerach ne ?
     5866         then do:
     5867            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
     5868            create buffer bh_tbl-name for table v-full-tbl-name .
     5869         end.
     5870         else do:
     5871            if p-tt-handle = ? then do:
     5872               assign
     5873                  vTable = entry( 1 , p-key-rec, chr(3) )
     5874               .
     5875               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
     5876               create buffer bh_tbl-name for table v-full-tbl-name .
     5877            end.
     5878            else do:
     5879               create buffer bh_tbl-name for table p-tt-handle:table-handle .
     5880            end.
     5881         end.
     5882         if p-tt-handle = ? then do:
     5883            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
     5884         end.
     5885         else do:
     5886            bh_tbl-name:find-first( v-where ) no-error .
     5887         end.
     5888         o-hn = bh_tbl-name.
     5889      end.
     5890   end procedure.
     5891   procedure gen-hn-keyr :
     5892     define input  parameter p-key-rec    as character no-undo.
     5893     define input  parameter p-key-handle as handle    no-undo .
     5894     define input  parameter p-db-name    as character no-undo .
     5895     define input  parameter p-tt-handle  as handle    no-undo .
     5896     define input  parameter p-stts-lock  as integer   no-undo .
     5897     define output parameter o-hn         as handle    no-undo.
     5898     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
     5899   end.
     5900   procedure gen-row-keyr :
     5901     define input  parameter p-key-rec    as character no-undo.
     5902     define input  parameter p-key-handle as handle    no-undo .
     5903     define input  parameter p-db-name    as character no-undo .
     5904     define input  parameter p-tt-handle  as handle    no-undo .
     5905     define input  parameter p-stts-lock  as integer   no-undo .
     5906     define output parameter p-tbl-row    as rowid     no-undo.
     5907     define output parameter p-tbl-name   as character no-undo.
     5908     define variable vHn as handle no-undo.
     5909       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
     5910       p-tbl-row = if vHn:available then vHn:rowid else ?.
     5911       p-tbl-name =  vHn:table.
     5912       delete object vHn no-error.
     5913     if p-tbl-row = ? then do:
     5914       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info34, p-tbl-name, p-key-rec ).
     5915     end.
     5916     else do:
     5917       return.
     5918     end.
     5919   end procedure.
     5920   procedure gen-key-fv :
     5921     define input  parameter p-key-rec    as character no-undo .
     5922     define output parameter p-field-list as character no-undo .
     5923     define output parameter p-value-list as character no-undo.
     5924     do
     5925     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     5926     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     5927     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     5928     :
     5929       define variable v-full-tbl-name  as character no-undo .
     5930       define variable bh_tbl-name      as handle    no-undo .
     5931       define variable v-tbl-name       as character no-undo .
     5932       define variable v-field-num      as integer   no-undo .
     5933       define variable v-count-fld      as integer   no-undo .
     5934       define variable v-inform         as character no-undo .
     5935       define variable v-ind            as integer   no-undo .
     5936       define variable v-idx-field-qnty as integer   no-undo .
     5937       define variable v-delim-key      as character no-undo .
     5938       if p-key-rec = ?
     5939         or p-key-rec = "":U
     5940       then do:
     5941         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info34 ).
     5942       end.
     5943       assign
     5944         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
     5945         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     5946       .
     5947       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     5948       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info34 ).
     5949       assign
     5950         v-inform = bh_tbl-name:index-information(1)
     5951         v-ind    = 2
     5952       .
     5953       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     5954       on error undo, return error
     5955       :
     5956         assign
     5957           v-inform = bh_tbl-name:index-information( v-ind )
     5958           v-ind    = v-ind + 1
     5959         .
     5960       end.
     5961       if v-inform = ?
     5962         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     5963         or entry( 3, v-inform, ",":U ) <> "1":U
     5964       then do:
     5965         delete object bh_tbl-name no-error.
     5966         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info34, v-tbl-name ).
     5967       end.
     5968       assign
     5969         v-idx-field-qnty = num-entries( v-inform ) - 4
     5970       .
     5971       if v-idx-field-qnty < 2 then do:
     5972         delete object bh_tbl-name no-error.
     5973         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info34, v-inform, v-tbl-name ).
     5974       end.
     5975       assign
     5976         p-field-list = "":U
     5977         p-value-list = "":U
     5978         v-delim-key  = "":U
     5979         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
     5980         v-count-fld  = 0
     5981       .
     5982       block_where:
     5983       do v-ind = 1 to v-idx-field-qnty by 2
     5984       on error undo, return error
     5985       :
     5986         assign
     5987           v-count-fld = v-count-fld + 1
     5988         .
     5989         if v-count-fld > v-field-num then do:
     5990           leave block_where.
     5991         end.
     5992         assign
     5993           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
     5994           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
     5995         .
     5996         if v-ind = 1 then do:
     5997           assign
     5998             v-delim-key = chr(3)
     5999           .
     6000         end.
     6001       end.
     6002       delete object bh_tbl-name.
     6003       if v-count-fld <> v-field-num then do:
     6004         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info34, v-tbl-name ).
     6005       end.
     6006     end.
     6007   end procedure.
     6008   procedure gen-key-field :
     6009     define input  parameter p-table      as character no-undo .
     6010     define output parameter p-field-list as character no-undo .
     6011     do
     6012     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     6013     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     6014     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     6015     :
     6016       define variable v-full-tbl-name  as character no-undo .
     6017       define variable bh_tbl-name      as handle    no-undo .
     6018       define variable v-tbl-name       as character no-undo .
     6019       define variable v-field-num      as integer   no-undo .
     6020       define variable v-count-fld      as integer   no-undo .
     6021       define variable v-inform         as character no-undo .
     6022       define variable v-ind            as integer   no-undo .
     6023       define variable v-idx-field-qnty as integer   no-undo .
     6024       define variable v-delim-key      as character no-undo .
     6025       if p-table = ?
     6026         or p-table = "":U
     6027       then do:
     6028         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info34 ).
     6029       end.
     6030       assign
     6031         v-tbl-name      = p-table
     6032         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     6033       .
     6034       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     6035       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info34 ).
     6036       assign
     6037         v-inform = bh_tbl-name:index-information(1)
     6038         v-ind    = 2
     6039       .
     6040       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     6041       on error undo, return error
     6042       :
     6043         assign
     6044           v-inform = bh_tbl-name:index-information( v-ind )
     6045           v-ind    = v-ind + 1
     6046         .
     6047       end.
     6048       if v-inform = ?
     6049         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     6050         or entry( 3, v-inform, ",":U ) <> "1":U
     6051       then do:
     6052         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info34, v-tbl-name ).
     6053       end.
     6054       assign
     6055         v-idx-field-qnty = num-entries( v-inform ) - 4
     6056       .
     6057       if v-idx-field-qnty < 2 then do:
     6058         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info34, v-inform, v-tbl-name ).
     6059       end.
     6060       assign
     6061         p-field-list = "":U
     6062         v-delim-key  = "":U
     6063         v-count-fld  = 0
     6064       .
     6065       block_where:
     6066       do v-ind = 1 to v-idx-field-qnty by 2
     6067       on error undo, return error
     6068       :
     6069         assign
     6070           v-count-fld = v-count-fld + 1
     6071         .
     6072         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
     6073         if v-ind = 1 then do:
     6074           assign
     6075             v-delim-key = chr(3)
     6076           .
     6077         end.
     6078       end.
     6079       delete object bh_tbl-name.
     6080     end.
     6081   end procedure.
     6082   function AddUtdErrForTab returns logical
     6083   (idb-num         as integer ,
     6084    idoc-id         as integer ,
     6085    iTab            as character,
     6086    iObj            as handle ,
     6087    iCheckType      as character,
     6088    iCodeErr        as character,
     6089    iCheckObj       as character ):
     6090      define buffer utd-err for utd-err.
     6091      define buffer utd for utd.
     6092      find first utd where utd.db-num     eq idb-num
     6093                       and utd.doc-id     eq idoc-id
     6094                       and utd.Direction  eq 'Outbound'
     6095      no-lock no-error.
     6096      if available utd
     6097      then
     6098         return no.
     6099      define variable vRecKey as character no-undo.
     6100            run gen-key-rec (input iTab,
     6101                             input  iObj,
     6102                             output vRecKey).
     6103      find first utd-err where utd-err.db-num     eq idb-num
     6104                           and utd-err.doc-id     eq idoc-id
     6105                           and utd-err.CheckType  eq iCheckType
     6106                           and utd-err.CodeErr    eq iCodeErr
     6107                           and utd-err.CheckObj   eq iCheckObj
     6108      exclusive-lock no-error.
     6109      if not available utd-err
     6110      then do:
     6111         create utd-err.
     6112         assign
     6113            utd-err.db-num         = idb-num
     6114            utd-err.doc-id         = idoc-id
     6115            utd-err.CheckType      = iCheckType
     6116            utd-err.CodeErr        = iCodeErr
     6117            utd-err.CheckObj       = if iCheckObj eq ? then "?" else iCheckObj
     6118            utd-err.reckey         = vRecKey
     6119            utd-err.qnty           = 1
     6120         .
     6121      end.
     6122      else
     6123         utd-err.qnty = utd-err.qnty + 1.
     6124      return utd-err.qnty eq 1.
     6125   end.
     6126   function AddUtdErr returns logical
     6127   (idb-num         as integer ,
     6128    idoc-id         as integer ,
     6129    iObj            as handle ,
     6130    iCheckType      as character,
     6131    iCodeErr        as character,
     6132    iCheckObj       as character ):
     6133      AddUtdErrForTab
     6134         (idb-num,
     6135          idoc-id,
     6136          iObj:table,
     6137          iObj,
     6138          iCheckType,
     6139          iCodeErr,
     6140          iCheckObj).
     6141   end.
     6142   function ClearUtdErrTypeCode returns logical
     6143   (idb-num         as integer,
     6144    idoc-id         as integer ,
     6145    iCheckType      as character,
     6146    iCodeErr        as character
     6147    ):
     6148      define buffer utd-err for utd-err.
     6149      if    iCheckType eq "*"
     6150         or iCheckType eq ?
     6151      then do:
     6152         if     iCodeErr ne ?
     6153            and iCodeErr ne "*"
     6154         then
     6155            message "Задан код ошибки " iCodeErr " для удаления, но не задан тип"
     6156            view-as alert-box.
     6157         else
     6158         for each utd-err where utd-err.db-num  eq idb-num
     6159                            and utd-err.doc-id  eq idoc-id
     6160         exclusive-lock:
     6161            delete utd-err.
     6162         end.
     6163      end.
     6164      else do:
     6165         if    iCodeErr eq ?
     6166            or iCodeErr eq "*"
     6167         then do:
     6168            for each utd-err where utd-err.db-num     eq idb-num
     6169                               and utd-err.doc-id     eq idoc-id
     6170                               and utd-err.CheckType  eq iCheckType
     6171            exclusive-lock:
     6172               delete utd-err.
     6173            end.
     6174         end.
     6175         else do:
     6176            for each utd-err where utd-err.db-num     eq idb-num
     6177                               and utd-err.doc-id     eq idoc-id
     6178                               and utd-err.CheckType  eq iCheckType
     6179                               and ub.utd-err.CodeErr eq iCodeErr
     6180            exclusive-lock:
     6181               delete utd-err.
     6182            end.
     6183         end.
     6184      end.
     6185   end.
     6186   function ClearUtdErr returns logical
     6187   (idb-num         as integer,
     6188    idoc-id         as integer ,
     6189    iCheckType      as character
     6190    ):
     6191      ClearUtdErrTypeCode(idb-num,idoc-id,iCheckType,?).
     6192   end.
     6193   function GetMesError returns character
     6194   (itxt as character,
     6195    iobj as character ):
     6196    define variable vi as integer no-undo.
     6197    do vi = num-entries(iobj ,chr(4) ) to 1 by -1 :
     6198       itxt = replace(itxt,"&" + string(vi),entry(vi,iobj,chr(4))).
     6199    end.
     6200    return itxt.
     6201   end.
     6202   function GetTextErrorType returns character
     6203   (iCheckType as character,
     6204    iCodeErr   as character,
     6205    iChechObj  as character,
     6206    iType      as character  ):
     6207      define buffer code    for code.
     6208      define variable vError as character no-undo.
     6209      find first code where code.parent eq "CodeError" +  chr(4)  + "UTD" +  chr(4) + iCheckType
     6210                        and code.code   eq iCodeErr
     6211      no-lock no-error.
     6212      if available code
     6213      then do:
     6214         define variable vType as integer no-undo.
     6215         if code.misc3 eq "error"
     6216         then
     6217            vType = 0.
     6218         else if code.misc3 eq "warning"
     6219         then
     6220            vType = 1.
     6221         else if code.misc3 eq "Hiden"
     6222         then
     6223            vType = 2.
     6224         else
     6225            vtype = int(code.misc3) no-error.
     6226         case itype:
     6227            when "error"
     6228            then do:
     6229               if vtype eq 0
     6230               then
     6231                  vError = GetMesError(Code.CodeValue,iChechObj).
     6232            end.
     6233            when "warning"
     6234            then do:
     6235               if vtype <= 1
     6236               then
     6237                  vError = GetMesError(Code.CodeValue,iChechObj).
     6238            end.
     6239            otherwise do:
     6240               vError = GetMesError(Code.CodeValue,iChechObj).
     6241            end.
     6242         end.
     6243      end.
     6244      else
     6245         vError =  iCodeErr + ":" + replace (iChechObj,chr(4),"|").
     6246      return vError.
     6247   end.
     6248   function GetTypeError returns integer
     6249   (iCheckType as character,
     6250    iCodeErr   as character):
     6251      define buffer code    for code.
     6252      define variable vType as integer no-undo.
     6253      find first code where code.parent eq "CodeError" +  chr(4)  + "UTD" +  chr(4) + iCheckType
     6254                        and code.code   eq iCodeErr
     6255      no-lock no-error.
     6256      if     not available code
     6257         and code.misc3 eq "error"
     6258      then
     6259         vType = 0.
     6260      else if code.misc3 eq "warning"
     6261      then
     6262         vType = 1.
     6263      else if code.misc3 eq "Hiden"
     6264      then
     6265         vType = 2.
     6266      else
     6267         vtype = int(code.misc3) no-error.
     6268      return vtype.
     6269   end.
     6270   function GetTextError returns character
     6271   (iCheckType as character,
     6272    iCodeErr   as character,
     6273    iChechObj  as character ):
     6274      return GetTextErrortype(iCheckType,iCodeErr,iChechObj,"warning").
     6275   end.
     6276   function GetErrForUtdStr returns character
     6277   (idb-num     as integer ,
     6278    idoc-id     as integer ,
     6279    iCheckType  as character
     6280    ):
     6281      define buffer utd-err for utd-err.
     6282      define buffer code    for code.
     6283      define variable vHQry as handle no-undo.
     6284      define variable vError as longchar no-undo.
     6285      define variable vErrorOne as longchar  no-undo.
     6286      define variable oError as character no-undo.
     6287      create query vHQry.
     6288      vHQry:set-buffers(buffer utd-err:handle).
     6289      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
     6290                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
     6291                               + if    iCheckType eq "*"
     6292                                    or iCheckType eq ?
     6293                                 then       ""
     6294                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
     6295      vHQry:query-open().
     6296      vHQry:get-first().
     6297      QRY-BLOCK:
     6298      repeat while not vHQry:query-off-end:
     6299         vErrorOne = GetTextErrorType(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj,"error").
     6300         if     vErrorOne ne ""
     6301            and vErrorOne ne ?
     6302         then
     6303            vError = vError + ", " + vErrorOne.
     6304         vHQry:get-next().
     6305      end.
     6306      oError = substring(vError,3,4002).
     6307      return oError.
     6308   end.
     6309   function GetErrJsonForUtd returns character
     6310   (idb-num         as integer ,
     6311    idoc-id         as integer ,
     6312    iCheckType      as character
     6313    ):
     6314      define buffer utd-err for utd-err.
     6315      define variable vHQry as handle no-undo.
     6316      define variable vError as longchar no-undo.
     6317      define variable oError as character no-undo.
     6318      create query vHQry.
     6319      define variable vi as integer no-undo.
     6320      vHQry:set-buffers(buffer utd-err:handle).
     6321      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
     6322                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
     6323                               + if    iCheckType eq "*"
     6324                                    or iCheckType eq ?
     6325                                 then       ""
     6326                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
     6327      vHQry:query-open().
     6328      vHQry:get-first().
     6329      QRY-BLOCK:
     6330      repeat while not vHQry:query-off-end:
     6331         define variable vErrorOne as character no-undo.
     6332         vErrorOne = GetTextErrorType(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj,"error").
     6333         if     vErrorOne ne ?
     6334            and vErrorOne ne ""
     6335         then do:
     6336            vi = vi + 1.
     6337            vError = vError + ',"Ошибка_' + string(vi) +  '":~{"КодОш":"'    + utd-err.CheckType + "_" + utd-err.CodeErr
     6338                            + '","ОбъектОш":"' + replace(utd-err.CheckObj,chr(4),"|")
     6339                            + '","ТекстОш":"' + vErrorOne + '"}'.
     6340         end.
     6341         vHQry:get-next().
     6342      end.
     6343      for first utd where utd.db-num eq idb-num
     6344                      and utd.doc-id eq idoc-id
     6345                      and utd.sts    eq ObjSrv:Env:Utd:Sts:th:DeliveryCodeMismatch:KeyIntDB
     6346      no-lock,
     6347         each utd-marking-lines where utd-marking-lines.db-num eq idb-num
     6348                                  and utd-marking-lines.doc-id eq idoc-id
     6349                                  and utd-marking-lines.doc-level eq 1
     6350      no-lock,
     6351         first marking where marking.mark eq utd-marking-lines.mark
     6352                         and marking.sts  eq ObjSrv:Env:Marking:Sts:Mark:NotAvailable:KeyIntDB
     6353      no-lock:
     6354         vErrorOne = GetTextErrortype("CheckShip","NotMark",marking.mark,"error").
     6355         if     vErrorOne ne ?
     6356            and vErrorOne ne ""
     6357         then do:
     6358            vError = vError + ',"Ошибка_' + string(vi) +  '":~{"КодОш":"'    + "CheckShip" + "_" + "NotMark"
     6359                            + '","ОбъектОш":"' + marking.mark
     6360                            + '","ТекстОш":"' + vErrorOne + '"}'.
     6361         end.
     6362      end.
     6363      if vError ne ""
     6364      then
     6365         oError = '"Ошибки":~{' + substring(vError,2,31002) + "}".
     6366      return oError.
     6367   end.
     6368   function GetErrJsonForUtdReturn returns character
     6369   (idb-num         as integer ,
     6370    idoc-id         as integer ,
     6371    iCheckType      as character
     6372    ):
     6373      define buffer utd-err for utd-err.
     6374      define variable vHQry as handle no-undo.
     6375      define variable vError as longchar no-undo.
     6376      define variable oError as character no-undo.
     6377      define variable vi as integer no-undo.
     6378      create query vHQry.
     6379      vHQry:set-buffers(buffer utd-err:handle).
     6380      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
     6381                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
     6382                               + if    iCheckType eq "*"
     6383                                    or iCheckType eq ?
     6384                                 then       ""
     6385                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
     6386      vHQry:query-open().
     6387      vHQry:get-first().
     6388      QRY-BLOCK:
     6389      repeat while not vHQry:query-off-end:
     6390         define variable vErrorOne as character no-undo.
     6391         vErrorOne = GetTextErrorType(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj,"error").
     6392         if     vErrorOne ne ?
     6393            and vErrorOne ne ""
     6394         then do:
     6395            vi = vi + 1.
     6396            vError = vError + ',"Возврат_' + string(vi) +  '":~{"КодВозр":"'    + utd-err.CheckType + "_" + utd-err.CodeErr
     6397                            + '","ОбъектВозр":"' + replace(utd-err.CheckObj,chr(4),"|")
     6398                            + '","ТекстВозр":"' + GetTextError(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj) + '"}'.
     6399         end.
     6400         vHQry:get-next().
     6401      end.
     6402      if vError ne ""
     6403      then
     6404         oError = '"Возвраты":~{' + substring(vError,2,31002) + "}".
     6405      return oError.
     6406   end.
     6407   function GetCodeTextError returns character
     6408   (iCheckType as character,
     6409    iCodeErr   as character,
     6410    iChechObj  as character,
     6411    output oCode as character,
     6412    output ovalue as character ):
     6413      define buffer code    for code.
     6414      find first code where code.parent eq "CodeError" +  chr(4)  + "UTD" +  chr(4) + iCheckType
     6415                        and code.code   eq iCodeErr
     6416      no-lock no-error.
     6417      if     available code
     6418      then do:
     6419         define variable vi as integer no-undo init ?.
     6420         vi = int(Code.misc3) no-error.
     6421         if    code.misc3 ne "error"
     6422            and vi ne 0
     6423         then
     6424            oCode = ?.
     6425         else if     Code.misc1 ne ?
     6426                 and Code.misc1 ne ""
     6427         then
     6428            assign
     6429               oCode  = GetMesError(Code.misc1,iChechObj)
     6430               ovalue = GetMesError(Code.misc2,iChechObj)
     6431            .
     6432      end.
     6433      return if oCode eq ""
     6434             then ""
     6435             else (oCode + "_" + ovalue).
     6436   end.
     6437   define temp-table TT-err no-undo
     6438     field code_ as character
     6439     field text_ as character
     6440   index code_ code_.
     6441   function GetErrTxtForUtd returns character
     6442   (idb-num         as integer ,
     6443    idoc-id         as integer ,
     6444    iCheckType      as character
     6445    ):
     6446      define buffer utd-err for utd-err.
     6447      define variable vHQry as handle no-undo.
     6448      define variable oError as character no-undo.
     6449      create query vHQry.
     6450      define variable vi as integer no-undo.
     6451      for each tt-err :
     6452         delete tt-err.
     6453      end.
     6454      vHQry:set-buffers(buffer utd-err:handle).
     6455      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
     6456                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
     6457                               + if    iCheckType eq "*"
     6458                                    or iCheckType eq ?
     6459                                 then       ""
     6460                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
     6461      vHQry:query-open().
     6462      vHQry:get-first().
     6463      define variable vcode as character no-undo.
     6464      define variable vvalue as character no-undo.
     6465      QRY-BLOCK:
     6466      repeat while not vHQry:query-off-end:
     6467         vi = vi + 1.
     6468         GetCodeTextError (utd-err.CheckType, utd-err.CodeErr, utd-err.CheckObj, output vcode, output vvalue).
     6469         if vcode ne ?
     6470         then do:
     6471            find first tt-err where tt-err.code eq vcode
     6472            no-error.
     6473            if not available tt-err
     6474            then do:
     6475               create tt-err.
     6476               assign
     6477                  tt-err.code_ = vcode
     6478                  tt-err.text_ = vvalue
     6479               .
     6480            end.
     6481            else
     6482               tt-err.text_ = tt-err.text_ + "||" + vvalue.
     6483         end.
     6484         vHQry:get-next().
     6485      end.
     6486     find first utd where utd.db-num eq idb-num
     6487                         and utd.doc-id eq idoc-id
     6488         no-lock.
     6489      define buffer cancel_utd-lines for utd-lines.
     6490      for each cancel_utd-lines where cancel_utd-lines.db-num eq idb-num
     6491                                  and cancel_utd-lines.doc-id eq idoc-id
     6492      no-lock:
     6493         if logical(getattrutdlinesex  (idb-num,idoc-id,cancel_utd-lines.LineNum,"MarkUtdLine"        ,"no"))
     6494         then do:
     6495            for   each utd-marking-lines where utd-marking-lines.db-num eq idb-num
     6496                                        and utd-marking-lines.doc-id eq idoc-id
     6497                                        and utd-marking-lines.LineNum eq cancel_utd-lines.LineNum
     6498            no-lock,
     6499               first marking where marking.mark eq utd-marking-lines.mark
     6500                               and marking.sts  eq ObjSrv:Env:Marking:Sts:Mark:NotAvailable:KeyIntDB
     6501            no-lock:
     6502               GetCodeTextError ("CheckShip", "MARKDECLINED", utd-marking-lines.mark + chr(4) + string(utd-marking-lines.LineNum), output vcode, output vvalue).
     6503               find first tt-err where tt-err.code eq vcode
     6504               no-error.
     6505               if not available tt-err
     6506               then do:
     6507                  create tt-err.
     6508                  assign
     6509                     tt-err.code_ = vcode
     6510                     tt-err.text_ = vvalue
     6511                  .
     6512               end.
     6513               else
     6514                  tt-err.text_ = tt-err.text_ + "||" + vvalue.
     6515            end.
     6516         end.
     6517         else do:
     6518            define variable vqnty as decimal no-undo.
     6519            vqnty = decimal(GetAttrUtdlines(cancel_utd-lines.db-num,cancel_utd-lines.doc-id,cancel_utd-lines.linenum,"QuantityBarCode")).
     6520            if vqnty eq ? then vqnty = 0.
     6521            if vqnty ne cancel_utd-lines.Quantity
     6522            then do:
     6523               GetCodeTextError ("CheckShip", "NotAcceptQuantity", string(cancel_utd-lines.LineNum) + chr(4) + string(cancel_utd-lines.Quantity - vqnty), output vcode, output vvalue).
     6524               find first tt-err where tt-err.code eq vcode
     6525               no-error.
     6526               if not available tt-err
     6527               then do:
     6528                  create tt-err.
     6529                  assign
     6530                     tt-err.code_ = vcode
     6531                     tt-err.text_ = vvalue
     6532                  .
     6533               end.
     6534               else
     6535                  tt-err.text_ = tt-err.text_ + "||" + vvalue.
     6536            end.
     6537         end.
     6538      end.
     6539      for each tt-err:
     6540         oError = oError + substitute("&1|&2|",tt-err.code_ , tt-err.text_ ) + chr(13) + chr(10) .
     6541      end.
     6542      return oError.
     6543   end.
     6544   define variable mFormatErr as character no-undo init "text".
     6545   function GetErrForUtd returns character
     6546   (idb-num         as integer ,
     6547    idoc-id         as integer ,
     6548    iType           as character
     6549    ):
     6550      if mFormatErr eq "text"
     6551      then
     6552         return GetErrTxtForUtd(idb-num,idoc-id,iType).
     6553      else do:
     6554         if itype eq "return"
     6555         then return GetErrJsonForUtdReturn (idb-num,idoc-id,iType).
     6556         else return GetErrJsonForUtd(idb-num,idoc-id,iType).
     6557      end.
     6558   end.
     6559   function GetErrComText returns longchar
     6560   (icomment as character,
     6561    itext    as longchar ):
     6562       define variable vText as longchar no-undo.
     6563      if mFormatErr eq "text"
     6564      then do:
     6565         if icomment ne ""
     6566         then
     6567            icomment = substitute("comment:|&1|",icomment).
     6568         vText = icomment + itext.
     6569      end.
     6570      else do:
     6571         icomment = if icomment begins  '"'
     6572                    then icomment
     6573                    else  if icomment eq "" then "" else ( '"Коментрии":~{"Коментарий":"' + icomment  + '"}') .
     6574         vText = icomment + "," + itext.
     6575         vText = "~{" + trim(vText,",") + "~}".
     6576      end.
     6577      return vText.
     6578   end.
     6579   function CheckTypeForMarkLineType returns logical
     6580   (iObj            as handle,
     6581    iCheckType      as character,
     6582    iCodeErr        as character ,
     6583    iTypeErr        as character ):
     6584      define variable vRecKey-markLine as character no-undo.
     6585      define variable vGoodMark        as logical no-undo.
     6586      define variable vdb-num          as integer no-undo.
     6587      define variable vdoc-id          as integer no-undo.
     6588      define variable vlinenum         as integer no-undo.
     6589      define variable vErrorOne as character no-undo.
     6590      define buffer buf_utd-err for utd-err.
     6591      run gen-key-rec (input "utd-marking-lines",
     6592                       input  iObj,
     6593                       output vRecKey-markLine).
     6594      vGoodMark = yes.
     6595      vdb-num = iObj::db-num.
     6596      vdoc-id = iObj::doc-id.
     6597      vlinenum = iObj::linenum.
     6598      block-mark-err:
     6599      for each buf_utd-err  where  buf_utd-err.doc-id = vdoc-id
     6600                               and buf_utd-err.db-num = vdb-num
     6601                               and buf_utd-err.reckey = vRecKey-markLine
     6602                               and if iCheckType  eq "*" or iCheckType eq ? then yes else buf_utd-err.CheckType = iCheckType
     6603                               and if iCodeErr    eq "*" or iCodeErr   eq ? then yes else buf_utd-err.CodeErr   = iCodeErr
     6604      no-lock:
     6605         vErrorOne = GetTextErrorType(buf_utd-err.CheckType,buf_utd-err.CodeErr,buf_utd-err.CheckObj,iTypeErr).
     6606         if     vErrorOne ne ?
     6607            and vErrorOne ne ""
     6608         then do:
     6609            vGoodMark = no.
     6610            leave block-mark-err.
     6611         end.
     6612      end.
     6613      return not vGoodMark.
     6614   end.
     6615   function CheckErrForMarkLineType returns logical
     6616   (iObj            as handle,
     6617    iType           as character  ):
     6618      return CheckTypeForMarkLineType (iObj,iType,"*","error").
     6619   end.
     6620   function CheckErrForMarkLine returns logical
     6621   (iObj            as handle):
     6622      return CheckErrForMarkLineType(iObj,"*").
     6623   end.
     6624   function CheckErrForLineTypeCode returns logical
     6625   (iObj                 as handle,
     6626    iCheckType           as character,
     6627    iCodeErr             as character,
     6628    iTypeErr             as character,
     6629    iOneErr              as logical):
     6630      define variable vRecKey-line     as character no-undo.
     6631      define buffer buf_utd-err for utd-err.
     6632      define variable vUtdlineError as logical no-undo.
     6633      define variable vErrorOne as character no-undo.
     6634            run gen-key-rec (input "utd-lines",
     6635                             input  iObj,
     6636                             output vRecKey-line).
     6637         define variable vdb-num as integer no-undo.
     6638         define variable vdoc-id as integer no-undo.
     6639         define variable vlinenum as integer no-undo.
     6640         vdb-num = iObj::db-num.
     6641         vdoc-id = iObj::doc-id.
     6642         vlinenum = iObj::linenum.
     6643         block-err:
     6644         for each buf_utd-err  where  buf_utd-err.doc-id = vdoc-id
     6645                                  and buf_utd-err.db-num = vdb-num
     6646                                  and buf_utd-err.reckey = vRecKey-line
     6647                                  and if iCheckType eq "*" or iCheckType eq ? then yes else buf_utd-err.CheckType = iCheckType
     6648                                  and if iCodeErr   eq "*" or iCodeErr   eq ? then yes else buf_utd-err.CodeErr   = iCodeErr
     6649         no-lock:
     6650            vErrorOne = GetTextErrorType(buf_utd-err.CheckType,buf_utd-err.CodeErr,buf_utd-err.CheckObj,iTypeErr).
     6651            if     vErrorOne ne ?
     6652               and vErrorOne ne ""
     6653            then do:
     6654               vUtdlineError = yes.
     6655               leave block-err.
     6656            end.
     6657         end.
     6658         if  not vUtdlineError
     6659         then do:
     6660            define variable vGoodMark as logical no-undo.
     6661            vGoodMark = yes.
     6662            block-line-err:
     6663            for each utd-marking-lines where utd-marking-lines.db-num  eq vdb-num
     6664                                         and utd-marking-lines.doc-id  eq vdoc-id
     6665                                         and utd-marking-lines.LineNum eq vLineNum
     6666            no-lock:
     6667               vGoodMark = not CheckTypeForMarkLineType(buffer utd-marking-lines:handle,iCheckType,iCodeErr,iTypeErr).
     6668               if     vGoodMark
     6669                  and iOneErr eq no
     6670               then
     6671                  leave block-line-err.
     6672               if     iOneErr = yes
     6673                  and not vGoodMark
     6674               then
     6675                  leave block-line-err.
     6676            end.
     6677            vUtdlineError = not vGoodMark.
     6678         end.
     6679      return vUtdlineError.
     6680   end.
     6681   function getErrForLineType returns character
     6682   (iObj            as handle,
     6683    iType           as character  ):
     6684      define variable vRecKey-line     as character no-undo.
     6685      define buffer buf_utd-err for utd-err.
     6686      define variable vUtdlineError as logical no-undo.
     6687      define variable vErrorOne as character no-undo.
     6688      define variable oError as character no-undo.
     6689            run gen-key-rec (input "utd-lines",
     6690                             input  iObj,
     6691                             output vRecKey-line).
     6692         define variable vdb-num as integer no-undo.
     6693         define variable vdoc-id as integer no-undo.
     6694         define variable vlinenum as integer no-undo.
     6695         vdb-num = iObj::db-num.
     6696         vdoc-id = iObj::doc-id.
     6697         vlinenum = iObj::linenum.
     6698         block-err:
     6699         for each buf_utd-err  where  buf_utd-err.doc-id = vdoc-id
     6700                                  and buf_utd-err.db-num = vdb-num
     6701                                  and buf_utd-err.reckey = vRecKey-line
     6702                                  and if iType eq "*" or iType eq ? then yes else buf_utd-err.CheckType = iType
     6703         no-lock:
     6704            vErrorOne = GetTextErrorType(buf_utd-err.CheckType,buf_utd-err.CodeErr,buf_utd-err.CheckObj,"error").
     6705            if     vErrorOne ne ?
     6706               and vErrorOne ne ""
     6707            then do:
     6708               oError = oError + vErrorOne + " ".
     6709            end.
     6710         end.
     6711      return oError.
     6712   end.
     6713   function CheckErrForLineType returns logical
     6714   (iObj            as handle,
     6715    iType           as character  ):
     6716       return CheckErrForLineTypeCode (iObj,itype,"*","error",no).
     6717   end.
     6718   function CheckErrForLine returns logical
     6719   (iObj            as handle):
     6720      return CheckErrForLineType(iobj,"*").
     6721   end.
     6722   function CheckErrForUtd returns logical
     6723   (idb-num         as integer ,
     6724    idoc-id         as integer ):
     6725      for each utd-lines where utd-lines.db-num eq idb-num
     6726                           and utd-lines.doc-id eq idoc-id
     6727      no-lock :
     6728         if not CheckErrForLine (buffer ub.utd-lines:handle)
     6729         then
     6730            return no.
     6731      end.
     6732      return yes.
     6733   end.
     6734   function CheckMarkUtd-28rel return logical
     6735    (input idb-num as integer,
     6736    input idoc-id as integer):
     6737    define buffer utd                   for utd.
     6738    define buffer utd-lines             for utd-lines.
     6739    define buffer utd-marking-lines     for utd-marking-lines.
     6740    define variable v-par-type as character no-undo.
     6741    define variable vgdsNoMark as logical no-undo.
     6742    define variable EDOParSec as class ibs.th.gbl.env.prmtrs.edo .
     6743      define variable v-par-val  as character no-undo.
     6744      find first utd where utd.db-num eq idb-num
     6745                       and utd.doc-id eq idoc-id
     6746      no-lock no-error.
     6747      if available utd
     6748      then do:
     6749         if     utd.obj-code ne ?
     6750            and utd.obj-type ne ?
     6751         then do:
     6752            EDOParSec = ObjSrv:Env:ParametrsOfSection:GetSectionEDO(utd.obj-type, utd.obj-code).
     6753            Block-utd-lines:
     6754            for each utd-lines where utd-lines.db-num eq idb-num
     6755                                 and utd-lines.doc-id eq idoc-id
     6756            no-lock:
     6757               if     utd-lines.gds-code ne ?
     6758                  and utd-lines.gds-code ne 0
     6759               then do:
     6760                                  if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     6761                       ( utd-lines.gds-code,
     6762                         'mark-type':U,
     6763                          output v-par-val,
     6764                          output v-par-type
     6765                       ).
     6766                  if     EDOParSec:IsEdo
     6767                     and EDOParSec:GetIsEDOForType(v-par-val)
     6768                  then do:
     6769                     find first utd-marking-lines where utd-marking-lines.db-num  eq utd-lines.db-num
     6770                                                    and utd-marking-lines.doc-id  eq utd-lines.doc-id
     6771                                                    and utd-marking-lines.LineNum eq utd-lines.LineNum
     6772                                                    and length(utd-marking-lines.mark) > 13
     6773                     no-lock no-error.
     6774                     if     avail utd-marking-lines
     6775                        and not CheckErrForLine(buffer utd-lines:handle)
     6776                     then
     6777                        leave Block-utd-lines.
     6778                  end.
     6779                  else
     6780                     vgdsNoMark = yes.
     6781               end.
     6782            end.
     6783            setattrutd (utd.db-num,utd.doc-id,"MarkUtd",if vgdsNoMark then string(available utd-lines) else "yes").
     6784            if vgdsNoMark then return available utd-lines . else return yes .
     6785         end.
     6786      end.
     6787      return yes.
     6788   end.
     6789   function get-subject returns character
     6790     ( p-subject as character ) :
     6791     return p-subject.
     6792   end function.
     6793   procedure local-view-cange:
     6794      define output parameter oDescription as character no-undo.
     6795      if X_c-obj-hist.subject eq "order-doc"
     6796      then
     6797         run order-doc-proc in this-procedure no-error.
     6798      else if X_c-obj-hist.subject eq "order-doc-attr"
     6799      then
     6800         run order-doc-attr-proc in this-procedure no-error.
     6801      else if X_c-obj-hist.subject eq "order-line"
     6802      then
     6803         run order-line-proc in this-procedure no-error.
     6804      else if X_c-obj-hist.subject eq "order-line-attr"
     6805      then
     6806         run order-line-attr-proc in this-procedure no-error.
     6807      if error-status:error then
     6808        message return-value view-as alert-box.
     6809   end procedure.
     6810   function local-open-br returns logical
     6811   (  p-open-query     as logical    ,
     6812     p-find-next       as logical    ,
     6813     p-find-condition as character ):
     6814        define variable sort-column-phrase as character no-undo .
     6815        define variable l-query-was-opened as logical no-undo .
     6816      for each X_c-obj-hist :
     6817         delete X_c-obj-hist.
     6818      end.
     6819      if p-mode eq "one"
     6820      then do:
     6821         if p-chip-num eq ?
     6822         then do:
     6823            for each c-order-head where c-order-head.db-num   = p-db-num-order
     6824                                       and c-order-head.doc-code = p-doc-code-order
     6825                                       and c-order-head.corr-user-db-num = v-corr-user-db-num
     6826            no-lock:
     6827               create X_c-obj-hist.
     6828               buffer-copy c-order-head to X_c-obj-hist.
     6829               if c-order-head.subject <> "order-doc" and
     6830                  c-order-head.subject <> "*" then
     6831               do:
     6832                 run getRecordsByChipNum in this-procedure ((buffer X_c-obj-hist:handle), c-order-head.subject).
     6833               end.
     6834            end.
     6835         end.
     6836         else do:
     6837            for each c-order-head where
     6838                     c-order-head.db-num           = p-db-num-order
     6839                 and c-order-head.doc-code         = p-doc-code-order
     6840                 and c-order-head.corr-user-db-num = v-corr-user-db-num
     6841                 and c-order-head.chip-num         = p-chip-num
     6842                no-lock:
     6843              run getRecordsByChipNum in this-procedure (?, "order-doc").
     6844              run getRecordsByChipNum in this-procedure (?, "order-doc-attr").
     6845              run getRecordsByChipNum in this-procedure (?, "order-line").
     6846              run getRecordsByChipNum in this-procedure (?, "order-line-attr").
     6847            end.
     6848         end.
     6849      end.
     6850   define variable vss-include-info35 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6851   define variable  l-disable-where-36  as logical   no-undo .
     6852   define variable  l-filter-open-36    as logical   .
     6853   define variable  flt-rec-36       as recid     no-undo .
     6854   define variable  filter-name-36      as character no-undo .
     6855   define variable  where-phrase-36     as character no-undo .
     6856   define variable  sort-phrase-36      as character no-undo .
     6857   define variable  where-phrase-rus-36 as character no-undo .
     6858   define variable  sort-phrase-rus-36  as character no-undo .
     6859     run waitfram-show in this-procedure
     6860       (input "ЖДИТЕ ..."
     6861       ).
     6862   run gbl/flt-get.p
     6863     (input filter-point
     6864     ,output flt-rec-36
     6865     ,output filter-name-36
     6866     ,output where-phrase-36
     6867     ,output sort-phrase-36
     6868     ,output where-phrase-rus-36
     6869     ,output sort-phrase-rus-36
     6870     ).
     6871   if p-open-query then do:
     6872       run set-filter-name in this-procedure
     6873         (INPUT filter-name-36
     6874         ) no-error .
     6875     assign
     6876       l-filter-open-36 = false
     6877     .
     6878     if flt-rec-36 <> ?
     6879       or sort-column-phrase > ""
     6880     then do:
     6881       define variable  parameter-2-36 as character no-undo .
     6882       define variable  parameter-3-36 as character no-undo .
     6883       define variable  parameter-4-36 as character no-undo .
     6884       define variable  parameter-5-36 as character no-undo .
     6885       define variable  parameter-6-36 as character no-undo .
     6886       define variable  parameter-7-36 as character no-undo .
     6887         assign
     6888         parameter-3-36 =
     6889                                 "FOR EACH X_c-obj-hist"
     6890         parameter-4-36 =
     6891           (
     6892             if (" TRUE " + " " + where-phrase-36) <> ""
     6893             then " TRUE " + " " + where-phrase-36
     6894             else "true"
     6895           )
     6896         parameter-5-36 = (" " + "" + " " + "")
     6897         parameter-6-36 = if sort-phrase-36 = ''
     6898                              then
     6899           (
     6900           " " + "" +
     6901             " " + sort-column-phrase +
     6902           " " + " by X_c-obj-hist.chip-num  "
     6903           )
     6904                              else
     6905           (
     6906           " " + "" +
     6907             " " + sort-column-phrase +
     6908           " " + sort-phrase-36
     6909           )
     6910         parameter-7-36 =
     6911           " indexed-reposition  "
     6912       .
     6913       do
     6914       on stop undo, leave
     6915       on error undo, leave
     6916       :
     6917         assign
     6918           l-disable-where-36 =
     6919             (" TRUE " + " " + where-phrase-36 = "")
     6920         .
     6921         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     6922                             ,input query br-obj-hist:handle
     6923                             ,input parameter-3-36
     6924                             ,input parameter-4-36
     6925                             ,input parameter-5-36
     6926                             ,input parameter-6-36
     6927                             ,input parameter-7-36
     6928                             )
     6929         .
     6930         assign
     6931           l-filter-open-36 = true
     6932         .
     6933       end.
     6934       if l-filter-open-36 = false then do:
     6935         message
     6936           "Ошибка при фильтрации / сортировке" skip
     6937           "Будут показаны записи без учета фильтра" skip
     6938           view-as alert-box .
     6939       end.
     6940       else do:
     6941           assign
     6942             l-query-was-opened = true
     6943           .
     6944       end.
     6945     end.
     6946     if l-filter-open-36 = false then do:
     6947       OPEN QUERY br-obj-hist FOR EACH X_c-obj-hist
     6948         where  TRUE
     6949          by X_c-obj-hist.chip-num
     6950         indexed-reposition
     6951     .
     6952         assign
     6953           l-query-was-opened = true
     6954         .
     6955     end.
     6956   end.
     6957   else do:
     6958     assign
     6959       v-doc-rec = recid( X_c-obj-hist )
     6960     .
     6961     do
     6962     on stop undo, leave
     6963     on error undo, leave
     6964     :
     6965       if query br-obj-hist:handle:get-buffer-handle(1) = (buffer X_c-obj-hist:handle) then do:
     6966         assign
     6967         parameter-2-36 = (if p-find-next then "true":u else "false":u )
     6968         parameter-4-36 =
     6969           "where ":u + " TRUE " + " ":u + where-phrase-36 + " ":u + p-find-condition + " " + ""
     6970         parameter-5-36 = ""
     6971       .
     6972         run fltopend_fltfindd in this-procedure  (
     6973                             input this-procedure:handle
     6974                             ,input query br-obj-hist:handle
     6975                             ,input rowid(X_c-obj-hist)
     6976                             ,input logical(parameter-2-36)
