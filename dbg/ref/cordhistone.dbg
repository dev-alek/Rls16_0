      147   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      148   define variable c-point  as character no-undo .
      149   define variable tbl      as character no-undo .
      150   define variable join-tbl as character no-undo .
      151   define variable fld      as character no-undo .
      152   define variable lab      as character no-undo .
      153   define variable spr      as character no-undo .
      154   define variable dim      as character no-undo .
      155   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      156   procedure cur-time :
      157      define output parameter p-today as date      no-undo .
      158      define output parameter p-time  as integer   no-undo .
      159     do
      160     on error undo, return error
      161     :
      162       define variable v-date1 as date      no-undo .
      163       define variable v-date2 as date      no-undo .
      164       define variable v-time  as integer   no-undo .
      165       assign
      166         v-date1 = today
      167         v-time  = time
      168         v-date2 = today
      169       .
      170       if v-date1 <> v-date2
      171       then do:
      172         assign
      173           v-date1 = today
      174           v-time  = v-time
      175         .
      176       end.
      177       assign
      178         p-today = v-date1
      179         p-time  = v-time
      180       .
      181     end.
      182   end.
      183   function cur-time-date returns character
      184   :
      185     return string(today, '99/99/9999':U) .
      186   end.
      187   function cur-time-mjd returns decimal
      188   :
      189     define variable v-date as date      no-undo .
      190     define variable v-time as integer   no-undo .
      191     run cur-time in this-procedure
      192       (output v-date
      193       ,output v-time
      194       ) .
      195     return integer(v-date) - 2400002 + (v-time / 86400) .
      196   end.
      197   function cur-time-get-ending-index returns integer
      198   (input p-number as integer
      199   )
      200   :
      201     if p-number < 0
      202     or p-number = ?
      203     then do:
      204       return 1 .
      205     end.
      206     define variable v-rest as integer   no-undo .
      207     assign
      208       p-number = p-number modulo 100
      209     .
      210     if p-number < 20
      211     then do:
      212       assign
      213         v-rest = p-number
      214       .
      215     end.
      216     else do:
      217       assign
      218         v-rest = p-number modulo 10
      219       .
      220     end.
      221     case v-rest :
      222       when 1
      223       then do:
      224         return 2 .
      225       end.
      226       when 2 or
      227       when 3 or
      228       when 4
      229       then do:
      230         return 3 .
      231       end.
      232       otherwise do:
      233         return 1 .
      234       end.
      235     end case .
      236   end.
      237   procedure cur-time-mjd-to-date :
      238      define input  parameter i-mjd-diff as decimal no-undo.
      239      define output parameter o-Date     as date    no-undo.
      240      define output parameter o-Time     as integer no-undo.
      241      define variable v-day-number as integer   no-undo .
      242      if    i-mjd-diff < 0
      243         or i-mjd-diff = ?
      244      then do:
      245         return "?" .
      246      end.
      247      assign
      248         v-day-number = truncate(i-mjd-diff,0).
      249         o-Date = date(v-day-number + 2400002).
      250         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      251     .
      252   end.
      253   function cur-time-mjd-to-string returns character
      254   (input p-mjd-diff as decimal
      255   )
      256   :
      257     define variable v-day-number as integer   no-undo .
      258     define variable v-seconds    as integer   no-undo .
      259     define variable v-hour       as integer   no-undo .
      260     define variable v-min        as integer   no-undo .
      261     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      262     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      263     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      264     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      265     if p-mjd-diff < 0
      266     or p-mjd-diff = ?
      267     then do:
      268       return "?" .
      269     end.
      270     assign
      271       v-day-number = integer(truncate(p-mjd-diff,0))
      272       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      273     .
      274     if v-seconds > 86400
      275     then do:
      276       assign
      277         v-seconds = 86400 - 1
      278       .
      279     end.
      280     if v-seconds < 0
      281     then do:
      282       assign
      283         v-seconds = 0
      284       .
      285     end.
      286     assign
      287       v-hour = truncate(v-seconds / 3600, 0)
      288     .
      289     assign
      290       v-seconds = v-seconds modulo 3600
      291     .
      292     assign
      293       v-min = truncate(v-seconds / 60, 0)
      294     .
      295     assign
      296       v-seconds = v-seconds modulo 60
      297     .
      298     return
      299         (if v-day-number <> 0
      300           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      301           else ""
      302         )
      303       + (if v-day-number <> 0 or v-hour <> 0
      304           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      305           else ""
      306         )
      307       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      308           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      309           else ""
      310         )
      311       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      312       .
      313   end.
      314   function cur-time-string returns character
      315   :
      316     define variable v-date as date      no-undo .
      317     define variable v-time as integer   no-undo .
      318     run cur-time in this-procedure
      319       (output v-date
      320       ,output v-time
      321       ) .
      322     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      323   end.
      324   function cur-time-string-sec returns character
      325   :
      326     define variable v-date as date      no-undo .
      327     define variable v-time as integer   no-undo .
      328     run cur-time in this-procedure
      329       (output v-date
      330       ,output v-time
      331       ) .
      332     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      333   end.
      334   function cur-time-custom  returns character
      335   (input p-prefix as character
      336   ,input p-date-format as character
      337   ,input p-delimiter as character
      338   ,input p-time-format as character
      339   ,input p-suffix as character
      340   )
      341   :
      342     define variable v-date as date      no-undo .
      343     define variable v-time as integer   no-undo .
      344     run cur-time in this-procedure
      345       (output v-date
      346       ,output v-time
      347       ) .
      348     return
      349       p-prefix
      350       + string(v-date, p-date-format)
      351       + p-delimiter
      352       + string(v-time, p-time-format)
      353       + p-suffix
      354       .
      355   end.
      356   function cur-time-print  returns character
      357   :
      358     define variable v-date as date      no-undo .
      359     define variable v-time as integer   no-undo .
      360     run cur-time in this-procedure
      361       (output v-date
      362       ,output v-time
      363       ) .
      364     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      365   end.
      366   function cur-time-datetime returns datetime
      367   :
      368     define variable v-char as character no-undo .
      369     define variable v-datetime as datetime no-undo .
      370     v-char = cur-time-string().
      371     v-datetime = datetime(v-char).
      372     return  v-datetime.
      373   end.
      374   function cur-time-string-msec returns character
      375   :
      376     define variable v-date as datetime  no-undo .
      377     v-date = now.
      378     return string(v-date) .
      379   end.
      380   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      381   define new shared variable PrintCopiesCounter as integer   no-undo initial 1 .
      382   define new shared variable RepPathName        as character no-undo .
      383   define new shared variable PrintRubl          as logical   no-undo .
      384   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      385   define variable v-waitfram-action01         as character   no-undo .
      386   define variable v-waitfram-action02         as character   no-undo .
      387   define variable v-waitfram-action03         as character   no-undo .
      388   define variable mWaitFramTextBeg            as character   no-undo.
      389   define variable mWaitFramTextEnd            as character   no-undo.
      390   define variable mWaitFramView               as logical     no-undo.
      391   define variable mWaitProcEvent              as logical     no-undo init yes.
      392   define variable mWaitFramInterval           as integer     no-undo init 1 .
      393   define variable mWaitFramStop               as logical     no-undo.
      394   define variable mWaitFramStopUser           as logical     no-undo.
      395   define variable mWaitFramStopTimeOut        as logical     no-undo.
      396   define variable mWaitFramStartProc          as datetime-tz no-undo.
      397   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      398   define button B-WaitFramStop auto-end-key
      399        label "Стоп"
      400        size 10 by 1 tooltip "Остоновить процесс".
      401   define button B-viewProcInfo
      402        label "Информация"
      403        size 15 by 1 tooltip "Информация о процесс".
      404   define frame waitfram
      405     v-waitfram-action01 format "x(72)" no-label skip
      406     v-waitfram-action02 format "x(72)" no-label skip
      407     v-waitfram-action03 format "x(72)" no-label skip
      408     B-viewProcInfo
      409     B-WaitFramStop at row 4 col 30
      410     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      411     .
      412   define new global shared variable mBatchMode as logical no-undo init ?.
      413   define variable mFramBachModHandle as handle no-undo.
      414   mFramBachModHandle = frame waitfram:handle.
      415   define variable mFameOldVis as logical no-undo.
      416   define variable mVisCUrentVin as logical no-undo.
      417   if session:batch-mode
      418   then
      419      mBatchMode = yes.
      420   if mBatchMode = ? then do:
      421     mVisCUrentVin = current-window:visible.
      422     mFameOldVis = mFramBachModHandle:visible.
      423     mFramBachModHandle:visible  = yes.
      424     mBatchMode = mFramBachModHandle:visible ne yes.
      425     mFramBachModHandle:visible = mFameOldVis.
      426     current-window:visible = mVisCUrentVin.
      427   end.
      428    if  log-manager:logfile-name ne ?
      429     then DO:
      430         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      431         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      432         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      433     end.
      434   on choose of B-WaitFramStop in frame waitfram
      435   do:
      436     mWaitFramStop = yes.
      437     mWaitFramStopUser = yes.
      438   end.
      439   function waitfram-check-timeout returns logical():
      440      define variable vtime as int64 no-undo.
      441      if mWaitFramStopTimeOut
      442      then
      443         return yes.
      444      vtime = ( now - mWaitFramStartProc ) / 1000 .
      445      if     mWaitFramTimeOut ne ?
      446         and mWaitFramTimeOut ne 0
      447         and mWaitFramTimeOut lt vtime
      448      then do:
      449         mWaitFramStopTimeOut = yes.
      450      end.
      451      return mWaitFramStopTimeOut.
      452   end.
      453   procedure waitfram-hide :
      454     if not session:batch-mode
      455     then do
      456     on error undo, return error return-value
      457     :
      458       pause 0 before-hide .
      459       if not mBatchMode then
      460         hide frame waitfram .
      461     end.
      462   end procedure.
      463   procedure waitfram-show :
      464     define input  parameter p-message as character no-undo .
      465     define variable v-left-margin as integer   no-undo .
      466     if not session:batch-mode
      467     then do
      468     on error undo, return error return-value
      469     :
      470       if length(p-message) <= 70 then do:
      471         assign
      472           v-left-margin = integer((70 - length(p-message)) / 2)
      473         .
      474         assign
      475           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      476         .
      477         assign
      478           v-waitfram-action01 = " "
      479           v-waitfram-action02 = " "
      480                                    + fill(" ", v-left-margin)
      481                                    + p-message
      482           v-waitfram-action03 = " "
      483         .
      484       end.
      485       else do:
      486         define variable vRindex1 as integer no-undo.
      487         define variable vRindex2 as integer no-undo.
      488         vRindex1 = r-index(p-message," ",70).
      489         if vRindex1 = 0
      490         then
      491            vRindex1 = 70.
      492         if length(p-message)  <= vRindex1 + 70 then do:
      493           assign
      494             v-waitfram-action01 = " "
      495             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      496             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      497           .
      498         end.
      499         else do:
      500           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      501           if vRindex2 <= vRindex1
      502           then
      503              vRindex2 = vRindex1 + 70.
      504           assign
      505             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      506             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      507             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      508           .
      509         end.
      510       end.
      511       B-viewProcInfo:visible   in frame waitfram = no.
      512       B-viewProcInfo:sensitive in frame waitfram = no.
      513       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      514       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      515       if  (   mWaitFramView
      516          or  mWaitProcEvent)
      517          and not mBatchMode
      518       then
      519          display
      520             v-waitfram-action01 skip
      521             v-waitfram-action02 skip
      522             v-waitfram-action03 skip
      523          with frame waitfram .
      524     end.
      525   end procedure.
      526      procedure waitfram-show-this:
      527         define input  parameter iInterval as int64 no-undo.
      528         define variable vtime as int64 no-undo.
      529         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      530         mWaitFramInterval = iInterval.
      531         run waitfram-show (substitute("&1&2 &3&4" ,
      532                                       mWaitFramTextBeg ,
      533                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      534                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      535                                       mWaitFramTextEnd
      536                                      )
      537                           ).
      538      end.
      539      procedure WaitFramRunPause:
      540         define input  parameter iInterval as dec no-undo.
      541         define variable vStart  as datetime-tz no-undo.
      542         define variable vend    as datetime-tz no-undo.
      543         define variable vint as int64 no-undo.
      544         define variable vOk as logical no-undo.
      545         vStart = now.
      546         vend   = vStart.
      547         publish "WaitFramPause" (iInterval,output vOk).
      548         vend   =  now.
      549         vint = vend - vStart.
      550         vint = iInterval - vint / 1000.
      551         if     not mWaitFramStop
      552            and (   vint > 0
      553                 or (    not vOk
      554                     and iInterval eq ?
      555                     )
      556                 )
      557         then
      558            run waitfram-show-this (iInterval).
      559         vend   =  now.
      560         vint = vend - vStart.
      561         vint = iInterval - vint / 1000.
      562         if     not mWaitFramStop
      563            and vint > 0
      564         then do:
      565            run gbl/pause.p (vint * 1000).
      566         end.
      567         if iInterval ne ?
      568         then
      569            publish "WaitFramStop".
      570         waitfram-check-timeout().
      571      end.
      572      procedure WaitFramWaitFor:
      573         define input  parameter iInterval as dec no-undo.
      574         assign
      575            mWaitFramStartProc   = now
      576            mWaitFramStopUser    = no
      577            mWaitFramStopTimeOut = no
      578         .
      579         block-wait:
      580         do while not mWaitFramStop:
      581            run WaitFramRunPause (iInterval).
      582            if  waitfram-check-timeout()
      583            then do:
      584               leave block-wait.
      585            end.
      586         end.
      587         run waitfram-hide.
      588      end.
      589   procedure waitfram-join :
      590     define input  parameter p-line-1  as character no-undo .
      591     define input  parameter p-line-2  as character no-undo .
      592     define input  parameter p-line-3  as character no-undo .
      593     define output parameter p-message as character no-undo .
      594     do
      595     on error undo, return error return-value
      596     :
      597       assign
      598         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      599                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      600                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      601       .
      602     end.
      603   end procedure.
      604   function waitfram-join-function returns character
      605     (input p-line-1 as character
      606     ,input p-line-2 as character
      607     ,input p-line-3 as character
      608     ).
      609     define variable v-message as character no-undo .
      610     run waitfram-join in this-procedure
      611       (input  p-line-1
      612       ,input  p-line-2
      613       ,input  p-line-3
      614       ,output v-message
      615       ) .
      616     return v-message .
      617   end function .
