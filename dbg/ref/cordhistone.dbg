      883   define variable v-fltopend-rowid as rowid extent 18 no-undo .
      884   procedure fltopend_fltopend :
      885   define input parameter p-parent-handle as handle no-undo .
      886   define input parameter p-qh as handle no-undo .
      887   define input parameter p-flt-open-open-query  as character no-undo .
      888   define input parameter p-where-cond as character no-undo .
      889   define input parameter p-use-indFIRST-query-tail as character no-undo .
      890   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      891   define input parameter p-indexed-reposition as character no-undo .
      892     do
      893     on error undo, return error
      894     :
      895   define variable v-prepare-string as character no-undo .
      896   define variable glog as logical no-undo .
      897   assign
      898   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      899                      p-where-cond + chr(32)  +
      900                      p-use-indFIRST-query-tail + chr(32) +
      901                      p-use-ind-sort-clmn-by + chr(32) +
      902                      p-indexed-reposition
      903   .
      904   assign
      905   glog = p-qh:query-prepare(v-prepare-string) no-error .
      906   if not glog
      907   or error-status:error then do:
      908     message error-status:get-message(1) view-as alert-box .
      909     undo, return error .
      910   end.
      911   assign
      912   glog = p-qh:query-open no-error .
      913   if not glog
      914   or error-status:error then do:
      915     message error-status:get-message(1) view-as alert-box .
      916     undo, return error .
      917   end.
      918     end.
      919   end procedure.
      920   procedure fltopend_fltfindd :
      921   define input parameter p-parent-handle as handle no-undo .
      922   define input parameter p-qh as handle no-undo .
      923   define input parameter p-rowid as rowid no-undo .
      924   define input parameter p-next as logical no-undo .
      925   define input parameter p-lock as integer no-undo .
      926   define input parameter p-bh as handle no-undo .
      927   define input parameter p-where-cond as character no-undo .
      928   define input parameter p-use-index-phrase as character no-undo .
      929   define variable glog as logical no-undo .
      930   define variable v-qh as handle no-undo .
      931   define variable v-bh as handle no-undo .
      932   define variable v-recid as recid no-undo .
      933   define variable v-prepare-string as character no-undo .
      934   do
      935   on error undo, return error
      936   on stop undo, return error
      937   :
      938     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
      939     create buffer v-bh for table p-bh buffer-name p-bh:name.
      940     create query v-qh.
      941     v-qh:set-buffers(v-bh).
      942     v-prepare-string = substitute("for each &1 &2 &3"
      943                                     ,v-bh:name
      944                                     ,p-where-cond
      945                                     ,p-use-index-phrase).
      946     glog = v-qh:query-prepare(v-prepare-string) no-error.
      947     if not glog then do:
      948       delete object v-qh.
      949       delete object v-bh.
      950       undo, return error .
      951     end.
      952     glog = v-qh:query-open no-error .
      953     if not glog then do:
      954       delete object v-qh.
      955       delete object v-bh.
      956       undo, return error .
      957     end.
      958     if p-next then do:
      959       v-qh:reposition-to-rowid(p-rowid) no-error .
      960       glog = v-qh:get-next( p-lock) no-error .
      961       glog = v-qh:get-next( p-lock) no-error .
      962       if not glog or v-qh:query-off-end = yes then do:
      963         glog = v-qh:get-first( p-lock) no-error .
      964       end.
      965     end.
      966     else do:
      967       glog = v-qh:get-first( p-lock) no-error .
      968     end.
      969     v-recid = v-bh:recid no-error .
      970     delete object v-qh.
      971     delete object v-bh.
      972     return string(v-recid) .
      973   end.
      974   end procedure.
      975   procedure fltopend_fltfindq :
      976   define input parameter p-parent-handle as handle no-undo .
      977   define input parameter p-qh as handle no-undo .
      978   define input parameter p-next as logical no-undo .
      979   define input parameter p-lock as integer no-undo .
      980   define input parameter p-flt-open-open-query  as character no-undo .
      981   define input parameter p-where-cond as character no-undo .
      982   define input parameter p-use-indFIRST-query-tail as character no-undo .
      983   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      984   define input parameter p-indexed-reposition as character no-undo .
      985   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
      986   define variable glog as logical no-undo .
      987   define variable v-qh as handle no-undo .
      988   define variable v-bh as handle no-undo extent 18.
      989   define variable v-rowid as rowid no-undo extent 18.
      990   define variable v-ii as integer no-undo .
      991   define variable v-prepare-string as character no-undo .
      992   do
      993   on error undo, return error
      994   on stop undo, return error
      995   :
      996     create query v-qh.
      997     do v-ii = 1 to p-qh:num-buffers:
      998       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
      999       assign
     1000       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
     1001       no-error.
     1002       v-qh:add-buffer(v-bh[v-ii]).
     1003     end.
     1004     assign
     1005     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     1006                       p-where-cond + chr(32)  +
     1007                       p-use-indFIRST-query-tail + chr(32) +
     1008                       p-use-ind-sort-clmn-by + chr(32) +
     1009                       p-indexed-reposition
     1010     .
     1011     glog = v-qh:query-prepare( v-prepare-string) no-error .
     1012     if not glog then do:
     1013       delete object v-qh.
     1014       do v-ii = 1 to p-qh:num-buffers:
     1015         delete object v-bh[v-ii].
     1016       end.
     1017       undo, return error .
     1018     end.
     1019     glog = v-qh:query-open no-error .
     1020     if not glog then do:
     1021       delete object v-qh.
     1022       do v-ii = 1 to p-qh:num-buffers:
     1023         delete object v-bh[v-ii].
     1024       end.
     1025       undo, return error .
     1026     end.
     1027     if p-next then do:
     1028       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
     1029       glog = v-qh:get-next( p-lock) no-error .
     1030       glog = v-qh:get-next( p-lock) no-error .
     1031       if not glog or v-qh:query-off-end = yes then do:
     1032         glog = v-qh:get-first( p-lock) no-error .
     1033       end.
     1034     end.
     1035     else do:
     1036       glog = v-qh:get-first( p-lock) no-error .
     1037     end.
     1038     do v-ii = 1 to p-qh:num-buffers:
     1039       assign
     1040       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
     1041       no-error.
     1042     end.
     1043     delete object v-qh.
     1044     do v-ii = 1 to p-qh:num-buffers:
     1045       delete object v-bh[v-ii].
     1046     end.
     1047   end.
     1048   end procedure.
