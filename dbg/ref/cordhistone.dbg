     3457   END PROCEDURE.
     3458   PROCEDURE enable_UI :
     3459     DISPLAY v-corr-user-db-num sch-db-num sch-corr-date sch-obj-code
     3460             sch-corr-user-name mark-num
     3461         WITH FRAME Dialog-Frame.
     3462     ENABLE b-quit B-mark b-sel v-corr-user-db-num B-print B-sch
     3463            B-Help br-obj-hist sch-db-num sch-corr-date sch-obj-code
     3464            sch-corr-user-name BR-changes mark-num b-nextlevel
     3465         WITH FRAME Dialog-Frame.
     3466     VIEW FRAME Dialog-Frame.
     3467   END PROCEDURE.
     3468   PROCEDURE MyEnable :
     3469   DEFINE VARIABLE v-h AS handle NO-UNDO.
     3470   assign
     3471   br-obj-hist:num-locked-columns in frame Dialog-Frame = 1
     3472   X_c-obj-hist.corr-date:read-only in browse br-obj-hist = yes
     3473   br-changes:title = "":U
     3474   v-corr-user-db-num = v-db-num
     3475   temp-changes.l_name:resizable in browse br-changes = true
     3476   temp-changes.v_old:resizable in browse br-changes = true
     3477   temp-changes.v_new:resizable in browse br-changes = true
     3478   temp-changes.l_name:width in browse br-changes = 30
     3479   temp-changes.v_old:width in browse br-changes = 40
     3480   temp-changes.v_new:width in browse br-changes = 40
     3481   v-h = br-obj-hist:FIRST-COLUMN IN FRAME Dialog-Frame
     3482   .
     3483   DO while valid-handle(v-h) :
     3484     if v-h:LABEL = "Предмет изменения"
     3485     or v-h:LABEL = "Изменил"
     3486       then do:
     3487       v-h:RESIZABLE = YES.
     3488     end.
     3489       v-h = v-h:NEXT-COLUMN.
     3490     END.
     3491   DISPLAY
     3492   v-corr-user-db-num
     3493   sch-db-num
     3494   sch-corr-date
     3495   sch-obj-code
     3496   sch-corr-user-name
     3497   mark-num
     3498   WITH FRAME Dialog-Frame.
     3499   ENABLE
     3500   v-corr-user-db-num
     3501   b-quit
     3502   B-mark when lookup("b-mark":U, bttns) > 0
     3503   b-sel when lookup("b-sel":U, bttns) > 0
     3504   B-sch
     3505   B-Print
     3506   B-Help
     3507   br-obj-hist
     3508   sch-corr-date
     3509   sch-corr-user-name
     3510   sch-obj-code when p-mode = 'все':U
     3511   sch-db-num when p-mode = 'все':U
     3512   BR-changes mark-num
     3513   b-nextlevel
     3514   WITH FRAME Dialog-Frame.
     3515   VIEW FRAME Dialog-Frame.
     3516   HIDE sch-corr-user-name IN FRAME Dialog-Frame.
     3517   END PROCEDURE.
     3518   PROCEDURE OpenBr :
     3519   define input  parameter p-open-query     as logical   no-undo .
     3520   define input  parameter p-find-next      as logical   no-undo .
     3521   define input  parameter p-find-condition as character no-undo .
     3522   define input  parameter p-db-num like c-order-head.corr-user-db-num no-undo .
     3523   define variable l-query-was-opened as logical no-undo .
     3524   define variable title0 as character no-undo.
     3525   title0 = "Список полной истории контрагента" + chr(32).
     3526   run waitfram-show in this-procedure ("Ждите...").
     3527   define variable sort-column-phrase as character no-undo .
     3528   case sort-column-name :
     3529     when "" then do:
     3530       assign
     3531         sort-column-phrase = ""
     3532       .
     3533     end.
     3534     otherwise do:
     3535       assign
     3536         sort-column-phrase = "by " + sort-column-name
     3537       .
     3538     end.
     3539   end case.
     3540   define variable l-open-query as logical   no-undo .
     3541   if p-mode = 'все':U then
     3542   do:
     3543         assign
     3544         filter-point = filter-point0 + p-mode
     3545         filter-label = substitute("&1", filter-label0)
     3546         .
     3547   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3548   define variable  l-disable-where-27  as logical   no-undo .
     3549   define variable  l-filter-open-27    as logical   .
     3550   define variable  flt-rec-27       as recid     no-undo .
     3551   define variable  filter-name-27      as character no-undo .
     3552   define variable  where-phrase-27     as character no-undo .
     3553   define variable  sort-phrase-27      as character no-undo .
     3554   define variable  where-phrase-rus-27 as character no-undo .
     3555   define variable  sort-phrase-rus-27  as character no-undo .
     3556     run waitfram-show in this-procedure
     3557       (input "ЖДИТЕ ..."
     3558       ).
     3559   run gbl/flt-get.p
     3560     (input filter-point
     3561     ,output flt-rec-27
     3562     ,output filter-name-27
     3563     ,output where-phrase-27
     3564     ,output sort-phrase-27
     3565     ,output where-phrase-rus-27
     3566     ,output sort-phrase-rus-27
     3567     ).
     3568   if p-open-query then do:
     3569       run set-filter-name in this-procedure
     3570         (INPUT filter-name-27
     3571         ) no-error .
     3572     assign
     3573       l-filter-open-27 = false
     3574     .
     3575     if flt-rec-27 <> ?
     3576       or sort-column-phrase > ""
     3577     then do:
     3578       define variable  parameter-2-27 as character no-undo .
     3579       define variable  parameter-3-27 as character no-undo .
     3580       define variable  parameter-4-27 as character no-undo .
     3581       define variable  parameter-5-27 as character no-undo .
     3582       define variable  parameter-6-27 as character no-undo .
     3583       define variable  parameter-7-27 as character no-undo .
     3584         assign
     3585         parameter-3-27 =
     3586                                 "FOR EACH X_c-obj-hist"
     3587         parameter-4-27 =
     3588           (
     3589             if (" TRUE " + " " + where-phrase-27) <> ""
     3590             then " TRUE " + " " + where-phrase-27
     3591             else "true"
     3592           )
     3593         parameter-5-27 = (" " + "" + " " + "")
     3594         parameter-6-27 = if sort-phrase-27 = ''
     3595                              then
     3596           (
     3597           " " + " BY X_c-obj-hist.corr-date DESC BY X_c-obj-hist.corr-time DESC  " +
     3598             " " + sort-column-phrase +
     3599           " " + " BY X_c-obj-hist.corr-date DESC BY X_c-obj-hist.corr-time DESC  "
     3600           )
     3601                              else
     3602           (
     3603           " " + " BY X_c-obj-hist.corr-date DESC BY X_c-obj-hist.corr-time DESC  " +
     3604             " " + sort-column-phrase +
     3605           " " + sort-phrase-27
     3606           )
     3607         parameter-7-27 =
     3608           " indexed-reposition  "
     3609       .
     3610       do
     3611       on stop undo, leave
     3612       on error undo, leave
     3613       :
     3614         assign
     3615           l-disable-where-27 =
     3616             (" TRUE " + " " + where-phrase-27 = "")
     3617         .
     3618         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     3619                             ,input query br-obj-hist:handle
     3620                             ,input parameter-3-27
     3621                             ,input parameter-4-27
     3622                             ,input parameter-5-27
     3623                             ,input parameter-6-27
     3624                             ,input parameter-7-27
     3625                             )
     3626         .
     3627         assign
     3628           l-filter-open-27 = true
     3629         .
     3630       end.
     3631       if l-filter-open-27 = false then do:
     3632         message
     3633           "Ошибка при фильтрации / сортировке" skip
     3634           "Будут показаны записи без учета фильтра" skip
     3635           view-as alert-box .
     3636       end.
     3637       else do:
     3638           assign
     3639             l-query-was-opened = true
     3640           .
     3641       end.
     3642     end.
     3643     if l-filter-open-27 = false then do:
     3644       OPEN QUERY br-obj-hist FOR EACH X_c-obj-hist
     3645         where  TRUE
     3646          BY X_c-obj-hist.corr-date DESC BY X_c-obj-hist.corr-time DESC
     3647          BY X_c-obj-hist.corr-date DESC BY X_c-obj-hist.corr-time DESC
     3648         indexed-reposition
     3649     .
     3650         assign
     3651           l-query-was-opened = true
     3652         .
     3653     end.
     3654   end.
     3655   else do:
     3656     assign
     3657       v-doc-rec = recid( X_c-obj-hist )
     3658     .
     3659     do
     3660     on stop undo, leave
     3661     on error undo, leave
     3662     :
     3663       if query br-obj-hist:handle:get-buffer-handle(1) = (buffer X_c-obj-hist:handle) then do:
     3664         assign
     3665         parameter-2-27 = (if p-find-next then "true":u else "false":u )
     3666         parameter-4-27 =
     3667           "where ":u + " TRUE " + " ":u + where-phrase-27 + " ":u + p-find-condition + " " + ""
     3668         parameter-5-27 = " BY X_c-obj-hist.corr-date DESC BY X_c-obj-hist.corr-time DESC  "
     3669       .
     3670         run fltopend_fltfindd in this-procedure  (
     3671                             input this-procedure:handle
     3672                             ,input query br-obj-hist:handle
     3673                             ,input rowid(X_c-obj-hist)
     3674                             ,input logical(parameter-2-27)
     3675                             ,input no-lock
     3676                             ,input (buffer X_c-obj-hist:handle)
     3677                             ,input parameter-4-27
     3678                             ,input parameter-5-27
     3679                             ) no-error.
     3680         .
     3681         assign
     3682           v-doc-rec = integer(return-value)
     3683           v-fltopend-rowid[1] = ?
     3684         .
     3685       end.
     3686       else do:
     3687         assign
     3688         parameter-2-27 = (if p-find-next then "true":u else "false":u )
     3689         parameter-3-27 =  "FOR EACH X_c-obj-hist"
     3690         parameter-4-27 =
     3691           (
     3692             if (" TRUE " + " " + where-phrase-27) <> ""
     3693             then " TRUE " + " " + where-phrase-27
     3694             else "true"
     3695           )
     3696         parameter-5-27 = (" " + "" + " " + "" + " " + p-find-condition)
     3697         parameter-6-27 = if sort-phrase-27 = ''
     3698                              then
     3699           (
     3700           " " + " BY X_c-obj-hist.corr-date DESC BY X_c-obj-hist.corr-time DESC  " +
     3701             " " + sort-column-phrase +
     3702           " " + " BY X_c-obj-hist.corr-date DESC BY X_c-obj-hist.corr-time DESC  "
     3703           )
     3704                              else
     3705           (
     3706           " " + " BY X_c-obj-hist.corr-date DESC BY X_c-obj-hist.corr-time DESC  " +
     3707             " " + sort-column-phrase +
     3708           " " + sort-phrase-27
     3709           )
     3710         parameter-7-27 =
     3711           " indexed-reposition  "
     3712       .
     3713         run fltopend_fltfindq in this-procedure  (
     3714                             input this-procedure:handle
     3715                             ,input query br-obj-hist:handle
     3716                             ,input logical(parameter-2-27)
     3717                             ,input no-lock
     3718                             ,input parameter-3-27
     3719                             ,input parameter-4-27
     3720                             ,input parameter-5-27
     3721                             ,input parameter-6-27
     3722                             ,input parameter-7-27
     3723                             ,output v-fltopend-rowid
     3724                             ) no-error.
     3725         .
     3726         v-doc-rec = ?.
     3727       end.
     3728       assign
     3729         l-query-was-opened = true
     3730       .
     3731     end.
     3732   end.
     3733     run waitfram-hide in this-procedure .
     3734   end.
     3735   else do:
     3736     if not local-open-br( p-open-query      ,
     3737                           p-find-next         ,
     3738                          p-find-condition )
     3739     then do:
     3740   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3741   define variable  l-disable-where-29  as logical   no-undo .
     3742   define variable  l-filter-open-29    as logical   .
     3743   define variable  flt-rec-29       as recid     no-undo .
     3744   define variable  filter-name-29      as character no-undo .
     3745   define variable  where-phrase-29     as character no-undo .
     3746   define variable  sort-phrase-29      as character no-undo .
     3747   define variable  where-phrase-rus-29 as character no-undo .
     3748   define variable  sort-phrase-rus-29  as character no-undo .
     3749     run waitfram-show in this-procedure
     3750       (input "ЖДИТЕ ..."
     3751       ).
     3752   run gbl/flt-get.p
     3753     (input filter-point
     3754     ,output flt-rec-29
     3755     ,output filter-name-29
     3756     ,output where-phrase-29
     3757     ,output sort-phrase-29
     3758     ,output where-phrase-rus-29
     3759     ,output sort-phrase-rus-29
     3760     ).
     3761   if p-open-query then do:
     3762       run set-filter-name in this-procedure
     3763         (INPUT filter-name-29
     3764         ) no-error .
     3765     assign
     3766       l-filter-open-29 = false
     3767     .
     3768     if flt-rec-29 <> ?
     3769       or sort-column-phrase > ""
     3770     then do:
     3771       define variable  parameter-2-29 as character no-undo .
     3772       define variable  parameter-3-29 as character no-undo .
     3773       define variable  parameter-4-29 as character no-undo .
     3774       define variable  parameter-5-29 as character no-undo .
     3775       define variable  parameter-6-29 as character no-undo .
     3776       define variable  parameter-7-29 as character no-undo .
     3777         assign
     3778         parameter-3-29 =
     3779                                 "FOR EACH X_c-obj-hist"
     3780         parameter-4-29 =
     3781           (
     3782             if (" TRUE " + " " + where-phrase-29) <> ""
     3783             then " TRUE " + " " + where-phrase-29
     3784             else "true"
     3785           )
     3786         parameter-5-29 = (" " + "" + " " + "")
     3787         parameter-6-29 = if sort-phrase-29 = ''
     3788                              then
     3789           (
     3790           " " + "" +
     3791             " " + sort-column-phrase +
     3792           " " + "  "
     3793           )
     3794                              else
     3795           (
     3796           " " + "" +
     3797             " " + sort-column-phrase +
     3798           " " + sort-phrase-29
     3799           )
     3800         parameter-7-29 =
     3801           " indexed-reposition  "
     3802       .
     3803       do
     3804       on stop undo, leave
     3805       on error undo, leave
     3806       :
     3807         assign
     3808           l-disable-where-29 =
     3809             (" TRUE " + " " + where-phrase-29 = "")
     3810         .
     3811         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     3812                             ,input query br-obj-hist:handle
     3813                             ,input parameter-3-29
     3814                             ,input parameter-4-29
     3815                             ,input parameter-5-29
     3816                             ,input parameter-6-29
     3817                             ,input parameter-7-29
     3818                             )
     3819         .
     3820         assign
     3821           l-filter-open-29 = true
     3822         .
     3823       end.
     3824       if l-filter-open-29 = false then do:
     3825         message
     3826           "Ошибка при фильтрации / сортировке" skip
     3827           "Будут показаны записи без учета фильтра" skip
     3828           view-as alert-box .
     3829       end.
     3830       else do:
     3831           assign
     3832             l-query-was-opened = true
     3833           .
     3834       end.
     3835     end.
     3836     if l-filter-open-29 = false then do:
     3837       OPEN QUERY br-obj-hist FOR EACH X_c-obj-hist
     3838         where  TRUE
     3839         indexed-reposition
     3840     .
     3841         assign
     3842           l-query-was-opened = true
     3843         .
     3844     end.
     3845   end.
     3846   else do:
     3847     assign
     3848       v-doc-rec = recid( X_c-obj-hist )
     3849     .
     3850     do
     3851     on stop undo, leave
     3852     on error undo, leave
     3853     :
     3854       if query br-obj-hist:handle:get-buffer-handle(1) = (buffer X_c-obj-hist:handle) then do:
     3855         assign
     3856         parameter-2-29 = (if p-find-next then "true":u else "false":u )
     3857         parameter-4-29 =
     3858           "where ":u + " TRUE " + " ":u + where-phrase-29 + " ":u + p-find-condition + " " + ""
     3859         parameter-5-29 = ""
     3860       .
     3861         run fltopend_fltfindd in this-procedure  (
     3862                             input this-procedure:handle
     3863                             ,input query br-obj-hist:handle
     3864                             ,input rowid(X_c-obj-hist)
     3865                             ,input logical(parameter-2-29)
     3866                             ,input no-lock
     3867                             ,input (buffer X_c-obj-hist:handle)
     3868                             ,input parameter-4-29
     3869                             ,input parameter-5-29
     3870                             ) no-error.
     3871         .
     3872         assign
     3873           v-doc-rec = integer(return-value)
     3874           v-fltopend-rowid[1] = ?
     3875         .
     3876       end.
     3877       else do:
     3878         assign
     3879         parameter-2-29 = (if p-find-next then "true":u else "false":u )
     3880         parameter-3-29 =  "FOR EACH X_c-obj-hist"
     3881         parameter-4-29 =
     3882           (
     3883             if (" TRUE " + " " + where-phrase-29) <> ""
     3884             then " TRUE " + " " + where-phrase-29
     3885             else "true"
     3886           )
     3887         parameter-5-29 = (" " + "" + " " + "" + " " + p-find-condition)
     3888         parameter-6-29 = if sort-phrase-29 = ''
     3889                              then
     3890           (
     3891           " " + "" +
     3892             " " + sort-column-phrase +
     3893           " " + "  "
     3894           )
     3895                              else
     3896           (
     3897           " " + "" +
     3898             " " + sort-column-phrase +
     3899           " " + sort-phrase-29
     3900           )
     3901         parameter-7-29 =
     3902           " indexed-reposition  "
     3903       .
     3904         run fltopend_fltfindq in this-procedure  (
     3905                             input this-procedure:handle
     3906                             ,input query br-obj-hist:handle
     3907                             ,input logical(parameter-2-29)
     3908                             ,input no-lock
     3909                             ,input parameter-3-29
     3910                             ,input parameter-4-29
     3911                             ,input parameter-5-29
     3912                             ,input parameter-6-29
     3913                             ,input parameter-7-29
     3914                             ,output v-fltopend-rowid
     3915                             ) no-error.
     3916         .
     3917         v-doc-rec = ?.
     3918       end.
     3919       assign
     3920         l-query-was-opened = true
     3921       .
     3922     end.
     3923   end.
     3924     run waitfram-hide in this-procedure .
     3925     end.
     3926   end.
     3927   if not p-open-query and v-doc-rec <> ? then
     3928   REPOSITION br-obj-hist to recid v-doc-rec No-ERROR.
     3929   if not p-open-query and v-fltopend-rowid[1] <> ? then
     3930   query br-obj-hist:handle:reposition-to-rowid(v-fltopend-rowid) No-ERROR.
     3931   run waitfram-hide in this-procedure .
     3932   APPLY "VALUE-CHANGED" TO br-obj-hist in frame Dialog-Frame.
     3933   APPLY "ENTRY" TO br-obj-hist.
     3934   END PROCEDURE.
     3935   PROCEDURE proc-b-print :
     3936   define variable date_string     as      char    no-undo.
     3937   define variable Line                as      char    no-undo.
     3938   define variable for-time as char.
     3939   define variable accum-count as integer.
     3940   define variable v-doc-rec as recid no-undo.
     3941   define variable v-subject-chr as character no-undo .
     3942   define variable v-upd-time as character no-undo .
     3943   define variable v-obj as character no-undo .
     3944   define variable v-action-chr as character no-undo .
     3945   define variable v-source-type as character no-undo .
     3946   DEFINE FRAME HistoryList
     3947   v-action-chr FORMAT "X(10)" COLUMN-LABEL "Действие"
     3948   v-subject-chr COLUMN-LABEL "Предмет изменений" FORMAT "X(20)"
     3949   X_c-obj-hist.is-news COLUMn-LABEL "СПН" FORMAT "+/ "
     3950   v-source-type COLUMn-LABEL "Источн.!измен"
     3951   X_c-obj-hist.source-ref COLUMn-LABEL "№"
     3952   X_c-obj-hist.corr-date
     3953   v-upd-time COLUMN-LABEL "Время изм." FORMAT "X(8)"
     3954   X_c-obj-hist.corr-user-name
     3955   X_c-obj-hist.corr-user-db-num
     3956   HEADER  date_string AT 5 format "X(35)"
     3957   string( "Страница " ) format "X(9)" AT 115 PAGE-NUMBER(PrnLibStream) AT 125 FORMAT ">>9" SKIP
     3958   Line format "X(195)" AT 1
     3959   with width 232 down stream-io use-text    .
     3960   Line = fill("-", 195).
     3961   date_string = cur-time-print() .
     3962   assign
     3963   v-doc-rec = recid( X_c-obj-hist ).
     3964   DO WHILE available X_c-obj-hist :
     3965         GET prev br-obj-hist.
     3966   END.
     3967   run prn-lib-open-stream  in this-procedure (
     3968                                                input parparentProc
     3969                                               ,input 43
     3970                                               ,input yes
     3971                                               ,input no
     3972                                               ).
     3973   PUT  STREAM PrnLibStream
     3974   SPACE(25) ( frame Dialog-Frame:title )
     3975   format "x(90)" SKIP(1) .
     3976   FORM HEADER
     3977   Line format "X(180)" AT 1 SKIP
     3978   "Продолжение - на следующей странице" AT 30 SKIP
     3979   with FRAME BottomFrame width 232 PAGE-BOTTOM NO-LABELS NO-BOX .
     3980   VIEW  STREAM PrnLibStream FRAME BottomFrame .
     3981   FORM with FRAME HistoryList  .
     3982   run waitfram-show in this-procedure ("Ждите...").
     3983     GET next br-obj-hist.
     3984       DO WHILE available X_c-obj-hist :
     3985         Display STREAM PrnLibStream
     3986          get-action(X_c-obj-hist.action) @ v-action-chr
     3987          get-subject(X_c-obj-hist.subject) @ v-subject-chr
     3988         X_c-obj-hist.is-news
     3989         get-source-type(X_c-obj-hist.source-type) @ v-source-type
     3990         X_c-obj-hist.source-ref
     3991         X_c-obj-hist.corr-date
     3992         string(X_c-obj-hist.corr-time, "HH:MM:SS":U) @ v-upd-time
     3993         X_c-obj-hist.corr-user-name
     3994         X_c-obj-hist.corr-user-db-num
     3995         with FRAME HistoryList .
     3996     DOWN STREAM PrnLibStream 1 with FRAME HistoryList  .
     3997     assign
     3998     accum-count = accum-count + 1
     3999     .
     4000     GET next br-obj-hist.
     4001   END.
     4002   UNDERLINE  STREAM PrnLibStream
     4003   v-action-chr
     4004   v-subject-chr
     4005   X_c-obj-hist.is-news
     4006   v-source-type
     4007   X_c-obj-hist.source-ref
     4008   X_c-obj-hist.corr-date
     4009   v-upd-time
     4010   X_c-obj-hist.corr-user-name
     4011   X_c-obj-hist.corr-user-db-num
     4012   with FRAME HistoryList .
     4013   DISPLAY STREAM PrnLibStream
     4014   "ИТОГО"  @ v-obj
     4015   string(accum-count)  @ v-action-chr
     4016   with frame HistoryList.
     4017   HIDE  STREAM PrnLibStream FRAME BottomFrame .
     4018   HIDE  STREAM PrnLibStream FRAME CheckList.
     4019   output  STREAM PrnLibStream CLOSE.
     4020   run waitfram-hide in this-procedure.
     4021   run prn-lib-prn-file in this-procedure (
     4022                                             input parparentproc
     4023                                             ,input 8
     4024                                             ).
     4025   reposition br-obj-hist to recid v-doc-rec no-error.
     4026   apply "entry" to br-obj-hist in frame Dialog-Frame.
     4027   END PROCEDURE.
     4028   PROCEDURE proc-b-sch :
     4029   assign
     4030     tbl = "c-order-head"
     4031     join-tbl = 'X_c-obj-hist'
     4032     fld = ""
     4033     lab = ""
     4034     spr = ""
     4035     dim = '0'
     4036     .
     4037   run fltfield-add in this-procedure('corr-date', 'Дата корр.', '',
     4038   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4039   run fltfield-add in this-procedure('corr-time', 'Время корр.', 'time',
     4040   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4041   run fltfield-add in this-procedure('corr-user-db-num', 'БД корр.', '',
     4042   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4043   run fltfield-add in this-procedure('corr-user-name', 'Изменил', 'usr',
     4044   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4045   run fltfield-add in this-procedure('action', 'Действие', 'hist-action',
     4046   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4047   run fltfield-add in this-procedure('subject', 'Предмет изменения', 'obj-hist-subject',
     4048   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4049   run fltfield-add in this-procedure('source-type', 'Источник измен-я', 'hist-source-type',
     4050   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4051   run fltfield-add in this-procedure('source-ref', 'Код источника измен-я', '',
     4052   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4053   Filter-Block:
     4054   DO ON STOP    UNDO Filter-Block, LEAVE Filter-Block
     4055       ON ERROR   UNDO Filter-Block, LEAVE Filter-Block
     4056       ON END-KEY UNDO Filter-Block, LEAVE Filter-Block :
     4057     run gbl/filter.w ( INPUT parparentproc
     4058                      , INPUT filter-point + chr(4) + filter-label
     4059                      , INPUT tbl
     4060                      , INPUT join-tbl
     4061                      , INPUT fld
     4062                      , INPUT lab
     4063                      , INPUT spr
     4064                      , INPUT dim ).
     4065     RUN OpenBr in this-procedure ( input yes, input no, input '':U, input v-corr-user-db-num).
     4066   END.
     4067   END PROCEDURE.
     4068   PROCEDURE proc-find-corr-date :
     4069   define input parameter p-next as logical no-undo.
     4070   define input parameter p-date like ub.fin-doc.doc-date no-undo.
     4071   define variable v-date-chr as character no-undo.
     4072   if p-date = ? then return .
     4073   display
     4074   0 @ sch-obj-code
     4075   0 @ sch-db-num
     4076   "":U @ sch-corr-user-name
     4077   with frame Dialog-Frame.
     4078   assign
     4079   v-date-chr = string(day(p-date)) + chr(47) +
     4080                    string(month(p-date)) + chr(47) +
     4081                    string(year(p-date)).
     4082          run OpenBr in this-procedure
     4083           (input false
     4084           ,input true
     4085           ,input substitute("and X_c-obj-hist.corr-date = &1 "
     4086             , v-date-chr)
     4087           ,input v-corr-user-db-num
     4088           ).
     4089         apply "entry":u to sch-corr-date in frame Dialog-Frame.
     4090   END PROCEDURE.
     4091   PROCEDURE proc-find-db-num :
     4092   define input parameter p-next as logical no-undo.
     4093   define input parameter p-db-num like c-order-head.corr-user-db-num no-undo.
     4094   define variable v-db-num as character no-undo.
     4095   assign
     4096   sch-corr-date = ?
     4097   .
     4098   display
     4099   "":U @ sch-corr-user-name
     4100   0 @ sch-obj-code
     4101   sch-corr-date
     4102   with frame Dialog-Frame.
     4103   assign
     4104   v-db-num = string(p-db-num).
     4105   run OpenBr in this-procedure
     4106       (input false
     4107       ,input p-next
     4108       ,input substitute("and X_c-obj-hist.corr-user-db-num = &1 "
     4109         , v-db-num)
     4110       ,input v-corr-user-db-num
     4111       ).
     4112   apply "entry":u to sch-db-num in frame Dialog-Frame .
     4113   END PROCEDURE.
     4114   PROCEDURE proc-find-user :
     4115   define input parameter p-next as logical no-undo.
     4116   define input parameter p-user like c-order-head.corr-user-name no-undo.
     4117   assign
     4118   sch-corr-date = ?.
     4119   display
     4120   0 @ sch-db-num
     4121   sch-corr-date
     4122   0 @ sch-obj-code
     4123   with frame Dialog-Frame.
     4124   p-user = chr(34) + p-user + chr(34).
     4125   run OpenBr in this-procedure
     4126       (input false
     4127       ,input p-next
     4128       ,input substitute("and X_c-obj-hist.corr-user-name = &1 "
     4129         , p-user)
     4130       ,input v-corr-user-db-num
     4131       ).
     4132   apply "entry":u to sch-corr-user-name in frame Dialog-Frame .
     4133   END PROCEDURE.
     4134   PROCEDURE proc-view-changes :
     4135   define variable v-description as character no-undo .
     4136   for each temp-changes:
     4137       delete temp-changes.
     4138   END.
     4139   if not available X_c-obj-hist then do:
     4140     b-nextlevel:visible IN FRAME Dialog-Frame = no.
     4141     Open QUery br-changes for each temp-changes.
     4142     return.
     4143   end.
     4144   b-nextlevel:visible IN FRAME Dialog-Frame = X_c-obj-hist.subject eq "*" .
     4145   run local-view-cange in this-procedure (output v-description) .
     4146   Open QUery br-changes for each temp-changes by temp-changes.fNotChange.
     4147   assign
     4148   br-changes:title in frame Dialog-Frame = v-description
     4149   .
     4150   END PROCEDURE.
     4151   FUNCTION get-action RETURNS CHARACTER
     4152     ( p-action as integer ) :
     4153   define variable dops as character no-undo.
     4154   assign dops = entry (lookup (trim(string(p-action)), '99,1,2,3,4,9,51,79':U), 'Удаление,Создание,Изменение,Коррекция,Восстановление,Смена_кода,Смена_артик,Выключ.':U) no-error.
     4155   RETURN dops.
     4156   END FUNCTION.
     4157   FUNCTION get-source-type RETURNS CHARACTER
     4158     ( p-source-type as character ) :
     4159   define variable v-dop as character no-undo .
     4160   assign
     4161   v-dop = entry (lookup (p-source-type, ',db,esys,trn-doc,payment,fin-doc,import,recalc,wth-doc,ren-gdsc,upgrade,grp-chg,stop-list,dis-card':U), ',БД,ВС,Документ,Платеж,Фин.док.,Импорт,Пересчет,Документ МЦ,Коллизия,Апгрейд,Изм.группы,Стоплист,ДК':U)
     4162   no-error
     4163   .
     4164   RETURN v-dop.
     4165   END FUNCTION.
     4166   function fLabel returns character :
     4167      return if p-mode eq "one"  then "История по Заказу " + string(p-doc-code-order) + " по ДБ " + string(p-db-num-order) else "История по Заказам".
     4168   end.
     4169   def var vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4170   define new global shared variable g#attr-lib  as handle no-undo .
     4171   define variable v-attr-lib-variable as handle no-undo .
     4172   def var vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4173   function getattrUtdex returns char
     4174   (idb-num   as integer,
     4175    idoc-id   as integer,
     4176    iattrcode as character,
     4177    iExValue  as character  ):
     4178      define buffer utd-attr for utd-attr.
     4179      find first utd-attr where utd-attr.db-num eq idb-num
     4180                            and utd-attr.doc-id eq idoc-id
     4181                            and utd-attr.attr-code eq iattrcode
     4182      no-lock no-error.
     4183      return if not available utd-attr  then iExValue    else  utd-attr.attr-value.
     4184   end.
     4185   function getattrUtd returns char
     4186   (idb-num   as integer,
     4187    idoc-id   as integer,
     4188    iattrcode as character ):
     4189     return getattrUtdex(idb-num,idoc-id,iattrcode,?).
     4190   end.
     4191   function setattrUtd returns logical
     4192   (idb-num   as integer,
     4193    idoc-id   as integer,
     4194    iattrcode as character,
     4195    iattrval  as character ):
     4196      define buffer utd-attr for utd-attr.
     4197      find first utd-attr where utd-attr.db-num eq idb-num
     4198                            and utd-attr.doc-id eq idoc-id
     4199                            and utd-attr.attr-code eq iattrcode
     4200      no-lock no-error.
     4201      if not available utd-attr
     4202      then do:
     4203         create utd-attr.
     4204         assign
     4205            utd-attr.db-num    = idb-num
     4206            utd-attr.doc-id    = idoc-id
     4207            utd-attr.attr-code = iattrcode
     4208            utd-attr.attr-value = iattrval
     4209         .
     4210      end.
     4211      else do:
     4212         if utd-attr.attr-value ne iattrval
     4213         then do:
     4214            find current utd-attr exclusive-lock no-error.
     4215            if available utd-attr
     4216            then
     4217               utd-attr.attr-value = iattrval.
     4218         end.
     4219      end.
     4220      release utd-attr.
     4221   end.
     4222   function GetAttrUtdlinesEx returns char
     4223   (idb-num   as integer,
     4224    idoc-id   as integer,
     4225    ilinenum  as integer,
     4226    iattrcode as character,
     4227    iExValue  as character  ):
     4228      define buffer utd-lines-attr for utd-lines-attr.
     4229      find first utd-lines-attr where utd-lines-attr.db-num    eq idb-num
     4230                                  and utd-lines-attr.doc-id    eq idoc-id
     4231                                  and utd-lines-attr.lineNum   eq ilineNum
     4232                                  and utd-lines-attr.attr-code eq iattrcode
     4233      no-lock no-error.
     4234      return if not available utd-lines-attr  then iExValue    else  utd-lines-attr.attr-value.
     4235   end.
     4236   function GetAttrUtdlines returns char
     4237   (idb-num   as integer,
     4238    idoc-id   as integer,
     4239    ilinenum  as integer,
     4240    iattrcode as character ):
     4241      return GetAttrUtdlinesex (idb-num,idoc-id,ilinenum,iattrcode,?).
     4242   end.
     4243   function setattrUtdlines returns logical
     4244   (idb-num   as integer,
     4245    idoc-id   as integer,
     4246    ilinenum  as integer,
     4247    iattrcode as character,
     4248    iattrval  as character ):
     4249      define buffer utd-lines-attr for utd-lines-attr.
     4250      find first utd-lines-attr where utd-lines-attr.db-num    eq idb-num
     4251                                  and utd-lines-attr.doc-id    eq idoc-id
     4252                                  and utd-lines-attr.lineNum   eq ilineNum
     4253                                  and utd-lines-attr.attr-code eq iattrcode
     4254      no-lock no-error.
     4255      if not available utd-lines-attr
     4256      then do:
     4257         if iattrval ne ?
     4258            and iattrval ne ""
     4259         then do:
     4260            create utd-lines-attr.
     4261            assign
     4262               utd-lines-attr.db-num    = idb-num
     4263               utd-lines-attr.doc-id    = idoc-id
     4264               utd-lines-attr.lineNum   = ilineNum
     4265               utd-lines-attr.attr-code = iattrcode
     4266               utd-lines-attr.attr-value = iattrval
     4267            .
     4268         end.
     4269      end.
     4270      else do:
     4271         if utd-lines-attr.attr-value ne iattrval
     4272         then do:
     4273            find current utd-lines-attr exclusive-lock no-error.
     4274            if available utd-lines-attr
     4275            then do:
     4276               if    iattrval eq ?
     4277                  or iattrval eq ""
     4278               then do:
     4279                  delete utd-lines-attr.
     4280               end.
     4281               else do:
     4282                  utd-lines-attr.attr-value = iattrval.
     4283               end.
     4284            end.
     4285         end.
     4286      end.
     4287      release utd-lines-attr.
     4288   end.
     4289   function GetAttrUtdMarkingLinesEx returns char
     4290   (idb-num   as integer,
     4291    idoc-id   as integer,
     4292    ilinenum  as integer,
     4293    imark     as character,
     4294    iattrcode as character,
     4295    iExValue  as character  ):
     4296      define buffer utd-marking-lines-attr for utd-marking-lines-attr.
     4297      find first utd-marking-lines-attr where utd-marking-lines-attr.db-num    eq idb-num
     4298                                          and utd-marking-lines-attr.doc-id    eq idoc-id
     4299                                          and utd-marking-lines-attr.lineNum   eq ilineNum
     4300                                          and utd-marking-lines-attr.mark      eq imark
     4301                                          and utd-marking-lines-attr.attr-code eq iattrcode
     4302      no-lock no-error.
     4303      return if not available utd-marking-lines-attr  then iExValue    else  utd-marking-lines-attr.attr-value.
     4304   end.
     4305   function GetAttrUtdMarkingLines returns char
     4306   (idb-num   as integer,
     4307    idoc-id   as integer,
     4308    ilinenum  as integer,
     4309    imark     as character,
     4310    iattrcode as character ):
     4311      return GetAttrUtdMarkingLinesEx (idb-num,idoc-id,ilinenum,imark,iattrcode,?).
     4312   end.
     4313   function setattrUtdMarkingLines returns logical
     4314   (idb-num   as integer,
     4315    idoc-id   as integer,
     4316    ilinenum  as integer,
     4317    imark     as character,
     4318    iattrcode as character,
     4319    iattrval  as character ):
     4320      define buffer utd-marking-lines-attr for utd-marking-lines-attr.
     4321      find first utd-marking-lines-attr where utd-marking-lines-attr.db-num    eq idb-num
     4322                                          and utd-marking-lines-attr.doc-id    eq idoc-id
     4323                                          and utd-marking-lines-attr.lineNum   eq ilineNum
     4324                                          and utd-marking-lines-attr.mark      eq imark
     4325                                          and utd-marking-lines-attr.attr-code eq iattrcode
     4326      no-lock no-error.
     4327      if not available utd-marking-lines-attr
     4328      then do:
     4329         if iattrval ne ?
     4330            and iattrval ne ""
     4331         then do:
     4332            create utd-marking-lines-attr.
     4333            assign
     4334               utd-marking-lines-attr.db-num     = idb-num
     4335               utd-marking-lines-attr.doc-id     = idoc-id
     4336               utd-marking-lines-attr.lineNum    = ilineNum
     4337               utd-marking-lines-attr.mark       = imark
     4338               utd-marking-lines-attr.attr-code  = iattrcode
     4339               utd-marking-lines-attr.attr-value = iattrval
     4340            .
     4341         end.
     4342      end.
     4343      else do:
     4344         if utd-marking-lines-attr.attr-value ne iattrval
     4345         then do:
     4346            find current utd-marking-lines-attr exclusive-lock no-error.
     4347            if available utd-marking-lines-attr
     4348            then do:
     4349               if    iattrval eq ?
     4350                  or iattrval eq ""
     4351               then do:
     4352                  delete utd-marking-lines-attr.
     4353               end.
     4354               else do:
     4355                  utd-marking-lines-attr.attr-value = iattrval.
     4356               end.
     4357            end.
     4358         end.
     4359      end.
     4360      release utd-marking-lines-attr.
     4361   end.
     4362   def var vss-include-info32 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4363   define variable vss-include-info33 as character format "X(65)" no-undo
     4364   initial "@(#)$Workfile$ $Revision$".
     4365   procedure xmlchar-test :
     4366   define input parameter p-in-string          as character        no-undo.
     4367   define output parameter p-out-string-enc    as character        no-undo.
     4368   define output parameter p-out-string-dec    as character        no-undo.
     4369   do
     4370   on error undo, return error
     4371   :
     4372          run xmlchar-encode in this-procedure
     4373       (
     4374             input p-in-string
     4375           , output p-out-string-enc
     4376       ).
     4377          run xmlchar-decode in this-procedure
     4378       (
     4379             input p-out-string-enc
     4380           , output p-out-string-dec
     4381       ).
     4382   end.
     4383   end .
     4384   procedure xmlchar-encode :
     4385   define input parameter p-in-string      as character        no-undo.
     4386   define output parameter p-out-string    as character        no-undo.
     4387       define variable v-position      as integer      no-undo.
     4388       define variable v-current-char  as character    no-undo.
     4389   do
     4390   on error undo, return error
     4391   :
     4392       assign
     4393           p-out-string = "":U
     4394       .
     4395       case p-in-string
     4396       :
     4397           when ?
     4398           then do:
     4399               assign
     4400                   p-out-string = "?":U
     4401               .
     4402           end.
     4403           when "?":U
     4404           then do:
     4405               assign
     4406                   p-out-string = "&#63;":U
     4407               .
     4408           end.
     4409           otherwise do:
     4410               do v-position = 1 to length( p-in-string )
     4411               :
     4412                   assign
     4413                       v-current-char = substring( p-in-string, v-position, 1 )
     4414                   .
     4415                   case v-current-char
     4416                   :
     4417                       when "&":U
     4418                       then do:
     4419                           assign
     4420                               p-out-string = p-out-string + "&amp;":U
     4421                           .
     4422                       end.
     4423                       when ">":U
     4424                       then do:
     4425                           assign
     4426                               p-out-string = p-out-string + "&gt;":U
     4427                           .
     4428                       end.
     4429                       when "<":U
     4430                       then do:
     4431                           assign
     4432                               p-out-string = p-out-string + "&lt;":U
     4433                           .
     4434                       end.
     4435                       when "'":U
     4436                       then do:
     4437                           assign
     4438                               p-out-string = p-out-string + "&apos;":U
     4439                           .
     4440                       end.
     4441                       when '"':U
     4442                       then do:
     4443                           assign
     4444                               p-out-string = p-out-string + "&quot;":U
     4445                           .
     4446                       end.
     4447                       when chr(1)
     4448                       then do:
     4449                           assign
     4450                               p-out-string = p-out-string + "":U
     4451                           .
     4452                       end.
     4453                       when chr(2)
     4454                       then do:
     4455                           assign
     4456                               p-out-string = p-out-string + "":U
     4457                           .
     4458                       end.
     4459                       when chr(3)
     4460                       then do:
     4461                           assign
     4462                               p-out-string = p-out-string + "":U
     4463                           .
     4464                       end.
     4465                       when chr(4)
     4466                       then do:
     4467                           assign
     4468                               p-out-string = p-out-string + "":U
     4469                           .
     4470                       end.
     4471                       when chr(5)
     4472                       then do:
     4473                           assign
     4474                               p-out-string = p-out-string + "":U
     4475                           .
     4476                       end.
     4477                       when chr(6)
     4478                       then do:
     4479                           assign
     4480                               p-out-string = p-out-string + "":U
     4481                           .
     4482                       end.
     4483                       when chr(7)
     4484                       then do:
     4485                           assign
     4486                               p-out-string = p-out-string + "":U
     4487                           .
     4488                       end.
     4489                       when chr(8)
     4490                       then do:
     4491                           assign
     4492                               p-out-string = p-out-string + "":U
     4493                           .
     4494                       end.
     4495                       when chr(9)
     4496                       then do:
     4497                           assign
     4498                               p-out-string = p-out-string + "":U
     4499                           .
     4500                       end.
     4501                       when chr(29)
     4502                       then do:
     4503                           assign
     4504                               p-out-string = p-out-string + "":U
     4505                           .
     4506                       end.
     4507                       when chr(10)
     4508                       then do:
     4509                           assign
     4510                               p-out-string = p-out-string + "&#10;":U
     4511                           .
     4512                       end.
     4513                       when chr(13)
     4514                       then do:
     4515                           assign
     4516                               p-out-string = p-out-string + "&#13;":U
     4517                           .
     4518                       end.
     4519                       otherwise do:
     4520                           assign
     4521                               p-out-string = p-out-string + v-current-char
     4522                           .
     4523                       end.
     4524                   end case.
     4525               end.
     4526           end.
     4527       end case.
     4528   end.
     4529   end .
     4530   procedure xmlchar-encode-1c :
     4531   define input parameter p-in-string      as character        no-undo.
     4532   define output parameter p-out-string    as character        no-undo.
     4533       define variable v-position      as integer      no-undo.
     4534       define variable v-current-char  as character    no-undo.
     4535   do
     4536   on error undo, return error
     4537   :
     4538       assign
     4539           p-out-string = "":U
     4540       .
     4541       case p-in-string
     4542       :
     4543           when ?
     4544           then do:
     4545               assign
     4546                   p-out-string = "?":U
     4547               .
     4548           end.
     4549           otherwise do:
     4550               do v-position = 1 to length( p-in-string )
     4551               :
     4552                   assign
     4553                       v-current-char = substring( p-in-string, v-position, 1 )
     4554                   .
     4555                   case v-current-char
     4556                   :
     4557                       when chr(1)
     4558                       then do:
     4559                           assign
