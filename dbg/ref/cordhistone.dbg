     2976     v-doc-rec = recid(X_c-obj-hist). run OpenBr(yes, no, no, v-corr-user-db-num). reposition br-obj-hist to recid v-doc-rec no-error.               apply 'value-changed' to br-obj-hist.
     2977       apply "VALUE-CHANGED" to BR-changes.
     2978   end.
     2979   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2980   procedure set-filter-name :
