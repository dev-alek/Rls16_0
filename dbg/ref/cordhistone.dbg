     1636      then do:
     1637         temp-changes.l_name:fGCOLOR in browse BR-changes = GRAY_COLOR.
     1638         temp-changes.v_old:fGCOLOR in browse BR-changes  = GRAY_COLOR.
     1639         temp-changes.v_new:fGCOLOR in browse BR-changes  = GRAY_COLOR.
     1640      end.
     1641      else do:
     1642         temp-changes.l_name:fGCOLOR in browse BR-changes = BLACK_COLOR.
     1643         temp-changes.v_old:fGCOLOR in browse BR-changes = BLACK_COLOR.
     1644         temp-changes.v_new:fGCOLOR in browse BR-changes = BLACK_COLOR.
     1645      end.
     1646   END.
     1647   ON CTRL-J OF sch-obj-code IN FRAME Dialog-Frame
