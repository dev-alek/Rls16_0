     3136   on ctrl-f of sch-corr-date in frame Dialog-Frame
     3137   do:
     3138     if (can-query (self, "sensitive")
     3139        and
     3140        self :sensitive = true
     3141        )
     3142     or (can-query (self, "read-only")
     3143        and
     3144        self :read-only = false
     3145        )
     3146     then do:
     3147       if self :handle <> focus :handle
     3148       then do:
     3149         apply "entry":u to self .
     3150       end.
     3151       define variable v-ok            as logical   no-undo .
     3152       define variable v-curr-sv-date  as date      no-undo .
     3153       define variable v-description   as character no-undo .
     3154       assign
     3155         v-curr-sv-date = date(self :screen-value) no-error
     3156       .
     3157       if v-curr-sv-date = ?
     3158       then do:
     3159         run gbl/getcurdt.p
     3160           (output v-curr-sv-date
     3161           ) .
     3162       end.
     3163       if v-curr-sv-date <> ?
     3164       then do:
     3165         run gbl/d-inpday.w
     3166           (input ?
     3167           ,input "Выбор даты"
     3168           ,input v-description
     3169           ,input ""
     3170           ,input-output v-curr-sv-date
     3171           ,output v-ok
     3172           ).
     3173         if v-ok = true
     3174         then do:
     3175           assign
     3176             self :screen-value = string(v-curr-sv-date) .
     3177           .
     3178         end.
     3179       end.
     3180     end.
     3181     return no-apply .
     3182   end.
     3183     define MENU m-ed-date22
     3184       MENU-ITEM m-ed-date22-1 LABEL "Начало месяца" ACCELERATOR "ALT-1"
     3185       MENU-ITEM m-ed-date22-2 LABEL "Сегодня"       ACCELERATOR "ALT-2"
     3186       MENU-ITEM m-ed-date22-3 LABEL "Конец месяца"  ACCELERATOR "ALT-3"
     3187       MENU-ITEM m-ed-date22-4 LABEL "Календарь"     ACCELERATOR "ALT-4"
     3188       .
     3189     if sch-corr-date :POPUP-MENU in frame Dialog-Frame = ?
     3190     then do:
     3191       ASSIGN
     3192         sch-corr-date :POPUP-MENU in frame Dialog-Frame = MENU m-ed-date22 :HANDLE
     3193         sch-corr-date :MENU-MOUSE in frame Dialog-Frame = 3
     3194       .
     3195     end.
     3196     define variable v-label-handle22 as handle no-undo .
     3197     assign
     3198       v-label-handle22 = sch-corr-date :side-label-handle in frame Dialog-Frame
     3199     .
     3200     if valid-handle (v-label-handle22)
     3201     then do:
     3202       if v-label-handle22 :tooltip = ""
     3203       or v-label-handle22 :tooltip = ?
     3204       then do:
