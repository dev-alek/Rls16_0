        1   define input  parameter p-db-num-order as int64 no-undo.
        2   define input  parameter p-doc-code-order as int64 no-undo.
        3   define variable orderStatus  as class ibs.th.str.order.sts.order no-undo .
        4   orderStatus =  new ibs.th.str.order.sts.order().
        5   def var objSrv as class ibs.th.gbl.sys.objsrv no-undo.
        6   run gbl/getobjsrvhndl.p (input-output ObjSrv).
        7   define variable vLabel as character no-undo.
        8   vLabel = "История по Заказу " + string(p-doc-code-order) + " по ДБ " + string(p-db-num-order).
        9   define temp-table X_c-obj-hist like c-order-head use-index chip-num use-index corr-user-db-num use-index user-name use-index sub
       10                   field line-num like ub.order-line.line-num
       11                   field attr-code like ub.order-doc-attr.attr-code
       12                   index pi-2 is primary unique
       13                     db-num asc
       14                     doc-code asc
       15                     line-num asc
       16                     attr-code asc
       17                     corr-user-db-num asc
       18                     chip-num asc
       19                     subject asc.
       20   DEFINE BUFFER find_c-obj-hist FOR X_c-obj-hist.
       21   DEFINE BUFFER X_curr-sysconf FOR sysconf.
       22   DEFINE BUFFER X_db FOR db.
       23   DEFINE BUFFER X_sysconf FOR sysconf.
       24   define input     parameter parParentProc  as widget-handle no-undo.
       25   define input parameter p-curr-host-code like ub.sysconf.host-code no-undo.
       26   define input parameter p-curr-obj-type like ub.clients.obj-type no-undo.
       27   define input parameter p-curr-obj-code like ub.clients.obj-code no-undo.
       28   define input parameter bttns  as char   no-undo .
       29   define input parameter p-mode  as char   no-undo .
       30   define input parameter p-corr-user-db-num  like ub.c-cli-hist.corr-user-db-num no-undo .
       31   define input parameter p-corr-user-name  like ub.c-cli-hist.corr-user-name no-undo .
       32   define input parameter p-subject  like ub.c-cli-hist.subject no-undo .
       33   define input parameter p-db-num  like ub.c-cli-hist.corr-user-db-num no-undo .
       34   define input parameter p-chip-num  as int64 no-undo.
       35   define input-output param p-rid-list    as  char no-undo .
       36   define variable vss-revision    AS CHAR NO-UNDO INIT "$Revision$":U.
       37   define variable vss-author      AS CHAR NO-UNDO INIT "$Author$":U.
       38   define variable vss-date        AS CHAR NO-UNDO INIT "$Date$":U.
       39   define variable vss-workfile    AS CHAR NO-UNDO INIT "$Workfile$":U.
       40   define variable vss-archive     AS CHAR NO-UNDO INIT "$Archive$":U.
       41   define variable vss-description AS CHAR NO-UNDO INIT "Список полной истории":U.
       42   procedure vss-get-info :
       43     define output parameter p-vss-revision    like vss-revision    no-undo .
       44     define output parameter p-vss-author      like vss-author      no-undo .
       45     define output parameter p-vss-date        like vss-date        no-undo .
       46     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       47     define output parameter p-vss-archive     like vss-archive     no-undo .
       48     define output parameter p-vss-description like vss-description no-undo .
       49     assign
       50       p-vss-revision    = vss-revision
       51       p-vss-author      = vss-author
       52       p-vss-date        = vss-date
       53       p-vss-workfile    = vss-workfile
       54       p-vss-archive     = vss-archive
       55       p-vss-description = vss-description
       56     .
       57   end procedure.
       58   procedure vss-get-parameters :
       59     define output parameter p-vss-parameters as character no-undo .
       60   end procedure.
       61   define new global shared variable g#vssrevis-logger as handle    no-undo .
       62   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       63   define variable v-vssrevis-logger                   as handle    no-undo .
       64   procedure vss-logevent :
       65     define input  parameter p-extra-paramters as character no-undo .
       66     define variable v-vssrevis-parameters as character no-undo .
       67     do
       68     on error undo, return error return-value
       69     :
       70       if  valid-handle(v-vssrevis-logger)
       71       and v-vssrevis-logger :get-signature("logevent") <> ""
       72       then do:
       73         run vss-get-parameters in this-procedure
       74           (output v-vssrevis-parameters
       75           ).
       76         run logevent in v-vssrevis-logger
       77           (input vss-workfile
       78           ,input vss-revision
       79           ,input v-vssrevis-parameters
       80           ,input p-extra-paramters
       81           ).
       82       end.
       83     end.
       84   end procedure.
       85   assign
       86     v-vssrevis-logger = g#vssrevis-logger
       87   .
       88   if  valid-handle(v-vssrevis-logger)
       89   and v-vssrevis-logger :get-signature("logevent") <> ""
       90   then do:
       91     assign
       92       v-vssrevis-logevent = true
       93     .
       94     run vss-logevent in this-procedure (input vss-description) .
       95   end.
       96   define new global shared variable g#language as character no-undo .
       97   if g#language <> '' and g#language <> 'rus':U then do:
       98     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       99   end.
      100   define new global shared variable g#library  as handle no-undo .
      101   define new global shared variable g#library2 as handle no-undo .
      102   procedure proc-alt-shift-f2:
