     1584         (
     1585          p-db-num-order,
     1586          p-doc-code-order,
     1587          parParentProc,
     1588          p-curr-host-code,
     1589          p-curr-obj-type,
     1590          p-curr-obj-code,
     1591          bttns,
     1592          "one",
     1593          p-corr-user-db-num,
     1594          p-corr-user-name,
     1595          p-subject,
     1596          p-db-num,
     1597          X_c-obj-hist.chip-num ,
     1598          input-output p-rid-list ).
     1599      apply "entry" to br-obj-hist in frame Dialog-Frame.
     1600   END.
