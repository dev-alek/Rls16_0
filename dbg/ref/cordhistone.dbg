     7037   end.
     7038   procedure getRecordsByChipNum:
     7039     define input parameter iXObjHist as handle no-undo.
     7040     define input parameter iTable as character no-undo.
     7041     define variable vXObjHist   as handle    no-undo.
     7042     define variable vHistTable  as character no-undo.
     7043     define variable vQuery      as handle    no-undo.
     7044     define variable vEachWhere  as character no-undo .
     7045     define variable vBufSubj    as handle    no-undo.
     7046     vHistTable = substitute("c-&1",iTable).
     7047     CREATE BUFFER vBufSubj FOR TABLE vHistTable.
     7048     vEachWhere  = substitute(
     7049       "for each &1 where &1.db-num = &2 and &1.doc-code = &3 and &1.corr-user-db-num = &4 and &1.chip-num = &5"
     7050       ,vHistTable
     7051       ,c-order-head.db-num
     7052       ,c-order-head.doc-code
     7053       ,c-order-head.corr-user-db-num
     7054       ,c-order-head.chip-num)
     7055     .
     7056     create query vQuery.
     7057     vQuery:set-buffers(vBufSubj).
     7058     vQuery:query-prepare(vEachWhere).
     7059     vQuery:query-open.
     7060     vQuery:get-first(no-lock).
     7061     do while not vQuery:query-off-end:
     7062       if iXObjHist = ? then do:
     7063         create buffer vXObjHist for table "X_c-obj-hist".
     7064         vXObjHist:buffer-copy(buffer c-order-head:handle).
     7065       end.
     7066       else vXObjHist = iXObjHist.
     7067       vXObjHist:buffer-copy(vQuery:get-buffer-handle()).
     7068       vXObjHist:buffer-field("subject"):buffer-value = iTable.
     7069       vQuery:get-next(no-lock).
     7070     end.
     7071     vQuery:QUERY-CLOSE().
     7072     DELETE OBJECT vQuery.
     7073   end procedure.
     7074   procedure order-doc-proc :
     7075     define variable vIndexLabel     as integer no-undo.
     7076     define variable vIndexMethod    as integer no-undo.
     7077     define variable vListNameFields as character no-undo.
     7078     define variable vListLabelParam as character no-undo.
     7079     define buffer buf_c-order-doc for ub.c-order-doc .
     7080     define buffer b_File         for ub._File.
     7081     define buffer b_Field        for ub._Field.
     7082     do
     7083     on error undo, return error return-value
     7084     :
     7085       find first buf_c-order-doc no-lock where
     7086                  buf_c-order-doc.corr-user-db-num = X_c-obj-hist.corr-user-db-num
     7087              and buf_c-order-doc.chip-num         = X_c-obj-hist.chip-num no-error.
     7088       if not avail buf_c-order-doc then
     7089       do:
     7090         return error  "Неверная ссылка на c-order-doc в таблице c-order-head" .
     7091       end.
     7092       for first b_File no-lock where
     7093                 b_File._File-name = 'order-doc',
     7094           each b_Field no-lock where
     7095                b_Field._File-recid = recid(b_file):
     7096         if can-do('"', b_Field._Field-name) then next.
     7097         vListNameFields = substitute("&1&2&3",vListNameFields, if vListNameFields = "" then "" else ",", b_Field._Field-name).
     7098         vIndexLabel = lookup(b_Field._Field-name, '"').
     7099         vIndexMethod = lookup(b_Field._Field-name, 'sts,getStsOrder').
     7100         vListLabelParam = substitute("&1&2&3&6&4&6&5",
     7101                           vListLabelParam,
     7102                           if vListLabelParam = "" then "" else chr(8),
     7103                           b_Field._Field-name,
     7104                           if vIndexLabel > 0 then entry(vIndexLabel + 1,'"') else b_Field._Label,
     7105                           if vIndexMethod > 0 then entry(vIndexMethod + 1,'sts,getStsOrder') else "",
     7106                           chr(4)).
     7107       end.
     7108       run proc-full-temp-changes in this-procedure
     7109         (input buf_c-order-doc.action = integer('1':U)
     7110         ,input buf_c-order-doc.action = integer('99':U)
     7111         ,input buffer buf_c-order-doc:handle
     7112         ,input "order-doc"
     7113         ,input vListNameFields
     7114         ,input vListLabelParam).
     7115     end.
     7116   end procedure.
