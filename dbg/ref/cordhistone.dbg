     1069   define buffer X_clients-obj for ub.clients.
     1070   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1071   define   temp-table temp-changes no-undo
     1072   field f_name as character
     1073   field l_name as character
     1074   field v_old as character
     1075   field v_new as character
     1076   field t_name as character
     1077   field num_ as integer
     1078   field uniq-key-rec as character
     1079   field action as integer
     1080   field fNotChange as logical
     1081   index pi is unique primary
     1082   num_
     1083   t_name
     1084   f_name
     1085   index
     1086   Chan
     1087   fnotChange
     1088   t_name
     1089   f_name
     1090   index imain uniq-key-rec
     1091   .
     1092   FUNCTION get-all-fields returns character (p-file-name as character ):
     1093   define variable v-dop as character no-undo .
     1094     find first _file no-lock where _file._file-name = p-file-name no-error .
     1095     if not available _file then return "":U.
     1096     for each _field no-lock where
     1097              _field._file-recid = recid(_file) :
     1098       assign
     1099       v-dop = v-dop + _field._field-name + chr(44)
     1100       .
     1101     end.
     1102     return trim(v-dop).
     1103   END FUNCTION.
     1104   PROCEDURE proc-full-temp-changes :
     1105     define input  parameter p-act-create as logical   no-undo .
     1106     define input  parameter p-act-delete as logical   no-undo .
     1107     define input  parameter p-hst-handle as handle    no-undo .
     1108     define input  parameter p-main-table as character no-undo .
     1109     define input  parameter p-field-list as character no-undo .
     1110     define input  parameter p-label-form as character no-undo .
     1111     define variable h-new-buf         as handle    no-undo .
     1112     define variable h-main-buf        as handle    no-undo .
     1113     define variable h-for-comp        as handle    no-undo .
     1114     define variable v-inform          as character no-undo .
     1115     define variable v-ind             as integer   no-undo .
     1116     define variable v-idx-field-qnty  as integer   no-undo .
     1117     define variable v-num-entries     as integer   no-undo .
     1118     define variable fh                as handle    no-undo .
     1119     define variable fh-main           as handle    no-undo .
     1120     define variable fh-old            as handle    no-undo .
     1121     define variable fh-new            as handle    no-undo .
     1122     define variable v-field-name      as character no-undo .
     1123     define variable v-field-lvl       as character no-undo .
     1124     define variable v-field-form      as character no-undo .
     1125     define variable v-search-exp      as character no-undo .
     1126     define variable v-srch-main       as character no-undo .
     1127     define variable v-word-link       as character no-undo .
     1128     define variable v-av-chip-num     as logical   no-undo .
     1129     define variable v-main-pi-fld-lst as character no-undo .
     1130     define variable v-main-fld-lst    as character no-undo .
     1131     define variable v-delim-list      as character no-undo .
     1132     define variable v-label           as character no-undo .
     1133     define variable v-old-value       as character no-undo case-sensitive.
     1134     define variable v-new-value       as character no-undo case-sensitive.
     1135     define variable v-chg-fields as character no-undo.
     1136     for each temp-changes:
     1137       delete temp-changes.
     1138     end.
     1139     if not p-hst-handle:available then do:
     1140       return .
     1141     end.
     1142     create buffer h-new-buf  for table p-hst-handle .
     1143     create buffer h-main-buf for table p-main-table .
     1144     assign
     1145       v-inform = h-main-buf:index-information(1)
     1146       v-ind    = 2
     1147     .
     1148     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1149     on error undo, return error
     1150     :
     1151       assign
     1152         v-inform = h-main-buf:index-information( v-ind )
     1153         v-ind    = v-ind + 1
     1154       .
     1155     end.
     1156     if v-inform = ?
     1157       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1158       or entry( 3, v-inform, ",":U ) <> "1":U
     1159     then do:
     1160       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, h-main-buf:name ).
     1161     end.
     1162     assign
     1163       v-idx-field-qnty = num-entries( v-inform ) - 4
     1164     .
     1165     if v-idx-field-qnty < 2 then do:
     1166       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, h-main-buf:name ).
     1167     end.
     1168     assign
     1169       v-srch-main   = "where":U
     1170       v-word-link   = "":U
     1171       v-av-chip-num = false
     1172       v-delim-list  = "":U
     1173     .
     1174     do v-ind = 1 to v-idx-field-qnty by 2
     1175     on error undo, return error
     1176     :
     1177       assign
     1178         v-field-name      = entry( 4 + v-ind, v-inform, ",":U )
     1179         fh                = p-hst-handle:buffer-field( v-field-name )
     1180         fh-main           = h-main-buf:buffer-field( v-field-name )
     1181         v-srch-main       = substitute( "&1 &2 &3.&4 =", v-srch-main, v-word-link, fh-main:table, v-field-name )
     1182         v-main-pi-fld-lst = v-main-pi-fld-lst + v-delim-list + v-field-name
     1183       .
     1184       if fh:data-type ="character":U then do:
     1185         assign
     1186           v-srch-main = substitute( '&1 "&2"', v-srch-main, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
     1187         .
     1188       end.
     1189       else do:
     1190         assign
     1191           v-srch-main = substitute( "&1 &2", v-srch-main, fh:buffer-value() )
     1192         .
     1193       end.
     1194       if v-delim-list = "":U then do:
     1195         assign
     1196           v-delim-list = ",":U
     1197         .
     1198       end.
     1199       if v-word-link = "":U then do:
     1200         assign
     1201           v-word-link = "and":U
     1202         .
     1203       end.
     1204     end.
     1205     assign
     1206       v-delim-list  = "":U
     1207     .
     1208     do v-ind = 1 to h-main-buf:num-fields
     1209     on error undo, return error
     1210     :
     1211       assign
     1212         fh-main      = h-main-buf:buffer-field( v-ind )
     1213         v-field-name = fh-main:name
     1214       .
     1215         assign
     1216           v-main-fld-lst = v-main-fld-lst + v-delim-list + v-field-name
     1217         .
     1218         if v-delim-list = "":U then do:
     1219           assign
     1220             v-delim-list = ",":U
     1221           .
     1222         end.
     1223     end.
     1224     assign
     1225       v-inform = p-hst-handle:index-information(1)
     1226       v-ind    = 2
     1227     .
     1228     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1229     on error undo, return error
     1230     :
     1231       assign
     1232         v-inform = p-hst-handle:index-information( v-ind )
     1233         v-ind    = v-ind + 1
     1234       .
     1235     end.
     1236     if v-inform = ?
     1237       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1238       or entry( 3, v-inform, ",":U ) <> "1":U
     1239     then do:
     1240       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, p-hst-handle:name ).
     1241     end.
     1242     assign
     1243       v-idx-field-qnty = num-entries( v-inform ) - 4
     1244     .
     1245     if v-idx-field-qnty < 2 then do:
     1246       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, p-hst-handle:name ).
     1247     end.
     1248     assign
     1249       v-search-exp  = "where":U
     1250       v-word-link   = "":U
     1251       v-av-chip-num = false
     1252     .
     1253     do v-ind = 1 to v-idx-field-qnty by 2
     1254     on error undo, return error
     1255     :
     1256       assign
     1257         v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     1258         fh           = p-hst-handle:buffer-field( v-field-name )
     1259         v-search-exp = substitute( "&1 &2 &3.&4", v-search-exp, v-word-link, fh:table, v-field-name )
     1260       .
     1261       if v-field-name = "chip-num":U then do:
     1262         assign
     1263           v-search-exp  = substitute( "&1 >", v-search-exp )
     1264           v-av-chip-num = true
     1265         .
     1266       end.
     1267       else do:
     1268         assign
     1269           v-search-exp = substitute( "&1 =", v-search-exp )
     1270         .
     1271       end.
     1272       if fh:data-type ="character":U then do:
     1273         assign
     1274           v-search-exp = substitute( '&1 "&2"', v-search-exp, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
     1275         .
     1276       end.
     1277       else do:
     1278         assign
     1279           v-search-exp = substitute( '&1 &2', v-search-exp, fh:buffer-value() )
     1280         .
     1281       end.
     1282       if v-word-link = "":U then do:
     1283         assign
     1284           v-word-link = "and":U
     1285         .
     1286       end.
     1287     end.
     1288     if v-av-chip-num = false then do:
     1289       message
     1290         vss-workfile vss-revision vss-description skip
     1291         substitute( "Таблица &2 не содержит поля chip-num.", vss-workfile, p-hst-handle:name ) skip
     1292         "Использование данной процедуры невозможно!" skip
     1293         view-as alert-box error .
     1294       return error .
     1295     end.
     1296     h-new-buf:find-first( v-search-exp, no-lock ) no-error .
     1297     if not h-new-buf:available then do:
     1298       h-main-buf:find-first( v-srch-main, no-lock ) no-error .
     1299       if not h-main-buf:available then do:
     1300         assign
     1301           h-for-comp = ?
     1302         .
     1303       end.
     1304       else do:
     1305         assign
     1306           h-for-comp = h-main-buf
     1307         .
     1308       end.
     1309     end.
     1310     else do:
     1311       assign
     1312         h-for-comp = h-new-buf
     1313       .
     1314     end.
     1315     assign
     1316       v-num-entries = num-entries( v-main-fld-lst, ",":U )
     1317     .
     1318     do v-ind = 1 to v-num-entries
     1319     on error undo, return error return-value
     1320     :
     1321       assign
     1322         v-field-name = entry( v-ind, v-main-fld-lst )
     1323         fh-old       = p-hst-handle:buffer-field( v-field-name )
     1324         v-old-value  = fh-old:buffer-value()
     1325         v-label      = trim( fh-old:label )
     1326       .
     1327       if ( trim( p-field-list ) <> "":U
     1328            and lookup( v-field-name, p-field-list ) > 0
     1329          )
     1330          or trim( p-field-list ) = "":U
     1331       then do:
     1332         if h-for-comp <> ? then do:
     1333           assign
     1334             fh-new      = h-for-comp:buffer-field( v-field-name )
     1335             v-new-value = fh-new:buffer-value()
     1336           .
     1337         end.
     1338         else do:
     1339           assign
     1340             v-new-value = "":U
     1341           .
     1342         end.
     1343           if p-act-create = true then do:
     1344             assign
     1345               v-old-value = "":U
     1346             .
     1347           end.
     1348           if p-act-delete = true then do:
     1349             assign
     1350               v-new-value = "":U
     1351             .
     1352           end.
     1353         if v-old-value <> v-new-value
     1354           or lookup(v-field-name,v-main-pi-fld-lst) ne 0
     1355         then do:
     1356           create temp-changes.
     1357           assign
     1358             temp-changes.t_name = p-main-table
     1359             temp-changes.f_name = v-field-name
     1360             temp-changes.l_name = replace( v-label, "&":U, "":U )
     1361             temp-changes.v_old  = trim( v-old-value )
     1362             temp-changes.v_new  = trim( v-new-value )
     1363             temp-changes.num_   = 0
     1364             temp-changes.fNotChange = v-old-value eq v-new-value
     1365           .
     1366         end.
     1367       end.
     1368     end.
     1369     assign
     1370       v-num-entries = num-entries( p-label-form, chr(8) )
     1371     .
     1372     do v-ind = 1 to v-num-entries
     1373     on error undo, return error return-value
     1374     :
     1375       if num-entries( entry( v-ind, p-label-form, chr(8) ), chr(4) ) = 3 then do:
     1376         assign
     1377           v-field-name = entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1378           v-field-lvl  = entry( 2, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1379           v-field-form = entry( 3, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1380         .
     1381         find first temp-changes
     1382           where temp-changes.f_name = v-field-name
     1383           no-error .
     1384         if available temp-changes then do:
     1385           if trim( v-field-lvl ) <> "":U then do:
     1386             assign
     1387               temp-changes.l_name = v-field-lvl
     1388             .
     1389           end.
     1390           if trim( v-field-form ) <> "":U then do:
     1391             assign
     1392               temp-changes.v_old = dynamic-function( v-field-form, temp-changes.v_old )
     1393             .
     1394             if h-for-comp <> ? then do:
     1395               assign
     1396                 temp-changes.v_new = dynamic-function( v-field-form, temp-changes.v_new )
     1397               .
     1398             end.
     1399           end.
     1400         end.
     1401       end.
     1402       else do:
     1403         message
     1404           vss-workfile vss-revision vss-description skip
     1405           "Ошибка! Список должен содержать три поля с разделителем delim-par!" skip
     1406           substitute( "список для поля '&1': '&2'"
     1407                       ,entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1408                       ,entry( v-ind, p-label-form, chr(8) )
     1409                     ) skip
     1410           substitute( "полный список: &2", p-label-form ) skip
     1411           view-as alert-box error .
     1412       end.
     1413     end.
     1414     delete object h-new-buf .
     1415     delete object h-main-buf .
     1416   END PROCEDURE.
     1417   FUNCTION get-action RETURNS CHARACTER
     1418     ( p-action as integer )  FORWARD.
     1419   FUNCTION get-source-type RETURNS CHARACTER
     1420     ( p-source-type as character )  FORWARD.
     1421   FUNCTION get-subject RETURNS CHARACTER
     1422     ( p-subject as character )  FORWARD.
     1423   FUNCTION local-open-br RETURNS logical
     1424     (  p-open-query     as logical    ,
     1425     p-find-next       as logical    ,
     1426     p-find-condition as character )  FORWARD.
     1427   DEFINE BUTTON B-Help
     1428        LABEL "Помо&щь"
     1429        SIZE 3 BY 1
     1430        BGCOLOR 8 .
     1431   DEFINE BUTTON B-mark
     1432        LABEL "&*"
     1433        SIZE 3 BY 1.
     1434   DEFINE BUTTON B-print
     1435        LABEL "Пе&чать"
     1436        SIZE 3 BY 1.
     1437   DEFINE BUTTON b-quit AUTO-END-KEY
     1438        LABEL "&Выход"
     1439        SIZE 10 BY 1
     1440        BGCOLOR 8 .
     1441   DEFINE BUTTON b-reason
     1442        LABEL "&Причина"
     1443        SIZE 10 BY 1.
     1444   DEFINE BUTTON B-sch
     1445        LABEL "&Фильтр"
     1446        SIZE 3 BY 1.
     1447   DEFINE BUTTON b-sel AUTO-GO
     1448        LABEL "Вы&бор"
     1449        SIZE 10 BY 1
     1450        BGCOLOR 8 .
     1451   DEFINE BUTTON b-nextlevel
     1452        LABEL "Детали"
     1453        SIZE 10 BY 1
     1454        BGCOLOR 8 .
     1455   DEFINE VARIABLE mark-num AS CHARACTER FORMAT "X(256)":U
     1456         VIEW-AS TEXT
     1457        SIZE 6 BY 1
     1458        FGCOLOR 4  NO-UNDO.
     1459   DEFINE VARIABLE sch-obj-code AS CHARACTER FORMAT "X(50)":U
     1460        LABEL "коду"
     1461        VIEW-AS FILL-IN
     1462        SIZE 10 BY 1 TOOLTIP "Поиск первой записи - <ВВОД>; поиск следующей - <CTRL-J>" NO-UNDO.
     1463   DEFINE VARIABLE sch-corr-date AS DATE FORMAT "99/99/9999":U
     1464        LABEL "Дате изменения"
     1465        VIEW-AS FILL-IN
     1466        SIZE 11 BY 1 NO-UNDO.
     1467   DEFINE VARIABLE sch-corr-user-name AS CHARACTER FORMAT "X(9)":U
     1468        LABEL "пользователю"
     1469        VIEW-AS FILL-IN
     1470        SIZE 12 BY 1 TOOLTIP "Поиск первой записи - <ВВОД>; поиск следующей - <CTRL-J>" NO-UNDO.
     1471   DEFINE VARIABLE sch-db-num AS INTEGER FORMAT ">>>>>>9":U INITIAL 0
     1472        LABEL "БД"
     1473        VIEW-AS FILL-IN
     1474        SIZE 8 BY 1 TOOLTIP "Поиск первой записи - <ВВОД>; поиск следующей - <CTRL-J>" NO-UNDO.
     1475   DEFINE VARIABLE v-corr-user-db-num AS INTEGER FORMAT ">>>>9":U INITIAL 0
     1476        LABEL "по БД"
     1477        VIEW-AS FILL-IN
     1478        SIZE 6 BY 1 NO-UNDO.
     1479   DEFINE QUERY BR-changes FOR
     1480         temp-changes SCROLLING.
     1481   DEFINE QUERY br-obj-hist FOR
     1482         X_c-obj-hist SCROLLING.
     1483   DEFINE BROWSE BR-changes
     1484     QUERY BR-changes DISPLAY
     1485         temp-changes.l_name COLUMn-LABEL "Изменилось" format "X(200)" width 40
     1486   temp-changes.v_old COLUMn-LABEL "Было" format "X(255)"
     1487   temp-changes.v_new COLUMn-LABEL "Стало" format "X(255)"
     1488       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 7.25.
     1489   DEFINE BROWSE br-obj-hist
     1490     QUERY br-obj-hist NO-LOCK DISPLAY
     1491         mark-string(recid(X_c-obj-hist), v-rid-list) COLUMN-LABEL "*" FORMAT "X(1)":U
     1492         X_c-obj-hist.corr-date FORMAT "99/99/9999":U COLUMN-LABEL "Дата изм."
     1493         string(X_c-obj-hist.corr-time, "HH:MM:SS":U) COLUMN-LABEL "Время изм." FORMAT "X(8)":U
     1494         usrfulnf(X_c-obj-hist.corr-user-name) COLUMn-LABEL "Изменил" FORMAT "X(255)":U width 18
     1495         get-action(X_c-obj-hist.action) COLUMN-LABEL "Действие" FORMAT "X(10)":U
     1496         X_c-obj-hist.corr-user-db-num FORMAT ">>>>9":U COLUMN-LABEL "Дб!созд."
     1497         X_c-obj-hist.is-news FORMAT "+/":U COLUMN-LABEL "Прием.!нов."
     1498         get-source-type(X_c-obj-hist.source-type) COLUMN-LABEL "Источн.!измен." WIDTH 7
     1499         X_c-obj-hist.source-ref FORMAT "X(20)":U COLUMN-LABEL "Ссылка на!источник." WIDTH 9
     1500          get-subject(X_c-obj-hist.subject) COLUMN-LABEL "Предмет изменения" FORMAT "X(35)":U WIDTH 15
     1501     ENABLE
     1502         X_c-obj-hist.corr-date
     1503       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 11.46.
     1504   DEFINE FRAME Dialog-Frame
     1505        b-quit AT ROW 1 COL 1
     1506        B-mark AT ROW 1 COL 11
     1507        b-sel AT ROW 1 COL 21
     1508        v-corr-user-db-num AT ROW 1 COL 37 COLON-ALIGNED
     1509        b-nextlevel AT ROW 1 COL 70
     1510        b-reason AT ROW 1 COL 59
     1511        B-print AT ROW 1 COL 89
     1512        B-sch AT ROW 1 COL 92
     1513        B-Help AT ROW 1 COL 95
     1514        br-obj-hist AT ROW 2 COL 1
     1515        sch-db-num AT ROW 13.63 COL 60.13 COLON-ALIGNED
     1516        sch-corr-date AT ROW 13.63 COL 85.75 COLON-ALIGNED
     1517        sch-obj-code AT ROW 13.67 COL 45.13 COLON-ALIGNED
     1518        sch-corr-user-name AT ROW 13.71 COL 22.5 COLON-ALIGNED
     1519        BR-changes AT ROW 14.79 COL 1
     1520        mark-num AT ROW 1 COL 12.5 COLON-ALIGNED NO-LABEL
     1521        "ПОИСК ПО" VIEW-AS TEXT
     1522             SIZE 8.38 BY 1 AT ROW 13.63 COL 1.38
     1523             FGCOLOR 4
     1524        SPACE(89.48) SKIP(7.44)
     1525       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1526            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1527            TITLE
     1528            vLabel
     1529            CANCEL-BUTTON b-quit.
     1530   ASSIGN
     1531          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1532          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1533   ASSIGN
     1534          br-obj-hist:COLUMN-RESIZABLE IN FRAME Dialog-Frame       = TRUE.
     1535   ON GO OF FRAME Dialog-Frame
     1536   DO:
     1537     p-rid-list = v-rid-list.
     1538   END.
     1539   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1540   DO:
     1541     APPLY "END-ERROR":U TO SELF.
     1542   END.
     1543   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
     1544   DO:
     1545   define variable loc#log as logical no-undo .
     1546     if available X_c-obj-hist then do:
     1547   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1548   define variable v-str-recid15 as character no-undo .
     1549   define variable v-num-entry15 as integer   no-undo .
     1550   assign
     1551     v-str-recid15 = trim( string( recid( X_c-obj-hist ) , "->>>>>>>>>>>9":U ) )
     1552     v-num-entry15 = lookup( v-str-recid15 , v-rid-list )
     1553   .
     1554   if v-num-entry15 > 0 then do:
     1555     assign
     1556       entry( v-num-entry15, v-rid-list ) = "":U
     1557       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1558     .
     1559   end.
     1560   else do:
     1561     assign
     1562       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid15
     1563     .
     1564   end.
     1565       loc#log = br-obj-hist:refresh() .
     1566       if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
     1567           loc#log = br-obj-hist:select-next-row ().
     1568           apply "VALUE-CHANGED" to br-obj-hist in frame Dialog-Frame.
     1569       end.
     1570       if num-entries( v-rid-list ) = 0
     1571       then
     1572           hide mark-num in frame Dialog-Frame.
     1573       else
     1574           disp num-entries( v-rid-list ) @ mark-num with frame Dialog-Frame.
     1575     end.
     1576     apply "entry" to br-obj-hist in frame Dialog-Frame.
     1577   END.
     1578   ON CHOOSE OF b-nextlevel IN FRAME Dialog-Frame
     1579   DO:
     1580      define variable vRun as character no-undo.
