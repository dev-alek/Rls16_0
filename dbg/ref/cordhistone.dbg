     2990         .
     2991       end.
     2992       else do:
     2993         assign
     2994           b-sch :tooltip = ""
     2995         .
     2996       end.
     2997     end.
     2998   end procedure.
     2999   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3000   on ' ' of sch-corr-date in frame Dialog-Frame
     3001   do:
     3002     if (can-query (self, "sensitive")
     3003        and
     3004        self :sensitive = true
     3005        )
     3006     or (can-query (self, "read-only")
     3007        and
     3008        self :read-only = false
     3009        )
     3010     then do:
     3011       assign
     3012         self :screen-value = ?
     3013       .
     3014     end.
     3015     return no-apply.
     3016   end.
     3017   on delete-character of sch-corr-date in frame Dialog-Frame
     3018   do:
     3019     if (can-query (self, "sensitive")
     3020        and
     3021        self :sensitive = true
     3022        )
     3023     or (can-query (self, "read-only")
     3024        and
     3025        self :read-only = false
     3026        )
     3027     then do:
     3028       assign
     3029         self :screen-value = ?
     3030       .
     3031     end.
     3032     return no-apply.
     3033   end.
     3034   on ctrl-d of sch-corr-date in frame Dialog-Frame
     3035   do:
     3036     define variable v-curr-sv-date as date no-undo .
     3037     if (can-query (self, "sensitive")
     3038        and
     3039        self :sensitive = true
     3040        )
     3041     or (can-query (self, "read-only")
     3042        and
     3043        self :read-only = false
     3044        )
     3045     then do:
     3046       if self :handle <> focus :handle
     3047       then do:
     3048         apply "entry":u to self .
     3049       end.
     3050       run gbl/getcurdt.p
     3051         (output v-curr-sv-date
     3052         ) .
     3053       assign
     3054         self :screen-value = string(v-curr-sv-date) .
     3055       .
     3056     end.
     3057     return no-apply.
     3058   end.
     3059   on ctrl-b of sch-corr-date in frame Dialog-Frame
     3060   do:
     3061     if (can-query (self, "sensitive")
     3062        and
     3063        self :sensitive = true
     3064        )
     3065     or (can-query (self, "read-only")
     3066        and
     3067        self :read-only = false
     3068        )
     3069     then do:
     3070       if self :handle <> focus :handle
     3071       then do:
     3072         apply "entry":u to self .
     3073       end.
     3074       define variable v-curr-sv-date as date no-undo .
     3075       define variable v-new-sv-date  as date no-undo .
     3076       assign
     3077         v-curr-sv-date = date(self :screen-value) no-error
     3078       .
     3079       if v-curr-sv-date = ?
     3080       then do:
     3081         run gbl/getcurdt.p
     3082           (output v-curr-sv-date
     3083           ) .
     3084       end.
     3085       if v-curr-sv-date <> ?
     3086       then do:
     3087         assign
     3088           v-new-sv-date = date( month(v-curr-sv-date), 1, year(v-curr-sv-date))
     3089         .
     3090         assign
     3091           self :screen-value = string(v-new-sv-date) .
     3092         .
     3093       end.
     3094     end.
     3095     return no-apply .
     3096   end.
     3097   on ctrl-e of sch-corr-date in frame Dialog-Frame
     3098   do:
     3099     if (can-query (self, "sensitive")
     3100        and
     3101        self :sensitive = true
     3102        )
     3103     or (can-query (self, "read-only")
     3104        and
     3105        self :read-only = false
     3106        )
     3107     then do:
     3108       if self :handle <> focus :handle
     3109       then do:
     3110         apply "entry":u to self .
     3111       end.
     3112       define variable v-curr-sv-date as date no-undo .
     3113       define variable v-new-sv-date  as date no-undo .
     3114       assign
     3115         v-curr-sv-date = date(self :screen-value) no-error
     3116       .
     3117       if v-curr-sv-date = ?
     3118       then do:
     3119         run gbl/getcurdt.p
     3120           (output v-curr-sv-date
     3121           ) .
     3122       end.
     3123       if v-curr-sv-date <> ?
     3124       then do:
