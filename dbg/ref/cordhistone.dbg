      684       DO:
      685         Message
      686           "Нет заданий на печать ! "
      687           view-as alert-box .
      688         Return  .
      689       End.
      690       run gbl/prnfilen.w
      691         (input  ""
      692         ,input  p-DisabledOptions
      693         ,input  string(v-report-name )
      694         ,input  7
      695         ,output v-user-action
      696         ,output v-printed
      697         ) .
      698       if v-printed then
