        1   block-level on error undo, throw.
        2   using Progress.Lang.*.
        3   using ibs.th.bge.1crn.subjects.*.
        4   define input parameter p-Price-Doc as class price-doc-imp.
        5   define variable vt-obj-code as integer   no-undo .
        6   define variable v-host-code as integer   no-undo .
        7   define variable v-grp-full-name as character no-undo .
        8   define variable vss-revision    as character no-undo init "$Revision: f669785c8aa5, 1477, rls $":U .
        9   define variable vss-author      as character no-undo init "$Author: SSlivenko $":U .
       10   define variable vss-date        as character no-undo init "$Date: Wed Jul 25 17:54:04 2018 +0300 $":U .
       11   define variable vss-workfile    as character no-undo init "$Workfile: imp-price-doc-1c-RN.p $":U .
       12   define variable vss-archive     as character no-undo init "$Archive: ref/imp-price-doc-1c-RN.p $":U .
       13   define variable vss-description as character no-undo init "Загрузка переоценки из ERP 1C RN".
       14   procedure vss-get-info :
       15     define output parameter p-vss-revision    like vss-revision    no-undo .
       16     define output parameter p-vss-author      like vss-author      no-undo .
       17     define output parameter p-vss-date        like vss-date        no-undo .
       18     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       19     define output parameter p-vss-archive     like vss-archive     no-undo .
       20     define output parameter p-vss-description like vss-description no-undo .
       21     assign
       22       p-vss-revision    = vss-revision
       23       p-vss-author      = vss-author
       24       p-vss-date        = vss-date
       25       p-vss-workfile    = vss-workfile
       26       p-vss-archive     = vss-archive
       27       p-vss-description = vss-description
       28     .
       29   end procedure.
       30   procedure vss-get-parameters :
       31     define output parameter p-vss-parameters as character no-undo .
       32   end procedure.
       33   define new global shared variable g#vssrevis-logger as handle    no-undo .
       34   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       35   define variable v-vssrevis-logger                   as handle    no-undo .
       36   procedure vss-logevent :
       37     define input  parameter p-extra-paramters as character no-undo .
       38     define variable v-vssrevis-parameters as character no-undo .
       39     do
       40     on error undo, return error return-value
       41     :
       42       if  valid-handle(v-vssrevis-logger)
       43       and v-vssrevis-logger :get-signature("logevent") <> ""
       44       then do:
       45         run vss-get-parameters in this-procedure
       46           (output v-vssrevis-parameters
       47           ).
       48         run logevent in v-vssrevis-logger
       49           (input vss-workfile
       50           ,input vss-revision
       51           ,input v-vssrevis-parameters
       52           ,input p-extra-paramters
       53           ).
       54       end.
       55     end.
       56   end procedure.
       57   assign
       58     v-vssrevis-logger = g#vssrevis-logger
       59   .
       60   if  valid-handle(v-vssrevis-logger)
       61   and v-vssrevis-logger :get-signature("logevent") <> ""
       62   then do:
       63     assign
       64       v-vssrevis-logevent = true
       65     .
       66     run vss-logevent in this-procedure (input vss-description) .
       67   end.
       68   define new global shared variable g#language as character no-undo .
       69   if g#language <> '' and g#language <> 'rus':U then do:
       70     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       71   end.
       72   define new global shared variable g#library  as handle no-undo .
       73   define new global shared variable g#library2 as handle no-undo .
       74   define   shared variable g#auto as logical no-undo.
       75   define   shared variable g#news as logical no-undo.
       76   define   shared variable g#oxml as logical no-undo.
       77   define   shared variable g#esys as logical no-undo.
       78   define   shared variable g#news-source-db as integer no-undo.
       79   define   shared variable g#esys-source-esys as integer no-undo.
       80   define   shared variable g#db-num as integer   no-undo .
       81   define   shared variable g#userid as character no-undo .
       82   define   shared variable g#passwd as character no-undo .
       83   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       84   define  variable garbcoll_ii as integer no-undo .
       85   define  temp-table temp-gc no-undo
       86   field ii as integer
       87   field obj-r as handle
       88   field cn as character
       89   index pi is unique primary
       90   ii
       91   index icn
       92   cn.
       93   procedure garbcoll_create-gc-entry :
       94   define input parameter p-cn as character no-undo .
       95   define input parameter p-obj-r as handle no-undo .
       96     do
       97     on error undo, return error
       98     :
       99       create temp-gc.
      100       assign
      101       temp-gc.ii = garbcoll_ii
      102       garbcoll_ii = garbcoll_ii + 1
      103       temp-gc.cn = p-cn
      104       temp-gc.obj-r = p-obj-r
      105       .
      106     end.
      107   end procedure.
      108   procedure garbcoll_clear :
      109     do
      110     on error undo, return error
      111     :
      112       for each temp-gc:
      113         delete object temp-gc.obj-r.
      114         delete temp-gc.
      115       end.
      116     end.
      117   end procedure.
      118   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      119   procedure cur-time :
      120      define output parameter p-today as date      no-undo .
      121      define output parameter p-time  as integer   no-undo .
      122     do
      123     on error undo, return error
      124     :
      125       define variable v-date1 as date      no-undo .
      126       define variable v-date2 as date      no-undo .
      127       define variable v-time  as integer   no-undo .
      128       assign
      129         v-date1 = today
      130         v-time  = time
      131         v-date2 = today
      132       .
      133       if v-date1 <> v-date2
      134       then do:
      135         assign
      136           v-date1 = today
      137           v-time  = v-time
      138         .
      139       end.
      140       assign
      141         p-today = v-date1
      142         p-time  = v-time
      143       .
      144     end.
      145   end.
      146   function cur-time-date returns character
      147   :
      148     return string(today, '99/99/9999':U) .
      149   end.
      150   function cur-time-mjd returns decimal
      151   :
      152     define variable v-date as date      no-undo .
      153     define variable v-time as integer   no-undo .
      154     run cur-time in this-procedure
      155       (output v-date
      156       ,output v-time
      157       ) .
      158     return integer(v-date) - 2400002 + (v-time / 86400) .
      159   end.
      160   function cur-time-get-ending-index returns integer
      161   (input p-number as integer
      162   )
      163   :
      164     if p-number < 0
      165     or p-number = ?
      166     then do:
      167       return 1 .
      168     end.
      169     define variable v-rest as integer   no-undo .
      170     assign
      171       p-number = p-number modulo 100
      172     .
      173     if p-number < 20
      174     then do:
      175       assign
      176         v-rest = p-number
      177       .
      178     end.
      179     else do:
      180       assign
      181         v-rest = p-number modulo 10
      182       .
      183     end.
      184     case v-rest :
      185       when 1
      186       then do:
      187         return 2 .
      188       end.
      189       when 2 or
      190       when 3 or
      191       when 4
      192       then do:
      193         return 3 .
      194       end.
      195       otherwise do:
      196         return 1 .
      197       end.
      198     end case .
      199   end.
      200   procedure cur-time-mjd-to-date :
      201      define input  parameter i-mjd-diff as decimal no-undo.
      202      define output parameter o-Date     as date    no-undo.
      203      define output parameter o-Time     as integer no-undo.
      204      define variable v-day-number as integer   no-undo .
      205      if    i-mjd-diff < 0
      206         or i-mjd-diff = ?
      207      then do:
      208         return "?" .
      209      end.
      210      assign
      211         v-day-number = truncate(i-mjd-diff,0).
      212         o-Date = date(v-day-number + 2400002).
      213         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      214     .
      215   end.
      216   function cur-time-mjd-to-string returns character
      217   (input p-mjd-diff as decimal
      218   )
      219   :
      220     define variable v-day-number as integer   no-undo .
      221     define variable v-seconds    as integer   no-undo .
      222     define variable v-hour       as integer   no-undo .
      223     define variable v-min        as integer   no-undo .
      224     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      225     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      226     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      227     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      228     if p-mjd-diff < 0
      229     or p-mjd-diff = ?
      230     then do:
      231       return "?" .
      232     end.
      233     assign
      234       v-day-number = integer(truncate(p-mjd-diff,0))
      235       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      236     .
      237     if v-seconds > 86400
      238     then do:
      239       assign
      240         v-seconds = 86400 - 1
      241       .
      242     end.
      243     if v-seconds < 0
      244     then do:
      245       assign
      246         v-seconds = 0
      247       .
      248     end.
      249     assign
      250       v-hour = truncate(v-seconds / 3600, 0)
      251     .
      252     assign
      253       v-seconds = v-seconds modulo 3600
      254     .
      255     assign
      256       v-min = truncate(v-seconds / 60, 0)
      257     .
      258     assign
      259       v-seconds = v-seconds modulo 60
      260     .
      261     return
      262         (if v-day-number <> 0
      263           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      264           else ""
      265         )
      266       + (if v-day-number <> 0 or v-hour <> 0
      267           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      268           else ""
      269         )
      270       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      271           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      272           else ""
      273         )
      274       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      275       .
      276   end.
      277   function cur-time-string returns character
      278   :
      279     define variable v-date as date      no-undo .
      280     define variable v-time as integer   no-undo .
      281     run cur-time in this-procedure
      282       (output v-date
      283       ,output v-time
      284       ) .
      285     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      286   end.
      287   function cur-time-string-sec returns character
      288   :
      289     define variable v-date as date      no-undo .
      290     define variable v-time as integer   no-undo .
      291     run cur-time in this-procedure
      292       (output v-date
      293       ,output v-time
      294       ) .
      295     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      296   end.
      297   function cur-time-custom  returns character
      298   (input p-prefix as character
      299   ,input p-date-format as character
      300   ,input p-delimiter as character
      301   ,input p-time-format as character
      302   ,input p-suffix as character
      303   )
      304   :
      305     define variable v-date as date      no-undo .
      306     define variable v-time as integer   no-undo .
      307     run cur-time in this-procedure
      308       (output v-date
      309       ,output v-time
      310       ) .
      311     return
      312       p-prefix
      313       + string(v-date, p-date-format)
      314       + p-delimiter
      315       + string(v-time, p-time-format)
      316       + p-suffix
      317       .
      318   end.
      319   function cur-time-print  returns character
      320   :
      321     define variable v-date as date      no-undo .
      322     define variable v-time as integer   no-undo .
      323     run cur-time in this-procedure
      324       (output v-date
      325       ,output v-time
      326       ) .
      327     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      328   end.
      329   function cur-time-datetime returns datetime
      330   :
      331     define variable v-char as character no-undo .
      332     define variable v-datetime as datetime no-undo .
      333     v-char = cur-time-string().
      334     v-datetime = datetime(v-char).
      335     return  v-datetime.
      336   end.
      337   function cur-time-string-msec returns character
      338   :
      339     define variable v-date as datetime  no-undo .
      340     v-date = now.
      341     return string(v-date) .
      342   end.
      343   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      344   define new global shared variable g#lib-nws as handle no-undo .
      345   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      346   def var vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      347   procedure gen-key-rec :
      348     define input  parameter p-tbl-name    as character no-undo.
      349     define input  parameter p-bh_tbl-name as handle    no-undo.
      350     define output parameter p-key-rec     as character no-undo.
      351     do
      352     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      353     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      354     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      355     :
      356       define variable fh               as handle    no-undo .
      357       define variable v-ok             as logical   no-undo .
      358       define variable v-inform         as character no-undo .
      359       define variable v-ind            as integer   no-undo .
      360       define variable v-idx-field-qnty as integer   no-undo .
      361       if p-tbl-name = ?
      362         or p-tbl-name = "":U
      363       then do:
      364         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info4 ).
      365       end.
      366       if not p-bh_tbl-name:available then do:
      367         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info4, p-tbl-name ).
      368       end.
      369       assign
      370         p-key-rec = p-tbl-name
      371         v-inform  = p-bh_tbl-name:index-information(1)
      372         v-ind     = 2
      373       .
      374       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      375       on error undo, return error
      376       :
      377         assign
      378           v-inform = p-bh_tbl-name:index-information( v-ind )
      379           v-ind    = v-ind + 1
      380         .
      381       end.
      382       if v-inform = ?
      383         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      384         or entry( 3, v-inform, ",":U ) <> "1":U
      385       then do:
      386         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info4, p-tbl-name ).
      387       end.
      388       else do:
      389         assign
      390           v-idx-field-qnty = num-entries( v-inform ) - 4
      391         .
      392         if v-idx-field-qnty < 2 then do:
      393           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info4, v-inform, p-tbl-name ).
      394         end.
      395         do v-ind = 1 to v-idx-field-qnty by 2
      396         on error undo, return error
      397         :
      398           assign
      399             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      400             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      401           .
      402         end.
      403       end.
      404       if p-key-rec = ? then do:
      405         assign
      406           p-key-rec = "":U
      407         .
      408         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info4, p-tbl-name ).
      409       end.
      410     end.
      411     return.
      412   end procedure.
      413   procedure gen-where-keyr-tab :
      414     define input  parameter i-tableSerach as character no-undo.
      415     define input  parameter i-tablekey   as character  no-undo.
      416     define input  parameter p-key-rec    as character  no-undo.
      417     define input  parameter p-key-handle as handle     no-undo .
      418     define input  parameter p-db-name    as character  no-undo .
      419     define input  parameter p-tt-handle  as handle     no-undo .
      420     define output parameter o-Where      as character  no-undo.
      421     do
      422     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      423     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      424     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      425     :
      426       define variable v-full-tbl-name  as character no-undo .
      427       define variable bh_tbl-name      as handle    no-undo .
      428       define variable fh_key           as handle    no-undo .
      429       define variable fh_search        as handle    no-undo .
      430       define variable v-field-num      as integer   no-undo .
      431       define variable v-count-fld      as integer   no-undo .
      432       define variable v-inform         as character no-undo .
      433       define variable v-ind            as integer   no-undo .
      434       define variable v-idx-field-qnty as integer   no-undo .
      435       define variable v-field-name     as character no-undo .
      436       define variable v-field-val      as character no-undo .
      437       define variable v-word-link      as character no-undo .
      438       define variable vTable           as character no-undo.
      439       define variable bh_tbl-key       as handle    no-undo .
      440       assign
      441         p-key-rec = trim( p-key-rec )
      442       .
      443       if p-key-handle <> ? then do:
      444         if not valid-handle(p-key-handle)
      445            or p-key-handle:type <> "buffer"
      446         then do:
      447           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info4 ).
      448         end.
      449         if num-entries( p-key-rec, chr(3) ) > 1
      450           or p-key-rec = ?
      451           or p-key-rec = "":U
      452         then do:
      453           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info4, p-key-rec ).
      454         end.
      455       end.
      456       else do:
      457         if p-key-rec = ?
      458           or p-key-rec = "":U
      459         then do:
      460           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info4 ).
      461         end.
      462       end.
      463       assign
      464         vTable = entry( 1 , p-key-rec, chr(3) )
      465       .
      466       if p-tt-handle <> ?
      467         and ( not valid-handle(p-tt-handle)
      468               or p-tt-handle:type <> "buffer"
      469             )
      470       then do:
      471         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info4, vTable, chr(10) ).
      472       end.
      473       if p-tt-handle = ? then do:
      474         assign
      475           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      476         .
      477         create buffer bh_tbl-name for table v-full-tbl-name .
      478       end.
      479       else do:
      480         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      481       end.
      482       assign
      483         v-inform = bh_tbl-name:index-information(1)
      484         v-ind    = 2
      485       .
      486       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      487       on error undo, return error
      488       :
      489         assign
      490           v-inform = bh_tbl-name:index-information( v-ind )
      491           v-ind    = v-ind + 1
      492         .
      493       end.
      494       if v-inform = ?
      495         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      496         or entry( 3, v-inform, ",":U ) <> "1":U
      497       then do:
      498         delete object bh_tbl-name no-error.
      499         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info4, vTable ).
      500       end.
      501       assign
      502         v-idx-field-qnty = num-entries( v-inform ) - 4
      503       .
      504       if v-idx-field-qnty < 2 then do:
      505         delete object bh_tbl-name no-error.
      506         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info4, v-inform, vTable ).
      507       end.
      508       assign
      509         o-where     = "where":U
      510         v-word-link = "":U
      511         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      512         v-count-fld = 0
      513       .
      514       if i-tablekey ne "" and i-tablekey ne ?
      515       then do:
      516         assign
      517           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      518         .
      519         create buffer bh_tbl-key for table v-full-tbl-name .
      520       end.
      521       if i-tableSerach ne "" and i-tableSerach ne ?
      522       then do:
      523         delete object bh_tbl-name no-error.
      524         assign
      525           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      526         .
      527         create buffer bh_tbl-name for table v-full-tbl-name .
      528       end.
      529       block_where:
      530       do v-ind = 1 to v-idx-field-qnty by 2
      531       on error undo, return error
      532       :
      533         assign
      534           v-count-fld = v-count-fld + 1
      535         .
      536         if p-key-handle = ?
      537           and v-count-fld > v-field-num
      538         then do:
      539           leave block_where.
      540         end.
      541         define variable VfieldKeyTable as handle no-undo.
      542         assign
      543           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      544           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      545         .
      546         if     bh_tbl-key ne ?
      547         then do:
      548            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      549            if VfieldKeyTable eq ?
      550            then next block_where.
      551         end.
      552         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      553         then
      554            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      555         else
      556            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      557         if p-key-handle = ? then do:
      558           assign
      559             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      560           .
      561         end.
      562         else do:
      563           assign
      564             fh_key = p-key-handle:buffer-field( v-field-name )
      565           .
      566           if fh_key = ?
      567             or not valid-handle( fh_key )
      568           then do:
      569             delete object bh_tbl-name.
      570             if     bh_tbl-key ne ?
      571             then
      572                delete object bh_tbl-key.
      573             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info4, p-key-handle:name, v-field-name ).
      574           end.
      575           assign
      576             v-field-val = fh_key:buffer-value
      577           .
      578         end.
      579         if fh_search:data-type ="character":U then do:
      580           assign
      581             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      582             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      583             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      584             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      585             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      586             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      587             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      588             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      589             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      590             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      591             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      592             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      593             v-field-val = substitute( '"&1"', v-field-val )
      594           .
      595         end.
      596         assign
      597           o-where = substitute( "&1 &2", o-where, v-field-val )
      598         .
      599         if v-word-link = "":U then do:
      600           assign
      601             v-word-link = "and":U
      602           .
      603         end.
      604       end.
      605       delete object bh_tbl-name.
      606       if     bh_tbl-key ne ?
      607       then
      608          delete object bh_tbl-key.
      609       if p-key-handle = ?
      610         and v-count-fld <> v-field-num
      611       then do:
      612         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info4, vTable ).
      613       end.
      614     end.
      615   end procedure.
      616   procedure gen-hn-keyr-tab :
      617     define input  parameter i-tableSerach as character no-undo.
      618     define input  parameter i-tablekey   as character no-undo.
      619     define input  parameter p-key-rec    as character no-undo.
      620     define input  parameter p-key-handle as handle    no-undo .
      621     define input  parameter p-db-name    as character no-undo .
      622     define input  parameter p-tt-handle  as handle    no-undo .
      623     define input  parameter p-stts-lock  as integer   no-undo .
      624     define output parameter o-hn         as handle    no-undo.
      625     define variable v-full-tbl-name as character no-undo.
      626     define variable v-where         as character no-undo.
      627     define variable bh_tbl-name     as handle    no-undo.
      628     define variable vTable          as character no-undo.
      629     do
      630     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      631     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      632     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      633         run gen-where-keyr-tab(i-tableSerach,
      634                                i-tablekey,
      635                                p-key-rec,
      636                                p-key-handle,
      637                                p-db-name,
      638                                p-tt-handle,
      639                                output v-where).
      640         if i-tableSerach ne "" and i-tableSerach ne ?
      641         then do:
      642            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      643            create buffer bh_tbl-name for table v-full-tbl-name .
      644         end.
      645         else do:
      646            if p-tt-handle = ? then do:
      647               assign
      648                  vTable = entry( 1 , p-key-rec, chr(3) )
      649               .
      650               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      651               create buffer bh_tbl-name for table v-full-tbl-name .
      652            end.
      653            else do:
      654               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      655            end.
      656         end.
      657         if p-tt-handle = ? then do:
      658            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      659         end.
      660         else do:
      661            bh_tbl-name:find-first( v-where ) no-error .
      662         end.
      663         o-hn = bh_tbl-name.
      664      end.
      665   end procedure.
      666   procedure gen-hn-keyr :
      667     define input  parameter p-key-rec    as character no-undo.
      668     define input  parameter p-key-handle as handle    no-undo .
      669     define input  parameter p-db-name    as character no-undo .
      670     define input  parameter p-tt-handle  as handle    no-undo .
      671     define input  parameter p-stts-lock  as integer   no-undo .
      672     define output parameter o-hn         as handle    no-undo.
      673     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      674   end.
      675   procedure gen-row-keyr :
      676     define input  parameter p-key-rec    as character no-undo.
      677     define input  parameter p-key-handle as handle    no-undo .
      678     define input  parameter p-db-name    as character no-undo .
      679     define input  parameter p-tt-handle  as handle    no-undo .
      680     define input  parameter p-stts-lock  as integer   no-undo .
      681     define output parameter p-tbl-row    as rowid     no-undo.
      682     define output parameter p-tbl-name   as character no-undo.
      683     define variable vHn as handle no-undo.
      684       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      685       p-tbl-row = if vHn:available then vHn:rowid else ?.
      686       p-tbl-name =  vHn:table.
      687       delete object vHn no-error.
      688     if p-tbl-row = ? then do:
      689       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info4, p-tbl-name, p-key-rec ).
      690     end.
      691     else do:
      692       return.
      693     end.
      694   end procedure.
      695   procedure gen-key-fv :
      696     define input  parameter p-key-rec    as character no-undo .
      697     define output parameter p-field-list as character no-undo .
      698     define output parameter p-value-list as character no-undo.
      699     do
      700     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      701     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      702     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      703     :
      704       define variable v-full-tbl-name  as character no-undo .
      705       define variable bh_tbl-name      as handle    no-undo .
      706       define variable v-tbl-name       as character no-undo .
      707       define variable v-field-num      as integer   no-undo .
      708       define variable v-count-fld      as integer   no-undo .
      709       define variable v-inform         as character no-undo .
      710       define variable v-ind            as integer   no-undo .
      711       define variable v-idx-field-qnty as integer   no-undo .
      712       define variable v-delim-key      as character no-undo .
      713       if p-key-rec = ?
      714         or p-key-rec = "":U
      715       then do:
      716         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info4 ).
      717       end.
      718       assign
      719         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      720         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      721       .
      722       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      723       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info4 ).
      724       assign
      725         v-inform = bh_tbl-name:index-information(1)
      726         v-ind    = 2
      727       .
      728       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      729       on error undo, return error
      730       :
      731         assign
      732           v-inform = bh_tbl-name:index-information( v-ind )
      733           v-ind    = v-ind + 1
      734         .
      735       end.
      736       if v-inform = ?
      737         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      738         or entry( 3, v-inform, ",":U ) <> "1":U
      739       then do:
      740         delete object bh_tbl-name no-error.
      741         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info4, v-tbl-name ).
      742       end.
      743       assign
      744         v-idx-field-qnty = num-entries( v-inform ) - 4
      745       .
      746       if v-idx-field-qnty < 2 then do:
      747         delete object bh_tbl-name no-error.
      748         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info4, v-inform, v-tbl-name ).
      749       end.
      750       assign
      751         p-field-list = "":U
      752         p-value-list = "":U
      753         v-delim-key  = "":U
      754         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      755         v-count-fld  = 0
      756       .
      757       block_where:
      758       do v-ind = 1 to v-idx-field-qnty by 2
      759       on error undo, return error
      760       :
      761         assign
      762           v-count-fld = v-count-fld + 1
      763         .
      764         if v-count-fld > v-field-num then do:
      765           leave block_where.
      766         end.
      767         assign
      768           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      769           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      770         .
      771         if v-ind = 1 then do:
      772           assign
      773             v-delim-key = chr(3)
      774           .
      775         end.
      776       end.
      777       delete object bh_tbl-name.
      778       if v-count-fld <> v-field-num then do:
      779         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info4, v-tbl-name ).
      780       end.
      781     end.
      782   end procedure.
      783   procedure gen-key-field :
      784     define input  parameter p-table      as character no-undo .
      785     define output parameter p-field-list as character no-undo .
      786     do
      787     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      788     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      789     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      790     :
      791       define variable v-full-tbl-name  as character no-undo .
      792       define variable bh_tbl-name      as handle    no-undo .
      793       define variable v-tbl-name       as character no-undo .
      794       define variable v-field-num      as integer   no-undo .
      795       define variable v-count-fld      as integer   no-undo .
      796       define variable v-inform         as character no-undo .
      797       define variable v-ind            as integer   no-undo .
      798       define variable v-idx-field-qnty as integer   no-undo .
      799       define variable v-delim-key      as character no-undo .
      800       if p-table = ?
      801         or p-table = "":U
      802       then do:
      803         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info4 ).
      804       end.
      805       assign
      806         v-tbl-name      = p-table
      807         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      808       .
      809       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      810       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info4 ).
      811       assign
      812         v-inform = bh_tbl-name:index-information(1)
      813         v-ind    = 2
      814       .
      815       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      816       on error undo, return error
      817       :
      818         assign
      819           v-inform = bh_tbl-name:index-information( v-ind )
      820           v-ind    = v-ind + 1
      821         .
      822       end.
      823       if v-inform = ?
      824         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      825         or entry( 3, v-inform, ",":U ) <> "1":U
      826       then do:
      827         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info4, v-tbl-name ).
      828       end.
      829       assign
      830         v-idx-field-qnty = num-entries( v-inform ) - 4
      831       .
      832       if v-idx-field-qnty < 2 then do:
      833         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info4, v-inform, v-tbl-name ).
      834       end.
      835       assign
      836         p-field-list = "":U
      837         v-delim-key  = "":U
      838         v-count-fld  = 0
      839       .
      840       block_where:
      841       do v-ind = 1 to v-idx-field-qnty by 2
      842       on error undo, return error
      843       :
      844         assign
      845           v-count-fld = v-count-fld + 1
      846         .
      847         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      848         if v-ind = 1 then do:
      849           assign
      850             v-delim-key = chr(3)
      851           .
      852         end.
      853       end.
      854       delete object bh_tbl-name.
      855     end.
      856   end procedure.
      857   define SHARED temp-table temp-cmd no-undo
      858   field cmd-code as integer
      859   field db-list as character
      860   index pi is unique primary
      861   db-list
      862   index icmd
      863   cmd-code
      864   .
      865   define SHARED temp-table temp-smart-route no-undo
      866   field key-field as character
      867   field db-num as integer
      868   index pi is unique primary
      869   key-field
      870   db-num
      871   .
      872   define SHARED temp-table temp-no-route no-undo
      873   field rec-ord as integer
      874   field db-num as integer
      875   index pi is unique primary
      876   db-num
      877   rec-ord
      878   index iro
      879   rec-ord
      880   .
      881   define SHARED temp-table temp-smart-link no-undo
      882   field uniq-key-rec as character
      883   field key-field as character
      884   field rec-ord as integer
      885   field is-smart as logical
      886   index pi is unique primary
      887   key-field
      888   uniq-key-rec
      889   rec-ord
      890   index iu
      891   uniq-key-rec
      892   index iro
      893   rec-ord
      894   .
      895   define SHARED temp-table temp-nws-outline no-undo
      896   like ub.nws-outline.
      897   procedure create-smart-route :
      898   define input parameter p-key-field as character no-undo .
      899   define input parameter p-db-num as integer no-undo .
      900   define buffer buf_temp-smart-route for temp-smart-route.
      901     do
      902     on error undo, return error
      903     :
      904       find first buf_temp-smart-route where
      905                 buf_temp-smart-route.key-field = p-key-field
      906             and buf_temp-smart-route.db-num = p-db-num no-error.
      907       if not available buf_temp-smart-route then do:
      908         create buf_temp-smart-route.
      909         assign
      910         buf_temp-smart-route.key-field = p-key-field
      911         buf_temp-smart-route.db-num = p-db-num
      912         .
      913       end.
      914     end.
      915   end procedure.
      916   procedure create-smart-route-link :
      917   define input parameter p-tbl-name as character no-undo .
      918   define input parameter p-bh_tbl-name as handle no-undo .
      919   define input parameter p-key-field as character no-undo .
      920   define input parameter p-rec-ord as integer no-undo .
      921   define input parameter p-is-smart as logical no-undo .
      922   define variable v-key-rec as character no-undo .
      923   define buffer buf_temp-smart-link for temp-smart-link.
      924     do
      925     on error undo, return error
      926     :
      927       run gen-key-rec in this-procedure ( input p-tbl-name
      928                                          ,input p-bh_tbl-name
      929                                          ,output v-key-rec     ).
      930      find first buf_temp-smart-link where
      931                 buf_temp-smart-link.uniq-key-rec = v-key-rec
      932              and buf_temp-smart-link.key-field = p-key-field
      933              and buf_temp-smart-link.rec-ord = p-rec-ord
      934              no-error .
      935      if not available buf_temp-smart-link then do:
      936        create buf_temp-smart-link.
      937        assign
      938        buf_temp-smart-link.uniq-key-rec = v-key-rec
      939        buf_temp-smart-link.key-field = p-key-field
      940        buf_temp-smart-link.rec-ord = p-rec-ord
      941        buf_temp-smart-link.is-smart = p-is-smart
      942        .
      943      end.
      944     end.
      945   end procedure.
      946   procedure create-nws-outline :
      947   define input parameter p-cmd-proc-handle as handle no-undo .
      948   define input parameter p-cmd-code as integer no-undo .
      949   define input parameter p-outline-type as character no-undo .
      950   define input parameter p-charkey_one as character no-undo .
      951   define input parameter p-charkey_two as character no-undo .
      952   define input parameter p-charkey_three as character no-undo .
      953   define input parameter p-key#_one as integer no-undo .
      954   define input parameter p-key#_two as integer no-undo .
      955   define input parameter p-key#_three as integer no-undo .
      956   define variable v-no-id as integer no-undo .
      957   define variable v-rec-ord as integer no-undo .
      958     do
      959     on error undo, return error return-value
      960     :
      961       find last temp-nws-outline use-index pi no-error .
      962       v-no-id = (if available temp-nws-outline
      963                  then (temp-nws-outline.no-id  + 1)
      964                  else 1).
      965       create temp-nws-outline.
      966       assign
      967       temp-nws-outline.charkeY_one = p-charkey_one
      968       temp-nws-outline.charkeY_two = p-charkey_two
      969       temp-nws-outline.charkeY_three = p-charkey_three
      970       temp-nws-outline.key#_one = p-key#_one
      971       temp-nws-outline.key#_two = p-key#_two
      972       temp-nws-outline.key#_three = p-key#_three
      973       temp-nws-outline.no-id = v-no-id
      974       temp-nws-outline.outline-type = p-outline-type
      975       .
      976                                   run add-dump in p-cmd-proc-handle                                                                           (input p-cmd-code                                                                                         ,input 'nws-outline':U                                                                                          ,input '+update'                                                                                         ,input (buffer temp-nws-outline:handle)                                                                                    ,input ''                                                                                         ,output v-rec-ord                                                                                         ) no-error .                                                                                               if error-status :error                                                                                       then do:                                                                                                     delete procedure p-cmd-proc-handle .                                                                        undo , return error substitute("&1 &2 &3&4Ошибка при добавлении записи &5 в команду с кодом &6&4&8&4&9&4"                                       ,vss-workfile                                                                                                ,vss-revision                                                                                                ,vss-description                                                                                             ,chr(10)                                                                                               ,'nws-outline':U                                                                                                ,p-cmd-code                                                                                               ,error-status:get-message(1)                                                                                 ,return-value                                                                                                ) .                                                                    end.
      977       run  create-smart-route in this-procedure (
      978                                                   input ('nws-outline':U + chr(4) + string(temp-nws-outline.no-id))
      979                                                  ,input -1).
      980       run create-smart-route-link in this-procedure (
      981                                                      input 'nws-outline':U
      982                                                     ,input (buffer temp-nws-outline:handle)
      983                                                     ,input ('nws-outline':U + chr(4) + string(temp-nws-outline.no-id))
      984                                                     ,input v-rec-ord
      985                                                     ,input no
      986                                                     ).
      987     end.
      988   end procedure.
      989   procedure create-no-route :
      990   define input parameter p-rec-ord as integer no-undo .
      991   define input parameter p-db-num as integer no-undo .
      992   define buffer buf_temp-no-route for temp-no-route.
      993   do
      994   on error undo, return error
      995   :
      996      find first buf_temp-no-route where
      997                 buf_temp-no-route.rec-ord = p-rec-ord
      998              and buf_temp-no-route.db-num = p-db-num no-error .
      999      if not available buf_temp-no-route then do:
     1000        create buf_temp-no-route.
     1001        assign
     1002        buf_temp-no-route.rec-ord = p-rec-ord
     1003        buf_temp-no-route.db-num = p-db-num
     1004        .
     1005      end.
     1006   end.
     1007   end procedure.
     1008   procedure clear-from-rec-ord :
     1009   define input parameter p-rec-ord as integer no-undo .
     1010   define buffer buf_temp-no-route for temp-no-route.
     1011   define buffer buf_temp-smart-link for temp-smart-link.
     1012   do
     1013   on error undo, return error
     1014   :
     1015   for each buf_temp-no-route where
     1016           buf_temp-no-route.rec-ord > p-rec-ord:
     1017     delete buf_temp-no-route.
     1018   end.
     1019   for each buf_temp-smart-link where
     1020           buf_temp-smart-link.rec-ord > p-rec-ord:
     1021      delete buf_temp-smart-link.
     1022   end.
     1023   end.
     1024   end procedure.
     1025   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1026   define shared temp-table temp-hist-nws-option no-undo
     1027   like ub.hist-nws-option
     1028   .
     1029   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1030   procedure library-cls_get-handle :
     1031   define input parameter p-library-name as character no-undo .
     1032   define output parameter p-library-handle as handle no-undo .
     1033     do
     1034     on error undo, return error
     1035     :
     1036       CASE p-library-name:
     1037         when "library" then do:
     1038           if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end.
     1039           p-library-handle = g#library.
     1040         end.
     1041         when "library2" then do:
     1042           if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end.
     1043           p-library-handle = g#library2.
     1044         end.
     1045       end case.
     1046     end.
     1047   end procedure.
     1048   def var vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1049   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1050   define variable tempcxml_v-num_ as integer no-undo .
     1051   define shared temp-table temp-xml-tables no-undo
     1052   field order as integer
     1053   field tbl-name as character
     1054   field tbl-handle_ as handle
     1055   field table-handle_ as handle
     1056   field uniq-gate-rec as character
     1057   field gate-name as character
     1058   field gate-handle_ as handle
     1059   field is-parent as logical
     1060   index pi is unique primary
     1061   uniq-gate-rec
     1062   tbl-name
     1063   index iorder
     1064   order
     1065   index gr
     1066   uniq-gate-rec
     1067   index gh
     1068   gate-handle_
     1069   index iparent
     1070   is-parent
     1071   .
     1072   define shared temp-table temp-xml-records no-undo
     1073   field tbl-name as character
     1074   field uniq-key-rec as character
     1075   index pi is unique primary
     1076   tbl-name
     1077   uniq-key-rec
     1078   .
     1079   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1080   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1081   def var vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1082   procedure get-gate-file-name :
     1083   define input parameter p-gate-rec as character no-undo .
     1084   define output  parameter p-gate-file-name as character no-undo .
     1085   define buffer buf_clob-data for ub.clob-data.
     1086   define variable v-tbl-row as rowid no-undo .
     1087   define variable v-tbl-name as character no-undo .
     1088   run gen-row-keyr in this-procedure ( input p-gate-rec
     1089                                       ,input ?
     1090                                       ,input "ub"
     1091                                       ,input ?
     1092                                       ,input no-lock
     1093                                       ,output v-tbl-row
     1094                                       ,output v-tbl-name) no-error.
     1095   if error-status:error then undo, return error substitute("&1 (get-gate-name) Несуществующий gate &2"
     1096                                                           ,vss-include-info9
     1097                                                           ,p-gate-rec).
     1098   find first buf_clob-data no-lock where
     1099             rowid(buf_clob-data) = v-tbl-row no-error.
     1100   if not available buf_clob-data then do:
     1101     if error-status:error then undo, return error substitute("&1 (get-gate-name) Несуществующий gate &2"
     1102                                                             ,vss-include-info9
     1103                                                             ,p-gate-rec).
     1104   end.
     1105   p-gate-file-name = buf_clob-data.file-name.
     1106   end procedure.
     1107   procedure get-gate-rec :
     1108   define input  parameter p-gate-name as character no-undo .
     1109   define output parameter p-gate-rec as character no-undo .
     1110   define buffer buf_clob-bind for ub.clob-bind.
     1111   define buffer buf_clob-data for ub.clob-data.
     1112   main-block:
     1113   do
     1114   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info9, return-value, chr(10), error-status :get-message (1))
     1115   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info9 )
     1116   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info9 )
     1117   :
     1118       find first buf_clob-bind no-lock where
     1119                 buf_clob-bind.uniq-key-rec = p-gate-name
     1120             and buf_clob-bind.field-name = '':U
     1121             and buf_clob-bind.part-num = 1
     1122             and buf_clob-bind.resource-type = 'gate':U
     1123             no-error.
     1124       if not available buf_clob-bind then do:
     1125         undo, return error substitute("Неверная ссылка на XSD -файл &1 для gate"
     1126                                         , p-gate-name
     1127                                         ).
     1128       end.
     1129       find first buf_clob-data no-lock where
     1130                 buf_clob-data.db-num = buf_clob-bind.db-num
     1131             and buf_clob-data.int64-i= buf_clob-bind.int64-id no-error.
     1132       if not available buf_clob-data then do:
     1133         undo, return error substitute("Не найден CLOB c ДБ &1 id &2 - файл &3"
     1134                                         , buf_clob-bind.db-num
     1135                                         , buf_clob-bind.int64-id
     1136                                         , p-gate-name
     1137                                         ).
     1138       end.
     1139       run gen-key-rec in this-procedure ( input 'clob-data':U
     1140                                 ,input buffer buf_clob-data:handle
     1141                                 ,output p-gate-rec).
     1142   end.
     1143   end procedure.
     1144   procedure get-gate-by-name :
     1145   define input  parameter p-gate-name as character no-undo .
     1146   define output parameter p-gate-rec as character no-undo .
     1147   define output parameter p-dsh as handle no-undo .
     1148   define input-output  parameter p-xmlh as handle no-undo .
     1149   define variable v-ii as integer   no-undo .
     1150   define variable glog as logical   no-undo .
     1151   define variable v-longchar as longchar no-undo .
     1152   define variable v-txmlh as handle no-undo .
     1153   define variable v-db-num as integer no-undo .
     1154   define variable v-int64-id as int64 no-undo .
     1155   define buffer buf_clob-bind for ub.clob-bind.
     1156   define buffer buf_clob-data for ub.clob-data.
     1157   main-block:
     1158   do
     1159   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info9, return-value, chr(10), error-status :get-message (1))
     1160   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info9 )
     1161   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info9 )
     1162   :
     1163       find first buf_clob-bind no-lock where
     1164                 buf_clob-bind.uniq-key-rec = p-gate-name
     1165             and buf_clob-bind.field-name = '':U
     1166             and buf_clob-bind.part-num = 1
     1167             and buf_clob-bind.resource-type = 'gate':U
     1168             no-error.
     1169       if not available buf_clob-bind then do:
     1170         undo, return error substitute("Неверная ссылка на XSD -файл &1 для gate"
     1171                                         , p-gate-name
     1172                                         ).
     1173       end.
     1174       find first buf_clob-data no-lock where
     1175                 buf_clob-data.db-num = buf_clob-bind.db-num
     1176             and buf_clob-data.int64-i= buf_clob-bind.int64-id no-error.
     1177       if not available buf_clob-data then do:
     1178         undo, return error substitute("Не найден CLOB c ДБ &1 id &2 - файл &3"
     1179                                         , buf_clob-bind.db-num
     1180                                         , buf_clob-bind.int64-id
     1181                                         , p-gate-name
     1182                                         ).
     1183       end.
     1184       assign
     1185       v-longchar = buf_clob-data.cdata
     1186       .
     1187       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     1188       if error-status :error then do:
     1189         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, buf_clob-data.file-name_, chr(10), error-status:get-message(1) , return-value ).
     1190       end.
     1191       create dataset p-dsh .
     1192       glog = p-dsh:READ-XMLSCHEMA( "LONGCHAR"
     1193                                     , v-longchar
     1194                                     , ?
     1195                                     , ?
     1196                                     , ?
     1197                                     ) no-error.
     1198       v-longchar = '':U.
     1199       if error-status :error
     1200       or not glog
     1201       then do:
     1202         undo, return error substitute("Не удалось прочитать XML-схему &1 из БД:&2&3", p-gate-name, chr(10), error-status:get-message(1) ).
     1203       end.
     1204       if not valid-handle(p-xmlh)
     1205       or not valid-handle(p-xmlh:buffer-field("tbl-name")) then do:
     1206         create temp-table v-txmlh.
     1207         v-txmlh:create-like(buffer temp-xml-tables:handle).
     1208         v-txmlh:temp-table-prepare("temp-xml-tables").
     1209         p-xmlh = v-txmlh:default-buffer-handle.
     1210       end.
     1211       run gen-key-rec in this-procedure ( input 'clob-data':U
     1212                                 ,input buffer buf_clob-data:handle
     1213                                 ,output p-gate-rec).
     1214       do v-ii = 1 to p-dsh:num-buffers:
     1215         p-xmlh:find-first(substitute(' where tbl-name = "&1"', p-dsh:get-buffer-handle(v-ii):name)) no-error.
     1216         if not p-xmlh:available then do:
     1217           p-xmlh:buffer-create().
     1218           assign
     1219           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):name
     1220           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1221           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1222           p-xmlh::gate-handle_ = p-dsh
     1223           p-xmlh::uniq-gate-rec = p-gate-rec
     1224           p-xmlh::gate-name = p-dsh:name
     1225           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1226           .
     1227           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1228             assign
     1229             p-xmlh::order = -3.
     1230           end.
     1231         end.
     1232       end.
     1233   end.
     1234   end procedure.
     1235   procedure get-gate-by-rec :
     1236   define input  parameter p-gate-rec as character no-undo .
     1237   define output parameter p-dsh as handle no-undo .
     1238   define input-output  parameter p-xmlh as handle no-undo .
     1239   define input-output parameter p-longchar  as longchar no-undo .
     1240   define variable v-ii as integer   no-undo .
     1241   define variable glog as logical   no-undo .
     1242   define variable v-rowid as rowid no-undo .
     1243   define variable v-tbl-name as character no-undo .
     1244   define variable v-longchar as longchar no-undo .
     1245   define variable v-txmlh as handle no-undo .
     1246   define buffer buf_clob-data for ub.clob-data.
     1247   main-block:
     1248   do
     1249   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info9, return-value, chr(10), error-status :get-message (1))
     1250   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info9 )
     1251   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info9 )
     1252   :
     1253     run gen-row-keyr in this-procedure (
     1254                                           input  p-gate-rec
     1255                                           ,input  ?
     1256                                           ,input  "ub"
     1257                                           ,input  ?
     1258                                           ,input  NO-LOCK
     1259                                           ,output v-rowid
     1260                                           ,output v-tbl-name   ) no-error.
     1261       find first buf_clob-data no-lock where
     1262                 rowid(buf_clob-data) = v-rowid  no-error.
     1263       if not available buf_clob-data then do:
     1264         undo, return error substitute("Не найден CLOB  &1"
     1265                                         , p-gate-rec
     1266                                         ).
     1267       end.
     1268       assign
     1269       v-longchar = buf_clob-data.cdata
     1270       .
     1271       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     1272       if error-status :error then do:
     1273         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, buf_clob-data.file-name_, chr(10), error-status:get-message(1) , return-value ).
     1274       end.
     1275       create dataset p-dsh .
     1276       glog = p-dsh:READ-XMLSCHEMA( "LONGCHAR"
     1277                                     , v-longchar
     1278                                     , ?
     1279                                     , ?
     1280                                     , ?
     1281                                     ) no-error.
     1282       define variable v-esm as character no-undo .
     1283       v-esm = error-status:get-message(1) .
     1284       if p-longchar <> ? then do:
     1285         p-longchar = v-longchar.
     1286       end.
     1287       v-longchar = '':U.
     1288       if error-status :error
     1289       or not glog
     1290       then do:
     1291         undo, return error substitute("Не удалось прочитать XML-схему &1 (&2) из БД&3&4"
     1292                                      , p-gate-rec
     1293                                      , p-gate-rec
     1294                                      , v-esm
     1295                                      ).
     1296       end.
     1297       p-dsh:private-data = buf_clob-data.file-name_ + chr(4) + p-gate-rec.
     1298       if not valid-handle(p-xmlh)
     1299       or not valid-handle(p-xmlh:buffer-field("tbl-name")) then do:
     1300         create temp-table v-txmlh.
     1301         v-txmlh:create-like(buffer temp-xml-tables:handle).
     1302         v-txmlh:temp-table-prepare("temp-xml-tables").
     1303         p-xmlh = v-txmlh:default-buffer-handle.
     1304       end.
     1305       do v-ii = 1 to p-dsh:num-buffers:
     1306         p-xmlh:find-first(substitute(' where tbl-name = "&1"', p-dsh:get-buffer-handle(v-ii):name)) no-error.
     1307         if not p-xmlh:available then do:
     1308           p-xmlh:buffer-create().
     1309           assign
     1310           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):name
     1311           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1312           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1313           p-xmlh::gate-handle_ = p-dsh
     1314           p-xmlh::uniq-gate-rec = p-gate-rec
     1315           p-xmlh::gate-name = p-dsh:name
     1316           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1317           .
     1318           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1319             assign
     1320             p-xmlh::order = -3.
     1321           end.
     1322           p-xmlh:buffer-release().
     1323         end.
     1324       end.
     1325   end.
     1326   end procedure.
     1327   procedure get-gate-by-file :
     1328   define input  parameter p-schema-file-name as character no-undo .
     1329   define input  parameter p-gate-rec as character no-undo .
     1330   define output parameter p-dsh as handle no-undo .
     1331   define input-output  parameter p-xmlh as handle no-undo .
     1332   define variable v-ii as integer   no-undo .
     1333   define variable glog as logical   no-undo .
     1334   define variable v-rowid as rowid no-undo .
     1335   define variable v-tbl-name as character no-undo .
     1336   define variable v-longchar as longchar no-undo .
     1337   define variable v-txmlh as handle no-undo .
     1338   main-block:
     1339   do
     1340   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info9, return-value, chr(10), error-status :get-message (1))
     1341   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info9 )
     1342   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info9 )
     1343   :
     1344       COPY-LOB
     1345       FROM  FILE p-schema-file-name
     1346       TO  OBJECT v-longchar
     1347       no-convert
     1348       NO-ERROR .
     1349       if error-status :error then do:
     1350           undo, return error substitute("Не удалось считать файл схемы &1 в память&2&3"
     1351                                     , p-schema-file-name
     1352                                 , chr(10)
     1353                                 , error-status:get-message(1) ).
     1354       end.
     1355       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     1356       if error-status :error then do:
     1357         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, p-schema-file-name, chr(10), error-status:get-message(1) , return-value ).
     1358       end.
     1359       create dataset p-dsh .
     1360       glog = p-dsh:READ-XMLSCHEMA( "longchar"
     1361                                     , v-longchar
     1362                                     , ?
     1363                                     , ?
     1364                                     , ?
     1365                                     ) no-error.
     1366       v-longchar = ''.
     1367       if error-status :error
     1368       or not glog
     1369       then do:
     1370         undo, return error substitute("Не удалось прочитать XML-схему из файла &1&2&3"
     1371                                      , p-schema-file-name
     1372                                      ,chr(10)
     1373                                      , error-status:get-message(1)
     1374                                      ).
     1375       end.
     1376       if not valid-handle(p-xmlh)
     1377       or not valid-handle(p-xmlh:buffer-field("tbl-name")) then do:
     1378         create temp-table v-txmlh.
     1379         v-txmlh:create-like(buffer temp-xml-tables:handle).
     1380         v-txmlh:temp-table-prepare("temp-xml-tables").
     1381         p-xmlh = v-txmlh:default-buffer-handle.
     1382       end.
     1383       do v-ii = 1 to p-dsh:num-buffers:
     1384         p-xmlh:find-first(substitute(' where tbl-name = "&1" and  uniq-gate-rec = "&2" '
     1385                                      ,p-dsh:get-buffer-handle(v-ii):name
     1386                                      ,p-gate-rec
     1387                                      )) no-error.
     1388         if not p-xmlh:available then do:
     1389           p-xmlh:buffer-create().
     1390           assign
     1391           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):table
     1392           p-xmlh::uniq-gate-rec = p-gate-rec
     1393           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1394           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1395           p-xmlh::gate-handle_ = p-dsh
     1396           p-xmlh::gate-name = p-dsh:name
     1397           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1398           .
     1399           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1400             assign
     1401             p-xmlh::order = -3.
     1402           end.
     1403           p-xmlh:buffer-release().
     1404         end.
     1405       end.
     1406   end.
     1407   end procedure.
     1408   procedure gate-clear :
     1409   define input  parameter p-dsh as handle no-undo .
     1410   define input  parameter p-xmlh as handle no-undo .
     1411   define variable v-dsh as handle no-undo .
     1412   define variable v-th as handle no-undo .
     1413     do
     1414     on error undo, return error return-value
     1415     :
     1416       if valid-handle(p-dsh) then do:
     1417         delete object p-dsh.
     1418         v-dsh = p-dsh.
     1419         p-dsh = ?.
     1420       end.
     1421       repeat while true:
     1422         p-xmlh:find-first( substitute( " where gate-handle_ = &1 ", v-dsh)
     1423                            , share-lock) no-error.
     1424         if p-xmlh:available then do:
     1425           assign
     1426           v-th = p-xmlh:buffer-field("table-handle_"):buffer-value.
     1427           if valid-handle(p-xmlh:buffer-field("table-handle_"))
     1428           and valid-handle(v-th)
     1429           and v-th:dynamic = yes
     1430           then do:
     1431             delete object p-xmlh:buffer-field("table-handle_"):buffer-value.
     1432             p-xmlh:buffer-field("table-handle_"):buffer-value = ?.
     1433           end.
     1434           p-xmlh:buffer-delete().
     1435         end.
     1436         else do:
     1437           leave.
     1438         end.
     1439       end.
     1440       if p-xmlh:dynamic = yes
     1441       and valid-handle(p-xmlh)
     1442       then do:
     1443         delete object p-xmlh:table-handle.
     1444         p-xmlh = ?.
     1445       end.
     1446       v-dsh = ?.
     1447     end.
     1448   end procedure.
     1449   procedure all-gates-clear :
     1450   define parameter buffer buf_temp-xml-tables for temp-xml-tables.
     1451   do
     1452   on error undo, return error
     1453   :
     1454     for each buf_temp-xml-tables
     1455     break
     1456     by buf_temp-xml-tables.uniq-gate-rec
     1457     on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1458     on stop   undo , return error substitute( "&1. stop", vss-workfile )
     1459     on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     1460     :
     1461         if first-of(buf_temp-xml-tables.uniq-gate-rec) then do:
     1462           delete object buf_temp-xml-tables.gate-handle_.
     1463           buf_temp-xml-tables.gate-handle_ = ?.
     1464         end.
     1465         if valid-handle(buf_temp-xml-tables.table-handle_)
     1466         and buf_temp-xml-tables.table-handle_:dynamic = no
     1467         then do:
     1468           delete object buf_temp-xml-tables.table-handle_.
     1469           buf_temp-xml-tables.table-handle_ = ?.
     1470         end.
     1471         delete buf_temp-xml-tables.
     1472     end.
     1473   end.
     1474   end procedure.
     1475   procedure fix-schemalocation :
     1476   define input-output  parameter p-longchar as longchar no-undo .
     1477   DEFINE VARIABLE hdoc AS HANDLE.
     1478   DEFINE VARIABLE hroot AS HANDLE.
     1479   DEFINE VARIABLE hnode-child AS HANDLE.
     1480   DEFINE VARIABLE hnode-attr AS HANDLE.
     1481   define variable v-jj as integer   no-undo .
     1482   define variable ok as logical   no-undo .
     1483   define variable v-path1                    as character                no-undo .
     1484   DEFINE VARIABLE v-full-path1               as character                no-undo .
     1485   DEFINE VARIABLE v-file-name1               as character                no-undo .
     1486   DEFINE VARIABLE v-file-name-no-ext1        as character                no-undo .
     1487   DEFINE VARIABLE v-file-name-ext1           as character                no-undo .
     1488   define variable v-schema-location          as character                no-undo .
     1489   do
     1490   on error undo, return error return-value
     1491   :
     1492     CREATE X-DOCUMENT hdoc.
     1493     CREATE X-noderef hroot.
     1494     CREATE X-noderef hnode-child.
     1495     CREATE X-noderef hnode-attr.
     1496     hdoc:load("longchar", p-longchar, no) no-error.
     1497     iF ERROR-STATUS:GET-MESSAGE(1) <> '' THEN message ERROR-STATUS:GET-MESSAGE(1) view-as alert-box .
     1498     hdoc:get-document-element(hroot).
     1499     _repeat:
     1500     REPEAT v-jj = 1 TO hroot:NUM-CHILDREN:
     1501       ok = hroot:GET-CHILD(hNode-Child, v-jj).
     1502       if not ok then next.
     1503       if hNode-Child:local-name = "include"
     1504       then do:
     1505         ok = hNode-Child:GET-ATTRIBUTE-NODE( hnode-attr, "schemaLocation" ).
     1506           v-schema-location = hnode-attr:node-value.
     1507           run gbl/filename.p (
     1508                           input "exe/" + hnode-attr:node-value
     1509                         ,output v-full-path1
     1510                         ,output v-path1
     1511                         ,output v-file-name1
     1512                         ,output v-file-name-no-ext1
     1513                         ,output v-file-name-ext1
     1514                         ) no-error .
     1515           if error-status :error then do:
     1516             delete object hnode-attr.
     1517             delete object hnode-child.
     1518             delete object hroot.
     1519             delete object hdoc.
     1520             undo, return error substitute("Не удалось определить расположение схемы &1", v-schema-location).
     1521           end.
     1522         ok = hNode-Child:sET-ATTRIBUTE(  "schemaLocation", v-full-path1 ).
     1523         leave  _repeat.
     1524       end.
     1525     END.
     1526     hdoc:save("longchar", p-longchar).
     1527     delete object hnode-attr.
     1528     delete object hnode-child.
     1529     delete object hroot.
     1530     delete object hdoc.
     1531   end.
     1532   end procedure.
     1533   procedure gate-clb_fill-xml-tables :
     1534   define input parameter p-dsh as handle no-undo .
     1535   define input-output parameter p-xmlh as handle no-undo .
     1536   define variable v-ii as integer no-undo .
     1537     do
     1538     on error undo, return error
     1539     :
     1540       do v-ii = 1 to p-dsh:num-buffers:
     1541         p-xmlh:find-first(substitute(' where tbl-name = "&1"', p-dsh:get-buffer-handle(v-ii):name)) no-error.
     1542         if not p-xmlh:available then do:
     1543           p-xmlh:buffer-create().
     1544           assign
     1545           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):name
     1546           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1547           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1548           p-xmlh::gate-handle_ = p-dsh
     1549           p-xmlh::uniq-gate-rec = entry(2, p-dsh:private-data, chr(4))
     1550           p-xmlh::gate-name = p-dsh:name
     1551           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1552           .
     1553           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1554             assign
     1555             p-xmlh::order = -3.
     1556           end.
     1557           p-xmlh:buffer-release().
     1558         end.
     1559       end.
     1560     end.
     1561   end procedure.
     1562   procedure all-gates-empty :
     1563   define buffer buf_temp-xml-tables for temp-xml-tables.
     1564   do
     1565   on error undo, return error
     1566   :
     1567     for each buf_temp-xml-tables
     1568     break
     1569     by buf_temp-xml-tables.uniq-gate-rec
     1570     on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1571     on stop   undo , return error substitute( "&1. stop", vss-workfile )
     1572     on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     1573     :
     1574       if valid-handle(buf_temp-xml-tables.tbl-handle_) then do:
     1575         buf_temp-xml-tables.tbl-handle_:empty-temp-table().
     1576       end.
     1577     end.
     1578   end.
     1579   end procedure.
     1580   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1581   define temp-table temp-price-doc no-undo
     1582   field line-num as integer
     1583   field doc-date as date
     1584   field doc-num  as integer
     1585   field doc-num-ES as character
     1586   field doc-id   as character
     1587   field obj-type as character
     1588   field obj-code as integer
     1589   field cmnt     as character
     1590   index pi line-num doc-num
     1591   index pi2 doc-num
     1592   index pi3 doc-id
     1593   .
     1594   define temp-table temp-price-list no-undo
     1595   field line-num     as integer
     1596   field doc-num      as integer
     1597   field bar-code     as integer
     1598   field gds-code     as integer
     1599   field price-sale   as decimal
     1600   index pi  doc-num  line-num  bar-code
     1601   index pi2 bar-code
     1602   .
     1603   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1604   PROCEDURE get-db-num :
     1605     define output parameter p-db-num as integer no-undo .
     1606     do
     1607     on error undo, return error return-value
     1608     :
     1609         run gbl/getdbnum.p (output p-db-num).
     1610     end.
     1611   END PROCEDURE.
     1612   define variable v-cntxa-report-num as integer no-undo .
     1613   PROCEDURE get-report-num :
     1614     define output parameter p-report-num as integer no-undo .
     1615     do
     1616     on error undo, return error
     1617     :
     1618       if v-cntxa-report-num = 0 then do:
     1619         run gbl/getrpnum.p (output p-report-num).
     1620         v-cntxa-report-num = p-report-num.
     1621       end.
     1622       else do:
     1623         assign
     1624         p-report-num = v-cntxa-report-num
     1625         .
     1626       end.
     1627     end.
     1628   END PROCEDURE.
     1629   PROCEDURE get-userid :
     1630   do
     1631   on error undo, return error
     1632   :
     1633   define output parameter p-userid  as character    no-undo.
     1634       assign
     1635           p-userid = g#userid
     1636       .
     1637   end.
     1638   END PROCEDURE.
     1639   PROCEDURE get-version-num :
     1640   define output parameter p-curr-version as character no-undo .
     1641     do
     1642     on error undo, return error return-value
     1643     :
     1644       run gbl/getvern.p
     1645         ( output p-curr-version
     1646         ) .
     1647     end.
     1648   END PROCEDURE.
     1649   procedure get-news :
     1650   define output parameter p-news as logical no-undo .
     1651     do
     1652     on error undo, return error
     1653     :
     1654        p-news = g#news.
     1655     end.
     1656   end procedure.
     1657   procedure get-esys :
     1658   define output parameter p-esys as logical no-undo .
     1659     do
     1660     on error undo, return error
     1661     :
     1662        p-esys = g#esys.
     1663     end.
     1664   end procedure.
     1665   define variable num-rec-ok2 as integer no-undo .
     1666   define variable ii as integer no-undo .
     1667   define variable v-Gds-Sale as class price-doc_gds-sale.
     1668   define variable v-Price-list as class subjects.
     1669   define variable v-doc-date as character no-undo .
     1670   define buffer buf_price-doc for ub.price-doc .
     1671     empty temp-table temp-price-doc .
     1672     empty temp-table temp-price-list .
     1673     v-Price-list = p-Price-Doc:gds-sale .
     1674     find first ub.clients no-lock where ub.clients.db-num = g#db-num
     1675                                     and ub.clients.obj-type = 'маг':U
     1676                                     and ub.clients.stts = 0 .
     1677     v-doc-date = p-Price-Doc:doc-date .
     1678     v-doc-date = entry(1, v-doc-date, "T") no-error .
     1679     create temp-price-doc.
     1680     assign
     1681       temp-price-doc.doc-date = date(integer(entry(2, v-doc-date, '-')), integer(entry(3, v-doc-date, '-')), integer(entry(1, v-doc-date, '-')))
     1682       temp-price-doc.doc-num  = 1
     1683       temp-price-doc.line-num = 1
     1684       temp-price-doc.obj-code = ub.clients.obj-code
     1685       temp-price-doc.obj-type = 'маг':U
     1686       temp-price-doc.doc-num-ES = p-Price-Doc:doc-num-ES
     1687       temp-price-doc.doc-id   = p-Price-Doc:doc-id
     1688       temp-price-doc.cmnt     = p-Price-Doc:cmnt
     1689     .
     1690     if valid-object (v-Price-list)
     1691     then
     1692     do ii = 1 to v-Price-list:Get(ii):
     1693       v-Gds-Sale = cast (v-Price-list:SubjectObjCurr, price-doc_gds-sale).
     1694       create temp-price-list.
     1695       assign
     1696         temp-price-list.doc-num = 1
     1697         temp-price-list.line-num = 1
     1698         temp-price-list.gds-code = integer(v-Gds-Sale:gds-code)
     1699         temp-price-list.price-sale = decimal(v-Gds-Sale:price-sale)
     1700       .
     1701     end.
     1702     if integer(p-Price-Doc:doc-status) = 1
     1703     then do :
     1704       if p-Price-Doc:doc-num <> ? and p-Price-Doc:doc-num <> ""
     1705       then do :
     1706         find first buf_price-doc exclusive-lock where buf_price-doc.doc-num = p-Price-Doc:doc-num no-error.
     1707       end.
     1708       if not available buf_price-doc
     1709       then do :
     1710         find first buf_price-doc exclusive-lock where buf_price-doc.uid-es = p-Price-Doc:doc-id no-error.
     1711       end.
     1712       if not available buf_price-doc
     1713       then do :
     1714         undo, return error "Не найдена переоценка для отмены" .
     1715       end.
     1716       if buf_price-doc.status_ = 'акт':U
     1717       then do :
     1718           return "Переоценка в статусе АКТ и не может быть отменена." .
     1719       end.
     1720       if buf_price-doc.status_ = 'приказ':U
     1721       then do :
     1722           delete buf_price-doc no-error.
     1723           if error-status:error
     1724           then do :
     1725             undo, return error return-value.
     1726           end.
     1727       end.
     1728     end.
     1729     else do :
     1730       if p-Price-Doc:doc-num <> ? and p-Price-Doc:doc-num <> ""
     1731       then do :
     1732         find first buf_price-doc exclusive-lock where buf_price-doc.doc-num = p-Price-Doc:doc-num no-error.
     1733       end.
     1734       if not available buf_price-doc
     1735       then do :
     1736         find first buf_price-doc exclusive-lock where buf_price-doc.uid-es = p-Price-Doc:doc-id no-error.
     1737       end.
     1738       if not available buf_price-doc
     1739       then do :
     1740         run utl/ora-i301.p (
     1741           input this-procedure ,
     1742           input this-procedure ,
     1743           input table temp-price-doc ,
     1744           input table temp-price-list ,
     1745           output num-rec-ok2
     1746           ) no-error .
     1747         if error-status:error
     1748         then do :
     1749           undo, return error return-value.
     1750         end.
     1751       end.
     1752     end.
     1753   procedure pcall-log-file :
     1754   define input  parameter p-message as character no-undo .
     1755     do
     1756     on error undo, return error return-value
     1757     :
     1758     end.
     1759   end procedure.
