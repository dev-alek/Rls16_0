      133   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      134     run mainmenu_getcntxt in parparentproc
      135       (output v-cntxt-db-num
      136       ,output v-cntxt-userid
      137       ,output v-cntxt-level
      138       ,output v-cntxt-host-code-obj
      139       ,output v-cntxt-obj-type
