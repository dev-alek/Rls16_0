      192     end.
      193     otherwise do:
      194       message
      195         vss-workfile vss-revision vss-description skip
      196         "Неизвестное значение типа товара" skip
      197         "Тип товара" buf_goods.gds-type skip
      198         "Код товара" buf_goods.gds-code skip
