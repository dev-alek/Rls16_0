      171     end.
      172     when 'у':U
      173     then do:
      174   define variable vss-include-info4 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      175   do:
      176     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      177       (input  v-cntxt-db-num
      178       ,input  v-cntxt-userid
      179       ,input  0
      180       ,input  'actn_reference-services_update':U
      181       ,input  'global':U
