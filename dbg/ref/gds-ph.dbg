      143       ) .
      144   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
      145     (input  buf_goods.gds-code
      146     ,input  ?
      147     ,output v-b-code
      148     )  .
      149   case buf_goods.gds-type
      150   :
      151     when 'т':U
      152     then do:
      153   define variable vss-include-info3 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      154   do:
      155     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      156       (input  v-cntxt-db-num
      157       ,input  v-cntxt-userid
      158       ,input  0
      159       ,input  'actn_reference_update':U
      160       ,input  'global':U
      161       ,input  0
      162       ,input  '':U
      163       ,input  0
      164       ,input  0
      165       ,input  buf_goods.grp-code
      166       ,input  0
      167       ,input  true
      168       ,output v-can-edit
      169       )  .
