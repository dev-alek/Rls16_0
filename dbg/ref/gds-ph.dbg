        1   block-level on error undo, throw.
        2   define input parameter parparentproc  as widget-handle no-undo.
        3   define parameter buffer buf_goods for ub.goods .
        4   define input parameter  loc-mode      as character no-undo .
        5   define variable vss-revision    as character no-undo init "$Revision: a35951db4a04, 289, rls $":U .
        6   define variable vss-author      as character no-undo init "$Author: EShklyar $":U .
        7   define variable vss-date        as character no-undo init "$Date: Tue Dec 01 19:11:22 2015 +0300 $":U .
        8   define variable vss-workfile    as character no-undo init "$Workfile: gds-ph.p $":U .
        9   define variable vss-archive     as character no-undo init "$Archive: ref/gds-ph.p $":U .
       10   define variable vss-description as character no-undo init "Показать изображение товара".
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
       18     assign
       19       p-vss-revision    = vss-revision
       20       p-vss-author      = vss-author
       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29   end procedure.
       30   define new global shared variable g#vssrevis-logger as handle    no-undo .
       31   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       32   define variable v-vssrevis-logger                   as handle    no-undo .
       33   procedure vss-logevent :
       34     define input  parameter p-extra-paramters as character no-undo .
       35     define variable v-vssrevis-parameters as character no-undo .
       36     do
       37     on error undo, return error return-value
       38     :
       39       if  valid-handle(v-vssrevis-logger)
       40       and v-vssrevis-logger :get-signature("logevent") <> ""
       41       then do:
       42         run vss-get-parameters in this-procedure
       43           (output v-vssrevis-parameters
       44           ).
       45         run logevent in v-vssrevis-logger
       46           (input vss-workfile
       47           ,input vss-revision
       48           ,input v-vssrevis-parameters
       49           ,input p-extra-paramters
       50           ).
       51       end.
       52     end.
       53   end procedure.
       54   assign
       55     v-vssrevis-logger = g#vssrevis-logger
       56   .
       57   if  valid-handle(v-vssrevis-logger)
       58   and v-vssrevis-logger :get-signature("logevent") <> ""
       59   then do:
       60     assign
       61       v-vssrevis-logevent = true
       62     .
       63     run vss-logevent in this-procedure (input vss-description) .
       64   end.
       65   define new global shared variable g#language as character no-undo .
       66   if g#language <> '' and g#language <> 'rus':U then do:
       67     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       68   end.
       69   define new global shared variable g#library  as handle no-undo .
       70   define new global shared variable g#library2 as handle no-undo .
       71   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       72   PROCEDURE verify-ini-entry:
       73   DEFINE INPUT  PARAMETER ini-key-name     as character no-undo.
       74   DEFINE INPUT  PARAMETER ini-section-name as character no-undo.
       75   DEFINE INPUT  PARAMETER error-msg-text   as character no-undo.
       76   DEFINE INPUT  PARAMETER silence          as logical no-undo.
       77   DEFINE OUTPUT PARAMETER ini-entry-value  as character no-undo INIt ?.
       78   define variable v-mess as character no-undo .
       79   get-key-value section ini-section-name key ini-key-name value ini-entry-value.
       80   if ini-entry-value = ? and ini-key-name begins "spl"
       81   then
       82   get-key-value section ini-section-name key "splall" value ini-entry-value.
       83   if ini-entry-value = ? and ini-key-name begins "sav"
       84   then
       85   get-key-value section ini-section-name key "savall" value ini-entry-value.
       86   if ini-entry-value = ? then do:
       87     assign
       88     v-mess = substitute("Ошибка ini - файла:&1Секция &2&1Ключ &3&1&4"
       89                       , chr(10)
       90                       , ini-section-name
       91                       , ini-key-name
       92                       , error-msg-text).
       93       if not silence then do:
       94         message
       95         v-mess
       96         view-as alert-box ERROR  .
       97         return error.
       98       end.
       99       else do:
      100         return error v-mess.
      101       end.
      102   end.
      103   END PROCEDURE.
      104   PROCEDURE verify-file:
      105   DEFINE INPUT  PARAMETER filename       as character no-undo.
      106   DEFINE INPUT  PARAMETER error-msg-text as character no-undo.
      107   DEFINE INPUT  PARAMETER silence        as logical no-undo.
      108   DEFINE OUTPUT PARAMETER found          as logical no-undo.
      109   file-info:file-name = filename.
      110   found = NOT (file-info:full-pathname = ?).
      111   if NOT found  then do:
      112     if not silence then do:
      113       message error-msg-text
      114       view-as alert-box ERROR.
      115       return error.
      116     end.
      117     else return error error-msg-text.
      118   end.
      119   END PROCEDURE.
      120   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      121     define variable v-cntxt-db-num        as integer   no-undo .
      122     define variable v-cntxt-userid        as character no-undo .
      123     define variable v-cntxt-level         as character no-undo .
      124     define variable v-cntxt-host-code-obj as integer   no-undo .
      125     define variable v-cntxt-obj-type      as character no-undo .
      126     define variable v-cntxt-obj-code      as integer   no-undo .
      127     define variable v-cntxt-db-num-obj    as integer   no-undo .
      128     define variable v-cntxt-is-admin      as logical   no-undo .
