       75   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       76   procedure cur-time :
       77      define output parameter p-today as date      no-undo .
       78      define output parameter p-time  as integer   no-undo .
       79     do
       80     on error undo, return error
       81     :
       82       define variable v-date1 as date      no-undo .
       83       define variable v-date2 as date      no-undo .
       84       define variable v-time  as integer   no-undo .
       85       assign
       86         v-date1 = today
       87         v-time  = time
       88         v-date2 = today
       89       .
       90       if v-date1 <> v-date2
       91       then do:
       92         assign
       93           v-date1 = today
       94           v-time  = v-time
       95         .
       96       end.
       97       assign
       98         p-today = v-date1
       99         p-time  = v-time
      100       .
      101     end.
      102   end.
      103   function cur-time-date returns character
      104   :
      105     return string(today, '99/99/9999':U) .
      106   end.
      107   function cur-time-mjd returns decimal
      108   :
      109     define variable v-date as date      no-undo .
      110     define variable v-time as integer   no-undo .
      111     run cur-time in this-procedure
      112       (output v-date
      113       ,output v-time
      114       ) .
      115     return integer(v-date) - 2400002 + (v-time / 86400) .
      116   end.
      117   function cur-time-get-ending-index returns integer
      118   (input p-number as integer
      119   )
      120   :
      121     if p-number < 0
      122     or p-number = ?
      123     then do:
      124       return 1 .
      125     end.
      126     define variable v-rest as integer   no-undo .
      127     assign
      128       p-number = p-number modulo 100
      129     .
      130     if p-number < 20
      131     then do:
      132       assign
      133         v-rest = p-number
      134       .
      135     end.
      136     else do:
      137       assign
      138         v-rest = p-number modulo 10
      139       .
      140     end.
      141     case v-rest :
      142       when 1
      143       then do:
      144         return 2 .
      145       end.
      146       when 2 or
      147       when 3 or
      148       when 4
      149       then do:
      150         return 3 .
      151       end.
      152       otherwise do:
      153         return 1 .
      154       end.
      155     end case .
      156   end.
      157   procedure cur-time-mjd-to-date :
      158      define input  parameter i-mjd-diff as decimal no-undo.
      159      define output parameter o-Date     as date    no-undo.
      160      define output parameter o-Time     as integer no-undo.
      161      define variable v-day-number as integer   no-undo .
      162      if    i-mjd-diff < 0
      163         or i-mjd-diff = ?
      164      then do:
      165         return "?" .
      166      end.
      167      assign
      168         v-day-number = truncate(i-mjd-diff,0).
      169         o-Date = date(v-day-number + 2400002).
      170         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      171     .
      172   end.
      173   function cur-time-mjd-to-string returns character
      174   (input p-mjd-diff as decimal
      175   )
      176   :
      177     define variable v-day-number as integer   no-undo .
      178     define variable v-seconds    as integer   no-undo .
      179     define variable v-hour       as integer   no-undo .
      180     define variable v-min        as integer   no-undo .
      181     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      182     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      183     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      184     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      185     if p-mjd-diff < 0
      186     or p-mjd-diff = ?
      187     then do:
      188       return "?" .
      189     end.
      190     assign
      191       v-day-number = integer(truncate(p-mjd-diff,0))
      192       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      193     .
      194     if v-seconds > 86400
      195     then do:
      196       assign
      197         v-seconds = 86400 - 1
      198       .
      199     end.
      200     if v-seconds < 0
      201     then do:
      202       assign
      203         v-seconds = 0
      204       .
      205     end.
      206     assign
      207       v-hour = truncate(v-seconds / 3600, 0)
      208     .
      209     assign
      210       v-seconds = v-seconds modulo 3600
      211     .
      212     assign
      213       v-min = truncate(v-seconds / 60, 0)
      214     .
      215     assign
      216       v-seconds = v-seconds modulo 60
      217     .
      218     return
      219         (if v-day-number <> 0
      220           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      221           else ""
      222         )
      223       + (if v-day-number <> 0 or v-hour <> 0
      224           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      225           else ""
      226         )
      227       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      228           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      229           else ""
      230         )
      231       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      232       .
      233   end.
      234   function cur-time-string returns character
      235   :
      236     define variable v-date as date      no-undo .
      237     define variable v-time as integer   no-undo .
      238     run cur-time in this-procedure
      239       (output v-date
      240       ,output v-time
      241       ) .
      242     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      243   end.
      244   function cur-time-string-sec returns character
      245   :
      246     define variable v-date as date      no-undo .
      247     define variable v-time as integer   no-undo .
      248     run cur-time in this-procedure
      249       (output v-date
      250       ,output v-time
      251       ) .
      252     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      253   end.
      254   function cur-time-custom  returns character
      255   (input p-prefix as character
      256   ,input p-date-format as character
      257   ,input p-delimiter as character
      258   ,input p-time-format as character
      259   ,input p-suffix as character
      260   )
      261   :
      262     define variable v-date as date      no-undo .
      263     define variable v-time as integer   no-undo .
      264     run cur-time in this-procedure
      265       (output v-date
      266       ,output v-time
      267       ) .
      268     return
      269       p-prefix
      270       + string(v-date, p-date-format)
      271       + p-delimiter
      272       + string(v-time, p-time-format)
      273       + p-suffix
      274       .
      275   end.
      276   function cur-time-print  returns character
      277   :
      278     define variable v-date as date      no-undo .
      279     define variable v-time as integer   no-undo .
      280     run cur-time in this-procedure
      281       (output v-date
      282       ,output v-time
      283       ) .
      284     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      285   end.
      286   function cur-time-datetime returns datetime
      287   :
      288     define variable v-char as character no-undo .
      289     define variable v-datetime as datetime no-undo .
      290     v-char = cur-time-string().
      291     v-datetime = datetime(v-char).
      292     return  v-datetime.
      293   end.
      294   function cur-time-string-msec returns character
      295   :
      296     define variable v-date as datetime  no-undo .
      297     v-date = now.
      298     return string(v-date) .
      299   end.
      300   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      301   define  NEW SHARED  temp-table cash-obj no-undo
      302   field km-objcode  as integer
      303   field km-objname as character
      304   field km-objtype as integer
      305   field on-addr like ub.cash-desk.addr-path
      306   field off-addr like ub.cash-desk.addr-path
      307   field shop-nums as character
      308   field obj-lock as integer
      309   field firm-name as character
      310   field jur-address as character
      311   field post-address as character
      312   field INN as character
      313   field KPP as character
      314   index pi is unique primary
      315   km-objtype km-objcode km-objname
      316   .
      317   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      318     define variable v-cntxt-db-num        as integer   no-undo .
      319     define variable v-cntxt-userid        as character no-undo .
      320     define variable v-cntxt-level         as character no-undo .
      321     define variable v-cntxt-host-code-obj as integer   no-undo .
      322     define variable v-cntxt-obj-type      as character no-undo .
      323     define variable v-cntxt-obj-code      as integer   no-undo .
      324     define variable v-cntxt-db-num-obj    as integer   no-undo .
      325     define variable v-cntxt-is-admin      as logical   no-undo .
      326   DEFINE VARIABLE loc#log as logical no-undo .
      327   DEFINE VARIABLE choice as logical no-undo .
      328   DEFINE VARIABLE varold-cash-on like ub.cash-desk.cash-on no-undo .
      329   define variable l-shift-on as logical no-undo.
      330   define variable v-shift-date as date no-undo.
      331   define variable v-shift-num as integer no-undo.
      332   define variable v-shift-name as character no-undo.
      333   define variable v-result as integer no-undo .
      334   DEFINE BUFFER bf_cash-desk for ub.cash-desk.
      335   DEFINE BUFFER buf_cash-desk for ub.cash-desk.
      336   define buffer bfcdm_cash-desk for ub.cash-desk.
      337   define buffer buf_shift-cash for ub.shift-cash.
      338   _main:
      339   do
      340   on error undo, return error
      341   :
      342   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      343     run mainmenu_getcntxt in parparentproc
      344       (output v-cntxt-db-num
      345       ,output v-cntxt-userid
      346       ,output v-cntxt-level
      347       ,output v-cntxt-host-code-obj
      348       ,output v-cntxt-obj-type
      349       ,output v-cntxt-obj-code
      350       ,output v-cntxt-db-num-obj
      351       ,output v-cntxt-is-admin
      352       ) .
      353   FIND FIRST bf_cash-desk WHERE
      354              recid(bf_cash-desk) = par-recid.
      355   varold-cash-on = bf_cash-desk.cash-on.
      356   if par-cash-on = ? then do:
      357     CASE bf_cash-desk.cash-on:
      358       when yes then do:
      359         assign
      360         par-cash-on = no.
      361       end.
      362       when no then do:
      363         assign
      364         par-cash-on = yes.
      365       end.
      366     END CASE.
      367   end.
      368   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      369   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      370     (input  'маг':U
      371     ,input  bf_cash-desk.obj-code
      372     ,input  'shift-on=request'
      373     ,output l-shift-on
      374     )  .
      375   CASE par-cash-on:
      376    when yes then do:
      377       run proc-b-on in this-procedure ( buffer bf_cash-desk
      378                                        ,output v-result
      379                                        ) no-error.
      380       if error-status:error then do:
      381         undo _main, return error return-value.
      382       end.
      383       if v-result = 1
      384       and return-value <> '':U
      385       then do:
      386          message
      387          return-value
      388          view-as alert-box .
      389       end.
      390       run proc-on-off in this-procedure (input-output par-cash-on) no-error.
      391       if error-status:error then do:
      392         undo _main, return error return-value.
      393       end.
      394    end.
      395    when no then do:
      396       run proc-b-off in this-procedure (buffer bf_cash-desk) no-error.
      397       if error-status:error then do:
      398         undo _main, return error return-value .
      399       end.
      400       if l-shift-on then do:
      401           FIND FIRST buf_shift-cash WHERE
      402                     buf_shift-cash.obj-type = 'маг':U
      403                 AND buf_shift-cash.obj-code = bf_cash-desk.obj-code
      404                 AND buf_shift-cash.cash-num = bf_cash-desk.cash-num
      405                 AND buf_shift-cash.shift-date = v-shift-date
      406                 AND buf_shift-cash.z-status = '' No-ERROR.
      407           if avail buf_shift-cash then do:
      408               if buf_shift-cash.status_ = 'зкр':U then.
      409               else delete buf_shift-cash.
      410           end.
      411       end.
      412       run proc-on-off in this-procedure (input-output par-cash-on) no-error.
      413       if error-status:error then do:
      414         undo _main, return error return-value .
      415       end.
      416    end.
      417    END CASE.
      418   end.
      419   procedure proc-on-off:
      420   define input-output parameter par-cash-on like ub.cash-desk.cash-on no-undo .
      421     do
      422     on error undo, return error
      423     :
      424       assign
      425       bf_cash-desk.cash-on = par-cash-on.
      426       if bf_cash-desk.pos-type = 'IBM-XML':U
      427       and bf_cash-desk.autonomy <> integer('0':U)
      428       then do:
      429         for each cash-obj:
      430           delete cash-obj.
      431         end.
      432         find first cash-obj where
      433                 cash-obj.km-objtype = (if buf_cash-desk.autonomy = integer('2':U) then 2 else 3)
      434             AND cash-obj.km-objcode = bf_cash-desk.cash-num no-error .
      435         if not available cash-obj then do:
      436           create cash-obj.
      437           assign
      438           cash-obj.km-objcode = bf_cash-desk.cash-num
      439           cash-obj.km-objtype = (if bf_cash-desk.autonomy = integer('2':U) then 2 else 3)
      440           cash-obj.km-objname = (if bf_cash-desk.autonomy = integer('2':U)
      441                                  then "КМ"
      442                                  else ("касса" + string(bf_cash-desk.cash-num))
      443                                  )
      444           cash-obj.on-addr    = (if bf_cash-desk.autonomy = integer('2':U)
      445                                 then bf_cash-desk.addr-path
      446                                 else (entry(1, bf_cash-desk.addr-path, chr(4))
      447                                       + "://":U
      448                                       + entry(2, bf_cash-desk.addr-path, chr(4))
      449                                     )
      450                                 )
      451           cash-obj.off-addr   = (if bf_cash-desk.autonomy = integer('2':U)
      452                                 then bf_cash-desk.addr-path
      453                                 else (entry(1, bf_cash-desk.addr-path, chr(4))
      454                                       + "://":U
      455                                       + entry(2, bf_cash-desk.addr-path, chr(4))
      456                                     )
      457                                 )
      458           cash-obj.shop-nums  = if bf_cash-desk.autonomy = integer('1':U)
      459                                 then  string(bf_cash-desk.obj-code)
      460                                 else "":U
      461           cash-obj.obj-lock   = if bf_cash-desk.cash-on then 0 else 1
      462           .
      463           if bf_cash-desk.autonomy = integer('2':U) then do:
      464             for each bfcdm_cash-desk no-lock where
      465                     bfcdm_cash-desk.db-num = bf_cash-desk.db-num
      466               AND  bfcdm_cash-desk.pos-type = 'IBM-XML':U
      467               AND  bfcdm_cash-desk.autonomy = integer('2':U)
      468               AND  bfcdm_cash-desk.cash-on = yes
      469               :
      470               assign
      471               cash-obj.shop-nums = cash-obj.shop-nums
      472                                     + (if cash-obj.shop-nums = "":u then "":U else chr(44))
      473                                     + string(bfcdm_cash-desk.obj-code)
      474               .
      475             end.
      476           end.
      477           if can-find(first ub.cash-desk no-lock where
      478                            ub.cash-desk.db-num = bf_cash-desk.db-num
      479                        and ub.cash-desk.obj-code = bf_cash-desk.obj-code
      480                        and ub.cash-desk.pos-type = 'IBM-XML':U) then
      481           run str/diallog.w (
      482                         input parparentproc
      483                       , input this-procedure
      484                       , 'str/send-obj.p':U
      485                       , input (string(bf_cash-desk.db-num) + chr(4) +
      486                               string(bf_cash-desk.obj-code) + chr(4) +
      487                               "R":U )
      488                       , no
      489                       , ''
      490                       , substitute('Отправка информации по объектам БД на кассовый менеджер &1', 'IBM-XML':U)).
      491         end.
      492       end.
      493       release bf_cash-desk no-error .
      494       if error-status:error then do:
      495         message
      496         "Ошибка при сохранении записи КАССА" skip
      497         error-status:get-message(1) skip
      498         return-value
      499         view-as alert-box error .
      500         undo , return error .
      501       end.
      502       par-cash-on = ?.
      503     end.
      504   end procedure.
      505   PROCEDURE proc-b-off :
      506   DEFINE PARAMETER BUFFER t-cash-desk for ub.cash-desk.
      507   define variable glog as logical no-undo .
      508   define variable v-shift-date as date no-undo.
      509   define variable v-shift-num as integer no-undo.
      510   if l-shift-on then do:
      511   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      512   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curshift in g#library
      513     (input  'маг':U
      514     ,input  t-cash-desk.obj-code
      515     ,output v-shift-date
      516     ,output v-shift-num
      517     ,output v-shift-name
      518     ) no-error .
      519      if error-status:error and v-shift-num = 0 then return.
      520     define variable v-chk-act-host-code as integer   no-undo .
      521   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      522   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      523     (input  'маг':U
      524     ,input  bf_cash-desk.obj-code
      525     ,output v-chk-act-host-code
      526     )  .
      527   define variable vss-include-info7 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      528   do:
      529     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      530       (input  v-cntxt-db-num
      531       ,input  v-cntxt-userid
      532       ,input  0
      533       ,input  'actn_shift_super':U
      534       ,input  'object':U
      535       ,input  v-chk-act-host-code
      536       ,input  'маг':U
      537       ,input  bf_cash-desk.obj-code
      538       ,input  0
      539       ,input  0
      540       ,input  0
      541       ,input  false
      542       ,output glog
      543       )  .
      544   end.
      545     if not glog then do:
      546         return error  ( substitute("Включена смена на магазине &1&2Выключить кассу невозможно"
      547                                   ,t-cash-desk.obj-code
      548                                   , chr(10))).
      549     end.
      550   end.
      551   END PROCEDURE.
      552   PROCEDURE proc-b-on :
      553   DEFINE PARAMETER BUFFER t-cash-desk for ub.cash-desk.
      554   define output parameter p-result as integer no-undo .
      555   define variable vrecid as recid no-undo.
      556   define variable predmet as char.
      557   define variable hr as recid.
      558   DEFINE VARIABLE hour AS INTEGER.
      559   DEFINE VARIABLE minute AS INTEGER.
      560   DEFINE VARIABLE sec AS INTEGER.
      561   DEFINE VARIABLE timeleft AS INTEGER.
      562   DEFINE VARIABLE v-today as date no-undo .
      563   DEFINE VARIABLE v-time as integer no-undo .
      564   define variable v-shift-date as date no-undo.
      565   define variable v-shift-num as integer no-undo.
      566   define variable varshift-name     as character no-undo.
      567   define variable varshift-name-num as character no-undo.
      568   define buffer buf_c-cash-desk for ub.c-cash-desk.
      569   if l-shift-on then do:
      570   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      571   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curshift in g#library
      572     (input  'маг':U
      573     ,input  t-cash-desk.obj-code
      574     ,output v-shift-date
      575     ,output v-shift-num
      576     ,output v-shift-name
      577     ) no-error .
      578     if not error-status:error and v-shift-num > 0 then do:
      579       FIND FIRST buf_shift-cash NO-LOCK WHERE
      580                 buf_shift-cash.obj-type = 'маг':U
      581             AND buf_shift-cash.obj-code = t-cash-desk.obj-code
      582             AND buf_shift-cash.cash-num = t-cash-desk.cash-num
      583             AND buf_shift-cash.shift-date = v-shift-date
      584             AND buf_shift-cash.shift-num = v-shift-num No-ERROR.
      585       if not avail buf_shift-cash then do:
      586           run cur-time in this-procedure ( output v-today, output v-time).
      587           run str/shftccr.p (input 'маг':U
      588                         ,input t-cash-desk.obj-code
      589                         ,input t-cash-desk.cash-num
      590                         ,input v-shift-date
      591                         ,input v-shift-num
      592                         ,input string(v-shift-num)
      593                         ,input v-shift-name
      594                         ,input v-time
      595                         ,input 0
      596                         ,input 'касса-вкл':U
      597                         ,output vrecid
      598                         ) no-error.
      599           if error-status:error then return error
      600           ("Не удалось создать запись открытия смены на кассе " + string(t-cash-desk.cash-num)).
      601       end.
      602       else do:
      603         if buf_shift-cash.status_ = 'зкр':U then.
      604         else do:
      605            p-result = 1.
      606         end.
      607       end.
      608     end.
      609   end.
      610   FOR EACH buf_c-cash-desk no-lock where
      611           buf_c-cash-desk.db-num = t-cash-desk.db-num
      612       AND buf_c-cash-desk.obj-code = t-cash-desk.obj-code
      613       AND buf_c-cash-desk.pos-type = t-cash-desk.pos-type
      614       AND buf_c-cash-desk.cash-num = t-cash-desk.cash-num
      615   BY buf_c-cash-desk.chip-num descending:
      616     if buf_c-cash-desk.cash-on
      617     AND
      618     buf_c-cash-desk.cash-on <> t-cash-desk.cash-on
      619     and not (t-cash-desk.pos-type = 'IBS-TH':U
      620              or
      621              t-cash-desk.pos-type = 'IBS-TH-MOB':U
      622             )
      623     then do:
      624       run cur-time in this-procedure(output v-today, output v-time).
      625       if v-today > buf_c-cash-desk.corr-date then do:
      626           message
      627           substitute("ВНИМАНИЕ! Касса &1 магазина  &2&3" +
      628                      "была выключена &4 дней!&3" +
      629                      "Перешлите на кассы все сделанные за это время изменения!"
      630                       ,t-cash-desk.cash-num
      631                       ,t-cash-desk.obj-code
      632                       ,chr(10)
      633                       ,string(v-today - buf_c-cash-desk.corr-date))
      634          view-as alert-box WARNING.
      635       end.
      636       else do:
      637         timeleft = v-time - buf_c-cash-desk.corr-time.
      638         sec = timeleft MOD 60.
      639         timeleft = (timeleft - sec) / 60.
      640         minute = timeleft MOD 60.
      641         hour = (timeleft - minute) / 60.
      642         message
      643         substitute("ВНИМАНИЕ! Касса &1 магазина  &2&3" +
      644                    "была выключена в течении &4 часов &5 минут &6 секунд!&3" +
      645                    "Перешлите на кассы все сделанные за это время изменения!"
      646                     ,t-cash-desk.cash-num
      647                     ,t-cash-desk.obj-code
      648                     ,chr(10)
      649                    ,hour
      650                    ,minute
      651                    ,sec)
      652         view-as alert-box WARNING.
      653       end.
      654       LEAVE.
      655     end.
      656   END.
      657   if p-result = 1 then do:
      658     return substitute("ВНИМАНИЕ! Попытка повторно открыть смену на кассе "  +
      659                                 string(t-cash-desk.cash-num)).
      660   end.
      661   END PROCEDURE.
