        1   block-level on error undo, throw.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define input parameter par-recid as recid no-undo.
        4   define input-output parameter par-cash-on like ub.cash-desk.cash-on no-undo .
        5   define variable vss-revision    as character no-undo init "$Revision: 79dbeab10a26, 2672, rls $":U .
        6   define variable vss-author      as character no-undo init "$Author: Ostroukhov $":U .
