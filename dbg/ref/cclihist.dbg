     1672     RUn OpenBR(yes, no, '':U, v-corr-user-db-num).
     1673   END.
     1674   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1675   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1676   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1677   on help of frame Dialog-Frame
     1678   do:
     1679     run gbl/app_help.p
     1680       (input this-procedure :file-name
     1681       ,input ''
     1682       ,input ?
     1683       ) no-error.
     1684     if error-status :error then do:
     1685       message
     1686         "Ошибка при вызове помощи"
     1687         error-status :get-message(1)
     1688         view-as alert-box .
     1689     end.
     1690   end.
     1691   run minbtn-set in this-procedure .
     1692   on choose of b-help in frame Dialog-Frame
     1693   do:
     1694     apply "help":u to frame Dialog-Frame .
     1695   end.
     1696   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1697   procedure minbtn-set :
     1698       do
     1699           on error undo, return error return-value
     1700           :
     1701           define variable ii              as integer       no-undo .
     1702           define variable fh              as widget-handle no-undo .
     1703           define variable hh              as widget-handle no-undo .
     1704           define variable v-h             as handle        extent 4 no-undo .
     1705           define variable v-name-button   as character     no-undo .
     1706           define variable v-help-old-x    as decimal       no-undo .
     1707           define variable v-help-old-y    as decimal       no-undo .
     1708           define variable v-help-old-size as decimal       no-undo .
     1709           define variable v-frame-width   as decimal       no-undo .
     1710           define variable jj              as integer       no-undo .
     1711           do
     1712               on error undo, return error
     1713               :
     1714               assign
     1715                   v-frame-width = frame Dialog-Frame:width - 0.3
     1716                   fh            = frame Dialog-Frame:first-child
     1717                   hh            = fh:first-child
     1718                   ii            = 1
     1719                   .
     1720               do while valid-handle(hh):
     1721                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1722                   do:
     1723                       case lc(hh:name) :
     1724                           when "b-help" then
     1725                               do:
     1726                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1727                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1728                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1729                                   hh:TOOLTIP = "Помощь" .
     1730                                   v-help-old-x = hh:column .
     1731                                   v-help-old-y = hh:row    .
     1732                                   v-help-old-size = hh:width .
     1733                                   hh:width-chars = 2.5 .
     1734                               end.
     1735                           when "b-print" then
     1736                               do:
     1737                                   hh:load-image("cmp/b-print.bmp":u) .
     1738                                   hh:TOOLTIP = "Печать" .
     1739                                   v-h[ii] = hh:handle .
     1740                                   ii = ii + 1 .
     1741                                   hh:width-chars = 3 .
     1742                               end.
     1743                           when "b-history" or
     1744                           when "b-hist" then
     1745                               do:
     1746                                   hh:load-image("cmp/b-hist.bmp":u) .
     1747                                   hh:TOOLTIP = "История" .
     1748                                   v-h[ii] = hh:handle .
     1749                                   ii = ii + 1 .
     1750                                   hh:width-chars = 3 .
     1751                               end.
     1752                           when "b-sch" then
     1753                               do:
     1754                                   hh:load-image("cmp/b-sch.bmp":u) .
     1755                                   hh:TOOLTIP = "Установка Фильтра" .
     1756                                   v-h[ii] = hh:handle .
     1757                                   ii = ii + 1 .
     1758                                   hh:width-chars = 3 .
     1759                               end.
     1760                           when "b-hist-user" then
     1761                               do:
     1762                                   hh:load-image("cmp/b-hist.bmp":u) .
     1763                                   hh:TOOLTIP = "История пользователя" .
     1764                                   ii = ii + 1 .
     1765                               end.
     1766                       end case.
     1767                   end.
     1768                   hh = hh:next-sibling.
     1769               end.
     1770               b-help:column = v-frame-width - b-help:width-chars.
     1771               jj = 0.
     1772               repeat ii = 4 to 1 by -1 :
     1773                   if valid-handle (v-h[ii] ) then
     1774                   do:
     1775                       jj  = jj + 1 .
     1776                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1777                       v-h[ii]:row    = v-help-old-y .
     1778                   end.
     1779               end.
     1780           end.
     1781       end.
     1782   end procedure.
     1783   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1784   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1785   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1786   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1787   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1788   define variable v-diasize-current-frame-height as decimal   no-undo .
     1789   define variable v-diasize-change-size          as logical   no-undo .
     1790   define variable v-diasize-resize-button        as handle    no-undo .
     1791   define variable v-diasize-wndmax               as logical   no-undo .
     1792   define variable v-diasize-wndstore             as logical   no-undo .
     1793   define variable v-diasize-proc-name            as character no-undo .
     1794   define variable v-diasize-browse-handle        as handle    no-undo .
     1795   define variable v-diasize-browse-number        as integer   no-undo .
     1796   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1797   define temp-table temp-diasize-handle no-undo
     1798     field handle-value  as handle
     1799     field save-position as decimal
     1800     index xpk is primary unique handle-value
     1801     .
     1802   define temp-table temp-browse-handle no-undo
     1803     field browse-type   as character
     1804     field browse-number as integer
     1805     field browse-handle as handle
     1806     field original-size as decimal
     1807     index xpk is primary unique browse-type browse-number
     1808     index xie browse-type browse-handle
     1809   .
     1810   procedure diasize_change-height :
     1811     define input  parameter p-change-value  as decimal   no-undo .
     1812     define input  parameter p-move-resize   as logical   no-undo .
     1813     define variable v-field-group-handle    as handle    no-undo .
     1814     define variable v-object-handle         as handle    no-undo .
     1815     define variable v-frame-height          as decimal   no-undo .
     1816     define variable v-frame-virtual-height  as decimal   no-undo .
     1817     define variable v-browse-height         as decimal   no-undo .
     1818     define variable v-window-height         as decimal   no-undo .
     1819     define variable v-window-virtual-height as decimal   no-undo .
     1820     define variable v-change-sign           as integer   no-undo .
     1821     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1822     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1823     if p-change-value > 0
     1824     then do:
     1825       if frame Dialog-Frame :height + p-change-value
     1826           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1827       then do:
     1828         assign
     1829           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1830                           - (frame Dialog-Frame :height-chars)
     1831         .
     1832         if p-change-value <= 0
     1833         then do:
     1834           run diasize_position-resize-button in this-procedure .
     1835           return .
     1836         end.
     1837       end.
     1838     end.
     1839     if p-change-value < 0
     1840     then do:
     1841       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1842       then do:
     1843         assign
     1844           p-change-value = v-diasize-orig-frame-height
     1845                          - (frame Dialog-Frame :height-chars)
     1846         .
     1847         if p-change-value >= 0
     1848         then do:
     1849           run diasize_position-resize-button in this-procedure .
     1850           return .
     1851         end.
     1852       end.
     1853     end.
     1854     if p-change-value >= 0
     1855     then do:
     1856       assign
     1857         v-change-sign = 1
     1858       .
     1859     end.
     1860     else do:
     1861       assign
     1862         v-change-sign = -1
     1863       .
     1864     end.
     1865     assign
     1866       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1867     .
     1868     if p-change-value = 0
     1869     then do:
     1870       run diasize_position-resize-button in this-procedure .
     1871       return .
     1872     end.
     1873     move_block:
     1874     do
     1875     on error undo move_block, retry move_block
     1876     :
     1877       if retry
     1878       then do:
     1879         do
     1880         on error undo move_block, leave move_block
     1881         :
     1882           if p-change-value > 0
     1883           then do:
     1884             for each buf_temp-diasize-handle
     1885             on error undo, next
     1886             :
     1887               assign
     1888                 v-object-handle = buf_temp-diasize-handle.handle-value
     1889               .
     1890               if v-object-handle <> v-diasize-resize-button
     1891               then do:
     1892                 assign
     1893                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1894                 .
     1895               end.
     1896             end.
     1897             assign
     1898               v-diasize-browse-handle :height = v-browse-height
     1899             .
     1900             for each buf_temp-browse-handle
     1901               where buf_temp-browse-handle.browse-type = 'height':u
     1902             on error undo, next
     1903             :
     1904               assign
     1905                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1906               .
     1907             end.
     1908             assign
     1909               frame Dialog-Frame :height = v-frame-height
     1910             .
     1911             if frame Dialog-Frame :scrollable = true
     1912             then do:
     1913               assign
     1914                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1915               .
     1916             end.
     1917             run diasize_position-resize-button in this-procedure .
     1918           end.
     1919           else do:
     1920             if frame Dialog-Frame :scrollable = true
     1921             then do:
     1922               assign
     1923                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1924               .
     1925             end.
     1926             assign
     1927               frame Dialog-Frame :height = v-frame-height
     1928             .
     1929             assign
     1930               v-diasize-browse-handle :height = v-browse-height
     1931             .
     1932             for each buf_temp-browse-handle
     1933               where buf_temp-browse-handle.browse-type = 'height':u
     1934             on error undo, next
     1935             :
     1936               assign
     1937                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1938               .
     1939             end.
     1940             for each buf_temp-diasize-handle
     1941             on error undo, next
     1942             :
     1943               assign
     1944                 v-object-handle = buf_temp-diasize-handle.handle-value
     1945               .
     1946               if v-object-handle <> v-diasize-resize-button
     1947               then do:
     1948                 assign
     1949                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1950                 .
     1951               end.
     1952             end.
     1953             run diasize_position-resize-button in this-procedure .
     1954           end.
     1955           assign
     1956             v-diasize-change-size = false
     1957           .
     1958           leave move_block .
     1959         end.
     1960       end.
     1961       assign
     1962         v-diasize-need-full-display = true
     1963       .
     1964       if v-diasize-change-size = false
     1965       then do:
     1966         assign
     1967           v-diasize-change-size = true
     1968         .
     1969       end.
     1970       else do:
     1971         return .
     1972       end.
     1973       assign
     1974         v-frame-height = frame Dialog-Frame :height
     1975         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1976         v-browse-height = v-diasize-browse-handle :height
     1977       .
     1978       for each buf_temp-browse-handle
     1979         where buf_temp-browse-handle.browse-type = 'height':u
     1980       :
     1981         assign
     1982           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1983         .
     1984       end.
     1985       for each buf_temp-diasize-handle
     1986       :
     1987         delete buf_temp-diasize-handle .
     1988       end.
     1989       assign
     1990         v-field-group-handle = frame Dialog-Frame :first-child
     1991       .
     1992       do while valid-handle(v-field-group-handle)
     1993       :
     1994         assign
     1995           v-object-handle = v-field-group-handle :first-child
     1996         .
     1997         do while valid-handle(v-object-handle)
     1998         :
     1999           if  v-object-handle <> v-diasize-browse-handle :handle
     2000           and can-query(v-object-handle, "row")
     2001           and can-query(v-object-handle, "height")
     2002           and ( v-object-handle :row > v-diasize-browse-handle :row )
     2003           then do:
     2004             find first buf_temp-browse-handle
     2005               where buf_temp-browse-handle.browse-type   = 'height':u
     2006                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2007               no-error .
     2008             if available buf_temp-browse-handle
     2009             then do:
     2010             end.
     2011             else do:
     2012               create buf_temp-diasize-handle .
     2013               assign
     2014                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2015                 buf_temp-diasize-handle.save-position = v-object-handle :row
     2016               .
     2017             end.
     2018           end.
     2019           assign
     2020             v-object-handle = v-object-handle :next-sibling
     2021           .
     2022         end.
     2023         assign
     2024           v-field-group-handle = v-field-group-handle :next-sibling
     2025         .
     2026       end.
     2027       do with frame Dialog-Frame
     2028       :
     2029         hide v-diasize-resize-button .
     2030         assign
     2031           v-diasize-resize-button :row    = 1
     2032           v-diasize-resize-button :column = 1
     2033         .
     2034       end.
     2035       if p-change-value > 0
     2036       then do:
     2037         if frame Dialog-Frame :scrollable = true
     2038         then do:
     2039           assign
     2040             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2041             no-error .
     2042           if error-status :error
     2043           or error-status :get-message(1) <> ""
     2044           then do:
     2045             undo move_block, retry move_block .
     2046           end.
     2047         end.
     2048         assign
     2049           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2050           no-error .
     2051         if error-status :error
     2052         or error-status :get-message(1) <> ""
     2053         then do:
     2054           undo move_block, retry move_block .
     2055         end.
     2056         assign
     2057           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2058           no-error .
     2059         if error-status :error
     2060         or error-status :get-message(1) <> ""
     2061         then do:
     2062           undo move_block, retry move_block .
     2063         end.
     2064         for each buf_temp-browse-handle
     2065           where buf_temp-browse-handle.browse-type = 'height':u
     2066         on error undo move_block, retry move_block
     2067         :
     2068           assign
     2069             buf_temp-browse-handle.browse-handle :height
     2070               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2071             no-error .
     2072           if error-status :error
     2073           or error-status :get-message(1) <> ""
     2074           then do:
     2075             undo move_block, retry move_block .
     2076           end.
     2077         end.
     2078         for each buf_temp-diasize-handle
     2079         on error undo move_block, retry move_block
     2080         :
     2081           assign
     2082             v-object-handle = buf_temp-diasize-handle.handle-value
     2083           .
     2084           if v-object-handle <> v-diasize-resize-button
     2085           then do:
     2086             assign
     2087               v-object-handle :row = v-object-handle :row + p-change-value
     2088               no-error .
     2089             if error-status :error
     2090             or error-status :get-message(1) <> ""
     2091             then do:
     2092               undo move_block, retry move_block .
     2093             end.
     2094           end.
     2095         end.
     2096       end.
     2097       else do:
     2098         for each buf_temp-diasize-handle
     2099         on error undo move_block, retry move_block
     2100         :
     2101           assign
     2102             v-object-handle = buf_temp-diasize-handle.handle-value
     2103           .
     2104           if v-object-handle <> v-diasize-resize-button
     2105           then do:
     2106             assign
     2107               v-object-handle :row = v-object-handle :row + p-change-value
     2108               no-error .
     2109             if error-status :error
     2110             or error-status :get-message(1) <> ""
     2111             then do:
     2112               undo move_block, retry move_block .
     2113             end.
     2114           end.
     2115         end.
     2116         assign
     2117           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2118           no-error .
     2119         if error-status :error
     2120         or error-status :get-message(1) <> ""
     2121         then do:
     2122           undo move_block, retry move_block .
     2123         end.
     2124         for each buf_temp-browse-handle
     2125           where buf_temp-browse-handle.browse-type = 'height':u
     2126         on error undo move_block, retry move_block
     2127         :
     2128           assign
     2129             buf_temp-browse-handle.browse-handle :height
     2130               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2131             no-error .
     2132           if error-status :error
     2133           or error-status :get-message(1) <> ""
     2134           then do:
     2135             undo move_block, retry move_block .
     2136           end.
     2137         end.
     2138         assign
     2139           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2140           no-error .
     2141         if error-status :error
     2142         or error-status :get-message(1) <> ""
     2143         then do:
     2144           undo move_block, retry move_block .
     2145         end.
     2146         if frame Dialog-Frame :scrollable = true
     2147         then do:
     2148           assign
     2149             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2150             no-error .
     2151           if error-status :error
     2152           or error-status :get-message(1) <> ""
     2153           then do:
     2154             undo move_block, retry move_block .
     2155           end.
     2156         end.
     2157       end.
     2158       if p-move-resize = true
     2159       then do:
     2160         run diasize_position-resize-button in this-procedure .
     2161       end.
     2162       if v-diasize-wndstore = true
     2163       then do:
     2164         if connected("ub") = true
     2165         then do:
     2166           define variable v-cntxt-db-num        as integer   no-undo .
     2167           define variable v-cntxt-userid        as character no-undo .
     2168           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2169                                             , OUTPUT v-cntxt-userid
     2170                                             ) .
     2171           run gbl/wndsizew.p
     2172             (input  v-cntxt-db-num
     2173             ,input  v-cntxt-userid
     2174             ,input  v-diasize-proc-name
     2175             ,input  'height':u
     2176             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     2177             ) .
     2178         end.
     2179       end.
     2180     end.
     2181     assign
     2182       v-diasize-change-size = false
     2183     .
     2184   end procedure.
     2185   procedure diasize_set-height :
     2186     define input  parameter p-new-height  as decimal   no-undo .
     2187     define input  parameter p-move-resize as logical   no-undo .
     2188     do
     2189     on error undo, return error return-value
     2190     :
     2191       run diasize_change-height in this-procedure
     2192         (input  (p-new-height - frame Dialog-Frame :height)
     2193         ,input  p-move-resize
     2194         ) .
     2195     end.
     2196   end procedure.
     2197   procedure diasize_change-width :
     2198     define input  parameter p-change-value as decimal   no-undo .
     2199     define input  parameter p-move-resize  as logical   no-undo .
     2200     define variable v-field-group-handle   as handle    no-undo .
     2201     define variable v-object-handle        as handle    no-undo .
     2202     define variable v-frame-width          as decimal   no-undo .
     2203     define variable v-frame-virtual-width  as decimal   no-undo .
     2204     define variable v-browse-width         as decimal   no-undo .
     2205     define variable v-window-width         as decimal   no-undo .
     2206     define variable v-window-virtual-width as decimal   no-undo .
     2207     define variable v-change-sign          as integer   no-undo .
     2208     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2209     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2210     if p-change-value > 0
     2211     then do:
     2212       if frame Dialog-Frame :width + p-change-value >
     2213           session :width-chars
     2214       then do:
     2215         assign
     2216           p-change-value = session :width-chars - frame Dialog-Frame :width
     2217         .
     2218         if p-change-value <= 0
     2219         then do:
     2220           run diasize_position-resize-button in this-procedure .
     2221           return .
     2222         end.
     2223       end.
     2224     end.
     2225     if p-change-value < 0
     2226     then do:
     2227       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     2228       then do:
     2229         assign
     2230           p-change-value = v-diasize-orig-frame-width
     2231                          - frame Dialog-Frame :width
     2232         .
     2233         if p-change-value >= 0
     2234         then do:
     2235           run diasize_position-resize-button in this-procedure .
     2236           return .
     2237         end.
     2238       end.
     2239     end.
     2240     if p-change-value >= 0
     2241     then do:
     2242       assign
     2243         v-change-sign = 1
     2244       .
     2245     end.
     2246     else do:
     2247       assign
     2248         v-change-sign = -1
     2249       .
     2250     end.
     2251     assign
     2252       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2253     .
     2254     if p-change-value = 0
     2255     then do:
     2256       run diasize_position-resize-button in this-procedure .
     2257       return .
     2258     end.
     2259     move_block:
     2260     do
     2261     on error undo move_block, leave move_block
     2262     :
     2263       if retry
     2264       then do:
     2265         do
     2266         on error undo move_block, leave move_block
     2267         :
     2268           if p-change-value > 0
     2269           then do:
     2270             for each buf_temp-diasize-handle
     2271             on error undo, next
     2272             :
     2273               assign
     2274                 v-object-handle = buf_temp-diasize-handle.handle-value
     2275               .
     2276               if v-object-handle <> v-diasize-resize-button
     2277               then do:
     2278                 assign
     2279                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2280                 .
     2281               end.
     2282             end.
     2283             assign
     2284               v-diasize-browse-handle :width = v-browse-width
     2285             .
     2286             for each buf_temp-browse-handle
     2287               where buf_temp-browse-handle.browse-type = 'width':u
     2288             on error undo, next
     2289             :
     2290               assign
     2291                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2292               .
     2293             end.
     2294             assign
     2295               frame Dialog-Frame :width = v-frame-width
     2296             .
     2297             if frame Dialog-Frame :scrollable = true
     2298             then do:
     2299               assign
     2300                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2301               .
     2302             end.
     2303             run diasize_position-resize-button in this-procedure .
     2304           end.
     2305           else do:
     2306             if frame Dialog-Frame :scrollable = true
     2307             then do:
     2308               assign
     2309                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2310               .
     2311             end.
     2312             assign
     2313               frame Dialog-Frame :width = v-frame-width
     2314             .
     2315             for each buf_temp-browse-handle
     2316               where buf_temp-browse-handle.browse-type = 'width':u
     2317             on error undo, next
     2318             :
     2319               assign
     2320                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2321               .
     2322             end.
     2323             assign
     2324               v-diasize-browse-handle :width = v-browse-width
     2325             .
     2326             for each buf_temp-diasize-handle
     2327             on error undo, next
     2328             :
     2329               assign
     2330                 v-object-handle = buf_temp-diasize-handle.handle-value
     2331               .
     2332               if v-object-handle <> v-diasize-resize-button
     2333               then do:
     2334                 assign
     2335                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2336                 .
     2337               end.
     2338             end.
     2339             run diasize_position-resize-button in this-procedure .
     2340           end.
     2341           assign
     2342             v-diasize-change-size = false
     2343           .
     2344           leave move_block .
     2345         end.
     2346       end.
     2347       assign
     2348         v-diasize-need-full-display = true
     2349       .
     2350       if v-diasize-change-size = false
     2351       then do:
     2352         assign
     2353           v-diasize-change-size = true
     2354         .
     2355       end.
     2356       else do:
     2357         return .
     2358       end.
     2359       assign
     2360         v-frame-width = frame Dialog-Frame :width
     2361         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     2362         v-browse-width = v-diasize-browse-handle :width
     2363       .
     2364       for each buf_temp-browse-handle
     2365         where buf_temp-browse-handle.browse-type = 'width':u
     2366       :
     2367         assign
     2368           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2369         .
     2370       end.
     2371       for each buf_temp-diasize-handle
     2372       :
     2373         delete buf_temp-diasize-handle .
     2374       end.
     2375       assign
     2376         v-field-group-handle = frame Dialog-Frame :first-child
     2377       .
     2378       do while valid-handle(v-field-group-handle)
     2379       :
     2380         assign
     2381           v-object-handle = v-field-group-handle :first-child
     2382         .
     2383         do while valid-handle(v-object-handle)
     2384         :
     2385           if  v-object-handle <> v-diasize-browse-handle :handle
     2386           and v-object-handle <> v-diasize-resize-button
     2387           and can-query(v-object-handle, "row")
     2388           and can-query(v-object-handle, "height")
     2389           and ( v-object-handle :col + v-object-handle :width
     2390                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2391               )
     2392           then do:
     2393             find first buf_temp-browse-handle
     2394               where buf_temp-browse-handle.browse-type   = 'width':u
     2395                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2396               no-error .
     2397             if available buf_temp-browse-handle
     2398             then do:
     2399             end.
     2400             else do:
     2401               create buf_temp-diasize-handle .
     2402               assign
     2403                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2404                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2405               .
     2406             end.
     2407           end.
     2408           assign
     2409             v-object-handle = v-object-handle :next-sibling
     2410           .
     2411         end.
     2412         assign
     2413           v-field-group-handle = v-field-group-handle :next-sibling
     2414         .
     2415       end.
     2416       do with frame Dialog-Frame
     2417       :
     2418         hide v-diasize-resize-button .
     2419         v-diasize-resize-button :row = 1.
     2420         v-diasize-resize-button :column = 1.
     2421       end.
     2422       if p-change-value > 0
     2423       then do:
     2424         if frame Dialog-Frame :scrollable = true
     2425         then do:
     2426           assign
     2427             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2428             no-error .
     2429           if error-status :error
     2430           or error-status :get-message(1) <> ""
     2431           then do:
     2432             undo move_block, retry move_block.
     2433           end.
     2434         end.
     2435         assign
     2436           frame Dialog-Frame :width = v-frame-width + p-change-value
     2437           no-error .
     2438         if error-status :error
     2439         or error-status :get-message(1) <> ""
     2440         then do:
     2441           undo move_block, retry move_block.
     2442         end.
     2443         assign
     2444           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2445         no-error .
     2446         if error-status :error
     2447         or error-status :get-message(1) <> ""
     2448         then do:
     2449           undo move_block, retry move_block.
     2450         end.
     2451         for each buf_temp-browse-handle
     2452           where buf_temp-browse-handle.browse-type = 'width':u
     2453         on error undo move_block, retry move_block
     2454         :
     2455           assign
     2456             buf_temp-browse-handle.browse-handle :width
     2457               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2458             no-error .
     2459           if error-status :error
     2460           or error-status :get-message(1) <> ""
     2461           then do:
     2462             undo move_block, retry move_block .
     2463           end.
     2464         end.
     2465         for each buf_temp-diasize-handle
     2466         on error undo move_block, retry move_block
     2467         :
     2468           assign
     2469             v-object-handle = buf_temp-diasize-handle.handle-value
     2470           .
     2471           if v-object-handle <> v-diasize-resize-button
     2472           then do:
     2473             assign
     2474               v-object-handle :col = v-object-handle :col + p-change-value
     2475               no-error .
     2476             if error-status :error
     2477             or error-status :get-message(1) <> ""
     2478             then do:
     2479               undo move_block, retry move_block .
     2480             end.
     2481           end.
     2482         end.
     2483       end.
     2484       else do:
     2485         for each buf_temp-diasize-handle
     2486         on error undo move_block, retry move_block
     2487         :
     2488           assign
     2489             v-object-handle = buf_temp-diasize-handle.handle-value
     2490           .
     2491           if v-object-handle <> v-diasize-resize-button
     2492           then do:
     2493             assign
     2494               v-object-handle :col = v-object-handle :col + p-change-value
     2495               no-error .
     2496             if error-status :error
     2497             or error-status :get-message(1) <> ""
     2498             then do:
     2499               undo move_block, retry move_block .
     2500             end.
     2501           end.
     2502         end.
     2503         for each buf_temp-browse-handle
     2504           where buf_temp-browse-handle.browse-type = 'width':u
     2505         on error undo move_block, retry move_block
     2506         :
     2507           assign
     2508             buf_temp-browse-handle.browse-handle :width
     2509               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2510             no-error .
     2511           if error-status :error
     2512           or error-status :get-message(1) <> ""
     2513           then do:
     2514             undo move_block, retry move_block .
     2515           end.
     2516         end.
     2517         assign
     2518           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2519           no-error .
     2520         if error-status :error
     2521         or error-status :get-message(1) <> ""
     2522         then do:
     2523           undo move_block, retry move_block.
     2524         end.
     2525         assign
     2526           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2527         no-error .
     2528         if error-status :error
     2529         or error-status :get-message(1) <> ""
     2530         then do:
     2531           undo move_block, retry move_block.
     2532         end.
     2533         if frame Dialog-Frame :scrollable = true
     2534         then do:
     2535           assign
     2536             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2537           no-error .
     2538           if error-status :error
     2539           or error-status :get-message(1) <> ""
     2540           then do:
     2541             undo move_block, retry move_block.
     2542           end.
     2543         end.
     2544       end.
     2545       if p-move-resize
     2546       then do:
     2547         run diasize_position-resize-button in this-procedure .
     2548       end.
     2549       if v-diasize-wndstore = true
     2550       then do:
     2551         if connected("ub") = true
     2552         then do:
     2553           define variable v-cntxt-db-num        as integer   no-undo .
     2554           define variable v-cntxt-userid        as character no-undo .
     2555           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2556                                             , OUTPUT v-cntxt-userid
     2557                                             ) .
     2558           run gbl/wndsizew.p
     2559             (input  v-cntxt-db-num
     2560             ,input  v-cntxt-userid
     2561             ,input  v-diasize-proc-name
     2562             ,input  'width':u
     2563             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2564             ) .
     2565         end.
     2566       end.
     2567     end.
     2568     assign
     2569       v-diasize-change-size = false
     2570     .
     2571   end procedure.
     2572   procedure diasize_set-width :
     2573     define input  parameter p-new-width  as decimal   no-undo .
     2574     define input  parameter p-move-resize as logical   no-undo .
     2575     do
     2576     on error undo, return error return-value
     2577     :
     2578       run diasize_change-width in this-procedure
     2579         (input  (p-new-width - frame Dialog-Frame :width)
     2580         ,input  p-move-resize
     2581         ) .
     2582     end.
     2583   end procedure.
     2584   procedure diasize_position-resize-button :
     2585     do with frame Dialog-Frame
     2586     :
     2587       hide v-diasize-resize-button .
     2588       assign
     2589         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2590                     - 1
     2591                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2592         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2593                     - 1
     2594                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2595       .
     2596       view v-diasize-resize-button .
     2597     end.
     2598   end procedure.
     2599   on alt-right anywhere
     2600   do:
     2601     run diasize_change-width in this-procedure
     2602       (input 1
     2603       ,input true
     2604       ) .
     2605     return no-apply .
     2606   end.
     2607   on alt-left anywhere
     2608   do:
     2609     run diasize_change-width in this-procedure
     2610       (input -1
     2611       ,input true
     2612       ) .
     2613     return no-apply .
     2614   end.
     2615   on alt-down anywhere
     2616   do:
     2617     run diasize_change-height in this-procedure
     2618       (input 1
     2619       ,input true
     2620       ) .
     2621     return no-apply .
     2622   end.
     2623   on alt-up anywhere
     2624   do:
     2625     run diasize_change-height in this-procedure
     2626       (input -1
     2627       ,input true
     2628       ) .
     2629     return no-apply .
     2630   end.
     2631   on alt-enter of frame Dialog-Frame
     2632   do:
     2633     run diasize_maximize in this-procedure
     2634       (input  ?
     2635       ).
     2636     return no-apply .
     2637   end.
     2638   procedure diasize_end-move :
     2639     do
     2640     on error undo, return error return-value
     2641     :
     2642       define variable v-row-delta as decimal   no-undo .
     2643       define variable v-col-delta as decimal   no-undo .
     2644       define variable v-new-row as decimal   no-undo .
     2645       define variable v-new-col as decimal   no-undo .
     2646       assign
     2647         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2648         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2649       .
     2650       assign
     2651         v-row-delta = v-new-row - frame Dialog-Frame :height
     2652         v-col-delta = v-new-col - frame Dialog-Frame :width
     2653       .
     2654       run diasize_change-height in this-procedure
     2655         (input v-row-delta
     2656         ,input true
     2657         ) .
     2658       run diasize_change-width in this-procedure
     2659         (input v-col-delta
     2660         ,input true
     2661         ) .
     2662     end.
     2663   end procedure.
     2664   procedure diasize_maximize :
     2665     define input  parameter p-action as logical   no-undo .
     2666     do
     2667     on error undo, return error return-value
     2668     :
     2669       if p-action = ?
     2670       then do:
     2671         if v-diasize-need-maximize = true
     2672         then do:
     2673           assign
     2674             p-action = true
     2675           .
     2676         end.
     2677         else do:
     2678           assign
     2679             p-action = false
     2680           .
     2681         end.
     2682       end.
     2683       if p-action = true
     2684       then do:
     2685         run diasize_change-height in this-procedure
     2686           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2687               - frame Dialog-Frame :height-chars
     2688           ,input true
     2689           ) .
     2690         run diasize_change-width in this-procedure
     2691           (input session :width-chars
     2692               - frame Dialog-Frame :width-chars
     2693           ,input true
     2694           ) .
     2695         assign
     2696           v-diasize-need-maximize = false
     2697         .
     2698       end.
     2699       else do:
     2700         run diasize_change-width in this-procedure
     2701           (input v-diasize-orig-frame-width
     2702               - frame Dialog-Frame :width-chars
     2703           ,input true
     2704           ) .
     2705         run diasize_change-height in this-procedure
     2706           (input v-diasize-orig-frame-height
     2707               - frame Dialog-Frame :height-chars
     2708           ,input true
     2709           ) .
     2710         assign
     2711           v-diasize-need-maximize = true
     2712         .
     2713       end.
     2714     end.
     2715   end procedure.
     2716   procedure diasize_restore-orig-size :
     2717     do
     2718     on error undo, return error return-value
     2719     :
     2720       assign
     2721         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2722         v-diasize-current-frame-height = frame Dialog-Frame :height
     2723       .
     2724       run diasize_set-height in this-procedure
     2725         (input  v-diasize-orig-frame-height
     2726         ,input  true
     2727         ) .
     2728       run diasize_set-width in this-procedure
     2729         (input  v-diasize-orig-frame-width
     2730         ,input  true
     2731         ) .
     2732     end.
     2733   end procedure.
     2734   procedure diasize_restore-current-size :
     2735     do
     2736     on error undo, return error return-value
     2737     :
     2738       run diasize_set-height in this-procedure
     2739         (input  v-diasize-current-frame-height
     2740         ,input  true
     2741         ) .
     2742       run diasize_set-width in this-procedure
     2743         (input  v-diasize-current-frame-width
     2744         ,input  true
     2745         ) .
     2746     end.
     2747   end procedure.
     2748   procedure diasize_set-browse-handle :
     2749     define input  parameter p-browse-handle as handle   no-undo .
     2750     define buffer buf_temp-browse-handle for temp-browse-handle .
     2751     do
     2752     on error undo, return error return-value
     2753     :
     2754       assign
     2755         v-diasize-browse-handle = p-browse-handle
     2756       .
     2757       for each buf_temp-browse-handle
     2758       on error undo, return error return-value
     2759       :
     2760         delete buf_temp-browse-handle .
     2761       end.
     2762     end.
     2763   end procedure.
     2764   procedure diasize_add_browse :
     2765     define input  parameter p-browse-type   as character no-undo .
     2766     define input  parameter p-browse-handle as handle    no-undo .
     2767     define buffer buf_temp-browse-handle for temp-browse-handle .
     2768     do
     2769     on error undo, return error return-value
     2770     :
     2771       assign
     2772         v-diasize-browse-number = v-diasize-browse-number + 1
     2773       .
     2774       create buf_temp-browse-handle .
     2775       assign
     2776         buf_temp-browse-handle.browse-type   = p-browse-type
     2777         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2778         buf_temp-browse-handle.browse-handle = p-browse-handle
     2779       .
     2780     end.
     2781   end procedure.
     2782   procedure diasize_init :
     2783     define variable v-default-value    as logical   no-undo .
     2784     define variable v-restore-saved    as logical   no-undo .
     2785     define variable v-resize-value-str as character no-undo .
     2786     do
     2787     on error undo, return error return-value
     2788     :
     2789       do with frame Dialog-Frame
     2790       :
     2791         assign
     2792           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2793           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2794           v-diasize-browse-handle     = browse br-cli-hist :handle
     2795         .
     2796         create button v-diasize-resize-button
     2797         assign
     2798           parent        = frame Dialog-Frame :first-child
     2799           label         = "s"
     2800           height-pixels = 16
     2801           width-pixels  = 16
     2802           visible       = true
     2803           sensitive     = true
     2804           movable       = true
     2805           triggers:
     2806             on end-move persistent run diasize_end-move in this-procedure .
     2807           end triggers.
     2808         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2809         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2810         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2811         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2812         assign
     2813           v-diasize-wndmax = false
     2814         .
     2815         if connected("ub") = true
     2816         then do:
     2817           define variable v-cntxt-db-num        as integer   no-undo .
     2818           define variable v-cntxt-userid        as character no-undo .
     2819           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2820                                             , OUTPUT v-cntxt-userid
     2821                                             ) .
     2822           run gbl/wndpar_r.p
     2823             (input  v-cntxt-db-num
     2824             ,input  v-cntxt-userid
     2825             ,input  'wndmax':U
     2826             ,output v-diasize-wndmax
     2827             ,output v-default-value
     2828             ) .
     2829         end.
     2830         assign
     2831           v-diasize-wndstore = false
     2832         .
     2833         if connected("ub") = true
     2834         then do:
     2835           run gbl/wndpar_r.p
     2836             (input  v-cntxt-db-num
     2837             ,input  v-cntxt-userid
     2838             ,input  'wndstore':U
     2839             ,output v-diasize-wndstore
     2840             ,output v-default-value
     2841             ) .
     2842         end.
     2843         assign
     2844           v-diasize-proc-name = entry(1, program-name(2), '.')
     2845         .
     2846         if v-diasize-wndstore = true
     2847         then do:
     2848           assign
     2849             v-restore-saved = false
     2850           .
     2851           if connected("ub") = true
     2852           then do:
     2853             run gbl/wndsizer.p
     2854               (input  v-cntxt-db-num
     2855               ,input  v-cntxt-userid
     2856               ,input  v-diasize-proc-name
     2857               ,input  'height':u
     2858               ,output v-resize-value-str
     2859               ) .
     2860             if v-resize-value-str <> '':U
     2861             then do:
     2862               run diasize_change-height in this-procedure
     2863                 (input  integer(v-resize-value-str)
     2864                 ,input  true
     2865                 ) .
     2866               assign
     2867                 v-restore-saved = true
     2868               .
     2869             end.
     2870           end.
     2871           if connected("ub") = true
     2872           then do:
     2873             run gbl/wndsizer.p
     2874               (input  v-cntxt-db-num
     2875               ,input  v-cntxt-userid
     2876               ,input  v-diasize-proc-name
     2877               ,input  'width':u
     2878               ,output v-resize-value-str
     2879               ) .
     2880             if v-resize-value-str <> '':U
     2881             then do:
     2882               run diasize_change-width in this-procedure
     2883                 (input  integer(v-resize-value-str)
     2884                 ,input  true
     2885                 ) .
     2886               assign
     2887                 v-restore-saved = true
     2888               .
     2889             end.
     2890           end.
     2891           if v-restore-saved <> true
     2892           then do:
     2893             if v-diasize-wndmax = true
     2894             then do:
     2895               run diasize_maximize in this-procedure
     2896                 (input  true
     2897                 ) .
     2898             end.
     2899           end.
     2900         end.
     2901         else do:
     2902           if v-diasize-wndmax = true
     2903           then do:
     2904             run diasize_maximize in this-procedure
     2905               (input  true
     2906               ) .
     2907           end.
     2908         end.
     2909       end.
     2910     end.
     2911   end procedure.
     2912   procedure diasize_need-full-display :
     2913     define output parameter p-need-full-display as logical   no-undo .
     2914     do
     2915     on error undo, return error return-value
     2916     :
     2917       assign
     2918         p-need-full-display = v-diasize-need-full-display
     2919       .
     2920       assign
     2921         v-diasize-need-full-display = false
     2922       .
     2923     end.
     2924   end procedure.
     2925   procedure get-context :
     2926      define output parameter p-db-num as integer          no-undo.
     2927      define output parameter p-user-id as character        no-undo.
     2928      define variable v-login               as character    no-undo.
     2929      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2930      define buffer buf_user-login  for ub.user-login .
     2931      do
     2932      on error undo, return error
     2933      :
     2934            FIND FIRST buf_sys-ctrl no-lock.
     2935            ASSIGN
     2936               v-login = USERID("ub")
     2937               p-db-num = buf_sys-ctrl.db-num
     2938            .
     2939            FIND FIRST buf_user-login
     2940                 WHERE buf_user-login.db-num = p-db-num
     2941                   AND buf_user-login.user-login = v-login
     2942                 no-lock
     2943                 no-error
     2944                 .
     2945            IF AVAILABLE buf_user-login
     2946            THEN DO:
     2947               assign
     2948                  p-user-id = buf_user-login.user-id
     2949               .
     2950            END.
     2951      end.
     2952   end procedure.
