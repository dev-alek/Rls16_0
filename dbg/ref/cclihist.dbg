     5192   PROCEDURE proc-b-print :
     5193   define variable date_string     as      char    no-undo.
     5194   define variable Line                as      char    no-undo.
     5195   define variable for-time as char.
     5196   define variable accum-count as integer.
     5197   define variable v-doc-rec as recid no-undo.
     5198   define variable v-subject-chr as character no-undo .
     5199   define variable v-upd-time as character no-undo .
     5200   define variable v-obj as character no-undo .
     5201   define variable v-action-chr as character no-undo .
     5202   define variable v-source-type as character no-undo .
     5203   DEFINE FRAME HistoryList
     5204   v-obj COLUMN-LABEL "Контрагент" FORMAT "X(12)"
     5205   v-action-chr FORMAT "X(10)" COLUMN-LABEL "Действие"
     5206   v-cli-name COLUMN-LABEL "Назв. контрагента" FORMAT "X(20)"
     5207   v-subject-chr COLUMN-LABEL "Предмет изменений" FORMAT "X(20)"
     5208   X_c-cli-hist.is-news COLUMn-LABEL "СПН" FORMAT "+/ "
     5209   v-source-type COLUMn-LABEL "Источн.!измен"
     5210   X_c-cli-hist.source-ref COLUMn-LABEL "№"
     5211   X_c-cli-hist.corr-date
     5212   v-upd-time COLUMN-LABEL "Время изм." FORMAT "X(8)"
     5213   X_c-cli-hist.corr-user-name
     5214   X_c-cli-hist.corr-user-db-num
     5215   X_c-cli-hist.host-code COLUMN-LABEL "Фирма"
     5216   HEADER  date_string AT 5 format "X(35)"
     5217   string( "Страница " ) format "X(9)" AT 115 PAGE-NUMBER(PrnLibStream) AT 125 FORMAT ">>9" SKIP
     5218   Line format "X(195)" AT 1
     5219   with width 232 down stream-io use-text    .
     5220   Line = fill("-", 195).
     5221   date_string = cur-time-print() .
     5222   assign
     5223   v-doc-rec = recid( X_c-cli-hist ).
     5224   DO WHILE available X_c-cli-hist :
     5225         GET prev br-cli-hist.
     5226   END.
     5227   run prn-lib-open-stream  in this-procedure (
     5228                                                input parparentProc
     5229                                               ,input 43
     5230                                               ,input yes
     5231                                               ,input no
     5232                                               ).
     5233   PUT  STREAM PrnLibStream
     5234   SPACE(25) ( frame Dialog-Frame:title )
     5235   format "x(90)" SKIP(1) .
     5236   FORM HEADER
     5237   Line format "X(180)" AT 1 SKIP
     5238   "Продолжение - на следующей странице" AT 30 SKIP
     5239   with FRAME BottomFrame width 232 PAGE-BOTTOM NO-LABELS NO-BOX .
     5240   VIEW  STREAM PrnLibStream FRAME BottomFrame .
     5241   FORM with FRAME HistoryList  .
     5242   run waitfram-show in this-procedure ("Ждите...").
     5243     GET next br-cli-hist.
     5244       DO WHILE available X_c-cli-hist :
     5245         Display STREAM PrnLibStream
     5246          X_c-cli-hist.obj-type + string(X_c-cli-hist.obj-code) @ v-obj
     5247         get-action(X_c-cli-hist.action) @ v-action-chr
     5248         (if v-find then get-cli(X_c-cli-hist.obj-type, X_c-cli-hist.obj-code) else "":U )
     5249         @ v-cli-name
     5250         get-subject(X_c-cli-hist.subject) @ v-subject-chr
     5251         X_c-cli-hist.is-news
     5252         get-source-type(X_c-cli-hist.source-type) @ v-source-type
     5253         X_c-cli-hist.source-ref
     5254         X_c-cli-hist.corr-date
     5255         string(X_c-cli-hist.corr-time, "HH:MM:SS":U) @ v-upd-time
     5256         X_c-cli-hist.corr-user-name
     5257         X_c-cli-hist.corr-user-db-num
     5258         X_c-cli-hist.host-code
     5259         with FRAME HistoryList .
     5260     DOWN STREAM PrnLibStream 1 with FRAME HistoryList  .
     5261     assign
     5262     accum-count = accum-count + 1
     5263     .
     5264     GET next br-cli-hist.
     5265   END.
     5266   UNDERLINE  STREAM PrnLibStream
     5267   v-obj
     5268   v-action-chr
     5269   v-cli-name
     5270   v-subject-chr
     5271   X_c-cli-hist.is-news
     5272   v-source-type
     5273   X_c-cli-hist.source-ref
     5274   X_c-cli-hist.corr-date
     5275   v-upd-time
     5276   X_c-cli-hist.corr-user-name
     5277   X_c-cli-hist.corr-user-db-num
     5278   X_c-cli-hist.host-code
     5279   with FRAME HistoryList .
     5280   DISPLAY STREAM PrnLibStream
     5281   "ИТОГО"  @ v-obj
     5282   string(accum-count)  @ v-action-chr
     5283   with frame HistoryList.
     5284   HIDE  STREAM PrnLibStream FRAME BottomFrame .
     5285   HIDE  STREAM PrnLibStream FRAME CheckList.
     5286   output  STREAM PrnLibStream CLOSE.
     5287   run waitfram-hide in this-procedure.
     5288   run prn-lib-prn-file in this-procedure (
     5289                                             input parparentproc
     5290                                             ,input 8
     5291                                             ).
     5292   reposition br-cli-hist to recid v-doc-rec no-error.
     5293   apply "entry" to br-cli-hist in frame Dialog-Frame.
     5294   END PROCEDURE.
     5295   PROCEDURE proc-b-sch :
     5296   assign
     5297     tbl = 'c-cli-hist'
     5298     join-tbl = 'X_c-cli-hist'
     5299     fld = ""
     5300     lab = ""
     5301     spr = ""
     5302     dim = '0'
     5303     .
     5304   run fltfield-add in this-procedure('obj-type*obj-code', 'Контрагент', '',
     5305   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5306   run fltfield-add in this-procedure('host-code', '', '',
     5307   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5308   run fltfield-add in this-procedure('corr-date', '', '',
     5309   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5310   run fltfield-add in this-procedure('corr-time', 'Время корр.', 'time',
     5311   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5312   run fltfield-add in this-procedure('corr-user-db-num', '', '',
     5313   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5314   run fltfield-add in this-procedure('corr-user-name', 'Изменил', 'usr',
     5315   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5316   run fltfield-add in this-procedure('subject', 'Предмет изменения', 'cli-hist-subject',
     5317   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5318   run fltfield-add in this-procedure('action', 'Действие', 'hist-action',
     5319   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5320   run fltfield-add in this-procedure('source-type', 'Источник_измен-я', 'hist-source-type',
     5321   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5322   run fltfield-add in this-procedure('source-ref', '', '',
     5323   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5324   Filter-Block:
     5325   DO ON STOP    UNDO Filter-Block, LEAVE Filter-Block
     5326       ON ERROR   UNDO Filter-Block, LEAVE Filter-Block
     5327       ON END-KEY UNDO Filter-Block, LEAVE Filter-Block :
     5328     run gbl/filter.w ( INPUT parparentproc
     5329                      , INPUT filter-point + chr(4) + filter-label
     5330                      , INPUT tbl
     5331                      , INPUT join-tbl
     5332                      , INPUT fld
     5333                      , INPUT lab
     5334                      , INPUT spr
     5335                      , INPUT dim ).
     5336     RUN OpenBr in this-procedure ( input yes, input no, input '':U, input v-corr-user-db-num).
     5337   END.
     5338   END PROCEDURE.
     5339   PROCEDURE proc-br-cli-hist :
     5340   define variable vss-include-info41 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5341   if b-sel:sensitive in frame Dialog-Frame then dO:
     5342       if b-mark:sensitive then do:
     5343           apply "choose" to b-mark in frame Dialog-Frame.
     5344       end.
     5345       else do:
     5346           apply "choose" to b-sel in frame Dialog-Frame.
     5347       end.
     5348   end.
     5349   else do:
     5350       if b-lookup:sensitive then
     5351       apply "choose" to b-lookup in frame Dialog-Frame.
     5352   end.
     5353   END PROCEDURE.
     5354   PROCEDURE proc-find-corr-date :
     5355   define input parameter p-next as logical no-undo.
     5356   define input parameter p-date like ub.fin-doc.doc-date no-undo.
     5357   define variable v-date-chr as character no-undo.
     5358   if p-date = ? then return .
     5359   display
     5360   0 @ sch-cli-code
     5361   0 @ sch-db-num
     5362   "":U @ sch-corr-user-name
     5363   with frame Dialog-Frame.
     5364   assign
     5365   v-date-chr = string(day(p-date)) + chr(47) +
     5366                    string(month(p-date)) + chr(47) +
     5367                    string(year(p-date)).
     5368          run OpenBr in this-procedure
     5369           (input false
     5370           ,input true
     5371           ,input substitute("and X_c-cli-hist.corr-date = &1 "
     5372             , v-date-chr)
     5373           ,input v-corr-user-db-num
     5374           ).
     5375         apply "entry":u to sch-corr-date in frame Dialog-Frame.
     5376   END PROCEDURE.
     5377   PROCEDURE proc-find-db-num :
     5378   define input parameter p-next as logical no-undo.
     5379   define input parameter p-db-num like ub.c-cli-hist.corr-user-db-num no-undo.
     5380   define variable v-db-num as character no-undo.
     5381   assign
     5382   sch-corr-date = ?
     5383   .
     5384   display
     5385   "":U @ sch-corr-user-name
     5386   0 @ sch-cli-code
     5387   sch-corr-date
     5388   with frame Dialog-Frame.
     5389   assign
     5390   v-db-num = string(p-db-num).
     5391   run OpenBr in this-procedure
     5392       (input false
     5393       ,input p-next
     5394       ,input substitute("and X_c-cli-hist.corr-user-db-num = &1 "
     5395         , v-db-num)
     5396       ,input v-corr-user-db-num
     5397       ).
     5398   apply "entry":u to sch-db-num in frame Dialog-Frame .
     5399   END PROCEDURE.
     5400   PROCEDURE proc-find-obj-code :
     5401   define input parameter p-next as logical no-undo.
     5402   define input parameter p-obj-code like ub.c-cli-hist.obj-code no-undo.
     5403   define variable v-obj-code as character no-undo.
     5404   display
     5405   "":U @ sch-corr-user-name
     5406   with frame Dialog-Frame.
     5407   display
     5408   "":U @ sch-corr-user-name
     5409   0 @ sch-db-num
     5410   sch-corr-date
     5411   with frame Dialog-Frame.
     5412   assign
     5413   v-obj-code = string(p-obj-code).
     5414   run OpenBr in this-procedure
     5415       (input false
     5416       ,input p-next
     5417       ,input substitute("and X_c-cli-hist.obj-code = &1 "
     5418         , v-obj-code)
     5419       ,input v-corr-user-db-num
     5420       ).
     5421   apply "entry":u to sch-cli-code in frame Dialog-Frame .
     5422   END PROCEDURE.
     5423   PROCEDURE proc-find-user :
     5424   define input parameter p-next as logical no-undo.
     5425   define input parameter p-user like ub.c-cli-hist.corr-user-name no-undo.
     5426   assign
     5427   sch-corr-date = ?.
     5428   display
     5429   0 @ sch-db-num
     5430   sch-corr-date
     5431   0 @ sch-cli-code
     5432   with frame Dialog-Frame.
     5433   p-user = chr(34) + p-user + chr(34).
     5434   run OpenBr in this-procedure
     5435       (input false
     5436       ,input p-next
     5437       ,input substitute("and X_c-cli-hist.corr-user-name = &1 "
     5438         , p-user)
     5439       ,input v-corr-user-db-num
     5440       ).
     5441   apply "entry":u to sch-corr-user-name in frame Dialog-Frame .
     5442   END PROCEDURE.
     5443   PROCEDURE proc-view-changes :
     5444   define variable v-description as character no-undo .
     5445   RUN get-show-reason IN THIS-PROCEDURE.
     5446   for each temp-changes:
     5447       delete temp-changes.
     5448   END.
     5449   if not available X_c-cli-hist then do:
     5450     Open QUery br-changes for each temp-changes.
     5451     return.
     5452   end.
     5453   if v-show-reason = ? then do:
     5454   end.
     5455   run ref/cclihisv.p (
     5456                      input X_c-cli-hist.obj-type
     5457                     ,input X_c-cli-hist.obj-code
     5458                     ,input X_c-cli-hist.chip-num
     5459                     ,input X_c-cli-hist.corr-user-db-num
     5460                     ,input X_c-cli-hist.host-code
     5461                     ,input X_c-cli-hist.subject
     5462                     ,input X_c-cli-hist.action
     5463                     ,input no
     5464                     ,output v-description
     5465                  ) no-error .
     5466   Open QUery br-changes for each temp-changes.
     5467   assign
     5468   br-changes:title in frame Dialog-Frame = v-description
     5469   .
     5470   END PROCEDURE.
     5471   FUNCTION get-action RETURNS CHARACTER
     5472     ( p-action as integer ) :
     5473   define variable dops as character no-undo.
     5474   assign dops = entry (lookup (trim(string(p-action)), '99,1,2,3,4,9,51,79':U), 'Удаление,Создание,Изменение,Коррекция,Восстановление,Смена_кода,Смена_артик,Выключ.':U) no-error.
     5475   RETURN dops.
     5476   END FUNCTION.
     5477   FUNCTION get-cli RETURNS CHARACTER
     5478     ( p-obj-type as character, p-obj-code as integer ) :
     5479   define buffer buf_clients for ub.clients.
     5480   find first buf_clients no-lock where
     5481             buf_clients.obj-type = p-obj-type
     5482         AND buf_clients.obj-code = p-obj-code
     5483         no-error.
     5484   if not available buf_clients then do:
     5485       return "!!! Неизвестный контрагент!!!".
     5486   end.
     5487     RETURN buf_clients.obj-name.
     5488   END FUNCTION.
     5489   FUNCTION get-source-type RETURNS CHARACTER
     5490     ( p-source-type as character ) :
     5491   define variable v-dop as character no-undo .
     5492   assign
     5493   v-dop = entry (lookup (p-source-type, ',db,esys,trn-doc,payment,fin-doc,import,recalc,wth-doc,ren-gdsc,upgrade,grp-chg,stop-list,dis-card':U), ',БД,ВС,Документ,Платеж,Фин.док.,Импорт,Пересчет,Документ МЦ,Коллизия,Апгрейд,Изм.группы,Стоплист,ДК':U)
     5494   no-error
     5495   .
     5496   RETURN v-dop.
     5497   END FUNCTION.
     5498   FUNCTION get-subject RETURNS CHARACTER
     5499     ( p-subject as character ) :
     5500     RETURN entry (lookup (p-subject, 'clients,clients-attr,thbj-attr,sysconf,firm,person,shop,store,staff,dis-thbj-rule,ext-classif':U), 'Клиент,Атрибут клиента,Параметры объекта TH,Своя фирма,Организация,Физ.лицо,Магазин,store,Персонал,Общие скидки,Внешний классификатор':U).
     5501   END FUNCTION.
