      807   procedure prn-lib-reportviewer :
      808     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      809     define input parameter p-report-name-html as character no-undo .
      810     define input parameter p-param        as character no-undo .
      811     define variable v-excel           as character no-undo init 'TRUE' .
      812     define variable v-value-character as character no-undo .
      813     define variable v-value-integer   as character no-undo .
      814     define variable v-value-date      as date      no-undo .
      815     define variable v-value-decimal   as decimal   no-undo .
      816     define variable rep-excel         as logical   no-undo .
      817     define variable excel-string      as character no-undo .
      818     define variable v-param-type      as character no-undo .
      819     define variable v-tth             as handle    no-undo .
      820     run adm/shattri.p (
      821       input "get":U
      822       ,input  ""
      823       ,input  0
      824       ,input  'report-glob':U
      825       ,input  'rep-excel':U
      826       ,output v-value-character
      827       ,output v-value-date
      828       ,output v-value-decimal
      829       ,output v-value-integer
      830       ,output rep-excel
      831       ,output v-param-type
      832       ,INPUT-OUTPUT table-handle v-tth
      833       )  .
      834     if rep-excel then v-excel = "TRUE" .
      835     else v-excel = "FALSE" .
      836     if p-param eq ""
      837     then
      838        p-param = "EXCEL:" + v-excel.
      839     else
      840        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      841     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      842   end procedure.
