     1075   FUNCTION get-all-fields returns character (p-file-name as character ):
     1076   define variable v-dop as character no-undo .
     1077     find first _file no-lock where _file._file-name = p-file-name no-error .
     1078     if not available _file then return "":U.
     1079     for each _field no-lock where
     1080              _field._file-recid = recid(_file) :
     1081       assign
     1082       v-dop = v-dop + _field._field-name + chr(44)
     1083       .
     1084     end.
     1085     return trim(v-dop).
     1086   END FUNCTION.
     1087   PROCEDURE proc-full-temp-changes :
     1088     define input  parameter p-hst-handle as handle    no-undo .
     1089     define input  parameter p-main-table as character no-undo .
     1090     define input  parameter p-field-list as character no-undo .
     1091     define input  parameter p-label-form as character no-undo .
     1092     define variable h-new-buf         as handle    no-undo .
     1093     define variable h-main-buf        as handle    no-undo .
     1094     define variable h-for-comp        as handle    no-undo .
     1095     define variable v-inform          as character no-undo .
     1096     define variable v-ind             as integer   no-undo .
     1097     define variable v-idx-field-qnty  as integer   no-undo .
     1098     define variable v-num-entries     as integer   no-undo .
     1099     define variable fh                as handle    no-undo .
     1100     define variable fh-main           as handle    no-undo .
     1101     define variable fh-old            as handle    no-undo .
     1102     define variable fh-new            as handle    no-undo .
     1103     define variable v-field-name      as character no-undo .
     1104     define variable v-field-lvl       as character no-undo .
     1105     define variable v-field-form      as character no-undo .
     1106     define variable v-search-exp      as character no-undo .
     1107     define variable v-srch-main       as character no-undo .
     1108     define variable v-word-link       as character no-undo .
     1109     define variable v-av-chip-num     as logical   no-undo .
     1110     define variable v-main-pi-fld-lst as character no-undo .
     1111     define variable v-main-fld-lst    as character no-undo .
     1112     define variable v-delim-list      as character no-undo .
     1113     define variable v-label           as character no-undo .
     1114     define variable v-old-value       as character no-undo case-sensitive.
     1115     define variable v-new-value       as character no-undo case-sensitive.
     1116     define variable v-chg-fields as character no-undo.
     1117     for each temp-changes:
     1118       delete temp-changes.
     1119     end.
     1120     if not p-hst-handle:available then do:
     1121       return .
     1122     end.
     1123     create buffer h-new-buf  for table p-hst-handle .
     1124     create buffer h-main-buf for table p-main-table .
     1125     assign
     1126       v-inform = h-main-buf:index-information(1)
     1127       v-ind    = 2
     1128     .
     1129     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1130     on error undo, return error
     1131     :
     1132       assign
     1133         v-inform = h-main-buf:index-information( v-ind )
     1134         v-ind    = v-ind + 1
     1135       .
     1136     end.
     1137     if v-inform = ?
     1138       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1139       or entry( 3, v-inform, ",":U ) <> "1":U
     1140     then do:
     1141       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, h-main-buf:name ).
     1142     end.
     1143     assign
     1144       v-idx-field-qnty = num-entries( v-inform ) - 4
     1145     .
     1146     if v-idx-field-qnty < 2 then do:
     1147       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, h-main-buf:name ).
     1148     end.
     1149     assign
     1150       v-srch-main   = "where":U
     1151       v-word-link   = "":U
     1152       v-av-chip-num = false
     1153       v-delim-list  = "":U
     1154     .
     1155     do v-ind = 1 to v-idx-field-qnty by 2
     1156     on error undo, return error
     1157     :
     1158       assign
     1159         v-field-name      = entry( 4 + v-ind, v-inform, ",":U )
     1160         fh                = p-hst-handle:buffer-field( v-field-name )
     1161         fh-main           = h-main-buf:buffer-field( v-field-name )
     1162         v-srch-main       = substitute( "&1 &2 &3.&4 =", v-srch-main, v-word-link, fh-main:table, v-field-name )
     1163         v-main-pi-fld-lst = v-main-pi-fld-lst + v-delim-list + v-field-name
     1164       .
     1165       if fh:data-type ="character":U then do:
     1166         assign
     1167           v-srch-main = substitute( '&1 "&2"', v-srch-main, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
     1168         .
     1169       end.
     1170       else do:
     1171         assign
     1172           v-srch-main = substitute( "&1 &2", v-srch-main, fh:buffer-value() )
     1173         .
     1174       end.
     1175       if v-delim-list = "":U then do:
     1176         assign
     1177           v-delim-list = ",":U
     1178         .
     1179       end.
     1180       if v-word-link = "":U then do:
     1181         assign
     1182           v-word-link = "and":U
     1183         .
     1184       end.
     1185     end.
     1186     assign
     1187       v-delim-list  = "":U
     1188     .
     1189     do v-ind = 1 to h-main-buf:num-fields
     1190     on error undo, return error
     1191     :
     1192       assign
     1193         fh-main      = h-main-buf:buffer-field( v-ind )
     1194         v-field-name = fh-main:name
     1195       .
     1196         assign
     1197           v-main-fld-lst = v-main-fld-lst + v-delim-list + v-field-name
     1198         .
     1199         if v-delim-list = "":U then do:
     1200           assign
     1201             v-delim-list = ",":U
     1202           .
     1203         end.
     1204     end.
     1205     assign
     1206       v-inform = p-hst-handle:index-information(1)
     1207       v-ind    = 2
     1208     .
     1209     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1210     on error undo, return error
     1211     :
     1212       assign
     1213         v-inform = p-hst-handle:index-information( v-ind )
     1214         v-ind    = v-ind + 1
     1215       .
     1216     end.
     1217     if v-inform = ?
     1218       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1219       or entry( 3, v-inform, ",":U ) <> "1":U
     1220     then do:
     1221       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, p-hst-handle:name ).
     1222     end.
     1223     assign
     1224       v-idx-field-qnty = num-entries( v-inform ) - 4
     1225     .
     1226     if v-idx-field-qnty < 2 then do:
     1227       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, p-hst-handle:name ).
     1228     end.
     1229     assign
     1230       v-search-exp  = "where":U
     1231       v-word-link   = "":U
     1232       v-av-chip-num = false
     1233     .
     1234     do v-ind = 1 to v-idx-field-qnty by 2
     1235     on error undo, return error
     1236     :
     1237       assign
     1238         v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     1239         fh           = p-hst-handle:buffer-field( v-field-name )
     1240         v-search-exp = substitute( "&1 &2 &3.&4", v-search-exp, v-word-link, fh:table, v-field-name )
     1241       .
     1242       if v-field-name = "chip-num":U then do:
     1243         assign
     1244           v-search-exp  = substitute( "&1 >", v-search-exp )
     1245           v-av-chip-num = true
     1246         .
     1247       end.
     1248       else do:
     1249         assign
     1250           v-search-exp = substitute( "&1 =", v-search-exp )
     1251         .
     1252       end.
     1253       if fh:data-type ="character":U then do:
     1254         assign
     1255           v-search-exp = substitute( '&1 "&2"', v-search-exp, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
     1256         .
     1257       end.
     1258       else do:
     1259         assign
     1260           v-search-exp = substitute( '&1 &2', v-search-exp, fh:buffer-value() )
     1261         .
     1262       end.
     1263       if v-word-link = "":U then do:
     1264         assign
     1265           v-word-link = "and":U
     1266         .
     1267       end.
     1268     end.
     1269     if v-av-chip-num = false then do:
     1270       message
     1271         vss-workfile vss-revision vss-description skip
     1272         substitute( "Таблица &2 не содержит поля chip-num.", vss-workfile, p-hst-handle:name ) skip
     1273         "Использование данной процедуры невозможно!" skip
     1274         view-as alert-box error .
     1275       return error .
     1276     end.
     1277     h-new-buf:find-first( v-search-exp, no-lock ) no-error .
     1278     if not h-new-buf:available then do:
     1279       h-main-buf:find-first( v-srch-main, no-lock ) no-error .
     1280       if not h-main-buf:available then do:
     1281         assign
     1282           h-for-comp = ?
     1283         .
     1284       end.
     1285       else do:
     1286         assign
     1287           h-for-comp = h-main-buf
     1288         .
     1289       end.
     1290     end.
     1291     else do:
     1292       assign
     1293         h-for-comp = h-new-buf
     1294       .
     1295     end.
     1296     assign
     1297       v-num-entries = num-entries( v-main-fld-lst, ",":U )
     1298     .
     1299     do v-ind = 1 to v-num-entries
     1300     on error undo, return error return-value
     1301     :
     1302       assign
     1303         v-field-name = entry( v-ind, v-main-fld-lst )
     1304         fh-old       = p-hst-handle:buffer-field( v-field-name )
     1305         v-old-value  = fh-old:buffer-value()
     1306         v-label      = trim( fh-old:label )
     1307       .
     1308       if ( trim( p-field-list ) <> "":U
     1309            and lookup( v-field-name, p-field-list ) > 0
     1310          )
     1311          or trim( p-field-list ) = "":U
     1312       then do:
     1313         if h-for-comp <> ? then do:
     1314           assign
     1315             fh-new      = h-for-comp:buffer-field( v-field-name )
     1316             v-new-value = fh-new:buffer-value()
     1317           .
     1318         end.
     1319         else do:
     1320           assign
     1321             v-new-value = "":U
     1322           .
     1323         end.
     1324         if v-old-value <> v-new-value
     1325         then do:
     1326           create temp-changes.
     1327           assign
     1328             temp-changes.t_name = p-main-table
     1329             temp-changes.f_name = v-field-name
     1330             temp-changes.l_name = replace( v-label, "&":U, "":U )
     1331             temp-changes.v_old  = trim( v-old-value )
     1332             temp-changes.v_new  = trim( v-new-value )
     1333             temp-changes.num_   = 0
     1334             temp-changes.fNotChange = v-old-value eq v-new-value
     1335           .
     1336         end.
     1337       end.
     1338     end.
     1339     assign
     1340       v-num-entries = num-entries( p-label-form, chr(8) )
     1341     .
     1342     do v-ind = 1 to v-num-entries
     1343     on error undo, return error return-value
     1344     :
     1345       if num-entries( entry( v-ind, p-label-form, chr(8) ), chr(4) ) = 3 then do:
     1346         assign
     1347           v-field-name = entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1348           v-field-lvl  = entry( 2, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1349           v-field-form = entry( 3, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1350         .
     1351         find first temp-changes
     1352           where temp-changes.f_name = v-field-name
     1353           no-error .
     1354         if available temp-changes then do:
     1355           if trim( v-field-lvl ) <> "":U then do:
     1356             assign
     1357               temp-changes.l_name = v-field-lvl
     1358             .
     1359           end.
     1360           if trim( v-field-form ) <> "":U then do:
     1361             assign
     1362               temp-changes.v_old = dynamic-function( v-field-form, temp-changes.v_old )
     1363             .
     1364             if h-for-comp <> ? then do:
     1365               assign
     1366                 temp-changes.v_new = dynamic-function( v-field-form, temp-changes.v_new )
     1367               .
     1368             end.
     1369           end.
     1370         end.
     1371       end.
     1372       else do:
     1373         message
     1374           vss-workfile vss-revision vss-description skip
     1375           "Ошибка! Список должен содержать три поля с разделителем delim-par!" skip
     1376           substitute( "список для поля '&1': '&2'"
     1377                       ,entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1378                       ,entry( v-ind, p-label-form, chr(8) )
     1379                     ) skip
     1380           substitute( "полный список: &2", p-label-form ) skip
     1381           view-as alert-box error .
     1382       end.
     1383     end.
     1384     delete object h-new-buf .
     1385     delete object h-main-buf .
     1386   END PROCEDURE.
     1387   FUNCTION get-action RETURNS CHARACTER
     1388     ( p-action as integer )  FORWARD.
     1389   FUNCTION get-cli RETURNS CHARACTER
     1390     ( p-obj-type as character, p-obj-code as integer )  FORWARD.
     1391   FUNCTION get-source-type RETURNS CHARACTER
     1392     ( p-source-type as character )  FORWARD.
     1393   FUNCTION get-subject RETURNS CHARACTER
     1394     ( p-subject as character )  FORWARD.
     1395   DEFINE BUTTON B-Help
     1396        LABEL "Помо&щь"
     1397        SIZE 3 BY 1
     1398        BGCOLOR 8 .
     1399   DEFINE BUTTON B-lookup
     1400        LABEL "&Контрагент"
     1401        SIZE 10 BY 1.
     1402   DEFINE BUTTON B-mark
     1403        LABEL "&*"
     1404        SIZE 3 BY 1.
     1405   DEFINE BUTTON B-print
     1406        LABEL "Пе&чать"
     1407        SIZE 3 BY 1.
     1408   DEFINE BUTTON b-quit AUTO-END-KEY
     1409        LABEL "&Выход"
     1410        SIZE 10 BY 1
     1411        BGCOLOR 8 .
     1412   DEFINE BUTTON b-reason
     1413        LABEL "&Причина"
     1414        SIZE 10 BY 1.
     1415   DEFINE BUTTON B-sch
     1416        LABEL "&Фильтр"
     1417        SIZE 3 BY 1.
     1418   DEFINE BUTTON b-sel AUTO-GO
     1419        LABEL "Вы&бор"
     1420        SIZE 10 BY 1
     1421        BGCOLOR 8 .
     1422   DEFINE VARIABLE mark-num AS CHARACTER FORMAT "X(256)":U
     1423         VIEW-AS TEXT
     1424        SIZE 6 BY 1
     1425        FGCOLOR 4  NO-UNDO.
     1426   DEFINE VARIABLE sch-cli-code AS INTEGER FORMAT ">>>>>>9":U INITIAL 0
     1427        LABEL "коду"
     1428        VIEW-AS FILL-IN
     1429        SIZE 8 BY 1 TOOLTIP "Поиск первой записи - <ВВОД>; поиск следующей - <CTRL-J>" NO-UNDO.
     1430   DEFINE VARIABLE sch-corr-date AS DATE FORMAT "99/99/9999":U
     1431        LABEL "Дате изменения"
     1432        VIEW-AS FILL-IN
     1433        SIZE 11 BY 1 NO-UNDO.
     1434   DEFINE VARIABLE sch-corr-user-name AS CHARACTER FORMAT "X(9)":U
     1435        LABEL "пользователю"
     1436        VIEW-AS FILL-IN
     1437        SIZE 12 BY 1 TOOLTIP "Поиск первой записи - <ВВОД>; поиск следующей - <CTRL-J>" NO-UNDO.
     1438   DEFINE VARIABLE sch-db-num AS INTEGER FORMAT ">>>>>>9":U INITIAL 0
     1439        LABEL "БД"
     1440        VIEW-AS FILL-IN
     1441        SIZE 8 BY 1 TOOLTIP "Поиск первой записи - <ВВОД>; поиск следующей - <CTRL-J>" NO-UNDO.
     1442   DEFINE VARIABLE v-corr-user-db-num AS INTEGER FORMAT ">>>>9":U INITIAL 0
     1443        LABEL "по БД"
     1444        VIEW-AS FILL-IN
     1445        SIZE 6 BY 1 NO-UNDO.
     1446   DEFINE QUERY BR-changes FOR
     1447         temp-changes SCROLLING.
     1448   DEFINE QUERY br-cli-hist FOR
     1449         X_c-cli-hist SCROLLING.
     1450   DEFINE BROWSE BR-changes
     1451     QUERY BR-changes DISPLAY
     1452         temp-changes.l_name COLUMn-LABEL "Изменилось" format "X(40)"
     1453   temp-changes.v_old COLUMn-LABEL "Было" format "X(255)"
     1454   temp-changes.v_new COLUMn-LABEL "Стало" format "X(255)"
     1455       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 7.25.
     1456   DEFINE BROWSE br-cli-hist
     1457     QUERY br-cli-hist NO-LOCK DISPLAY
     1458         mark-string(recid(X_c-cli-hist), v-rid-list) COLUMN-LABEL "*" FORMAT "X(1)":U
     1459         X_c-cli-hist.corr-date FORMAT "99/99/9999":U
     1460         string(X_c-cli-hist.corr-time, "HH:MM:SS":U) COLUMN-LABEL "Время изм." FORMAT "X(8)":U
     1461         usrfulnf(X_c-cli-hist.corr-user-name) COLUMn-LABEL "Изменил" FORMAT "X(255)":U width 18
     1462         get-action(X_c-cli-hist.action) COLUMN-LABEL "Действие" FORMAT "X(10)":U
     1463         X_c-cli-hist.corr-user-db-num FORMAT ">>>>9":U
     1464         X_c-cli-hist.is-news FORMAT "+/":U
     1465         get-source-type(X_c-cli-hist.source-type) COLUMN-LABEL "Источн.!измен."
     1466         X_c-cli-hist.source-ref FORMAT "X(14)":U
     1467         X_c-cli-hist.obj-type + string(X_c-cli-hist.obj-code) COLUMN-LABEL "Объект" FORMAT "X(12)":U
     1468         if v-find then get-cli(X_c-cli-hist.obj-type, X_c-cli-hist.obj-code) else "":U COLUMN-LABEL "Назв. контрагента" FORMAT "X(25)":U
     1469         get-subject(X_c-cli-hist.subject) COLUMN-LABEL "Предмет изменения" FORMAT "X(35)":U WIDTH 15
     1470         X_c-cli-hist.host-code COLUMN-LABEL "Фирма" FORMAT "9999999999":U
     1471     ENABLE
     1472         X_c-cli-hist.corr-date
     1473       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 11.46.
     1474   DEFINE FRAME Dialog-Frame
     1475        b-quit AT ROW 1 COL 1
     1476        B-mark AT ROW 1 COL 11
     1477        b-sel AT ROW 1 COL 21
     1478        v-corr-user-db-num AT ROW 1 COL 37 COLON-ALIGNED
     1479        B-lookup AT ROW 1 COL 49
     1480        b-reason AT ROW 1 COL 59
     1481        B-print AT ROW 1 COL 89
     1482        B-sch AT ROW 1 COL 92
     1483        B-Help AT ROW 1 COL 95
     1484        br-cli-hist AT ROW 2 COL 1
     1485        sch-db-num AT ROW 13.63 COL 60.13 COLON-ALIGNED
     1486        sch-corr-date AT ROW 13.63 COL 85.75 COLON-ALIGNED
     1487        sch-cli-code AT ROW 13.67 COL 48.13 COLON-ALIGNED
     1488        sch-corr-user-name AT ROW 13.71 COL 22.5 COLON-ALIGNED
     1489        BR-changes AT ROW 14.79 COL 1
     1490        mark-num AT ROW 1 COL 12.5 COLON-ALIGNED NO-LABEL
     1491        "ПОИСК ПО" VIEW-AS TEXT
     1492             SIZE 8.38 BY 1 AT ROW 13.63 COL 1.38
     1493             FGCOLOR 4
     1494        SPACE(89.48) SKIP(7.44)
     1495       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1496            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1497            TITLE "Полная история по контрагенту"
     1498            CANCEL-BUTTON b-quit.
     1499   ASSIGN
     1500          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1501          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1502   ASSIGN
     1503          br-cli-hist:COLUMN-RESIZABLE IN FRAME Dialog-Frame       = TRUE.
     1504   ON GO OF FRAME Dialog-Frame
     1505   DO:
     1506     p-rid-list = v-rid-list.
     1507   END.
     1508   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1509   DO:
     1510     APPLY "END-ERROR":U TO SELF.
     1511   END.
     1512   ON CHOOSE OF B-lookup IN FRAME Dialog-Frame
     1513   DO:
     1514   run ref/showcli.p (
     1515                  input parparentproc
     1516                 ,input X_c-cli-hist.obj-type
     1517                 ,input X_c-cli-hist.obj-code
     1518                 ) no-error.
     1519   if error-status:error then return no-apply.
     1520   END.
     1521   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
     1522   DO:
     1523   define variable loc#log as logical no-undo .
     1524     if available X_c-cli-hist then do:
     1525   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1526   define variable v-str-recid14 as character no-undo .
     1527   define variable v-num-entry14 as integer   no-undo .
     1528   assign
     1529     v-str-recid14 = trim( string( recid( X_c-cli-hist ) , "->>>>>>>>>>>9":U ) )
     1530     v-num-entry14 = lookup( v-str-recid14 , v-rid-list )
     1531   .
     1532   if v-num-entry14 > 0 then do:
     1533     assign
     1534       entry( v-num-entry14, v-rid-list ) = "":U
     1535       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1536     .
     1537   end.
     1538   else do:
     1539     assign
     1540       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid14
     1541     .
     1542   end.
     1543       loc#log = br-cli-hist:refresh() .
     1544       if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
     1545           loc#log = br-cli-hist:select-next-row ().
     1546           apply "VALUE-CHANGED" to br-cli-hist in frame Dialog-Frame.
     1547       end.
     1548       if num-entries( v-rid-list ) = 0
     1549       then
     1550           hide mark-num in frame Dialog-Frame.
     1551       else
     1552           disp num-entries( v-rid-list ) @ mark-num with frame Dialog-Frame.
     1553     end.
     1554     apply "entry" to br-cli-hist in frame Dialog-Frame.
     1555   END.
     1556   ON CHOOSE OF B-print IN FRAME Dialog-Frame
     1557   DO:
     1558       run proc-b-print in this-procedure no-error.
     1559     if error-status:error then return no-apply.
     1560   END.
     1561   ON CHOOSE OF b-reason IN FRAME Dialog-Frame
     1562   DO:
     1563     define variable v-list as character no-undo.
     1564     case X_c-cli-hist.obj-type :
     1565       when 'орг':U   then do:
     1566         run str/hstcrsns.w (
     1567                          input        parparentproc
     1568                        , input        "":U
     1569                        , input        "frm":U
     1570                        , input        (if p-mode = 'все':U
     1571                                        then X_c-cli-hist.obj-code
     1572                                        else p-obj-code)
     1573                        , input        ?
     1574                        , input        ?
     1575                        , input-output v-list
     1576                        ) no-error.
     1577       end.
     1578       when 'маг':U  or
     1579       when 'скл':U then do:
     1580         run str/objcrsns.w ( input        parparentproc
     1581                        , input        "":U
     1582                        , input        "obj":U
     1583                        , input        (if p-mode = 'все':U
     1584                                        then X_c-cli-hist.obj-type
     1585                                        else p-obj-type)
     1586                        , input        (if p-mode = 'все':U
     1587                                        then X_c-cli-hist.obj-code
     1588                                        else p-obj-code)
     1589                        , input        ?
     1590                        , input        ?
     1591                        , input-output v-list
     1592                        ) no-error.
     1593       end.
     1594       otherwise          do:
     1595         return no-apply.
     1596       end.
     1597     end case.
     1598     if error-status :error then do: return no-apply. end.
     1599   END.
     1600   ON CHOOSE OF B-sch IN FRAME Dialog-Frame
     1601   DO:
     1602       run proc-b-sch in this-procedure no-error.
     1603     if error-status:error then return no-apply.
     1604   END.
     1605   ON CHOOSE OF b-sel IN FRAME Dialog-Frame
     1606   DO:
     1607     if ( available X_c-cli-hist ) then do:
     1608       if ( v-rid-list = "" ) or b-mark:sensitive = no
     1609       then
     1610       v-rid-list = string( recid( X_c-cli-hist ) ) .
     1611     end.
     1612   END.
     1613   ON MOUSE-SELECT-DBLCLICK OF br-cli-hist IN FRAME Dialog-Frame
