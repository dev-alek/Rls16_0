     1639      run proc-find-corr-date in this-procedure(yes, input frame Dialog-Frame sch-corr-date) no-error.
     1640     if error-status:error then return no-apply.
     1641   END.
     1642   ON RETURN OF sch-corr-date IN FRAME Dialog-Frame
     1643   DO:
     1644     run proc-find-corr-date in this-procedure(no, input frame Dialog-Frame sch-corr-date) no-error.
     1645     if error-status:error then return no-apply.
     1646   END.
     1647   ON CTRL-J OF sch-corr-user-name IN FRAME Dialog-Frame
     1648   DO:
     1649     run proc-find-user in this-procedure(yes, input frame Dialog-Frame sch-corr-user-name) no-error.
     1650     if error-status:error then return no-apply.
     1651   END.
     1652   ON RETURN OF sch-corr-user-name IN FRAME Dialog-Frame
     1653   DO:
     1654     run proc-find-user in this-procedure(no, input frame Dialog-Frame sch-corr-user-name) no-error.
     1655     if error-status:error then return no-apply.
