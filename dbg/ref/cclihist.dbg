      866   define variable v-fltopend-rowid as rowid extent 18 no-undo .
      867   procedure fltopend_fltopend :
      868   define input parameter p-parent-handle as handle no-undo .
      869   define input parameter p-qh as handle no-undo .
      870   define input parameter p-flt-open-open-query  as character no-undo .
      871   define input parameter p-where-cond as character no-undo .
      872   define input parameter p-use-indFIRST-query-tail as character no-undo .
      873   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      874   define input parameter p-indexed-reposition as character no-undo .
      875     do
      876     on error undo, return error
      877     :
      878   define variable v-prepare-string as character no-undo .
      879   define variable glog as logical no-undo .
      880   assign
      881   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      882                      p-where-cond + chr(32)  +
      883                      p-use-indFIRST-query-tail + chr(32) +
      884                      p-use-ind-sort-clmn-by + chr(32) +
      885                      p-indexed-reposition
      886   .
      887   assign
      888   glog = p-qh:query-prepare(v-prepare-string) no-error .
      889   if not glog
      890   or error-status:error then do:
      891     message error-status:get-message(1) view-as alert-box .
      892     undo, return error .
      893   end.
      894   assign
      895   glog = p-qh:query-open no-error .
      896   if not glog
      897   or error-status:error then do:
      898     message error-status:get-message(1) view-as alert-box .
      899     undo, return error .
      900   end.
      901     end.
      902   end procedure.
      903   procedure fltopend_fltfindd :
      904   define input parameter p-parent-handle as handle no-undo .
      905   define input parameter p-qh as handle no-undo .
      906   define input parameter p-rowid as rowid no-undo .
      907   define input parameter p-next as logical no-undo .
      908   define input parameter p-lock as integer no-undo .
      909   define input parameter p-bh as handle no-undo .
      910   define input parameter p-where-cond as character no-undo .
      911   define input parameter p-use-index-phrase as character no-undo .
      912   define variable glog as logical no-undo .
      913   define variable v-qh as handle no-undo .
      914   define variable v-bh as handle no-undo .
      915   define variable v-recid as recid no-undo .
      916   define variable v-prepare-string as character no-undo .
      917   do
      918   on error undo, return error
      919   on stop undo, return error
      920   :
      921     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
      922     create buffer v-bh for table p-bh buffer-name p-bh:name.
      923     create query v-qh.
      924     v-qh:set-buffers(v-bh).
      925     v-prepare-string = substitute("for each &1 &2 &3"
      926                                     ,v-bh:name
      927                                     ,p-where-cond
      928                                     ,p-use-index-phrase).
      929     glog = v-qh:query-prepare(v-prepare-string) no-error.
      930     if not glog then do:
      931       delete object v-qh.
      932       delete object v-bh.
      933       undo, return error .
      934     end.
      935     glog = v-qh:query-open no-error .
      936     if not glog then do:
      937       delete object v-qh.
      938       delete object v-bh.
      939       undo, return error .
      940     end.
      941     if p-next then do:
      942       v-qh:reposition-to-rowid(p-rowid) no-error .
      943       glog = v-qh:get-next( p-lock) no-error .
      944       glog = v-qh:get-next( p-lock) no-error .
      945       if not glog or v-qh:query-off-end = yes then do:
      946         glog = v-qh:get-first( p-lock) no-error .
      947       end.
      948     end.
      949     else do:
      950       glog = v-qh:get-first( p-lock) no-error .
      951     end.
      952     v-recid = v-bh:recid no-error .
      953     delete object v-qh.
      954     delete object v-bh.
      955     return string(v-recid) .
      956   end.
      957   end procedure.
      958   procedure fltopend_fltfindq :
      959   define input parameter p-parent-handle as handle no-undo .
      960   define input parameter p-qh as handle no-undo .
      961   define input parameter p-next as logical no-undo .
      962   define input parameter p-lock as integer no-undo .
      963   define input parameter p-flt-open-open-query  as character no-undo .
      964   define input parameter p-where-cond as character no-undo .
      965   define input parameter p-use-indFIRST-query-tail as character no-undo .
      966   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      967   define input parameter p-indexed-reposition as character no-undo .
      968   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
      969   define variable glog as logical no-undo .
      970   define variable v-qh as handle no-undo .
      971   define variable v-bh as handle no-undo extent 18.
      972   define variable v-rowid as rowid no-undo extent 18.
      973   define variable v-ii as integer no-undo .
      974   define variable v-prepare-string as character no-undo .
      975   do
      976   on error undo, return error
      977   on stop undo, return error
      978   :
      979     create query v-qh.
      980     do v-ii = 1 to p-qh:num-buffers:
      981       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
      982       assign
      983       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
      984       no-error.
      985       v-qh:add-buffer(v-bh[v-ii]).
      986     end.
      987     assign
      988     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      989                       p-where-cond + chr(32)  +
      990                       p-use-indFIRST-query-tail + chr(32) +
      991                       p-use-ind-sort-clmn-by + chr(32) +
      992                       p-indexed-reposition
      993     .
      994     glog = v-qh:query-prepare( v-prepare-string) no-error .
      995     if not glog then do:
      996       delete object v-qh.
      997       do v-ii = 1 to p-qh:num-buffers:
      998         delete object v-bh[v-ii].
      999       end.
     1000       undo, return error .
     1001     end.
     1002     glog = v-qh:query-open no-error .
     1003     if not glog then do:
     1004       delete object v-qh.
     1005       do v-ii = 1 to p-qh:num-buffers:
     1006         delete object v-bh[v-ii].
     1007       end.
     1008       undo, return error .
     1009     end.
     1010     if p-next then do:
     1011       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
     1012       glog = v-qh:get-next( p-lock) no-error .
     1013       glog = v-qh:get-next( p-lock) no-error .
     1014       if not glog or v-qh:query-off-end = yes then do:
     1015         glog = v-qh:get-first( p-lock) no-error .
     1016       end.
     1017     end.
     1018     else do:
     1019       glog = v-qh:get-first( p-lock) no-error .
     1020     end.
     1021     do v-ii = 1 to p-qh:num-buffers:
     1022       assign
     1023       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
     1024       no-error.
     1025     end.
     1026     delete object v-qh.
     1027     do v-ii = 1 to p-qh:num-buffers:
     1028       delete object v-bh[v-ii].
     1029     end.
     1030   end.
     1031   end procedure.
