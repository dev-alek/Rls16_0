        1   DEFINE SHARED TEMP-TABLE tt-fin-doc NO-UNDO LIKE ub.fin-doc.
        2   DEFINE INPUT     PARAMETER parParentProc  AS WIDGET-HANDLE NO-UNDO.
        3   define input parameter p-curr-host-code like ub.sysconf.host-code no-undo.
        4   define input parameter p-mode as character no-undo.
        5   define input parameter p-host-code like ub.fin-doc.host-code no-undo.
        6   define input parameter p-fin-doc-code like ub.fin-doc.fin-doc-code no-undo.
        7   define input parameter p-fin-ext-doc-type like ub.fin-doc.fin-ext-doc-type no-undo.
        8   define input-output parameter p-doc-rec as recid no-undo.
        9   define variable vss-revision    as character no-undo init "$Revision$":U .
       10   define variable vss-author      as character no-undo init "$Author$":U .
       11   define variable vss-date        as character no-undo init "$Date$":U .
       12   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       13   define variable vss-archive     as character no-undo init "$Archive$":U .
       14   define variable vss-description as character no-undo init "Карточка редактирования платежного поручения-дополнительные поля".
       15   procedure vss-get-info :
       16     define output parameter p-vss-revision    like vss-revision    no-undo .
       17     define output parameter p-vss-author      like vss-author      no-undo .
       18     define output parameter p-vss-date        like vss-date        no-undo .
       19     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       20     define output parameter p-vss-archive     like vss-archive     no-undo .
       21     define output parameter p-vss-description like vss-description no-undo .
       22     assign
       23       p-vss-revision    = vss-revision
       24       p-vss-author      = vss-author
       25       p-vss-date        = vss-date
       26       p-vss-workfile    = vss-workfile
       27       p-vss-archive     = vss-archive
       28       p-vss-description = vss-description
       29     .
       30   end procedure.
       31   procedure vss-get-parameters :
       32     define output parameter p-vss-parameters as character no-undo .
       33   end procedure.
       34   define new global shared variable g#vssrevis-logger as handle    no-undo .
       35   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       36   define variable v-vssrevis-logger                   as handle    no-undo .
       37   procedure vss-logevent :
       38     define input  parameter p-extra-paramters as character no-undo .
       39     define variable v-vssrevis-parameters as character no-undo .
       40     do
       41     on error undo, return error return-value
       42     :
       43       if  valid-handle(v-vssrevis-logger)
       44       and v-vssrevis-logger :get-signature("logevent") <> ""
       45       then do:
       46         run vss-get-parameters in this-procedure
       47           (output v-vssrevis-parameters
       48           ).
       49         run logevent in v-vssrevis-logger
       50           (input vss-workfile
       51           ,input vss-revision
       52           ,input v-vssrevis-parameters
       53           ,input p-extra-paramters
       54           ).
       55       end.
       56     end.
       57   end procedure.
       58   assign
       59     v-vssrevis-logger = g#vssrevis-logger
       60   .
       61   if  valid-handle(v-vssrevis-logger)
       62   and v-vssrevis-logger :get-signature("logevent") <> ""
       63   then do:
       64     assign
       65       v-vssrevis-logevent = true
       66     .
       67     run vss-logevent in this-procedure (input vss-description) .
       68   end.
       69   define new global shared variable g#language as character no-undo .
       70   if g#language <> '' and g#language <> 'rus':U then do:
       71     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       72   end.
       73   procedure proc-alt-shift-f2:
       74     if not ibs.th.gbl.gbl-var:rcode
       75   then
       76     run gbl\inidebug.p .
       77   end.
       78   procedure proc-alt-shift-f3:
       79     run gbl/prvssinf.p
       80       ( input this-procedure
       81       ) .
       82   end.
       83   define variable v-inform-launched as logical no-undo initial false .
       84   procedure proc-alt-shift-f4:
       85     define variable v-action as character no-undo .
       86     if v-inform-launched = false then do:
       87       assign
       88         v-inform-launched = true
       89       .
       90       run gbl/d-inform.w
       91         (  input self
       92         ,  input this-procedure
       93         , output v-action
       94         ) no-error .
       95       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       96       assign
       97         v-inform-launched = false
       98       .
       99     end.
      100   end.
      101   procedure proc-alt-f1:
      102     run gbl/corrhelp.p
      103       (input this-procedure
      104       ) .
      105   end .
      106   on alt-shift-f2 anywhere do:
      107     run proc-alt-shift-f2.
      108   end.
      109   on alt-shift-f3 anywhere do:
      110     run proc-alt-shift-f3 in this-procedure .
      111   end.
      112   on alt-shift-f4 anywhere do:
      113     run proc-alt-shift-f4 in this-procedure.
      114   end.
      115   on alt-f1 anywhere do:
      116     run proc-alt-f1 in this-procedure .
      117   end.
      118   DEFINE BUTTON B-exit AUTO-GO
      119        LABEL "&Ввод"
      120        SIZE 10 BY 1
      121        BGCOLOR 8 .
      122   DEFINE BUTTON B-Help
      123        LABEL "Помо&щь"
      124        SIZE 10 BY 1
      125        BGCOLOR 8 .
      126   DEFINE BUTTON b-quit AUTO-END-KEY
      127        LABEL "&Отмена"
      128        SIZE 10 BY 1
      129        BGCOLOR 8 .
      130   DEFINE VARIABLE F-stat-pl AS CHARACTER FORMAT "X(256)":U
      131        VIEW-AS FILL-IN
      132        SIZE 51.75 BY 1
      133        BGCOLOR 15  NO-UNDO.
      134   DEFINE QUERY Dialog-Frame FOR
      135         tt-fin-doc SCROLLING.
      136   DEFINE FRAME Dialog-Frame
      137        B-exit AT ROW 1 COL 1
      138        b-quit AT ROW 1 COL 11
      139        B-Help AT ROW 1 COL 54.88
      140        tt-fin-doc.vid-opl AT ROW 2.25 COL 18 COLON-ALIGNED
      141             LABEL "Вид операции"
      142             VIEW-AS FILL-IN
      143             SIZE 12 BY 1
      144             BGCOLOR 15 FGCOLOR 4
      145        tt-fin-doc.srok-pl AT ROW 2.25 COL 45.63 COLON-ALIGNED
      146             LABEL "Срок платежа"
      147             VIEW-AS FILL-IN
      148             SIZE 12 BY 1
      149             BGCOLOR 15 FGCOLOR 4
      150        tt-fin-doc.nazn-pl AT ROW 3.5 COL 18 COLON-ALIGNED
      151             LABEL "Назн.платежа(код)"
      152             VIEW-AS FILL-IN
      153             SIZE 12 BY 1
      154             BGCOLOR 15 FGCOLOR 4
      155        tt-fin-doc.ocher-pl AT ROW 3.5 COL 45.63 COLON-ALIGNED
      156             LABEL "Очер. платежа"
      157             VIEW-AS COMBO-BOX INNER-LINES 6
      158             LIST-ITEMS "Item 1"
      159             DROP-DOWN-LIST
      160             SIZE 12 BY 1
      161             BGCOLOR 15 FGCOLOR 4
      162        tt-fin-doc.f22 AT ROW 4.75 COL 18 COLON-ALIGNED
      163             LABEL "Код"
      164             VIEW-AS FILL-IN
      165             SIZE 12 BY 1
      166             BGCOLOR 15 FGCOLOR 4
      167        tt-fin-doc.f23 AT ROW 4.75 COL 45.63 COLON-ALIGNED
      168             LABEL "Резервн. поле"
      169             VIEW-AS FILL-IN
      170             SIZE 12 BY 1
      171             BGCOLOR 15 FGCOLOR 4
      172        tt-fin-doc.stat-pl AT ROW 6 COL 21.25 COLON-ALIGNED
      173             LABEL "Статус плательщика"
      174             VIEW-AS COMBO-BOX INNER-LINES 8
      175             LIST-ITEMS "Item 1"
      176             DROP-DOWN-LIST
      177             SIZE 7.63 BY 1
      178             BGCOLOR 15 FGCOLOR 4
      179        F-stat-pl AT ROW 6 COL 31 COLON-ALIGNED NO-LABEL
      180        tt-fin-doc.f104 AT ROW 7.25 COL 5.88 COLON-ALIGNED
      181             LABEL "КБК" FORMAT "X(20)"
      182             VIEW-AS FILL-IN
      183             SIZE 23 BY 1
      184             BGCOLOR 15 FGCOLOR 4
      185        tt-fin-doc.f105 AT ROW 7.25 COL 56.88 COLON-ALIGNED
      186             LABEL "ОКАТО муниц.образования"
      187             VIEW-AS FILL-IN
      188             SIZE 15 BY 1
      189             BGCOLOR 15 FGCOLOR 4
      190        tt-fin-doc.f106 AT ROW 8.5 COL 27 COLON-ALIGNED
      191             LABEL "Показат. основания платежа"
      192             VIEW-AS COMBO-BOX INNER-LINES 11
      193             LIST-ITEMS "Item 1"
      194             DROP-DOWN-LIST
      195             SIZE 6.38 BY 1
      196             BGCOLOR 15 FGCOLOR 4
      197        tt-fin-doc.f107 AT ROW 9.75 COL 27 COLON-ALIGNED
      198             LABEL "Показат. налог. периода"
      199             VIEW-AS FILL-IN
      200             SIZE 12 BY 1
      201             BGCOLOR 15 FGCOLOR 4
      202        tt-fin-doc.f108 AT ROW 11 COL 27 COLON-ALIGNED
      203             LABEL "Показат. № документа"
      204             VIEW-AS FILL-IN
      205             SIZE 12 BY 1
      206             BGCOLOR 15 FGCOLOR 4
      207        tt-fin-doc.f109 AT ROW 12.25 COL 27 COLON-ALIGNED
      208             LABEL "Показат. даты документа"
      209             VIEW-AS FILL-IN
      210             SIZE 12 BY 1
      211             BGCOLOR 15 FGCOLOR 4
      212        tt-fin-doc.f110 AT ROW 13.5 COL 27.13 COLON-ALIGNED
      213             LABEL "Показат. типа платежа"
      214             VIEW-AS COMBO-BOX INNER-LINES 8
      215             LIST-ITEMS "Item 1"
      216             DROP-DOWN-LIST
      217             SIZE 12 BY 1
      218        SPACE(58.11) SKIP(1.34)
      219       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      220            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      221            TITLE "Остальные поля платежа"
      222            DEFAULT-BUTTON B-exit CANCEL-BUTTON b-quit.
      223   ASSIGN
      224          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      225          FRAME Dialog-Frame:HIDDEN           = TRUE.
      226   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      227   DO:
      228     APPLY "END-ERROR":U TO SELF.
      229   END.
      230   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
      231   DO:
      232       run proc-save in this-procedure no-error.
      233     if error-status:error then return no-apply.
      234   END.
      235   ON VALUE-CHANGED OF tt-fin-doc.stat-pl IN FRAME Dialog-Frame
      236   DO:
      237       assign
      238     F-stat-pl = entry (lookup (tt-fin-doc.stat-pl:screen-value, '01,02,03,04,05,06,07,08':U), 'налогоплательщик,налоговый агент,сборщик налогов и сборов,налоговый орган,служба судебных приставов МинЮста Рф,участник внешнеэкономической деятельности,таможенный орган,плательщик иных обязательных платежей':U) no-error .
      239     if error-status:error then do:
      240       assign
      241       f-stat-pl = ?
      242       .
      243     end.
      244     display
      245     f-stat-pl
      246     with frame Dialog-Frame.
      247   END.
      248   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      249   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      250   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      251   on help of frame Dialog-Frame
      252   do:
      253     run gbl/app_help.p
      254       (input this-procedure :file-name
      255       ,input ''
      256       ,input ?
      257       ) no-error.
      258     if error-status :error then do:
      259       message
      260         "Ошибка при вызове помощи"
      261         error-status :get-message(1)
      262         view-as alert-box .
      263     end.
      264   end.
      265   run minbtn-set in this-procedure .
      266   on choose of b-help in frame Dialog-Frame
      267   do:
      268     apply "help":u to frame Dialog-Frame .
      269   end.
      270   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      271   procedure minbtn-set :
      272       do
      273           on error undo, return error return-value
      274           :
      275           define variable ii              as integer       no-undo .
      276           define variable fh              as widget-handle no-undo .
      277           define variable hh              as widget-handle no-undo .
      278           define variable v-h             as handle        extent 4 no-undo .
      279           define variable v-name-button   as character     no-undo .
      280           define variable v-help-old-x    as decimal       no-undo .
      281           define variable v-help-old-y    as decimal       no-undo .
      282           define variable v-help-old-size as decimal       no-undo .
      283           define variable v-frame-width   as decimal       no-undo .
      284           define variable jj              as integer       no-undo .
      285           do
      286               on error undo, return error
      287               :
      288               assign
      289                   v-frame-width = frame Dialog-Frame:width - 0.3
      290                   fh            = frame Dialog-Frame:first-child
      291                   hh            = fh:first-child
      292                   ii            = 1
      293                   .
      294               do while valid-handle(hh):
      295                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      296                   do:
      297                       case lc(hh:name) :
      298                           when "b-help" then
      299                               do:
      300                                   hh:load-image-up("cmp/b-help.bmp":u) .
      301                                   hh:load-image-down("cmp/b-help.bmp":u) .
      302                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      303                                   hh:TOOLTIP = "Помощь" .
      304                                   v-help-old-x = hh:column .
      305                                   v-help-old-y = hh:row    .
      306                                   v-help-old-size = hh:width .
      307                                   hh:width-chars = 2.5 .
      308                               end.
      309                           when "b-print" then
      310                               do:
      311                                   hh:load-image("cmp/b-print.bmp":u) .
      312                                   hh:TOOLTIP = "Печать" .
      313                                   v-h[ii] = hh:handle .
      314                                   ii = ii + 1 .
      315                                   hh:width-chars = 3 .
      316                               end.
      317                           when "b-history" or
      318                           when "b-hist" then
      319                               do:
      320                                   hh:load-image("cmp/b-hist.bmp":u) .
      321                                   hh:TOOLTIP = "История" .
      322                                   v-h[ii] = hh:handle .
      323                                   ii = ii + 1 .
      324                                   hh:width-chars = 3 .
      325                               end.
      326                           when "b-sch" then
      327                               do:
      328                                   hh:load-image("cmp/b-sch.bmp":u) .
      329                                   hh:TOOLTIP = "Установка Фильтра" .
      330                                   v-h[ii] = hh:handle .
      331                                   ii = ii + 1 .
      332                                   hh:width-chars = 3 .
      333                               end.
      334                           when "b-hist-user" then
      335                               do:
      336                                   hh:load-image("cmp/b-hist.bmp":u) .
      337                                   hh:TOOLTIP = "История пользователя" .
      338                                   ii = ii + 1 .
      339                               end.
      340                       end case.
      341                   end.
      342                   hh = hh:next-sibling.
      343               end.
      344               b-help:column = v-frame-width - b-help:width-chars.
      345               jj = 0.
      346               repeat ii = 4 to 1 by -1 :
      347                   if valid-handle (v-h[ii] ) then
      348                   do:
      349                       jj  = jj + 1 .
      350                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      351                       v-h[ii]:row    = v-help-old-y .
      352                   end.
      353               end.
      354           end.
      355       end.
      356   end procedure.
      357   MAIN-BLOCK:
      358   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      359      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      360     RUN Myenable.
      361     WAIT-FOR GO OF FRAME Dialog-Frame.
      362   END.
      363   RUN disable_UI.
      364   PROCEDURE disable_UI :
      365     HIDE FRAME Dialog-Frame.
      366   END PROCEDURE.
      367   PROCEDURE enable_UI :
      368     OPEN QUERY Dialog-Frame FOR EACH tt-fin-doc SHARE-LOCK.
      369     GET FIRST Dialog-Frame.
      370     DISPLAY F-stat-pl
      371         WITH FRAME Dialog-Frame.
      372     IF AVAILABLE tt-fin-doc THEN
      373       DISPLAY tt-fin-doc.vid-opl tt-fin-doc.srok-pl tt-fin-doc.nazn-pl
      374             tt-fin-doc.ocher-pl tt-fin-doc.f22 tt-fin-doc.f23 tt-fin-doc.stat-pl
      375             tt-fin-doc.f104 tt-fin-doc.f105 tt-fin-doc.f106 tt-fin-doc.f107
      376             tt-fin-doc.f108 tt-fin-doc.f109 tt-fin-doc.f110
      377         WITH FRAME Dialog-Frame.
      378     ENABLE B-exit b-quit B-Help tt-fin-doc.ocher-pl tt-fin-doc.stat-pl
      379            tt-fin-doc.f104 tt-fin-doc.f105 tt-fin-doc.f106 tt-fin-doc.f107
      380            tt-fin-doc.f108 tt-fin-doc.f109 tt-fin-doc.f110
      381         WITH FRAME Dialog-Frame.
      382     VIEW FRAME Dialog-Frame.
      383   END PROCEDURE.
      384   PROCEDURE MyEnable :
      385   find first tt-fin-doc.
      386   assign
      387   tt-fin-doc.stat-pl:list-items in frame Dialog-Frame = "":U + chr(44) + '01,02,03,04,05,06,07,08':U
      388   tt-fin-doc.f106:list-items in frame Dialog-Frame = 'ТП,ЗД,ТР,РС,ОТ,РТ,ВУ,ПР,АП,АР,0':U
      389   tt-fin-doc.f110:list-items in frame Dialog-Frame = 'НС,АВ,ПЕ,ПЦ,СА,АШ,ИШ,0':U
      390   tt-fin-doc.ocher-pl:list-items in frame Dialog-Frame = "1,2,3,4,5,6"
      391   .
      392   CASE tt-fin-doc.fin-doc-type:
      393     when 'ппп':U then do:
      394       IF AVAILABLE tt-fin-doc THEN
      395       DISPLAY
      396       tt-fin-doc.vid-opl
      397       tt-fin-doc.srok-pl
      398       tt-fin-doc.nazn-pl
      399       tt-fin-doc.ocher-pl
      400       tt-fin-doc.f22
      401       tt-fin-doc.f23
      402       WITH FRAME Dialog-Frame.
      403       if p-mode <> 'ПРОСМОТР':U then do:
      404         ENABLE
      405         B-exit
      406         B-Help
      407         tt-fin-doc.ocher-pl
      408         WITH FRAME Dialog-Frame.
      409       end.
      410       APPLY "VALUE-CHANGED" to tt-fin-doc.stat-pl.
      411     end.
      412     when 'рпп':U  then do:
      413       DISPLAY
      414       F-stat-pl
      415       WITH FRAME Dialog-Frame.
      416       IF AVAILABLE tt-fin-doc THEN
      417       DISPLAY
      418       tt-fin-doc.vid-opl
      419       tt-fin-doc.srok-pl
      420       tt-fin-doc.nazn-pl
      421       tt-fin-doc.ocher-pl
      422       tt-fin-doc.f22
      423       tt-fin-doc.f23
      424       tt-fin-doc.stat-pl
      425       tt-fin-doc.f104
      426       tt-fin-doc.f105
      427       tt-fin-doc.f106
      428       tt-fin-doc.f107
      429       tt-fin-doc.f108
      430       tt-fin-doc.f109
      431       tt-fin-doc.f110
      432       WITH FRAME Dialog-Frame.
      433       if p-mode <> 'ПРОСМОТР':U then do:
      434         ENABLE
      435         B-exit
      436         B-Help
      437         tt-fin-doc.ocher-pl
      438         tt-fin-doc.stat-pl
      439         tt-fin-doc.f104
      440         tt-fin-doc.f105
      441         tt-fin-doc.f106
      442         tt-fin-doc.f107
      443         tt-fin-doc.f108
      444         tt-fin-doc.f109
      445         tt-fin-doc.f110
      446         WITH FRAME Dialog-Frame.
      447       end.
      448       APPLY "VALUE-CHANGED" to tt-fin-doc.stat-pl.
      449     end.
      450   END CASE.
      451   ENABLE
      452   B-quit
      453   B-Help
      454   WITH FRAME Dialog-Frame.
      455   if p-mode = 'ПРОСМОТР':U then do:
      456     hide b-exit in frame Dialog-Frame.
      457     assign
      458     b-quit:label = "&Выход"
      459     b-quit:column = 1
      460     .
      461   end.
      462   VIEW FRAME Dialog-Frame.
      463   END PROCEDURE.
      464   PROCEDURE proc-save :
      465   CASE tt-fin-doc.fin-doc-type:
      466     when 'ппп':U then do:
      467       assign
      468       tt-fin-doc.vid-opl frame Dialog-Frame
      469       tt-fin-doc.srok-pl
      470       tt-fin-doc.nazn-pl
      471       tt-fin-doc.ocher-pl
      472       tt-fin-doc.f22
      473       tt-fin-doc.f23
      474       .
      475     end.
      476     when 'рпп':U then do:
      477       assign
      478       tt-fin-doc.vid-opl frame Dialog-Frame
      479       tt-fin-doc.srok-pl
      480       tt-fin-doc.nazn-pl
      481       tt-fin-doc.ocher-pl
      482       tt-fin-doc.f22
      483       tt-fin-doc.f23
      484       tt-fin-doc.stat-pl
      485       tt-fin-doc.f104
      486       tt-fin-doc.f105
      487       tt-fin-doc.f106
      488       tt-fin-doc.f107
      489       tt-fin-doc.f108
      490       tt-fin-doc.f109
      491       tt-fin-doc.f110
      492       .
      493     end.
      494   END CASE.
      495   END PROCEDURE.
