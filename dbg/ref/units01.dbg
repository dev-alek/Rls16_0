        1   block-level on error undo, throw.
        2   define input-output parameter p-rec as recid no-undo.
        3   define input parameter        p-mode             as character no-undo .
        4   define input parameter        p-OKEI           like ub.units.OKEI no-undo .
        5   define input parameter        p-long-name      like ub.units.long-name no-undo .
        6   define input parameter        p-type           like ub.units.type no-undo .
        7   define input parameter        p-unit-name      like ub.units.unit-name  no-undo .
        8   define variable vss-revision    as character no-undo init "$Revision: ce1e41b5e8d1, 1173, rls $":U .
        9   define variable vss-author      as character no-undo init "$Author: EShklyar $":U .
       10   define variable vss-date        as character no-undo init "$Date: Thu Dec 14 02:20:27 2017 +0300 $":U .
       11   define variable vss-workfile    as character no-undo init "$Workfile: units01.p $":U .
       12   define variable vss-archive     as character no-undo init "$Archive: ref/units01.p $":U .
       13   define variable vss-description as character no-undo init "Сохранение изменений в карточке единицы измерени".
       14   procedure vss-get-info :
       15     define output parameter p-vss-revision    like vss-revision    no-undo .
       16     define output parameter p-vss-author      like vss-author      no-undo .
       17     define output parameter p-vss-date        like vss-date        no-undo .
       18     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       19     define output parameter p-vss-archive     like vss-archive     no-undo .
       20     define output parameter p-vss-description like vss-description no-undo .
       21     assign
       22       p-vss-revision    = vss-revision
       23       p-vss-author      = vss-author
       24       p-vss-date        = vss-date
       25       p-vss-workfile    = vss-workfile
       26       p-vss-archive     = vss-archive
       27       p-vss-description = vss-description
       28     .
       29   end procedure.
       30   procedure vss-get-parameters :
       31     define output parameter p-vss-parameters as character no-undo .
       32   end procedure.
       33   define new global shared variable g#vssrevis-logger as handle    no-undo .
       34   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       35   define variable v-vssrevis-logger                   as handle    no-undo .
       36   procedure vss-logevent :
       37     define input  parameter p-extra-paramters as character no-undo .
       38     define variable v-vssrevis-parameters as character no-undo .
       39     do
       40     on error undo, return error return-value
       41     :
       42       if  valid-handle(v-vssrevis-logger)
       43       and v-vssrevis-logger :get-signature("logevent") <> ""
       44       then do:
       45         run vss-get-parameters in this-procedure
       46           (output v-vssrevis-parameters
       47           ).
       48         run logevent in v-vssrevis-logger
       49           (input vss-workfile
       50           ,input vss-revision
       51           ,input v-vssrevis-parameters
       52           ,input p-extra-paramters
       53           ).
       54       end.
       55     end.
       56   end procedure.
       57   assign
       58     v-vssrevis-logger = g#vssrevis-logger
       59   .
       60   if  valid-handle(v-vssrevis-logger)
       61   and v-vssrevis-logger :get-signature("logevent") <> ""
       62   then do:
       63     assign
       64       v-vssrevis-logevent = true
       65     .
       66     run vss-logevent in this-procedure (input vss-description) .
       67   end.
       68   define new global shared variable g#language as character no-undo .
       69   if g#language <> '' and g#language <> 'rus':U then do:
       70     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       71   end.
       72   define new global shared variable g#library  as handle no-undo .
       73   define new global shared variable g#library2 as handle no-undo .
       74   define   shared variable g#auto as logical no-undo.
       75   define   shared variable g#news as logical no-undo.
       76   define   shared variable g#oxml as logical no-undo.
       77   define   shared variable g#esys as logical no-undo.
       78   define   shared variable g#news-source-db as integer no-undo.
       79   define   shared variable g#esys-source-esys as integer no-undo.
       80   define   shared variable g#db-num as integer   no-undo .
       81   define   shared variable g#userid as character no-undo .
       82   define   shared variable g#passwd as character no-undo .
       83   define variable v-db-num like ub.db.db-num no-undo .
       84   define variable v-log         as logical   no-undo .
       85   define buffer buf_units for ub.units.
       86   define variable v-value as character no-undo.
       87   define variable v-ttype as character no-undo.
       88   if p-mode <> 'ДОБАВЛЕНИЕ':U
       89   AND p-mode <> 'ИЗМЕНЕНИЕ':U then do:
       90     message
       91     vss-workfile vss-revision vss-description skip
       92     "Неверный параметр p-mode" p-mode
       93     view-as alert-box error .
       94     return error '':u.
       95   end.
       96   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       97   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
       98     (output v-db-num
       99     )  .
      100   run gbl/conf-rd.p ("is-erpRN", "", "", 0, "", "", "", no, output v-value, output v-ttype) no-error.
      101   if v-value = "no"  then do:
      102   if v-db-num <> 0
      103   then do:
      104     run err-mess (substitute("Нельзя изменять запись ЕД.ИЗМ в УБД: Номер текущей БД &1 ", v-db-num ) ).
      105     undo, return error "":U.
      106   end.
      107   end.
      108   if p-long-name = "":U then do:
      109     run err-mess ("Укажите полное наименование ед.изм").
      110     undo, return error "long-name":U.
      111   end.
      112   if p-unit-name = "":U or p-unit-name = ? then do:
      113     run err-mess ("Укажите аббревиатуру ед.изм").
      114     undo, return error "unit-name":U.
      115   end.
      116   if
      117   can-find(first buf_units no-lock where
      118                     buf_units.unit-name = p-unit-name
      119                 AND (p-mode = 'ДОБАВЛЕНИЕ':U OR p-rec <> recid(buf_units))
      120                 ) then do:
      121     run err-mess (substitute("Уже есть такая ЕД.ИЗМ &1", p-unit-name) ).
      122     return error "unit-name":U.
      123   end.
      124   if LOOKUP(entry(1, p-type),  'шту,дро,сер,вес,топ,сте':U) = 0 then do:
      125     run err-mess (substitute("Неверный тип единицы измерения &1: &2", p-unit-name, entry(1, p-type)) ).
      126     return error "type":U.
      127   end.
      128   if num-entries(p-type) > 1 then do:
      129     if LOOKUP(entry(2, p-type),  'шту':U + chr(44) + 'дро':U + chr(44) + '2ед':U + chr(44) + 'доп':U) = 0  then do:
      130       run err-mess (substitute("Неверный тип2 единицы измерения &1: &2", p-unit-name, entry(2, p-type)) ).
      131       return error "type":U.
      132     end.
      133   end.
      134   if p-OKEI <> 0
      135   and
      136   can-find(first buf_units no-lock where
      137                     buf_units.OKEI = p-OKEI
      138                 AND (p-mode = 'ДОБАВЛЕНИЕ':U OR p-rec <> recid(buf_units))
      139                 ) then do:
      140                   if v-value = "no" then do:
      141       message substitute("Уже есть  ЕД.ИЗМ &1 c таким же кодом ОКЕИ &2", p-unit-name, p-okei) skip "Добавить?" view-as alert-box information buttons YES-NO update v-log.
      142       if v-log = no then do:
      143         return error "okei":U.
      144       end.
      145       end.
      146       else do:
      147         run err-mess (substitute("Уже есть  ЕД.ИЗМ &1 c таким же кодом ОКЕИ &2", p-unit-name, p-okei) ).
      148       end.
      149   end.
      150   _MAIN:
      151   DO ON ERROR UNDO, RETURN ERROR
      152   ON STOP UNDO, RETURN ERROR:
      153     if p-mode = 'ДОБАВЛЕНИЕ':U then do:
      154       create ub.units.
      155       assign
      156       ub.units.unit-name = p-unit-name
      157       p-rec = recid(ub.units)
      158       .
      159     end.
      160     else do:
      161       FIND FIRST ub.units where
      162                 recid(ub.units) = p-rec No-ERROR.
      163       if not available ub.units then do:
      164         message
      165         vss-workfile vss-revision vss-description skip
      166         "Не найдена запись ед.изм - p-rec" p-rec
      167         view-as alert-box error .
      168         undo, return error '':u.
      169       end.
      170       if ub.units.unit-name <> p-unit-name
      171       then do:
      172         message
      173         vss-workfile vss-revision vss-description skip
      174         "Для уже имеющейся ЕД.ИЗМ. нельзя изменить аббревиатуру" skip
      175         view-as alert-box ERROR.
      176         undo, return error '':U.
      177       end.
      178     end.
      179     assign
      180     ub.units.unit-name = p-unit-name
      181     ub.units.long-name  = p-long-name
      182     ub.units.type       = p-type
      183     ub.units.OKEI       = p-OKEI
      184     ub.units.stts    =  (if p-mode = 'ДОБАВЛЕНИЕ':U
      185                                then 0
      186                                else ub.units.stts)
      187     .
      188     release ub.units no-error.
      189     if error-status:error then do:
      190        run err-mess(substitute("Ошибка при сохранении записи ЕД.ИЗМ &1: &2: &3", p-unit-name, return-value, ERROR-STATUS:GET-message(1))).
      191       undo, return error "":U.
      192    end.
      193   end.
      194   PROCEDURE err-mess:
      195     DEFINE INPUT PARAMETER p-mess as character No-UNDO.
      196     if v-value = "yes" then do:
      197       p-mess .
      198     end.
      199     else do:
      200         message
      201         p-mess
      202         view-as alert-box error .
      203     end.
      204   END PROCEDURE.
