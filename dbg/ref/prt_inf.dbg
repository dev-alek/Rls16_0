        1   DEFINE TEMP-TABLE TT-prt-obj NO-UNDO LIKE prt-obj.
        2   CREATE WIDGET-POOL.
        3   define parameter buffer bf-goods for ub.goods .
        4   define input parameter parnode-code like ub.gds-prt.node-code no-undo.
        5   define input parameter parobj-type  like ub.clients.obj-type  no-undo.
        6   define input parameter parobj-code  like ub.clients.obj-code  no-undo.
        7   def var vss-revision    as character no-undo init "$Revision$":U .
        8   def var vss-author      as character no-undo init "$Author$":U .
        9   def var vss-date        as character no-undo init "$Date$":U .
       10   def var vss-workfile    as character no-undo init "$Workfile$":U .
       11   def var vss-archive     as character no-undo init "$Archive$":U .
       12   def var vss-description as character no-undo init "Просмотр архива по признаку".
       13   procedure vss-get-info :
       14     define output parameter p-vss-revision    like vss-revision    no-undo .
       15     define output parameter p-vss-author      like vss-author      no-undo .
       16     define output parameter p-vss-date        like vss-date        no-undo .
       17     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       18     define output parameter p-vss-archive     like vss-archive     no-undo .
       19     define output parameter p-vss-description like vss-description no-undo .
       20     assign
       21       p-vss-revision    = vss-revision
       22       p-vss-author      = vss-author
       23       p-vss-date        = vss-date
       24       p-vss-workfile    = vss-workfile
       25       p-vss-archive     = vss-archive
       26       p-vss-description = vss-description
       27     .
       28   end procedure.
       29   procedure vss-get-parameters :
       30     define output parameter p-vss-parameters as character no-undo .
       31   end procedure.
       32   define new global shared variable g#vssrevis-logger as handle    no-undo .
       33   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       34   define variable v-vssrevis-logger                   as handle    no-undo .
       35   procedure vss-logevent :
       36     define input  parameter p-extra-paramters as character no-undo .
       37     define variable v-vssrevis-parameters as character no-undo .
       38     do
       39     on error undo, return error return-value
       40     :
       41       if  valid-handle(v-vssrevis-logger)
       42       and v-vssrevis-logger :get-signature("logevent") <> ""
       43       then do:
       44         run vss-get-parameters in this-procedure
       45           (output v-vssrevis-parameters
       46           ).
       47         run logevent in v-vssrevis-logger
       48           (input vss-workfile
       49           ,input vss-revision
       50           ,input v-vssrevis-parameters
       51           ,input p-extra-paramters
       52           ).
       53       end.
       54     end.
       55   end procedure.
       56   assign
       57     v-vssrevis-logger = g#vssrevis-logger
       58   .
       59   if  valid-handle(v-vssrevis-logger)
       60   and v-vssrevis-logger :get-signature("logevent") <> ""
       61   then do:
       62     assign
       63       v-vssrevis-logevent = true
       64     .
       65     run vss-logevent in this-procedure (input vss-description) .
       66   end.
       67   procedure proc-alt-shift-f2:
       68     if not ibs.th.gbl.gbl-var:rcode
       69   then
       70     run gbl\inidebug.p .
       71   end.
       72   procedure proc-alt-shift-f3:
       73     run gbl/prvssinf.p
       74       ( input this-procedure
       75       ) .
       76   end.
       77   define variable v-inform-launched as logical no-undo initial false .
       78   procedure proc-alt-shift-f4:
       79     define variable v-action as character no-undo .
       80     if v-inform-launched = false then do:
       81       assign
       82         v-inform-launched = true
       83       .
       84       run gbl/d-inform.w
       85         (  input self
       86         ,  input this-procedure
       87         , output v-action
       88         ) no-error .
       89       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       90       assign
       91         v-inform-launched = false
       92       .
       93     end.
       94   end.
       95   procedure proc-alt-f1:
       96     run gbl/corrhelp.p
       97       (input this-procedure
       98       ) .
       99   end .
      100   on alt-shift-f2 anywhere do:
      101     run proc-alt-shift-f2.
      102   end.
      103   on alt-shift-f3 anywhere do:
      104     run proc-alt-shift-f3 in this-procedure .
      105   end.
      106   on alt-shift-f4 anywhere do:
      107     run proc-alt-shift-f4 in this-procedure.
      108   end.
      109   on alt-f1 anywhere do:
      110     run proc-alt-f1 in this-procedure .
      111   end.
      112   DEFINE BUTTON b-exit AUTO-END-KEY
      113        LABEL "Выход"
      114        SIZE 10 BY 1
      115        BGCOLOR 8 .
      116   DEFINE BUTTON b-help
      117        LABEL "Помощь"
      118        SIZE 10 BY 1
      119        BGCOLOR 8 .
      120   DEFINE QUERY D-Dialog FOR
      121         TT-prt-obj SCROLLING.
      122   DEFINE FRAME D-Dialog
      123        b-exit AT ROW 1.21 COL 2
      124        b-help AT ROW 1.21 COL 14
      125        TT-prt-obj.fact-qnty AT ROW 2.54 COL 24.5 COLON-ALIGNED NO-LABEL
      126             VIEW-AS FILL-IN
      127             SIZE 16 BY 1
      128        TT-prt-obj.free-qnty AT ROW 3.83 COL 24.5 COLON-ALIGNED NO-LABEL
      129             VIEW-AS FILL-IN
      130             SIZE 16 BY 1
      131        TT-prt-obj.price-sale AT ROW 5.13 COL 24.5 COLON-ALIGNED NO-LABEL
      132             VIEW-AS FILL-IN
      133             SIZE 16 BY 1
      134        "Продажная цена" VIEW-AS TEXT
      135             SIZE 22.88 BY .67 AT ROW 5.25 COL 2
      136        "Фактическое количество" VIEW-AS TEXT
      137             SIZE 23.13 BY .67 AT ROW 2.67 COL 1.75
      138        "Свободное количество" VIEW-AS TEXT
      139             SIZE 22.88 BY .67 AT ROW 4 COL 2
      140        SPACE(18.49) SKIP(1.74)
      141       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      142            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      143            TITLE "Товар"
      144            CANCEL-BUTTON b-exit.
      145   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
      146   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
      147   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
      148   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
      149   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
      150   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
      151   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
      152   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
      153       ASSIGN adm-object-hdl = FRAME D-Dialog:HANDLE.
      154   RUN ensure-broker.
      155   THIS-PROCEDURE:ADM-DATA =
      156        'ADM1.1~`':U +
      157        'SmartDialog~`':U +
      158        'DIALOG-BOX~`':U +
      159        'NO ~`':U +
      160        '~`':U +
      161        'TT-prt-obj~`':U +
      162        '~`':U +
      163        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
      164           + "~`":U +
      165        'Layout,Hide-on-Init~`':U +
      166        '~`':U +
      167        '~`':U +
      168        '~`~`~`~`~`~`~`~`~`~`~`':U +
      169        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
      170            THEN "^^":U
      171        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
      172             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
      173   PROCEDURE adm-apply-entry :
      174     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      175   END PROCEDURE.
      176   PROCEDURE adm-destroy :
      177    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      178   END PROCEDURE.
      179   PROCEDURE adm-disable :
      180       DISABLE b-exit b-help WITH FRAME D-Dialog.
      181       RUN dispatch ('disable-fields':U).
      182       RUN set-attribute-list ('ENABLED=no':U).
      183       RETURN.
      184   END PROCEDURE.
      185   PROCEDURE adm-edit-attribute-list :
      186         RUN adm/support/contnrd.w (INPUT THIS-PROCEDURE).
      187         RETURN.
      188   END PROCEDURE.
      189   PROCEDURE adm-enable :
      190       ENABLE UNLESS-HIDDEN b-exit b-help WITH FRAME D-Dialog.
      191       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
      192       RUN set-attribute-list ('ENABLED=yes':U).
      193       RETURN.
      194   END PROCEDURE.
      195   PROCEDURE adm-exit :
      196        RUN notify ('exit':U).
      197     RETURN.
      198   END PROCEDURE.
      199   PROCEDURE adm-hide :
      200     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      201   END PROCEDURE.
      202   PROCEDURE adm-initialize :
      203     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      204   END PROCEDURE.
      205   PROCEDURE adm-show-errors :
      206       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
      207       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
      208           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
      209       END.
      210       RETURN.
      211   END PROCEDURE.
      212   PROCEDURE adm-UIB-mode :
      213     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      214   END PROCEDURE.
      215   PROCEDURE adm-view :
      216     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      217   END PROCEDURE.
      218   PROCEDURE dispatch :
      219       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
      220       RUN broker-dispatch IN adm-broker-hdl
      221           (THIS-PROCEDURE, p-method-name) NO-ERROR.
      222       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
      223   END PROCEDURE.
      224   PROCEDURE ensure-broker :
      225   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
      226   IF RETURN-VALUE NE "ADM-Broker":U THEN
      227   DO:
      228       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
      229       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
      230   END.
      231   END PROCEDURE.
      232   PROCEDURE get-attribute :
      233     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
      234     RUN broker-get-attribute IN adm-broker-hdl
      235         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
      236     RETURN RETURN-VALUE.
      237   END PROCEDURE.
      238   PROCEDURE get-attribute-list :
      239     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
      240     RUN broker-get-attribute-list IN adm-broker-hdl
      241         (INPUT THIS-PROCEDURE,
      242          INPUT ?,
      243          OUTPUT p-attr-list) NO-ERROR.
      244     RETURN.
      245   END PROCEDURE.
      246   PROCEDURE new-state :
      247     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
      248     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
      249     RETURN.
      250   END PROCEDURE.
      251   PROCEDURE notify :
      252     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
      253     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
      254     IF RETURN-VALUE = "ADM-ERROR":U THEN
      255         RETURN "ADM-ERROR":U.
      256     RETURN.
      257   END PROCEDURE.
      258   PROCEDURE set-attribute-list :
      259     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
      260     RUN ensure-broker.
      261     RUN broker-set-attribute-list IN adm-broker-hdl
      262         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
      263     RETURN.
      264   END PROCEDURE.
      265   PROCEDURE set-position :
      266       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
      267       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
      268       IF VALID-HANDLE(adm-object-hdl) THEN
      269       DO:
      270           DEFINE VARIABLE parent-hdl AS HANDLE NO-UNDO.
      271           IF adm-object-hdl:TYPE = "WINDOW":U THEN
      272           DO:
      273             IF p-row = 0 THEN p-row =
      274               (SESSION:HEIGHT-CHARS - adm-object-hdl:HEIGHT-CHARS) / 2.
      275             IF p-col = 0 THEN p-col =
      276               (SESSION:WIDTH-CHARS - adm-object-hdl:WIDTH-CHARS) / 2.
      277           END.
      278           ELSE IF adm-object-hdl:TYPE = "DIALOG-BOX":U THEN
      279           DO:
      280             parent-hdl = adm-object-hdl:PARENT.
      281             IF p-row = 0 THEN p-row =
      282               ((SESSION:HEIGHT-CHARS - adm-object-hdl:HEIGHT-CHARS) / 2) -
      283                 parent-hdl:ROW.
      284             IF p-col = 0 THEN p-col =
      285               ((SESSION:WIDTH-CHARS - adm-object-hdl:WIDTH-CHARS) / 2) -
      286                 parent-hdl:COL.
      287           END.
      288           IF p-row GE 0 AND p-row < 1 THEN p-row = 1.
      289           IF p-col GE 0 AND p-col < 1 THEN p-col = 1.
      290         ASSIGN adm-object-hdl:ROW    =   p-row
      291                adm-object-hdl:COLUMN =   p-col.
      292       END.
      293       RETURN.
      294   END PROCEDURE.
      295   RUN set-attribute-list ("CURRENT-PAGE=0,ADM-OBJECT-HANDLE=":U +
      296       STRING(adm-object-hdl)).
      297   PAUSE 0 BEFORE-HIDE.
      298   PROCEDURE adm-change-page :
      299     RUN broker-change-page IN adm-broker-hdl (INPUT THIS-PROCEDURE) NO-ERROR.
      300     END PROCEDURE.
      301   PROCEDURE delete-page :
      302     DEFINE INPUT PARAMETER p-page# AS INTEGER NO-UNDO.
      303     RUN broker-delete-page IN adm-broker-hdl
      304         (INPUT THIS-PROCEDURE, INPUT p-page#).
      305     END PROCEDURE.
      306   PROCEDURE init-object :
      307     DEFINE INPUT PARAMETER  p-proc-name   AS CHARACTER NO-UNDO.
      308     DEFINE INPUT PARAMETER  p-parent-hdl  AS HANDLE    NO-UNDO.
      309     DEFINE INPUT PARAMETER  p-attr-list   AS CHARACTER NO-UNDO.
      310     DEFINE OUTPUT PARAMETER p-proc-hdl    AS HANDLE    NO-UNDO.
      311     RUN broker-init-object IN adm-broker-hdl
      312         (INPUT THIS-PROCEDURE, INPUT p-proc-name, INPUT p-parent-hdl,
      313          INPUT p-attr-list, OUTPUT p-proc-hdl) NO-ERROR.
      314     RETURN.
      315   END PROCEDURE.
      316   PROCEDURE init-pages :
      317     DEFINE INPUT PARAMETER p-page-list      AS CHARACTER NO-UNDO.
      318     RUN broker-init-pages IN adm-broker-hdl (INPUT THIS-PROCEDURE,
      319         INPUT p-page-list) NO-ERROR.
      320     END PROCEDURE.
      321   PROCEDURE select-page :
      322     DEFINE INPUT PARAMETER p-page#     AS INTEGER   NO-UNDO.
      323     RUN broker-select-page IN adm-broker-hdl (INPUT THIS-PROCEDURE,
      324         INPUT p-page#) NO-ERROR.
      325     END PROCEDURE.
      326   PROCEDURE view-page :
      327     DEFINE INPUT PARAMETER p-page#      AS INTEGER   NO-UNDO.
      328     RUN broker-view-page IN adm-broker-hdl (INPUT THIS-PROCEDURE,
      329         INPUT p-page#).
      330     END PROCEDURE.
      331   ASSIGN
      332          FRAME D-Dialog:SCROLLABLE       = FALSE
      333          FRAME D-Dialog:HIDDEN           = TRUE.
      334   ON WINDOW-CLOSE OF FRAME D-Dialog
      335   DO:
      336     APPLY "END-ERROR":U TO SELF.
      337   END.
      338   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      339   on help of frame D-Dialog
      340   do:
      341     run gbl/app_help.p
      342       (input this-procedure :file-name
      343       ,input ''
      344       ,input ?
      345       ) no-error.
      346     if error-status :error then do:
      347       message
      348         "Ошибка при вызове помощи"
      349         error-status :get-message(1)
      350         view-as alert-box .
      351     end.
      352   end.
      353   run minbtn-set in this-procedure .
      354   on choose of b-help in frame D-Dialog
      355   do:
      356     apply "help":u to frame D-Dialog .
      357   end.
      358   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      359   procedure minbtn-set :
      360       do
      361           on error undo, return error return-value
      362           :
      363           define variable ii              as integer       no-undo .
      364           define variable fh              as widget-handle no-undo .
      365           define variable hh              as widget-handle no-undo .
      366           define variable v-h             as handle        extent 4 no-undo .
      367           define variable v-name-button   as character     no-undo .
      368           define variable v-help-old-x    as decimal       no-undo .
      369           define variable v-help-old-y    as decimal       no-undo .
      370           define variable v-help-old-size as decimal       no-undo .
      371           define variable v-frame-width   as decimal       no-undo .
      372           define variable jj              as integer       no-undo .
      373           do
      374               on error undo, return error
      375               :
      376               assign
      377                   v-frame-width = frame D-Dialog:width - 0.3
      378                   fh            = frame D-Dialog:first-child
      379                   hh            = fh:first-child
      380                   ii            = 1
      381                   .
      382               do while valid-handle(hh):
      383                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      384                   do:
      385                       case lc(hh:name) :
      386                           when "b-help" then
      387                               do:
      388                                   hh:load-image-up("cmp/b-help.bmp":u) .
      389                                   hh:load-image-down("cmp/b-help.bmp":u) .
      390                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      391                                   hh:TOOLTIP = "Помощь" .
      392                                   v-help-old-x = hh:column .
      393                                   v-help-old-y = hh:row    .
      394                                   v-help-old-size = hh:width .
      395                                   hh:width-chars = 2.5 .
      396                               end.
      397                           when "b-print" then
      398                               do:
      399                                   hh:load-image("cmp/b-print.bmp":u) .
      400                                   hh:TOOLTIP = "Печать" .
      401                                   v-h[ii] = hh:handle .
      402                                   ii = ii + 1 .
      403                                   hh:width-chars = 3 .
      404                               end.
      405                           when "b-history" or
      406                           when "b-hist" then
      407                               do:
      408                                   hh:load-image("cmp/b-hist.bmp":u) .
      409                                   hh:TOOLTIP = "История" .
      410                                   v-h[ii] = hh:handle .
      411                                   ii = ii + 1 .
      412                                   hh:width-chars = 3 .
      413                               end.
      414                           when "b-sch" then
      415                               do:
      416                                   hh:load-image("cmp/b-sch.bmp":u) .
      417                                   hh:TOOLTIP = "Установка Фильтра" .
      418                                   v-h[ii] = hh:handle .
      419                                   ii = ii + 1 .
      420                                   hh:width-chars = 3 .
      421                               end.
      422                           when "b-hist-user" then
      423                               do:
      424                                   hh:load-image("cmp/b-hist.bmp":u) .
      425                                   hh:TOOLTIP = "История пользователя" .
      426                                   ii = ii + 1 .
      427                               end.
      428                       end case.
      429                   end.
      430                   hh = hh:next-sibling.
      431               end.
      432               b-help:column = v-frame-width - b-help:width-chars.
      433               jj = 0.
      434               repeat ii = 4 to 1 by -1 :
      435                   if valid-handle (v-h[ii] ) then
      436                   do:
      437                       jj  = jj + 1 .
      438                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      439                       v-h[ii]:row    = v-help-old-y .
      440                   end.
      441               end.
      442           end.
      443       end.
      444   end procedure.
      445   find first ub.gds-prt where ub.gds-prt.node-code = parnode-code no-lock.
      446   ASSIGN frame D-Dialog:TITLE = "Товар " + bf-goods.gds-name + ". Признак: " + ub.gds-prt.node-name + ".".
      447   find first ub.prt-obj where ub.prt-obj.obj-type  = parobj-type        and
      448                               ub.prt-obj.obj-code  = parobj-code        and
      449                               ub.prt-obj.prod-type = bf-goods.prod-type and
      450                               ub.prt-obj.prod-code = bf-goods.prod-code and
      451                               ub.prt-obj.artic     = bf-goods.artic     and
      452                               ub.prt-obj.prt-code  = parnode-code       no-lock no-error.
      453   if available ub.prt-obj then do:
      454     for each tt-prt-obj:
      455       delete tt-prt-obj.
      456     end.
      457     create tt-prt-obj.
      458     buffer-copy ub.prt-obj to tt-prt-obj.
      459   end.
      460   else do:
      461     message "Нет информации по признаку на объекте." view-as alert-box.
      462     return error.
      463   end.
      464   IF THIS-PROCEDURE:PERSISTENT THEN DO:
      465       MESSAGE "A SmartDialog is not intended ":U SKIP
      466               "to be run Persistent or to be placed ":U SKIP
      467               "in another SmartObject at UIB design time.":U
      468               VIEW-AS ALERT-BOX ERROR.
      469       RUN disable_UI.
      470       DELETE PROCEDURE THIS-PROCEDURE.
      471       RETURN.
      472   END.
      473   RUN dispatch ('create-objects':U).
      474   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME D-Dialog:PARENT eq ?
      475   THEN FRAME D-Dialog:PARENT = ACTIVE-WINDOW.
      476   MAIN-BLOCK:
      477   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      478      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      479     RUN dispatch IN THIS-PROCEDURE ('initialize':U).
      480     WAIT-FOR GO OF FRAME D-Dialog.
      481   END.
      482   RUN dispatch IN THIS-PROCEDURE ('destroy':U).
      483   PROCEDURE adm-create-objects :
      484   END PROCEDURE.
      485   PROCEDURE adm-row-available :
      486     DEFINE VARIABLE tbl-list           AS CHARACTER INIT "":U NO-UNDO.
      487     DEFINE VARIABLE rowid-list         AS CHARACTER NO-UNDO.
      488     DEFINE VARIABLE row-avail-cntr     AS INTEGER INIT 0 NO-UNDO.
      489     DEFINE VARIABLE row-avail-rowid    AS ROWID NO-UNDO.
      490     DEFINE VARIABLE row-avail-enabled  AS LOGICAL NO-UNDO.
      491     DEFINE VARIABLE link-handle        AS CHARACTER NO-UNDO.
      492     DEFINE VARIABLE record-source-hdl  AS HANDLE NO-UNDO.
      493     DEFINE VARIABLE different-row      AS LOGICAL NO-UNDO INIT no.
      494     DEFINE VARIABLE key-name           AS CHARACTER INIT ? NO-UNDO.
      495     DEFINE VARIABLE key-value          AS CHARACTER INIT ? NO-UNDO.
      496     RUN check-modified IN THIS-PROCEDURE ('check':U) NO-ERROR.
      497     IF adm-updating-record THEN RETURN.
      498     RUN get-attribute ('FIELDS-ENABLED':U).
      499     row-avail-enabled = IF RETURN-VALUE = "YES":U THEN yes ELSE no.
      500     RUN get-link-handle IN adm-broker-hdl (THIS-PROCEDURE, 'RECORD-SOURCE':U,
      501         OUTPUT link-handle) NO-ERROR.
      502     IF link-handle = "":U THEN
      503         RETURN.
      504     ASSIGN record-source-hdl = WIDGET-HANDLE(ENTRY(1,link-handle)).
      505     IF NUM-ENTRIES(link-handle) > 1 THEN
      506         MESSAGE "row-available in ":U THIS-PROCEDURE:FILE-NAME
      507             "encountered more than one RECORD-SOURCE.":U SKIP
      508             "The first - ":U record-source-hdl:file-name " - will be used.":U
      509                VIEW-AS ALERT-BOX ERROR.
      510     RUN get-attribute ('Key-Name':U).
      511     key-name = RETURN-VALUE.
      512     IF key-name = "":U THEN key-name = ?.
      513     IF key-name NE ? THEN DO:
      514       RUN send-key IN record-source-hdl (INPUT key-name, OUTPUT key-value)
      515         NO-ERROR.
      516       IF key-value NE ? THEN
      517         RUN set-attribute-list (SUBSTITUTE ('Key-Value="&1"':U, key-value)).
      518     END.
      519   IF VALID-HANDLE (adm-object-hdl) THEN
      520       RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
      521   RUN notify IN THIS-PROCEDURE ('row-available':U).
      522   END PROCEDURE.
      523   PROCEDURE disable_UI :
      524     HIDE FRAME D-Dialog.
      525   END PROCEDURE.
      526   PROCEDURE enable_UI :
      527     IF AVAILABLE TT-prt-obj THEN
      528       DISPLAY TT-prt-obj.fact-qnty TT-prt-obj.free-qnty TT-prt-obj.price-sale
      529         WITH FRAME D-Dialog.
      530     ENABLE b-exit b-help
      531         WITH FRAME D-Dialog.
      532     VIEW FRAME D-Dialog.
      533   END PROCEDURE.
      534   PROCEDURE send-records :
      535     DEFINE INPUT PARAMETER p-tbl-list AS CHARACTER NO-UNDO.
      536     DEFINE OUTPUT PARAMETER p-rowid-list AS CHARACTER NO-UNDO.
      537     DEFINE VARIABLE i            AS INTEGER   NO-UNDO.
      538     DEFINE VARIABLE link-handle  AS CHARACTER NO-UNDO.
      539     DEFINE VARIABLE rowid-string AS CHARACTER NO-UNDO.
      540     DO i = 1 TO NUM-ENTRIES(p-tbl-list):
      541         IF i > 1 THEN p-rowid-list = p-rowid-list + ",":U.
      542         CASE ENTRY(i, p-tbl-list):
      543       WHEN "TT-prt-obj":U THEN p-rowid-list = p-rowid-list +
      544           IF AVAILABLE TT-prt-obj THEN STRING(ROWID(TT-prt-obj))
      545           ELSE "?":U.
      546           OTHERWISE
      547           DO:
      548               RUN get-link-handle IN adm-broker-hdl (INPUT THIS-PROCEDURE,
      549                   INPUT "RECORD-SOURCE":U, OUTPUT link-handle) NO-ERROR.
      550               IF link-handle NE "":U THEN
      551               DO:
      552                   IF NUM-ENTRIES(link-handle) > 1 THEN
      553                       MESSAGE "send-records in ":U THIS-PROCEDURE:FILE-NAME
      554                               "encountered more than one RECORD-SOURCE.":U SKIP
      555                               "The first will be used.":U
      556                               VIEW-AS ALERT-BOX ERROR.
      557                   RUN send-records IN WIDGET-HANDLE(ENTRY(1,link-handle))
      558                       (INPUT ENTRY(i, p-tbl-list), OUTPUT rowid-string).
      559                   p-rowid-list = p-rowid-list + rowid-string.
      560               END.
      561               ELSE
      562               DO:
      563                   MESSAGE "Requested table":U ENTRY(i, p-tbl-list)
      564                           "does not match tables in send-records":U
      565                           "in procedure":U THIS-PROCEDURE:FILE-NAME ".":U SKIP
      566                           "Check that objects are linked properly and that":U
      567                           "database qualification is consistent.":U
      568                       VIEW-AS ALERT-BOX ERROR.
      569                   RETURN ERROR.
      570               END.
      571           END.
      572           END CASE.
      573       END.
      574   END PROCEDURE.
      575   PROCEDURE state-changed :
      576     DEFINE INPUT PARAMETER p-issuer-hdl AS HANDLE NO-UNDO.
      577     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
      578   END PROCEDURE.
