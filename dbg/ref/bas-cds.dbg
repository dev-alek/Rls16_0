      130     define variable v-cntxt-obj-type      as character no-undo .
      131     define variable v-cntxt-obj-code      as integer   no-undo .
      132     define variable v-cntxt-db-num-obj    as integer   no-undo .
      133     define variable v-cntxt-is-admin      as logical   no-undo .
      134   define variable  mark as character  no-undo.
