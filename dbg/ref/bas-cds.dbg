     1142         for each buf_temp-browse-handle
     1143           where buf_temp-browse-handle.browse-type = 'width':u
     1144         on error undo move_block, retry move_block
     1145         :
     1146           assign
     1147             buf_temp-browse-handle.browse-handle :width
     1148               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1149             no-error .
     1150           if error-status :error
     1151           or error-status :get-message(1) <> ""
     1152           then do:
     1153             undo move_block, retry move_block .
     1154           end.
     1155         end.
     1156         assign
     1157           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1158           no-error .
     1159         if error-status :error
     1160         or error-status :get-message(1) <> ""
     1161         then do:
     1162           undo move_block, retry move_block.
     1163         end.
     1164         assign
     1165           frame d-bas-cds :width = frame d-bas-cds :width + p-change-value
     1166         no-error .
     1167         if error-status :error
     1168         or error-status :get-message(1) <> ""
     1169         then do:
     1170           undo move_block, retry move_block.
     1171         end.
     1172         if frame d-bas-cds :scrollable = true
     1173         then do:
     1174           assign
     1175             frame d-bas-cds :virtual-width = frame d-bas-cds :virtual-width + p-change-value
     1176           no-error .
     1177           if error-status :error
     1178           or error-status :get-message(1) <> ""
     1179           then do:
     1180             undo move_block, retry move_block.
     1181           end.
     1182         end.
     1183       end.
     1184       if p-move-resize
     1185       then do:
     1186         run diasize_position-resize-button in this-procedure .
     1187       end.
     1188       if v-diasize-wndstore = true
     1189       then do:
     1190         if connected("ub") = true
     1191         then do:
     1192           define variable v-cntxt-db-num        as integer   no-undo .
     1193           define variable v-cntxt-userid        as character no-undo .
     1194           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1195                                             , OUTPUT v-cntxt-userid
     1196                                             ) .
     1197           run gbl/wndsizew.p
     1198             (input  v-cntxt-db-num
     1199             ,input  v-cntxt-userid
     1200             ,input  v-diasize-proc-name
     1201             ,input  'width':u
     1202             ,input  string(frame d-bas-cds :width - v-diasize-orig-frame-width)
     1203             ) .
     1204         end.
     1205       end.
     1206     end.
     1207     assign
     1208       v-diasize-change-size = false
     1209     .
     1210   end procedure.
     1211   procedure diasize_set-width :
     1212     define input  parameter p-new-width  as decimal   no-undo .
     1213     define input  parameter p-move-resize as logical   no-undo .
     1214     do
     1215     on error undo, return error return-value
     1216     :
     1217       run diasize_change-width in this-procedure
     1218         (input  (p-new-width - frame d-bas-cds :width)
     1219         ,input  p-move-resize
     1220         ) .
     1221     end.
     1222   end procedure.
     1223   procedure diasize_position-resize-button :
     1224     do with frame d-bas-cds
     1225     :
     1226       hide v-diasize-resize-button .
     1227       assign
     1228         v-diasize-resize-button :row = frame d-bas-cds :height - v-diasize-resize-button :height
     1229                     - 1
     1230                     - (frame d-bas-cds :border-bottom-pixels / session :pixels-per-row)
     1231         v-diasize-resize-button :col = frame d-bas-cds :width - v-diasize-resize-button :width
     1232                     - 1
     1233                     - (frame d-bas-cds :border-right-pixels / session :pixels-per-column)
     1234       .
     1235       view v-diasize-resize-button .
     1236     end.
     1237   end procedure.
     1238   on alt-right anywhere
     1239   do:
     1240     run diasize_change-width in this-procedure
     1241       (input 1
     1242       ,input true
     1243       ) .
     1244     return no-apply .
     1245   end.
     1246   on alt-left anywhere
     1247   do:
     1248     run diasize_change-width in this-procedure
     1249       (input -1
     1250       ,input true
     1251       ) .
     1252     return no-apply .
     1253   end.
     1254   on alt-down anywhere
     1255   do:
     1256     run diasize_change-height in this-procedure
     1257       (input 1
     1258       ,input true
     1259       ) .
     1260     return no-apply .
     1261   end.
     1262   on alt-up anywhere
     1263   do:
     1264     run diasize_change-height in this-procedure
     1265       (input -1
     1266       ,input true
     1267       ) .
     1268     return no-apply .
     1269   end.
     1270   on alt-enter of frame d-bas-cds
     1271   do:
     1272     run diasize_maximize in this-procedure
     1273       (input  ?
     1274       ).
     1275     return no-apply .
     1276   end.
     1277   procedure diasize_end-move :
     1278     do
     1279     on error undo, return error return-value
     1280     :
     1281       define variable v-row-delta as decimal   no-undo .
     1282       define variable v-col-delta as decimal   no-undo .
     1283       define variable v-new-row as decimal   no-undo .
     1284       define variable v-new-col as decimal   no-undo .
     1285       assign
     1286         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1287         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1288       .
     1289       assign
     1290         v-row-delta = v-new-row - frame d-bas-cds :height
     1291         v-col-delta = v-new-col - frame d-bas-cds :width
     1292       .
     1293       run diasize_change-height in this-procedure
     1294         (input v-row-delta
     1295         ,input true
     1296         ) .
     1297       run diasize_change-width in this-procedure
     1298         (input v-col-delta
     1299         ,input true
     1300         ) .
     1301     end.
     1302   end procedure.
     1303   procedure diasize_maximize :
     1304     define input  parameter p-action as logical   no-undo .
     1305     do
     1306     on error undo, return error return-value
     1307     :
     1308       if p-action = ?
     1309       then do:
     1310         if v-diasize-need-maximize = true
     1311         then do:
     1312           assign
     1313             p-action = true
     1314           .
     1315         end.
     1316         else do:
     1317           assign
     1318             p-action = false
     1319           .
     1320         end.
     1321       end.
     1322       if p-action = true
     1323       then do:
     1324         run diasize_change-height in this-procedure
     1325           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1326               - frame d-bas-cds :height-chars
     1327           ,input true
     1328           ) .
     1329         run diasize_change-width in this-procedure
     1330           (input session :width-chars
     1331               - frame d-bas-cds :width-chars
     1332           ,input true
     1333           ) .
     1334         assign
     1335           v-diasize-need-maximize = false
     1336         .
     1337       end.
     1338       else do:
     1339         run diasize_change-width in this-procedure
     1340           (input v-diasize-orig-frame-width
     1341               - frame d-bas-cds :width-chars
     1342           ,input true
     1343           ) .
     1344         run diasize_change-height in this-procedure
     1345           (input v-diasize-orig-frame-height
     1346               - frame d-bas-cds :height-chars
     1347           ,input true
     1348           ) .
     1349         assign
     1350           v-diasize-need-maximize = true
     1351         .
     1352       end.
     1353     end.
     1354   end procedure.
     1355   procedure diasize_restore-orig-size :
     1356     do
     1357     on error undo, return error return-value
     1358     :
     1359       assign
     1360         v-diasize-current-frame-width  = frame d-bas-cds :width
     1361         v-diasize-current-frame-height = frame d-bas-cds :height
     1362       .
     1363       run diasize_set-height in this-procedure
     1364         (input  v-diasize-orig-frame-height
     1365         ,input  true
     1366         ) .
     1367       run diasize_set-width in this-procedure
     1368         (input  v-diasize-orig-frame-width
     1369         ,input  true
     1370         ) .
     1371     end.
     1372   end procedure.
     1373   procedure diasize_restore-current-size :
     1374     do
     1375     on error undo, return error return-value
     1376     :
     1377       run diasize_set-height in this-procedure
     1378         (input  v-diasize-current-frame-height
     1379         ,input  true
     1380         ) .
     1381       run diasize_set-width in this-procedure
     1382         (input  v-diasize-current-frame-width
     1383         ,input  true
     1384         ) .
     1385     end.
     1386   end procedure.
     1387   procedure diasize_set-browse-handle :
     1388     define input  parameter p-browse-handle as handle   no-undo .
     1389     define buffer buf_temp-browse-handle for temp-browse-handle .
     1390     do
     1391     on error undo, return error return-value
     1392     :
     1393       assign
     1394         v-diasize-browse-handle = p-browse-handle
     1395       .
     1396       for each buf_temp-browse-handle
     1397       on error undo, return error return-value
     1398       :
     1399         delete buf_temp-browse-handle .
     1400       end.
     1401     end.
     1402   end procedure.
     1403   procedure diasize_add_browse :
     1404     define input  parameter p-browse-type   as character no-undo .
     1405     define input  parameter p-browse-handle as handle    no-undo .
     1406     define buffer buf_temp-browse-handle for temp-browse-handle .
     1407     do
     1408     on error undo, return error return-value
     1409     :
     1410       assign
     1411         v-diasize-browse-number = v-diasize-browse-number + 1
     1412       .
     1413       create buf_temp-browse-handle .
     1414       assign
     1415         buf_temp-browse-handle.browse-type   = p-browse-type
     1416         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1417         buf_temp-browse-handle.browse-handle = p-browse-handle
     1418       .
     1419     end.
     1420   end procedure.
     1421   procedure diasize_init :
     1422     define variable v-default-value    as logical   no-undo .
     1423     define variable v-restore-saved    as logical   no-undo .
     1424     define variable v-resize-value-str as character no-undo .
     1425     do
     1426     on error undo, return error return-value
     1427     :
     1428       do with frame d-bas-cds
     1429       :
     1430         assign
     1431           v-diasize-orig-frame-height = frame d-bas-cds :height
     1432           v-diasize-orig-frame-width  = frame d-bas-cds :width
     1433           v-diasize-browse-handle     = browse br-cds :handle
     1434         .
     1435         create button v-diasize-resize-button
     1436         assign
     1437           parent        = frame d-bas-cds :first-child
     1438           label         = "s"
     1439           height-pixels = 16
     1440           width-pixels  = 16
     1441           visible       = true
     1442           sensitive     = true
     1443           movable       = true
     1444           triggers:
     1445             on end-move persistent run diasize_end-move in this-procedure .
     1446           end triggers.
     1447         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1448         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1449         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1450         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1451         assign
     1452           v-diasize-wndmax = false
     1453         .
     1454         if connected("ub") = true
     1455         then do:
     1456           define variable v-cntxt-db-num        as integer   no-undo .
     1457           define variable v-cntxt-userid        as character no-undo .
     1458           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1459                                             , OUTPUT v-cntxt-userid
     1460                                             ) .
     1461           run gbl/wndpar_r.p
     1462             (input  v-cntxt-db-num
     1463             ,input  v-cntxt-userid
     1464             ,input  'wndmax':U
     1465             ,output v-diasize-wndmax
     1466             ,output v-default-value
     1467             ) .
     1468         end.
     1469         assign
     1470           v-diasize-wndstore = false
     1471         .
     1472         if connected("ub") = true
     1473         then do:
     1474           run gbl/wndpar_r.p
     1475             (input  v-cntxt-db-num
     1476             ,input  v-cntxt-userid
     1477             ,input  'wndstore':U
     1478             ,output v-diasize-wndstore
     1479             ,output v-default-value
     1480             ) .
     1481         end.
     1482         assign
     1483           v-diasize-proc-name = entry(1, program-name(2), '.')
     1484         .
     1485         if v-diasize-wndstore = true
     1486         then do:
     1487           assign
     1488             v-restore-saved = false
     1489           .
     1490           if connected("ub") = true
     1491           then do:
     1492             run gbl/wndsizer.p
     1493               (input  v-cntxt-db-num
     1494               ,input  v-cntxt-userid
     1495               ,input  v-diasize-proc-name
     1496               ,input  'height':u
     1497               ,output v-resize-value-str
     1498               ) .
     1499             if v-resize-value-str <> '':U
     1500             then do:
     1501               run diasize_change-height in this-procedure
     1502                 (input  integer(v-resize-value-str)
     1503                 ,input  true
     1504                 ) .
     1505               assign
     1506                 v-restore-saved = true
     1507               .
     1508             end.
     1509           end.
     1510           if connected("ub") = true
     1511           then do:
     1512             run gbl/wndsizer.p
     1513               (input  v-cntxt-db-num
     1514               ,input  v-cntxt-userid
     1515               ,input  v-diasize-proc-name
     1516               ,input  'width':u
     1517               ,output v-resize-value-str
     1518               ) .
     1519             if v-resize-value-str <> '':U
     1520             then do:
     1521               run diasize_change-width in this-procedure
     1522                 (input  integer(v-resize-value-str)
     1523                 ,input  true
     1524                 ) .
     1525               assign
     1526                 v-restore-saved = true
     1527               .
     1528             end.
     1529           end.
     1530           if v-restore-saved <> true
     1531           then do:
     1532             if v-diasize-wndmax = true
     1533             then do:
     1534               run diasize_maximize in this-procedure
     1535                 (input  true
     1536                 ) .
     1537             end.
     1538           end.
     1539         end.
     1540         else do:
     1541           if v-diasize-wndmax = true
     1542           then do:
     1543             run diasize_maximize in this-procedure
     1544               (input  true
     1545               ) .
     1546           end.
     1547         end.
     1548       end.
     1549     end.
     1550   end procedure.
     1551   procedure diasize_need-full-display :
     1552     define output parameter p-need-full-display as logical   no-undo .
     1553     do
     1554     on error undo, return error return-value
     1555     :
     1556       assign
     1557         p-need-full-display = v-diasize-need-full-display
     1558       .
     1559       assign
     1560         v-diasize-need-full-display = false
     1561       .
     1562     end.
     1563   end procedure.
     1564   procedure get-context :
     1565      define output parameter p-db-num as integer          no-undo.
     1566      define output parameter p-user-id as character        no-undo.
     1567      define variable v-login               as character    no-undo.
     1568      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1569      define buffer buf_user-login  for ub.user-login .
     1570      do
     1571      on error undo, return error
     1572      :
     1573            FIND FIRST buf_sys-ctrl no-lock.
     1574            ASSIGN
     1575               v-login = USERID("ub")
     1576               p-db-num = buf_sys-ctrl.db-num
     1577            .
     1578            FIND FIRST buf_user-login
     1579                 WHERE buf_user-login.db-num = p-db-num
     1580                   AND buf_user-login.user-login = v-login
     1581                 no-lock
     1582                 no-error
     1583                 .
     1584            IF AVAILABLE buf_user-login
     1585            THEN DO:
     1586               assign
     1587                  p-user-id = buf_user-login.user-id
     1588               .
     1589            END.
     1590      end.
     1591   end procedure.
     1592       run diasize_init in this-procedure .
     1593   MAIN-BLOCK:
     1594   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1595      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1596   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1597     run mainmenu_getcntxt in parparentproc
     1598       (output v-cntxt-db-num
     1599       ,output v-cntxt-userid
     1600       ,output v-cntxt-level
     1601       ,output v-cntxt-host-code-obj
     1602       ,output v-cntxt-obj-type
     1603       ,output v-cntxt-obj-code
     1604       ,output v-cntxt-db-num-obj
     1605       ,output v-cntxt-is-admin
     1606       ) .
     1607     find goods no-lock where
     1608          goods.gds-code = g-code.
     1609     v-rec-list = p-rec-list.
     1610     RUN UI-on.
     1611     WAIT-FOR GO OF FRAME d-bas-cds.
     1612   END.
     1613   RUN disable_UI.
     1614   PROCEDURE cre-bas :
     1615   def var pr-rec   as   recid                  no-undo.
     1616   def var pr-c-b-r like ub.bar-code.cli-base-rate no-undo.
     1617   define buffer buf2_parts for ub.parts  .
     1618   define buffer buf2_goods for ub.goods  .
     1619   find ub.gds-prt no-lock where
     1620        ub.gds-prt.node-code = ub.bar-code.node-code.
     1621   if ub.bar-code.in-code = "" and
     1622      ub.gds-prt.upper-code = ub.goods.prt-root then
     1623     return.
     1624   if not ub.gds-prt.root and
     1625      not ub.gds-prt.is-term then
     1626     return.
     1627   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1628   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodepls in g#library
     1629     (input  p-curr-obj-type
     1630     ,input  p-curr-obj-code
     1631     ,input  ub.bar-code.b-code
     1632     ,input  0
     1633     ,input  0
     1634     ,output pr-rec
     1635     ,output pr-c-b-r
     1636     )  .
     1637   create bas-code.
     1638   buffer-copy ub.bar-code to bas-code
     1639     assign
     1640       bas-code.rid  = recid (ub.bar-code)
     1641       .
     1642   if ub.gds-prt.upper-code = ub.goods.prt-root then
     1643     bas-code.f-name = "".
     1644   else
     1645     bas-code.f-name = ub.gds-prt.f-name.
     1646   find  ub.price-list no-lock where
     1647         recid (ub.price-list) = pr-rec no-error.
     1648   if available ub.price-list and
     1649      ub.price-list.b-code = ub.bar-code.b-code then
     1650     assign
     1651       bas-code.price-sale = ub.price-list.price-sale
     1652       bas-code.doc-num    = ub.price-list.doc-num
     1653       .
     1654   else
     1655     if lookup (mode, "gds-current") > 0 then
     1656       delete bas-code.
     1657     else
     1658       assign
     1659         bas-code.price-sale = ?
     1660         bas-code.doc-num    = ?
     1661         .
     1662    bas-code.qnty    = 0.
     1663   if mode = "par-gds-free" then do:
     1664   find first buf2_goods no-lock  where
     1665              buf2_goods.gds-code = g-code no-error .
     1666   find first buf2_parts no-lock where
     1667         buf2_parts.out-code  = 'free-zone':U and
     1668         buf2_parts.obj-type = p-curr-obj-type and
     1669         buf2_parts.obj-code = p-curr-obj-code and
     1670         buf2_parts.rsrv-free = true    and
     1671         buf2_parts.status_   = false   and
     1672         buf2_parts.in-code   = bar-code.in-code  and
     1673         buf2_parts.part-code   = bar-code.part-code  and
     1674         buf2_parts.artic     = buf2_goods.artic  and
     1675         buf2_parts.prod-type = buf2_goods.prod-type  and
     1676         buf2_parts.prod-code = buf2_goods.prod-code no-error .
     1677       if available buf2_parts then do:
     1678          bas-code.qnty    = buf2_parts.fact-qnty .
     1679       end.
     1680       else do:
     1681          bas-code.qnty    = ?.
     1682       end.
     1683   end.
     1684   END PROCEDURE.
     1685   PROCEDURE disable_UI :
     1686     HIDE FRAME d-bas-cds.
     1687   END PROCEDURE.
     1688   PROCEDURE UI-on :
     1689   ENABLE b-quit b-sel b-mark b-help br-cds WITH FRAME d-bas-cds.
     1690   for each bas-code:
     1691     delete bas-code.
     1692   end.
     1693   case mode:
     1694     when "gds-current" then do:
     1695       frame d-bas-cds :title = "Имеющиеся основные цены:   " +
     1696                                    "Товар: " + ub.goods.artic + "  " + ub.goods.gds-name
     1697                                    .
     1698       for each ub.bar-code no-lock where
     1699                ub.bar-code.gds-code  = ub.goods.gds-code and
     1700                ub.bar-code.unit-cli  = ub.goods.unit-base:
     1701         run cre-bas.
     1702       end.
     1703     end.
     1704     when "scl-gds-all" then do:
     1705       frame d-bas-cds :title = "Все основные коды по признакам:   " +
     1706                                    "Товар: " + ub.goods.artic + "  " + ub.goods.gds-name
     1707                                    .
     1708       for each ub.bar-code no-lock where
     1709                ub.bar-code.gds-code  = ub.goods.gds-code and
     1710                ub.bar-code.in-code   = "" and
     1711                ub.bar-code.unit-cli  = ub.goods.unit-base:
     1712         run cre-bas.
     1713       end.
     1714       ENABLE b-add WITH FRAME d-bas-cds.
     1715     end.
     1716     when "par-gds-all" then do:
     1717       frame d-bas-cds :title = "Все основные коды по партиям:   " +
     1718                                    "Товар: " + ub.goods.artic + "  " + ub.goods.gds-name
     1719                                    .
     1720       for each ub.bar-code no-lock where
     1721                ub.bar-code.gds-code  = ub.goods.gds-code and
     1722                ub.bar-code.in-code  <> "" and
     1723                ub.bar-code.unit-cli  = ub.goods.unit-base:
     1724         run cre-bas.
     1725       end.
     1726       ENABLE b-add WITH FRAME d-bas-cds.
     1727     end.
     1728     when "par-gds-free" then do:
     1729       frame d-bas-cds :title = "Основные коды по партиям свободной зоны и незакрытых ПН:   " +
     1730                                    "Товар: " + goods.artic + "  " + goods.gds-name
     1731                                    .
     1732       for each ub.bar-code no-lock where
     1733                ub.bar-code.gds-code  = ub.goods.gds-code and
     1734                ub.bar-code.in-code  <> "" and
     1735                ub.bar-code.unit-cli  = ub.goods.unit-base,
     1736          first buf_parts no-lock where
     1737                buf_parts.out-code = 'free-zone':U  and
     1738                buf_parts.status_  = false   and
     1739                buf_parts.rsrv-free = true    and
     1740                buf_parts.in-code  = ub.bar-code.in-code  and
     1741                buf_parts.part-code  = ub.bar-code.part-code  and
     1742                buf_parts.artic     = ub.goods.artic  and
     1743                buf_parts.prod-type = ub.goods.prod-type  and
     1744                buf_parts.prod-code = ub.goods.prod-code
     1745                :
     1746         run cre-bas.
     1747       end.
     1748       hide b-add in frame d-bas-cds.
     1749     end.
     1750     when "gds-all" then do:
     1751       frame d-bas-cds :title = "Все основные коды по товару:   " +
     1752                                    "Товар: " + ub.goods.artic + "  " + ub.goods.gds-name
     1753                                    .
     1754       for each ub.bar-code no-lock where
     1755                ub.bar-code.gds-code  = ub.goods.gds-code and
     1756                ub.bar-code.unit-cli  = ub.goods.unit-base:
     1757         run cre-bas.
     1758       end.
     1759     end.
     1760   end case.
     1761   frame d-bas-cds :title = frame d-bas-cds :title +
     1762                                "      Текущий объект: " + string (p-curr-obj-type, "x(3)") +
     1763                                " " + string (p-curr-obj-code, ">>>>9").
     1764   open query br-cds
     1765     for each bas-code no-lock.
     1766   END PROCEDURE.
     1767   FUNCTION get-mark RETURNS CHARACTER
     1768     (local-rid as recid) :
     1769   if lookup (string (local-rid), v-rec-list) > 0 then
     1770     return "*".
     1771   else
     1772     return "".
     1773   END FUNCTION.
