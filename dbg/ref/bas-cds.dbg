     1058         v-diasize-resize-button :row = 1.
     1059         v-diasize-resize-button :column = 1.
     1060       end.
     1061       if p-change-value > 0
     1062       then do:
     1063         if frame d-bas-cds :scrollable = true
     1064         then do:
     1065           assign
     1066             frame d-bas-cds :virtual-width = frame d-bas-cds :virtual-width + p-change-value
     1067             no-error .
