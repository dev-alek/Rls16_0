      137   define variable v-rec-list as character no-undo .
      138   define buffer buf_parts for ub.parts  .
      139   FUNCTION get-mark RETURNS CHARACTER
      140     (local-rid as recid)  FORWARD.
      141   DEFINE BUTTON b-add
      142        LABEL "&Добавить"
      143        SIZE 10 BY 1.
      144   DEFINE BUTTON b-quit AUTO-END-KEY
      145        LABEL "&Выход"
      146        SIZE 10 BY 1
      147        BGCOLOR 8 .
      148   DEFINE BUTTON b-help
      149        LABEL "Помо&щь"
      150        SIZE 4 BY 1
      151        BGCOLOR 8 .
      152   DEFINE BUTTON b-mark
      153        LABEL "&*"
      154        SIZE 3 BY 1.
      155   DEFINE BUTTON b-sel AUTO-GO
      156        LABEL "Вы&бор"
      157        SIZE 10 BY 1
      158        BGCOLOR 8 .
      159   DEFINE QUERY br-cds FOR
      160         bas-code SCROLLING.
      161   DEFINE BROWSE br-cds
      162     QUERY br-cds DISPLAY
      163         get-mark (bas-code.rid) @ mark format "x(1)" column-label "*"
      164         bas-code.b-code                              column-label "Код"
      165         bas-code.price-sale   format ">>>>>>>>>>9.99"  column-label "Цена"
      166         bas-code.unit-cli                            column-label "Изм"
      167         bas-code.f-name
      168         bas-code.in-code         format "x(14)"     column-label "ПН"
      169         bas-code.part-code      format "x(14)"
      170         bas-code.doc-num        format "x(14)"      column-label "Переоценка"
      171         bas-code.qnty                                column-label "Кол-во"
      172       WITH NO-ROW-MARKERS SEPARATORS SIZE 100.38 BY 14.13.
      173   DEFINE FRAME d-bas-cds
      174        b-quit AT ROW 1 COL 1
      175        b-sel AT ROW 1 COL 11
      176        b-mark AT ROW 1 COL 21
      177        b-add AT ROW 1 COL 24
      178        b-help AT ROW 1 COL 95.5
      179        br-cds AT ROW 2.38 COL 1.13
      180        SPACE(0.23) SKIP(0.27)
      181       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      182            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      183            TITLE "Список основных кодов:    "
      184            DEFAULT-BUTTON b-quit CANCEL-BUTTON b-quit.
      185   ASSIGN
      186          FRAME d-bas-cds:SCROLLABLE       = FALSE.
      187   ON GO OF FRAME d-bas-cds
      188   DO:
      189     p-rec-list = v-rec-list.
      190   END.
      191   ON WINDOW-CLOSE OF FRAME d-bas-cds
      192   DO:
      193     APPLY "END-ERROR":U TO SELF.
      194   END.
      195   ON CHOOSE OF b-add IN FRAME d-bas-cds
      196   DO:
      197   define variable v-prt-rec as recid no-undo .
      198   case mode:
      199     when "scl-gds-all" then do:
      200       define variable v-sel-node-code as integer   no-undo .
      201       run str/prt-ref.w
      202         (INPUT  parparentproc
      203         ,input  ub.goods.gds-code
      204         ,input  'ПРОСМОТР':U
      205         ,input  p-curr-obj-type
      206         ,input  p-curr-obj-code
      207         ,input  ""
      208         ,input  ""
      209         ,output v-sel-node-code
      210         ) .
      211     end.
      212     when "par-gds-free" then do:
      213     end.
      214     when "par-gds-all" then do:
      215       define variable v-chk-act-host-code as integer   no-undo .
      216   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      217   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      218     (input  p-curr-obj-type
      219     ,input  p-curr-obj-code
      220     ,output v-chk-act-host-code
      221     )  .
      222   define variable vss-include-info2 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      223   do:
      224     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      225       (input  v-cntxt-db-num
      226       ,input  v-cntxt-userid
      227       ,input  0
      228       ,input  'actn_archive_cost':U
      229       ,input  'object':U
      230       ,input  v-chk-act-host-code
      231       ,input  p-curr-obj-type
      232       ,input  p-curr-obj-code
      233       ,input  0
      234       ,input  0
      235       ,input  0
      236       ,input  true
      237       ,output glog
      238       )  .
      239   end.
      240       if NOT glog then return no-apply .
      241       run str/parts-l.w
      242         (
      243          input parparentproc
      244         ,input p-curr-obj-type
      245         ,input p-curr-obj-code
      246         ,input goods.gds-code
      247         ,input ""
      248         ,input 'ПРОСМОТР':U
      249         ,input 'остатки':U
      250         ,input 'текущий':U
      251         ,input 'справочник':U
      252         ,output v-prt-rec
      253         ) .
      254     end.
      255     otherwise do:
      256       message
      257         "Для данного режима добавление не работает."
      258         view-as alert-box.
      259       return no-apply.
      260     end.
      261   end case.
      262   run UI-on.
      263   END.
      264   ON CHOOSE OF b-mark IN FRAME d-bas-cds
      265   DO:
      266   if not available bas-code then  return no-apply.
      267   define variable v-num-entry3 as integer no-undo .
      268   assign
      269     v-num-entry3 = lookup(string( bas-code.rid ), v-rec-list ).
      270   if v-num-entry3 > 0 then do:
      271     assign
      272       entry(v-num-entry3, v-rec-list) = "":U
      273       v-rec-list = replace( v-rec-list, chr(44) + chr(44), chr(44)) .
      274   end.
      275   else do:
      276     assign
      277     v-rec-list = v-rec-list + ( if v-rec-list = "":U then "":U else chr(44) ) + string( bas-code.rid) .
      278   end.
      279   br-cds :refresh ().
      280   if last-event :function <> "mouse-select-dblclick" then
      281     br-cds :select-next-row ().
      282   apply "entry" to br-cds in frame d-bas-cds.
      283   END.
      284   ON CHOOSE OF b-sel IN FRAME d-bas-cds
      285   DO:
      286   if v-rec-list = "" and
      287      available bas-code then
      288     v-rec-list = string (bas-code.rid).
      289   END.
      290   ON MOUSE-SELECT-DBLCLICK OF br-cds IN FRAME d-bas-cds
      291   DO:
      292   apply "choose" to b-mark in frame d-bas-cds.
      293   END.
      294   ON RETURN OF br-cds IN FRAME d-bas-cds
      295   DO:
      296   apply "choose" to b-mark in frame d-bas-cds.
      297   END.
      298   define variable vss-include-info4 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      299   on CTRL-N, CTRL-Т of frame d-bas-cds anywhere do:
      300     if b-add :sensitive then DO: apply "CHOOSE":U to b-add in frame d-bas-cds. END.
      301     return no-apply.
      302   end.
      303   define variable vss-include-info5 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      304   on F2 of frame d-bas-cds anywhere do:
      305     if b-sel :sensitive then DO: apply "CHOOSE":U to b-sel in frame d-bas-cds. END.
      306     return no-apply.
      307   end.
      308   define variable vss-include-info6 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      309   on INS of frame d-bas-cds anywhere do:
      310     if b-mark :sensitive then DO: apply "CHOOSE":U to b-mark in frame d-bas-cds. END.
      311     return no-apply.
      312   end.
      313   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME d-bas-cds:PARENT eq ?
      314   THEN FRAME d-bas-cds:PARENT = ACTIVE-WINDOW.
      315   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      316   on help of frame d-bas-cds
      317   do:
      318     run gbl/app_help.p
      319       (input this-procedure :file-name
      320       ,input ''
      321       ,input ?
      322       ) no-error.
      323     if error-status :error then do:
      324       message
      325         "Ошибка при вызове помощи"
      326         error-status :get-message(1)
      327         view-as alert-box .
      328     end.
      329   end.
      330   run minbtn-set in this-procedure .
      331   on choose of b-help in frame d-bas-cds
      332   do:
      333     apply "help":u to frame d-bas-cds .
      334   end.
      335   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      336   procedure minbtn-set :
      337       do
      338           on error undo, return error return-value
      339           :
      340           define variable ii              as integer       no-undo .
      341           define variable fh              as widget-handle no-undo .
      342           define variable hh              as widget-handle no-undo .
      343           define variable v-h             as handle        extent 4 no-undo .
      344           define variable v-name-button   as character     no-undo .
      345           define variable v-help-old-x    as decimal       no-undo .
      346           define variable v-help-old-y    as decimal       no-undo .
      347           define variable v-help-old-size as decimal       no-undo .
      348           define variable v-frame-width   as decimal       no-undo .
      349           define variable jj              as integer       no-undo .
      350           do
      351               on error undo, return error
      352               :
      353               assign
      354                   v-frame-width = frame d-bas-cds:width - 0.3
      355                   fh            = frame d-bas-cds:first-child
      356                   hh            = fh:first-child
      357                   ii            = 1
      358                   .
      359               do while valid-handle(hh):
      360                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      361                   do:
      362                       case lc(hh:name) :
      363                           when "b-help" then
      364                               do:
      365                                   hh:load-image-up("cmp/b-help.bmp":u) .
      366                                   hh:load-image-down("cmp/b-help.bmp":u) .
      367                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      368                                   hh:TOOLTIP = "Помощь" .
      369                                   v-help-old-x = hh:column .
      370                                   v-help-old-y = hh:row    .
      371                                   v-help-old-size = hh:width .
      372                                   hh:width-chars = 2.5 .
      373                               end.
      374                           when "b-print" then
      375                               do:
      376                                   hh:load-image("cmp/b-print.bmp":u) .
      377                                   hh:TOOLTIP = "Печать" .
      378                                   v-h[ii] = hh:handle .
      379                                   ii = ii + 1 .
      380                                   hh:width-chars = 3 .
      381                               end.
      382                           when "b-history" or
      383                           when "b-hist" then
      384                               do:
      385                                   hh:load-image("cmp/b-hist.bmp":u) .
      386                                   hh:TOOLTIP = "История" .
      387                                   v-h[ii] = hh:handle .
      388                                   ii = ii + 1 .
      389                                   hh:width-chars = 3 .
      390                               end.
      391                           when "b-sch" then
      392                               do:
      393                                   hh:load-image("cmp/b-sch.bmp":u) .
      394                                   hh:TOOLTIP = "Установка Фильтра" .
      395                                   v-h[ii] = hh:handle .
      396                                   ii = ii + 1 .
      397                                   hh:width-chars = 3 .
      398                               end.
      399                           when "b-hist-user" then
      400                               do:
      401                                   hh:load-image("cmp/b-hist.bmp":u) .
      402                                   hh:TOOLTIP = "История пользователя" .
      403                                   ii = ii + 1 .
      404                               end.
      405                       end case.
      406                   end.
      407                   hh = hh:next-sibling.
      408               end.
      409               b-help:column = v-frame-width - b-help:width-chars.
      410               jj = 0.
      411               repeat ii = 4 to 1 by -1 :
      412                   if valid-handle (v-h[ii] ) then
      413                   do:
      414                       jj  = jj + 1 .
      415                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      416                       v-h[ii]:row    = v-help-old-y .
      417                   end.
      418               end.
      419           end.
      420       end.
      421   end procedure.
      422   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      423   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      424   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      425   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      426   define variable v-diasize-current-frame-width  as decimal   no-undo .
      427   define variable v-diasize-current-frame-height as decimal   no-undo .
      428   define variable v-diasize-change-size          as logical   no-undo .
      429   define variable v-diasize-resize-button        as handle    no-undo .
      430   define variable v-diasize-wndmax               as logical   no-undo .
      431   define variable v-diasize-wndstore             as logical   no-undo .
      432   define variable v-diasize-proc-name            as character no-undo .
      433   define variable v-diasize-browse-handle        as handle    no-undo .
      434   define variable v-diasize-browse-number        as integer   no-undo .
      435   define variable v-diasize-need-full-display    as logical   no-undo init false .
      436   define temp-table temp-diasize-handle no-undo
      437     field handle-value  as handle
      438     field save-position as decimal
      439     index xpk is primary unique handle-value
      440     .
      441   define temp-table temp-browse-handle no-undo
      442     field browse-type   as character
      443     field browse-number as integer
      444     field browse-handle as handle
      445     field original-size as decimal
      446     index xpk is primary unique browse-type browse-number
      447     index xie browse-type browse-handle
      448   .
      449   procedure diasize_change-height :
      450     define input  parameter p-change-value  as decimal   no-undo .
      451     define input  parameter p-move-resize   as logical   no-undo .
      452     define variable v-field-group-handle    as handle    no-undo .
      453     define variable v-object-handle         as handle    no-undo .
      454     define variable v-frame-height          as decimal   no-undo .
      455     define variable v-frame-virtual-height  as decimal   no-undo .
      456     define variable v-browse-height         as decimal   no-undo .
      457     define variable v-window-height         as decimal   no-undo .
      458     define variable v-window-virtual-height as decimal   no-undo .
      459     define variable v-change-sign           as integer   no-undo .
      460     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      461     define buffer buf_temp-browse-handle  for temp-browse-handle .
      462     if p-change-value > 0
      463     then do:
      464       if frame d-bas-cds :height + p-change-value
      465           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      466       then do:
      467         assign
      468           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      469                           - (frame d-bas-cds :height-chars)
      470         .
      471         if p-change-value <= 0
      472         then do:
      473           run diasize_position-resize-button in this-procedure .
      474           return .
      475         end.
      476       end.
      477     end.
      478     if p-change-value < 0
      479     then do:
      480       if frame d-bas-cds :height + p-change-value < v-diasize-orig-frame-height
      481       then do:
      482         assign
      483           p-change-value = v-diasize-orig-frame-height
      484                          - (frame d-bas-cds :height-chars)
      485         .
      486         if p-change-value >= 0
      487         then do:
      488           run diasize_position-resize-button in this-procedure .
      489           return .
      490         end.
      491       end.
      492     end.
      493     if p-change-value >= 0
      494     then do:
      495       assign
      496         v-change-sign = 1
      497       .
      498     end.
      499     else do:
      500       assign
      501         v-change-sign = -1
      502       .
      503     end.
      504     assign
      505       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      506     .
      507     if p-change-value = 0
      508     then do:
      509       run diasize_position-resize-button in this-procedure .
      510       return .
      511     end.
      512     move_block:
      513     do
      514     on error undo move_block, retry move_block
      515     :
      516       if retry
      517       then do:
      518         do
      519         on error undo move_block, leave move_block
      520         :
      521           if p-change-value > 0
      522           then do:
      523             for each buf_temp-diasize-handle
      524             on error undo, next
      525             :
      526               assign
      527                 v-object-handle = buf_temp-diasize-handle.handle-value
      528               .
      529               if v-object-handle <> v-diasize-resize-button
      530               then do:
      531                 assign
      532                   v-object-handle :row = buf_temp-diasize-handle.save-position
      533                 .
      534               end.
      535             end.
      536             assign
      537               v-diasize-browse-handle :height = v-browse-height
      538             .
      539             for each buf_temp-browse-handle
      540               where buf_temp-browse-handle.browse-type = 'height':u
      541             on error undo, next
      542             :
      543               assign
      544                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      545               .
      546             end.
      547             assign
      548               frame d-bas-cds :height = v-frame-height
      549             .
      550             if frame d-bas-cds :scrollable = true
      551             then do:
      552               assign
      553                 frame d-bas-cds :virtual-height = v-frame-virtual-height
      554               .
      555             end.
      556             run diasize_position-resize-button in this-procedure .
      557           end.
      558           else do:
      559             if frame d-bas-cds :scrollable = true
      560             then do:
      561               assign
      562                 frame d-bas-cds :virtual-height = v-frame-virtual-height
      563               .
      564             end.
      565             assign
      566               frame d-bas-cds :height = v-frame-height
      567             .
      568             assign
      569               v-diasize-browse-handle :height = v-browse-height
      570             .
      571             for each buf_temp-browse-handle
      572               where buf_temp-browse-handle.browse-type = 'height':u
      573             on error undo, next
      574             :
      575               assign
      576                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      577               .
      578             end.
      579             for each buf_temp-diasize-handle
      580             on error undo, next
      581             :
