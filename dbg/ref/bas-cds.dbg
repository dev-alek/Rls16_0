      632       :
      633         assign
      634           v-object-handle = v-field-group-handle :first-child
      635         .
      636         do while valid-handle(v-object-handle)
      637         :
      638           if  v-object-handle <> v-diasize-browse-handle :handle
      639           and can-query(v-object-handle, "row")
      640           and can-query(v-object-handle, "height")
      641           and ( v-object-handle :row > v-diasize-browse-handle :row )
      642           then do:
      643             find first buf_temp-browse-handle
      644               where buf_temp-browse-handle.browse-type   = 'height':u
      645                 and buf_temp-browse-handle.browse-handle = v-object-handle
      646               no-error .
      647             if available buf_temp-browse-handle
      648             then do:
      649             end.
      650             else do:
      651               create buf_temp-diasize-handle .
      652               assign
      653                 buf_temp-diasize-handle.handle-value  = v-object-handle
      654                 buf_temp-diasize-handle.save-position = v-object-handle :row
      655               .
      656             end.
      657           end.
      658           assign
      659             v-object-handle = v-object-handle :next-sibling
      660           .
      661         end.
      662         assign
      663           v-field-group-handle = v-field-group-handle :next-sibling
      664         .
      665       end.
      666       do with frame d-bas-cds
      667       :
      668         hide v-diasize-resize-button .
      669         assign
      670           v-diasize-resize-button :row    = 1
      671           v-diasize-resize-button :column = 1
      672         .
      673       end.
      674       if p-change-value > 0
      675       then do:
      676         if frame d-bas-cds :scrollable = true
      677         then do:
      678           assign
      679             frame d-bas-cds :virtual-height = frame d-bas-cds :virtual-height + p-change-value
      680             no-error .
      681           if error-status :error
      682           or error-status :get-message(1) <> ""
      683           then do:
      684             undo move_block, retry move_block .
      685           end.
      686         end.
      687         assign
      688           frame d-bas-cds :height = frame d-bas-cds :height + p-change-value
      689           no-error .
      690         if error-status :error
