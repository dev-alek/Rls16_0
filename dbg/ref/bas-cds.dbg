      811             (input  v-cntxt-db-num
      812             ,input  v-cntxt-userid
      813             ,input  v-diasize-proc-name
      814             ,input  'height':u
      815             ,input  string(frame d-bas-cds :height - v-diasize-orig-frame-height)
      816             ) .
      817         end.
