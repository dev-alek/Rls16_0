     1081         end.
     1082         assign
     1083           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1084         no-error .
     1085         if error-status :error
     1086         or error-status :get-message(1) <> ""
     1087         then do:
     1088           undo move_block, retry move_block.
     1089         end.
     1090         for each buf_temp-browse-handle
     1091           where buf_temp-browse-handle.browse-type = 'width':u
     1092         on error undo move_block, retry move_block
     1093         :
     1094           assign
     1095             buf_temp-browse-handle.browse-handle :width
     1096               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1097             no-error .
