     1041               assign
     1042                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1043                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1044               .
     1045             end.
     1046           end.
     1047           assign
     1048             v-object-handle = v-object-handle :next-sibling
     1049           .
     1050         end.
     1051         assign
