      822     .
      823   end procedure.
      824   procedure diasize_set-height :
      825     define input  parameter p-new-height  as decimal   no-undo .
      826     define input  parameter p-move-resize as logical   no-undo .
      827     do
      828     on error undo, return error return-value
      829     :
      830       run diasize_change-height in this-procedure
      831         (input  (p-new-height - frame d-bas-cds :height)
      832         ,input  p-move-resize
      833         ) .
      834     end.
      835   end procedure.
      836   procedure diasize_change-width :
      837     define input  parameter p-change-value as decimal   no-undo .
      838     define input  parameter p-move-resize  as logical   no-undo .
      839     define variable v-field-group-handle   as handle    no-undo .
      840     define variable v-object-handle        as handle    no-undo .
      841     define variable v-frame-width          as decimal   no-undo .
      842     define variable v-frame-virtual-width  as decimal   no-undo .
      843     define variable v-browse-width         as decimal   no-undo .
      844     define variable v-window-width         as decimal   no-undo .
      845     define variable v-window-virtual-width as decimal   no-undo .
      846     define variable v-change-sign          as integer   no-undo .
      847     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      848     define buffer buf_temp-browse-handle  for temp-browse-handle .
      849     if p-change-value > 0
      850     then do:
      851       if frame d-bas-cds :width + p-change-value >
      852           session :width-chars
      853       then do:
      854         assign
      855           p-change-value = session :width-chars - frame d-bas-cds :width
      856         .
      857         if p-change-value <= 0
      858         then do:
      859           run diasize_position-resize-button in this-procedure .
      860           return .
      861         end.
      862       end.
      863     end.
      864     if p-change-value < 0
      865     then do:
      866       if frame d-bas-cds :width + p-change-value < v-diasize-orig-frame-width
      867       then do:
      868         assign
      869           p-change-value = v-diasize-orig-frame-width
      870                          - frame d-bas-cds :width
      871         .
      872         if p-change-value >= 0
      873         then do:
      874           run diasize_position-resize-button in this-procedure .
      875           return .
      876         end.
      877       end.
      878     end.
      879     if p-change-value >= 0
      880     then do:
      881       assign
      882         v-change-sign = 1
      883       .
      884     end.
      885     else do:
      886       assign
      887         v-change-sign = -1
      888       .
      889     end.
      890     assign
      891       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      892     .
      893     if p-change-value = 0
      894     then do:
      895       run diasize_position-resize-button in this-procedure .
      896       return .
      897     end.
      898     move_block:
      899     do
