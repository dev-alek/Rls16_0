        1   DEFINE BUFFER X_goods FOR ub.goods.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   DEFINE INPUT PARAMETER BTTNS AS CHAR NO-UNDO.
        4   define input parameter p-list-mode as character no-undo .
        5   define input parameter p-tax-code as integer no-undo .
        6   DEFINE INPUT-OUTPUT PARAMETER p-rid-list As character NO-UNDO.
        7   define variable vss-revision    as character no-undo init "$Revision$":u .
        8   define variable vss-author      as character no-undo init "$Author$":u .
        9   define variable vss-date        as character no-undo init "$Date$":u .
       10   define variable vss-workfile    as character no-undo init "$Workfile$":u .
       11   define variable vss-archive     as character no-undo init "$Archive$":u .
       12   define variable vss-description as character no-undo init "Справочник товаров по индивидуальным налогам" .
       13   procedure vss-get-info :
       14     define output parameter p-vss-revision    like vss-revision    no-undo .
       15     define output parameter p-vss-author      like vss-author      no-undo .
       16     define output parameter p-vss-date        like vss-date        no-undo .
       17     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       18     define output parameter p-vss-archive     like vss-archive     no-undo .
       19     define output parameter p-vss-description like vss-description no-undo .
       20     assign
       21       p-vss-revision    = vss-revision
       22       p-vss-author      = vss-author
       23       p-vss-date        = vss-date
       24       p-vss-workfile    = vss-workfile
       25       p-vss-archive     = vss-archive
       26       p-vss-description = vss-description
       27     .
       28   end procedure.
       29   procedure vss-get-parameters :
       30     define output parameter p-vss-parameters as character no-undo .
       31   end procedure.
       32   define new global shared variable g#vssrevis-logger as handle    no-undo .
       33   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       34   define variable v-vssrevis-logger                   as handle    no-undo .
       35   procedure vss-logevent :
       36     define input  parameter p-extra-paramters as character no-undo .
       37     define variable v-vssrevis-parameters as character no-undo .
       38     do
       39     on error undo, return error return-value
       40     :
       41       if  valid-handle(v-vssrevis-logger)
       42       and v-vssrevis-logger :get-signature("logevent") <> ""
       43       then do:
       44         run vss-get-parameters in this-procedure
       45           (output v-vssrevis-parameters
       46           ).
       47         run logevent in v-vssrevis-logger
       48           (input vss-workfile
       49           ,input vss-revision
       50           ,input v-vssrevis-parameters
       51           ,input p-extra-paramters
       52           ).
       53       end.
       54     end.
       55   end procedure.
       56   assign
       57     v-vssrevis-logger = g#vssrevis-logger
       58   .
       59   if  valid-handle(v-vssrevis-logger)
       60   and v-vssrevis-logger :get-signature("logevent") <> ""
       61   then do:
       62     assign
       63       v-vssrevis-logevent = true
       64     .
       65     run vss-logevent in this-procedure (input vss-description) .
       66   end.
       67   define new global shared variable g#language as character no-undo .
       68   if g#language <> '' and g#language <> 'rus':U then do:
       69     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       70   end.
       71   procedure proc-alt-shift-f2:
       72     if not ibs.th.gbl.gbl-var:rcode
       73   then
       74     run gbl\inidebug.p .
       75   end.
       76   procedure proc-alt-shift-f3:
       77     run gbl/prvssinf.p
       78       ( input this-procedure
       79       ) .
       80   end.
       81   define variable v-inform-launched as logical no-undo initial false .
       82   procedure proc-alt-shift-f4:
       83     define variable v-action as character no-undo .
       84     if v-inform-launched = false then do:
       85       assign
       86         v-inform-launched = true
       87       .
       88       run gbl/d-inform.w
       89         (  input self
       90         ,  input this-procedure
       91         , output v-action
       92         ) no-error .
       93       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       94       assign
       95         v-inform-launched = false
       96       .
       97     end.
       98   end.
       99   procedure proc-alt-f1:
      100     run gbl/corrhelp.p
      101       (input this-procedure
      102       ) .
      103   end .
      104   on alt-shift-f2 anywhere do:
      105     run proc-alt-shift-f2.
      106   end.
      107   on alt-shift-f3 anywhere do:
      108     run proc-alt-shift-f3 in this-procedure .
      109   end.
      110   on alt-shift-f4 anywhere do:
      111     run proc-alt-shift-f4 in this-procedure.
      112   end.
      113   on alt-f1 anywhere do:
      114     run proc-alt-f1 in this-procedure .
      115   end.
      116   define new global shared variable g#library  as handle no-undo .
      117   define new global shared variable g#library2 as handle no-undo .
      118   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      119   define variable c-point  as character no-undo .
      120   define variable tbl      as character no-undo .
      121   define variable join-tbl as character no-undo .
      122   define variable fld      as character no-undo .
      123   define variable lab      as character no-undo .
      124   define variable spr      as character no-undo .
      125   define variable dim      as character no-undo .
      126   function cross-list returns logical (
      127     input parfirst-stream  as character,
      128     input parsecond-stream as character,
      129     input pardelim         as character).
      130     if pardelim = ""
      131     or pardelim = ?
      132     then do:
      133       assign
      134         pardelim = ","
      135       .
      136     end.
      137     define variable vari            as integer no-undo .
      138     define variable varresult-cross as logical no-undo .
      139     assign
      140       varresult-cross = no
      141     .
      142     def var v-num-parfirst-stream as integer no-undo .
      143     assign
      144       v-num-parfirst-stream = num-entries(parfirst-stream, pardelim)
      145     .
      146     do vari = 1 to v-num-parfirst-stream
      147     :
      148       if lookup(entry(vari, parfirst-stream, pardelim)
      149                ,parsecond-stream
      150                ,pardelim
      151                ) > 0 then do:
      152         assign
      153           varresult-cross = yes
      154         .
      155         leave.
      156       end.
      157     end.
      158     return varresult-cross .
      159   end function.
      160   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      161   procedure fltfield-clear :
      162     define output parameter loc-fld as character no-undo.
      163     define output parameter loc-lab as character no-undo .
      164     define output parameter loc-spr as character no-undo .
      165     define output parameter loc-dim as character no-undo .
      166     assign
      167       loc-fld = ""
      168       loc-lab = ""
      169       loc-spr = ""
      170       loc-dim = "0"
      171     .
      172   end procedure .
      173   procedure fltfield-add :
      174     define input        parameter par-fld as character no-undo.
      175     define input        parameter par-lab as character no-undo .
      176     define input        parameter par-spr as character no-undo .
      177     define input-output parameter loc-fld as character no-undo.
      178     define input-output parameter loc-lab as character no-undo .
      179     define input-output parameter loc-spr as character no-undo .
      180     define input-output parameter loc-dim as character no-undo .
      181     do
      182     on error undo, return error
      183     :
      184       assign
      185       loc-fld = if loc-dim = '0'
      186                 then par-fld
      187                 else (loc-fld + chr(44) + par-fld)
      188       loc-lab = if loc-dim = '0'
      189                 then par-lab
      190                 else (loc-lab + chr(44) + par-lab)
      191       loc-spr = if loc-dim = '0'
      192                 then par-spr
      193                 else (loc-spr + chr(44) + par-spr)
      194       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
      195                 string(integer(if num-entries(loc-dim) > 1
      196                               then entry(2, loc-dim)
      197                               else entry(1, loc-dim)
      198                               ) + 1)
      199       no-error
      200       .
      201     end.
      202   end procedure.
      203   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      204   define variable v-waitfram-action01         as character   no-undo .
      205   define variable v-waitfram-action02         as character   no-undo .
      206   define variable v-waitfram-action03         as character   no-undo .
      207   define variable mWaitFramTextBeg            as character   no-undo.
      208   define variable mWaitFramTextEnd            as character   no-undo.
      209   define variable mWaitFramView               as logical     no-undo.
      210   define variable mWaitProcEvent              as logical     no-undo init yes.
      211   define variable mWaitFramInterval           as integer     no-undo init 1 .
      212   define variable mWaitFramStop               as logical     no-undo.
      213   define variable mWaitFramStopUser           as logical     no-undo.
      214   define variable mWaitFramStopTimeOut        as logical     no-undo.
      215   define variable mWaitFramStartProc          as datetime-tz no-undo.
      216   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      217   define button B-WaitFramStop auto-end-key
      218        label "Стоп"
      219        size 10 by 1 tooltip "Остоновить процесс".
      220   define button B-viewProcInfo
      221        label "Информация"
      222        size 15 by 1 tooltip "Информация о процесс".
      223   define frame waitfram
      224     v-waitfram-action01 format "x(72)" no-label skip
      225     v-waitfram-action02 format "x(72)" no-label skip
      226     v-waitfram-action03 format "x(72)" no-label skip
      227     B-viewProcInfo
      228     B-WaitFramStop at row 4 col 30
      229     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      230     .
      231   define new global shared variable mBatchMode as logical no-undo init ?.
      232   define variable mFramBachModHandle as handle no-undo.
      233   mFramBachModHandle = frame waitfram:handle.
      234   define variable mFameOldVis as logical no-undo.
      235   define variable mVisCUrentVin as logical no-undo.
      236   if session:batch-mode
      237   then
      238      mBatchMode = yes.
      239   if mBatchMode = ? then do:
      240     mVisCUrentVin = current-window:visible.
      241     mFameOldVis = mFramBachModHandle:visible.
      242     mFramBachModHandle:visible  = yes.
      243     mBatchMode = mFramBachModHandle:visible ne yes.
      244     mFramBachModHandle:visible = mFameOldVis.
      245     current-window:visible = mVisCUrentVin.
      246   end.
      247    if  log-manager:logfile-name ne ?
      248     then DO:
      249         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      250         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      251         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      252     end.
      253   on choose of B-WaitFramStop in frame waitfram
      254   do:
      255     mWaitFramStop = yes.
      256     mWaitFramStopUser = yes.
      257   end.
      258   function waitfram-check-timeout returns logical():
      259      define variable vtime as int64 no-undo.
      260      if mWaitFramStopTimeOut
      261      then
      262         return yes.
      263      vtime = ( now - mWaitFramStartProc ) / 1000 .
      264      if     mWaitFramTimeOut ne ?
      265         and mWaitFramTimeOut ne 0
      266         and mWaitFramTimeOut lt vtime
      267      then do:
      268         mWaitFramStopTimeOut = yes.
      269      end.
      270      return mWaitFramStopTimeOut.
      271   end.
      272   procedure waitfram-hide :
      273     if not session:batch-mode
      274     then do
      275     on error undo, return error return-value
      276     :
      277       pause 0 before-hide .
      278       if not mBatchMode then
      279         hide frame waitfram .
      280     if     not mWaitFramView
      281        and mWaitProcEvent
      282     then
      283       process events .
      284     end.
      285   end procedure.
      286   procedure waitfram-show :
      287     define input  parameter p-message as character no-undo .
      288     define variable v-left-margin as integer   no-undo .
      289     if not session:batch-mode
      290     then do
      291     on error undo, return error return-value
      292     :
      293       if length(p-message) <= 70 then do:
      294         assign
      295           v-left-margin = integer((70 - length(p-message)) / 2)
      296         .
      297         assign
      298           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      299         .
      300         assign
      301           v-waitfram-action01 = " "
      302           v-waitfram-action02 = " "
      303                                    + fill(" ", v-left-margin)
      304                                    + p-message
      305           v-waitfram-action03 = " "
      306         .
      307       end.
      308       else do:
      309         define variable vRindex1 as integer no-undo.
      310         define variable vRindex2 as integer no-undo.
      311         vRindex1 = r-index(p-message," ",70).
      312         if vRindex1 = 0
      313         then
      314            vRindex1 = 70.
      315         if length(p-message)  <= vRindex1 + 70 then do:
      316           assign
      317             v-waitfram-action01 = " "
      318             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      319             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      320           .
      321         end.
      322         else do:
      323           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      324           if vRindex2 <= vRindex1
      325           then
      326              vRindex2 = vRindex1 + 70.
      327           assign
      328             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      329             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      330             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      331           .
      332         end.
      333       end.
      334       B-viewProcInfo:visible   in frame waitfram = no.
      335       B-viewProcInfo:sensitive in frame waitfram = no.
      336       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      337       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      338       if  (   mWaitFramView
      339          or  mWaitProcEvent)
      340          and not mBatchMode
      341       then
      342          display
      343             v-waitfram-action01 skip
      344             v-waitfram-action02 skip
      345             v-waitfram-action03 skip
      346          with frame waitfram .
      347       if     mWaitFramView
      348          then do:
      349             if     mWaitFramInterval ne ?
      350                and not mBatchMode
      351             then
      352                wait-for go of frame waitfram pause mWaitFramInterval.
      353          end.
      354          else
      355             if     mWaitProcEvent
      356                and not mBatchMode
      357             then
      358                process events .
      359     end.
      360   end procedure.
      361      procedure waitfram-show-this:
      362         define input  parameter iInterval as int64 no-undo.
      363         define variable vtime as int64 no-undo.
      364         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      365         mWaitFramInterval = iInterval.
      366         run waitfram-show (substitute("&1&2 &3&4" ,
      367                                       mWaitFramTextBeg ,
      368                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      369                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      370                                       mWaitFramTextEnd
      371                                      )
      372                           ).
      373      end.
      374      procedure WaitFramRunPause:
      375         define input  parameter iInterval as dec no-undo.
      376         define variable vStart  as datetime-tz no-undo.
      377         define variable vend    as datetime-tz no-undo.
      378         define variable vint as int64 no-undo.
      379         define variable vOk as logical no-undo.
      380         vStart = now.
      381         vend   = vStart.
      382         publish "WaitFramPause" (iInterval,output vOk).
      383         vend   =  now.
      384         vint = vend - vStart.
      385         vint = iInterval - vint / 1000.
      386         if     not mWaitFramStop
      387            and (   vint > 0
      388                 or (    not vOk
      389                     and iInterval eq ?
      390                     )
      391                 )
      392         then
      393            run waitfram-show-this (iInterval).
      394         vend   =  now.
      395         vint = vend - vStart.
      396         vint = iInterval - vint / 1000.
      397         if     not mWaitFramStop
      398            and vint > 0
      399         then do:
      400            run gbl/pause.p (vint * 1000).
      401         end.
      402         if iInterval ne ?
      403         then
      404            publish "WaitFramStop".
      405         waitfram-check-timeout().
      406      end.
      407      procedure WaitFramWaitFor:
      408         define input  parameter iInterval as dec no-undo.
      409         assign
      410            mWaitFramStartProc   = now
      411            mWaitFramStopUser    = no
      412            mWaitFramStopTimeOut = no
      413         .
      414         block-wait:
      415         do while not mWaitFramStop:
      416            run WaitFramRunPause (iInterval).
      417            if  waitfram-check-timeout()
      418            then do:
      419               leave block-wait.
      420            end.
      421         end.
      422         run waitfram-hide.
      423      end.
      424   procedure waitfram-join :
      425     define input  parameter p-line-1  as character no-undo .
      426     define input  parameter p-line-2  as character no-undo .
      427     define input  parameter p-line-3  as character no-undo .
      428     define output parameter p-message as character no-undo .
      429     do
      430     on error undo, return error return-value
      431     :
      432       assign
      433         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      434                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      435                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      436       .
      437     end.
      438   end procedure.
      439   function waitfram-join-function returns character
      440     (input p-line-1 as character
      441     ,input p-line-2 as character
      442     ,input p-line-3 as character
      443     ).
      444     define variable v-message as character no-undo .
      445     run waitfram-join in this-procedure
      446       (input  p-line-1
      447       ,input  p-line-2
      448       ,input  p-line-3
      449       ,output v-message
      450       ) .
      451     return v-message .
      452   end function .
      453   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      454   define variable v-fltopend-rowid as rowid extent 18 no-undo .
      455   procedure fltopend_fltopend :
      456   define input parameter p-parent-handle as handle no-undo .
      457   define input parameter p-qh as handle no-undo .
      458   define input parameter p-flt-open-open-query  as character no-undo .
      459   define input parameter p-where-cond as character no-undo .
      460   define input parameter p-use-indFIRST-query-tail as character no-undo .
      461   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      462   define input parameter p-indexed-reposition as character no-undo .
      463     do
      464     on error undo, return error
      465     :
      466   define variable v-prepare-string as character no-undo .
      467   define variable glog as logical no-undo .
      468   assign
      469   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      470                      p-where-cond + chr(32)  +
      471                      p-use-indFIRST-query-tail + chr(32) +
      472                      p-use-ind-sort-clmn-by + chr(32) +
      473                      p-indexed-reposition
      474   .
      475   assign
      476   glog = p-qh:query-prepare(v-prepare-string) no-error .
      477   if not glog
      478   or error-status:error then do:
      479     message error-status:get-message(1) view-as alert-box .
      480     undo, return error .
      481   end.
      482   assign
      483   glog = p-qh:query-open no-error .
      484   if not glog
      485   or error-status:error then do:
      486     message error-status:get-message(1) view-as alert-box .
      487     undo, return error .
      488   end.
      489     end.
      490   end procedure.
      491   procedure fltopend_fltfindd :
      492   define input parameter p-parent-handle as handle no-undo .
      493   define input parameter p-qh as handle no-undo .
      494   define input parameter p-rowid as rowid no-undo .
      495   define input parameter p-next as logical no-undo .
      496   define input parameter p-lock as integer no-undo .
      497   define input parameter p-bh as handle no-undo .
      498   define input parameter p-where-cond as character no-undo .
      499   define input parameter p-use-index-phrase as character no-undo .
      500   define variable glog as logical no-undo .
      501   define variable v-qh as handle no-undo .
      502   define variable v-bh as handle no-undo .
      503   define variable v-recid as recid no-undo .
      504   define variable v-prepare-string as character no-undo .
      505   do
      506   on error undo, return error
      507   on stop undo, return error
      508   :
      509     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
      510     create buffer v-bh for table p-bh buffer-name p-bh:name.
      511     create query v-qh.
      512     v-qh:set-buffers(v-bh).
      513     v-prepare-string = substitute("for each &1 &2 &3"
      514                                     ,v-bh:name
      515                                     ,p-where-cond
      516                                     ,p-use-index-phrase).
      517     glog = v-qh:query-prepare(v-prepare-string) no-error.
      518     if not glog then do:
      519       delete object v-qh.
      520       delete object v-bh.
      521       undo, return error .
      522     end.
      523     glog = v-qh:query-open no-error .
      524     if not glog then do:
      525       delete object v-qh.
      526       delete object v-bh.
      527       undo, return error .
      528     end.
      529     if p-next then do:
      530       v-qh:reposition-to-rowid(p-rowid) no-error .
      531       glog = v-qh:get-next( p-lock) no-error .
      532       glog = v-qh:get-next( p-lock) no-error .
      533       if not glog or v-qh:query-off-end = yes then do:
      534         glog = v-qh:get-first( p-lock) no-error .
      535       end.
      536     end.
      537     else do:
      538       glog = v-qh:get-first( p-lock) no-error .
      539     end.
      540     v-recid = v-bh:recid no-error .
      541     delete object v-qh.
      542     delete object v-bh.
      543     return string(v-recid) .
      544   end.
      545   end procedure.
      546   procedure fltopend_fltfindq :
      547   define input parameter p-parent-handle as handle no-undo .
      548   define input parameter p-qh as handle no-undo .
      549   define input parameter p-next as logical no-undo .
      550   define input parameter p-lock as integer no-undo .
      551   define input parameter p-flt-open-open-query  as character no-undo .
      552   define input parameter p-where-cond as character no-undo .
      553   define input parameter p-use-indFIRST-query-tail as character no-undo .
      554   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      555   define input parameter p-indexed-reposition as character no-undo .
      556   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
      557   define variable glog as logical no-undo .
      558   define variable v-qh as handle no-undo .
      559   define variable v-bh as handle no-undo extent 18.
      560   define variable v-rowid as rowid no-undo extent 18.
      561   define variable v-ii as integer no-undo .
      562   define variable v-prepare-string as character no-undo .
      563   do
      564   on error undo, return error
      565   on stop undo, return error
      566   :
      567     create query v-qh.
      568     do v-ii = 1 to p-qh:num-buffers:
      569       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
      570       assign
      571       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
      572       no-error.
      573       v-qh:add-buffer(v-bh[v-ii]).
      574     end.
      575     assign
      576     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      577                       p-where-cond + chr(32)  +
      578                       p-use-indFIRST-query-tail + chr(32) +
      579                       p-use-ind-sort-clmn-by + chr(32) +
      580                       p-indexed-reposition
      581     .
      582     glog = v-qh:query-prepare( v-prepare-string) no-error .
      583     if not glog then do:
      584       delete object v-qh.
      585       do v-ii = 1 to p-qh:num-buffers:
      586         delete object v-bh[v-ii].
      587       end.
      588       undo, return error .
      589     end.
      590     glog = v-qh:query-open no-error .
      591     if not glog then do:
      592       delete object v-qh.
      593       do v-ii = 1 to p-qh:num-buffers:
      594         delete object v-bh[v-ii].
      595       end.
      596       undo, return error .
      597     end.
      598     if p-next then do:
      599       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
      600       glog = v-qh:get-next( p-lock) no-error .
      601       glog = v-qh:get-next( p-lock) no-error .
      602       if not glog or v-qh:query-off-end = yes then do:
      603         glog = v-qh:get-first( p-lock) no-error .
      604       end.
      605     end.
      606     else do:
      607       glog = v-qh:get-first( p-lock) no-error .
      608     end.
      609     do v-ii = 1 to p-qh:num-buffers:
      610       assign
      611       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
      612       no-error.
      613     end.
      614     delete object v-qh.
      615     do v-ii = 1 to p-qh:num-buffers:
      616       delete object v-bh[v-ii].
      617     end.
      618   end.
      619   end procedure.
      620   define variable gds-rec as recid no-undo .
      621   DEFINE TEMP-TABLE tt-units no-undo
      622   LIKE ub.units
      623   .
      624   define variable v-rid-list as character no-undo .
      625   DEFINE BUFFER t-units for tt-units.
      626   define variable filter-label as character no-undo init "Товары по индивидуальному налогу" .
      627   define variable filter-label0 as character no-undo init "Товары по индивидуальному налогу" .
      628   define variable filter-point as character no-undo init "taxigds".
      629   define variable filter-point0 as character no-undo init "taxigds".
      630   DEFINE BUTTON B-Help
      631        LABEL "Помо&щь"
      632        SIZE 3 BY 1
      633        BGCOLOR 8 .
      634   DEFINE BUTTON B-quit AUTO-END-KEY
      635        LABEL "&Выход "
      636        SIZE 10 BY 1
      637        BGCOLOR 8 .
      638   DEFINE BUTTON B-sch
      639        LABEL "&Фильтр"
      640        SIZE 3 BY 1.
      641   DEFINE BUTTON B-sel AUTO-GO
      642        LABEL "Вы&бор "
      643        SIZE 10 BY 1.
      644   DEFINE QUERY BR-tax-rate-gds FOR
      645         t-units,
      646         X_goods SCROLLING.
      647   DEFINE BROWSE BR-tax-rate-gds
      648     QUERY BR-tax-rate-gds NO-LOCK DISPLAY
      649         X_goods.gds-code
      650   X_goods.artic
      651   X_goods.prod-type
      652   X_goods.prod-code
      653   X_goods.gds-name
      654   t-units.unit-name column-label "Ед.!изм"
      655       WITH NO-ROW-MARKERS SEPARATORS SIZE 97.63 BY 19.92.
      656   DEFINE FRAME Dialog-Frame
      657        B-quit AT ROW 1 COL 1
      658        B-sel AT ROW 1 COL 11
      659        B-sch AT ROW 1 COL 92
      660        B-Help AT ROW 1 COL 95
      661        BR-tax-rate-gds AT ROW 3 COL 1
      662        SPACE(0.06) SKIP(0.01)
      663       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      664            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      665            TITLE "Товары, привязанные к индивидуальному налогу с кодом"
      666            DEFAULT-BUTTON B-quit.
      667   ASSIGN
      668          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      669          FRAME Dialog-Frame:HIDDEN           = TRUE.
      670   ON GO OF FRAME Dialog-Frame
      671   DO:
      672     p-rid-list = v-rid-list.
      673   END.
      674   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      675   DO:
      676     APPLY "END-ERROR":U TO SELF.
      677   END.
      678   ON CHOOSE OF B-sch IN FRAME Dialog-Frame
      679   DO:
      680     run proc-b-sch no-error.
      681     if error-status:error then return no-apply.
      682   END.
      683   ON CHOOSE OF B-sel IN FRAME Dialog-Frame
      684   DO:
      685     v-rid-list = STRING(RECID(X_goods)).
      686   END.
      687   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      688   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      689   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      690   on help of frame Dialog-Frame
      691   do:
      692     run gbl/app_help.p
      693       (input this-procedure :file-name
      694       ,input ''
      695       ,input ?
      696       ) no-error.
      697     if error-status :error then do:
      698       message
      699         "Ошибка при вызове помощи"
      700         error-status :get-message(1)
      701         view-as alert-box .
      702     end.
      703   end.
      704   run minbtn-set in this-procedure .
      705   on choose of b-help in frame Dialog-Frame
      706   do:
      707     apply "help":u to frame Dialog-Frame .
      708   end.
      709   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      710   procedure minbtn-set :
      711       do
      712           on error undo, return error return-value
      713           :
      714           define variable ii              as integer       no-undo .
      715           define variable fh              as widget-handle no-undo .
      716           define variable hh              as widget-handle no-undo .
      717           define variable v-h             as handle        extent 4 no-undo .
      718           define variable v-name-button   as character     no-undo .
      719           define variable v-help-old-x    as decimal       no-undo .
      720           define variable v-help-old-y    as decimal       no-undo .
      721           define variable v-help-old-size as decimal       no-undo .
      722           define variable v-frame-width   as decimal       no-undo .
      723           define variable jj              as integer       no-undo .
      724           do
      725               on error undo, return error
      726               :
      727               assign
      728                   v-frame-width = frame Dialog-Frame:width - 0.3
      729                   fh            = frame Dialog-Frame:first-child
      730                   hh            = fh:first-child
      731                   ii            = 1
      732                   .
      733               do while valid-handle(hh):
      734                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      735                   do:
      736                       case lc(hh:name) :
      737                           when "b-help" then
      738                               do:
      739                                   hh:load-image-up("cmp/b-help.bmp":u) .
      740                                   hh:load-image-down("cmp/b-help.bmp":u) .
      741                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      742                                   hh:TOOLTIP = "Помощь" .
      743                                   v-help-old-x = hh:column .
      744                                   v-help-old-y = hh:row    .
      745                                   v-help-old-size = hh:width .
      746                                   hh:width-chars = 2.5 .
      747                               end.
      748                           when "b-print" then
      749                               do:
      750                                   hh:load-image("cmp/b-print.bmp":u) .
      751                                   hh:TOOLTIP = "Печать" .
      752                                   v-h[ii] = hh:handle .
      753                                   ii = ii + 1 .
      754                                   hh:width-chars = 3 .
      755                               end.
      756                           when "b-history" or
      757                           when "b-hist" then
      758                               do:
      759                                   hh:load-image("cmp/b-hist.bmp":u) .
      760                                   hh:TOOLTIP = "История" .
      761                                   v-h[ii] = hh:handle .
      762                                   ii = ii + 1 .
      763                                   hh:width-chars = 3 .
      764                               end.
      765                           when "b-sch" then
      766                               do:
      767                                   hh:load-image("cmp/b-sch.bmp":u) .
      768                                   hh:TOOLTIP = "Установка Фильтра" .
      769                                   v-h[ii] = hh:handle .
      770                                   ii = ii + 1 .
      771                                   hh:width-chars = 3 .
      772                               end.
      773                           when "b-hist-user" then
      774                               do:
      775                                   hh:load-image("cmp/b-hist.bmp":u) .
      776                                   hh:TOOLTIP = "История пользователя" .
      777                                   ii = ii + 1 .
      778                               end.
      779                       end case.
      780                   end.
      781                   hh = hh:next-sibling.
      782               end.
      783               b-help:column = v-frame-width - b-help:width-chars.
      784               jj = 0.
      785               repeat ii = 4 to 1 by -1 :
      786                   if valid-handle (v-h[ii] ) then
      787                   do:
      788                       jj  = jj + 1 .
      789                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      790                       v-h[ii]:row    = v-help-old-y .
      791                   end.
      792               end.
      793           end.
      794       end.
      795   end procedure.
      796   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      797   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      798   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      799   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      800   define variable v-diasize-current-frame-width  as decimal   no-undo .
      801   define variable v-diasize-current-frame-height as decimal   no-undo .
      802   define variable v-diasize-change-size          as logical   no-undo .
      803   define variable v-diasize-resize-button        as handle    no-undo .
      804   define variable v-diasize-wndmax               as logical   no-undo .
      805   define variable v-diasize-wndstore             as logical   no-undo .
      806   define variable v-diasize-proc-name            as character no-undo .
      807   define variable v-diasize-browse-handle        as handle    no-undo .
      808   define variable v-diasize-browse-number        as integer   no-undo .
      809   define variable v-diasize-need-full-display    as logical   no-undo init false .
      810   define temp-table temp-diasize-handle no-undo
      811     field handle-value  as handle
      812     field save-position as decimal
      813     index xpk is primary unique handle-value
      814     .
      815   define temp-table temp-browse-handle no-undo
      816     field browse-type   as character
      817     field browse-number as integer
      818     field browse-handle as handle
      819     field original-size as decimal
      820     index xpk is primary unique browse-type browse-number
      821     index xie browse-type browse-handle
      822   .
      823   procedure diasize_change-height :
      824     define input  parameter p-change-value  as decimal   no-undo .
      825     define input  parameter p-move-resize   as logical   no-undo .
      826     define variable v-field-group-handle    as handle    no-undo .
      827     define variable v-object-handle         as handle    no-undo .
      828     define variable v-frame-height          as decimal   no-undo .
      829     define variable v-frame-virtual-height  as decimal   no-undo .
      830     define variable v-browse-height         as decimal   no-undo .
      831     define variable v-window-height         as decimal   no-undo .
      832     define variable v-window-virtual-height as decimal   no-undo .
      833     define variable v-change-sign           as integer   no-undo .
      834     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      835     define buffer buf_temp-browse-handle  for temp-browse-handle .
      836     if p-change-value > 0
      837     then do:
      838       if frame Dialog-Frame :height + p-change-value
      839           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      840       then do:
      841         assign
      842           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      843                           - (frame Dialog-Frame :height-chars)
      844         .
      845         if p-change-value <= 0
      846         then do:
      847           run diasize_position-resize-button in this-procedure .
      848           return .
      849         end.
      850       end.
      851     end.
      852     if p-change-value < 0
      853     then do:
      854       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      855       then do:
      856         assign
      857           p-change-value = v-diasize-orig-frame-height
      858                          - (frame Dialog-Frame :height-chars)
      859         .
      860         if p-change-value >= 0
      861         then do:
      862           run diasize_position-resize-button in this-procedure .
      863           return .
      864         end.
      865       end.
      866     end.
      867     if p-change-value >= 0
      868     then do:
      869       assign
      870         v-change-sign = 1
      871       .
      872     end.
      873     else do:
      874       assign
      875         v-change-sign = -1
      876       .
      877     end.
      878     assign
      879       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      880     .
      881     if p-change-value = 0
      882     then do:
      883       run diasize_position-resize-button in this-procedure .
      884       return .
      885     end.
      886     move_block:
      887     do
      888     on error undo move_block, retry move_block
      889     :
      890       if retry
      891       then do:
      892         do
      893         on error undo move_block, leave move_block
      894         :
      895           if p-change-value > 0
      896           then do:
      897             for each buf_temp-diasize-handle
      898             on error undo, next
      899             :
      900               assign
      901                 v-object-handle = buf_temp-diasize-handle.handle-value
      902               .
      903               if v-object-handle <> v-diasize-resize-button
      904               then do:
      905                 assign
      906                   v-object-handle :row = buf_temp-diasize-handle.save-position
      907                 .
      908               end.
      909             end.
      910             assign
      911               v-diasize-browse-handle :height = v-browse-height
      912             .
      913             for each buf_temp-browse-handle
      914               where buf_temp-browse-handle.browse-type = 'height':u
      915             on error undo, next
      916             :
      917               assign
      918                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      919               .
      920             end.
      921             assign
      922               frame Dialog-Frame :height = v-frame-height
      923             .
      924             if frame Dialog-Frame :scrollable = true
      925             then do:
      926               assign
      927                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      928               .
      929             end.
      930             run diasize_position-resize-button in this-procedure .
      931           end.
      932           else do:
      933             if frame Dialog-Frame :scrollable = true
      934             then do:
      935               assign
      936                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      937               .
      938             end.
      939             assign
      940               frame Dialog-Frame :height = v-frame-height
      941             .
      942             assign
      943               v-diasize-browse-handle :height = v-browse-height
      944             .
      945             for each buf_temp-browse-handle
      946               where buf_temp-browse-handle.browse-type = 'height':u
      947             on error undo, next
      948             :
      949               assign
      950                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      951               .
      952             end.
      953             for each buf_temp-diasize-handle
      954             on error undo, next
      955             :
      956               assign
      957                 v-object-handle = buf_temp-diasize-handle.handle-value
      958               .
      959               if v-object-handle <> v-diasize-resize-button
      960               then do:
      961                 assign
      962                   v-object-handle :row = buf_temp-diasize-handle.save-position
      963                 .
      964               end.
      965             end.
      966             run diasize_position-resize-button in this-procedure .
      967           end.
      968           assign
      969             v-diasize-change-size = false
      970           .
      971           leave move_block .
      972         end.
      973       end.
      974       assign
      975         v-diasize-need-full-display = true
      976       .
      977       if v-diasize-change-size = false
      978       then do:
      979         assign
      980           v-diasize-change-size = true
      981         .
      982       end.
      983       else do:
      984         return .
      985       end.
      986       assign
      987         v-frame-height = frame Dialog-Frame :height
      988         v-frame-virtual-height = frame Dialog-Frame :virtual-height
      989         v-browse-height = v-diasize-browse-handle :height
      990       .
      991       for each buf_temp-browse-handle
      992         where buf_temp-browse-handle.browse-type = 'height':u
      993       :
      994         assign
      995           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
      996         .
      997       end.
      998       for each buf_temp-diasize-handle
      999       :
     1000         delete buf_temp-diasize-handle .
     1001       end.
     1002       assign
     1003         v-field-group-handle = frame Dialog-Frame :first-child
     1004       .
     1005       do while valid-handle(v-field-group-handle)
     1006       :
     1007         assign
     1008           v-object-handle = v-field-group-handle :first-child
     1009         .
     1010         do while valid-handle(v-object-handle)
     1011         :
     1012           if  v-object-handle <> v-diasize-browse-handle :handle
     1013           and can-query(v-object-handle, "row")
     1014           and can-query(v-object-handle, "height")
     1015           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1016           then do:
     1017             find first buf_temp-browse-handle
     1018               where buf_temp-browse-handle.browse-type   = 'height':u
     1019                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1020               no-error .
     1021             if available buf_temp-browse-handle
     1022             then do:
     1023             end.
     1024             else do:
     1025               create buf_temp-diasize-handle .
     1026               assign
     1027                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1028                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1029               .
     1030             end.
     1031           end.
     1032           assign
     1033             v-object-handle = v-object-handle :next-sibling
     1034           .
     1035         end.
     1036         assign
     1037           v-field-group-handle = v-field-group-handle :next-sibling
     1038         .
     1039       end.
     1040       do with frame Dialog-Frame
     1041       :
     1042         hide v-diasize-resize-button .
     1043         assign
     1044           v-diasize-resize-button :row    = 1
     1045           v-diasize-resize-button :column = 1
     1046         .
     1047       end.
     1048       if p-change-value > 0
     1049       then do:
     1050         if frame Dialog-Frame :scrollable = true
     1051         then do:
     1052           assign
     1053             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1054             no-error .
     1055           if error-status :error
     1056           or error-status :get-message(1) <> ""
     1057           then do:
     1058             undo move_block, retry move_block .
     1059           end.
     1060         end.
     1061         assign
     1062           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1063           no-error .
     1064         if error-status :error
     1065         or error-status :get-message(1) <> ""
     1066         then do:
     1067           undo move_block, retry move_block .
     1068         end.
     1069         assign
     1070           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1071           no-error .
     1072         if error-status :error
     1073         or error-status :get-message(1) <> ""
     1074         then do:
     1075           undo move_block, retry move_block .
     1076         end.
     1077         for each buf_temp-browse-handle
     1078           where buf_temp-browse-handle.browse-type = 'height':u
     1079         on error undo move_block, retry move_block
     1080         :
     1081           assign
     1082             buf_temp-browse-handle.browse-handle :height
     1083               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1084             no-error .
     1085           if error-status :error
     1086           or error-status :get-message(1) <> ""
     1087           then do:
     1088             undo move_block, retry move_block .
     1089           end.
     1090         end.
     1091         for each buf_temp-diasize-handle
     1092         on error undo move_block, retry move_block
     1093         :
     1094           assign
     1095             v-object-handle = buf_temp-diasize-handle.handle-value
     1096           .
     1097           if v-object-handle <> v-diasize-resize-button
     1098           then do:
     1099             assign
     1100               v-object-handle :row = v-object-handle :row + p-change-value
     1101               no-error .
     1102             if error-status :error
     1103             or error-status :get-message(1) <> ""
     1104             then do:
     1105               undo move_block, retry move_block .
     1106             end.
     1107           end.
     1108         end.
     1109       end.
     1110       else do:
     1111         for each buf_temp-diasize-handle
     1112         on error undo move_block, retry move_block
     1113         :
     1114           assign
     1115             v-object-handle = buf_temp-diasize-handle.handle-value
     1116           .
     1117           if v-object-handle <> v-diasize-resize-button
     1118           then do:
     1119             assign
     1120               v-object-handle :row = v-object-handle :row + p-change-value
     1121               no-error .
     1122             if error-status :error
     1123             or error-status :get-message(1) <> ""
     1124             then do:
     1125               undo move_block, retry move_block .
     1126             end.
     1127           end.
     1128         end.
     1129         assign
     1130           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1131           no-error .
     1132         if error-status :error
     1133         or error-status :get-message(1) <> ""
     1134         then do:
     1135           undo move_block, retry move_block .
     1136         end.
     1137         for each buf_temp-browse-handle
     1138           where buf_temp-browse-handle.browse-type = 'height':u
     1139         on error undo move_block, retry move_block
     1140         :
     1141           assign
     1142             buf_temp-browse-handle.browse-handle :height
     1143               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1144             no-error .
     1145           if error-status :error
     1146           or error-status :get-message(1) <> ""
     1147           then do:
     1148             undo move_block, retry move_block .
     1149           end.
     1150         end.
     1151         assign
     1152           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1153           no-error .
     1154         if error-status :error
     1155         or error-status :get-message(1) <> ""
     1156         then do:
     1157           undo move_block, retry move_block .
     1158         end.
     1159         if frame Dialog-Frame :scrollable = true
     1160         then do:
     1161           assign
     1162             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1163             no-error .
     1164           if error-status :error
     1165           or error-status :get-message(1) <> ""
     1166           then do:
     1167             undo move_block, retry move_block .
     1168           end.
     1169         end.
     1170       end.
     1171       if p-move-resize = true
     1172       then do:
     1173         run diasize_position-resize-button in this-procedure .
     1174       end.
     1175       if v-diasize-wndstore = true
     1176       then do:
     1177         if connected("ub") = true
     1178         then do:
     1179           define variable v-cntxt-db-num        as integer   no-undo .
     1180           define variable v-cntxt-userid        as character no-undo .
     1181           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1182                                             , OUTPUT v-cntxt-userid
     1183                                             ) .
     1184           run gbl/wndsizew.p
     1185             (input  v-cntxt-db-num
     1186             ,input  v-cntxt-userid
     1187             ,input  v-diasize-proc-name
     1188             ,input  'height':u
     1189             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1190             ) .
     1191         end.
     1192       end.
     1193     end.
     1194     assign
     1195       v-diasize-change-size = false
     1196     .
     1197   end procedure.
     1198   procedure diasize_set-height :
     1199     define input  parameter p-new-height  as decimal   no-undo .
     1200     define input  parameter p-move-resize as logical   no-undo .
     1201     do
     1202     on error undo, return error return-value
     1203     :
     1204       run diasize_change-height in this-procedure
     1205         (input  (p-new-height - frame Dialog-Frame :height)
     1206         ,input  p-move-resize
     1207         ) .
     1208     end.
     1209   end procedure.
     1210   procedure diasize_change-width :
     1211     define input  parameter p-change-value as decimal   no-undo .
     1212     define input  parameter p-move-resize  as logical   no-undo .
     1213     define variable v-field-group-handle   as handle    no-undo .
     1214     define variable v-object-handle        as handle    no-undo .
     1215     define variable v-frame-width          as decimal   no-undo .
     1216     define variable v-frame-virtual-width  as decimal   no-undo .
     1217     define variable v-browse-width         as decimal   no-undo .
     1218     define variable v-window-width         as decimal   no-undo .
     1219     define variable v-window-virtual-width as decimal   no-undo .
     1220     define variable v-change-sign          as integer   no-undo .
     1221     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1222     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1223     if p-change-value > 0
     1224     then do:
     1225       if frame Dialog-Frame :width + p-change-value >
     1226           session :width-chars
     1227       then do:
     1228         assign
     1229           p-change-value = session :width-chars - frame Dialog-Frame :width
     1230         .
     1231         if p-change-value <= 0
     1232         then do:
     1233           run diasize_position-resize-button in this-procedure .
     1234           return .
     1235         end.
     1236       end.
     1237     end.
     1238     if p-change-value < 0
     1239     then do:
     1240       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1241       then do:
     1242         assign
     1243           p-change-value = v-diasize-orig-frame-width
     1244                          - frame Dialog-Frame :width
     1245         .
     1246         if p-change-value >= 0
     1247         then do:
     1248           run diasize_position-resize-button in this-procedure .
     1249           return .
     1250         end.
     1251       end.
     1252     end.
     1253     if p-change-value >= 0
     1254     then do:
     1255       assign
     1256         v-change-sign = 1
     1257       .
     1258     end.
     1259     else do:
     1260       assign
     1261         v-change-sign = -1
     1262       .
     1263     end.
     1264     assign
     1265       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1266     .
     1267     if p-change-value = 0
     1268     then do:
     1269       run diasize_position-resize-button in this-procedure .
     1270       return .
     1271     end.
     1272     move_block:
     1273     do
     1274     on error undo move_block, leave move_block
     1275     :
     1276       if retry
     1277       then do:
     1278         do
     1279         on error undo move_block, leave move_block
     1280         :
     1281           if p-change-value > 0
     1282           then do:
     1283             for each buf_temp-diasize-handle
     1284             on error undo, next
     1285             :
     1286               assign
     1287                 v-object-handle = buf_temp-diasize-handle.handle-value
     1288               .
     1289               if v-object-handle <> v-diasize-resize-button
     1290               then do:
     1291                 assign
     1292                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1293                 .
     1294               end.
     1295             end.
     1296             assign
     1297               v-diasize-browse-handle :width = v-browse-width
     1298             .
     1299             for each buf_temp-browse-handle
     1300               where buf_temp-browse-handle.browse-type = 'width':u
     1301             on error undo, next
     1302             :
     1303               assign
     1304                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1305               .
     1306             end.
     1307             assign
     1308               frame Dialog-Frame :width = v-frame-width
     1309             .
     1310             if frame Dialog-Frame :scrollable = true
     1311             then do:
     1312               assign
     1313                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1314               .
     1315             end.
     1316             run diasize_position-resize-button in this-procedure .
     1317           end.
     1318           else do:
     1319             if frame Dialog-Frame :scrollable = true
     1320             then do:
     1321               assign
     1322                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1323               .
     1324             end.
     1325             assign
     1326               frame Dialog-Frame :width = v-frame-width
     1327             .
     1328             for each buf_temp-browse-handle
     1329               where buf_temp-browse-handle.browse-type = 'width':u
     1330             on error undo, next
     1331             :
     1332               assign
     1333                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1334               .
     1335             end.
     1336             assign
     1337               v-diasize-browse-handle :width = v-browse-width
     1338             .
     1339             for each buf_temp-diasize-handle
     1340             on error undo, next
     1341             :
     1342               assign
     1343                 v-object-handle = buf_temp-diasize-handle.handle-value
     1344               .
     1345               if v-object-handle <> v-diasize-resize-button
     1346               then do:
     1347                 assign
     1348                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1349                 .
     1350               end.
     1351             end.
     1352             run diasize_position-resize-button in this-procedure .
     1353           end.
     1354           assign
     1355             v-diasize-change-size = false
     1356           .
     1357           leave move_block .
     1358         end.
     1359       end.
     1360       assign
     1361         v-diasize-need-full-display = true
     1362       .
     1363       if v-diasize-change-size = false
     1364       then do:
     1365         assign
     1366           v-diasize-change-size = true
     1367         .
     1368       end.
     1369       else do:
     1370         return .
     1371       end.
     1372       assign
     1373         v-frame-width = frame Dialog-Frame :width
     1374         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1375         v-browse-width = v-diasize-browse-handle :width
     1376       .
     1377       for each buf_temp-browse-handle
     1378         where buf_temp-browse-handle.browse-type = 'width':u
     1379       :
     1380         assign
     1381           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1382         .
     1383       end.
     1384       for each buf_temp-diasize-handle
     1385       :
     1386         delete buf_temp-diasize-handle .
     1387       end.
     1388       assign
     1389         v-field-group-handle = frame Dialog-Frame :first-child
     1390       .
     1391       do while valid-handle(v-field-group-handle)
     1392       :
     1393         assign
     1394           v-object-handle = v-field-group-handle :first-child
     1395         .
     1396         do while valid-handle(v-object-handle)
     1397         :
     1398           if  v-object-handle <> v-diasize-browse-handle :handle
     1399           and v-object-handle <> v-diasize-resize-button
     1400           and can-query(v-object-handle, "row")
     1401           and can-query(v-object-handle, "height")
     1402           and ( v-object-handle :col + v-object-handle :width
     1403                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1404               )
     1405           then do:
     1406             find first buf_temp-browse-handle
     1407               where buf_temp-browse-handle.browse-type   = 'width':u
     1408                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1409               no-error .
     1410             if available buf_temp-browse-handle
     1411             then do:
     1412             end.
     1413             else do:
     1414               create buf_temp-diasize-handle .
     1415               assign
     1416                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1417                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1418               .
     1419             end.
     1420           end.
     1421           assign
     1422             v-object-handle = v-object-handle :next-sibling
     1423           .
     1424         end.
     1425         assign
     1426           v-field-group-handle = v-field-group-handle :next-sibling
     1427         .
     1428       end.
     1429       do with frame Dialog-Frame
     1430       :
     1431         hide v-diasize-resize-button .
     1432         v-diasize-resize-button :row = 1.
     1433         v-diasize-resize-button :column = 1.
     1434       end.
     1435       if p-change-value > 0
     1436       then do:
     1437         if frame Dialog-Frame :scrollable = true
     1438         then do:
     1439           assign
     1440             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1441             no-error .
     1442           if error-status :error
     1443           or error-status :get-message(1) <> ""
     1444           then do:
     1445             undo move_block, retry move_block.
     1446           end.
     1447         end.
     1448         assign
     1449           frame Dialog-Frame :width = v-frame-width + p-change-value
     1450           no-error .
     1451         if error-status :error
     1452         or error-status :get-message(1) <> ""
     1453         then do:
     1454           undo move_block, retry move_block.
     1455         end.
     1456         assign
     1457           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1458         no-error .
     1459         if error-status :error
     1460         or error-status :get-message(1) <> ""
     1461         then do:
     1462           undo move_block, retry move_block.
     1463         end.
     1464         for each buf_temp-browse-handle
     1465           where buf_temp-browse-handle.browse-type = 'width':u
     1466         on error undo move_block, retry move_block
     1467         :
     1468           assign
     1469             buf_temp-browse-handle.browse-handle :width
     1470               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1471             no-error .
     1472           if error-status :error
     1473           or error-status :get-message(1) <> ""
     1474           then do:
     1475             undo move_block, retry move_block .
     1476           end.
     1477         end.
     1478         for each buf_temp-diasize-handle
     1479         on error undo move_block, retry move_block
     1480         :
     1481           assign
     1482             v-object-handle = buf_temp-diasize-handle.handle-value
     1483           .
     1484           if v-object-handle <> v-diasize-resize-button
     1485           then do:
     1486             assign
     1487               v-object-handle :col = v-object-handle :col + p-change-value
     1488               no-error .
     1489             if error-status :error
     1490             or error-status :get-message(1) <> ""
     1491             then do:
     1492               undo move_block, retry move_block .
     1493             end.
     1494           end.
     1495         end.
     1496       end.
     1497       else do:
     1498         for each buf_temp-diasize-handle
     1499         on error undo move_block, retry move_block
     1500         :
     1501           assign
     1502             v-object-handle = buf_temp-diasize-handle.handle-value
     1503           .
     1504           if v-object-handle <> v-diasize-resize-button
     1505           then do:
     1506             assign
     1507               v-object-handle :col = v-object-handle :col + p-change-value
     1508               no-error .
     1509             if error-status :error
     1510             or error-status :get-message(1) <> ""
     1511             then do:
     1512               undo move_block, retry move_block .
     1513             end.
     1514           end.
     1515         end.
     1516         for each buf_temp-browse-handle
     1517           where buf_temp-browse-handle.browse-type = 'width':u
     1518         on error undo move_block, retry move_block
     1519         :
     1520           assign
     1521             buf_temp-browse-handle.browse-handle :width
     1522               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1523             no-error .
     1524           if error-status :error
     1525           or error-status :get-message(1) <> ""
     1526           then do:
     1527             undo move_block, retry move_block .
     1528           end.
     1529         end.
     1530         assign
     1531           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1532           no-error .
     1533         if error-status :error
     1534         or error-status :get-message(1) <> ""
     1535         then do:
     1536           undo move_block, retry move_block.
     1537         end.
     1538         assign
     1539           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1540         no-error .
     1541         if error-status :error
     1542         or error-status :get-message(1) <> ""
     1543         then do:
     1544           undo move_block, retry move_block.
     1545         end.
     1546         if frame Dialog-Frame :scrollable = true
     1547         then do:
     1548           assign
     1549             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1550           no-error .
     1551           if error-status :error
     1552           or error-status :get-message(1) <> ""
     1553           then do:
     1554             undo move_block, retry move_block.
     1555           end.
     1556         end.
     1557       end.
     1558       if p-move-resize
     1559       then do:
     1560         run diasize_position-resize-button in this-procedure .
     1561       end.
     1562       if v-diasize-wndstore = true
     1563       then do:
     1564         if connected("ub") = true
     1565         then do:
     1566           define variable v-cntxt-db-num        as integer   no-undo .
     1567           define variable v-cntxt-userid        as character no-undo .
     1568           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1569                                             , OUTPUT v-cntxt-userid
     1570                                             ) .
     1571           run gbl/wndsizew.p
     1572             (input  v-cntxt-db-num
     1573             ,input  v-cntxt-userid
     1574             ,input  v-diasize-proc-name
     1575             ,input  'width':u
     1576             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1577             ) .
     1578         end.
     1579       end.
     1580     end.
     1581     assign
     1582       v-diasize-change-size = false
     1583     .
     1584   end procedure.
     1585   procedure diasize_set-width :
     1586     define input  parameter p-new-width  as decimal   no-undo .
     1587     define input  parameter p-move-resize as logical   no-undo .
     1588     do
     1589     on error undo, return error return-value
     1590     :
     1591       run diasize_change-width in this-procedure
     1592         (input  (p-new-width - frame Dialog-Frame :width)
     1593         ,input  p-move-resize
     1594         ) .
     1595     end.
     1596   end procedure.
     1597   procedure diasize_position-resize-button :
     1598     do with frame Dialog-Frame
     1599     :
     1600       hide v-diasize-resize-button .
     1601       assign
     1602         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1603                     - 1
     1604                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1605         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1606                     - 1
     1607                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1608       .
     1609       view v-diasize-resize-button .
     1610     end.
     1611   end procedure.
     1612   on alt-right anywhere
     1613   do:
     1614     run diasize_change-width in this-procedure
     1615       (input 1
     1616       ,input true
     1617       ) .
     1618     return no-apply .
     1619   end.
     1620   on alt-left anywhere
     1621   do:
     1622     run diasize_change-width in this-procedure
     1623       (input -1
     1624       ,input true
     1625       ) .
     1626     return no-apply .
     1627   end.
     1628   on alt-down anywhere
     1629   do:
     1630     run diasize_change-height in this-procedure
     1631       (input 1
     1632       ,input true
     1633       ) .
     1634     return no-apply .
     1635   end.
     1636   on alt-up anywhere
     1637   do:
     1638     run diasize_change-height in this-procedure
     1639       (input -1
     1640       ,input true
     1641       ) .
     1642     return no-apply .
     1643   end.
     1644   on alt-enter of frame Dialog-Frame
     1645   do:
     1646     run diasize_maximize in this-procedure
     1647       (input  ?
     1648       ).
     1649     return no-apply .
     1650   end.
     1651   procedure diasize_end-move :
     1652     do
     1653     on error undo, return error return-value
     1654     :
     1655       define variable v-row-delta as decimal   no-undo .
     1656       define variable v-col-delta as decimal   no-undo .
     1657       define variable v-new-row as decimal   no-undo .
     1658       define variable v-new-col as decimal   no-undo .
     1659       assign
     1660         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1661         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1662       .
     1663       assign
     1664         v-row-delta = v-new-row - frame Dialog-Frame :height
     1665         v-col-delta = v-new-col - frame Dialog-Frame :width
     1666       .
     1667       run diasize_change-height in this-procedure
     1668         (input v-row-delta
     1669         ,input true
     1670         ) .
     1671       run diasize_change-width in this-procedure
     1672         (input v-col-delta
     1673         ,input true
     1674         ) .
     1675     end.
     1676   end procedure.
     1677   procedure diasize_maximize :
     1678     define input  parameter p-action as logical   no-undo .
     1679     do
     1680     on error undo, return error return-value
     1681     :
     1682       if p-action = ?
     1683       then do:
     1684         if v-diasize-need-maximize = true
     1685         then do:
     1686           assign
     1687             p-action = true
     1688           .
     1689         end.
     1690         else do:
     1691           assign
     1692             p-action = false
     1693           .
     1694         end.
     1695       end.
     1696       if p-action = true
     1697       then do:
     1698         run diasize_change-height in this-procedure
     1699           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1700               - frame Dialog-Frame :height-chars
     1701           ,input true
     1702           ) .
     1703         run diasize_change-width in this-procedure
     1704           (input session :width-chars
     1705               - frame Dialog-Frame :width-chars
     1706           ,input true
     1707           ) .
     1708         assign
     1709           v-diasize-need-maximize = false
     1710         .
     1711       end.
     1712       else do:
     1713         run diasize_change-width in this-procedure
     1714           (input v-diasize-orig-frame-width
     1715               - frame Dialog-Frame :width-chars
     1716           ,input true
     1717           ) .
     1718         run diasize_change-height in this-procedure
     1719           (input v-diasize-orig-frame-height
     1720               - frame Dialog-Frame :height-chars
     1721           ,input true
     1722           ) .
     1723         assign
     1724           v-diasize-need-maximize = true
     1725         .
     1726       end.
     1727     end.
     1728   end procedure.
     1729   procedure diasize_restore-orig-size :
     1730     do
     1731     on error undo, return error return-value
     1732     :
     1733       assign
     1734         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1735         v-diasize-current-frame-height = frame Dialog-Frame :height
     1736       .
     1737       run diasize_set-height in this-procedure
     1738         (input  v-diasize-orig-frame-height
     1739         ,input  true
     1740         ) .
     1741       run diasize_set-width in this-procedure
     1742         (input  v-diasize-orig-frame-width
     1743         ,input  true
     1744         ) .
     1745     end.
     1746   end procedure.
     1747   procedure diasize_restore-current-size :
     1748     do
     1749     on error undo, return error return-value
     1750     :
     1751       run diasize_set-height in this-procedure
     1752         (input  v-diasize-current-frame-height
     1753         ,input  true
     1754         ) .
     1755       run diasize_set-width in this-procedure
     1756         (input  v-diasize-current-frame-width
     1757         ,input  true
     1758         ) .
     1759     end.
     1760   end procedure.
     1761   procedure diasize_set-browse-handle :
     1762     define input  parameter p-browse-handle as handle   no-undo .
     1763     define buffer buf_temp-browse-handle for temp-browse-handle .
     1764     do
     1765     on error undo, return error return-value
     1766     :
     1767       assign
     1768         v-diasize-browse-handle = p-browse-handle
     1769       .
     1770       for each buf_temp-browse-handle
     1771       on error undo, return error return-value
     1772       :
     1773         delete buf_temp-browse-handle .
     1774       end.
     1775     end.
     1776   end procedure.
     1777   procedure diasize_add_browse :
     1778     define input  parameter p-browse-type   as character no-undo .
     1779     define input  parameter p-browse-handle as handle    no-undo .
     1780     define buffer buf_temp-browse-handle for temp-browse-handle .
     1781     do
     1782     on error undo, return error return-value
     1783     :
     1784       assign
     1785         v-diasize-browse-number = v-diasize-browse-number + 1
     1786       .
     1787       create buf_temp-browse-handle .
     1788       assign
     1789         buf_temp-browse-handle.browse-type   = p-browse-type
     1790         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1791         buf_temp-browse-handle.browse-handle = p-browse-handle
     1792       .
     1793     end.
     1794   end procedure.
     1795   procedure diasize_init :
     1796     define variable v-default-value    as logical   no-undo .
     1797     define variable v-restore-saved    as logical   no-undo .
     1798     define variable v-resize-value-str as character no-undo .
     1799     do
     1800     on error undo, return error return-value
     1801     :
     1802       do with frame Dialog-Frame
     1803       :
     1804         assign
     1805           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1806           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1807           v-diasize-browse-handle     = browse BR-tax-rate-gds :handle
     1808         .
     1809         create button v-diasize-resize-button
     1810         assign
     1811           parent        = frame Dialog-Frame :first-child
     1812           label         = "s"
     1813           height-pixels = 16
     1814           width-pixels  = 16
     1815           visible       = true
     1816           sensitive     = true
     1817           movable       = true
     1818           triggers:
     1819             on end-move persistent run diasize_end-move in this-procedure .
     1820           end triggers.
     1821         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1822         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1823         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1824         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1825         assign
     1826           v-diasize-wndmax = false
     1827         .
     1828         if connected("ub") = true
     1829         then do:
     1830           define variable v-cntxt-db-num        as integer   no-undo .
     1831           define variable v-cntxt-userid        as character no-undo .
     1832           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1833                                             , OUTPUT v-cntxt-userid
     1834                                             ) .
     1835           run gbl/wndpar_r.p
     1836             (input  v-cntxt-db-num
     1837             ,input  v-cntxt-userid
     1838             ,input  'wndmax':U
     1839             ,output v-diasize-wndmax
     1840             ,output v-default-value
     1841             ) .
     1842         end.
     1843         assign
     1844           v-diasize-wndstore = false
     1845         .
     1846         if connected("ub") = true
     1847         then do:
     1848           run gbl/wndpar_r.p
     1849             (input  v-cntxt-db-num
     1850             ,input  v-cntxt-userid
     1851             ,input  'wndstore':U
     1852             ,output v-diasize-wndstore
     1853             ,output v-default-value
     1854             ) .
     1855         end.
     1856         assign
     1857           v-diasize-proc-name = entry(1, program-name(2), '.')
     1858         .
     1859         if v-diasize-wndstore = true
     1860         then do:
     1861           assign
     1862             v-restore-saved = false
     1863           .
     1864           if connected("ub") = true
     1865           then do:
     1866             run gbl/wndsizer.p
     1867               (input  v-cntxt-db-num
     1868               ,input  v-cntxt-userid
     1869               ,input  v-diasize-proc-name
     1870               ,input  'height':u
     1871               ,output v-resize-value-str
     1872               ) .
     1873             if v-resize-value-str <> '':U
     1874             then do:
     1875               run diasize_change-height in this-procedure
     1876                 (input  integer(v-resize-value-str)
     1877                 ,input  true
     1878                 ) .
     1879               assign
     1880                 v-restore-saved = true
     1881               .
     1882             end.
     1883           end.
     1884           if connected("ub") = true
     1885           then do:
     1886             run gbl/wndsizer.p
     1887               (input  v-cntxt-db-num
     1888               ,input  v-cntxt-userid
     1889               ,input  v-diasize-proc-name
     1890               ,input  'width':u
     1891               ,output v-resize-value-str
     1892               ) .
     1893             if v-resize-value-str <> '':U
     1894             then do:
     1895               run diasize_change-width in this-procedure
     1896                 (input  integer(v-resize-value-str)
     1897                 ,input  true
     1898                 ) .
     1899               assign
     1900                 v-restore-saved = true
     1901               .
     1902             end.
     1903           end.
     1904           if v-restore-saved <> true
     1905           then do:
     1906             if v-diasize-wndmax = true
     1907             then do:
     1908               run diasize_maximize in this-procedure
     1909                 (input  true
     1910                 ) .
     1911             end.
     1912           end.
     1913         end.
     1914         else do:
     1915           if v-diasize-wndmax = true
     1916           then do:
     1917             run diasize_maximize in this-procedure
     1918               (input  true
     1919               ) .
     1920           end.
     1921         end.
     1922       end.
     1923     end.
     1924   end procedure.
     1925   procedure diasize_need-full-display :
     1926     define output parameter p-need-full-display as logical   no-undo .
     1927     do
     1928     on error undo, return error return-value
     1929     :
     1930       assign
     1931         p-need-full-display = v-diasize-need-full-display
     1932       .
     1933       assign
     1934         v-diasize-need-full-display = false
     1935       .
     1936     end.
     1937   end procedure.
     1938   procedure get-context :
     1939      define output parameter p-db-num as integer          no-undo.
     1940      define output parameter p-user-id as character        no-undo.
     1941      define variable v-login               as character    no-undo.
     1942      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1943      define buffer buf_user-login  for ub.user-login .
     1944      do
     1945      on error undo, return error
     1946      :
     1947            FIND FIRST buf_sys-ctrl no-lock.
     1948            ASSIGN
     1949               v-login = USERID("ub")
     1950               p-db-num = buf_sys-ctrl.db-num
     1951            .
     1952            FIND FIRST buf_user-login
     1953                 WHERE buf_user-login.db-num = p-db-num
     1954                   AND buf_user-login.user-login = v-login
     1955                 no-lock
     1956                 no-error
     1957                 .
     1958            IF AVAILABLE buf_user-login
     1959            THEN DO:
     1960               assign
     1961                  p-user-id = buf_user-login.user-id
     1962               .
     1963            END.
     1964      end.
     1965   end procedure.
     1966       run diasize_init in this-procedure .
     1967   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1968   procedure set-filter-name :
     1969   define input parameter p-filter-name as character no-undo .
     1970     do with frame Dialog-Frame:
     1971       if p-filter-name > "" then do:
     1972         assign
     1973           frame Dialog-Frame:title
     1974             = frame Dialog-Frame:title + "   ФИЛЬТР: " + p-filter-name.
     1975         .
     1976         assign
     1977           b-sch :tooltip = "Установлен фильтр " + p-filter-name
     1978         .
     1979       end.
     1980       else do:
     1981         assign
     1982           b-sch :tooltip = ""
     1983         .
     1984       end.
     1985     end.
     1986   end procedure.
     1987   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1988   on F9 of frame Dialog-Frame anywhere do:
     1989     if not available X_goods then
     1990       return no-apply.
     1991     gds-rec = recid (X_goods).
     1992     run ref/gds-form.w ( input parparentproc
     1993                         ,input 'ПРОСМОТР':U
     1994                         ,input ?
     1995                         ,input ?
     1996                         ,input ?
     1997                         ,input-output gds-rec).
     1998     apply "entry" to br-tax-rate-gds in frame Dialog-Frame.
     1999     return no-apply.
     2000   end.
     2001   MAIN-BLOCK:
     2002   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2003      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2004     v-rid-list = p-rid-list.
     2005     RUN MyEnable.
     2006     WAIT-FOR GO OF FRAME Dialog-Frame.
     2007   END.
     2008   RUN disable_UI.
     2009   PROCEDURE disable_UI :
     2010     HIDE FRAME Dialog-Frame.
     2011   END PROCEDURE.
     2012   PROCEDURE enable_UI :
     2013     ENABLE B-quit B-sch B-Help BR-tax-rate-gds
     2014         WITH FRAME Dialog-Frame.
     2015     VIEW FRAME Dialog-Frame.
     2016     OPEN QUERY BR-tax-rate-gds FOR EACH t-units NO-LOCK,              EACH X_goods WHERE TRUE        AND X_goods.unit-base = t-units.unit-name NO-LOCK.
     2017   END PROCEDURE.
     2018   PROCEDURE MyEnable :
     2019   define buffer buf_units for ub.units.
     2020     CASE p-list-mode:
     2021         when "TAX" then do:
     2022             FIND FIRST ub.tax NO-LOCK where ub.tax.tax-code = p-tax-code NO-ERROR.
     2023         END.
     2024     END case.
     2025     ENABLE
     2026     B-quit
     2027     B-sel when lookup("b-sel", bttns) > 0
     2028     B-Help
     2029     b-sch
     2030     BR-tax-rate-gds
     2031     WITH FRAME Dialog-Frame.
     2032     VIEW FRAME Dialog-Frame.
     2033     for each buf_units No-LOCK,
     2034             first ub.tax-units No-LOCK WHERE
     2035                      LOOKUP(ub.tax-units.type, buf_units.type) > 0  AND
     2036                      ub.tax-units.tax-code = p-tax-code:
     2037       create tt-units.
     2038       buffer-copy buf_units to tt-units.
     2039     end.
     2040     Run OpenBr in this-procedure  ( input yes, input no, input '':U).
     2041   END PROCEDURE.
     2042   PROCEDURE OpenBr :
     2043   define input  parameter p-open-query     as logical   no-undo .
     2044   define input  parameter p-find-next      as logical   no-undo .
     2045   define input  parameter p-find-condition as character no-undo .
     2046   define variable l-query-was-opened as logical no-undo .
     2047   run waitfram-show in this-procedure ( input "Ждите...").
     2048   CASE p-list-mode:
     2049       when "TAX" then do:
     2050           ASSIGN
     2051           frame Dialog-Frame:TITLE = substitute("Товары, привязанные к индивидуальному налогу с кодом &1 (&2)"
     2052                                                ,p-tax-code
     2053                                                ,ub.tax.tax-name)
     2054           filter-point = filter-point0 + chr(44) + p-list-mode
     2055           filter-label = substitute("&1", filter-label0)
     2056           .
     2057   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2058   define variable  l-disable-where-11  as logical   no-undo .
     2059   define variable  l-filter-open-11    as logical   .
     2060   define variable  flt-rec-11       as recid     no-undo .
     2061   define variable  filter-name-11      as character no-undo .
     2062   define variable  where-phrase-11     as character no-undo .
     2063   define variable  sort-phrase-11      as character no-undo .
     2064   define variable  where-phrase-rus-11 as character no-undo .
     2065   define variable  sort-phrase-rus-11  as character no-undo .
     2066     run waitfram-show in this-procedure
     2067       (input "ЖДИТЕ ..."
     2068       ).
     2069   run gbl/flt-get.p
     2070     (input filter-point
     2071     ,output flt-rec-11
     2072     ,output filter-name-11
     2073     ,output where-phrase-11
     2074     ,output sort-phrase-11
     2075     ,output where-phrase-rus-11
     2076     ,output sort-phrase-rus-11
     2077     ).
     2078       run set-filter-name in this-procedure
     2079         (INPUT filter-name-11
     2080         ) no-error .
     2081     assign
     2082       l-filter-open-11 = false
     2083     .
     2084     if flt-rec-11 <> ?
     2085     then do:
     2086       define variable  parameter-2-11 as character no-undo .
     2087       define variable  parameter-3-11 as character no-undo .
     2088       define variable  parameter-4-11 as character no-undo .
     2089       define variable  parameter-5-11 as character no-undo .
     2090       define variable  parameter-6-11 as character no-undo .
     2091       define variable  parameter-7-11 as character no-undo .
     2092         assign
     2093         parameter-3-11 =
     2094                                 "FOR EACH t-units NO-LOCK, EACH X_goods NO-LOCK"
     2095         parameter-4-11 =
     2096           (
     2097             if (" X_goods.unit-base = t-units.unit-name  " + " " + where-phrase-11) <> ""
     2098             then " X_goods.unit-base = t-units.unit-name  " + " " + where-phrase-11
     2099             else "true"
     2100           )
     2101         parameter-5-11 = (" " + "" + " " + "")
     2102         parameter-6-11 = if sort-phrase-11 = ''
     2103                              then
     2104           (
     2105           " " + "  " +
     2106           " " + " BY X_goods.artic BY X_goods.prod-type BY X_goods.prod-code "
     2107           )
     2108                              else
     2109           (
     2110           " " + "  " +
     2111           " " + sort-phrase-11
     2112           )
     2113         parameter-7-11 =
     2114           "   "
     2115       .
     2116       do
     2117       on stop undo, leave
     2118       on error undo, leave
     2119       :
     2120         assign
     2121           l-disable-where-11 =
     2122             (" X_goods.unit-base = t-units.unit-name  " + " " + where-phrase-11 = "")
     2123         .
     2124         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     2125                             ,input QUERY br-tax-rate-gds:handle
     2126                             ,input parameter-3-11
     2127                             ,input parameter-4-11
     2128                             ,input parameter-5-11
     2129                             ,input parameter-6-11
     2130                             ,input parameter-7-11
     2131                             )
     2132         .
     2133         assign
     2134           l-filter-open-11 = true
     2135         .
     2136       end.
     2137       if l-filter-open-11 = false then do:
     2138         message
     2139           "Ошибка при фильтрации / сортировке" skip
     2140           "Будут показаны записи без учета фильтра" skip
     2141           view-as alert-box .
     2142       end.
     2143       else do:
     2144           assign
     2145             l-query-was-opened = true
     2146           .
     2147       end.
     2148     end.
     2149     if l-filter-open-11 = false then do:
     2150       OPEN QUERY br-tax-rate-gds FOR EACH t-units NO-LOCK, EACH X_goods NO-LOCK
     2151         where  X_goods.unit-base = t-units.unit-name
     2152          BY X_goods.artic BY X_goods.prod-type BY X_goods.prod-code
     2153     .
     2154         assign
     2155           l-query-was-opened = true
     2156         .
     2157     end.
     2158     run waitfram-hide in this-procedure .
     2159       end.
     2160   END CASE.
     2161   run waitfram-hide in this-procedure .
     2162   END PROCEDURE.
     2163   PROCEDURE proc-b-sch :
     2164   assign
     2165     tbl = 'goods'
     2166     join-tbl = 'X_goods'
     2167     fld = ""
     2168     lab = ""
     2169     spr = ""
     2170     dim = '0'
     2171     .
     2172   run fltfield-add in this-procedure('artic', '', '',
     2173   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     2174   run fltfield-add in this-procedure('gds-name', '', '',
     2175   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     2176   run fltfield-add in this-procedure('engl-name', 'Название по-английски', '',
     2177   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     2178   run fltfield-add in this-procedure('prod-type*prod-code', 'Производитель', 'cli',
     2179   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     2180   run fltfield-add in this-procedure('unit-base', '', 'unit',
     2181   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     2182   run fltfield-add in this-procedure('unit-cli', '', 'unit',
     2183   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     2184   run fltfield-add in this-procedure('grp-name', '', 'gdsgrp',
     2185   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     2186   run fltfield-add in this-procedure('prt-root', 'Шкала', 'prt',
     2187   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     2188   run fltfield-add in this-procedure('increase-pc', '', '',
     2189   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     2190   run fltfield-add in this-procedure('qnty-cart', '', '',
     2191   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     2192   run fltfield-add in this-procedure('wt-cart', '', '',
     2193   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     2194   run fltfield-add in this-procedure('okdp', '', '',
     2195   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     2196   run fltfield-add in this-procedure('destin', '', '',
     2197   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     2198   run fltfield-add in this-procedure('sert', '', '',
     2199   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     2200   run fltfield-add in this-procedure('struct', '', '',
     2201   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     2202   run fltfield-add in this-procedure('sort', '', '',
     2203   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     2204   run fltfield-add in this-procedure('deadline', '', '',
     2205   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     2206   run fltfield-add in this-procedure('negative-rest', '', '',
     2207   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     2208   run fltfield-add in this-procedure('cost-calc', '', '',
     2209   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     2210   run fltfield-add in this-procedure('gds-type', 'Услуга-товар', '',
     2211   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     2212   run fltfield-add in this-procedure('tnved', 'Код ТНВЭД', '',
     2213   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     2214   run fltfield-add in this-procedure('nationality', '', '',
     2215   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     2216   run fltfield-add in this-procedure('unit-cst', 'Таможенная единица', 'unit',
     2217   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     2218   run fltfield-add in this-procedure('alpha1', 'Код страны изготовления', 'country',
     2219   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     2220   run fltfield-add in this-procedure('normal-wastage', 'Норма естест.убыли', '',
     2221   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     2222   run fltfield-add in this-procedure('normal-waste', 'Норма отходов', '',
     2223   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     2224   run fltfield-add in this-procedure('min-rate', 'Min кол-во в штуке', '',
     2225   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     2226   run fltfield-add in this-procedure('max-rate', 'Max кол-во в штуке', '',
     2227   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     2228      DO on stop undo, leave:
     2229           run gbl/filter.w ( input parparentproc
     2230                             ,input (filter-point + chr(4) + filter-label)
     2231                             ,input tbl
     2232                             ,input join-tbl
     2233                             ,input fld
     2234                             ,input lab
     2235                             ,input spr
     2236                             ,input dim).
     2237           RUN OpenBr in this-procedure ( input yes, input no, input '':U).
     2238       END .
     2239   END PROCEDURE.
