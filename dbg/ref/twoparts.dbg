        1   DEFINE BUFFER X_parts FOR ub.parts.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define input parameter paction as character no-undo .
        4   define input parameter p-mode as character no-undo .
        5   DEFINE INPUT PARAMETER partic like ub.goods.artic NO-UNDO.
        6   DEFINE INPUT PARAMETER pprod-type like ub.goods.prod-type NO-UNDO.
        7   DEFINE INPUT PARAMETER pprod-code like ub.goods.prod-code NO-UNDO.
        8   DEFINE INPUT PARAMETER p-obj-type like ub.clients.obj-type NO-UNDO.
        9   DEFINE INPUT PARAMETER p-obj-code like ub.clients.obj-code NO-UNDO.
       10   define variable vss-revision    as character no-undo init "$Revision$":u .
       11   define variable vss-author      as character no-undo init "$Author$":u .
       12   define variable vss-date        as character no-undo init "$Date$":u .
       13   define variable vss-workfile    as character no-undo init "$Workfile$":u .
       14   define variable vss-archive     as character no-undo init "$Archive$":u .
       15   define variable vss-description as character no-undo init "Партии товаров с двумя ед измерения" .
       16   procedure vss-get-info :
       17     define output parameter p-vss-revision    like vss-revision    no-undo .
       18     define output parameter p-vss-author      like vss-author      no-undo .
       19     define output parameter p-vss-date        like vss-date        no-undo .
       20     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       21     define output parameter p-vss-archive     like vss-archive     no-undo .
       22     define output parameter p-vss-description like vss-description no-undo .
       23     assign
       24       p-vss-revision    = vss-revision
       25       p-vss-author      = vss-author
       26       p-vss-date        = vss-date
       27       p-vss-workfile    = vss-workfile
       28       p-vss-archive     = vss-archive
       29       p-vss-description = vss-description
       30     .
       31   end procedure.
       32   procedure vss-get-parameters :
       33     define output parameter p-vss-parameters as character no-undo .
       34   end procedure.
       35   define new global shared variable g#vssrevis-logger as handle    no-undo .
       36   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       37   define variable v-vssrevis-logger                   as handle    no-undo .
       38   procedure vss-logevent :
       39     define input  parameter p-extra-paramters as character no-undo .
       40     define variable v-vssrevis-parameters as character no-undo .
       41     do
       42     on error undo, return error return-value
       43     :
       44       if  valid-handle(v-vssrevis-logger)
       45       and v-vssrevis-logger :get-signature("logevent") <> ""
       46       then do:
       47         run vss-get-parameters in this-procedure
       48           (output v-vssrevis-parameters
       49           ).
       50         run logevent in v-vssrevis-logger
       51           (input vss-workfile
       52           ,input vss-revision
       53           ,input v-vssrevis-parameters
       54           ,input p-extra-paramters
       55           ).
       56       end.
       57     end.
       58   end procedure.
       59   assign
       60     v-vssrevis-logger = g#vssrevis-logger
       61   .
       62   if  valid-handle(v-vssrevis-logger)
       63   and v-vssrevis-logger :get-signature("logevent") <> ""
       64   then do:
       65     assign
       66       v-vssrevis-logevent = true
       67     .
       68     run vss-logevent in this-procedure (input vss-description) .
       69   end.
       70   define new global shared variable g#language as character no-undo .
       71   if g#language <> '' and g#language <> 'rus':U then do:
       72     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       73   end.
       74   define new global shared variable g#library  as handle no-undo .
       75   define new global shared variable g#library2 as handle no-undo .
       76   procedure proc-alt-shift-f2:
       77     if not ibs.th.gbl.gbl-var:rcode
       78   then
       79     run gbl\inidebug.p .
       80   end.
       81   procedure proc-alt-shift-f3:
       82     run gbl/prvssinf.p
       83       ( input this-procedure
       84       ) .
       85   end.
       86   define variable v-inform-launched as logical no-undo initial false .
       87   procedure proc-alt-shift-f4:
       88     define variable v-action as character no-undo .
       89     if v-inform-launched = false then do:
       90       assign
       91         v-inform-launched = true
       92       .
       93       run gbl/d-inform.w
       94         (  input self
       95         ,  input this-procedure
       96         , output v-action
       97         ) no-error .
       98       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       99       assign
      100         v-inform-launched = false
      101       .
      102     end.
      103   end.
      104   procedure proc-alt-f1:
      105     run gbl/corrhelp.p
      106       (input this-procedure
      107       ) .
      108   end .
      109   on alt-shift-f2 anywhere do:
      110     run proc-alt-shift-f2.
      111   end.
      112   on alt-shift-f3 anywhere do:
      113     run proc-alt-shift-f3 in this-procedure .
      114   end.
      115   on alt-shift-f4 anywhere do:
      116     run proc-alt-shift-f4 in this-procedure.
      117   end.
      118   on alt-f1 anywhere do:
      119     run proc-alt-f1 in this-procedure .
      120   end.
      121   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      122   define variable c-point  as character no-undo .
      123   define variable tbl      as character no-undo .
      124   define variable join-tbl as character no-undo .
      125   define variable fld      as character no-undo .
      126   define variable lab      as character no-undo .
      127   define variable spr      as character no-undo .
      128   define variable dim      as character no-undo .
      129   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      130   procedure fltfield-clear :
      131     define output parameter loc-fld as character no-undo.
      132     define output parameter loc-lab as character no-undo .
      133     define output parameter loc-spr as character no-undo .
      134     define output parameter loc-dim as character no-undo .
      135     assign
      136       loc-fld = ""
      137       loc-lab = ""
      138       loc-spr = ""
      139       loc-dim = "0"
      140     .
      141   end procedure .
      142   procedure fltfield-add :
      143     define input        parameter par-fld as character no-undo.
      144     define input        parameter par-lab as character no-undo .
      145     define input        parameter par-spr as character no-undo .
      146     define input-output parameter loc-fld as character no-undo.
      147     define input-output parameter loc-lab as character no-undo .
      148     define input-output parameter loc-spr as character no-undo .
      149     define input-output parameter loc-dim as character no-undo .
      150     do
      151     on error undo, return error
      152     :
      153       assign
      154       loc-fld = if loc-dim = '0'
      155                 then par-fld
      156                 else (loc-fld + chr(44) + par-fld)
      157       loc-lab = if loc-dim = '0'
      158                 then par-lab
      159                 else (loc-lab + chr(44) + par-lab)
      160       loc-spr = if loc-dim = '0'
      161                 then par-spr
      162                 else (loc-spr + chr(44) + par-spr)
      163       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
      164                 string(integer(if num-entries(loc-dim) > 1
      165                               then entry(2, loc-dim)
      166                               else entry(1, loc-dim)
      167                               ) + 1)
      168       no-error
      169       .
      170     end.
      171   end procedure.
      172   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      173   define variable v-waitfram-action01         as character   no-undo .
      174   define variable v-waitfram-action02         as character   no-undo .
      175   define variable v-waitfram-action03         as character   no-undo .
      176   define variable mWaitFramTextBeg            as character   no-undo.
      177   define variable mWaitFramTextEnd            as character   no-undo.
      178   define variable mWaitFramView               as logical     no-undo.
      179   define variable mWaitProcEvent              as logical     no-undo init yes.
      180   define variable mWaitFramInterval           as integer     no-undo init 1 .
      181   define variable mWaitFramStop               as logical     no-undo.
      182   define variable mWaitFramStopUser           as logical     no-undo.
      183   define variable mWaitFramStopTimeOut        as logical     no-undo.
      184   define variable mWaitFramStartProc          as datetime-tz no-undo.
      185   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      186   define button B-WaitFramStop auto-end-key
      187        label "Стоп"
      188        size 10 by 1 tooltip "Остоновить процесс".
      189   define button B-viewProcInfo
      190        label "Информация"
      191        size 15 by 1 tooltip "Информация о процесс".
      192   define frame waitfram
      193     v-waitfram-action01 format "x(72)" no-label skip
      194     v-waitfram-action02 format "x(72)" no-label skip
      195     v-waitfram-action03 format "x(72)" no-label skip
      196     B-viewProcInfo
      197     B-WaitFramStop at row 4 col 30
      198     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      199     .
      200   define new global shared variable mBatchMode as logical no-undo init ?.
      201   define variable mFramBachModHandle as handle no-undo.
      202   mFramBachModHandle = frame waitfram:handle.
      203   define variable mFameOldVis as logical no-undo.
      204   define variable mVisCUrentVin as logical no-undo.
      205   if session:batch-mode
      206   then
      207      mBatchMode = yes.
      208   if mBatchMode = ? then do:
      209     mVisCUrentVin = current-window:visible.
      210     mFameOldVis = mFramBachModHandle:visible.
      211     mFramBachModHandle:visible  = yes.
      212     mBatchMode = mFramBachModHandle:visible ne yes.
      213     mFramBachModHandle:visible = mFameOldVis.
      214     current-window:visible = mVisCUrentVin.
      215   end.
      216    if  log-manager:logfile-name ne ?
      217     then DO:
      218         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      219         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      220         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      221     end.
      222   on choose of B-WaitFramStop in frame waitfram
      223   do:
      224     mWaitFramStop = yes.
      225     mWaitFramStopUser = yes.
      226   end.
      227   function waitfram-check-timeout returns logical():
      228      define variable vtime as int64 no-undo.
      229      if mWaitFramStopTimeOut
      230      then
      231         return yes.
      232      vtime = ( now - mWaitFramStartProc ) / 1000 .
      233      if     mWaitFramTimeOut ne ?
      234         and mWaitFramTimeOut ne 0
      235         and mWaitFramTimeOut lt vtime
      236      then do:
      237         mWaitFramStopTimeOut = yes.
      238      end.
      239      return mWaitFramStopTimeOut.
      240   end.
      241   procedure waitfram-hide :
      242     if not session:batch-mode
      243     then do
      244     on error undo, return error return-value
      245     :
      246       pause 0 before-hide .
      247       if not mBatchMode then
      248         hide frame waitfram .
      249     if     not mWaitFramView
      250        and mWaitProcEvent
      251     then
      252       process events .
      253     end.
      254   end procedure.
      255   procedure waitfram-show :
      256     define input  parameter p-message as character no-undo .
      257     define variable v-left-margin as integer   no-undo .
      258     if not session:batch-mode
      259     then do
      260     on error undo, return error return-value
      261     :
      262       if length(p-message) <= 70 then do:
      263         assign
      264           v-left-margin = integer((70 - length(p-message)) / 2)
      265         .
      266         assign
      267           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      268         .
      269         assign
      270           v-waitfram-action01 = " "
      271           v-waitfram-action02 = " "
      272                                    + fill(" ", v-left-margin)
      273                                    + p-message
      274           v-waitfram-action03 = " "
      275         .
      276       end.
      277       else do:
      278         define variable vRindex1 as integer no-undo.
      279         define variable vRindex2 as integer no-undo.
      280         vRindex1 = r-index(p-message," ",70).
      281         if vRindex1 = 0
      282         then
      283            vRindex1 = 70.
      284         if length(p-message)  <= vRindex1 + 70 then do:
      285           assign
      286             v-waitfram-action01 = " "
      287             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      288             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      289           .
      290         end.
      291         else do:
      292           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      293           if vRindex2 <= vRindex1
      294           then
      295              vRindex2 = vRindex1 + 70.
      296           assign
      297             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      298             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      299             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      300           .
      301         end.
      302       end.
      303       B-viewProcInfo:visible   in frame waitfram = no.
      304       B-viewProcInfo:sensitive in frame waitfram = no.
      305       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      306       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      307       if  (   mWaitFramView
      308          or  mWaitProcEvent)
      309          and not mBatchMode
      310       then
      311          display
      312             v-waitfram-action01 skip
      313             v-waitfram-action02 skip
      314             v-waitfram-action03 skip
      315          with frame waitfram .
      316       if     mWaitFramView
      317          then do:
      318             if     mWaitFramInterval ne ?
      319                and not mBatchMode
      320             then
      321                wait-for go of frame waitfram pause mWaitFramInterval.
      322          end.
      323          else
      324             if     mWaitProcEvent
      325                and not mBatchMode
      326             then
      327                process events .
      328     end.
      329   end procedure.
      330      procedure waitfram-show-this:
      331         define input  parameter iInterval as int64 no-undo.
      332         define variable vtime as int64 no-undo.
      333         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      334         mWaitFramInterval = iInterval.
      335         run waitfram-show (substitute("&1&2 &3&4" ,
      336                                       mWaitFramTextBeg ,
      337                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      338                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      339                                       mWaitFramTextEnd
      340                                      )
      341                           ).
      342      end.
      343      procedure WaitFramRunPause:
      344         define input  parameter iInterval as dec no-undo.
      345         define variable vStart  as datetime-tz no-undo.
      346         define variable vend    as datetime-tz no-undo.
      347         define variable vint as int64 no-undo.
      348         define variable vOk as logical no-undo.
      349         vStart = now.
      350         vend   = vStart.
      351         publish "WaitFramPause" (iInterval,output vOk).
      352         vend   =  now.
      353         vint = vend - vStart.
      354         vint = iInterval - vint / 1000.
      355         if     not mWaitFramStop
      356            and (   vint > 0
      357                 or (    not vOk
      358                     and iInterval eq ?
      359                     )
      360                 )
      361         then
      362            run waitfram-show-this (iInterval).
      363         vend   =  now.
      364         vint = vend - vStart.
      365         vint = iInterval - vint / 1000.
      366         if     not mWaitFramStop
      367            and vint > 0
      368         then do:
      369            run gbl/pause.p (vint * 1000).
      370         end.
      371         if iInterval ne ?
      372         then
      373            publish "WaitFramStop".
      374         waitfram-check-timeout().
      375      end.
      376      procedure WaitFramWaitFor:
      377         define input  parameter iInterval as dec no-undo.
      378         assign
      379            mWaitFramStartProc   = now
      380            mWaitFramStopUser    = no
      381            mWaitFramStopTimeOut = no
      382         .
      383         block-wait:
      384         do while not mWaitFramStop:
      385            run WaitFramRunPause (iInterval).
      386            if  waitfram-check-timeout()
      387            then do:
      388               leave block-wait.
      389            end.
      390         end.
      391         run waitfram-hide.
      392      end.
      393   procedure waitfram-join :
      394     define input  parameter p-line-1  as character no-undo .
      395     define input  parameter p-line-2  as character no-undo .
      396     define input  parameter p-line-3  as character no-undo .
      397     define output parameter p-message as character no-undo .
      398     do
      399     on error undo, return error return-value
      400     :
      401       assign
      402         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      403                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      404                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      405       .
      406     end.
      407   end procedure.
      408   function waitfram-join-function returns character
      409     (input p-line-1 as character
      410     ,input p-line-2 as character
      411     ,input p-line-3 as character
      412     ).
      413     define variable v-message as character no-undo .
      414     run waitfram-join in this-procedure
      415       (input  p-line-1
      416       ,input  p-line-2
      417       ,input  p-line-3
      418       ,output v-message
      419       ) .
      420     return v-message .
      421   end function .
      422   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      423     define variable v-cntxt-db-num        as integer   no-undo .
      424     define variable v-cntxt-userid        as character no-undo .
      425     define variable v-cntxt-level         as character no-undo .
      426     define variable v-cntxt-host-code-obj as integer   no-undo .
      427     define variable v-cntxt-obj-type      as character no-undo .
      428     define variable v-cntxt-obj-code      as integer   no-undo .
      429     define variable v-cntxt-db-num-obj    as integer   no-undo .
      430     define variable v-cntxt-is-admin      as logical   no-undo .
      431   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      432   FUNCTION mark-string RETURNS CHARACTER
      433     ( input p-recid as recid, input mark-list as character  ) :
      434     RETURN ( IF LOOKUP( STRING( p-recid), mark-list ) > 0 THEN '*' ELSE '':U ).
      435   END FUNCTION.
      436   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      437   define variable v-fltopend-rowid as rowid extent 18 no-undo .
      438   procedure fltopend_fltopend :
      439   define input parameter p-parent-handle as handle no-undo .
      440   define input parameter p-qh as handle no-undo .
      441   define input parameter p-flt-open-open-query  as character no-undo .
      442   define input parameter p-where-cond as character no-undo .
      443   define input parameter p-use-indFIRST-query-tail as character no-undo .
      444   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      445   define input parameter p-indexed-reposition as character no-undo .
      446     do
      447     on error undo, return error
      448     :
      449   define variable v-prepare-string as character no-undo .
      450   define variable glog as logical no-undo .
      451   assign
      452   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      453                      p-where-cond + chr(32)  +
      454                      p-use-indFIRST-query-tail + chr(32) +
      455                      p-use-ind-sort-clmn-by + chr(32) +
      456                      p-indexed-reposition
      457   .
      458   assign
      459   glog = p-qh:query-prepare(v-prepare-string) no-error .
      460   if not glog
      461   or error-status:error then do:
      462     message error-status:get-message(1) view-as alert-box .
      463     undo, return error .
      464   end.
      465   assign
      466   glog = p-qh:query-open no-error .
      467   if not glog
      468   or error-status:error then do:
      469     message error-status:get-message(1) view-as alert-box .
      470     undo, return error .
      471   end.
      472     end.
      473   end procedure.
      474   procedure fltopend_fltfindd :
      475   define input parameter p-parent-handle as handle no-undo .
      476   define input parameter p-qh as handle no-undo .
      477   define input parameter p-rowid as rowid no-undo .
      478   define input parameter p-next as logical no-undo .
      479   define input parameter p-lock as integer no-undo .
      480   define input parameter p-bh as handle no-undo .
      481   define input parameter p-where-cond as character no-undo .
      482   define input parameter p-use-index-phrase as character no-undo .
      483   define variable glog as logical no-undo .
      484   define variable v-qh as handle no-undo .
      485   define variable v-bh as handle no-undo .
      486   define variable v-recid as recid no-undo .
      487   define variable v-prepare-string as character no-undo .
      488   do
      489   on error undo, return error
      490   on stop undo, return error
      491   :
      492     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
      493     create buffer v-bh for table p-bh buffer-name p-bh:name.
      494     create query v-qh.
      495     v-qh:set-buffers(v-bh).
      496     v-prepare-string = substitute("for each &1 &2 &3"
      497                                     ,v-bh:name
      498                                     ,p-where-cond
      499                                     ,p-use-index-phrase).
      500     glog = v-qh:query-prepare(v-prepare-string) no-error.
      501     if not glog then do:
      502       delete object v-qh.
      503       delete object v-bh.
      504       undo, return error .
      505     end.
      506     glog = v-qh:query-open no-error .
      507     if not glog then do:
      508       delete object v-qh.
      509       delete object v-bh.
      510       undo, return error .
      511     end.
      512     if p-next then do:
      513       v-qh:reposition-to-rowid(p-rowid) no-error .
      514       glog = v-qh:get-next( p-lock) no-error .
      515       glog = v-qh:get-next( p-lock) no-error .
      516       if not glog or v-qh:query-off-end = yes then do:
      517         glog = v-qh:get-first( p-lock) no-error .
      518       end.
      519     end.
      520     else do:
      521       glog = v-qh:get-first( p-lock) no-error .
      522     end.
      523     v-recid = v-bh:recid no-error .
      524     delete object v-qh.
      525     delete object v-bh.
      526     return string(v-recid) .
      527   end.
      528   end procedure.
      529   procedure fltopend_fltfindq :
      530   define input parameter p-parent-handle as handle no-undo .
      531   define input parameter p-qh as handle no-undo .
      532   define input parameter p-next as logical no-undo .
      533   define input parameter p-lock as integer no-undo .
      534   define input parameter p-flt-open-open-query  as character no-undo .
      535   define input parameter p-where-cond as character no-undo .
      536   define input parameter p-use-indFIRST-query-tail as character no-undo .
      537   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      538   define input parameter p-indexed-reposition as character no-undo .
      539   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
      540   define variable glog as logical no-undo .
      541   define variable v-qh as handle no-undo .
      542   define variable v-bh as handle no-undo extent 18.
      543   define variable v-rowid as rowid no-undo extent 18.
      544   define variable v-ii as integer no-undo .
      545   define variable v-prepare-string as character no-undo .
      546   do
      547   on error undo, return error
      548   on stop undo, return error
      549   :
      550     create query v-qh.
      551     do v-ii = 1 to p-qh:num-buffers:
      552       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
      553       assign
      554       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
      555       no-error.
      556       v-qh:add-buffer(v-bh[v-ii]).
      557     end.
      558     assign
      559     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      560                       p-where-cond + chr(32)  +
      561                       p-use-indFIRST-query-tail + chr(32) +
      562                       p-use-ind-sort-clmn-by + chr(32) +
      563                       p-indexed-reposition
      564     .
      565     glog = v-qh:query-prepare( v-prepare-string) no-error .
      566     if not glog then do:
      567       delete object v-qh.
      568       do v-ii = 1 to p-qh:num-buffers:
      569         delete object v-bh[v-ii].
      570       end.
      571       undo, return error .
      572     end.
      573     glog = v-qh:query-open no-error .
      574     if not glog then do:
      575       delete object v-qh.
      576       do v-ii = 1 to p-qh:num-buffers:
      577         delete object v-bh[v-ii].
      578       end.
      579       undo, return error .
      580     end.
      581     if p-next then do:
      582       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
      583       glog = v-qh:get-next( p-lock) no-error .
      584       glog = v-qh:get-next( p-lock) no-error .
      585       if not glog or v-qh:query-off-end = yes then do:
      586         glog = v-qh:get-first( p-lock) no-error .
      587       end.
      588     end.
      589     else do:
      590       glog = v-qh:get-first( p-lock) no-error .
      591     end.
      592     do v-ii = 1 to p-qh:num-buffers:
      593       assign
      594       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
      595       no-error.
      596     end.
      597     delete object v-qh.
      598     do v-ii = 1 to p-qh:num-buffers:
      599       delete object v-bh[v-ii].
      600     end.
      601   end.
      602   end procedure.
      603   define variable filter-point as character no-undo init "twoparts" .
      604   define variable filter-point0 as character no-undo init "twoparts" .
      605   define variable filter-label as character no-undo init "Партии_товаров_с_2_ед_изм" .
      606   define variable filter-label0 as character no-undo init "Партии_товаров_с_2_ед_изм" .
      607   define variable mark-list as character no-undo.
      608   define variable mark as char no-undo.
      609   define variable sort-column-name as character no-undo .
      610   define buffer buf_goods for ub.goods.
      611   DEFINE BUTTON B-case
      612        LABEL "&Коробка"
      613        SIZE 10 BY 1.
      614   DEFINE BUTTON B-doc
      615        LABEL "&ПН"
      616        SIZE 10 BY 1.
      617   DEFINE BUTTON B-exit AUTO-GO
      618        LABEL "&Выход"
      619        SIZE 10 BY 1
      620        BGCOLOR 8 .
      621   DEFINE BUTTON B-gds
      622        LABEL "&Товар"
      623        SIZE 10 BY 1.
      624   DEFINE BUTTON B-Help
      625        LABEL "Помо&щь"
      626        SIZE 3 BY 1
      627        BGCOLOR 8 .
      628   DEFINE BUTTON B-mark
      629        LABEL "&*"
      630        SIZE 3 BY 1.
      631   DEFINE BUTTON B-part
      632        LABEL "Па&ртии"
      633        SIZE 10 BY 1.
      634   DEFINE BUTTON B-sch
      635        LABEL "&Фильтр"
      636        SIZE 3 BY 1.
      637   DEFINE VARIABLE ED-notes AS CHARACTER
      638        VIEW-AS EDITOR SCROLLBAR-VERTICAL
      639        SIZE 97.75 BY 1.63
      640        BGCOLOR 8  NO-UNDO.
      641   DEFINE VARIABLE for-gds AS CHARACTER FORMAT "X(256)":U
      642         VIEW-AS TEXT
      643        SIZE 78.5 BY 1
      644        FGCOLOR 4  NO-UNDO.
      645   DEFINE VARIABLE for-gds-code AS INTEGER FORMAT ">>>>>>>>9" INITIAL 0
      646         VIEW-AS TEXT
      647        SIZE 17.38 BY 1 NO-UNDO.
      648   DEFINE VARIABLE Rs-action AS CHARACTER
      649        VIEW-AS RADIO-SET HORIZONTAL
      650        RADIO-BUTTONS
      651             "Неразбитые партии", "split",
      652   "Штуки", "fuse"
      653        SIZE 31.13 BY 1 NO-UNDO.
      654   DEFINE QUERY BR-parts FOR
      655                   X_parts SCROLLING.
      656   DEFINE BROWSE BR-parts
      657     QUERY BR-parts DISPLAY
      658         mark COLUMN-LABEL "*" FORMAT "X(1)":U
      659         X_parts.cli-qnty FORMAT "->>,>>>,>>9.999":U
      660         X_parts.in-code FORMAT "X(14)":U
      661         X_parts.part-code FORMAT "X(12)":U
      662         X_parts.qnty FORMAT "->>,>>>,>>9.999":U
      663         X_parts.fact-qnty FORMAT "->>,>>>,>>9.999":U
      664       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 15.33.
      665   DEFINE FRAME Dialog-Frame
      666        B-exit AT ROW 1 COL 1.13
      667        B-gds AT ROW 1 COL 21
      668        B-doc AT ROW 1 COL 31
      669        B-part AT ROW 1 COL 41
      670        B-mark AT ROW 1 COL 51
      671        B-case AT ROW 1 COL 54
      672        B-sch AT ROW 1 COL 92
      673        B-Help AT ROW 1 COL 95
      674        Rs-action AT ROW 4.04 COL 3.25 NO-LABEL
      675        BR-parts AT ROW 5.54 COL 1.25
      676        ED-notes AT ROW 21.08 COL 1.5 NO-LABEL
      677        for-gds AT ROW 2.71 COL 1.75 NO-LABEL
      678        for-gds-code AT ROW 2.71 COL 79.25 COLON-ALIGNED NO-LABEL
      679        SPACE(0.86) SKIP(19.24)
      680       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      681            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      682            TITLE "Партии"
      683            DEFAULT-BUTTON B-exit.
      684   ASSIGN
      685          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      686          FRAME Dialog-Frame:HIDDEN           = TRUE.
      687   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      688   DO:
      689     APPLY "END-ERROR":U TO SELF.
      690   END.
      691   ON CHOOSE OF B-case IN FRAME Dialog-Frame
      692   DO:
      693   define variable glog as logical no-undo .
      694   define variable v-line-rec as recid no-undo .
      695     define variable v-chk-act-host-code as integer   no-undo .
      696   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      697   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      698     (input  p-obj-type
      699     ,input  p-obj-code
      700     ,output v-chk-act-host-code
      701     )  .
      702   define variable vss-include-info8 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      703   do:
      704     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      705       (input  v-cntxt-db-num
      706       ,input  v-cntxt-userid
      707       ,input  0
      708       ,input  'actn_parts_split-fuse':U
      709       ,input  'object':U
      710       ,input  v-chk-act-host-code
      711       ,input  p-obj-type
      712       ,input  p-obj-code
      713       ,input  0
      714       ,input  0
      715       ,input  0
      716       ,input  true
      717       ,output glog
      718       )  .
      719   end.
      720     if NOT glog then return no-apply.
      721     case paction:
      722       when "split":U then do:
      723         if avail X_parts then do:
      724           if buf_goods.min-rate = 0
      725           or buf_goods.max-rate = 0 then do:
      726             message "Товар в справочнике имеет неверные значения полей КОЛИЧЕСТВО ДРОБНОГО В ШТУКЕ!"
      727             view-as alert-box .
      728             return no-apply.
      729           end.
      730             if X_parts.cli-qnty = 1 then do:
      731               message "Партия уже состоит из одного изделия"
      732               view-as alert-box ERROR.
      733               return no-apply.
      734             end.
      735             v-line-rec = recid(X_parts).
      736             run ref/spltpart.w (input parparentproc, input-output v-line-rec)  no-error.
      737             if v-line-rec <> ? then do:
      738               RUN OPENBr in this-procedure ( input yes, input no, input '':U, input paction).
      739               APPLY "ENTRY" TO br-parts.
      740             end.
      741         end.
      742       end.
      743       when "fuse":U then do:
      744         if mark-list = "" then do:
      745           message "Не выбрано ни одной записи для слияния партий"
      746           view-as alert-box ERROR.
      747           return no-apply.
      748         end.
      749           if INDEX(X_parts.part-code, '#':U) = 0 then do:
      750             message "Партия слиянию не подлежит"
      751             view-as alert-box ERROR.
      752             return no-apply.
      753           end.
      754         run fuse-parts no-error.
      755         if error-status:error then return no-apply.
      756         mark-list = "".
      757         run openbr in this-procedure ( input yes, input no, input '':U, input paction).
      758       end.
      759     END CASE.
      760   END.
      761   ON CHOOSE OF B-doc IN FRAME Dialog-Frame
      762   DO:
      763     if available X_parts
      764     then do:
      765       run str/showdoc.p
      766         (input parparentproc
      767         ,input X_parts.in-code
      768         ,input buf_goods.artic
      769         ,input buf_goods.prod-type
      770         ,input buf_goods.prod-code
      771         ,input true
      772         ) .
      773     end.
      774   END.
      775   ON CHOOSE OF B-gds IN FRAME Dialog-Frame
      776   DO:
      777     define variable v-gds-rec as recid no-undo .
      778     define variable glog as logical no-undo .
      779     define variable v-call-handle as handle no-undo .
      780     FIND FIRST ub.db WHERE ub.db.db-num = v-cntxt-db-num NO-LOCK .
      781     if not avail db then return no-apply.
      782   define variable vss-include-info9 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      783   do:
      784     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      785       (input  v-cntxt-db-num
      786       ,input  v-cntxt-userid
      787       ,input  0
      788       ,input  'actn_reference_update':U
      789       ,input  'object':U
      790       ,input  0
      791       ,input  '':U
      792       ,input  0
      793       ,input  0
      794       ,input  buf_goods.grp-code
      795       ,input  0
      796       ,input  true
      797       ,output glog
      798       )  .
      799   end.
      800     v-gds-rec = recid (buf_goods).
      801     if glog AND NOT buf_goods.stts <> 0 AND db.add-goods AND NOT transaction
      802     then do:
      803       assign
      804       v-call-handle = ?
      805           .
      806       run ref/gds-form.w ( input parparentproc
      807                           ,input 'ИЗМЕНЕНИЕ':U
      808                           ,input p-obj-type
      809                           ,input p-obj-code
      810                           ,input v-call-handle
      811                           ,input-output v-gds-rec
      812                           ).
      813     end.
      814     else do:
      815       assign
      816       v-call-handle = ?
      817           .
      818       run ref/gds-form.w ( input parparentproc
      819                          , input 'ПРОСМОТР':U
      820                          , input p-obj-type
      821                          , input p-obj-code
      822                          , input v-call-handle
      823                          , input-output v-gds-rec
      824                          ) no-error.
      825     end.
      826     FIND current buf_goods No-LOCK No-ERROR.
      827   END.
      828   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
      829   DO:
      830     define variable glog as logical no-undo .
      831     RUN loc-mark.
      832     glog = BR-parts:select-next-row ().
      833     apply "entry" to BR-parts in frame Dialog-Frame.
      834   END.
      835   ON CHOOSE OF B-part IN FRAME Dialog-Frame
      836   DO:
      837    define variable v-prt-rec as recid no-undo .
      838     if avail X_parts then do:
      839       run str/parts-l.w
      840         (input parparentproc
      841         ,input p-obj-type
      842         ,input p-obj-code
      843         ,input buf_goods.gds-code
      844         ,input ""
      845         ,input 'ПРОСМОТР':U
      846         ,input 'остатки':U
      847         ,input 'текущий':U
      848         ,input 'справочник':U
      849         ,output v-prt-rec
      850         ) .
      851     end.
      852   END.
      853   ON CHOOSE OF B-sch IN FRAME Dialog-Frame
      854   DO:
      855     assign
      856     tbl = 'parts'
      857     join-tbl = 'X_parts'
      858     fld = '':U
      859     spr = '':U
      860     lab = '':U
      861     dim = '0':U
      862     .
      863     run fltfield-add in this-procedure('artic', 'Артикул', '',
      864     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
      865     run fltfield-add in this-procedure('prod-type*prod-code', 'Производитель', 'cli',
      866     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
      867     run fltfield-add in this-procedure('cli-qnty', 'Кол-во в ед.поставщика', '',
      868     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
      869     run fltfield-add in this-procedure('qnty', '', '',
      870     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
      871     run fltfield-add in this-procedure('fact-qnty', '', '',
      872     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
      873     run fltfield-add in this-procedure('in-code', '', '',
      874     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
      875     run fltfield-add in this-procedure('part-code', '', '',
      876     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
      877     DO on stop undo, leave:
      878         run gbl/filter.w ( input parparentproc
      879                           ,input (filter-point + chr(4) + filter-label)
      880                           ,input tbl
      881                           ,input join-tbl
      882                           ,input fld
      883                           ,input lab
      884                           ,input spr
      885                           ,input dim).
      886         RUN OpenBr in this-procedure ( input yes, input no, input '':U, input paction).
      887     END .
      888   END.
      889   ON DEFAULT-ACTION OF BR-parts IN FRAME Dialog-Frame
      890   DO:
      891     case paction:
      892         when "split":U then do:
      893             APPLY "CHOOSE" TO b-case.
      894         end.
      895         when "fuse":U then do:
      896             APPLY "CHOOSE" TO b-mark.
      897         end.
      898     end case.
      899   END.
      900   ON RETURN OF BR-parts IN FRAME Dialog-Frame
      901   DO:
      902     APPLY "DEFAULT-ACTION" to br-parts.
      903   END.
      904   ON VALUE-CHANGED OF BR-parts IN FRAME Dialog-Frame
      905   DO:
      906     if avail X_parts then do:
      907       ed-notes = X_parts.PS.
      908       display
      909       ed-notes
      910       with frame Dialog-Frame.
      911     end.
      912     else do:
      913         ed-notes = "".
      914         display
      915         ed-notes
      916         with frame Dialog-Frame.
      917     end.
      918   END.
      919   ON ENTRY OF ED-notes IN FRAME Dialog-Frame
      920   DO:
      921     APPLY "ENTRY" to br-parts.
      922     return no-apply.
      923   END.
      924   ON VALUE-CHANGED OF Rs-action IN FRAME Dialog-Frame
      925   DO:
      926     assign
      927     rs-action
      928     paction = rs-action.
      929     run  Myenable.
      930     RUn OpenBR in this-procedure ( input yes, input no, input '':U, input paction).
      931   END.
      932   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      933   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      934   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      935   on help of frame Dialog-Frame
      936   do:
      937     run gbl/app_help.p
      938       (input this-procedure :file-name
      939       ,input ''
      940       ,input ?
      941       ) no-error.
      942     if error-status :error then do:
      943       message
      944         "Ошибка при вызове помощи"
      945         error-status :get-message(1)
      946         view-as alert-box .
      947     end.
      948   end.
      949   run minbtn-set in this-procedure .
      950   on choose of b-help in frame Dialog-Frame
      951   do:
      952     apply "help":u to frame Dialog-Frame .
      953   end.
      954   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      955   procedure minbtn-set :
      956       do
      957           on error undo, return error return-value
      958           :
      959           define variable ii              as integer       no-undo .
      960           define variable fh              as widget-handle no-undo .
      961           define variable hh              as widget-handle no-undo .
      962           define variable v-h             as handle        extent 4 no-undo .
      963           define variable v-name-button   as character     no-undo .
      964           define variable v-help-old-x    as decimal       no-undo .
      965           define variable v-help-old-y    as decimal       no-undo .
      966           define variable v-help-old-size as decimal       no-undo .
      967           define variable v-frame-width   as decimal       no-undo .
      968           define variable jj              as integer       no-undo .
      969           do
      970               on error undo, return error
      971               :
      972               assign
      973                   v-frame-width = frame Dialog-Frame:width - 0.3
      974                   fh            = frame Dialog-Frame:first-child
      975                   hh            = fh:first-child
      976                   ii            = 1
      977                   .
      978               do while valid-handle(hh):
      979                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      980                   do:
      981                       case lc(hh:name) :
      982                           when "b-help" then
      983                               do:
      984                                   hh:load-image-up("cmp/b-help.bmp":u) .
      985                                   hh:load-image-down("cmp/b-help.bmp":u) .
      986                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      987                                   hh:TOOLTIP = "Помощь" .
      988                                   v-help-old-x = hh:column .
      989                                   v-help-old-y = hh:row    .
      990                                   v-help-old-size = hh:width .
      991                                   hh:width-chars = 2.5 .
      992                               end.
      993                           when "b-print" then
      994                               do:
      995                                   hh:load-image("cmp/b-print.bmp":u) .
      996                                   hh:TOOLTIP = "Печать" .
      997                                   v-h[ii] = hh:handle .
      998                                   ii = ii + 1 .
      999                                   hh:width-chars = 3 .
     1000                               end.
     1001                           when "b-history" or
     1002                           when "b-hist" then
     1003                               do:
     1004                                   hh:load-image("cmp/b-hist.bmp":u) .
     1005                                   hh:TOOLTIP = "История" .
     1006                                   v-h[ii] = hh:handle .
     1007                                   ii = ii + 1 .
     1008                                   hh:width-chars = 3 .
     1009                               end.
     1010                           when "b-sch" then
     1011                               do:
     1012                                   hh:load-image("cmp/b-sch.bmp":u) .
     1013                                   hh:TOOLTIP = "Установка Фильтра" .
     1014                                   v-h[ii] = hh:handle .
     1015                                   ii = ii + 1 .
     1016                                   hh:width-chars = 3 .
     1017                               end.
     1018                           when "b-hist-user" then
     1019                               do:
     1020                                   hh:load-image("cmp/b-hist.bmp":u) .
     1021                                   hh:TOOLTIP = "История пользователя" .
     1022                                   ii = ii + 1 .
     1023                               end.
     1024                       end case.
     1025                   end.
     1026                   hh = hh:next-sibling.
     1027               end.
     1028               b-help:column = v-frame-width - b-help:width-chars.
     1029               jj = 0.
     1030               repeat ii = 4 to 1 by -1 :
     1031                   if valid-handle (v-h[ii] ) then
     1032                   do:
     1033                       jj  = jj + 1 .
     1034                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1035                       v-h[ii]:row    = v-help-old-y .
     1036                   end.
     1037               end.
     1038           end.
     1039       end.
     1040   end procedure.
     1041   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1042   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1043   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1044   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1045   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1046   define variable v-diasize-current-frame-height as decimal   no-undo .
     1047   define variable v-diasize-change-size          as logical   no-undo .
     1048   define variable v-diasize-resize-button        as handle    no-undo .
     1049   define variable v-diasize-wndmax               as logical   no-undo .
     1050   define variable v-diasize-wndstore             as logical   no-undo .
     1051   define variable v-diasize-proc-name            as character no-undo .
     1052   define variable v-diasize-browse-handle        as handle    no-undo .
     1053   define variable v-diasize-browse-number        as integer   no-undo .
     1054   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1055   define temp-table temp-diasize-handle no-undo
     1056     field handle-value  as handle
     1057     field save-position as decimal
     1058     index xpk is primary unique handle-value
     1059     .
     1060   define temp-table temp-browse-handle no-undo
     1061     field browse-type   as character
     1062     field browse-number as integer
     1063     field browse-handle as handle
     1064     field original-size as decimal
     1065     index xpk is primary unique browse-type browse-number
     1066     index xie browse-type browse-handle
     1067   .
     1068   procedure diasize_change-height :
     1069     define input  parameter p-change-value  as decimal   no-undo .
     1070     define input  parameter p-move-resize   as logical   no-undo .
     1071     define variable v-field-group-handle    as handle    no-undo .
     1072     define variable v-object-handle         as handle    no-undo .
     1073     define variable v-frame-height          as decimal   no-undo .
     1074     define variable v-frame-virtual-height  as decimal   no-undo .
     1075     define variable v-browse-height         as decimal   no-undo .
     1076     define variable v-window-height         as decimal   no-undo .
     1077     define variable v-window-virtual-height as decimal   no-undo .
     1078     define variable v-change-sign           as integer   no-undo .
     1079     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1080     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1081     if p-change-value > 0
     1082     then do:
     1083       if frame Dialog-Frame :height + p-change-value
     1084           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1085       then do:
     1086         assign
     1087           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1088                           - (frame Dialog-Frame :height-chars)
     1089         .
     1090         if p-change-value <= 0
     1091         then do:
     1092           run diasize_position-resize-button in this-procedure .
     1093           return .
     1094         end.
     1095       end.
     1096     end.
     1097     if p-change-value < 0
     1098     then do:
     1099       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1100       then do:
     1101         assign
     1102           p-change-value = v-diasize-orig-frame-height
     1103                          - (frame Dialog-Frame :height-chars)
     1104         .
     1105         if p-change-value >= 0
     1106         then do:
     1107           run diasize_position-resize-button in this-procedure .
     1108           return .
     1109         end.
     1110       end.
     1111     end.
     1112     if p-change-value >= 0
     1113     then do:
     1114       assign
     1115         v-change-sign = 1
     1116       .
     1117     end.
     1118     else do:
     1119       assign
     1120         v-change-sign = -1
     1121       .
     1122     end.
     1123     assign
     1124       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1125     .
     1126     if p-change-value = 0
     1127     then do:
     1128       run diasize_position-resize-button in this-procedure .
     1129       return .
     1130     end.
     1131     move_block:
     1132     do
     1133     on error undo move_block, retry move_block
     1134     :
     1135       if retry
     1136       then do:
     1137         do
     1138         on error undo move_block, leave move_block
     1139         :
     1140           if p-change-value > 0
     1141           then do:
     1142             for each buf_temp-diasize-handle
     1143             on error undo, next
     1144             :
     1145               assign
     1146                 v-object-handle = buf_temp-diasize-handle.handle-value
     1147               .
     1148               if v-object-handle <> v-diasize-resize-button
     1149               then do:
     1150                 assign
     1151                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1152                 .
     1153               end.
     1154             end.
     1155             assign
     1156               v-diasize-browse-handle :height = v-browse-height
     1157             .
     1158             for each buf_temp-browse-handle
     1159               where buf_temp-browse-handle.browse-type = 'height':u
     1160             on error undo, next
     1161             :
     1162               assign
     1163                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1164               .
     1165             end.
     1166             assign
     1167               frame Dialog-Frame :height = v-frame-height
     1168             .
     1169             if frame Dialog-Frame :scrollable = true
     1170             then do:
     1171               assign
     1172                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1173               .
     1174             end.
     1175             run diasize_position-resize-button in this-procedure .
     1176           end.
     1177           else do:
     1178             if frame Dialog-Frame :scrollable = true
     1179             then do:
     1180               assign
     1181                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1182               .
     1183             end.
     1184             assign
     1185               frame Dialog-Frame :height = v-frame-height
     1186             .
     1187             assign
     1188               v-diasize-browse-handle :height = v-browse-height
     1189             .
     1190             for each buf_temp-browse-handle
     1191               where buf_temp-browse-handle.browse-type = 'height':u
     1192             on error undo, next
     1193             :
     1194               assign
     1195                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1196               .
     1197             end.
     1198             for each buf_temp-diasize-handle
     1199             on error undo, next
     1200             :
     1201               assign
     1202                 v-object-handle = buf_temp-diasize-handle.handle-value
     1203               .
     1204               if v-object-handle <> v-diasize-resize-button
     1205               then do:
     1206                 assign
     1207                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1208                 .
     1209               end.
     1210             end.
     1211             run diasize_position-resize-button in this-procedure .
     1212           end.
     1213           assign
     1214             v-diasize-change-size = false
     1215           .
     1216           leave move_block .
     1217         end.
     1218       end.
     1219       assign
     1220         v-diasize-need-full-display = true
     1221       .
     1222       if v-diasize-change-size = false
     1223       then do:
     1224         assign
     1225           v-diasize-change-size = true
     1226         .
     1227       end.
     1228       else do:
     1229         return .
     1230       end.
     1231       assign
     1232         v-frame-height = frame Dialog-Frame :height
     1233         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1234         v-browse-height = v-diasize-browse-handle :height
     1235       .
     1236       for each buf_temp-browse-handle
     1237         where buf_temp-browse-handle.browse-type = 'height':u
     1238       :
     1239         assign
     1240           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1241         .
     1242       end.
     1243       for each buf_temp-diasize-handle
     1244       :
     1245         delete buf_temp-diasize-handle .
     1246       end.
     1247       assign
     1248         v-field-group-handle = frame Dialog-Frame :first-child
     1249       .
     1250       do while valid-handle(v-field-group-handle)
     1251       :
     1252         assign
     1253           v-object-handle = v-field-group-handle :first-child
     1254         .
     1255         do while valid-handle(v-object-handle)
     1256         :
     1257           if  v-object-handle <> v-diasize-browse-handle :handle
     1258           and can-query(v-object-handle, "row")
     1259           and can-query(v-object-handle, "height")
     1260           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1261           then do:
     1262             find first buf_temp-browse-handle
     1263               where buf_temp-browse-handle.browse-type   = 'height':u
     1264                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1265               no-error .
     1266             if available buf_temp-browse-handle
     1267             then do:
     1268             end.
     1269             else do:
     1270               create buf_temp-diasize-handle .
     1271               assign
     1272                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1273                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1274               .
     1275             end.
     1276           end.
     1277           assign
     1278             v-object-handle = v-object-handle :next-sibling
     1279           .
     1280         end.
     1281         assign
     1282           v-field-group-handle = v-field-group-handle :next-sibling
     1283         .
     1284       end.
     1285       do with frame Dialog-Frame
     1286       :
     1287         hide v-diasize-resize-button .
     1288         assign
     1289           v-diasize-resize-button :row    = 1
     1290           v-diasize-resize-button :column = 1
     1291         .
     1292       end.
     1293       if p-change-value > 0
     1294       then do:
     1295         if frame Dialog-Frame :scrollable = true
     1296         then do:
     1297           assign
     1298             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1299             no-error .
     1300           if error-status :error
     1301           or error-status :get-message(1) <> ""
     1302           then do:
     1303             undo move_block, retry move_block .
     1304           end.
     1305         end.
     1306         assign
     1307           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1308           no-error .
     1309         if error-status :error
     1310         or error-status :get-message(1) <> ""
     1311         then do:
     1312           undo move_block, retry move_block .
     1313         end.
     1314         assign
     1315           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1316           no-error .
     1317         if error-status :error
     1318         or error-status :get-message(1) <> ""
     1319         then do:
     1320           undo move_block, retry move_block .
     1321         end.
     1322         for each buf_temp-browse-handle
     1323           where buf_temp-browse-handle.browse-type = 'height':u
     1324         on error undo move_block, retry move_block
     1325         :
     1326           assign
     1327             buf_temp-browse-handle.browse-handle :height
     1328               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1329             no-error .
     1330           if error-status :error
     1331           or error-status :get-message(1) <> ""
     1332           then do:
     1333             undo move_block, retry move_block .
     1334           end.
     1335         end.
     1336         for each buf_temp-diasize-handle
     1337         on error undo move_block, retry move_block
     1338         :
     1339           assign
     1340             v-object-handle = buf_temp-diasize-handle.handle-value
     1341           .
     1342           if v-object-handle <> v-diasize-resize-button
     1343           then do:
     1344             assign
     1345               v-object-handle :row = v-object-handle :row + p-change-value
     1346               no-error .
     1347             if error-status :error
     1348             or error-status :get-message(1) <> ""
     1349             then do:
     1350               undo move_block, retry move_block .
     1351             end.
     1352           end.
     1353         end.
     1354       end.
     1355       else do:
     1356         for each buf_temp-diasize-handle
     1357         on error undo move_block, retry move_block
     1358         :
     1359           assign
     1360             v-object-handle = buf_temp-diasize-handle.handle-value
     1361           .
     1362           if v-object-handle <> v-diasize-resize-button
     1363           then do:
     1364             assign
     1365               v-object-handle :row = v-object-handle :row + p-change-value
     1366               no-error .
     1367             if error-status :error
     1368             or error-status :get-message(1) <> ""
     1369             then do:
     1370               undo move_block, retry move_block .
     1371             end.
     1372           end.
     1373         end.
     1374         assign
     1375           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1376           no-error .
     1377         if error-status :error
     1378         or error-status :get-message(1) <> ""
     1379         then do:
     1380           undo move_block, retry move_block .
     1381         end.
     1382         for each buf_temp-browse-handle
     1383           where buf_temp-browse-handle.browse-type = 'height':u
     1384         on error undo move_block, retry move_block
     1385         :
     1386           assign
     1387             buf_temp-browse-handle.browse-handle :height
     1388               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1389             no-error .
     1390           if error-status :error
     1391           or error-status :get-message(1) <> ""
     1392           then do:
     1393             undo move_block, retry move_block .
     1394           end.
     1395         end.
     1396         assign
     1397           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1398           no-error .
     1399         if error-status :error
     1400         or error-status :get-message(1) <> ""
     1401         then do:
     1402           undo move_block, retry move_block .
     1403         end.
     1404         if frame Dialog-Frame :scrollable = true
     1405         then do:
     1406           assign
     1407             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1408             no-error .
     1409           if error-status :error
     1410           or error-status :get-message(1) <> ""
     1411           then do:
     1412             undo move_block, retry move_block .
     1413           end.
     1414         end.
     1415       end.
     1416       if p-move-resize = true
     1417       then do:
     1418         run diasize_position-resize-button in this-procedure .
     1419       end.
     1420       if v-diasize-wndstore = true
     1421       then do:
     1422         if connected("ub") = true
     1423         then do:
     1424           define variable v-cntxt-db-num        as integer   no-undo .
     1425           define variable v-cntxt-userid        as character no-undo .
     1426           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1427                                             , OUTPUT v-cntxt-userid
     1428                                             ) .
     1429           run gbl/wndsizew.p
     1430             (input  v-cntxt-db-num
     1431             ,input  v-cntxt-userid
     1432             ,input  v-diasize-proc-name
     1433             ,input  'height':u
     1434             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1435             ) .
     1436         end.
     1437       end.
     1438     end.
     1439     assign
     1440       v-diasize-change-size = false
     1441     .
     1442   end procedure.
     1443   procedure diasize_set-height :
     1444     define input  parameter p-new-height  as decimal   no-undo .
     1445     define input  parameter p-move-resize as logical   no-undo .
     1446     do
     1447     on error undo, return error return-value
     1448     :
     1449       run diasize_change-height in this-procedure
     1450         (input  (p-new-height - frame Dialog-Frame :height)
     1451         ,input  p-move-resize
     1452         ) .
     1453     end.
     1454   end procedure.
     1455   procedure diasize_change-width :
     1456     define input  parameter p-change-value as decimal   no-undo .
     1457     define input  parameter p-move-resize  as logical   no-undo .
     1458     define variable v-field-group-handle   as handle    no-undo .
     1459     define variable v-object-handle        as handle    no-undo .
     1460     define variable v-frame-width          as decimal   no-undo .
     1461     define variable v-frame-virtual-width  as decimal   no-undo .
     1462     define variable v-browse-width         as decimal   no-undo .
     1463     define variable v-window-width         as decimal   no-undo .
     1464     define variable v-window-virtual-width as decimal   no-undo .
     1465     define variable v-change-sign          as integer   no-undo .
     1466     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1467     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1468     if p-change-value > 0
     1469     then do:
     1470       if frame Dialog-Frame :width + p-change-value >
     1471           session :width-chars
     1472       then do:
     1473         assign
     1474           p-change-value = session :width-chars - frame Dialog-Frame :width
     1475         .
     1476         if p-change-value <= 0
     1477         then do:
     1478           run diasize_position-resize-button in this-procedure .
     1479           return .
     1480         end.
     1481       end.
     1482     end.
     1483     if p-change-value < 0
     1484     then do:
     1485       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1486       then do:
     1487         assign
     1488           p-change-value = v-diasize-orig-frame-width
     1489                          - frame Dialog-Frame :width
     1490         .
     1491         if p-change-value >= 0
     1492         then do:
     1493           run diasize_position-resize-button in this-procedure .
     1494           return .
     1495         end.
     1496       end.
     1497     end.
     1498     if p-change-value >= 0
     1499     then do:
     1500       assign
     1501         v-change-sign = 1
     1502       .
     1503     end.
     1504     else do:
     1505       assign
     1506         v-change-sign = -1
     1507       .
     1508     end.
     1509     assign
     1510       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1511     .
     1512     if p-change-value = 0
     1513     then do:
     1514       run diasize_position-resize-button in this-procedure .
     1515       return .
     1516     end.
     1517     move_block:
     1518     do
     1519     on error undo move_block, leave move_block
     1520     :
     1521       if retry
     1522       then do:
     1523         do
     1524         on error undo move_block, leave move_block
     1525         :
     1526           if p-change-value > 0
     1527           then do:
     1528             for each buf_temp-diasize-handle
     1529             on error undo, next
     1530             :
     1531               assign
     1532                 v-object-handle = buf_temp-diasize-handle.handle-value
     1533               .
     1534               if v-object-handle <> v-diasize-resize-button
     1535               then do:
     1536                 assign
     1537                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1538                 .
     1539               end.
     1540             end.
     1541             assign
     1542               v-diasize-browse-handle :width = v-browse-width
     1543             .
     1544             for each buf_temp-browse-handle
     1545               where buf_temp-browse-handle.browse-type = 'width':u
     1546             on error undo, next
     1547             :
     1548               assign
     1549                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1550               .
     1551             end.
     1552             assign
     1553               frame Dialog-Frame :width = v-frame-width
     1554             .
     1555             if frame Dialog-Frame :scrollable = true
     1556             then do:
     1557               assign
     1558                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1559               .
     1560             end.
     1561             run diasize_position-resize-button in this-procedure .
     1562           end.
     1563           else do:
     1564             if frame Dialog-Frame :scrollable = true
     1565             then do:
     1566               assign
     1567                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1568               .
     1569             end.
     1570             assign
     1571               frame Dialog-Frame :width = v-frame-width
     1572             .
     1573             for each buf_temp-browse-handle
     1574               where buf_temp-browse-handle.browse-type = 'width':u
     1575             on error undo, next
     1576             :
     1577               assign
     1578                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1579               .
     1580             end.
     1581             assign
     1582               v-diasize-browse-handle :width = v-browse-width
     1583             .
     1584             for each buf_temp-diasize-handle
     1585             on error undo, next
     1586             :
     1587               assign
     1588                 v-object-handle = buf_temp-diasize-handle.handle-value
     1589               .
     1590               if v-object-handle <> v-diasize-resize-button
     1591               then do:
     1592                 assign
     1593                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1594                 .
     1595               end.
     1596             end.
     1597             run diasize_position-resize-button in this-procedure .
     1598           end.
     1599           assign
     1600             v-diasize-change-size = false
     1601           .
     1602           leave move_block .
     1603         end.
     1604       end.
     1605       assign
     1606         v-diasize-need-full-display = true
     1607       .
     1608       if v-diasize-change-size = false
     1609       then do:
     1610         assign
     1611           v-diasize-change-size = true
     1612         .
     1613       end.
     1614       else do:
     1615         return .
     1616       end.
     1617       assign
     1618         v-frame-width = frame Dialog-Frame :width
     1619         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1620         v-browse-width = v-diasize-browse-handle :width
     1621       .
     1622       for each buf_temp-browse-handle
     1623         where buf_temp-browse-handle.browse-type = 'width':u
     1624       :
     1625         assign
     1626           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1627         .
     1628       end.
     1629       for each buf_temp-diasize-handle
     1630       :
     1631         delete buf_temp-diasize-handle .
     1632       end.
     1633       assign
     1634         v-field-group-handle = frame Dialog-Frame :first-child
     1635       .
     1636       do while valid-handle(v-field-group-handle)
     1637       :
     1638         assign
     1639           v-object-handle = v-field-group-handle :first-child
     1640         .
     1641         do while valid-handle(v-object-handle)
     1642         :
     1643           if  v-object-handle <> v-diasize-browse-handle :handle
     1644           and v-object-handle <> v-diasize-resize-button
     1645           and can-query(v-object-handle, "row")
     1646           and can-query(v-object-handle, "height")
     1647           and ( v-object-handle :col + v-object-handle :width
     1648                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1649               )
     1650           then do:
     1651             find first buf_temp-browse-handle
     1652               where buf_temp-browse-handle.browse-type   = 'width':u
     1653                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1654               no-error .
     1655             if available buf_temp-browse-handle
     1656             then do:
     1657             end.
     1658             else do:
     1659               create buf_temp-diasize-handle .
     1660               assign
     1661                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1662                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1663               .
     1664             end.
     1665           end.
     1666           assign
     1667             v-object-handle = v-object-handle :next-sibling
     1668           .
     1669         end.
     1670         assign
     1671           v-field-group-handle = v-field-group-handle :next-sibling
     1672         .
     1673       end.
     1674       do with frame Dialog-Frame
     1675       :
     1676         hide v-diasize-resize-button .
     1677         v-diasize-resize-button :row = 1.
     1678         v-diasize-resize-button :column = 1.
     1679       end.
     1680       if p-change-value > 0
     1681       then do:
     1682         if frame Dialog-Frame :scrollable = true
     1683         then do:
     1684           assign
     1685             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1686             no-error .
     1687           if error-status :error
     1688           or error-status :get-message(1) <> ""
     1689           then do:
     1690             undo move_block, retry move_block.
     1691           end.
     1692         end.
     1693         assign
     1694           frame Dialog-Frame :width = v-frame-width + p-change-value
     1695           no-error .
     1696         if error-status :error
     1697         or error-status :get-message(1) <> ""
     1698         then do:
     1699           undo move_block, retry move_block.
     1700         end.
     1701         assign
     1702           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1703         no-error .
     1704         if error-status :error
     1705         or error-status :get-message(1) <> ""
     1706         then do:
     1707           undo move_block, retry move_block.
     1708         end.
     1709         for each buf_temp-browse-handle
     1710           where buf_temp-browse-handle.browse-type = 'width':u
     1711         on error undo move_block, retry move_block
     1712         :
     1713           assign
     1714             buf_temp-browse-handle.browse-handle :width
     1715               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1716             no-error .
     1717           if error-status :error
     1718           or error-status :get-message(1) <> ""
     1719           then do:
     1720             undo move_block, retry move_block .
     1721           end.
     1722         end.
     1723         for each buf_temp-diasize-handle
     1724         on error undo move_block, retry move_block
     1725         :
     1726           assign
     1727             v-object-handle = buf_temp-diasize-handle.handle-value
     1728           .
     1729           if v-object-handle <> v-diasize-resize-button
     1730           then do:
     1731             assign
     1732               v-object-handle :col = v-object-handle :col + p-change-value
     1733               no-error .
     1734             if error-status :error
     1735             or error-status :get-message(1) <> ""
     1736             then do:
     1737               undo move_block, retry move_block .
     1738             end.
     1739           end.
     1740         end.
     1741       end.
     1742       else do:
     1743         for each buf_temp-diasize-handle
     1744         on error undo move_block, retry move_block
     1745         :
     1746           assign
     1747             v-object-handle = buf_temp-diasize-handle.handle-value
     1748           .
     1749           if v-object-handle <> v-diasize-resize-button
     1750           then do:
     1751             assign
     1752               v-object-handle :col = v-object-handle :col + p-change-value
     1753               no-error .
     1754             if error-status :error
     1755             or error-status :get-message(1) <> ""
     1756             then do:
     1757               undo move_block, retry move_block .
     1758             end.
     1759           end.
     1760         end.
     1761         for each buf_temp-browse-handle
     1762           where buf_temp-browse-handle.browse-type = 'width':u
     1763         on error undo move_block, retry move_block
     1764         :
     1765           assign
     1766             buf_temp-browse-handle.browse-handle :width
     1767               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1768             no-error .
     1769           if error-status :error
     1770           or error-status :get-message(1) <> ""
     1771           then do:
     1772             undo move_block, retry move_block .
     1773           end.
     1774         end.
     1775         assign
     1776           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1777           no-error .
     1778         if error-status :error
     1779         or error-status :get-message(1) <> ""
     1780         then do:
     1781           undo move_block, retry move_block.
     1782         end.
     1783         assign
     1784           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1785         no-error .
     1786         if error-status :error
     1787         or error-status :get-message(1) <> ""
     1788         then do:
     1789           undo move_block, retry move_block.
     1790         end.
     1791         if frame Dialog-Frame :scrollable = true
     1792         then do:
     1793           assign
     1794             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1795           no-error .
     1796           if error-status :error
     1797           or error-status :get-message(1) <> ""
     1798           then do:
     1799             undo move_block, retry move_block.
     1800           end.
     1801         end.
     1802       end.
     1803       if p-move-resize
     1804       then do:
     1805         run diasize_position-resize-button in this-procedure .
     1806       end.
     1807       if v-diasize-wndstore = true
     1808       then do:
     1809         if connected("ub") = true
     1810         then do:
     1811           define variable v-cntxt-db-num        as integer   no-undo .
     1812           define variable v-cntxt-userid        as character no-undo .
     1813           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1814                                             , OUTPUT v-cntxt-userid
     1815                                             ) .
     1816           run gbl/wndsizew.p
     1817             (input  v-cntxt-db-num
     1818             ,input  v-cntxt-userid
     1819             ,input  v-diasize-proc-name
     1820             ,input  'width':u
     1821             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1822             ) .
     1823         end.
     1824       end.
     1825     end.
     1826     assign
     1827       v-diasize-change-size = false
     1828     .
     1829   end procedure.
     1830   procedure diasize_set-width :
     1831     define input  parameter p-new-width  as decimal   no-undo .
     1832     define input  parameter p-move-resize as logical   no-undo .
     1833     do
     1834     on error undo, return error return-value
     1835     :
     1836       run diasize_change-width in this-procedure
     1837         (input  (p-new-width - frame Dialog-Frame :width)
     1838         ,input  p-move-resize
     1839         ) .
     1840     end.
     1841   end procedure.
     1842   procedure diasize_position-resize-button :
     1843     do with frame Dialog-Frame
     1844     :
     1845       hide v-diasize-resize-button .
     1846       assign
     1847         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1848                     - 1
     1849                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1850         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1851                     - 1
     1852                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1853       .
     1854       view v-diasize-resize-button .
     1855     end.
     1856   end procedure.
     1857   on alt-right anywhere
     1858   do:
     1859     run diasize_change-width in this-procedure
     1860       (input 1
     1861       ,input true
     1862       ) .
     1863     return no-apply .
     1864   end.
     1865   on alt-left anywhere
     1866   do:
     1867     run diasize_change-width in this-procedure
     1868       (input -1
     1869       ,input true
     1870       ) .
     1871     return no-apply .
     1872   end.
     1873   on alt-down anywhere
     1874   do:
     1875     run diasize_change-height in this-procedure
     1876       (input 1
     1877       ,input true
     1878       ) .
     1879     return no-apply .
     1880   end.
     1881   on alt-up anywhere
     1882   do:
     1883     run diasize_change-height in this-procedure
     1884       (input -1
     1885       ,input true
     1886       ) .
     1887     return no-apply .
     1888   end.
     1889   on alt-enter of frame Dialog-Frame
     1890   do:
     1891     run diasize_maximize in this-procedure
     1892       (input  ?
     1893       ).
     1894     return no-apply .
     1895   end.
     1896   procedure diasize_end-move :
     1897     do
     1898     on error undo, return error return-value
     1899     :
     1900       define variable v-row-delta as decimal   no-undo .
     1901       define variable v-col-delta as decimal   no-undo .
     1902       define variable v-new-row as decimal   no-undo .
     1903       define variable v-new-col as decimal   no-undo .
     1904       assign
     1905         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1906         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1907       .
     1908       assign
     1909         v-row-delta = v-new-row - frame Dialog-Frame :height
     1910         v-col-delta = v-new-col - frame Dialog-Frame :width
     1911       .
     1912       run diasize_change-height in this-procedure
     1913         (input v-row-delta
     1914         ,input true
     1915         ) .
     1916       run diasize_change-width in this-procedure
     1917         (input v-col-delta
     1918         ,input true
     1919         ) .
     1920     end.
     1921   end procedure.
     1922   procedure diasize_maximize :
     1923     define input  parameter p-action as logical   no-undo .
     1924     do
     1925     on error undo, return error return-value
     1926     :
     1927       if p-action = ?
     1928       then do:
     1929         if v-diasize-need-maximize = true
     1930         then do:
     1931           assign
     1932             p-action = true
     1933           .
     1934         end.
     1935         else do:
     1936           assign
     1937             p-action = false
     1938           .
     1939         end.
     1940       end.
     1941       if p-action = true
     1942       then do:
     1943         run diasize_change-height in this-procedure
     1944           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1945               - frame Dialog-Frame :height-chars
     1946           ,input true
     1947           ) .
     1948         run diasize_change-width in this-procedure
     1949           (input session :width-chars
     1950               - frame Dialog-Frame :width-chars
     1951           ,input true
     1952           ) .
     1953         assign
     1954           v-diasize-need-maximize = false
     1955         .
     1956       end.
     1957       else do:
     1958         run diasize_change-width in this-procedure
     1959           (input v-diasize-orig-frame-width
     1960               - frame Dialog-Frame :width-chars
     1961           ,input true
     1962           ) .
     1963         run diasize_change-height in this-procedure
     1964           (input v-diasize-orig-frame-height
     1965               - frame Dialog-Frame :height-chars
     1966           ,input true
     1967           ) .
     1968         assign
     1969           v-diasize-need-maximize = true
     1970         .
     1971       end.
     1972     end.
     1973   end procedure.
     1974   procedure diasize_restore-orig-size :
     1975     do
     1976     on error undo, return error return-value
     1977     :
     1978       assign
     1979         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1980         v-diasize-current-frame-height = frame Dialog-Frame :height
     1981       .
     1982       run diasize_set-height in this-procedure
     1983         (input  v-diasize-orig-frame-height
     1984         ,input  true
     1985         ) .
     1986       run diasize_set-width in this-procedure
     1987         (input  v-diasize-orig-frame-width
     1988         ,input  true
     1989         ) .
     1990     end.
     1991   end procedure.
     1992   procedure diasize_restore-current-size :
     1993     do
     1994     on error undo, return error return-value
     1995     :
     1996       run diasize_set-height in this-procedure
     1997         (input  v-diasize-current-frame-height
     1998         ,input  true
     1999         ) .
     2000       run diasize_set-width in this-procedure
     2001         (input  v-diasize-current-frame-width
     2002         ,input  true
     2003         ) .
     2004     end.
     2005   end procedure.
     2006   procedure diasize_set-browse-handle :
     2007     define input  parameter p-browse-handle as handle   no-undo .
     2008     define buffer buf_temp-browse-handle for temp-browse-handle .
     2009     do
     2010     on error undo, return error return-value
     2011     :
     2012       assign
     2013         v-diasize-browse-handle = p-browse-handle
     2014       .
     2015       for each buf_temp-browse-handle
     2016       on error undo, return error return-value
     2017       :
     2018         delete buf_temp-browse-handle .
     2019       end.
     2020     end.
     2021   end procedure.
     2022   procedure diasize_add_browse :
     2023     define input  parameter p-browse-type   as character no-undo .
     2024     define input  parameter p-browse-handle as handle    no-undo .
     2025     define buffer buf_temp-browse-handle for temp-browse-handle .
     2026     do
     2027     on error undo, return error return-value
     2028     :
     2029       assign
     2030         v-diasize-browse-number = v-diasize-browse-number + 1
     2031       .
     2032       create buf_temp-browse-handle .
     2033       assign
     2034         buf_temp-browse-handle.browse-type   = p-browse-type
     2035         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2036         buf_temp-browse-handle.browse-handle = p-browse-handle
     2037       .
     2038     end.
     2039   end procedure.
     2040   procedure diasize_init :
     2041     define variable v-default-value    as logical   no-undo .
     2042     define variable v-restore-saved    as logical   no-undo .
     2043     define variable v-resize-value-str as character no-undo .
     2044     do
     2045     on error undo, return error return-value
     2046     :
     2047       do with frame Dialog-Frame
     2048       :
     2049         assign
     2050           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2051           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2052           v-diasize-browse-handle     = browse BR-parts :handle
     2053         .
     2054         create button v-diasize-resize-button
     2055         assign
     2056           parent        = frame Dialog-Frame :first-child
     2057           label         = "s"
     2058           height-pixels = 16
     2059           width-pixels  = 16
     2060           visible       = true
     2061           sensitive     = true
     2062           movable       = true
     2063           triggers:
     2064             on end-move persistent run diasize_end-move in this-procedure .
     2065           end triggers.
     2066         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2067         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2068         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2069         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2070         assign
     2071           v-diasize-wndmax = false
     2072         .
     2073         if connected("ub") = true
     2074         then do:
     2075           define variable v-cntxt-db-num        as integer   no-undo .
     2076           define variable v-cntxt-userid        as character no-undo .
     2077           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2078                                             , OUTPUT v-cntxt-userid
     2079                                             ) .
     2080           run gbl/wndpar_r.p
     2081             (input  v-cntxt-db-num
     2082             ,input  v-cntxt-userid
     2083             ,input  'wndmax':U
     2084             ,output v-diasize-wndmax
     2085             ,output v-default-value
     2086             ) .
     2087         end.
     2088         assign
     2089           v-diasize-wndstore = false
     2090         .
     2091         if connected("ub") = true
     2092         then do:
     2093           run gbl/wndpar_r.p
     2094             (input  v-cntxt-db-num
     2095             ,input  v-cntxt-userid
     2096             ,input  'wndstore':U
     2097             ,output v-diasize-wndstore
     2098             ,output v-default-value
     2099             ) .
     2100         end.
     2101         assign
     2102           v-diasize-proc-name = entry(1, program-name(2), '.')
     2103         .
     2104         if v-diasize-wndstore = true
     2105         then do:
     2106           assign
     2107             v-restore-saved = false
     2108           .
     2109           if connected("ub") = true
     2110           then do:
     2111             run gbl/wndsizer.p
     2112               (input  v-cntxt-db-num
     2113               ,input  v-cntxt-userid
     2114               ,input  v-diasize-proc-name
     2115               ,input  'height':u
     2116               ,output v-resize-value-str
     2117               ) .
     2118             if v-resize-value-str <> '':U
     2119             then do:
     2120               run diasize_change-height in this-procedure
     2121                 (input  integer(v-resize-value-str)
     2122                 ,input  true
     2123                 ) .
     2124               assign
     2125                 v-restore-saved = true
     2126               .
     2127             end.
     2128           end.
     2129           if connected("ub") = true
     2130           then do:
     2131             run gbl/wndsizer.p
     2132               (input  v-cntxt-db-num
     2133               ,input  v-cntxt-userid
     2134               ,input  v-diasize-proc-name
     2135               ,input  'width':u
     2136               ,output v-resize-value-str
     2137               ) .
     2138             if v-resize-value-str <> '':U
     2139             then do:
     2140               run diasize_change-width in this-procedure
     2141                 (input  integer(v-resize-value-str)
     2142                 ,input  true
     2143                 ) .
     2144               assign
     2145                 v-restore-saved = true
     2146               .
     2147             end.
     2148           end.
     2149           if v-restore-saved <> true
     2150           then do:
     2151             if v-diasize-wndmax = true
     2152             then do:
     2153               run diasize_maximize in this-procedure
     2154                 (input  true
     2155                 ) .
     2156             end.
     2157           end.
     2158         end.
     2159         else do:
     2160           if v-diasize-wndmax = true
     2161           then do:
     2162             run diasize_maximize in this-procedure
     2163               (input  true
     2164               ) .
     2165           end.
     2166         end.
     2167       end.
     2168     end.
     2169   end procedure.
     2170   procedure diasize_need-full-display :
     2171     define output parameter p-need-full-display as logical   no-undo .
     2172     do
     2173     on error undo, return error return-value
     2174     :
     2175       assign
     2176         p-need-full-display = v-diasize-need-full-display
     2177       .
     2178       assign
     2179         v-diasize-need-full-display = false
     2180       .
     2181     end.
     2182   end procedure.
     2183   procedure get-context :
     2184      define output parameter p-db-num as integer          no-undo.
     2185      define output parameter p-user-id as character        no-undo.
     2186      define variable v-login               as character    no-undo.
     2187      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2188      define buffer buf_user-login  for ub.user-login .
     2189      do
     2190      on error undo, return error
     2191      :
     2192            FIND FIRST buf_sys-ctrl no-lock.
     2193            ASSIGN
     2194               v-login = USERID("ub")
     2195               p-db-num = buf_sys-ctrl.db-num
     2196            .
     2197            FIND FIRST buf_user-login
     2198                 WHERE buf_user-login.db-num = p-db-num
     2199                   AND buf_user-login.user-login = v-login
     2200                 no-lock
     2201                 no-error
     2202                 .
     2203            IF AVAILABLE buf_user-login
     2204            THEN DO:
     2205               assign
     2206                  p-user-id = buf_user-login.user-id
     2207               .
     2208            END.
     2209      end.
     2210   end procedure.
     2211       run diasize_init in this-procedure .
     2212   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2213   do:
     2214     BR-parts :SET-REPOSITIONED-ROW(5, "CONDITIONAL") .
     2215   end.
     2216   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2217   procedure set-filter-name :
     2218   define input parameter p-filter-name as character no-undo .
     2219     do with frame Dialog-Frame:
     2220       if p-filter-name > "" then do:
     2221         assign
     2222           frame Dialog-Frame:title
     2223             = frame Dialog-Frame:title + "   ФИЛЬТР: " + p-filter-name.
     2224         .
     2225         assign
     2226           b-sch :tooltip = "Установлен фильтр " + p-filter-name
     2227         .
     2228       end.
     2229       else do:
     2230         assign
     2231           b-sch :tooltip = ""
     2232         .
     2233       end.
     2234     end.
     2235   end procedure.
     2236   MAIN-BLOCK:
     2237   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2238      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2239   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2240     run mainmenu_getcntxt in parparentproc
     2241       (output v-cntxt-db-num
     2242       ,output v-cntxt-userid
     2243       ,output v-cntxt-level
     2244       ,output v-cntxt-host-code-obj
     2245       ,output v-cntxt-obj-type
     2246       ,output v-cntxt-obj-code
     2247       ,output v-cntxt-db-num-obj
     2248       ,output v-cntxt-is-admin
     2249       ) .
     2250     FIND FIRST buf_goods No-LOCK WHERE
     2251                buf_goods.artic = partic AND
     2252                buf_goods.prod-type = pprod-type AND
     2253                buf_goods.prod-code = pprod-code NO-ERROR.
     2254     IF NOT AVAIL buf_goods then do:
     2255         message
     2256         vss-workfile vss-revision vss-description skip
     2257         "Не найден товар " partic pprod-type string(pprod-code) skip
     2258         view-as alert-box error .
     2259       return "error".
     2260     END.
     2261     assign
     2262     for-gds = buf_goods.artic + " " + buf_goods.prod-type + string(buf_goods.prod-code) + " " + buf_goods.gds-name
     2263     for-gds-code = buf_goods.gds-code.
     2264     FIND FIRST ub.clients No-LOCK WHERE
     2265                ub.clients.obj-type = p-obj-type AND
     2266                ub.clients.obj-code = p-obj-code No-ERROR.
     2267     IF NOT AVAIL ub.clients then do:
     2268         message
     2269         vss-workfile vss-revision vss-description skip
     2270         "Не найден объект " p-obj-type p-obj-code skip
     2271         view-as alert-box error .
     2272       return "error".
     2273     end.
     2274     RUN MyEnable.
     2275     RUn OpenBR in this-procedure ( input yes, input no, input '':U, input paction).
     2276     WAIT-FOR GO OF FRAME Dialog-Frame.
     2277   END.
     2278   RUN disable_UI.
     2279   PROCEDURE disable_UI :
     2280     HIDE FRAME Dialog-Frame.
     2281   END PROCEDURE.
     2282   PROCEDURE enable_UI :
     2283     DISPLAY Rs-action ED-notes for-gds for-gds-code
     2284         WITH FRAME Dialog-Frame.
     2285     ENABLE B-exit B-gds B-doc B-part B-mark B-case B-sch B-Help Rs-action
     2286            BR-parts ED-notes for-gds for-gds-code
     2287         WITH FRAME Dialog-Frame.
     2288     VIEW FRAME Dialog-Frame.
     2289   END PROCEDURE.
     2290   PROCEDURE fuse-parts :
     2291   define variable ii as integer no-undo.
     2292   define variable glog as logical no-undo .
     2293   glog = no.
     2294   message "Вы уверены, что хотите слить отмеченные партии?"
     2295   view-as alert-box QUESTION buttons YES-NO
     2296   update glog.
     2297   if not glog then return no-apply.
     2298   _ii:
     2299   do ii = 1 to num-entries(mark-list)
     2300   ON ERROR UNDO, return error
     2301   ON STOP UNDO, return error:
     2302       find first X_parts No-LOCK where
     2303                  recid(X_parts) = integer(entry(ii, mark-list)) NO-ERROR.
     2304       if not avail X_parts then NEXT _ii.
     2305       run trg/partjoin.p (
     2306                     input X_parts.obj-type,
     2307                     input X_parts.obj-code,
     2308                     input X_parts.artic,
     2309                     input X_parts.prod-type,
     2310                     input X_parts.prod-code,
     2311                     input X_parts.in-code,
     2312                     input X_parts.out-code,
     2313                     input X_parts.part-code) no-error.
     2314       if error-status:error then do:
     2315           message "Не удалось слить партию с номерос X_parts.part-code" skip
     2316             error-status:get-message(1)
     2317             view-as alert-box ERROR.
     2318           UNDO _ii, return error.
     2319       end.
     2320   end.
     2321   END PROCEDURE.
     2322   PROCEDURE loc-mark :
     2323     if not available X_parts then do:
     2324       message "Неправильный выбор строки.".
     2325       return no-apply.
     2326     end.
     2327   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2328   define variable v-str-recid17 as character no-undo .
     2329   define variable v-num-entry17 as integer   no-undo .
     2330   assign
     2331     v-str-recid17 = trim( string( recid( X_parts ) , "->>>>>>>>>>>9":U ) )
     2332     v-num-entry17 = lookup( v-str-recid17 , mark-list )
     2333   .
     2334   if v-num-entry17 > 0 then do:
     2335     assign
     2336       entry( v-num-entry17, mark-list ) = "":U
     2337       mark-list = trim( replace( mark-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     2338     .
     2339   end.
     2340   else do:
     2341     assign
     2342       mark-list = mark-list + ( if mark-list = "":U then "":U else chr(44) ) + v-str-recid17
     2343     .
     2344   end.
     2345     display
     2346     string(lookup (string (recid (X_parts)), mark-list ) > 0, "*/":U)  @ mark
     2347     with browse BR-parts.
     2348   END PROCEDURE.
     2349   PROCEDURE MyEnable :
     2350     assign
     2351     rs-action = paction.
     2352     case paction:
     2353       when "split":U then do:
     2354         b-case:label in frame Dialog-Frame = "&Коробка".
     2355       end.
     2356       when "fuse":U then do:
     2357         b-case:label = "В &коробку".
     2358       end.
     2359     end case.
     2360     DISPLAY ED-notes for-gds rs-action
     2361         WITH FRAME Dialog-Frame.
     2362     ENABLE B-exit
     2363     B-case when ub.clients.db-num = v-cntxt-db-num
     2364     RS-action
     2365     b-mark when paction = "fuse":U
     2366     B-sch B-gds B-doc B-Help B-part BR-parts ED-notes for-gds
     2367         WITH FRAME Dialog-Frame.
     2368     if paction = "split":U then
     2369     hide b-mark in frame Dialog-Frame .
     2370     VIEW FRAME Dialog-Frame.
     2371   END PROCEDURE.
     2372   PROCEDURE OpenBr :
     2373   define input  parameter p-open-query     as logical   no-undo .
     2374   define input  parameter p-find-next      as logical   no-undo .
     2375   define input  parameter p-find-condition as character no-undo .
     2376   define input parameter loc-action as character no-undo .
     2377   define variable l-query-was-opened as logical no-undo .
     2378   run waitfram-show in this-procedure ("Ждите...").
     2379   define variable sort-column-phrase as character no-undo .
     2380   case sort-column-name :
     2381     when "" then do:
     2382       assign
     2383         sort-column-phrase = ""
     2384       .
     2385     end.
     2386     otherwise do:
     2387       assign
     2388         sort-column-phrase = "by " + sort-column-name
     2389       .
     2390     end.
     2391   end case.
     2392   CASE p-mode:
     2393       when 'объект':U then do:
     2394           ASSIGN frame Dialog-Frame:TITLE = "Партии товаров с двумя ед.изм. на объекте " + p-obj-type + string(p-obj-code)
     2395           filter-point = filter-point0 + p-mode
     2396           filter-label = substitute("&1 Один объект", filter-label0)
     2397           .
     2398           case paction:
     2399             when "split":U then do:
     2400   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2401   define variable  l-disable-where-19  as logical   no-undo .
     2402   define variable  l-filter-open-19    as logical   .
     2403   define variable  flt-rec-19       as recid     no-undo .
     2404   define variable  filter-name-19      as character no-undo .
     2405   define variable  where-phrase-19     as character no-undo .
     2406   define variable  sort-phrase-19      as character no-undo .
     2407   define variable  where-phrase-rus-19 as character no-undo .
     2408   define variable  sort-phrase-rus-19  as character no-undo .
     2409     run waitfram-show in this-procedure
     2410       (input "ЖДИТЕ ..."
     2411       ).
     2412   run gbl/flt-get.p
     2413     (input filter-point
     2414     ,output flt-rec-19
     2415     ,output filter-name-19
     2416     ,output where-phrase-19
     2417     ,output sort-phrase-19
     2418     ,output where-phrase-rus-19
     2419     ,output sort-phrase-rus-19
     2420     ).
     2421       run set-filter-name in this-procedure
     2422         (INPUT filter-name-19
     2423         ) no-error .
     2424     assign
     2425       l-filter-open-19 = false
     2426     .
     2427     if flt-rec-19 <> ?
     2428       or sort-column-phrase > ""
     2429     then do:
     2430       define variable  parameter-2-19 as character no-undo .
     2431       define variable  parameter-3-19 as character no-undo .
     2432       define variable  parameter-4-19 as character no-undo .
     2433       define variable  parameter-5-19 as character no-undo .
     2434       define variable  parameter-6-19 as character no-undo .
     2435       define variable  parameter-7-19 as character no-undo .
     2436         assign
     2437         parameter-3-19 =
     2438                                 "FOR EACH X_parts NO-LOCK"
     2439         parameter-4-19 =
     2440           (
     2441             if (" X_parts.artic = partic AND X_parts.prod-type = pprod-type AND X_parts.prod-code = pprod-code AND X_parts.obj-type = p-obj-type AND X_parts.obj-code = p-obj-code AND X_parts.cli-qnty > 1 AND X_parts.out-code = 'free-zone':U " + " " + where-phrase-19) <> ""
     2442             then  substitute('X_parts.artic = &1&2&1 AND X_parts.prod-type = &1&3&1 AND X_parts.prod-code = &4 AND X_parts.obj-type = &1&5&1 AND X_parts.obj-code = &6 AND X_parts.cli-qnty > 1 AND X_parts.out-code = &1&7&1 '                                  , chr(34), partic, pprod-type, pprod-code, p-obj-type, p-obj-code, 'free-zone':U) + " " + where-phrase-19
     2443             else "true"
     2444           )
     2445         parameter-5-19 = (" " + "" + " " + "")
     2446         parameter-6-19 = if sort-phrase-19 = ''
     2447                              then
     2448           (
     2449           " " + " " +
     2450             " " + sort-column-phrase +
     2451           " " + "  "
     2452           )
     2453                              else
     2454           (
     2455           " " + " " +
     2456             " " + sort-column-phrase +
     2457           " " + sort-phrase-19
     2458           )
     2459         parameter-7-19 =
     2460           " indexed-reposition  "
     2461       .
     2462       do
     2463       on stop undo, leave
     2464       on error undo, leave
     2465       :
     2466         assign
     2467           l-disable-where-19 =
     2468             (" X_parts.artic = partic AND X_parts.prod-type = pprod-type AND X_parts.prod-code = pprod-code AND X_parts.obj-type = p-obj-type AND X_parts.obj-code = p-obj-code AND X_parts.cli-qnty > 1 AND X_parts.out-code = 'free-zone':U " + " " + where-phrase-19 = "")
     2469         .
     2470         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     2471                             ,input QUERY br-parts:handle
     2472                             ,input parameter-3-19
     2473                             ,input parameter-4-19
     2474                             ,input parameter-5-19
     2475                             ,input parameter-6-19
     2476                             ,input parameter-7-19
     2477                             )
     2478         .
     2479         assign
     2480           l-filter-open-19 = true
     2481         .
     2482       end.
     2483       if l-filter-open-19 = false then do:
     2484         message
     2485           "Ошибка при фильтрации / сортировке" skip
     2486           "Будут показаны записи без учета фильтра" skip
     2487           view-as alert-box .
     2488       end.
     2489       else do:
     2490           assign
     2491             l-query-was-opened = true
     2492           .
     2493       end.
     2494     end.
     2495     if l-filter-open-19 = false then do:
     2496       OPEN QUERY br-parts FOR EACH X_parts NO-LOCK
     2497         where  X_parts.artic = partic AND X_parts.prod-type = pprod-type AND X_parts.prod-code = pprod-code AND X_parts.obj-type = p-obj-type AND X_parts.obj-code = p-obj-code AND X_parts.cli-qnty > 1 AND X_parts.out-code = 'free-zone':U
     2498         indexed-reposition
     2499     .
     2500         assign
     2501           l-query-was-opened = true
     2502         .
     2503     end.
     2504     run waitfram-hide in this-procedure .
     2505             end.
     2506             when "fuse":U then do:
     2507   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2508   define variable  l-disable-where-21  as logical   no-undo .
     2509   define variable  l-filter-open-21    as logical   .
     2510   define variable  flt-rec-21       as recid     no-undo .
     2511   define variable  filter-name-21      as character no-undo .
     2512   define variable  where-phrase-21     as character no-undo .
     2513   define variable  sort-phrase-21      as character no-undo .
     2514   define variable  where-phrase-rus-21 as character no-undo .
     2515   define variable  sort-phrase-rus-21  as character no-undo .
     2516     run waitfram-show in this-procedure
     2517       (input "ЖДИТЕ ..."
     2518       ).
     2519   run gbl/flt-get.p
     2520     (input filter-point
     2521     ,output flt-rec-21
     2522     ,output filter-name-21
     2523     ,output where-phrase-21
     2524     ,output sort-phrase-21
     2525     ,output where-phrase-rus-21
     2526     ,output sort-phrase-rus-21
     2527     ).
     2528       run set-filter-name in this-procedure
     2529         (INPUT filter-name-21
     2530         ) no-error .
     2531     assign
     2532       l-filter-open-21 = false
     2533     .
     2534     if flt-rec-21 <> ?
     2535       or sort-column-phrase > ""
     2536     then do:
     2537       define variable  parameter-2-21 as character no-undo .
     2538       define variable  parameter-3-21 as character no-undo .
     2539       define variable  parameter-4-21 as character no-undo .
     2540       define variable  parameter-5-21 as character no-undo .
     2541       define variable  parameter-6-21 as character no-undo .
     2542       define variable  parameter-7-21 as character no-undo .
     2543         assign
     2544         parameter-3-21 =
     2545                                 "FOR EACH X_parts NO-LOCK"
     2546         parameter-4-21 =
     2547           (
     2548             if (" X_parts.artic = partic AND X_parts.prod-type = pprod-type AND X_parts.prod-code = pprod-code AND X_parts.obj-type = p-obj-type AND X_parts.obj-code = p-obj-code AND X_parts.cli-qnty = 1 AND X_parts.out-code = 'free-zone':U " + " " + where-phrase-21) <> ""
     2549             then  substitute('X_parts.artic = &1&2&1 AND X_parts.prod-type = &1&3&1 AND X_parts.prod-code = &4 AND X_parts.obj-type = &1&5&1 AND X_parts.obj-code = &6 AND X_parts.cli-qnty = 1 AND X_parts.out-code = &1&7&1 '                                 , chr(34), partic, pprod-type, pprod-code, p-obj-type, p-obj-code, 'free-zone':U) + " " + where-phrase-21
     2550             else "true"
     2551           )
     2552         parameter-5-21 = (" " + "" + " " + "")
     2553         parameter-6-21 = if sort-phrase-21 = ''
     2554                              then
     2555           (
     2556           " " + " " +
     2557             " " + sort-column-phrase +
     2558           " " + "  "
     2559           )
     2560                              else
     2561           (
     2562           " " + " " +
     2563             " " + sort-column-phrase +
     2564           " " + sort-phrase-21
     2565           )
     2566         parameter-7-21 =
     2567           " indexed-reposition  "
     2568       .
     2569       do
     2570       on stop undo, leave
     2571       on error undo, leave
     2572       :
     2573         assign
     2574           l-disable-where-21 =
     2575             (" X_parts.artic = partic AND X_parts.prod-type = pprod-type AND X_parts.prod-code = pprod-code AND X_parts.obj-type = p-obj-type AND X_parts.obj-code = p-obj-code AND X_parts.cli-qnty = 1 AND X_parts.out-code = 'free-zone':U " + " " + where-phrase-21 = "")
     2576         .
     2577         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     2578                             ,input QUERY br-parts:handle
     2579                             ,input parameter-3-21
     2580                             ,input parameter-4-21
     2581                             ,input parameter-5-21
     2582                             ,input parameter-6-21
     2583                             ,input parameter-7-21
     2584                             )
     2585         .
     2586         assign
     2587           l-filter-open-21 = true
     2588         .
     2589       end.
     2590       if l-filter-open-21 = false then do:
     2591         message
     2592           "Ошибка при фильтрации / сортировке" skip
     2593           "Будут показаны записи без учета фильтра" skip
     2594           view-as alert-box .
     2595       end.
     2596       else do:
     2597           assign
     2598             l-query-was-opened = true
     2599           .
     2600       end.
     2601     end.
     2602     if l-filter-open-21 = false then do:
     2603       OPEN QUERY br-parts FOR EACH X_parts NO-LOCK
     2604         where  X_parts.artic = partic AND X_parts.prod-type = pprod-type AND X_parts.prod-code = pprod-code AND X_parts.obj-type = p-obj-type AND X_parts.obj-code = p-obj-code AND X_parts.cli-qnty = 1 AND X_parts.out-code = 'free-zone':U
     2605         indexed-reposition
     2606     .
     2607         assign
     2608           l-query-was-opened = true
     2609         .
     2610     end.
     2611     run waitfram-hide in this-procedure .
     2612             end.
     2613           end case.
     2614       end.
     2615   END CASE.
     2616   run waitfram-hide in this-procedure .
     2617   APPLY "VALUE-CHANGED" TO br-parts.
     2618   APPLY "ENTRY" TO br-parts.
     2619   APPLY "VALUE-CHANGED" TO br-parts.
     2620   END PROCEDURE.
