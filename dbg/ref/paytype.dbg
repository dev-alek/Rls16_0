      116   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      117   define new shared variable PrintCopiesCounter as integer   no-undo initial 1 .
      118   define new shared variable RepPathName        as character no-undo .
      119   define new shared variable PrintRubl          as logical   no-undo .
      120   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      121   procedure cur-time :
      122      define output parameter p-today as date      no-undo .
      123      define output parameter p-time  as integer   no-undo .
      124     do
      125     on error undo, return error
      126     :
      127       define variable v-date1 as date      no-undo .
      128       define variable v-date2 as date      no-undo .
      129       define variable v-time  as integer   no-undo .
      130       assign
      131         v-date1 = today
      132         v-time  = time
      133         v-date2 = today
      134       .
      135       if v-date1 <> v-date2
      136       then do:
      137         assign
      138           v-date1 = today
      139           v-time  = v-time
      140         .
      141       end.
      142       assign
      143         p-today = v-date1
      144         p-time  = v-time
      145       .
      146     end.
      147   end.
      148   function cur-time-date returns character
      149   :
      150     return string(today, '99/99/9999':U) .
      151   end.
      152   function cur-time-mjd returns decimal
      153   :
      154     define variable v-date as date      no-undo .
      155     define variable v-time as integer   no-undo .
      156     run cur-time in this-procedure
      157       (output v-date
      158       ,output v-time
      159       ) .
      160     return integer(v-date) - 2400002 + (v-time / 86400) .
      161   end.
      162   function cur-time-get-ending-index returns integer
      163   (input p-number as integer
      164   )
      165   :
      166     if p-number < 0
      167     or p-number = ?
      168     then do:
      169       return 1 .
      170     end.
      171     define variable v-rest as integer   no-undo .
      172     assign
      173       p-number = p-number modulo 100
      174     .
      175     if p-number < 20
      176     then do:
      177       assign
      178         v-rest = p-number
      179       .
      180     end.
      181     else do:
      182       assign
      183         v-rest = p-number modulo 10
      184       .
      185     end.
      186     case v-rest :
      187       when 1
      188       then do:
      189         return 2 .
      190       end.
      191       when 2 or
      192       when 3 or
      193       when 4
      194       then do:
      195         return 3 .
      196       end.
      197       otherwise do:
      198         return 1 .
      199       end.
      200     end case .
      201   end.
      202   procedure cur-time-mjd-to-date :
      203      define input  parameter i-mjd-diff as decimal no-undo.
      204      define output parameter o-Date     as date    no-undo.
      205      define output parameter o-Time     as integer no-undo.
      206      define variable v-day-number as integer   no-undo .
      207      if    i-mjd-diff < 0
      208         or i-mjd-diff = ?
      209      then do:
      210         return "?" .
      211      end.
      212      assign
      213         v-day-number = truncate(i-mjd-diff,0).
      214         o-Date = date(v-day-number + 2400002).
      215         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      216     .
      217   end.
      218   function cur-time-mjd-to-string returns character
      219   (input p-mjd-diff as decimal
      220   )
      221   :
      222     define variable v-day-number as integer   no-undo .
      223     define variable v-seconds    as integer   no-undo .
      224     define variable v-hour       as integer   no-undo .
      225     define variable v-min        as integer   no-undo .
      226     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      227     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      228     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      229     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      230     if p-mjd-diff < 0
      231     or p-mjd-diff = ?
      232     then do:
      233       return "?" .
      234     end.
      235     assign
      236       v-day-number = integer(truncate(p-mjd-diff,0))
      237       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      238     .
      239     if v-seconds > 86400
      240     then do:
      241       assign
      242         v-seconds = 86400 - 1
      243       .
      244     end.
      245     if v-seconds < 0
      246     then do:
      247       assign
      248         v-seconds = 0
      249       .
      250     end.
      251     assign
      252       v-hour = truncate(v-seconds / 3600, 0)
      253     .
      254     assign
      255       v-seconds = v-seconds modulo 3600
      256     .
      257     assign
      258       v-min = truncate(v-seconds / 60, 0)
      259     .
      260     assign
      261       v-seconds = v-seconds modulo 60
      262     .
      263     return
      264         (if v-day-number <> 0
      265           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      266           else ""
      267         )
      268       + (if v-day-number <> 0 or v-hour <> 0
      269           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      270           else ""
      271         )
      272       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      273           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      274           else ""
      275         )
      276       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      277       .
      278   end.
      279   function cur-time-string returns character
      280   :
      281     define variable v-date as date      no-undo .
      282     define variable v-time as integer   no-undo .
      283     run cur-time in this-procedure
      284       (output v-date
      285       ,output v-time
      286       ) .
      287     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      288   end.
      289   function cur-time-string-sec returns character
      290   :
      291     define variable v-date as date      no-undo .
      292     define variable v-time as integer   no-undo .
      293     run cur-time in this-procedure
      294       (output v-date
      295       ,output v-time
      296       ) .
      297     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      298   end.
      299   function cur-time-custom  returns character
      300   (input p-prefix as character
      301   ,input p-date-format as character
      302   ,input p-delimiter as character
      303   ,input p-time-format as character
      304   ,input p-suffix as character
      305   )
      306   :
      307     define variable v-date as date      no-undo .
      308     define variable v-time as integer   no-undo .
      309     run cur-time in this-procedure
      310       (output v-date
      311       ,output v-time
      312       ) .
      313     return
      314       p-prefix
      315       + string(v-date, p-date-format)
      316       + p-delimiter
      317       + string(v-time, p-time-format)
      318       + p-suffix
      319       .
      320   end.
      321   function cur-time-print  returns character
      322   :
      323     define variable v-date as date      no-undo .
      324     define variable v-time as integer   no-undo .
      325     run cur-time in this-procedure
      326       (output v-date
      327       ,output v-time
      328       ) .
      329     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      330   end.
      331   function cur-time-datetime returns datetime
      332   :
      333     define variable v-char as character no-undo .
      334     define variable v-datetime as datetime no-undo .
      335     v-char = cur-time-string().
      336     v-datetime = datetime(v-char).
      337     return  v-datetime.
      338   end.
      339   function cur-time-string-msec returns character
      340   :
      341     define variable v-date as datetime  no-undo .
      342     v-date = now.
      343     return string(v-date) .
      344   end.
      345   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      346     define variable v-cntxt-db-num        as integer   no-undo .
      347     define variable v-cntxt-userid        as character no-undo .
      348     define variable v-cntxt-level         as character no-undo .
