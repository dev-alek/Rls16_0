     1102   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1103   procedure minbtn-set :
     1104       do
     1105           on error undo, return error return-value
     1106           :
     1107           define variable ii              as integer       no-undo .
     1108           define variable fh              as widget-handle no-undo .
     1109           define variable hh              as widget-handle no-undo .
     1110           define variable v-h             as handle        extent 4 no-undo .
     1111           define variable v-name-button   as character     no-undo .
     1112           define variable v-help-old-x    as decimal       no-undo .
     1113           define variable v-help-old-y    as decimal       no-undo .
     1114           define variable v-help-old-size as decimal       no-undo .
     1115           define variable v-frame-width   as decimal       no-undo .
     1116           define variable jj              as integer       no-undo .
     1117           do
     1118               on error undo, return error
     1119               :
     1120               assign
     1121                   v-frame-width = frame d-pay-type:width - 0.3
     1122                   fh            = frame d-pay-type:first-child
     1123                   hh            = fh:first-child
     1124                   ii            = 1
     1125                   .
     1126               do while valid-handle(hh):
     1127                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1128                   do:
     1129                       case lc(hh:name) :
     1130                           when "b-help" then
     1131                               do:
     1132                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1133                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1134                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1135                                   hh:TOOLTIP = "Помощь" .
     1136                                   v-help-old-x = hh:column .
     1137                                   v-help-old-y = hh:row    .
     1138                                   v-help-old-size = hh:width .
     1139                                   hh:width-chars = 2.5 .
     1140                               end.
     1141                           when "b-print" then
     1142                               do:
     1143                                   hh:load-image("cmp/b-print.bmp":u) .
     1144                                   hh:TOOLTIP = "Печать" .
     1145                                   v-h[ii] = hh:handle .
     1146                                   ii = ii + 1 .
     1147                                   hh:width-chars = 3 .
     1148                               end.
     1149                           when "b-history" or
     1150                           when "b-hist" then
     1151                               do:
     1152                                   hh:load-image("cmp/b-hist.bmp":u) .
     1153                                   hh:TOOLTIP = "История" .
     1154                                   v-h[ii] = hh:handle .
     1155                                   ii = ii + 1 .
     1156                                   hh:width-chars = 3 .
     1157                               end.
     1158                           when "b-sch" then
     1159                               do:
     1160                                   hh:load-image("cmp/b-sch.bmp":u) .
     1161                                   hh:TOOLTIP = "Установка Фильтра" .
     1162                                   v-h[ii] = hh:handle .
     1163                                   ii = ii + 1 .
     1164                                   hh:width-chars = 3 .
     1165                               end.
     1166                           when "b-hist-user" then
     1167                               do:
     1168                                   hh:load-image("cmp/b-hist.bmp":u) .
     1169                                   hh:TOOLTIP = "История пользователя" .
     1170                                   ii = ii + 1 .
     1171                               end.
     1172                       end case.
     1173                   end.
     1174                   hh = hh:next-sibling.
     1175               end.
     1176               b-help:column = v-frame-width - b-help:width-chars.
     1177               jj = 0.
     1178               repeat ii = 4 to 1 by -1 :
     1179                   if valid-handle (v-h[ii] ) then
     1180                   do:
     1181                       jj  = jj + 1 .
     1182                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1183                       v-h[ii]:row    = v-help-old-y .
     1184                   end.
     1185               end.
     1186           end.
     1187       end.
     1188   end procedure.
     1189   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1190   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1191   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1192   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1193   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1194   define variable v-diasize-current-frame-height as decimal   no-undo .
     1195   define variable v-diasize-change-size          as logical   no-undo .
     1196   define variable v-diasize-resize-button        as handle    no-undo .
     1197   define variable v-diasize-wndmax               as logical   no-undo .
     1198   define variable v-diasize-wndstore             as logical   no-undo .
     1199   define variable v-diasize-proc-name            as character no-undo .
     1200   define variable v-diasize-browse-handle        as handle    no-undo .
     1201   define variable v-diasize-browse-number        as integer   no-undo .
     1202   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1203   define temp-table temp-diasize-handle no-undo
     1204     field handle-value  as handle
     1205     field save-position as decimal
     1206     index xpk is primary unique handle-value
     1207     .
     1208   define temp-table temp-browse-handle no-undo
     1209     field browse-type   as character
     1210     field browse-number as integer
     1211     field browse-handle as handle
     1212     field original-size as decimal
     1213     index xpk is primary unique browse-type browse-number
     1214     index xie browse-type browse-handle
     1215   .
     1216   procedure diasize_change-height :
     1217     define input  parameter p-change-value  as decimal   no-undo .
     1218     define input  parameter p-move-resize   as logical   no-undo .
     1219     define variable v-field-group-handle    as handle    no-undo .
     1220     define variable v-object-handle         as handle    no-undo .
     1221     define variable v-frame-height          as decimal   no-undo .
     1222     define variable v-frame-virtual-height  as decimal   no-undo .
     1223     define variable v-browse-height         as decimal   no-undo .
     1224     define variable v-window-height         as decimal   no-undo .
     1225     define variable v-window-virtual-height as decimal   no-undo .
     1226     define variable v-change-sign           as integer   no-undo .
     1227     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1228     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1229     if p-change-value > 0
     1230     then do:
     1231       if frame d-pay-type :height + p-change-value
     1232           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1233       then do:
     1234         assign
     1235           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1236                           - (frame d-pay-type :height-chars)
     1237         .
     1238         if p-change-value <= 0
     1239         then do:
     1240           run diasize_position-resize-button in this-procedure .
     1241           return .
     1242         end.
     1243       end.
     1244     end.
     1245     if p-change-value < 0
     1246     then do:
     1247       if frame d-pay-type :height + p-change-value < v-diasize-orig-frame-height
     1248       then do:
     1249         assign
     1250           p-change-value = v-diasize-orig-frame-height
     1251                          - (frame d-pay-type :height-chars)
     1252         .
     1253         if p-change-value >= 0
     1254         then do:
     1255           run diasize_position-resize-button in this-procedure .
     1256           return .
     1257         end.
     1258       end.
     1259     end.
     1260     if p-change-value >= 0
     1261     then do:
     1262       assign
     1263         v-change-sign = 1
     1264       .
     1265     end.
     1266     else do:
     1267       assign
     1268         v-change-sign = -1
     1269       .
     1270     end.
     1271     assign
     1272       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1273     .
     1274     if p-change-value = 0
     1275     then do:
     1276       run diasize_position-resize-button in this-procedure .
     1277       return .
     1278     end.
     1279     move_block:
     1280     do
     1281     on error undo move_block, retry move_block
     1282     :
     1283       if retry
     1284       then do:
     1285         do
     1286         on error undo move_block, leave move_block
     1287         :
     1288           if p-change-value > 0
     1289           then do:
     1290             for each buf_temp-diasize-handle
     1291             on error undo, next
     1292             :
     1293               assign
     1294                 v-object-handle = buf_temp-diasize-handle.handle-value
     1295               .
     1296               if v-object-handle <> v-diasize-resize-button
     1297               then do:
     1298                 assign
     1299                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1300                 .
     1301               end.
     1302             end.
     1303             assign
     1304               v-diasize-browse-handle :height = v-browse-height
     1305             .
     1306             for each buf_temp-browse-handle
     1307               where buf_temp-browse-handle.browse-type = 'height':u
     1308             on error undo, next
     1309             :
     1310               assign
     1311                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1312               .
     1313             end.
     1314             assign
     1315               frame d-pay-type :height = v-frame-height
     1316             .
     1317             if frame d-pay-type :scrollable = true
     1318             then do:
     1319               assign
     1320                 frame d-pay-type :virtual-height = v-frame-virtual-height
     1321               .
     1322             end.
     1323             run diasize_position-resize-button in this-procedure .
     1324           end.
     1325           else do:
     1326             if frame d-pay-type :scrollable = true
     1327             then do:
     1328               assign
     1329                 frame d-pay-type :virtual-height = v-frame-virtual-height
     1330               .
     1331             end.
     1332             assign
     1333               frame d-pay-type :height = v-frame-height
     1334             .
     1335             assign
     1336               v-diasize-browse-handle :height = v-browse-height
     1337             .
     1338             for each buf_temp-browse-handle
     1339               where buf_temp-browse-handle.browse-type = 'height':u
     1340             on error undo, next
     1341             :
     1342               assign
     1343                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1344               .
     1345             end.
     1346             for each buf_temp-diasize-handle
     1347             on error undo, next
     1348             :
     1349               assign
     1350                 v-object-handle = buf_temp-diasize-handle.handle-value
     1351               .
     1352               if v-object-handle <> v-diasize-resize-button
     1353               then do:
     1354                 assign
     1355                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1356                 .
     1357               end.
     1358             end.
     1359             run diasize_position-resize-button in this-procedure .
     1360           end.
     1361           assign
     1362             v-diasize-change-size = false
     1363           .
     1364           leave move_block .
     1365         end.
     1366       end.
     1367       assign
     1368         v-diasize-need-full-display = true
     1369       .
     1370       if v-diasize-change-size = false
     1371       then do:
     1372         assign
     1373           v-diasize-change-size = true
     1374         .
     1375       end.
     1376       else do:
     1377         return .
     1378       end.
     1379       assign
     1380         v-frame-height = frame d-pay-type :height
     1381         v-frame-virtual-height = frame d-pay-type :virtual-height
     1382         v-browse-height = v-diasize-browse-handle :height
     1383       .
     1384       for each buf_temp-browse-handle
     1385         where buf_temp-browse-handle.browse-type = 'height':u
     1386       :
     1387         assign
     1388           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1389         .
     1390       end.
     1391       for each buf_temp-diasize-handle
     1392       :
     1393         delete buf_temp-diasize-handle .
     1394       end.
     1395       assign
     1396         v-field-group-handle = frame d-pay-type :first-child
     1397       .
     1398       do while valid-handle(v-field-group-handle)
     1399       :
     1400         assign
     1401           v-object-handle = v-field-group-handle :first-child
     1402         .
     1403         do while valid-handle(v-object-handle)
     1404         :
     1405           if  v-object-handle <> v-diasize-browse-handle :handle
     1406           and can-query(v-object-handle, "row")
     1407           and can-query(v-object-handle, "height")
     1408           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1409           then do:
     1410             find first buf_temp-browse-handle
     1411               where buf_temp-browse-handle.browse-type   = 'height':u
     1412                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1413               no-error .
     1414             if available buf_temp-browse-handle
     1415             then do:
     1416             end.
     1417             else do:
     1418               create buf_temp-diasize-handle .
     1419               assign
     1420                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1421                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1422               .
     1423             end.
     1424           end.
     1425           assign
     1426             v-object-handle = v-object-handle :next-sibling
     1427           .
     1428         end.
     1429         assign
     1430           v-field-group-handle = v-field-group-handle :next-sibling
     1431         .
     1432       end.
     1433       do with frame d-pay-type
     1434       :
     1435         hide v-diasize-resize-button .
     1436         assign
     1437           v-diasize-resize-button :row    = 1
     1438           v-diasize-resize-button :column = 1
     1439         .
     1440       end.
     1441       if p-change-value > 0
     1442       then do:
     1443         if frame d-pay-type :scrollable = true
     1444         then do:
     1445           assign
     1446             frame d-pay-type :virtual-height = frame d-pay-type :virtual-height + p-change-value
     1447             no-error .
     1448           if error-status :error
     1449           or error-status :get-message(1) <> ""
     1450           then do:
     1451             undo move_block, retry move_block .
     1452           end.
     1453         end.
     1454         assign
     1455           frame d-pay-type :height = frame d-pay-type :height + p-change-value
     1456           no-error .
     1457         if error-status :error
     1458         or error-status :get-message(1) <> ""
     1459         then do:
     1460           undo move_block, retry move_block .
     1461         end.
     1462         assign
     1463           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1464           no-error .
     1465         if error-status :error
     1466         or error-status :get-message(1) <> ""
     1467         then do:
     1468           undo move_block, retry move_block .
     1469         end.
     1470         for each buf_temp-browse-handle
     1471           where buf_temp-browse-handle.browse-type = 'height':u
     1472         on error undo move_block, retry move_block
     1473         :
     1474           assign
     1475             buf_temp-browse-handle.browse-handle :height
     1476               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1477             no-error .
     1478           if error-status :error
     1479           or error-status :get-message(1) <> ""
     1480           then do:
     1481             undo move_block, retry move_block .
     1482           end.
     1483         end.
     1484         for each buf_temp-diasize-handle
     1485         on error undo move_block, retry move_block
     1486         :
     1487           assign
     1488             v-object-handle = buf_temp-diasize-handle.handle-value
     1489           .
     1490           if v-object-handle <> v-diasize-resize-button
     1491           then do:
     1492             assign
     1493               v-object-handle :row = v-object-handle :row + p-change-value
     1494               no-error .
     1495             if error-status :error
     1496             or error-status :get-message(1) <> ""
     1497             then do:
     1498               undo move_block, retry move_block .
     1499             end.
     1500           end.
     1501         end.
     1502       end.
     1503       else do:
     1504         for each buf_temp-diasize-handle
     1505         on error undo move_block, retry move_block
     1506         :
     1507           assign
     1508             v-object-handle = buf_temp-diasize-handle.handle-value
     1509           .
     1510           if v-object-handle <> v-diasize-resize-button
     1511           then do:
     1512             assign
     1513               v-object-handle :row = v-object-handle :row + p-change-value
     1514               no-error .
     1515             if error-status :error
     1516             or error-status :get-message(1) <> ""
     1517             then do:
     1518               undo move_block, retry move_block .
     1519             end.
     1520           end.
     1521         end.
     1522         assign
     1523           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1524           no-error .
     1525         if error-status :error
     1526         or error-status :get-message(1) <> ""
     1527         then do:
     1528           undo move_block, retry move_block .
     1529         end.
     1530         for each buf_temp-browse-handle
     1531           where buf_temp-browse-handle.browse-type = 'height':u
     1532         on error undo move_block, retry move_block
     1533         :
     1534           assign
     1535             buf_temp-browse-handle.browse-handle :height
     1536               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1537             no-error .
     1538           if error-status :error
     1539           or error-status :get-message(1) <> ""
     1540           then do:
     1541             undo move_block, retry move_block .
     1542           end.
     1543         end.
     1544         assign
     1545           frame d-pay-type :height = frame d-pay-type :height + p-change-value
     1546           no-error .
     1547         if error-status :error
     1548         or error-status :get-message(1) <> ""
     1549         then do:
     1550           undo move_block, retry move_block .
     1551         end.
     1552         if frame d-pay-type :scrollable = true
     1553         then do:
     1554           assign
     1555             frame d-pay-type :virtual-height = frame d-pay-type :virtual-height + p-change-value
     1556             no-error .
     1557           if error-status :error
     1558           or error-status :get-message(1) <> ""
     1559           then do:
     1560             undo move_block, retry move_block .
     1561           end.
     1562         end.
     1563       end.
     1564       if p-move-resize = true
     1565       then do:
     1566         run diasize_position-resize-button in this-procedure .
     1567       end.
     1568       if v-diasize-wndstore = true
     1569       then do:
     1570         if connected("ub") = true
     1571         then do:
     1572           define variable v-cntxt-db-num        as integer   no-undo .
     1573           define variable v-cntxt-userid        as character no-undo .
     1574           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1575                                             , OUTPUT v-cntxt-userid
     1576                                             ) .
     1577           run gbl/wndsizew.p
     1578             (input  v-cntxt-db-num
     1579             ,input  v-cntxt-userid
     1580             ,input  v-diasize-proc-name
     1581             ,input  'height':u
     1582             ,input  string(frame d-pay-type :height - v-diasize-orig-frame-height)
     1583             ) .
     1584         end.
     1585       end.
     1586     end.
     1587     assign
     1588       v-diasize-change-size = false
     1589     .
     1590   end procedure.
     1591   procedure diasize_set-height :
     1592     define input  parameter p-new-height  as decimal   no-undo .
     1593     define input  parameter p-move-resize as logical   no-undo .
     1594     do
     1595     on error undo, return error return-value
     1596     :
     1597       run diasize_change-height in this-procedure
     1598         (input  (p-new-height - frame d-pay-type :height)
     1599         ,input  p-move-resize
     1600         ) .
     1601     end.
     1602   end procedure.
     1603   procedure diasize_change-width :
     1604     define input  parameter p-change-value as decimal   no-undo .
     1605     define input  parameter p-move-resize  as logical   no-undo .
     1606     define variable v-field-group-handle   as handle    no-undo .
     1607     define variable v-object-handle        as handle    no-undo .
     1608     define variable v-frame-width          as decimal   no-undo .
     1609     define variable v-frame-virtual-width  as decimal   no-undo .
     1610     define variable v-browse-width         as decimal   no-undo .
     1611     define variable v-window-width         as decimal   no-undo .
     1612     define variable v-window-virtual-width as decimal   no-undo .
     1613     define variable v-change-sign          as integer   no-undo .
     1614     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1615     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1616     if p-change-value > 0
     1617     then do:
     1618       if frame d-pay-type :width + p-change-value >
     1619           session :width-chars
     1620       then do:
     1621         assign
     1622           p-change-value = session :width-chars - frame d-pay-type :width
     1623         .
     1624         if p-change-value <= 0
     1625         then do:
     1626           run diasize_position-resize-button in this-procedure .
     1627           return .
     1628         end.
     1629       end.
     1630     end.
     1631     if p-change-value < 0
     1632     then do:
     1633       if frame d-pay-type :width + p-change-value < v-diasize-orig-frame-width
     1634       then do:
     1635         assign
     1636           p-change-value = v-diasize-orig-frame-width
     1637                          - frame d-pay-type :width
     1638         .
     1639         if p-change-value >= 0
     1640         then do:
     1641           run diasize_position-resize-button in this-procedure .
     1642           return .
     1643         end.
     1644       end.
     1645     end.
     1646     if p-change-value >= 0
     1647     then do:
     1648       assign
     1649         v-change-sign = 1
     1650       .
     1651     end.
     1652     else do:
     1653       assign
     1654         v-change-sign = -1
     1655       .
     1656     end.
     1657     assign
     1658       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1659     .
     1660     if p-change-value = 0
     1661     then do:
     1662       run diasize_position-resize-button in this-procedure .
     1663       return .
     1664     end.
     1665     move_block:
     1666     do
     1667     on error undo move_block, leave move_block
     1668     :
     1669       if retry
     1670       then do:
     1671         do
     1672         on error undo move_block, leave move_block
     1673         :
     1674           if p-change-value > 0
     1675           then do:
     1676             for each buf_temp-diasize-handle
     1677             on error undo, next
     1678             :
     1679               assign
     1680                 v-object-handle = buf_temp-diasize-handle.handle-value
     1681               .
     1682               if v-object-handle <> v-diasize-resize-button
     1683               then do:
     1684                 assign
     1685                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1686                 .
     1687               end.
     1688             end.
     1689             assign
     1690               v-diasize-browse-handle :width = v-browse-width
     1691             .
     1692             for each buf_temp-browse-handle
     1693               where buf_temp-browse-handle.browse-type = 'width':u
     1694             on error undo, next
     1695             :
     1696               assign
     1697                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1698               .
     1699             end.
     1700             assign
     1701               frame d-pay-type :width = v-frame-width
     1702             .
     1703             if frame d-pay-type :scrollable = true
     1704             then do:
     1705               assign
     1706                 frame d-pay-type :virtual-width = v-frame-virtual-width
     1707               .
     1708             end.
     1709             run diasize_position-resize-button in this-procedure .
     1710           end.
     1711           else do:
     1712             if frame d-pay-type :scrollable = true
     1713             then do:
     1714               assign
     1715                 frame d-pay-type :virtual-width = v-frame-virtual-width
     1716               .
     1717             end.
     1718             assign
     1719               frame d-pay-type :width = v-frame-width
     1720             .
     1721             for each buf_temp-browse-handle
     1722               where buf_temp-browse-handle.browse-type = 'width':u
     1723             on error undo, next
     1724             :
     1725               assign
     1726                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1727               .
     1728             end.
     1729             assign
     1730               v-diasize-browse-handle :width = v-browse-width
     1731             .
     1732             for each buf_temp-diasize-handle
     1733             on error undo, next
     1734             :
     1735               assign
     1736                 v-object-handle = buf_temp-diasize-handle.handle-value
     1737               .
     1738               if v-object-handle <> v-diasize-resize-button
     1739               then do:
     1740                 assign
     1741                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1742                 .
     1743               end.
     1744             end.
     1745             run diasize_position-resize-button in this-procedure .
     1746           end.
     1747           assign
     1748             v-diasize-change-size = false
     1749           .
     1750           leave move_block .
     1751         end.
     1752       end.
     1753       assign
     1754         v-diasize-need-full-display = true
     1755       .
     1756       if v-diasize-change-size = false
     1757       then do:
     1758         assign
     1759           v-diasize-change-size = true
     1760         .
     1761       end.
     1762       else do:
     1763         return .
     1764       end.
     1765       assign
     1766         v-frame-width = frame d-pay-type :width
     1767         v-frame-virtual-width = frame d-pay-type :virtual-width
     1768         v-browse-width = v-diasize-browse-handle :width
     1769       .
     1770       for each buf_temp-browse-handle
     1771         where buf_temp-browse-handle.browse-type = 'width':u
     1772       :
     1773         assign
     1774           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1775         .
     1776       end.
     1777       for each buf_temp-diasize-handle
     1778       :
     1779         delete buf_temp-diasize-handle .
     1780       end.
     1781       assign
     1782         v-field-group-handle = frame d-pay-type :first-child
     1783       .
     1784       do while valid-handle(v-field-group-handle)
     1785       :
     1786         assign
     1787           v-object-handle = v-field-group-handle :first-child
     1788         .
     1789         do while valid-handle(v-object-handle)
     1790         :
     1791           if  v-object-handle <> v-diasize-browse-handle :handle
     1792           and v-object-handle <> v-diasize-resize-button
     1793           and can-query(v-object-handle, "row")
     1794           and can-query(v-object-handle, "height")
     1795           and ( v-object-handle :col + v-object-handle :width
     1796                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1797               )
     1798           then do:
     1799             find first buf_temp-browse-handle
     1800               where buf_temp-browse-handle.browse-type   = 'width':u
     1801                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1802               no-error .
     1803             if available buf_temp-browse-handle
     1804             then do:
     1805             end.
     1806             else do:
     1807               create buf_temp-diasize-handle .
     1808               assign
     1809                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1810                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1811               .
     1812             end.
     1813           end.
     1814           assign
     1815             v-object-handle = v-object-handle :next-sibling
     1816           .
     1817         end.
     1818         assign
     1819           v-field-group-handle = v-field-group-handle :next-sibling
     1820         .
     1821       end.
     1822       do with frame d-pay-type
     1823       :
     1824         hide v-diasize-resize-button .
     1825         v-diasize-resize-button :row = 1.
     1826         v-diasize-resize-button :column = 1.
     1827       end.
     1828       if p-change-value > 0
     1829       then do:
     1830         if frame d-pay-type :scrollable = true
     1831         then do:
     1832           assign
     1833             frame d-pay-type :virtual-width = frame d-pay-type :virtual-width + p-change-value
     1834             no-error .
     1835           if error-status :error
     1836           or error-status :get-message(1) <> ""
     1837           then do:
     1838             undo move_block, retry move_block.
     1839           end.
     1840         end.
     1841         assign
     1842           frame d-pay-type :width = v-frame-width + p-change-value
     1843           no-error .
     1844         if error-status :error
     1845         or error-status :get-message(1) <> ""
     1846         then do:
     1847           undo move_block, retry move_block.
     1848         end.
     1849         assign
     1850           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1851         no-error .
     1852         if error-status :error
     1853         or error-status :get-message(1) <> ""
     1854         then do:
     1855           undo move_block, retry move_block.
     1856         end.
     1857         for each buf_temp-browse-handle
     1858           where buf_temp-browse-handle.browse-type = 'width':u
     1859         on error undo move_block, retry move_block
     1860         :
     1861           assign
     1862             buf_temp-browse-handle.browse-handle :width
     1863               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1864             no-error .
     1865           if error-status :error
     1866           or error-status :get-message(1) <> ""
     1867           then do:
     1868             undo move_block, retry move_block .
     1869           end.
     1870         end.
     1871         for each buf_temp-diasize-handle
     1872         on error undo move_block, retry move_block
     1873         :
     1874           assign
     1875             v-object-handle = buf_temp-diasize-handle.handle-value
     1876           .
     1877           if v-object-handle <> v-diasize-resize-button
     1878           then do:
     1879             assign
     1880               v-object-handle :col = v-object-handle :col + p-change-value
     1881               no-error .
     1882             if error-status :error
     1883             or error-status :get-message(1) <> ""
     1884             then do:
     1885               undo move_block, retry move_block .
     1886             end.
     1887           end.
     1888         end.
     1889       end.
     1890       else do:
     1891         for each buf_temp-diasize-handle
     1892         on error undo move_block, retry move_block
     1893         :
     1894           assign
     1895             v-object-handle = buf_temp-diasize-handle.handle-value
     1896           .
     1897           if v-object-handle <> v-diasize-resize-button
     1898           then do:
     1899             assign
     1900               v-object-handle :col = v-object-handle :col + p-change-value
     1901               no-error .
     1902             if error-status :error
     1903             or error-status :get-message(1) <> ""
     1904             then do:
     1905               undo move_block, retry move_block .
     1906             end.
     1907           end.
     1908         end.
     1909         for each buf_temp-browse-handle
     1910           where buf_temp-browse-handle.browse-type = 'width':u
     1911         on error undo move_block, retry move_block
     1912         :
     1913           assign
     1914             buf_temp-browse-handle.browse-handle :width
     1915               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1916             no-error .
     1917           if error-status :error
     1918           or error-status :get-message(1) <> ""
     1919           then do:
     1920             undo move_block, retry move_block .
     1921           end.
     1922         end.
     1923         assign
     1924           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1925           no-error .
     1926         if error-status :error
     1927         or error-status :get-message(1) <> ""
     1928         then do:
     1929           undo move_block, retry move_block.
     1930         end.
     1931         assign
     1932           frame d-pay-type :width = frame d-pay-type :width + p-change-value
     1933         no-error .
     1934         if error-status :error
     1935         or error-status :get-message(1) <> ""
     1936         then do:
     1937           undo move_block, retry move_block.
     1938         end.
     1939         if frame d-pay-type :scrollable = true
     1940         then do:
     1941           assign
     1942             frame d-pay-type :virtual-width = frame d-pay-type :virtual-width + p-change-value
     1943           no-error .
     1944           if error-status :error
     1945           or error-status :get-message(1) <> ""
     1946           then do:
     1947             undo move_block, retry move_block.
     1948           end.
     1949         end.
     1950       end.
     1951       if p-move-resize
     1952       then do:
     1953         run diasize_position-resize-button in this-procedure .
     1954       end.
     1955       if v-diasize-wndstore = true
     1956       then do:
     1957         if connected("ub") = true
     1958         then do:
     1959           define variable v-cntxt-db-num        as integer   no-undo .
     1960           define variable v-cntxt-userid        as character no-undo .
     1961           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1962                                             , OUTPUT v-cntxt-userid
     1963                                             ) .
     1964           run gbl/wndsizew.p
     1965             (input  v-cntxt-db-num
     1966             ,input  v-cntxt-userid
     1967             ,input  v-diasize-proc-name
     1968             ,input  'width':u
     1969             ,input  string(frame d-pay-type :width - v-diasize-orig-frame-width)
     1970             ) .
     1971         end.
     1972       end.
     1973     end.
     1974     assign
     1975       v-diasize-change-size = false
     1976     .
     1977   end procedure.
     1978   procedure diasize_set-width :
     1979     define input  parameter p-new-width  as decimal   no-undo .
     1980     define input  parameter p-move-resize as logical   no-undo .
     1981     do
     1982     on error undo, return error return-value
     1983     :
     1984       run diasize_change-width in this-procedure
     1985         (input  (p-new-width - frame d-pay-type :width)
     1986         ,input  p-move-resize
     1987         ) .
     1988     end.
     1989   end procedure.
     1990   procedure diasize_position-resize-button :
     1991     do with frame d-pay-type
     1992     :
     1993       hide v-diasize-resize-button .
     1994       assign
     1995         v-diasize-resize-button :row = frame d-pay-type :height - v-diasize-resize-button :height
     1996                     - 1
     1997                     - (frame d-pay-type :border-bottom-pixels / session :pixels-per-row)
     1998         v-diasize-resize-button :col = frame d-pay-type :width - v-diasize-resize-button :width
     1999                     - 1
     2000                     - (frame d-pay-type :border-right-pixels / session :pixels-per-column)
     2001       .
     2002       view v-diasize-resize-button .
     2003     end.
     2004   end procedure.
     2005   on alt-right anywhere
     2006   do:
     2007     run diasize_change-width in this-procedure
     2008       (input 1
     2009       ,input true
     2010       ) .
     2011     return no-apply .
     2012   end.
     2013   on alt-left anywhere
     2014   do:
     2015     run diasize_change-width in this-procedure
     2016       (input -1
     2017       ,input true
     2018       ) .
     2019     return no-apply .
     2020   end.
     2021   on alt-down anywhere
     2022   do:
     2023     run diasize_change-height in this-procedure
     2024       (input 1
     2025       ,input true
     2026       ) .
     2027     return no-apply .
     2028   end.
     2029   on alt-up anywhere
     2030   do:
     2031     run diasize_change-height in this-procedure
     2032       (input -1
     2033       ,input true
     2034       ) .
     2035     return no-apply .
     2036   end.
     2037   on alt-enter of frame d-pay-type
     2038   do:
     2039     run diasize_maximize in this-procedure
     2040       (input  ?
     2041       ).
     2042     return no-apply .
     2043   end.
     2044   procedure diasize_end-move :
     2045     do
     2046     on error undo, return error return-value
     2047     :
     2048       define variable v-row-delta as decimal   no-undo .
     2049       define variable v-col-delta as decimal   no-undo .
     2050       define variable v-new-row as decimal   no-undo .
     2051       define variable v-new-col as decimal   no-undo .
     2052       assign
     2053         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2054         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2055       .
     2056       assign
     2057         v-row-delta = v-new-row - frame d-pay-type :height
     2058         v-col-delta = v-new-col - frame d-pay-type :width
     2059       .
     2060       run diasize_change-height in this-procedure
     2061         (input v-row-delta
     2062         ,input true
     2063         ) .
     2064       run diasize_change-width in this-procedure
     2065         (input v-col-delta
     2066         ,input true
     2067         ) .
     2068     end.
     2069   end procedure.
     2070   procedure diasize_maximize :
     2071     define input  parameter p-action as logical   no-undo .
     2072     do
     2073     on error undo, return error return-value
     2074     :
     2075       if p-action = ?
     2076       then do:
     2077         if v-diasize-need-maximize = true
     2078         then do:
     2079           assign
     2080             p-action = true
     2081           .
     2082         end.
     2083         else do:
     2084           assign
     2085             p-action = false
     2086           .
     2087         end.
     2088       end.
     2089       if p-action = true
     2090       then do:
     2091         run diasize_change-height in this-procedure
     2092           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2093               - frame d-pay-type :height-chars
     2094           ,input true
     2095           ) .
     2096         run diasize_change-width in this-procedure
     2097           (input session :width-chars
     2098               - frame d-pay-type :width-chars
     2099           ,input true
     2100           ) .
     2101         assign
     2102           v-diasize-need-maximize = false
     2103         .
     2104       end.
     2105       else do:
     2106         run diasize_change-width in this-procedure
     2107           (input v-diasize-orig-frame-width
     2108               - frame d-pay-type :width-chars
     2109           ,input true
     2110           ) .
     2111         run diasize_change-height in this-procedure
     2112           (input v-diasize-orig-frame-height
     2113               - frame d-pay-type :height-chars
     2114           ,input true
     2115           ) .
     2116         assign
     2117           v-diasize-need-maximize = true
     2118         .
     2119       end.
     2120     end.
     2121   end procedure.
     2122   procedure diasize_restore-orig-size :
     2123     do
     2124     on error undo, return error return-value
     2125     :
     2126       assign
     2127         v-diasize-current-frame-width  = frame d-pay-type :width
     2128         v-diasize-current-frame-height = frame d-pay-type :height
     2129       .
     2130       run diasize_set-height in this-procedure
     2131         (input  v-diasize-orig-frame-height
     2132         ,input  true
     2133         ) .
     2134       run diasize_set-width in this-procedure
     2135         (input  v-diasize-orig-frame-width
     2136         ,input  true
     2137         ) .
     2138     end.
     2139   end procedure.
     2140   procedure diasize_restore-current-size :
     2141     do
     2142     on error undo, return error return-value
     2143     :
     2144       run diasize_set-height in this-procedure
     2145         (input  v-diasize-current-frame-height
     2146         ,input  true
     2147         ) .
     2148       run diasize_set-width in this-procedure
     2149         (input  v-diasize-current-frame-width
     2150         ,input  true
     2151         ) .
     2152     end.
     2153   end procedure.
     2154   procedure diasize_set-browse-handle :
     2155     define input  parameter p-browse-handle as handle   no-undo .
     2156     define buffer buf_temp-browse-handle for temp-browse-handle .
     2157     do
     2158     on error undo, return error return-value
     2159     :
     2160       assign
     2161         v-diasize-browse-handle = p-browse-handle
     2162       .
     2163       for each buf_temp-browse-handle
     2164       on error undo, return error return-value
     2165       :
     2166         delete buf_temp-browse-handle .
     2167       end.
     2168     end.
     2169   end procedure.
     2170   procedure diasize_add_browse :
     2171     define input  parameter p-browse-type   as character no-undo .
     2172     define input  parameter p-browse-handle as handle    no-undo .
     2173     define buffer buf_temp-browse-handle for temp-browse-handle .
     2174     do
     2175     on error undo, return error return-value
     2176     :
     2177       assign
     2178         v-diasize-browse-number = v-diasize-browse-number + 1
     2179       .
     2180       create buf_temp-browse-handle .
     2181       assign
     2182         buf_temp-browse-handle.browse-type   = p-browse-type
     2183         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2184         buf_temp-browse-handle.browse-handle = p-browse-handle
     2185       .
     2186     end.
     2187   end procedure.
     2188   procedure diasize_init :
     2189     define variable v-default-value    as logical   no-undo .
     2190     define variable v-restore-saved    as logical   no-undo .
     2191     define variable v-resize-value-str as character no-undo .
     2192     do
     2193     on error undo, return error return-value
     2194     :
     2195       do with frame d-pay-type
     2196       :
     2197         assign
     2198           v-diasize-orig-frame-height = frame d-pay-type :height
     2199           v-diasize-orig-frame-width  = frame d-pay-type :width
     2200           v-diasize-browse-handle     = browse br-paytype :handle
     2201         .
     2202         create button v-diasize-resize-button
     2203         assign
     2204           parent        = frame d-pay-type :first-child
     2205           label         = "s"
     2206           height-pixels = 16
     2207           width-pixels  = 16
     2208           visible       = true
     2209           sensitive     = true
     2210           movable       = true
     2211           triggers:
     2212             on end-move persistent run diasize_end-move in this-procedure .
     2213           end triggers.
     2214         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2215         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2216         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2217         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2218         assign
     2219           v-diasize-wndmax = false
     2220         .
     2221         if connected("ub") = true
     2222         then do:
     2223           define variable v-cntxt-db-num        as integer   no-undo .
     2224           define variable v-cntxt-userid        as character no-undo .
     2225           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2226                                             , OUTPUT v-cntxt-userid
     2227                                             ) .
     2228           run gbl/wndpar_r.p
     2229             (input  v-cntxt-db-num
     2230             ,input  v-cntxt-userid
     2231             ,input  'wndmax':U
     2232             ,output v-diasize-wndmax
     2233             ,output v-default-value
     2234             ) .
     2235         end.
     2236         assign
     2237           v-diasize-wndstore = false
     2238         .
     2239         if connected("ub") = true
     2240         then do:
     2241           run gbl/wndpar_r.p
     2242             (input  v-cntxt-db-num
     2243             ,input  v-cntxt-userid
     2244             ,input  'wndstore':U
     2245             ,output v-diasize-wndstore
     2246             ,output v-default-value
     2247             ) .
     2248         end.
     2249         assign
     2250           v-diasize-proc-name = entry(1, program-name(2), '.')
     2251         .
     2252         if v-diasize-wndstore = true
     2253         then do:
     2254           assign
     2255             v-restore-saved = false
     2256           .
     2257           if connected("ub") = true
     2258           then do:
     2259             run gbl/wndsizer.p
     2260               (input  v-cntxt-db-num
     2261               ,input  v-cntxt-userid
     2262               ,input  v-diasize-proc-name
     2263               ,input  'height':u
     2264               ,output v-resize-value-str
     2265               ) .
     2266             if v-resize-value-str <> '':U
     2267             then do:
     2268               run diasize_change-height in this-procedure
     2269                 (input  integer(v-resize-value-str)
     2270                 ,input  true
     2271                 ) .
     2272               assign
     2273                 v-restore-saved = true
     2274               .
     2275             end.
     2276           end.
     2277           if connected("ub") = true
     2278           then do:
     2279             run gbl/wndsizer.p
     2280               (input  v-cntxt-db-num
     2281               ,input  v-cntxt-userid
     2282               ,input  v-diasize-proc-name
     2283               ,input  'width':u
     2284               ,output v-resize-value-str
     2285               ) .
     2286             if v-resize-value-str <> '':U
     2287             then do:
     2288               run diasize_change-width in this-procedure
     2289                 (input  integer(v-resize-value-str)
     2290                 ,input  true
     2291                 ) .
     2292               assign
     2293                 v-restore-saved = true
     2294               .
     2295             end.
     2296           end.
     2297           if v-restore-saved <> true
     2298           then do:
     2299             if v-diasize-wndmax = true
     2300             then do:
     2301               run diasize_maximize in this-procedure
     2302                 (input  true
     2303                 ) .
     2304             end.
     2305           end.
     2306         end.
     2307         else do:
     2308           if v-diasize-wndmax = true
     2309           then do:
     2310             run diasize_maximize in this-procedure
     2311               (input  true
     2312               ) .
     2313           end.
     2314         end.
     2315       end.
     2316     end.
     2317   end procedure.
     2318   procedure diasize_need-full-display :
     2319     define output parameter p-need-full-display as logical   no-undo .
     2320     do
     2321     on error undo, return error return-value
     2322     :
     2323       assign
     2324         p-need-full-display = v-diasize-need-full-display
     2325       .
     2326       assign
     2327         v-diasize-need-full-display = false
     2328       .
     2329     end.
     2330   end procedure.
     2331   procedure get-context :
     2332      define output parameter p-db-num as integer          no-undo.
     2333      define output parameter p-user-id as character        no-undo.
     2334      define variable v-login               as character    no-undo.
     2335      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2336      define buffer buf_user-login  for ub.user-login .
     2337      do
     2338      on error undo, return error
     2339      :
     2340            FIND FIRST buf_sys-ctrl no-lock.
     2341            ASSIGN
     2342               v-login = USERID("ub")
     2343               p-db-num = buf_sys-ctrl.db-num
     2344            .
     2345            FIND FIRST buf_user-login
     2346                 WHERE buf_user-login.db-num = p-db-num
     2347                   AND buf_user-login.user-login = v-login
     2348                 no-lock
     2349                 no-error
     2350                 .
     2351            IF AVAILABLE buf_user-login
     2352            THEN DO:
     2353               assign
     2354                  p-user-id = buf_user-login.user-id
     2355               .
     2356            END.
     2357      end.
     2358   end procedure.
     2359       run diasize_init in this-procedure .
     2360   ON WINDOW-CLOSE OF FRAME d-pay-type APPLY "END-ERROR":U TO SELF.
     2361   MAIN-BLOCK:
     2362   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2363      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2364     if lookup('s-deploy', bttns) > 0 then do:
     2365       assign
     2366       v-is-deploy = yes.
     2367     end.
     2368   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2369     run mainmenu_getcntxt in parparentproc
     2370       (output v-cntxt-db-num
     2371       ,output v-cntxt-userid
     2372       ,output v-cntxt-level
     2373       ,output v-cntxt-host-code-obj
     2374       ,output v-cntxt-obj-type
     2375       ,output v-cntxt-obj-code
     2376       ,output v-cntxt-db-num-obj
     2377       ,output v-cntxt-is-admin
     2378       ) .
     2379     run enable_UI in this-procedure .
     2380     WAIT-FOR GO OF FRAME d-pay-type focus br-paytype.
     2381   END.
     2382   run disable_UI in this-procedure .
     2383   PROCEDURE disable_UI :
     2384     HIDE FRAME d-pay-type.
     2385   END PROCEDURE.
     2386   PROCEDURE enable_UI :
     2387     ENABLE
     2388         br-paytype
     2389         b-exit
     2390         b-sel WHEN can-do( bttns, "b-sel" )
     2391         b-mark WHEN can-do( bttns, "b-mark" )
     2392         b-add WHEN can-do( bttns, "b-add" ) AND v-cntxt-db-num = 0
     2393         b-upd WHEN can-do( bttns, "b-upd" ) AND v-cntxt-db-num = 0
     2394         b-doc WHEN can-do( bttns, "b-doc" ) and not v-is-deploy
     2395         b-print when not v-is-deploy
     2396         b-hist when not v-is-deploy
     2397         b-help
     2398         WITH FRAME d-pay-type.
     2399     OPEN QUERY br-paytype FOR EACH X_pay-type NO-LOCK     BY X_pay-type.obj-name.
     2400     if available X_pay-type
     2401     then log-res  = br-paytype:select-focused-row( ).
     2402   END PROCEDURE.
