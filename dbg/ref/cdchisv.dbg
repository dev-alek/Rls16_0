      628   define buffer buf_c-dis-card-property for ub.c-dis-card-property.
      629     main-block:
      630     do
      631     on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      632     on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      633     on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      634     :
      635       if not available buf_dis-card-property and not p-action = integer('1':U) then do:
      636         message
      637           vss-workfile vss-revision vss-description skip
      638           "Ошибка задания входных параметров" skip
      639           "Не определена запись СВОЙСТВА ДК" skip
      640           view-as alert-box error .
      641         undo, return error .
      642       end.
      643     v-send = integer('0':U).
      644     if not p-action = integer('1':U) then do:
      645       if available buf_dis-card then do:
      646         if g#news then do:
      647   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      648   if (valid-handle(g#lib-nws) <> true) then do:   run nws/lib-nws.p persistent no-error .   if error-status :error or (valid-handle(g#lib-nws) <> true) then do:     message       "Error starting nws/lib-nws.p" skip       g#lib-nws skip       g#lib-nws :type skip       g#lib-nws :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-nws_get-hn-option in g#lib-nws
      649     (input  g#db-num
      650     ,input  'dis-card-property':U
      651     ,input  0
      652     ,input  '':U
      653     ,input  0
      654     ,input  buf_dis-card.type
      655     ,input  '':U
      656     ,input  '':U
      657     ,input  buf_dis-card.emitent-host-code
      658     ,input  (if buf_Dis-card-property.dt-code > 0 then 0 else -1)
      659     ,input  0
      660     ,input  'nws-to-hist'
      661     ,output v-send
      662     ) no-error .
      663         end.
      664         else do:
      665   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      666   if (valid-handle(g#lib-nws) <> true) then do:   run nws/lib-nws.p persistent no-error .   if error-status :error or (valid-handle(g#lib-nws) <> true) then do:     message       "Error starting nws/lib-nws.p" skip       g#lib-nws skip       g#lib-nws :type skip       g#lib-nws :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-nws_get-hn-option in g#lib-nws
      667     (input  g#db-num
      668     ,input  'dis-card-property':U
      669     ,input  0
      670     ,input  '':U
      671     ,input  0
      672     ,input  buf_dis-card.type
      673     ,input  '':U
      674     ,input  '':U
      675     ,input  buf_dis-card.emitent-host-code
      676     ,input  (if buf_Dis-card-property.dt-code > 0 then 0 else -1)
      677     ,input  0
      678     ,input  'hist-from-prim'
      679     ,output v-send
      680     ) no-error .
      681         end.
      682       end.
      683     end.
      684     if v-send >= 0 then do:
      685       run cur-time in this-procedure(output v-date, output v-time).
      686       if p-action = integer('1':U) then do:
      687         create buf_c-dis-card-property.
      688         assign
      689         buf_c-dis-card-property.d-card            = p-d-card
      690         buf_c-dis-card-property.card-num          = p-card-num
      691         buf_c-dis-card-property.host-code         = p-host-code
      692         buf_c-dis-card-property.obj-type          = p-obj-type
      693         buf_c-dis-card-property.obj-code          = p-obj-code
      694         buf_c-dis-card-property.dt-code           = p-dt-code
      695         buf_c-dis-card-property.node-code         = p-node-code
      696         buf_c-dis-card-property.dtm-code         = p-dtm-code
      697         buf_c-dis-card-property.main-card         = p-main-card
      698         buf_c-dis-card-property.first-main-card   = p-first-main-card
      699         buf_c-dis-card-property.first-card        = p-first-card
      700         buf_c-dis-card-property.chip-num          = (if p-chip-num = 0
      701                                                      then next-value (s-dc-chip, ub)
      702                                                      else p-chip-num)
      703         buf_c-dis-card-property.corr-time         = (if p-corr-time = ?
      704                                                      then v-time
      705                                                      else p-corr-time)
      706         buf_c-dis-card-property.corr-user-db-num  = g#db-num
      707         buf_c-dis-card-property.corr-user-name    = if g#news then (chr(4) +  'СПН':U) else g#userid
      708         buf_c-dis-card-property.corr-date         = (if p-corr-date = ?
      709                                                      then v-date
      710                                                      else p-corr-date)
      711         .
      712       end.
      713       else do:
      714         create buf_c-dis-card-property.
      715         buffer-copy buf_dis-card-property to buf_c-dis-card-property
      716         assign
      717         buf_c-dis-card-property.d-card             = buf_dis-card-property.d-card
      718         buf_c-dis-card-property.card-num           = buf_dis-card-property.card-num
      719         buf_c-dis-card-property.dt-code             = buf_dis-card-property.dt-code
      720         buf_c-dis-card-property.main-card          = buf_dis-card-property.main-card
      721         buf_c-dis-card-property.first-main-card    = buf_dis-card-property.first-main-card
      722         buf_c-dis-card-property.first-card         = buf_dis-card-property.first-card
      723         buf_c-dis-card-property.host-code          = buf_dis-card-property.host-code
      724         buf_c-dis-card-property.obj-type          = p-obj-type
      725         buf_c-dis-card-property.obj-code          = p-obj-code
      726         buf_c-dis-card-property.node-code         = p-node-code
      727         buf_c-dis-card-property.dtm-code         = p-dtm-code
      728         buf_c-dis-card-property.chip-num           = (if p-chip-num = 0
      729                                                       then next-value (s-dc-chip, ub)
      730                                                       else p-chip-num)
      731         buf_c-dis-card-property.corr-time          = (if p-corr-time = ?
      732                                                       then v-time
      733                                                       else p-corr-time)
      734         buf_c-dis-card-property.corr-user-db-num   = g#db-num
      735               buf_c-dis-card-property.corr-user-name    = (if g#news
      736                                                      then (chr(4) +  'СПН':U)
      737                                                      else (if g#esys
      738                                                            then (chr(4) +  'ВС':U)
      739                                                            else g#userid
      740                                                            )
      741                                                      )
      742         buf_c-dis-card-property.corr-date          = (if p-corr-date = ?
      743                                                       then v-date
      744                                                       else p-corr-date)
      745         .
      746         run gen-key-rec in this-procedure (
      747                                             input 'dis-card-property':U
      748                                           ,input buffer buf_dis-card-property:handle
      749                                           ,output v-uniq-key-rec).
      750       end.
      751       if p-chip-num = 0   then do:
      752         create buf_c-dc-hist.
      753         buffer-copy buf_c-dis-card-property to buf_c-dc-hist
      754         assign
      755         buf_c-dc-hist.action =  p-action
      756         buf_c-dc-hist.subject = 'dis-card-property':U
      757         buf_c-dc-hist.is-news = g#news
      758         buf_c-dc-hist.source-type = p-source-type
      759         buf_c-dc-hist.source-ref = p-source-ref
      760         buf_c-dc-hist.uniq-key-rec = v-uniq-key-rec
      761         .
      762       end.
      763       assign
      764       p-chip-num = buf_c-dis-card-property.chip-num
      765       p-corr-date = buf_c-dis-card-property.corr-date
      766       p-corr-time = buf_c-dis-card-property.corr-time
      767       .
      768       run disproph_send-nws in this-procedure (
      769                                                 buffer buf_c-dis-card-property
      770                                                ,buffer buf_c-dc-hist
      771                                                ,buffer buf_dis-card
      772                                                 ).
      773       end.
      774     end.
      775   end procedure.
      776   procedure disproph_send-nws :
      777   define parameter buffer buf_c-dis-card-property for ub.c-dis-card-property.
      778   define parameter buffer buf_c-dc-hist for ub.c-dc-hist.
      779   define parameter buffer buf_Dis-card for ub.dis-card.
      780   define variable v-dh-hn as integer no-undo .
      781   main-block:
      782   do
      783   on error undo, return error return-value
      784   :
      785     if g#news
      786     and g#db-num > 0
      787     and buf_c-dis-card-property.corr-user-db-num <> g#db-num
      788     then return.
      789     if g#db-num = 0
      790     or (g#news
      791         and g#db-num > 0
      792         and buf_c-dis-card-property.corr-user-name = (chr(4) +  'СПН':U)
      793         )
      794     then do:
      795       if not available buf_dis-card then do:
      796         find first buf_dis-card no-lock where
      797                   buf_Dis-card.d-card = buf_c-dis-card-property.d-card no-error.
      798       end.
      799       if not available buf_dis-card then do:
      800         assign
      801         v-dh-hn = integer('0':U).
      802       end.
      803       else do:
      804   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      805   if (valid-handle(g#lib-nws) <> true) then do:   run nws/lib-nws.p persistent no-error .   if error-status :error or (valid-handle(g#lib-nws) <> true) then do:     message       "Error starting nws/lib-nws.p" skip       g#lib-nws skip       g#lib-nws :type skip       g#lib-nws :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-nws_get-hn-option in g#lib-nws
      806     (input  g#db-num
      807     ,input  'dis-card-property':U
      808     ,input  0
      809     ,input  '':U
      810     ,input  0
      811     ,input  buf_dis-card.type
      812     ,input  '':U
      813     ,input  '':U
      814     ,input  buf_dis-card.emitent-host-code
      815     ,input  (if buf_c-dis-card-property.dt-code > 0 then 0 else -1)
      816     ,input  0
      817     ,input  'hist-to-nws'
      818     ,output v-dh-hn
      819     ) no-error .
      820       end.
      821       if v-dh-hn >= 0 then do:
      822         run str/callnews.p (
      823           input 'c-dis-card-property':U
      824           ,input (buffer buf_c-dis-card-property:handle)
      825           ) no-error .
      826         if error-status:error then do:
      827           undo main-block,  return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1) ).
      828         end.
      829         if available buf_c-dc-hist then do:
      830           run str/callnews.p (
      831             input 'c-dc-hist':U
      832             ,input (buffer buf_c-dc-hist:handle)
      833             ) no-error .
      834           if error-status:error then do:
      835             undo main-block,  return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1) ).
      836           end.
      837         end.
      838       end.
      839     end.
      840   end.
      841   end procedure.
      842   procedure discprop-node-code :
      843   define input parameter p-dtm-code as integer no-undo .
      844   define input parameter p-node-code as integer no-undo .
      845   define output parameter p-data-type as character no-undo .
      846   define output parameter p-format as character no-undo .
      847   define output parameter p-label as character no-undo .
      848   define output parameter p-range as integer no-undo .
      849   define output parameter p-rw-option as character no-undo .
      850   define buffer buf_prop-map for ub.prop-map.
      851   define buffer buf_prop-head for ub.prop-head.
      852   do
      853   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      854   :
      855   find first buf_prop-head no-lock where
      856             buf_prop-head.dtm-code = p-dtm-code no-error .
      857   if available buf_prop-head then do:
      858     if p-node-code > 0 then do:
      859       find first buf_prop-map no-lock where
      860                 buf_prop-map.dtm-code = p-dtm-code
      861             and buf_prop-map.node-code = p-node-code no-error .
      862       if available buf_prop-map then do:
      863         assign
      864         p-data-type = buf_prop-map.node-value-type
      865         p-format = buf_prop-map.node-format
      866         p-label = buf_prop-map.node-label
      867         p-rw-option = buf_prop-map.rw-option
      868         .
      869       end.
      870     end.
      871     if buf_prop-head.storage-place  = "":U
      872     and buf_prop-head.storage-place-host  > "":U
      873     and buf_prop-head.storage-place-obj  > "":U then do:
      874       p-range =  12.
      875     end.
      876     if buf_prop-head.storage-place  > "":U
      877     and buf_prop-head.storage-place-host  > "":U
      878     and buf_prop-head.storage-place-obj  > "":U then do:
      879       p-range =  3.
      880     end.
      881     if buf_prop-head.storage-place  > "":U
      882     and buf_prop-head.storage-place-host  > "":U
      883     and buf_prop-head.storage-place-obj  = "":U then do:
      884       p-range =  2.
      885     end.
      886     if buf_prop-head.storage-place  = "":U
      887     and buf_prop-head.storage-place-host  > "":U
      888     and buf_prop-head.storage-place-obj  = "":U then do:
      889       p-range =  1.
      890     end.
      891     if buf_prop-head.storage-place  > "":U
      892     and buf_prop-head.storage-place-host  = "":U
      893     and buf_prop-head.storage-place-obj  = "":U then do:
      894       p-range =  0.
      895     end.
      896   end.
      897   end.
      898   end procedure.
      899   procedure discprop-initial:
      900   define input parameter p-dtm-code as integer no-undo .
      901   define input parameter p-node-code as integer no-undo .
      902   define output parameter p-init-value-character as character no-undo .
      903   define output parameter p-init-value-date as date no-undo .
      904   define output parameter p-init-value-decimal as decimal no-undo .
      905   define output parameter p-init-value-integer as integer no-undo .
      906   define output parameter p-init-value-logical as logical no-undo .
      907   define buffer buf_prop-map for ub.prop-map.
      908   find first buf_prop-map no-lock where
      909             buf_prop-map.dtm-code = p-dtm-code
      910         and buf_prop-map.node-code = p-node-code no-error.
      911   if not available buf_prop-map then return error substitute("Не найдено свойство &1 для объекта &2"
      912                                                               , p-node-code
      913                                                               , p-dtm-code).
      914   assign
      915   p-init-value-character = buf_prop-map.init-value-character
      916   p-init-value-date = buf_prop-map.init-value-date
      917   p-init-value-decimal = buf_prop-map.init-value-decimal
      918   p-init-value-integer = buf_prop-map.init-value-integer
      919   p-init-value-logical = buf_prop-map.init-value-logical
      920   .
      921   end procedure.
      922   Function discprop-usercanedit returns logical (  input p-dtm-code as integer, input p-db-num as integer):
      923   define buffer buf_attr-prop for ub.attr-prop.
      924   find first buf_attr-prop no-lock where
      925             buf_attr-prop.table-name = 'dis-card-property':U
      926         and buf_attr-prop.templ-rl-root = p-dtm-code
      927         and buf_attr-prop.upper-prop-code = "UserCanEdit"
      928         and buf_attr-prop.prop-code = (if p-db-num = 0 then 'DB0' else 'DBR':U) no-error.
      929   if not available buf_attr-prop
      930   or logical(buf_attr-prop.property-value) = no then do:
      931     return no.
      932   end.
      933   return yes.
      934   end function.
      935   procedure discprop-edit :
      936   define input parameter p-dtm-code-node-name as character no-undo .
      937   define output parameter p-edit-menu-section-num as integer no-undo .
      938   define buffer buf_attr-prop for ub.attr-prop.
      939   do
      940   on error undo, return error return-value
      941   :
      942     find first buf_attr-prop no-lock where
      943             buf_attr-prop.table-name = 'dis-card-property':U
      944        and  buf_attr-prop.templ-rl-root = integer(entry(1, p-dtm-code-node-name, chr(4)))
      945        and  buf_attr-prop.upper-prop-code = "ManualEdit":U
      946        and  buf_attr-prop.prop-code = "SectionNum":U no-error .
      947     if available buf_attr-prop then do:
      948       assign
      949       p-edit-menu-section-num = integer(buf_attr-prop.property-value).
      950     end.
      951   end.
      952   end procedure.
      953   procedure discprop-node-name :
      954   define input parameter p-dtm-code-node-name as character no-undo .
      955   define output parameter p-tool-tip as character no-undo .
      956   define output parameter p-node-label as character no-undo .
      957   define buffer buf_prop-map for ub.prop-map.
      958   define buffer buf_prop-head for ub.prop-head.
      959   do
      960   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      961   :
      962     find first buf_prop-head no-lock where
      963               buf_prop-head.dtm-code = integer(entry(1, p-dtm-code-node-name, chr(4) )) no-error .
      964     assign
      965     p-tool-tip   = if available buf_prop-head
      966                    then buf_prop-head.prop-des
      967                    else entry(1, p-dtm-code-node-name, chr(4) )
      968     p-node-label = (if available buf_prop-head
      969                     then buf_prop-head.prop-label
      970                     else '':U)
      971     .
      972     if entry(2, p-dtm-code-node-name, chr(4) ) <> "" then do:
      973       find first buf_prop-map no-lock where
      974                 buf_prop-map.dtm-code = integer(entry(1, p-dtm-code-node-name, chr(4) ))
      975           and  buf_prop-map.node-code = integer(entry(2, p-dtm-code-node-name, chr(4) )) no-error.
      976       if available buf_prop-map then do:
      977         assign
      978         p-tool-tip   = buf_prop-map.node-description
      979         p-node-label = (if available buf_prop-head
      980                         then buf_prop-head.prop-label
      981                         else '':U) + ":" + buf_prop-map.node-label
      982         .
      983       end.
      984     end.
      985   end.
      986   end procedure.
      987   procedure discprop-write :
      988   define input parameter p-d-card          like ub.dis-card-property.d-card     no-undo .
      989   define input parameter p-host-code       like ub.dis-card-property.host-code  no-undo .
      990   define input parameter p-obj-type        like ub.dis-card-property.obj-type   no-undo .
      991   define input parameter p-obj-code        like ub.dis-card-property.obj-code   no-undo .
      992   define input parameter p-dtm-code        like ub.dis-card-property.dtm-code   no-undo .
      993   define input parameter p-node-code       like ub.dis-card-property.node-code  no-undo .
      994   define input parameter p-dt-code         like ub.dis-card-property.dt-code    no-undo .
      995   define input parameter p-sum-id          like ub.dis-card-property.sum-id     no-undo .
      996   define input parameter p-value-character like ub.dis-card-property.property-value-character no-undo .
      997   define input parameter p-value-date      like ub.dis-card-property.property-value-date no-undo .
      998   define input parameter p-value-decimal   like ub.dis-card-property.property-value-decimal no-undo .
      999   define input parameter p-value-integer   like ub.dis-card-property.property-value-integer no-undo .
     1000   define input parameter p-value-logical   like ub.dis-card-property.property-value-logical no-undo .
     1001   define input parameter p-source-type     as character no-undo .
     1002   define input parameter p-source-ref      as character no-undo .
     1003   define input-output parameter p-chip-num as integer no-undo .
     1004   define input-output parameter p-corr-date as date no-undo .
     1005   define input-output parameter p-corr-time as integer no-undo .
     1006   do
     1007   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1008   :
     1009     define buffer buf_dis-card-property for ub.dis-card-property .
     1010     define buffer buf_dis-card for ub.dis-card.
     1011     define buffer buf_prop-ref for ub.prop-ref.
     1012     define variable v-data-type      as character no-undo .
     1013     define variable v-data-type-1    as character no-undo .
     1014     define variable v-format         as character no-undo .
     1015     define variable v-label          as character no-undo .
     1016     define variable v-range          as integer   no-undo .
     1017     define variable v-rw-option      as character no-undo .
     1018     run discprop-node-code in this-procedure
     1019       (
     1020        input  p-dtm-code
     1021       ,input  p-node-code
     1022       ,output v-data-type
     1023       ,output v-format
     1024       ,output v-label
     1025       ,output v-range
     1026       ,output v-rw-option
     1027       ) no-error .
     1028     if error-status :error then do:
     1029       undo, return error return-value .
     1030     end.
     1031     v-data-type-1 = entry(1, v-data-type).
     1032     if p-dt-code = ? then do:
     1033       find buf_prop-ref no-lock where
     1034           buf_prop-ref.dtm-code = p-dtm-code
     1035       and buf_prop-ref.sum-id = p-sum-id no-error.
     1036       if not available buf_prop-ref then do:
     1037         undo, return error substitute("Неопределен или неоднозначен ИТОГ/СРЕЗ для объекта-операнда &1 &2"
     1038                                       ,p-dtm-code
     1039                                       ,p-sum-id).
     1040       end.
     1041       assign
     1042       p-dt-code = buf_prop-ref.dt-code.
     1043     end.
     1044     if discprop-usercanedit ( input p-dtm-code, input g#db-num)  = no then do:
     1045       undo, return error "Нельзя редактировать свойство в данной БД".
     1046     end.
     1047     run discprop-check in this-procedure (
     1048                                             input v-range
     1049                                           ,input p-d-card
     1050                                           ,input p-host-code
     1051                                           ,input p-obj-type
     1052                                           ,input p-obj-code
     1053                                           ,input p-dtm-code
     1054                                           ,input p-node-code
     1055                                           ,input p-dt-code
     1056                                         ) no-error .
     1057     if error-status:error then undo,  return error return-value .
     1058     find first buf_dis-card-property exclusive-lock
     1059       where buf_dis-card-property.d-card    = p-d-card
     1060         and buf_dis-card-property.host-code = p-host-code
     1061         and buf_dis-card-property.obj-type  = p-obj-type
     1062         and buf_dis-card-property.obj-code  = p-obj-code
     1063         and buf_dis-card-property.dt-code = p-dt-code
     1064         and buf_dis-card-property.node-code = p-node-code
     1065       no-error .
     1066       find first buf_dis-card no-lock where
     1067                   buf_dis-card.d-card = p-d-card.
     1068     if not available buf_dis-card-property then do:
     1069       create buf_dis-card-property .
     1070       assign
     1071         buf_dis-card-property.d-card    = p-d-card
     1072         buf_dis-card-property.host-code = p-host-code
     1073         buf_dis-card-property.obj-type  = p-obj-type
     1074         buf_dis-card-property.obj-code  = p-obj-code
     1075         buf_dis-card-property.dt-code = p-dt-code
     1076         buf_dis-card-property.node-code = p-node-code
     1077         buf_dis-card-property.dtm-code = p-dtm-code
     1078         buf_dis-card-property.sum-id   = p-sum-id
     1079         buf_dis-card-property.card-num  = buf_dis-card.card-num
     1080         buf_dis-card-property.main-card  = buf_dis-card.main-card
     1081         buf_dis-card-property.first-card  = buf_dis-card.first-card
     1082         buf_dis-card-property.first-main-card  = buf_dis-card.first-main-card
     1083       .
     1084     end.
     1085     else do:
     1086       if (v-data-type-1 = 'character':U
     1087       and buf_dis-card-property.property-value-character = p-value-character)
     1088       or  (v-data-type-1 = 'date':U
     1089           and buf_dis-card-property.property-value-date = p-value-date)
     1090       or  (v-data-type-1 = 'decimal':U
     1091           and buf_dis-card-property.property-value-decimal = p-value-decimal)
     1092       or  (v-data-type-1 = 'integer':U
     1093           and buf_dis-card-property.property-value-integer = p-value-integer)
     1094       or  (v-data-type-1 = 'logical':U
     1095           and buf_dis-card-property.property-value-logical = p-value-logical)
     1096       then return.
     1097     end.
     1098     run disproph_write-dis-card-property-proc  in this-procedure (
     1099             buffer buf_dis-card-property
     1100             ,buffer Buf_dis-card
     1101             ,input p-d-card
     1102             ,input p-dt-code
     1103             ,input p-host-code
     1104             ,input p-obj-type
     1105             ,input p-obj-code
     1106             ,input p-dtm-code
     1107             ,input buf_dis-card.card-num
     1108             ,input buf_dis-card.main-card
     1109             ,input buf_dis-card.first-card
     1110             ,input buf_dis-card.first-main-card
     1111             ,input p-node-code
     1112             ,input (if new(buf_dis-card-property) then integer('1':U) else integer('2':U))
     1113             ,input p-source-type
     1114             ,input p-source-ref
     1115             ,input-output p-chip-num
     1116             ,input-output p-corr-date
     1117             ,input-output p-corr-time
     1118             ).
     1119     assign
     1120     buf_dis-card-property.property-value-character = (if v-data-type-1 = 'character':U
     1121                                                       then p-value-character
     1122                                                       else buf_dis-card-property.property-value-character)
     1123     buf_dis-card-property.property-value-date      = (if v-data-type-1 = 'date':U
     1124                                                       then p-value-date
     1125                                                       else buf_dis-card-property.property-value-date)
     1126     buf_dis-card-property.property-value-decimal   = (if v-data-type-1 = 'decimal':U
     1127                                                       then p-value-decimal
     1128                                                       else buf_dis-card-property.property-value-decimal)
     1129     buf_dis-card-property.property-value-integer   = (if v-data-type-1 = 'integer':U
     1130                                                       then p-value-integer
     1131                                                       else buf_dis-card-property.property-value-integer)
     1132     buf_dis-card-property.property-value-logical   = (if v-data-type-1 = 'logical':U
     1133                                                       then p-value-logical
     1134                                                       else buf_dis-card-property.property-value-logical)
     1135     buf_dis-card-property.trg-param = (if p-source-type = '':U then '':U else 'no-hist':U)
     1136     .
     1137     release buf_dis-card-property no-error .
     1138     if error-status:error then do:
     1139       return error return-value .
     1140     end.
     1141   end.
     1142   end procedure.
     1143   procedure discprop-delete :
     1144   define input parameter p-d-card    like ub.dis-card-property.d-card     no-undo .
     1145   define input parameter p-host-code like ub.dis-card-property.host-code  no-undo .
     1146   define input parameter p-obj-type  like ub.dis-card-property.obj-type   no-undo .
     1147   define input parameter p-obj-code  like ub.dis-card-property.obj-code   no-undo .
     1148   define input parameter p-dtm-code  like ub.dis-card-property.dtm-code   no-undo .
     1149   define input parameter p-node-code like ub.dis-card-property.node-code  no-undo .
     1150   define input parameter p-dt-code   like ub.dis-card-property.dt-code    no-undo .
     1151   define input parameter p-source-type as character no-undo .
     1152   define input parameter p-source-ref as character no-undo .
     1153   define output parameter p-deleted  as logical no-undo.
     1154   define input-output parameter p-chip-num as integer no-undo .
     1155   define input-output parameter p-corr-date as date no-undo .
     1156   define input-output parameter p-corr-time as integer no-undo .
     1157   do
     1158   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1159   :
     1160   define buffer buf_dis-card-property for ub.dis-card-property .
     1161   define buffer buf_dis-card for ub.dis-card.
     1162   define variable v-data-type      as character no-undo .
     1163   define variable v-format         as character no-undo .
     1164   define variable v-label          as character no-undo .
     1165   define variable v-range          as integer   no-undo .
     1166   define variable v-rw-option      as character   no-undo .
     1167     run discprop-node-code in this-procedure
     1168       (input  p-dtm-code
     1169       ,input  p-node-code
     1170       ,output v-data-type
     1171       ,output v-format
     1172       ,output v-label
     1173       ,output v-range
     1174       ,output v-rw-option
     1175       ) no-error .
     1176     if error-status :error then do:
     1177       undo, return error return-value .
     1178     end.
     1179     find first buf_dis-card-property exclusive-lock
     1180       where buf_dis-card-property.d-card    = p-d-card
     1181         and buf_dis-card-property.host-code = p-host-code
     1182         and buf_dis-card-property.obj-type  = p-obj-type
     1183         and buf_dis-card-property.obj-code  = p-obj-code
     1184         and buf_dis-card-property.dt-code = p-dt-code
     1185         and buf_dis-card-property.node-code = p-node-code
     1186       no-error NO-WAIT.
     1187     if not available buf_dis-card-property then do:
     1188       p-deleted = no.
     1189     end.
     1190     else do:
     1191       run disproph_write-dis-card-property-proc  in this-procedure (
     1192            buffer buf_dis-card-property
     1193           ,buffer buf_dis-card
     1194           ,input buf_dis-card-property.d-card
     1195           ,input buf_dis-card-property.dt-code
     1196           ,input buf_dis-card-property.host-code
     1197           ,input buf_dis-card-property.obj-type
     1198           ,input buf_dis-card-property.obj-code
     1199           ,input buf_dis-card-property.dtm-code
     1200           ,input buf_dis-card-property.card-num
     1201           ,input buf_dis-card-property.main-card
     1202           ,input buf_dis-card-property.first-card
     1203           ,input buf_dis-card-property.first-main-card
     1204           ,input buf_dis-card-property.node-code
     1205           ,input integer('99':U)
     1206           ,input p-source-type
     1207           ,input p-source-ref
     1208           ,input-output p-chip-num
     1209           ,input-output p-corr-date
     1210           ,input-output p-corr-time
     1211            ).
     1212       buf_dis-card-property.trg-param = (if p-source-type = '':U then '':U else 'no-hist':U).
     1213       delete buf_dis-card-property no-error .
     1214       if error-status:error then do:
     1215         return error return-value.
     1216       end.
     1217       p-deleted = yes.
     1218     end.
     1219   end.
     1220   end procedure.
     1221   procedure discprop-check :
     1222   define input parameter p-range  as integer no-undo .
     1223   define input parameter p-d-card like ub.dis-card-property.d-card no-undo .
     1224   define input parameter p-host-code like ub.dis-card-property.host-code no-undo .
     1225   define input parameter p-obj-type like ub.dis-card-property.obj-type no-undo .
     1226   define input parameter p-obj-code like ub.dis-card-property.obj-code no-undo .
     1227   define input parameter p-dtm-code like ub.dis-card-property.dtm-code no-undo .
     1228   define input parameter p-node-code like ub.dis-card-property.node-code no-undo .
     1229   define input parameter p-dt-code like ub.dis-card-property.dt-code no-undo .
     1230   define variable v-message as character no-undo .
     1231   define buffer buf_sysconf for ub.sysconf.
     1232   define buffer buf_clients for ub.clients.
     1233   define buffer buf_dis-card for ub.dis-card.
     1234   define buffer buf_attr-prop for ub.attr-prop.
     1235   do
     1236   on error undo, return error return-value
     1237   :
     1238     if p-host-code > 0 then do:
     1239       FIND FIRST buf_sysconf No-LOCK WHERE
     1240                 buf_sysconf.host-code = p-host-code No-ERROR.
     1241       IF NOT AVAIL buf_sysconf THEN DO:
     1242         v-message = substitute("Не найдена фирма &1", p-host-code).
     1243         RETURN ERROR v-message.
     1244       END.
     1245     end.
     1246     if p-obj-type <> "":U or
     1247         p-obj-code <> 0 then do:
     1248       find first buf_clients No-LOCK WHERE
     1249                 buf_clients.obj-type = p-obj-type AND
     1250                 buf_clients.obj-code = p-obj-code no-error .
     1251       if not available buf_clients then do:
     1252         v-message = substitute("Не найден объект &1&2", p-obj-type, p-obj-code).
     1253         RETURN ERROR v-message.
     1254       end.
     1255     end.
     1256     else if NOT (p-obj-type = "":U and p-obj-code = 0) then do:
     1257       v-message = substitute("Неверные значения параметров p-obj-type/p-obj-code и/или p-host-code: &1&2 &3"
     1258                               , p-obj-type
     1259                               , p-obj-code
     1260                               , p-host-code).
     1261       RETURN ERROR v-message.
     1262     end.
     1263     if p-d-card <> "":U then do:
     1264       find first buf_dis-card No-LOCK WHERE
     1265                   buf_dis-card.d-card = p-d-card No-ERROR.
     1266       if not avail buf_dis-card then do:
     1267         v-message =substitute("Не найдена ДК").
     1268         return error  v-message.
     1269       end.
     1270       if buf_dis-card.emitent-host-code <> 0
     1271       and p-host-code <> buf_dis-card.emitent-host-code then do:
     1272         v-message = substitute("Для фирменной карты свойство можно ввести только с привязкой к фирме-эмитенту").
     1273         return error v-message.
     1274       end.
     1275       if buf_dis-card.emitent-host-code = 0
     1276       and p-range = 1
     1277       and p-host-code <> 0 then do:
     1278         v-message = substitute("Для свойство с ОБЛАСТЬЮ ДЕЙСТВИЯ СОГЛАСНО КОДУ ЭМИТЕНТА&1" +
     1279                               "для ГЛОБАЛЬНОЙ карты можно ввести только ГЛОБАЛЬНОЕ свойство"
     1280                                 , chr(10)
     1281                               ).
     1282         return error v-message.
     1283       end.
     1284     end.
     1285   end.
     1286   end procedure.
     1287   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1288   define variable dcard-algo-field-name as character no-undo extent 3 init [
     1289    'd-pcnt':U
     1290   ,'cash-d-pcnt':U
     1291   ,'pcnt-kat':U].
     1292   define variable algo-field-abbr as character no-undo extent 3 init [
     1293    'ITEM%':U
     1294   ,'TOTAL%':U
     1295   ,'CATEG':U].
     1296   FUNCTION dct-algo-Date-to-String returns character(input  p-date as date):
     1297   define variable v-date-str as character no-undo .
     1298   assign
     1299   v-date-str = string(YEAR(p-date), "9999":U) + chr(47) +
     1300                string(Month(p-date), "99":U) + chr(47) +
     1301                string(DAY(p-date), "99":U).
     1302   return v-date-str.
     1303   END FUNCTION.
     1304   function dct-algo-string-to-date returns date ( input p-string  as character):
     1305     define variable v-date as date no-undo .
     1306     assign
     1307     v-date = date(integer(substring(p-string, 6, 2))
     1308                   ,integer(substring(p-string, 9, 2))
     1309                   ,integer(substring(p-string, 1, 4))
     1310                  ) no-error .
     1311     if error-status:error then return ?.
     1312     return v-date.
     1313   END FUNCTION.
     1314   FUNCTION dct-algo-get-sum-id-from-DT-CODE returns character ( input p-DT-CODE as integer):
     1315   define buffer buf_prop-ref for ub.prop-ref.
     1316   find first buf_prop-ref no-lock where
     1317             buf_prop-ref.DT-CODE = p-DT-CODE no-error.
     1318   if not available buf_prop-ref then do:
     1319     return chr(63).
     1320   end.
     1321   return buf_prop-ref.sum-id.
     1322   END FUNCTION.
     1323   FUNCTION dct-algo-get-description-sum-id returns character ( input p-dt-code as integer):
     1324   define variable v-des as character no-undo .
     1325   define buffer buf_prop-ref for ub.prop-ref.
     1326   define buffer buf_prop-head for ub.prop-head.
     1327   find first buf_prop-ref no-lock where
     1328             buf_prop-ref.dt-code = p-dt-code no-error.
     1329   if not available buf_prop-ref then do:
     1330     return substitute("Срез/итог по ДК c кодом &1 - срез не найден", p-dt-code).
     1331   end.
     1332   find first buf_prop-head no-lock where
     1333           buf_prop-head.dtm-code = buf_prop-ref.dtm-code no-error.
     1334   if not available buf_prop-head then do:
     1335     return substitute("Срез/итог по ДК &1 c кодом &2 - неизвестное", p-dt-code, buf_prop-ref.dtm-code).
     1336   end.
     1337   assign
     1338   v-des = substitute("&1  &2 &3"
     1339                     , buf_prop-head.prop-name
     1340                     , buf_prop-ref.sum-id
     1341                     , buf_prop-ref.caller_id).
     1342   return v-des.
     1343   end FUNCTION.
     1344   FUNCTION dct-algo-get-description-node-code returns character ( input p-dtm-code as integer
     1345                                                               ,input p-dt-code as integer
     1346                                                               ,input p-node-code as integer
     1347                                                               ):
     1348   define variable v-des as character no-undo .
     1349   define buffer buf_prop-ref for ub.prop-ref.
     1350   define buffer buf_prop-head for ub.prop-head.
     1351   define buffer buf_prop-map for ub.prop-map.
     1352   find first buf_prop-ref no-lock where
     1353             buf_prop-ref.dt-code = p-dt-code no-error.
     1354   if not available buf_prop-ref then do:
     1355     return substitute("Срез/итог по ДК c кодом &1 - срез не найден", p-dt-code).
     1356   end.
     1357   find first buf_prop-head no-lock where
     1358           buf_prop-head.dtm-code = p-dtm-code no-error.
     1359   if not available buf_prop-head then do:
     1360     return substitute("Срез/итог по ДК &1 c кодом &2 - неизвестное", p-dt-code, p-dtm-code).
     1361   end.
     1362   find first buf_prop-map no-lock where
     1363           buf_prop-map.dtm-code = p-dtm-code
     1364       and buf_prop-map.node-code = p-node-code no-error .
     1365   if not available buf_prop-map then do:
     1366     return substitute("Срез/итог по ДК &1, &2.&3 - неизвестно"
     1367                       , p-dt-code
     1368                       , buf_prop-head.prop-label
     1369                       , p-node-code).
     1370   end.
     1371   assign
     1372   v-des = substitute("&1.&2 &3 &4"
     1373                     , buf_prop-head.prop-label
     1374                     , buf_prop-map.node-label
     1375                     , buf_prop-ref.sum-id
     1376                     , buf_prop-ref.caller_id).
     1377   return v-des.
     1378   end FUNCTION.
     1379   function dct-algo-get-prev-sum-id RETURNS integer (
     1380                                                       input p-dt-code as integer
     1381                                                      ):
     1382   define variable v-dtm-code as integer no-undo .
     1383   define variable v-sum-id as character no-undo .
     1384   define variable v-caller-id as character no-undo .
     1385   define buffer buf_prop-ref for ub.prop-ref.
     1386   find first buf_prop-ref no-lock where
     1387           buf_prop-ref.dt-code = p-dt-code no-error.
     1388   if not available buf_prop-ref then return ?.
     1389   assign
     1390   v-dtm-code = buf_prop-ref.dtm-code
     1391   v-sum-id = buf_prop-ref.sum-id.
     1392   v-caller-id = buf_prop-ref.caller_id.
     1393   find last buf_prop-ref no-lock where
     1394             buf_prop-ref.dtm-code = v-dtm-code
     1395        and  buf_prop-ref.sum-id < v-sum-id
     1396        and  buf_prop-ref.caller_id = v-caller-id
     1397        no-error.
     1398   if available buf_prop-ref then return buf_prop-ref.dt-code.
     1399   return -1 .
     1400   END FUNCTION.
     1401   FUNCTION dct-algo-get_dcproperty-value returns logical (
     1402                                                             input p-prop-name as character
     1403                                                           , input p-d-card    as character
     1404                                                           , input p-host-code as integer
     1405                                                           , input p-obj-type  as character
     1406                                                           , input p-obj-code  as integer
     1407                                                           , output p-value-character as character
     1408                                                           , output p-value-date   as date
     1409                                                           , output p-value-integer as integer
     1410                                                           , output p-value-decimal as decimal
     1411                                                           , output p-value-logical as logical):
     1412     return no.
     1413   END FUNCTION.
     1414   FUNCTION dct-algo-get_dcproperty-value-chr returns logical (
     1415                                                             input p-d-card    as character
     1416                                                           , input p-emitent-host-code as integer
     1417                                                           , input p-type as character
     1418                                                           , input p-host-code as integer
     1419                                                           , input p-obj-type  as character
     1420                                                           , input p-obj-code  as integer
     1421                                                           , output p-value-chr as character):
     1422   define variable v-dt-code as integer no-undo .
     1423   define variable v-node-code as integer no-undo .
     1424   define variable v-field-name as character no-undo .
     1425   define variable v-storage-place as character no-undo .
     1426   define variable v-sum-id-value as character no-undo .
     1427   define variable v-sum-id-output as logical no-undo .
     1428   define variable v-value-chr as character no-undo .
     1429   define variable v-ii as integer no-undo .
     1430   define buffer buf_dis-card-property for ub.dis-card-property.
     1431   define buffer buf_dis-host for ub.dis-host.
     1432   define buffer buf_dis-obj for ub.dis-obj.
     1433   run get-cd-sumid in this-procedure (
     1434                                         input p-emitent-host-code
     1435                                        ,input p-type
     1436                                        ,input p-host-code
     1437                                        ,input p-obj-type
     1438                                        ,input p-obj-code
     1439                                        ,output v-sum-id-value
     1440                                        ,output v-sum-id-output
     1441                                       ) no-error.
     1442   if not v-sum-id-output then do:
     1443     return no.
     1444   end.
     1445   do v-ii = 1 to num-entries(v-sum-id-value):
     1446     assign
     1447     v-storage-place = entry(1, entry(v-ii, v-sum-id-value), chr(4))
     1448     v-dt-code = integer(entry(2, entry(v-ii, v-sum-id-value), chr(4)))
     1449     v-node-code = integer(entry(3, entry(v-ii, v-sum-id-value), chr(4)))
     1450     v-field-name = entry(4, entry(v-ii, v-sum-id-value), chr(4))
     1451     no-error .
     1452     if not error-status:error then do:
     1453       case v-storage-place:
     1454         when 'dis-card-property':U then do:
     1455           find first buf_dis-card-property no-lock where
     1456                     buf_dis-card-property.d-card = p-d-card
     1457               and  buf_dis-card-property.host-code = p-host-code
     1458               and  buf_dis-card-property.obj-type = p-obj-type
     1459               and  buf_dis-card-property.obj-code = p-obj-code
     1460               and  buf_dis-card-property.dt-code = v-dt-code
     1461               and  buf_dis-card-property.node-code = v-node-code no-error .
     1462           if available buf_dis-card-property then do:
     1463             v-value-chr = buffer buf_dis-card-property:handle:buffer-field(v-field-name):string-value.
     1464           end.
     1465           else do:
     1466             v-value-chr = chr(63).
     1467           end.
     1468         end.
     1469         when 'dis-obj':U then do:
     1470           find first buf_dis-obj no-lock where
     1471                     buf_dis-obj.d-card = p-d-card
     1472               and  buf_dis-obj.obj-type = p-obj-type
     1473               and  buf_dis-obj.obj-code = p-obj-code
     1474               and  buf_dis-obj.dt-code = v-dt-code no-error .
     1475           if available buf_dis-obj then do:
     1476             v-value-chr = buffer buf_dis-obj:handle:buffer-field(v-field-name):string-value.
     1477           end.
     1478           else do:
     1479             v-value-chr = chr(63).
     1480           end.
     1481         end.
     1482         when 'dis-host':U then do:
     1483           find first buf_dis-host no-lock where
     1484                     buf_dis-host.d-card = p-d-card
     1485               and  buf_dis-host.host-code = p-host-code
     1486               and  buf_dis-host.dt-code = v-dt-code no-error .
     1487           if available buf_dis-host then do:
     1488             v-value-chr = buffer buf_dis-host:handle:buffer-field(v-field-name):string-value.
     1489           end.
     1490           else do:
     1491             v-value-chr = chr(63).
     1492           end.
     1493         end.
     1494       end.
     1495     end.
     1496     p-value-chr = p-value-chr + (if v-ii = 1 then '':U else chr(44)) + v-value-chr.
     1497   end.
     1498   END FUNCTION.
     1499   FUNCTION dct-algo_custom-sent-description RETURNS CHARACTER
     1500     ( INPUT p-custom-sent as character ) :
     1501   DEFINE VARIABLE v-storage-place AS CHARACTER NO-UNDO.
     1502   DEFINE VARIABLE v-dtm-code AS integer NO-UNDO.
     1503   DEFINE VARIABLE v-sum-id AS character NO-UNDO.
     1504   DEFINE VARIABLE v-caller-id AS character NO-UNDO.
     1505   DEFINE VARIABLE v-node-code AS INTEGER NO-UNDO.
     1506   DEFINE VARIABLE v-sum-id-description AS CHARACTER.
     1507   DEFINE BUFFER buf_prop-ref FOR ub.prop-ref.
     1508   IF p-custom-sent = chr(63) THEN RETURN "Не отсылать".
     1509   assign
     1510   v-storage-place = entry(1, p-custom-sent, chr(4))
     1511   v-dtm-code = integer(entry(2, p-custom-sent, chr(4)))
     1512   v-sum-id   = entry(3, p-custom-sent, chr(4))
     1513   v-caller-id = entry(4, p-custom-sent, chr(4))
     1514   v-node-code = integer(entry(5, p-custom-sent, chr(4)))
     1515   no-error .
     1516   IF ERROR-STATUS:ERROR THEN DO:
     1517     MESSAGE
     1518     "Не могу разобрать строку, описывающую итог"
     1519      VIEW-AS ALERT-BOX WARNING.
     1520     RETURN chr(63).
     1521   END.
     1522   FIND FIRST buf_prop-ref NO-LOCK WHERE
     1523             buf_prop-ref.dtm-code = v-dtm-code
     1524        AND  buf_prop-ref.sum-id = v-sum-id
     1525        AND  buf_prop-ref.caller_id = v-caller-id NO-ERROR.
     1526   IF NOT AVAILABLE buf_prop-ref THEN DO:
     1527     FIND FIRST buf_prop-ref NO-LOCK WHERE
     1528               buf_prop-ref.dtm-code = v-dtm-code
     1529         AND  buf_prop-ref.caller_id = v-caller-id NO-ERROR.
     1530     IF NOT AVAILABLE buf_prop-ref THEN DO:
     1531         MESSAGE
     1532         "Не могу разобрать строку, описывающую итог"
     1533          VIEW-AS ALERT-BOX WARNING.
     1534         RETURN chr(63).
     1535      end.
     1536   end.
     1537   ASSIGN
     1538   v-sum-id-description =  dct-algo-get-description-node-code ( v-dtm-code
     1539                                                          ,buf_prop-ref.dt-code
     1540                                                          ,v-node-code).
     1541   RETURN v-sum-id-description.
     1542   END FUNCTION.
     1543   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1544   def var vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1545   define temp-table temp-drt-prop no-undo like ub.drt-prop.
     1546   procedure disrules-fill-properties:
     1547   define input  parameter p-templ-rl-root as integer   no-undo .
     1548   define buffer buf_drt-prop for ub.drt-prop.
     1549   define buffer buf_temp-drt-prop for temp-drt-prop.
     1550   do
     1551   on error undo, return error return-value
     1552   :
     1553     for each buf_temp-drt-prop:
     1554       delete buf_temp-drt-prop.
     1555     end.
     1556     for each buf_drt-prop where buf_drt-prop.templ-rl-root = p-templ-rl-root:
     1557       create buf_temp-drt-prop.
     1558       buffer-copy buf_drt-prop to buf_temp-drt-prop.
     1559     end.
     1560   end.
     1561   end procedure.
     1562   ~
     1563   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1564   procedure discfgru-check :
     1565   define input parameter p-table-name as character no-undo .
     1566   define input parameter p-templ-rl-root as integer no-undo .
     1567   define input parameter p-time-templ-rl-root as integer no-undo .
     1568   define input parameter p-pos-type as character no-undo .
     1569   define output parameter p-disnct-role as character no-undo .
     1570   define buffer buf_dis-cfg-rule for ub.dis-cfg-rule.
     1571     do
     1572     on error undo, return error return-value
     1573     :
     1574       find first buf_dis-cfg-rule no-lock where
     1575               buf_dis-cfg-rule.table-name = p-table-name
     1576           and buf_dis-cfg-rule.templ-rl-root = p-templ-rl-root
     1577           and (p-time-templ-rl-root = ? or  buf_dis-cfg-rule.time-templ-rl-root = p-time-templ-rl-root)
     1578           and buf_dis-cfg-rule.pos-type = p-pos-type no-error.
     1579       if not available buf_dis-cfg-rule
     1580       or p-pos-type = "":U
     1581       then do:
     1582          return error substitute("Для места использования типа &1 не определен тип скидки с шаблоном &2 &3"
     1583                                  ,entry (lookup (p-pos-type, 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,r-keeper,InfoKiosk,pricecheck-Servis+,Emulator-NKT-IBM,MARIA,-,bo,Autotank':U), 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,R-KEEPER,InfoKiosk,Прайс-чекер Servis+,Emulator-NKT-IBM,MARIA,Накладная,Бэкофис,Autotank':U)
     1584                                  , p-templ-rl-root
     1585                                  , (if p-time-templ-rl-root = ?
     1586                                     then '':U
     1587                                     else substitute("с расписанием типа &1", p-time-templ-rl-root)
     1588                                     )
     1589                                  ).
     1590       end.
     1591       assign
     1592       p-disnct-role = buf_dis-cfg-rule.discnt-role
     1593       .
     1594     end.
     1595   end procedure.
     1596   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1597   FUNCTION get-region RETURNS CHARACTER
     1598     ( input parhost-code as integer, input parobj-type as character, input parobj-code as integer ) :
     1599     define variable par-region as character no-undo.
     1600     if parhost-code = 0 and
     1601          parobj-type = "":U and
     1602          parobj-code = 0 then do:
     1603          par-region = "Глобально".
     1604          return par-region.
     1605       end.
     1606       if parobj-type = 'орг':U then do:
     1607          par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(parhost-code).
     1608          return par-region.
     1609       end.
     1610       if parobj-type = 'регион':U
     1611       then do:
     1612          par-region = fill(chr(32), 2) + "Регион" + chr(32) + string(parobj-code).
     1613          return par-region.
     1614       end.
     1615       par-region = fill(chr(32), 4) + parobj-type + chr(32) + string(parobj-code).
     1616       return par-region.
     1617   END FUNCTION.
     1618   FUNCTION get-objregion RETURNS CHARACTER
     1619     (  input parobj-type as character, input parobj-code as integer ) :
     1620     define variable par-region as character no-undo.
     1621     if  parobj-type = "":U and
     1622         parobj-code = 0
     1623     then do:
     1624        par-region = "Глобально".
     1625     end.
     1626     else if parobj-type = 'орг':U
     1627     then do:
     1628        par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(parobj-code).
     1629     end.
     1630     else if parobj-type = 'регион':U
     1631     then do:
     1632        par-region = fill(chr(32), 2) + "Регион" + chr(32) + string(parobj-code).
     1633     end.
     1634     else
     1635        par-region = fill(chr(32), 4) + parobj-type + chr(32) + string(parobj-code).
     1636     return par-region.
     1637   END FUNCTION.
     1638   procedure disdcrul-name :
     1639   define buffer buf_dis-rule for ub.dis-rule.
     1640   do
     1641     on error undo, return error
     1642     :
     1643     define input  parameter p-templ-rl-root  as integer no-undo .
     1644     define output parameter p-label          as character no-undo .
     1645     find first buf_dis-rule no-lock where
     1646               buf_dis-rule.rule-num = p-templ-rl-root no-error.
     1647     if available buf_dis-rule then do:
     1648       if buf_dis-rule.rule-num > 0 then
     1649       p-label = buf_dis-rule.des.
     1650     end.
     1651     else do:
     1652       p-label = substitute("Неизвестный тип правила скидки &1", p-templ-rl-root).
     1653     end.
     1654   end.
     1655   end procedure.
     1656   function disdcrul-get-disc-label returns character ( input p-templ-rl-root as integer):
     1657   define variable v-rule-label as character no-undo .
     1658   run disdcrul-name in this-procedure ( input p-templ-rl-root
     1659                                        ,output v-rule-label) no-error.
     1660   return v-rule-label.
     1661   end function.
     1662   function disdcrul-get-disc-role-label returns character ( input p-discnt-role as character):
     1663   define variable v-rule-label as character no-undo .
     1664   return entry (lookup (p-discnt-role, 'debet-pay-pcnt-disc,debet-pay-abs-disc,debet-pay-qnty-disc,debet-pay-sum-disc,debet-pay-free-disc,dc-d-pcnt,dc-cash-d-pcnt,credit-pay-pcnt-disc,credit-pay-abs-disc,credit-pay-qnty-disc,credit-pay-sum-disc,credit-pay-free-disc':u) + 1, ',' + '% Скидка при оплате топлива по дебет.ведомости,ABS Скидка при оплате топлива по дебет.ведомости,Скидка на кол-во при оплате топлива по дебет.ведомости,Скидка на сумму при оплате топлива по дебет.ведомости,Своб скидка при оплате топлива по дебет.ведомости,% скидка на товар по ДК,% скидка на итог чека по ДК,% Скидка при оплате топлива по кредит.ведомости,Abs Скидка при оплате топлива по кредит.ведомости,Скидка на кол-во при оплате топлива по кредит.ведомости,Скидка на сумму при оплате топлива по кредит.ведомости,Своб Скидка на сумму при оплате топлива по кредит.ведомости':u).
     1665   end function.
     1666   procedure disdcrul-write :
     1667     do
     1668     on error undo, return error
     1669     :
     1670       define input parameter p-d-card         like ub.dis-dc-rule.d-card     no-undo .
     1671       define input parameter p-host-code      like ub.dis-dc-rule.host-code  no-undo .
     1672       define input parameter p-obj-type       like ub.dis-dc-rule.obj-type   no-undo .
     1673       define input parameter p-obj-code       like ub.dis-dc-rule.obj-code   no-undo .
     1674       define input parameter p-pos-type       like ub.dis-dc-rule.pos-type   no-undo .
     1675       define input parameter p-discnt-role    like ub.dis-dc-rule.discnt-role no-undo .
     1676       define input parameter p-templ-rl-root  like ub.dis-dc-rule.templ-rl-root  no-undo .
     1677       define input parameter p-time-templ-rl-root  like ub.dis-dc-rule.time-templ-rl-root  no-undo .
     1678       define input parameter p-rule-num       like ub.dis-dc-rule.rule-num    no-undo .
     1679       define input parameter p-nonunique      like ub.dis-dc-rule.nonunique   no-undo .
     1680       define buffer buf_dis-rule for ub.dis-rule.
     1681       define buffer buf_dis-dc-rule for ub.dis-dc-rule .
     1682       define buffer lock_dis-dc-rule for ub.dis-dc-rule .
     1683       define variable v-label          as character no-undo .
     1684       define variable v-discnt-role as character no-undo .
     1685       run discfgru-check in this-procedure (
     1686                                             input 'dis-dc-rule':U
     1687                                            ,input p-templ-rl-root
     1688                                            ,input p-time-templ-rl-root
     1689                                            ,input p-pos-type
     1690                                            ,output v-discnt-role
     1691                                             ) no-error .
     1692       if error-status :error then do:
     1693         undo, return error return-value .
     1694       end.
     1695       if p-discnt-role = ? then do:
     1696         p-discnt-role = v-discnt-role.
     1697       end.
     1698       if p-discnt-role <> v-discnt-role then do:
     1699         undo, return error substitute("ДК &1 Фирма &2 &3&4 место использ. &5 скидка типа &6&7не может быть по шаблону &8 и расписанию &9"
     1700                                 ,p-d-card
     1701                                 ,p-host-code
     1702                                 ,p-obj-type
     1703                                 ,p-obj-code
     1704                                 ,p-pos-type
     1705                                 ,entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u)
     1706                                 ,chr(10)
     1707                                 ,p-templ-rl-root
     1708                                 ,p-rule-num).
     1709       end.
     1710       if p-pos-type = ? then do:
     1711   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1712   define variable v-param-type12 as character no-undo .
     1713   define variable v-value-date12 as date no-undo .
     1714   define variable v-value-decimal12 as decimal no-undo .
     1715   define variable v-value-integer12 as INTEGER no-undo .
     1716   define variable v-value-logical12 AS LOGICAL no-undo .
     1717   define variable v-tth12 as handle no-undo .
     1718   run adm/shattri.p (
     1719       input "get":U
     1720       ,input  p-obj-type
     1721       ,input  p-obj-code
     1722       ,input  'cd-sending':U
     1723       ,input  'dflt-cd':U
     1724       ,output p-pos-type
     1725       ,output v-value-date12
     1726       ,output v-value-decimal12
     1727       ,output v-value-integer12
     1728       ,output v-value-logical12
     1729       ,output v-param-type12
     1730       ,INPUT-OUTPUT table-handle v-tth12
     1731       )  .
     1732   delete object v-tth12 no-error.
     1733       end.
     1734       find first buf_dis-rule no-lock where
     1735                 buf_dis-rule.rule-num = p-rule-num no-error.
     1736       if not available buf_Dis-rule then do:
     1737         undo, return error substitute("ДК &1 Фирма &2 &3&4 место использ. &5 скидка типа &6&7не найдено правило скидки &8"
     1738                                 ,p-d-card
     1739                                 ,p-host-code
     1740                                 ,p-obj-type
     1741                                 ,p-obj-code
     1742                                 ,p-pos-type
     1743                                 ,entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u)
     1744                                 ,chr(10)
     1745                                 ,p-rule-num).
     1746       end.
     1747       if buf_dis-rule.root <> yes then do:
     1748         undo, return error substitute("ДК &1 Фирма &2 &3&4 место использ. &5 скидка типа &6&7правило скидки &8 - некорневое"
     1749                                 ,p-d-card
     1750                                 ,p-host-code
     1751                                 ,p-obj-type
     1752                                 ,p-obj-code
     1753                                 ,p-pos-type
     1754                                 ,entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u)
     1755                                 ,chr(10)
     1756                                 ,p-rule-num).
     1757       end.
     1758       if not (p-host-code = buf_dis-rule.host-code
     1759           and p-obj-type = buf_dis-rule.obj-type
     1760           and p-obj-code = buf_dis-rule.obj-code)
     1761       then do:
     1762         undo, return error (substitute("ДК &1 Фирма &2 &3&4 место использ. &5 скидка типа &6&7правило скидки &8 - некорневое"
     1763                                 ,p-d-card
     1764                                 ,p-host-code
     1765                                 ,p-obj-type
     1766                                 ,p-obj-code
     1767                                 ,p-pos-type
     1768                                 ,entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u)
     1769                                 ,chr(10)
     1770                                 )
     1771                             +
     1772                             substitute("Правило скидки &1 определено для &2&3" +
     1773                                        "а привязка к ДК для &4"
     1774                                        ,buf_dis-rule.rule-num
     1775                                        ,get-region( buf_Dis-rule.host-code, buf_dis-rule.obj-type, buf_Dis-rule.obj-code)
     1776                                        ,chr(10)
     1777                                        ,get-region( p-host-code, p-obj-type, p-obj-code)
     1778                                        ))
     1779                                 .
     1780       end.
     1781       find first buf_dis-dc-rule exclusive-lock where
     1782                  buf_dis-dc-rule.d-card  = p-d-card
     1783              AND buf_dis-dc-rule.obj-type  = p-obj-type
     1784              AND buf_dis-dc-rule.host-code = p-host-code
     1785              AND buf_dis-dc-rule.obj-code  = p-obj-code
     1786              AND buf_dis-dc-rule.pos-type  = p-pos-type
     1787              AND buf_dis-dc-rule.discnt-role = p-discnt-role
     1788              and buf_dis-dc-rule.nonunique = p-nonunique
     1789              no-error .
     1790       if not available buf_dis-dc-rule then do:
     1791         create buf_dis-dc-rule .
     1792         assign
     1793         buf_dis-dc-rule.d-card  = p-d-card
     1794         buf_dis-dc-rule.host-code  = p-host-code
     1795         buf_dis-dc-rule.obj-type  = p-obj-type
     1796         buf_dis-dc-rule.obj-code  = p-obj-code
     1797         buf_dis-dc-rule.pos-type = p-pos-type
     1798         buf_dis-dc-rule.discnt-role = v-discnt-role
     1799         buf_dis-dc-rule.rule-num = p-rule-num
     1800         buf_dis-dc-rule.nonunique = p-nonunique
     1801         no-error
     1802         .
     1803       end.
     1804       ASSIGN
     1805       buf_dis-dc-rule.time-templ-rl-root = p-time-templ-rl-root
     1806       buf_dis-dc-rule.rule-num = p-rule-num
     1807       buf_dis-dc-rule.rl-root = buf_Dis-rule.rl-root
     1808       buf_dis-dc-rule.templ-rl-root = p-templ-rl-root
     1809       buf_dis-dc-rule.nonunique = p-nonunique
     1810       no-error.
     1811     end.
     1812   end procedure.
     1813   define variable v-chg-fields as character no-undo.
     1814   define variable v-old-fields as character no-undo.
     1815   define variable v-new-fields as character no-undo.
     1816   define variable ii as integer no-undo.
     1817   define variable v-mess as character no-undo .
     1818   define buffer buf_c-dc-hist for ub.c-dc-hist.
     1819   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1820   define SHARED temp-table temp-changes no-undo
     1821   field f_name as character
     1822   field l_name as character
     1823   field v_old as character
     1824   field v_new as character
     1825   field t_name as character
     1826   field num_ as integer
     1827   field uniq-key-rec as character
     1828   field action as integer
     1829   field fNotChange as logical
     1830   index pi is unique primary
     1831   num_
     1832   t_name
     1833   f_name
     1834   index
     1835   Chan
     1836   fnotChange
     1837   t_name
     1838   f_name
     1839   index imain uniq-key-rec
     1840   .
     1841   FUNCTION get-all-fields returns character (p-file-name as character ):
     1842   define variable v-dop as character no-undo .
     1843     find first _file no-lock where _file._file-name = p-file-name no-error .
     1844     if not available _file then return "":U.
     1845     for each _field no-lock where
     1846              _field._file-recid = recid(_file) :
     1847       assign
     1848       v-dop = v-dop + _field._field-name + chr(44)
     1849       .
     1850     end.
     1851     return trim(v-dop).
     1852   END FUNCTION.
     1853   PROCEDURE proc-full-temp-changes :
     1854     define input  parameter p-act-create as logical   no-undo .
     1855     define input  parameter p-act-delete as logical   no-undo .
     1856     define input  parameter p-hst-handle as handle    no-undo .
     1857     define input  parameter p-main-table as character no-undo .
     1858     define input  parameter p-field-list as character no-undo .
     1859     define input  parameter p-label-form as character no-undo .
     1860     define variable h-new-buf         as handle    no-undo .
     1861     define variable h-main-buf        as handle    no-undo .
     1862     define variable h-for-comp        as handle    no-undo .
     1863     define variable v-inform          as character no-undo .
     1864     define variable v-ind             as integer   no-undo .
     1865     define variable v-idx-field-qnty  as integer   no-undo .
     1866     define variable v-num-entries     as integer   no-undo .
     1867     define variable fh                as handle    no-undo .
     1868     define variable fh-main           as handle    no-undo .
     1869     define variable fh-old            as handle    no-undo .
     1870     define variable fh-new            as handle    no-undo .
     1871     define variable v-field-name      as character no-undo .
     1872     define variable v-field-lvl       as character no-undo .
     1873     define variable v-field-form      as character no-undo .
     1874     define variable v-search-exp      as character no-undo .
     1875     define variable v-srch-main       as character no-undo .
     1876     define variable v-word-link       as character no-undo .
     1877     define variable v-av-chip-num     as logical   no-undo .
     1878     define variable v-main-pi-fld-lst as character no-undo .
     1879     define variable v-main-fld-lst    as character no-undo .
     1880     define variable v-delim-list      as character no-undo .
     1881     define variable v-label           as character no-undo .
     1882     define variable v-old-value       as character no-undo case-sensitive.
     1883     define variable v-new-value       as character no-undo case-sensitive.
     1884     define variable v-chg-fields as character no-undo.
     1885     for each temp-changes:
     1886       delete temp-changes.
     1887     end.
     1888     if not p-hst-handle:available then do:
     1889       return .
     1890     end.
     1891     create buffer h-new-buf  for table p-hst-handle .
     1892     create buffer h-main-buf for table p-main-table .
     1893     assign
     1894       v-inform = h-main-buf:index-information(1)
     1895       v-ind    = 2
     1896     .
     1897     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1898     on error undo, return error
     1899     :
     1900       assign
     1901         v-inform = h-main-buf:index-information( v-ind )
     1902         v-ind    = v-ind + 1
     1903       .
     1904     end.
     1905     if v-inform = ?
     1906       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1907       or entry( 3, v-inform, ",":U ) <> "1":U
     1908     then do:
     1909       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, h-main-buf:name ).
     1910     end.
     1911     assign
     1912       v-idx-field-qnty = num-entries( v-inform ) - 4
     1913     .
     1914     if v-idx-field-qnty < 2 then do:
     1915       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, h-main-buf:name ).
     1916     end.
     1917     assign
     1918       v-srch-main   = "where":U
     1919       v-word-link   = "":U
     1920       v-av-chip-num = false
     1921       v-delim-list  = "":U
     1922     .
     1923     do v-ind = 1 to v-idx-field-qnty by 2
     1924     on error undo, return error
     1925     :
     1926       assign
     1927         v-field-name      = entry( 4 + v-ind, v-inform, ",":U )
     1928         fh                = p-hst-handle:buffer-field( v-field-name )
     1929         fh-main           = h-main-buf:buffer-field( v-field-name )
     1930         v-srch-main       = substitute( "&1 &2 &3.&4 =", v-srch-main, v-word-link, fh-main:table, v-field-name )
     1931         v-main-pi-fld-lst = v-main-pi-fld-lst + v-delim-list + v-field-name
     1932       .
     1933       if fh:data-type ="character":U then do:
     1934         assign
     1935           v-srch-main = substitute( '&1 "&2"', v-srch-main, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
     1936         .
     1937       end.
     1938       else do:
     1939         assign
     1940           v-srch-main = substitute( "&1 &2", v-srch-main, fh:buffer-value() )
     1941         .
     1942       end.
     1943       if v-delim-list = "":U then do:
     1944         assign
     1945           v-delim-list = ",":U
     1946         .
     1947       end.
     1948       if v-word-link = "":U then do:
     1949         assign
     1950           v-word-link = "and":U
     1951         .
     1952       end.
     1953     end.
     1954     assign
     1955       v-delim-list  = "":U
     1956     .
     1957     do v-ind = 1 to h-main-buf:num-fields
     1958     on error undo, return error
     1959     :
     1960       assign
     1961         fh-main      = h-main-buf:buffer-field( v-ind )
     1962         v-field-name = fh-main:name
     1963       .
     1964         assign
     1965           v-main-fld-lst = v-main-fld-lst + v-delim-list + v-field-name
     1966         .
     1967         if v-delim-list = "":U then do:
     1968           assign
     1969             v-delim-list = ",":U
     1970           .
     1971         end.
     1972     end.
     1973     assign
     1974       v-inform = p-hst-handle:index-information(1)
     1975       v-ind    = 2
     1976     .
     1977     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1978     on error undo, return error
     1979     :
     1980       assign
     1981         v-inform = p-hst-handle:index-information( v-ind )
     1982         v-ind    = v-ind + 1
     1983       .
     1984     end.
     1985     if v-inform = ?
     1986       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1987       or entry( 3, v-inform, ",":U ) <> "1":U
     1988     then do:
     1989       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, p-hst-handle:name ).
     1990     end.
     1991     assign
     1992       v-idx-field-qnty = num-entries( v-inform ) - 4
     1993     .
     1994     if v-idx-field-qnty < 2 then do:
     1995       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, p-hst-handle:name ).
     1996     end.
     1997     assign
     1998       v-search-exp  = "where":U
     1999       v-word-link   = "":U
     2000       v-av-chip-num = false
     2001     .
     2002     do v-ind = 1 to v-idx-field-qnty by 2
     2003     on error undo, return error
     2004     :
     2005       assign
     2006         v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     2007         fh           = p-hst-handle:buffer-field( v-field-name )
     2008         v-search-exp = substitute( "&1 &2 &3.&4", v-search-exp, v-word-link, fh:table, v-field-name )
     2009       .
     2010       if v-field-name = "chip-num":U then do:
     2011         assign
     2012           v-search-exp  = substitute( "&1 >", v-search-exp )
     2013           v-av-chip-num = true
     2014         .
     2015       end.
     2016       else do:
     2017         assign
     2018           v-search-exp = substitute( "&1 =", v-search-exp )
     2019         .
     2020       end.
     2021       if fh:data-type ="character":U then do:
     2022         assign
     2023           v-search-exp = substitute( '&1 "&2"', v-search-exp, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
     2024         .
     2025       end.
     2026       else do:
     2027         assign
     2028           v-search-exp = substitute( '&1 &2', v-search-exp, fh:buffer-value() )
     2029         .
     2030       end.
     2031       if v-word-link = "":U then do:
     2032         assign
     2033           v-word-link = "and":U
     2034         .
     2035       end.
     2036     end.
     2037     if v-av-chip-num = false then do:
     2038       message
     2039         vss-workfile vss-revision vss-description skip
     2040         substitute( "Таблица &2 не содержит поля chip-num.", vss-workfile, p-hst-handle:name ) skip
     2041         "Использование данной процедуры невозможно!" skip
     2042         view-as alert-box error .
     2043       return error .
     2044     end.
     2045     h-new-buf:find-first( v-search-exp, no-lock ) no-error .
     2046     if not h-new-buf:available then do:
     2047       h-main-buf:find-first( v-srch-main, no-lock ) no-error .
     2048       if not h-main-buf:available then do:
     2049         assign
     2050           h-for-comp = ?
     2051         .
     2052       end.
     2053       else do:
     2054         assign
     2055           h-for-comp = h-main-buf
     2056         .
     2057       end.
     2058     end.
     2059     else do:
     2060       assign
     2061         h-for-comp = h-new-buf
     2062       .
     2063     end.
     2064     assign
     2065       v-num-entries = num-entries( v-main-fld-lst, ",":U )
     2066     .
     2067     do v-ind = 1 to v-num-entries
     2068     on error undo, return error return-value
     2069     :
     2070       assign
     2071         v-field-name = entry( v-ind, v-main-fld-lst )
     2072         fh-old       = p-hst-handle:buffer-field( v-field-name )
     2073         v-old-value  = fh-old:buffer-value()
     2074         v-label      = trim( fh-old:label )
     2075       .
     2076       if ( trim( p-field-list ) <> "":U
     2077            and lookup( v-field-name, p-field-list ) > 0
     2078          )
     2079          or trim( p-field-list ) = "":U
     2080       then do:
     2081         if h-for-comp <> ? then do:
     2082           assign
     2083             fh-new      = h-for-comp:buffer-field( v-field-name )
     2084             v-new-value = fh-new:buffer-value()
     2085           .
     2086         end.
     2087         else do:
     2088           assign
     2089             v-new-value = "":U
     2090           .
     2091         end.
     2092           if p-act-create = true then do:
     2093             assign
     2094               v-old-value = "":U
     2095             .
     2096           end.
     2097           if p-act-delete = true then do:
     2098             assign
     2099               v-new-value = "":U
     2100             .
     2101           end.
     2102         if v-old-value <> v-new-value
     2103         then do:
     2104           create temp-changes.
     2105           assign
     2106             temp-changes.t_name = p-main-table
     2107             temp-changes.f_name = v-field-name
     2108             temp-changes.l_name = replace( v-label, "&":U, "":U )
     2109             temp-changes.v_old  = trim( v-old-value )
     2110             temp-changes.v_new  = trim( v-new-value )
     2111             temp-changes.num_   = 0
     2112             temp-changes.fNotChange = v-old-value eq v-new-value
     2113           .
     2114         end.
     2115       end.
     2116     end.
     2117     assign
     2118       v-num-entries = num-entries( p-label-form, chr(8) )
     2119     .
     2120     do v-ind = 1 to v-num-entries
     2121     on error undo, return error return-value
     2122     :
     2123       if num-entries( entry( v-ind, p-label-form, chr(8) ), chr(4) ) = 3 then do:
     2124         assign
     2125           v-field-name = entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     2126           v-field-lvl  = entry( 2, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     2127           v-field-form = entry( 3, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     2128         .
     2129         find first temp-changes
     2130           where temp-changes.f_name = v-field-name
     2131           no-error .
     2132         if available temp-changes then do:
     2133           if trim( v-field-lvl ) <> "":U then do:
     2134             assign
     2135               temp-changes.l_name = v-field-lvl
     2136             .
     2137           end.
     2138           if trim( v-field-form ) <> "":U then do:
     2139             assign
     2140               temp-changes.v_old = dynamic-function( v-field-form, temp-changes.v_old )
     2141             .
     2142             if h-for-comp <> ? then do:
     2143               assign
     2144                 temp-changes.v_new = dynamic-function( v-field-form, temp-changes.v_new )
     2145               .
     2146             end.
     2147           end.
     2148         end.
     2149       end.
     2150       else do:
     2151         message
     2152           vss-workfile vss-revision vss-description skip
     2153           "Ошибка! Список должен содержать три поля с разделителем delim-par!" skip
     2154           substitute( "список для поля '&1': '&2'"
     2155                       ,entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     2156                       ,entry( v-ind, p-label-form, chr(8) )
     2157                     ) skip
     2158           substitute( "полный список: &2", p-label-form ) skip
     2159           view-as alert-box error .
     2160       end.
     2161     end.
     2162     delete object h-new-buf .
     2163     delete object h-main-buf .
     2164   END PROCEDURE.
     2165   find first buf_c-dc-hist no-lock where
     2166             buf_c-dc-hist.d-card = p-d-card
     2167         AND buf_c-dc-hist.chip-num = p-chip-num
     2168         AND buf_c-dc-hist.corr-user-db-num = p-corr-user-db-num
     2169         AND buf_c-dc-hist.subject  = p-subject no-error .
     2170   if not available buf_c-dc-hist then do:
     2171     return error .
     2172   end.
     2173   CASE p-subject:
     2174     when 'dis-card':U then do:
     2175       run dis-card-proc in this-procedure(output p-description) no-error .
     2176     end.
     2177     when 'dis-obj':U then do:
     2178       run dis-obj-proc in this-procedure(output p-description) no-error .
     2179     end.
     2180     when 'dis-host':U then do:
     2181       run dis-host-proc in this-procedure(output p-description) no-error  .
     2182     end.
     2183     when 'dis-card-property':U then do:
     2184       run dis-card-property-proc in this-procedure(output p-description) no-error .
     2185     end.
     2186     when 'dis-dc-rule':U then do:
     2187       run dis-dc-rule-proc in this-procedure(output p-description) no-error .
     2188     end.
     2189   END CASE.
     2190   if error-status:error then do:
     2191     return error .
     2192   end.
     2193   procedure dis-card-proc :
     2194   define output parameter p-description as character no-undo .
     2195   define buffer current_c-dis-card for ub.c-dis-card.
     2196     do
     2197     on error undo, return error return-value
     2198     :
     2199       find first current_c-dis-card no-lock where
     2200                  current_c-dis-card.d-card = p-d-card
     2201              AND current_c-dis-card.chip-num = p-chip-num
     2202              AND current_c-dis-card.corr-user-db-num = p-corr-user-db-num no-error .
     2203       if not avail current_c-dis-card then do:
     2204          v-mess = "Неверная ссылка на c-dis-card в таблице c-dc-hist".
     2205          run err-mess in this-procedure ( input-output v-mess).
     2206          return error (if p-silent then v-mess else '':U).
     2207       end.
     2208   define variable v-label-param as character no-undo .
     2209   v-label-param =
     2210     "card-num" + chr(4) + "Вн № карты" + chr(4) + "" + chr(8)
     2211    + "cash-d-pcnt" + chr(4) + "% скидки на итог" + chr(4) + "" + chr(8)
     2212    + "category" + chr(4) + "Категория" + chr(4) + "" + chr(8)
     2213    + "cli-code" + chr(4) + "Код клиента" + chr(4) + "" + chr(8)
     2214    + "cli-message" + chr(4) + "Сообщ. для клиента" + chr(4) + "" + chr(8)
     2215    + "cli-type" + chr(4) + "Тип клиента" + chr(4) + "" + chr(8)
     2216    + "credit-card" + chr(4) + "Кредитная карта" + chr(4) + "" + chr(8)
     2217    + "d-card" + chr(4) + "№ карты" + chr(4) + "" + chr(8)
     2218    + "d-pcnt" + chr(4) + "Процент скидки" + chr(4) + "" + chr(8)
     2219    + "d-pcnt-method" + chr(4) + "Тип скидки" + chr(4) + "" + chr(8)
     2220    + "debet-card" + chr(4) + "Дебетовая карта" + chr(4) + "" + chr(8)
     2221    + "emitent-host-code" + chr(4) + "Код эмитента" + chr(4) + "" + chr(8)
     2222    + "issue-code" + chr(4) + "Выдал магазин" + chr(4) + "" + chr(8)
     2223    + "issue-date" + chr(4) + "Выдано (дата)" + chr(4) + "" + chr(8)
     2224    + "lim-kr" + chr(4) + "Лимит кредита" + chr(4) + "" + chr(8)
     2225    + "saldo-base" + chr(4) + "Баланс баз вал" + chr(4) + "" + chr(8)
     2226    + "saldo-rubl" + chr(4) + "Баланс нац.вал." + chr(4) + "" + chr(8)
     2227    + "sourced-card" + chr(4) + "Выдано к карте" + chr(4) + "" + chr(8)
     2228    + "staff-card" + chr(4) + "Карта персонала" + chr(4) + "" + chr(8)
     2229    + "status_" + chr(4) + "Статус" + chr(4) + "" + chr(8)
     2230    + "type" + chr(4) + "Тип" + chr(4) + "" + chr(8)
     2231    + "valid-from" + chr(4) + "Начало действия" + chr(4) + "" + chr(8)
     2232    + "valid-date" + chr(4) + "Оконч действия" + chr(4) + "" + chr(8)
     2233    + "first-card" + chr(4) + "Первичная" + chr(4) + "" + chr(8)
     2234    + "first-main-card" + chr(4) + "Первичная основная" + chr(4) + "" + chr(8)
     2235    + "main-card" + chr(4) + "Основная" + chr(4) + "" + chr(8)
     2236    + "is-subsid" + chr(4) + "Дополн?" + chr(4) + "" + chr(8)
     2237    + "overissue-num" + chr(4) + "Пор-к в цепочке перевыпуска" + chr(4) + "" + chr(8)
     2238    + "service-db-num" + chr(4) + "Обслуживающая БД" + chr(4) + ""  .
     2239    run proc-full-temp-changes in this-procedure (
     2240                                                input  (buf_c-dc-hist.action = integer('1':U))
     2241                                               ,input  (buf_c-dc-hist.action = integer('99':U))
     2242                                               ,input  buffer current_c-dis-card:handle
     2243                                               ,input  'dis-card':U
     2244                                               ,input  "card-num,cash-d-pcnt,category,cli-code,cli-message,cli-type,credit-card,d-card,d-pcnt,d-pcnt-method,debet-card,emitent-host-code,issue-code,issue-date,lim-kr,saldo-base,saldo-rubl,sourced-card,staff-card,status_,type,valid-date,first-card,first-main-card,main-card,is-subsid,overissue-num,service-db-num"
     2245                                               ,input  v-label-param).
     2246   end.
     2247   end procedure.
     2248   procedure dis-card-property-proc :
     2249   define output parameter p-description as character no-undo .
     2250   define variable v-tooltip as character no-undo .
     2251   define variable v-label as character no-undo .
     2252   define variable v-mess as character no-undo .
     2253   define buffer current_c-dis-card-property for ub.c-dis-card-property  .
     2254   do
     2255   on error undo, return error return-value
     2256   :
     2257       find first current_c-dis-card-property no-lock where
     2258                  current_c-dis-card-property.d-card = p-d-card
     2259              AND current_c-dis-card-property.chip-num = p-chip-num
     2260              AND current_c-dis-card-property.corr-user-db-num = p-corr-user-db-num
     2261              no-error .
     2262       if not avail current_c-dis-card-property then do:
     2263          v-mess = "Неверная ссылка на c-dis-card-property в таблице c-dc-hist".
     2264          run err-mess in this-procedure ( input-output v-mess).
     2265       end.
     2266       run discprop-node-name in this-procedure ( input substitute("&1&2&3"
     2267                                                                   ,current_c-dis-card-property.dtm-code
     2268                                                                   , chr(4)
     2269                                                                   ,current_c-dis-card-property.node-code)
     2270                                             ,output v-tooltip
     2271                                             ,output v-label
     2272                                             ) no-error .
     2273       assign
     2274       p-description = "Свойство" + chr(32) + v-label
     2275       .
     2276   define variable v-label-param as character no-undo .
     2277   v-label-param =
     2278     "d-card" + chr(4) + "№ карты" + chr(4) + "" + chr(8)
     2279    + "dt-code" + chr(4) + "Код среза" + chr(4) + "" + chr(8)
     2280    + "sum-id" + chr(4) + "ID среза" + chr(4) + "" + chr(8)
     2281    + "host-code" + chr(4) + "Код фирмы" + chr(4) + "" + chr(8)
     2282    + "obj-type" + chr(4) + "Тип объекта" + chr(4) + "" + chr(8)
     2283    + "obj-code" + chr(4) + "Код объекта" + chr(4) + "" + chr(8)
     2284    + "property-value-character" + chr(4) + "Значение(строковое)" + chr(4) + "" + chr(8)
     2285    + "property-value-date" + chr(4) + "Значение(дата)" + chr(4) + "" + chr(8)
     2286    + "property-value-decimal" + chr(4) + "Значение(десятичное)" + chr(4) + "" + chr(8)
     2287    + "property-value-integer" + chr(4) + "Значение(целое)" + chr(4) + "" + chr(8)
     2288    + "property-value-logical" + chr(4) + "Значение(логическое)" + chr(4) + "" + chr(8)
     2289    + "dtm-code" + chr(4) + "Код объекта-операнда" + chr(4) + ""  .
     2290    run proc-full-temp-changes in this-procedure (
     2291                                                input  (buf_c-dc-hist.action = integer('1':U))
     2292                                               ,input  (buf_c-dc-hist.action = integer('99':U))
     2293                                               ,input  buffer current_c-dis-card-property:handle
     2294                                               ,input  'dis-card-property':U
     2295                                               ,input  "d-card,dt-code,sum-id,host-code,obj-type,obj-code,property-value-character,property-value-date,property-value-decimal,property-value-integer,property-value-logical,dtm-code"
     2296                                               ,input  v-label-param).
     2297   end.
     2298   end procedure.
     2299   procedure dis-obj-proc :
