     2389   procedure dis-dc-rule-proc :
     2390   define output parameter p-description as character no-undo .
     2391   define variable v-label as character no-undo .
     2392   define buffer current_c-dis-dc-rule for ub.c-dis-dc-rule  .
     2393   do
     2394   on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     2395   :
     2396       find first current_c-dis-dc-rule no-lock where
     2397                  current_c-dis-dc-rule.d-card = p-d-card
     2398              AND current_c-dis-dc-rule.chip-num = p-chip-num
     2399              AND current_c-dis-dc-rule.corr-user-db-num = p-corr-user-db-num    no-error .
     2400       if not avail current_c-dis-dc-rule then do:
     2401          v-mess = "Неверная ссылка на c-dis-dc-rule в таблице c-dc-hist".
     2402          run err-mess in this-procedure ( input-output v-mess).
     2403          return error v-mess.
     2404       end.
     2405       run disdcrul-name in this-procedure (
     2406                   input  current_c-dis-dc-rule.templ-rl-root
     2407                   ,output v-label
     2408                   ) no-error .
     2409       assign
     2410       p-description = substitute("Тип скидки &1", v-label)
     2411       .
     2412   define variable v-label-param as character no-undo .
     2413   v-label-param =
     2414     "rule-num" + chr(4) + "Номер правила скидки" + chr(4) + "" + chr(8)
     2415    + "pos-type" + chr(4) + "Место использ." + chr(4) + "" + chr(8)
     2416    + "templ-rl-root" + chr(4) + "Шаблон скидки" + chr(4) + "disdcrul-get-disc-label"  + chr(8)
     2417    + "discnt-role" + chr(4) + "Тип скидки" + chr(4) + "disdcrul-get-disc-role-label"  .
     2418    run proc-full-temp-changes in this-procedure (
     2419                                                input  (buf_c-dc-hist.action = integer('1':U))
     2420                                               ,input  (buf_c-dc-hist.action = integer('99':U))
     2421                                               ,input  buffer current_c-dis-dc-rule:handle
     2422                                               ,input  'dis-dc-rule':U
     2423                                               ,input  "rule-num,pos-type,templ-rl-root,discnt-role"
     2424                                               ,input  v-label-param).
     2425   end.
     2426   end procedure.
     2427   PROCEDURE err-mess:
     2428     DEFINE INPUT-output PARAMETER p-mess as character No-UNDO.
     2429     CASE p-silent:
     2430       when yes then do:
     2431         p-mess = substitute("История контрагента  &1&2: щепка &3 БД:&4 фирма: &5  Предмет изменений &6&7&8"
     2432                             ,p-obj-type
     2433                             , p-obj-code
     2434                             , p-chip-num
     2435                             , p-corr-user-db-num
     2436                             , p-host-code
     2437                             , p-subject
     2438                             ,chr(10)
     2439                             ,p-mess
     2440                             ).
     2441       end.
     2442       otherwise do:
     2443         message
     2444         p-mess
     2445         view-as alert-box error .
     2446       end.
     2447     end.
     2448   END PROCEDURE.
