     2373    + "sum-dis-rubl" + chr(4) + "Скидка итоговая в баз.вал." + chr(4) + "" + chr(8)
     2374    + "sum-tot-base" + chr(4) + "Суммовые строки" + chr(4) + "" + chr(8)
     2375    + "sum-tot-rubl" + chr(4) + "Суммовые строки" + chr(4) + "" + chr(8)
