     2322    + "gds-dis-rubl" + chr(4) + "Скидка тов. - нац.вал." + chr(4) + "" + chr(8)
     2323    + "gds-tot-b0" + chr(4) + "Сум. тов. в учет. ценах баз вал." + chr(4) + "" + chr(8)
     2324    + "gds-tot-base" + chr(4) + "Сум. тов. в ценах продажи баз вал." + chr(4) + "" + chr(8)
     2325    + "gds-tot-r0" + chr(4) + "Сум. тов. в учет. ценах нац.вал." + chr(4) + "" + chr(8)
     2326    + "gds-tot-rubl" + chr(4) + "Сум. тов. в ценах продажи нац.вал." + chr(4) + "" + chr(8)
     2327    + "sum-dis-base" + chr(4) + "Скидка итоговая в баз.вал." + chr(4) + "" + chr(8)
     2328    + "sum-dis-rubl" + chr(4) + "Скидка итоговая в нац.вал." + chr(4) + "" + chr(8)
     2329    + "sum-tot-base" + chr(4) + "Суммовые строки" + chr(4) + "" + chr(8)
     2330    + "sum-tot-rubl" + chr(4) + "Суммовые строки" + chr(4) + "" + chr(8)
     2331    + "num-chk" + chr(4) + "Число чеков" + chr(4) + "" + chr(8)
     2332    + "pay-tot-base" + chr(4) + "Сум. плат. баз вал." + chr(4) + "" + chr(8)
     2333    + "pay-tot-rubl" + chr(4) + "Сум. плат. нац.вал." + chr(4) + "" + chr(8)
     2334    + "dt-code" + chr(4) + "№ частного итога" + chr(4) + ""  .
     2335    run proc-full-temp-changes in this-procedure (
     2336                                                input  (buf_c-dc-hist.action = integer('1':U))
     2337                                               ,input  (buf_c-dc-hist.action = integer('99':U))
     2338                                               ,input  buffer current_c-dis-obj:handle
     2339                                               ,input  'dis-obj':U
     2340                                               ,input  "card-num,gds-dis-base,gds-dis-rubl,gds-tot-b0,gds-tot-base,gds-tot-r0,gds-tot-rubl,sum-dis-base,sum-dis-rubl,sum-tot-base,sum-tot-rubl,num-chk,pay-tot-base,pay-tot-rubl,dt-code"
     2341                                               ,input  v-label-param).
     2342   end.
     2343   end procedure.
     2344   procedure dis-host-proc :
