        1   block-level on error undo, throw.
        2   define input parameter p-d-card  like ub.c-dc-hist.d-card no-undo .
        3   define input parameter p-chip-num like ub.c-dc-hist.chip-num no-undo .
        4   define input parameter p-corr-user-db-num like ub.c-dc-hist.corr-user-db-num no-undo .
        5   define input parameter p-obj-type like ub.c-dc-hist.obj-type no-undo .
        6   define input parameter p-obj-code like ub.c-dc-hist.obj-code no-undo .
        7   define input parameter p-host-code like ub.c-dc-hist.host-code no-undo .
        8   define input parameter p-subject like ub.c-dc-hist.subject no-undo .
        9   define input parameter p-action   like ub.c-dc-hist.action no-undo .
       10   define input parameter p-silent  as logical no-undo .
       11   define output parameter p-description as character no-undo .
       12   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       13   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       14   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       15   define variable vss-workfile    as character no-undo init "$Workfile: cdchisv.p $":U .
       16   define variable vss-archive     as character no-undo init "$Archive: ref/cdchisv.p $":U .
       17   define variable vss-description as character no-undo init "Заполнение временной таблицы для показа изменений по таблицам истории ДК".
       18   procedure vss-get-info :
       19     define output parameter p-vss-revision    like vss-revision    no-undo .
       20     define output parameter p-vss-author      like vss-author      no-undo .
       21     define output parameter p-vss-date        like vss-date        no-undo .
       22     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       23     define output parameter p-vss-archive     like vss-archive     no-undo .
       24     define output parameter p-vss-description like vss-description no-undo .
       25     assign
       26       p-vss-revision    = vss-revision
       27       p-vss-author      = vss-author
       28       p-vss-date        = vss-date
       29       p-vss-workfile    = vss-workfile
       30       p-vss-archive     = vss-archive
       31       p-vss-description = vss-description
       32     .
       33   end procedure.
       34   procedure vss-get-parameters :
       35     define output parameter p-vss-parameters as character no-undo .
       36   end procedure.
       37   define new global shared variable g#vssrevis-logger as handle    no-undo .
       38   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       39   define variable v-vssrevis-logger                   as handle    no-undo .
       40   procedure vss-logevent :
       41     define input  parameter p-extra-paramters as character no-undo .
       42     define variable v-vssrevis-parameters as character no-undo .
       43     do
       44     on error undo, return error return-value
       45     :
       46       if  valid-handle(v-vssrevis-logger)
       47       and v-vssrevis-logger :get-signature("logevent") <> ""
       48       then do:
       49         run vss-get-parameters in this-procedure
       50           (output v-vssrevis-parameters
       51           ).
       52         run logevent in v-vssrevis-logger
       53           (input vss-workfile
       54           ,input vss-revision
       55           ,input v-vssrevis-parameters
       56           ,input p-extra-paramters
       57           ).
       58       end.
       59     end.
       60   end procedure.
       61   assign
       62     v-vssrevis-logger = g#vssrevis-logger
       63   .
       64   if  valid-handle(v-vssrevis-logger)
       65   and v-vssrevis-logger :get-signature("logevent") <> ""
       66   then do:
       67     assign
       68       v-vssrevis-logevent = true
       69     .
       70     run vss-logevent in this-procedure (input vss-description) .
       71   end.
       72   define new global shared variable g#language as character no-undo .
       73   if g#language <> '' and g#language <> 'rus':U then do:
       74     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       75   end.
       76   define new global shared variable g#library  as handle no-undo .
       77   define new global shared variable g#library2 as handle no-undo .
       78   define   shared variable g#auto as logical no-undo.
       79   define   shared variable g#news as logical no-undo.
       80   define   shared variable g#oxml as logical no-undo.
       81   define   shared variable g#esys as logical no-undo.
       82   define   shared variable g#news-source-db as integer no-undo.
       83   define   shared variable g#esys-source-esys as integer no-undo.
       84   define   shared variable g#db-num as integer   no-undo .
       85   define   shared variable g#userid as character no-undo .
       86   define   shared variable g#passwd as character no-undo .
       87   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       88   define variable v-disprop-menu-section-num as integer no-undo .
       89   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       90   def var vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       91   procedure gen-key-rec :
       92     define input  parameter p-tbl-name    as character no-undo.
       93     define input  parameter p-bh_tbl-name as handle    no-undo.
       94     define output parameter p-key-rec     as character no-undo.
       95     do
       96     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
       97     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
       98     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
       99     :
      100       define variable fh               as handle    no-undo .
      101       define variable v-ok             as logical   no-undo .
      102       define variable v-inform         as character no-undo .
      103       define variable v-ind            as integer   no-undo .
      104       define variable v-idx-field-qnty as integer   no-undo .
      105       if p-tbl-name = ?
      106         or p-tbl-name = "":U
      107       then do:
      108         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info2 ).
      109       end.
      110       if not p-bh_tbl-name:available then do:
      111         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info2, p-tbl-name ).
      112       end.
      113       assign
      114         p-key-rec = p-tbl-name
      115         v-inform  = p-bh_tbl-name:index-information(1)
      116         v-ind     = 2
      117       .
      118       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      119       on error undo, return error
      120       :
      121         assign
      122           v-inform = p-bh_tbl-name:index-information( v-ind )
      123           v-ind    = v-ind + 1
      124         .
      125       end.
      126       if v-inform = ?
      127         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      128         or entry( 3, v-inform, ",":U ) <> "1":U
      129       then do:
      130         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info2, p-tbl-name ).
      131       end.
      132       else do:
      133         assign
      134           v-idx-field-qnty = num-entries( v-inform ) - 4
      135         .
      136         if v-idx-field-qnty < 2 then do:
      137           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info2, v-inform, p-tbl-name ).
      138         end.
      139         do v-ind = 1 to v-idx-field-qnty by 2
      140         on error undo, return error
      141         :
      142           assign
      143             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      144             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      145           .
      146         end.
      147       end.
      148       if p-key-rec = ? then do:
      149         assign
      150           p-key-rec = "":U
      151         .
      152         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info2, p-tbl-name ).
      153       end.
      154     end.
      155     return.
      156   end procedure.
      157   procedure gen-where-keyr-tab :
      158     define input  parameter i-tableSerach as character no-undo.
      159     define input  parameter i-tablekey   as character  no-undo.
      160     define input  parameter p-key-rec    as character  no-undo.
      161     define input  parameter p-key-handle as handle     no-undo .
      162     define input  parameter p-db-name    as character  no-undo .
      163     define input  parameter p-tt-handle  as handle     no-undo .
      164     define output parameter o-Where      as character  no-undo.
      165     do
      166     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      167     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      168     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      169     :
      170       define variable v-full-tbl-name  as character no-undo .
      171       define variable bh_tbl-name      as handle    no-undo .
      172       define variable fh_key           as handle    no-undo .
      173       define variable fh_search        as handle    no-undo .
      174       define variable v-field-num      as integer   no-undo .
      175       define variable v-count-fld      as integer   no-undo .
      176       define variable v-inform         as character no-undo .
      177       define variable v-ind            as integer   no-undo .
      178       define variable v-idx-field-qnty as integer   no-undo .
      179       define variable v-field-name     as character no-undo .
      180       define variable v-field-val      as character no-undo .
      181       define variable v-word-link      as character no-undo .
      182       define variable vTable           as character no-undo.
      183       define variable bh_tbl-key       as handle    no-undo .
      184       assign
      185         p-key-rec = trim( p-key-rec )
      186       .
      187       if p-key-handle <> ? then do:
      188         if not valid-handle(p-key-handle)
      189            or p-key-handle:type <> "buffer"
      190         then do:
      191           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info2 ).
      192         end.
      193         if num-entries( p-key-rec, chr(3) ) > 1
      194           or p-key-rec = ?
      195           or p-key-rec = "":U
      196         then do:
      197           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info2, p-key-rec ).
      198         end.
      199       end.
      200       else do:
      201         if p-key-rec = ?
      202           or p-key-rec = "":U
      203         then do:
      204           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info2 ).
      205         end.
      206       end.
      207       assign
      208         vTable = entry( 1 , p-key-rec, chr(3) )
      209       .
      210       if p-tt-handle <> ?
      211         and ( not valid-handle(p-tt-handle)
      212               or p-tt-handle:type <> "buffer"
      213             )
      214       then do:
      215         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info2, vTable, chr(10) ).
      216       end.
      217       if p-tt-handle = ? then do:
      218         assign
      219           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      220         .
      221         create buffer bh_tbl-name for table v-full-tbl-name .
      222       end.
      223       else do:
      224         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      225       end.
      226       assign
      227         v-inform = bh_tbl-name:index-information(1)
      228         v-ind    = 2
      229       .
      230       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      231       on error undo, return error
      232       :
      233         assign
      234           v-inform = bh_tbl-name:index-information( v-ind )
      235           v-ind    = v-ind + 1
      236         .
      237       end.
      238       if v-inform = ?
      239         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      240         or entry( 3, v-inform, ",":U ) <> "1":U
      241       then do:
      242         delete object bh_tbl-name no-error.
      243         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info2, vTable ).
      244       end.
      245       assign
      246         v-idx-field-qnty = num-entries( v-inform ) - 4
      247       .
      248       if v-idx-field-qnty < 2 then do:
      249         delete object bh_tbl-name no-error.
      250         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info2, v-inform, vTable ).
      251       end.
      252       assign
      253         o-where     = "where":U
      254         v-word-link = "":U
      255         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      256         v-count-fld = 0
      257       .
      258       if i-tablekey ne "" and i-tablekey ne ?
      259       then do:
      260         assign
      261           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      262         .
      263         create buffer bh_tbl-key for table v-full-tbl-name .
      264       end.
      265       if i-tableSerach ne "" and i-tableSerach ne ?
      266       then do:
      267         delete object bh_tbl-name no-error.
      268         assign
      269           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      270         .
      271         create buffer bh_tbl-name for table v-full-tbl-name .
      272       end.
      273       block_where:
      274       do v-ind = 1 to v-idx-field-qnty by 2
      275       on error undo, return error
      276       :
      277         assign
      278           v-count-fld = v-count-fld + 1
      279         .
      280         if p-key-handle = ?
      281           and v-count-fld > v-field-num
      282         then do:
      283           leave block_where.
      284         end.
      285         define variable VfieldKeyTable as handle no-undo.
      286         assign
      287           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      288           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      289         .
      290         if     bh_tbl-key ne ?
      291         then do:
      292            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      293            if VfieldKeyTable eq ?
      294            then next block_where.
      295         end.
      296         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      297         then
      298            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      299         else
      300            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      301         if p-key-handle = ? then do:
      302           assign
      303             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      304           .
      305         end.
      306         else do:
      307           assign
      308             fh_key = p-key-handle:buffer-field( v-field-name )
      309           .
      310           if fh_key = ?
      311             or not valid-handle( fh_key )
      312           then do:
      313             delete object bh_tbl-name.
      314             if     bh_tbl-key ne ?
      315             then
      316                delete object bh_tbl-key.
      317             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info2, p-key-handle:name, v-field-name ).
      318           end.
      319           assign
      320             v-field-val = fh_key:buffer-value
      321           .
      322         end.
      323         if fh_search:data-type ="character":U then do:
      324           assign
      325             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      326             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      327             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      328             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      329             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      330             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      331             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      332             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      333             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      334             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      335             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      336             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      337             v-field-val = substitute( '"&1"', v-field-val )
      338           .
      339         end.
      340         assign
      341           o-where = substitute( "&1 &2", o-where, v-field-val )
      342         .
      343         if v-word-link = "":U then do:
      344           assign
      345             v-word-link = "and":U
      346           .
      347         end.
      348       end.
      349       delete object bh_tbl-name.
      350       if     bh_tbl-key ne ?
      351       then
      352          delete object bh_tbl-key.
      353       if p-key-handle = ?
      354         and v-count-fld <> v-field-num
      355       then do:
      356         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info2, vTable ).
      357       end.
      358     end.
      359   end procedure.
      360   procedure gen-hn-keyr-tab :
      361     define input  parameter i-tableSerach as character no-undo.
      362     define input  parameter i-tablekey   as character no-undo.
      363     define input  parameter p-key-rec    as character no-undo.
      364     define input  parameter p-key-handle as handle    no-undo .
      365     define input  parameter p-db-name    as character no-undo .
      366     define input  parameter p-tt-handle  as handle    no-undo .
      367     define input  parameter p-stts-lock  as integer   no-undo .
      368     define output parameter o-hn         as handle    no-undo.
      369     define variable v-full-tbl-name as character no-undo.
      370     define variable v-where         as character no-undo.
      371     define variable bh_tbl-name     as handle    no-undo.
      372     define variable vTable          as character no-undo.
      373     do
      374     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      375     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      376     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      377         run gen-where-keyr-tab(i-tableSerach,
      378                                i-tablekey,
      379                                p-key-rec,
      380                                p-key-handle,
      381                                p-db-name,
      382                                p-tt-handle,
      383                                output v-where).
      384         if i-tableSerach ne "" and i-tableSerach ne ?
      385         then do:
      386            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      387            create buffer bh_tbl-name for table v-full-tbl-name .
      388         end.
      389         else do:
      390            if p-tt-handle = ? then do:
      391               assign
      392                  vTable = entry( 1 , p-key-rec, chr(3) )
      393               .
      394               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      395               create buffer bh_tbl-name for table v-full-tbl-name .
      396            end.
      397            else do:
      398               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      399            end.
      400         end.
      401         if p-tt-handle = ? then do:
      402            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      403         end.
      404         else do:
      405            bh_tbl-name:find-first( v-where ) no-error .
      406         end.
      407         o-hn = bh_tbl-name.
      408      end.
      409   end procedure.
      410   procedure gen-hn-keyr :
      411     define input  parameter p-key-rec    as character no-undo.
      412     define input  parameter p-key-handle as handle    no-undo .
      413     define input  parameter p-db-name    as character no-undo .
      414     define input  parameter p-tt-handle  as handle    no-undo .
      415     define input  parameter p-stts-lock  as integer   no-undo .
      416     define output parameter o-hn         as handle    no-undo.
      417     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      418   end.
      419   procedure gen-row-keyr :
      420     define input  parameter p-key-rec    as character no-undo.
      421     define input  parameter p-key-handle as handle    no-undo .
      422     define input  parameter p-db-name    as character no-undo .
      423     define input  parameter p-tt-handle  as handle    no-undo .
      424     define input  parameter p-stts-lock  as integer   no-undo .
      425     define output parameter p-tbl-row    as rowid     no-undo.
      426     define output parameter p-tbl-name   as character no-undo.
      427     define variable vHn as handle no-undo.
      428       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      429       p-tbl-row = if vHn:available then vHn:rowid else ?.
      430       p-tbl-name =  vHn:table.
      431       delete object vHn no-error.
      432     if p-tbl-row = ? then do:
      433       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info2, p-tbl-name, p-key-rec ).
      434     end.
      435     else do:
      436       return.
      437     end.
      438   end procedure.
      439   procedure gen-key-fv :
      440     define input  parameter p-key-rec    as character no-undo .
      441     define output parameter p-field-list as character no-undo .
      442     define output parameter p-value-list as character no-undo.
      443     do
      444     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      445     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      446     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      447     :
      448       define variable v-full-tbl-name  as character no-undo .
      449       define variable bh_tbl-name      as handle    no-undo .
      450       define variable v-tbl-name       as character no-undo .
      451       define variable v-field-num      as integer   no-undo .
      452       define variable v-count-fld      as integer   no-undo .
      453       define variable v-inform         as character no-undo .
      454       define variable v-ind            as integer   no-undo .
      455       define variable v-idx-field-qnty as integer   no-undo .
      456       define variable v-delim-key      as character no-undo .
      457       if p-key-rec = ?
      458         or p-key-rec = "":U
      459       then do:
      460         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info2 ).
      461       end.
      462       assign
      463         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      464         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      465       .
      466       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      467       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info2 ).
      468       assign
      469         v-inform = bh_tbl-name:index-information(1)
      470         v-ind    = 2
      471       .
      472       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      473       on error undo, return error
      474       :
      475         assign
      476           v-inform = bh_tbl-name:index-information( v-ind )
      477           v-ind    = v-ind + 1
      478         .
      479       end.
      480       if v-inform = ?
      481         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      482         or entry( 3, v-inform, ",":U ) <> "1":U
      483       then do:
      484         delete object bh_tbl-name no-error.
      485         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info2, v-tbl-name ).
      486       end.
      487       assign
      488         v-idx-field-qnty = num-entries( v-inform ) - 4
      489       .
      490       if v-idx-field-qnty < 2 then do:
      491         delete object bh_tbl-name no-error.
      492         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info2, v-inform, v-tbl-name ).
      493       end.
      494       assign
      495         p-field-list = "":U
      496         p-value-list = "":U
      497         v-delim-key  = "":U
      498         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      499         v-count-fld  = 0
      500       .
      501       block_where:
      502       do v-ind = 1 to v-idx-field-qnty by 2
      503       on error undo, return error
      504       :
      505         assign
      506           v-count-fld = v-count-fld + 1
      507         .
      508         if v-count-fld > v-field-num then do:
      509           leave block_where.
      510         end.
      511         assign
      512           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      513           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      514         .
      515         if v-ind = 1 then do:
      516           assign
      517             v-delim-key = chr(3)
      518           .
      519         end.
      520       end.
      521       delete object bh_tbl-name.
      522       if v-count-fld <> v-field-num then do:
      523         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info2, v-tbl-name ).
      524       end.
      525     end.
      526   end procedure.
      527   procedure gen-key-field :
      528     define input  parameter p-table      as character no-undo .
      529     define output parameter p-field-list as character no-undo .
      530     do
      531     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      532     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      533     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      534     :
      535       define variable v-full-tbl-name  as character no-undo .
      536       define variable bh_tbl-name      as handle    no-undo .
      537       define variable v-tbl-name       as character no-undo .
      538       define variable v-field-num      as integer   no-undo .
      539       define variable v-count-fld      as integer   no-undo .
      540       define variable v-inform         as character no-undo .
      541       define variable v-ind            as integer   no-undo .
      542       define variable v-idx-field-qnty as integer   no-undo .
      543       define variable v-delim-key      as character no-undo .
      544       if p-table = ?
      545         or p-table = "":U
      546       then do:
      547         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info2 ).
      548       end.
      549       assign
      550         v-tbl-name      = p-table
      551         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      552       .
      553       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      554       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info2 ).
      555       assign
      556         v-inform = bh_tbl-name:index-information(1)
      557         v-ind    = 2
      558       .
      559       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      560       on error undo, return error
      561       :
      562         assign
      563           v-inform = bh_tbl-name:index-information( v-ind )
      564           v-ind    = v-ind + 1
      565         .
      566       end.
      567       if v-inform = ?
      568         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      569         or entry( 3, v-inform, ",":U ) <> "1":U
      570       then do:
      571         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info2, v-tbl-name ).
      572       end.
      573       assign
      574         v-idx-field-qnty = num-entries( v-inform ) - 4
      575       .
      576       if v-idx-field-qnty < 2 then do:
      577         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info2, v-inform, v-tbl-name ).
      578       end.
      579       assign
      580         p-field-list = "":U
      581         v-delim-key  = "":U
      582         v-count-fld  = 0
      583       .
      584       block_where:
      585       do v-ind = 1 to v-idx-field-qnty by 2
      586       on error undo, return error
      587       :
      588         assign
      589           v-count-fld = v-count-fld + 1
      590         .
      591         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      592         if v-ind = 1 then do:
      593           assign
      594             v-delim-key = chr(3)
      595           .
      596         end.
      597       end.
      598       delete object bh_tbl-name.
      599     end.
      600   end procedure.
      601   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      602   define new global shared variable g#lib-nws as handle no-undo .
      603   procedure disproph_write-dis-card-property-proc  :
      604   define parameter buffer buf_dis-card-property for ub.dis-card-property .
      605   define parameter buffer buf_dis-card for ub.dis-card.
