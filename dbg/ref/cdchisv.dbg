      607   define input parameter p-dt-code      like ub.dis-card-property.dt-code no-undo .
      608   define input parameter p-host-code   like ub.dis-card-property.host-code no-undo .
      609   define input parameter p-obj-type    like ub.dis-card-property.obj-type no-undo .
      610   define input parameter p-obj-code    like ub.dis-card-property.obj-code no-undo .
      611   define input parameter p-dtm-code    like ub.dis-card-property.dtm-code no-undo .
      612   define input parameter p-card-num    like ub.dis-card-property.card-num  no-undo .
      613   define input parameter p-main-card   like ub.dis-card-property.main-card  no-undo .
      614   define input parameter p-first-card  like ub.dis-card-property.first-card  no-undo .
      615   define input parameter p-first-main-card  like ub.dis-card-property.first-main-card  no-undo .
      616   define input parameter p-node-code   like ub.dis-card-property.node-code no-undo .
      617   define input parameter p-action      as integer no-undo .
