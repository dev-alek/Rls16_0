      432         VIEW-AS TEXT
      433        SIZE 16.25 BY .67
      434        FGCOLOR 10  NO-UNDO.
      435   DEFINE VARIABLE text-string AS CHARACTER FORMAT "X(256)":U
      436         VIEW-AS TEXT
      437        SIZE 61 BY .67
      438        FGCOLOR 10  NO-UNDO.
      439   DEFINE VARIABLE RS-codir AS INTEGER
      440        VIEW-AS RADIO-SET VERTICAL
      441        RADIO-BUTTONS
      442             "1251", 1,
      443   "KOI8-R", 2
      444        SIZE 15.25 BY 2.63 NO-UNDO.
      445   DEFINE RECTANGLE RECT-atribut
      446        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      447        SIZE 41.75 BY 18.83.
      448   DEFINE VARIABLE T-alpha1 AS LOGICAL INITIAL yes
      449        LABEL "Страна"
      450        VIEW-AS TOGGLE-BOX
      451        SIZE 29 BY 1 NO-UNDO.
      452   DEFINE VARIABLE T-artic AS LOGICAL INITIAL yes
      453        LABEL "Артикул"
      454        VIEW-AS TOGGLE-BOX
      455        SIZE 29 BY 1 NO-UNDO.
      456   DEFINE VARIABLE T-grp-code AS LOGICAL INITIAL yes
      457        LABEL "Код группы"
      458        VIEW-AS TOGGLE-BOX
      459        SIZE 29 BY 1 NO-UNDO.
      460   DEFINE VARIABLE T-service AS LOGICAL INITIAL yes
      461        LABEL "Услуга"
      462        VIEW-AS TOGGLE-BOX
      463        SIZE 29 BY 1 NO-UNDO.
      464   DEFINE VARIABLE T-gds-code AS LOGICAL INITIAL yes
