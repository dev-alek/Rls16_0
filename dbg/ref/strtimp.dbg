        1   define input parameter parparentproc as widget-handle no-undo .
        2   DEFINE INPUT PARAMETER iOnlyfile     as logical no-undo.
        3   DEFINE INPUT PARAMETER vattaxcd      as integer no-undo.
        4   DEFINE INPUT PARAMETER slttaxcd      as integer no-undo.
        5   define input parameter custvalue     as character no-undo .
        6   define input parameter tnvedimp      as logical no-undo .
        7   DEFINE OUTPUT PARAMETER v_os-file    AS CHAR    NO-UNDO INIT "".
        8   DEFINE OUTPUT PARAMETER choice       AS integer NO-UNDO.
        9   DEFINE OUTPUT PARAMETER p-artic      AS integer NO-UNDO.
       10   DEFINE OUTPUT PARAMETER p-prod       AS integer NO-UNDO.
       11   DEFINE OUTPUT PARAMETER p-name       AS integer NO-UNDO.
       12   DEFINE OUTPUT PARAMETER p-engl-name  AS integer NO-UNDO.
       13   DEFINE OUTPUT PARAMETER p-unit-base  AS integer NO-UNDO.
       14   DEFINE OUTPUT PARAMETER p-VAT-code   AS integer NO-UNDO.
       15   DEFINE OUTPUT PARAMETER p-SLT-code   AS integer NO-UNDO.
       16   DEFINE OUTPUT PARAMETER p-struct     AS integer NO-UNDO.
       17   define output parameter p-tnved      as integer no-undo .
       18   define output parameter p-attrib     as integer no-undo .
       19   define output parameter p-destin     as integer no-undo .
       20   define output parameter p-sert       as integer no-undo .
       21   define output parameter p-user-rule  as integer no-undo .
       22   define output parameter p-alpha1     as integer no-undo .
       23   define output parameter p-grp-code   as integer no-undo .
       24   define output parameter p-service    as integer no-undo .
       25   define output parameter p-gds-code   as integer no-undo .
       26   define output parameter p-mark       as integer no-undo .
       27   define variable vss-revision    as character no-undo init "$Revision$":u .
       28   define variable vss-author      as character no-undo init "$Author$":u .
       29   define variable vss-date        as character no-undo init "$Date$":u .
       30   define variable vss-workfile    as character no-undo init "$Workfile$":u .
       31   define variable vss-archive     as character no-undo init "$Archive$":u .
       32   define variable vss-description as character no-undo init "Параметры файла импорта товаров" .
       33   procedure vss-get-info :
       34     define output parameter p-vss-revision    like vss-revision    no-undo .
       35     define output parameter p-vss-author      like vss-author      no-undo .
       36     define output parameter p-vss-date        like vss-date        no-undo .
       37     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       38     define output parameter p-vss-archive     like vss-archive     no-undo .
       39     define output parameter p-vss-description like vss-description no-undo .
       40     assign
       41       p-vss-revision    = vss-revision
       42       p-vss-author      = vss-author
       43       p-vss-date        = vss-date
       44       p-vss-workfile    = vss-workfile
       45       p-vss-archive     = vss-archive
       46       p-vss-description = vss-description
       47     .
       48   end procedure.
       49   procedure vss-get-parameters :
       50     define output parameter p-vss-parameters as character no-undo .
       51   end procedure.
       52   define new global shared variable g#vssrevis-logger as handle    no-undo .
       53   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       54   define variable v-vssrevis-logger                   as handle    no-undo .
       55   procedure vss-logevent :
       56     define input  parameter p-extra-paramters as character no-undo .
       57     define variable v-vssrevis-parameters as character no-undo .
       58     do
       59     on error undo, return error return-value
       60     :
       61       if  valid-handle(v-vssrevis-logger)
       62       and v-vssrevis-logger :get-signature("logevent") <> ""
       63       then do:
       64         run vss-get-parameters in this-procedure
       65           (output v-vssrevis-parameters
       66           ).
       67         run logevent in v-vssrevis-logger
       68           (input vss-workfile
       69           ,input vss-revision
       70           ,input v-vssrevis-parameters
       71           ,input p-extra-paramters
       72           ).
       73       end.
       74     end.
       75   end procedure.
       76   assign
       77     v-vssrevis-logger = g#vssrevis-logger
       78   .
       79   if  valid-handle(v-vssrevis-logger)
       80   and v-vssrevis-logger :get-signature("logevent") <> ""
       81   then do:
       82     assign
       83       v-vssrevis-logevent = true
       84     .
       85     run vss-logevent in this-procedure (input vss-description) .
       86   end.
       87   define new global shared variable g#language as character no-undo .
       88   if g#language <> '' and g#language <> 'rus':U then do:
       89     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       90   end.
       91   define new global shared variable g#library  as handle no-undo .
       92   define new global shared variable g#library2 as handle no-undo .
       93   procedure proc-alt-shift-f2:
       94     if not ibs.th.gbl.gbl-var:rcode
       95   then
       96     run gbl\inidebug.p .
       97   end.
       98   procedure proc-alt-shift-f3:
       99     run gbl/prvssinf.p
      100       ( input this-procedure
      101       ) .
      102   end.
      103   define variable v-inform-launched as logical no-undo initial false .
      104   procedure proc-alt-shift-f4:
      105     define variable v-action as character no-undo .
      106     if v-inform-launched = false then do:
      107       assign
      108         v-inform-launched = true
      109       .
      110       run gbl/d-inform.w
      111         (  input self
      112         ,  input this-procedure
      113         , output v-action
      114         ) no-error .
      115       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      116       assign
      117         v-inform-launched = false
      118       .
      119     end.
      120   end.
      121   procedure proc-alt-f1:
      122     run gbl/corrhelp.p
      123       (input this-procedure
      124       ) .
      125   end .
      126   on alt-shift-f2 anywhere do:
      127     run proc-alt-shift-f2.
      128   end.
      129   on alt-shift-f3 anywhere do:
      130     run proc-alt-shift-f3 in this-procedure .
      131   end.
      132   on alt-shift-f4 anywhere do:
      133     run proc-alt-shift-f4 in this-procedure.
      134   end.
      135   on alt-f1 anywhere do:
      136     run proc-alt-f1 in this-procedure .
      137   end.
      138   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      139   define variable v-uf-List_        like ubflt.usr-flt.List_        no-undo .
      140   define variable v-uf-Naim         like ubflt.usr-flt.Naim         no-undo .
      141   define variable v-uf-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
      142   define variable v-uf-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
      143   define variable v-uf-type-price   like ubflt.usr-flt.type-price   no-undo .
      144   define variable v-uf-type-val     like ubflt.usr-flt.type-val     no-undo .
      145   define temp-table usr-flt_custom-labels no-undo like ub.custom-labels.
      146   procedure uf-name :
      147     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
      148     define output parameter p-use-List_     as logical   no-undo .
      149     define output parameter p-type-List_     as character no-undo .
      150     define output parameter p-format-List_   as character no-undo .
      151     define output parameter p-use-Naim      as logical   no-undo .
      152     define output parameter p-type-Naim      as character no-undo .
      153     define output parameter p-format-Naim    as character no-undo .
      154     define output parameter p-use-print-graft as logical   no-undo .
      155     define output parameter p-use-sort-gr   as logical   no-undo .
      156     define output parameter p-use-type-price as logical   no-undo .
      157     define output parameter p-use-type-val  as logical   no-undo .
      158     define output parameter p-label          as character no-undo .
      159     define output parameter p-tooltip        as character no-undo .
      160     define output parameter p-user-can-edit  as logical   no-undo .
      161     define output parameter p-output-display as logical   no-undo .
      162     define output parameter p-other          as character no-undo .
      163     do
      164     on error undo, return error
      165     :
      166       case p-code :
      167               when 'cli-all-p':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = yes      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Параметры вызова справочника клиентов"     p-tooltip = "Параметры по умолчанию, используемые для вызова справочника клиентов"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
      168               when 'oldscode':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(1)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Настройки справочника неиспользуемых весовых кодов"     p-tooltip = "Настройки справочника неиспользуемых весовых кодов"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
      169               when 'gds-ref-p':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = yes      p-type-Naim = 'C':U      p-format-Naim = "X(8)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = yes      p-label = "Параметры вызова справочника товаров"     p-tooltip = "Параметры по умолчанию, используемые для вызова справочника товаров"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
      170               when 'gds-grp-p':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(1)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Параметры вызова справочника групп товаров"     p-tooltip = "Параметры по умолчанию, используемые для вызова справочника групп товаров"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
