      409        LABEL "&Ввод"
      410        SIZE 10 BY 1
      411        BGCOLOR 8 .
      412   DEFINE BUTTON B-file
      413        IMAGE-UP FILE "btn-down-arrow":U
      414        IMAGE-DOWN FILE "btn-down-arrow":U
      415        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      416        LABEL ""
      417        SIZE 3 BY 1.
      418   DEFINE BUTTON B-Help
      419        LABEL "Помо&щь"
      420        SIZE 10 BY 1
      421        BGCOLOR 8 .
      422   DEFINE BUTTON b-quit AUTO-END-KEY
      423        LABEL "&Отмена"
      424        SIZE 10 BY 1
      425        BGCOLOR 8 .
      426   DEFINE VARIABLE file-name AS CHARACTER FORMAT "X(256)":U
      427        LABEL "Файл импорта"
