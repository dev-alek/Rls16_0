      520   DEFINE FRAME Dialog-Frame
      521        B-exit AT ROW 1 COL 1.13
      522        b-quit AT ROW 1 COL 11.13
      523        B-check AT ROW 1 COL 21
      524        B-Help AT ROW 1 COL 54.88
      525        B-file AT ROW 2.88 COL 43.13
      526        file-name AT ROW 2.92 COL 3.38
      527        T-artic AT ROW 5.08 COL 24.25
      528        RS-codir AT ROW 5.38 COL 3.38 NO-LABEL
      529        T-name AT ROW 6.08 COL 24.5
      530        T-engl-name AT ROW 7.08 COL 24.5
      531        T-unit-base AT ROW 8.08 COL 24.5
      532        T-VAT-code AT ROW 9.08 COL 24.5
      533        T-SLT-code AT ROW 10.08 COL 24.5
      534        T-struct AT ROW 11.08 COL 24.5
      535        T-tnved AT ROW 12.08 COL 24.5
      536        T-destin AT ROW 13.08 COL 24.5
      537        T-attrib AT ROW 14.08 COL 24.5
      538        T-user-rule AT ROW 15.08 COL 24.5
      539        T-sert AT ROW 16.08 COL 24.5
      540        T-prod AT ROW 17.08 COL 24.5
      541        T-alpha1 AT ROW 18.08 COL 24.5
      542        T-grp-code AT ROW 19.08 COL 24.5
      543        T-service AT ROW 20.08 COL 24.5
      544        T-gds-code AT ROW 21.08 COL 24.5
      545        T-Mark AT ROW 22.08 COL 24.5
      546        ii AT ROW 23.1 COL 2
      547        text-string AT ROW 24.1 COL 2.13 NO-LABEL
      548        "Кодировка" VIEW-AS TEXT
      549             SIZE 15.75 BY .92 AT ROW 4.21 COL 3.38
      550        "Импортируемые поля" VIEW-AS TEXT
      551             SIZE 19.25 BY .88 AT ROW 4 COL 26.25
      552             FGCOLOR 3
      553        RECT-atribut AT ROW 4.42 COL 21.13
      554        SPACE(2.24) SKIP(3.91)
      555       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      556            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      557            TITLE "Параметры файла импорта"
      558            DEFAULT-BUTTON B-exit CANCEL-BUTTON b-quit.
      559   ASSIGN
      560          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      561          FRAME Dialog-Frame:HIDDEN           = TRUE.
      562   ASSIGN
      563          ii:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      564   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      565   DO:
      566     APPLY "END-ERROR":U TO SELF.
      567   END.
      568   ON CHOOSE OF B-check IN FRAME Dialog-Frame
      569   DO:
      570     define variable NEN as integer No-UNDO.
      571     define variable p-text as char no-undo.
      572     define variable p-int as integer no-undo.
      573     define variable vars as integer no-undo EXTENT 18.
      574     define variable lok as logical no-undo.
      575     define buffer buf_country for ub.country.
      576     define buffer buf_gds-grp for ub.gds-grp .
      577     assign
      578     file-name
      579     v_os-file = file-name
      580     RS-codir
      581     choice = RS-codir
      582     T-artic
      583     t-prod
      584     T-engl-name
      585     T-name
      586     T-SLT-code
      587     T-unit-base
      588     T-VAT-code
      589     T-struct
      590     T-tnved
      591     T-attrib
      592     T-destin
      593     T-sert
      594     T-user-rule
      595     T-alpha1
      596     T-grp-code
      597     T-service
      598     T-gds-code
      599     T-Mark
      600     NEN = NEN + integer(T-artic)
      601     vars[1] = NEN
      602     p-artic = vars[1]
      603     NEN = NEN + integer(T-name)
      604     vars[2] = if T-name then NEN else 0
      605     p-name = vars[2]
      606     NEN = NEN + integer(T-engl-name)
      607     vars[3] = if T-engl-name then NEN else 0
      608     p-engl-name = vars[3]
      609     NEN = NEN + integer(T-unit-base)
      610     vars[5] = if T-unit-base then NEN else 0
      611     p-unit-base = vars[5]
      612     NEN = NEN + integer(T-VAT-code)
      613     vars[6] = if T-VAT-code then NEN else 0
      614     p-VAT-code = vars[6]
      615     NEN = NEN + integer(T-SLT-code)
      616     vars[4] = if T-SLT-code then NEN else 0
      617     p-SLT-code = vars[4]
      618     NEN = NEN + integer(T-Struct)
      619       vars[7] = if T-struct then NEN else 0
      620       p-struct = vars[7]
      621     NEN = NEN + integer(T-Tnved)
      622       vars[8] = if T-tnved then NEN else 0
      623       p-tnved = vars[8]
      624     NEN = NEN + integer(T-destin)
      625       vars[10] = if T-destin then NEN else 0
      626       p-destin = vars[10]
      627     NEN = NEN + integer(T-attrib)
      628       vars[9] = if T-attrib then NEN else 0
      629       p-attrib = vars[9]
      630     NEN = NEN + integer(T-user-rule)
      631       vars[12] = if T-user-rule then NEN else 0
      632       p-user-rule = vars[12]
      633     NEN = NEN + integer(T-sert)
      634       vars[11] = if T-sert then NEN else 0
      635       p-sert = vars[11]
      636     NEN = NEN + integer(T-prod)
      637     vars[13] = if T-prod then NEN else 0
      638     p-prod = vars[13]
      639     NEN = NEN + integer(T-alpha1)
      640       vars[14] = if T-alpha1 then NEN else 0
      641       p-alpha1 = vars[14]
      642      NEN = NEN + integer(T-grp-code)
      643       vars[15] = if T-grp-code then NEN else 0
      644       p-grp-code = vars[15]
      645      NEN = NEN + integer(T-service)
      646       vars[16] = if T-service then NEN else 0
      647       p-service = vars[16]
      648      NEN = NEN + integer(T-gds-code)
      649       vars[17] = if T-gds-code then NEN else 0
      650       p-gds-code = vars[17]
      651    NEN = NEN + integer(T-mark)
      652       vars[18] = if T-mark then NEN else 0
      653       p-mark = vars[18]
      654     .
      655     IF v_os-file = "" or v_os-file = ? then do:
      656       message "Не определен файл импорта!" view-as alert-box ERROR.
      657       return no-apply.
      658     END.
      659     if substring(v_os-file, length(v_os-file) - 2) = "xls"
      660     or substring(v_os-file, length(v_os-file) - 3) = "xlsx"
      661     then do :
      662         message "Для файлов Excel проверка не возможна" view-as alert-box.
      663         return no-apply .
      664     end.
      665     IF (T-SLT-code OR T-VAt-code) AND NOT T-unit-base then do:
      666       message "Невозможно импортировать код НДС и/или код НП" SKIP
      667               "без импорта основной единицы измерения" view-as alert-box ERROR.
      668       return no-apply.
      669     end.
      670     CASE choice:
      671           WHEN 1 then do:
      672               input stream gds-file from value (v_os-file) convert source "1251".
      673           END.
      674           WHEN 2 then do:
      675               input stream gds-file from value (v_os-file) convert source "KOI8-R".
      676           END.
      677     END CASE.
      678     ii = 0.
      679     VIEW
      680     ii
      681     IN FRAME Dialog-Frame.
      682     _stroka:
      683       REPEAT:
      684       IMPORT stream gds-file UNFORMATTED text-string NO-ERROR.
      685       ii = ii + 1.
      686       DISPLAY
      687       text-string
      688       ii
      689       WITH frame Dialog-Frame.
      690       if NUm-ENTRIES(text-string, ";") <> NEN then do:
      691           message "В строчке N " ii "неверное кол-во полей - " NUm-ENTRIES(text-string, ";") skip
      692               "должно быть" NEN
      693           view-as alert-box ERROR
      694           buttons OK-Cancel update lok
      695           .
      696           if NOT lok then return no-apply.
      697           else NEXT _stroka.
      698       end.
      699       if vars[5] > 0 then do:
      700           FIND FIRST ub.units NO-LOCK where
      701                      ub.units.unit-name = ENTRY(vars[5], text-string, ";")
      702                      No-ERROR.
      703           IF NOT avail ub.units then do:
      704               message "Нет в БД единицы измерения "
      705                       ENTRY(vars[5], text-string, ";") skip
      706                       " - поле N " vars[5]
      707                       "   строчка N " ii
      708               view-as alert-box ERROR
      709               buttons OK-Cancel update lok
      710               .
      711               if NOT lok then return no-apply.
      712           END.
      713       end.
      714       if vars[4] > 0 then do:
      715           assign
      716           p-int = integer(ENTRY(vars[4], text-string, ";"))
      717           no-error.
      718           if error-status:error then do:
      719               message "Неверное значение кода ставки НП "
      720                       ENTRY(vars[4], text-string, ";") skip
      721                       " - поле N " vars[4]
      722                       "   строчка N " ii
      723               view-as alert-box ERROR
      724               buttons OK-Cancel update lok
      725               .
      726               if NOT lok then return no-apply.
      727           end.
      728           else do:
      729               FIND FIRST ub.tax-rate NO-LOCK where
      730                          ub.tax-rate.rate-code = p-int
      731                          No-ERROR.
      732               IF NOT avail ub.tax-rate then do:
      733                   message "Нет в БД ставки налога с кодом "
      734                           ENTRY(vars[4], text-string, ";") skip
      735                           " - поле N " vars[4]
      736                           "   строчка N " ii
      737                   view-as alert-box ERROR
      738                   buttons OK-Cancel update lok
      739                   .
      740                   if NOT lok then return no-apply.
      741               END.
      742               ELSE DO:
      743                   if tax-rate.tax-code <> slttaxcd then do:
      744                       message "Для ставки налога с кодом "
      745                               ENTRY(vars[4], text-string, ";")
      746                               "код налога отличается от кода НП" skip
      747                               " - поле N " vars[4]
      748                               "   строчка N " ii
      749                       view-as alert-box ERROR
      750                       buttons OK-Cancel update lok
      751                       .
      752                       if NOT lok then return no-apply.
      753                   end.
      754               END.
      755           end.
      756       end.
      757       if vars[6] > 0 then do:
      758           assign
      759           p-int = integer(ENTRY(vars[6], text-string, ";"))
      760           no-error.
      761           if error-status:error then do:
      762               message "Неверное значение кода ставки НДС "
      763                       ENTRY(vars[6], text-string, ";") skip
      764                       " - поле N " vars[6]
      765                       "   строчка N " ii
      766               view-as alert-box ERROR
      767               buttons OK-Cancel update lok
      768               .
      769               if NOT lok then return no-apply.
      770           end.
      771           else do:
      772               FIND FIRST tax-rate NO-LOCK where
      773                          tax-rate.rate-code = p-int
      774                          No-ERROR.
      775               IF NOT avail tax-rate then do:
      776                   message "Нет в БД ставки налога с кодом "
      777                           ENTRY(vars[6], text-string, ";") skip
      778                           " - поле N " vars[6]
      779                           "   строчка N " ii
      780                   view-as alert-box ERROR
      781                   buttons OK-Cancel update lok
      782                   .
      783                   if NOT lok then return no-apply.
      784               END.
      785               ELSE DO:
      786                   if tax-rate.tax-code <> vattaxcd then do:
      787                       message "Для ставки налога с кодом "
      788                               ENTRY(vars[6], text-string, ";")
      789                               "код налога отличается от кода НДС" skip
      790                               " - поле N " vars[6]
      791                               "   строчка N " ii
      792                       view-as alert-box ERROR
      793                       buttons OK-Cancel update lok
      794                       .
      795                       if NOT lok then return no-apply.
      796                   end.
      797               END.
      798           end.
      799       end.
      800       if vars[14] > 0 then do:
      801           FIND FIRST buf_country NO-LOCK where
      802                      buf_country.alpha1 = ENTRY(vars[14], text-string, ";")
      803                      No-ERROR.
      804           IF NOT avail buf_country then do:
      805               message "Нет в БД страны "
      806                       ENTRY(vars[14], text-string, ";") skip
      807                       " - поле N " vars[14]
      808                       "   строчка N " ii
      809               view-as alert-box ERROR
      810               buttons OK-Cancel update lok
      811               .
      812               if NOT lok then return no-apply.
      813           END.
      814       end.
      815       if vars[15] > 0 then do:
      816           FIND FIRST buf_gds-grp NO-LOCK where
      817                      buf_gds-grp.node-code = integer(ENTRY(vars[15], text-string, ";"))
      818                      No-ERROR.
      819           IF NOT avail buf_gds-grp then do:
      820               message "Нет в БД группы товаров с вн. номером "
      821                       ENTRY(vars[15], text-string, ";") skip
      822                       " - поле N " vars[15]
      823                       "   строчка N " ii
      824               view-as alert-box ERROR
      825               buttons OK-Cancel update lok
      826               .
      827               if NOT lok then return no-apply.
      828           END.
      829       end.
      830     END.
      831     HIDE
      832     ii
      833     text-string
      834     IN FRAME Dialog-Frame.
      835     input stream gds-file close.
      836     message "Проверка завершена" view-as alert-box.
      837   END.
      838   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
      839   DO:
      840     define variable NEN as integer No-UNDO.
      841     define variable vars as integer no-undo EXTENT 18.
      842     assign
      843     file-name
      844     v_os-file = file-name
      845     RS-codir
      846     choice = RS-codir
      847     T-artic
      848     T-prod
      849     T-engl-name
      850     T-name
      851     T-SLT-code
      852     T-unit-base
      853     T-VAT-code
      854     T-struct
      855     T-tnved
      856     T-attrib
      857     T-destin
      858     T-sert
      859     T-user-rule
      860     T-alpha1
      861     T-grp-code
      862     T-service
      863     T-gds-code
      864     T-mark
      865     NEN = NEN + integer(T-artic)
      866     vars[1] = NEN
      867     p-artic = vars[1]
      868     NEN = NEN + integer(T-name)
      869     vars[2] = if T-name then NEN else 0
      870     p-name = vars[2]
      871     NEN = NEN + integer(T-engl-name)
      872     vars[3] = if T-engl-name then NEN else 0
      873     p-engl-name = vars[3]
      874     NEN = NEN + integer(T-unit-base)
      875     vars[5] = if T-unit-base then NEN else 0
      876     p-unit-base = vars[5]
      877     NEN = NEN + integer(T-VAT-code)
      878     vars[6] = if T-VAT-code then NEN else 0
      879     p-VAT-code = vars[6]
      880     NEN = NEN + integer(T-SLT-code)
      881     vars[4] = if T-SLT-code then NEN else 0
      882     p-SLT-code = vars[4]
      883     NEN = NEN + integer(T-Struct)
      884     vars[7] = if T-Struct then NEN else 0
      885     p-Struct = vars[7]
      886     NEN = NEN + integer(T-tnved)
      887     vars[8] = if T-tnved then NEN else 0
      888     p-tnved = vars[8]
      889     NEN = NEN + integer(T-destin)
      890     vars[10] = if T-destin then NEN else 0
      891     p-destin = vars[10]
      892     NEN = NEN + integer(T-attrib)
      893     vars[9] = if T-attrib then NEN else 0
      894     p-attrib = vars[9]
      895     NEN = NEN + integer(T-user-rule)
      896     vars[12] = if T-user-rule then NEN else 0
      897     p-user-rule = vars[12]
      898     NEN = NEN + integer(T-sert)
      899     vars[11] = if T-sert then NEN else 0
      900     p-sert = vars[11]
      901     NEN = NEN + integer(T-prod)
      902     vars[13] = if T-prod then NEN else 0
      903     p-prod = vars[13]
      904     NEN = NEN + integer(T-alpha1)
      905     vars[14] = if T-alpha1 then NEN else 0
      906     p-alpha1 = vars[14]
      907     NEN = NEN + integer(T-grp-code)
      908     vars[15] = if T-grp-code then NEN else 0
      909     p-grp-code = vars[15]
      910     NEN = NEN + integer(T-service)
      911     vars[16] = if T-service then NEN else 0
      912     p-service = vars[16]
      913     NEN = NEN + integer(T-gds-code)
      914     vars[17] = if T-gds-code then NEN else 0
      915     p-gds-code = vars[17]
      916    NEN = NEN + integer(T-mark)
      917       vars[18] = if T-mark then NEN else 0
      918       p-mark = vars[18]
      919     .
      920     if vars[17] eq 0
      921        and  vars[13] eq 0
      922     then do:
      923         message
      924         "В загрузке обязательно должен быть код товара или производитель."
      925         view-as alert-box WARNING.
      926         return no-apply.
      927     end.
      928     if p-tnved > 0 then do:
      929       if custvalue = "no"  then do:
      930         message
      931         "В Вашей системе не включен настроечный параметр ТАМОЖНЯ," skip
      932         "поэтому проверить корректность импортируемых кодов ТНВЭД будет невозможно"
      933         view-as alert-box WARNING.
      934       end.
      935     end.
      936     IF v_os-file = "" or v_os-file = ? then do:
      937       message "Не определен файл импорта!" view-as alert-box ERROR.
      938       return no-apply.
      939     END.
      940     IF (T-SLT-code OR T-VAt-code) AND NOT T-unit-base then do:
      941       message "Невозможно импортировать код НДС и/или код НП" SKIP
      942               "без импорта основной единицы измерения" view-as alert-box ERROR.
      943       return no-apply.
      944     end.
      945     CASE choice:
      946           WHEN 1 then do:
      947               input stream gds-file from value (v_os-file) convert source "1251".
      948           END.
      949           WHEN 2 then do:
      950               input stream gds-file from value (v_os-file) convert source "KOI8-R".
      951           END.
      952     END CASE.
      953   END.
      954   ON CHOOSE OF B-file IN FRAME Dialog-Frame
      955   DO:
      956   define variable ll_commit AS LOG    NO-UNDO INIT NO.
      957   define variable v-full-path        as character no-undo .
      958   define variable v-path             as character no-undo .
      959   define variable v-file-name        as character no-undo .
      960   define variable v-file-name-no-ext as character no-undo .
      961   define variable v-file-name-ext    as character no-undo .
      962       SYSTEM-DIALOG GET-FILE v_os-file
      963           TITLE "Выберите файл для импорта"
      964           FILTERS
      965             " Текстовые файлы (*.gim) " "*.gim",
      966             " Текстовые файлы (*.txt) " "*.txt",
      967             " Текстовые файлы (*.csv) " "*.csv",
      968             " MS Excel (*.xls,*.xlsx) " "*.xls,*.xlsx",
      969             " Все файлы (*.*) "                      "*.*"
      970           INITIAL-DIR v-init-dir
      971           must-exist
      972           update ll_commit
      973           default-extension "gim"
      974           .
      975       IF ll_commit <> YES THEN do:
      976          RETURN NO-APPLY.
      977       end.
      978       IF v_os-file = PROGRAM-NAME( 1 ) THEN DO:
      979           BELL.
      980           MESSAGE "Рекурсия!" VIEW-AS ALERT-BOX ERROR.
      981           RETURN NO-APPLY.
      982       END.
      983       ASSIGN file-name = ( IF SEARCH( v_os-file ) = ? THEN v_os-file ELSE SEARCH( v_os-file ) ).
      984       DISP file-name WITH FRAME Dialog-Frame.
      985     run gbl/filename.p (
      986                             input  file-name
      987                             ,output v-full-path
      988                             ,output v-path
      989                             ,output v-file-name
      990                             ,output v-file-name-no-ext
      991                             ,output v-file-name-ext
      992                             ) no-error .
      993     if not error-status:error then v-init-dir = v-path.
      994   END.
      995   ON CHOOSE OF b-quit IN FRAME Dialog-Frame
      996   DO:
      997       assign v_os-file = "".
      998   END.
      999   ON LEAVE OF file-name IN FRAME Dialog-Frame
     1000   DO:
     1001       ASSIGN file-name.
     1002       IF SEARCH( file-name ) <> ? AND SEARCH( file-name ) <> "":U THEN DO:
     1003           ASSIGN FILE-INFO:FILE-NAME = file-name.
     1004           IF FILE-INFO:FULL-PATHNAME <> ? THEN ASSIGN file-name = FILE-INFO:FULL-PATHNAME.
     1005           DISP file-name WITH FRAME Dialog-Frame.
     1006       END.
     1007       APPLY "TAB":U TO file-name IN FRAME Dialog-Frame.
     1008   END.
     1009   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1010   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1011   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1012   on help of frame Dialog-Frame
     1013   do:
     1014     run gbl/app_help.p
     1015       (input this-procedure :file-name
     1016       ,input ''
     1017       ,input ?
     1018       ) no-error.
     1019     if error-status :error then do:
     1020       message
     1021         "Ошибка при вызове помощи"
     1022         error-status :get-message(1)
     1023         view-as alert-box .
     1024     end.
     1025   end.
     1026   run minbtn-set in this-procedure .
     1027   on choose of b-help in frame Dialog-Frame
     1028   do:
     1029     apply "help":u to frame Dialog-Frame .
     1030   end.
     1031   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1032   procedure minbtn-set :
     1033       do
     1034           on error undo, return error return-value
     1035           :
     1036           define variable ii              as integer       no-undo .
     1037           define variable fh              as widget-handle no-undo .
     1038           define variable hh              as widget-handle no-undo .
     1039           define variable v-h             as handle        extent 4 no-undo .
     1040           define variable v-name-button   as character     no-undo .
     1041           define variable v-help-old-x    as decimal       no-undo .
     1042           define variable v-help-old-y    as decimal       no-undo .
     1043           define variable v-help-old-size as decimal       no-undo .
     1044           define variable v-frame-width   as decimal       no-undo .
     1045           define variable jj              as integer       no-undo .
     1046           do
     1047               on error undo, return error
     1048               :
     1049               assign
     1050                   v-frame-width = frame Dialog-Frame:width - 0.3
     1051                   fh            = frame Dialog-Frame:first-child
     1052                   hh            = fh:first-child
     1053                   ii            = 1
     1054                   .
     1055               do while valid-handle(hh):
     1056                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1057                   do:
     1058                       case lc(hh:name) :
     1059                           when "b-help" then
     1060                               do:
     1061                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1062                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1063                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1064                                   hh:TOOLTIP = "Помощь" .
     1065                                   v-help-old-x = hh:column .
     1066                                   v-help-old-y = hh:row    .
     1067                                   v-help-old-size = hh:width .
     1068                                   hh:width-chars = 2.5 .
     1069                               end.
     1070                           when "b-print" then
     1071                               do:
     1072                                   hh:load-image("cmp/b-print.bmp":u) .
     1073                                   hh:TOOLTIP = "Печать" .
     1074                                   v-h[ii] = hh:handle .
     1075                                   ii = ii + 1 .
     1076                                   hh:width-chars = 3 .
     1077                               end.
     1078                           when "b-history" or
     1079                           when "b-hist" then
     1080                               do:
     1081                                   hh:load-image("cmp/b-hist.bmp":u) .
     1082                                   hh:TOOLTIP = "История" .
     1083                                   v-h[ii] = hh:handle .
     1084                                   ii = ii + 1 .
     1085                                   hh:width-chars = 3 .
     1086                               end.
     1087                           when "b-sch" then
     1088                               do:
     1089                                   hh:load-image("cmp/b-sch.bmp":u) .
     1090                                   hh:TOOLTIP = "Установка Фильтра" .
     1091                                   v-h[ii] = hh:handle .
     1092                                   ii = ii + 1 .
     1093                                   hh:width-chars = 3 .
     1094                               end.
     1095                           when "b-hist-user" then
     1096                               do:
     1097                                   hh:load-image("cmp/b-hist.bmp":u) .
     1098                                   hh:TOOLTIP = "История пользователя" .
     1099                                   ii = ii + 1 .
     1100                               end.
     1101                       end case.
     1102                   end.
     1103                   hh = hh:next-sibling.
     1104               end.
     1105               b-help:column = v-frame-width - b-help:width-chars.
     1106               jj = 0.
     1107               repeat ii = 4 to 1 by -1 :
     1108                   if valid-handle (v-h[ii] ) then
     1109                   do:
     1110                       jj  = jj + 1 .
     1111                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1112                       v-h[ii]:row    = v-help-old-y .
     1113                   end.
     1114               end.
     1115           end.
     1116       end.
     1117   end procedure.
     1118   MAIN-BLOCK:
     1119   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1120      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1121   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1122     run mainmenu_getcntxt in parparentproc
     1123       (output v-cntxt-db-num
     1124       ,output v-cntxt-userid
     1125       ,output v-cntxt-level
     1126       ,output v-cntxt-host-code-obj
     1127       ,output v-cntxt-obj-type
     1128       ,output v-cntxt-obj-code
     1129       ,output v-cntxt-db-num-obj
     1130       ,output v-cntxt-is-admin
     1131       ) .
     1132    run fill-by-usr-flt in this-procedure  no-error .
     1133    RUN enable_UI.
     1134    if not tnvedimp and custvalue <> "yes" then do:
     1135       assign
     1136       t-tnved = no.
     1137       disable
     1138       T-tnved
     1139       with frame Dialog-Frame .
     1140     end.
     1141     WAIT-FOR GO OF FRAME Dialog-Frame.
     1142     assign
     1143     v-uf-list_ =
     1144                  string(T-artic)       + chr(4) +
     1145                  string(T-name)        + chr(4) +
     1146                  string(t-engl-name )  + chr(4) +
     1147                  string(t-unit-base)   + chr(4) +
     1148                  string(t-VAT-code)    + chr(4) +
     1149                  string(t-SLT-code)    + chr(4) +
     1150                  string(t-struct)      + chr(4) +
     1151                  string(t-tnved)       + chr(4) +
     1152                  string(t-attrib)      + chr(4) +
     1153                  string(t-destin)      + chr(4) +
     1154                  string(t-sert)        + chr(4) +
     1155                  string(t-user-rule)   + chr(4) +
     1156                  string(t-prod)        + chr(4) +
     1157                  string(t-alpha1)      + chr(4) +
     1158                  string(t-grp-code)    + chr(4) +
     1159                  string(t-service)     + chr(4) +
     1160                  string(t-gds-code)    + chr(4) +
     1161                  string(t-mark)
     1162     v-uf-Naim  = v-init-dir
     1163    .
     1164     run uf-set in this-procedure(
     1165       input  'imp-goods':U
     1166       ,input v-cntxt-userid
     1167       ,input v-uf-List_
     1168       ,input v-uf-Naim
     1169       ,input v-uf-print-graft
     1170       ,input v-uf-sort-gr
     1171       ,input v-uf-type-price
     1172       ,input v-uf-type-val
     1173   )  no-error .
     1174   END.
     1175   RUN disable_UI.
     1176   PROCEDURE disable_UI :
     1177     HIDE FRAME Dialog-Frame.
     1178   END PROCEDURE.
     1179   PROCEDURE enable_UI :
     1180     DISPLAY file-name T-artic RS-codir T-name T-engl-name T-unit-base T-VAT-code
     1181             T-SLT-code T-struct T-tnved T-destin T-attrib T-user-rule T-sert
     1182             T-prod T-alpha1 T-grp-code T-service T-gds-code t-mark text-string
     1183         WITH FRAME Dialog-Frame.
     1184     if iOnlyfile
     1185     then
     1186        ENABLE RECT-atribut B-exit b-quit B-check B-Help B-file file-name RS-codir
     1187         WITH FRAME Dialog-Frame.
     1188     else
     1189        ENABLE RECT-atribut B-exit b-quit B-check B-Help B-file file-name RS-codir
     1190            T-engl-name T-unit-base T-VAT-code T-SLT-code T-struct T-tnved
     1191            T-destin T-attrib T-user-rule T-sert T-prod T-grp-code T-service T-gds-code t-mark text-string
     1192         WITH FRAME Dialog-Frame.
     1193     VIEW FRAME Dialog-Frame.
     1194   END PROCEDURE.
     1195   PROCEDURE fill-by-usr-flt :
     1196   run uf-get in this-procedure(
     1197        input  'imp-goods':U
     1198       ,input  v-cntxt-userid
     1199       ,output v-uf-List_
     1200       ,output v-uf-Naim
     1201       ,output v-uf-print-graft
     1202       ,output v-uf-sort-gr
     1203       ,output v-uf-type-price
     1204       ,output v-uf-type-val
     1205   )  no-error.
     1206     if num-entries(v-uf-List_, chr(4)) >= 12 then
     1207     assign
     1208     T-artic       =  logical(entry(1     ,      v-uf-list_, chr(4)))
     1209     T-name        =  logical(entry(2      ,      v-uf-list_, chr(4)))
     1210     t-engl-name   =  logical(entry(3 ,      v-uf-list_, chr(4)))
     1211     t-unit-base   =  logical(entry(4  ,      v-uf-list_, chr(4)))
     1212     t-VAT-code    =  logical(entry(5 ,      v-uf-list_, chr(4)))
     1213     t-SLT-code    =  logical(entry(6  ,      v-uf-list_, chr(4)))
     1214     t-struct      =  logical(entry(7    ,      v-uf-list_, chr(4)))
     1215     t-tnved       =  logical(entry(8     ,      v-uf-list_, chr(4)))
     1216     t-attrib      =  logical(entry(9    ,      v-uf-list_, chr(4)))
     1217     t-destin      =  logical(entry(10    ,      v-uf-list_, chr(4)))
     1218     t-sert        =  logical(entry(11      ,      v-uf-list_, chr(4)))
     1219     t-user-rule   =  logical(entry(12 ,      v-uf-list_, chr(4)))
     1220     no-error.
     1221     if num-entries(v-uf-List_, chr(4)) >= 13 then
     1222     assign
     1223     T-prod       =  logical(entry(13     ,      v-uf-list_, chr(4)))
     1224     no-error
     1225     .
     1226     if num-entries(v-uf-List_, chr(4)) >= 14 then
     1227     assign
     1228     T-alpha1       =  logical(entry(14     ,      v-uf-list_, chr(4)))
     1229     no-error
     1230     .
     1231     if num-entries(v-uf-List_, chr(4)) >= 15 then
     1232     assign
     1233     T-grp-code     =  logical(entry(15     ,      v-uf-list_, chr(4)))
     1234     no-error
     1235     .
     1236     if num-entries(v-uf-List_, chr(4)) >= 16 then
     1237     assign
     1238     T-service     =  logical(entry(16     ,      v-uf-list_, chr(4)))
     1239     no-error
     1240     .
     1241     if num-entries(v-uf-List_, chr(4)) >= 17 then
     1242     assign
     1243     T-gds-code     =  logical(entry(17     ,      v-uf-list_, chr(4)))
     1244     no-error
     1245     .
     1246     if num-entries(v-uf-List_, chr(4)) >= 18 then
     1247     assign
     1248     T-mark     =  logical(entry(18     ,      v-uf-list_, chr(4)))
     1249     no-error
     1250     .
     1251     assign
     1252     file-info:file-name = v-uf-naim
     1253     .
     1254     assign
     1255     v-init-dir   = ( if file-info:file-type <> ?
     1256                      and index( file-info:file-type, "D":U ) <> 0
     1257                      then v-uf-naim
     1258                      else ".")
     1259     .
     1260   END PROCEDURE.
