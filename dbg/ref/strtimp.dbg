      230               when 'e-eslg-e':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Оперативный балансовый отчет движения нефтепродуктов"     p-tooltip = "Оперативный балансовый отчет движения нефтепродуктов"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
      231               when 'prphoto':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(2256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(2256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Прайс-лист с фото товаров"     p-tooltip = "Прайс-лист с фото товаров"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
      232               when 'chkgdsfi':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Товарная строка чека - доп поля"     p-tooltip = "Товарная строка чека - доп поля "     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
      233               when 'chkdocfi':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Чек - доп поля"     p-tooltip = "Чек - доп поля"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
      234               when 'barcodfi':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Бар-код - доп поля"     p-tooltip = "Бар-код - доп поля"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
      235                when 'UPD':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Настройки справочника Электронного документоборота"     p-tooltip = "Настройки справочника Электронного документоборота"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
      236               when 'LK_RECEIPT':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Настройки справочника документов Вывода из оборота (ОСУ)"     p-tooltip = "Настройки справочника документов Вывода из оборота (ОСУ)"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
      237         otherwise do:
      238           undo, return error "неизвестная настройка пользователя usr-flt" + " " + p-code .
      239         end.
      240       end CASE.
      241     end.
      242   end procedure.
      243   procedure uf-get :
      244     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
      245     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
      246     define output parameter p-List_        like ubflt.usr-flt.List_        no-undo .
      247     define output parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
      248     define output parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
      249     define output parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
      250     define output parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
      251     define output parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
      252     do
      253     on error undo, return error
      254     :
      255       define buffer buf_usr-flt for ubflt.usr-flt .
      256       define variable v-use-List_     as logical   no-undo .
      257       define variable v-type-List_     as character no-undo .
      258       define variable v-format-List_   as character no-undo .
      259       define variable v-use-Naim      as logical   no-undo .
      260       define variable v-type-Naim      as character no-undo .
      261       define variable v-format-Naim    as character no-undo .
      262       define variable v-use-print-graft as logical   no-undo .
      263       define variable v-use-sort-gr     as logical   no-undo .
      264       define variable v-use-type-price  as logical   no-undo .
      265       define variable v-use-type-val    as logical   no-undo .
      266       define variable v-label          as character no-undo .
      267       define variable v-tooltip        as character no-undo .
      268       define variable v-user-can-edit  as logical   no-undo .
      269       define variable v-output-display as logical   no-undo .
      270       define variable v-other          as character no-undo .
      271       run uf-name in this-procedure
      272          (input  entry(1, p-code, chr(4))
      273         ,output v-use-List_
      274         ,output v-type-List_
      275         ,output v-format-List_
      276         ,output v-use-Naim
      277         ,output v-type-Naim
      278         ,output v-format-Naim
      279         ,output v-use-print-graft
      280         ,output v-use-sort-gr
      281         ,output v-use-type-price
      282         ,output v-use-type-val
      283         ,output v-label
      284         ,output v-tooltip
      285         ,output v-user-can-edit
      286         ,output v-output-display
      287         ,output v-other
      288         ) no-error .
      289       if error-status :error then do:
      290         undo, return error return-value .
      291       end.
      292       find first buf_usr-flt no-lock where
      293                  buf_usr-flt.Call-point     = p-code AND
      294                  buf_usr-flt.user-name       = p-user-name
      295         no-error .
      296       if avail buf_usr-flt then do:
      297         assign
      298         p-List_        = (if v-use-List_       then buf_usr-flt.List_       else ?)
      299         p-Naim         = (if v-use-Naim        then buf_usr-flt.Naim        else ?)
      300         p-print-graft  = (if v-use-print-graft then buf_usr-flt.print-graft else ?)
      301         p-sort-gr      = (if v-use-sort-gr     then buf_usr-flt.sort-gr     else ?)
      302         p-type-price   = (if v-use-type-price  then buf_usr-flt.type-price  else ?)
      303         p-type-val     = (if v-use-List_       then buf_usr-flt.type-val    else ?)
      304         .
      305       end.
      306       else do:
      307         assign
      308         p-List_        = (if v-use-List_       then "":U                    else ?)
      309         p-Naim         = (if v-use-Naim        then "":U                    else ?)
      310         p-print-graft  = (if v-use-print-graft then no                      else ?)
      311         p-sort-gr      = (if v-use-sort-gr     then no                      else ?)
      312         p-type-price   = (if v-use-type-price  then no                      else ?)
      313         p-type-val     = (if v-use-List_       then no                      else ?)
      314         .
      315       end.
      316     end.
      317   end procedure.
      318   procedure uf-set :
      319     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
      320     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
      321     define input  parameter p-List_        like ubflt.usr-flt.List_        no-undo .
      322     define input  parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
      323     define input  parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
      324     define input  parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
      325     define input  parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
      326     define input  parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
      327     do
      328     on error undo, return error
      329     :
      330       define buffer buf_usr-flt for ubflt.usr-flt .
      331       define variable v-use-List_     as logical   no-undo .
      332       define variable v-type-List_     as character no-undo .
      333       define variable v-format-List_   as character no-undo .
      334       define variable v-use-Naim      as logical   no-undo .
      335       define variable v-type-Naim      as character no-undo .
      336       define variable v-format-Naim    as character no-undo .
      337       define variable v-use-print-graft as logical   no-undo .
      338       define variable v-use-sort-gr   as logical   no-undo .
      339       define variable v-use-type-price as logical   no-undo .
      340       define variable v-use-type-val  as logical   no-undo .
      341       define variable v-tooltip        as character no-undo .
      342       define variable v-label          as character no-undo .
      343       define variable v-user-can-edit  as logical   no-undo .
      344       define variable v-output-display as logical   no-undo .
      345       define variable v-other          as character no-undo .
      346       run uf-name in this-procedure
      347         (input  entry(1, p-code, chr(4))
      348         ,output v-use-List_
      349         ,output v-type-List_
      350         ,output v-format-List_
      351         ,output v-use-Naim
      352         ,output v-type-Naim
      353         ,output v-format-Naim
      354         ,output v-use-print-graft
      355         ,output v-use-sort-gr
      356         ,output v-use-type-price
      357         ,output v-use-type-val
      358         ,output v-label
      359         ,output v-tooltip
      360         ,output v-user-can-edit
      361         ,output v-output-display
      362         ,output v-other
      363         ) no-error .
      364       if error-status :error then do:
      365         undo, return error return-value .
      366       end.
      367       find first buf_usr-flt where
      368                  buf_usr-flt.Call-point     = p-code AND
      369                  buf_usr-flt.user-name       = p-user-name
      370         no-error .
      371       if not avail buf_usr-flt then do:
      372           create buf_usr-flt .
      373           assign
      374           buf_usr-flt.call-point = p-code
      375           buf_usr-flt.user-name  = p-user-name
      376           .
      377       end.
      378       if avail buf_usr-flt then do:
      379        assign
      380        buf_usr-flt.List_       =  (if v-use-List_       then  p-List_        else ?)
      381        buf_usr-flt.Naim        =  (if v-use-Naim        then  p-Naim         else ?)
      382        buf_usr-flt.print-graft =  (if v-use-print-graft then  p-print-graft  else ?)
      383        buf_usr-flt.sort-gr     =  (if v-use-sort-gr     then  p-sort-gr      else ?)
      384        buf_usr-flt.type-price  =  (if v-use-type-price  then  p-type-price   else ?)
      385        buf_usr-flt.type-val    =  (if v-use-List_       then  p-type-val     else ?)
      386       .
      387       release buf_usr-flt.
      388       end.
      389       else undo, return error ("Ошибка при записи usr-flt" + substitute(" call-point=&1, user-name=&2", p-code, p-user-name)).
      390     end.
      391   end procedure.
      392   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      393     define variable v-cntxt-db-num        as integer   no-undo .
      394     define variable v-cntxt-userid        as character no-undo .
      395     define variable v-cntxt-level         as character no-undo .
      396     define variable v-cntxt-host-code-obj as integer   no-undo .
      397     define variable v-cntxt-obj-type      as character no-undo .
      398     define variable v-cntxt-obj-code      as integer   no-undo .
      399     define variable v-cntxt-db-num-obj    as integer   no-undo .
      400     define variable v-cntxt-is-admin      as logical   no-undo .
      401   define variable  conf-par as character no-undo.
      402   define variable  par-type as character no-undo.
      403   define variable v-init-dir as character no-undo .
      404   DEFINE stream gds-file.
