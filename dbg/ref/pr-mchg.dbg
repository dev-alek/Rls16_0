        1   define input parameter parparentproc as widget-handle no-undo .
        2   define input parameter p-mode as character no-undo.
        3   define input parameter p-node-code like ub.gds-grp-obj.node-code no-undo.
        4   define input parameter  p-option as character no-undo.
        5   define input parameter  p-host-code like ub.sysconf.host-code no-undo.
        6   define input parameter  p-obj-type like ub.clients.obj-type no-undo.
        7   define input parameter  p-obj-code like ub.clients.obj-code no-undo.
        8   define output parameter p-rec as recid no-undo.
        9   define variable vss-revision    as character no-undo init "$Revision$":U .
       10   define variable vss-author      as character no-undo init "$Author$":U .
       11   define variable vss-date        as character no-undo init "$Date$":U .
       12   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       13   define variable vss-archive     as character no-undo init "$Archive$":U .
       14   define variable vss-description as character no-undo init "Границы торговой наценки на группы товаров".
       15   procedure vss-get-info :
       16     define output parameter p-vss-revision    like vss-revision    no-undo .
       17     define output parameter p-vss-author      like vss-author      no-undo .
       18     define output parameter p-vss-date        like vss-date        no-undo .
       19     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       20     define output parameter p-vss-archive     like vss-archive     no-undo .
       21     define output parameter p-vss-description like vss-description no-undo .
       22     assign
       23       p-vss-revision    = vss-revision
       24       p-vss-author      = vss-author
       25       p-vss-date        = vss-date
       26       p-vss-workfile    = vss-workfile
       27       p-vss-archive     = vss-archive
       28       p-vss-description = vss-description
       29     .
       30   end procedure.
       31   procedure vss-get-parameters :
       32     define output parameter p-vss-parameters as character no-undo .
       33   end procedure.
       34   define new global shared variable g#vssrevis-logger as handle    no-undo .
       35   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       36   define variable v-vssrevis-logger                   as handle    no-undo .
       37   procedure vss-logevent :
       38     define input  parameter p-extra-paramters as character no-undo .
       39     define variable v-vssrevis-parameters as character no-undo .
       40     do
       41     on error undo, return error return-value
       42     :
       43       if  valid-handle(v-vssrevis-logger)
       44       and v-vssrevis-logger :get-signature("logevent") <> ""
       45       then do:
       46         run vss-get-parameters in this-procedure
       47           (output v-vssrevis-parameters
       48           ).
       49         run logevent in v-vssrevis-logger
       50           (input vss-workfile
       51           ,input vss-revision
       52           ,input v-vssrevis-parameters
       53           ,input p-extra-paramters
       54           ).
       55       end.
       56     end.
       57   end procedure.
       58   assign
       59     v-vssrevis-logger = g#vssrevis-logger
       60   .
       61   if  valid-handle(v-vssrevis-logger)
       62   and v-vssrevis-logger :get-signature("logevent") <> ""
       63   then do:
       64     assign
       65       v-vssrevis-logevent = true
       66     .
       67     run vss-logevent in this-procedure (input vss-description) .
       68   end.
       69   define new global shared variable g#language as character no-undo .
       70   if g#language <> '' and g#language <> 'rus':U then do:
       71     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       72   end.
       73   procedure proc-alt-shift-f2:
       74     if not ibs.th.gbl.gbl-var:rcode
       75   then
       76     run gbl\inidebug.p .
       77   end.
       78   procedure proc-alt-shift-f3:
       79     run gbl/prvssinf.p
       80       ( input this-procedure
       81       ) .
       82   end.
       83   define variable v-inform-launched as logical no-undo initial false .
       84   procedure proc-alt-shift-f4:
       85     define variable v-action as character no-undo .
       86     if v-inform-launched = false then do:
       87       assign
       88         v-inform-launched = true
       89       .
       90       run gbl/d-inform.w
       91         (  input self
       92         ,  input this-procedure
       93         , output v-action
       94         ) no-error .
       95       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       96       assign
       97         v-inform-launched = false
       98       .
       99     end.
      100   end.
      101   procedure proc-alt-f1:
      102     run gbl/corrhelp.p
      103       (input this-procedure
      104       ) .
      105   end .
      106   on alt-shift-f2 anywhere do:
      107     run proc-alt-shift-f2.
      108   end.
      109   on alt-shift-f3 anywhere do:
      110     run proc-alt-shift-f3 in this-procedure .
      111   end.
      112   on alt-shift-f4 anywhere do:
      113     run proc-alt-shift-f4 in this-procedure.
      114   end.
      115   on alt-f1 anywhere do:
      116     run proc-alt-f1 in this-procedure .
      117   end.
      118   define new global shared variable g#library  as handle no-undo .
      119   define new global shared variable g#library2 as handle no-undo .
      120   define variable vss-include-info0 as character format "X(65)" no-undo
      121   initial "@(#)$Workfile$ $Revision$".
      122   define temp-table temp_grplib_grp no-undo
      123       field sel           as character
      124       field nabor         as character
      125       field full-name     as character
      126       field print-code    as character
      127       field sort-name     as character
      128       field node-code     as integer
      129       field upper-code    as integer
      130       field calc-method   as character
      131       field round-method  as character
      132       field increase-pc   as decimal
      133       field min-marg      as character
      134       field max-marg      as character
      135       field cli-type      as character
      136       field cli-code      as integer
      137       field notcorr      as character
      138       field name          as character
      139       field level         as integer
      140       field mark          as character
      141       index pi is primary unique sort-name
      142       index fn full-name
      143       index nc is unique node-code
      144       index sl sel
      145       index uc upper-code
      146   .
      147   define temp-table temp_grplib_found-grp no-undo
      148       field full-name   as character
      149       field sort-name   as character
      150       field node-code   as integer
      151       field level       as integer
      152       field is-terminal as logical
      153       index pi is primary unique sort-name
      154       index fn full-name
      155       index lv level
      156       index it is-terminal
      157   .
      158   define temp-table temp_found-result-nodelist no-undo
      159       field node-code     as recid
      160       field processed     as logical
      161       field sort-name     as character
      162       field full-name     as character
      163       index pi is primary unique node-code
      164       index ps processed
      165   .
      166   define variable v-grplib-not-fill-extra-info        as logical      no-undo.
      167   define variable v-grplib-no-warning-grp-amount      as logical      no-undo.
      168   define variable v-grplib-grp-amount-for-load        as integer      no-undo.
      169   procedure grplib-get-parameters :
      170   define input parameter p-store-type     as character        no-undo.
      171   define input parameter p-store-code     as integer          no-undo.
      172   do
      173   on error undo, return error
      174   :
      175       assign
      176           v-grplib-not-fill-extra-info = no
      177       .
      178   end.
      179   end procedure.
      180   procedure grplib-get-sort-name :
      181   do
      182   on error undo, return error
      183   :
      184   define input parameter p-node-code  as integer      no-undo.
      185   define output parameter p-sort-name as character    no-undo.
      186       define variable v-upper-code    as integer           no-undo.
      187       define buffer buf_gds-grp       for ub.gds-grp.
      188       define buffer buf_upper_gds-grp for ub.gds-grp.
      189       find first buf_gds-grp no-lock
      190            where buf_gds-grp.node-code = p-node-code
      191       no-error.
      192       if not available buf_gds-grp
      193       then do:
      194           undo, return error "grplib-get-sort-name: Не найдена группа товаров с кодом " + string( p-node-code ).
      195       end.
      196       assign
      197           p-sort-name  = ""
      198           v-upper-code = 1
      199       .
      200       do while buf_gds-grp.upper-code <> 0
      201       on error undo, return error "grplib-get-sort-name: Ошибка составления полного имени группы"
      202       :
      203           assign
      204               p-sort-name  = buf_gds-grp.node-name
      205                            + (if p-sort-name <> "" then chr(2) else "")
      206                            + p-sort-name
      207               v-upper-code = buf_gds-grp.upper-code
      208           .
      209           find first buf_gds-grp no-lock
      210                where buf_gds-grp.node-code = v-upper-code
      211           no-error.
      212           if not available buf_gds-grp
      213           then do:
      214               undo, return error "grplib-get-sort-name: Не найдена группа товаров с кодом "
      215                                   + string( v-upper-code )
      216                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
      217           end.
      218       end.
      219   end.
      220   end procedure.
      221   define variable vss-include-info1 as character format "X(65)" no-undo
      222   initial "@(#)$Workfile$ $Revision$".
      223   procedure grplib-get-full-name :
      224      define input parameter p-node-code  as integer      no-undo.
      225      define output parameter p-full-name as character    no-undo.
      226      do
      227   on error undo, return error
      228   :
      229       define variable v-upper-code    as integer           no-undo.
      230       define buffer buf_gds-grp       for ub.gds-grp.
      231       define buffer buf_upper_gds-grp for ub.gds-grp.
      232       find first buf_gds-grp no-lock
      233            where buf_gds-grp.node-code = p-node-code
      234       no-error.
      235       if not available buf_gds-grp
      236       then do:
      237           undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
      238       end.
      239       assign
      240           p-full-name  = ""
      241           v-upper-code = 1
      242       .
      243       do while buf_gds-grp.upper-code <> 0
      244       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
      245       :
      246           assign
      247               p-full-name  = buf_gds-grp.node-name
      248                            + (if p-full-name <> "" then chr(47) else "")
      249                            + p-full-name
      250               v-upper-code = buf_gds-grp.upper-code
      251           .
      252           find first buf_gds-grp no-lock
      253                where buf_gds-grp.node-code = v-upper-code
      254           no-error.
      255           if not available buf_gds-grp
      256           then do:
      257               undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом "
      258                                   + string( v-upper-code )
      259                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
      260           end.
      261       end.
      262       assign
      263       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
      264       .
      265   end.
      266   end .
      267   procedure grplib-get-node-from-full-name :
      268   define input parameter p-full-name as character no-undo .
      269   define output parameter p-node-code as integer no-undo .
      270   define variable v-ii as integer no-undo .
      271   define variable v-upper-code as integer no-undo .
      272   define variable v-root-code as integer no-undo .
      273   define variable v-entry as character no-undo .
      274   define buffer buf_gds-grp       for ub.gds-grp.
      275   do
      276   on error undo, return error
      277   :
      278     find first buf_gds-grp no-lock
      279         where buf_gds-grp.upper-code = 0
      280     no-error .
      281     if not available buf_gds-grp
      282     then do:
      283         undo, return error substitute("Не найдена корневая группа товаров (upper-code = 0)").
      284     end.
      285     else do:
      286       assign
      287       v-root-code = buf_gds-grp.node-code
      288       .
      289     end.
      290     v-upper-code = v-root-code.
      291     do v-ii = 1 to num-entries(p-full-name, chr(47)):
      292       assign
      293       v-entry = entry(v-ii, p-full-name, chr(47)).
      294       if v-entry = '' then leave.
      295       find first buf_gds-grp no-lock where
      296                 buf_gds-grp.node-name = v-entry
      297             and buf_gds-grp.upper-code = v-upper-code
      298             no-error.
      299       if not available buf_gds-grp then do:
      300         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
      301       end.
      302       else do:
      303         p-node-code = buf_gds-grp.node-code.
      304         v-upper-code = buf_gds-grp.node-code.
      305       end.
      306     end.
      307   end.
      308   end .
      309   procedure grplib-get-root-code :
      310   do
      311   on error undo, return error
      312   :
      313   define output parameter p-root-code as integer      no-undo.
      314       define buffer buf_gds-grp       for ub.gds-grp.
      315       find first buf_gds-grp no-lock
      316           where buf_gds-grp.upper-code = 0
      317       no-error .
      318       if not available buf_gds-grp
      319       then do:
      320           undo, return error .
      321       end.
      322       else do:
      323           assign
      324               p-root-code = buf_gds-grp.node-code
      325           .
      326       end.
      327   end.
      328   end procedure.
      329   procedure grplib-find-grp-by-full-name :
      330   do
      331   on error undo, return error
      332   :
      333   define input parameter p-search-name  as character    no-undo.
      334   define input parameter p-fill-path    as logical      no-undo.
      335   define output parameter p-found       as logical      no-undo.
      336       define variable v-upper-code    as integer          no-undo.
      337       define variable v-counter       as integer           no-undo.
      338       define variable v-level         as integer           no-undo.
      339       define variable v-full-name     as character         no-undo.
      340       define variable v-sort-name     as character         no-undo.
      341       define buffer buf_gds-grp       for ub.gds-grp.
      342       assign
      343           p-search-name = replace( p-search-name, chr(47), chr(2) )
      344       .
      345       run grplib-get-root-code ( output v-upper-code ) no-error .
      346       if error-status :error
      347       then do:
      348           undo, return error "grplib-expand-name: Ошибка при поиске корневого узла".
      349       end.
      350       assign
      351           v-full-name  = ""
      352           v-level      = num-entries( p-search-name, chr(2) )
      353       .
      354       for each temp_grplib_found-grp
      355       :
      356           delete temp_grplib_found-grp.
      357       end.
      358       start-name-analyze:
      359       do v-counter = 1 to v-level
      360       :
      361           if v-counter < v-level
      362           then do:
      363               find first buf_gds-grp no-lock
      364                    where buf_gds-grp.upper-code = v-upper-code
      365                      and buf_gds-grp.node-name  = entry( v-counter, p-search-name, chr(2) )
      366               no-error .
      367               if not available buf_gds-grp
      368               then do:
      369                   assign
      370                       v-full-name  = p-search-name
      371                       v-sort-name  = p-search-name
      372                   .
      373                   return error "grplib-expand-name: не найдена группа " + entry( v-level, p-search-name, chr(2) ).
      374               end.
      375               else do:
      376                   assign
      377                       v-full-name = v-full-name + ( if v-full-name = "" then "" else chr(47) )        + buf_gds-grp.node-name
      378                       v-sort-name = v-sort-name + ( if v-sort-name = "" then "" else chr(2) ) + buf_gds-grp.node-name
      379                       v-upper-code = buf_gds-grp.node-code
      380                   .
      381                   if p-fill-path = yes
      382                   then do:
      383                       create temp_grplib_found-grp.
      384                       assign
      385                           temp_grplib_found-grp.full-name = v-full-name + chr(47)
      386                           temp_grplib_found-grp.sort-name = v-sort-name
      387                           temp_grplib_found-grp.node-code = v-upper-code
      388                           temp_grplib_found-grp.level     = v-counter
      389                       .
      390                   end.
      391               end.
      392           end.
      393           else do:
      394               for each buf_gds-grp no-lock
      395                  where buf_gds-grp.upper-code = v-upper-code
      396                    and buf_gds-grp.node-name begins entry( v-counter, p-search-name, chr(2) )
      397               :
      398                   assign
      399                       p-found = yes
      400                   .
      401                   create temp_grplib_found-grp.
      402                   assign
      403                       temp_grplib_found-grp.full-name = v-full-name
      404                                                           + (if v-full-name = "" then "" else chr(47) )
      405                                                           + buf_gds-grp.node-name + chr(47)
      406                       temp_grplib_found-grp.sort-name = v-sort-name
      407                                                           + ( if v-sort-name = "" then "" else chr(2) )
      408                                                           + buf_gds-grp.node-name
      409                       temp_grplib_found-grp.node-code = buf_gds-grp.node-code
      410                       temp_grplib_found-grp.level     = v-level
      411                   .
      412               end.
      413               if p-found = no
      414               then do:
      415                   assign
      416                       v-full-name  = p-search-name
      417                       v-sort-name  = p-search-name
      418                   .
      419                   for each temp_grplib_found-grp
      420                   :
      421                       delete temp_grplib_found-grp.
      422                   end.
      423                   assign
      424                       p-found = no
      425                   .
      426               end.
      427           end.
      428       end.
      429   end.
      430   end procedure.
      431   procedure grplib-find-all-subgroup :
      432   do
      433   on error undo, return error
      434   :
      435   define input parameter p-start-node-code    as integer      no-undo.
      436   define input parameter p-terminal-only      as logical      no-undo.
      437       define variable v-start-full-name   as character     no-undo.
      438       define variable v-start-sort-name   as character     no-undo.
      439       define variable v-not-found         as logical       no-undo.
      440       define variable v-is-terminal       as logical       no-undo.
      441       define buffer buf_gds-grp           for ub.gds-grp.
      442       create temp_found-result-nodelist.
      443       assign
      444           temp_found-result-nodelist.node-code = p-start-node-code
      445           temp_found-result-nodelist.processed = no
      446       .
      447       run grplib-get-full-name in this-procedure (
      448             input p-start-node-code
      449           , output v-start-full-name
      450       ).
      451       run grplib-get-full-name in this-procedure (
      452             input p-start-node-code
      453           , output v-start-sort-name
      454       ).
      455       process-nodes:
      456       do while yes
      457       :
      458           find first temp_found-result-nodelist
      459                where temp_found-result-nodelist.node-code = p-start-node-code
      460           .
      461           assign
      462               temp_found-result-nodelist.processed = yes
      463           .
      464           for each buf_gds-grp no-lock
      465              where buf_gds-grp.upper-code = p-start-node-code
      466           on error undo, return error
      467           :
      468               run grplib-is-terminal in this-procedure (
      469                     input buf_gds-grp.node-code
      470                   , output v-is-terminal
      471               ).
      472               if v-is-terminal = yes
      473               then do:
      474                   create temp_grplib_found-grp.
      475                   assign
      476                       temp_grplib_found-grp.full-name   = right-trim(v-start-full-name, chr(47)) +
      477                                                           chr(47) + buf_gds-grp.node-name + chr(47)
      478                       temp_grplib_found-grp.sort-name   = right-trim(v-start-sort-name, chr(2)) +
      479                                                           chr(2) + buf_gds-grp.node-name + chr(2)
      480                       temp_grplib_found-grp.node-code   = buf_gds-grp.node-code
      481                       temp_grplib_found-grp.is-terminal = yes
      482                   .
      483               end.
      484               else do:
      485                   create temp_found-result-nodelist.
      486                   assign
      487                       temp_found-result-nodelist.node-code = buf_gds-grp.node-code
      488                       temp_found-result-nodelist.full-name = right-trim(v-start-full-name, chr(47)) +
      489                                                              chr(47) + buf_gds-grp.node-name + chr(47)
      490                       temp_found-result-nodelist.sort-name = right-trim(v-start-sort-name, chr(2)) +
      491                                                              chr(2) + buf_gds-grp.node-name + chr(2)
      492                       temp_found-result-nodelist.processed = no
      493                   .
      494                   if p-terminal-only = no
      495                   then do:
      496                       create temp_grplib_found-grp.
      497                       assign
      498                           temp_grplib_found-grp.full-name   = right-trim(v-start-full-name, chr(47)) +
      499                                                               chr(47) + buf_gds-grp.node-name + chr(47)
      500                           temp_grplib_found-grp.sort-name   = right-trim(v-start-sort-name, chr(2)) +
      501                                                               chr(2) + buf_gds-grp.node-name + chr(2)
      502                           temp_grplib_found-grp.node-code   = buf_gds-grp.node-code
      503                           temp_grplib_found-grp.is-terminal = no
      504                       .
      505                   end.
      506               end.
      507           end.
      508           find first temp_found-result-nodelist
      509                where temp_found-result-nodelist.processed = no
      510           no-error.
      511           if not available temp_found-result-nodelist
      512           then do:
      513               leave process-nodes.
      514           end.
      515           else do:
      516               assign
      517                   p-start-node-code = temp_found-result-nodelist.node-code
      518                   v-start-full-name = temp_found-result-nodelist.full-name
      519                   v-start-sort-name = temp_found-result-nodelist.sort-name
      520               .
      521           end.
      522       end.
      523   end.
      524   end procedure.
      525   procedure grplib-expand-name :
      526   define input parameter p-start-name as character        no-undo.
      527   define output parameter p-end-name  as character        no-undo.
      528       define variable v-is-terminal   as logical      no-undo.
      529       define variable v-found         as character    no-undo.
      530       define buffer buf_temp_grplib_found-grp     for temp_grplib_found-grp.
      531   do
      532   for buf_temp_grplib_found-grp
      533   on error undo, return error
      534   :
      535       run grplib-find-grp-by-full-name in this-procedure (
      536             input p-start-name
      537           , input no
      538           , output v-found
      539       ) no-error.
      540       run grplib-get-max-substring in this-procedure (
      541                   input length( p-start-name )
      542                 , output p-end-name
      543       ) no-error .
      544       if error-status :error
      545       then do:
      546           assign
      547               p-end-name = ""
      548           .
      549       end.
      550       else do:
      551           find first temp_grplib_found-grp
      552               where temp_grplib_found-grp.full-name = p-end-name
      553           no-error.
      554           if available temp_grplib_found-grp
      555           then do:
      556               find first buf_temp_grplib_found-grp
      557                   where buf_temp_grplib_found-grp.full-name begins p-end-name
      558                   and recid( buf_temp_grplib_found-grp ) <> recid( temp_grplib_found-grp )
      559               no-error.
      560               if not available buf_temp_grplib_found-grp
      561               then do:
      562                   run grplib-is-terminal in this-procedure (
      563                       input temp_grplib_found-grp.node-code
      564                       , output v-is-terminal
      565                   ).
      566               end.
      567           end.
      568       end.
      569   end.
      570   end procedure.
      571   procedure grplib-get-max-substring :
      572   do
      573   on error undo, return error
      574   :
      575   define input parameter p-min-substring-length   as integer      no-undo.
      576   define output parameter p-substring             as character    no-undo.
      577           define variable v-char-counter  as integer           no-undo.
      578           define variable v-current-char  as character         no-undo.
      579           define variable v-names-counter  as integer           no-undo.
      580           define variable v-base-string   as character         no-undo.
      581           assign
      582               v-char-counter  = p-min-substring-length
      583           .
      584           find first temp_grplib_found-grp no-error.
      585           if not available temp_grplib_found-grp
      586           then do:
      587               undo, return error "grplib-get-max-substring: Нет строк для вычисления общей подстроки".
      588           end.
      589           else do:
      590               assign
      591                   v-base-string  = temp_grplib_found-grp.full-name
      592                   v-char-counter = 0
      593               .
      594               counter-block:
      595               do while yes
      596               on error undo, return error "grplib-get-max-substring: Ошибка вычисления продолжения имени группы."
      597               :
      598                   assign
      599                       v-char-counter  = v-char-counter + 1
      600                       v-current-char  = substring( v-base-string, v-char-counter, 1 )
      601                       v-names-counter = 0
      602                   .
      603                   compare-block:
      604                   for each temp_grplib_found-grp
      605                   :
      606                       assign
      607                           v-names-counter = v-names-counter + 1
      608                       .
      609                       if v-names-counter = 1
      610                       then do:
      611                           next compare-block.
      612                       end.
      613                       if substring( temp_grplib_found-grp.full-name, v-char-counter, 1 ) <> v-current-char
      614                       then do:
      615                           leave counter-block.
      616                       end.
      617                   end.
      618                   if v-names-counter = 1
      619                   then do:
      620                       assign
      621                           p-substring = v-base-string
      622                       .
      623                       return.
      624                   end.
      625               end.
      626               assign
      627                   p-substring = substring( v-base-string, 1, v-char-counter - 1 )
      628               .
      629           end.
      630   end.
      631   end procedure.
      632   procedure grplib-is-terminal :
      633   do
      634   on error undo, return error "Ошибка процедуры grplib-is-terminal"
      635   :
      636   define input parameter p-node-code      as integer      no-undo.
      637   define output parameter p-is-terminal   as logical      no-undo.
      638       define buffer buf_gds-grp       for ub.gds-grp.
      639       find first buf_gds-grp no-lock
      640           where buf_gds-grp.upper-code = p-node-code
      641       no-error .
      642       if not available buf_gds-grp
      643       then do:
      644           assign
      645               p-is-terminal = yes
      646           .
      647       end.
      648       else do:
      649           assign
      650               p-is-terminal = no
      651           .
      652       end.
      653   end.
      654   end procedure.
      655   procedure grplib-have-goods :
      656   do
      657   on error undo, return error
      658   :
      659   define input parameter p-node-code      as integer      no-undo.
      660   define output parameter p-have-goods   as logical      no-undo.
      661       define buffer buf_goods         for ub.goods.
      662       find first buf_goods no-lock
      663            where buf_goods.grp-code = p-node-code
      664       no-error .
      665       if available buf_goods
      666       then do:
      667           assign
      668               p-have-goods = yes
      669           .
      670       end.
      671       else do:
      672           assign
      673               p-have-goods = no
      674           .
      675       end.
      676   end.
      677   end procedure.
      678   procedure grplib-find-by-substring :
      679   do
      680   on error undo, return error
      681   :
      682   define input parameter p-start-code         as integer      no-undo.
      683   define input parameter p-full-search-string as character    no-undo.
      684   define output parameter p-found-code        as integer      no-undo.
      685   define output parameter p-full-name         as character    no-undo.
      686       define variable v-start-code     as integer           no-undo.
      687       define variable v-found          as logical  init no  no-undo.
      688       define buffer buf_gds-grp       for ub.gds-grp.
      689       search-grp:
      690       for each buf_gds-grp no-lock
      691           where buf_gds-grp.node-code > p-start-code
      692       :
      693           if index( buf_gds-grp.node-name, p-full-search-string ) <> 0
      694           then do:
      695               assign
      696                   p-found-code = buf_gds-grp.node-code
      697                   v-found      = yes
      698               .
      699               run grplib-get-full-name in this-procedure (
      700                     input p-found-code
      701                   , output p-full-name
      702               ) no-error .
      703               if error-status :error
      704               then do:
      705                   undo, return error "grplib-find-by-substring: Ошибка вычисления полного имени группы." + chr(10) + return-value.
      706               end.
      707               leave search-grp.
      708           end.
      709       end.
      710       if v-found = yes
      711       then do:
      712       end.
      713       else do:
      714           assign
      715               p-full-name  = ""
      716               p-found-code = 0
      717           .
      718       end.
      719   end.
      720   end procedure.
      721   procedure grplib-analyze-grp-name :
      722   do
      723   on error undo, return error
      724   :
      725   define input parameter p-grp-name       as character            no-undo.
      726   define input parameter p-upper-code     as integer              no-undo.
      727   define output parameter p-error-message as character init ""    no-undo.
      728       define variable v-char-list     as character    no-undo.
      729       define variable v-char-counter  as integer      no-undo.
      730       define variable v-full-name     as character    no-undo.
      731       if p-grp-name = "" then do:
      732           assign
      733               p-error-message = "Название группы не может быть пустым.".
      734           .
      735       end.
      736       else do:
      737           assign
      738               v-char-list = "47,92,58,63,34,60,62,171,187,183"
      739           .
      740           do v-char-counter = 1 to num-entries( v-char-list )
      741           :
      742               if index( p-grp-name, chr( integer( entry( v-char-counter, v-char-list ) ) ) ) <> 0
      743               then do:
      744                   assign
      745                       p-error-message = 'Название группы не может содержать символы /\:*?"<>|«»·'
      746                   .
      747                   return.
      748               end.
      749           end.
      750           if p-upper-code > 0
      751           then do:
      752               run grplib-get-full-name in this-procedure (
      753                     input p-upper-code
      754                   , output v-full-name
      755               ) no-error .
      756               if error-status :error
      757               then do:
      758                   undo, return error "grplib-analyze-grp-name: Не удалось вычислить полное имя группы." + chr(10) + return-value.
      759               end.
      760               if length( v-full-name ) + 1 + length( p-grp-name ) > 350
      761               then do:
      762                   assign
      763                       p-error-message = 'Полное название группы не может содержать более 350 символов.'
      764                   .
      765               end.
      766           end.
      767       end.
      768   end.
      769   end procedure.
      770   procedure grplib-get-lvl-num :
      771   define input parameter p-node-code  as integer      no-undo.
      772   define output parameter p-lvl-num   as integer      no-undo.
      773       define variable v-full-name    as character    no-undo.
      774   do
      775   on error undo, return error
      776   :
      777       run grplib-get-full-name in this-procedure (
      778             input p-node-code
      779           , output v-full-name
      780       ).
      781       assign
      782           p-lvl-num = num-entries( v-full-name, chr(47) ) - 1
      783       .
      784       if p-lvl-num = -1
      785       then do:
      786           assign
      787               p-lvl-num = 0
      788           .
      789       end.
      790   end.
      791   end procedure.
      792   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      793   procedure grp-obj-write :
      794   do
      795   on error undo, return error
      796   :
      797   define input parameter p-node-code  like ub.gds-grp-obj.node-code      no-undo.
      798   define input parameter p-host-code  as integer                          no-undo.
      799   define input parameter p-obj-type   like ub.clients.obj-type            no-undo.
      800   define input parameter p-obj-code   like ub.clients.obj-code            no-undo.
      801   define input parameter p-min-increase like ub.gds-grp-obj.min-increase  no-undo.
      802   define input parameter p-max-increase like ub.gds-grp-obj.max-increase  no-undo.
      803   define input parameter p-increase-pc like ub.gds-grp-obj.increase-pc  no-undo.
      804   define input parameter p-calc-method like ub.gds-grp-obj.calc-method no-undo .
      805   define input parameter p-round-method like ub.gds-grp-obj.round-method no-undo .
      806   define input parameter p-round-coef like ub.gds-grp-obj.round-coef no-undo .
      807   define input parameter p-cli-type   like ub.clients.obj-type            no-undo.
      808   define input parameter p-cli-code   like ub.clients.obj-code            no-undo.
      809   define buffer buf_gds-grp-obj for ub.gds-grp-obj.
      810       find first buf_gds-grp-obj exclusive-lock
      811            where buf_gds-grp-obj.node-code  = p-node-code
      812              and buf_gds-grp-obj.host-code  = p-host-code
      813              and buf_gds-grp-obj.obj-type   = p-obj-type
      814              and buf_gds-grp-obj.obj-code   = p-obj-code
      815       no-error.
      816       if not available buf_gds-grp-obj
      817       then do:
      818           create buf_gds-grp-obj.
      819           assign
      820                   buf_gds-grp-obj.node-code  = p-node-code
      821                   buf_gds-grp-obj.host-code  = p-host-code
      822                   buf_gds-grp-obj.obj-type   = p-obj-type
      823                   buf_gds-grp-obj.obj-code   = p-obj-code
      824           .
      825       end.
      826       assign
      827       buf_gds-grp-obj.min-increase = p-min-increase
      828       buf_gds-grp-obj.max-increase = p-max-increase
      829       buf_gds-grp-obj.increase-pc = p-increase-pc
      830       buf_gds-grp-obj.calc-method = p-calc-method
      831       buf_gds-grp-obj.round-method = p-round-method
      832       buf_gds-grp-obj.round-coef = p-round-coef
      833       buf_gds-grp-obj.cli-type   = p-cli-type
      834       buf_gds-grp-obj.cli-code   = p-cli-code
      835       .
      836   end.
      837   end procedure.
      838   procedure grp-obj-margin-value :
      839   do
      840   on error undo, return error
      841   :
      842   define input parameter p-node-code as integer      no-undo.
      843   define input parameter p-obj-type  as character    no-undo.
      844   define input parameter p-obj-code  as integer      no-undo.
      845   define output parameter p-min-value as decimal      no-undo init ?.
      846   define output parameter p-max-value as decimal      no-undo init ?.
      847   define output parameter p-increase-pc as decimal      no-undo init ?.
      848   define output parameter p-round-method as character no-undo init "":U.
      849   define output parameter p-base as decimal no-undo init ?.
      850   define output parameter p-range-margin     as integer      no-undo.
      851   define output parameter p-exists-margin    as logical      no-undo.
      852   define output parameter p-range-increase     as integer      no-undo.
      853   define output parameter p-exists-increase    as logical      no-undo.
      854   define output parameter p-range-rmethod     as integer no-undo .
      855   define output parameter p-exists-rmethod    as logical no-undo .
      856   define variable v-host-code as integer      no-undo.
      857   DEFINE VARIABLE v-found as logical no-undo .
      858   DEFINE VARIABLE v-exists as logical no-undo .
      859   DEFINE VARIABLE v-range as integer no-undo .
      860   DEFINE VARIABLE jj as integer no-undo .
      861   DEFINE VARIABLE v-margin-found as logical no-undo .
      862   DEFINE VARIABLE v-increase-found as logical no-undo .
      863   DEFINE VARIABLE v-min-value as decimal      no-undo.
      864   DEFINE VARIABLE v-max-value as decimal      no-undo.
      865   DEFINE VARIABLE v-increase-pc as decimal      no-undo.
      866   define variable v-round-method as character no-undo .
      867   define variable v-base as decimal no-undo .
      868   define variable v-print-code as character no-undo .
      869   define buffer buf_gds-grp for ub.gds-grp.
      870   find first buf_gds-grp no-lock where
      871              buf_gds-grp.node-code = p-node-code no-error .
      872   if not avail buf_gds-grp and p-node-code <> 0 then do:
      873     message
      874       vss-workfile vss-revision vss-description
      875       skip "Не удалось найти группу товаров с кодом" p-node-code
      876       view-as alert-box error .
      877     undo, return error .
      878   end.
      879   if p-obj-type <> '' then do:
      880   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      881   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      882     (input  p-obj-type
      883     ,input  p-obj-code
      884     ,output v-host-code
      885     ) no-error .
      886     if error-status :error
      887     then do:
      888         message
      889           vss-workfile vss-revision vss-description
      890           skip "Не удалось найти фирму объекта"
      891           skip p-obj-type p-obj-code
      892           skip return-value
      893           skip trim(error-status :get-message(1))
      894               trim(error-status :get-message(2))
      895               trim(error-status :get-message(3))
      896               trim(error-status :get-message(4))
      897               trim(error-status :get-message(5))
      898         view-as alert-box error.
      899         undo, return error .
      900     end.
      901   end.
      902   define buffer buf_gds-grp-obj      for ub.gds-grp-obj.
      903   do while v-found = no and jj < 2:
      904     if v-range <> 3 then do:
      905       find first buf_gds-grp-obj no-lock
      906           where buf_gds-grp-obj.node-code = p-node-code
      907             and buf_gds-grp-obj.host-code = v-host-code
      908             and buf_gds-grp-obj.obj-type  = p-obj-type
      909             and buf_gds-grp-obj.obj-code  = p-obj-code
      910       no-error .
      911     end.
      912     if v-range = 3 or not available buf_gds-grp-obj
      913     then do:
      914        if v-range <> 2 then do:
      915           find first buf_gds-grp-obj no-lock
      916               where buf_gds-grp-obj.node-code = p-node-code
      917                 and buf_gds-grp-obj.host-code = v-host-code
      918                 and buf_gds-grp-obj.obj-type  = ""
      919                 and buf_gds-grp-obj.obj-code  = 0
      920           no-error .
      921         end.
      922         if v-range = 2 or not available buf_gds-grp-obj
      923         then do:
      924             if v-range <> 1 then do:
      925               find first buf_gds-grp-obj no-lock
      926                   where buf_gds-grp-obj.node-code = p-node-code
      927                   and buf_gds-grp-obj.host-code = 0
      928                   and buf_gds-grp-obj.obj-type  = ""
      929                   and buf_gds-grp-obj.obj-code  = 0
      930               no-error .
      931             end.
      932             if v-range = 1 or not available buf_gds-grp-obj
      933             then do:
      934                 assign
      935                     v-exists = no
      936                 .
      937             end.
      938             else do:
      939                 assign
      940                     v-exists = yes
      941                     v-range = 1
      942                 .
      943             end.
      944         end.
      945         else do:
      946             assign
      947                 v-exists = yes
      948                 v-range  = 2
      949             .
      950         end.
      951     end.
      952     else do:
      953         assign
      954             v-exists = yes
      955             v-range  = 3
      956         .
      957     end.
      958     if available buf_gds-grp-obj
      959     then do:
      960       assign
      961       v-min-value    = buf_gds-grp-obj.min-increase
      962       v-max-value    = buf_gds-grp-obj.max-increase
      963       v-increase-pc  = buf_gds-grp-obj.increase-pc
      964       v-round-method = buf_gds-grp-obj.round-method
      965       v-base         = buf_gds-grp-obj.round-coef
      966       .
      967       assign
      968       p-exists-margin = (if v-min-value <> ? and v-max-value <> ? and p-min-value = ?
      969                           then yes
      970                           else p-exists-margin)
      971       p-range-margin = if p-exists-margin and p-min-value = ?
      972                         then v-range
      973                         else p-range-margin
      974       p-min-value   =  if p-exists-margin and  p-min-value = ?
      975                         then v-min-value
      976                         else p-min-value
      977       p-max-value   =  if p-exists-margin and  p-max-value = ?
      978                         then v-max-value
      979                         else p-max-value
      980       p-exists-increase = (if v-increase-pc <> ? and p-increase-pc = ?
      981                           then yes
      982                           else p-exists-increase)
      983       p-range-increase = if p-exists-increase and p-increase-pc = ?
      984                         then v-range
      985                         else p-range-increase
      986       p-increase-pc = (if p-exists-increase and p-increase-pc = ?
      987                         then v-increase-pc
      988                         else p-increase-pc)
      989       p-exists-rmethod = if v-round-method <> "":U and p-round-method = "":U
      990                           then yes
      991                           else p-exists-rmethod
      992       p-range-rmethod = (if p-exists-rmethod and p-round-method = "":U
      993                           then v-range
      994                           else p-range-rmethod)
      995       p-round-method  = (if p-exists-rmethod and p-round-method = "":U
      996                           then v-round-method
      997                           else p-round-method)
      998       p-base          = (if p-exists-rmethod and p-base = ?
      999                           then v-base
     1000                           else p-base)
     1001       v-found =  (p-exists-margin and p-exists-increase and p-exists-rmethod) or (v-range <= 1)
     1002       jj = jj + 1
     1003       .
     1004     end.
     1005     else do:
     1006       assign
     1007       v-found =  (p-exists-margin and p-exists-increase and p-exists-rmethod ) or (v-range <= 1)
     1008       jj = jj + 1
     1009       .
     1010     end.
     1011   end.
     1012   end.
     1013   end procedure.
     1014   procedure grp-obj-income-cli-value :
     1015   do
     1016   on error undo, return error
     1017   :
     1018   define input parameter p-node-code as integer      no-undo.
     1019   define input parameter p-obj-type  as character    no-undo.
     1020   define input parameter p-obj-code  as integer      no-undo.
