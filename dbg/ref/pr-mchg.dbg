     1023   define output parameter p-range-income-cli     as integer      no-undo.
     1024   define output parameter p-exists-income-cli    as logical      no-undo.
     1025   define variable v-host-code as integer      no-undo.
     1026   DEFINE VARIABLE v-found as logical no-undo .
     1027   DEFINE VARIABLE v-exists as logical no-undo .
     1028   DEFINE VARIABLE v-range as integer no-undo .
     1029   DEFINE VARIABLE jj as integer no-undo .
     1030   DEFINE VARIABLE v-income-cli-found as logical no-undo .
     1031   DEFINE VARIABLE v-cli-type-value as char      no-undo.
     1032   DEFINE VARIABLE v-cli-code-value as int      no-undo.
     1033   define buffer buf_gds-grp for ub.gds-grp.
     1034   find first buf_gds-grp no-lock where
     1035              buf_gds-grp.node-code = p-node-code no-error .
     1036   if not avail buf_gds-grp and p-node-code <> 0 then do:
     1037     message
     1038       vss-workfile vss-revision vss-description
     1039       skip "Не удалось найти группу товаров с кодом" p-node-code
     1040       view-as alert-box error .
     1041     undo, return error .
     1042   end.
     1043   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1044   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1045     (input  p-obj-type
     1046     ,input  p-obj-code
     1047     ,output v-host-code
     1048     ) no-error .
     1049   if error-status :error
     1050   then do:
     1051       message
     1052         vss-workfile vss-revision vss-description
     1053         skip "Не удалось найти фирму объекта"
     1054         skip p-obj-type p-obj-code
     1055         skip return-value
     1056         skip trim(error-status :get-message(1))
     1057              trim(error-status :get-message(2))
     1058              trim(error-status :get-message(3))
     1059              trim(error-status :get-message(4))
     1060              trim(error-status :get-message(5))
     1061       view-as alert-box error.
     1062       undo, return error .
     1063   end.
     1064   define buffer buf_gds-grp-obj      for ub.gds-grp-obj.
     1065   do while v-found = no and jj < 2:
     1066     if v-range <> 3 then do:
     1067       find first buf_gds-grp-obj no-lock
     1068           where buf_gds-grp-obj.node-code = p-node-code
     1069             and buf_gds-grp-obj.host-code = v-host-code
     1070             and buf_gds-grp-obj.obj-type  = p-obj-type
     1071             and buf_gds-grp-obj.obj-code  = p-obj-code
     1072       no-error .
     1073     end.
     1074     if v-range = 3 or not available buf_gds-grp-obj
     1075     then do:
     1076        if v-range <> 2 then do:
     1077           find first buf_gds-grp-obj no-lock
     1078               where buf_gds-grp-obj.node-code = p-node-code
     1079                 and buf_gds-grp-obj.host-code = v-host-code
     1080                 and buf_gds-grp-obj.obj-type  = ""
     1081                 and buf_gds-grp-obj.obj-code  = 0
     1082           no-error .
     1083         end.
     1084         if v-range = 2 or not available buf_gds-grp-obj
     1085         then do:
     1086             if v-range <> 1 then do:
     1087               find first buf_gds-grp-obj no-lock
     1088                   where buf_gds-grp-obj.node-code = p-node-code
     1089                   and buf_gds-grp-obj.host-code = 0
     1090                   and buf_gds-grp-obj.obj-type  = ""
     1091                   and buf_gds-grp-obj.obj-code  = 0
     1092               no-error .
     1093             end.
     1094             if v-range = 1 or not available buf_gds-grp-obj
     1095             then do:
     1096                 assign
     1097                     v-exists = no
     1098                 .
     1099             end.
     1100             else do:
     1101                 assign
     1102                     v-exists = yes
     1103                     v-range = 1
     1104                 .
     1105             end.
     1106         end.
     1107         else do:
     1108             assign
     1109                 v-exists = yes
     1110                 v-range  = 2
     1111             .
     1112         end.
     1113     end.
     1114     else do:
     1115         assign
     1116             v-exists = yes
     1117             v-range  = 3
     1118         .
     1119     end.
     1120     if available buf_gds-grp-obj
     1121     then do:
     1122       assign
     1123       v-cli-type-value    = buf_gds-grp-obj.cli-type
     1124       v-cli-code-value    = buf_gds-grp-obj.cli-code
     1125       .
     1126       assign
     1127       p-exists-income-cli = (if v-cli-type-value <> ? and v-cli-code-value <> ? and p-cli-type = ?
     1128                           then yes
     1129                           else p-exists-income-cli)
     1130       p-range-income-cli = if p-exists-income-cli and p-cli-type = ?
     1131                         then v-range
     1132                         else p-range-income-cli
     1133       p-cli-type   =  if p-exists-income-cli and  p-cli-type = ?
     1134                         then v-cli-type-value
     1135                         else p-cli-type
     1136       p-cli-code   =  if p-exists-income-cli and  p-cli-code = ?
     1137                         then v-cli-code-value
     1138                         else p-cli-code
     1139       v-found =  (p-exists-income-cli ) or (v-range <= 1)
     1140       jj = jj + 1
     1141       .
     1142     end.
     1143     else do:
     1144       assign
     1145       v-found =  (p-exists-income-cli  ) or (v-range <= 1)
     1146       jj = jj + 1
     1147       .
     1148     end.
     1149   end.
     1150   end.
     1151   end procedure.
