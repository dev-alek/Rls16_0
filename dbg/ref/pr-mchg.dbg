     6773   FUNCTION func-cli-name RETURNS CHARACTER
     6774     ( p-type as char, p-code as int  ) :
     6775   define buffer buf_clients   for ub.clients.
     6776       find first buf_clients no-lock
     6777            where buf_clients.obj-type = p-type
     6778              and buf_clients.obj-code = p-code
     6779       no-error.
     6780       if not available buf_clients
     6781       then do:
     6782         RETURN "" .
     6783       end.
     6784       else do:
     6785          RETURN buf_clients.obj-name    .
     6786       end.
     6787   END FUNCTION.
