     1543   procedure grp-obj-notcorr-value :
     1544   do
     1545   on error undo, return error
     1546   :
     1547   define input parameter p-node-code             as integer      no-undo.
     1548   define input parameter p-obj-type              as character    no-undo.
     1549   define input parameter p-obj-code              as integer      no-undo.
     1550   define output parameter p-notcorr              as character    no-undo init ?.
     1551   define output parameter p-range-notcorr     as integer      no-undo.
     1552   define output parameter p-exists-notcorr    as logical      no-undo.
     1553   define variable v-host-code as integer      no-undo.
     1554   DEFINE VARIABLE v-found as logical no-undo .
     1555   DEFINE VARIABLE v-exists as logical no-undo .
     1556   DEFINE VARIABLE v-range as integer no-undo .
     1557   DEFINE VARIABLE jj as integer no-undo .
     1558   DEFINE VARIABLE v-notcorr-found as logical no-undo .
     1559   DEFINE VARIABLE v-notcorr-value as char      no-undo.
     1560   define buffer buf_gds-grp for ub.gds-grp.
     1561   define buffer buf_gds-grp-obj-attr for ub.gds-grp-obj-attr  .
     1562   find first buf_gds-grp no-lock where
     1563              buf_gds-grp.node-code = p-node-code no-error .
     1564   if not avail buf_gds-grp and p-node-code <> 0 then do:
     1565     message
     1566       vss-workfile vss-revision vss-description
     1567       skip "Не удалось найти группу товаров с кодом" p-node-code
     1568       view-as alert-box error .
     1569     undo, return error .
     1570   end.
     1571   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1572   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1573     (input  p-obj-type
     1574     ,input  p-obj-code
     1575     ,output v-host-code
     1576     ) no-error .
     1577   if error-status :error
     1578   then do:
     1579       message
     1580         vss-workfile vss-revision vss-description
     1581         skip "Не удалось найти фирму объекта"
     1582         skip p-obj-type p-obj-code
     1583         skip return-value
     1584         skip trim(error-status :get-message(1))
     1585       view-as alert-box error.
     1586       undo, return error .
     1587   end.
     1588   define buffer buf_gds-grp-obj      for ub.gds-grp-obj.
     1589   do while v-found = no and jj < 2:
     1590     if v-range <> 3 then do:
     1591       find first buf_gds-grp-obj no-lock
     1592           where buf_gds-grp-obj.node-code = p-node-code
     1593             and buf_gds-grp-obj.host-code = v-host-code
     1594             and buf_gds-grp-obj.obj-type  = p-obj-type
     1595             and buf_gds-grp-obj.obj-code  = p-obj-code
     1596       no-error .
     1597     end.
     1598     if v-range = 3 or not available buf_gds-grp-obj
     1599     then do:
     1600        if v-range <> 2 then do:
     1601           find first buf_gds-grp-obj no-lock
     1602               where buf_gds-grp-obj.node-code = p-node-code
     1603                 and buf_gds-grp-obj.host-code = v-host-code
     1604                 and buf_gds-grp-obj.obj-type  = ""
     1605                 and buf_gds-grp-obj.obj-code  = 0
     1606           no-error .
     1607         end.
     1608         if v-range = 2 or not available buf_gds-grp-obj
     1609         then do:
     1610             if v-range <> 1 then do:
     1611               find first buf_gds-grp-obj no-lock
     1612                   where buf_gds-grp-obj.node-code = p-node-code
     1613                   and buf_gds-grp-obj.host-code = 0
     1614                   and buf_gds-grp-obj.obj-type  = ""
     1615                   and buf_gds-grp-obj.obj-code  = 0
     1616               no-error .
     1617             end.
     1618             if v-range = 1 or not available buf_gds-grp-obj
     1619             then do:
     1620                 assign
     1621                     v-exists = no
     1622                 .
     1623             end.
     1624             else do:
     1625                 assign
     1626                     v-exists = yes
     1627                     v-range = 1
     1628                 .
     1629             end.
     1630         end.
     1631         else do:
     1632             assign
     1633                 v-exists = yes
     1634                 v-range  = 2
     1635             .
     1636         end.
     1637     end.
     1638     else do:
     1639         assign
     1640             v-exists = yes
     1641             v-range  = 3
     1642         .
     1643     end.
     1644     if available buf_gds-grp-obj
     1645     then do:
     1646       find first buf_gds-grp-obj-attr no-lock
     1647         where buf_gds-grp-obj-attr.node-code   = p-node-code
     1648           and buf_gds-grp-obj-attr.host-code   = buf_gds-grp-obj.host-code
     1649           and buf_gds-grp-obj-attr.obj-type    = buf_gds-grp-obj.obj-type
     1650           and buf_gds-grp-obj-attr.obj-code    = buf_gds-grp-obj.obj-code
     1651           and buf_gds-grp-obj-attr.attr-code   = 'NotCorrOP':U
     1652         no-error .
     1653       if available buf_gds-grp-obj-attr then do:
     1654         assign
     1655           v-notcorr-value = (if buf_gds-grp-obj-attr.attr-value = '' then ? else buf_gds-grp-obj-attr.attr-value)
     1656         .
     1657       end.
     1658       else do:
     1659         assign
     1660           v-notcorr-value = ?
     1661         .
     1662       end.
     1663       assign
     1664       p-exists-notcorr = (if v-notcorr-value <> ? and p-notcorr = ?
     1665                           then yes
     1666                           else p-exists-notcorr)
     1667       p-range-notcorr = if p-exists-notcorr and p-notcorr = ?
     1668                         then v-range
     1669                         else p-range-notcorr
     1670       p-notcorr   =  if p-exists-notcorr and  p-notcorr = ?
     1671                         then v-notcorr-value
     1672                         else p-notcorr
     1673       v-found =  (p-exists-notcorr ) or (v-range <= 1)
     1674       jj = jj + 1
     1675       .
     1676     end.
     1677     else do:
     1678       assign
     1679       v-found =  (p-exists-notcorr  ) or (v-range <= 1)
     1680       jj = jj + 1
     1681       .
     1682     end.
     1683   end.
     1684   end.
     1685   end procedure.
     1686   def var objSrv as class ibs.th.gbl.sys.objsrv no-undo.
     1687   run gbl/getobjsrvhndl.p (input-output ObjSrv).
