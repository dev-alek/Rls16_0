     5571   PROCEDURE proc-load :
     5572   define variable v-list as character no-undo.
     5573   define variable vi as integer no-undo.
     5574   define variable MarkType as ibs.th.gbl.map.mapstring no-undo.
     5575   define variable objType  as ibs.th.gbl.propmap no-undo.
     5576   MarkType = ObjSrv:Env:Marking:Types:MapType.
     5577   do vi = 1 to MarkType:GetItemByLab(vi):
     5578      objType  = ObjSrv:Env:Marking:Types:CurrProp.
     5579      v-list = v-list + "," + objType:Label_ + "," + objType:NameProp.
     5580   end.
     5581   v-list = trim(v-list, ",").
     5582   c-mark-type:list-item-pairs in frame Dialog-Frame = v-list.
     5583   v-list = "".
     5584   for each code where Code.parent eq "emc" no-lock:
     5585         v-list = v-list + "," + Code.CodeName + "," + Code.code.
     5586      end.
     5587      v-list = "," + v-list .
     5588      c-emrc-type:list-item-pairs in frame Dialog-Frame = v-list.
     5589      if p-mode = 'ДОБАВЛЕНИЕ':U OR p-mode = 'ИЗМЕНЕНИЕ':U then
     5590      do:
     5591         enable c-mark-type c-emrc-type with frame Dialog-Frame.
     5592      end.
     5593      display c-mark-type c-emrc-type with frame Dialog-Frame.
     5594      c-mark-type:visible in frame Dialog-Frame = p-option eq "global".
     5595      c-emrc-type:visible in frame Dialog-Frame = p-option eq "global".
     5596   end procedure.
     5597   PROCEDURE disable_UI :
     5598     HIDE FRAME Dialog-Frame.
     5599   END PROCEDURE.
     5600   PROCEDURE enable_UI :
     5601     DISPLAY RS-option fi-increase-pc n-marg fi-marg-min fi-marg-max S-round-method
     5602             F-base fi-cli-type fi-cli-code fi-cli-name fi-notcorr fi-alc-min-price
     5603             n-marg-pr-paraf fi-marg-pr-paraf fi-grp-name n-increase-pc l-min l-max n-rmethod
     5604             n-income-cli n-notcorr n-alc-min-price n-level-dis fill-sum-grp r-sum-grp
     5605         WITH FRAME Dialog-Frame.
     5606     ENABLE B-exit b-quit B-Help l-income-cli l-marg l-marg-pr-paraf l-rmethod l-increase-pc
     5607            l-notcorr l-alc-min-price l-level-dis BR-temp_obj-list RS-option
     5608            fi-increase-pc fi-marg-min fi-marg-max S-round-method F-base
     5609            fi-cli-type fi-cli-code r-cli fi-cli-name fi-notcorr fi-alc-min-price
     5610            br-level-dis fi-marg-pr-paraf fi-grp-name n-increase-pc l-min l-max n-rmethod
     5611            n-income-cli n-notcorr n-alc-min-price n-level-dis fill-sum-grp r-sum-grp
     5612         WITH FRAME Dialog-Frame.
     5613     VIEW FRAME Dialog-Frame.
     5614     OPEN QUERY br-level-dis FOR EACH tt-level-dis-attr NO-LOCK INDEXED-REPOSITION.    OPEN QUERY BR-temp_obj-list FOR EACH temp_obj-list.
     5615   END PROCEDURE.
     5616   PROCEDURE fill-tables :
     5617   define variable v-obj-list as character no-undo.
     5618   define variable  v-host-code like ub.sysconf.host-code no-undo .
     5619   CASE p-option:
     5620       when "global":U then do:
     5621       CASE p-mode:
     5622           when 'ИЗМЕНЕНИЕ':U then do:
     5623                       find first buf_gds-grp-obj exclusive-lock where
     5624                            buf_gds-grp-obj.node-code = p-node-code
     5625                      AND buf_gds-grp-obj.host-code = 0
     5626                      AND buf_gds-grp-obj.obj-type = "":U
     5627                      AND buf_gds-grp-obj.obj-code = 0.
     5628           end.
     5629           when 'ПРОСМОТР':U then do:
     5630                       find first buf_gds-grp-obj exclusive-lock where
     5631                            buf_gds-grp-obj.node-code = p-node-code
     5632                      AND buf_gds-grp-obj.host-code = 0
     5633                      AND buf_gds-grp-obj.obj-type = "":U
     5634                      AND buf_gds-grp-obj.obj-code = 0.
     5635           end.
     5636           END CASE.
     5637       end.
     5638       when 'фирма':U then do:
     5639       CASE p-mode:
     5640           when 'ДОБАВЛЕНИЕ':U then do:
     5641               find first buf_gds-grp-obj no-lock where
     5642                            buf_gds-grp-obj.node-code = p-node-code
     5643                      AND buf_gds-grp-obj.host-code = p-host-code
     5644                      AND buf_gds-grp-obj.obj-type = "":U
     5645                      AND buf_gds-grp-obj.obj-code = 0 no-error.
     5646              if avail buf_gds-grp-obj then do:
     5647               message
     5648               "Уже существует запись параметров группы товаров"
     5649               "для фирмы" v-host-name
     5650               view-as alert-box error.
     5651               undo, return error.
     5652             end.
     5653           end.
     5654           when 'ИЗМЕНЕНИЕ':U then do:
     5655                       find first buf_gds-grp-obj exclusive-lock where
     5656                            buf_gds-grp-obj.node-code = p-node-code
     5657                      AND buf_gds-grp-obj.host-code = p-host-code
     5658                      AND buf_gds-grp-obj.obj-type = "":U
     5659                      AND buf_gds-grp-obj.obj-code = 0.
     5660           end.
     5661           when 'ПРОСМОТР':U then do:
     5662                       find first buf_gds-grp-obj exclusive-lock where
     5663                            buf_gds-grp-obj.node-code = p-node-code
     5664                      AND buf_gds-grp-obj.host-code = p-host-code
     5665                      AND buf_gds-grp-obj.obj-type = "":U
     5666                      AND buf_gds-grp-obj.obj-code = 0.
     5667           end.
     5668           END CASE.
     5669       end.
     5670       when 'объект':U then do:
     5671       CASE p-mode:
     5672           when 'ДОБАВЛЕНИЕ':U then do:
     5673               find first buf_gds-grp-obj no-lock where
     5674                            buf_gds-grp-obj.node-code = p-node-code
     5675                      AND buf_gds-grp-obj.host-code = p-host-code
     5676                      AND buf_gds-grp-obj.obj-type = p-obj-type
     5677                      AND buf_gds-grp-obj.obj-code = p-obj-code no-error.
     5678              if avail buf_gds-grp-obj then do:
     5679               message
     5680               "Уже существует запись параметров группы товаров"
     5681               "для объекта" p-obj-type p-obj-code
     5682               view-as alert-box error.
     5683               undo, return error.
     5684             end.
     5685           end.
     5686           when 'ИЗМЕНЕНИЕ':U then do:
     5687                       find first buf_gds-grp-obj exclusive-lock where
     5688                            buf_gds-grp-obj.node-code = p-node-code
     5689                      AND buf_gds-grp-obj.host-code = p-host-code
     5690                      AND buf_gds-grp-obj.obj-type = p-obj-type
     5691                      AND buf_gds-grp-obj.obj-code = p-obj-code.
     5692           end.
     5693           when 'ПРОСМОТР':U then do:
     5694                       find first buf_gds-grp-obj exclusive-lock where
     5695                            buf_gds-grp-obj.node-code = p-node-code
     5696                      AND buf_gds-grp-obj.host-code = p-host-code
     5697                      AND buf_gds-grp-obj.obj-type = p-obj-type
     5698                      AND buf_gds-grp-obj.obj-code = p-obj-code.
     5699           end.
     5700           END CASE.
     5701       end.
     5702       when "object-list":U then do:
     5703       CASE p-mode:
     5704           when 'ДОБАВЛЕНИЕ':U
     5705           then do:
     5706   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5707   run userobjs_clear in this-procedure  .
     5708             define variable v-object-available as logical   no-undo .
     5709   define variable vss-include-info17 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5710   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run usobjava in g#library2
     5711     (input  v-cntxt-db-num
     5712     ,input  0
     5713     ,input  v-cntxt-userid
     5714     ,input  p-obj-type
     5715     ,input  p-obj-code
     5716     ,output v-object-available
     5717     )  .
     5718             if v-object-available = true
     5719             then do:
     5720   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5721   run userobjs_append in this-procedure
     5722     (input  p-obj-type
     5723     ,input  p-obj-code
     5724     )  .
     5725             end.
     5726             define variable v-user-select as logical   no-undo .
     5727   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5728   run userobjs_select-many in this-procedure
     5729     (input  parparentproc
     5730     ,input  v-cntxt-db-num
     5731     ,input  v-cntxt-userid
     5732     ,input  v-host-code
     5733     ,input  p-obj-type
     5734     ,input  p-obj-code
     5735     ,output v-user-select
     5736     )  .
     5737             if v-user-select <> true
     5738             then do:
     5739               message
     5740                 "Объект не выбран"
     5741                 view-as alert-box information .
     5742               return .
     5743             end.
     5744             define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
     5745             for each temp_obj-list:
     5746                 delete temp_obj-list.
     5747             end.
     5748             for each buf_userobjs_temp-user-obj
     5749             on error undo, return error return-value
     5750             :
     5751                 CASE buf_userobjs_temp-user-obj.obj-type:
     5752                     when 'маг':U then do:
     5753                         find first ub.shop no-lock where
     5754                                     ub.shop.obj-code = buf_userobjs_temp-user-obj.obj-code.
     5755                         assign
     5756                         v-host-code = ub.shop.host-code.
     5757                     end.
     5758                     when 'скл':U then do:
     5759                                 find first ub.store no-lock where
     5760                                     ub.store.obj-code = buf_userobjs_temp-user-obj.obj-code.
     5761                         assign
     5762                         v-host-code = ub.store.host-code.
     5763                     end.
     5764                 END CASE.
     5765                 create temp_obj-list.
     5766                 assign
     5767                     temp_obj-list.obj-type = buf_userobjs_temp-user-obj.obj-type
     5768                     temp_obj-list.obj-code = buf_userobjs_temp-user-obj.obj-code
     5769                       temp_obj-list.host-code = v-host-code
     5770                 .
     5771             end.
     5772       llist:
     5773       for each temp_obj-list:
     5774               find first buf_gds-grp-obj no-lock where
     5775                            buf_gds-grp-obj.node-code = p-node-code
     5776                      AND buf_gds-grp-obj.host-code = temp_obj-list.host-code
     5777                      AND buf_gds-grp-obj.obj-type = temp_obj-list.obj-type
     5778                      AND buf_gds-grp-obj.obj-code = temp_obj-list.obj-code no-error.
     5779              if avail buf_gds-grp-obj then do:
     5780               message
     5781               "Уже существует запись параметров группы товаров"
     5782               "для объекта" temp_obj-list.obj-type temp_obj-list.obj-code
     5783               view-as alert-box error.
     5784               delete temp_obj-list.
     5785               NEXT llist.
     5786             end.
     5787             end.
     5788           end.
     5789            END CASE.
     5790       end.
     5791   END CASE.
     5792   if available buf_gds-grp-obj then do:
     5793       assign
     5794       v-marg-min     = buf_gds-grp-obj.min-increase
     5795       v-marg-max     = buf_gds-grp-obj.max-increase
     5796       v-increase-pc  = buf_gds-grp-obj.increase-pc
     5797       v-round-method = buf_gds-grp-obj.round-method
     5798       v-base         = buf_gds-grp-obj.round-coef
     5799       v-cli-type     = buf_gds-grp-obj.cli-type
     5800       v-cli-code     = buf_gds-grp-obj.cli-code
     5801       .
     5802       run ggoattr-value (
     5803          input   p-node-code
     5804         ,input   buf_gds-grp-obj.host-code
     5805         ,input   buf_gds-grp-obj.obj-type
     5806         ,input   buf_gds-grp-obj.obj-code
     5807         ,input   'NotCorrOP':U
     5808         ,output  v-notcorr
     5809         ,output  v-type ) no-error .
     5810       run ggoattr-value (
     5811          input   p-node-code
     5812         ,input   buf_gds-grp-obj.host-code
     5813         ,input   buf_gds-grp-obj.obj-type
     5814         ,input   buf_gds-grp-obj.obj-code
     5815         ,input   'alc-min-price':U
     5816         ,output  v-alc-min-price
     5817         ,output  v-type ) no-error .
     5818       run ggoattr-value (
     5819          input   p-node-code
     5820         ,input   buf_gds-grp-obj.host-code
     5821         ,input   buf_gds-grp-obj.obj-type
     5822         ,input   buf_gds-grp-obj.obj-code
     5823         ,input   'marg-pr-paraf':U
     5824         ,output  v-marg-pr-paraf
     5825         ,output  v-type ) no-error .
     5826       run ggoattr-value (
     5827          input   p-node-code
     5828         ,input   buf_gds-grp-obj.host-code
     5829         ,input   buf_gds-grp-obj.obj-type
     5830         ,input   buf_gds-grp-obj.obj-code
     5831         ,input   'level-dis':U
     5832         ,output  v-level-dis-attr
     5833         ,output  v-type ) no-error .
     5834       run ggoattr-value (
     5835          input   p-node-code
     5836         ,input   buf_gds-grp-obj.host-code
     5837         ,input   buf_gds-grp-obj.obj-type
     5838         ,input   buf_gds-grp-obj.obj-code
     5839         ,input   'no-inc-auto-rep':U
     5840         ,output  v-no-inc-auto-rep
     5841         ,output  v-type ) no-error .
     5842       run ggoattr-value (
     5843          input   p-node-code
     5844         ,input   buf_gds-grp-obj.host-code
     5845         ,input   buf_gds-grp-obj.obj-type
     5846         ,input   buf_gds-grp-obj.obj-code
     5847         ,input   'ban-sales-via-cd':U
     5848         ,output  v-ban-sales-via-cd
     5849         ,output  v-type ) no-error .
     5850       run ggoattr-value (
     5851          input   p-node-code
     5852         ,input   buf_gds-grp-obj.host-code
     5853         ,input   buf_gds-grp-obj.obj-type
     5854         ,input   buf_gds-grp-obj.obj-code
     5855         ,input   'alchol-grp':U
     5856         ,output  v-alchol
     5857         ,output  v-type ) no-error .
     5858       run ggoattr-value (
     5859          input   p-node-code
     5860         ,input   buf_gds-grp-obj.host-code
     5861         ,input   buf_gds-grp-obj.obj-type
     5862         ,input   buf_gds-grp-obj.obj-code
     5863         ,input   'mark-grp':U
     5864         ,output  v-mark
     5865         ,output  v-type ) no-error .
     5866       run ggoattr-value (
     5867          input   p-node-code
     5868         ,input   buf_gds-grp-obj.host-code
     5869         ,input   buf_gds-grp-obj.obj-type
     5870         ,input   buf_gds-grp-obj.obj-code
     5871         ,input   'sum-grps':U
     5872         ,output  v-sum-grp
     5873         ,output  v-type ) no-error .
     5874       run ggoattr-value (
     5875          input   p-node-code
     5876         ,input   buf_gds-grp-obj.host-code
     5877         ,input   buf_gds-grp-obj.obj-type
     5878         ,input   buf_gds-grp-obj.obj-code
     5879         ,input   'gg-mark-type':U
     5880         ,output  c-mark-type
     5881         ,output  v-type ) no-error .
     5882   repeat ix = 1 to num-entries (v-level-dis-attr, chr(4)) - 1 :
     5883     create
     5884       tt-level-dis-attr
     5885     .
     5886     tt-level-dis-attr.attr-code = entry (1, entry (ix, v-level-dis-attr, chr(4)), chr(44)) .
     5887     tt-level-dis-attr.attr-value = entry (2, entry (ix, v-level-dis-attr, chr(4)), chr(44)) .
     5888   end.
     5889   end.
     5890   else do:
     5891       assign
     5892       v-marg-min      = 0
     5893       v-marg-max      = 0
     5894       v-increase-pc   = 0
     5895       v-round-method  = "":U
     5896       v-base          = 0
     5897       v-cli-type      = "":U
     5898       v-notcorr       = "":U
     5899       v-cli-code      = 0
     5900       v-alc-min-price = "":U
     5901       v-no-inc-auto-rep = "no"
     5902       v-ban-sales-via-cd = "no"
     5903       v-alchol        = "no"
     5904       v-mark          = "no"
     5905       v-sum-grp       = 0
     5906       .
     5907   end.
     5908   END PROCEDURE.
     5909   PROCEDURE MyEnable :
     5910   define variable v-value as character no-undo.
     5911   define variable v-type as character no-undo.
     5912   assign
     5913   s-round-method:list-items in frame Dialog-Frame = '9-окончание,9-99окончание,Без-дробных,Произвольно,Вверх,Коэффициент,Отключено':U.
     5914   f-base = v-base.
     5915   APPLY "VALUE-CHANGED" to s-round-method.
     5916   CASE p-mode:
     5917       when 'ДОБАВЛЕНИЕ':U then do:
     5918               assign
     5919               RS-option:radio-buttons in frame Dialog-Frame =
     5920                                                       "Фирма" + chr(32) + v-host-name + chr(44) + 'фирма':U + chr(44) +
     5921                                                       "Объект" + chr(32) + p-obj-type + string(p-obj-code) + chr(44) + 'объект':U + chr(44) +
     5922                                                       "Список объектов" + chr(44) + "object-list":U.
     5923       end.
     5924       when 'ИЗМЕНЕНИЕ':U then do:
     5925           assign
     5926       RS-option:radio-buttons = "Глобально" + chr(44) + "global":U + chr(44) +
     5927                                               "Фирма" + chr(44) + 'фирма':U + chr(44) +
     5928                                               "Объект" + chr(44) + 'объект':U .
     5929       end.
     5930       when 'ПРОСМОТР':U then do:
     5931           assign
     5932       RS-option:radio-buttons = "Глобально" + chr(44) + "global":U + chr(44) +
     5933                                               "Фирма" + chr(44) + 'фирма':U + chr(44) +
     5934                                               "Объект" + chr(44) + 'объект':U .
     5935       end.
     5936   END CASE.
     5937   assign
     5938   rs-option = p-option.
     5939   DISPLAY
     5940   n-marg
     5941   n-increase-pc
     5942   n-rmethod
     5943   n-income-cli
     5944   RS-option
     5945   v-full-name @ fi-grp-name
     5946   l-max l-min
     5947   n-notcorr
     5948   l-notcorr
     5949   n-alc-min-price
     5950   l-alc-min-price
     5951   n-level-dis
     5952   l-level-dis
     5953   n-marg-pr-paraf
     5954   n-no-inc-auto-rep
     5955   n-ban-sales-via-cd
     5956   WITH FRAME Dialog-Frame.
     5957   run Show-hide-lock in this-procedure.
     5958   ENABLE
     5959   b-quit
     5960   b-exit
     5961   B-Help
     5962   n-no-inc-auto-rep
     5963   n-ban-sales-via-cd
     5964    WITH FRAME Dialog-Frame.
     5965   if p-option = "object-list":U then do:
     5966       display
     5967       BR-temp_obj-list
     5968       with frame Dialog-Frame.
     5969       enable
     5970       BR-temp_obj-list
     5971       with frame Dialog-Frame.
     5972       OPEN QUERY br-level-dis FOR EACH tt-level-dis-attr NO-LOCK INDEXED-REPOSITION.
     5973   end.
     5974   else do:
     5975       hide
     5976   BR-temp_obj-list
     5977       in frame Dialog-Frame.
     5978   end.
     5979   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     5980     (input  'is-tm'
     5981     ,input  0
     5982     ,input  ''
     5983     ,input  0
     5984     ,input  ''
     5985     ,input  ''
     5986     ,input  ''
     5987     ,input  no
     5988     ,output v-value
     5989     ,output v-type
     5990     ) no-error .
     5991   v-value = "no".
     5992   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     5993     (input  'alcohol'
     5994     ,input  0
     5995     ,input  ''
     5996     ,input  0
     5997     ,input  ''
     5998     ,input  ''
     5999     ,input  ''
     6000     ,input  no
     6001     ,output v-value
     6002     ,output v-type
     6003     ) no-error .
     6004   if v-value = "yes" then do:
     6005       enable
     6006       n-alchol
     6007       with frame Dialog-Frame.
     6008   end.
     6009   if v-alchol = "yes" then do:
     6010       enable
     6011       n-mark
     6012       with frame Dialog-Frame.
     6013   end.
     6014   enable
     6015     fill-sum-grp
     6016     r-sum-grp
     6017     c-mark-type
     6018     with frame Dialog-Frame .
     6019   if p-mode = 'ПРОСМОТР':U then do:
     6020       disable
     6021        B-exit
     6022        B-Help
     6023        BR-temp_obj-list
     6024        RS-option
     6025        fi-increase-pc
     6026        n-marg
     6027        fi-marg-min
     6028        fi-marg-max
     6029        S-round-method
     6030        F-base
     6031        fi-cli-type
     6032        fi-cli-code
     6033        r-cli
     6034        fi-cli-name
     6035        fi-notcorr
     6036        fi-alc-min-price
     6037        br-level-dis
     6038        n-marg-pr-paraf
     6039        fi-marg-pr-paraf
     6040        fi-grp-name
     6041        n-increase-pc
     6042        l-min
     6043        l-max
     6044        n-rmethod
     6045        n-no-inc-auto-rep
     6046        n-ban-sales-via-cd
     6047        n-alchol
     6048        n-mark
     6049        fill-sum-grp
     6050        r-sum-grp
     6051        n-income-cli
     6052        n-notcorr
     6053        n-alc-min-price
     6054        n-level-dis
     6055        l-income-cli
     6056        l-marg
     6057        l-marg-pr-paraf
     6058        l-rmethod
     6059        l-increase-pc
     6060        l-notcorr
     6061        c-mark-type
     6062        l-alc-min-price
     6063        l-level-dis
     6064        B-add
     6065        B-chg
     6066        B-del  WITH FRAME Dialog-Frame.
     6067       hide
     6068        l-income-cli
     6069        l-marg
     6070        l-marg-pr-paraf
     6071        l-rmethod
     6072        l-increase-pc
     6073        l-notcorr
     6074        l-alc-min-price
     6075        l-level-dis  in frame Dialog-Frame.
     6076   end.
     6077     VIEW FRAME Dialog-Frame.
     6078   END PROCEDURE.
     6079   PROCEDURE proc-b-save :
     6080   assign
     6081   frame Dialog-Frame
     6082   n-no-inc-auto-rep
     6083   n-ban-sales-via-cd
     6084   n-alchol
     6085   n-mark
     6086   fill-sum-grp
     6087   fi-notcorr
     6088   fi-alc-min-price
     6089   fi-cli-type fi-cli-code
     6090   fi-marg-max fi-marg-min
     6091   fi-increase-pc
     6092   s-round-method
     6093   f-base
     6094   fi-marg-pr-paraf
     6095   c-mark-type
     6096   v-increase-pc  = if fi-increase-pc:sensitive
     6097                    and fi-increase-pc:visible then fi-increase-pc else ?
     6098   v-marg-min  = if fi-marg-min:sensitive
     6099                 and fi-marg-min:visible then fi-marg-min else ?
     6100   v-marg-max  = if fi-marg-max:sensitive
     6101                 and fi-marg-max:visible
     6102                 then fi-marg-max else ?
     6103   v-round-method = if s-round-method:sensitive
     6104                    and s-round-method:visible
     6105                    then s-round-method else "":U
     6106   v-base         = if lookup(v-round-method, 'Произвольно,Вверх,Коэффициент,9-99окончание':U) > 0
     6107                     then f-base
     6108                     else 0
     6109   v-cli-type   =  if fi-cli-type:sensitive
     6110                   and fi-cli-type:visible
     6111                   then fi-cli-type else "":U
     6112   v-cli-code   =  if fi-cli-code:sensitive
     6113                   and fi-cli-code:visible
     6114                   then fi-cli-code else 0
     6115   v-notcorr   =  if fi-notcorr:sensitive
     6116                   and fi-notcorr:visible
     6117                   then fi-notcorr else "":U
     6118   .
     6119   v-alc-min-price =  if  fi-alc-min-price:sensitive
     6120                      and fi-alc-min-price:visible
     6121                     then fi-alc-min-price else "":U
     6122   .
     6123   v-marg-pr-paraf =  if  fi-marg-pr-paraf:sensitive
     6124                      and fi-marg-pr-paraf:visible
     6125                     then string (fi-marg-pr-paraf) else "":U
     6126   .
     6127   if br-level-dis:sensitive and br-level-dis:visible
     6128   then do:
     6129     assign
     6130       v-level-dis-attr = ""
     6131     .
     6132     for each tt-level-dis-attr  :
     6133       assign
     6134         v-level-dis-attr = v-level-dis-attr + tt-level-dis-attr.attr-code + chr(44) + tt-level-dis-attr.attr-value + chr(4)
     6135       .
     6136     end.
     6137   end.
     6138   else do:
     6139     assign
     6140       v-level-dis-attr = ""
     6141     .
     6142   end.
     6143   run create-attr in this-procedure ( input v-marg-min
     6144                                      ,input v-marg-max
     6145                                      ,input v-increase-pc
     6146                                      ,input v-round-method
     6147                                      ,input v-base
     6148                                      ,input v-cli-type
     6149                                      ,input v-cli-code
     6150                                      ,input v-notcorr
     6151                                      ,input v-alc-min-price
     6152                                      ,input v-marg-pr-paraf
     6153                                      ,input v-level-dis-attr
     6154                                      ,input string(n-no-inc-auto-rep)
     6155                                      ,input string(n-ban-sales-via-cd)
     6156                                      ,input string(n-alchol)
     6157                                      ,input string(n-mark)
     6158                                      ,input fill-sum-grp
     6159                                      ,input c-mark-type
     6160                                      ,input c-emrc-type
     6161                                     ) no-error.
     6162   if error-status:error then do:
     6163      message error-status :get-message(1) .
     6164      undo, return error.
     6165   end.
     6166   END PROCEDURE.
     6167   PROCEDURE show-hide-lock :
     6168   v-cli-name = func-cli-name (v-cli-type,v-cli-code) .
     6169   CASE p-mode:
     6170     when 'ИЗМЕНЕНИЕ':U or when 'ПРОСМОТР':U then do:
     6171       if v-marg-min <> ? and v-marg-max <> ? then do:
     6172         display
     6173         v-marg-min @ fi-marg-min
     6174         v-marg-max @ fi-marg-max
     6175         with frame Dialog-Frame
     6176         .
     6177         ENABLE
     6178         fi-marg-max
     6179         fi-marg-min
     6180         with frame Dialog-Frame
     6181         .
     6182         hide
     6183         l-marg
     6184         in frame Dialog-Frame
     6185         .
     6186       end.
     6187       else do:
     6188         hide
     6189         fi-marg-max
     6190         fi-marg-min
     6191         in frame Dialog-Frame
     6192         .
     6193         ENABLE
     6194         l-marg
     6195         with frame Dialog-Frame.
     6196         display
     6197         l-marg
     6198         with frame Dialog-Frame.
     6199       end.
     6200       if v-increase-pc <> ? then do:
     6201         display
     6202         v-increase-pc @ fi-increase-pc
     6203         with frame Dialog-Frame
     6204         .
     6205         ENABLE
     6206         fi-increase-pc
     6207         with frame Dialog-Frame
     6208         .
     6209         assign
     6210         n-increase-pc:fgcolor = ?
     6211         .
     6212         hide
     6213         l-increase-pc
     6214         in frame Dialog-Frame
     6215         .
     6216       end.
     6217       else do:
     6218         hide
     6219         fi-increase-pc
     6220         in frame Dialog-Frame
     6221         .
     6222         ENABLE
     6223         l-increase-pc
     6224         with frame Dialog-Frame.
     6225         display
     6226         l-increase-pc
     6227         with frame Dialog-Frame.
     6228       end.
     6229       if v-round-method <> "":U then do:
     6230         assign
     6231         s-round-method:screen-value = v-round-method
     6232         .
     6233         ENABLE
     6234         s-round-method
     6235         with frame Dialog-Frame
     6236         .
     6237         assign
     6238         n-rmethod:fgcolor = ?
     6239         .
     6240         hide
     6241         l-rmethod
     6242         in frame Dialog-Frame
     6243         .
     6244         APPLY "VALUE-CHANGED" to s-round-method.
     6245       end.
     6246       else do:
     6247         APPLY "VALUE-CHANGED" to s-round-method.
     6248         hide
     6249         s-round-method
     6250         in frame Dialog-Frame
     6251         .
     6252         ENABLE
     6253         l-rmethod
     6254         with frame Dialog-Frame.
     6255         display
     6256         l-rmethod
     6257         with frame Dialog-Frame.
     6258       end.
     6259       if v-cli-type <> "" and v-cli-code <> 0 then do:
     6260         display
     6261         v-cli-type @ fi-cli-type
     6262         v-cli-code @ fi-cli-code
     6263         v-cli-name @ fi-cli-name
     6264         with frame Dialog-Frame
     6265         .
     6266         ENABLE
     6267         fi-cli-type
     6268         fi-cli-code
     6269         r-cli
     6270         fi-cli-name
     6271         with frame Dialog-Frame
     6272         .
     6273         hide
     6274         l-income-cli
     6275         in frame Dialog-Frame
     6276         .
     6277       end.
     6278       else do:
     6279         hide
     6280         fi-cli-type
     6281         fi-cli-code
     6282         r-cli
     6283         fi-cli-name
     6284         in frame Dialog-Frame
     6285         .
     6286         ENABLE
     6287         l-income-cli
     6288         with frame Dialog-Frame.
     6289         display
     6290         l-income-cli
     6291         with frame Dialog-Frame.
     6292       end.
     6293       if v-notcorr <> ""  then do:
     6294         fi-notcorr = v-notcorr .
     6295         display
     6296          fi-notcorr
