     4858                  define buffer buf_goods-attr for ub.goods-attr .
     4859                  define buffer buf_goods      for ub.goods .
     4860                  define variable v-ask        as character no-undo .
     4861                  define variable v-price-emc  as decimal   no-undo .
     4862                  define variable v-value-emrc as character no-undo .
     4863                  define variable v-type-emrc  as character no-undo .
     4864                  define variable v-del        as logical   no-undo .
     4865                  define variable choice       as integer   no-undo .
     4866                  empty temp-table tt-goods .
     4867                  for each buf_goods no-lock where buf_goods.grp-code = p-node-code:
     4868                     run gds-attr-value (
     4869                        input   buf_goods.gds-code
     4870                        ,input   'emrc-type':U
     4871                        ,output   v-value-emrc
     4872                        ,output   v-type-emrc
     4873                        ) no-error .
     4874                     if v-value-emrc <> v-emrc-type then
     4875                     do:
     4876                        create tt-goods .
     4877                        buffer-copy buf_goods to tt-goods .
     4878                        for first ub.Code where ub.Code.parent = "emc" and
     4879                           ub.Code.Code = v-value-emrc no-lock:
     4880                           tt-goods.emrc = ub.Code.CodeName .
     4881                        end.
     4882                     end.
     4883                  end.
     4884                  if can-find (first tt-goods) then
     4885                  do:
     4886                     run ref/emrc-mes.w (input parparentproc,
     4887                        input table tt-goods,
     4888                        output v-ask)  .
     4889                  end.
     4890                  case v-ask:
     4891                     when "cancel" then
     4892                        do:
     4893                           leave .
     4894                        end.
     4895                     when "true" then
     4896                        do:
     4897                           for each tt-goods:
     4898                              run gds-attr-delete IN THIS-PROCEDURE(
     4899                                 input tt-goods.gds-code
     4900                                 ,INPUT 'emrc-type':U
     4901                                 ,output v-del ) .
     4902                           end.
     4903                        end.
     4904                     when "false" then
     4905                        do:
     4906                        end.
     4907                  end case .
     4908                  find last ub.Code no-lock where ub.Code.parent = "emc" + chr(4) + v-emrc-type and
     4909                     ub.Code.status_ = 0 and ub.Code.code <= iso-date(today) no-error .
     4910                  if available (ub.Code) then
     4911                  do:
     4912                     run gbl/d-askw.w (
     4913                        input "Вопрос"
     4914                        ,input  "Проверить цены товара на соответствие ЕМЦ?"
     4915                        ,input "|"
     4916                        ,input "Да|Нет"
     4917                        ,input "Установить ЕМЦ и провести проверку по всем объектам|Установить ЕМЦ без проверки"
     4918                        ,input 1
     4919                        ,input 2
     4920                        ,output choice).
     4921                     if choice = 1 then
     4922                     do:
     4923                        v-price-emc = decimal(ub.Code.CodeValue) .
     4924                        for each buf_clients no-lock where buf_clients.host-code = v-cntxt-host-code-obj and
     4925                           buf_clients.obj-type = 'маг':U:
     4926                           for each buf_goods no-lock where buf_goods.grp-code = p-node-code,
     4927                              last ub.price-all no-lock where ub.price-all.gds-code = buf_goods.gds-code and
     4928                              ub.price-all.obj-code = buf_clients.obj-code and
     4929                              ub.price-all.obj-type = buf_clients.obj-type and
     4930                              ub.price-all.main-indication = 0 and
     4931                              ub.price-all.type-price = 0:
     4932                              if ub.price-all.price-sale < v-price-emc then
     4933                              do:
     4934                                 create tt-emc-price .
     4935                                 assign
     4936                                    tt-emc-price.gds-name = buf_goods.gds-name
     4937                                    tt-emc-price.gds-code = buf_goods.gds-code
     4938                                    tt-emc-price.price    = ub.price-all.price-sale
     4939                                    tt-emc-price.obj-code = buf_clients.obj-code
     4940                                    tt-emc-price.obj-type = buf_clients.obj-type
     4941                                    .
     4942                              end.
     4943                           end.
     4944                        end.
     4945                        if can-find (first tt-emc-price) then
     4946                        do:
     4947                           run print-list (input v-price-emc,
     4948                              input table tt-emc-price).
     4949                        end.
     4950                        else
     4951                        do:
     4952                           message "Несоответствий товаров по ЕМЦ - не найдено."
     4953                              view-as alert-box.
     4954                        end.
     4955                     end.
     4956                  end.
     4957                  else
     4958                  do:
     4959                     if c-emrc-type <> "" then
     4960                     do:
     4961                        find last ub.Code no-lock where ub.Code.parent = "emc" + chr(4) + v-emrc-type and
     4962                           ub.Code.status_ = 0 and ub.Code.code > iso-date(today) no-error .
     4963                        if available (ub.Code) then
     4964                        do:
     4965                           message "Для выбранного типа ЕМЦ установлено ограничение, которое станет активным только с " ub.Code.misc1
     4966                              view-as alert-box.
     4967                        end.
     4968                        else
