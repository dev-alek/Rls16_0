     1205         where buf_userobjs_temp-user-obj.obj-type = p-obj-type
     1206           and buf_userobjs_temp-user-obj.obj-code = p-obj-code
     1207         no-error .
     1208       if not available buf_userobjs_temp-user-obj
     1209       then do:
     1210         create buf_userobjs_temp-user-obj .
     1211         assign
     1212           buf_userobjs_temp-user-obj.obj-type = p-obj-type
     1213           buf_userobjs_temp-user-obj.obj-code = p-obj-code
