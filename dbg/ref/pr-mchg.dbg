     2486        VIEW-AS TOGGLE-BOX
     2487        SIZE 40 BY 1
     2488        FGCOLOR 3  NO-UNDO.
     2489   DEFINE VARIABLE n-mark AS LOGICAL INITIAL no
     2490        LABEL "По умолчанию обязательная маркировка"
     2491        VIEW-AS TOGGLE-BOX
     2492        SIZE 40 BY 1
     2493        FGCOLOR 3  NO-UNDO.
     2494   DEFINE VARIABLE n-no-inc-auto-rep AS LOGICAL INITIAL no
     2495        LABEL "Не учитывать в автоматической отчетности"
     2496        VIEW-AS TOGGLE-BOX
     2497        SIZE 45 BY 1
     2498        FGCOLOR 3  NO-UNDO.
     2499   DEFINE QUERY br-level-dis FOR
     2500         tt-level-dis-attr SCROLLING.
     2501   DEFINE QUERY BR-temp_obj-list FOR
     2502         temp_obj-list SCROLLING.
     2503   DEFINE BROWSE br-level-dis
     2504     QUERY br-level-dis NO-LOCK DISPLAY
     2505         tt-level-dis-attr.attr-code COLUMN-LABEL "Интервал" FORMAT "X(15)":U
     2506         tt-level-dis-attr.attr-value COLUMN-LABEL "% Наценки" FORMAT "X(15)":U
     2507       WITH NO-ROW-MARKERS SEPARATORS SIZE 31.5 BY 4.5 FIT-LAST-COLUMN.
     2508   DEFINE BROWSE BR-temp_obj-list
     2509     QUERY BR-temp_obj-list DISPLAY
     2510         temp_obj-list.obj-type  + chr(32) + string(temp_obj-list.obj-code)
     2511       WITH NO-LABELS NO-ROW-MARKERS SEPARATORS SIZE 15 BY 9.58
     2512            TITLE "Список объектов".
     2513   DEFINE FRAME Dialog-Frame
     2514        B-exit AT ROW 1 COL 1
     2515        b-quit AT ROW 1 COL 11
     2516        B-Help AT ROW 1 COL 57
     2517        n-no-inc-auto-rep AT ROW 3 COL 65
     2518        n-ban-sales-via-cd AT ROW 4 COL 65
     2519        BR-temp_obj-list AT ROW 4.13 COL 47.63
     2520        RS-option AT ROW 4.17 COL 2 NO-LABEL
     2521        n-alchol AT ROW 6 COL 65
     2522        n-mark AT ROW 7 COL 65
     2523        fill-sum-grp AT ROW 8 COL 88.38 COLON-ALIGNED
     2524        r-sum-grp AT ROW 8 COL 101.13
     2525        fi-increase-pc AT ROW 8.67 COL 31.88 RIGHT-ALIGNED NO-LABEL
     2526        c-mark-type AT ROW 9.33 COL 79 COLON-ALIGNED WIDGET-ID 50
     2527        c-EMRC-type AT ROW 10.5 COL 79 COLON-ALIGNED WIDGET-ID 50
     2528        n-marg AT ROW 10.29 COL 2.13 NO-LABEL
     2529        fi-marg-min AT ROW 10.38 COL 32.13 RIGHT-ALIGNED NO-LABEL
     2530        fi-marg-max AT ROW 11.38 COL 32.13 RIGHT-ALIGNED NO-LABEL
     2531        S-round-method AT ROW 13.08 COL 23.13 NO-LABEL
     2532        F-base AT ROW 15.38 COL 42.63 COLON-ALIGNED NO-LABEL
     2533        fi-cli-type AT ROW 19.42 COL 24.88 RIGHT-ALIGNED NO-LABEL
     2534        fi-cli-code AT ROW 19.42 COL 31.25 RIGHT-ALIGNED NO-LABEL
     2535        r-cli AT ROW 19.42 COL 32.5
     2536        fi-cli-name AT ROW 19.42 COL 62.38 RIGHT-ALIGNED NO-LABEL
     2537        fi-notcorr AT ROW 20.75 COL 36.5 COLON-ALIGNED NO-LABEL WIDGET-ID 8
     2538        fi-alc-min-price AT ROW 21.75 COL 62.5 RIGHT-ALIGNED NO-LABEL WIDGET-ID 12
     2539        br-level-dis AT ROW 24 COL 1.13 WIDGET-ID 200
     2540        n-marg-pr-paraf AT ROW 24 COL 36.5 NO-LABEL WIDGET-ID 44
     2541        fi-marg-pr-paraf AT ROW 24 COL 62 RIGHT-ALIGNED NO-LABEL
     2542        B-add AT ROW 28.54 COL 2 WIDGET-ID 12
     2543        B-chg AT ROW 28.54 COL 12 WIDGET-ID 14
     2544        B-del AT ROW 28.54 COL 22 WIDGET-ID 16
     2545        fi-grp-name AT ROW 3.08 COL 2 COLON-ALIGNED NO-LABEL
     2546        n-increase-pc AT ROW 8.63 COL 2 NO-LABEL
     2547        l-min AT ROW 10.25 COL 35.5 COLON-ALIGNED NO-LABEL
     2548        l-max AT ROW 11.5 COL 35.5 COLON-ALIGNED NO-LABEL
     2549        n-rmethod AT ROW 13.08 COL 5.88 NO-LABEL
     2550        n-income-cli AT ROW 19.42 COL 1.13 NO-LABEL
     2551        n-notcorr AT ROW 20.63 COL 1.13 NO-LABEL WIDGET-ID 6
     2552        n-alc-min-price AT ROW 21.75 COL 1 NO-LABEL WIDGET-ID 10
     2553        n-level-dis AT ROW 23 COL 1.13 NO-LABEL
     2554        l-income-cli AT ROW 19.42 COL 64
     2555        l-marg AT ROW 10.71 COL 34.75
     2556        l-marg-pr-paraf AT ROW 24 COL 64
     2557        l-rmethod AT ROW 13.17 COL 44.13
     2558        l-increase-pc AT ROW 8.63 COL 34.75
     2559        l-notcorr AT ROW 20.75 COL 46.5 WIDGET-ID 4
     2560        l-alc-min-price AT ROW 21.75 COL 64 WIDGET-ID 16
     2561        l-level-dis AT ROW 23 COL 28 WIDGET-ID 42
     2562        SPACE(79.12) SKIP(5.55)
     2563       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     2564            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     2565            TITLE "Параметры на объектах для группы товаров"
     2566            DEFAULT-BUTTON B-exit CANCEL-BUTTON b-quit.
     2567   ASSIGN
     2568          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     2569          FRAME Dialog-Frame:HIDDEN           = TRUE.
     2570   ASSIGN
     2571          n-marg:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
     2572   ASSIGN
     2573          n-marg-pr-paraf:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
     2574   ON GO OF FRAME Dialog-Frame
     2575   DO:
     2576     run proc-b-save in this-procedure no-error.
     2577     if error-status:error then return no-apply.
     2578   END.
     2579   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     2580   DO:
     2581     APPLY "END-ERROR":U TO SELF.
     2582   END.
     2583   ON CHOOSE OF B-add IN FRAME Dialog-Frame
     2584   DO :
     2585    define variable v-pole1 as character no-undo .
     2586    define variable v-pole2 as character no-undo .
     2587     run str/lvldsc.w ( input-output v-pole1 , input-output v-pole2 ) .
     2588     create tt-level-dis-attr.
     2589     assign
     2590       tt-level-dis-attr.attr-code  = v-pole1
     2591       tt-level-dis-attr.attr-value = v-pole2
     2592     no-error
     2593     .
     2594     if error-status :error then do:
     2595       message
     2596         "Пороговая наценка," skip
     2597         "где интервал " v-pole1 skip
     2598         "наценка " v-pole2 "," skip
     2599         "уже есть."
     2600       view-as alert-box error.
     2601       delete tt-level-dis-attr.
     2602     end.
     2603     else do:
     2604       OPEN QUERY br-level-dis FOR EACH tt-level-dis-attr NO-LOCK INDEXED-REPOSITION.    OPEN QUERY BR-temp_obj-list FOR EACH temp_obj-list.
     2605     end.
     2606   END.
     2607   ON RIGHT-MOUSE-CLICK OF br-level-dis IN FRAME Dialog-Frame
     2608   DO:
     2609       assign
     2610       n-level-dis:fgcolor = 3
     2611       l-level-dis:visible = true
     2612       .
     2613       for each tt-level-dis-attr.
     2614         delete tt-level-dis-attr.
     2615       end.
     2616       hide
     2617       br-level-dis
     2618       B-add
     2619       B-chg
     2620       B-del
     2621       in frame Dialog-Frame.
     2622       ENABLE l-level-dis
     2623       with frame Dialog-Frame.
     2624   END.
     2625   ON RIGHT-MOUSE-CLICK OF fi-marg-pr-paraf IN FRAME Dialog-Frame
     2626   DO:
     2627       assign
     2628       n-marg-pr-paraf:fgcolor = 15
     2629       l-marg-pr-paraf:visible = true
     2630       v-marg-pr-paraf = '':U
     2631       .
     2632       hide
     2633       fi-marg-pr-paraf
     2634       in frame Dialog-Frame.
     2635       ENABLE l-marg-pr-paraf
     2636       with frame Dialog-Frame.
     2637   END.
     2638   ON ENTRY OF fi-marg-max IN FRAME Dialog-Frame
     2639   DO:
     2640   assign
     2641       v-old-value = fi-marg-max:screen-value
     2642   .
     2643   END.
