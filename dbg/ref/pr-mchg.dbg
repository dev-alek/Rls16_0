     3025   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3026   on help of frame Dialog-Frame
     3027   do:
     3028     run gbl/app_help.p
     3029       (input this-procedure :file-name
     3030       ,input ''
     3031       ,input ?
     3032       ) no-error.
     3033     if error-status :error then do:
     3034       message
     3035         "Ошибка при вызове помощи"
     3036         error-status :get-message(1)
     3037         view-as alert-box .
     3038     end.
     3039   end.
     3040   run minbtn-set in this-procedure .
     3041   on choose of b-help in frame Dialog-Frame
     3042   do:
     3043     apply "help":u to frame Dialog-Frame .
     3044   end.
     3045   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3046   procedure minbtn-set :
     3047       do
     3048           on error undo, return error return-value
     3049           :
     3050           define variable ii              as integer       no-undo .
     3051           define variable fh              as widget-handle no-undo .
     3052           define variable hh              as widget-handle no-undo .
     3053           define variable v-h             as handle        extent 4 no-undo .
     3054           define variable v-name-button   as character     no-undo .
     3055           define variable v-help-old-x    as decimal       no-undo .
     3056           define variable v-help-old-y    as decimal       no-undo .
     3057           define variable v-help-old-size as decimal       no-undo .
     3058           define variable v-frame-width   as decimal       no-undo .
     3059           define variable jj              as integer       no-undo .
     3060           do
     3061               on error undo, return error
     3062               :
     3063               assign
     3064                   v-frame-width = frame Dialog-Frame:width - 0.3
     3065                   fh            = frame Dialog-Frame:first-child
     3066                   hh            = fh:first-child
     3067                   ii            = 1
     3068                   .
     3069               do while valid-handle(hh):
     3070                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     3071                   do:
     3072                       case lc(hh:name) :
     3073                           when "b-help" then
     3074                               do:
     3075                                   hh:load-image-up("cmp/b-help.bmp":u) .
     3076                                   hh:load-image-down("cmp/b-help.bmp":u) .
     3077                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     3078                                   hh:TOOLTIP = "Помощь" .
     3079                                   v-help-old-x = hh:column .
     3080                                   v-help-old-y = hh:row    .
     3081                                   v-help-old-size = hh:width .
     3082                                   hh:width-chars = 2.5 .
     3083                               end.
     3084                           when "b-print" then
     3085                               do:
     3086                                   hh:load-image("cmp/b-print.bmp":u) .
     3087                                   hh:TOOLTIP = "Печать" .
     3088                                   v-h[ii] = hh:handle .
     3089                                   ii = ii + 1 .
     3090                                   hh:width-chars = 3 .
     3091                               end.
     3092                           when "b-history" or
     3093                           when "b-hist" then
     3094                               do:
     3095                                   hh:load-image("cmp/b-hist.bmp":u) .
     3096                                   hh:TOOLTIP = "История" .
     3097                                   v-h[ii] = hh:handle .
     3098                                   ii = ii + 1 .
     3099                                   hh:width-chars = 3 .
     3100                               end.
     3101                           when "b-sch" then
     3102                               do:
     3103                                   hh:load-image("cmp/b-sch.bmp":u) .
     3104                                   hh:TOOLTIP = "Установка Фильтра" .
     3105                                   v-h[ii] = hh:handle .
     3106                                   ii = ii + 1 .
     3107                                   hh:width-chars = 3 .
     3108                               end.
     3109                           when "b-hist-user" then
     3110                               do:
     3111                                   hh:load-image("cmp/b-hist.bmp":u) .
     3112                                   hh:TOOLTIP = "История пользователя" .
     3113                                   ii = ii + 1 .
     3114                               end.
     3115                       end case.
     3116                   end.
     3117                   hh = hh:next-sibling.
     3118               end.
     3119               b-help:column = v-frame-width - b-help:width-chars.
     3120               jj = 0.
     3121               repeat ii = 4 to 1 by -1 :
     3122                   if valid-handle (v-h[ii] ) then
     3123                   do:
     3124                       jj  = jj + 1 .
     3125                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     3126                       v-h[ii]:row    = v-help-old-y .
     3127                   end.
     3128               end.
     3129           end.
     3130       end.
     3131   end procedure.
     3132   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     3133   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     3134   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     3135   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     3136   define variable v-diasize-current-frame-width  as decimal   no-undo .
     3137   define variable v-diasize-current-frame-height as decimal   no-undo .
     3138   define variable v-diasize-change-size          as logical   no-undo .
     3139   define variable v-diasize-resize-button        as handle    no-undo .
     3140   define variable v-diasize-wndmax               as logical   no-undo .
     3141   define variable v-diasize-wndstore             as logical   no-undo .
     3142   define variable v-diasize-proc-name            as character no-undo .
     3143   define variable v-diasize-browse-handle        as handle    no-undo .
     3144   define variable v-diasize-browse-number        as integer   no-undo .
     3145   define variable v-diasize-need-full-display    as logical   no-undo init false .
     3146   define temp-table temp-diasize-handle no-undo
     3147     field handle-value  as handle
     3148     field save-position as decimal
     3149     index xpk is primary unique handle-value
     3150     .
     3151   define temp-table temp-browse-handle no-undo
     3152     field browse-type   as character
     3153     field browse-number as integer
     3154     field browse-handle as handle
     3155     field original-size as decimal
     3156     index xpk is primary unique browse-type browse-number
     3157     index xie browse-type browse-handle
     3158   .
     3159   procedure diasize_change-height :
     3160     define input  parameter p-change-value  as decimal   no-undo .
     3161     define input  parameter p-move-resize   as logical   no-undo .
     3162     define variable v-field-group-handle    as handle    no-undo .
     3163     define variable v-object-handle         as handle    no-undo .
     3164     define variable v-frame-height          as decimal   no-undo .
     3165     define variable v-frame-virtual-height  as decimal   no-undo .
     3166     define variable v-browse-height         as decimal   no-undo .
     3167     define variable v-window-height         as decimal   no-undo .
     3168     define variable v-window-virtual-height as decimal   no-undo .
     3169     define variable v-change-sign           as integer   no-undo .
     3170     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     3171     define buffer buf_temp-browse-handle  for temp-browse-handle .
     3172     if p-change-value > 0
     3173     then do:
     3174       if frame Dialog-Frame :height + p-change-value
     3175           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     3176       then do:
     3177         assign
     3178           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     3179                           - (frame Dialog-Frame :height-chars)
     3180         .
     3181         if p-change-value <= 0
     3182         then do:
     3183           run diasize_position-resize-button in this-procedure .
     3184           return .
     3185         end.
     3186       end.
     3187     end.
     3188     if p-change-value < 0
     3189     then do:
     3190       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     3191       then do:
     3192         assign
     3193           p-change-value = v-diasize-orig-frame-height
     3194                          - (frame Dialog-Frame :height-chars)
     3195         .
     3196         if p-change-value >= 0
     3197         then do:
     3198           run diasize_position-resize-button in this-procedure .
     3199           return .
     3200         end.
     3201       end.
     3202     end.
     3203     if p-change-value >= 0
     3204     then do:
     3205       assign
     3206         v-change-sign = 1
     3207       .
     3208     end.
     3209     else do:
     3210       assign
     3211         v-change-sign = -1
     3212       .
     3213     end.
     3214     assign
     3215       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     3216     .
     3217     if p-change-value = 0
     3218     then do:
     3219       run diasize_position-resize-button in this-procedure .
     3220       return .
     3221     end.
     3222     move_block:
     3223     do
     3224     on error undo move_block, retry move_block
     3225     :
     3226       if retry
     3227       then do:
     3228         do
     3229         on error undo move_block, leave move_block
     3230         :
     3231           if p-change-value > 0
     3232           then do:
     3233             for each buf_temp-diasize-handle
     3234             on error undo, next
     3235             :
     3236               assign
     3237                 v-object-handle = buf_temp-diasize-handle.handle-value
     3238               .
     3239               if v-object-handle <> v-diasize-resize-button
     3240               then do:
     3241                 assign
     3242                   v-object-handle :row = buf_temp-diasize-handle.save-position
     3243                 .
     3244               end.
     3245             end.
     3246             assign
     3247               v-diasize-browse-handle :height = v-browse-height
     3248             .
     3249             for each buf_temp-browse-handle
     3250               where buf_temp-browse-handle.browse-type = 'height':u
     3251             on error undo, next
     3252             :
     3253               assign
     3254                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     3255               .
     3256             end.
     3257             assign
     3258               frame Dialog-Frame :height = v-frame-height
     3259             .
     3260             if frame Dialog-Frame :scrollable = true
     3261             then do:
     3262               assign
     3263                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     3264               .
     3265             end.
     3266             run diasize_position-resize-button in this-procedure .
     3267           end.
     3268           else do:
     3269             if frame Dialog-Frame :scrollable = true
     3270             then do:
     3271               assign
     3272                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     3273               .
     3274             end.
     3275             assign
     3276               frame Dialog-Frame :height = v-frame-height
     3277             .
     3278             assign
     3279               v-diasize-browse-handle :height = v-browse-height
     3280             .
     3281             for each buf_temp-browse-handle
     3282               where buf_temp-browse-handle.browse-type = 'height':u
     3283             on error undo, next
     3284             :
     3285               assign
     3286                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     3287               .
     3288             end.
     3289             for each buf_temp-diasize-handle
     3290             on error undo, next
     3291             :
     3292               assign
     3293                 v-object-handle = buf_temp-diasize-handle.handle-value
     3294               .
     3295               if v-object-handle <> v-diasize-resize-button
     3296               then do:
     3297                 assign
     3298                   v-object-handle :row = buf_temp-diasize-handle.save-position
     3299                 .
     3300               end.
     3301             end.
     3302             run diasize_position-resize-button in this-procedure .
     3303           end.
     3304           assign
     3305             v-diasize-change-size = false
     3306           .
     3307           leave move_block .
     3308         end.
     3309       end.
     3310       assign
     3311         v-diasize-need-full-display = true
     3312       .
     3313       if v-diasize-change-size = false
     3314       then do:
     3315         assign
     3316           v-diasize-change-size = true
     3317         .
     3318       end.
     3319       else do:
     3320         return .
     3321       end.
     3322       assign
     3323         v-frame-height = frame Dialog-Frame :height
     3324         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     3325         v-browse-height = v-diasize-browse-handle :height
     3326       .
     3327       for each buf_temp-browse-handle
     3328         where buf_temp-browse-handle.browse-type = 'height':u
     3329       :
     3330         assign
     3331           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     3332         .
     3333       end.
     3334       for each buf_temp-diasize-handle
     3335       :
     3336         delete buf_temp-diasize-handle .
     3337       end.
     3338       assign
     3339         v-field-group-handle = frame Dialog-Frame :first-child
     3340       .
     3341       do while valid-handle(v-field-group-handle)
     3342       :
     3343         assign
     3344           v-object-handle = v-field-group-handle :first-child
     3345         .
     3346         do while valid-handle(v-object-handle)
     3347         :
     3348           if  v-object-handle <> v-diasize-browse-handle :handle
     3349           and can-query(v-object-handle, "row")
     3350           and can-query(v-object-handle, "height")
     3351           and ( v-object-handle :row > v-diasize-browse-handle :row )
     3352           then do:
     3353             find first buf_temp-browse-handle
     3354               where buf_temp-browse-handle.browse-type   = 'height':u
     3355                 and buf_temp-browse-handle.browse-handle = v-object-handle
     3356               no-error .
     3357             if available buf_temp-browse-handle
     3358             then do:
     3359             end.
     3360             else do:
     3361               create buf_temp-diasize-handle .
     3362               assign
     3363                 buf_temp-diasize-handle.handle-value  = v-object-handle
     3364                 buf_temp-diasize-handle.save-position = v-object-handle :row
     3365               .
     3366             end.
     3367           end.
     3368           assign
     3369             v-object-handle = v-object-handle :next-sibling
     3370           .
     3371         end.
     3372         assign
     3373           v-field-group-handle = v-field-group-handle :next-sibling
     3374         .
     3375       end.
     3376       do with frame Dialog-Frame
     3377       :
     3378         hide v-diasize-resize-button .
     3379         assign
     3380           v-diasize-resize-button :row    = 1
     3381           v-diasize-resize-button :column = 1
     3382         .
     3383       end.
     3384       if p-change-value > 0
     3385       then do:
     3386         if frame Dialog-Frame :scrollable = true
     3387         then do:
     3388           assign
     3389             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     3390             no-error .
     3391           if error-status :error
     3392           or error-status :get-message(1) <> ""
     3393           then do:
     3394             undo move_block, retry move_block .
     3395           end.
     3396         end.
     3397         assign
     3398           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     3399           no-error .
     3400         if error-status :error
     3401         or error-status :get-message(1) <> ""
     3402         then do:
     3403           undo move_block, retry move_block .
     3404         end.
     3405         assign
     3406           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     3407           no-error .
     3408         if error-status :error
     3409         or error-status :get-message(1) <> ""
     3410         then do:
     3411           undo move_block, retry move_block .
     3412         end.
     3413         for each buf_temp-browse-handle
     3414           where buf_temp-browse-handle.browse-type = 'height':u
     3415         on error undo move_block, retry move_block
     3416         :
     3417           assign
     3418             buf_temp-browse-handle.browse-handle :height
     3419               = buf_temp-browse-handle.browse-handle :height + p-change-value
     3420             no-error .
     3421           if error-status :error
     3422           or error-status :get-message(1) <> ""
     3423           then do:
     3424             undo move_block, retry move_block .
     3425           end.
     3426         end.
     3427         for each buf_temp-diasize-handle
     3428         on error undo move_block, retry move_block
     3429         :
     3430           assign
     3431             v-object-handle = buf_temp-diasize-handle.handle-value
     3432           .
     3433           if v-object-handle <> v-diasize-resize-button
     3434           then do:
     3435             assign
     3436               v-object-handle :row = v-object-handle :row + p-change-value
     3437               no-error .
     3438             if error-status :error
     3439             or error-status :get-message(1) <> ""
     3440             then do:
     3441               undo move_block, retry move_block .
     3442             end.
     3443           end.
     3444         end.
     3445       end.
     3446       else do:
     3447         for each buf_temp-diasize-handle
     3448         on error undo move_block, retry move_block
     3449         :
     3450           assign
     3451             v-object-handle = buf_temp-diasize-handle.handle-value
     3452           .
     3453           if v-object-handle <> v-diasize-resize-button
     3454           then do:
     3455             assign
     3456               v-object-handle :row = v-object-handle :row + p-change-value
     3457               no-error .
     3458             if error-status :error
     3459             or error-status :get-message(1) <> ""
     3460             then do:
     3461               undo move_block, retry move_block .
     3462             end.
     3463           end.
     3464         end.
     3465         assign
     3466           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     3467           no-error .
     3468         if error-status :error
     3469         or error-status :get-message(1) <> ""
     3470         then do:
     3471           undo move_block, retry move_block .
     3472         end.
     3473         for each buf_temp-browse-handle
     3474           where buf_temp-browse-handle.browse-type = 'height':u
     3475         on error undo move_block, retry move_block
     3476         :
     3477           assign
     3478             buf_temp-browse-handle.browse-handle :height
     3479               = buf_temp-browse-handle.browse-handle :height + p-change-value
     3480             no-error .
     3481           if error-status :error
     3482           or error-status :get-message(1) <> ""
     3483           then do:
     3484             undo move_block, retry move_block .
     3485           end.
     3486         end.
     3487         assign
     3488           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     3489           no-error .
     3490         if error-status :error
     3491         or error-status :get-message(1) <> ""
     3492         then do:
     3493           undo move_block, retry move_block .
     3494         end.
     3495         if frame Dialog-Frame :scrollable = true
     3496         then do:
     3497           assign
     3498             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     3499             no-error .
     3500           if error-status :error
     3501           or error-status :get-message(1) <> ""
     3502           then do:
     3503             undo move_block, retry move_block .
     3504           end.
     3505         end.
     3506       end.
     3507       if p-move-resize = true
     3508       then do:
     3509         run diasize_position-resize-button in this-procedure .
     3510       end.
     3511       if v-diasize-wndstore = true
     3512       then do:
     3513         if connected("ub") = true
     3514         then do:
     3515           define variable v-cntxt-db-num        as integer   no-undo .
     3516           define variable v-cntxt-userid        as character no-undo .
     3517           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3518                                             , OUTPUT v-cntxt-userid
     3519                                             ) .
     3520           run gbl/wndsizew.p
     3521             (input  v-cntxt-db-num
     3522             ,input  v-cntxt-userid
     3523             ,input  v-diasize-proc-name
     3524             ,input  'height':u
     3525             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     3526             ) .
     3527         end.
     3528       end.
     3529     end.
     3530     assign
     3531       v-diasize-change-size = false
     3532     .
     3533   end procedure.
     3534   procedure diasize_set-height :
     3535     define input  parameter p-new-height  as decimal   no-undo .
     3536     define input  parameter p-move-resize as logical   no-undo .
     3537     do
     3538     on error undo, return error return-value
     3539     :
     3540       run diasize_change-height in this-procedure
     3541         (input  (p-new-height - frame Dialog-Frame :height)
     3542         ,input  p-move-resize
     3543         ) .
     3544     end.
     3545   end procedure.
     3546   procedure diasize_change-width :
     3547     define input  parameter p-change-value as decimal   no-undo .
     3548     define input  parameter p-move-resize  as logical   no-undo .
     3549     define variable v-field-group-handle   as handle    no-undo .
     3550     define variable v-object-handle        as handle    no-undo .
     3551     define variable v-frame-width          as decimal   no-undo .
     3552     define variable v-frame-virtual-width  as decimal   no-undo .
     3553     define variable v-browse-width         as decimal   no-undo .
     3554     define variable v-window-width         as decimal   no-undo .
     3555     define variable v-window-virtual-width as decimal   no-undo .
     3556     define variable v-change-sign          as integer   no-undo .
     3557     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     3558     define buffer buf_temp-browse-handle  for temp-browse-handle .
     3559     if p-change-value > 0
     3560     then do:
     3561       if frame Dialog-Frame :width + p-change-value >
     3562           session :width-chars
     3563       then do:
     3564         assign
     3565           p-change-value = session :width-chars - frame Dialog-Frame :width
     3566         .
     3567         if p-change-value <= 0
     3568         then do:
     3569           run diasize_position-resize-button in this-procedure .
     3570           return .
     3571         end.
     3572       end.
     3573     end.
     3574     if p-change-value < 0
     3575     then do:
     3576       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     3577       then do:
     3578         assign
     3579           p-change-value = v-diasize-orig-frame-width
     3580                          - frame Dialog-Frame :width
     3581         .
     3582         if p-change-value >= 0
     3583         then do:
     3584           run diasize_position-resize-button in this-procedure .
     3585           return .
     3586         end.
     3587       end.
     3588     end.
     3589     if p-change-value >= 0
     3590     then do:
     3591       assign
     3592         v-change-sign = 1
     3593       .
     3594     end.
     3595     else do:
     3596       assign
     3597         v-change-sign = -1
     3598       .
     3599     end.
     3600     assign
     3601       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     3602     .
     3603     if p-change-value = 0
     3604     then do:
     3605       run diasize_position-resize-button in this-procedure .
     3606       return .
     3607     end.
     3608     move_block:
     3609     do
     3610     on error undo move_block, leave move_block
     3611     :
     3612       if retry
     3613       then do:
     3614         do
     3615         on error undo move_block, leave move_block
     3616         :
     3617           if p-change-value > 0
     3618           then do:
     3619             for each buf_temp-diasize-handle
     3620             on error undo, next
     3621             :
     3622               assign
     3623                 v-object-handle = buf_temp-diasize-handle.handle-value
     3624               .
     3625               if v-object-handle <> v-diasize-resize-button
     3626               then do:
     3627                 assign
     3628                   v-object-handle :col = buf_temp-diasize-handle.save-position
     3629                 .
     3630               end.
     3631             end.
     3632             assign
     3633               v-diasize-browse-handle :width = v-browse-width
     3634             .
     3635             for each buf_temp-browse-handle
     3636               where buf_temp-browse-handle.browse-type = 'width':u
     3637             on error undo, next
     3638             :
     3639               assign
     3640                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     3641               .
     3642             end.
     3643             assign
     3644               frame Dialog-Frame :width = v-frame-width
     3645             .
     3646             if frame Dialog-Frame :scrollable = true
     3647             then do:
     3648               assign
     3649                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     3650               .
     3651             end.
     3652             run diasize_position-resize-button in this-procedure .
     3653           end.
     3654           else do:
     3655             if frame Dialog-Frame :scrollable = true
     3656             then do:
     3657               assign
     3658                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     3659               .
     3660             end.
     3661             assign
     3662               frame Dialog-Frame :width = v-frame-width
     3663             .
     3664             for each buf_temp-browse-handle
     3665               where buf_temp-browse-handle.browse-type = 'width':u
     3666             on error undo, next
     3667             :
     3668               assign
     3669                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     3670               .
     3671             end.
     3672             assign
     3673               v-diasize-browse-handle :width = v-browse-width
     3674             .
     3675             for each buf_temp-diasize-handle
     3676             on error undo, next
     3677             :
     3678               assign
     3679                 v-object-handle = buf_temp-diasize-handle.handle-value
     3680               .
     3681               if v-object-handle <> v-diasize-resize-button
     3682               then do:
     3683                 assign
     3684                   v-object-handle :col = buf_temp-diasize-handle.save-position
     3685                 .
     3686               end.
     3687             end.
     3688             run diasize_position-resize-button in this-procedure .
     3689           end.
     3690           assign
     3691             v-diasize-change-size = false
     3692           .
     3693           leave move_block .
     3694         end.
     3695       end.
     3696       assign
     3697         v-diasize-need-full-display = true
     3698       .
     3699       if v-diasize-change-size = false
     3700       then do:
     3701         assign
     3702           v-diasize-change-size = true
     3703         .
     3704       end.
     3705       else do:
     3706         return .
     3707       end.
     3708       assign
     3709         v-frame-width = frame Dialog-Frame :width
     3710         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     3711         v-browse-width = v-diasize-browse-handle :width
     3712       .
     3713       for each buf_temp-browse-handle
     3714         where buf_temp-browse-handle.browse-type = 'width':u
     3715       :
     3716         assign
     3717           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     3718         .
     3719       end.
     3720       for each buf_temp-diasize-handle
     3721       :
     3722         delete buf_temp-diasize-handle .
     3723       end.
     3724       assign
     3725         v-field-group-handle = frame Dialog-Frame :first-child
     3726       .
     3727       do while valid-handle(v-field-group-handle)
     3728       :
     3729         assign
     3730           v-object-handle = v-field-group-handle :first-child
     3731         .
     3732         do while valid-handle(v-object-handle)
     3733         :
     3734           if  v-object-handle <> v-diasize-browse-handle :handle
     3735           and v-object-handle <> v-diasize-resize-button
     3736           and can-query(v-object-handle, "row")
     3737           and can-query(v-object-handle, "height")
     3738           and ( v-object-handle :col + v-object-handle :width
     3739                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     3740               )
     3741           then do:
     3742             find first buf_temp-browse-handle
     3743               where buf_temp-browse-handle.browse-type   = 'width':u
     3744                 and buf_temp-browse-handle.browse-handle = v-object-handle
     3745               no-error .
     3746             if available buf_temp-browse-handle
     3747             then do:
     3748             end.
     3749             else do:
     3750               create buf_temp-diasize-handle .
     3751               assign
     3752                 buf_temp-diasize-handle.handle-value  = v-object-handle
     3753                 buf_temp-diasize-handle.save-position = v-object-handle :col
     3754               .
     3755             end.
     3756           end.
     3757           assign
     3758             v-object-handle = v-object-handle :next-sibling
     3759           .
     3760         end.
     3761         assign
     3762           v-field-group-handle = v-field-group-handle :next-sibling
     3763         .
     3764       end.
     3765       do with frame Dialog-Frame
     3766       :
     3767         hide v-diasize-resize-button .
     3768         v-diasize-resize-button :row = 1.
     3769         v-diasize-resize-button :column = 1.
     3770       end.
     3771       if p-change-value > 0
     3772       then do:
     3773         if frame Dialog-Frame :scrollable = true
     3774         then do:
     3775           assign
     3776             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     3777             no-error .
     3778           if error-status :error
     3779           or error-status :get-message(1) <> ""
     3780           then do:
     3781             undo move_block, retry move_block.
     3782           end.
     3783         end.
     3784         assign
     3785           frame Dialog-Frame :width = v-frame-width + p-change-value
     3786           no-error .
     3787         if error-status :error
     3788         or error-status :get-message(1) <> ""
     3789         then do:
     3790           undo move_block, retry move_block.
     3791         end.
     3792         assign
     3793           v-diasize-browse-handle :width = v-browse-width + p-change-value
     3794         no-error .
     3795         if error-status :error
     3796         or error-status :get-message(1) <> ""
     3797         then do:
     3798           undo move_block, retry move_block.
     3799         end.
     3800         for each buf_temp-browse-handle
     3801           where buf_temp-browse-handle.browse-type = 'width':u
     3802         on error undo move_block, retry move_block
     3803         :
     3804           assign
     3805             buf_temp-browse-handle.browse-handle :width
     3806               = buf_temp-browse-handle.browse-handle :width + p-change-value
     3807             no-error .
     3808           if error-status :error
     3809           or error-status :get-message(1) <> ""
     3810           then do:
     3811             undo move_block, retry move_block .
     3812           end.
     3813         end.
     3814         for each buf_temp-diasize-handle
     3815         on error undo move_block, retry move_block
     3816         :
     3817           assign
     3818             v-object-handle = buf_temp-diasize-handle.handle-value
     3819           .
     3820           if v-object-handle <> v-diasize-resize-button
     3821           then do:
     3822             assign
     3823               v-object-handle :col = v-object-handle :col + p-change-value
     3824               no-error .
     3825             if error-status :error
     3826             or error-status :get-message(1) <> ""
     3827             then do:
     3828               undo move_block, retry move_block .
     3829             end.
     3830           end.
     3831         end.
     3832       end.
     3833       else do:
     3834         for each buf_temp-diasize-handle
     3835         on error undo move_block, retry move_block
     3836         :
     3837           assign
     3838             v-object-handle = buf_temp-diasize-handle.handle-value
     3839           .
     3840           if v-object-handle <> v-diasize-resize-button
     3841           then do:
     3842             assign
     3843               v-object-handle :col = v-object-handle :col + p-change-value
     3844               no-error .
     3845             if error-status :error
     3846             or error-status :get-message(1) <> ""
     3847             then do:
     3848               undo move_block, retry move_block .
     3849             end.
     3850           end.
     3851         end.
     3852         for each buf_temp-browse-handle
     3853           where buf_temp-browse-handle.browse-type = 'width':u
     3854         on error undo move_block, retry move_block
     3855         :
     3856           assign
     3857             buf_temp-browse-handle.browse-handle :width
     3858               = buf_temp-browse-handle.browse-handle :width + p-change-value
     3859             no-error .
     3860           if error-status :error
     3861           or error-status :get-message(1) <> ""
     3862           then do:
     3863             undo move_block, retry move_block .
     3864           end.
     3865         end.
     3866         assign
     3867           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     3868           no-error .
     3869         if error-status :error
     3870         or error-status :get-message(1) <> ""
     3871         then do:
     3872           undo move_block, retry move_block.
     3873         end.
     3874         assign
     3875           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     3876         no-error .
     3877         if error-status :error
     3878         or error-status :get-message(1) <> ""
     3879         then do:
     3880           undo move_block, retry move_block.
     3881         end.
     3882         if frame Dialog-Frame :scrollable = true
     3883         then do:
     3884           assign
     3885             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     3886           no-error .
     3887           if error-status :error
     3888           or error-status :get-message(1) <> ""
     3889           then do:
     3890             undo move_block, retry move_block.
     3891           end.
     3892         end.
     3893       end.
     3894       if p-move-resize
     3895       then do:
     3896         run diasize_position-resize-button in this-procedure .
     3897       end.
     3898       if v-diasize-wndstore = true
     3899       then do:
     3900         if connected("ub") = true
     3901         then do:
     3902           define variable v-cntxt-db-num        as integer   no-undo .
     3903           define variable v-cntxt-userid        as character no-undo .
     3904           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3905                                             , OUTPUT v-cntxt-userid
     3906                                             ) .
     3907           run gbl/wndsizew.p
     3908             (input  v-cntxt-db-num
     3909             ,input  v-cntxt-userid
     3910             ,input  v-diasize-proc-name
     3911             ,input  'width':u
     3912             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     3913             ) .
     3914         end.
     3915       end.
     3916     end.
     3917     assign
     3918       v-diasize-change-size = false
     3919     .
     3920   end procedure.
     3921   procedure diasize_set-width :
     3922     define input  parameter p-new-width  as decimal   no-undo .
     3923     define input  parameter p-move-resize as logical   no-undo .
     3924     do
     3925     on error undo, return error return-value
     3926     :
     3927       run diasize_change-width in this-procedure
     3928         (input  (p-new-width - frame Dialog-Frame :width)
     3929         ,input  p-move-resize
     3930         ) .
     3931     end.
     3932   end procedure.
     3933   procedure diasize_position-resize-button :
     3934     do with frame Dialog-Frame
     3935     :
     3936       hide v-diasize-resize-button .
     3937       assign
     3938         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     3939                     - 1
     3940                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     3941         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     3942                     - 1
     3943                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     3944       .
     3945       view v-diasize-resize-button .
     3946     end.
     3947   end procedure.
     3948   on alt-right anywhere
     3949   do:
     3950     run diasize_change-width in this-procedure
     3951       (input 1
     3952       ,input true
     3953       ) .
     3954     return no-apply .
     3955   end.
     3956   on alt-left anywhere
     3957   do:
     3958     run diasize_change-width in this-procedure
     3959       (input -1
     3960       ,input true
     3961       ) .
     3962     return no-apply .
     3963   end.
     3964   on alt-down anywhere
     3965   do:
     3966     run diasize_change-height in this-procedure
     3967       (input 1
     3968       ,input true
     3969       ) .
     3970     return no-apply .
     3971   end.
     3972   on alt-up anywhere
     3973   do:
     3974     run diasize_change-height in this-procedure
     3975       (input -1
     3976       ,input true
     3977       ) .
     3978     return no-apply .
     3979   end.
     3980   on alt-enter of frame Dialog-Frame
     3981   do:
     3982     run diasize_maximize in this-procedure
     3983       (input  ?
     3984       ).
     3985     return no-apply .
     3986   end.
     3987   procedure diasize_end-move :
     3988     do
     3989     on error undo, return error return-value
     3990     :
     3991       define variable v-row-delta as decimal   no-undo .
     3992       define variable v-col-delta as decimal   no-undo .
     3993       define variable v-new-row as decimal   no-undo .
     3994       define variable v-new-col as decimal   no-undo .
     3995       assign
     3996         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     3997         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     3998       .
     3999       assign
     4000         v-row-delta = v-new-row - frame Dialog-Frame :height
     4001         v-col-delta = v-new-col - frame Dialog-Frame :width
     4002       .
     4003       run diasize_change-height in this-procedure
     4004         (input v-row-delta
     4005         ,input true
     4006         ) .
     4007       run diasize_change-width in this-procedure
     4008         (input v-col-delta
     4009         ,input true
     4010         ) .
     4011     end.
     4012   end procedure.
     4013   procedure diasize_maximize :
     4014     define input  parameter p-action as logical   no-undo .
     4015     do
     4016     on error undo, return error return-value
     4017     :
     4018       if p-action = ?
     4019       then do:
     4020         if v-diasize-need-maximize = true
     4021         then do:
     4022           assign
     4023             p-action = true
     4024           .
     4025         end.
     4026         else do:
     4027           assign
     4028             p-action = false
     4029           .
     4030         end.
     4031       end.
     4032       if p-action = true
     4033       then do:
     4034         run diasize_change-height in this-procedure
     4035           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     4036               - frame Dialog-Frame :height-chars
     4037           ,input true
     4038           ) .
     4039         run diasize_change-width in this-procedure
     4040           (input session :width-chars
     4041               - frame Dialog-Frame :width-chars
     4042           ,input true
     4043           ) .
     4044         assign
     4045           v-diasize-need-maximize = false
     4046         .
     4047       end.
     4048       else do:
     4049         run diasize_change-width in this-procedure
     4050           (input v-diasize-orig-frame-width
     4051               - frame Dialog-Frame :width-chars
     4052           ,input true
     4053           ) .
     4054         run diasize_change-height in this-procedure
     4055           (input v-diasize-orig-frame-height
     4056               - frame Dialog-Frame :height-chars
     4057           ,input true
     4058           ) .
     4059         assign
     4060           v-diasize-need-maximize = true
     4061         .
     4062       end.
     4063     end.
     4064   end procedure.
     4065   procedure diasize_restore-orig-size :
     4066     do
     4067     on error undo, return error return-value
     4068     :
     4069       assign
     4070         v-diasize-current-frame-width  = frame Dialog-Frame :width
     4071         v-diasize-current-frame-height = frame Dialog-Frame :height
     4072       .
     4073       run diasize_set-height in this-procedure
     4074         (input  v-diasize-orig-frame-height
     4075         ,input  true
     4076         ) .
     4077       run diasize_set-width in this-procedure
     4078         (input  v-diasize-orig-frame-width
     4079         ,input  true
     4080         ) .
     4081     end.
     4082   end procedure.
     4083   procedure diasize_restore-current-size :
     4084     do
     4085     on error undo, return error return-value
     4086     :
     4087       run diasize_set-height in this-procedure
     4088         (input  v-diasize-current-frame-height
     4089         ,input  true
     4090         ) .
     4091       run diasize_set-width in this-procedure
     4092         (input  v-diasize-current-frame-width
     4093         ,input  true
     4094         ) .
     4095     end.
     4096   end procedure.
     4097   procedure diasize_set-browse-handle :
     4098     define input  parameter p-browse-handle as handle   no-undo .
     4099     define buffer buf_temp-browse-handle for temp-browse-handle .
     4100     do
     4101     on error undo, return error return-value
     4102     :
     4103       assign
     4104         v-diasize-browse-handle = p-browse-handle
     4105       .
     4106       for each buf_temp-browse-handle
     4107       on error undo, return error return-value
     4108       :
     4109         delete buf_temp-browse-handle .
     4110       end.
     4111     end.
     4112   end procedure.
     4113   procedure diasize_add_browse :
     4114     define input  parameter p-browse-type   as character no-undo .
     4115     define input  parameter p-browse-handle as handle    no-undo .
     4116     define buffer buf_temp-browse-handle for temp-browse-handle .
     4117     do
     4118     on error undo, return error return-value
     4119     :
     4120       assign
     4121         v-diasize-browse-number = v-diasize-browse-number + 1
     4122       .
     4123       create buf_temp-browse-handle .
     4124       assign
     4125         buf_temp-browse-handle.browse-type   = p-browse-type
     4126         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     4127         buf_temp-browse-handle.browse-handle = p-browse-handle
     4128       .
     4129     end.
     4130   end procedure.
     4131   procedure diasize_init :
     4132     define variable v-default-value    as logical   no-undo .
     4133     define variable v-restore-saved    as logical   no-undo .
     4134     define variable v-resize-value-str as character no-undo .
     4135     do
     4136     on error undo, return error return-value
     4137     :
     4138       do with frame Dialog-Frame
     4139       :
     4140         assign
     4141           v-diasize-orig-frame-height = frame Dialog-Frame :height
     4142           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     4143           v-diasize-browse-handle     = browse br-level-dis :handle
     4144         .
     4145         create button v-diasize-resize-button
     4146         assign
     4147           parent        = frame Dialog-Frame :first-child
     4148           label         = "s"
     4149           height-pixels = 16
     4150           width-pixels  = 16
     4151           visible       = true
     4152           sensitive     = true
     4153           movable       = true
     4154           triggers:
     4155             on end-move persistent run diasize_end-move in this-procedure .
     4156           end triggers.
     4157         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     4158         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     4159         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     4160         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     4161         assign
     4162           v-diasize-wndmax = false
     4163         .
     4164         if connected("ub") = true
     4165         then do:
     4166           define variable v-cntxt-db-num        as integer   no-undo .
     4167           define variable v-cntxt-userid        as character no-undo .
     4168           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     4169                                             , OUTPUT v-cntxt-userid
     4170                                             ) .
     4171           run gbl/wndpar_r.p
     4172             (input  v-cntxt-db-num
     4173             ,input  v-cntxt-userid
     4174             ,input  'wndmax':U
     4175             ,output v-diasize-wndmax
     4176             ,output v-default-value
     4177             ) .
     4178         end.
     4179         assign
     4180           v-diasize-wndstore = false
     4181         .
     4182         if connected("ub") = true
     4183         then do:
     4184           run gbl/wndpar_r.p
     4185             (input  v-cntxt-db-num
     4186             ,input  v-cntxt-userid
     4187             ,input  'wndstore':U
     4188             ,output v-diasize-wndstore
     4189             ,output v-default-value
     4190             ) .
     4191         end.
     4192         assign
     4193           v-diasize-proc-name = entry(1, program-name(2), '.')
     4194         .
     4195         if v-diasize-wndstore = true
     4196         then do:
     4197           assign
     4198             v-restore-saved = false
     4199           .
     4200           if connected("ub") = true
     4201           then do:
     4202             run gbl/wndsizer.p
     4203               (input  v-cntxt-db-num
     4204               ,input  v-cntxt-userid
     4205               ,input  v-diasize-proc-name
     4206               ,input  'height':u
     4207               ,output v-resize-value-str
     4208               ) .
     4209             if v-resize-value-str <> '':U
     4210             then do:
     4211               run diasize_change-height in this-procedure
     4212                 (input  integer(v-resize-value-str)
     4213                 ,input  true
     4214                 ) .
     4215               assign
     4216                 v-restore-saved = true
     4217               .
     4218             end.
     4219           end.
     4220           if connected("ub") = true
     4221           then do:
     4222             run gbl/wndsizer.p
     4223               (input  v-cntxt-db-num
     4224               ,input  v-cntxt-userid
     4225               ,input  v-diasize-proc-name
     4226               ,input  'width':u
     4227               ,output v-resize-value-str
     4228               ) .
     4229             if v-resize-value-str <> '':U
     4230             then do:
     4231               run diasize_change-width in this-procedure
     4232                 (input  integer(v-resize-value-str)
     4233                 ,input  true
     4234                 ) .
     4235               assign
     4236                 v-restore-saved = true
     4237               .
     4238             end.
     4239           end.
     4240           if v-restore-saved <> true
     4241           then do:
     4242             if v-diasize-wndmax = true
     4243             then do:
     4244               run diasize_maximize in this-procedure
     4245                 (input  true
     4246                 ) .
     4247             end.
     4248           end.
     4249         end.
     4250         else do:
     4251           if v-diasize-wndmax = true
     4252           then do:
     4253             run diasize_maximize in this-procedure
     4254               (input  true
     4255               ) .
     4256           end.
     4257         end.
     4258       end.
     4259     end.
     4260   end procedure.
     4261   procedure diasize_need-full-display :
     4262     define output parameter p-need-full-display as logical   no-undo .
     4263     do
     4264     on error undo, return error return-value
     4265     :
     4266       assign
     4267         p-need-full-display = v-diasize-need-full-display
     4268       .
     4269       assign
     4270         v-diasize-need-full-display = false
     4271       .
     4272     end.
     4273   end procedure.
     4274   procedure get-context :
     4275      define output parameter p-db-num as integer          no-undo.
     4276      define output parameter p-user-id as character        no-undo.
     4277      define variable v-login               as character    no-undo.
     4278      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     4279      define buffer buf_user-login  for ub.user-login .
     4280      do
     4281      on error undo, return error
     4282      :
     4283            FIND FIRST buf_sys-ctrl no-lock.
     4284            ASSIGN
     4285               v-login = USERID("ub")
     4286               p-db-num = buf_sys-ctrl.db-num
     4287            .
     4288            FIND FIRST buf_user-login
     4289                 WHERE buf_user-login.db-num = p-db-num
     4290                   AND buf_user-login.user-login = v-login
     4291                 no-lock
     4292                 no-error
     4293                 .
     4294            IF AVAILABLE buf_user-login
     4295            THEN DO:
     4296               assign
     4297                  p-user-id = buf_user-login.user-id
     4298               .
     4299            END.
     4300      end.
     4301   end procedure.
     4302       run diasize_init in this-procedure .
     4303   on choose of r-cli in frame dialog-frame
     4304   do:
     4305      run proc-r-cli in this-procedure no-error .
     4306      if error-status :error then
     4307         return no-apply.
     4308   end.
     4309   on mouse-select-dblclick of fi-cli-code in frame Dialog-Frame
     4310   do:
     4311     apply "CHOOSE" to r-cli in frame Dialog-Frame.
     4312     return no-apply .
     4313   end.
     4314   on mouse-select-dblclick of fi-cli-type in frame Dialog-Frame
     4315   do:
     4316     apply "CHOOSE" to r-cli in frame Dialog-Frame.
     4317     return no-apply .
     4318   end.
     4319   procedure proc-r-cli :
     4320    do
     4321    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     4322    :
     4323    define variable v-recid as recid no-undo .
     4324    define variable old-types as character no-undo .
     4325    define variable v-host-code like ub.sysconf.host-code no-undo .
     4326    define buffer cli#clients for ub.clients.
     4327    define variable v-user-select as logical   no-undo .
     4328    define variable v-obj-type    as character no-undo .
     4329    define variable v-obj-code    as integer   no-undo .
     4330   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4331   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     4332     (input  p-obj-type
     4333     ,input  p-obj-code
     4334     ,output v-host-code
     4335     )  .
     4336   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4337   run userobjs_select-one in this-procedure
     4338     (input  parparentproc
     4339     ,input  v-cntxt-db-num
     4340     ,input  v-cntxt-userid
     4341     ,input  v-host-code
     4342     ,input  p-obj-type
     4343     ,input  p-obj-code
     4344     ,output v-user-select
     4345     ,output v-obj-type
     4346     ,output v-obj-code
     4347     )  .
     4348     if v-user-select <> true
     4349     then do:
     4350       return error return-value .
     4351     end.
     4352       find first cli#clients no-lock
     4353         where cli#clients.obj-type = v-obj-type
     4354           and cli#clients.obj-code = v-obj-code
     4355            no-error.
     4356       if avail cli#clients then
     4357           assign
     4358               fi-cli-type = cli#clients.obj-type
     4359               fi-cli-code = cli#clients.obj-code
     4360               fi-cli-name = cli#clients.obj-name
     4361               .
     4362       else
     4363          assign
     4364             fi-cli-type = ""
     4365             fi-cli-name = ""
     4366             fi-cli-code = ?
     4367             .
     4368       display
     4369           fi-cli-type
     4370           fi-cli-name
     4371           fi-cli-code
     4372           with frame Dialog-Frame .
     4373   end.
     4374   end procedure.
     4375   procedure leave-proc-cli :
     4376    do
     4377    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     4378    :
     4379     def buffer buf_clients for ub.clients.
     4380     assign frame Dialog-Frame
     4381        fi-cli-type
     4382        fi-cli-code
     4383         .
     4384     if fi-cli-code <> ? and fi-cli-code <> 0 and
     4385        fi-cli-type <> ? and fi-cli-type <> ""
     4386         then do:
     4387         find first buf_clients no-lock where
     4388                   buf_clients.obj-type =  fi-cli-type  and
     4389                   buf_clients.obj-code  = fi-cli-code no-error.
     4390             if error-status :error or not available buf_clients then do:
     4391                 message "Неправильно задан "  fi-cli-code:label in frame Dialog-Frame.
     4392                   assign
     4393                   fi-cli-type = ""
     4394                   fi-cli-name = ""
     4395                   fi-cli-code = ?
     4396                   .
     4397                 display
     4398                 fi-cli-type
     4399                 fi-cli-name
     4400                 fi-cli-code
     4401                 with frame Dialog-Frame.
     4402                 apply "CHOOSE" to r-cli in frame Dialog-Frame .
     4403             end.
     4404             if available buf_clients then do:
     4405                   fi-cli-type  = buf_clients.obj-type .
     4406                   fi-cli-name  = buf_clients.obj-name .
     4407                   fi-cli-code  = buf_clients.obj-code .
     4408             end.
     4409    end.
     4410    else do:
     4411         assign
     4412           fi-cli-type = ""
     4413           fi-cli-name = ""
     4414           fi-cli-code = ?
     4415           .
     4416     end.
     4417    display
     4418     fi-cli-type
     4419     fi-cli-name
     4420     fi-cli-code
     4421     with frame Dialog-Frame.
     4422    end.
     4423   end procedure.
     4424   MAIN-BLOCK:
     4425   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     4426     ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     4427   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4428     run mainmenu_getcntxt in parparentproc
     4429       (output v-cntxt-db-num
     4430       ,output v-cntxt-userid
     4431       ,output v-cntxt-level
     4432       ,output v-cntxt-host-code-obj
     4433       ,output v-cntxt-obj-type
     4434       ,output v-cntxt-obj-code
     4435       ,output v-cntxt-db-num-obj
     4436       ,output v-cntxt-is-admin
     4437       ) .
     4438     if NOT (p-mode = 'ДОБАВЛЕНИЕ':U or p-mode = 'ИЗМЕНЕНИЕ':U or p-mode = 'ПРОСМОТР':U) then do:
     4439       message
     4440       vss-workfile vss-revision vss-description skip
     4441       "Неверный параметр вызова p-mode" p-mode
     4442           view-as alert-box ERROR.
     4443           undo, return error.
     4444       end.
     4445     find first ub.gds-grp where
     4446                   ub.gds-grp.node-code = p-node-code no-error.
     4447       if not avail ub.gds-grp then do:
     4448           message
     4449           vss-workfile vss-revision vss-description skip
     4450           "Неверное значение параметра вызова p-node-code" p-node-code
     4451               view-as alert-box ERROR.
     4452               undo, return error.
     4453       end.
     4454       run grplib-get-full-name in this-procedure( input p-node-code,
     4455                                                                           output v-full-name) no-error.
     4456     CASE p-option:
     4457       when 'фирма':U then do:
     4458         find first ub.sysconf no-lock where
     4459                     ub.sysconf.host-code = p-host-code no-error.
     4460       if not avail ub.sysconf then do:
     4461           message
     4462           vss-workfile vss-revision vss-description skip
     4463           "Неверное значение параметра вызова p-host-code" p-host-code
     4464               view-as alert-box ERROR.
     4465               undo, return error.
     4466       end.
     4467           find first ub.clients no-lock where
     4468                     ub.clients.obj-type = 'орг':U
     4469                 AND ub.clients.obj-code = p-host-code.
     4470       assign
     4471         v-host-name = replace(ub.clients.obj-name, chr(44), chr(32)).
     4472       end.
     4473       when 'объект':U then do:
     4474           find first ub.clients no-lock where
     4475                     ub.clients.obj-type = p-obj-type
     4476                 AND ub.clients.obj-code = p-obj-code no-error.
     4477       if not avail ub.clieNts then do:
     4478           message
     4479           vss-workfile vss-revision vss-description skip
     4480           "Неверное значение параметров вызова p-obj-type и/или p-obj-code host-code" p-obj-type p-obj-code
     4481               view-as alert-box ERROR.
     4482               undo, return error.
     4483           end.
     4484       end.
     4485     END CASE.
     4486     RUN FILL-TABLES IN THIS-PROCEDURE NO-ERROR.
     4487     if error-status:error then  do:
     4488       undo, return error.
     4489     end.
     4490     RUN MYenable.
     4491     run proc-load.
     4492     WAIT-FOR GO OF FRAME Dialog-Frame.
     4493   END.
     4494   RUN disable_UI.
     4495   PROCEDURE create-attr :
     4496   do
     4497   on error undo, return error
     4498   :
     4499     define input parameter v-min-marg           as decimal                  no-undo .
     4500     define input parameter v-max-marg           as decimal                  no-undo .
     4501     define input parameter v-increase-pc        like ub.gds-grp.increase-pc no-undo .
     4502     define input parameter v-round-method       as character                no-undo .
     4503     define input parameter v-base               as decimal                  no-undo .
     4504     define input parameter v-cli-type           as character                no-undo .
     4505     define input parameter v-cli-code           as integer                  no-undo .
     4506     define input parameter v-notcorr            as character                no-undo .
     4507     define input parameter v-alc-min-price      as character                no-undo .
     4508     define input parameter v-marg-pr-paraf      as character                no-undo .
     4509     define input parameter v-level-dis-attr     as character                no-undo .
     4510     define input parameter v-no-inc-auto-rep    as character                no-undo .
     4511     define input parameter v-ban-sales-via-cd   as character                no-undo .
     4512     define input parameter v-alchol             as character                no-undo .
     4513     define input parameter v-mark               as character                no-undo .
     4514     define input parameter v-sum-grp            as character                no-undo .
     4515     define input parameter v-mark-type          as character                no-undo .
     4516     define input parameter v-emrc-type          as character                no-undo .
     4517     DEFINE VARIABLE v-node-code  like ub.gds-grp.node-code  no-undo .
     4518     DEFINE VARIABLE v-upper-code like ub.gds-grp.upper-code no-undo .
     4519     DEFINE VARIABLE v-delete     as logical                 no-undo .
     4520     DEFINE VARIABLE rid as recid no-undo.
     4521   define buffer buf_clients   for ub.clients.
     4522   if fi-cli-type:visible in frame  Dialog-Frame  then do:
     4523       if v-cli-type = ""
     4524           then do:
     4525             message "Не верно введен тип поставщика! "  view-as alert-box information .
     4526             return error .
     4527           end.
     4528       if v-cli-code = 0
     4529           then do:
     4530             message "Не верно введен код поставщика! "  view-as alert-box information .
     4531             return error .
     4532           end.
     4533       if not( v-cli-type = 'маг':U or
     4534         v-cli-type = 'скл':U )
     4535           then do:
     4536             message "Не верно введен тип поставщика! Может быть только магазин или склад ! "  v-cli-type view-as alert-box information .
     4537             return error .
     4538           end.
     4539     find first buf_clients no-lock
     4540         where buf_clients.obj-type = v-cli-type
     4541           and buf_clients.obj-code = v-cli-code
     4542     no-error.
     4543     if not available buf_clients
     4544     then do:
     4545       message "Такого " v-cli-type v-cli-code " нет в справочнике клиентов ! "   view-as alert-box information .
     4546       return error .
     4547     end.
     4548   end.
     4549     if v-min-marg <> ? and
     4550     v-min-marg > v-max-marg then do:
     4551         message
     4552         "Минимальная наценка не может быть больше максимальной. Наценки не могут быть заданы."
     4553         view-as alert-box error.
     4554         return error.
     4555     end.
     4556     if (v-min-marg = ? ) <> (v-max-marg = ?) then do:
     4557       message
     4558       "Нельзя задать только одну границу диапазона"
     4559       view-as alert-box  error .
     4560       return error .
     4561     end.
     4562     if v-min-marg = ? and v-max-marg = ? and v-increase-pc = ? and
     4563        v-cli-type = "":U and v-cli-code = 0 and
     4564       (v-round-method = "":U or v-round-method = ?) then do:
     4565         message
     4566         "Вы не задали ни торговую наценку, ни диапазон торговых наценок, ни метод округления"
     4567         view-as alert-box error.
     4568         return error.
     4569     end.
