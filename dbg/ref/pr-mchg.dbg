     1239   procedure userobjs_transfer :
     1240     define input  parameter p-callback-handle as handle no-undo .
     1241     define variable vss-description as character no-undo init "userobjs_transfer: Передача списка объектов".
     1242     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
     1243     do
     1244     on error undo, return error return-value
     1245     :
     1246       if valid-handle(p-callback-handle) <> true
     1247       then do:
     1248         message
     1249           vss-workfile vss-revision vss-description skip
     1250           "Ошибка задания входных параметров" skip
     1251           "Неизвестный указатель на процедуру" skip
     1252           view-as alert-box error .
     1253         undo, return error return-value .
     1254       end.
     1255       if p-callback-handle :get-signature("userobjs_append") = ""
     1256       then do:
     1257         message
     1258           vss-workfile vss-revision vss-description skip
     1259           "Ошибка задания входных параметров" skip
     1260           substitute("В процедуре &1 не найдена внутренняя процедура userobjs_append"
     1261                     ,p-callback-handle :file-name
     1262                     ) skip
     1263           view-as alert-box error .
     1264         undo, return error return-value .
     1265       end.
     1266       for each buf_userobjs_temp-user-obj
     1267       on error undo, return error return-value
     1268       :
     1269         run userobjs_append in p-callback-handle
     1270           (input  buf_userobjs_temp-user-obj.obj-type
     1271           ,input  buf_userobjs_temp-user-obj.obj-code
     1272           ) .
     1273       end.
     1274     end.
     1275   end procedure.
