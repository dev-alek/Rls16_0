     2968   ON CHOOSE OF r-sum-grp IN FRAME Dialog-Frame
     2969   DO:
     2970   DEFINE VARIABLE rid-list as character no-undo .
     2971   define buffer buf_sum-grp for ub.sum-grp.
     2972       run ref/sum-grps.w ( input parparentproc
     2973                           ,input "b-sel"
     2974                           ,input-output rid-list).
     2975       if rid-list <> "":U then do:
     2976         find first buf_sum-grp no-lock where
     2977                    recid(buf_sum-grp) = integer(entry(1, rid-list)) no-error .
     2978         assign
     2979         v-sum-grp = buf_sum-grp.grp-code
     2980         .
     2981       end.
     2982       else v-sum-grp = 0 .
     2983         fill-sum-grp = v-sum-grp .
     2984       display fill-sum-grp with frame Dialog-Frame.
     2985   END.
     2986   ON RIGHT-MOUSE-CLICK OF S-round-method IN FRAME Dialog-Frame
