     2991       l-rmethod:visible = true
     2992       v-round-method = '':U
     2993       .
     2994       hide
     2995       s-round-method
     2996       f-base
     2997       in frame Dialog-Frame.
     2998       ENABLE l-rmethod
     2999       with frame Dialog-Frame.
     3000   END.
