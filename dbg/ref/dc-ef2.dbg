        1   DEFINE BUFFER X_clients FOR ub.clients.
        2   DEFINE BUFFER X_dis-card FOR ub.dis-card.
        3   DEFINE INPUT PARAMETER parparentproc AS WIDGET-HANDLE NO-UNDO.
        4   DEFINE INPUT PARAMETER p-mode AS CHARACTER NO-UNDO.
        5   DEFINE INPUT PARAMETER p-dtm-code AS integer NO-UNDO.
        6   DEFINE INPUT PARAMETER p-sum-id AS CHARACTER NO-UNDO.
        7   DEFINE INPUT PARAMETER p-dt-code AS integer NO-UNDO.
        8   DEFINE INPUT PARAMETER p-node-code AS integer NO-UNDO.
        9   DEFINE INPUT PARAMETER p-emitent-host-code AS integer NO-UNDO.
       10   DEFINE INPUT PARAMETER p-type AS character NO-UNDO.
       11   DEFINE INPUT PARAMETER p-d-card AS character NO-UNDO.
       12   DEFINE INPUT PARAMETER p-host-code AS integer NO-UNDO.
       13   DEFINE INPUT PARAMETER p-obj-type AS CHARACTER NO-UNDO.
       14   DEFINE INPUT PARAMETER p-obj-code AS integer NO-UNDO.
       15   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       16   DEFINE TEMP-TABLE temp-dis-card-property NO-UNDO LIKE ub.dis-card-property
       17   field rw-option as character
       18   field prop-label as character
       19   field node-label as character
       20   field data-type as character
       21   field range as integer
       22   INDEX attrc is
       23   UNIQUE PRIMARY
       24   prop-label
       25   node-label
       26   dt-code
       27   host-code
       28   obj-type
       29   obj-code
       30   INDEX attrcl is UNIQUE
       31   dt-code
       32   node-code
       33   host-code
       34   obj-type
       35   obj-code
       36   .
       37   DEFINE INPUT-OUTPUT PARAMETER TABLE FOR temp-dis-card-property.
       38   DEFINE OUTPUT PARAMETER p-setted AS LOGICAL NO-UNDO.
       39   define variable vss-revision    as character no-undo init "$Revision$":U .
       40   define variable vss-author      as character no-undo init "$Author$":U .
       41   define variable vss-date        as character no-undo init "$Date$":U .
       42   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       43   define variable vss-archive     as character no-undo init "$Archive$":U .
       44   define variable vss-description as character no-undo init "Идентификаторы EasyFuel2".
       45   procedure vss-get-info :
       46     define output parameter p-vss-revision    like vss-revision    no-undo .
       47     define output parameter p-vss-author      like vss-author      no-undo .
       48     define output parameter p-vss-date        like vss-date        no-undo .
       49     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       50     define output parameter p-vss-archive     like vss-archive     no-undo .
       51     define output parameter p-vss-description like vss-description no-undo .
       52     assign
       53       p-vss-revision    = vss-revision
       54       p-vss-author      = vss-author
       55       p-vss-date        = vss-date
       56       p-vss-workfile    = vss-workfile
       57       p-vss-archive     = vss-archive
       58       p-vss-description = vss-description
       59     .
       60   end procedure.
       61   procedure vss-get-parameters :
       62     define output parameter p-vss-parameters as character no-undo .
       63   end procedure.
       64   define new global shared variable g#vssrevis-logger as handle    no-undo .
       65   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       66   define variable v-vssrevis-logger                   as handle    no-undo .
       67   procedure vss-logevent :
       68     define input  parameter p-extra-paramters as character no-undo .
       69     define variable v-vssrevis-parameters as character no-undo .
       70     do
       71     on error undo, return error return-value
       72     :
       73       if  valid-handle(v-vssrevis-logger)
       74       and v-vssrevis-logger :get-signature("logevent") <> ""
       75       then do:
       76         run vss-get-parameters in this-procedure
       77           (output v-vssrevis-parameters
       78           ).
       79         run logevent in v-vssrevis-logger
       80           (input vss-workfile
       81           ,input vss-revision
       82           ,input v-vssrevis-parameters
       83           ,input p-extra-paramters
       84           ).
       85       end.
       86     end.
       87   end procedure.
       88   assign
       89     v-vssrevis-logger = g#vssrevis-logger
       90   .
       91   if  valid-handle(v-vssrevis-logger)
       92   and v-vssrevis-logger :get-signature("logevent") <> ""
       93   then do:
       94     assign
       95       v-vssrevis-logevent = true
       96     .
       97     run vss-logevent in this-procedure (input vss-description) .
       98   end.
       99   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      100   define variable v-waitfram-action01         as character   no-undo .
      101   define variable v-waitfram-action02         as character   no-undo .
      102   define variable v-waitfram-action03         as character   no-undo .
      103   define variable mWaitFramTextBeg            as character   no-undo.
      104   define variable mWaitFramTextEnd            as character   no-undo.
      105   define variable mWaitFramView               as logical     no-undo.
      106   define variable mWaitProcEvent              as logical     no-undo init yes.
      107   define variable mWaitFramInterval           as integer     no-undo init 1 .
      108   define variable mWaitFramStop               as logical     no-undo.
      109   define variable mWaitFramStopUser           as logical     no-undo.
      110   define variable mWaitFramStopTimeOut        as logical     no-undo.
      111   define variable mWaitFramStartProc          as datetime-tz no-undo.
      112   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      113   define button B-WaitFramStop auto-end-key
      114        label "Стоп"
      115        size 10 by 1 tooltip "Остоновить процесс".
      116   define button B-viewProcInfo
      117        label "Информация"
      118        size 15 by 1 tooltip "Информация о процесс".
      119   define frame waitfram
      120     v-waitfram-action01 format "x(72)" no-label skip
      121     v-waitfram-action02 format "x(72)" no-label skip
      122     v-waitfram-action03 format "x(72)" no-label skip
      123     B-viewProcInfo
      124     B-WaitFramStop at row 4 col 30
      125     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      126     .
      127   define new global shared variable mBatchMode as logical no-undo init ?.
      128   define variable mFramBachModHandle as handle no-undo.
      129   mFramBachModHandle = frame waitfram:handle.
      130   define variable mFameOldVis as logical no-undo.
      131   define variable mVisCUrentVin as logical no-undo.
      132   if session:batch-mode
      133   then
      134      mBatchMode = yes.
      135   if mBatchMode = ? then do:
      136     mVisCUrentVin = current-window:visible.
      137     mFameOldVis = mFramBachModHandle:visible.
      138     mFramBachModHandle:visible  = yes.
      139     mBatchMode = mFramBachModHandle:visible ne yes.
      140     mFramBachModHandle:visible = mFameOldVis.
      141     current-window:visible = mVisCUrentVin.
      142   end.
      143    if  log-manager:logfile-name ne ?
      144     then DO:
      145         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      146         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      147         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      148     end.
      149   on choose of B-WaitFramStop in frame waitfram
      150   do:
      151     mWaitFramStop = yes.
      152     mWaitFramStopUser = yes.
      153   end.
      154   function waitfram-check-timeout returns logical():
      155      define variable vtime as int64 no-undo.
      156      if mWaitFramStopTimeOut
      157      then
      158         return yes.
      159      vtime = ( now - mWaitFramStartProc ) / 1000 .
      160      if     mWaitFramTimeOut ne ?
      161         and mWaitFramTimeOut ne 0
      162         and mWaitFramTimeOut lt vtime
      163      then do:
      164         mWaitFramStopTimeOut = yes.
      165      end.
      166      return mWaitFramStopTimeOut.
      167   end.
      168   procedure waitfram-hide :
      169     if not session:batch-mode
      170     then do
      171     on error undo, return error return-value
      172     :
      173       pause 0 before-hide .
      174       if not mBatchMode then
      175         hide frame waitfram .
      176     if     not mWaitFramView
      177        and mWaitProcEvent
      178     then
      179       process events .
      180     end.
      181   end procedure.
      182   procedure waitfram-show :
      183     define input  parameter p-message as character no-undo .
      184     define variable v-left-margin as integer   no-undo .
      185     if not session:batch-mode
      186     then do
      187     on error undo, return error return-value
      188     :
      189       if length(p-message) <= 70 then do:
      190         assign
      191           v-left-margin = integer((70 - length(p-message)) / 2)
      192         .
      193         assign
      194           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      195         .
      196         assign
      197           v-waitfram-action01 = " "
      198           v-waitfram-action02 = " "
      199                                    + fill(" ", v-left-margin)
      200                                    + p-message
      201           v-waitfram-action03 = " "
      202         .
      203       end.
      204       else do:
      205         define variable vRindex1 as integer no-undo.
      206         define variable vRindex2 as integer no-undo.
      207         vRindex1 = r-index(p-message," ",70).
      208         if vRindex1 = 0
      209         then
      210            vRindex1 = 70.
      211         if length(p-message)  <= vRindex1 + 70 then do:
      212           assign
      213             v-waitfram-action01 = " "
      214             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      215             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      216           .
      217         end.
      218         else do:
      219           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      220           if vRindex2 <= vRindex1
      221           then
      222              vRindex2 = vRindex1 + 70.
      223           assign
      224             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      225             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      226             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      227           .
      228         end.
      229       end.
      230       B-viewProcInfo:visible   in frame waitfram = no.
      231       B-viewProcInfo:sensitive in frame waitfram = no.
      232       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      233       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      234       if  (   mWaitFramView
      235          or  mWaitProcEvent)
      236          and not mBatchMode
      237       then
      238          display
      239             v-waitfram-action01 skip
      240             v-waitfram-action02 skip
      241             v-waitfram-action03 skip
      242          with frame waitfram .
      243       if     mWaitFramView
      244          then do:
      245             if     mWaitFramInterval ne ?
      246                and not mBatchMode
      247             then
      248                wait-for go of frame waitfram pause mWaitFramInterval.
      249          end.
      250          else
      251             if     mWaitProcEvent
      252                and not mBatchMode
      253             then
      254                process events .
      255     end.
      256   end procedure.
      257      procedure waitfram-show-this:
      258         define input  parameter iInterval as int64 no-undo.
      259         define variable vtime as int64 no-undo.
      260         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      261         mWaitFramInterval = iInterval.
      262         run waitfram-show (substitute("&1&2 &3&4" ,
      263                                       mWaitFramTextBeg ,
      264                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      265                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      266                                       mWaitFramTextEnd
      267                                      )
      268                           ).
      269      end.
      270      procedure WaitFramRunPause:
      271         define input  parameter iInterval as dec no-undo.
      272         define variable vStart  as datetime-tz no-undo.
      273         define variable vend    as datetime-tz no-undo.
      274         define variable vint as int64 no-undo.
      275         define variable vOk as logical no-undo.
      276         vStart = now.
      277         vend   = vStart.
      278         publish "WaitFramPause" (iInterval,output vOk).
      279         vend   =  now.
      280         vint = vend - vStart.
      281         vint = iInterval - vint / 1000.
      282         if     not mWaitFramStop
      283            and (   vint > 0
      284                 or (    not vOk
      285                     and iInterval eq ?
      286                     )
      287                 )
      288         then
      289            run waitfram-show-this (iInterval).
      290         vend   =  now.
      291         vint = vend - vStart.
      292         vint = iInterval - vint / 1000.
      293         if     not mWaitFramStop
      294            and vint > 0
      295         then do:
      296            run gbl/pause.p (vint * 1000).
      297         end.
      298         if iInterval ne ?
      299         then
      300            publish "WaitFramStop".
      301         waitfram-check-timeout().
      302      end.
      303      procedure WaitFramWaitFor:
      304         define input  parameter iInterval as dec no-undo.
      305         assign
      306            mWaitFramStartProc   = now
      307            mWaitFramStopUser    = no
      308            mWaitFramStopTimeOut = no
      309         .
      310         block-wait:
      311         do while not mWaitFramStop:
      312            run WaitFramRunPause (iInterval).
      313            if  waitfram-check-timeout()
      314            then do:
      315               leave block-wait.
      316            end.
      317         end.
      318         run waitfram-hide.
      319      end.
      320   procedure waitfram-join :
      321     define input  parameter p-line-1  as character no-undo .
      322     define input  parameter p-line-2  as character no-undo .
      323     define input  parameter p-line-3  as character no-undo .
      324     define output parameter p-message as character no-undo .
      325     do
      326     on error undo, return error return-value
      327     :
      328       assign
      329         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      330                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      331                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      332       .
      333     end.
      334   end procedure.
      335   function waitfram-join-function returns character
      336     (input p-line-1 as character
      337     ,input p-line-2 as character
      338     ,input p-line-3 as character
      339     ).
      340     define variable v-message as character no-undo .
      341     run waitfram-join in this-procedure
      342       (input  p-line-1
      343       ,input  p-line-2
      344       ,input  p-line-3
      345       ,output v-message
      346       ) .
      347     return v-message .
      348   end function .
      349   define new global shared variable g#language as character no-undo .
      350   if g#language <> '' and g#language <> 'rus':U then do:
      351     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      352   end.
      353   define new global shared variable g#library  as handle no-undo .
      354   define new global shared variable g#library2 as handle no-undo .
      355   define   shared variable g#auto as logical no-undo.
      356   define   shared variable g#news as logical no-undo.
      357   define   shared variable g#oxml as logical no-undo.
      358   define   shared variable g#esys as logical no-undo.
      359   define   shared variable g#news-source-db as integer no-undo.
      360   define   shared variable g#esys-source-esys as integer no-undo.
      361   define   shared variable g#db-num as integer   no-undo .
      362   define   shared variable g#userid as character no-undo .
      363   define   shared variable g#passwd as character no-undo .
      364   procedure proc-alt-shift-f2:
      365     if not ibs.th.gbl.gbl-var:rcode
      366   then
      367     run gbl\inidebug.p .
      368   end.
      369   procedure proc-alt-shift-f3:
      370     run gbl/prvssinf.p
      371       ( input this-procedure
      372       ) .
      373   end.
      374   define variable v-inform-launched as logical no-undo initial false .
      375   procedure proc-alt-shift-f4:
      376     define variable v-action as character no-undo .
      377     if v-inform-launched = false then do:
      378       assign
      379         v-inform-launched = true
      380       .
      381       run gbl/d-inform.w
      382         (  input self
      383         ,  input this-procedure
      384         , output v-action
      385         ) no-error .
      386       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      387       assign
      388         v-inform-launched = false
      389       .
      390     end.
      391   end.
      392   procedure proc-alt-f1:
      393     run gbl/corrhelp.p
      394       (input this-procedure
      395       ) .
      396   end .
      397   on alt-shift-f2 anywhere do:
      398     run proc-alt-shift-f2.
      399   end.
      400   on alt-shift-f3 anywhere do:
      401     run proc-alt-shift-f3 in this-procedure .
      402   end.
      403   on alt-shift-f4 anywhere do:
      404     run proc-alt-shift-f4 in this-procedure.
      405   end.
      406   on alt-f1 anywhere do:
      407     run proc-alt-f1 in this-procedure .
      408   end.
      409   function diff-list returns character (
      410     input parfirst-list  as character,
      411     input parsecond-list as character,
      412     input pardelim       as character).
      413     if pardelim = ""
      414     or pardelim = ?
      415     then do:
      416       assign
      417         pardelim = ","
      418       .
      419     end.
      420     def var ind as integer no-undo .
      421     def var v-elem as character no-undo .
      422     def var v-result-list as character no-undo init "".
      423     def var v-num-parfirst-list as integer no-undo .
      424     assign
      425       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      426     .
      427     do ind = 1 to v-num-parfirst-list
      428     :
      429       assign
      430         v-elem = entry(ind, parfirst-list, pardelim)
      431       .
      432       if lookup(v-elem, parsecond-list, pardelim) = 0 then do:
      433         assign
      434           v-result-list = v-result-list
      435                         + (if v-result-list > "" then pardelim else "")
      436                         + v-elem
      437         .
      438       end.
      439     end.
      440     return v-result-list .
      441   end function.
      442   function add-list returns character (
      443    input parfirst-list  as character,
      444    input parsecond-list as character,
      445    input pardelim       as character).
      446     if pardelim = ""
      447     or pardelim = ?
      448     then do:
      449       assign
      450         pardelim = ","
      451       .
      452     end.
      453     def var ind as integer no-undo .
      454     def var v-elem as character no-undo .
      455     def var v-result-list as character no-undo init "".
      456     def var v-num-parfirst-list as integer no-undo .
      457     assign
      458       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      459     .
      460     do ind = 1 to v-num-parfirst-list
      461     :
      462       assign
      463         v-elem = entry(ind, parfirst-list, pardelim)
      464       .
      465       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
      466         assign
      467           v-result-list = v-result-list
      468                         + (if v-result-list > "" then pardelim else "")
      469                         + v-elem
      470         .
      471       end.
      472     end.
      473     def var v-num-parsecond-list as integer no-undo .
      474     assign
      475       v-num-parsecond-list = num-entries(parsecond-list, pardelim)
      476     .
      477     do ind = 1 to v-num-parsecond-list
      478     :
      479       assign
      480         v-elem = entry(ind, parsecond-list, pardelim)
      481       .
      482       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
      483         assign
      484           v-result-list = v-result-list
      485                         + (if v-result-list > "" then pardelim else "")
      486                         + v-elem
      487         .
      488       end.
      489     end.
      490     return v-result-list .
      491   end function.
      492   function cross-list returns character (
      493    input parfirst-list  as character,
      494    input parsecond-list as character,
      495    input pardelim       as character).
      496     if pardelim = ""
      497     or pardelim = ?
      498     then do:
      499       assign
      500         pardelim = ","
      501       .
      502     end.
      503     def var ind as integer no-undo .
      504     def var v-elem as character no-undo .
      505     def var v-result-list as character no-undo init "".
      506     def var v-num-parfirst-list as integer no-undo .
      507     assign
      508       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      509     .
      510     do ind = 1 to v-num-parfirst-list
      511     :
      512       assign
      513         v-elem = entry(ind, parfirst-list, pardelim)
      514       .
      515       if lookup(v-elem, v-result-list, pardelim) = 0
      516       and lookup(v-elem, parsecond-list, pardelim) > 0
      517       then do:
      518         assign
      519           v-result-list = v-result-list
      520                         + (if v-result-list > "" then pardelim else "")
      521                         + v-elem
      522         .
      523       end.
      524     end.
      525     return v-result-list .
      526   end function.
      527   function radio-label returns character (
      528    input par-rs-value  as character,
      529    input par-rs-radio-buttons as character)
      530    .
      531    DEFINE variable v-result-label as character no-undo.
      532    assign
      533    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons) MODULO 2 = 0)
      534                              then (LOOKUP(par-rs-value, par-rs-radio-buttons) - 1)
      535                              else LOOKUP(par-rs-value, par-rs-radio-buttons)
      536                             ), par-rs-radio-buttons
      537                           )
      538    v-result-label = REPLACE(v-result-label, "&":U, "":U)
      539    .
      540   return v-result-label.
      541   end function.
      542   function m-radio-label returns character (
      543    input par-rs-value  as character,
      544    input par-rs-radio-buttons as character,
      545    input par-delim as character
      546    )
      547    .
      548    DEFINE variable v-result-label as character no-undo.
      549    assign
      550    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) MODULO 2 = 0)
      551                              then (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) - 1)
      552                              else LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim)
      553                             ), par-rs-radio-buttons, par-delim
      554                           )
      555    v-result-label = REPLACE(v-result-label, "&":U, "":U)
      556    .
      557   return v-result-label.
      558   end function.
      559   FUNCTION mixlist returns character
      560   (
      561    input parfirst-list  as character
      562    ,input parsecond-list as character
      563    ,input pardelim       as character
      564    ,input pardelim-result as character ) :
      565     if pardelim = ""
      566     or pardelim = ?
      567     then do:
      568       assign
      569         pardelim = ","
      570       .
      571     end.
      572     def var ind as integer no-undo .
      573     def var v-elem1 as character no-undo .
      574     def var v-elem2 as character no-undo .
      575     def var v-result-list as character no-undo init "".
      576     do ind = 1 to num-entries(parfirst-list, pardelim)
      577     :
      578       assign
      579         v-elem1 = entry(ind, parfirst-list, pardelim)
      580         v-elem2 = entry(ind, parsecond-list, pardelim)
      581       .
      582         assign
      583           v-result-list = v-result-list
      584                         + (if v-result-list > "" then pardelim-result else "")
      585                         + v-elem1 + pardelim-result + v-elem2
      586         .
      587     end.
      588     return v-result-list .
      589   END FUNCTION.
      590   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      591   def var vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      592   procedure gen-key-rec :
      593     define input  parameter p-tbl-name    as character no-undo.
      594     define input  parameter p-bh_tbl-name as handle    no-undo.
      595     define output parameter p-key-rec     as character no-undo.
      596     do
      597     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      598     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      599     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      600     :
      601       define variable fh               as handle    no-undo .
      602       define variable v-ok             as logical   no-undo .
      603       define variable v-inform         as character no-undo .
      604       define variable v-ind            as integer   no-undo .
      605       define variable v-idx-field-qnty as integer   no-undo .
      606       if p-tbl-name = ?
      607         or p-tbl-name = "":U
      608       then do:
      609         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info3 ).
      610       end.
      611       if not p-bh_tbl-name:available then do:
      612         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info3, p-tbl-name ).
      613       end.
      614       assign
      615         p-key-rec = p-tbl-name
      616         v-inform  = p-bh_tbl-name:index-information(1)
      617         v-ind     = 2
      618       .
      619       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      620       on error undo, return error
      621       :
      622         assign
      623           v-inform = p-bh_tbl-name:index-information( v-ind )
      624           v-ind    = v-ind + 1
      625         .
      626       end.
      627       if v-inform = ?
      628         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      629         or entry( 3, v-inform, ",":U ) <> "1":U
      630       then do:
      631         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info3, p-tbl-name ).
      632       end.
      633       else do:
      634         assign
      635           v-idx-field-qnty = num-entries( v-inform ) - 4
      636         .
      637         if v-idx-field-qnty < 2 then do:
      638           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info3, v-inform, p-tbl-name ).
      639         end.
      640         do v-ind = 1 to v-idx-field-qnty by 2
      641         on error undo, return error
      642         :
      643           assign
      644             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      645             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      646           .
      647         end.
      648       end.
      649       if p-key-rec = ? then do:
      650         assign
      651           p-key-rec = "":U
      652         .
      653         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info3, p-tbl-name ).
      654       end.
      655     end.
      656     return.
      657   end procedure.
      658   procedure gen-where-keyr-tab :
      659     define input  parameter i-tableSerach as character no-undo.
      660     define input  parameter i-tablekey   as character  no-undo.
      661     define input  parameter p-key-rec    as character  no-undo.
      662     define input  parameter p-key-handle as handle     no-undo .
      663     define input  parameter p-db-name    as character  no-undo .
      664     define input  parameter p-tt-handle  as handle     no-undo .
      665     define output parameter o-Where      as character  no-undo.
      666     do
      667     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      668     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      669     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      670     :
      671       define variable v-full-tbl-name  as character no-undo .
      672       define variable bh_tbl-name      as handle    no-undo .
      673       define variable fh_key           as handle    no-undo .
      674       define variable fh_search        as handle    no-undo .
      675       define variable v-field-num      as integer   no-undo .
      676       define variable v-count-fld      as integer   no-undo .
      677       define variable v-inform         as character no-undo .
      678       define variable v-ind            as integer   no-undo .
      679       define variable v-idx-field-qnty as integer   no-undo .
      680       define variable v-field-name     as character no-undo .
      681       define variable v-field-val      as character no-undo .
      682       define variable v-word-link      as character no-undo .
      683       define variable vTable           as character no-undo.
      684       define variable bh_tbl-key       as handle    no-undo .
      685       assign
      686         p-key-rec = trim( p-key-rec )
      687       .
      688       if p-key-handle <> ? then do:
      689         if not valid-handle(p-key-handle)
      690            or p-key-handle:type <> "buffer"
      691         then do:
      692           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info3 ).
      693         end.
      694         if num-entries( p-key-rec, chr(3) ) > 1
      695           or p-key-rec = ?
      696           or p-key-rec = "":U
      697         then do:
      698           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info3, p-key-rec ).
      699         end.
      700       end.
      701       else do:
      702         if p-key-rec = ?
      703           or p-key-rec = "":U
      704         then do:
      705           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info3 ).
      706         end.
      707       end.
      708       assign
      709         vTable = entry( 1 , p-key-rec, chr(3) )
      710       .
      711       if p-tt-handle <> ?
      712         and ( not valid-handle(p-tt-handle)
      713               or p-tt-handle:type <> "buffer"
      714             )
      715       then do:
      716         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info3, vTable, chr(10) ).
      717       end.
      718       if p-tt-handle = ? then do:
      719         assign
      720           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      721         .
      722         create buffer bh_tbl-name for table v-full-tbl-name .
      723       end.
      724       else do:
      725         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      726       end.
      727       assign
      728         v-inform = bh_tbl-name:index-information(1)
      729         v-ind    = 2
      730       .
      731       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      732       on error undo, return error
      733       :
      734         assign
      735           v-inform = bh_tbl-name:index-information( v-ind )
      736           v-ind    = v-ind + 1
      737         .
      738       end.
      739       if v-inform = ?
      740         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      741         or entry( 3, v-inform, ",":U ) <> "1":U
      742       then do:
      743         delete object bh_tbl-name no-error.
      744         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info3, vTable ).
      745       end.
      746       assign
      747         v-idx-field-qnty = num-entries( v-inform ) - 4
      748       .
      749       if v-idx-field-qnty < 2 then do:
      750         delete object bh_tbl-name no-error.
      751         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info3, v-inform, vTable ).
      752       end.
      753       assign
      754         o-where     = "where":U
      755         v-word-link = "":U
      756         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      757         v-count-fld = 0
      758       .
      759       if i-tablekey ne "" and i-tablekey ne ?
      760       then do:
      761         assign
      762           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      763         .
      764         create buffer bh_tbl-key for table v-full-tbl-name .
      765       end.
      766       if i-tableSerach ne "" and i-tableSerach ne ?
      767       then do:
      768         delete object bh_tbl-name no-error.
      769         assign
      770           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      771         .
      772         create buffer bh_tbl-name for table v-full-tbl-name .
      773       end.
      774       block_where:
      775       do v-ind = 1 to v-idx-field-qnty by 2
      776       on error undo, return error
      777       :
      778         assign
      779           v-count-fld = v-count-fld + 1
      780         .
      781         if p-key-handle = ?
      782           and v-count-fld > v-field-num
      783         then do:
      784           leave block_where.
      785         end.
      786         define variable VfieldKeyTable as handle no-undo.
      787         assign
      788           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      789           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      790         .
      791         if     bh_tbl-key ne ?
      792         then do:
      793            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      794            if VfieldKeyTable eq ?
      795            then next block_where.
      796         end.
      797         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      798         then
      799            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      800         else
      801            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      802         if p-key-handle = ? then do:
      803           assign
      804             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      805           .
      806         end.
      807         else do:
      808           assign
      809             fh_key = p-key-handle:buffer-field( v-field-name )
      810           .
      811           if fh_key = ?
      812             or not valid-handle( fh_key )
      813           then do:
      814             delete object bh_tbl-name.
      815             if     bh_tbl-key ne ?
      816             then
      817                delete object bh_tbl-key.
      818             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info3, p-key-handle:name, v-field-name ).
      819           end.
      820           assign
      821             v-field-val = fh_key:buffer-value
      822           .
      823         end.
      824         if fh_search:data-type ="character":U then do:
      825           assign
      826             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      827             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      828             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      829             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      830             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      831             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      832             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      833             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      834             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      835             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      836             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      837             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      838             v-field-val = substitute( '"&1"', v-field-val )
      839           .
      840         end.
      841         assign
      842           o-where = substitute( "&1 &2", o-where, v-field-val )
      843         .
      844         if v-word-link = "":U then do:
      845           assign
      846             v-word-link = "and":U
      847           .
      848         end.
      849       end.
      850       delete object bh_tbl-name.
      851       if     bh_tbl-key ne ?
      852       then
      853          delete object bh_tbl-key.
      854       if p-key-handle = ?
      855         and v-count-fld <> v-field-num
      856       then do:
      857         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info3, vTable ).
      858       end.
      859     end.
      860   end procedure.
      861   procedure gen-hn-keyr-tab :
      862     define input  parameter i-tableSerach as character no-undo.
      863     define input  parameter i-tablekey   as character no-undo.
      864     define input  parameter p-key-rec    as character no-undo.
      865     define input  parameter p-key-handle as handle    no-undo .
      866     define input  parameter p-db-name    as character no-undo .
      867     define input  parameter p-tt-handle  as handle    no-undo .
      868     define input  parameter p-stts-lock  as integer   no-undo .
      869     define output parameter o-hn         as handle    no-undo.
      870     define variable v-full-tbl-name as character no-undo.
      871     define variable v-where         as character no-undo.
      872     define variable bh_tbl-name     as handle    no-undo.
      873     define variable vTable          as character no-undo.
      874     do
      875     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      876     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      877     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      878         run gen-where-keyr-tab(i-tableSerach,
      879                                i-tablekey,
      880                                p-key-rec,
      881                                p-key-handle,
      882                                p-db-name,
      883                                p-tt-handle,
      884                                output v-where).
      885         if i-tableSerach ne "" and i-tableSerach ne ?
      886         then do:
      887            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      888            create buffer bh_tbl-name for table v-full-tbl-name .
      889         end.
      890         else do:
      891            if p-tt-handle = ? then do:
      892               assign
      893                  vTable = entry( 1 , p-key-rec, chr(3) )
      894               .
      895               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      896               create buffer bh_tbl-name for table v-full-tbl-name .
      897            end.
      898            else do:
      899               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      900            end.
      901         end.
      902         if p-tt-handle = ? then do:
      903            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      904         end.
      905         else do:
      906            bh_tbl-name:find-first( v-where ) no-error .
      907         end.
      908         o-hn = bh_tbl-name.
      909      end.
      910   end procedure.
      911   procedure gen-hn-keyr :
      912     define input  parameter p-key-rec    as character no-undo.
      913     define input  parameter p-key-handle as handle    no-undo .
      914     define input  parameter p-db-name    as character no-undo .
      915     define input  parameter p-tt-handle  as handle    no-undo .
      916     define input  parameter p-stts-lock  as integer   no-undo .
      917     define output parameter o-hn         as handle    no-undo.
      918     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      919   end.
      920   procedure gen-row-keyr :
      921     define input  parameter p-key-rec    as character no-undo.
      922     define input  parameter p-key-handle as handle    no-undo .
      923     define input  parameter p-db-name    as character no-undo .
      924     define input  parameter p-tt-handle  as handle    no-undo .
      925     define input  parameter p-stts-lock  as integer   no-undo .
      926     define output parameter p-tbl-row    as rowid     no-undo.
      927     define output parameter p-tbl-name   as character no-undo.
      928     define variable vHn as handle no-undo.
      929       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      930       p-tbl-row = if vHn:available then vHn:rowid else ?.
      931       p-tbl-name =  vHn:table.
      932       delete object vHn no-error.
      933     if p-tbl-row = ? then do:
      934       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info3, p-tbl-name, p-key-rec ).
      935     end.
      936     else do:
      937       return.
      938     end.
      939   end procedure.
      940   procedure gen-key-fv :
      941     define input  parameter p-key-rec    as character no-undo .
      942     define output parameter p-field-list as character no-undo .
      943     define output parameter p-value-list as character no-undo.
      944     do
      945     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      946     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      947     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      948     :
      949       define variable v-full-tbl-name  as character no-undo .
      950       define variable bh_tbl-name      as handle    no-undo .
      951       define variable v-tbl-name       as character no-undo .
      952       define variable v-field-num      as integer   no-undo .
      953       define variable v-count-fld      as integer   no-undo .
      954       define variable v-inform         as character no-undo .
      955       define variable v-ind            as integer   no-undo .
      956       define variable v-idx-field-qnty as integer   no-undo .
      957       define variable v-delim-key      as character no-undo .
      958       if p-key-rec = ?
      959         or p-key-rec = "":U
      960       then do:
      961         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info3 ).
      962       end.
      963       assign
      964         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      965         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      966       .
      967       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      968       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info3 ).
      969       assign
      970         v-inform = bh_tbl-name:index-information(1)
      971         v-ind    = 2
      972       .
      973       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      974       on error undo, return error
      975       :
      976         assign
      977           v-inform = bh_tbl-name:index-information( v-ind )
      978           v-ind    = v-ind + 1
      979         .
      980       end.
      981       if v-inform = ?
      982         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      983         or entry( 3, v-inform, ",":U ) <> "1":U
      984       then do:
      985         delete object bh_tbl-name no-error.
      986         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info3, v-tbl-name ).
      987       end.
      988       assign
      989         v-idx-field-qnty = num-entries( v-inform ) - 4
      990       .
      991       if v-idx-field-qnty < 2 then do:
      992         delete object bh_tbl-name no-error.
      993         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info3, v-inform, v-tbl-name ).
      994       end.
      995       assign
      996         p-field-list = "":U
      997         p-value-list = "":U
      998         v-delim-key  = "":U
      999         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
     1000         v-count-fld  = 0
     1001       .
     1002       block_where:
     1003       do v-ind = 1 to v-idx-field-qnty by 2
     1004       on error undo, return error
     1005       :
     1006         assign
     1007           v-count-fld = v-count-fld + 1
     1008         .
     1009         if v-count-fld > v-field-num then do:
     1010           leave block_where.
     1011         end.
     1012         assign
     1013           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
     1014           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
     1015         .
     1016         if v-ind = 1 then do:
     1017           assign
     1018             v-delim-key = chr(3)
     1019           .
     1020         end.
     1021       end.
     1022       delete object bh_tbl-name.
     1023       if v-count-fld <> v-field-num then do:
     1024         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info3, v-tbl-name ).
     1025       end.
     1026     end.
     1027   end procedure.
     1028   procedure gen-key-field :
     1029     define input  parameter p-table      as character no-undo .
     1030     define output parameter p-field-list as character no-undo .
     1031     do
     1032     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1033     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1034     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1035     :
     1036       define variable v-full-tbl-name  as character no-undo .
     1037       define variable bh_tbl-name      as handle    no-undo .
     1038       define variable v-tbl-name       as character no-undo .
     1039       define variable v-field-num      as integer   no-undo .
     1040       define variable v-count-fld      as integer   no-undo .
     1041       define variable v-inform         as character no-undo .
     1042       define variable v-ind            as integer   no-undo .
     1043       define variable v-idx-field-qnty as integer   no-undo .
     1044       define variable v-delim-key      as character no-undo .
     1045       if p-table = ?
     1046         or p-table = "":U
     1047       then do:
     1048         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info3 ).
     1049       end.
     1050       assign
     1051         v-tbl-name      = p-table
     1052         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1053       .
     1054       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1055       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info3 ).
     1056       assign
     1057         v-inform = bh_tbl-name:index-information(1)
     1058         v-ind    = 2
     1059       .
     1060       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1061       on error undo, return error
     1062       :
     1063         assign
     1064           v-inform = bh_tbl-name:index-information( v-ind )
     1065           v-ind    = v-ind + 1
     1066         .
     1067       end.
     1068       if v-inform = ?
     1069         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1070         or entry( 3, v-inform, ",":U ) <> "1":U
     1071       then do:
     1072         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info3, v-tbl-name ).
     1073       end.
     1074       assign
     1075         v-idx-field-qnty = num-entries( v-inform ) - 4
     1076       .
     1077       if v-idx-field-qnty < 2 then do:
     1078         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info3, v-inform, v-tbl-name ).
     1079       end.
     1080       assign
     1081         p-field-list = "":U
     1082         v-delim-key  = "":U
     1083         v-count-fld  = 0
     1084       .
     1085       block_where:
     1086       do v-ind = 1 to v-idx-field-qnty by 2
     1087       on error undo, return error
     1088       :
     1089         assign
     1090           v-count-fld = v-count-fld + 1
     1091         .
     1092         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
     1093         if v-ind = 1 then do:
     1094           assign
     1095             v-delim-key = chr(3)
     1096           .
     1097         end.
     1098       end.
     1099       delete object bh_tbl-name.
     1100     end.
     1101   end procedure.
     1102   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1103   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1104   FUNCTION propreft-Date-to-String returns character(input  p-date as date):
     1105   define variable v-date-str as character no-undo .
