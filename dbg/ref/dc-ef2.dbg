     1108                string(Month(p-date), "99":U) + chr(47) +
     1109                string(DAY(p-date), "99":U).
     1110   return v-date-str.
     1111   END FUNCTION.
     1112   function propreft-string-to-date returns date ( input p-string  as character):
     1113     define variable v-date as date no-undo .
     1114     assign
     1115     v-date = date(integer(substring(p-string, 6, 2))
     1116                   ,integer(substring(p-string, 9, 2))
     1117                   ,integer(substring(p-string, 1, 4))
     1118                  ) no-error .
     1119     if error-status:error then return ?.
     1120     return v-date.
     1121   END FUNCTION.
