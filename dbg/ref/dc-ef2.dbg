     1157   procedure xml-cd-write-header:
     1158   do
     1159   on error undo, return error
     1160   :
     1161   define input parameter p-xml-file-name       as character    no-undo.
     1162   define input parameter p-xml-file-name-path  as character    no-undo.
     1163   define input parameter p-doc-name            as character    no-undo.
     1164   define input parameter p-version             as character    no-undo.
     1165   define input parameter p-obj-list            as character    no-undo.
     1166   define input parameter p-correspondent       as character    no-undo .
     1167   define input parameter p-write-header        as logical      no-undo .
     1168   define variable OS-time as character no-undo .
     1169   define variable id as character no-undo .
     1170   define buffer buf_db for ub.db.
     1171   output stream stmXMLOut to value( p-xml-file-name-path + "xm1":U ) convert target "1251" append.
     1172   put stream stmXMLOut unformatted "<?xml version='1.0' encoding='windows-1251'?>".
     1173   assign
     1174   OS-time =  string( ( today - date( "01/01/1996" ) ) * 24 * 3600 + time, ">>>>>>>>9" )
     1175   .
     1176   run bgelib-tag-open in this-procedure (
     1177                                        1
     1178                                       ,p-doc-name
     1179                                       ,substitute("type='REQUEST' id='&1' from='&2' to='&3' tstamp='&4'", p-xml-file-name, p-obj-list, p-correspondent, OS-time )
     1180                                         ).
     1181   if p-write-header then do:
     1182     run bgelib-tag-open(2, "Header","").
     1183     run bgelib-tag-put( 3, "DocumentName", p-doc-name, 1).
     1184     run bgelib-tag-put( 3, "DateFormat", "DD.MM.YYYY":U, 1).
     1185     run bgelib-tag-put( 3, "DocumentVersion", "1.02":U, 1).
     1186     run bgelib-tag-put( 3, "DocumentVersionDate", "09.09.2004":U, 1).
     1187     run bgelib-tag-put( 3, "ExportDate", string(today, "99.99.9999":U), 1).
     1188     run bgelib-tag-put( 3, "ExportTime", string(time, "hh:mm:ss":U), 1).
     1189     run bgelib-tag-put( 3, "objList",             p-obj-list                    , 1).
     1190     find first buf_db where buf_db.db-num = g#db-num no-lock.
     1191     run bgelib-tag-put( 3, "dbEncKey",            buf_db.db-key-enc, 1).
     1192     run bgelib-tag-close( 2, "Header" ).
     1193   end.
     1194   output stream stmXMLOut close.
     1195   end.
     1196   end procedure.
     1197   procedure xml-cd-write-footer:
     1198   do
     1199   on error undo, return error
     1200   :
     1201   define input parameter p-pos-type      like ub.cash-desk.pos-type no-undo .
     1202   define input parameter p-xml-file-name as character    no-undo.
     1203   define input parameter p-doc-name      as character    no-undo .
     1204   define variable v-error-num     as integer           no-undo.
     1205   define variable v-md5-signature as character no-undo .
     1206   output stream stmXMLOut to value( p-xml-file-name + "xm1" ) convert target "1251" append.
     1207   run bgelib-tag-close( 0, p-doc-name ).
     1208   put stream stmXMLOut unformatted skip.
     1209   output stream stmXMLOut close.
     1210   run bge/os_copy.p ("M", p-xml-file-name + "xm1", p-xml-file-name + "xml", output v-error-num ).
     1211   if v-error-num > 0
     1212   then do:
     1213      return error.
     1214   end.
     1215   if opsys = "unix"
     1216   then do:
     1217       os-command silent chmod 666 value (p-xml-file-name + "xml") 2>/dev/null.
     1218   end.
     1219   end.
     1220   end procedure.
     1221   procedure xml-cd-filename :
     1222   do
     1223   on error undo, return error
     1224   :
     1225   define input parameter  p-out               as character no-undo .
     1226   define output parameter p-xml-file-name     as character    no-undo.
     1227   define output parameter p-xml-file-name-path   as character    no-undo.
     1228   define output parameter p-log-file-name     as character    no-undo.
     1229   define output parameter p-locked            as logical      no-undo.
     1230   define variable v-out as character     no-undo.
     1231   define variable loc#log as logical no-undo .
     1232   define variable BadFlag as logical no-undo .
     1233   define variable fq as integer no-undo .
     1234   define variable v-remote as character no-undo .
     1235   assign
     1236   p-xml-file-name = substring( string( next-value( s-spool, ub), '99999999999999999999'), 13, 8 )
     1237   p-xml-file-name-path = p-out + p-xml-file-name + ".":U
     1238   p-log-file-name = p-out + "actions.log"
     1239   p-locked = ( search ( p-xml-file-name-path + "lk" ) <> ? )
     1240   .
     1241   end.
     1242   end procedure.
     1243   FUNCTION Xml-CD-DatetoString returns character(input  p-date as date):
     1244   define variable v-date-str as character no-undo .
