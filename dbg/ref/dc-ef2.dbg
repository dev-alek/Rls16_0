     1260   function string-to-date returns date ( input p-string  as character):
     1261     define variable v-date as date no-undo .
     1262     assign
     1263     v-date = date(integer(substring(p-string, 4, 2))
     1264                   ,integer(substring(p-string, 1, 2))
     1265                   ,integer(substring(p-string, 7, 4))
     1266                  ) no-error .
     1267     if error-status:error then return ?.
     1268     return v-date.
     1269   END FUNCTION.
     1270   FUNCTION string-IS0-8601-to-sec returns integer (input p-string-iso-8601 as character ):
     1271   define variable v-time as integer no-undo init ?.
     1272   define variable v-dop1 as character no-undo .
     1273   define variable v-dop2 as character no-undo .
     1274   assign
     1275   v-dop1 = entry(1, p-string-iso-8601, chr(32) )
     1276   v-dop2 = entry(2, p-string-iso-8601, chr(32) )
     1277   no-error .
     1278   if error-status:error then return ?.
     1279   assign
     1280   v-time =  integer(entry(1, v-dop2, ";":U)) * 3600 +
     1281             integer(entry(2, v-dop2, ";":U)) * 60 +
     1282             integer(entry(3, v-dop2, ";":U)) no-error .
     1283   return v-time.
     1284   END FUNCTION.
     1285   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1286   def var vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1287   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1288   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1289   define temp-table temp-ef no-undo
     1290   field d-card as character
     1291   field car-reg-number as character label "Госрег. номер"
     1292   field car-brand as character  label "Марка трансп. ср-ва"
     1293   index pi is unique primary
     1294   d-card
     1295   .
     1296   DEFINE TEMP-TABLE temp-ef1 NO-UNDO
     1297   field d-card as character
     1298   FIELD rfn-code AS character  format "X(16)"  label "Номер RFN"
     1299   FIELD limit AS decimal     label "Максимальный!объем"
     1300   FIELD status_ AS logical  label "Статус"
     1301   field name as character
     1302   field new_ as logical
     1303   INDEX pi IS UNIQUE PRIMARY
     1304   d-card
     1305   rfn-code
     1306   INDEX ip rfn-code
     1307   INDEX name d-card name
     1308   .
     1309   procedure fill-main-table :
     1310   define input parameter p-d-card as character no-undo .
     1311   define parameter buffer buf_dis-card for ub.dis-card.
     1312   define buffer buf_temp-dis-card-property for temp-dis-card-property.
     1313   define buffer buf_temp-ef for temp-ef.
     1314   do
     1315   on error undo, return error
     1316   :
     1317     for each buf_temp-ef:
     1318       delete buf_temp-ef.
     1319     end.
     1320     create buf_temp-ef.
     1321     if available buf_dis-card then do:
     1322       assign
     1323       buf_temp-ef.d-card = p-d-card
     1324       .
     1325     end.
     1326     else do:
     1327       assign
     1328       buf_temp-ef.d-card = p-d-card.
     1329     end.
     1330    FOR EACH temp-dis-card-property where
     1331          temp-dis-card-property.d-card = p-d-card
     1332       and temp-dis-card-property.dtm-code = 33
     1333       :
     1334      CASE temp-dis-card-property.node-code:
     1335        WHEN 1 THEN DO:
     1336          buf_temp-ef.car-reg-number = temp-dis-card-property.property-value-character.
     1337        END.
     1338        WHEN 2 THEN DO:
     1339           buf_temp-ef.car-brand = temp-dis-card-property.property-value-character.
     1340        END.
     1341      END CASE.
     1342    END.
     1343    RUN fill-tables IN THIS-PROCEDURE ( buffer buf_temp-ef) NO-ERROR.
     1344   end.
     1345   end procedure.
     1346   PROCEDURE fill-tables :
     1347   define parameter buffer buf_temp-ef for temp-ef.
     1348   DEFINE VARIABLE v-ii AS INTEGER NO-UNDO.
     1349   DEFINE VARIABLE v-gds-code AS INTEGER NO-UNDO.
     1350   define buffer buf_ext-classif for ub.ext-classif.
     1351       for each buf_ext-classif no-lock where buf_ext-classif.classif-subject = buf_temp-ef.d-card and
     1352                                              buf_ext-classif.classif-name = "easyfuel2-rfn" :
     1353         find first temp-ef1 no-lock where temp-ef1.d-card   = buf_temp-ef.d-card and
     1354                                           temp-ef1.name     = buf_ext-classif.classif-name and
     1355                                           temp-ef1.rfn-code = buf_ext-classif.CharKey_One no-error.
     1356         if not available temp-ef1 then do :
     1357           create temp-ef1.
     1358           assign
     1359             temp-ef1.d-card = buf_temp-ef.d-card
     1360             temp-ef1.name   = buf_ext-classif.classif-name
     1361             temp-ef1.rfn-code = buf_ext-classif.CharKey_One
     1362             temp-ef1.limit = decimal(buf_ext-classif.CharKey_Two)
     1363             temp-ef1.status_ = logical(buf_ext-classif.CharKey_Three)
     1364           .
     1365         end.
     1366       end.
     1367   END PROCEDURE.
     1368   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1369   function usrfulnf returns character ( input p-user-id as character):
     1370   define variable v-user-name as character no-undo .
     1371   define variable vss-include-info14 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1372   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run usrfulnm in g#library
     1373     (input  p-user-id
     1374     ,output v-user-name
     1375     ) no-error .
     1376   if error-status:error
     1377   or v-user-name = ""
     1378   then do:
     1379     return p-user-id.
     1380   end.
     1381   else do:
     1382     return v-user-name.
     1383   end.
     1384   end function.
     1385   define variable is-ef-chr as character no-undo .
     1386   define variable par-type as character no-undo .
     1387   define variable v-init-mode as logical no-undo .
     1388   define buffer buf_prop-head for ub.prop-head.
     1389   define buffer buf_prop-ref for ub.prop-ref.
     1390   DEFINE BUFFER buf_dis-card-type FOR ub.dis-card-type.
     1391   DEFINE BUTTON b-add
     1392        LABEL "Добавить"
     1393        SIZE 17 BY 1.
     1394   DEFINE BUTTON b-card
     1395        LABEL "Карта"
     1396        SIZE 10 BY 1.
     1397   DEFINE BUTTON b-cli
     1398        LABEL "Клиент"
     1399        SIZE 10 BY 1.
     1400   DEFINE BUTTON b-del
     1401        LABEL "Удалить"
     1402        SIZE 17 BY 1.
     1403   DEFINE BUTTON B-exit AUTO-GO
     1404        LABEL "&Ввод"
     1405        SIZE 10 BY 1
     1406        BGCOLOR 8 .
     1407   DEFINE BUTTON B-Help
     1408        LABEL "Помо&щь"
     1409        SIZE 3 BY 1
     1410        BGCOLOR 8 .
     1411   DEFINE BUTTON b-quit AUTO-END-KEY
     1412        LABEL "&Отмена"
     1413        SIZE 10 BY 1
     1414        BGCOLOR 8 .
     1415   DEFINE VARIABLE f-car-brand AS CHARACTER FORMAT "X(256)":U
     1416        LABEL "Марка ТС"
     1417        VIEW-AS FILL-IN
     1418        SIZE 26 BY 1.07 NO-UNDO.
     1419   DEFINE VARIABLE f-car-reg-number AS CHARACTER FORMAT "X(10)":U
     1420        LABEL "Гос.рег.знак"
     1421        VIEW-AS FILL-IN
     1422        SIZE 11 BY 1 NO-UNDO.
     1423   DEFINE QUERY br-ef1 FOR
     1424         temp-ef1 SCROLLING.
     1425   DEFINE BROWSE br-ef1
     1426     QUERY br-ef1 DISPLAY
     1427         temp-ef1.rfn-code COLUMN-LABEL "Номер RFN" format "X(16)"
     1428    temp-ef1.limit COLUMN-LABEL "Максимальный!Объем"
     1429    temp-ef1.status_ COLUMN-LABEL "Метка!активна" view-as toggle-box
     1430    ENABLE
     1431    temp-ef1.rfn-code
     1432    temp-ef1.limit
     1433    temp-ef1.status_
     1434       WITH NO-ROW-MARKERS SEPARATORS SIZE 40 BY 12.8 FIT-LAST-COLUMN.
     1435   DEFINE FRAME Dialog-Frame
     1436        B-exit AT ROW 1 COL 1
     1437        b-quit AT ROW 1 COL 11
     1438        b-card AT ROW 1 COL 21 WIDGET-ID 36
     1439        b-cli AT ROW 1 COL 31 WIDGET-ID 38
     1440        B-Help AT ROW 1 COL 41 WIDGET-ID 120
     1441        f-car-brand AT ROW 2.33 COL 14 COLON-ALIGNED
     1442        f-car-reg-number AT ROW 3.93 COL 14 COLON-ALIGNED
     1443        b-add AT ROW 5.27 COL 1 WIDGET-ID 28
     1444        b-del AT ROW 5.27 COL 18 WIDGET-ID 46
     1445        br-ef1 AT ROW 6.33 COL 1 WIDGET-ID 100
     1446       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1447            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1448            TITLE "Идентификаторы EasyFuel2"
     1449            DEFAULT-BUTTON B-exit CANCEL-BUTTON b-quit.
     1450   ASSIGN
     1451          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1452          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1453   ON END-ERROR OF FRAME Dialog-Frame
     1454   DO:
     1455     RUN undo-proc IN THIS-PROCEDURE NO-ERROR.
     1456   END.
     1457   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1458   DO:
     1459     APPLY "END-ERROR":U TO SELF.
     1460   END.
     1461   ON CHOOSE OF b-add IN FRAME Dialog-Frame
     1462   DO:
     1463     DEFINE VARIABLE v-rid-list AS CHARACTER NO-UNDO.
     1464     define VARIABLE v-tbl-row    as rowid     no-undo.
     1465     define variable v-tbl-name   as character no-undo.
     1466     define variable v-sum-id   as character no-undo.
     1467     DEFINE VARIABLE v-gds-code AS INTEGER NO-UNDO.
     1468     define variable v-recid as recid no-undo .
     1469     DEFINE BUFFER buf_goods FOR ub.goods.
     1470     DEFINE BUFFER buf_ext-classif FOR ub.ext-classif.
     1471     DEFINE BUFFER buf_temp-ef1 FOR temp-ef1.
     1472     DEFINE BUFFER buf_prop-ref FOR ub.prop-ref.
     1473     CREATE buf_temp-ef1.
     1474     ASSIGN
     1475       buf_temp-ef1.name = "easyfuel2-rfn"
     1476       buf_temp-ef1.new_ = yes
     1477       buf_temp-ef1.d-card = p-d-card
     1478     .
     1479     buf_temp-ef1.rfn-code = "0".
     1480     assign
     1481     v-recid = recid(buf_temp-ef1)
     1482     .
     1483     OPEN QUERY br-ef1 FOR EACH temp-ef1 BY temp-ef1.rfn-code.
     1484     reposition  br-ef1 to recid v-recid no-error .
     1485     apply "ENTRY" to temp-ef1.rfn-code in browse br-ef1.
     1486   END.
     1487   ON CHOOSE OF b-card IN FRAME Dialog-Frame
     1488   DO:
     1489   DEFINE VARIABLE v-ri AS RECID NO-UNDO.
     1490     IF AVAILABLE X_dis-card THEN DO:
     1491         v-ri = RECID(X_dis-card).
     1492         run ref/dcardi.w ( INPUT parparentproc
     1493                           ,INPUT 'ПРОСМОТР':U
     1494                           ,INPUT X_dis-card.emitent-host-code
     1495                           ,INPUT v-cntxt-host-code-obj
     1496                           ,INPUT v-cntxt-obj-type
     1497                           ,INPUT v-cntxt-obj-code
     1498                           ,INPUT ?
     1499                           ,INPUT-OUTPUT v-ri) NO-ERROR.
     1500        IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1501     END.
     1502   END.
     1503   ON CHOOSE OF b-cli IN FRAME Dialog-Frame
     1504   DO:
     1505     IF AVAILABLE X_clients THEN DO:
     1506         run ref/showcli.p (
     1507          input parParentProc
     1508         ,input X_clients.obj-type
     1509         ,input X_clients.obj-code
     1510         ) NO-ERROR.
     1511      IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1512     END.
     1513   END.
     1514   ON CHOOSE OF b-del IN FRAME Dialog-Frame
     1515   DO:
     1516   DEFINE BUFFER buf_temp-ef1 FOR temp-ef1.
     1517   define buffer del_ext-classif for ub.ext-classif.
     1518     IF NOT AVAILABLE temp-ef1 THEN RETURN NO-APPLY.
     1519     FIND FIRST buf_temp-ef1 WHERE recid(buf_temp-ef1) = RECID(temp-ef1).
     1520     FIND FIRST del_ext-classif NO-LOCK WHERE
     1521               del_ext-classif.classif-subject = buf_temp-ef1.d-card
     1522           AND del_ext-classif.classif-name = buf_temp-ef1.name
     1523           AND del_ext-classif.CharKey_One  = buf_temp-ef1.rfn-code NO-ERROR.
     1524     IF AVAILABLE del_ext-classif THEN DO:
     1525         MESSAGE
     1526         "Нельзя удалить существующие лимиты"
     1527         VIEW-AS ALERT-BOX.
     1528         RETURN NO-APPLY.
     1529     END.
     1530     DELETE buf_temp-ef1.
     1531     OPEN QUERY br-ef1 FOR EACH temp-ef1 BY temp-ef1.rfn-code.
     1532     reposition  br-ef1 to ROW 1 no-error .
     1533   END.
     1534   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
     1535   DO:
     1536     RUN proc-save IN THIS-PROCEDURE NO-ERROR.
     1537     IF ERROR-STATUS:error THEN RETURN NO-APPLY.
     1538   END.
     1539   ON LEAVE OF
     1540   temp-ef1.rfn-code IN BROWSE br-ef1,
     1541   temp-ef1.limit in BROWSE br-ef1,
     1542   temp-ef1.status_ in BROWSE br-ef1 do:
     1543   define buffer buf_temp-ef1 for temp-ef1.
     1544   find first buf_temp-ef1 where recid(buf_temp-ef1) = recid(temp-ef1).
     1545   assign
     1546   buf_temp-ef1.rfn-code = (temp-ef1.rfn-code:screen-value in browse br-ef1)
     1547   buf_temp-ef1.limit = decimal(temp-ef1.limit:screen-value in browse br-ef1)
     1548   buf_temp-ef1.status_ = logical(temp-ef1.status_:screen-value in browse br-ef1)
     1549   .
     1550   END.
     1551   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1552   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1553   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1554   on help of frame Dialog-Frame
     1555   do:
     1556     run gbl/app_help.p
     1557       (input this-procedure :file-name
     1558       ,input ''
     1559       ,input ?
     1560       ) no-error.
     1561     if error-status :error then do:
     1562       message
     1563         "Ошибка при вызове помощи"
     1564         error-status :get-message(1)
     1565         view-as alert-box .
     1566     end.
     1567   end.
     1568   run minbtn-set in this-procedure .
     1569   on choose of b-help in frame Dialog-Frame
     1570   do:
     1571     apply "help":u to frame Dialog-Frame .
     1572   end.
     1573   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1574   procedure minbtn-set :
     1575       do
     1576           on error undo, return error return-value
     1577           :
     1578           define variable ii              as integer       no-undo .
     1579           define variable fh              as widget-handle no-undo .
     1580           define variable hh              as widget-handle no-undo .
     1581           define variable v-h             as handle        extent 4 no-undo .
     1582           define variable v-name-button   as character     no-undo .
     1583           define variable v-help-old-x    as decimal       no-undo .
     1584           define variable v-help-old-y    as decimal       no-undo .
     1585           define variable v-help-old-size as decimal       no-undo .
     1586           define variable v-frame-width   as decimal       no-undo .
     1587           define variable jj              as integer       no-undo .
     1588           do
     1589               on error undo, return error
     1590               :
     1591               assign
     1592                   v-frame-width = frame Dialog-Frame:width - 0.3
     1593                   fh            = frame Dialog-Frame:first-child
     1594                   hh            = fh:first-child
     1595                   ii            = 1
     1596                   .
     1597               do while valid-handle(hh):
     1598                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1599                   do:
     1600                       case lc(hh:name) :
     1601                           when "b-help" then
     1602                               do:
     1603                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1604                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1605                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1606                                   hh:TOOLTIP = "Помощь" .
     1607                                   v-help-old-x = hh:column .
     1608                                   v-help-old-y = hh:row    .
     1609                                   v-help-old-size = hh:width .
     1610                                   hh:width-chars = 2.5 .
     1611                               end.
     1612                           when "b-print" then
     1613                               do:
     1614                                   hh:load-image("cmp/b-print.bmp":u) .
     1615                                   hh:TOOLTIP = "Печать" .
     1616                                   v-h[ii] = hh:handle .
     1617                                   ii = ii + 1 .
     1618                                   hh:width-chars = 3 .
     1619                               end.
     1620                           when "b-history" or
     1621                           when "b-hist" then
     1622                               do:
     1623                                   hh:load-image("cmp/b-hist.bmp":u) .
     1624                                   hh:TOOLTIP = "История" .
     1625                                   v-h[ii] = hh:handle .
     1626                                   ii = ii + 1 .
     1627                                   hh:width-chars = 3 .
     1628                               end.
     1629                           when "b-sch" then
     1630                               do:
     1631                                   hh:load-image("cmp/b-sch.bmp":u) .
     1632                                   hh:TOOLTIP = "Установка Фильтра" .
     1633                                   v-h[ii] = hh:handle .
     1634                                   ii = ii + 1 .
     1635                                   hh:width-chars = 3 .
     1636                               end.
     1637                           when "b-hist-user" then
     1638                               do:
     1639                                   hh:load-image("cmp/b-hist.bmp":u) .
     1640                                   hh:TOOLTIP = "История пользователя" .
     1641                                   ii = ii + 1 .
     1642                               end.
     1643                       end case.
     1644                   end.
     1645                   hh = hh:next-sibling.
     1646               end.
     1647               b-help:column = v-frame-width - b-help:width-chars.
     1648               jj = 0.
     1649               repeat ii = 4 to 1 by -1 :
     1650                   if valid-handle (v-h[ii] ) then
     1651                   do:
     1652                       jj  = jj + 1 .
     1653                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1654                       v-h[ii]:row    = v-help-old-y .
     1655                   end.
     1656               end.
     1657           end.
     1658       end.
     1659   end procedure.
     1660   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1661   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1662   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1663   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1664   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1665   define variable v-diasize-current-frame-height as decimal   no-undo .
     1666   define variable v-diasize-change-size          as logical   no-undo .
     1667   define variable v-diasize-resize-button        as handle    no-undo .
     1668   define variable v-diasize-wndmax               as logical   no-undo .
     1669   define variable v-diasize-wndstore             as logical   no-undo .
     1670   define variable v-diasize-proc-name            as character no-undo .
     1671   define variable v-diasize-browse-handle        as handle    no-undo .
     1672   define variable v-diasize-browse-number        as integer   no-undo .
     1673   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1674   define temp-table temp-diasize-handle no-undo
     1675     field handle-value  as handle
     1676     field save-position as decimal
     1677     index xpk is primary unique handle-value
     1678     .
     1679   define temp-table temp-browse-handle no-undo
     1680     field browse-type   as character
     1681     field browse-number as integer
     1682     field browse-handle as handle
     1683     field original-size as decimal
     1684     index xpk is primary unique browse-type browse-number
     1685     index xie browse-type browse-handle
     1686   .
     1687   procedure diasize_change-height :
     1688     define input  parameter p-change-value  as decimal   no-undo .
     1689     define input  parameter p-move-resize   as logical   no-undo .
     1690     define variable v-field-group-handle    as handle    no-undo .
     1691     define variable v-object-handle         as handle    no-undo .
     1692     define variable v-frame-height          as decimal   no-undo .
     1693     define variable v-frame-virtual-height  as decimal   no-undo .
     1694     define variable v-browse-height         as decimal   no-undo .
     1695     define variable v-window-height         as decimal   no-undo .
     1696     define variable v-window-virtual-height as decimal   no-undo .
     1697     define variable v-change-sign           as integer   no-undo .
     1698     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1699     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1700     if p-change-value > 0
     1701     then do:
     1702       if frame Dialog-Frame :height + p-change-value
     1703           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1704       then do:
     1705         assign
     1706           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1707                           - (frame Dialog-Frame :height-chars)
     1708         .
     1709         if p-change-value <= 0
     1710         then do:
     1711           run diasize_position-resize-button in this-procedure .
     1712           return .
     1713         end.
     1714       end.
     1715     end.
     1716     if p-change-value < 0
     1717     then do:
     1718       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1719       then do:
     1720         assign
     1721           p-change-value = v-diasize-orig-frame-height
     1722                          - (frame Dialog-Frame :height-chars)
     1723         .
     1724         if p-change-value >= 0
     1725         then do:
     1726           run diasize_position-resize-button in this-procedure .
     1727           return .
     1728         end.
     1729       end.
     1730     end.
     1731     if p-change-value >= 0
     1732     then do:
     1733       assign
     1734         v-change-sign = 1
     1735       .
     1736     end.
     1737     else do:
     1738       assign
     1739         v-change-sign = -1
     1740       .
     1741     end.
     1742     assign
     1743       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1744     .
     1745     if p-change-value = 0
     1746     then do:
     1747       run diasize_position-resize-button in this-procedure .
     1748       return .
     1749     end.
     1750     move_block:
     1751     do
     1752     on error undo move_block, retry move_block
     1753     :
     1754       if retry
     1755       then do:
     1756         do
     1757         on error undo move_block, leave move_block
     1758         :
     1759           if p-change-value > 0
     1760           then do:
     1761             for each buf_temp-diasize-handle
     1762             on error undo, next
     1763             :
     1764               assign
     1765                 v-object-handle = buf_temp-diasize-handle.handle-value
     1766               .
     1767               if v-object-handle <> v-diasize-resize-button
     1768               then do:
     1769                 assign
     1770                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1771                 .
     1772               end.
     1773             end.
     1774             assign
     1775               v-diasize-browse-handle :height = v-browse-height
     1776             .
     1777             for each buf_temp-browse-handle
     1778               where buf_temp-browse-handle.browse-type = 'height':u
     1779             on error undo, next
     1780             :
     1781               assign
     1782                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1783               .
     1784             end.
     1785             assign
     1786               frame Dialog-Frame :height = v-frame-height
     1787             .
     1788             if frame Dialog-Frame :scrollable = true
     1789             then do:
     1790               assign
     1791                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1792               .
     1793             end.
     1794             run diasize_position-resize-button in this-procedure .
     1795           end.
     1796           else do:
     1797             if frame Dialog-Frame :scrollable = true
     1798             then do:
     1799               assign
     1800                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1801               .
     1802             end.
     1803             assign
     1804               frame Dialog-Frame :height = v-frame-height
     1805             .
     1806             assign
     1807               v-diasize-browse-handle :height = v-browse-height
     1808             .
     1809             for each buf_temp-browse-handle
     1810               where buf_temp-browse-handle.browse-type = 'height':u
     1811             on error undo, next
     1812             :
     1813               assign
     1814                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1815               .
     1816             end.
     1817             for each buf_temp-diasize-handle
     1818             on error undo, next
     1819             :
     1820               assign
     1821                 v-object-handle = buf_temp-diasize-handle.handle-value
     1822               .
     1823               if v-object-handle <> v-diasize-resize-button
     1824               then do:
     1825                 assign
     1826                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1827                 .
     1828               end.
     1829             end.
     1830             run diasize_position-resize-button in this-procedure .
     1831           end.
     1832           assign
     1833             v-diasize-change-size = false
     1834           .
     1835           leave move_block .
     1836         end.
     1837       end.
     1838       assign
     1839         v-diasize-need-full-display = true
     1840       .
     1841       if v-diasize-change-size = false
     1842       then do:
     1843         assign
     1844           v-diasize-change-size = true
     1845         .
     1846       end.
     1847       else do:
     1848         return .
     1849       end.
     1850       assign
     1851         v-frame-height = frame Dialog-Frame :height
     1852         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1853         v-browse-height = v-diasize-browse-handle :height
     1854       .
     1855       for each buf_temp-browse-handle
     1856         where buf_temp-browse-handle.browse-type = 'height':u
     1857       :
     1858         assign
     1859           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1860         .
     1861       end.
     1862       for each buf_temp-diasize-handle
     1863       :
     1864         delete buf_temp-diasize-handle .
     1865       end.
     1866       assign
     1867         v-field-group-handle = frame Dialog-Frame :first-child
     1868       .
     1869       do while valid-handle(v-field-group-handle)
     1870       :
     1871         assign
     1872           v-object-handle = v-field-group-handle :first-child
     1873         .
     1874         do while valid-handle(v-object-handle)
     1875         :
     1876           if  v-object-handle <> v-diasize-browse-handle :handle
     1877           and can-query(v-object-handle, "row")
     1878           and can-query(v-object-handle, "height")
     1879           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1880           then do:
     1881             find first buf_temp-browse-handle
     1882               where buf_temp-browse-handle.browse-type   = 'height':u
     1883                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1884               no-error .
     1885             if available buf_temp-browse-handle
     1886             then do:
     1887             end.
     1888             else do:
     1889               create buf_temp-diasize-handle .
     1890               assign
     1891                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1892                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1893               .
     1894             end.
     1895           end.
     1896           assign
     1897             v-object-handle = v-object-handle :next-sibling
     1898           .
     1899         end.
     1900         assign
     1901           v-field-group-handle = v-field-group-handle :next-sibling
     1902         .
     1903       end.
     1904       do with frame Dialog-Frame
     1905       :
     1906         hide v-diasize-resize-button .
     1907         assign
     1908           v-diasize-resize-button :row    = 1
     1909           v-diasize-resize-button :column = 1
     1910         .
     1911       end.
     1912       if p-change-value > 0
     1913       then do:
     1914         if frame Dialog-Frame :scrollable = true
     1915         then do:
     1916           assign
     1917             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1918             no-error .
     1919           if error-status :error
     1920           or error-status :get-message(1) <> ""
     1921           then do:
     1922             undo move_block, retry move_block .
     1923           end.
     1924         end.
     1925         assign
     1926           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1927           no-error .
     1928         if error-status :error
     1929         or error-status :get-message(1) <> ""
     1930         then do:
     1931           undo move_block, retry move_block .
     1932         end.
     1933         assign
     1934           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1935           no-error .
     1936         if error-status :error
     1937         or error-status :get-message(1) <> ""
     1938         then do:
     1939           undo move_block, retry move_block .
     1940         end.
     1941         for each buf_temp-browse-handle
     1942           where buf_temp-browse-handle.browse-type = 'height':u
     1943         on error undo move_block, retry move_block
     1944         :
     1945           assign
     1946             buf_temp-browse-handle.browse-handle :height
     1947               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1948             no-error .
     1949           if error-status :error
     1950           or error-status :get-message(1) <> ""
     1951           then do:
     1952             undo move_block, retry move_block .
     1953           end.
     1954         end.
     1955         for each buf_temp-diasize-handle
     1956         on error undo move_block, retry move_block
     1957         :
     1958           assign
     1959             v-object-handle = buf_temp-diasize-handle.handle-value
     1960           .
     1961           if v-object-handle <> v-diasize-resize-button
     1962           then do:
     1963             assign
     1964               v-object-handle :row = v-object-handle :row + p-change-value
     1965               no-error .
     1966             if error-status :error
     1967             or error-status :get-message(1) <> ""
     1968             then do:
     1969               undo move_block, retry move_block .
     1970             end.
     1971           end.
     1972         end.
     1973       end.
     1974       else do:
     1975         for each buf_temp-diasize-handle
     1976         on error undo move_block, retry move_block
     1977         :
     1978           assign
     1979             v-object-handle = buf_temp-diasize-handle.handle-value
     1980           .
     1981           if v-object-handle <> v-diasize-resize-button
     1982           then do:
     1983             assign
     1984               v-object-handle :row = v-object-handle :row + p-change-value
     1985               no-error .
     1986             if error-status :error
     1987             or error-status :get-message(1) <> ""
     1988             then do:
     1989               undo move_block, retry move_block .
     1990             end.
     1991           end.
     1992         end.
     1993         assign
     1994           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1995           no-error .
     1996         if error-status :error
     1997         or error-status :get-message(1) <> ""
     1998         then do:
     1999           undo move_block, retry move_block .
     2000         end.
     2001         for each buf_temp-browse-handle
     2002           where buf_temp-browse-handle.browse-type = 'height':u
     2003         on error undo move_block, retry move_block
     2004         :
     2005           assign
     2006             buf_temp-browse-handle.browse-handle :height
     2007               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2008             no-error .
     2009           if error-status :error
     2010           or error-status :get-message(1) <> ""
     2011           then do:
     2012             undo move_block, retry move_block .
     2013           end.
     2014         end.
     2015         assign
     2016           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2017           no-error .
     2018         if error-status :error
     2019         or error-status :get-message(1) <> ""
     2020         then do:
     2021           undo move_block, retry move_block .
     2022         end.
     2023         if frame Dialog-Frame :scrollable = true
     2024         then do:
     2025           assign
     2026             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2027             no-error .
     2028           if error-status :error
     2029           or error-status :get-message(1) <> ""
     2030           then do:
     2031             undo move_block, retry move_block .
     2032           end.
     2033         end.
     2034       end.
     2035       if p-move-resize = true
     2036       then do:
     2037         run diasize_position-resize-button in this-procedure .
     2038       end.
     2039       if v-diasize-wndstore = true
     2040       then do:
     2041         if connected("ub") = true
     2042         then do:
     2043           define variable v-cntxt-db-num        as integer   no-undo .
     2044           define variable v-cntxt-userid        as character no-undo .
     2045           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2046                                             , OUTPUT v-cntxt-userid
     2047                                             ) .
     2048           run gbl/wndsizew.p
     2049             (input  v-cntxt-db-num
     2050             ,input  v-cntxt-userid
     2051             ,input  v-diasize-proc-name
     2052             ,input  'height':u
     2053             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     2054             ) .
     2055         end.
     2056       end.
     2057     end.
     2058     assign
     2059       v-diasize-change-size = false
     2060     .
     2061   end procedure.
     2062   procedure diasize_set-height :
     2063     define input  parameter p-new-height  as decimal   no-undo .
     2064     define input  parameter p-move-resize as logical   no-undo .
     2065     do
     2066     on error undo, return error return-value
     2067     :
     2068       run diasize_change-height in this-procedure
     2069         (input  (p-new-height - frame Dialog-Frame :height)
     2070         ,input  p-move-resize
     2071         ) .
     2072     end.
     2073   end procedure.
     2074   procedure diasize_change-width :
     2075     define input  parameter p-change-value as decimal   no-undo .
     2076     define input  parameter p-move-resize  as logical   no-undo .
     2077     define variable v-field-group-handle   as handle    no-undo .
     2078     define variable v-object-handle        as handle    no-undo .
     2079     define variable v-frame-width          as decimal   no-undo .
     2080     define variable v-frame-virtual-width  as decimal   no-undo .
     2081     define variable v-browse-width         as decimal   no-undo .
     2082     define variable v-window-width         as decimal   no-undo .
     2083     define variable v-window-virtual-width as decimal   no-undo .
     2084     define variable v-change-sign          as integer   no-undo .
     2085     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2086     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2087     if p-change-value > 0
     2088     then do:
     2089       if frame Dialog-Frame :width + p-change-value >
     2090           session :width-chars
     2091       then do:
     2092         assign
     2093           p-change-value = session :width-chars - frame Dialog-Frame :width
     2094         .
     2095         if p-change-value <= 0
     2096         then do:
     2097           run diasize_position-resize-button in this-procedure .
     2098           return .
     2099         end.
     2100       end.
     2101     end.
     2102     if p-change-value < 0
     2103     then do:
     2104       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     2105       then do:
     2106         assign
     2107           p-change-value = v-diasize-orig-frame-width
     2108                          - frame Dialog-Frame :width
     2109         .
     2110         if p-change-value >= 0
     2111         then do:
     2112           run diasize_position-resize-button in this-procedure .
     2113           return .
     2114         end.
     2115       end.
     2116     end.
     2117     if p-change-value >= 0
     2118     then do:
     2119       assign
     2120         v-change-sign = 1
     2121       .
     2122     end.
     2123     else do:
     2124       assign
     2125         v-change-sign = -1
     2126       .
     2127     end.
     2128     assign
     2129       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2130     .
     2131     if p-change-value = 0
     2132     then do:
     2133       run diasize_position-resize-button in this-procedure .
     2134       return .
     2135     end.
     2136     move_block:
     2137     do
     2138     on error undo move_block, leave move_block
     2139     :
     2140       if retry
     2141       then do:
     2142         do
     2143         on error undo move_block, leave move_block
     2144         :
     2145           if p-change-value > 0
     2146           then do:
     2147             for each buf_temp-diasize-handle
     2148             on error undo, next
     2149             :
     2150               assign
     2151                 v-object-handle = buf_temp-diasize-handle.handle-value
     2152               .
     2153               if v-object-handle <> v-diasize-resize-button
     2154               then do:
     2155                 assign
     2156                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2157                 .
     2158               end.
     2159             end.
     2160             assign
     2161               v-diasize-browse-handle :width = v-browse-width
     2162             .
     2163             for each buf_temp-browse-handle
     2164               where buf_temp-browse-handle.browse-type = 'width':u
     2165             on error undo, next
     2166             :
     2167               assign
     2168                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2169               .
     2170             end.
     2171             assign
     2172               frame Dialog-Frame :width = v-frame-width
     2173             .
     2174             if frame Dialog-Frame :scrollable = true
     2175             then do:
     2176               assign
     2177                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2178               .
     2179             end.
     2180             run diasize_position-resize-button in this-procedure .
     2181           end.
     2182           else do:
     2183             if frame Dialog-Frame :scrollable = true
     2184             then do:
     2185               assign
     2186                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2187               .
     2188             end.
     2189             assign
     2190               frame Dialog-Frame :width = v-frame-width
     2191             .
     2192             for each buf_temp-browse-handle
     2193               where buf_temp-browse-handle.browse-type = 'width':u
     2194             on error undo, next
     2195             :
     2196               assign
     2197                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2198               .
     2199             end.
     2200             assign
     2201               v-diasize-browse-handle :width = v-browse-width
     2202             .
     2203             for each buf_temp-diasize-handle
     2204             on error undo, next
     2205             :
     2206               assign
     2207                 v-object-handle = buf_temp-diasize-handle.handle-value
     2208               .
     2209               if v-object-handle <> v-diasize-resize-button
     2210               then do:
     2211                 assign
     2212                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2213                 .
     2214               end.
     2215             end.
     2216             run diasize_position-resize-button in this-procedure .
     2217           end.
     2218           assign
     2219             v-diasize-change-size = false
     2220           .
     2221           leave move_block .
     2222         end.
     2223       end.
     2224       assign
     2225         v-diasize-need-full-display = true
     2226       .
     2227       if v-diasize-change-size = false
     2228       then do:
     2229         assign
     2230           v-diasize-change-size = true
     2231         .
     2232       end.
     2233       else do:
     2234         return .
     2235       end.
     2236       assign
     2237         v-frame-width = frame Dialog-Frame :width
     2238         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     2239         v-browse-width = v-diasize-browse-handle :width
     2240       .
     2241       for each buf_temp-browse-handle
     2242         where buf_temp-browse-handle.browse-type = 'width':u
     2243       :
     2244         assign
     2245           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2246         .
     2247       end.
     2248       for each buf_temp-diasize-handle
     2249       :
     2250         delete buf_temp-diasize-handle .
     2251       end.
     2252       assign
     2253         v-field-group-handle = frame Dialog-Frame :first-child
     2254       .
     2255       do while valid-handle(v-field-group-handle)
     2256       :
     2257         assign
     2258           v-object-handle = v-field-group-handle :first-child
     2259         .
     2260         do while valid-handle(v-object-handle)
     2261         :
     2262           if  v-object-handle <> v-diasize-browse-handle :handle
     2263           and v-object-handle <> v-diasize-resize-button
     2264           and can-query(v-object-handle, "row")
     2265           and can-query(v-object-handle, "height")
     2266           and ( v-object-handle :col + v-object-handle :width
     2267                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2268               )
     2269           then do:
     2270             find first buf_temp-browse-handle
     2271               where buf_temp-browse-handle.browse-type   = 'width':u
     2272                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2273               no-error .
     2274             if available buf_temp-browse-handle
     2275             then do:
     2276             end.
     2277             else do:
     2278               create buf_temp-diasize-handle .
     2279               assign
     2280                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2281                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2282               .
     2283             end.
     2284           end.
     2285           assign
     2286             v-object-handle = v-object-handle :next-sibling
     2287           .
     2288         end.
     2289         assign
     2290           v-field-group-handle = v-field-group-handle :next-sibling
     2291         .
     2292       end.
     2293       do with frame Dialog-Frame
     2294       :
     2295         hide v-diasize-resize-button .
     2296         v-diasize-resize-button :row = 1.
     2297         v-diasize-resize-button :column = 1.
     2298       end.
     2299       if p-change-value > 0
     2300       then do:
     2301         if frame Dialog-Frame :scrollable = true
     2302         then do:
     2303           assign
     2304             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2305             no-error .
     2306           if error-status :error
     2307           or error-status :get-message(1) <> ""
     2308           then do:
     2309             undo move_block, retry move_block.
     2310           end.
     2311         end.
     2312         assign
     2313           frame Dialog-Frame :width = v-frame-width + p-change-value
     2314           no-error .
     2315         if error-status :error
     2316         or error-status :get-message(1) <> ""
     2317         then do:
     2318           undo move_block, retry move_block.
     2319         end.
     2320         assign
     2321           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2322         no-error .
     2323         if error-status :error
     2324         or error-status :get-message(1) <> ""
     2325         then do:
     2326           undo move_block, retry move_block.
     2327         end.
     2328         for each buf_temp-browse-handle
     2329           where buf_temp-browse-handle.browse-type = 'width':u
     2330         on error undo move_block, retry move_block
     2331         :
     2332           assign
     2333             buf_temp-browse-handle.browse-handle :width
     2334               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2335             no-error .
     2336           if error-status :error
     2337           or error-status :get-message(1) <> ""
     2338           then do:
     2339             undo move_block, retry move_block .
     2340           end.
     2341         end.
     2342         for each buf_temp-diasize-handle
     2343         on error undo move_block, retry move_block
     2344         :
     2345           assign
     2346             v-object-handle = buf_temp-diasize-handle.handle-value
     2347           .
     2348           if v-object-handle <> v-diasize-resize-button
     2349           then do:
     2350             assign
     2351               v-object-handle :col = v-object-handle :col + p-change-value
     2352               no-error .
     2353             if error-status :error
     2354             or error-status :get-message(1) <> ""
     2355             then do:
     2356               undo move_block, retry move_block .
     2357             end.
     2358           end.
     2359         end.
     2360       end.
     2361       else do:
     2362         for each buf_temp-diasize-handle
     2363         on error undo move_block, retry move_block
     2364         :
     2365           assign
     2366             v-object-handle = buf_temp-diasize-handle.handle-value
     2367           .
     2368           if v-object-handle <> v-diasize-resize-button
     2369           then do:
     2370             assign
     2371               v-object-handle :col = v-object-handle :col + p-change-value
     2372               no-error .
     2373             if error-status :error
     2374             or error-status :get-message(1) <> ""
     2375             then do:
     2376               undo move_block, retry move_block .
     2377             end.
     2378           end.
     2379         end.
     2380         for each buf_temp-browse-handle
     2381           where buf_temp-browse-handle.browse-type = 'width':u
     2382         on error undo move_block, retry move_block
     2383         :
     2384           assign
     2385             buf_temp-browse-handle.browse-handle :width
     2386               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2387             no-error .
     2388           if error-status :error
     2389           or error-status :get-message(1) <> ""
     2390           then do:
     2391             undo move_block, retry move_block .
     2392           end.
     2393         end.
     2394         assign
     2395           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2396           no-error .
     2397         if error-status :error
     2398         or error-status :get-message(1) <> ""
     2399         then do:
     2400           undo move_block, retry move_block.
     2401         end.
     2402         assign
     2403           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2404         no-error .
     2405         if error-status :error
     2406         or error-status :get-message(1) <> ""
     2407         then do:
     2408           undo move_block, retry move_block.
     2409         end.
     2410         if frame Dialog-Frame :scrollable = true
     2411         then do:
     2412           assign
     2413             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2414           no-error .
     2415           if error-status :error
     2416           or error-status :get-message(1) <> ""
     2417           then do:
     2418             undo move_block, retry move_block.
     2419           end.
     2420         end.
     2421       end.
     2422       if p-move-resize
     2423       then do:
     2424         run diasize_position-resize-button in this-procedure .
     2425       end.
     2426       if v-diasize-wndstore = true
     2427       then do:
     2428         if connected("ub") = true
     2429         then do:
     2430           define variable v-cntxt-db-num        as integer   no-undo .
     2431           define variable v-cntxt-userid        as character no-undo .
     2432           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2433                                             , OUTPUT v-cntxt-userid
     2434                                             ) .
     2435           run gbl/wndsizew.p
     2436             (input  v-cntxt-db-num
     2437             ,input  v-cntxt-userid
     2438             ,input  v-diasize-proc-name
     2439             ,input  'width':u
     2440             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2441             ) .
     2442         end.
     2443       end.
     2444     end.
     2445     assign
     2446       v-diasize-change-size = false
     2447     .
     2448   end procedure.
     2449   procedure diasize_set-width :
     2450     define input  parameter p-new-width  as decimal   no-undo .
     2451     define input  parameter p-move-resize as logical   no-undo .
     2452     do
     2453     on error undo, return error return-value
     2454     :
     2455       run diasize_change-width in this-procedure
     2456         (input  (p-new-width - frame Dialog-Frame :width)
     2457         ,input  p-move-resize
     2458         ) .
     2459     end.
     2460   end procedure.
     2461   procedure diasize_position-resize-button :
     2462     do with frame Dialog-Frame
     2463     :
     2464       hide v-diasize-resize-button .
     2465       assign
     2466         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2467                     - 1
     2468                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2469         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2470                     - 1
     2471                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2472       .
     2473       view v-diasize-resize-button .
     2474     end.
     2475   end procedure.
     2476   on alt-right anywhere
     2477   do:
     2478     run diasize_change-width in this-procedure
     2479       (input 1
     2480       ,input true
     2481       ) .
     2482     return no-apply .
     2483   end.
     2484   on alt-left anywhere
     2485   do:
     2486     run diasize_change-width in this-procedure
     2487       (input -1
     2488       ,input true
     2489       ) .
     2490     return no-apply .
     2491   end.
     2492   on alt-down anywhere
     2493   do:
     2494     run diasize_change-height in this-procedure
     2495       (input 1
     2496       ,input true
     2497       ) .
     2498     return no-apply .
     2499   end.
     2500   on alt-up anywhere
     2501   do:
     2502     run diasize_change-height in this-procedure
     2503       (input -1
     2504       ,input true
     2505       ) .
     2506     return no-apply .
     2507   end.
     2508   on alt-enter of frame Dialog-Frame
     2509   do:
     2510     run diasize_maximize in this-procedure
     2511       (input  ?
     2512       ).
     2513     return no-apply .
     2514   end.
     2515   procedure diasize_end-move :
     2516     do
     2517     on error undo, return error return-value
     2518     :
     2519       define variable v-row-delta as decimal   no-undo .
     2520       define variable v-col-delta as decimal   no-undo .
     2521       define variable v-new-row as decimal   no-undo .
     2522       define variable v-new-col as decimal   no-undo .
     2523       assign
     2524         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2525         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2526       .
     2527       assign
     2528         v-row-delta = v-new-row - frame Dialog-Frame :height
     2529         v-col-delta = v-new-col - frame Dialog-Frame :width
     2530       .
     2531       run diasize_change-height in this-procedure
     2532         (input v-row-delta
     2533         ,input true
     2534         ) .
     2535       run diasize_change-width in this-procedure
     2536         (input v-col-delta
     2537         ,input true
     2538         ) .
     2539     end.
     2540   end procedure.
     2541   procedure diasize_maximize :
     2542     define input  parameter p-action as logical   no-undo .
     2543     do
     2544     on error undo, return error return-value
     2545     :
     2546       if p-action = ?
     2547       then do:
     2548         if v-diasize-need-maximize = true
     2549         then do:
     2550           assign
     2551             p-action = true
     2552           .
     2553         end.
     2554         else do:
     2555           assign
     2556             p-action = false
     2557           .
     2558         end.
     2559       end.
     2560       if p-action = true
     2561       then do:
     2562         run diasize_change-height in this-procedure
     2563           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2564               - frame Dialog-Frame :height-chars
     2565           ,input true
     2566           ) .
     2567         run diasize_change-width in this-procedure
     2568           (input session :width-chars
     2569               - frame Dialog-Frame :width-chars
     2570           ,input true
     2571           ) .
     2572         assign
     2573           v-diasize-need-maximize = false
     2574         .
     2575       end.
     2576       else do:
     2577         run diasize_change-width in this-procedure
     2578           (input v-diasize-orig-frame-width
     2579               - frame Dialog-Frame :width-chars
     2580           ,input true
     2581           ) .
     2582         run diasize_change-height in this-procedure
     2583           (input v-diasize-orig-frame-height
     2584               - frame Dialog-Frame :height-chars
     2585           ,input true
     2586           ) .
     2587         assign
     2588           v-diasize-need-maximize = true
     2589         .
     2590       end.
     2591     end.
     2592   end procedure.
     2593   procedure diasize_restore-orig-size :
     2594     do
     2595     on error undo, return error return-value
     2596     :
     2597       assign
     2598         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2599         v-diasize-current-frame-height = frame Dialog-Frame :height
     2600       .
     2601       run diasize_set-height in this-procedure
     2602         (input  v-diasize-orig-frame-height
     2603         ,input  true
     2604         ) .
     2605       run diasize_set-width in this-procedure
     2606         (input  v-diasize-orig-frame-width
     2607         ,input  true
     2608         ) .
     2609     end.
     2610   end procedure.
     2611   procedure diasize_restore-current-size :
     2612     do
     2613     on error undo, return error return-value
     2614     :
     2615       run diasize_set-height in this-procedure
     2616         (input  v-diasize-current-frame-height
     2617         ,input  true
     2618         ) .
     2619       run diasize_set-width in this-procedure
     2620         (input  v-diasize-current-frame-width
     2621         ,input  true
     2622         ) .
     2623     end.
     2624   end procedure.
     2625   procedure diasize_set-browse-handle :
     2626     define input  parameter p-browse-handle as handle   no-undo .
     2627     define buffer buf_temp-browse-handle for temp-browse-handle .
     2628     do
     2629     on error undo, return error return-value
     2630     :
     2631       assign
     2632         v-diasize-browse-handle = p-browse-handle
     2633       .
     2634       for each buf_temp-browse-handle
     2635       on error undo, return error return-value
     2636       :
     2637         delete buf_temp-browse-handle .
     2638       end.
     2639     end.
     2640   end procedure.
     2641   procedure diasize_add_browse :
     2642     define input  parameter p-browse-type   as character no-undo .
     2643     define input  parameter p-browse-handle as handle    no-undo .
     2644     define buffer buf_temp-browse-handle for temp-browse-handle .
     2645     do
     2646     on error undo, return error return-value
     2647     :
     2648       assign
     2649         v-diasize-browse-number = v-diasize-browse-number + 1
     2650       .
     2651       create buf_temp-browse-handle .
     2652       assign
     2653         buf_temp-browse-handle.browse-type   = p-browse-type
     2654         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2655         buf_temp-browse-handle.browse-handle = p-browse-handle
     2656       .
     2657     end.
     2658   end procedure.
     2659   procedure diasize_init :
     2660     define variable v-default-value    as logical   no-undo .
     2661     define variable v-restore-saved    as logical   no-undo .
     2662     define variable v-resize-value-str as character no-undo .
     2663     do
     2664     on error undo, return error return-value
     2665     :
     2666       do with frame Dialog-Frame
     2667       :
     2668         assign
     2669           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2670           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2671           v-diasize-browse-handle     = browse br-ef1 :handle
     2672         .
     2673         create button v-diasize-resize-button
     2674         assign
     2675           parent        = frame Dialog-Frame :first-child
     2676           label         = "s"
     2677           height-pixels = 16
     2678           width-pixels  = 16
     2679           visible       = true
     2680           sensitive     = true
     2681           movable       = true
     2682           triggers:
     2683             on end-move persistent run diasize_end-move in this-procedure .
     2684           end triggers.
     2685         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2686         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2687         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2688         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2689         assign
     2690           v-diasize-wndmax = false
     2691         .
     2692         if connected("ub") = true
     2693         then do:
     2694           define variable v-cntxt-db-num        as integer   no-undo .
     2695           define variable v-cntxt-userid        as character no-undo .
     2696           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2697                                             , OUTPUT v-cntxt-userid
     2698                                             ) .
     2699           run gbl/wndpar_r.p
     2700             (input  v-cntxt-db-num
     2701             ,input  v-cntxt-userid
     2702             ,input  'wndmax':U
     2703             ,output v-diasize-wndmax
     2704             ,output v-default-value
     2705             ) .
     2706         end.
     2707         assign
     2708           v-diasize-wndstore = false
     2709         .
     2710         if connected("ub") = true
     2711         then do:
     2712           run gbl/wndpar_r.p
     2713             (input  v-cntxt-db-num
     2714             ,input  v-cntxt-userid
     2715             ,input  'wndstore':U
     2716             ,output v-diasize-wndstore
     2717             ,output v-default-value
     2718             ) .
     2719         end.
     2720         assign
     2721           v-diasize-proc-name = entry(1, program-name(2), '.')
     2722         .
     2723         if v-diasize-wndstore = true
     2724         then do:
     2725           assign
     2726             v-restore-saved = false
     2727           .
     2728           if connected("ub") = true
     2729           then do:
     2730             run gbl/wndsizer.p
     2731               (input  v-cntxt-db-num
     2732               ,input  v-cntxt-userid
     2733               ,input  v-diasize-proc-name
     2734               ,input  'height':u
     2735               ,output v-resize-value-str
     2736               ) .
     2737             if v-resize-value-str <> '':U
     2738             then do:
     2739               run diasize_change-height in this-procedure
     2740                 (input  integer(v-resize-value-str)
     2741                 ,input  true
     2742                 ) .
     2743               assign
     2744                 v-restore-saved = true
     2745               .
     2746             end.
     2747           end.
     2748           if connected("ub") = true
     2749           then do:
     2750             run gbl/wndsizer.p
     2751               (input  v-cntxt-db-num
     2752               ,input  v-cntxt-userid
     2753               ,input  v-diasize-proc-name
     2754               ,input  'width':u
     2755               ,output v-resize-value-str
     2756               ) .
     2757             if v-resize-value-str <> '':U
     2758             then do:
     2759               run diasize_change-width in this-procedure
     2760                 (input  integer(v-resize-value-str)
     2761                 ,input  true
     2762                 ) .
     2763               assign
     2764                 v-restore-saved = true
     2765               .
     2766             end.
     2767           end.
     2768           if v-restore-saved <> true
     2769           then do:
     2770             if v-diasize-wndmax = true
     2771             then do:
     2772               run diasize_maximize in this-procedure
     2773                 (input  true
     2774                 ) .
     2775             end.
     2776           end.
     2777         end.
     2778         else do:
     2779           if v-diasize-wndmax = true
     2780           then do:
     2781             run diasize_maximize in this-procedure
     2782               (input  true
     2783               ) .
     2784           end.
     2785         end.
     2786       end.
     2787     end.
     2788   end procedure.
     2789   procedure diasize_need-full-display :
     2790     define output parameter p-need-full-display as logical   no-undo .
     2791     do
     2792     on error undo, return error return-value
     2793     :
     2794       assign
     2795         p-need-full-display = v-diasize-need-full-display
     2796       .
     2797       assign
     2798         v-diasize-need-full-display = false
     2799       .
     2800     end.
     2801   end procedure.
     2802   procedure get-context :
     2803      define output parameter p-db-num as integer          no-undo.
     2804      define output parameter p-user-id as character        no-undo.
     2805      define variable v-login               as character    no-undo.
     2806      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2807      define buffer buf_user-login  for ub.user-login .
     2808      do
     2809      on error undo, return error
     2810      :
     2811            FIND FIRST buf_sys-ctrl no-lock.
     2812            ASSIGN
     2813               v-login = USERID("ub")
     2814               p-db-num = buf_sys-ctrl.db-num
     2815            .
     2816            FIND FIRST buf_user-login
     2817                 WHERE buf_user-login.db-num = p-db-num
     2818                   AND buf_user-login.user-login = v-login
     2819                 no-lock
     2820                 no-error
     2821                 .
     2822            IF AVAILABLE buf_user-login
     2823            THEN DO:
     2824               assign
     2825                  p-user-id = buf_user-login.user-id
     2826               .
     2827            END.
     2828      end.
     2829   end procedure.
     2830       run diasize_init in this-procedure .
     2831   MAIN-BLOCK:
     2832   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2833      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2834   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2835     run mainmenu_getcntxt in parparentproc
     2836       (output v-cntxt-db-num
     2837       ,output v-cntxt-userid
     2838       ,output v-cntxt-level
     2839       ,output v-cntxt-host-code-obj
     2840       ,output v-cntxt-obj-type
     2841       ,output v-cntxt-obj-code
     2842       ,output v-cntxt-db-num-obj
     2843       ,output v-cntxt-is-admin
     2844       ) .
     2845       FIND FIRST buf_Dis-card-type NO-LOCK WHERE
     2846             buf_dis-card-type.emitent-host-code = p-emitent-host-code
     2847         AND   buf_dis-card-type.TYPE = p-type
     2848       AND buf_dis-card-type.host-code = 0
     2849       AND buf_Dis-card-type.obj-type = '':U
     2850       AND buf_Dis-card-type.obj-code = 0 NO-ERROR.
     2851       IF NOT AVAILABLE buf_dis-card-type THEN DO:
     2852         MESSAGE
     2853         "Не определен тип ДК" SKIP
     2854           "Невозможно задать свойство"
     2855           VIEW-AS ALERT-BOX ERROR.
     2856         UNDO, RETURN ERROR.
     2857       END.
     2858       IF NOT (buf_Dis-card-type.card-media = integer('6':U)) THEN DO:
     2859         MESSAGE
     2860         "Данное свойство можно задать ТОЛЬКО для карты типа EasyFuel2"
     2861         VIEW-AS ALERT-BOX ERROR.
     2862       UNDO, RETURN ERROR.
     2863     END.
     2864     FOR EACH temp-ef1:
     2865       DELETE temp-ef1.
     2866     END.
     2867     IF p-mode <> 'ДОБАВЛЕНИЕ':U
     2868     AND p-mode <> 'ИЗМЕНЕНИЕ':U
     2869     AND p-mode <> 'ПРОСМОТР':U
     2870     and p-mode <> 'ПРОСМОТР':U + chr(44) + "init"
     2871     THEN DO:
     2872       MESSAGE
     2873       substitute("Неверное значение параметра p-mode=&1", p-mode)
     2874       VIEW-AS ALERT-BOX ERROR.
     2875       UNDO, RETURN ERROR.
     2876     END.
     2877     assign
     2878     v-init-mode = (if num-entries(p-mode) > 1
     2879                    and entry(2, p-mode) = "init"
     2880                    then yes
     2881                    else no)
     2882     p-mode = entry(1, p-mode)
     2883     .
     2884   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     2885     (input  'is-ef'
     2886     ,input  ''
     2887     ,input  ''
     2888     ,input  0
     2889     ,input  ''
     2890     ,input  ''
     2891     ,input  ''
     2892     ,input  no
     2893     ,output is-ef-chr
     2894     ,output par-type
     2895     ) no-error .
     2896     if error-status:error
     2897     or logical(is-ef-chr) = no then do:
     2898       message
     2899       "В Вашей конфигурации нельзя работать с этим свойством ДК," skip
     2900       "так как не включен конфигурационный параметр is-ef"
     2901       view-as alert-box .
     2902       undo, return error .
     2903     end.
     2904     find first buf_prop-head no-lock where
     2905               buf_prop-head.dtm-code = p-dtm-code.
     2906     find first buf_prop-ref no-lock where
     2907             buf_prop-ref.dtm-code = p-dtm-code
     2908         and buf_prop-ref.dt-code = p-dt-code.
     2909     case p-dtm-code:
     2910       when 25 then do:
     2911       end.
     2912       when 24 then do:
     2913       end.
     2914     end case.
     2915     FIND FIRST X_dis-card NO-LOCK WHERE
     2916               X_dis-card.d-card = p-d-card NO-ERROR.
     2917     IF AVAILABLE X_dis-card THEN DO:
     2918         FIND FIRST X_clients NO-LOCK WHERE
     2919                   X_clients.obj-type = X_dis-card.cli-type
     2920              AND X_clients.obj-code = X_dis-card.cli-code NO-ERROR.
     2921     END.
     2922     RUN Myenable IN THIS-PROCEDURE.
     2923     WAIT-FOR GO OF FRAME Dialog-Frame.
     2924   END.
     2925   RUN disable_UI.
     2926   PROCEDURE disable_UI :
     2927     HIDE FRAME Dialog-Frame.
     2928   END PROCEDURE.
     2929   PROCEDURE enable_UI :
     2930     DISPLAY f-car-brand f-car-reg-number
     2931         WITH FRAME Dialog-Frame.
     2932     ENABLE B-exit b-quit b-card b-cli B-Help f-car-brand
     2933            f-car-reg-number
     2934            b-add b-del br-ef1
     2935         WITH FRAME Dialog-Frame.
     2936     VIEW FRAME Dialog-Frame.
     2937     OPEN QUERY br-ef1 FOR EACH temp-ef1 BY temp-ef1.rfn-code.
     2938   END PROCEDURE.
     2939   PROCEDURE MyEnable :
     2940   define buffer buf_dis-card for ub.dis-card.
     2941   define buffer buf_temp-ef for temp-ef.
     2942   find first buf_Dis-card no-lock where
     2943             buf_Dis-card.d-card = p-d-card no-error.
     2944   run fill-main-table in this-procedure ( input p-d-card, buffer buf_dis-card) no-error.
     2945   if error-status:error then do:
     2946     undo, return error .
     2947   end.
     2948   find first buf_temp-ef.
     2949   assign
     2950   f-car-reg-number = buf_temp-ef.car-reg-number
     2951   f-car-brand = buf_temp-ef.car-brand
     2952   .
     2953   IF p-mode = 'ДОБАВЛЕНИЕ':U THEN DO:
     2954   END.
     2955   DISPLAY
     2956   f-car-brand
     2957   f-car-reg-number
     2958   WITH FRAME Dialog-Frame.
     2959   open query br-ef1 for each temp-ef1.
     2960   IF p-mode = 'ПРОСМОТР':U THEN DO:
     2961       ASSIGN
     2962       temp-ef1.rfn-code:READ-ONLY in BROWSE br-ef1 = YES
     2963       temp-ef1.limit:READ-ONLY in BROWSE br-ef1 = YES
     2964       temp-ef1.status_:READ-ONLY in BROWSE br-ef1 = YES    .
     2965   END.
     2966   ENABLE
     2967   B-exit WHEN p-mode <> 'ПРОСМОТР':U
     2968   b-quit
     2969   B-Help
     2970   f-car-reg-number WHEN (p-mode <> 'ПРОСМОТР':U and p-dtm-code = 33)
     2971   f-car-brand WHEN (p-mode <> 'ПРОСМОТР':U and p-dtm-code = 33)
     2972   b-add WHEN p-mode <> 'ПРОСМОТР':U
     2973   b-del WHEN p-mode <> 'ПРОСМОТР':U
     2974   br-ef1
     2975   b-card WHEN AVAILABLE X_dis-card
     2976   b-cli WHEN AVAILABLE X_dis-card
     2977   WITH FRAME Dialog-Frame.
     2978   VIEW FRAME Dialog-Frame.
     2979   IF p-mode = 'ПРОСМОТР':U  THEN DO:
     2980     ASSIGN
     2981     b-quit:LABEL = "&Выход"
     2982     b-quit:COLUMN = 1
     2983     .
     2984     HIDE
     2985     b-exit
     2986     IN FRAME Dialog-Frame.
     2987   END.
     2988   ASSIGN
     2989   FRAME Dialog-Frame:TITLE = SUBSTITUTE("&1 для &2 ",  FRAME Dialog-Frame:TITLE, p-d-card).
     2990   END PROCEDURE.
     2991   PROCEDURE proc-save :
     2992   DEFINE BUFFER buf_prop-map FOR ub.prop-map.
     2993   DEFINE BUFFER bufl_prop-head FOR ub.prop-head.
     2994   DEFINE BUFFER buf_temp-ef1 FOR temp-ef1.
     2995   DEFINE BUFFER buf_ext-classif FOR ub.ext-classif.
     2996   if p-dtm-code = 33 then do:
     2997     ASSIGN
     2998     FRAME Dialog-Frame
     2999     f-car-brand
     3000     f-car-reg-number
     3001     .
     3002   end.
     3003   FOR EACH buf_temp-ef1 :
     3004      IF buf_temp-ef1.limit = 0
     3005      THEN DO:
     3006        MESSAGE
     3007        substitute("Не заполнен разрешенный максимальный объем топлива для RFN с кодом &1", buf_temp-ef1.rfn-code)
     3008        VIEW-AS ALERT-BOX ERROR.
     3009        UNDO, RETURN ERROR.
     3010      END.
     3011   end.
     3012   FOR EACH buf_temp-ef1 :
     3013      FIND FIRST buf_ext-classif WHERE
     3014                 buf_ext-classif.classif-subject =  p-d-card
     3015             AND buf_ext-classif.classif-name    =  buf_temp-ef1.name
     3016             AND buf_ext-classif.CharKey_One     =  buf_temp-ef1.rfn-code NO-ERROR.
     3017      IF NOT AVAILABLE buf_ext-classif THEN DO:
     3018       CREATE buf_ext-classif.
     3019       ASSIGN
     3020         buf_ext-classif.classif-subject = p-d-card
     3021         buf_ext-classif.classif-name    = buf_temp-ef1.name
     3022         buf_ext-classif.CharKey_One     = buf_temp-ef1.rfn-code
     3023         buf_ext-classif.CharKey_Two     = string(buf_temp-ef1.limit)
     3024         buf_ext-classif.CharKey_Three   = string(buf_temp-ef1.status_)
     3025         buf_ext-classif.db-num          = 0
     3026       .
     3027      END.
     3028      else do :
     3029        ASSIGN
     3030         buf_ext-classif.CharKey_Two     = string(buf_temp-ef1.limit)
     3031         buf_ext-classif.CharKey_Three   = string(buf_temp-ef1.status_)
     3032         buf_ext-classif.db-num          = 0
     3033       .
     3034      end.
     3035   END.
     3036   if p-dtm-code = 33 then do:
     3037     FOR EACH buf_prop-map NO-LOCK WHERE
     3038             buf_prop-map.dtm-code = p-dtm-code
     3039         and buf_prop-map.node-code > 0:
     3040       FIND FIRST temp-dis-card-property WHERE
     3041                 temp-dis-card-property.d-card = p-d-card
     3042           AND   temp-dis-card-property.dt-code = p-dt-code
     3043           AND   temp-dis-card-property.node-code = buf_prop-map.node-code
     3044           AND   temp-dis-card-property.host-code = p-host-code
     3045           AND   temp-dis-card-property.obj-type = p-obj-type
     3046           AND   temp-dis-card-property.obj-code = p-obj-code NO-ERROR.
     3047       IF NOT AVAILABLE temp-dis-card-property THEN DO:
     3048         CREATE temp-dis-card-property.
     3049         ASSIGN
     3050         temp-dis-card-property.d-card = p-d-card
     3051         temp-dis-card-property.dt-code = p-dt-code
     3052         temp-dis-card-property.dtm-code = p-dtm-code
     3053         temp-dis-card-property.sum-id = p-sum-id
     3054         temp-dis-card-property.node-code = buf_prop-map.node-code
     3055         temp-dis-card-property.host-code = p-host-code
     3056         temp-dis-card-property.obj-type = p-obj-type
     3057         temp-dis-card-property.obj-code = p-obj-code
     3058         temp-dis-card-property.prop-label = buf_prop-head.prop-label
     3059         temp-dis-card-property.node-label = buf_prop-map.node-label
     3060         temp-dis-card-property.data-type = entry(1, buf_prop-map.node-value-type)
     3061         .
     3062       END.
     3063     END.
     3064     FOR EACH temp-dis-card-property
     3065       where temp-dis-card-property.d-card = p-d-card
     3066     and temp-dis-card-property.dtm-code = p-dtm-code
     3067     and temp-dis-card-property.dt-code = p-dt-code
     3068       :
     3069       CASE temp-dis-card-property.node-code :
     3070         WHEN 1 THEN DO:
     3071           temp-dis-card-property.property-value-character = f-car-reg-number.
     3072         END.
     3073         WHEN 2 THEN DO:
     3074           temp-dis-card-property.property-value-character = f-car-brand.
     3075         END.
     3076       END CASE.
     3077     END.
     3078   end.
     3079   ASSIGN
     3080   p-setted = YES
     3081   .
     3082   END PROCEDURE.
     3083   PROCEDURE undo-proc :
     3084   DEFINE BUFFER buf_temp-ef1 FOR temp-ef1.
     3085   DEFINE BUFFER buf_ext-classif FOR ub.ext-classif.
     3086   disable triggers for load of ub.ext-classif.
     3087   FOR EACH buf_temp-ef1 WHERE
     3088          buf_temp-ef1.d-card = p-d-card
     3089       and buf_temp-ef1.NEW_ = YES,
     3090       EACH buf_ext-classif WHERE
     3091           buf_ext-classif.CharKey_One = buf_temp-ef1.rfn-code:
     3092      DELETE buf_ext-classif.
     3093   END.
     3094   END PROCEDURE.
