     1246   v-date-str = string(YEAR(p-date), "9999":U) + "-":U +
     1247                string(Month(p-date), "99":U) + "-":U +
     1248                string(DAY(p-date), "99":U).
     1249   return v-date-str.
     1250   END FUNCTION.
     1251   FUNCTION Xml-CD-DateTimetoString returns character (input  p-date as date, p-time as integer):
     1252   define variable v-date-str as character no-undo .
