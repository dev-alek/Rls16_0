     9966   procedure diasize_set-height :
     9967     define input  parameter p-new-height  as decimal   no-undo .
     9968     define input  parameter p-move-resize as logical   no-undo .
     9969     do
     9970     on error undo, return error return-value
     9971     :
     9972       run diasize_change-height in this-procedure
     9973         (input  (p-new-height - frame frm :height)
     9974         ,input  p-move-resize
     9975         ) .
     9976     end.
     9977   end procedure.
     9978   procedure diasize_change-width :
     9979     define input  parameter p-change-value as decimal   no-undo .
