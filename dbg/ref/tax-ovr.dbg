     6577   procedure re-define :
     6578   define input-output parameter p-calc-method      as character no-undo .
     6579   define input        parameter p-gds-code         as integer   no-undo .
     6580     do
     6581     on error undo, return error return-value
     6582     :
     6583   define buffer buf_goods for ub.goods  .
     6584   define buffer buf_gds-grp for ub.gds-grp  .
     6585       case p-calc-method :
     6586         when 'Товар':U then do:
     6587              find first buf_goods no-lock where buf_goods.gds-code = p-gds-code no-error .
     6588                   case buf_goods.calc-method:
     6589                     when 'Группа':U then do:
     6590                       find first buf_gds-grp no-lock where
     6591                                  buf_gds-grp.node-code = buf_goods.grp-code no-error .
     6592                       p-calc-method  = buf_gds-grp.calc-method.
     6593                     end.
     6594                   otherwise do:
     6595                       p-calc-method  =  buf_goods.calc-method .
     6596                   end.
     6597                   end case.
     6598              run  re-define in this-procedure (
     6599                         input-output  p-calc-method ,
     6600                         input p-gds-code )  .
     6601         end.
     6602         when 'Группа':U then do:
     6603              find first buf_goods no-lock where buf_goods.gds-code = p-gds-code no-error .
     6604              find first buf_gds-grp no-lock where
     6605                         buf_gds-grp.node-code = buf_goods.grp-code no-error .
     6606              run re-define in this-procedure (
     6607                         input-output buf_gds-grp.calc-method ,
     6608                         input p-gds-code )  .
     6609         end.
     6610         when 'Учетная':U or
     6611         when 'Учет-объект':U then do:
     6612              p-calc-method = 'УчетнаяS':U .
     6613         end.
     6614         when 'Учет-резерв':U then do:
     6615              p-calc-method = 'Учет-рзрвS':U.
     6616         end.
     6617         when 'Приходная':U or
     6618         when 'Прих-объект':U then do:
     6619              p-calc-method = 'ПриходнаяS':U.
     6620         end.
     6621         when 'Учет-безНДС':U then do:
     6622              p-calc-method = 'Учет-НДСS':U .
     6623         end.
     6624       end case.
     6625     end.
     6626   end procedure.
     6627   procedure create-line-pdf-mpl-lib :
     6628   define input  parameter  p-plt-db-num as integer   no-undo .
     6629   define input  parameter  p-plt-id     as integer   no-undo .
