     3882   Откат_цен"
     3883     .
     3884   if lookup ( p-calc-method , v-sps )  = 0 then  do:
     3885       p-calc-method = entry (1,p-calc-method, " ") no-error .
     3886       if error-status :error then message p-calc-method.
     3887   end.
