     9290   define variable v-host-code  as integer   no-undo .
     9291   define variable l-ok as logical   no-undo .
     9292   define temp-table gds-list no-undo
     9293       field gds-code      like ub.gds-obj.gds-code
     9294       field obj-type      like ub.gds-obj.obj-type
     9295       field obj-code      like ub.gds-obj.obj-code
     9296       field price-sale    like ub.price-list.price-sale
     9297       index gc is primary unique obj-type obj-code gds-code
     9298   .
     9299   define temp-table obj-list no-undo
     9300       field obj-type like ub.gds-obj.obj-type
     9301       field obj-code like ub.gds-obj.obj-code
     9302       field obj-name like ub.clients.obj-name
     9303       index oc is primary unique obj-type obj-code
     9304   .
     9305   define buffer buf_goods                for ub.goods.
     9306   define buffer buf_gds-obj              for ub.gds-obj.
     9307   define buffer buf_clients              for ub.clients.
     9308   define buffer buf_tax-rate-value       for ub.tax-rate-value.
     9309   define buffer buf_host_tax-rate-value  for ub.tax-rate-value.
     9310   define buffer buf_obj_tax-rate-value   for ub.tax-rate-value.
     9311   define variable  v-obj-current-date  like ub.tax-rate-value.fact-date       no-undo.
     9312   define variable  v-display-frame     as logical                          no-undo.
     9313   define variable  v-save-option       as char                             no-undo.
     9314   DEFINE MENU POPUP-MENU-bt-export
     9315          MENU-ITEM m_obj-list     LABEL "Список объектов"
     9316          MENU-ITEM m_gds-list     LABEL "Список товаров".
     9317   DEFINE BUTTON b-help
     9318        LABEL "Помо&щь"
     9319        SIZE 3 BY 1.
     9320   DEFINE BUTTON bt-close AUTO-GO
     9321        LABEL "&Выход"
     9322        SIZE 10 BY 1.
     9323   DEFINE BUTTON bt-export
     9324        LABEL "Экспорт..."
     9325        SIZE 11 BY 1.
     9326   DEFINE BUTTON bt-form-goods-list
     9327        LABEL "Товары"
     9328        SIZE 10 BY 1 TOOLTIP "Добавить товары для переоценивания".
     9329   DEFINE BUTTON bt-form-ovr-obj
     9330        LABEL "По Объекту"
     9331        SIZE 12 BY 1 TOOLTIP "Сформировать ДНЦ по выбранному объекту".
     9332   DEFINE BUTTON bt-form-ovr-obj-2
     9333        LABEL "По списку"
     9334        SIZE 12 BY 1 TOOLTIP "Сформировать ДНЦ по списку объектов".
     9335   DEFINE QUERY br-goods FOR
     9336         gds-list,
     9337         buf_goods SCROLLING.
     9338   DEFINE QUERY br-objects FOR
     9339         obj-list SCROLLING.
     9340   DEFINE BROWSE br-goods
     9341     QUERY br-goods DISPLAY
     9342         buf_goods.gds-code
     9343         buf_goods.artic
     9344         buf_goods.gds-name
     9345       WITH NO-ROW-MARKERS SEPARATORS SIZE 65.88 BY 19.58.
     9346   DEFINE BROWSE br-objects
     9347     QUERY br-objects DISPLAY
     9348         obj-list.obj-type format "X(3)"
     9349       obj-list.obj-code format ">>>>9"
     9350       " " + obj-list.obj-name format "X(18)" column-label "Наименование"
     9351       WITH NO-ROW-MARKERS SEPARATORS SIZE 31 BY 19.58.
     9352   DEFINE FRAME frm
     9353        bt-close AT ROW 1 COL 1.63
     9354        bt-export AT ROW 1 COL 20.5
     9355        bt-form-goods-list AT ROW 1 COL 32
     9356        bt-form-ovr-obj AT ROW 1 COL 67.88
     9357        bt-form-ovr-obj-2 AT ROW 1 COL 79.88
     9358        b-help AT ROW 1 COL 96
     9359        br-objects AT ROW 2.38 COL 1.5
     9360        br-goods AT ROW 2.38 COL 33.13
     9361        "Сформировать ДНЦ:" VIEW-AS TEXT
     9362             SIZE 17.5 BY 1 AT ROW 1 COL 50
     9363        SPACE(31.87) SKIP(20.12)
     9364       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     9365            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     9366            TITLE "Список товаров по объекту"
     9367            DEFAULT-BUTTON bt-close.
     9368   ASSIGN
     9369          FRAME frm:SCROLLABLE       = FALSE
     9370          FRAME frm:HIDDEN           = TRUE.
     9371   ASSIGN
     9372          bt-export:HIDDEN IN FRAME frm           = TRUE
     9373          bt-export:POPUP-MENU IN FRAME frm       = MENU POPUP-MENU-bt-export:HANDLE.
     9374   ON WINDOW-CLOSE OF FRAME frm
     9375   DO:
     9376     APPLY "END-ERROR":U TO SELF.
     9377   END.
     9378   ON MOUSE-SELECT-DBLCLICK OF br-objects IN FRAME frm
     9379   DO:
     9380     apply "choose" to bt-form-goods-list.
     9381   END.
     9382   ON CHOOSE OF bt-close IN FRAME frm
     9383   DO:
     9384   END.
     9385   ON CHOOSE OF bt-export IN FRAME frm
     9386   DO:
     9387      if v-save-option = "" then do:
     9388          run gbl/pop-up.p (self:handle, no) no-error.
     9389      end.
     9390      run process-bt-export (v-save-option) no-error.
     9391      if error-status:error then do:
     9392           assign
     9393                   v-save-option = ""
     9394           .
     9395           return no-apply.
     9396      end.
     9397      assign
     9398           v-save-option = ""
     9399      .
     9400   END.
     9401   ON CHOOSE OF bt-form-goods-list IN FRAME frm
     9402   DO:
     9403       if not available obj-list then do:
     9404         message "Не выбран объект в списке" view-as alert-box.
     9405         return no-apply.
     9406       end.
     9407       run form-goods-list in this-procedure ( input obj-list.obj-type,
     9408                                               input obj-list.obj-code,
     9409                                               input ""
     9410                                             ).
     9411       OPEN QUERY br-goods FOR EACH gds-list,        first buf_goods where buf_goods.gds-code = gds-list.gds-code.
     9412   END.
     9413   ON CHOOSE OF bt-form-ovr-obj IN FRAME frm
     9414   DO:
     9415       if not available obj-list then do:
     9416         message "Не выбран объект в списке" view-as alert-box.
     9417         return no-apply.
     9418       end.
     9419       message
     9420           "Создать ДНЦ на объекте " + string(obj-list.obj-type) + string(obj-list.obj-code) + " ?"
     9421       view-as alert-box buttons ok-cancel title "Создание ДНЦ"
     9422       update v-1 as logical.
     9423       if v-1 = no then do: return no-apply. end.
     9424       run form-ovr-obj in this-procedure no-error.
     9425       if error-status :error
     9426       then do:
     9427           return no-apply.
     9428       end.
     9429   END.
     9430   ON CHOOSE OF bt-form-ovr-obj-2 IN FRAME frm
     9431   DO:
     9432       message
     9433           "Создать ДНЦ на всех объектах ?"
     9434       view-as alert-box buttons ok-cancel title "Создание ДНЦ"
     9435       update v-1 as logical.
     9436       if v-1 = no then do: undo, return. end.
     9437       run form-ovr-obj-2 in this-procedure no-error.
     9438       if error-status :error
     9439       then do:
     9440           return no-apply.
     9441       end.
     9442   END.
     9443   ON CHOOSE OF MENU-ITEM m_gds-list
     9444   DO:
     9445     assign
     9446       v-save-option = "gds-list":U
     9447     .
     9448     apply "choose" to bt-export in frame frm.
     9449   END.
     9450   ON CHOOSE OF MENU-ITEM m_obj-list
     9451   DO:
     9452     assign
     9453       v-save-option = "obj-list":U
     9454     .
     9455     apply "choose" to bt-export in frame frm.
     9456   END.
     9457   define variable vss-include-info87 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9458   on help of frame frm
     9459   do:
     9460     run gbl/app_help.p
     9461       (input this-procedure :file-name
     9462       ,input ''
     9463       ,input ?
     9464       ) no-error.
     9465     if error-status :error then do:
     9466       message
     9467         "Ошибка при вызове помощи"
     9468         error-status :get-message(1)
     9469         view-as alert-box .
     9470     end.
     9471   end.
     9472   run minbtn-set in this-procedure .
     9473   on choose of b-help in frame frm
     9474   do:
     9475     apply "help":u to frame frm .
     9476   end.
     9477   define variable vss-include-info88 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9478   procedure minbtn-set :
     9479       do
     9480           on error undo, return error return-value
     9481           :
     9482           define variable ii              as integer       no-undo .
     9483           define variable fh              as widget-handle no-undo .
     9484           define variable hh              as widget-handle no-undo .
     9485           define variable v-h             as handle        extent 4 no-undo .
     9486           define variable v-name-button   as character     no-undo .
     9487           define variable v-help-old-x    as decimal       no-undo .
     9488           define variable v-help-old-y    as decimal       no-undo .
     9489           define variable v-help-old-size as decimal       no-undo .
     9490           define variable v-frame-width   as decimal       no-undo .
     9491           define variable jj              as integer       no-undo .
     9492           do
     9493               on error undo, return error
     9494               :
     9495               assign
     9496                   v-frame-width = frame frm:width - 0.3
     9497                   fh            = frame frm:first-child
     9498                   hh            = fh:first-child
     9499                   ii            = 1
     9500                   .
     9501               do while valid-handle(hh):
     9502                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     9503                   do:
     9504                       case lc(hh:name) :
     9505                           when "b-help" then
     9506                               do:
     9507                                   hh:load-image-up("cmp/b-help.bmp":u) .
     9508                                   hh:load-image-down("cmp/b-help.bmp":u) .
     9509                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     9510                                   hh:TOOLTIP = "Помощь" .
     9511                                   v-help-old-x = hh:column .
     9512                                   v-help-old-y = hh:row    .
     9513                                   v-help-old-size = hh:width .
     9514                                   hh:width-chars = 2.5 .
     9515                               end.
     9516                           when "b-print" then
     9517                               do:
     9518                                   hh:load-image("cmp/b-print.bmp":u) .
     9519                                   hh:TOOLTIP = "Печать" .
     9520                                   v-h[ii] = hh:handle .
     9521                                   ii = ii + 1 .
     9522                                   hh:width-chars = 3 .
     9523                               end.
     9524                           when "b-history" or
     9525                           when "b-hist" then
     9526                               do:
     9527                                   hh:load-image("cmp/b-hist.bmp":u) .
     9528                                   hh:TOOLTIP = "История" .
     9529                                   v-h[ii] = hh:handle .
     9530                                   ii = ii + 1 .
     9531                                   hh:width-chars = 3 .
     9532                               end.
     9533                           when "b-sch" then
     9534                               do:
     9535                                   hh:load-image("cmp/b-sch.bmp":u) .
     9536                                   hh:TOOLTIP = "Установка Фильтра" .
     9537                                   v-h[ii] = hh:handle .
     9538                                   ii = ii + 1 .
     9539                                   hh:width-chars = 3 .
     9540                               end.
     9541                           when "b-hist-user" then
     9542                               do:
     9543                                   hh:load-image("cmp/b-hist.bmp":u) .
     9544                                   hh:TOOLTIP = "История пользователя" .
     9545                                   ii = ii + 1 .
     9546                               end.
     9547                       end case.
     9548                   end.
     9549                   hh = hh:next-sibling.
     9550               end.
     9551               b-help:column = v-frame-width - b-help:width-chars.
     9552               jj = 0.
     9553               repeat ii = 4 to 1 by -1 :
     9554                   if valid-handle (v-h[ii] ) then
     9555                   do:
     9556                       jj  = jj + 1 .
     9557                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     9558                       v-h[ii]:row    = v-help-old-y .
     9559                   end.
     9560               end.
     9561           end.
     9562       end.
     9563   end procedure.
     9564   define variable vss-include-info89 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     9565   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     9566   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     9567   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     9568   define variable v-diasize-current-frame-width  as decimal   no-undo .
     9569   define variable v-diasize-current-frame-height as decimal   no-undo .
     9570   define variable v-diasize-change-size          as logical   no-undo .
     9571   define variable v-diasize-resize-button        as handle    no-undo .
     9572   define variable v-diasize-wndmax               as logical   no-undo .
     9573   define variable v-diasize-wndstore             as logical   no-undo .
     9574   define variable v-diasize-proc-name            as character no-undo .
     9575   define variable v-diasize-browse-handle        as handle    no-undo .
     9576   define variable v-diasize-browse-number        as integer   no-undo .
     9577   define variable v-diasize-need-full-display    as logical   no-undo init false .
     9578   define temp-table temp-diasize-handle no-undo
     9579     field handle-value  as handle
     9580     field save-position as decimal
     9581     index xpk is primary unique handle-value
     9582     .
     9583   define temp-table temp-browse-handle no-undo
     9584     field browse-type   as character
     9585     field browse-number as integer
     9586     field browse-handle as handle
     9587     field original-size as decimal
     9588     index xpk is primary unique browse-type browse-number
     9589     index xie browse-type browse-handle
     9590   .
     9591   procedure diasize_change-height :
     9592     define input  parameter p-change-value  as decimal   no-undo .
     9593     define input  parameter p-move-resize   as logical   no-undo .
     9594     define variable v-field-group-handle    as handle    no-undo .
     9595     define variable v-object-handle         as handle    no-undo .
     9596     define variable v-frame-height          as decimal   no-undo .
     9597     define variable v-frame-virtual-height  as decimal   no-undo .
     9598     define variable v-browse-height         as decimal   no-undo .
     9599     define variable v-window-height         as decimal   no-undo .
     9600     define variable v-window-virtual-height as decimal   no-undo .
     9601     define variable v-change-sign           as integer   no-undo .
     9602     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     9603     define buffer buf_temp-browse-handle  for temp-browse-handle .
     9604     if p-change-value > 0
     9605     then do:
     9606       if frame frm :height + p-change-value
     9607           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     9608       then do:
     9609         assign
     9610           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     9611                           - (frame frm :height-chars)
     9612         .
     9613         if p-change-value <= 0
     9614         then do:
     9615           run diasize_position-resize-button in this-procedure .
     9616           return .
     9617         end.
     9618       end.
     9619     end.
     9620     if p-change-value < 0
     9621     then do:
     9622       if frame frm :height + p-change-value < v-diasize-orig-frame-height
     9623       then do:
     9624         assign
     9625           p-change-value = v-diasize-orig-frame-height
     9626                          - (frame frm :height-chars)
     9627         .
     9628         if p-change-value >= 0
     9629         then do:
     9630           run diasize_position-resize-button in this-procedure .
     9631           return .
     9632         end.
     9633       end.
     9634     end.
     9635     if p-change-value >= 0
     9636     then do:
     9637       assign
     9638         v-change-sign = 1
     9639       .
     9640     end.
     9641     else do:
     9642       assign
     9643         v-change-sign = -1
     9644       .
     9645     end.
     9646     assign
     9647       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     9648     .
     9649     if p-change-value = 0
     9650     then do:
     9651       run diasize_position-resize-button in this-procedure .
     9652       return .
     9653     end.
     9654     move_block:
     9655     do
     9656     on error undo move_block, retry move_block
     9657     :
     9658       if retry
     9659       then do:
     9660         do
     9661         on error undo move_block, leave move_block
     9662         :
     9663           if p-change-value > 0
     9664           then do:
     9665             for each buf_temp-diasize-handle
     9666             on error undo, next
     9667             :
     9668               assign
     9669                 v-object-handle = buf_temp-diasize-handle.handle-value
     9670               .
     9671               if v-object-handle <> v-diasize-resize-button
     9672               then do:
     9673                 assign
     9674                   v-object-handle :row = buf_temp-diasize-handle.save-position
     9675                 .
     9676               end.
     9677             end.
     9678             assign
     9679               v-diasize-browse-handle :height = v-browse-height
     9680             .
     9681             for each buf_temp-browse-handle
     9682               where buf_temp-browse-handle.browse-type = 'height':u
     9683             on error undo, next
     9684             :
     9685               assign
     9686                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     9687               .
     9688             end.
     9689             assign
     9690               frame frm :height = v-frame-height
     9691             .
     9692             if frame frm :scrollable = true
     9693             then do:
     9694               assign
     9695                 frame frm :virtual-height = v-frame-virtual-height
     9696               .
     9697             end.
     9698             run diasize_position-resize-button in this-procedure .
     9699           end.
     9700           else do:
     9701             if frame frm :scrollable = true
     9702             then do:
     9703               assign
     9704                 frame frm :virtual-height = v-frame-virtual-height
     9705               .
     9706             end.
     9707             assign
     9708               frame frm :height = v-frame-height
     9709             .
     9710             assign
     9711               v-diasize-browse-handle :height = v-browse-height
     9712             .
     9713             for each buf_temp-browse-handle
     9714               where buf_temp-browse-handle.browse-type = 'height':u
     9715             on error undo, next
     9716             :
     9717               assign
     9718                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     9719               .
     9720             end.
     9721             for each buf_temp-diasize-handle
     9722             on error undo, next
     9723             :
     9724               assign
     9725                 v-object-handle = buf_temp-diasize-handle.handle-value
     9726               .
     9727               if v-object-handle <> v-diasize-resize-button
     9728               then do:
     9729                 assign
     9730                   v-object-handle :row = buf_temp-diasize-handle.save-position
     9731                 .
     9732               end.
     9733             end.
     9734             run diasize_position-resize-button in this-procedure .
     9735           end.
     9736           assign
     9737             v-diasize-change-size = false
     9738           .
     9739           leave move_block .
     9740         end.
     9741       end.
     9742       assign
     9743         v-diasize-need-full-display = true
     9744       .
     9745       if v-diasize-change-size = false
     9746       then do:
     9747         assign
     9748           v-diasize-change-size = true
     9749         .
     9750       end.
     9751       else do:
