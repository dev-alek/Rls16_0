     2181   procedure grp-obj-notcorr-value :
     2182   do
     2183   on error undo, return error
     2184   :
     2185   define input parameter p-node-code             as integer      no-undo.
     2186   define input parameter p-obj-type              as character    no-undo.
     2187   define input parameter p-obj-code              as integer      no-undo.
     2188   define output parameter p-notcorr              as character    no-undo init ?.
     2189   define output parameter p-range-notcorr     as integer      no-undo.
     2190   define output parameter p-exists-notcorr    as logical      no-undo.
     2191   define variable v-host-code as integer      no-undo.
     2192   DEFINE VARIABLE v-found as logical no-undo .
     2193   DEFINE VARIABLE v-exists as logical no-undo .
     2194   DEFINE VARIABLE v-range as integer no-undo .
     2195   DEFINE VARIABLE jj as integer no-undo .
     2196   DEFINE VARIABLE v-notcorr-found as logical no-undo .
     2197   DEFINE VARIABLE v-notcorr-value as char      no-undo.
     2198   define buffer buf_gds-grp for ub.gds-grp.
     2199   define buffer buf_gds-grp-obj-attr for ub.gds-grp-obj-attr  .
     2200   find first buf_gds-grp no-lock where
     2201              buf_gds-grp.node-code = p-node-code no-error .
     2202   if not avail buf_gds-grp and p-node-code <> 0 then do:
     2203     message
     2204       vss-workfile vss-revision vss-description
     2205       skip "Не удалось найти группу товаров с кодом" p-node-code
     2206       view-as alert-box error .
     2207     undo, return error .
     2208   end.
