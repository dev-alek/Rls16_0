     7155           other-rubl-loc      = if buf_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.other-rubl     * in-vatp-parts.fact-qnty) / buf_doc-line.fact-qnty  else 0
     7156                                           vat-base-loc        = if buf_doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))) / buf_doc-line.fact-qnty   else 0
     7157           slt-base-loc        = if buf_doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))) / buf_doc-line.fact-qnty   else 0
     7158                   vat-rubl-loc        = if buf_doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))) / buf_doc-line.fact-qnty   else 0
     7159           slt-rubl-loc        = if buf_doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))) / buf_doc-line.fact-qnty   else 0
     7160           vat-pc-loc          = (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))) / (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  / (100 + in-vatp-parts.vat-pc)))
     7161           slt-pc-loc          = (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))) / (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                      / (100 + in-vatp-parts.slt-pc))).
     7162         if road-tax-base-loc  = ? then road-tax-base-loc  = 0.
     7163         if road-tax-rubl-loc  = ? then road-tax-rubl-loc  = 0.
     7164         if transport-base-loc = ? then transport-base-loc = 0.
     7165         if transport-rubl-loc = ? then transport-rubl-loc = 0.
     7166         if other-base-loc     = ? then other-base-loc     = 0.
     7167         if other-rubl-loc     = ? then other-rubl-loc     = 0.
     7168         assign
     7169           transport-cli-loc      = 0
     7170           other-cli-loc          = 0
     7171           road-tax-cli-loc       = ?
     7172           vat-cli-loc            = ?
     7173           slt-cli-loc            = ?
     7174           price-cli-with-tax-loc = ?.
     7175      end.
     7176   ASSIGN
     7177             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     7178       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     7179   .
     7180                 assign
     7181                   p-road-tax-rubl =  road-tax-rubl-loc
     7182                   p-road-tax-base =  road-tax-base-loc
     7183                   .
     7184               end.
     7185         end.
     7186     end.
     7187   end procedure.
     7188   procedure calc-sigma :
     7189    do
     7190    on error undo, return error return-value
     7191    :
     7192   define input parameter l-bcode like ub.price-list.b-code no-undo .
     7193   define input-output parameter new-price as decimal no-undo .
     7194   define input parameter l-host as integer no-undo .
     7195   define input parameter l-code as integer no-undo .
     7196   define input parameter l-type as character no-undo .
     7197   define output parameter p-ret as logical no-undo .
     7198   define variable conf-par     as character no-undo.
     7199   define variable par-type     as character no-undo.
     7200   define variable i-sigma as decimal no-undo .
     7201   define variable cur-pr like ub.price-list.price-sale no-undo.
     7202   define variable cur-rt like ub.price-list.road-tax   no-undo.
     7203   define variable cur-ex like ub.price-list.excise     no-undo.
     7204   define variable cur-dn like ub.price-list.doc-num    no-undo.
     7205   define variable old-price as decimal no-undo .
     7206   p-ret = true  .
     7207   if par-pr-sigma <> ? and par-pr-sigma <> "" and par-pr-sigma <> "0" then do:
     7208   define variable vss-include-info65 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7209   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     7210     (input  l-type
     7211     ,input  l-code
     7212     ,input  l-bcode
     7213     ,input  0
     7214     ,input  0
     7215     ,output cur-dn
     7216     ,output cur-pr
     7217     ,output cur-rt
     7218     ,output cur-ex
     7219     )  .
     7220   old-price = cur-pr .
     7221   if old-price =  new-price then do:
     7222      p-ret = true .
     7223      return.
     7224   end.
     7225      i-sigma = decimal(par-pr-sigma) .
     7226      if ( 100 * ABSOLUTE( old-price - new-price ) / old-price ) <= i-sigma then do:
     7227          p-ret = false .
     7228          new-price = old-price.
     7229          end.
     7230      else p-ret = true .
     7231   end.
     7232    end.
     7233   end procedure.
     7234   define variable vss-include-info66 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7235   define variable var-pr-r-b as character no-undo .
     7236   define variable v-str2 as character no-undo .
     7237   define variable vss-include-info67 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     7238   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     7239     (output var-pr-r-b
     7240     )  .
     7241   function f-base-code return integer ( p-b-code as integer ).
     7242     define variable main-b-code as integer   no-undo .
     7243     define buffer buf_bar-code for ub.bar-code  .
     7244     find first buf_bar-code no-lock where
     7245               buf_bar-code.b-code = p-b-code no-error .
     7246   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     7247     (input  buf_bar-code.gds-code
     7248     ,input  ?
     7249     ,output main-b-code
     7250     )  .
     7251     return (main-b-code).
     7252   end function.
     7253   function fnc-cost-pc return decimal (buffer local-price-list for ub.price-doc-forming-gds ).
     7254     define variable f-cost     as decimal no-undo .
     7255     define variable f-cost-pc  as decimal no-undo .
     7256     define variable v-qnty     as decimal no-undo .
     7257     define variable v-sum      as decimal no-undo .
     7258     define variable fact_price as decimal no-undo .
     7259     find first ub.goods where ub.goods.artic     = local-price-list.artic and
     7260                               ub.goods.prod-type = local-price-list.prod-type and
     7261                               ub.goods.prod-code = local-price-list.prod-code no-lock
     7262                               no-error .
     7263     assign
     7264       v-sum  =  0
     7265       v-qnty =  0
     7266       .
     7267     for each x_obj-group :
     7268         find ub.gds-obj no-lock where
     7269             ub.gds-obj.gds-code = ub.goods.gds-code and
     7270             ub.gds-obj.obj-type = x_obj-group.obj-type and
     7271             ub.gds-obj.obj-code = x_obj-group.obj-code no-error.
     7272         if  available ub.gds-obj then
     7273           if ub.goods.gds-type = 'т':U then
     7274             assign
     7275               v-sum  = v-sum  + ( if var-pr-r-b = "rubl" then ub.gds-obj.avrg-rubl else ub.gds-obj.avrg-base) * ub.gds-obj.avrg-qnty
     7276               v-qnty =  v-qnty + ub.gds-obj.avrg-qnty
     7277               .
     7278             else  v-sum = ?.
     7279         else v-sum = ?.
     7280     end.
     7281     f-cost = v-sum / v-qnty .
     7282     fact_price = if var-pr-r-b = "rubl" then local-price-list.price-sale-rubl else local-price-list.price-sale-base .
     7283     f-cost-pc = ( round ( fact_price / f-cost , 2 ) -  1 ) * 100.
     7284     return (f-cost-pc).
     7285   end function.
     7286   function fnc-pr-pc return decimal (buffer local-price-list for ub.price-doc-forming-gds ).
     7287   define variable f-pr     as decimal no-undo .
     7288   define variable f-pr-pc  as decimal no-undo.
     7289   define variable v-qnty as decimal   no-undo .
     7290   define variable v-sum as decimal   no-undo .
     7291   define variable fact_price as decimal   no-undo .
     7292   find first ub.goods where ub.goods.artic = local-price-list.artic and
     7293                          ub.goods.prod-type = local-price-list.prod-type and
     7294                          ub.goods.prod-code = local-price-list.prod-code no-lock  no-error .
     7295    assign
     7296      v-sum  =  0
     7297      v-qnty =  0
     7298      .
     7299   for each x_obj-group :
     7300   find ub.gds-obj no-lock where
     7301        ub.gds-obj.gds-code = ub.goods.gds-code and
     7302        ub.gds-obj.obj-type = x_obj-group.obj-type and
     7303        ub.gds-obj.obj-code = x_obj-group.obj-code  no-error .
     7304   if  available ub.gds-obj then do:
     7305     if ub.goods.gds-type = 'т':U then
     7306       assign
     7307         f-pr = (if var-pr-r-b = "rubl" then ub.gds-obj.last-rubl else ub.gds-obj.last-base)
     7308         .
     7309       else f-pr = ?.
     7310   end.
     7311   else f-pr = ?.
     7312   end.
     7313     fact_price = if var-pr-r-b = "rubl" then local-price-list.price-sale-rubl else local-price-list.price-sale-base .
     7314     f-pr-pc = ( round( fact_price / f-pr , 2 ) - 1 ) * 100 .
     7315     return (f-pr-pc).
     7316   end function.
     7317   function fnc-cost return decimal (buffer local-price-list for ub.price-doc-forming-gds).
     7318   define variable f-cost   as decimal no-undo .
     7319   find first  x_obj-group.
     7320   find first ub.goods where ub.goods.artic = local-price-list.artic and
     7321                          ub.goods.prod-type = local-price-list.prod-type and
     7322                          ub.goods.prod-code = local-price-list.prod-code no-lock  no-error .
     7323   find ub.gds-obj no-lock where
     7324        ub.gds-obj.gds-code = ub.goods.gds-code  and
     7325        ub.gds-obj.obj-type = x_obj-group.obj-type and
     7326        ub.gds-obj.obj-code = x_obj-group.obj-code
     7327        no-error.
     7328   if  available ub.gds-obj then
     7329     if ub.goods.gds-type = 'т':U then
     7330       assign
     7331         f-cost = if var-pr-r-b = "rubl" then ub.gds-obj.avrg-rubl else ub.gds-obj.avrg-base
     7332         .
     7333       else  f-cost = ?.
     7334   else f-cost = ?.
     7335     return ( f-cost ).
     7336   end function.
     7337   function fnc-pr return decimal (buffer local-price-list for ub.price-doc-forming-gds).
     7338   define variable f-pr   as decimal no-undo .
     7339   find first x_obj-group .
     7340   find first ub.goods where ub.goods.artic = local-price-list.artic and
     7341                          ub.goods.prod-type = local-price-list.prod-type and
     7342                          ub.goods.prod-code = local-price-list.prod-code no-lock  no-error .
     7343   find ub.gds-obj no-lock where
     7344        ub.gds-obj.gds-code = ub.goods.gds-code and
     7345        ub.gds-obj.obj-type = x_obj-group.obj-type and
     7346        ub.gds-obj.obj-code = x_obj-group.obj-code
     7347        no-error.
     7348   if  available ub.gds-obj then
     7349     if ub.goods.gds-type = 'т':U then
     7350       assign
     7351         f-pr = if var-pr-r-b = "rubl" then ub.gds-obj.last-rubl  else ub.gds-obj.last-base
     7352         .
     7353       else  f-pr = ?.
     7354   else f-pr = ?.
     7355      return ( f-pr ).
     7356   end function.
     7357   procedure make-fact-order-lib3 :
     7358   define input  parameter p-recid as recid no-undo .
     7359   define output parameter p-fact-order-sys-from as decimal   no-undo .
     7360   define output parameter p-fact-order-sys-to   as decimal   no-undo .
     7361   define buffer buf_price-doc-forming for ub.price-doc-forming  .
     7362   define buffer buf_price-list-type for ub.price-list-type  .
     7363   define variable v-shift-end-fact-order as decimal no-undo .
     7364   define variable v-day-end-fact-order   as decimal no-undo .
     7365   define variable v-fact-order           as decimal no-undo .
     7366     do
     7367     on error undo, return error return-value
     7368     :
     7369   find first buf_price-doc-forming  no-lock where recid(buf_price-doc-forming ) = p-recid no-error .
     7370     if error-status :error then return error error-status :get-message(1) .
     7371   find first buf_price-list-type  no-lock where
     7372              buf_price-list-type.plt-id = buf_price-doc-forming.plt-id and
     7373              buf_price-list-type.plt-db-num = buf_price-doc-forming.plt-db-num no-error .
     7374     if error-status :error then return error error-status :get-message(1) .
     7375    if buf_price-doc-forming.have-start-period = 1 then do:
     7376       case buf_price-list-type.work-date :
     7377         when int('1':U)  then
     7378           do :
     7379              run day-begin-fact-order
     7380                   ( buf_price-doc-forming.start-date ,
     7381                    output p-fact-order-sys-from ) no-error .
     7382                    if error-status :error then
     7383                    return error substitute ( "Ошибка из day-begin-fact-order &1 &2" ,
     7384                                               error-status :get-message(1) ,
     7385                                               return-value ).
     7386           end.
     7387         when int('2':U)   then
     7388           do :
     7389             run factord (
     7390                input   buf_price-doc-forming.start-shift-date
     7391               ,input   buf_price-doc-forming.sys-time
     7392               ,input   1
     7393               ,input   buf_price-doc-forming.start-shift-date
     7394               ,input   buf_price-doc-forming.start-shift-num
     7395               ,input   true
     7396               ,output  p-fact-order-sys-from
     7397               ,output  v-shift-end-fact-order
     7398               ,output  v-day-end-fact-order
     7399               ) no-error  .
     7400               if error-status :error then
     7401                    return error substitute ( "Ошибка из factord &1 &2" ,
     7402                                               error-status :get-message(1) ,
     7403                                               return-value ).
     7404           end.
     7405         when int('3':U)   then
     7406           do :
     7407             run factord (
     7408               input    buf_price-doc-forming.start-sys-date
     7409               ,input   buf_price-doc-forming.start-sys-time
     7410               ,input   (if buf_price-doc-forming.start-sys-time = 0 or buf_price-doc-forming.start-sys-time = ? then 1 else buf_price-doc-forming.start-sys-time )
     7411               ,input   ?
     7412               ,input   ?
     7413               ,input   false
     7414               ,output  p-fact-order-sys-from
     7415               ,output  v-shift-end-fact-order
     7416               ,output  v-day-end-fact-order
     7417               ) no-error .
     7418               if error-status :error then
     7419                    return error substitute ( "Ошибка из factord  - дата сервера &1 &2" ,
     7420                                               error-status :get-message(1) ,
     7421                                               return-value ).
     7422           end.
     7423       end case.
     7424     end.
     7425    if buf_price-doc-forming.have-end-period = 1 then do:
     7426       case buf_price-list-type.work-date :
     7427         when int('1':U)   then
     7428           do :
     7429              run factord-end-day
     7430                 ( buf_price-doc-forming.end-date ,
     7431                   output p-fact-order-sys-to ) no-error .
     7432                   if error-status :error then
     7433                    return error substitute ( "Ошибка из factord-end-day дата на объекте на конец периода &1 &2" ,
     7434                                               error-status :get-message(1) ,
     7435                                               return-value ).
     7436           end.
     7437         when int('2':U)   then
     7438           do :
     7439             run factord (
     7440                input   buf_price-doc-forming.end-shift-date
     7441               ,input   buf_price-doc-forming.sys-time
     7442               ,input   1
     7443               ,input   buf_price-doc-forming.end-shift-date
     7444               ,input   buf_price-doc-forming.end-shift-num
     7445               ,input   true
     7446               ,output  v-fact-order
     7447               ,output  p-fact-order-sys-to
     7448               ,output  v-day-end-fact-order
     7449               ) no-error .
     7450               if error-status :error then
     7451                 return error substitute ( "Ошибка из factord сменная дата на конец &1 &2" ,
     7452                                           error-status :get-message(1) ,
     7453                                           return-value ).
     7454           end.
     7455         when int('3':U)   then
     7456           do :
     7457             run factord (
     7458                input   buf_price-doc-forming.end-sys-date
     7459               ,input   buf_price-doc-forming.end-sys-time
     7460               ,input   (if buf_price-doc-forming.end-sys-time  = 0 or buf_price-doc-forming.end-sys-time = ? then 1 else buf_price-doc-forming.end-sys-time )
     7461               ,input   ?
     7462               ,input   ?
     7463               ,input   false
     7464               ,output  p-fact-order-sys-to
     7465               ,output  v-shift-end-fact-order
     7466               ,output  v-day-end-fact-order
     7467               ) no-error .
     7468               if error-status :error then
     7469                 return error substitute ( "Ошибка из factord  - дата сервера &1 &2" ,
     7470                                           error-status :get-message(1) ,
     7471                                           return-value ).
     7472           end.
     7473       end case.
     7474     end.
     7475     end.
     7476   end procedure.
     7477   procedure ver-dfc-mpl-lib3 :
     7478   define input  parameter p-recid as recid no-undo .
     7479   define buffer buf_price-doc-forming for ub.price-doc-forming  .
     7480   define buffer buf_price-list-type for ub.price-list-type  .
     7481   define buffer buf_price-doc-forming-gds for ub.price-doc-forming-gds  .
     7482   define buffer buf_price-doc-forming-gds-qnty for ub.price-doc-forming-gds-qnty  .
     7483   define buffer buf_price-doc-sum  for ub.price-doc-forming-gds-sum  .
     7484   define buffer buf_price-doc-forming-gds-tnv  for ub.price-doc-forming-gds-tnv  .
     7485   define variable v-fact-order-sys-from   as decimal   no-undo .
     7486   define variable v-fact-order-sys-to     as decimal   no-undo .
     7487     do
     7488     on error undo, return error return-value
     7489    :
     7490   find first buf_price-doc-forming  no-lock where recid(buf_price-doc-forming ) = p-recid no-error .
     7491     if error-status :error then return error error-status :get-message(1) .
     7492   find first buf_price-list-type  no-lock where
     7493              buf_price-list-type.plt-id = buf_price-doc-forming.plt-id and
     7494              buf_price-list-type.plt-db-num = buf_price-doc-forming.plt-db-num no-error .
     7495     if error-status :error then return error error-status :get-message(1) .
     7496     if buf_price-list-type.stts = integer('1':U) then do:
     7497        return error substitute(" ТПЛ &1 в статусе УДАЛЕН ! Закрывать с ним новые ДНЦ нельзя !" , buf_price-list-type.name )  .
     7498     end.
     7499     if buf_price-list-type.bgr-id > 0 then do:
     7500         find ub.buyer-group where
     7501               ub.buyer-group.stts       = 0  and
     7502               ub.buyer-group.bgr-db-num = buf_price-list-type.bgr-db-num and
     7503               ub.buyer-group.bgr-id     = buf_price-list-type.bgr-id
     7504               no-lock no-error .
     7505         if not available ub.buyer-group then
     7506         return error substitute(" ТПЛ &1 содержит некорректную группу по покупателям &2(&3) !" , buf_price-list-type.name,buf_price-list-type.bgr-id,buf_price-list-type.bgr-db-num )  .
     7507     end.
     7508     if buf_price-list-type.sgr-id > 0 then do:
     7509         find ub.sum-group where
     7510               ub.sum-group.stts       = 0  and
     7511               ub.sum-group.sgr-db-num = buf_price-list-type.sgr-db-num and
     7512               ub.sum-group.sgr-id     = buf_price-list-type.sgr-id
     7513               no-lock no-error .
     7514         if not available ub.sum-group then
     7515         return error substitute(" ТПЛ &1 содержит некорректную суммовую группу &2(&3) !" , buf_price-list-type.name,buf_price-list-type.sgr-id,buf_price-list-type.sgr-db-num )  .
     7516     end.
     7517     if buf_price-list-type.qgr-id > 0 then do:
     7518         find ub.qnty-group where
     7519              ub.qnty-group.stts       = 0  and
     7520              ub.qnty-group.qgr-db-num = buf_price-list-type.qgr-db-num and
     7521              ub.qnty-group.qgr-id     = buf_price-list-type.qgr-id
     7522              no-lock no-error .
     7523         if not available ub.qnty-group then
     7524         return error substitute(" ТПЛ &1 содержит некорректную количественную группу &2(&3) !" , buf_price-list-type.name,buf_price-list-type.qgr-id,buf_price-list-type.qgr-db-num )  .
     7525     end.
     7526     if buf_price-list-type.tog-id > 0 then do:
     7527         find ub.turnover-group where
     7528              ub.turnover-group.stts       = 0  and
     7529              ub.turnover-group.tog-db-num = buf_price-list-type.tog-db-num and
     7530              ub.turnover-group.tog-id     = buf_price-list-type.tog-id
     7531             no-lock no-error .
     7532         if not available ub.turnover-group then
     7533         return error substitute(" ТПЛ &1 содержит некорректную группу по оборотам &2(&3) !" , buf_price-list-type.name , buf_price-list-type.tog-id , buf_price-list-type.tog-db-num )  .
     7534     end.
     7535     if buf_price-list-type.gop-id > 0 then do:
     7536         find ub.grp-obj-price where
     7537               ub.grp-obj-price.stts       = 0  and
     7538               ub.grp-obj-price.gop-db-num = buf_price-list-type.gop-db-num and
     7539               ub.grp-obj-price.gop-id     = buf_price-list-type.gop-id
     7540               no-lock no-error .
     7541         if not available ub.grp-obj-price then
     7542         return error substitute(" ТПЛ &1 содержит некорректную группу по объектам &2(&3) !" , buf_price-list-type.name,buf_price-list-type.gop-id,buf_price-list-type.gop-db-num )  .
     7543     end.
     7544     if buf_price-list-type.gop-id-for-calc-turnover > 0 then do:
     7545         find ub.grp-obj-price where
     7546               ub.grp-obj-price.stts       = 0  and
     7547               ub.grp-obj-price.gop-db-num = buf_price-list-type.gop-db-num-for-calc-turnover and
     7548               ub.grp-obj-price.gop-id     = buf_price-list-type.gop-id-for-calc-turnover
     7549               no-lock no-error .
     7550         if not available ub.grp-obj-price then
     7551         return error substitute(" ТПЛ &1 содержит некорректную группу по объектам &2(&3) !" , buf_price-list-type.name,buf_price-list-type.gop-id-for-calc-turnover,buf_price-list-type.gop-db-num-for-calc-turnover )  .
     7552     end.
     7553      if buf_price-doc-forming.have-start-period = integer(true) then do:
     7554         case buf_price-list-type.work-date :
     7555             when int('1':U)     then
     7556               do :
     7557                  if buf_price-doc-forming.start-date = ? then return error "Не задана дата начала действия цен !" .
     7558               end.
     7559             when int('2':U)   then
     7560               do :
     7561                   if buf_price-doc-forming.start-shift-date = ? then return error "Не задана сменная дата начала действия цен !" .
     7562                   if buf_price-doc-forming.start-shift-num  = ? or
     7563                      buf_price-doc-forming.start-shift-num = 0  then return error "Не задан порядок смены начала действия цен !" .
     7564               end.
     7565             when int('3':U)     then
     7566               do :
     7567                   if buf_price-doc-forming.start-sys-date = ? then return error "Не задана дата начала действия цен !" .
     7568                   if buf_price-doc-forming.start-sys-time = ? then return error "Не задано время начала действия цен !" .
     7569               end.
     7570         end case.
     7571      end.
     7572      if buf_price-doc-forming.have-end-period = integer(true) then do:
     7573         case buf_price-list-type.work-date :
     7574             when int('1':U)     then
     7575               do :
     7576                  if buf_price-doc-forming.end-date = ? then return error "Не задана дата окончания действия цен !" .
     7577               end.
     7578             when int('2':U)   then
     7579               do :
     7580                   if buf_price-doc-forming.end-shift-date = ? then return error "Не задана сменная дата окончания действия цен !" .
     7581                   if buf_price-doc-forming.end-shift-num  = ? or
     7582                      buf_price-doc-forming.end-shift-num = 0  then return error "Не задан порядок смены окончания  действия цен !" .
     7583               end.
     7584             when int('3':U)     then
     7585               do :
     7586                   if buf_price-doc-forming.end-sys-date = ? then return error "Не задана дата окончания действия цен !" .
     7587                   if buf_price-doc-forming.end-sys-time = ? then return error "Не задано время окончания действия цен !" .
     7588               end.
     7589         end case.
     7590      end.
     7591      if buf_price-doc-forming.have-start-period = integer(true) and
     7592         buf_price-doc-forming.have-end-period = integer(true) then do:
     7593         case buf_price-list-type.work-date :
     7594             when int('1':U)     then
     7595               do :
     7596                  if buf_price-doc-forming.end-date < buf_price-doc-forming.start-date then return error "Не верно задан интервал дат !" .
     7597               end.
     7598             when int('2':U)   then
     7599               do :
     7600                   if buf_price-doc-forming.end-shift-date < buf_price-doc-forming.start-shift-date then return error "Не верно задан интервал дат !" .
     7601                   if buf_price-doc-forming.end-shift-date = buf_price-doc-forming.start-shift-date then do:
     7602                      if buf_price-doc-forming.end-shift-num < buf_price-doc-forming.start-shift-num then return error "Не верно задан интервал смен !" .
     7603                   end.
     7604               end.
     7605             when int('3':U)     then
     7606               do :
     7607                   if buf_price-doc-forming.end-sys-date < buf_price-doc-forming.start-sys-date then return error "Не верно задан интервал дат !" .
     7608                   if buf_price-doc-forming.end-sys-date = buf_price-doc-forming.start-sys-date then do:
     7609                      if buf_price-doc-forming.end-sys-time < buf_price-doc-forming.start-sys-time then return error "Не верно задан интервал времени !" .
     7610                   end.
     7611               end.
     7612         end case.
     7613      end.
     7614   if buf_price-doc-forming.name = "" then return error "Не задано название ДНЦ !" .
     7615   if buf_price-list-type.main = false then do:
     7616       run make-fact-order-lib3 in this-procedure
     7617           ( input  p-recid ,
     7618             output v-fact-order-sys-from ,
     7619             output v-fact-order-sys-to   ) .
     7620   end.
     7621   define variable old-price as decimal   no-undo .
     7622   define variable v-kol-rec as integer   no-undo .
     7623   define variable v-gds-null-price as character no-undo initial "" .
     7624   define variable v-type as character no-undo .
     7625   v-kol-rec = 0.
     7626   for each buf_price-doc-forming-gds no-lock where
     7627            buf_price-doc-forming-gds.plt-id     = buf_price-doc-forming.plt-id      and
     7628            buf_price-doc-forming-gds.plt-db-num = buf_price-doc-forming.plt-db-num  and
     7629            buf_price-doc-forming-gds.pdf-id     = buf_price-doc-forming.pdf-id      and
     7630            buf_price-doc-forming-gds.pdf-db     = buf_price-doc-forming.pdf-db      :
     7631       find first ub.bar-code no-lock where
     7632                  ub.bar-code.b-code = buf_price-doc-forming-gds.b-code no-error .
     7633                  if error-status :error then return error substitute ("Не найден бар-код &1" ,  buf_price-doc-forming-gds.b-code ) .
     7634       find first ub.goods no-lock where
     7635                  ub.goods.artic = buf_price-doc-forming-gds.artic         and
     7636                  ub.goods.prod-type = buf_price-doc-forming-gds.prod-type and
     7637                  ub.goods.prod-code = buf_price-doc-forming-gds.prod-code no-error .
     7638                  if error-status :error then return error substitute ("Не найден товар &1 &2 &3" ,  buf_price-doc-forming-gds.artic , buf_price-doc-forming-gds.prod-type ,buf_price-doc-forming-gds.prod-code) .
     7639       if ub.bar-code.gds-code <> ub.goods.gds-code then return error substitute ("Бар-код &4 не соответствует товару &1 &2 &3" ,  buf_price-doc-forming-gds.artic , buf_price-doc-forming-gds.prod-type ,buf_price-doc-forming-gds.prod-code, buf_price-doc-forming-gds.b-code ) .
     7640       run gds-attr-value in this-procedure (input ub.goods.gds-code
     7641                                            ,input 'null-price':U
     7642                                            ,output v-gds-null-price
     7643                                            ,output v-type ) no-error .
     7644       if buf_price-doc-forming-gds.price-sale-doc   = ? or (buf_price-doc-forming-gds.price-sale-doc   = 0 and not logical(v-gds-null-price) )
     7645                   then return error substitute ("Продажная цена по товару &1 &2 &3 = &4" ,  buf_price-doc-forming-gds.artic , buf_price-doc-forming-gds.prod-type ,buf_price-doc-forming-gds.prod-code, buf_price-doc-forming-gds.price-sale-doc  ) .
     7646       if buf_price-doc-forming-gds.price-sale-rubl  = ? or (buf_price-doc-forming-gds.price-sale-rubl  = 0 and not logical(v-gds-null-price) )
     7647                   then return error substitute ("Продажная цена по товару &1 &2 &3 = &4" ,  buf_price-doc-forming-gds.artic , buf_price-doc-forming-gds.prod-type ,buf_price-doc-forming-gds.prod-code, buf_price-doc-forming-gds.price-sale-rubl ) .
     7648       if buf_price-doc-forming-gds.price-sale-base  = ? or (buf_price-doc-forming-gds.price-sale-base  = 0 and not logical(v-gds-null-price) )
     7649                   then return error substitute ("Продажная цена по товару &1 &2 &3 = &4" ,  buf_price-doc-forming-gds.artic , buf_price-doc-forming-gds.prod-type ,buf_price-doc-forming-gds.prod-code, buf_price-doc-forming-gds.price-sale-base ) .
     7650       if buf_price-doc-forming-gds.slt-pc = ? then return error substitute ("НсП по товару &1 &2 &3 не определен" ,  buf_price-doc-forming-gds.artic , buf_price-doc-forming-gds.prod-type ,buf_price-doc-forming-gds.prod-code) .
     7651       if buf_price-doc-forming-gds.vat-pc = ? then return error substitute ("НДС по товару &1 &2 &3 не определен" ,  buf_price-doc-forming-gds.artic , buf_price-doc-forming-gds.prod-type ,buf_price-doc-forming-gds.prod-code) .
     7652   old-price = ? .
     7653     for each buf_price-doc-forming-gds-qnty no-lock where
     7654              buf_price-doc-forming-gds-qnty.plt-id = buf_price-doc-forming-gds.plt-id and
     7655              buf_price-doc-forming-gds-qnty.plt-db-num = buf_price-doc-forming-gds.plt-db-num and
     7656              buf_price-doc-forming-gds-qnty.pdf-id = buf_price-doc-forming-gds.pdf-id and
     7657              buf_price-doc-forming-gds-qnty.pdf-db = buf_price-doc-forming-gds.pdf-db and
     7658              buf_price-doc-forming-gds-qnty.b-code = buf_price-doc-forming-gds.b-code
     7659              by buf_price-doc-forming-gds-qnty.ggr-qnty :
     7660              if old-price < buf_price-doc-forming-gds-qnty.price-sale-doc and old-price <> ? then do:
     7661                 return error substitute ("Цена по товару &1 &2 &3 по категории количество покупки >= &4  больше предыдущей категории (&5 и  &6)" ,  buf_price-doc-forming-gds.artic , buf_price-doc-forming-gds.prod-type ,buf_price-doc-forming-gds.prod-code, buf_price-doc-forming-gds-qnty.ggr-qnty ,old-price , buf_price-doc-forming-gds-qnty.price-sale-doc) .
     7662              end.
     7663              old-price = buf_price-doc-forming-gds-qnty.price-sale-doc .
     7664     end.
     7665   old-price = ? .
     7666     for each buf_price-doc-sum no-lock where
     7667              buf_price-doc-sum.plt-id     = buf_price-doc-forming-gds.plt-id and
     7668              buf_price-doc-sum.plt-db-num = buf_price-doc-forming-gds.plt-db-num and
     7669              buf_price-doc-sum.pdf-id     = buf_price-doc-forming-gds.pdf-id and
     7670              buf_price-doc-sum.pdf-db     = buf_price-doc-forming-gds.pdf-db and
     7671              buf_price-doc-sum.b-code     = buf_price-doc-forming-gds.b-code
     7672              by buf_price-doc-sum.ssg-summa
     7673              :
     7674              if old-price < buf_price-doc-sum.price-sale-doc and old-price <> ? then do:
     7675                 return error substitute ("Цена по товару &1 &2 &3 по категории сумма покупки >= &4  больше предыдущей категории (&5 и  &6)" ,  buf_price-doc-forming-gds.artic , buf_price-doc-forming-gds.prod-type ,buf_price-doc-forming-gds.prod-code, buf_price-doc-sum.ssg-summa , old-price , buf_price-doc-sum.price-sale-doc) .
     7676              end.
     7677              old-price = buf_price-doc-sum.price-sale-doc .
     7678     end.
     7679   old-price = ? .
     7680     for each buf_price-doc-forming-gds-tnv no-lock where
     7681              buf_price-doc-forming-gds-tnv.plt-id     = buf_price-doc-forming-gds.plt-id and
     7682              buf_price-doc-forming-gds-tnv.plt-db-num = buf_price-doc-forming-gds.plt-db-num and
     7683              buf_price-doc-forming-gds-tnv.pdf-id     = buf_price-doc-forming-gds.pdf-id and
     7684              buf_price-doc-forming-gds-tnv.pdf-db     = buf_price-doc-forming-gds.pdf-db and
     7685              buf_price-doc-forming-gds-tnv.b-code     = buf_price-doc-forming-gds.b-code
     7686              by buf_price-doc-forming-gds-tnv.ttg-summa :
     7687              if old-price < buf_price-doc-forming-gds-tnv.price-sale-doc and old-price <> ? then do:
     7688                 return error substitute ("Цена по товару &1 &2 &3 по категории сумма оборота покупателя >= &4  больше предыдущей категории (&5 и  &6)" ,  buf_price-doc-forming-gds.artic , buf_price-doc-forming-gds.prod-type ,buf_price-doc-forming-gds.prod-code, buf_price-doc-forming-gds-tnv.ttg-summa ,old-price , buf_price-doc-forming-gds-tnv.price-sale-doc) .
     7689              end.
     7690              old-price = buf_price-doc-forming-gds-tnv.price-sale-doc .
     7691     end.
     7692     define buffer old_price-doc-forming for ub.price-doc-forming  .
     7693     define buffer old_price-doc-forming-gds for ub.price-doc-forming-gds  .
     7694     define buffer old_price-all for ub.price-all.
     7695     if buf_price-list-type.main = false then do:
     7696        for each old_price-doc-forming no-lock where
     7697                 old_price-doc-forming.plt-id     = buf_price-list-type.plt-id     and
     7698                 old_price-doc-forming.plt-db-num = buf_price-list-type.plt-db-num and
     7699                 old_price-doc-forming.stts       = integer('3':U)  ,
     7700                 each old_price-doc-forming-gds no-lock where
     7701                       old_price-doc-forming-gds.plt-id     = buf_price-list-type.plt-id      and
     7702                       old_price-doc-forming-gds.plt-db-num = buf_price-list-type.plt-db-num  and
     7703                       old_price-doc-forming-gds.pdf-id     = old_price-doc-forming.pdf-id    and
     7704                       old_price-doc-forming-gds.pdf-db     = old_price-doc-forming.pdf-db    and
     7705                       old_price-doc-forming-gds.b-code     = buf_price-doc-forming-gds.b-code :
     7706                for each old_price-all no-lock where
     7707                         old_price-all.plt-id     = old_price-doc-forming-gds.plt-id      and
     7708                         old_price-all.plt-db-num = old_price-doc-forming-gds.plt-db-num  and
     7709                         old_price-all.pdf-id     = old_price-doc-forming-gds.pdf-id      and
     7710                         old_price-all.pdf-db     = old_price-doc-forming-gds.pdf-db      and
     7711                         old_price-all.b-code     = old_price-doc-forming-gds.b-code      and
     7712                         old_price-all.fact-order-sys-to   >= v-fact-order-sys-from       and
     7713                         old_price-all.fact-order-sys-from <= v-fact-order-sys-to         :
     7714                        return error substitute ("По товару &1 &2 &3 есть цена &6 в пересекающийся период с таким же приоритетом &7 (ДНЦ &4 &5) " ,
     7715                                                  buf_price-doc-forming-gds.artic ,
     7716                                                  buf_price-doc-forming-gds.prod-type ,
     7717                                                  buf_price-doc-forming-gds.prod-code,
     7718                                                  old_price-all.pdf-id ,
     7719                                                  old_price-all.pdf-db ,
     7720                                                  old_price-doc-forming-gds.price-sale-doc ,
     7721                                                  old_price-all.plt-priority
     7722                                                  ) .
     7723                end.
     7724        end.
     7725        end.
     7726       assign v-kol-rec = v-kol-rec + 1 .
     7727   end.
     7728     run ver-pr-equ-qS in this-procedure
     7729       ( input buf_price-doc-forming.plt-id ,
     7730         input buf_price-doc-forming.plt-db-num,
     7731         input buf_price-doc-forming.pdf-id ,
     7732         input buf_price-doc-forming.pdf-db
     7733         ) no-error .
     7734     if error-status :error then  return error  "Ошибка при удалении строки ДНЦ "   .
     7735   if v-kol-rec = 0 then return error "no-records":U.
     7736   end.
     7737   end procedure.
     7738   procedure ver-pr-equ-qS :
     7739   define input parameter  p-plt-id      as integer   no-undo .
     7740   define input parameter  p-plt-db-num  as integer   no-undo .
     7741   define input parameter  p-pdf-id      as integer   no-undo .
     7742   define input parameter  p-pdf-db      as integer   no-undo .
     7743     do
     7744     on error undo, return error return-value
     7745     :
     7746   define variable  l-doc-num2   like ub.price-list.doc-num    no-undo .
     7747   define buffer pdf_price-list  for ub.price-doc-forming-gds .
     7748   define buffer pp_price-list   for ub.price-doc-forming-gds .
     7749   define buffer main_price-list for ub.price-doc-forming-gds .
     7750   define buffer alt_price-list  for ub.price-doc-forming-gds .
     7751   define buffer buf1-bar-code   for ub.bar-code .
     7752   define buffer buf2-bar-code   for ub.bar-code .
     7753   define buffer buf_goods for ub.goods  .
     7754   define buffer buf2_goods for ub.goods  .
     7755   define variable v-num as integer init 0 no-undo .
     7756   define variable bbb   as logical no-undo .
     7757   define variable l-price-sale like ub.price-list.price-sale no-undo .
     7758   define variable l-road-tax   like ub.price-list.road-tax   no-undo .
     7759   define variable l-excise     like ub.price-list.excise     no-undo .
     7760   define variable l-ok          as logical no-undo .
     7761   define variable check-par     as logical no-undo .
     7762   define variable main-b-code   as integer no-undo .
     7763   define variable par-pr-equ-dq as integer no-undo .
     7764   define variable v-price-sale  as decimal no-undo .
     7765   define variable vss-include-info68 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7766   empty temp-table thbjattr_thbj-attr.
     7767   run adm/shattri.p (
     7768      input "get":U
     7769     ,input v-cntxt-obj-type
     7770     ,input v-cntxt-obj-code
     7771     ,input 'overval':U
     7772     ,input  ""
     7773     ,output v-value-character
     7774     ,output v-value-date
     7775     ,output v-value-decimal
