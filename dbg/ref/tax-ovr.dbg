     9990     define buffer buf_temp-browse-handle  for temp-browse-handle .
     9991     if p-change-value > 0
     9992     then do:
     9993       if frame frm :width + p-change-value >
     9994           session :width-chars
     9995       then do:
     9996         assign
     9997           p-change-value = session :width-chars - frame frm :width
     9998         .
     9999         if p-change-value <= 0
    10000         then do:
    10001           run diasize_position-resize-button in this-procedure .
    10002           return .
    10003         end.
    10004       end.
    10005     end.
    10006     if p-change-value < 0
    10007     then do:
    10008       if frame frm :width + p-change-value < v-diasize-orig-frame-width
    10009       then do:
    10010         assign
    10011           p-change-value = v-diasize-orig-frame-width
    10012                          - frame frm :width
    10013         .
    10014         if p-change-value >= 0
    10015         then do:
    10016           run diasize_position-resize-button in this-procedure .
    10017           return .
    10018         end.
    10019       end.
    10020     end.
    10021     if p-change-value >= 0
    10022     then do:
    10023       assign
    10024         v-change-sign = 1
    10025       .
    10026     end.
    10027     else do:
    10028       assign
    10029         v-change-sign = -1
    10030       .
    10031     end.
    10032     assign
    10033       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
    10034     .
    10035     if p-change-value = 0
    10036     then do:
    10037       run diasize_position-resize-button in this-procedure .
    10038       return .
    10039     end.
