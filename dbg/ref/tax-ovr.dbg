     2218         vss-workfile vss-revision vss-description
     2219         skip "Не удалось найти фирму объекта"
     2220         skip p-obj-type p-obj-code
     2221         skip return-value
     2222         skip trim(error-status :get-message(1))
     2223       view-as alert-box error.
     2224       undo, return error .
     2225   end.
     2226   define buffer buf_gds-grp-obj      for ub.gds-grp-obj.
     2227   do while v-found = no and jj < 2:
     2228     if v-range <> 3 then do:
     2229       find first buf_gds-grp-obj no-lock
     2230           where buf_gds-grp-obj.node-code = p-node-code
     2231             and buf_gds-grp-obj.host-code = v-host-code
     2232             and buf_gds-grp-obj.obj-type  = p-obj-type
     2233             and buf_gds-grp-obj.obj-code  = p-obj-code
     2234       no-error .
     2235     end.
     2236     if v-range = 3 or not available buf_gds-grp-obj
     2237     then do:
     2238        if v-range <> 2 then do:
     2239           find first buf_gds-grp-obj no-lock
     2240               where buf_gds-grp-obj.node-code = p-node-code
     2241                 and buf_gds-grp-obj.host-code = v-host-code
     2242                 and buf_gds-grp-obj.obj-type  = ""
     2243                 and buf_gds-grp-obj.obj-code  = 0
     2244           no-error .
     2245         end.
     2246         if v-range = 2 or not available buf_gds-grp-obj
     2247         then do:
     2248             if v-range <> 1 then do:
     2249               find first buf_gds-grp-obj no-lock
     2250                   where buf_gds-grp-obj.node-code = p-node-code
     2251                   and buf_gds-grp-obj.host-code = 0
     2252                   and buf_gds-grp-obj.obj-type  = ""
     2253                   and buf_gds-grp-obj.obj-code  = 0
     2254               no-error .
     2255             end.
     2256             if v-range = 1 or not available buf_gds-grp-obj
     2257             then do:
     2258                 assign
     2259                     v-exists = no
     2260                 .
     2261             end.
     2262             else do:
     2263                 assign
     2264                     v-exists = yes
     2265                     v-range = 1
     2266                 .
     2267             end.
     2268         end.
     2269         else do:
     2270             assign
     2271                 v-exists = yes
     2272                 v-range  = 2
     2273             .
     2274         end.
     2275     end.
     2276     else do:
     2277         assign
     2278             v-exists = yes
     2279             v-range  = 3
     2280         .
     2281     end.
     2282     if available buf_gds-grp-obj
     2283     then do:
     2284       find first buf_gds-grp-obj-attr no-lock
     2285         where buf_gds-grp-obj-attr.node-code   = p-node-code
     2286           and buf_gds-grp-obj-attr.host-code   = buf_gds-grp-obj.host-code
     2287           and buf_gds-grp-obj-attr.obj-type    = buf_gds-grp-obj.obj-type
     2288           and buf_gds-grp-obj-attr.obj-code    = buf_gds-grp-obj.obj-code
     2289           and buf_gds-grp-obj-attr.attr-code   = 'NotCorrOP':U
     2290         no-error .
     2291       if available buf_gds-grp-obj-attr then do:
     2292         assign
     2293           v-notcorr-value = (if buf_gds-grp-obj-attr.attr-value = '' then ? else buf_gds-grp-obj-attr.attr-value)
     2294         .
     2295       end.
     2296       else do:
     2297         assign
     2298           v-notcorr-value = ?
     2299         .
     2300       end.
     2301       assign
     2302       p-exists-notcorr = (if v-notcorr-value <> ? and p-notcorr = ?
     2303                           then yes
     2304                           else p-exists-notcorr)
     2305       p-range-notcorr = if p-exists-notcorr and p-notcorr = ?
     2306                         then v-range
     2307                         else p-range-notcorr
     2308       p-notcorr   =  if p-exists-notcorr and  p-notcorr = ?
     2309                         then v-notcorr-value
     2310                         else p-notcorr
     2311       v-found =  (p-exists-notcorr ) or (v-range <= 1)
     2312       jj = jj + 1
     2313       .
     2314     end.
     2315     else do:
     2316       assign
     2317       v-found =  (p-exists-notcorr  ) or (v-range <= 1)
     2318       jj = jj + 1
     2319       .
     2320     end.
     2321   end.
     2322   end.
     2323   end procedure.
     2324   define variable vss-include-info28 as character format "X(65)" no-undo
     2325   initial "@(#)$Workfile$ $Revision$".
     2326   procedure grplib-get-full-name :
     2327      define input parameter p-node-code  as integer      no-undo.
     2328      define output parameter p-full-name as character    no-undo.
     2329      do
     2330   on error undo, return error
     2331   :
     2332       define variable v-upper-code    as integer           no-undo.
     2333       define buffer buf_gds-grp       for ub.gds-grp.
     2334       define buffer buf_upper_gds-grp for ub.gds-grp.
     2335       find first buf_gds-grp no-lock
     2336            where buf_gds-grp.node-code = p-node-code
     2337       no-error.
     2338       if not available buf_gds-grp
     2339       then do:
     2340           undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
     2341       end.
     2342       assign
     2343           p-full-name  = ""
     2344           v-upper-code = 1
     2345       .
     2346       do while buf_gds-grp.upper-code <> 0
     2347       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
     2348       :
     2349           assign
     2350               p-full-name  = buf_gds-grp.node-name
     2351                            + (if p-full-name <> "" then chr(47) else "")
     2352                            + p-full-name
     2353               v-upper-code = buf_gds-grp.upper-code
     2354           .
     2355           find first buf_gds-grp no-lock
     2356                where buf_gds-grp.node-code = v-upper-code
     2357           no-error.
     2358           if not available buf_gds-grp
     2359           then do:
     2360               undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом "
     2361                                   + string( v-upper-code )
     2362                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
     2363           end.
     2364       end.
     2365       assign
     2366       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
     2367       .
     2368   end.
     2369   end .
     2370   procedure grplib-get-node-from-full-name :
     2371   define input parameter p-full-name as character no-undo .
     2372   define output parameter p-node-code as integer no-undo .
     2373   define variable v-ii as integer no-undo .
     2374   define variable v-upper-code as integer no-undo .
     2375   define variable v-root-code as integer no-undo .
     2376   define variable v-entry as character no-undo .
     2377   define buffer buf_gds-grp       for ub.gds-grp.
     2378   do
     2379   on error undo, return error
     2380   :
     2381     find first buf_gds-grp no-lock
     2382         where buf_gds-grp.upper-code = 0
     2383     no-error .
     2384     if not available buf_gds-grp
     2385     then do:
     2386         undo, return error substitute("Не найдена корневая группа товаров (upper-code = 0)").
     2387     end.
     2388     else do:
     2389       assign
     2390       v-root-code = buf_gds-grp.node-code
     2391       .
     2392     end.
     2393     v-upper-code = v-root-code.
     2394     do v-ii = 1 to num-entries(p-full-name, chr(47)):
     2395       assign
     2396       v-entry = entry(v-ii, p-full-name, chr(47)).
     2397       if v-entry = '' then leave.
     2398       find first buf_gds-grp no-lock where
     2399                 buf_gds-grp.node-name = v-entry
     2400             and buf_gds-grp.upper-code = v-upper-code
     2401             no-error.
     2402       if not available buf_gds-grp then do:
     2403         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
     2404       end.
     2405       else do:
     2406         p-node-code = buf_gds-grp.node-code.
     2407         v-upper-code = buf_gds-grp.node-code.
     2408       end.
     2409     end.
     2410   end.
     2411   end .
     2412   procedure  chec-par :
     2413   define output parameter l-par as logical no-undo .
     2414   define input parameter l-host like ub.clients.obj-code no-undo .
     2415   define input parameter l-type like ub.clients.obj-type no-undo .
     2416   define input parameter l-code like ub.clients.obj-code no-undo .
