     5204       then do:
     5205         find first x_obj-group.
     5206   define variable vss-include-info58 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5207   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run proprice in g#library
     5208   (  input  p-b-code
     5209    , input  x_obj-group.obj-type
     5210    , input  x_obj-group.obj-code
     5211    , output vd
     5212    , output v-PriceWithVat
     5213    , output v-prod-vat
     5214    , output v-str1
     5215    , output v-str1
     5216           ) no-error .
     5217         if error-status :error then
     5218         message
     5219           vss-workfile vss-revision vss-description skip
     5220           error-status :get-message(1) skip
     5221           return-value skip
     5222           "proprice.i"
     5223           view-as alert-box error
     5224         .
     5225         if vd = 0 or vd = ?  then do:
     5226           message "Нет ПН для товара или цена = 0 :" p-artic  p-b-code skip
     5227                   "На объекте" x_obj-group.obj-type x_obj-group.obj-code skip
     5228                   "- расчет по производителю от последней приходной накладной невозможен."
     5229                   view-as alert-box  .
     5230         end.
     5231         else do:
     5232             cost-rubl = vd .
     5233             cost-base = cost-rubl / p-base-rate * p-base-scale .
     5234             p-new-calc-method = p-calc-method .
     5235         end.
     5236       end.
     5237      when 'Спецификация':U
     5238      then do:
     5239         find first x_obj-group.
     5240         assign
     5241           v-num-specif    = 0
     5242           v-contract-code = 0
     5243         .
     5244         for each buf_contract no-lock
     5245         where buf_contract.host-code = v-cntxt-host-code-obj
     5246         :
     5247   define variable vss-include-info59 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5248   ASSIGN
     5249      i-gl-Host-Code      = 0
     5250      i-gl-Contract-Code  = 0
     5251      i-gl-Extent3        = 0
     5252      .
     5253   RUN MS-Contract-EXTENT-3 IN THIS-PROCEDURE(
     5254       INPUT  v-cntxt-host-code-obj,
     5255       INPUT  buf_contract.contract-code,
     5256       OUTPUT i-gl-Extent3
     5257      ).
     5258   IF i-gl-Extent3[1] = 2 THEN DO:
     5259      ASSIGN
     5260         i-gl-Host-Code      = i-gl-Extent3[2]
     5261         i-gl-Contract-Code  = i-gl-Extent3[3]
     5262         .
     5263   END. ELSE DO:
     5264      ASSIGN
     5265         i-gl-Host-Code      = v-cntxt-host-code-obj
     5266         i-gl-Contract-Code  = buf_contract.contract-code
     5267         .
     5268   END.
     5269   FOR EACH
     5270       buf_contract-specif
     5271        NO-LOCK
     5272        WHERE
     5273            buf_contract-specif.Host-code    = i-gl-Host-Code
     5274        AND buf_contract-specif.Contract-num = i-gl-Contract-Code
     5275              :
     5276               if buf_contract-specif.gds-code = p-gds-code then do:
     5277                 assign
     5278                   v-num-specif = v-num-specif + 1
     5279                   v-contract-code = buf_contract.contract-code
     5280                 .
     5281               end.
     5282           end.
     5283         end.
     5284         if v-num-specif > 1 then do:
     5285            run str/gds-cnts.w
     5286               (input parparentproc
     5287               ,input p-gds-code
     5288               , "b-sel":U
     5289               ,output v-spis
     5290             ) no-error.
     5291           find first buf_contract-specif no-lock
     5292           where recid(buf_contract-specif) = integer(v-spis)
     5293             no-error.
     5294             if available buf_contract-specif then do:
     5295                 run read-bonus (
     5296                     input  buf_contract-specif.contract-num  ,
     5297                     input  buf_contract-specif.host-code     ,
     5298                     input  buf_contract-specif.gds-code      ,
     5299                     output v-bonus  ) .
     5300                 assign
     5301                   cost-rubl = buf_contract-specif.price-cli
     5302                   cost-base = buf_contract-specif.price-cli / p-base-rate * p-base-scale
     5303                   p-new-calc-method = 'Спецификация':U
     5304                 .
     5305                 if v-bonus <> ? and v-bonus <> 0 then do:
     5306                    assign
     5307                    cost-rubl = cost-rubl + ( cost-rubl * v-bonus / 100 )
     5308                    cost-base = cost-base + ( cost-base * v-bonus / 100 )
     5309                    .
     5310                 end.
     5311             end.
     5312             else do:
     5313               message "Не найдена спецификация с recid " v-spis skip
     5314                       "для товара с артикулом " p-artic skip
     5315                       "на объекте " x_obj-group.obj-type x_obj-group.obj-code skip
     5316                       view-as alert-box information .
     5317             end.
     5318         end.
     5319         if v-num-specif = 0 then do:
     5320             message "Не найдена ни одна спецификация" skip
     5321                     "для товара с артикулом " p-artic skip
     5322                     "на объекте " x_obj-group.obj-type x_obj-group.obj-code skip
     5323                     view-as alert-box information .
     5324         end.
     5325         if v-num-specif = 1 then do:
     5326   define variable vss-include-info60 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5327   ASSIGN
     5328      i-gl-Host-Code      = 0
     5329      i-gl-Contract-Code  = 0
     5330      i-gl-Extent3        = 0
     5331      .
     5332   RUN MS-Contract-EXTENT-3 IN THIS-PROCEDURE(
     5333       INPUT  v-cntxt-host-code-obj,
     5334       INPUT  v-contract-code,
     5335       OUTPUT i-gl-Extent3
     5336      ).
     5337   IF i-gl-Extent3[1] = 2 THEN DO:
     5338      ASSIGN
     5339         i-gl-Host-Code      = i-gl-Extent3[2]
     5340         i-gl-Contract-Code  = i-gl-Extent3[3]
     5341         .
     5342   END. ELSE DO:
     5343      ASSIGN
     5344         i-gl-Host-Code      = v-cntxt-host-code-obj
     5345         i-gl-Contract-Code  = v-contract-code
     5346         .
     5347   END.
     5348   FOR EACH
     5349       buf_contract-specif
     5350        NO-LOCK
     5351        WHERE
     5352            buf_contract-specif.Host-code    = i-gl-Host-Code
     5353        AND buf_contract-specif.Contract-num = i-gl-Contract-Code
     5354               :
     5355               if buf_contract-specif.gds-code = p-gds-code then do:
     5356                 run read-bonus (
     5357                     input  buf_contract-specif.contract-num  ,
     5358                     input  buf_contract-specif.host-code     ,
     5359                     input  buf_contract-specif.gds-code      ,
     5360                     output v-bonus  ) .
     5361                 assign
     5362                   cost-rubl = buf_contract-specif.price-cli
     5363                   cost-base = buf_contract-specif.price-cli / p-base-rate * p-base-scale
     5364                   p-new-calc-method = 'Спецификация':U
     5365                 .
     5366                 if v-bonus <> ? and v-bonus <> 0 then do:
     5367                    assign
     5368                    cost-rubl = cost-rubl + ( cost-rubl * v-bonus / 100 )
     5369                    cost-base = cost-base + ( cost-base * v-bonus / 100 )
     5370                    .
     5371                 end.
     5372               end.
     5373             end.
     5374         end.
     5375      end.
     5376      otherwise do:
     5377        message  "Не просчитывается метод p-calc-method = " p-calc-method  skip
     5378                  p-new-calc-method  skip
     5379                 "p-price-prev-doc " p-price-prev-doc  skip
     5380                 "mpl-lib ERR !!! " skip
     5381                 'артикул ' p-artic skip
     5382                 view-as alert-box information .
     5383      end.
     5384    end case.
     5385   run main-road-taxs in this-procedure
     5386     ( input p-artic     ,
     5387       input p-prod-type ,
     5388       input p-prod-code ,
     5389       input-output cur-rt-base ,
     5390       input-output cur-rt-rubl )
     5391       .
     5392     if p-exch-scale = 0  or  p-exch-scale = ?  then do:
     5393       return error "Не определен курс валюты документа" .
     5394     end.
     5395     if p-base-scale = 0  or  p-base-scale = ?  then do:
     5396        return error "Не определен курс базовой валюты " .
     5397     end.
     5398   if v-base = false then var-pr-r-b = "rubl":U .
     5399                     else var-pr-r-b =  "base":U .
     5400       if var-pr-r-b = "rubl":U then do:
     5401            case p-calc-method :
     5402            when 'ПорогПр-НДС':U then do:
     5403               p-price-sale-rubl  =  cost-rubl + (cost-rubl * p-vat-pc / 100)  .
     5404            end.
     5405            when 'ПорогПр+НДС':U then do:
     5406               p-price-sale-rubl  =  cost-rubl .
     5407            end.
     5408            when  'Производит':U then do:
     5409               p-price-sale-rubl  =  cost-rubl * (1 + p-increase-pc / 100)  .
     5410            end.
     5411            when  'Произв-НДС':U then do:
     5412               p-price-sale-rubl  =  cost-rubl * (1 + p-increase-pc / 100) * (1 + p-vat-pc / 100)   .
     5413            end.
     5414            otherwise do:
     5415               p-price-sale-rubl  =  cost-rubl * (1 + p-increase-pc / 100) .
     5416            end.
     5417           end case.
     5418           assign
     5419             p-price-calc-rubl  =  cost-rubl
     5420             p-road-tax-rubl    =  cur-rt-rubl
     5421             p-price-calc-doc   =  p-price-calc-rubl / p-exch-rate * p-exch-scale
     5422             p-price-sale-doc   =  p-price-sale-rubl / p-exch-rate * p-exch-scale
     5423             p-road-tax-doc     =  p-road-tax-rubl   / p-exch-rate * p-exch-scale
     5424           .
     5425       end.
     5426       else do:
     5427            case p-calc-method:
     5428               when 'ПорогПр-НДС':U then do:
     5429                   p-price-sale-base  =  cost-base + (cost-base * p-vat-pc / 100)  .
     5430               end.
     5431               when 'ПорогПр+НДС':U then do:
     5432                   p-price-sale-base  =  cost-base .
     5433               end.
     5434               when 'Производит':U then do:
     5435                   p-price-sale-base  =  cost-base * (1 + p-increase-pc / 100)  .
     5436               end.
     5437               when 'Произв-НДС':U then do:
     5438                   p-price-sale-base  =  cost-base * (1 + p-increase-pc / 100) * (1 + p-vat-pc / 100)  .
     5439               end.
     5440               otherwise do:
     5441                   p-price-sale-base  =  cost-base * (1 + p-increase-pc / 100) .
     5442               end.
     5443            end case.
     5444           assign
     5445             p-price-calc-base  =  cost-base
     5446             p-road-tax-base    =  cur-rt-base
     5447             p-price-calc-rubl  =  p-price-calc-base * p-base-rate / p-base-scale
     5448             p-price-sale-rubl  =  p-price-sale-base * p-base-rate / p-base-scale
     5449             p-road-tax-rubl    =  p-road-tax-base   * p-base-rate / p-base-scale
     5450             p-price-calc-doc   =  p-price-calc-rubl / p-exch-rate * p-exch-scale
     5451             p-price-sale-doc   =  p-price-sale-rubl / p-exch-rate * p-exch-scale
     5452             p-road-tax-doc     =  p-road-tax-rubl   / p-exch-rate * p-exch-scale
     5453           .
     5454       end.
     5455      if p-price-sale-doc <> 0 then do:
     5456   case p-round-method :
     5457     when '9-окончание':U then do:
     5458       if p-price-sale-doc < 29 then do:
     5459         if (p-price-sale-doc - truncate (p-price-sale-doc, 0)) <> 0 then do:
     5460           assign
     5461             p-price-sale-doc = truncate (p-price-sale-doc, 0) + 1
     5462           .
     5463         end.
     5464       end.
     5465       else do:
     5466         if (p-price-sale-doc modulo 10) < 3 then do:
     5467           assign
     5468             p-price-sale-doc = (p-price-sale-doc - (p-price-sale-doc modulo 100))
     5469                 + ( truncate (((p-price-sale-doc modulo 100) / 10), 0)
     5470                   - 1 ) * 10
     5471                 + 9
     5472           .
     5473         end.
     5474         else do:
     5475           assign
     5476             p-price-sale-doc = (p-price-sale-doc - (p-price-sale-doc modulo 100))
     5477                 + ( truncate (((p-price-sale-doc modulo 100) / 10), 0)
     5478                   ) * 10
     5479                 + 9
     5480           .
     5481         end.
     5482         assign
     5483           p-price-sale-doc = round (p-price-sale-doc, 0)
     5484         .
     5485       end.
     5486     end.
     5487     when '9-99окончание':U then do:
     5488       if p-price-sale-doc < p-round-base then do:
     5489         assign
     5490           p-price-sale-doc = truncate (p-price-sale-doc, 0) + 0.99
     5491         .
     5492       end.
     5493       else do:
     5494         assign
     5495           p-price-sale-doc = truncate (p-price-sale-doc / 10 , 0) * 10 + 9.99
     5496         .
     5497       end.
     5498     end.
     5499     when 'Без-дробных':U then do:
     5500       assign
     5501         p-price-sale-doc = round (p-price-sale-doc, 0)
     5502       .
     5503     end.
     5504     when 'Произвольно':U then do:
     5505       if p-round-base <> 0 then do:
     5506         assign
     5507           p-price-sale-doc = round (p-price-sale-doc / p-round-base, 0) * p-round-base
     5508         .
     5509         if p-price-sale-doc = 0 then do:
     5510           assign
     5511             p-price-sale-doc = p-round-base
     5512           .
     5513         end.
     5514       end.
     5515     end.
     5516     when 'Вверх':U then do:
     5517       if p-round-base <> 0 then do:
     5518         if truncate ( p-price-sale-doc / p-round-base, 0 ) <> (p-price-sale-doc / p-round-base) then do:
     5519           assign
     5520             p-price-sale-doc = truncate (p-price-sale-doc / p-round-base, 0) * p-round-base + p-round-base
     5521           .
     5522         end.
     5523       end.
     5524       if p-price-sale-doc = 0 then do:
     5525         assign
     5526           p-price-sale-doc = p-round-base
     5527         .
     5528       end.
     5529     end.
     5530     when 'Коэффициент':U then do:
     5531       if p-round-base <> 0 then do:
     5532         assign
     5533           p-price-sale-doc = p-price-sale-doc * p-round-base
     5534         .
     5535       end.
     5536     end.
     5537     when 'Отключено':U then do:
     5538     end.
     5539     otherwise do:
     5540       message
     5541         vss-workfile vss-revision vss-description skip
     5542         "Неизвестный метод округления продажной цены" skip
     5543         "round-method" p-round-method skip
     5544         "round-base"   p-round-base   skip
     5545         "price"        p-price-sale-doc             skip
     5546         view-as alert-box error .
     5547     end.
     5548   end.
     5549     end.
     5550     assign
     5551       p-price-calc-rubl = p-price-calc-doc * p-exch-rate / p-exch-scale
     5552       p-price-sale-rubl = p-price-sale-doc * p-exch-rate / p-exch-scale
     5553       p-road-tax-rubl   = p-road-tax-doc   * p-exch-rate / p-exch-scale
     5554       p-price-prev-rubl = p-price-prev-doc * p-exch-rate / p-exch-scale
     5555      .
     5556     assign
     5557       p-price-calc-base = p-price-calc-rubl / p-base-rate * p-base-scale
     5558       p-price-sale-base = p-price-sale-rubl / p-base-rate * p-base-scale
     5559       p-road-tax-base   = p-road-tax-rubl   / p-base-rate * p-base-scale
     5560       p-price-prev-base = p-price-prev-rubl / p-base-rate * p-base-scale
     5561     .
     5562     define buffer bufold_price-doc-forming for ub.price-doc-forming  .
     5563     find first bufold_price-doc-forming where  recid(bufold_price-doc-forming) = v1-recid no-lock no-error .
     5564     p-prev-doc-code = if available bufold_price-doc-forming
     5565                          then (string(bufold_price-doc-forming.pdf-id) + " БД" + string(bufold_price-doc-forming.pdf-db))
     5566                          else "" .
     5567   END PROCEDURE.
     5568   PROCEDURE create-line :
     5569   define input  parameter p-plt-db-num        like ub.price-doc-forming-gds.plt-db-num  no-undo .
     5570   define input  parameter p-plt-id            like ub.price-doc-forming-gds.plt-id      no-undo .
     5571   define input  parameter p-pdf-db            like ub.price-doc-forming-gds.pdf-db      no-undo .
     5572   define input  parameter p-pdf-id            like ub.price-doc-forming-gds.pdf-id  no-undo .
     5573   define input  parameter p-line-num          like ub.price-doc-forming-gds.line-num no-undo .
     5574   define input  parameter p-b-code            like ub.price-doc-forming-gds.b-code   no-undo .
     5575   define input  parameter p-artic             like ub.price-doc-forming-gds.artic    no-undo .
     5576   define input  parameter p-prod-type         like ub.price-doc-forming-gds.prod-type no-undo .
     5577   define input  parameter p-prod-code         like ub.price-doc-forming-gds.prod-code no-undo .
     5578   define input  parameter p-calc-method       like ub.price-doc-forming-gds.calc-method  no-undo .
     5579   define input  parameter p-d-pcnt            like ub.price-doc-forming-gds.d-pcnt       no-undo .
     5580   define input  parameter p-have-start-period like ub.price-doc-forming-gds.have-start-period no-undo .
     5581   define input  parameter p-start-date        like ub.price-doc-forming-gds.start-date        no-undo .
     5582   define input  parameter p-start-shift-date  like ub.price-doc-forming-gds.start-shift-date  no-undo .
     5583   define input  parameter p-start-shift-name  like ub.price-doc-forming-gds.start-shift-name  no-undo .
     5584   define input  parameter p-start-shift-num   like ub.price-doc-forming-gds.start-shift-num   no-undo .
     5585   define input  parameter p-start-sys-date    like ub.price-doc-forming-gds.start-sys-date    no-undo .
     5586   define input  parameter p-start-sys-time    like ub.price-doc-forming-gds.start-sys-time    no-undo .
     5587   define input  parameter p-have-end-period   like ub.price-doc-forming-gds.have-end-period   no-undo .
     5588   define input  parameter p-end-date          like ub.price-doc-forming-gds.end-date          no-undo .
     5589   define input  parameter p-end-shift-date    like ub.price-doc-forming-gds.end-shift-date    no-undo .
     5590   define input  parameter p-end-shift-name    like ub.price-doc-forming-gds.end-shift-name    no-undo .
     5591   define input  parameter p-end-shift-num     like ub.price-doc-forming-gds.end-shift-num     no-undo .
     5592   define input  parameter p-end-sys-date      like ub.price-doc-forming-gds.end-sys-date      no-undo .
     5593   define input  parameter p-end-sys-time      like ub.price-doc-forming-gds.end-sys-time      no-undo .
     5594   define input  parameter p-price-calc-base   like ub.price-doc-forming-gds.price-calc-base   no-undo .
     5595   define input  parameter p-price-calc-doc    like ub.price-doc-forming-gds.price-calc-doc    no-undo .
     5596   define input  parameter p-price-calc-rubl   like ub.price-doc-forming-gds.price-calc-rubl   no-undo .
     5597   define input  parameter p-price-prev-base   like ub.price-doc-forming-gds.price-prev-base   no-undo .
     5598   define input  parameter p-price-prev-doc    like ub.price-doc-forming-gds.price-prev-doc    no-undo .
     5599   define input  parameter p-price-prev-rubl   like ub.price-doc-forming-gds.price-prev-rubl   no-undo .
     5600   define input  parameter p-price-sale-base   like ub.price-doc-forming-gds.price-sale-base   no-undo .
     5601   define input  parameter p-price-sale-doc    like ub.price-doc-forming-gds.price-sale-doc    no-undo .
     5602   define input  parameter p-price-sale-rubl   like ub.price-doc-forming-gds.price-sale-rubl   no-undo .
     5603   define input  parameter p-road-tax-base     like ub.price-doc-forming-gds.road-tax-base     no-undo .
     5604   define input  parameter p-road-tax-doc      like ub.price-doc-forming-gds.road-tax-doc      no-undo .
     5605   define input  parameter p-road-tax-rubl     like ub.price-doc-forming-gds.road-tax-rubl     no-undo .
     5606   define input  parameter p-excise-base       like ub.price-doc-forming-gds.excise-base       no-undo .
     5607   define input  parameter p-excise-doc        like ub.price-doc-forming-gds.excise-doc        no-undo .
     5608   define input  parameter p-excise-rubl       like ub.price-doc-forming-gds.excise-rubl       no-undo .
     5609   define input  parameter p-vat-pc            like ub.price-doc-forming-gds.vat-pc            no-undo .
     5610   define input  parameter p-slt-pc            like ub.price-doc-forming-gds.slt-pc            no-undo .
     5611   define input  parameter p-prev-doc-code     as character no-undo .
     5612   define input  parameter p-stts              like ub.price-doc-forming-gds.stts              no-undo .
     5613   define input-output parameter  v-sec        as integer   no-undo .
     5614     run check-use-bar-code ( p-b-code ) no-error .
     5615     if error-status :error then do:
     5616       message
     5617         return-value skip
     5618         "Ошибка !"
     5619         view-as alert-box error
     5620       .
     5621       undo, return error return-value.
     5622     end.
     5623   find first ub.price-doc-forming-gds exclusive-lock where
     5624              ub.price-doc-forming-gds.plt-db-num  =  p-plt-db-num and
     5625              ub.price-doc-forming-gds.plt-id      =  p-plt-id     and
     5626              ub.price-doc-forming-gds.pdf-db      =  p-pdf-db     and
     5627              ub.price-doc-forming-gds.pdf-id      =  p-pdf-id     and
     5628              ub.price-doc-forming-gds.b-code      =  p-b-code     no-error .
     5629       if not available ub.price-doc-forming-gds then
     5630       do:
     5631         create ub.price-doc-forming-gds .
     5632          assign
     5633           ub.price-doc-forming-gds.plt-db-num = p-plt-db-num
     5634           ub.price-doc-forming-gds.plt-id     = p-plt-id
     5635           ub.price-doc-forming-gds.pdf-db     = p-pdf-db
     5636           ub.price-doc-forming-gds.pdf-id     = p-pdf-id
     5637           ub.price-doc-forming-gds.b-code     = p-b-code
     5638           ub.price-doc-forming-gds.line-num   = p-line-num
     5639          .
     5640       end.
     5641     assign
     5642       ub.price-doc-forming-gds.artic            = p-artic
     5643       ub.price-doc-forming-gds.prod-type        = p-prod-type
     5644       ub.price-doc-forming-gds.prod-code        = p-prod-code
     5645       ub.price-doc-forming-gds.calc-method      = p-calc-method
     5646       ub.price-doc-forming-gds.d-pcnt            = p-d-pcnt
     5647       ub.price-doc-forming-gds.have-start-period = p-have-start-period
     5648       ub.price-doc-forming-gds.start-date       = p-start-date
     5649       ub.price-doc-forming-gds.start-shift-date = p-start-shift-date
     5650       ub.price-doc-forming-gds.start-shift-name = p-start-shift-name
     5651       ub.price-doc-forming-gds.start-shift-num  = p-start-shift-num
     5652       ub.price-doc-forming-gds.start-sys-date   = p-start-sys-date
     5653       ub.price-doc-forming-gds.start-sys-time   = p-start-sys-time
     5654       ub.price-doc-forming-gds.have-end-period  = p-have-end-period
     5655       ub.price-doc-forming-gds.end-date         = p-end-date
     5656       ub.price-doc-forming-gds.end-shift-date   = p-end-shift-date
     5657       ub.price-doc-forming-gds.end-shift-name   = p-end-shift-name
     5658       ub.price-doc-forming-gds.end-shift-num    = p-end-shift-num
     5659       ub.price-doc-forming-gds.end-sys-date     = p-end-sys-date
     5660       ub.price-doc-forming-gds.end-sys-time     = p-end-sys-time
     5661       ub.price-doc-forming-gds.price-calc-base  = p-price-calc-base
     5662       ub.price-doc-forming-gds.price-calc-doc   = p-price-calc-doc
     5663       ub.price-doc-forming-gds.price-calc-rubl  = p-price-calc-rubl
     5664       ub.price-doc-forming-gds.price-prev-base  = p-price-prev-base
     5665       ub.price-doc-forming-gds.price-prev-doc   = p-price-prev-doc
     5666       ub.price-doc-forming-gds.price-prev-rubl  = p-price-prev-rubl
     5667       ub.price-doc-forming-gds.road-tax-base    = p-road-tax-base
     5668       ub.price-doc-forming-gds.road-tax-doc     = p-road-tax-doc
     5669       ub.price-doc-forming-gds.road-tax-rubl    = p-road-tax-rubl
     5670       ub.price-doc-forming-gds.excise-base      = p-excise-base
     5671       ub.price-doc-forming-gds.excise-doc       = p-excise-doc
     5672       ub.price-doc-forming-gds.excise-rubl      = p-excise-rubl
     5673       ub.price-doc-forming-gds.vat-pc           = p-vat-pc
     5674       ub.price-doc-forming-gds.slt-pc           = p-slt-pc
     5675       ub.price-doc-forming-gds.prev-doc-code    = p-prev-doc-code
     5676       ub.price-doc-forming-gds.stts             = p-stts
     5677       ub.price-doc-forming-gds.price-sale-base  = p-price-sale-base
     5678       ub.price-doc-forming-gds.price-sale-doc   = p-price-sale-doc
     5679       ub.price-doc-forming-gds.price-sale-rubl  = p-price-sale-rubl
     5680       .
     5681     run ref/h-pdfgds.p
     5682       ( buffer ub.price-doc-forming-gds ,
     5683         input p-price-sale-doc ,
     5684         input-output v-sec
     5685         ) .
     5686   END PROCEDURE.
     5687   PROCEDURE last-num :
     5688   define input  parameter p-recid as recid no-undo .
     5689   define output parameter p-last-id as integer   no-undo .
     5690   define buffer buf2_price-doc-forming     for ub.price-doc-forming  .
     5691   define buffer buf2_price-doc-forming-gds for ub.price-doc-forming-gds  .
     5692   find first buf2_price-doc-forming no-lock where recid(buf2_price-doc-forming) = p-recid no-error .
     5693         if error-status :error then do:
     5694           p-last-id = ? .
     5695           return .
     5696         end.
     5697       for each buf2_price-doc-forming-gds no-lock  where
     5698               buf2_price-doc-forming-gds.plt-id     = buf2_price-doc-forming.plt-id     and
     5699               buf2_price-doc-forming-gds.plt-db-num = buf2_price-doc-forming.plt-db-num and
     5700               buf2_price-doc-forming-gds.pdf-id     = buf2_price-doc-forming.pdf-id     and
     5701               buf2_price-doc-forming-gds.pdf-db     = buf2_price-doc-forming.pdf-db
     5702               by buf2_price-doc-forming-gds.line-num
     5703               :
     5704               p-last-id = buf2_price-doc-forming-gds.line-num .
     5705       end.
     5706   END PROCEDURE.
     5707   PROCEDURE calc-price-alt :
     5708   define input parameter bc         like ub.bar-code.b-code   no-undo.
     5709   define input parameter p-recid as recid no-undo .
     5710   define input parameter d-pcnt as decimal   no-undo .
     5711   define input parameter r-method   as character no-undo .
     5712   define input parameter r-base     as decimal   no-undo .
     5713   define output parameter pa-price-sale-base  as decimal   no-undo .
     5714   define output parameter pa-price-sale-doc   as decimal   no-undo .
     5715   define output parameter pa-price-sale-rubl  as decimal   no-undo .
     5716   pr-alt:
     5717   do on error undo pr-alt, return error:
     5718     if r-method = ? or
     5719        r-base = ? then do:
     5720       message
     5721         "Не задан способ округления для расчета зависящих от нее неосновных цен." skip
     5722         "Код:" bc skip
     5723         view-as alert-box error.
     5724       undo pr-alt, return error.
     5725     end.
     5726   define buffer buf_bar-code for ub.bar-code  .
     5727   define buffer buf_main_bar-code for ub.bar-code  .
     5728   define buffer buf_main_price-doc-forming for ub.price-doc-forming  .
     5729   define buffer buf_main_price-doc-forming-gds for ub.price-doc-forming-gds  .
     5730   find first buf_main_price-doc-forming no-lock where recid(buf_main_price-doc-forming) = p-recid  no-error .
     5731   if error-status :error then
     5732   message
     5733     vss-workfile vss-revision vss-description skip
     5734     error-status :get-message(1) skip
     5735     return-value skip
     5736     "Ошибка "
     5737     view-as alert-box error
     5738   .
     5739   find first buf_bar-code no-lock where
     5740              buf_bar-code.b-code = bc no-error .
     5741   if error-status :error then
     5742   message
     5743     vss-workfile vss-revision vss-description skip
     5744     error-status :get-message(1) skip
     5745     return-value skip
     5746     "3"
     5747     view-as alert-box error
     5748   .
     5749         assign
     5750           pa-price-sale-doc = fnc-base-price-doc ( input bc , input p-recid ) *
     5751                               buf_bar-code.cli-base-rate *
     5752                               (1 - d-pcnt / 100)
     5753                                 .
     5754     if pa-price-sale-doc <> 0 then do:
     5755   case r-method :
     5756     when '9-окончание':U then do:
     5757       if pa-price-sale-doc < 29 then do:
     5758         if (pa-price-sale-doc - truncate (pa-price-sale-doc, 0)) <> 0 then do:
     5759           assign
     5760             pa-price-sale-doc = truncate (pa-price-sale-doc, 0) + 1
     5761           .
     5762         end.
     5763       end.
     5764       else do:
     5765         if (pa-price-sale-doc modulo 10) < 3 then do:
     5766           assign
     5767             pa-price-sale-doc = (pa-price-sale-doc - (pa-price-sale-doc modulo 100))
     5768                 + ( truncate (((pa-price-sale-doc modulo 100) / 10), 0)
     5769                   - 1 ) * 10
     5770                 + 9
     5771           .
     5772         end.
     5773         else do:
     5774           assign
     5775             pa-price-sale-doc = (pa-price-sale-doc - (pa-price-sale-doc modulo 100))
     5776                 + ( truncate (((pa-price-sale-doc modulo 100) / 10), 0)
     5777                   ) * 10
     5778                 + 9
     5779           .
     5780         end.
     5781         assign
     5782           pa-price-sale-doc = round (pa-price-sale-doc, 0)
     5783         .
     5784       end.
     5785     end.
     5786     when '9-99окончание':U then do:
     5787       if pa-price-sale-doc < r-base then do:
     5788         assign
     5789           pa-price-sale-doc = truncate (pa-price-sale-doc, 0) + 0.99
     5790         .
     5791       end.
     5792       else do:
     5793         assign
     5794           pa-price-sale-doc = truncate (pa-price-sale-doc / 10 , 0) * 10 + 9.99
     5795         .
     5796       end.
     5797     end.
     5798     when 'Без-дробных':U then do:
     5799       assign
     5800         pa-price-sale-doc = round (pa-price-sale-doc, 0)
     5801       .
     5802     end.
     5803     when 'Произвольно':U then do:
     5804       if r-base <> 0 then do:
     5805         assign
     5806           pa-price-sale-doc = round (pa-price-sale-doc / r-base, 0) * r-base
     5807         .
     5808         if pa-price-sale-doc = 0 then do:
     5809           assign
     5810             pa-price-sale-doc = r-base
     5811           .
     5812         end.
     5813       end.
     5814     end.
     5815     when 'Вверх':U then do:
     5816       if r-base <> 0 then do:
     5817         if truncate ( pa-price-sale-doc / r-base, 0 ) <> (pa-price-sale-doc / r-base) then do:
     5818           assign
     5819             pa-price-sale-doc = truncate (pa-price-sale-doc / r-base, 0) * r-base + r-base
     5820           .
     5821         end.
     5822       end.
     5823       if pa-price-sale-doc = 0 then do:
     5824         assign
     5825           pa-price-sale-doc = r-base
     5826         .
     5827       end.
     5828     end.
     5829     when 'Коэффициент':U then do:
     5830       if r-base <> 0 then do:
     5831         assign
     5832           pa-price-sale-doc = pa-price-sale-doc * r-base
     5833         .
     5834       end.
     5835     end.
     5836     when 'Отключено':U then do:
     5837     end.
     5838     otherwise do:
     5839       message
     5840         vss-workfile vss-revision vss-description skip
     5841         "Неизвестный метод округления продажной цены" skip
     5842         "round-method" r-method skip
     5843         "round-base"   r-base   skip
     5844         "price"        pa-price-sale-doc             skip
     5845         view-as alert-box error .
     5846     end.
     5847   end.
     5848     end.
     5849     pa-price-sale-rubl = pa-price-sale-doc * buf_main_price-doc-forming.exch-rate / buf_main_price-doc-forming.exch-scale .
     5850     pa-price-sale-base = pa-price-sale-rubl / buf_main_price-doc-forming.base-rate * buf_main_price-doc-forming.base-scale .
     5851   end.
     5852   END PROCEDURE.
     5853   procedure calc-price-discnt :
     5854     do
     5855     on error undo, return error return-value
     5856     :
     5857   define input parameter p-recid as recid no-undo .
     5858   define input parameter bc    like ub.bar-code.b-code   no-undo.
     5859   define buffer buf-price-doc-forming             for ub.price-doc-forming.
     5860   define buffer buf-price-doc-forming-gds for ub.price-doc-forming-gds.
     5861   define buffer buf-bar-code                      for ub.bar-code.
     5862   define buffer buf-goods                         for ub.goods.
     5863   define buffer old-price-doc-forming-gds         for ub.price-doc-forming-gds.
     5864   define variable pr-rec   as   recid                     no-undo.
     5865   define variable pr-c-b-r like ub.bar-code.cli-base-rate no-undo.
     5866   pr-discnt:
     5867   do on error undo pr-discnt, return error:
     5868     find  buf-price-doc-forming no-lock where
     5869           recid(buf-price-doc-forming) = p-recid .
     5870     find  buf-bar-code no-lock where
     5871           buf-bar-code.b-code = bc.
     5872     find  buf-goods no-lock where
     5873           buf-goods.gds-code = buf-bar-code.gds-code.
     5874     find  buf-price-doc-forming-gds exclusive-lock where
     5875           buf-price-doc-forming-gds.pdf-id = buf-price-doc-forming.pdf-id and
     5876           buf-price-doc-forming-gds.plt-id = buf-price-doc-forming.plt-id and
     5877           buf-price-doc-forming-gds.pdf-db     = buf-price-doc-forming.pdf-db and
     5878           buf-price-doc-forming-gds.plt-db-num = buf-price-doc-forming.plt-db-num and
     5879           buf-price-doc-forming-gds.b-code  = bc.
     5880      if available buf-price-doc-forming-gds then do:
     5881         buf-price-doc-forming-gds.d-pcnt =
     5882         (1 - buf-price-doc-forming-gds.price-sale-doc /
     5883               fnc-base-price-doc ( buf-bar-code.b-code, p-recid ) /
     5884               buf-bar-code.cli-base-rate) * 100 .
     5885      end.
     5886   end.
     5887     end.
     5888   end procedure.
     5889   procedure calc-price-sub :
     5890   define  input  parameter bc           like ub.price-doc-forming-gds.b-code no-undo.
     5891   define  input  parameter p-recid      as recid no-undo .
     5892   define  input  parameter calc-method  as character         no-undo.
     5893   define  input  parameter increase-pc  as decimal           no-undo.
     5894   define  input  parameter round-method as character         no-undo.
     5895   define  input  parameter round-base   as decimal           no-undo.
     5896   define  input  parameter doc-code     as character no-undo .
     5897   define  input  parameter common-price as decimal   no-undo .
     5898   define  input  parameter copy-type    as character no-undo .
     5899   define  input  parameter copy-code    as integer   no-undo .
     5900   define  output parameter calc-rec     as recid             no-undo.
     5901   define  buffer buf-price-doc-forming-gds for ub.price-doc-forming-gds.
     5902   define  buffer buf-bar-code              for ub.bar-code.
     5903   define  buffer buf-goods                 for ub.goods.
     5904   define  buffer buf-gds-prt               for ub.gds-prt.
     5905   define  buffer buf-gds-grp               for ub.gds-grp.
     5906   define  buffer buf-price-doc-forming     for ub.price-doc-forming.
     5907   calc-sub:
     5908   do on error undo calc-sub, return error:
     5909     find  buf-price-doc-forming no-lock where
     5910           recid (buf-price-doc-forming) =  p-recid .
     5911     find  buf-bar-code no-lock where
     5912           buf-bar-code.b-code = bc.
     5913     find  buf-goods no-lock where
     5914           buf-goods.gds-code = buf-bar-code.gds-code.
     5915     find  buf-gds-prt no-lock where
     5916           buf-gds-prt.node-code = buf-bar-code.node-code.
     5917     find  buf-price-doc-forming-gds where
     5918           buf-price-doc-forming-gds.pdf-id    = buf-price-doc-forming.pdf-id and
     5919           buf-price-doc-forming-gds.plt-id    = buf-price-doc-forming.plt-id and
     5920           buf-price-doc-forming-gds.pdf-db    = buf-price-doc-forming.pdf-db and
     5921           buf-price-doc-forming-gds.plt-db-num  = buf-price-doc-forming.plt-db-num and
     5922           buf-price-doc-forming-gds.b-code      = bc no-error .
     5923     calc-rec = recid (buf-price-doc-forming-gds).
     5924     if buf-gds-prt.upper-code = buf-goods.prt-root and  buf-goods.unit-base = buf-bar-code.unit-cli  then do:
     5925       for each  buf-price-doc-forming-gds exclusive-lock where
     5926                 buf-price-doc-forming-gds.pdf-id    = buf-price-doc-forming.pdf-id and
     5927                 buf-price-doc-forming-gds.plt-id    = buf-price-doc-forming.plt-id and
     5928                 buf-price-doc-forming-gds.pdf-db    = buf-price-doc-forming.pdf-db and
     5929                 buf-price-doc-forming-gds.plt-db-num    = buf-price-doc-forming.plt-db-num and
     5930                 buf-price-doc-forming-gds.artic      = buf-goods.artic and
     5931                 buf-price-doc-forming-gds.prod-type  = buf-goods.prod-type and
     5932                 buf-price-doc-forming-gds.prod-code  = buf-goods.prod-code,
     5933           first buf-bar-code no-lock where
     5934                 buf-bar-code.b-code   = buf-price-doc-forming-gds.b-code and
     5935                 buf-bar-code.unit-cli = buf-goods.unit-base ,
     5936           first buf-gds-prt no-lock where
     5937                 buf-gds-prt.node-code = buf-bar-code.node-code and
     5938                 buf-gds-prt.upper-code <> buf-goods.prt-root
     5939           on error undo calc-sub, return error:
     5940             run calc-price-line  in this-procedure
     5941               ( input  calc-method
     5942               , input  increase-pc
     5943               , input  round-method
     5944               , input  round-base
     5945               , input  buf-bar-code.b-code
     5946               , input  buf-goods.gds-code
     5947               , input  buf-goods.artic
     5948               , input  buf-goods.prod-type
     5949               , input  buf-goods.prod-code
     5950               , input  buf-price-doc-forming.base-rate
     5951               , input  buf-price-doc-forming.base-scale
     5952               , input  buf-price-doc-forming.exch-scale
     5953               , input  buf-price-doc-forming.exch-rate
     5954               , input  doc-code
     5955               , input  common-price
     5956               , input  copy-type
     5957               , input  copy-code
     5958               , output buf-price-doc-forming-gds.calc-method
     5959               , output buf-price-doc-forming-gds.price-calc-base
     5960               , output buf-price-doc-forming-gds.price-calc-doc
     5961               , output buf-price-doc-forming-gds.price-calc-rubl
     5962               , output buf-price-doc-forming-gds.price-prev-base
     5963               , output buf-price-doc-forming-gds.price-prev-doc
     5964               , output buf-price-doc-forming-gds.price-prev-rubl
     5965               , output buf-price-doc-forming-gds.price-sale-base
     5966               , output buf-price-doc-forming-gds.price-sale-doc
     5967               , output buf-price-doc-forming-gds.price-sale-rubl
     5968               , output buf-price-doc-forming-gds.road-tax-base
     5969               , output buf-price-doc-forming-gds.road-tax-doc
     5970               , output buf-price-doc-forming-gds.road-tax-rubl
     5971               , output buf-price-doc-forming-gds.excise-base
     5972               , output buf-price-doc-forming-gds.excise-doc
     5973               , output buf-price-doc-forming-gds.excise-rubl
     5974               , output buf-price-doc-forming-gds.vat-pc
     5975               , output buf-price-doc-forming-gds.slt-pc
     5976               , output buf-price-doc-forming-gds.prev-doc-code
     5977               , output buf-price-doc-forming-gds.d-pcnt
     5978               ) no-error .
     5979             if error-status :error then do :
     5980               message
     5981                 vss-workfile vss-revision vss-description skip
     5982                 error-status :get-message(1) skip
     5983                 return-value skip
     5984                 "calc-price-line"
     5985                 view-as alert-box error
     5986               .
     5987               undo calc-sub, return error.
     5988               end.
     5989         calc-rec = recid (buf-price-doc-forming-gds).
     5990       end.
     5991       for each  buf-price-doc-forming-gds exclusive-lock where
     5992                 buf-price-doc-forming-gds.pdf-id    = buf-price-doc-forming.pdf-id and
     5993                 buf-price-doc-forming-gds.plt-id    = buf-price-doc-forming.plt-id and
     5994                 buf-price-doc-forming-gds.pdf-db    = buf-price-doc-forming.pdf-db and
     5995                 buf-price-doc-forming-gds.plt-db-num    = buf-price-doc-forming.plt-db-num and
     5996                 buf-price-doc-forming-gds.artic      = buf-goods.artic and
     5997                 buf-price-doc-forming-gds.prod-type  = buf-goods.prod-type and
     5998                 buf-price-doc-forming-gds.prod-code  = buf-goods.prod-code,
     5999           first buf-bar-code no-lock where
     6000                 buf-bar-code.b-code    = buf-price-doc-forming-gds.b-code and
     6001                 buf-bar-code.unit-cli <> buf-goods.unit-base ,
     6002           first buf-gds-prt no-lock where
     6003                 buf-gds-prt.node-code = buf-bar-code.node-code
     6004           on error undo calc-sub, return error:
     6005       end.
     6006     end.
     6007     else do:
     6008     end.
     6009   end.
     6010   end procedure.
     6011   procedure calc-base-update :
     6012   define input parameter bc           like ub.bar-code.b-code   no-undo.
     6013   define input parameter p-recid      as recid no-undo .
     6014   define input parameter round-method as character    no-undo.
     6015   define input parameter round-base   as decimal      no-undo.
     6016   define buffer alt-bar-code              for ub.bar-code.
     6017   define buffer alt-price-doc-forming-gds for ub.price-doc-forming-gds.
     6018   define buffer buf-bar-code              for ub.bar-code.
     6019   define buffer buf-goods                 for ub.goods.
     6020   define buffer buf-price-doc-forming     for ub.price-doc-forming  .
     6021   calc-base:
     6022   do on error undo calc-base, return error :
     6023     find  buf-price-doc-forming no-lock where
     6024           recid (buf-price-doc-forming) =  p-recid .
     6025     find  buf-bar-code no-lock where
     6026           buf-bar-code.b-code = bc.
     6027     find  buf-goods no-lock where
     6028           buf-goods.gds-code = buf-bar-code.gds-code.
     6029     for each  alt-bar-code no-lock where
     6030               alt-bar-code.gds-code  = buf-bar-code.gds-code and
     6031               alt-bar-code.node-code = buf-bar-code.node-code and
     6032               alt-bar-code.part-code = buf-bar-code.part-code and
     6033               alt-bar-code.in-code   = buf-bar-code.in-code and
     6034               alt-bar-code.unit-cli <> buf-goods.unit-base,
     6035         each  alt-price-doc-forming-gds exclusive-lock where
     6036               alt-price-doc-forming-gds.pdf-id      = buf-price-doc-forming.pdf-id and
     6037               alt-price-doc-forming-gds.plt-id      = buf-price-doc-forming.plt-id and
     6038               alt-price-doc-forming-gds.pdf-db      = buf-price-doc-forming.pdf-db and
     6039               alt-price-doc-forming-gds.plt-db-num  = buf-price-doc-forming.plt-db-num and
     6040               alt-price-doc-forming-gds.b-code      = alt-bar-code.b-code
     6041         on error undo calc-base, return error:
     6042     run calc-price-alt in this-procedure
     6043         ( input  alt-price-doc-forming-gds.b-code
     6044         , input  p-recid
     6045         , input  alt-price-doc-forming-gds.d-pcnt
     6046         , input  round-method
     6047         , input  round-base
     6048         , output alt-price-doc-forming-gds.price-sale-base
     6049         , output alt-price-doc-forming-gds.price-sale-doc
     6050         , output alt-price-doc-forming-gds.price-sale-rubl
     6051         ) no-error .
     6052       if error-status:error then do:
     6053       message
     6054         vss-workfile vss-revision vss-description skip
     6055         error-status :get-message(1) skip
     6056         return-value skip
     6057         "calc-price-alt"
     6058         view-as alert-box error
     6059       .
     6060         undo calc-base, return error.
     6061       end.
     6062     end.
     6063   end.
     6064   end procedure.
     6065   define temp-table temp-exp-partbc no-undo
     6066   field b-code  as integer
     6067   index pi b-code
     6068   .
     6069   procedure expose-prt :
     6070   define input  parameter p-calc-method  as character no-undo .
     6071   define input  parameter p-increase-pc as decimal   no-undo .
     6072   define input  parameter p-main-code    like ub.goods.gds-code    no-undo.
     6073   define input  parameter old-recid      as recid no-undo .
     6074   define input  parameter new-recid      as recid no-undo .
     6075   define input  parameter p-round-method as character no-undo .
     6076   define input  parameter p-round-base   as decimal   no-undo .
     6077   define input  parameter v-doc-code     as character no-undo .
     6078   define input  parameter v-common-price as decimal   no-undo .
     6079   define input  parameter v-copy-type    as character no-undo .
     6080   define input  parameter v-copy-code    as integer   no-undo .
     6081   define input-output parameter v-line-num as integer   no-undo .
     6082   define input-output parameter v-sec      as integer   no-undo .
     6083   define output parameter new-rec-str      as recid   no-undo.
     6084   define buffer buf-bar-code              for ub.bar-code.
     6085   define buffer buf-goods                 for ub.goods.
     6086   define buffer buf-price-doc-forming-gds for ub.price-doc-forming-gds.
     6087   define buffer buf-price-list            for ub.price-doc-forming-gds.
     6088   define buffer buf-price-doc-forming     for ub.price-doc-forming.
     6089   define buffer new-price-doc-forming     for ub.price-doc-forming.
     6090   define buffer new-price-doc-forming-gds for ub.price-doc-forming-gds  .
     6091   define buffer buf-gds-prt               for ub.gds-prt  .
     6092   define buffer buf_parts for ub.parts  .
     6093   define buffer buf_goods for ub.goods  .
     6094     do
     6095     on error undo, return error return-value
     6096     :
     6097     find  buf-price-doc-forming no-lock where
     6098           recid(buf-price-doc-forming) = old-recid .
     6099     find  new-price-doc-forming no-lock where
     6100           recid(new-price-doc-forming) = new-recid .
     6101     find  buf-bar-code no-lock where
     6102           buf-bar-code.b-code = p-main-code.
     6103     find  buf-goods no-lock where
     6104           buf-goods.gds-code = buf-bar-code.gds-code.
     6105     find  buf-price-doc-forming-gds no-lock  where
     6106           buf-price-doc-forming-gds.pdf-id = buf-price-doc-forming.pdf-id and
     6107           buf-price-doc-forming-gds.plt-id = buf-price-doc-forming.plt-id and
     6108           buf-price-doc-forming-gds.pdf-db     = buf-price-doc-forming.pdf-db and
     6109           buf-price-doc-forming-gds.plt-db-num = buf-price-doc-forming.plt-db-num and
     6110           buf-price-doc-forming-gds.b-code  = p-main-code no-error .
     6111     if error-status :error then return .
     6112     find  buf-gds-prt no-lock where
     6113           buf-gds-prt.node-code = buf-bar-code.node-code.
     6114   if par-pr-altex = "yes" and
     6115      par-pr-notls = "yes" then do:
     6116   for each  buf-price-list where
     6117             buf-price-list.pdf-id = buf-price-doc-forming.pdf-id and
     6118             buf-price-list.plt-id = buf-price-doc-forming.plt-id and
     6119             buf-price-list.pdf-db     = buf-price-doc-forming.pdf-db and
     6120             buf-price-list.plt-db-num = buf-price-doc-forming.plt-db-num and
     6121             buf-price-list.b-code     <> p-main-code and
     6122             buf-price-list.artic       = buf-goods.artic  and
     6123             buf-price-list.prod-type   = buf-goods.prod-type and
     6124             buf-price-list.prod-code   = buf-goods.prod-code
     6125             ,
     6126       first buf-bar-code no-lock where
     6127             buf-bar-code.b-code   = buf-price-list.b-code and
     6128             buf-bar-code.unit-cli <> buf-goods.unit-base:
     6129      run create-calc-bc in this-procedure
     6130          ( input  recid( new-price-doc-forming )
     6131           ,input  p-calc-method
     6132           ,input  p-increase-pc
     6133           ,input  p-round-method
     6134           ,input  p-round-base
     6135           ,input  buf-bar-code.b-code
     6136           ,input  buf-goods.gds-code
     6137           ,input  buf-goods.artic
     6138           ,input  buf-goods.prod-type
     6139           ,input  buf-goods.prod-code
     6140           ,input  new-price-doc-forming.base-rate
     6141           ,input  new-price-doc-forming.base-scale
     6142           ,input  new-price-doc-forming.exch-scale
     6143           ,input  new-price-doc-forming.exch-rate
     6144           ,input  v-doc-code
     6145           ,input  v-common-price
     6146           ,input  v-copy-type
     6147           ,input  v-copy-code
     6148           ,input-output v-line-num
     6149           ,input-output v-sec
     6150         ) no-error .
     6151     if error-status:error then do:
     6152       message
     6153         "Ошибка cre-pr-list."                skip
     6154         "Код:" buf-bar-code.b-code           skip
     6155         error-status :get-message(1)         skip
     6156         return-value                         skip
     6157          "pdf" new-price-doc-forming.pdf-id  skip
     6158         view-as alert-box.
     6159       next.
     6160     end.
     6161   end.
     6162   end.
     6163   if par-pr-sclex = "yes" and
     6164      par-pr-notls = "yes" then do:
     6165   for each  buf-price-list where
     6166             buf-price-list.pdf-id = buf-price-doc-forming.pdf-id and
     6167             buf-price-list.plt-id = buf-price-doc-forming.plt-id and
     6168             buf-price-list.pdf-db     = buf-price-doc-forming.pdf-db and
     6169             buf-price-list.plt-db-num = buf-price-doc-forming.plt-db-num and
     6170             buf-price-list.b-code     <> p-main-code and
     6171             buf-price-list.artic       = buf-goods.artic  and
     6172             buf-price-list.prod-type   = buf-goods.prod-type and
     6173             buf-price-list.prod-code   = buf-goods.prod-code  ,
     6174       first buf-bar-code no-lock where
     6175             buf-bar-code.b-code   = buf-price-list.b-code and
     6176             buf-bar-code.unit-cli = buf-goods.unit-base and
     6177             buf-bar-code.in-code = ""
     6178             :
     6179      run create-calc-bc in this-procedure
     6180          ( input  recid( new-price-doc-forming )
     6181           ,input  p-calc-method
     6182           ,input  p-increase-pc
     6183           ,input  p-round-method
     6184           ,input  p-round-base
     6185           ,input  buf-bar-code.b-code
     6186           ,input  buf-goods.gds-code
     6187           ,input  buf-goods.artic
     6188           ,input  buf-goods.prod-type
     6189           ,input  buf-goods.prod-code
     6190           ,input  new-price-doc-forming.base-rate
     6191           ,input  new-price-doc-forming.base-scale
     6192           ,input  new-price-doc-forming.exch-scale
     6193           ,input  new-price-doc-forming.exch-rate
     6194           ,input v-doc-code
     6195           ,input v-common-price
     6196           ,input v-copy-type
     6197           ,input v-copy-code
     6198           ,input-output v-line-num
     6199           ,input-output v-sec
     6200         ) no-error .
     6201         if error-status:error then do:
     6202           message
     6203             "Ошибка cre-pr-list.2" skip
     6204             "Код:" buf-bar-code.b-code
     6205             view-as alert-box.
     6206           next.
     6207         end.
     6208       end.
     6209   end.
     6210   if par-pr-parex = "yes" and
     6211      par-pr-notls = "yes" then do:
     6212   define buffer bt_trn-doc  for ub.trn-doc  .
     6213   define buffer bf_parts    for ub.parts  .
     6214   define buffer free_parts  for ub.parts  .
     6215   define buffer buf_gds-obj for ub.gds-obj  .
     6216   find first buf_gds-obj no-lock where
     6217              buf_gds-obj.gds-code = buf-goods.gds-code and
     6218              buf_gds-obj.obj-type = v-cntxt-obj-type   and
     6219              buf_gds-obj.obj-code = v-cntxt-obj-code   and
     6220              buf_gds-obj.cash-parts = true
     6221              no-error .
     6222   if not available buf_gds-obj then return .
     6223    find first bt_trn-doc no-lock where
     6224               bt_trn-doc.doc-code = v-doc-code no-error .
     6225    if v-doc-code <> "" and available bt_trn-doc then do:
     6226    for each temp-exp-partbc :
     6227        delete temp-exp-partbc.
     6228    end.
     6229    for each bf_parts no-lock where
     6230             bf_parts.out-code   = bt_trn-doc.doc-code and
     6231             bf_parts.obj-type   = bt_trn-doc.obj-type and
     6232             bf_parts.obj-code   = bt_trn-doc.obj-code and
     6233             bf_parts.artic      = buf-goods.artic     and
     6234             bf_parts.prod-type  = buf-goods.prod-type and
     6235             bf_parts.prod-code  = buf-goods.prod-code  ,
     6236           first free_parts no-lock where
     6237                 free_parts.in-code   = bf_parts.in-code   and
     6238                 free_parts.part-code = bf_parts.part-code and
     6239                 free_parts.out-code  = 'free-zone':U       and
     6240                 free_parts.rsrv-free = true               and
     6241                 free_parts.status_   = false              and
     6242                 free_parts.obj-type  = bf_parts.obj-type  and
     6243                 free_parts.obj-code  = bf_parts.obj-code  and
     6244                 free_parts.artic     = bf_parts.artic     and
     6245                 free_parts.prod-type = bf_parts.prod-type and
     6246                 free_parts.prod-code = bf_parts.prod-code ,
     6247           first buf-bar-code no-lock where
     6248                 buf-bar-code.gds-code  = buf-goods.gds-code and
     6249                 buf-bar-code.unit-cli  = buf-goods.unit-base and
     6250                 buf-bar-code.in-code   = bf_parts.in-code and
     6251                 buf-bar-code.part-code = bf_parts.part-code
     6252                 :
     6253      run create-calc-bc in this-procedure
     6254          ( input  recid( new-price-doc-forming )
     6255           ,input  p-calc-method
     6256           ,input  p-increase-pc
     6257           ,input  p-round-method
     6258           ,input  p-round-base
     6259           ,input  buf-bar-code.b-code
     6260           ,input  buf-goods.gds-code
     6261           ,input  buf-goods.artic
     6262           ,input  buf-goods.prod-type
     6263           ,input  buf-goods.prod-code
     6264           ,input  new-price-doc-forming.base-rate
     6265           ,input  new-price-doc-forming.base-scale
     6266           ,input  new-price-doc-forming.exch-scale
     6267           ,input  new-price-doc-forming.exch-rate
     6268           ,input v-doc-code
     6269           ,input v-common-price
     6270           ,input v-copy-type
     6271           ,input v-copy-code
     6272           ,input-output v-line-num
     6273           ,input-output v-sec
     6274         ) no-error .
     6275         if error-status:error then do:
     6276           message
     6277             "Ошибка cre-pr-list.3-" skip
     6278             "Код:" buf-bar-code.b-code
     6279             view-as alert-box.
     6280           next.
     6281         end.
     6282         create temp-exp-partbc.
     6283         assign
     6284            temp-exp-partbc.b-code = buf-bar-code.b-code
     6285         .
     6286    end.
     6287   end.
     6288   for each  buf-price-list where
     6289             buf-price-list.pdf-id     = buf-price-doc-forming.pdf-id and
     6290             buf-price-list.plt-id     = buf-price-doc-forming.plt-id and
     6291             buf-price-list.pdf-db     = buf-price-doc-forming.pdf-db and
     6292             buf-price-list.plt-db-num = buf-price-doc-forming.plt-db-num and
     6293             buf-price-list.b-code     <> p-main-code         and
     6294             buf-price-list.artic       = buf-goods.artic     and
     6295             buf-price-list.prod-type   = buf-goods.prod-type and
     6296             buf-price-list.prod-code   = buf-goods.prod-code ,
     6297       first buf-bar-code no-lock where
     6298             buf-bar-code.b-code   = buf-price-list.b-code and
     6299             buf-bar-code.unit-cli = buf-goods.unit-base and
     6300             buf-bar-code.in-code <> "" ,
     6301       first buf_parts no-lock where
     6302             buf_parts.out-code    = 'free-zone':U and
     6303             buf_parts.rsrv-free   = true  and
     6304             buf_parts.status_     = false and
     6305             buf_parts.artic       = buf-goods.artic and
     6306             buf_parts.prod-type   = buf-goods.prod-type and
     6307             buf_parts.prod-code   = buf-goods.prod-code and
     6308             buf_parts.obj-type   = v-cntxt-obj-type and
     6309             buf_parts.obj-code   = v-cntxt-obj-code and
     6310             buf_parts.part-code   = buf-bar-code.part-code and
     6311             buf_parts.in-code     = buf-bar-code.in-code
     6312             :
     6313             find first temp-exp-partbc where
     6314                        temp-exp-partbc.b-code = buf-bar-code.b-code no-error .
     6315           if available temp-exp-partbc then next.
     6316      run create-calc-bc in this-procedure
     6317          ( input  recid( new-price-doc-forming )
     6318           ,input  'Старая':U
     6319           ,input  0
     6320           ,input  'Отключено':U
     6321           ,input  0
     6322           ,input  buf-bar-code.b-code
     6323           ,input  buf-goods.gds-code
     6324           ,input  buf-goods.artic
     6325           ,input  buf-goods.prod-type
     6326           ,input  buf-goods.prod-code
     6327           ,input  new-price-doc-forming.base-rate
     6328           ,input  new-price-doc-forming.base-scale
     6329           ,input  new-price-doc-forming.exch-scale
     6330           ,input  new-price-doc-forming.exch-rate
     6331           ,input v-doc-code
     6332           ,input v-common-price
     6333           ,input v-copy-type
     6334           ,input v-copy-code
     6335           ,input-output v-line-num
     6336           ,input-output v-sec
     6337         ) no-error .
     6338         if error-status:error then do:
     6339           message
     6340             "Ошибка cre-pr-list.3" skip
     6341             "Код:" buf-bar-code.b-code
     6342             view-as alert-box.
     6343           next.
     6344         end.
     6345       end.
     6346     for each buf_parts no-lock where
     6347             buf_parts.out-code    = 'free-zone':U and
     6348             buf_parts.rsrv-free   = true  and
     6349             buf_parts.status_     = false and
     6350             buf_parts.artic       = buf-goods.artic and
     6351             buf_parts.prod-type   = buf-goods.prod-type and
     6352             buf_parts.prod-code   = buf-goods.prod-code and
     6353             buf_parts.obj-type    = v-cntxt-obj-type and
     6354             buf_parts.obj-code    = v-cntxt-obj-code and
     6355             buf_parts.part-code   = buf-bar-code.part-code and
     6356             buf_parts.in-code     = buf-bar-code.in-code,
     6357           first buf-bar-code no-lock where
     6358                 buf-bar-code.gds-code  = buf-goods.gds-code and
     6359                 buf-bar-code.unit-cli  = buf-goods.unit-base and
     6360                 buf-bar-code.in-code   = buf_parts.in-code and
     6361                 buf-bar-code.part-code = buf_parts.part-code
     6362             :
     6363             find first temp-exp-partbc where
     6364                        temp-exp-partbc.b-code = buf-bar-code.b-code no-error .
     6365           if available temp-exp-partbc then next.
     6366             find first new-price-doc-forming-gds where
     6367                        new-price-doc-forming-gds.pdf-id     = new-price-doc-forming.pdf-id and
     6368                        new-price-doc-forming-gds.pdf-db     = new-price-doc-forming.pdf-db and
     6369                        new-price-doc-forming-gds.plt-id     = new-price-doc-forming.plt-id and
     6370                        new-price-doc-forming-gds.plt-db-num = new-price-doc-forming.plt-db-num  and
     6371                        new-price-doc-forming-gds.b-code = buf-bar-code.b-code
     6372                        no-error .
     6373           if available new-price-doc-forming-gds then next.
     6374      run create-calc-bc in this-procedure
     6375          ( input recid( new-price-doc-forming )
     6376           ,input 'Старая':U
     6377           ,input 0
     6378           ,input 'Отключено':U
     6379           ,input 0
     6380           ,input buf-bar-code.b-code
     6381           ,input buf-goods.gds-code
     6382           ,input buf-goods.artic
     6383           ,input buf-goods.prod-type
     6384           ,input buf-goods.prod-code
     6385           ,input new-price-doc-forming.base-rate
     6386           ,input new-price-doc-forming.base-scale
     6387           ,input new-price-doc-forming.exch-scale
     6388           ,input new-price-doc-forming.exch-rate
     6389           ,input v-doc-code
     6390           ,input v-common-price
     6391           ,input v-copy-type
     6392           ,input v-copy-code
     6393           ,input-output v-line-num
     6394           ,input-output v-sec
     6395         ) no-error .
     6396         if error-status:error then do:
     6397           message
     6398             "Ошибка cre-pr-list.4" skip
     6399             "Код:" buf-bar-code.b-code
     6400             view-as alert-box.
     6401           next.
     6402         end.
     6403       end.
     6404   end.
     6405     end.
     6406   end procedure.
     6407   procedure create-calc-bc :
     6408   define input parameter  v-new-recid as recid no-undo .
     6409   define input parameter  p-calc-method  as character no-undo .
     6410   define input parameter  p-increase-pc  as decimal   no-undo .
     6411   define input parameter  round-method as character no-undo .
     6412   define input parameter  round-base   as decimal   no-undo .
     6413   define input parameter  p-b-code     as integer   no-undo .
     6414   define input parameter  p-gds-code   as integer   no-undo .
     6415   define input parameter  p-artic      as character no-undo .
     6416   define input parameter  p-prod-type  as character no-undo .
     6417   define input parameter  p-prod-code  as integer   no-undo .
     6418   define input parameter  v-base-rate  as decimal   no-undo .
     6419   define input parameter  v-base-scale as decimal   no-undo .
     6420   define input parameter  v-exch-scale as decimal   no-undo .
     6421   define input parameter  v-exch-rate  as decimal   no-undo .
     6422   define input parameter  v-doc-code   as character no-undo .
     6423   define input parameter  v-common-price as decimal   no-undo .
     6424   define input parameter  v-copy-type as character no-undo .
     6425   define input parameter  v-copy-code as integer   no-undo .
     6426   define input-output parameter v-line-num as integer   no-undo .
     6427   define input-output parameter v-sec     as integer   no-undo .
     6428   define buffer buf_price-doc-forming for ub.price-doc-forming  .
     6429   define variable v-price-calc-base as decimal   no-undo .
     6430   define variable v-price-calc-doc  as decimal   no-undo .
     6431   define variable v-price-calc-rubl as decimal   no-undo .
     6432   define variable v-price-prev-base as decimal   no-undo .
     6433   define variable v-price-prev-doc  as decimal   no-undo .
     6434   define variable v-price-prev-rubl as decimal   no-undo .
     6435   define variable v-price-sale-base as decimal   no-undo .
     6436   define variable v-price-sale-doc  as decimal   no-undo .
     6437   define variable v-price-sale-rubl as decimal   no-undo .
     6438   define variable v-road-tax-base   as decimal   no-undo .
     6439   define variable v-road-tax-doc    as decimal   no-undo .
     6440   define variable v-road-tax-rubl   as decimal   no-undo .
     6441   define variable v-excise-base     as decimal   no-undo .
     6442   define variable v-excise-doc      as decimal   no-undo .
     6443   define variable v-excise-rubl     as decimal   no-undo .
     6444   define variable v-vat-pc          as decimal   no-undo .
     6445   define variable v-slt-pc          as decimal   no-undo .
     6446   define variable v-prev-doc-code   as character no-undo .
     6447   define variable v-d-pcnt as decimal   no-undo .
     6448     do
     6449     on error undo, return error return-value
     6450     :
     6451     find  buf_price-doc-forming no-lock where
     6452           recid(buf_price-doc-forming) = v-new-recid no-error .
     6453      if error-status :error then return error error-status :get-message(1) .
     6454      v-line-num = v-line-num + 1.
     6455      run calc-price-line  in this-procedure (
     6456        input  p-calc-method
     6457      , input  p-increase-pc
     6458      , input  round-method
     6459      , input  round-base
     6460      , input  p-b-code
     6461      , input  p-gds-code
     6462      , input  p-artic
     6463      , input  p-prod-type
     6464      , input  p-prod-code
     6465      , input  v-base-rate
     6466      , input  v-base-scale
     6467      , input  v-exch-scale
