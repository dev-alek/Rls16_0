     2493   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2494   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gtplpnakl in g#library2
     2495     (input  ?
     2496     ,input  l-type
     2497     ,input  l-code
     2498     ,output par-pr-nakl-ie
     2499     ,output par-pr-nakl-iv
     2500     ,output par-pr-nakl-im
     2501     ) no-error .
     2502      define variable ii as integer   no-undo .
     2503      define variable nn as integer   no-undo .
     2504      define variable v-fullname as character no-undo .
     2505      nn = num-entries ( par-pr-nogds ).
     2506      par-pr-nogds-long = "".
     2507      if par-pr-nogds <> "0" and par-pr-nogds <> ""  then do:
     2508         repeat ii = 1 to nn :
     2509           run grplib-get-full-name  ( input integer(entry(ii,par-pr-nogds)) , output v-fullname ) .
     2510           par-pr-nogds-long = par-pr-nogds-long + v-fullname + chr(4) .
     2511         end.
     2512         par-pr-nogds-long = trim (par-pr-nogds-long,chr(4)) .
     2513      end.
     2514   l-par = true .
     2515   end procedure.
     2516   PROCEDURE cre-pr-list:
     2517   define input  parameter bc      like ub.price-list.b-code no-undo.
     2518   define input  parameter new-num like ub.price-doc.doc-num no-undo.
     2519   define output parameter new-rec as recid             no-undo.
     2520   define buffer buf-price-list for ub.price-list.
     2521   define buffer buf-price-doc  for ub.price-doc.
     2522   define buffer buf-bar-code   for ub.bar-code.
     2523   define buffer buf-goods      for ub.goods.
     2524   define buffer buf-gds-prt    for ub.gds-prt.
     2525   define buffer root-gds-prt   for ub.gds-prt.
     2526   define variable cur-pr like ub.price-list.price-sale no-undo.
     2527   define variable cur-rt like ub.price-list.road-tax   no-undo.
     2528   define variable cur-ex like ub.price-list.excise     no-undo.
     2529   define variable cur-dn like ub.price-list.doc-num    no-undo.
     2530   define variable local_vat-pc like ub.price-list.vat-pc    no-undo.
     2531   define variable local_slt-pc like ub.price-list.slt-pc    no-undo.
     2532   define variable cur-rt-base as decimal no-undo .
     2533   define variable cur-rt-rubl as decimal no-undo .
     2534   define variable p-hostcode as int no-undo .
     2535   define variable v-line-num as integer no-undo .
     2536   define variable v-skip-del-gds as logical no-undo initial no .
     2537   cre-pr:
     2538   do on error undo cre-pr, return error:
     2539     find  buf-bar-code no-lock where
     2540           buf-bar-code.b-code = bc.
     2541     run check-use-bar-code ( buf-bar-code.b-code ) no-error .
     2542     if error-status :error then do:
     2543       message
     2544         return-value skip
     2545         "Ошибка !"
     2546         view-as alert-box error
     2547       .
     2548       undo cre-pr, return.
     2549     end.
     2550     find  buf-goods no-lock where
     2551           buf-goods.gds-code = buf-bar-code.gds-code.
     2552     find first root-gds-prt no-lock where
     2553               root-gds-prt.upper-code = buf-goods.prt-root.
     2554     if root-gds-prt.node-name <> '_Пустая шкала':U and
     2555       buf-bar-code.in-code <> "" then do:
     2556       message
     2557         "Не допускается создавать спец. цены на партии для товаров с непустой шкалой!" skip (2)
     2558         "Артикул:" buf-goods.artic "Код:" buf-goods.gds-code buf-goods.gds-name
     2559         view-as alert-box error.
     2560       undo cre-pr, return.
     2561     end.
     2562     find  buf-gds-prt no-lock where
     2563           buf-gds-prt.node-code = buf-bar-code.node-code.
     2564     if buf-goods.stts <> 0 and not v-skip-del-gds then do:
     2565       message
     2566         "Не допускается создавать цены на удаленные товары!" skip (2)
     2567         "Артикул:" buf-goods.artic "Код:" buf-goods.gds-code buf-goods.gds-name
     2568         view-as alert-box error.
     2569       undo cre-pr, return.
     2570     end.
     2571     find  buf-price-doc where
     2572           buf-price-doc.doc-num = new-num.
     2573   define variable v-ret as logical no-undo .
     2574      run ver-modificator-price-is-null (
     2575             input    buf-goods.artic        ,
     2576             input    buf-goods.prod-type    ,
     2577             input    buf-goods.prod-code    ,
     2578             input    buf-price-doc.obj-type   ,
     2579             input    buf-price-doc.obj-code   ,
     2580             output   v-ret ).
     2581         if v-ret = false then dO:
     2582             message
     2583               "Не допускается создавать цены на модификаторы с нулевой ценой !" skip (2)
     2584               "Артикул:" buf-goods.artic "Код:" buf-goods.gds-code buf-goods.gds-name
     2585               view-as alert-box error.
     2586             undo cre-pr, return.
     2587           end.
     2588   define variable vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2589   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2590     (input  buf-price-doc.obj-type
     2591     ,input  buf-price-doc.obj-code
     2592     ,output p-hostcode
     2593     ) no-error .
