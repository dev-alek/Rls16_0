     4788   Учет-НДСS,
     4789   Откат_цен,
     4790   Спецификация
     4791   "
     4792     .
     4793   if lookup ( p-calc-method , v-sps )  = 0 then  do:
     4794       p-calc-method = entry (1,p-calc-method, " ") no-error .
     4795       if error-status :error then message p-calc-method.
     4796   end.
     4797   define variable v-i as integer   no-undo init 0.
     4798     for each  x_obj-group :
     4799         v-i = v-i + 1.
     4800         if entry( v-i, new_round , chr(4) ) <> string ( loc_round ) then do:
     4801             message "На выбранных объектах используются разные параметры Наценки и округления ! Для расчета выбран" string ( loc_round ) skip "для товара  "
     4802             skip
     4803             "код     :" p-gds-code  skip
     4804             "бар-код :" p-b-code    skip
     4805             "артикул :" p-artic     skip
     4806             "производитель :" p-prod-type        p-prod-code
     4807             view-as alert-box information .
     4808             leave.
     4809         end.
     4810         if entry( v-i, new_vat-pc , chr(4) ) <> string ( local_vat-pc ) then do:
     4811             message "На выбранных объектах используются разные НДС ! Для расчета выбран" string ( local_vat-pc ) "%" skip "для товара  "
     4812             skip
     4813             "код     :" p-gds-code  skip
     4814             "бар-код :" p-b-code    skip
     4815             "артикул :" p-artic     skip
     4816             "производитель :" p-prod-type        p-prod-code
     4817             view-as alert-box information .
     4818             leave.
     4819         end.
     4820         if entry( v-i, new_slt-pc , chr(4) ) <> string ( local_slt-pc ) then do:
     4821             message "На выбранных объектах используются разные НсП ! Для расчета выбран" string ( local_slt-pc )
     4822             skip
     4823             "код     :" p-gds-code   skip
     4824             "бар-код :" p-b-code    skip
     4825             "артикул :" p-artic             skip
     4826             "производитель :" p-prod-type        p-prod-code
     4827             view-as alert-box information .
