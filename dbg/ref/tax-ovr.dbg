    10358     :
    10359       run diasize_change-width in this-procedure
    10360         (input  (p-new-width - frame frm :width)
    10361         ,input  p-move-resize
    10362         ) .
    10363     end.
    10364   end procedure.
    10365   procedure diasize_position-resize-button :
    10366     do with frame frm
    10367     :
    10368       hide v-diasize-resize-button .
    10369       assign
    10370         v-diasize-resize-button :row = frame frm :height - v-diasize-resize-button :height
    10371                     - 1
    10372                     - (frame frm :border-bottom-pixels / session :pixels-per-row)
    10373         v-diasize-resize-button :col = frame frm :width - v-diasize-resize-button :width
    10374                     - 1
    10375                     - (frame frm :border-right-pixels / session :pixels-per-column)
    10376       .
    10377       view v-diasize-resize-button .
    10378     end.
    10379   end procedure.
    10380   on alt-right anywhere
    10381   do:
    10382     run diasize_change-width in this-procedure
    10383       (input 1
    10384       ,input true
    10385       ) .
    10386     return no-apply .
    10387   end.
    10388   on alt-left anywhere
    10389   do:
    10390     run diasize_change-width in this-procedure
    10391       (input -1
    10392       ,input true
    10393       ) .
    10394     return no-apply .
    10395   end.
    10396   on alt-down anywhere
    10397   do:
    10398     run diasize_change-height in this-procedure
    10399       (input 1
    10400       ,input true
    10401       ) .
    10402     return no-apply .
    10403   end.
    10404   on alt-up anywhere
    10405   do:
    10406     run diasize_change-height in this-procedure
    10407       (input -1
    10408       ,input true
    10409       ) .
    10410     return no-apply .
    10411   end.
    10412   on alt-enter of frame frm
    10413   do:
    10414     run diasize_maximize in this-procedure
    10415       (input  ?
    10416       ).
    10417     return no-apply .
    10418   end.
    10419   procedure diasize_end-move :
    10420     do
    10421     on error undo, return error return-value
    10422     :
    10423       define variable v-row-delta as decimal   no-undo .
    10424       define variable v-col-delta as decimal   no-undo .
    10425       define variable v-new-row as decimal   no-undo .
    10426       define variable v-new-col as decimal   no-undo .
    10427       assign
    10428         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
    10429         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
    10430       .
    10431       assign
    10432         v-row-delta = v-new-row - frame frm :height
    10433         v-col-delta = v-new-col - frame frm :width
    10434       .
    10435       run diasize_change-height in this-procedure
    10436         (input v-row-delta
    10437         ,input true
    10438         ) .
    10439       run diasize_change-width in this-procedure
    10440         (input v-col-delta
    10441         ,input true
    10442         ) .
    10443     end.
    10444   end procedure.
    10445   procedure diasize_maximize :
    10446     define input  parameter p-action as logical   no-undo .
    10447     do
    10448     on error undo, return error return-value
    10449     :
    10450       if p-action = ?
    10451       then do:
    10452         if v-diasize-need-maximize = true
    10453         then do:
    10454           assign
    10455             p-action = true
    10456           .
    10457         end.
    10458         else do:
    10459           assign
    10460             p-action = false
    10461           .
    10462         end.
    10463       end.
    10464       if p-action = true
    10465       then do:
    10466         run diasize_change-height in this-procedure
    10467           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
    10468               - frame frm :height-chars
    10469           ,input true
    10470           ) .
    10471         run diasize_change-width in this-procedure
    10472           (input session :width-chars
    10473               - frame frm :width-chars
    10474           ,input true
    10475           ) .
    10476         assign
    10477           v-diasize-need-maximize = false
    10478         .
    10479       end.
    10480       else do:
    10481         run diasize_change-width in this-procedure
    10482           (input v-diasize-orig-frame-width
    10483               - frame frm :width-chars
    10484           ,input true
    10485           ) .
    10486         run diasize_change-height in this-procedure
    10487           (input v-diasize-orig-frame-height
    10488               - frame frm :height-chars
    10489           ,input true
    10490           ) .
    10491         assign
    10492           v-diasize-need-maximize = true
    10493         .
    10494       end.
    10495     end.
    10496   end procedure.
    10497   procedure diasize_restore-orig-size :
    10498     do
    10499     on error undo, return error return-value
    10500     :
    10501       assign
    10502         v-diasize-current-frame-width  = frame frm :width
    10503         v-diasize-current-frame-height = frame frm :height
    10504       .
    10505       run diasize_set-height in this-procedure
    10506         (input  v-diasize-orig-frame-height
    10507         ,input  true
    10508         ) .
    10509       run diasize_set-width in this-procedure
    10510         (input  v-diasize-orig-frame-width
    10511         ,input  true
    10512         ) .
    10513     end.
    10514   end procedure.
    10515   procedure diasize_restore-current-size :
    10516     do
    10517     on error undo, return error return-value
    10518     :
    10519       run diasize_set-height in this-procedure
    10520         (input  v-diasize-current-frame-height
    10521         ,input  true
    10522         ) .
    10523       run diasize_set-width in this-procedure
    10524         (input  v-diasize-current-frame-width
    10525         ,input  true
    10526         ) .
    10527     end.
    10528   end procedure.
    10529   procedure diasize_set-browse-handle :
    10530     define input  parameter p-browse-handle as handle   no-undo .
    10531     define buffer buf_temp-browse-handle for temp-browse-handle .
    10532     do
    10533     on error undo, return error return-value
    10534     :
    10535       assign
    10536         v-diasize-browse-handle = p-browse-handle
    10537       .
    10538       for each buf_temp-browse-handle
    10539       on error undo, return error return-value
    10540       :
    10541         delete buf_temp-browse-handle .
    10542       end.
    10543     end.
    10544   end procedure.
    10545   procedure diasize_add_browse :
    10546     define input  parameter p-browse-type   as character no-undo .
    10547     define input  parameter p-browse-handle as handle    no-undo .
    10548     define buffer buf_temp-browse-handle for temp-browse-handle .
    10549     do
    10550     on error undo, return error return-value
    10551     :
    10552       assign
    10553         v-diasize-browse-number = v-diasize-browse-number + 1
    10554       .
    10555       create buf_temp-browse-handle .
    10556       assign
    10557         buf_temp-browse-handle.browse-type   = p-browse-type
    10558         buf_temp-browse-handle.browse-number = v-diasize-browse-number
    10559         buf_temp-browse-handle.browse-handle = p-browse-handle
    10560       .
    10561     end.
    10562   end procedure.
    10563   procedure diasize_init :
    10564     define variable v-default-value    as logical   no-undo .
    10565     define variable v-restore-saved    as logical   no-undo .
    10566     define variable v-resize-value-str as character no-undo .
    10567     do
    10568     on error undo, return error return-value
    10569     :
    10570       do with frame frm
    10571       :
    10572         assign
    10573           v-diasize-orig-frame-height = frame frm :height
    10574           v-diasize-orig-frame-width  = frame frm :width
    10575           v-diasize-browse-handle     = browse br-goods :handle
    10576         .
    10577         create button v-diasize-resize-button
    10578         assign
    10579           parent        = frame frm :first-child
    10580           label         = "s"
    10581           height-pixels = 16
    10582           width-pixels  = 16
    10583           visible       = true
    10584           sensitive     = true
    10585           movable       = true
    10586           triggers:
    10587             on end-move persistent run diasize_end-move in this-procedure .
    10588           end triggers.
    10589         v-diasize-resize-button :load-mouse-pointer("SIZE") .
    10590         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
    10591         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
    10592         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
    10593         assign
    10594           v-diasize-wndmax = false
    10595         .
    10596         if connected("ub") = true
    10597         then do:
    10598           define variable v-cntxt-db-num        as integer   no-undo .
    10599           define variable v-cntxt-userid        as character no-undo .
    10600           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
    10601                                             , OUTPUT v-cntxt-userid
    10602                                             ) .
    10603           run gbl/wndpar_r.p
    10604             (input  v-cntxt-db-num
    10605             ,input  v-cntxt-userid
    10606             ,input  'wndmax':U
    10607             ,output v-diasize-wndmax
    10608             ,output v-default-value
    10609             ) .
    10610         end.
    10611         assign
    10612           v-diasize-wndstore = false
    10613         .
    10614         if connected("ub") = true
    10615         then do:
    10616           run gbl/wndpar_r.p
    10617             (input  v-cntxt-db-num
    10618             ,input  v-cntxt-userid
    10619             ,input  'wndstore':U
    10620             ,output v-diasize-wndstore
    10621             ,output v-default-value
    10622             ) .
    10623         end.
    10624         assign
    10625           v-diasize-proc-name = entry(1, program-name(2), '.')
    10626         .
    10627         if v-diasize-wndstore = true
    10628         then do:
    10629           assign
    10630             v-restore-saved = false
    10631           .
    10632           if connected("ub") = true
    10633           then do:
    10634             run gbl/wndsizer.p
    10635               (input  v-cntxt-db-num
    10636               ,input  v-cntxt-userid
    10637               ,input  v-diasize-proc-name
    10638               ,input  'height':u
    10639               ,output v-resize-value-str
    10640               ) .
    10641             if v-resize-value-str <> '':U
    10642             then do:
    10643               run diasize_change-height in this-procedure
    10644                 (input  integer(v-resize-value-str)
    10645                 ,input  true
    10646                 ) .
    10647               assign
    10648                 v-restore-saved = true
    10649               .
    10650             end.
    10651           end.
    10652           if connected("ub") = true
    10653           then do:
    10654             run gbl/wndsizer.p
    10655               (input  v-cntxt-db-num
    10656               ,input  v-cntxt-userid
    10657               ,input  v-diasize-proc-name
    10658               ,input  'width':u
    10659               ,output v-resize-value-str
    10660               ) .
    10661             if v-resize-value-str <> '':U
    10662             then do:
    10663               run diasize_change-width in this-procedure
    10664                 (input  integer(v-resize-value-str)
    10665                 ,input  true
    10666                 ) .
    10667               assign
    10668                 v-restore-saved = true
    10669               .
    10670             end.
    10671           end.
    10672           if v-restore-saved <> true
    10673           then do:
    10674             if v-diasize-wndmax = true
    10675             then do:
    10676               run diasize_maximize in this-procedure
    10677                 (input  true
    10678                 ) .
    10679             end.
    10680           end.
    10681         end.
    10682         else do:
    10683           if v-diasize-wndmax = true
    10684           then do:
    10685             run diasize_maximize in this-procedure
    10686               (input  true
    10687               ) .
    10688           end.
    10689         end.
    10690       end.
    10691     end.
    10692   end procedure.
    10693   procedure diasize_need-full-display :
    10694     define output parameter p-need-full-display as logical   no-undo .
    10695     do
    10696     on error undo, return error return-value
    10697     :
    10698       assign
    10699         p-need-full-display = v-diasize-need-full-display
    10700       .
    10701       assign
    10702         v-diasize-need-full-display = false
    10703       .
    10704     end.
    10705   end procedure.
    10706   procedure get-context :
    10707      define output parameter p-db-num as integer          no-undo.
    10708      define output parameter p-user-id as character        no-undo.
    10709      define variable v-login               as character    no-undo.
    10710      define buffer buf_sys-ctrl    for ub.sys-ctrl .
    10711      define buffer buf_user-login  for ub.user-login .
    10712      do
    10713      on error undo, return error
    10714      :
    10715            FIND FIRST buf_sys-ctrl no-lock.
    10716            ASSIGN
    10717               v-login = USERID("ub")
    10718               p-db-num = buf_sys-ctrl.db-num
    10719            .
    10720            FIND FIRST buf_user-login
    10721                 WHERE buf_user-login.db-num = p-db-num
    10722                   AND buf_user-login.user-login = v-login
    10723                 no-lock
    10724                 no-error
    10725                 .
    10726            IF AVAILABLE buf_user-login
    10727            THEN DO:
    10728               assign
    10729                  p-user-id = buf_user-login.user-id
    10730               .
    10731            END.
    10732      end.
    10733   end procedure.
    10734       run diasize_init in this-procedure .
    10735   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME frm:PARENT eq ?
    10736   THEN FRAME frm:PARENT = ACTIVE-WINDOW.
    10737   MAIN-BLOCK:
    10738   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
    10739      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
    10740   define variable vss-include-info90 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10741     run mainmenu_getcntxt in parparentproc
    10742       (output v-cntxt-db-num
    10743       ,output v-cntxt-userid
    10744       ,output v-cntxt-level
    10745       ,output v-cntxt-host-code-obj
    10746       ,output v-cntxt-obj-type
    10747       ,output v-cntxt-obj-code
    10748       ,output v-cntxt-db-num-obj
    10749       ,output v-cntxt-is-admin
    10750       ) .
    10751     find first buf_tax-rate-value no-lock
    10752        where recid( buf_tax-rate-value ) = p-tax-rate-value-recid
    10753     .
    10754     run create-obj-list in this-procedure ( output v-display-frame ).
    10755     if v-display-frame = yes
    10756     then do:
    10757           ASSIGN bt-export:MENU-MOUSE = 1.
    10758           RUN enable_UI.
    10759           WAIT-FOR GO OF FRAME frm.
    10760     end.
    10761   END.
    10762   if v-display-frame = yes
    10763   then do:
    10764       RUN disable_UI.
    10765   end.
    10766   PROCEDURE create-obj-list :
    10767   define output parameter p-display-frame as logical no-undo.
    10768   do
    10769   on error undo, return error
    10770   :
    10771   assign
    10772       p-display-frame = yes
    10773   .
    10774   if buf_tax-rate-value.host-code = 0
    10775       and buf_tax-rate-value.obj-type = ""
    10776       and buf_tax-rate-value.obj-code = 0
    10777   then do:
    10778       run init-temphost.
    10779       for each temp-host on error undo, return error
    10780       :
    10781           find first buf_host_tax-rate-value no-lock
    10782                where buf_host_tax-rate-value.tax-code     = buf_tax-rate-value.tax-code
    10783                  and buf_host_tax-rate-value.rate-code    = buf_tax-rate-value.rate-code
    10784                  and buf_host_tax-rate-value.host-code    = temp-host.host-code
    10785                  and buf_host_tax-rate-value.obj-type     = ""
    10786                  and buf_host_tax-rate-value.obj-code     = 0
    10787                  and buf_host_tax-rate-value.fact-order   < buf_tax-rate-value.fact-order
    10788           no-error.
    10789           if not available buf_host_tax-rate-value
    10790           then do:
    10791               for each temp-obj no-lock
    10792               where temp-obj.host-code = temp-host.host-code on error undo, return error
    10793               :
    10794   define variable vss-include-info91 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10795   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
    10796     (input  temp-obj.obj-type
    10797     ,input  temp-obj.obj-code
    10798     ,output v-obj-current-date
    10799     )  .
    10800                   if buf_tax-rate-value.fact-date = v-obj-current-date
    10801                   then do:
    10802                       find first buf_obj_tax-rate-value no-lock
    10803                           where buf_obj_tax-rate-value.tax-code     = buf_tax-rate-value.tax-code
    10804                             and buf_obj_tax-rate-value.rate-code    = buf_tax-rate-value.rate-code
    10805                             and buf_obj_tax-rate-value.host-code    = temp-host.host-code
    10806                             and buf_obj_tax-rate-value.obj-type     = temp-obj.obj-type
    10807                             and buf_obj_tax-rate-value.obj-code     = temp-obj.obj-code
    10808                             and buf_obj_tax-rate-value.fact-order   < buf_tax-rate-value.fact-order
    10809                       no-error.
    10810                       if not available buf_obj_tax-rate-value
    10811                       then do:
    10812                           create obj-list.
    10813                           find first buf_clients
    10814                                where buf_clients.obj-type = temp-obj.obj-type
    10815                                  and buf_clients.obj-code = temp-obj.obj-code
    10816                           .
    10817                           assign
    10818                               obj-list.obj-type   = temp-obj.obj-type
    10819                               obj-list.obj-code   = temp-obj.obj-code
    10820                               obj-list.obj-name   = buf_clients.obj-name
    10821                           .
    10822                       end.
    10823                   end.
    10824               end.
    10825           end.
    10826       end.
    10827       return.
    10828   end.
    10829   if buf_tax-rate-value.obj-type = ""
    10830       and buf_tax-rate-value.obj-code = 0
    10831   then do:
    10832       run init-temphost.
    10833       for each temp-obj no-lock
    10834       where temp-obj.host-code = buf_tax-rate-value.host-code on error undo, return error
    10835       :
    10836   define variable vss-include-info92 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10837   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
    10838     (input  temp-obj.obj-type
    10839     ,input  temp-obj.obj-code
    10840     ,output v-obj-current-date
    10841     )  .
    10842           if buf_tax-rate-value.fact-date = v-obj-current-date
    10843           then do:
    10844               find first buf_obj_tax-rate-value no-lock
    10845                   where buf_obj_tax-rate-value.tax-code     = buf_tax-rate-value.tax-code
    10846                       and buf_obj_tax-rate-value.rate-code    = buf_tax-rate-value.rate-code
    10847                       and buf_obj_tax-rate-value.host-code    = buf_tax-rate-value.host-code
    10848                       and buf_obj_tax-rate-value.obj-type     = temp-obj.obj-type
    10849                       and buf_obj_tax-rate-value.obj-code     = temp-obj.obj-code
    10850                       and buf_obj_tax-rate-value.fact-order   < buf_tax-rate-value.fact-order
    10851               no-error.
    10852               if not available buf_obj_tax-rate-value
    10853               then do:
    10854                   create obj-list.
    10855                   find first buf_clients
    10856                           where buf_clients.obj-type = temp-obj.obj-type
    10857                           and buf_clients.obj-code = temp-obj.obj-code
    10858                   .
    10859                   assign
    10860                       obj-list.obj-type   = temp-obj.obj-type
    10861                       obj-list.obj-code   = temp-obj.obj-code
    10862                       obj-list.obj-name   = buf_clients.obj-name
    10863                   .
    10864               end.
    10865           end.
    10866       end.
    10867       return.
    10868   end.
    10869   define variable vss-include-info93 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10870   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
    10871     (input  buf_tax-rate-value.obj-type
    10872     ,input  buf_tax-rate-value.obj-code
    10873     ,output v-obj-current-date
    10874     )  .
    10875   if buf_tax-rate-value.fact-date = v-obj-current-date
    10876   then do:
    10877       create obj-list.
    10878       find first buf_clients
    10879               where buf_clients.obj-type = buf_tax-rate-value.obj-type
    10880                 and buf_clients.obj-code = buf_tax-rate-value.obj-code
    10881       .
    10882       assign
    10883           obj-list.obj-type   = buf_tax-rate-value.obj-type
    10884           obj-list.obj-code   = buf_tax-rate-value.obj-code
    10885           obj-list.obj-name   = buf_clients.obj-name
    10886       .
    10887   end.
    10888   else do:
    10889       message
    10890       skip "Переоценку при изменении значения налога можно сформировать"
    10891       skip "только в день, когда новая ставка начнет действовать. "
    10892       skip(1) "Текущая дата на объекте:" chr(9) chr(9) chr(9) string( v-obj-current-date, "99/99/9999" )
    10893       skip    "Дата начала действия ставки налога:" chr(9) string( buf_tax-rate-value.fact-date, "99/99/9999" )
    10894       view-as alert-box information title "Невозможно сформировать ДНЦ  на объекте "
    10895                                       + buf_tax-rate-value.obj-type
    10896                                       + string(buf_tax-rate-value.obj-code)
    10897       .
    10898       assign
    10899           p-display-frame = no
    10900       .
    10901   end.
    10902   end.
    10903   end procedure.
    10904   PROCEDURE disable_UI :
    10905     HIDE FRAME frm.
    10906   END PROCEDURE.
    10907   PROCEDURE enable_UI :
    10908     ENABLE bt-close bt-form-goods-list bt-form-ovr-obj bt-form-ovr-obj-2 b-help
    10909            br-objects br-goods
    10910         WITH FRAME frm.
    10911     VIEW FRAME frm.
    10912     OPEN QUERY br-goods FOR EACH gds-list,        first buf_goods where buf_goods.gds-code = gds-list.gds-code.    OPEN QUERY br-objects FOR EACH obj-list.
    10913   END PROCEDURE.
    10914   PROCEDURE form-goods-list :
    10915   define input parameter p-obj-type       like ub.gds-obj.obj-type   no-undo.
    10916   define input parameter p-obj-code       like ub.gds-obj.obj-code   no-undo.
    10917   define input parameter p-empty-gds-list as char                 no-undo .
    10918   do
    10919   on error undo, return error
    10920   :
    10921   define variable v-today             as date                         no-undo .
    10922   define variable v-time              as integer                      no-undo .
    10923   define variable v-fact-order        like ub.tax-rate-gds.fact-order no-undo.
    10924   define buffer buf_tax-rate-gds       for ub.tax-rate-gds.
    10925   define buffer buf_new_tax-rate-gds   for ub.tax-rate-gds.
    10926   run waitfram-show ("Ждите подбор товаров...") .
    10927       if p-empty-gds-list <> "no-empty"
    10928       then do:
    10929           for each gds-list
    10930           :
    10931               delete gds-list.
    10932           end.
    10933       end.
    10934   define variable vss-include-info94 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10935   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
    10936     (input  p-obj-type
    10937     ,input  p-obj-code
    10938     ,output v-today
    10939     )  .
    10940       run factord-end-day in this-procedure ( input v-today, output v-fact-order ).
    10941       define buffer LAST_tax-rate-gds for ub.tax-rate-gds  .
    10942       define buffer x_tax-rate-gds for ub.tax-rate-gds  .
    10943       gds-obj-list-create:
    10944       for each buf_gds-obj no-lock
    10945          where buf_gds-obj.obj-type   = p-obj-type
    10946            and buf_gds-obj.obj-code   = p-obj-code
    10947            and buf_gds-obj.price-sale > 0 ,
    10948                first buf_goods no-lock where
    10949                       buf_goods.gds-code = buf_gds-obj.gds-code and
    10950                       buf_goods.stts = 0 ,
    10951               LAST X_tax-rate-gds NO-LOCK where
    10952                       X_tax-rate-gds.gds-code = buf_gds-obj.gds-code AND
    10953                       X_tax-rate-gds.tax-code = buf_tax-rate-value.tax-code AND
    10954                       X_tax-rate-gds.fact-order <= v-fact-order,
    10955                       first last_tax-rate-gds no-lock where
    10956                             recid(last_tax-rate-gds) = recid(x_tax-rate-gds) and
    10957                             last_tax-rate-gds.rate-code = buf_tax-rate-value.rate-code
    10958                             :
    10959           if buf_gds-obj.price-sale = ? or buf_gds-obj.price-sale = 0
    10960           then do:
    10961               next gds-obj-list-create.
    10962           end.
    10963           create gds-list.
    10964           assign
    10965               gds-list.gds-code   = buf_gds-obj.gds-code
    10966               gds-list.obj-type   = p-obj-type
    10967               gds-list.obj-code   = p-obj-code
    10968               gds-list.price-sale = buf_gds-obj.price-sale
    10969           .
    10970       end.
    10971   run waitfram-hide.
    10972   end.
    10973   END PROCEDURE.
    10974   PROCEDURE form-ovr-obj :
    10975   do
    10976   on error undo, return error
    10977   :
    10978   define variable  v-price-doc-recid   as recid                            no-undo.
    10979   define variable  v-update            as logical                          no-undo.
    10980   define variable  v-price-sale        like ub.price-list.price-sale       no-undo.
    10981   define variable  v-counter           as integer                          no-undo.
    10982   define buffer buf_price-doc        for ub.price-doc.
    10983   run form-goods-list in this-procedure (   input obj-list.obj-type
    10984                                           , input obj-list.obj-code
    10985                                           , input ""
    10986                                         ).
    10987   find first gds-list no-error.
    10988   if not available gds-list
    10989   then do:
    10990       message
    10991           "Нет товаров для ДНЦ на объекте"
    10992           skip obj-list.obj-type obj-list.obj-code
    10993       view-as alert-box.
    10994       undo, return error .
    10995   end.
    10996   for each x_obj-group : delete x_obj-group . end.
    10997   create x_obj-group.
    10998   buffer-copy obj-list to x_obj-group .
    10999   define variable vss-include-info95 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    11000   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
    11001     (input  obj-list.obj-type
    11002     ,input  obj-list.obj-code
    11003     ,output v-host-code
    11004     )  .
    11005     run chec-par in this-procedure (output l-ok , input v-host-code, input obj-list.obj-type,input obj-list.obj-code ) no-error .
    11006     If l-ok <> true or error-status :error
    11007     then do:
    11008         undo,return error return-value .
    11009     end.
    11010   run prcreate-new-price-doc in this-procedure ( input v-cntxt-db-num
    11011                                                , input obj-list.obj-type
    11012                                                , input obj-list.obj-code
    11013                                                , input ?
    11014                                                , input ?
    11015                                                , input ?
    11016                                                , input ?
    11017                                                , output v-price-doc-recid
    11018                                                ) no-error.
    11019   if error-status:error
    11020   then do:
    11021       return no-apply.
    11022   end.
    11023   else do:
    11024       find first buf_price-doc exclusive-lock
    11025            where recid( buf_price-doc ) = v-price-doc-recid
    11026       .
    11027           find first buf_price-doc-forming no-lock where
    11028                 buf_price-doc-forming.plt-id     = buf_price-doc.plt-id      and
    11029                 buf_price-doc-forming.plt-db-num = buf_price-doc.plt-db-num  and
    11030                 buf_price-doc-forming.pdf-id     = buf_price-doc.pdf-id      and
    11031                 buf_price-doc-forming.pdf-db     = buf_price-doc.pdf-db      no-error .
    11032   end.
    11033   assign
    11034       v-counter = 0
    11035   .
    11036   gds-list-line-create:
    11037   for each gds-list
    11038   :
    11039           assign
    11040               v-counter = v-counter + 1
    11041           .
    11042           run prcreate-new-price-doc-forming-gds in this-procedure (
    11043               input recid ( buf_price-doc-forming )
    11044             , input obj-list.obj-type
    11045             , input obj-list.obj-code
    11046             , input true
    11047             , input true
    11048             , input true
    11049             , input v-counter
    11050             , input gds-list.gds-code
    11051             , input gds-list.price-sale
    11052             ) no-error.
    11053       if error-status:error
    11054       then do:
    11055               assign
    11056                 v-counter = v-counter - 1
    11057               .
    11058           message
    11059               "Не удалось включить в ДНЦ товар:"
    11060               skip string(gds-list.gds-code)
    11061           view-as alert-box.
    11062           next gds-list-line-create.
    11063       end.
    11064   end.
    11065   if available buf_price-doc then do:
    11066      delete buf_price-doc.
    11067   end.
    11068   message
    11069       "Создан ДНЦ " string(buf_price-doc-forming.pdf-id)
    11070       skip "на объектe " obj-list.obj-type obj-list.obj-code
    11071       skip "Количество товаров в документе:"
    11072       skip string(v-counter)
    11073   view-as alert-box.
    11074   end.
    11075   END PROCEDURE.
    11076   PROCEDURE form-ovr-obj-2 :
    11077   do
    11078   on error undo, return error
    11079   :
    11080   define variable  v-price-doc-recid   as recid                            no-undo.
    11081   define variable  v-update            as logical                          no-undo.
    11082   define variable  v-price-sale        like ub.price-list.price-sale       no-undo.
    11083   define variable  v-counter           as integer                          no-undo.
    11084   define variable  v-end-message       as char       init ""               no-undo.
    11085   define buffer buf_price-doc        for ub.price-doc.
    11086   define buffer buf_obj-list         for obj-list.
    11087   run waitfram-show ("Ждите...") .
    11088   create-on-object:
    11089   for each buf_obj-list
    11090   :
    11091       for each x_obj-group : delete x_obj-group . end.
    11092       create x_obj-group.
    11093       buffer-copy buf_obj-list to x_obj-group .
    11094   define variable vss-include-info96 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    11095   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
    11096     (input  buf_obj-list.obj-type
    11097     ,input  buf_obj-list.obj-code
    11098     ,output v-host-code
    11099     )  .
    11100       run chec-par in this-procedure (output l-ok , input v-host-code, input obj-list.obj-type,input obj-list.obj-code ) no-error .
    11101       If l-ok <> true or error-status :error
    11102       then do:
    11103           undo,return error return-value .
    11104       end.
    11105       run form-goods-list in this-procedure (   input buf_obj-list.obj-type
    11106                                               , input buf_obj-list.obj-code
    11107                                               , input ""
    11108                                             ) no-error .
    11109                                             if error-status :error then message
    11110                                               vss-workfile vss-revision vss-description skip
    11111                                               error-status :get-message(1) skip
    11112                                               return-value skip
    11113                                               ""
    11114                                               view-as alert-box error
    11115                                             .
    11116       find first gds-list no-error.
    11117       if not available gds-list
    11118       then do:
    11119           assign
    11120               v-end-message = v-end-message + chr(10) + string(buf_obj-list.obj-type) + string(buf_obj-list.obj-code)
    11121               + chr(9) + "Нет товаров для ДНЦ"
    11122           .
    11123           next create-on-object.
    11124       end.
    11125       run waitfram-show  ( substitute("Создание ДНЦ для объекта  &1&2 " , buf_obj-list.obj-type ,buf_obj-list.obj-code)) .
    11126       run prcreate-new-price-doc in this-procedure
    11127           ( input v-cntxt-db-num
    11128           , input buf_obj-list.obj-type
    11129           , input buf_obj-list.obj-code
    11130           , input ?
    11131           , input ?
    11132           , input ?
    11133           , input ?
    11134           , output v-price-doc-recid
    11135           ) no-error.
    11136       if error-status:error
    11137       then do:
    11138           assign
    11139               v-end-message = v-end-message + chr(10) + string(buf_obj-list.obj-type) + string(buf_obj-list.obj-code)
    11140               + chr(9) + "Ошибка при создании документа"
    11141           .
    11142           next create-on-object.
    11143       end.
    11144       else do:
    11145           find first buf_price-doc exclusive-lock
    11146                where recid( buf_price-doc ) = v-price-doc-recid
    11147           .
    11148           find first buf_price-doc-forming no-lock where
    11149                 buf_price-doc-forming.plt-id     = buf_price-doc.plt-id      and
    11150                 buf_price-doc-forming.plt-db-num = buf_price-doc.plt-db-num  and
    11151                 buf_price-doc-forming.pdf-id     = buf_price-doc.pdf-id      and
    11152                 buf_price-doc-forming.pdf-db     = buf_price-doc.pdf-db      no-error .
    11153       end.
    11154       assign
    11155           v-counter = 0
    11156       .
    11157       gds-list-line-create:
    11158       for each gds-list
    11159       :
    11160           assign
    11161               v-counter = v-counter + 1
    11162           .
    11163           run prcreate-new-price-doc-forming-gds in this-procedure (
    11164               input recid ( buf_price-doc-forming )
    11165             , input buf_obj-list.obj-type
    11166             , input buf_obj-list.obj-code
    11167             , input par-pr-notls
    11168             , input par-pr-altex
    11169             , input par-pr-sclex
    11170             , input v-counter
    11171             , input gds-list.gds-code
    11172             , input gds-list.price-sale
    11173             ) no-error.
    11174           if error-status:error
    11175           then do:
    11176              message
    11177                vss-workfile vss-revision vss-description skip
    11178                error-status :get-message(1) skip
    11179                return-value skip
    11180                "1"
    11181                view-as alert-box error
    11182              .
    11183               assign
    11184                 v-counter = v-counter - 1
    11185               .
    11186               message
    11187                   "Не удалось включить в ДНЦ товар: "
    11188                   skip string(gds-list.gds-code)
    11189               view-as alert-box title "ДНЦ № " + string(buf_price-doc-forming.pdf-id)  + " на объекте "
    11190                                                     + string(buf_obj-list.obj-type) + string(buf_obj-list.obj-code)
    11191               .
    11192               next gds-list-line-create.
    11193           end.
    11194       end.
    11195       if available buf_price-doc then do:
    11196          delete buf_price-doc.
    11197       end.
    11198       assign
    11199           v-end-message = v-end-message + chr(10) + string(buf_obj-list.obj-type) + string(buf_obj-list.obj-code)
    11200           + chr(9) + string(buf_price-doc-forming.pdf-id) + chr(9) + string(v-counter) + " товаров" + chr(10)
    11201       .
    11202   end.
    11203   run waitfram-hide .
    11204   message
    11205       "Созданы новые ДНЦ: "
    11206       skip v-end-message
    11207   view-as alert-box title "ДНЦ на объектах".
    11208   end.
    11209   END PROCEDURE.
    11210   PROCEDURE process-bt-export :
    11211   do
    11212   on error undo, return error
    11213   :
    11214   define input parameter p-save-option as character no-undo.
    11215   define variable  v-log       as logical no-undo.
    11216   define variable  v-file-name as char no-undo.
    11217   case p-save-option:
    11218       when "obj-list":U
    11219       then do:
    11220           assign
    11221             v-file-name = "objects.txt"
    11222             v-log = yes
    11223           .
    11224           system-dialog get-file v-file-name
    11225             filters "Список объектов *.txt" "*.txt"
    11226             ask-overwrite
    11227             save-as
    11228             use-filename
    11229             update v-log
    11230             default-extension "txt".
    11231           if not v-log then do:
    11232             return no-apply.
    11233           end.
    11234           output to value (v-file-name).
    11235           for each obj-list:
    11236               export obj-list.
    11237           end.
    11238           output close.
    11239       end.
    11240       when "gds-list":U
    11241       then do:
    11242           assign
    11243             v-file-name = "goods.txt"
    11244             v-log = yes
    11245           .
    11246           system-dialog get-file v-file-name
    11247             filters "Список товаров *.txt" "*.txt"
    11248             ask-overwrite
    11249             save-as
    11250             use-filename
    11251             update v-log
    11252             default-extension "txt".
    11253           if not v-log then do:
    11254             return no-apply.
    11255           end.
    11256           output to value (v-file-name).
    11257           for each obj-list
    11258           break by obj-list.obj-type
    11259                 by obj-list.obj-code
    11260           :
    11261               if first ( obj-list.obj-code )
    11262               then do:
    11263                   run form-goods-list in this-procedure ( input obj-list.obj-type,
    11264                                                           input obj-list.obj-code,
    11265                                                           input ""
    11266                                                       ).
    11267               end.
    11268               else do:
    11269                   run form-goods-list in this-procedure ( input obj-list.obj-type,
    11270                                                           input obj-list.obj-code,
    11271                                                           input "no-empty"
    11272                                                       ).
    11273               end.
    11274           end.
    11275           for each gds-list
    11276           break by gds-list.gds-code
    11277           :
    11278               if first-of ( gds-list.gds-code )
    11279               then do:
    11280                   find first buf_goods no-lock
    11281                        where buf_goods.gds-code = gds-list.gds-code
    11282                   .
    11283                   display gds-list.gds-code buf_goods.gds-name.
    11284               end.
    11285           end.
    11286       end.
    11287   end case.
    11288   output close.
    11289   end.
    11290   END PROCEDURE.
