     4833     if available buf_price-doc-forming then do:
     4834        find first buf_price-list-type no-lock where
     4835                   buf_price-list-type.plt-id     = buf_price-doc-forming.plt-id    and
     4836                   buf_price-list-type.plt-db-num = buf_price-doc-forming.plt-db-num
     4837                   no-error .
