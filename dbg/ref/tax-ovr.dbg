     9781           and can-query(v-object-handle, "row")
     9782           and can-query(v-object-handle, "height")
     9783           and ( v-object-handle :row > v-diasize-browse-handle :row )
     9784           then do:
     9785             find first buf_temp-browse-handle
     9786               where buf_temp-browse-handle.browse-type   = 'height':u
     9787                 and buf_temp-browse-handle.browse-handle = v-object-handle
     9788               no-error .
     9789             if available buf_temp-browse-handle
     9790             then do:
     9791             end.
     9792             else do:
     9793               create buf_temp-diasize-handle .
     9794               assign
     9795                 buf_temp-diasize-handle.handle-value  = v-object-handle
     9796                 buf_temp-diasize-handle.save-position = v-object-handle :row
     9797               .
     9798             end.
     9799           end.
     9800           assign
     9801             v-object-handle = v-object-handle :next-sibling
     9802           .
     9803         end.
