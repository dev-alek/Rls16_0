     1883   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1884   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1885   DEFINE VARIABLE v-S_CONTRACT               AS CHARACTER NO-UNDO INITIAL "".
     1886   DEFINE VARIABLE v-S_CODE_LAST_MASTER_NUM   AS CHARACTER NO-UNDO INITIAL "".
     1887   DEFINE VARIABLE v-DELIM_CHR_3              AS CHARACTER NO-UNDO INITIAL "".
     1888   ASSIGN
     1889      v-S_CONTRACT                = "Contract":U
     1890      v-S_CODE_LAST_MASTER_NUM    = "LastMasterNum":U
     1891      v-DELIM_CHR_3               = ","
     1892      .
     1893   DEFINE VARIABLE i-gl-Host-Code      AS INTEGER NO-UNDO INITIAL 0.
     1894   DEFINE VARIABLE i-gl-Contract-Code  AS INTEGER NO-UNDO INITIAL 0.
     1895   DEFINE VARIABLE i-gl-Extent3        AS INTEGER NO-UNDO INITIAL 0 EXTENT 3.
     1896   FUNCTION Can-Find-Spec RETURN LOGICAL (
     1897      INPUT iHost-Code    AS INTEGER,
     1898      INPUT iContract-Num AS INTEGER,
     1899      INPUT iGds-Code     AS INTEGER ):
     1900      DEFINE BUFFER buf_Spec FOR ub.Contract-Specif.
     1901      DEFINE VARIABLE iTmp-Host-Code     AS INTEGER NO-UNDO INITIAL 0.
     1902      DEFINE VARIABLE iTmp-Contract-Num  AS INTEGER NO-UNDO INITIAL 0.
     1903      DEFINE VARIABLE iTmp-Extent3       AS INTEGER NO-UNDO INITIAL 0 EXTENT 3.
     1904      DEFINE VARIABLE lRet               AS LOGICAL NO-UNDO INITIAL FALSE.
     1905      RUN MS-Contract-EXTENT-3 IN THIS-PROCEDURE(
     1906          INPUT  iHost-Code,
     1907          INPUT  iContract-Num,
     1908          OUTPUT iTmp-Extent3
     1909          ).
     1910      IF iTmp-Extent3[1] = 2 THEN DO:
     1911         ASSIGN
     1912            iTmp-Host-Code      = iTmp-Extent3[2]
     1913            iTmp-Contract-Num   = iTmp-Extent3[3]
     1914            .
     1915      END. ELSE DO:
     1916         ASSIGN
     1917            iTmp-Host-Code      = iHost-Code
     1918            iTmp-Contract-Num   = iContract-Num
     1919            .
     1920      END.
     1921      IF iGds-Code = ? THEN DO:
     1922         ASSIGN
     1923            lRet = CAN-FIND(FIRST buf_Spec NO-LOCK WHERE
     1924                                  buf_Spec.Host-Code     = iTmp-Host-Code
     1925                              AND buf_Spec.Contract-Num  = iTmp-Contract-Num
     1926                           ).
     1927      END. ELSE DO:
     1928            lRet = CAN-FIND(FIRST buf_Spec NO-LOCK WHERE
     1929                                  buf_Spec.Host-Code     = iTmp-Host-Code
     1930                              AND buf_Spec.Contract-Num  = iTmp-Contract-Num
     1931                              AND buf_Spec.Gds-Code      = iGds-Code
     1932                            ).
     1933      END.
     1934      RETURN (lRet).
     1935   END FUNCTION.
     1936   PROCEDURE MS-Contract-EXTENT-3:
     1937      DEFINE INPUT  PARAMETER i-Host-Code     AS INTEGER NO-UNDO.
     1938      DEFINE INPUT  PARAMETER i-Contract-Code AS INTEGER NO-UNDO.
     1939      DEFINE OUTPUT PARAMETER i-Ret           AS INTEGER NO-UNDO EXTENT 3 INITIAL 0.
     1940      DEFINE BUFFER buf_Ext-Classif FOR ub.Ext-Classif.
     1941      DEFINE BUFFER buf_Cont        FOR ub.Contract.
     1942      DEFINE BUFFER buf_Cont-2      FOR ub.Contract.
     1943      FIND FIRST buf_Cont-2 WHERE
     1944                 buf_Cont-2.Host-Code      = i-Host-Code
     1945             AND buf_Cont-2.Contract-Code  = i-Contract-Code
     1946           NO-LOCK NO-ERROR.
     1947      IF NOT AVAILABLE buf_Cont-2 THEN DO:
     1948         RETURN.
     1949      END.
     1950      FOR FIRST buf_Ext-Classif WHERE
     1951                buf_Ext-Classif.Classif-name = v-S_CONTRACT
     1952           AND  buf_Ext-Classif.CharKey_One  = STRING(i-Host-code) + v-DELIM_CHR_3 +
     1953                                               STRING(i-Contract-code)
     1954           AND  buf_Ext-classif.db-num       = buf_Cont-2.Db-num
     1955          NO-LOCK,
     1956          EACH buf_Cont WHERE
     1957               buf_Cont.Host-code     = INTEGER(ENTRY(1, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3 ))
     1958           AND buf_Cont.Contract-code = INTEGER(ENTRY(2, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3))
     1959          NO-LOCK:
     1960          ASSIGN
     1961             i-Ret[1] = 1
     1962             i-Ret[2] = buf_Cont.Host-code
     1963             i-Ret[3] = buf_Cont.Contract-code
     1964             .
     1965          LEAVE.
     1966      END.
     1967      IF i-Ret[1] <> 1 THEN DO:
     1968         FOR FIRST buf_Ext-Classif WHERE
     1969                   buf_Ext-Classif.Classif-name = v-S_CONTRACT
     1970              AND  buf_Ext-Classif.CharKey_Two  = STRING(i-Host-code) + v-DELIM_CHR_3 +
     1971                                                  STRING(i-Contract-code)
     1972              AND  buf_Ext-classif.db-num       = buf_Cont-2.Db-num
     1973             NO-LOCK,
     1974             EACH buf_Cont WHERE
     1975                  buf_Cont.Host-code     = INTEGER(ENTRY(1, buf_Ext-classif.charKey_One, v-DELIM_CHR_3))
     1976              AND buf_Cont.Contract-code = INTEGER(ENTRY(2, buf_Ext-classif.charKey_One, v-DELIM_CHR_3))
     1977             NO-LOCK:
     1978             ASSIGN
     1979                i-Ret[1] = 2
     1980                i-Ret[2] = buf_Cont.Host-code
     1981                i-Ret[3] = buf_Cont.Contract-code
     1982                .
     1983             LEAVE.
     1984         END.
     1985      END.
     1986      RETURN.
     1987   END PROCEDURE.
