     1538     :
     1539   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1540   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rbisbase in g#library
     1541     (output v-base
     1542     )  .
     1543   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1544   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1545     (input  p-obj-type
     1546     ,input  p-obj-code
     1547     ,output v-host-code
     1548     )  .
     1549   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1550   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run baserate in g#library
     1551     (input  v-host-code
     1552     ,input  today
     1553     ,output v-base-rate
     1554     ,output v-base-scale
     1555     )  .
     1556   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1557   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gtplobj in g#library2
     1558     (input  ?
     1559     ,input  p-obj-type
     1560     ,input  p-obj-code
     1561     ,input  yes
     1562     ,output p-plt-id
     1563     ,output p-plt-db-num
     1564     )  .
     1565      create ub.price-doc-forming.
     1566      assign
     1567         ub.price-doc-forming.plt-id       = p-plt-id
     1568         ub.price-doc-forming.plt-db-num   = p-plt-db-num
     1569         ub.price-doc-forming.pdf-id       = next-value ( s-pdf , ub)
     1570         ub.price-doc-forming.pdf-db       = v-cntxt-db-num
     1571         ub.price-doc-forming.base-rate    = v-base-rate
     1572         ub.price-doc-forming.base-scale   = v-base-scale
     1573         ub.price-doc-forming.db-num-chg   = v-cntxt-db-num
     1574         ub.price-doc-forming.exch-rate    = if v-base then v-base-rate else 1
     1575         ub.price-doc-forming.exch-scale   = if v-base then v-base-scale else 1
     1576         ub.price-doc-forming.stts         = 0
     1577         ub.price-doc-forming.sys-date     = today
     1578         ub.price-doc-forming.sys-time     = time
     1579         ub.price-doc-forming.sys-time-chr = string ( ub.price-doc-forming.sys-time , "hh:mm" )
     1580         ub.price-doc-forming.who          = v-cntxt-userid
     1581         ub.price-doc-forming.name         = "автосоздание"
     1582      .
     1583      assign
     1584       p-pdf-db-num  = ub.price-doc-forming.pdf-db
     1585       p-pdf-id      = ub.price-doc-forming.pdf-id
     1586       p-plt-db-num  = ub.price-doc-forming.plt-db-num
     1587       p-plt-id      = ub.price-doc-forming.plt-id
     1588      .
     1589     end.
     1590   end procedure.
     1591   procedure prcreate-new-price-doc-forming-gds :
     1592   define input  parameter p-price-doc-forming-recid as recid  no-undo.
     1593   define input  parameter p-obj-type   as character no-undo .
     1594   define input  parameter p-obj-code   as integer   no-undo .
     1595   define input  parameter par-pr-notls as character no-undo .
     1596   define input  parameter par-pr-altex as character no-undo .
     1597   define input  parameter par-pr-sclex as character no-undo .
     1598   define input  parameter p-line-num    as integer   no-undo .
     1599   define input  parameter p-gds-code    as integer   no-undo .
     1600   define input  parameter p-price-sale  as decimal   no-undo .
     1601   define buffer buf_price-doc-forming for ub.price-doc-forming  .
     1602   define buffer buf_goods for ub.goods  .
     1603   define buffer buf_bar-code for ub.bar-code  .
     1604   define buffer main_bar-code for ub.bar-code  .
     1605   define variable main-b-code as integer   no-undo .
     1606   define variable v-sec as integer   no-undo .
     1607     do
     1608     on error undo, return error return-value
     1609     :
     1610   define variable v-cur-dn as character no-undo .
     1611   define variable v-cur-pr as decimal   no-undo .
     1612   define variable v-cur-rt as decimal   no-undo .
     1613   define variable v-cur-ex as decimal   no-undo .
     1614   find first buf_price-doc-forming no-lock where
     1615              recid(buf_price-doc-forming) = p-price-doc-forming-recid  no-error .
     1616              if error-status :error then return error .
     1617   find first buf_goods no-lock where
     1618              buf_goods.gds-code  = p-gds-code no-error .
     1619              if error-status :error then return error .
     1620   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     1621     (input  buf_goods.gds-code
     1622     ,input  ?
     1623     ,output main-b-code
     1624     ) no-error .
     1625   run check-use-bar-code (main-b-code) no-error .
     1626   if error-status :error then return .
     1627   run create-line-pdf-mpl-lib (
     1628        input buf_price-doc-forming.plt-db-num
     1629       ,input buf_price-doc-forming.plt-id
     1630       ,input buf_price-doc-forming.pdf-db
     1631       ,input buf_price-doc-forming.pdf-id
     1632       ,input p-line-num
     1633       ,input main-b-code
     1634       ,input buf_goods.artic
     1635       ,input buf_goods.prod-type
     1636       ,input buf_goods.prod-code
     1637       ,input ""
     1638       ,input 0
     1639       ,input p-price-sale
     1640       ,input ""
     1641       ,input 0
     1642      ,input-output v-sec ) no-error .
     1643      if error-status :error  then do:
     1644        message
     1645          vss-workfile vss-revision vss-description skip
     1646          error-status :get-message(1) skip
     1647          return-value skip
     1648          "2"
     1649          view-as alert-box error
     1650        .
     1651      end.
     1652   define buffer old_price-list for ub.price-list  .
     1653   if par-pr-notls = "yes" then do:
     1654   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1655   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     1656     (input  p-obj-type
     1657     ,input  p-obj-code
     1658     ,input  main-b-code
     1659     ,input  0
     1660     ,input  0
     1661     ,output v-cur-dn
     1662     ,output v-cur-pr
     1663     ,output v-cur-rt
     1664     ,output v-cur-ex
     1665     )  .
     1666   end.
     1667   if par-pr-altex = "yes" and
     1668      par-pr-notls = "yes" then do:
     1669       if v-cur-dn <> "" then do:
     1670           for each old_price-list no-lock where
     1671                    old_price-list.doc-num = v-cur-dn and
     1672                    old_price-list.artic      = buf_goods.artic and
     1673                    old_price-list.prod-type  = buf_goods.prod-type and
     1674                    old_price-list.prod-code  = buf_goods.prod-code and
     1675                    old_price-list.main-price = no,
     1676                   first buf_bar-code no-lock where
     1677                         buf_bar-code.b-code   = old_price-list.b-code and
     1678                         buf_bar-code.unit-cli <> buf_goods.unit-base
     1679                         :
     1680                          run check-use-bar-code (buf_bar-code.b-code) no-error .
     1681                          if error-status :error then next.
     1682                    run create-line-pdf-mpl-lib (
     1683                          input buf_price-doc-forming.plt-db-num
     1684                         ,input buf_price-doc-forming.plt-id
     1685                         ,input buf_price-doc-forming.pdf-db
     1686                         ,input buf_price-doc-forming.pdf-id
     1687                         ,input p-line-num
     1688                         ,input old_price-list.b-code
     1689                         ,input buf_goods.artic
     1690                         ,input buf_goods.prod-type
     1691                         ,input buf_goods.prod-code
     1692                         ,input ""
     1693                         ,input 0
     1694                         ,input old_price-list.price-sale
     1695                         ,input ""
     1696                         ,input 0
     1697                        ,input-output v-sec ) no-error .
     1698           end.
     1699       end.
     1700   end.
     1701   if par-pr-sclex = "yes" and
     1702      par-pr-notls = "yes" then do:
     1703       if v-cur-dn <> "" then do:
     1704           for each old_price-list no-lock where
     1705                    old_price-list.doc-num    = v-cur-dn and
     1706                    old_price-list.artic      = buf_goods.artic and
     1707                    old_price-list.prod-type  = buf_goods.prod-type and
     1708                    old_price-list.prod-code  = buf_goods.prod-code and
     1709                    old_price-list.main-price = no,
     1710                   first buf_bar-code no-lock where
     1711                         buf_bar-code.b-code   = old_price-list.b-code and
     1712                         buf_bar-code.in-code  = "" and
     1713                         buf_bar-code.unit-cli = buf_goods.unit-base
     1714                         :
     1715                          run check-use-bar-code (buf_bar-code.b-code) no-error .
     1716                          if error-status :error then next.
     1717                    run create-line-pdf-mpl-lib (
     1718                          input buf_price-doc-forming.plt-db-num
     1719                         ,input buf_price-doc-forming.plt-id
     1720                         ,input buf_price-doc-forming.pdf-db
     1721                         ,input buf_price-doc-forming.pdf-id
     1722                         ,input p-line-num
     1723                         ,input old_price-list.b-code
     1724                         ,input buf_goods.artic
     1725                         ,input buf_goods.prod-type
     1726                         ,input buf_goods.prod-code
     1727                         ,input ""
     1728                         ,input 0
     1729                         ,input old_price-list.price-sale
     1730                         ,input ""
     1731                         ,input 0
     1732                       ,input-output v-sec ) no-error .
     1733           end.
     1734       end.
     1735   end.
     1736   end.
     1737   end procedure.
     1738   procedure copy_new_price-doc-forming :
     1739   define input  parameter       p-recid      as recid no-undo .
     1740   define input-output parameter p-plt-db-num as integer   no-undo .
     1741   define input-output parameter p-plt-id     as integer   no-undo .
     1742   define output parameter       p-pdf-db-num as integer   no-undo .
     1743   define output parameter       p-pdf-id     as integer   no-undo .
     1744   define buffer buf_price-list-type        for ub.price-list-type  .
     1745   define buffer buf_price-doc-forming      for ub.price-doc-forming .
     1746   define buffer buf_price-doc-forming-attr for ub.price-doc-forming-attr .
     1747   define buffer buf_price-doc-forming-gds  for ub.price-doc-forming-gds .
     1748   define buffer buf_pd-forming-gds-attr    for ub.price-doc-forming-gdsattr .
     1749   define variable v-host-code  as integer   no-undo .
     1750   define variable v-base-rate  as decimal   no-undo .
     1751   define variable v-base-scale as integer   no-undo .
     1752   define variable v-exch-rate  as decimal   no-undo .
     1753   define variable v-exch-scale as integer   no-undo .
     1754   define variable v-base as logical   no-undo .
     1755   define variable v-name as character no-undo .
     1756     do
     1757     on error undo, return error return-value
     1758     :
     1759   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1760   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rbisbase in g#library
     1761     (output v-base
     1762     )  .
     1763   find first buf_price-list-type no-lock where
     1764              buf_price-list-type.plt-db-num = p-plt-db-num and
     1765              buf_price-list-type.plt-id     = p-plt-id no-error .
     1766   if error-status :error then return error "Не найден ТПЛ".
     1767   if buf_price-list-type.stts <> 0 then return error "ТПЛ удален" .
     1768   find first buf_price-doc-forming  no-lock where recid(buf_price-doc-forming )  = p-recid no-error .
     1769       if available buf_price-doc-forming then do :
     1770           assign
     1771             v-base-rate  = buf_price-doc-forming.base-rate
     1772             v-base-scale = buf_price-doc-forming.base-scale
     1773             v-name       =  substitute("Скопировано с ДНЦ &1 &2",  buf_price-doc-forming.pdf-id , trim(buf_price-doc-forming.name)  )
     1774           .
     1775       end.
     1776       else do:
     1777           assign
     1778             v-base-rate  = 1
     1779             v-base-scale = 1
     1780             v-name       = "Автосоздание"
     1781           .
     1782       end.
     1783      create ub.price-doc-forming.
     1784      assign
     1785         ub.price-doc-forming.plt-id       = p-plt-id
     1786         ub.price-doc-forming.plt-db-num   = p-plt-db-num
     1787         ub.price-doc-forming.pdf-id       = next-value ( s-pdf , ub)
     1788         ub.price-doc-forming.pdf-db       = v-cntxt-db-num
     1789         ub.price-doc-forming.base-rate    = v-base-rate
     1790         ub.price-doc-forming.base-scale   = v-base-scale
     1791         ub.price-doc-forming.db-num-chg   = v-cntxt-db-num
     1792         ub.price-doc-forming.exch-rate    = if v-base then v-base-rate else 1
     1793         ub.price-doc-forming.exch-scale   = if v-base then v-base-scale else 1
     1794         ub.price-doc-forming.stts         = 0
     1795         ub.price-doc-forming.sys-date     = today
     1796         ub.price-doc-forming.sys-time     = time
     1797         ub.price-doc-forming.sys-time-chr = string ( ub.price-doc-forming.sys-time , "hh:mm" )
     1798         ub.price-doc-forming.who          = v-cntxt-userid
     1799         ub.price-doc-forming.name         = v-name
     1800      .
     1801      assign
     1802       p-pdf-db-num  = ub.price-doc-forming.pdf-db
     1803       p-pdf-id      = ub.price-doc-forming.pdf-id
     1804       p-plt-db-num  = ub.price-doc-forming.plt-db-num
     1805       p-plt-id      = ub.price-doc-forming.plt-id
     1806      .
     1807     end.
     1808     if not available buf_price-doc-forming then return .
     1809   for each buf_price-doc-forming-attr no-lock where
     1810            buf_price-doc-forming-attr.pdf-db      = buf_price-doc-forming.pdf-db       and
     1811            buf_price-doc-forming-attr.pdf-id      = buf_price-doc-forming.pdf-id       and
     1812            buf_price-doc-forming-attr.plt-db-num  = buf_price-doc-forming.plt-db-num   and
     1813            buf_price-doc-forming-attr.plt-id      = buf_price-doc-forming.plt-id       :
     1814       create ub.price-doc-forming-attr.
     1815       buffer-copy buf_price-doc-forming-attr to ub.price-doc-forming-attr
     1816       assign
     1817         ub.price-doc-forming-attr.plt-db-num  = p-plt-db-num
     1818         ub.price-doc-forming-attr.plt-id      = p-plt-id
     1819         ub.price-doc-forming-attr.pdf-db     = p-pdf-db-num
     1820         ub.price-doc-forming-attr.pdf-id      = p-pdf-id
     1821         .
     1822   end.
     1823   for each buf_price-doc-forming-gds no-lock where
     1824            buf_price-doc-forming-gds.pdf-db      = buf_price-doc-forming.pdf-db       and
     1825            buf_price-doc-forming-gds.pdf-id      = buf_price-doc-forming.pdf-id       and
