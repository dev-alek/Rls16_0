     8407           other-rubl-loc      = if b_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.other-rubl     * in-vatp-parts.fact-qnty) / b_doc-line.fact-qnty  else 0
     8408                                           vat-base-loc        = if b_doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))) / b_doc-line.fact-qnty   else 0
     8409           slt-base-loc        = if b_doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))) / b_doc-line.fact-qnty   else 0
     8410                   vat-rubl-loc        = if b_doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))) / b_doc-line.fact-qnty   else 0
     8411           slt-rubl-loc        = if b_doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))) / b_doc-line.fact-qnty   else 0
     8412           vat-pc-loc          = (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))) / (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  / (100 + in-vatp-parts.vat-pc)))
     8413           slt-pc-loc          = (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))) / (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                      / (100 + in-vatp-parts.slt-pc))).
     8414         if road-tax-base-loc  = ? then road-tax-base-loc  = 0.
     8415         if road-tax-rubl-loc  = ? then road-tax-rubl-loc  = 0.
     8416         if transport-base-loc = ? then transport-base-loc = 0.
     8417         if transport-rubl-loc = ? then transport-rubl-loc = 0.
     8418         if other-base-loc     = ? then other-base-loc     = 0.
     8419         if other-rubl-loc     = ? then other-rubl-loc     = 0.
     8420         assign
     8421           transport-cli-loc      = 0
     8422           other-cli-loc          = 0
     8423           road-tax-cli-loc       = ?
     8424           vat-cli-loc            = ?
     8425           slt-cli-loc            = ?
     8426           price-cli-with-tax-loc = ?.
     8427      end.
     8428   ASSIGN
     8429             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     8430       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     8431   .
     8432                if var-pr-r-b = "rubl" then
     8433                    s-cost = price-rubl-with-tax-loc.
     8434                  else
     8435                    s-cost = price-base-with-tax-loc.
     8436                s-qnty = b_doc-line.fact-qnty .
     8437              end.
     8438              else do:
     8439                assign
     8440                 s-cost = 0
     8441                 s-qnty = 0
     8442                .
     8443              end.
     8444              l_price  =  (f-cost * f-qnty + s-cost * s-qnty ) / (f-qnty + s-qnty)  .
     8445           end.
     8446           when "cost-vat":u then do:
     8447                run str/gdsnovat.p ('Уч+накл-НДС':U,
     8448                        b_trn-doc.obj-type,
     8449                        b_trn-doc.obj-code,
     8450                        b_trn-doc.host-code,
     8451                        b_doc-line.artic,
     8452                        b_doc-line.prod-type,
     8453                        b_doc-line.prod-code,
     8454                        0 ,
     8455                        b_doc-line.doc-code,
     8456                        ?,
     8457                        ?,
     8458                        output cost-base   ,
     8459                        output cost-rubl   ,
     8460                        output v-price-base  ,
     8461                        output v-price-rubl  ,
     8462                        output cur-rt-base ,
     8463                        output cur-rt-rubl ).
     8464                        if var-pr-r-b = "rubl"
     8465                           then l_price = v-price-rubl.
     8466                           else l_price = v-price-base.
     8467           end.
     8468           when "sale":u then do:
     8469                 l_price = ( if var-pr-r-b = "rubl"
     8470                                then b_doc-line.price-rubl
     8471                                else b_doc-line.price-base ).
     8472           end.
     8473           when "prod":u then do:
     8474   define variable vss-include-info80 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8475   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run proprice in g#library
     8476   (  input  b_price-doc-forming-gds.b-code
     8477    , input  p-obj-type
     8478    , input  p-obj-code
     8479    , output l_pricewithoutvat
     8480    , output l_price
     8481    , output l_prod-vat
     8482    , output v-str2
     8483    , output v-str2
     8484           )  .
     8485       end.
     8486      when "prod-vat":u then do:
     8487   define variable vss-include-info81 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8488   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run proprice in g#library
     8489   (  input  b_price-doc-forming-gds.b-code
     8490    , input  p-obj-type
     8491    , input  p-obj-code
     8492    , output l_price
     8493    , output l_pricewithvat
     8494    , output l_prod-vat
     8495    , output v-str2
     8496    , output v-str2
     8497           )  .
     8498       end.
     8499         end case.
     8500           tt-price-sale = b_price-doc-forming-gds.price-sale-rubl .
     8501           t-prc = (( tt-price-sale /  v-koff ) / l_price - 1) * 100.
     8502      end.
     8503   end.
     8504     if  p-prc-max <> ? then do:
     8505       if  t-prc <> ? and ( p-prc-max < t-prc  or p-prc-min > t-prc)
     8506       then do:
     8507         message (if v-main-b-code = b_price-doc-forming-gds.b-code then "По товару :"
     8508             else "По признаку"  )
     8509             b_price-doc-forming-gds.artic
     8510             b_price-doc-forming-gds.prod-type
     8511             b_price-doc-forming-gds.prod-code skip
     8512             "бар-код: " b_price-doc-forming-gds.b-code
     8513              ( if v-koff > 1 then substitute("Упаковка на: &1" , v-koff)
     8514                else "" ) skip
     8515             fnc-pr  (buffer b_price-doc-forming-gds)
     8516             skip
     8517           "Процент торговой наценки вышел за интервал возможных значений !!! " skip
     8518           "Процент не менее :" p-prc-min "%" skip
     8519           "Процент не более :" p-prc-max "%" skip
     8520           "Процент фактический :" t-prc  "%"  skip
     8521           "ДНЦ №: " b_price-doc-forming-gds.pdf-id         skip
     8522           "БД" b_price-doc-forming-gds.pdf-db
     8523             view-as alert-box error .
     8524                 p-err = true .
     8525                 undo , return error .
     8526       end.
     8527       else do:
     8528          if  t-prc = ? then  do:
     8529             message (if v-main-b-code = b_price-doc-forming-gds.b-code then "По товару :"
     8530             else "По признаку"  )
     8531             b_price-doc-forming-gds.artic
     8532             b_price-doc-forming-gds.prod-type
     8533             b_price-doc-forming-gds.prod-code skip
     8534             "бар-код: " b_price-doc-forming-gds.b-code
     8535              ( if v-koff > 1 then substitute("Упаковка на: &1" , v-koff)
     8536                else "" ) skip
     8537             fnc-pr  (buffer b_price-doc-forming-gds)
     8538             skip
     8539             "Нет базовой цены для расчета процента наценки !" skip
     8540             "Процент торговой наценки вышел за интервал возможных значений !!! " skip
     8541             "Процент не менее :" p-prc-min "%" skip
     8542             "Процент не более :" p-prc-max "%" skip
     8543             "Процент фактический :" t-prc  "%"  skip
     8544             "ДНЦ №_: " b_price-doc-forming-gds.pdf-id         skip
     8545             "БД" b_price-doc-forming-gds.pdf-db
     8546             view-as alert-box error .
     8547             p-err = true .
     8548             undo , return error .
     8549          end.
     8550       end.
     8551     end.
     8552   end.
     8553     end.
     8554   end procedure.
     8555   procedure del-doc-line :
     8556   define input  parameter p-recid as recid no-undo .
     8557     do
     8558     on error undo, return error return-value
     8559     :
     8560     find first ub.price-doc-forming-gds exclusive-lock where
     8561          recid ( ub.price-doc-forming-gds ) = p-recid  no-error .
     8562      if available ub.price-doc-forming-gds then do:
     8563         delete ub.price-doc-forming-gds no-error .
     8564      end.
     8565     end.
     8566   end procedure.
     8567   def var vss-include-info82 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8568   procedure check-use-bar-code :
     8569     define input  parameter p-b-code    like ub.bar-code.b-code no-undo .
     8570     do
     8571     on error  undo, return error substitute( "&1. &2&3&4", vss-include-info82, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     8572     on stop   undo, return error substitute( "&1. stop", vss-include-info82 )
     8573     on endkey undo, return error substitute( "&1. endkey", vss-include-info82 )
     8574     :
     8575       define buffer buf_bar-code for ub.bar-code .
     8576       find first buf_bar-code no-lock
     8577         where buf_bar-code.b-code     = p-b-code
     8578         no-error .
     8579       if not available buf_bar-code then do:
     8580         return error substitute( "&1 (check-use-bar-code). Не найден бар-код &2", vss-include-info82, p-b-code ) .
     8581       end.
     8582       if buf_bar-code.stts = integer('99':U) then do:
     8583         return error substitute( "&1 (check-use-bar-code). Нельзя использовать бар-код &2&3"
     8584                                 + "Выполняется удаление бар-кода"
     8585                                 ,vss-include-info82
     8586                                 ,p-b-code
     8587                                 ,chr(10)
     8588                               ) .
     8589       end.
     8590       if buf_bar-code.stts = integer('79':U) then do:
     8591         return error substitute( "&1 (check-use-bar-code). Нельзя использовать бар-код &2&3"
     8592                                 + "Бар-код выключен"
     8593                                 ,vss-include-info82
     8594                                 ,p-b-code
     8595                                 ,chr(10)
     8596                               ) .
     8597       end.
     8598       return .
     8599     end.
     8600   end procedure.
     8601   define variable vss-include-info83 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8602   procedure last-incom-S :
     8603   define input parameter  p-artic      like ub.gds-obj.artic      no-undo .
     8604   define input parameter  p-prod-type  like ub.gds-obj.prod-type  no-undo .
     8605   define input parameter  p-prod-code  like ub.gds-obj.prod-code  no-undo .
     8606   define output parameter p-in-code   as character no-undo .
     8607   define output parameter p-obj-type  as character no-undo .
     8608   define output parameter p-obj-code  as integer   no-undo .
     8609     do
     8610     on error undo, return error return-value
     8611     :
     8612     define buffer buf_trn-doc for ub.trn-doc .
     8613     define buffer buf_gds-obj for ub.gds-obj  .
     8614     do
     8615     on error undo, return error
     8616     :
     8617       assign
     8618         p-in-code  = ""
     8619         p-obj-type = ""
     8620         p-obj-code = 0
     8621       .
     8622        for each x_obj-group ,
     8623         each buf_gds-obj no-lock
     8624         where buf_gds-obj.obj-type  = x_obj-group.obj-type
     8625           and buf_gds-obj.obj-code  = x_obj-group.obj-code
     8626           and buf_gds-obj.artic     = p-artic
     8627           and buf_gds-obj.prod-type = p-prod-type
     8628           and buf_gds-obj.prod-code = p-prod-code
     8629       , first buf_trn-doc no-lock
     8630         where buf_trn-doc.doc-code = buf_gds-obj.in-code
     8631           and buf_trn-doc.status_  = 'факт':U
     8632       on error undo, return error
     8633       by buf_trn-doc.fact-order descending
     8634       :
     8635         assign
     8636           p-in-code  = buf_gds-obj.in-code
     8637           p-obj-type = buf_gds-obj.obj-type
     8638           p-obj-code = buf_gds-obj.obj-code
     8639         .
     8640         leave .
     8641       end.
     8642     end.
     8643     end.
     8644   end procedure.
     8645   procedure main-road-tax :
     8646   def input param p-obj-type  like ub.gds-obj.obj-type  no-undo .
     8647   def input param p-obj-code  like ub.gds-obj.obj-code  no-undo .
     8648   def input param p-artic     like ub.gds-obj.artic     no-undo .
     8649   def input param p-prod-type like ub.gds-obj.prod-type no-undo .
     8650   def input param p-prod-code like ub.gds-obj.prod-code no-undo .
     8651   def input-output param p-road-tax-base as decimal no-undo .
     8652   def input-output param p-road-tax-rubl as decimal no-undo .
     8653   define buffer     buff-goods    for ub.goods   .
     8654   define buffer     buf_gds-obj   for ub.gds-obj .
     8655   define buffer     buf_parts     for ub.parts   .
     8656       define buffer   in-vatp-trn-doc  for ub.trn-doc .
     8657       define buffer   in-vatp-parts    for ub.parts   .
     8658       define buffer   in-vatp-doc      for ub.trn-doc .
     8659       define buffer   in-vatp-goods    for ub.goods   .
     8660       define buffer   in-vatp-sysconf  for ub.sysconf .
     8661       define buffer   in-vatp_doc-attr for ub.doc-attr.
     8662       define variable in-vatp-have-vat-slt       as   logical initial yes    no-undo.
     8663       define variable vat-pc-loc                 like ub.doc-line.vat-pc     no-undo.
     8664       define variable varinvprb                  as   character              no-undo.
     8665       define variable slt-pc-loc                 like ub.doc-line.slt-pc     no-undo.
     8666       define variable cli-base-rate              as   decimal                no-undo.
     8667       define variable price-rubl-with-tax-loc    like ub.doc-line.price-rubl no-undo.
     8668       define variable price-base-with-tax-loc    like ub.doc-line.price-base no-undo.
     8669       define variable price-cli-with-tax-loc     like ub.doc-line.price-cli  no-undo.
     8670       define variable price-rubl-without-tax-loc like ub.doc-line.price-rubl no-undo.
     8671       define variable price-base-without-tax-loc like ub.doc-line.price-base no-undo.
     8672       define variable price-cli-without-tax-loc  like ub.doc-line.price-base no-undo.
     8673       define variable vat-base-loc               like ub.doc-line.price-base no-undo.
     8674       define variable vat-rubl-loc               like ub.doc-line.price-rubl no-undo.
     8675       define variable vat-cli-loc                like ub.doc-line.price-rubl no-undo.
     8676       define variable slt-base-loc               like ub.doc-line.price-base no-undo.
     8677       define variable slt-rubl-loc               like ub.doc-line.price-rubl no-undo.
     8678       define variable slt-cli-loc                like ub.doc-line.price-rubl no-undo.
     8679       define variable road-tax-base-loc          like ub.doc-line.road-tax   no-undo.
     8680       define variable road-tax-rubl-loc          like ub.doc-line.road-tax   no-undo.
     8681       define variable road-tax-cli-loc           like ub.doc-line.road-tax   no-undo.
     8682       define variable transport-base-loc         like ub.doc-line.price-base no-undo.
     8683       define variable transport-rubl-loc         like ub.doc-line.price-rubl no-undo.
     8684       define variable transport-cli-loc          like ub.doc-line.price-rubl no-undo.
     8685       define variable other-base-loc             like ub.doc-line.price-base no-undo.
     8686       define variable other-rubl-loc             like ub.doc-line.price-rubl no-undo.
     8687       define variable other-cli-loc              like ub.doc-line.price-rubl no-undo.
     8688       define variable exch-rate-cli-loc          like ub.trn-doc.exch-rate   no-undo.
     8689       define variable varinvatp-envd             as   character              no-undo.
     8690       define variable varinvatp-type             as   character              no-undo.
     8691   define buffer buf_trn-doc for ub.trn-doc  .
     8692   define buffer buf_doc-line for ub.doc-line .
     8693   define variable   is-petrolium  as logical             no-undo.
     8694   define variable   is-pieces     as logical             no-undo.
     8695   define variable v-last-in-code  like ub.gds-obj.in-code  no-undo .
     8696   define variable v-last-obj-type like ub.gds-obj.obj-type no-undo .
     8697   define variable v-last-obj-code like ub.gds-obj.obj-code no-undo .
     8698   def var v-rec as recid no-undo.
     8699   def var t-ret as logical no-undo .
     8700   def var v-total-avrg-base as decimal no-undo .
     8701   def var v-total-avrg-rubl as decimal no-undo .
     8702   def var v-total-avrg-qnty as decimal no-undo .
     8703   def var v-total-road-tax-base     as decimal no-undo .
     8704   def var v-total-road-tax-rubl     as decimal no-undo .
     8705   def var v-all-total-road-tax-base as decimal no-undo .
     8706   def var v-all-total-road-tax-rubl as decimal no-undo .
     8707   assign
     8708     p-road-tax-base = ?
     8709     p-road-tax-rubl = ?
     8710     .
     8711     Find first buff-goods no-lock where
     8712           buff-goods.artic     = p-artic and
     8713           buff-goods.prod-type = p-prod-type and
     8714           buff-goods.prod-code = p-prod-code
     8715           no-error .
     8716         if available buff-goods then do:
