     6906       define variable road-tax-base-loc          like ub.doc-line.road-tax   no-undo.
     6907       define variable road-tax-rubl-loc          like ub.doc-line.road-tax   no-undo.
     6908       define variable road-tax-cli-loc           like ub.doc-line.road-tax   no-undo.
     6909       define variable transport-base-loc         like ub.doc-line.price-base no-undo.
     6910       define variable transport-rubl-loc         like ub.doc-line.price-rubl no-undo.
     6911       define variable transport-cli-loc          like ub.doc-line.price-rubl no-undo.
     6912       define variable other-base-loc             like ub.doc-line.price-base no-undo.
     6913       define variable other-rubl-loc             like ub.doc-line.price-rubl no-undo.
     6914       define variable other-cli-loc              like ub.doc-line.price-rubl no-undo.
     6915       define variable exch-rate-cli-loc          like ub.trn-doc.exch-rate   no-undo.
     6916       define variable varinvatp-envd             as   character              no-undo.
     6917       define variable varinvatp-type             as   character              no-undo.
     6918     do
     6919     on error undo, return error return-value
     6920     :
