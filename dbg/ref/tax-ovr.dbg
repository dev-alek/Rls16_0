     4900                 buf_buf_price-doc-forming-gds.pdf-id =  v-pdf-id and
     4901                 buf_buf_price-doc-forming-gds.pdf-db =  v-pdf-db-num and
     4902                 buf_buf_price-doc-forming-gds.plt-id =  v-plt-id2     and
     4903                 buf_buf_price-doc-forming-gds.plt-db-num =  v-plt-db-num2 and
     4904                 buf_buf_price-doc-forming-gds.b-code =  p-b-code
     4905                 no-error .
