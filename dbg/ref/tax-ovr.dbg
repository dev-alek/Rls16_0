        1   define input parameter parparentproc            as widget-handle    no-undo .
        2   define input parameter p-tax-rate-value-recid   as recid            no-undo.
        3   define variable vss-revision    as character no-undo init "$Revision$":U .
        4   define variable vss-author      as character no-undo init "$Author$":U .
        5   define variable vss-date        as character no-undo init "$Date$":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        7   define variable vss-archive     as character no-undo init "$Archive$":U .
        8   define variable vss-description as character no-undo init "Создание переоценки при изменении налога на товар".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       68   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       69   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
       70   define variable par-type          as character no-undo.
       71   define variable v-value-character as character no-undo .
       72   define variable v-value-date      as date      no-undo .
       73   define variable v-value-decimal   as decimal   no-undo .
       74   define variable v-value-integer   as integer   no-undo .
       75   define variable v-value-logical   as logical   no-undo .
       76   define new global shared variable g#library  as handle no-undo .
       77   define new global shared variable g#library2 as handle no-undo .
       78   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       79   define  temp-table temp-host no-undo
       80     field host-code like ub.store.host-code
       81     index xpk host-code
       82   .
       83   define  temp-table temp-obj no-undo
       84     field obj-type  like ub.clients.obj-type
       85     field obj-code  like ub.clients.obj-code
       86     field host-code like ub.store.host-code
       87     field db-num    like ub.clients.db-num
       88     index xpk  obj-type obj-code
       89     index xie1 host-code
       90     index xie2 db-num host-code
       91   .
       92   procedure init-temphost:
       93     define buffer buf_store   for ub.store .
       94     define buffer buf_shop    for ub.shop .
       95     define buffer buf_clients for ub.clients .
       96     define buffer buf_db for ub.db .
       97     define buffer buf_temp-host for temp-host .
       98     define buffer buf_temp-obj for temp-obj .
       99     do
      100     on error undo, return error return-value
      101     :
      102       for each buf_store
      103       on error undo, return error
      104       :
      105         find first buf_clients no-lock
      106           where buf_clients.obj-type = 'скл':U
      107             and buf_clients.obj-code = buf_store.obj-code
      108           no-error .
      109         if not available buf_clients
      110         then do:
      111           message
      112             "Ошибка при поиске клиента" skip
      113             "Клиент" 'скл':U buf_store.obj-code skip
      114             view-as alert-box error .
      115           undo, return error .
      116         end.
      117         if buf_clients.stts <> 0 then next.
      118         find first buf_temp-host
      119           where buf_temp-host.host-code = buf_store.host-code
      120           no-error .
      121         if not available buf_temp-host
      122         then do:
      123           create buf_temp-host .
      124           assign
      125             buf_temp-host.host-code = buf_store.host-code
      126           .
      127         end.
      128         create buf_temp-obj .
      129         assign
      130           buf_temp-obj.obj-type  = 'скл':U
      131           buf_temp-obj.obj-code  = buf_store.obj-code
      132           buf_temp-obj.host-code = buf_store.host-code
      133           buf_temp-obj.db-num    = buf_clients.db-num
      134         .
      135       end.
      136       for each buf_shop
      137       on error undo, return error
      138       :
      139         find first buf_clients no-lock
      140           where buf_clients.obj-type = 'маг':U
      141             and buf_clients.obj-code = buf_shop.obj-code
      142           no-error .
      143         if not available buf_clients then do:
      144           message
      145             "Ошибка при поиске клиента" skip
      146             "Клиент" 'маг':U buf_shop.obj-code skip
      147             view-as alert-box error .
      148           undo, return error .
      149         end.
      150         if buf_clients.stts <> 0 then next.
      151         find first buf_temp-host
      152           where buf_temp-host.host-code = buf_shop.host-code
      153           no-error .
      154         if not available buf_temp-host
      155         then do:
      156           create buf_temp-host .
      157           assign
      158             buf_temp-host.host-code = buf_shop.host-code
      159           .
      160         end.
      161         create buf_temp-obj .
      162         assign
      163           buf_temp-obj.obj-type  = 'маг':U
      164           buf_temp-obj.obj-code  = buf_shop.obj-code
      165           buf_temp-obj.host-code = buf_shop.host-code
      166           buf_temp-obj.db-num    = buf_clients.db-num
      167         .
      168       end.
      169     end.
      170   end.
      171   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      172   procedure factord :
      173     define input  parameter p-fact-date            as date    no-undo .
      174     define input  parameter p-fact-time            as integer no-undo .
      175     define input  parameter p-fact-num             as integer no-undo .
      176     define input  parameter p-shift-date           as date    no-undo .
      177     define input  parameter p-shift-num            as integer no-undo .
      178     define input  parameter p-shift-on             as logical no-undo .
      179     define output parameter p-fact-order           as decimal no-undo .
      180     define output parameter p-shift-end-fact-order as decimal no-undo .
      181     define output parameter p-day-end-fact-order   as decimal no-undo .
      182     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
      183     if p-fact-date = ?
      184     then do:
      185       return error "Не указана фактическая дата" .
      186     end.
      187     define variable v-fact-date-num as integer no-undo .
      188     assign
      189       v-fact-date-num = integer(p-fact-date)
      190     .
      191     if p-fact-num = ?
      192     or p-fact-num = 0
      193     then do:
      194       return error "Не задан p-fact-num " + string(p-fact-num) .
      195     end.
      196     if p-fact-num < 0
      197     then do:
      198       return error "Отрицательный fact-num " + string(p-fact-num) .
      199     end.
      200     if p-fact-num >= 100000000
      201     then do:
      202       return error "Недопустимо большой fact-num " + string(p-fact-num) .
      203     end.
      204     if p-shift-on = true
      205     then do:
      206       if p-shift-date = ?
      207       then do:
      208         return error "Не задана дата смены" .
      209       end.
      210       if p-shift-num = ?
      211       or p-shift-num = 0
      212       then do:
      213         return error "Не задан номер смены" .
      214       end.
      215     end.
      216     else do:
      217       assign
      218         p-shift-date = p-fact-date
      219         p-shift-num  = 24
      220       .
      221     end.
      222     define variable v-shift-offset as integer no-undo .
      223     if p-shift-date = p-fact-date
      224     then do:
      225       assign
      226         v-shift-offset = 1
      227       .
      228     end.
      229     if p-shift-date < p-fact-date
      230     then do:
      231       assign
      232         v-shift-offset = 0
      233       .
      234     end.
      235     if p-shift-date > p-fact-date
      236     then do:
      237       message
      238         vss-workfile vss-revision vss-description skip
      239         "Неправильная дата закрытия смены" skip
      240         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
      241         view-as alert-box error .
      242       undo, return error
      243         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
      244           ,string(p-fact-date, '99/99/9999':U)
      245           ,string(p-shift-date, '99/99/9999':U)
      246           )
      247       .
      248     end.
      249     if p-shift-num < 1
      250     or p-shift-num > 24
      251     then do:
      252       message
      253         vss-workfile vss-revision vss-description skip
      254         "Неправильный номер смены" skip
      255         "p-shift-num" p-shift-num skip
      256         view-as alert-box error .
      257       undo, return error return-value .
      258     end.
      259     assign
      260       p-fact-order           = v-fact-date-num
      261                              + v-shift-offset * 0.5
      262                              + p-shift-num    * 0.02 - 0.01
      263                              + p-fact-num     * 0.0000000001
      264       p-shift-end-fact-order = v-fact-date-num
      265                              + v-shift-offset * 0.5
      266                              + p-shift-num    * 0.02
      267       p-day-end-fact-order   = v-fact-date-num
      268                              + 0.99
      269     .
      270     if p-fact-order           <= v-fact-date-num
      271     or p-shift-end-fact-order <= v-fact-date-num
      272     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
      273     or p-shift-end-fact-order >= p-day-end-fact-order
      274     then do:
      275       message
      276         vss-workfile vss-revision vss-description skip
      277         "Внутренняя ошибка при генерации фактического номера" skip
      278         "p-fact-date"            p-fact-date            skip
      279         "p-fact-time"            p-fact-time            skip
      280         "p-fact-num"             p-fact-num             skip
      281         "p-shift-date"           p-shift-date           skip
      282         "p-shift-num"            p-shift-num            skip
      283         "p-shift-on"             p-shift-on             skip
      284         "p-shift-end-fact-order" p-shift-end-fact-order skip
      285         "p-day-end-fact-order"   p-day-end-fact-order   skip
      286         "v-fact-date-num"        v-fact-date-num        skip
      287         view-as alert-box error .
      288       undo, return error return-value .
      289     end.
      290   end procedure.
      291   procedure day-begin-fact-order :
      292     define input  parameter p-fact-date            as date    no-undo .
      293     define output parameter p-day-begin-fact-order as decimal no-undo .
      294     do
      295     on error undo, return error return-value
      296     :
      297       if p-fact-date = ?
      298       then do:
      299         assign
      300           p-day-begin-fact-order = 0
      301         .
      302       end.
      303       else do:
      304         assign
      305           p-day-begin-fact-order = integer(p-fact-date)
      306         .
      307       end.
      308     end.
      309   end procedure.
      310   procedure factord-max-fact-order :
      311     define output parameter p-max-fact-order as decimal   no-undo .
      312     do
      313     on error undo, return error return-value
      314     :
      315       run day-begin-fact-order in this-procedure
      316         (input  date(1, 1, 5000)
      317         ,output p-max-fact-order
      318         ) .
      319     end.
      320   end procedure.
      321   procedure factord-cut-archive :
      322     define input  parameter p-obj-type             as character no-undo .
      323     define input  parameter p-obj-code             as integer   no-undo .
      324     define input  parameter p-fact-date            as date      no-undo .
      325     define output parameter p-shift-on             as logical   no-undo .
      326     define output parameter p-shift-date           as date      no-undo .
      327     define output parameter p-shift-num            as integer   no-undo .
      328     define output parameter p-day-end-fact-order   as decimal   no-undo .
      329     define output parameter p-shift-end-fact-order as decimal   no-undo .
      330     define variable v-fact-order as decimal   no-undo .
      331     define buffer buf_shift-obj for ub.shift-obj .
      332     do
      333     on error undo, return error return-value
      334     :
      335   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      336   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      337     (input  p-obj-type
      338     ,input  p-obj-code
      339     ,input  'shift-on=request'
      340     ,output p-shift-on
      341     ) no-error .
      342       if error-status :error
      343       then do:
      344         message
      345           vss-workfile vss-revision vss-description skip
      346           "Ошибка при определении атрибута объекта" skip
      347           "Объект" p-obj-type p-obj-code skip
      348           error-status :get-message(1) skip
      349           return-value skip
      350           view-as alert-box error .
      351         undo, return error return-value .
      352       end.
      353       if p-shift-on = false
      354       then do:
      355         assign
      356           p-shift-date               = ?
      357           p-shift-num                = 0
      358         .
      359       end.
      360       else do:
      361         find first buf_shift-obj share-lock
      362           where buf_shift-obj.obj-type   = p-obj-type
      363             and buf_shift-obj.obj-code   = p-obj-code
      364             and buf_shift-obj.shift-date > p-fact-date
      365           use-index pi
      366           no-error .
      367         if not available buf_shift-obj
      368         or buf_shift-obj.status_ <> 'зкр':U
      369         then do:
      370           message
      371             vss-workfile vss-revision vss-description skip
      372             "Невозможно вычислить последнюю смену" skip
      373             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
      374             "Объект" p-obj-type p-obj-code skip
      375             "Дата" p-fact-date skip
      376             view-as alert-box error .
      377           undo, return error return-value .
      378         end.
      379         find last buf_shift-obj share-lock
      380           where buf_shift-obj.obj-type = p-obj-type
      381             and buf_shift-obj.obj-code = p-obj-code
      382             and buf_shift-obj.shift-date <= p-fact-date
      383           use-index pi
      384           no-error .
      385         if available buf_shift-obj
      386         then do:
      387           if  buf_shift-obj.status_ = 'зкр':U
      388           then do:
      389             assign
      390               p-shift-date = buf_shift-obj.shift-date
      391               p-shift-num  = buf_shift-obj.shift-num
      392             .
      393           end.
      394           else do:
      395             message
      396               vss-workfile vss-revision vss-description skip
      397               "Невозможно вычислить последнюю смену" skip
      398               "Статус смены отличен от статуса" 'зкр':U skip
      399               "Объект" p-obj-type p-obj-code skip
      400               "Дата" p-fact-date skip
      401               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
      402               view-as alert-box error .
      403             undo, return error return-value .
      404           end.
      405         end.
      406         else do:
      407           assign
      408             p-shift-date = p-fact-date - 1
      409             p-shift-num  = 1
      410           .
      411         end.
      412       end.
      413       run factord in this-procedure
      414         (input  p-fact-date
      415         ,input  1
      416         ,input  1
      417         ,input  p-shift-date
      418         ,input  p-shift-num
      419         ,input  p-shift-on
      420         ,output v-fact-order
      421         ,output p-shift-end-fact-order
      422         ,output p-day-end-fact-order
      423         ) no-error .
      424       if error-status :error
      425       then do:
      426         message
      427           vss-workfile vss-revision vss-description skip
      428           "Ошибка при вызове процедуры factord"
      429           error-status :get-message(1) skip
      430           return-value skip
      431           view-as alert-box error .
      432         undo, return error return-value .
      433       end.
      434     end.
      435   end procedure.
      436   procedure factord-lock-shift :
      437     define input  parameter p-obj-type  as character no-undo .
      438     define input  parameter p-obj-code  as integer   no-undo .
      439     define input  parameter p-fact-date as date      no-undo .
      440     define parameter buffer buf_shift-obj for ub.shift-obj .
      441     define variable v-shift-on      as logical   no-undo .
      442     define variable v-extra-message as character no-undo .
      443     define variable v-error as character no-undo .
      444     do
      445     on error undo, return error return-value
      446     :
      447   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      448   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      449     (input  p-obj-type
      450     ,input  p-obj-code
      451     ,input  'shift-on=request'
      452     ,output v-shift-on
      453     ) no-error .
      454       if error-status :error
      455       then do:
      456         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
      457         undo, return error v-error .
      458       end.
      459       if v-shift-on = true
      460       then do:
      461         find first buf_shift-obj share-lock
      462           where buf_shift-obj.obj-type   = p-obj-type
      463             and buf_shift-obj.obj-code   = p-obj-code
      464             and buf_shift-obj.shift-date > p-fact-date
      465           use-index pi
      466           no-error .
      467         if not available buf_shift-obj
      468         or buf_shift-obj.status_ <> 'зкр':U
      469         then do:
      470           find last buf_shift-obj
      471             where buf_shift-obj.obj-type = p-obj-type
      472               and buf_shift-obj.obj-code = p-obj-code
      473               and buf_shift-obj.status_  = 'зкр':U
      474             use-index stts
      475             no-error .
      476           if available buf_shift-obj
      477           then do:
      478             assign
      479               v-extra-message =
      480                     substitute("Дата начала последеней закрытой смены на объекте &1"
      481                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
      482                               )
      483             .
      484           end.
      485           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
      486           undo, return error v-error .
      487         end.
      488       end.
      489     end.
      490   end procedure.
      491   procedure factord-end-day :
      492     define input  parameter p-fact-date            as date    no-undo .
      493     define output parameter p-day-end-fact-order   as decimal no-undo .
      494     do
      495     on error undo, return error return-value
      496     :
      497       if p-fact-date = ?
      498       then do:
      499         return error "Не указана фактическая дата" .
      500       end.
      501       assign
      502         p-day-end-fact-order = integer(p-fact-date) + 0.99
      503       .
      504     end.
      505   end procedure.
      506   procedure factord-to-date :
      507     define input  parameter p-fact-order as decimal no-undo .
      508     define output parameter p-fact-date  as date    no-undo .
      509     define variable v-ref-date  as date      no-undo .
      510     define variable v-ref-delta as integer   no-undo .
      511     do
      512     on error undo, return error return-value
      513     :
      514       if p-fact-order = ?
      515       or p-fact-order = 0
      516       then do:
      517         return error "Не указан fact-order" .
      518       end.
      519       assign
      520         v-ref-date  = date(1, 1, 2000)
      521       .
      522       assign
      523         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
      524       .
      525       assign
      526         p-fact-date = v-ref-date + v-ref-delta
      527       .
      528     end.
      529   end procedure.
      530   procedure factord-to-fact-num :
      531     define input  parameter p-fact-order as decimal no-undo .
      532     define output parameter p-fact-num   as integer no-undo .
      533     define variable v-fact-order-trunc as decimal no-undo .
      534     do
      535     on error undo, return error return-value
      536     :
      537       if p-fact-order = ?
      538       or p-fact-order = 0
      539       then do:
      540         return error "Не указан fact-order" .
      541       end.
      542       assign
      543        v-fact-order-trunc = truncate(p-fact-order, 2)
      544       .
      545       assign
      546         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
      547       .
      548     end.
      549   end procedure.
      550   procedure factord-to-shift-num :
      551     define input  parameter p-fact-order as decimal no-undo .
      552     define output parameter p-shift-num   as integer no-undo .
      553     define variable  p-shift-numd  as decimal   no-undo .
      554     define variable v-fact-order-trunc as decimal no-undo .
      555     do
      556     on error undo, return error return-value
      557     :
      558       if p-fact-order = ?
      559       or p-fact-order = 0
      560       then do:
      561         return error "Не указан fact-order" .
      562       end.
      563       assign
      564        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
      565       .
      566       if v-fact-order-trunc < 0.5 then do:
      567         v-fact-order-trunc = v-fact-order-trunc + 0.5.
      568       end.
      569       assign
      570         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
      571         .
      572        assign
      573         p-shift-num = truncate (p-shift-numd , 0)
      574       .
      575     end.
      576   end procedure.
      577   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      578   procedure doc-code:
      579   define input  parameter parmode          as   character           no-undo.
      580   define input  parameter parobj-type      like ub.clients.obj-type no-undo.
      581   define input  parameter parobj-code      like ub.clients.obj-code no-undo.
      582   define input  parameter parroot-doc-code like ub.trn-doc.doc-code no-undo.
      583   define output parameter pardoc-code      like ub.trn-doc.doc-code no-undo.
      584   define buffer buf_sys-ctrl for ub.sys-ctrl  .
      585   define variable vardb-remote     as   logical             no-undo.
      586   define variable vartemp-doc-code like ub.trn-doc.doc-code no-undo.
      587   define variable v-delimiter as character no-undo .
      588   do
      589   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      590   :
      591   find first buf_sys-ctrl no-lock .
      592   vardb-remote = buf_sys-ctrl.db-num <> 0 .
      593     CASE parmode:
      594       when "main":u then do:
      595         if vardb-remote then do:
      596           assign
      597             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-" + trim (string (parobj-code, ">>>>9")) + substring (parobj-type, (if g#language = "RUS" then 1 else 2), 1).
      598         end.
      599         else do:
      600           assign
      601             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-".
      602         end.
      603       end.
      604       when "trio" then do:
      605         assign
      606           pardoc-code = replace (parroot-doc-code, "=", "*").
      607       end.
      608       otherwise do:
      609         assign
      610         v-delimiter = entry(lookup(entry(1, parmode), "main,chip,pair,flora,trio-m,quadro,stock-up,stock-down,stock-fix," +                          "main_s,chip_s,pair_s,trio-m_s,quadro_s,stock-up_s,stock-down_s,stock-fix_s":U), ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)))
      611         no-error
      612         .
      613         if error-status:error  then do:
      614           undo, return error substitute("Ошибка при генерации номера документа&1Неверное значение параметра parmode &2"
      615                                         ,chr(10)
      616                                         ,parmode
      617                                         ).
      618         end.
      619         if num-entries(parmode) = 1
      620         and parmode <> "chip":U
      621         and parmode <> "chip_s":U
      622         then do:
      623           assign
      624           pardoc-code = replace (parroot-doc-code, "-", v-delimiter).
      625         end.
      626         else if (lookup("chip":U, parmode) > 0
      627                  or
      628                  lookup("chip_s":U, parmode) > 0) then do:
      629           assign
      630             vartemp-doc-code = parroot-doc-code.
      631           do while true:
      632             if index (vartemp-doc-code , ".") = 0 then
      633               vartemp-doc-code  = replace (vartemp-doc-code , v-delimiter, v-delimiter + "1.").
      634             else
      635               vartemp-doc-code  =
      636               substring (vartemp-doc-code , 1, index (vartemp-doc-code, v-delimiter)) +
      637               string (integer (substring (vartemp-doc-code, index (vartemp-doc-code, v-delimiter) + 1, index (vartemp-doc-code, ".") - index (vartemp-doc-code, v-delimiter) - 1)) + 1) +
      638               substring (vartemp-doc-code, index (vartemp-doc-code, ".")).
      639             if not can-find (ub.trn-doc where ub.trn-doc.doc-code = vartemp-doc-code no-lock) then leave.
      640           end.
      641           assign
      642             pardoc-code = vartemp-doc-code.
      643         end.
      644       end.
      645     end CASE.
      646     if pardoc-code = '':U
      647     or (parroot-doc-code <> '':U
      648     and pardoc-code = parroot-doc-code) then do:
      649       undo, return error substitute("Ошибка при генерации номера документа&1"
      650                                     ,chr(10)).
      651     end.
      652   end.
      653   end. // procedure/method
      654   function get-doc-code-int64 returns int64
      655     ( input p-doc-code as character ) :
      656     define variable v-ind              as integer   no-undo .
      657     define variable v-num-entries      as integer   no-undo .
      658     define variable v-doc-code-int64   as int64     no-undo .
      659     define variable v-canonic-doc-code as character no-undo .
      660     assign
      661       v-num-entries      = num-entries( ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) )
      662       v-canonic-doc-code = p-doc-code
      663     .
      664     do v-ind = 1 to v-num-entries
      665     :
      666       assign
      667         v-canonic-doc-code = entry(1, v-canonic-doc-code, entry( v-ind, ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) ) )
      668       .
      669     end.
      670     assign
      671       v-doc-code-int64 = int64(v-canonic-doc-code) no-error
      672     .
      673     return v-doc-code-int64 .
      674   end. // function/method
      675   procedure proc-alt-shift-f2:
      676     if not ibs.th.gbl.gbl-var:rcode
      677   then
      678     run gbl\inidebug.p .
      679   end.
      680   procedure proc-alt-shift-f3:
      681     run gbl/prvssinf.p
      682       ( input this-procedure
      683       ) .
      684   end.
      685   define variable v-inform-launched as logical no-undo initial false .
      686   procedure proc-alt-shift-f4:
      687     define variable v-action as character no-undo .
      688     if v-inform-launched = false then do:
      689       assign
      690         v-inform-launched = true
      691       .
      692       run gbl/d-inform.w
      693         (  input self
      694         ,  input this-procedure
      695         , output v-action
      696         ) no-error .
      697       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      698       assign
      699         v-inform-launched = false
      700       .
      701     end.
      702   end.
      703   procedure proc-alt-f1:
      704     run gbl/corrhelp.p
      705       (input this-procedure
      706       ) .
      707   end .
      708   on alt-shift-f2 anywhere do:
      709     run proc-alt-shift-f2.
      710   end.
      711   on alt-shift-f3 anywhere do:
      712     run proc-alt-shift-f3 in this-procedure .
      713   end.
      714   on alt-shift-f4 anywhere do:
      715     run proc-alt-shift-f4 in this-procedure.
      716   end.
      717   on alt-f1 anywhere do:
      718     run proc-alt-f1 in this-procedure .
      719   end.
      720   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      721     define variable v-cntxt-db-num        as integer   no-undo .
      722     define variable v-cntxt-userid        as character no-undo .
      723     define variable v-cntxt-level         as character no-undo .
      724     define variable v-cntxt-host-code-obj as integer   no-undo .
      725     define variable v-cntxt-obj-type      as character no-undo .
      726     define variable v-cntxt-obj-code      as integer   no-undo .
      727     define variable v-cntxt-db-num-obj    as integer   no-undo .
      728     define variable v-cntxt-is-admin      as logical   no-undo .
      729   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      730   define variable v-waitfram-action01         as character   no-undo .
      731   define variable v-waitfram-action02         as character   no-undo .
      732   define variable v-waitfram-action03         as character   no-undo .
      733   define variable mWaitFramTextBeg            as character   no-undo.
      734   define variable mWaitFramTextEnd            as character   no-undo.
      735   define variable mWaitFramView               as logical     no-undo.
      736   define variable mWaitProcEvent              as logical     no-undo init yes.
      737   define variable mWaitFramInterval           as integer     no-undo init 1 .
      738   define variable mWaitFramStop               as logical     no-undo.
      739   define variable mWaitFramStopUser           as logical     no-undo.
      740   define variable mWaitFramStopTimeOut        as logical     no-undo.
      741   define variable mWaitFramStartProc          as datetime-tz no-undo.
      742   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      743   define button B-WaitFramStop auto-end-key
      744        label "Стоп"
      745        size 10 by 1 tooltip "Остоновить процесс".
      746   define button B-viewProcInfo
      747        label "Информация"
      748        size 15 by 1 tooltip "Информация о процесс".
      749   define frame waitfram
      750     v-waitfram-action01 format "x(72)" no-label skip
      751     v-waitfram-action02 format "x(72)" no-label skip
      752     v-waitfram-action03 format "x(72)" no-label skip
      753     B-viewProcInfo
      754     B-WaitFramStop at row 4 col 30
      755     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      756     .
      757   define new global shared variable mBatchMode as logical no-undo init ?.
      758   define variable mFramBachModHandle as handle no-undo.
      759   mFramBachModHandle = frame waitfram:handle.
      760   define variable mFameOldVis as logical no-undo.
      761   define variable mVisCUrentVin as logical no-undo.
      762   if session:batch-mode
      763   then
      764      mBatchMode = yes.
      765   if mBatchMode = ? then do:
      766     mVisCUrentVin = current-window:visible.
      767     mFameOldVis = mFramBachModHandle:visible.
      768     mFramBachModHandle:visible  = yes.
      769     mBatchMode = mFramBachModHandle:visible ne yes.
      770     mFramBachModHandle:visible = mFameOldVis.
      771     current-window:visible = mVisCUrentVin.
      772   end.
      773    if  log-manager:logfile-name ne ?
      774     then DO:
      775         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      776         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      777         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      778     end.
      779   on choose of B-WaitFramStop in frame waitfram
      780   do:
      781     mWaitFramStop = yes.
      782     mWaitFramStopUser = yes.
      783   end.
      784   function waitfram-check-timeout returns logical():
      785      define variable vtime as int64 no-undo.
      786      if mWaitFramStopTimeOut
      787      then
      788         return yes.
      789      vtime = ( now - mWaitFramStartProc ) / 1000 .
      790      if     mWaitFramTimeOut ne ?
      791         and mWaitFramTimeOut ne 0
      792         and mWaitFramTimeOut lt vtime
      793      then do:
      794         mWaitFramStopTimeOut = yes.
      795      end.
      796      return mWaitFramStopTimeOut.
      797   end.
      798   procedure waitfram-hide :
      799     if not session:batch-mode
      800     then do
      801     on error undo, return error return-value
      802     :
      803       pause 0 before-hide .
      804       if not mBatchMode then
      805         hide frame waitfram .
      806     if     not mWaitFramView
      807        and mWaitProcEvent
      808     then
      809       process events .
      810     end.
      811   end procedure.
      812   procedure waitfram-show :
      813     define input  parameter p-message as character no-undo .
      814     define variable v-left-margin as integer   no-undo .
      815     if not session:batch-mode
      816     then do
      817     on error undo, return error return-value
      818     :
      819       if length(p-message) <= 70 then do:
      820         assign
      821           v-left-margin = integer((70 - length(p-message)) / 2)
      822         .
      823         assign
      824           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      825         .
      826         assign
      827           v-waitfram-action01 = " "
      828           v-waitfram-action02 = " "
      829                                    + fill(" ", v-left-margin)
      830                                    + p-message
      831           v-waitfram-action03 = " "
      832         .
      833       end.
      834       else do:
      835         define variable vRindex1 as integer no-undo.
      836         define variable vRindex2 as integer no-undo.
      837         vRindex1 = r-index(p-message," ",70).
      838         if vRindex1 = 0
      839         then
      840            vRindex1 = 70.
      841         if length(p-message)  <= vRindex1 + 70 then do:
      842           assign
      843             v-waitfram-action01 = " "
      844             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      845             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      846           .
      847         end.
      848         else do:
      849           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      850           if vRindex2 <= vRindex1
      851           then
      852              vRindex2 = vRindex1 + 70.
      853           assign
      854             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      855             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      856             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      857           .
      858         end.
      859       end.
      860       B-viewProcInfo:visible   in frame waitfram = no.
      861       B-viewProcInfo:sensitive in frame waitfram = no.
      862       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      863       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      864       if  (   mWaitFramView
      865          or  mWaitProcEvent)
      866          and not mBatchMode
      867       then
      868          display
      869             v-waitfram-action01 skip
      870             v-waitfram-action02 skip
      871             v-waitfram-action03 skip
      872          with frame waitfram .
      873       if     mWaitFramView
      874          then do:
      875             if     mWaitFramInterval ne ?
      876                and not mBatchMode
      877             then
      878                wait-for go of frame waitfram pause mWaitFramInterval.
      879          end.
      880          else
      881             if     mWaitProcEvent
      882                and not mBatchMode
      883             then
      884                process events .
      885     end.
      886   end procedure.
      887      procedure waitfram-show-this:
      888         define input  parameter iInterval as int64 no-undo.
      889         define variable vtime as int64 no-undo.
      890         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      891         mWaitFramInterval = iInterval.
      892         run waitfram-show (substitute("&1&2 &3&4" ,
      893                                       mWaitFramTextBeg ,
      894                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      895                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      896                                       mWaitFramTextEnd
      897                                      )
      898                           ).
      899      end.
      900      procedure WaitFramRunPause:
      901         define input  parameter iInterval as dec no-undo.
      902         define variable vStart  as datetime-tz no-undo.
      903         define variable vend    as datetime-tz no-undo.
      904         define variable vint as int64 no-undo.
      905         define variable vOk as logical no-undo.
      906         vStart = now.
      907         vend   = vStart.
      908         publish "WaitFramPause" (iInterval,output vOk).
      909         vend   =  now.
      910         vint = vend - vStart.
      911         vint = iInterval - vint / 1000.
      912         if     not mWaitFramStop
      913            and (   vint > 0
      914                 or (    not vOk
      915                     and iInterval eq ?
      916                     )
      917                 )
      918         then
      919            run waitfram-show-this (iInterval).
      920         vend   =  now.
      921         vint = vend - vStart.
      922         vint = iInterval - vint / 1000.
      923         if     not mWaitFramStop
      924            and vint > 0
      925         then do:
      926            run gbl/pause.p (vint * 1000).
      927         end.
      928         if iInterval ne ?
      929         then
      930            publish "WaitFramStop".
      931         waitfram-check-timeout().
      932      end.
      933      procedure WaitFramWaitFor:
      934         define input  parameter iInterval as dec no-undo.
      935         assign
      936            mWaitFramStartProc   = now
      937            mWaitFramStopUser    = no
      938            mWaitFramStopTimeOut = no
      939         .
      940         block-wait:
      941         do while not mWaitFramStop:
      942            run WaitFramRunPause (iInterval).
      943            if  waitfram-check-timeout()
      944            then do:
      945               leave block-wait.
      946            end.
      947         end.
      948         run waitfram-hide.
      949      end.
      950   procedure waitfram-join :
      951     define input  parameter p-line-1  as character no-undo .
      952     define input  parameter p-line-2  as character no-undo .
      953     define input  parameter p-line-3  as character no-undo .
      954     define output parameter p-message as character no-undo .
      955     do
      956     on error undo, return error return-value
      957     :
      958       assign
      959         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      960                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      961                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      962       .
      963     end.
      964   end procedure.
      965   function waitfram-join-function returns character
      966     (input p-line-1 as character
      967     ,input p-line-2 as character
      968     ,input p-line-3 as character
      969     ).
      970     define variable v-message as character no-undo .
      971     run waitfram-join in this-procedure
      972       (input  p-line-1
      973       ,input  p-line-2
      974       ,input  p-line-3
      975       ,output v-message
      976       ) .
      977     return v-message .
      978   end function .
      979   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      980   define temp-table x_obj-group no-undo like ub.clients  .
      981   define temp-table x_grp-obj-price no-undo like ub.grp-obj-price .
      982   procedure metod-gop-obj :
      983     do
      984     on error undo, return error return-value
      985     :
      986   define input  parameter p-cntxt-db-num as integer   no-undo .
      987   define input  parameter p-gop-id       as integer   no-undo .
      988   define input  parameter p-gop-db-num   as integer   no-undo .
      989   define buffer buf1_clients for ub.clients  .
      990   define buffer buf_db-grp-obj-price   for ub.db-grp-obj-price  .
      991   define buffer buf_host-grp-obj-price for ub.host-grp-obj-price  .
      992   define buffer buf_obj-grp-obj-price  for ub.obj-grp-obj-price  .
      993   for each  x_obj-group : delete x_obj-group. end.
      994   if p-gop-id = 0 or p-gop-id = ?  then do:
      995      if p-cntxt-db-num = 0  then do:
      996           for each buf1_clients no-lock where
      997                   (buf1_clients.obj-type = 'маг':U  or
      998                    buf1_clients.obj-type = 'скл':U  )
      999                   and
     1000                   buf1_clients.db-num >= 0  and
     1001                   buf1_clients.stts = 0
     1002                   :
     1003             create x_obj-group .
     1004             assign
     1005               x_obj-group.obj-code   = buf1_clients.obj-code
     1006               x_obj-group.obj-type   = buf1_clients.obj-type
     1007               x_obj-group.obj-name   = buf1_clients.obj-name
     1008               x_obj-group.db-num     = buf1_clients.db-num
     1009             .
     1010           end.
     1011      end.
     1012      else do:
     1013           for each buf1_clients no-lock where
     1014                   (buf1_clients.obj-type = 'маг':U  or
     1015                    buf1_clients.obj-type = 'скл':U  ) and
     1016                    buf1_clients.db-num = p-cntxt-db-num  and
     1017                    buf1_clients.stts = 0
     1018                   :
     1019             create x_obj-group .
     1020             assign
     1021               x_obj-group.obj-code   = buf1_clients.obj-code
     1022               x_obj-group.obj-type   = buf1_clients.obj-type
     1023               x_obj-group.obj-name   = buf1_clients.obj-name
     1024               x_obj-group.db-num     = buf1_clients.db-num
     1025             .
     1026           end.
     1027      end.
     1028   end.
     1029   else do:
     1030         for each buf_db-grp-obj-price  where
     1031                 buf_db-grp-obj-price.gop-id     = p-gop-id and
     1032                 buf_db-grp-obj-price.gop-db-num = p-gop-db-num and
     1033                 buf_db-grp-obj-price.stts = 0  no-lock :
     1034           for each buf1_clients no-lock where
     1035                  (buf1_clients.obj-type = 'маг':U  or
     1036                   buf1_clients.obj-type = 'скл':U  ) and
     1037                   buf1_clients.db-num = buf_db-grp-obj-price.dgo-db-num  and
     1038                   buf1_clients.stts = 0
     1039                   :
     1040             create x_obj-group .
     1041             assign
     1042               x_obj-group.obj-code   = buf1_clients.obj-code
     1043               x_obj-group.obj-type   = buf1_clients.obj-type
     1044               x_obj-group.obj-name   = buf1_clients.obj-name
     1045               x_obj-group.db-num     = buf1_clients.db-num
     1046             .
     1047           end.
     1048         end.
     1049       for each buf_host-grp-obj-price where
     1050               buf_host-grp-obj-price.gop-id     = p-gop-id and
     1051               buf_host-grp-obj-price.gop-db-num = p-gop-db-num and
     1052               buf_host-grp-obj-price.stts = 0
     1053               no-lock :
     1054         for each buf1_clients no-lock where
     1055                (buf1_clients.obj-type = 'маг':U  or
     1056                 buf1_clients.obj-type = 'скл':U  ) and
     1057                 buf1_clients.host-code = buf_host-grp-obj-price.host-code and
     1058                 buf1_clients.stts = 0
     1059                 :
     1060             find first x_obj-group no-lock  where
     1061                       x_obj-group.obj-code   = buf1_clients.obj-code and
     1062                       x_obj-group.obj-type   = buf1_clients.obj-type no-error .
     1063             if not available  x_obj-group then   create x_obj-group .
     1064             assign
     1065               x_obj-group.obj-code   = buf1_clients.obj-code
     1066               x_obj-group.obj-type   = buf1_clients.obj-type
     1067               x_obj-group.obj-name   = buf1_clients.obj-name
     1068               x_obj-group.db-num     = buf1_clients.db-num
     1069             .
     1070         end.
     1071       end.
     1072       for each buf_obj-grp-obj-price where
     1073               buf_obj-grp-obj-price.gop-id     = p-gop-id and
     1074               buf_obj-grp-obj-price.gop-db-num = p-gop-db-num and
     1075               buf_obj-grp-obj-price.stts = 0
     1076               no-lock :
     1077         for each buf1_clients no-lock where
     1078                   buf1_clients.obj-type = buf_obj-grp-obj-price.obj-type and
     1079                   buf1_clients.obj-code = buf_obj-grp-obj-price.obj-code and
     1080                   buf1_clients.stts     = 0
     1081                   :
     1082             find first  x_obj-group no-lock  where
     1083                         x_obj-group.obj-code   = buf1_clients.obj-code and
     1084                         x_obj-group.obj-type   = buf1_clients.obj-type no-error .
     1085             if not available  x_obj-group then   create x_obj-group .
     1086             assign
     1087               x_obj-group.obj-code   = buf1_clients.obj-code
     1088               x_obj-group.obj-type   = buf1_clients.obj-type
     1089               x_obj-group.obj-name   = buf1_clients.obj-name
     1090               x_obj-group.db-num     = buf1_clients.db-num
     1091             .
     1092         end.
     1093       end.
     1094   end.
     1095   end.
     1096   end procedure.
     1097   procedure metod-obj-in-gop :
     1098   define input  parameter p-curr-db-num as integer   no-undo .
     1099   define input  parameter p-obj-type as character no-undo .
     1100   define input  parameter p-obj-code as integer   no-undo .
     1101   define buffer buf_grp-obj-price for ub.grp-obj-price  .
     1102     do
     1103     on error undo, return error return-value
     1104     :
     1105       empty temp-table x_grp-obj-price.
     1106       for each buf_grp-obj-price where
     1107                buf_grp-obj-price.stts = 0
     1108                no-lock :
     1109                  run metod-gop-obj (p-curr-db-num , buf_grp-obj-price.gop-id ,buf_grp-obj-price.gop-db-num) .
     1110                  for each x_obj-group where
     1111                           x_obj-group.obj-type = p-obj-type and
     1112                           x_obj-group.obj-code = p-obj-code :
     1113                       create  x_grp-obj-price.
     1114                       buffer-copy buf_grp-obj-price to x_grp-obj-price .
     1115                  end.
     1116       end.
     1117     end.
     1118   end procedure.
     1119   procedure metod-delobj-usr :
     1120   define input  parameter p-pdf-id  as integer   no-undo .
     1121   define input  parameter p-pdf-db  as integer   no-undo .
     1122   define input  parameter p-plt-id  as integer   no-undo .
     1123   define input  parameter p-plt-db-num as integer   no-undo .
     1124   define buffer buf_price-doc-forming-attr for ub.price-doc-forming-attr  .
     1125     do
     1126     on error undo, return error return-value
     1127     :
     1128   for each buf_price-doc-forming-attr no-lock  where
     1129            buf_price-doc-forming-attr.pdf-id =     p-pdf-id and
     1130            buf_price-doc-forming-attr.pdf-db =     p-pdf-db and
     1131            buf_price-doc-forming-attr.plt-id =     p-plt-id and
     1132            buf_price-doc-forming-attr.plt-db-num = p-plt-db-num and
     1133            buf_price-doc-forming-attr.attr-code begins "obj" :
     1134      for each x_obj-group  where
     1135               x_obj-group.obj-type = substring(buf_price-doc-forming-attr.attr-code,4,3) and
     1136               x_obj-group.obj-code = int(substring(buf_price-doc-forming-attr.attr-code,7,20)) :
     1137        delete x_obj-group.
     1138      end.
     1139   end.
     1140     if not can-find (first x_obj-group) then do:
     1141        return "nullobj" .
     1142     end.
     1143   end.
     1144   end procedure.
     1145   procedure metod-obj-pdf :
     1146   define input  parameter p-cntxt-db-num as integer   no-undo .
     1147   define input  parameter p-pdf-id     like ub.price-doc-forming.pdf-id   no-undo .
     1148   define input  parameter p-pdf-db-num like ub.price-doc-forming.pdf-db   no-undo .
     1149   define input  parameter p-plt-id     like ub.price-doc-forming.plt-id   no-undo .
     1150   define input  parameter p-plt-db-num like ub.price-doc-forming.plt-db-num  no-undo .
     1151   define buffer buf_price-list-type for ub.price-list-type  .
     1152   define buffer buf_price-doc-forming for ub.price-doc-forming  .
     1153     do
     1154     on error undo, return error return-value
     1155     :
     1156    for each  x_obj-group : delete x_obj-group. end.
     1157    find first buf_price-list-type no-lock where
     1158               buf_price-list-type.plt-id = p-plt-id and
     1159               buf_price-list-type.plt-db-num = p-plt-db-num no-error .
     1160   if error-status :error then return error return-value .
     1161    find first buf_price-doc-forming no-lock where
     1162               buf_price-doc-forming.plt-id     = p-plt-id and
     1163               buf_price-doc-forming.plt-db-num = p-plt-db-num and
     1164               buf_price-doc-forming.pdf-id     = p-pdf-id and
     1165               buf_price-doc-forming.pdf-db     = p-pdf-db-num
     1166               no-error .
     1167   if error-status :error then return error return-value .
     1168     run metod-gop-obj in this-procedure (
     1169         p-cntxt-db-num,
     1170         buf_price-list-type.gop-id ,
     1171         buf_price-list-type.gop-db-num
     1172         ) no-error .
     1173     run metod-delobj-usr in this-procedure (
     1174       buf_price-doc-forming.pdf-id ,
     1175       buf_price-doc-forming.pdf-db ,
     1176       buf_price-doc-forming.plt-id ,
     1177       buf_price-doc-forming.plt-db-num
     1178       ) no-error .
     1179     end.
     1180   end procedure.
     1181   function hvrdtax return logical (input parrecid as recid):
     1182   define variable varresult as logical no-undo.
     1183   run hvrdtax-proc (input parrecid, output varresult).
     1184   return varresult.
     1185   end function.
     1186   procedure hvrdtax-proc:
     1187   define input  parameter parrecid  as recid   no-undo.
     1188   define output parameter parresult as logical no-undo.
     1189   define buffer bf_goods for ub.goods.
     1190   define buffer bf_units for ub.units.
     1191   define buffer rt_tax   for ub.tax.
     1192   find first rt_tax   where rt_tax.tax-code    = integer('3':U) no-lock no-error.
     1193   find first bf_goods where recid(bf_goods)    = parrecid              no-lock.
     1194   find first bf_units where bf_units.unit-name = bf_goods.unit-base    no-lock.
     1195   if available rt_tax and
     1196       can-find(first ub.tax-units No-LOCK WHERE
     1197                      ub.tax-units.tax-code = rt_tax.tax-code AND
     1198                      LOOKUP(ub.tax-units.type, bf_units.type) > 0) then assign parresult = yes.
     1199                                                       else assign parresult = no.
     1200   end procedure.
     1201   define new global shared variable g#lib-trn  as handle no-undo .
     1202   define new global shared variable g#lib-trn2 as handle no-undo .
     1203   define new global shared variable g#lib-trn3 as handle no-undo .
     1204   define new global shared variable g#lib-trn4 as handle no-undo .
     1205   define buffer buf_price-doc-forming for ub.price-doc-forming  .
     1206   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1207   FUNCTION fnc-base-price RETURN decimal (local-bc      as integer,
     1208                                           local-doc-num as char).
     1209   define buffer base-price        for ub.price-list.
     1210   define variable local-main-code like ub.bar-code.b-code no-undo.
     1211   define variable local-base-code like ub.bar-code.b-code no-undo.
     1212     run prc-base-code (input local-bc, output local-base-code).
     1213     find base-price no-lock where
     1214          base-price.doc-num = local-doc-num and
     1215          base-price.b-code  = local-base-code and
     1216          base-price.price-type = "" no-error.
     1217     if not available base-price then do:
     1218       run prc-main-code (input local-bc, output local-main-code).
     1219       find  base-price no-lock where
     1220             base-price.doc-num = local-doc-num and
     1221             base-price.b-code  = local-main-code and
     1222             base-price.price-type = "" no-error.
     1223     end.
     1224     if available base-price then
     1225       return (base-price.price-sale).
     1226     else
     1227       return (?).
     1228   END FUNCTION.
     1229   procedure prc-main-code:
     1230   define input  parameter local-bc        like ub.bar-code.b-code no-undo.
     1231   define output parameter local-main-code like ub.bar-code.b-code no-undo.
     1232   define buffer local-bar-code        for ub.bar-code.
     1233   define buffer local-goods           for ub.goods.
     1234   define buffer main-code             for ub.bar-code.
     1235   define buffer main-prt              for ub.gds-prt.
     1236     local-main-code = ?.
     1237     find local-bar-code no-lock where
     1238          local-bar-code.b-code = local-bc no-error.
     1239     if not available local-bar-code then
     1240       return.
     1241     find local-goods no-lock where
     1242          local-goods.gds-code = local-bar-code.gds-code.
     1243     find first  main-prt no-lock where
     1244                 main-prt.upper-code = local-goods.prt-root.
     1245     find  main-code no-lock where
     1246           main-code.gds-code  = local-bar-code.gds-code and
     1247           main-code.in-code   = "" and
     1248           main-code.part-code = "" and
     1249           main-code.unit-cli  = local-goods.unit-base and
     1250           main-code.node-code = main-prt.node-code.
     1251     local-main-code = main-code.b-code.
     1252   end procedure.
     1253   procedure prc-base-code:
     1254   define input  parameter local-bc        like ub.bar-code.b-code no-undo.
     1255   define output parameter local-base-code like ub.bar-code.b-code no-undo.
     1256   define buffer local-bar-code for ub.bar-code.
     1257   define buffer local-goods    for ub.goods.
     1258   define buffer base-code      for ub.bar-code.
     1259     local-base-code = ?.
     1260     find local-bar-code no-lock where
     1261          local-bar-code.b-code = local-bc no-error.
     1262     if not available local-bar-code then
     1263       return.
     1264     find local-goods no-lock where
     1265          local-goods.gds-code = local-bar-code.gds-code.
     1266     find base-code no-lock where
     1267          base-code.gds-code  = local-bar-code.gds-code and
     1268          base-code.node-code = local-bar-code.node-code and
     1269          base-code.in-code   = local-bar-code.in-code and
     1270          base-code.part-code = local-bar-code.part-code and
     1271          base-code.unit-cli  = local-goods.unit-base.
     1272     local-base-code = base-code.b-code.
     1273   end procedure.
     1274   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1275   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1276   procedure prcreate-new-price-doc :
     1277   do
     1278   on error undo, return error return-value
     1279   :
     1280   define input  parameter p-curr-db-num  as integer   no-undo .
     1281   define input  parameter p-obj-type     like ub.price-doc.obj-type no-undo.
     1282   define input  parameter p-obj-code     like ub.price-doc.obj-code no-undo.
     1283   define input  parameter p-plt-id       as integer   no-undo .
     1284   define input  parameter p-plt-db-num   as integer   no-undo .
     1285   define input  parameter p-pdf-id       as integer   no-undo .
     1286   define input  parameter p-pdf-db-num   as integer   no-undo .
     1287   define output parameter p-price-doc-recid  as recid                no-undo.
     1288   define variable v-host-code         like ub.sysconf.host-code        no-undo.
     1289   define variable v-obj-current-date  like ub.price-doc.doc-date      no-undo.
     1290   define variable v-base-rate    like ub.price-doc-forming.base-rate   no-undo .
     1291   define variable v-base-scale   like ub.price-doc-forming.base-scale  no-undo .
     1292   define buffer buf_price-doc-forming for ub.price-doc-forming.
     1293   define buffer buf_price-doc         for ub.price-doc.
     1294   find first buf_price-doc-forming no-lock where
     1295              buf_price-doc-forming.pdf-db     = p-pdf-db-num and
     1296              buf_price-doc-forming.pdf-id     = p-pdf-id     and
     1297              buf_price-doc-forming.plt-db-num = p-plt-db-num and
     1298              buf_price-doc-forming.plt-id     = p-plt-id
     1299              no-error .
     1300   if not available buf_price-doc-forming and p-plt-id = ? then do:
     1301      run create_new_price-doc-forming
     1302           ( input p-obj-type ,
     1303             input p-obj-code ,
     1304             output p-pdf-db-num ,
     1305             output p-pdf-id ,
     1306             output p-plt-db-num ,
     1307             output p-plt-id
     1308             ).
     1309       find first buf_price-doc-forming no-lock where
     1310                 buf_price-doc-forming.pdf-db     = p-pdf-db-num and
     1311                 buf_price-doc-forming.pdf-id     = p-pdf-id     and
     1312                 buf_price-doc-forming.plt-db-num = p-plt-db-num and
     1313                 buf_price-doc-forming.plt-id     = p-plt-id
     1314                 no-error .
     1315   end.
     1316       create buf_price-doc .
     1317       run doc-code in this-procedure
     1318       (input  "main",
     1319        input  p-obj-type  ,
     1320        input  p-obj-code  ,
     1321        input  ?,
     1322        output buf_price-doc.doc-num) no-error.
     1323       if error-status:error then do:
     1324         message vss-workfile vss-revision vss-description skip
     1325                error-status :get-message(1)
     1326               "Ошибка при генерации номера документа." return-value view-as alert-box error.
     1327         return error.
     1328       end.
     1329   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1330   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1331     (input  p-obj-type
     1332     ,input  p-obj-code
     1333     ,output v-host-code
     1334     )  .
     1335       v-obj-current-date  = today .
     1336       if not (buf_price-doc-forming.base-rate = 0 or buf_price-doc-forming.base-rate = ?) then do:
     1337           v-base-rate   =  buf_price-doc-forming.base-rate  .
     1338           v-base-scale  =  buf_price-doc-forming.base-scale .
     1339       end.
     1340       else do:
     1341   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1342   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run baserate in g#library
     1343     (input  v-host-code
     1344     ,input  v-obj-current-date
     1345     ,output v-base-rate
     1346     ,output v-base-scale
     1347     )  .
     1348       end.
     1349      assign
     1350       buf_price-doc.base-rate      = v-base-rate
     1351       buf_price-doc.base-scale     = v-base-scale
     1352       buf_price-doc.cr-db-num      = p-curr-db-num
     1353       buf_price-doc.doc-date       = v-obj-current-date
     1354       buf_price-doc.fact-num       = 0
     1355       buf_price-doc.host-code      = v-host-code
     1356       buf_price-doc.is-corr        = false
     1357       buf_price-doc.is-del         = false
     1358       buf_price-doc.obj-code       = p-obj-code
     1359       buf_price-doc.obj-type       = p-obj-type
     1360       buf_price-doc.out-code       = ""
     1361       buf_price-doc.pdf-db         = p-pdf-db-num
     1362       buf_price-doc.pdf-id         = p-pdf-id
     1363       buf_price-doc.plt-db-num     = p-plt-db-num
     1364       buf_price-doc.plt-id         = p-plt-id
     1365       buf_price-doc.PS             = "@ "
     1366       buf_price-doc.rest-base      = 0
     1367       buf_price-doc.rest-last      = 0
     1368       buf_price-doc.rest-qnty      = 0
     1369       buf_price-doc.rest-sale      = 0
     1370       buf_price-doc.sale-base      = 0
     1371       buf_price-doc.status_        = 'новый':U
     1372       .
     1373       buf_price-doc.doc-num-es     = entry(1, buf_price-doc-forming.des, chr(4)) no-error.
     1374       buf_price-doc.uid-es         = entry(2, buf_price-doc-forming.des, chr(4)) no-error.
     1375       buf_price-doc.doc-date       = date(entry(3, buf_price-doc-forming.des, chr(4))) no-error.
     1376       if buf_price-doc.uid-es = "_" then buf_price-doc.uid-es = "" .
     1377       assign
     1378           p-price-doc-recid = recid ( buf_price-doc )
     1379       .
     1380   end.
     1381   end procedure.
     1382   procedure prcreate-new-price-list :
     1383   do
     1384   on error undo, return error return-value
     1385   :
     1386   define input parameter p-price-doc-recid   as recid                    no-undo.
     1387   define input parameter p-gds-code          like ub.goods.gds-code         no-undo.
     1388   define input parameter p-price-sale        like ub.price-list.price-sale  no-undo.
     1389   define output parameter p-update           as logical                  no-undo.
     1390   define variable kk as integer no-undo .
     1391   define var v-b-code    like ub.bar-code.b-code     no-undo.
     1392   define variable p-hostcode as int no-undo .
     1393   define variable local_vat-pc like ub.price-list.vat-pc    no-undo.
     1394   define variable local_slt-pc like ub.price-list.slt-pc    no-undo.
     1395   define buffer buf_price-doc        for ub.price-doc.
     1396   define buffer buf_price-list       for ub.price-list.
     1397   define buffer buf_bar-code         for ub.bar-code.
     1398   define buffer buf_goods            for ub.goods.
     1399   define buffer buf_root_gds-prt     for ub.gds-prt.
     1400   define buffer buf_gds-prt          for ub.gds-prt.
     1401   find first buf_price-doc no-lock
     1402        where recid( buf_price-doc ) = p-price-doc-recid
     1403   .
     1404   find first buf_goods no-lock
     1405        where buf_goods.gds-code = p-gds-code
     1406   .
     1407   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     1408     (input  p-gds-code
     1409     ,input  ?
     1410     ,output v-b-code
     1411     ) no-error .
     1412   if error-status :error
     1413   then do:
     1414       message
     1415           "Не найден основной бар-код"
     1416           skip "для товара "
     1417           skip string(buf_goods.artic)
     1418           skip buf_goods.gds-name
     1419       view-as alert-box
     1420       title "Ошибка при выполнении prcreate.i".
     1421       undo, return error .
     1422   end.
     1423   find first buf_bar-code no-lock
     1424        where buf_bar-code.b-code = v-b-code
     1425   no-error.
     1426   if error-status :error
     1427   then do:
     1428       message
     1429           "Не найдена запись bar-code"
     1430           skip "для товара "
     1431           skip string(buf_goods.artic)
     1432           skip buf_goods.gds-name
     1433           skip "С основным бар-кодом"
     1434           skip string(v-b-code)
     1435       view-as alert-box
     1436       title "Ошибка при выполнении prcreate.i".
     1437       undo, return error .
     1438   end.
     1439   find first buf_root_gds-prt no-lock
     1440        where buf_root_gds-prt.upper-code = buf_goods.prt-root
     1441   .
     1442   if buf_root_gds-prt.node-name <> '_Пустая шкала':U
     1443     and buf_bar-code.in-code <> ""
     1444   then do:
     1445       message
     1446           "Не допускается создавать спец. цены на партии для товаров с непустой шкалой!" skip (2)
     1447           "Артикул:" buf_goods.artic "Код:" buf_goods.gds-code buf_goods.gds-name
     1448           view-as alert-box error.
     1449       undo, return error.
     1450   end.
     1451   find first buf_gds-prt no-lock
     1452        where buf_gds-prt.node-code = buf_bar-code.node-code
     1453   .
     1454   find first buf_price-list
     1455        where buf_price-list.doc-num = buf_price-doc.doc-num
     1456          and buf_price-list.b-code  = v-b-code
     1457   no-error.
     1458   if available buf_price-list
     1459   then do:
     1460       message "Строка с товаром арт." buf_price-list.artic " уже есть в данной переоценке."
     1461          skip "  Цена:   " buf_price-list.price-sale
     1462          skip "Цена будет изменена"
     1463       view-as alert-box warning.
     1464       assign
     1465           p-update = yes
     1466       .
     1467   end.
     1468   else do:
     1469   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1470   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1471     (input  buf_price-doc.obj-type
     1472     ,input  buf_price-doc.obj-code
     1473     ,output p-hostcode
     1474     ) no-error .
     1475   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1476   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     1477     (input  buf_goods.gds-code
     1478     ,input  '1':U
     1479     ,input  ?
     1480     ,input  p-hostcode
     1481     ,input  buf_price-doc.obj-type
     1482     ,input  buf_price-doc.obj-code
     1483     ,output local_vat-pc
     1484     ) no-error .
     1485   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1486   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     1487     (input  buf_goods.gds-code
     1488     ,input  '2':U
     1489     ,input  ?
     1490     ,input  p-hostcode
     1491     ,input  buf_price-doc.obj-type
     1492     ,input  buf_price-doc.obj-code
     1493     ,output local_slt-pc
     1494     ) no-error .
     1495       kk = kk + 1.
     1496   define variable v-main-bar-code as integer   no-undo .
     1497   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     1498     (input  buf_goods.gds-code
     1499     ,input  ?
     1500     ,output v-main-bar-code
     1501     )  .
     1502       create buf_price-list.
     1503       assign
     1504           buf_price-list.line-num    = kk
     1505           buf_price-list.doc-num     = buf_price-doc.doc-num
     1506           buf_price-list.b-code      = buf_bar-code.b-code
     1507           buf_price-list.artic       = buf_goods.artic
     1508           buf_price-list.prod-type   = buf_goods.prod-type
     1509           buf_price-list.prod-code   = buf_goods.prod-code
     1510           buf_price-list.main-price  = (buf_bar-code.b-code = v-main-bar-code )
     1511           buf_price-list.calc-method = 'Отсутствует':U
     1512           buf_price-list.obj-type    = buf_price-doc.obj-type
     1513           buf_price-list.obj-code    = buf_price-doc.obj-code
     1514           buf_price-list.price-sale  = p-price-sale
     1515           buf_price-list.vat-pc      = local_vat-pc
     1516           buf_price-list.slt-pc      = local_slt-pc
     1517           p-update                   = no
