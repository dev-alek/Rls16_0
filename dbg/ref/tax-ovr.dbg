     2610     ,input  buf-price-doc.obj-type
     2611     ,input  buf-price-doc.obj-code
     2612     ,output local_slt-pc
     2613     ) no-error .
     2614   define variable vss-include-info34 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2615   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     2616     (input  buf-price-doc.obj-type
     2617     ,input  buf-price-doc.obj-code
     2618     ,input  bc
     2619     ,input  0
     2620     ,input  0
     2621     ,output cur-dn
     2622     ,output cur-pr
     2623     ,output cur-rt
     2624     ,output cur-ex
     2625     ) no-error .
     2626     find first buf-price-list where
     2627               buf-price-list.b-code  = buf-bar-code.b-code and
     2628               buf-price-list.doc-num = new-num  and
     2629               buf-price-list.price-type = ""    no-error .
     2630     if not available buf-price-list then do:
     2631       run calc-price-line-num (input  new-num , output v-line-num) .
     2632       create buf-price-list.
     2633       assign
     2634         buf-price-list.line-num  = v-line-num
     2635         buf-price-list.b-code    = buf-bar-code.b-code
     2636         buf-price-list.doc-num   = buf-price-doc.doc-num
     2637         buf-price-list.prod-type = buf-goods.prod-type
     2638         buf-price-list.prod-code = buf-goods.prod-code
     2639         buf-price-list.artic     = buf-goods.artic
     2640         buf-price-list.obj-type  = buf-price-doc.obj-type
     2641         buf-price-list.obj-code  = buf-price-doc.obj-code
     2642         buf-price-list.vat-pc    = local_vat-pc
     2643         buf-price-list.slt-pc    = local_slt-pc
     2644         buf-price-list.price-prev = cur-pr
     2645         .
     2646       if  buf-gds-prt.upper-code = buf-goods.prt-root and
     2647           buf-bar-code.in-code   = "" and
     2648           buf-bar-code.part-code = "" and
     2649           buf-bar-code.unit-cli  = buf-goods.unit-base then do:
     2650         buf-price-list.main-price = yes.
     2651         if cur-pr <> ? then do:
     2652           run exp-prt (input buf-goods.gds-code,
     2653                       input cur-dn,
     2654                       input new-num,
     2655                       output new-rec) no-error.
     2656           if error-status :error then do:
     2657             message
     2658               "Ошибка вызова процедуры разворота специальных и неосновных цен."
     2659               view-as alert-box error.
     2660             undo cre-pr, return error.
     2661           end.
     2662         end.
     2663       end.
     2664       else do:
     2665         if buf-bar-code.unit-cli <> buf-goods.unit-base then do:
     2666           buf-price-list.d-pcnt = ?.
     2667         end.
     2668         buf-price-list.main-price = no.
     2669       end.
     2670     end.
     2671   end.
     2672   new-rec = recid (buf-price-list).
     2673   END PROCEDURE.
     2674   procedure calc-price-line-num :
     2675    do
     2676    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     2677    :
     2678   define input parameter p-doc-num as character no-undo .
     2679   define output parameter p-num  as integer no-undo .
     2680   define variable v-fact as integer no-undo .
     2681   define buffer buf_1_price-list for ub.price-list .
     2682   p-num = 1 .
     2683   find last  buf_1_price-list no-lock where
     2684              buf_1_price-list.doc-num = p-doc-num use-index line-num no-error .
     2685              if available buf_1_price-list then
     2686                   assign
     2687                     v-fact = buf_1_price-list.line-num
     2688                   .
     2689   v-fact = v-fact + 1.
     2690   if v-fact <> ? then if p-num < v-fact then p-num = v-fact .
     2691    end.
     2692   end procedure.
     2693   PROCEDURE del-pr-list:
     2694   define input parameter bc    like ub.bar-code.b-code   no-undo.
     2695   define input parameter d-num like ub.price-doc.doc-num no-undo.
     2696   define input parameter round-method as character         no-undo.
     2697   define input parameter round-base   as decimal      no-undo.
     2698   define buffer buf-price-list for ub.price-list.
     2699   define buffer buf-bar-code   for ub.bar-code.
     2700   define buffer buf-goods      for ub.goods.
     2701   define variable l-ov-on as logical no-undo .
     2702   del-pr:
     2703   do on error undo del-pr, return error:
     2704     find first  buf-price-list no-lock where
     2705                 buf-price-list.doc-num    = d-num and
     2706                 buf-price-list.b-code     = bc and
     2707                 buf-price-list.price-type = "" no-error.
     2708     if not available buf-price-list then
     2709       undo del-pr, return error.
     2710     find  buf-goods no-lock where
     2711           buf-goods.prod-type = buf-price-list.prod-type and
     2712           buf-goods.prod-code = buf-price-list.prod-code and
     2713           buf-goods.artic     = buf-price-list.artic.
     2714     if buf-price-list.main-price then do:
     2715       for each  buf-price-list exclusive-lock where
     2716                 buf-price-list.doc-num   = d-num and
     2717                 buf-price-list.artic     = buf-goods.artic and
     2718                 buf-price-list.prod-type = buf-goods.prod-type and
     2719                 buf-price-list.prod-code = buf-goods.prod-code,
     2720           first buf-bar-code no-lock where
     2721                 buf-bar-code.b-code = buf-price-list.b-code
     2722       on error undo del-pr, return error:
     2723   define variable vss-include-info35 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2724   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjat in g#library
     2725     (input  ub.buf-price-list.obj-type
     2726     ,input  ub.buf-price-list.obj-code
     2727     ,input  ub.buf-price-list.artic
     2728     ,input  ub.buf-price-list.prod-type
     2729     ,input  ub.buf-price-list.prod-code
     2730     ,input  'ov-on=request:exclusive'
     2731     ,output l-ov-on
     2732     ) no-error .
     2733         if error-status:error then do:
     2734           message
     2735             vss-workfile vss-revision vss-description skip
     2736             "Ошибка получения признака товара на объекте" skip
     2737             error-status :get-message(1) skip
     2738             return-value skip
     2739             view-as alert-box error .
     2740         end.
     2741         if l-ov-on then do:
     2742   define variable vss-include-info36 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2743   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjat in g#library
     2744     (input  ub.buf-price-list.obj-type
     2745     ,input  ub.buf-price-list.obj-code
     2746     ,input  ub.buf-price-list.artic
     2747     ,input  ub.buf-price-list.prod-type
     2748     ,input  ub.buf-price-list.prod-code
     2749     ,input  'ov-on=false'
     2750     ,output l-ov-on
     2751     ) no-error .
     2752           if error-status :error then do:
     2753           end.
     2754          end.
     2755         delete buf-price-list.
     2756       end.
     2757     end.
     2758     else do:
     2759       find  buf-bar-code no-lock where
     2760             buf-bar-code.b-code = buf-price-list.b-code.
     2761       if buf-bar-code.unit-cli <> buf-goods.unit-base then do:
     2762         message
     2763           "Нельзя удалить неосновную цену." skip
     2764           "Неосновная цена (скидка) не может быть неопределенной." skip
     2765           "Код:" bc skip
     2766           "Переоценка:" d-num
     2767           view-as alert-box error.
     2768         undo del-pr, return error.
     2769       end.
     2770       find current buf-price-list exclusive-lock no-error .
     2771       delete buf-price-list.
     2772       run calc-base-upd (input buf-bar-code.b-code,
     2773                         input d-num,
     2774                         input round-method,
     2775                         input round-base) no-error.
     2776       if error-status :error then
     2777         undo del-pr, return error.
     2778     end.
     2779   end.
     2780   END PROCEDURE.
     2781   PROCEDURE calc-base-upd:
     2782   define input parameter bc    like ub.bar-code.b-code   no-undo.
     2783   define input parameter d-num like ub.price-doc.doc-num no-undo.
     2784   define input parameter round-method as character         no-undo.
     2785   define input parameter round-base   as decimal      no-undo.
     2786   define buffer alt-bar-code   for ub.bar-code.
     2787   define buffer alt-price-list for ub.price-list.
     2788   define buffer buf-bar-code   for ub.bar-code.
     2789   define buffer buf-goods      for ub.goods.
     2790   calc-base:
     2791   do on error undo calc-base, return error:
     2792     find  buf-bar-code no-lock where
     2793           buf-bar-code.b-code = bc.
     2794     find  buf-goods no-lock where
     2795           buf-goods.gds-code = buf-bar-code.gds-code.
     2796     for each  alt-bar-code no-lock where
     2797               alt-bar-code.gds-code  = buf-bar-code.gds-code and
     2798               alt-bar-code.node-code = buf-bar-code.node-code and
     2799               alt-bar-code.part-code = buf-bar-code.part-code and
     2800               alt-bar-code.in-code   = buf-bar-code.in-code and
     2801               alt-bar-code.unit-cli <> buf-goods.unit-base,
     2802         each  alt-price-list where
     2803               alt-price-list.doc-num    = d-num and
     2804               alt-price-list.b-code     = alt-bar-code.b-code and
     2805               alt-price-list.price-type = ""
     2806         on error undo calc-base, return error:
     2807       run calc-pr-alt (input d-num,
     2808                       input alt-bar-code.b-code,
     2809                       input round-method,
     2810                       input round-base) no-error.
     2811       if error-status:error then
     2812         undo calc-base, return error.
     2813     end.
     2814   end.
     2815   END PROCEDURE.
     2816   PROCEDURE calc-pr-alt:
     2817   define input parameter d-num like ub.price-doc.doc-num no-undo.
     2818   define input parameter bc    like ub.bar-code.b-code   no-undo.
     2819   define input parameter r-method as character             no-undo.
     2820   define input parameter r-base   as decimal              no-undo.
     2821   define buffer buf-price-doc  for ub.price-doc.
     2822   define buffer buf-price-list for ub.price-list.
     2823   define buffer buf-bar-code   for ub.bar-code.
     2824   define buffer buf-goods      for ub.goods.
     2825   define buffer old-price-list for ub.price-list.
     2826   define variable pr-rec   as   recid                  no-undo.
     2827   define variable pr-c-b-r like ub.bar-code.cli-base-rate no-undo.
     2828   pr-alt:
     2829   do on error undo pr-alt, return error:
     2830     if r-method = ? or
     2831        r-base = ? then do:
     2832       message
     2833         "Нельзя удалить основную цену." skip
     2834         "Не задан способ округления для расчета зависящих от нее неосновных цен." skip
     2835         "Код:" bc skip
     2836         "Переоценка:" d-num
     2837         view-as alert-box error.
     2838       undo pr-alt, return error.
     2839     end.
     2840     find  buf-price-doc where
     2841           buf-price-doc.doc-num = d-num.
     2842     find  buf-bar-code no-lock where
     2843           buf-bar-code.b-code = bc.
     2844     find  buf-goods no-lock where
     2845           buf-goods.gds-code = buf-bar-code.gds-code.
     2846     find  buf-price-list where
     2847           buf-price-list.doc-num = buf-price-doc.doc-num and
     2848           buf-price-list.b-code  = bc.
     2849     if buf-price-list.d-pcnt = ? then do:
     2850   define variable vss-include-info37 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2851   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodepls in g#library
     2852     (input  buf-price-doc.obj-type
     2853     ,input  buf-price-doc.obj-code
     2854     ,input  bc
     2855     ,input  0
     2856     ,input  0
     2857     ,output pr-rec
     2858     ,output pr-c-b-r
     2859     )  .
     2860       find old-price-list no-lock where
     2861           recid (old-price-list) = pr-rec no-error.
     2862       if available old-price-list and
     2863         old-price-list.b-code = bc then
     2864         buf-price-list.d-pcnt = old-price-list.d-pcnt.
     2865       else
     2866         buf-price-list.d-pcnt = 0.
     2867     end.
     2868      if buf-price-list.d-pcnt = ? then do:
     2869         assign
     2870           buf-price-list.price-sale =   if available old-price-list then old-price-list.price-sale else 0
     2871           buf-price-list.calc-method =  'Не-считать':U + 'Основная':U
     2872           .
     2873     end.
     2874     else do:
     2875         assign
     2876           buf-price-list.price-sale =   fnc-base-price (buf-bar-code.b-code, buf-price-list.doc-num) *
     2877                                         buf-bar-code.cli-base-rate *
     2878                                         (1 - buf-price-list.d-pcnt / 100)
     2879           buf-price-list.calc-method =  'Основная':U
     2880           .
     2881   case r-method :
     2882     when '9-окончание':U then do:
     2883       if buf-price-list.price-sale < 29 then do:
     2884         if (buf-price-list.price-sale - truncate (buf-price-list.price-sale, 0)) <> 0 then do:
     2885           assign
     2886             buf-price-list.price-sale = truncate (buf-price-list.price-sale, 0) + 1
     2887           .
     2888         end.
     2889       end.
     2890       else do:
     2891         if (buf-price-list.price-sale modulo 10) < 3 then do:
     2892           assign
     2893             buf-price-list.price-sale = (buf-price-list.price-sale - (buf-price-list.price-sale modulo 100))
     2894                 + ( truncate (((buf-price-list.price-sale modulo 100) / 10), 0)
     2895                   - 1 ) * 10
     2896                 + 9
     2897           .
     2898         end.
     2899         else do:
     2900           assign
     2901             buf-price-list.price-sale = (buf-price-list.price-sale - (buf-price-list.price-sale modulo 100))
     2902                 + ( truncate (((buf-price-list.price-sale modulo 100) / 10), 0)
     2903                   ) * 10
     2904                 + 9
     2905           .
     2906         end.
     2907         assign
     2908           buf-price-list.price-sale = round (buf-price-list.price-sale, 0)
     2909         .
     2910       end.
     2911     end.
     2912     when '9-99окончание':U then do:
     2913       if buf-price-list.price-sale < r-base then do:
     2914         assign
     2915           buf-price-list.price-sale = truncate (buf-price-list.price-sale, 0) + 0.99
     2916         .
     2917       end.
     2918       else do:
     2919         assign
     2920           buf-price-list.price-sale = truncate (buf-price-list.price-sale / 10 , 0) * 10 + 9.99
     2921         .
     2922       end.
     2923     end.
     2924     when 'Без-дробных':U then do:
     2925       assign
     2926         buf-price-list.price-sale = round (buf-price-list.price-sale, 0)
     2927       .
     2928     end.
     2929     when 'Произвольно':U then do:
     2930       if r-base <> 0 then do:
     2931         assign
     2932           buf-price-list.price-sale = round (buf-price-list.price-sale / r-base, 0) * r-base
     2933         .
     2934         if buf-price-list.price-sale = 0 then do:
     2935           assign
     2936             buf-price-list.price-sale = r-base
     2937           .
     2938         end.
     2939       end.
     2940     end.
     2941     when 'Вверх':U then do:
     2942       if r-base <> 0 then do:
     2943         if truncate ( buf-price-list.price-sale / r-base, 0 ) <> (buf-price-list.price-sale / r-base) then do:
     2944           assign
     2945             buf-price-list.price-sale = truncate (buf-price-list.price-sale / r-base, 0) * r-base + r-base
     2946           .
     2947         end.
     2948       end.
     2949       if buf-price-list.price-sale = 0 then do:
     2950         assign
     2951           buf-price-list.price-sale = r-base
     2952         .
     2953       end.
     2954     end.
     2955     when 'Коэффициент':U then do:
     2956       if r-base <> 0 then do:
     2957         assign
     2958           buf-price-list.price-sale = buf-price-list.price-sale * r-base
     2959         .
     2960       end.
     2961     end.
     2962     when 'Отключено':U then do:
     2963     end.
     2964     otherwise do:
     2965       message
     2966         vss-workfile vss-revision vss-description skip
     2967         "Неизвестный метод округления продажной цены" skip
     2968         "round-method" r-method skip
     2969         "round-base"   r-base   skip
     2970         "price"        buf-price-list.price-sale             skip
     2971         view-as alert-box error .
     2972     end.
     2973   end.
     2974     end.
     2975   end.
     2976   END PROCEDURE.
     2977   PROCEDURE calc-pr-discnt:
     2978   define input parameter d-num like ub.price-doc.doc-num no-undo.
     2979   define input parameter bc    like ub.bar-code.b-code   no-undo.
     2980   define buffer buf-price-doc  for ub.price-doc.
     2981   define buffer buf-price-list for ub.price-list.
     2982   define buffer buf-bar-code   for ub.bar-code.
     2983   define buffer buf-goods      for ub.goods.
     2984   define buffer old-price-list for ub.price-list.
     2985   define variable pr-rec   as   recid                  no-undo.
     2986   define variable pr-c-b-r like ub.bar-code.cli-base-rate no-undo.
     2987   pr-discnt:
     2988   do on error undo pr-discnt, return error:
     2989     find  buf-price-doc where
     2990           buf-price-doc.doc-num = d-num.
     2991     find  buf-bar-code no-lock where
     2992           buf-bar-code.b-code = bc.
     2993     find  buf-goods no-lock where
     2994           buf-goods.gds-code = buf-bar-code.gds-code.
     2995     find  buf-price-list where
     2996           buf-price-list.doc-num = buf-price-doc.doc-num and
     2997           buf-price-list.b-code  = bc.
     2998     buf-price-list.d-pcnt = (1 -
     2999                              buf-price-list.price-sale /
     3000                              fnc-base-price (buf-bar-code.b-code, buf-price-list.doc-num) /
     3001                              buf-bar-code.cli-base-rate) *
     3002                              100
     3003                              .
     3004   end.
     3005   END PROCEDURE.
     3006   PROCEDURE calc-pr-sub :
     3007   define  input  parameter bc             like ub.price-list.b-code no-undo.
     3008   define  input  parameter d-num          like ub.price-doc.doc-num no-undo.
     3009   define  input  parameter calc-method  as character    no-undo.
     3010   define  input  parameter increase-pc  as decimal      no-undo.
     3011   define  input  parameter round-method as character    no-undo.
     3012   define  input  parameter round-base   as decimal      no-undo.
     3013   define  output parameter calc-rec     as recid        no-undo.
     3014   define  buffer buf-price-list for ub.price-list.
     3015   define  buffer buf-bar-code   for ub.bar-code.
     3016   define  buffer buf-goods      for ub.goods.
     3017   define  buffer buf-gds-prt    for ub.gds-prt.
     3018   define  buffer buf-gds-grp    for ub.gds-grp.
     3019   define  buffer buf-price-doc  for ub.price-doc.
     3020   calc-sub:
     3021   do on error undo calc-sub, return error:
     3022     find  buf-bar-code no-lock where
     3023           buf-bar-code.b-code = bc.
     3024     find  buf-goods no-lock where
     3025           buf-goods.gds-code = buf-bar-code.gds-code.
     3026     find  buf-gds-prt no-lock where
     3027           buf-gds-prt.node-code = buf-bar-code.node-code.
     3028     find  buf-price-list where
     3029           buf-price-list.doc-num    = d-num and
     3030           buf-price-list.b-code     = bc and
     3031           buf-price-list.price-type = "".
     3032     find  buf-price-doc where
     3033           buf-price-doc.doc-num = d-num.
     3034     calc-rec = recid (buf-price-list).
     3035     if buf-price-list.main-price then do:
     3036       for each  buf-price-list where
     3037                 buf-price-list.doc-num    = buf-price-doc.doc-num and
     3038                 buf-price-list.main-price = no and
     3039                 buf-price-list.artic      = buf-goods.artic and
     3040                 buf-price-list.prod-type  = buf-goods.prod-type and
     3041                 buf-price-list.prod-code  = buf-goods.prod-code,
     3042           first buf-bar-code no-lock where
     3043                 buf-bar-code.b-code   = buf-price-list.b-code and
     3044                 buf-bar-code.unit-cli = buf-goods.unit-base
     3045           on error undo calc-sub, return error:
     3046         run calc-pr-list (input  buf-bar-code.b-code,
     3047                           input  buf-price-list.doc-num,
     3048                           input  calc-method,
     3049                           input  increase-pc,
     3050                           input  round-method,
     3051                           input  round-base,
     3052                           input ? ,
     3053                           input ? ,
     3054                           input ? ,
     3055                           input ? ,
     3056                           output calc-rec) no-error.
     3057         if error-status :error then
     3058           undo calc-sub, return error.
     3059         calc-rec = recid (buf-price-list).
     3060       end.
     3061       for each  buf-price-list where
     3062                 buf-price-list.doc-num    = buf-price-doc.doc-num and
     3063                 buf-price-list.main-price = no and
     3064                 buf-price-list.artic      = buf-goods.artic and
     3065                 buf-price-list.prod-type  = buf-goods.prod-type and
     3066                 buf-price-list.prod-code  = buf-goods.prod-code,
     3067           first buf-bar-code no-lock where
     3068                 buf-bar-code.b-code    = buf-price-list.b-code and
     3069                 buf-bar-code.unit-cli <> buf-goods.unit-base
     3070           on error undo calc-sub, return error:
     3071         run calc-pr-alt (input buf-price-doc.doc-num,
     3072                         input buf-bar-code.b-code,
     3073                         input round-method,
     3074                         input round-base) no-error.
     3075         if error-status :error then
     3076           undo calc-sub, return error.
     3077       end.
     3078     end.
     3079     else do:
     3080       run calc-base-upd (input buf-bar-code.b-code,
     3081                         input buf-price-doc.doc-num,
     3082                         input round-method,
     3083                         input round-base) no-error.
     3084       if error-status :error then
     3085         undo calc-sub, return error.
     3086     end.
     3087   end.
     3088   END PROCEDURE.
     3089   procedure ver-pr-nogds :
     3090   define input  parameter p-gds-code      as integer   no-undo .
     3091   define input  parameter p-par-pr-nogds  as character no-undo .
     3092   define output parameter p-not           as logical   no-undo .
     3093   define output parameter p-str           as character no-undo .
     3094   define buffer buf_goods for ub.goods  .
     3095   define variable nn as integer   no-undo .
     3096   define variable ii as integer   no-undo .
     3097   define variable v-namegrp as character no-undo .
     3098     do
     3099     on error undo, return error return-value
     3100     :
     3101     if p-par-pr-nogds = "1" then do:
     3102        assign
     3103         p-not = true
     3104         p-str = ""
     3105        .
     3106        return .
     3107     end.
     3108     assign
     3109       p-not = false
     3110       p-str = ""
     3111     .
     3112     find first buf_goods no-lock where
     3113                buf_goods.gds-code = p-gds-code no-error .
     3114     nn = num-entries(par-pr-nogds-long,chr(4)) .
     3115     repeat ii = 1 to nn:
     3116        v-namegrp = entry(ii , par-pr-nogds-long , chr(4) ) no-error .
     3117        if buf_goods.grp-name  begins v-namegrp  then do:
     3118           assign
     3119             p-not = true
     3120             p-str = substitute ( "Товар &1 &2 &3  может быть включен в ДНЦ из-за исключения запрета по группе : &4"  , buf_goods.artic, buf_goods.gds-name , buf_goods.grp-name , v-namegrp )
     3121           .
     3122           leave .
     3123        end.
     3124     end.
     3125     end.
     3126   end procedure.
     3127   define variable vss-include-info38 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3128   define variable vss-include-info39 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3129   define temp-table tt-level-dis-attr no-undo
     3130         field attr-code   like global-state-attr.attr-code
     3131         field attr-value  like global-state-attr.attr-value
     3132         index pi   attr-value descending
     3133         index pi1 is unique attr-value
     3134               attr-code .
     3135   procedure lvldsc-byattr :
     3136   define input  parameter p-attr-code  as character no-undo .
     3137   define input  parameter p-attr-value as character no-undo .
     3138   define output parameter p-val1       as decimal   no-undo .
     3139   define output parameter p-val2       as decimal   no-undo .
     3140   define output parameter p-prc        as decimal   no-undo .
     3141     do
     3142     on error undo, return error return-value
     3143     :
     3144     define variable v-str1 as character no-undo .
     3145     v-str1 = trim ( p-attr-code , 'level-discnt':U ) .
     3146     v-str1 = trim ( v-str1 , chr(4) ) .
     3147    run lvldsc-bytt (
     3148         input   v-str1
     3149       , input   p-attr-value
     3150       , output  p-val1
     3151       , output  p-val2
     3152       , output  p-prc )
     3153         no-error .
     3154     end.
     3155   end procedure.
     3156   procedure lvldsc-bytt :
     3157   define input  parameter p-attr-code as character no-undo .
     3158   define input  parameter p-attr-value as character no-undo .
     3159   define output parameter p-val1 as decimal   no-undo .
     3160   define output parameter p-val2 as decimal   no-undo .
     3161   define output parameter p-prc  as decimal   no-undo .
     3162   define variable v-str1 as character no-undo .
     3163     do
     3164     on error undo, return error return-value
     3165     :
     3166     assign
     3167        v-str1 = trim ( p-attr-code , "[]()" )
     3168        p-val1 = decimal(entry(1,v-str1, ";"))
     3169        p-val2 = decimal(entry(2,v-str1, ";"))
     3170        p-prc  = decimal(p-attr-value)
     3171        no-error
     3172     .
     3173     end.
     3174   end procedure.
     3175   procedure level-dis-value :
     3176   define input  parameter p-price-prod as decimal   no-undo .
     3177   define input  parameter p-b-code     as integer   no-undo .
     3178   define input  parameter p-obj-type   as character no-undo .
     3179   define input  parameter p-obj-code   as integer   no-undo .
     3180   define output parameter p-prc as decimal   no-undo .
     3181   define variable v-level-dis-attr as character no-undo .
     3182   define variable v-type as character no-undo .
     3183   define variable v-val1 as decimal   no-undo .
     3184   define variable v-val2 as decimal   no-undo .
     3185   define variable v-prc  as decimal   no-undo .
     3186   define variable ix     as integer   no-undo .
     3187   do
     3188    on error undo, return error return-value
     3189    :
     3190   define buffer buf_goods for ub.goods  .
     3191   define buffer buf_bar-code for ub.bar-code  .
     3192   find first buf_bar-code no-lock where
     3193              buf_bar-code.b-code = p-b-code
     3194              no-error .
     3195   find first buf_goods no-lock where
     3196              buf_goods.gds-code = buf_bar-code.gds-code
     3197              no-error .
     3198   run ggoattr-value (
     3199      input   buf_goods.grp-code
     3200     ,input   v-cntxt-host-code-obj
     3201     ,input   p-obj-type
     3202     ,input   p-obj-code
     3203     ,input   'level-dis':U
     3204     ,output  v-level-dis-attr
     3205     ,output  v-type ) no-error .
     3206   repeat ix = 1 to num-entries (v-level-dis-attr, chr(4)) - 1 :
     3207     create
     3208       tt-level-dis-attr
     3209     .
     3210     tt-level-dis-attr.attr-code = entry (1, entry (ix, v-level-dis-attr, chr(4)), chr(44)) .
     3211     tt-level-dis-attr.attr-value = entry (2, entry (ix, v-level-dis-attr, chr(4)), chr(44)) .
     3212   end.
     3213   p-prc = 0 .
     3214     if p-price-prod = 0 then do:
     3215         for each tt-level-dis-attr no-lock
     3216                 :
     3217               run lvldsc-bytt (
     3218                 input   tt-level-dis-attr.attr-code
     3219               , input   tt-level-dis-attr.attr-value
     3220               , output  v-val1
     3221               , output  v-val2
     3222               , output  v-prc  )
     3223               .
     3224               if v-val1  = 0  then do:
     3225                  p-prc = v-prc .
     3226                 leave.
     3227               end.
     3228         end.
     3229     end.
     3230     else do:
     3231         for each tt-level-dis-attr no-lock
     3232                 :
     3233               run lvldsc-bytt (
     3234                 input   tt-level-dis-attr.attr-code
     3235               , input   tt-level-dis-attr.attr-value
     3236               , output  v-val1
     3237               , output  v-val2
     3238               , output  v-prc  )
     3239               .
     3240               if p-price-prod   > v-val1 and
     3241                  p-price-prod  <= v-val2 then do:
     3242                  p-prc = v-prc .
     3243                 leave.
     3244               end.
     3245         end.
     3246     end.
     3247   for each tt-level-dis-attr no-lock. delete tt-level-dis-attr. end.
     3248    end.
     3249   end procedure.
     3250   procedure calc-price-levelprod :
     3251   define input  parameter p-mode     as integer   no-undo .
     3252   define input  parameter p-rb       as character no-undo .
     3253   define input  parameter p-b-code   as integer   no-undo .
     3254   define input  parameter p-obj-type as character no-undo .
     3255   define input  parameter p-obj-code as integer   no-undo .
     3256   define output parameter p-price-sale as decimal   no-undo .
     3257   define output parameter p-descript-calc as character no-undo .
     3258   define variable  v-PriceWithoutVat as decimal   no-undo init 0.
     3259   define variable  v-PriceWithVat    as decimal   no-undo init 0.
     3260   define variable  v-prod-vat        as decimal   no-undo init 0.
     3261   define variable  v-discnt          as decimal   no-undo init 0.
     3262   define buffer buf_goods for ub.goods  .
     3263   define buffer buf_bar-code for ub.bar-code  .
     3264   define buffer buf_parts for ub.parts  .
     3265   define variable v-part-code as character no-undo .
     3266   define variable v-in-code   as character no-undo .
     3267     do
     3268     on error undo, return error return-value
     3269     :
     3270   define variable vss-include-info40 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3271   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run proprice in g#library
     3272   (  input  p-b-code
     3273    , input  p-obj-type
     3274    , input  p-obj-code
     3275    , output v-PriceWithoutVat
     3276    , output v-PriceWithVat
     3277    , output v-prod-vat
     3278    , output v-part-code
     3279    , output v-in-code
     3280           ) no-error .
     3281         if error-status :error then do:
     3282           return error "Нет цены производителя!".
     3283         end.
     3284   find first buf_bar-code no-lock where
     3285              buf_bar-code.b-code = p-b-code
     3286              no-error .
     3287   find first buf_goods no-lock where
     3288              buf_goods.gds-code = buf_bar-code.gds-code
     3289              no-error .
     3290   find first buf_parts no-lock where
     3291              buf_parts.artic      = buf_goods.artic        and
     3292              buf_parts.prod-type  = buf_goods.prod-type    and
     3293              buf_parts.prod-code  = buf_goods.prod-code    and
     3294              buf_parts.in-code    = buf_bar-code.in-code   and
     3295              buf_parts.out-code   = buf_bar-code.in-code   and
     3296              buf_parts.part-code  = buf_bar-code.part-code
     3297              no-error .
     3298               if error-status :error then do:
     3299                   find first buf_parts no-lock where
     3300                             buf_parts.artic      = buf_goods.artic        and
     3301                             buf_parts.prod-type  = buf_goods.prod-type    and
     3302                             buf_parts.prod-code  = buf_goods.prod-code    and
     3303                             buf_parts.in-code    = v-in-code              and
     3304                             buf_parts.out-code   = v-in-code              and
     3305                             buf_parts.part-code  = v-part-code
     3306                             no-error .
     3307                   if error-status :error then do:
     3308                      message
     3309                       substitute("Нет цены производителя !  &1 &2&3&4&5"  ,
     3310                                   v-in-code,
     3311                                   v-part-code ,
     3312                                   buf_goods.artic   ,
     3313                                   buf_goods.prod-type,
     3314                                   buf_goods.prod-code ) .
     3315                      return error "Нет цены производителя !!!".
     3316                   end.
     3317               end.
     3318   run level-dis-value ( input (if p-mode = 2 then v-PriceWithoutVat else v-PriceWithVat) , input p-b-code, input p-obj-type, input p-obj-code, output v-discnt ) no-error .
     3319   define variable v-postWithoutVat-rubl as decimal   no-undo .
     3320   define variable v-postWithoutVat-base as decimal   no-undo .
     3321      case p-mode :
     3322       when 1 then do:
     3323          if p-rb = "rubl" then do:
     3324             p-price-sale = buf_parts.price-rubl + ( MINIMUM ( buf_parts.price-rubl , v-PriceWithVat ) * v-discnt / 100 ).
     3325          end.
     3326          else do:
     3327             p-price-sale = buf_parts.price-base + ( MINIMUM ( v-PriceWithVat , buf_parts.price-base ) * v-discnt / 100 ).
     3328          end.
     3329       end.
     3330       when 2 then do:
     3331         if p-rb = "rubl" then do:
     3332           v-postWithoutVat-rubl =  buf_parts.price-rubl - (buf_parts.price-rubl * buf_parts.vat-pc / (100 + buf_parts.vat-pc) ).
     3333           p-price-sale = v-postWithoutVat-rubl + ( MINIMUM ( v-PriceWithoutVat , v-postWithoutVat-rubl ) * v-discnt / 100 ) .
     3334         end.
     3335         else do:
     3336           v-postWithoutVat-base = buf_parts.price-base - (buf_parts.price-base * buf_parts.vat-pc / ( 100 + buf_parts.vat-pc) ) .
     3337           p-price-sale = v-postWithoutVat-base + ( MINIMUM ( v-PriceWithoutVat, v-postWithoutVat-base) * v-discnt / 100 ) .
     3338         end.
     3339       end.
     3340      end case.
     3341   p-descript-calc =
     3342     string(p-mode) + '_Элементы расчета: ' +  chr(10)  +
     3343     buf_goods.gds-name                  +  chr(10) +
     3344     buf_goods.artic +
     3345     buf_goods.prod-type +
     3346     string(buf_goods.prod-code)         + chr(10) +
     3347     "бар-код " +  string(p-b-code)      + chr(10)  +
     3348     'ПН    ' + v-in-code  +
     3349     ' серия ' + v-part-code             +  chr(10)  + chr(10) +
     3350     'Цена поставщика без ндс    '  + string((buf_parts.price-rubl - (buf_parts.price-rubl * buf_parts.vat-pc / (100 + buf_parts.vat-pc) ) ))  + chr(10) +
     3351     'Цена поставщика   c ндс    '  + string ( buf_parts.price-rubl )  + chr(10) +
     3352     'Цена производителя без ндс ' +  string( v-PriceWithoutVat)       + chr(10) +
     3353     'Цена производителя   c ндс ' +  string( v-PriceWithVat  )        + chr(10) +
     3354     chr(10) +
     3355     "% пороговой наценки        "  + string(v-discnt)                 + chr(10) +
     3356     chr(10) +
     3357     "сумма наценки от произв без ндс "  + string( v-PriceWithoutVat * v-discnt / 100 ) +  chr(10) +
     3358     "сумма наценки от произв   с ндс "  + string( v-PriceWithVat * v-discnt / 100 )    +  chr(10)  +
     3359     chr(10) +
     3360     string(p-price-sale)                                                               +  chr(10) +
     3361     (if p-mode = 1 then substitute("ПорогПр+НДС  &1 + ( min(&2или &1) * &3 / 100 )  = &4 " , buf_parts.price-rubl , v-PriceWithVat , v-discnt , p-price-sale)
     3362     else                substitute("ПорогПр-НДС  &1 - ( &1 * &2 / 100 ) + ( min(&3 или &6 ) * &4 / 100 ) = &5 и еще накручивается НДС " , buf_parts.price-rubl , buf_parts.vat-pc , v-PriceWithoutVat , v-discnt , p-price-sale , v-postWithoutVat-rubl))
     3363   .
     3364     end.
     3365   end procedure.
     3366   define variable vss-include-info41 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3367   PROCEDURE write-bonus :
     3368   define input  parameter p-contract-num   like ub.contract-specif.contract-num  no-undo .
     3369   define input  parameter p-host-code      like ub.contract-specif.host-code     no-undo .
     3370   define input  parameter p-gds-code       like ub.contract-specif.gds-code      no-undo .
     3371   define input  parameter v-bonus as decimal   no-undo .
     3372     do
     3373     on error undo, return error return-value
     3374     :
     3375       find first ub.contract-specif-attr exclusive-lock  where
     3376                  ub.contract-specif-attr.contract-num = p-contract-num  and
     3377                  ub.contract-specif-attr.host-code    = p-host-code     and
     3378                  ub.contract-specif-attr.gds-code     = p-gds-code      and
     3379                  ub.contract-specif-attr.attr-code    = 'bonus':U
     3380                 no-error .
     3381         if not available ub.contract-specif-attr then do:
     3382            create ub.contract-specif-attr .
     3383            assign
     3384                 ub.contract-specif-attr.contract-num = p-contract-num
     3385                 ub.contract-specif-attr.host-code    = p-host-code
     3386                 ub.contract-specif-attr.gds-code     = p-gds-code
     3387                 ub.contract-specif-attr.attr-code    = 'bonus':U
     3388            .
     3389         end.
     3390         ub.contract-specif-attr.attr-value  = string (v-bonus) .
     3391   end.
     3392   END PROCEDURE.
     3393   PROCEDURE read-bonus :
     3394   define input  parameter p-contract-num   like ub.contract-specif.contract-num  no-undo .
     3395   define input  parameter p-host-code      like ub.contract-specif.host-code     no-undo .
     3396   define input  parameter p-gds-code       like ub.contract-specif.gds-code      no-undo .
     3397   define output parameter v-bonus as decimal   no-undo .
     3398     do
     3399     on error undo, return error return-value
     3400     :
     3401   find first ub.contract-specif-attr no-lock  where
     3402              ub.contract-specif-attr.contract-num = p-contract-num  and
     3403              ub.contract-specif-attr.host-code    = p-host-code     and
     3404              ub.contract-specif-attr.gds-code     = p-gds-code      and
     3405              ub.contract-specif-attr.attr-code    = 'bonus':U
     3406              no-error .
     3407      if available ub.contract-specif-attr then  v-bonus = decimal (ub.contract-specif-attr.attr-value ) .
     3408                                           else  v-bonus = 0 .
     3409   end.
     3410   END PROCEDURE.
     3411   PROCEDURE write-prc-min :
     3412   define input  parameter p-contract-num   like ub.contract-specif.contract-num  no-undo .
     3413   define input  parameter p-host-code      like ub.contract-specif.host-code     no-undo .
     3414   define input  parameter p-gds-code       like ub.contract-specif.gds-code      no-undo .
     3415   define input  parameter v-prc-min        as decimal   no-undo .
     3416     do
     3417     on error undo, return error return-value
     3418     :
     3419       find first ub.contract-specif-attr exclusive-lock  where
     3420                 ub.contract-specif-attr.contract-num = p-contract-num  and
     3421                 ub.contract-specif-attr.host-code    = p-host-code     and
     3422                 ub.contract-specif-attr.gds-code     = p-gds-code      and
     3423                 ub.contract-specif-attr.attr-code    = 'prc-min':U
     3424                 no-error .
     3425         if not available ub.contract-specif-attr then do:
     3426            create ub.contract-specif-attr .
     3427            assign
     3428                 ub.contract-specif-attr.contract-num = p-contract-num
     3429                 ub.contract-specif-attr.host-code    = p-host-code
     3430                 ub.contract-specif-attr.gds-code     = p-gds-code
     3431                 ub.contract-specif-attr.attr-code    = 'prc-min':U
     3432                 ub.contract-specif-attr.attr-value  = string (v-prc-min)
     3433            .
     3434         end.
     3435         else do:
     3436            ub.contract-specif-attr.attr-value  = string (v-prc-min) .
     3437         end.
     3438       find first ub.contract-specif exclusive-lock where
     3439           ub.contract-specif.contract-num = p-contract-num and
     3440           ub.contract-specif.host-code    = p-host-code    and
     3441           ub.contract-specif.gds-code     = p-gds-code.
     3442           ub.contract-specif.whole-send-news  = ub.contract-specif.whole-send-news + 1.
     3443   end.
     3444   END PROCEDURE.
     3445   PROCEDURE read-prc-min :
     3446   define input  parameter p-contract-num   like ub.contract-specif.contract-num  no-undo .
     3447   define input  parameter p-host-code      like ub.contract-specif.host-code     no-undo .
     3448   define input  parameter p-gds-code       like ub.contract-specif.gds-code      no-undo .
     3449   define output parameter v-prc-min as decimal   no-undo .
