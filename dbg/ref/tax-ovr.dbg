     3460                                           else  v-prc-min = 0 .
     3461   end.
     3462   END PROCEDURE.
     3463   PROCEDURE write-retro-bonus :
     3464   define input  parameter p-contract-num   like ub.contract-specif.contract-num  no-undo .
     3465   define input  parameter p-host-code      like ub.contract-specif.host-code     no-undo .
     3466   define input  parameter p-gds-code       like ub.contract-specif.gds-code      no-undo .
     3467   define input  parameter v-retro-bonus as character   no-undo .
     3468     do
     3469     on error undo, return error return-value
     3470     :
     3471       find first ub.contract-specif-attr exclusive-lock  where
     3472                 ub.contract-specif-attr.contract-num = p-contract-num  and
     3473                 ub.contract-specif-attr.host-code    = p-host-code     and
     3474                 ub.contract-specif-attr.gds-code     = p-gds-code      and
     3475                 ub.contract-specif-attr.attr-code    = "retro-bonus"
     3476                 no-error .
     3477         if not available ub.contract-specif-attr then do:
     3478            create ub.contract-specif-attr .
     3479            assign
     3480                 ub.contract-specif-attr.contract-num = p-contract-num
     3481                 ub.contract-specif-attr.host-code    = p-host-code
     3482                 ub.contract-specif-attr.gds-code     = p-gds-code
     3483                 ub.contract-specif-attr.attr-code    = "retro-bonus"
     3484            .
     3485            ub.contract-specif-attr.attr-value  = v-retro-bonus no-error.
     3486            if error-status:error then
     3487               message "Превышен допустимый объем информации о ретро-бонусах. Удалите исторические или неактуальны периоды" view-as alert-box error.
     3488         end.
     3489         else do:
     3490            ub.contract-specif-attr.attr-value  = v-retro-bonus no-error.
     3491            if error-status:error then
     3492               message "Превышен допустимый объем информации о ретро-бонусах. Удалите исторические или неактуальны периоды" view-as alert-box error.
     3493         end.
     3494       find first ub.contract-specif exclusive-lock where
     3495           ub.contract-specif.contract-num = p-contract-num and
     3496           ub.contract-specif.host-code    = p-host-code    and
     3497           ub.contract-specif.gds-code     = p-gds-code.
     3498           ub.contract-specif.whole-send-news  = ub.contract-specif.whole-send-news + 1.
     3499   end.
     3500   END PROCEDURE.
     3501   PROCEDURE read-retro-bonus :
     3502   define input  parameter p-contract-num   like ub.contract-specif.contract-num  no-undo .
     3503   define input  parameter p-host-code      like ub.contract-specif.host-code     no-undo .
     3504   define input  parameter p-gds-code       like ub.contract-specif.gds-code      no-undo .
     3505   define output parameter v-retro-bonus as character   no-undo .
     3506     do
     3507     on error undo, return error return-value
     3508     :
     3509   find first ub.contract-specif-attr no-lock  where
     3510              ub.contract-specif-attr.contract-num = p-contract-num  and
     3511              ub.contract-specif-attr.host-code    = p-host-code     and
     3512              ub.contract-specif-attr.gds-code     = p-gds-code      and
     3513              ub.contract-specif-attr.attr-code    = "retro-bonus"
     3514              no-error .
     3515      if available ub.contract-specif-attr then  v-retro-bonus = ub.contract-specif-attr.attr-value  .
     3516                                           else  v-retro-bonus = "" .
     3517   end.
     3518   END PROCEDURE.
     3519   define variable v-str1 as character no-undo .
     3520   FUNCTION fnc-base-price-doc RETURN decimal
     3521     ( local-bc as integer, p-recid as recid ).
     3522   define buffer   base-price       for ub.price-doc-forming-gds .
     3523   define variable local-main-code like ub.bar-code.b-code no-undo.
     3524   define variable local-base-code like ub.bar-code.b-code no-undo.
     3525   define buffer   buf_main-pdf     for ub.price-doc-forming .
     3526   find first buf_main-pdf no-lock where recid (buf_main-pdf) = p-recid .
     3527     run prc-base-code in this-procedure (input local-bc, output local-base-code).
     3528     find base-price no-lock where
     3529          base-price.pdf-id = buf_main-pdf.pdf-id and
     3530          base-price.pdf-db = buf_main-pdf.pdf-db and
     3531          base-price.plt-id = buf_main-pdf.plt-id and
     3532          base-price.plt-db-num = buf_main-pdf.plt-db-num and
     3533          base-price.b-code  = local-base-code
     3534          no-error.
     3535     if not available base-price then do:
     3536       run prc-main-code in this-procedure
     3537          ( input local-bc, output local-main-code ).
     3538       find  base-price no-lock where
     3539             base-price.pdf-id = buf_main-pdf.pdf-id and
     3540             base-price.pdf-db = buf_main-pdf.pdf-db and
     3541             base-price.plt-id = buf_main-pdf.plt-id and
     3542             base-price.plt-db-num = buf_main-pdf.plt-db-num and
     3543             base-price.b-code  = local-main-code
     3544             no-error.
     3545     end.
     3546     if available base-price then
     3547       return (base-price.price-sale-doc).
     3548     else
     3549       return (?).
     3550   END FUNCTION.
