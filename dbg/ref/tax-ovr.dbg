     6898       define variable price-base-without-tax-loc like ub.doc-line.price-base no-undo.
     6899       define variable price-cli-without-tax-loc  like ub.doc-line.price-base no-undo.
     6900       define variable vat-base-loc               like ub.doc-line.price-base no-undo.
     6901       define variable vat-rubl-loc               like ub.doc-line.price-rubl no-undo.
     6902       define variable vat-cli-loc                like ub.doc-line.price-rubl no-undo.
     6903       define variable slt-base-loc               like ub.doc-line.price-base no-undo.
     6904       define variable slt-rubl-loc               like ub.doc-line.price-rubl no-undo.
