     6676     "Ошибка!"
     6677     view-as alert-box error
     6678   .
     6679   find first ub.price-doc-forming no-lock  where
     6680              ub.price-doc-forming.plt-db-num = p-plt-db-num and
     6681              ub.price-doc-forming.plt-id     = p-plt-id     and
     6682              ub.price-doc-forming.pdf-db     = p-pdf-db     and
     6683              ub.price-doc-forming.pdf-id     = p-pdf-id
     6684               no-error .
     6685   if error-status :error then message
     6686     vss-workfile vss-revision vss-description skip
     6687     error-status :get-message(1) skip
     6688     return-value skip
     6689     "Ошибка!"
     6690     view-as alert-box error
