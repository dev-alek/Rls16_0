     6693    ub.goods.artic = p-artic and
     6694    ub.goods.prod-type = p-prod-type and
     6695    ub.goods.prod-code = p-prod-code no-error .
     6696   if error-status :error then message
     6697     vss-workfile vss-revision vss-description skip
     6698     error-status :get-message(1) skip
     6699     return-value skip
     6700     "Ошибка!"
     6701     view-as alert-box error
     6702   .
     6703   if ub.price-list-type.fix-cource-crc-base = true then do:
