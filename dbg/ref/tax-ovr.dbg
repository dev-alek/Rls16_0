     3845     define variable v-sps as character no-undo .
     3846   v-sps =
     3847    "Товар,
     3848   Группа,
     3849   Учетная,
     3850   Учет-объект,
     3851   Учет-резерв,
     3852   Приходная,
     3853   Прих-объект,
     3854   Начальная,
     3855   Старая,
     3856   Новая,
     3857   Объект,
     3858   Накладная,
     3859   Накл-безНДС,
     3860   Учет-безНДС,
     3861   Стар-безНДС,
     3862   Переоценка,
     3863   ДокФормЦены,
     3864   Отсутствует,
     3865   Признак,
     3866   Специальная,
     3867   Не-считать,
     3868   Основная,
     3869   Единая,
