     1522   procedure create_new_price-doc-forming :
     1523   define input  parameter p-obj-type   as character no-undo .
     1524   define input  parameter p-obj-code   as integer   no-undo .
     1525   define output parameter p-pdf-db-num as integer   no-undo .
     1526   define output parameter p-pdf-id     as integer   no-undo .
     1527   define output parameter p-plt-db-num as integer   no-undo .
     1528   define output parameter p-plt-id     as integer   no-undo .
     1529   define buffer buf_price-list-type for ub.price-list-type  .
     1530   define variable v-host-code  as integer   no-undo .
     1531   define variable v-base-rate  as decimal   no-undo .
     1532   define variable v-base-scale as integer   no-undo .
     1533   define variable v-exch-rate  as decimal   no-undo .
     1534   define variable v-exch-scale as integer   no-undo .
     1535   define variable v-base as logical   no-undo .
     1536     do
