     4341            end.
     4342            otherwise do:
     4343               p-price-sale-base  =  cost-base * (1 + p-increase-pc / 100) .
     4344            end.
     4345            end case.
     4346           assign
     4347             p-price-calc-base  =  cost-base
     4348             p-road-tax-base    =  cur-rt-base
     4349             p-price-calc-rubl  =  p-price-calc-base * p-base-rate / p-base-scale
     4350             p-price-sale-rubl  =  p-price-sale-base * p-base-rate / p-base-scale
     4351             p-road-tax-rubl    =  p-road-tax-base   * p-base-rate / p-base-scale
     4352             p-price-calc-doc   =  p-price-calc-rubl / p-exch-rate * p-exch-scale
     4353             p-price-sale-doc   =  p-price-sale-rubl / p-exch-rate * p-exch-scale
     4354             p-road-tax-doc     =  p-road-tax-rubl   / p-exch-rate * p-exch-scale
     4355           .
     4356       end.
     4357   case p-round-method :
     4358     when '9-окончание':U then do:
     4359       if p-price-sale-doc < 29 then do:
     4360         if (p-price-sale-doc - truncate (p-price-sale-doc, 0)) <> 0 then do:
     4361           assign
     4362             p-price-sale-doc = truncate (p-price-sale-doc, 0) + 1
     4363           .
     4364         end.
     4365       end.
     4366       else do:
     4367         if (p-price-sale-doc modulo 10) < 3 then do:
     4368           assign
     4369             p-price-sale-doc = (p-price-sale-doc - (p-price-sale-doc modulo 100))
     4370                 + ( truncate (((p-price-sale-doc modulo 100) / 10), 0)
     4371                   - 1 ) * 10
     4372                 + 9
     4373           .
     4374         end.
     4375         else do:
     4376           assign
     4377             p-price-sale-doc = (p-price-sale-doc - (p-price-sale-doc modulo 100))
     4378                 + ( truncate (((p-price-sale-doc modulo 100) / 10), 0)
     4379                   ) * 10
     4380                 + 9
     4381           .
     4382         end.
     4383         assign
     4384           p-price-sale-doc = round (p-price-sale-doc, 0)
     4385         .
     4386       end.
     4387     end.
     4388     when '9-99окончание':U then do:
     4389       if p-price-sale-doc < p-round-base then do:
     4390         assign
     4391           p-price-sale-doc = truncate (p-price-sale-doc, 0) + 0.99
     4392         .
     4393       end.
     4394       else do:
     4395         assign
     4396           p-price-sale-doc = truncate (p-price-sale-doc / 10 , 0) * 10 + 9.99
     4397         .
     4398       end.
     4399     end.
     4400     when 'Без-дробных':U then do:
     4401       assign
     4402         p-price-sale-doc = round (p-price-sale-doc, 0)
     4403       .
     4404     end.
     4405     when 'Произвольно':U then do:
     4406       if p-round-base <> 0 then do:
     4407         assign
     4408           p-price-sale-doc = round (p-price-sale-doc / p-round-base, 0) * p-round-base
     4409         .
     4410         if p-price-sale-doc = 0 then do:
     4411           assign
     4412             p-price-sale-doc = p-round-base
     4413           .
     4414         end.
     4415       end.
     4416     end.
     4417     when 'Вверх':U then do:
     4418       if p-round-base <> 0 then do:
     4419         if truncate ( p-price-sale-doc / p-round-base, 0 ) <> (p-price-sale-doc / p-round-base) then do:
     4420           assign
     4421             p-price-sale-doc = truncate (p-price-sale-doc / p-round-base, 0) * p-round-base + p-round-base
     4422           .
     4423         end.
     4424       end.
     4425       if p-price-sale-doc = 0 then do:
     4426         assign
     4427           p-price-sale-doc = p-round-base
     4428         .
     4429       end.
     4430     end.
     4431     when 'Коэффициент':U then do:
     4432       if p-round-base <> 0 then do:
     4433         assign
     4434           p-price-sale-doc = p-price-sale-doc * p-round-base
     4435         .
     4436       end.
     4437     end.
     4438     when 'Отключено':U then do:
     4439     end.
     4440     otherwise do:
     4441       message
     4442         vss-workfile vss-revision vss-description skip
     4443         "Неизвестный метод округления продажной цены" skip
     4444         "round-method" p-round-method skip
     4445         "round-base"   p-round-base   skip
     4446         "price"        p-price-sale-doc             skip
     4447         view-as alert-box error .
     4448     end.
     4449   end.
     4450       if error-status :error then do:
     4451       message
     4452         error-status :get-message(1) skip
     4453         return-value skip
     4454         "pr-99"
     4455         view-as alert-box error
     4456       .
     4457       end.
     4458     p-price-calc-rubl = p-price-calc-doc * p-exch-rate / p-exch-scale .
     4459     p-price-sale-rubl = p-price-sale-doc * p-exch-rate / p-exch-scale .
     4460     p-road-tax-rubl   = p-road-tax-doc   * p-exch-rate / p-exch-scale .
     4461     p-price-prev-rubl = p-price-prev-doc * p-exch-rate / p-exch-scale .
     4462     p-price-calc-base = p-price-calc-rubl / p-base-rate * p-base-scale .
     4463     p-price-sale-base = p-price-sale-rubl / p-base-rate * p-base-scale .
     4464     p-road-tax-base   = p-road-tax-rubl   / p-base-rate * p-base-scale .
     4465     p-price-prev-base = p-price-prev-rubl / p-base-rate * p-base-scale .
     4466     define buffer bufold_price-doc-forming for ub.price-doc-forming  .
     4467     find first bufold_price-doc-forming where  recid(bufold_price-doc-forming) = v1-recid no-lock no-error .
     4468     p-prev-doc-code = if available bufold_price-doc-forming
     4469                          then (string(bufold_price-doc-forming.pdf-id) + " БД" + string(bufold_price-doc-forming.pdf-db))
     4470                          else "" .
     4471     end.
     4472   end procedure.
