     3576         .
     3577       end.
     3578       if l-filter-open-27 = false then do:
     3579         message
     3580           "Ошибка при фильтрации / сортировке" skip
     3581           "Будут показаны записи без учета фильтра" skip
     3582           view-as alert-box .
     3583       end.
     3584       else do:
     3585           assign
     3586             l-query-was-opened = true
     3587           .
     3588       end.
     3589     end.
