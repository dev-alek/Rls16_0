     3442     sch-corr-date
     3443     sch-pump-code
     3444     sch-corr-user-name
     3445     mark-num
     3446     WITH FRAME Dialog-Frame .
     3447     ENABLE
     3448     b-quit
     3449     B-mark when lookup("b-mark":U, bttns) > 0
     3450     b-sel when lookup("b-sel":U, bttns) > 0
     3451     B-lookup
     3452     B-sch
     3453     B-Print
     3454     B-Help
     3455     br-pmp-hist
     3456     sch-corr-date
     3457     sch-pump-code when p-mode = 'все':U
     3458     sch-corr-user-name
     3459     BR-changes mark-num
     3460     WITH FRAME Dialog-Frame .
     3461     VIEW FRAME Dialog-Frame .
     3462     hide b-lookup sch-corr-user-name
     3463     in frame Dialog-Frame .
     3464   END PROCEDURE.
     3465   PROCEDURE OpenBr :
     3466   define input  parameter p-open-query     as logical   no-undo .
     3467   define input  parameter p-find-next      as logical   no-undo .
     3468   define input  parameter p-find-condition as character no-undo .
     3469   define variable l-query-was-opened as logical no-undo .
