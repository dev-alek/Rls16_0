     3472   title0 = "История ТРК" + chr(32).
     3473   run waitfram-show in this-procedure ( input "Ждите...").
     3474   define variable sort-column-phrase as character no-undo .
     3475   case sort-column-name :
     3476     when "" then do:
     3477       assign
     3478         sort-column-phrase = ""
     3479       .
