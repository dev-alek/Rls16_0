     5155   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5156   run fltfield-add in this-procedure('pump-code', '№ ТРК', '',
     5157   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5158   run fltfield-add in this-procedure('corr-date', '', '',
     5159   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5160   run fltfield-add in this-procedure('corr-time', 'Время корр.', 'time',
     5161   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5162   run fltfield-add in this-procedure('corr-user-db-num', '', '',
     5163   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5164   run fltfield-add in this-procedure('corr-user-name', 'Изменил', 'usr',
     5165   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5166   run fltfield-add in this-procedure('subject', 'Предмет изменения', 'pmp-hist-subject',
     5167   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5168   run fltfield-add in this-procedure('action', 'Действие', 'hist-action',
     5169   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5170   Filter-Block:
     5171   DO ON STOP    UNDO Filter-Block, LEAVE Filter-Block
     5172       ON ERROR   UNDO Filter-Block, LEAVE Filter-Block
     5173       ON END-KEY UNDO Filter-Block, LEAVE Filter-Block :
     5174     run gbl/filter.w ( INPUT parparentproc
     5175                       ,INPUT (filter-point + chr(4) + filter-label + chr(4) + 'yes':U)
     5176                       ,INPUT tbl
     5177                       ,INPUT join-tbl
     5178                       ,INPUT fld
     5179                       ,INPUT lab
     5180                       ,INPUT spr
     5181                       ,INPUT dim ).
     5182     RUN OpenBr in this-procedure ( input yes, input no, input '':U).
     5183   END.
     5184   END PROCEDURE.
     5185   PROCEDURE proc-br-pmp-hist :
     5186   define variable vss-include-info42 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5187   if b-sel:sensitive in frame Dialog-Frame then dO:
     5188       if b-mark:sensitive then do:
     5189           apply "choose" to b-mark in frame Dialog-Frame.
     5190       end.
     5191       else do:
     5192           apply "choose" to b-sel in frame Dialog-Frame.
     5193       end.
     5194   end.
     5195   else do:
     5196       if b-lookup:sensitive then
     5197       apply "choose" to b-lookup in frame Dialog-Frame.
     5198   end.
     5199   END PROCEDURE.
     5200   PROCEDURE proc-find-corr-date :
     5201   define input parameter p-next as logical no-undo.
     5202   define input parameter p-date like ub.fin-doc.doc-date no-undo.
     5203   define variable v-date-chr as character no-undo.
     5204   if p-date = ? then return .
     5205   display
     5206   0 @ sch-pump-code
     5207   "":U @ sch-corr-user-name
     5208   with frame Dialog-Frame.
     5209   assign
     5210   v-date-chr = string(day(p-date)) + chr(47) +
     5211                    string(month(p-date)) + chr(47) +
     5212                    string(year(p-date)).
     5213          run OpenBr in this-procedure
     5214           (input false
     5215           ,input true
     5216           ,input substitute("and X_c-pmp-hist.corr-date = &1 "
     5217             , v-date-chr)
     5218           ).
     5219         apply "entry":u to sch-corr-date in frame Dialog-Frame.
     5220   END PROCEDURE.
     5221   PROCEDURE proc-find-pump-code :
     5222   define input parameter p-next as logical no-undo.
     5223   define input parameter p-pump-code like ub.c-pmp-hist.pump-code no-undo.
     5224   define variable v-pump-code as character no-undo.
     5225   assign
     5226   sch-corr-date = ?.
     5227   display
     5228   "":U @ sch-corr-user-name
     5229   sch-corr-date
     5230   with frame Dialog-Frame.
     5231   assign
     5232   v-pump-code = string(p-pump-code).
     5233   run OpenBr in this-procedure
     5234       (input false
     5235       ,input p-next
     5236       ,input substitute("and X_c-pmp-hist.pump-code = &1 "
     5237         , v-pump-code)
     5238       ).
     5239   apply "entry":u to sch-pump-code in frame Dialog-Frame .
     5240   END PROCEDURE.
     5241   PROCEDURE proc-find-user :
     5242   define input parameter p-next as logical no-undo.
     5243   define input parameter p-user like ub.c-pmp-hist.corr-user-name no-undo.
     5244   assign
     5245   sch-corr-date = ?.
     5246   display
     5247   sch-corr-date
     5248   0 @ sch-pump-code
     5249   with frame Dialog-Frame.
     5250   p-user = chr(34) + p-user + chr(34).
     5251   run OpenBr in this-procedure
     5252       (input false
     5253       ,input p-next
     5254       ,input substitute("and X_c-pmp-hist.corr-user-name = &1 "
     5255         , p-user)
     5256       ).
     5257   apply "entry":u to sch-corr-user-name in frame Dialog-Frame .
     5258   END PROCEDURE.
     5259   PROCEDURE proc-view-changes :
     5260   define variable v-description as character no-undo .
     5261   for each temp-changes:
     5262       delete temp-changes.
     5263   END.
     5264   if not available X_c-pmp-hist then do:
     5265     Open QUery br-changes for each temp-changes.
     5266     return.
     5267   end.
     5268   run ref/cpmphisv.p (
     5269                      input X_c-pmp-hist.obj-type
     5270                     ,input X_c-pmp-hist.obj-code
     5271                     ,input X_c-pmp-hist.pump-code
     5272                     ,input X_c-pmp-hist.chip-num
     5273                     ,input X_c-pmp-hist.corr-user-db-num
     5274                     ,input X_c-pmp-hist.subject
     5275                     ,input X_c-pmp-hist.action
     5276                     ,input no
     5277                     ,output v-description
     5278                  ) no-error .
     5279   Open QUery br-changes for each temp-changes.
     5280   assign
     5281   br-changes:title in frame Dialog-Frame = v-description
     5282   .
     5283   END PROCEDURE.
     5284   FUNCTION get-action RETURNS CHARACTER
     5285     ( p-action as integer ) :
     5286     define variable dops as character no-undo.
     5287   assign dops = entry (lookup (trim(string(p-action)), '99,1,2,3,4,9,51,79':U), 'Удаление,Создание,Изменение,Коррекция,Восстановление,Смена_кода,Смена_артик,Выключ.':U) no-error.
     5288   RETURN dops.
     5289   END FUNCTION.
     5290   FUNCTION get-subject RETURNS CHARACTER
     5291     ( p-subject as character ) :
     5292     RETURN entry (lookup (p-subject, 'pl-gds-pump,pl-pump,pl-pump-nozzle,pump-nozzle,pump,pump-attr':U), 'Товар на ТРК,Резервуар/ТРК,Резервуар/ТРК/Пистолет,ТРК/Пистолет,ТРК,Атрибут ТРК':U).
     5293   END FUNCTION.
