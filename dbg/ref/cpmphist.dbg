        1   DEFINE BUFFER find_c-pmp-hist FOR ub.c-pmp-hist.
        2   DEFINE BUFFER X_c-pmp-hist FOR ub.c-pmp-hist.
        3   DEFINE BUFFER X_clients FOR ub.clients.
        4   DEFINE BUFFER X_curr-sysconf FOR ub.sysconf.
        5   DEFINE BUFFER X_goods FOR ub.goods.
        6   DEFINE BUFFER X_place FOR ub.place.
        7   DEFINE BUFFER X_pump FOR ub.pump.
        8   DEFINE BUFFER X_sysconf FOR ub.sysconf.
        9   DEFINE INPUT     PARAMETER parParentProc  AS WIDGET-HANDLE NO-UNDO.
       10   define input parameter p-curr-obj-type like ub.clients.obj-type no-undo.
       11   define input parameter p-curr-obj-code like ub.clients.obj-code no-undo.
       12   define input parameter bttns  as char   no-undo .
       13   define input parameter p-mode  as char   no-undo .
       14   define input parameter p-obj-type like ub.c-pmp-hist.obj-type no-undo.
       15   define input parameter p-obj-code like ub.c-pmp-hist.obj-code no-undo.
       16   define input parameter p-pump-code like ub.c-pmp-hist.pump-code no-undo .
       17   define input parameter p-pl-code  like ub.c-pmp-hist.pl-code no-undo .
       18   define input parameter p-gds-code like ub.c-pmp-hist.gds-code no-undo .
       19   define input parameter p-nozzle-code like ub.c-pmp-hist.nozzle-code no-undo .
       20   define input parameter p-subject  like ub.c-pmp-hist.subject no-undo .
       21   define input-output param p-rid-list    as  char no-undo .
       22   define variable vss-revision    AS CHAR NO-UNDO INIT "$Revision$":U.
       23   define variable vss-author      AS CHAR NO-UNDO INIT "$Author$":U.
       24   define variable vss-date        AS CHAR NO-UNDO INIT "$Date$":U.
       25   define variable vss-workfile    AS CHAR NO-UNDO INIT "$Workfile$":U.
       26   define variable vss-archive     AS CHAR NO-UNDO INIT "$Archive$":U.
       27   define variable vss-description AS CHAR NO-UNDO INIT "Список полной истории ТРК":U.
       28   procedure vss-get-info :
       29     define output parameter p-vss-revision    like vss-revision    no-undo .
       30     define output parameter p-vss-author      like vss-author      no-undo .
       31     define output parameter p-vss-date        like vss-date        no-undo .
       32     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       33     define output parameter p-vss-archive     like vss-archive     no-undo .
       34     define output parameter p-vss-description like vss-description no-undo .
       35     assign
       36       p-vss-revision    = vss-revision
       37       p-vss-author      = vss-author
       38       p-vss-date        = vss-date
       39       p-vss-workfile    = vss-workfile
       40       p-vss-archive     = vss-archive
       41       p-vss-description = vss-description
       42     .
       43   end procedure.
       44   procedure vss-get-parameters :
       45     define output parameter p-vss-parameters as character no-undo .
       46   end procedure.
       47   define new global shared variable g#vssrevis-logger as handle    no-undo .
       48   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       49   define variable v-vssrevis-logger                   as handle    no-undo .
       50   procedure vss-logevent :
       51     define input  parameter p-extra-paramters as character no-undo .
       52     define variable v-vssrevis-parameters as character no-undo .
       53     do
       54     on error undo, return error return-value
       55     :
       56       if  valid-handle(v-vssrevis-logger)
       57       and v-vssrevis-logger :get-signature("logevent") <> ""
       58       then do:
       59         run vss-get-parameters in this-procedure
       60           (output v-vssrevis-parameters
       61           ).
       62         run logevent in v-vssrevis-logger
       63           (input vss-workfile
       64           ,input vss-revision
       65           ,input v-vssrevis-parameters
       66           ,input p-extra-paramters
       67           ).
       68       end.
       69     end.
       70   end procedure.
       71   assign
       72     v-vssrevis-logger = g#vssrevis-logger
       73   .
       74   if  valid-handle(v-vssrevis-logger)
       75   and v-vssrevis-logger :get-signature("logevent") <> ""
       76   then do:
       77     assign
       78       v-vssrevis-logevent = true
       79     .
       80     run vss-logevent in this-procedure (input vss-description) .
       81   end.
       82   define new global shared variable g#language as character no-undo .
       83   if g#language <> '' and g#language <> 'rus':U then do:
       84     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       85   end.
       86   define new global shared variable g#library  as handle no-undo .
       87   define new global shared variable g#library2 as handle no-undo .
       88   procedure proc-alt-shift-f2:
       89     if not ibs.th.gbl.gbl-var:rcode
       90   then
       91     run gbl\inidebug.p .
       92   end.
       93   procedure proc-alt-shift-f3:
       94     run gbl/prvssinf.p
       95       ( input this-procedure
       96       ) .
       97   end.
       98   define variable v-inform-launched as logical no-undo initial false .
       99   procedure proc-alt-shift-f4:
      100     define variable v-action as character no-undo .
      101     if v-inform-launched = false then do:
      102       assign
      103         v-inform-launched = true
      104       .
      105       run gbl/d-inform.w
      106         (  input self
      107         ,  input this-procedure
      108         , output v-action
      109         ) no-error .
      110       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
