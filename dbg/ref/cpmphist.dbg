     3629           v-fltopend-rowid[1] = ?
     3630         .
     3631       end.
     3632       else do:
     3633         assign
     3634         parameter-2-27 = (if p-find-next then "true":u else "false":u )
     3635         parameter-3-27 =  "FOR EACH X_c-pmp-hist"
     3636         parameter-4-27 =
     3637           (
     3638             if (" TRUE " + " " + where-phrase-27) <> ""
     3639             then " TRUE " + " " + where-phrase-27
     3640             else "true"
     3641           )
     3642         parameter-5-27 = (" " + "" + " " + "" + " " + p-find-condition)
     3643         parameter-6-27 = if sort-phrase-27 = ''
     3644                              then
     3645           (
