     3562           l-disable-where-27 =
     3563             (" TRUE " + " " + where-phrase-27 = "")
     3564         .
     3565         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     3566                             ,input query br-pmp-hist:handle
     3567                             ,input parameter-3-27
     3568                             ,input parameter-4-27
     3569                             ,input parameter-5-27
     3570                             ,input parameter-6-27
     3571                             ,input parameter-7-27
     3572                             )
     3573         .
     3574         assign
