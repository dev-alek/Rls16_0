     5054   PROCEDURE proc-b-print :
     5055   define variable date_string     as      char    no-undo.
     5056   define variable Line                as      char    no-undo.
     5057   define variable for-time as char.
     5058   define variable accum-count as integer.
     5059   define variable v-doc-rec as recid no-undo.
     5060   define variable v-prod as character no-undo .
     5061   define variable v-subject-chr as character no-undo .
     5062   define variable v-upd-time as character no-undo .
     5063   define variable v-obj as character no-undo .
     5064   define variable v-action-chr as character no-undo .
     5065   DEFINE VARIABLE v-for-user-name AS CHARACTER NO-UNDO.
     5066   DEFINE FRAME HistoryList
     5067   X_c-pmp-hist.pump-code COLUMN-LABEL "№ ТРК"
     5068   v-action-chr FORMAT "X(10)"  COLUMN-LABEL "Действие"
     5069   v-subject-chr COLUMN-LABEL "Предмет изменений" FORMAT "X(20)"
     5070   X_c-pmp-hist.corr-date
     5071   v-upd-time COLUMN-LABEL "Время изм." FORMAT "X(8)"
     5072   v-for-user-name COLUMN-LABEL "Изменил" FORMAT "X(18)"
     5073   X_c-pmp-hist.corr-user-db-num
     5074   v-obj COLUMN-LABEL "Объект" FORMAT "X(8)"
     5075   HEADER  date_string AT 5 format "X(35)"
     5076   string( "Страница " ) format "X(9)" AT 115 PAGE-NUMBER(PrnLibStream) AT 125 FORMAT ">>9" SKIP
     5077   Line format "X(195)" AT 1
     5078   with width 232 down stream-io use-text    .
     5079   Line = fill("-", 195).
     5080   date_string = cur-time-print() .
     5081   assign
     5082   v-doc-rec = recid( X_c-pmp-hist ).
     5083   DO WHILE available X_c-pmp-hist :
     5084         GET prev br-pmp-hist.
     5085   END.
     5086   run prn-lib-open-stream  in this-procedure (
     5087                                                input parparentProc
     5088                                               ,input 43
     5089                                               ,input yes
     5090                                               ,input no
     5091                                               ).
     5092   PUT  STREAM PrnLibStream
     5093   SPACE(25) ( frame Dialog-Frame:title )
     5094   format "x(90)" SKIP(1) .
     5095   FORM HEADER
     5096   Line format "X(180)" AT 1 SKIP
     5097   "Продолжение - на следующей странице" AT 30 SKIP
     5098   with FRAME BottomFrame width 232 PAGE-BOTTOM NO-LABELS NO-BOX .
     5099   VIEW  STREAM PrnLibStream FRAME BottomFrame .
     5100   FORM with FRAME HistoryList  .
     5101   run waitfram-show in this-procedure ("Ждите...").
     5102     GET next br-pmp-hist.
     5103       DO WHILE available X_c-pmp-hist :
     5104         Display STREAM PrnLibStream
     5105         X_c-pmp-hist.pump-code
     5106         get-action(X_c-pmp-hist.action) @ v-action-chr
     5107         get-subject(X_c-pmp-hist.subject) @ v-subject-chr
     5108         X_c-pmp-hist.corr-date
     5109         string(X_c-pmp-hist.corr-time, "HH:MM:SS":U) @ v-upd-time
     5110         usrfulnf(X_c-pmp-hist.corr-user-name) @ v-for-user-name
     5111         X_c-pmp-hist.corr-user-db-num
     5112         X_c-pmp-hist.obj-type + string(X_c-pmp-hist.obj-code) @ v-obj
     5113         with FRAME HistoryList .
     5114     DOWN STREAM PrnLibStream 1 with FRAME HistoryList  .
     5115     assign
     5116     accum-count = accum-count + 1
     5117     .
     5118     GET next br-pmp-hist.
     5119   END.
     5120   UNDERLINE  STREAM PrnLibStream
     5121   X_c-pmp-hist.pump-code
     5122   v-action-chr
     5123   v-subject-chr
     5124   X_c-pmp-hist.corr-date
     5125   v-upd-time
     5126   v-for-user-name
     5127   X_c-pmp-hist.corr-user-db-num
     5128   v-obj
     5129   with FRAME HistoryList .
     5130   DISPLAY STREAM PrnLibStream
     5131   "ИТОГО"  @ X_c-pmp-hist.pump-code
     5132   string(accum-count)  @ v-action-chr
     5133   with frame HistoryList.
     5134   HIDE  STREAM PrnLibStream FRAME BottomFrame .
     5135   HIDE  STREAM PrnLibStream FRAME CheckList.
     5136   output  STREAM PrnLibStream CLOSE.
     5137   run waitfram-hide in this-procedure.
     5138   run prn-lib-prn-file in this-procedure (
     5139                                             input parparentproc
     5140                                             ,input 8
     5141                                             ).
     5142   reposition br-pmp-hist to recid v-doc-rec no-error.
     5143   apply "entry" to br-pmp-hist in frame Dialog-Frame.
     5144   END PROCEDURE.
