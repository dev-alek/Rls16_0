     3136   def var sort-labelbr-pmp-hist   as character no-undo .
     3137   def var sort-clmnbr-pmp-hist    as handle    no-undo .
     3138   def var cur-clmnbr-pmp-hist     as handle    no-undo .
     3139   def var cur-clmn-locbr-pmp-hist as integer   no-undo .
     3140   def var re-querybr-pmp-hist     as logical   initial no no-undo .
     3141   on start-search, ctrl-o of br-pmp-hist in frame Dialog-Frame do:
     3142      run sort-brbr-pmp-hist
     3143        (input (if available X_c-pmp-hist
     3144                then recid(X_c-pmp-hist)
     3145                else ?
     3146               )
     3147        ).
     3148   end.
     3149   PROCEDURE sort-brbr-pmp-hist :
     3150     define input parameter p-recid as recid no-undo .
     3151     if re-querybr-pmp-hist = no then do:
     3152       assign
     3153          cur-clmnbr-pmp-hist = br-pmp-hist:current-column in frame Dialog-Frame
     3154       .
     3155       if sort-clmnbr-pmp-hist <> ? then sort-clmnbr-pmp-hist:column-fgcolor = 0.
     3156       if cur-clmnbr-pmp-hist = sort-clmnbr-pmp-hist then do:
     3157         assign
     3158            sort-labelbr-pmp-hist = ""
     3159            sort-clmnbr-pmp-hist = ?
     3160         .
     3161        end.
     3162        else do:
     3163          assign
     3164            sort-labelbr-pmp-hist = cur-clmnbr-pmp-hist:label
     3165            sort-clmnbr-pmp-hist  = cur-clmnbr-pmp-hist
     3166            sort-clmnbr-pmp-hist:column-fgcolor = 4
     3167          .
     3168        end.
     3169      end.
     3170     assign
     3171       cur-clmn-locbr-pmp-hist = 1
     3172     .
     3173     def var column-handle as handle no-undo .
     3174     column-handle = br-pmp-hist:first-column.
     3175     do while valid-handle(column-handle) :
     3176       if column-handle = cur-clmnbr-pmp-hist then do:
     3177         leave .
     3178       end.
     3179       column-handle = column-handle:NEXT-COLUMN.
     3180       assign
     3181         cur-clmn-locbr-pmp-hist = cur-clmn-locbr-pmp-hist + 1
     3182       .
     3183     end.
     3184     case sort-labelbr-pmp-hist:
     3185           when X_c-pmp-hist.pump-code:label in browse br-pmp-hist then DO:    assign       sort-column-name = "X_c-pmp-hist.pump-code"     .     run OpenBr in this-procedure ( input yes, input no, input '':U).   . END.
     3186           when X_c-pmp-hist.corr-date:label in browse br-pmp-hist then DO:    assign       sort-column-name = "X_c-pmp-hist.corr-date"     .     run OpenBr in this-procedure ( input yes, input no, input '':U).   . END.
     3187           when X_c-pmp-hist.corr-user-db-num:label in browse br-pmp-hist then DO:    assign       sort-column-name = "X_c-pmp-hist.corr-user-db-num"     .     run OpenBr in this-procedure ( input yes, input no, input '':U).   . END.
     3188       otherwise do:
     3189         assign
     3190           sort-column-name = ""
     3191         .
     3192         run OpenBr in this-procedure ( input yes, input no, input '':U).
     3193           if can-do( this-procedure:internal-entries, 'mv-brw-defaultbr-pmp-hist') then do:
     3194             run mv-brw-defaultbr-pmp-hist.
     3195           end.
     3196         if sort-labelbr-pmp-hist <> "" then do:
     3197           assign
     3198             cur-clmnbr-pmp-hist:column-fgcolor = 0
     3199           .
     3200         end.
     3201         assign
     3202           cur-clmn-locbr-pmp-hist = ?
     3203         .
     3204       end.
     3205     end case.
     3206       if cur-clmn-locbr-pmp-hist <> ? then do:
     3207         if can-do( this-procedure:internal-entries, 'ch-clmnbr-pmp-hist') then do:
     3208           run ch-clmnbr-pmp-hist in this-procedure (cur-clmn-locbr-pmp-hist).
     3209         end.
     3210       end.
     3211     if p-recid <> ? then do:
     3212       reposition br-pmp-hist to recid p-recid no-error.
     3213       apply "value-changed" to br-pmp-hist in frame Dialog-Frame.
     3214     end.
     3215     apply "entry" to br-pmp-hist in frame Dialog-Frame.
     3216   END PROCEDURE.
     3217   procedure re-open-query-srt-clmnbr-pmp-hist:
     3218   if cur-clmnbr-pmp-hist = ? then do:
     3219      run OpenBr in this-procedure ( input yes, input no, input '':U).
     3220   end.
     3221   else do:
     3222      assign re-querybr-pmp-hist = yes.
     3223      run sort-brbr-pmp-hist
     3224        (input (if available X_c-pmp-hist
     3225                then recid(X_c-pmp-hist)
     3226                else ?
     3227               )
     3228        ).
     3229      assign re-querybr-pmp-hist = no.
     3230   end.
     3231   end.
     3232   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3233   do:
     3234     BR-changes :SET-REPOSITIONED-ROW(5, "CONDITIONAL") .
     3235   end.
     3236   MAIN-BLOCK:
     3237   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     3238      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     3239      if p-mode <> 'все':U
     3240    and p-mode <> "one":U
     3241    and p-mode <> 'объект':U
     3242    and p-mode <> "subject":U
     3243    then dO:
     3244       message
     3245       vss-workfile vss-revision vss-description skip
     3246       "Неверное значение параметров вызова p-mode"
     3247       p-mode
     3248       view-as alert-box ERROR.
     3249       return.
     3250    end.
     3251    if p-mode = 'объект':U
     3252    or p-mode = "subject":U
     3253    then do:
     3254     find first X_clients no-lock where
     3255                   X_clients.obj-type = p-obj-type
     3256               and X_clients.obj-code = p-obj-code no-error.
     3257       if not available X_clients then do:
     3258           message
     3259           vss-workfile vss-revision vss-description skip
     3260           "Неверное значение параметра вызова p-obj-type/p-obj-code"
     3261           p-obj-type p-obj-code
     3262           view-as alert-box ERROR.
     3263           return.
     3264       end.
     3265   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3266   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     3267     (input  p-obj-type
     3268     ,input  p-obj-code
     3269     ,output v-host-code
     3270     )  .
     3271    end.
     3272    if p-mode = "one":U
     3273    or p-mode = "subject":U
     3274    then do:
     3275     find first X_pump no-lock where
     3276                X_pump.obj-type = p-obj-type
     3277            AND  X_pump.obj-code = p-obj-code
     3278            AND  X_pump.pump-code = p-pump-code no-error.
     3279       if not available X_pump then do:
     3280           message
     3281           vss-workfile vss-revision vss-description skip
     3282           "Неверное значение параметра вызова p-pump-code" p-pump-code
     3283           view-as alert-box ERROR.
     3284           return.
     3285       end.
     3286     end.
     3287     if p-mode = "subject"  then do:
     3288       if p-subject = 'pl-gds-pump':U
     3289       then do:
     3290           find first X_goods no-lock where
     3291                     X_goods.gds-code = p-gds-code no-error .
     3292           if not available X_goods then do:
     3293               message
     3294               vss-workfile vss-revision vss-description skip
     3295               "Неверное значение параметра вызова p-gds-code" p-gds-code
     3296               view-as alert-box ERROR.
     3297               return.
     3298           end.
     3299       end.
     3300     end.
     3301     v-rid-list = p-rid-list.
     3302     if v-rid-list <> "" then do:
     3303         FIND FIRST find_c-pmp-hist No-LOCK where
     3304                    recid(find_c-pmp-hist) = integer(entry(1, v-rid-list)) No-ERROR.
