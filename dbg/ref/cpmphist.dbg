      867   define variable v-fltopend-rowid as rowid extent 18 no-undo .
      868   procedure fltopend_fltopend :
      869   define input parameter p-parent-handle as handle no-undo .
      870   define input parameter p-qh as handle no-undo .
      871   define input parameter p-flt-open-open-query  as character no-undo .
      872   define input parameter p-where-cond as character no-undo .
      873   define input parameter p-use-indFIRST-query-tail as character no-undo .
      874   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      875   define input parameter p-indexed-reposition as character no-undo .
      876     do
      877     on error undo, return error
      878     :
      879   define variable v-prepare-string as character no-undo .
      880   define variable glog as logical no-undo .
      881   assign
      882   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      883                      p-where-cond + chr(32)  +
      884                      p-use-indFIRST-query-tail + chr(32) +
      885                      p-use-ind-sort-clmn-by + chr(32) +
      886                      p-indexed-reposition
      887   .
      888   assign
      889   glog = p-qh:query-prepare(v-prepare-string) no-error .
      890   if not glog
      891   or error-status:error then do:
      892     message error-status:get-message(1) view-as alert-box .
      893     undo, return error .
      894   end.
      895   assign
      896   glog = p-qh:query-open no-error .
      897   if not glog
      898   or error-status:error then do:
      899     message error-status:get-message(1) view-as alert-box .
      900     undo, return error .
      901   end.
      902     end.
      903   end procedure.
      904   procedure fltopend_fltfindd :
      905   define input parameter p-parent-handle as handle no-undo .
      906   define input parameter p-qh as handle no-undo .
      907   define input parameter p-rowid as rowid no-undo .
      908   define input parameter p-next as logical no-undo .
      909   define input parameter p-lock as integer no-undo .
      910   define input parameter p-bh as handle no-undo .
      911   define input parameter p-where-cond as character no-undo .
      912   define input parameter p-use-index-phrase as character no-undo .
      913   define variable glog as logical no-undo .
      914   define variable v-qh as handle no-undo .
      915   define variable v-bh as handle no-undo .
      916   define variable v-recid as recid no-undo .
      917   define variable v-prepare-string as character no-undo .
      918   do
      919   on error undo, return error
      920   on stop undo, return error
      921   :
      922     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
      923     create buffer v-bh for table p-bh buffer-name p-bh:name.
      924     create query v-qh.
      925     v-qh:set-buffers(v-bh).
      926     v-prepare-string = substitute("for each &1 &2 &3"
      927                                     ,v-bh:name
      928                                     ,p-where-cond
      929                                     ,p-use-index-phrase).
      930     glog = v-qh:query-prepare(v-prepare-string) no-error.
      931     if not glog then do:
      932       delete object v-qh.
      933       delete object v-bh.
      934       undo, return error .
      935     end.
      936     glog = v-qh:query-open no-error .
      937     if not glog then do:
      938       delete object v-qh.
      939       delete object v-bh.
      940       undo, return error .
      941     end.
      942     if p-next then do:
      943       v-qh:reposition-to-rowid(p-rowid) no-error .
      944       glog = v-qh:get-next( p-lock) no-error .
      945       glog = v-qh:get-next( p-lock) no-error .
      946       if not glog or v-qh:query-off-end = yes then do:
      947         glog = v-qh:get-first( p-lock) no-error .
      948       end.
      949     end.
      950     else do:
      951       glog = v-qh:get-first( p-lock) no-error .
      952     end.
      953     v-recid = v-bh:recid no-error .
      954     delete object v-qh.
      955     delete object v-bh.
      956     return string(v-recid) .
      957   end.
      958   end procedure.
      959   procedure fltopend_fltfindq :
      960   define input parameter p-parent-handle as handle no-undo .
      961   define input parameter p-qh as handle no-undo .
      962   define input parameter p-next as logical no-undo .
      963   define input parameter p-lock as integer no-undo .
      964   define input parameter p-flt-open-open-query  as character no-undo .
      965   define input parameter p-where-cond as character no-undo .
      966   define input parameter p-use-indFIRST-query-tail as character no-undo .
      967   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      968   define input parameter p-indexed-reposition as character no-undo .
      969   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
      970   define variable glog as logical no-undo .
      971   define variable v-qh as handle no-undo .
      972   define variable v-bh as handle no-undo extent 18.
      973   define variable v-rowid as rowid no-undo extent 18.
      974   define variable v-ii as integer no-undo .
      975   define variable v-prepare-string as character no-undo .
      976   do
      977   on error undo, return error
      978   on stop undo, return error
      979   :
      980     create query v-qh.
      981     do v-ii = 1 to p-qh:num-buffers:
      982       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
      983       assign
      984       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
      985       no-error.
      986       v-qh:add-buffer(v-bh[v-ii]).
      987     end.
      988     assign
      989     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      990                       p-where-cond + chr(32)  +
      991                       p-use-indFIRST-query-tail + chr(32) +
      992                       p-use-ind-sort-clmn-by + chr(32) +
      993                       p-indexed-reposition
      994     .
      995     glog = v-qh:query-prepare( v-prepare-string) no-error .
      996     if not glog then do:
      997       delete object v-qh.
      998       do v-ii = 1 to p-qh:num-buffers:
      999         delete object v-bh[v-ii].
     1000       end.
     1001       undo, return error .
     1002     end.
     1003     glog = v-qh:query-open no-error .
     1004     if not glog then do:
     1005       delete object v-qh.
     1006       do v-ii = 1 to p-qh:num-buffers:
     1007         delete object v-bh[v-ii].
     1008       end.
     1009       undo, return error .
     1010     end.
     1011     if p-next then do:
     1012       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
     1013       glog = v-qh:get-next( p-lock) no-error .
     1014       glog = v-qh:get-next( p-lock) no-error .
     1015       if not glog or v-qh:query-off-end = yes then do:
     1016         glog = v-qh:get-first( p-lock) no-error .
     1017       end.
     1018     end.
     1019     else do:
     1020       glog = v-qh:get-first( p-lock) no-error .
     1021     end.
     1022     do v-ii = 1 to p-qh:num-buffers:
     1023       assign
     1024       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
     1025       no-error.
     1026     end.
     1027     delete object v-qh.
     1028     do v-ii = 1 to p-qh:num-buffers:
     1029       delete object v-bh[v-ii].
     1030     end.
     1031   end.
     1032   end procedure.
