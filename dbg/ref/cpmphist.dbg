     3427   END PROCEDURE.
     3428   PROCEDURE MyEnable :
     3429   assign
     3430     br-pmp-hist:num-locked-columns in frame Dialog-Frame = 1
     3431     X_c-pmp-hist.corr-date:read-only in browse br-pmp-hist = yes
     3432     br-changes:title = "":U
     3433     temp-changes.l_name:resizable in browse br-changes = true
     3434     temp-changes.v_old:resizable in browse br-changes = true
     3435     temp-changes.v_new:resizable in browse br-changes = true
     3436     temp-changes.l_name:width in browse br-changes = 30
     3437     temp-changes.v_old:width in browse br-changes = 40
     3438     temp-changes.v_new:width in browse br-changes = 40
     3439     .
     3440     VIEW frame Dialog-Frame .
