     3617                             input this-procedure:handle
     3618                             ,input query br-pmp-hist:handle
     3619                             ,input rowid(X_c-pmp-hist)
     3620                             ,input logical(parameter-2-27)
     3621                             ,input no-lock
     3622                             ,input (buffer X_c-pmp-hist:handle)
     3623                             ,input parameter-4-27
     3624                             ,input parameter-5-27
     3625                             ) no-error.
     3626         .
     3627         assign
