     3610         assign
     3611         parameter-2-27 = (if p-find-next then "true":u else "false":u )
     3612         parameter-4-27 =
     3613           "where ":u + " TRUE " + " ":u + where-phrase-27 + " ":u + p-find-condition + " " + ""
     3614         parameter-5-27 = " use-index idate  "
     3615       .
