     1072   FUNCTION get-all-fields returns character (p-file-name as character ):
     1073   define variable v-dop as character no-undo .
     1074     find first _file no-lock where _file._file-name = p-file-name no-error .
     1075     if not available _file then return "":U.
     1076     for each _field no-lock where
     1077              _field._file-recid = recid(_file) :
     1078       assign
     1079       v-dop = v-dop + _field._field-name + chr(44)
     1080       .
     1081     end.
     1082     return trim(v-dop).
     1083   END FUNCTION.
     1084   PROCEDURE proc-full-temp-changes :
     1085     define input  parameter p-hst-handle as handle    no-undo .
     1086     define input  parameter p-main-table as character no-undo .
     1087     define input  parameter p-field-list as character no-undo .
     1088     define input  parameter p-label-form as character no-undo .
     1089     define variable h-new-buf         as handle    no-undo .
     1090     define variable h-main-buf        as handle    no-undo .
     1091     define variable h-for-comp        as handle    no-undo .
     1092     define variable v-inform          as character no-undo .
     1093     define variable v-ind             as integer   no-undo .
     1094     define variable v-idx-field-qnty  as integer   no-undo .
     1095     define variable v-num-entries     as integer   no-undo .
     1096     define variable fh                as handle    no-undo .
     1097     define variable fh-main           as handle    no-undo .
     1098     define variable fh-old            as handle    no-undo .
     1099     define variable fh-new            as handle    no-undo .
     1100     define variable v-field-name      as character no-undo .
     1101     define variable v-field-lvl       as character no-undo .
     1102     define variable v-field-form      as character no-undo .
     1103     define variable v-search-exp      as character no-undo .
     1104     define variable v-srch-main       as character no-undo .
     1105     define variable v-word-link       as character no-undo .
     1106     define variable v-av-chip-num     as logical   no-undo .
     1107     define variable v-main-pi-fld-lst as character no-undo .
     1108     define variable v-main-fld-lst    as character no-undo .
     1109     define variable v-delim-list      as character no-undo .
     1110     define variable v-label           as character no-undo .
     1111     define variable v-old-value       as character no-undo case-sensitive.
     1112     define variable v-new-value       as character no-undo case-sensitive.
     1113     define variable v-chg-fields as character no-undo.
     1114     for each temp-changes:
     1115       delete temp-changes.
     1116     end.
     1117     if not p-hst-handle:available then do:
     1118       return .
     1119     end.
     1120     create buffer h-new-buf  for table p-hst-handle .
     1121     create buffer h-main-buf for table p-main-table .
     1122     assign
     1123       v-inform = h-main-buf:index-information(1)
     1124       v-ind    = 2
     1125     .
     1126     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1127     on error undo, return error
     1128     :
     1129       assign
     1130         v-inform = h-main-buf:index-information( v-ind )
     1131         v-ind    = v-ind + 1
     1132       .
     1133     end.
     1134     if v-inform = ?
     1135       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1136       or entry( 3, v-inform, ",":U ) <> "1":U
     1137     then do:
     1138       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, h-main-buf:name ).
     1139     end.
     1140     assign
     1141       v-idx-field-qnty = num-entries( v-inform ) - 4
     1142     .
     1143     if v-idx-field-qnty < 2 then do:
     1144       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, h-main-buf:name ).
     1145     end.
     1146     assign
     1147       v-srch-main   = "where":U
     1148       v-word-link   = "":U
     1149       v-av-chip-num = false
     1150       v-delim-list  = "":U
     1151     .
     1152     do v-ind = 1 to v-idx-field-qnty by 2
     1153     on error undo, return error
     1154     :
     1155       assign
     1156         v-field-name      = entry( 4 + v-ind, v-inform, ",":U )
     1157         fh                = p-hst-handle:buffer-field( v-field-name )
     1158         fh-main           = h-main-buf:buffer-field( v-field-name )
     1159         v-srch-main       = substitute( "&1 &2 &3.&4 =", v-srch-main, v-word-link, fh-main:table, v-field-name )
     1160         v-main-pi-fld-lst = v-main-pi-fld-lst + v-delim-list + v-field-name
     1161       .
     1162       if fh:data-type ="character":U then do:
     1163         assign
     1164           v-srch-main = substitute( '&1 "&2"', v-srch-main, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
     1165         .
     1166       end.
     1167       else do:
     1168         assign
     1169           v-srch-main = substitute( "&1 &2", v-srch-main, fh:buffer-value() )
     1170         .
     1171       end.
     1172       if v-delim-list = "":U then do:
     1173         assign
     1174           v-delim-list = ",":U
     1175         .
     1176       end.
     1177       if v-word-link = "":U then do:
     1178         assign
     1179           v-word-link = "and":U
     1180         .
     1181       end.
     1182     end.
     1183     assign
     1184       v-delim-list  = "":U
     1185     .
     1186     do v-ind = 1 to h-main-buf:num-fields
     1187     on error undo, return error
     1188     :
     1189       assign
     1190         fh-main      = h-main-buf:buffer-field( v-ind )
     1191         v-field-name = fh-main:name
     1192       .
     1193         assign
     1194           v-main-fld-lst = v-main-fld-lst + v-delim-list + v-field-name
     1195         .
     1196         if v-delim-list = "":U then do:
     1197           assign
     1198             v-delim-list = ",":U
     1199           .
     1200         end.
     1201     end.
     1202     assign
     1203       v-inform = p-hst-handle:index-information(1)
     1204       v-ind    = 2
     1205     .
     1206     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1207     on error undo, return error
     1208     :
     1209       assign
     1210         v-inform = p-hst-handle:index-information( v-ind )
     1211         v-ind    = v-ind + 1
     1212       .
     1213     end.
     1214     if v-inform = ?
     1215       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1216       or entry( 3, v-inform, ",":U ) <> "1":U
     1217     then do:
     1218       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, p-hst-handle:name ).
     1219     end.
     1220     assign
     1221       v-idx-field-qnty = num-entries( v-inform ) - 4
     1222     .
     1223     if v-idx-field-qnty < 2 then do:
     1224       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, p-hst-handle:name ).
     1225     end.
     1226     assign
     1227       v-search-exp  = "where":U
     1228       v-word-link   = "":U
     1229       v-av-chip-num = false
     1230     .
     1231     do v-ind = 1 to v-idx-field-qnty by 2
     1232     on error undo, return error
     1233     :
     1234       assign
     1235         v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     1236         fh           = p-hst-handle:buffer-field( v-field-name )
     1237         v-search-exp = substitute( "&1 &2 &3.&4", v-search-exp, v-word-link, fh:table, v-field-name )
     1238       .
     1239       if v-field-name = "chip-num":U then do:
     1240         assign
     1241           v-search-exp  = substitute( "&1 >", v-search-exp )
     1242           v-av-chip-num = true
     1243         .
     1244       end.
     1245       else do:
     1246         assign
     1247           v-search-exp = substitute( "&1 =", v-search-exp )
     1248         .
     1249       end.
     1250       if fh:data-type ="character":U then do:
     1251         assign
     1252           v-search-exp = substitute( '&1 "&2"', v-search-exp, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
     1253         .
     1254       end.
     1255       else do:
     1256         assign
     1257           v-search-exp = substitute( '&1 &2', v-search-exp, fh:buffer-value() )
     1258         .
     1259       end.
     1260       if v-word-link = "":U then do:
     1261         assign
     1262           v-word-link = "and":U
     1263         .
     1264       end.
     1265     end.
     1266     if v-av-chip-num = false then do:
     1267       message
     1268         vss-workfile vss-revision vss-description skip
     1269         substitute( "Таблица &2 не содержит поля chip-num.", vss-workfile, p-hst-handle:name ) skip
     1270         "Использование данной процедуры невозможно!" skip
     1271         view-as alert-box error .
     1272       return error .
     1273     end.
     1274     h-new-buf:find-first( v-search-exp, no-lock ) no-error .
     1275     if not h-new-buf:available then do:
     1276       h-main-buf:find-first( v-srch-main, no-lock ) no-error .
     1277       if not h-main-buf:available then do:
     1278         assign
     1279           h-for-comp = ?
     1280         .
     1281       end.
     1282       else do:
     1283         assign
     1284           h-for-comp = h-main-buf
     1285         .
     1286       end.
     1287     end.
     1288     else do:
     1289       assign
     1290         h-for-comp = h-new-buf
     1291       .
     1292     end.
     1293     assign
     1294       v-num-entries = num-entries( v-main-fld-lst, ",":U )
     1295     .
     1296     do v-ind = 1 to v-num-entries
     1297     on error undo, return error return-value
     1298     :
     1299       assign
     1300         v-field-name = entry( v-ind, v-main-fld-lst )
     1301         fh-old       = p-hst-handle:buffer-field( v-field-name )
     1302         v-old-value  = fh-old:buffer-value()
     1303         v-label      = trim( fh-old:label )
     1304       .
     1305       if ( trim( p-field-list ) <> "":U
     1306            and lookup( v-field-name, p-field-list ) > 0
     1307          )
     1308          or trim( p-field-list ) = "":U
     1309       then do:
     1310         if h-for-comp <> ? then do:
     1311           assign
     1312             fh-new      = h-for-comp:buffer-field( v-field-name )
     1313             v-new-value = fh-new:buffer-value()
     1314           .
     1315         end.
     1316         else do:
     1317           assign
     1318             v-new-value = "":U
     1319           .
     1320         end.
     1321         if v-old-value <> v-new-value
     1322         then do:
     1323           create temp-changes.
     1324           assign
     1325             temp-changes.t_name = p-main-table
     1326             temp-changes.f_name = v-field-name
     1327             temp-changes.l_name = replace( v-label, "&":U, "":U )
     1328             temp-changes.v_old  = trim( v-old-value )
     1329             temp-changes.v_new  = trim( v-new-value )
     1330             temp-changes.num_   = 0
     1331             temp-changes.fNotChange = v-old-value eq v-new-value
     1332           .
     1333         end.
     1334       end.
     1335     end.
     1336     assign
     1337       v-num-entries = num-entries( p-label-form, chr(8) )
     1338     .
     1339     do v-ind = 1 to v-num-entries
     1340     on error undo, return error return-value
     1341     :
     1342       if num-entries( entry( v-ind, p-label-form, chr(8) ), chr(4) ) = 3 then do:
     1343         assign
     1344           v-field-name = entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1345           v-field-lvl  = entry( 2, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1346           v-field-form = entry( 3, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1347         .
     1348         find first temp-changes
     1349           where temp-changes.f_name = v-field-name
     1350           no-error .
     1351         if available temp-changes then do:
     1352           if trim( v-field-lvl ) <> "":U then do:
     1353             assign
     1354               temp-changes.l_name = v-field-lvl
     1355             .
     1356           end.
     1357           if trim( v-field-form ) <> "":U then do:
     1358             assign
     1359               temp-changes.v_old = dynamic-function( v-field-form, temp-changes.v_old )
     1360             .
     1361             if h-for-comp <> ? then do:
     1362               assign
     1363                 temp-changes.v_new = dynamic-function( v-field-form, temp-changes.v_new )
     1364               .
     1365             end.
     1366           end.
     1367         end.
     1368       end.
     1369       else do:
     1370         message
     1371           vss-workfile vss-revision vss-description skip
     1372           "Ошибка! Список должен содержать три поля с разделителем delim-par!" skip
     1373           substitute( "список для поля '&1': '&2'"
     1374                       ,entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1375                       ,entry( v-ind, p-label-form, chr(8) )
     1376                     ) skip
     1377           substitute( "полный список: &2", p-label-form ) skip
     1378           view-as alert-box error .
     1379       end.
     1380     end.
     1381     delete object h-new-buf .
     1382     delete object h-main-buf .
     1383   END PROCEDURE.
     1384   FUNCTION get-action RETURNS CHARACTER
     1385     ( p-action as integer )  FORWARD.
     1386   FUNCTION get-subject RETURNS CHARACTER
     1387     ( p-subject as character )  FORWARD.
     1388   DEFINE BUTTON B-Help
     1389        LABEL "Помо&щь"
     1390        SIZE 3 BY 1
     1391        BGCOLOR 8 .
     1392   DEFINE BUTTON B-lookup
     1393        LABEL "&Просмотр"
     1394        SIZE 10 BY 1.
     1395   DEFINE BUTTON B-mark
     1396        LABEL "&*"
     1397        SIZE 3 BY 1.
     1398   DEFINE BUTTON B-print
     1399        LABEL "Пе&чать"
     1400        SIZE 3 BY 1.
     1401   DEFINE BUTTON b-quit AUTO-END-KEY
     1402        LABEL "&Выход"
     1403        SIZE 10 BY 1
     1404        BGCOLOR 8 .
     1405   DEFINE BUTTON B-sch
     1406        LABEL "&Фильтр"
     1407        SIZE 3 BY 1.
     1408   DEFINE BUTTON b-sel AUTO-GO
     1409        LABEL "Вы&бор"
     1410        SIZE 10 BY 1
     1411        BGCOLOR 8 .
     1412   DEFINE VARIABLE mark-num AS CHARACTER FORMAT "X(256)":U
     1413         VIEW-AS TEXT
     1414        SIZE 6 BY 1
     1415        FGCOLOR 4  NO-UNDO.
     1416   DEFINE VARIABLE sch-corr-date AS DATE FORMAT "99/99/9999":U
     1417        LABEL "Дате изменения"
     1418        VIEW-AS FILL-IN
     1419        SIZE 11 BY 1 NO-UNDO.
     1420   DEFINE VARIABLE sch-corr-user-name AS CHARACTER FORMAT "X(9)":U
     1421        LABEL "пользователю"
     1422        VIEW-AS FILL-IN
     1423        SIZE 12 BY 1 TOOLTIP "Поиск первой записи - <ВВОД>; поиск следующей - <CTRL-J>" NO-UNDO.
     1424   DEFINE VARIABLE sch-pump-code AS INTEGER FORMAT ">>>>>>9":U INITIAL 0
     1425        LABEL "№ ТРК"
     1426        VIEW-AS FILL-IN
     1427        SIZE 8 BY 1 TOOLTIP "Поиск первой записи - <ВВОД>; поиск следующей - <CTRL-J>" NO-UNDO.
     1428   DEFINE QUERY BR-changes FOR
     1429         temp-changes SCROLLING.
     1430   DEFINE QUERY br-pmp-hist FOR
     1431         X_c-pmp-hist SCROLLING.
     1432   DEFINE BROWSE BR-changes
     1433     QUERY BR-changes DISPLAY
     1434         temp-changes.l_name COLUMn-LABEL "Изменилось" format "X(40)"
     1435   temp-changes.v_old COLUMn-LABEL "Было" format "X(70)"
     1436   temp-changes.v_new COLUMn-LABEL "Стало" format "X(70)"
     1437       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 7.25.
     1438   DEFINE BROWSE br-pmp-hist
     1439     QUERY br-pmp-hist NO-LOCK DISPLAY
     1440         mark-string(recid(X_c-pmp-hist), v-rid-list) COLUMN-LABEL "*" FORMAT "X(1)":U
     1441         X_c-pmp-hist.pump-code COLUMN-LABEL "№ ТРК" FORMAT ">9":U
     1442         X_c-pmp-hist.corr-date FORMAT "99/99/9999":U
     1443         string(X_c-pmp-hist.corr-time, "HH:MM:SS":U) COLUMN-LABEL "Время изм." FORMAT "X(8)":U
     1444         usrfulnf(X_c-pmp-hist.corr-user-name) FORMAT "X(18)":U
     1445         get-action(X_c-pmp-hist.action) COLUMN-LABEL "Действие" FORMAT "X(10)":U
     1446         X_c-pmp-hist.corr-user-db-num FORMAT ">>>>9":U
     1447         get-subject(X_c-pmp-hist.subject) COLUMN-LABEL "Предмет изменений" FORMAT "X(15)":U
     1448         X_c-pmp-hist.obj-type + string(X_c-pmp-hist.obj-code) COLUMN-LABEL "Объект" FORMAT "X(8)":U
     1449     ENABLE
     1450         X_c-pmp-hist.corr-date
     1451       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 11.46.
     1452   DEFINE FRAME Dialog-Frame
     1453        b-quit AT ROW 1 COL 1
     1454        B-mark AT ROW 1 COL 11
     1455        b-sel AT ROW 1 COL 21
     1456        B-print AT ROW 1 COL 89
     1457        B-sch AT ROW 1 COL 92
     1458        B-Help AT ROW 1 COL 95
     1459        B-lookup AT ROW 1.04 COL 45
     1460        br-pmp-hist AT ROW 2 COL 1
     1461        sch-corr-date AT ROW 13.63 COL 85.75 COLON-ALIGNED
     1462        sch-pump-code AT ROW 13.67 COL 56.13 COLON-ALIGNED
     1463        sch-corr-user-name AT ROW 13.71 COL 22.5 COLON-ALIGNED
     1464        BR-changes AT ROW 14.79 COL 1
     1465        mark-num AT ROW 1 COL 12.5 COLON-ALIGNED NO-LABEL
     1466        "ПОИСК ПО" VIEW-AS TEXT
     1467             SIZE 8.38 BY 1 AT ROW 13.63 COL 1.38
     1468             FGCOLOR 4
     1469        SPACE(89.48) SKIP(7.44)
     1470       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1471            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1472            TITLE "Полная история по ТРК"
     1473            CANCEL-BUTTON b-quit.
     1474   ASSIGN
     1475          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1476          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1477   ON GO OF FRAME Dialog-Frame
     1478   DO:
     1479     p-rid-list = v-rid-list.
     1480   END.
     1481   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1482   DO:
     1483     APPLY "END-ERROR":U TO SELF.
     1484   END.
     1485   ON CHOOSE OF B-lookup IN FRAME Dialog-Frame
     1486   DO:
     1487     DEFINE VARIABLE v-rec AS RECID NO-UNDO.
     1488     DEFINE BUFFER buf_c-pump FOR ub.c-pump.
     1489     DEFINE BUFFER buf_c-pl-gds-pump FOR ub.c-pl-gds-pump.
     1490     DEFINE BUFFER buf_c-pl-pump FOR ub.c-pl-pump.
     1491     DEFINE BUFFER buf_c-pl-pump-nozzle FOR ub.c-pl-pump-nozzle.
     1492     DEFINE BUFFER buf_c-pump-nozzle FOR ub.c-pl-pump-nozzle.
     1493       IF AVAILABLE X_c-pmp-hist THEN DO:
     1494       CASE X_c-pmp-hist.subject:
     1495         WHEN 'place':U THEN DO:
     1496           find first buf_c-pump no-lock where
     1497                  buf_c-pump.obj-type = p-obj-type
     1498              AND buf_c-pump.obj-code = p-obj-code
     1499              AND buf_c-pump.pump-code = X_c-pmp-hist.pump-code
     1500              AND buf_c-pump.chip-num = X_c-pmp-hist.chip-num
     1501              AND buf_c-pump.corr-user-db-num = X_c-pmp-hist.corr-user-db-num
     1502              no-error .
     1503              ASSIGN v-rec = RECID(buf_c-pump).
     1504               run str/c-pumpa.w (
     1505                              INPUT 'ПРОСМОТР':U
     1506                             ,INPUT-OUTPUT v-rec) NO-ERROR.
     1507           END.
     1508       END CASE.
     1509     END.
     1510   END.
     1511   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
     1512   DO:
     1513   define variable loc#log as logical no-undo .
     1514     if available X_c-pmp-hist then do:
     1515   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1516   define variable v-str-recid14 as character no-undo .
     1517   define variable v-num-entry14 as integer   no-undo .
     1518   assign
     1519     v-str-recid14 = trim( string( recid( X_c-pmp-hist ) , "->>>>>>>>>>>9":U ) )
     1520     v-num-entry14 = lookup( v-str-recid14 , v-rid-list )
     1521   .
     1522   if v-num-entry14 > 0 then do:
     1523     assign
     1524       entry( v-num-entry14, v-rid-list ) = "":U
     1525       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1526     .
     1527   end.
     1528   else do:
     1529     assign
     1530       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid14
     1531     .
     1532   end.
     1533       loc#log = br-pmp-hist:refresh() .
     1534       if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
     1535           loc#log = br-pmp-hist:select-next-row ().
     1536           apply "VALUE-CHANGED" to br-pmp-hist in frame Dialog-Frame.
     1537       end.
     1538       if num-entries( v-rid-list ) = 0
     1539       then
     1540           hide mark-num in frame Dialog-Frame.
     1541       else
     1542           disp num-entries( v-rid-list ) @ mark-num with frame Dialog-Frame.
     1543     end.
     1544     apply "entry" to br-pmp-hist in frame Dialog-Frame.
     1545   END.
     1546   ON CHOOSE OF B-print IN FRAME Dialog-Frame
     1547   DO:
     1548       run proc-b-print in this-procedure no-error.
     1549     if error-status:error then return no-apply.
     1550   END.
     1551   ON CHOOSE OF B-sch IN FRAME Dialog-Frame
     1552   DO:
     1553       run proc-b-sch in this-procedure no-error.
     1554     if error-status:error then return no-apply.
     1555   END.
     1556   ON CHOOSE OF b-sel IN FRAME Dialog-Frame
     1557   DO:
     1558     if ( available X_c-pmp-hist ) then do:
     1559       if ( v-rid-list = "" ) or b-mark:sensitive = no
     1560       then
     1561       v-rid-list = string( recid( X_c-pmp-hist ) ) .
     1562     end.
     1563   END.
     1564   ON MOUSE-SELECT-DBLCLICK OF br-pmp-hist IN FRAME Dialog-Frame
     1565   DO:
     1566        run proc-br-pmp-hist in this-procedure no-error.
     1567     if error-status:error then return no-apply.
     1568   END.
     1569   ON RETURN OF br-pmp-hist IN FRAME Dialog-Frame
     1570   DO:
     1571       run proc-br-pmp-hist in this-procedure no-error.
     1572     if error-status:error then return no-apply.
     1573   END.
     1574   ON VALUE-CHANGED OF br-pmp-hist IN FRAME Dialog-Frame
     1575   DO:
     1576     run proc-view-changes in this-procedure no-error.
     1577   END.
     1578   ON CTRL-J OF sch-corr-date IN FRAME Dialog-Frame
     1579   DO:
     1580      run proc-find-corr-date in this-procedure(yes, input frame Dialog-Frame sch-corr-date) no-error.
     1581     if error-status:error then return no-apply.
     1582   END.
     1583   ON RETURN OF sch-corr-date IN FRAME Dialog-Frame
     1584   DO:
     1585     run proc-find-corr-date in this-procedure(no, input frame Dialog-Frame sch-corr-date) no-error.
     1586     if error-status:error then return no-apply.
     1587   END.
     1588   ON CTRL-J OF sch-corr-user-name IN FRAME Dialog-Frame
     1589   DO:
     1590     run proc-find-user in this-procedure(yes, input frame Dialog-Frame sch-corr-user-name) no-error.
     1591     if error-status:error then return no-apply.
     1592   END.
     1593   ON RETURN OF sch-corr-user-name IN FRAME Dialog-Frame
     1594   DO:
     1595     run proc-find-user in this-procedure(no, input frame Dialog-Frame sch-corr-user-name) no-error.
     1596     if error-status:error then return no-apply.
     1597   END.
     1598   ON CTRL-J OF sch-pump-code IN FRAME Dialog-Frame
     1599   DO:
     1600     run proc-find-pump-code in this-procedure(yes, input frame Dialog-Frame sch-pump-code) no-error.
     1601     if error-status:error then return no-apply.
     1602   END.
     1603   ON RETURN OF sch-pump-code IN FRAME Dialog-Frame
     1604   DO:
     1605     run proc-find-pump-code in this-procedure(no, input frame Dialog-Frame sch-pump-code) no-error.
     1606     if error-status:error then return no-apply.
     1607   END.
     1608   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1609   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1610   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1611   on help of frame Dialog-Frame
     1612   do:
     1613     run gbl/app_help.p
     1614       (input this-procedure :file-name
     1615       ,input ''
     1616       ,input ?
     1617       ) no-error.
     1618     if error-status :error then do:
     1619       message
     1620         "Ошибка при вызове помощи"
     1621         error-status :get-message(1)
     1622         view-as alert-box .
     1623     end.
     1624   end.
     1625   run minbtn-set in this-procedure .
     1626   on choose of b-help in frame Dialog-Frame
     1627   do:
     1628     apply "help":u to frame Dialog-Frame .
     1629   end.
     1630   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1631   procedure minbtn-set :
     1632       do
     1633           on error undo, return error return-value
     1634           :
     1635           define variable ii              as integer       no-undo .
     1636           define variable fh              as widget-handle no-undo .
     1637           define variable hh              as widget-handle no-undo .
     1638           define variable v-h             as handle        extent 4 no-undo .
     1639           define variable v-name-button   as character     no-undo .
     1640           define variable v-help-old-x    as decimal       no-undo .
     1641           define variable v-help-old-y    as decimal       no-undo .
     1642           define variable v-help-old-size as decimal       no-undo .
     1643           define variable v-frame-width   as decimal       no-undo .
     1644           define variable jj              as integer       no-undo .
     1645           do
     1646               on error undo, return error
     1647               :
     1648               assign
     1649                   v-frame-width = frame Dialog-Frame:width - 0.3
     1650                   fh            = frame Dialog-Frame:first-child
     1651                   hh            = fh:first-child
     1652                   ii            = 1
     1653                   .
     1654               do while valid-handle(hh):
     1655                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1656                   do:
     1657                       case lc(hh:name) :
     1658                           when "b-help" then
     1659                               do:
     1660                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1661                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1662                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1663                                   hh:TOOLTIP = "Помощь" .
     1664                                   v-help-old-x = hh:column .
     1665                                   v-help-old-y = hh:row    .
     1666                                   v-help-old-size = hh:width .
     1667                                   hh:width-chars = 2.5 .
     1668                               end.
     1669                           when "b-print" then
     1670                               do:
     1671                                   hh:load-image("cmp/b-print.bmp":u) .
     1672                                   hh:TOOLTIP = "Печать" .
     1673                                   v-h[ii] = hh:handle .
     1674                                   ii = ii + 1 .
     1675                                   hh:width-chars = 3 .
     1676                               end.
     1677                           when "b-history" or
     1678                           when "b-hist" then
     1679                               do:
     1680                                   hh:load-image("cmp/b-hist.bmp":u) .
     1681                                   hh:TOOLTIP = "История" .
     1682                                   v-h[ii] = hh:handle .
     1683                                   ii = ii + 1 .
     1684                                   hh:width-chars = 3 .
     1685                               end.
     1686                           when "b-sch" then
     1687                               do:
     1688                                   hh:load-image("cmp/b-sch.bmp":u) .
     1689                                   hh:TOOLTIP = "Установка Фильтра" .
     1690                                   v-h[ii] = hh:handle .
     1691                                   ii = ii + 1 .
     1692                                   hh:width-chars = 3 .
     1693                               end.
     1694                           when "b-hist-user" then
     1695                               do:
     1696                                   hh:load-image("cmp/b-hist.bmp":u) .
     1697                                   hh:TOOLTIP = "История пользователя" .
     1698                                   ii = ii + 1 .
     1699                               end.
     1700                       end case.
     1701                   end.
     1702                   hh = hh:next-sibling.
     1703               end.
     1704               b-help:column = v-frame-width - b-help:width-chars.
     1705               jj = 0.
     1706               repeat ii = 4 to 1 by -1 :
     1707                   if valid-handle (v-h[ii] ) then
     1708                   do:
     1709                       jj  = jj + 1 .
     1710                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1711                       v-h[ii]:row    = v-help-old-y .
     1712                   end.
     1713               end.
     1714           end.
     1715       end.
     1716   end procedure.
     1717   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1718   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1719   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1720   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1721   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1722   define variable v-diasize-current-frame-height as decimal   no-undo .
     1723   define variable v-diasize-change-size          as logical   no-undo .
     1724   define variable v-diasize-resize-button        as handle    no-undo .
     1725   define variable v-diasize-wndmax               as logical   no-undo .
     1726   define variable v-diasize-wndstore             as logical   no-undo .
     1727   define variable v-diasize-proc-name            as character no-undo .
     1728   define variable v-diasize-browse-handle        as handle    no-undo .
     1729   define variable v-diasize-browse-number        as integer   no-undo .
     1730   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1731   define temp-table temp-diasize-handle no-undo
     1732     field handle-value  as handle
     1733     field save-position as decimal
     1734     index xpk is primary unique handle-value
     1735     .
     1736   define temp-table temp-browse-handle no-undo
     1737     field browse-type   as character
     1738     field browse-number as integer
     1739     field browse-handle as handle
     1740     field original-size as decimal
     1741     index xpk is primary unique browse-type browse-number
     1742     index xie browse-type browse-handle
     1743   .
     1744   procedure diasize_change-height :
     1745     define input  parameter p-change-value  as decimal   no-undo .
     1746     define input  parameter p-move-resize   as logical   no-undo .
     1747     define variable v-field-group-handle    as handle    no-undo .
     1748     define variable v-object-handle         as handle    no-undo .
     1749     define variable v-frame-height          as decimal   no-undo .
     1750     define variable v-frame-virtual-height  as decimal   no-undo .
     1751     define variable v-browse-height         as decimal   no-undo .
     1752     define variable v-window-height         as decimal   no-undo .
     1753     define variable v-window-virtual-height as decimal   no-undo .
     1754     define variable v-change-sign           as integer   no-undo .
     1755     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1756     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1757     if p-change-value > 0
     1758     then do:
     1759       if frame Dialog-Frame :height + p-change-value
     1760           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1761       then do:
     1762         assign
     1763           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1764                           - (frame Dialog-Frame :height-chars)
     1765         .
     1766         if p-change-value <= 0
     1767         then do:
     1768           run diasize_position-resize-button in this-procedure .
     1769           return .
     1770         end.
     1771       end.
     1772     end.
     1773     if p-change-value < 0
     1774     then do:
     1775       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1776       then do:
     1777         assign
     1778           p-change-value = v-diasize-orig-frame-height
     1779                          - (frame Dialog-Frame :height-chars)
     1780         .
     1781         if p-change-value >= 0
     1782         then do:
     1783           run diasize_position-resize-button in this-procedure .
     1784           return .
     1785         end.
     1786       end.
     1787     end.
     1788     if p-change-value >= 0
     1789     then do:
     1790       assign
     1791         v-change-sign = 1
     1792       .
     1793     end.
     1794     else do:
     1795       assign
     1796         v-change-sign = -1
     1797       .
     1798     end.
     1799     assign
     1800       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1801     .
     1802     if p-change-value = 0
     1803     then do:
     1804       run diasize_position-resize-button in this-procedure .
     1805       return .
     1806     end.
     1807     move_block:
     1808     do
     1809     on error undo move_block, retry move_block
     1810     :
     1811       if retry
     1812       then do:
     1813         do
     1814         on error undo move_block, leave move_block
     1815         :
     1816           if p-change-value > 0
     1817           then do:
     1818             for each buf_temp-diasize-handle
     1819             on error undo, next
     1820             :
     1821               assign
     1822                 v-object-handle = buf_temp-diasize-handle.handle-value
     1823               .
     1824               if v-object-handle <> v-diasize-resize-button
     1825               then do:
     1826                 assign
     1827                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1828                 .
     1829               end.
     1830             end.
     1831             assign
     1832               v-diasize-browse-handle :height = v-browse-height
     1833             .
     1834             for each buf_temp-browse-handle
     1835               where buf_temp-browse-handle.browse-type = 'height':u
     1836             on error undo, next
     1837             :
     1838               assign
     1839                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1840               .
     1841             end.
     1842             assign
     1843               frame Dialog-Frame :height = v-frame-height
     1844             .
     1845             if frame Dialog-Frame :scrollable = true
     1846             then do:
     1847               assign
     1848                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1849               .
     1850             end.
     1851             run diasize_position-resize-button in this-procedure .
     1852           end.
     1853           else do:
     1854             if frame Dialog-Frame :scrollable = true
     1855             then do:
     1856               assign
     1857                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1858               .
     1859             end.
     1860             assign
     1861               frame Dialog-Frame :height = v-frame-height
     1862             .
     1863             assign
     1864               v-diasize-browse-handle :height = v-browse-height
     1865             .
     1866             for each buf_temp-browse-handle
     1867               where buf_temp-browse-handle.browse-type = 'height':u
     1868             on error undo, next
     1869             :
     1870               assign
     1871                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1872               .
     1873             end.
     1874             for each buf_temp-diasize-handle
     1875             on error undo, next
     1876             :
     1877               assign
     1878                 v-object-handle = buf_temp-diasize-handle.handle-value
     1879               .
     1880               if v-object-handle <> v-diasize-resize-button
     1881               then do:
     1882                 assign
     1883                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1884                 .
     1885               end.
     1886             end.
     1887             run diasize_position-resize-button in this-procedure .
     1888           end.
     1889           assign
     1890             v-diasize-change-size = false
     1891           .
     1892           leave move_block .
     1893         end.
     1894       end.
     1895       assign
     1896         v-diasize-need-full-display = true
     1897       .
     1898       if v-diasize-change-size = false
     1899       then do:
     1900         assign
     1901           v-diasize-change-size = true
     1902         .
     1903       end.
     1904       else do:
     1905         return .
     1906       end.
     1907       assign
     1908         v-frame-height = frame Dialog-Frame :height
     1909         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1910         v-browse-height = v-diasize-browse-handle :height
     1911       .
     1912       for each buf_temp-browse-handle
     1913         where buf_temp-browse-handle.browse-type = 'height':u
     1914       :
     1915         assign
     1916           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1917         .
     1918       end.
     1919       for each buf_temp-diasize-handle
     1920       :
     1921         delete buf_temp-diasize-handle .
     1922       end.
     1923       assign
     1924         v-field-group-handle = frame Dialog-Frame :first-child
     1925       .
     1926       do while valid-handle(v-field-group-handle)
     1927       :
     1928         assign
     1929           v-object-handle = v-field-group-handle :first-child
     1930         .
     1931         do while valid-handle(v-object-handle)
     1932         :
     1933           if  v-object-handle <> v-diasize-browse-handle :handle
     1934           and can-query(v-object-handle, "row")
     1935           and can-query(v-object-handle, "height")
     1936           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1937           then do:
     1938             find first buf_temp-browse-handle
     1939               where buf_temp-browse-handle.browse-type   = 'height':u
     1940                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1941               no-error .
     1942             if available buf_temp-browse-handle
     1943             then do:
     1944             end.
     1945             else do:
     1946               create buf_temp-diasize-handle .
     1947               assign
     1948                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1949                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1950               .
     1951             end.
     1952           end.
     1953           assign
     1954             v-object-handle = v-object-handle :next-sibling
     1955           .
     1956         end.
     1957         assign
     1958           v-field-group-handle = v-field-group-handle :next-sibling
     1959         .
     1960       end.
     1961       do with frame Dialog-Frame
     1962       :
     1963         hide v-diasize-resize-button .
     1964         assign
     1965           v-diasize-resize-button :row    = 1
     1966           v-diasize-resize-button :column = 1
     1967         .
     1968       end.
     1969       if p-change-value > 0
     1970       then do:
     1971         if frame Dialog-Frame :scrollable = true
     1972         then do:
     1973           assign
     1974             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1975             no-error .
     1976           if error-status :error
     1977           or error-status :get-message(1) <> ""
     1978           then do:
     1979             undo move_block, retry move_block .
     1980           end.
     1981         end.
     1982         assign
     1983           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1984           no-error .
     1985         if error-status :error
     1986         or error-status :get-message(1) <> ""
     1987         then do:
     1988           undo move_block, retry move_block .
     1989         end.
     1990         assign
     1991           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1992           no-error .
     1993         if error-status :error
     1994         or error-status :get-message(1) <> ""
     1995         then do:
     1996           undo move_block, retry move_block .
     1997         end.
     1998         for each buf_temp-browse-handle
     1999           where buf_temp-browse-handle.browse-type = 'height':u
     2000         on error undo move_block, retry move_block
     2001         :
     2002           assign
     2003             buf_temp-browse-handle.browse-handle :height
     2004               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2005             no-error .
     2006           if error-status :error
     2007           or error-status :get-message(1) <> ""
     2008           then do:
     2009             undo move_block, retry move_block .
     2010           end.
     2011         end.
     2012         for each buf_temp-diasize-handle
     2013         on error undo move_block, retry move_block
     2014         :
     2015           assign
     2016             v-object-handle = buf_temp-diasize-handle.handle-value
     2017           .
     2018           if v-object-handle <> v-diasize-resize-button
     2019           then do:
     2020             assign
     2021               v-object-handle :row = v-object-handle :row + p-change-value
     2022               no-error .
     2023             if error-status :error
     2024             or error-status :get-message(1) <> ""
     2025             then do:
     2026               undo move_block, retry move_block .
     2027             end.
     2028           end.
     2029         end.
     2030       end.
     2031       else do:
     2032         for each buf_temp-diasize-handle
     2033         on error undo move_block, retry move_block
     2034         :
     2035           assign
     2036             v-object-handle = buf_temp-diasize-handle.handle-value
     2037           .
     2038           if v-object-handle <> v-diasize-resize-button
     2039           then do:
     2040             assign
     2041               v-object-handle :row = v-object-handle :row + p-change-value
     2042               no-error .
     2043             if error-status :error
     2044             or error-status :get-message(1) <> ""
     2045             then do:
     2046               undo move_block, retry move_block .
     2047             end.
     2048           end.
     2049         end.
     2050         assign
     2051           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2052           no-error .
     2053         if error-status :error
     2054         or error-status :get-message(1) <> ""
     2055         then do:
     2056           undo move_block, retry move_block .
     2057         end.
     2058         for each buf_temp-browse-handle
     2059           where buf_temp-browse-handle.browse-type = 'height':u
     2060         on error undo move_block, retry move_block
     2061         :
     2062           assign
     2063             buf_temp-browse-handle.browse-handle :height
     2064               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2065             no-error .
     2066           if error-status :error
     2067           or error-status :get-message(1) <> ""
     2068           then do:
     2069             undo move_block, retry move_block .
     2070           end.
     2071         end.
     2072         assign
     2073           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2074           no-error .
     2075         if error-status :error
     2076         or error-status :get-message(1) <> ""
     2077         then do:
     2078           undo move_block, retry move_block .
     2079         end.
     2080         if frame Dialog-Frame :scrollable = true
     2081         then do:
     2082           assign
     2083             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2084             no-error .
     2085           if error-status :error
     2086           or error-status :get-message(1) <> ""
     2087           then do:
     2088             undo move_block, retry move_block .
     2089           end.
     2090         end.
     2091       end.
     2092       if p-move-resize = true
     2093       then do:
     2094         run diasize_position-resize-button in this-procedure .
     2095       end.
     2096       if v-diasize-wndstore = true
     2097       then do:
     2098         if connected("ub") = true
     2099         then do:
     2100           define variable v-cntxt-db-num        as integer   no-undo .
     2101           define variable v-cntxt-userid        as character no-undo .
     2102           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2103                                             , OUTPUT v-cntxt-userid
     2104                                             ) .
     2105           run gbl/wndsizew.p
     2106             (input  v-cntxt-db-num
     2107             ,input  v-cntxt-userid
     2108             ,input  v-diasize-proc-name
     2109             ,input  'height':u
     2110             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     2111             ) .
     2112         end.
     2113       end.
     2114     end.
     2115     assign
     2116       v-diasize-change-size = false
     2117     .
     2118   end procedure.
     2119   procedure diasize_set-height :
     2120     define input  parameter p-new-height  as decimal   no-undo .
     2121     define input  parameter p-move-resize as logical   no-undo .
     2122     do
     2123     on error undo, return error return-value
     2124     :
     2125       run diasize_change-height in this-procedure
     2126         (input  (p-new-height - frame Dialog-Frame :height)
     2127         ,input  p-move-resize
     2128         ) .
     2129     end.
     2130   end procedure.
     2131   procedure diasize_change-width :
     2132     define input  parameter p-change-value as decimal   no-undo .
     2133     define input  parameter p-move-resize  as logical   no-undo .
     2134     define variable v-field-group-handle   as handle    no-undo .
     2135     define variable v-object-handle        as handle    no-undo .
     2136     define variable v-frame-width          as decimal   no-undo .
     2137     define variable v-frame-virtual-width  as decimal   no-undo .
     2138     define variable v-browse-width         as decimal   no-undo .
     2139     define variable v-window-width         as decimal   no-undo .
     2140     define variable v-window-virtual-width as decimal   no-undo .
     2141     define variable v-change-sign          as integer   no-undo .
     2142     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2143     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2144     if p-change-value > 0
     2145     then do:
     2146       if frame Dialog-Frame :width + p-change-value >
     2147           session :width-chars
     2148       then do:
     2149         assign
     2150           p-change-value = session :width-chars - frame Dialog-Frame :width
     2151         .
     2152         if p-change-value <= 0
     2153         then do:
     2154           run diasize_position-resize-button in this-procedure .
     2155           return .
     2156         end.
     2157       end.
     2158     end.
     2159     if p-change-value < 0
     2160     then do:
     2161       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     2162       then do:
     2163         assign
     2164           p-change-value = v-diasize-orig-frame-width
     2165                          - frame Dialog-Frame :width
     2166         .
     2167         if p-change-value >= 0
     2168         then do:
     2169           run diasize_position-resize-button in this-procedure .
     2170           return .
     2171         end.
     2172       end.
     2173     end.
     2174     if p-change-value >= 0
     2175     then do:
     2176       assign
     2177         v-change-sign = 1
     2178       .
     2179     end.
     2180     else do:
     2181       assign
     2182         v-change-sign = -1
     2183       .
     2184     end.
     2185     assign
     2186       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2187     .
     2188     if p-change-value = 0
     2189     then do:
     2190       run diasize_position-resize-button in this-procedure .
     2191       return .
     2192     end.
     2193     move_block:
     2194     do
     2195     on error undo move_block, leave move_block
     2196     :
     2197       if retry
     2198       then do:
     2199         do
     2200         on error undo move_block, leave move_block
     2201         :
     2202           if p-change-value > 0
     2203           then do:
     2204             for each buf_temp-diasize-handle
     2205             on error undo, next
     2206             :
     2207               assign
     2208                 v-object-handle = buf_temp-diasize-handle.handle-value
     2209               .
     2210               if v-object-handle <> v-diasize-resize-button
     2211               then do:
     2212                 assign
     2213                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2214                 .
     2215               end.
     2216             end.
     2217             assign
     2218               v-diasize-browse-handle :width = v-browse-width
     2219             .
     2220             for each buf_temp-browse-handle
     2221               where buf_temp-browse-handle.browse-type = 'width':u
     2222             on error undo, next
     2223             :
     2224               assign
     2225                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2226               .
     2227             end.
     2228             assign
     2229               frame Dialog-Frame :width = v-frame-width
     2230             .
     2231             if frame Dialog-Frame :scrollable = true
     2232             then do:
     2233               assign
     2234                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2235               .
     2236             end.
     2237             run diasize_position-resize-button in this-procedure .
     2238           end.
     2239           else do:
     2240             if frame Dialog-Frame :scrollable = true
     2241             then do:
     2242               assign
     2243                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2244               .
     2245             end.
     2246             assign
     2247               frame Dialog-Frame :width = v-frame-width
     2248             .
     2249             for each buf_temp-browse-handle
     2250               where buf_temp-browse-handle.browse-type = 'width':u
     2251             on error undo, next
     2252             :
     2253               assign
     2254                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2255               .
     2256             end.
     2257             assign
     2258               v-diasize-browse-handle :width = v-browse-width
     2259             .
     2260             for each buf_temp-diasize-handle
     2261             on error undo, next
     2262             :
     2263               assign
     2264                 v-object-handle = buf_temp-diasize-handle.handle-value
     2265               .
     2266               if v-object-handle <> v-diasize-resize-button
     2267               then do:
     2268                 assign
     2269                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2270                 .
     2271               end.
     2272             end.
     2273             run diasize_position-resize-button in this-procedure .
     2274           end.
     2275           assign
     2276             v-diasize-change-size = false
     2277           .
     2278           leave move_block .
     2279         end.
     2280       end.
     2281       assign
     2282         v-diasize-need-full-display = true
     2283       .
     2284       if v-diasize-change-size = false
     2285       then do:
     2286         assign
     2287           v-diasize-change-size = true
     2288         .
     2289       end.
     2290       else do:
     2291         return .
     2292       end.
     2293       assign
     2294         v-frame-width = frame Dialog-Frame :width
     2295         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     2296         v-browse-width = v-diasize-browse-handle :width
     2297       .
     2298       for each buf_temp-browse-handle
     2299         where buf_temp-browse-handle.browse-type = 'width':u
     2300       :
     2301         assign
     2302           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2303         .
     2304       end.
     2305       for each buf_temp-diasize-handle
     2306       :
     2307         delete buf_temp-diasize-handle .
     2308       end.
     2309       assign
     2310         v-field-group-handle = frame Dialog-Frame :first-child
     2311       .
     2312       do while valid-handle(v-field-group-handle)
     2313       :
     2314         assign
     2315           v-object-handle = v-field-group-handle :first-child
     2316         .
     2317         do while valid-handle(v-object-handle)
     2318         :
     2319           if  v-object-handle <> v-diasize-browse-handle :handle
     2320           and v-object-handle <> v-diasize-resize-button
     2321           and can-query(v-object-handle, "row")
     2322           and can-query(v-object-handle, "height")
     2323           and ( v-object-handle :col + v-object-handle :width
     2324                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2325               )
     2326           then do:
     2327             find first buf_temp-browse-handle
     2328               where buf_temp-browse-handle.browse-type   = 'width':u
     2329                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2330               no-error .
     2331             if available buf_temp-browse-handle
     2332             then do:
     2333             end.
     2334             else do:
     2335               create buf_temp-diasize-handle .
     2336               assign
     2337                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2338                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2339               .
     2340             end.
     2341           end.
     2342           assign
     2343             v-object-handle = v-object-handle :next-sibling
     2344           .
     2345         end.
     2346         assign
     2347           v-field-group-handle = v-field-group-handle :next-sibling
     2348         .
     2349       end.
     2350       do with frame Dialog-Frame
     2351       :
     2352         hide v-diasize-resize-button .
     2353         v-diasize-resize-button :row = 1.
     2354         v-diasize-resize-button :column = 1.
     2355       end.
     2356       if p-change-value > 0
     2357       then do:
     2358         if frame Dialog-Frame :scrollable = true
     2359         then do:
     2360           assign
     2361             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2362             no-error .
     2363           if error-status :error
     2364           or error-status :get-message(1) <> ""
     2365           then do:
     2366             undo move_block, retry move_block.
     2367           end.
     2368         end.
     2369         assign
     2370           frame Dialog-Frame :width = v-frame-width + p-change-value
     2371           no-error .
     2372         if error-status :error
     2373         or error-status :get-message(1) <> ""
     2374         then do:
     2375           undo move_block, retry move_block.
     2376         end.
     2377         assign
     2378           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2379         no-error .
     2380         if error-status :error
     2381         or error-status :get-message(1) <> ""
     2382         then do:
     2383           undo move_block, retry move_block.
     2384         end.
     2385         for each buf_temp-browse-handle
     2386           where buf_temp-browse-handle.browse-type = 'width':u
     2387         on error undo move_block, retry move_block
     2388         :
     2389           assign
     2390             buf_temp-browse-handle.browse-handle :width
     2391               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2392             no-error .
     2393           if error-status :error
     2394           or error-status :get-message(1) <> ""
     2395           then do:
     2396             undo move_block, retry move_block .
     2397           end.
     2398         end.
     2399         for each buf_temp-diasize-handle
     2400         on error undo move_block, retry move_block
     2401         :
     2402           assign
     2403             v-object-handle = buf_temp-diasize-handle.handle-value
     2404           .
     2405           if v-object-handle <> v-diasize-resize-button
     2406           then do:
     2407             assign
     2408               v-object-handle :col = v-object-handle :col + p-change-value
     2409               no-error .
     2410             if error-status :error
     2411             or error-status :get-message(1) <> ""
     2412             then do:
     2413               undo move_block, retry move_block .
     2414             end.
     2415           end.
     2416         end.
     2417       end.
     2418       else do:
     2419         for each buf_temp-diasize-handle
     2420         on error undo move_block, retry move_block
     2421         :
     2422           assign
     2423             v-object-handle = buf_temp-diasize-handle.handle-value
     2424           .
     2425           if v-object-handle <> v-diasize-resize-button
     2426           then do:
     2427             assign
     2428               v-object-handle :col = v-object-handle :col + p-change-value
     2429               no-error .
     2430             if error-status :error
     2431             or error-status :get-message(1) <> ""
     2432             then do:
     2433               undo move_block, retry move_block .
     2434             end.
     2435           end.
     2436         end.
     2437         for each buf_temp-browse-handle
     2438           where buf_temp-browse-handle.browse-type = 'width':u
     2439         on error undo move_block, retry move_block
     2440         :
     2441           assign
     2442             buf_temp-browse-handle.browse-handle :width
     2443               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2444             no-error .
     2445           if error-status :error
     2446           or error-status :get-message(1) <> ""
     2447           then do:
     2448             undo move_block, retry move_block .
     2449           end.
     2450         end.
     2451         assign
     2452           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2453           no-error .
     2454         if error-status :error
     2455         or error-status :get-message(1) <> ""
     2456         then do:
     2457           undo move_block, retry move_block.
     2458         end.
     2459         assign
     2460           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2461         no-error .
     2462         if error-status :error
     2463         or error-status :get-message(1) <> ""
     2464         then do:
     2465           undo move_block, retry move_block.
     2466         end.
     2467         if frame Dialog-Frame :scrollable = true
     2468         then do:
     2469           assign
     2470             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2471           no-error .
     2472           if error-status :error
     2473           or error-status :get-message(1) <> ""
     2474           then do:
     2475             undo move_block, retry move_block.
     2476           end.
     2477         end.
     2478       end.
     2479       if p-move-resize
     2480       then do:
     2481         run diasize_position-resize-button in this-procedure .
     2482       end.
     2483       if v-diasize-wndstore = true
     2484       then do:
     2485         if connected("ub") = true
     2486         then do:
     2487           define variable v-cntxt-db-num        as integer   no-undo .
     2488           define variable v-cntxt-userid        as character no-undo .
     2489           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2490                                             , OUTPUT v-cntxt-userid
     2491                                             ) .
     2492           run gbl/wndsizew.p
     2493             (input  v-cntxt-db-num
     2494             ,input  v-cntxt-userid
     2495             ,input  v-diasize-proc-name
     2496             ,input  'width':u
     2497             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2498             ) .
     2499         end.
     2500       end.
     2501     end.
     2502     assign
     2503       v-diasize-change-size = false
     2504     .
     2505   end procedure.
     2506   procedure diasize_set-width :
     2507     define input  parameter p-new-width  as decimal   no-undo .
     2508     define input  parameter p-move-resize as logical   no-undo .
     2509     do
     2510     on error undo, return error return-value
     2511     :
     2512       run diasize_change-width in this-procedure
     2513         (input  (p-new-width - frame Dialog-Frame :width)
     2514         ,input  p-move-resize
     2515         ) .
     2516     end.
     2517   end procedure.
     2518   procedure diasize_position-resize-button :
     2519     do with frame Dialog-Frame
     2520     :
     2521       hide v-diasize-resize-button .
     2522       assign
     2523         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2524                     - 1
     2525                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2526         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2527                     - 1
     2528                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2529       .
     2530       view v-diasize-resize-button .
     2531     end.
     2532   end procedure.
     2533   on alt-right anywhere
     2534   do:
     2535     run diasize_change-width in this-procedure
     2536       (input 1
     2537       ,input true
     2538       ) .
     2539     return no-apply .
     2540   end.
     2541   on alt-left anywhere
     2542   do:
     2543     run diasize_change-width in this-procedure
     2544       (input -1
     2545       ,input true
     2546       ) .
     2547     return no-apply .
     2548   end.
     2549   on alt-down anywhere
     2550   do:
     2551     run diasize_change-height in this-procedure
     2552       (input 1
     2553       ,input true
     2554       ) .
     2555     return no-apply .
     2556   end.
     2557   on alt-up anywhere
     2558   do:
     2559     run diasize_change-height in this-procedure
     2560       (input -1
     2561       ,input true
     2562       ) .
     2563     return no-apply .
     2564   end.
     2565   on alt-enter of frame Dialog-Frame
     2566   do:
     2567     run diasize_maximize in this-procedure
     2568       (input  ?
     2569       ).
     2570     return no-apply .
     2571   end.
     2572   procedure diasize_end-move :
     2573     do
     2574     on error undo, return error return-value
     2575     :
     2576       define variable v-row-delta as decimal   no-undo .
     2577       define variable v-col-delta as decimal   no-undo .
     2578       define variable v-new-row as decimal   no-undo .
     2579       define variable v-new-col as decimal   no-undo .
     2580       assign
     2581         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2582         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2583       .
     2584       assign
     2585         v-row-delta = v-new-row - frame Dialog-Frame :height
     2586         v-col-delta = v-new-col - frame Dialog-Frame :width
     2587       .
     2588       run diasize_change-height in this-procedure
     2589         (input v-row-delta
     2590         ,input true
     2591         ) .
     2592       run diasize_change-width in this-procedure
     2593         (input v-col-delta
     2594         ,input true
     2595         ) .
     2596     end.
     2597   end procedure.
     2598   procedure diasize_maximize :
     2599     define input  parameter p-action as logical   no-undo .
     2600     do
     2601     on error undo, return error return-value
     2602     :
     2603       if p-action = ?
     2604       then do:
     2605         if v-diasize-need-maximize = true
     2606         then do:
     2607           assign
     2608             p-action = true
     2609           .
     2610         end.
     2611         else do:
     2612           assign
     2613             p-action = false
     2614           .
     2615         end.
     2616       end.
     2617       if p-action = true
     2618       then do:
     2619         run diasize_change-height in this-procedure
     2620           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2621               - frame Dialog-Frame :height-chars
     2622           ,input true
     2623           ) .
     2624         run diasize_change-width in this-procedure
     2625           (input session :width-chars
     2626               - frame Dialog-Frame :width-chars
     2627           ,input true
     2628           ) .
     2629         assign
     2630           v-diasize-need-maximize = false
     2631         .
     2632       end.
     2633       else do:
     2634         run diasize_change-width in this-procedure
     2635           (input v-diasize-orig-frame-width
     2636               - frame Dialog-Frame :width-chars
     2637           ,input true
     2638           ) .
     2639         run diasize_change-height in this-procedure
     2640           (input v-diasize-orig-frame-height
     2641               - frame Dialog-Frame :height-chars
     2642           ,input true
     2643           ) .
     2644         assign
     2645           v-diasize-need-maximize = true
     2646         .
     2647       end.
     2648     end.
     2649   end procedure.
     2650   procedure diasize_restore-orig-size :
     2651     do
     2652     on error undo, return error return-value
     2653     :
     2654       assign
     2655         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2656         v-diasize-current-frame-height = frame Dialog-Frame :height
     2657       .
     2658       run diasize_set-height in this-procedure
     2659         (input  v-diasize-orig-frame-height
     2660         ,input  true
     2661         ) .
     2662       run diasize_set-width in this-procedure
     2663         (input  v-diasize-orig-frame-width
     2664         ,input  true
     2665         ) .
     2666     end.
     2667   end procedure.
     2668   procedure diasize_restore-current-size :
     2669     do
     2670     on error undo, return error return-value
     2671     :
     2672       run diasize_set-height in this-procedure
     2673         (input  v-diasize-current-frame-height
     2674         ,input  true
     2675         ) .
     2676       run diasize_set-width in this-procedure
     2677         (input  v-diasize-current-frame-width
     2678         ,input  true
     2679         ) .
     2680     end.
     2681   end procedure.
     2682   procedure diasize_set-browse-handle :
     2683     define input  parameter p-browse-handle as handle   no-undo .
     2684     define buffer buf_temp-browse-handle for temp-browse-handle .
     2685     do
     2686     on error undo, return error return-value
     2687     :
     2688       assign
     2689         v-diasize-browse-handle = p-browse-handle
     2690       .
     2691       for each buf_temp-browse-handle
     2692       on error undo, return error return-value
     2693       :
     2694         delete buf_temp-browse-handle .
     2695       end.
     2696     end.
     2697   end procedure.
     2698   procedure diasize_add_browse :
     2699     define input  parameter p-browse-type   as character no-undo .
     2700     define input  parameter p-browse-handle as handle    no-undo .
     2701     define buffer buf_temp-browse-handle for temp-browse-handle .
     2702     do
     2703     on error undo, return error return-value
     2704     :
     2705       assign
     2706         v-diasize-browse-number = v-diasize-browse-number + 1
     2707       .
     2708       create buf_temp-browse-handle .
     2709       assign
     2710         buf_temp-browse-handle.browse-type   = p-browse-type
     2711         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2712         buf_temp-browse-handle.browse-handle = p-browse-handle
     2713       .
     2714     end.
     2715   end procedure.
     2716   procedure diasize_init :
     2717     define variable v-default-value    as logical   no-undo .
     2718     define variable v-restore-saved    as logical   no-undo .
     2719     define variable v-resize-value-str as character no-undo .
     2720     do
     2721     on error undo, return error return-value
     2722     :
     2723       do with frame Dialog-Frame
     2724       :
     2725         assign
     2726           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2727           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2728           v-diasize-browse-handle     = browse br-pmp-hist :handle
     2729         .
     2730         create button v-diasize-resize-button
     2731         assign
     2732           parent        = frame Dialog-Frame :first-child
     2733           label         = "s"
     2734           height-pixels = 16
     2735           width-pixels  = 16
     2736           visible       = true
     2737           sensitive     = true
     2738           movable       = true
     2739           triggers:
     2740             on end-move persistent run diasize_end-move in this-procedure .
     2741           end triggers.
     2742         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2743         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2744         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2745         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2746         assign
     2747           v-diasize-wndmax = false
     2748         .
     2749         if connected("ub") = true
     2750         then do:
     2751           define variable v-cntxt-db-num        as integer   no-undo .
     2752           define variable v-cntxt-userid        as character no-undo .
     2753           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2754                                             , OUTPUT v-cntxt-userid
     2755                                             ) .
     2756           run gbl/wndpar_r.p
     2757             (input  v-cntxt-db-num
     2758             ,input  v-cntxt-userid
     2759             ,input  'wndmax':U
     2760             ,output v-diasize-wndmax
     2761             ,output v-default-value
     2762             ) .
     2763         end.
     2764         assign
     2765           v-diasize-wndstore = false
     2766         .
     2767         if connected("ub") = true
     2768         then do:
     2769           run gbl/wndpar_r.p
     2770             (input  v-cntxt-db-num
     2771             ,input  v-cntxt-userid
     2772             ,input  'wndstore':U
     2773             ,output v-diasize-wndstore
     2774             ,output v-default-value
     2775             ) .
     2776         end.
     2777         assign
     2778           v-diasize-proc-name = entry(1, program-name(2), '.')
     2779         .
     2780         if v-diasize-wndstore = true
     2781         then do:
     2782           assign
     2783             v-restore-saved = false
     2784           .
     2785           if connected("ub") = true
     2786           then do:
     2787             run gbl/wndsizer.p
     2788               (input  v-cntxt-db-num
     2789               ,input  v-cntxt-userid
     2790               ,input  v-diasize-proc-name
     2791               ,input  'height':u
     2792               ,output v-resize-value-str
     2793               ) .
     2794             if v-resize-value-str <> '':U
     2795             then do:
     2796               run diasize_change-height in this-procedure
     2797                 (input  integer(v-resize-value-str)
     2798                 ,input  true
     2799                 ) .
     2800               assign
     2801                 v-restore-saved = true
     2802               .
     2803             end.
     2804           end.
     2805           if connected("ub") = true
     2806           then do:
     2807             run gbl/wndsizer.p
     2808               (input  v-cntxt-db-num
     2809               ,input  v-cntxt-userid
     2810               ,input  v-diasize-proc-name
     2811               ,input  'width':u
     2812               ,output v-resize-value-str
     2813               ) .
     2814             if v-resize-value-str <> '':U
     2815             then do:
     2816               run diasize_change-width in this-procedure
     2817                 (input  integer(v-resize-value-str)
     2818                 ,input  true
     2819                 ) .
     2820               assign
     2821                 v-restore-saved = true
     2822               .
     2823             end.
     2824           end.
     2825           if v-restore-saved <> true
     2826           then do:
     2827             if v-diasize-wndmax = true
     2828             then do:
     2829               run diasize_maximize in this-procedure
     2830                 (input  true
     2831                 ) .
     2832             end.
     2833           end.
     2834         end.
     2835         else do:
     2836           if v-diasize-wndmax = true
     2837           then do:
     2838             run diasize_maximize in this-procedure
     2839               (input  true
     2840               ) .
     2841           end.
     2842         end.
     2843       end.
     2844     end.
     2845   end procedure.
     2846   procedure diasize_need-full-display :
     2847     define output parameter p-need-full-display as logical   no-undo .
     2848     do
     2849     on error undo, return error return-value
     2850     :
     2851       assign
     2852         p-need-full-display = v-diasize-need-full-display
     2853       .
     2854       assign
     2855         v-diasize-need-full-display = false
     2856       .
     2857     end.
     2858   end procedure.
     2859   procedure get-context :
     2860      define output parameter p-db-num as integer          no-undo.
     2861      define output parameter p-user-id as character        no-undo.
     2862      define variable v-login               as character    no-undo.
     2863      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2864      define buffer buf_user-login  for ub.user-login .
     2865      do
     2866      on error undo, return error
     2867      :
     2868            FIND FIRST buf_sys-ctrl no-lock.
     2869            ASSIGN
     2870               v-login = USERID("ub")
     2871               p-db-num = buf_sys-ctrl.db-num
     2872            .
     2873            FIND FIRST buf_user-login
     2874                 WHERE buf_user-login.db-num = p-db-num
     2875                   AND buf_user-login.user-login = v-login
     2876                 no-lock
     2877                 no-error
     2878                 .
     2879            IF AVAILABLE buf_user-login
     2880            THEN DO:
     2881               assign
     2882                  p-user-id = buf_user-login.user-id
     2883               .
     2884            END.
     2885      end.
     2886   end procedure.
