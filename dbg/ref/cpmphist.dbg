     3487   define variable l-open-query as logical   no-undo .
     3488   CASE p-mode :
     3489     WHEN 'все':U        THEN DO:
     3490       assign
     3491       filter-point = filter-point0 + p-mode
     3492       filter-label = substitute("&1", filter-label0)
     3493       .
     3494   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3495   define variable  l-disable-where-27  as logical   no-undo .
     3496   define variable  l-filter-open-27    as logical   .
     3497   define variable  flt-rec-27       as recid     no-undo .
     3498   define variable  filter-name-27      as character no-undo .
