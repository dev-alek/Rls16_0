     3517         (INPUT filter-name-27
     3518         ) no-error .
     3519     assign
     3520       l-filter-open-27 = false
     3521     .
     3522     if flt-rec-27 <> ?
     3523       or sort-column-phrase > ""
     3524     then do:
     3525       define variable  parameter-2-27 as character no-undo .
     3526       define variable  parameter-3-27 as character no-undo .
     3527       define variable  parameter-4-27 as character no-undo .
     3528       define variable  parameter-5-27 as character no-undo .
     3529       define variable  parameter-6-27 as character no-undo .
     3530       define variable  parameter-7-27 as character no-undo .
     3531         assign
     3532         parameter-3-27 =
     3533                                 "FOR EACH X_c-pmp-hist"
     3534         parameter-4-27 =
     3535           (
     3536             if (" TRUE " + " " + where-phrase-27) <> ""
     3537             then " TRUE " + " " + where-phrase-27
     3538             else "true"
     3539           )
     3540         parameter-5-27 = (" " + "" + " " + "")
     3541         parameter-6-27 = if sort-phrase-27 = ''
     3542                              then
     3543           (
     3544           " " + " use-index idate  " +
     3545             " " + sort-column-phrase +
     3546           " " + "  "
     3547           )
     3548                              else
     3549           (
     3550           " " + " use-index idate  " +
     3551             " " + sort-column-phrase +
     3552           " " + sort-phrase-27
     3553           )
     3554         parameter-7-27 =
     3555           " indexed-reposition  "
     3556       .
     3557       do
