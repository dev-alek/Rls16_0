     3660                             input this-procedure:handle
     3661                             ,input query br-pmp-hist:handle
     3662                             ,input logical(parameter-2-27)
     3663                             ,input no-lock
     3664                             ,input parameter-3-27
     3665                             ,input parameter-4-27
     3666                             ,input parameter-5-27
     3667                             ,input parameter-6-27
     3668                             ,input parameter-7-27
     3669                             ,output v-fltopend-rowid
     3670                             ) no-error.
     3671         .
     3672         v-doc-rec = ?.
     3673       end.
     3674       assign
     3675         l-query-was-opened = true
     3676       .
     3677     end.
     3678   end.
     3679     run waitfram-hide in this-procedure .
     3680     END.
