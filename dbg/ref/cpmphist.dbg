     3326     REPOSITION br-pmp-hist to recid integer(entry(1, v-rid-list)) No-ERROR.
     3327   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3328   DEF VAR cur-clmn-numbr-pmp-hist as INT EXTENT 9 no-undo.
     3329   DEF VAR varmvibr-pmp-hist       as INT no-undo.
     3330   DEF VAR varmvjbr-pmp-hist       as INT no-undo.
     3331   DEF VAR varmvkbr-pmp-hist       as INT no-undo.
     3332   DEF VAR varmvlbr-pmp-hist       as INT no-undo.
     3333   DEF VAR move-elementbr-pmp-hist as INT no-undo.
     3334   def var jjbr-pmp-hist           as int no-undo.
     3335   do varmvibr-pmp-hist = 1 to EXTENT(cur-clmn-numbr-pmp-hist):
     3336     ASSIGN cur-clmn-numbr-pmp-hist[varmvibr-pmp-hist] = varmvibr-pmp-hist.
     3337   END.
     3338   RUN start-mv-clmnbr-pmp-hist.
     3339   PROCEDURE start-mv-clmnbr-pmp-hist:
     3340   def var old-session as logical no-undo.
     3341      old-session = SESSION:IMMEDIATE-DISPLAY.
     3342      IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     3343          IF  p-mode = 'все':U  THEN DO:
     3344      DO jjbr-pmp-hist = NUM-ENTRIES('9,1,2,3,4,5,6,7,8') TO 1 BY -1:
     3345        RUN re-move-clmnbr-pmp-hist ( cur-clmn-numbr-pmp-hist[INTEGER(ENTRY (jjbr-pmp-hist, '9,1,2,3,4,5,6,7,8'))] , 1).
     3346      END.
     3347          END.
     3348          IF  p-mode <> 'все':U  THEN DO:
     3349      DO jjbr-pmp-hist = NUM-ENTRIES('1,2,3,4,5,6,7,8,9') TO 1 BY -1:
     3350        RUN re-move-clmnbr-pmp-hist ( cur-clmn-numbr-pmp-hist[INTEGER(ENTRY (jjbr-pmp-hist, '1,2,3,4,5,6,7,8,9'))] , 1).
     3351      END.
     3352          END.
     3353      SESSION:IMMEDIATE-DISPLAY = old-session.
     3354   END.
     3355   ON ctrl-cursor-right OF BROWSE br-pmp-hist do:
     3356     RUN re-move-clmnbr-pmp-hist ( 1, 9).
     3357   END.
     3358   ON ctrl-cursor-left OF BROWSE br-pmp-hist do:
     3359     RUN re-move-clmnbr-pmp-hist (9, 1).
     3360   END.
     3361   PROCEDURE re-move-clmnbr-pmp-hist:
     3362     DEFINE INPUT PARAMETER source-column as INTEGER NO-UNDO.
     3363     DEFINE INPUT PARAMETER target-column as INTEGER NO-UNDO.
     3364     DO varmvibr-pmp-hist = 1 TO EXTENT(cur-clmn-numbr-pmp-hist):
     3365       if cur-clmn-numbr-pmp-hist[varmvibr-pmp-hist] = source-column THEN cur-clmn-numbr-pmp-hist[varmvibr-pmp-hist] = -1.
     3366     END.
     3367     if br-pmp-hist:MOVE-COLUMN(source-column, target-column) IN FRAME Dialog-Frame then.
     3368     if source-column > target-column THEN
     3369     DO varmvjbr-pmp-hist = source-column - 1 to target-column BY -1:
     3370       DO varmvibr-pmp-hist = 1 TO EXTENT(cur-clmn-numbr-pmp-hist):
     3371           if cur-clmn-numbr-pmp-hist[varmvibr-pmp-hist] = varmvjbr-pmp-hist THEN DO:
     3372             cur-clmn-numbr-pmp-hist[varmvibr-pmp-hist] = cur-clmn-numbr-pmp-hist[varmvibr-pmp-hist] + 1.
     3373           END.
     3374       END.
     3375     END.
     3376     ELSE
     3377     DO varmvjbr-pmp-hist = source-column + 1 to target-column:
     3378       DO varmvibr-pmp-hist = 1 TO EXTENT(cur-clmn-numbr-pmp-hist):
     3379         if cur-clmn-numbr-pmp-hist[varmvibr-pmp-hist] = varmvjbr-pmp-hist THEN DO:
     3380           cur-clmn-numbr-pmp-hist[varmvibr-pmp-hist] = cur-clmn-numbr-pmp-hist[varmvibr-pmp-hist] - 1.
     3381         END.
     3382       END.
     3383     END.
     3384     DO varmvibr-pmp-hist = 1 TO EXTENT(cur-clmn-numbr-pmp-hist):
     3385       if cur-clmn-numbr-pmp-hist[varmvibr-pmp-hist] = -1 THEN cur-clmn-numbr-pmp-hist[varmvibr-pmp-hist] = target-column.
     3386     END.
     3387   END PROCEDURE.
     3388   PROCEDURE ch-clmnbr-pmp-hist:
     3389     DEFINE INPUT PARAMETER cur-clmn-loc as INTEGER NO-UNDO.
     3390     if cur-clmn-loc <= 1 then do:
     3391       return .
     3392     end.
     3393     DO varmvibr-pmp-hist = 1 TO EXTENT(cur-clmn-numbr-pmp-hist):
     3394       if cur-clmn-numbr-pmp-hist[varmvibr-pmp-hist] = cur-clmn-loc THEN move-elementbr-pmp-hist = varmvibr-pmp-hist.
     3395     END.
     3396     RUN re-move-clmnbr-pmp-hist (cur-clmn-loc, 1).
     3397   END PROCEDURE.
     3398   PROCEDURE mv-brw-defaultbr-pmp-hist:
     3399   def var old-session as logical no-undo.
     3400     old-session = SESSION:IMMEDIATE-DISPLAY.
     3401     IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     3402     do varmvlbr-pmp-hist = 1 to EXTENT(cur-clmn-numbr-pmp-hist):
     3403       RUN re-move-clmnbr-pmp-hist (cur-clmn-numbr-pmp-hist[varmvlbr-pmp-hist], varmvlbr-pmp-hist).
     3404     END.
     3405     RUN start-mv-clmnbr-pmp-hist.
     3406     SESSION:IMMEDIATE-DISPLAY = old-session.
     3407   END PROCEDURE.
     3408   .
     3409     run diasize_add_browse in this-procedure
     3410       (input  'width':u
     3411       ,input  browse br-changes :handle
     3412       ) .
     3413     run diasize_init in this-procedure .
     3414     WAIT-FOR GO OF FRAME Dialog-Frame.
     3415   END.
     3416   RUN disable_UI.
     3417   PROCEDURE disable_UI :
     3418     HIDE FRAME Dialog-Frame.
     3419   END PROCEDURE.
     3420   PROCEDURE enable_UI :
     3421     DISPLAY sch-corr-date sch-pump-code sch-corr-user-name mark-num
     3422         WITH FRAME Dialog-Frame.
     3423     ENABLE b-quit B-mark b-sel B-print B-sch B-Help B-lookup br-pmp-hist
     3424            sch-corr-date sch-pump-code sch-corr-user-name BR-changes mark-num
     3425         WITH FRAME Dialog-Frame.
