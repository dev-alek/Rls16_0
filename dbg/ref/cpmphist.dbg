      621   procedure fltfield-clear :
      622     define output parameter loc-fld as character no-undo.
      623     define output parameter loc-lab as character no-undo .
      624     define output parameter loc-spr as character no-undo .
      625     define output parameter loc-dim as character no-undo .
      626     assign
      627       loc-fld = ""
      628       loc-lab = ""
      629       loc-spr = ""
      630       loc-dim = "0"
      631     .
      632   end procedure .
      633   procedure fltfield-add :
      634     define input        parameter par-fld as character no-undo.
      635     define input        parameter par-lab as character no-undo .
      636     define input        parameter par-spr as character no-undo .
      637     define input-output parameter loc-fld as character no-undo.
      638     define input-output parameter loc-lab as character no-undo .
      639     define input-output parameter loc-spr as character no-undo .
      640     define input-output parameter loc-dim as character no-undo .
      641     do
      642     on error undo, return error
      643     :
      644       assign
      645       loc-fld = if loc-dim = '0'
      646                 then par-fld
      647                 else (loc-fld + chr(44) + par-fld)
      648       loc-lab = if loc-dim = '0'
      649                 then par-lab
      650                 else (loc-lab + chr(44) + par-lab)
      651       loc-spr = if loc-dim = '0'
      652                 then par-spr
      653                 else (loc-spr + chr(44) + par-spr)
      654       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
      655                 string(integer(if num-entries(loc-dim) > 1
      656                               then entry(2, loc-dim)
      657                               else entry(1, loc-dim)
      658                               ) + 1)
      659       no-error
      660       .
      661     end.
      662   end procedure.
