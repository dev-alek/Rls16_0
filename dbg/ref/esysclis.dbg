     2603         for each buf_temp-diasize-handle
     2604         on error undo move_block, retry move_block
     2605         :
     2606           assign
     2607             v-object-handle = buf_temp-diasize-handle.handle-value
     2608           .
     2609           if v-object-handle <> v-diasize-resize-button
     2610           then do:
     2611             assign
     2612               v-object-handle :col = v-object-handle :col + p-change-value
     2613               no-error .
     2614             if error-status :error
     2615             or error-status :get-message(1) <> ""
     2616             then do:
     2617               undo move_block, retry move_block .
     2618             end.
     2619           end.
     2620         end.
     2621         for each buf_temp-browse-handle
     2622           where buf_temp-browse-handle.browse-type = 'width':u
     2623         on error undo move_block, retry move_block
     2624         :
     2625           assign
     2626             buf_temp-browse-handle.browse-handle :width
     2627               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2628             no-error .
     2629           if error-status :error
     2630           or error-status :get-message(1) <> ""
     2631           then do:
     2632             undo move_block, retry move_block .
     2633           end.
     2634         end.
     2635         assign
     2636           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2637           no-error .
     2638         if error-status :error
     2639         or error-status :get-message(1) <> ""
     2640         then do:
     2641           undo move_block, retry move_block.
     2642         end.
     2643         assign
     2644           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2645         no-error .
     2646         if error-status :error
     2647         or error-status :get-message(1) <> ""
     2648         then do:
     2649           undo move_block, retry move_block.
     2650         end.
     2651         if frame Dialog-Frame :scrollable = true
     2652         then do:
     2653           assign
     2654             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2655           no-error .
     2656           if error-status :error
     2657           or error-status :get-message(1) <> ""
     2658           then do:
     2659             undo move_block, retry move_block.
     2660           end.
     2661         end.
     2662       end.
     2663       if p-move-resize
     2664       then do:
     2665         run diasize_position-resize-button in this-procedure .
     2666       end.
     2667       if v-diasize-wndstore = true
     2668       then do:
     2669         if connected("ub") = true
     2670         then do:
     2671           define variable v-cntxt-db-num        as integer   no-undo .
     2672           define variable v-cntxt-userid        as character no-undo .
     2673           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2674                                             , OUTPUT v-cntxt-userid
     2675                                             ) .
     2676           run gbl/wndsizew.p
     2677             (input  v-cntxt-db-num
     2678             ,input  v-cntxt-userid
     2679             ,input  v-diasize-proc-name
     2680             ,input  'width':u
     2681             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2682             ) .
     2683         end.
     2684       end.
     2685     end.
     2686     assign
     2687       v-diasize-change-size = false
     2688     .
     2689   end procedure.
     2690   procedure diasize_set-width :
     2691     define input  parameter p-new-width  as decimal   no-undo .
     2692     define input  parameter p-move-resize as logical   no-undo .
     2693     do
     2694     on error undo, return error return-value
     2695     :
     2696       run diasize_change-width in this-procedure
     2697         (input  (p-new-width - frame Dialog-Frame :width)
     2698         ,input  p-move-resize
     2699         ) .
     2700     end.
     2701   end procedure.
     2702   procedure diasize_position-resize-button :
     2703     do with frame Dialog-Frame
     2704     :
     2705       hide v-diasize-resize-button .
     2706       assign
     2707         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2708                     - 1
     2709                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2710         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2711                     - 1
     2712                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2713       .
     2714       view v-diasize-resize-button .
     2715     end.
     2716   end procedure.
     2717   on alt-right anywhere
     2718   do:
     2719     run diasize_change-width in this-procedure
     2720       (input 1
     2721       ,input true
     2722       ) .
     2723     return no-apply .
     2724   end.
     2725   on alt-left anywhere
     2726   do:
     2727     run diasize_change-width in this-procedure
     2728       (input -1
     2729       ,input true
     2730       ) .
     2731     return no-apply .
     2732   end.
     2733   on alt-down anywhere
     2734   do:
     2735     run diasize_change-height in this-procedure
     2736       (input 1
     2737       ,input true
     2738       ) .
     2739     return no-apply .
     2740   end.
     2741   on alt-up anywhere
     2742   do:
     2743     run diasize_change-height in this-procedure
     2744       (input -1
     2745       ,input true
     2746       ) .
     2747     return no-apply .
     2748   end.
     2749   on alt-enter of frame Dialog-Frame
     2750   do:
     2751     run diasize_maximize in this-procedure
     2752       (input  ?
     2753       ).
     2754     return no-apply .
     2755   end.
     2756   procedure diasize_end-move :
     2757     do
     2758     on error undo, return error return-value
     2759     :
     2760       define variable v-row-delta as decimal   no-undo .
     2761       define variable v-col-delta as decimal   no-undo .
     2762       define variable v-new-row as decimal   no-undo .
     2763       define variable v-new-col as decimal   no-undo .
     2764       assign
     2765         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2766         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2767       .
     2768       assign
     2769         v-row-delta = v-new-row - frame Dialog-Frame :height
     2770         v-col-delta = v-new-col - frame Dialog-Frame :width
     2771       .
     2772       run diasize_change-height in this-procedure
     2773         (input v-row-delta
     2774         ,input true
     2775         ) .
     2776       run diasize_change-width in this-procedure
     2777         (input v-col-delta
     2778         ,input true
     2779         ) .
     2780     end.
     2781   end procedure.
     2782   procedure diasize_maximize :
     2783     define input  parameter p-action as logical   no-undo .
     2784     do
     2785     on error undo, return error return-value
     2786     :
     2787       if p-action = ?
     2788       then do:
     2789         if v-diasize-need-maximize = true
     2790         then do:
     2791           assign
     2792             p-action = true
     2793           .
     2794         end.
     2795         else do:
     2796           assign
     2797             p-action = false
     2798           .
     2799         end.
     2800       end.
     2801       if p-action = true
     2802       then do:
     2803         run diasize_change-height in this-procedure
     2804           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2805               - frame Dialog-Frame :height-chars
     2806           ,input true
     2807           ) .
     2808         run diasize_change-width in this-procedure
     2809           (input session :width-chars
     2810               - frame Dialog-Frame :width-chars
     2811           ,input true
     2812           ) .
     2813         assign
     2814           v-diasize-need-maximize = false
     2815         .
     2816       end.
     2817       else do:
     2818         run diasize_change-width in this-procedure
     2819           (input v-diasize-orig-frame-width
     2820               - frame Dialog-Frame :width-chars
     2821           ,input true
     2822           ) .
     2823         run diasize_change-height in this-procedure
     2824           (input v-diasize-orig-frame-height
     2825               - frame Dialog-Frame :height-chars
     2826           ,input true
     2827           ) .
     2828         assign
     2829           v-diasize-need-maximize = true
     2830         .
     2831       end.
     2832     end.
     2833   end procedure.
     2834   procedure diasize_restore-orig-size :
     2835     do
     2836     on error undo, return error return-value
     2837     :
     2838       assign
     2839         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2840         v-diasize-current-frame-height = frame Dialog-Frame :height
     2841       .
     2842       run diasize_set-height in this-procedure
     2843         (input  v-diasize-orig-frame-height
     2844         ,input  true
     2845         ) .
     2846       run diasize_set-width in this-procedure
     2847         (input  v-diasize-orig-frame-width
     2848         ,input  true
     2849         ) .
     2850     end.
     2851   end procedure.
     2852   procedure diasize_restore-current-size :
     2853     do
     2854     on error undo, return error return-value
     2855     :
     2856       run diasize_set-height in this-procedure
     2857         (input  v-diasize-current-frame-height
     2858         ,input  true
     2859         ) .
     2860       run diasize_set-width in this-procedure
     2861         (input  v-diasize-current-frame-width
     2862         ,input  true
     2863         ) .
     2864     end.
     2865   end procedure.
     2866   procedure diasize_set-browse-handle :
     2867     define input  parameter p-browse-handle as handle   no-undo .
     2868     define buffer buf_temp-browse-handle for temp-browse-handle .
     2869     do
     2870     on error undo, return error return-value
     2871     :
     2872       assign
     2873         v-diasize-browse-handle = p-browse-handle
     2874       .
     2875       for each buf_temp-browse-handle
     2876       on error undo, return error return-value
     2877       :
     2878         delete buf_temp-browse-handle .
     2879       end.
     2880     end.
     2881   end procedure.
     2882   procedure diasize_add_browse :
     2883     define input  parameter p-browse-type   as character no-undo .
     2884     define input  parameter p-browse-handle as handle    no-undo .
     2885     define buffer buf_temp-browse-handle for temp-browse-handle .
     2886     do
     2887     on error undo, return error return-value
     2888     :
     2889       assign
     2890         v-diasize-browse-number = v-diasize-browse-number + 1
     2891       .
     2892       create buf_temp-browse-handle .
     2893       assign
     2894         buf_temp-browse-handle.browse-type   = p-browse-type
     2895         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2896         buf_temp-browse-handle.browse-handle = p-browse-handle
     2897       .
     2898     end.
     2899   end procedure.
     2900   procedure diasize_init :
     2901     define variable v-default-value    as logical   no-undo .
     2902     define variable v-restore-saved    as logical   no-undo .
     2903     define variable v-resize-value-str as character no-undo .
     2904     do
     2905     on error undo, return error return-value
     2906     :
     2907       do with frame Dialog-Frame
     2908       :
     2909         assign
     2910           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2911           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2912           v-diasize-browse-handle     = browse br-esys-cli :handle
     2913         .
     2914         create button v-diasize-resize-button
     2915         assign
     2916           parent        = frame Dialog-Frame :first-child
     2917           label         = "s"
     2918           height-pixels = 16
     2919           width-pixels  = 16
     2920           visible       = true
     2921           sensitive     = true
     2922           movable       = true
     2923           triggers:
     2924             on end-move persistent run diasize_end-move in this-procedure .
     2925           end triggers.
     2926         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2927         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2928         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2929         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2930         assign
     2931           v-diasize-wndmax = false
     2932         .
     2933         if connected("ub") = true
     2934         then do:
     2935           define variable v-cntxt-db-num        as integer   no-undo .
     2936           define variable v-cntxt-userid        as character no-undo .
     2937           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2938                                             , OUTPUT v-cntxt-userid
     2939                                             ) .
     2940           run gbl/wndpar_r.p
     2941             (input  v-cntxt-db-num
     2942             ,input  v-cntxt-userid
     2943             ,input  'wndmax':U
     2944             ,output v-diasize-wndmax
     2945             ,output v-default-value
     2946             ) .
     2947         end.
     2948         assign
     2949           v-diasize-wndstore = false
     2950         .
     2951         if connected("ub") = true
     2952         then do:
     2953           run gbl/wndpar_r.p
     2954             (input  v-cntxt-db-num
     2955             ,input  v-cntxt-userid
     2956             ,input  'wndstore':U
     2957             ,output v-diasize-wndstore
     2958             ,output v-default-value
     2959             ) .
     2960         end.
     2961         assign
     2962           v-diasize-proc-name = entry(1, program-name(2), '.')
     2963         .
     2964         if v-diasize-wndstore = true
     2965         then do:
     2966           assign
     2967             v-restore-saved = false
     2968           .
     2969           if connected("ub") = true
     2970           then do:
     2971             run gbl/wndsizer.p
     2972               (input  v-cntxt-db-num
     2973               ,input  v-cntxt-userid
     2974               ,input  v-diasize-proc-name
     2975               ,input  'height':u
     2976               ,output v-resize-value-str
     2977               ) .
     2978             if v-resize-value-str <> '':U
     2979             then do:
     2980               run diasize_change-height in this-procedure
     2981                 (input  integer(v-resize-value-str)
     2982                 ,input  true
     2983                 ) .
     2984               assign
     2985                 v-restore-saved = true
     2986               .
     2987             end.
     2988           end.
     2989           if connected("ub") = true
     2990           then do:
     2991             run gbl/wndsizer.p
     2992               (input  v-cntxt-db-num
     2993               ,input  v-cntxt-userid
     2994               ,input  v-diasize-proc-name
     2995               ,input  'width':u
     2996               ,output v-resize-value-str
     2997               ) .
     2998             if v-resize-value-str <> '':U
     2999             then do:
     3000               run diasize_change-width in this-procedure
     3001                 (input  integer(v-resize-value-str)
     3002                 ,input  true
     3003                 ) .
     3004               assign
     3005                 v-restore-saved = true
     3006               .
     3007             end.
     3008           end.
     3009           if v-restore-saved <> true
     3010           then do:
     3011             if v-diasize-wndmax = true
     3012             then do:
     3013               run diasize_maximize in this-procedure
     3014                 (input  true
     3015                 ) .
     3016             end.
     3017           end.
     3018         end.
     3019         else do:
     3020           if v-diasize-wndmax = true
     3021           then do:
     3022             run diasize_maximize in this-procedure
     3023               (input  true
     3024               ) .
     3025           end.
     3026         end.
     3027       end.
     3028     end.
     3029   end procedure.
     3030   procedure diasize_need-full-display :
     3031     define output parameter p-need-full-display as logical   no-undo .
     3032     do
     3033     on error undo, return error return-value
     3034     :
     3035       assign
     3036         p-need-full-display = v-diasize-need-full-display
     3037       .
     3038       assign
     3039         v-diasize-need-full-display = false
     3040       .
     3041     end.
     3042   end procedure.
     3043   procedure get-context :
     3044      define output parameter p-db-num as integer          no-undo.
     3045      define output parameter p-user-id as character        no-undo.
     3046      define variable v-login               as character    no-undo.
     3047      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     3048      define buffer buf_user-login  for ub.user-login .
     3049      do
     3050      on error undo, return error
     3051      :
     3052            FIND FIRST buf_sys-ctrl no-lock.
     3053            ASSIGN
     3054               v-login = USERID("ub")
     3055               p-db-num = buf_sys-ctrl.db-num
     3056            .
     3057            FIND FIRST buf_user-login
     3058                 WHERE buf_user-login.db-num = p-db-num
     3059                   AND buf_user-login.user-login = v-login
     3060                 no-lock
     3061                 no-error
     3062                 .
     3063            IF AVAILABLE buf_user-login
     3064            THEN DO:
     3065               assign
     3066                  p-user-id = buf_user-login.user-id
     3067               .
     3068            END.
     3069      end.
     3070   end procedure.
     3071       run diasize_init in this-procedure .
     3072   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3073   procedure set-filter-name :
     3074   define input parameter p-filter-name as character no-undo .
     3075     do with frame Dialog-Frame:
     3076       if p-filter-name > "" then do:
     3077         assign
     3078           frame Dialog-Frame:title
     3079             = frame Dialog-Frame:title + "   ФИЛЬТР: " + p-filter-name.
     3080         .
     3081         assign
     3082           b-sch :tooltip = "Установлен фильтр " + p-filter-name
     3083         .
     3084       end.
     3085       else do:
     3086         assign
     3087           b-sch :tooltip = ""
     3088         .
     3089       end.
     3090     end.
     3091   end procedure.
     3092   define variable vss-include-info20 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3093   on CTRL-P, CTRL-З of frame Dialog-Frame anywhere do:
     3094     if b-print :sensitive then DO: apply "CHOOSE":U to b-print in frame Dialog-Frame. END.
     3095     return no-apply.
     3096   end.
     3097   define variable vss-include-info21 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3098   on CTRL-N, CTRL-Т of frame Dialog-Frame anywhere do:
     3099     if b-add :sensitive then DO: apply "CHOOSE":U to b-add in frame Dialog-Frame. END.
     3100     return no-apply.
     3101   end.
     3102   define variable vss-include-info22 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3103   on F8 of frame Dialog-Frame anywhere do:
     3104     if b-del :sensitive then DO: apply "CHOOSE":U to b-del in frame Dialog-Frame. END.
     3105     return no-apply.
     3106   end.
     3107   define variable vss-include-info23 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3108   on INS of frame Dialog-Frame anywhere do:
     3109     if b-mark :sensitive then DO: apply "CHOOSE":U to b-mark in frame Dialog-Frame. END.
     3110     return no-apply.
     3111   end.
     3112   define variable vss-include-info24 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3113   on F2 of frame Dialog-Frame anywhere do:
     3114     if b-sel :sensitive then DO: apply "CHOOSE":U to b-sel in frame Dialog-Frame. END.
     3115     return no-apply.
     3116   end.
     3117   define variable vss-include-info25 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3118   on F2 of frame Dialog-Frame anywhere do:
     3119     if b-quit :sensitive then DO: apply "CHOOSE":U to b-quit in frame Dialog-Frame. END.
     3120     return no-apply.
     3121   end.
     3122   MAIN-BLOCK:
     3123   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     3124      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     3125   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3126     run mainmenu_getcntxt in parparentproc
     3127       (output v-cntxt-db-num
     3128       ,output v-cntxt-userid
     3129       ,output v-cntxt-level
     3130       ,output v-cntxt-host-code-obj
     3131       ,output v-cntxt-obj-type
     3132       ,output v-cntxt-obj-code
     3133       ,output v-cntxt-db-num-obj
     3134       ,output v-cntxt-is-admin
     3135       ) .
     3136     v-rid-list = p-rid-list.
     3137     if not (p-list-mode = 'все':U
     3138            or
     3139            p-list-mode = "one") then  do:
     3140       message
     3141       substitute("Неверное значение параметра p-list-mode=&1", p-list-mode)
     3142       view-as alert-box error .
     3143       undo, return error .
     3144     end.
     3145     if p-list-mode = "one" then do:
     3146       find first X_ext-system no-lock where
     3147                 X_ext-system.db-num = 0
     3148             and X_ext-system.esys-id = p-esys-id no-error.
     3149       if not available X_ext-system then do:
     3150         message
     3151         substitute("Неверное значение параметра p-esys-id=&1&2" +
     3152                     "Нет внешней системы &1 с db-num = 0"
     3153                   , p-esys-id)
     3154         view-as alert-box error .
     3155         undo, return error .
     3156       end.
     3157     end.
     3158     RUN Myenable.
     3159     WAIT-FOR GO OF FRAME Dialog-Frame.
     3160   END.
     3161   RUN disable_UI.
     3162   PROCEDURE disable_UI :
     3163     HIDE FRAME Dialog-Frame.
     3164   END PROCEDURE.
     3165   PROCEDURE enable_UI :
     3166     DISPLAY fill-cli-vn fill-cli-th mark-num
     3167         WITH FRAME Dialog-Frame.
     3168     ENABLE b-quit B-mark B-sel b-add b-del b-cli b-esys b-look b-sch b-print
     3169            B-Help fill-cli-vn fill-cli-th br-esys-cli mark-num
     3170         WITH FRAME Dialog-Frame.
     3171     VIEW FRAME Dialog-Frame.
     3172     OPEN QUERY br-esys-cli FOR EACH X_ext-classif NO-LOCK,        FIRST X_clients NO-LOCK INDEXED-REPOSITION.
     3173   END PROCEDURE.
     3174   PROCEDURE MyEnable :
     3175   ENABLE
     3176   b-quit
     3177   b-cli
     3178   b-print
     3179   b-look
     3180   b-add when (v-cntxt-db-num = 0 and lookup("b-add", bttns) > 0 and not transaction)
     3181   b-del when (v-cntxt-db-num = 0 and lookup("b-add", bttns) > 0 and not transaction)
     3182   b-esys
     3183   b-sch
     3184   fill-cli-vn
     3185   fill-cli-th
     3186   B-Help
     3187   br-esys-cli
     3188   WITH FRAME Dialog-Frame.
     3189   VIEW FRAME Dialog-Frame.
     3190   RUN Openbr IN THIS-PROCEDURE ( INPUT YES, INPUT NO, INPUT '':U).
     3191   END PROCEDURE.
     3192   PROCEDURE OpenBr :
     3193   define input  parameter p-open-query     as logical   no-undo .
     3194   define input  parameter p-find-next      as logical   no-undo .
     3195   define input  parameter p-find-condition as character no-undo .
     3196   define variable sort-column-phrase as character no-undo .
     3197   define variable l-query-was-opened as logical no-undo .
     3198   define variable title0 as character no-undo .
     3199   define buffer buf_clients for ub.clients.
     3200   case sort-column-name :
     3201     when "" then do:
     3202       assign
     3203         sort-column-phrase = ""
     3204       .
     3205     end.
     3206     otherwise do:
     3207       assign
     3208         sort-column-phrase = "by " + sort-column-name
     3209       .
     3210     end.
     3211   end case.
     3212   filter-point = filter-point0 + p-list-mode .
     3213   case p-list-mode :
     3214     when 'все':U then do:
     3215       title0 = "Объекты и клиенты во внешних системах".
     3216       ASSIGN
     3217       frame Dialog-Frame:title = substitute("&1", title0)
     3218       filter-label = SUBSTITUTE("&1"
     3219                                 , frame Dialog-Frame:title
     3220                                 )
     3221       .
     3222   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3223   define variable  l-disable-where-28  as logical   no-undo .
     3224   define variable  l-filter-open-28    as logical   .
     3225   define variable  flt-rec-28       as recid     no-undo .
     3226   define variable  filter-name-28      as character no-undo .
     3227   define variable  where-phrase-28     as character no-undo .
     3228   define variable  sort-phrase-28      as character no-undo .
     3229   define variable  where-phrase-rus-28 as character no-undo .
     3230   define variable  sort-phrase-rus-28  as character no-undo .
     3231   run gbl/flt-get.p
     3232     (input filter-point
     3233     ,output flt-rec-28
     3234     ,output filter-name-28
     3235     ,output where-phrase-28
     3236     ,output sort-phrase-28
     3237     ,output where-phrase-rus-28
     3238     ,output sort-phrase-rus-28
     3239     ).
     3240       run set-filter-name in this-procedure
     3241         (INPUT filter-name-28
     3242         ) no-error .
     3243     assign
     3244       l-filter-open-28 = false
     3245     .
     3246     if flt-rec-28 <> ?
     3247       or sort-column-phrase > ""
     3248     then do:
     3249       define variable  parameter-2-28 as character no-undo .
     3250       define variable  parameter-3-28 as character no-undo .
     3251       define variable  parameter-4-28 as character no-undo .
     3252       define variable  parameter-5-28 as character no-undo .
     3253       define variable  parameter-6-28 as character no-undo .
     3254       define variable  parameter-7-28 as character no-undo .
     3255         assign
     3256         parameter-3-28 =
     3257                                 "FOR EACH X_ext-classif"
     3258         parameter-4-28 =
     3259           (
     3260             if (" X_ext-classif.classif-subject = 'clients':U                       and X_ext-classif.classif-name = 'clients-esys':U                       AND X_ext-classif.db-num = 0" + " " + where-phrase-28) <> ""
     3261             then  substitute('X_ext-classif.classif-subject = &1&2&1                       and X_ext-classif.classif-name = &1&3&1                       AND X_ext-classif.db-num = 0', chr(34), 'clients':U, 'clients-esys':U) + " " + where-phrase-28
     3262             else "true"
     3263           )
     3264         parameter-5-28 = (" " + "" + " " + ", FIRST X_clients NO-LOCK WHERE                                   X_clients.obj-type = ENTRY(2, X_eXt-classif.uniq-key-rec, chr(3)) AND                                   X_clients.obj-code = integer(ENTRY(3, X_eXt-classif.uniq-key-rec, chr(3)))")
     3265         parameter-6-28 = if sort-phrase-28 = ''
     3266                              then
     3267           (
     3268           " " + "  " +
     3269             " " + sort-column-phrase +
     3270           " " + "  "
     3271           )
     3272                              else
     3273           (
     3274           " " + "  " +
     3275             " " + sort-column-phrase +
     3276           " " + sort-phrase-28
     3277           )
     3278         parameter-7-28 =
     3279           " INDEXED-REPOSITION  "
     3280       .
     3281       do
     3282       on stop undo, leave
     3283       on error undo, leave
     3284       :
     3285         assign
     3286           l-disable-where-28 =
     3287             (" X_ext-classif.classif-subject = 'clients':U                       and X_ext-classif.classif-name = 'clients-esys':U                       AND X_ext-classif.db-num = 0" + " " + where-phrase-28 = "")
     3288         .
     3289         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     3290                             ,input QUERY br-esys-cli:handle
     3291                             ,input parameter-3-28
     3292                             ,input parameter-4-28
     3293                             ,input parameter-5-28
     3294                             ,input parameter-6-28
     3295                             ,input parameter-7-28
     3296                             )
     3297         .
     3298         assign
     3299           l-filter-open-28 = true
     3300         .
     3301       end.
     3302       if l-filter-open-28 = false then do:
     3303         message
     3304           "Ошибка при фильтрации / сортировке" skip
     3305           "Будут показаны записи без учета фильтра" skip
     3306           view-as alert-box .
     3307       end.
     3308       else do:
     3309           assign
     3310             l-query-was-opened = true
     3311           .
     3312       end.
     3313     end.
     3314     if l-filter-open-28 = false then do:
     3315       OPEN QUERY br-esys-cli FOR EACH X_ext-classif
     3316         where  X_ext-classif.classif-subject = 'clients':U                       and X_ext-classif.classif-name = 'clients-esys':U                       AND X_ext-classif.db-num = 0
     3317       , FIRST X_clients NO-LOCK WHERE                                   X_clients.obj-type = ENTRY(2, X_eXt-classif.uniq-key-rec, chr(3)) AND                                   X_clients.obj-code = integer(ENTRY(3, X_eXt-classif.uniq-key-rec, chr(3)))
     3318         INDEXED-REPOSITION
     3319     .
     3320         assign
     3321           l-query-was-opened = true
     3322         .
     3323     end.
     3324     end.
     3325     when "one" then do:
     3326       title0 = substitute("Объекты внешней системы &1", p-esys-id).
     3327       ASSIGN
     3328       frame Dialog-Frame:title = substitute("&1", title0)
     3329       filter-label = SUBSTITUTE("&1"
     3330                                 , frame Dialog-Frame:title
     3331                                 )
     3332       .
     3333   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3334   define variable  l-disable-where-30  as logical   no-undo .
     3335   define variable  l-filter-open-30    as logical   .
     3336   define variable  flt-rec-30       as recid     no-undo .
     3337   define variable  filter-name-30      as character no-undo .
     3338   define variable  where-phrase-30     as character no-undo .
     3339   define variable  sort-phrase-30      as character no-undo .
     3340   define variable  where-phrase-rus-30 as character no-undo .
     3341   define variable  sort-phrase-rus-30  as character no-undo .
     3342   run gbl/flt-get.p
     3343     (input filter-point
     3344     ,output flt-rec-30
     3345     ,output filter-name-30
     3346     ,output where-phrase-30
     3347     ,output sort-phrase-30
     3348     ,output where-phrase-rus-30
     3349     ,output sort-phrase-rus-30
     3350     ).
     3351       run set-filter-name in this-procedure
     3352         (INPUT filter-name-30
     3353         ) no-error .
     3354     assign
     3355       l-filter-open-30 = false
     3356     .
     3357     if flt-rec-30 <> ?
     3358       or sort-column-phrase > ""
     3359     then do:
     3360       define variable  parameter-2-30 as character no-undo .
     3361       define variable  parameter-3-30 as character no-undo .
     3362       define variable  parameter-4-30 as character no-undo .
     3363       define variable  parameter-5-30 as character no-undo .
     3364       define variable  parameter-6-30 as character no-undo .
     3365       define variable  parameter-7-30 as character no-undo .
     3366         assign
     3367         parameter-3-30 =
     3368                                 "FOR EACH X_ext-classif"
     3369         parameter-4-30 =
     3370           (
     3371             if (" X_ext-classif.classif-subject = 'clients':U                       and X_ext-classif.classif-name = 'clients-esys':U                       AND X_ext-classif.db-num = 0                       AND X_ext-classif.key#_one = p-esys-id" + " " + where-phrase-30) <> ""
     3372             then  substitute('X_ext-classif.classif-subject = &1&2&1                       and X_ext-classif.classif-name = &1&3&1                       AND X_ext-classif.db-num = 0                       AND X_ext-classif.key#_one = &4', chr(34), 'clients':U, 'clients-esys':U, p-esys-id) + " " + where-phrase-30
     3373             else "true"
     3374           )
     3375         parameter-5-30 = (" " + "" + " " + ", FIRST X_clients NO-LOCK WHERE                                   X_clients.obj-type = ENTRY(2, X_eXt-classif.uniq-key-rec, chr(3)) AND                                   X_clients.obj-code = integer(ENTRY(3, X_eXt-classif.uniq-key-rec, chr(3)))")
     3376         parameter-6-30 = if sort-phrase-30 = ''
     3377                              then
     3378           (
     3379           " " + "  " +
     3380             " " + sort-column-phrase +
     3381           " " + "  "
     3382           )
     3383                              else
     3384           (
     3385           " " + "  " +
     3386             " " + sort-column-phrase +
     3387           " " + sort-phrase-30
     3388           )
     3389         parameter-7-30 =
     3390           " INDEXED-REPOSITION  "
     3391       .
     3392       do
     3393       on stop undo, leave
     3394       on error undo, leave
     3395       :
     3396         assign
     3397           l-disable-where-30 =
     3398             (" X_ext-classif.classif-subject = 'clients':U                       and X_ext-classif.classif-name = 'clients-esys':U                       AND X_ext-classif.db-num = 0                       AND X_ext-classif.key#_one = p-esys-id" + " " + where-phrase-30 = "")
     3399         .
     3400         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     3401                             ,input QUERY br-esys-cli:handle
     3402                             ,input parameter-3-30
     3403                             ,input parameter-4-30
     3404                             ,input parameter-5-30
     3405                             ,input parameter-6-30
     3406                             ,input parameter-7-30
     3407                             )
     3408         .
     3409         assign
     3410           l-filter-open-30 = true
     3411         .
     3412       end.
     3413       if l-filter-open-30 = false then do:
     3414         message
     3415           "Ошибка при фильтрации / сортировке" skip
     3416           "Будут показаны записи без учета фильтра" skip
     3417           view-as alert-box .
     3418       end.
     3419       else do:
     3420           assign
     3421             l-query-was-opened = true
     3422           .
     3423       end.
     3424     end.
     3425     if l-filter-open-30 = false then do:
     3426       OPEN QUERY br-esys-cli FOR EACH X_ext-classif
     3427         where  X_ext-classif.classif-subject = 'clients':U                       and X_ext-classif.classif-name = 'clients-esys':U                       AND X_ext-classif.db-num = 0                       AND X_ext-classif.key#_one = p-esys-id
     3428       , FIRST X_clients NO-LOCK WHERE                                   X_clients.obj-type = ENTRY(2, X_eXt-classif.uniq-key-rec, chr(3)) AND                                   X_clients.obj-code = integer(ENTRY(3, X_eXt-classif.uniq-key-rec, chr(3)))
     3429         INDEXED-REPOSITION
     3430     .
     3431         assign
     3432           l-query-was-opened = true
     3433         .
     3434     end.
     3435     end.
     3436   end case.
     3437   APPLY "entry" TO br-esys-cli.
     3438   if available X_ext-classif then do:
     3439       APPLY "VALUE-CHANGED":U to br-esys-cli.
     3440   END.
     3441   END PROCEDURE.
     3442   PROCEDURE proc-b-add :
     3443   DEFINE VARIABLE v-rid-list AS CHARACTER NO-UNDO.
     3444   define variable v-rid as recid no-undo .
     3445   DEFINE VARIABLE v-ok AS logical NO-UNDO.
     3446   define variable v-esys-id as integer no-undo .
     3447   DEFINE VARIABLE v-value-character2 AS character NO-UNDO.
     3448   define variable v-value-character as character no-undo .
     3449   define VARIABLE v-value-character3  as character  no-undo .
     3450   define variable v-uniq-key-rec as character no-undo .
     3451   define variable v-esys-uniq-key-rec as character no-undo .
     3452   define variable v-tbl-row as rowid no-undo .
     3453   define variable v-tbl-name as character no-undo .
     3454   define buffer buf_clients for ub.clients.
     3455   define buffer buf_ext-system for ub.ext-system.
     3456   define buffer buf_ext-classif for ub.ext-classif .
     3457   if not available X_ext-system then do:
     3458     message
     3459     "Выберите внешнюю систему, для которой Вы хотите добавить запись объекта"
     3460     view-as alert-box .
     3461     run bge/oxmlexts.p (
     3462           input parparentproc
     3463         , input 2
     3464         , input substitute("esys-type > &1", '0':U)
     3465         , input v-esys-uniq-key-rec
     3466         , output v-rid-list
     3467         , output v-ok
     3468     ).
     3469     if v-ok then do:
     3470       run gen-row-keyr in this-procedure
     3471         ( input v-rid-list
     3472           ,input ?
     3473           ,input "ub"
     3474           ,input ?
     3475           ,input no-lock
     3476           ,output v-tbl-row
     3477           ,output v-tbl-name
     3478         ).
     3479       find first buf_ext-system no-lock where
     3480                 rowid(buf_ext-system) = v-tbl-row.
     3481     end.
     3482     else do:
     3483      undo, return error .
     3484     end.
     3485   end.
     3486   else do:
     3487       find first buf_ext-system no-lock where
     3488                 rowid(buf_ext-system) = rowid(X_ext-system).
     3489   end.
     3490   message
     3491   "Выберите объект, для которого Вы хотите добавить запись во внешней системе"
     3492   view-as alert-box .
     3493   run ref/cli-all.w (   input parparentproc
     3494                     ,input "b-sel"
     3495                     ,input 'все':U
     3496                     ,input 'все':U
     3497                     ,input 'текущие':U
     3498                     ,input ?
     3499                     ,input ",,,,,,NO,,"
     3500                     ,input "":U
     3501                     ,output v-rid-list) no-error.
     3502   if v-rid-list = '':U then return no-apply.
     3503   find first buf_clients where recid (buf_clients) = integer (v-rid-list) no-lock no-error.
     3504   assign
     3505   v-value-character = buf_clients.obj-type
     3506   v-value-character2 = string(buf_clients.obj-code)
     3507   .
     3508   find first buf_ext-classif NO-LOCK where buf_ext-classif.classif-subject = 'clients':U
     3509                                        and buf_ext-classif.classif-name = 'clients-esys':U
     3510                                        and buf_ext-classif.CharKey_One = STRING (buf_ext-system.esys-id)
     3511                                        and buf_ext-classif.CharKey_One = v-value-character
     3512                                        and buf_ext-classif.CharKey_Three = v-value-character2 no-error .
     3513   if AVAILABLE (buf_ext-classif) then do:
     3514     v-value-character3 = buf_ext-classif.CharKey_Two .
     3515   end.
     3516   run ref/esysclii.w (INPUT parparentproc
     3517                      ,input 'ДОБАВЛЕНИЕ':U
     3518                      ,input substitute("Добавление кода объекта во внешней системе &1 для &2&3"
     3519                                 ,buf_ext-system.esys-name
     3520                                 ,buf_clients.obj-type
     3521                                 ,buf_clients.obj-code)
     3522                      ,input INTEGER (buf_ext-system.esys-type)
     3523                      ,input-output v-value-character
     3524                      ,input-output v-value-character2
     3525                      ,input-output v-value-character3
     3526                      ,output v-ok) no-error.
     3527   if not v-ok then return error.
     3528   run gen-key-rec IN THIS-PROCEDURE ( input 'clients':U
     3529                                  ,input (buffer buf_clients:handle)
     3530                                  ,output v-uniq-key-rec).
     3531   run ref/extclas1.p ( INPUT 'ДОБАВЛЕНИЕ':U
     3532                       ,INPUT NO
     3533                       ,INPUT-OUTPUT v-rid
     3534                       ,INPUT 'clients':U
     3535                       ,INPUT 'clients-esys':U
     3536                       ,input 0
     3537                       ,input buf_ext-system.esys-id
     3538                       ,input 0
     3539                       ,input 0
     3540                       ,input v-value-character
     3541                       ,input v-value-character3
     3542                       ,input v-value-character2
     3543                       ,input 0
     3544                       ,input v-uniq-key-rec ) no-error.
     3545   if error-status:error then do:
     3546     undo, return error .
     3547   end.
     3548   if v-rid <> ? then do:
     3549     run openbr in this-procedure ( input yes, input no, input '':U).
     3550     reposition br-esys-cli to recid v-rid no-error .
     3551     apply "entry" to br-esys-cli in frame Dialog-Frame .
     3552   end.
     3553   END PROCEDURE.
     3554   PROCEDURE proc-b-del :
     3555   DEFINE VARIABLE v-rec AS RECID NO-UNDO.
     3556   DEFINE VARIABLE glog AS logical NO-UNDO.
     3557   IF NOT AVAILABLE X_ext-classif THEN UNDO, RETURN ERROR.
     3558   v-rec = recid(X_ext-classif).
     3559   MESSAGE
     3560   "Вы действительно хотите удалить эту запись?"
     3561   VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE glog.
     3562   IF NOT glog THEN RETURN ERROR.
     3563   run ref/extclas3.p ( INPUT NO
     3564                       ,INPUT v-rec) NO-ERROR.
     3565   if not error-status:error then do:
     3566     run openbr in this-procedure ( input yes, input no, input '':U).
     3567     reposition br-esys-cli to row 1 no-error .
     3568     apply "entry" to br-esys-cli in frame Dialog-Frame .
     3569   end.
     3570   END PROCEDURE.
     3571   PROCEDURE proc-b-print :
     3572   DEFINE VARIABLE date_string              as   character no-undo .
     3573   DEFINE VARIABLE Line                     as   character no-undo .
     3574   DEFINE VARIABLE for-time                 as   character no-undo .
     3575   DEFINE VARIABLE accum-count              as   integer   no-undo .
     3576   define variable v-rid                    as   recid no-undo .
     3577   DEFINE VARIABLE v-esys-name AS CHARACTER NO-UNDO.
     3578   output stream OutStr-html to value(v-file-name-rep-htm) append convert target 'UTF-8'.
     3579       put stream OutStr-html unformatted
     3580           "<!DOCTYPE HTML>" skip
     3581           ' <html>' skip
     3582           '  <head>' skip
     3583           '   <meta charset="utf-8">' skip
     3584           '    <style type="text/css">' skip
     3585           '      table ' + chr(123) + ' border-collapse: collapse; font-size: 9pt; table-layout: fixed; width: 1157px; padding: 12px; ' + chr(125) skip
     3586           '      td ' + chr(123) ' border: 1px black ridge; word-wrap:break-word; ' + chr(125) skip
     3587           '      htm' skip
     3588           '      .rotate ' + chr(123) skip
     3589           '        -webkit-transform: rotate(-90deg);' skip
     3590           '        -moz-transform: rotate(-90deg);' skip
     3591           '        -ms-transform: rotate(-90deg);' skip
     3592           '        -o-transform: rotate(-90deg);' skip
     3593           '        transform: rotate(-90deg);' skip
     3594           '        -webkit-transform-origin: 50% 50%;' skip
     3595           '        -moz-transform-origin: 50% 50%;' skip
     3596           '        -ms-transform-origin: 50% 50%;' skip
     3597           '        -o-transform-origin: 50% 50%;' skip
     3598           '        transform-origin: 50% 50%;' skip
     3599           '        filter: progid:DXImageTransform.Microsoft.BasicImage(rotation=3);' skip
     3600           '          ' + chr(125) skip
     3601           '            th' + ' ' + chr(123) skip
     3602           '            border: 1px black solid;' skip
     3603           '            word-wrap: break-word;' skip
     3604           '          ' + chr(125) skip
     3605           '   </style>' skip
     3606           '  </head>' skip
     3607           .
     3608       put stream OutStr-html unformatted
     3609           ' <body>' skip
     3610           '   <table name="ВС" fit_to_page="true" orientation="portrait" outline_below="false">' skip
     3611           '     <thead>' skip
     3612           '       <tr class="set_columns">' skip
     3613           '         <td style="width: 60px; border: none;"></td>' skip
     3614           '         <td style="width: 120px; border: none;"></td>' skip
     3615           '         <td style="width: 60px; border: none;"></td>' skip
     3616           '         <td style="width: 100px; border: none;"></td>' skip
     3617           '         <td style="width: 60px; border: none;"></td>' skip
     3618           '         <td style="width: 100px; border: none;"></td>' skip
     3619           '         <td style="width: 200px; border: none;"></td>' skip
     3620              '</tr>' skip
     3621   .
     3622   put stream OutStr-html unformatted
     3623           '       <tr>' skip
     3624           '         <td colspan="7" style="border: none;text-align: center; font-weight: bold">Объекты и Клиенты всех внешних систем</td>' skip
     3625           '</tr>' skip
     3626           '       <tr>' skip
     3627           '         <td colspan="7" style="border: none;text-align: left; font-weight: bold">Дата печати: ' + STRING(DAY(TODAY), "99") + "." + STRING(MONTH(TODAY), "99") + "." + STRING(YEAR(TODAY), "9999") +  "   " + substring(string(time,"HH:MM:SS"),1,2) + ":" + substring(string(time,"HH:MM:SS"),4,2) +   '</td>' skip
     3628           '</tr>' skip
     3629           .
     3630       put stream OutStr-html unformatted
     3631           '     <tbody>' skip
     3632           '       <tr>' skip
     3633           '         <th  style="background-color:#ffffcc; text-align: center;">Код внешней системы </th>' skip
     3634           '         <th  style="background-color:#ffffcc; text-align: center;">Внешняя система</th>' skip
     3635           '         <th  style="background-color:#ffffcc; text-align: center;">Тип объекта во внешней системе</th>' skip
     3636           '         <th  style="background-color:#ffffcc; text-align: center;">Код объекта во внешней системе</th>' skip
     3637           '         <th  style="background-color:#ffffcc; text-align: center;">Тип Объекта</th>' skip
     3638           '         <th  style="background-color:#ffffcc; text-align: center;">Код объекта</th>' skip
     3639                   '         <th  style="background-color:#ffffcc; text-align: center;">Название объекта</th>' skip
     3640           '</tr>'
     3641           .
     3642       output stream OutStr-html close.
     3643   output stream OutStr-html to value(v-file-name-rep-htm) append convert target 'UTF-8'.
     3644   for each  ub.ext-classif where     ub.ext-classif.classif-subject = 'clients':U
     3645       and  ub.ext-classif.classif-name = 'clients-esys':U :
     3646       i = i + 1.
     3647       v-cli-obj-type = ENTRY(2, ub.eXt-classif.uniq-key-rec, chr(3)) no-error.
     3648       v-cli-obj-code =   ENTRY(3, ub.ext-classif.uniq-key-rec, chr(3)) no-error.
     3649       find first clients where clients.obj-code =   integer(v-cli-obj-code) and  clients.obj-type =    v-cli-obj-type no-lock no-error.
     3650       put stream OutStr-html unformatted
     3651           '       <tr >' skip
     3652           '         <td style="display: yes; text-align: center; font-weight: bold">' +  string(ext-classif.KEY#_one) + '</td>' skip
     3653           '         <td text_wrap="true" style="display: yes; text-align:  right; font-weight: bold">'  + get-esys-name(ext-classif.key#_one) + '</td>' skip
     3654           '         <td style="display: yes; text-align:  right; font-weight: bold">'   + ext-classif.charKEY_one + '</td>' skip
     3655           '         <td style="display: yes; text-align:  right; font-weight: bold">'   + ext-classif.charkey_three + '</td>' skip
     3656           '         <td style="display: yes; text-align:  right; font-weight: bold">'   +  v-cli-obj-type + '</td>' skip
     3657           '         <td style="display: yes; text-align:  right; font-weight: bold">'   + v-cli-obj-code + '</td>' skip
     3658           '         <td text_wrap="true" style="display: yes; text-align:  right; font-weight: bold">'   + clients.obj-name + '</td>' skip
     3659           '       </tr>' skip
     3660           .
     3661   end.
     3662       put stream OutStr-html unformatted
     3663           '       <tr >' skip
     3664           '         <td colspan = "7" style="display: yes; text-align:  left; font-weight: bold">Количество записей : '   + string(i) + '</td>' skip
     3665           '       </tr>' skip
     3666     .
     3667   put stream OutStr-html unformatted
     3668       '     </tbody>' skip
     3669       '   </table>' skip
     3670       '  </body>' skip
     3671       ' </html>' skip
     3672       .
     3673   output stream OutStr-html close.
     3674   i = 0.
     3675   END PROCEDURE.
     3676    procedure define-full-path-Report:
     3677       define input parameter p-rep-num as integer no-undo.
     3678       define output parameter p-file-name-rep-htm as character no-undo.
     3679       p-file-name-rep-htm = session:temp-directory + "Объекты_и_Клиенты_ВС" + ".html".
     3680   end procedure.
     3681   procedure create-file:
     3682       define input parameter p-file-name as character no-undo.
     3683       output to value(string(p-file-name)).
     3684       output close.
     3685   end procedure.
     3686   procedure Report-Viewer:
     3687       define input parameter p-full-path-RepView as character no-undo.
     3688       define input parameter p-file-name-rep-htm as character no-undo.
     3689       os-command no-wait value(p-full-path-RepView + " true " + search(p-file-name-rep-htm)).
     3690   end procedure.
     3691   procedure get-full-path-RepViewer:
     3692       define output parameter p-fill-path-RepView as character no-undo.
     3693       if search("exe\ReportViewer\reportviewer.exe") <> ? then
     3694       do:
     3695           p-fill-path-RepView = search("exe\ReportViewer\reportviewer.exe").
     3696       end.
     3697       else
     3698       do:
     3699           message "Не найдена программа просмотра отчёта!" view-as alert-box error.
     3700       end.
     3701   end procedure.
     3702   procedure search-full-path-Report:
     3703       define input parameter p-file-name as character no-undo.
     3704       if search(p-file-name) = ? then
     3705           do:
     3706               message "Не найден файл отчёта: " p-file-name view-as alert-box error.
     3707           end.
     3708       else
     3709           do:
     3710               p-file-name = search(p-file-name).
     3711           end.
     3712   end procedure.
     3713   PROCEDURE proc-b-sch :
     3714   define variable v-ri as recid no-undo .
     3715   assign
     3716   v-ri = (if avail X_ext-classif then recid(X_ext-classif) else ?)
     3717   .
     3718   assign
     3719   tbl = 'ext-classif':U
     3720   join-tbl = 'X_ext-classif'
     3721   fld = ""
     3722   lab = ""
     3723   spr = ""
     3724   dim = '0'
     3725   .
     3726   run fltfield-add in this-procedure('key#_one', 'Код внешней системы', '',
     3727   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3728   run fltfield-add in this-procedure('key#_two', 'Код объекта во внешней системе', '',
     3729   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3730   run fltfield-add in this-procedure('charkey_one', 'Тип объекта во внешней системе', '',
     3731   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3732   DO on stop undo, leave:
     3733       run gbl/filter.w ( INPUT parparentproc
     3734                    ,INPUT filter-point + chr(4) + filter-label
     3735                    ,INPUT tbl
     3736                    ,INPUT join-tbl
     3737                    ,INPUT fld
     3738                    ,INput lab
     3739                    ,INPUT spr
     3740                    ,INPUT  dim).
     3741       run OpenBr IN THIS-PROCEDURE ( INPUT YES, INPUT NO, INPUT '':U).
     3742       if v-ri <> ? then do:
     3743         reposition br-esys-cli to recid v-ri no-error.
     3744       end.
     3745       APPLY "ENTRY" to br-esys-cli in frame Dialog-Frame .
     3746       APPLY "VALUE-CHANGED" to br-esys-cli.
     3747   END .
     3748   END PROCEDURE.
     3749   FUNCTION get-cli-name RETURNS CHARACTER
     3750     ( INPUT p-uniq-key-rec AS CHARACTER ) :
     3751   DEFINE VARIABLE v-rowid AS ROWID NO-UNDO.
     3752   DEFINE VARIABLE v-tbl-name AS character NO-UNDO.
     3753   DEFINE BUFFER buf_clients FOR ub.clients.
     3754   RUN gen-row-keyr IN THIS-PROCEDURE ( INPUT p-uniq-key-rec
     3755                                       ,input ?
     3756                                       ,INPUT "ub"
     3757                                       ,INPUT ?
     3758                                       ,INPUT NO-LOCK
     3759                                       ,OUTPUT v-rowid
     3760                                       ,OUTPUT v-tbl-name) no-error.
     3761   if error-status :error then do:
     3762     message
     3763       vss-workfile vss-revision vss-description skip
     3764       error-status :get-message(1)
     3765       error-status :get-message(2)
     3766     view-as alert-box error.
     3767     undo, return error.
     3768   end.
     3769   IF v-rowid = ? THEN RETURN 'НЕИЗВЕСТНЫЙ КЛИЕНТ'.
     3770   FIND FIRST buf_clients NO-LOCK WHERE ROWID(buf_clients) = v-rowid.
     3771   RETURN buf_clients.obj-name.
     3772   END FUNCTION.
     3773   FUNCTION get-cli-type-code RETURNS CHARACTER
     3774     ( INPUT p-uniq-key-rec AS character ) :
     3775   DEFINE VARIABLE v-rowid AS ROWID NO-UNDO.
     3776   DEFINE VARIABLE v-tbl-name AS character NO-UNDO.
     3777   DEFINE BUFFER buf_clients FOR ub.clients.
     3778       RUN gen-row-keyr IN THIS-PROCEDURE ( INPUT p-uniq-key-rec
     3779                                           ,INPUT ?
     3780                                           ,INPUT "ub"
     3781                                           ,INPUT ?
     3782                                           ,INPUT NO-LOCK
     3783                                           ,OUTPUT v-rowid
     3784                                           ,OUTPUT v-tbl-name) NO-ERROR.
     3785       if error-status :error then do:
     3786         message
     3787           vss-workfile vss-revision vss-description skip
     3788           error-status :get-message(1)
     3789           error-status :get-message(2)
     3790         view-as alert-box error.
     3791         undo, return error.
     3792       end.
     3793       IF v-rowid = ? THEN RETURN ''.
     3794       FIND FIRST buf_clients NO-LOCK WHERE ROWID(buf_clients) = v-rowid.
     3795       RETURN substitute("&1&2"
     3796                         ,buf_clients.obj-type
     3797                         ,buf_Clients.obj-code).
     3798   END FUNCTION.
     3799   FUNCTION get-esys-name RETURNS CHARACTER
     3800     ( INPUT p-esys-id AS INTEGER ) :
     3801   DEFINE BUFFER buf_ext-system FOR ub.ext-system.
     3802   FIND FIRST buf_ext-system NO-LOCK WHERE
     3803             buf_Ext-system.db-num = 0
     3804         AND buf_Ext-system.esys-id = p-esys-id NO-ERROR.
     3805   IF AVAILABLE buf_ext-system THEN DO:
     3806      RETURN buf_ext-system.esys-name.
     3807   END.
     3808   RETURN "!!Неизвестная внешняя система".
     3809   END FUNCTION.
