     2361         v-change-sign = 1
     2362       .
     2363     end.
     2364     else do:
     2365       assign
     2366         v-change-sign = -1
     2367       .
     2368     end.
     2369     assign
     2370       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2371     .
