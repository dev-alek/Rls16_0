     2326     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2327     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2328     if p-change-value > 0
     2329     then do:
     2330       if frame Dialog-Frame :width + p-change-value >
     2331           session :width-chars
     2332       then do:
     2333         assign
     2334           p-change-value = session :width-chars - frame Dialog-Frame :width
     2335         .
     2336         if p-change-value <= 0
     2337         then do:
     2338           run diasize_position-resize-button in this-procedure .
     2339           return .
     2340         end.
     2341       end.
     2342     end.
