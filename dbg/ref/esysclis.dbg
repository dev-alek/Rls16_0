     1177   define  stream PrnLibStream.
     1178   procedure prn-lib-prn-file :
     1179     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1180     define input parameter p-DIsabledoptions as integer no-undo .
     1181     define variable v-report-name as character no-undo .
     1182     define variable v-user-action as character no-undo .
     1183     define variable v-printed     as logical   no-undo .
     1184     define variable v-exist       as logical   no-undo .
     1185     do
     1186       on error undo, return error
     1187       :
     1188       run prn-lib-get-report-name  in this-procedure (
     1189         input parParentProc
     1190         ,output v-report-name
     1191         ).
     1192   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1193   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
     1194     (input  v-report-name
     1195     ,input  2
     1196     ,output v-exist
     1197     )  .
     1198       if NOT v-exist then
     1199       DO:
     1200         Message
     1201           "Нет заданий на печать ! "
     1202           view-as alert-box .
     1203         Return  .
     1204       End.
     1205       run gbl/prnfilen.w
     1206         (input  ""
     1207         ,input  p-DisabledOptions
     1208         ,input  string(v-report-name )
     1209         ,input  7
     1210         ,output v-user-action
     1211         ,output v-printed
     1212         ) .
     1213       if v-printed then
     1214       do:
     1215         return "YES" .
     1216       end.
     1217       else
     1218       do:
     1219         return "NO" .
     1220       end.
     1221     end.
     1222   end procedure.
     1223   procedure prn-lib-open-stream :
     1224     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1225     define input parameter p-page-size    as integer no-undo .
     1226     define input parameter p-is-stream    as logical no-undo .
     1227     define input parameter p-append       as logical no-undo .
     1228     define variable v-report-name as character no-undo .
     1229     do
     1230       on error undo, return error
     1231       :
     1232       run prn-lib-get-report-name  in this-procedure (
     1233         input parParentProc
     1234         ,output v-report-name
     1235         ).
     1236       if p-is-stream then
     1237       do:
     1238         if p-append then
     1239         do:
     1240           output stream PrnLibStream to value( v-report-name )
     1241             page-size value(p-page-size) append .
     1242         end.
     1243         if not p-append then
     1244         do:
     1245           output stream PrnLibStream to value( v-report-name )
     1246             page-size value(p-page-size) .
     1247         end.
     1248       end.
     1249       if not p-is-stream then
     1250       do:
     1251         if p-append then
     1252         do:
     1253           output to value( v-report-name )
     1254             page-size value(p-page-size) append .
     1255         end.
     1256         if not p-append then
     1257         do:
     1258           output to value( v-report-name )
     1259             page-size value(p-page-size) .
     1260         end.
     1261       end.
     1262     end.
     1263   end procedure.
     1264   procedure prn-lib-open-exp :
     1265     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1266     define input parameter p-is-stream    as logical no-undo .
     1267     define input parameter p-is-append    as logical no-undo .
     1268     define output parameter p-ReportFileName as char init "report" no-undo.
     1269     define output parameter p-process as logical no-undo .
     1270     define variable glog as logical no-undo .
     1271     do
     1272       on error undo, return error
     1273       :
     1274       SYSTEM-DIALOG GET-FILE p-ReportFileName
     1275         TITLE      "Укажите путь"
     1276         FILTERS "Текстовый файл (*.txt)"   "*.txt"
     1277         ASK-OVERWRITE
     1278         CREATE-TEST-FILE
     1279         SAVE-AS
     1280         USE-FILENAME
     1281         DEFAULT-EXTENSION "txt"
     1282         UPDATE glog
     1283         .
     1284       if not glog then  return.
     1285       p-ReportFileName = trim( string( p-ReportFileName ) ) .
     1286       if p-is-stream then
     1287       do:
     1288         if p-is-append then
     1289         do:
     1290           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1291         end.
     1292         else
     1293         do:
     1294           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1295         end.
     1296       end.
     1297       else
     1298       do:
     1299         if p-is-append then
     1300         do:
     1301           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1302         end.
     1303         else
     1304         do:
     1305           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1306         end.
     1307       end.
     1308       p-process = yes.
     1309     end.
     1310   end procedure.
     1311   procedure prn-lib-get-report-name :
     1312     define input parameter parParentProc  as widget-handle no-undo.
     1313     define output parameter p-report-name as character no-undo .
     1314     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
     1315   end procedure.
     1316   procedure prn-lib-reportviewer-report-name :
     1317     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1318     define input parameter p-report-name-html as character no-undo .
     1319     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
     1320   end procedure.
     1321   procedure prn-lib-reportviewer :
     1322     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1323     define input parameter p-report-name-html as character no-undo .
     1324     define input parameter p-param        as character no-undo .
     1325     define variable v-excel           as character no-undo init 'TRUE' .
     1326     define variable v-value-character as character no-undo .
     1327     define variable v-value-integer   as character no-undo .
     1328     define variable v-value-date      as date      no-undo .
     1329     define variable v-value-decimal   as decimal   no-undo .
     1330     define variable rep-excel         as logical   no-undo .
     1331     define variable excel-string      as character no-undo .
     1332     define variable v-param-type      as character no-undo .
     1333     define variable v-tth             as handle    no-undo .
     1334     run adm/shattri.p (
     1335       input "get":U
     1336       ,input  ""
     1337       ,input  0
     1338       ,input  'report-glob':U
     1339       ,input  'rep-excel':U
     1340       ,output v-value-character
     1341       ,output v-value-date
     1342       ,output v-value-decimal
     1343       ,output v-value-integer
     1344       ,output rep-excel
     1345       ,output v-param-type
     1346       ,INPUT-OUTPUT table-handle v-tth
     1347       )  .
     1348     if rep-excel then v-excel = "TRUE" .
     1349     else v-excel = "FALSE" .
     1350     if p-param eq ""
     1351     then
     1352        p-param = "EXCEL:" + v-excel.
     1353     else
     1354        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
     1355     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
     1356   end procedure.
     1357   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1358   define variable v-fltopend-rowid as rowid extent 18 no-undo .
     1359   procedure fltopend_fltopend :
     1360   define input parameter p-parent-handle as handle no-undo .
     1361   define input parameter p-qh as handle no-undo .
     1362   define input parameter p-flt-open-open-query  as character no-undo .
     1363   define input parameter p-where-cond as character no-undo .
     1364   define input parameter p-use-indFIRST-query-tail as character no-undo .
     1365   define input parameter p-use-ind-sort-clmn-by as character no-undo .
     1366   define input parameter p-indexed-reposition as character no-undo .
     1367     do
     1368     on error undo, return error
     1369     :
     1370   define variable v-prepare-string as character no-undo .
     1371   define variable glog as logical no-undo .
     1372   assign
     1373   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     1374                      p-where-cond + chr(32)  +
     1375                      p-use-indFIRST-query-tail + chr(32) +
     1376                      p-use-ind-sort-clmn-by + chr(32) +
     1377                      p-indexed-reposition
     1378   .
     1379   assign
     1380   glog = p-qh:query-prepare(v-prepare-string) no-error .
     1381   if not glog
     1382   or error-status:error then do:
     1383     message error-status:get-message(1) view-as alert-box .
     1384     undo, return error .
     1385   end.
     1386   assign
     1387   glog = p-qh:query-open no-error .
     1388   if not glog
     1389   or error-status:error then do:
     1390     message error-status:get-message(1) view-as alert-box .
     1391     undo, return error .
     1392   end.
     1393     end.
     1394   end procedure.
     1395   procedure fltopend_fltfindd :
     1396   define input parameter p-parent-handle as handle no-undo .
     1397   define input parameter p-qh as handle no-undo .
     1398   define input parameter p-rowid as rowid no-undo .
     1399   define input parameter p-next as logical no-undo .
     1400   define input parameter p-lock as integer no-undo .
     1401   define input parameter p-bh as handle no-undo .
     1402   define input parameter p-where-cond as character no-undo .
     1403   define input parameter p-use-index-phrase as character no-undo .
     1404   define variable glog as logical no-undo .
     1405   define variable v-qh as handle no-undo .
     1406   define variable v-bh as handle no-undo .
     1407   define variable v-recid as recid no-undo .
     1408   define variable v-prepare-string as character no-undo .
     1409   do
     1410   on error undo, return error
     1411   on stop undo, return error
     1412   :
     1413     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
     1414     create buffer v-bh for table p-bh buffer-name p-bh:name.
     1415     create query v-qh.
     1416     v-qh:set-buffers(v-bh).
     1417     v-prepare-string = substitute("for each &1 &2 &3"
     1418                                     ,v-bh:name
     1419                                     ,p-where-cond
     1420                                     ,p-use-index-phrase).
     1421     glog = v-qh:query-prepare(v-prepare-string) no-error.
     1422     if not glog then do:
     1423       delete object v-qh.
     1424       delete object v-bh.
     1425       undo, return error .
     1426     end.
     1427     glog = v-qh:query-open no-error .
     1428     if not glog then do:
     1429       delete object v-qh.
     1430       delete object v-bh.
     1431       undo, return error .
     1432     end.
     1433     if p-next then do:
     1434       v-qh:reposition-to-rowid(p-rowid) no-error .
     1435       glog = v-qh:get-next( p-lock) no-error .
     1436       glog = v-qh:get-next( p-lock) no-error .
     1437       if not glog or v-qh:query-off-end = yes then do:
     1438         glog = v-qh:get-first( p-lock) no-error .
     1439       end.
     1440     end.
     1441     else do:
     1442       glog = v-qh:get-first( p-lock) no-error .
     1443     end.
     1444     v-recid = v-bh:recid no-error .
     1445     delete object v-qh.
     1446     delete object v-bh.
     1447     return string(v-recid) .
     1448   end.
     1449   end procedure.
     1450   procedure fltopend_fltfindq :
     1451   define input parameter p-parent-handle as handle no-undo .
     1452   define input parameter p-qh as handle no-undo .
     1453   define input parameter p-next as logical no-undo .
     1454   define input parameter p-lock as integer no-undo .
     1455   define input parameter p-flt-open-open-query  as character no-undo .
     1456   define input parameter p-where-cond as character no-undo .
     1457   define input parameter p-use-indFIRST-query-tail as character no-undo .
     1458   define input parameter p-use-ind-sort-clmn-by as character no-undo .
     1459   define input parameter p-indexed-reposition as character no-undo .
     1460   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
     1461   define variable glog as logical no-undo .
     1462   define variable v-qh as handle no-undo .
     1463   define variable v-bh as handle no-undo extent 18.
     1464   define variable v-rowid as rowid no-undo extent 18.
     1465   define variable v-ii as integer no-undo .
     1466   define variable v-prepare-string as character no-undo .
     1467   do
     1468   on error undo, return error
     1469   on stop undo, return error
     1470   :
     1471     create query v-qh.
     1472     do v-ii = 1 to p-qh:num-buffers:
     1473       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
     1474       assign
     1475       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
     1476       no-error.
     1477       v-qh:add-buffer(v-bh[v-ii]).
     1478     end.
     1479     assign
     1480     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     1481                       p-where-cond + chr(32)  +
     1482                       p-use-indFIRST-query-tail + chr(32) +
     1483                       p-use-ind-sort-clmn-by + chr(32) +
     1484                       p-indexed-reposition
     1485     .
     1486     glog = v-qh:query-prepare( v-prepare-string) no-error .
     1487     if not glog then do:
     1488       delete object v-qh.
     1489       do v-ii = 1 to p-qh:num-buffers:
     1490         delete object v-bh[v-ii].
     1491       end.
     1492       undo, return error .
     1493     end.
     1494     glog = v-qh:query-open no-error .
     1495     if not glog then do:
     1496       delete object v-qh.
     1497       do v-ii = 1 to p-qh:num-buffers:
     1498         delete object v-bh[v-ii].
     1499       end.
     1500       undo, return error .
     1501     end.
     1502     if p-next then do:
     1503       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
     1504       glog = v-qh:get-next( p-lock) no-error .
     1505       glog = v-qh:get-next( p-lock) no-error .
     1506       if not glog or v-qh:query-off-end = yes then do:
     1507         glog = v-qh:get-first( p-lock) no-error .
     1508       end.
     1509     end.
     1510     else do:
     1511       glog = v-qh:get-first( p-lock) no-error .
     1512     end.
     1513     do v-ii = 1 to p-qh:num-buffers:
     1514       assign
     1515       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
     1516       no-error.
     1517     end.
     1518     delete object v-qh.
     1519     do v-ii = 1 to p-qh:num-buffers:
     1520       delete object v-bh[v-ii].
     1521     end.
     1522   end.
     1523   end procedure.
     1524   define variable g#report-num as integer no-undo .
     1525   define stream OutStr-html .
     1526   define variable i as integer no-undo.
     1527   define variable v-cli-obj-type as character no-undo.
     1528   define variable v-cli-obj-code as character no-undo.
     1529   define variable sort-column-name as character no-undo.
     1530   define variable filter-point     as character NO-UNDO INIT "esysclis".
     1531   define variable filter-label     as character NO-UNDO INIT "Коды объектов внешней системы".
     1532   define variable filter-point0     as character NO-UNDO INIT "esysclis".
     1533   define variable filter-label0     as character NO-UNDO INIT "Коды объектов внешней системы".
     1534   DEFINE VARIABLE v-rid-list AS CHARACTER NO-UNDO.
     1535   define variable v-full-path-RepView as character no-undo.
     1536   define variable v-file-name-rep-htm as character no-undo.
     1537   define variable v-report-name as character no-undo.
     1538   FUNCTION get-cli-name RETURNS CHARACTER
     1539     ( INPUT p-uniq-key-rec AS CHARACTER )  FORWARD.
     1540   FUNCTION get-cli-type-code RETURNS CHARACTER
     1541     ( INPUT p-uniq-key-rec AS character )  FORWARD.
     1542   FUNCTION get-esys-name RETURNS CHARACTER
     1543     ( INPUT p-esys-id AS INTEGER )  FORWARD.
     1544   DEFINE BUTTON b-add
     1545        LABEL "&Добавить"
     1546        SIZE 10 BY 1.
     1547   DEFINE BUTTON b-cli
     1548        LABEL "Объект"
     1549        SIZE 10 BY 1.
     1550   DEFINE BUTTON b-del
     1551        LABEL "&Удалить"
     1552        SIZE 10 BY 1.
     1553   DEFINE BUTTON b-esys
     1554        LABEL "ВС"
     1555        SIZE 10 BY 1.
     1556   DEFINE BUTTON B-Help
     1557        LABEL "Помо&щь"
     1558        SIZE 3 BY 1
     1559        BGCOLOR 8 .
     1560   DEFINE BUTTON b-look
     1561        LABEL "&Просмотр"
     1562        SIZE 10 BY 1.
     1563   DEFINE BUTTON B-mark
     1564        LABEL "&*"
     1565        SIZE 3 BY 1.
     1566   DEFINE BUTTON b-print
     1567        LABEL "&Печать"
     1568        SIZE 3 BY 1.
     1569   DEFINE BUTTON b-quit AUTO-END-KEY
     1570        LABEL "&Выход"
     1571        SIZE 10 BY 1
     1572        BGCOLOR 8 .
     1573   DEFINE BUTTON b-sch
     1574        LABEL "Фильтр"
     1575        SIZE 3 BY 1.
     1576   DEFINE BUTTON B-sel AUTO-GO
     1577        LABEL "Вы&бор"
     1578        SIZE 10 BY 1.
     1579   DEFINE VARIABLE fill-cli-th AS CHARACTER FORMAT "X(256)":U
     1580        LABEL "Код объекта/клиента в TH"
     1581        VIEW-AS FILL-IN
     1582        SIZE 14 BY 1 NO-UNDO.
     1583   DEFINE VARIABLE fill-cli-vn AS CHARACTER FORMAT "X(256)":U
     1584        LABEL "Код объекта/клиента во внешней системе"
     1585        VIEW-AS FILL-IN
     1586        SIZE 14 BY 1 NO-UNDO.
     1587   DEFINE VARIABLE mark-num AS CHARACTER FORMAT "X(256)":U
     1588         VIEW-AS TEXT
     1589        SIZE 6 BY 1
     1590        FGCOLOR 4  NO-UNDO.
     1591   DEFINE QUERY br-esys-cli FOR X_ext-classif, X_clients SCROLLING.
     1592   DEFINE BROWSE br-esys-cli
     1593     QUERY br-esys-cli NO-LOCK DISPLAY
     1594         mark-string(recid(X_ext-classif), v-rid-list) COLUMN-LABEL "" FORMAT "X(1)"
     1595   X_ext-classif.KEY#_one  COLUMN-LABEL "Код!внешней!системы" FORMAT ">>>>>>>>9"
     1596   get-esys-name(X_ext-classif.KEY#_one) COLUMN-LABEL "Внешняя система" FORMAT "X(30)"
     1597   X_ext-classif.charkey_one  COLUMN-LABEL "Тип!объ!во!внеш.!сист." FORMAT "X(3)"
     1598   X_ext-classif.charkey_three  COLUMN-LABEL "Код!объ.!во!внеш.!сист." FORMAT "X(16)"
     1599   X_clients.obj-type COLUMN-LABEL "Тип!объекта" FORMAT "X(3)"
     1600   X_clients.obj-code COLUMN-LABEL "Код!объекта" FORMAT ">>>>>>>>9"
     1601   X_clients.obj-name COLUMN-LABEL "Название объекта" FORMAT "X(60)"
     1602       WITH NO-ROW-MARKERS SEPARATORS SIZE 116 BY 17.75 FIT-LAST-COLUMN.
     1603   DEFINE FRAME Dialog-Frame
     1604        b-quit AT ROW 1 COL 1
     1605        B-mark AT ROW 1 COL 11 WIDGET-ID 4
     1606        B-sel AT ROW 1 COL 21 WIDGET-ID 6
     1607        b-add AT ROW 1 COL 31 WIDGET-ID 14
     1608        b-del AT ROW 1 COL 41 WIDGET-ID 16
     1609        b-cli AT ROW 1 COL 51 WIDGET-ID 2
     1610        b-esys AT ROW 1 COL 61 WIDGET-ID 18
     1611        b-look AT ROW 1 COL 71.13 WIDGET-ID 24
     1612        b-sch AT ROW 1 COL 102.5 WIDGET-ID 12
     1613        b-print AT ROW 1 COL 106 WIDGET-ID 10
     1614        B-Help AT ROW 1 COL 113
     1615        fill-cli-vn AT ROW 3 COL 40.5 COLON-ALIGNED WIDGET-ID 20
     1616        fill-cli-th AT ROW 3 COL 93 COLON-ALIGNED WIDGET-ID 22
     1617        br-esys-cli AT ROW 5.5 COL 1.5 WIDGET-ID 100
     1618        mark-num AT ROW 1 COL 12.5 COLON-ALIGNED NO-LABEL WIDGET-ID 8
     1619        SPACE(97.00) SKIP(21.41)
     1620       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1621            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1622            TITLE ""
     1623            CANCEL-BUTTON b-quit.
     1624   ASSIGN
     1625          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1626          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1627   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1628   DO:
     1629     APPLY "END-ERROR":U TO SELF.
     1630   END.
     1631   ON CHOOSE OF b-add IN FRAME Dialog-Frame
     1632   DO:
     1633     RUN proc-b-add IN THIS-PROCEDURE NO-ERROR.
     1634     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1635   END.
     1636   ON CHOOSE OF b-cli IN FRAME Dialog-Frame
     1637   DO:
     1638     IF NOT AVAILABLE X_clients THEN RETURN NO-APPLY.
     1639     run ref/showcli.p ( INPUT parparentproc
     1640                        ,INPUT X_clients.obj-type
     1641                        ,INPUT X_clients.obj-code) NO-ERROR.
     1642     APPLY "entry" TO br-esys-cli.
     1643   END.
     1644   ON CHOOSE OF b-del IN FRAME Dialog-Frame
     1645   DO:
     1646     IF NOT AVAILABLE X_ext-classif THEN RETURN NO-APPLY.
     1647     RUN proc-b-del IN THIS-PROCEDURE NO-ERROR.
     1648     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1649   END.
     1650   ON CHOOSE OF b-esys IN FRAME Dialog-Frame
     1651   DO:
     1652   define variable v-have-rights    as logical        no-undo.
     1653   define variable v-success    as logical        no-undo.
     1654   define variable v-esys-id   as integer        no-undo.
     1655     IF NOT AVAILABLE X_ext-classif THEN RETURN NO-APPLY.
     1656    ASSIGN
     1657    v-esys-id = X_ext-classif.key#_one.
     1658   define variable vss-include-info13 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1659   do:
     1660     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1661       (input  v-cntxt-db-num
     1662       ,input  v-cntxt-userid
     1663       ,input  0
     1664       ,input  'actn_openxml-subsystem_lookup':U
     1665       ,input  'global':U
     1666       ,input  0
     1667       ,input  '':U
     1668       ,input  0
     1669       ,input  0
     1670       ,input  0
     1671       ,input  0
     1672       ,input  yes
     1673       ,output v-have-rights
     1674       )  .
     1675   end.
     1676       if v-have-rights = yes
     1677       then do:
     1678                     run bge/oxmlspci.w (
     1679                   input parparentproc
     1680                 , input 'ПРОСМОТР':U
     1681                 , input-output v-esys-id
     1682                 , input 0
     1683                 , output v-success
     1684             ) no-error.
     1685    end.
     1686     APPLY "entry" TO br-esys-cli.
     1687   END.
     1688   ON CHOOSE OF b-look IN FRAME Dialog-Frame
     1689   DO:
     1690   define VARIABLE v-ok as LOGICAL no-undo .
     1691       if ( available X_ext-classif ) then do:
     1692         find first ub.ext-system no-lock where
     1693         ub.ext-system.esys-id = integer(X_ext-classif.KEY#_one) no-error .
     1694   run ref/esysclii.w (INPUT parparentproc
     1695                      ,input 'ПРОСМОТР':U
     1696                      ,input substitute("Добавление кода объекта во внешней системе &1 для &2&3"
     1697                                 ,ub.ext-system.esys-name
     1698                                 ,X_clients.obj-type
     1699                                 ,X_clients.obj-code)
     1700                      ,input INTEGER (ub.ext-system.esys-type)
     1701                      ,input-output X_ext-classif.CharKey_One
     1702                      ,input-output X_ext-classif.CharKey_Three
     1703                      ,input-output X_ext-classif.CharKey_Two
     1704                      ,output v-ok) no-error.
     1705   if not v-ok then return NO-APPLY.
     1706   end.
     1707   END.
     1708   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
     1709   DO:
     1710     define variable loc#log as logical no-undo .
     1711     if available X_ext-classif then do:
     1712   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1713   define variable v-str-recid15 as character no-undo .
     1714   define variable v-num-entry15 as integer   no-undo .
     1715   assign
     1716     v-str-recid15 = trim( string( recid( X_ext-classif ) , "->>>>>>>>>>>9":U ) )
     1717     v-num-entry15 = lookup( v-str-recid15 , v-rid-list )
     1718   .
     1719   if v-num-entry15 > 0 then do:
     1720     assign
     1721       entry( v-num-entry15, v-rid-list ) = "":U
     1722       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1723     .
     1724   end.
     1725   else do:
     1726     assign
     1727       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid15
     1728     .
     1729   end.
     1730       loc#log = br-esys-cli:refresh() .
     1731       if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
     1732           loc#log = br-esys-cli:select-next-row ().
     1733           apply "VALUE-CHANGED" to br-esys-cli in frame Dialog-Frame.
     1734       end.
     1735       if num-entries( v-rid-list ) = 0
     1736       then
     1737           hide mark-num in frame Dialog-Frame.
     1738       else
     1739           disp num-entries( v-rid-list ) @ mark-num with frame Dialog-Frame.
     1740     end.
     1741     apply "entry" to br-esys-cli in frame Dialog-Frame.
     1742   END.
     1743   ON CHOOSE OF b-print IN FRAME Dialog-Frame
     1744   DO:
     1745         run get-full-path-RepViewer(output v-full-path-RepView).
     1746   run get-report-num in parParentProc(output g#report-num).
     1747    run define-full-path-Report(input g#report-num, output v-file-name-rep-htm).
     1748   run create-file(v-file-name-rep-htm).
     1749     run proc-b-print IN THIS-PROCEDURE NO-ERROR.
     1750     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1751       run search-full-path-Report(input v-file-name-rep-htm).
     1752   run Report-Viewer(input v-full-path-RepView, input v-file-name-rep-htm).
     1753   END.
     1754   ON CHOOSE OF b-sch IN FRAME Dialog-Frame
     1755   DO:
     1756     run proc-b-sch IN THIS-PROCEDURE NO-ERROR.
     1757     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1758   END.
     1759   ON CHOOSE OF B-sel IN FRAME Dialog-Frame
     1760   DO:
     1761       if ( available X_ext-classif ) then do:
     1762       if  ( v-rid-list = "" ) or b-mark:sensitive = no
     1763       then
     1764       v-rid-list = string( recid( X_ext-classif ) ) .
     1765     end.
     1766   END.
     1767   ON ENTER OF fill-cli-vn IN FRAME Dialog-Frame
     1768   DO:
     1769      find first ub.ext-classif no-lock  where
     1770                                           ub.ext-classif.charkey_three = fill-cli-vn:screen-value
     1771                                           and (if fill-cli-th:screen-value > "" then
     1772                                                ub.ext-classif.Key#_One = integer(fill-cli-th:screen-value) else true)
     1773                                           and  ub.ext-classif.classif-subject = 'clients':U
     1774                                           and  ub.ext-classif.classif-name = 'clients-esys':U no-error.
     1775     if available ub.ext-classif then reposition br-esys-cli to rowid rowid(ub.ext-classif).
     1776                              else message "Указанный код объекта/клиента во внешней системе отсутствует. ".
     1777     apply "entry" to br-esys-cli in frame Dialog-Frame .
     1778     return no-apply.
     1779   END.
     1780   ON ENTER OF fill-cli-th IN FRAME Dialog-Frame
     1781   DO:
     1782     find first ub.ext-classif no-lock   where integer(ENTRY(3, ub.ext-classif.uniq-key-rec, chr(3))) = integer(fill-cli-th:screen-value)
     1783                                            and (if fill-cli-vn:screen-value>"" then
     1784                                                 ub.ext-classif.CharKey_One = fill-cli-vn:screen-value else true )
     1785                                            and ub.ext-classif.classif-subject = 'clients':U
     1786                                            and ub.ext-classif.classif-name = 'clients-esys':U  no-error.
     1787     if available ub.ext-classif then reposition br-esys-cli to rowid rowid(ub.ext-classif).
     1788                              else message "Указанный код объекта/клиента в TH отсутствует. ".
     1789     apply "entry" to br-esys-cli in frame Dialog-Frame .
     1790     return no-apply.
     1791   END.
     1792   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1793   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1794   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1795   on help of frame Dialog-Frame
     1796   do:
     1797     run gbl/app_help.p
     1798       (input this-procedure :file-name
     1799       ,input ''
     1800       ,input ?
     1801       ) no-error.
     1802     if error-status :error then do:
     1803       message
     1804         "Ошибка при вызове помощи"
     1805         error-status :get-message(1)
     1806         view-as alert-box .
     1807     end.
     1808   end.
     1809   run minbtn-set in this-procedure .
     1810   on choose of b-help in frame Dialog-Frame
     1811   do:
     1812     apply "help":u to frame Dialog-Frame .
     1813   end.
     1814   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1815   procedure minbtn-set :
     1816       do
     1817           on error undo, return error return-value
     1818           :
     1819           define variable ii              as integer       no-undo .
     1820           define variable fh              as widget-handle no-undo .
     1821           define variable hh              as widget-handle no-undo .
     1822           define variable v-h             as handle        extent 4 no-undo .
     1823           define variable v-name-button   as character     no-undo .
     1824           define variable v-help-old-x    as decimal       no-undo .
     1825           define variable v-help-old-y    as decimal       no-undo .
     1826           define variable v-help-old-size as decimal       no-undo .
     1827           define variable v-frame-width   as decimal       no-undo .
     1828           define variable jj              as integer       no-undo .
     1829           do
     1830               on error undo, return error
     1831               :
     1832               assign
     1833                   v-frame-width = frame Dialog-Frame:width - 0.3
     1834                   fh            = frame Dialog-Frame:first-child
     1835                   hh            = fh:first-child
     1836                   ii            = 1
     1837                   .
     1838               do while valid-handle(hh):
     1839                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1840                   do:
     1841                       case lc(hh:name) :
     1842                           when "b-help" then
     1843                               do:
     1844                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1845                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1846                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1847                                   hh:TOOLTIP = "Помощь" .
     1848                                   v-help-old-x = hh:column .
     1849                                   v-help-old-y = hh:row    .
     1850                                   v-help-old-size = hh:width .
     1851                                   hh:width-chars = 2.5 .
     1852                               end.
     1853                           when "b-print" then
     1854                               do:
     1855                                   hh:load-image("cmp/b-print.bmp":u) .
     1856                                   hh:TOOLTIP = "Печать" .
     1857                                   v-h[ii] = hh:handle .
     1858                                   ii = ii + 1 .
     1859                                   hh:width-chars = 3 .
     1860                               end.
     1861                           when "b-history" or
     1862                           when "b-hist" then
     1863                               do:
     1864                                   hh:load-image("cmp/b-hist.bmp":u) .
     1865                                   hh:TOOLTIP = "История" .
     1866                                   v-h[ii] = hh:handle .
     1867                                   ii = ii + 1 .
     1868                                   hh:width-chars = 3 .
     1869                               end.
     1870                           when "b-sch" then
     1871                               do:
     1872                                   hh:load-image("cmp/b-sch.bmp":u) .
     1873                                   hh:TOOLTIP = "Установка Фильтра" .
     1874                                   v-h[ii] = hh:handle .
     1875                                   ii = ii + 1 .
     1876                                   hh:width-chars = 3 .
     1877                               end.
     1878                           when "b-hist-user" then
     1879                               do:
     1880                                   hh:load-image("cmp/b-hist.bmp":u) .
     1881                                   hh:TOOLTIP = "История пользователя" .
     1882                                   ii = ii + 1 .
     1883                               end.
     1884                       end case.
     1885                   end.
     1886                   hh = hh:next-sibling.
     1887               end.
     1888               b-help:column = v-frame-width - b-help:width-chars.
     1889               jj = 0.
     1890               repeat ii = 4 to 1 by -1 :
     1891                   if valid-handle (v-h[ii] ) then
     1892                   do:
     1893                       jj  = jj + 1 .
     1894                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1895                       v-h[ii]:row    = v-help-old-y .
     1896                   end.
     1897               end.
     1898           end.
     1899       end.
     1900   end procedure.
     1901   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1902   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1903   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1904   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1905   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1906   define variable v-diasize-current-frame-height as decimal   no-undo .
     1907   define variable v-diasize-change-size          as logical   no-undo .
     1908   define variable v-diasize-resize-button        as handle    no-undo .
     1909   define variable v-diasize-wndmax               as logical   no-undo .
     1910   define variable v-diasize-wndstore             as logical   no-undo .
     1911   define variable v-diasize-proc-name            as character no-undo .
     1912   define variable v-diasize-browse-handle        as handle    no-undo .
     1913   define variable v-diasize-browse-number        as integer   no-undo .
     1914   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1915   define temp-table temp-diasize-handle no-undo
     1916     field handle-value  as handle
     1917     field save-position as decimal
     1918     index xpk is primary unique handle-value
     1919     .
     1920   define temp-table temp-browse-handle no-undo
     1921     field browse-type   as character
     1922     field browse-number as integer
     1923     field browse-handle as handle
     1924     field original-size as decimal
     1925     index xpk is primary unique browse-type browse-number
     1926     index xie browse-type browse-handle
     1927   .
     1928   procedure diasize_change-height :
     1929     define input  parameter p-change-value  as decimal   no-undo .
     1930     define input  parameter p-move-resize   as logical   no-undo .
     1931     define variable v-field-group-handle    as handle    no-undo .
     1932     define variable v-object-handle         as handle    no-undo .
     1933     define variable v-frame-height          as decimal   no-undo .
     1934     define variable v-frame-virtual-height  as decimal   no-undo .
     1935     define variable v-browse-height         as decimal   no-undo .
     1936     define variable v-window-height         as decimal   no-undo .
     1937     define variable v-window-virtual-height as decimal   no-undo .
     1938     define variable v-change-sign           as integer   no-undo .
     1939     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1940     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1941     if p-change-value > 0
     1942     then do:
     1943       if frame Dialog-Frame :height + p-change-value
     1944           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1945       then do:
     1946         assign
     1947           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1948                           - (frame Dialog-Frame :height-chars)
     1949         .
     1950         if p-change-value <= 0
     1951         then do:
     1952           run diasize_position-resize-button in this-procedure .
     1953           return .
     1954         end.
     1955       end.
     1956     end.
     1957     if p-change-value < 0
     1958     then do:
     1959       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1960       then do:
     1961         assign
     1962           p-change-value = v-diasize-orig-frame-height
     1963                          - (frame Dialog-Frame :height-chars)
     1964         .
     1965         if p-change-value >= 0
     1966         then do:
     1967           run diasize_position-resize-button in this-procedure .
     1968           return .
     1969         end.
     1970       end.
     1971     end.
     1972     if p-change-value >= 0
     1973     then do:
     1974       assign
     1975         v-change-sign = 1
     1976       .
     1977     end.
     1978     else do:
     1979       assign
     1980         v-change-sign = -1
     1981       .
     1982     end.
     1983     assign
