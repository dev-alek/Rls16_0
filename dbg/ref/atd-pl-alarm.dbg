        1   define input parameter parparentproc as widget-handle no-undo .
        2   define input parameter p-obj-type like ub.clients.obj-type no-undo .
        3   define input parameter p-obj-code like ub.clients.obj-code no-undo .
        4   define input parameter p-pl-rowid as rowid no-undo .
        5   define variable vss-revision    as character no-undo init "$Revision$":u .
        6   define variable vss-author      as character no-undo init "$Author$":u .
        7   define variable vss-date        as character no-undo init "$Date$":u .
        8   define variable vss-workfile    as character no-undo init "$Workfile$":u .
        9   define variable vss-archive     as character no-undo init "$Archive$":u .
       10   define variable vss-description as character no-undo init "Отключение повторных сообщений АТД" .
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
       18     assign
       19       p-vss-revision    = vss-revision
       20       p-vss-author      = vss-author
       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29   end procedure.
       30   define new global shared variable g#vssrevis-logger as handle    no-undo .
       31   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       32   define variable v-vssrevis-logger                   as handle    no-undo .
       33   procedure vss-logevent :
       34     define input  parameter p-extra-paramters as character no-undo .
       35     define variable v-vssrevis-parameters as character no-undo .
       36     do
       37     on error undo, return error return-value
       38     :
       39       if  valid-handle(v-vssrevis-logger)
       40       and v-vssrevis-logger :get-signature("logevent") <> ""
       41       then do:
       42         run vss-get-parameters in this-procedure
       43           (output v-vssrevis-parameters
       44           ).
       45         run logevent in v-vssrevis-logger
       46           (input vss-workfile
       47           ,input vss-revision
       48           ,input v-vssrevis-parameters
       49           ,input p-extra-paramters
       50           ).
       51       end.
       52     end.
       53   end procedure.
       54   assign
       55     v-vssrevis-logger = g#vssrevis-logger
       56   .
       57   if  valid-handle(v-vssrevis-logger)
       58   and v-vssrevis-logger :get-signature("logevent") <> ""
       59   then do:
       60     assign
       61       v-vssrevis-logevent = true
       62     .
       63     run vss-logevent in this-procedure (input vss-description) .
       64   end.
       65   procedure proc-alt-shift-f2:
       66     if not ibs.th.gbl.gbl-var:rcode
       67   then
       68     run gbl\inidebug.p .
       69   end.
       70   procedure proc-alt-shift-f3:
       71     run gbl/prvssinf.p
       72       ( input this-procedure
       73       ) .
       74   end.
       75   define variable v-inform-launched as logical no-undo initial false .
       76   procedure proc-alt-shift-f4:
       77     define variable v-action as character no-undo .
       78     if v-inform-launched = false then do:
       79       assign
       80         v-inform-launched = true
       81       .
       82       run gbl/d-inform.w
       83         (  input self
       84         ,  input this-procedure
       85         , output v-action
       86         ) no-error .
       87       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       88       assign
       89         v-inform-launched = false
       90       .
       91     end.
       92   end.
       93   procedure proc-alt-f1:
       94     run gbl/corrhelp.p
       95       (input this-procedure
       96       ) .
       97   end .
       98   on alt-shift-f2 anywhere do:
       99     run proc-alt-shift-f2.
      100   end.
      101   on alt-shift-f3 anywhere do:
      102     run proc-alt-shift-f3 in this-procedure .
      103   end.
      104   on alt-shift-f4 anywhere do:
      105     run proc-alt-shift-f4 in this-procedure.
      106   end.
      107   on alt-f1 anywhere do:
      108     run proc-alt-f1 in this-procedure .
      109   end.
      110   define new global shared variable g#language as character no-undo .
      111   if g#language <> '' and g#language <> 'rus':U then do:
      112     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      113   end.
      114   procedure placelib_write-attr:
      115   define input  parameter p-code     like ub.place-attr.attr-code .
      116   define input  parameter p-obj-code like ub.place-attr.obj-code .
      117   define input  parameter p-obj-type like ub.place-attr.obj-type .
      118   define input  parameter p-pl-code  like ub.place-attr.pl-code .
      119   define input  parameter p-value    like ub.place-attr.attr-value .
      120   define output parameter p-ok       as logical.
      121   define buffer buf_place-attr for ub.place-attr .
      122     do on error undo, return error return-value :
      123        p-ok = false.
      124        find first buf_place-attr exclusive-lock where buf_place-attr.attr-code   = p-code
      125                                                   and buf_place-attr.obj-code    = p-obj-code
      126                                                   and buf_place-attr.obj-type    = p-obj-type
      127                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
      128        if not available buf_place-attr then do :
      129           create buf_place-attr.
      130           assign
      131             buf_place-attr.attr-code   = p-code
      132             buf_place-attr.attr-value  = p-value
      133             buf_place-attr.obj-code    = p-obj-code
      134             buf_place-attr.obj-type    = p-obj-type
      135             buf_place-attr.pl-code     = p-pl-code
      136           .
      137           p-ok = true.
      138        end.
      139        else do:
      140           buf_place-attr.attr-value  = p-value .
      141           p-ok = true.
      142        end.
      143     end.
      144   end.
      145   procedure placelib_get-attr:
      146   define input  parameter  p-code     like ub.place-attr.attr-code .
      147   define input  parameter  p-obj-code like ub.place-attr.obj-code .
      148   define input  parameter  p-obj-type like ub.place-attr.obj-type .
      149   define input  parameter  p-pl-code  like ub.place-attr.pl-code .
      150   define output parameter  p-value    like ub.place-attr.attr-value .
      151   define output parameter  p-ok       as logical.
      152   define buffer buf_place-attr for ub.place-attr .
      153     do on error undo, return error return-value :
      154        p-ok = false.
      155        find first buf_place-attr no-lock where buf_place-attr.attr-code   = p-code
      156                                                   and buf_place-attr.obj-code    = p-obj-code
      157                                                   and buf_place-attr.obj-type    = p-obj-type
      158                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
      159        if available buf_place-attr then do :
      160          p-value = buf_place-attr.attr-value.
      161          p-ok = true.
      162        end.
      163        else do :
      164          p-ok = false.
      165        end.
      166     end.
      167   end.
      168   procedure placelib_del-attr:
      169   define input parameter  p-code     like ub.place-attr.attr-code .
      170   define input parameter  p-obj-code like ub.place-attr.obj-code .
      171   define input parameter  p-obj-type like ub.place-attr.obj-type .
      172   define input parameter  p-pl-code  like ub.place-attr.pl-code .
      173   define input parameter  p-value    like ub.place-attr.attr-value .
      174   define output parameter p-ok       as logical.
      175   define buffer buf_place-attr for ub.place-attr .
      176     do on error undo, return error return-value :
      177        p-ok = false.
      178        find first buf_place-attr exclusive-lock where buf_place-attr.attr-code   = p-code
      179                                                   and buf_place-attr.obj-code    = p-obj-code
      180                                                   and buf_place-attr.obj-type    = p-obj-type
      181                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
      182        if available buf_place-attr then do :
      183           delete buf_place-attr.
      184           p-ok = true.
      185        end.
      186     end.
      187   end.
      188   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      189     define variable v-cntxt-db-num        as integer   no-undo .
      190     define variable v-cntxt-userid        as character no-undo .
      191     define variable v-cntxt-level         as character no-undo .
      192     define variable v-cntxt-host-code-obj as integer   no-undo .
      193     define variable v-cntxt-obj-type      as character no-undo .
      194     define variable v-cntxt-obj-code      as integer   no-undo .
      195     define variable v-cntxt-db-num-obj    as integer   no-undo .
      196     define variable v-cntxt-is-admin      as logical   no-undo .
      197   define variable v-attr-shift-date   as date     no-undo .
      198   define variable v-attr-shift-num    as integer  no-undo .
      199   define buffer buf_clients for ub.clients .
      200   define buffer buf_place for ub.place .
      201   define buffer buf_place-attr for ub.place-attr .
      202   define buffer buf_shift-obj for ub.shift-obj .
      203   DEFINE BUTTON b-cancel AUTO-END-KEY
      204        LABEL "Отмена"
      205        SIZE 15 BY 1.14
      206        BGCOLOR 8 .
      207   DEFINE BUTTON b-ok AUTO-GO
      208        LABEL "Ввод"
      209        SIZE 15 BY 1.14
      210        BGCOLOR 8 .
      211   DEFINE VARIABLE t-level AS LOGICAL INITIAL no
      212        LABEL "Отключить сообщения о переполнении"
      213        VIEW-AS TOGGLE-BOX
      214        SIZE 40 BY .81 NO-UNDO.
      215   DEFINE VARIABLE t-water AS LOGICAL INITIAL no
      216        LABEL "Отключить сообщения по воде"
      217        VIEW-AS TOGGLE-BOX
      218        SIZE 40 BY .81 NO-UNDO.
      219   DEFINE FRAME Dialog-Frame
      220        b-ok AT ROW 1.38 COL 2
      221        b-cancel AT ROW 1.38 COL 16.8
      222        t-water AT ROW 3.14 COL 2.2 WIDGET-ID 2
      223        t-level AT ROW 4.38 COL 2.2 WIDGET-ID 4
      224        SPACE(3.79) SKIP(0.75)
      225       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      226            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      227            TITLE "Отключение повторных сообщений"
      228            DEFAULT-BUTTON b-ok CANCEL-BUTTON b-cancel WIDGET-ID 100.
      229   ASSIGN
      230          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      231          FRAME Dialog-Frame:HIDDEN           = TRUE.
      232   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      233   DO:
      234     APPLY "END-ERROR":U TO SELF.
      235   END.
      236   ON CHOOSE OF b-ok IN FRAME Dialog-Frame
      237   DO:
      238     define variable t-water-chr as character no-undo .
      239     define variable t-level-chr as character no-undo .
      240     assign
      241       t-water
      242       t-level
      243     .
      244     if t-water
      245     then t-water-chr = "disable" .
      246     else t-water-chr = "enable" .
      247     if t-level
      248     then t-level-chr = "disable" .
      249     else t-level-chr = "enable" .
      250     find first buf_place-attr exclusive-lock where buf_place-attr.attr-code   = "disable-water-alarm"
      251                                                and buf_place-attr.obj-code    = buf_place.obj-code
      252                                                and buf_place-attr.obj-type    = buf_place.obj-type
      253                                                and buf_place-attr.pl-code     = buf_place.pl-code
      254                                                no-error .
      255     if not available buf_place-attr
      256     then do :
      257       create buf_place-attr .
      258       assign
      259         buf_place-attr.attr-code   = "disable-water-alarm"
      260         buf_place-attr.obj-code    = buf_place.obj-code
      261         buf_place-attr.obj-type    = buf_place.obj-type
      262         buf_place-attr.pl-code     = buf_place.pl-code
      263       .
      264     end .
      265     assign
      266       buf_place-attr.attr-value = t-water-chr + chr(4) + string(buf_shift-obj.shift-date) + chr(4) + string(buf_shift-obj.shift-num)
      267     .
      268     if v-cntxt-db-num = 0
      269     then do :
      270       run nws/cr-route.p ( input 'send-cmd':U
      271                           ,input "command":U + chr(1) +
      272                                  "place-attr":U + chr(1) +
      273                                  buf_place-attr.obj-type + chr(1) +
      274                                  string(buf_place-attr.obj-code) + chr(1) +
      275                                  string(buf_place-attr.pl-code) + chr(1) +
      276                                  buf_place-attr.attr-code + chr(1) +
      277                                  buf_place-attr.attr-value
      278                           ,input ?
      279                           ,input string(buf_clients.db-num)
      280                          ).
      281     end .
      282     find first buf_place-attr exclusive-lock where buf_place-attr.attr-code   = "disable-level-alarm"
      283                                                and buf_place-attr.obj-code    = buf_place.obj-code
      284                                                and buf_place-attr.obj-type    = buf_place.obj-type
      285                                                and buf_place-attr.pl-code     = buf_place.pl-code
      286                                                no-error .
      287     if not available buf_place-attr
      288     then do :
      289       create buf_place-attr .
      290       assign
      291         buf_place-attr.attr-code   = "disable-level-alarm"
      292         buf_place-attr.obj-code    = buf_place.obj-code
      293         buf_place-attr.obj-type    = buf_place.obj-type
      294         buf_place-attr.pl-code     = buf_place.pl-code
      295       .
      296     end .
      297     assign
      298       buf_place-attr.attr-value = t-level-chr + chr(4) + string(buf_shift-obj.shift-date) + chr(4) + string(buf_shift-obj.shift-num)
      299     .
      300     if v-cntxt-db-num = 0
      301     then do :
      302       run nws/cr-route.p ( input 'send-cmd':U
      303                           ,input "command":U + chr(1) +
      304                                  "place-attr":U + chr(1) +
      305                                  buf_place-attr.obj-type + chr(1) +
      306                                  string(buf_place-attr.obj-code) + chr(1) +
      307                                  string(buf_place-attr.pl-code) + chr(1) +
      308                                  buf_place-attr.attr-code + chr(1) +
      309                                  buf_place-attr.attr-value
      310                           ,input ?
      311                           ,input string(buf_clients.db-num)
      312                          ).
      313     end .
      314   END.
      315   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      316   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      317   MAIN-BLOCK:
      318   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      319      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      320   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      321     run mainmenu_getcntxt in parparentproc
      322       (output v-cntxt-db-num
      323       ,output v-cntxt-userid
      324       ,output v-cntxt-level
      325       ,output v-cntxt-host-code-obj
      326       ,output v-cntxt-obj-type
      327       ,output v-cntxt-obj-code
      328       ,output v-cntxt-db-num-obj
      329       ,output v-cntxt-is-admin
      330       ) .
      331     find first buf_clients no-lock where buf_clients.obj-type = p-obj-type
      332                                      and buf_clients.obj-code = p-obj-code
      333                                      .
      334     find first buf_shift-obj where buf_shift-obj.obj-type = p-obj-type
      335                                and buf_shift-obj.obj-code = p-obj-code
      336                                and buf_shift-obj.status_ = 'тек':U
      337                                use-index stts no-lock no-error .
      338     if not available buf_shift-obj
      339     then do :
      340       message "Нет открытой смены на объекте!" view-as alert-box warning .
      341       return .
      342     end .
      343     find first buf_place no-lock where rowid(buf_place) = p-pl-rowid .
      344     for first buf_place-attr no-lock where buf_place-attr.attr-code   = "disable-level-alarm"
      345                                        and buf_place-attr.obj-code    = buf_place.obj-code
      346                                        and buf_place-attr.obj-type    = buf_place.obj-type
      347                                        and buf_place-attr.pl-code     = buf_place.pl-code
      348                                        :
      349       if num-entries(buf_place-attr.attr-value, chr(4)) = 3
      350       then do :
      351         v-attr-shift-date = date(entry(2, buf_place-attr.attr-value, chr(4))) .
      352         v-attr-shift-num = integer(entry(3, buf_place-attr.attr-value, chr(4))) .
      353         if v-attr-shift-date = buf_shift-obj.shift-date
      354         and v-attr-shift-num = buf_shift-obj.shift-num
      355         and entry(1, buf_place-attr.attr-value, chr(4)) = "disable"
      356         then do :
      357           t-level = yes .
      358         end .
      359       end .
      360     end .
      361     for first buf_place-attr no-lock where buf_place-attr.attr-code   = "disable-water-alarm"
      362                                        and buf_place-attr.obj-code    = buf_place.obj-code
      363                                        and buf_place-attr.obj-type    = buf_place.obj-type
      364                                        and buf_place-attr.pl-code     = buf_place.pl-code
      365                                        :
      366       if num-entries(buf_place-attr.attr-value, chr(4)) = 3
      367       then do :
      368         v-attr-shift-date = date(entry(2, buf_place-attr.attr-value, chr(4))) .
      369         v-attr-shift-num = integer(entry(3, buf_place-attr.attr-value, chr(4))) .
      370         if v-attr-shift-date = buf_shift-obj.shift-date
      371         and v-attr-shift-num = buf_shift-obj.shift-num
      372         and entry(1, buf_place-attr.attr-value, chr(4)) = "disable"
      373         then do :
      374           t-water = yes .
      375         end .
      376       end .
      377     end .
      378     RUN enable_UI.
      379     WAIT-FOR GO OF FRAME Dialog-Frame.
      380   END.
      381   RUN disable_UI.
      382   PROCEDURE disable_UI :
      383     HIDE FRAME Dialog-Frame.
      384   END PROCEDURE.
      385   PROCEDURE enable_UI :
      386     DISPLAY t-water t-level
      387         WITH FRAME Dialog-Frame.
      388     ENABLE b-ok b-cancel t-water t-level
      389         WITH FRAME Dialog-Frame.
      390     VIEW FRAME Dialog-Frame.
      391   END PROCEDURE.
