        1   BLOCK-LEVEL ON ERROR UNDO, THROW.
        2   define output parameter this-proc-hndl as handle no-undo.
        3   define variable vss-revision    as character no-undo init "$Revision$":U .
        4   define variable vss-author      as character no-undo init "$Author$":U .
        5   define variable vss-date        as character no-undo init "$Date$":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        7   define variable vss-archive     as character no-undo init "$Archive$":U .
        8   define variable vss-description as character no-undo init "Метод возвращает можно ли добавить данный товар в спецификацию".
        9   define new global shared variable g#language as character no-undo .
       10   if g#language <> '' and g#language <> 'rus':U then do:
       11     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       12   end.
       13   do:
       14     this-proc-hndl = this-procedure.
       15   end.
       16   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       17   procedure SpecGr-gds-code-yes :
       18   define input  parameter p-gds-code   as integer   no-undo .
       19   define input  parameter p-node-code  as integer   no-undo .
       20   define input  parameter p-contract-num         as integer   no-undo .
       21   define input  parameter p-host-code     as integer   no-undo .
       22   define output parameter p-ask        as logical   no-undo .
       23   define buffer buf_gds-grp-obj-attr for ub.gds-grp-obj-attr  .
       24   define buffer buf1_gds-grp-obj-attr for ub.gds-grp-obj-attr  .
       25   define buffer buf_goods   for ub.goods  .
       26   define buffer buf_gds-grp for ub.gds-grp  .
       27   define variable v-grp-qnty as integer   no-undo .
       28   define variable v-grp-lim as integer   no-undo .
       29     do
       30     on error undo, return error return-value
       31     :
       32   p-ask = ? .
       33   find first buf_goods no-lock where buf_goods.gds-code = p-gds-code .
       34   find first buf_gds-grp-obj-attr no-lock where
       35              buf_gds-grp-obj-attr.attr-code = 'LimSpecGr':U and
       36              buf_gds-grp-obj-attr.obj-type  = string(p-contract-num) and
       37              buf_gds-grp-obj-attr.obj-code  = p-host-code and
       38              buf_gds-grp-obj-attr.host-code = 0 and
       39              buf_gds-grp-obj-attr.node-code = p-node-code no-error .
       40   if error-status :error then do:
       41     p-ask = true .
       42     return .
       43   end.
       44   if buf_gds-grp-obj-attr.attr-value  = "0" then do:
       45     p-ask = false  .
       46     return .
       47   end.
       48     if buf_gds-grp-obj-attr.attr-value  = "" or
       49       buf_gds-grp-obj-attr.attr-value  = ?  or
       50       buf_gds-grp-obj-attr.attr-value  = "?" then do:
       51       find first buf_gds-grp no-lock where
       52                   buf_gds-grp.node-code = p-node-code no-error .
       53         if available buf_gds-grp  then do:
       54             if buf_gds-grp.upper-code = 0 then do:
       55                 p-ask = true .
       56                 return .
       57             end.
       58             else do:
       59                 run SpecGr-gds-code-yes (
       60                    input   p-gds-code
       61                   ,input   buf_gds-grp.upper-code
       62                   ,input   p-contract-num
       63                   ,input   p-host-code
       64                   ,output  p-ask
       65                   ).
       66                 if p-ask <> ? then return .
       67           end.
       68         end.
       69     end.
       70     else do:
       71       v-grp-lim = int (buf_gds-grp-obj-attr.attr-value) no-error  .
       72       if v-grp-lim > 0 then do:
       73           v-grp-qnty = 0 .
       74           find first buf1_gds-grp-obj-attr no-lock where
       75                      buf1_gds-grp-obj-attr.attr-code = 'QntySpecGr':U and
       76                      buf1_gds-grp-obj-attr.obj-type  = string(p-contract-num) and
       77                      buf1_gds-grp-obj-attr.obj-code  = p-host-code and
       78                      buf1_gds-grp-obj-attr.host-code = 0 and
       79                      buf1_gds-grp-obj-attr.node-code = p-node-code no-error .
       80           if available buf1_gds-grp-obj-attr then do:
       81             v-grp-qnty = int(buf1_gds-grp-obj-attr.attr-value) .
       82           end.
       83           if v-grp-lim >= v-grp-qnty + 1 then p-ask = true .
       84           else p-ask = false .
       85           return .
       86       end.
       87     end.
       88     end.
       89   end procedure.
       90   procedure recalc-gds-SpecGr :
       91   define input  parameter p-action     as character no-undo .
       92   define input  parameter p-node-code  as integer   no-undo .
       93   define input  parameter p-contract-num         as integer   no-undo .
       94   define input  parameter p-host-code     as integer   no-undo .
       95   define buffer buf_gds-grp for ub.gds-grp  .
       96   define buffer curr_gds-grp for ub.gds-grp  .
       97   define buffer buf1_gds-grp-obj-attr for ub.gds-grp-obj-attr  .
       98   define variable kk as character no-undo .
       99     do
      100     on error undo, return error return-value
      101     :
      102       find first buf1_gds-grp-obj-attr exclusive-lock where
      103                  buf1_gds-grp-obj-attr.attr-code = 'QntySpecGr':U and
      104                  buf1_gds-grp-obj-attr.obj-type  = string(p-contract-num) and
      105                  buf1_gds-grp-obj-attr.obj-code  = p-host-code and
      106                  buf1_gds-grp-obj-attr.host-code = 0 and
      107                  buf1_gds-grp-obj-attr.node-code = p-node-code
      108                  no-error .
      109       if available buf1_gds-grp-obj-attr then do:
      110          if p-action = '+' then  do:
      111             kk = string( int( buf1_gds-grp-obj-attr.attr-value ) + 1 ).
      112          end.
      113          else do:
      114             kk = string( int( buf1_gds-grp-obj-attr.attr-value ) - 1 ).
      115          end.
      116          buf1_gds-grp-obj-attr.attr-value = kk .
      117       end.
      118       else do:
      119           if p-action = '+' then  do:
      120               create buf1_gds-grp-obj-attr .
      121                 assign
      122                   buf1_gds-grp-obj-attr.attr-code  = 'QntySpecGr':U
      123                   buf1_gds-grp-obj-attr.obj-type   = string(p-contract-num)
      124                   buf1_gds-grp-obj-attr.obj-code   = p-host-code
      125                   buf1_gds-grp-obj-attr.host-code  = 0
      126                   buf1_gds-grp-obj-attr.node-code  = p-node-code
      127                   buf1_gds-grp-obj-attr.attr-value = "1"
      128                 .
      129           end.
      130       end.
      131      FIND FIRST curr_gds-grp WHERE
      132                 curr_gds-grp.node-code = p-node-code
      133           NO-LOCK NO-ERROR.
      134      if AVAILABLE curr_gds-grp AND curr_gds-grp.upper-code > 0 then do:
      135         run recalc-gds-SpecGr (p-action ,curr_gds-grp.upper-code,p-contract-num,p-host-code ) .
      136      end.
      137     end.
      138   end procedure.
