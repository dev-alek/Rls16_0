     1691     END.
     1692     ELSE DO:
     1693         buf_matrix.asmt-date-create   :fgcolor in browse BROWSE-AM = DARK_GRAY_COLOR.
     1694         buf_matrix.asmt-date-update   :fgcolor in browse BROWSE-AM = DARK_GRAY_COLOR.
     1695         buf_matrix.asmt-db-num-create :fgcolor in browse BROWSE-AM = DARK_GRAY_COLOR.
     1696         buf_matrix.asmt-db-num-update :fgcolor in browse BROWSE-AM = DARK_GRAY_COLOR.
     1697         buf_matrix.asmt-name         :fgcolor in browse BROWSE-AM  = DARK_GRAY_COLOR.
     1698         p-asmt-type         :fgcolor in browse BROWSE-AM  = DARK_GRAY_COLOR.
     1699         p-mark                       :fgcolor in browse BROWSE-AM  = DARK_GRAY_COLOR.
     1700         p-obj                        :fgcolor in browse BROWSE-AM  = DARK_GRAY_COLOR.
     1701         p-time-upd                   :fgcolor in browse BROWSE-AM  = DARK_GRAY_COLOR.
     1702         p-time-cr                    :fgcolor in browse BROWSE-AM  = DARK_GRAY_COLOR.
     1703         p-status                     :fgcolor in browse BROWSE-AM  = DARK_GRAY_COLOR.
