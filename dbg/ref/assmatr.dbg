     1682         buf_matrix.asmt-db-num-create :fgcolor in browse BROWSE-AM = ?.
     1683         buf_matrix.asmt-db-num-update :fgcolor in browse BROWSE-AM = ?.
     1684         buf_matrix.asmt-name         :fgcolor in browse BROWSE-AM = ? .
     1685         p-asmt-type         :fgcolor in browse BROWSE-AM = ? .
     1686         p-mark                       :fgcolor in browse BROWSE-AM = ? .
     1687         p-obj                        :fgcolor in browse BROWSE-AM = ? .
     1688         p-time-upd                   :fgcolor in browse BROWSE-AM = ? .
     1689         p-time-cr                    :fgcolor in browse BROWSE-AM = ? .
