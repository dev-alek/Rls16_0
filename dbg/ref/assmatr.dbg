     1750   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1751   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1752   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1753   procedure set-filter-name :
     1754   define input parameter p-filter-name as character no-undo .
     1755     do with frame Dialog-Frame:
     1756       if p-filter-name > "" then do:
     1757         assign
     1758           frame Dialog-Frame:title
     1759             = frame Dialog-Frame:title + "   ФИЛЬТР: " + p-filter-name.
     1760         .
     1761       end.
     1762       else do:
     1763       end.
     1764     end.
     1765   end procedure.
     1766   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1767   on help of frame Dialog-Frame
     1768   do:
     1769     run gbl/app_help.p
     1770       (input this-procedure :file-name
     1771       ,input ''
     1772       ,input ?
     1773       ) no-error.
     1774     if error-status :error then do:
     1775       message
     1776         "Ошибка при вызове помощи"
     1777         error-status :get-message(1)
     1778         view-as alert-box .
     1779     end.
     1780   end.
     1781   run minbtn-set in this-procedure .
     1782   on choose of b-help in frame Dialog-Frame
     1783   do:
     1784     apply "help":u to frame Dialog-Frame .
     1785   end.
     1786   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1787   procedure minbtn-set :
     1788       do
     1789           on error undo, return error return-value
     1790           :
     1791           define variable ii              as integer       no-undo .
     1792           define variable fh              as widget-handle no-undo .
     1793           define variable hh              as widget-handle no-undo .
     1794           define variable v-h             as handle        extent 4 no-undo .
     1795           define variable v-name-button   as character     no-undo .
     1796           define variable v-help-old-x    as decimal       no-undo .
     1797           define variable v-help-old-y    as decimal       no-undo .
     1798           define variable v-help-old-size as decimal       no-undo .
     1799           define variable v-frame-width   as decimal       no-undo .
     1800           define variable jj              as integer       no-undo .
     1801           do
     1802               on error undo, return error
     1803               :
     1804               assign
     1805                   v-frame-width = frame Dialog-Frame:width - 0.3
     1806                   fh            = frame Dialog-Frame:first-child
     1807                   hh            = fh:first-child
     1808                   ii            = 1
     1809                   .
     1810               do while valid-handle(hh):
     1811                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1812                   do:
     1813                       case lc(hh:name) :
     1814                           when "b-help" then
     1815                               do:
     1816                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1817                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1818                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1819                                   hh:TOOLTIP = "Помощь" .
     1820                                   v-help-old-x = hh:column .
     1821                                   v-help-old-y = hh:row    .
     1822                                   v-help-old-size = hh:width .
     1823                                   hh:width-chars = 2.5 .
     1824                               end.
     1825                           when "b-print" then
     1826                               do:
     1827                                   hh:load-image("cmp/b-print.bmp":u) .
     1828                                   hh:TOOLTIP = "Печать" .
     1829                                   v-h[ii] = hh:handle .
     1830                                   ii = ii + 1 .
     1831                                   hh:width-chars = 3 .
     1832                               end.
     1833                           when "b-history" or
     1834                           when "b-hist" then
     1835                               do:
     1836                                   hh:load-image("cmp/b-hist.bmp":u) .
     1837                                   hh:TOOLTIP = "История" .
     1838                                   v-h[ii] = hh:handle .
     1839                                   ii = ii + 1 .
     1840                                   hh:width-chars = 3 .
     1841                               end.
     1842                           when "b-sch" then
     1843                               do:
     1844                                   hh:load-image("cmp/b-sch.bmp":u) .
     1845                                   hh:TOOLTIP = "Установка Фильтра" .
     1846                                   v-h[ii] = hh:handle .
     1847                                   ii = ii + 1 .
     1848                                   hh:width-chars = 3 .
     1849                               end.
     1850                           when "b-hist-user" then
     1851                               do:
     1852                                   hh:load-image("cmp/b-hist.bmp":u) .
     1853                                   hh:TOOLTIP = "История пользователя" .
     1854                                   ii = ii + 1 .
     1855                               end.
     1856                       end case.
     1857                   end.
     1858                   hh = hh:next-sibling.
     1859               end.
     1860               b-help:column = v-frame-width - b-help:width-chars.
     1861               jj = 0.
     1862               repeat ii = 4 to 1 by -1 :
     1863                   if valid-handle (v-h[ii] ) then
     1864                   do:
     1865                       jj  = jj + 1 .
     1866                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1867                       v-h[ii]:row    = v-help-old-y .
     1868                   end.
     1869               end.
     1870           end.
     1871       end.
     1872   end procedure.
     1873   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1874   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1875   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1876   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1877   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1878   define variable v-diasize-current-frame-height as decimal   no-undo .
     1879   define variable v-diasize-change-size          as logical   no-undo .
     1880   define variable v-diasize-resize-button        as handle    no-undo .
     1881   define variable v-diasize-wndmax               as logical   no-undo .
     1882   define variable v-diasize-wndstore             as logical   no-undo .
     1883   define variable v-diasize-proc-name            as character no-undo .
     1884   define variable v-diasize-browse-handle        as handle    no-undo .
     1885   define variable v-diasize-browse-number        as integer   no-undo .
     1886   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1887   define temp-table temp-diasize-handle no-undo
     1888     field handle-value  as handle
     1889     field save-position as decimal
     1890     index xpk is primary unique handle-value
     1891     .
     1892   define temp-table temp-browse-handle no-undo
     1893     field browse-type   as character
     1894     field browse-number as integer
     1895     field browse-handle as handle
     1896     field original-size as decimal
     1897     index xpk is primary unique browse-type browse-number
     1898     index xie browse-type browse-handle
     1899   .
     1900   procedure diasize_change-height :
     1901     define input  parameter p-change-value  as decimal   no-undo .
     1902     define input  parameter p-move-resize   as logical   no-undo .
     1903     define variable v-field-group-handle    as handle    no-undo .
     1904     define variable v-object-handle         as handle    no-undo .
     1905     define variable v-frame-height          as decimal   no-undo .
     1906     define variable v-frame-virtual-height  as decimal   no-undo .
     1907     define variable v-browse-height         as decimal   no-undo .
     1908     define variable v-window-height         as decimal   no-undo .
     1909     define variable v-window-virtual-height as decimal   no-undo .
     1910     define variable v-change-sign           as integer   no-undo .
     1911     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1912     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1913     if p-change-value > 0
     1914     then do:
     1915       if frame Dialog-Frame :height + p-change-value
     1916           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1917       then do:
     1918         assign
     1919           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1920                           - (frame Dialog-Frame :height-chars)
     1921         .
     1922         if p-change-value <= 0
     1923         then do:
     1924           run diasize_position-resize-button in this-procedure .
     1925           return .
     1926         end.
     1927       end.
     1928     end.
     1929     if p-change-value < 0
     1930     then do:
     1931       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1932       then do:
     1933         assign
     1934           p-change-value = v-diasize-orig-frame-height
     1935                          - (frame Dialog-Frame :height-chars)
     1936         .
     1937         if p-change-value >= 0
     1938         then do:
     1939           run diasize_position-resize-button in this-procedure .
     1940           return .
     1941         end.
     1942       end.
     1943     end.
     1944     if p-change-value >= 0
     1945     then do:
     1946       assign
     1947         v-change-sign = 1
     1948       .
     1949     end.
     1950     else do:
     1951       assign
     1952         v-change-sign = -1
     1953       .
     1954     end.
     1955     assign
     1956       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1957     .
     1958     if p-change-value = 0
     1959     then do:
     1960       run diasize_position-resize-button in this-procedure .
     1961       return .
     1962     end.
     1963     move_block:
     1964     do
     1965     on error undo move_block, retry move_block
     1966     :
     1967       if retry
     1968       then do:
     1969         do
     1970         on error undo move_block, leave move_block
     1971         :
     1972           if p-change-value > 0
     1973           then do:
     1974             for each buf_temp-diasize-handle
     1975             on error undo, next
     1976             :
     1977               assign
     1978                 v-object-handle = buf_temp-diasize-handle.handle-value
     1979               .
     1980               if v-object-handle <> v-diasize-resize-button
     1981               then do:
     1982                 assign
     1983                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1984                 .
     1985               end.
     1986             end.
     1987             assign
     1988               v-diasize-browse-handle :height = v-browse-height
     1989             .
     1990             for each buf_temp-browse-handle
     1991               where buf_temp-browse-handle.browse-type = 'height':u
     1992             on error undo, next
     1993             :
     1994               assign
     1995                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1996               .
     1997             end.
     1998             assign
     1999               frame Dialog-Frame :height = v-frame-height
     2000             .
     2001             if frame Dialog-Frame :scrollable = true
     2002             then do:
     2003               assign
     2004                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     2005               .
     2006             end.
     2007             run diasize_position-resize-button in this-procedure .
     2008           end.
     2009           else do:
     2010             if frame Dialog-Frame :scrollable = true
     2011             then do:
     2012               assign
     2013                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     2014               .
     2015             end.
     2016             assign
     2017               frame Dialog-Frame :height = v-frame-height
     2018             .
     2019             assign
     2020               v-diasize-browse-handle :height = v-browse-height
     2021             .
     2022             for each buf_temp-browse-handle
     2023               where buf_temp-browse-handle.browse-type = 'height':u
     2024             on error undo, next
     2025             :
     2026               assign
     2027                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2028               .
     2029             end.
     2030             for each buf_temp-diasize-handle
     2031             on error undo, next
     2032             :
     2033               assign
     2034                 v-object-handle = buf_temp-diasize-handle.handle-value
     2035               .
     2036               if v-object-handle <> v-diasize-resize-button
     2037               then do:
     2038                 assign
     2039                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2040                 .
     2041               end.
     2042             end.
     2043             run diasize_position-resize-button in this-procedure .
     2044           end.
     2045           assign
     2046             v-diasize-change-size = false
     2047           .
     2048           leave move_block .
     2049         end.
     2050       end.
     2051       assign
     2052         v-diasize-need-full-display = true
     2053       .
     2054       if v-diasize-change-size = false
     2055       then do:
     2056         assign
     2057           v-diasize-change-size = true
     2058         .
     2059       end.
     2060       else do:
     2061         return .
     2062       end.
     2063       assign
     2064         v-frame-height = frame Dialog-Frame :height
     2065         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     2066         v-browse-height = v-diasize-browse-handle :height
     2067       .
     2068       for each buf_temp-browse-handle
     2069         where buf_temp-browse-handle.browse-type = 'height':u
     2070       :
     2071         assign
     2072           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     2073         .
     2074       end.
     2075       for each buf_temp-diasize-handle
     2076       :
     2077         delete buf_temp-diasize-handle .
     2078       end.
     2079       assign
     2080         v-field-group-handle = frame Dialog-Frame :first-child
     2081       .
     2082       do while valid-handle(v-field-group-handle)
     2083       :
     2084         assign
     2085           v-object-handle = v-field-group-handle :first-child
     2086         .
     2087         do while valid-handle(v-object-handle)
     2088         :
     2089           if  v-object-handle <> v-diasize-browse-handle :handle
     2090           and can-query(v-object-handle, "row")
     2091           and can-query(v-object-handle, "height")
     2092           and ( v-object-handle :row > v-diasize-browse-handle :row )
     2093           then do:
     2094             find first buf_temp-browse-handle
     2095               where buf_temp-browse-handle.browse-type   = 'height':u
     2096                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2097               no-error .
     2098             if available buf_temp-browse-handle
     2099             then do:
     2100             end.
     2101             else do:
     2102               create buf_temp-diasize-handle .
     2103               assign
     2104                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2105                 buf_temp-diasize-handle.save-position = v-object-handle :row
     2106               .
     2107             end.
     2108           end.
     2109           assign
     2110             v-object-handle = v-object-handle :next-sibling
     2111           .
     2112         end.
     2113         assign
     2114           v-field-group-handle = v-field-group-handle :next-sibling
     2115         .
     2116       end.
     2117       do with frame Dialog-Frame
     2118       :
     2119         hide v-diasize-resize-button .
     2120         assign
     2121           v-diasize-resize-button :row    = 1
     2122           v-diasize-resize-button :column = 1
     2123         .
     2124       end.
     2125       if p-change-value > 0
     2126       then do:
     2127         if frame Dialog-Frame :scrollable = true
     2128         then do:
     2129           assign
     2130             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2131             no-error .
     2132           if error-status :error
     2133           or error-status :get-message(1) <> ""
     2134           then do:
     2135             undo move_block, retry move_block .
     2136           end.
     2137         end.
     2138         assign
     2139           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2140           no-error .
     2141         if error-status :error
     2142         or error-status :get-message(1) <> ""
     2143         then do:
     2144           undo move_block, retry move_block .
     2145         end.
     2146         assign
     2147           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2148           no-error .
     2149         if error-status :error
     2150         or error-status :get-message(1) <> ""
     2151         then do:
     2152           undo move_block, retry move_block .
     2153         end.
     2154         for each buf_temp-browse-handle
     2155           where buf_temp-browse-handle.browse-type = 'height':u
     2156         on error undo move_block, retry move_block
     2157         :
     2158           assign
     2159             buf_temp-browse-handle.browse-handle :height
     2160               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2161             no-error .
     2162           if error-status :error
     2163           or error-status :get-message(1) <> ""
     2164           then do:
     2165             undo move_block, retry move_block .
     2166           end.
     2167         end.
     2168         for each buf_temp-diasize-handle
     2169         on error undo move_block, retry move_block
     2170         :
     2171           assign
     2172             v-object-handle = buf_temp-diasize-handle.handle-value
     2173           .
     2174           if v-object-handle <> v-diasize-resize-button
     2175           then do:
     2176             assign
     2177               v-object-handle :row = v-object-handle :row + p-change-value
     2178               no-error .
     2179             if error-status :error
     2180             or error-status :get-message(1) <> ""
     2181             then do:
     2182               undo move_block, retry move_block .
     2183             end.
     2184           end.
     2185         end.
     2186       end.
     2187       else do:
     2188         for each buf_temp-diasize-handle
     2189         on error undo move_block, retry move_block
     2190         :
     2191           assign
     2192             v-object-handle = buf_temp-diasize-handle.handle-value
     2193           .
     2194           if v-object-handle <> v-diasize-resize-button
     2195           then do:
     2196             assign
     2197               v-object-handle :row = v-object-handle :row + p-change-value
     2198               no-error .
     2199             if error-status :error
     2200             or error-status :get-message(1) <> ""
     2201             then do:
     2202               undo move_block, retry move_block .
     2203             end.
     2204           end.
     2205         end.
     2206         assign
     2207           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2208           no-error .
     2209         if error-status :error
     2210         or error-status :get-message(1) <> ""
     2211         then do:
     2212           undo move_block, retry move_block .
     2213         end.
     2214         for each buf_temp-browse-handle
     2215           where buf_temp-browse-handle.browse-type = 'height':u
     2216         on error undo move_block, retry move_block
     2217         :
     2218           assign
     2219             buf_temp-browse-handle.browse-handle :height
     2220               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2221             no-error .
     2222           if error-status :error
     2223           or error-status :get-message(1) <> ""
     2224           then do:
     2225             undo move_block, retry move_block .
     2226           end.
     2227         end.
     2228         assign
     2229           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2230           no-error .
     2231         if error-status :error
     2232         or error-status :get-message(1) <> ""
     2233         then do:
     2234           undo move_block, retry move_block .
     2235         end.
     2236         if frame Dialog-Frame :scrollable = true
     2237         then do:
     2238           assign
     2239             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2240             no-error .
     2241           if error-status :error
     2242           or error-status :get-message(1) <> ""
     2243           then do:
     2244             undo move_block, retry move_block .
     2245           end.
     2246         end.
     2247       end.
     2248       if p-move-resize = true
     2249       then do:
     2250         run diasize_position-resize-button in this-procedure .
     2251       end.
     2252       if v-diasize-wndstore = true
     2253       then do:
     2254         if connected("ub") = true
     2255         then do:
     2256           define variable v-cntxt-db-num        as integer   no-undo .
     2257           define variable v-cntxt-userid        as character no-undo .
     2258           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2259                                             , OUTPUT v-cntxt-userid
     2260                                             ) .
     2261           run gbl/wndsizew.p
     2262             (input  v-cntxt-db-num
     2263             ,input  v-cntxt-userid
     2264             ,input  v-diasize-proc-name
     2265             ,input  'height':u
     2266             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     2267             ) .
     2268         end.
     2269       end.
     2270     end.
     2271     assign
     2272       v-diasize-change-size = false
     2273     .
     2274   end procedure.
     2275   procedure diasize_set-height :
     2276     define input  parameter p-new-height  as decimal   no-undo .
     2277     define input  parameter p-move-resize as logical   no-undo .
     2278     do
     2279     on error undo, return error return-value
     2280     :
     2281       run diasize_change-height in this-procedure
     2282         (input  (p-new-height - frame Dialog-Frame :height)
     2283         ,input  p-move-resize
     2284         ) .
     2285     end.
     2286   end procedure.
     2287   procedure diasize_change-width :
     2288     define input  parameter p-change-value as decimal   no-undo .
     2289     define input  parameter p-move-resize  as logical   no-undo .
     2290     define variable v-field-group-handle   as handle    no-undo .
     2291     define variable v-object-handle        as handle    no-undo .
     2292     define variable v-frame-width          as decimal   no-undo .
     2293     define variable v-frame-virtual-width  as decimal   no-undo .
     2294     define variable v-browse-width         as decimal   no-undo .
     2295     define variable v-window-width         as decimal   no-undo .
     2296     define variable v-window-virtual-width as decimal   no-undo .
     2297     define variable v-change-sign          as integer   no-undo .
     2298     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2299     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2300     if p-change-value > 0
     2301     then do:
     2302       if frame Dialog-Frame :width + p-change-value >
     2303           session :width-chars
     2304       then do:
     2305         assign
     2306           p-change-value = session :width-chars - frame Dialog-Frame :width
     2307         .
     2308         if p-change-value <= 0
     2309         then do:
     2310           run diasize_position-resize-button in this-procedure .
     2311           return .
     2312         end.
     2313       end.
     2314     end.
     2315     if p-change-value < 0
     2316     then do:
     2317       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     2318       then do:
     2319         assign
     2320           p-change-value = v-diasize-orig-frame-width
     2321                          - frame Dialog-Frame :width
     2322         .
     2323         if p-change-value >= 0
     2324         then do:
     2325           run diasize_position-resize-button in this-procedure .
     2326           return .
     2327         end.
     2328       end.
     2329     end.
     2330     if p-change-value >= 0
     2331     then do:
     2332       assign
     2333         v-change-sign = 1
     2334       .
     2335     end.
     2336     else do:
     2337       assign
     2338         v-change-sign = -1
     2339       .
     2340     end.
     2341     assign
     2342       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2343     .
     2344     if p-change-value = 0
     2345     then do:
     2346       run diasize_position-resize-button in this-procedure .
     2347       return .
     2348     end.
     2349     move_block:
     2350     do
     2351     on error undo move_block, leave move_block
     2352     :
     2353       if retry
     2354       then do:
     2355         do
     2356         on error undo move_block, leave move_block
     2357         :
     2358           if p-change-value > 0
     2359           then do:
     2360             for each buf_temp-diasize-handle
     2361             on error undo, next
     2362             :
     2363               assign
     2364                 v-object-handle = buf_temp-diasize-handle.handle-value
     2365               .
     2366               if v-object-handle <> v-diasize-resize-button
     2367               then do:
     2368                 assign
     2369                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2370                 .
     2371               end.
     2372             end.
     2373             assign
     2374               v-diasize-browse-handle :width = v-browse-width
     2375             .
     2376             for each buf_temp-browse-handle
     2377               where buf_temp-browse-handle.browse-type = 'width':u
     2378             on error undo, next
     2379             :
     2380               assign
     2381                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2382               .
     2383             end.
     2384             assign
     2385               frame Dialog-Frame :width = v-frame-width
     2386             .
     2387             if frame Dialog-Frame :scrollable = true
     2388             then do:
     2389               assign
     2390                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2391               .
     2392             end.
     2393             run diasize_position-resize-button in this-procedure .
     2394           end.
     2395           else do:
     2396             if frame Dialog-Frame :scrollable = true
     2397             then do:
     2398               assign
     2399                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2400               .
     2401             end.
     2402             assign
     2403               frame Dialog-Frame :width = v-frame-width
     2404             .
     2405             for each buf_temp-browse-handle
     2406               where buf_temp-browse-handle.browse-type = 'width':u
     2407             on error undo, next
     2408             :
     2409               assign
     2410                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2411               .
     2412             end.
     2413             assign
     2414               v-diasize-browse-handle :width = v-browse-width
     2415             .
     2416             for each buf_temp-diasize-handle
     2417             on error undo, next
     2418             :
     2419               assign
     2420                 v-object-handle = buf_temp-diasize-handle.handle-value
     2421               .
     2422               if v-object-handle <> v-diasize-resize-button
     2423               then do:
     2424                 assign
     2425                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2426                 .
     2427               end.
     2428             end.
     2429             run diasize_position-resize-button in this-procedure .
     2430           end.
     2431           assign
     2432             v-diasize-change-size = false
     2433           .
     2434           leave move_block .
     2435         end.
     2436       end.
     2437       assign
     2438         v-diasize-need-full-display = true
     2439       .
     2440       if v-diasize-change-size = false
     2441       then do:
     2442         assign
     2443           v-diasize-change-size = true
     2444         .
     2445       end.
     2446       else do:
     2447         return .
     2448       end.
     2449       assign
     2450         v-frame-width = frame Dialog-Frame :width
     2451         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     2452         v-browse-width = v-diasize-browse-handle :width
     2453       .
     2454       for each buf_temp-browse-handle
     2455         where buf_temp-browse-handle.browse-type = 'width':u
     2456       :
     2457         assign
     2458           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2459         .
     2460       end.
     2461       for each buf_temp-diasize-handle
     2462       :
     2463         delete buf_temp-diasize-handle .
     2464       end.
     2465       assign
     2466         v-field-group-handle = frame Dialog-Frame :first-child
     2467       .
     2468       do while valid-handle(v-field-group-handle)
     2469       :
     2470         assign
     2471           v-object-handle = v-field-group-handle :first-child
     2472         .
     2473         do while valid-handle(v-object-handle)
     2474         :
     2475           if  v-object-handle <> v-diasize-browse-handle :handle
     2476           and v-object-handle <> v-diasize-resize-button
     2477           and can-query(v-object-handle, "row")
     2478           and can-query(v-object-handle, "height")
     2479           and ( v-object-handle :col + v-object-handle :width
     2480                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2481               )
     2482           then do:
     2483             find first buf_temp-browse-handle
     2484               where buf_temp-browse-handle.browse-type   = 'width':u
     2485                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2486               no-error .
     2487             if available buf_temp-browse-handle
     2488             then do:
     2489             end.
     2490             else do:
     2491               create buf_temp-diasize-handle .
     2492               assign
     2493                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2494                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2495               .
     2496             end.
     2497           end.
     2498           assign
     2499             v-object-handle = v-object-handle :next-sibling
     2500           .
     2501         end.
     2502         assign
     2503           v-field-group-handle = v-field-group-handle :next-sibling
     2504         .
     2505       end.
     2506       do with frame Dialog-Frame
     2507       :
     2508         hide v-diasize-resize-button .
     2509         v-diasize-resize-button :row = 1.
     2510         v-diasize-resize-button :column = 1.
     2511       end.
     2512       if p-change-value > 0
     2513       then do:
     2514         if frame Dialog-Frame :scrollable = true
     2515         then do:
     2516           assign
     2517             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2518             no-error .
     2519           if error-status :error
     2520           or error-status :get-message(1) <> ""
     2521           then do:
     2522             undo move_block, retry move_block.
     2523           end.
     2524         end.
     2525         assign
     2526           frame Dialog-Frame :width = v-frame-width + p-change-value
     2527           no-error .
     2528         if error-status :error
     2529         or error-status :get-message(1) <> ""
     2530         then do:
     2531           undo move_block, retry move_block.
     2532         end.
     2533         assign
     2534           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2535         no-error .
     2536         if error-status :error
     2537         or error-status :get-message(1) <> ""
     2538         then do:
     2539           undo move_block, retry move_block.
     2540         end.
     2541         for each buf_temp-browse-handle
     2542           where buf_temp-browse-handle.browse-type = 'width':u
     2543         on error undo move_block, retry move_block
     2544         :
     2545           assign
     2546             buf_temp-browse-handle.browse-handle :width
     2547               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2548             no-error .
     2549           if error-status :error
     2550           or error-status :get-message(1) <> ""
     2551           then do:
     2552             undo move_block, retry move_block .
     2553           end.
     2554         end.
     2555         for each buf_temp-diasize-handle
     2556         on error undo move_block, retry move_block
     2557         :
     2558           assign
     2559             v-object-handle = buf_temp-diasize-handle.handle-value
     2560           .
     2561           if v-object-handle <> v-diasize-resize-button
     2562           then do:
     2563             assign
     2564               v-object-handle :col = v-object-handle :col + p-change-value
     2565               no-error .
     2566             if error-status :error
     2567             or error-status :get-message(1) <> ""
     2568             then do:
     2569               undo move_block, retry move_block .
     2570             end.
     2571           end.
     2572         end.
     2573       end.
     2574       else do:
     2575         for each buf_temp-diasize-handle
     2576         on error undo move_block, retry move_block
     2577         :
     2578           assign
     2579             v-object-handle = buf_temp-diasize-handle.handle-value
     2580           .
     2581           if v-object-handle <> v-diasize-resize-button
     2582           then do:
     2583             assign
     2584               v-object-handle :col = v-object-handle :col + p-change-value
     2585               no-error .
     2586             if error-status :error
     2587             or error-status :get-message(1) <> ""
     2588             then do:
     2589               undo move_block, retry move_block .
     2590             end.
     2591           end.
     2592         end.
     2593         for each buf_temp-browse-handle
     2594           where buf_temp-browse-handle.browse-type = 'width':u
     2595         on error undo move_block, retry move_block
     2596         :
     2597           assign
     2598             buf_temp-browse-handle.browse-handle :width
     2599               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2600             no-error .
     2601           if error-status :error
     2602           or error-status :get-message(1) <> ""
     2603           then do:
     2604             undo move_block, retry move_block .
     2605           end.
     2606         end.
     2607         assign
     2608           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2609           no-error .
     2610         if error-status :error
     2611         or error-status :get-message(1) <> ""
     2612         then do:
     2613           undo move_block, retry move_block.
     2614         end.
     2615         assign
     2616           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2617         no-error .
     2618         if error-status :error
     2619         or error-status :get-message(1) <> ""
     2620         then do:
     2621           undo move_block, retry move_block.
     2622         end.
     2623         if frame Dialog-Frame :scrollable = true
     2624         then do:
     2625           assign
     2626             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2627           no-error .
     2628           if error-status :error
     2629           or error-status :get-message(1) <> ""
     2630           then do:
     2631             undo move_block, retry move_block.
     2632           end.
     2633         end.
     2634       end.
     2635       if p-move-resize
     2636       then do:
     2637         run diasize_position-resize-button in this-procedure .
     2638       end.
     2639       if v-diasize-wndstore = true
     2640       then do:
     2641         if connected("ub") = true
     2642         then do:
     2643           define variable v-cntxt-db-num        as integer   no-undo .
     2644           define variable v-cntxt-userid        as character no-undo .
     2645           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2646                                             , OUTPUT v-cntxt-userid
     2647                                             ) .
     2648           run gbl/wndsizew.p
     2649             (input  v-cntxt-db-num
     2650             ,input  v-cntxt-userid
     2651             ,input  v-diasize-proc-name
     2652             ,input  'width':u
     2653             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2654             ) .
     2655         end.
     2656       end.
     2657     end.
     2658     assign
     2659       v-diasize-change-size = false
     2660     .
     2661   end procedure.
     2662   procedure diasize_set-width :
     2663     define input  parameter p-new-width  as decimal   no-undo .
     2664     define input  parameter p-move-resize as logical   no-undo .
     2665     do
     2666     on error undo, return error return-value
     2667     :
     2668       run diasize_change-width in this-procedure
     2669         (input  (p-new-width - frame Dialog-Frame :width)
     2670         ,input  p-move-resize
     2671         ) .
     2672     end.
     2673   end procedure.
     2674   procedure diasize_position-resize-button :
     2675     do with frame Dialog-Frame
     2676     :
     2677       hide v-diasize-resize-button .
     2678       assign
     2679         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2680                     - 1
     2681                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2682         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2683                     - 1
     2684                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2685       .
     2686       view v-diasize-resize-button .
     2687     end.
     2688   end procedure.
     2689   on alt-right anywhere
     2690   do:
     2691     run diasize_change-width in this-procedure
     2692       (input 1
     2693       ,input true
     2694       ) .
     2695     return no-apply .
     2696   end.
     2697   on alt-left anywhere
     2698   do:
     2699     run diasize_change-width in this-procedure
     2700       (input -1
     2701       ,input true
     2702       ) .
     2703     return no-apply .
     2704   end.
     2705   on alt-down anywhere
     2706   do:
     2707     run diasize_change-height in this-procedure
     2708       (input 1
     2709       ,input true
     2710       ) .
     2711     return no-apply .
     2712   end.
     2713   on alt-up anywhere
     2714   do:
     2715     run diasize_change-height in this-procedure
     2716       (input -1
     2717       ,input true
     2718       ) .
     2719     return no-apply .
     2720   end.
     2721   on alt-enter of frame Dialog-Frame
     2722   do:
     2723     run diasize_maximize in this-procedure
     2724       (input  ?
     2725       ).
     2726     return no-apply .
     2727   end.
     2728   procedure diasize_end-move :
     2729     do
     2730     on error undo, return error return-value
     2731     :
     2732       define variable v-row-delta as decimal   no-undo .
     2733       define variable v-col-delta as decimal   no-undo .
     2734       define variable v-new-row as decimal   no-undo .
     2735       define variable v-new-col as decimal   no-undo .
     2736       assign
     2737         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2738         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2739       .
     2740       assign
     2741         v-row-delta = v-new-row - frame Dialog-Frame :height
     2742         v-col-delta = v-new-col - frame Dialog-Frame :width
     2743       .
     2744       run diasize_change-height in this-procedure
     2745         (input v-row-delta
     2746         ,input true
     2747         ) .
     2748       run diasize_change-width in this-procedure
     2749         (input v-col-delta
     2750         ,input true
     2751         ) .
     2752     end.
     2753   end procedure.
     2754   procedure diasize_maximize :
     2755     define input  parameter p-action as logical   no-undo .
     2756     do
     2757     on error undo, return error return-value
     2758     :
     2759       if p-action = ?
     2760       then do:
     2761         if v-diasize-need-maximize = true
     2762         then do:
     2763           assign
     2764             p-action = true
     2765           .
     2766         end.
     2767         else do:
     2768           assign
     2769             p-action = false
     2770           .
     2771         end.
     2772       end.
     2773       if p-action = true
     2774       then do:
     2775         run diasize_change-height in this-procedure
     2776           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2777               - frame Dialog-Frame :height-chars
     2778           ,input true
     2779           ) .
     2780         run diasize_change-width in this-procedure
     2781           (input session :width-chars
     2782               - frame Dialog-Frame :width-chars
     2783           ,input true
     2784           ) .
     2785         assign
     2786           v-diasize-need-maximize = false
     2787         .
     2788       end.
     2789       else do:
     2790         run diasize_change-width in this-procedure
     2791           (input v-diasize-orig-frame-width
     2792               - frame Dialog-Frame :width-chars
     2793           ,input true
     2794           ) .
     2795         run diasize_change-height in this-procedure
     2796           (input v-diasize-orig-frame-height
     2797               - frame Dialog-Frame :height-chars
     2798           ,input true
     2799           ) .
     2800         assign
     2801           v-diasize-need-maximize = true
     2802         .
     2803       end.
     2804     end.
     2805   end procedure.
     2806   procedure diasize_restore-orig-size :
     2807     do
     2808     on error undo, return error return-value
     2809     :
     2810       assign
     2811         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2812         v-diasize-current-frame-height = frame Dialog-Frame :height
     2813       .
     2814       run diasize_set-height in this-procedure
     2815         (input  v-diasize-orig-frame-height
     2816         ,input  true
     2817         ) .
     2818       run diasize_set-width in this-procedure
     2819         (input  v-diasize-orig-frame-width
     2820         ,input  true
     2821         ) .
     2822     end.
     2823   end procedure.
     2824   procedure diasize_restore-current-size :
     2825     do
     2826     on error undo, return error return-value
     2827     :
     2828       run diasize_set-height in this-procedure
     2829         (input  v-diasize-current-frame-height
     2830         ,input  true
     2831         ) .
     2832       run diasize_set-width in this-procedure
     2833         (input  v-diasize-current-frame-width
     2834         ,input  true
     2835         ) .
     2836     end.
     2837   end procedure.
     2838   procedure diasize_set-browse-handle :
     2839     define input  parameter p-browse-handle as handle   no-undo .
     2840     define buffer buf_temp-browse-handle for temp-browse-handle .
     2841     do
     2842     on error undo, return error return-value
     2843     :
     2844       assign
     2845         v-diasize-browse-handle = p-browse-handle
     2846       .
     2847       for each buf_temp-browse-handle
     2848       on error undo, return error return-value
     2849       :
     2850         delete buf_temp-browse-handle .
     2851       end.
     2852     end.
     2853   end procedure.
     2854   procedure diasize_add_browse :
     2855     define input  parameter p-browse-type   as character no-undo .
     2856     define input  parameter p-browse-handle as handle    no-undo .
     2857     define buffer buf_temp-browse-handle for temp-browse-handle .
     2858     do
     2859     on error undo, return error return-value
     2860     :
     2861       assign
     2862         v-diasize-browse-number = v-diasize-browse-number + 1
     2863       .
     2864       create buf_temp-browse-handle .
     2865       assign
     2866         buf_temp-browse-handle.browse-type   = p-browse-type
     2867         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2868         buf_temp-browse-handle.browse-handle = p-browse-handle
     2869       .
     2870     end.
     2871   end procedure.
     2872   procedure diasize_init :
     2873     define variable v-default-value    as logical   no-undo .
     2874     define variable v-restore-saved    as logical   no-undo .
     2875     define variable v-resize-value-str as character no-undo .
     2876     do
     2877     on error undo, return error return-value
     2878     :
     2879       do with frame Dialog-Frame
     2880       :
     2881         assign
     2882           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2883           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2884           v-diasize-browse-handle     = browse BROWSE-AM :handle
     2885         .
     2886         create button v-diasize-resize-button
     2887         assign
     2888           parent        = frame Dialog-Frame :first-child
     2889           label         = "s"
     2890           height-pixels = 16
     2891           width-pixels  = 16
     2892           visible       = true
     2893           sensitive     = true
     2894           movable       = true
     2895           triggers:
     2896             on end-move persistent run diasize_end-move in this-procedure .
     2897           end triggers.
     2898         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2899         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2900         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2901         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2902         assign
     2903           v-diasize-wndmax = false
     2904         .
     2905         if connected("ub") = true
     2906         then do:
     2907           define variable v-cntxt-db-num        as integer   no-undo .
     2908           define variable v-cntxt-userid        as character no-undo .
     2909           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2910                                             , OUTPUT v-cntxt-userid
     2911                                             ) .
     2912           run gbl/wndpar_r.p
     2913             (input  v-cntxt-db-num
     2914             ,input  v-cntxt-userid
     2915             ,input  'wndmax':U
     2916             ,output v-diasize-wndmax
     2917             ,output v-default-value
     2918             ) .
     2919         end.
     2920         assign
     2921           v-diasize-wndstore = false
     2922         .
     2923         if connected("ub") = true
     2924         then do:
     2925           run gbl/wndpar_r.p
     2926             (input  v-cntxt-db-num
     2927             ,input  v-cntxt-userid
     2928             ,input  'wndstore':U
     2929             ,output v-diasize-wndstore
     2930             ,output v-default-value
     2931             ) .
     2932         end.
     2933         assign
     2934           v-diasize-proc-name = entry(1, program-name(2), '.')
     2935         .
     2936         if v-diasize-wndstore = true
     2937         then do:
     2938           assign
     2939             v-restore-saved = false
     2940           .
     2941           if connected("ub") = true
     2942           then do:
     2943             run gbl/wndsizer.p
     2944               (input  v-cntxt-db-num
     2945               ,input  v-cntxt-userid
     2946               ,input  v-diasize-proc-name
     2947               ,input  'height':u
     2948               ,output v-resize-value-str
     2949               ) .
     2950             if v-resize-value-str <> '':U
     2951             then do:
     2952               run diasize_change-height in this-procedure
     2953                 (input  integer(v-resize-value-str)
     2954                 ,input  true
     2955                 ) .
     2956               assign
     2957                 v-restore-saved = true
     2958               .
     2959             end.
     2960           end.
     2961           if connected("ub") = true
     2962           then do:
     2963             run gbl/wndsizer.p
     2964               (input  v-cntxt-db-num
     2965               ,input  v-cntxt-userid
     2966               ,input  v-diasize-proc-name
     2967               ,input  'width':u
     2968               ,output v-resize-value-str
     2969               ) .
     2970             if v-resize-value-str <> '':U
     2971             then do:
     2972               run diasize_change-width in this-procedure
     2973                 (input  integer(v-resize-value-str)
     2974                 ,input  true
     2975                 ) .
     2976               assign
     2977                 v-restore-saved = true
     2978               .
     2979             end.
     2980           end.
     2981           if v-restore-saved <> true
     2982           then do:
     2983             if v-diasize-wndmax = true
     2984             then do:
     2985               run diasize_maximize in this-procedure
     2986                 (input  true
     2987                 ) .
     2988             end.
     2989           end.
     2990         end.
     2991         else do:
     2992           if v-diasize-wndmax = true
     2993           then do:
     2994             run diasize_maximize in this-procedure
     2995               (input  true
     2996               ) .
     2997           end.
     2998         end.
     2999       end.
     3000     end.
     3001   end procedure.
     3002   procedure diasize_need-full-display :
     3003     define output parameter p-need-full-display as logical   no-undo .
     3004     do
     3005     on error undo, return error return-value
     3006     :
     3007       assign
     3008         p-need-full-display = v-diasize-need-full-display
     3009       .
     3010       assign
     3011         v-diasize-need-full-display = false
     3012       .
     3013     end.
     3014   end procedure.
     3015   procedure get-context :
     3016      define output parameter p-db-num as integer          no-undo.
     3017      define output parameter p-user-id as character        no-undo.
     3018      define variable v-login               as character    no-undo.
     3019      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     3020      define buffer buf_user-login  for ub.user-login .
     3021      do
     3022      on error undo, return error
     3023      :
     3024            FIND FIRST buf_sys-ctrl no-lock.
     3025            ASSIGN
     3026               v-login = USERID("ub")
     3027               p-db-num = buf_sys-ctrl.db-num
     3028            .
     3029            FIND FIRST buf_user-login
     3030                 WHERE buf_user-login.db-num = p-db-num
     3031                   AND buf_user-login.user-login = v-login
     3032                 no-lock
     3033                 no-error
     3034                 .
     3035            IF AVAILABLE buf_user-login
     3036            THEN DO:
     3037               assign
     3038                  p-user-id = buf_user-login.user-id
     3039               .
     3040            END.
     3041      end.
     3042   end procedure.
     3043       run diasize_init in this-procedure .
     3044   def var sort-labelBROWSE-AM   as character no-undo .
     3045   def var sort-clmnBROWSE-AM    as handle    no-undo .
     3046   def var cur-clmnBROWSE-AM     as handle    no-undo .
     3047   def var cur-clmn-locBROWSE-AM as integer   no-undo .
     3048   def var re-queryBROWSE-AM     as logical   initial no no-undo .
     3049   on start-search, ctrl-o of BROWSE-AM in frame Dialog-Frame do:
     3050      run sort-brBROWSE-AM
     3051        (input (if available buf_Matrix
     3052                then recid(buf_Matrix)
     3053                else ?
     3054               )
     3055        ).
     3056   end.
     3057   PROCEDURE sort-brBROWSE-AM :
     3058     define input parameter p-recid as recid no-undo .
     3059     if re-queryBROWSE-AM = no then do:
     3060       assign
     3061          cur-clmnBROWSE-AM = BROWSE-AM:current-column in frame Dialog-Frame
     3062       .
     3063       if sort-clmnBROWSE-AM <> ? then sort-clmnBROWSE-AM:column-fgcolor = 0.
     3064       if cur-clmnBROWSE-AM = sort-clmnBROWSE-AM then do:
     3065         assign
     3066            sort-labelBROWSE-AM = ""
     3067            sort-clmnBROWSE-AM = ?
     3068         .
     3069        end.
     3070        else do:
     3071          assign
     3072            sort-labelBROWSE-AM = cur-clmnBROWSE-AM:label
     3073            sort-clmnBROWSE-AM  = cur-clmnBROWSE-AM
     3074            sort-clmnBROWSE-AM:column-fgcolor = 4
     3075          .
     3076        end.
     3077      end.
     3078     assign
     3079       cur-clmn-locBROWSE-AM = 1
     3080     .
     3081     def var column-handle as handle no-undo .
     3082     column-handle = BROWSE-AM:first-column.
     3083     do while valid-handle(column-handle) :
     3084       if column-handle = cur-clmnBROWSE-AM then do:
     3085         leave .
     3086       end.
     3087       column-handle = column-handle:NEXT-COLUMN.
     3088       assign
     3089         cur-clmn-locBROWSE-AM = cur-clmn-locBROWSE-AM + 1
     3090       .
     3091     end.
     3092     case sort-labelBROWSE-AM:
     3093           when '*'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1mark-string&1, recid(buf_Matrix), &1&2&1)', chr(34), p-rid-list)     .     run OpenBr.   . END.
     3094           when 'Название'  then DO:    assign       sort-column-name = "buf_Matrix.asmt-name"     .     run OpenBr.   . END.
     3095           when 'Тип'  then DO:    assign       sort-column-name = "buf_Matrix.asmt-type"     .     run OpenBr.   . END.
     3096           when 'Объект'  then DO:    assign       sort-column-name = "buf_Matrix.obj-type + ' ' + string(buf_Matrix.obj-code,'>>>>>>>>>')"     .     run OpenBr.   . END.
     3097           when 'Дата!изменения'  then DO:    assign       sort-column-name = "buf_Matrix.asmt-date-update"     .     run OpenBr.   . END.
     3098           when 'Время'  then DO:    assign       sort-column-name = "STRING (buf_Matrix.asmt-time-update,'HH:MM')"     .     run OpenBr.   . END.
     3099           when 'Кто!изменил'  then DO:    assign       sort-column-name = "buf_Matrix.asmt-who-update"     .     run OpenBr.   . END.
     3100           when 'БД!изм'  then DO:    assign       sort-column-name = "buf_Matrix.asmt-db-num-update"     .     run OpenBr.   . END.
     3101           when 'Дата!создания'  then DO:    assign       sort-column-name = "buf_Matrix.asmt-date-create"     .     run OpenBr.   . END.
     3102           when 'Время'  then DO:    assign       sort-column-name = "STRING (buf_Matrix.asmt-time-create,'HH:MM')"     .     run OpenBr.   . END.
     3103           when 'Кто!создал'  then DO:    assign       sort-column-name = "buf_Matrix.asmt-who-create"     .     run OpenBr.   . END.
     3104           when 'БД!соз'  then DO:    assign       sort-column-name = "buf_Matrix.asmt-db-num-create"     .     run OpenBr.   . END.
     3105           when 'Статус'  then DO:    assign       sort-column-name = "entry (lookup (STRING(buf_Matrix.asmt-status), '0,1,50,99':U), 'тек,удал,блок,удаление':U)"     .     run OpenBr.   . END.
     3106           when 'Связка с!шаблоном'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1attrRootShablon&1, recid(buf_Matrix))', chr(34))     .     run OpenBr.   . END.
     3107       otherwise do:
     3108         assign
     3109           sort-column-name = ""
     3110         .
     3111         run OpenBr.
     3112         if sort-labelBROWSE-AM <> "" then do:
     3113           assign
     3114             cur-clmnBROWSE-AM:column-fgcolor = 0
     3115           .
     3116         end.
     3117         assign
     3118           cur-clmn-locBROWSE-AM = ?
     3119         .
     3120       end.
     3121     end case.
     3122     if p-recid <> ? then do:
     3123       reposition BROWSE-AM to recid p-recid no-error.
     3124       apply "value-changed" to BROWSE-AM in frame Dialog-Frame.
     3125     end.
     3126     apply "entry" to BROWSE-AM in frame Dialog-Frame.
     3127   END PROCEDURE.
     3128   procedure re-open-query-srt-clmnBROWSE-AM:
     3129   if cur-clmnBROWSE-AM = ? then do:
     3130      run OpenBr.
     3131   end.
     3132   else do:
     3133      assign re-queryBROWSE-AM = yes.
     3134      run sort-brBROWSE-AM
     3135        (input (if available buf_Matrix
     3136                then recid(buf_Matrix)
     3137                else ?
     3138               )
     3139        ).
     3140      assign re-queryBROWSE-AM = no.
     3141   end.
     3142   end.
     3143   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3144   do:
     3145     BROWSE-AM :SET-REPOSITIONED-ROW(5, "CONDITIONAL") .
     3146   end.
     3147   MAIN-BLOCK:
     3148   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     3149      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     3150   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3151   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
     3152     (output v-db-num
     3153     )  .
     3154     run my_enable in this-procedure .
     3155     hide mark-num in frame Dialog-Frame .
     3156     if v-doc-rec <> ? then
     3157     reposition BROWSE-AM to recid v-doc-rec no-error.
     3158     WAIT-FOR GO OF FRAME Dialog-Frame.
     3159   END.
     3160   run disable_ui in this-procedure .
     3161   PROCEDURE disable_UI :
     3162     HIDE FRAME Dialog-Frame.
     3163   END PROCEDURE.
     3164   PROCEDURE enable_UI :
     3165     DISPLAY RS-sts RS-type RS-object mark-num FILL-IN-1 FILL-IN-2 v-text_object-bd
     3166             v-user-name-create name-link v-user-name-corr
     3167         WITH FRAME Dialog-Frame.
     3168     IF AVAILABLE buf_matrix THEN
     3169       DISPLAY buf_matrix.asmt-des
     3170         WITH FRAME Dialog-Frame.
     3171     ENABLE b-quit I-link B-mark B-sel B-add B-lookup B-chg B-del B-Help
     3172            B-mark-all B-demark-all B-goods B-print RS-sts B-hist RS-type
     3173            RS-object BROWSE-AM buf_matrix.asmt-des mark-num FILL-IN-1 FILL-IN-2
     3174            v-text_object-bd v-user-name-create name-link v-user-name-corr
     3175         WITH FRAME Dialog-Frame.
     3176     VIEW FRAME Dialog-Frame.
     3177     OPEN QUERY BROWSE-AM FOR EACH buf_matrix NO-LOCK INDEXED-REPOSITION.
     3178   END PROCEDURE.
     3179   PROCEDURE my_enable :
     3180   define variable v-db-num like ub.db.db-num no-undo .
     3181   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3182   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
     3183     (output v-db-num
     3184     )  .
     3185   buf_Matrix.asmt-name:read-only in browse BROWSE-AM = true .
     3186   buf_Matrix.asmt-name:resizable in browse BROWSE-AM = true .
     3187   ASSIGN
     3188   rs-sts:RADIO-BUTTONS IN FRAME Dialog-Frame
     3189                 = "Текущие&+" + chr(44) +  '0':U + chr(44) +
     3190                 "Все&!" + chr(44) + 'все':U + chr(44) +
     3191                 "Удаленные&-" + chr(44) + '1':U
     3192   rs-sts = (IF p-sts = ? THEN '0':U ELSE string(p-sts))
     3193   rs-type:RADIO-BUTTONS IN FRAME Dialog-Frame
     3194                   = "Все" + chr(44) +  "1" + chr(44) +
     3195                   "Объект" + chr(44) + "2" + chr(44) +
     3196                   "Шаблон" + chr(44) + "3"
     3197   rs-object:RADIO-BUTTONS IN FRAME Dialog-Frame
     3198                   = "Своя БД" + chr(44) +  "1" + chr(44) +
     3199                     "Все БД" + chr(44) + "2"
     3200   .
     3201   if v-db-num = 0 then
     3202         assign
     3203           rs-object = "2"
     3204           rs-type = "1"
     3205         .
     3206       else
     3207         assign
     3208           rs-object = "1"
     3209           rs-type = "1"
     3210         .
     3211   if p-mode = 'Шаблон':U then do:
     3212      rs-type = "3" .
     3213      rs-type:RADIO-BUTTONS IN FRAME Dialog-Frame =   "Шаблон" + chr(44) + "3" .
     3214      display rs-type with frame Dialog-Frame .
     3215   end.
     3216   v-type-s  = 'Шаблон':U  .
     3217   v-type-o  = 'Объект':U .
     3218   if rs-type = "3" then v-type = 'Шаблон':U .
     3219   if rs-type = "2" then v-type = 'Объект':U .
     3220   rs-sts = '0':U .
     3221   DISPLAY mark-num
     3222   FILL-IN-1
     3223   FILL-IN-2
     3224   v-text_object-bd
     3225   RS-sts
     3226   RS-type
     3227   RS-object
     3228   WITH FRAME Dialog-Frame.
     3229   ENABLE
     3230   b-quit
     3231   B-mark when LOOKUP("b-mark":U, bttns) > 0
     3232   B-mark-all when LOOKUP("b-mark":U, bttns) > 0
     3233   B-demark-all when LOOKUP("b-mark":U, bttns) > 0
     3234   B-sel when LOOKUP("b-sel":U, bttns) > 0
     3235   B-add when LOOKUP("b-add":U, bttns) > 0
     3236   B-lookup
     3237   B-chg when LOOKUP("b-add":U, bttns) > 0
     3238   B-del when LOOKUP("b-add":U, bttns) > 0
     3239   B-print
     3240   B-Help
     3241   B-hist
     3242   BROWSE-AM
     3243   mark-num
     3244   RS-sts
     3245   RS-type
     3246   RS-object
     3247   b-goods
     3248   buf_matrix.asmt-des
     3249   with FRAME Dialog-Frame.
     3250   VIEW FRAME Dialog-Frame.
     3251   buf_matrix.asmt-des:READ-ONLY = TRUE.
     3252   run openbr in this-procedure no-error.
     3253   IF ERROR-STATUS:ERROR  THEN RETURN error.
     3254   END PROCEDURE.
     3255   PROCEDURE openBr :
     3256   define variable p-open-query     as logical   no-undo init true .
     3257   define variable l-query-was-opened as logical no-undo .
     3258   define variable doc-rec  as recid     no-undo .
     3259   define variable  p-find-next      as logical   no-undo .
     3260   define variable  p-find-condition as character no-undo .
     3261   ASSIGN  FRAME Dialog-Frame
     3262     rs-sts
     3263     rs-object
     3264     rs-type
     3265       .
     3266   ASSIGN
     3267     p-sts = (IF rs-sts = 'все':U THEN ? ELSE INTEGER(rs-sts))
     3268     .
     3269     if rs-type = "3" then v-type = 'Шаблон':U .
     3270     if rs-type = "2" then v-type = 'Объект':U .
     3271     if rs-type = "1" then v-type = "" .
     3272   define variable sort-column-phrase as character no-undo .
     3273   case sort-column-name :
     3274     when "" then do:
     3275       assign
     3276         sort-column-phrase = ""
     3277       .
     3278     end.
     3279     otherwise do:
     3280       assign
     3281         sort-column-phrase = "by " + sort-column-name
     3282       .
     3283     end.
     3284   end case.
     3285   define variable title0 as character no-undo init "Список Ассортиментных матриц".
     3286   IF p-sts = ? THEN DO:
     3287       frame Dialog-Frame:TITLE = title0  .
     3288       if rs-type = "1" or rs-type = "" then do:
     3289           if rs-object = "2" then do:
     3290   define variable vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3291   define variable  l-disable-where-32  as logical   no-undo .
     3292   define variable  l-filter-open-32    as logical   .
     3293   define variable  flt-rec-32       as recid     no-undo .
