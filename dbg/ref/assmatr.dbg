     3296   define variable  sort-phrase-32      as character no-undo .
     3297   define variable  where-phrase-rus-32 as character no-undo .
     3298   define variable  sort-phrase-rus-32  as character no-undo .
     3299     run waitfram-show in this-procedure
     3300       (input "ЖДИТЕ ..."
     3301       ).
     3302   run gbl/flt-get.p
     3303     (input filter-point
     3304     ,output flt-rec-32
     3305     ,output filter-name-32
     3306     ,output where-phrase-32
     3307     ,output sort-phrase-32
     3308     ,output where-phrase-rus-32
     3309     ,output sort-phrase-rus-32
     3310     ).
     3311   if p-open-query then do:
     3312       run set-filter-name in this-procedure
     3313         (INPUT filter-name-32
     3314         ) no-error .
     3315     assign
     3316       l-filter-open-32 = false
     3317     .
     3318     if flt-rec-32 <> ?
     3319       or sort-column-phrase > ""
     3320     then do:
     3321       define variable  parameter-2-32 as character no-undo .
     3322       define variable  parameter-3-32 as character no-undo .
     3323       define variable  parameter-4-32 as character no-undo .
     3324       define variable  parameter-5-32 as character no-undo .
     3325       define variable  parameter-6-32 as character no-undo .
     3326       define variable  parameter-7-32 as character no-undo .
     3327         assign
     3328         parameter-3-32 =
     3329                                 "FOR EACH buf_Matrix"
     3330         parameter-4-32 =
     3331           (
     3332             if (" true " + " " + where-phrase-32) <> ""
     3333             then  'true'  + " " + where-phrase-32
     3334             else "true"
     3335           )
     3336         parameter-5-32 = (" " + "" + " " + "")
     3337         parameter-6-32 = if sort-phrase-32 = ''
     3338                              then
     3339           (
     3340           " " + " USE-INDEX asmt-name " +
     3341             " " + sort-column-phrase +
     3342           " " + " "
     3343           )
     3344                              else
     3345           (
     3346           " " + " USE-INDEX asmt-name " +
     3347             " " + sort-column-phrase +
     3348           " " + sort-phrase-32
     3349           )
     3350         parameter-7-32 =
     3351           " indexed-reposition  "
     3352       .
     3353       do
     3354       on stop undo, leave
     3355       on error undo, leave
     3356       :
     3357         assign
     3358           l-disable-where-32 =
     3359             (" true " + " " + where-phrase-32 = "")
     3360         .
     3361         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     3362                             ,input query BROWSE-AM:handle
     3363                             ,input parameter-3-32
     3364                             ,input parameter-4-32
     3365                             ,input parameter-5-32
     3366                             ,input parameter-6-32
     3367                             ,input parameter-7-32
     3368                             )
     3369         .
     3370         assign
     3371           l-filter-open-32 = true
     3372         .
     3373       end.
     3374       if l-filter-open-32 = false then do:
     3375         message
     3376           "Ошибка при фильтрации / сортировке" skip
     3377           "Будут показаны записи без учета фильтра" skip
     3378           view-as alert-box .
     3379       end.
     3380       else do:
     3381           assign
     3382             l-query-was-opened = true
     3383           .
     3384       end.
     3385     end.
     3386     if l-filter-open-32 = false then do:
     3387       OPEN QUERY BROWSE-AM FOR EACH buf_Matrix
     3388         where  true
     3389          USE-INDEX asmt-name
     3390         indexed-reposition
     3391     .
     3392         assign
     3393           l-query-was-opened = true
     3394         .
     3395     end.
     3396   end.
     3397   else do:
     3398     assign
     3399       doc-rec = recid( buf_matrix )
     3400     .
     3401     do
     3402     on stop undo, leave
     3403     on error undo, leave
     3404     :
     3405       if query BROWSE-AM:handle:get-buffer-handle(1) = (buffer buf_Matrix:handle) then do:
     3406         assign
     3407         parameter-2-32 = (if p-find-next then "true":u else "false":u )
     3408         parameter-4-32 =
     3409           "where ":u +  'true'  + " ":u + where-phrase-32 + " ":u + p-find-condition + " " + ""
     3410         parameter-5-32 = " USE-INDEX asmt-name "
     3411       .
     3412         run fltopend_fltfindd in this-procedure  (
     3413                             input this-procedure:handle
     3414                             ,input query BROWSE-AM:handle
     3415                             ,input rowid(buf_matrix)
     3416                             ,input logical(parameter-2-32)
     3417                             ,input no-lock
     3418                             ,input (buffer buf_matrix:handle)
     3419                             ,input parameter-4-32
     3420                             ,input parameter-5-32
     3421                             ) no-error.
     3422         .
     3423         assign
     3424           doc-rec = integer(return-value)
     3425           v-fltopend-rowid[1] = ?
     3426         .
     3427       end.
     3428       else do:
     3429         assign
     3430         parameter-2-32 = (if p-find-next then "true":u else "false":u )
     3431         parameter-3-32 =  "FOR EACH buf_Matrix"
     3432         parameter-4-32 =
     3433           (
     3434             if (" true " + " " + where-phrase-32) <> ""
     3435             then  'true'  + " " + where-phrase-32
     3436             else "true"
     3437           )
     3438         parameter-5-32 = (" " + "" + " " + "" + " " + p-find-condition)
     3439         parameter-6-32 = if sort-phrase-32 = ''
     3440                              then
     3441           (
     3442           " " + " USE-INDEX asmt-name " +
     3443             " " + sort-column-phrase +
     3444           " " + " "
     3445           )
     3446                              else
     3447           (
     3448           " " + " USE-INDEX asmt-name " +
     3449             " " + sort-column-phrase +
     3450           " " + sort-phrase-32
     3451           )
     3452         parameter-7-32 =
     3453           " indexed-reposition  "
     3454       .
     3455         run fltopend_fltfindq in this-procedure  (
     3456                             input this-procedure:handle
     3457                             ,input query BROWSE-AM:handle
     3458                             ,input logical(parameter-2-32)
     3459                             ,input no-lock
     3460                             ,input parameter-3-32
     3461                             ,input parameter-4-32
     3462                             ,input parameter-5-32
     3463                             ,input parameter-6-32
     3464                             ,input parameter-7-32
     3465                             ,output v-fltopend-rowid
     3466                             ) no-error.
     3467         .
     3468         doc-rec = ?.
     3469       end.
     3470       assign
     3471         l-query-was-opened = true
     3472       .
     3473     end.
     3474   end.
     3475     run waitfram-hide in this-procedure .
     3476           end.
     3477           else do:
     3478   define variable vss-include-info33 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3479   define variable  l-disable-where-34  as logical   no-undo .
     3480   define variable  l-filter-open-34    as logical   .
     3481   define variable  flt-rec-34       as recid     no-undo .
     3482   define variable  filter-name-34      as character no-undo .
     3483   define variable  where-phrase-34     as character no-undo .
     3484   define variable  sort-phrase-34      as character no-undo .
     3485   define variable  where-phrase-rus-34 as character no-undo .
     3486   define variable  sort-phrase-rus-34  as character no-undo .
     3487     run waitfram-show in this-procedure
     3488       (input "ЖДИТЕ ..."
     3489       ).
     3490   run gbl/flt-get.p
     3491     (input filter-point
     3492     ,output flt-rec-34
     3493     ,output filter-name-34
     3494     ,output where-phrase-34
     3495     ,output sort-phrase-34
     3496     ,output where-phrase-rus-34
     3497     ,output sort-phrase-rus-34
     3498     ).
     3499   if p-open-query then do:
     3500       run set-filter-name in this-procedure
     3501         (INPUT filter-name-34
     3502         ) no-error .
     3503     assign
     3504       l-filter-open-34 = false
     3505     .
     3506     if flt-rec-34 <> ?
     3507       or sort-column-phrase > ""
     3508     then do:
     3509       define variable  parameter-2-34 as character no-undo .
     3510       define variable  parameter-3-34 as character no-undo .
     3511       define variable  parameter-4-34 as character no-undo .
     3512       define variable  parameter-5-34 as character no-undo .
     3513       define variable  parameter-6-34 as character no-undo .
     3514       define variable  parameter-7-34 as character no-undo .
     3515         assign
     3516         parameter-3-34 =
     3517                                 "FOR EACH buf_Matrix"
     3518         parameter-4-34 =
     3519           (
     3520             if (" ( buf_Matrix.db-num-obj = v-db-num  and  buf_Matrix.asmt-type = v-type-o) or ( buf_Matrix.asmt-type = v-type-s )" + " " + where-phrase-34) <> ""
     3521             then  substitute(' ( buf_Matrix.db-num-obj = &2 and  buf_Matrix.asmt-type = &1&3&1 ) or ( buf_Matrix.asmt-type = &1&4&1  ) ' , chr(34) ,v-db-num  , v-type-o , v-type-s )  + " " + where-phrase-34
     3522             else "true"
     3523           )
     3524         parameter-5-34 = (" " + "" + " " + "")
     3525         parameter-6-34 = if sort-phrase-34 = ''
     3526                              then
     3527           (
     3528           " " + " USE-INDEX asmt-name " +
     3529             " " + sort-column-phrase +
     3530           " " + " "
     3531           )
     3532                              else
     3533           (
     3534           " " + " USE-INDEX asmt-name " +
     3535             " " + sort-column-phrase +
     3536           " " + sort-phrase-34
     3537           )
     3538         parameter-7-34 =
     3539           " indexed-reposition  "
     3540       .
     3541       do
     3542       on stop undo, leave
     3543       on error undo, leave
     3544       :
