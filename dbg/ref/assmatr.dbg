     1596   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
     1597   DO:
     1598     define variable loc#log as logical no-undo .
     1599     if AVAILABLE buf_matrix  then do:
     1600   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1601   define variable v-str-recid19 as character no-undo .
     1602   define variable v-num-entry19 as integer   no-undo .
     1603   assign
     1604     v-str-recid19 = trim( string( recid( buf_matrix ) , "->>>>>>>>>>>9":U ) )
     1605     v-num-entry19 = lookup( v-str-recid19 , p-rid-list )
     1606   .
     1607   if v-num-entry19 > 0 then do:
     1608     assign
     1609       entry( v-num-entry19, p-rid-list ) = "":U
     1610       p-rid-list = trim( replace( p-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1611     .
     1612   end.
     1613   else do:
     1614     assign
     1615       p-rid-list = p-rid-list + ( if p-rid-list = "":U then "":U else chr(44) ) + v-str-recid19
     1616     .
     1617   end.
     1618       loc#log = BROWSE-AM:refresh() .
     1619       if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
     1620           loc#log = BROWSE-AM:select-next-row ().
     1621           apply "VALUE-CHANGED" to BROWSE-AM in frame Dialog-Frame.
     1622       end.
     1623       if num-entries( p-rid-list ) = 0
     1624       then
     1625           hide mark-num in frame Dialog-Frame.
     1626       else
     1627           disp num-entries( p-rid-list ) @ mark-num with frame Dialog-Frame.
     1628     end.
     1629     apply "entry" to BROWSE-AM in frame Dialog-Frame.
     1630   END.
