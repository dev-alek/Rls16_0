      828   define variable v-fltopend-rowid as rowid extent 18 no-undo .
      829   procedure fltopend_fltopend :
      830   define input parameter p-parent-handle as handle no-undo .
      831   define input parameter p-qh as handle no-undo .
      832   define input parameter p-flt-open-open-query  as character no-undo .
      833   define input parameter p-where-cond as character no-undo .
      834   define input parameter p-use-indFIRST-query-tail as character no-undo .
      835   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      836   define input parameter p-indexed-reposition as character no-undo .
      837     do
      838     on error undo, return error
      839     :
      840   define variable v-prepare-string as character no-undo .
      841   define variable glog as logical no-undo .
      842   assign
      843   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      844                      p-where-cond + chr(32)  +
      845                      p-use-indFIRST-query-tail + chr(32) +
      846                      p-use-ind-sort-clmn-by + chr(32) +
      847                      p-indexed-reposition
      848   .
      849   assign
      850   glog = p-qh:query-prepare(v-prepare-string) no-error .
      851   if not glog
      852   or error-status:error then do:
      853     message error-status:get-message(1) view-as alert-box .
      854     undo, return error .
      855   end.
      856   assign
      857   glog = p-qh:query-open no-error .
      858   if not glog
      859   or error-status:error then do:
      860     message error-status:get-message(1) view-as alert-box .
      861     undo, return error .
      862   end.
      863     end.
      864   end procedure.
      865   procedure fltopend_fltfindd :
      866   define input parameter p-parent-handle as handle no-undo .
      867   define input parameter p-qh as handle no-undo .
      868   define input parameter p-rowid as rowid no-undo .
      869   define input parameter p-next as logical no-undo .
      870   define input parameter p-lock as integer no-undo .
      871   define input parameter p-bh as handle no-undo .
      872   define input parameter p-where-cond as character no-undo .
      873   define input parameter p-use-index-phrase as character no-undo .
      874   define variable glog as logical no-undo .
      875   define variable v-qh as handle no-undo .
      876   define variable v-bh as handle no-undo .
      877   define variable v-recid as recid no-undo .
      878   define variable v-prepare-string as character no-undo .
      879   do
      880   on error undo, return error
      881   on stop undo, return error
      882   :
      883     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
      884     create buffer v-bh for table p-bh buffer-name p-bh:name.
      885     create query v-qh.
      886     v-qh:set-buffers(v-bh).
      887     v-prepare-string = substitute("for each &1 &2 &3"
      888                                     ,v-bh:name
      889                                     ,p-where-cond
      890                                     ,p-use-index-phrase).
      891     glog = v-qh:query-prepare(v-prepare-string) no-error.
      892     if not glog then do:
      893       delete object v-qh.
      894       delete object v-bh.
      895       undo, return error .
      896     end.
      897     glog = v-qh:query-open no-error .
      898     if not glog then do:
      899       delete object v-qh.
      900       delete object v-bh.
      901       undo, return error .
      902     end.
      903     if p-next then do:
      904       v-qh:reposition-to-rowid(p-rowid) no-error .
      905       glog = v-qh:get-next( p-lock) no-error .
      906       glog = v-qh:get-next( p-lock) no-error .
      907       if not glog or v-qh:query-off-end = yes then do:
      908         glog = v-qh:get-first( p-lock) no-error .
      909       end.
      910     end.
      911     else do:
      912       glog = v-qh:get-first( p-lock) no-error .
      913     end.
      914     v-recid = v-bh:recid no-error .
      915     delete object v-qh.
      916     delete object v-bh.
      917     return string(v-recid) .
      918   end.
      919   end procedure.
      920   procedure fltopend_fltfindq :
      921   define input parameter p-parent-handle as handle no-undo .
      922   define input parameter p-qh as handle no-undo .
      923   define input parameter p-next as logical no-undo .
      924   define input parameter p-lock as integer no-undo .
      925   define input parameter p-flt-open-open-query  as character no-undo .
      926   define input parameter p-where-cond as character no-undo .
      927   define input parameter p-use-indFIRST-query-tail as character no-undo .
      928   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      929   define input parameter p-indexed-reposition as character no-undo .
      930   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
      931   define variable glog as logical no-undo .
      932   define variable v-qh as handle no-undo .
      933   define variable v-bh as handle no-undo extent 18.
      934   define variable v-rowid as rowid no-undo extent 18.
      935   define variable v-ii as integer no-undo .
      936   define variable v-prepare-string as character no-undo .
      937   do
      938   on error undo, return error
      939   on stop undo, return error
      940   :
      941     create query v-qh.
      942     do v-ii = 1 to p-qh:num-buffers:
      943       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
      944       assign
      945       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
      946       no-error.
      947       v-qh:add-buffer(v-bh[v-ii]).
      948     end.
      949     assign
      950     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      951                       p-where-cond + chr(32)  +
      952                       p-use-indFIRST-query-tail + chr(32) +
      953                       p-use-ind-sort-clmn-by + chr(32) +
      954                       p-indexed-reposition
      955     .
      956     glog = v-qh:query-prepare( v-prepare-string) no-error .
      957     if not glog then do:
      958       delete object v-qh.
      959       do v-ii = 1 to p-qh:num-buffers:
      960         delete object v-bh[v-ii].
      961       end.
      962       undo, return error .
      963     end.
      964     glog = v-qh:query-open no-error .
      965     if not glog then do:
      966       delete object v-qh.
      967       do v-ii = 1 to p-qh:num-buffers:
      968         delete object v-bh[v-ii].
      969       end.
      970       undo, return error .
      971     end.
      972     if p-next then do:
      973       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
      974       glog = v-qh:get-next( p-lock) no-error .
      975       glog = v-qh:get-next( p-lock) no-error .
      976       if not glog or v-qh:query-off-end = yes then do:
      977         glog = v-qh:get-first( p-lock) no-error .
      978       end.
      979     end.
      980     else do:
      981       glog = v-qh:get-first( p-lock) no-error .
      982     end.
      983     do v-ii = 1 to p-qh:num-buffers:
      984       assign
      985       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
      986       no-error.
      987     end.
      988     delete object v-qh.
      989     do v-ii = 1 to p-qh:num-buffers:
      990       delete object v-bh[v-ii].
      991     end.
      992   end.
      993   end procedure.
      994   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      995   FUNCTION mark-string RETURNS CHARACTER
      996     ( input p-recid as recid, input mark-list as character  ) :
      997     RETURN ( IF LOOKUP( STRING( p-recid), mark-list ) > 0 THEN '*' ELSE '':U ).
      998   END FUNCTION.
