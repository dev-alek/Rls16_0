     3546           l-disable-where-34 =
     3547             (" ( buf_Matrix.db-num-obj = v-db-num  and  buf_Matrix.asmt-type = v-type-o) or ( buf_Matrix.asmt-type = v-type-s )" + " " + where-phrase-34 = "")
     3548         .
     3549         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     3550                             ,input query BROWSE-AM:handle
     3551                             ,input parameter-3-34
     3552                             ,input parameter-4-34
     3553                             ,input parameter-5-34
     3554                             ,input parameter-6-34
     3555                             ,input parameter-7-34
     3556                             )
     3557         .
     3558         assign
     3559           l-filter-open-34 = true
     3560         .
     3561       end.
     3562       if l-filter-open-34 = false then do:
     3563         message
     3564           "Ошибка при фильтрации / сортировке" skip
     3565           "Будут показаны записи без учета фильтра" skip
     3566           view-as alert-box .
     3567       end.
     3568       else do:
     3569           assign
     3570             l-query-was-opened = true
     3571           .
     3572       end.
     3573     end.
     3574     if l-filter-open-34 = false then do:
     3575       OPEN QUERY BROWSE-AM FOR EACH buf_Matrix
     3576         where  ( buf_Matrix.db-num-obj = v-db-num  and  buf_Matrix.asmt-type = v-type-o) or ( buf_Matrix.asmt-type = v-type-s )
     3577          USE-INDEX asmt-name
     3578         indexed-reposition
     3579     .
