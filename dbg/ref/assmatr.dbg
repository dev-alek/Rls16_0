     5197   do:
     5198     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     5199       (input  v-cntxt-db-num
     5200       ,input  v-cntxt-userid
     5201       ,input  0
     5202       ,input  'actn_assort-matr_deletion':U
     5203       ,input  'global':U
     5204       ,input  v-cntxt-host-code-obj
     5205       ,input  v-cntxt-obj-type
     5206       ,input  v-cntxt-obj-code
     5207       ,input  0
     5208       ,input  0
     5209       ,input  0
     5210       ,input  true
     5211       ,output loc#log
     5212       )  .
     5213   end.
     5214     if loc#log <> yes then do: return error. end.
     5215     assign
     5216     v-sts = ?
     5217     loc-doc-rec = RECID(buf_Matrix)
     5218     .
     5219     run ref/assmatr2.p (
     5220          input recid ( buf_Matrix )
     5221         ,input-output v-sts )
     5222          no-error .
     5223     if error-status:error then undo, return error.
     5224     run openbr in this-procedure .
     5225     REPOSITION BROWSE-AM to recid loc-doc-rec No-error.
     5226     if error-status:error then do:                           find first pos_assortment-matrix no-lock where                                   recid(pos_assortment-matrix) = loc-doc-rec no-error .                             message                             "Невозможно позиционироваться на записи AM" skip                            string(if avail pos_assortment-matrix                                     then  substitute("Вн код AM: &1"                                                     , pos_assortment-matrix.asmt-id)                                     else "":U) skip                             "Запись была добавлена (или изменена или удалена) -" skip                             "и теперь не попадает в текущую выборку"                             view-as alert-box WARNING.                           end.
     5227     if available buf_Matrix then do:
     5228       loc#log = BROWSE-AM:select-focused-row( ) IN FRAME Dialog-Frame.
     5229     end.
     5230     apply "ENTRY" to BROWSE-AM.
     5231   end.
     5232   END PROCEDURE.
     5233   PROCEDURE proc-b-print :
     5234   define variable v-doc-rec as recid no-undo .
     5235   define variable accum-count as integer.
     5236   define variable date_string     as      char    no-undo.
     5237   define variable Line            as      char    no-undo.
     5238   define variable v-time-cr as character no-undo .
     5239   define variable v-time-up as character no-undo .
     5240   define variable v-st      as character no-undo .
     5241   DEFINE FRAME buf_Matrix-list
     5242         buf_Matrix.asmt-name COLUMN-LABEL "Название" FORMAT "X(30)":U
     5243         buf_Matrix.asmt-type COLUMN-LABEL "Тип" FORMAT "X(6)":U
     5244         buf_Matrix.obj-type  COLUMN-LABEL "Объект"
     5245         buf_Matrix.obj-code
     5246         buf_Matrix.asmt-date-update COLUMN-LABEL "Дата!изменения" FORMAT "99/99/99":U
     5247         v-time-up COLUMN-LABEL "Время" FORMAT "x(5)":U
     5248         buf_Matrix.asmt-who-update COLUMN-LABEL "Кто!изменил" FORMAT "X(8)":U
     5249         buf_Matrix.asmt-db-num-update COLUMN-LABEL "БД!изм" FORMAT ">>>>9":U
     5250         buf_Matrix.asmt-date-create COLUMN-LABEL "Дата!создания" FORMAT "99/99/99":U
     5251         v-time-cr  COLUMN-LABEL "Время" FORMAT "x(5)":U
     5252         buf_Matrix.asmt-who-create COLUMN-LABEL "Кто!создал" FORMAT "X(8)":U
     5253         buf_Matrix.asmt-db-num-create COLUMN-LABEL "БД!соз" FORMAT ">>>>9":U
     5254   HEADER  date_string AT 5 format "X(35)"
     5255    string( "Страница " ) format "X(9)" AT 115 PAGE-NUMBER(PrnLibStream) AT 125 FORMAT ">>9" SKIP
     5256   Line format "X(195)" AT 1
     5257   with width 232 down stream-io use-text    .
     5258   Line = fill("-", 195).
     5259   date_string = cur-time-print() .
     5260   run prn-lib-open-stream  in this-procedure (
     5261                                                input parParentProc
     5262                                               ,input 43
     5263                                               ,input yes
     5264                                               ,input no
     5265                                               ).
     5266   PUT  STREAM PrnLibStream
     5267   SPACE(25) ( frame Dialog-Frame:title )
     5268   format "x(90)" SKIP(1) .
     5269   FORM HEADER
     5270   Line format "X(195)" AT 1 SKIP
     5271   "Продолжение - на следующей странице" AT 30 SKIP
     5272   with FRAME BottomFrame width 232 PAGE-BOTTOM NO-LABELS NO-BOX .
     5273   VIEW  STREAM PrnLibStream FRAME BottomFrame .
     5274   FORM with FRAME buf_Matrix-list  .
     5275   run waitfram-show in this-procedure ("Ждите...").
     5276   v-doc-rec = recid(buf_Matrix).
     5277   DO WHILE available buf_Matrix :
     5278     GET prev BROWSE-AM.
     5279   END.
     5280   GET next BROWSE-AM.
     5281   DO WHILE available buf_Matrix :
     5282     Display STREAM PrnLibStream
     5283         buf_Matrix.asmt-name
     5284         buf_Matrix.asmt-type
     5285         buf_Matrix.obj-type
     5286         buf_Matrix.obj-code
     5287         buf_Matrix.asmt-date-update
     5288         STRING (buf_Matrix.asmt-time-update,"HH:MM") @ v-time-up
     5289         buf_Matrix.asmt-who-update
     5290         buf_Matrix.asmt-db-num-update
     5291         buf_Matrix.asmt-date-create
     5292         STRING (buf_Matrix.asmt-time-create,"HH:MM") @ v-time-cr
     5293         buf_Matrix.asmt-who-create
     5294         buf_Matrix.asmt-db-num-create
     5295   with FRAME buf_Matrix-list .
     5296     DOWN STREAM PrnLibStream 1
     5297     with FRAME buf_Matrix-list  .
     5298     assign
     5299     accum-count = accum-count + 1
     5300     .
     5301     GET next BROWSE-AM.
     5302   END.
     5303   UNDERLINE  STREAM PrnLibStream
     5304         buf_Matrix.asmt-name
     5305         buf_Matrix.asmt-type
     5306         buf_Matrix.obj-type
     5307         buf_Matrix.obj-code
     5308         buf_Matrix.asmt-date-update
     5309         buf_Matrix.asmt-who-update
     5310         buf_Matrix.asmt-db-num-update
     5311         buf_Matrix.asmt-date-create
     5312         buf_Matrix.asmt-who-create
     5313         buf_Matrix.asmt-db-num-create
     5314         v-time-cr
     5315         v-time-up
     5316   with FRAME buf_Matrix-list .
     5317   DISPLAY STREAM PrnLibStream
     5318   "ИТОГО" @ buf_Matrix.asmt-name
     5319   accum-count @ buf_Matrix.asmt-type
     5320   with frame buf_Matrix-list.
     5321   HIDE  STREAM PrnLibStream FRAME BottomFrame .
     5322   HIDE  STREAM PrnLibStream FRAME buf_Matrix-List.
     5323   output  STREAM PrnLibStream CLOSE.
     5324   REPOSITION BROWSE-AM to recid v-doc-rec no-error.
     5325   APPLY "entry" to BROWSE-AM.
     5326   run waitfram-hide in this-procedure .
     5327   run prn-lib-prn-file in this-procedure (
     5328                                             input parParentProc
     5329                                             ,input 8
     5330                                             ).
     5331   END PROCEDURE.
     5332   PROCEDURE proc-br :
     5333   define variable vss-include-info52 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5334   if b-sel:sensitive in frame Dialog-Frame then dO:
     5335       if b-mark:sensitive then do:
     5336           apply "choose" to b-mark in frame Dialog-Frame.
     5337       end.
     5338       else do:
     5339           apply "choose" to b-sel in frame Dialog-Frame.
     5340       end.
     5341   end.
     5342   else do:
     5343       if b-lookup:sensitive then
     5344       apply "choose" to b-lookup in frame Dialog-Frame.
     5345   end.
     5346   END PROCEDURE.
     5347   FUNCTION attrRootShablon RETURNS CHARACTER
     5348     ( p-recid as recid ) :
     5349   define buffer bufs_matrix for ub.assortment-matrix.
     5350   define variable v-type as character no-undo .
     5351   define variable v-value as character no-undo .
     5352   find first bufs_matrix no-lock  where recid(bufs_matrix) = p-recid no-error .
     5353   if error-status :error then return "" .
     5354   if bufs_matrix.asmt-type = 'Шаблон':U  then
     5355      return substitute("&1&3&2" ,bufs_matrix.asmt-id ,bufs_matrix.db-num, chr(1)  ) .
     5356   else do:
     5357     run assmatat-value (
     5358          input bufs_matrix.asmt-id
     5359         ,input bufs_matrix.db-num
     5360         ,input 'RootShablon':U
     5361         ,output v-value
     5362         ,output v-type
     5363         ) .
     5364      return  v-value .
     5365    end.
     5366   END FUNCTION.
     5367   FUNCTION f-name-link RETURNS CHARACTER
     5368     ( p-recid as recid ) :
     5369   define buffer bufs_matrix for ub.assortment-matrix.
     5370   define buffer bufr_assortment-matrix for ub.assortment-matrix.
     5371   define variable v-type as character no-undo .
     5372   define variable v-value as character no-undo .
     5373   find first bufs_matrix no-lock  where recid(bufs_matrix) = p-recid no-error .
     5374   if error-status :error then return "" .
     5375   if bufs_matrix.asmt-type = 'Шаблон':U  then
     5376      return "".
     5377   else do:
     5378     run assmatat-value (
     5379          input bufs_matrix.asmt-id
     5380         ,input bufs_matrix.db-num
     5381         ,input 'RootShablon':U
     5382         ,output v-value
     5383         ,output v-type
     5384         ) .
     5385        find first bufr_assortment-matrix no-lock where
     5386                   bufr_assortment-matrix.asmt-id = int(entry(1,v-value,chr(4))) and
     5387                   bufr_assortment-matrix.db-num  = int(entry(2,v-value,chr(4))) no-error .
     5388       if not available bufr_assortment-matrix then do:
     5389          return  "" .
     5390       end.
     5391       else do:
     5392         return  bufr_assortment-matrix.asmt-name.
     5393       end.
     5394    end.
     5395   END FUNCTION.
     5396   FUNCTION shablon-type RETURNS CHARACTER
     5397     ( p-recid as recid ) :
     5398   define buffer bufs_matrix for ub.assortment-matrix.
     5399   define buffer obj_assortment-matrix for ub.assortment-matrix  .
     5400   define variable v-type as character no-undo .
     5401   define variable v-value as character no-undo .
     5402   find first bufs_matrix no-lock  where recid(bufs_matrix) = p-recid no-error .
     5403   if error-status :error then return "" .
     5404   if bufs_matrix.asmt-type <> 'Шаблон':U  then do:
     5405      return "".
     5406   end.
     5407   else do:
     5408      for each obj_assortment-matrix no-lock where
     5409               obj_assortment-matrix.asmt-status = 0 and
     5410               obj_assortment-matrix.asmt-type   =   'Объект':U ,
     5411         first ub.assortment-matrix-attr no-lock where
     5412               ub.assortment-matrix-attr.asmt-id    = obj_assortment-matrix.asmt-id and
     5413               ub.assortment-matrix-attr.db-num     = obj_assortment-matrix.db-num  and
     5414               ub.assortment-matrix-attr.attr-code  = 'RootShablon':U and
     5415               ub.assortment-matrix-attr.attr-value = substitute("&1&3&2" , bufs_matrix.asmt-id,bufs_matrix.db-num,chr(4))
     5416               :
     5417               return chr(135) .
     5418      end.
     5419   end.
     5420   RETURN "".
     5421   END FUNCTION.
