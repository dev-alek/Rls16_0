     1199   DEFINE BUTTON B-add
     1200        LABEL "&Добавить"
     1201        SIZE 10 BY 1.
     1202   DEFINE BUTTON B-chg
     1203        LABEL "&Изменить"
     1204        SIZE 10 BY 1 TOOLTIP "Изменить название матрицы".
     1205   DEFINE BUTTON B-del
     1206        LABEL "&Удалить"
     1207        SIZE 10 BY 1.
     1208   DEFINE BUTTON B-demark-all
     1209        LABEL "-"
     1210        SIZE 3 BY 1 TOOLTIP "Снять все отметки".
     1211   DEFINE BUTTON B-goods AUTO-GO
     1212        LABEL "&Товары"
     1213        SIZE 10 BY 1 TOOLTIP "Состав матрицы".
     1214   DEFINE BUTTON B-Help
     1215        LABEL "Помо&щь"
     1216        SIZE 10 BY 1
     1217        BGCOLOR 8 .
     1218   DEFINE BUTTON B-hist
     1219        LABEL "Ис&тория"
     1220        SIZE 10 BY 1.
     1221   DEFINE BUTTON B-lookup
     1222        LABEL "&Просмотр"
     1223        SIZE 10 BY 1.
     1224   DEFINE BUTTON B-mark
     1225        LABEL "&*"
     1226        SIZE 3 BY 1 TOOLTIP "Отметить".
     1227   DEFINE BUTTON B-mark-all
     1228        LABEL "&+"
     1229        SIZE 3 BY 1 TOOLTIP "Отметить все".
     1230   DEFINE BUTTON B-print
     1231        LABEL "Пе&чать"
     1232        SIZE 10 BY 1.
     1233   DEFINE BUTTON b-quit AUTO-END-KEY
     1234        LABEL "&Выход"
     1235        SIZE 10 BY 1
     1236        BGCOLOR 8 .
     1237   DEFINE BUTTON B-sel AUTO-GO
     1238        LABEL "Вы&бор"
     1239        SIZE 10 BY 1.
     1240   DEFINE VARIABLE FILL-IN-1 AS CHARACTER FORMAT "X(256)":U INITIAL "Статус:"
     1241         VIEW-AS TEXT
     1242        SIZE 7.5 BY 1 NO-UNDO.
     1243   DEFINE VARIABLE FILL-IN-2 AS CHARACTER FORMAT "X(256)":U INITIAL "Тип:"
     1244         VIEW-AS TEXT
     1245        SIZE 4.5 BY 1 NO-UNDO.
     1246   DEFINE VARIABLE mark-num AS CHARACTER FORMAT "X(256)":U
     1247         VIEW-AS TEXT
     1248        SIZE 3 BY 1
     1249        FGCOLOR 4  NO-UNDO.
     1250   DEFINE VARIABLE name-link AS CHARACTER FORMAT "X(256)":U
     1251         VIEW-AS TEXT
     1252        SIZE 32 BY 1.25 TOOLTIP "Привязан к Шаблону"
     1253        BGCOLOR 8 FGCOLOR 1  NO-UNDO.
     1254   DEFINE VARIABLE v-text_object-bd AS CHARACTER FORMAT "X(256)":U INITIAL "ОбъектыБД:"
     1255         VIEW-AS TEXT
     1256        SIZE 10 BY 1 NO-UNDO.
     1257   DEFINE VARIABLE v-user-name-corr AS CHARACTER FORMAT "X(256)":U
     1258        LABEL "Изменил"
     1259         VIEW-AS TEXT
     1260        SIZE 15 BY .67
     1261        FGCOLOR 4  NO-UNDO.
     1262   DEFINE VARIABLE v-user-name-create AS CHARACTER FORMAT "X(256)":U
     1263        LABEL "Создал"
     1264         VIEW-AS TEXT
     1265        SIZE 15 BY .67
     1266        FGCOLOR 4  NO-UNDO.
     1267   DEFINE IMAGE I-link
     1268        FILENAME "cmp/link.bmp":U
     1269        SIZE 4.5 BY 1.25 TOOLTIP "Привязан к Шаблону".
     1270   DEFINE VARIABLE RS-object AS CHARACTER
     1271        VIEW-AS RADIO-SET HORIZONTAL EXPAND
     1272        RADIO-BUTTONS
     1273             "Item 1", "1",
     1274   "Item 2", "2"
     1275        SIZE 22.5 BY 1 NO-UNDO.
     1276   DEFINE VARIABLE RS-sts AS CHARACTER
     1277        VIEW-AS RADIO-SET HORIZONTAL EXPAND
     1278        RADIO-BUTTONS
     1279             "Item 1", "1",
     1280   "Item 2", "2",
     1281   "Item 3", "3"
     1282        SIZE 33.5 BY 1 NO-UNDO.
     1283   DEFINE VARIABLE RS-type AS CHARACTER
     1284        VIEW-AS RADIO-SET HORIZONTAL EXPAND
     1285        RADIO-BUTTONS
     1286             "Item 1", "1",
     1287   "Item 2", "2",
     1288   "Item 3", "3"
     1289        SIZE 33.5 BY 1 NO-UNDO.
     1290   DEFINE QUERY BROWSE-AM FOR
     1291         buf_matrix SCROLLING.
     1292   DEFINE BROWSE BROWSE-AM
     1293     QUERY BROWSE-AM NO-LOCK DISPLAY
     1294         mark-string(recid( buf_Matrix ), p-rid-list) @ p-mark COLUMN-LABEL "*" FORMAT "x(1)":U
     1295         buf_matrix.asmt-name COLUMN-LABEL "Название" FORMAT "X(20)":U
     1296         buf_matrix.asmt-type + shablon-type (recid ( buf_Matrix )) @ p-asmt-type COLUMN-LABEL "Тип" FORMAT "X(7)":U
     1297         IF (buf_Matrix.obj-code <> 0 ) THEN (buf_Matrix.obj-type + ' ' + string(buf_Matrix.obj-code)) ELSE ("")  @ p-obj COLUMN-LABEL "Объект" FORMAT "x(11)":U
     1298         entry (lookup (STRING(buf_Matrix.asmt-status), '0,1,50,99':U), 'тек,удал,блок,удаление':U) @ p-status COLUMN-LABEL "Статус" FORMAT "x(6)":U
     1299         buf_matrix.asmt-date-update COLUMN-LABEL "Дата!изменения" FORMAT "99/99/99":U
     1300         STRING (buf_Matrix.asmt-time-update,"HH:MM") @ p-time-upd COLUMN-LABEL "Время" FORMAT "x(5)":U
     1301         buf_matrix.asmt-db-num-update COLUMN-LABEL "БД!изм" FORMAT ">>>>9":U
     1302         buf_matrix.asmt-date-create COLUMN-LABEL "Дата!создания" FORMAT "99/99/99":U
     1303         STRING (buf_Matrix.asmt-time-create,"HH:MM") @ p-time-cr COLUMN-LABEL "Время" FORMAT "x(5)":U
     1304         attrRootShablon ( recid ( buf_Matrix ) ) @ p-shablon COLUMN-LABEL "Связка с!шаблоном"
     1305         buf_matrix.asmt-db-num-create COLUMN-LABEL "БД!соз" FORMAT ">>>>9":U
     1306     ENABLE
     1307         buf_matrix.asmt-name
     1308       WITH NO-ROW-MARKERS SEPARATORS SIZE 96 BY 11.75 FIT-LAST-COLUMN.
     1309   DEFINE FRAME Dialog-Frame
     1310        b-quit AT ROW 1 COL 1
     1311        B-mark AT ROW 1 COL 11
     1312        B-sel AT ROW 1 COL 17.5
     1313        B-add AT ROW 1 COL 27.5
     1314        B-lookup AT ROW 1 COL 37.5
     1315        B-chg AT ROW 1 COL 47.5
     1316        B-del AT ROW 1 COL 57.5
     1317        B-Help AT ROW 1 COL 87.5
     1318        B-mark-all AT ROW 2 COL 11.13 WIDGET-ID 6
     1319        B-demark-all AT ROW 2 COL 14.25 WIDGET-ID 8
     1320        B-goods AT ROW 2 COL 17.5
     1321        B-print AT ROW 2 COL 87.5
     1322        RS-sts AT ROW 3 COL 11.5 NO-LABEL
     1323        B-hist AT ROW 3 COL 87.5
     1324        RS-type AT ROW 4 COL 11.5 NO-LABEL
     1325        RS-object AT ROW 5 COL 11.5 NO-LABEL
     1326        BROWSE-AM AT ROW 6.08 COL 1.5
     1327        ub.buf_matrix.asmt-des AT ROW 19.42 COL 1.5 NO-LABEL
     1328             VIEW-AS EDITOR SCROLLBAR-VERTICAL
     1329             SIZE 94 BY 2.5
     1330        mark-num AT ROW 1 COL 12 COLON-ALIGNED NO-LABEL
     1331        FILL-IN-1 AT ROW 3 COL 3.5 NO-LABEL
     1332        FILL-IN-2 AT ROW 4 COL 6.5 NO-LABEL
     1333        v-text_object-bd AT ROW 5 COL 1 NO-LABEL
     1334        v-user-name-create AT ROW 17.96 COL 9.5 COLON-ALIGNED WIDGET-ID 2
     1335        name-link AT ROW 18 COL 30.5 COLON-ALIGNED NO-LABEL WIDGET-ID 12
     1336        v-user-name-corr AT ROW 18.75 COL 9.5 COLON-ALIGNED WIDGET-ID 4
     1337        I-link AT ROW 18 COL 28.5 WIDGET-ID 10
     1338        SPACE(64.74) SKIP(2.91)
     1339       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1340            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1341            TITLE "Список Ассортиментных матриц".
     1342   ASSIGN
     1343          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1344          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1345   ASSIGN
     1346          buf_matrix.asmt-name:COLUMN-READ-ONLY IN BROWSE BROWSE-AM = TRUE.
     1347   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1348   OR ENDKEY OF FRAME Dialog-Frame DO:
     1349       run gbl/markqwa.p
     1350       (    input b-mark:sensitive
     1351          , input p-rid-list) no-error.
     1352       if error-status:error then return no-apply.
     1353       else p-rid-list = "" .
     1354       APPLY "END-ERROR":U TO SELF.
     1355   END.
     1356   ON CHOOSE OF B-add IN FRAME Dialog-Frame
     1357   DO:
     1358     define variable loc#log as logical no-undo.
     1359     define variable loc-doc-rec as recid no-undo .
     1360   define variable vss-include-info12 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1361   do:
     1362     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1363       (input  v-cntxt-db-num
     1364       ,input  v-cntxt-userid
     1365       ,input  0
     1366       ,input  'actn_assort-matr_add-def':U
     1367       ,input  'global':U
     1368       ,input  v-cntxt-host-code-obj
     1369       ,input  v-cntxt-obj-type
     1370       ,input  v-cntxt-obj-code
     1371       ,input  0
     1372       ,input  0
     1373       ,input  0
     1374       ,input  true
     1375       ,output loc#log
     1376       )  .
     1377   end.
     1378     if loc#log <> yes then do: return no-apply. end.
     1379     run ref/assmatri.w
     1380                   (
     1381                      input parParentProc
     1382                     ,input p-curr-obj-type
     1383                     ,input p-curr-obj-code
     1384                     ,input 'ДОБАВЛЕНИЕ':U
     1385                     ,input 0
     1386                     ,input-output loc-doc-rec
     1387                                 ) no-error
     1388     .
     1389     if loc-doc-rec <> ? THEN DO:
     1390         run OpenBR in this-procedure .
     1391         reposition BROWSE-AM to recid loc-doc-rec no-error.
     1392         if error-status:error then do:                           find first pos_assortment-matrix no-lock where                                   recid(pos_assortment-matrix) = loc-doc-rec no-error .                             message                             "Невозможно позиционироваться на записи AM" skip                            string(if avail pos_assortment-matrix                                     then  substitute("Вн код AM: &1"                                                     , pos_assortment-matrix.asmt-id)                                     else "":U) skip                             "Запись была добавлена (или изменена или удалена) -" skip                             "и теперь не попадает в текущую выборку"                             view-as alert-box WARNING.                           end.
     1393     END.
     1394     apply "entry" to BROWSE-AM in frame Dialog-Frame.
     1395     apply "value-changed" to BROWSE-AM in frame Dialog-Frame.
     1396   END.
     1397   ON CHOOSE OF B-chg IN FRAME Dialog-Frame
     1398   DO:
     1399   define variable loc#log as logical no-undo.
     1400   define variable loc-doc-rec as recid no-undo .
     1401   if not available buf_matrix then return no-apply.
     1402   if  buf_matrix.asmt-status = 1  then do:
     1403       message "Корректировать можно только запись в статусе  ТЕК."
     1404       view-as alert-box information .
     1405       return no-apply.
     1406   end.
     1407   assign
     1408   loc-doc-rec = recid(buf_matrix).
     1409   define variable vss-include-info13 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1410   do:
     1411     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1412       (input  v-cntxt-db-num
     1413       ,input  v-cntxt-userid
     1414       ,input  0
     1415       ,input  'actn_assort-matr_update':U
     1416       ,input  'global':U
     1417       ,input  v-cntxt-host-code-obj
     1418       ,input  v-cntxt-obj-type
     1419       ,input  v-cntxt-obj-code
     1420       ,input  0
     1421       ,input  0
     1422       ,input  0
     1423       ,input  true
     1424       ,output loc#log
     1425       )  .
     1426   end.
     1427      if loc#log <> yes then do: return no-apply. end.
     1428   if buf_matrix.asmt-type = 'Шаблон':U then do:
     1429   if v-cntxt-db-num <> 0 and  v-cntxt-db-num <> buf_matrix.asmt-db-num-create then do:
     1430      message
     1431       "Нельзя редактировать ШАБЛОН Ассортиментная матрица созданный в чужой УБД"
     1432       view-as alert-box error.
     1433       return  no-apply.
     1434   end.
     1435   end.
     1436   else do:
     1437   define variable obj-db-num as integer   no-undo .
     1438   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1439   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
     1440     (input  buf_matrix.obj-type
     1441     ,input  buf_matrix.obj-code
     1442     ,output obj-db-num
     1443     )  .
     1444   if v-cntxt-db-num <> 0 and  v-cntxt-db-num <> obj-db-num  then do:
     1445      message
     1446       "Нельзя редактировать запись Ассортиментная матрица чужой УБД"
     1447       view-as alert-box error.
     1448       return  no-apply.
     1449   end.
     1450   end.
     1451      run ref/assmatri.w
     1452                    (
     1453                       input parParentProc
     1454                      ,input p-curr-obj-type
     1455                      ,input p-curr-obj-code
     1456                      ,input 'ИЗМЕНЕНИЕ':U
     1457                      ,input buf_matrix.asmt-id
     1458                      ,input-output loc-doc-rec
     1459                                  ) no-error
     1460      .
     1461      if loc-doc-rec <> ? THEN DO:
     1462          run OpenBR in this-procedure .
     1463          reposition BROWSE-AM to recid loc-doc-rec no-error.
     1464          if error-status:error then do:                           find first pos_assortment-matrix no-lock where                                   recid(pos_assortment-matrix) = loc-doc-rec no-error .                             message                             "Невозможно позиционироваться на записи AM" skip                            string(if avail pos_assortment-matrix                                     then  substitute("Вн код AM: &1"                                                     , pos_assortment-matrix.asmt-id)                                     else "":U) skip                             "Запись была добавлена (или изменена или удалена) -" skip                             "и теперь не попадает в текущую выборку"                             view-as alert-box WARNING.                           end.
     1465      END.
     1466      apply "entry" to BROWSE-AM in frame Dialog-Frame.
     1467      apply "value-changed" to BROWSE-AM in frame Dialog-Frame.
     1468   END.
     1469   ON CHOOSE OF B-del IN FRAME Dialog-Frame
