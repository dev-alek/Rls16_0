        1   DEFINE BUFFER buf_goods FOR ub.goods.
        2   define input            parameter parParentProc   as handle               no-undo .
        3   define input            parameter p-mode          as character            no-undo .
        4   define input            parameter p-gds-code      like ub.goods.gds-code  no-undo .
        5   define input-output     parameter p-recid         as recid                no-undo .
        6   define input            parameter p-sel-contractor-recid as recid no-undo.
        7   define variable vss-revision    as character no-undo init "$Revision$":U .
        8   define variable vss-author      as character no-undo init "$Author$":U .
        9   define variable vss-date        as character no-undo init "$Date$":U .
       10   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       11   define variable vss-archive     as character no-undo init "$Archive$":U .
       12   define variable vss-description as character no-undo init "Карточка внешний артикул".
       13   procedure vss-get-info :
       14     define output parameter p-vss-revision    like vss-revision    no-undo .
       15     define output parameter p-vss-author      like vss-author      no-undo .
       16     define output parameter p-vss-date        like vss-date        no-undo .
       17     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       18     define output parameter p-vss-archive     like vss-archive     no-undo .
       19     define output parameter p-vss-description like vss-description no-undo .
       20     assign
       21       p-vss-revision    = vss-revision
       22       p-vss-author      = vss-author
       23       p-vss-date        = vss-date
       24       p-vss-workfile    = vss-workfile
       25       p-vss-archive     = vss-archive
       26       p-vss-description = vss-description
       27     .
       28   end procedure.
       29   procedure vss-get-parameters :
       30     define output parameter p-vss-parameters as character no-undo .
       31   end procedure.
       32   define new global shared variable g#vssrevis-logger as handle    no-undo .
       33   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       34   define variable v-vssrevis-logger                   as handle    no-undo .
       35   procedure vss-logevent :
       36     define input  parameter p-extra-paramters as character no-undo .
       37     define variable v-vssrevis-parameters as character no-undo .
       38     do
       39     on error undo, return error return-value
       40     :
       41       if  valid-handle(v-vssrevis-logger)
       42       and v-vssrevis-logger :get-signature("logevent") <> ""
       43       then do:
       44         run vss-get-parameters in this-procedure
       45           (output v-vssrevis-parameters
       46           ).
       47         run logevent in v-vssrevis-logger
       48           (input vss-workfile
       49           ,input vss-revision
       50           ,input v-vssrevis-parameters
       51           ,input p-extra-paramters
       52           ).
       53       end.
       54     end.
       55   end procedure.
       56   assign
       57     v-vssrevis-logger = g#vssrevis-logger
       58   .
       59   if  valid-handle(v-vssrevis-logger)
       60   and v-vssrevis-logger :get-signature("logevent") <> ""
       61   then do:
       62     assign
       63       v-vssrevis-logevent = true
       64     .
       65     run vss-logevent in this-procedure (input vss-description) .
       66   end.
       67   define new global shared variable g#language as character no-undo .
       68   if g#language <> '' and g#language <> 'rus':U then do:
       69     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       70   end.
       71   procedure proc-alt-shift-f2:
       72     if not ibs.th.gbl.gbl-var:rcode
       73   then
       74     run gbl\inidebug.p .
       75   end.
       76   procedure proc-alt-shift-f3:
       77     run gbl/prvssinf.p
       78       ( input this-procedure
       79       ) .
       80   end.
       81   define variable v-inform-launched as logical no-undo initial false .
       82   procedure proc-alt-shift-f4:
       83     define variable v-action as character no-undo .
       84     if v-inform-launched = false then do:
       85       assign
       86         v-inform-launched = true
       87       .
       88       run gbl/d-inform.w
       89         (  input self
       90         ,  input this-procedure
       91         , output v-action
       92         ) no-error .
       93       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       94       assign
       95         v-inform-launched = false
       96       .
       97     end.
       98   end.
       99   procedure proc-alt-f1:
      100     run gbl/corrhelp.p
      101       (input this-procedure
      102       ) .
      103   end .
      104   on alt-shift-f2 anywhere do:
      105     run proc-alt-shift-f2.
      106   end.
      107   on alt-shift-f3 anywhere do:
      108     run proc-alt-shift-f3 in this-procedure .
      109   end.
      110   on alt-shift-f4 anywhere do:
      111     run proc-alt-shift-f4 in this-procedure.
      112   end.
      113   on alt-f1 anywhere do:
      114     run proc-alt-f1 in this-procedure .
      115   end.
      116   DEFINE BUTTON b-exit AUTO-GO
      117        LABEL "&Выход"
      118        SIZE 10 BY 1.
      119   DEFINE BUTTON b-help
      120        LABEL "Помо&щь"
      121        SIZE 10 BY 1.
      122   DEFINE BUTTON b-rest AUTO-END-KEY
      123        LABEL "&Отмена"
      124        SIZE 10 BY 1.
      125   DEFINE BUTTON b-units
      126        IMAGE-UP FILE "btn-down-arrow":U
      127        IMAGE-DOWN FILE "btn-down-arrow":U
      128        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      129        LABEL "b-units"
      130        SIZE 3 BY .88.
      131   DEFINE BUTTON b-units-ord
      132        IMAGE-UP FILE "btn-down-arrow":U
      133        IMAGE-DOWN FILE "btn-down-arrow":U
      134        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      135        LABEL "b-units"
      136        SIZE 3 BY .88.
      137   DEFINE BUTTON b-units-rcv
      138        IMAGE-UP FILE "btn-down-arrow":U
      139        IMAGE-DOWN FILE "btn-down-arrow":U
      140        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      141        LABEL "b-units"
      142        SIZE 3 BY .88.
      143   DEFINE BUTTON r-prod
      144        IMAGE-UP FILE "btn-down-arrow":U
      145        IMAGE-DOWN FILE "btn-down-arrow":U
      146        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      147        LABEL "r-prod"
      148        SIZE 3 BY .88.
      149   DEFINE VARIABLE ed-ps AS CHARACTER
      150        VIEW-AS EDITOR NO-WORD-WRAP SCROLLBAR-HORIZONTAL SCROLLBAR-VERTICAL
      151        SIZE 80.5 BY 5 NO-UNDO.
      152   DEFINE VARIABLE fi-cli-base-rate LIKE ub.ext-artic.cli-base-rate
      153        VIEW-AS FILL-IN
      154        SIZE 8 BY 1 NO-UNDO.
      155   DEFINE VARIABLE fi-cli-base-rate-ord LIKE ub.ext-artic.cli-base-rate
      156        VIEW-AS FILL-IN
      157        SIZE 8 BY 1 NO-UNDO.
      158   DEFINE VARIABLE fi-cli-base-rate-rcv LIKE ub.ext-artic.cli-base-rate
      159        VIEW-AS FILL-IN
      160        SIZE 8 BY 1 NO-UNDO.
      161   DEFINE VARIABLE fi-ext-artic LIKE ub.ext-artic.ext-artic
      162        LABEL "Вн. артикул"
      163        VIEW-AS FILL-IN
      164        SIZE 17 BY 1 NO-UNDO.
      165   DEFINE VARIABLE fi-unit-cli AS CHARACTER FORMAT "X(3)"
      166        VIEW-AS FILL-IN
      167        SIZE 7 BY 1
      168        FGCOLOR 4 .
      169   DEFINE VARIABLE fi-unit-cli-ord AS CHARACTER FORMAT "X(3)"
      170        VIEW-AS FILL-IN
      171        SIZE 7 BY 1
      172        FGCOLOR 4 .
      173   DEFINE VARIABLE fi-unit-cli-rcv AS CHARACTER FORMAT "X(3)"
      174        VIEW-AS FILL-IN
      175        SIZE 7 BY 1
      176        FGCOLOR 4 .
      177   DEFINE RECTANGLE RECT-1
      178        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      179        SIZE 80.5 BY 1.83.
      180   DEFINE RECTANGLE RECT-2
      181        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      182        SIZE 80.5 BY 1.83.
      183   DEFINE RECTANGLE RECT-3
      184        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      185        SIZE 80.5 BY 1.83.
      186   DEFINE QUERY Dialog-Frame FOR
      187         ub.goods,
      188         ub.clients,
      189         buf_goods SCROLLING.
      190   DEFINE FRAME Dialog-Frame
      191        b-exit AT ROW 1 COL 1 WIDGET-ID 4
      192        b-rest AT ROW 1 COL 11 WIDGET-ID 8
      193        b-help AT ROW 1 COL 21 WIDGET-ID 6
      194        buf_goods.artic AT ROW 3.04 COL 9.25 COLON-ALIGNED WIDGET-ID 2
      195             VIEW-AS FILL-IN
      196             SIZE 10 BY 1
      197             FGCOLOR 4
      198        buf_goods.gds-name AT ROW 4 COL 17 COLON-ALIGNED WIDGET-ID 10
      199             VIEW-AS FILL-IN
      200             SIZE 64 BY 1
      201             FGCOLOR 4
      202        ub.clients.obj-type AT ROW 5 COL 12 COLON-ALIGNED WIDGET-ID 16
      203             LABEL "Контрагент"
      204             VIEW-AS FILL-IN
      205             SIZE 5 BY 1
      206             BGCOLOR 3 FGCOLOR 15
      207        ub.clients.obj-code AT ROW 5 COL 15.75 COLON-ALIGNED NO-LABEL WIDGET-ID 12
      208             VIEW-AS FILL-IN
      209             SIZE 13 BY 1
      210             BGCOLOR 3 FGCOLOR 15
      211        ub.clients.obj-name AT ROW 5 COL 34 COLON-ALIGNED NO-LABEL WIDGET-ID 14
      212             VIEW-AS FILL-IN
      213             SIZE 49 BY 1
      214             BGCOLOR 3 FGCOLOR 15
      215        fi-ext-artic AT ROW 6 COL 12 COLON-ALIGNED HELP
      216             "" WIDGET-ID 26
      217             LABEL "Вн. артикул"
      218        fi-unit-cli AT ROW 7.75 COL 46.75 COLON-ALIGNED NO-LABEL WIDGET-ID 32
      219        b-units AT ROW 7.75 COL 56.25 WIDGET-ID 30
      220        fi-cli-base-rate AT ROW 7.75 COL 70.75 COLON-ALIGNED HELP
      221             "" WIDGET-ID 34
      222        fi-unit-cli-ord AT ROW 9.75 COL 46.75 COLON-ALIGNED NO-LABEL WIDGET-ID 44
      223        b-units-ord AT ROW 9.75 COL 56.25 WIDGET-ID 40
      224        fi-cli-base-rate-ord AT ROW 9.75 COL 70.75 COLON-ALIGNED HELP
      225             "" WIDGET-ID 42
      226        fi-unit-cli-rcv AT ROW 11.75 COL 46.75 COLON-ALIGNED NO-LABEL WIDGET-ID 54
      227        b-units-rcv AT ROW 11.75 COL 56.25 WIDGET-ID 50
      228        fi-cli-base-rate-rcv AT ROW 11.75 COL 70.75 COLON-ALIGNED HELP
      229             "" WIDGET-ID 52
      230        ed-ps AT ROW 14.38 COL 1.5 NO-LABEL WIDGET-ID 28
      231        r-prod AT ROW 5 COL 32 WIDGET-ID 18
      232        "Единица  измерения поставщика в  поставке:" VIEW-AS TEXT
      233             SIZE 42.5 BY .67 AT ROW 12 COL 3 WIDGET-ID 58
      234        "Единица  измерения поставщика в накладной:" VIEW-AS TEXT
      235             SIZE 43.75 BY .67 AT ROW 8 COL 3 WIDGET-ID 36
      236        "Примечание" VIEW-AS TEXT
      237             SIZE 11.5 BY .75 AT ROW 13.5 COL 2 WIDGET-ID 20
      238        "Единица  измерения поставщика в заказе:" VIEW-AS TEXT
      239             SIZE 42 BY .67 AT ROW 10 COL 3 WIDGET-ID 48
      240        RECT-1 AT ROW 7.5 COL 1.5 WIDGET-ID 38
      241        RECT-2 AT ROW 9.5 COL 1.5 WIDGET-ID 46
      242        RECT-3 AT ROW 11.5 COL 1.5 WIDGET-ID 56
      243        SPACE(0.87) SKIP(6.05)
      244       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      245            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      246            TITLE "Внешний артикул" WIDGET-ID 100.
      247   ASSIGN
      248          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      249          FRAME Dialog-Frame:HIDDEN           = TRUE.
      250   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      251   DO:
      252     APPLY "END-ERROR":U TO SELF.
      253   END.
      254   ON CHOOSE OF b-exit IN FRAME Dialog-Frame
      255   DO:
      256     define buffer buf_goods     for ub.goods.
      257     define buffer cur_ext-artic for ub.ext-artic.
      258     define variable v-log       as logical                no-undo .
      259     define variable v-cli-code           like ub.clients.obj-code          no-undo .
      260     define variable v-cli-type           like ub.clients.obj-type          no-undo .
      261     define variable v-ext-artic          like ub.ext-artic.ext-artic          no-undo .
      262     define variable v-ps                 like ub.ext-artic.ps                 no-undo .
      263     define variable v-unit-cli           like ub.ext-artic.unit-cli           no-undo .
      264     define variable v-cli-base-rate      like ub.ext-artic.cli-base-rate      no-undo .
      265     define variable v-unit-cli-ord       like ub.ext-artic.unit-cli-ord       no-undo .
      266     define variable v-cli-base-rate-ord  like ub.ext-artic.cli-base-rate-ord  no-undo .
      267     define variable v-unit-cli-rcv       like ub.ext-artic.unit-cli-rcv       no-undo .
      268     define variable v-cli-base-rate-rcv  like ub.ext-artic.cli-base-rate-rcv  no-undo .
      269     if p-mode = 'ПРОСМОТР':U then return.
      270     run chk-client in this-procedure (output v-log).
      271     if not v-log then do :
      272       message
      273         "Неверный контрагент!"
      274       view-as alert-box error.
      275       apply "choose":U to r-prod.
      276       return no-apply.
      277     end.
      278     if fi-ext-artic :screen-value = "" then do:
      279       message
      280         "Введите внешний артикул!"
      281       view-as alert-box error.
      282       apply "entry":u to fi-ext-artic.
      283       return no-apply.
      284     end.
      285     assign
      286       v-cli-code  = input frame Dialog-Frame ub.clients.obj-code
      287       v-cli-type  = input frame Dialog-Frame ub.clients.obj-type
      288       v-ext-artic = fi-ext-artic :screen-value
      289       v-ps        = ed-ps :screen-value
      290       v-unit-cli          = fi-unit-cli :screen-value
      291       v-cli-base-rate     = input frame Dialog-Frame fi-cli-base-rate
      292       v-unit-cli-ord      = fi-unit-cli-ord :screen-value
      293       v-cli-base-rate-ord = input frame Dialog-Frame fi-cli-base-rate-ord
      294       v-unit-cli-rcv      = fi-unit-cli-rcv :screen-value
      295       v-cli-base-rate-rcv = input frame Dialog-Frame fi-cli-base-rate-rcv
      296     .
      297     run check-exist-artic in this-procedure ( input  v-cli-type
      298                                             , input  v-cli-code
      299                                             , input  v-ext-artic
      300                                             , input  p-recid
      301                                             , output v-log
      302                                             ) .
      303     if v-log then return no-apply.
      304     run ref/extarts.p ( input p-mode
      305                      , input v-cli-type
      306                      , input v-cli-code
      307                      , input p-gds-code
      308                      , input v-ext-artic
      309                      , input v-ps
      310                      , input v-unit-cli
      311                      , input v-cli-base-rate
      312                      , input v-unit-cli-ord
      313                      , input v-cli-base-rate-ord
      314                      , input v-unit-cli-rcv
      315                      , input v-cli-base-rate-rcv
      316                      ) no-error .
      317     if error-status :error then do :
      318       message
      319         return-value skip
      320         error-status :get-message(1)
      321       view-as alert-box error.
      322       return no-apply.
      323     end.
      324     find first cur_ext-artic no-lock
      325       where cur_ext-artic.cli-type = v-cli-type
      326         and cur_ext-artic.cli-code = v-cli-code
      327         and cur_ext-artic.gds-code = p-gds-code
      328     no-error .
      329     if not available cur_ext-artic then do :
      330       message
      331         "Ошибка при сохранении внешнего артикула!" skip
      332       view-as alert-box error.
      333     end.
      334     else do :
      335       assign
      336         p-recid = recid( cur_ext-artic )
      337       .
      338     end.
      339   END.
      340   ON choose OF b-units IN FRAME Dialog-Frame
      341   do:
      342   define variable vss-include-info0 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      343   if lookup(self :type
      344            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      345            ) = 0
      346   then do:
      347     message
      348       "$Workfile$"
      349       "Указанному интерфейсному элементу фокус не может быть передан" skip
      350       "Интерфейсный элемент" self :name  skip
      351       "Тип" self :type  skip
      352       "Процедура" this-procedure :file-name skip
      353       view-as alert-box .
      354   end.
      355   else do:
      356     apply "entry":u to self  .
      357     if focus :handle <> self :handle  then do:
      358       return no-apply .
      359     end.
      360   end.
      361     define buffer buf_units for ub.units.
      362     define variable ref-rec as recid no-undo.
      363     run ref/units.w (input parparentproc, input yes, output ref-rec).
      364     if ref-rec = ? then return no-apply.
      365     find buf_units where recid (buf_units) = ref-rec no-lock.
      366     assign fi-unit-cli  = buf_units.unit-name.
      367     display fi-unit-cli with frame Dialog-Frame.
      368     apply "entry":U to fi-cli-base-rate .
      369   end.
      370   ON choose OF b-units-ord IN FRAME Dialog-Frame
      371   do:
      372   define variable vss-include-info1 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      373   if lookup(self :type
      374            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      375            ) = 0
      376   then do:
      377     message
      378       "$Workfile$"
      379       "Указанному интерфейсному элементу фокус не может быть передан" skip
      380       "Интерфейсный элемент" self :name  skip
      381       "Тип" self :type  skip
      382       "Процедура" this-procedure :file-name skip
      383       view-as alert-box .
      384   end.
      385   else do:
      386     apply "entry":u to self  .
      387     if focus :handle <> self :handle  then do:
      388       return no-apply .
      389     end.
      390   end.
      391     define buffer buf_units for ub.units.
      392     define variable ref-rec as recid no-undo.
      393     run ref/units.w (input parparentproc, input yes, output ref-rec).
      394     if ref-rec = ? then return no-apply.
      395     find buf_units where recid (buf_units) = ref-rec no-lock.
      396     assign fi-unit-cli-ord  = buf_units.unit-name.
      397     display fi-unit-cli-ord with frame Dialog-Frame.
      398     apply "entry":U to fi-cli-base-rate-ord .
      399   end.
      400   ON choose OF b-units-rcv IN FRAME Dialog-Frame
      401   do:
      402   define variable vss-include-info2 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      403   if lookup(self :type
      404            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      405            ) = 0
      406   then do:
      407     message
      408       "$Workfile$"
      409       "Указанному интерфейсному элементу фокус не может быть передан" skip
      410       "Интерфейсный элемент" self :name  skip
      411       "Тип" self :type  skip
      412       "Процедура" this-procedure :file-name skip
      413       view-as alert-box .
      414   end.
      415   else do:
      416     apply "entry":u to self  .
      417     if focus :handle <> self :handle  then do:
      418       return no-apply .
      419     end.
      420   end.
      421     define buffer buf_units for ub.units.
      422     define variable ref-rec as recid no-undo.
      423     run ref/units.w (input parparentproc, input yes, output ref-rec).
      424     if ref-rec = ? then return no-apply.
      425     find buf_units where recid (buf_units) = ref-rec no-lock.
      426     assign fi-unit-cli-rcv  = buf_units.unit-name.
      427     display fi-unit-cli-rcv with frame Dialog-Frame.
      428     apply "entry":U to fi-cli-base-rate-rcv .
      429   end.
      430   ON leave OF fi-unit-cli IN FRAME Dialog-Frame
      431   do:
      432     find ub.units where ub.units.unit-name = input frame Dialog-Frame fi-unit-cli no-lock no-error.
      433     if not available ub.units then do:
      434       message "Неправильная единица измерения поставщика." view-as alert-box.
      435       display fi-unit-cli with frame Dialog-Frame.
      436       apply "choose" to b-units.
      437       return no-apply.
      438     end.
      439     assign frame Dialog-Frame fi-unit-cli.
      440   end.
      441   ON return OF fi-unit-cli IN FRAME Dialog-Frame
      442   do:
      443     apply "entry" to fi-cli-base-rate in frame Dialog-Frame.
      444     return no-apply.
      445   end.
      446   ON leave OF fi-unit-cli-ord IN FRAME Dialog-Frame
      447   do:
      448     find ub.units where ub.units.unit-name = input frame Dialog-Frame fi-unit-cli-ord no-lock no-error.
      449     if not available ub.units then do:
      450       message "Неправильная единица измерения поставщика." view-as alert-box.
      451       display fi-unit-cli-ord with frame Dialog-Frame.
      452       apply "choose" to b-units-ord.
      453       return no-apply.
      454     end.
      455     assign frame Dialog-Frame fi-unit-cli-ord.
      456   end.
      457   ON return OF fi-unit-cli-ord IN FRAME Dialog-Frame
      458   do:
      459     apply "entry" to fi-cli-base-rate-ord in frame Dialog-Frame.
      460     return no-apply.
      461   end.
      462   ON leave OF fi-unit-cli-rcv IN FRAME Dialog-Frame
      463   do:
      464     find ub.units where ub.units.unit-name = input frame Dialog-Frame fi-unit-cli-rcv no-lock no-error.
      465     if not available ub.units then do:
      466       message "Неправильная единица измерения поставщика." view-as alert-box.
      467       display fi-unit-cli-rcv with frame Dialog-Frame.
      468       apply "choose" to b-units-rcv.
      469       return no-apply.
      470     end.
      471     assign frame Dialog-Frame fi-unit-cli-rcv.
      472   end.
      473   ON return OF fi-unit-cli-rcv IN FRAME Dialog-Frame
      474   do:
      475     apply "entry" to fi-cli-base-rate-rcv in frame Dialog-Frame.
      476     return no-apply.
      477   end.
      478   ON LEAVE OF ub.clients.obj-code IN FRAME Dialog-Frame
      479   DO:
      480     run proc-choose-client in this-procedure no-error .
      481     if error-status :error then return no-apply.
      482   END.
      483   ON RETURN OF ub.clients.obj-code IN FRAME Dialog-Frame
      484   DO:
      485     run proc-choose-client in this-procedure no-error .
      486     if error-status :error then return no-apply.
      487     apply "entry":u to fi-ext-artic in frame Dialog-Frame.
      488     return no-apply.
      489   END.
      490   ON RETURN OF ub.clients.obj-type IN FRAME Dialog-Frame
      491   DO:
      492     apply "ENTRY" to ub.clients.obj-code in frame Dialog-Frame.
      493     return no-apply.
      494   END.
      495   ON CHOOSE OF r-prod IN FRAME Dialog-Frame
      496   DO:
      497     define variable v-ref-list as character no-undo .
      498     run ref/cli-all.w ( parParentProc
      499                       , "b-add,b-sel"
      500                       , ?
      501                       , ?
      502                       , ?
      503                       , ?
      504                       , ?
      505                       , ?
      506                       , output v-ref-list
      507                       ) .
      508     if v-ref-list = "" then do:
      509       return no-apply.
      510     end.
      511     find ub.clients no-lock
      512       where recid (ub.clients) = integer(v-ref-list)
      513     no-error .
      514     if available ub.clients then do :
      515       display
      516         ub.clients.obj-type
      517         ub.clients.obj-code
      518         ub.clients.obj-name
      519       with frame Dialog-Frame.
      520     end.
      521     else do:
      522       message
      523         "Не найден контрагент!"
      524       view-as alert-box error.
      525       return no-apply.
      526     end.
      527     apply "entry":U to fi-ext-artic.
      528   END.
      529   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      530   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      531   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      532   on help of frame Dialog-Frame
      533   do:
      534     run gbl/app_help.p
      535       (input this-procedure :file-name
      536       ,input ''
      537       ,input ?
      538       ) no-error.
      539     if error-status :error then do:
      540       message
      541         "Ошибка при вызове помощи"
      542         error-status :get-message(1)
      543         view-as alert-box .
      544     end.
      545   end.
      546   run minbtn-set in this-procedure .
      547   on choose of b-help in frame Dialog-Frame
      548   do:
      549     apply "help":u to frame Dialog-Frame .
      550   end.
      551   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      552   procedure minbtn-set :
      553       do
      554           on error undo, return error return-value
      555           :
      556           define variable ii              as integer       no-undo .
      557           define variable fh              as widget-handle no-undo .
      558           define variable hh              as widget-handle no-undo .
      559           define variable v-h             as handle        extent 4 no-undo .
      560           define variable v-name-button   as character     no-undo .
      561           define variable v-help-old-x    as decimal       no-undo .
      562           define variable v-help-old-y    as decimal       no-undo .
      563           define variable v-help-old-size as decimal       no-undo .
      564           define variable v-frame-width   as decimal       no-undo .
      565           define variable jj              as integer       no-undo .
      566           do
      567               on error undo, return error
      568               :
      569               assign
      570                   v-frame-width = frame Dialog-Frame:width - 0.3
      571                   fh            = frame Dialog-Frame:first-child
      572                   hh            = fh:first-child
      573                   ii            = 1
      574                   .
      575               do while valid-handle(hh):
      576                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      577                   do:
      578                       case lc(hh:name) :
      579                           when "b-help" then
      580                               do:
      581                                   hh:load-image-up("cmp/b-help.bmp":u) .
      582                                   hh:load-image-down("cmp/b-help.bmp":u) .
      583                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      584                                   hh:TOOLTIP = "Помощь" .
      585                                   v-help-old-x = hh:column .
      586                                   v-help-old-y = hh:row    .
      587                                   v-help-old-size = hh:width .
      588                                   hh:width-chars = 2.5 .
      589                               end.
      590                           when "b-print" then
      591                               do:
      592                                   hh:load-image("cmp/b-print.bmp":u) .
      593                                   hh:TOOLTIP = "Печать" .
      594                                   v-h[ii] = hh:handle .
      595                                   ii = ii + 1 .
      596                                   hh:width-chars = 3 .
      597                               end.
      598                           when "b-history" or
      599                           when "b-hist" then
      600                               do:
      601                                   hh:load-image("cmp/b-hist.bmp":u) .
      602                                   hh:TOOLTIP = "История" .
      603                                   v-h[ii] = hh:handle .
      604                                   ii = ii + 1 .
      605                                   hh:width-chars = 3 .
      606                               end.
      607                           when "b-sch" then
      608                               do:
      609                                   hh:load-image("cmp/b-sch.bmp":u) .
      610                                   hh:TOOLTIP = "Установка Фильтра" .
      611                                   v-h[ii] = hh:handle .
      612                                   ii = ii + 1 .
      613                                   hh:width-chars = 3 .
      614                               end.
      615                           when "b-hist-user" then
      616                               do:
      617                                   hh:load-image("cmp/b-hist.bmp":u) .
      618                                   hh:TOOLTIP = "История пользователя" .
      619                                   ii = ii + 1 .
      620                               end.
      621                       end case.
      622                   end.
      623                   hh = hh:next-sibling.
      624               end.
      625               b-help:column = v-frame-width - b-help:width-chars.
      626               jj = 0.
      627               repeat ii = 4 to 1 by -1 :
      628                   if valid-handle (v-h[ii] ) then
      629                   do:
      630                       jj  = jj + 1 .
      631                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      632                       v-h[ii]:row    = v-help-old-y .
      633                   end.
      634               end.
      635           end.
      636       end.
      637   end procedure.
      638   MAIN-BLOCK:
      639   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      640      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      641     RUN my-enable.
      642     WAIT-FOR GO OF FRAME Dialog-Frame.
      643   END.
      644   RUN disable_UI.
      645   PROCEDURE check-exist-artic :
      646   define input  parameter p-cli-type  like ub.ext-artic.cli-type  no-undo .
      647   define input  parameter p-cli-code  like ub.ext-artic.cli-code  no-undo .
      648   define input  parameter p-ext-artic like ub.ext-artic.ext-artic no-undo .
      649   define input  parameter p-recid     as recid                    no-undo .
      650   define output parameter p-exist     as logical                  no-undo .
      651   define buffer ea        for ub.ext-artic.
      652   define buffer buf_goods for ub.goods.
      653   define variable v-del as logical   no-undo .
      654   do
      655   on error undo, return error return-value
      656   :
      657     find first ea no-lock
      658       where ea.cli-type  = p-cli-type
      659         and ea.cli-code  = p-cli-code
      660         and ea.ext-artic = p-ext-artic
      661         and ea.status_   <> 'удаленные':U
      662     no-error .
      663     if available ea then do:
      664       if recid( ea ) <> p-recid then do:
      665         find first buf_goods no-lock
      666           where buf_goods.gds-code = ea.gds-code
      667         no-error .
      668         message
      669           substitute( "Для данного контрагента уже есть товар &1 &2 с таким внешним артикулом"
      670                     , buf_goods.artic
      671                     , buf_goods.gds-name
      672                     )
      673         view-as alert-box error .
      674         assign
      675           p-exist = yes
      676         .
      677       end.
      678       else do:
      679         assign
      680           p-exist = no
      681         .
      682       end.
      683     end.
      684     else do:
      685       assign
      686         p-exist = no
      687       .
      688     end.
      689   end.
      690   END PROCEDURE.
      691   PROCEDURE chk-client :
      692   define output parameter p-log as logical   no-undo .
      693   define buffer buf_clients for ub.clients.
      694     find first ub.clients no-lock
      695       where ub.clients.obj-type = input frame Dialog-Frame ub.clients.obj-type
      696         and ub.clients.obj-code = input frame Dialog-Frame ub.clients.obj-code
      697     no-error.
      698     if available ub.clients then do :
      699       assign
      700         p-log = yes
      701       .
      702       display
      703         ub.clients.obj-name
      704       with frame Dialog-Frame.
      705     end.
      706   END PROCEDURE.
      707   PROCEDURE disable_UI :
      708     HIDE FRAME Dialog-Frame.
      709   END PROCEDURE.
      710   PROCEDURE enable_UI :
      711     OPEN QUERY Dialog-Frame FOR EACH ub.goods SHARE-LOCK,       EACH ub.clients WHERE TRUE  SHARE-LOCK,       EACH buf_goods WHERE TRUE  SHARE-LOCK.
      712     GET FIRST Dialog-Frame.
      713     DISPLAY fi-ext-artic fi-unit-cli fi-cli-base-rate fi-unit-cli-ord
      714             fi-cli-base-rate-ord fi-unit-cli-rcv fi-cli-base-rate-rcv ed-ps
      715         WITH FRAME Dialog-Frame.
      716     IF AVAILABLE buf_goods THEN
      717       DISPLAY buf_goods.artic buf_goods.gds-name
      718         WITH FRAME Dialog-Frame.
      719     IF AVAILABLE ub.clients THEN
      720       DISPLAY ub.clients.obj-type ub.clients.obj-code ub.clients.obj-name
      721         WITH FRAME Dialog-Frame.
      722     ENABLE b-exit b-rest b-help buf_goods.artic buf_goods.gds-name RECT-1
      723            ub.clients.obj-type RECT-2 ub.clients.obj-code RECT-3 fi-ext-artic
      724            fi-unit-cli b-units fi-cli-base-rate fi-unit-cli-ord b-units-ord
      725            fi-cli-base-rate-ord fi-unit-cli-rcv b-units-rcv fi-cli-base-rate-rcv
      726            ed-ps r-prod
      727         WITH FRAME Dialog-Frame.
      728     VIEW FRAME Dialog-Frame.
      729   END PROCEDURE.
      730   PROCEDURE find-clients :
      731   define input  parameter p-recid as recid     no-undo .
      732   define buffer buf_ext-artic for ub.ext-artic.
      733   do
      734   on error undo, return error return-value
      735   :
      736     find first buf_ext-artic no-lock
      737       where recid( buf_ext-artic ) = p-recid
      738     no-error .
      739     if available buf_ext-artic then do:
      740       find first ub.clients
      741         where ub.clients.obj-type = buf_ext-artic.cli-type
      742           and ub.clients.obj-code = buf_ext-artic.cli-code
      743           no-error .
      744       assign
      745         fi-ext-artic         = buf_ext-artic.ext-artic
      746         ed-ps                = buf_ext-artic.ps
      747         fi-unit-cli          = buf_ext-artic.unit-cli
      748         fi-cli-base-rate     = buf_ext-artic.cli-base-rate
      749         fi-unit-cli-ord      = buf_ext-artic.unit-cli-ord
      750         fi-cli-base-rate-ord = buf_ext-artic.cli-base-rate-ord
      751         fi-unit-cli-rcv      = buf_ext-artic.unit-cli-rcv
      752         fi-cli-base-rate-rcv = buf_ext-artic.cli-base-rate-rcv
      753       .
      754       display
      755         ub.clients.obj-type
      756         ub.clients.obj-code
      757         ub.clients.obj-name
      758         fi-ext-artic
      759         fi-unit-cli
      760         fi-cli-base-rate
      761         fi-unit-cli-ord
      762         fi-cli-base-rate-ord
      763         fi-unit-cli-rcv
      764         fi-cli-base-rate-rcv
      765         ed-ps
      766       with frame Dialog-Frame.
      767     end.
      768   end.
      769   END PROCEDURE.
      770   PROCEDURE my-enable :
      771     find first buf_goods no-lock
      772       where buf_goods.gds-code = p-gds-code
      773     no-error .
      774     if not available buf_goods then do:
      775       message "Не найден товар с кодом: " p-gds-code view-as alert-box error .
      776       return error substitute( "Не найден товар с кодом: &1" , p-gds-code ).
      777     end.
      778     case p-mode :
      779       when 'ДОБАВЛЕНИЕ':U then do:
      780         frame Dialog-Frame:title = "Д О Б А В Л Е Н И Е   внешний артикул для товара артикул: " + buf_goods.artic + "   " + buf_goods.gds-name.
      781         b-exit:label = "&Ввод".
      782         assign
      783           fi-unit-cli          = buf_goods.unit-cli
      784           fi-cli-base-rate     = buf_goods.cli-base-rate
      785           fi-unit-cli-ord      = buf_goods.unit-cli
      786           fi-cli-base-rate-ord = buf_goods.cli-base-rate
      787           fi-unit-cli-rcv      = buf_goods.unit-cli
      788           fi-cli-base-rate-rcv = buf_goods.cli-base-rate
      789         .
      790         enable
      791             r-prod
      792             ub.clients.obj-type
      793             ub.clients.obj-code
      794             fi-ext-artic
      795             fi-unit-cli
      796             b-units
      797             fi-cli-base-rate
      798             fi-unit-cli-ord
      799             b-units-ord
      800             fi-cli-base-rate-ord
      801             fi-unit-cli-rcv
      802             b-units-rcv
      803             fi-cli-base-rate-rcv
      804             ed-PS
      805         with frame Dialog-Frame.
      806         display
      807           fi-unit-cli
      808           fi-cli-base-rate
      809           fi-unit-cli-ord
      810           fi-cli-base-rate-ord
      811           fi-unit-cli-rcv
      812           fi-cli-base-rate-rcv
      813         with frame Dialog-Frame.
      814         run set-client-by-recid in this-procedure.
      815       end.
      816       when 'ПРОСМОТР':U then do:
      817         frame Dialog-Frame:title = "П Р О С М О Т Р   внешний артикул для товара артикул: " + buf_goods.artic + "   " + buf_goods.gds-name.
      818         assign
      819           ed-PS:read-only = yes
      820           b-rest:visible  = no
      821         .
      822         disable
      823           r-prod
      824         with frame Dialog-Frame.
      825         run find-clients in this-procedure  ( input p-recid ) no-error .
      826       end.
      827       when 'ИЗМЕНЕНИЕ':U then do:
      828         frame Dialog-Frame:title = "И З М Е Н Е Н И Е   внешний артикул для товара артикул: " + buf_goods.artic + "   " + buf_goods.gds-name.
      829         b-exit:label = "&Ввод".
      830         enable
      831           fi-ext-artic
      832           ed-PS
      833           fi-unit-cli
      834           b-units
      835           fi-cli-base-rate
      836           fi-unit-cli-ord
      837           b-units-ord
      838           fi-cli-base-rate-ord
      839           fi-unit-cli-rcv
      840           b-units-rcv
      841           fi-cli-base-rate-rcv
      842         with frame Dialog-Frame.
      843         assign
      844           ub.clients.obj-type :read-only = yes
      845           ub.clients.obj-code :read-only = yes
      846           ub.clients.obj-name :read-only = yes
      847         .
      848         run find-clients in this-procedure  ( input p-recid ) no-error .
      849       end.
      850     end case.
      851     ENABLE
      852       b-exit
      853       b-help
      854       b-rest when p-mode <> 'ПРОСМОТР':U
      855       ed-PS
      856     WITH FRAME Dialog-Frame.
      857     VIEW FRAME Dialog-Frame.
      858     display
      859         buf_goods.artic
      860         buf_goods.gds-name
      861     with frame Dialog-Frame .
      862   END PROCEDURE.
      863   PROCEDURE proc-choose-client :
      864   do
      865   on error undo, return error return-value
      866   :
      867     define variable v-log       as logical   no-undo .
      868     define variable v-ref-list  as character no-undo .
      869     run chk-client in this-procedure (output v-log).
      870     if not v-log then do :
      871       run ref/cli-all.w ( parParentProc
      872                         , "b-add,b-sel"
      873                         , ?
      874                         , ?
      875                         , ?
      876                         , ?
      877                         , ?
      878                         , ?
      879                         , output v-ref-list
      880                         ) .
      881       if v-ref-list = "" then do:
      882         return error.
      883       end.
      884       find ub.clients no-lock
      885         where recid (ub.clients) = integer(v-ref-list)
      886       no-error .
      887       if available ub.clients then do :
      888         display
      889           ub.clients.obj-type
      890           ub.clients.obj-code
      891           ub.clients.obj-name
      892         with frame Dialog-Frame.
      893       end.
      894       else do:
      895         message
      896           "Не найден контрагент!"
      897         view-as alert-box error.
      898         return error.
      899       end.
      900     end.
      901   end.
      902   END PROCEDURE.
      903   procedure set-client-by-recid:
      904       if p-sel-contractor-recid = 0 then return.
      905       find first ub.clients no-lock
      906           where recid(ub.clients) = p-sel-contractor-recid
      907           no-error.
      908       if avail ub.clients then
      909           do:
      910               display
      911                   ub.clients.obj-code
      912                   ub.clients.obj-name
      913                   ub.clients.obj-type
      914                   with frame Dialog-Frame.
      915               disable
      916                   r-prod
      917                   ub.clients.obj-code
      918                   ub.clients.obj-name
      919                   ub.clients.obj-type
      920                   with frame Dialog-Frame.
      921           end.
      922   end.
