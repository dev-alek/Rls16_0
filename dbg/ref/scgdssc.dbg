      751   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      752   procedure minbtn-set :
      753       do
      754           on error undo, return error return-value
      755           :
      756           define variable ii              as integer       no-undo .
      757           define variable fh              as widget-handle no-undo .
      758           define variable hh              as widget-handle no-undo .
      759           define variable v-h             as handle        extent 4 no-undo .
      760           define variable v-name-button   as character     no-undo .
      761           define variable v-help-old-x    as decimal       no-undo .
      762           define variable v-help-old-y    as decimal       no-undo .
      763           define variable v-help-old-size as decimal       no-undo .
      764           define variable v-frame-width   as decimal       no-undo .
      765           define variable jj              as integer       no-undo .
      766           do
      767               on error undo, return error
      768               :
      769               assign
      770                   v-frame-width = frame Dialog-Frame:width - 0.3
      771                   fh            = frame Dialog-Frame:first-child
      772                   hh            = fh:first-child
      773                   ii            = 1
      774                   .
      775               do while valid-handle(hh):
      776                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      777                   do:
      778                       case lc(hh:name) :
      779                           when "b-help" then
      780                               do:
      781                                   hh:load-image-up("cmp/b-help.bmp":u) .
      782                                   hh:load-image-down("cmp/b-help.bmp":u) .
      783                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      784                                   hh:TOOLTIP = "Помощь" .
      785                                   v-help-old-x = hh:column .
      786                                   v-help-old-y = hh:row    .
      787                                   v-help-old-size = hh:width .
      788                                   hh:width-chars = 2.5 .
      789                               end.
      790                           when "b-print" then
      791                               do:
      792                                   hh:load-image("cmp/b-print.bmp":u) .
      793                                   hh:TOOLTIP = "Печать" .
      794                                   v-h[ii] = hh:handle .
      795                                   ii = ii + 1 .
      796                                   hh:width-chars = 3 .
      797                               end.
      798                           when "b-history" or
      799                           when "b-hist" then
      800                               do:
      801                                   hh:load-image("cmp/b-hist.bmp":u) .
      802                                   hh:TOOLTIP = "История" .
      803                                   v-h[ii] = hh:handle .
      804                                   ii = ii + 1 .
      805                                   hh:width-chars = 3 .
      806                               end.
      807                           when "b-sch" then
      808                               do:
      809                                   hh:load-image("cmp/b-sch.bmp":u) .
      810                                   hh:TOOLTIP = "Установка Фильтра" .
      811                                   v-h[ii] = hh:handle .
      812                                   ii = ii + 1 .
      813                                   hh:width-chars = 3 .
      814                               end.
      815                           when "b-hist-user" then
      816                               do:
      817                                   hh:load-image("cmp/b-hist.bmp":u) .
      818                                   hh:TOOLTIP = "История пользователя" .
      819                                   ii = ii + 1 .
      820                               end.
      821                       end case.
      822                   end.
      823                   hh = hh:next-sibling.
      824               end.
      825               b-help:column = v-frame-width - b-help:width-chars.
      826               jj = 0.
      827               repeat ii = 4 to 1 by -1 :
      828                   if valid-handle (v-h[ii] ) then
      829                   do:
      830                       jj  = jj + 1 .
      831                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      832                       v-h[ii]:row    = v-help-old-y .
      833                   end.
      834               end.
      835           end.
      836       end.
      837   end procedure.
