      602         ub.scales.scales-name COLUMN-LABEL "Название весов" FORMAT "X(40)":U
      603         IF (ub.scales.master = 0 ) THEN yes ELSE no COLUMN-LABEL "Главные" FORMAT "+/":U
      604         ub.scales-gds.obj-code COLUMN-LABEL "Маг-н" FORMAT "99999":U
      605         ub.gds-obj-attr.attr-value COLUMN-LABEL "Вес.!код" FORMAT "X(5)":U
      606         get-price(buffer ub.goods , input ub.scales-gds.obj-type, input ub.scales-gds.obj-code, input ub.scales-gds.b-code) COLUMN-LABEL "Цена" FORMAT ">>>,>>9.99":U
      607       WITH NO-ROW-MARKERS SEPARATORS SIZE 78.38 BY 8.42.
      608   DEFINE FRAME Dialog-Frame
      609        b-quit AT ROW 1 COL 1
      610        B-scales AT ROW 1 COL 11
      611        B-add AT ROW 1 COL 31
      612        B-Help AT ROW 1 COL 54.88
      613        RS-all-shop AT ROW 2.33 COL 3.75 NO-LABEL
      614        br-scales AT ROW 3.46 COL 1.88
      615        SPACE(0.23) SKIP(0.40)
