     1489         end.
     1490         assign
     1491           frame Dialog-Frame :width = v-frame-width + p-change-value
     1492           no-error .
     1493         if error-status :error
     1494         or error-status :get-message(1) <> ""
     1495         then do:
     1496           undo move_block, retry move_block.
     1497         end.
     1498         assign
     1499           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1500         no-error .
     1501         if error-status :error
     1502         or error-status :get-message(1) <> ""
     1503         then do:
     1504           undo move_block, retry move_block.
     1505         end.
     1506         for each buf_temp-browse-handle
     1507           where buf_temp-browse-handle.browse-type = 'width':u
     1508         on error undo move_block, retry move_block
     1509         :
     1510           assign
     1511             buf_temp-browse-handle.browse-handle :width
     1512               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1513             no-error .
     1514           if error-status :error
     1515           or error-status :get-message(1) <> ""
     1516           then do:
     1517             undo move_block, retry move_block .
     1518           end.
     1519         end.
     1520         for each buf_temp-diasize-handle
     1521         on error undo move_block, retry move_block
     1522         :
     1523           assign
     1524             v-object-handle = buf_temp-diasize-handle.handle-value
     1525           .
     1526           if v-object-handle <> v-diasize-resize-button
     1527           then do:
     1528             assign
     1529               v-object-handle :col = v-object-handle :col + p-change-value
     1530               no-error .
     1531             if error-status :error
     1532             or error-status :get-message(1) <> ""
     1533             then do:
     1534               undo move_block, retry move_block .
     1535             end.
     1536           end.
     1537         end.
     1538       end.
     1539       else do:
     1540         for each buf_temp-diasize-handle
     1541         on error undo move_block, retry move_block
     1542         :
     1543           assign
     1544             v-object-handle = buf_temp-diasize-handle.handle-value
     1545           .
     1546           if v-object-handle <> v-diasize-resize-button
     1547           then do:
     1548             assign
     1549               v-object-handle :col = v-object-handle :col + p-change-value
     1550               no-error .
     1551             if error-status :error
     1552             or error-status :get-message(1) <> ""
     1553             then do:
     1554               undo move_block, retry move_block .
     1555             end.
     1556           end.
     1557         end.
     1558         for each buf_temp-browse-handle
     1559           where buf_temp-browse-handle.browse-type = 'width':u
     1560         on error undo move_block, retry move_block
     1561         :
     1562           assign
     1563             buf_temp-browse-handle.browse-handle :width
     1564               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1565             no-error .
     1566           if error-status :error
     1567           or error-status :get-message(1) <> ""
     1568           then do:
     1569             undo move_block, retry move_block .
     1570           end.
     1571         end.
     1572         assign
     1573           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1574           no-error .
     1575         if error-status :error
     1576         or error-status :get-message(1) <> ""
     1577         then do:
     1578           undo move_block, retry move_block.
     1579         end.
     1580         assign
     1581           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1582         no-error .
     1583         if error-status :error
     1584         or error-status :get-message(1) <> ""
     1585         then do:
     1586           undo move_block, retry move_block.
     1587         end.
     1588         if frame Dialog-Frame :scrollable = true
     1589         then do:
     1590           assign
     1591             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1592           no-error .
     1593           if error-status :error
     1594           or error-status :get-message(1) <> ""
     1595           then do:
     1596             undo move_block, retry move_block.
     1597           end.
     1598         end.
     1599       end.
     1600       if p-move-resize
     1601       then do:
     1602         run diasize_position-resize-button in this-procedure .
     1603       end.
     1604       if v-diasize-wndstore = true
     1605       then do:
     1606         if connected("ub") = true
     1607         then do:
     1608           define variable v-cntxt-db-num        as integer   no-undo .
     1609           define variable v-cntxt-userid        as character no-undo .
     1610           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1611                                             , OUTPUT v-cntxt-userid
     1612                                             ) .
     1613           run gbl/wndsizew.p
     1614             (input  v-cntxt-db-num
     1615             ,input  v-cntxt-userid
     1616             ,input  v-diasize-proc-name
     1617             ,input  'width':u
     1618             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1619             ) .
     1620         end.
     1621       end.
     1622     end.
     1623     assign
     1624       v-diasize-change-size = false
     1625     .
     1626   end procedure.
     1627   procedure diasize_set-width :
     1628     define input  parameter p-new-width  as decimal   no-undo .
     1629     define input  parameter p-move-resize as logical   no-undo .
     1630     do
     1631     on error undo, return error return-value
     1632     :
     1633       run diasize_change-width in this-procedure
     1634         (input  (p-new-width - frame Dialog-Frame :width)
     1635         ,input  p-move-resize
     1636         ) .
     1637     end.
     1638   end procedure.
     1639   procedure diasize_position-resize-button :
     1640     do with frame Dialog-Frame
     1641     :
     1642       hide v-diasize-resize-button .
     1643       assign
     1644         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1645                     - 1
     1646                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1647         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1648                     - 1
     1649                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1650       .
     1651       view v-diasize-resize-button .
     1652     end.
     1653   end procedure.
     1654   on alt-right anywhere
     1655   do:
     1656     run diasize_change-width in this-procedure
     1657       (input 1
     1658       ,input true
     1659       ) .
     1660     return no-apply .
     1661   end.
     1662   on alt-left anywhere
     1663   do:
     1664     run diasize_change-width in this-procedure
     1665       (input -1
     1666       ,input true
     1667       ) .
     1668     return no-apply .
     1669   end.
     1670   on alt-down anywhere
     1671   do:
     1672     run diasize_change-height in this-procedure
     1673       (input 1
     1674       ,input true
     1675       ) .
     1676     return no-apply .
     1677   end.
     1678   on alt-up anywhere
     1679   do:
     1680     run diasize_change-height in this-procedure
     1681       (input -1
     1682       ,input true
     1683       ) .
     1684     return no-apply .
     1685   end.
     1686   on alt-enter of frame Dialog-Frame
     1687   do:
     1688     run diasize_maximize in this-procedure
     1689       (input  ?
     1690       ).
     1691     return no-apply .
     1692   end.
     1693   procedure diasize_end-move :
     1694     do
     1695     on error undo, return error return-value
     1696     :
     1697       define variable v-row-delta as decimal   no-undo .
     1698       define variable v-col-delta as decimal   no-undo .
     1699       define variable v-new-row as decimal   no-undo .
     1700       define variable v-new-col as decimal   no-undo .
     1701       assign
     1702         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1703         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1704       .
     1705       assign
     1706         v-row-delta = v-new-row - frame Dialog-Frame :height
     1707         v-col-delta = v-new-col - frame Dialog-Frame :width
     1708       .
     1709       run diasize_change-height in this-procedure
     1710         (input v-row-delta
     1711         ,input true
     1712         ) .
     1713       run diasize_change-width in this-procedure
     1714         (input v-col-delta
     1715         ,input true
     1716         ) .
     1717     end.
     1718   end procedure.
     1719   procedure diasize_maximize :
     1720     define input  parameter p-action as logical   no-undo .
     1721     do
     1722     on error undo, return error return-value
     1723     :
     1724       if p-action = ?
     1725       then do:
     1726         if v-diasize-need-maximize = true
     1727         then do:
     1728           assign
     1729             p-action = true
     1730           .
     1731         end.
     1732         else do:
     1733           assign
     1734             p-action = false
     1735           .
     1736         end.
     1737       end.
     1738       if p-action = true
     1739       then do:
     1740         run diasize_change-height in this-procedure
     1741           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1742               - frame Dialog-Frame :height-chars
     1743           ,input true
     1744           ) .
     1745         run diasize_change-width in this-procedure
     1746           (input session :width-chars
     1747               - frame Dialog-Frame :width-chars
     1748           ,input true
     1749           ) .
     1750         assign
     1751           v-diasize-need-maximize = false
     1752         .
     1753       end.
     1754       else do:
     1755         run diasize_change-width in this-procedure
     1756           (input v-diasize-orig-frame-width
     1757               - frame Dialog-Frame :width-chars
     1758           ,input true
     1759           ) .
     1760         run diasize_change-height in this-procedure
     1761           (input v-diasize-orig-frame-height
     1762               - frame Dialog-Frame :height-chars
     1763           ,input true
     1764           ) .
     1765         assign
     1766           v-diasize-need-maximize = true
     1767         .
     1768       end.
     1769     end.
     1770   end procedure.
     1771   procedure diasize_restore-orig-size :
     1772     do
     1773     on error undo, return error return-value
     1774     :
     1775       assign
     1776         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1777         v-diasize-current-frame-height = frame Dialog-Frame :height
     1778       .
     1779       run diasize_set-height in this-procedure
     1780         (input  v-diasize-orig-frame-height
     1781         ,input  true
     1782         ) .
     1783       run diasize_set-width in this-procedure
     1784         (input  v-diasize-orig-frame-width
     1785         ,input  true
     1786         ) .
     1787     end.
     1788   end procedure.
     1789   procedure diasize_restore-current-size :
     1790     do
     1791     on error undo, return error return-value
     1792     :
     1793       run diasize_set-height in this-procedure
     1794         (input  v-diasize-current-frame-height
     1795         ,input  true
     1796         ) .
     1797       run diasize_set-width in this-procedure
     1798         (input  v-diasize-current-frame-width
     1799         ,input  true
     1800         ) .
     1801     end.
     1802   end procedure.
     1803   procedure diasize_set-browse-handle :
     1804     define input  parameter p-browse-handle as handle   no-undo .
     1805     define buffer buf_temp-browse-handle for temp-browse-handle .
     1806     do
     1807     on error undo, return error return-value
     1808     :
     1809       assign
     1810         v-diasize-browse-handle = p-browse-handle
     1811       .
     1812       for each buf_temp-browse-handle
     1813       on error undo, return error return-value
     1814       :
     1815         delete buf_temp-browse-handle .
     1816       end.
     1817     end.
     1818   end procedure.
     1819   procedure diasize_add_browse :
     1820     define input  parameter p-browse-type   as character no-undo .
     1821     define input  parameter p-browse-handle as handle    no-undo .
     1822     define buffer buf_temp-browse-handle for temp-browse-handle .
     1823     do
     1824     on error undo, return error return-value
     1825     :
     1826       assign
     1827         v-diasize-browse-number = v-diasize-browse-number + 1
     1828       .
     1829       create buf_temp-browse-handle .
     1830       assign
     1831         buf_temp-browse-handle.browse-type   = p-browse-type
     1832         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1833         buf_temp-browse-handle.browse-handle = p-browse-handle
     1834       .
     1835     end.
     1836   end procedure.
     1837   procedure diasize_init :
     1838     define variable v-default-value    as logical   no-undo .
     1839     define variable v-restore-saved    as logical   no-undo .
     1840     define variable v-resize-value-str as character no-undo .
     1841     do
     1842     on error undo, return error return-value
     1843     :
     1844       do with frame Dialog-Frame
     1845       :
     1846         assign
     1847           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1848           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1849           v-diasize-browse-handle     = browse br-scales :handle
     1850         .
     1851         create button v-diasize-resize-button
     1852         assign
     1853           parent        = frame Dialog-Frame :first-child
     1854           label         = "s"
     1855           height-pixels = 16
     1856           width-pixels  = 16
     1857           visible       = true
     1858           sensitive     = true
     1859           movable       = true
     1860           triggers:
     1861             on end-move persistent run diasize_end-move in this-procedure .
     1862           end triggers.
     1863         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1864         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1865         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1866         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1867         assign
     1868           v-diasize-wndmax = false
     1869         .
     1870         if connected("ub") = true
     1871         then do:
     1872           define variable v-cntxt-db-num        as integer   no-undo .
     1873           define variable v-cntxt-userid        as character no-undo .
     1874           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1875                                             , OUTPUT v-cntxt-userid
     1876                                             ) .
     1877           run gbl/wndpar_r.p
     1878             (input  v-cntxt-db-num
     1879             ,input  v-cntxt-userid
     1880             ,input  'wndmax':U
     1881             ,output v-diasize-wndmax
     1882             ,output v-default-value
     1883             ) .
     1884         end.
     1885         assign
     1886           v-diasize-wndstore = false
     1887         .
     1888         if connected("ub") = true
     1889         then do:
     1890           run gbl/wndpar_r.p
     1891             (input  v-cntxt-db-num
     1892             ,input  v-cntxt-userid
     1893             ,input  'wndstore':U
     1894             ,output v-diasize-wndstore
     1895             ,output v-default-value
     1896             ) .
     1897         end.
     1898         assign
     1899           v-diasize-proc-name = entry(1, program-name(2), '.')
     1900         .
     1901         if v-diasize-wndstore = true
     1902         then do:
     1903           assign
     1904             v-restore-saved = false
     1905           .
     1906           if connected("ub") = true
     1907           then do:
     1908             run gbl/wndsizer.p
     1909               (input  v-cntxt-db-num
     1910               ,input  v-cntxt-userid
     1911               ,input  v-diasize-proc-name
     1912               ,input  'height':u
     1913               ,output v-resize-value-str
     1914               ) .
     1915             if v-resize-value-str <> '':U
     1916             then do:
     1917               run diasize_change-height in this-procedure
     1918                 (input  integer(v-resize-value-str)
     1919                 ,input  true
     1920                 ) .
     1921               assign
     1922                 v-restore-saved = true
     1923               .
     1924             end.
     1925           end.
     1926           if connected("ub") = true
     1927           then do:
     1928             run gbl/wndsizer.p
     1929               (input  v-cntxt-db-num
     1930               ,input  v-cntxt-userid
     1931               ,input  v-diasize-proc-name
     1932               ,input  'width':u
     1933               ,output v-resize-value-str
     1934               ) .
     1935             if v-resize-value-str <> '':U
     1936             then do:
     1937               run diasize_change-width in this-procedure
     1938                 (input  integer(v-resize-value-str)
     1939                 ,input  true
     1940                 ) .
     1941               assign
     1942                 v-restore-saved = true
     1943               .
     1944             end.
     1945           end.
     1946           if v-restore-saved <> true
     1947           then do:
     1948             if v-diasize-wndmax = true
     1949             then do:
     1950               run diasize_maximize in this-procedure
     1951                 (input  true
     1952                 ) .
     1953             end.
     1954           end.
     1955         end.
     1956         else do:
     1957           if v-diasize-wndmax = true
     1958           then do:
     1959             run diasize_maximize in this-procedure
     1960               (input  true
     1961               ) .
     1962           end.
     1963         end.
     1964       end.
     1965     end.
     1966   end procedure.
     1967   procedure diasize_need-full-display :
     1968     define output parameter p-need-full-display as logical   no-undo .
     1969     do
     1970     on error undo, return error return-value
     1971     :
     1972       assign
     1973         p-need-full-display = v-diasize-need-full-display
     1974       .
     1975       assign
     1976         v-diasize-need-full-display = false
     1977       .
     1978     end.
     1979   end procedure.
     1980   procedure get-context :
     1981      define output parameter p-db-num as integer          no-undo.
     1982      define output parameter p-user-id as character        no-undo.
     1983      define variable v-login               as character    no-undo.
     1984      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1985      define buffer buf_user-login  for ub.user-login .
     1986      do
     1987      on error undo, return error
     1988      :
     1989            FIND FIRST buf_sys-ctrl no-lock.
     1990            ASSIGN
     1991               v-login = USERID("ub")
     1992               p-db-num = buf_sys-ctrl.db-num
     1993            .
     1994            FIND FIRST buf_user-login
     1995                 WHERE buf_user-login.db-num = p-db-num
     1996                   AND buf_user-login.user-login = v-login
     1997                 no-lock
     1998                 no-error
     1999                 .
     2000            IF AVAILABLE buf_user-login
     2001            THEN DO:
     2002               assign
     2003                  p-user-id = buf_user-login.user-id
     2004               .
     2005            END.
     2006      end.
     2007   end procedure.
     2008       run diasize_init in this-procedure .
     2009   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2010   on f5 of frame Dialog-Frame anywhere
     2011   do:
     2012     v-doc-rec = ?. if available ub.scales then v-doc-rec = recid(ub.scales). run openbr in this-procedure. reposition br-scales to recid v-doc-rec.
     2013                 v-doc-rec = ? . APPLY 'ENTRY' to br-scales. apply 'VALUE-CHANGED' to br-scales.
     2014       apply "VALUE-CHANGED" to br-scales.
     2015   end.
     2016   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2017   do:
     2018     br-scales :SET-REPOSITIONED-ROW(5, "CONDITIONAL") .
     2019   end.
     2020   define variable vss-include-info14 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2021   on F2 of frame Dialog-Frame anywhere do:
     2022     if b-quit :sensitive then DO: apply "CHOOSE":U to b-quit in frame Dialog-Frame. END.
     2023     return no-apply.
     2024   end.
     2025   MAIN-BLOCK:
     2026   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2027      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2028   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2029     run mainmenu_getcntxt in parparentproc
     2030       (output v-cntxt-db-num
     2031       ,output v-cntxt-userid
     2032       ,output v-cntxt-level
     2033       ,output v-cntxt-host-code-obj
     2034       ,output v-cntxt-obj-type
     2035       ,output v-cntxt-obj-code
     2036       ,output v-cntxt-db-num-obj
     2037       ,output v-cntxt-is-admin
     2038       ) .
     2039     assign
     2040     v-obj-type = p-obj-type
     2041     v-obj-code = p-obj-code
     2042     .
     2043     RUN MYenable in this-procedure .
     2044     WAIT-FOR GO OF FRAME Dialog-Frame.
     2045   END.
     2046   RUN disable_UI in this-procedure .
     2047   PROCEDURE disable_UI :
     2048     HIDE FRAME Dialog-Frame.
     2049   END PROCEDURE.
     2050   PROCEDURE enable_UI :
     2051     DISPLAY RS-all-shop
     2052         WITH FRAME Dialog-Frame.
     2053     ENABLE b-quit B-scales B-add B-Help RS-all-shop br-scales
     2054         WITH FRAME Dialog-Frame.
     2055     VIEW FRAME Dialog-Frame.
     2056     OPEN QUERY br-scales FOR EACH ub.scales-gds       WHERE scales-gds.db-num = p-db-num AND scales-gds.b-code = p-b-code  AND (scales-gds.obj-type = v-obj-type or v-obj-type = "")  AND (scales-gds.obj-code = v-obj-code or v-obj-code = 0) NO-LOCK,       EACH ub.scales WHERE (scales.db-num = scales-gds.db-num AND scales.scales-num = scales-gds.scales-num)   OR (scales.db-num = scales-gds.db-num AND  scales.master = scales-gds.scales-num) NO-LOCK,       EACH ub.bar-code WHERE bar-code.b-code = scales-gds.b-code NO-LOCK,       EACH ub.gds-obj-attr WHERE TRUE        AND gds-obj-attr.obj-type = scales-gds.obj-type  AND gds-obj-attr.obj-code = scales-gds.obj-code  AND gds-obj-attr.gds-code = bar-code.gds-code  AND gds-obj-attr.attr-code = 'scales-code':U NO-LOCK.
     2057   END PROCEDURE.
     2058   PROCEDURE MyEnable :
     2059     define variable glog as logical no-undo .
     2060       FIND FIRST b-bar-code No-LOCK WHERE
     2061                  b-bar-code.b-code = p-b-code No-ERROR.
     2062       if not avail b-bar-code then do:
     2063           message vss-workfile vss-revision vss-description skip
     2064                         "Не найден бар-код " p-b-code
     2065           view-as alert-box ERROR.
     2066           return.
     2067       end.
     2068       FIND FIRST ub.goods no-lock where
     2069                  ub.goods.gds-code = b-bar-code.gds-code NO-ERROR.
     2070       if not avail ub.goods then return.
     2071       ASSIGN frame Dialog-Frame:TITLE = substitute("БД &1 Весы с товаром &2 &3&4 &5"
     2072                                                     , p-db-num
     2073                                                     , ub.goods.artic
     2074                                                     , ub.goods.prod-type
     2075                                                     , ub.goods.prod-code
     2076                                                     , ub.goods.gds-name).
     2077    DISPLAY RS-all-shop
     2078         WITH FRAME Dialog-Frame.
     2079     ENABLE
     2080      b-add WHEN p-db-num = v-cntxt-db-num
     2081      b-quit
     2082      B-scales
     2083      B-Help
     2084      RS-all-shop
     2085      br-scales
     2086      WITH FRAME Dialog-Frame.
     2087     VIEW FRAME Dialog-Frame.
     2088     OPEN QUERY br-scales FOR EACH ub.scales-gds       WHERE scales-gds.db-num = p-db-num AND scales-gds.b-code = p-b-code  AND (scales-gds.obj-type = v-obj-type or v-obj-type = "")  AND (scales-gds.obj-code = v-obj-code or v-obj-code = 0) NO-LOCK,       EACH ub.scales WHERE (scales.db-num = scales-gds.db-num AND scales.scales-num = scales-gds.scales-num)   OR (scales.db-num = scales-gds.db-num AND  scales.master = scales-gds.scales-num) NO-LOCK,       EACH ub.bar-code WHERE bar-code.b-code = scales-gds.b-code NO-LOCK,       EACH ub.gds-obj-attr WHERE TRUE        AND gds-obj-attr.obj-type = scales-gds.obj-type  AND gds-obj-attr.obj-code = scales-gds.obj-code  AND gds-obj-attr.gds-code = bar-code.gds-code  AND gds-obj-attr.attr-code = 'scales-code':U NO-LOCK.
     2089     APPLY "ENTRY" to br-scales.
     2090   END PROCEDURE.
     2091   PROCEDURE Openbr :
     2092   OPEN QUERY br-scales FOR EACH ub.scales-gds       WHERE scales-gds.db-num = p-db-num AND scales-gds.b-code = p-b-code  AND (scales-gds.obj-type = v-obj-type or v-obj-type = "")  AND (scales-gds.obj-code = v-obj-code or v-obj-code = 0) NO-LOCK,       EACH ub.scales WHERE (scales.db-num = scales-gds.db-num AND scales.scales-num = scales-gds.scales-num)   OR (scales.db-num = scales-gds.db-num AND  scales.master = scales-gds.scales-num) NO-LOCK,       EACH ub.bar-code WHERE bar-code.b-code = scales-gds.b-code NO-LOCK,       EACH ub.gds-obj-attr WHERE TRUE        AND gds-obj-attr.obj-type = scales-gds.obj-type  AND gds-obj-attr.obj-code = scales-gds.obj-code  AND gds-obj-attr.gds-code = bar-code.gds-code  AND gds-obj-attr.attr-code = 'scales-code':U NO-LOCK.
     2093   END PROCEDURE.
     2094   PROCEDURE proc-b-add :
     2095     define variable rid-list as char no-undo.
     2096     define variable ii as integer no-undo.
     2097     define buffer b-scales for ub.scales.
     2098     define buffer b-scales-gds for ub.scales-gds.
     2099     run ref/scales.w (
     2100                  input parparentproc
     2101                 ,input p-obj-type
     2102                 ,input p-obj-type
     2103                 ,input "b-sel":U
     2104                 ,input 'db':U
     2105                 ,output rid-list) no-error.
     2106     if error-status:error then return no-apply.
     2107     _ii:
     2108     do ii = 1 to num-entries(rid-list):
     2109       find first b-scales  WHERE
     2110                  recid(b-scales) = integer(entry(ii, rid-list)) no-error.
     2111       if not avail b-scales then next.
     2112       if b-scales.master > 0 then do:
     2113         message "Для того чтобы привязать товар к подчиненным весам," b-scales.scales-num b-scales.scales-name skip
     2114                 "выберите соответствующие главные весы" "N":U b-scales.master
     2115         view-as alert-box ERROR.
     2116         next _ii.
     2117       end.
     2118       if can-find(first b-scales-gds No-LOCK WHERE
     2119                         b-scales-gds.b-code =  p-b-code AND
     2120                         b-scales-gds.db-num =  b-scales.db-num AND
     2121                         b-scales-gds.scales-num = b-scales.scales-num) then do:
     2122         message "Товар уже имеется на весах N" b-scales.scales-num b-scales.scales-name
     2123         view-as alert-box ERROR.
     2124         next _ii.
     2125       end.
     2126       run ref/ves-pbc.p (
     2127                           input parparentproc
     2128                         , input 'ДОБАВЛЕНИЕ':U
     2129                         , input p-obj-type
     2130                         , input p-obj-code
     2131                         , input ?
     2132                         , input ?
     2133                         , input ?
     2134                         , input 0
     2135                         , buffer b-bar-code
     2136                         , buffer b-scales) no-error.
     2137       if error-status:error then do:
     2138         message "Не удалось привязать товар к весам N" b-scales.scales-num b-scales.scales-name
     2139         view-as alert-box ERROR.
     2140         return no-apply.
     2141       end.
     2142     end.
     2143    OPEN QUERY br-scales FOR EACH ub.scales-gds       WHERE scales-gds.db-num = p-db-num AND scales-gds.b-code = p-b-code  AND (scales-gds.obj-type = v-obj-type or v-obj-type = "")  AND (scales-gds.obj-code = v-obj-code or v-obj-code = 0) NO-LOCK,       EACH ub.scales WHERE (scales.db-num = scales-gds.db-num AND scales.scales-num = scales-gds.scales-num)   OR (scales.db-num = scales-gds.db-num AND  scales.master = scales-gds.scales-num) NO-LOCK,       EACH ub.bar-code WHERE bar-code.b-code = scales-gds.b-code NO-LOCK,       EACH ub.gds-obj-attr WHERE TRUE        AND gds-obj-attr.obj-type = scales-gds.obj-type  AND gds-obj-attr.obj-code = scales-gds.obj-code  AND gds-obj-attr.gds-code = bar-code.gds-code  AND gds-obj-attr.attr-code = 'scales-code':U NO-LOCK.
     2144    APPLY "ENTRY" to br-scales in frame Dialog-Frame.
     2145   END PROCEDURE.
     2146   PROCEDURE proc-select-scales :
     2147   define parameter buffer loc-scales-gds for ub.scales-gds.
     2148   define variable rid-list as character no-undo.
     2149   assign
     2150   rid-list = string(recid(loc-scales-gds))
     2151   .
     2152   run ref/scalelst.w (
     2153                   input parparentproc
     2154                  ,input p-obj-type
     2155                  ,input p-obj-code
     2156                  ,input loc-scales-gds.db-num
     2157                  ,input loc-scales-gds.scales-num
     2158                  ,input (if v-cntxt-db-num-obj = v-cntxt-db-num then  "b-chg":U else '':U)
     2159                  ,input 'ТОВАР':U
     2160                  ,input-output rid-list).
     2161   OPEN QUERY br-scales FOR EACH ub.scales-gds       WHERE scales-gds.db-num = p-db-num AND scales-gds.b-code = p-b-code  AND (scales-gds.obj-type = v-obj-type or v-obj-type = "")  AND (scales-gds.obj-code = v-obj-code or v-obj-code = 0) NO-LOCK,       EACH ub.scales WHERE (scales.db-num = scales-gds.db-num AND scales.scales-num = scales-gds.scales-num)   OR (scales.db-num = scales-gds.db-num AND  scales.master = scales-gds.scales-num) NO-LOCK,       EACH ub.bar-code WHERE bar-code.b-code = scales-gds.b-code NO-LOCK,       EACH ub.gds-obj-attr WHERE TRUE        AND gds-obj-attr.obj-type = scales-gds.obj-type  AND gds-obj-attr.obj-code = scales-gds.obj-code  AND gds-obj-attr.gds-code = bar-code.gds-code  AND gds-obj-attr.attr-code = 'scales-code':U NO-LOCK.
     2162    APPLY "ENTRY" to br-scales in frame Dialog-Frame.
     2163   END PROCEDURE.
