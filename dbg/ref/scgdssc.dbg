     1469         .
     1470       end.
     1471       do with frame Dialog-Frame
     1472       :
     1473         hide v-diasize-resize-button .
     1474         v-diasize-resize-button :row = 1.
     1475         v-diasize-resize-button :column = 1.
     1476       end.
     1477       if p-change-value > 0
     1478       then do:
     1479         if frame Dialog-Frame :scrollable = true
     1480         then do:
     1481           assign
     1482             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1483             no-error .
     1484           if error-status :error
     1485           or error-status :get-message(1) <> ""
     1486           then do:
     1487             undo move_block, retry move_block.
