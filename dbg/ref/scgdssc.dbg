     1210           end.
     1211         end.
     1212       end.
     1213       if p-move-resize = true
     1214       then do:
     1215         run diasize_position-resize-button in this-procedure .
     1216       end.
     1217       if v-diasize-wndstore = true
     1218       then do:
     1219         if connected("ub") = true
     1220         then do:
     1221           define variable v-cntxt-db-num        as integer   no-undo .
     1222           define variable v-cntxt-userid        as character no-undo .
     1223           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1224                                             , OUTPUT v-cntxt-userid
     1225                                             ) .
     1226           run gbl/wndsizew.p
     1227             (input  v-cntxt-db-num
     1228             ,input  v-cntxt-userid
     1229             ,input  v-diasize-proc-name
     1230             ,input  'height':u
     1231             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1232             ) .
     1233         end.
     1234       end.
     1235     end.
     1236     assign
     1237       v-diasize-change-size = false
     1238     .
     1239   end procedure.
     1240   procedure diasize_set-height :
     1241     define input  parameter p-new-height  as decimal   no-undo .
     1242     define input  parameter p-move-resize as logical   no-undo .
     1243     do
     1244     on error undo, return error return-value
     1245     :
     1246       run diasize_change-height in this-procedure
     1247         (input  (p-new-height - frame Dialog-Frame :height)
     1248         ,input  p-move-resize
     1249         ) .
     1250     end.
     1251   end procedure.
     1252   procedure diasize_change-width :
     1253     define input  parameter p-change-value as decimal   no-undo .
     1254     define input  parameter p-move-resize  as logical   no-undo .
     1255     define variable v-field-group-handle   as handle    no-undo .
     1256     define variable v-object-handle        as handle    no-undo .
     1257     define variable v-frame-width          as decimal   no-undo .
     1258     define variable v-frame-virtual-width  as decimal   no-undo .
     1259     define variable v-browse-width         as decimal   no-undo .
     1260     define variable v-window-width         as decimal   no-undo .
     1261     define variable v-window-virtual-width as decimal   no-undo .
     1262     define variable v-change-sign          as integer   no-undo .
     1263     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1264     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1265     if p-change-value > 0
     1266     then do:
     1267       if frame Dialog-Frame :width + p-change-value >
     1268           session :width-chars
     1269       then do:
     1270         assign
     1271           p-change-value = session :width-chars - frame Dialog-Frame :width
     1272         .
     1273         if p-change-value <= 0
     1274         then do:
     1275           run diasize_position-resize-button in this-procedure .
     1276           return .
     1277         end.
     1278       end.
     1279     end.
     1280     if p-change-value < 0
     1281     then do:
     1282       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1283       then do:
     1284         assign
     1285           p-change-value = v-diasize-orig-frame-width
     1286                          - frame Dialog-Frame :width
     1287         .
     1288         if p-change-value >= 0
     1289         then do:
     1290           run diasize_position-resize-button in this-procedure .
     1291           return .
     1292         end.
     1293       end.
     1294     end.
     1295     if p-change-value >= 0
     1296     then do:
     1297       assign
     1298         v-change-sign = 1
     1299       .
     1300     end.
     1301     else do:
     1302       assign
     1303         v-change-sign = -1
     1304       .
     1305     end.
     1306     assign
     1307       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1308     .
     1309     if p-change-value = 0
     1310     then do:
     1311       run diasize_position-resize-button in this-procedure .
     1312       return .
     1313     end.
     1314     move_block:
     1315     do
     1316     on error undo move_block, leave move_block
     1317     :
     1318       if retry
     1319       then do:
     1320         do
