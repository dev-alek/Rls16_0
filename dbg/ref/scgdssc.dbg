      682       (input  v-cntxt-db-num
      683       ,input  v-cntxt-userid
      684       ,input  0
      685       ,input  'actn_scales_another_obj':U
      686       ,input  'global':U
      687       ,input  0
      688       ,input  '':U
      689       ,input  0
      690       ,input  0
      691       ,input  0
      692       ,input  0
      693       ,input  true
      694       ,output glog
      695       )  .
      696   end.
      697             if not glog then do :
      698               assign
      699                 rs-all-shop = 1
      700               .
      701               DISPLAY
