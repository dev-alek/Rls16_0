      725     end case.
      726      OPEN QUERY br-scales FOR EACH ub.scales-gds       WHERE scales-gds.db-num = p-db-num AND scales-gds.b-code = p-b-code  AND (scales-gds.obj-type = v-obj-type or v-obj-type = "")  AND (scales-gds.obj-code = v-obj-code or v-obj-code = 0) NO-LOCK,       EACH ub.scales WHERE (scales.db-num = scales-gds.db-num AND scales.scales-num = scales-gds.scales-num)   OR (scales.db-num = scales-gds.db-num AND  scales.master = scales-gds.scales-num) NO-LOCK,       EACH ub.bar-code WHERE bar-code.b-code = scales-gds.b-code NO-LOCK,       EACH ub.gds-obj-attr WHERE TRUE        AND gds-obj-attr.obj-type = scales-gds.obj-type  AND gds-obj-attr.obj-code = scales-gds.obj-code  AND gds-obj-attr.gds-code = bar-code.gds-code  AND gds-obj-attr.attr-code = 'scales-code':U NO-LOCK.
      727      APPLY "ENTRY" to br-scales.
      728   END.
      729   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      730   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      731   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      732   on help of frame Dialog-Frame
      733   do:
      734     run gbl/app_help.p
      735       (input this-procedure :file-name
      736       ,input ''
      737       ,input ?
      738       ) no-error.
      739     if error-status :error then do:
      740       message
      741         "Ошибка при вызове помощи"
      742         error-status :get-message(1)
      743         view-as alert-box .
      744     end.
