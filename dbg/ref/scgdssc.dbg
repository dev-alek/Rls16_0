     1169           end.
     1170         end.
     1171         assign
     1172           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1173           no-error .
     1174         if error-status :error
     1175         or error-status :get-message(1) <> ""
     1176         then do:
     1177           undo move_block, retry move_block .
     1178         end.
     1179         for each buf_temp-browse-handle
     1180           where buf_temp-browse-handle.browse-type = 'height':u
     1181         on error undo move_block, retry move_block
     1182         :
     1183           assign
     1184             buf_temp-browse-handle.browse-handle :height
     1185               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1186             no-error .
     1187           if error-status :error
     1188           or error-status :get-message(1) <> ""
     1189           then do:
     1190             undo move_block, retry move_block .
     1191           end.
     1192         end.
