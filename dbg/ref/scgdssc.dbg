      625     APPLY "END-ERROR":U TO SELF.
      626   END.
      627   ON CHOOSE OF B-add IN FRAME Dialog-Frame
      628   DO:
      629     run proc-b-add in this-procedure no-error.
      630     if error-status:error then return no-apply.
      631     OPEN QUERY br-scales FOR EACH ub.scales-gds       WHERE scales-gds.db-num = p-db-num AND scales-gds.b-code = p-b-code  AND (scales-gds.obj-type = v-obj-type or v-obj-type = "")  AND (scales-gds.obj-code = v-obj-code or v-obj-code = 0) NO-LOCK,       EACH ub.scales WHERE (scales.db-num = scales-gds.db-num AND scales.scales-num = scales-gds.scales-num)   OR (scales.db-num = scales-gds.db-num AND  scales.master = scales-gds.scales-num) NO-LOCK,       EACH ub.bar-code WHERE bar-code.b-code = scales-gds.b-code NO-LOCK,       EACH ub.gds-obj-attr WHERE TRUE        AND gds-obj-attr.obj-type = scales-gds.obj-type  AND gds-obj-attr.obj-code = scales-gds.obj-code  AND gds-obj-attr.gds-code = bar-code.gds-code  AND gds-obj-attr.attr-code = 'scales-code':U NO-LOCK.
      632     APPLY "ENTRY" to br-scales.
      633   END.
      634   ON CHOOSE OF B-scales IN FRAME Dialog-Frame
      635   DO:
      636     def buffer m-scales for ub.scales.
      637     if not avail ub.scales-gds then return no-apply.
      638     if ub.scales.master > 0 then do:
      639           find first m-scales no-lock where
      640                    m-scales.db-num = ub.scales.db-num
      641                AND m-scales.scales-num = ub.scales.master No-ERROR.
      642       message "Для просмотра товаров на весах"  skip
      643                   "выберите соответствующие главные весы"
      644                   (if avail m-scales
      645                   then ("N ":U + string(m-scales.scales-num) + chr(32) + m-scales.scales-name)
      646                   else "")
      647       view-as alert-box.
      648       return no-apply.
      649     end.
      650     run proc-select-scales in this-procedure (buffer scales-gds).
      651   END.
      652   ON MOUSE-SELECT-DBLCLICK OF br-scales IN FRAME Dialog-Frame
      653   DO:
      654     if not avail ub.scales-gds then return no-apply.
      655       run proc-select-scales in this-procedure (buffer ub.scales-gds).
      656   END.
      657   ON RETURN OF br-scales IN FRAME Dialog-Frame
      658   DO:
      659     if not avail ub.scales-gds then return no-apply.
      660       run proc-select-scales in this-procedure (buffer ub.scales-gds).
      661   END.
      662   ON VALUE-CHANGED OF RS-all-shop IN FRAME Dialog-Frame
