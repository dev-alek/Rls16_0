      865   procedure diasize_change-height :
      866     define input  parameter p-change-value  as decimal   no-undo .
      867     define input  parameter p-move-resize   as logical   no-undo .
      868     define variable v-field-group-handle    as handle    no-undo .
      869     define variable v-object-handle         as handle    no-undo .
      870     define variable v-frame-height          as decimal   no-undo .
      871     define variable v-frame-virtual-height  as decimal   no-undo .
      872     define variable v-browse-height         as decimal   no-undo .
      873     define variable v-window-height         as decimal   no-undo .
      874     define variable v-window-virtual-height as decimal   no-undo .
      875     define variable v-change-sign           as integer   no-undo .
      876     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      877     define buffer buf_temp-browse-handle  for temp-browse-handle .
      878     if p-change-value > 0
      879     then do:
      880       if frame Dialog-Frame :height + p-change-value
      881           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      882       then do:
      883         assign
      884           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      885                           - (frame Dialog-Frame :height-chars)
      886         .
      887         if p-change-value <= 0
      888         then do:
      889           run diasize_position-resize-button in this-procedure .
      890           return .
      891         end.
      892       end.
      893     end.
      894     if p-change-value < 0
      895     then do:
      896       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      897       then do:
      898         assign
      899           p-change-value = v-diasize-orig-frame-height
      900                          - (frame Dialog-Frame :height-chars)
      901         .
      902         if p-change-value >= 0
      903         then do:
      904           run diasize_position-resize-button in this-procedure .
      905           return .
      906         end.
      907       end.
      908     end.
      909     if p-change-value >= 0
      910     then do:
      911       assign
      912         v-change-sign = 1
      913       .
      914     end.
      915     else do:
      916       assign
      917         v-change-sign = -1
      918       .
      919     end.
      920     assign
      921       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      922     .
      923     if p-change-value = 0
      924     then do:
      925       run diasize_position-resize-button in this-procedure .
      926       return .
      927     end.
      928     move_block:
      929     do
      930     on error undo move_block, retry move_block
      931     :
      932       if retry
      933       then do:
      934         do
      935         on error undo move_block, leave move_block
      936         :
      937           if p-change-value > 0
      938           then do:
      939             for each buf_temp-diasize-handle
      940             on error undo, next
      941             :
      942               assign
      943                 v-object-handle = buf_temp-diasize-handle.handle-value
      944               .
      945               if v-object-handle <> v-diasize-resize-button
      946               then do:
      947                 assign
      948                   v-object-handle :row = buf_temp-diasize-handle.save-position
      949                 .
      950               end.
      951             end.
      952             assign
      953               v-diasize-browse-handle :height = v-browse-height
      954             .
      955             for each buf_temp-browse-handle
      956               where buf_temp-browse-handle.browse-type = 'height':u
      957             on error undo, next
      958             :
      959               assign
      960                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      961               .
      962             end.
      963             assign
      964               frame Dialog-Frame :height = v-frame-height
      965             .
      966             if frame Dialog-Frame :scrollable = true
      967             then do:
      968               assign
      969                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      970               .
      971             end.
      972             run diasize_position-resize-button in this-procedure .
      973           end.
      974           else do:
      975             if frame Dialog-Frame :scrollable = true
      976             then do:
      977               assign
      978                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      979               .
      980             end.
      981             assign
      982               frame Dialog-Frame :height = v-frame-height
      983             .
      984             assign
      985               v-diasize-browse-handle :height = v-browse-height
      986             .
      987             for each buf_temp-browse-handle
      988               where buf_temp-browse-handle.browse-type = 'height':u
      989             on error undo, next
      990             :
      991               assign
      992                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      993               .
      994             end.
      995             for each buf_temp-diasize-handle
      996             on error undo, next
      997             :
      998               assign
      999                 v-object-handle = buf_temp-diasize-handle.handle-value
     1000               .
     1001               if v-object-handle <> v-diasize-resize-button
     1002               then do:
     1003                 assign
     1004                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1005                 .
     1006               end.
     1007             end.
     1008             run diasize_position-resize-button in this-procedure .
     1009           end.
     1010           assign
     1011             v-diasize-change-size = false
     1012           .
     1013           leave move_block .
     1014         end.
     1015       end.
     1016       assign
     1017         v-diasize-need-full-display = true
     1018       .
     1019       if v-diasize-change-size = false
     1020       then do:
     1021         assign
     1022           v-diasize-change-size = true
     1023         .
     1024       end.
     1025       else do:
     1026         return .
     1027       end.
     1028       assign
     1029         v-frame-height = frame Dialog-Frame :height
     1030         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1031         v-browse-height = v-diasize-browse-handle :height
     1032       .
     1033       for each buf_temp-browse-handle
     1034         where buf_temp-browse-handle.browse-type = 'height':u
     1035       :
     1036         assign
     1037           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1038         .
     1039       end.
     1040       for each buf_temp-diasize-handle
     1041       :
     1042         delete buf_temp-diasize-handle .
     1043       end.
     1044       assign
     1045         v-field-group-handle = frame Dialog-Frame :first-child
     1046       .
     1047       do while valid-handle(v-field-group-handle)
     1048       :
     1049         assign
     1050           v-object-handle = v-field-group-handle :first-child
     1051         .
     1052         do while valid-handle(v-object-handle)
     1053         :
     1054           if  v-object-handle <> v-diasize-browse-handle :handle
     1055           and can-query(v-object-handle, "row")
     1056           and can-query(v-object-handle, "height")
     1057           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1058           then do:
     1059             find first buf_temp-browse-handle
     1060               where buf_temp-browse-handle.browse-type   = 'height':u
     1061                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1062               no-error .
     1063             if available buf_temp-browse-handle
     1064             then do:
     1065             end.
     1066             else do:
     1067               create buf_temp-diasize-handle .
     1068               assign
     1069                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1070                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1071               .
     1072             end.
     1073           end.
     1074           assign
     1075             v-object-handle = v-object-handle :next-sibling
     1076           .
     1077         end.
     1078         assign
     1079           v-field-group-handle = v-field-group-handle :next-sibling
     1080         .
     1081       end.
     1082       do with frame Dialog-Frame
     1083       :
     1084         hide v-diasize-resize-button .
     1085         assign
     1086           v-diasize-resize-button :row    = 1
     1087           v-diasize-resize-button :column = 1
     1088         .
     1089       end.
     1090       if p-change-value > 0
     1091       then do:
     1092         if frame Dialog-Frame :scrollable = true
     1093         then do:
     1094           assign
     1095             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1096             no-error .
     1097           if error-status :error
     1098           or error-status :get-message(1) <> ""
     1099           then do:
     1100             undo move_block, retry move_block .
     1101           end.
     1102         end.
     1103         assign
     1104           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1105           no-error .
     1106         if error-status :error
     1107         or error-status :get-message(1) <> ""
     1108         then do:
     1109           undo move_block, retry move_block .
     1110         end.
     1111         assign
     1112           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1113           no-error .
     1114         if error-status :error
     1115         or error-status :get-message(1) <> ""
     1116         then do:
     1117           undo move_block, retry move_block .
     1118         end.
     1119         for each buf_temp-browse-handle
     1120           where buf_temp-browse-handle.browse-type = 'height':u
     1121         on error undo move_block, retry move_block
     1122         :
     1123           assign
     1124             buf_temp-browse-handle.browse-handle :height
     1125               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1126             no-error .
     1127           if error-status :error
     1128           or error-status :get-message(1) <> ""
     1129           then do:
     1130             undo move_block, retry move_block .
     1131           end.
     1132         end.
     1133         for each buf_temp-diasize-handle
     1134         on error undo move_block, retry move_block
     1135         :
     1136           assign
     1137             v-object-handle = buf_temp-diasize-handle.handle-value
     1138           .
     1139           if v-object-handle <> v-diasize-resize-button
     1140           then do:
     1141             assign
     1142               v-object-handle :row = v-object-handle :row + p-change-value
     1143               no-error .
     1144             if error-status :error
     1145             or error-status :get-message(1) <> ""
     1146             then do:
     1147               undo move_block, retry move_block .
     1148             end.
     1149           end.
     1150         end.
     1151       end.
     1152       else do:
     1153         for each buf_temp-diasize-handle
     1154         on error undo move_block, retry move_block
     1155         :
     1156           assign
     1157             v-object-handle = buf_temp-diasize-handle.handle-value
     1158           .
     1159           if v-object-handle <> v-diasize-resize-button
     1160           then do:
     1161             assign
     1162               v-object-handle :row = v-object-handle :row + p-change-value
