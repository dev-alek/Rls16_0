     1612     if error-status:error then return no-apply.
     1613   END.
     1614   ON RETURN OF sch-corr-user-name IN FRAME Dialog-Frame
     1615   DO:
     1616     run proc-find-user in this-procedure ( no, input frame Dialog-Frame sch-corr-user-name) no-error.
     1617     if error-status:error then return no-apply.
     1618   END.
     1619   ON CTRL-J OF sch-d-card IN FRAME Dialog-Frame
     1620   DO:
     1621     run proc-find-d-card in this-procedure ( yes, input frame Dialog-Frame sch-d-card) no-error.
     1622     if error-status:error then return no-apply.
     1623   END.
     1624   ON RETURN OF sch-d-card IN FRAME Dialog-Frame
