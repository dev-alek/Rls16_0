      711   procedure prn-lib-open-stream :
      712     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      713     define input parameter p-page-size    as integer no-undo .
      714     define input parameter p-is-stream    as logical no-undo .
      715     define input parameter p-append       as logical no-undo .
      716     define variable v-report-name as character no-undo .
      717     do
      718       on error undo, return error
      719       :
      720       run prn-lib-get-report-name  in this-procedure (
      721         input parParentProc
      722         ,output v-report-name
      723         ).
      724       if p-is-stream then
      725       do:
      726         if p-append then
      727         do:
      728           output stream PrnLibStream to value( v-report-name )
      729             page-size value(p-page-size) append .
      730         end.
      731         if not p-append then
      732         do:
      733           output stream PrnLibStream to value( v-report-name )
      734             page-size value(p-page-size) .
      735         end.
      736       end.
      737       if not p-is-stream then
      738       do:
      739         if p-append then
      740         do:
      741           output to value( v-report-name )
      742             page-size value(p-page-size) append .
      743         end.
      744         if not p-append then
      745         do:
      746           output to value( v-report-name )
      747             page-size value(p-page-size) .
      748         end.
      749       end.
      750     end.
      751   end procedure.
      752   procedure prn-lib-open-exp :
      753     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      754     define input parameter p-is-stream    as logical no-undo .
      755     define input parameter p-is-append    as logical no-undo .
      756     define output parameter p-ReportFileName as char init "report" no-undo.
      757     define output parameter p-process as logical no-undo .
      758     define variable glog as logical no-undo .
      759     do
      760       on error undo, return error
      761       :
      762       SYSTEM-DIALOG GET-FILE p-ReportFileName
      763         TITLE      "Укажите путь"
      764         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      765         ASK-OVERWRITE
      766         CREATE-TEST-FILE
      767         SAVE-AS
      768         USE-FILENAME
      769         DEFAULT-EXTENSION "txt"
      770         UPDATE glog
      771         .
      772       if not glog then  return.
      773       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      774       if p-is-stream then
      775       do:
      776         if p-is-append then
      777         do:
      778           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      779         end.
      780         else
      781         do:
      782           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      783         end.
      784       end.
      785       else
      786       do:
      787         if p-is-append then
      788         do:
      789           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      790         end.
      791         else
      792         do:
      793           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      794         end.
      795       end.
      796       p-process = yes.
      797     end.
      798   end procedure.
