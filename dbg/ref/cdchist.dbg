     1639   ON RETURN OF v-corr-user-db-num IN FRAME Dialog-Frame
     1640   DO:
     1641     assign
     1642     v-corr-user-db-num
     1643     .
     1644     RUn OpenBR in this-procedure ( input yes, input no, input '':U, input v-corr-user-db-num).
     1645   END.
     1646   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1647   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1648   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1649   on help of frame Dialog-Frame
     1650   do:
     1651     run gbl/app_help.p
     1652       (input this-procedure :file-name
     1653       ,input ''
     1654       ,input ?
     1655       ) no-error.
     1656     if error-status :error then do:
     1657       message
     1658         "Ошибка при вызове помощи"
     1659         error-status :get-message(1)
     1660         view-as alert-box .
     1661     end.
     1662   end.
     1663   run minbtn-set in this-procedure .
     1664   on choose of b-help in frame Dialog-Frame
     1665   do:
     1666     apply "help":u to frame Dialog-Frame .
     1667   end.
     1668   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1669   procedure minbtn-set :
     1670       do
     1671           on error undo, return error return-value
     1672           :
     1673           define variable ii              as integer       no-undo .
     1674           define variable fh              as widget-handle no-undo .
     1675           define variable hh              as widget-handle no-undo .
     1676           define variable v-h             as handle        extent 4 no-undo .
     1677           define variable v-name-button   as character     no-undo .
     1678           define variable v-help-old-x    as decimal       no-undo .
     1679           define variable v-help-old-y    as decimal       no-undo .
     1680           define variable v-help-old-size as decimal       no-undo .
     1681           define variable v-frame-width   as decimal       no-undo .
     1682           define variable jj              as integer       no-undo .
     1683           do
     1684               on error undo, return error
     1685               :
     1686               assign
     1687                   v-frame-width = frame Dialog-Frame:width - 0.3
     1688                   fh            = frame Dialog-Frame:first-child
     1689                   hh            = fh:first-child
     1690                   ii            = 1
     1691                   .
     1692               do while valid-handle(hh):
     1693                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1694                   do:
     1695                       case lc(hh:name) :
     1696                           when "b-help" then
     1697                               do:
     1698                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1699                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1700                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1701                                   hh:TOOLTIP = "Помощь" .
     1702                                   v-help-old-x = hh:column .
     1703                                   v-help-old-y = hh:row    .
     1704                                   v-help-old-size = hh:width .
     1705                                   hh:width-chars = 2.5 .
     1706                               end.
     1707                           when "b-print" then
     1708                               do:
     1709                                   hh:load-image("cmp/b-print.bmp":u) .
     1710                                   hh:TOOLTIP = "Печать" .
     1711                                   v-h[ii] = hh:handle .
     1712                                   ii = ii + 1 .
     1713                                   hh:width-chars = 3 .
     1714                               end.
     1715                           when "b-history" or
     1716                           when "b-hist" then
     1717                               do:
     1718                                   hh:load-image("cmp/b-hist.bmp":u) .
     1719                                   hh:TOOLTIP = "История" .
     1720                                   v-h[ii] = hh:handle .
     1721                                   ii = ii + 1 .
     1722                                   hh:width-chars = 3 .
     1723                               end.
     1724                           when "b-sch" then
     1725                               do:
     1726                                   hh:load-image("cmp/b-sch.bmp":u) .
     1727                                   hh:TOOLTIP = "Установка Фильтра" .
     1728                                   v-h[ii] = hh:handle .
     1729                                   ii = ii + 1 .
     1730                                   hh:width-chars = 3 .
     1731                               end.
     1732                           when "b-hist-user" then
     1733                               do:
     1734                                   hh:load-image("cmp/b-hist.bmp":u) .
     1735                                   hh:TOOLTIP = "История пользователя" .
     1736                                   ii = ii + 1 .
     1737                               end.
     1738                       end case.
     1739                   end.
     1740                   hh = hh:next-sibling.
     1741               end.
     1742               b-help:column = v-frame-width - b-help:width-chars.
     1743               jj = 0.
     1744               repeat ii = 4 to 1 by -1 :
     1745                   if valid-handle (v-h[ii] ) then
     1746                   do:
     1747                       jj  = jj + 1 .
     1748                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1749                       v-h[ii]:row    = v-help-old-y .
     1750                   end.
     1751               end.
     1752           end.
     1753       end.
     1754   end procedure.
     1755   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1756   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1757   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1758   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1759   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1760   define variable v-diasize-current-frame-height as decimal   no-undo .
     1761   define variable v-diasize-change-size          as logical   no-undo .
     1762   define variable v-diasize-resize-button        as handle    no-undo .
     1763   define variable v-diasize-wndmax               as logical   no-undo .
     1764   define variable v-diasize-wndstore             as logical   no-undo .
     1765   define variable v-diasize-proc-name            as character no-undo .
     1766   define variable v-diasize-browse-handle        as handle    no-undo .
     1767   define variable v-diasize-browse-number        as integer   no-undo .
     1768   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1769   define temp-table temp-diasize-handle no-undo
     1770     field handle-value  as handle
     1771     field save-position as decimal
     1772     index xpk is primary unique handle-value
     1773     .
     1774   define temp-table temp-browse-handle no-undo
     1775     field browse-type   as character
     1776     field browse-number as integer
     1777     field browse-handle as handle
     1778     field original-size as decimal
     1779     index xpk is primary unique browse-type browse-number
     1780     index xie browse-type browse-handle
     1781   .
     1782   procedure diasize_change-height :
     1783     define input  parameter p-change-value  as decimal   no-undo .
     1784     define input  parameter p-move-resize   as logical   no-undo .
     1785     define variable v-field-group-handle    as handle    no-undo .
     1786     define variable v-object-handle         as handle    no-undo .
     1787     define variable v-frame-height          as decimal   no-undo .
     1788     define variable v-frame-virtual-height  as decimal   no-undo .
     1789     define variable v-browse-height         as decimal   no-undo .
     1790     define variable v-window-height         as decimal   no-undo .
     1791     define variable v-window-virtual-height as decimal   no-undo .
     1792     define variable v-change-sign           as integer   no-undo .
     1793     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1794     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1795     if p-change-value > 0
     1796     then do:
     1797       if frame Dialog-Frame :height + p-change-value
     1798           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1799       then do:
     1800         assign
     1801           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1802                           - (frame Dialog-Frame :height-chars)
     1803         .
     1804         if p-change-value <= 0
     1805         then do:
     1806           run diasize_position-resize-button in this-procedure .
     1807           return .
     1808         end.
     1809       end.
     1810     end.
     1811     if p-change-value < 0
     1812     then do:
     1813       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1814       then do:
     1815         assign
     1816           p-change-value = v-diasize-orig-frame-height
     1817                          - (frame Dialog-Frame :height-chars)
     1818         .
     1819         if p-change-value >= 0
     1820         then do:
     1821           run diasize_position-resize-button in this-procedure .
     1822           return .
     1823         end.
     1824       end.
     1825     end.
     1826     if p-change-value >= 0
     1827     then do:
     1828       assign
     1829         v-change-sign = 1
     1830       .
     1831     end.
     1832     else do:
     1833       assign
     1834         v-change-sign = -1
     1835       .
     1836     end.
     1837     assign
     1838       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1839     .
     1840     if p-change-value = 0
     1841     then do:
     1842       run diasize_position-resize-button in this-procedure .
     1843       return .
     1844     end.
     1845     move_block:
     1846     do
     1847     on error undo move_block, retry move_block
     1848     :
     1849       if retry
     1850       then do:
     1851         do
     1852         on error undo move_block, leave move_block
     1853         :
     1854           if p-change-value > 0
     1855           then do:
     1856             for each buf_temp-diasize-handle
     1857             on error undo, next
     1858             :
     1859               assign
     1860                 v-object-handle = buf_temp-diasize-handle.handle-value
     1861               .
     1862               if v-object-handle <> v-diasize-resize-button
     1863               then do:
     1864                 assign
     1865                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1866                 .
     1867               end.
     1868             end.
     1869             assign
     1870               v-diasize-browse-handle :height = v-browse-height
     1871             .
     1872             for each buf_temp-browse-handle
     1873               where buf_temp-browse-handle.browse-type = 'height':u
     1874             on error undo, next
     1875             :
     1876               assign
     1877                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1878               .
     1879             end.
     1880             assign
     1881               frame Dialog-Frame :height = v-frame-height
     1882             .
     1883             if frame Dialog-Frame :scrollable = true
     1884             then do:
     1885               assign
     1886                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1887               .
     1888             end.
     1889             run diasize_position-resize-button in this-procedure .
     1890           end.
     1891           else do:
     1892             if frame Dialog-Frame :scrollable = true
     1893             then do:
     1894               assign
     1895                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1896               .
     1897             end.
     1898             assign
     1899               frame Dialog-Frame :height = v-frame-height
     1900             .
     1901             assign
     1902               v-diasize-browse-handle :height = v-browse-height
     1903             .
     1904             for each buf_temp-browse-handle
     1905               where buf_temp-browse-handle.browse-type = 'height':u
     1906             on error undo, next
     1907             :
     1908               assign
     1909                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1910               .
     1911             end.
     1912             for each buf_temp-diasize-handle
     1913             on error undo, next
     1914             :
     1915               assign
     1916                 v-object-handle = buf_temp-diasize-handle.handle-value
     1917               .
     1918               if v-object-handle <> v-diasize-resize-button
     1919               then do:
     1920                 assign
     1921                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1922                 .
     1923               end.
     1924             end.
     1925             run diasize_position-resize-button in this-procedure .
     1926           end.
     1927           assign
     1928             v-diasize-change-size = false
     1929           .
     1930           leave move_block .
     1931         end.
     1932       end.
     1933       assign
     1934         v-diasize-need-full-display = true
     1935       .
     1936       if v-diasize-change-size = false
     1937       then do:
     1938         assign
     1939           v-diasize-change-size = true
     1940         .
     1941       end.
     1942       else do:
     1943         return .
     1944       end.
     1945       assign
     1946         v-frame-height = frame Dialog-Frame :height
     1947         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1948         v-browse-height = v-diasize-browse-handle :height
     1949       .
     1950       for each buf_temp-browse-handle
     1951         where buf_temp-browse-handle.browse-type = 'height':u
     1952       :
     1953         assign
     1954           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1955         .
     1956       end.
     1957       for each buf_temp-diasize-handle
     1958       :
     1959         delete buf_temp-diasize-handle .
     1960       end.
     1961       assign
     1962         v-field-group-handle = frame Dialog-Frame :first-child
     1963       .
     1964       do while valid-handle(v-field-group-handle)
     1965       :
     1966         assign
     1967           v-object-handle = v-field-group-handle :first-child
     1968         .
     1969         do while valid-handle(v-object-handle)
     1970         :
     1971           if  v-object-handle <> v-diasize-browse-handle :handle
     1972           and can-query(v-object-handle, "row")
     1973           and can-query(v-object-handle, "height")
     1974           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1975           then do:
     1976             find first buf_temp-browse-handle
     1977               where buf_temp-browse-handle.browse-type   = 'height':u
     1978                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1979               no-error .
     1980             if available buf_temp-browse-handle
     1981             then do:
     1982             end.
     1983             else do:
     1984               create buf_temp-diasize-handle .
     1985               assign
     1986                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1987                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1988               .
     1989             end.
     1990           end.
     1991           assign
     1992             v-object-handle = v-object-handle :next-sibling
     1993           .
     1994         end.
     1995         assign
     1996           v-field-group-handle = v-field-group-handle :next-sibling
     1997         .
     1998       end.
     1999       do with frame Dialog-Frame
     2000       :
     2001         hide v-diasize-resize-button .
     2002         assign
     2003           v-diasize-resize-button :row    = 1
     2004           v-diasize-resize-button :column = 1
     2005         .
     2006       end.
     2007       if p-change-value > 0
     2008       then do:
     2009         if frame Dialog-Frame :scrollable = true
     2010         then do:
     2011           assign
     2012             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2013             no-error .
     2014           if error-status :error
     2015           or error-status :get-message(1) <> ""
     2016           then do:
     2017             undo move_block, retry move_block .
     2018           end.
     2019         end.
     2020         assign
     2021           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2022           no-error .
     2023         if error-status :error
     2024         or error-status :get-message(1) <> ""
     2025         then do:
     2026           undo move_block, retry move_block .
     2027         end.
     2028         assign
     2029           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2030           no-error .
     2031         if error-status :error
     2032         or error-status :get-message(1) <> ""
     2033         then do:
     2034           undo move_block, retry move_block .
     2035         end.
     2036         for each buf_temp-browse-handle
     2037           where buf_temp-browse-handle.browse-type = 'height':u
     2038         on error undo move_block, retry move_block
     2039         :
     2040           assign
     2041             buf_temp-browse-handle.browse-handle :height
     2042               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2043             no-error .
     2044           if error-status :error
     2045           or error-status :get-message(1) <> ""
     2046           then do:
     2047             undo move_block, retry move_block .
     2048           end.
     2049         end.
     2050         for each buf_temp-diasize-handle
     2051         on error undo move_block, retry move_block
     2052         :
     2053           assign
     2054             v-object-handle = buf_temp-diasize-handle.handle-value
     2055           .
     2056           if v-object-handle <> v-diasize-resize-button
     2057           then do:
     2058             assign
     2059               v-object-handle :row = v-object-handle :row + p-change-value
     2060               no-error .
     2061             if error-status :error
     2062             or error-status :get-message(1) <> ""
     2063             then do:
     2064               undo move_block, retry move_block .
     2065             end.
     2066           end.
     2067         end.
     2068       end.
     2069       else do:
     2070         for each buf_temp-diasize-handle
     2071         on error undo move_block, retry move_block
     2072         :
     2073           assign
     2074             v-object-handle = buf_temp-diasize-handle.handle-value
     2075           .
     2076           if v-object-handle <> v-diasize-resize-button
     2077           then do:
     2078             assign
     2079               v-object-handle :row = v-object-handle :row + p-change-value
     2080               no-error .
     2081             if error-status :error
     2082             or error-status :get-message(1) <> ""
     2083             then do:
     2084               undo move_block, retry move_block .
     2085             end.
     2086           end.
     2087         end.
     2088         assign
     2089           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2090           no-error .
     2091         if error-status :error
     2092         or error-status :get-message(1) <> ""
     2093         then do:
     2094           undo move_block, retry move_block .
     2095         end.
     2096         for each buf_temp-browse-handle
     2097           where buf_temp-browse-handle.browse-type = 'height':u
     2098         on error undo move_block, retry move_block
     2099         :
     2100           assign
     2101             buf_temp-browse-handle.browse-handle :height
     2102               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2103             no-error .
     2104           if error-status :error
     2105           or error-status :get-message(1) <> ""
     2106           then do:
     2107             undo move_block, retry move_block .
     2108           end.
     2109         end.
     2110         assign
     2111           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2112           no-error .
     2113         if error-status :error
     2114         or error-status :get-message(1) <> ""
     2115         then do:
     2116           undo move_block, retry move_block .
     2117         end.
     2118         if frame Dialog-Frame :scrollable = true
     2119         then do:
     2120           assign
     2121             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2122             no-error .
     2123           if error-status :error
     2124           or error-status :get-message(1) <> ""
     2125           then do:
     2126             undo move_block, retry move_block .
     2127           end.
     2128         end.
     2129       end.
     2130       if p-move-resize = true
     2131       then do:
     2132         run diasize_position-resize-button in this-procedure .
     2133       end.
     2134       if v-diasize-wndstore = true
     2135       then do:
     2136         if connected("ub") = true
     2137         then do:
     2138           define variable v-cntxt-db-num        as integer   no-undo .
     2139           define variable v-cntxt-userid        as character no-undo .
     2140           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2141                                             , OUTPUT v-cntxt-userid
     2142                                             ) .
     2143           run gbl/wndsizew.p
     2144             (input  v-cntxt-db-num
     2145             ,input  v-cntxt-userid
     2146             ,input  v-diasize-proc-name
     2147             ,input  'height':u
     2148             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     2149             ) .
     2150         end.
     2151       end.
     2152     end.
     2153     assign
     2154       v-diasize-change-size = false
     2155     .
     2156   end procedure.
     2157   procedure diasize_set-height :
     2158     define input  parameter p-new-height  as decimal   no-undo .
     2159     define input  parameter p-move-resize as logical   no-undo .
     2160     do
     2161     on error undo, return error return-value
     2162     :
     2163       run diasize_change-height in this-procedure
     2164         (input  (p-new-height - frame Dialog-Frame :height)
     2165         ,input  p-move-resize
     2166         ) .
     2167     end.
     2168   end procedure.
     2169   procedure diasize_change-width :
     2170     define input  parameter p-change-value as decimal   no-undo .
     2171     define input  parameter p-move-resize  as logical   no-undo .
     2172     define variable v-field-group-handle   as handle    no-undo .
     2173     define variable v-object-handle        as handle    no-undo .
     2174     define variable v-frame-width          as decimal   no-undo .
     2175     define variable v-frame-virtual-width  as decimal   no-undo .
     2176     define variable v-browse-width         as decimal   no-undo .
     2177     define variable v-window-width         as decimal   no-undo .
     2178     define variable v-window-virtual-width as decimal   no-undo .
     2179     define variable v-change-sign          as integer   no-undo .
     2180     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2181     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2182     if p-change-value > 0
     2183     then do:
     2184       if frame Dialog-Frame :width + p-change-value >
     2185           session :width-chars
     2186       then do:
     2187         assign
     2188           p-change-value = session :width-chars - frame Dialog-Frame :width
     2189         .
     2190         if p-change-value <= 0
     2191         then do:
     2192           run diasize_position-resize-button in this-procedure .
     2193           return .
     2194         end.
     2195       end.
     2196     end.
     2197     if p-change-value < 0
     2198     then do:
     2199       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     2200       then do:
     2201         assign
     2202           p-change-value = v-diasize-orig-frame-width
     2203                          - frame Dialog-Frame :width
     2204         .
     2205         if p-change-value >= 0
     2206         then do:
     2207           run diasize_position-resize-button in this-procedure .
     2208           return .
     2209         end.
     2210       end.
     2211     end.
     2212     if p-change-value >= 0
     2213     then do:
     2214       assign
     2215         v-change-sign = 1
     2216       .
     2217     end.
     2218     else do:
     2219       assign
     2220         v-change-sign = -1
     2221       .
     2222     end.
     2223     assign
     2224       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2225     .
     2226     if p-change-value = 0
     2227     then do:
     2228       run diasize_position-resize-button in this-procedure .
     2229       return .
     2230     end.
     2231     move_block:
     2232     do
     2233     on error undo move_block, leave move_block
     2234     :
     2235       if retry
     2236       then do:
     2237         do
     2238         on error undo move_block, leave move_block
     2239         :
     2240           if p-change-value > 0
     2241           then do:
     2242             for each buf_temp-diasize-handle
     2243             on error undo, next
     2244             :
     2245               assign
     2246                 v-object-handle = buf_temp-diasize-handle.handle-value
     2247               .
     2248               if v-object-handle <> v-diasize-resize-button
     2249               then do:
     2250                 assign
     2251                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2252                 .
     2253               end.
     2254             end.
     2255             assign
     2256               v-diasize-browse-handle :width = v-browse-width
     2257             .
     2258             for each buf_temp-browse-handle
     2259               where buf_temp-browse-handle.browse-type = 'width':u
     2260             on error undo, next
     2261             :
     2262               assign
     2263                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2264               .
     2265             end.
     2266             assign
     2267               frame Dialog-Frame :width = v-frame-width
     2268             .
     2269             if frame Dialog-Frame :scrollable = true
     2270             then do:
     2271               assign
     2272                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2273               .
     2274             end.
     2275             run diasize_position-resize-button in this-procedure .
     2276           end.
     2277           else do:
     2278             if frame Dialog-Frame :scrollable = true
     2279             then do:
     2280               assign
     2281                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2282               .
     2283             end.
     2284             assign
     2285               frame Dialog-Frame :width = v-frame-width
     2286             .
     2287             for each buf_temp-browse-handle
     2288               where buf_temp-browse-handle.browse-type = 'width':u
     2289             on error undo, next
     2290             :
     2291               assign
     2292                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2293               .
     2294             end.
     2295             assign
     2296               v-diasize-browse-handle :width = v-browse-width
     2297             .
     2298             for each buf_temp-diasize-handle
     2299             on error undo, next
     2300             :
     2301               assign
     2302                 v-object-handle = buf_temp-diasize-handle.handle-value
     2303               .
     2304               if v-object-handle <> v-diasize-resize-button
     2305               then do:
     2306                 assign
     2307                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2308                 .
     2309               end.
     2310             end.
     2311             run diasize_position-resize-button in this-procedure .
     2312           end.
     2313           assign
     2314             v-diasize-change-size = false
     2315           .
     2316           leave move_block .
     2317         end.
     2318       end.
     2319       assign
     2320         v-diasize-need-full-display = true
     2321       .
     2322       if v-diasize-change-size = false
     2323       then do:
     2324         assign
     2325           v-diasize-change-size = true
     2326         .
     2327       end.
     2328       else do:
     2329         return .
     2330       end.
     2331       assign
     2332         v-frame-width = frame Dialog-Frame :width
     2333         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     2334         v-browse-width = v-diasize-browse-handle :width
     2335       .
     2336       for each buf_temp-browse-handle
     2337         where buf_temp-browse-handle.browse-type = 'width':u
     2338       :
     2339         assign
     2340           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2341         .
     2342       end.
     2343       for each buf_temp-diasize-handle
     2344       :
     2345         delete buf_temp-diasize-handle .
     2346       end.
     2347       assign
     2348         v-field-group-handle = frame Dialog-Frame :first-child
     2349       .
     2350       do while valid-handle(v-field-group-handle)
     2351       :
     2352         assign
     2353           v-object-handle = v-field-group-handle :first-child
     2354         .
     2355         do while valid-handle(v-object-handle)
     2356         :
     2357           if  v-object-handle <> v-diasize-browse-handle :handle
     2358           and v-object-handle <> v-diasize-resize-button
     2359           and can-query(v-object-handle, "row")
     2360           and can-query(v-object-handle, "height")
     2361           and ( v-object-handle :col + v-object-handle :width
     2362                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2363               )
     2364           then do:
     2365             find first buf_temp-browse-handle
     2366               where buf_temp-browse-handle.browse-type   = 'width':u
     2367                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2368               no-error .
     2369             if available buf_temp-browse-handle
     2370             then do:
     2371             end.
     2372             else do:
     2373               create buf_temp-diasize-handle .
     2374               assign
     2375                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2376                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2377               .
     2378             end.
     2379           end.
     2380           assign
     2381             v-object-handle = v-object-handle :next-sibling
     2382           .
     2383         end.
     2384         assign
     2385           v-field-group-handle = v-field-group-handle :next-sibling
     2386         .
     2387       end.
     2388       do with frame Dialog-Frame
     2389       :
     2390         hide v-diasize-resize-button .
     2391         v-diasize-resize-button :row = 1.
     2392         v-diasize-resize-button :column = 1.
     2393       end.
     2394       if p-change-value > 0
     2395       then do:
     2396         if frame Dialog-Frame :scrollable = true
     2397         then do:
     2398           assign
     2399             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2400             no-error .
     2401           if error-status :error
     2402           or error-status :get-message(1) <> ""
     2403           then do:
     2404             undo move_block, retry move_block.
     2405           end.
     2406         end.
     2407         assign
     2408           frame Dialog-Frame :width = v-frame-width + p-change-value
     2409           no-error .
     2410         if error-status :error
     2411         or error-status :get-message(1) <> ""
     2412         then do:
     2413           undo move_block, retry move_block.
     2414         end.
     2415         assign
     2416           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2417         no-error .
     2418         if error-status :error
     2419         or error-status :get-message(1) <> ""
     2420         then do:
     2421           undo move_block, retry move_block.
     2422         end.
     2423         for each buf_temp-browse-handle
     2424           where buf_temp-browse-handle.browse-type = 'width':u
     2425         on error undo move_block, retry move_block
     2426         :
     2427           assign
     2428             buf_temp-browse-handle.browse-handle :width
     2429               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2430             no-error .
     2431           if error-status :error
     2432           or error-status :get-message(1) <> ""
     2433           then do:
     2434             undo move_block, retry move_block .
     2435           end.
     2436         end.
     2437         for each buf_temp-diasize-handle
     2438         on error undo move_block, retry move_block
     2439         :
     2440           assign
     2441             v-object-handle = buf_temp-diasize-handle.handle-value
     2442           .
     2443           if v-object-handle <> v-diasize-resize-button
     2444           then do:
     2445             assign
     2446               v-object-handle :col = v-object-handle :col + p-change-value
     2447               no-error .
     2448             if error-status :error
     2449             or error-status :get-message(1) <> ""
     2450             then do:
     2451               undo move_block, retry move_block .
     2452             end.
     2453           end.
     2454         end.
     2455       end.
     2456       else do:
     2457         for each buf_temp-diasize-handle
     2458         on error undo move_block, retry move_block
     2459         :
     2460           assign
     2461             v-object-handle = buf_temp-diasize-handle.handle-value
     2462           .
     2463           if v-object-handle <> v-diasize-resize-button
     2464           then do:
     2465             assign
     2466               v-object-handle :col = v-object-handle :col + p-change-value
     2467               no-error .
     2468             if error-status :error
     2469             or error-status :get-message(1) <> ""
     2470             then do:
     2471               undo move_block, retry move_block .
     2472             end.
     2473           end.
     2474         end.
     2475         for each buf_temp-browse-handle
     2476           where buf_temp-browse-handle.browse-type = 'width':u
     2477         on error undo move_block, retry move_block
     2478         :
     2479           assign
     2480             buf_temp-browse-handle.browse-handle :width
     2481               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2482             no-error .
     2483           if error-status :error
     2484           or error-status :get-message(1) <> ""
     2485           then do:
     2486             undo move_block, retry move_block .
     2487           end.
     2488         end.
     2489         assign
     2490           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2491           no-error .
     2492         if error-status :error
     2493         or error-status :get-message(1) <> ""
     2494         then do:
     2495           undo move_block, retry move_block.
     2496         end.
     2497         assign
     2498           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2499         no-error .
     2500         if error-status :error
     2501         or error-status :get-message(1) <> ""
     2502         then do:
     2503           undo move_block, retry move_block.
     2504         end.
     2505         if frame Dialog-Frame :scrollable = true
     2506         then do:
     2507           assign
     2508             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2509           no-error .
     2510           if error-status :error
     2511           or error-status :get-message(1) <> ""
     2512           then do:
     2513             undo move_block, retry move_block.
     2514           end.
     2515         end.
     2516       end.
     2517       if p-move-resize
     2518       then do:
     2519         run diasize_position-resize-button in this-procedure .
     2520       end.
     2521       if v-diasize-wndstore = true
     2522       then do:
     2523         if connected("ub") = true
     2524         then do:
     2525           define variable v-cntxt-db-num        as integer   no-undo .
     2526           define variable v-cntxt-userid        as character no-undo .
     2527           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2528                                             , OUTPUT v-cntxt-userid
     2529                                             ) .
     2530           run gbl/wndsizew.p
     2531             (input  v-cntxt-db-num
     2532             ,input  v-cntxt-userid
     2533             ,input  v-diasize-proc-name
     2534             ,input  'width':u
     2535             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2536             ) .
     2537         end.
     2538       end.
     2539     end.
     2540     assign
     2541       v-diasize-change-size = false
     2542     .
     2543   end procedure.
     2544   procedure diasize_set-width :
     2545     define input  parameter p-new-width  as decimal   no-undo .
     2546     define input  parameter p-move-resize as logical   no-undo .
     2547     do
     2548     on error undo, return error return-value
     2549     :
     2550       run diasize_change-width in this-procedure
     2551         (input  (p-new-width - frame Dialog-Frame :width)
     2552         ,input  p-move-resize
     2553         ) .
     2554     end.
     2555   end procedure.
     2556   procedure diasize_position-resize-button :
     2557     do with frame Dialog-Frame
     2558     :
     2559       hide v-diasize-resize-button .
     2560       assign
     2561         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2562                     - 1
     2563                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2564         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2565                     - 1
     2566                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2567       .
     2568       view v-diasize-resize-button .
     2569     end.
     2570   end procedure.
     2571   on alt-right anywhere
     2572   do:
     2573     run diasize_change-width in this-procedure
     2574       (input 1
     2575       ,input true
     2576       ) .
     2577     return no-apply .
     2578   end.
     2579   on alt-left anywhere
     2580   do:
     2581     run diasize_change-width in this-procedure
     2582       (input -1
     2583       ,input true
     2584       ) .
     2585     return no-apply .
     2586   end.
     2587   on alt-down anywhere
     2588   do:
     2589     run diasize_change-height in this-procedure
     2590       (input 1
     2591       ,input true
     2592       ) .
     2593     return no-apply .
     2594   end.
     2595   on alt-up anywhere
     2596   do:
     2597     run diasize_change-height in this-procedure
     2598       (input -1
     2599       ,input true
     2600       ) .
     2601     return no-apply .
     2602   end.
     2603   on alt-enter of frame Dialog-Frame
     2604   do:
     2605     run diasize_maximize in this-procedure
     2606       (input  ?
     2607       ).
     2608     return no-apply .
     2609   end.
     2610   procedure diasize_end-move :
     2611     do
     2612     on error undo, return error return-value
     2613     :
     2614       define variable v-row-delta as decimal   no-undo .
     2615       define variable v-col-delta as decimal   no-undo .
     2616       define variable v-new-row as decimal   no-undo .
     2617       define variable v-new-col as decimal   no-undo .
     2618       assign
     2619         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2620         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2621       .
     2622       assign
     2623         v-row-delta = v-new-row - frame Dialog-Frame :height
     2624         v-col-delta = v-new-col - frame Dialog-Frame :width
     2625       .
     2626       run diasize_change-height in this-procedure
     2627         (input v-row-delta
     2628         ,input true
     2629         ) .
     2630       run diasize_change-width in this-procedure
     2631         (input v-col-delta
     2632         ,input true
     2633         ) .
     2634     end.
     2635   end procedure.
     2636   procedure diasize_maximize :
     2637     define input  parameter p-action as logical   no-undo .
     2638     do
     2639     on error undo, return error return-value
     2640     :
     2641       if p-action = ?
     2642       then do:
     2643         if v-diasize-need-maximize = true
     2644         then do:
     2645           assign
     2646             p-action = true
     2647           .
     2648         end.
     2649         else do:
     2650           assign
     2651             p-action = false
     2652           .
     2653         end.
     2654       end.
     2655       if p-action = true
     2656       then do:
     2657         run diasize_change-height in this-procedure
     2658           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2659               - frame Dialog-Frame :height-chars
     2660           ,input true
     2661           ) .
     2662         run diasize_change-width in this-procedure
     2663           (input session :width-chars
     2664               - frame Dialog-Frame :width-chars
     2665           ,input true
     2666           ) .
     2667         assign
     2668           v-diasize-need-maximize = false
     2669         .
     2670       end.
     2671       else do:
     2672         run diasize_change-width in this-procedure
     2673           (input v-diasize-orig-frame-width
     2674               - frame Dialog-Frame :width-chars
     2675           ,input true
     2676           ) .
     2677         run diasize_change-height in this-procedure
     2678           (input v-diasize-orig-frame-height
     2679               - frame Dialog-Frame :height-chars
     2680           ,input true
     2681           ) .
     2682         assign
     2683           v-diasize-need-maximize = true
     2684         .
     2685       end.
     2686     end.
     2687   end procedure.
     2688   procedure diasize_restore-orig-size :
     2689     do
     2690     on error undo, return error return-value
     2691     :
     2692       assign
     2693         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2694         v-diasize-current-frame-height = frame Dialog-Frame :height
     2695       .
     2696       run diasize_set-height in this-procedure
     2697         (input  v-diasize-orig-frame-height
     2698         ,input  true
     2699         ) .
     2700       run diasize_set-width in this-procedure
     2701         (input  v-diasize-orig-frame-width
     2702         ,input  true
     2703         ) .
     2704     end.
     2705   end procedure.
     2706   procedure diasize_restore-current-size :
     2707     do
     2708     on error undo, return error return-value
     2709     :
     2710       run diasize_set-height in this-procedure
     2711         (input  v-diasize-current-frame-height
     2712         ,input  true
     2713         ) .
     2714       run diasize_set-width in this-procedure
     2715         (input  v-diasize-current-frame-width
     2716         ,input  true
     2717         ) .
     2718     end.
     2719   end procedure.
     2720   procedure diasize_set-browse-handle :
     2721     define input  parameter p-browse-handle as handle   no-undo .
     2722     define buffer buf_temp-browse-handle for temp-browse-handle .
     2723     do
     2724     on error undo, return error return-value
     2725     :
     2726       assign
     2727         v-diasize-browse-handle = p-browse-handle
     2728       .
     2729       for each buf_temp-browse-handle
     2730       on error undo, return error return-value
     2731       :
     2732         delete buf_temp-browse-handle .
     2733       end.
     2734     end.
     2735   end procedure.
     2736   procedure diasize_add_browse :
     2737     define input  parameter p-browse-type   as character no-undo .
     2738     define input  parameter p-browse-handle as handle    no-undo .
     2739     define buffer buf_temp-browse-handle for temp-browse-handle .
     2740     do
     2741     on error undo, return error return-value
     2742     :
     2743       assign
     2744         v-diasize-browse-number = v-diasize-browse-number + 1
     2745       .
     2746       create buf_temp-browse-handle .
     2747       assign
     2748         buf_temp-browse-handle.browse-type   = p-browse-type
     2749         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2750         buf_temp-browse-handle.browse-handle = p-browse-handle
     2751       .
     2752     end.
     2753   end procedure.
     2754   procedure diasize_init :
     2755     define variable v-default-value    as logical   no-undo .
     2756     define variable v-restore-saved    as logical   no-undo .
     2757     define variable v-resize-value-str as character no-undo .
     2758     do
     2759     on error undo, return error return-value
     2760     :
     2761       do with frame Dialog-Frame
     2762       :
     2763         assign
     2764           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2765           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2766           v-diasize-browse-handle     = browse br-dc-hist :handle
     2767         .
     2768         create button v-diasize-resize-button
     2769         assign
     2770           parent        = frame Dialog-Frame :first-child
     2771           label         = "s"
     2772           height-pixels = 16
     2773           width-pixels  = 16
     2774           visible       = true
     2775           sensitive     = true
     2776           movable       = true
     2777           triggers:
     2778             on end-move persistent run diasize_end-move in this-procedure .
     2779           end triggers.
     2780         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2781         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2782         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2783         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2784         assign
     2785           v-diasize-wndmax = false
     2786         .
     2787         if connected("ub") = true
     2788         then do:
     2789           define variable v-cntxt-db-num        as integer   no-undo .
     2790           define variable v-cntxt-userid        as character no-undo .
     2791           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2792                                             , OUTPUT v-cntxt-userid
     2793                                             ) .
     2794           run gbl/wndpar_r.p
     2795             (input  v-cntxt-db-num
     2796             ,input  v-cntxt-userid
     2797             ,input  'wndmax':U
     2798             ,output v-diasize-wndmax
     2799             ,output v-default-value
     2800             ) .
     2801         end.
     2802         assign
     2803           v-diasize-wndstore = false
     2804         .
     2805         if connected("ub") = true
     2806         then do:
     2807           run gbl/wndpar_r.p
     2808             (input  v-cntxt-db-num
     2809             ,input  v-cntxt-userid
     2810             ,input  'wndstore':U
     2811             ,output v-diasize-wndstore
     2812             ,output v-default-value
     2813             ) .
     2814         end.
     2815         assign
     2816           v-diasize-proc-name = entry(1, program-name(2), '.')
     2817         .
     2818         if v-diasize-wndstore = true
     2819         then do:
     2820           assign
     2821             v-restore-saved = false
     2822           .
     2823           if connected("ub") = true
     2824           then do:
     2825             run gbl/wndsizer.p
     2826               (input  v-cntxt-db-num
     2827               ,input  v-cntxt-userid
     2828               ,input  v-diasize-proc-name
     2829               ,input  'height':u
     2830               ,output v-resize-value-str
     2831               ) .
     2832             if v-resize-value-str <> '':U
     2833             then do:
     2834               run diasize_change-height in this-procedure
     2835                 (input  integer(v-resize-value-str)
     2836                 ,input  true
     2837                 ) .
     2838               assign
     2839                 v-restore-saved = true
     2840               .
     2841             end.
     2842           end.
     2843           if connected("ub") = true
     2844           then do:
     2845             run gbl/wndsizer.p
     2846               (input  v-cntxt-db-num
     2847               ,input  v-cntxt-userid
     2848               ,input  v-diasize-proc-name
     2849               ,input  'width':u
     2850               ,output v-resize-value-str
     2851               ) .
     2852             if v-resize-value-str <> '':U
     2853             then do:
     2854               run diasize_change-width in this-procedure
     2855                 (input  integer(v-resize-value-str)
     2856                 ,input  true
     2857                 ) .
     2858               assign
     2859                 v-restore-saved = true
     2860               .
     2861             end.
     2862           end.
     2863           if v-restore-saved <> true
     2864           then do:
     2865             if v-diasize-wndmax = true
     2866             then do:
     2867               run diasize_maximize in this-procedure
     2868                 (input  true
     2869                 ) .
     2870             end.
     2871           end.
     2872         end.
     2873         else do:
     2874           if v-diasize-wndmax = true
     2875           then do:
     2876             run diasize_maximize in this-procedure
     2877               (input  true
     2878               ) .
     2879           end.
     2880         end.
     2881       end.
     2882     end.
     2883   end procedure.
     2884   procedure diasize_need-full-display :
     2885     define output parameter p-need-full-display as logical   no-undo .
     2886     do
     2887     on error undo, return error return-value
     2888     :
     2889       assign
     2890         p-need-full-display = v-diasize-need-full-display
     2891       .
     2892       assign
     2893         v-diasize-need-full-display = false
     2894       .
     2895     end.
     2896   end procedure.
     2897   procedure get-context :
     2898      define output parameter p-db-num as integer          no-undo.
     2899      define output parameter p-user-id as character        no-undo.
     2900      define variable v-login               as character    no-undo.
     2901      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2902      define buffer buf_user-login  for ub.user-login .
     2903      do
     2904      on error undo, return error
     2905      :
     2906            FIND FIRST buf_sys-ctrl no-lock.
     2907            ASSIGN
     2908               v-login = USERID("ub")
     2909               p-db-num = buf_sys-ctrl.db-num
     2910            .
     2911            FIND FIRST buf_user-login
     2912                 WHERE buf_user-login.db-num = p-db-num
     2913                   AND buf_user-login.user-login = v-login
     2914                 no-lock
     2915                 no-error
     2916                 .
     2917            IF AVAILABLE buf_user-login
     2918            THEN DO:
     2919               assign
     2920                  p-user-id = buf_user-login.user-id
     2921               .
     2922            END.
     2923      end.
     2924   end procedure.
     2925   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2926   on f5 of frame Dialog-Frame anywhere
