     1629   ON CTRL-J OF sch-db-num IN FRAME Dialog-Frame
     1630   DO:
     1631     run proc-find-db-num in this-procedure ( yes, input frame Dialog-Frame sch-db-num) no-error.
     1632     if error-status:error then return no-apply.
     1633   END.
     1634   ON RETURN OF sch-db-num IN FRAME Dialog-Frame
     1635   DO:
     1636     run proc-find-db-num in this-procedure ( no, input frame Dialog-Frame sch-db-num) no-error.
     1637     if error-status:error then return no-apply.
