     6227       v-doc-rec = recid( X_c-dc-hist )
     6228     .
     6229     do
     6230     on stop undo, leave
     6231     on error undo, leave
     6232     :
     6233       if query br-dc-hist:handle:get-buffer-handle(1) = (buffer X_c-dc-hist:handle) then do:
     6234         assign
     6235         parameter-2-52 = (if p-find-next then "true":u else "false":u )
     6236         parameter-4-52 =
     6237           "where ":u +  substitute(' X_c-dc-hist.corr-user-db-num = &1  AND           X_c-dc-hist.d-card  = &2&3&2 AND            X_c-dc-hist.subject = &2&4&2 AND            X_c-dc-hist.obj-type = &2&5&2 AND            X_c-dc-hist.obj-code = &6 ', p-db-num, chr(34), p-d-card, p-subject , p-obj-type, p-obj-code)  + " ":u + where-phrase-52 + " ":u + p-find-condition + " " + ""
     6238         parameter-5-52 = " use-index ishow "
     6239       .
     6240         run fltopend_fltfindd in this-procedure  (
     6241                             input this-procedure:handle
     6242                             ,input query br-dc-hist:handle
     6243                             ,input rowid(X_c-dc-hist)
     6244                             ,input logical(parameter-2-52)
     6245                             ,input no-lock
     6246                             ,input (buffer X_c-dc-hist:handle)
     6247                             ,input parameter-4-52
     6248                             ,input parameter-5-52
     6249                             ) no-error.
     6250         .
     6251         assign
     6252           v-doc-rec = integer(return-value)
     6253           v-fltopend-rowid[1] = ?
     6254         .
     6255       end.
     6256       else do:
     6257         assign
     6258         parameter-2-52 = (if p-find-next then "true":u else "false":u )
     6259         parameter-3-52 =  "FOR EACH X_c-dc-hist"
     6260         parameter-4-52 =
     6261           (
     6262             if ("           X_c-dc-hist.corr-user-db-num = p-db-num  AND           X_c-dc-hist.d-card  = p-d-card AND            X_c-dc-hist.subject = p-subject AND            X_c-dc-hist.obj-type = p-obj-type AND            X_c-dc-hist.obj-code = p-obj-code                         " + " " + where-phrase-52) <> ""
     6263             then  substitute(' X_c-dc-hist.corr-user-db-num = &1  AND           X_c-dc-hist.d-card  = &2&3&2 AND            X_c-dc-hist.subject = &2&4&2 AND            X_c-dc-hist.obj-type = &2&5&2 AND            X_c-dc-hist.obj-code = &6 ', p-db-num, chr(34), p-d-card, p-subject , p-obj-type, p-obj-code)  + " " + where-phrase-52
     6264             else "true"
     6265           )
     6266         parameter-5-52 = (" " + "" + " " + "" + " " + p-find-condition)
     6267         parameter-6-52 = if sort-phrase-52 = ''
     6268                              then
     6269           (
     6270           " " + " use-index ishow " +
     6271             " " + sort-column-phrase +
     6272           " " + "  "
     6273           )
     6274                              else
     6275           (
     6276           " " + " use-index ishow " +
     6277             " " + sort-column-phrase +
     6278           " " + sort-phrase-52
     6279           )
     6280         parameter-7-52 =
     6281           " indexed-reposition  "
     6282       .
     6283         run fltopend_fltfindq in this-procedure  (
     6284                             input this-procedure:handle
     6285                             ,input query br-dc-hist:handle
     6286                             ,input logical(parameter-2-52)
     6287                             ,input no-lock
     6288                             ,input parameter-3-52
     6289                             ,input parameter-4-52
     6290                             ,input parameter-5-52
     6291                             ,input parameter-6-52
     6292                             ,input parameter-7-52
     6293                             ,output v-fltopend-rowid
     6294                             ) no-error.
     6295         .
     6296         v-doc-rec = ?.
     6297       end.
     6298       assign
     6299         l-query-was-opened = true
     6300       .
     6301     end.
     6302   end.
     6303     run waitfram-hide in this-procedure .
     6304         END.
     6305       END CASE.
     6306     end.
     6307   END CASE.
     6308   if not p-open-query and v-doc-rec <> ?  then
     6309   REPOSITION br-dc-hist to recid v-doc-rec No-ERROR.
     6310   if not p-open-query and v-fltopend-rowid[1] <> ? then
     6311   query br-dc-hist:handle:reposition-to-rowid(v-fltopend-rowid) No-ERROR.
     6312   run waitfram-hide in this-procedure .
     6313   APPLY "VALUE-CHANGED" TO br-dc-hist in frame Dialog-Frame.
     6314   APPLY "ENTRY" TO br-dc-hist.
     6315   END PROCEDURE.
     6316   PROCEDURE proc-b-print :
     6317   define variable date_string     as      char    no-undo.
     6318   define variable Line                as      char    no-undo.
     6319   define variable for-time as char.
     6320   define variable accum-count as integer.
     6321   define variable v-doc-rec as recid no-undo.
     6322   define variable v-subject-chr as character no-undo .
     6323   define variable v-upd-time as character no-undo .
     6324   define variable v-obj as character no-undo .
     6325   define variable v-action-chr as character no-undo .
     6326   define variable v-source-type as character no-undo .
     6327   DEFINE VARIABLE v-for-user-name AS CHARACTER NO-UNDO.
     6328   DEFINE FRAME HistoryList
     6329   v-obj COLUMN-LABEL "Контрагент" FORMAT "X(8)"
     6330   v-action-chr FORMAT "X(10)" COLUMN-LABEL "Действие"
     6331   v-cli      COLUMN-LABEL "Влад-ц карты" FORMAT "X(12)"
     6332   v-cli-name COLUMN-LABEL "Имя влад-ца карты" FORMAT "X(20)"
     6333   v-subject-chr COLUMN-LABEL "Предмет изменений" FORMAT "X(20)"
     6334   X_c-dc-hist.is-news COLUMn-LABEL "СПН" FORMAT "+/ "
     6335   v-source-type COLUMn-LABEL "Источн.!измен"
     6336   X_c-dc-hist.source-ref COLUMn-LABEL "№"
     6337   X_c-dc-hist.corr-date
     6338   v-upd-time COLUMN-LABEL "Время изм." FORMAT "X(8)"
     6339   v-for-user-name COLUMN-LABEL "Изменил" FORMAT "X(18)"
     6340   X_c-dc-hist.corr-user-db-num
     6341   X_c-dc-hist.host-code COLUMN-LABEL "Фирма"
     6342   HEADER  date_string AT 5 format "X(35)"
     6343   string( "Страница " ) format "X(9)" AT 115 PAGE-NUMBER(PrnLibStream) AT 125 FORMAT ">>9" SKIP
     6344   Line format "X(195)" AT 1
     6345   with width 232 down stream-io use-text    .
     6346   Line = fill("-", 195).
     6347   date_string = cur-time-print() .
     6348   assign
     6349   v-doc-rec = recid( X_c-dc-hist ).
     6350   DO WHILE available X_c-dc-hist :
     6351         GET prev br-dc-hist.
     6352   END.
     6353   run prn-lib-open-stream  in this-procedure (
     6354                                                input parparentProc
     6355                                               ,input 43
     6356                                               ,input yes
     6357                                               ,input no
     6358                                               ).
     6359   PUT  STREAM PrnLibStream
     6360   SPACE(25) ( frame Dialog-Frame:title )
     6361   format "x(90)" SKIP(1) .
     6362   FORM HEADER
     6363   Line format "X(180)" AT 1 SKIP
     6364   "Продолжение - на следующей странице" AT 30 SKIP
     6365   with FRAME BottomFrame width 232 PAGE-BOTTOM NO-LABELS NO-BOX .
     6366   VIEW  STREAM PrnLibStream FRAME BottomFrame .
     6367   FORM with FRAME HistoryList  .
     6368   run waitfram-show in this-procedure ( input "Ждите...").
     6369     GET next br-dc-hist.
     6370       DO WHILE available X_c-dc-hist :
     6371         Display STREAM PrnLibStream
     6372          X_c-dc-hist.obj-type + string(X_c-dc-hist.obj-code) @ v-obj
     6373         get-action(X_c-dc-hist.action) @ v-action-chr
     6374         (if v-find then get-cli(X_c-dc-hist.d-card) else "":U )  @ v-cli
     6375         v-cli-name
     6376         get-subject(X_c-dc-hist.subject) @ v-subject-chr
     6377         X_c-dc-hist.is-news
     6378         get-source-type(X_c-dc-hist.source-type) @ v-source-type
     6379         X_c-dc-hist.source-ref
     6380         X_c-dc-hist.corr-date
     6381         string(X_c-dc-hist.corr-time, "HH:MM:SS":U) @ v-upd-time
     6382         usrfulnf(X_c-dc-hist.corr-user-name) @ v-for-user-name
     6383         X_c-dc-hist.corr-user-db-num
     6384         X_c-dc-hist.host-code
     6385         with FRAME HistoryList .
     6386     DOWN STREAM PrnLibStream 1 with FRAME HistoryList  .
     6387     assign
     6388     accum-count = accum-count + 1
     6389     .
     6390     GET next br-dc-hist.
     6391   END.
     6392   UNDERLINE  STREAM PrnLibStream
     6393   v-obj
     6394   v-action-chr
     6395   v-cli
     6396   v-cli-name
     6397   v-subject-chr
     6398   X_c-dc-hist.is-news
     6399   v-source-type
     6400   X_c-dc-hist.source-ref
     6401   X_c-dc-hist.corr-date
     6402   v-upd-time
     6403   v-for-user-name
     6404   X_c-dc-hist.corr-user-db-num
     6405   X_c-dc-hist.host-code
     6406   with FRAME HistoryList .
     6407   DISPLAY STREAM PrnLibStream
     6408   "ИТОГО"  @ v-obj
     6409   string(accum-count)  @ v-action-chr
     6410   with frame HistoryList.
     6411   HIDE  STREAM PrnLibStream FRAME BottomFrame .
     6412   HIDE  STREAM PrnLibStream FRAME CheckList.
     6413   output  STREAM PrnLibStream CLOSE.
     6414   run waitfram-hide in this-procedure.
     6415   run prn-lib-prn-file in this-procedure (
     6416                                             input parparentproc
     6417                                             ,input 8
     6418                                             ).
     6419   reposition br-dc-hist to recid v-doc-rec no-error.
     6420   apply "entry" to br-dc-hist in frame Dialog-Frame.
     6421   END PROCEDURE.
     6422   PROCEDURE proc-b-sch :
     6423   assign
     6424     tbl = 'c-dc-hist'
     6425     join-tbl = 'X_c-dc-hist'
     6426     fld = ""
     6427     lab = ""
     6428     spr = ""
     6429     dim = '0'
     6430     .
     6431   run fltfield-add in this-procedure('obj-type*obj-code', 'Контрагент', '',
     6432   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     6433   run fltfield-add in this-procedure('host-code', '', '',
     6434   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     6435   run fltfield-add in this-procedure('corr-date', '', '',
     6436   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     6437   run fltfield-add in this-procedure('corr-time', 'Время корр.', 'time',
     6438   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     6439   run fltfield-add in this-procedure('corr-user-db-num', '', '',
     6440   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     6441   run fltfield-add in this-procedure('corr-user-name', 'Изменил', 'usr',
     6442   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     6443   run fltfield-add in this-procedure('subject', 'Предмет изменения', 'dc-hist-subject',
     6444   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     6445   run fltfield-add in this-procedure('action', 'Действие', 'hist-action',
     6446   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     6447   run fltfield-add in this-procedure('source-type', 'Источник_измен-я', 'hist-source-type',
     6448   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     6449   run fltfield-add in this-procedure('source-ref', '', '',
     6450   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     6451   Filter-Block:
     6452   DO ON STOP    UNDO Filter-Block, LEAVE Filter-Block
     6453       ON ERROR   UNDO Filter-Block, LEAVE Filter-Block
     6454       ON END-KEY UNDO Filter-Block, LEAVE Filter-Block :
     6455     run gbl/filter.w ( INPUT parparentproc
     6456                      , INPUT (filter-point + chr(4) + filter-label)
     6457                      , INPUT tbl
     6458                      , INPUT join-tbl
     6459                      , INPUT fld
     6460                      , INPUT lab
     6461                      , INPUT spr
     6462                      , INPUT dim ).
     6463     RUN OpenBr in this-procedure ( input yes, input no, input '':U, input v-corr-user-db-num).
     6464   END.
     6465   END PROCEDURE.
     6466   PROCEDURE proc-br-dc-hist :
     6467   define variable vss-include-info53 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6468   if b-sel:sensitive in frame Dialog-Frame then dO:
     6469       if b-mark:sensitive then do:
     6470           apply "choose" to b-mark in frame Dialog-Frame.
     6471       end.
     6472       else do:
     6473           apply "choose" to b-sel in frame Dialog-Frame.
     6474       end.
     6475   end.
     6476   else do:
     6477       if b-lookup:sensitive then
     6478       apply "choose" to b-lookup in frame Dialog-Frame.
     6479   end.
     6480   END PROCEDURE.
     6481   PROCEDURE proc-find-corr-date :
     6482   define input parameter p-next as logical no-undo.
     6483   define input parameter p-date like ub.fin-doc.doc-date no-undo.
     6484   define variable v-date-chr as character no-undo.
     6485   if p-date = ? then return .
     6486   display
     6487   "":U @ sch-d-card
     6488   0 @ sch-db-num
     6489   "":U @ sch-corr-user-name
     6490   with frame Dialog-Frame.
     6491   assign
     6492   v-date-chr = string(day(p-date)) + chr(47) +
     6493                    string(month(p-date)) + chr(47) +
     6494                    string(year(p-date)).
     6495          run OpenBr in this-procedure
     6496           (input false
     6497           ,input true
     6498           ,input substitute("and X_c-dc-hist.corr-date = &1 "
     6499             , v-date-chr)
     6500           ,input v-corr-user-db-num
     6501           ).
     6502         apply "entry":u to sch-corr-date in frame Dialog-Frame.
     6503   END PROCEDURE.
     6504   PROCEDURE proc-find-d-card :
     6505   define input parameter p-next as logical no-undo.
     6506   define input parameter p-d-card like ub.c-dc-hist.d-card no-undo.
     6507   display
     6508   "":U @ sch-corr-user-name
     6509   with frame Dialog-Frame.
     6510   display
     6511   "":U @ sch-corr-user-name
     6512   0 @ sch-db-num
     6513   sch-corr-date
     6514   with frame Dialog-Frame.
     6515   assign
     6516   p-d-card = replace(p-d-card, chr(34), "":U)
     6517   p-d-card = replace(p-d-card, chr(39), chr(39) + chr(39))
     6518   p-d-card = chr(34) + p-d-card + chr(34).
     6519   run OpenBr in this-procedure
     6520       (input false
     6521       ,input p-next
     6522       ,input substitute("and X_c-dc-hist.d-card = &1 "
     6523         , p-d-card)
     6524       ,input v-corr-user-db-num
     6525       ).
     6526   apply "entry":u to sch-d-card in frame Dialog-Frame .
     6527   END PROCEDURE.
     6528   PROCEDURE proc-find-db-num :
     6529   define input parameter p-next as logical no-undo.
     6530   define input parameter p-db-num like ub.c-dc-hist.corr-user-db-num no-undo.
     6531   define variable v-db-num as character no-undo.
     6532   assign
     6533   sch-corr-date = ?
     6534   .
     6535   display
     6536   "":U @ sch-corr-user-name
     6537   "":U @ sch-d-card
     6538   sch-corr-date
     6539   with frame Dialog-Frame.
     6540   assign
     6541   v-db-num = string(p-db-num).
     6542   run OpenBr in this-procedure
     6543       (input false
     6544       ,input p-next
     6545       ,input substitute("and X_c-dc-hist.corr-user-db-num = &1 "
     6546         , v-db-num)
     6547       ,input v-corr-user-db-num
     6548       ).
     6549   apply "entry":u to sch-db-num in frame Dialog-Frame .
     6550   END PROCEDURE.
     6551   PROCEDURE proc-find-user :
     6552   define input parameter p-next as logical no-undo.
     6553   define input parameter p-user like ub.c-dc-hist.corr-user-name no-undo.
     6554   assign
     6555   sch-corr-date = ?.
     6556   display
     6557   0 @ sch-db-num
     6558   sch-corr-date
     6559   0 @ sch-d-card
     6560   with frame Dialog-Frame.
     6561   p-user = chr(34) + p-user + chr(34).
     6562   run OpenBr in this-procedure
     6563       (input false
     6564       ,input p-next
     6565       ,input substitute("and X_c-dc-hist.corr-user-name = &1 "
     6566         , p-user)
     6567       ,input v-corr-user-db-num
     6568       ).
     6569   apply "entry":u to sch-corr-user-name in frame Dialog-Frame .
     6570   END PROCEDURE.
     6571   PROCEDURE proc-view-changes :
     6572   define variable v-description as character no-undo .
     6573   for each temp-changes:
     6574       delete temp-changes.
     6575   END.
     6576   if not available X_c-dc-hist then do:
     6577     Open QUery br-changes for each temp-changes.
     6578     return.
     6579   end.
     6580   run ref/cdchisv.p (
     6581                      input X_c-dc-hist.d-card
     6582                     ,input X_c-dc-hist.chip-num
     6583                     ,input X_c-dc-hist.corr-user-db-num
     6584                     ,input X_c-dc-hist.obj-type
     6585                     ,input X_c-dc-hist.obj-code
     6586                     ,input X_c-dc-hist.host-code
     6587                     ,input X_c-dc-hist.subject
     6588                     ,input X_c-dc-hist.action
     6589                     ,input no
     6590                     ,output v-description
     6591                  ) no-error .
     6592   Open QUery br-changes for each temp-changes.
     6593   assign
     6594   br-changes:title in frame Dialog-Frame = v-description
     6595   .
     6596   END PROCEDURE.
     6597   FUNCTION get-action RETURNS CHARACTER
     6598     ( p-action as integer ) :
     6599   define variable dops as character no-undo.
     6600   assign dops = entry (lookup (trim(string(p-action)), '99,1,2,3,4,9,51,79':U), 'Удаление,Создание,Изменение,Коррекция,Восстановление,Смена_кода,Смена_артик,Выключ.':U) no-error.
     6601   RETURN dops.
     6602   END FUNCTION.
     6603   FUNCTION get-cli RETURNS CHARACTER
     6604     ( p-d-card as character ) :
     6605   define buffer buf_dis-card for ub.dis-card.
     6606   define buffer buf_clients for ub.clients.
     6607   find first buf_dis-card no-lock where
     6608             buf_dis-card.d-card = ENTRY(1, p-d-card, chr(4)) no-error .
     6609   if not avail buf_dis-card then do:
     6610     assign
     6611     v-cli-name = "!!! Неизвестный владелец ДК!!!".
     6612   end.
     6613   find first buf_clients no-lock where
     6614             buf_clients.obj-type = buf_dis-card.cli-type
     6615         AND buf_clients.obj-code = buf_dis-card.cli-code
     6616         no-error.
     6617   if not available buf_clients then do:
     6618     assign
     6619     v-cli-name = "!!! Неизвестный владелец ДК!!!".
     6620   end.
     6621   else do:
     6622     assign
     6623     v-cli-name = buf_clients.obj-name
     6624     .
     6625   end.
     6626   RETURN (buf_clients.obj-type + string(buf_clients.obj-code)).
     6627   END FUNCTION.
     6628   FUNCTION get-source-type RETURNS CHARACTER
     6629     ( p-source-type as character ) :
     6630   define variable v-dop as character no-undo .
     6631   assign
     6632   v-dop = entry (lookup (p-source-type, ',db,esys,trn-doc,payment,fin-doc,import,recalc,wth-doc,ren-gdsc,upgrade,grp-chg,stop-list,dis-card':U), ',БД,ВС,Документ,Платеж,Фин.док.,Импорт,Пересчет,Документ МЦ,Коллизия,Апгрейд,Изм.группы,Стоплист,ДК':U)
     6633   no-error
     6634   .
     6635   RETURN v-dop.
     6636   END FUNCTION.
     6637   FUNCTION get-subject RETURNS CHARACTER
     6638     ( p-subject as character ) :
     6639     RETURN entry (lookup (p-subject, 'dis-card,dis-card-property,dis-obj,dis-host,dis-dc-rule':U), 'Диск.карта,Свойства ДК,Итоги ДК на объ.,Итоги ДК фирма/общ,Скидки для ДК':U).
     6640   END FUNCTION.
