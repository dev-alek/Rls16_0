     1592     run proc-br-dc-hist in this-procedure no-error.
     1593     if error-status:error then return no-apply.
     1594   END.
     1595   ON VALUE-CHANGED OF br-dc-hist IN FRAME Dialog-Frame
     1596   DO:
     1597     run proc-view-changes in this-procedure no-error.
     1598   END.
     1599   ON CTRL-J OF sch-corr-date IN FRAME Dialog-Frame
     1600   DO:
     1601      run proc-find-corr-date in this-procedure ( yes, input frame Dialog-Frame sch-corr-date) no-error.
     1602     if error-status:error then return no-apply.
     1603   END.
     1604   ON RETURN OF sch-corr-date IN FRAME Dialog-Frame
     1605   DO:
     1606     run proc-find-corr-date in this-procedure ( no, input frame Dialog-Frame sch-corr-date) no-error.
     1607     if error-status:error then return no-apply.
     1608   END.
     1609   ON CTRL-J OF sch-corr-user-name IN FRAME Dialog-Frame
