     4997     entry (lookup (p-discnt-role, 'pcnt-tot-kateg,dflt-gds-temp-disc,abs-tot-kateg,pcnt-codes,kateg-codes,free-discnt-flag,pmnt-discnt-flag,kat-gds-grp,temp-disc-pdf,pcnt-kat-pdf,bonus-tot,bonus-all':u) + 1, ',' + '% Скидка на итог,Временная скидка на товар по умолчанию,Abs Скидка на итог,Коды % скидок,Коды категорий,Флаг своб.скидки,Флаг уст. скидки на платеж,Ск-ка на группу товаров для кат.клиентов,Временная через ТПЛ,Категорийная через ТПЛ,Начисление бонусов на сумму чека,Правило-итого бонусов по чеку':u) @ v-d-name
     4998     X_dis-thbj-rule.rule-num
     4999     X_dis-thbj-rule.rl-root
     5000     with frame List .
     5001     DOWN stream PrnLibStream 1 with frame List .
     5002     ii =  ii + 1 .
     5003     if ( ( ii modulo 10 ) = 0 ) AND ( ii >= 10 ) then
     5004     run waitfram-show in this-procedure ( input ("Просмотрено строк : " + string( ii )) ) .
     5005     GET next br-dis-thbj-rule .
     5006   END.
     5007   run waitfram-hide in this-procedure .
     5008   PUT stream PrnLibStream Line format "X(130)" SKIP.
     5009   HIDE stream PrnLibStream FRAME BottomFrame .
     5010   output stream PrnLibStream close .
     5011   run prn-lib-prn-file in this-procedure (
     5012                                             input parParentProc
     5013                                             ,input 0
     5014                                             ).
     5015   reposition br-dis-thbj-rule to recid v-rec no-error.
     5016   if error-status:error then do:
     5017     reposition br-dis-thbj-rule to row 1 no-error.
     5018   end.
     5019   APPLy "ENTRY" to br-dis-thbj-rule.
     5020   END PROCEDURE.
     5021   PROCEDURE proc-b-sch :
     5022   assign
     5023     tbl = 'dis-thbj-rule'
     5024     join-tbl = 'X_dis-thbj-rule'
     5025     fld = ""
     5026     lab = ""
     5027     spr = ""
     5028     dim = '0'
     5029     .
     5030     run fltfield-add in this-procedure('templ-rl-root', 'Номер типа(шаблона) правила', '',
     5031     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5032     run fltfield-add in this-procedure('obj-type*obj-code', 'Объект', 'cli',
     5033     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5034     run fltfield-add in this-procedure('rule-num', '№ правила', '',
     5035     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5036     run fltfield-add in this-procedure('rl-root', '№ корн.правила', '',
     5037     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5038     run fltfield-add in this-procedure('pos-type', 'Место использ.', 'cd-types-discnt',
     5039     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5040     run fltfield-add in this-procedure('discnt-role', 'Тип скидки', '',
     5041     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5042   Filter-Block:
     5043   DO ON STOP    UNDO Filter-Block, LEAVE Filter-Block
     5044       ON ERROR   UNDO Filter-Block, LEAVE Filter-Block
     5045       ON END-KEY UNDO Filter-Block, LEAVE Filter-Block :
     5046     run gbl/filter.w ( INPUT parparentproc
     5047                        ,INPUT filter-point + chr(4) + filter-label
     5048                        ,INPUT tbl
     5049                        ,INPUT join-tbl
     5050                        ,INPUT fld
     5051                        ,INPUT lab
     5052                        ,INPUT spr
     5053                        ,INPUT dim ).
     5054     RUN OpenBr in this-procedure ( input yes, input no, input '':U).
     5055   END.
     5056   END PROCEDURE.
