     4910   PROCEDURE proc-b-mark :
     4911   define variable loc#log as logical no-undo .
     4912   if available X_dis-thbj-rule then do:
     4913   define variable vss-include-info42 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4914   define variable v-str-recid43 as character no-undo .
     4915   define variable v-num-entry43 as integer   no-undo .
     4916   assign
     4917     v-str-recid43 = trim( string( recid( X_dis-thbj-rule ) , "->>>>>>>>>>>9":U ) )
     4918     v-num-entry43 = lookup( v-str-recid43 , v-rid-list )
     4919   .
     4920   if v-num-entry43 > 0 then do:
     4921     assign
     4922       entry( v-num-entry43, v-rid-list ) = "":U
     4923       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     4924     .
     4925   end.
     4926   else do:
     4927     assign
     4928       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid43
     4929     .
     4930   end.
     4931     loc#log = br-dis-thbj-rule:refresh() IN FRAME Dialog-Frame .
     4932     if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
     4933         loc#log = br-dis-thbj-rule:select-next-row ().
     4934         apply "VALUE-CHANGED" to br-dis-thbj-rule in frame Dialog-Frame.
     4935     end.
     4936     if num-entries( v-rid-list ) = 0
     4937     then
     4938         hide mark-num in frame Dialog-Frame.
     4939     else
     4940         disp num-entries( v-rid-list ) @ mark-num with frame Dialog-Frame.
     4941   end.
     4942   apply "entry" to br-dis-thbj-rule in frame Dialog-Frame.
     4943   END PROCEDURE.
