       11   define INPUT PARAMETER p-curr-obj-code AS integer NO-UNDO.
       12   define INPUT PARAMETER p-templ-rl-root AS integer NO-UNDO.
       13   define INPUT PARAMETER p-pos-type AS character NO-UNDO.
       14   define INPUT PARAMETER p-discnt-role AS character NO-UNDO.
       15   define input parameter p-rule-num as integer no-undo .
       16   define INPUT-OUTPUT PARAMETER p-rid-list AS CHARACTER NO-UNDO.
       17   define variable vss-revision    as character no-undo init "$Revision$":U .
       18   define variable vss-author      as character no-undo init "$Author$":U .
       19   define variable vss-date        as character no-undo init "$Date$":U .
       20   define variable vss-workfile    as character no-undo init "$Workfile$":U .
