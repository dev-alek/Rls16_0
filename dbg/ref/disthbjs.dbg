     2455     run ref/gds-form.w ( input parparentproc
     2456                         ,input 'ПРОСМОТР':U
     2457                         ,input ?
     2458                         ,input ?
     2459                         ,input ?
     2460                         ,input-output gds-rec).
     2461     apply "entry" to br-dis-thbj-rule in frame Dialog-Frame.
     2462     return no-apply.
     2463   end.
     2464   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2465   procedure set-filter-name :
     2466   define input parameter p-filter-name as character no-undo .
     2467     do with frame Dialog-Frame:
     2468       if p-filter-name > "" then do:
     2469         assign
     2470           frame Dialog-Frame:title
     2471             = frame Dialog-Frame:title + "   ФИЛЬТР: " + p-filter-name.
     2472         .
     2473         assign
     2474           b-sch :tooltip = "Установлен фильтр " + p-filter-name
     2475         .
     2476       end.
     2477       else do:
     2478         assign
     2479           b-sch :tooltip = ""
     2480         .
     2481       end.
     2482     end.
     2483   end procedure.
     2484   def var sort-labelbr-dis-thbj-rule   as character no-undo .
     2485   def var sort-clmnbr-dis-thbj-rule    as handle    no-undo .
     2486   def var cur-clmnbr-dis-thbj-rule     as handle    no-undo .
     2487   def var cur-clmn-locbr-dis-thbj-rule as integer   no-undo .
     2488   def var re-querybr-dis-thbj-rule     as logical   initial no no-undo .
     2489   on start-search, ctrl-o of br-dis-thbj-rule in frame Dialog-Frame do:
     2490      run sort-brbr-dis-thbj-rule
     2491        (input (if available X_dis-thbj-rule
     2492                then recid(X_dis-thbj-rule)
     2493                else ?
     2494               )
     2495        ).
     2496   end.
     2497   PROCEDURE sort-brbr-dis-thbj-rule :
     2498     define input parameter p-recid as recid no-undo .
     2499     if re-querybr-dis-thbj-rule = no then do:
     2500       assign
     2501          cur-clmnbr-dis-thbj-rule = br-dis-thbj-rule:current-column in frame Dialog-Frame
     2502       .
     2503       if sort-clmnbr-dis-thbj-rule <> ? then sort-clmnbr-dis-thbj-rule:column-fgcolor = 0.
     2504       if cur-clmnbr-dis-thbj-rule = sort-clmnbr-dis-thbj-rule then do:
     2505         assign
     2506            sort-labelbr-dis-thbj-rule = ""
     2507            sort-clmnbr-dis-thbj-rule = ?
     2508         .
     2509        end.
     2510        else do:
     2511          assign
     2512            sort-labelbr-dis-thbj-rule = cur-clmnbr-dis-thbj-rule:label
     2513            sort-clmnbr-dis-thbj-rule  = cur-clmnbr-dis-thbj-rule
     2514            sort-clmnbr-dis-thbj-rule:column-fgcolor = 4
     2515          .
     2516        end.
     2517      end.
     2518     assign
     2519       cur-clmn-locbr-dis-thbj-rule = 1
     2520     .
     2521     def var column-handle as handle no-undo .
     2522     column-handle = br-dis-thbj-rule:first-column.
     2523     do while valid-handle(column-handle) :
     2524       if column-handle = cur-clmnbr-dis-thbj-rule then do:
     2525         leave .
     2526       end.
     2527       column-handle = column-handle:NEXT-COLUMN.
     2528       assign
     2529         cur-clmn-locbr-dis-thbj-rule = cur-clmn-locbr-dis-thbj-rule + 1
     2530       .
     2531     end.
     2532     case sort-labelbr-dis-thbj-rule:
     2533           when '*'  then DO:    assign       sort-column-name = "mark-string(recid(X_dis-thbj-rule), v-rid-list)"     .     run OpenBr in this-procedure ( input yes, input no, input no).   . END.
     2534           when 'Объект/Фирма'  then DO:    assign       sort-column-name = "X_clients.obj-name"     .     run OpenBr in this-procedure ( input yes, input no, input no).   . END.
     2535           when 'Тип правила'  then DO:    assign       sort-column-name = "X_dis-thbj-rule.templ-rl-root"     .     run OpenBr in this-procedure ( input yes, input no, input no).   . END.
     2536           when 'Место использ.'  then DO:    assign       sort-column-name = "X_dis-thbj-rule.pos-type"     .     run OpenBr in this-procedure ( input yes, input no, input no).   . END.
     2537           when 'Тип объ'  then DO:    assign       sort-column-name = "X_dis-thbj-rule.obj-type"     .     run OpenBr in this-procedure ( input yes, input no, input no).   . END.
     2538           when 'Код объ'  then DO:    assign       sort-column-name = "X_dis-thbj-rule.obj-code"     .     run OpenBr in this-procedure ( input yes, input no, input no).   . END.
     2539           when 'Код фирмы'  then DO:    assign       sort-column-name = "X_dis-thbj-rule.host-code"     .     run OpenBr in this-procedure ( input yes, input no, input no).   . END.
     2540           when 'Тип скидки'  then DO:    assign       sort-column-name = "entry (lookup (X_dis-thbj-rule.discnt-role, 'pcnt-tot-kateg,dflt-gds-temp-disc,abs-tot-kateg,pcnt-codes,kateg-codes,free-discnt-flag,pmnt-discnt-flag,kat-gds-grp,temp-disc-pdf,pcnt-kat-pdf,bonus-tot,bonus-all':u) + 1, ',' + '% Скидка на итог,Временная скидка на товар по умолчанию,Abs Скидка на итог,Коды % скидок,Коды категорий,Флаг своб.скидки,Флаг уст. скидки на платеж,Ск-ка на группу товаров для кат.клиентов,Временная через ТПЛ,Категорийная через ТПЛ,Начисление бонусов на сумму чека,Правило-итого бонусов по чеку':u)"     .     run OpenBr in this-procedure ( input yes, input no, input no).   . END.
     2541           when '№ правила'  then DO:    assign       sort-column-name = "X_dis-thbj-rule.rule-num"     .     run OpenBr in this-procedure ( input yes, input no, input no).   . END.
     2542           when '№ корн.!правила'  then DO:    assign       sort-column-name = "X_dis-thbj-rule.rl-root"     .     run OpenBr in this-procedure ( input yes, input no, input no).   . END.
     2543       otherwise do:
     2544         assign
     2545           sort-column-name = ""
     2546         .
     2547         run OpenBr in this-procedure ( input yes, input no, input no).
     2548         if sort-labelbr-dis-thbj-rule <> "" then do:
     2549           assign
     2550             cur-clmnbr-dis-thbj-rule:column-fgcolor = 0
     2551           .
     2552         end.
     2553         assign
     2554           cur-clmn-locbr-dis-thbj-rule = ?
     2555         .
     2556       end.
     2557     end case.
     2558     if p-recid <> ? then do:
     2559       reposition br-dis-thbj-rule to recid p-recid no-error.
     2560       apply "value-changed" to br-dis-thbj-rule in frame Dialog-Frame.
     2561     end.
     2562     apply "entry" to br-dis-thbj-rule in frame Dialog-Frame.
     2563   END PROCEDURE.
     2564   procedure re-open-query-srt-clmnbr-dis-thbj-rule:
     2565   if cur-clmnbr-dis-thbj-rule = ? then do:
     2566      run OpenBr in this-procedure ( input yes, input no, input no).
     2567   end.
     2568   else do:
     2569      assign re-querybr-dis-thbj-rule = yes.
     2570      run sort-brbr-dis-thbj-rule
     2571        (input (if available X_dis-thbj-rule
     2572                then recid(X_dis-thbj-rule)
     2573                else ?
     2574               )
     2575        ).
     2576      assign re-querybr-dis-thbj-rule = no.
     2577   end.
     2578   end.
     2579   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2580   do:
     2581     BR-dis-thbj-rule :SET-REPOSITIONED-ROW(5, "CONDITIONAL") .
     2582   end.
     2583   MAIN-BLOCK:
     2584   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2585      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2586   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2587     run mainmenu_getcntxt in parparentproc
     2588       (output v-cntxt-db-num
     2589       ,output v-cntxt-userid
     2590       ,output v-cntxt-level
     2591       ,output v-cntxt-host-code-obj
     2592       ,output v-cntxt-obj-type
     2593       ,output v-cntxt-obj-code
     2594       ,output v-cntxt-db-num-obj
     2595       ,output v-cntxt-is-admin
     2596       ) .
     2597       v-rid-list = p-rid-list.
     2598     IF lookup(p-list-mode, ('все':U + chr(4) +
     2599                             "pos" + chr(4) +
     2600                             "templ-rl-root" + chr(4) +
     2601                             "discnt-role" + chr(4) +
     2602                             'объект':U + chr(4) +
     2603                             ('объект':U + chr(44) + "pos-type":U) + chr(4) +
     2604                             ('объект':U + chr(44) + "templ-rl-root":U) + chr(4) +
     2605                             ('объект':U + chr(44) + "discnt-role":U) + chr(4) +
     2606                             "rule-num":U + chr(4) +
     2607                             "rl-root":U
     2608                             ) , chr(4)) = 0
     2609     THEN DO:
     2610        MESSAGE
     2611        vss-workfile vss-revision vss-description skip
     2612        "Неверный параметр вызова p-list-mode " p-list-mode
     2613        VIEW-AS ALERT-BOX ERROR.
     2614        UNDO, RETURN ERROR.
     2615     END.
     2616     IF lookup('объект':U , p-list-mode) > 0 THEN DO:
     2617       IF p-curr-obj-type <> 'скл':U
     2618       AND p-curr-obj-type <> 'маг':U THEN DO:
     2619           MESSAGE
     2620           vss-workfile vss-revision vss-description skip
     2621           "Неверный параметр вызова p-curr-obj-type " p-curr-obj-type
     2622           VIEW-AS ALERT-BOX ERROR.
     2623           UNDO, RETURN ERROR.
     2624       END.
     2625       FIND FIRST X_clients-obj NO-LOCK WHERE
     2626                 X_clients-obj.obj-type = p-curr-obj-type
     2627            AND  X_clients-obj.obj-code = p-curr-obj-code NO-ERROR.
     2628       IF NOT AVAILABLE X_clients-obj THEN DO:
     2629           MESSAGE
     2630           vss-workfile vss-revision vss-description skip
     2631           "Неверные параметры вызова p-curr-obj-type p-curr-obj-code" p-curr-obj-type p-curr-obj-code
     2632           VIEW-AS ALERT-BOX ERROR.
     2633           UNDO, RETURN ERROR.
     2634       END.
     2635     end.
     2636     IF LOOKUP( "templ-rl-root", p-list-mode) > 0 THEN DO:
     2637         FIND FIRST PAR_dis-rule NO-LOCK WHERE
     2638                   par_dis-rule.rule-num = p-templ-rl-root no-error.
     2639         IF NOT AVAILABLE par_Dis-rule THEN DO:
     2640             MESSAGE
     2641             vss-workfile vss-revision vss-description skip
     2642             "Неверный параметр вызова p-templ-rl-root" p-templ-rl-root
     2643             VIEW-AS ALERT-BOX ERROR.
     2644             UNDO, RETURN ERROR.
     2645         END.
     2646     END.
     2647     IF LOOKUP( "pos-type", p-list-mode) > 0
     2648     AND lookup(p-pos-type, 'IBM-XML,Autotank,IBM,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,r-keeper,InfoKiosk,pricecheck-Servis+,Emulator-NKT-IBM,MARIA':U) = 0  THEN DO:
     2649         MESSAGE
     2650         vss-workfile vss-revision vss-description skip
     2651         "Неверный параметр вызова p-pos-type" p-pos-type
     2652         VIEW-AS ALERT-BOX ERROR.
     2653         UNDO, RETURN ERROR.
     2654     END.
     2655     IF LOOKUP( "discnt-role", p-list-mode) > 0 THEN DO:
     2656       FIND FIRST par_dis-cfg-rule NO-LOCK WHERE
     2657                 par_dis-cfg-rule.discnt-role = p-discnt-role
     2658             AND par_dis-cfg-rule.TABLE-name = 'dis-thbj-rule':U NO-ERROR.
     2659       IF NOT AVAILABLE par_dis-cfg-rule  THEN DO:
     2660         MESSAGE
     2661         vss-workfile vss-revision vss-description skip
     2662         "Неверный параметр вызова p-discnt-role" p-discnt-role
     2663         VIEW-AS ALERT-BOX ERROR.
     2664         UNDO, RETURN ERROR.
     2665       END.
     2666     END.
     2667     RUN Myenable IN THIS-PROCEDURE NO-ERROR.
     2668     IF ERROR-STATUS:ERROR THEN UNDO, RETURN ERROR.
     2669     WAIT-FOR GO OF FRAME Dialog-Frame.
     2670   END.
     2671   RUN disable_UI.
     2672   PROCEDURE disable_UI :
     2673     HIDE FRAME Dialog-Frame.
     2674   END PROCEDURE.
     2675   PROCEDURE enable_UI :
     2676     DISPLAY mark-num
     2677         WITH FRAME Dialog-Frame.
     2678     ENABLE b-quit B-mark B-sel B-sch B-print b-history B-Help BR-dis-thbj-rule
     2679            mark-num
     2680         WITH FRAME Dialog-Frame.
     2681     VIEW FRAME Dialog-Frame.
     2682     OPEN QUERY BR-dis-thbj-rule FOR EACH X_dis-thbj-rule NO-LOCK ,            FIRST X_clients NO-LOCK OUTER-JOIN where           X_clients.obj-type = X_dis-thbj-rule.obj-type       AND X_clients.obj-code = X_dis-thbj-rule.obj-code INDEXED-REPOSITION.
     2683   END PROCEDURE.
     2684   PROCEDURE MyEnable :
     2685   DEFINE VARIABLE v-ii AS INTEGER NO-UNDO.
     2686   DEFINE VARIABLE v-h AS widget-handle NO-UNDO.
     2687   X_clients.obj-name:RESIZABLE IN BROWSE br-dis-thbj-rule = YES.
     2688   v-h = br-dis-thbj-rule:FIRST-COLUMN IN FRAME Dialog-Frame.
     2689   DO while valid-handle(v-h) :
     2690     if v-h:LABEL = 'Тип скидки' then do:
     2691       v-h:RESIZABLE = YES.
     2692       leave.
     2693     end.
     2694     ELSE DO:
     2695       v-h = v-h:NEXT-COLUMN.
     2696     END.
     2697   END.
     2698   DISPLAY
