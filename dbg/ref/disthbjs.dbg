     2801         parameter-6-21 = if sort-phrase-21 = ''
     2802                              then
     2803           (
     2804           " " + "  " +
     2805             " " + sort-column-phrase +
     2806           " " + "  "
     2807           )
     2808                              else
     2809           (
     2810           " " + "  " +
     2811             " " + sort-column-phrase +
     2812           " " + sort-phrase-21
     2813           )
     2814         parameter-7-21 =
     2815           " indexed-reposition  "
