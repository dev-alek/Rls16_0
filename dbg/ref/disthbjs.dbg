     1074   X_dis-thbj-rule.obj-code COLUMN-LABEL 'Код объ' FORMAT ">>>>9"
     1075   X_dis-thbj-rule.host-code COLUMN-LABEL 'Код фирмы' FORMAT ">>>>9"
     1076   entry (lookup (X_dis-thbj-rule.discnt-role, 'pcnt-tot-kateg,dflt-gds-temp-disc,abs-tot-kateg,pcnt-codes,kateg-codes,free-discnt-flag,pmnt-discnt-flag,kat-gds-grp,temp-disc-pdf,pcnt-kat-pdf,bonus-tot,bonus-all':u) + 1, ',' + '% Скидка на итог,Временная скидка на товар по умолчанию,Abs Скидка на итог,Коды % скидок,Коды категорий,Флаг своб.скидки,Флаг уст. скидки на платеж,Ск-ка на группу товаров для кат.клиентов,Временная через ТПЛ,Категорийная через ТПЛ,Начисление бонусов на сумму чека,Правило-итого бонусов по чеку':u) COLUMN-LABEL 'Тип скидки' FORMAT "X(40)" WIDTH 20
     1077   X_dis-thbj-rule.rule-num COLUMN-LABEL '№ правила' FORMAT ">>>>>>>>9"
     1078   X_dis-thbj-rule.rl-root COLUMN-LABEL '№ корн.!правила' FORMAT ">>>>>>>>9"
     1079       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 20 FIT-LAST-COLUMN.
     1080   DEFINE FRAME Dialog-Frame
     1081        b-quit AT ROW 1 COL 1
     1082        B-mark AT ROW 1 COL 11 WIDGET-ID 4
     1083        B-sel AT ROW 1 COL 21 WIDGET-ID 10
     1084        B-sch AT ROW 1 COL 86 WIDGET-ID 8
     1085        B-print AT ROW 1 COL 89 WIDGET-ID 6
     1086        b-history AT ROW 1 COL 92 WIDGET-ID 2
     1087        B-Help AT ROW 1 COL 95
     1088        BR-dis-thbj-rule AT ROW 3 COL 1 WIDGET-ID 100
     1089        mark-num AT ROW 1 COL 12.5 COLON-ALIGNED NO-LABEL WIDGET-ID 12
     1090        SPACE(78.50) SKIP(21.22)
     1091       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1092            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1093            TITLE "Скидки на объектах TH"
     1094            CANCEL-BUTTON b-quit.
     1095   ASSIGN
     1096          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1097          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1098   ON GO OF FRAME Dialog-Frame
     1099   DO:
     1100     p-rid-list = v-rid-list.
     1101   END.
     1102   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1103   DO:
     1104     APPLY "END-ERROR":U TO SELF.
     1105   END.
     1106   ON CHOOSE OF b-history IN FRAME Dialog-Frame
     1107   DO:
     1108   define variable v-rid-list as character no-undo .
     1109   if not available X_dis-thbj-rule then return no-apply.
     1110   run ref/cclihist.w (
     1111                         input parparentproc
     1112                       , input 0
     1113                       , input "":U
     1114                       , input 0
     1115                       , input "":U
     1116                       , input "subject":U
     1117                       , input X_dis-thbj-rule.obj-type
     1118                       , input X_dis-thbj-rule.obj-code
     1119                       , input X_dis-thbj-rule.host-code
     1120                       , input ?
     1121                       , input "":U
     1122                       , input 'dis-thbj-rule':U
     1123                       , input v-cntxt-db-num
     1124                       , input-output v-rid-list  ) no-error .
     1125   END.
     1126   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
     1127   DO:
     1128     RUN proc-b-mark IN THIS-PROCEDURE NO-ERROR.
     1129     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1130   END.
     1131   ON CHOOSE OF B-print IN FRAME Dialog-Frame
     1132   DO:
     1133     run proc-b-print in this-procedure no-error.
     1134     if error-status:error then do:
     1135       return no-apply.
     1136     end.
     1137     APPLY "ENTRY" to br-dis-thbj-rule.
     1138   END.
     1139   ON CHOOSE OF B-sch IN FRAME Dialog-Frame
     1140   DO:
     1141     RUN proc-b-sch IN THIS-PROCEDURE NO-ERROR.
     1142     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1143   END.
     1144   ON CHOOSE OF B-sel IN FRAME Dialog-Frame
     1145   DO:
     1146       if ( available X_dis-thbj-rule ) then do:
     1147       if  ( v-rid-list = "" ) or b-mark:sensitive = no
     1148       then
     1149       v-rid-list = string( recid( X_dis-thbj-rule ) ) .
     1150     end.
     1151   END.
     1152   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1153   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1154   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1155   on help of frame Dialog-Frame
     1156   do:
     1157     run gbl/app_help.p
     1158       (input this-procedure :file-name
     1159       ,input ''
     1160       ,input ?
     1161       ) no-error.
     1162     if error-status :error then do:
     1163       message
     1164         "Ошибка при вызове помощи"
     1165         error-status :get-message(1)
     1166         view-as alert-box .
     1167     end.
     1168   end.
     1169   run minbtn-set in this-procedure .
     1170   on choose of b-help in frame Dialog-Frame
     1171   do:
     1172     apply "help":u to frame Dialog-Frame .
     1173   end.
     1174   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1175   procedure minbtn-set :
     1176       do
     1177           on error undo, return error return-value
     1178           :
     1179           define variable ii              as integer       no-undo .
     1180           define variable fh              as widget-handle no-undo .
     1181           define variable hh              as widget-handle no-undo .
     1182           define variable v-h             as handle        extent 4 no-undo .
     1183           define variable v-name-button   as character     no-undo .
     1184           define variable v-help-old-x    as decimal       no-undo .
     1185           define variable v-help-old-y    as decimal       no-undo .
     1186           define variable v-help-old-size as decimal       no-undo .
     1187           define variable v-frame-width   as decimal       no-undo .
     1188           define variable jj              as integer       no-undo .
     1189           do
     1190               on error undo, return error
     1191               :
     1192               assign
     1193                   v-frame-width = frame Dialog-Frame:width - 0.3
     1194                   fh            = frame Dialog-Frame:first-child
     1195                   hh            = fh:first-child
     1196                   ii            = 1
     1197                   .
     1198               do while valid-handle(hh):
     1199                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1200                   do:
     1201                       case lc(hh:name) :
     1202                           when "b-help" then
     1203                               do:
     1204                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1205                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1206                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1207                                   hh:TOOLTIP = "Помощь" .
     1208                                   v-help-old-x = hh:column .
     1209                                   v-help-old-y = hh:row    .
     1210                                   v-help-old-size = hh:width .
     1211                                   hh:width-chars = 2.5 .
     1212                               end.
     1213                           when "b-print" then
     1214                               do:
     1215                                   hh:load-image("cmp/b-print.bmp":u) .
     1216                                   hh:TOOLTIP = "Печать" .
     1217                                   v-h[ii] = hh:handle .
     1218                                   ii = ii + 1 .
     1219                                   hh:width-chars = 3 .
     1220                               end.
     1221                           when "b-history" or
     1222                           when "b-hist" then
     1223                               do:
     1224                                   hh:load-image("cmp/b-hist.bmp":u) .
     1225                                   hh:TOOLTIP = "История" .
     1226                                   v-h[ii] = hh:handle .
     1227                                   ii = ii + 1 .
     1228                                   hh:width-chars = 3 .
     1229                               end.
     1230                           when "b-sch" then
     1231                               do:
     1232                                   hh:load-image("cmp/b-sch.bmp":u) .
     1233                                   hh:TOOLTIP = "Установка Фильтра" .
     1234                                   v-h[ii] = hh:handle .
     1235                                   ii = ii + 1 .
     1236                                   hh:width-chars = 3 .
     1237                               end.
     1238                           when "b-hist-user" then
     1239                               do:
     1240                                   hh:load-image("cmp/b-hist.bmp":u) .
     1241                                   hh:TOOLTIP = "История пользователя" .
     1242                                   ii = ii + 1 .
     1243                               end.
     1244                       end case.
     1245                   end.
     1246                   hh = hh:next-sibling.
     1247               end.
     1248               b-help:column = v-frame-width - b-help:width-chars.
     1249               jj = 0.
     1250               repeat ii = 4 to 1 by -1 :
     1251                   if valid-handle (v-h[ii] ) then
     1252                   do:
     1253                       jj  = jj + 1 .
     1254                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1255                       v-h[ii]:row    = v-help-old-y .
     1256                   end.
     1257               end.
     1258           end.
     1259       end.
     1260   end procedure.
     1261   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1262   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1263   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1264   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1265   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1266   define variable v-diasize-current-frame-height as decimal   no-undo .
     1267   define variable v-diasize-change-size          as logical   no-undo .
     1268   define variable v-diasize-resize-button        as handle    no-undo .
     1269   define variable v-diasize-wndmax               as logical   no-undo .
     1270   define variable v-diasize-wndstore             as logical   no-undo .
     1271   define variable v-diasize-proc-name            as character no-undo .
     1272   define variable v-diasize-browse-handle        as handle    no-undo .
     1273   define variable v-diasize-browse-number        as integer   no-undo .
     1274   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1275   define temp-table temp-diasize-handle no-undo
     1276     field handle-value  as handle
     1277     field save-position as decimal
     1278     index xpk is primary unique handle-value
     1279     .
     1280   define temp-table temp-browse-handle no-undo
     1281     field browse-type   as character
     1282     field browse-number as integer
     1283     field browse-handle as handle
     1284     field original-size as decimal
     1285     index xpk is primary unique browse-type browse-number
     1286     index xie browse-type browse-handle
     1287   .
     1288   procedure diasize_change-height :
     1289     define input  parameter p-change-value  as decimal   no-undo .
     1290     define input  parameter p-move-resize   as logical   no-undo .
     1291     define variable v-field-group-handle    as handle    no-undo .
     1292     define variable v-object-handle         as handle    no-undo .
     1293     define variable v-frame-height          as decimal   no-undo .
     1294     define variable v-frame-virtual-height  as decimal   no-undo .
     1295     define variable v-browse-height         as decimal   no-undo .
     1296     define variable v-window-height         as decimal   no-undo .
     1297     define variable v-window-virtual-height as decimal   no-undo .
     1298     define variable v-change-sign           as integer   no-undo .
     1299     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1300     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1301     if p-change-value > 0
     1302     then do:
     1303       if frame Dialog-Frame :height + p-change-value
     1304           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1305       then do:
     1306         assign
     1307           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1308                           - (frame Dialog-Frame :height-chars)
     1309         .
     1310         if p-change-value <= 0
     1311         then do:
     1312           run diasize_position-resize-button in this-procedure .
     1313           return .
     1314         end.
     1315       end.
     1316     end.
     1317     if p-change-value < 0
     1318     then do:
     1319       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1320       then do:
     1321         assign
     1322           p-change-value = v-diasize-orig-frame-height
     1323                          - (frame Dialog-Frame :height-chars)
     1324         .
     1325         if p-change-value >= 0
     1326         then do:
     1327           run diasize_position-resize-button in this-procedure .
     1328           return .
     1329         end.
     1330       end.
     1331     end.
     1332     if p-change-value >= 0
     1333     then do:
     1334       assign
     1335         v-change-sign = 1
     1336       .
     1337     end.
     1338     else do:
     1339       assign
     1340         v-change-sign = -1
     1341       .
     1342     end.
     1343     assign
     1344       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1345     .
     1346     if p-change-value = 0
     1347     then do:
     1348       run diasize_position-resize-button in this-procedure .
     1349       return .
     1350     end.
     1351     move_block:
     1352     do
     1353     on error undo move_block, retry move_block
     1354     :
     1355       if retry
     1356       then do:
     1357         do
     1358         on error undo move_block, leave move_block
     1359         :
     1360           if p-change-value > 0
     1361           then do:
     1362             for each buf_temp-diasize-handle
     1363             on error undo, next
     1364             :
     1365               assign
     1366                 v-object-handle = buf_temp-diasize-handle.handle-value
     1367               .
     1368               if v-object-handle <> v-diasize-resize-button
     1369               then do:
     1370                 assign
     1371                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1372                 .
     1373               end.
     1374             end.
     1375             assign
     1376               v-diasize-browse-handle :height = v-browse-height
     1377             .
     1378             for each buf_temp-browse-handle
     1379               where buf_temp-browse-handle.browse-type = 'height':u
     1380             on error undo, next
     1381             :
     1382               assign
     1383                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1384               .
     1385             end.
     1386             assign
     1387               frame Dialog-Frame :height = v-frame-height
     1388             .
     1389             if frame Dialog-Frame :scrollable = true
     1390             then do:
     1391               assign
     1392                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1393               .
     1394             end.
     1395             run diasize_position-resize-button in this-procedure .
     1396           end.
     1397           else do:
     1398             if frame Dialog-Frame :scrollable = true
     1399             then do:
     1400               assign
     1401                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1402               .
     1403             end.
     1404             assign
     1405               frame Dialog-Frame :height = v-frame-height
     1406             .
     1407             assign
     1408               v-diasize-browse-handle :height = v-browse-height
     1409             .
     1410             for each buf_temp-browse-handle
     1411               where buf_temp-browse-handle.browse-type = 'height':u
     1412             on error undo, next
     1413             :
     1414               assign
     1415                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1416               .
     1417             end.
     1418             for each buf_temp-diasize-handle
     1419             on error undo, next
     1420             :
     1421               assign
     1422                 v-object-handle = buf_temp-diasize-handle.handle-value
     1423               .
     1424               if v-object-handle <> v-diasize-resize-button
     1425               then do:
     1426                 assign
     1427                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1428                 .
     1429               end.
     1430             end.
     1431             run diasize_position-resize-button in this-procedure .
     1432           end.
     1433           assign
     1434             v-diasize-change-size = false
     1435           .
     1436           leave move_block .
     1437         end.
     1438       end.
     1439       assign
     1440         v-diasize-need-full-display = true
     1441       .
     1442       if v-diasize-change-size = false
     1443       then do:
     1444         assign
     1445           v-diasize-change-size = true
     1446         .
     1447       end.
     1448       else do:
     1449         return .
     1450       end.
     1451       assign
     1452         v-frame-height = frame Dialog-Frame :height
     1453         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1454         v-browse-height = v-diasize-browse-handle :height
     1455       .
     1456       for each buf_temp-browse-handle
     1457         where buf_temp-browse-handle.browse-type = 'height':u
     1458       :
     1459         assign
     1460           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1461         .
     1462       end.
     1463       for each buf_temp-diasize-handle
     1464       :
     1465         delete buf_temp-diasize-handle .
     1466       end.
     1467       assign
     1468         v-field-group-handle = frame Dialog-Frame :first-child
     1469       .
     1470       do while valid-handle(v-field-group-handle)
     1471       :
     1472         assign
     1473           v-object-handle = v-field-group-handle :first-child
     1474         .
     1475         do while valid-handle(v-object-handle)
     1476         :
     1477           if  v-object-handle <> v-diasize-browse-handle :handle
     1478           and can-query(v-object-handle, "row")
     1479           and can-query(v-object-handle, "height")
     1480           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1481           then do:
     1482             find first buf_temp-browse-handle
     1483               where buf_temp-browse-handle.browse-type   = 'height':u
     1484                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1485               no-error .
     1486             if available buf_temp-browse-handle
     1487             then do:
     1488             end.
     1489             else do:
     1490               create buf_temp-diasize-handle .
     1491               assign
     1492                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1493                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1494               .
     1495             end.
     1496           end.
     1497           assign
     1498             v-object-handle = v-object-handle :next-sibling
     1499           .
     1500         end.
     1501         assign
     1502           v-field-group-handle = v-field-group-handle :next-sibling
     1503         .
     1504       end.
     1505       do with frame Dialog-Frame
     1506       :
     1507         hide v-diasize-resize-button .
     1508         assign
     1509           v-diasize-resize-button :row    = 1
     1510           v-diasize-resize-button :column = 1
     1511         .
     1512       end.
     1513       if p-change-value > 0
     1514       then do:
     1515         if frame Dialog-Frame :scrollable = true
     1516         then do:
     1517           assign
     1518             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1519             no-error .
     1520           if error-status :error
     1521           or error-status :get-message(1) <> ""
     1522           then do:
     1523             undo move_block, retry move_block .
     1524           end.
     1525         end.
     1526         assign
     1527           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1528           no-error .
     1529         if error-status :error
     1530         or error-status :get-message(1) <> ""
     1531         then do:
     1532           undo move_block, retry move_block .
     1533         end.
     1534         assign
     1535           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1536           no-error .
     1537         if error-status :error
     1538         or error-status :get-message(1) <> ""
     1539         then do:
     1540           undo move_block, retry move_block .
     1541         end.
     1542         for each buf_temp-browse-handle
     1543           where buf_temp-browse-handle.browse-type = 'height':u
     1544         on error undo move_block, retry move_block
     1545         :
     1546           assign
     1547             buf_temp-browse-handle.browse-handle :height
     1548               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1549             no-error .
     1550           if error-status :error
     1551           or error-status :get-message(1) <> ""
     1552           then do:
     1553             undo move_block, retry move_block .
     1554           end.
     1555         end.
     1556         for each buf_temp-diasize-handle
     1557         on error undo move_block, retry move_block
     1558         :
     1559           assign
     1560             v-object-handle = buf_temp-diasize-handle.handle-value
     1561           .
     1562           if v-object-handle <> v-diasize-resize-button
     1563           then do:
     1564             assign
     1565               v-object-handle :row = v-object-handle :row + p-change-value
     1566               no-error .
     1567             if error-status :error
     1568             or error-status :get-message(1) <> ""
     1569             then do:
     1570               undo move_block, retry move_block .
     1571             end.
     1572           end.
     1573         end.
     1574       end.
     1575       else do:
     1576         for each buf_temp-diasize-handle
     1577         on error undo move_block, retry move_block
     1578         :
     1579           assign
     1580             v-object-handle = buf_temp-diasize-handle.handle-value
     1581           .
     1582           if v-object-handle <> v-diasize-resize-button
     1583           then do:
     1584             assign
     1585               v-object-handle :row = v-object-handle :row + p-change-value
     1586               no-error .
     1587             if error-status :error
     1588             or error-status :get-message(1) <> ""
     1589             then do:
     1590               undo move_block, retry move_block .
     1591             end.
     1592           end.
     1593         end.
     1594         assign
     1595           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1596           no-error .
     1597         if error-status :error
     1598         or error-status :get-message(1) <> ""
     1599         then do:
     1600           undo move_block, retry move_block .
     1601         end.
     1602         for each buf_temp-browse-handle
     1603           where buf_temp-browse-handle.browse-type = 'height':u
     1604         on error undo move_block, retry move_block
     1605         :
     1606           assign
     1607             buf_temp-browse-handle.browse-handle :height
     1608               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1609             no-error .
     1610           if error-status :error
     1611           or error-status :get-message(1) <> ""
     1612           then do:
     1613             undo move_block, retry move_block .
     1614           end.
     1615         end.
     1616         assign
     1617           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1618           no-error .
     1619         if error-status :error
     1620         or error-status :get-message(1) <> ""
     1621         then do:
     1622           undo move_block, retry move_block .
     1623         end.
     1624         if frame Dialog-Frame :scrollable = true
     1625         then do:
     1626           assign
     1627             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1628             no-error .
     1629           if error-status :error
     1630           or error-status :get-message(1) <> ""
     1631           then do:
     1632             undo move_block, retry move_block .
     1633           end.
     1634         end.
     1635       end.
     1636       if p-move-resize = true
     1637       then do:
     1638         run diasize_position-resize-button in this-procedure .
     1639       end.
     1640       if v-diasize-wndstore = true
     1641       then do:
     1642         if connected("ub") = true
     1643         then do:
     1644           define variable v-cntxt-db-num        as integer   no-undo .
     1645           define variable v-cntxt-userid        as character no-undo .
     1646           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1647                                             , OUTPUT v-cntxt-userid
     1648                                             ) .
     1649           run gbl/wndsizew.p
     1650             (input  v-cntxt-db-num
     1651             ,input  v-cntxt-userid
     1652             ,input  v-diasize-proc-name
     1653             ,input  'height':u
     1654             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1655             ) .
     1656         end.
     1657       end.
     1658     end.
     1659     assign
     1660       v-diasize-change-size = false
     1661     .
     1662   end procedure.
     1663   procedure diasize_set-height :
     1664     define input  parameter p-new-height  as decimal   no-undo .
     1665     define input  parameter p-move-resize as logical   no-undo .
     1666     do
     1667     on error undo, return error return-value
     1668     :
     1669       run diasize_change-height in this-procedure
     1670         (input  (p-new-height - frame Dialog-Frame :height)
     1671         ,input  p-move-resize
     1672         ) .
     1673     end.
     1674   end procedure.
     1675   procedure diasize_change-width :
     1676     define input  parameter p-change-value as decimal   no-undo .
     1677     define input  parameter p-move-resize  as logical   no-undo .
     1678     define variable v-field-group-handle   as handle    no-undo .
     1679     define variable v-object-handle        as handle    no-undo .
     1680     define variable v-frame-width          as decimal   no-undo .
     1681     define variable v-frame-virtual-width  as decimal   no-undo .
     1682     define variable v-browse-width         as decimal   no-undo .
     1683     define variable v-window-width         as decimal   no-undo .
     1684     define variable v-window-virtual-width as decimal   no-undo .
     1685     define variable v-change-sign          as integer   no-undo .
     1686     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1687     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1688     if p-change-value > 0
     1689     then do:
     1690       if frame Dialog-Frame :width + p-change-value >
     1691           session :width-chars
     1692       then do:
     1693         assign
     1694           p-change-value = session :width-chars - frame Dialog-Frame :width
     1695         .
     1696         if p-change-value <= 0
     1697         then do:
     1698           run diasize_position-resize-button in this-procedure .
     1699           return .
     1700         end.
     1701       end.
     1702     end.
     1703     if p-change-value < 0
     1704     then do:
     1705       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1706       then do:
     1707         assign
     1708           p-change-value = v-diasize-orig-frame-width
     1709                          - frame Dialog-Frame :width
     1710         .
     1711         if p-change-value >= 0
     1712         then do:
     1713           run diasize_position-resize-button in this-procedure .
     1714           return .
     1715         end.
     1716       end.
     1717     end.
     1718     if p-change-value >= 0
     1719     then do:
     1720       assign
     1721         v-change-sign = 1
     1722       .
     1723     end.
     1724     else do:
     1725       assign
     1726         v-change-sign = -1
     1727       .
     1728     end.
     1729     assign
     1730       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1731     .
     1732     if p-change-value = 0
     1733     then do:
     1734       run diasize_position-resize-button in this-procedure .
     1735       return .
     1736     end.
     1737     move_block:
     1738     do
     1739     on error undo move_block, leave move_block
     1740     :
     1741       if retry
     1742       then do:
     1743         do
     1744         on error undo move_block, leave move_block
     1745         :
     1746           if p-change-value > 0
     1747           then do:
     1748             for each buf_temp-diasize-handle
     1749             on error undo, next
     1750             :
     1751               assign
     1752                 v-object-handle = buf_temp-diasize-handle.handle-value
     1753               .
     1754               if v-object-handle <> v-diasize-resize-button
     1755               then do:
     1756                 assign
     1757                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1758                 .
     1759               end.
     1760             end.
     1761             assign
     1762               v-diasize-browse-handle :width = v-browse-width
     1763             .
     1764             for each buf_temp-browse-handle
     1765               where buf_temp-browse-handle.browse-type = 'width':u
     1766             on error undo, next
     1767             :
     1768               assign
     1769                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1770               .
     1771             end.
     1772             assign
     1773               frame Dialog-Frame :width = v-frame-width
     1774             .
     1775             if frame Dialog-Frame :scrollable = true
     1776             then do:
     1777               assign
     1778                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1779               .
     1780             end.
     1781             run diasize_position-resize-button in this-procedure .
     1782           end.
     1783           else do:
     1784             if frame Dialog-Frame :scrollable = true
     1785             then do:
     1786               assign
     1787                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1788               .
     1789             end.
     1790             assign
     1791               frame Dialog-Frame :width = v-frame-width
     1792             .
     1793             for each buf_temp-browse-handle
     1794               where buf_temp-browse-handle.browse-type = 'width':u
     1795             on error undo, next
     1796             :
     1797               assign
     1798                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1799               .
     1800             end.
     1801             assign
     1802               v-diasize-browse-handle :width = v-browse-width
     1803             .
     1804             for each buf_temp-diasize-handle
     1805             on error undo, next
     1806             :
     1807               assign
     1808                 v-object-handle = buf_temp-diasize-handle.handle-value
     1809               .
     1810               if v-object-handle <> v-diasize-resize-button
     1811               then do:
     1812                 assign
     1813                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1814                 .
     1815               end.
     1816             end.
     1817             run diasize_position-resize-button in this-procedure .
     1818           end.
     1819           assign
     1820             v-diasize-change-size = false
     1821           .
     1822           leave move_block .
     1823         end.
     1824       end.
     1825       assign
     1826         v-diasize-need-full-display = true
     1827       .
     1828       if v-diasize-change-size = false
     1829       then do:
     1830         assign
     1831           v-diasize-change-size = true
     1832         .
     1833       end.
     1834       else do:
     1835         return .
     1836       end.
     1837       assign
     1838         v-frame-width = frame Dialog-Frame :width
     1839         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1840         v-browse-width = v-diasize-browse-handle :width
     1841       .
     1842       for each buf_temp-browse-handle
     1843         where buf_temp-browse-handle.browse-type = 'width':u
     1844       :
     1845         assign
     1846           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1847         .
     1848       end.
     1849       for each buf_temp-diasize-handle
     1850       :
     1851         delete buf_temp-diasize-handle .
     1852       end.
     1853       assign
     1854         v-field-group-handle = frame Dialog-Frame :first-child
     1855       .
     1856       do while valid-handle(v-field-group-handle)
     1857       :
     1858         assign
     1859           v-object-handle = v-field-group-handle :first-child
     1860         .
     1861         do while valid-handle(v-object-handle)
     1862         :
     1863           if  v-object-handle <> v-diasize-browse-handle :handle
     1864           and v-object-handle <> v-diasize-resize-button
     1865           and can-query(v-object-handle, "row")
     1866           and can-query(v-object-handle, "height")
     1867           and ( v-object-handle :col + v-object-handle :width
     1868                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1869               )
     1870           then do:
     1871             find first buf_temp-browse-handle
     1872               where buf_temp-browse-handle.browse-type   = 'width':u
     1873                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1874               no-error .
     1875             if available buf_temp-browse-handle
     1876             then do:
     1877             end.
     1878             else do:
     1879               create buf_temp-diasize-handle .
     1880               assign
     1881                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1882                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1883               .
     1884             end.
     1885           end.
     1886           assign
     1887             v-object-handle = v-object-handle :next-sibling
     1888           .
     1889         end.
     1890         assign
     1891           v-field-group-handle = v-field-group-handle :next-sibling
     1892         .
     1893       end.
     1894       do with frame Dialog-Frame
     1895       :
     1896         hide v-diasize-resize-button .
     1897         v-diasize-resize-button :row = 1.
     1898         v-diasize-resize-button :column = 1.
     1899       end.
     1900       if p-change-value > 0
     1901       then do:
     1902         if frame Dialog-Frame :scrollable = true
     1903         then do:
     1904           assign
     1905             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1906             no-error .
     1907           if error-status :error
     1908           or error-status :get-message(1) <> ""
     1909           then do:
     1910             undo move_block, retry move_block.
     1911           end.
     1912         end.
     1913         assign
     1914           frame Dialog-Frame :width = v-frame-width + p-change-value
     1915           no-error .
     1916         if error-status :error
     1917         or error-status :get-message(1) <> ""
     1918         then do:
     1919           undo move_block, retry move_block.
     1920         end.
     1921         assign
     1922           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1923         no-error .
     1924         if error-status :error
     1925         or error-status :get-message(1) <> ""
     1926         then do:
     1927           undo move_block, retry move_block.
     1928         end.
     1929         for each buf_temp-browse-handle
     1930           where buf_temp-browse-handle.browse-type = 'width':u
     1931         on error undo move_block, retry move_block
     1932         :
     1933           assign
     1934             buf_temp-browse-handle.browse-handle :width
     1935               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1936             no-error .
     1937           if error-status :error
     1938           or error-status :get-message(1) <> ""
     1939           then do:
     1940             undo move_block, retry move_block .
     1941           end.
     1942         end.
     1943         for each buf_temp-diasize-handle
     1944         on error undo move_block, retry move_block
     1945         :
     1946           assign
     1947             v-object-handle = buf_temp-diasize-handle.handle-value
     1948           .
     1949           if v-object-handle <> v-diasize-resize-button
     1950           then do:
     1951             assign
     1952               v-object-handle :col = v-object-handle :col + p-change-value
     1953               no-error .
     1954             if error-status :error
     1955             or error-status :get-message(1) <> ""
     1956             then do:
     1957               undo move_block, retry move_block .
     1958             end.
     1959           end.
     1960         end.
     1961       end.
     1962       else do:
     1963         for each buf_temp-diasize-handle
     1964         on error undo move_block, retry move_block
     1965         :
     1966           assign
     1967             v-object-handle = buf_temp-diasize-handle.handle-value
     1968           .
     1969           if v-object-handle <> v-diasize-resize-button
     1970           then do:
     1971             assign
     1972               v-object-handle :col = v-object-handle :col + p-change-value
     1973               no-error .
     1974             if error-status :error
     1975             or error-status :get-message(1) <> ""
     1976             then do:
     1977               undo move_block, retry move_block .
     1978             end.
     1979           end.
     1980         end.
     1981         for each buf_temp-browse-handle
     1982           where buf_temp-browse-handle.browse-type = 'width':u
     1983         on error undo move_block, retry move_block
     1984         :
     1985           assign
     1986             buf_temp-browse-handle.browse-handle :width
     1987               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1988             no-error .
     1989           if error-status :error
     1990           or error-status :get-message(1) <> ""
     1991           then do:
     1992             undo move_block, retry move_block .
     1993           end.
     1994         end.
     1995         assign
     1996           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1997           no-error .
     1998         if error-status :error
     1999         or error-status :get-message(1) <> ""
     2000         then do:
     2001           undo move_block, retry move_block.
     2002         end.
     2003         assign
     2004           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2005         no-error .
     2006         if error-status :error
     2007         or error-status :get-message(1) <> ""
     2008         then do:
     2009           undo move_block, retry move_block.
     2010         end.
     2011         if frame Dialog-Frame :scrollable = true
     2012         then do:
     2013           assign
     2014             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2015           no-error .
     2016           if error-status :error
     2017           or error-status :get-message(1) <> ""
     2018           then do:
     2019             undo move_block, retry move_block.
     2020           end.
     2021         end.
     2022       end.
     2023       if p-move-resize
     2024       then do:
     2025         run diasize_position-resize-button in this-procedure .
     2026       end.
     2027       if v-diasize-wndstore = true
     2028       then do:
     2029         if connected("ub") = true
     2030         then do:
     2031           define variable v-cntxt-db-num        as integer   no-undo .
     2032           define variable v-cntxt-userid        as character no-undo .
     2033           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2034                                             , OUTPUT v-cntxt-userid
     2035                                             ) .
     2036           run gbl/wndsizew.p
     2037             (input  v-cntxt-db-num
     2038             ,input  v-cntxt-userid
     2039             ,input  v-diasize-proc-name
     2040             ,input  'width':u
     2041             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2042             ) .
     2043         end.
     2044       end.
     2045     end.
     2046     assign
     2047       v-diasize-change-size = false
     2048     .
     2049   end procedure.
     2050   procedure diasize_set-width :
     2051     define input  parameter p-new-width  as decimal   no-undo .
     2052     define input  parameter p-move-resize as logical   no-undo .
     2053     do
     2054     on error undo, return error return-value
     2055     :
     2056       run diasize_change-width in this-procedure
     2057         (input  (p-new-width - frame Dialog-Frame :width)
     2058         ,input  p-move-resize
     2059         ) .
     2060     end.
     2061   end procedure.
     2062   procedure diasize_position-resize-button :
     2063     do with frame Dialog-Frame
     2064     :
     2065       hide v-diasize-resize-button .
     2066       assign
     2067         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2068                     - 1
     2069                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2070         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2071                     - 1
     2072                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2073       .
     2074       view v-diasize-resize-button .
     2075     end.
     2076   end procedure.
     2077   on alt-right anywhere
     2078   do:
     2079     run diasize_change-width in this-procedure
     2080       (input 1
     2081       ,input true
     2082       ) .
     2083     return no-apply .
     2084   end.
     2085   on alt-left anywhere
     2086   do:
     2087     run diasize_change-width in this-procedure
     2088       (input -1
     2089       ,input true
     2090       ) .
     2091     return no-apply .
     2092   end.
     2093   on alt-down anywhere
     2094   do:
     2095     run diasize_change-height in this-procedure
     2096       (input 1
     2097       ,input true
     2098       ) .
     2099     return no-apply .
     2100   end.
     2101   on alt-up anywhere
     2102   do:
     2103     run diasize_change-height in this-procedure
     2104       (input -1
     2105       ,input true
     2106       ) .
     2107     return no-apply .
     2108   end.
     2109   on alt-enter of frame Dialog-Frame
     2110   do:
     2111     run diasize_maximize in this-procedure
     2112       (input  ?
     2113       ).
     2114     return no-apply .
     2115   end.
     2116   procedure diasize_end-move :
     2117     do
     2118     on error undo, return error return-value
     2119     :
     2120       define variable v-row-delta as decimal   no-undo .
     2121       define variable v-col-delta as decimal   no-undo .
     2122       define variable v-new-row as decimal   no-undo .
     2123       define variable v-new-col as decimal   no-undo .
     2124       assign
     2125         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2126         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2127       .
     2128       assign
     2129         v-row-delta = v-new-row - frame Dialog-Frame :height
     2130         v-col-delta = v-new-col - frame Dialog-Frame :width
     2131       .
     2132       run diasize_change-height in this-procedure
     2133         (input v-row-delta
     2134         ,input true
     2135         ) .
     2136       run diasize_change-width in this-procedure
     2137         (input v-col-delta
     2138         ,input true
     2139         ) .
     2140     end.
     2141   end procedure.
     2142   procedure diasize_maximize :
     2143     define input  parameter p-action as logical   no-undo .
     2144     do
     2145     on error undo, return error return-value
     2146     :
     2147       if p-action = ?
     2148       then do:
     2149         if v-diasize-need-maximize = true
     2150         then do:
     2151           assign
     2152             p-action = true
     2153           .
     2154         end.
     2155         else do:
     2156           assign
     2157             p-action = false
     2158           .
     2159         end.
     2160       end.
     2161       if p-action = true
     2162       then do:
     2163         run diasize_change-height in this-procedure
     2164           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2165               - frame Dialog-Frame :height-chars
     2166           ,input true
     2167           ) .
     2168         run diasize_change-width in this-procedure
     2169           (input session :width-chars
     2170               - frame Dialog-Frame :width-chars
     2171           ,input true
     2172           ) .
     2173         assign
     2174           v-diasize-need-maximize = false
     2175         .
     2176       end.
     2177       else do:
     2178         run diasize_change-width in this-procedure
     2179           (input v-diasize-orig-frame-width
     2180               - frame Dialog-Frame :width-chars
     2181           ,input true
     2182           ) .
     2183         run diasize_change-height in this-procedure
     2184           (input v-diasize-orig-frame-height
     2185               - frame Dialog-Frame :height-chars
     2186           ,input true
     2187           ) .
     2188         assign
     2189           v-diasize-need-maximize = true
     2190         .
     2191       end.
     2192     end.
     2193   end procedure.
     2194   procedure diasize_restore-orig-size :
     2195     do
     2196     on error undo, return error return-value
     2197     :
     2198       assign
     2199         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2200         v-diasize-current-frame-height = frame Dialog-Frame :height
     2201       .
     2202       run diasize_set-height in this-procedure
     2203         (input  v-diasize-orig-frame-height
     2204         ,input  true
     2205         ) .
     2206       run diasize_set-width in this-procedure
     2207         (input  v-diasize-orig-frame-width
     2208         ,input  true
     2209         ) .
     2210     end.
     2211   end procedure.
     2212   procedure diasize_restore-current-size :
     2213     do
     2214     on error undo, return error return-value
     2215     :
     2216       run diasize_set-height in this-procedure
     2217         (input  v-diasize-current-frame-height
     2218         ,input  true
     2219         ) .
     2220       run diasize_set-width in this-procedure
     2221         (input  v-diasize-current-frame-width
     2222         ,input  true
     2223         ) .
     2224     end.
     2225   end procedure.
     2226   procedure diasize_set-browse-handle :
     2227     define input  parameter p-browse-handle as handle   no-undo .
     2228     define buffer buf_temp-browse-handle for temp-browse-handle .
     2229     do
     2230     on error undo, return error return-value
     2231     :
     2232       assign
     2233         v-diasize-browse-handle = p-browse-handle
     2234       .
     2235       for each buf_temp-browse-handle
     2236       on error undo, return error return-value
     2237       :
     2238         delete buf_temp-browse-handle .
     2239       end.
     2240     end.
     2241   end procedure.
     2242   procedure diasize_add_browse :
     2243     define input  parameter p-browse-type   as character no-undo .
     2244     define input  parameter p-browse-handle as handle    no-undo .
     2245     define buffer buf_temp-browse-handle for temp-browse-handle .
     2246     do
     2247     on error undo, return error return-value
     2248     :
     2249       assign
     2250         v-diasize-browse-number = v-diasize-browse-number + 1
     2251       .
     2252       create buf_temp-browse-handle .
     2253       assign
     2254         buf_temp-browse-handle.browse-type   = p-browse-type
     2255         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2256         buf_temp-browse-handle.browse-handle = p-browse-handle
     2257       .
     2258     end.
     2259   end procedure.
     2260   procedure diasize_init :
     2261     define variable v-default-value    as logical   no-undo .
     2262     define variable v-restore-saved    as logical   no-undo .
     2263     define variable v-resize-value-str as character no-undo .
     2264     do
     2265     on error undo, return error return-value
     2266     :
     2267       do with frame Dialog-Frame
     2268       :
     2269         assign
     2270           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2271           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2272           v-diasize-browse-handle     = browse br-dis-thbj-rule :handle
     2273         .
     2274         create button v-diasize-resize-button
     2275         assign
     2276           parent        = frame Dialog-Frame :first-child
     2277           label         = "s"
     2278           height-pixels = 16
     2279           width-pixels  = 16
     2280           visible       = true
     2281           sensitive     = true
     2282           movable       = true
     2283           triggers:
     2284             on end-move persistent run diasize_end-move in this-procedure .
     2285           end triggers.
     2286         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2287         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2288         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2289         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2290         assign
     2291           v-diasize-wndmax = false
     2292         .
     2293         if connected("ub") = true
     2294         then do:
     2295           define variable v-cntxt-db-num        as integer   no-undo .
     2296           define variable v-cntxt-userid        as character no-undo .
     2297           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2298                                             , OUTPUT v-cntxt-userid
     2299                                             ) .
     2300           run gbl/wndpar_r.p
     2301             (input  v-cntxt-db-num
     2302             ,input  v-cntxt-userid
     2303             ,input  'wndmax':U
     2304             ,output v-diasize-wndmax
     2305             ,output v-default-value
     2306             ) .
     2307         end.
     2308         assign
     2309           v-diasize-wndstore = false
     2310         .
     2311         if connected("ub") = true
     2312         then do:
     2313           run gbl/wndpar_r.p
     2314             (input  v-cntxt-db-num
     2315             ,input  v-cntxt-userid
     2316             ,input  'wndstore':U
     2317             ,output v-diasize-wndstore
     2318             ,output v-default-value
     2319             ) .
     2320         end.
     2321         assign
     2322           v-diasize-proc-name = entry(1, program-name(2), '.')
     2323         .
     2324         if v-diasize-wndstore = true
     2325         then do:
     2326           assign
     2327             v-restore-saved = false
     2328           .
     2329           if connected("ub") = true
     2330           then do:
     2331             run gbl/wndsizer.p
     2332               (input  v-cntxt-db-num
     2333               ,input  v-cntxt-userid
     2334               ,input  v-diasize-proc-name
     2335               ,input  'height':u
     2336               ,output v-resize-value-str
     2337               ) .
     2338             if v-resize-value-str <> '':U
     2339             then do:
     2340               run diasize_change-height in this-procedure
     2341                 (input  integer(v-resize-value-str)
     2342                 ,input  true
     2343                 ) .
     2344               assign
     2345                 v-restore-saved = true
     2346               .
     2347             end.
     2348           end.
     2349           if connected("ub") = true
     2350           then do:
     2351             run gbl/wndsizer.p
     2352               (input  v-cntxt-db-num
     2353               ,input  v-cntxt-userid
     2354               ,input  v-diasize-proc-name
     2355               ,input  'width':u
     2356               ,output v-resize-value-str
     2357               ) .
     2358             if v-resize-value-str <> '':U
     2359             then do:
     2360               run diasize_change-width in this-procedure
     2361                 (input  integer(v-resize-value-str)
     2362                 ,input  true
     2363                 ) .
     2364               assign
     2365                 v-restore-saved = true
     2366               .
     2367             end.
     2368           end.
     2369           if v-restore-saved <> true
     2370           then do:
     2371             if v-diasize-wndmax = true
     2372             then do:
     2373               run diasize_maximize in this-procedure
     2374                 (input  true
     2375                 ) .
     2376             end.
     2377           end.
     2378         end.
     2379         else do:
     2380           if v-diasize-wndmax = true
     2381           then do:
     2382             run diasize_maximize in this-procedure
     2383               (input  true
     2384               ) .
     2385           end.
     2386         end.
     2387       end.
     2388     end.
     2389   end procedure.
     2390   procedure diasize_need-full-display :
     2391     define output parameter p-need-full-display as logical   no-undo .
     2392     do
     2393     on error undo, return error return-value
     2394     :
     2395       assign
     2396         p-need-full-display = v-diasize-need-full-display
     2397       .
     2398       assign
     2399         v-diasize-need-full-display = false
     2400       .
     2401     end.
     2402   end procedure.
     2403   procedure get-context :
     2404      define output parameter p-db-num as integer          no-undo.
     2405      define output parameter p-user-id as character        no-undo.
     2406      define variable v-login               as character    no-undo.
     2407      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2408      define buffer buf_user-login  for ub.user-login .
     2409      do
     2410      on error undo, return error
     2411      :
     2412            FIND FIRST buf_sys-ctrl no-lock.
     2413            ASSIGN
     2414               v-login = USERID("ub")
     2415               p-db-num = buf_sys-ctrl.db-num
     2416            .
     2417            FIND FIRST buf_user-login
     2418                 WHERE buf_user-login.db-num = p-db-num
     2419                   AND buf_user-login.user-login = v-login
     2420                 no-lock
     2421                 no-error
     2422                 .
     2423            IF AVAILABLE buf_user-login
     2424            THEN DO:
     2425               assign
     2426                  p-user-id = buf_user-login.user-id
     2427               .
     2428            END.
     2429      end.
     2430   end procedure.
     2431   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2432   on f5 of frame Dialog-Frame anywhere
     2433   do:
     2434      v-doc-rec = recid(X_dis-thbj-rule).  Run OpenBR in this-procedure ( input yes, input no, input '':U).  REPOSITION br-dis-thbj-rule to recid v-doc-rec No-ERROR.               apply 'value-changed' to br-dis-thbj-rule.
     2435       apply "VALUE-CHANGED" to BR-dis-thbj-rule.
     2436   end.
     2437   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2438   on F9 of frame Dialog-Frame anywhere do:
     2439     if not available ub.goods then
     2440       return no-apply.
     2441     gds-rec = recid (ub.goods).
