     2777         (INPUT filter-name-21
     2778         ) no-error .
     2779     assign
     2780       l-filter-open-21 = false
     2781     .
     2782     if flt-rec-21 <> ?
     2783       or sort-column-phrase > ""
     2784     then do:
     2785       define variable  parameter-2-21 as character no-undo .
     2786       define variable  parameter-3-21 as character no-undo .
     2787       define variable  parameter-4-21 as character no-undo .
     2788       define variable  parameter-5-21 as character no-undo .
     2789       define variable  parameter-6-21 as character no-undo .
     2790       define variable  parameter-7-21 as character no-undo .
     2791         assign
     2792         parameter-3-21 =
     2793                                 "FOR EACH X_dis-thbj-rule"
