     2748       frame Dialog-Frame:TITLE =
     2749                                     substitute("&1"
     2750                                     , title0
     2751                                     )
     2752       filter-label = substitute("&1", filter-label0)
     2753                                     .
     2754   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
