     4214   procedure ext-artic-proc :
     4215   define output parameter p-description as character no-undo .
     4216   define buffer current_c-ext-artic for ub.c-ext-artic.
     4217   define buffer buf_clients         for ub.clients.
     4218   do
     4219   on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     4220   :
     4221     if buf_c-gds-hist.action <> integer('99':U) then do:
     4222       find first current_c-ext-artic no-lock  where
     4223              current_c-ext-artic.gds-code = buf_c-gds-hist.gds-code
     4224           and current_c-ext-artic.corr-user-db-num = buf_c-gds-hist.corr-user-db-num
     4225           and current_c-ext-artic.chip-num = buf_c-gds-hist.chip-num
     4226       no-error .
     4227       if not available current_c-ext-artic then do:
     4228         v-mess = "Неверная ссылка на c-ext-artic в таблице c-gds-hist"  .
     4229         run err-mess in this-procedure ( input-output v-mess).
     4230         return error v-mess.
     4231       end.
     4232   define variable v-label-param as character no-undo .
     4233   v-label-param =
     4234     "ext-artic" + chr(4) + "Внешний артикул" + chr(4) + "" + chr(8)
     4235    + "ps" + chr(4) + "Описание" + chr(4) + "" + chr(8)
     4236    + "status_" + chr(4) + "Статус" + chr(4) + ""  .
     4237    run proc-full-temp-changes in this-procedure (
     4238                                                input  (buf_c-gds-hist.action = integer('1':U))
     4239                                               ,input  (buf_c-gds-hist.action = integer('99':U))
     4240                                               ,input  buffer current_c-ext-artic:handle
     4241                                               ,input  'ext-artic':U
     4242                                               ,input  "ext-artic,ps,status_"
     4243                                               ,input  v-label-param).
     4244       find first buf_clients no-lock
     4245         where buf_clients.obj-type = current_c-ext-artic.cli-type
     4246           and buf_clients.obj-code = current_c-ext-artic.cli-code
     4247       no-error .
     4248       assign
     4249         p-description = substitute( "Внешний артикул &1/&2 '&3'"
     4250                                   , current_c-ext-artic.cli-code
     4251                                   , current_c-ext-artic.cli-type
     4252                                   , if available buf_clients then
     4253                                       buf_clients.obj-name
     4254                                     else
     4255                                       "":U
     4256                                   )
     4257       .
     4258     end.
     4259   end.
     4260   end procedure.
     4261   procedure sert-join-proc :
     4262   define output parameter p-description as character no-undo .
     4263   define variable v-tooltip as character no-undo .
     4264   define variable v-label as character no-undo .
     4265   define variable v-field-name as character no-undo .
     4266   define variable v-field-function as character no-undo .
     4267   define variable jj as integer no-undo .
     4268   define variable v-field-label  as character no-undo .
     4269   define variable v-field-list as character no-undo .
     4270   define buffer curr_sert-join   for ub.sert-join  .
     4271   define buffer curr_c-sert for ub.c-sert  .
     4272   define buffer new_c-sert  for ub.c-sert  .
     4273   define buffer buf_c-table-bind for ub.c-table-bind.
     4274   do
     4275   on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     4276   :
     4277       find first buf_c-table-bind no-lock where
     4278                 buf_c-table-bind.corr-user-db-num = buf_c-gds-hist.corr-user-db-num
     4279             AND buf_c-table-bind.tbl-name-rec     = 'c-gds-hist':U
     4280             AND buf_c-table-bind.chip-num-rec     = buf_c-gds-hist.chip-num no-error .
     4281       if not available buf_c-table-bind then do:
     4282         v-mess = "Неверная ссылка на c-table-bind в таблице c-gds-hist".
     4283         run err-mess in this-procedure ( input-output v-mess).
     4284         return error v-mess.
     4285       end.
     4286     find first curr_c-sert no-lock where
     4287               curr_c-sert.b-code        = buf_c-gds-hist.b-code
     4288           AND curr_c-sert.corr-user-db-num = buf_c-table-bind.corr-user-db-num
     4289           AND curr_c-sert.chip-num        = buf_c-table-bind.chip-num-src   no-error .
     4290     if not avail curr_c-sert then do:
     4291       v-mess = "Неверная ссылка на c-sert-join в таблице c-gds-hist".
     4292       run err-mess in this-procedure ( input-output v-mess).
     4293       return error v-mess.
     4294     end.
     4295     find first new_c-sert no-lock where
     4296                 new_c-sert.b-code = buf_c-gds-hist.b-code
     4297             AND new_c-sert.cli-type = curr_c-sert.cli-type
     4298             AND new_c-sert.cli-code = curr_c-sert.cli-code
     4299             AND new_c-sert.sert-code = curr_c-sert.sert-code
     4300             AND new_c-sert.chip-num > p-chip-num
     4301             no-error.
     4302     if not available new_c-sert then do:
     4303       find first curr_sert-join no-lock where
     4304                   curr_sert-join.b-code = buf_c-gds-hist.b-code
     4305               AND curr_sert-join.cli-type  = curr_c-sert.cli-type
     4306               AND curr_sert-join.cli-code  = curr_c-sert.cli-code
     4307               AND curr_sert-join.sert-code = curr_c-sert.sert-code
     4308               no-error.
     4309       if not available curr_sert-join then do:
     4310           return error.
     4311       end.
     4312       buffer-compare curr_sert-join to curr_c-sert
     4313       case-sensitive
     4314       save result in v-chg-fields.
     4315     end.
     4316     else do:
     4317       buffer-compare new_c-sert
     4318       except chip-num corr-date corr-user-name corr-user-db-num corr-time
     4319       to curr_c-sert
     4320       case-sensitive
     4321       save result in v-chg-fields.
     4322     end.
     4323     _ii:
     4324     do ii = 1 to num-entries(v-chg-fields):
     4325       assign
     4326       v-field-name = entry(ii, v-chg-fields)
     4327       jj = lookup(v-field-name, "b-code,cli-code,cli-type,sert-code").
     4328       if jj = 0 then next _ii.
     4329       assign
     4330       v-field-label = entry(jj, "Бар-код,Код контрагента,Тип контрагента,№ сертификата")
     4331       v-field-function = entry(jj, ",,,")
     4332       .
     4333       create temp-changes.
     4334       assign
     4335       temp-changes.f_name = v-field-name
     4336       temp-changes.l_name = v-field-label
     4337       temp-changes.v_old = (if buf_c-gds-hist.action = integer('1':U)
     4338                             then "":U
     4339                             else string(buffer curr_c-sert:buffer-field(v-field-name):buffer-value))
     4340       temp-changes.v_new =  (if available new_c-sert
     4341                                   then string(buffer new_c-sert:buffer-field(v-field-name):buffer-value)
     4342                                   else string(buffer curr_sert-join:buffer-field(v-field-name):buffer-value)
     4343                              )
     4344       .
     4345       if v-field-function <> '':U then do:
     4346         assign
     4347         temp-changes.v_old = DYNAMIC-function(v-field-function, temp-changes.v_old)
     4348         temp-changes.v_new = DYNAMIC-function(v-field-function, temp-changes.v_new)
     4349         .
     4350       end.
     4351     end.
     4352   end.
     4353   end procedure.
     4354   procedure recipe-gds-proc :
     4355   define output parameter p-description as character no-undo .
     4356   define variable v-tooltip as character no-undo .
     4357   define variable v-label as character no-undo .
     4358   define variable v-is-created as logical no-undo .
     4359   define variable v-field-name as character no-undo .
     4360   define variable v-field-function as character no-undo .
     4361   define variable jj as integer no-undo .
     4362   define variable v-field-label  as character no-undo .
     4363   define buffer buf_c-table-bind for ub.c-table-bind.
     4364   define buffer curr_recipe-gds for ub.recipe-gds  .
     4365   define buffer curr_c-recipe-gds for ub.c-recipe-gds  .
     4366   define buffer new_c-recipe-gds for ub.c-recipe-gds  .
     4367   do
     4368   on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     4369   :
     4370       find first buf_c-table-bind no-lock where
     4371                 buf_c-table-bind.corr-user-db-num = buf_c-gds-hist.corr-user-db-num
     4372             AND buf_c-table-bind.tbl-name-rec     = 'c-gds-hist':U
     4373             AND buf_c-table-bind.chip-num-rec     = buf_c-gds-hist.chip-num no-error .
     4374       if not available buf_c-table-bind then do:
     4375         v-mess = "Неверная ссылка на c-table-bind в таблице c-gds-hist".
     4376         run err-mess in this-procedure ( input-output v-mess).
     4377         return error v-mess.
     4378       end.
     4379       find first curr_c-recipe-gds no-lock where
     4380                  curr_c-recipe-gds.gds-code = p-gds-code
     4381              AND curr_c-recipe-gds.corr-user-db-num = buf_c-table-bind.corr-user-db-num
     4382              AND curr_c-recipe-gds.chip-num = buf_c-table-bind.chip-num-src  no-error .
     4383       if not avail curr_c-recipe-gds then do:
     4384         v-mess = "Неверная ссылка на c-recipe-gds в таблице c-table-bind".
     4385         run err-mess in this-procedure ( input-output v-mess).
     4386         return error v-mess.
     4387       end.
     4388       find first new_c-recipe-gds no-lock where
     4389                   new_c-recipe-gds.gds-code = buf_c-gds-hist.gds-code
     4390               AND new_c-recipe-gds.chip-num > buf_c-table-bind.chip-num-src
     4391               AND new_c-recipe-gds.corr-user-db-num = buf_c-table-bind.corr-user-db-num  no-error.
     4392       if not available new_c-recipe-gds then do:
     4393           find first curr_recipe-gds no-lock where
     4394                       curr_recipe-gds.gds-code = buf_c-gds-hist.gds-code
     4395                   no-error.
     4396           if not available curr_recipe-gds then do:
     4397               return error.
     4398           end.
     4399           buffer-compare curr_recipe-gds to curr_c-recipe-gds
     4400           case-sensitive
     4401           save result in v-chg-fields.
     4402       end.
     4403       else do:
     4404           buffer-compare new_c-recipe-gds except chip-num corr-date corr-user-name corr-user-db-num corr-time
     4405           to curr_c-recipe-gds
     4406           case-sensitive
     4407           save result in v-chg-fields.
     4408       end.
     4409     _ii:
     4410     do ii = 1 to num-entries(v-chg-fields):
     4411       assign
     4412       v-field-name = entry(ii, v-chg-fields)
     4413       jj = lookup(v-field-name, "artic,brutto-qnty,calc-method,coeff-waste,is-waste,proc-number,prod-code,prod-type,qnty,recipe-code").
     4414       if jj = 0 then next _ii.
     4415       assign
     4416       v-field-label = entry(jj, "Артикул,Кол-во брутто,Метод расчета брутто,Коэфф.отходов,Флаг ОТХОДЫ,Пор.№ при обработке,Код пр-ля,Тип пр-ля,Кол-во по рецепту,Номер рецепта")
     4417       v-field-function = entry(jj, ",,,,,,,,,")
     4418       .
     4419       create temp-changes.
     4420       assign
     4421       temp-changes.f_name = v-field-name
     4422       temp-changes.l_name = v-field-label
     4423       temp-changes.v_old = (if v-is-created
     4424                             then "":U
     4425                             else string(buffer curr_c-recipe-gds:buffer-field(v-field-name):buffer-value))
     4426       temp-changes.v_new = (if available new_c-recipe-gds
     4427                             then string(buffer new_c-recipe-gds:buffer-field(v-field-name):buffer-value)
     4428                             else string(buffer curr_recipe-gds:buffer-field(v-field-name):buffer-value)
     4429                             )
     4430       .
     4431       if v-field-function <> '':U then do:
     4432         assign
     4433         temp-changes.v_old = DYNAMIC-function(v-field-function, temp-changes.v_old)
     4434         temp-changes.v_new = DYNAMIC-function(v-field-function, temp-changes.v_new)
     4435         .
     4436       end.
     4437     end.
     4438   end.
     4439   end procedure.
     4440   procedure recipe-proc :
     4441   define output parameter p-description as character no-undo .
     4442   define variable v-tooltip as character no-undo .
     4443   define variable v-label as character no-undo .
     4444   define variable v-is-created as logical no-undo .
     4445   define variable v-field-name as character no-undo .
     4446   define variable v-field-function as character no-undo .
     4447   define variable jj as integer no-undo .
     4448   define variable v-field-label  as character no-undo .
     4449   define buffer buf_c-table-bind for ub.c-table-bind.
     4450   define buffer curr_recipe for ub.recipe  .
     4451   define buffer curr_c-recipe for ub.c-recipe  .
     4452   define buffer new_c-recipe for ub.c-recipe  .
     4453   do
     4454   on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     4455   :
     4456       find first buf_c-table-bind no-lock where
     4457                 buf_c-table-bind.corr-user-db-num = buf_c-gds-hist.corr-user-db-num
     4458             AND buf_c-table-bind.tbl-name-rec     = 'c-gds-hist':U
     4459             AND buf_c-table-bind.chip-num-rec     = buf_c-gds-hist.chip-num no-error .
     4460       if not available buf_c-table-bind then do:
     4461         v-mess = "Неверная ссылка на c-table-bind в таблице c-gds-hist".
     4462         run err-mess in this-procedure ( input-output v-mess).
     4463         return error v-mess.
     4464       end.
     4465       find first curr_c-recipe no-lock where
     4466                  curr_c-recipe.gds-code = p-gds-code
     4467              AND curr_c-recipe.corr-user-db-num = buf_c-table-bind.corr-user-db-num
     4468              AND curr_c-recipe.chip-num = buf_c-table-bind.chip-num-src  no-error .
     4469       if not avail curr_c-recipe then do:
     4470         v-mess = "Неверная ссылка на c-recipe в таблице c-table-bind".
     4471         run err-mess in this-procedure ( input-output v-mess).
     4472         return error v-mess.
     4473       end.
     4474       find first new_c-recipe no-lock where
     4475                   new_c-recipe.gds-code = buf_c-gds-hist.gds-code
     4476               AND new_c-recipe.chip-num > buf_c-table-bind.chip-num-src
     4477               AND new_c-recipe.corr-user-db-num = buf_c-table-bind.corr-user-db-num  no-error.
     4478       if not available new_c-recipe then do:
     4479           find first curr_recipe no-lock where
     4480                       curr_recipe.gds-code = buf_c-gds-hist.gds-code
     4481                   no-error.
     4482           if not available curr_recipe then do:
     4483               return error.
     4484           end.
     4485           buffer-compare curr_recipe to curr_c-recipe
     4486           case-sensitive
     4487           save result in v-chg-fields.
     4488       end.
     4489       else do:
     4490           buffer-compare new_c-recipe except chip-num corr-date corr-user-name corr-user-db-num corr-time
     4491           to curr_c-recipe
     4492           case-sensitive
     4493           save result in v-chg-fields.
     4494       end.
     4495     _ii:
     4496     do ii = 1 to num-entries(v-chg-fields):
     4497       assign
     4498       v-field-name = entry(ii, v-chg-fields)
     4499       jj = lookup(v-field-name, "host-code,obj-code,obj-type,portion-qnty,portion-weight,recipe-design,recipe-name,recipe-order,recipe-quality,recipe-ref-num,recipe-technique,recipe-template,recipe-type,sale-factor,artic,brutto-qnty,prod-code,prod-type,qnty,recipe-code").
     4500       if jj = 0 then next _ii.
     4501       assign
     4502       v-field-label = entry(jj, "Фирма,Код объекта,Тип объекта,Кол-во порций,Вес порции,Способ оформления,Название,Порядок при обработке,Показатели качества,Номер в справочнике рецептур,Технология,Ссылка на спр.рецептур,Тип рецепта,Кратность при продаже,Артикул,Кол-во брутто,Код пр-ля,Тип пр-ля,Кол-во по рецепту,Номер рецепта")
     4503       v-field-function = entry(jj, ",,,,,,,,,,,,,,,,,,,")
     4504       .
     4505       create temp-changes.
     4506       assign
     4507       temp-changes.f_name = v-field-name
     4508       temp-changes.l_name = v-field-label
     4509       temp-changes.v_old = (if v-is-created
     4510                             then "":U
     4511                             else string(buffer curr_c-recipe:buffer-field(v-field-name):buffer-value))
     4512       temp-changes.v_new = (if available new_c-recipe
     4513                             then string(buffer new_c-recipe:buffer-field(v-field-name):buffer-value)
     4514                             else string(buffer curr_recipe:buffer-field(v-field-name):buffer-value)
     4515                             )
     4516       .
     4517       if v-field-function <> '':U then do:
     4518         assign
     4519         temp-changes.v_old = DYNAMIC-function(v-field-function, temp-changes.v_old)
     4520         temp-changes.v_new = DYNAMIC-function(v-field-function, temp-changes.v_new)
     4521         .
     4522       end.
     4523     end.
     4524   end.
     4525   end procedure.
     4526   define temp-table temp-goods no-undo like ub.goods.
     4527   procedure ext-classif-proc :
     4528   define output parameter p-description as character no-undo .
     4529   define variable v-uniq-key-rec as character no-undo .
     4530   define variable v-field-list as character no-undo .
     4531   define variable v-value-list as character no-undo .
     4532   define variable v-label-param as character no-undo .
     4533   define buffer curr_c-ext-classif for ub.c-ext-classif  .
     4534   do
     4535   on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     4536   :
     4537       create temp-goods.
     4538       buffer-copy buf_c-gds-hist to temp-goods.
     4539       run gen-key-rec in this-procedure ( input 'goods':U
     4540                                          ,input (buffer temp-goods:handle)
     4541                                          ,output v-uniq-key-rec).
     4542       delete temp-goods.
     4543       find first curr_c-ext-classif no-lock where
     4544                  curr_c-ext-classif.classif-subject = 'ext-classif':U
     4545              and curr_c-ext-classif.uniq-key-rec = v-uniq-key-rec
     4546              AND curr_c-ext-classif.chip-num = p-chip-num
     4547              no-error .
     4548       if not avail curr_c-ext-classif then do:
     4549          v-mess = "Неверная ссылка на c-ext-classif в таблице c-gds-hist".
     4550          run err-mess in this-procedure ( input-output v-mess).
     4551          return error v-mess.
     4552       end.
     4553   case curr_c-ext-classif.classif-name:
     4554      when 'exp-accor-gds-code':U then do:
     4555      assign
     4556      v-label-param = "key#_one" + chr(4) + "Код топлива " + chr(4) + ""
     4557      p-description = "Классификатор АККОР"
     4558      .
     4559     end.
     4560   end case.
     4561   MESSAGE
     4562   VIEW-AS ALERT-BOX.
     4563    run proc-full-temp-changes in this-procedure (
     4564                                                input  (buf_c-gds-hist.action = integer('1':U))
     4565                                               ,input  (buf_c-gds-hist.action = integer('99':U))
     4566                                               ,input  buffer curr_c-ext-classif:handle
     4567                                               ,input  'ext-classif':U
     4568                                               ,input  "key#_one"
     4569                                               ,input  v-label-param).
     4570   end.
     4571   end procedure.
     4572   procedure gds-obj-prop-attr-proc :
     4573   define output parameter p-description as character no-undo .
     4574   define variable v-tooltip as character no-undo .
     4575   define variable v-label as character no-undo .
     4576   define buffer current_c-gds-obj-prop-attr for ub.c-gds-obj-attr .
     4577   do
     4578   on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     4579   :
     4580   find first current_c-gds-obj-prop-attr no-lock where
     4581               current_c-gds-obj-prop-attr.gds-code = p-gds-code
     4582           AND current_c-gds-obj-prop-attr.chip-num = p-chip-num
     4583           AND current_c-gds-obj-prop-attr.attr-code = buf_c-gds-hist.attr-code
     4584           no-error .
     4585   define variable v-label-param as character no-undo .
     4586   v-label-param =
     4587     "obj-type" + chr(4) + "Тип объекта" + chr(4) + "" + chr(8)
     4588    + "obj-code" + chr(4) + "Код объекта" + chr(4) + "" + chr(8)
     4589    + "attr-code" + chr(4) + "Атрибут" + chr(4) + "" + chr(8)
     4590    + "gds-code" + chr(4) + "Код товара" + chr(4) + "" + chr(8)
     4591    + "attr-value" + chr(4) + "Значение атрибута" + chr(4) + ""  .
     4592    run proc-full-temp-changes in this-procedure (
     4593                                                input  (buf_c-gds-hist.action = integer('1':U))
     4594                                               ,input  (buf_c-gds-hist.action = integer('99':U))
     4595                                               ,input  buffer current_c-gds-obj-prop-attr:handle
     4596                                               ,input  'gds-obj-prop-attr':U
     4597                                               ,input  "obj-type,obj-code,attr-code,gds-code,attr-value"
     4598                                               ,input  v-label-param).
     4599       run gdspoatr-tooltip in this-procedure (
     4600                   input  current_c-gds-obj-prop-attr.attr-code
     4601                   ,output v-tooltip
     4602                   ,output v-label
     4603                   ) no-error .
     4604       assign
     4605       p-description = "Атрибут" + chr(32) + v-label
     4606       .
     4607   end.
     4608   end procedure.
     4609   PROCEDURE err-mess:
     4610     DEFINE INPUT-output PARAMETER p-mess as character No-UNDO.
     4611     CASE p-silent:
     4612       when yes then do:
     4613         p-mess =  substitute("История товара с кодом &1: щепка &2 Предмет изменений &3&4&5"
     4614                               ,p-gds-code
     4615                               ,p-chip-num
     4616                               ,p-subject
     4617                               ,chr(10)
     4618                               ,p-mess).
     4619       end.
     4620       otherwise do:
     4621         message
     4622         p-mess
     4623         view-as alert-box error .
     4624       end.
     4625     end.
     4626   END PROCEDURE.
