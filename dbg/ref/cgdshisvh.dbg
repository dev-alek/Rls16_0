     3665   procedure s-coeff-proc :
     3666   define output parameter p-description as character no-undo .
     3667   define variable v-tooltip as character no-undo .
     3668   define variable v-label as character no-undo .
     3669   define buffer current_c-s-coeff for ub.c-s-coeff  .
