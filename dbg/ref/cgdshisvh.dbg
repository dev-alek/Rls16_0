     3689     "coeff-value" + chr(4) + "Значение коэфф" + chr(4) + "" + chr(8)
     3690    + "credate" + chr(4) + "Дата создания" + chr(4) + "" + chr(8)
     3691    + "creid" + chr(4) + "Создал" + chr(4) + ""  .
     3692    run proc-full-temp-changes in this-procedure (
     3693                                                input  (buf_c-gds-hist.action = integer('1':U))
     3694                                               ,input  (buf_c-gds-hist.action = integer('99':U))
     3695                                               ,input  buffer current_c-s-coeff:handle
     3696                                               ,input  's-coeff':U
     3697                                               ,input  "coeff-value,credate,creid"
     3698                                               ,input  v-label-param).
