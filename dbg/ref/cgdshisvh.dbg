     1639       define input parameter p-rule-num       like ub.dis-gds-rule.rule-num    no-undo .
     1640       define input parameter p-nonunique      like ub.dis-gds-rule.nonunique   no-undo .
     1641       define buffer buf_dis-gds-rule for ub.dis-gds-rule .
