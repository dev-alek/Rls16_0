     3903   procedure tax-rate-gds-proc :
     3904   define output parameter p-description as character no-undo .
     3905   define variable v-tooltip as character no-undo .
     3906   define variable v-label as character no-undo .
     3907   define variable jj as integer no-undo .
     3908   define variable v-field-label as character no-undo .
     3909   define variable v-field-name as character no-undo .
     3910   define variable v-old-rate-code like ub.tax-rate-gds.rate-code no-undo .
     3911   define variable v-old-fact-order like ub.tax-rate-gds.fact-order no-undo .
     3912   define variable v-old-fact-date as date no-undo .
     3913   define variable v-new-rate-code like ub.tax-rate-gds.rate-code no-undo .
     3914   define variable v-new-fact-order like ub.tax-rate-gds.fact-order no-undo .
     3915   define variable v-new-fact-date as date no-undo .
     3916   define buffer buf_next_tax-rate-gds for ub.tax-rate-gds.
     3917   define buffer buf_tax for ub.tax.
     3918   do
     3919   on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     3920   :
     3921       find first buf_tax no-lock where
     3922                 buf_tax.tax-code = buf_c-gds-hist.tax-code no-error .
     3923       if available buf_tax then do:
     3924         assign
     3925         p-description = buf_tax.tax-name.
     3926       end.
     3927       assign
     3928       v-old-rate-code = buf_c-gds-hist.rate-code
     3929       v-old-fact-order = buf_c-gds-hist.fact-order
     3930       .
     3931       run factord-to-date in this-procedure (
     3932                                               input v-old-fact-order
     3933                                              ,output v-old-fact-date) no-error .
     3934       assign
     3935       v-chg-fields = "rate-code,fact-date"
     3936       .
     3937       find first buf_next_tax-rate-gds no-lock where
     3938               buf_next_tax-rate-gds.gds-code = p-gds-code
     3939           AND buf_next_tax-rate-gds.host-code        = 0
     3940           AND buf_next_tax-rate-gds.obj-type         = "":U
     3941           AND buf_next_tax-rate-gds.obj-code         = 0
     3942           AND buf_next_tax-rate-gds.tax-code         = buf_c-gds-hist.tax-code
     3943           AND buf_next_tax-rate-gds.fact-order       > buf_c-gds-hist.fact-order no-error .
     3944       if available buf_next_tax-rate-gds then do:
     3945         assign
     3946         v-new-rate-code = buf_next_tax-rate-gds.rate-code
     3947         v-new-fact-order = buf_next_tax-rate-gds.fact-order
     3948         .
     3949         run factord-to-date in this-procedure (
     3950                                                 input v-new-fact-order
     3951                                               ,output v-new-fact-date) no-error .
     3952       end.
     3953     _ii:
     3954     do ii = 1 to num-entries(v-chg-fields):
     3955       assign
     3956       v-field-name = entry(ii, v-chg-fields)
     3957       jj = lookup(v-field-name, "rate-code,fact-date").
     3958       if jj = 0 then next _ii.
     3959       assign
     3960       v-field-label = entry(jj, "Код ставки,Начало действия")
     3961       .
     3962       create temp-changes.
     3963       assign
     3964       temp-changes.f_name = v-field-name
     3965       temp-changes.l_name = v-field-label
     3966       temp-changes.v_old = (if temp-changes.f_name = "rate-code"
     3967                             then string(v-old-rate-code)
     3968                             else string(v-old-fact-date, "99/99/9999")
     3969                             )
     3970       temp-changes.v_new = (if temp-changes.f_name = "rate-code"
     3971                             then string(v-new-rate-code)
     3972                             else string(v-new-fact-date, "99/99/9999")
     3973                             )
     3974       .
     3975     end.
     3976   end.
     3977   end procedure.
