     3672   :
     3673       find first current_c-s-coeff no-lock where
     3674                  current_c-s-coeff.gds-code = p-gds-code
     3675              AND current_c-s-coeff.chip-num = p-chip-num
     3676              no-error .
     3677       if not avail current_c-s-coeff then do:
     3678         v-mess = "Неверная ссылка на c-s-coeff в таблице c-gds-hist".
     3679         run err-mess in this-procedure ( input-output v-mess).
     3680         return error v-mess.
     3681       end.
     3682       assign
     3683       p-description = "Начало действия" + chr(32) +
     3684                       entry(1, string(current_c-s-coeff.s-date, "99/99/9999":U), chr(47)) + chr(47) +
     3685                       entry(2, string(current_c-s-coeff.s-date, "99/99/9999":U), chr(47))
     3686       .
     3687   define variable v-label-param as character no-undo .
