     1504   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1505   def var vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1506   define temp-table temp-drt-prop no-undo like ub.drt-prop.
     1507   procedure disrules-fill-properties:
     1508   define input  parameter p-templ-rl-root as integer   no-undo .
     1509   define buffer buf_drt-prop for ub.drt-prop.
     1510   define buffer buf_temp-drt-prop for temp-drt-prop.
     1511   do
     1512   on error undo, return error return-value
     1513   :
     1514     for each buf_temp-drt-prop:
     1515       delete buf_temp-drt-prop.
     1516     end.
     1517     for each buf_drt-prop where buf_drt-prop.templ-rl-root = p-templ-rl-root:
     1518       create buf_temp-drt-prop.
     1519       buffer-copy buf_drt-prop to buf_temp-drt-prop.
     1520     end.
     1521   end.
     1522   end procedure.
     1523   ~
     1524   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1525   procedure discfgru-check :
     1526   define input parameter p-table-name as character no-undo .
     1527   define input parameter p-templ-rl-root as integer no-undo .
     1528   define input parameter p-time-templ-rl-root as integer no-undo .
     1529   define input parameter p-pos-type as character no-undo .
     1530   define output parameter p-disnct-role as character no-undo .
     1531   define buffer buf_dis-cfg-rule for ub.dis-cfg-rule.
     1532     do
     1533     on error undo, return error return-value
     1534     :
     1535       find first buf_dis-cfg-rule no-lock where
     1536               buf_dis-cfg-rule.table-name = p-table-name
     1537           and buf_dis-cfg-rule.templ-rl-root = p-templ-rl-root
     1538           and (p-time-templ-rl-root = ? or  buf_dis-cfg-rule.time-templ-rl-root = p-time-templ-rl-root)
     1539           and buf_dis-cfg-rule.pos-type = p-pos-type no-error.
     1540       if not available buf_dis-cfg-rule
     1541       or p-pos-type = "":U
     1542       then do:
     1543          return error substitute("Для места использования типа &1 не определен тип скидки с шаблоном &2 &3"
     1544                                  ,entry (lookup (p-pos-type, 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,r-keeper,InfoKiosk,pricecheck-Servis+,Emulator-NKT-IBM,MARIA,-,bo,Autotank':U), 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,R-KEEPER,InfoKiosk,Прайс-чекер Servis+,Emulator-NKT-IBM,MARIA,Накладная,Бэкофис,Autotank':U)
     1545                                  , p-templ-rl-root
     1546                                  , (if p-time-templ-rl-root = ?
     1547                                     then '':U
     1548                                     else substitute("с расписанием типа &1", p-time-templ-rl-root)
     1549                                     )
     1550                                  ).
     1551       end.
     1552       assign
     1553       p-disnct-role = buf_dis-cfg-rule.discnt-role
     1554       .
     1555     end.
     1556   end procedure.
     1557   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1558   FUNCTION get-region RETURNS CHARACTER
     1559     ( input parhost-code as integer, input parobj-type as character, input parobj-code as integer ) :
     1560     define variable par-region as character no-undo.
     1561     if parhost-code = 0 and
     1562          parobj-type = "":U and
     1563          parobj-code = 0 then do:
     1564          par-region = "Глобально".
     1565          return par-region.
     1566       end.
     1567       if parobj-type = 'орг':U then do:
     1568          par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(parhost-code).
     1569          return par-region.
     1570       end.
     1571       if parobj-type = 'регион':U
     1572       then do:
     1573          par-region = fill(chr(32), 2) + "Регион" + chr(32) + string(parobj-code).
     1574          return par-region.
     1575       end.
     1576       par-region = fill(chr(32), 4) + parobj-type + chr(32) + string(parobj-code).
     1577       return par-region.
     1578   END FUNCTION.
     1579   FUNCTION get-objregion RETURNS CHARACTER
     1580     (  input parobj-type as character, input parobj-code as integer ) :
     1581     define variable par-region as character no-undo.
     1582     if  parobj-type = "":U and
     1583         parobj-code = 0
     1584     then do:
     1585        par-region = "Глобально".
     1586     end.
     1587     else if parobj-type = 'орг':U
     1588     then do:
     1589        par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(parobj-code).
     1590     end.
     1591     else if parobj-type = 'регион':U
     1592     then do:
     1593        par-region = fill(chr(32), 2) + "Регион" + chr(32) + string(parobj-code).
     1594     end.
     1595     else
     1596        par-region = fill(chr(32), 4) + parobj-type + chr(32) + string(parobj-code).
     1597     return par-region.
     1598   END FUNCTION.
     1599   procedure disgdsru-name :
     1600   define buffer buf_dis-rule for ub.dis-rule.
     1601   do
     1602     on error undo, return error
     1603     :
     1604     define input  parameter p-templ-rl-root  as integer no-undo .
     1605     define output parameter p-label          as character no-undo .
     1606     find first buf_dis-rule no-lock where
     1607               buf_dis-rule.rule-num = p-templ-rl-root no-error.
     1608     if available buf_dis-rule
     1609     then do:
     1610       if buf_dis-rule.rule-num > 0 then
     1611       p-label = buf_dis-rule.des.
     1612     end.
     1613     else do:
     1614       p-label = substitute("Неизвестный тип правила скидки &1", p-templ-rl-root).
     1615     end.
     1616   end.
     1617   end procedure.
     1618   function disgdsru-get-disc-label returns character ( input p-templ-rl-root as integer):
     1619   define variable v-rule-label as character no-undo .
     1620   run disgdsru-name in this-procedure ( input p-templ-rl-root
     1621                                        ,output v-rule-label) no-error.
     1622   return v-rule-label.
     1623   end function.
     1624   function disgdsru-get-disc-role-label returns character ( input p-discnt-role as character):
     1625   define variable v-rule-label as character no-undo .
     1626   return entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u).
     1627   end function.
     1628   procedure disgdsru-write :
     1629     do
     1630     on error undo, return error
     1631     :
     1632       define input parameter p-obj-type       like ub.dis-gds-rule.obj-type   no-undo .
     1633       define input parameter p-obj-code       like ub.dis-gds-rule.obj-code   no-undo .
