     4113                   ,output v-tooltip
     4114                   ,output v-label
     4115                   ) no-error .
     4116       assign
     4117       p-description = "Атрибут" + chr(32) + v-label
     4118       .
     4119   define variable v-label-param as character no-undo .
     4120   v-label-param =
     4121     "attr-code" + chr(4) + "Атрибут" + chr(4) + "" + chr(8)
     4122    + "attr-value" + chr(4) + "Значение атрибута" + chr(4) + ""  .
     4123    run proc-full-temp-changes in this-procedure (
     4124                                                input  (buf_c-gds-hist.action = integer('1':U))
     4125                                               ,input  (buf_c-gds-hist.action = integer('99':U))
     4126                                               ,input  buffer current_c-pl-gds-attr:handle
     4127                                               ,input  'pl-gds-attr':U
     4128                                               ,input  "attr-code,attr-value"
