     1643       define buffer lock_dis-gds-rule for ub.dis-gds-rule .
     1644       define variable v-label          as character no-undo .
     1645       define variable v-discnt-role as character no-undo .
     1646       run discfgru-check in this-procedure (
     1647                                             input 'dis-gds-rule':U
     1648                                            ,input p-templ-rl-root
     1649                                            ,input p-time-templ-rl-root
     1650                                            ,input p-pos-type
     1651                                            ,output v-discnt-role
     1652                                             ) no-error .
     1653       if error-status :error then do:
     1654         undo, return error return-value .
     1655       end.
     1656       if p-discnt-role = ? then do:
     1657         p-discnt-role = v-discnt-role.
     1658       end.
     1659       if p-discnt-role <> v-discnt-role then do:
     1660         undo, return error substitute("Товар &1 &2&3 место использ. &4 скидка типа &5&6не может быть по шаблону &7 и расписанию &8"
     1661                                 ,p-gds-code
     1662                                 ,p-obj-type
     1663                                 ,p-obj-code
     1664                                 ,p-pos-type
     1665                                 ,entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u)
     1666                                 ,chr(10)
     1667                                 ,p-templ-rl-root
     1668                                 ,p-rule-num).
     1669       end.
     1670       if p-pos-type = ? then do:
     1671   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1672   define variable v-param-type9 as character no-undo .
     1673   define variable v-value-date9 as date no-undo .
     1674   define variable v-value-decimal9 as decimal no-undo .
     1675   define variable v-value-integer9 as INTEGER no-undo .
     1676   define variable v-value-logical9 AS LOGICAL no-undo .
     1677   define variable v-tth9 as handle no-undo .
     1678   run adm/shattri.p (
     1679       input "get":U
     1680       ,input  p-obj-type
     1681       ,input  p-obj-code
     1682       ,input  'cd-sending':U
     1683       ,input  'dflt-cd':U
     1684       ,output p-pos-type
     1685       ,output v-value-date9
     1686       ,output v-value-decimal9
     1687       ,output v-value-integer9
     1688       ,output v-value-logical9
     1689       ,output v-param-type9
     1690       ,INPUT-OUTPUT table-handle v-tth9
     1691       )  .
     1692   delete object v-tth9 no-error.
     1693       end.
     1694       find first buf_dis-rule no-lock where
     1695                 buf_dis-rule.rule-num = p-rule-num no-error.
     1696       if not available buf_Dis-rule then do:
     1697         undo, return error substitute("Товар &1 &2&3 место использ. &4 скидка типа &5&6не найдено правило скидки &7"
     1698                                 ,p-gds-code
     1699                                 ,p-obj-type
     1700                                 ,p-obj-code
     1701                                 ,p-pos-type
     1702                                 ,entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u)
     1703                                 ,chr(10)
     1704                                 ,p-rule-num).
     1705       end.
     1706       if buf_dis-rule.root <> yes then do:
     1707         undo, return error substitute("Товар &1 &2&3 место использ. &4 скидка типа &5&6правило скидки &7 - некорневое"
     1708                                 ,p-gds-code
     1709                                 ,p-obj-type
     1710                                 ,p-obj-code
     1711                                 ,p-pos-type
     1712                                 ,entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u)
     1713                                 ,chr(10)
     1714                                 ,p-rule-num).
     1715       end.
     1716       if not (p-obj-type = buf_dis-rule.obj-type
     1717           and p-obj-code = buf_dis-rule.obj-code)
     1718       and not ( (p-obj-type = 'маг':U or p-obj-type = 'скл':U )
     1719                and
     1720                (buf_dis-rule.obj-type = 'орг':U or buf_dis-rule.obj-type = ""))
     1721        then do:
     1722         undo, return error (substitute("Товар &1 &2&3 место использ. &4 скидка типа &5&6"
     1723                                 ,p-gds-code
     1724                                 ,p-obj-type
     1725                                 ,p-obj-code
     1726                                 ,p-pos-type
     1727                                 ,entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u)
     1728                                 ,chr(10)
     1729                                 ) +
     1730                             substitute("Правило скидки &1 определено для &2&3" +
     1731                                        "а привязка к товару для &4"
     1732                                        ,buf_dis-rule.rule-num
     1733                                        ,get-objregion( buf_dis-rule.obj-type, buf_Dis-rule.obj-code)
     1734                                        ,chr(10)
     1735                                        ,get-objregion( p-obj-type, p-obj-code)
     1736                                        ))
     1737                                 .
     1738       end.
     1739       find first buf_dis-gds-rule exclusive-lock where
     1740                  buf_dis-gds-rule.gds-code  = p-gds-code
     1741              AND buf_dis-gds-rule.obj-type  = buf_dis-rule.obj-type
     1742              AND buf_dis-gds-rule.obj-code  = buf_dis-rule.obj-code
     1743              AND buf_dis-gds-rule.pos-type  = p-pos-type
     1744              AND buf_dis-gds-rule.discnt-role = p-discnt-role
     1745              and buf_dis-gds-rule.nonunique = p-nonunique
     1746              no-error .
     1747       if not available buf_dis-gds-rule then do:
     1748         find first buf_dis-gds-rule exclusive-lock where
     1749                   buf_dis-gds-rule.gds-code  = p-gds-code
     1750               AND buf_dis-gds-rule.obj-type  = buf_dis-rule.obj-type
     1751               AND buf_dis-gds-rule.obj-code  = buf_dis-rule.obj-code
     1752               AND buf_dis-gds-rule.pos-type  = p-pos-type
     1753               AND buf_dis-gds-rule.discnt-role = p-discnt-role
     1754               no-error .
     1755         if available buf_Dis-gds-rule then do:
     1756           if p-nonunique = ''
     1757           and available buf_dis-gds-rule
     1758           then do:
     1759             return error substitute("Скидка типа &1 на товар с кодом &2 &3&4 уже существует (детализ. &3)"
     1760                                      , entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u)
     1761                                      , p-gds-code
     1762                                      , buf_Dis-rule.obj-type
     1763                                      , buf_Dis-rule.obj-code
     1764                                      , p-nonunique
     1765                                     ).
     1766           end.
     1767           if available buf_dis-gds-rule
     1768           and buf_dis-gds-rule.nonunique = ''
     1769           and p-nonunique <> ''then do:
     1770             return error substitute("Скидка типа &1 на товар с кодом &2 &3&4 уже существует"
     1771                                      , entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u)
     1772                                      , p-gds-code
     1773                                      , buf_Dis-rule.obj-type
     1774                                      , buf_Dis-rule.obj-code
     1775                                     ).
     1776           end.
     1777         end.
     1778         create buf_dis-gds-rule .
     1779         assign
     1780         buf_dis-gds-rule.gds-code  = p-gds-code
     1781         buf_dis-gds-rule.obj-type  = buf_dis-rule.obj-type
     1782         buf_dis-gds-rule.obj-code  = buf_dis-rule.obj-code
     1783         buf_dis-gds-rule.pos-type = p-pos-type
     1784         buf_dis-gds-rule.discnt-role = v-discnt-role
     1785         buf_dis-gds-rule.rule-num = p-rule-num
     1786         buf_dis-gds-rule.nonunique = p-nonunique
     1787         no-error
     1788         .
     1789       end.
     1790       ASSIGN
     1791       buf_dis-gds-rule.rule-num = p-rule-num
     1792       buf_dis-gds-rule.rl-root = buf_Dis-rule.rl-root
     1793       buf_dis-gds-rule.time-templ-rl-root = p-time-templ-rl-root
     1794       buf_dis-gds-rule.templ-rl-root = p-templ-rl-root
     1795       buf_dis-gds-rule.nonunique = p-nonunique
     1796       no-error.
     1797     end.
     1798   end procedure.
     1799   PROCEDURE cmp-disgdsru-write :
     1800   do
     1801   on error undo, return error
     1802   :
     1803     define input parameter p-gds-code like ub.dis-gds-rule.gds-code   no-undo .
     1804     define input parameter p-obj-type like ub.dis-gds-rule.obj-type   no-undo .
     1805     define input parameter p-obj-code like ub.dis-gds-rule.obj-code   no-undo .
     1806     define input parameter p-pos-type like ub.dis-gds-rule.pos-type   no-undo .
     1807     define input parameter p-templ-rl-root     like ub.dis-gds-rule.templ-rl-root  no-undo .
     1808     define input parameter p-time-templ-rl-root     like ub.dis-gds-rule.time-templ-rl-root  no-undo .
     1809     define input parameter p-discnt-role like ub.dis-gds-rule.discnt-role no-undo .
     1810     define input parameter p-rule-num    like ub.dis-gds-rule.rule-num no-undo .
     1811     define input parameter p-nonunique like ub.dis-gds-rule.nonunique no-undo .
     1812     define variable v-rule-label          as character no-undo .
     1813     define buffer buf_tt0-dis-gds-rule for ub.dis-gds-rule .
     1814     define buffer buf_dis-rule     for ub.dis-rule.
     1815     run disgdsru-name in this-procedure (
     1816                                         input  p-templ-rl-root
     1817                                         ,output v-rule-label
     1818                                         ) no-error .
     1819     if error-status :error then do:
     1820       undo, return error return-value .
     1821     end.
     1822     find first buf_tt0-dis-gds-rule exclusive-lock where
     1823                 buf_tt0-dis-gds-rule.gds-code  = p-gds-code
     1824             AND buf_tt0-dis-gds-rule.obj-type  = p-obj-type
     1825             AND buf_tt0-dis-gds-rule.obj-code  = p-obj-code
     1826             AND buf_tt0-dis-gds-rule.pos-type  = p-pos-type
     1827             AND buf_tt0-dis-gds-rule.discnt-role = p-discnt-role
     1828             AND buf_tt0-dis-gds-rule.nonunique = p-nonunique
     1829             no-error .
     1830     if not available buf_tt0-dis-gds-rule then do:
     1831       create buf_tt0-dis-gds-rule .
     1832       assign
     1833       buf_tt0-dis-gds-rule.gds-code  = p-gds-code
     1834       buf_tt0-dis-gds-rule.obj-type  = p-obj-type
     1835       buf_tt0-dis-gds-rule.obj-code  = p-obj-code
     1836       buf_tt0-dis-gds-rule.pos-type  = p-pos-type
     1837       buf_tt0-dis-gds-rule.nonunique = p-nonunique
     1838       buf_tt0-dis-gds-rule.discnt-role = p-discnt-role
     1839       no-error
     1840       .
     1841     end.
     1842     find first buf_dis-rule no-lock where
     1843               buf_dis-rule.rule-num = p-rule-num.
     1844     ASSIGN
     1845     buf_tt0-dis-gds-rule.templ-rl-root = p-templ-rl-root
     1846     buf_tt0-dis-gds-rule.rule-num = p-rule-num
     1847     buf_tt0-dis-gds-rule.time-templ-rl-root = p-time-templ-rl-root
     1848     buf_tt0-dis-gds-rule.nonunique = p-nonunique
     1849     buf_tt0-dis-gds-rule.templ-rl-root = p-templ-rl-root
     1850     buf_tt0-dis-gds-rule.rl-root = buf_Dis-rule.rl-root
     1851     no-error.
     1852     release buf_tt0-dis-gds-rule no-error .
     1853     if error-status:error then do:
     1854       undo, return error return-value .
     1855     end.
     1856   end.
     1857   END PROCEDURE.
     1858   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1859   procedure plgdattr-name :
     1860   do
     1861     on error undo, return error
     1862     :
     1863     define input  parameter p-code           as character no-undo .
     1864     define output parameter p-type           as character no-undo .
     1865     define output parameter p-format         as character no-undo .
     1866     define output parameter p-label          as character no-undo .
     1867     define output parameter p-user-can-edit  as logical   no-undo .
     1868     define output parameter p-output-display as logical   no-undo .
     1869     define output parameter p-other          as character no-undo .
     1870       case p-code :
     1871         otherwise do:
     1872           undo, return error substitute("Неизвестный атрибут товара на складском месте &1",  p-code ).
     1873         end.
     1874       end.
     1875     end.
     1876   end procedure.
     1877   procedure plgdattr-tooltip :
     1878   do
     1879     on error undo, return error
     1880     :
     1881       define input  parameter p-code    as character no-undo .
     1882       define output parameter p-tooltip as character no-undo .
     1883       define output parameter p-label   as character no-undo .
     1884       case p-code :
     1885         otherwise do:
     1886           undo, return error substitute("Неизвестный атрибут товара складском месте &1" , p-code ).
     1887         end.
     1888       end.
     1889     end.
     1890   end procedure.
     1891   procedure plgdattr-value :
     1892    do
     1893     on error undo, return error
     1894     :
     1895       define input  parameter p-code     like ub.pl-gds-attr.attr-code  no-undo .
     1896       define input  parameter p-obj-type like ub.pl-gds-attr.obj-type   no-undo .
     1897       define input  parameter p-obj-code like ub.pl-gds-attr.obj-code   no-undo .
     1898       define input  parameter p-pl-code  like ub.pl-gds-attr.pl-code    no-undo .
     1899       define input  parameter p-gds-code like ub.pl-gds-attr.gds-code   no-undo .
     1900       define output parameter p-value    like ub.pl-gds-attr.attr-value no-undo .
     1901       define output parameter p-type     as character no-undo .
     1902       define buffer buf_pl-gds-attr for ub.pl-gds-attr .
     1903       def var v-format         as character no-undo .
     1904       def var v-label          as character no-undo .
     1905       def var v-user-can-edit  as logical   no-undo .
     1906       def var v-output-display as logical   no-undo .
     1907       def var v-other          as character no-undo .
     1908       run plgdattr-name in this-procedure
     1909         (input  p-code
     1910         ,output p-type
     1911         ,output v-format
     1912         ,output v-label
     1913         ,output v-user-can-edit
     1914         ,output v-output-display
     1915         ,output v-other
     1916         ) no-error .
     1917       if error-status :error then do:
     1918         undo, return error return-value .
     1919       end.
     1920       find first buf_pl-gds-attr no-lock where
     1921                  buf_pl-gds-attr.obj-type  = p-obj-type
     1922              AND buf_pl-gds-attr.obj-code  = p-obj-code
     1923              AND buf_pl-gds-attr.pl-code  = p-pl-code
     1924              AND buf_pl-gds-attr.gds-code  = p-gds-code
     1925              AND buf_pl-gds-attr.attr-code = p-code
     1926         no-error .
     1927       if avail buf_pl-gds-attr then do:
     1928         assign
     1929           p-value =  buf_pl-gds-attr.attr-value
     1930         .
     1931       end.
     1932       else do:
     1933         assign
     1934           p-value = if p-type = 'L':U then "no":U else ""
     1935         .
     1936       end.
     1937     end.
     1938   end procedure.
     1939   procedure plgdattr-write :
     1940     do
     1941     on error undo, return error
     1942     :
     1943       define input parameter p-obj-type like ub.pl-gds-attr.obj-type   no-undo .
     1944       define input parameter p-obj-code like ub.pl-gds-attr.obj-code   no-undo .
     1945       define input parameter p-pl-code  like ub.pl-gds-attr.pl-code    no-undo .
     1946       define input parameter p-gds-code like ub.pl-gds-attr.gds-code   no-undo .
     1947       define input parameter p-code     like ub.pl-gds-attr.attr-code  no-undo .
     1948       define input parameter p-value    like ub.pl-gds-attr.attr-value no-undo .
     1949       define buffer buf_pl-gds-attr for ub.pl-gds-attr .
     1950       define buffer lock_pl-gds-attr for ub.pl-gds-attr .
     1951       def var v-type           as character no-undo .
     1952       def var v-format         as character no-undo .
     1953       def var v-label          as character no-undo .
     1954       def var v-user-can-edit  as logical   no-undo .
     1955       def var v-output-display as logical   no-undo .
     1956       def var v-other          as character no-undo .
     1957       run plgdattr-name in this-procedure
     1958         (input  p-code
     1959         ,output v-type
     1960         ,output v-format
     1961         ,output v-label
     1962         ,output v-user-can-edit
     1963         ,output v-output-display
     1964         ,output v-other
     1965         ) no-error .
     1966       if error-status :error then do:
     1967         undo, return error return-value .
     1968       end.
     1969       find first buf_pl-gds-attr exclusive-lock where
     1970                  buf_pl-gds-attr.obj-type  = p-obj-type
     1971              AND buf_pl-gds-attr.obj-code  = p-obj-code
     1972              AND buf_pl-gds-attr.pl-code  = p-pl-code
     1973              AND buf_pl-gds-attr.gds-code  = p-gds-code
     1974              AND buf_pl-gds-attr.attr-code = p-code no-error .
     1975       if not available buf_pl-gds-attr then do:
     1976         create buf_pl-gds-attr .
     1977         assign
     1978         buf_pl-gds-attr.obj-type  = p-obj-type
     1979         buf_pl-gds-attr.obj-code  = p-obj-code
     1980         buf_pl-gds-attr.pl-code  = p-pl-code
     1981         buf_pl-gds-attr.gds-code  = p-gds-code
     1982         buf_pl-gds-attr.attr-code = p-code
     1983         buf_pl-gds-attr.attr-value = p-value no-error
     1984         .
     1985       end.
     1986       ELSE
     1987       ASSIGN
     1988       buf_pl-gds-attr.attr-value = p-value no-error.
     1989     end.
     1990   end procedure.
     1991   procedure plgdattr-exist :
     1992     do
     1993     on error undo, return error
     1994     :
     1995       define input parameter p-obj-type like ub.pl-gds-attr.obj-type   no-undo .
     1996       define input parameter p-obj-code like ub.pl-gds-attr.obj-code   no-undo .
     1997       define input parameter p-pl-code  like ub.pl-gds-attr.pl-code    no-undo .
     1998       define input parameter p-gds-code like ub.pl-gds-attr.gds-code   no-undo .
     1999       define input parameter p-code     like ub.pl-gds-attr.attr-code  no-undo .
     2000       define output parameter p-exist    as logical no-undo .
     2001       define buffer buf_pl-gds-attr for ub.pl-gds-attr .
     2002       def var v-type           as character no-undo .
     2003       def var v-format         as character no-undo .
     2004       def var v-label          as character no-undo .
     2005       def var v-user-can-edit  as logical   no-undo .
     2006       def var v-output-display as logical   no-undo .
     2007       def var v-other          as character no-undo .
     2008       run plgdattr-name in this-procedure
     2009         (input  p-code
     2010         ,output v-type
     2011         ,output v-format
     2012         ,output v-label
     2013         ,output v-user-can-edit
     2014         ,output v-output-display
     2015         ,output v-other
     2016         ) no-error .
     2017       if error-status :error then do:
     2018         undo, return error return-value .
     2019       end.
     2020       find first buf_pl-gds-attr no-lock where
     2021                  buf_pl-gds-attr.obj-type  = p-obj-type
     2022              AND buf_pl-gds-attr.obj-code  = p-obj-code
     2023              AND buf_pl-gds-attr.pl-code  = p-pl-code
     2024              AND buf_pl-gds-attr.gds-code  = p-gds-code
     2025              AND buf_pl-gds-attr.attr-code = p-code no-error .
     2026       if available buf_pl-gds-attr then do:
     2027         P-EXIST = YES.
     2028       end.
     2029     end.
     2030   end procedure.
     2031   procedure plgdattr-delete :
     2032     do
     2033     on error undo, return error
     2034     :
     2035       define input parameter p-obj-type like ub.pl-gds-attr.obj-type   no-undo .
     2036       define input parameter p-obj-code like ub.pl-gds-attr.obj-code   no-undo .
     2037       define input parameter p-pl-code  like ub.pl-gds-attr.pl-code    no-undo .
     2038       define input parameter p-gds-code like ub.pl-gds-attr.gds-code   no-undo .
     2039       define input parameter p-code     like ub.pl-gds-attr.attr-code  no-undo .
     2040       define output parameter p-deleted  as logical no-undo .
     2041       define buffer buf_pl-gds-attr for ub.pl-gds-attr .
     2042       def var v-type           as character no-undo .
     2043       def var v-format         as character no-undo .
     2044       def var v-label          as character no-undo .
     2045       def var v-user-can-edit  as logical   no-undo .
     2046       def var v-output-display as logical   no-undo .
     2047       def var v-other          as character no-undo .
     2048       run plgdattr-name in this-procedure
     2049         (input  p-code
     2050         ,output v-type
     2051         ,output v-format
     2052         ,output v-label
     2053         ,output v-user-can-edit
     2054         ,output v-output-display
     2055         ,output v-other
     2056         ) no-error .
     2057       if error-status :error then do:
     2058         undo, return error return-value .
     2059       end.
     2060       find first buf_pl-gds-attr exclusive-lock where
     2061                  buf_pl-gds-attr.obj-type  = p-obj-type
     2062              AND buf_pl-gds-attr.obj-code  = p-obj-code
     2063              AND buf_pl-gds-attr.gds-code  = p-gds-code
     2064              AND buf_pl-gds-attr.pl-code  = p-pl-code
     2065              AND buf_pl-gds-attr.attr-code = p-code no-error .
     2066       if not available buf_pl-gds-attr then do:
     2067         P-DELETED = NO.
     2068       end.
     2069       ELSE DO:
     2070          delete buf_pl-gds-attr.
     2071          P-DELETED = YES.
     2072       END.
     2073     end.
     2074   end procedure.
     2075   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2076   procedure factord :
     2077     define input  parameter p-fact-date            as date    no-undo .
     2078     define input  parameter p-fact-time            as integer no-undo .
     2079     define input  parameter p-fact-num             as integer no-undo .
     2080     define input  parameter p-shift-date           as date    no-undo .
     2081     define input  parameter p-shift-num            as integer no-undo .
     2082     define input  parameter p-shift-on             as logical no-undo .
     2083     define output parameter p-fact-order           as decimal no-undo .
     2084     define output parameter p-shift-end-fact-order as decimal no-undo .
     2085     define output parameter p-day-end-fact-order   as decimal no-undo .
     2086     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
     2087     if p-fact-date = ?
     2088     then do:
     2089       return error "Не указана фактическая дата" .
     2090     end.
     2091     define variable v-fact-date-num as integer no-undo .
     2092     assign
     2093       v-fact-date-num = integer(p-fact-date)
     2094     .
     2095     if p-fact-num = ?
     2096     or p-fact-num = 0
     2097     then do:
     2098       return error "Не задан p-fact-num " + string(p-fact-num) .
     2099     end.
     2100     if p-fact-num < 0
     2101     then do:
     2102       return error "Отрицательный fact-num " + string(p-fact-num) .
     2103     end.
     2104     if p-fact-num >= 100000000
     2105     then do:
     2106       return error "Недопустимо большой fact-num " + string(p-fact-num) .
     2107     end.
     2108     if p-shift-on = true
     2109     then do:
     2110       if p-shift-date = ?
     2111       then do:
     2112         return error "Не задана дата смены" .
     2113       end.
     2114       if p-shift-num = ?
     2115       or p-shift-num = 0
     2116       then do:
     2117         return error "Не задан номер смены" .
     2118       end.
     2119     end.
     2120     else do:
     2121       assign
     2122         p-shift-date = p-fact-date
     2123         p-shift-num  = 24
     2124       .
     2125     end.
     2126     define variable v-shift-offset as integer no-undo .
     2127     if p-shift-date = p-fact-date
     2128     then do:
     2129       assign
     2130         v-shift-offset = 1
     2131       .
     2132     end.
     2133     if p-shift-date < p-fact-date
     2134     then do:
     2135       assign
     2136         v-shift-offset = 0
     2137       .
     2138     end.
     2139     if p-shift-date > p-fact-date
     2140     then do:
     2141       message
     2142         vss-workfile vss-revision vss-description skip
     2143         "Неправильная дата закрытия смены" skip
     2144         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
     2145         view-as alert-box error .
     2146       undo, return error
     2147         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
     2148           ,string(p-fact-date, '99/99/9999':U)
     2149           ,string(p-shift-date, '99/99/9999':U)
     2150           )
     2151       .
     2152     end.
     2153     if p-shift-num < 1
     2154     or p-shift-num > 24
     2155     then do:
     2156       message
     2157         vss-workfile vss-revision vss-description skip
     2158         "Неправильный номер смены" skip
     2159         "p-shift-num" p-shift-num skip
     2160         view-as alert-box error .
     2161       undo, return error return-value .
     2162     end.
     2163     assign
     2164       p-fact-order           = v-fact-date-num
     2165                              + v-shift-offset * 0.5
     2166                              + p-shift-num    * 0.02 - 0.01
     2167                              + p-fact-num     * 0.0000000001
     2168       p-shift-end-fact-order = v-fact-date-num
     2169                              + v-shift-offset * 0.5
     2170                              + p-shift-num    * 0.02
     2171       p-day-end-fact-order   = v-fact-date-num
     2172                              + 0.99
     2173     .
     2174     if p-fact-order           <= v-fact-date-num
     2175     or p-shift-end-fact-order <= v-fact-date-num
     2176     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
     2177     or p-shift-end-fact-order >= p-day-end-fact-order
     2178     then do:
     2179       message
     2180         vss-workfile vss-revision vss-description skip
     2181         "Внутренняя ошибка при генерации фактического номера" skip
     2182         "p-fact-date"            p-fact-date            skip
     2183         "p-fact-time"            p-fact-time            skip
     2184         "p-fact-num"             p-fact-num             skip
     2185         "p-shift-date"           p-shift-date           skip
     2186         "p-shift-num"            p-shift-num            skip
     2187         "p-shift-on"             p-shift-on             skip
     2188         "p-shift-end-fact-order" p-shift-end-fact-order skip
     2189         "p-day-end-fact-order"   p-day-end-fact-order   skip
     2190         "v-fact-date-num"        v-fact-date-num        skip
     2191         view-as alert-box error .
     2192       undo, return error return-value .
     2193     end.
     2194   end procedure.
     2195   procedure day-begin-fact-order :
     2196     define input  parameter p-fact-date            as date    no-undo .
     2197     define output parameter p-day-begin-fact-order as decimal no-undo .
     2198     do
     2199     on error undo, return error return-value
     2200     :
     2201       if p-fact-date = ?
     2202       then do:
     2203         assign
     2204           p-day-begin-fact-order = 0
     2205         .
     2206       end.
     2207       else do:
     2208         assign
     2209           p-day-begin-fact-order = integer(p-fact-date)
     2210         .
     2211       end.
     2212     end.
     2213   end procedure.
     2214   procedure factord-max-fact-order :
     2215     define output parameter p-max-fact-order as decimal   no-undo .
     2216     do
     2217     on error undo, return error return-value
     2218     :
     2219       run day-begin-fact-order in this-procedure
     2220         (input  date(1, 1, 5000)
     2221         ,output p-max-fact-order
     2222         ) .
     2223     end.
     2224   end procedure.
     2225   procedure factord-cut-archive :
     2226     define input  parameter p-obj-type             as character no-undo .
     2227     define input  parameter p-obj-code             as integer   no-undo .
     2228     define input  parameter p-fact-date            as date      no-undo .
     2229     define output parameter p-shift-on             as logical   no-undo .
     2230     define output parameter p-shift-date           as date      no-undo .
     2231     define output parameter p-shift-num            as integer   no-undo .
     2232     define output parameter p-day-end-fact-order   as decimal   no-undo .
     2233     define output parameter p-shift-end-fact-order as decimal   no-undo .
     2234     define variable v-fact-order as decimal   no-undo .
     2235     define buffer buf_shift-obj for ub.shift-obj .
     2236     do
     2237     on error undo, return error return-value
     2238     :
     2239   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2240   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     2241     (input  p-obj-type
     2242     ,input  p-obj-code
     2243     ,input  'shift-on=request'
     2244     ,output p-shift-on
     2245     ) no-error .
     2246       if error-status :error
     2247       then do:
     2248         message
     2249           vss-workfile vss-revision vss-description skip
     2250           "Ошибка при определении атрибута объекта" skip
     2251           "Объект" p-obj-type p-obj-code skip
     2252           error-status :get-message(1) skip
     2253           return-value skip
     2254           view-as alert-box error .
     2255         undo, return error return-value .
     2256       end.
     2257       if p-shift-on = false
     2258       then do:
     2259         assign
     2260           p-shift-date               = ?
     2261           p-shift-num                = 0
     2262         .
     2263       end.
     2264       else do:
     2265         find first buf_shift-obj share-lock
     2266           where buf_shift-obj.obj-type   = p-obj-type
     2267             and buf_shift-obj.obj-code   = p-obj-code
     2268             and buf_shift-obj.shift-date > p-fact-date
     2269           use-index pi
     2270           no-error .
     2271         if not available buf_shift-obj
     2272         or buf_shift-obj.status_ <> 'зкр':U
     2273         then do:
     2274           message
     2275             vss-workfile vss-revision vss-description skip
     2276             "Невозможно вычислить последнюю смену" skip
     2277             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
     2278             "Объект" p-obj-type p-obj-code skip
     2279             "Дата" p-fact-date skip
     2280             view-as alert-box error .
     2281           undo, return error return-value .
     2282         end.
     2283         find last buf_shift-obj share-lock
     2284           where buf_shift-obj.obj-type = p-obj-type
     2285             and buf_shift-obj.obj-code = p-obj-code
     2286             and buf_shift-obj.shift-date <= p-fact-date
     2287           use-index pi
     2288           no-error .
     2289         if available buf_shift-obj
     2290         then do:
     2291           if  buf_shift-obj.status_ = 'зкр':U
     2292           then do:
     2293             assign
     2294               p-shift-date = buf_shift-obj.shift-date
     2295               p-shift-num  = buf_shift-obj.shift-num
     2296             .
     2297           end.
     2298           else do:
     2299             message
     2300               vss-workfile vss-revision vss-description skip
     2301               "Невозможно вычислить последнюю смену" skip
     2302               "Статус смены отличен от статуса" 'зкр':U skip
     2303               "Объект" p-obj-type p-obj-code skip
     2304               "Дата" p-fact-date skip
     2305               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
     2306               view-as alert-box error .
     2307             undo, return error return-value .
     2308           end.
     2309         end.
     2310         else do:
     2311           assign
     2312             p-shift-date = p-fact-date - 1
     2313             p-shift-num  = 1
     2314           .
     2315         end.
     2316       end.
     2317       run factord in this-procedure
     2318         (input  p-fact-date
     2319         ,input  1
     2320         ,input  1
     2321         ,input  p-shift-date
     2322         ,input  p-shift-num
     2323         ,input  p-shift-on
     2324         ,output v-fact-order
     2325         ,output p-shift-end-fact-order
     2326         ,output p-day-end-fact-order
     2327         ) no-error .
     2328       if error-status :error
     2329       then do:
     2330         message
     2331           vss-workfile vss-revision vss-description skip
     2332           "Ошибка при вызове процедуры factord"
     2333           error-status :get-message(1) skip
     2334           return-value skip
     2335           view-as alert-box error .
     2336         undo, return error return-value .
     2337       end.
     2338     end.
     2339   end procedure.
     2340   procedure factord-lock-shift :
     2341     define input  parameter p-obj-type  as character no-undo .
     2342     define input  parameter p-obj-code  as integer   no-undo .
     2343     define input  parameter p-fact-date as date      no-undo .
     2344     define parameter buffer buf_shift-obj for ub.shift-obj .
     2345     define variable v-shift-on      as logical   no-undo .
     2346     define variable v-extra-message as character no-undo .
     2347     define variable v-error as character no-undo .
     2348     do
     2349     on error undo, return error return-value
     2350     :
     2351   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2352   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     2353     (input  p-obj-type
     2354     ,input  p-obj-code
     2355     ,input  'shift-on=request'
     2356     ,output v-shift-on
     2357     ) no-error .
     2358       if error-status :error
     2359       then do:
     2360         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
     2361         undo, return error v-error .
     2362       end.
     2363       if v-shift-on = true
     2364       then do:
     2365         find first buf_shift-obj share-lock
     2366           where buf_shift-obj.obj-type   = p-obj-type
     2367             and buf_shift-obj.obj-code   = p-obj-code
     2368             and buf_shift-obj.shift-date > p-fact-date
     2369           use-index pi
     2370           no-error .
     2371         if not available buf_shift-obj
     2372         or buf_shift-obj.status_ <> 'зкр':U
     2373         then do:
     2374           find last buf_shift-obj
     2375             where buf_shift-obj.obj-type = p-obj-type
     2376               and buf_shift-obj.obj-code = p-obj-code
     2377               and buf_shift-obj.status_  = 'зкр':U
     2378             use-index stts
     2379             no-error .
     2380           if available buf_shift-obj
     2381           then do:
     2382             assign
     2383               v-extra-message =
     2384                     substitute("Дата начала последеней закрытой смены на объекте &1"
     2385                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
     2386                               )
     2387             .
     2388           end.
     2389           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
     2390           undo, return error v-error .
     2391         end.
     2392       end.
     2393     end.
     2394   end procedure.
     2395   procedure factord-end-day :
     2396     define input  parameter p-fact-date            as date    no-undo .
     2397     define output parameter p-day-end-fact-order   as decimal no-undo .
     2398     do
     2399     on error undo, return error return-value
     2400     :
     2401       if p-fact-date = ?
     2402       then do:
     2403         return error "Не указана фактическая дата" .
     2404       end.
     2405       assign
     2406         p-day-end-fact-order = integer(p-fact-date) + 0.99
     2407       .
     2408     end.
     2409   end procedure.
     2410   procedure factord-to-date :
     2411     define input  parameter p-fact-order as decimal no-undo .
     2412     define output parameter p-fact-date  as date    no-undo .
     2413     define variable v-ref-date  as date      no-undo .
     2414     define variable v-ref-delta as integer   no-undo .
     2415     do
     2416     on error undo, return error return-value
     2417     :
     2418       if p-fact-order = ?
     2419       or p-fact-order = 0
     2420       then do:
     2421         return error "Не указан fact-order" .
     2422       end.
     2423       assign
     2424         v-ref-date  = date(1, 1, 2000)
     2425       .
     2426       assign
     2427         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
     2428       .
     2429       assign
     2430         p-fact-date = v-ref-date + v-ref-delta
     2431       .
     2432     end.
     2433   end procedure.
     2434   procedure factord-to-fact-num :
     2435     define input  parameter p-fact-order as decimal no-undo .
     2436     define output parameter p-fact-num   as integer no-undo .
     2437     define variable v-fact-order-trunc as decimal no-undo .
     2438     do
     2439     on error undo, return error return-value
     2440     :
     2441       if p-fact-order = ?
     2442       or p-fact-order = 0
     2443       then do:
     2444         return error "Не указан fact-order" .
     2445       end.
     2446       assign
     2447        v-fact-order-trunc = truncate(p-fact-order, 2)
     2448       .
     2449       assign
     2450         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
     2451       .
     2452     end.
     2453   end procedure.
     2454   procedure factord-to-shift-num :
     2455     define input  parameter p-fact-order as decimal no-undo .
     2456     define output parameter p-shift-num   as integer no-undo .
     2457     define variable  p-shift-numd  as decimal   no-undo .
     2458     define variable v-fact-order-trunc as decimal no-undo .
     2459     do
     2460     on error undo, return error return-value
     2461     :
     2462       if p-fact-order = ?
     2463       or p-fact-order = 0
     2464       then do:
     2465         return error "Не указан fact-order" .
     2466       end.
     2467       assign
     2468        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
     2469       .
     2470       if v-fact-order-trunc < 0.5 then do:
     2471         v-fact-order-trunc = v-fact-order-trunc + 0.5.
     2472       end.
     2473       assign
     2474         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
     2475         .
     2476        assign
     2477         p-shift-num = truncate (p-shift-numd , 0)
     2478       .
     2479     end.
     2480   end procedure.
     2481   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2482   def var vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2483   procedure gen-key-rec :
     2484     define input  parameter p-tbl-name    as character no-undo.
     2485     define input  parameter p-bh_tbl-name as handle    no-undo.
     2486     define output parameter p-key-rec     as character no-undo.
     2487     do
     2488     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2489     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
     2490     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
     2491     :
     2492       define variable fh               as handle    no-undo .
     2493       define variable v-ok             as logical   no-undo .
     2494       define variable v-inform         as character no-undo .
     2495       define variable v-ind            as integer   no-undo .
     2496       define variable v-idx-field-qnty as integer   no-undo .
     2497       if p-tbl-name = ?
     2498         or p-tbl-name = "":U
     2499       then do:
     2500         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info15 ).
     2501       end.
     2502       if not p-bh_tbl-name:available then do:
     2503         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info15, p-tbl-name ).
     2504       end.
     2505       assign
     2506         p-key-rec = p-tbl-name
     2507         v-inform  = p-bh_tbl-name:index-information(1)
     2508         v-ind     = 2
     2509       .
     2510       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     2511       on error undo, return error
     2512       :
     2513         assign
     2514           v-inform = p-bh_tbl-name:index-information( v-ind )
     2515           v-ind    = v-ind + 1
     2516         .
     2517       end.
     2518       if v-inform = ?
     2519         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     2520         or entry( 3, v-inform, ",":U ) <> "1":U
     2521       then do:
     2522         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info15, p-tbl-name ).
     2523       end.
     2524       else do:
     2525         assign
     2526           v-idx-field-qnty = num-entries( v-inform ) - 4
     2527         .
     2528         if v-idx-field-qnty < 2 then do:
     2529           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info15, v-inform, p-tbl-name ).
     2530         end.
     2531         do v-ind = 1 to v-idx-field-qnty by 2
     2532         on error undo, return error
     2533         :
     2534           assign
     2535             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
     2536             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
     2537           .
     2538         end.
     2539       end.
     2540       if p-key-rec = ? then do:
     2541         assign
     2542           p-key-rec = "":U
     2543         .
     2544         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info15, p-tbl-name ).
     2545       end.
     2546     end.
     2547     return.
     2548   end procedure.
     2549   procedure gen-where-keyr-tab :
     2550     define input  parameter i-tableSerach as character no-undo.
     2551     define input  parameter i-tablekey   as character  no-undo.
     2552     define input  parameter p-key-rec    as character  no-undo.
     2553     define input  parameter p-key-handle as handle     no-undo .
     2554     define input  parameter p-db-name    as character  no-undo .
     2555     define input  parameter p-tt-handle  as handle     no-undo .
     2556     define output parameter o-Where      as character  no-undo.
     2557     do
     2558     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2559     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     2560     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
     2561     :
     2562       define variable v-full-tbl-name  as character no-undo .
     2563       define variable bh_tbl-name      as handle    no-undo .
     2564       define variable fh_key           as handle    no-undo .
     2565       define variable fh_search        as handle    no-undo .
     2566       define variable v-field-num      as integer   no-undo .
     2567       define variable v-count-fld      as integer   no-undo .
     2568       define variable v-inform         as character no-undo .
     2569       define variable v-ind            as integer   no-undo .
     2570       define variable v-idx-field-qnty as integer   no-undo .
     2571       define variable v-field-name     as character no-undo .
     2572       define variable v-field-val      as character no-undo .
     2573       define variable v-word-link      as character no-undo .
     2574       define variable vTable           as character no-undo.
     2575       define variable bh_tbl-key       as handle    no-undo .
     2576       assign
     2577         p-key-rec = trim( p-key-rec )
     2578       .
     2579       if p-key-handle <> ? then do:
     2580         if not valid-handle(p-key-handle)
     2581            or p-key-handle:type <> "buffer"
     2582         then do:
     2583           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info15 ).
     2584         end.
     2585         if num-entries( p-key-rec, chr(3) ) > 1
     2586           or p-key-rec = ?
     2587           or p-key-rec = "":U
     2588         then do:
     2589           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info15, p-key-rec ).
     2590         end.
     2591       end.
     2592       else do:
     2593         if p-key-rec = ?
     2594           or p-key-rec = "":U
     2595         then do:
     2596           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info15 ).
     2597         end.
     2598       end.
     2599       assign
     2600         vTable = entry( 1 , p-key-rec, chr(3) )
     2601       .
     2602       if p-tt-handle <> ?
     2603         and ( not valid-handle(p-tt-handle)
     2604               or p-tt-handle:type <> "buffer"
     2605             )
     2606       then do:
     2607         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info15, vTable, chr(10) ).
     2608       end.
     2609       if p-tt-handle = ? then do:
     2610         assign
     2611           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
     2612         .
     2613         create buffer bh_tbl-name for table v-full-tbl-name .
     2614       end.
     2615       else do:
     2616         create buffer bh_tbl-name for table p-tt-handle:table-handle .
     2617       end.
     2618       assign
     2619         v-inform = bh_tbl-name:index-information(1)
     2620         v-ind    = 2
     2621       .
     2622       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     2623       on error undo, return error
     2624       :
     2625         assign
     2626           v-inform = bh_tbl-name:index-information( v-ind )
     2627           v-ind    = v-ind + 1
     2628         .
     2629       end.
     2630       if v-inform = ?
     2631         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     2632         or entry( 3, v-inform, ",":U ) <> "1":U
     2633       then do:
     2634         delete object bh_tbl-name no-error.
     2635         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info15, vTable ).
     2636       end.
     2637       assign
     2638         v-idx-field-qnty = num-entries( v-inform ) - 4
     2639       .
     2640       if v-idx-field-qnty < 2 then do:
     2641         delete object bh_tbl-name no-error.
     2642         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info15, v-inform, vTable ).
     2643       end.
     2644       assign
     2645         o-where     = "where":U
     2646         v-word-link = "":U
     2647         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
     2648         v-count-fld = 0
     2649       .
     2650       if i-tablekey ne "" and i-tablekey ne ?
     2651       then do:
     2652         assign
     2653           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
     2654         .
     2655         create buffer bh_tbl-key for table v-full-tbl-name .
     2656       end.
     2657       if i-tableSerach ne "" and i-tableSerach ne ?
     2658       then do:
     2659         delete object bh_tbl-name no-error.
     2660         assign
     2661           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
     2662         .
     2663         create buffer bh_tbl-name for table v-full-tbl-name .
     2664       end.
     2665       block_where:
     2666       do v-ind = 1 to v-idx-field-qnty by 2
     2667       on error undo, return error
     2668       :
     2669         assign
     2670           v-count-fld = v-count-fld + 1
     2671         .
     2672         if p-key-handle = ?
     2673           and v-count-fld > v-field-num
     2674         then do:
     2675           leave block_where.
     2676         end.
     2677         define variable VfieldKeyTable as handle no-undo.
     2678         assign
     2679           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     2680           fh_search    = bh_tbl-name:buffer-field( v-field-name )
     2681         .
     2682         if     bh_tbl-key ne ?
     2683         then do:
     2684            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
     2685            if VfieldKeyTable eq ?
     2686            then next block_where.
     2687         end.
     2688         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
     2689         then
     2690            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
     2691         else
     2692            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
     2693         if p-key-handle = ? then do:
     2694           assign
     2695             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
     2696           .
     2697         end.
     2698         else do:
     2699           assign
     2700             fh_key = p-key-handle:buffer-field( v-field-name )
     2701           .
     2702           if fh_key = ?
     2703             or not valid-handle( fh_key )
     2704           then do:
     2705             delete object bh_tbl-name.
     2706             if     bh_tbl-key ne ?
     2707             then
     2708                delete object bh_tbl-key.
     2709             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info15, p-key-handle:name, v-field-name ).
     2710           end.
     2711           assign
     2712             v-field-val = fh_key:buffer-value
     2713           .
     2714         end.
     2715         if fh_search:data-type ="character":U then do:
     2716           assign
     2717             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
     2718             v-field-val = replace( v-field-val, '"':U, '~~"':U )
     2719             v-field-val = replace( v-field-val, "'":U, "~~'":U )
     2720             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
     2721             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
     2722             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
     2723             v-field-val = replace( v-field-val, chr(10), '~~n':U )
     2724             v-field-val = replace( v-field-val, chr(9), '~~t':U )
     2725             v-field-val = replace( v-field-val, chr(13), '~~r':U )
     2726             v-field-val = replace( v-field-val, chr(27), '~~E':U )
     2727             v-field-val = replace( v-field-val, chr(8), '~~b':U )
     2728             v-field-val = replace( v-field-val, chr(12), '~~f':U )
     2729             v-field-val = substitute( '"&1"', v-field-val )
     2730           .
     2731         end.
     2732         assign
     2733           o-where = substitute( "&1 &2", o-where, v-field-val )
     2734         .
     2735         if v-word-link = "":U then do:
     2736           assign
     2737             v-word-link = "and":U
     2738           .
     2739         end.
     2740       end.
     2741       delete object bh_tbl-name.
     2742       if     bh_tbl-key ne ?
     2743       then
     2744          delete object bh_tbl-key.
     2745       if p-key-handle = ?
     2746         and v-count-fld <> v-field-num
     2747       then do:
     2748         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info15, vTable ).
     2749       end.
     2750     end.
     2751   end procedure.
     2752   procedure gen-hn-keyr-tab :
     2753     define input  parameter i-tableSerach as character no-undo.
     2754     define input  parameter i-tablekey   as character no-undo.
     2755     define input  parameter p-key-rec    as character no-undo.
     2756     define input  parameter p-key-handle as handle    no-undo .
     2757     define input  parameter p-db-name    as character no-undo .
     2758     define input  parameter p-tt-handle  as handle    no-undo .
     2759     define input  parameter p-stts-lock  as integer   no-undo .
     2760     define output parameter o-hn         as handle    no-undo.
     2761     define variable v-full-tbl-name as character no-undo.
     2762     define variable v-where         as character no-undo.
     2763     define variable bh_tbl-name     as handle    no-undo.
     2764     define variable vTable          as character no-undo.
     2765     do
     2766     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2767     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     2768     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
     2769         run gen-where-keyr-tab(i-tableSerach,
     2770                                i-tablekey,
     2771                                p-key-rec,
     2772                                p-key-handle,
     2773                                p-db-name,
     2774                                p-tt-handle,
     2775                                output v-where).
     2776         if i-tableSerach ne "" and i-tableSerach ne ?
     2777         then do:
     2778            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
     2779            create buffer bh_tbl-name for table v-full-tbl-name .
     2780         end.
     2781         else do:
     2782            if p-tt-handle = ? then do:
     2783               assign
     2784                  vTable = entry( 1 , p-key-rec, chr(3) )
     2785               .
     2786               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
     2787               create buffer bh_tbl-name for table v-full-tbl-name .
     2788            end.
     2789            else do:
     2790               create buffer bh_tbl-name for table p-tt-handle:table-handle .
     2791            end.
     2792         end.
     2793         if p-tt-handle = ? then do:
     2794            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
     2795         end.
     2796         else do:
     2797            bh_tbl-name:find-first( v-where ) no-error .
     2798         end.
     2799         o-hn = bh_tbl-name.
     2800      end.
     2801   end procedure.
     2802   procedure gen-hn-keyr :
     2803     define input  parameter p-key-rec    as character no-undo.
     2804     define input  parameter p-key-handle as handle    no-undo .
     2805     define input  parameter p-db-name    as character no-undo .
     2806     define input  parameter p-tt-handle  as handle    no-undo .
     2807     define input  parameter p-stts-lock  as integer   no-undo .
     2808     define output parameter o-hn         as handle    no-undo.
     2809     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
     2810   end.
     2811   procedure gen-row-keyr :
     2812     define input  parameter p-key-rec    as character no-undo.
     2813     define input  parameter p-key-handle as handle    no-undo .
     2814     define input  parameter p-db-name    as character no-undo .
     2815     define input  parameter p-tt-handle  as handle    no-undo .
     2816     define input  parameter p-stts-lock  as integer   no-undo .
     2817     define output parameter p-tbl-row    as rowid     no-undo.
     2818     define output parameter p-tbl-name   as character no-undo.
     2819     define variable vHn as handle no-undo.
     2820       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
     2821       p-tbl-row = if vHn:available then vHn:rowid else ?.
     2822       p-tbl-name =  vHn:table.
     2823       delete object vHn no-error.
     2824     if p-tbl-row = ? then do:
     2825       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info15, p-tbl-name, p-key-rec ).
     2826     end.
     2827     else do:
     2828       return.
     2829     end.
     2830   end procedure.
     2831   procedure gen-key-fv :
     2832     define input  parameter p-key-rec    as character no-undo .
     2833     define output parameter p-field-list as character no-undo .
     2834     define output parameter p-value-list as character no-undo.
     2835     do
     2836     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2837     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     2838     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     2839     :
     2840       define variable v-full-tbl-name  as character no-undo .
     2841       define variable bh_tbl-name      as handle    no-undo .
     2842       define variable v-tbl-name       as character no-undo .
     2843       define variable v-field-num      as integer   no-undo .
     2844       define variable v-count-fld      as integer   no-undo .
     2845       define variable v-inform         as character no-undo .
     2846       define variable v-ind            as integer   no-undo .
     2847       define variable v-idx-field-qnty as integer   no-undo .
     2848       define variable v-delim-key      as character no-undo .
     2849       if p-key-rec = ?
     2850         or p-key-rec = "":U
     2851       then do:
     2852         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info15 ).
     2853       end.
     2854       assign
     2855         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
     2856         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     2857       .
     2858       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     2859       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info15 ).
     2860       assign
     2861         v-inform = bh_tbl-name:index-information(1)
     2862         v-ind    = 2
     2863       .
     2864       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     2865       on error undo, return error
     2866       :
     2867         assign
     2868           v-inform = bh_tbl-name:index-information( v-ind )
     2869           v-ind    = v-ind + 1
     2870         .
     2871       end.
     2872       if v-inform = ?
     2873         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     2874         or entry( 3, v-inform, ",":U ) <> "1":U
     2875       then do:
     2876         delete object bh_tbl-name no-error.
     2877         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info15, v-tbl-name ).
     2878       end.
     2879       assign
     2880         v-idx-field-qnty = num-entries( v-inform ) - 4
     2881       .
     2882       if v-idx-field-qnty < 2 then do:
     2883         delete object bh_tbl-name no-error.
     2884         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info15, v-inform, v-tbl-name ).
     2885       end.
     2886       assign
     2887         p-field-list = "":U
     2888         p-value-list = "":U
     2889         v-delim-key  = "":U
     2890         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
     2891         v-count-fld  = 0
     2892       .
     2893       block_where:
     2894       do v-ind = 1 to v-idx-field-qnty by 2
     2895       on error undo, return error
     2896       :
     2897         assign
     2898           v-count-fld = v-count-fld + 1
     2899         .
     2900         if v-count-fld > v-field-num then do:
     2901           leave block_where.
     2902         end.
     2903         assign
     2904           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
     2905           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
     2906         .
     2907         if v-ind = 1 then do:
     2908           assign
     2909             v-delim-key = chr(3)
     2910           .
     2911         end.
     2912       end.
     2913       delete object bh_tbl-name.
     2914       if v-count-fld <> v-field-num then do:
     2915         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info15, v-tbl-name ).
     2916       end.
     2917     end.
     2918   end procedure.
     2919   procedure gen-key-field :
     2920     define input  parameter p-table      as character no-undo .
     2921     define output parameter p-field-list as character no-undo .
     2922     do
     2923     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2924     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     2925     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     2926     :
     2927       define variable v-full-tbl-name  as character no-undo .
     2928       define variable bh_tbl-name      as handle    no-undo .
     2929       define variable v-tbl-name       as character no-undo .
     2930       define variable v-field-num      as integer   no-undo .
     2931       define variable v-count-fld      as integer   no-undo .
     2932       define variable v-inform         as character no-undo .
     2933       define variable v-ind            as integer   no-undo .
     2934       define variable v-idx-field-qnty as integer   no-undo .
     2935       define variable v-delim-key      as character no-undo .
     2936       if p-table = ?
     2937         or p-table = "":U
     2938       then do:
     2939         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info15 ).
     2940       end.
     2941       assign
     2942         v-tbl-name      = p-table
     2943         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     2944       .
     2945       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     2946       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info15 ).
     2947       assign
     2948         v-inform = bh_tbl-name:index-information(1)
     2949         v-ind    = 2
     2950       .
     2951       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     2952       on error undo, return error
     2953       :
     2954         assign
     2955           v-inform = bh_tbl-name:index-information( v-ind )
     2956           v-ind    = v-ind + 1
     2957         .
     2958       end.
     2959       if v-inform = ?
     2960         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     2961         or entry( 3, v-inform, ",":U ) <> "1":U
     2962       then do:
     2963         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info15, v-tbl-name ).
     2964       end.
     2965       assign
     2966         v-idx-field-qnty = num-entries( v-inform ) - 4
     2967       .
     2968       if v-idx-field-qnty < 2 then do:
     2969         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info15, v-inform, v-tbl-name ).
     2970       end.
     2971       assign
     2972         p-field-list = "":U
     2973         v-delim-key  = "":U
     2974         v-count-fld  = 0
     2975       .
     2976       block_where:
     2977       do v-ind = 1 to v-idx-field-qnty by 2
     2978       on error undo, return error
     2979       :
     2980         assign
     2981           v-count-fld = v-count-fld + 1
     2982         .
     2983         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
     2984         if v-ind = 1 then do:
     2985           assign
     2986             v-delim-key = chr(3)
     2987           .
     2988         end.
     2989       end.
     2990       delete object bh_tbl-name.
     2991     end.
     2992   end procedure.
     2993   define variable v-chg-fields as character no-undo.
     2994   define variable v-chg-fields-name as character no-undo.
     2995   define variable v-old-fields as character no-undo.
     2996   define variable v-new-fields as character no-undo.
     2997   define variable ii as integer no-undo.
     2998   define variable v-mess as character no-undo .
     2999   define buffer buf_c-gds-hist for ub.c-gds-hist.
     3000   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3001   define SHARED temp-table temp-changes no-undo
     3002   field f_name as character
     3003   field l_name as character
     3004   field v_old as character
     3005   field v_new as character
     3006   field t_name as character
     3007   field num_ as integer
     3008   field uniq-key-rec as character
     3009   field action as integer
     3010   field fNotChange as logical
     3011   index pi is unique primary
     3012   num_
     3013   t_name
     3014   f_name
     3015   index
     3016   Chan
     3017   fnotChange
     3018   t_name
     3019   f_name
     3020   index imain uniq-key-rec
     3021   .
     3022   FUNCTION get-all-fields returns character (p-file-name as character ):
     3023   define variable v-dop as character no-undo .
     3024     find first _file no-lock where _file._file-name = p-file-name no-error .
     3025     if not available _file then return "":U.
     3026     for each _field no-lock where
     3027              _field._file-recid = recid(_file) :
     3028       assign
     3029       v-dop = v-dop + _field._field-name + chr(44)
     3030       .
     3031     end.
     3032     return trim(v-dop).
     3033   END FUNCTION.
     3034   PROCEDURE proc-full-temp-changes :
     3035     define input  parameter p-act-create as logical   no-undo .
     3036     define input  parameter p-act-delete as logical   no-undo .
     3037     define input  parameter p-hst-handle as handle    no-undo .
     3038     define input  parameter p-main-table as character no-undo .
     3039     define input  parameter p-field-list as character no-undo .
     3040     define input  parameter p-label-form as character no-undo .
     3041     define variable h-new-buf         as handle    no-undo .
     3042     define variable h-main-buf        as handle    no-undo .
     3043     define variable h-for-comp        as handle    no-undo .
     3044     define variable v-inform          as character no-undo .
     3045     define variable v-ind             as integer   no-undo .
     3046     define variable v-idx-field-qnty  as integer   no-undo .
     3047     define variable v-num-entries     as integer   no-undo .
     3048     define variable fh                as handle    no-undo .
     3049     define variable fh-main           as handle    no-undo .
     3050     define variable fh-old            as handle    no-undo .
     3051     define variable fh-new            as handle    no-undo .
     3052     define variable v-field-name      as character no-undo .
     3053     define variable v-field-lvl       as character no-undo .
     3054     define variable v-field-form      as character no-undo .
     3055     define variable v-search-exp      as character no-undo .
     3056     define variable v-srch-main       as character no-undo .
     3057     define variable v-word-link       as character no-undo .
     3058     define variable v-av-chip-num     as logical   no-undo .
     3059     define variable v-main-pi-fld-lst as character no-undo .
     3060     define variable v-main-fld-lst    as character no-undo .
     3061     define variable v-delim-list      as character no-undo .
     3062     define variable v-label           as character no-undo .
     3063     define variable v-old-value       as character no-undo case-sensitive.
     3064     define variable v-new-value       as character no-undo case-sensitive.
     3065     define variable v-chg-fields as character no-undo.
     3066     for each temp-changes:
     3067       delete temp-changes.
     3068     end.
     3069     if not p-hst-handle:available then do:
     3070       return .
     3071     end.
     3072     create buffer h-new-buf  for table p-hst-handle .
     3073     create buffer h-main-buf for table p-main-table .
     3074     assign
     3075       v-inform = h-main-buf:index-information(1)
     3076       v-ind    = 2
     3077     .
     3078     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     3079     on error undo, return error
     3080     :
     3081       assign
     3082         v-inform = h-main-buf:index-information( v-ind )
     3083         v-ind    = v-ind + 1
     3084       .
     3085     end.
     3086     if v-inform = ?
     3087       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     3088       or entry( 3, v-inform, ",":U ) <> "1":U
     3089     then do:
     3090       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, h-main-buf:name ).
     3091     end.
     3092     assign
     3093       v-idx-field-qnty = num-entries( v-inform ) - 4
     3094     .
     3095     if v-idx-field-qnty < 2 then do:
     3096       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, h-main-buf:name ).
     3097     end.
     3098     assign
     3099       v-srch-main   = "where":U
     3100       v-word-link   = "":U
     3101       v-av-chip-num = false
     3102       v-delim-list  = "":U
     3103     .
     3104     do v-ind = 1 to v-idx-field-qnty by 2
     3105     on error undo, return error
     3106     :
     3107       assign
     3108         v-field-name      = entry( 4 + v-ind, v-inform, ",":U )
     3109         fh                = p-hst-handle:buffer-field( v-field-name )
     3110         fh-main           = h-main-buf:buffer-field( v-field-name )
     3111         v-srch-main       = substitute( "&1 &2 &3.&4 =", v-srch-main, v-word-link, fh-main:table, v-field-name )
     3112         v-main-pi-fld-lst = v-main-pi-fld-lst + v-delim-list + v-field-name
     3113       .
     3114       if fh:data-type ="character":U then do:
     3115         assign
     3116           v-srch-main = substitute( '&1 "&2"', v-srch-main, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
     3117         .
     3118       end.
     3119       else do:
     3120         assign
     3121           v-srch-main = substitute( "&1 &2", v-srch-main, fh:buffer-value() )
     3122         .
     3123       end.
     3124       if v-delim-list = "":U then do:
     3125         assign
     3126           v-delim-list = ",":U
     3127         .
     3128       end.
     3129       if v-word-link = "":U then do:
     3130         assign
     3131           v-word-link = "and":U
     3132         .
     3133       end.
     3134     end.
     3135     assign
     3136       v-delim-list  = "":U
     3137     .
     3138     do v-ind = 1 to h-main-buf:num-fields
     3139     on error undo, return error
     3140     :
     3141       assign
     3142         fh-main      = h-main-buf:buffer-field( v-ind )
     3143         v-field-name = fh-main:name
     3144       .
     3145         assign
     3146           v-main-fld-lst = v-main-fld-lst + v-delim-list + v-field-name
     3147         .
     3148         if v-delim-list = "":U then do:
     3149           assign
     3150             v-delim-list = ",":U
     3151           .
     3152         end.
     3153     end.
     3154     assign
     3155       v-inform = p-hst-handle:index-information(1)
     3156       v-ind    = 2
     3157     .
     3158     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     3159     on error undo, return error
     3160     :
     3161       assign
     3162         v-inform = p-hst-handle:index-information( v-ind )
     3163         v-ind    = v-ind + 1
     3164       .
     3165     end.
     3166     if v-inform = ?
     3167       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     3168       or entry( 3, v-inform, ",":U ) <> "1":U
     3169     then do:
     3170       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, p-hst-handle:name ).
     3171     end.
     3172     assign
     3173       v-idx-field-qnty = num-entries( v-inform ) - 4
     3174     .
     3175     if v-idx-field-qnty < 2 then do:
     3176       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, p-hst-handle:name ).
     3177     end.
     3178     assign
     3179       v-search-exp  = "where":U
     3180       v-word-link   = "":U
     3181       v-av-chip-num = false
     3182     .
     3183     do v-ind = 1 to v-idx-field-qnty by 2
     3184     on error undo, return error
     3185     :
     3186       assign
     3187         v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     3188         fh           = p-hst-handle:buffer-field( v-field-name )
     3189         v-search-exp = substitute( "&1 &2 &3.&4", v-search-exp, v-word-link, fh:table, v-field-name )
     3190       .
     3191       if v-field-name = "chip-num":U then do:
     3192         assign
     3193           v-search-exp  = substitute( "&1 >", v-search-exp )
     3194           v-av-chip-num = true
     3195         .
     3196       end.
     3197       else do:
     3198         assign
     3199           v-search-exp = substitute( "&1 =", v-search-exp )
     3200         .
     3201       end.
     3202       if fh:data-type ="character":U then do:
     3203         assign
     3204           v-search-exp = substitute( '&1 "&2"', v-search-exp, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
     3205         .
     3206       end.
     3207       else do:
     3208         assign
     3209           v-search-exp = substitute( '&1 &2', v-search-exp, fh:buffer-value() )
     3210         .
     3211       end.
     3212       if v-word-link = "":U then do:
     3213         assign
     3214           v-word-link = "and":U
     3215         .
     3216       end.
     3217     end.
     3218     if v-av-chip-num = false then do:
     3219       message
     3220         vss-workfile vss-revision vss-description skip
     3221         substitute( "Таблица &2 не содержит поля chip-num.", vss-workfile, p-hst-handle:name ) skip
     3222         "Использование данной процедуры невозможно!" skip
     3223         view-as alert-box error .
     3224       return error .
     3225     end.
     3226     h-new-buf:find-first( v-search-exp, no-lock ) no-error .
     3227     if not h-new-buf:available then do:
     3228       h-main-buf:find-first( v-srch-main, no-lock ) no-error .
     3229       if not h-main-buf:available then do:
     3230         assign
     3231           h-for-comp = ?
     3232         .
     3233       end.
     3234       else do:
     3235         assign
     3236           h-for-comp = h-main-buf
     3237         .
     3238       end.
     3239     end.
     3240     else do:
     3241       assign
     3242         h-for-comp = h-new-buf
     3243       .
     3244     end.
     3245     assign
     3246       v-num-entries = num-entries( v-main-fld-lst, ",":U )
     3247     .
     3248     do v-ind = 1 to v-num-entries
     3249     on error undo, return error return-value
     3250     :
     3251       assign
     3252         v-field-name = entry( v-ind, v-main-fld-lst )
     3253         fh-old       = p-hst-handle:buffer-field( v-field-name )
     3254         v-old-value  = fh-old:buffer-value()
     3255         v-label      = trim( fh-old:label )
     3256       .
     3257       if ( trim( p-field-list ) <> "":U
     3258            and lookup( v-field-name, p-field-list ) > 0
     3259          )
     3260          or trim( p-field-list ) = "":U
     3261       then do:
     3262         if h-for-comp <> ? then do:
     3263           assign
     3264             fh-new      = h-for-comp:buffer-field( v-field-name )
     3265             v-new-value = fh-new:buffer-value()
     3266           .
     3267         end.
     3268         else do:
     3269           assign
     3270             v-new-value = "":U
     3271           .
     3272         end.
     3273           if p-act-create = true then do:
     3274             assign
     3275               v-old-value = "":U
     3276             .
     3277           end.
     3278           if p-act-delete = true then do:
     3279             assign
     3280               v-new-value = "":U
     3281             .
     3282           end.
     3283         if v-old-value <> v-new-value
     3284         then do:
     3285           create temp-changes.
     3286           assign
     3287             temp-changes.t_name = p-main-table
     3288             temp-changes.f_name = v-field-name
     3289             temp-changes.l_name = replace( v-label, "&":U, "":U )
     3290             temp-changes.v_old  = trim( v-old-value )
     3291             temp-changes.v_new  = trim( v-new-value )
     3292             temp-changes.num_   = 0
     3293             temp-changes.fNotChange = v-old-value eq v-new-value
     3294           .
     3295         end.
     3296       end.
     3297     end.
     3298     assign
     3299       v-num-entries = num-entries( p-label-form, chr(8) )
     3300     .
     3301     do v-ind = 1 to v-num-entries
     3302     on error undo, return error return-value
     3303     :
     3304       if num-entries( entry( v-ind, p-label-form, chr(8) ), chr(4) ) = 3 then do:
     3305         assign
     3306           v-field-name = entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     3307           v-field-lvl  = entry( 2, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     3308           v-field-form = entry( 3, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     3309         .
     3310         find first temp-changes
     3311           where temp-changes.f_name = v-field-name
     3312           no-error .
     3313         if available temp-changes then do:
     3314           if trim( v-field-lvl ) <> "":U then do:
     3315             assign
     3316               temp-changes.l_name = v-field-lvl
     3317             .
     3318           end.
     3319           if trim( v-field-form ) <> "":U then do:
     3320             assign
     3321               temp-changes.v_old = dynamic-function( v-field-form, temp-changes.v_old )
     3322             .
     3323             if h-for-comp <> ? then do:
     3324               assign
     3325                 temp-changes.v_new = dynamic-function( v-field-form, temp-changes.v_new )
     3326               .
     3327             end.
     3328           end.
     3329         end.
     3330       end.
     3331       else do:
     3332         message
     3333           vss-workfile vss-revision vss-description skip
     3334           "Ошибка! Список должен содержать три поля с разделителем delim-par!" skip
     3335           substitute( "список для поля '&1': '&2'"
     3336                       ,entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     3337                       ,entry( v-ind, p-label-form, chr(8) )
     3338                     ) skip
     3339           substitute( "полный список: &2", p-label-form ) skip
     3340           view-as alert-box error .
     3341       end.
     3342     end.
     3343     delete object h-new-buf .
     3344     delete object h-main-buf .
     3345   END PROCEDURE.
     3346   find first buf_c-gds-hist no-lock where
     3347             buf_c-gds-hist.gds-code = p-gds-code
     3348         AND buf_c-gds-hist.chip-num = p-chip-num
     3349         AND buf_c-gds-hist.subject  = p-subject no-error .
     3350   if not available buf_c-gds-hist then do:
     3351     return error .
     3352   end.
     3353   CASE p-subject:
     3354     when 'goods':U then do:
     3355       run goods-proc in this-procedure(output p-description) no-error .
     3356     end.
     3357     when 'gds-obj-attr':U then do:
     3358       run gds-obj-attr-proc in this-procedure(output p-description) no-error .
     3359     end.
     3360     when 'gds-host-attr':U then do:
     3361       run gds-host-attr-proc in this-procedure(output p-description) no-error .
     3362     end.
     3363     when 'goods-attr':U then do:
     3364       run goods-attr-proc in this-procedure(output p-description) no-error  .
     3365     end.
     3366     when 'fbr-gds-obj':U then do:
     3367       run fbr-gds-obj-proc in this-procedure(output p-description) no-error  .
     3368     end.
     3369     when 's-coeff':U then do:
     3370       run s-coeff-proc in this-procedure(output p-description) no-error  .
     3371     end.
     3372     when 'prod-bc':U then do:
     3373       run prod-bc-proc in this-procedure(output p-description) no-error  .
     3374     end.
     3375     when 'bar-code':U then do:
     3376       run bar-code-proc in this-procedure(output p-description) no-error  .
     3377     end.
     3378     when 'bar-code-attr':U then do:
     3379       run bar-code-attr-proc in this-procedure(output p-description) no-error  .
     3380     end.
     3381     when 'varianty-delivery-gds-obj':U then do:
     3382       run varianty-delivery-gds-obj-proc in this-procedure(output p-description) no-error  .
     3383     end.
     3384     when 'gds-season':U then do:
     3385       run gds-season-proc in this-procedure(output p-description) no-error  .
     3386     end.
     3387     when 'tax-rate-gds':U then do:
     3388       run tax-rate-gds-proc in this-procedure(output p-description) no-error  .
     3389     end.
     3390     when 'assortment-matrix-goods':U then do:
     3391       run ass-matr-proc in this-procedure(output p-description) no-error  .
     3392     end.
     3393     when 'gds-obj-prop':U then do:
     3394       run izt-proc in this-procedure(output p-description) no-error  .
     3395     end.
     3396     when 'pl-gds':U then do:
     3397       run pl-gds-proc in this-procedure(output p-description) no-error  .
     3398     end.
     3399     when 'pl-gds-attr':U then do:
     3400       run pl-gds-attr-proc in this-procedure(output p-description) no-error  .
     3401     end.
     3402     when 'pl-gds-pump':U then do:
     3403       run pl-gds-pump-proc in this-procedure(output p-description) no-error  .
     3404     end.
     3405     when 'dis-gds-rule':U then do:
     3406       run dis-gds-rule-proc in this-procedure(output p-description) no-error  .
     3407     end.
     3408     when 'ext-artic':U then do:
     3409       run ext-artic-proc in this-procedure(output p-description) no-error  .
     3410     end.
     3411     when 'sert-join':U then do:
     3412       run sert-join-proc in this-procedure(output p-description) no-error  .
     3413     end.
     3414     when 'recipe':U then do:
     3415       run recipe-proc in this-procedure(output p-description) no-error  .
     3416     end.
     3417     when 'recipe-gds':U then do:
     3418       run recipe-gds-proc in this-procedure(output p-description) no-error  .
     3419     end.
     3420     when 'ext-classif':U then do:
     3421       run ext-classif-proc in this-procedure(output p-description) no-error  .
     3422     end.
     3423     when 'gds-obj-prop-attr':U then do:
     3424       run gds-obj-prop-attr-proc in this-procedure(output p-description) no-error .
     3425     end.
     3426   END CASE.
     3427   if error-status:error then do:
     3428     return error .
     3429   end.
