     3700   end procedure.
     3701   function get-node-code-name returns character ( input p-node-code as integer):
     3702   define variable v-prt-name as character no-undo .
     3703   v-prt-name = "(":U + string(p-node-code) + ")".
     3704   define buffer buf_gds-prt for ub.gds-prt.
     3705   find first buf_gds-prt no-lock where
     3706             buf_gds-prt.node-code = p-node-code no-error.
     3707   if available buf_gds-prt then do:
     3708     assign
     3709     v-prt-name =  (if buf_gds-prt.f-name <> "":U
     3710                   then buf_gds-prt.f-name
     3711                   else buf_gds-prt.node-name) + "(":U + string(p-node-code) + ")"
     3712     .
     3713   end.
     3714   return v-prt-name.
     3715   end function.
     3716   procedure bar-code-proc :
     3717   define output parameter p-description as character no-undo .
     3718   define buffer current_c-bar-code for ub.c-bar-code  .
     3719   do
     3720   on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     3721   :
     3722       find first current_c-bar-code no-lock where
     3723                  current_c-bar-code.gds-code = p-gds-code
     3724              AND current_c-bar-code.b-code   = buf_c-gds-hist.b-code
     3725              AND current_c-bar-code.chip-num = p-chip-num
