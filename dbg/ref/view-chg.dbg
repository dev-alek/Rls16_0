        1   DEFINE INPUT PARAMETER parparentproc AS WIDGET-HANDLE NO-UNDO.
        2   DEFINE INPUT PARAMETER p-call-handle AS HANDLE NO-UNDO.
        3   define input parameter p-tbl-name as character no-undo .
        4   DEFINE INPUT PARAMETER p-first-bh AS HANDLE no-undo.
        5   DEFINE INPUT PARAMETER p-next-bh AS HANDLE no-undo.
        6   DEFINE INPUT PARAMETER p-mode AS CHARACTER no-undo.
        7   DEFINE INPUT PARAMETER p-limit-access AS integer no-undo.
        8   DEFINE INPUT PARAMETER p-title AS character no-undo.
        9   define input parameter p-col-old-label as character no-undo .
       10   define input parameter p-col-new-label as character no-undo .
       11   define input parameter p-col-aux-label as character no-undo .
       12   DEFINE INPUT PARAMETER p-descr AS character no-undo.
       13   DEFINE OUTPUT PARAMETER p-ok AS logical no-undo.
       14   define variable vss-revision    as character no-undo init "$Revision$":U .
       15   define variable vss-author      as character no-undo init "$Author$":U .
       16   define variable vss-date        as character no-undo init "$Date$":U .
       17   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       18   define variable vss-archive     as character no-undo init "$Archive$":U .
       19   define variable vss-description as character no-undo init "Просмотр и изменение коррекции записи в связи с происшедними изменениями реляционных таблиц".
       20   procedure vss-get-info :
       21     define output parameter p-vss-revision    like vss-revision    no-undo .
       22     define output parameter p-vss-author      like vss-author      no-undo .
       23     define output parameter p-vss-date        like vss-date        no-undo .
       24     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       25     define output parameter p-vss-archive     like vss-archive     no-undo .
       26     define output parameter p-vss-description like vss-description no-undo .
       27     assign
       28       p-vss-revision    = vss-revision
       29       p-vss-author      = vss-author
       30       p-vss-date        = vss-date
       31       p-vss-workfile    = vss-workfile
       32       p-vss-archive     = vss-archive
       33       p-vss-description = vss-description
       34     .
       35   end procedure.
       36   procedure vss-get-parameters :
       37     define output parameter p-vss-parameters as character no-undo .
       38   end procedure.
       39   define new global shared variable g#vssrevis-logger as handle    no-undo .
       40   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       41   define variable v-vssrevis-logger                   as handle    no-undo .
       42   procedure vss-logevent :
       43     define input  parameter p-extra-paramters as character no-undo .
       44     define variable v-vssrevis-parameters as character no-undo .
       45     do
       46     on error undo, return error return-value
       47     :
       48       if  valid-handle(v-vssrevis-logger)
       49       and v-vssrevis-logger :get-signature("logevent") <> ""
       50       then do:
       51         run vss-get-parameters in this-procedure
       52           (output v-vssrevis-parameters
       53           ).
       54         run logevent in v-vssrevis-logger
       55           (input vss-workfile
       56           ,input vss-revision
       57           ,input v-vssrevis-parameters
       58           ,input p-extra-paramters
       59           ).
       60       end.
       61     end.
       62   end procedure.
       63   assign
       64     v-vssrevis-logger = g#vssrevis-logger
       65   .
       66   if  valid-handle(v-vssrevis-logger)
       67   and v-vssrevis-logger :get-signature("logevent") <> ""
       68   then do:
       69     assign
       70       v-vssrevis-logevent = true
       71     .
       72     run vss-logevent in this-procedure (input vss-description) .
       73   end.
       74   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       75   define variable v-waitfram-action01         as character   no-undo .
       76   define variable v-waitfram-action02         as character   no-undo .
       77   define variable v-waitfram-action03         as character   no-undo .
       78   define variable mWaitFramTextBeg            as character   no-undo.
       79   define variable mWaitFramTextEnd            as character   no-undo.
       80   define variable mWaitFramView               as logical     no-undo.
       81   define variable mWaitProcEvent              as logical     no-undo init yes.
       82   define variable mWaitFramInterval           as integer     no-undo init 1 .
       83   define variable mWaitFramStop               as logical     no-undo.
       84   define variable mWaitFramStopUser           as logical     no-undo.
       85   define variable mWaitFramStopTimeOut        as logical     no-undo.
       86   define variable mWaitFramStartProc          as datetime-tz no-undo.
       87   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
       88   define button B-WaitFramStop auto-end-key
       89        label "Стоп"
       90        size 10 by 1 tooltip "Остоновить процесс".
       91   define button B-viewProcInfo
       92        label "Информация"
       93        size 15 by 1 tooltip "Информация о процесс".
       94   define frame waitfram
       95     v-waitfram-action01 format "x(72)" no-label skip
       96     v-waitfram-action02 format "x(72)" no-label skip
       97     v-waitfram-action03 format "x(72)" no-label skip
       98     B-viewProcInfo
       99     B-WaitFramStop at row 4 col 30
      100     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      101     .
      102   define new global shared variable mBatchMode as logical no-undo init ?.
      103   define variable mFramBachModHandle as handle no-undo.
      104   mFramBachModHandle = frame waitfram:handle.
      105   define variable mFameOldVis as logical no-undo.
      106   define variable mVisCUrentVin as logical no-undo.
      107   if session:batch-mode
      108   then
      109      mBatchMode = yes.
      110   if mBatchMode = ? then do:
      111     mVisCUrentVin = current-window:visible.
      112     mFameOldVis = mFramBachModHandle:visible.
      113     mFramBachModHandle:visible  = yes.
      114     mBatchMode = mFramBachModHandle:visible ne yes.
      115     mFramBachModHandle:visible = mFameOldVis.
      116     current-window:visible = mVisCUrentVin.
      117   end.
      118    if  log-manager:logfile-name ne ?
      119     then DO:
      120         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      121         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      122         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      123     end.
      124   on choose of B-WaitFramStop in frame waitfram
      125   do:
      126     mWaitFramStop = yes.
      127     mWaitFramStopUser = yes.
      128   end.
      129   function waitfram-check-timeout returns logical():
      130      define variable vtime as int64 no-undo.
      131      if mWaitFramStopTimeOut
      132      then
      133         return yes.
      134      vtime = ( now - mWaitFramStartProc ) / 1000 .
      135      if     mWaitFramTimeOut ne ?
      136         and mWaitFramTimeOut ne 0
      137         and mWaitFramTimeOut lt vtime
      138      then do:
      139         mWaitFramStopTimeOut = yes.
      140      end.
      141      return mWaitFramStopTimeOut.
      142   end.
      143   procedure waitfram-hide :
      144     if not session:batch-mode
      145     then do
      146     on error undo, return error return-value
      147     :
      148       pause 0 before-hide .
      149       if not mBatchMode then
      150         hide frame waitfram .
      151     if     not mWaitFramView
      152        and mWaitProcEvent
      153     then
      154       process events .
      155     end.
      156   end procedure.
      157   procedure waitfram-show :
      158     define input  parameter p-message as character no-undo .
      159     define variable v-left-margin as integer   no-undo .
      160     if not session:batch-mode
      161     then do
      162     on error undo, return error return-value
      163     :
      164       if length(p-message) <= 70 then do:
      165         assign
      166           v-left-margin = integer((70 - length(p-message)) / 2)
      167         .
      168         assign
      169           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      170         .
      171         assign
      172           v-waitfram-action01 = " "
      173           v-waitfram-action02 = " "
      174                                    + fill(" ", v-left-margin)
      175                                    + p-message
      176           v-waitfram-action03 = " "
      177         .
      178       end.
      179       else do:
      180         define variable vRindex1 as integer no-undo.
      181         define variable vRindex2 as integer no-undo.
      182         vRindex1 = r-index(p-message," ",70).
      183         if vRindex1 = 0
      184         then
      185            vRindex1 = 70.
      186         if length(p-message)  <= vRindex1 + 70 then do:
      187           assign
      188             v-waitfram-action01 = " "
      189             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      190             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      191           .
      192         end.
      193         else do:
      194           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      195           if vRindex2 <= vRindex1
      196           then
      197              vRindex2 = vRindex1 + 70.
      198           assign
      199             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      200             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      201             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      202           .
      203         end.
      204       end.
      205       B-viewProcInfo:visible   in frame waitfram = no.
      206       B-viewProcInfo:sensitive in frame waitfram = no.
      207       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      208       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      209       if  (   mWaitFramView
      210          or  mWaitProcEvent)
      211          and not mBatchMode
      212       then
      213          display
      214             v-waitfram-action01 skip
      215             v-waitfram-action02 skip
      216             v-waitfram-action03 skip
      217          with frame waitfram .
      218       if     mWaitFramView
      219          then do:
      220             if     mWaitFramInterval ne ?
      221                and not mBatchMode
      222             then
      223                wait-for go of frame waitfram pause mWaitFramInterval.
      224          end.
      225          else
      226             if     mWaitProcEvent
      227                and not mBatchMode
      228             then
      229                process events .
      230     end.
      231   end procedure.
      232      procedure waitfram-show-this:
      233         define input  parameter iInterval as int64 no-undo.
      234         define variable vtime as int64 no-undo.
      235         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      236         mWaitFramInterval = iInterval.
      237         run waitfram-show (substitute("&1&2 &3&4" ,
      238                                       mWaitFramTextBeg ,
      239                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      240                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      241                                       mWaitFramTextEnd
      242                                      )
      243                           ).
      244      end.
      245      procedure WaitFramRunPause:
      246         define input  parameter iInterval as dec no-undo.
      247         define variable vStart  as datetime-tz no-undo.
      248         define variable vend    as datetime-tz no-undo.
      249         define variable vint as int64 no-undo.
      250         define variable vOk as logical no-undo.
      251         vStart = now.
      252         vend   = vStart.
      253         publish "WaitFramPause" (iInterval,output vOk).
      254         vend   =  now.
      255         vint = vend - vStart.
      256         vint = iInterval - vint / 1000.
      257         if     not mWaitFramStop
      258            and (   vint > 0
      259                 or (    not vOk
      260                     and iInterval eq ?
      261                     )
      262                 )
      263         then
      264            run waitfram-show-this (iInterval).
      265         vend   =  now.
      266         vint = vend - vStart.
      267         vint = iInterval - vint / 1000.
      268         if     not mWaitFramStop
      269            and vint > 0
      270         then do:
      271            run gbl/pause.p (vint * 1000).
      272         end.
      273         if iInterval ne ?
      274         then
      275            publish "WaitFramStop".
      276         waitfram-check-timeout().
      277      end.
      278      procedure WaitFramWaitFor:
      279         define input  parameter iInterval as dec no-undo.
      280         assign
      281            mWaitFramStartProc   = now
      282            mWaitFramStopUser    = no
      283            mWaitFramStopTimeOut = no
      284         .
      285         block-wait:
      286         do while not mWaitFramStop:
      287            run WaitFramRunPause (iInterval).
      288            if  waitfram-check-timeout()
      289            then do:
      290               leave block-wait.
      291            end.
      292         end.
      293         run waitfram-hide.
      294      end.
      295   procedure waitfram-join :
      296     define input  parameter p-line-1  as character no-undo .
      297     define input  parameter p-line-2  as character no-undo .
      298     define input  parameter p-line-3  as character no-undo .
      299     define output parameter p-message as character no-undo .
      300     do
      301     on error undo, return error return-value
      302     :
      303       assign
      304         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      305                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      306                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      307       .
      308     end.
      309   end procedure.
      310   function waitfram-join-function returns character
      311     (input p-line-1 as character
      312     ,input p-line-2 as character
      313     ,input p-line-3 as character
      314     ).
      315     define variable v-message as character no-undo .
      316     run waitfram-join in this-procedure
      317       (input  p-line-1
      318       ,input  p-line-2
      319       ,input  p-line-3
      320       ,output v-message
      321       ) .
      322     return v-message .
      323   end function .
      324   define new global shared variable g#language as character no-undo .
      325   if g#language <> '' and g#language <> 'rus':U then do:
      326     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      327   end.
      328   define new global shared variable g#library  as handle no-undo .
      329   define new global shared variable g#library2 as handle no-undo .
      330   procedure proc-alt-shift-f2:
      331     if not ibs.th.gbl.gbl-var:rcode
      332   then
      333     run gbl\inidebug.p .
      334   end.
      335   procedure proc-alt-shift-f3:
      336     run gbl/prvssinf.p
      337       ( input this-procedure
      338       ) .
      339   end.
      340   define variable v-inform-launched as logical no-undo initial false .
      341   procedure proc-alt-shift-f4:
      342     define variable v-action as character no-undo .
      343     if v-inform-launched = false then do:
      344       assign
      345         v-inform-launched = true
      346       .
      347       run gbl/d-inform.w
      348         (  input self
      349         ,  input this-procedure
      350         , output v-action
      351         ) no-error .
      352       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      353       assign
      354         v-inform-launched = false
      355       .
      356     end.
      357   end.
      358   procedure proc-alt-f1:
      359     run gbl/corrhelp.p
      360       (input this-procedure
      361       ) .
      362   end .
      363   on alt-shift-f2 anywhere do:
      364     run proc-alt-shift-f2.
      365   end.
      366   on alt-shift-f3 anywhere do:
      367     run proc-alt-shift-f3 in this-procedure .
      368   end.
      369   on alt-shift-f4 anywhere do:
      370     run proc-alt-shift-f4 in this-procedure.
      371   end.
      372   on alt-f1 anywhere do:
      373     run proc-alt-f1 in this-procedure .
      374   end.
      375   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      376   DEF VAR BLACK_COLOR        AS INTEGER NO-UNDO INIT  0.
      377   DEF VAR DARK_BLUE_COLOR    AS INTEGER NO-UNDO INIT  1.
      378   DEF VAR DARK_GREEN_COLOR   AS INTEGER NO-UNDO INIT  2.
      379   DEF VAR CYAN_COLOR         AS INTEGER NO-UNDO INIT  3.
      380   DEF VAR BROWN_COLOR        AS INTEGER NO-UNDO INIT  4.
      381   DEF VAR DARK_GRAY_COLOR    AS INTEGER NO-UNDO INIT  7.
      382   DEF VAR DARK_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
      383   DEF VAR VERY_GRAY_COLOR    AS INTEGER NO-UNDO INIT  7.
      384   DEF VAR VERY_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
      385   DEF VAR GRAY_COLOR         AS INTEGER NO-UNDO INIT  8.
      386   DEF VAR GREY_COLOR         AS INTEGER NO-UNDO INIT  8.
      387   DEF VAR BLUE_COLOR         AS INTEGER NO-UNDO INIT  9.
      388   DEF VAR GREEN_COLOR        AS INTEGER NO-UNDO INIT 10.
      389   DEF VAR RED_COLOR          AS INTEGER NO-UNDO INIT 12.
      390   DEF VAR LIGHT_RED_COLOR    AS INTEGER NO-UNDO INIT 13.
      391   DEF VAR YELLOW_COLOR       AS INTEGER NO-UNDO INIT 14.
      392   DEF VAR WHITE_COLOR        AS INTEGER NO-UNDO INIT 15.
      393   def var vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      394   procedure gen-key-rec :
      395     define input  parameter p-tbl-name    as character no-undo.
      396     define input  parameter p-bh_tbl-name as handle    no-undo.
      397     define output parameter p-key-rec     as character no-undo.
      398     do
      399     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      400     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      401     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      402     :
      403       define variable fh               as handle    no-undo .
      404       define variable v-ok             as logical   no-undo .
      405       define variable v-inform         as character no-undo .
      406       define variable v-ind            as integer   no-undo .
      407       define variable v-idx-field-qnty as integer   no-undo .
      408       if p-tbl-name = ?
      409         or p-tbl-name = "":U
      410       then do:
      411         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info2 ).
      412       end.
      413       if not p-bh_tbl-name:available then do:
      414         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info2, p-tbl-name ).
      415       end.
      416       assign
      417         p-key-rec = p-tbl-name
      418         v-inform  = p-bh_tbl-name:index-information(1)
      419         v-ind     = 2
      420       .
      421       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      422       on error undo, return error
      423       :
      424         assign
      425           v-inform = p-bh_tbl-name:index-information( v-ind )
      426           v-ind    = v-ind + 1
      427         .
      428       end.
      429       if v-inform = ?
      430         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      431         or entry( 3, v-inform, ",":U ) <> "1":U
      432       then do:
      433         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info2, p-tbl-name ).
      434       end.
      435       else do:
      436         assign
      437           v-idx-field-qnty = num-entries( v-inform ) - 4
      438         .
      439         if v-idx-field-qnty < 2 then do:
      440           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info2, v-inform, p-tbl-name ).
      441         end.
      442         do v-ind = 1 to v-idx-field-qnty by 2
      443         on error undo, return error
      444         :
      445           assign
      446             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      447             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      448           .
      449         end.
      450       end.
      451       if p-key-rec = ? then do:
      452         assign
      453           p-key-rec = "":U
      454         .
      455         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info2, p-tbl-name ).
      456       end.
      457     end.
      458     return.
      459   end procedure.
      460   procedure gen-where-keyr-tab :
      461     define input  parameter i-tableSerach as character no-undo.
      462     define input  parameter i-tablekey   as character  no-undo.
      463     define input  parameter p-key-rec    as character  no-undo.
      464     define input  parameter p-key-handle as handle     no-undo .
      465     define input  parameter p-db-name    as character  no-undo .
      466     define input  parameter p-tt-handle  as handle     no-undo .
      467     define output parameter o-Where      as character  no-undo.
      468     do
      469     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      470     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      471     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      472     :
      473       define variable v-full-tbl-name  as character no-undo .
      474       define variable bh_tbl-name      as handle    no-undo .
      475       define variable fh_key           as handle    no-undo .
      476       define variable fh_search        as handle    no-undo .
      477       define variable v-field-num      as integer   no-undo .
      478       define variable v-count-fld      as integer   no-undo .
      479       define variable v-inform         as character no-undo .
      480       define variable v-ind            as integer   no-undo .
      481       define variable v-idx-field-qnty as integer   no-undo .
      482       define variable v-field-name     as character no-undo .
      483       define variable v-field-val      as character no-undo .
      484       define variable v-word-link      as character no-undo .
      485       define variable vTable           as character no-undo.
      486       define variable bh_tbl-key       as handle    no-undo .
      487       assign
      488         p-key-rec = trim( p-key-rec )
      489       .
      490       if p-key-handle <> ? then do:
      491         if not valid-handle(p-key-handle)
      492            or p-key-handle:type <> "buffer"
      493         then do:
      494           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info2 ).
      495         end.
      496         if num-entries( p-key-rec, chr(3) ) > 1
      497           or p-key-rec = ?
      498           or p-key-rec = "":U
      499         then do:
      500           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info2, p-key-rec ).
      501         end.
      502       end.
      503       else do:
      504         if p-key-rec = ?
      505           or p-key-rec = "":U
      506         then do:
      507           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info2 ).
      508         end.
      509       end.
      510       assign
      511         vTable = entry( 1 , p-key-rec, chr(3) )
      512       .
      513       if p-tt-handle <> ?
      514         and ( not valid-handle(p-tt-handle)
      515               or p-tt-handle:type <> "buffer"
      516             )
      517       then do:
      518         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info2, vTable, chr(10) ).
      519       end.
      520       if p-tt-handle = ? then do:
      521         assign
      522           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      523         .
      524         create buffer bh_tbl-name for table v-full-tbl-name .
      525       end.
      526       else do:
      527         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      528       end.
      529       assign
      530         v-inform = bh_tbl-name:index-information(1)
      531         v-ind    = 2
      532       .
      533       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      534       on error undo, return error
      535       :
      536         assign
      537           v-inform = bh_tbl-name:index-information( v-ind )
      538           v-ind    = v-ind + 1
      539         .
      540       end.
      541       if v-inform = ?
      542         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      543         or entry( 3, v-inform, ",":U ) <> "1":U
      544       then do:
      545         delete object bh_tbl-name no-error.
      546         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info2, vTable ).
      547       end.
      548       assign
      549         v-idx-field-qnty = num-entries( v-inform ) - 4
      550       .
      551       if v-idx-field-qnty < 2 then do:
      552         delete object bh_tbl-name no-error.
      553         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info2, v-inform, vTable ).
      554       end.
      555       assign
      556         o-where     = "where":U
      557         v-word-link = "":U
      558         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      559         v-count-fld = 0
      560       .
      561       if i-tablekey ne "" and i-tablekey ne ?
      562       then do:
      563         assign
      564           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      565         .
      566         create buffer bh_tbl-key for table v-full-tbl-name .
      567       end.
      568       if i-tableSerach ne "" and i-tableSerach ne ?
      569       then do:
      570         delete object bh_tbl-name no-error.
      571         assign
      572           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      573         .
      574         create buffer bh_tbl-name for table v-full-tbl-name .
      575       end.
      576       block_where:
      577       do v-ind = 1 to v-idx-field-qnty by 2
      578       on error undo, return error
      579       :
      580         assign
      581           v-count-fld = v-count-fld + 1
      582         .
      583         if p-key-handle = ?
      584           and v-count-fld > v-field-num
      585         then do:
      586           leave block_where.
      587         end.
      588         define variable VfieldKeyTable as handle no-undo.
      589         assign
      590           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      591           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      592         .
      593         if     bh_tbl-key ne ?
      594         then do:
      595            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      596            if VfieldKeyTable eq ?
      597            then next block_where.
      598         end.
      599         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      600         then
      601            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      602         else
      603            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      604         if p-key-handle = ? then do:
      605           assign
      606             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      607           .
      608         end.
      609         else do:
      610           assign
      611             fh_key = p-key-handle:buffer-field( v-field-name )
      612           .
      613           if fh_key = ?
      614             or not valid-handle( fh_key )
      615           then do:
      616             delete object bh_tbl-name.
      617             if     bh_tbl-key ne ?
      618             then
      619                delete object bh_tbl-key.
      620             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info2, p-key-handle:name, v-field-name ).
      621           end.
      622           assign
      623             v-field-val = fh_key:buffer-value
      624           .
      625         end.
      626         if fh_search:data-type ="character":U then do:
      627           assign
      628             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      629             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      630             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      631             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      632             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      633             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      634             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      635             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      636             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      637             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      638             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      639             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      640             v-field-val = substitute( '"&1"', v-field-val )
      641           .
      642         end.
      643         assign
      644           o-where = substitute( "&1 &2", o-where, v-field-val )
      645         .
      646         if v-word-link = "":U then do:
      647           assign
      648             v-word-link = "and":U
      649           .
      650         end.
      651       end.
      652       delete object bh_tbl-name.
      653       if     bh_tbl-key ne ?
      654       then
      655          delete object bh_tbl-key.
      656       if p-key-handle = ?
      657         and v-count-fld <> v-field-num
      658       then do:
      659         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info2, vTable ).
      660       end.
      661     end.
      662   end procedure.
      663   procedure gen-hn-keyr-tab :
      664     define input  parameter i-tableSerach as character no-undo.
      665     define input  parameter i-tablekey   as character no-undo.
      666     define input  parameter p-key-rec    as character no-undo.
      667     define input  parameter p-key-handle as handle    no-undo .
      668     define input  parameter p-db-name    as character no-undo .
      669     define input  parameter p-tt-handle  as handle    no-undo .
      670     define input  parameter p-stts-lock  as integer   no-undo .
      671     define output parameter o-hn         as handle    no-undo.
      672     define variable v-full-tbl-name as character no-undo.
      673     define variable v-where         as character no-undo.
      674     define variable bh_tbl-name     as handle    no-undo.
      675     define variable vTable          as character no-undo.
      676     do
      677     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      678     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      679     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      680         run gen-where-keyr-tab(i-tableSerach,
      681                                i-tablekey,
      682                                p-key-rec,
      683                                p-key-handle,
      684                                p-db-name,
      685                                p-tt-handle,
      686                                output v-where).
      687         if i-tableSerach ne "" and i-tableSerach ne ?
      688         then do:
      689            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      690            create buffer bh_tbl-name for table v-full-tbl-name .
      691         end.
      692         else do:
      693            if p-tt-handle = ? then do:
      694               assign
      695                  vTable = entry( 1 , p-key-rec, chr(3) )
      696               .
      697               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      698               create buffer bh_tbl-name for table v-full-tbl-name .
      699            end.
      700            else do:
      701               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      702            end.
      703         end.
      704         if p-tt-handle = ? then do:
      705            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      706         end.
      707         else do:
      708            bh_tbl-name:find-first( v-where ) no-error .
      709         end.
      710         o-hn = bh_tbl-name.
      711      end.
      712   end procedure.
      713   procedure gen-hn-keyr :
      714     define input  parameter p-key-rec    as character no-undo.
      715     define input  parameter p-key-handle as handle    no-undo .
      716     define input  parameter p-db-name    as character no-undo .
      717     define input  parameter p-tt-handle  as handle    no-undo .
      718     define input  parameter p-stts-lock  as integer   no-undo .
      719     define output parameter o-hn         as handle    no-undo.
      720     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      721   end.
      722   procedure gen-row-keyr :
      723     define input  parameter p-key-rec    as character no-undo.
      724     define input  parameter p-key-handle as handle    no-undo .
      725     define input  parameter p-db-name    as character no-undo .
      726     define input  parameter p-tt-handle  as handle    no-undo .
      727     define input  parameter p-stts-lock  as integer   no-undo .
      728     define output parameter p-tbl-row    as rowid     no-undo.
      729     define output parameter p-tbl-name   as character no-undo.
      730     define variable vHn as handle no-undo.
      731       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      732       p-tbl-row = if vHn:available then vHn:rowid else ?.
      733       p-tbl-name =  vHn:table.
      734       delete object vHn no-error.
      735     if p-tbl-row = ? then do:
      736       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info2, p-tbl-name, p-key-rec ).
      737     end.
      738     else do:
      739       return.
      740     end.
      741   end procedure.
      742   procedure gen-key-fv :
      743     define input  parameter p-key-rec    as character no-undo .
      744     define output parameter p-field-list as character no-undo .
      745     define output parameter p-value-list as character no-undo.
      746     do
      747     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      748     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      749     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      750     :
      751       define variable v-full-tbl-name  as character no-undo .
      752       define variable bh_tbl-name      as handle    no-undo .
      753       define variable v-tbl-name       as character no-undo .
      754       define variable v-field-num      as integer   no-undo .
      755       define variable v-count-fld      as integer   no-undo .
      756       define variable v-inform         as character no-undo .
      757       define variable v-ind            as integer   no-undo .
      758       define variable v-idx-field-qnty as integer   no-undo .
      759       define variable v-delim-key      as character no-undo .
      760       if p-key-rec = ?
      761         or p-key-rec = "":U
      762       then do:
      763         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info2 ).
      764       end.
      765       assign
      766         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      767         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      768       .
      769       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      770       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info2 ).
      771       assign
      772         v-inform = bh_tbl-name:index-information(1)
      773         v-ind    = 2
      774       .
      775       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      776       on error undo, return error
      777       :
      778         assign
      779           v-inform = bh_tbl-name:index-information( v-ind )
      780           v-ind    = v-ind + 1
      781         .
      782       end.
      783       if v-inform = ?
      784         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      785         or entry( 3, v-inform, ",":U ) <> "1":U
      786       then do:
      787         delete object bh_tbl-name no-error.
      788         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info2, v-tbl-name ).
      789       end.
      790       assign
      791         v-idx-field-qnty = num-entries( v-inform ) - 4
      792       .
      793       if v-idx-field-qnty < 2 then do:
      794         delete object bh_tbl-name no-error.
      795         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info2, v-inform, v-tbl-name ).
      796       end.
      797       assign
      798         p-field-list = "":U
      799         p-value-list = "":U
      800         v-delim-key  = "":U
      801         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      802         v-count-fld  = 0
      803       .
      804       block_where:
      805       do v-ind = 1 to v-idx-field-qnty by 2
      806       on error undo, return error
      807       :
      808         assign
      809           v-count-fld = v-count-fld + 1
      810         .
      811         if v-count-fld > v-field-num then do:
      812           leave block_where.
      813         end.
      814         assign
      815           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      816           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      817         .
      818         if v-ind = 1 then do:
      819           assign
      820             v-delim-key = chr(3)
      821           .
      822         end.
      823       end.
      824       delete object bh_tbl-name.
      825       if v-count-fld <> v-field-num then do:
      826         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info2, v-tbl-name ).
      827       end.
      828     end.
      829   end procedure.
      830   procedure gen-key-field :
      831     define input  parameter p-table      as character no-undo .
      832     define output parameter p-field-list as character no-undo .
      833     do
      834     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      835     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      836     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      837     :
      838       define variable v-full-tbl-name  as character no-undo .
      839       define variable bh_tbl-name      as handle    no-undo .
      840       define variable v-tbl-name       as character no-undo .
      841       define variable v-field-num      as integer   no-undo .
      842       define variable v-count-fld      as integer   no-undo .
      843       define variable v-inform         as character no-undo .
      844       define variable v-ind            as integer   no-undo .
      845       define variable v-idx-field-qnty as integer   no-undo .
      846       define variable v-delim-key      as character no-undo .
      847       if p-table = ?
      848         or p-table = "":U
      849       then do:
      850         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info2 ).
      851       end.
      852       assign
      853         v-tbl-name      = p-table
      854         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      855       .
      856       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      857       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info2 ).
      858       assign
      859         v-inform = bh_tbl-name:index-information(1)
      860         v-ind    = 2
      861       .
      862       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      863       on error undo, return error
      864       :
      865         assign
      866           v-inform = bh_tbl-name:index-information( v-ind )
      867           v-ind    = v-ind + 1
      868         .
      869       end.
      870       if v-inform = ?
      871         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      872         or entry( 3, v-inform, ",":U ) <> "1":U
      873       then do:
      874         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info2, v-tbl-name ).
      875       end.
      876       assign
      877         v-idx-field-qnty = num-entries( v-inform ) - 4
      878       .
      879       if v-idx-field-qnty < 2 then do:
      880         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info2, v-inform, v-tbl-name ).
      881       end.
      882       assign
      883         p-field-list = "":U
      884         v-delim-key  = "":U
      885         v-count-fld  = 0
      886       .
      887       block_where:
      888       do v-ind = 1 to v-idx-field-qnty by 2
      889       on error undo, return error
      890       :
      891         assign
      892           v-count-fld = v-count-fld + 1
      893         .
      894         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      895         if v-ind = 1 then do:
      896           assign
      897             v-delim-key = chr(3)
      898           .
      899         end.
      900       end.
      901       delete object bh_tbl-name.
      902     end.
      903   end procedure.
      904   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      905   define SHARED temp-table temp-labels no-undo
      906   field f_name as character
      907   field l_name as character
      908   field v_old as character
      909   field v_new as character
      910   field t_name as character
      911   field num_ as integer
      912   field uniq-key-rec as character
      913   field action as integer
      914   field fNotChange as logical
      915   field f_update as logical
      916   field f_can_update as logical
      917   field f_parent as character
      918   field f_visible as logical
      919   field f_root as character
      920   index iu f_update
      921   index ivisible  f_visible
      922   index iparent f_root f_parent
      923   index pi is unique primary
      924   num_
      925   t_name
      926   f_name
      927   index
      928   Chan
      929   fnotChange
      930   t_name
      931   f_name
      932   index imain uniq-key-rec
      933   .
      934   FUNCTION get-all-fields returns character (p-file-name as character ):
      935   define variable v-dop as character no-undo .
      936     find first _file no-lock where _file._file-name = p-file-name no-error .
      937     if not available _file then return "":U.
      938     for each _field no-lock where
      939              _field._file-recid = recid(_file) :
      940       assign
      941       v-dop = v-dop + _field._field-name + chr(44)
      942       .
      943     end.
      944     return trim(v-dop).
      945   END FUNCTION.
      946   procedure tempchgs-create-lable-record :
      947   define input parameter p-t_name as character no-undo .
      948   define input parameter p-f_name as character no-undo .
      949   define input parameter p-l_name as character no-undo .
      950   define input parameter p-f_update as logical no-undo .
      951   define input parameter p-f_parent as character no-undo .
      952   define input parameter p-f_visible as logical no-undo .
      953   define buffer buf_temp-labels for temp-labels.
      954     do
      955     on error undo, return error
      956     :
      957        find first buf_temp-labels where
      958                 buf_temp-labels.t_name = p-t_name
      959             and buf_temp-labels.f_name = p-f_name no-error.
      960        if not available buf_temp-labels then do:
      961         create buf_temp-labels.
      962         assign
      963         buf_temp-labels.t_name = p-t_name
      964         buf_temp-labels.f_name = p-f_name
      965         buf_temp-labels.l_name = p-l_name
      966         .
      967        end.
      968        assign
      969        buf_temp-labels.f_can_update = p-f_update
      970        buf_temp-labels.f_parent = p-f_parent
      971        buf_temp-labels.f_visible = p-f_visible
      972        buf_temp-labels.f_root = (if p-f_parent = '':U then p-f_name else p-f_parent)
      973        buf_temp-labels.num_ = 0
      974        .
      975     end.
      976   end procedure.
      977   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      978   define   temp-table temp-changes no-undo
      979   field f_name as character
      980   field l_name as character
      981   field v_old as character
      982   field v_new as character
      983   field t_name as character
      984   field num_ as integer
      985   field uniq-key-rec as character
      986   field action as integer
      987   field fNotChange as logical
      988   field f_update as logical
      989   field f_can_update as logical
      990   field f_parent as character
      991   field f_visible as logical
      992   field f_root as character
      993   index iu f_update
      994   index ivisible  f_visible
      995   index iparent f_root f_parent
      996   index pi is unique primary
      997   num_
      998   t_name
      999   f_name
     1000   index
     1001   Chan
     1002   fnotChange
     1003   t_name
     1004   f_name
     1005   index imain uniq-key-rec
     1006   .
     1007   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1008   procedure tempchgs-check-child-label-record :
     1009   define buffer buf_temp-changes for temp-changes.
     1010   define buffer buf_child_temp-changes for temp-changes.
     1011   define buffer buf_temp-labels for temp-labels.
     1012     do
     1013     on error undo, return error
     1014     :
     1015       for each buf_child_temp-changes
     1016       break
     1017       by buf_child_temp-changes.f_parent:
     1018         if buf_child_temp-changes.f_parent = '':u then next.
     1019         find first buf_temp-changes where
     1020                   buf_temp-changes.f_name = buf_child_temp-changes.f_parent no-error.
     1021         if available buf_temp-changes then do:
     1022           assign
     1023           buf_child_temp-changes.f_can_update = no
     1024           buf_child_temp-changes.l_name = fill( chr(32), 3) + buf_child_temp-changes.l_name
     1025           .
     1026           find first buf_temp-labels where
     1027                     buf_temp-labels.f_name = buf_child_temp-changes.f_name.
     1028           assign
     1029           buf_temp-labels.f_update = no.
     1030         end.
     1031       end.
     1032     end.
     1033   end procedure.
     1034   DEFINE VARIABLE hndlCellf_update AS WIDGET-HANDLE NO-UNDO.
     1035   DEFINE VARIABLE v-first-bh AS HANDLE NO-UNDO.
     1036   DEFINE VARIABLE v-next-bh AS HANDLE NO-UNDO.
     1037   DEFINE BUTTON B-exit AUTO-GO
     1038        LABEL "&Ввод"
     1039        SIZE 10 BY 1
     1040        BGCOLOR 8 .
     1041   DEFINE BUTTON B-Help
     1042        LABEL "Помо&щь"
     1043        SIZE 3 BY 1
     1044        BGCOLOR 8 .
     1045   DEFINE BUTTON B-mark
     1046        LABEL "*"
     1047        SIZE 3 BY 1.
     1048   DEFINE BUTTON b-quit AUTO-END-KEY
     1049        LABEL "&Отмена"
     1050        SIZE 10 BY 1
     1051        BGCOLOR 8 .
     1052   DEFINE VARIABLE ED-notes AS CHARACTER
     1053        VIEW-AS EDITOR SCROLLBAR-VERTICAL
     1054        SIZE 98 BY 2.77 NO-UNDO.
     1055   DEFINE QUERY BR-changes FOR
     1056         temp-changes SCROLLING.
     1057   DEFINE BROWSE BR-changes
     1058     QUERY BR-changes DISPLAY
     1059         temp-changes.l_name COLUMn-LABEL "Поле" format "X(35)"
     1060   temp-changes.f_update COLUMn-LABEL "Изменить" FORMAT "Да/Нет" WIDTH 11
     1061   temp-changes.f_can_update COLUMn-LABEL "Можно!Изменить" FORMAT "Да/Нет" WIDTH 11
     1062   temp-changes.v_old COLUMn-LABEL "Было" format "X(255)"
     1063   temp-changes.v_new COLUMn-LABEL "Стало" format "X(255)"
     1064       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 14.73.
     1065   DEFINE FRAME REDDialog-Frame
     1066        B-exit AT ROW 1 COL 1
     1067        b-quit AT ROW 1 COL 11
     1068        B-mark AT ROW 1 COL 31
     1069        B-Help AT ROW 1 COL 95
     1070        ED-notes AT ROW 2.13 COL 1 NO-LABEL
     1071        BR-changes AT ROW 5 COL 1
     1072        SPACE(0.29) SKIP(0.00)
     1073       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1074            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1075            TITLE ""
     1076            DEFAULT-BUTTON B-exit CANCEL-BUTTON b-quit.
     1077   ASSIGN
     1078          FRAME REDDialog-Frame:SCROLLABLE       = FALSE
     1079          FRAME REDDialog-Frame:HIDDEN           = TRUE.
     1080   ASSIGN
     1081          ED-notes:READ-ONLY IN FRAME REDDialog-Frame        = TRUE.
     1082   ON WINDOW-CLOSE OF FRAME REDDialog-Frame
     1083   DO:
     1084     APPLY "END-ERROR":U TO SELF.
     1085   END.
     1086   ON CHOOSE OF B-exit IN FRAME REDDialog-Frame
     1087   DO:
     1088     RUN proc-save IN THIS-PROCEDURE NO-ERROR.
     1089     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1090   END.
     1091   ON CHOOSE OF B-mark IN FRAME REDDialog-Frame
     1092   DO:
     1093       RUN proc-b-mark IN THIS-PROCEDURE NO-ERROR.
     1094       IF ERROR-STATUS:ERROR  THEN RETURN NO-APPLY.
     1095   END.
     1096   ON MOUSE-SELECT-DBLCLICK OF BR-changes IN FRAME REDDialog-Frame
     1097   DO:
     1098      RUN proc-b-mark IN THIS-PROCEDURE NO-ERROR.
     1099       IF ERROR-STATUS:ERROR  THEN RETURN NO-APPLY.
     1100   END.
     1101   ON ROW-DISPLAY OF BR-changes IN FRAME REDDialog-Frame
     1102   DO:
     1103    DO WITH FRAME REDDialog-Frame:
     1104     IF Temp-changes.f_can_update THEN
     1105        ASSIGN Temp-changes.f_update:FGCOLOR IN BROWSE br-changes = BROWN_COLOR
     1106               Temp-changes.f_update:BGCOLOR IN BROWSE br-changes = ?.
     1107     ELSE
     1108         ASSIGN Temp-changes.f_update:FGCOLOR IN BROWSE br-changes = 0
     1109                Temp-changes.f_update:BGCOLOR IN BROWSE br-changes = GREY_COLOR.
     1110     IF Temp-changes.f_can_update = no
     1111     and Temp-changes.f_parent <> '' then do:
     1112        ASSIGN Temp-changes.l_name:FGCOLOR IN BROWSE br-changes = GREY_COLOR.
     1113     end.
     1114     else do:
     1115        ASSIGN Temp-changes.l_name:FGCOLOR IN BROWSE br-changes = 0.
     1116     end.
     1117   END.
     1118   END.
     1119   ON VALUE-CHANGED OF BR-changes IN FRAME REDDialog-Frame
     1120   DO:
     1121     DO WITH FRAME REDDialog-Frame:
     1122       IF AVAILABLE temp-changes THEN DO:
     1123           IF temp-changes.f_can_update = YES THEN
     1124           ASSIGN
     1125           b-mark:sensitive IN FRAME REDDialog-Frame = YES.
     1126           ELSE
     1127           ASSIGN
     1128           b-mark:sensitive IN FRAME REDDialog-Frame = no.
     1129       END.
     1130       ELSE DO:
     1131       END.
     1132     END.
     1133   END.
     1134   ON ROW-DISPLAY OF br-changes IN frame REDDialog-Frame
     1135   DO:
     1136     RUN set-row-color IN this-procedure  ( INPUT temp-changes.v_old, INPUT temp-changes.v_new).
     1137   END.
     1138   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME REDDialog-Frame:PARENT eq ?
     1139   THEN FRAME REDDialog-Frame:PARENT = ACTIVE-WINDOW.
     1140   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1141   on help of frame REDDialog-Frame
     1142   do:
     1143     run gbl/app_help.p
     1144       (input this-procedure :file-name
     1145       ,input ''
     1146       ,input ?
     1147       ) no-error.
     1148     if error-status :error then do:
     1149       message
     1150         "Ошибка при вызове помощи"
     1151         error-status :get-message(1)
     1152         view-as alert-box .
     1153     end.
     1154   end.
     1155   run minbtn-set in this-procedure .
     1156   on choose of b-help in frame REDDialog-Frame
     1157   do:
     1158     apply "help":u to frame REDDialog-Frame .
     1159   end.
     1160   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1161   procedure minbtn-set :
     1162       do
     1163           on error undo, return error return-value
     1164           :
     1165           define variable ii              as integer       no-undo .
     1166           define variable fh              as widget-handle no-undo .
     1167           define variable hh              as widget-handle no-undo .
     1168           define variable v-h             as handle        extent 4 no-undo .
     1169           define variable v-name-button   as character     no-undo .
     1170           define variable v-help-old-x    as decimal       no-undo .
     1171           define variable v-help-old-y    as decimal       no-undo .
     1172           define variable v-help-old-size as decimal       no-undo .
     1173           define variable v-frame-width   as decimal       no-undo .
     1174           define variable jj              as integer       no-undo .
     1175           do
     1176               on error undo, return error
     1177               :
     1178               assign
     1179                   v-frame-width = frame REDDialog-Frame:width - 0.3
     1180                   fh            = frame REDDialog-Frame:first-child
     1181                   hh            = fh:first-child
     1182                   ii            = 1
     1183                   .
     1184               do while valid-handle(hh):
     1185                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1186                   do:
     1187                       case lc(hh:name) :
     1188                           when "b-help" then
     1189                               do:
     1190                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1191                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1192                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1193                                   hh:TOOLTIP = "Помощь" .
     1194                                   v-help-old-x = hh:column .
     1195                                   v-help-old-y = hh:row    .
     1196                                   v-help-old-size = hh:width .
     1197                                   hh:width-chars = 2.5 .
     1198                               end.
     1199                           when "b-print" then
     1200                               do:
     1201                                   hh:load-image("cmp/b-print.bmp":u) .
     1202                                   hh:TOOLTIP = "Печать" .
     1203                                   v-h[ii] = hh:handle .
     1204                                   ii = ii + 1 .
     1205                                   hh:width-chars = 3 .
     1206                               end.
     1207                           when "b-history" or
     1208                           when "b-hist" then
     1209                               do:
     1210                                   hh:load-image("cmp/b-hist.bmp":u) .
     1211                                   hh:TOOLTIP = "История" .
     1212                                   v-h[ii] = hh:handle .
     1213                                   ii = ii + 1 .
     1214                                   hh:width-chars = 3 .
     1215                               end.
     1216                           when "b-sch" then
     1217                               do:
     1218                                   hh:load-image("cmp/b-sch.bmp":u) .
     1219                                   hh:TOOLTIP = "Установка Фильтра" .
     1220                                   v-h[ii] = hh:handle .
     1221                                   ii = ii + 1 .
     1222                                   hh:width-chars = 3 .
     1223                               end.
     1224                           when "b-hist-user" then
     1225                               do:
     1226                                   hh:load-image("cmp/b-hist.bmp":u) .
     1227                                   hh:TOOLTIP = "История пользователя" .
     1228                                   ii = ii + 1 .
     1229                               end.
     1230                       end case.
     1231                   end.
     1232                   hh = hh:next-sibling.
     1233               end.
     1234               b-help:column = v-frame-width - b-help:width-chars.
     1235               jj = 0.
     1236               repeat ii = 4 to 1 by -1 :
     1237                   if valid-handle (v-h[ii] ) then
     1238                   do:
     1239                       jj  = jj + 1 .
     1240                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1241                       v-h[ii]:row    = v-help-old-y .
     1242                   end.
     1243               end.
     1244           end.
     1245       end.
     1246   end procedure.
     1247   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1248   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1249   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1250   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1251   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1252   define variable v-diasize-current-frame-height as decimal   no-undo .
     1253   define variable v-diasize-change-size          as logical   no-undo .
     1254   define variable v-diasize-resize-button        as handle    no-undo .
     1255   define variable v-diasize-wndmax               as logical   no-undo .
     1256   define variable v-diasize-wndstore             as logical   no-undo .
     1257   define variable v-diasize-proc-name            as character no-undo .
     1258   define variable v-diasize-browse-handle        as handle    no-undo .
     1259   define variable v-diasize-browse-number        as integer   no-undo .
     1260   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1261   define temp-table temp-diasize-handle no-undo
     1262     field handle-value  as handle
     1263     field save-position as decimal
     1264     index xpk is primary unique handle-value
     1265     .
     1266   define temp-table temp-browse-handle no-undo
     1267     field browse-type   as character
     1268     field browse-number as integer
     1269     field browse-handle as handle
     1270     field original-size as decimal
     1271     index xpk is primary unique browse-type browse-number
     1272     index xie browse-type browse-handle
     1273   .
     1274   procedure diasize_change-height :
     1275     define input  parameter p-change-value  as decimal   no-undo .
     1276     define input  parameter p-move-resize   as logical   no-undo .
     1277     define variable v-field-group-handle    as handle    no-undo .
     1278     define variable v-object-handle         as handle    no-undo .
     1279     define variable v-frame-height          as decimal   no-undo .
     1280     define variable v-frame-virtual-height  as decimal   no-undo .
     1281     define variable v-browse-height         as decimal   no-undo .
     1282     define variable v-window-height         as decimal   no-undo .
     1283     define variable v-window-virtual-height as decimal   no-undo .
     1284     define variable v-change-sign           as integer   no-undo .
     1285     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1286     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1287     if p-change-value > 0
     1288     then do:
     1289       if frame REDDialog-Frame :height + p-change-value
     1290           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1291       then do:
     1292         assign
     1293           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1294                           - (frame REDDialog-Frame :height-chars)
     1295         .
     1296         if p-change-value <= 0
     1297         then do:
     1298           run diasize_position-resize-button in this-procedure .
     1299           return .
     1300         end.
     1301       end.
     1302     end.
     1303     if p-change-value < 0
     1304     then do:
     1305       if frame REDDialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1306       then do:
     1307         assign
     1308           p-change-value = v-diasize-orig-frame-height
     1309                          - (frame REDDialog-Frame :height-chars)
     1310         .
     1311         if p-change-value >= 0
     1312         then do:
     1313           run diasize_position-resize-button in this-procedure .
     1314           return .
     1315         end.
     1316       end.
     1317     end.
     1318     if p-change-value >= 0
     1319     then do:
     1320       assign
     1321         v-change-sign = 1
     1322       .
     1323     end.
     1324     else do:
     1325       assign
     1326         v-change-sign = -1
     1327       .
     1328     end.
     1329     assign
     1330       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1331     .
     1332     if p-change-value = 0
     1333     then do:
     1334       run diasize_position-resize-button in this-procedure .
     1335       return .
     1336     end.
     1337     move_block:
     1338     do
     1339     on error undo move_block, retry move_block
     1340     :
     1341       if retry
     1342       then do:
     1343         do
     1344         on error undo move_block, leave move_block
     1345         :
     1346           if p-change-value > 0
     1347           then do:
     1348             for each buf_temp-diasize-handle
     1349             on error undo, next
     1350             :
     1351               assign
     1352                 v-object-handle = buf_temp-diasize-handle.handle-value
     1353               .
     1354               if v-object-handle <> v-diasize-resize-button
     1355               then do:
     1356                 assign
     1357                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1358                 .
     1359               end.
     1360             end.
     1361             assign
     1362               v-diasize-browse-handle :height = v-browse-height
     1363             .
     1364             for each buf_temp-browse-handle
     1365               where buf_temp-browse-handle.browse-type = 'height':u
     1366             on error undo, next
     1367             :
     1368               assign
     1369                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1370               .
     1371             end.
     1372             assign
     1373               frame REDDialog-Frame :height = v-frame-height
     1374             .
     1375             if frame REDDialog-Frame :scrollable = true
     1376             then do:
     1377               assign
     1378                 frame REDDialog-Frame :virtual-height = v-frame-virtual-height
     1379               .
     1380             end.
     1381             run diasize_position-resize-button in this-procedure .
     1382           end.
     1383           else do:
     1384             if frame REDDialog-Frame :scrollable = true
     1385             then do:
     1386               assign
     1387                 frame REDDialog-Frame :virtual-height = v-frame-virtual-height
     1388               .
     1389             end.
     1390             assign
     1391               frame REDDialog-Frame :height = v-frame-height
     1392             .
     1393             assign
     1394               v-diasize-browse-handle :height = v-browse-height
     1395             .
     1396             for each buf_temp-browse-handle
     1397               where buf_temp-browse-handle.browse-type = 'height':u
     1398             on error undo, next
     1399             :
     1400               assign
     1401                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1402               .
     1403             end.
     1404             for each buf_temp-diasize-handle
     1405             on error undo, next
     1406             :
     1407               assign
     1408                 v-object-handle = buf_temp-diasize-handle.handle-value
     1409               .
     1410               if v-object-handle <> v-diasize-resize-button
     1411               then do:
     1412                 assign
     1413                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1414                 .
     1415               end.
     1416             end.
     1417             run diasize_position-resize-button in this-procedure .
     1418           end.
     1419           assign
     1420             v-diasize-change-size = false
     1421           .
     1422           leave move_block .
     1423         end.
     1424       end.
     1425       assign
     1426         v-diasize-need-full-display = true
     1427       .
     1428       if v-diasize-change-size = false
     1429       then do:
     1430         assign
     1431           v-diasize-change-size = true
     1432         .
     1433       end.
     1434       else do:
     1435         return .
     1436       end.
     1437       assign
     1438         v-frame-height = frame REDDialog-Frame :height
     1439         v-frame-virtual-height = frame REDDialog-Frame :virtual-height
     1440         v-browse-height = v-diasize-browse-handle :height
     1441       .
     1442       for each buf_temp-browse-handle
     1443         where buf_temp-browse-handle.browse-type = 'height':u
     1444       :
     1445         assign
     1446           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1447         .
     1448       end.
     1449       for each buf_temp-diasize-handle
     1450       :
     1451         delete buf_temp-diasize-handle .
     1452       end.
     1453       assign
     1454         v-field-group-handle = frame REDDialog-Frame :first-child
     1455       .
     1456       do while valid-handle(v-field-group-handle)
     1457       :
     1458         assign
     1459           v-object-handle = v-field-group-handle :first-child
     1460         .
     1461         do while valid-handle(v-object-handle)
     1462         :
     1463           if  v-object-handle <> v-diasize-browse-handle :handle
     1464           and can-query(v-object-handle, "row")
     1465           and can-query(v-object-handle, "height")
     1466           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1467           then do:
     1468             find first buf_temp-browse-handle
     1469               where buf_temp-browse-handle.browse-type   = 'height':u
     1470                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1471               no-error .
     1472             if available buf_temp-browse-handle
     1473             then do:
     1474             end.
     1475             else do:
     1476               create buf_temp-diasize-handle .
     1477               assign
     1478                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1479                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1480               .
     1481             end.
     1482           end.
     1483           assign
     1484             v-object-handle = v-object-handle :next-sibling
     1485           .
     1486         end.
     1487         assign
     1488           v-field-group-handle = v-field-group-handle :next-sibling
     1489         .
     1490       end.
     1491       do with frame REDDialog-Frame
     1492       :
     1493         hide v-diasize-resize-button .
     1494         assign
     1495           v-diasize-resize-button :row    = 1
     1496           v-diasize-resize-button :column = 1
     1497         .
     1498       end.
     1499       if p-change-value > 0
     1500       then do:
     1501         if frame REDDialog-Frame :scrollable = true
     1502         then do:
     1503           assign
     1504             frame REDDialog-Frame :virtual-height = frame REDDialog-Frame :virtual-height + p-change-value
     1505             no-error .
     1506           if error-status :error
     1507           or error-status :get-message(1) <> ""
     1508           then do:
     1509             undo move_block, retry move_block .
     1510           end.
     1511         end.
     1512         assign
     1513           frame REDDialog-Frame :height = frame REDDialog-Frame :height + p-change-value
     1514           no-error .
     1515         if error-status :error
     1516         or error-status :get-message(1) <> ""
     1517         then do:
     1518           undo move_block, retry move_block .
     1519         end.
     1520         assign
     1521           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1522           no-error .
     1523         if error-status :error
     1524         or error-status :get-message(1) <> ""
     1525         then do:
     1526           undo move_block, retry move_block .
     1527         end.
     1528         for each buf_temp-browse-handle
     1529           where buf_temp-browse-handle.browse-type = 'height':u
     1530         on error undo move_block, retry move_block
     1531         :
     1532           assign
     1533             buf_temp-browse-handle.browse-handle :height
     1534               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1535             no-error .
     1536           if error-status :error
     1537           or error-status :get-message(1) <> ""
     1538           then do:
     1539             undo move_block, retry move_block .
     1540           end.
     1541         end.
     1542         for each buf_temp-diasize-handle
     1543         on error undo move_block, retry move_block
     1544         :
     1545           assign
     1546             v-object-handle = buf_temp-diasize-handle.handle-value
     1547           .
     1548           if v-object-handle <> v-diasize-resize-button
     1549           then do:
     1550             assign
     1551               v-object-handle :row = v-object-handle :row + p-change-value
     1552               no-error .
     1553             if error-status :error
     1554             or error-status :get-message(1) <> ""
     1555             then do:
     1556               undo move_block, retry move_block .
     1557             end.
     1558           end.
     1559         end.
     1560       end.
     1561       else do:
     1562         for each buf_temp-diasize-handle
     1563         on error undo move_block, retry move_block
     1564         :
     1565           assign
     1566             v-object-handle = buf_temp-diasize-handle.handle-value
     1567           .
     1568           if v-object-handle <> v-diasize-resize-button
     1569           then do:
     1570             assign
     1571               v-object-handle :row = v-object-handle :row + p-change-value
     1572               no-error .
     1573             if error-status :error
     1574             or error-status :get-message(1) <> ""
     1575             then do:
     1576               undo move_block, retry move_block .
     1577             end.
     1578           end.
     1579         end.
     1580         assign
     1581           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1582           no-error .
     1583         if error-status :error
     1584         or error-status :get-message(1) <> ""
     1585         then do:
     1586           undo move_block, retry move_block .
     1587         end.
     1588         for each buf_temp-browse-handle
     1589           where buf_temp-browse-handle.browse-type = 'height':u
     1590         on error undo move_block, retry move_block
     1591         :
     1592           assign
     1593             buf_temp-browse-handle.browse-handle :height
     1594               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1595             no-error .
     1596           if error-status :error
     1597           or error-status :get-message(1) <> ""
     1598           then do:
     1599             undo move_block, retry move_block .
     1600           end.
     1601         end.
     1602         assign
     1603           frame REDDialog-Frame :height = frame REDDialog-Frame :height + p-change-value
     1604           no-error .
     1605         if error-status :error
     1606         or error-status :get-message(1) <> ""
     1607         then do:
     1608           undo move_block, retry move_block .
     1609         end.
     1610         if frame REDDialog-Frame :scrollable = true
     1611         then do:
     1612           assign
     1613             frame REDDialog-Frame :virtual-height = frame REDDialog-Frame :virtual-height + p-change-value
     1614             no-error .
     1615           if error-status :error
     1616           or error-status :get-message(1) <> ""
     1617           then do:
     1618             undo move_block, retry move_block .
     1619           end.
     1620         end.
     1621       end.
     1622       if p-move-resize = true
     1623       then do:
     1624         run diasize_position-resize-button in this-procedure .
     1625       end.
     1626       if v-diasize-wndstore = true
     1627       then do:
     1628         if connected("ub") = true
     1629         then do:
     1630           define variable v-cntxt-db-num        as integer   no-undo .
     1631           define variable v-cntxt-userid        as character no-undo .
     1632           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1633                                             , OUTPUT v-cntxt-userid
     1634                                             ) .
     1635           run gbl/wndsizew.p
     1636             (input  v-cntxt-db-num
     1637             ,input  v-cntxt-userid
     1638             ,input  v-diasize-proc-name
     1639             ,input  'height':u
     1640             ,input  string(frame REDDialog-Frame :height - v-diasize-orig-frame-height)
     1641             ) .
     1642         end.
     1643       end.
     1644     end.
     1645     assign
     1646       v-diasize-change-size = false
     1647     .
     1648   end procedure.
     1649   procedure diasize_set-height :
     1650     define input  parameter p-new-height  as decimal   no-undo .
     1651     define input  parameter p-move-resize as logical   no-undo .
     1652     do
     1653     on error undo, return error return-value
     1654     :
     1655       run diasize_change-height in this-procedure
     1656         (input  (p-new-height - frame REDDialog-Frame :height)
     1657         ,input  p-move-resize
     1658         ) .
     1659     end.
     1660   end procedure.
     1661   procedure diasize_change-width :
     1662     define input  parameter p-change-value as decimal   no-undo .
     1663     define input  parameter p-move-resize  as logical   no-undo .
     1664     define variable v-field-group-handle   as handle    no-undo .
     1665     define variable v-object-handle        as handle    no-undo .
     1666     define variable v-frame-width          as decimal   no-undo .
     1667     define variable v-frame-virtual-width  as decimal   no-undo .
     1668     define variable v-browse-width         as decimal   no-undo .
     1669     define variable v-window-width         as decimal   no-undo .
     1670     define variable v-window-virtual-width as decimal   no-undo .
     1671     define variable v-change-sign          as integer   no-undo .
     1672     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1673     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1674     if p-change-value > 0
     1675     then do:
     1676       if frame REDDialog-Frame :width + p-change-value >
     1677           session :width-chars
     1678       then do:
     1679         assign
     1680           p-change-value = session :width-chars - frame REDDialog-Frame :width
     1681         .
     1682         if p-change-value <= 0
     1683         then do:
     1684           run diasize_position-resize-button in this-procedure .
     1685           return .
     1686         end.
     1687       end.
     1688     end.
     1689     if p-change-value < 0
     1690     then do:
     1691       if frame REDDialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1692       then do:
     1693         assign
     1694           p-change-value = v-diasize-orig-frame-width
     1695                          - frame REDDialog-Frame :width
     1696         .
     1697         if p-change-value >= 0
     1698         then do:
     1699           run diasize_position-resize-button in this-procedure .
     1700           return .
     1701         end.
     1702       end.
     1703     end.
     1704     if p-change-value >= 0
     1705     then do:
     1706       assign
     1707         v-change-sign = 1
     1708       .
     1709     end.
     1710     else do:
     1711       assign
     1712         v-change-sign = -1
     1713       .
     1714     end.
     1715     assign
     1716       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1717     .
     1718     if p-change-value = 0
     1719     then do:
     1720       run diasize_position-resize-button in this-procedure .
     1721       return .
     1722     end.
     1723     move_block:
     1724     do
     1725     on error undo move_block, leave move_block
     1726     :
     1727       if retry
     1728       then do:
     1729         do
     1730         on error undo move_block, leave move_block
     1731         :
     1732           if p-change-value > 0
     1733           then do:
     1734             for each buf_temp-diasize-handle
     1735             on error undo, next
     1736             :
     1737               assign
     1738                 v-object-handle = buf_temp-diasize-handle.handle-value
     1739               .
     1740               if v-object-handle <> v-diasize-resize-button
     1741               then do:
     1742                 assign
     1743                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1744                 .
     1745               end.
     1746             end.
     1747             assign
     1748               v-diasize-browse-handle :width = v-browse-width
     1749             .
     1750             for each buf_temp-browse-handle
     1751               where buf_temp-browse-handle.browse-type = 'width':u
     1752             on error undo, next
     1753             :
     1754               assign
     1755                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1756               .
     1757             end.
     1758             assign
     1759               frame REDDialog-Frame :width = v-frame-width
     1760             .
     1761             if frame REDDialog-Frame :scrollable = true
     1762             then do:
     1763               assign
     1764                 frame REDDialog-Frame :virtual-width = v-frame-virtual-width
     1765               .
     1766             end.
     1767             run diasize_position-resize-button in this-procedure .
     1768           end.
     1769           else do:
     1770             if frame REDDialog-Frame :scrollable = true
     1771             then do:
     1772               assign
     1773                 frame REDDialog-Frame :virtual-width = v-frame-virtual-width
     1774               .
     1775             end.
     1776             assign
     1777               frame REDDialog-Frame :width = v-frame-width
     1778             .
     1779             for each buf_temp-browse-handle
     1780               where buf_temp-browse-handle.browse-type = 'width':u
     1781             on error undo, next
     1782             :
     1783               assign
     1784                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1785               .
     1786             end.
     1787             assign
     1788               v-diasize-browse-handle :width = v-browse-width
     1789             .
     1790             for each buf_temp-diasize-handle
     1791             on error undo, next
     1792             :
     1793               assign
     1794                 v-object-handle = buf_temp-diasize-handle.handle-value
     1795               .
     1796               if v-object-handle <> v-diasize-resize-button
     1797               then do:
     1798                 assign
     1799                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1800                 .
     1801               end.
     1802             end.
     1803             run diasize_position-resize-button in this-procedure .
     1804           end.
     1805           assign
     1806             v-diasize-change-size = false
     1807           .
     1808           leave move_block .
     1809         end.
     1810       end.
     1811       assign
     1812         v-diasize-need-full-display = true
     1813       .
     1814       if v-diasize-change-size = false
     1815       then do:
     1816         assign
     1817           v-diasize-change-size = true
     1818         .
     1819       end.
     1820       else do:
     1821         return .
     1822       end.
     1823       assign
     1824         v-frame-width = frame REDDialog-Frame :width
     1825         v-frame-virtual-width = frame REDDialog-Frame :virtual-width
     1826         v-browse-width = v-diasize-browse-handle :width
     1827       .
     1828       for each buf_temp-browse-handle
     1829         where buf_temp-browse-handle.browse-type = 'width':u
     1830       :
     1831         assign
     1832           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1833         .
     1834       end.
     1835       for each buf_temp-diasize-handle
     1836       :
     1837         delete buf_temp-diasize-handle .
     1838       end.
     1839       assign
     1840         v-field-group-handle = frame REDDialog-Frame :first-child
     1841       .
     1842       do while valid-handle(v-field-group-handle)
     1843       :
     1844         assign
     1845           v-object-handle = v-field-group-handle :first-child
     1846         .
     1847         do while valid-handle(v-object-handle)
     1848         :
     1849           if  v-object-handle <> v-diasize-browse-handle :handle
     1850           and v-object-handle <> v-diasize-resize-button
     1851           and can-query(v-object-handle, "row")
     1852           and can-query(v-object-handle, "height")
     1853           and ( v-object-handle :col + v-object-handle :width
     1854                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1855               )
     1856           then do:
     1857             find first buf_temp-browse-handle
     1858               where buf_temp-browse-handle.browse-type   = 'width':u
     1859                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1860               no-error .
     1861             if available buf_temp-browse-handle
     1862             then do:
     1863             end.
     1864             else do:
     1865               create buf_temp-diasize-handle .
     1866               assign
     1867                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1868                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1869               .
     1870             end.
     1871           end.
     1872           assign
     1873             v-object-handle = v-object-handle :next-sibling
     1874           .
     1875         end.
     1876         assign
     1877           v-field-group-handle = v-field-group-handle :next-sibling
     1878         .
     1879       end.
     1880       do with frame REDDialog-Frame
     1881       :
     1882         hide v-diasize-resize-button .
     1883         v-diasize-resize-button :row = 1.
     1884         v-diasize-resize-button :column = 1.
     1885       end.
     1886       if p-change-value > 0
     1887       then do:
     1888         if frame REDDialog-Frame :scrollable = true
     1889         then do:
     1890           assign
     1891             frame REDDialog-Frame :virtual-width = frame REDDialog-Frame :virtual-width + p-change-value
     1892             no-error .
     1893           if error-status :error
     1894           or error-status :get-message(1) <> ""
     1895           then do:
     1896             undo move_block, retry move_block.
     1897           end.
     1898         end.
     1899         assign
     1900           frame REDDialog-Frame :width = v-frame-width + p-change-value
     1901           no-error .
     1902         if error-status :error
     1903         or error-status :get-message(1) <> ""
     1904         then do:
     1905           undo move_block, retry move_block.
     1906         end.
     1907         assign
     1908           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1909         no-error .
     1910         if error-status :error
     1911         or error-status :get-message(1) <> ""
     1912         then do:
     1913           undo move_block, retry move_block.
     1914         end.
     1915         for each buf_temp-browse-handle
     1916           where buf_temp-browse-handle.browse-type = 'width':u
     1917         on error undo move_block, retry move_block
     1918         :
     1919           assign
     1920             buf_temp-browse-handle.browse-handle :width
     1921               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1922             no-error .
     1923           if error-status :error
     1924           or error-status :get-message(1) <> ""
     1925           then do:
     1926             undo move_block, retry move_block .
     1927           end.
     1928         end.
     1929         for each buf_temp-diasize-handle
     1930         on error undo move_block, retry move_block
     1931         :
     1932           assign
     1933             v-object-handle = buf_temp-diasize-handle.handle-value
     1934           .
     1935           if v-object-handle <> v-diasize-resize-button
     1936           then do:
     1937             assign
     1938               v-object-handle :col = v-object-handle :col + p-change-value
     1939               no-error .
     1940             if error-status :error
     1941             or error-status :get-message(1) <> ""
     1942             then do:
     1943               undo move_block, retry move_block .
     1944             end.
     1945           end.
     1946         end.
     1947       end.
     1948       else do:
     1949         for each buf_temp-diasize-handle
     1950         on error undo move_block, retry move_block
     1951         :
     1952           assign
     1953             v-object-handle = buf_temp-diasize-handle.handle-value
     1954           .
     1955           if v-object-handle <> v-diasize-resize-button
     1956           then do:
     1957             assign
     1958               v-object-handle :col = v-object-handle :col + p-change-value
     1959               no-error .
     1960             if error-status :error
     1961             or error-status :get-message(1) <> ""
     1962             then do:
     1963               undo move_block, retry move_block .
     1964             end.
     1965           end.
     1966         end.
     1967         for each buf_temp-browse-handle
     1968           where buf_temp-browse-handle.browse-type = 'width':u
     1969         on error undo move_block, retry move_block
     1970         :
     1971           assign
     1972             buf_temp-browse-handle.browse-handle :width
     1973               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1974             no-error .
     1975           if error-status :error
     1976           or error-status :get-message(1) <> ""
     1977           then do:
     1978             undo move_block, retry move_block .
     1979           end.
     1980         end.
     1981         assign
     1982           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1983           no-error .
     1984         if error-status :error
     1985         or error-status :get-message(1) <> ""
     1986         then do:
     1987           undo move_block, retry move_block.
     1988         end.
     1989         assign
     1990           frame REDDialog-Frame :width = frame REDDialog-Frame :width + p-change-value
     1991         no-error .
     1992         if error-status :error
     1993         or error-status :get-message(1) <> ""
     1994         then do:
     1995           undo move_block, retry move_block.
     1996         end.
     1997         if frame REDDialog-Frame :scrollable = true
     1998         then do:
     1999           assign
     2000             frame REDDialog-Frame :virtual-width = frame REDDialog-Frame :virtual-width + p-change-value
     2001           no-error .
     2002           if error-status :error
     2003           or error-status :get-message(1) <> ""
     2004           then do:
     2005             undo move_block, retry move_block.
     2006           end.
     2007         end.
     2008       end.
     2009       if p-move-resize
     2010       then do:
     2011         run diasize_position-resize-button in this-procedure .
     2012       end.
     2013       if v-diasize-wndstore = true
     2014       then do:
     2015         if connected("ub") = true
     2016         then do:
     2017           define variable v-cntxt-db-num        as integer   no-undo .
     2018           define variable v-cntxt-userid        as character no-undo .
     2019           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2020                                             , OUTPUT v-cntxt-userid
     2021                                             ) .
     2022           run gbl/wndsizew.p
     2023             (input  v-cntxt-db-num
     2024             ,input  v-cntxt-userid
     2025             ,input  v-diasize-proc-name
     2026             ,input  'width':u
     2027             ,input  string(frame REDDialog-Frame :width - v-diasize-orig-frame-width)
     2028             ) .
     2029         end.
     2030       end.
     2031     end.
     2032     assign
     2033       v-diasize-change-size = false
     2034     .
     2035   end procedure.
     2036   procedure diasize_set-width :
     2037     define input  parameter p-new-width  as decimal   no-undo .
     2038     define input  parameter p-move-resize as logical   no-undo .
     2039     do
     2040     on error undo, return error return-value
     2041     :
     2042       run diasize_change-width in this-procedure
     2043         (input  (p-new-width - frame REDDialog-Frame :width)
     2044         ,input  p-move-resize
     2045         ) .
     2046     end.
     2047   end procedure.
     2048   procedure diasize_position-resize-button :
     2049     do with frame REDDialog-Frame
     2050     :
     2051       hide v-diasize-resize-button .
     2052       assign
     2053         v-diasize-resize-button :row = frame REDDialog-Frame :height - v-diasize-resize-button :height
     2054                     - 1
     2055                     - (frame REDDialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2056         v-diasize-resize-button :col = frame REDDialog-Frame :width - v-diasize-resize-button :width
     2057                     - 1
     2058                     - (frame REDDialog-Frame :border-right-pixels / session :pixels-per-column)
     2059       .
     2060       view v-diasize-resize-button .
     2061     end.
     2062   end procedure.
     2063   on alt-right anywhere
     2064   do:
     2065     run diasize_change-width in this-procedure
     2066       (input 1
     2067       ,input true
     2068       ) .
     2069     return no-apply .
     2070   end.
     2071   on alt-left anywhere
     2072   do:
     2073     run diasize_change-width in this-procedure
     2074       (input -1
     2075       ,input true
     2076       ) .
     2077     return no-apply .
     2078   end.
     2079   on alt-down anywhere
     2080   do:
     2081     run diasize_change-height in this-procedure
     2082       (input 1
     2083       ,input true
     2084       ) .
     2085     return no-apply .
     2086   end.
     2087   on alt-up anywhere
     2088   do:
     2089     run diasize_change-height in this-procedure
     2090       (input -1
     2091       ,input true
     2092       ) .
     2093     return no-apply .
     2094   end.
     2095   on alt-enter of frame REDDialog-Frame
     2096   do:
     2097     run diasize_maximize in this-procedure
     2098       (input  ?
     2099       ).
     2100     return no-apply .
     2101   end.
     2102   procedure diasize_end-move :
     2103     do
     2104     on error undo, return error return-value
     2105     :
     2106       define variable v-row-delta as decimal   no-undo .
     2107       define variable v-col-delta as decimal   no-undo .
     2108       define variable v-new-row as decimal   no-undo .
     2109       define variable v-new-col as decimal   no-undo .
     2110       assign
     2111         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2112         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2113       .
     2114       assign
     2115         v-row-delta = v-new-row - frame REDDialog-Frame :height
     2116         v-col-delta = v-new-col - frame REDDialog-Frame :width
     2117       .
     2118       run diasize_change-height in this-procedure
     2119         (input v-row-delta
     2120         ,input true
     2121         ) .
     2122       run diasize_change-width in this-procedure
     2123         (input v-col-delta
     2124         ,input true
     2125         ) .
     2126     end.
     2127   end procedure.
     2128   procedure diasize_maximize :
     2129     define input  parameter p-action as logical   no-undo .
     2130     do
     2131     on error undo, return error return-value
     2132     :
     2133       if p-action = ?
     2134       then do:
     2135         if v-diasize-need-maximize = true
     2136         then do:
     2137           assign
     2138             p-action = true
     2139           .
     2140         end.
     2141         else do:
     2142           assign
     2143             p-action = false
     2144           .
     2145         end.
     2146       end.
     2147       if p-action = true
     2148       then do:
     2149         run diasize_change-height in this-procedure
     2150           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2151               - frame REDDialog-Frame :height-chars
     2152           ,input true
     2153           ) .
     2154         run diasize_change-width in this-procedure
     2155           (input session :width-chars
     2156               - frame REDDialog-Frame :width-chars
     2157           ,input true
     2158           ) .
     2159         assign
     2160           v-diasize-need-maximize = false
     2161         .
     2162       end.
     2163       else do:
     2164         run diasize_change-width in this-procedure
     2165           (input v-diasize-orig-frame-width
     2166               - frame REDDialog-Frame :width-chars
     2167           ,input true
     2168           ) .
     2169         run diasize_change-height in this-procedure
     2170           (input v-diasize-orig-frame-height
     2171               - frame REDDialog-Frame :height-chars
     2172           ,input true
     2173           ) .
     2174         assign
     2175           v-diasize-need-maximize = true
     2176         .
     2177       end.
     2178     end.
     2179   end procedure.
     2180   procedure diasize_restore-orig-size :
     2181     do
     2182     on error undo, return error return-value
     2183     :
     2184       assign
     2185         v-diasize-current-frame-width  = frame REDDialog-Frame :width
     2186         v-diasize-current-frame-height = frame REDDialog-Frame :height
     2187       .
     2188       run diasize_set-height in this-procedure
     2189         (input  v-diasize-orig-frame-height
     2190         ,input  true
     2191         ) .
     2192       run diasize_set-width in this-procedure
     2193         (input  v-diasize-orig-frame-width
     2194         ,input  true
     2195         ) .
     2196     end.
     2197   end procedure.
     2198   procedure diasize_restore-current-size :
     2199     do
     2200     on error undo, return error return-value
     2201     :
     2202       run diasize_set-height in this-procedure
     2203         (input  v-diasize-current-frame-height
     2204         ,input  true
     2205         ) .
     2206       run diasize_set-width in this-procedure
     2207         (input  v-diasize-current-frame-width
     2208         ,input  true
     2209         ) .
     2210     end.
     2211   end procedure.
     2212   procedure diasize_set-browse-handle :
     2213     define input  parameter p-browse-handle as handle   no-undo .
     2214     define buffer buf_temp-browse-handle for temp-browse-handle .
     2215     do
     2216     on error undo, return error return-value
     2217     :
     2218       assign
     2219         v-diasize-browse-handle = p-browse-handle
     2220       .
     2221       for each buf_temp-browse-handle
     2222       on error undo, return error return-value
     2223       :
     2224         delete buf_temp-browse-handle .
     2225       end.
     2226     end.
     2227   end procedure.
     2228   procedure diasize_add_browse :
     2229     define input  parameter p-browse-type   as character no-undo .
     2230     define input  parameter p-browse-handle as handle    no-undo .
     2231     define buffer buf_temp-browse-handle for temp-browse-handle .
     2232     do
     2233     on error undo, return error return-value
     2234     :
     2235       assign
     2236         v-diasize-browse-number = v-diasize-browse-number + 1
     2237       .
     2238       create buf_temp-browse-handle .
     2239       assign
     2240         buf_temp-browse-handle.browse-type   = p-browse-type
     2241         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2242         buf_temp-browse-handle.browse-handle = p-browse-handle
     2243       .
     2244     end.
     2245   end procedure.
     2246   procedure diasize_init :
     2247     define variable v-default-value    as logical   no-undo .
     2248     define variable v-restore-saved    as logical   no-undo .
     2249     define variable v-resize-value-str as character no-undo .
     2250     do
     2251     on error undo, return error return-value
     2252     :
     2253       do with frame REDDialog-Frame
     2254       :
     2255         assign
     2256           v-diasize-orig-frame-height = frame REDDialog-Frame :height
     2257           v-diasize-orig-frame-width  = frame REDDialog-Frame :width
     2258           v-diasize-browse-handle     = browse BR-changes :handle
     2259         .
     2260         create button v-diasize-resize-button
     2261         assign
     2262           parent        = frame REDDialog-Frame :first-child
     2263           label         = "s"
     2264           height-pixels = 16
     2265           width-pixels  = 16
     2266           visible       = true
     2267           sensitive     = true
     2268           movable       = true
     2269           triggers:
     2270             on end-move persistent run diasize_end-move in this-procedure .
     2271           end triggers.
     2272         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2273         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2274         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2275         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2276         assign
     2277           v-diasize-wndmax = false
     2278         .
     2279         if connected("ub") = true
     2280         then do:
     2281           define variable v-cntxt-db-num        as integer   no-undo .
     2282           define variable v-cntxt-userid        as character no-undo .
     2283           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2284                                             , OUTPUT v-cntxt-userid
     2285                                             ) .
     2286           run gbl/wndpar_r.p
     2287             (input  v-cntxt-db-num
     2288             ,input  v-cntxt-userid
     2289             ,input  'wndmax':U
     2290             ,output v-diasize-wndmax
     2291             ,output v-default-value
     2292             ) .
     2293         end.
     2294         assign
     2295           v-diasize-wndstore = false
     2296         .
     2297         if connected("ub") = true
     2298         then do:
     2299           run gbl/wndpar_r.p
     2300             (input  v-cntxt-db-num
     2301             ,input  v-cntxt-userid
     2302             ,input  'wndstore':U
     2303             ,output v-diasize-wndstore
     2304             ,output v-default-value
     2305             ) .
     2306         end.
     2307         assign
     2308           v-diasize-proc-name = entry(1, program-name(2), '.')
     2309         .
     2310         if v-diasize-wndstore = true
     2311         then do:
     2312           assign
     2313             v-restore-saved = false
     2314           .
     2315           if connected("ub") = true
     2316           then do:
     2317             run gbl/wndsizer.p
     2318               (input  v-cntxt-db-num
     2319               ,input  v-cntxt-userid
     2320               ,input  v-diasize-proc-name
     2321               ,input  'height':u
     2322               ,output v-resize-value-str
     2323               ) .
     2324             if v-resize-value-str <> '':U
     2325             then do:
     2326               run diasize_change-height in this-procedure
     2327                 (input  integer(v-resize-value-str)
     2328                 ,input  true
     2329                 ) .
     2330               assign
     2331                 v-restore-saved = true
     2332               .
     2333             end.
     2334           end.
     2335           if connected("ub") = true
     2336           then do:
     2337             run gbl/wndsizer.p
     2338               (input  v-cntxt-db-num
     2339               ,input  v-cntxt-userid
     2340               ,input  v-diasize-proc-name
     2341               ,input  'width':u
     2342               ,output v-resize-value-str
     2343               ) .
     2344             if v-resize-value-str <> '':U
     2345             then do:
     2346               run diasize_change-width in this-procedure
     2347                 (input  integer(v-resize-value-str)
     2348                 ,input  true
     2349                 ) .
     2350               assign
     2351                 v-restore-saved = true
     2352               .
     2353             end.
     2354           end.
     2355           if v-restore-saved <> true
     2356           then do:
     2357             if v-diasize-wndmax = true
     2358             then do:
     2359               run diasize_maximize in this-procedure
     2360                 (input  true
     2361                 ) .
     2362             end.
     2363           end.
     2364         end.
     2365         else do:
     2366           if v-diasize-wndmax = true
     2367           then do:
     2368             run diasize_maximize in this-procedure
     2369               (input  true
     2370               ) .
     2371           end.
     2372         end.
     2373       end.
     2374     end.
     2375   end procedure.
     2376   procedure diasize_need-full-display :
     2377     define output parameter p-need-full-display as logical   no-undo .
     2378     do
     2379     on error undo, return error return-value
     2380     :
     2381       assign
     2382         p-need-full-display = v-diasize-need-full-display
     2383       .
     2384       assign
     2385         v-diasize-need-full-display = false
     2386       .
     2387     end.
     2388   end procedure.
     2389   procedure get-context :
     2390      define output parameter p-db-num as integer          no-undo.
     2391      define output parameter p-user-id as character        no-undo.
     2392      define variable v-login               as character    no-undo.
     2393      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2394      define buffer buf_user-login  for ub.user-login .
     2395      do
     2396      on error undo, return error
     2397      :
     2398            FIND FIRST buf_sys-ctrl no-lock.
     2399            ASSIGN
     2400               v-login = USERID("ub")
     2401               p-db-num = buf_sys-ctrl.db-num
     2402            .
     2403            FIND FIRST buf_user-login
     2404                 WHERE buf_user-login.db-num = p-db-num
     2405                   AND buf_user-login.user-login = v-login
     2406                 no-lock
     2407                 no-error
     2408                 .
     2409            IF AVAILABLE buf_user-login
     2410            THEN DO:
     2411               assign
     2412                  p-user-id = buf_user-login.user-id
     2413               .
     2414            END.
     2415      end.
     2416   end procedure.
     2417       run diasize_init in this-procedure .
     2418   MAIN-BLOCK:
     2419   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2420      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2421     RUN fill-tables IN THIS-PROCEDURE NO-ERROR.
     2422     FIND FIRST temp-changes  NO-ERROR.
     2423     IF NOT AVAILABLE temp-changes THEN RETURN.
     2424     RUN Myenable.
     2425     APPLY "ENTRY":U TO br-changes IN FRAME REDDialog-Frame.
     2426     WAIT-FOR GO OF FRAME REDDialog-Frame.
     2427   END.
     2428   RUN disable_UI.
     2429   PROCEDURE br-changesassignproc :
     2430   DO WITH FRAME REDDialog-Frame:
     2431     IF AVAILABLE Temp-changes THEN DO:
     2432       IF SESSION:SET-WAIT-STATE("GENERAL":U) THEN.
     2433       GET CURRENT br-changes EXCLUSIVE-LOCK NO-WAIT.
     2434       IF temp-changes.f_can_update THEN DO:
     2435         ASSIGN
     2436         Temp-changes.f_update = NOT (INPUT BROWSE BR-changes Temp-changes.f_update ).
     2437         GET CURRENT br-changes NO-LOCK.
     2438         br-changes:REFRESH().
     2439         IF SESSION:SET-WAIT-STATE("") THEN.
     2440       END.
     2441       else do:
     2442         BELL.
     2443       end.
     2444       IF SESSION:SET-WAIT-STATE("") THEN.
     2445     END.
     2446   END.
     2447   END PROCEDURE.
     2448   PROCEDURE disable_UI :
     2449     HIDE FRAME REDDialog-Frame.
     2450   END PROCEDURE.
     2451   PROCEDURE enable_UI :
     2452     DISPLAY ED-notes
     2453         WITH FRAME REDDialog-Frame.
     2454     ENABLE B-exit b-quit B-mark B-Help ED-notes BR-changes
     2455         WITH FRAME REDDialog-Frame.
     2456     VIEW FRAME REDDialog-Frame.
     2457   END PROCEDURE.
     2458   PROCEDURE fill-tables :
     2459   DEFINE VARIABLE v-log1 AS LOGICAL NO-UNDO.
     2460   DEFINE VARIABLE v-log2 AS LOGICAL NO-UNDO.
     2461   define variable fh-first as handle no-undo .
     2462   define variable fh-next as handle no-undo .
     2463   define variable v-first-rw as rowid no-undo .
     2464   define variable v-next-rw as rowid no-undo .
     2465   define variable v-ii as integer no-undo .
     2466   define variable v-uniq-key-rec as character no-undo .
     2467   define variable v-tbl-name as character no-undo .
     2468   CREATE BUFFER v-first-bh FOR TABLE p-first-bh .
     2469   CREATE BUFFER v-next-bh FOR TABLE p-next-bh .
     2470   if lookup("available", p-mode) > 0 then do:
     2471     assign
     2472     v-first-rw = p-first-bh:rowid
     2473     v-next-rw = p-next-bh:rowid
     2474     .
     2475     run gen-key-rec in this-procedure ( input p-tbl-name
     2476                                        ,input p-first-bh
     2477                                        ,output v-uniq-key-rec).
     2478     run gen-row-keyr in this-procedure
     2479       ( input  v-uniq-key-rec
     2480        ,input  ?
     2481        ,input  '':U
     2482        ,input  p-next-bh
     2483        ,input  0
     2484        ,output v-next-rw
     2485        ,output v-tbl-name
     2486       ).
     2487     assign
     2488     v-log2 = p-next-bh:FIND-by-rowid(v-next-rw) no-error .
     2489     if not (p-first-bh:available
     2490       and p-next-bh:available) then do:
     2491       undo, return error .
     2492     end.
     2493   end.
     2494   else do:
     2495     assign
     2496     v-log1 = v-first-bh:FIND-FIRST('') no-error .
     2497     assign
     2498     v-log2 = v-next-bh:FIND-FIRST('') no-error .
     2499   end.
     2500   if not can-find(first temp-labels) then do:
     2501     do v-ii = 1 to min(v-first-bh:num-fields, v-next-bh:num-fields):
     2502       assign
     2503       fh-first      = p-first-bh:buffer-field( v-ii )
     2504       fh-next       = p-next-bh:buffer-field( v-ii )
     2505       .
     2506       if fh-first:name = fh-next:name
     2507       and fh-first:data-type = fh-next:data-type then do:
     2508         IF  fh-first:BUFFER-VALUE <> fh-next:BUFFER-VALUE
     2509         THEN DO:
     2510           create temp-changes.
     2511           assign
     2512           temp-changes.t_name = p-tbl-name
     2513           temp-changes.f_name = fh-first:name
     2514           temp-changes.l_name = fh-first:label
     2515           temp-changes.v_old = fh-first:string-VALUE
     2516           temp-changes.v_new = fh-next:string-value
     2517           temp-changes.f_can_update = (lookup('ИЗМЕНЕНИЕ':U, p-mode) > 0)
     2518           temp-changes.f_parent ='':U
     2519           temp-changes.f_visible = yes
     2520           temp-changes.f_root =  p-tbl-name
     2521           temp-changes.num_ = 0
     2522           .
     2523           run tempchgs-create-lable-record in this-procedure (
     2524                                                               input p-tbl-name
     2525                                                             , input fh-first:name
     2526                                                             , input fh-first:name
     2527                                                             , input yes
     2528                                                             , input '':U
     2529                                                             , input yes
     2530                                                             ).
     2531         END.
     2532       end.
     2533     end.
     2534   end.
     2535   else do:
     2536     IF v-log1 AND v-log2
     2537     or lookup("available", p-mode) > 0
     2538     THEN DO:
     2539       FOR EACH temp-labels NO-LOCK
     2540                 where temp-labels.t_name = p-tbl-name:
     2541         IF  v-first-bh:BUFFER-FIELD(temp-labels.f_name):BUFFER-VALUE <>
     2542           v-next-bh:BUFFER-FIELD(temp-labels.f_name):BUFFER-VALUE
     2543         or lookup("view-identical", p-mode) > 0 THEN DO:
     2544           create temp-changes.
     2545           assign
     2546           temp-changes.t_name = temp-labels.t_name
     2547           temp-changes.f_name = temp-labels.f_name
     2548           temp-changes.l_name = temp-labels.l_name
     2549           temp-changes.v_old = string(v-first-bh:BUFFER-FIELD(temp-labels.f_name):BUFFER-VALUE)
     2550           temp-changes.v_new = string(v-next-bh:BUFFER-FIELD(temp-labels.f_name):BUFFER-VALUE)
     2551           temp-changes.f_can_update = temp-labels.f_can_upDATE
     2552           temp-changes.f_parent = temp-labels.f_parent
     2553           temp-changes.f_visible = temp-labels.f_visible
     2554           temp-changes.f_root = temp-labels.f_root
     2555           temp-changes.num_ = 0
     2556           .
     2557         END.
     2558       END.
     2559       run tempchgs-check-child-label-record  in this-procedure .
     2560     END.
     2561   end.
     2562   delete object v-first-bh  .
     2563   delete object v-next-bh  .
     2564   END PROCEDURE.
     2565   PROCEDURE MyEnable :
     2566   ASSIGN
     2567   FRAME REDDialog-Frame:TITLE = p-title
     2568   ed-notes:SCREEN-VALUE = p-descr
     2569   temp-changes.l_name:resizable in browse br-changes = true
     2570   temp-changes.v_old:resizable in browse br-changes = true
     2571   temp-changes.v_new:resizable in browse br-changes = true
     2572   temp-changes.l_name:width in browse br-changes = 30
     2573   temp-changes.v_old:width in browse br-changes = 40
     2574   temp-changes.v_new:width in browse br-changes = 40
     2575   temp-changes.f_update:visible in browse br-changes = (lookup('ПРОСМОТР':U, p-mode) = 0)
     2576   .
     2577   DISPLAY
     2578   ED-notes
     2579   WITH FRAME REDDialog-Frame.
     2580   ENABLE
     2581   B-exit
     2582   b-quit
     2583   B-Help
     2584   ED-notes
     2585   BR-changes
     2586   b-mark WHEN (lookup('ПРОСМОТР':U, p-mode) = 0)
     2587   WITH FRAME REDDialog-Frame.
     2588   VIEW FRAME REDDialog-Frame.
     2589   IF lookup('ПРОСМОТР':U, p-mode) > 0 THEN DO:
     2590     HIDE b-exit
     2591     b-mark
     2592     IN FRAME REDDialog-Frame.
     2593     ASSIGN
     2594     b-quit:LABEL = "&Выход"
     2595     b-quit:COL  = 1
     2596     .
     2597   END.
     2598   ASSIGN
     2599   FRAME REDDialog-Frame:TITLE = p-title
     2600   ed-notes:SCREEN-VALUE = p-descr
     2601   temp-changes.v_old:label in browse br-changes = p-col-old-label
     2602   temp-changes.v_new:label in browse br-changes = p-col-new-label
     2603   .
     2604   Open query br-changes
     2605   for each temp-changes where
     2606            temp-changes.f_visible = yes
     2607   by temp-changes.f_root
     2608   by temp-changes.f_parent
     2609   by temp-changes.l_name
     2610   .
     2611   APPLY "ENTRY" to br-changes.
     2612   apply "VALUE-CHANGED" to br-changes .
     2613   END PROCEDURE.
     2614   PROCEDURE proc-b-mark :
     2615   define variable glog as logical no-undo .
     2616      DO WITH FRAME REDDialog-Frame:
     2617         IF AVAILABLE Temp-changes THEN DO:
     2618           ASSIGN br-changes:SENSITIVE = NO.
     2619           RUN br-changesassignproc IN THIS-PROCEDURE NO-ERROR.
     2620           ASSIGN br-changes:SENSITIVE =YES.
     2621           if lookup( last-event :function, "MOUSE-SELECT-DBLCLICK,Return" ) = 0 then do:
     2622             assign
     2623             glog = BR-changes :select-next-row () in frame REDDialog-Frame
     2624             .
     2625             apply "VALUE-changed":U to BR-changes in frame REDDialog-Frame.
     2626           end.
     2627           apply "entry":U to BR-changes in frame REDDialog-Frame.
     2628        END.
     2629      END.
     2630   END PROCEDURE.
     2631   PROCEDURE proc-save :
     2632   define buffer buf_temp-labels for temp-labels.
     2633   FOR EACH temp-changes WHERE
     2634           temp-changes.f_update,
     2635       FIRST temp-labels WHERE
     2636            temp-labels.t_name = temp-changes.t_name
     2637        and temp-labels.f_name = temp-changes.f_name :
     2638       temp-labels.f_Update = YES.
     2639   END.
     2640   for each temp-labels where
     2641               temp-labels.f_parent = ''
     2642           and temp-labels.f_update = yes:
     2643     for each buf_temp-labels where
     2644             buf_temp-labels.t_name = temp-labels.t_name
     2645         and buf_temp-labels.f_parent = temp-labels.f_name:
     2646       buf_temp-labels.f_update = yes.
     2647     end.
     2648   end.
     2649   ASSIGN
     2650   p-ok = YES.
     2651   END PROCEDURE.
     2652   PROCEDURE set-row-color :
     2653   DEFINE INPUT PARAMETER p-old AS character.
     2654   DEFINE INPUT PARAMETER p-new AS character.
     2655   DEFINE VARIABLE iFGColor AS INTEGER NO-UNDO.
     2656   DEFINE VARIABLE iBGColor AS INTEGER NO-UNDO.
     2657   IF p-old <> p-new THEN DO:
     2658     ASSIGN
     2659     iFGColor = WHITE_COLOR
     2660     iBGColor = DARK_GREEN_COLOR
     2661       .
     2662   end.
     2663   ELSE do:
     2664     ASSIGN
     2665     iFGColor = Black_COLOR
     2666     iBGColor = White_COLOR
     2667     .
     2668   end.
     2669   ASSIGN
     2670   temp-changes.v_old:FGCOLOR IN BROWSE br-changes = iFGColor
     2671   temp-changes.v_old:BGCOLOR IN BROWSE br-changes = iBGColor
     2672   temp-changes.v_new:FGCOLOR IN BROWSE br-changes = iFGColor
     2673   temp-changes.v_new:BGCOLOR IN BROWSE br-changes = iBGColor
     2674   .
     2675   END PROCEDURE.
