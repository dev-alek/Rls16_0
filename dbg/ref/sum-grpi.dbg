        1   DEFINE BUFFER buf_sum-grp FOR ub.sum-grp.
        2   DEFINE BUFFER locked_sum-grp FOR ub.sum-grp.
        3   DEFINE TEMP-TABLE tt-sum-grp NO-UNDO LIKE ub.sum-grp.
        4   define input parameter parparentproc as widget-handle no-undo .
        5   define input        parameter p-mode as character  no-undo.
        6   define input-output parameter p-ri       as recid no-undo.
        7   define variable vss-revision    as character no-undo init "$Revision$":U .
        8   define variable vss-author      as character no-undo init "$Author$":U .
        9   define variable vss-date        as character no-undo init "$Date$":U .
       10   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       11   define variable vss-archive     as character no-undo init "$Archive$":U .
       12   define variable vss-description as character no-undo init "Редактирование групп суммовых чеков".
       13   procedure vss-get-info :
       14     define output parameter p-vss-revision    like vss-revision    no-undo .
       15     define output parameter p-vss-author      like vss-author      no-undo .
       16     define output parameter p-vss-date        like vss-date        no-undo .
       17     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       18     define output parameter p-vss-archive     like vss-archive     no-undo .
       19     define output parameter p-vss-description like vss-description no-undo .
       20     assign
       21       p-vss-revision    = vss-revision
       22       p-vss-author      = vss-author
       23       p-vss-date        = vss-date
       24       p-vss-workfile    = vss-workfile
       25       p-vss-archive     = vss-archive
       26       p-vss-description = vss-description
       27     .
       28   end procedure.
       29   procedure vss-get-parameters :
       30     define output parameter p-vss-parameters as character no-undo .
       31   end procedure.
       32   define new global shared variable g#vssrevis-logger as handle    no-undo .
       33   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       34   define variable v-vssrevis-logger                   as handle    no-undo .
       35   procedure vss-logevent :
       36     define input  parameter p-extra-paramters as character no-undo .
       37     define variable v-vssrevis-parameters as character no-undo .
       38     do
       39     on error undo, return error return-value
       40     :
       41       if  valid-handle(v-vssrevis-logger)
       42       and v-vssrevis-logger :get-signature("logevent") <> ""
       43       then do:
       44         run vss-get-parameters in this-procedure
       45           (output v-vssrevis-parameters
       46           ).
       47         run logevent in v-vssrevis-logger
       48           (input vss-workfile
       49           ,input vss-revision
       50           ,input v-vssrevis-parameters
       51           ,input p-extra-paramters
       52           ).
       53       end.
       54     end.
       55   end procedure.
       56   assign
       57     v-vssrevis-logger = g#vssrevis-logger
       58   .
       59   if  valid-handle(v-vssrevis-logger)
       60   and v-vssrevis-logger :get-signature("logevent") <> ""
       61   then do:
       62     assign
       63       v-vssrevis-logevent = true
       64     .
       65     run vss-logevent in this-procedure (input vss-description) .
       66   end.
       67   procedure proc-alt-shift-f2:
       68     if not ibs.th.gbl.gbl-var:rcode
       69   then
       70     run gbl\inidebug.p .
       71   end.
       72   procedure proc-alt-shift-f3:
       73     run gbl/prvssinf.p
       74       ( input this-procedure
       75       ) .
       76   end.
       77   define variable v-inform-launched as logical no-undo initial false .
       78   procedure proc-alt-shift-f4:
       79     define variable v-action as character no-undo .
       80     if v-inform-launched = false then do:
       81       assign
       82         v-inform-launched = true
       83       .
       84       run gbl/d-inform.w
       85         (  input self
       86         ,  input this-procedure
       87         , output v-action
       88         ) no-error .
       89       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       90       assign
       91         v-inform-launched = false
       92       .
       93     end.
       94   end.
       95   procedure proc-alt-f1:
       96     run gbl/corrhelp.p
       97       (input this-procedure
       98       ) .
       99   end .
      100   on alt-shift-f2 anywhere do:
      101     run proc-alt-shift-f2.
      102   end.
      103   on alt-shift-f3 anywhere do:
      104     run proc-alt-shift-f3 in this-procedure .
      105   end.
      106   on alt-shift-f4 anywhere do:
      107     run proc-alt-shift-f4 in this-procedure.
      108   end.
      109   on alt-f1 anywhere do:
      110     run proc-alt-f1 in this-procedure .
      111   end.
      112   define new global shared variable g#language as character no-undo .
      113   if g#language <> '' and g#language <> 'rus':U then do:
      114     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      115   end.
      116   define new global shared variable g#library  as handle no-undo .
      117   define new global shared variable g#library2 as handle no-undo .
      118   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      119     define variable v-cntxt-db-num        as integer   no-undo .
      120     define variable v-cntxt-userid        as character no-undo .
      121     define variable v-cntxt-level         as character no-undo .
      122     define variable v-cntxt-host-code-obj as integer   no-undo .
      123     define variable v-cntxt-obj-type      as character no-undo .
      124     define variable v-cntxt-obj-code      as integer   no-undo .
      125     define variable v-cntxt-db-num-obj    as integer   no-undo .
      126     define variable v-cntxt-is-admin      as logical   no-undo .
      127   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      128     run mainmenu_getcntxt in parparentproc
      129       (output v-cntxt-db-num
      130       ,output v-cntxt-userid
      131       ,output v-cntxt-level
      132       ,output v-cntxt-host-code-obj
      133       ,output v-cntxt-obj-type
      134       ,output v-cntxt-obj-code
      135       ,output v-cntxt-db-num-obj
      136       ,output v-cntxt-is-admin
      137       ) .
      138   DEFINE VARIABLE mImagePath     AS CHARACTER   NO-UNDO.
      139   DEFINE VARIABLE mImageDir      AS CHARACTER   NO-UNDO.
      140   DEFINE VARIABLE mImagePreDir   AS CHARACTER   NO-UNDO.
      141   DEFINE VARIABLE mImageTrash    AS CHARACTER   NO-UNDO.
      142   DEFINE VARIABLE mPhotomgd      AS LOGICAL     NO-UNDO.
      143   DEFINE VARIABLE mImagePh       AS LOGICAL     NO-UNDO.
      144   define variable v-param-types   as character  no-undo.
      145   define variable v-value-char    as character  no-undo.
      146   define variable v-val-date      as date       no-undo.
      147   define variable v-val-decimal   as decimal    no-undo.
      148   define variable v-val-integer   as integer    no-undo.
      149   define variable v-val-logical   as logical    no-undo.
      150   define variable v-tthd          as handle     no-undo.
      151   RUN imagelist_loaddef IN THIS-PROCEDURE NO-ERROR.
      152   PROCEDURE imagelist_loaddef:
      153       DEFINE VARIABLE vPar-val       AS CHARACTER   NO-UNDO.
      154       DEFINE VARIABLE vPar-type      AS CHARACTER   NO-UNDO.
      155       ASSIGN
      156           vPar-val  = "":U
      157           vPar-type = "":U
      158           .
      159   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
      160     (input  'photo':u
      161     ,input  '':u
      162     ,input  '':u
      163     ,input  0
      164     ,input  '':u
      165     ,input  '':u
      166     ,input  '':u
      167     ,input  no
      168     ,output vPar-val
      169     ,output vPar-type
      170     ) no-error .
      171           mImagePh = LOOKUP (vPar-val, "true,yes":U) > 0.
      172       IF mImagePh THEN .
      173       ELSE RETURN.
      174       ASSIGN
      175           vPar-val  = "":U
      176           vPar-type = "":U
      177           .
      178   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
      179     (input  'ph-dir':u
      180     ,input  '':u
      181     ,input  '':u
      182     ,input  0
      183     ,input  '':u
      184     ,input  '':u
      185     ,input  '':u
      186     ,input  NO
      187     ,output vPar-val
      188     ,output vPar-type
      189     ) no-error .
      190       IF LENGTH (vPar-val) = 0 THEN
      191           RUN verify-ini-entry("ph-dir":U, "REP-SETS":U, "":U, YES, OUTPUT vPar-val) NO-ERROR.
      192       IF LENGTH (vPar-val) = 0 THEN vPar-val = "c:\temp\":U.
      193       ASSIGN
      194           mImagePath   = RIGHT-TRIM (vPar-val, "~\~/":U)
      195           mImagePath   = mImagePath + (IF LENGTH (mImagePath) > 0 THEN "\":U ELSE "":U)
      196           mImagePreDir = mImagePath
      197           mImageDir    = mImagePreDir
      198           mImageTrash  = mImagePath + "trash\":U
      199           .
      200       ASSIGN
      201           vPar-val  = "":U
      202           vPar-type = "":U
      203           .
      204               run adm/shattri.p (
      205           input "get":U
      206           ,input  '':U
      207           ,input  0
      208           ,input  'gds-ref':U
      209           ,input  'shema-foto':U
      210           ,output v-value-char
      211           ,output v-val-date
      212           ,output v-val-decimal
      213           ,output v-val-integer
      214           ,output v-val-logical
      215           ,output v-param-types
      216           ,INPUT-OUTPUT table-handle v-tthd
      217           ) no-error.
      218           delete object v-tthd.
      219           mPhotomgd = IF v-val-integer = 2 then yes else no.
      220   END PROCEDURE.
      221   PROCEDURE imagelist_decode:
      222       DEFINE INPUT  PARAMETER iImageList AS LONGCHAR  NO-UNDO.
      223       DEFINE INPUT  PARAMETER iImageGdsCode AS int    NO-UNDO.
      224       DEFINE OUTPUT PARAMETER oImageList AS LONGCHAR  NO-UNDO.
      225       DEFINE VARIABLE vCh                AS CHARACTER NO-UNDO.
      226       DEFINE VARIABLE vInt               AS INTEGER   NO-UNDO.
      227       ASSIGN
      228           oImageList = iImageList
      229           .
      230       DO vInt = 1 TO NUM-ENTRIES (iImageList, ",":U):
      231           vCh =ENTRY (vInt, iImageList, ",":U).
      232           IF SUBSTRING (vCh, 1, 2) = "~\~\":U THEN .
      233           ELSE
      234           DO:
      235               ASSIGN
      236                   vCh = REPLACE (vCh, "~/":U, "\":U)
      237                   vCh = REPLACE (vCh, "~\":U, "\":U)
      238                   .
      239               IF SUBSTRING (vCh, 2, 2) = ":\":U OR vCh BEGINS mImageDir THEN .
      240               ELSE vCh = mImagePreDir + (if mPhotomgd then string(iImageGdsCode) + "\":U else '':U ) +  vCh.
      241               ENTRY (vInt, oImageList, ",":U) = vCh.
      242           END.
      243       END.
      244   END PROCEDURE.
      245   PROCEDURE imagelist_encode:
      246       DEFINE INPUT  PARAMETER iImageList AS LONGCHAR  NO-UNDO.
      247       DEFINE OUTPUT PARAMETER oImageList AS LONGCHAR  NO-UNDO.
      248       DEFINE VARIABLE vCh                AS CHARACTER NO-UNDO.
      249       DEFINE VARIABLE vInt               AS INTEGER   NO-UNDO.
      250       DEFINE VARIABLE vLen               AS INTEGER   NO-UNDO.
      251       ASSIGN
      252           oImageList = iImageList
      253           vLen       = LENGTH (mImageDir)
      254           .
      255       DO vInt = 1 TO NUM-ENTRIES (iImageList, ",":U):
      256           vCh =ENTRY (vInt, iImageList, ",":U).
      257           IF LENGTH (vCh) > 0 AND vLen > 0 AND vCh BEGINS mImageDir THEN
      258               ENTRY (vInt, oImageList, ",":U) =
      259                   SUBSTRING (vCh, vLen + 1).
      260       END.
      261   END PROCEDURE.
      262   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      263   PROCEDURE verify-ini-entry:
      264   DEFINE INPUT  PARAMETER ini-key-name     as character no-undo.
      265   DEFINE INPUT  PARAMETER ini-section-name as character no-undo.
      266   DEFINE INPUT  PARAMETER error-msg-text   as character no-undo.
      267   DEFINE INPUT  PARAMETER silence          as logical no-undo.
      268   DEFINE OUTPUT PARAMETER ini-entry-value  as character no-undo INIt ?.
      269   define variable v-mess as character no-undo .
      270   get-key-value section ini-section-name key ini-key-name value ini-entry-value.
      271   if ini-entry-value = ? and ini-key-name begins "spl"
      272   then
      273   get-key-value section ini-section-name key "splall" value ini-entry-value.
      274   if ini-entry-value = ? and ini-key-name begins "sav"
      275   then
      276   get-key-value section ini-section-name key "savall" value ini-entry-value.
      277   if ini-entry-value = ? then do:
      278     assign
      279     v-mess = substitute("Ошибка ini - файла:&1Секция &2&1Ключ &3&1&4"
      280                       , chr(10)
      281                       , ini-section-name
      282                       , ini-key-name
      283                       , error-msg-text).
      284       if not silence then do:
      285         message
      286         v-mess
      287         view-as alert-box ERROR  .
      288         return error.
      289       end.
      290       else do:
      291         return error v-mess.
      292       end.
      293   end.
      294   END PROCEDURE.
      295   PROCEDURE verify-file:
      296   DEFINE INPUT  PARAMETER filename       as character no-undo.
      297   DEFINE INPUT  PARAMETER error-msg-text as character no-undo.
      298   DEFINE INPUT  PARAMETER silence        as logical no-undo.
      299   DEFINE OUTPUT PARAMETER found          as logical no-undo.
      300   file-info:file-name = filename.
      301   found = NOT (file-info:full-pathname = ?).
      302   if NOT found  then do:
      303     if not silence then do:
      304       message error-msg-text
      305       view-as alert-box ERROR.
      306       return error.
      307     end.
      308     else return error error-msg-text.
      309   end.
      310   END PROCEDURE.
      311   define variable tcode      like sum-grp.grp-code no-undo.
      312   define variable rr         as recid    no-undo.
      313   DEFINE VARIABLE mImageList AS LONGCHAR NO-UNDO.
      314   DEFINE VARIABLE mLogical   AS LOGICAL  NO-UNDO.
      315   DEFINE buffer buf_sum-grp-attr for ub.sum-grp-attr .
      316   DEFINE TEMP-TABLE ttImgBar NO-UNDO
      317       FIELD fID    AS CHARACTER
      318       FIELD fFrame AS HANDLE
      319       FIELD fImage AS HANDLE
      320       FIELD fXPix  AS INTEGER
      321       FIELD fTrgs  AS HANDLE
      322       FIELD fFile  AS CHARACTER
      323       FIELD fNum   AS INTEGER
      324       INDEX i1 fXPix
      325       INDEX i2 fID
      326       INDEX i3 fNum
      327       .
      328   DEFINE BUTTON b-add
      329       LABEL "&Добавить"
      330       SIZE 15 BY 1.13.
      331   DEFINE BUTTON b-exit AUTO-GO
      332       LABEL "&Ввод "
      333       SIZE 10 BY 1.
      334   DEFINE BUTTON b-help
      335       LABEL "Помо&щь"
      336       SIZE 10 BY 1.
      337   DEFINE BUTTON b-quit AUTO-END-KEY
      338       LABEL "&Отмена"
      339       SIZE 10 BY 1.
      340   DEFINE IMAGE v-IMAGE
      341       STRETCH-TO-FIT RETAIN-SHAPE
      342       SIZE 25 BY 4.25.
      343   DEFINE RECTANGLE RECT-1
      344       EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      345       SIZE 61.88 BY 9.5.
      346   DEFINE VARIABLE n-choose-goods AS LOGICAL INITIAL no
      347       LABEL "Группа для выбора товаров на кассе"
      348       VIEW-AS TOGGLE-BOX
      349       SIZE 39.13 BY .83 NO-UNDO.
      350   DEFINE FRAME d-sumgrp
      351       b-exit AT ROW 1 COL 1
      352       b-quit AT ROW 1 COL 11
      353       b-help AT ROW 1 COL 58 WIDGET-ID 2
      354       tt-sum-grp.grp-code AT ROW 3 COL 38 COLON-ALIGNED
      355       LABEL "Код группы" FORMAT "999"
      356       VIEW-AS FILL-IN
      357       SIZE 4.5 BY 1
      358       tt-sum-grp.grp-name AT ROW 4.5 COL 16 COLON-ALIGNED
      359       LABEL "Название"
      360       VIEW-AS FILL-IN
      361       SIZE 41 BY 1
      362       b-add AT ROW 6 COL 49 WIDGET-ID 8
      363       n-choose-goods AT ROW 6.25 COL 5.5 WIDGET-ID 4
      364       RECT-1 AT ROW 2.5 COL 3.5
      365       v-IMAGE AT ROW 7.25 COL 39.5 WIDGET-ID 10
      366       SPACE(4.87) SKIP(0.82)
      367       WITH VIEW-AS DIALOG-BOX
      368       SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      369       TITLE "Параметры группы".
      370   ASSIGN
      371          FRAME d-sumgrp:SCROLLABLE       = FALSE.
      372   ON GO OF FRAME d-sumgrp
      373       DO:
      374           assign
      375               tt-sum-grp.grp-code
      376               tt-sum-grp.grp-name
      377               .
      378           RUN proc-save IN THIS-PROCEDURE NO-ERROR.
      379           IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
      380       END.
      381   ON CHOOSE OF b-add IN FRAME d-sumgrp
      382       DO:
      383           DEFINE VARIABLE vFile AS CHARACTER NO-UNDO.
      384           DEFINE VARIABLE vLog  AS LOGICAL   NO-UNDO.
      385           SYSTEM-DIALOG GET-FILE vFile
      386           FILTERS         "Картинки" "*.jpg,*.png,*.bmp,*.gif":U,         "Картинки *.jpg" "*.jpg":U,         "Картинки *.png" "*.png":U,         "Картинки *.bmp" "*.bmp":U,         "Картинки *.gif" "*.gif":U,         "Все файлы" "*.*":U
      387           MUST-EXIST
      388         TITLE "Выбор файла"
      389         UPDATE vLog
      390           .
      391           IF NOT vLog THEN RETURN NO-APPLY.
      392           RUN ImageAdd IN THIS-PROCEDURE (vFile).
      393       END.
      394   ON VALUE-CHANGED OF n-choose-goods IN FRAME d-sumgrp
      395       DO:
      396           assign n-choose-goods .
      397       END.
      398   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME d-sumgrp:PARENT eq ?
      399   THEN FRAME d-sumgrp:PARENT = ACTIVE-WINDOW.
      400   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      401   on help of frame d-sumgrp
      402   do:
      403     run gbl/app_help.p
      404       (input this-procedure :file-name
      405       ,input ''
      406       ,input ?
      407       ) no-error.
      408     if error-status :error then do:
      409       message
      410         "Ошибка при вызове помощи"
      411         error-status :get-message(1)
      412         view-as alert-box .
      413     end.
      414   end.
      415   run minbtn-set in this-procedure .
      416   on choose of b-help in frame d-sumgrp
      417   do:
      418     apply "help":u to frame d-sumgrp .
      419   end.
      420   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      421   procedure minbtn-set :
      422       do
      423           on error undo, return error return-value
      424           :
      425           define variable ii              as integer       no-undo .
      426           define variable fh              as widget-handle no-undo .
      427           define variable hh              as widget-handle no-undo .
      428           define variable v-h             as handle        extent 4 no-undo .
      429           define variable v-name-button   as character     no-undo .
      430           define variable v-help-old-x    as decimal       no-undo .
      431           define variable v-help-old-y    as decimal       no-undo .
      432           define variable v-help-old-size as decimal       no-undo .
      433           define variable v-frame-width   as decimal       no-undo .
      434           define variable jj              as integer       no-undo .
      435           do
      436               on error undo, return error
      437               :
      438               assign
      439                   v-frame-width = frame d-sumgrp:width - 0.3
      440                   fh            = frame d-sumgrp:first-child
      441                   hh            = fh:first-child
      442                   ii            = 1
      443                   .
      444               do while valid-handle(hh):
      445                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      446                   do:
      447                       case lc(hh:name) :
      448                           when "b-help" then
      449                               do:
      450                                   hh:load-image-up("cmp/b-help.bmp":u) .
      451                                   hh:load-image-down("cmp/b-help.bmp":u) .
      452                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      453                                   hh:TOOLTIP = "Помощь" .
      454                                   v-help-old-x = hh:column .
      455                                   v-help-old-y = hh:row    .
      456                                   v-help-old-size = hh:width .
      457                                   hh:width-chars = 2.5 .
      458                               end.
      459                           when "b-print" then
      460                               do:
      461                                   hh:load-image("cmp/b-print.bmp":u) .
      462                                   hh:TOOLTIP = "Печать" .
      463                                   v-h[ii] = hh:handle .
      464                                   ii = ii + 1 .
      465                                   hh:width-chars = 3 .
      466                               end.
      467                           when "b-history" or
      468                           when "b-hist" then
      469                               do:
      470                                   hh:load-image("cmp/b-hist.bmp":u) .
      471                                   hh:TOOLTIP = "История" .
      472                                   v-h[ii] = hh:handle .
      473                                   ii = ii + 1 .
      474                                   hh:width-chars = 3 .
      475                               end.
      476                           when "b-sch" then
      477                               do:
      478                                   hh:load-image("cmp/b-sch.bmp":u) .
      479                                   hh:TOOLTIP = "Установка Фильтра" .
      480                                   v-h[ii] = hh:handle .
      481                                   ii = ii + 1 .
      482                                   hh:width-chars = 3 .
      483                               end.
      484                           when "b-hist-user" then
      485                               do:
      486                                   hh:load-image("cmp/b-hist.bmp":u) .
      487                                   hh:TOOLTIP = "История пользователя" .
      488                                   ii = ii + 1 .
      489                               end.
      490                       end case.
      491                   end.
      492                   hh = hh:next-sibling.
      493               end.
      494               b-help:column = v-frame-width - b-help:width-chars.
      495               jj = 0.
      496               repeat ii = 4 to 1 by -1 :
      497                   if valid-handle (v-h[ii] ) then
      498                   do:
      499                       jj  = jj + 1 .
      500                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      501                       v-h[ii]:row    = v-help-old-y .
      502                   end.
      503               end.
      504           end.
      505       end.
      506   end procedure.
      507   ON WINDOW-CLOSE OF FRAME d-sumgrp APPLY "END-ERROR":U TO SELF.
      508   MAIN-BLOCK:
      509   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      510         ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      511         ON STOP       UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      512   if not (p-mode = 'ДОБАВЛЕНИЕ':U
      513           or p-mode = 'ИЗМЕНЕНИЕ':U
      514           or p-mode = 'ПРОСМОТР':U) then do:
      515     message
      516     vss-workfile vss-revision vss-description skip
      517     "Неверное значение параметра p-mode" p-mode
      518     view-as alert-box error .
      519     undo, return error .
      520   end.
      521   if p-mode = 'ДОБАВЛЕНИЕ':U then do:
      522     p-ri = ?.
      523     FIND LAST buf_sum-grp NO-LOCK NO-ERROR .
      524     if available buf_sum-grp then
      525         tcode = buf_sum-grp.grp-code + 1.
      526     else
      527         tcode = 1.
      528     if tcode >= 1000 then do:
      529        tcode = ?.
      530     end.
      531     CREATE tt-sum-grp.
      532     tt-sum-grp.grp-code = tcode.
      533   end.
      534   else do:
      535     if  p-mode = 'ИЗМЕНЕНИЕ':U then do:
      536       FIND locked_sum-grp EXCLUSIVE-LOCK WHERE recid( locked_sum-grp ) = p-ri .
      537     end.
      538     else do:
      539       FIND locked_sum-grp no-LOCK WHERE recid( locked_sum-grp ) = p-ri .
      540     end.
      541     CREATE tt-sum-grp.
      542     buffer-copy locked_sum-grp to tt-sum-grp.
      543   end.
      544   session:data-entry-return = yes .
      545   RUN Myenable IN THIS-PROCEDURE.
      546   if p-mode = 'ДОБАВЛЕНИЕ':U then
      547       WAIT-FOR GO OF FRAME d-sumgrp FOCUS tt-sum-grp.grp-code .
      548   else
      549       WAIT-FOR GO OF FRAME d-sumgrp FOCUS tt-sum-grp.grp-name .
      550   END.
      551   RUN disable_UI.
      552   session:data-entry-return = no .
      553   PROCEDURE disable_UI :
      554     HIDE FRAME d-sumgrp.
      555   END PROCEDURE.
      556   PROCEDURE enable_UI :
      557       DISPLAY n-choose-goods
      558           WITH FRAME d-sumgrp.
      559       IF AVAILABLE tt-sum-grp THEN
      560           DISPLAY tt-sum-grp.grp-code tt-sum-grp.grp-name
      561               WITH FRAME d-sumgrp.
      562       ENABLE b-exit b-quit b-help RECT-1 v-IMAGE tt-sum-grp.grp-code
      563           tt-sum-grp.grp-name b-add n-choose-goods
      564           WITH FRAME d-sumgrp.
      565   END PROCEDURE.
      566   PROCEDURE MyEnable :
      567       DEFINE VARIABLE vPar-val  AS CHARACTER NO-UNDO.
      568       DEFINE VARIABLE vPar-type AS CHARACTER NO-UNDO.
      569       ASSIGN
      570           vPar-val  = "":U
      571           vPar-type = "":U
      572           .
      573   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
      574     (input  'photo':u
      575     ,input  '':u
      576     ,input  '':u
      577     ,input  0
      578     ,input  '':u
      579     ,input  '':u
      580     ,input  '':u
      581     ,input  no
      582     ,output vPar-val
      583     ,output vPar-type
      584     ) no-error .
      585       define VARIABLE vFile as character no-undo .
      586       IF AVAILABLE tt-sum-grp THEN
      587       do:
      588           DISPLAY tt-sum-grp.grp-code tt-sum-grp.grp-name
      589               WITH FRAME d-sumgrp.
      590           mImagePh = LOOKUP (vPar-val, "true,yes":U) > 0.
      591           if mImagePh then
      592           do:
      593               if p-mode <> 'ПРОСМОТР':U then
      594               do:
      595                   ENABLE
      596                       b-add
      597                       n-choose-goods
      598                       with frame d-sumgrp.
      599               end.
      600               else
      601               do:
      602                   display
      603                       b-add
      604                       n-choose-goods
      605                       with frame d-sumgrp.
      606               end.
      607               for each buf_sum-grp-attr where buf_sum-grp-attr.grp-code = tt-sum-grp.grp-code:
      608                   if buf_sum-grp-attr.attr-code = "image-list" then
      609                   do:
      610                       if LOOKUP("grp", mImageDir, "\") = 0 then
      611                       do:
      612                           vFile = mImageDir + "grp\":U + buf_sum-grp-attr.attr-value .
      613                       end.
      614                       else vFile = mImageDir + buf_sum-grp-attr.attr-value .
      615                       v-IMAGE:LOAD-IMAGE (vFile) in frame d-sumgrp NO-ERROR.
      616                   end.
      617                   if buf_sum-grp-attr.attr-code = "grp-image" then
      618                   do:
      619                       n-choose-goods = LOGICAL (buf_sum-grp-attr.attr-value) .
      620                       DISPLAY n-choose-goods with frame d-sumgrp.
      621                   end.
      622               end.
      623           end.
      624       end.
      625       ENABLE
      626           b-exit
      627           when P-mode <> 'ПРОСМОТР':U
      628           RECT-1
      629           b-quit
      630           tt-sum-grp.grp-code
      631           WHEN p-mode = 'ДОБАВЛЕНИЕ':U
      632           tt-sum-grp.grp-name
      633           when P-mode <> 'ПРОСМОТР':U
      634           n-choose-goods
      635           WITH FRAME d-sumgrp.
      636       if p-mode = 'ПРОСМОТР':U then
      637       do:
      638           hide
      639               b-exit in frame d-sumgrp .
      640           assign
      641               b-quit:label  = "&Выход"
      642               b-quit:column = 1
      643               .
      644       end.
      645   END PROCEDURE.
      646   PROCEDURE proc-save :
      647       if p-mode = 'ПРОСМОТР':U then return.
      648       run ref/sumgrp01.p (
      649           input-output p-ri
      650           ,input p-mode
      651           ,INPUT NO
      652           ,INPUT tt-sum-grp.grp-code
      653           ,INPUT tt-sum-grp.grp-name) NO-ERROR.
      654       if error-status:error then
      655       do:
      656   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      657   define variable fh as widget-handle no-undo .
      658   define variable hh as widget-handle no-undo .
      659   define variable rv as character no-undo .
      660   assign
      661   rv = entry(1, return-value , chr(4)).
      662   if rv <> "":U then do:
      663     assign
      664     fh = frame d-sumgrp:first-child
      665     hh = fh:first-child
      666     .
      667     do while valid-handle(hh):
      668       if hh:name = rv then do:
      669         APPLY "ENTRY" to hh.
      670         undo ,
      671         return error.
      672       end.
      673       hh = hh:next-sibling.
      674     end.
      675   end.
      676           undo, return error.
      677       end.
      678       else
      679       do:
      680           find first buf_sum-grp-attr where buf_sum-grp-attr.grp-code = tt-sum-grp.grp-code and buf_sum-grp-attr.attr-code = "grp-image" no-error .
      681           if AVAILABLE buf_sum-grp-attr then
      682           do:
      683               buf_sum-grp-attr.attr-value = string(n-choose-goods) .
      684           end.
      685           else
      686           do:
      687               create buf_sum-grp-attr.
      688               ASSIGN
      689                   buf_sum-grp-attr.attr-code  = "grp-image"
      690                   buf_sum-grp-attr.attr-value = string(n-choose-goods)
      691                   buf_sum-grp-attr.grp-code   = tt-sum-grp.grp-code
      692                   .
      693           end.
      694           find first buf_sum-grp-attr where buf_sum-grp-attr.grp-code = tt-sum-grp.grp-code and buf_sum-grp-attr.attr-code = "image-list" no-error .
      695           if AVAILABLE buf_sum-grp-attr then
      696           do:
      697               if buf_sum-grp-attr.attr-value = "" or mImageList <> "" then
      698               do:
      699                   buf_sum-grp-attr.attr-value = mImageList .
      700               end.
      701           end.
      702           else
      703           do:
      704               create buf_sum-grp-attr.
      705               ASSIGN
      706                   buf_sum-grp-attr.attr-code  = "image-list"
      707                   buf_sum-grp-attr.attr-value = mImageList
      708                   buf_sum-grp-attr.grp-code   = tt-sum-grp.grp-code
      709                   .
      710           end.
      711       end.
      712   END PROCEDURE.
      713   PROCEDURE ImageAdd :
      714       DEFINE INPUT PARAMETER iFile AS CHARACTER NO-UNDO.
      715       DEFINE BUFFER ttImgBar FOR ttImgBar.
      716       DEFINE VARIABLE vNum  AS INTEGER   NO-UNDO.
      717       DEFINE VARIABLE vFile AS CHARACTER NO-UNDO.
      718       DEFINE VARIABLE vTmp  AS CHARACTER NO-UNDO.
      719       DEFINE VARIABLE vInt  AS INTEGER   NO-UNDO.
      720       DEFINE VARIABLE vCh2  AS CHARACTER NO-UNDO.
      721       DEFINE VARIABLE vExt  AS CHARACTER NO-UNDO.
      722       if LOOKUP("grp", mImageDir, "\") = 0 then
      723       do:
      724           mImageDir = mImageDir + "grp\":U .
      725       end.
      726       RUN verify-file (mImagePreDir, "":U, YES, OUTPUT mLogical) NO-ERROR.
      727       IF ERROR-STATUS:ERROR OR NOT mLogical THEN
      728       DO:
      729           OS-CREATE-DIR VALUE (mImagePreDir).
      730           IF OS-ERROR <> 0 THEN
      731           DO:
      732               MESSAGE SUBSTITUTE ("Ошибка &1 создания поддиректории~n&2",
      733                   OS-ERROR, mImageDir)
      734                   VIEW-AS ALERT-BOX ERROR.
      735               RETURN NO-APPLY.
      736           END.
      737       END.
      738       RUN verify-file (mImageDir, "":U, YES, OUTPUT mLogical) NO-ERROR.
      739       IF ERROR-STATUS:ERROR OR NOT mLogical THEN
      740       DO:
      741           OS-CREATE-DIR VALUE (mImageDir).
      742           IF OS-ERROR <> 0 THEN
      743           DO:
      744               MESSAGE SUBSTITUTE ("Ошибка &1 создания поддиректории~n&2",
      745                   OS-ERROR, mImageDir)
      746                   VIEW-AS ALERT-BOX ERROR.
      747               RETURN NO-APPLY.
      748           END.
      749       END.
      750       IF iFile BEGINS mImageDir THEN vFile = iFile.
      751       ELSE
      752       DO:
      753           ASSIGN
      754               vTmp       = SUBSTRING (iFile, 1 +
      755                   MAXIMUM (R-INDEX (iFile, "~\":U), R-INDEX (iFile, "~/":U)))
      756               vInt       = R-INDEX (vTmp, ".":U)
      757               vExt       = SUBSTRING (vTmp, vInt)
      758               vTmp       = SUBSTRING (vTmp, 1, vInt - 1)
      759               vFile      = mImageDir + vTmp + vExt
      760               mImageList = vTmp + vExt .
      761           .
      762           IF SEARCH (vFile) <> ? THEN
      763           bl0:
      764           DO:
      765               MESSAGE
      766                   "Файл с таким именем уже существует" SKIP
      767                   vFile SKIP (1)
      768                   "Сгенерировать новое имя файла и продолжить?"
      769                   VIEW-AS ALERT-BOX WARNING BUTTONS OK-CANCEL
      770                   TITLE "Предупреждение" UPDATE mLogical.
      771               IF mLogical = NO THEN RETURN NO-APPLY.
      772               DO WHILE YES:
      773                   bl1:
      774                   DO:
      775                       vInt = R-INDEX (vTmp, "#":U).
      776                       IF vInt > 0 THEN
      777                       DO:
      778                           vCh2 = SUBSTRING (vTmp, vInt + 1).
      779                           IF LENGTH (TRIM (vCh2, "0123456789":U)) = 0 THEN
      780                           DO:
      781                               ASSIGN
      782                                   vTmp  = SUBSTRING (vTmp, 1, vInt) +
      783                                       STRING (INTEGER (vCh2) + 1)
      784                                   vFile = mImageDir + vTmp + vExt
      785                                   .
      786                               LEAVE bl1.
      787                           END.
      788                       END.
      789                       ASSIGN
      790                           vTmp  = vTmp + "#1":U
      791                           vFile = mImageDir + vTmp + vExt
      792                           .
      793                   END.
      794                   IF SEARCH (vFile) = ? THEN LEAVE bl0.
      795               END.
      796           END.
      797           OS-COPY VALUE (iFile) VALUE (vFile).
      798           IF OS-ERROR <> 0 THEN
      799           DO:
      800               MESSAGE SUBSTITUTE ("Ошибка &1 копирования файла~n&2~n&3",
      801                   OS-ERROR, iFile, vFile)
      802                   VIEW-AS ALERT-BOX ERROR.
      803               RETURN NO-APPLY.
      804           END.
      805           v-IMAGE:LOAD-IMAGE (vFile) in frame d-sumgrp NO-ERROR.
      806       END.
      807   END PROCEDURE.
