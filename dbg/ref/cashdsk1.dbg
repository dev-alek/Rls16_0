     1687         end.
     1688       end.
     1689       when 'MARIA':U then do:
     1690         if p-autonomy = integer('1':U) then do:
     1691           if not can-find(first ub.cash-desk where
     1692                               ub.cash-desk.obj-code = p-obj-code
     1693                           and ub.cash-desk.pos-type  = p-pos-type
     1694                           and ub.cash-desk.autonomy  = integer('2':U)
     1695                           and ub.cash-desk.is-del  = no
     1696                           ) then do:
     1697             message
     1698             substitute("Нельзя добавить/изменить подчиненную кассу типа &1&2" +
     1699                        "На объекте не определен кассовый менеджер этого типа"
     1700                        , 'MARIA':U
     1701                        , chr(10))
     1702             view-as alert-box error .
     1703             undo, return error ''.
     1704           end.
     1705           if LOOKUP(entry(1, p-addr-path, chr(4)), "shared,local,remote,ftp":U) = 0 then do:
     1706             message
     1707             "Для кассы типа" p-pos-type
     1708             "надо ввести протокол работы с кассой - shared,local,remote,ftp!"
     1709             view-as alert-box ERROR .
     1710             undo, return error "addr-path":U.
     1711           end.
     1712           assign
     1713           v-dop-path = entry(2, p-addr-path, chr(4))
     1714           .
     1715           assign
     1716           v-dopd = decimal(entry(3, p-addr-path, chr(4) ))
     1717           no-error .
     1718           if error-status:error
     1719           or v-dopd <> round(v-dopd, 0)
     1720           or v-dopd <= 0
     1721           or string(v-dopd, '9999999999') <> entry(3, p-addr-path, chr(4))
     1722           then do:
     1723             message
     1724             substitute("Для подчиненной кассы типа &1 заводской № кассы должен быть 10-значным числом с лидирующими нулями"
     1725                       ,p-pos-type
     1726                       ,chr(10)
     1727                       )
     1728             view-as alert-box ERROR .
     1729             undo, return error "cash-num":U.
     1730           end.
     1731           v-dopd = 0.
     1732           if p-cash-num <> integer(substring(entry(3, p-addr-path, chr(4)), 7, 10)) then do:
     1733               message
     1734               substitute("Для подчиненной кассы типа &1, № кассы в IBS TH&2должен быть равен 4-ем последним цифрам заводского номера ЭККА"
     1735                         ,p-pos-type
     1736                         ,chr(10)
     1737                         )
     1738               view-as alert-box ERROR .
     1739               undo, return error "cash-num":U.
     1740           end.
     1741           CASE entry(1, p-addr-path, chr(4)):
     1742             when 'local' then do:
     1743               if not v-dop-path begins 'COM' then do:
     1744                 message
     1745                 substitute("Для кассы типа &1, работающей по протоколу &2&3" +
     1746                           "адрес должен представлять из себя номер COM-порта!"
     1747                           ,p-pos-type
     1748                           ,entry(1, p-addr-path, chr(4))
     1749                           , chr(10)
     1750                           )
     1751                 view-as alert-box ERROR .
     1752                 undo, return error "addr-path":U.
     1753               end.
     1754               for each other_cash-desk no-lock where
     1755                       other_cash-desk.db-num = p-db-num
     1756                   and other_cash-desk.obj-code = p-obj-code
     1757                   and other_cash-desk.pos-type = p-pos-type:
     1758                 if p-mode <> 'ДОБАВЛЕНИЕ':U
     1759                 and p-cash-num = other_cash-desk.cash-num then do:
     1760                   next.
     1761                 end.
     1762                 if other_cash-desk.autonomy = integer('2':U) then do:
     1763                   next.
     1764                 end.
     1765                 if entry(1, other_cash-desk.addr-path) = 'shared' then do:
     1766                   message
     1767                   substitute("На одном объекте не могут одновременно существовать кассы типа &1 подключенные как <LOCAL>  и <SHARED>"
     1768                             ,'MARIA':U)
     1769                   view-as alert-box error .
     1770                   undo, return error "addr-path":U.
     1771                 end.
     1772               end.
     1773               integer(trim (v-dop-path, 'COM')) no-error .
     1774               if error-status:error
     1775               then do:
     1776                 message
     1777                 substitute("Для кассы типа &1, работающей по протоколу &2&3" +
     1778                           "адрес должен представлять из себя номер COM-порта, записанный в виде COM[n],&3" +
     1779                           "где n - номер порта"
     1780                           ,p-pos-type
     1781                           ,entry(1, p-addr-path, chr(4))
     1782                           , chr(10)
     1783                           )
     1784                 view-as alert-box ERROR .
     1785                 undo, return error "addr-path":U.
     1786               end.
     1787             end.
     1788             when 'remote' then do:
     1789               if not v-dop-path begins 'COM' then do:
     1790                 message
     1791                 substitute("Для кассы типа &1, работающей по протоколу &2&3" +
     1792                           "адрес должен начинаться с номера COM-порта!"
     1793                           ,p-pos-type
     1794                           ,entry(1, p-addr-path, chr(4))
     1795                           , chr(10)
     1796                           )
     1797                 view-as alert-box ERROR .
     1798                 undo, return error "addr-path":U.
     1799               end.
     1800               integer(trim (entry(1, v-dop-path, '+'), 'COM1')) no-error .
     1801               if error-status:error
     1802               then do:
     1803                 message
     1804                 substitute("Для кассы типа &1, работающей по протоколу &2&3" +
     1805                           "адрес должен начинаться с номера COM-порта, записанного в виде COM[n],&3" +
     1806                           "где n - номер порта"
     1807                           ,p-pos-type
     1808                           ,entry(1, p-addr-path, chr(4))
     1809                           , chr(10)
     1810                           )
     1811                 view-as alert-box ERROR .
     1812                 undo, return error "addr-path":U.
     1813               end.
     1814               if num-entries(v-dop-path, '+') <> 2 then do:
     1815                 message
     1816                 substitute("Для кассы типа &1, работающей по протоколу &2&3" +
     1817                           "адрес должен включать номер модема, записанный в международном формате!"
     1818                           ,p-pos-type
     1819                           ,entry(1, p-addr-path, chr(4))
     1820                           , chr(10)
     1821                           )
     1822                 view-as alert-box ERROR .
     1823                 undo, return error "addr-path":U.
     1824               end.
     1825               assign
     1826               v-dopd = decimal(entry(2, v-dop-path, '+'))
     1827               no-error .
     1828               if error-status:error
     1829               or v-dopd <> round(v-dopd, 0)
     1830               or v-dopd <= 0 then do:
     1831                 message
     1832                 substitute("Для кассы типа &1, работающей по протоколу &2&3" +
     1833                           "адрес должен включать номер модема, записанный в международном формате&3" +
     1834                           " - знак '+' а далее только цифры!"
     1835                           ,p-pos-type
     1836                           ,entry(1, p-addr-path, chr(4))
     1837                           , chr(10)
     1838                           )
     1839                 view-as alert-box ERROR .
     1840                 undo, return error "addr-path":U.
     1841               end.
     1842             end.
     1843             when 'ftp' then do:
     1844             end.
     1845             when 'shared' then do:
     1846               for each other_cash-desk no-lock where
     1847                       other_cash-desk.db-num = p-db-num
     1848                   and other_cash-desk.obj-code = p-obj-code
     1849                   and other_cash-desk.pos-type = p-pos-type:
     1850                 if p-mode <> 'ДОБАВЛЕНИЕ':U
     1851                 and p-cash-num = other_cash-desk.cash-num then do:
     1852                   next.
     1853                 end.
     1854                 if other_cash-desk.autonomy = integer('2':U) then do:
     1855                   next.
     1856                 end.
     1857                 if entry(1, other_cash-desk.addr-path) = 'local' then do:
     1858                   message
     1859                   substitute("На одном объекте не могут одновременно существовать кассы типа &1 подключенные как <LOCAL>  и <SHARED>"
     1860                             ,'MARIA':U)
     1861                   view-as alert-box error .
     1862                   undo, return error "addr-path":U.
     1863                 end.
     1864               end.
     1865             end.
     1866           END CASE.
     1867         end.
     1868         if p-autonomy = integer('2':U) then do:
     1869           if p-addr-path <> '':U then do:
     1870             message substitute("Для кассового менеджера типа &1 НЕ НУЖНО ВВОДИТЬ АДРЕС-ПУТЬ И/ИЛИ ЗАВОДСКОЙ # И/ИЛИ ПАРОЛЬ И/ИЛИ ПРОТОКОЛ", p-pos-type)
     1871             view-as alert-box error .
     1872             undo, return error "addr-path":U.
     1873           end.
     1874         end.
     1875       end.
     1876     end CASE.
     1877     if (p-pos-type = 'IBM':U or
     1878         p-pos-type = 'IBM-XML':U)
     1879       and p-cash-os = "" then do:
     1880       message
     1881       "Неверный тип ОС кассы типа IBM!"
     1882       view-as alert-box ERROR .
     1883       undo, return error "cash-os":U.
     1884     end.
     1885     if (p-pos-type = 'IBS-TH':U
     1886         or
     1887         p-pos-type = 'IBS-TH-MOB':U)
     1888     and p-cash-os <> "WINDOWS" then do:
     1889       message
     1890       substitute("Неверный тип ОС кассы типа &1!", p-pos-type)
     1891       view-as alert-box ERROR .
     1892       undo, return error "cash-os":U.
     1893     end.
     1894     if (( p-cash-num <= 0 ) OR ( p-cash-num = ? ) )
     1895     and p-autonomy <> integer('2':U)
     1896     then do:
     1897       message
     1898       "Номер кассы должен быть больше 0 !"
     1899       view-as alert-box ERROR .
     1900       undo, return error "cash-num":U.
     1901     end.
     1902     if (( p-cash-num <> 0 ) OR ( p-cash-num = ? ) )
     1903     and p-autonomy = integer('2':U)
     1904     then do:
     1905       message
     1906       "Номер кассового менеджера должен = 0 !"
     1907       view-as alert-box ERROR .
     1908       undo, return error "cash-num":U.
     1909     end.
     1910     if p-cash-num > 999 and
     1911     LOOKUP(p-pos-type, 'IBM':U + chr(44) + 'IBM-XML':U) > 0 then do:
     1912       message
     1913       substitute("Номер кассы типа &1 должен быть меньше < 999 ! ", p-pos-type)
     1914       view-as alert-box ERROR .
     1915       undo, return error "cash-num":U.
     1916     end.
     1917     if can-find( FIRST buf_cash-desk WHERE
     1918                       buf_cash-desk.obj-code = p-obj-code
     1919                   AND buf_cash-desk.cash-num = p-cash-num
     1920                   AND (p-mode = 'ДОБАВЛЕНИЕ':U or
     1921                       recid(buf_cash-desk ) <> p-doc-rec )
     1922                 ) then do:
     1923       message
     1924       "В магазине с номером" p-obj-code skip
     1925       "уже есть касса с номером" p-cash-num
     1926       view-as alert-box ERROR .
     1927       undo, return error "cash-num":U.
     1928     end.
     1929     if p-cash-num <> 0 then do:
     1930       FIND FIRST buf_cash-desk WHERE
     1931                 buf_cash-desk.cash-num = p-cash-num
     1932             AND buf_cash-desk.db-num = v-db-num
     1933             AND (recid( buf_cash-desk ) <> p-doc-rec
     1934             or
     1935                 p-mode = 'ДОБАВЛЕНИЕ':U) NO-LOCK NO-ERROR.
     1936       if available buf_cash-desk then do:
     1937         message
     1938         "Уже имеется касса с номером" buf_cash-desk.cash-num skip
     1939         "в магазине" buf_cash-desk.obj-code skip
     1940         "БД" v-db-num skip(1)
     1941         "Продолжать ?"
     1942         view-as alert-box WARNING buttons yes-no update ans .
     1943         if NOT ans then do:
     1944           undo, return error "":U.
     1945         end.
     1946       end.
     1947     end.
     1948     if p-addr-path <> "":U then do:
     1949       find FIRST buf_cash-desk WHERE
     1950                 buf_cash-desk.addr-path = p-addr-path
     1951             AND buf_cash-desk.db-num = p-db-num
     1952             AND buf_cash-desk.is-del = no
     1953             AND (p-mode = 'ДОБАВЛЕНИЕ':U
     1954                 or
     1955                 recid( buf_cash-desk ) <> p-doc-rec) NO-LOCK NO-ERROR.
     1956       IF AVAIL buf_cash-desk then do:
     1957         ans = FALSE .
     1958         message
     1959         "Уже имеется касса с адресом " p-addr-path
     1960         "Касса номер" buf_cash-desk.cash-num SKIP
     1961         "магазин" buf_cash-desk.obj-code skip
     1962         "БД" buf_cash-desk.db-num skip(1)
     1963         "Продолжать ?"
     1964         view-as alert-box WARNING buttons yes-no update ans .
     1965         if NOT ans then do:
     1966           undo, return error "":U.
     1967         end.
     1968         else do:
     1969           if LOOKUP(p-pos-type, 'IBM':U + chr(44) + 'IBM-XML':U + chr(44) + 'Autotank':U) > 0
     1970           or
     1971           LOOKUP(buf_cash-desk.pos-type, 'IBM':U + chr(44) + 'IBM-XML':U + chr(44) + 'Autotank':U) > 0
     1972           then do:
     1973             FIND FIRST buf_shop NO-LOCK WHERE
     1974                       buf_shop.obj-code = p-obj-code NO-ERROR.
     1975             run adm/shattri.p (
     1976                 input "get":U
     1977                 ,input  'орг':U
     1978                 ,input  buf_shop.host-code
     1979                 ,input  'get-chk':U
     1980                 ,input  'hnum':U
     1981                 ,output v-value-character
     1982                 ,output v-value-date
     1983                 ,output v-value-decimal
     1984                 ,output v-value-integer
     1985                 ,output v-value-logical
     1986                 ,output v-param-type
     1987                 ,INPUT-OUTPUT table-handle v-tth
     1988                 ) no-error .
     1989             IF error-status:error then do:
     1990               delete object v-tth.
     1991               message
     1992               substitute("Ошибка при получении опций закачки чеков НА ОБЪЕКТЕ &1&2:&3&4 &5"
     1993                         , 'орг':U
     1994                         , buf_shop.host-code
     1995                         , chr(10)
     1996                         , error-status:get-message(1)
     1997                         , return-value )
     1998               view-as alert-box error .
     1999               return error.
     2000             end.
     2001             delete object v-tth.
     2002             hnum = v-value-logical.
     2003             FIND FIRST buf_shop NO-LOCK WHERE
     2004                     buf_shop.obj-code = buf_cash-desk.obj-code NO-ERROR.
     2005             run adm/shattri.p (
     2006                 input "get":U
     2007                 ,input  'орг':U
     2008                 ,input  buf_shop.host-code
     2009                 ,input  'get-chk':U
     2010                 ,input  'hnum':U
     2011                 ,output v-value-character
     2012                 ,output v-value-date
     2013                 ,output v-value-decimal
     2014                 ,output v-value-integer
     2015                 ,output v-value-logical
     2016                 ,output v-param-type
     2017                 ,INPUT-OUTPUT table-handle v-tth
     2018                 ) no-error .
     2019             IF error-status:error then do:
     2020               delete object v-tth.
     2021               message
     2022               substitute("Ошибка при получении опций закачки чеков НА ОБЪЕКТЕ &1&2:&3&4 &5"
     2023                         , 'орг':U
     2024                         , buf_shop.host-code
     2025                         , chr(10)
     2026                         , error-status:get-message(1)
     2027                         , return-value )
     2028               view-as alert-box error .
     2029               return error.
     2030             end.
     2031             delete object v-tth.
     2032             b-hnum = v-value-logical.
     2033             if (hnum or b-hnum) AND (p-obj-code > 999 OR  buf_cash-desk.obj-code > 999) then do:
     2034               message
     2035               "Касса типа IBM c адресом " buf_cash-desk.addr-path skip
     2036               "не может работать  с магазинами, у которых номер больше 999!" skip
     2037               "(параметр НОМЕР МАГАЗИНА ДЛЯ ЧЕКОВ БРАТЬ ИЗ СПУЛОВ для фирмы этого магазина установлен в YES)"
     2038               view-as alert-box ERROR.
     2039               undo, return error "add-path":U.
     2040             end.
     2041             if NOT hnum or not b-hnum then do:
     2042               message
     2043               substitute("Касса типа &1 c адресом &2 не может работать с магазином,&3" +
     2044                         "пока параметр НОМЕР МАГАЗИНА ДЛЯ ЧЕКОВ БРАТЬ ИЗ СПУЛОВ для фирмы магазина &4 не установлен в YES!"
     2045                         , p-pos-type
     2046                         , buf_cash-desk.addr-path
     2047                         , chr(10)
     2048                         , (if not hnum then p-obj-code else buf_cash-desk.obj-code)
     2049                         )
     2050               view-as alert-box ERROR.
     2051               undo, return error "addr-path":U.
     2052             end.
     2053           end.
     2054         end.
     2055       end.
     2056     end.
     2057   end.
     2058   _MAIN:
     2059   DO ON ERROR UNDO, RETURN ERROR return-value
     2060   ON STOP UNDO, RETURN ERROR return-value :
     2061     if p-autonomy <> integer('2':U)
     2062     and (p-mode = 'ДОБАВЛЕНИЕ':U or p-is-del = no)
     2063     then  do:
     2064   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     2065     (input  'num-cd'
     2066     ,input  ''
     2067     ,input  ''
     2068     ,input  0
     2069     ,input  ''
     2070     ,input  ''
     2071     ,input  '':U
     2072     ,input  yes
     2073     ,output conf-par
     2074     ,output par-type
     2075     ) no-error .
     2076       if error-status:error then undo _main, return error return-value .
     2077       if par-type <> "I" then do:
     2078         message
     2079         "Неправильный тип параметра num-cd (должно быть integer)."
     2080         view-as alert-box error.
     2081         undo _main, return error "":U.
     2082       end.
     2083       assign
     2084       num-cd = integer(conf-par)
     2085       no-error .
     2086       if error-status:error then do:
     2087         message
     2088         substitute("Неправильное значение параметра num-cd:&1 (должно быть integer).", conf-par)
     2089         view-as alert-box error.
     2090         undo _main, return error "":U.
     2091       end.
     2092       for each buf_cash-desk no-lock where
     2093               buf_cash-desk.db-num = v-db-num:
     2094         if buf_cash-desk.autonomy = integer('2':U)
     2095         or buf_cash-desk.is-del = yes
     2096         or buf_cash-desk.pos-type = 'InfoKiosk':U
     2097         or buf_cash-desk.pos-type = 'pricecheck-Servis+':U
     2098         then next.
     2099         find first temp-cash-desk where
     2100                  temp-cash-desk.db-num = buf_cash-desk.db-num
     2101              and temp-cash-desk.obj-code = buf_cash-desk.obj-code
     2102              and temp-cash-desk.cash-num = buf_cash-desk.cash-num
     2103              and temp-cash-desk.pos-type = buf_cash-desk.pos-type no-error .
     2104         if not available temp-cash-desk then do:
     2105           create temp-cash-desk.
     2106           buffer-copy
     2107           buf_cash-desk to temp-cash-desk
     2108           .
     2109          if buf_cash-desk.pos-type = 'NCR-GM':U
     2110           or buf_cash-desk.pos-type = 'NCR-AS@R':U then do:
     2111             assign
     2112             temp-cash-desk.addr-path = string(buf_cash-desk.cash-num).
     2113           end.
     2114         end.
     2115           if temp-cash-desk.cash-on then do:
     2116           assign
     2117           ii-num-cd = ii-num-cd + 1
     2118           .
     2119           end.
     2120       end.
     2121       if p-mode = 'ДОБАВЛЕНИЕ':U then do:
     2122         if not p-is-del then do:
     2123           create temp-cash-desk.
     2124           assign
     2125           temp-cash-desk.db-num = p-db-num
     2126           temp-cash-desk.obj-code = p-obj-code
     2127           temp-cash-desk.cash-num = p-cash-num
     2128           temp-cash-desk.pos-type  = p-pos-type
     2129           temp-cash-desk.addr-path = p-addr-path
     2130           temp-cash-desk.cash-on   = p-cash-on
     2131           temp-cash-desk.cash-os   = p-cash-os
     2132           temp-cash-desk.remote    = p-remote
     2133           temp-cash-desk.version   = p-version
     2134           temp-cash-desk.autonomy  = p-autonomy
     2135           temp-cash-desk.is-del    = p-is-del
     2136           .
     2137           if temp-cash-desk.cash-on then do:
     2138           assign
     2139           ii-num-cd = ii-num-cd + 1
     2140           .
     2141           end.
     2142         end.
     2143       end.
     2144       for each temp-cash-desk
     2145       where temp-cash-desk.db-num  = v-db-num
     2146       break
     2147       by temp-cash-desk.obj-code:
     2148         if first-of(temp-cash-desk.obj-code) then do:
     2149           v-is-tpsi-obj = no.
     2150           run is-tpsi-object in this-procedure (
     2151                                                 input 'маг':U
     2152                                               ,input temp-cash-desk.obj-code
     2153                                               ,output v-is-tpsi-obj ).
     2154         end.
     2155         if v-is-tpsi-obj then
     2156         temp-cash-desk.tpsi-obj = yes.
     2157       end.
     2158       for each temp-cash-desk where
     2159       temp-cash-desk.db-num  = v-db-num
     2160       and  temp-cash-desk.tpsi-obj = yes
     2161       break
     2162       by temp-cash-desk.addr-path
     2163       :
     2164         if temp-cash-desk.addr-path <> '':U then do:
     2165           if first-of(temp-cash-desk.addr-path) then do:
     2166           end.
     2167           else do:
     2168             ii-num-cd = ii-num-cd - 1.
     2169           end.
     2170         end.
     2171       end.
     2172       if ii-num-cd > num-cd
     2173       then do:
     2174         message
     2175         substitute("Превышено максимальное количество включенных касс в БД: &1", num-cd)
     2176         view-as alert-box error .
     2177         undo _main, return error substitute("Превышено максимальное количество включенных касс в БД: &1", num-cd).
     2178       end.
     2179     end.
     2180     if p-pos-type = 'MARIA':U
     2181     then do:
     2182       if p-autonomy = integer('1':U) then
     2183       find first man_cash-desk exclusive-lock where
     2184                 man_cash-desk.obj-code = p-obj-code
     2185             and man_cash-desk.pos-type = p-pos-type
     2186             and man_cash-desk.autonomy = integer('2':U) .
     2187       for each mar_cash-desk where
     2188                mar_cash-desk.obj-code = p-obj-code
     2189             and mar_cash-desk.pos-type = p-pos-type
     2190             and mar_cash-desk.autonomy = integer('1':U)
     2191             and mar_cash-desk.is-del   = no:
     2192         if mar_cash-desk.cash-num = p-cash-num then next.
     2193         assign
     2194         v-cd-list = v-cd-list + (if v-cd-list = '':U then '':U else chr(44)) + string(mar_cash-desk.cash-num).
     2195       end.
     2196     end.
     2197     if p-pos-type = 'IBS-TH':U then do:
     2198       if p-fr-type = ''
     2199       or p-fr-type = ?
     2200       or lookup(p-fr-type, 'shtrih-fr-k-01,prim08tk':U) = 0 then do:
     2201         message
     2202         "Не задан или неверный тип ФР"
     2203         view-as alert-box error .
     2204         undo, return error 'fr-type'.
     2205       end.
     2206       if p-serial-code = "" then do:
     2207         message
     2208         "Не задан серийный номер"
     2209         view-as alert-box error .
     2210         undo, return error 'serial-code'.
     2211       end.
     2212       if trim(p-serial-code, "0123456789") <> '' then do:
     2213         message
     2214         "Серийный номер может включать только цифры!"
     2215         view-as alert-box error .
     2216         undo, return error 'serial-code'.
     2217       end.
     2218     end.
     2219     if p-mode = 'ДОБАВЛЕНИЕ':U then do:
     2220       create ub.cash-desk.
     2221       assign
     2222       ub.cash-desk.db-num = p-db-num
     2223       ub.cash-desk.obj-code = p-obj-code
     2224       ub.cash-desk.cash-num = p-cash-num
     2225       ub.cash-desk.pos-type = p-pos-type
     2226       p-doc-rec = recid(ub.cash-desk)
     2227       .
     2228     end.
     2229     else do:
     2230       FIND FIRST ub.cash-desk where
     2231                 recid(ub.cash-desk) = p-doc-rec No-ERROR.
     2232       if not available ub.cash-desk then do:
     2233         message
     2234         vss-workfile vss-revision vss-description skip
     2235         "Не найдена запись КАССА - p-doc-rec" p-doc-rec
     2236         view-as alert-box error .
     2237         undo, return error '':u.
     2238       end.
     2239       if ub.cash-desk.db-num <> p-db-num
     2240       OR ub.cash-desk.obj-code <> p-obj-code
     2241       OR ub.cash-desk.cash-num <> p-cash-num
     2242       then do:
     2243         message
     2244         vss-workfile vss-revision vss-description skip
     2245         "Для уже имеющейся записи нельзя изменить"
     2246         "номер БД, номер магазина, номер кассы" skip
     2247         view-as alert-box ERROR.
     2248         undo, return error '':U.
     2249       end.
     2250       else if ub.cash-desk.pos-type <> p-pos-type
     2251       then do:
     2252          define buffer buf_cash-desk-attr for ub.cash-desk-attr.
     2253          for each buf_cash-desk-attr where buf_cash-desk-attr.db-num   eq ub.cash-desk.db-num
     2254                                        and buf_cash-desk-attr.obj-code eq ub.cash-desk.obj-code
     2255                                        and buf_cash-desk-attr.cash-num eq ub.cash-desk.cash-num
     2256                                        and buf_cash-desk-attr.pos-type eq ub.cash-desk.pos-type
     2257          exclusive-lock:
     2258             buf_cash-desk-attr.pos-type = p-pos-type.
     2259          end.
     2260          ub.cash-desk.pos-type = p-pos-type.
     2261       end.
     2262     end.
     2263     assign
     2264     ub.cash-desk.addr-path = p-addr-path
     2265     ub.cash-desk.cash-on   = (if p-is-del then no else p-cash-on)
     2266     ub.cash-desk.cash-os   = p-cash-os
     2267     ub.cash-desk.remote    = p-remote
     2268     ub.cash-desk.version   = p-version
     2269     ub.cash-desk.autonomy  = p-autonomy
     2270     ub.cash-desk.is-del    = (if p-is-del then not ub.cash-desk.is-del else no)
     2271     ub.cash-desk.registration-code = p-registration-code
     2272     ub.cash-desk.serial-code = p-serial-code
     2273     ub.cash-desk.fr-type = p-fr-type
     2274     ub.cash-desk.device-kind = p-device-kind
     2275     .
     2276     if p-is-del = no
     2277     then
     2278     assign
     2279     v-cd-list = v-cd-list + (if v-cd-list = '':U then '':U else chr(44)) +
     2280                string(ub.cash-desk.cash-num).
     2281     if p-pos-type = 'MARIA':U then do:
     2282       if p-autonomy = integer('2':U) then do:
     2283         ub.cash-desk.addr-path = v-cd-list.
     2284       end.
     2285       else do:
     2286         man_cash-desk.addr-path = v-cd-list.
     2287       end.
     2288     end.
     2289     release ub.cash-desk no-error.
     2290     if error-status:error then do:
     2291       message
     2292       vss-workfile vss-revision vss-description skip
     2293       "Ошибка при сохранении записи КАССЫ" skip
     2294       ERROR-STATUS:GET-NUMBER(1) skip
     2295       view-as alert-box .
     2296       undo, return error "":U.
     2297     end.
     2298     if p-pos-type = 'IBS-TH':U
     2299     and p-mode = 'ДОБАВЛЕНИЕ':U
     2300     then do:
     2301       FOR EACH thbjattr_thbj-attr:
     2302         delete thbjattr_thbj-attr.
     2303       end.
     2304       run adm/shattri.p (
     2305                     input "init":U
     2306                   , input 'маг':U
     2307                   , input p-obj-code
     2308                   , input 'cd-type-IBS-TH':U
     2309                   , input "":U
     2310                   , output v-value-character
     2311                   , output v-value-date
     2312                   , output v-value-decimal
     2313                   , output v-value-integer
     2314                   , output v-value-logical
     2315                   , output v-param-type
     2316                   , INPUT-OUTPUT TABLE-handle v-tth
     2317                   ) no-error .
     2318      if error-status:error then do:
     2319        message
     2320        vss-workfile vss-revision vss-description skip
     2321        "Ошибка при получении настроек кассы по умолчанию"
     2322        error-status:get-message(1) skip
     2323        return-value
     2324        view-as alert-box .
     2325        undo, return error ''.
     2326      end.
     2327       for each thbjattr_thbj-attr
     2328       break
     2329       by thbjattr_thbj-attr.upper-prop-code
     2330       on error  undo _main, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     2331       on stop   undo _main, return error substitute( "&1. stop", vss-workfile )
     2332       on endkey undo _main, return error substitute( "&1. endkey", vss-workfile )
     2333       :
     2334        if thbjattr_thbj-attr.upper-prop-code <> 'cd-type-IBS-TH':U
     2335        then do:
     2336          run update-cda in this-procedure ( buffer thbjattr_thbj-attr) no-error .
     2337          if error-status:error then do:
     2338             message
     2339             vss-workfile vss-revision vss-description skip
     2340             "Ошибка при записи настроек кассы по умолчанию"
     2341             error-status:get-message(1) skip
     2342             return-value
     2343             view-as alert-box .
     2344             undo, return error ''.
     2345          end.
     2346        end.
     2347       end.
     2348     end.
     2349   end.
     2350   procedure update-cda :
     2351   define parameter buffer buf_thbjattr_thbj-attr for thbjattr_thbj-attr.
     2352   define buffer buf_cash-desk-attr for ub.cash-desk-attr.
     2353   do
     2354   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     2355   :
     2356     find first   buf_cash-desk-attr share-lock where
     2357           buf_cash-desk-attr.db-num = p-db-num
     2358       and buf_cash-desk-attr.obj-code = p-obj-code
     2359       and buf_cash-desk-attr.pos-type = p-pos-type
     2360       and buf_cash-desk-attr.cash-num = p-cash-num
     2361       and buf_cash-desk-attr.upper-attr-code = buf_thbjattr_thbj-attr.upper-prop-code
     2362     and buf_cash-desk-attr.attr-code = buf_thbjattr_thbj-attr.prop-code
     2363     no-error.
     2364     if not available buf_Cash-desk-attr then do:
     2365       create buf_cash-desk-attr.
     2366       assign
     2367       buf_cash-desk-attr.db-num = p-db-num
     2368       buf_cash-desk-attr.obj-code = p-obj-code
     2369       buf_cash-desk-attr.pos-type = p-pos-type
     2370       buf_cash-desk-attr.cash-num = p-cash-num
     2371       buf_cash-desk-attr.upper-attr-code = buf_thbjattr_thbj-attr.upper-prop-code
     2372       buf_cash-desk-attr.attr-code = buf_thbjattr_thbj-attr.prop-code
     2373       .
     2374     end.
     2375     assign
     2376     buf_cash-desk-attr.attr-value-character = buf_thbjattr_thbj-attr.property-value-character
     2377     buf_cash-desk-attr.attr-value-date = buf_thbjattr_thbj-attr.property-value-date
     2378     buf_cash-desk-attr.attr-value-decimal = buf_thbjattr_thbj-attr.property-value-decimal
     2379     buf_cash-desk-attr.attr-value-integer = buf_thbjattr_thbj-attr.property-value-integer
     2380     buf_cash-desk-attr.attr-value-logical = buf_thbjattr_thbj-attr.property-value-logical
     2381     buf_cash-desk-attr.attr-value-type = buf_thbjattr_thbj-attr.prop-value-type
     2382     .
     2383     release buf_cash-desk-attr no-error.
     2384     if error-status:error then do:
     2385       undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1)).
     2386     end.
     2387   end.
     2388   end procedure.
