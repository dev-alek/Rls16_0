     1421                  , chr(10)
     1422                  , 'IBM-XML':U
     1423                  , 'NCR-GM':U
     1424                  , 'NCR-AS@R':U
     1425                  , 'MAGIA-XML':U
     1426                  , 'MARIA':U
     1427                  , 'Autotank':U
     1428                  )
     1429       view-as alert-box error .
     1430       undo, return error "autonomy":U.
     1431     end.
     1432     if p-pos-type <> 'IBM-XML':U
     1433     and p-pos-type <> 'NCR-GM':U
     1434     and p-pos-type <> 'NCR-AS@R':U
     1435     and p-pos-type <> 'MAGIA-XML':U
     1436     and p-pos-type <> 'MARIA':U
     1437     and p-pos-type <> 'Autotank':U
     1438     and p-autonomy = integer('1':U) then do:
     1439       message
     1440       substitute("В настоящее время поддерживается работа с подчиненными кассами только типа&1&2 &3 &4 &5 &6"
     1441                  ,chr(10)
     1442                  ,'IBM-XML':U
     1443                  ,'NCR-GM':U
     1444                  ,'NCR-AS@R':U
     1445                  ,'MAGIA-XML':U
     1446                  ,'MARIA':U
     1447                  ,'Autotank':U )
     1448       view-as alert-box error .
     1449       undo, return error "autonomy":U.
     1450     end.
     1451     if p-pos-type = 'IBM-XML':U then do:
     1452       CASE p-autonomy:
     1453         when integer('0':U) then do:
     1454           find first other_cash-desk no-lock where
     1455                     other_cash-desk.db-num = p-db-num
     1456                 AND other_cash-desk.obj-code = p-obj-code
     1457                 AND other_cash-desk.pos-type = p-pos-type
     1458                 AND other_cash-desk.autonomy <> integer('0':U)
     1459                 and other_cash-desk.is-del = no
     1460                 no-error .
     1461         end.
     1462         otherwise do:
     1463           find first other_cash-desk no-lock where
     1464                     other_cash-desk.db-num = p-db-num
     1465                 AND other_cash-desk.obj-code = p-obj-code
     1466                 AND other_cash-desk.pos-type = p-pos-type
     1467                 AND other_cash-desk.autonomy = integer('0':U)
     1468                 and other_cash-desk.is-del = no
     1469                 no-error .
     1470         end.
     1471       END CASE.
