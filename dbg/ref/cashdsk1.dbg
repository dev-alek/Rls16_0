     1517       and p-pos-type <> 'pricecheck-Servis+':U
     1518       and p-pos-type <> 'r-keeper':U
     1519       and p-pos-type <> 'IBS-TH':U
     1520       and p-pos-type <> 'IBS-TH-MOB':U
