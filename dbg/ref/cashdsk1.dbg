     1664             "надо указать IP адрес и порт в формате NNN.NNN.NNN.NNN:PPPP или DNS-имя кассы и порт в формате DNS:PPPP"
     1665             view-as alert-box ERROR .
     1666             undo, return error "addr-path":U.
     1667           end.
     1668           integer(  entry(2, l-ipaddr, ":")  ) no-error .
     1669           if error-status:error then do:
     1670             message
     1671             "Для кассового менеджера типа" p-pos-type
     1672             "порт в IP адресе кассы должен быть цифровым"
     1673             view-as alert-box ERROR .
     1674             undo, return error "addr-path":U.
     1675           end.
     1676         end.
     1677       end.
     1678       when 'IPC-Servis+':U
     1679       or
     1680       when 'OMRON-NEW':U then do:
