     1411            OR
     1412            p-pos-type = 'MAGIA-XML':U
     1413            OR
     1414            p-pos-type = 'MARIA':U
     1415            OR
     1416            p-pos-type = 'Autotank':U
     1417            )
     1418     and p-autonomy = integer('2':U) then do:
