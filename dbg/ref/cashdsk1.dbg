     1596             "не надо вводить ПУТЬ(АДРЕС) и протокол работы с кассой"
     1597             view-as alert-box ERROR .
     1598             undo, return error "addr-path":U.
     1599          end.
     1600         end.
     1601         else do:
     1602           if p-autonomy = integer('1':U) then do:
     1603             if LOOKUP(entry(1, p-addr-path, chr(4)), "http,ftp,samba,SMTP":U) = 0 then do:
     1604               message
     1605               "Для подчиненной кассы типа" p-pos-type
     1606               "надо ввести протокол работы с кассой - http,ftp,samba,SMTP!"
     1607               view-as alert-box ERROR .
     1608               undo, return error "addr-path":U.
     1609             end.
     1610           end.
     1611           if p-autonomy = integer('0':U) then do:
     1612             if entry(1, p-addr-path, chr(4)) <>  "http":U then do:
     1613               message
     1614               "Для автономной кассы типа" p-pos-type
     1615               "можно ввести только один протокол работы с кассой - http!"
     1616               view-as alert-box ERROR .
     1617               undo, return error "addr-path":U.
     1618             end.
     1619           end.
     1620           l-ipaddr = entry(2, p-addr-path, chr(4)) .
     1621           if num-entries(l-ipaddr, ":") <> 2 then do:
     1622             message
     1623             "Для автономной кассы типа" p-pos-type
     1624             "надо указать IP адрес и порт в формате NNN.NNN.NNN.NNN:PPPP или DNS-имя кассы и порт в формате DNS:PPPP"
     1625             view-as alert-box ERROR .
     1626             undo, return error "addr-path":U.
     1627           end.
     1628           integer(  entry(2, l-ipaddr, ":")  ) no-error .
     1629           if error-status:error then do:
     1630             message
     1631             "Для автономной кассы типа" p-pos-type
