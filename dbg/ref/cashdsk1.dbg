     1582     define variable l-ipaddr as character no-undo .
     1583     CASE p-pos-type:
     1584       when 'NCR-GM':U or
     1585       when 'MAGIA-XML':U then .
     1586       when 'IBM':U or
     1587       when 'OMRON':U or
     1588       when 'Emulator-NKT-IBM':U then do:
     1589       end.
     1590       when 'IBM-XML':U then do:
     1591         if p-autonomy = integer('2':U)
     1592         then do:
     1593           if p-addr-path <> "":U then do:
