      376   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      377   procedure is-tpsi-object :
      378   define input parameter p-obj-type like ub.clients.obj-type no-undo .
      379   define input parameter p-obj-code like ub.clients.obj-code no-undo .
      380   define output parameter p-is-tpsi-object as logical no-undo .
      381   define variable vss-description as character no-undo init "is-tpsi-object-01: получение признака объекта - участвует в TPSI".
      382   define variable conf-par as character no-undo .
      383   define variable par-type as character no-undo .
      384   define variable v-attr-value as character no-undo .
      385   define variable v-attr-type as character no-undo .
      386   define variable v-is-tpsi-object as logical no-undo .
      387   define buffer buf_clients for ub.clients.
      388     do
      389     on error undo, return error
      390     :
      391       find first buf_clients no-lock where
      392                 buf_clients.obj-type = p-obj-type
      393             AND buf_clients.obj-code = p-obj-code no-error .
      394       if not available buf_clients then do:
      395         return error substitute("&1 &2&3 не найден объект", vss-description, p-obj-type, p-obj-code).
      396       end.
      397       if not (buf_clients.db-num = g#db-num  or g#db-num = 0) then do:
      398         return error substitute("&1 &2&3 нельзя определить значение свойства УЧАСТВУЕТ В ТСПИ не в ГБД и не в свое УБД", vss-description, p-obj-type, p-obj-code).
      399       end.
      400       run clntattr-value  in this-procedure (
      401             input  'орг':U
      402           ,input   buf_clients.host-code
      403           ,input   'als-gds':U
      404           ,output v-attr-value
      405           ,output v-attr-type
      406                                               ) no-error .
      407       if not error-status:error
      408       and logical (v-attr-value) = yes then do:
      409         assign
      410         v-is-tpsi-object = yes
      411         .
