        1   define output parameter p-old as character no-undo .
        2   define output parameter p-new as character no-undo .
        3   define variable vss-revision    as character no-undo init "$Revision$":U .
        4   define variable vss-author      as character no-undo init "$Author$":U .
        5   define variable vss-date        as character no-undo init "$Date$":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        7   define variable vss-archive     as character no-undo init "$Archive$":U .
        8   define variable vss-description as character no-undo init "Определение перехода ИЖТ".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   define new global shared variable g#library  as handle no-undo .
       68   define new global shared variable g#library2 as handle no-undo .
       69   define   shared variable g#auto as logical no-undo.
       70   define   shared variable g#news as logical no-undo.
       71   define   shared variable g#oxml as logical no-undo.
       72   define   shared variable g#esys as logical no-undo.
       73   define   shared variable g#news-source-db as integer no-undo.
       74   define   shared variable g#esys-source-esys as integer no-undo.
       75   define   shared variable g#db-num as integer   no-undo .
       76   define   shared variable g#userid as character no-undo .
       77   define   shared variable g#passwd as character no-undo .
       78   procedure proc-alt-shift-f2:
       79     if not ibs.th.gbl.gbl-var:rcode
       80   then
       81     run gbl\inidebug.p .
       82   end.
       83   procedure proc-alt-shift-f3:
       84     run gbl/prvssinf.p
       85       ( input this-procedure
       86       ) .
       87   end.
       88   define variable v-inform-launched as logical no-undo initial false .
       89   procedure proc-alt-shift-f4:
       90     define variable v-action as character no-undo .
       91     if v-inform-launched = false then do:
       92       assign
       93         v-inform-launched = true
       94       .
       95       run gbl/d-inform.w
       96         (  input self
       97         ,  input this-procedure
       98         , output v-action
       99         ) no-error .
      100       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      101       assign
      102         v-inform-launched = false
      103       .
      104     end.
      105   end.
      106   procedure proc-alt-f1:
      107     run gbl/corrhelp.p
      108       (input this-procedure
      109       ) .
      110   end .
      111   on alt-shift-f2 anywhere do:
      112     run proc-alt-shift-f2.
      113   end.
      114   on alt-shift-f3 anywhere do:
      115     run proc-alt-shift-f3 in this-procedure .
      116   end.
      117   on alt-shift-f4 anywhere do:
      118     run proc-alt-shift-f4 in this-procedure.
      119   end.
      120   on alt-f1 anywhere do:
      121     run proc-alt-f1 in this-procedure .
      122   end.
      123   p-old = "" .
      124   p-new = "" .
      125   DEFINE BUTTON B-Cancel AUTO-END-KEY
      126        LABEL "&Отмена"
      127        SIZE 10 BY 1
      128        BGCOLOR 8 .
      129   DEFINE BUTTON B-Help
      130        LABEL "Помо&щь"
      131        SIZE 12 BY 1
      132        BGCOLOR 8 .
      133   DEFINE BUTTON B-save AUTO-GO
      134        LABEL "&Ввод"
      135        SIZE 10 BY 1
      136        BGCOLOR 8 .
      137   DEFINE VARIABLE FILL-IN-1 AS CHARACTER FORMAT "X(256)":U INITIAL "Текущий ИЖТ:"
      138         VIEW-AS TEXT
      139        SIZE 14 BY .67
      140        FGCOLOR 4  NO-UNDO.
      141   DEFINE VARIABLE FILL-IN-2 AS CHARACTER FORMAT "X(256)":U INITIAL "Новый ИЖТ:"
      142         VIEW-AS TEXT
      143        SIZE 14 BY .67
      144        FGCOLOR 4  NO-UNDO.
      145   DEFINE VARIABLE R-new AS CHARACTER
      146        VIEW-AS RADIO-SET VERTICAL
      147        RADIO-BUTTONS
      148             "Основная группа", "2",
      149   "На вывод из ассортимента", "3"
      150        SIZE 29.5 BY 2.25 NO-UNDO.
      151   DEFINE VARIABLE R-old AS CHARACTER
      152        VIEW-AS RADIO-SET VERTICAL
      153        RADIO-BUTTONS
      154             "Новинка", "1",
      155   "Основная группа", "2"
      156        SIZE 29 BY 2.25 NO-UNDO.
      157   DEFINE FRAME Dialog-Frame
      158        B-save AT ROW 1 COL 1
      159        B-Cancel AT ROW 1 COL 11
      160        B-Help AT ROW 1 COL 53
      161        R-old AT ROW 3.75 COL 13 NO-LABEL
      162        R-new AT ROW 8.75 COL 13 NO-LABEL
      163        FILL-IN-1 AT ROW 2.75 COL 3 COLON-ALIGNED NO-LABEL
      164        FILL-IN-2 AT ROW 7.75 COL 3 COLON-ALIGNED NO-LABEL
      165        SPACE(46.12) SKIP(3.86)
      166       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      167            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      168            TITLE "Определение перехода ИЖТ у товаров"
      169            DEFAULT-BUTTON B-save CANCEL-BUTTON B-Cancel.
      170   ASSIGN
      171          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      172          FRAME Dialog-Frame:HIDDEN           = TRUE.
      173   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      174   DO:
      175     APPLY "END-ERROR":U TO SELF.
      176   END.
      177   ON CHOOSE OF B-Cancel IN FRAME Dialog-Frame
      178   DO:
      179     RETURN "no" .
      180   END.
      181   ON CHOOSE OF B-save IN FRAME Dialog-Frame
      182   DO:
      183     ASSIGN R-new R-old.
      184     if R-new =  R-old then do:
      185        MESSAGE "Вы выбрали одинаковые ИЖТ : " R-old  view-as alert-box information .
      186        return no-apply.
      187     end.
      188     p-old = r-old .
      189     p-new = r-new .
      190   END.
      191   ON VALUE-CHANGED OF R-old IN FRAME Dialog-Frame
      192   DO:
      193     ASSIGN r-old .
      194     IF r-old = 'Основная группа':U THEN DO:
      195         r-new = 'На вывод из ассортимента':U.
      196         DISPLAY r-new with FRAME Dialog-Frame.
      197         END.
      198   END.
      199   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      200   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      201   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      202   on help of frame Dialog-Frame
      203   do:
      204     run gbl/app_help.p
      205       (input this-procedure :file-name
      206       ,input ''
      207       ,input ?
      208       ) no-error.
      209     if error-status :error then do:
      210       message
      211         "Ошибка при вызове помощи"
      212         error-status :get-message(1)
      213         view-as alert-box .
      214     end.
      215   end.
      216   run minbtn-set in this-procedure .
      217   on choose of b-help in frame Dialog-Frame
      218   do:
      219     apply "help":u to frame Dialog-Frame .
      220   end.
      221   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      222   procedure minbtn-set :
      223       do
      224           on error undo, return error return-value
      225           :
      226           define variable ii              as integer       no-undo .
      227           define variable fh              as widget-handle no-undo .
      228           define variable hh              as widget-handle no-undo .
      229           define variable v-h             as handle        extent 4 no-undo .
      230           define variable v-name-button   as character     no-undo .
      231           define variable v-help-old-x    as decimal       no-undo .
      232           define variable v-help-old-y    as decimal       no-undo .
      233           define variable v-help-old-size as decimal       no-undo .
      234           define variable v-frame-width   as decimal       no-undo .
      235           define variable jj              as integer       no-undo .
      236           do
      237               on error undo, return error
      238               :
      239               assign
      240                   v-frame-width = frame Dialog-Frame:width - 0.3
      241                   fh            = frame Dialog-Frame:first-child
      242                   hh            = fh:first-child
      243                   ii            = 1
      244                   .
      245               do while valid-handle(hh):
      246                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      247                   do:
      248                       case lc(hh:name) :
      249                           when "b-help" then
      250                               do:
      251                                   hh:load-image-up("cmp/b-help.bmp":u) .
      252                                   hh:load-image-down("cmp/b-help.bmp":u) .
      253                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      254                                   hh:TOOLTIP = "Помощь" .
      255                                   v-help-old-x = hh:column .
      256                                   v-help-old-y = hh:row    .
      257                                   v-help-old-size = hh:width .
      258                                   hh:width-chars = 2.5 .
      259                               end.
      260                           when "b-print" then
      261                               do:
      262                                   hh:load-image("cmp/b-print.bmp":u) .
      263                                   hh:TOOLTIP = "Печать" .
      264                                   v-h[ii] = hh:handle .
      265                                   ii = ii + 1 .
      266                                   hh:width-chars = 3 .
      267                               end.
      268                           when "b-history" or
      269                           when "b-hist" then
      270                               do:
      271                                   hh:load-image("cmp/b-hist.bmp":u) .
      272                                   hh:TOOLTIP = "История" .
      273                                   v-h[ii] = hh:handle .
      274                                   ii = ii + 1 .
      275                                   hh:width-chars = 3 .
      276                               end.
      277                           when "b-sch" then
      278                               do:
      279                                   hh:load-image("cmp/b-sch.bmp":u) .
      280                                   hh:TOOLTIP = "Установка Фильтра" .
      281                                   v-h[ii] = hh:handle .
      282                                   ii = ii + 1 .
      283                                   hh:width-chars = 3 .
      284                               end.
      285                           when "b-hist-user" then
      286                               do:
      287                                   hh:load-image("cmp/b-hist.bmp":u) .
      288                                   hh:TOOLTIP = "История пользователя" .
      289                                   ii = ii + 1 .
      290                               end.
      291                       end case.
      292                   end.
      293                   hh = hh:next-sibling.
      294               end.
      295               b-help:column = v-frame-width - b-help:width-chars.
      296               jj = 0.
      297               repeat ii = 4 to 1 by -1 :
      298                   if valid-handle (v-h[ii] ) then
      299                   do:
      300                       jj  = jj + 1 .
      301                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      302                       v-h[ii]:row    = v-help-old-y .
      303                   end.
      304               end.
      305           end.
      306       end.
      307   end procedure.
      308   MAIN-BLOCK:
      309   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      310      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      311     r-old:RADIO-BUTTONS in  frame Dialog-Frame = 'Новинка':U  + "," + 'Новинка':U + "," +
      312                                                   'Нештатный':U + "," + 'Нештатный':U + "," +
      313                                                   'Основная группа':U  + "," + 'Основная группа':U
      314     .
      315     r-new:RADIO-BUTTONS in  frame Dialog-Frame = 'Основная группа':U + "," + 'Основная группа':U + "," +
      316                                                   'Нештатный':U + "," + 'Нештатный':U + "," +
      317                                                   'На вывод из ассортимента':U + "," + 'На вывод из ассортимента':U
      318     .
      319    define variable v-log as logical   no-undo .
      320   define variable vss-include-info2 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      321   do:
      322     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      323       (input  g#db-num
      324       ,input  g#userid
      325       ,input  0
      326       ,input  'actn_assort-izt_update':U
      327       ,input  'global':U
      328       ,input  0
      329       ,input  '':U
      330       ,input  0
      331       ,input  0
      332       ,input  0
      333       ,input  0
      334       ,input  true
      335       ,output v-log
      336       )  .
      337   end.
      338    if not v-log then return no-apply .
      339     run enable_ui.
      340     WAIT-FOR GO OF FRAME Dialog-Frame.
      341   END.
      342   run disable_ui.
      343   PROCEDURE disable_UI :
      344     HIDE FRAME Dialog-Frame.
      345   END PROCEDURE.
      346   PROCEDURE enable_UI :
      347     DISPLAY R-old R-new FILL-IN-1 FILL-IN-2
      348         WITH FRAME Dialog-Frame.
      349     ENABLE B-save B-Cancel B-Help R-old R-new FILL-IN-1 FILL-IN-2
      350         WITH FRAME Dialog-Frame.
      351     VIEW FRAME Dialog-Frame.
      352   END PROCEDURE.
