      890     if not g#log then return .
      891     if not available buf_sum-in-sum-group then return .
      892   if v-cntxt-db-num <> 0 then do :
      893      if buf_sum-group.sgr-db-num <> v-cntxt-db-num then do:
      894         message substitute(" Группа создана в другой БД (&1) , корректировать ее в текущей БД нельзя !" , buf_sum-group.sgr-db-num ) .
      895         return .
      896      end.
      897   end.
      898     if buf_sum-in-sum-group.stts = 0 then do:
      899         message
      900         "Сумма " buf_sum-in-sum-group.ssg-summa
      901         "Удалять ?"
      902         view-as alert-box question
      903         buttons yes-no
      904         update v-ok as logical
      905         .
      906         if v-ok then
      907               run sis-del in this-procedure (
      908                 input   buf_sum-in-sum-group.sgr-db-num
      909                 ,input   buf_sum-in-sum-group.sgr-id
      910                 ,input   buf_sum-in-sum-group.ssg-summa
      911                 ,input   v-cntxt-db-num
      912                 ,input   v-cntxt-userid
      913                 ) .
      914     end.
      915     else do:
      916     end.
      917     OPEN QUERY BROWSE-2cli FOR EACH buf_sum-in-sum-group OF buf_sum-group      WHERE ( r-status = 2 OR buf_sum-in-sum-group.stts =  r-status )       NO-LOCK INDEXED-REPOSITION.
      918   END.
      919   ON CHOOSE OF B-history IN FRAME Dialog-Frame
      920   DO:
      921     if not available buf_sum-group then return .
      922     run ref/cgr-sgr.w (
      923         parParentProc ,
      924         buf_sum-group.sgr-id ,
      925         buf_sum-group.sgr-db-num ) .
      926   END.
      927   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
      928   DO:
      929       if available buf_sum-group then do:
      930   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      931   define variable v-str-recid12 as character no-undo .
      932   define variable v-num-entry12 as integer   no-undo .
      933   assign
      934     v-str-recid12 = trim( string( recid( buf_sum-group ) , "->>>>>>>>>>>9":U ) )
      935     v-num-entry12 = lookup( v-str-recid12 , p-rec-list )
      936   .
      937   if v-num-entry12 > 0 then do:
      938     assign
      939       entry( v-num-entry12, p-rec-list ) = "":U
      940       p-rec-list = trim( replace( p-rec-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
      941     .
      942   end.
      943   else do:
      944     assign
      945       p-rec-list = p-rec-list + ( if p-rec-list = "":U then "":U else chr(44) ) + v-str-recid12
      946     .
      947   end.
      948           g-log = browse-1grp:refresh() .
      949         if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
      950             g-log = browse-1grp:select-next-row ().
      951             apply "VALUE-CHANGED" to browse-1grp in frame Dialog-Frame.
      952         end.
      953       end.
      954       apply "display" to browse-1grp in frame Dialog-Frame.
      955   END.
      956   ON CHOOSE OF B-mark-2 IN FRAME Dialog-Frame
      957   DO:
      958       if available buf_sum-in-sum-group then do:
      959   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      960   define variable v-str-recid14 as character no-undo .
      961   define variable v-num-entry14 as integer   no-undo .
      962   assign
      963     v-str-recid14 = trim( string( recid( buf_sum-in-sum-group ) , "->>>>>>>>>>>9":U ) )
      964     v-num-entry14 = lookup( v-str-recid14 , v-rec-list-cli )
      965   .
      966   if v-num-entry14 > 0 then do:
      967     assign
      968       entry( v-num-entry14, v-rec-list-cli ) = "":U
      969       v-rec-list-cli = trim( replace( v-rec-list-cli , chr(44) + chr(44) , chr(44) ) , chr(44) )
      970     .
      971   end.
      972   else do:
      973     assign
      974       v-rec-list-cli = v-rec-list-cli + ( if v-rec-list-cli = "":U then "":U else chr(44) ) + v-str-recid14
      975     .
      976   end.
      977           g-log = browse-2cli:refresh() .
      978         if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
      979             g-log = browse-2cli:select-next-row ().
      980             apply "VALUE-CHANGED" to browse-2cli in frame Dialog-Frame.
      981         end.
      982       end.
      983       apply "entry" to browse-2cli in frame Dialog-Frame.
      984   END.
      985   ON CHOOSE OF B-print IN FRAME Dialog-Frame
      986   DO:
      987   if not available buf_sum-group then return .
      988     run rep/g-prsum.p
      989     ( parParentProc ,
      990       recid( buf_sum-group )
      991     ).
      992   END.
      993   ON CHOOSE OF B-sel IN FRAME Dialog-Frame
      994   DO:
      995       if ( available buf_sum-group ) AND ( p-rec-list = "" ) then
      996       p-rec-list = string( recid( buf_sum-group ) ) .
      997   END.
      998   ON VALUE-CHANGED OF BROWSE-1grp IN FRAME Dialog-Frame
      999   DO:
     1000     OPEN QUERY BROWSE-2cli FOR EACH buf_sum-in-sum-group OF buf_sum-group      WHERE ( r-status = 2 OR buf_sum-in-sum-group.stts =  r-status )       NO-LOCK INDEXED-REPOSITION.
     1001   END.
     1002   ON VALUE-CHANGED OF R-status IN FRAME Dialog-Frame
     1003   DO:
     1004       ASSIGN R-status .
     1005     OPEN QUERY BROWSE-1grp FOR EACH buf_sum-group WHERE ( r-status = 2 OR buf_sum-group.stts =  r-status ) and   ( r-find = no or (buf_sum-group.sgr-db-num = find-db and                         buf_sum-group.sgr-id = find-id ))  .
     1006     OPEN QUERY BROWSE-2cli FOR EACH buf_sum-in-sum-group OF buf_sum-group      WHERE ( r-status = 2 OR buf_sum-in-sum-group.stts =  r-status )       NO-LOCK INDEXED-REPOSITION.
     1007   END.
     1008   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1009   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1010   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1011   on help of frame Dialog-Frame
     1012   do:
     1013     run gbl/app_help.p
     1014       (input this-procedure :file-name
     1015       ,input ''
     1016       ,input ?
     1017       ) no-error.
     1018     if error-status :error then do:
     1019       message
     1020         "Ошибка при вызове помощи"
     1021         error-status :get-message(1)
     1022         view-as alert-box .
     1023     end.
     1024   end.
     1025   run minbtn-set in this-procedure .
     1026   on choose of b-help in frame Dialog-Frame
     1027   do:
     1028     apply "help":u to frame Dialog-Frame .
     1029   end.
     1030   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1031   procedure minbtn-set :
     1032       do
     1033           on error undo, return error return-value
     1034           :
     1035           define variable ii              as integer       no-undo .
     1036           define variable fh              as widget-handle no-undo .
     1037           define variable hh              as widget-handle no-undo .
     1038           define variable v-h             as handle        extent 4 no-undo .
     1039           define variable v-name-button   as character     no-undo .
     1040           define variable v-help-old-x    as decimal       no-undo .
     1041           define variable v-help-old-y    as decimal       no-undo .
     1042           define variable v-help-old-size as decimal       no-undo .
     1043           define variable v-frame-width   as decimal       no-undo .
     1044           define variable jj              as integer       no-undo .
     1045           do
     1046               on error undo, return error
     1047               :
     1048               assign
     1049                   v-frame-width = frame Dialog-Frame:width - 0.3
     1050                   fh            = frame Dialog-Frame:first-child
     1051                   hh            = fh:first-child
     1052                   ii            = 1
     1053                   .
     1054               do while valid-handle(hh):
     1055                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1056                   do:
     1057                       case lc(hh:name) :
     1058                           when "b-help" then
     1059                               do:
     1060                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1061                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1062                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1063                                   hh:TOOLTIP = "Помощь" .
     1064                                   v-help-old-x = hh:column .
     1065                                   v-help-old-y = hh:row    .
     1066                                   v-help-old-size = hh:width .
     1067                                   hh:width-chars = 2.5 .
     1068                               end.
     1069                           when "b-print" then
     1070                               do:
     1071                                   hh:load-image("cmp/b-print.bmp":u) .
     1072                                   hh:TOOLTIP = "Печать" .
     1073                                   v-h[ii] = hh:handle .
     1074                                   ii = ii + 1 .
     1075                                   hh:width-chars = 3 .
     1076                               end.
     1077                           when "b-history" or
     1078                           when "b-hist" then
     1079                               do:
     1080                                   hh:load-image("cmp/b-hist.bmp":u) .
     1081                                   hh:TOOLTIP = "История" .
     1082                                   v-h[ii] = hh:handle .
     1083                                   ii = ii + 1 .
     1084                                   hh:width-chars = 3 .
     1085                               end.
     1086                           when "b-sch" then
     1087                               do:
     1088                                   hh:load-image("cmp/b-sch.bmp":u) .
     1089                                   hh:TOOLTIP = "Установка Фильтра" .
     1090                                   v-h[ii] = hh:handle .
     1091                                   ii = ii + 1 .
     1092                                   hh:width-chars = 3 .
     1093                               end.
     1094                           when "b-hist-user" then
     1095                               do:
     1096                                   hh:load-image("cmp/b-hist.bmp":u) .
     1097                                   hh:TOOLTIP = "История пользователя" .
     1098                                   ii = ii + 1 .
     1099                               end.
     1100                       end case.
     1101                   end.
     1102                   hh = hh:next-sibling.
     1103               end.
     1104               b-help:column = v-frame-width - b-help:width-chars.
     1105               jj = 0.
     1106               repeat ii = 4 to 1 by -1 :
     1107                   if valid-handle (v-h[ii] ) then
     1108                   do:
     1109                       jj  = jj + 1 .
     1110                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1111                       v-h[ii]:row    = v-help-old-y .
     1112                   end.
     1113               end.
     1114           end.
     1115       end.
     1116   end procedure.
     1117   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1118   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1119   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1120   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1121   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1122   define variable v-diasize-current-frame-height as decimal   no-undo .
     1123   define variable v-diasize-change-size          as logical   no-undo .
     1124   define variable v-diasize-resize-button        as handle    no-undo .
     1125   define variable v-diasize-wndmax               as logical   no-undo .
     1126   define variable v-diasize-wndstore             as logical   no-undo .
     1127   define variable v-diasize-proc-name            as character no-undo .
     1128   define variable v-diasize-browse-handle        as handle    no-undo .
     1129   define variable v-diasize-browse-number        as integer   no-undo .
     1130   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1131   define temp-table temp-diasize-handle no-undo
     1132     field handle-value  as handle
     1133     field save-position as decimal
     1134     index xpk is primary unique handle-value
     1135     .
     1136   define temp-table temp-browse-handle no-undo
     1137     field browse-type   as character
     1138     field browse-number as integer
     1139     field browse-handle as handle
     1140     field original-size as decimal
     1141     index xpk is primary unique browse-type browse-number
     1142     index xie browse-type browse-handle
     1143   .
     1144   procedure diasize_change-height :
     1145     define input  parameter p-change-value  as decimal   no-undo .
     1146     define input  parameter p-move-resize   as logical   no-undo .
     1147     define variable v-field-group-handle    as handle    no-undo .
     1148     define variable v-object-handle         as handle    no-undo .
     1149     define variable v-frame-height          as decimal   no-undo .
     1150     define variable v-frame-virtual-height  as decimal   no-undo .
     1151     define variable v-browse-height         as decimal   no-undo .
     1152     define variable v-window-height         as decimal   no-undo .
     1153     define variable v-window-virtual-height as decimal   no-undo .
     1154     define variable v-change-sign           as integer   no-undo .
     1155     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1156     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1157     if p-change-value > 0
     1158     then do:
     1159       if frame Dialog-Frame :height + p-change-value
     1160           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1161       then do:
     1162         assign
     1163           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1164                           - (frame Dialog-Frame :height-chars)
     1165         .
     1166         if p-change-value <= 0
     1167         then do:
     1168           run diasize_position-resize-button in this-procedure .
     1169           return .
     1170         end.
     1171       end.
     1172     end.
     1173     if p-change-value < 0
     1174     then do:
     1175       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1176       then do:
     1177         assign
     1178           p-change-value = v-diasize-orig-frame-height
     1179                          - (frame Dialog-Frame :height-chars)
     1180         .
     1181         if p-change-value >= 0
     1182         then do:
     1183           run diasize_position-resize-button in this-procedure .
     1184           return .
     1185         end.
     1186       end.
     1187     end.
     1188     if p-change-value >= 0
     1189     then do:
     1190       assign
     1191         v-change-sign = 1
     1192       .
     1193     end.
     1194     else do:
     1195       assign
     1196         v-change-sign = -1
     1197       .
     1198     end.
     1199     assign
     1200       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1201     .
     1202     if p-change-value = 0
     1203     then do:
     1204       run diasize_position-resize-button in this-procedure .
     1205       return .
     1206     end.
     1207     move_block:
     1208     do
     1209     on error undo move_block, retry move_block
     1210     :
     1211       if retry
     1212       then do:
     1213         do
     1214         on error undo move_block, leave move_block
     1215         :
     1216           if p-change-value > 0
     1217           then do:
     1218             for each buf_temp-diasize-handle
     1219             on error undo, next
     1220             :
     1221               assign
     1222                 v-object-handle = buf_temp-diasize-handle.handle-value
     1223               .
     1224               if v-object-handle <> v-diasize-resize-button
     1225               then do:
     1226                 assign
     1227                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1228                 .
     1229               end.
     1230             end.
     1231             assign
     1232               v-diasize-browse-handle :height = v-browse-height
     1233             .
     1234             for each buf_temp-browse-handle
     1235               where buf_temp-browse-handle.browse-type = 'height':u
     1236             on error undo, next
     1237             :
     1238               assign
     1239                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1240               .
     1241             end.
     1242             assign
     1243               frame Dialog-Frame :height = v-frame-height
     1244             .
     1245             if frame Dialog-Frame :scrollable = true
     1246             then do:
     1247               assign
     1248                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1249               .
     1250             end.
     1251             run diasize_position-resize-button in this-procedure .
     1252           end.
     1253           else do:
     1254             if frame Dialog-Frame :scrollable = true
     1255             then do:
     1256               assign
     1257                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1258               .
     1259             end.
     1260             assign
     1261               frame Dialog-Frame :height = v-frame-height
     1262             .
     1263             assign
     1264               v-diasize-browse-handle :height = v-browse-height
     1265             .
     1266             for each buf_temp-browse-handle
     1267               where buf_temp-browse-handle.browse-type = 'height':u
     1268             on error undo, next
     1269             :
     1270               assign
     1271                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1272               .
     1273             end.
     1274             for each buf_temp-diasize-handle
     1275             on error undo, next
     1276             :
     1277               assign
     1278                 v-object-handle = buf_temp-diasize-handle.handle-value
     1279               .
     1280               if v-object-handle <> v-diasize-resize-button
     1281               then do:
     1282                 assign
     1283                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1284                 .
     1285               end.
     1286             end.
     1287             run diasize_position-resize-button in this-procedure .
     1288           end.
     1289           assign
     1290             v-diasize-change-size = false
     1291           .
     1292           leave move_block .
     1293         end.
     1294       end.
     1295       assign
     1296         v-diasize-need-full-display = true
     1297       .
     1298       if v-diasize-change-size = false
     1299       then do:
     1300         assign
     1301           v-diasize-change-size = true
     1302         .
     1303       end.
     1304       else do:
     1305         return .
     1306       end.
     1307       assign
     1308         v-frame-height = frame Dialog-Frame :height
     1309         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1310         v-browse-height = v-diasize-browse-handle :height
     1311       .
     1312       for each buf_temp-browse-handle
     1313         where buf_temp-browse-handle.browse-type = 'height':u
     1314       :
     1315         assign
     1316           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1317         .
     1318       end.
     1319       for each buf_temp-diasize-handle
     1320       :
     1321         delete buf_temp-diasize-handle .
     1322       end.
     1323       assign
     1324         v-field-group-handle = frame Dialog-Frame :first-child
     1325       .
     1326       do while valid-handle(v-field-group-handle)
     1327       :
     1328         assign
     1329           v-object-handle = v-field-group-handle :first-child
     1330         .
     1331         do while valid-handle(v-object-handle)
     1332         :
     1333           if  v-object-handle <> v-diasize-browse-handle :handle
     1334           and can-query(v-object-handle, "row")
     1335           and can-query(v-object-handle, "height")
     1336           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1337           then do:
     1338             find first buf_temp-browse-handle
     1339               where buf_temp-browse-handle.browse-type   = 'height':u
     1340                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1341               no-error .
     1342             if available buf_temp-browse-handle
     1343             then do:
     1344             end.
     1345             else do:
     1346               create buf_temp-diasize-handle .
     1347               assign
     1348                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1349                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1350               .
     1351             end.
     1352           end.
     1353           assign
     1354             v-object-handle = v-object-handle :next-sibling
     1355           .
     1356         end.
     1357         assign
     1358           v-field-group-handle = v-field-group-handle :next-sibling
     1359         .
     1360       end.
     1361       do with frame Dialog-Frame
     1362       :
     1363         hide v-diasize-resize-button .
     1364         assign
     1365           v-diasize-resize-button :row    = 1
     1366           v-diasize-resize-button :column = 1
     1367         .
     1368       end.
     1369       if p-change-value > 0
     1370       then do:
     1371         if frame Dialog-Frame :scrollable = true
     1372         then do:
     1373           assign
     1374             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1375             no-error .
     1376           if error-status :error
     1377           or error-status :get-message(1) <> ""
     1378           then do:
     1379             undo move_block, retry move_block .
     1380           end.
     1381         end.
     1382         assign
     1383           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1384           no-error .
     1385         if error-status :error
     1386         or error-status :get-message(1) <> ""
     1387         then do:
     1388           undo move_block, retry move_block .
     1389         end.
     1390         assign
     1391           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1392           no-error .
     1393         if error-status :error
     1394         or error-status :get-message(1) <> ""
     1395         then do:
     1396           undo move_block, retry move_block .
     1397         end.
     1398         for each buf_temp-browse-handle
     1399           where buf_temp-browse-handle.browse-type = 'height':u
     1400         on error undo move_block, retry move_block
     1401         :
     1402           assign
     1403             buf_temp-browse-handle.browse-handle :height
     1404               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1405             no-error .
     1406           if error-status :error
     1407           or error-status :get-message(1) <> ""
     1408           then do:
     1409             undo move_block, retry move_block .
     1410           end.
     1411         end.
     1412         for each buf_temp-diasize-handle
     1413         on error undo move_block, retry move_block
     1414         :
     1415           assign
     1416             v-object-handle = buf_temp-diasize-handle.handle-value
     1417           .
     1418           if v-object-handle <> v-diasize-resize-button
     1419           then do:
     1420             assign
     1421               v-object-handle :row = v-object-handle :row + p-change-value
     1422               no-error .
     1423             if error-status :error
     1424             or error-status :get-message(1) <> ""
     1425             then do:
     1426               undo move_block, retry move_block .
     1427             end.
     1428           end.
     1429         end.
     1430       end.
     1431       else do:
     1432         for each buf_temp-diasize-handle
     1433         on error undo move_block, retry move_block
     1434         :
     1435           assign
     1436             v-object-handle = buf_temp-diasize-handle.handle-value
     1437           .
     1438           if v-object-handle <> v-diasize-resize-button
     1439           then do:
     1440             assign
     1441               v-object-handle :row = v-object-handle :row + p-change-value
     1442               no-error .
     1443             if error-status :error
     1444             or error-status :get-message(1) <> ""
     1445             then do:
     1446               undo move_block, retry move_block .
     1447             end.
     1448           end.
     1449         end.
     1450         assign
     1451           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1452           no-error .
     1453         if error-status :error
     1454         or error-status :get-message(1) <> ""
     1455         then do:
     1456           undo move_block, retry move_block .
     1457         end.
     1458         for each buf_temp-browse-handle
     1459           where buf_temp-browse-handle.browse-type = 'height':u
     1460         on error undo move_block, retry move_block
     1461         :
     1462           assign
     1463             buf_temp-browse-handle.browse-handle :height
     1464               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1465             no-error .
     1466           if error-status :error
     1467           or error-status :get-message(1) <> ""
     1468           then do:
     1469             undo move_block, retry move_block .
     1470           end.
     1471         end.
     1472         assign
     1473           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1474           no-error .
     1475         if error-status :error
     1476         or error-status :get-message(1) <> ""
     1477         then do:
     1478           undo move_block, retry move_block .
     1479         end.
     1480         if frame Dialog-Frame :scrollable = true
     1481         then do:
     1482           assign
     1483             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1484             no-error .
     1485           if error-status :error
     1486           or error-status :get-message(1) <> ""
     1487           then do:
     1488             undo move_block, retry move_block .
     1489           end.
     1490         end.
     1491       end.
     1492       if p-move-resize = true
     1493       then do:
     1494         run diasize_position-resize-button in this-procedure .
     1495       end.
     1496       if v-diasize-wndstore = true
     1497       then do:
     1498         if connected("ub") = true
     1499         then do:
     1500           define variable v-cntxt-db-num        as integer   no-undo .
     1501           define variable v-cntxt-userid        as character no-undo .
     1502           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1503                                             , OUTPUT v-cntxt-userid
     1504                                             ) .
     1505           run gbl/wndsizew.p
     1506             (input  v-cntxt-db-num
     1507             ,input  v-cntxt-userid
     1508             ,input  v-diasize-proc-name
     1509             ,input  'height':u
     1510             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1511             ) .
     1512         end.
     1513       end.
     1514     end.
     1515     assign
     1516       v-diasize-change-size = false
     1517     .
     1518   end procedure.
     1519   procedure diasize_set-height :
     1520     define input  parameter p-new-height  as decimal   no-undo .
     1521     define input  parameter p-move-resize as logical   no-undo .
     1522     do
     1523     on error undo, return error return-value
     1524     :
     1525       run diasize_change-height in this-procedure
     1526         (input  (p-new-height - frame Dialog-Frame :height)
     1527         ,input  p-move-resize
     1528         ) .
     1529     end.
     1530   end procedure.
     1531   procedure diasize_change-width :
     1532     define input  parameter p-change-value as decimal   no-undo .
     1533     define input  parameter p-move-resize  as logical   no-undo .
     1534     define variable v-field-group-handle   as handle    no-undo .
     1535     define variable v-object-handle        as handle    no-undo .
     1536     define variable v-frame-width          as decimal   no-undo .
     1537     define variable v-frame-virtual-width  as decimal   no-undo .
     1538     define variable v-browse-width         as decimal   no-undo .
     1539     define variable v-window-width         as decimal   no-undo .
     1540     define variable v-window-virtual-width as decimal   no-undo .
     1541     define variable v-change-sign          as integer   no-undo .
     1542     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1543     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1544     if p-change-value > 0
     1545     then do:
     1546       if frame Dialog-Frame :width + p-change-value >
     1547           session :width-chars
     1548       then do:
     1549         assign
     1550           p-change-value = session :width-chars - frame Dialog-Frame :width
     1551         .
     1552         if p-change-value <= 0
     1553         then do:
     1554           run diasize_position-resize-button in this-procedure .
     1555           return .
     1556         end.
     1557       end.
     1558     end.
     1559     if p-change-value < 0
     1560     then do:
     1561       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1562       then do:
     1563         assign
     1564           p-change-value = v-diasize-orig-frame-width
     1565                          - frame Dialog-Frame :width
     1566         .
     1567         if p-change-value >= 0
     1568         then do:
     1569           run diasize_position-resize-button in this-procedure .
     1570           return .
     1571         end.
     1572       end.
     1573     end.
     1574     if p-change-value >= 0
     1575     then do:
     1576       assign
     1577         v-change-sign = 1
     1578       .
     1579     end.
     1580     else do:
     1581       assign
     1582         v-change-sign = -1
     1583       .
     1584     end.
     1585     assign
     1586       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1587     .
     1588     if p-change-value = 0
     1589     then do:
     1590       run diasize_position-resize-button in this-procedure .
     1591       return .
     1592     end.
     1593     move_block:
     1594     do
     1595     on error undo move_block, leave move_block
     1596     :
     1597       if retry
     1598       then do:
     1599         do
     1600         on error undo move_block, leave move_block
     1601         :
     1602           if p-change-value > 0
     1603           then do:
     1604             for each buf_temp-diasize-handle
     1605             on error undo, next
     1606             :
     1607               assign
     1608                 v-object-handle = buf_temp-diasize-handle.handle-value
     1609               .
     1610               if v-object-handle <> v-diasize-resize-button
     1611               then do:
     1612                 assign
     1613                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1614                 .
     1615               end.
     1616             end.
     1617             assign
     1618               v-diasize-browse-handle :width = v-browse-width
     1619             .
     1620             for each buf_temp-browse-handle
     1621               where buf_temp-browse-handle.browse-type = 'width':u
     1622             on error undo, next
     1623             :
     1624               assign
     1625                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1626               .
     1627             end.
     1628             assign
     1629               frame Dialog-Frame :width = v-frame-width
     1630             .
     1631             if frame Dialog-Frame :scrollable = true
     1632             then do:
     1633               assign
     1634                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1635               .
     1636             end.
     1637             run diasize_position-resize-button in this-procedure .
     1638           end.
     1639           else do:
     1640             if frame Dialog-Frame :scrollable = true
     1641             then do:
     1642               assign
     1643                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1644               .
     1645             end.
     1646             assign
     1647               frame Dialog-Frame :width = v-frame-width
     1648             .
     1649             for each buf_temp-browse-handle
     1650               where buf_temp-browse-handle.browse-type = 'width':u
     1651             on error undo, next
     1652             :
     1653               assign
     1654                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1655               .
     1656             end.
     1657             assign
     1658               v-diasize-browse-handle :width = v-browse-width
     1659             .
     1660             for each buf_temp-diasize-handle
     1661             on error undo, next
     1662             :
     1663               assign
     1664                 v-object-handle = buf_temp-diasize-handle.handle-value
     1665               .
     1666               if v-object-handle <> v-diasize-resize-button
     1667               then do:
     1668                 assign
     1669                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1670                 .
     1671               end.
     1672             end.
     1673             run diasize_position-resize-button in this-procedure .
     1674           end.
     1675           assign
     1676             v-diasize-change-size = false
     1677           .
     1678           leave move_block .
     1679         end.
     1680       end.
     1681       assign
     1682         v-diasize-need-full-display = true
     1683       .
     1684       if v-diasize-change-size = false
     1685       then do:
     1686         assign
     1687           v-diasize-change-size = true
     1688         .
     1689       end.
     1690       else do:
     1691         return .
     1692       end.
     1693       assign
     1694         v-frame-width = frame Dialog-Frame :width
     1695         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1696         v-browse-width = v-diasize-browse-handle :width
     1697       .
     1698       for each buf_temp-browse-handle
     1699         where buf_temp-browse-handle.browse-type = 'width':u
     1700       :
     1701         assign
     1702           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1703         .
     1704       end.
     1705       for each buf_temp-diasize-handle
     1706       :
     1707         delete buf_temp-diasize-handle .
     1708       end.
     1709       assign
     1710         v-field-group-handle = frame Dialog-Frame :first-child
     1711       .
     1712       do while valid-handle(v-field-group-handle)
     1713       :
     1714         assign
     1715           v-object-handle = v-field-group-handle :first-child
     1716         .
     1717         do while valid-handle(v-object-handle)
     1718         :
     1719           if  v-object-handle <> v-diasize-browse-handle :handle
     1720           and v-object-handle <> v-diasize-resize-button
     1721           and can-query(v-object-handle, "row")
     1722           and can-query(v-object-handle, "height")
     1723           and ( v-object-handle :col + v-object-handle :width
     1724                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1725               )
     1726           then do:
     1727             find first buf_temp-browse-handle
     1728               where buf_temp-browse-handle.browse-type   = 'width':u
     1729                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1730               no-error .
     1731             if available buf_temp-browse-handle
     1732             then do:
     1733             end.
     1734             else do:
     1735               create buf_temp-diasize-handle .
     1736               assign
     1737                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1738                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1739               .
     1740             end.
     1741           end.
     1742           assign
     1743             v-object-handle = v-object-handle :next-sibling
     1744           .
     1745         end.
     1746         assign
     1747           v-field-group-handle = v-field-group-handle :next-sibling
     1748         .
     1749       end.
     1750       do with frame Dialog-Frame
     1751       :
     1752         hide v-diasize-resize-button .
     1753         v-diasize-resize-button :row = 1.
     1754         v-diasize-resize-button :column = 1.
     1755       end.
     1756       if p-change-value > 0
     1757       then do:
     1758         if frame Dialog-Frame :scrollable = true
     1759         then do:
     1760           assign
     1761             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1762             no-error .
     1763           if error-status :error
     1764           or error-status :get-message(1) <> ""
     1765           then do:
     1766             undo move_block, retry move_block.
     1767           end.
     1768         end.
     1769         assign
     1770           frame Dialog-Frame :width = v-frame-width + p-change-value
     1771           no-error .
     1772         if error-status :error
     1773         or error-status :get-message(1) <> ""
     1774         then do:
     1775           undo move_block, retry move_block.
     1776         end.
     1777         assign
     1778           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1779         no-error .
     1780         if error-status :error
     1781         or error-status :get-message(1) <> ""
     1782         then do:
     1783           undo move_block, retry move_block.
     1784         end.
     1785         for each buf_temp-browse-handle
     1786           where buf_temp-browse-handle.browse-type = 'width':u
     1787         on error undo move_block, retry move_block
     1788         :
     1789           assign
     1790             buf_temp-browse-handle.browse-handle :width
     1791               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1792             no-error .
     1793           if error-status :error
     1794           or error-status :get-message(1) <> ""
     1795           then do:
     1796             undo move_block, retry move_block .
     1797           end.
     1798         end.
     1799         for each buf_temp-diasize-handle
     1800         on error undo move_block, retry move_block
     1801         :
     1802           assign
     1803             v-object-handle = buf_temp-diasize-handle.handle-value
     1804           .
     1805           if v-object-handle <> v-diasize-resize-button
     1806           then do:
     1807             assign
     1808               v-object-handle :col = v-object-handle :col + p-change-value
     1809               no-error .
     1810             if error-status :error
     1811             or error-status :get-message(1) <> ""
     1812             then do:
     1813               undo move_block, retry move_block .
     1814             end.
     1815           end.
     1816         end.
     1817       end.
     1818       else do:
     1819         for each buf_temp-diasize-handle
     1820         on error undo move_block, retry move_block
     1821         :
     1822           assign
     1823             v-object-handle = buf_temp-diasize-handle.handle-value
     1824           .
     1825           if v-object-handle <> v-diasize-resize-button
     1826           then do:
     1827             assign
     1828               v-object-handle :col = v-object-handle :col + p-change-value
     1829               no-error .
     1830             if error-status :error
     1831             or error-status :get-message(1) <> ""
     1832             then do:
     1833               undo move_block, retry move_block .
     1834             end.
     1835           end.
     1836         end.
     1837         for each buf_temp-browse-handle
     1838           where buf_temp-browse-handle.browse-type = 'width':u
     1839         on error undo move_block, retry move_block
     1840         :
     1841           assign
     1842             buf_temp-browse-handle.browse-handle :width
     1843               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1844             no-error .
     1845           if error-status :error
     1846           or error-status :get-message(1) <> ""
     1847           then do:
     1848             undo move_block, retry move_block .
     1849           end.
     1850         end.
     1851         assign
     1852           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1853           no-error .
     1854         if error-status :error
     1855         or error-status :get-message(1) <> ""
     1856         then do:
     1857           undo move_block, retry move_block.
     1858         end.
     1859         assign
     1860           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1861         no-error .
     1862         if error-status :error
     1863         or error-status :get-message(1) <> ""
     1864         then do:
     1865           undo move_block, retry move_block.
     1866         end.
     1867         if frame Dialog-Frame :scrollable = true
     1868         then do:
     1869           assign
     1870             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1871           no-error .
     1872           if error-status :error
     1873           or error-status :get-message(1) <> ""
     1874           then do:
     1875             undo move_block, retry move_block.
     1876           end.
     1877         end.
     1878       end.
     1879       if p-move-resize
     1880       then do:
     1881         run diasize_position-resize-button in this-procedure .
     1882       end.
     1883       if v-diasize-wndstore = true
     1884       then do:
     1885         if connected("ub") = true
     1886         then do:
     1887           define variable v-cntxt-db-num        as integer   no-undo .
     1888           define variable v-cntxt-userid        as character no-undo .
     1889           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1890                                             , OUTPUT v-cntxt-userid
     1891                                             ) .
     1892           run gbl/wndsizew.p
     1893             (input  v-cntxt-db-num
     1894             ,input  v-cntxt-userid
     1895             ,input  v-diasize-proc-name
     1896             ,input  'width':u
     1897             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1898             ) .
     1899         end.
     1900       end.
     1901     end.
     1902     assign
     1903       v-diasize-change-size = false
     1904     .
     1905   end procedure.
     1906   procedure diasize_set-width :
     1907     define input  parameter p-new-width  as decimal   no-undo .
     1908     define input  parameter p-move-resize as logical   no-undo .
     1909     do
     1910     on error undo, return error return-value
     1911     :
     1912       run diasize_change-width in this-procedure
     1913         (input  (p-new-width - frame Dialog-Frame :width)
     1914         ,input  p-move-resize
     1915         ) .
     1916     end.
     1917   end procedure.
     1918   procedure diasize_position-resize-button :
     1919     do with frame Dialog-Frame
     1920     :
     1921       hide v-diasize-resize-button .
     1922       assign
     1923         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1924                     - 1
     1925                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1926         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1927                     - 1
     1928                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1929       .
     1930       view v-diasize-resize-button .
     1931     end.
     1932   end procedure.
     1933   on alt-right anywhere
     1934   do:
     1935     run diasize_change-width in this-procedure
     1936       (input 1
     1937       ,input true
     1938       ) .
     1939     return no-apply .
     1940   end.
     1941   on alt-left anywhere
     1942   do:
     1943     run diasize_change-width in this-procedure
     1944       (input -1
     1945       ,input true
     1946       ) .
     1947     return no-apply .
     1948   end.
     1949   on alt-down anywhere
     1950   do:
     1951     run diasize_change-height in this-procedure
     1952       (input 1
     1953       ,input true
     1954       ) .
     1955     return no-apply .
     1956   end.
     1957   on alt-up anywhere
     1958   do:
     1959     run diasize_change-height in this-procedure
     1960       (input -1
     1961       ,input true
     1962       ) .
     1963     return no-apply .
     1964   end.
     1965   on alt-enter of frame Dialog-Frame
     1966   do:
     1967     run diasize_maximize in this-procedure
     1968       (input  ?
     1969       ).
     1970     return no-apply .
     1971   end.
     1972   procedure diasize_end-move :
     1973     do
     1974     on error undo, return error return-value
     1975     :
     1976       define variable v-row-delta as decimal   no-undo .
     1977       define variable v-col-delta as decimal   no-undo .
     1978       define variable v-new-row as decimal   no-undo .
     1979       define variable v-new-col as decimal   no-undo .
     1980       assign
     1981         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1982         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1983       .
     1984       assign
     1985         v-row-delta = v-new-row - frame Dialog-Frame :height
     1986         v-col-delta = v-new-col - frame Dialog-Frame :width
     1987       .
     1988       run diasize_change-height in this-procedure
     1989         (input v-row-delta
     1990         ,input true
     1991         ) .
     1992       run diasize_change-width in this-procedure
     1993         (input v-col-delta
     1994         ,input true
     1995         ) .
     1996     end.
     1997   end procedure.
     1998   procedure diasize_maximize :
     1999     define input  parameter p-action as logical   no-undo .
     2000     do
     2001     on error undo, return error return-value
     2002     :
     2003       if p-action = ?
     2004       then do:
     2005         if v-diasize-need-maximize = true
     2006         then do:
     2007           assign
     2008             p-action = true
     2009           .
     2010         end.
     2011         else do:
     2012           assign
     2013             p-action = false
     2014           .
     2015         end.
     2016       end.
     2017       if p-action = true
     2018       then do:
     2019         run diasize_change-height in this-procedure
     2020           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2021               - frame Dialog-Frame :height-chars
     2022           ,input true
     2023           ) .
     2024         run diasize_change-width in this-procedure
     2025           (input session :width-chars
     2026               - frame Dialog-Frame :width-chars
     2027           ,input true
     2028           ) .
     2029         assign
     2030           v-diasize-need-maximize = false
     2031         .
     2032       end.
     2033       else do:
     2034         run diasize_change-width in this-procedure
     2035           (input v-diasize-orig-frame-width
     2036               - frame Dialog-Frame :width-chars
     2037           ,input true
     2038           ) .
     2039         run diasize_change-height in this-procedure
     2040           (input v-diasize-orig-frame-height
     2041               - frame Dialog-Frame :height-chars
     2042           ,input true
     2043           ) .
     2044         assign
     2045           v-diasize-need-maximize = true
     2046         .
     2047       end.
     2048     end.
     2049   end procedure.
     2050   procedure diasize_restore-orig-size :
     2051     do
     2052     on error undo, return error return-value
     2053     :
     2054       assign
     2055         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2056         v-diasize-current-frame-height = frame Dialog-Frame :height
     2057       .
     2058       run diasize_set-height in this-procedure
     2059         (input  v-diasize-orig-frame-height
     2060         ,input  true
     2061         ) .
     2062       run diasize_set-width in this-procedure
     2063         (input  v-diasize-orig-frame-width
     2064         ,input  true
     2065         ) .
     2066     end.
     2067   end procedure.
     2068   procedure diasize_restore-current-size :
     2069     do
     2070     on error undo, return error return-value
     2071     :
     2072       run diasize_set-height in this-procedure
     2073         (input  v-diasize-current-frame-height
     2074         ,input  true
     2075         ) .
     2076       run diasize_set-width in this-procedure
     2077         (input  v-diasize-current-frame-width
     2078         ,input  true
     2079         ) .
     2080     end.
     2081   end procedure.
     2082   procedure diasize_set-browse-handle :
     2083     define input  parameter p-browse-handle as handle   no-undo .
     2084     define buffer buf_temp-browse-handle for temp-browse-handle .
     2085     do
     2086     on error undo, return error return-value
     2087     :
     2088       assign
     2089         v-diasize-browse-handle = p-browse-handle
     2090       .
     2091       for each buf_temp-browse-handle
     2092       on error undo, return error return-value
     2093       :
     2094         delete buf_temp-browse-handle .
     2095       end.
     2096     end.
     2097   end procedure.
     2098   procedure diasize_add_browse :
     2099     define input  parameter p-browse-type   as character no-undo .
     2100     define input  parameter p-browse-handle as handle    no-undo .
     2101     define buffer buf_temp-browse-handle for temp-browse-handle .
     2102     do
     2103     on error undo, return error return-value
     2104     :
     2105       assign
     2106         v-diasize-browse-number = v-diasize-browse-number + 1
     2107       .
     2108       create buf_temp-browse-handle .
     2109       assign
     2110         buf_temp-browse-handle.browse-type   = p-browse-type
     2111         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2112         buf_temp-browse-handle.browse-handle = p-browse-handle
     2113       .
     2114     end.
     2115   end procedure.
     2116   procedure diasize_init :
     2117     define variable v-default-value    as logical   no-undo .
     2118     define variable v-restore-saved    as logical   no-undo .
     2119     define variable v-resize-value-str as character no-undo .
     2120     do
     2121     on error undo, return error return-value
     2122     :
     2123       do with frame Dialog-Frame
     2124       :
     2125         assign
     2126           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2127           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2128           v-diasize-browse-handle     = browse browse-1grp :handle
     2129         .
     2130         create button v-diasize-resize-button
     2131         assign
     2132           parent        = frame Dialog-Frame :first-child
     2133           label         = "s"
     2134           height-pixels = 16
     2135           width-pixels  = 16
     2136           visible       = true
     2137           sensitive     = true
     2138           movable       = true
     2139           triggers:
     2140             on end-move persistent run diasize_end-move in this-procedure .
     2141           end triggers.
     2142         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2143         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2144         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2145         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2146         assign
     2147           v-diasize-wndmax = false
     2148         .
     2149         if connected("ub") = true
     2150         then do:
     2151           define variable v-cntxt-db-num        as integer   no-undo .
     2152           define variable v-cntxt-userid        as character no-undo .
     2153           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2154                                             , OUTPUT v-cntxt-userid
     2155                                             ) .
     2156           run gbl/wndpar_r.p
     2157             (input  v-cntxt-db-num
     2158             ,input  v-cntxt-userid
     2159             ,input  'wndmax':U
     2160             ,output v-diasize-wndmax
     2161             ,output v-default-value
     2162             ) .
     2163         end.
     2164         assign
     2165           v-diasize-wndstore = false
     2166         .
     2167         if connected("ub") = true
     2168         then do:
     2169           run gbl/wndpar_r.p
     2170             (input  v-cntxt-db-num
     2171             ,input  v-cntxt-userid
     2172             ,input  'wndstore':U
     2173             ,output v-diasize-wndstore
     2174             ,output v-default-value
     2175             ) .
     2176         end.
     2177         assign
     2178           v-diasize-proc-name = entry(1, program-name(2), '.')
     2179         .
     2180         if v-diasize-wndstore = true
     2181         then do:
     2182           assign
     2183             v-restore-saved = false
     2184           .
     2185           if connected("ub") = true
     2186           then do:
     2187             run gbl/wndsizer.p
     2188               (input  v-cntxt-db-num
     2189               ,input  v-cntxt-userid
     2190               ,input  v-diasize-proc-name
     2191               ,input  'height':u
     2192               ,output v-resize-value-str
     2193               ) .
     2194             if v-resize-value-str <> '':U
     2195             then do:
     2196               run diasize_change-height in this-procedure
     2197                 (input  integer(v-resize-value-str)
     2198                 ,input  true
     2199                 ) .
     2200               assign
     2201                 v-restore-saved = true
     2202               .
     2203             end.
     2204           end.
     2205           if connected("ub") = true
     2206           then do:
     2207             run gbl/wndsizer.p
     2208               (input  v-cntxt-db-num
     2209               ,input  v-cntxt-userid
     2210               ,input  v-diasize-proc-name
     2211               ,input  'width':u
     2212               ,output v-resize-value-str
     2213               ) .
     2214             if v-resize-value-str <> '':U
     2215             then do:
     2216               run diasize_change-width in this-procedure
     2217                 (input  integer(v-resize-value-str)
     2218                 ,input  true
     2219                 ) .
     2220               assign
     2221                 v-restore-saved = true
     2222               .
     2223             end.
     2224           end.
     2225           if v-restore-saved <> true
     2226           then do:
     2227             if v-diasize-wndmax = true
     2228             then do:
     2229               run diasize_maximize in this-procedure
     2230                 (input  true
     2231                 ) .
     2232             end.
     2233           end.
     2234         end.
     2235         else do:
     2236           if v-diasize-wndmax = true
     2237           then do:
     2238             run diasize_maximize in this-procedure
     2239               (input  true
     2240               ) .
     2241           end.
     2242         end.
     2243       end.
     2244     end.
     2245   end procedure.
     2246   procedure diasize_need-full-display :
     2247     define output parameter p-need-full-display as logical   no-undo .
     2248     do
     2249     on error undo, return error return-value
     2250     :
     2251       assign
     2252         p-need-full-display = v-diasize-need-full-display
     2253       .
     2254       assign
     2255         v-diasize-need-full-display = false
     2256       .
     2257     end.
     2258   end procedure.
     2259   procedure get-context :
     2260      define output parameter p-db-num as integer          no-undo.
     2261      define output parameter p-user-id as character        no-undo.
     2262      define variable v-login               as character    no-undo.
     2263      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2264      define buffer buf_user-login  for ub.user-login .
     2265      do
     2266      on error undo, return error
     2267      :
     2268            FIND FIRST buf_sys-ctrl no-lock.
     2269            ASSIGN
     2270               v-login = USERID("ub")
     2271               p-db-num = buf_sys-ctrl.db-num
     2272            .
     2273            FIND FIRST buf_user-login
     2274                 WHERE buf_user-login.db-num = p-db-num
     2275                   AND buf_user-login.user-login = v-login
     2276                 no-lock
     2277                 no-error
     2278                 .
     2279            IF AVAILABLE buf_user-login
     2280            THEN DO:
     2281               assign
     2282                  p-user-id = buf_user-login.user-id
     2283               .
     2284            END.
     2285      end.
     2286   end procedure.
     2287   run diasize_add_browse in this-procedure
     2288     (input  'HEIGHT':U
     2289     ,input  browse browse-2cli :handle
     2290     ) .
     2291   run diasize_init in this-procedure .
     2292   MAIN-BLOCK:
     2293   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2294      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2295      define variable g#log as logical   no-undo .
     2296   define variable vss-include-info18 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2297   do:
     2298     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     2299       (input  v-cntxt-db-num
     2300       ,input  v-cntxt-userid
     2301       ,input  0
     2302       ,input  'actn_ref-mpl_lookup':U
     2303       ,input  'global':U
     2304       ,input  v-cntxt-host-code-obj
     2305       ,input  v-cntxt-obj-type
     2306       ,input  v-cntxt-obj-code
     2307       ,input  0
     2308       ,input  0
     2309       ,input  0
     2310       ,input  true
     2311       ,output g#log
     2312       )  .
     2313   end.
     2314     if not g#log then return .
     2315      buf_sum-group.NAME:resizable in browse browse-1grp = true .
     2316      buf_sum-group.NAME:width  in browse browse-1grp = 20 .
     2317      if p-rec-list <> "" and p-rec-list <> ? then run select_one .
     2318     run enable_ui in this-procedure .
     2319     disable
     2320        B-sel      when LOOKUP ("b-sel":U,    p-bttns) = 0
     2321        B-add      when LOOKUP ("b-add":U,    p-bttns) = 0
     2322        B-chg      when LOOKUP ("b-chg":U,    p-bttns) = 0
     2323        B-del      when LOOKUP ("b-del":U,    p-bttns) = 0
     2324        B-add-2    when LOOKUP ("b-add":U,    p-bttns) = 0
     2325        B-del-2    when LOOKUP ("b-del":U,    p-bttns) = 0
     2326        B-mark     when LOOKUP ("b-mark":U,   p-bttns) = 0
     2327        B-mark-2   when LOOKUP ("b-mark-2":U, p-bttns) = 0
     2328       with frame Dialog-Frame .
     2329     WAIT-FOR GO OF FRAME Dialog-Frame.
     2330   END.
     2331   run disable_UI in this-procedure .
     2332   PROCEDURE disable_UI :
     2333     HIDE FRAME Dialog-Frame.
     2334   END PROCEDURE.
     2335   PROCEDURE enable_UI :
     2336     DISPLAY R-status FILL-IN-1
     2337         WITH FRAME Dialog-Frame.
     2338     ENABLE B-Cancel B-sel B-chg B-add B-del B-history B-Help B-print R-status
     2339            B-mark-2 B-add-2 B-chg2 B-del-2 B-mark BROWSE-1grp BROWSE-2cli
     2340            FILL-IN-1
     2341         WITH FRAME Dialog-Frame.
     2342     VIEW FRAME Dialog-Frame.
     2343     OPEN QUERY BROWSE-1grp FOR EACH buf_sum-group WHERE ( r-status = 2 OR buf_sum-group.stts =  r-status ) and   ( r-find = no or (buf_sum-group.sgr-db-num = find-db and                         buf_sum-group.sgr-id = find-id ))  .    OPEN QUERY BROWSE-2cli FOR EACH buf_sum-in-sum-group OF buf_sum-group      WHERE ( r-status = 2 OR buf_sum-in-sum-group.stts =  r-status )       NO-LOCK INDEXED-REPOSITION.
     2344   END PROCEDURE.
     2345   PROCEDURE select_one :
     2346   define buffer bufl_sum-group for ub.sum-group  .
     2347   find first bufl_sum-group no-lock where recid(bufl_sum-group) = int(p-rec-list) no-error .
     2348   if error-status :error then return .
     2349   r-find = true .
     2350   find-db = bufl_sum-group.sgr-db-num  .
     2351   find-id = bufl_sum-group.sgr-id      .
     2352   END PROCEDURE.
