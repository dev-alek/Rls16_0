        1   DEFINE NEW SHARED BUFFER buf_sum-group FOR ub.sum-group.
        2   DEFINE BUFFER buf_sum-in-sum-group FOR ub.sum-in-sum-group.
        3   define input  parameter parParentProc as handle no-undo .
        4   define input  parameter p-bttns as character no-undo .
        5   define input-output parameter p-rec-list as character no-undo .
        6   define variable vss-revision    as character no-undo init "$Revision$":U .
        7   define variable vss-author      as character no-undo init "$Author$":U .
        8   define variable vss-date        as character no-undo init "$Date$":U .
        9   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       10   define variable vss-archive     as character no-undo init "$Archive$":U .
       11   define variable vss-description as character no-undo init "Справочник суммовых групп для ценообразования".
       12   procedure vss-get-info :
       13     define output parameter p-vss-revision    like vss-revision    no-undo .
       14     define output parameter p-vss-author      like vss-author      no-undo .
       15     define output parameter p-vss-date        like vss-date        no-undo .
       16     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       17     define output parameter p-vss-archive     like vss-archive     no-undo .
       18     define output parameter p-vss-description like vss-description no-undo .
       19     assign
       20       p-vss-revision    = vss-revision
       21       p-vss-author      = vss-author
       22       p-vss-date        = vss-date
       23       p-vss-workfile    = vss-workfile
       24       p-vss-archive     = vss-archive
       25       p-vss-description = vss-description
       26     .
       27   end procedure.
       28   procedure vss-get-parameters :
       29     define output parameter p-vss-parameters as character no-undo .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define new global shared variable g#language as character no-undo .
       67   if g#language <> '' and g#language <> 'rus':U then do:
       68     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       69   end.
       70   procedure proc-alt-shift-f2:
       71     if not ibs.th.gbl.gbl-var:rcode
       72   then
       73     run gbl\inidebug.p .
       74   end.
       75   procedure proc-alt-shift-f3:
       76     run gbl/prvssinf.p
       77       ( input this-procedure
       78       ) .
       79   end.
       80   define variable v-inform-launched as logical no-undo initial false .
       81   procedure proc-alt-shift-f4:
       82     define variable v-action as character no-undo .
       83     if v-inform-launched = false then do:
       84       assign
       85         v-inform-launched = true
       86       .
       87       run gbl/d-inform.w
       88         (  input self
       89         ,  input this-procedure
       90         , output v-action
       91         ) no-error .
       92       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       93       assign
       94         v-inform-launched = false
       95       .
       96     end.
       97   end.
       98   procedure proc-alt-f1:
       99     run gbl/corrhelp.p
      100       (input this-procedure
      101       ) .
      102   end .
      103   on alt-shift-f2 anywhere do:
      104     run proc-alt-shift-f2.
      105   end.
      106   on alt-shift-f3 anywhere do:
      107     run proc-alt-shift-f3 in this-procedure .
      108   end.
      109   on alt-shift-f4 anywhere do:
      110     run proc-alt-shift-f4 in this-procedure.
      111   end.
      112   on alt-f1 anywhere do:
      113     run proc-alt-f1 in this-procedure .
      114   end.
      115   define new global shared variable g#library  as handle no-undo .
      116   define new global shared variable g#library2 as handle no-undo .
      117   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      118     define variable v-cntxt-db-num        as integer   no-undo .
      119     define variable v-cntxt-userid        as character no-undo .
      120     define variable v-cntxt-level         as character no-undo .
      121     define variable v-cntxt-host-code-obj as integer   no-undo .
      122     define variable v-cntxt-obj-type      as character no-undo .
      123     define variable v-cntxt-obj-code      as integer   no-undo .
      124     define variable v-cntxt-db-num-obj    as integer   no-undo .
      125     define variable v-cntxt-is-admin      as logical   no-undo .
      126   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      127     run mainmenu_getcntxt in parparentproc
      128       (output v-cntxt-db-num
      129       ,output v-cntxt-userid
      130       ,output v-cntxt-level
      131       ,output v-cntxt-host-code-obj
      132       ,output v-cntxt-obj-type
      133       ,output v-cntxt-obj-code
      134       ,output v-cntxt-db-num-obj
      135       ,output v-cntxt-is-admin
      136       ) .
      137   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      138   define variable v-waitfram-action01         as character   no-undo .
      139   define variable v-waitfram-action02         as character   no-undo .
      140   define variable v-waitfram-action03         as character   no-undo .
      141   define variable mWaitFramTextBeg            as character   no-undo.
      142   define variable mWaitFramTextEnd            as character   no-undo.
      143   define variable mWaitFramView               as logical     no-undo.
      144   define variable mWaitProcEvent              as logical     no-undo init yes.
      145   define variable mWaitFramInterval           as integer     no-undo init 1 .
      146   define variable mWaitFramStop               as logical     no-undo.
      147   define variable mWaitFramStopUser           as logical     no-undo.
      148   define variable mWaitFramStopTimeOut        as logical     no-undo.
      149   define variable mWaitFramStartProc          as datetime-tz no-undo.
      150   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      151   define button B-WaitFramStop auto-end-key
      152        label "Стоп"
      153        size 10 by 1 tooltip "Остоновить процесс".
      154   define button B-viewProcInfo
      155        label "Информация"
      156        size 15 by 1 tooltip "Информация о процесс".
      157   define frame waitfram
      158     v-waitfram-action01 format "x(72)" no-label skip
      159     v-waitfram-action02 format "x(72)" no-label skip
      160     v-waitfram-action03 format "x(72)" no-label skip
      161     B-viewProcInfo
      162     B-WaitFramStop at row 4 col 30
      163     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      164     .
      165   define new global shared variable mBatchMode as logical no-undo init ?.
      166   define variable mFramBachModHandle as handle no-undo.
      167   mFramBachModHandle = frame waitfram:handle.
      168   define variable mFameOldVis as logical no-undo.
      169   define variable mVisCUrentVin as logical no-undo.
      170   if session:batch-mode
      171   then
      172      mBatchMode = yes.
      173   if mBatchMode = ? then do:
      174     mVisCUrentVin = current-window:visible.
      175     mFameOldVis = mFramBachModHandle:visible.
      176     mFramBachModHandle:visible  = yes.
      177     mBatchMode = mFramBachModHandle:visible ne yes.
      178     mFramBachModHandle:visible = mFameOldVis.
      179     current-window:visible = mVisCUrentVin.
      180   end.
      181    if  log-manager:logfile-name ne ?
      182     then DO:
      183         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      184         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      185         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      186     end.
      187   on choose of B-WaitFramStop in frame waitfram
      188   do:
      189     mWaitFramStop = yes.
      190     mWaitFramStopUser = yes.
      191   end.
      192   function waitfram-check-timeout returns logical():
      193      define variable vtime as int64 no-undo.
      194      if mWaitFramStopTimeOut
      195      then
      196         return yes.
      197      vtime = ( now - mWaitFramStartProc ) / 1000 .
      198      if     mWaitFramTimeOut ne ?
      199         and mWaitFramTimeOut ne 0
      200         and mWaitFramTimeOut lt vtime
      201      then do:
      202         mWaitFramStopTimeOut = yes.
      203      end.
      204      return mWaitFramStopTimeOut.
      205   end.
      206   procedure waitfram-hide :
      207     if not session:batch-mode
      208     then do
      209     on error undo, return error return-value
      210     :
      211       pause 0 before-hide .
      212       if not mBatchMode then
      213         hide frame waitfram .
      214     if     not mWaitFramView
      215        and mWaitProcEvent
      216     then
      217       process events .
      218     end.
      219   end procedure.
      220   procedure waitfram-show :
      221     define input  parameter p-message as character no-undo .
      222     define variable v-left-margin as integer   no-undo .
      223     if not session:batch-mode
      224     then do
      225     on error undo, return error return-value
      226     :
      227       if length(p-message) <= 70 then do:
      228         assign
      229           v-left-margin = integer((70 - length(p-message)) / 2)
      230         .
      231         assign
      232           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      233         .
      234         assign
      235           v-waitfram-action01 = " "
      236           v-waitfram-action02 = " "
      237                                    + fill(" ", v-left-margin)
      238                                    + p-message
      239           v-waitfram-action03 = " "
      240         .
      241       end.
      242       else do:
      243         define variable vRindex1 as integer no-undo.
      244         define variable vRindex2 as integer no-undo.
      245         vRindex1 = r-index(p-message," ",70).
      246         if vRindex1 = 0
      247         then
      248            vRindex1 = 70.
      249         if length(p-message)  <= vRindex1 + 70 then do:
      250           assign
      251             v-waitfram-action01 = " "
      252             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      253             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      254           .
      255         end.
      256         else do:
      257           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      258           if vRindex2 <= vRindex1
      259           then
      260              vRindex2 = vRindex1 + 70.
      261           assign
      262             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      263             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      264             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      265           .
      266         end.
      267       end.
      268       B-viewProcInfo:visible   in frame waitfram = no.
      269       B-viewProcInfo:sensitive in frame waitfram = no.
      270       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      271       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      272       if  (   mWaitFramView
      273          or  mWaitProcEvent)
      274          and not mBatchMode
      275       then
      276          display
      277             v-waitfram-action01 skip
      278             v-waitfram-action02 skip
      279             v-waitfram-action03 skip
      280          with frame waitfram .
      281       if     mWaitFramView
      282          then do:
      283             if     mWaitFramInterval ne ?
      284                and not mBatchMode
      285             then
      286                wait-for go of frame waitfram pause mWaitFramInterval.
      287          end.
      288          else
      289             if     mWaitProcEvent
      290                and not mBatchMode
      291             then
      292                process events .
      293     end.
      294   end procedure.
      295      procedure waitfram-show-this:
      296         define input  parameter iInterval as int64 no-undo.
      297         define variable vtime as int64 no-undo.
      298         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      299         mWaitFramInterval = iInterval.
      300         run waitfram-show (substitute("&1&2 &3&4" ,
      301                                       mWaitFramTextBeg ,
      302                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      303                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      304                                       mWaitFramTextEnd
      305                                      )
      306                           ).
      307      end.
      308      procedure WaitFramRunPause:
      309         define input  parameter iInterval as dec no-undo.
      310         define variable vStart  as datetime-tz no-undo.
      311         define variable vend    as datetime-tz no-undo.
      312         define variable vint as int64 no-undo.
      313         define variable vOk as logical no-undo.
      314         vStart = now.
      315         vend   = vStart.
      316         publish "WaitFramPause" (iInterval,output vOk).
      317         vend   =  now.
      318         vint = vend - vStart.
      319         vint = iInterval - vint / 1000.
      320         if     not mWaitFramStop
      321            and (   vint > 0
      322                 or (    not vOk
      323                     and iInterval eq ?
      324                     )
      325                 )
      326         then
      327            run waitfram-show-this (iInterval).
      328         vend   =  now.
      329         vint = vend - vStart.
      330         vint = iInterval - vint / 1000.
      331         if     not mWaitFramStop
      332            and vint > 0
      333         then do:
      334            run gbl/pause.p (vint * 1000).
      335         end.
      336         if iInterval ne ?
      337         then
      338            publish "WaitFramStop".
      339         waitfram-check-timeout().
      340      end.
      341      procedure WaitFramWaitFor:
      342         define input  parameter iInterval as dec no-undo.
      343         assign
      344            mWaitFramStartProc   = now
      345            mWaitFramStopUser    = no
      346            mWaitFramStopTimeOut = no
      347         .
      348         block-wait:
      349         do while not mWaitFramStop:
      350            run WaitFramRunPause (iInterval).
      351            if  waitfram-check-timeout()
      352            then do:
      353               leave block-wait.
      354            end.
      355         end.
      356         run waitfram-hide.
      357      end.
      358   procedure waitfram-join :
      359     define input  parameter p-line-1  as character no-undo .
      360     define input  parameter p-line-2  as character no-undo .
      361     define input  parameter p-line-3  as character no-undo .
      362     define output parameter p-message as character no-undo .
      363     do
      364     on error undo, return error return-value
      365     :
      366       assign
      367         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      368                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      369                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      370       .
      371     end.
      372   end procedure.
      373   function waitfram-join-function returns character
      374     (input p-line-1 as character
      375     ,input p-line-2 as character
      376     ,input p-line-3 as character
      377     ).
      378     define variable v-message as character no-undo .
      379     run waitfram-join in this-procedure
      380       (input  p-line-1
      381       ,input  p-line-2
      382       ,input  p-line-3
      383       ,output v-message
      384       ) .
      385     return v-message .
      386   end function .
      387   define variable v-sec as integer   no-undo .
      388   PROCEDURE SIS-ADD :
      389   define input  parameter p-db-num       as integer   no-undo .
      390   define input  parameter p-id           as integer   no-undo .
      391   define input  parameter p-ssg-summa    as decimal   no-undo .
      392   define input  parameter p-use-discnt           as logical   no-undo .
      393   define input  parameter p-discnt-pc            as decimal   no-undo .
      394   define input  parameter p-discnt-method-round  as character no-undo .
      395   define input  parameter p-stts         as integer   no-undo .
      396   define input  parameter p-db-num-usr   as integer   no-undo .
      397   define input  parameter p-userid       as character no-undo .
      398   define output parameter p-recid as recid no-undo .
      399     do
      400     on error undo, return error return-value
      401     :
      402   find first ub.sum-in-sum-group exclusive-lock where
      403           ub.sum-in-sum-group.sgr-db-num   = p-db-num  and
      404           ub.sum-in-sum-group.sgr-id       = p-id      and
      405           ub.sum-in-sum-group.ssg-summa    = p-ssg-summa
      406           no-error .
      407         if not available ub.sum-in-sum-group then do:
      408             create ub.sum-in-sum-group.
      409               assign
      410                   ub.sum-in-sum-group.sgr-db-num          = p-db-num
      411                   ub.sum-in-sum-group.sgr-id              = p-id
      412                   ub.sum-in-sum-group.ssg-summa           = p-ssg-summa
      413                   ub.sum-in-sum-group.use-discnt          = p-use-discnt
      414                   ub.sum-in-sum-group.discnt-pc           = p-discnt-pc
      415                   ub.sum-in-sum-group.discnt-method-round = p-discnt-method-round
      416               .
      417         end.
      418         assign
      419           ub.sum-in-sum-group.db-num-chg    = p-db-num-usr
      420           ub.sum-in-sum-group.stts          = p-stts
      421           ub.sum-in-sum-group.sys-date      = today
      422           ub.sum-in-sum-group.sys-time      = time
      423           ub.sum-in-sum-group.sys-time-chr  = string ( ub.sum-in-sum-group.sys-time,"hh:mm" )
      424           ub.sum-in-sum-group.who           = p-userid
      425           ub.sum-in-sum-group.use-discnt          = p-use-discnt
      426           ub.sum-in-sum-group.discnt-pc           = p-discnt-pc
      427           ub.sum-in-sum-group.discnt-method-round = p-discnt-method-round
      428           p-recid = recid ( ub.sum-in-sum-group )
      429         .
      430         run ref/h-grsu.p (buffer ub.sum-in-sum-group , input-output v-sec )  .
      431     end.
      432   end procedure.
      433   PROCEDURE SIS-DEL :
      434   define input  parameter p-db-num       as integer   no-undo .
      435   define input  parameter p-id           as integer   no-undo .
      436   define input  parameter p-ssg-summa    as decimal   no-undo .
      437   define input  parameter p-db-num-usr   as integer   no-undo .
      438   define input  parameter p-userid       as character no-undo .
      439     do
      440     on error undo, return error return-value
      441     :
      442   find first ub.sum-in-sum-group exclusive-lock where
      443           ub.sum-in-sum-group.sgr-db-num   = p-db-num  and
      444           ub.sum-in-sum-group.sgr-id       = p-id      and
      445           ub.sum-in-sum-group.ssg-summa = p-ssg-summa
      446           no-error .
      447    if not available ub.sum-in-sum-group then  return error .
      448         assign
      449           ub.sum-in-sum-group.db-num-chg    = p-db-num-usr
      450           ub.sum-in-sum-group.stts          = 1
      451           ub.sum-in-sum-group.sys-date      = today
      452           ub.sum-in-sum-group.sys-time      = time
      453           ub.sum-in-sum-group.sys-time-chr  = string(ub.sum-in-sum-group.sys-time,"hh:mm")
      454           ub.sum-in-sum-group.who           = p-userid
      455         .
      456         run ref/h-grsu.p (buffer ub.sum-in-sum-group , input-output v-sec )  .
      457     end.
      458   end procedure.
      459   PROCEDURE SIS-UPDATE :
      460   define input  parameter p-recid as recid no-undo .
      461   define input  parameter p-db-num       as integer   no-undo .
      462   define input  parameter p-id           as integer   no-undo .
      463   define input  parameter p-ssg-summa    as decimal   no-undo .
      464   define input  parameter p-use-discnt           as logical   no-undo .
      465   define input  parameter p-discnt-pc            as decimal   no-undo .
      466   define input  parameter p-discnt-method-round  as character no-undo .
      467   define input  parameter p-stts         as integer   no-undo .
      468   define input  parameter p-db-num-usr   as integer   no-undo .
      469   define input  parameter p-userid       as character no-undo .
      470     do
      471     on error undo, return error return-value
      472     :
      473   find first ub.sum-in-sum-group exclusive-lock where
      474              recid(ub.sum-in-sum-group) = p-recid
      475              no-error .
      476         if not available ub.sum-in-sum-group then do:
      477             create ub.sum-in-sum-group.
      478               assign
      479                   ub.sum-in-sum-group.sgr-db-num          = p-db-num
      480                   ub.sum-in-sum-group.sgr-id              = p-id
      481                   ub.sum-in-sum-group.ssg-summa           = p-ssg-summa
      482                   ub.sum-in-sum-group.use-discnt          = p-use-discnt
      483                   ub.sum-in-sum-group.discnt-pc           = p-discnt-pc
      484                   ub.sum-in-sum-group.discnt-method-round = p-discnt-method-round
      485               .
      486         end.
      487         assign
      488           ub.sum-in-sum-group.sgr-db-num          = p-db-num
      489           ub.sum-in-sum-group.sgr-id              = p-id
      490           ub.sum-in-sum-group.ssg-summa           = p-ssg-summa
      491           ub.sum-in-sum-group.db-num-chg          = p-db-num-usr
      492           ub.sum-in-sum-group.stts                = p-stts
      493           ub.sum-in-sum-group.sys-date            = today
      494           ub.sum-in-sum-group.sys-time            = time
      495           ub.sum-in-sum-group.sys-time-chr        = string ( ub.sum-in-sum-group.sys-time , "hh:mm" )
      496           ub.sum-in-sum-group.who                 = p-userid
      497           ub.sum-in-sum-group.use-discnt          = p-use-discnt
      498           ub.sum-in-sum-group.discnt-pc           = p-discnt-pc
      499           ub.sum-in-sum-group.discnt-method-round = p-discnt-method-round
      500         .
      501         run ref/h-grsu.p (buffer ub.sum-in-sum-group , input-output v-sec )  .
      502     end.
      503   end procedure.
      504   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      505   function usrfulnf returns character ( input p-user-id as character):
      506   define variable v-user-name as character no-undo .
      507   define variable vss-include-info4 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      508   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run usrfulnm in g#library
      509     (input  p-user-id
      510     ,output v-user-name
      511     ) no-error .
      512   if error-status:error
      513   or v-user-name = ""
      514   then do:
      515     return p-user-id.
      516   end.
      517   else do:
      518     return v-user-name.
      519   end.
      520   end function.
      521   define variable r-find  as logical   no-undo init false .
      522   define variable find-id as integer   no-undo .
      523   define variable find-db as integer   no-undo .
      524   define variable v-rec-list-cli as character no-undo .
      525   define variable g-log as logical   no-undo .
      526   function mark-string returns character
      527     ( buffer loc-table for ub.sum-group, input mark-list as character  ) :
      528     return ( if lookup( string( recid( loc-table ) ), mark-list ) > 0 then "*" else "":U ).
      529   end function.
      530   function mark-string-2 returns character
      531     ( buffer loc-table for ub.sum-in-sum-group , input mark-list as character  ) :
      532     return ( if lookup( string( recid( loc-table ) ), mark-list ) > 0 then "*" else "":U ).
      533   end function.
      534   function stts-string-2 returns character
      535     ( buffer loc-table for ub.sum-in-sum-group   ) :
      536   return entry (lookup (string(loc-table.stts), '0,1,50,99':U), 'тек,удал,блок,удаление':U) .
      537   end function.
      538   function stts-string returns character
      539     ( buffer loc-table for ub.sum-group   ) :
      540   return entry (lookup (string(loc-table.stts), '0,1,50,99':U), 'тек,удал,блок,удаление':U) .
      541   end function.
      542   DEFINE QUERY external_tables FOR buf_sum-group.
      543   DEFINE BUTTON B-add
      544        LABEL "Добавить"
      545        SIZE 10 BY 1 TOOLTIP "Добавить группу"
      546        BGCOLOR 8 .
      547   DEFINE BUTTON B-add-2
      548        LABEL "Добавить"
      549        SIZE 10 BY 1 TOOLTIP "Добавить сумму"
      550        BGCOLOR 8 .
      551   DEFINE BUTTON B-Cancel AUTO-END-KEY
      552        LABEL "Выход"
      553        SIZE 10 BY 1
      554        BGCOLOR 8 .
      555   DEFINE BUTTON B-chg
      556        LABEL "Изменить"
      557        SIZE 10 BY 1 TOOLTIP "Изменить название группы"
      558        BGCOLOR 8 .
      559   DEFINE BUTTON B-chg2
      560        LABEL "Изменить"
      561        SIZE 10 BY 1 TOOLTIP "Изменить сумму и процент скидки"
      562        BGCOLOR 8 .
      563   DEFINE BUTTON B-del
      564        LABEL "Удалить"
      565        SIZE 10 BY 1 TOOLTIP "Удалить группу"
      566        BGCOLOR 8 .
      567   DEFINE BUTTON B-del-2
      568        LABEL "Удалить"
      569        SIZE 10 BY 1 TOOLTIP "Удалить сумму"
      570        BGCOLOR 8 .
      571   DEFINE BUTTON B-Help
      572        LABEL "Помо&щь"
      573        SIZE 10 BY 1
      574        BGCOLOR 8 .
      575   DEFINE BUTTON B-history
      576        LABEL "История"
      577        SIZE 10 BY 1 TOOLTIP "История изменения справочника"
      578        BGCOLOR 8 .
      579   DEFINE BUTTON B-mark
      580        LABEL "*"
      581        SIZE 3.25 BY 1 TOOLTIP "Отметить группу"
      582        BGCOLOR 8 .
      583   DEFINE BUTTON B-mark-2
      584        LABEL "*"
      585        SIZE 3.25 BY 1 TOOLTIP "Отметить сумму"
      586        BGCOLOR 8 .
      587   DEFINE BUTTON B-print
      588        LABEL "Печать"
      589        SIZE 10 BY 1 TOOLTIP "Печать справочника"
      590        BGCOLOR 8 .
      591   DEFINE BUTTON B-sel AUTO-GO
      592        LABEL "Выбор"
      593        SIZE 10 BY 1
      594        BGCOLOR 8 .
      595   DEFINE VARIABLE FILL-IN-1 AS CHARACTER FORMAT "X(256)":U INITIAL "Статус:"
      596         VIEW-AS TEXT
      597        SIZE 7.5 BY .67
      598        FGCOLOR 4  NO-UNDO.
      599   DEFINE VARIABLE R-status AS INTEGER
      600        VIEW-AS RADIO-SET HORIZONTAL
      601        RADIO-BUTTONS
      602             "Текущие", 0,
      603   "Все", 2,
      604   "Удаленные", 1
      605        SIZE 30.5 BY .67 TOOLTIP "Условие отбора записей" NO-UNDO.
      606   DEFINE QUERY BROWSE-1grp FOR
      607         buf_sum-group SCROLLING.
      608   DEFINE QUERY BROWSE-2cli FOR
      609         buf_sum-in-sum-group SCROLLING.
      610   DEFINE BROWSE BROWSE-1grp
      611     QUERY BROWSE-1grp NO-LOCK DISPLAY
      612         mark-string(buffer buf_sum-group, p-rec-list) COLUMN-LABEL "*! " FORMAT "x(1)":U
      613         stts-string(buffer buf_sum-group) COLUMN-LABEL "Ста!тус" FORMAT "x(3)":U
      614         buf_sum-group.sgr-id COLUMN-LABEL "Код! " FORMAT ">>9":U
      615         buf_sum-group.name COLUMN-LABEL "Название!группы" FORMAT "X(80)":U
      616         usrfulnf(buf_sum-group.who) COLUMN-LABEL "Кто!изменял" FORMAT "X(15)":U
      617         buf_sum-group.sys-date COLUMN-LABEL "Дата!изм" FORMAT "99/99/99":U
      618         buf_sum-group.sys-time-chr COLUMN-LABEL "Время!изм" FORMAT "X(5)":U
      619         buf_sum-group.db-num-chg COLUMN-LABEL "БД!изм" FORMAT ">>9":U
      620         buf_sum-group.sgr-db-num FORMAT ">9":U
      621       WITH NO-ROW-MARKERS SEPARATORS SIZE 48.13 BY 19
      622            TITLE "Cуммовые группы" FIT-LAST-COLUMN.
      623   DEFINE BROWSE BROWSE-2cli
      624     QUERY BROWSE-2cli NO-LOCK DISPLAY
      625         mark-string-2(buffer buf_sum-in-sum-group, v-rec-list-cli) COLUMN-LABEL "*! " FORMAT "x(1)":U
      626         stts-string-2(buffer buf_sum-in-sum-group) COLUMN-LABEL "Ста!тус" FORMAT "x(3)":U
      627         buf_sum-in-sum-group.ssg-summa COLUMN-LABEL "Сумма! " FORMAT "->,>>>,>>>,>>>,>>9.99":U
      628         buf_sum-in-sum-group.discnt-pc COLUMN-LABEL "Скидка!% " FORMAT ">>9.99":U
      629         usrfulnf(buf_sum-in-sum-group.who) COLUMN-LABEL "Кто!изменял" FORMAT "X(15)":U
      630         buf_sum-in-sum-group.sys-date COLUMN-LABEL "Дата!изм" FORMAT "99/99/99":U
      631         buf_sum-in-sum-group.sys-time-chr COLUMN-LABEL "Время!изм" FORMAT "X(5)":U
      632         buf_sum-in-sum-group.db-num-chg COLUMN-LABEL "БД!изм" FORMAT ">>>>9":U
      633         buf_sum-in-sum-group.sgr-id COLUMN-LABEL "Гру!ппа" FORMAT ">>9":U
      634         buf_sum-in-sum-group.sgr-db-num FORMAT ">>>>9":U
      635       WITH NO-ROW-MARKERS SEPARATORS SIZE 50.5 BY 19
      636            TITLE "Суммы в группе" FIT-LAST-COLUMN.
      637   DEFINE FRAME Dialog-Frame
      638        B-Cancel AT ROW 1 COL 1
      639        B-sel AT ROW 1 COL 11
      640        B-chg AT ROW 1 COL 21 WIDGET-ID 2
      641        B-add AT ROW 1 COL 31
      642        B-del AT ROW 1 COL 41
      643        B-history AT ROW 1 COL 79.88
      644        B-Help AT ROW 1 COL 90
      645        B-print AT ROW 2 COL 90
      646        R-status AT ROW 2.29 COL 9.63 NO-LABEL
      647        B-mark-2 AT ROW 2.92 COL 49.75
      648        B-add-2 AT ROW 2.92 COL 53
      649        B-chg2 AT ROW 2.92 COL 63.13
      650        B-del-2 AT ROW 2.92 COL 73.13
      651        B-mark AT ROW 3 COL 1.75
      652        BROWSE-1grp AT ROW 4 COL 1.38
      653        BROWSE-2cli AT ROW 4 COL 49.5
      654        FILL-IN-1 AT ROW 2.25 COL 2 NO-LABEL
      655        SPACE(90.88) SKIP(20.21)
      656       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      657            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      658            TITLE "Суммовые группы для ценообразования"
      659            DEFAULT-BUTTON B-sel CANCEL-BUTTON B-Cancel.
      660   ASSIGN
      661          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      662          FRAME Dialog-Frame:HIDDEN           = TRUE.
      663   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      664   DO:
      665     APPLY "END-ERROR":U TO SELF.
      666   END.
      667   ON CHOOSE OF B-add IN FRAME Dialog-Frame
      668   DO:
      669      define variable g#log as logical   no-undo .
      670   define variable vss-include-info5 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      671   do:
      672     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      673       (input  v-cntxt-db-num
      674       ,input  v-cntxt-userid
      675       ,input  0
      676       ,input  'actn_ref-mpl_update':U
      677       ,input  'global':U
      678       ,input  v-cntxt-host-code-obj
      679       ,input  v-cntxt-obj-type
      680       ,input  v-cntxt-obj-code
      681       ,input  0
      682       ,input  0
      683       ,input  0
      684       ,input  true
      685       ,output g#log
      686       )  .
      687   end.
      688     if not g#log then return .
      689   define variable v-rec-id as recid no-undo .
      690     run ref/gr-supra.w (input parparentproc,input 'ДОБАВЛЕНИЕ':U , input-output v-rec-id) .
      691     OPEN QUERY BROWSE-1grp FOR EACH buf_sum-group WHERE ( r-status = 2 OR buf_sum-group.stts =  r-status ) and   ( r-find = no or (buf_sum-group.sgr-db-num = find-db and                         buf_sum-group.sgr-id = find-id ))  .
      692     reposition BROWSE-1grp to recid v-rec-id no-error .
      693     apply "VALUE-CHANGED" to browse-1grp in frame Dialog-Frame.
      694   END.
      695   ON CHOOSE OF B-add-2 IN FRAME Dialog-Frame
      696   DO:
      697      define variable g#log as logical   no-undo .
      698   define variable vss-include-info6 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      699   do:
      700     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      701       (input  v-cntxt-db-num
      702       ,input  v-cntxt-userid
      703       ,input  0
      704       ,input  'actn_ref-mpl_update':U
      705       ,input  'global':U
      706       ,input  v-cntxt-host-code-obj
      707       ,input  v-cntxt-obj-type
      708       ,input  v-cntxt-obj-code
      709       ,input  0
      710       ,input  0
      711       ,input  0
      712       ,input  true
      713       ,output g#log
      714       )  .
      715   end.
      716     if not g#log then return .
      717   define variable v-rec-id as recid no-undo .
      718   if not available buf_sum-group then return .
      719   if buf_sum-group.stts <> 0 then do:
      720      message "В эту группу добавлять сумму нельзя!" view-as alert-box error .
      721      return .
      722   end.
      723   if v-cntxt-db-num <> 0 then do :
      724      if buf_sum-group.sgr-db-num <> v-cntxt-db-num then do:
      725         message substitute(" Группа создана в другой БД (&1) , корректировать ее в текущей БД нельзя !" , buf_sum-group.sgr-db-num ) .
      726         return .
      727      end.
      728   end.
      729     run ref/gr-suprb.w (
      730         input parparentproc ,
      731         input 'ДОБАВЛЕНИЕ':U ,
      732         input buf_sum-group.sgr-db-num ,
      733         input buf_sum-group.sgr-id     ,
      734         input buf_sum-group.name ,
      735         input-output v-rec-id ) .
      736     OPEN QUERY BROWSE-2cli FOR EACH buf_sum-in-sum-group OF buf_sum-group      WHERE ( r-status = 2 OR buf_sum-in-sum-group.stts =  r-status )       NO-LOCK INDEXED-REPOSITION.
      737     reposition BROWSE-2cli to recid v-rec-id no-error .
      738   END.
      739   ON CHOOSE OF B-chg IN FRAME Dialog-Frame
      740   DO:
      741      define variable g#log as logical   no-undo .
      742   define variable vss-include-info7 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      743   do:
      744     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      745       (input  v-cntxt-db-num
      746       ,input  v-cntxt-userid
      747       ,input  0
      748       ,input  'actn_ref-mpl_update':U
      749       ,input  'global':U
      750       ,input  v-cntxt-host-code-obj
      751       ,input  v-cntxt-obj-type
      752       ,input  v-cntxt-obj-code
      753       ,input  0
      754       ,input  0
      755       ,input  0
      756       ,input  true
      757       ,output g#log
      758       )  .
      759   end.
      760     if not g#log then return .
      761   define variable v-rec-id as recid no-undo .
      762   IF NOT AVAILABLE buf_sum-group THEN RETURN.
      763      if buf_sum-group.stts <> 0 then do:
      764         message " Группа удалена " .
      765         return .
      766      end.
      767   if v-cntxt-db-num <> 0 then do :
      768      if buf_sum-group.sgr-db-num <> v-cntxt-db-num then do:
      769         message substitute(" Группа создана в другой БД (&1) , корректировать ее в текущей БД нельзя !" , buf_sum-group.sgr-db-num ) .
      770         return .
      771      end.
      772   end.
      773     v-rec-id = RECID(buf_sum-group) .
      774     run ref/gr-supra.w (input parparentproc,input 'ИЗМЕНЕНИЕ':U , input-output v-rec-id) .
      775     OPEN QUERY BROWSE-1grp FOR EACH buf_sum-group WHERE ( r-status = 2 OR buf_sum-group.stts =  r-status ) and   ( r-find = no or (buf_sum-group.sgr-db-num = find-db and                         buf_sum-group.sgr-id = find-id ))  .
      776     reposition BROWSE-1grp to recid v-rec-id no-error .
      777     apply "VALUE-CHANGED" to browse-1grp in frame Dialog-Frame.
      778   END.
      779   ON CHOOSE OF B-chg2 IN FRAME Dialog-Frame
      780   DO:
      781      define variable g#log as logical   no-undo .
      782   define variable vss-include-info8 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      783   do:
      784     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      785       (input  v-cntxt-db-num
      786       ,input  v-cntxt-userid
      787       ,input  0
      788       ,input  'actn_ref-mpl_update':U
      789       ,input  'global':U
      790       ,input  v-cntxt-host-code-obj
      791       ,input  v-cntxt-obj-type
      792       ,input  v-cntxt-obj-code
      793       ,input  0
      794       ,input  0
      795       ,input  0
      796       ,input  true
      797       ,output g#log
      798       )  .
      799   end.
      800     if not g#log then return .
      801   define variable v-rec-id as recid no-undo .
      802   if not available buf_sum-group then return .
      803   if not available buf_sum-in-sum-group then return .
      804   if v-cntxt-db-num <> 0 then do :
      805      if buf_sum-group.sgr-db-num <> v-cntxt-db-num then do:
      806         message substitute(" Группа создана в другой БД (&1) , корректировать ее в текущей БД нельзя !" , buf_sum-group.sgr-db-num ) .
      807         return .
      808      end.
      809   end.
      810   if buf_sum-group.stts <> 0 then do:
      811      message "В этой группе изменять сумму нельзя!" view-as alert-box error .
      812      return .
      813   end.
      814   if buf_sum-in-sum-group.stts <> 0 then do:
      815      message "Изменять сумму нельзя!" view-as alert-box error .
      816      return .
      817   end.
      818   v-rec-id = RECID (buf_sum-in-sum-group )  .
      819     run ref/gr-suprb.w (
      820         input parparentproc ,
      821         input 'ИЗМЕНЕНИЕ':U ,
      822         input buf_sum-group.sgr-db-num ,
      823         input buf_sum-group.sgr-id     ,
      824         input buf_sum-group.name ,
      825         input-output v-rec-id ) .
      826     OPEN QUERY BROWSE-2cli FOR EACH buf_sum-in-sum-group OF buf_sum-group      WHERE ( r-status = 2 OR buf_sum-in-sum-group.stts =  r-status )       NO-LOCK INDEXED-REPOSITION.
      827     reposition BROWSE-2cli to recid v-rec-id no-error .
      828   END.
      829   ON CHOOSE OF B-del IN FRAME Dialog-Frame
      830   DO:
      831      define variable g#log as logical   no-undo .
      832   define variable vss-include-info9 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      833   do:
      834     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      835       (input  v-cntxt-db-num
      836       ,input  v-cntxt-userid
      837       ,input  0
      838       ,input  'actn_ref-mpl_update':U
      839       ,input  'global':U
      840       ,input  v-cntxt-host-code-obj
      841       ,input  v-cntxt-obj-type
      842       ,input  v-cntxt-obj-code
      843       ,input  0
      844       ,input  0
      845       ,input  0
      846       ,input  true
      847       ,output g#log
      848       )  .
      849   end.
      850     if not g#log then return .
      851     if not available buf_sum-group then return .
      852      if buf_sum-group.stts <> 0 then do:
      853         message " Группа удалена " .
      854         return .
      855      end.
      856     message "Удалять группу " buf_sum-group.name "?"
      857             view-as alert-box question
      858             buttons yes-no update g-ok as log.
      859     if not g-ok then return .
      860     run ref/gr-sudel.p (
      861         input parparentproc ,
      862         input buf_sum-group.sgr-db-num ,
      863         input buf_sum-group.sgr-id      )
      864         no-error .
      865    if error-status :error then return no-apply .
      866    OPEN QUERY BROWSE-1grp FOR EACH buf_sum-group WHERE ( r-status = 2 OR buf_sum-group.stts =  r-status ) and   ( r-find = no or (buf_sum-group.sgr-db-num = find-db and                         buf_sum-group.sgr-id = find-id ))  .
      867    OPEN QUERY BROWSE-2cli FOR EACH buf_sum-in-sum-group OF buf_sum-group      WHERE ( r-status = 2 OR buf_sum-in-sum-group.stts =  r-status )       NO-LOCK INDEXED-REPOSITION.
      868   END.
      869   ON CHOOSE OF B-del-2 IN FRAME Dialog-Frame
      870   DO:
      871      define variable g#log as logical   no-undo .
      872   define variable vss-include-info10 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      873   do:
      874     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      875       (input  v-cntxt-db-num
      876       ,input  v-cntxt-userid
      877       ,input  0
      878       ,input  'actn_ref-mpl_update':U
      879       ,input  'global':U
      880       ,input  v-cntxt-host-code-obj
      881       ,input  v-cntxt-obj-type
      882       ,input  v-cntxt-obj-code
