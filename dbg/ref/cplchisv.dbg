        6   define input parameter p-corr-user-db-num like ub.c-plc-hist.corr-user-db-num no-undo .
        7   define input parameter p-subject like ub.c-plc-hist.subject no-undo .
        8   define input parameter p-action   like ub.c-plc-hist.action no-undo .
        9   define input parameter p-silent  as logical no-undo .
       10   define output parameter p-description as character no-undo .
       11   define variable vss-revision    as character no-undo init "$Revision: 63f60a8c7447, 2876, rls $":U .
       12   define variable vss-author      as character no-undo init "$Author: SSlivenko $":U .
       13   define variable vss-date        as character no-undo init "$Date: Пн ноя 22 19:49:10 2021 +0300 $":U .
       14   define variable vss-workfile    as character no-undo init "$Workfile: cplchisv.p $":U .
       15   define variable vss-archive     as character no-undo init "$Archive: ref/cplchisv.p $":U .
       16   define variable vss-description as character no-undo init "Заполнение временной таблицы для показа изменений по таблицам истории скл места".
       17   procedure vss-get-info :
       18     define output parameter p-vss-revision    like vss-revision    no-undo .
       19     define output parameter p-vss-author      like vss-author      no-undo .
       20     define output parameter p-vss-date        like vss-date        no-undo .
       21     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       22     define output parameter p-vss-archive     like vss-archive     no-undo .
       23     define output parameter p-vss-description like vss-description no-undo .
       24     assign
       25       p-vss-revision    = vss-revision
       26       p-vss-author      = vss-author
       27       p-vss-date        = vss-date
       28       p-vss-workfile    = vss-workfile
       29       p-vss-archive     = vss-archive
       30       p-vss-description = vss-description
       31     .
