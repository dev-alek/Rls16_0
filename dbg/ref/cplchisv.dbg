      504   define variable v-mess as character no-undo .
      505   define buffer buf_c-plc-hist for ub.c-plc-hist.
      506   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      507   define SHARED temp-table temp-changes no-undo
      508   field f_name as character
      509   field l_name as character
      510   field v_old as character
      511   field v_new as character
      512   field t_name as character
      513   field num_ as integer
      514   field uniq-key-rec as character
      515   field action as integer
      516   field fNotChange as logical
      517   index pi is unique primary
      518   num_
      519   t_name
      520   f_name
      521   index
      522   Chan
      523   fnotChange
      524   t_name
      525   f_name
      526   index imain uniq-key-rec
      527   .
      528   FUNCTION get-all-fields returns character (p-file-name as character ):
      529   define variable v-dop as character no-undo .
      530     find first _file no-lock where _file._file-name = p-file-name no-error .
      531     if not available _file then return "":U.
      532     for each _field no-lock where
      533              _field._file-recid = recid(_file) :
      534       assign
      535       v-dop = v-dop + _field._field-name + chr(44)
      536       .
      537     end.
      538     return trim(v-dop).
      539   END FUNCTION.
      540   PROCEDURE proc-full-temp-changes :
      541     define input  parameter p-act-create as logical   no-undo .
      542     define input  parameter p-act-delete as logical   no-undo .
      543     define input  parameter p-hst-handle as handle    no-undo .
      544     define input  parameter p-main-table as character no-undo .
      545     define input  parameter p-field-list as character no-undo .
      546     define input  parameter p-label-form as character no-undo .
      547     define variable h-new-buf         as handle    no-undo .
      548     define variable h-main-buf        as handle    no-undo .
      549     define variable h-for-comp        as handle    no-undo .
      550     define variable v-inform          as character no-undo .
      551     define variable v-ind             as integer   no-undo .
      552     define variable v-idx-field-qnty  as integer   no-undo .
      553     define variable v-num-entries     as integer   no-undo .
      554     define variable fh                as handle    no-undo .
      555     define variable fh-main           as handle    no-undo .
      556     define variable fh-old            as handle    no-undo .
      557     define variable fh-new            as handle    no-undo .
      558     define variable v-field-name      as character no-undo .
      559     define variable v-field-lvl       as character no-undo .
      560     define variable v-field-form      as character no-undo .
      561     define variable v-search-exp      as character no-undo .
      562     define variable v-srch-main       as character no-undo .
      563     define variable v-word-link       as character no-undo .
      564     define variable v-av-chip-num     as logical   no-undo .
      565     define variable v-main-pi-fld-lst as character no-undo .
      566     define variable v-main-fld-lst    as character no-undo .
      567     define variable v-delim-list      as character no-undo .
      568     define variable v-label           as character no-undo .
      569     define variable v-old-value       as character no-undo case-sensitive.
      570     define variable v-new-value       as character no-undo case-sensitive.
      571     define variable v-chg-fields as character no-undo.
      572     for each temp-changes:
      573       delete temp-changes.
      574     end.
      575     if not p-hst-handle:available then do:
      576       return .
      577     end.
      578     create buffer h-new-buf  for table p-hst-handle .
      579     create buffer h-main-buf for table p-main-table .
      580     assign
      581       v-inform = h-main-buf:index-information(1)
      582       v-ind    = 2
      583     .
      584     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      585     on error undo, return error
      586     :
      587       assign
      588         v-inform = h-main-buf:index-information( v-ind )
      589         v-ind    = v-ind + 1
      590       .
      591     end.
      592     if v-inform = ?
      593       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      594       or entry( 3, v-inform, ",":U ) <> "1":U
      595     then do:
      596       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, h-main-buf:name ).
      597     end.
      598     assign
      599       v-idx-field-qnty = num-entries( v-inform ) - 4
      600     .
      601     if v-idx-field-qnty < 2 then do:
      602       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, h-main-buf:name ).
      603     end.
      604     assign
      605       v-srch-main   = "where":U
      606       v-word-link   = "":U
      607       v-av-chip-num = false
      608       v-delim-list  = "":U
      609     .
      610     do v-ind = 1 to v-idx-field-qnty by 2
      611     on error undo, return error
      612     :
      613       assign
      614         v-field-name      = entry( 4 + v-ind, v-inform, ",":U )
      615         fh                = p-hst-handle:buffer-field( v-field-name )
      616         fh-main           = h-main-buf:buffer-field( v-field-name )
      617         v-srch-main       = substitute( "&1 &2 &3.&4 =", v-srch-main, v-word-link, fh-main:table, v-field-name )
      618         v-main-pi-fld-lst = v-main-pi-fld-lst + v-delim-list + v-field-name
      619       .
      620       if fh:data-type ="character":U then do:
      621         assign
      622           v-srch-main = substitute( '&1 "&2"', v-srch-main, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
      623         .
      624       end.
      625       else do:
      626         assign
      627           v-srch-main = substitute( "&1 &2", v-srch-main, fh:buffer-value() )
      628         .
      629       end.
      630       if v-delim-list = "":U then do:
      631         assign
      632           v-delim-list = ",":U
      633         .
      634       end.
      635       if v-word-link = "":U then do:
      636         assign
      637           v-word-link = "and":U
      638         .
      639       end.
      640     end.
      641     assign
      642       v-delim-list  = "":U
      643     .
      644     do v-ind = 1 to h-main-buf:num-fields
      645     on error undo, return error
      646     :
      647       assign
      648         fh-main      = h-main-buf:buffer-field( v-ind )
      649         v-field-name = fh-main:name
      650       .
      651         assign
      652           v-main-fld-lst = v-main-fld-lst + v-delim-list + v-field-name
      653         .
      654         if v-delim-list = "":U then do:
      655           assign
      656             v-delim-list = ",":U
      657           .
      658         end.
      659     end.
      660     assign
      661       v-inform = p-hst-handle:index-information(1)
      662       v-ind    = 2
      663     .
      664     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      665     on error undo, return error
      666     :
      667       assign
      668         v-inform = p-hst-handle:index-information( v-ind )
      669         v-ind    = v-ind + 1
      670       .
      671     end.
      672     if v-inform = ?
      673       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      674       or entry( 3, v-inform, ",":U ) <> "1":U
      675     then do:
      676       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, p-hst-handle:name ).
      677     end.
      678     assign
      679       v-idx-field-qnty = num-entries( v-inform ) - 4
      680     .
      681     if v-idx-field-qnty < 2 then do:
      682       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, p-hst-handle:name ).
      683     end.
      684     assign
      685       v-search-exp  = "where":U
      686       v-word-link   = "":U
      687       v-av-chip-num = false
      688     .
      689     do v-ind = 1 to v-idx-field-qnty by 2
      690     on error undo, return error
      691     :
      692       assign
      693         v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      694         fh           = p-hst-handle:buffer-field( v-field-name )
      695         v-search-exp = substitute( "&1 &2 &3.&4", v-search-exp, v-word-link, fh:table, v-field-name )
      696       .
      697       if v-field-name = "chip-num":U then do:
      698         assign
      699           v-search-exp  = substitute( "&1 >", v-search-exp )
      700           v-av-chip-num = true
      701         .
      702       end.
      703       else do:
      704         assign
      705           v-search-exp = substitute( "&1 =", v-search-exp )
      706         .
      707       end.
      708       if fh:data-type ="character":U then do:
      709         assign
      710           v-search-exp = substitute( '&1 "&2"', v-search-exp, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
      711         .
      712       end.
      713       else do:
      714         assign
      715           v-search-exp = substitute( '&1 &2', v-search-exp, fh:buffer-value() )
      716         .
      717       end.
      718       if v-word-link = "":U then do:
      719         assign
      720           v-word-link = "and":U
      721         .
      722       end.
      723     end.
      724     if v-av-chip-num = false then do:
      725       message
      726         vss-workfile vss-revision vss-description skip
      727         substitute( "Таблица &2 не содержит поля chip-num.", vss-workfile, p-hst-handle:name ) skip
      728         "Использование данной процедуры невозможно!" skip
      729         view-as alert-box error .
      730       return error .
      731     end.
      732     h-new-buf:find-first( v-search-exp, no-lock ) no-error .
      733     if not h-new-buf:available then do:
      734       h-main-buf:find-first( v-srch-main, no-lock ) no-error .
      735       if not h-main-buf:available then do:
      736         assign
      737           h-for-comp = ?
      738         .
      739       end.
      740       else do:
      741         assign
      742           h-for-comp = h-main-buf
      743         .
      744       end.
      745     end.
      746     else do:
      747       assign
      748         h-for-comp = h-new-buf
      749       .
      750     end.
      751     assign
      752       v-num-entries = num-entries( v-main-fld-lst, ",":U )
      753     .
      754     do v-ind = 1 to v-num-entries
      755     on error undo, return error return-value
      756     :
      757       assign
      758         v-field-name = entry( v-ind, v-main-fld-lst )
      759         fh-old       = p-hst-handle:buffer-field( v-field-name )
      760         v-old-value  = fh-old:buffer-value()
      761         v-label      = trim( fh-old:label )
      762       .
      763       if ( trim( p-field-list ) <> "":U
      764            and lookup( v-field-name, p-field-list ) > 0
      765          )
      766          or trim( p-field-list ) = "":U
      767       then do:
      768         if h-for-comp <> ? then do:
      769           assign
      770             fh-new      = h-for-comp:buffer-field( v-field-name )
      771             v-new-value = fh-new:buffer-value()
      772           .
      773         end.
      774         else do:
      775           assign
      776             v-new-value = "":U
      777           .
      778         end.
      779           if p-act-create = true then do:
      780             assign
      781               v-old-value = "":U
      782             .
      783           end.
      784           if p-act-delete = true then do:
      785             assign
      786               v-new-value = "":U
      787             .
      788           end.
      789         if v-old-value <> v-new-value
      790           or lookup(v-field-name,v-main-pi-fld-lst) ne 0
      791         then do:
      792           create temp-changes.
      793           assign
      794             temp-changes.t_name = p-main-table
      795             temp-changes.f_name = v-field-name
      796             temp-changes.l_name = replace( v-label, "&":U, "":U )
      797             temp-changes.v_old  = trim( v-old-value )
      798             temp-changes.v_new  = trim( v-new-value )
      799             temp-changes.num_   = 0
      800             temp-changes.fNotChange = v-old-value eq v-new-value
      801           .
      802         end.
      803       end.
      804     end.
      805     assign
      806       v-num-entries = num-entries( p-label-form, chr(8) )
      807     .
      808     do v-ind = 1 to v-num-entries
      809     on error undo, return error return-value
      810     :
      811       if num-entries( entry( v-ind, p-label-form, chr(8) ), chr(4) ) = 3 then do:
      812         assign
      813           v-field-name = entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
      814           v-field-lvl  = entry( 2, entry( v-ind, p-label-form, chr(8) ), chr(4) )
      815           v-field-form = entry( 3, entry( v-ind, p-label-form, chr(8) ), chr(4) )
      816         .
      817         find first temp-changes
      818           where temp-changes.f_name = v-field-name
      819           no-error .
      820         if available temp-changes then do:
      821           if trim( v-field-lvl ) <> "":U then do:
      822             assign
      823               temp-changes.l_name = v-field-lvl
      824             .
      825           end.
      826           if trim( v-field-form ) <> "":U then do:
      827             assign
      828               temp-changes.v_old = dynamic-function( v-field-form, temp-changes.v_old )
      829             .
      830             if h-for-comp <> ? then do:
      831               assign
      832                 temp-changes.v_new = dynamic-function( v-field-form, temp-changes.v_new )
      833               .
      834             end.
      835           end.
      836         end.
      837       end.
      838       else do:
      839         message
      840           vss-workfile vss-revision vss-description skip
      841           "Ошибка! Список должен содержать три поля с разделителем delim-par!" skip
      842           substitute( "список для поля '&1': '&2'"
      843                       ,entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
      844                       ,entry( v-ind, p-label-form, chr(8) )
      845                     ) skip
      846           substitute( "полный список: &2", p-label-form ) skip
      847           view-as alert-box error .
      848       end.
      849     end.
      850     delete object h-new-buf .
      851     delete object h-main-buf .
      852   END PROCEDURE.
      853   find first buf_c-plc-hist no-lock where
      854             buf_c-plc-hist.obj-type = p-obj-type
      855         AND buf_c-plc-hist.obj-code = p-obj-code
      856         AND buf_c-plc-hist.pl-code = p-pl-code
      857         AND buf_c-plc-hist.chip-num = p-chip-num
      858         AND buf_c-plc-hist.corr-user-db-num = p-corr-user-db-num
      859         AND buf_c-plc-hist.subject  = p-subject no-error .
      860   if not available buf_c-plc-hist then do:
      861     return error .
      862   end.
      863   CASE p-subject:
      864     when 'place':U then do:
      865       run place-proc in this-procedure(output p-description) no-error  .
      866     end.
      867     when 'pl-gds':U then do:
      868       run pl-gds-proc in this-procedure(output p-description) no-error  .
      869     end.
      870     when 'pl-gds-pump':U then do:
      871       run pl-gds-pump-proc in this-procedure(output p-description) no-error  .
      872     end.
      873     when 'pl-pump':U then do:
      874       run pl-pump-proc in this-procedure(output p-description) no-error  .
      875     end.
      876     when 'pl-pump-nozzle':U then do:
      877       run pl-pump-nozzle-proc in this-procedure(output p-description) no-error  .
      878     end.
      879     when 'place-attr':U then do:
      880       run place-attr-proc in this-procedure(output p-description) no-error  .
      881     end.
      882     when 'pl-gds-attr':U then do:
      883       run pl-gds-attr-proc in this-procedure(output p-description) no-error  .
      884     end.
      885     when 'pl-level':U then do:
      886       run pl-level-proc in this-procedure(output p-description) no-error  .
      887     end.
      888   END CASE.
      889   if error-status:error then do:
      890     return error substitute("&1 &2", error-status:get-message(1), return-value ) .
      891   end.
      892   procedure place-proc :
      893   define output parameter p-description as character no-undo .
      894   define buffer curr_c-place for ub.c-place  .
      895     do
      896     on error undo, return error
      897     :
      898       find first curr_c-place no-lock where
      899                  curr_c-place.obj-type = p-obj-type
      900              AND curr_c-place.obj-code = p-obj-code
      901              AND curr_c-place.pl-code = buf_c-plc-hist.pl-code
      902              AND curr_c-place.chip-num = p-chip-num
      903              AND curr_c-place.corr-user-db-num = p-corr-user-db-num
      904              no-error .
      905       if not avail curr_c-place then do:
      906         v-mess = "Неверная ссылка на c-place в таблице c-plc-hist".
      907         run err-mess in this-procedure ( input-output v-mess).
      908         return error v-mess.
      909       end.
      910   define variable v-label-param as character no-undo .
      911   v-label-param =
      912     "add-qnty" + chr(4) + "Дополнительное количество" + chr(4) + "" + chr(8)
      913    + "is-meas" + chr(4) + "Измеряется приборами" + chr(4) + "" + chr(8)
      914    + "loc1" + chr(4) + "Коорд1" + chr(4) + "" + chr(8)
      915    + "loc2" + chr(4) + "Коорд2" + chr(4) + "" + chr(8)
      916    + "loc3" + chr(4) + "Коорд3" + chr(4) + "" + chr(8)
      917    + "loc4" + chr(4) + "Коорд4" + chr(4) + "" + chr(8)
      918    + "max-qnty" + chr(4) + "Максимальное количество" + chr(4) + "" + chr(8)
      919    + "obj-code" + chr(4) + "Код объектаТип объекта" + chr(4) + "" + chr(8)
      920    + "obj-type" + chr(4) + "Код объекта" + chr(4) + "" + chr(8)
      921    + "pl-code" + chr(4) + "Код складского места" + chr(4) + "" + chr(8)
      922    + "pl-name" + chr(4) + "Название" + chr(4) + "" + chr(8)
      923    + "PS" + chr(4) + "Описание" + chr(4) + "" + chr(8)
      924    + "status_" + chr(4) + "Статус" + chr(4) + ""  .
      925    run proc-full-temp-changes in this-procedure (
      926                                                input buf_c-plc-hist.action = integer('1':U)
      927                                               ,input buf_c-plc-hist.action = integer('99':U)
      928                                               ,input  buffer curr_c-place:handle
      929                                               ,input  'place':U
      930                                               ,input  "add-qnty,is-meas,loc1,loc2,loc3,loc4,max-qnty,pl-name,PS,status_"
      931                                               ,input  v-label-param).
      932   end.
      933   end procedure.
      934   procedure pl-gds-proc :
      935   define output parameter p-description as character no-undo .
      936   define buffer curr_c-pl-gds for ub.c-pl-gds  .
      937     do
      938     on error undo, return error
      939     :
      940       find first curr_c-pl-gds no-lock where
      941                  curr_c-pl-gds.gds-code = buf_c-plc-hist.gds-code
      942              AND curr_c-pl-gds.obj-type = p-obj-type
      943              AND curr_c-pl-gds.obj-code = p-obj-code
      944              AND curr_c-pl-gds.pl-code = buf_c-plc-hist.pl-code
      945              AND curr_c-pl-gds.chip-num = p-chip-num
      946              AND curr_c-pl-gds.corr-user-db-num = p-corr-user-db-num   no-error .
      947       if not avail curr_c-pl-gds then do:
      948         v-mess = "Неверная ссылка на c-pl-gds в таблице c-plc-hist".
      949         run err-mess in this-procedure ( input-output v-mess).
      950         return error v-mess.
      951       end.
      952   define variable v-label-param as character no-undo .
      953   v-label-param =
      954     "tolerance" + chr(4) + "Допустимое отклонение" + chr(4) + "" + chr(8)
      955    + "max-qnty" + chr(4) + "Максимальное количество" + chr(4) + "" + chr(8)
      956    + "obj-code" + chr(4) + "Код объекта" + chr(4) + "" + chr(8)
      957    + "obj-type" + chr(4) + "Тип объекта" + chr(4) + "" + chr(8)
      958    + "pl-code" + chr(4) + "Код складского места" + chr(4) + "" + chr(8)
      959    + "PS" + chr(4) + "Примечание" + chr(4) + "" + chr(8)
      960    + "status_" + chr(4) + "Статус" + chr(4) + ""  .
      961    run proc-full-temp-changes in this-procedure (
      962                                                input buf_c-plc-hist.action = integer('1':U)
      963                                               ,input buf_c-plc-hist.action = integer('99':U)
      964                                               ,input  buffer curr_c-pl-gds:handle
      965                                               ,input  'pl-gds':U
      966                                               ,input  "tolerance,max-qnty,PS,status_"
      967                                               ,input  v-label-param).
      968   end.
      969   end procedure.
      970   procedure pl-gds-pump-proc :
      971   define output parameter p-description as character no-undo .
      972   define buffer curr_c-pl-gds-pump for ub.c-pl-gds-pump  .
      973     do
      974     on error undo, return error
      975     :
      976       find first curr_c-pl-gds-pump no-lock where
      977                  curr_c-pl-gds-pump.gds-code = buf_c-plc-hist.gds-code
      978              AND curr_c-pl-gds-pump.obj-type = p-obj-type
      979              AND curr_c-pl-gds-pump.obj-code = p-obj-code
      980              AND curr_c-pl-gds-pump.pl-code = buf_c-plc-hist.pl-code
      981              AND curr_c-pl-gds-pump.pump-code = buf_c-plc-hist.pump-code
      982              AND curr_c-pl-gds-pump.chip-num = p-chip-num
      983              AND curr_c-pl-gds-pump.corr-user-db-num = p-corr-user-db-num   no-error .
      984       if not avail curr_c-pl-gds-pump then do:
