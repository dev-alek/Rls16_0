     1228   procedure pl-level-proc :
     1229   define output parameter p-description as character no-undo .
     1230   define buffer curr_c-pl-level for ub.c-pl-level  .
     1231     do
     1232     on error undo, return error
     1233     :
     1234       find first curr_c-pl-level no-lock where
     1235                  curr_c-pl-level.obj-type = p-obj-type
     1236              AND curr_c-pl-level.obj-code = p-obj-code
     1237              AND curr_c-pl-level.pl-code = buf_c-plc-hist.pl-code
     1238              AND curr_c-pl-level.chip-num = p-chip-num
     1239              AND curr_c-pl-level.corr-user-db-num = p-corr-user-db-num
     1240              no-error .
     1241       if not avail curr_c-pl-level then do:
     1242         v-mess = "Неверная ссылка на c-pl-level в таблице c-plc-hist".
     1243         run err-mess in this-procedure ( input-output v-mess).
     1244         return error v-mess.
     1245       end.
     1246   define variable v-label-param as character no-undo .
     1247   v-label-param =
     1248      "obj-code" + chr(4) + "Код объекта" + chr(4) + "" + chr(8)
     1249    + "obj-type" + chr(4) + "Тип объекта" + chr(4) + "" + chr(8)
     1250    + "pl-code" + chr(4) + "Код складского места" + chr(4) + "" + chr(8)
     1251    + "pl-level" + chr(4) + "Уровень в см" + chr(4) + "" + chr(8)
     1252    + "pl-qnty" + chr(4) + "Объем в л" + chr(4) + "".
     1253    run proc-full-temp-changes in this-procedure (
     1254                                                input buf_c-plc-hist.action = integer('1':U)
     1255                                               ,input buf_c-plc-hist.action = integer('99':U)
     1256                                               ,input  buffer curr_c-pl-level:handle
     1257                                               ,input  'pl-level':U
     1258                                               ,input  "pl-level,pl-qnty"
     1259                                               ,input  v-label-param).
     1260   end.
     1261   end procedure.
     1262   PROCEDURE err-mess:
     1263     DEFINE INPUT-output PARAMETER p-mess as character No-UNDO.
     1264     CASE p-silent:
     1265       when yes then do:
     1266         p-mess =
     1267         substitute("История складского места &1 на &2&3: щепка &4 БД:&5  Предмет изменений &6&7&8"
     1268                     ,p-pl-code
     1269                     , p-obj-type
     1270                     , p-obj-code
     1271                     , p-chip-num
     1272                     , p-corr-user-db-num
     1273                     , p-subject
     1274                     , chr(10)
     1275                     , p-mess
     1276                     ).
     1277       end.
     1278       otherwise do:
     1279         message
     1280         p-mess
     1281         view-as alert-box error .
     1282       end.
     1283     end.
     1284   END PROCEDURE.
