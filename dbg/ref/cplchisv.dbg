     1076   function  getPlaceAttrCode returns character (istr as char ):
     1077      define variable OStr as character no-undo.
     1078      if istr eq "disable-level-alarm"
     1079      then
     1080         OStr = "Сообщения о переполнении".
     1081      else if istr eq "disable-water-alarm"
     1082      then
     1083         OStr = "Сообщения по воде".
     1084      else if istr eq "place-need-RVD-rvs"
     1085      then
     1086         OStr = "Необходимо сделать сверку с РВД".
     1087      else if istr eq "place-SI-level"
     1088      then
     1089         OStr = "Доп. средство измерения уровня".
     1090      else if istr eq "place-SI-dens"
     1091      then
     1092         OStr = "Доп. средство измерения плотности".
     1093      else if istr eq "place-SI-temp"
     1094      then
     1095         OStr = "Доп. средство измерения температуры".
     1096      else if istr eq "place-SI"
     1097      then
     1098         OStr = "Основное средство измерения".
     1099      else
     1100         OStr = istr.
     1101      return OStr.
     1102   end.
     1103   function  getPlaceAttrValue returns character (istr as char ):
     1104      define variable OStr as character no-undo.
     1105      define variable vFlag as logical no-undo.
     1106      if    entry(1,istr,chr(4)) eq "enable"
     1107      then
     1108         assign
     1109            OStr = "Включено"
     1110            vFlag = yes
     1111         .
     1112      else if    entry(1,istr,chr(4)) eq "disable"
     1113      then
     1114         assign
     1115            OStr  = "Выключено"
     1116            vFlag = yes
     1117         .
     1118      else
     1119         OStr = istr.
     1120      if     vFlag
     1121         and num-entries (istr,chr(4)) > 2
     1122      then
     1123         OStr = OStr + " для смены № " + entry(3,istr,chr(4)) + " Дата " + entry(2,istr,chr(4)).
     1124      return OStr.
     1125   end.
     1126   function getSIname returns character (si-code as char) :
     1127     for first sr-izmerenia no-lock where sr-izmerenia.node-code = integer(si-code) :
     1128       return sr-izmerenia.sr-model .
     1129     end .
     1130   end .
     1131   procedure place-attr-proc :
     1132   define output parameter p-description as character no-undo .
     1133   define variable v-tooltip as character no-undo .
     1134   define variable v-label as character no-undo .
     1135   define buffer current_c-place-attr for ub.c-place-attr  .
     1136     do
     1137     on error undo, return error
     1138     :
     1139       find first current_c-place-attr no-lock where
     1140                  current_c-place-attr.chip-num = p-chip-num
     1141              AND current_c-place-attr.corr-user-db-num = p-corr-user-db-num
     1142              AND current_c-place-attr.obj-type = p-obj-type
     1143              AND current_c-place-attr.obj-code = p-obj-code
     1144              AND current_c-place-attr.pl-code = p-pl-code  no-error .
     1145       if not avail current_c-place-attr then do:
     1146         v-mess = "Неверная ссылка на c-place-attr в таблице c-plc-hist".
     1147         run err-mess in this-procedure ( input-output v-mess).
     1148         return error v-mess.
     1149       end.
     1150       run placattr-tooltip in this-procedure (
     1151                   input  current_c-place-attr.attr-code
     1152                   ,output v-tooltip
     1153                   ,output v-label
     1154                   ) no-error .
     1155       assign
     1156       p-description = "Атрибут" + chr(32) + v-label
     1157       .
     1158   define variable v-label-param as character no-undo .
     1159   if current_c-place-attr.attr-code = "place-SI"
     1160   or current_c-place-attr.attr-code = "place-SI-temp"
     1161   or current_c-place-attr.attr-code = "place-SI-dens"
     1162   or current_c-place-attr.attr-code = "place-SI-level"
     1163   then do :
     1164     v-label-param =
     1165       "attr-value" + chr(4) + "Значение атрибута" + chr(4) + "getSIname" + chr(8)
     1166      + "attr-code" + chr(4) + "Код атрибута" + chr(4) + "getPlaceAttrCode"   .
     1167   end .
     1168   else do :
     1169     v-label-param =
     1170       "attr-value" + chr(4) + "Значение атрибута" + chr(4) + "getPlaceAttrValue" + chr(8)
     1171      + "attr-code" + chr(4) + "Код атрибута" + chr(4) + "getPlaceAttrCode" + chr(8)
     1172      + "PS" + chr(4) + "Примечание" + chr(4) + "" + chr(8)
     1173      + "status_" + chr(4) + "Статус" + chr(4) + ""  .
     1174   end .
     1175    run proc-full-temp-changes in this-procedure (
     1176                                                input buf_c-plc-hist.action = integer('1':U)
     1177                                               ,input buf_c-plc-hist.action = integer('99':U)
     1178                                               ,input  buffer current_c-place-attr:handle
     1179                                               ,input  'place-attr':U
     1180                                               ,input  "attr-code,attr-value,PS,status_"
     1181                                               ,input  v-label-param).
     1182   end.
     1183   end procedure.
