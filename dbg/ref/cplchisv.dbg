       76   procedure placattr-name :
       77   do
       78     on error undo, return error
       79     :
       80     define input  parameter p-code           as character no-undo .
       81     define output parameter p-type           as character no-undo .
       82     define output parameter p-format         as character no-undo .
       83     define output parameter p-label          as character no-undo .
       84     define output parameter p-user-can-edit  as logical   no-undo .
       85     define output parameter p-output-display as logical   no-undo .
       86     define output parameter p-other          as character no-undo .
       87       case p-code :
       88         otherwise do:
       89           undo, return error "неизвестный атрибут складского места" + " " + p-code .
       90         end.
       91       end.
       92     end.
       93   end procedure.
       94   procedure placattr-tooltip :
       95   do
       96     on error undo, return error
       97     :
       98       define input  parameter p-code    as character no-undo .
       99       define output parameter p-tooltip as character no-undo .
      100       define output parameter p-label   as character no-undo .
      101       case p-code :
      102         otherwise do:
      103           undo, return error "Неизвестный атрибут складского места" + " " + p-code .
      104         end.
      105       end.
      106     end.
      107   end procedure.
      108   procedure placattr-value :
      109    do
      110     on error undo, return error
      111     :
      112       define input  parameter p-code     like ub.place-attr.attr-code  no-undo .
      113       define input  parameter p-obj-type like ub.place-attr.obj-type   no-undo .
      114       define input  parameter p-obj-code like ub.place-attr.obj-code   no-undo .
      115       define input  parameter p-pl-code like ub.place-attr.pl-code   no-undo .
      116       define output parameter p-value    like ub.place-attr.attr-value no-undo .
      117       define output parameter p-type     as character no-undo .
      118       define buffer buf_place-attr for ub.place-attr .
      119       def var v-format         as character no-undo .
      120       def var v-label          as character no-undo .
      121       def var v-user-can-edit  as logical   no-undo .
      122       def var v-output-display as logical   no-undo .
      123       def var v-other          as character no-undo .
      124       run placattr-name in this-procedure
      125         (input  p-code
      126         ,output p-type
      127         ,output v-format
      128         ,output v-label
      129         ,output v-user-can-edit
      130         ,output v-output-display
      131         ,output v-other
      132         ) no-error .
      133       if error-status :error then do:
      134         undo, return error return-value .
      135       end.
      136       find first buf_place-attr no-lock where
      137                  buf_place-attr.obj-type  = p-obj-type
      138              AND buf_place-attr.obj-code  = p-obj-code
      139              AND buf_place-attr.pl-code  = p-pl-code
      140              AND buf_place-attr.attr-code = p-code
      141         no-error .
      142       if avail buf_place-attr then do:
      143         assign
      144           p-value =  buf_place-attr.attr-value
      145         .
      146       end.
      147       else do:
      148         assign
      149           p-value = if p-type = 'L':U then "no":U else ""
      150         .
      151       end.
      152     end.
      153   end procedure.
      154   procedure placattr-write :
      155     do
      156     on error undo, return error
      157     :
      158       define input parameter p-obj-type like ub.place-attr.obj-type   no-undo .
      159       define input parameter p-obj-code like ub.place-attr.obj-code   no-undo .
      160       define input parameter p-pl-code  like ub.place-attr.pl-code   no-undo .
      161       define input parameter p-code     like ub.place-attr.attr-code  no-undo .
      162       define input parameter p-value    like ub.place-attr.attr-value no-undo .
      163       define buffer buf_place-attr for ub.place-attr .
      164       define buffer lock_place-attr for ub.place-attr .
      165       def var v-type           as character no-undo .
      166       def var v-format         as character no-undo .
      167       def var v-label          as character no-undo .
      168       def var v-user-can-edit  as logical   no-undo .
      169       def var v-output-display as logical   no-undo .
      170       def var v-other          as character no-undo .
      171       run placattr-name in this-procedure
      172         (input  p-code
      173         ,output v-type
      174         ,output v-format
      175         ,output v-label
      176         ,output v-user-can-edit
      177         ,output v-output-display
      178         ,output v-other
      179         ) no-error .
      180       if error-status :error then do:
      181         undo, return error return-value .
      182       end.
      183       find first buf_place-attr exclusive-lock where
      184                  buf_place-attr.obj-type  = p-obj-type
      185              AND buf_place-attr.obj-code  = p-obj-code
      186              AND buf_place-attr.pl-code  = p-pl-code
      187              AND buf_place-attr.attr-code = p-code no-error .
      188       if not available buf_place-attr then do:
      189         create buf_place-attr .
      190         assign
      191           buf_place-attr.pl-code  = p-pl-code
      192           buf_place-attr.obj-type  = p-obj-type
      193           buf_place-attr.obj-code  = p-obj-code
      194           buf_place-attr.attr-code = p-code
      195           buf_place-attr.attr-value = p-value no-error
      196         .
      197       end.
      198       ELSE
      199       ASSIGN
      200       buf_place-attr.attr-value = p-value no-error.
      201     end.
      202   end procedure.
