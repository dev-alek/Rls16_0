     3731     assign
     3732       l-filter-open-33 = false
     3733     .
     3734     if flt-rec-33 <> ?
     3735       or sort-column-phrase > ""
     3736     then do:
     3737       define variable  parameter-2-33 as character no-undo .
     3738       define variable  parameter-3-33 as character no-undo .
     3739       define variable  parameter-4-33 as character no-undo .
     3740       define variable  parameter-5-33 as character no-undo .
     3741       define variable  parameter-6-33 as character no-undo .
     3742       define variable  parameter-7-33 as character no-undo .
     3743         assign
     3744         parameter-3-33 =
     3745                                 "FOR EACH X_c-variant-delivery"
     3746         parameter-4-33 =
     3747           (
     3748             if ("             X_c-variant-delivery.obj-type         = p-deliv-obj-type            AND X_c-variant-delivery.obj-code         = p-deliv-obj-code                        " + " " + where-phrase-33) <> ""
     3749             then  substitute(' X_c-variant-delivery.obj-type         = &1            AND X_c-variant-delivery.obj-code         = &2 ', p-deliv-obj-type, p-deliv-obj-code)  + " " + where-phrase-33
     3750             else "true"
     3751           )
     3752         parameter-5-33 = (" " + "" + " " + "")
     3753         parameter-6-33 = if sort-phrase-33 = ''
     3754                              then
     3755           (
     3756           " " + "  " +
     3757             " " + sort-column-phrase +
     3758           " " + "  "
     3759           )
     3760                              else
     3761           (
     3762           " " + "  " +
     3763             " " + sort-column-phrase +
     3764           " " + sort-phrase-33
     3765           )
     3766         parameter-7-33 =
     3767           " indexed-reposition  "
     3768       .
     3769       do
     3770       on stop undo, leave
     3771       on error undo, leave
     3772       :
     3773         assign
     3774           l-disable-where-33 =
     3775             ("             X_c-variant-delivery.obj-type         = p-deliv-obj-type            AND X_c-variant-delivery.obj-code         = p-deliv-obj-code                        " + " " + where-phrase-33 = "")
     3776         .
     3777         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     3778                             ,input QUERY br-vardeliv:handle
     3779                             ,input parameter-3-33
     3780                             ,input parameter-4-33
     3781                             ,input parameter-5-33
     3782                             ,input parameter-6-33
     3783                             ,input parameter-7-33
     3784                             )
     3785         .
     3786         assign
     3787           l-filter-open-33 = true
     3788         .
     3789       end.
     3790       if l-filter-open-33 = false then do:
     3791         message
     3792           "Ошибка при фильтрации / сортировке" skip
     3793           "Будут показаны записи без учета фильтра" skip
     3794           view-as alert-box .
     3795       end.
     3796       else do:
     3797           assign
     3798             l-query-was-opened = true
     3799           .
     3800       end.
     3801     end.
     3802     if l-filter-open-33 = false then do:
     3803       OPEN QUERY br-vardeliv FOR EACH X_c-variant-delivery
     3804         where              X_c-variant-delivery.obj-type         = p-deliv-obj-type            AND X_c-variant-delivery.obj-code         = p-deliv-obj-code
     3805         indexed-reposition
     3806     .
     3807         assign
     3808           l-query-was-opened = true
     3809         .
     3810     end.
     3811   end.
     3812   else do:
     3813     assign
     3814       v-doc-rec = recid( X_c-variant-delivery )
     3815     .
     3816     do
     3817     on stop undo, leave
     3818     on error undo, leave
     3819     :
     3820       if QUERY br-vardeliv:handle:get-buffer-handle(1) = (buffer X_c-variant-delivery:handle) then do:
     3821         assign
     3822         parameter-2-33 = (if p-find-next then "true":u else "false":u )
     3823         parameter-4-33 =
     3824           "where ":u +  substitute(' X_c-variant-delivery.obj-type         = &1            AND X_c-variant-delivery.obj-code         = &2 ', p-deliv-obj-type, p-deliv-obj-code)  + " ":u + where-phrase-33 + " ":u + p-find-condition + " " + ""
     3825         parameter-5-33 = "  "
     3826       .
     3827         run fltopend_fltfindd in this-procedure  (
     3828                             input this-procedure:handle
     3829                             ,input QUERY br-vardeliv:handle
     3830                             ,input rowid(X_c-variant-delivery)
     3831                             ,input logical(parameter-2-33)
     3832                             ,input no-lock
     3833                             ,input (buffer X_c-variant-delivery:handle)
     3834                             ,input parameter-4-33
     3835                             ,input parameter-5-33
     3836                             ) no-error.
     3837         .
     3838         assign
     3839           v-doc-rec = integer(return-value)
     3840           v-fltopend-rowid[1] = ?
     3841         .
     3842       end.
     3843       else do:
     3844         assign
     3845         parameter-2-33 = (if p-find-next then "true":u else "false":u )
     3846         parameter-3-33 =  "FOR EACH X_c-variant-delivery"
     3847         parameter-4-33 =
     3848           (
     3849             if ("             X_c-variant-delivery.obj-type         = p-deliv-obj-type            AND X_c-variant-delivery.obj-code         = p-deliv-obj-code                        " + " " + where-phrase-33) <> ""
     3850             then  substitute(' X_c-variant-delivery.obj-type         = &1            AND X_c-variant-delivery.obj-code         = &2 ', p-deliv-obj-type, p-deliv-obj-code)  + " " + where-phrase-33
     3851             else "true"
     3852           )
     3853         parameter-5-33 = (" " + "" + " " + "" + " " + p-find-condition)
     3854         parameter-6-33 = if sort-phrase-33 = ''
     3855                              then
     3856           (
     3857           " " + "  " +
     3858             " " + sort-column-phrase +
     3859           " " + "  "
     3860           )
     3861                              else
     3862           (
     3863           " " + "  " +
     3864             " " + sort-column-phrase +
     3865           " " + sort-phrase-33
     3866           )
     3867         parameter-7-33 =
     3868           " indexed-reposition  "
     3869       .
     3870         run fltopend_fltfindq in this-procedure  (
     3871                             input this-procedure:handle
     3872                             ,input QUERY br-vardeliv:handle
     3873                             ,input logical(parameter-2-33)
     3874                             ,input no-lock
     3875                             ,input parameter-3-33
     3876                             ,input parameter-4-33
     3877                             ,input parameter-5-33
     3878                             ,input parameter-6-33
     3879                             ,input parameter-7-33
     3880                             ,output v-fltopend-rowid
     3881                             ) no-error.
     3882         .
     3883         v-doc-rec = ?.
     3884       end.
     3885       assign
     3886         l-query-was-opened = true
     3887       .
     3888     end.
     3889   end.
     3890     run waitfram-hide in this-procedure .
     3891     END.
     3892   END CASE.
     3893   if not p-open-query then
     3894   REPOSITION br-vardeliv to recid v-doc-rec No-ERROR.
     3895   if not p-open-query and v-fltopend-rowid[1] <> ? then
     3896   query br-vardeliv:handle:reposition-to-rowid(v-fltopend-rowid) No-ERROR.
     3897   run waitfram-hide in this-procedure.
     3898   APPLY "VALUE-CHANGED" TO br-vardeliv in frame Dialog-Frame.
     3899   APPLY "ENTRY" TO br-vardeliv.
     3900   END PROCEDURE.
     3901   PROCEDURE proc-br-vardeliv :
     3902   define variable vss-include-info34 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3903   if b-sel:sensitive in frame Dialog-Frame then dO:
     3904       if b-mark:sensitive then do:
     3905           apply "choose" to b-mark in frame Dialog-Frame.
     3906       end.
     3907       else do:
     3908           apply "choose" to b-sel in frame Dialog-Frame.
     3909       end.
     3910   end.
     3911   else do:
     3912       if b-lkp:sensitive then
     3913       apply "choose" to b-lkp in frame Dialog-Frame.
     3914   end.
     3915   END PROCEDURE.
     3916   PROCEDURE proc-view-changes :
     3917   for each temp-changes:
     3918       delete temp-changes.
     3919   END.
     3920   if not available X_c-variant-delivery then do:
     3921     Open QUery br-changes for each temp-changes.
     3922     return.
     3923   end.
     3924   define variable v-label-param as character no-undo .
     3925   v-label-param =
     3926     "des" + chr(4) + "Описание" + chr(4) + "" + chr(8)
     3927    + "deliv-type-code" + chr(4) + "Внутр.код типа доставки" + chr(4) + "" + chr(8)
     3928    + "deliv-subj-code" + chr(4) + "Внутр.код субеъкта доставки" + chr(4) + "" + chr(8)
     3929    + "obj-type" + chr(4) + "Тип объекта доставки" + chr(4) + "" + chr(8)
     3930    + "obj-code" + chr(4) + "Код объекта доставки" + chr(4) + "" + chr(8)
     3931    + "term-delivery" + chr(4) + "Срок доставки(дней)" + chr(4) + "" + chr(8)
     3932    + "sts" + chr(4) + "Статус" + chr(4) + ""  .
     3933    run proc-full-temp-changes in this-procedure (
     3934                                                input  buffer X_c-variant-delivery:handle
     3935                                               ,input  'variant-delivery':U
     3936                                               ,input  "des,deliv-type-code,deliv-subj-code,obj-type,obj-code,term-delivery,sts"
     3937                                               ,input  v-label-param).
     3938   Open QUery br-changes for each temp-changes.
     3939   END PROCEDURE.
     3940   FUNCTION get-subject RETURNS CHARACTER
     3941     ( INPUT p-deliv-subj-code AS INTEGER) :
     3942   DEFINE BUFFER loc_delivery-subject FOR ub.delivery-subject.
     3943   FIND FIRST loc_delivery-subject NO-LOCK WHERE
     3944             loc_delivery-subject.deliv-subj-code = p-deliv-subj-code NO-ERROR.
     3945   IF AVAILABLE loc_delivery-subject THEN RETURN loc_delivery-subject.deliv-subj-name.
     3946     RETURN "Неизв.субъект доставки".
     3947   END FUNCTION.
     3948   FUNCTION get-type RETURNS CHARACTER
     3949   ( INPUT p-deliv-type-code AS INTEGER) :
     3950   DEFINE BUFFER loc_delivery-type FOR ub.delivery-type.
     3951   FIND FIRST loc_delivery-type NO-LOCK WHERE
     3952             loc_delivery-type.deliv-type-code = p-deliv-type-code NO-ERROR.
     3953   IF AVAILABLE loc_delivery-type THEN RETURN loc_delivery-type.deliv-type-name.
     3954     RETURN "Неизв.тип доставки".
     3955   END FUNCTION.
