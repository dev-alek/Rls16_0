      429   procedure prn-lib-open-stream :
      430     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      431     define input parameter p-page-size    as integer no-undo .
      432     define input parameter p-is-stream    as logical no-undo .
      433     define input parameter p-append       as logical no-undo .
      434     define variable v-report-name as character no-undo .
      435     do
      436       on error undo, return error
      437       :
      438       run prn-lib-get-report-name  in this-procedure (
      439         input parParentProc
      440         ,output v-report-name
      441         ).
      442       if p-is-stream then
      443       do:
      444         if p-append then
      445         do:
      446           output stream PrnLibStream to value( v-report-name )
      447             page-size value(p-page-size) append .
      448         end.
      449         if not p-append then
      450         do:
      451           output stream PrnLibStream to value( v-report-name )
      452             page-size value(p-page-size) .
      453         end.
      454       end.
      455       if not p-is-stream then
      456       do:
      457         if p-append then
      458         do:
      459           output to value( v-report-name )
      460             page-size value(p-page-size) append .
      461         end.
      462         if not p-append then
      463         do:
      464           output to value( v-report-name )
      465             page-size value(p-page-size) .
      466         end.
      467       end.
      468     end.
      469   end procedure.
      470   procedure prn-lib-open-exp :
      471     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      472     define input parameter p-is-stream    as logical no-undo .
      473     define input parameter p-is-append    as logical no-undo .
      474     define output parameter p-ReportFileName as char init "report" no-undo.
      475     define output parameter p-process as logical no-undo .
      476     define variable glog as logical no-undo .
      477     do
      478       on error undo, return error
      479       :
      480       SYSTEM-DIALOG GET-FILE p-ReportFileName
      481         TITLE      "Укажите путь"
      482         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      483         ASK-OVERWRITE
      484         CREATE-TEST-FILE
      485         SAVE-AS
      486         USE-FILENAME
      487         DEFAULT-EXTENSION "txt"
      488         UPDATE glog
      489         .
      490       if not glog then  return.
      491       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      492       if p-is-stream then
      493       do:
      494         if p-is-append then
      495         do:
      496           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      497         end.
      498         else
      499         do:
      500           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      501         end.
      502       end.
      503       else
      504       do:
      505         if p-is-append then
      506         do:
      507           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      508         end.
      509         else
      510         do:
      511           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      512         end.
      513       end.
      514       p-process = yes.
      515     end.
      516   end procedure.
      517   procedure prn-lib-get-report-name :
      518     define input parameter parParentProc  as widget-handle no-undo.
      519     define output parameter p-report-name as character no-undo .
      520     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      521   end procedure.
      522   procedure prn-lib-reportviewer-report-name :
