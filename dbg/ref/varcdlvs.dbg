        1   DEFINE BUFFER X_c-variant-delivery FOR ub.c-variant-delivery.
        2   DEFINE BUFFER X_clients FOR ub.clients.
        3   DEFINE BUFFER X_curr_clients FOR ub.clients.
        4   DEFINE BUFFER X_delivery-subject FOR ub.delivery-subject.
        5   DEFINE BUFFER X_delivery-type FOR ub.delivery-type.
        6   DEFINE BUFFER X_variant-delivery FOR ub.variant-delivery.
        7   DEFINE INPUT     PARAMETER parParentProc  AS WIDGET-HANDLE NO-UNDO.
        8   define input parameter p-curr-obj-type like ub.clients.obj-type no-undo.
        9   define input parameter p-curr-obj-code like ub.clients.obj-code no-undo.
       10   define input parameter bttns  as char   no-undo .
