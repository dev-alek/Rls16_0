      120     run proc-alt-shift-f3 in this-procedure .
      121   end.
      122   on alt-shift-f4 anywhere do:
      123     run proc-alt-shift-f4 in this-procedure.
      124   end.
      125   on alt-f1 anywhere do:
      126     run proc-alt-f1 in this-procedure .
      127   end.
      128   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      129   define new shared variable PrintCopiesCounter as integer   no-undo initial 1 .
      130   define new shared variable RepPathName        as character no-undo .
      131   define new shared variable PrintRubl          as logical   no-undo .
      132   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      133   define variable v-waitfram-action01         as character   no-undo .
      134   define variable v-waitfram-action02         as character   no-undo .
      135   define variable v-waitfram-action03         as character   no-undo .
      136   define variable mWaitFramTextBeg            as character   no-undo.
      137   define variable mWaitFramTextEnd            as character   no-undo.
      138   define variable mWaitFramView               as logical     no-undo.
      139   define variable mWaitProcEvent              as logical     no-undo init yes.
      140   define variable mWaitFramInterval           as integer     no-undo init 1 .
      141   define variable mWaitFramStop               as logical     no-undo.
      142   define variable mWaitFramStopUser           as logical     no-undo.
      143   define variable mWaitFramStopTimeOut        as logical     no-undo.
      144   define variable mWaitFramStartProc          as datetime-tz no-undo.
      145   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      146   define button B-WaitFramStop auto-end-key
      147        label "Стоп"
      148        size 10 by 1 tooltip "Остоновить процесс".
      149   define button B-viewProcInfo
      150        label "Информация"
      151        size 15 by 1 tooltip "Информация о процесс".
      152   define frame waitfram
      153     v-waitfram-action01 format "x(72)" no-label skip
      154     v-waitfram-action02 format "x(72)" no-label skip
      155     v-waitfram-action03 format "x(72)" no-label skip
      156     B-viewProcInfo
      157     B-WaitFramStop at row 4 col 30
      158     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      159     .
      160   define new global shared variable mBatchMode as logical no-undo init ?.
      161   define variable mFramBachModHandle as handle no-undo.
      162   mFramBachModHandle = frame waitfram:handle.
      163   define variable mFameOldVis as logical no-undo.
      164   define variable mVisCUrentVin as logical no-undo.
      165   if session:batch-mode
      166   then
      167      mBatchMode = yes.
      168   if mBatchMode = ? then do:
      169     mVisCUrentVin = current-window:visible.
      170     mFameOldVis = mFramBachModHandle:visible.
      171     mFramBachModHandle:visible  = yes.
      172     mBatchMode = mFramBachModHandle:visible ne yes.
      173     mFramBachModHandle:visible = mFameOldVis.
      174     current-window:visible = mVisCUrentVin.
      175   end.
      176    if  log-manager:logfile-name ne ?
      177     then DO:
      178         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      179         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      180         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      181     end.
      182   on choose of B-WaitFramStop in frame waitfram
      183   do:
      184     mWaitFramStop = yes.
      185     mWaitFramStopUser = yes.
      186   end.
      187   function waitfram-check-timeout returns logical():
      188      define variable vtime as int64 no-undo.
      189      if mWaitFramStopTimeOut
      190      then
      191         return yes.
      192      vtime = ( now - mWaitFramStartProc ) / 1000 .
      193      if     mWaitFramTimeOut ne ?
      194         and mWaitFramTimeOut ne 0
      195         and mWaitFramTimeOut lt vtime
      196      then do:
      197         mWaitFramStopTimeOut = yes.
      198      end.
      199      return mWaitFramStopTimeOut.
      200   end.
      201   procedure waitfram-hide :
      202     if not session:batch-mode
      203     then do
      204     on error undo, return error return-value
      205     :
      206       pause 0 before-hide .
      207       if not mBatchMode then
      208         hide frame waitfram .
      209     if     not mWaitFramView
      210        and mWaitProcEvent
      211     then
      212       process events .
      213     end.
      214   end procedure.
      215   procedure waitfram-show :
      216     define input  parameter p-message as character no-undo .
      217     define variable v-left-margin as integer   no-undo .
      218     if not session:batch-mode
      219     then do
      220     on error undo, return error return-value
      221     :
      222       if length(p-message) <= 70 then do:
      223         assign
      224           v-left-margin = integer((70 - length(p-message)) / 2)
      225         .
      226         assign
      227           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      228         .
      229         assign
      230           v-waitfram-action01 = " "
      231           v-waitfram-action02 = " "
      232                                    + fill(" ", v-left-margin)
      233                                    + p-message
      234           v-waitfram-action03 = " "
      235         .
      236       end.
      237       else do:
      238         define variable vRindex1 as integer no-undo.
      239         define variable vRindex2 as integer no-undo.
      240         vRindex1 = r-index(p-message," ",70).
      241         if vRindex1 = 0
      242         then
      243            vRindex1 = 70.
      244         if length(p-message)  <= vRindex1 + 70 then do:
      245           assign
      246             v-waitfram-action01 = " "
      247             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      248             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      249           .
      250         end.
      251         else do:
      252           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      253           if vRindex2 <= vRindex1
      254           then
      255              vRindex2 = vRindex1 + 70.
      256           assign
      257             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      258             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      259             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      260           .
      261         end.
      262       end.
      263       B-viewProcInfo:visible   in frame waitfram = no.
      264       B-viewProcInfo:sensitive in frame waitfram = no.
      265       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      266       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      267       if  (   mWaitFramView
      268          or  mWaitProcEvent)
      269          and not mBatchMode
      270       then
      271          display
      272             v-waitfram-action01 skip
      273             v-waitfram-action02 skip
      274             v-waitfram-action03 skip
      275          with frame waitfram .
      276       if     mWaitFramView
      277          then do:
      278             if     mWaitFramInterval ne ?
      279                and not mBatchMode
      280             then
      281                wait-for go of frame waitfram pause mWaitFramInterval.
      282          end.
      283          else
      284             if     mWaitProcEvent
      285                and not mBatchMode
      286             then
      287                process events .
      288     end.
      289   end procedure.
      290      procedure waitfram-show-this:
      291         define input  parameter iInterval as int64 no-undo.
      292         define variable vtime as int64 no-undo.
      293         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      294         mWaitFramInterval = iInterval.
      295         run waitfram-show (substitute("&1&2 &3&4" ,
      296                                       mWaitFramTextBeg ,
      297                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      298                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      299                                       mWaitFramTextEnd
      300                                      )
      301                           ).
      302      end.
      303      procedure WaitFramRunPause:
      304         define input  parameter iInterval as dec no-undo.
      305         define variable vStart  as datetime-tz no-undo.
      306         define variable vend    as datetime-tz no-undo.
      307         define variable vint as int64 no-undo.
      308         define variable vOk as logical no-undo.
      309         vStart = now.
      310         vend   = vStart.
      311         publish "WaitFramPause" (iInterval,output vOk).
      312         vend   =  now.
      313         vint = vend - vStart.
      314         vint = iInterval - vint / 1000.
      315         if     not mWaitFramStop
      316            and (   vint > 0
      317                 or (    not vOk
      318                     and iInterval eq ?
      319                     )
      320                 )
      321         then
      322            run waitfram-show-this (iInterval).
      323         vend   =  now.
      324         vint = vend - vStart.
      325         vint = iInterval - vint / 1000.
      326         if     not mWaitFramStop
      327            and vint > 0
      328         then do:
      329            run gbl/pause.p (vint * 1000).
      330         end.
      331         if iInterval ne ?
      332         then
      333            publish "WaitFramStop".
      334         waitfram-check-timeout().
      335      end.
      336      procedure WaitFramWaitFor:
      337         define input  parameter iInterval as dec no-undo.
      338         assign
      339            mWaitFramStartProc   = now
      340            mWaitFramStopUser    = no
      341            mWaitFramStopTimeOut = no
      342         .
      343         block-wait:
      344         do while not mWaitFramStop:
      345            run WaitFramRunPause (iInterval).
      346            if  waitfram-check-timeout()
      347            then do:
      348               leave block-wait.
      349            end.
      350         end.
      351         run waitfram-hide.
      352      end.
      353   procedure waitfram-join :
      354     define input  parameter p-line-1  as character no-undo .
      355     define input  parameter p-line-2  as character no-undo .
      356     define input  parameter p-line-3  as character no-undo .
      357     define output parameter p-message as character no-undo .
      358     do
      359     on error undo, return error return-value
      360     :
      361       assign
      362         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      363                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      364                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      365       .
      366     end.
      367   end procedure.
      368   function waitfram-join-function returns character
      369     (input p-line-1 as character
      370     ,input p-line-2 as character
      371     ,input p-line-3 as character
      372     ).
      373     define variable v-message as character no-undo .
      374     run waitfram-join in this-procedure
      375       (input  p-line-1
      376       ,input  p-line-2
      377       ,input  p-line-3
      378       ,output v-message
      379       ) .
      380     return v-message .
      381   end function .
      382   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      383   define  stream PrnLibStream.
      384   procedure prn-lib-prn-file :
      385     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      386     define input parameter p-DIsabledoptions as integer no-undo .
      387     define variable v-report-name as character no-undo .
      388     define variable v-user-action as character no-undo .
      389     define variable v-printed     as logical   no-undo .
      390     define variable v-exist       as logical   no-undo .
