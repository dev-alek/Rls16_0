      797   procedure fltfield-clear :
      798     define output parameter loc-fld as character no-undo.
      799     define output parameter loc-lab as character no-undo .
      800     define output parameter loc-spr as character no-undo .
      801     define output parameter loc-dim as character no-undo .
      802     assign
      803       loc-fld = ""
      804       loc-lab = ""
      805       loc-spr = ""
      806       loc-dim = "0"
      807     .
      808   end procedure .
      809   procedure fltfield-add :
      810     define input        parameter par-fld as character no-undo.
      811     define input        parameter par-lab as character no-undo .
      812     define input        parameter par-spr as character no-undo .
      813     define input-output parameter loc-fld as character no-undo.
      814     define input-output parameter loc-lab as character no-undo .
      815     define input-output parameter loc-spr as character no-undo .
      816     define input-output parameter loc-dim as character no-undo .
      817     do
      818     on error undo, return error
      819     :
      820       assign
      821       loc-fld = if loc-dim = '0'
      822                 then par-fld
      823                 else (loc-fld + chr(44) + par-fld)
      824       loc-lab = if loc-dim = '0'
      825                 then par-lab
      826                 else (loc-lab + chr(44) + par-lab)
      827       loc-spr = if loc-dim = '0'
      828                 then par-spr
      829                 else (loc-spr + chr(44) + par-spr)
      830       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
      831                 string(integer(if num-entries(loc-dim) > 1
      832                               then entry(2, loc-dim)
      833                               else entry(1, loc-dim)
      834                               ) + 1)
      835       no-error
      836       .
      837     end.
      838   end procedure.
