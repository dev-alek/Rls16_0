      840   FUNCTION mark-string RETURNS CHARACTER
      841     ( input p-recid as recid, input mark-list as character  ) :
      842     RETURN ( IF LOOKUP( STRING( p-recid), mark-list ) > 0 THEN '*' ELSE '':U ).
      843   END FUNCTION.
