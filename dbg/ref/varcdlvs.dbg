     1055   FUNCTION get-all-fields returns character (p-file-name as character ):
     1056   define variable v-dop as character no-undo .
     1057     find first _file no-lock where _file._file-name = p-file-name no-error .
     1058     if not available _file then return "":U.
     1059     for each _field no-lock where
     1060              _field._file-recid = recid(_file) :
     1061       assign
     1062       v-dop = v-dop + _field._field-name + chr(44)
     1063       .
     1064     end.
     1065     return trim(v-dop).
     1066   END FUNCTION.
