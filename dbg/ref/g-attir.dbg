        1   block-level on error undo, throw.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define input parameter p-mode      as character no-undo .
        4   define input parameter p-gds-code  like ub.goods.gds-code no-undo .
        5   define input parameter p-update-on-exit as logical no-undo .
        6   define output parameter p-modified as logical no-undo .
        7   define output parameter p-is-error as logical no-undo .
        8   define variable vss-revision    as character no-undo init "$Revision: cb632b432cdb, 3204, rls $":U .
        9   define variable vss-author      as character no-undo init "$Author: Ostroukhov $":U .
       10   define variable vss-date        as character no-undo init "$Date: 2022/12/27 12:54:28 $":U .
       11   define variable vss-workfile    as character no-undo init "$Workfile: g-attir.p $":U .
       12   define variable vss-archive     as character no-undo init "$Archive: ref/g-attir.p $":U .
       13   define variable vss-description as character no-undo init "Запуск интерфейса редактирования глобальных атрибутов товара".
       14   procedure vss-get-info :
       15     define output parameter p-vss-revision    like vss-revision    no-undo .
       16     define output parameter p-vss-author      like vss-author      no-undo .
       17     define output parameter p-vss-date        like vss-date        no-undo .
       18     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       19     define output parameter p-vss-archive     like vss-archive     no-undo .
       20     define output parameter p-vss-description like vss-description no-undo .
       21     assign
       22       p-vss-revision    = vss-revision
       23       p-vss-author      = vss-author
       24       p-vss-date        = vss-date
       25       p-vss-workfile    = vss-workfile
       26       p-vss-archive     = vss-archive
       27       p-vss-description = vss-description
       28     .
       29   end procedure.
       30   procedure vss-get-parameters :
       31     define output parameter p-vss-parameters as character no-undo .
       32   end procedure.
       33   define new global shared variable g#vssrevis-logger as handle    no-undo .
       34   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       35   define variable v-vssrevis-logger                   as handle    no-undo .
       36   procedure vss-logevent :
       37     define input  parameter p-extra-paramters as character no-undo .
       38     define variable v-vssrevis-parameters as character no-undo .
       39     do
       40     on error undo, return error return-value
       41     :
       42       if  valid-handle(v-vssrevis-logger)
       43       and v-vssrevis-logger :get-signature("logevent") <> ""
       44       then do:
       45         run vss-get-parameters in this-procedure
       46           (output v-vssrevis-parameters
       47           ).
       48         run logevent in v-vssrevis-logger
       49           (input vss-workfile
       50           ,input vss-revision
       51           ,input v-vssrevis-parameters
       52           ,input p-extra-paramters
       53           ).
       54       end.
       55     end.
       56   end procedure.
       57   assign
       58     v-vssrevis-logger = g#vssrevis-logger
       59   .
       60   if  valid-handle(v-vssrevis-logger)
       61   and v-vssrevis-logger :get-signature("logevent") <> ""
       62   then do:
       63     assign
       64       v-vssrevis-logevent = true
       65     .
       66     run vss-logevent in this-procedure (input vss-description) .
       67   end.
       68   define new global shared variable g#language as character no-undo .
       69   if g#language <> '' and g#language <> 'rus':U then do:
       70     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       71   end.
       72   define variable v-update-attr as logical no-undo .
       73   define temp-table tt0-goods-attr no-undo like ub.goods-attr
       74   field grp as logical
       75   field fdisable as logical
       76   index attr-code-activ fdisable gds-code attr-code
       77   index attr-code                gds-code attr-code.
       78   procedure addGdsGrpAttr:
       79      define input  parameter i-gds-code as integer no-undo.
       80      define input  parameter i-grp-code as integer no-undo.
       81      define variable vi as integer no-undo.
       82      define buffer buf_gds-grp-obj-attr for gds-grp-obj-attr.
       83      define buffer tt0-goods-attr for tt0-goods-attr.
       84      define buffer buf-goods-attr for tt0-goods-attr.
       85      for each tt0-goods-attr where tt0-goods-attr.grp:
       86         delete tt0-goods-attr.
       87      end.
       88      do vi = 1 to num-entries('alcohol-prod,egais-name,is-gas,ptrl-without-rvs,office-type,mark-type,emrc-type,IS18Plus,loyalty-gift,item-matter-mark,type-method-calc,group-np,fuel-type,is-loyalty-payment,ban-bonus,null-price,fasovka,time-coock,mark,sum-grp-gl,min-zapas,mercur_FGIS,perishable,production-only,15x80,8x50,6x50,calories,protein,fat,carbohydrate,calc-cal-rec,cash-parts,ptrl-as-good,dflt-insalepr,gds-ptrl-densities,gds-CommodityCode,gds-code-AIS,length-of,width-of,height-of,qnty-in-box,weight-box,qnty-on-pallet,weight-of-pallet,image-list,MercUnits,weighed-gds':U):
       89         find first buf_gds-grp-obj-attr no-lock
       90            where buf_gds-grp-obj-attr.node-code   = i-grp-code
       91              and buf_gds-grp-obj-attr.host-code   = 0
       92              and buf_gds-grp-obj-attr.obj-type    = ""
       93              and buf_gds-grp-obj-attr.obj-code    = 0
       94              and buf_gds-grp-obj-attr.attr-code   = entry(vi,'alcohol-prod,egais-name,is-gas,ptrl-without-rvs,office-type,mark-type,emrc-type,IS18Plus,loyalty-gift,item-matter-mark,type-method-calc,group-np,fuel-type,is-loyalty-payment,ban-bonus,null-price,fasovka,time-coock,mark,sum-grp-gl,min-zapas,mercur_FGIS,perishable,production-only,15x80,8x50,6x50,calories,protein,fat,carbohydrate,calc-cal-rec,cash-parts,ptrl-as-good,dflt-insalepr,gds-ptrl-densities,gds-CommodityCode,gds-code-AIS,length-of,width-of,height-of,qnty-in-box,weight-box,qnty-on-pallet,weight-of-pallet,image-list,MercUnits,weighed-gds':U)
       95         no-error .
       96         if available buf_gds-grp-obj-attr
       97         then do:
       98            find first tt0-goods-attr where tt0-goods-attr.gds-code   = i-gds-code
       99                                        and tt0-goods-attr.attr-code  = buf_gds-grp-obj-attr.attr-code
      100                                        and tt0-goods-attr.grp
      101            no-error.
      102               create tt0-goods-attr.
      103            assign
      104               tt0-goods-attr.gds-code   = i-gds-code
      105               tt0-goods-attr.attr-code  = buf_gds-grp-obj-attr.attr-code
      106               tt0-goods-attr.attr-value = buf_gds-grp-obj-attr.attr-value
      107               tt0-goods-attr.grp        = yes
      108            .
      109            tt0-goods-attr.fdisable = can-find (buf-goods-attr where buf-goods-attr.gds-code   eq tt0-goods-attr.gds-code
      110                                                                 and buf-goods-attr.attr-code  eq tt0-goods-attr.attr-code
      111                                                                 and buf-goods-attr.grp        ne yes).
      112            .
      113            end.
      114      end.
      115   end.
      116   define buffer buf_goods-attr for ub.goods-attr.
      117   define buffer locked_goods-attr for ub.goods-attr.
      118   define buffer goods          for ub.goods.
      119   do transaction
      120   on error undo, return error return-value
      121   on stop undo, return error return-value
      122   :
      123     for each tt0-goods-attr:
      124       delete tt0-goods-attr.
      125     end.
      126     case p-mode:
      127       when 'ИЗМЕНЕНИЕ':U then do:
      128         do on error undo, return error :
      129           Find first locked_goods-attr exclusive-lock  where
      130                   locked_goods-attr.gds-code = p-gds-code
      131               and locked_goods-attr.attr-code = 'lock':U
      132               no-error no-wait.
      133           if not available locked_goods-attr
      134           and not locked locked_goods-attr then do:
      135             create locked_goods-attr.
      136             assign
      137             locked_goods-attr.gds-code =  p-gds-code
      138             locked_goods-attr.attr-code = 'lock':U
      139             .
      140           end.
      141           if locked locked_goods-attr then do:
      142             Find first locked_goods-attr exclusive-lock  where
      143                   locked_goods-attr.gds-code = p-gds-code
      144               and locked_goods-attr.attr-code = 'lock':U
      145               no-error .
      146           end.
      147         end.
      148         for each buf_goods-attr no-lock where
      149                    buf_goods-attr.gds-code = p-gds-code:
      150                if buf_goods-attr.attr-code = 'lock':U then next.
      151                create tt0-goods-attr.
      152                buffer-copy buf_goods-attr to tt0-goods-attr.
      153         end.
      154         find first goods where goods.gds-code eq p-gds-code no-lock no-error.
      155         if available goods
      156         then
      157            run addGdsGrpAttr (goods.gds-code, goods.grp-code).
      158         run ref/gds-atti.w (
      159                         input parparentproc
      160                       , input p-mode
      161                       , input p-gds-code
      162                       , input p-update-on-exit
      163                       , output p-modified
      164                       , input-output table tt0-goods-attr
      165                             ) no-error.
      166         if error-status:error then do:
      167           assign
      168           p-is-error = yes
      169           .
      170         end.
      171         for each tt0-goods-attr:
      172           delete tt0-goods-attr.
      173         end.
      174         if p-is-error then do:
      175           return error substitute("&1 &2", error-status:get-message(1) , return-value ).
      176         end.
      177       end.
      178       when 'ПРОСМОТР':U then do:
      179         for each buf_goods-attr no-lock where
      180                 buf_goods-attr.gds-code = p-gds-code:
      181             if buf_goods-attr.attr-code = 'lock':U then next.
      182             create tt0-goods-attr.
      183             buffer-copy buf_goods-attr to tt0-goods-attr.
      184         end.
      185         find first goods where goods.gds-code eq p-gds-code no-lock no-error.
      186         if available goods
      187         then
      188            run addGdsGrpAttr (goods.gds-code, goods.grp-code).
      189         run ref/gds-atti.w (
      190                         input parparentproc
      191                       , input p-mode
      192                       , input p-gds-code
      193                       , input p-update-on-exit
      194                       , output p-modified
      195                       , input-output table tt0-goods-attr
      196                             ) no-error.
      197         if error-status:error then do:
      198           assign
      199           p-is-error = yes.
      200         end.
      201         for each tt0-goods-attr:
      202           delete tt0-goods-attr.
      203         end.
      204         if p-is-error then do:
      205           return error substitute("&1 &2", error-status:get-message(1) , return-value ).
      206         end.
      207       end.
      208     end case.
      209   end.
