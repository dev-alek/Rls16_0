     2557         ,input (if p-mode = 'ДОБАВЛЕНИЕ':U then p-payer-type else tt-fin-doc.payer-type)
     2558         ,input (if p-mode = 'ДОБАВЛЕНИЕ':U then p-payer-code else tt-fin-doc.payer-code)
     2559         ,input (if p-mode = 'ДОБАВЛЕНИЕ':U then p-receiver-type else tt-fin-doc.receiver-type)
     2560         ,input (if p-mode = 'ДОБАВЛЕНИЕ':U then p-receiver-code else tt-fin-doc.receiver-code)
     2561         ,input no
     2562         ,input-output tt-fin-doc.payer-bank-name
     2563         ,input-output tt-fin-doc.receiver-bank-name
     2564         ,input-output tt-fin-doc.payer-bank-city
     2565         ,input-output tt-fin-doc.receiver-bank-city
     2566         ,input-output tt-fin-doc.payer-bik
     2567         ,input-output tt-fin-doc.receiver-bik
