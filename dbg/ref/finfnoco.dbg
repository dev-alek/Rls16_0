     3433             ,buf_contract.contract-code
     3434             ,(if not available buf_payer-fin-schet then "Не найден такой счет" else '':U)
     3435             ).
     3436         end.
     3437         if p-mode = 'ДОБАВЛЕНИЕ':U
     3438           and available buf_payer-fin-schet
     3439           and buf_payer-fin-schet.status_ <> 'тек':U then
     3440         do:
     3441           undo, return error substitute("Статус счета с кодом &1 для ПЛАТЕЛЬЩИКА &2&3 &4"
     3442             ,p-payer-code-schet
     3443             ,buf_payer-fin-schet.cli-type
     3444             ,buf_payer-fin-schet.cli-code
     3445             ,buf_payer-fin-schet.status_
