     2487   if (p-mode = 'ДОБАВЛЕНИЕ':U
     2488     and p-receiver-type <> "":U
     2489     AND p-receiver-code <> 0)
     2490     or (p-mode <> 'ДОБАВЛЕНИЕ':U
     2491     and
     2492     tt-fin-doc.receiver-type <> '':U
     2493     and
