     4164     for each bufc_ttc-fin-doc no-lock where
     4165       bufc_ttc-fin-doc.host-code = p-host-code
     4166       AND bufc_ttc-fin-doc.fin-doc-code = v-fin-doc-code:
     4167       find first tt0c-fin-doc where
     4168         tt0c-fin-doc.host-code = p-host-code
     4169         AND tt0c-fin-doc.fin-doc-code = v-fin-doc-code no-error.
     4170       if not available tt0c-fin-doc then
     4171       do:
     4172         create tt0c-fin-doc.
     4173       end.
     4174       buffer-copy bufc_ttc-fin-doc to tt0c-fin-doc.
     4175       release tt0c-fin-doc.
     4176     END.
     4177   end.
     4178   end.
     4179   procedure get-fin-code-descr :
     4180     define input parameter p-mode as character no-undo .
     4181     define input parameter p-cor-acc1 like ub.fin-doc.cor-acc1 no-undo .
     4182     define input parameter p-cor-acc like ub.fin-doc.cor-acc no-undo .
     4183     define input parameter p-an-uchet-code like ub.fin-doc.an-uchet-code no-undo .
     4184     define input parameter p-cel-nazn-code like ub.fin-doc.cel-nazn-code no-undo .
     4185     define input-output parameter p-cor-acc1-value like ub.fin-doc.cor-acc1-value no-undo .
     4186     define input-output parameter p-cor-acc-value like ub.fin-doc.cor-acc-value no-undo .
     4187     define input-output parameter p-an-uchet-value like ub.fin-doc.an-uchet-value no-undo .
     4188     define input-output parameter p-cel-nazn-value like ub.fin-doc.cel-nazn-value no-undo .
     4189     define output parameter f-cor-acc1-descr as character no-undo .
     4190     define output parameter f-cor-acc-descr as character no-undo .
     4191     define output parameter f-an-uchet-descr as character no-undo .
     4192     define output parameter f-cel-nazn-descr as character no-undo .
     4193     define variable v-cor-acc1-value like ub.fin-doc.cor-acc1-value no-undo .
     4194     define variable v-cor-acc-value  like ub.fin-doc.cor-acc-value no-undo .
     4195     define variable v-an-uchet-value like ub.fin-doc.an-uchet-value no-undo .
     4196     define variable v-cel-nazn-value like ub.fin-doc.cel-nazn-value no-undo .
     4197     if p-cor-acc1 = ? then p-cor-acc1 = 0.
     4198     if p-cor-acc = ? then p-cor-acc = 0.
     4199     if p-an-uchet-code = ? then p-an-uchet-code = 0 .
     4200     if p-cel-nazn-code = ? then p-cel-nazn-code = 0 .
     4201     assign
     4202       f-cor-acc1-descr = '':U
     4203       f-cor-acc-descr  = '':U
     4204       f-an-uchet-descr = '':U
     4205       f-cel-nazn-descr = '':U
     4206       .
     4207     if tt-fin-doc.fin-ext-doc-type = 'пко':U
     4208       or tt-fin-doc.fin-ext-doc-type = 'рко':U
     4209       or tt-fin-doc.fin-ext-doc-type = 'апп':U
     4210       or tt-fin-doc.fin-ext-doc-type = 'апр':U then
     4211     do:
     4212       if p-cor-acc1 <> 0 then
     4213       do:
     4214         find first buf_fin-code-cor-acc1 no-lock where
     4215           buf_fin-code-cor-acc1.fin-code  = p-cor-acc1
     4216           AND buf_fin-code-cor-acc1.host-code  = tt-fin-doc.host-code
     4217           no-error.
     4218         if available buf_fin-code-cor-acc1
     4219           and buf_fin-code-cor-acc1.status_ = integer('0':U) then
     4220         do:
     4221           assign
     4222             f-cor-acc1-descr = buf_fin-code-cor-acc1.descr
     4223             v-cor-acc1-value = buf_fin-code-cor-acc1.code-value
     4224             .
     4225         end.
     4226         if not available buf_fin-code-cor-acc1
     4227           or (buf_fin-code-cor-acc1.code-value <> p-cor-acc1-value and p-mode <> 'ДОБАВЛЕНИЕ':U and p-cor-acc1-value = '':U)
     4228           or buf_fin-code-cor-acc1.status_ <> integer('0':U)
     4229           then
     4230         do:
     4231           assign
     4232             f-cor-acc1-descr = "!!!Код больше не существует"
     4233             .
     4234         end.
     4235         if p-mode <> 'ПРОСМОТР':U then
     4236         do:
     4237           p-cor-acc1-value = v-cor-acc1-value.
     4238         end.
     4239       end.
     4240       else if p-mode <> 'ПРОСМОТР':U then
     4241         do:
     4242           p-cor-acc1-value = '':U.
     4243         end.
     4244     end.
     4245     if p-cor-acc <> 0 then
     4246     do:
     4247       find first buf_fin-code-cor-acc no-lock where
     4248         buf_fin-code-cor-acc.fin-code  = p-cor-acc
     4249         AND buf_fin-code-cor-acc.host-code  = tt-fin-doc.host-code
     4250         no-error.
     4251       if available buf_fin-code-cor-acc
     4252         and buf_fin-code-cor-acc.status_ = integer('0':U)
     4253         then
     4254       do:
     4255         assign
     4256           f-cor-acc-descr = buf_fin-code-cor-acc.descr
     4257           v-cor-acc-value = buf_fin-code-cor-acc.code-value
     4258           .
     4259       end.
     4260       if not available buf_fin-code-cor-acc
     4261         or (buf_fin-code-cor-acc.code-value <> p-cor-acc-value and p-mode <> 'ДОБАВЛЕНИЕ':U and p-cor-acc-value = '':U)
     4262         or buf_fin-code-cor-acc.status_ <> integer('0':U)
     4263         then
     4264       do:
     4265         assign
     4266           f-cor-acc-descr = "!!!Код больше не существует"
     4267           .
     4268       end.
     4269       if p-mode <> 'ПРОСМОТР':U then
     4270       do:
     4271         p-cor-acc-value = v-cor-acc-value.
     4272       end.
     4273     end.
     4274     else if p-mode <> 'ПРОСМОТР':U then
     4275       do:
     4276         p-cor-acc-value = '':U.
     4277       end.
     4278     if p-an-uchet-code <> 0 then
     4279     do:
     4280       find first buf_fin-code-an-uchet no-lock where
     4281         buf_fin-code-an-uchet.fin-code  = p-an-uchet-code
     4282         AND buf_fin-code-an-uchet.host-code  = tt-fin-doc.host-code
     4283         no-error.
     4284       if available buf_fin-code-an-uchet
     4285         and buf_fin-code-an-uchet.status_ = integer('0':U)
     4286         then
     4287       do:
     4288         assign
     4289           f-an-uchet-descr = buf_fin-code-an-uchet.descr
     4290           v-an-uchet-value = buf_fin-code-an-uchet.code-value
     4291           .
     4292       end.
     4293       if not available buf_fin-code-an-uchet
     4294         or (buf_fin-code-an-uchet.code-value <> p-an-uchet-value and p-mode <> 'ДОБАВЛЕНИЕ':U and p-an-uchet-value = '':U)
     4295         or buf_fin-code-an-uchet.status_ <> integer('0':U)
     4296         then
     4297       do:
     4298         assign
     4299           f-an-uchet-descr = "!!!Код больше не существует".
     4300         .
     4301       end.
     4302       if p-mode <> 'ПРОСМОТР':U then
     4303       do:
     4304         p-an-uchet-value = v-an-uchet-value.
     4305       end.
     4306     end.
     4307     else if p-mode <> 'ПРОСМОТР':U then
     4308       do:
     4309         p-an-uchet-value = '':U.
     4310       end.
     4311     if p-cel-nazn-code <> 0 then
     4312     do:
     4313       find first buf_fin-code-cel-nazn no-lock where
     4314         buf_fin-code-cel-nazn.fin-code  = p-cel-nazn-code
     4315         AND buf_fin-code-cel-nazn.host-code  = tt-fin-doc.host-code
     4316         no-error.
     4317       if available buf_fin-code-cel-nazn
     4318         and buf_fin-code-cel-nazn.status_ = integer('0':U)
     4319         then
     4320       do:
     4321         assign
     4322           f-cel-nazn-descr = buf_fin-code-cel-nazn.descr
     4323           v-cel-nazn-value = Buf_fin-code-cel-nazn.code-value
     4324           .
     4325       end.
     4326       if not available buf_fin-code-cel-nazn
     4327         or (buf_fin-code-cel-nazn.code-value <> p-cel-nazn-value and p-mode <> 'ДОБАВЛЕНИЕ':U and p-cel-nazn-value = '':U)
     4328         or buf_fin-code-cel-nazn.status_ <> integer('0':U)
     4329         then
     4330       do:
     4331         assign
     4332           f-cel-nazn-descr = "!!!Код больше не существует"
     4333           .
     4334       end.
     4335       if p-mode <> 'ПРОСМОТР':U then
     4336       do:
     4337         p-cel-nazn-value = v-cel-nazn-value.
     4338       end.
     4339     end.
     4340     else if p-mode <> 'ПРОСМОТР':U then
     4341       do:
     4342         p-cel-nazn-value = '':U.
     4343       end.
     4344   end procedure.
     4345   procedure get-fin-schet :
     4346     define parameter buffer buf_payer-fin-schet    for ub.fin-schet  .
     4347     define parameter buffer buf_receiver-fin-schet for ub.fin-schet .
     4348     define parameter buffer buf_payer-fin-bank     for ub.fin-bank  .
     4349     define parameter buffer buf_receiver-fin-bank  for ub.fin-bank  .
     4350     define input parameter p-payer-code-schet like ub.fin-schet.code-schet no-undo .
     4351     define input parameter p-receiver-code-schet like ub.fin-schet.code-schet no-undo .
     4352     define input parameter p-payer-type like ub.fin-doc.payer-type no-undo .
     4353     define input parameter p-payer-code like ub.fin-doc.payer-code no-undo .
     4354     define input parameter p-receiver-type like ub.fin-doc.receiver-type no-undo .
     4355     define input parameter p-receiver-code like ub.fin-doc.receiver-code no-undo .
     4356     define input parameter p-refill-if-nees as logical no-undo .
     4357     define input-output parameter p-payer-bank-name like ub.fin-doc.payer-bank-name no-undo .
     4358     define input-output parameter p-receiver-bank-name like ub.fin-doc.receiver-bank-name no-undo .
     4359     define input-output parameter p-payer-bank-city like ub.fin-doc.payer-bank-city no-undo .
     4360     define input-output parameter p-receiver-bank-city like ub.fin-doc.receiver-bank-city no-undo .
     4361     define input-output parameter p-payer-bik like ub.fin-doc.payer-bik no-undo .
     4362     define input-output parameter p-receiver-bik like ub.fin-doc.receiver-bik no-undo .
     4363     define input-output parameter p-payer-r-schet like ub.fin-doc.payer-r-schet no-undo .
     4364     define input-output parameter p-receiver-r-schet like ub.fin-doc.receiver-r-schet no-undo .
     4365     define input-output parameter p-payer-c-schet like ub.fin-doc.payer-c-schet no-undo .
     4366     define input-output parameter p-receiver-c-schet like ub.fin-doc.receiver-c-schet no-undo .
     4367     define variable v-refill-payer    as logical no-undo .
     4368     define variable v-refill-receiver as logical no-undo .
     4369     do
     4370       on error undo, return error
     4371       :
     4372       if p-fin-ext-doc-type <> 'ппп':U
     4373         and p-fin-ext-doc-type <> 'рпп':U then return.
     4374       if (not available buf_payer-fin-schet and  p-payer-code-schet <> 0 and p-payer-code-schet <> ?)
     4375         or (available buf_payer-fin-schet and p-payer-code-schet <> buf_payer-fin-schet.code-schet) then
     4376       do:
     4377         if p-payer-code-schet = 0
     4378           or p-payer-code-schet = ? then
     4379         do:
     4380           release buf_payer-fin-schet.
     4381           release buf_payer-fin-bank.
     4382           v-refill-payer = yes.
     4383         end.
     4384         else
     4385         do:
     4386           v-refill-payer = yes.
     4387           find first buf_payer-fin-schet no-lock where
     4388             buf_payer-fin-schet.host-code = p-host-code
     4389             AND  buf_payer-fin-schet.code-schet = p-payer-code-schet  no-error .
     4390           if available buf_payer-fin-schet then
     4391           do:
     4392             if not available buf_payer-fin-bank
     4393               or buf_payer-fin-bank.code-bank <> buf_payer-fin-schet.code-bank then
     4394             do:
     4395               find first buf_payer-fin-bank no-lock where
     4396                 buf_payer-fin-bank.host-code = p-host-code
     4397                 AND  buf_payer-fin-bank.code-bank = buf_payer-fin-schet.code-bank no-error .
     4398             end.
     4399           end.
     4400           if not available buf_payer-fin-schet
     4401             or not available buf_payer-fin-bank
     4402             or (
     4403             (p-mode = 'ДОБАВЛЕНИЕ':U
     4404             and
     4405             NOT (p-payer-type = buf_payer-fin-schet.cli-type
     4406             and
     4407             p-payer-code = buf_payer-fin-schet.cli-code  )
     4408             )
     4409             OR (
     4410             p-mode <> 'ДОБАВЛЕНИЕ':U
     4411             AND
     4412             not (buf_payer-fin-schet.cli-type = p-payer-type
     4413             and
     4414             buf_payer-fin-schet.cli-code = p-payer-code)
     4415             )
     4416             or
     4417             (p-fin-doc-type = 'рпп':U
     4418             and not(buf_payer-fin-schet.cli-type = 'орг':U
     4419             AND
     4420             buf_payer-fin-schet.cli-code = p-host-code)
     4421             ))
     4422             then
     4423           do:
     4424             undo, return error substitute("&1 &2 &3&4Неверный параметр p-payer-fin-schet или значение поля payer-code-schet &5&4&6"
     4425               ,vss-workfile
     4426               ,vss-revision
     4427               ,vss-description
     4428               ,chr(10)
     4429               ,buf_payer-fin-schet.code-schet
     4430               ,(if not available buf_payer-fin-bank then "Не найден банк" else '':U)
     4431               ).
     4432           end.
     4433         end.
     4434         if p-mode = 'ДОБАВЛЕНИЕ':U
     4435           and available buf_payer-fin-schet
     4436           and buf_payer-fin-schet.status_ <> 'тек':U then
     4437         do:
     4438           undo, return error substitute("Статус счета с кодом &1 для ПЛАТЕЛЬЩИКА &2&3 &4"
     4439             ,p-payer-code-schet
     4440             ,buf_payer-fin-schet.cli-type
     4441             ,buf_payer-fin-schet.cli-code
     4442             ,buf_payer-fin-schet.status_
     4443             ).
     4444         end.
     4445         if p-mode = 'ДОБАВЛЕНИЕ':U
     4446           and available buf_payer-fin-bank
     4447           and buf_payer-fin-bank.status_ <> 'тек':U then
     4448         do:
     4449           undo, return error substitute("Статус банка с кодом &1 &2"
     4450             ,buf_payer-fin-bank.code-bank
     4451             ,buf_payer-fin-bank.status_).
     4452         end.
     4453       end.
     4454       if (not available buf_receiver-fin-schet and  p-receiver-code-schet <> 0 and p-receiver-code-schet <> ?)
     4455         or (available buf_receiver-fin-schet and p-receiver-code-schet <> buf_receiver-fin-schet.code-schet) then
     4456       do:
     4457         if p-receiver-code-schet = 0
     4458           or p-receiver-code-schet = ? then
     4459         do:
     4460           release buf_receiver-fin-schet.
     4461           release buf_receiver-fin-bank.
     4462           V-REFILL-receiver = yes.
     4463         end.
     4464         else
     4465         do:
     4466           v-refill-receiver = yes.
     4467           find first buf_receiver-fin-schet no-lock where
     4468             buf_receiver-fin-schet.host-code = p-host-code
     4469             AND  buf_receiver-fin-schet.code-schet = p-receiver-code-schet  no-error .
     4470           if available buf_receiver-fin-schet then
     4471           do:
     4472             if not available buf_receiver-fin-bank
     4473               or buf_receiver-fin-bank.code-bank <> buf_receiver-fin-schet.code-bank then
     4474             do:
     4475               find first buf_receiver-fin-bank no-lock where
     4476                 buf_receiver-fin-bank.host-code = p-host-code
     4477                 AND  buf_receiver-fin-bank.code-bank = buf_receiver-fin-schet.code-bank no-error .
     4478             end.
     4479           end.
     4480           if not available buf_receiver-fin-schet
     4481             or not available buf_receiver-fin-bank
     4482             or (
     4483             (p-mode = 'ДОБАВЛЕНИЕ':U
     4484             and
     4485             NOT (p-receiver-type = buf_receiver-fin-schet.cli-type
     4486             and
     4487             p-receiver-code = buf_receiver-fin-schet.cli-code  )
     4488             )
     4489             OR (
     4490             p-mode <> 'ДОБАВЛЕНИЕ':U
     4491             AND
     4492             not (buf_receiver-fin-schet.cli-type = p-receiver-type
     4493             and
     4494             buf_receiver-fin-schet.cli-code = p-receiver-code)
     4495             )
     4496             or
     4497             (p-fin-doc-type = 'ппп':U
     4498             and not (
     4499             buf_receiver-fin-schet.cli-type = 'орг':U
     4500             AND
     4501             buf_receiver-fin-schet.cli-code = p-host-code)
     4502             ))
     4503             then
     4504           do:
     4505             undo, return error substitute("&1 &2 &3&4Неверный параметр p-receiver-fin-schet или значение поля receiver-code-schet &5&4&6"
     4506               ,vss-workfile
     4507               ,vss-revision
     4508               ,vss-description
     4509               ,chr(10)
     4510               ,buf_receiver-fin-schet.code-schet
     4511               ,(if not available buf_receiver-fin-bank then "Не найден банк" else '':U)
     4512               ).
     4513           end.
     4514         end.
     4515         if p-mode = 'ДОБАВЛЕНИЕ':U
     4516           and available buf_receiver-fin-schet
     4517           and buf_receiver-fin-schet.status_ <> 'тек':U then
     4518         do:
     4519           undo, return error substitute("Статус счета с кодом &1 для ПОЛУЧАТЕЛЯ &2&3 &4"
     4520             ,p-receiver-code-schet
     4521             ,buf_receiver-fin-schet.cli-type
     4522             ,buf_receiver-fin-schet.cli-code
     4523             ,buf_receiver-fin-schet.status_
     4524             ).
     4525         end.
     4526         if p-mode = 'ДОБАВЛЕНИЕ':U
     4527           and available buf_receiver-fin-bank
     4528           and buf_receiver-fin-bank.status_ <> 'тек':U then
     4529         do:
     4530           undo, return error substitute("Статус банка с кодом &1 &2"
     4531             ,buf_receiver-fin-bank.code-bank
     4532             ,buf_receiver-fin-bank.status_).
     4533         end.
     4534       end.
     4535       if p-refill-if-nees then
     4536       do:
     4537         if v-refill-payer then
     4538         do:
     4539           assign
     4540             p-payer-bank-name = (if available buf_payer-fin-bank
     4541                               then buf_payer-fin-bank.bank-name
     4542                               else '':U)
     4543             p-payer-bank-city = (if available buf_payer-fin-bank
     4544                                then buf_payer-fin-bank.bank-city
     4545                                else '':U)
     4546             p-payer-bik       = (if available buf_payer-fin-bank
     4547                                         then buf_payer-fin-bank.bik
     4548                                         else "":U)
     4549             p-payer-r-schet   = (if available buf_payer-fin-schet
     4550                                       then buf_payer-fin-schet.r-schet
     4551                                       else "":U)
     4552             p-payer-c-schet   = (if available buf_payer-fin-schet
     4553                                       then buf_payer-fin-schet.c-schet
     4554                                       else "":U)
     4555             .
     4556         end.
     4557         if v-refill-receiver then
     4558         do:
     4559           assign
     4560             p-receiver-bank-name = (if available buf_receiver-fin-bank
     4561                               then buf_receiver-fin-bank.bank-name
     4562                               else '':U)
     4563             p-receiver-bank-city = (if available buf_receiver-fin-bank
     4564                                then buf_receiver-fin-bank.bank-city
     4565                                else '':U)
     4566             p-receiver-bik       = (if available buf_receiver-fin-bank
     4567                                         then buf_receiver-fin-bank.bik
     4568                                         else "":U)
     4569             p-receiver-r-schet   = (if available buf_receiver-fin-schet
     4570                                       then buf_receiver-fin-schet.r-schet
     4571                                       else "":U)
     4572             p-receiver-c-schet   = (if available buf_receiver-fin-schet
     4573                                       then buf_receiver-fin-schet.c-schet
     4574                                       else "":U)
     4575             .
     4576         end.
     4577       end.
     4578     end.
     4579   end procedure.
