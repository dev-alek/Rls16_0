       39   define variable vss-revision    as character no-undo init "$Revision: 5ee64da48eb6, 3419, rls $":U .
       40   define variable vss-author      as character no-undo init "$Author: DRuban $":U .
       41   define variable vss-date        as character no-undo init "$Date: 2023/10/16 15:13:30 $":U .
       42   define variable vss-workfile    as character no-undo init "$Workfile: finfnoco.p $":U .
