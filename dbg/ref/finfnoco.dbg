     2763         p-mode      = 'ДОБАВЛЕНИЕ':U
     2764         v-copy-mode = yes
     2765         .
     2766   end.
     2767   run cur-time in this-procedure
     2768     (output v-today
     2769     ,output v-time
     2770     ) no-error .
     2771   if tt-fin-doc.status_ <> 'факт':U then
     2772   do:
     2773     if tt-fin-doc.obj-type <> ''then
     2774     do:
     2775       define variable o-head-position as character no-undo .
     2776       define variable o-director      as character no-undo .
     2777       define variable o-snr-accnt     as character no-undo .
     2778       define variable o-cashier       as character no-undo .
     2779       define variable v-head-position as character no-undo .
     2780       define variable v-director      as character no-undo .
