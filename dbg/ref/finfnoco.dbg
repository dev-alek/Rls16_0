     2974               else tt-fin-doc.enclosure = ub.CashBook.RulePril .
     2975               if ub.CashBook.CorrRko <> "" then
     2976               do:
     2977                 for first ub.fin-code-cor-acc no-lock where ub.fin-code-cor-acc.code-value = ub.CashBook.CorrRko
     2978                   and ub.fin-code-cor-acc.host-code = p-curr-host-code :
     2979                   tt-fin-doc.cor-acc = ub.fin-code-cor-acc.fin-code .
     2980                 end.
     2981               end.
     2982               else
     2983               do:
     2984                 for first ub.fin-code-cor-acc no-lock where ub.fin-code-cor-acc.code-value = "57.01"
     2985                   and ub.fin-code-cor-acc.host-code = p-curr-host-code :
     2986                   tt-fin-doc.cor-acc = ub.fin-code-cor-acc.fin-code .
     2987                   tt-fin-doc.cor-acc-value = ub.fin-code-cor-acc.code-value .
     2988                 end.
     2989               end.
     2990               if ub.CashBook.OsnAcct <> "" then
     2991               do:
     2992                 for first ub.fin-code-cor-acc no-lock where ub.fin-code-cor-acc.code-value = ub.CashBook.OsnAcct
     2993                   and ub.fin-code-cor-acc.host-code = p-curr-host-code :
     2994                   tt-fin-doc.cor-acc1 = ub.fin-code-cor-acc.fin-code .
     2995                 end.
     2996               end.
     2997             end.
     2998           end.
     2999         end.
