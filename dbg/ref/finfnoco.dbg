     3239       ,input ttc-fin-doc.an-uchet-code
     3240       ,input ttc-fin-doc.cel-nazn-code
     3241       ,input-output ttc-fin-doc.cor-acc1-value
     3242       ,input-output ttc-fin-doc.cor-acc-value
     3243       ,input-output ttc-fin-doc.an-uchet-value
     3244       ,input-output ttc-fin-doc.cel-nazn-value
     3245       ,output fc-cor-acc1-descr
     3246       ,output fc-cor-acc-descr
     3247       ,output fc-an-uchet-descr
     3248       ,output fc-cel-nazn-descr
     3249       ).
     3250   end.
     3251   create buf_nc-tt-fin-doc.
     3252   if p-mode = 'ДОБАВЛЕНИЕ':U then
     3253     buffer-copy tt-fin-doc to buf_nc-tt-fin-doc.
     3254   else
     3255     buffer-copy ttc-fin-doc to buf_nc-tt-fin-doc.
     3256   if (p-mode = 'ДОБАВЛЕНИЕ':U
     3257     and p-contract-code <> 0)
     3258     or
     3259     (p-mode <> 'ДОБАВЛЕНИЕ':U
     3260     and tt-fin-doc.status_ <> 'факт':U
     3261     and tt-fin-doc.contract-code <> 0)
     3262     then
     3263   do:
     3264     if p-mode = 'ДОБАВЛЕНИЕ':U then
     3265     do:
     3266       run ref/finfcont.p (
     3267         input parparentproc
     3268         ,input p-host-code
     3269         ,input p-mode
     3270         ,input tt-fin-doc.fin-doc-code
     3271         ,input tt-fin-doc.fin-doc-type
     3272         ,input tt-fin-doc.fin-ext-doc-type
     3273         ,input (if p-mode = 'ДОБАВЛЕНИЕ':U
     3274         then p-contract-code
     3275         else tt-fin-doc.contract-code)
     3276         ,input-output table tt-fin-doc )
     3277         no-error .
     3278     end.
     3279     else
     3280     do:
     3281       run ref/finfcont.p (
     3282         input parparentproc
     3283         ,input p-host-code
     3284         ,input p-mode
     3285         ,input tt-fin-doc.fin-doc-code
     3286         ,input tt-fin-doc.fin-doc-type
     3287         ,input tt-fin-doc.fin-ext-doc-type
     3288         ,input (if p-mode = 'ДОБАВЛЕНИЕ':U
     3289         then p-contract-code
     3290         else tt-fin-doc.contract-code)
     3291         ,input-output table tt-fin-doc
     3292         )
     3293         no-error .
     3294     end.
     3295     if error-status:error then
     3296     do:
     3297       if p-mode = 'ДОБАВЛЕНИЕ':U
     3298         and return-value = "exit":U then undo, return error "exit":U .
     3299       else
     3300       do:
     3301         undo, return error ( substitute("Ошибка при заполнении реквизитов платежа согласно контракту&1&2 &3"
     3302           , chr(10)
     3303           ,(if return-value <> "":U then return-value else "":U)
     3304           ,error-status:get-message(1))).
     3305       end.
     3306     end.
     3307     if not avail tt-fin-doc then
     3308     do:
     3309       find first tt-fin-doc.
     3310     end.
     3311   end.
     3312   if tt-fin-doc.contract-code <> 0 then
     3313   do:
     3314     find first buf_contract where
     3315       buf_contract.host-code = p-host-code
     3316       AND buf_contract.contract-code = tt-fin-doc.contract-code  no-error .
     3317     if not available buf_contract then
     3318     do:
     3319       undo, return error substitute ("&1 &2 &3&4Неверный параметр p-contract-code или значение поля contract-code &5"
     3320         ,vss-workfile
     3321         ,vss-revision
     3322         ,vss-description
     3323         ,chr(10)
     3324         ,tt-fin-doc.contract-code).
     3325     end.
     3326     assign
     3327       v-curr-code = buf_contract.curr-code
     3328       .
     3329     if (tt-fin-doc.payer-type <> '':U
     3330       and tt-fin-doc.payer-code <> 0)
     3331       then
     3332     do:
     3333       FIND FIRST buf_payer NO-LOCK WHERE
     3334         buf_payer.obj-type = tt-fin-doc.payer-type
     3335         AND buf_payer.obj-code = tt-fin-doc.payer-code NO-ERROR .
     3336       if not avail buf_payer then
     3337       do:
     3338         undo, return error substitute("&1& 2& 3&4 Неверный ПЛАТЕЛЬЩИК &5&6 в контракте &7"
     3339           ,vss-workfile
     3340           ,vss-revision
     3341           ,vss-description
     3342           ,chr(10)
     3343           ,tt-fin-doc.payer-type
     3344           ,tt-fin-doc.payer-code
     3345           ,buf_contract.contract-code
     3346           ).
     3347       end.
     3348       if buf_payer.obj-type = 'орг':U then
     3349       do:
     3350         find first buf_payer-firm no-lock where
     3351           buf_payer-firm.firm-code = buf_payer.obj-code.
     3352       end.
     3353       else
     3354       do:
     3355         find first buf_payer-person no-lock where
     3356           buf_payer-person.psn-code = buf_payer.obj-code.
     3357       end.
     3358     end.
     3359     if tt-fin-doc.receiver-type <> '':U
     3360       and tt-fin-doc.receiver-code <> 0
     3361       then
     3362     do:
     3363       FIND FIRST buf_receiver WHERE
     3364         buf_receiver.obj-type = tt-fin-doc.receiver-type
     3365         AND buf_receiver.obj-code = tt-fin-doc.receiver-code NO-LOCK .
     3366       if not avail buf_receiver then
     3367       do:
     3368         undo, return error substitute("&1& 2& 3&4 Неверный ПОЛУЧАТЕЛЬ &5&6 в контракте &7"
     3369           ,vss-workfile
     3370           ,vss-revision
     3371           ,vss-description
     3372           ,chr(10)
     3373           ,tt-fin-doc.receiver-type
     3374           ,tt-fin-doc.receiver-code
     3375           ,buf_contract.contract-code
     3376           ).
     3377       end.
     3378       if buf_receiver.obj-type = 'орг':U then
     3379       do:
     3380         find first buf_receiver-firm no-lock where
     3381           buf_receiver-firm.firm-code = buf_receiver.obj-code.
     3382       end.
     3383       else
     3384       do:
     3385         find first buf_receiver-person no-lock where
     3386           buf_receiver-person.psn-code = buf_receiver.obj-code.
     3387       end.
     3388     end.
     3389     if p-fin-doc-type = 'ппп':U
     3390       or p-fin-doc-type = 'рпп':U then
     3391     do:
     3392       if tt-fin-doc.payer-code-schet <> 0
     3393         then
     3394       do:
     3395         find first buf_payer-fin-schet no-lock where
     3396           buf_payer-fin-schet.host-code = p-host-code
     3397           AND  buf_payer-fin-schet.code-schet = tt-fin-doc.payer-code-schet no-error .
     3398         if available buf_payer-fin-schet then
     3399         do:
     3400           find first buf_payer-fin-bank no-lock where
     3401             buf_payer-fin-bank.host-code = p-host-code
     3402             AND  buf_payer-fin-bank.code-bank = buf_payer-fin-schet.code-bank no-error .
     3403           if not available buf_payer-fin-bank then
     3404           do:
     3405             undo, return error substitute("&1 &2 &3&4Неверный счет ПЛАТЕЛЬЩИКА &5 в контракте &6 &7"
     3406               ,vss-workfile
     3407               ,vss-revision
     3408               ,vss-description
     3409               ,chr(10)
     3410               ,buf_payer-fin-schet.code-schet
     3411               ,buf_contract.contract-code
     3412               ,(if not available buf_payer-fin-bank then "Не найден банк" else '':U)
     3413               ).
     3414           end.
     3415         end.
     3416         if not available buf_payer-fin-schet
     3417           or not (buf_payer-fin-schet.cli-type = tt-fin-doc.payer-type
     3418           and
     3419           buf_payer-fin-schet.cli-code = tt-fin-doc.payer-code)
     3420           or  (p-fin-doc-type = 'рпп':U
     3421           and not(buf_payer-fin-schet.cli-type = 'орг':U
     3422           AND
     3423           buf_payer-fin-schet.cli-code = p-host-code)
     3424           )
     3425           then
