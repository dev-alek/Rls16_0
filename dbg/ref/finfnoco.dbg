     4139       ,input recid(buf_fin-ob)
     4140       ,input recid(buf_clients-obj)
     4141       ,input f-cor-acc1-descr
     4142       ,input f-cor-acc-descr
     4143       ,input f-an-uchet-descr
     4144       ,input f-cel-nazn-descr
     4145       ) no-error .
     4146   if p-mode = 'ДОБАВЛЕНИЕ':U then
     4147   do:
     4148     for each buf_tt-fin-doc no-lock where
     4149       buf_tt-fin-doc.host-code = p-host-code
     4150       AND buf_tt-fin-doc.fin-doc-code = v-fin-doc-code:
     4151       find first tt0-fin-doc where
     4152         tt0-fin-doc.host-code = p-host-code
     4153         AND tt0-fin-doc.fin-doc-code = 0 no-error.
     4154       if not available tt0-fin-doc then
     4155       do:
     4156         create tt0-fin-doc.
     4157       end.
     4158       buffer-copy buf_tt-fin-doc to tt0-fin-doc.
     4159       release tt0-fin-doc.
     4160     END.
     4161   end.
     4162   if p-mode = 'ИЗМЕНЕНИЕ':U then
