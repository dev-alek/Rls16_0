     2737       assign
     2738         v-fin-doc-shift-date = varobj-shift-date
     2739         v-fin-doc-shift-num  = varobj-shift-num
     2740         v-fin-doc-shift-name = varobj-shift-name
     2741         .
     2742       define variable v-date as date no-undo  .
     2743       run cur-time in this-procedure(output v-date, output v-time).
     2744       assign
     2745         tt-fin-doc.shift-date = v-fin-doc-shift-date
     2746         tt-fin-doc.shift-num  = v-fin-doc-shift-num
     2747         tt-fin-doc.shift-name = v-fin-doc-shift-name
     2748         .
     2749         if o-uchet <> "0" then tt-fin-doc.doc-date = v-fin-doc-shift-date .
     2750         else tt-fin-doc.doc-date = v-today .
     2751     end.
     2752     else
     2753     do:
     2754       assign
     2755         tt-fin-doc.shift-date = ?
     2756         tt-fin-doc.shift-num  = 0
     2757         tt-fin-doc.shift-name = ''
     2758         .
     2759     end.
     2760     if p-mode = 'КОПИРОВАНИЕ':U
     2761       then
