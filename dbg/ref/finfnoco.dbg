     2452         "И/ИЛИ p-payer-code или значение поля payer-code&6"
     2453         ,vss-workfile
     2454         ,vss-revision
     2455         ,vss-description
     2456         ,chr(10)
     2457         ,(if p-mode = 'ДОБАВЛЕНИЕ':U then p-payer-type else tt-fin-doc.payer-type)
     2458         ,(if p-mode = 'ДОБАВЛЕНИЕ':U then p-payer-code else tt-fin-doc.payer-code)).
     2459     end.
     2460     if buf_payer.obj-type = 'орг':U then
     2461     do:
     2462       find first buf_payer-firm no-lock where
     2463         buf_payer-firm.firm-code = buf_payer.obj-code no-error.
     2464       if not avail buf_payer-firm then do:
     2465         undo, return error substitute("&1 &2 &3&4 Не найдена запись с кодом &5 в справочнике организаций"
     2466                                       ,vss-workfile
     2467                                       ,vss-revision
     2468                                       ,vss-description
     2469                                       ,chr(10)
     2470                                       ,string(buf_payer.obj-code)).
     2471       end.
     2472     end.
