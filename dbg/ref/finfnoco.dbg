     4085       ,input tt-fin-doc.payer-code
     4086       ,input tt-fin-doc.receiver-type
     4087       ,input tt-fin-doc.receiver-code
     4088       ,input (tt-fin-doc.status_ <> 'факт':U)
     4089       ,input-output tt-fin-doc.payer-bank-name
     4090       ,input-output tt-fin-doc.receiver-bank-name
     4091       ,input-output tt-fin-doc.payer-bank-city
     4092       ,input-output tt-fin-doc.receiver-bank-city
     4093       ,input-output tt-fin-doc.payer-bik
     4094       ,input-output tt-fin-doc.receiver-bik
     4095       ,input-output tt-fin-doc.payer-r-schet
     4096       ,input-output tt-fin-doc.receiver-r-schet
     4097       ,input-output tt-fin-doc.payer-c-schet
     4098       ,input-output tt-fin-doc.receiver-c-schet
     4099       ).
     4100     run get-fin-code-descr in this-procedure (
     4101       input 'ДОБАВЛЕНИЕ':U
     4102       ,input tt-fin-doc.cor-acc1
     4103       ,input tt-fin-doc.cor-acc
     4104       ,input tt-fin-doc.an-uchet-code
     4105       ,input tt-fin-doc.cel-nazn-code
     4106       ,input-output tt-fin-doc.cor-acc1-value
     4107       ,input-output tt-fin-doc.cor-acc-value
     4108       ,input-output tt-fin-doc.an-uchet-value
     4109       ,input-output tt-fin-doc.cel-nazn-value
     4110       ,output f-cor-acc1-descr
