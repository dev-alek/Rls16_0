       59     .
       60   end procedure.
       61   procedure vss-get-parameters :
       62     define output parameter p-vss-parameters as character no-undo .
       63   end procedure.
       64   define new global shared variable g#vssrevis-logger as handle    no-undo .
       65   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       66   define variable v-vssrevis-logger                   as handle    no-undo .
       67   procedure vss-logevent :
       68     define input  parameter p-extra-paramters as character no-undo .
       69     define variable v-vssrevis-parameters as character no-undo .
       70     do
       71     on error undo, return error return-value
       72     :
       73       if  valid-handle(v-vssrevis-logger)
       74       and v-vssrevis-logger :get-signature("logevent") <> ""
       75       then do:
       76         run vss-get-parameters in this-procedure
       77           (output v-vssrevis-parameters
       78           ).
       79         run logevent in v-vssrevis-logger
       80           (input vss-workfile
       81           ,input vss-revision
       82           ,input v-vssrevis-parameters
       83           ,input p-extra-paramters
       84           ).
       85       end.
       86     end.
       87   end procedure.
       88   assign
       89     v-vssrevis-logger = g#vssrevis-logger
       90   .
       91   if  valid-handle(v-vssrevis-logger)
       92   and v-vssrevis-logger :get-signature("logevent") <> ""
       93   then do:
       94     assign
       95       v-vssrevis-logevent = true
       96     .
       97     run vss-logevent in this-procedure (input vss-description) .
       98   end.
       99   define new global shared variable g#language as character no-undo .
      100   if g#language <> '' and g#language <> 'rus':U then do:
      101     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      102   end.
      103   define new global shared variable g#library  as handle no-undo .
      104   define new global shared variable g#library2 as handle no-undo .
      105   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      106   procedure cur-time :
      107      define output parameter p-today as date      no-undo .
      108      define output parameter p-time  as integer   no-undo .
      109     do
      110     on error undo, return error
      111     :
      112       define variable v-date1 as date      no-undo .
      113       define variable v-date2 as date      no-undo .
      114       define variable v-time  as integer   no-undo .
      115       assign
      116         v-date1 = today
      117         v-time  = time
      118         v-date2 = today
      119       .
      120       if v-date1 <> v-date2
      121       then do:
      122         assign
      123           v-date1 = today
      124           v-time  = v-time
      125         .
      126       end.
      127       assign
      128         p-today = v-date1
      129         p-time  = v-time
      130       .
      131     end.
      132   end.
      133   function cur-time-date returns character
      134   :
      135     return string(today, '99/99/9999':U) .
      136   end.
      137   function cur-time-mjd returns decimal
      138   :
      139     define variable v-date as date      no-undo .
      140     define variable v-time as integer   no-undo .
      141     run cur-time in this-procedure
      142       (output v-date
      143       ,output v-time
      144       ) .
      145     return integer(v-date) - 2400002 + (v-time / 86400) .
      146   end.
      147   function cur-time-get-ending-index returns integer
      148   (input p-number as integer
      149   )
      150   :
      151     if p-number < 0
      152     or p-number = ?
      153     then do:
      154       return 1 .
      155     end.
      156     define variable v-rest as integer   no-undo .
      157     assign
      158       p-number = p-number modulo 100
      159     .
      160     if p-number < 20
      161     then do:
      162       assign
      163         v-rest = p-number
      164       .
      165     end.
      166     else do:
      167       assign
      168         v-rest = p-number modulo 10
      169       .
      170     end.
      171     case v-rest :
      172       when 1
      173       then do:
      174         return 2 .
      175       end.
      176       when 2 or
      177       when 3 or
      178       when 4
      179       then do:
      180         return 3 .
      181       end.
      182       otherwise do:
      183         return 1 .
      184       end.
      185     end case .
      186   end.
      187   procedure cur-time-mjd-to-date :
      188      define input  parameter i-mjd-diff as decimal no-undo.
      189      define output parameter o-Date     as date    no-undo.
      190      define output parameter o-Time     as integer no-undo.
      191      define variable v-day-number as integer   no-undo .
      192      if    i-mjd-diff < 0
      193         or i-mjd-diff = ?
      194      then do:
      195         return "?" .
      196      end.
      197      assign
      198         v-day-number = truncate(i-mjd-diff,0).
      199         o-Date = date(v-day-number + 2400002).
      200         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      201     .
      202   end.
      203   function cur-time-mjd-to-string returns character
      204   (input p-mjd-diff as decimal
      205   )
      206   :
      207     define variable v-day-number as integer   no-undo .
      208     define variable v-seconds    as integer   no-undo .
      209     define variable v-hour       as integer   no-undo .
      210     define variable v-min        as integer   no-undo .
      211     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      212     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      213     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      214     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      215     if p-mjd-diff < 0
      216     or p-mjd-diff = ?
      217     then do:
      218       return "?" .
      219     end.
      220     assign
      221       v-day-number = integer(truncate(p-mjd-diff,0))
      222       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      223     .
      224     if v-seconds > 86400
      225     then do:
      226       assign
      227         v-seconds = 86400 - 1
      228       .
      229     end.
      230     if v-seconds < 0
      231     then do:
      232       assign
      233         v-seconds = 0
      234       .
      235     end.
      236     assign
      237       v-hour = truncate(v-seconds / 3600, 0)
      238     .
      239     assign
      240       v-seconds = v-seconds modulo 3600
      241     .
      242     assign
      243       v-min = truncate(v-seconds / 60, 0)
      244     .
      245     assign
      246       v-seconds = v-seconds modulo 60
      247     .
      248     return
      249         (if v-day-number <> 0
      250           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      251           else ""
      252         )
      253       + (if v-day-number <> 0 or v-hour <> 0
      254           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      255           else ""
      256         )
      257       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      258           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      259           else ""
      260         )
      261       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      262       .
      263   end.
      264   function cur-time-string returns character
      265   :
      266     define variable v-date as date      no-undo .
      267     define variable v-time as integer   no-undo .
      268     run cur-time in this-procedure
      269       (output v-date
      270       ,output v-time
      271       ) .
      272     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      273   end.
      274   function cur-time-string-sec returns character
      275   :
      276     define variable v-date as date      no-undo .
      277     define variable v-time as integer   no-undo .
      278     run cur-time in this-procedure
      279       (output v-date
      280       ,output v-time
      281       ) .
      282     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      283   end.
      284   function cur-time-custom  returns character
      285   (input p-prefix as character
      286   ,input p-date-format as character
      287   ,input p-delimiter as character
      288   ,input p-time-format as character
      289   ,input p-suffix as character
      290   )
      291   :
      292     define variable v-date as date      no-undo .
      293     define variable v-time as integer   no-undo .
      294     run cur-time in this-procedure
      295       (output v-date
      296       ,output v-time
      297       ) .
      298     return
      299       p-prefix
      300       + string(v-date, p-date-format)
      301       + p-delimiter
      302       + string(v-time, p-time-format)
      303       + p-suffix
      304       .
      305   end.
      306   function cur-time-print  returns character
      307   :
      308     define variable v-date as date      no-undo .
      309     define variable v-time as integer   no-undo .
      310     run cur-time in this-procedure
      311       (output v-date
      312       ,output v-time
      313       ) .
      314     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      315   end.
      316   function cur-time-datetime returns datetime
      317   :
      318     define variable v-char as character no-undo .
      319     define variable v-datetime as datetime no-undo .
      320     v-char = cur-time-string().
      321     v-datetime = datetime(v-char).
      322     return  v-datetime.
      323   end.
      324   function cur-time-string-msec returns character
      325   :
      326     define variable v-date as datetime  no-undo .
      327     v-date = now.
      328     return string(v-date) .
      329   end.
      330   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      331     define variable v-cntxt-db-num        as integer   no-undo .
      332     define variable v-cntxt-userid        as character no-undo .
      333     define variable v-cntxt-level         as character no-undo .
      334     define variable v-cntxt-host-code-obj as integer   no-undo .
      335     define variable v-cntxt-obj-type      as character no-undo .
      336     define variable v-cntxt-obj-code      as integer   no-undo .
      337     define variable v-cntxt-db-num-obj    as integer   no-undo .
      338     define variable v-cntxt-is-admin      as logical   no-undo .
      339   function diff-list returns character (
      340     input parfirst-list  as character,
      341     input parsecond-list as character,
      342     input pardelim       as character).
      343     if pardelim = ""
      344     or pardelim = ?
      345     then do:
      346       assign
      347         pardelim = ","
      348       .
      349     end.
      350     def var ind as integer no-undo .
      351     def var v-elem as character no-undo .
      352     def var v-result-list as character no-undo init "".
      353     def var v-num-parfirst-list as integer no-undo .
      354     assign
      355       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      356     .
      357     do ind = 1 to v-num-parfirst-list
      358     :
      359       assign
      360         v-elem = entry(ind, parfirst-list, pardelim)
      361       .
      362       if lookup(v-elem, parsecond-list, pardelim) = 0 then do:
      363         assign
      364           v-result-list = v-result-list
      365                         + (if v-result-list > "" then pardelim else "")
      366                         + v-elem
      367         .
      368       end.
      369     end.
      370     return v-result-list .
      371   end function.
      372   function add-list returns character (
      373    input parfirst-list  as character,
      374    input parsecond-list as character,
      375    input pardelim       as character).
      376     if pardelim = ""
      377     or pardelim = ?
      378     then do:
      379       assign
      380         pardelim = ","
      381       .
      382     end.
      383     def var ind as integer no-undo .
      384     def var v-elem as character no-undo .
      385     def var v-result-list as character no-undo init "".
      386     def var v-num-parfirst-list as integer no-undo .
      387     assign
      388       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      389     .
      390     do ind = 1 to v-num-parfirst-list
      391     :
      392       assign
      393         v-elem = entry(ind, parfirst-list, pardelim)
      394       .
      395       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
      396         assign
      397           v-result-list = v-result-list
      398                         + (if v-result-list > "" then pardelim else "")
      399                         + v-elem
      400         .
      401       end.
      402     end.
      403     def var v-num-parsecond-list as integer no-undo .
      404     assign
      405       v-num-parsecond-list = num-entries(parsecond-list, pardelim)
      406     .
      407     do ind = 1 to v-num-parsecond-list
      408     :
      409       assign
      410         v-elem = entry(ind, parsecond-list, pardelim)
      411       .
      412       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
      413         assign
      414           v-result-list = v-result-list
      415                         + (if v-result-list > "" then pardelim else "")
      416                         + v-elem
      417         .
      418       end.
      419     end.
      420     return v-result-list .
      421   end function.
      422   function cross-list returns character (
      423    input parfirst-list  as character,
      424    input parsecond-list as character,
      425    input pardelim       as character).
      426     if pardelim = ""
      427     or pardelim = ?
      428     then do:
      429       assign
      430         pardelim = ","
      431       .
      432     end.
      433     def var ind as integer no-undo .
      434     def var v-elem as character no-undo .
      435     def var v-result-list as character no-undo init "".
      436     def var v-num-parfirst-list as integer no-undo .
      437     assign
      438       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      439     .
      440     do ind = 1 to v-num-parfirst-list
      441     :
      442       assign
      443         v-elem = entry(ind, parfirst-list, pardelim)
      444       .
      445       if lookup(v-elem, v-result-list, pardelim) = 0
      446       and lookup(v-elem, parsecond-list, pardelim) > 0
      447       then do:
      448         assign
      449           v-result-list = v-result-list
      450                         + (if v-result-list > "" then pardelim else "")
      451                         + v-elem
      452         .
      453       end.
      454     end.
      455     return v-result-list .
      456   end function.
      457   function radio-label returns character (
      458    input par-rs-value  as character,
      459    input par-rs-radio-buttons as character)
      460    .
      461    DEFINE variable v-result-label as character no-undo.
      462    assign
      463    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons) MODULO 2 = 0)
      464                              then (LOOKUP(par-rs-value, par-rs-radio-buttons) - 1)
      465                              else LOOKUP(par-rs-value, par-rs-radio-buttons)
      466                             ), par-rs-radio-buttons
      467                           )
      468    v-result-label = REPLACE(v-result-label, "&":U, "":U)
      469    .
      470   return v-result-label.
      471   end function.
      472   function m-radio-label returns character (
      473    input par-rs-value  as character,
      474    input par-rs-radio-buttons as character,
      475    input par-delim as character
      476    )
      477    .
      478    DEFINE variable v-result-label as character no-undo.
      479    assign
      480    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) MODULO 2 = 0)
      481                              then (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) - 1)
      482                              else LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim)
      483                             ), par-rs-radio-buttons, par-delim
      484                           )
      485    v-result-label = REPLACE(v-result-label, "&":U, "":U)
      486    .
      487   return v-result-label.
      488   end function.
      489   FUNCTION mixlist returns character
      490   (
      491    input parfirst-list  as character
      492    ,input parsecond-list as character
      493    ,input pardelim       as character
      494    ,input pardelim-result as character ) :
      495     if pardelim = ""
      496     or pardelim = ?
      497     then do:
      498       assign
      499         pardelim = ","
      500       .
      501     end.
      502     def var ind as integer no-undo .
      503     def var v-elem1 as character no-undo .
      504     def var v-elem2 as character no-undo .
      505     def var v-result-list as character no-undo init "".
      506     do ind = 1 to num-entries(parfirst-list, pardelim)
      507     :
      508       assign
      509         v-elem1 = entry(ind, parfirst-list, pardelim)
      510         v-elem2 = entry(ind, parsecond-list, pardelim)
      511       .
      512         assign
      513           v-result-list = v-result-list
      514                         + (if v-result-list > "" then pardelim-result else "")
      515                         + v-elem1 + pardelim-result + v-elem2
      516         .
      517     end.
      518     return v-result-list .
      519   END FUNCTION.
