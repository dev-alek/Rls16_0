     3457       if tt-fin-doc.receiver-code-schet <> 0
     3458         then
     3459       do:
     3460         find first buf_receiver-fin-schet no-lock where
     3461           buf_receiver-fin-schet.host-code = p-host-code
     3462           AND  buf_receiver-fin-schet.code-schet = tt-fin-doc.receiver-code-schet no-error .
     3463         if available buf_receiver-fin-schet then
