     2658                                         then buf_contract.curr-code
     2659                                         else 0)
     2660                                   else tt-fin-doc.contract-curr)
     2661       tt-fin-doc.contract-rate    = (if p-mode = 'ДОБАВЛЕНИЕ':U
     2662                                   then 1
     2663                                   else tt-fin-doc.contract-rate)
     2664       tt-fin-doc.contract-scale   = (if p-mode = 'ДОБАВЛЕНИЕ':U
     2665                                    then 1
     2666                                    else tt-fin-doc.contract-scale)
     2667       tt-fin-doc.obj-type         = (if p-mode = 'ДОБАВЛЕНИЕ':U
     2668                                   then p-obj-type
     2669                                   else tt-fin-doc.obj-type)
     2670       tt-fin-doc.obj-code         = (if p-mode = 'ДОБАВЛЕНИЕ':U
     2671                                   then p-obj-code
     2672                                   else tt-fin-doc.obj-code)
     2673       tt-fin-doc.str-podr-name    = if v-hist-name = "" then v-dpt-dflt-name else v-hist-name
     2674       tt-fin-doc.str-podr-type    = v-dpt-dflt-type
     2675       tt-fin-doc.str-podr-code    = v-dpt-dflt-code
     2676       tt-fin-doc.sum-doc          = (if p-mode = 'ДОБАВЛЕНИЕ':U
     2677                              then (if available buf_fin-ob
