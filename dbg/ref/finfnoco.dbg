     2635     assign
     2636       tt-fin-doc.host-code        = p-host-code
     2637       tt-fin-doc.fin-doc-code     = v-fd-code
     2638       v-fin-doc-code              = tt-fin-doc.fin-doc-code
     2639       tt-fin-doc.fin-doc-type     = p-fin-doc-type
     2640       tt-fin-doc.fin-ext-doc-type = p-fin-ext-doc-type
     2641       tt-fin-doc.prn-doc-code     = v-prefix-fin-doc + "":U
     2642       tt-fin-doc.status_          = 'новый':U
     2643       tt-fin-doc.user-db-num-doc  = v-cntxt-db-num
     2644       tt-fin-doc.user-name-doc    = v-cntxt-userid
