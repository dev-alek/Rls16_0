     2416       or (v-curr-code <> ? and buf_currency.curr-code <> v-curr-code and p-mode = 'ДОБАВЛЕНИЕ':U)
     2417       then
     2418     do:
     2419       undo, return error substitute("&1 &2 &3&4Неверный параметр p-curr-code или значение поля curr-code&5&4&6"
     2420         ,vss-workfile
     2421         ,vss-revision
     2422         ,vss-description
     2423         ,chr(10)
     2424         ,(if p-mode = 'ДОБАВЛЕНИЕ':U then p-curr-code else tt-fin-doc.curr-code)
