     2679                                    else 0)
     2680                              else tt-fin-doc.sum-doc)
     2681       tt-fin-doc.doc-author       = v-author
     2682       tt-fin-doc.shift-flag       = (if l-shift-on and v-cash-book-place <> ""
     2683                                       and lookup(tt-fin-doc.fin-ext-doc-type, 'пко,рко':U) > 0
     2684                                       and (tt-fin-doc.doc-author = 'manual':U or tt-fin-doc.doc-author = 'auto':U)
     2685                                       then integer('1':U)
     2686                                       else 0)
     2687       tt-fin-doc.trn-doc-code     = (if p-mode = 'ДОБАВЛЕНИЕ':U
     2688                                  then v-cash-book-place
     2689                                  else tt-fin-doc.trn-doc-code)
     2690       .
     2691     if l-shift-on
     2692       and tt-fin-doc.shift-flag = integer('1':U)
     2693       then
     2694     do:
     2695       define variable v-fin-doc-shift-date      as date      no-undo .
     2696       define variable v-fin-doc-shift-num       as integer   no-undo .
     2697       define variable v-fin-doc-shift-name      as character no-undo .
     2698       define variable v-fin-doc-shift-date-char as character no-undo .
     2699       define variable v-fin-doc-shift-num-char  as character no-undo .
     2700       define variable varobj-shift-date         as date      no-undo .
     2701       define variable varobj-shift-num          as integer   no-undo .
     2702       define variable varobj-shift-name         as character no-undo .
     2703       define variable v-can-back-shift          as logical   no-undo .
     2704   define variable vss-include-info14 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2705   do:
     2706     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     2707       (input  v-cntxt-db-num
     2708       ,input  v-cntxt-userid
     2709       ,input  0
     2710       ,input  'actn_fin-doc_create-back-shift':U
     2711       ,input  'object':U
     2712       ,input  tt-fin-doc.host-code
     2713       ,input  tt-fin-doc.obj-type
     2714       ,input  tt-fin-doc.obj-code
     2715       ,input  0
     2716       ,input  0
     2717       ,input  0
     2718       ,input  false
     2719       ,output v-can-back-shift
     2720       )  .
     2721   end.
     2722   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2723   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curshift in g#library
     2724     (input  tt-fin-doc.obj-type
     2725     ,input  tt-fin-doc.obj-code
     2726     ,output varobj-shift-date
     2727     ,output varobj-shift-num
     2728     ,output varobj-shift-name
     2729     ) no-error .
     2730       if error-status :error then
     2731       do:
     2732         if not v-can-back-shift then
