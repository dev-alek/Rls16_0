     3933         ,input '':U
     3934         ,input (if p-mode = 'ИЗМЕНЕНИЕ':U
     3935         then substitute("Вы можете подтвердить изменения, если они не противоречат статусу платежа (выделенные поля)&1" +
     3936         "изменения реквизитов, которые не могут быть подтверждены в данном статусе, запрещены (серые поля)"
     3937         , chr(10))
     3938         else substitute("Увидеть какие изменения могут быть подтверждены в текущем статусе платежа,&1можно ТОЛЬКО в режиме редактирования"
     3939         , chr(10))
     3940         )
     3941         ,output v-ok
     3942         ) no-error .
     3943       if error-status:error then
     3944       do:
     3945       end.
     3946       if p-mode <> 'ПРОСМОТР':U
     3947         and v-ok
     3948         then
     3949       do:
     3950         for each temp-labels where temp-labels.f_update :
     3951           if temp-labels.f_update then
     3952             assign
