     3959         ,buffer buf_receiver-fin-schet
     3960         ,buffer buf_payer-fin-bank
     3961         ,buffer buf_receiver-fin-bank
     3962         ,input ttc-fin-doc.payer-code-schet
     3963         ,input ttc-fin-doc.receiver-code-schet
     3964         ,input ttc-fin-doc.payer-type
     3965         ,input ttc-fin-doc.payer-code
     3966         ,input ttc-fin-doc.receiver-type
