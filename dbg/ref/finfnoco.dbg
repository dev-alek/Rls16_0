     3476               ,buf_payer-fin-bank.code-bank
     3477               ,(if not available buf_receiver-fin-bank then "Не найден банк" else '':U)
     3478               ).
     3479           end.
     3480         end.
     3481         if not available buf_receiver-fin-schet
     3482           OR (not (buf_receiver-fin-schet.cli-type = tt-fin-doc.receiver-type
     3483           and
     3484           buf_receiver-fin-schet.cli-code = tt-fin-doc.receiver-code)
     3485           )
     3486           or
     3487           (p-fin-doc-type = 'ппп':U
     3488           and not (
     3489           buf_receiver-fin-schet.cli-type = 'орг':U
     3490           AND
     3491           buf_receiver-fin-schet.cli-code = p-host-code)
     3492           )
     3493           then
     3494         do:
     3495           undo, return error substitute("&1 &2 &3&4Неверный счет ПОЛУЧАТЕЛЯ &5 в контракте &6 &7"
     3496             ,vss-workfile
     3497             ,vss-revision
     3498             ,vss-description
     3499             ,chr(10)
     3500             ,tt-fin-doc.receiver-code-schet
     3501             ,buf_payer-fin-bank.code-bank
     3502             ,(if not available buf_receiver-fin-schet then "Не найден такой счет" else '':U)
     3503             ).
     3504         end.
     3505         if p-mode = 'ДОБАВЛЕНИЕ':U
     3506           and available buf_receiver-fin-schet
     3507           and buf_receiver-fin-schet.status_ <> 'тек':U then
     3508         do:
     3509           undo, return error substitute("Статус счета с кодом &1 для ПОЛУЧАТЕЛЯ &2&3 &4"
     3510             ,p-receiver-code-schet
     3511             ,buf_receiver-fin-schet.cli-type
     3512             ,buf_receiver-fin-schet.cli-code
     3513             ,buf_receiver-fin-schet.status_
     3514             ).
     3515         end.
     3516         if p-mode = 'ДОБАВЛЕНИЕ':U
     3517           and available buf_receiver-fin-bank
     3518           and buf_receiver-fin-bank.status_ <> 'тек':U then
