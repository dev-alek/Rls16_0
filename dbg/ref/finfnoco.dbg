     1581   procedure fd-attr-news :
     1582     do
     1583     on error undo, return error
     1584     :
     1585       define input  parameter p-code           as character no-undo .
     1586       define output parameter p-news           as logical   no-undo .
     1587       case p-code :
     1588               when 'shift-date':U then do:     assign     p-news = no.   end.
     1589               when 'shift-num':U then do:     assign     p-news = no.   end.
     1590               when 'shift-name':U then do:     assign     p-news = no.   end.
     1591               when 'barcode':U then do:     assign     p-news = no.   end.
     1592               when 'lockid':U then do:     assign     p-news = no.   end.
     1593               when 'cover_sheet':U then do:     assign     p-news = no.   end.
     1594               when 'pre-vedom':U then do:     assign     p-news = no.   end.
     1595         otherwise do:
     1596           undo, return error "неизвестный атрибут платежа " + " " + p-code .
     1597         end.
     1598       end.
     1599     end.
     1600   end procedure.
