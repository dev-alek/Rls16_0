      550   FUNCTION get-all-fields returns character (p-file-name as character ):
      551   define variable v-dop as character no-undo .
      552     find first _file no-lock where _file._file-name = p-file-name no-error .
      553     if not available _file then return "":U.
      554     for each _field no-lock where
      555              _field._file-recid = recid(_file) :
      556       assign
      557       v-dop = v-dop + _field._field-name + chr(44)
      558       .
      559     end.
      560     return trim(v-dop).
      561   END FUNCTION.
      562   procedure tempchgs-create-lable-record :
      563   define input parameter p-t_name as character no-undo .
      564   define input parameter p-f_name as character no-undo .
      565   define input parameter p-l_name as character no-undo .
      566   define input parameter p-f_update as logical no-undo .
      567   define input parameter p-f_parent as character no-undo .
      568   define input parameter p-f_visible as logical no-undo .
      569   define buffer buf_temp-labels for temp-labels.
      570     do
      571     on error undo, return error
      572     :
      573        find first buf_temp-labels where
      574                 buf_temp-labels.t_name = p-t_name
      575             and buf_temp-labels.f_name = p-f_name no-error.
      576        if not available buf_temp-labels then do:
      577         create buf_temp-labels.
      578         assign
      579         buf_temp-labels.t_name = p-t_name
      580         buf_temp-labels.f_name = p-f_name
      581         buf_temp-labels.l_name = p-l_name
      582         .
      583        end.
      584        assign
      585        buf_temp-labels.f_can_update = p-f_update
      586        buf_temp-labels.f_parent = p-f_parent
      587        buf_temp-labels.f_visible = p-f_visible
      588        buf_temp-labels.f_root = (if p-f_parent = '':U then p-f_name else p-f_parent)
      589        buf_temp-labels.num_ = 0
      590        .
      591     end.
      592   end procedure.
      593   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile: findocip.i $ $Revision: ff8019e24d02, 2996, rls $".
      594   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      595   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      596   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
      597   define new global shared variable g#attr-lib  as handle no-undo .
      598   define variable v-attr-lib-variable as handle no-undo .
      599   procedure get-single-schet :
      600     define input parameter p-host-code like ub.sysconf.host-code no-undo .
      601     define input parameter p-cli-type like ub.fin-schet.cli-type no-undo .
      602     define input parameter p-cli-code like ub.fin-schet.cli-code no-undo .
      603     define input parameter p-curr-code like ub.fin-schet.curr-code no-undo .
      604     define output parameter p-recid-schet as recid no-undo .
      605     define output parameter p-recid-bank as recid no-undo .
      606     define variable ii as integer no-undo .
      607     define buffer buf_fin-schet for ub.fin-schet.
      608     define buffer buf_fin-bank  for ub.fin-bank.
      609     do
      610       on error undo, return error
      611       :
      612       for each buf_fin-schet no-lock where
      613         buf_fin-schet.host-code = p-host-code
      614         AND buf_fin-schet.cli-type = p-cli-type
      615         AND buf_fin-schet.cli-code = p-cli-code
      616         AND buf_fin-schet.curr-code = p-curr-code:
      617         if buf_fin-schet.status_ = 'тек':U then
      618         do:
      619           find first buf_fin-bank no-lock where
      620             buf_fin-bank.host-code = p-host-code
      621             AND buf_fin-bank.code-bank = buf_fin-schet.code-bank no-error .
      622           if avail buf_fin-bank and buf_fin-bank.status_ = 'тек':U then
      623           do:
      624             assign
      625               p-recid-schet = recid(buf_fin-schet)
      626               p-recid-bank  = recid(buf_fin-bank)
      627               .
      628             assign
      629               ii = ii + 1
      630               .
      631           end.
      632         end.
      633         if ii > 1 then
      634         do:
      635           assign
      636             p-recid-schet = ?
      637             p-recid-bank  = ?
      638             .
      639         end.
      640       end.
      641     end.
      642   end procedure.
      643   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      644   procedure gen-b-code :
      645     define input  parameter type-code like ub.code-range.range-type no-undo .
      646     define output parameter p-b-code  like ub.bar-code.b-code       no-undo .
      647     do
      648     on error  undo, return error substitute( "&1 (gen-b-code). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      649     on stop   undo, return error substitute( "&1 (gen-b-code). stop", vss-workfile )
      650     on endkey undo, return error substitute( "&1 (gen-b-code). endkey", vss-workfile )
      651     :
      652       define buffer buf_thbj-attr     for ub.thbj-attr .
      653       define buffer buf_sys-ctrl   for ub.sys-ctrl .
      654       define buffer buf_code-range for ub.code-range .
      655       define variable l-code         as   integer              no-undo .
      656       define variable v-db-num       like ub.db.db-num         no-undo .
      657       define variable cfg-param-code like ub.thbj-attr.prop-code no-undo .
      658       if type-code = 'sslc':U
      659       or type-code = 'ssgb':U
      660       then do:
      661         message
      662           "Нельзя генерировать локальный или глобальный взвешиваемый код." skip
      663           "Обратитесь к администратору системы."
      664           view-as alert-box error .
      665         undo, return error (if type-code = 'sslc':U then "loc-ss-code":U else "gbl-ss-code" ) .
      666       end.
      667       run trg/getpcode.p ( input  type-code
      668                      ,output cfg-param-code
      669                     ).
      670       run get-next-seq( input  type-code,
      671                         output l-code
      672                       ).
      673       find first buf_sys-ctrl no-lock.
      674       if type-code = 'sclc':U
      675       or type-code = 'pglc':U
      676       then do:
      677         assign
      678           v-db-num = 0
      679         .
      680       end.
      681       else do:
      682         assign
      683           v-db-num = buf_sys-ctrl.db-num
      684         .
      685       end.
      686       find first buf_code-range no-lock
      687         where buf_code-range.db-num     = v-db-num
      688           and buf_code-range.range-type = type-code
      689           and buf_code-range.stts       = "a"
      690         use-index stts
      691         no-error .
      692       if available buf_code-range
      693          and l-code <= buf_code-range.last-code
      694          and l-code >= buf_code-range.first-code then do:
      695         assign
      696           p-b-code = l-code
      697         .
      698       end.
      699       else do:
      700         if available buf_code-range
      701            and l-code < buf_code-range.last-code then do:
      702           message
      703             substitute( "Последовательность для создания кодов с типом &1 имеет неверное значение.", type-code ) skip
      704             "Обратитесь к администратору системы."
      705             view-as alert-box error .
      706           undo, return error "sequence":U .
      707         end.
      708         do transaction
      709         on error undo, return error
      710         :
      711           find first buf_thbj-attr exclusive-lock
      712             where buf_thbj-attr.upper-prop-code = 'code-range':U
      713               and buf_thbj-attr.prop-code = cfg-param-code
      714               and buf_thbj-attr.obj-type   = 'БД':U
      715               and buf_thbj-attr.obj-code   = v-db-num
      716             no-error .
      717           if not available buf_thbj-attr then do:
      718             find first buf_thbj-attr exclusive-lock
      719               where buf_thbj-attr.upper-prop-code = 'code-range':U
      720                 and buf_thbj-attr.prop-code = cfg-param-code
      721                 and buf_thbj-attr.obj-type   = ''
      722                 and buf_thbj-attr.obj-code   = 0
      723               no-error .
      724             if not available buf_thbj-attr then do:
      725               if not locked buf_thbj-attr then do:
      726                 message
      727                   substitute( "Отсутствует параметр 'длина диапазона кодов' (&1) для БД &2.", cfg-param-code, buf_sys-ctrl.db-num ) skip
      728                   "Обратитесь к администратору системы."
      729                   view-as alert-box error .
      730               end.
      731               undo, return error "config":U .
      732             end.
      733           end.
      734           run get-next-seq( input type-code,
      735                             output l-code
      736                           ).
      737           find first buf_code-range
      738             where buf_code-range.db-num     = v-db-num
      739               and buf_code-range.range-type = type-code
      740               and buf_code-range.stts       = "a"
      741             use-index stts
      742             no-error .
      743           if available buf_code-range
      744           and l-code <= buf_code-range.last-code
      745           and l-code >= buf_code-range.first-code
      746           then do:
      747             assign
      748               p-b-code = l-code
      749             .
      750           end.
      751           else do:
      752             if available buf_code-range then do:
      753               assign
      754                 buf_code-range.stts = "u"
      755               .
      756             end.
      757             find first buf_code-range
      758               where buf_code-range.db-num     = v-db-num
      759                 and buf_code-range.range-type = type-code
      760                 and buf_code-range.stts       = "f"
      761               use-index stts
      762               no-error .
      763             if not available buf_code-range then do:
      764               message
      765                 substitute( "Отсутствует свободный диапазон для кодов с типом &1.", type-code ) skip
      766                 "Обратитесь к администратору системы"
      767                 view-as alert-box error .
      768               undo, return error "code-range":U .
      769             end.
      770             assign
      771               buf_code-range.stts           = "a"
      772             .
      773             if buf_code-range.first-code = 1 then do:
      774               run set-seq-cr( input type-code,
      775                               input buf_code-range.first-code
      776                             ).
      777               assign
      778                 p-b-code = 1
      779               .
      780             end.
      781             else do:
      782               run set-seq-cr( input type-code,
      783                               input ( buf_code-range.first-code - 1 )
      784                             ).
      785               run get-next-seq( input type-code,
      786                                 output p-b-code
      787                               ).
      788             end.
      789           end.
      790         end.
      791       end.
      792     end.
      793   end procedure.
      794   procedure get-next-seq :
      795     define input  parameter type-code like ub.code-range.range-type no-undo .
      796     define output parameter next-seq  as   integer                  no-undo .
      797     do
      798     on error  undo, return error substitute( "&1 (get-next-seq). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      799     on stop   undo, return error substitute( "&1 (get-next-seq). stop", vss-workfile )
      800     on endkey undo, return error substitute( "&1 (get-next-seq). endkey", vss-workfile )
      801     :
      802       case type-code:
      803         when 'bcgb':U then do:
      804           assign
      805             next-seq = next-value(s-bcgb-code, ub)
      806           .
      807         end.
      808         when 'scgb':U then do:
      809           assign
      810             next-seq = next-value(s-scgb-code, ub)
      811           .
      812         end.
      813         when 'sclc':U then do:
      814           assign
      815             next-seq = next-value(s-sclc-code, ub)
      816           .
      817         end.
      818         when 'pglc':U then do:
      819           assign
      820             next-seq = next-value(s-pglc-code, ub)
      821           .
      822         end.
      823         when 'dcgb':U then do:
      824           assign
      825             next-seq = next-value(s-dcgb-code, ub)
      826           .
      827         end.
      828         when 'ctgb':U then do:
      829           assign
      830             next-seq = next-value(s-ctgb-code, ub)
      831           .
      832         end.
      833         when 'drgb':U then do:
      834           assign
      835             next-seq = next-value(s-drgb-code, ub)
      836           .
      837         end.
      838         when 'fmgb':U then do:
      839           assign
      840             next-seq = next-value(s-fmgb-code, ub)
      841           .
      842         end.
      843         when 'pngb':U then do:
      844           assign
      845             next-seq = next-value(s-pngb-code, ub)
      846           .
      847         end.
      848         when 'cagb':U then do:
      849           assign
      850             next-seq = next-value(s-cagb-code, ub)
      851           .
      852         end.
      853         when 'fdgb':U then do:
      854           assign
      855             next-seq = next-value(s-fin-doc, ub)
      856           .
      857         end.
      858       end case.
      859     end.
      860   end procedure.
      861   procedure set-seq-cr :
      862     define input parameter type-code like ub.code-range.range-type no-undo .
      863     define input parameter set-val   like ub.code-range.first-code no-undo .
      864     do
      865     on error  undo, return error substitute( "&1 (set-seq-cr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      866     on stop   undo, return error substitute( "&1 (set-seq-cr). stop", vss-workfile )
      867     on endkey undo, return error substitute( "&1 (set-seq-cr). endkey", vss-workfile )
      868     :
      869       case type-code:
      870         when 'bcgb':U then do:
      871           assign
      872             current-value(s-bcgb-code, ub) = set-val
      873           .
      874         end.
      875         when 'scgb':U then do:
      876           assign
      877             current-value(s-scgb-code, ub) = set-val
      878           .
      879         end.
      880         when 'sclc':U then do:
      881           assign
      882             current-value(s-sclc-code, ub) = set-val
      883           .
      884         end.
      885         when 'pglc':U then do:
      886           assign
      887             current-value(s-pglc-code, ub) = set-val
      888           .
      889         end.
      890         when 'dcgb':U then do:
      891           assign
      892             current-value(s-dcgb-code, ub) = set-val
      893           .
      894         end.
      895         when 'ctgb':U then do:
      896           assign
      897             current-value(s-ctgb-code, ub) = set-val
      898           .
      899         end.
      900         when 'drgb':U then do:
      901           assign
      902             current-value(s-drgb-code, ub) = set-val
      903           .
      904         end.
      905         when 'fmgb':U then do:
      906           assign
      907             current-value(s-fmgb-code, ub) = set-val
      908           .
      909         end.
      910         when 'pngb':U then do:
      911           assign
      912             current-value(s-pngb-code, ub) = set-val
      913           .
      914         end.
      915         when 'cagb':U then do:
      916           assign
      917             current-value(s-cagb-code, ub) = set-val
      918           .
      919         end.
      920         when 'fdgb':U then do:
      921           assign
      922             current-value(s-fin-doc, ub) = set-val
      923           .
      924         end.
      925       end case.
      926     end.
      927   end procedure.
      928   procedure new-bcod-gen-code-range :
      929     do
      930     on error  undo, return error substitute( "&1 (new-bcod-gen-code-range). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      931     on stop   undo, return error substitute( "&1 (new-bcod-gen-code-range). stop", vss-workfile )
      932     on endkey undo, return error substitute( "&1 (new-bcod-gen-code-range). endkey", vss-workfile )
      933     :
      934       define input parameter p-db-num  like ub.db.db-num             no-undo .
      935       define input parameter type-code like ub.code-range.range-type no-undo .
      936       define buffer buf_code-range      for ub.code-range .
      937       define buffer last_code-range     for ub.code-range .
      938       define buffer last-1_code-range   for ub.code-range .
      939       define buffer last-2_code-range   for ub.code-range .
      940       define buffer last-3_code-range   for ub.code-range .
      941       define buffer buf_sys-ctrl        for ub.sys-ctrl .
      942       define variable conf-par       as character no-undo .
      943       define variable par-type       as character no-undo .
      944       define variable cfg-param-code like ub.thbj-attr.prop-code no-undo .
      945       define variable v-cre-cdrg as logical   no-undo .
      946       define variable v-cre-str  as character no-undo .
      947       define variable v-cr1      as integer no-undo .
      948       define variable v-cr2      as integer no-undo .
      949       define variable v-cr3      as integer no-undo .
      950       define variable v-cmax     as integer no-undo .
      951       find first buf_sys-ctrl no-lock .
      952       if buf_sys-ctrl.db-num <> 0 and type-code <> 'cagb':U then do:
      953         undo, return error substitute("&1 &2 &3&4Диапазоны кодов можно создавать только в ГБД&4База данных &5"
      954                                       ,vss-workfile
      955                                       ,vss-revision
      956                                       ,vss-description
      957                                       ,chr(10)
      958                                       , p-db-num
      959                                      ).
      960       end.
      961       run trg/getpcode.p ( input  type-code
      962                      ,output cfg-param-code
      963                     ).
      964       for each buf_code-range
      965         where buf_code-range.db-num     = -1
      966           and buf_code-range.range-type = type-code
      967           and buf_code-range.stts       = "f"
      968       by buf_code-range.first-code
      969       on error  undo, return error substitute( "&1 (new-bcod-gen-code-range). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      970       on stop   undo, return error substitute( "&1 (new-bcod-gen-code-range). stop", vss-workfile )
      971       on endkey undo, return error substitute( "&1 (new-bcod-gen-code-range). endkey", vss-workfile )
      972       :
      973         assign
      974           buf_code-range.db-num = p-db-num
      975         .
      976         return .
      977       end.
      978       assign
      979         v-cre-cdrg = TRUE
      980       .
      981       case type-code:
      982         when 'sclc':U
      983         or when 'scgb':U
      984         or when 'pglc':U
      985         then do:
      986           find last last-1_code-range no-lock
      987             where last-1_code-range.range-type = 'sclc':U
      988             no-error .
      989           if available last-1_code-range then do:
      990             v-cr1 = last-1_code-range.last-code.
      991           end.
      992           find last last-2_code-range no-lock
      993             where last-2_code-range.range-type = 'scgb':U
      994             no-error .
      995           if available last-2_code-range then do:
      996             v-cr2 = last-2_code-range.last-code.
      997             end.
      998           find last last-3_code-range no-lock
      999             where last-3_code-range.range-type = 'pglc':U
     1000             no-error .
     1001           if available last-3_code-range then do:
     1002             v-cr3 = last-3_code-range.last-code.
     1003           end.
     1004           v-cmax = maximum(v-cr1, v-cr2, v-cr3)
     1005           .
     1006           if v-cmax = v-cr1  then do:
     1007               find last last_code-range no-lock
     1008                 where recid( last_code-range ) = recid( last-1_code-range )
     1009                 .
     1010             end.
     1011           if v-cmax = v-cr2  then do:
     1012               find last last_code-range no-lock
     1013                 where recid( last_code-range ) = recid( last-2_code-range )
     1014                 .
     1015             end.
     1016           if v-cmax = v-cr3  then do:
     1017             find last last_code-range no-lock
     1018               where recid( last_code-range ) = recid( last-3_code-range )
     1019               .
     1020           end.
     1021           if last_code-range.last-code + 1 > 99999 then do:
     1022             assign
     1023               v-cre-cdrg = FALSE
     1024             .
     1025           end.
     1026         end.
     1027         when 'bcgb':U
     1028         or when 'sslc':U
     1029         or when 'ssgb':U
     1030         then do:
     1031           find last last-1_code-range no-lock
     1032             where last-1_code-range.range-type = 'sslc':U
     1033             no-error .
     1034           if available last-1_code-range then do:
     1035             v-cr1 = last-1_code-range.last-code.
     1036           end.
     1037           find last last-2_code-range no-lock
     1038             where last-2_code-range.range-type = 'bcgb':U
     1039             no-error .
     1040           if available last-2_code-range then do:
     1041             v-cr2 = last-2_code-range.last-code.
     1042             end.
     1043           find last last-3_code-range no-lock
     1044             where last-3_code-range.range-type = 'ssgb':U
     1045             no-error .
     1046           if available last-3_code-range then do:
     1047             v-cr3 = last-3_code-range.last-code.
     1048           end.
     1049           v-cmax = maximum(v-cr1, v-cr2, v-cr3)
     1050           .
     1051           if v-cmax = v-cr1  then do:
     1052               find last last_code-range no-lock
     1053                 where recid( last_code-range ) = recid( last-1_code-range )
     1054                 .
     1055             end.
     1056           if v-cmax = v-cr2  then do:
     1057               find last last_code-range no-lock
     1058                 where recid( last_code-range ) = recid( last-2_code-range )
     1059                 .
     1060             end.
     1061           if v-cmax = v-cr3  then do:
     1062             find last last_code-range no-lock
     1063               where recid( last_code-range ) = recid( last-3_code-range )
     1064               .
     1065           end.
     1066         end.
     1067         otherwise do:
     1068           find last last_code-range no-lock
     1069             where last_code-range.range-type = type-code
     1070             no-error .
     1071         end.
     1072       end case.
     1073       if not available last_code-range then do:
     1074         undo, return error substitute("&1 &2 &3&4В БД нет ни одного диапазона с типом &5&4Не была проведена инициализация диапазонов!"
     1075                                       ,vss-workfile
     1076                                       ,vss-revision
     1077                                       ,vss-description
     1078                                       , chr(10)
     1079                                       , type-code
     1080                                      ) .
     1081       end.
     1082       define variable v-mes6 as character no-undo .
     1083       define variable v-param-type6 as character no-undo .
     1084       define variable v-value-character6 as INTEGER no-undo .
     1085       define variable v-value-date6 as date no-undo .
     1086       define variable v-value-decimal6 as decimal no-undo .
     1087       define variable v-value-integer6 AS integer no-undo .
     1088       define variable v-value-logical6 AS LOGICAL no-undo .
     1089       define variable v-tth6 as handle no-undo .
     1090       run adm/shattri.p (
     1091           input "get":U
     1092           ,input  'БД':U
     1093           ,input  p-db-num
     1094           ,input  'code-range':U
     1095           ,input  cfg-param-code
     1096           ,output v-value-character6
     1097           ,output v-value-date6
     1098           ,output v-value-decimal6
     1099           ,output v-value-integer6
     1100           ,output v-value-logical6
     1101           ,output v-param-type6
     1102           ,INPUT-OUTPUT table-handle v-tth6
     1103           ) no-error .
     1104       if error-status :error then do:
     1105         delete object v-tth6.
     1106         v-mes6 = substitute("Ошибка при получении размера диапазона собственных глобальных кодов&2&1&2&3"
     1107                            , error-status:get-message(1)
     1108                            , chr(10)
     1109                            , return-value ).
     1110         undo, return error v-mes6.
     1111       end.
     1112       delete object v-tth6.
     1113       if v-cre-cdrg = TRUE then do:
     1114         create buf_code-range .
     1115         assign
     1116           buf_code-range.db-num     = p-db-num
     1117           buf_code-range.range-type = type-code
     1118           buf_code-range.stts       = "f"
     1119           buf_code-range.first-code = last_code-range.last-code + 1
     1120           buf_code-range.last-code  = last_code-range.last-code + integer(v-value-integer6)
     1121           v-cre-str = "Свободный диапазон успешно создан"
     1122         .
     1123       end.
     1124       else do:
     1125         assign
     1126           v-cre-str = "Нет возможности создать свободный диапазон." + chr(10)
     1127                       + substitute( "Превышен предел диапазонов c типом &1", type-code )
     1128         .
     1129       end.
     1130     end.
     1131     return v-cre-str .
     1132   end procedure.
     1133   procedure gen-new-code-range-if-neces :
     1134     define input parameter v-db-num           like ub.db.db-num             no-undo .
     1135     define input parameter v-range-type       like ub.code-range.range-type no-undo .
     1136     define input parameter v-cur-code         as   integer                  no-undo .
     1137     define input parameter v-g#news           as   logical                  no-undo .
     1138     define input parameter v-g#db-num         like ub.db.db-num             no-undo .
     1139     define input parameter v-g#news-source-db like ub.db.db-num             no-undo .
     1140     do
     1141     on error  undo, return error substitute( "&1 (gen-new-code-range-if-neces). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     1142     on stop   undo, return error substitute( "&1 (gen-new-code-range-if-neces). stop", vss-workfile )
     1143     on endkey undo, return error substitute( "&1 (gen-new-code-range-if-neces). endkey", vss-workfile )
     1144     :
     1145       define variable l-code-range-exist as logical   no-undo init false .
     1146       define variable v-db-for-send      as character no-undo .
     1147       define buffer buf_code-range  for ub.code-range .
     1148       define buffer buf1_code-range for ub.code-range .
     1149       define buffer buf_db          for ub.db .
     1150       find first buf_code-range
     1151         where buf_code-range.range-type = v-range-type
     1152           and buf_code-range.last-code >= v-cur-code
     1153         use-index last-codei
     1154         no-error .
     1155       if
     1156       (
     1157          available buf_code-range
     1158          and
     1159         (buf_code-range.db-num = v-db-num
     1160           and
     1161         buf_code-range.first-code <= v-cur-code
     1162         )
     1163       or
     1164         (
     1165           v-range-type = 'drgb':U
     1166           AND
     1167           v-cur-code = 0
     1168         )
     1169      )
     1170      then do:
     1171         assign
     1172           l-code-range-exist = true
     1173         .
     1174         if v-g#news
     1175         and buf_code-range.stts = "f" then do:
     1176           assign
     1177             buf_code-range.stts = "u"
     1178           .
     1179         end.
     1180       end.
     1181       if not l-code-range-exist
     1182          and v-g#news-source-db <> 0
     1183       then do:
     1184         undo, return error substitute("&1 &2 &3&4Отсутствует диапазон кодов для БД &5 Тип диапазона кодов &6 Код &7"
     1185                                       ,vss-workfile
     1186                                       ,vss-revision
     1187                                       ,vss-description
     1188                                       ,chr(10)
     1189                                       ,v-db-num
     1190                                       ,v-range-type
     1191                                       ,v-cur-code
     1192                                      ).
     1193       end.
     1194       if (not l-code-range-exist
     1195           or ( v-cur-code >= int( (buf_code-range.first-code + buf_code-range.last-code) / 2 ) )
     1196          )
     1197       and ( not can-find (first buf1_code-range no-lock
     1198                           where buf1_code-range.db-num = v-db-num
     1199                             and buf1_code-range.range-type = v-range-type
     1200                             and buf1_code-range.stts = "f"
     1201                          )
     1202           )
     1203       then do:
     1204         if v-g#db-num = 0 then do:
     1205           run new-bcod-gen-code-range in this-procedure
     1206             (input v-db-num,
     1207              input v-range-type
     1208             ) no-error .
     1209           if error-status :error then do:
     1210             undo, return error substitute("Ошибка при создании нового свободного диапазона &1 Тип диапазона кодов &2 Код &3:&4&5 &6"
     1211                                           , substitute("&1 &2 &3", vss-workfile, vss-revision, vss-description)
     1212                                           ,v-db-num
     1213                                           ,v-range-type
     1214                                           ,v-cur-code
     1215                                           ,chr(10)
     1216                                           ,error-status:get-message(1)
     1217                                           ,return-value
     1218                                          ).
     1219           end.
     1220         end.
     1221         else do:
     1222           if v-range-type = 'sclc':U
     1223           or v-range-type = 'pglc':U
     1224           then do:
     1225             assign
     1226               v-db-for-send = "":U
     1227             .
     1228             if v-g#db-num = 0 then do:
     1229               for each buf_db no-lock
     1230                 where buf_db.db-num > 0
     1231                   and buf_db.db-num <> v-g#news-source-db
     1232               on error  undo, return error substitute( "&1 (gen-new-code-range-if-neces). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     1233               :
     1234                 assign
     1235                   v-db-for-send = v-db-for-send + chr(1) + string( buf_db.db-num )
     1236                 .
     1237               end.
     1238               assign
     1239                 v-db-for-send = right-trim( v-db-for-send, chr(1) )
     1240               .
     1241             end.
     1242             else do:
     1243               if not v-g#news then do:
     1244                 assign
     1245                   v-db-for-send = "0":U
     1246                 .
     1247               end.
     1248             end.
     1249             run nws/cr-route.p ( input 'send-cmd':U
     1250                           ,input ("command":U + chr(1) + "create":U + chr(1) +
     1251                                  "code-range":U + chr(1) +
     1252                                  (if v-range-type = 'sclc':U
     1253                                   then string( current-value(s-sclc-code, ub))
     1254                                   else string( current-value(s-pglc-code, ub))
     1255                                   ) + chr(1) +
     1256                                   v-range-type)
     1257                           ,input ?
     1258                           ,input v-db-for-send
     1259                           ) no-error .
     1260             if error-status :error then do:
     1261               undo, return error return-value.
     1262             end.
     1263           end.
     1264         end.
     1265       end.
     1266     end.
     1267   end procedure.
     1268   procedure cre-loc-sc-code-range :
     1269     define input parameter v-cur-code as integer no-undo .
     1270   define input parameter p-cdrg-type as character no-undo .
     1271     do
     1272     on error  undo, return error substitute( "&1 (cre-loc-sc-code-range). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     1273     on stop   undo, return error substitute( "&1 (cre-loc-sc-code-range). stop", vss-workfile )
     1274     on endkey undo, return error substitute( "&1 (cre-loc-sc-code-range). endkey", vss-workfile )
     1275     :
     1276       define buffer buf_code-range for ub.code-range .
     1277       find first buf_code-range
     1278            where buf_code-range.range-type = p-cdrg-type
     1279              and buf_code-range.first-code >= v-cur-code
     1280            no-error .
     1281       if not available buf_code-range then do:
     1282         run new-bcod-gen-code-range in this-procedure
     1283           ( input 0,
     1284             input p-cdrg-type
     1285           ) no-error .
     1286         if error-status :error then do:
     1287           undo, return error substitute( "Ошибка при создании нового свободного диапазона локальных весовых или штучных кодов&1"
     1288                                          + "Код &2&1&3 &4"
     1289                                         , chr(10)
     1290                                         , v-cur-code
     1291                                         , error-status:get-message(1)
     1292                                         , return-value
     1293                                        ) .
     1294         end.
     1295       end.
     1296     end.
     1297   end procedure.
     1298   procedure mark-used-if-need :
     1299   define input parameter p-cur-code as integer no-undo .
     1300   define input parameter p-range-type like ub.code-range.range-type no-undo .
     1301   define input parameter p-db-num like ub.code-range.db-num no-undo .
     1302     do
     1303     on error  undo, return error substitute( "&1 (mark-used-if-need). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     1304     on stop   undo, return error substitute( "&1 (mark-used-if-need). stop", vss-workfile )
     1305     on endkey undo, return error substitute( "&1 (mark-used-if-need). endkey", vss-workfile )
     1306     :
     1307       DEFINE VARIABLE v-db-num like ub.code-range.db-num no-undo .
     1308       define buffer buf_code-range for ub.code-range .
     1309       assign
     1310       v-db-num = if p-range-type = 'sclc':U
     1311                  then 0
     1312                  else p-db-num
     1313       .
     1314   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1315   define buffer locK-batchprocess7 for ub.batchprocess.
     1316   run gbl/lock-prc.p
     1317       (input 'lscc':U
     1318       ,input 0
     1319       ,input 0
     1320       ,input 0
     1321       ,input ""
     1322       ,input ""
     1323       ,input ""
     1324       ,input (
     1325               ",,,Вкл/выкл лок. вес. кодов"
     1326              )
     1327       ,input true
     1328       ,buffer lock-batchprocess7
     1329       ) no-error .
     1330     if error-status :error then do:
     1331       message
     1332         vss-workfile vss-revision vss-description skip
     1333         "В данный момент идет процесс вкл/выкл лок. вес. кодов" skip
     1334         view-as alert-box error .
     1335       undo, return error .
     1336     end.
     1337       find first buf_code-range
     1338            where buf_code-range.range-type = p-range-type
     1339              and buf_code-range.first-code >= p-cur-code
     1340              and buf_code-range.last-code <= p-cur-code
     1341              and buf_code-range.db-num = v-db-num
     1342            no-error .
     1343       if not available buf_code-range then do:
     1344         message
     1345           vss-workfile vss-revision vss-description skip
     1346           "Ошибка при создании поиске диапазона" skip
     1347           "База данных" p-db-num skip
     1348           "Код" p-cur-code skip
     1349           "Тип" p-range-type
     1350           error-status :get-message(1) skip
     1351           return-value skip
     1352           view-as alert-box error .
     1353         undo, return error .
     1354       end.
     1355       if buf_code-range.stts = "f":U then do:
     1356         assign
     1357         buf_code-range.stts = "u":U
     1358         .
     1359       end.
     1360     end.
     1361   end procedure.
     1362   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1363   define new global shared variable g#lib-farh as handle no-undo .
     1364   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1365   procedure fd-attr-code :
     1366     do
     1367     on error undo, return error
     1368     :
     1369       define input  parameter p-code           as character no-undo .
     1370       define output parameter p-type           as character no-undo .
     1371       define output parameter p-format         as character no-undo .
     1372       define output parameter p-label          as character no-undo .
     1373       define output parameter p-user-can-edit  as logical   no-undo .
     1374       define output parameter p-output-display as logical   no-undo .
     1375       define output parameter p-other          as character no-undo .
     1376       case p-code :
     1377               when 'shift-date':U then do:     assign     p-label = "Дата смены"     p-type = 'T':U      p-format = "99/99/9999"     p-label = "Дата смены"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
     1378               when 'shift-num':U then do:     assign     p-label = "П.смены"     p-type = 'I':U      p-format = "99"     p-label = "П.смены"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
     1379               when 'shift-name':U then do:     assign     p-label = "№ смены"     p-type = 'C':U      p-format = "X(2)"     p-label = "№ смены"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
     1380               when 'barcode':U then do:     assign     p-label = "Штрих-код"     p-type = 'C':U      p-format = "X(20)"     p-label = "Штрих-код"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
     1381               when 'lockid':U then do:     assign     p-label = "ID блокировки чека"     p-type = 'C':U      p-format = "X(2)"     p-label = "ID блокировки чека"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
     1382               when 'cover_sheet':U then do:     assign     p-label = "Разбиение по номиналам"     p-type = 'C':U      p-format = "X(4000)"     p-label = "Разбиение по номиналам"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
     1383               when 'pre-vedom':U then do:     assign     p-label = "Атрибут для препроводительной ведомости"     p-type = 'C':U      p-format = "X(256)"     p-label = "Атрибут для препроводительной ведомости"     p-user-can-edit  = false     p-output-display = false     p-other = '':u      .   end.
     1384               when 'contr-kb':U then do:     assign     p-label = "Код кассовой книги получателя\отправителя при перемещении ДС между кассами"     p-type = 'I':U      p-format = ">>>9"     p-label = "Код кассовой книги получателя\отправителя при перемещении ДС между кассами"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
     1385         otherwise do:
     1386           undo, return error "неизвестный атрибут платежа" + " " + p-code .
     1387         end.
     1388       end.
     1389     end.
     1390   end procedure.
     1391   procedure fd-attr-tooltip :
     1392     do
     1393     on error undo, return error
     1394     :
     1395       define input  parameter p-code    as character no-undo .
     1396       define output parameter p-tooltip as character no-undo .
     1397       define output parameter p-label   as character no-undo .
     1398       case p-code :
     1399               when 'shift-date':U then do:     assign     p-tooltip = "Дата смены"     p-label = "Дата смены" .   end.
     1400               when 'shift-num':U then do:     assign     p-tooltip = "П.смены"     p-label = "П.смены" .   end.
     1401               when 'shift-name':U then do:     assign     p-tooltip = "№ смены"     p-label = "№ смены" .   end.
     1402               when 'barcode':U then do:     assign     p-tooltip = "Штрих-код"     p-label = "Штрих-код" .   end.
     1403               when 'lockid':U then do:     assign     p-tooltip = "ID блокировки чека"     p-label = "ID блокировки чека" .   end.
     1404               when 'cover_sheet':U then do:     assign     p-tooltip = "Разбиение по номиналам"     p-label = "Разбиение по номиналам" .   end.
     1405               when 'pre-vedom':U then do:     assign     p-tooltip = "Атрибут для препроводительной ведомости"     p-label = "Атрибут для препроводительной ведомости" .   end.
     1406               when 'contr-kb':U then do:     assign     p-tooltip = "Код кассовой книги получателя\отправителя при перемещении ДС между кассами"     p-label = "Код кассовой книги получателя\отправителя при перемещении ДС между кассами" .   end.
     1407         otherwise do:
     1408           undo, return error "неизвестный атрибут платежа" + " " + p-code .
     1409         end.
     1410       end.
     1411     end.
     1412   end procedure.
     1413   procedure fin-doc-attr-write :
     1414    do
     1415    on error undo, return error return-value
     1416    :
     1417   define input parameter p-host-code     like ub.fin-doc-attr.host-code  no-undo .
     1418   define input parameter p-fin-doc-code  like ub.fin-doc-attr.fin-doc-code   no-undo .
     1419   define input parameter p-attr-code     like ub.fin-doc-attr.attr-code  no-undo .
     1420   define input parameter p-attr-value    like ub.fin-doc-attr.attr-value no-undo .
     1421   define variable  v-format         as character no-undo .
     1422   define variable  v-label          as character no-undo .
     1423   define variable  v-user-can-edit  as logical   no-undo .
     1424   define variable  v-output-display as logical   no-undo .
     1425   define variable  v-other          as character no-undo .
     1426   define variable  v-type           as character no-undo .
     1427   define buffer buf_fin-doc-attr for ub.fin-doc-attr.
     1428   run fd-attr-code in this-procedure
     1429                                     (input  p-attr-code
     1430                                     ,output v-type
     1431                                     ,output v-format
     1432                                     ,output v-label
     1433                                     ,output v-user-can-edit
     1434                                     ,output v-output-display
     1435                                     ,output v-other
     1436                                     ) no-error .
     1437   if error-status :error then do:
     1438     undo, return error return-value .
     1439   end.
     1440   find first buf_fin-doc-attr  exclusive-lock  where
     1441             buf_fin-doc-attr.attr-code    = p-attr-code
     1442         AND buf_fin-doc-attr.host-code    = p-host-code
     1443         AND buf_fin-doc-attr.fin-doc-code     = p-fin-doc-code  no-error .
     1444     if not available  buf_fin-doc-attr then do:
     1445         create buf_fin-doc-attr.
     1446         assign
     1447         buf_fin-doc-attr.attr-code    = p-attr-code
     1448         buf_fin-doc-attr.attr-value   = p-attr-value
     1449         buf_fin-doc-attr.host-code    = p-host-code
     1450         buf_fin-doc-attr.fin-doc-code     = p-fin-doc-code
     1451         .
     1452     end.
     1453     else do:
     1454          assign
     1455          buf_fin-doc-attr.attr-value = p-attr-value.
     1456     end.
     1457    end.
     1458   end procedure.
     1459   procedure fd-attr-exist :
     1460     do
     1461     on error undo, return error
     1462     :
     1463       define input parameter p-host-code     like ub.fin-doc-attr.host-code  no-undo .
     1464       define input parameter p-fin-doc-code  like ub.fin-doc-attr.fin-doc-code   no-undo .
     1465       define input parameter p-code          like ub.fin-doc-attr.attr-code  no-undo .
     1466       define output parameter p-exist   as logical  no-undo .
     1467       define buffer buf_fin-doc-attr for ub.fin-doc-attr .
     1468       define variable  v-type           as character no-undo .
     1469       define variable  v-format         as character no-undo .
     1470       define variable  v-label          as character no-undo .
     1471       define variable  v-user-can-edit  as logical   no-undo .
     1472       define variable  v-output-display as logical   no-undo .
     1473       define variable  v-other          as character no-undo .
     1474       run fd-attr-code in this-procedure
     1475         (input  p-code
     1476         ,output v-type
     1477         ,output v-format
     1478         ,output v-label
     1479         ,output v-user-can-edit
     1480         ,output v-output-display
     1481         ,output v-other
     1482         ) no-error .
     1483       if error-status :error then do:
     1484         undo, return error return-value .
     1485       end.
     1486       find first buf_fin-doc-attr exclusive-lock
     1487         where buf_fin-doc-attr.host-code  = p-host-code
     1488           and buf_fin-doc-attr.fin-doc-code  = p-fin-doc-code
     1489           and buf_fin-doc-attr.attr-code = p-code
     1490         no-error .
     1491       if  available buf_fin-doc-attr then do:
     1492         p-exist = yes.
     1493       end.
     1494     end.
     1495   end procedure.
     1496   procedure fd-attr-delete :
     1497     do
     1498     on error undo, return error
     1499     :
     1500     define input parameter p-host-code     like ub.fin-doc-attr.host-code  no-undo .
     1501     define input parameter p-fin-doc-code  like ub.fin-doc-attr.fin-doc-code   no-undo .
     1502     define input parameter p-code          like ub.fin-doc-attr.attr-code  no-undo .
     1503     define output parameter p-deleted  as logical no-undo.
     1504       define buffer buf_fin-doc-attr for ub.fin-doc-attr .
     1505       define variable  v-type           as character no-undo .
     1506       define variable  v-format         as character no-undo .
     1507       define variable  v-label          as character no-undo .
     1508       define variable  v-user-can-edit  as logical   no-undo .
     1509       define variable  v-output-display as logical   no-undo .
     1510       define variable  v-other          as character no-undo .
     1511       run fd-attr-code in this-procedure
     1512         (input  p-code
     1513         ,output v-type
     1514         ,output v-format
     1515         ,output v-label
     1516         ,output v-user-can-edit
     1517         ,output v-output-display
     1518         ,output v-other
     1519         ) no-error .
     1520       if error-status :error then do:
     1521         undo, return error return-value .
     1522       end.
     1523       find first buf_fin-doc-attr exclusive-lock
     1524         where buf_fin-doc-attr.host-code  = p-host-code
     1525           and buf_fin-doc-attr.fin-doc-code  = p-fin-doc-code
     1526           and buf_fin-doc-attr.attr-code = p-code
     1527         no-error NO-WAIT.
     1528       if not available buf_fin-doc-attr then do:
     1529         p-deleted = no.
     1530       end.
     1531       else do:
     1532         delete buf_fin-doc-attr no-error .
     1533         if error-status:error then do:
     1534           undo, return error return-value .
     1535         end.
     1536         p-deleted = yes.
     1537       end.
     1538     end.
     1539   end procedure.
