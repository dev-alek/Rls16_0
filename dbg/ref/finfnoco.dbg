     2380         ,p-ob-doc-code
     2381         ,p-host-code).
     2382     end.
     2383     find first buf_contract where
     2384       buf_contract.host-code = p-host-code
     2385       AND buf_contract.contract-code = buf_fin-ob.contract-code  no-error .
     2386     if not available buf_contract
     2387       or buf_contract.contract-code <> v-contract-code
     2388       then
     2389     do:
     2390       undo, return error( substitute("&1 &2 &3&4Неверный параметр p-ob-doc-code или значение поля ob-doc-code &5&4&6"
     2391         ,vss-workfile
     2392         ,vss-revision
     2393         ,vss-description
     2394         ,chr(10)
     2395         ,p-ob-doc-code
     2396         ,(if not available buf_contract
     2397         then "Не найден договор для финобязательства"
     2398         else substitute("Номер договора в платеже &1, номер договора для финобязательства &2"
     2399         ,v-contract-code
     2400         ,buf_contract.contract-code))
     2401         )).
     2402     end.
     2403     assign
     2404       v-curr-code = buf_fin-ob.curr-code
     2405       .
     2406   end.
     2407   if (p-mode = 'ДОБАВЛЕНИЕ':U and p-curr-code <> ?)
     2408     or p-mode <> 'ДОБАВЛЕНИЕ':U
     2409     then
     2410   do:
     2411     find first buf_currency no-lock where
