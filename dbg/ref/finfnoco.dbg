     2475       find first buf_payer-person no-lock where
     2476         buf_payer-person.psn-code = buf_payer.obj-code no-error.
     2477       if not avail buf_payer-person then do:
     2478         undo, return error substitute("&1 &2 &3&4 Не найдена запись с кодом &5 в справочнике физических лиц"
     2479                                       ,vss-workfile
     2480                                       ,vss-revision
     2481                                       ,vss-description
     2482                                       ,chr(10)
     2483                                       ,string(buf_payer.obj-code)).
     2484       end.
     2485     end.
