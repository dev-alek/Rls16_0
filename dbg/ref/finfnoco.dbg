     2788       define variable p-by-petrol-goods as logical   no-undo .
     2789       mCashBook = new ibs.th.ref.cashbookstorage () .
     2790       o-head-position = mCashBook:getSinglRule(tt-fin-doc.CashBookId, tt-fin-doc.obj-type, tt-fin-doc.obj-code, "ManagerPosition") .
     2791       o-director      = mCashBook:getSinglRule(tt-fin-doc.CashBookId, tt-fin-doc.obj-type, tt-fin-doc.obj-code, "ManagerFIO") .
     2792       o-snr-accnt     = mCashBook:getSinglRule(tt-fin-doc.CashBookId, tt-fin-doc.obj-type, tt-fin-doc.obj-code, "BuhFIO") .
     2793       delete object mCashBook no-error .
     2794       case o-head-position:
     2795         when '0':U then
     2796           do:
     2797             v-head-position = buf_sysconf.head-position.
     2798           end.
     2799         when '1':U then
     2800           do:
     2801             v-head-position = "Директор".
     2802           end.
     2803         when '2':U then
     2804           do:
     2805             v-head-position = "Управляющий".
     2806           end.
     2807         otherwise
     2808         do :
     2809           v-head-position = o-head-position.
     2810         end.
     2811       end case.
     2812       case o-director:
     2813         when '1':U then
     2814           do:
     2815             if p-obj-type = 'маг':U then
     2816             do:
     2817               find first buf_shop no-lock where
     2818                 buf_shop.obj-code = p-obj-code no-error .
     2819               if available buf_shop then
     2820               do:
     2821                 v-director = buf_shop.director.
     2822               end.
     2823             end.
     2824             if p-obj-type = 'скл':U then
     2825             do:
     2826               find first buf_store no-lock where
     2827                 buf_store.obj-code = p-obj-code no-error .
     2828               if available buf_store then
     2829               do:
     2830                 v-director = buf_store.store-boss.
     2831               end.
     2832             end.
     2833           end.
     2834         when '0':U then
     2835           do:
     2836             v-director = buf_firm.director.
     2837           end.
     2838         otherwise
     2839         do:
     2840           v-director = o-director .
     2841         end.
     2842       end case.
     2843       case o-snr-accnt:
     2844         when '1':U then
     2845           do:
     2846             if p-obj-type = 'маг':U then
     2847             do:
     2848               find first buf_shop no-lock where
     2849                 buf_shop.obj-code = p-obj-code no-error .
     2850               if available buf_shop then
     2851               do:
     2852                 v-snr-accnt = entry(1,buf_shop.acct,"|").
     2853               end.
     2854             end.
     2855             if p-obj-type = 'скл':U then
     2856             do:
     2857               v-snr-accnt = ''.
     2858             end.
     2859           end.
     2860         when '2':U then
     2861           do:
     2862             v-snr-accnt = buf_sysconf.snr-accnt.
     2863           end.
     2864         otherwise
     2865         do:
     2866           v-snr-accnt = o-snr-accnt .
     2867         end.
     2868       end case.
     2869       v-cashier = buf_sysconf.cashier.
     2870       if v-cashier = "" then v-cashier = p-cashier .
     2871     end.
     2872     else
     2873     do:
     2874       assign
     2875         v-head-position = buf_sysconf.head-position
     2876         v-director      = buf_firm.director
     2877         v-snr-accnt     = buf_sysconf.snr-accnt
     2878         v-cashier       = buf_sysconf.cashier
     2879         .
     2880     end.
     2881     FIND FIRST ub.shift-staff No-LOCK WHERE
     2882       ub.shift-staff.obj-type   = p-obj-type AND
     2883       ub.shift-staff.obj-code   = p-obj-code AND
     2884       ub.shift-staff.shift-date = tt-fin-doc.shift-date AND
     2885       ub.shift-staff.shift-num  = tt-fin-doc.shift-num AND
     2886       ub.shift-staff.shift-name  = tt-fin-doc.shift-name AND
     2887       ub.shift-staff.staff-role = no and
     2888       ub.shift-staff.psn-num    >= 0 No-ERROR.
     2889     assign
     2890       v-cashier = if available ub.shift-staff then string(ub.shift-staff.name, "X(30)") else  string(p-cashier, "X(30)") .
     2891     .
     2892     find first ub.CashBook no-lock where ub.CashBook.id = tt-fin-doc.cashbookid no-error .
     2893     if not available ub.CashBook
     2894       then
     2895     do :
     2896       find first ub.CashBook no-lock where ub.CashBook.id = 0 no-error .
     2897     end.
     2898     if available ub.CashBook
     2899       then
     2900     do :
     2901       p-by-cash-desk = ub.CashBook.FlagSepCash .
     2902       p-by-petrol-goods = ub.CashBook.FlagSepFull .
     2903     end.
