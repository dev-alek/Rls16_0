     3989         ,input ttc-fin-doc.cel-nazn-code
     3990         ,input-output ttc-fin-doc.cor-acc1-value
     3991         ,input-output ttc-fin-doc.cor-acc-value
     3992         ,input-output ttc-fin-doc.an-uchet-value
     3993         ,input-output ttc-fin-doc.cel-nazn-value
