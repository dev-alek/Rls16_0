        1   DEFINE BUFFER buf_fin-code FOR ub.fin-code-cel-nazn.
        2   def var vss-revision    as character no-undo init "$Revision$":U .
        3   def var vss-author      as character no-undo init "$Author$":U .
        4   def var vss-date        as character no-undo init "$Date$":U .
        5   def var vss-workfile    as character no-undo init "$Workfile$":U .
        6   def var vss-archive     as character no-undo init "$Archive$":U .
        7   def var vss-description as character no-undo init "Корректировка справочника в ФИНБлоке цел.назн    ".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define input parameter        ref-mode as character no-undo .
       63   define input-output parameter ri       as recid no-undo.
       64   define input parameter par-host-code as integer no-undo .
       65   define variable tcode as character no-undo .
       66   define variable p-fin-code as integer no-undo .
       67   define new global shared variable g#language as character no-undo .
       68   if g#language <> '' and g#language <> 'rus':U then do:
       69     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       70   end.
       71   define new global shared variable g#library  as handle no-undo .
       72   define new global shared variable g#library2 as handle no-undo .
       73   define   shared variable g#auto as logical no-undo.
       74   define   shared variable g#news as logical no-undo.
       75   define   shared variable g#oxml as logical no-undo.
       76   define   shared variable g#esys as logical no-undo.
       77   define   shared variable g#news-source-db as integer no-undo.
       78   define   shared variable g#esys-source-esys as integer no-undo.
       79   define   shared variable g#db-num as integer   no-undo .
       80   define   shared variable g#userid as character no-undo .
       81   define   shared variable g#passwd as character no-undo .
       82   procedure proc-alt-shift-f2:
       83     if not ibs.th.gbl.gbl-var:rcode
       84   then
       85     run gbl\inidebug.p .
       86   end.
       87   procedure proc-alt-shift-f3:
       88     run gbl/prvssinf.p
       89       ( input this-procedure
       90       ) .
       91   end.
       92   define variable v-inform-launched as logical no-undo initial false .
       93   procedure proc-alt-shift-f4:
       94     define variable v-action as character no-undo .
       95     if v-inform-launched = false then do:
       96       assign
       97         v-inform-launched = true
       98       .
       99       run gbl/d-inform.w
      100         (  input self
      101         ,  input this-procedure
      102         , output v-action
      103         ) no-error .
      104       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      105       assign
      106         v-inform-launched = false
      107       .
      108     end.
      109   end.
      110   procedure proc-alt-f1:
      111     run gbl/corrhelp.p
      112       (input this-procedure
      113       ) .
      114   end .
      115   on alt-shift-f2 anywhere do:
      116     run proc-alt-shift-f2.
      117   end.
      118   on alt-shift-f3 anywhere do:
      119     run proc-alt-shift-f3 in this-procedure .
      120   end.
      121   on alt-shift-f4 anywhere do:
      122     run proc-alt-shift-f4 in this-procedure.
      123   end.
      124   on alt-f1 anywhere do:
      125     run proc-alt-f1 in this-procedure .
      126   end.
      127   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      128   procedure cur-time :
      129      define output parameter p-today as date      no-undo .
      130      define output parameter p-time  as integer   no-undo .
      131     do
      132     on error undo, return error
      133     :
      134       define variable v-date1 as date      no-undo .
      135       define variable v-date2 as date      no-undo .
      136       define variable v-time  as integer   no-undo .
      137       assign
      138         v-date1 = today
      139         v-time  = time
      140         v-date2 = today
      141       .
      142       if v-date1 <> v-date2
      143       then do:
      144         assign
      145           v-date1 = today
      146           v-time  = v-time
      147         .
      148       end.
      149       assign
      150         p-today = v-date1
      151         p-time  = v-time
      152       .
      153     end.
      154   end.
      155   function cur-time-date returns character
      156   :
      157     return string(today, '99/99/9999':U) .
      158   end.
      159   function cur-time-mjd returns decimal
      160   :
      161     define variable v-date as date      no-undo .
      162     define variable v-time as integer   no-undo .
      163     run cur-time in this-procedure
      164       (output v-date
      165       ,output v-time
      166       ) .
      167     return integer(v-date) - 2400002 + (v-time / 86400) .
      168   end.
      169   function cur-time-get-ending-index returns integer
      170   (input p-number as integer
      171   )
      172   :
      173     if p-number < 0
      174     or p-number = ?
      175     then do:
      176       return 1 .
      177     end.
      178     define variable v-rest as integer   no-undo .
      179     assign
      180       p-number = p-number modulo 100
      181     .
      182     if p-number < 20
      183     then do:
      184       assign
      185         v-rest = p-number
      186       .
      187     end.
      188     else do:
      189       assign
      190         v-rest = p-number modulo 10
      191       .
      192     end.
      193     case v-rest :
      194       when 1
      195       then do:
      196         return 2 .
      197       end.
      198       when 2 or
      199       when 3 or
      200       when 4
      201       then do:
      202         return 3 .
      203       end.
      204       otherwise do:
      205         return 1 .
      206       end.
      207     end case .
      208   end.
      209   procedure cur-time-mjd-to-date :
      210      define input  parameter i-mjd-diff as decimal no-undo.
      211      define output parameter o-Date     as date    no-undo.
      212      define output parameter o-Time     as integer no-undo.
      213      define variable v-day-number as integer   no-undo .
      214      if    i-mjd-diff < 0
      215         or i-mjd-diff = ?
      216      then do:
      217         return "?" .
      218      end.
      219      assign
      220         v-day-number = truncate(i-mjd-diff,0).
      221         o-Date = date(v-day-number + 2400002).
      222         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      223     .
      224   end.
      225   function cur-time-mjd-to-string returns character
      226   (input p-mjd-diff as decimal
      227   )
      228   :
      229     define variable v-day-number as integer   no-undo .
      230     define variable v-seconds    as integer   no-undo .
      231     define variable v-hour       as integer   no-undo .
      232     define variable v-min        as integer   no-undo .
      233     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      234     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      235     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      236     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      237     if p-mjd-diff < 0
      238     or p-mjd-diff = ?
      239     then do:
      240       return "?" .
      241     end.
      242     assign
      243       v-day-number = integer(truncate(p-mjd-diff,0))
      244       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      245     .
      246     if v-seconds > 86400
      247     then do:
      248       assign
      249         v-seconds = 86400 - 1
      250       .
      251     end.
      252     if v-seconds < 0
      253     then do:
      254       assign
      255         v-seconds = 0
      256       .
      257     end.
      258     assign
      259       v-hour = truncate(v-seconds / 3600, 0)
      260     .
      261     assign
      262       v-seconds = v-seconds modulo 3600
      263     .
      264     assign
      265       v-min = truncate(v-seconds / 60, 0)
      266     .
      267     assign
      268       v-seconds = v-seconds modulo 60
      269     .
      270     return
      271         (if v-day-number <> 0
      272           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      273           else ""
      274         )
      275       + (if v-day-number <> 0 or v-hour <> 0
      276           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      277           else ""
      278         )
      279       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      280           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      281           else ""
      282         )
      283       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      284       .
      285   end.
      286   function cur-time-string returns character
      287   :
      288     define variable v-date as date      no-undo .
      289     define variable v-time as integer   no-undo .
      290     run cur-time in this-procedure
      291       (output v-date
      292       ,output v-time
      293       ) .
      294     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      295   end.
      296   function cur-time-string-sec returns character
      297   :
      298     define variable v-date as date      no-undo .
      299     define variable v-time as integer   no-undo .
      300     run cur-time in this-procedure
      301       (output v-date
      302       ,output v-time
      303       ) .
      304     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      305   end.
      306   function cur-time-custom  returns character
      307   (input p-prefix as character
      308   ,input p-date-format as character
      309   ,input p-delimiter as character
      310   ,input p-time-format as character
      311   ,input p-suffix as character
      312   )
      313   :
      314     define variable v-date as date      no-undo .
      315     define variable v-time as integer   no-undo .
      316     run cur-time in this-procedure
      317       (output v-date
      318       ,output v-time
      319       ) .
      320     return
      321       p-prefix
      322       + string(v-date, p-date-format)
      323       + p-delimiter
      324       + string(v-time, p-time-format)
      325       + p-suffix
      326       .
      327   end.
      328   function cur-time-print  returns character
      329   :
      330     define variable v-date as date      no-undo .
      331     define variable v-time as integer   no-undo .
      332     run cur-time in this-procedure
      333       (output v-date
      334       ,output v-time
      335       ) .
      336     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      337   end.
      338   function cur-time-datetime returns datetime
      339   :
      340     define variable v-char as character no-undo .
      341     define variable v-datetime as datetime no-undo .
      342     v-char = cur-time-string().
      343     v-datetime = datetime(v-char).
      344     return  v-datetime.
      345   end.
      346   function cur-time-string-msec returns character
      347   :
      348     define variable v-date as datetime  no-undo .
      349     v-date = now.
      350     return string(v-date) .
      351   end.
      352   DEFINE BUTTON b-exit AUTO-GO
      353        LABEL "&Ввод "
      354        SIZE 10 BY 1.
      355   DEFINE BUTTON b-help
      356        LABEL "Помо&щь"
      357        SIZE 10 BY 1.
      358   DEFINE BUTTON b-quit AUTO-END-KEY
      359        LABEL "&Отмена"
      360        SIZE 10 BY 1.
      361   DEFINE VARIABLE FILL-IN-1 AS CHARACTER FORMAT "X(256)":U INITIAL "Уровни для сбора аналитики"
      362         VIEW-AS TEXT
      363        SIZE 27.2 BY .67
      364        FGCOLOR 4  NO-UNDO.
      365   DEFINE RECTANGLE RECT-1
      366        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      367        SIZE 68.8 BY 2.52.
      368   DEFINE QUERY Dialog-Frame FOR
      369         fin-code-cel-nazn,
      370         buf_fin-code SCROLLING.
      371   DEFINE FRAME Dialog-Frame
      372        b-exit AT ROW 1 COL 1
      373        b-quit AT ROW 1 COL 11
      374        b-help AT ROW 1 COL 62.2
      375        fin-code-cel-nazn.code-value AT ROW 2.43 COL 7 COLON-ALIGNED
      376             LABEL "Код"
      377             VIEW-AS FILL-IN
      378             SIZE 13 BY 1 TOOLTIP "Код спрпавочника"
      379        fin-code-cel-nazn.descr AT ROW 5.29 COL 1 NO-LABEL
      380             VIEW-AS FILL-IN
      381             SIZE 69.8 BY 1
      382        fin-code-cel-nazn.level-1 AT ROW 7.76 COL 11.2 COLON-ALIGNED
      383             VIEW-AS FILL-IN
      384             SIZE 4 BY 1
      385        fin-code-cel-nazn.level-2 AT ROW 7.76 COL 35.6 COLON-ALIGNED
      386             VIEW-AS FILL-IN
      387             SIZE 4 BY 1
      388        fin-code-cel-nazn.level-3 AT ROW 7.76 COL 59 COLON-ALIGNED
      389             VIEW-AS FILL-IN
      390             SIZE 4 BY 1
      391        FILL-IN-1 AT ROW 6.71 COL 20.6 COLON-ALIGNED NO-LABEL
      392        "Наименование" VIEW-AS TEXT
      393             SIZE 16 BY .62 AT ROW 4.33 COL 1 WIDGET-ID 2
      394        RECT-1 AT ROW 6.81 COL 1
      395        SPACE(2.45) SKIP(0.04)
      396       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      397            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      398            TITLE "Корректировка справочника"
      399            CANCEL-BUTTON b-quit.
      400   ASSIGN
      401          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      402          FRAME Dialog-Frame:HIDDEN           = TRUE.
      403   ON GO OF FRAME Dialog-Frame
      404   DO:
      405     def var rr as recid no-undo.
      406     if input ub.fin-code-cel-nazn.code-value = "" then do:
      407         message "Код  не может быть не задан" view-as alert-box.
      408         apply "ENTRY":U to ub.fin-code-cel-nazn.code-value.
      409         return no-apply.
      410     end.
      411     if  input ub.fin-code-cel-nazn.descr = ""  then do:
      412         message "Введите наименование " view-as alert-box WARNING.
      413         apply "ENTRY":U to ub.fin-code-cel-nazn.descr.
      414         return no-apply.
      415     end.
      416     rr = recid( ub.fin-code-cel-nazn ).
      417     if ref-mode =  'ДОБАВЛЕНИЕ':U then do:
      418       if can-find(first ub.fin-code-cel-nazn where ub.fin-code-cel-nazn.code-value = input ub.fin-code-cel-nazn.code-value
      419                                          AND recid( ub.fin-code-cel-nazn ) <> rr
      420                                          and ub.fin-code-cel-nazn.host-code = par-host-code
      421                                            ) then do:
      422           message "Запись с кодом" input ub.fin-code-cel-nazn.code-value "уже существует!" skip
      423                 "Если ее нет в списке, то она логически удалена."
      424                 view-as alert-box warning.
      425           apply "ENTRY":U to ub.fin-code-cel-nazn.code-value.
      426           return no-apply.
      427       end.
      428     end.
      429       if ref-mode <> 'ПРОСМОТР':U then
      430     assign ub.fin-code-cel-nazn.code-value
      431            ub.fin-code-cel-nazn.descr
      432            ub.fin-code-cel-nazn.level-1
      433            ub.fin-code-cel-nazn.level-2
      434            ub.fin-code-cel-nazn.level-3
      435            ri = recid( ub.fin-code-cel-nazn )
      436     .
      437   END.
      438   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      439   DO:
      440   apply "CHOOSE" to b-quit IN FRAME Dialog-Frame .
      441     APPLY "END-ERROR":U TO SELF.
      442   END.
      443   ON CHOOSE OF b-quit IN FRAME Dialog-Frame
      444   DO:
      445       ri = ? .
      446     if ref-mode =  'ДОБАВЛЕНИЕ':U then do:
      447         find current ub.fin-code-cel-nazn  exclusive-lock   no-error.
      448         if available ub.fin-code-cel-nazn then do:
      449            delete ub.fin-code-cel-nazn.
      450         end.
      451     end.
      452   END.
      453   def var vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      454   define buffer buf_file for ub.fin-code-cel-nazn .
      455   procedure current-db :
      456    do
      457    on error undo, return error return-value
      458    :
      459   define input parameter  p-host-code as integer no-undo .
      460   define input parameter  c-host-code as integer no-undo .
      461   define output parameter ret         as logical no-undo .
      462   define buffer current_sysconf for ub.sysconf.
      463   define variable v-current-db as integer no-undo .
      464   find first current_sysconf where current_sysconf.host-code = c-host-code no-lock no-error .
      465   if error-status :error then return error .
      466      v-current-db = current_sysconf.firm-db-num .
      467      ret = true .
      468   find first ub.sysconf where ub.sysconf.host-code = p-host-code no-lock no-error .
      469   if not( ub.sysconf.firm-db-num = v-current-db or
      470           ub.sysconf.firm-db-num = 0 )
      471     then do:
      472     ret = false .
      473     message "Нельзя добавлять запись в  справочнике  для фирмы с не главной БД !!!" view-as alert-box information .
      474     return .
      475   end.
      476    end.
      477   end procedure.
      478   procedure ver-db :
      479    do
      480    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
      481    :
      482   define input parameter  c-host-code as integer no-undo .
      483   define input parameter  par-ver-db  as integer no-undo .
      484   define input parameter  p-mess as logical no-undo .
      485   define output parameter ret         as logical no-undo .
      486   define buffer current_sysconf for ub.sysconf.
      487   define variable v-current-db as integer no-undo .
      488   find first current_sysconf where current_sysconf.host-code = c-host-code no-lock no-error .
      489   if error-status :error then return error .
      490      v-current-db = current_sysconf.firm-db-num .
      491      ret = true .
      492   if not( par-ver-db = v-current-db or
      493           par-ver-db = 0 )
      494     then do:
      495     ret = false .
      496     if p-mess = true then message "База , на которой мы работаем не является главной базой данных текущей фирмы!!!" view-as alert-box information .
      497     return .
      498   end.
      499    end.
      500   end procedure.
      501   procedure fin-code :
      502    do
      503    on error undo, return error return-value
      504    :
      505     define input  parameter p-host-code as integer no-undo .
      506     define output parameter p-fin-code  as integer no-undo .
      507     p-fin-code = next-value(s-fin-code, ub) .
      508    end.
      509   end procedure.
      510   procedure create-ref-fin-code :
      511    do
      512    on error undo, return error return-value
      513    :
      514   define input parameter p-ver as logical no-undo .
      515   define input parameter p-host-code  as integer   no-undo .
      516   define input parameter p-fin-code   as integer   no-undo .
      517   define input parameter p-code-value as character no-undo .
      518   define input parameter p-descr      as character no-undo .
      519   define input parameter p-status_    as integer   no-undo .
      520   define input parameter p-level-1    as integer   no-undo .
      521   define input parameter p-level-2    as integer   no-undo .
      522   define input parameter p-level-3    as integer   no-undo .
      523   if p-ver then do:
      524       find first  buf_file no-lock  where buf_file.host-code = p-host-code and
      525                                           buf_file.fin-code  = p-fin-code no-error .
      526       if available buf_file then return error .
      527   end.
      528   define variable p-ret as logical no-undo .
      529   run current-db in this-procedure (
      530       input p-host-code,
      531       input p-host-code,
      532       output p-ret ) .
      533    if p-ret = no then return.
      534    create ub.fin-code-cel-nazn.
      535    assign
      536      ub.fin-code-cel-nazn.host-code  = p-host-code
      537      ub.fin-code-cel-nazn.fin-code   = p-fin-code
      538      ub.fin-code-cel-nazn.code-value = p-code-value
      539      ub.fin-code-cel-nazn.descr      = p-descr
      540      ub.fin-code-cel-nazn.status_    = p-status_
      541      ub.fin-code-cel-nazn.level-1    = p-level-1
      542      ub.fin-code-cel-nazn.level-2    = p-level-2
      543      ub.fin-code-cel-nazn.level-3    = p-level-3
      544     no-error .
      545     if error-status :error then do:
      546         message vss-include-info1 skip
      547                 error-status :get-message(1)
      548                 view-as alert-box error .
      549         return error .
      550     end.
      551    end.
      552   end procedure.
      553   procedure create-ref-corr-acc :
      554    do
      555    on error undo, return error return-value
      556    :
      557   define input parameter p-ver as logical no-undo .
      558   define input parameter p-host-code  as integer   no-undo .
      559   define input parameter p-fin-code   as integer   no-undo .
      560   define input parameter p-code-value as character no-undo .
      561   define input parameter p-descr      as character no-undo .
      562   define input parameter p-status_    as integer   no-undo .
      563   define input parameter p-level-1    as integer   no-undo .
      564   define input parameter p-level-2    as integer   no-undo .
      565   define input parameter p-level-3    as integer   no-undo .
      566   define input parameter p-acc-type    as integer   no-undo .
      567   define buffer buf_file  for ub.fin-code-cor-acc .
      568   if p-ver then do:
      569       find first  buf_file no-lock  where buf_file.host-code = p-host-code and
      570                                           buf_file.fin-code  = p-fin-code no-error .
      571       if available buf_file then return error .
      572   end.
      573   define variable p-ret as logical no-undo .
      574   run current-db in this-procedure (
      575       input p-host-code,
      576       input p-host-code,
      577       output p-ret ) .
      578    if p-ret = no then return.
      579    create ub.fin-code-cor-acc.
      580    assign
      581      ub.fin-code-cor-acc.host-code  = p-host-code
      582      ub.fin-code-cor-acc.fin-code   = p-fin-code
      583      ub.fin-code-cor-acc.code-value = p-code-value
      584      ub.fin-code-cor-acc.descr      = p-descr
      585      ub.fin-code-cor-acc.status_    = p-status_
      586      ub.fin-code-cor-acc.level-1    = p-level-1
      587      ub.fin-code-cor-acc.level-2    = p-level-2
      588      ub.fin-code-cor-acc.level-3    = p-level-3
      589      ub.fin-code-cor-acc.acc-type   = p-acc-type
      590     no-error .
      591     if error-status :error then do:
      592         message vss-include-info1 skip
      593                 error-status :get-message(1)
      594                 view-as alert-box error .
      595         return error .
      596     end.
      597    end.
      598   end procedure.
      599   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      600   on help of frame Dialog-Frame
      601   do:
      602     run gbl/app_help.p
      603       (input this-procedure :file-name
      604       ,input ''
      605       ,input ?
      606       ) no-error.
      607     if error-status :error then do:
      608       message
      609         "Ошибка при вызове помощи"
      610         error-status :get-message(1)
      611         view-as alert-box .
      612     end.
      613   end.
      614   run minbtn-set in this-procedure .
      615   on choose of b-help in frame Dialog-Frame
      616   do:
      617     apply "help":u to frame Dialog-Frame .
      618   end.
      619   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      620   procedure minbtn-set :
      621       do
      622           on error undo, return error return-value
      623           :
      624           define variable ii              as integer       no-undo .
      625           define variable fh              as widget-handle no-undo .
      626           define variable hh              as widget-handle no-undo .
      627           define variable v-h             as handle        extent 4 no-undo .
      628           define variable v-name-button   as character     no-undo .
      629           define variable v-help-old-x    as decimal       no-undo .
      630           define variable v-help-old-y    as decimal       no-undo .
      631           define variable v-help-old-size as decimal       no-undo .
      632           define variable v-frame-width   as decimal       no-undo .
      633           define variable jj              as integer       no-undo .
      634           do
      635               on error undo, return error
      636               :
      637               assign
      638                   v-frame-width = frame Dialog-Frame:width - 0.3
      639                   fh            = frame Dialog-Frame:first-child
      640                   hh            = fh:first-child
      641                   ii            = 1
      642                   .
      643               do while valid-handle(hh):
      644                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      645                   do:
      646                       case lc(hh:name) :
      647                           when "b-help" then
      648                               do:
      649                                   hh:load-image-up("cmp/b-help.bmp":u) .
      650                                   hh:load-image-down("cmp/b-help.bmp":u) .
      651                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      652                                   hh:TOOLTIP = "Помощь" .
      653                                   v-help-old-x = hh:column .
      654                                   v-help-old-y = hh:row    .
      655                                   v-help-old-size = hh:width .
      656                                   hh:width-chars = 2.5 .
      657                               end.
      658                           when "b-print" then
      659                               do:
      660                                   hh:load-image("cmp/b-print.bmp":u) .
      661                                   hh:TOOLTIP = "Печать" .
      662                                   v-h[ii] = hh:handle .
      663                                   ii = ii + 1 .
      664                                   hh:width-chars = 3 .
      665                               end.
      666                           when "b-history" or
      667                           when "b-hist" then
      668                               do:
      669                                   hh:load-image("cmp/b-hist.bmp":u) .
      670                                   hh:TOOLTIP = "История" .
      671                                   v-h[ii] = hh:handle .
      672                                   ii = ii + 1 .
      673                                   hh:width-chars = 3 .
      674                               end.
      675                           when "b-sch" then
      676                               do:
      677                                   hh:load-image("cmp/b-sch.bmp":u) .
      678                                   hh:TOOLTIP = "Установка Фильтра" .
      679                                   v-h[ii] = hh:handle .
      680                                   ii = ii + 1 .
      681                                   hh:width-chars = 3 .
      682                               end.
      683                           when "b-hist-user" then
      684                               do:
      685                                   hh:load-image("cmp/b-hist.bmp":u) .
      686                                   hh:TOOLTIP = "История пользователя" .
      687                                   ii = ii + 1 .
      688                               end.
      689                       end case.
      690                   end.
      691                   hh = hh:next-sibling.
      692               end.
      693               b-help:column = v-frame-width - b-help:width-chars.
      694               jj = 0.
      695               repeat ii = 4 to 1 by -1 :
      696                   if valid-handle (v-h[ii] ) then
      697                   do:
      698                       jj  = jj + 1 .
      699                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      700                       v-h[ii]:row    = v-help-old-y .
      701                   end.
      702               end.
      703           end.
      704       end.
      705   end procedure.
      706   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      707   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      708   MAIN-BLOCK:
      709   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      710      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      711       if ref-mode =  'ДОБАВЛЕНИЕ':U
      712           then  do:
      713               ri = ?.
      714               run fin-code in this-procedure (input par-host-code , output p-fin-code) .
      715               tcode = string(p-fin-code) .
      716               run create-ref-fin-code in this-procedure (
      717                   input no ,
      718                   input par-host-code ,
      719                   input p-fin-code    ,
      720                   input tcode ,
      721                   input ""    ,
      722                   input 0 ,
      723                   input 0 ,
      724                   input 0 ,
      725                   input 0 ).
      726           end.
      727           else  do:
      728            find ub.fin-code-cel-nazn where recid( ub.fin-code-cel-nazn ) = ri no-error .
      729            if error-status :error then return  error .
      730            end.
      731   frame Dialog-Frame:title = frame Dialog-Frame:title + "  - " + caps(ref-mode).
      732   b-quit:label = (if  ref-mode = 'ПРОСМОТР':U then "&Выход" else b-quit:label ).
      733       session:data-entry-return = yes .
      734        if ref-mode = 'ПРОСМОТР':U then do:
      735           run myenable_UI in this-procedure.
      736           WAIT-FOR GO OF FRAME Dialog-Frame FOCUS b-quit.
      737        end.
      738        else do:
      739       run enable_UI in this-procedure.
      740       if ref-mode = 'ДОБАВЛЕНИЕ':U
      741           then  WAIT-FOR GO OF FRAME Dialog-Frame FOCUS ub.fin-code-cel-nazn.code-value .
      742           else  WAIT-FOR GO OF FRAME Dialog-Frame FOCUS ub.fin-code-cel-nazn.descr .
      743       end.
      744   END.
      745   run disable_UI in this-procedure.
      746   PROCEDURE disable_UI :
      747     HIDE FRAME Dialog-Frame.
      748   END PROCEDURE.
      749   PROCEDURE enable_UI :
      750     DISPLAY FILL-IN-1
      751         WITH FRAME Dialog-Frame.
      752     IF AVAILABLE fin-code-cel-nazn THEN
      753       DISPLAY fin-code-cel-nazn.code-value fin-code-cel-nazn.descr
      754             fin-code-cel-nazn.level-1 fin-code-cel-nazn.level-2
      755             fin-code-cel-nazn.level-3
      756         WITH FRAME Dialog-Frame.
      757     ENABLE b-exit b-quit b-help RECT-1 fin-code-cel-nazn.code-value
      758            fin-code-cel-nazn.descr fin-code-cel-nazn.level-1
      759            fin-code-cel-nazn.level-2 fin-code-cel-nazn.level-3 FILL-IN-1
      760         WITH FRAME Dialog-Frame.
      761     VIEW FRAME Dialog-Frame.
      762   END PROCEDURE.
      763   PROCEDURE myenable_UI :
      764     IF AVAILABLE ub.fin-code-cel-nazn THEN
      765       DISPLAY ub.fin-code-cel-nazn.code-value ub.fin-code-cel-nazn.descr FILL-IN-1
      766             ub.fin-code-cel-nazn.level-1 ub.fin-code-cel-nazn.level-2
      767             ub.fin-code-cel-nazn.level-3
      768         WITH FRAME Dialog-Frame.
      769        enable b-quit b-help
      770         WITH FRAME Dialog-Frame.
      771     VIEW FRAME Dialog-Frame.
      772   END PROCEDURE.
