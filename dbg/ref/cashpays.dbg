     3143     end.
     3144   end procedure.
     3145   procedure diasize_add_browse :
     3146     define input  parameter p-browse-type   as character no-undo .
     3147     define input  parameter p-browse-handle as handle    no-undo .
     3148     define buffer buf_temp-browse-handle for temp-browse-handle .
