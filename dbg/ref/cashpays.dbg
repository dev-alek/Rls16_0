     1570        SIZE 3 BY 1.
     1571   DEFINE BUTTON b-sel AUTO-GO
     1572        LABEL "Вы&бор ":L
     1573        SIZE 10 BY 1.
     1574   DEFINE VARIABLE f-obj-name AS CHARACTER FORMAT "X(256)":U
     1575        LABEL "Поиск по назв."
     1576        VIEW-AS FILL-IN
     1577        SIZE 16.5 BY 1 NO-UNDO.
     1578   DEFINE VARIABLE mark-num AS CHARACTER FORMAT "X(256)":U
     1579        VIEW-AS FILL-IN
     1580        SIZE 6 BY 1
     1581        FGCOLOR 4  NO-UNDO.
     1582   DEFINE QUERY br-cashpay FOR
     1583         X_cash-pay SCROLLING.
     1584   DEFINE BROWSE br-cashpay
     1585     QUERY br-cashpay NO-LOCK DISPLAY
     1586         (IF ( CAN-DO (v-rid-list, string( recid( X_cash-pay ) ) ) ) THEN ("*") ELSE (" ")) COLUMN-LABEL "*" FORMAT "X(1)":U
     1587   X_cash-pay.cdpay-code FORMAT "9999":U
     1588   X_cash-pay.obj-name FORMAT "X(25)":U
     1589   X_cash-pay.curr-code COLUMN-LABEL "Валюта" FORMAT ">>9":U
     1590   X_cash-pay.pay-code COLUMN-LABEL "Вид оплаты" FORMAT "99999":U
     1591   X_cash-pay.status_ FORMAT "X(8)":U
     1592   get-grp-name(input X_cash-pay.cdpay-code, X_cash-pay.curr-code) COLUMN-LABEL "Группа" FORMAT "X(20)":U
     1593   X_cash-pay.wth-code COLUMN-LABEL "Код МЦ" FORMAT "999999999":U
     1594   get-wth-name(X_cash-pay.wth-code) COLUMN-LABEL "МЦ" FORMAT "X(20)":U
     1595   X_cash-pay.pay-limit COLUMN-LABEL "Предел без! авторизации" FORMAT "->>>,>>9.99":U
     1596   X_cash-pay.is-cash FORMAT "  +/":U
     1597   X_cash-pay.atr1 COLUMN-LABEL "Сдача" FORMAT "  +/":U
     1598   X_cash-pay.atr2 COLUMN-LABEL "Перевод" FORMAT "  +/":U
     1599   X_cash-pay.atr4 COLUMN-LABEL "Слип" FORMAT " +/":U
     1600   X_cash-pay.atr8 COLUMN-LABEL "Фактура" FORMAT "  +/":U
     1601   X_cash-pay.atr16 COLUMN-LABEL "On-line" FORMAT "  +/":U
     1602   X_cash-pay.atr32 COLUMN-LABEL "Обяз PIN" FORMAT "  +/":U
     1603   X_cash-pay.atr64 FORMAT "  +/":U
     1604   X_cash-pay.atr128 FORMAT "  +/":U
     1605       WITH SEPARATORS SIZE 98 BY 20
     1606            BGCOLOR 15 FGCOLOR 0 .
     1607   DEFINE FRAME d-cash-pay
     1608        b-quit AT ROW 1 COL 1
     1609        mark-num AT ROW 1 COL 9 COLON-ALIGNED NO-LABEL
     1610        b-sel AT ROW 1 COL 17
     1611        B-mark AT ROW 1 COL 27
     1612        b-add AT ROW 1 COL 30
     1613        b-lkp AT ROW 1 COL 40
     1614        b-chg AT ROW 1 COL 50
     1615        B-del AT ROW 1 COL 60
     1616        B-attr AT ROW 1 COL 70
     1617        B-disc AT ROW 1 COL 78
     1618        b-hist AT ROW 1 COL 87
     1619        B-sch AT ROW 1 COL 90 WIDGET-ID 2
     1620        b-print AT ROW 1 COL 93
     1621        b-help AT ROW 1 COL 96
     1622        f-obj-name AT ROW 2 COL 21.5 COLON-ALIGNED WIDGET-ID 4
     1623        br-cashpay AT ROW 3 COL 1
     1624        SPACE(0.00) SKIP(0.62)
     1625       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1626            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1627            TITLE "ТИПЫ КАССОВЫХ ПЛАТЕЖЕЙ":L.
     1628   ASSIGN
     1629          FRAME d-cash-pay:SCROLLABLE       = FALSE.
     1630   ASSIGN
     1631          B-attr:POPUP-MENU IN FRAME d-cash-pay       = MENU MENU-B-attr:HANDLE.
     1632   ASSIGN
     1633          B-disc:POPUP-MENU IN FRAME d-cash-pay       = MENU MENU-B-disc:HANDLE.
     1634   ASSIGN
     1635          br-cashpay:NUM-LOCKED-COLUMNS IN FRAME d-cash-pay     = 3.
     1636   ON GO OF FRAME d-cash-pay
     1637   DO:
     1638     IF b-sel:SENSITIVE THEN DO:
     1639        if ( available X_cash-pay ) AND ( v-rid-list = "" ) THEN DO:
     1640            v-rid-list = string( recid( X_cash-pay ) ) .
     1641        END.
     1642     END.
     1643     p-rid-list = v-rid-list.
     1644   END.
     1645   ON CHOOSE OF b-add IN FRAME d-cash-pay
     1646   DO:
     1647     define variable glog as logical no-undo .
     1648   define variable vss-include-info12 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1649   do:
     1650     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1651       (input  v-cntxt-db-num
     1652       ,input  v-cntxt-userid
     1653       ,input  0
     1654       ,input  'actn_payments-types_input-deletion-updating':U
     1655       ,input  'global':U
     1656       ,input  0
     1657       ,input  '':U
     1658       ,input  0
     1659       ,input  0
     1660       ,input  0
     1661       ,input  0
     1662       ,input  true
     1663       ,output glog
     1664       )  .
     1665   end.
     1666     if NOT glog then return no-apply .
     1667     run ref/cashpayi.w ( input parparentproc
     1668                     ,input 'ДОБАВЛЕНИЕ':U
     1669                     ,input p-host-code
     1670                     ,input p-obj-type
     1671                     ,input p-obj-code
     1672                     , input-output rr ).
     1673     if rr <> ? then do:
     1674       run Openbr in this-procedure ( INPUT YES, INPUT NO, INPUT '':U).
     1675       reposition br-cashpay to recid rr no-error .
     1676       log-res  = br-cashpay:select-focused-row( ).
     1677       apply "ENTRY":U to br-cashpay.
     1678     end.
     1679   END.
     1680   ON CHOOSE OF B-attr IN FRAME d-cash-pay
     1681   DO:
     1682     if not available X_cash-pay THEN return no-apply.
     1683     DEFINE VARIABLE glog AS LOGICAL NO-UNDO.
     1684     if attr-option = "":U then do:
     1685       run gbl/pop-up.p ( input self :handle, input no ) no-error.
     1686       if error-status :error then do: return no-apply. end.
     1687     end.
     1688     if attr-option = "":U then do:
     1689         return no-apply.
     1690     end.
     1691     IF attr-option = 'ИЗМЕНЕНИЕ':U THEN DO:
     1692   define variable vss-include-info13 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1693   do:
     1694     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1695       (input  v-cntxt-db-num
     1696       ,input  v-cntxt-userid
     1697       ,input  0
     1698       ,input  'actn_payments-types_input-deletion-updating':U
     1699       ,input  'global':U
     1700       ,input  0
     1701       ,input  '':U
     1702       ,input  0
     1703       ,input  0
     1704       ,input  0
     1705       ,input  0
     1706       ,input  true
     1707       ,output glog
     1708       )  .
     1709   end.
     1710       if NOT glog then return no-apply .
     1711     END.
     1712     run ref/cp-atti.w ( input parparentproc
     1713                   ,input attr-option
     1714                   ,input X_cash-pay.cdpay-code
     1715                   ,input X_cash-pay.curr-code
     1716                   ,input p-host-code
     1717                   ,input p-obj-type
     1718                   ,input p-obj-code
     1719                  ) NO-ERROR.
     1720     if attr-option = 'ИЗМЕНЕНИЕ':U then do:
     1721       br-cashpay:refresh().
     1722     end.
     1723     attr-option = "":U.
     1724   END.
     1725   ON CHOOSE OF b-chg IN FRAME d-cash-pay
     1726   DO:
     1727   define variable glog as logical no-undo .
     1728   define variable vss-include-info14 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1729   do:
     1730     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1731       (input  v-cntxt-db-num
     1732       ,input  v-cntxt-userid
     1733       ,input  0
     1734       ,input  'actn_payments-types_input-deletion-updating':U
     1735       ,input  'global':U
     1736       ,input  0
     1737       ,input  '':U
     1738       ,input  0
     1739       ,input  0
     1740       ,input  0
     1741       ,input  0
     1742       ,input  true
     1743       ,output glog
     1744       )  .
     1745   end.
     1746   if NOT glog then return no-apply .
     1747   if not available X_cash-pay THEN
     1748       return no-apply.
     1749   rr = recid( X_cash-pay ).
     1750   run ref/cashpayi.w (
     1751                   input parparentproc
     1752                 ,input 'ИЗМЕНЕНИЕ':U
     1753                 ,input p-host-code
     1754                 ,input p-obj-type
     1755                 ,input p-obj-code
     1756                 ,input-output rr ).
     1757   run Openbr in this-procedure ( INPUT YES, INPUT NO, INPUT '':U).
     1758   reposition br-cashpay to recid rr no-error .
     1759   apply "ENTRY" to br-cashpay.
     1760   END.
     1761   ON CHOOSE OF B-del IN FRAME d-cash-pay
     1762   DO:
     1763   define variable v-status_ like ub.cash-pay.status_ no-undo.
     1764   define variable v-rec as recid no-undo.
     1765   define variable glog as logical no-undo .
     1766   if not available X_cash-pay then return no-apply.
     1767   define variable vss-include-info15 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1768   do:
     1769     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1770       (input  v-cntxt-db-num
     1771       ,input  v-cntxt-userid
     1772       ,input  0
     1773       ,input  'actn_payments-types_input-deletion-updating':U
     1774       ,input  'global':U
     1775       ,input  0
     1776       ,input  '':U
     1777       ,input  0
     1778       ,input  0
     1779       ,input  0
     1780       ,input  0
     1781       ,input  true
     1782       ,output glog
     1783       )  .
     1784   end.
     1785   if NOT glog then  return no-apply .
     1786   assign
     1787   v-rec = recid(X_cash-pay).
     1788   run ref/cashpay3.p (recid(X_cash-pay),  input-output v-status_) no-error.
     1789   if not error-status:error then do:
     1790     run Openbr in this-procedure ( INPUT YES, INPUT NO, INPUT '':U).
     1791     REPOSITION br-cashpay to recid v-rec No-error.
     1792     if available X_cash-pay then do:
     1793       log-res = br-cashpay:select-focused-row( ).
     1794     end.
     1795   end.
     1796   apply "ENTRY" to br-cashpay.
     1797   END.
     1798   ON CHOOSE OF B-disc IN FRAME d-cash-pay
     1799   DO:
     1800     if not available X_cash-pay THEN return no-apply.
     1801     DEFINE VARIABLE glog AS LOGICAL NO-UNDO.
     1802     if dcpr-option = "":U then do:
     1803       run gbl/pop-up.p ( input self :handle, input no ) no-error.
     1804       if error-status :error then do: return no-apply. end.
     1805     end.
     1806     if dcpr-option = "":U then do:
     1807         return no-apply.
     1808     end.
     1809     run ref/discprui.w ( input parparentproc
     1810                   ,input dcpr-option
     1811                   ,input X_cash-pay.cdpay-code
     1812                   ,input X_cash-pay.curr-code
     1813                   ,input p-host-code
     1814                   ,input p-obj-type
     1815                   ,input p-obj-code
     1816                  ) NO-ERROR.
     1817   END.
     1818   ON CHOOSE OF b-hist IN FRAME d-cash-pay
     1819   DO:
     1820     define variable v-rid-list as character no-undo.
     1821    if not available X_cash-pay then return no-apply.
     1822         run ref/ccashpay.w (
     1823                            input parparentproc
     1824                          , INPUT "":U
     1825                          , INPUT "one":U
     1826                          , OUTPUT  v-rid-list
     1827                          , INPUT X_cash-pay.cdpay-code
     1828                          , INPUT X_cash-pay.curr-code
     1829                          , input "":U
     1830                           ) no-error .
     1831       apply "entry" to br-cashpay.
     1832   END.
     1833   ON CHOOSE OF b-lkp IN FRAME d-cash-pay
     1834   DO:
     1835       if not available X_cash-pay THEN
     1836           return no-apply.
     1837       rr = recid( X_cash-pay ).
     1838       run ref/cashpayi.w (
     1839                      input parparentproc
     1840                     ,input 'ПРОСМОТР':U
     1841                     ,input p-host-code
     1842                     ,input p-obj-type
     1843                     ,input p-obj-code
     1844                     , input-output rr ).
     1845   END.
     1846   ON CHOOSE OF B-mark IN FRAME d-cash-pay
     1847   DO:
     1848    define variable glog as logical no-undo .
     1849    if not available X_cash-pay then return no-apply.
     1850   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1851   define variable v-str-recid17 as character no-undo .
     1852   define variable v-num-entry17 as integer   no-undo .
     1853   assign
     1854     v-str-recid17 = trim( string( recid( X_cash-pay ) , "->>>>>>>>>>>9":U ) )
     1855     v-num-entry17 = lookup( v-str-recid17 , v-rid-list )
     1856   .
     1857   if v-num-entry17 > 0 then do:
     1858     assign
     1859       entry( v-num-entry17, v-rid-list ) = "":U
     1860       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1861     .
     1862   end.
     1863   else do:
     1864     assign
     1865       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid17
     1866     .
     1867   end.
     1868    glog = br-cashpay  :refresh( ) in frame d-cash-pay.
     1869     if not can-do ("MOUSE-SELECT-DBLCLICK,Return", last-event:function) then do:
     1870             glog = br-cashpay:select-next-row () in frame d-cash-pay.
     1871             apply "iteration-changed" to br-cashpay in frame d-cash-pay.
     1872     end.
     1873     if num-entries (v-rid-list) = 0 then
     1874         hide mark-num in frame d-cash-pay.
     1875     else
     1876     disp num-entries (v-rid-list) @ mark-num
     1877     with frame d-cash-pay.
     1878     apply "entry" to br-cashpay in frame d-cash-pay.
     1879   END.
     1880   ON CHOOSE OF b-print IN FRAME d-cash-pay
     1881   DO:
     1882   define variable sym1 as char init ":"   no-undo.
     1883   define variable sym2 as char init ":"   no-undo.
     1884   define variable sym3 as char init ":"   no-undo.
     1885   define variable sym4 as char init ":"   no-undo.
     1886   define variable sym5 as char init ":"   no-undo.
     1887   define variable sym6 as char init ":"   no-undo.
     1888   define variable Line                    as char         no-undo.
     1889   define variable ii      as integer   no-undo.
     1890   define variable StartRecid      as integer   no-undo.
     1891   DEFINE FRAME List
     1892   sym1 column-label ":" format "x(1)"
     1893   X_cash-pay.cdpay-code column-label "Код" format "9999"
     1894   sym2 column-label ":" format "x(1)"
     1895   X_cash-pay.obj-name column-label "Наименование" format "x(34)"
     1896   sym3 column-label ":" format "x(1)"
     1897   X_cash-pay.curr-code column-label "Валюта" format ">>>>>9"
     1898   sym4 column-label ":" format "x(1)"
     1899   X_cash-pay.pay-limit column-label "Предел" format "->>>,>>9.99"
     1900   X_cash-pay.atr1 COLUMN-LABEL "Сдача" FORMAT "  +/"
     1901   X_cash-pay.atr2 COLUMN-LABEL "Перевод" FORMAT "  +/"
     1902   X_cash-pay.atr4 COLUMN-LABEL "Слип" FORMAT " +/"
     1903   X_cash-pay.atr8 COLUMN-LABEL "Фактура" FORMAT "  +/"
     1904   X_cash-pay.atr16 COLUMN-LABEL "On-line" FORMAT "  +/"
     1905   X_cash-pay.atr32 COLUMN-LABEL "Обяз PIN" FORMAT "  +/"
     1906   sym6 column-label ":" format "x(1)"
     1907   HEADER
     1908   cur-time-print() AT 5 format "X(35)"
     1909   string( "Страница " + string( PAGE-NUMBER( PrnLibStream ) , ">>9") )
     1910   AT 86 format "X(15)" SKIP
     1911   Line format "x(110)" AT 1
     1912   with width 160 down use-text stream-io no-box .
     1913   if num-results( "br-cashpay" ) = 0 then  do:
     1914       message "Список  П У С Т !" skip view-as alert-box information .
     1915       return no-apply .
     1916   end.
     1917       if session:set-wait-state( "compiler" ) then .
     1918       Line = fill( "-" , 140 ) .
     1919       StartRecid = recid( X_cash-pay ) .
     1920   DO WHILE available X_cash-pay :
     1921       GET prev br-cashpay NO-LOCK .
     1922   END.
     1923   GET next br-cashpay NO-LOCK .
     1924   ii = 1 .
     1925   run prn-lib-open-stream  in this-procedure (
     1926                                               input parParentProc
     1927                                               ,input 62
     1928                                               ,input yes
     1929                                               ,input no
     1930                                               ).
     1931   FORM HEADER
     1932   Line format "X(130)" SKIP
     1933   "Продолжение - на следующей странице" AT 30 SKIP
     1934   with FRAME CliBottomFrame width 160 PAGE-BOTTOM NO-LABELS no-box.
     1935   VIEW stream PrnLibStream FRAME CliBottomFrame .
     1936   PUT stream PrnLibStream space(20)
     1937       "С П И С О К   К А С С О В Ы Х   Т И П О В   П Л А Т Е Ж Е Й" format "X(100)" SKIP(2) .
     1938   FORM with frame List .
     1939   DO WHILE available X_cash-pay :
     1940       DISPLAY stream PrnLibStream
     1941       sym1 X_cash-pay.cdpay-code
     1942       sym2 X_cash-pay.obj-name
     1943       sym3 X_cash-pay.curr-code
     1944       sym4 X_cash-pay.pay-limit
     1945       X_cash-pay.atr1
     1946       X_cash-pay.atr2
     1947       X_cash-pay.atr4
     1948       X_cash-pay.atr8
     1949       X_cash-pay.atr16
     1950       X_cash-pay.atr32
     1951       sym6    with frame List .
     1952       DOWN stream PrnLibStream 1 with frame List .
     1953       ii =  ii + 1 .
     1954       if ( ( ii modulo 10 ) = 0 ) AND ( ii >= 10 ) then
     1955         run waitfram-show in this-procedure ( "Просмотрено строк : " + string( ii ) ) .
     1956       GET next br-cashpay .
     1957   END.
     1958   PUT stream PrnLibStream Line format "X(110)" SKIP.
     1959   HIDE stream PrnLibStream FRAME CliBottomFrame .
     1960   output stream PrnLibStream close .
     1961   run prn-lib-prn-file in this-procedure (
     1962                                             input parParentProc
     1963                                             ,input 0
     1964                                             ).
     1965   reposition br-cashpay to recid StartRecid NO-ERROR .
     1966   run waitfram-hide in this-procedure .
     1967   END.
     1968   ON CHOOSE OF B-sch IN FRAME d-cash-pay
     1969   DO:
     1970     run proc-b-sch IN THIS-PROCEDURE NO-ERROR.
     1971     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1972   END.
     1973   ON CHOOSE OF b-sel IN FRAME d-cash-pay
     1974   DO:
     1975   define variable vss-include-info18 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1976   if lookup(self :type
     1977            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     1978            ) = 0
     1979   then do:
     1980     message
     1981       "$Workfile$"
     1982       "Указанному интерфейсному элементу фокус не может быть передан" skip
     1983       "Интерфейсный элемент" self :name  skip
     1984       "Тип" self :type  skip
     1985       "Процедура" this-procedure :file-name skip
     1986       view-as alert-box .
     1987   end.
     1988   else do:
     1989     apply "entry":u to self  .
     1990     if focus :handle <> self :handle  then do:
     1991       return no-apply .
     1992     end.
     1993   end.
     1994   END.
     1995   ON DEFAULT-ACTION OF br-cashpay IN FRAME d-cash-pay
     1996   DO:
     1997     case yes:
     1998         when  b-chg:sensitive THEN apply "CHOOSE":U to b-chg.
     1999     end case.
     2000   END.
     2001   ON MOUSE-SELECT-DBLCLICK OF br-cashpay IN FRAME d-cash-pay
     2002   DO:
     2003       if can-do( bttns, "b-sel" ) THEN do:
     2004         apply "choose" to b-sel in frame d-cash-pay .
     2005         return no-apply .
     2006       end.
     2007   END.
     2008   ON RETURN OF br-cashpay IN FRAME d-cash-pay
     2009   DO:
     2010       if can-do( bttns, "b-sel" ) THEN do:
     2011         apply "choose" to b-sel in frame d-cash-pay .
     2012         return no-apply .
     2013       end.
     2014       ELSE DO:
     2015         apply "DEFAULT-ACTION":U to self.
     2016       END.
     2017   END.
     2018   ON RETURN OF f-obj-name IN FRAME d-cash-pay
     2019   OR ctrl-J OF f-obj-name IN FRAME d-cash-pay DO:
     2020    DEFINE VARIABLE v-next AS LOGICAL NO-UNDO.
     2021    IF LAST-EVENT:LABEL = "CTRL-J" THEN DO:
     2022      v-next = YES.
     2023    END.
     2024     assign f-obj-name.
     2025     run proc-find in THIS-PROCEDURE ( INPUT v-next, input frame d-cash-pay f-obj-name) no-error.
     2026   END.
     2027   ON CHOOSE OF MENU-ITEM m_lookup-attr
     2028   DO:
     2029      assign
     2030     ATTR-option = 'ПРОСМОТР':U
     2031     .
     2032     APPLY "CHOOSE" TO b-attr IN FRAME d-cash-pay.
     2033   END.
     2034   ON CHOOSE OF MENU-ITEM m_lookup-disc
     2035   DO:
     2036     assign
     2037     dcpr-option = 'ПРОСМОТР':U
     2038     .
     2039     APPLY "CHOOSE" TO b-disc IN FRAME d-cash-pay.
     2040   END.
     2041   ON CHOOSE OF MENU-ITEM m_update-attr
     2042   DO:
     2043     assign
     2044     ATTR-option = 'ИЗМЕНЕНИЕ':U
     2045     .
     2046     APPLY "CHOOSE" TO b-attr IN FRAME d-cash-pay.
     2047   END.
     2048   ON CHOOSE OF MENU-ITEM m_update-disc
     2049   DO:
     2050     assign
     2051     dcpr-option = 'ИЗМЕНЕНИЕ':U
     2052     .
     2053     APPLY "CHOOSE" TO b-disc IN FRAME d-cash-pay.
     2054   END.
     2055   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME d-cash-pay:PARENT eq ?
     2056   THEN FRAME d-cash-pay:PARENT = ACTIVE-WINDOW.
     2057   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2058   on help of frame d-cash-pay
     2059   do:
     2060     run gbl/app_help.p
     2061       (input this-procedure :file-name
     2062       ,input ''
     2063       ,input ?
     2064       ) no-error.
     2065     if error-status :error then do:
     2066       message
     2067         "Ошибка при вызове помощи"
     2068         error-status :get-message(1)
     2069         view-as alert-box .
     2070     end.
     2071   end.
     2072   run minbtn-set in this-procedure .
     2073   on choose of b-help in frame d-cash-pay
     2074   do:
     2075     apply "help":u to frame d-cash-pay .
     2076   end.
     2077   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2078   procedure minbtn-set :
     2079       do
     2080           on error undo, return error return-value
     2081           :
     2082           define variable ii              as integer       no-undo .
     2083           define variable fh              as widget-handle no-undo .
     2084           define variable hh              as widget-handle no-undo .
     2085           define variable v-h             as handle        extent 4 no-undo .
     2086           define variable v-name-button   as character     no-undo .
     2087           define variable v-help-old-x    as decimal       no-undo .
     2088           define variable v-help-old-y    as decimal       no-undo .
     2089           define variable v-help-old-size as decimal       no-undo .
     2090           define variable v-frame-width   as decimal       no-undo .
     2091           define variable jj              as integer       no-undo .
     2092           do
     2093               on error undo, return error
     2094               :
     2095               assign
     2096                   v-frame-width = frame d-cash-pay:width - 0.3
     2097                   fh            = frame d-cash-pay:first-child
     2098                   hh            = fh:first-child
     2099                   ii            = 1
     2100                   .
     2101               do while valid-handle(hh):
     2102                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     2103                   do:
     2104                       case lc(hh:name) :
     2105                           when "b-help" then
     2106                               do:
     2107                                   hh:load-image-up("cmp/b-help.bmp":u) .
     2108                                   hh:load-image-down("cmp/b-help.bmp":u) .
     2109                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     2110                                   hh:TOOLTIP = "Помощь" .
     2111                                   v-help-old-x = hh:column .
     2112                                   v-help-old-y = hh:row    .
     2113                                   v-help-old-size = hh:width .
     2114                                   hh:width-chars = 2.5 .
     2115                               end.
     2116                           when "b-print" then
     2117                               do:
     2118                                   hh:load-image("cmp/b-print.bmp":u) .
     2119                                   hh:TOOLTIP = "Печать" .
     2120                                   v-h[ii] = hh:handle .
     2121                                   ii = ii + 1 .
     2122                                   hh:width-chars = 3 .
     2123                               end.
     2124                           when "b-history" or
     2125                           when "b-hist" then
     2126                               do:
     2127                                   hh:load-image("cmp/b-hist.bmp":u) .
     2128                                   hh:TOOLTIP = "История" .
     2129                                   v-h[ii] = hh:handle .
     2130                                   ii = ii + 1 .
     2131                                   hh:width-chars = 3 .
     2132                               end.
     2133                           when "b-sch" then
     2134                               do:
     2135                                   hh:load-image("cmp/b-sch.bmp":u) .
     2136                                   hh:TOOLTIP = "Установка Фильтра" .
     2137                                   v-h[ii] = hh:handle .
     2138                                   ii = ii + 1 .
     2139                                   hh:width-chars = 3 .
     2140                               end.
     2141                           when "b-hist-user" then
     2142                               do:
     2143                                   hh:load-image("cmp/b-hist.bmp":u) .
     2144                                   hh:TOOLTIP = "История пользователя" .
     2145                                   ii = ii + 1 .
     2146                               end.
     2147                       end case.
     2148                   end.
     2149                   hh = hh:next-sibling.
     2150               end.
     2151               b-help:column = v-frame-width - b-help:width-chars.
     2152               jj = 0.
     2153               repeat ii = 4 to 1 by -1 :
     2154                   if valid-handle (v-h[ii] ) then
     2155                   do:
     2156                       jj  = jj + 1 .
     2157                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     2158                       v-h[ii]:row    = v-help-old-y .
     2159                   end.
     2160               end.
     2161           end.
     2162       end.
     2163   end procedure.
     2164   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     2165   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     2166   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     2167   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     2168   define variable v-diasize-current-frame-width  as decimal   no-undo .
     2169   define variable v-diasize-current-frame-height as decimal   no-undo .
     2170   define variable v-diasize-change-size          as logical   no-undo .
     2171   define variable v-diasize-resize-button        as handle    no-undo .
     2172   define variable v-diasize-wndmax               as logical   no-undo .
     2173   define variable v-diasize-wndstore             as logical   no-undo .
     2174   define variable v-diasize-proc-name            as character no-undo .
     2175   define variable v-diasize-browse-handle        as handle    no-undo .
     2176   define variable v-diasize-browse-number        as integer   no-undo .
     2177   define variable v-diasize-need-full-display    as logical   no-undo init false .
     2178   define temp-table temp-diasize-handle no-undo
     2179     field handle-value  as handle
     2180     field save-position as decimal
     2181     index xpk is primary unique handle-value
     2182     .
     2183   define temp-table temp-browse-handle no-undo
     2184     field browse-type   as character
     2185     field browse-number as integer
     2186     field browse-handle as handle
     2187     field original-size as decimal
     2188     index xpk is primary unique browse-type browse-number
     2189     index xie browse-type browse-handle
     2190   .
     2191   procedure diasize_change-height :
     2192     define input  parameter p-change-value  as decimal   no-undo .
     2193     define input  parameter p-move-resize   as logical   no-undo .
     2194     define variable v-field-group-handle    as handle    no-undo .
     2195     define variable v-object-handle         as handle    no-undo .
     2196     define variable v-frame-height          as decimal   no-undo .
     2197     define variable v-frame-virtual-height  as decimal   no-undo .
     2198     define variable v-browse-height         as decimal   no-undo .
     2199     define variable v-window-height         as decimal   no-undo .
     2200     define variable v-window-virtual-height as decimal   no-undo .
     2201     define variable v-change-sign           as integer   no-undo .
     2202     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2203     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2204     if p-change-value > 0
     2205     then do:
     2206       if frame d-cash-pay :height + p-change-value
     2207           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     2208       then do:
     2209         assign
     2210           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     2211                           - (frame d-cash-pay :height-chars)
     2212         .
     2213         if p-change-value <= 0
     2214         then do:
     2215           run diasize_position-resize-button in this-procedure .
     2216           return .
     2217         end.
     2218       end.
     2219     end.
     2220     if p-change-value < 0
     2221     then do:
     2222       if frame d-cash-pay :height + p-change-value < v-diasize-orig-frame-height
     2223       then do:
     2224         assign
     2225           p-change-value = v-diasize-orig-frame-height
     2226                          - (frame d-cash-pay :height-chars)
     2227         .
     2228         if p-change-value >= 0
     2229         then do:
     2230           run diasize_position-resize-button in this-procedure .
     2231           return .
     2232         end.
     2233       end.
     2234     end.
     2235     if p-change-value >= 0
     2236     then do:
     2237       assign
     2238         v-change-sign = 1
     2239       .
     2240     end.
     2241     else do:
     2242       assign
     2243         v-change-sign = -1
     2244       .
     2245     end.
     2246     assign
     2247       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2248     .
     2249     if p-change-value = 0
     2250     then do:
     2251       run diasize_position-resize-button in this-procedure .
     2252       return .
     2253     end.
     2254     move_block:
     2255     do
     2256     on error undo move_block, retry move_block
     2257     :
     2258       if retry
     2259       then do:
     2260         do
     2261         on error undo move_block, leave move_block
     2262         :
     2263           if p-change-value > 0
     2264           then do:
     2265             for each buf_temp-diasize-handle
     2266             on error undo, next
     2267             :
     2268               assign
     2269                 v-object-handle = buf_temp-diasize-handle.handle-value
     2270               .
     2271               if v-object-handle <> v-diasize-resize-button
     2272               then do:
     2273                 assign
     2274                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2275                 .
     2276               end.
     2277             end.
     2278             assign
     2279               v-diasize-browse-handle :height = v-browse-height
     2280             .
     2281             for each buf_temp-browse-handle
     2282               where buf_temp-browse-handle.browse-type = 'height':u
     2283             on error undo, next
     2284             :
     2285               assign
     2286                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2287               .
     2288             end.
     2289             assign
     2290               frame d-cash-pay :height = v-frame-height
     2291             .
     2292             if frame d-cash-pay :scrollable = true
     2293             then do:
     2294               assign
     2295                 frame d-cash-pay :virtual-height = v-frame-virtual-height
     2296               .
     2297             end.
     2298             run diasize_position-resize-button in this-procedure .
     2299           end.
     2300           else do:
     2301             if frame d-cash-pay :scrollable = true
     2302             then do:
     2303               assign
     2304                 frame d-cash-pay :virtual-height = v-frame-virtual-height
     2305               .
     2306             end.
     2307             assign
     2308               frame d-cash-pay :height = v-frame-height
     2309             .
     2310             assign
     2311               v-diasize-browse-handle :height = v-browse-height
     2312             .
     2313             for each buf_temp-browse-handle
     2314               where buf_temp-browse-handle.browse-type = 'height':u
     2315             on error undo, next
     2316             :
     2317               assign
     2318                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2319               .
     2320             end.
     2321             for each buf_temp-diasize-handle
     2322             on error undo, next
     2323             :
     2324               assign
     2325                 v-object-handle = buf_temp-diasize-handle.handle-value
     2326               .
     2327               if v-object-handle <> v-diasize-resize-button
     2328               then do:
     2329                 assign
     2330                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2331                 .
     2332               end.
     2333             end.
     2334             run diasize_position-resize-button in this-procedure .
     2335           end.
     2336           assign
     2337             v-diasize-change-size = false
     2338           .
     2339           leave move_block .
     2340         end.
     2341       end.
     2342       assign
     2343         v-diasize-need-full-display = true
     2344       .
     2345       if v-diasize-change-size = false
     2346       then do:
     2347         assign
     2348           v-diasize-change-size = true
     2349         .
     2350       end.
     2351       else do:
     2352         return .
     2353       end.
     2354       assign
     2355         v-frame-height = frame d-cash-pay :height
     2356         v-frame-virtual-height = frame d-cash-pay :virtual-height
     2357         v-browse-height = v-diasize-browse-handle :height
     2358       .
     2359       for each buf_temp-browse-handle
     2360         where buf_temp-browse-handle.browse-type = 'height':u
     2361       :
     2362         assign
     2363           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     2364         .
     2365       end.
     2366       for each buf_temp-diasize-handle
     2367       :
     2368         delete buf_temp-diasize-handle .
     2369       end.
     2370       assign
     2371         v-field-group-handle = frame d-cash-pay :first-child
     2372       .
     2373       do while valid-handle(v-field-group-handle)
     2374       :
     2375         assign
     2376           v-object-handle = v-field-group-handle :first-child
     2377         .
     2378         do while valid-handle(v-object-handle)
     2379         :
     2380           if  v-object-handle <> v-diasize-browse-handle :handle
     2381           and can-query(v-object-handle, "row")
     2382           and can-query(v-object-handle, "height")
     2383           and ( v-object-handle :row > v-diasize-browse-handle :row )
     2384           then do:
     2385             find first buf_temp-browse-handle
     2386               where buf_temp-browse-handle.browse-type   = 'height':u
     2387                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2388               no-error .
     2389             if available buf_temp-browse-handle
     2390             then do:
     2391             end.
     2392             else do:
     2393               create buf_temp-diasize-handle .
     2394               assign
     2395                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2396                 buf_temp-diasize-handle.save-position = v-object-handle :row
     2397               .
     2398             end.
     2399           end.
     2400           assign
     2401             v-object-handle = v-object-handle :next-sibling
     2402           .
     2403         end.
     2404         assign
     2405           v-field-group-handle = v-field-group-handle :next-sibling
     2406         .
     2407       end.
     2408       do with frame d-cash-pay
     2409       :
     2410         hide v-diasize-resize-button .
     2411         assign
     2412           v-diasize-resize-button :row    = 1
     2413           v-diasize-resize-button :column = 1
     2414         .
     2415       end.
     2416       if p-change-value > 0
     2417       then do:
     2418         if frame d-cash-pay :scrollable = true
     2419         then do:
     2420           assign
     2421             frame d-cash-pay :virtual-height = frame d-cash-pay :virtual-height + p-change-value
     2422             no-error .
     2423           if error-status :error
     2424           or error-status :get-message(1) <> ""
     2425           then do:
     2426             undo move_block, retry move_block .
     2427           end.
     2428         end.
     2429         assign
     2430           frame d-cash-pay :height = frame d-cash-pay :height + p-change-value
     2431           no-error .
     2432         if error-status :error
     2433         or error-status :get-message(1) <> ""
     2434         then do:
     2435           undo move_block, retry move_block .
     2436         end.
     2437         assign
     2438           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2439           no-error .
     2440         if error-status :error
     2441         or error-status :get-message(1) <> ""
     2442         then do:
     2443           undo move_block, retry move_block .
     2444         end.
     2445         for each buf_temp-browse-handle
     2446           where buf_temp-browse-handle.browse-type = 'height':u
     2447         on error undo move_block, retry move_block
     2448         :
     2449           assign
     2450             buf_temp-browse-handle.browse-handle :height
     2451               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2452             no-error .
     2453           if error-status :error
     2454           or error-status :get-message(1) <> ""
     2455           then do:
     2456             undo move_block, retry move_block .
     2457           end.
     2458         end.
     2459         for each buf_temp-diasize-handle
     2460         on error undo move_block, retry move_block
     2461         :
     2462           assign
     2463             v-object-handle = buf_temp-diasize-handle.handle-value
     2464           .
     2465           if v-object-handle <> v-diasize-resize-button
     2466           then do:
     2467             assign
     2468               v-object-handle :row = v-object-handle :row + p-change-value
     2469               no-error .
     2470             if error-status :error
     2471             or error-status :get-message(1) <> ""
     2472             then do:
     2473               undo move_block, retry move_block .
     2474             end.
     2475           end.
     2476         end.
     2477       end.
     2478       else do:
     2479         for each buf_temp-diasize-handle
     2480         on error undo move_block, retry move_block
     2481         :
     2482           assign
     2483             v-object-handle = buf_temp-diasize-handle.handle-value
     2484           .
     2485           if v-object-handle <> v-diasize-resize-button
     2486           then do:
     2487             assign
     2488               v-object-handle :row = v-object-handle :row + p-change-value
     2489               no-error .
     2490             if error-status :error
     2491             or error-status :get-message(1) <> ""
     2492             then do:
     2493               undo move_block, retry move_block .
     2494             end.
     2495           end.
     2496         end.
     2497         assign
     2498           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2499           no-error .
     2500         if error-status :error
     2501         or error-status :get-message(1) <> ""
     2502         then do:
     2503           undo move_block, retry move_block .
     2504         end.
     2505         for each buf_temp-browse-handle
     2506           where buf_temp-browse-handle.browse-type = 'height':u
     2507         on error undo move_block, retry move_block
     2508         :
     2509           assign
     2510             buf_temp-browse-handle.browse-handle :height
     2511               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2512             no-error .
     2513           if error-status :error
     2514           or error-status :get-message(1) <> ""
     2515           then do:
     2516             undo move_block, retry move_block .
     2517           end.
     2518         end.
     2519         assign
     2520           frame d-cash-pay :height = frame d-cash-pay :height + p-change-value
     2521           no-error .
     2522         if error-status :error
     2523         or error-status :get-message(1) <> ""
     2524         then do:
     2525           undo move_block, retry move_block .
     2526         end.
     2527         if frame d-cash-pay :scrollable = true
     2528         then do:
     2529           assign
     2530             frame d-cash-pay :virtual-height = frame d-cash-pay :virtual-height + p-change-value
     2531             no-error .
     2532           if error-status :error
     2533           or error-status :get-message(1) <> ""
     2534           then do:
     2535             undo move_block, retry move_block .
     2536           end.
     2537         end.
     2538       end.
     2539       if p-move-resize = true
     2540       then do:
     2541         run diasize_position-resize-button in this-procedure .
     2542       end.
     2543       if v-diasize-wndstore = true
     2544       then do:
     2545         if connected("ub") = true
     2546         then do:
     2547           define variable v-cntxt-db-num        as integer   no-undo .
     2548           define variable v-cntxt-userid        as character no-undo .
     2549           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2550                                             , OUTPUT v-cntxt-userid
     2551                                             ) .
     2552           run gbl/wndsizew.p
     2553             (input  v-cntxt-db-num
     2554             ,input  v-cntxt-userid
     2555             ,input  v-diasize-proc-name
     2556             ,input  'height':u
     2557             ,input  string(frame d-cash-pay :height - v-diasize-orig-frame-height)
     2558             ) .
     2559         end.
     2560       end.
     2561     end.
     2562     assign
     2563       v-diasize-change-size = false
     2564     .
     2565   end procedure.
     2566   procedure diasize_set-height :
     2567     define input  parameter p-new-height  as decimal   no-undo .
     2568     define input  parameter p-move-resize as logical   no-undo .
     2569     do
     2570     on error undo, return error return-value
     2571     :
     2572       run diasize_change-height in this-procedure
     2573         (input  (p-new-height - frame d-cash-pay :height)
     2574         ,input  p-move-resize
     2575         ) .
     2576     end.
     2577   end procedure.
     2578   procedure diasize_change-width :
     2579     define input  parameter p-change-value as decimal   no-undo .
     2580     define input  parameter p-move-resize  as logical   no-undo .
     2581     define variable v-field-group-handle   as handle    no-undo .
     2582     define variable v-object-handle        as handle    no-undo .
     2583     define variable v-frame-width          as decimal   no-undo .
     2584     define variable v-frame-virtual-width  as decimal   no-undo .
     2585     define variable v-browse-width         as decimal   no-undo .
     2586     define variable v-window-width         as decimal   no-undo .
     2587     define variable v-window-virtual-width as decimal   no-undo .
     2588     define variable v-change-sign          as integer   no-undo .
     2589     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2590     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2591     if p-change-value > 0
     2592     then do:
     2593       if frame d-cash-pay :width + p-change-value >
     2594           session :width-chars
     2595       then do:
     2596         assign
     2597           p-change-value = session :width-chars - frame d-cash-pay :width
     2598         .
     2599         if p-change-value <= 0
     2600         then do:
     2601           run diasize_position-resize-button in this-procedure .
     2602           return .
     2603         end.
     2604       end.
     2605     end.
     2606     if p-change-value < 0
     2607     then do:
     2608       if frame d-cash-pay :width + p-change-value < v-diasize-orig-frame-width
     2609       then do:
     2610         assign
     2611           p-change-value = v-diasize-orig-frame-width
     2612                          - frame d-cash-pay :width
     2613         .
     2614         if p-change-value >= 0
     2615         then do:
     2616           run diasize_position-resize-button in this-procedure .
     2617           return .
     2618         end.
     2619       end.
     2620     end.
     2621     if p-change-value >= 0
     2622     then do:
     2623       assign
     2624         v-change-sign = 1
     2625       .
     2626     end.
     2627     else do:
     2628       assign
     2629         v-change-sign = -1
     2630       .
     2631     end.
     2632     assign
     2633       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2634     .
     2635     if p-change-value = 0
     2636     then do:
     2637       run diasize_position-resize-button in this-procedure .
     2638       return .
     2639     end.
     2640     move_block:
     2641     do
     2642     on error undo move_block, leave move_block
     2643     :
     2644       if retry
     2645       then do:
     2646         do
     2647         on error undo move_block, leave move_block
     2648         :
     2649           if p-change-value > 0
     2650           then do:
     2651             for each buf_temp-diasize-handle
     2652             on error undo, next
     2653             :
     2654               assign
     2655                 v-object-handle = buf_temp-diasize-handle.handle-value
     2656               .
     2657               if v-object-handle <> v-diasize-resize-button
     2658               then do:
     2659                 assign
     2660                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2661                 .
     2662               end.
     2663             end.
     2664             assign
     2665               v-diasize-browse-handle :width = v-browse-width
     2666             .
     2667             for each buf_temp-browse-handle
     2668               where buf_temp-browse-handle.browse-type = 'width':u
     2669             on error undo, next
     2670             :
     2671               assign
     2672                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2673               .
     2674             end.
     2675             assign
     2676               frame d-cash-pay :width = v-frame-width
     2677             .
     2678             if frame d-cash-pay :scrollable = true
     2679             then do:
     2680               assign
     2681                 frame d-cash-pay :virtual-width = v-frame-virtual-width
     2682               .
     2683             end.
     2684             run diasize_position-resize-button in this-procedure .
     2685           end.
     2686           else do:
     2687             if frame d-cash-pay :scrollable = true
     2688             then do:
     2689               assign
     2690                 frame d-cash-pay :virtual-width = v-frame-virtual-width
     2691               .
     2692             end.
     2693             assign
     2694               frame d-cash-pay :width = v-frame-width
     2695             .
     2696             for each buf_temp-browse-handle
     2697               where buf_temp-browse-handle.browse-type = 'width':u
     2698             on error undo, next
     2699             :
     2700               assign
     2701                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2702               .
     2703             end.
     2704             assign
     2705               v-diasize-browse-handle :width = v-browse-width
     2706             .
     2707             for each buf_temp-diasize-handle
     2708             on error undo, next
     2709             :
     2710               assign
     2711                 v-object-handle = buf_temp-diasize-handle.handle-value
     2712               .
     2713               if v-object-handle <> v-diasize-resize-button
     2714               then do:
     2715                 assign
     2716                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2717                 .
     2718               end.
     2719             end.
     2720             run diasize_position-resize-button in this-procedure .
     2721           end.
     2722           assign
     2723             v-diasize-change-size = false
     2724           .
     2725           leave move_block .
     2726         end.
     2727       end.
     2728       assign
     2729         v-diasize-need-full-display = true
     2730       .
     2731       if v-diasize-change-size = false
     2732       then do:
     2733         assign
     2734           v-diasize-change-size = true
     2735         .
     2736       end.
     2737       else do:
     2738         return .
     2739       end.
     2740       assign
     2741         v-frame-width = frame d-cash-pay :width
     2742         v-frame-virtual-width = frame d-cash-pay :virtual-width
     2743         v-browse-width = v-diasize-browse-handle :width
     2744       .
     2745       for each buf_temp-browse-handle
     2746         where buf_temp-browse-handle.browse-type = 'width':u
     2747       :
     2748         assign
     2749           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2750         .
     2751       end.
     2752       for each buf_temp-diasize-handle
     2753       :
     2754         delete buf_temp-diasize-handle .
     2755       end.
     2756       assign
     2757         v-field-group-handle = frame d-cash-pay :first-child
     2758       .
     2759       do while valid-handle(v-field-group-handle)
     2760       :
     2761         assign
     2762           v-object-handle = v-field-group-handle :first-child
     2763         .
     2764         do while valid-handle(v-object-handle)
     2765         :
     2766           if  v-object-handle <> v-diasize-browse-handle :handle
     2767           and v-object-handle <> v-diasize-resize-button
     2768           and can-query(v-object-handle, "row")
     2769           and can-query(v-object-handle, "height")
     2770           and ( v-object-handle :col + v-object-handle :width
     2771                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2772               )
     2773           then do:
     2774             find first buf_temp-browse-handle
     2775               where buf_temp-browse-handle.browse-type   = 'width':u
     2776                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2777               no-error .
     2778             if available buf_temp-browse-handle
     2779             then do:
     2780             end.
     2781             else do:
     2782               create buf_temp-diasize-handle .
     2783               assign
     2784                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2785                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2786               .
     2787             end.
     2788           end.
     2789           assign
     2790             v-object-handle = v-object-handle :next-sibling
     2791           .
     2792         end.
     2793         assign
     2794           v-field-group-handle = v-field-group-handle :next-sibling
     2795         .
     2796       end.
     2797       do with frame d-cash-pay
     2798       :
     2799         hide v-diasize-resize-button .
     2800         v-diasize-resize-button :row = 1.
     2801         v-diasize-resize-button :column = 1.
     2802       end.
     2803       if p-change-value > 0
     2804       then do:
     2805         if frame d-cash-pay :scrollable = true
     2806         then do:
     2807           assign
     2808             frame d-cash-pay :virtual-width = frame d-cash-pay :virtual-width + p-change-value
     2809             no-error .
     2810           if error-status :error
     2811           or error-status :get-message(1) <> ""
     2812           then do:
     2813             undo move_block, retry move_block.
     2814           end.
     2815         end.
     2816         assign
     2817           frame d-cash-pay :width = v-frame-width + p-change-value
     2818           no-error .
     2819         if error-status :error
     2820         or error-status :get-message(1) <> ""
     2821         then do:
     2822           undo move_block, retry move_block.
     2823         end.
     2824         assign
     2825           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2826         no-error .
     2827         if error-status :error
     2828         or error-status :get-message(1) <> ""
     2829         then do:
     2830           undo move_block, retry move_block.
     2831         end.
     2832         for each buf_temp-browse-handle
     2833           where buf_temp-browse-handle.browse-type = 'width':u
     2834         on error undo move_block, retry move_block
     2835         :
     2836           assign
     2837             buf_temp-browse-handle.browse-handle :width
     2838               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2839             no-error .
     2840           if error-status :error
     2841           or error-status :get-message(1) <> ""
     2842           then do:
     2843             undo move_block, retry move_block .
     2844           end.
     2845         end.
     2846         for each buf_temp-diasize-handle
     2847         on error undo move_block, retry move_block
     2848         :
     2849           assign
     2850             v-object-handle = buf_temp-diasize-handle.handle-value
     2851           .
     2852           if v-object-handle <> v-diasize-resize-button
     2853           then do:
     2854             assign
     2855               v-object-handle :col = v-object-handle :col + p-change-value
     2856               no-error .
     2857             if error-status :error
     2858             or error-status :get-message(1) <> ""
     2859             then do:
     2860               undo move_block, retry move_block .
     2861             end.
     2862           end.
     2863         end.
     2864       end.
     2865       else do:
     2866         for each buf_temp-diasize-handle
     2867         on error undo move_block, retry move_block
     2868         :
     2869           assign
     2870             v-object-handle = buf_temp-diasize-handle.handle-value
     2871           .
     2872           if v-object-handle <> v-diasize-resize-button
     2873           then do:
     2874             assign
     2875               v-object-handle :col = v-object-handle :col + p-change-value
     2876               no-error .
     2877             if error-status :error
     2878             or error-status :get-message(1) <> ""
     2879             then do:
     2880               undo move_block, retry move_block .
     2881             end.
     2882           end.
     2883         end.
     2884         for each buf_temp-browse-handle
     2885           where buf_temp-browse-handle.browse-type = 'width':u
     2886         on error undo move_block, retry move_block
     2887         :
     2888           assign
     2889             buf_temp-browse-handle.browse-handle :width
     2890               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2891             no-error .
     2892           if error-status :error
     2893           or error-status :get-message(1) <> ""
     2894           then do:
     2895             undo move_block, retry move_block .
     2896           end.
     2897         end.
     2898         assign
     2899           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2900           no-error .
     2901         if error-status :error
     2902         or error-status :get-message(1) <> ""
     2903         then do:
     2904           undo move_block, retry move_block.
     2905         end.
     2906         assign
     2907           frame d-cash-pay :width = frame d-cash-pay :width + p-change-value
     2908         no-error .
     2909         if error-status :error
     2910         or error-status :get-message(1) <> ""
     2911         then do:
     2912           undo move_block, retry move_block.
     2913         end.
     2914         if frame d-cash-pay :scrollable = true
     2915         then do:
     2916           assign
     2917             frame d-cash-pay :virtual-width = frame d-cash-pay :virtual-width + p-change-value
     2918           no-error .
     2919           if error-status :error
     2920           or error-status :get-message(1) <> ""
     2921           then do:
     2922             undo move_block, retry move_block.
     2923           end.
     2924         end.
     2925       end.
     2926       if p-move-resize
     2927       then do:
     2928         run diasize_position-resize-button in this-procedure .
     2929       end.
     2930       if v-diasize-wndstore = true
     2931       then do:
     2932         if connected("ub") = true
     2933         then do:
     2934           define variable v-cntxt-db-num        as integer   no-undo .
     2935           define variable v-cntxt-userid        as character no-undo .
     2936           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2937                                             , OUTPUT v-cntxt-userid
     2938                                             ) .
     2939           run gbl/wndsizew.p
     2940             (input  v-cntxt-db-num
     2941             ,input  v-cntxt-userid
     2942             ,input  v-diasize-proc-name
     2943             ,input  'width':u
     2944             ,input  string(frame d-cash-pay :width - v-diasize-orig-frame-width)
     2945             ) .
     2946         end.
     2947       end.
     2948     end.
     2949     assign
     2950       v-diasize-change-size = false
     2951     .
     2952   end procedure.
     2953   procedure diasize_set-width :
     2954     define input  parameter p-new-width  as decimal   no-undo .
     2955     define input  parameter p-move-resize as logical   no-undo .
     2956     do
     2957     on error undo, return error return-value
     2958     :
     2959       run diasize_change-width in this-procedure
     2960         (input  (p-new-width - frame d-cash-pay :width)
     2961         ,input  p-move-resize
     2962         ) .
     2963     end.
     2964   end procedure.
     2965   procedure diasize_position-resize-button :
     2966     do with frame d-cash-pay
     2967     :
     2968       hide v-diasize-resize-button .
     2969       assign
     2970         v-diasize-resize-button :row = frame d-cash-pay :height - v-diasize-resize-button :height
     2971                     - 1
     2972                     - (frame d-cash-pay :border-bottom-pixels / session :pixels-per-row)
     2973         v-diasize-resize-button :col = frame d-cash-pay :width - v-diasize-resize-button :width
     2974                     - 1
     2975                     - (frame d-cash-pay :border-right-pixels / session :pixels-per-column)
     2976       .
     2977       view v-diasize-resize-button .
     2978     end.
     2979   end procedure.
     2980   on alt-right anywhere
     2981   do:
     2982     run diasize_change-width in this-procedure
     2983       (input 1
     2984       ,input true
     2985       ) .
     2986     return no-apply .
     2987   end.
     2988   on alt-left anywhere
     2989   do:
     2990     run diasize_change-width in this-procedure
     2991       (input -1
     2992       ,input true
     2993       ) .
     2994     return no-apply .
     2995   end.
     2996   on alt-down anywhere
     2997   do:
     2998     run diasize_change-height in this-procedure
     2999       (input 1
     3000       ,input true
     3001       ) .
     3002     return no-apply .
     3003   end.
     3004   on alt-up anywhere
     3005   do:
     3006     run diasize_change-height in this-procedure
     3007       (input -1
     3008       ,input true
     3009       ) .
     3010     return no-apply .
     3011   end.
     3012   on alt-enter of frame d-cash-pay
     3013   do:
     3014     run diasize_maximize in this-procedure
     3015       (input  ?
     3016       ).
     3017     return no-apply .
     3018   end.
     3019   procedure diasize_end-move :
     3020     do
     3021     on error undo, return error return-value
     3022     :
     3023       define variable v-row-delta as decimal   no-undo .
     3024       define variable v-col-delta as decimal   no-undo .
     3025       define variable v-new-row as decimal   no-undo .
     3026       define variable v-new-col as decimal   no-undo .
     3027       assign
     3028         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     3029         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     3030       .
     3031       assign
     3032         v-row-delta = v-new-row - frame d-cash-pay :height
     3033         v-col-delta = v-new-col - frame d-cash-pay :width
     3034       .
     3035       run diasize_change-height in this-procedure
     3036         (input v-row-delta
     3037         ,input true
     3038         ) .
     3039       run diasize_change-width in this-procedure
     3040         (input v-col-delta
     3041         ,input true
     3042         ) .
     3043     end.
     3044   end procedure.
     3045   procedure diasize_maximize :
     3046     define input  parameter p-action as logical   no-undo .
     3047     do
     3048     on error undo, return error return-value
     3049     :
     3050       if p-action = ?
     3051       then do:
     3052         if v-diasize-need-maximize = true
     3053         then do:
     3054           assign
     3055             p-action = true
     3056           .
     3057         end.
     3058         else do:
     3059           assign
     3060             p-action = false
     3061           .
     3062         end.
     3063       end.
     3064       if p-action = true
     3065       then do:
     3066         run diasize_change-height in this-procedure
     3067           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     3068               - frame d-cash-pay :height-chars
     3069           ,input true
     3070           ) .
     3071         run diasize_change-width in this-procedure
     3072           (input session :width-chars
     3073               - frame d-cash-pay :width-chars
     3074           ,input true
     3075           ) .
     3076         assign
     3077           v-diasize-need-maximize = false
     3078         .
     3079       end.
     3080       else do:
     3081         run diasize_change-width in this-procedure
     3082           (input v-diasize-orig-frame-width
     3083               - frame d-cash-pay :width-chars
     3084           ,input true
     3085           ) .
     3086         run diasize_change-height in this-procedure
     3087           (input v-diasize-orig-frame-height
     3088               - frame d-cash-pay :height-chars
     3089           ,input true
     3090           ) .
     3091         assign
     3092           v-diasize-need-maximize = true
     3093         .
     3094       end.
     3095     end.
     3096   end procedure.
     3097   procedure diasize_restore-orig-size :
     3098     do
     3099     on error undo, return error return-value
     3100     :
     3101       assign
     3102         v-diasize-current-frame-width  = frame d-cash-pay :width
     3103         v-diasize-current-frame-height = frame d-cash-pay :height
     3104       .
     3105       run diasize_set-height in this-procedure
     3106         (input  v-diasize-orig-frame-height
     3107         ,input  true
     3108         ) .
     3109       run diasize_set-width in this-procedure
     3110         (input  v-diasize-orig-frame-width
     3111         ,input  true
     3112         ) .
     3113     end.
     3114   end procedure.
     3115   procedure diasize_restore-current-size :
     3116     do
     3117     on error undo, return error return-value
     3118     :
     3119       run diasize_set-height in this-procedure
     3120         (input  v-diasize-current-frame-height
     3121         ,input  true
     3122         ) .
     3123       run diasize_set-width in this-procedure
     3124         (input  v-diasize-current-frame-width
     3125         ,input  true
     3126         ) .
