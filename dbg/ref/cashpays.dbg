     1115   procedure prn-lib-prn-file :
     1116     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1117     define input parameter p-DIsabledoptions as integer no-undo .
     1118     define variable v-report-name as character no-undo .
     1119     define variable v-user-action as character no-undo .
     1120     define variable v-printed     as logical   no-undo .
     1121     define variable v-exist       as logical   no-undo .
     1122     do
     1123       on error undo, return error
     1124       :
     1125       run prn-lib-get-report-name  in this-procedure (
     1126         input parParentProc
     1127         ,output v-report-name
     1128         ).
     1129   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1130   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
     1131     (input  v-report-name
     1132     ,input  2
     1133     ,output v-exist
     1134     )  .
     1135       if NOT v-exist then
     1136       DO:
     1137         Message
     1138           "Нет заданий на печать ! "
     1139           view-as alert-box .
     1140         Return  .
     1141       End.
     1142       run gbl/prnfilen.w
     1143         (input  ""
     1144         ,input  p-DisabledOptions
     1145         ,input  string(v-report-name )
     1146         ,input  7
     1147         ,output v-user-action
     1148         ,output v-printed
     1149         ) .
     1150       if v-printed then
     1151       do:
     1152         return "YES" .
     1153       end.
     1154       else
     1155       do:
     1156         return "NO" .
     1157       end.
     1158     end.
