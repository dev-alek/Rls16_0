      120   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      121   define new shared variable PrintCopiesCounter as integer   no-undo initial 1 .
      122   define new shared variable RepPathName        as character no-undo .
      123   define new shared variable PrintRubl          as logical   no-undo .
      124   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      125   procedure cur-time :
      126      define output parameter p-today as date      no-undo .
      127      define output parameter p-time  as integer   no-undo .
      128     do
      129     on error undo, return error
      130     :
      131       define variable v-date1 as date      no-undo .
      132       define variable v-date2 as date      no-undo .
      133       define variable v-time  as integer   no-undo .
      134       assign
      135         v-date1 = today
      136         v-time  = time
      137         v-date2 = today
      138       .
      139       if v-date1 <> v-date2
      140       then do:
      141         assign
      142           v-date1 = today
      143           v-time  = v-time
      144         .
      145       end.
      146       assign
      147         p-today = v-date1
      148         p-time  = v-time
      149       .
      150     end.
      151   end.
      152   function cur-time-date returns character
      153   :
      154     return string(today, '99/99/9999':U) .
      155   end.
      156   function cur-time-mjd returns decimal
      157   :
      158     define variable v-date as date      no-undo .
      159     define variable v-time as integer   no-undo .
      160     run cur-time in this-procedure
      161       (output v-date
      162       ,output v-time
      163       ) .
      164     return integer(v-date) - 2400002 + (v-time / 86400) .
      165   end.
      166   function cur-time-get-ending-index returns integer
      167   (input p-number as integer
      168   )
      169   :
      170     if p-number < 0
      171     or p-number = ?
      172     then do:
      173       return 1 .
      174     end.
      175     define variable v-rest as integer   no-undo .
      176     assign
      177       p-number = p-number modulo 100
      178     .
      179     if p-number < 20
      180     then do:
      181       assign
      182         v-rest = p-number
      183       .
      184     end.
      185     else do:
      186       assign
      187         v-rest = p-number modulo 10
      188       .
      189     end.
      190     case v-rest :
      191       when 1
      192       then do:
      193         return 2 .
      194       end.
      195       when 2 or
      196       when 3 or
      197       when 4
      198       then do:
      199         return 3 .
      200       end.
      201       otherwise do:
      202         return 1 .
      203       end.
      204     end case .
      205   end.
      206   procedure cur-time-mjd-to-date :
      207      define input  parameter i-mjd-diff as decimal no-undo.
      208      define output parameter o-Date     as date    no-undo.
      209      define output parameter o-Time     as integer no-undo.
      210      define variable v-day-number as integer   no-undo .
      211      if    i-mjd-diff < 0
      212         or i-mjd-diff = ?
      213      then do:
      214         return "?" .
      215      end.
      216      assign
      217         v-day-number = truncate(i-mjd-diff,0).
      218         o-Date = date(v-day-number + 2400002).
      219         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      220     .
      221   end.
      222   function cur-time-mjd-to-string returns character
      223   (input p-mjd-diff as decimal
      224   )
      225   :
      226     define variable v-day-number as integer   no-undo .
      227     define variable v-seconds    as integer   no-undo .
      228     define variable v-hour       as integer   no-undo .
      229     define variable v-min        as integer   no-undo .
      230     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      231     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      232     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      233     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      234     if p-mjd-diff < 0
      235     or p-mjd-diff = ?
      236     then do:
      237       return "?" .
      238     end.
      239     assign
      240       v-day-number = integer(truncate(p-mjd-diff,0))
      241       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      242     .
      243     if v-seconds > 86400
      244     then do:
      245       assign
      246         v-seconds = 86400 - 1
      247       .
      248     end.
      249     if v-seconds < 0
      250     then do:
      251       assign
      252         v-seconds = 0
      253       .
      254     end.
      255     assign
      256       v-hour = truncate(v-seconds / 3600, 0)
      257     .
      258     assign
      259       v-seconds = v-seconds modulo 3600
      260     .
      261     assign
      262       v-min = truncate(v-seconds / 60, 0)
      263     .
      264     assign
      265       v-seconds = v-seconds modulo 60
      266     .
      267     return
      268         (if v-day-number <> 0
      269           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      270           else ""
      271         )
      272       + (if v-day-number <> 0 or v-hour <> 0
      273           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      274           else ""
      275         )
      276       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      277           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      278           else ""
      279         )
      280       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      281       .
      282   end.
      283   function cur-time-string returns character
      284   :
      285     define variable v-date as date      no-undo .
      286     define variable v-time as integer   no-undo .
      287     run cur-time in this-procedure
      288       (output v-date
      289       ,output v-time
      290       ) .
      291     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      292   end.
      293   function cur-time-string-sec returns character
      294   :
      295     define variable v-date as date      no-undo .
      296     define variable v-time as integer   no-undo .
      297     run cur-time in this-procedure
      298       (output v-date
      299       ,output v-time
      300       ) .
      301     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      302   end.
      303   function cur-time-custom  returns character
      304   (input p-prefix as character
      305   ,input p-date-format as character
      306   ,input p-delimiter as character
      307   ,input p-time-format as character
      308   ,input p-suffix as character
      309   )
      310   :
      311     define variable v-date as date      no-undo .
      312     define variable v-time as integer   no-undo .
      313     run cur-time in this-procedure
      314       (output v-date
      315       ,output v-time
      316       ) .
      317     return
      318       p-prefix
      319       + string(v-date, p-date-format)
      320       + p-delimiter
      321       + string(v-time, p-time-format)
      322       + p-suffix
      323       .
      324   end.
      325   function cur-time-print  returns character
      326   :
      327     define variable v-date as date      no-undo .
      328     define variable v-time as integer   no-undo .
      329     run cur-time in this-procedure
      330       (output v-date
      331       ,output v-time
      332       ) .
      333     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      334   end.
      335   function cur-time-datetime returns datetime
      336   :
      337     define variable v-char as character no-undo .
      338     define variable v-datetime as datetime no-undo .
      339     v-char = cur-time-string().
      340     v-datetime = datetime(v-char).
      341     return  v-datetime.
      342   end.
      343   function cur-time-string-msec returns character
      344   :
      345     define variable v-date as datetime  no-undo .
      346     v-date = now.
      347     return string(v-date) .
      348   end.
      349   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      350   define variable v-waitfram-action01         as character   no-undo .
      351   define variable v-waitfram-action02         as character   no-undo .
      352   define variable v-waitfram-action03         as character   no-undo .
      353   define variable mWaitFramTextBeg            as character   no-undo.
      354   define variable mWaitFramTextEnd            as character   no-undo.
      355   define variable mWaitFramView               as logical     no-undo.
      356   define variable mWaitProcEvent              as logical     no-undo init yes.
      357   define variable mWaitFramInterval           as integer     no-undo init 1 .
      358   define variable mWaitFramStop               as logical     no-undo.
      359   define variable mWaitFramStopUser           as logical     no-undo.
      360   define variable mWaitFramStopTimeOut        as logical     no-undo.
      361   define variable mWaitFramStartProc          as datetime-tz no-undo.
      362   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      363   define button B-WaitFramStop auto-end-key
      364        label "Стоп"
      365        size 10 by 1 tooltip "Остоновить процесс".
      366   define button B-viewProcInfo
      367        label "Информация"
      368        size 15 by 1 tooltip "Информация о процесс".
      369   define frame waitfram
      370     v-waitfram-action01 format "x(72)" no-label skip
      371     v-waitfram-action02 format "x(72)" no-label skip
      372     v-waitfram-action03 format "x(72)" no-label skip
      373     B-viewProcInfo
      374     B-WaitFramStop at row 4 col 30
      375     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      376     .
      377   define new global shared variable mBatchMode as logical no-undo init ?.
      378   define variable mFramBachModHandle as handle no-undo.
      379   mFramBachModHandle = frame waitfram:handle.
      380   define variable mFameOldVis as logical no-undo.
      381   define variable mVisCUrentVin as logical no-undo.
      382   if session:batch-mode
      383   then
      384      mBatchMode = yes.
      385   if mBatchMode = ? then do:
      386     mVisCUrentVin = current-window:visible.
      387     mFameOldVis = mFramBachModHandle:visible.
      388     mFramBachModHandle:visible  = yes.
      389     mBatchMode = mFramBachModHandle:visible ne yes.
      390     mFramBachModHandle:visible = mFameOldVis.
      391     current-window:visible = mVisCUrentVin.
      392   end.
      393    if  log-manager:logfile-name ne ?
      394     then DO:
      395         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      396         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      397         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      398     end.
      399   on choose of B-WaitFramStop in frame waitfram
      400   do:
      401     mWaitFramStop = yes.
      402     mWaitFramStopUser = yes.
      403   end.
      404   function waitfram-check-timeout returns logical():
      405      define variable vtime as int64 no-undo.
      406      if mWaitFramStopTimeOut
      407      then
      408         return yes.
      409      vtime = ( now - mWaitFramStartProc ) / 1000 .
      410      if     mWaitFramTimeOut ne ?
      411         and mWaitFramTimeOut ne 0
      412         and mWaitFramTimeOut lt vtime
      413      then do:
      414         mWaitFramStopTimeOut = yes.
      415      end.
      416      return mWaitFramStopTimeOut.
      417   end.
      418   procedure waitfram-hide :
      419     if not session:batch-mode
      420     then do
      421     on error undo, return error return-value
      422     :
      423       pause 0 before-hide .
      424       if not mBatchMode then
      425         hide frame waitfram .
      426     if     not mWaitFramView
      427        and mWaitProcEvent
      428     then
      429       process events .
      430     end.
      431   end procedure.
      432   procedure waitfram-show :
      433     define input  parameter p-message as character no-undo .
      434     define variable v-left-margin as integer   no-undo .
      435     if not session:batch-mode
      436     then do
      437     on error undo, return error return-value
      438     :
      439       if length(p-message) <= 70 then do:
      440         assign
      441           v-left-margin = integer((70 - length(p-message)) / 2)
      442         .
      443         assign
      444           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      445         .
      446         assign
      447           v-waitfram-action01 = " "
      448           v-waitfram-action02 = " "
      449                                    + fill(" ", v-left-margin)
      450                                    + p-message
      451           v-waitfram-action03 = " "
      452         .
      453       end.
      454       else do:
      455         define variable vRindex1 as integer no-undo.
      456         define variable vRindex2 as integer no-undo.
      457         vRindex1 = r-index(p-message," ",70).
      458         if vRindex1 = 0
      459         then
      460            vRindex1 = 70.
      461         if length(p-message)  <= vRindex1 + 70 then do:
      462           assign
      463             v-waitfram-action01 = " "
      464             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      465             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      466           .
      467         end.
      468         else do:
      469           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      470           if vRindex2 <= vRindex1
      471           then
      472              vRindex2 = vRindex1 + 70.
      473           assign
      474             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      475             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      476             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      477           .
      478         end.
      479       end.
      480       B-viewProcInfo:visible   in frame waitfram = no.
      481       B-viewProcInfo:sensitive in frame waitfram = no.
      482       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      483       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      484       if  (   mWaitFramView
      485          or  mWaitProcEvent)
      486          and not mBatchMode
      487       then
      488          display
      489             v-waitfram-action01 skip
      490             v-waitfram-action02 skip
      491             v-waitfram-action03 skip
      492          with frame waitfram .
      493       if     mWaitFramView
      494          then do:
      495             if     mWaitFramInterval ne ?
      496                and not mBatchMode
      497             then
      498                wait-for go of frame waitfram pause mWaitFramInterval.
      499          end.
      500          else
      501             if     mWaitProcEvent
      502                and not mBatchMode
      503             then
      504                process events .
      505     end.
      506   end procedure.
      507      procedure waitfram-show-this:
      508         define input  parameter iInterval as int64 no-undo.
      509         define variable vtime as int64 no-undo.
      510         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      511         mWaitFramInterval = iInterval.
      512         run waitfram-show (substitute("&1&2 &3&4" ,
      513                                       mWaitFramTextBeg ,
      514                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      515                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      516                                       mWaitFramTextEnd
      517                                      )
      518                           ).
      519      end.
      520      procedure WaitFramRunPause:
      521         define input  parameter iInterval as dec no-undo.
      522         define variable vStart  as datetime-tz no-undo.
      523         define variable vend    as datetime-tz no-undo.
      524         define variable vint as int64 no-undo.
      525         define variable vOk as logical no-undo.
      526         vStart = now.
      527         vend   = vStart.
      528         publish "WaitFramPause" (iInterval,output vOk).
      529         vend   =  now.
      530         vint = vend - vStart.
      531         vint = iInterval - vint / 1000.
      532         if     not mWaitFramStop
      533            and (   vint > 0
      534                 or (    not vOk
      535                     and iInterval eq ?
      536                     )
      537                 )
      538         then
      539            run waitfram-show-this (iInterval).
      540         vend   =  now.
      541         vint = vend - vStart.
      542         vint = iInterval - vint / 1000.
      543         if     not mWaitFramStop
      544            and vint > 0
      545         then do:
      546            run gbl/pause.p (vint * 1000).
      547         end.
      548         if iInterval ne ?
      549         then
      550            publish "WaitFramStop".
      551         waitfram-check-timeout().
      552      end.
      553      procedure WaitFramWaitFor:
      554         define input  parameter iInterval as dec no-undo.
      555         assign
      556            mWaitFramStartProc   = now
      557            mWaitFramStopUser    = no
      558            mWaitFramStopTimeOut = no
      559         .
      560         block-wait:
      561         do while not mWaitFramStop:
      562            run WaitFramRunPause (iInterval).
      563            if  waitfram-check-timeout()
      564            then do:
      565               leave block-wait.
      566            end.
      567         end.
      568         run waitfram-hide.
      569      end.
      570   procedure waitfram-join :
      571     define input  parameter p-line-1  as character no-undo .
      572     define input  parameter p-line-2  as character no-undo .
      573     define input  parameter p-line-3  as character no-undo .
      574     define output parameter p-message as character no-undo .
      575     do
      576     on error undo, return error return-value
      577     :
      578       assign
      579         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      580                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      581                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      582       .
      583     end.
      584   end procedure.
      585   function waitfram-join-function returns character
      586     (input p-line-1 as character
      587     ,input p-line-2 as character
      588     ,input p-line-3 as character
      589     ).
      590     define variable v-message as character no-undo .
      591     run waitfram-join in this-procedure
      592       (input  p-line-1
      593       ,input  p-line-2
      594       ,input  p-line-3
      595       ,output v-message
      596       ) .
      597     return v-message .
      598   end function .
      599   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      600     define variable v-cntxt-db-num        as integer   no-undo .
      601     define variable v-cntxt-userid        as character no-undo .
      602     define variable v-cntxt-level         as character no-undo .
      603     define variable v-cntxt-host-code-obj as integer   no-undo .
      604     define variable v-cntxt-obj-type      as character no-undo .
      605     define variable v-cntxt-obj-code      as integer   no-undo .
      606     define variable v-cntxt-db-num-obj    as integer   no-undo .
      607     define variable v-cntxt-is-admin      as logical   no-undo .
      608   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      609   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      610   procedure cp-attr-code :
      611     do
      612     on error undo, return error
      613     :
      614       define input  parameter p-code           as character no-undo .
      615       define output parameter p-type           as character no-undo .
      616       define output parameter p-format         as character no-undo .
      617       define output parameter p-label          as character no-undo .
      618       define output parameter p-range          as integer   no-undo .
      619       define output parameter p-user-can-edit  as logical   no-undo .
      620       define output parameter p-output-display as logical   no-undo .
      621       define output parameter p-other          as character no-undo .
      622       case p-code :
      623               when 'paycard-export-prefix':U then do:     assign     p-label = "Префиксы платежных карт (для выгрузки в XML)"     p-type = 'C':U      p-format = "X(19)"     p-label = "Префиксы платежных карт (для выгрузки в XML)"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=paycard-prefix':u      .   end.
      624               when 'grp-code':U then do:     assign     p-label = "Группа платежа"     p-type = 'C':U      p-format = "X(45)"     p-label = "Группа платежа"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=grp-code':u      .   end.
      625               when 'is-use':U then do:     assign     p-label = "Используется"     p-type = 'C':U      p-format = "X(255)"     p-label = "Используется"     p-range = 4     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=is-use':u      .   end.
      626               when 'dop-doc':U then do:     assign     p-label = "Дополнительный документ"     p-type = 'C':U      p-format = "X(255)"     p-label = "Дополнительный документ"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=dop-doc':u      .   end.
      627               when 'paycard-all-prefix':U then do:     assign     p-label = "Префиксы платежных карт (для разбора чеков и т.д.)"     p-type = 'C':U      p-format = "X(19)"     p-label = "Префиксы платежных карт (для разбора чеков и т.д.)"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=paycard-prefix':u      .   end.
      628               when 'paycard-edit-prefix':U then do:     assign     p-label = "Префиксы платежных карт, разрешенных для редактирования"     p-type = 'C':U      p-format = "X(19)"     p-label = "Префиксы платежных карт, разрешенных для редактирования"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=paycard-prefix':u      .   end.
      629               when 'form_km3':U then do:     assign     p-label = "Формировать КМ-3 по чекам возврата"     p-type = 'L':U      p-format = "+/-"     p-label = "Формировать КМ-3 по чекам возврата"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = '':u      .   end.
      630               when 'bal_malina':U then do:     assign     p-label = "Оплата баллами Малина"     p-type = 'L':U      p-format = "+/-"     p-label = "Оплата баллами Малина"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = '':u      .   end.
      631               when 'max_proc_sum':U then do:     assign     p-label = "Максимальный % порог от суммы"     p-type = 'D':U      p-format = ">>9.99"     p-label = "Максимальный % порог от суммы"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = '':u      .   end.
      632               when 'mask_card_kup':U then do:     assign     p-label = "Маска карты\купона"     p-type = 'C':U      p-format = "x(129)"     p-label = "Маска карты\купона"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = '':u      .   end.
      633         otherwise do:
      634           undo, return error substitute("неизвестный атрибут типа кассового платежа &1", p-code ).
      635         end.
      636       end.
      637     end.
      638   end procedure.
      639   procedure cp-attr-tooltip :
      640     do
      641     on error undo, return error
      642     :
      643       define input  parameter p-code    as character no-undo .
      644       define output parameter p-tooltip as character no-undo .
      645       define output parameter p-label   as character no-undo .
      646       case p-code :
      647               when 'paycard-export-prefix':U then do:     assign     p-tooltip = "Префиксы платежных карт (для выгрузки в XML)"     p-label = "Префиксы платежных карт (для выгрузки в XML)" .   end.
      648               when 'grp-code':U then do:     assign     p-tooltip = "Группа платежа"     p-label = "Группа платежа" .   end.
      649               when 'is-use':U then do:     assign     p-tooltip = "Используется"     p-label = "Используется" .   end.
      650               when 'dop-doc':U then do:     assign     p-tooltip = "Дополнительный документ"     p-label = "Дополнительный документ" .   end.
      651               when 'paycard-all-prefix':U then do:     assign     p-tooltip = "Префиксы платежных карт (для разбора чеков и т.д.)"     p-label = "Префиксы платежных карт (для разбора чеков и т.д.)" .   end.
      652               when 'paycard-edit-prefix':U then do:     assign     p-tooltip = "Префиксы платежных карт, разрешенных для редактировани"     p-label = "Префиксы платежных карт, разрешенных для редактирования" .   end.
      653               when 'form_km3':U then do:     assign     p-tooltip = "Формировать КМ-3 по чекам возврата"     p-label = "Формировать КМ-3 по чекам возврата" .   end.
      654               when 'bal_malina':U then do:     assign     p-tooltip = "Оплата баллами Малина"     p-label = "Оплата баллами Малина" .   end.
      655               when 'max_proc_sum':U then do:     assign     p-tooltip = "Максимальный % порог от суммы"     p-label = "Максимальный % порог от суммы" .   end.
      656               when 'mask_card_kup':U then do:     assign     p-tooltip = "Маска карты\купона"     p-label = "Маска карты\купона" .   end.
      657         otherwise do:
      658           undo, return error substitute("неизвестный атрибут типа кассового платежа &1", p-code) .
      659         end.
      660       end.
      661     end.
      662   end procedure.
      663   procedure cp-attr-value :
      664     do
      665     on error undo, return error
      666     :
      667       define input parameter p-cdpay-code   like ub.cash-pay-attr.cdpay-code     no-undo .
      668       define input parameter p-curr-code    like ub.cash-pay-attr.curr-code      no-undo .
      669       define input parameter p-host-code    like ub.cash-pay-attr.host-code      no-undo .
      670       define input parameter p-obj-type     like ub.cash-pay-attr.obj-type       no-undo .
      671       define input parameter p-obj-code     like ub.cash-pay-attr.obj-code       no-undo .
      672       define input  parameter p-code        like ub.cash-pay-attr.attr-code      no-undo .
      673       define output parameter p-value       like ub.cash-pay-attr.attr-value    no-undo .
      674       define output parameter p-type        as character no-undo .
      675       define buffer buf_cash-pay-attr for ub.cash-pay-attr .
      676       define variable v-format         as character no-undo .
      677       define variable v-label          as character no-undo .
      678       define variable v-range          as integer   no-undo .
      679       define variable v-user-can-edit  as logical   no-undo .
      680       define variable v-output-display as logical   no-undo .
      681       define variable v-other          as character no-undo .
      682       run cp-attr-code in this-procedure
      683         (input  p-code
      684         ,output p-type
      685         ,output v-format
      686         ,output v-label
      687         ,output v-range
      688         ,output v-user-can-edit
      689         ,output v-output-display
      690         ,output v-other
      691         ) no-error .
      692       if error-status :error then do:
      693         undo, return error return-value .
      694       end.
      695       find first buf_cash-pay-attr no-lock
      696         where buf_cash-pay-attr.cdpay-code = p-cdpay-code
      697           and buf_cash-pay-attr.curr-code  = p-curr-code
      698           and buf_cash-pay-attr.host-code  = p-host-code
      699           and buf_cash-pay-attr.obj-type   = p-obj-type
      700           and buf_cash-pay-attr.obj-code   = p-obj-code
      701           and buf_cash-pay-attr.attr-code  = p-code
      702         no-error .
      703       if avail buf_cash-pay-attr then do:
      704         assign
      705           p-value =  buf_cash-pay-attr.attr-value
      706         .
      707       end.
      708       else do:
      709         assign
      710           p-value = if p-type = 'L':U then "no":U else ""
      711         .
      712       end.
      713     end.
      714   end procedure.
      715   procedure cp-attr-write :
      716     do
      717     on error undo, return error
      718     :
      719       define input parameter p-cdpay-code   like ub.cash-pay-attr.cdpay-code     no-undo .
      720       define input parameter p-curr-code    like ub.cash-pay-attr.curr-code      no-undo .
      721       define input parameter p-host-code    like ub.cash-pay-attr.host-code      no-undo .
      722       define input parameter p-obj-type     like ub.cash-pay-attr.obj-type       no-undo .
      723       define input parameter p-obj-code     like ub.cash-pay-attr.obj-code       no-undo .
      724       define input parameter p-code     like ub.cash-pay-attr.attr-code  no-undo .
      725       define input parameter p-value    like ub.cash-pay-attr.attr-value no-undo .
      726       define buffer buf_cash-pay-attr for ub.cash-pay-attr .
      727       define buffer last_cash-pay-attr for ub.cash-pay-attr .
      728       define variable v-type           as character no-undo .
      729       define variable v-format         as character no-undo .
      730       define variable v-label          as character no-undo .
      731       define variable v-range          as integer   no-undo .
      732       define variable v-user-can-edit  as logical   no-undo .
      733       define variable v-output-display as logical   no-undo .
      734       define variable v-other          as character no-undo .
      735       run cp-attr-code in this-procedure
      736         (input  p-code
      737         ,output v-type
      738         ,output v-format
      739         ,output v-label
      740         ,output v-range
      741         ,output v-user-can-edit
      742         ,output v-output-display
      743         ,output v-other
      744         ) no-error .
      745       if error-status :error then do:
      746         undo, return error return-value .
      747       end.
      748       find first buf_cash-pay-attr exclusive-lock
      749         where buf_cash-pay-attr.cdpay-code = p-cdpay-code
      750           and buf_cash-pay-attr.curr-code  = p-curr-code
      751           and buf_cash-pay-attr.host-code  = p-host-code
      752           and buf_cash-pay-attr.obj-type   = p-obj-type
      753           and buf_cash-pay-attr.obj-code   = p-obj-code
      754           and buf_cash-pay-attr.attr-code = p-code
      755         no-error .
      756       if not available buf_cash-pay-attr then do:
      757         create buf_cash-pay-attr .
      758         assign
      759         buf_cash-pay-attr.cdpay-code = p-cdpay-code
      760         buf_cash-pay-attr.curr-code  = p-curr-code
      761         buf_cash-pay-attr.host-code  = p-host-code
      762         buf_cash-pay-attr.obj-type   = p-obj-type
      763         buf_cash-pay-attr.obj-code   = p-obj-code
      764         buf_cash-pay-attr.attr-code = p-code
      765         .
      766       end.
      767       assign
      768         buf_cash-pay-attr.attr-value = p-value
      769       .
      770       release buf_cash-pay-attr no-error .
      771       if error-status:error then do:
      772         undo, return error return-value .
      773       end.
      774     end.
      775   end procedure.
      776   procedure cp-attr-exist :
      777     do
      778     on error undo, return error
      779     :
      780       define input parameter p-cdpay-code   like ub.cash-pay-attr.cdpay-code     no-undo .
      781       define input parameter p-curr-code    like ub.cash-pay-attr.curr-code      no-undo .
      782       define input parameter p-host-code    like ub.cash-pay-attr.host-code      no-undo .
      783       define input parameter p-obj-type     like ub.cash-pay-attr.obj-type       no-undo .
      784       define input parameter p-obj-code     like ub.cash-pay-attr.obj-code       no-undo .
      785       define input parameter p-code     like ub.cash-pay-attr.attr-code  no-undo .
      786       define output parameter p-exist   as logical  no-undo .
      787       define buffer buf_cash-pay-attr for ub.cash-pay-attr .
      788       define variable v-type           as character no-undo .
      789       define variable v-format         as character no-undo .
      790       define variable v-label          as character no-undo .
      791       define variable v-range          as integer   no-undo .
      792       define variable v-user-can-edit  as logical   no-undo .
      793       define variable v-output-display as logical   no-undo .
      794       define variable v-other          as character no-undo .
      795       run cp-attr-code in this-procedure
      796         (input  p-code
      797         ,output v-type
      798         ,output v-format
      799         ,output v-label
      800         ,output v-range
      801         ,output v-user-can-edit
      802         ,output v-output-display
      803         ,output v-other
      804         ) no-error .
      805       if error-status :error then do:
      806         undo, return error return-value .
      807       end.
      808       find first buf_cash-pay-attr exclusive-lock
      809         where buf_cash-pay-attr.cdpay-code = p-cdpay-code
      810           and buf_cash-pay-attr.curr-code  = p-curr-code
      811           and buf_cash-pay-attr.host-code  = p-host-code
      812           and buf_cash-pay-attr.obj-type   = p-obj-type
      813           and buf_cash-pay-attr.obj-code   = p-obj-code
      814           and buf_cash-pay-attr.attr-code = p-code
      815         no-error .
      816       if  available buf_cash-pay-attr then do:
      817         p-exist = yes.
      818       end.
      819     end.
      820   end procedure.
      821   procedure cp-attr-delete :
      822     do
      823     on error undo, return error
      824     :
      825       define input parameter p-cdpay-code   like ub.cash-pay-attr.cdpay-code     no-undo .
      826       define input parameter p-curr-code    like ub.cash-pay-attr.curr-code      no-undo .
      827       define input parameter p-host-code    like ub.cash-pay-attr.host-code      no-undo .
      828       define input parameter p-obj-type     like ub.cash-pay-attr.obj-type       no-undo .
      829       define input parameter p-obj-code     like ub.cash-pay-attr.obj-code       no-undo .
      830       define input parameter p-code     like ub.cash-pay-attr.attr-code  no-undo .
      831       define output parameter p-deleted  as logical no-undo.
      832       define buffer buf_cash-pay-attr for ub.cash-pay-attr .
      833       define variable v-type           as character no-undo .
      834       define variable v-format         as character no-undo .
      835       define variable v-label          as character no-undo .
      836       define variable v-range          as integer   no-undo .
      837       define variable v-user-can-edit  as logical   no-undo .
      838       define variable v-output-display as logical   no-undo .
      839       define variable v-other          as character no-undo .
      840       run cp-attr-code in this-procedure
      841         (input  p-code
      842         ,output v-type
      843         ,output v-format
      844         ,output v-label
      845         ,output v-range
      846         ,output v-user-can-edit
      847         ,output v-output-display
      848         ,output v-other
      849         ) no-error .
      850       if error-status :error then do:
      851         undo, return error return-value .
      852       end.
      853       find first buf_cash-pay-attr exclusive-lock
      854         where buf_cash-pay-attr.cdpay-code = p-cdpay-code
      855           and buf_cash-pay-attr.curr-code  = p-curr-code
      856           and buf_cash-pay-attr.host-code  = p-host-code
      857           and buf_cash-pay-attr.obj-type   = p-obj-type
      858           and buf_cash-pay-attr.obj-code   = p-obj-code
      859           and buf_cash-pay-attr.attr-code = p-code
      860         no-error NO-WAIT.
      861       if not available buf_cash-pay-attr then do:
      862         p-deleted = no.
      863       end.
      864       else do:
      865         delete buf_cash-pay-attr no-error .
      866         if error-status:error then do:
      867           undo, return error return-value .
      868         end.
      869         p-deleted = yes.
      870       end.
      871     end.
      872   end procedure.
      873   procedure cp-attr-news :
      874     do
      875     on error undo, return error
      876     :
      877       define input  parameter p-code           as character no-undo .
      878       define output parameter p-news           as logical   no-undo .
      879       case p-code :
      880               when 'paycard-export-prefix':U then do:     assign     p-news = true.   end.
      881               when 'grp-code':U then do:     assign     p-news = true.   end.
      882               when 'is-use':U then do:     assign     p-news = true.   end.
      883               when 'dop-doc':U then do:     assign     p-news = true.   end.
      884               when 'paycard-all-prefix':U then do:     assign     p-news = true.   end.
      885               when 'paycard-edit-prefix':U then do:     assign     p-news = true.   end.
      886               when 'form_km3':U then do:     assign     p-news = false.   end.
      887               when 'bal_malina':U then do:     assign     p-news = false.   end.
      888               when 'max_proc_sum':U then do:     assign     p-news = true.   end.
      889               when 'mask_card_kup':U then do:     assign     p-news = true.   end.
      890         otherwise do:
      891           p-news = no.
      892         end.
      893       end.
      894     end.
      895   end procedure.
      896   procedure cp-attr-hist :
      897     do
      898     on error undo, return error
      899     :
      900       define input  parameter p-code           as character no-undo .
      901       define output parameter p-hist           as logical   no-undo .
      902       case p-code :
      903               when 'paycard-export-prefix':U then do:     assign     p-hist = true.   end.
      904               when 'paycard-all-prefix':U then do:     assign     p-hist = true.   end.
      905               when 'paycard-edit-prefix':U then do:     assign     p-hist = true.   end.
      906               when 'form_km3':U then do:     assign     p-hist = true.   end.
      907               when 'bal_malina':U then do:     assign     p-hist = true.   end.
      908               when 'max_proc_sum':U then do:     assign     p-hist = true.   end.
      909               when 'mask_card_kup':U then do:     assign     p-hist = true.   end.
      910         otherwise do:
      911           p-hist = no.
      912         end.
      913       end.
      914     end.
      915   end procedure.
      916   procedure paycard-prefix :
      917   define input parameter p-cdpay-code like ub.cash-pay-attr.cdpay-code no-undo .
      918   define input parameter p-curr-code like ub.cash-pay-attr.curr-code no-undo .
      919   define input parameter p-host-code like ub.cash-pay-attr.host-code no-undo .
      920   define input parameter p-obj-type like ub.cash-pay-attr.obj-type no-undo .
      921   define input parameter p-obj-code like ub.cash-pay-attr.obj-code no-undo .
      922   define input-output parameter p-value as character no-undo .
      923   define output parameter p-setted as logical no-undo .
      924   DEFINE VARIABLE v-value as character no-undo .
      925   define variable v-codes as character no-undo .
      926   define variable v-labels as character no-undo .
      927   define variable v-ok as logical no-undo .
      928     do
      929     on error undo, return error
      930     :
      931       assign
      932       v-value = p-value
      933       .
      934       run ref/cpa-pcep.w (
      935                      input parparentproc
      936                     ,input p-cdpay-code
      937                     ,input p-curr-code
      938                     ,input p-host-code
      939                     ,input p-obj-type
      940                     ,input p-obj-code
      941                     ,input-output v-value
      942                     ,output v-ok
      943                      ) no-error .
      944       if
      945       v-ok and
      946       p-value <> v-value and v-value <> ? and not error-status:error then do:
      947         assign
      948         p-setted = yes
      949         p-value = v-value
      950         .
      951       end.
      952     end.
      953   end procedure.
      954   procedure is-use :
      955   define input parameter p-cdpay-code like ub.cash-pay-attr.cdpay-code no-undo .
      956   define input parameter p-curr-code like ub.cash-pay-attr.curr-code no-undo .
      957   define input parameter p-host-code like ub.cash-pay-attr.host-code no-undo .
      958   define input parameter p-obj-type like ub.cash-pay-attr.obj-type no-undo .
      959   define input parameter p-obj-code like ub.cash-pay-attr.obj-code no-undo .
      960   define input-output parameter p-value as character no-undo .
      961   define output parameter p-setted as logical no-undo .
      962   DEFINE VARIABLE v-value as character no-undo .
      963   define variable v-codes as character no-undo .
      964   define variable v-labels as character no-undo .
      965   define variable v-ok as logical no-undo .
      966     do
      967     on error undo, return error
      968     :
      969       assign
      970       v-value = p-value
      971       .
      972       if p-obj-type = 'скл':U then do:
      973         message
      974         substitute("Нельзя задать атрибут для объекта типа &1", p-obj-type)
      975         view-as alert-box error .
      976         return error.
      977       end.
      978       run ref/cpa-isus.w (
      979                      input parparentproc
