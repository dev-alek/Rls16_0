     3364     return no-apply.
     3365   end.
     3366   define variable vss-include-info28 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3367   on F2 of frame d-cash-pay anywhere do:
     3368     if b-sel :sensitive then DO: apply "CHOOSE":U to b-sel in frame d-cash-pay. END.
     3369     return no-apply.
     3370   end.
     3371   define variable vss-include-info29 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3372   on F2 of frame d-cash-pay anywhere do:
     3373     if b-quit :sensitive then DO: apply "CHOOSE":U to b-quit in frame d-cash-pay. END.
     3374     return no-apply.
     3375   end.
     3376   define variable vss-include-info30 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3377   on CTRL-P, CTRL-З of frame d-cash-pay anywhere do:
     3378     if b-print :sensitive then DO: apply "CHOOSE":U to b-print in frame d-cash-pay. END.
     3379     return no-apply.
     3380   end.
     3381   define variable vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3382   procedure set-filter-name :
     3383   define input parameter p-filter-name as character no-undo .
     3384     do with frame d-cash-pay:
     3385       if p-filter-name > "" then do:
     3386         assign
     3387           frame d-cash-pay:title
     3388             = frame d-cash-pay:title + "   ФИЛЬТР: " + p-filter-name.
     3389         .
     3390         assign
     3391           b-sch :tooltip = "Установлен фильтр " + p-filter-name
     3392         .
     3393       end.
     3394       else do:
     3395         assign
     3396           b-sch :tooltip = ""
     3397         .
     3398       end.
     3399     end.
     3400   end procedure.
     3401   ON WINDOW-CLOSE OF FRAME d-cash-pay APPLY "END-ERROR":U TO SELF.
     3402   ON END-ERROR, ENDKEY OF FRAME d-cash-pay DO:
     3403      run gbl/markqwa.p (
     3404                              input b-mark:sensitive
     3405                             , input v-rid-list) no-error.
     3406      if error-status:error then return no-apply.
     3407      else do:
     3408        v-rid-list = '':U.
     3409      end.
     3410   END.
     3411   MAIN-BLOCK:
     3412   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     3413      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     3414       if lookup('s-deploy', bttns) > 0 then do:
     3415         assign
     3416         v-is-deploy = yes.
     3417       end.
     3418   define variable vss-include-info32 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3419     run mainmenu_getcntxt in parparentproc
     3420       (output v-cntxt-db-num
     3421       ,output v-cntxt-userid
     3422       ,output v-cntxt-level
     3423       ,output v-cntxt-host-code-obj
     3424       ,output v-cntxt-obj-type
     3425       ,output v-cntxt-obj-code
     3426       ,output v-cntxt-db-num-obj
     3427       ,output v-cntxt-is-admin
     3428       ) .
     3429       define variable v-parent-handle as handle no-undo .
     3430       v-parent-handle = this-procedure:instantiating-procedure .
     3431       // ак как запустили из класса v-parent-handle не существует
     3432       if valid-object(v-parent-handle) and lookup("cb_set-cp-list", v-parent-handle :internal-entries) > 0 then do:
     3433         run cb_set-cp-list in v-parent-handle (output p-rid-list).
     3434       end.
     3435       v-rid-list = p-rid-list.
     3436       RUN enable_UI.
     3437       if num-entries (v-rid-list) = 0 then
     3438           hide mark-num in frame d-cash-pay.
     3439       else
     3440           disp
     3441           num-entries (v-rid-list) @ mark-num
     3442           with frame d-cash-pay.
     3443       apply 'entry':U to br-cashpay.
     3444       WAIT-FOR GO OF FRAME d-cash-pay.
     3445   END.
     3446   RUN disable_UI.
     3447   PROCEDURE disable_UI :
     3448     HIDE FRAME d-cash-pay.
     3449   END PROCEDURE.
     3450   PROCEDURE enable_UI :
     3451   ASSIGN
     3452   b-attr:MENU-MOUSE IN frame d-cash-pay = 1
     3453   B-disc:MENU-MOUSE IN frame d-cash-pay = 1
     3454   .
     3455   ENABLE
     3456   br-cashpay
     3457   b-quit
     3458   b-add WHEN (lookup("b-add", bttns) > 0 and v-cntxt-db-num = 0)
     3459   b-sel WHEN lookup("b-sel", bttns) > 0
     3460   b-mark when lookup("b-mark", bttns) > 0
     3461   b-chg WHEN (lookup("b-add", bttns) > 0  and v-cntxt-db-num = 0)
     3462   b-del WHEN (lookup("b-add", bttns) > 0  and v-cntxt-db-num = 0)
     3463   b-sch
     3464   b-disc
     3465   b-ATTR when not v-is-deploy
     3466   b-lkp
     3467   b-print when valid-handle(parparentproc) and not v-is-deploy
     3468   b-hist when not v-is-deploy
     3469   b-help
     3470   f-obj-name
     3471   WITH FRAME d-cash-pay .
     3472   run Openbr in this-procedure ( input yes, input no, input '':U) no-error.
     3473   if available X_cash-pay then
     3474   log-res  = br-cashpay:select-focused-row( ).
     3475   if  (lookup("b-add", bttns) = 0  or v-cntxt-db-num > 0) then do:
     3476     assign
     3477     menu-item m_update-disc:sensitive in menu menu-b-disc = no.
     3478   end.
     3479   IF NOT  (can-do( bttns, "b-add" )  and v-cntxt-db-num = 0)
     3480   or p-host-code = 0
     3481   or p-obj-code = 0
     3482   THEN DO:
     3483   ASSIGN
     3484   MENU-ITEM M_UPDATE-attr:SENSITIVE  IN MENU menu-b-attr = NO.
     3485   END.
     3486   END PROCEDURE.
     3487   PROCEDURE Openbr :
     3488   define input  parameter p-open-query     as logical   no-undo .
     3489   define input  parameter p-find-next      as logical   no-undo .
     3490   define input  parameter p-find-condition as character no-undo .
     3491   define variable sort-column-phrase as character no-undo .
     3492   define variable l-query-was-opened as logical no-undo .
     3493   define variable title0 as character no-undo .
     3494   define buffer buf_clients for clients.
     3495   case sort-column-name :
     3496     when "" then do:
     3497       assign
     3498         sort-column-phrase = ""
     3499       .
     3500     end.
     3501     otherwise do:
     3502       assign
     3503         sort-column-phrase = "by " + sort-column-name
     3504       .
     3505     end.
     3506   end case.
     3507   title0 = "ТИПЫ КАССОВЫХ ПЛАТЕЖЕЙ".
     3508   case p-list-mode:
     3509     when 'все':U then do:
     3510       ASSIGN
     3511       frame d-cash-pay:title = substitute("&1: ВСЕ", title0)
     3512       filter-label = SUBSTITUTE("&1"
     3513                                 , frame d-cash-pay:title
     3514                                 )
     3515       .
     3516   define variable vss-include-info33 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3517   define variable  l-disable-where-34  as logical   no-undo .
     3518   define variable  l-filter-open-34    as logical   .
     3519   define variable  flt-rec-34       as recid     no-undo .
     3520   define variable  filter-name-34      as character no-undo .
     3521   define variable  where-phrase-34     as character no-undo .
     3522   define variable  sort-phrase-34      as character no-undo .
     3523   define variable  where-phrase-rus-34 as character no-undo .
     3524   define variable  sort-phrase-rus-34  as character no-undo .
     3525     run waitfram-show in this-procedure
     3526       (input "ЖДИТЕ ..."
     3527       ).
     3528   run gbl/flt-get.p
     3529     (input filter-point
     3530     ,output flt-rec-34
     3531     ,output filter-name-34
     3532     ,output where-phrase-34
     3533     ,output sort-phrase-34
     3534     ,output where-phrase-rus-34
     3535     ,output sort-phrase-rus-34
     3536     ).
     3537   if p-open-query then do:
     3538       run set-filter-name in this-procedure
     3539         (INPUT filter-name-34
     3540         ) no-error .
     3541     assign
     3542       l-filter-open-34 = false
     3543     .
     3544     if flt-rec-34 <> ?
     3545       or sort-column-phrase > ""
     3546     then do:
     3547       define variable  parameter-2-34 as character no-undo .
     3548       define variable  parameter-3-34 as character no-undo .
     3549       define variable  parameter-4-34 as character no-undo .
     3550       define variable  parameter-5-34 as character no-undo .
     3551       define variable  parameter-6-34 as character no-undo .
     3552       define variable  parameter-7-34 as character no-undo .
     3553         assign
     3554         parameter-3-34 =
     3555                                 "FOR EACH X_cash-pay"
     3556         parameter-4-34 =
     3557           (
     3558             if (" true " + " " + where-phrase-34) <> ""
     3559             then " true " + " " + where-phrase-34
     3560             else "true"
     3561           )
     3562         parameter-5-34 = (" " + "" + " " + "")
     3563         parameter-6-34 = if sort-phrase-34 = ''
     3564                              then
     3565           (
     3566           " " + "  " +
     3567             " " + sort-column-phrase +
     3568           " " + " BY X_cash-pay.cdpay-code  "
     3569           )
     3570                              else
     3571           (
     3572           " " + "  " +
     3573             " " + sort-column-phrase +
     3574           " " + sort-phrase-34
     3575           )
     3576         parameter-7-34 =
     3577           " INDEXED-REPOSITION  "
     3578       .
     3579       do
     3580       on stop undo, leave
     3581       on error undo, leave
     3582       :
     3583         assign
     3584           l-disable-where-34 =
     3585             (" true " + " " + where-phrase-34 = "")
     3586         .
     3587         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     3588                             ,input QUERY br-cashpay:handle
     3589                             ,input parameter-3-34
     3590                             ,input parameter-4-34
     3591                             ,input parameter-5-34
     3592                             ,input parameter-6-34
     3593                             ,input parameter-7-34
     3594                             )
     3595         .
     3596         assign
     3597           l-filter-open-34 = true
     3598         .
     3599       end.
     3600       if l-filter-open-34 = false then do:
     3601         message
     3602           "Ошибка при фильтрации / сортировке" skip
     3603           "Будут показаны записи без учета фильтра" skip
     3604           view-as alert-box .
     3605       end.
     3606       else do:
     3607           assign
     3608             l-query-was-opened = true
     3609           .
     3610       end.
     3611     end.
     3612     if l-filter-open-34 = false then do:
     3613       OPEN QUERY br-cashpay FOR EACH X_cash-pay
     3614         where  true
     3615          BY X_cash-pay.cdpay-code
     3616         INDEXED-REPOSITION
     3617     .
     3618         assign
     3619           l-query-was-opened = true
     3620         .
     3621     end.
     3622   end.
     3623   else do:
     3624     assign
     3625       v-rep-rec = recid( X_cash-pay )
     3626     .
     3627     do
     3628     on stop undo, leave
     3629     on error undo, leave
     3630     :
     3631       if QUERY br-cashpay:handle:get-buffer-handle(1) = (buffer X_cash-pay:handle) then do:
     3632         assign
     3633         parameter-2-34 = (if p-find-next then "true":u else "false":u )
     3634         parameter-4-34 =
     3635           "where ":u + " true " + " ":u + where-phrase-34 + " ":u + p-find-condition + " " + ""
     3636         parameter-5-34 = "  "
     3637       .
