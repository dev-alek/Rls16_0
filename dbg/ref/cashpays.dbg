     1303   procedure fltfield-clear :
     1304     define output parameter loc-fld as character no-undo.
     1305     define output parameter loc-lab as character no-undo .
     1306     define output parameter loc-spr as character no-undo .
     1307     define output parameter loc-dim as character no-undo .
     1308     assign
     1309       loc-fld = ""
     1310       loc-lab = ""
     1311       loc-spr = ""
     1312       loc-dim = "0"
     1313     .
     1314   end procedure .
     1315   procedure fltfield-add :
     1316     define input        parameter par-fld as character no-undo.
     1317     define input        parameter par-lab as character no-undo .
     1318     define input        parameter par-spr as character no-undo .
     1319     define input-output parameter loc-fld as character no-undo.
     1320     define input-output parameter loc-lab as character no-undo .
     1321     define input-output parameter loc-spr as character no-undo .
     1322     define input-output parameter loc-dim as character no-undo .
     1323     do
     1324     on error undo, return error
     1325     :
     1326       assign
     1327       loc-fld = if loc-dim = '0'
     1328                 then par-fld
     1329                 else (loc-fld + chr(44) + par-fld)
     1330       loc-lab = if loc-dim = '0'
     1331                 then par-lab
     1332                 else (loc-lab + chr(44) + par-lab)
     1333       loc-spr = if loc-dim = '0'
     1334                 then par-spr
     1335                 else (loc-spr + chr(44) + par-spr)
     1336       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
     1337                 string(integer(if num-entries(loc-dim) > 1
     1338                               then entry(2, loc-dim)
     1339                               else entry(1, loc-dim)
     1340                               ) + 1)
     1341       no-error
     1342       .
     1343     end.
     1344   end procedure.
     1345   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1346   define variable v-fltopend-rowid as rowid extent 18 no-undo .
     1347   procedure fltopend_fltopend :
     1348   define input parameter p-parent-handle as handle no-undo .
     1349   define input parameter p-qh as handle no-undo .
     1350   define input parameter p-flt-open-open-query  as character no-undo .
     1351   define input parameter p-where-cond as character no-undo .
     1352   define input parameter p-use-indFIRST-query-tail as character no-undo .
     1353   define input parameter p-use-ind-sort-clmn-by as character no-undo .
     1354   define input parameter p-indexed-reposition as character no-undo .
     1355     do
     1356     on error undo, return error
     1357     :
     1358   define variable v-prepare-string as character no-undo .
     1359   define variable glog as logical no-undo .
     1360   assign
     1361   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     1362                      p-where-cond + chr(32)  +
     1363                      p-use-indFIRST-query-tail + chr(32) +
     1364                      p-use-ind-sort-clmn-by + chr(32) +
     1365                      p-indexed-reposition
     1366   .
     1367   assign
     1368   glog = p-qh:query-prepare(v-prepare-string) no-error .
     1369   if not glog
     1370   or error-status:error then do:
     1371     message error-status:get-message(1) view-as alert-box .
     1372     undo, return error .
     1373   end.
     1374   assign
     1375   glog = p-qh:query-open no-error .
     1376   if not glog
     1377   or error-status:error then do:
     1378     message error-status:get-message(1) view-as alert-box .
     1379     undo, return error .
     1380   end.
     1381     end.
     1382   end procedure.
     1383   procedure fltopend_fltfindd :
     1384   define input parameter p-parent-handle as handle no-undo .
     1385   define input parameter p-qh as handle no-undo .
     1386   define input parameter p-rowid as rowid no-undo .
     1387   define input parameter p-next as logical no-undo .
     1388   define input parameter p-lock as integer no-undo .
     1389   define input parameter p-bh as handle no-undo .
     1390   define input parameter p-where-cond as character no-undo .
     1391   define input parameter p-use-index-phrase as character no-undo .
     1392   define variable glog as logical no-undo .
     1393   define variable v-qh as handle no-undo .
     1394   define variable v-bh as handle no-undo .
     1395   define variable v-recid as recid no-undo .
     1396   define variable v-prepare-string as character no-undo .
     1397   do
     1398   on error undo, return error
     1399   on stop undo, return error
     1400   :
     1401     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
     1402     create buffer v-bh for table p-bh buffer-name p-bh:name.
     1403     create query v-qh.
     1404     v-qh:set-buffers(v-bh).
     1405     v-prepare-string = substitute("for each &1 &2 &3"
     1406                                     ,v-bh:name
     1407                                     ,p-where-cond
     1408                                     ,p-use-index-phrase).
     1409     glog = v-qh:query-prepare(v-prepare-string) no-error.
     1410     if not glog then do:
     1411       delete object v-qh.
     1412       delete object v-bh.
     1413       undo, return error .
     1414     end.
     1415     glog = v-qh:query-open no-error .
     1416     if not glog then do:
     1417       delete object v-qh.
     1418       delete object v-bh.
     1419       undo, return error .
     1420     end.
     1421     if p-next then do:
     1422       v-qh:reposition-to-rowid(p-rowid) no-error .
     1423       glog = v-qh:get-next( p-lock) no-error .
     1424       glog = v-qh:get-next( p-lock) no-error .
     1425       if not glog or v-qh:query-off-end = yes then do:
     1426         glog = v-qh:get-first( p-lock) no-error .
     1427       end.
     1428     end.
     1429     else do:
     1430       glog = v-qh:get-first( p-lock) no-error .
     1431     end.
     1432     v-recid = v-bh:recid no-error .
     1433     delete object v-qh.
     1434     delete object v-bh.
     1435     return string(v-recid) .
     1436   end.
     1437   end procedure.
     1438   procedure fltopend_fltfindq :
     1439   define input parameter p-parent-handle as handle no-undo .
     1440   define input parameter p-qh as handle no-undo .
     1441   define input parameter p-next as logical no-undo .
     1442   define input parameter p-lock as integer no-undo .
     1443   define input parameter p-flt-open-open-query  as character no-undo .
     1444   define input parameter p-where-cond as character no-undo .
     1445   define input parameter p-use-indFIRST-query-tail as character no-undo .
     1446   define input parameter p-use-ind-sort-clmn-by as character no-undo .
     1447   define input parameter p-indexed-reposition as character no-undo .
     1448   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
     1449   define variable glog as logical no-undo .
     1450   define variable v-qh as handle no-undo .
     1451   define variable v-bh as handle no-undo extent 18.
     1452   define variable v-rowid as rowid no-undo extent 18.
     1453   define variable v-ii as integer no-undo .
     1454   define variable v-prepare-string as character no-undo .
     1455   do
     1456   on error undo, return error
     1457   on stop undo, return error
     1458   :
     1459     create query v-qh.
     1460     do v-ii = 1 to p-qh:num-buffers:
     1461       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
     1462       assign
     1463       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
     1464       no-error.
     1465       v-qh:add-buffer(v-bh[v-ii]).
     1466     end.
     1467     assign
     1468     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     1469                       p-where-cond + chr(32)  +
     1470                       p-use-indFIRST-query-tail + chr(32) +
     1471                       p-use-ind-sort-clmn-by + chr(32) +
     1472                       p-indexed-reposition
     1473     .
     1474     glog = v-qh:query-prepare( v-prepare-string) no-error .
     1475     if not glog then do:
     1476       delete object v-qh.
     1477       do v-ii = 1 to p-qh:num-buffers:
     1478         delete object v-bh[v-ii].
     1479       end.
     1480       undo, return error .
     1481     end.
     1482     glog = v-qh:query-open no-error .
     1483     if not glog then do:
     1484       delete object v-qh.
     1485       do v-ii = 1 to p-qh:num-buffers:
     1486         delete object v-bh[v-ii].
     1487       end.
     1488       undo, return error .
     1489     end.
     1490     if p-next then do:
     1491       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
     1492       glog = v-qh:get-next( p-lock) no-error .
     1493       glog = v-qh:get-next( p-lock) no-error .
     1494       if not glog or v-qh:query-off-end = yes then do:
     1495         glog = v-qh:get-first( p-lock) no-error .
     1496       end.
     1497     end.
     1498     else do:
     1499       glog = v-qh:get-first( p-lock) no-error .
     1500     end.
     1501     do v-ii = 1 to p-qh:num-buffers:
     1502       assign
     1503       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
     1504       no-error.
     1505     end.
     1506     delete object v-qh.
     1507     do v-ii = 1 to p-qh:num-buffers:
     1508       delete object v-bh[v-ii].
     1509     end.
     1510   end.
     1511   end procedure.
     1512   define variable log-res as log no-undo.
     1513   define variable rr as recid no-undo.
     1514   define variable varwht-name like ub.wealth.wth-name no-undo.
     1515   DEFINE VARIABLE attr-option AS CHARACTER NO-UNDO.
     1516   define variable dcpr-option as character no-undo .
     1517   define variable v-rep-rec as recid no-undo .
     1518   define variable v-is-deploy as logical no-undo .
     1519   define variable v-rid-list as character no-undo .
     1520   define variable sort-column-name as character no-undo.
     1521   define variable filter-point     as character NO-UNDO INIT "cashpays".
     1522   define variable filter-label     as character NO-UNDO INIT "Список типов кассовых платежей".
     1523   define variable filter-point0     as character NO-UNDO INIT "cashpays".
     1524   define variable filter-label0     as character NO-UNDO INIT "Список типов кассовых платежей".
     1525   FUNCTION get-grp-name RETURNS CHARACTER
     1526     ( INPUT p-cdpay-code AS integer, INPUT p-curr-code AS INTEGER )  FORWARD.
     1527   FUNCTION get-wth-name RETURNS CHARACTER
     1528     ( input parwth-code as integer)  FORWARD.
     1529   DEFINE MENU MENU-B-attr
     1530          MENU-ITEM m_lookup-attr  LABEL "Просмотр"
     1531          MENU-ITEM m_update-attr  LABEL "Изменение"     .
     1532   DEFINE MENU MENU-B-disc
     1533          MENU-ITEM m_lookup-disc  LABEL "Просмотр"
     1534          MENU-ITEM m_update-disc  LABEL "Изменение"     .
     1535   DEFINE BUTTON b-add
     1536        LABEL "&Добавить":L
     1537        SIZE 10 BY 1.
     1538   DEFINE BUTTON B-attr
     1539        LABEL "&Атриб."
     1540        SIZE 8 BY 1.
     1541   DEFINE BUTTON b-chg
     1542        LABEL "&Изменить":L
     1543        SIZE 10 BY 1.
     1544   DEFINE BUTTON B-del
     1545        LABEL "&Удалить"
     1546        SIZE 10 BY 1.
     1547   DEFINE BUTTON B-disc
