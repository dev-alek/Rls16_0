     3163   procedure diasize_init :
     3164     define variable v-default-value    as logical   no-undo .
     3165     define variable v-restore-saved    as logical   no-undo .
     3166     define variable v-resize-value-str as character no-undo .
     3167     do
     3168     on error undo, return error return-value
     3169     :
     3170       do with frame d-cash-pay
     3171       :
     3172         assign
     3173           v-diasize-orig-frame-height = frame d-cash-pay :height
     3174           v-diasize-orig-frame-width  = frame d-cash-pay :width
     3175           v-diasize-browse-handle     = browse br-cashpay :handle
     3176         .
     3177         create button v-diasize-resize-button
     3178         assign
     3179           parent        = frame d-cash-pay :first-child
     3180           label         = "s"
     3181           height-pixels = 16
     3182           width-pixels  = 16
     3183           visible       = true
     3184           sensitive     = true
     3185           movable       = true
     3186           triggers:
     3187             on end-move persistent run diasize_end-move in this-procedure .
     3188           end triggers.
     3189         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     3190         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     3191         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     3192         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     3193         assign
     3194           v-diasize-wndmax = false
     3195         .
     3196         if connected("ub") = true
     3197         then do:
     3198           define variable v-cntxt-db-num        as integer   no-undo .
     3199           define variable v-cntxt-userid        as character no-undo .
     3200           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3201                                             , OUTPUT v-cntxt-userid
     3202                                             ) .
     3203           run gbl/wndpar_r.p
     3204             (input  v-cntxt-db-num
     3205             ,input  v-cntxt-userid
     3206             ,input  'wndmax':U
     3207             ,output v-diasize-wndmax
     3208             ,output v-default-value
     3209             ) .
     3210         end.
     3211         assign
     3212           v-diasize-wndstore = false
     3213         .
     3214         if connected("ub") = true
     3215         then do:
     3216           run gbl/wndpar_r.p
     3217             (input  v-cntxt-db-num
     3218             ,input  v-cntxt-userid
     3219             ,input  'wndstore':U
     3220             ,output v-diasize-wndstore
     3221             ,output v-default-value
     3222             ) .
     3223         end.
     3224         assign
     3225           v-diasize-proc-name = entry(1, program-name(2), '.')
     3226         .
     3227         if v-diasize-wndstore = true
     3228         then do:
     3229           assign
     3230             v-restore-saved = false
     3231           .
     3232           if connected("ub") = true
     3233           then do:
     3234             run gbl/wndsizer.p
     3235               (input  v-cntxt-db-num
     3236               ,input  v-cntxt-userid
     3237               ,input  v-diasize-proc-name
     3238               ,input  'height':u
     3239               ,output v-resize-value-str
     3240               ) .
     3241             if v-resize-value-str <> '':U
     3242             then do:
     3243               run diasize_change-height in this-procedure
     3244                 (input  integer(v-resize-value-str)
     3245                 ,input  true
     3246                 ) .
     3247               assign
     3248                 v-restore-saved = true
     3249               .
     3250             end.
     3251           end.
     3252           if connected("ub") = true
     3253           then do:
     3254             run gbl/wndsizer.p
     3255               (input  v-cntxt-db-num
     3256               ,input  v-cntxt-userid
     3257               ,input  v-diasize-proc-name
     3258               ,input  'width':u
     3259               ,output v-resize-value-str
     3260               ) .
     3261             if v-resize-value-str <> '':U
     3262             then do:
     3263               run diasize_change-width in this-procedure
     3264                 (input  integer(v-resize-value-str)
     3265                 ,input  true
     3266                 ) .
     3267               assign
     3268                 v-restore-saved = true
     3269               .
     3270             end.
     3271           end.
     3272           if v-restore-saved <> true
     3273           then do:
     3274             if v-diasize-wndmax = true
     3275             then do:
     3276               run diasize_maximize in this-procedure
     3277                 (input  true
     3278                 ) .
     3279             end.
     3280           end.
     3281         end.
     3282         else do:
     3283           if v-diasize-wndmax = true
     3284           then do:
     3285             run diasize_maximize in this-procedure
     3286               (input  true
     3287               ) .
     3288           end.
     3289         end.
     3290       end.
     3291     end.
     3292   end procedure.
     3293   procedure diasize_need-full-display :
     3294     define output parameter p-need-full-display as logical   no-undo .
     3295     do
     3296     on error undo, return error return-value
     3297     :
     3298       assign
     3299         p-need-full-display = v-diasize-need-full-display
     3300       .
     3301       assign
     3302         v-diasize-need-full-display = false
     3303       .
     3304     end.
     3305   end procedure.
     3306   procedure get-context :
     3307      define output parameter p-db-num as integer          no-undo.
     3308      define output parameter p-user-id as character        no-undo.
     3309      define variable v-login               as character    no-undo.
     3310      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     3311      define buffer buf_user-login  for ub.user-login .
     3312      do
     3313      on error undo, return error
     3314      :
     3315            FIND FIRST buf_sys-ctrl no-lock.
     3316            ASSIGN
     3317               v-login = USERID("ub")
     3318               p-db-num = buf_sys-ctrl.db-num
     3319            .
     3320            FIND FIRST buf_user-login
     3321                 WHERE buf_user-login.db-num = p-db-num
     3322                   AND buf_user-login.user-login = v-login
     3323                 no-lock
     3324                 no-error
     3325                 .
     3326            IF AVAILABLE buf_user-login
     3327            THEN DO:
     3328               assign
     3329                  p-user-id = buf_user-login.user-id
     3330               .
     3331            END.
     3332      end.
     3333   end procedure.
     3334       run diasize_init in this-procedure .
     3335   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3336   on f5 of frame d-cash-pay anywhere
     3337   do:
     3338      v-rep-rec = ?. if available X_cash-pay then v-rep-rec = recid(X_cash-pay).                run openbr in this-procedure ( input yes, input no, input '':U) no-error.                REPOSITION br-cashpay to recid v-rep-rec No-ERROR.
     3339       apply "VALUE-CHANGED" to br-cashpay.
     3340   end.
     3341   define variable vss-include-info23 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3342   on INS of frame d-cash-pay anywhere do:
