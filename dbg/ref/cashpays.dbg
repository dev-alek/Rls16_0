     1036   procedure cp-attr-manual-edit :
     1037   do on error undo, return error return-value
     1038     :
     1039     define input  parameter p-code           as character no-undo .
     1040     define output parameter p-section-num    as integer no-undo .
     1041       case p-code :
     1042               when 'paycard-export-prefix':U then do:     assign     p-section-num = 1.   end.
     1043               when 'grp-code':U then do:     assign     p-section-num = 1.   end.
     1044               when 'is-use':U then do:     assign     p-section-num = 1.   end.
     1045               when 'dop-doc':U then do:     assign     p-section-num = 1.   end.
     1046               when 'paycard-all-prefix':U then do:     assign     p-section-num = 1.   end.
     1047               when 'form_km3':U then do:     assign     p-section-num = 1.   end.
     1048               when 'bal_malina':U then do:     assign     p-section-num = 1.   end.
     1049               when 'max_proc_sum':U then do:     assign     p-section-num = 1.   end.
     1050               when 'mask_card_kup':U then do:     assign     p-section-num = 1.   end.
     1051         otherwise do:
     1052           undo, return error substitute("неизвестный атрибут типа кассового платежа &1", p-code ).
     1053         end.
     1054       end.
     1055     end.
     1056   end procedure.
