     3995   PROCEDURE proc-find :
     3996   define input parameter p-next as logical no-undo.
     3997   define input parameter p-obj-name like ub.cash-pay.obj-name no-undo.
     3998   assign
     3999   p-obj-name = replace(p-obj-name, chr(34), "":U)
     4000   p-obj-name = replace(p-obj-name, chr(39), chr(39) + chr(39))
     4001   p-obj-name = chr(34) + p-obj-name + chr(34).
     4002   run OpenBr in this-procedure
     4003       (input false
     4004       ,input p-next
     4005       ,input substitute(" and X_cash-pay.obj-name  begins &1 " , p-obj-name)
     4006       ).
     4007   apply "entry":u to f-obj-name in frame d-cash-pay .
     4008   END PROCEDURE.
     4009   FUNCTION get-grp-name RETURNS CHARACTER
     4010     ( INPUT p-cdpay-code AS integer, INPUT p-curr-code AS INTEGER ) :
     4011       DEFINE VARIABLE v-dop AS character NO-UNDO .
     4012      DEFINE VARIABLE v-value AS character NO-UNDO.
     4013      DEFINE VARIABLE v-type AS character NO-UNDO.
     4014        RUN cp-attr-value  IN THIS-PROCEDURE(
     4015          input p-cdpay-code
     4016          ,input p-curr-code
     4017          ,input 0
     4018          ,input '':U
     4019          ,input 0
     4020          ,INPUT 'grp-code':U
     4021          ,output v-value
     4022          ,OUTPUT v-type) NO-ERROR.
     4023        IF NOT ERROR-STATUS:ERROR THEN DO:
     4024            ASSIGN
     4025            v-dop = entry(1, v-value, chr(4))
     4026            .
     4027        END.
     4028        RETURN v-dop.
     4029   END FUNCTION.
     4030   FUNCTION get-wth-name RETURNS CHARACTER
     4031     ( input parwth-code as integer) :
     4032   define buffer buf_wealth for ub.wealth.
     4033   if parwth-code > 0 then do:
     4034       FIND FIRST buf_wealth no-lock where
     4035                        buf_wealth.wth-code = X_cash-pay.wth-code No-ERROR.
     4036           if avail buf_wealth then do:
     4037              return buf_wealth.wth-name .
     4038           end.
     4039        end.
     4040     RETURN "?".
     4041   END FUNCTION.
