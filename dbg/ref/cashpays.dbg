     3128   end procedure.
     3129   procedure diasize_set-browse-handle :
     3130     define input  parameter p-browse-handle as handle   no-undo .
     3131     define buffer buf_temp-browse-handle for temp-browse-handle .
     3132     do
     3133     on error undo, return error return-value
     3134     :
     3135       assign
     3136         v-diasize-browse-handle = p-browse-handle
     3137       .
     3138       for each buf_temp-browse-handle
     3139       on error undo, return error return-value
     3140       :
     3141         delete buf_temp-browse-handle .
