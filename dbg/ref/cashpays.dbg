     1160   procedure prn-lib-open-stream :
     1161     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1162     define input parameter p-page-size    as integer no-undo .
     1163     define input parameter p-is-stream    as logical no-undo .
     1164     define input parameter p-append       as logical no-undo .
     1165     define variable v-report-name as character no-undo .
     1166     do
     1167       on error undo, return error
     1168       :
     1169       run prn-lib-get-report-name  in this-procedure (
     1170         input parParentProc
     1171         ,output v-report-name
     1172         ).
     1173       if p-is-stream then
     1174       do:
     1175         if p-append then
     1176         do:
     1177           output stream PrnLibStream to value( v-report-name )
     1178             page-size value(p-page-size) append .
     1179         end.
     1180         if not p-append then
     1181         do:
     1182           output stream PrnLibStream to value( v-report-name )
     1183             page-size value(p-page-size) .
     1184         end.
     1185       end.
     1186       if not p-is-stream then
     1187       do:
     1188         if p-append then
     1189         do:
     1190           output to value( v-report-name )
     1191             page-size value(p-page-size) append .
     1192         end.
     1193         if not p-append then
     1194         do:
     1195           output to value( v-report-name )
     1196             page-size value(p-page-size) .
     1197         end.
     1198       end.
     1199     end.
     1200   end procedure.
     1201   procedure prn-lib-open-exp :
     1202     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1203     define input parameter p-is-stream    as logical no-undo .
     1204     define input parameter p-is-append    as logical no-undo .
     1205     define output parameter p-ReportFileName as char init "report" no-undo.
     1206     define output parameter p-process as logical no-undo .
     1207     define variable glog as logical no-undo .
     1208     do
     1209       on error undo, return error
     1210       :
     1211       SYSTEM-DIALOG GET-FILE p-ReportFileName
     1212         TITLE      "Укажите путь"
     1213         FILTERS "Текстовый файл (*.txt)"   "*.txt"
     1214         ASK-OVERWRITE
     1215         CREATE-TEST-FILE
     1216         SAVE-AS
     1217         USE-FILENAME
     1218         DEFAULT-EXTENSION "txt"
     1219         UPDATE glog
     1220         .
     1221       if not glog then  return.
     1222       p-ReportFileName = trim( string( p-ReportFileName ) ) .
     1223       if p-is-stream then
     1224       do:
     1225         if p-is-append then
     1226         do:
     1227           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1228         end.
     1229         else
     1230         do:
     1231           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1232         end.
     1233       end.
     1234       else
     1235       do:
     1236         if p-is-append then
     1237         do:
     1238           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1239         end.
     1240         else
     1241         do:
     1242           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1243         end.
     1244       end.
     1245       p-process = yes.
     1246     end.
     1247   end procedure.
