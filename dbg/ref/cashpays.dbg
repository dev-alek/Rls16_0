     1258   procedure prn-lib-reportviewer :
     1259     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1260     define input parameter p-report-name-html as character no-undo .
     1261     define input parameter p-param        as character no-undo .
     1262     define variable v-excel           as character no-undo init 'TRUE' .
     1263     define variable v-value-character as character no-undo .
     1264     define variable v-value-integer   as character no-undo .
     1265     define variable v-value-date      as date      no-undo .
     1266     define variable v-value-decimal   as decimal   no-undo .
     1267     define variable rep-excel         as logical   no-undo .
     1268     define variable excel-string      as character no-undo .
     1269     define variable v-param-type      as character no-undo .
     1270     define variable v-tth             as handle    no-undo .
     1271     run adm/shattri.p (
     1272       input "get":U
     1273       ,input  ""
     1274       ,input  0
     1275       ,input  'report-glob':U
     1276       ,input  'rep-excel':U
     1277       ,output v-value-character
     1278       ,output v-value-date
     1279       ,output v-value-decimal
     1280       ,output v-value-integer
     1281       ,output rep-excel
     1282       ,output v-param-type
     1283       ,INPUT-OUTPUT table-handle v-tth
     1284       )  .
     1285     if rep-excel then v-excel = "TRUE" .
     1286     else v-excel = "FALSE" .
     1287     if p-param eq ""
     1288     then
     1289        p-param = "EXCEL:" + v-excel.
     1290     else
     1291        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
     1292     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
     1293   end procedure.
