        1   DEFINE TEMP-TABLE tt-ex-mark NO-UNDO LIKE ub.ex-mark.
        2   define input parameter parParentProc as widget-handle no-undo.
        3   define input parameter p-mode        as character no-undo.
        4   define input parameter p-mark-type   as integer no-undo.
        5   define input-output parameter p-rec  as recid no-undo.
        6   def var vss-revision    as character no-undo init "$Revision$":U .
        7   def var vss-author      as character no-undo init "$Author$":U .
        8   def var vss-date        as character no-undo init "$Date$":U .
        9   def var vss-workfile    as character no-undo init "$Workfile$":U .
       10   def var vss-archive     as character no-undo init "$Archive$":U .
       11   def var vss-description as character no-undo init "Корректировка акцизной или специальной марки".
       12   procedure vss-get-info :
       13     define output parameter p-vss-revision    like vss-revision    no-undo .
       14     define output parameter p-vss-author      like vss-author      no-undo .
       15     define output parameter p-vss-date        like vss-date        no-undo .
       16     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       17     define output parameter p-vss-archive     like vss-archive     no-undo .
       18     define output parameter p-vss-description like vss-description no-undo .
       19     assign
       20       p-vss-revision    = vss-revision
       21       p-vss-author      = vss-author
       22       p-vss-date        = vss-date
       23       p-vss-workfile    = vss-workfile
       24       p-vss-archive     = vss-archive
       25       p-vss-description = vss-description
       26     .
       27   end procedure.
       28   procedure vss-get-parameters :
       29     define output parameter p-vss-parameters as character no-undo .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define new global shared variable g#language as character no-undo .
       67   if g#language <> '' and g#language <> 'rus':U then do:
       68     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       69   end.
       70   define new global shared variable g#library  as handle no-undo .
       71   define new global shared variable g#library2 as handle no-undo .
       72   procedure proc-alt-shift-f2:
       73     if not ibs.th.gbl.gbl-var:rcode
       74   then
       75     run gbl\inidebug.p .
       76   end.
       77   procedure proc-alt-shift-f3:
       78     run gbl/prvssinf.p
       79       ( input this-procedure
       80       ) .
       81   end.
       82   define variable v-inform-launched as logical no-undo initial false .
       83   procedure proc-alt-shift-f4:
       84     define variable v-action as character no-undo .
       85     if v-inform-launched = false then do:
       86       assign
       87         v-inform-launched = true
       88       .
       89       run gbl/d-inform.w
       90         (  input self
       91         ,  input this-procedure
       92         , output v-action
       93         ) no-error .
       94       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       95       assign
       96         v-inform-launched = false
       97       .
       98     end.
       99   end.
      100   procedure proc-alt-f1:
      101     run gbl/corrhelp.p
      102       (input this-procedure
      103       ) .
      104   end .
      105   on alt-shift-f2 anywhere do:
      106     run proc-alt-shift-f2.
      107   end.
      108   on alt-shift-f3 anywhere do:
      109     run proc-alt-shift-f3 in this-procedure .
      110   end.
      111   on alt-shift-f4 anywhere do:
      112     run proc-alt-shift-f4 in this-procedure.
      113   end.
      114   on alt-f1 anywhere do:
      115     run proc-alt-f1 in this-procedure .
      116   end.
      117   define variable v-db-num like ub.db.db-num no-undo.
      118   define buffer locked_ex-mark for ub.ex-mark.
      119   define buffer locked_ex-mark-attr for ub.ex-mark-attr.
      120   DEFINE BUTTON B-exit AUTO-GO
      121        LABEL "&Ввод"
      122        SIZE 10 BY 1
      123        BGCOLOR 8 .
      124   DEFINE BUTTON B-Help
      125        LABEL "Помо&щь"
      126        SIZE 10 BY 1
      127        BGCOLOR 8 .
      128   DEFINE BUTTON B-quit AUTO-END-KEY
      129        LABEL "&Отмена"
      130        SIZE 10 BY 1
      131        BGCOLOR 8 .
      132   DEFINE VARIABLE FILL-IN-Date-to AS DATE FORMAT "99/99/9999":U INITIAL ?
      133        LABEL "Действительна до"
      134        VIEW-AS FILL-IN
      135        SIZE 14 BY 1 NO-UNDO.
      136   DEFINE VARIABLE FILL-IN-Descr AS CHARACTER FORMAT "X(256)":U INITIAL "Тип марки:"
      137         VIEW-AS TEXT
      138        SIZE 10.6 BY .67 NO-UNDO.
      139   DEFINE VARIABLE r-mark-type AS INTEGER
      140        VIEW-AS RADIO-SET VERTICAL
      141        RADIO-BUTTONS
      142             "Специальная", 0,
      143   "Акцизная", 1
      144        SIZE 22 BY 1.62 NO-UNDO.
      145   DEFINE QUERY Dialog-Frame FOR
      146         tt-ex-mark SCROLLING.
      147   DEFINE FRAME Dialog-Frame
      148        B-exit AT ROW 1 COL 1
      149        B-quit AT ROW 1 COL 11
      150        B-Help AT ROW 1 COL 50.6
      151        tt-ex-mark.mark-name AT ROW 4.71 COL 24 COLON-ALIGNED
      152             LABEL "Код марки" FORMAT "X(20)"
      153             VIEW-AS FILL-IN
      154             SIZE 30.6 BY 1
      155        r-mark-type AT ROW 6.05 COL 26 NO-LABEL
      156        FILL-IN-Date-to AT ROW 7.91 COL 24 COLON-ALIGNED WIDGET-ID 2
      157        tt-ex-mark.db-num AT ROW 2.62 COL 24 COLON-ALIGNED
      158             LABEL "Код БД создания"
      159              VIEW-AS TEXT
      160             SIZE 5.6 BY .67
      161             FGCOLOR 4
      162        tt-ex-mark.mark-code AT ROW 3.67 COL 24 COLON-ALIGNED
      163             LABEL "Внутренний код"
      164              VIEW-AS TEXT
      165             SIZE 10 BY .67
      166             FGCOLOR 4
      167        FILL-IN-Descr AT ROW 6.05 COL 13 COLON-ALIGNED NO-LABEL
      168        SPACE(37.59) SKIP(2.75)
      169       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      170            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      171            TITLE "Акцизная или специальная марка"
      172            DEFAULT-BUTTON B-exit CANCEL-BUTTON B-quit.
      173   ASSIGN
      174          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      175          FRAME Dialog-Frame:HIDDEN           = TRUE.
      176   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      177   DO:
      178     APPLY "END-ERROR":U TO SELF.
      179   END.
      180   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
      181   DO:
      182   define variable vss-include-info0 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      183   if lookup(self :type
      184            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      185            ) = 0
      186   then do:
      187     message
      188       "$Workfile$"
      189       "Указанному интерфейсному элементу фокус не может быть передан" skip
      190       "Интерфейсный элемент" self :name  skip
      191       "Тип" self :type  skip
      192       "Процедура" this-procedure :file-name skip
      193       view-as alert-box .
      194   end.
      195   else do:
      196     apply "entry":u to self  .
      197     if focus :handle <> self :handle  then do:
      198       return no-apply .
      199     end.
      200   end.
      201     if p-mode = 'ПРОСМОТР':U then return no-apply.
      202     do on error undo, return no-apply:
      203       run proc-save in this-procedure.
      204     end.
      205   END.
      206   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      207   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      208   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      209   on help of frame Dialog-Frame
      210   do:
      211     run gbl/app_help.p
      212       (input this-procedure :file-name
      213       ,input ''
      214       ,input ?
      215       ) no-error.
      216     if error-status :error then do:
      217       message
      218         "Ошибка при вызове помощи"
      219         error-status :get-message(1)
      220         view-as alert-box .
      221     end.
      222   end.
      223   run minbtn-set in this-procedure .
      224   on choose of b-help in frame Dialog-Frame
      225   do:
      226     apply "help":u to frame Dialog-Frame .
      227   end.
      228   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      229   procedure minbtn-set :
      230       do
      231           on error undo, return error return-value
      232           :
      233           define variable ii              as integer       no-undo .
      234           define variable fh              as widget-handle no-undo .
      235           define variable hh              as widget-handle no-undo .
      236           define variable v-h             as handle        extent 4 no-undo .
      237           define variable v-name-button   as character     no-undo .
      238           define variable v-help-old-x    as decimal       no-undo .
      239           define variable v-help-old-y    as decimal       no-undo .
      240           define variable v-help-old-size as decimal       no-undo .
      241           define variable v-frame-width   as decimal       no-undo .
      242           define variable jj              as integer       no-undo .
      243           do
      244               on error undo, return error
      245               :
      246               assign
      247                   v-frame-width = frame Dialog-Frame:width - 0.3
      248                   fh            = frame Dialog-Frame:first-child
      249                   hh            = fh:first-child
      250                   ii            = 1
      251                   .
      252               do while valid-handle(hh):
      253                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      254                   do:
      255                       case lc(hh:name) :
      256                           when "b-help" then
      257                               do:
      258                                   hh:load-image-up("cmp/b-help.bmp":u) .
      259                                   hh:load-image-down("cmp/b-help.bmp":u) .
      260                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      261                                   hh:TOOLTIP = "Помощь" .
      262                                   v-help-old-x = hh:column .
      263                                   v-help-old-y = hh:row    .
      264                                   v-help-old-size = hh:width .
      265                                   hh:width-chars = 2.5 .
      266                               end.
      267                           when "b-print" then
      268                               do:
      269                                   hh:load-image("cmp/b-print.bmp":u) .
      270                                   hh:TOOLTIP = "Печать" .
      271                                   v-h[ii] = hh:handle .
      272                                   ii = ii + 1 .
      273                                   hh:width-chars = 3 .
      274                               end.
      275                           when "b-history" or
      276                           when "b-hist" then
      277                               do:
      278                                   hh:load-image("cmp/b-hist.bmp":u) .
      279                                   hh:TOOLTIP = "История" .
      280                                   v-h[ii] = hh:handle .
      281                                   ii = ii + 1 .
      282                                   hh:width-chars = 3 .
      283                               end.
      284                           when "b-sch" then
      285                               do:
      286                                   hh:load-image("cmp/b-sch.bmp":u) .
      287                                   hh:TOOLTIP = "Установка Фильтра" .
      288                                   v-h[ii] = hh:handle .
      289                                   ii = ii + 1 .
      290                                   hh:width-chars = 3 .
      291                               end.
      292                           when "b-hist-user" then
      293                               do:
      294                                   hh:load-image("cmp/b-hist.bmp":u) .
      295                                   hh:TOOLTIP = "История пользователя" .
      296                                   ii = ii + 1 .
      297                               end.
      298                       end case.
      299                   end.
      300                   hh = hh:next-sibling.
      301               end.
      302               b-help:column = v-frame-width - b-help:width-chars.
      303               jj = 0.
      304               repeat ii = 4 to 1 by -1 :
      305                   if valid-handle (v-h[ii] ) then
      306                   do:
      307                       jj  = jj + 1 .
      308                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      309                       v-h[ii]:row    = v-help-old-y .
      310                   end.
      311               end.
      312           end.
      313       end.
      314   end procedure.
      315   assign frame Dialog-Frame:title = frame Dialog-Frame:title + " - " + p-mode.
      316   MAIN-BLOCK:
      317   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      318      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      319     if p-mode <> 'ДОБАВЛЕНИЕ':U and
      320        p-mode <> 'ИЗМЕНЕНИЕ':U  and
      321        p-mode <> 'ПРОСМОТР':U
      322     then do:
      323       message
      324         vss-workfile vss-revision vss-description skip
      325         "Неверное значение параметров вызова p-mode"  p-mode
      326         view-as alert-box error.
      327       return error.
      328     end.
      329     if p-mode = 'ПРОСМОТР':U then do:
      330       find first locked_ex-mark no-lock
      331         where recid(locked_ex-mark) = p-rec no-error .
      332       if not available locked_ex-mark then do:
      333         message
      334           "Не найдена запись Акцизной или Специальной марки"
      335           view-as alert-box error.
      336           return error.
      337       end.
      338     end.
      339     if p-mode = 'ИЗМЕНЕНИЕ':U then
      340     do transaction on error undo, return error:
      341       find first locked_ex-mark exclusive-lock
      342         where recid(locked_ex-mark) = p-rec no-error no-wait.
      343       if not available locked_ex-mark then do:
      344         if locked locked_ex-mark then do:
      345           message "Запись редактируется другим пользователем"
      346             view-as alert-box error.
      347         end.
      348         else do:
      349           message "Не найдена запись Акцизной или Специальной марки"
      350             view-as alert-box error.
      351         end.
      352         return error.
      353       end.
      354     end.
      355     create tt-ex-mark.
      356     if p-mode = 'ДОБАВЛЕНИЕ':U then do:
      357   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      358   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
      359     (output v-db-num
      360     )  .
      361       assign
      362         tt-ex-mark.db-num    = v-db-num
      363         tt-ex-mark.mark-code = 0
      364         tt-ex-mark.mark-type = 0
      365       .
      366       if p-mark-type <> ? then do:
      367         assign
      368           tt-ex-mark.mark-type = p-mark-type
      369         .
      370       end.
      371     end.
      372     else do:
      373       buffer-copy locked_ex-mark to tt-ex-mark.
      374     end.
      375     run MyEnable in this-procedure.
      376     WAIT-FOR GO OF FRAME Dialog-Frame.
      377   END.
      378   RUN disable_UI.
      379   PROCEDURE disable_UI :
      380     HIDE FRAME Dialog-Frame.
      381   END PROCEDURE.
      382   PROCEDURE enable_UI :
      383     OPEN QUERY Dialog-Frame FOR EACH tt-ex-mark SHARE-LOCK.
      384     GET FIRST Dialog-Frame.
      385     DISPLAY r-mark-type FILL-IN-Date-to FILL-IN-Descr
      386         WITH FRAME Dialog-Frame.
      387     IF AVAILABLE tt-ex-mark THEN
      388       DISPLAY tt-ex-mark.mark-name tt-ex-mark.db-num tt-ex-mark.mark-code
      389         WITH FRAME Dialog-Frame.
      390     ENABLE B-exit B-quit B-Help tt-ex-mark.mark-name r-mark-type FILL-IN-Date-to
      391         WITH FRAME Dialog-Frame.
      392     VIEW FRAME Dialog-Frame.
      393   END PROCEDURE.
      394   PROCEDURE MyEnable :
      395     if available tt-ex-mark then do:
      396       r-mark-type = tt-ex-mark.mark-type.
      397     end.
      398     find first locked_ex-mark-attr no-lock
      399       where locked_ex-mark-attr.db-num = tt-ex-mark.db-num
      400       and locked_ex-mark-attr.mark-code = tt-ex-mark.mark-code
      401       and locked_ex-mark-attr.attr-code = "exp-date" no-error.
      402     if available locked_ex-mark-attr then do:
      403       FILL-IN-Date-to = date(locked_ex-mark-attr.attr-value).
      404     end.
      405     display
      406       tt-ex-mark.db-num
      407       tt-ex-mark.mark-code
      408       tt-ex-mark.mark-name
      409       r-mark-type
      410       FILL-IN-Date-to
      411      with frame Dialog-Frame.
      412     view frame Dialog-Frame.
      413     enable B-quit B-Help
      414       with frame Dialog-Frame.
      415     if p-mode = 'ПРОСМОТР':U then do:
      416       assign
      417         b-exit:label  = "&Выход"
      418       .
      419       hide b-quit in frame Dialog-Frame.
      420     end.
      421     else do:
      422       enable B-exit
      423              tt-ex-mark.mark-name
      424              r-mark-type when p-mark-type = ?
      425              FILL-IN-Date-to
      426         with frame Dialog-Frame.
      427       apply "entry" to tt-ex-mark.mark-name in frame Dialog-Frame.
      428     end.
      429     return.
      430   END PROCEDURE.
      431   PROCEDURE proc-save :
      432     define variable v-new-code like ex-mark.mark-code no-undo.
      433     define buffer buf_ex-mark for ub.ex-mark.
      434     if p-mode = 'ПРОСМОТР':U then do:
      435         return error.
      436     end.
      437     assign frame Dialog-Frame
      438       tt-ex-mark.mark-name
      439       r-mark-type
      440       FILL-IN-Date-to
      441     .
      442     if tt-ex-mark.mark-name = "":U then do:
      443       message "Не указан код марки"
      444         view-as alert-box error.
      445       apply "entry" to tt-ex-mark.mark-name in frame Dialog-Frame.
      446       return error.
      447     end.
      448     find first buf_ex-mark no-lock
      449       where buf_ex-mark.mark-name = tt-ex-mark.mark-name
      450         and buf_ex-mark.stts      = integer('0':U)
      451         and (p-mode = 'ДОБАВЛЕНИЕ':U or p-rec <> recid(buf_ex-mark))
      452       no-error.
      453     if available buf_ex-mark then do:
      454       message substitute("Уже существует &1 марка с указанным кодом"
      455                         , (if buf_ex-mark.mark-type = 0 then "Специальная"
      456                                                         else "Акцизная")
      457                         )
      458         view-as alert-box error.
      459       apply "entry" to tt-ex-mark.mark-name in frame Dialog-Frame.
      460       return error.
      461     end.
      462     do on error undo, return error
      463        on stop  undo, return error
      464       :
      465       if p-mode = 'ДОБАВЛЕНИЕ':U then do:
      466         create locked_ex-mark.
      467         assign
      468           locked_ex-mark.db-num    = v-db-num
      469           locked_ex-mark.mark-code = NEXT-VALUE( s-ex-mark, ub )
      470         .
      471         if FILL-IN-Date-to <> ? then do:
      472           create locked_ex-mark-attr.
      473           assign
      474           locked_ex-mark-attr.db-num = locked_ex-mark.db-num
      475           locked_ex-mark-attr.mark-code = locked_ex-mark.mark-code
      476           locked_ex-mark-attr.attr-code = "exp-date"
      477           locked_ex-mark-attr.attr-value = string(FILL-IN-Date-to).
      478         end.
      479       end.
      480       else do:
      481         find current locked_ex-mark exclusive-lock.
      482         find first locked_ex-mark-attr exclusive-lock
      483               where locked_ex-mark-attr.db-num = locked_ex-mark.db-num
      484                 and locked_ex-mark-attr.mark-code = locked_ex-mark.mark-code
      485                 and locked_ex-mark-attr.attr-code = "exp-date" no-error.
      486         if not available(locked_ex-mark-attr) and FILL-IN-Date-to <> ? then do:
      487               create locked_ex-mark-attr.
      488               assign
      489               locked_ex-mark-attr.db-num = locked_ex-mark.db-num
      490               locked_ex-mark-attr.mark-code = locked_ex-mark.mark-code
      491               locked_ex-mark-attr.attr-code = "exp-date"
      492               locked_ex-mark-attr.attr-value = string(FILL-IN-Date-to).
      493         end.
      494         else do:
      495           if FILL-IN-Date-to <> ? then
      496           locked_ex-mark-attr.attr-value = string(FILL-IN-Date-to).
      497         end.
      498       end.
      499       assign
      500         locked_ex-mark.mark-type = r-mark-type
      501         locked_ex-mark.mark-name = tt-ex-mark.mark-name
      502       .
      503       p-rec = recid(locked_ex-mark).
      504       release locked_ex-mark no-error.
      505       if error-status:error then do:
      506         message
      507           vss-workfile vss-revision vss-description skip
      508           "Ошибка при сохранении записи Акцизной или Специальной марки" skip
      509           error-status :get-message(1) skip
      510           return-value skip
      511           view-as alert-box error .
      512         undo, return error.
      513       end.
      514     end.
      515     return.
      516   END PROCEDURE.
