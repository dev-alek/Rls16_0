      121   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      122   procedure cur-time :
      123      define output parameter p-today as date      no-undo .
      124      define output parameter p-time  as integer   no-undo .
      125     do
      126     on error undo, return error
      127     :
      128       define variable v-date1 as date      no-undo .
      129       define variable v-date2 as date      no-undo .
      130       define variable v-time  as integer   no-undo .
      131       assign
      132         v-date1 = today
      133         v-time  = time
      134         v-date2 = today
      135       .
      136       if v-date1 <> v-date2
      137       then do:
      138         assign
      139           v-date1 = today
      140           v-time  = v-time
      141         .
      142       end.
      143       assign
      144         p-today = v-date1
      145         p-time  = v-time
      146       .
      147     end.
      148   end.
      149   function cur-time-date returns character
      150   :
      151     return string(today, '99/99/9999':U) .
      152   end.
      153   function cur-time-mjd returns decimal
      154   :
      155     define variable v-date as date      no-undo .
      156     define variable v-time as integer   no-undo .
      157     run cur-time in this-procedure
      158       (output v-date
      159       ,output v-time
      160       ) .
      161     return integer(v-date) - 2400002 + (v-time / 86400) .
      162   end.
      163   function cur-time-get-ending-index returns integer
      164   (input p-number as integer
      165   )
      166   :
      167     if p-number < 0
      168     or p-number = ?
      169     then do:
      170       return 1 .
      171     end.
      172     define variable v-rest as integer   no-undo .
      173     assign
      174       p-number = p-number modulo 100
      175     .
      176     if p-number < 20
      177     then do:
      178       assign
      179         v-rest = p-number
      180       .
      181     end.
      182     else do:
      183       assign
      184         v-rest = p-number modulo 10
      185       .
      186     end.
      187     case v-rest :
      188       when 1
      189       then do:
      190         return 2 .
      191       end.
      192       when 2 or
      193       when 3 or
      194       when 4
      195       then do:
      196         return 3 .
      197       end.
      198       otherwise do:
      199         return 1 .
      200       end.
      201     end case .
      202   end.
      203   procedure cur-time-mjd-to-date :
      204      define input  parameter i-mjd-diff as decimal no-undo.
      205      define output parameter o-Date     as date    no-undo.
      206      define output parameter o-Time     as integer no-undo.
      207      define variable v-day-number as integer   no-undo .
      208      if    i-mjd-diff < 0
      209         or i-mjd-diff = ?
      210      then do:
      211         return "?" .
      212      end.
      213      assign
      214         v-day-number = truncate(i-mjd-diff,0).
      215         o-Date = date(v-day-number + 2400002).
      216         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      217     .
      218   end.
      219   function cur-time-mjd-to-string returns character
      220   (input p-mjd-diff as decimal
      221   )
      222   :
      223     define variable v-day-number as integer   no-undo .
      224     define variable v-seconds    as integer   no-undo .
      225     define variable v-hour       as integer   no-undo .
      226     define variable v-min        as integer   no-undo .
      227     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      228     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      229     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      230     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      231     if p-mjd-diff < 0
      232     or p-mjd-diff = ?
      233     then do:
      234       return "?" .
      235     end.
      236     assign
      237       v-day-number = integer(truncate(p-mjd-diff,0))
      238       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      239     .
      240     if v-seconds > 86400
      241     then do:
      242       assign
      243         v-seconds = 86400 - 1
      244       .
      245     end.
      246     if v-seconds < 0
      247     then do:
      248       assign
      249         v-seconds = 0
      250       .
      251     end.
      252     assign
      253       v-hour = truncate(v-seconds / 3600, 0)
      254     .
      255     assign
      256       v-seconds = v-seconds modulo 3600
      257     .
      258     assign
      259       v-min = truncate(v-seconds / 60, 0)
      260     .
      261     assign
      262       v-seconds = v-seconds modulo 60
      263     .
      264     return
      265         (if v-day-number <> 0
      266           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      267           else ""
      268         )
      269       + (if v-day-number <> 0 or v-hour <> 0
      270           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      271           else ""
      272         )
      273       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      274           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      275           else ""
      276         )
      277       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      278       .
      279   end.
      280   function cur-time-string returns character
      281   :
      282     define variable v-date as date      no-undo .
      283     define variable v-time as integer   no-undo .
      284     run cur-time in this-procedure
      285       (output v-date
      286       ,output v-time
      287       ) .
      288     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      289   end.
      290   function cur-time-string-sec returns character
      291   :
      292     define variable v-date as date      no-undo .
      293     define variable v-time as integer   no-undo .
      294     run cur-time in this-procedure
      295       (output v-date
      296       ,output v-time
      297       ) .
      298     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      299   end.
      300   function cur-time-custom  returns character
      301   (input p-prefix as character
      302   ,input p-date-format as character
      303   ,input p-delimiter as character
      304   ,input p-time-format as character
      305   ,input p-suffix as character
      306   )
      307   :
      308     define variable v-date as date      no-undo .
      309     define variable v-time as integer   no-undo .
      310     run cur-time in this-procedure
      311       (output v-date
      312       ,output v-time
      313       ) .
      314     return
      315       p-prefix
      316       + string(v-date, p-date-format)
      317       + p-delimiter
      318       + string(v-time, p-time-format)
      319       + p-suffix
      320       .
      321   end.
      322   function cur-time-print  returns character
      323   :
      324     define variable v-date as date      no-undo .
      325     define variable v-time as integer   no-undo .
      326     run cur-time in this-procedure
      327       (output v-date
      328       ,output v-time
      329       ) .
      330     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      331   end.
      332   function cur-time-datetime returns datetime
      333   :
      334     define variable v-char as character no-undo .
      335     define variable v-datetime as datetime no-undo .
      336     v-char = cur-time-string().
      337     v-datetime = datetime(v-char).
      338     return  v-datetime.
      339   end.
      340   function cur-time-string-msec returns character
      341   :
      342     define variable v-date as datetime  no-undo .
      343     v-date = now.
      344     return string(v-date) .
      345   end.
      346   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      347   define temp-table temp-index_name-value no-undo
      348   field name-key  as character
      349   field value-key as character
      350   index pi name-key
      351   .
      352   define temp-table temp-sub-index_name no-undo
      353   field name-key  as character
      354   field nn as integer
      355   index pi nn
      356   .
      357   procedure def-hash :
      358     do
      359     on error undo, return error return-value
      360     :
      361     define input  parameter p-full-string as character no-undo .
      362     define output parameter p-possb-keep-string as logical   no-undo .
      363     define output parameter p-string            as character no-undo .
      364     define output parameter p-hash-string       as character no-undo .
      365       p-full-string = trim( p-full-string ) .
      366       if length (p-full-string ) > 150 then do:
      367       assign
      368         p-possb-keep-string =  false
      369         p-string            =  substring(p-full-string,1,150)
      370         p-hash-string       =  encode(p-full-string)
      371       .
      372       end.
      373       else do:
      374       assign
      375         p-possb-keep-string =  true
      376         p-string            =  p-full-string
      377         p-hash-string       =  encode(p-full-string)
      378       .
      379       end.
      380     end.
      381   end procedure.
      382   procedure find-from-hash :
      383     do
      384     on error undo, return error return-value
      385     :
      386   define input  parameter  p-full-string            as character no-undo .
      387   define input  parameter  p-table-name             as character no-undo .
      388   define input  parameter  p-field-possb-keep-name  as character no-undo .
      389   define input  parameter  p-field-string-name      as character no-undo .
      390   define input  parameter  p-field-hash-string-name as character no-undo .
      391   define input  parameter  p-sub-table-name         as character no-undo .
      392   define output parameter  p-recid                  as recid     no-undo .
      393   define variable v-possb-keep-string as logical   no-undo .
      394   define variable v-string            as character no-undo .
      395   define variable v-hash-string       as character no-undo .
      396   define variable v-query-prepare     as character no-undo .
      397   define variable i  as integer no-undo .
      398   define variable qh as widget-handle no-undo .
      399   define variable bh as widget-handle no-undo .
      400   define variable p-rez as logical   no-undo .
      401   run def-hash in this-procedure (input  p-full-string ,
      402                 output v-possb-keep-string ,
      403                 output v-string            ,
      404                 output v-hash-string
      405                 ).
      406   p-recid = ? .
      407   create buffer bh for table p-table-name.
      408   create query qh.
      409      v-query-prepare =
      410       "for each " + p-table-name + " no-lock where "
      411       + p-field-possb-keep-name   + " = "  + string(v-possb-keep-string) + " and "
      412       + p-field-string-name       + " = '" + v-string            + "' and "
      413       + p-field-hash-string-name  + " = '" + v-hash-string       + "'"
      414       .
      415   if v-possb-keep-string = true then do:
      416       qh:set-buffers(bh).
      417       qh:query-prepare(v-query-prepare).
      418       qh:query-open.
      419       qh:get-first.
      420       p-recid = bh:recid.
      421   end.
      422   else do:
      423   message false "анализ hash" .
      424     qh:set-buffers(bh).
      425     qh:query-prepare(v-query-prepare).
      426     qh:query-open.
      427     qh:get-first.
      428     p-recid = bh:recid.
      429     repeat :
      430       qh:get-next.
      431       if bh:available then do:
      432          qh:get-first.
      433          run ver-sub-table in this-procedure (
      434              input  p-full-string ,
      435              input  p-table-name ,
      436              input  p-sub-table-name ,
      437              input  bh:recid  ,
      438              output p-rez
      439              ).
      440          if p-rez = true  then do:
      441             p-recid = bh:recid .
      442             leave.
      443          end.
      444          else do:
      445            next.
      446          end.
      447       end.
      448       leave.
      449     end.
      450   end.
      451   delete widget bh.
      452   delete widget qh.
      453     end.
      454   end procedure.
      455   procedure ver-sub-table :
      456     do
      457     on error undo, return error return-value
      458     :
      459   define input  parameter p-full-string as character no-undo .
      460   define input  parameter p-name-table as character no-undo .
      461   define input  parameter p-sub-name-table as character no-undo .
      462   define input  parameter p-recid as recid no-undo .
      463   define output parameter p-ok as logical   no-undo .
      464   define variable v-query-prepare     as character no-undo .
      465   define variable i  as integer no-undo .
      466   define variable qh as widget-handle no-undo .
      467   define variable bh as widget-handle no-undo .
      468   define variable p-rez as logical   no-undo .
      469   for each temp-index_name-value : delete temp-index_name-value . end.
      470   for each temp-sub-index_name : delete temp-sub-index_name . end.
      471       create buffer bh for table p-name-table.
      472       create query qh.
      473       v-query-prepare = "for each " + p-name-table + " no-lock where recid(" + p-name-table + ") = " + string ( p-recid ) .
      474       qh:set-buffers(bh).
      475       qh:query-prepare(v-query-prepare).
      476       qh:query-open.
      477       qh:get-first.
      478       p-recid = bh:recid.
      479   define variable v-inf-ind AS CHAR NO-UNDO.
      480   define variable v-name-pi as character no-undo .
      481   define variable v-num-fl-inkey as integer   no-undo .
      482   define variable v-num-fl       as integer   no-undo .
      483   define variable j as integer   no-undo .
      484   v-name-pi = bh:PRIMARY .
      485   v-inf-ind = "1".
      486   i = 0.
      487   DO while ( v-inf-ind <> ? )
      488       on error undo, return error:
      489       i = i + 1 .
      490       v-inf-ind = bh:INDEX-INFORMATION(i) .
      491       if v-inf-ind = ? then leave.
      492       if entry( 1 , v-inf-ind ) = v-name-pi then do:
      493          v-num-fl-inkey = ( num-entries(v-inf-ind) - 4 ) / 2 .
      494          v-num-fl       = ( num-entries(v-inf-ind) - 4 )     .
      495         if v-num-fl-inkey >= 1 then do:
      496             do j = 5 to v-num-fl  by 2 :
      497                 create temp-index_name-value .
      498                 assign
      499                   temp-index_name-value.name-key  = entry( j , v-inf-ind )
      500                   temp-index_name-value.value-key = bh:BUFFER-FIELD(entry( j , v-inf-ind )):BUFFER-VALUE
      501                 .
      502             end.
      503          end.
      504       end.
      505   END.
      506   define variable qh-sub as widget-handle no-undo .
      507   define variable bh-sub as widget-handle no-undo .
      508       create buffer bh-sub for table p-sub-name-table.
      509       create query qh-sub.
      510   define variable k as integer   no-undo init 0 .
      511       v-query-prepare = "for each " + p-sub-name-table + " no-lock where " .
      512       for each temp-index_name-value :
      513           v-query-prepare = v-query-prepare  + p-sub-name-table + "." + temp-index_name-value.name-key +
      514                         " = " + temp-index_name-value.value-key + " and " .
      515       end.
      516       v-query-prepare = v-query-prepare + " true = true " .
      517       qh-sub:set-buffers(bh-sub).
      518       qh-sub:query-prepare(v-query-prepare).
      519       qh-sub:query-open.
      520         v-name-pi = bh-sub:PRIMARY .
      521         v-inf-ind = "1".
      522         i = 0.
      523         DO while ( v-inf-ind <> ? )
      524             on error undo, return error:
      525             i = i + 1 .
      526             v-inf-ind = bh-sub:INDEX-INFORMATION(i) .
      527             if v-inf-ind = ? then leave.
      528             if entry( 1 , v-inf-ind ) = v-name-pi then do:
      529               v-num-fl-inkey = ( num-entries(v-inf-ind) - 4 ) / 2 .
      530               v-num-fl       = ( num-entries(v-inf-ind) - 4 )     .
      531               if v-num-fl-inkey >= 1 then do:
      532                   do j = 5 to v-num-fl  by 2 :
      533                       if not can-find (first temp-index_name-value  where temp-index_name-value.name-key =  entry( j , v-inf-ind )) then do:
      534                           create temp-sub-index_name .
      535                           assign
      536                             temp-sub-index_name.name-key  = entry( j , v-inf-ind )
      537                             temp-sub-index_name.nn  = j
      538                           .
      539                       end.
      540                   end.
      541               end.
      542             end.
      543         END.
      544         define variable v-qw as character no-undo .
      545         v-qw = "".
      546         qh-sub:GET-first.
      547         DO WHILE (bh-sub:AVAILABLE):
      548           for each temp-sub-index_name :
      549               v-qw = v-qw + string(bh-sub:BUFFER-FIELD(temp-sub-index_name.name-key):BUFFER-VALUE) .
      550           end.
      551           v-qw = v-qw + ",".
      552           qh-sub:GET-NEXT.
      553         END.
      554         p-ok = false .
      555         if trim(p-full-string, ",")  =  trim (v-qw, ",") then p-ok = true  .
      556       delete widget bh-sub.
      557       delete widget qh-sub.
      558       delete widget bh.
      559       delete widget qh.
      560     end.
      561   end procedure.
      562   PROCEDURE update-rang-def :
