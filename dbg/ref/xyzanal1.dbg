       33   define input PARAMETER TABLE FOR    x-XYZ-analysis-period.
       34   define variable  v-list-obj          like ub.XYZ-analysis.XYZ-hash-string-obj          no-undo .
       35   define variable  v-list-period       like ub.XYZ-analysis.XYZ-hash-string-period       no-undo .
