       26   define input parameter p-xyz-z-prc-qnty           like ub.XYZ-analysis.xyz-z-prc-qnty                   no-undo .
       27   define input parameter p-xyz-z-qnty               like ub.XYZ-analysis.xyz-z-qnty                       no-undo .
       28   define input parameter p-xyz-z-sum-prc            like ub.XYZ-analysis.xyz-z-sum-prc                    no-undo .
       29   define input parameter p-xyz-z-sum                like ub.XYZ-analysis.xyz-z-sum                        no-undo .
       30   define input parameter p-xyz-r-good               like ub.xyz-analysis-attr.xyza-attr-value             no-undo .
       31   define input PARAMETER TABLE FOR    x-XYZ-analysis-doc.
