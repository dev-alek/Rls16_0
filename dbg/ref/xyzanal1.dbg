      639       buf_rang-abc-def-obj.db-num   = buf_rang-abc-def.db-num
      640       buf_rang-abc-def-obj.obj-type = substring(entry(i, p-list-obj) , 1 , 3 )
      641       buf_rang-abc-def-obj.obj-code = integer(substring(entry(i, p-list-obj) , 4 , 10 ))
      642     .
      643   end.
      644   RELEASE buf_rang-abc-def .
      645   END PROCEDURE.
