      920   PROCEDURE find-def-analysis-obj :
      921   define input  parameter p-type     as character no-undo .
      922   define input  parameter p-obj-type as character no-undo .
      923   define input  parameter p-obj-code as integer   no-undo .
      924   define output parameter p-abc-id   as integer   no-undo .
      925   define output parameter p-db-num   as integer   no-undo .
      926     do
      927     on error undo, return error return-value
      928     :
      929     if p-type = "abc"  then do:
      930         define buffer buf_abc-analysis-obj for ub.abc-analysis-obj  .
      931         define buffer buf_abc-analysis     for ub.abc-analysis      .
      932         find first buf_abc-analysis-obj no-lock where
      933                   buf_abc-analysis-obj.obj-type = p-obj-type and
      934                   buf_abc-analysis-obj.obj-code = p-obj-code and
      935                   buf_abc-analysis-obj.is-def   = true use-index objdef no-error .
      936                   if available buf_abc-analysis-obj then do:
      937                       p-abc-id = buf_abc-analysis-obj.abc-id .
      938                       p-db-num = buf_abc-analysis-obj.db-num .
      939                   end.
      940                   else do:
      941                       p-abc-id = 0 .
      942                       p-db-num = 0.
      943                       return "На объекте нет анализа по умолчанию" .
      944                   end.
      945     end.
      946     if p-type = "xyz"  then do:
      947         define buffer buf_xyz-analysis-obj for ub.xyz-analysis-obj  .
      948         define buffer buf_xyz-analysis     for ub.xyz-analysis      .
      949         find first buf_xyz-analysis-obj no-lock where
      950                   buf_xyz-analysis-obj.obj-type = p-obj-type and
      951                   buf_xyz-analysis-obj.obj-code = p-obj-code and
      952                   buf_xyz-analysis-obj.is-def   = true use-index objdef no-error .
      953                   if available buf_xyz-analysis-obj then do:
      954                       p-abc-id = buf_xyz-analysis-obj.xyz-id .
      955                       p-db-num = buf_xyz-analysis-obj.db-num .
      956                   end.
      957                   else do:
      958                       p-abc-id = 0 .
      959                       p-db-num = 0 .
      960                       return "На объекте нет анализа по умолчанию" .
      961                   end.
      962     end.
      963     return .
      964   end.
      965   END PROCEDURE.
      966   procedure save-def-analysis-obj :
      967   define input  parameter p-type     as character no-undo .
      968   define input  parameter p-db-num   as integer   no-undo .
      969   define input  parameter p-abc-id   as integer   no-undo .
      970   define output parameter v-log      as logical   no-undo .
      971     do
      972     on error undo, return error return-value
      973     :
      974     v-log = true .
      975     if p-type = "abc"  then do:
      976         define buffer buf_abc-analysis-obj for ub.abc-analysis-obj  .
      977         define buffer buf_abc-obj          for ub.abc-analysis-obj  .
      978         define buffer buf_abc-analysis     for ub.abc-analysis      .
      979         for each buf_abc-obj no-lock where
      980                  buf_abc-obj.abc-id = p-abc-id and
      981                  buf_abc-obj.db-num = p-db-num :
      982               define variable v-exist    as logical   no-undo init false .
      983               define variable v-list-anal as character no-undo init ""    .
      984               for each  buf_abc-analysis-obj no-lock where
      985                         not (buf_abc-analysis-obj.abc-id = p-abc-id and
      986                              buf_abc-analysis-obj.db-num = p-db-num) and
      987                         buf_abc-analysis-obj.is-def   = true   and
      988                         buf_abc-analysis-obj.obj-type = buf_abc-obj.obj-type and
      989                         buf_abc-analysis-obj.obj-code = buf_abc-obj.obj-code
      990                         :
      991                   v-exist    = true .
      992                   v-list-anal = string( buf_abc-analysis-obj.abc-id ) + "," .
      993               end.
      994               if v-exist then do:
      995                   message "На объекте "
      996                   buf_abc-obj.obj-type
      997                   buf_abc-obj.obj-code
      998                   skip
      999                   "уже есть анализы по умолчанию , их внутренние номера :" skip
     1000                   v-list-anal                                              skip
     1001                   "Сделать по умолчанию анализ текущий " p-abc-id " ?"
     1002                   view-as alert-box question
     1003                   buttons yes-no update v-log .
     1004                   if v-log then do:
     1005                       for each  buf_abc-analysis-obj exclusive-lock where
     1006                                 buf_abc-analysis-obj.obj-type = buf_abc-obj.obj-type and
     1007                                 buf_abc-analysis-obj.obj-code = buf_abc-obj.obj-code :
     1008                         if ( buf_abc-analysis-obj.abc-id = p-abc-id and
     1009                              buf_abc-analysis-obj.db-num = p-db-num ) then
     1010                                 buf_abc-analysis-obj.is-def   = true .
     1011                         else buf_abc-analysis-obj.is-def   = false  .
     1012                       end.
     1013                   end.
     1014               end.
     1015               else do:
     1016                 for each  buf_abc-analysis-obj exclusive-lock where
     1017                           buf_abc-analysis-obj.obj-type = buf_abc-obj.obj-type and
     1018                           buf_abc-analysis-obj.obj-code = buf_abc-obj.obj-code and
     1019                           buf_abc-analysis-obj.abc-id = p-abc-id and
     1020                           buf_abc-analysis-obj.db-num = p-db-num
     1021                           :
     1022                     buf_abc-analysis-obj.is-def   = true .
     1023                 end.
     1024               end.
     1025         end.
     1026     end.
     1027     if p-type = "xyz"  then do:
     1028         define buffer buf_xyz-analysis-obj for ub.xyz-analysis-obj  .
     1029         define buffer buf_xyz-obj          for ub.xyz-analysis-obj  .
     1030         define buffer buf_xyz-analysis     for ub.xyz-analysis      .
     1031         for each buf_xyz-obj no-lock where
     1032                  buf_xyz-obj.xyz-id = p-abc-id and
     1033                  buf_xyz-obj.db-num = p-db-num :
     1034               v-exist = false .
     1035               v-list-anal = ""    .
     1036               for each  buf_xyz-analysis-obj no-lock where
     1037                         not (buf_xyz-analysis-obj.xyz-id = p-abc-id and
     1038                              buf_xyz-analysis-obj.db-num = p-db-num) and
     1039                         buf_xyz-analysis-obj.is-def   = true   and
     1040                         buf_xyz-analysis-obj.obj-type = buf_xyz-obj.obj-type and
     1041                         buf_xyz-analysis-obj.obj-code = buf_xyz-obj.obj-code
     1042                         :
     1043                   v-exist    = true .
     1044                   v-list-anal = string( buf_xyz-analysis-obj.xyz-id ) + "," .
     1045               end.
     1046               if v-exist then do:
     1047                   message "На объекте "
     1048                   buf_xyz-obj.obj-type
     1049                   buf_xyz-obj.obj-code
     1050                   skip
     1051                   "уже есть анализы по умолчанию , их внутренние номера :" skip
     1052                   v-list-anal                                              skip
     1053                   "Сделать по умолчанию анализ текущий " p-abc-id " ?"
     1054                   view-as alert-box question
     1055                   buttons yes-no update v-log .
     1056                   if v-log then do:
     1057                       for each  buf_xyz-analysis-obj exclusive-lock where
     1058                                 buf_xyz-analysis-obj.obj-type = buf_xyz-obj.obj-type and
     1059                                 buf_xyz-analysis-obj.obj-code = buf_xyz-obj.obj-code :
     1060                         if ( buf_xyz-analysis-obj.xyz-id = p-abc-id and
     1061                              buf_xyz-analysis-obj.db-num = p-db-num ) then
     1062                                 buf_xyz-analysis-obj.is-def   = true .
     1063                         else buf_xyz-analysis-obj.is-def   = false  .
     1064                       end.
     1065                   end.
     1066               end.
     1067               else do:
     1068                 for each  buf_xyz-analysis-obj exclusive-lock where
     1069                           buf_xyz-analysis-obj.obj-type = buf_xyz-obj.obj-type and
     1070                           buf_xyz-analysis-obj.obj-code = buf_xyz-obj.obj-code and
     1071                           buf_xyz-analysis-obj.xyz-id = p-abc-id and
     1072                           buf_xyz-analysis-obj.db-num = p-db-num
     1073                           :
     1074                     buf_xyz-analysis-obj.is-def   = true .
     1075                 end.
     1076               end.
     1077         end.
     1078     end.
     1079   end.
     1080   end procedure.
     1081   define variable v-db-num like ub.db.db-num no-undo .
     1082   define variable v-db-num-obj like ub.db.db-num no-undo .
     1083   define variable v-host-code as integer   no-undo .
     1084   define variable v-base-code as integer   no-undo .
     1085   define variable v-first-base-code as integer   no-undo .
     1086   define stream LogStream.
     1087   if p-mode <> 'ДОБАВЛЕНИЕ':U AND p-mode <> 'ИЗМЕНЕНИЕ':U then do:
     1088     message
     1089     vss-workfile vss-revision vss-description skip
     1090     "Неверный параметр p-mode" p-mode
     1091     view-as alert-box error .
     1092     return error '':u.
     1093   end.
     1094   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1095   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
     1096     (output v-db-num
     1097     )  .
     1098   if p-XYZ-name = "":U then do:
     1099     run err-mess ("Название XYZ анализа не может быть пустым").
     1100     return error "XYZ-name":U.
     1101   end.
     1102   if p-cral-id = 0 then do:
     1103     run err-mess ("Не выбран КРИТЕРИЙ АНАЛИЗА").
     1104     return error "cral-id":U.
     1105   end.
     1106   if not can-find ( first x-XYZ-analysis-doc) then do: run err-mess ("Не заданы типы документов для анализа"). return error "doc":U. end.
     1107   if not can-find ( first x-XYZ-analysis-obj) then do: run err-mess ("Не заданы объекты для анализа"). return error "obj":U. end.
     1108   if not can-find ( first x-XYZ-analysis-period) then do: run err-mess ("Не заданы периоды для анализа"). return error "period":U. end.
     1109   find first ub.criterion-analysis no-lock where ub.criterion-analysis.cral-id = p-cral-id no-error .
     1110   if not available ub.criterion-analysis then do: run err-mess ("Не верно задан критерий анализа.Ошибка поиска"). return error "cral-id":U. end.
     1111   define variable fl as logical   no-undo init false .
     1112   if lookup(string(criterion-analysis.cral-id) ,"5,7,9,11,13,15") > 0 then do:
     1113       for each x-XYZ-analysis-obj break by x-XYZ-analysis-obj.obj-type by x-XYZ-analysis-obj.obj-code :
     1114   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1115   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1116     (input  x-XYZ-analysis-obj.obj-type
     1117     ,input  x-XYZ-analysis-obj.obj-code
     1118     ,output v-host-code
     1119     )  .
     1120   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1121   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     1122     (input  v-host-code
     1123     ,output v-base-code
     1124     )  .
     1125         if fl = false then
     1126             assign
     1127               v-first-base-code = v-base-code
     1128               fl = true
     1129             .
     1130         if v-first-base-code <> v-base-code then do:
     1131             run err-mess ("При выбранном валютном критерии анализа , выбранные объекты принадлежат к разным валютным фирмам. Анализ не возможен !!!").
     1132             return error "obj":U.
     1133         end.
     1134       end.
     1135   end.
     1136     define buffer b_date for x-XYZ-analysis-period .
     1137     for each x-XYZ-analysis-period :
     1138       find first b_date where
     1139               ( b_date.xyzp-start >= x-XYZ-analysis-period.xyzp-start and
     1140                 b_date.xyzp-start <= x-XYZ-analysis-period.xyzp-end ) or
     1141               ( b_date.xyzp-end   >= x-XYZ-analysis-period.xyzp-start and
     1142                 b_date.xyzp-end   <= x-XYZ-analysis-period.xyzp-end )
     1143                 no-error .
     1144        if available b_date and
     1145            not  (   b_date.xyzp-start = x-XYZ-analysis-period.xyzp-start    and
     1146                     b_date.xyzp-end = x-XYZ-analysis-period.xyzp-end  ) then do:
     1147             run err-mess ( "Интервалы пересекаются ! "      +
     1148                       string( x-XYZ-analysis-period.xyzp-start ) + "-" +
     1149                       string( x-XYZ-analysis-period.xyzp-end ) + " " +
     1150                       string( b_date.xyzp-start  ) + "-" +
     1151                       string( b_date.xyzp-end  ) ).
     1152             return error "date":U .
     1153        end.
     1154     end.
     1155   _MAIN:
     1156   DO ON ERROR UNDO, RETURN ERROR
     1157   ON STOP UNDO, RETURN ERROR:
     1158   define variable v-date as date no-undo .
     1159   define variable v-time as integer no-undo .
     1160   run cur-time in this-procedure(output v-date, output v-time).
     1161     if p-mode = 'ДОБАВЛЕНИЕ':U then do:
     1162       create ub.XYZ-analysis.
     1163       assign
     1164       ub.XYZ-analysis.XYZ-id = next-value(s-asmt, ub)
     1165       ub.XYZ-analysis.XYZ-date-create    = v-date
     1166       ub.XYZ-analysis.XYZ-time-create    = v-time
     1167       ub.XYZ-analysis.XYZ-db-num-create  = g#db-num
     1168       ub.XYZ-analysis.XYZ-who-create     = g#userid
     1169       ub.XYZ-analysis.db-num             = g#db-num
     1170   .
     1171       p-doc-rec = recid(ub.XYZ-analysis)
     1172       .
     1173     end.
     1174     else do:
     1175       FIND FIRST ub.XYZ-analysis where
     1176                 recid(ub.XYZ-analysis) = p-doc-rec No-ERROR.
     1177       if not available ub.XYZ-analysis then do:
     1178         message
     1179         vss-workfile vss-revision vss-description skip
     1180         "Не найдена запись - p-doc-rec" p-doc-rec
     1181         view-as alert-box error .
     1182         undo, return error '':u.
     1183       end.
     1184       if ub.XYZ-analysis.XYZ-id <> p-XYZ-id
     1185       then do:
     1186         message
     1187         vss-workfile vss-revision vss-description skip
     1188         "Для уже имеющейся записи нельзя изменить"
     1189         "внутренний код" skip
     1190         view-as alert-box ERROR.
     1191         undo, return error '':U.
     1192       end.
     1193     end.
     1194     assign
     1195       ub.XYZ-analysis.cral-id     =  p-cral-id
     1196       ub.XYZ-analysis.XYZ-name    =  p-XYZ-name
     1197       ub.XYZ-analysis.XYZ-des     =  p-XYZ-des
     1198       ub.XYZ-analysis.raxd-x      =  p-raxd-x
     1199       ub.XYZ-analysis.raxd-y      =  p-raxd-y
     1200       ub.XYZ-analysis.raxd-z      =  p-raxd-z
     1201       ub.XYZ-analysis.XYZ-x       =  p-XYZ-x
     1202       ub.XYZ-analysis.XYZ-y       =  p-XYZ-y
     1203       ub.XYZ-analysis.XYZ-z       =  p-XYZ-z
     1204       ub.XYZ-analysis.xyz-x-prc-qnty          = p-xyz-x-prc-qnty
     1205       ub.XYZ-analysis.xyz-x-qnty              = p-xyz-x-qnty
     1206       ub.XYZ-analysis.xyz-x-sum-prc           = p-xyz-x-sum-prc
     1207       ub.XYZ-analysis.xyz-x-sum               = p-xyz-x-sum
     1208       ub.XYZ-analysis.xyz-y-prc-qnty          = p-xyz-y-prc-qnty
     1209       ub.XYZ-analysis.xyz-y-qnty              = p-xyz-y-qnty
     1210       ub.XYZ-analysis.xyz-y-sum-prc           = p-xyz-y-sum-prc
     1211       ub.XYZ-analysis.xyz-y-sum               = p-xyz-y-sum
     1212       ub.XYZ-analysis.xyz-z-prc-qnty          = p-xyz-z-prc-qnty
     1213       ub.XYZ-analysis.xyz-z-qnty              = p-xyz-z-qnty
     1214       ub.XYZ-analysis.xyz-z-sum-prc           = p-xyz-z-sum-prc
     1215       ub.XYZ-analysis.xyz-z-sum               = p-xyz-z-sum
     1216     .
     1217     find first ub.xyz-analysis-attr where ub.xyz-analysis-attr.db-num = ub.xyz-analysis.db-num
     1218                                       and ub.xyz-analysis-attr.xyz-id = ub.xyz-analysis.xyz-id
     1219                                       and ub.xyz-analysis-attr.xyza-attr-code = "r-goods" exclusive-lock no-error .
     1220       if not available ub.xyz-analysis-attr then do:
     1221         create ub.xyz-analysis-attr .
     1222         assign
     1223           ub.xyz-analysis-attr.db-num = ub.xyz-analysis.db-num
     1224           ub.xyz-analysis-attr.xyz-id = ub.xyz-analysis.xyz-id
     1225           ub.xyz-analysis-attr.xyza-attr-code = "r-goods"
     1226         .
     1227       end.
     1228       assign
     1229         ub.xyz-analysis-attr.xyza-attr-value = p-xyz-r-good
     1230       .
     1231   for each ub.XYZ-analysis-doc exclusive-lock where
     1232            ub.XYZ-analysis-doc.XYZ-id = ub.XYZ-analysis.XYZ-id and
     1233            ub.XYZ-analysis-doc.db-num = ub.XYZ-analysis.db-num   :
     1234       delete ub.XYZ-analysis-doc .
     1235   end.
     1236   v-list-doc = "".
     1237   for each x-XYZ-analysis-doc :
     1238        create ub.XYZ-analysis-doc.
     1239        BUFFER-COPY x-XYZ-analysis-doc  TO ub.XYZ-analysis-doc
     1240            assign
     1241              ub.XYZ-analysis-doc.XYZ-id = ub.XYZ-analysis.XYZ-id
     1242              ub.XYZ-analysis-doc.db-num = ub.XYZ-analysis.db-num
     1243            .
     1244             v-list-doc = v-list-doc +  x-XYZ-analysis-doc.XYZd-ext-doc-type + "," .
     1245   end.
     1246   for each ub.XYZ-analysis-obj exclusive-lock where
     1247            ub.XYZ-analysis-obj.XYZ-id = ub.XYZ-analysis.XYZ-id and
     1248            ub.XYZ-analysis-obj.db-num = ub.XYZ-analysis.db-num   :
     1249       delete ub.XYZ-analysis-obj .
     1250   end.
     1251    v-list-obj = "".
     1252   for each x-XYZ-analysis-obj :
     1253        create ub.XYZ-analysis-obj.
     1254        BUFFER-COPY x-XYZ-analysis-obj  TO ub.XYZ-analysis-obj
     1255            assign
     1256              ub.XYZ-analysis-obj.XYZ-id = ub.XYZ-analysis.XYZ-id
     1257              ub.XYZ-analysis-obj.db-num = ub.XYZ-analysis.db-num
     1258            .
     1259        v-list-obj = v-list-obj + x-XYZ-analysis-obj.obj-type + string(x-XYZ-analysis-obj.obj-code) + "," .
     1260   end.
     1261   for each ub.XYZ-analysis-period exclusive-lock where
     1262            ub.XYZ-analysis-period.XYZ-id = ub.XYZ-analysis.XYZ-id and
     1263            ub.XYZ-analysis-period.db-num = ub.XYZ-analysis.db-num   :
     1264       delete ub.XYZ-analysis-period .
     1265   end.
     1266   v-list-period = "".
     1267   for each x-XYZ-analysis-period :
     1268        create ub.XYZ-analysis-period.
     1269        BUFFER-COPY x-XYZ-analysis-period TO ub.XYZ-analysis-period
     1270            assign
     1271              ub.XYZ-analysis-period.XYZ-id = ub.XYZ-analysis.XYZ-id
     1272              ub.XYZ-analysis-period.db-num = ub.XYZ-analysis.db-num
     1273            .
     1274            v-list-period = v-list-period + string ( x-XYZ-analysis-period.XYZp-start,"99/99/9999") + "-"
     1275                                          + string ( x-XYZ-analysis-period.XYZp-end,"99/99/9999")    + "," .
     1276   end.
     1277     run def-hash ( input   v-list-obj ,
     1278                    output  v-XYZ-possb-keep-string-obj,
     1279                    output  v-XYZ-string-obj ,
     1280                    output  v-XYZ-hash-string-obj       )
     1281                    .
     1282     run def-hash ( input   v-list-period ,
     1283                    output  v-XYZ-possb-keep-string-period,
     1284                    output  v-XYZ-string-period ,
     1285                    output  v-XYZ-hash-string-period       )
     1286                    .
     1287     run def-hash ( input   v-list-doc ,
     1288                    output  v-XYZ-possb-keep-string-doc,
     1289                    output  v-XYZ-string-doc ,
     1290                    output  v-XYZ-hash-string-doc       )
     1291                    .
     1292     assign
     1293       ub.XYZ-analysis.XYZ-hash-string-obj          =  v-XYZ-hash-string-obj
     1294       ub.XYZ-analysis.XYZ-hash-string-period       =  v-XYZ-hash-string-period
     1295       ub.XYZ-analysis.XYZ-hash-string-doc          =  v-XYZ-hash-string-doc
     1296       ub.XYZ-analysis.XYZ-possb-keep-string-obj    =  v-XYZ-possb-keep-string-obj
     1297       ub.XYZ-analysis.XYZ-possb-keep-string-period =  v-XYZ-possb-keep-string-period
     1298       ub.XYZ-analysis.XYZ-possb-keep-string-doc    =  v-XYZ-possb-keep-string-doc
     1299       ub.XYZ-analysis.XYZ-string-obj               =  v-XYZ-string-obj
     1300       ub.XYZ-analysis.XYZ-string-period            =  v-XYZ-string-period
     1301       ub.XYZ-analysis.XYZ-string-doc               =  v-XYZ-string-doc
     1302     .
     1303   end.
     1304   PROCEDURE err-mess:
     1305     DEFINE INPUT PARAMETER p-mess as character No-UNDO.
     1306         message
     1307         p-mess
     1308         view-as alert-box error .
     1309   END PROCEDURE.
