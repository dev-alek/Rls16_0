      619             buf_rang-abc-def.raad-db-num                = g#db-num
      620             buf_rang-abc-def.db-num                     = p-db
      621             buf_rang-abc-def.raad-time                  = v-time
      622             buf_rang-abc-def.raad-who                   = g#userid
      623         .
      624   if v-exist = true then do:
      625      for each buf_rang-abc-def-obj exclusive-lock where
      626               buf_rang-abc-def-obj.raad-id = buf_rang-abc-def.raad-id and
      627               buf_rang-abc-def-obj.db-num  = buf_rang-abc-def.db-num :
      628               delete buf_rang-abc-def-obj.
      629      end.
      630   end.
      631   define variable i as integer   no-undo .
      632   define variable k as integer   no-undo .
      633   p-list-obj = trim(p-list-obj, "," ).
      634   k = num-entries(p-list-obj, ",") .
      635   repeat  i = 1 to k :
