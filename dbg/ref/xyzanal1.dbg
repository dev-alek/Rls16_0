       37   define variable  v-XYZ-hash-string-obj          like ub.XYZ-analysis.XYZ-hash-string-obj          no-undo .
       38   define variable  v-XYZ-hash-string-period       like ub.XYZ-analysis.XYZ-hash-string-period       no-undo .
       39   define variable  v-XYZ-hash-string-doc          like ub.XYZ-analysis.XYZ-hash-string-doc          no-undo .
       40   define variable  v-XYZ-possb-keep-string-obj    like ub.XYZ-analysis.XYZ-possb-keep-string-obj    no-undo .
       41   define variable  v-XYZ-possb-keep-string-period like ub.XYZ-analysis.XYZ-possb-keep-string-period no-undo .
