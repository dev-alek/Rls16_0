        1   DEFINE BUFFER locked_group-period-validity FOR ub.group-period-validity.
        2   DEFINE BUFFER locked_var-deliv-gr-per-val FOR ub.var-deliv-gr-per-val.
        3   DEFINE BUFFER locked_variant-delivery FOR ub.variant-delivery.
        4   DEFINE TEMP-TABLE tt-group-period-validity NO-UNDO LIKE ub.group-period-validity.
        5   DEFINE TEMP-TABLE tt-var-deliv-gr-per-val NO-UNDO LIKE ub.var-deliv-gr-per-val.
        6   DEFINE TEMP-TABLE tt-variant-delivery NO-UNDO LIKE ub.variant-delivery.
        7   DEFINE BUFFER X_clients FOR ub.clients.
        8   DEFINE BUFFER X_curr_clients FOR ub.clients.
        9   DEFINE BUFFER X_delivery-subject FOR ub.delivery-subject.
       10   DEFINE BUFFER X_delivery-type FOR ub.delivery-type.
       11   DEFINE INPUT     PARAMETER parParentProc  AS WIDGET-HANDLE NO-UNDO.
       12   define input parameter p-curr-obj-type like ub.clients.obj-type no-undo.
       13   define input parameter p-curr-obj-code like ub.clients.obj-code no-undo.
       14   define input parameter p-mode as character no-undo.
       15   DEFINE INPUT PARAMETER p-deliv-type-code LIKE ub.var-deliv-gr-per-val.deliv-type-code NO-UNDO.
       16   DEFINE INPUT PARAMETER p-deliv-subj-code LIKE ub.var-deliv-gr-per-val.deliv-subj-code NO-UNDO.
       17   DEFINE INPUT PARAMETER p-deliv-obj-type  LIKE ub.var-deliv-gr-per-val.obj-type NO-UNDO.
       18   DEFINE INPUT PARAMETER p-deliv-obj-code  LIKE ub.var-deliv-gr-per-val.obj-code NO-UNDO.
       19   define input parameter p-gr-per-val-code  LIKE ub.var-deliv-gr-per-val.gr-per-val-code no-undo .
       20   define input-output parameter p-doc-rec as recid no-undo.
       21   define variable vss-revision    as character no-undo init "$Revision$":U .
       22   define variable vss-author      as character no-undo init "$Author$":U .
       23   define variable vss-date        as character no-undo init "$Date$":U .
       24   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       25   define variable vss-archive     as character no-undo init "$Archive$":U .
       26   define variable vss-description as character no-undo init "Карточка редактирования ВАРИАНТА ДОСТАВКИ ПО ГРУППЕ СРОКОВ ГОДНОСТИ".
       27   procedure vss-get-info :
       28     define output parameter p-vss-revision    like vss-revision    no-undo .
       29     define output parameter p-vss-author      like vss-author      no-undo .
       30     define output parameter p-vss-date        like vss-date        no-undo .
       31     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       32     define output parameter p-vss-archive     like vss-archive     no-undo .
       33     define output parameter p-vss-description like vss-description no-undo .
       34     assign
       35       p-vss-revision    = vss-revision
       36       p-vss-author      = vss-author
       37       p-vss-date        = vss-date
       38       p-vss-workfile    = vss-workfile
       39       p-vss-archive     = vss-archive
       40       p-vss-description = vss-description
       41     .
       42   end procedure.
       43   procedure vss-get-parameters :
       44     define output parameter p-vss-parameters as character no-undo .
       45   end procedure.
       46   define new global shared variable g#vssrevis-logger as handle    no-undo .
       47   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       48   define variable v-vssrevis-logger                   as handle    no-undo .
       49   procedure vss-logevent :
       50     define input  parameter p-extra-paramters as character no-undo .
       51     define variable v-vssrevis-parameters as character no-undo .
       52     do
       53     on error undo, return error return-value
       54     :
       55       if  valid-handle(v-vssrevis-logger)
       56       and v-vssrevis-logger :get-signature("logevent") <> ""
       57       then do:
       58         run vss-get-parameters in this-procedure
       59           (output v-vssrevis-parameters
       60           ).
       61         run logevent in v-vssrevis-logger
       62           (input vss-workfile
       63           ,input vss-revision
       64           ,input v-vssrevis-parameters
       65           ,input p-extra-paramters
       66           ).
       67       end.
       68     end.
       69   end procedure.
       70   assign
       71     v-vssrevis-logger = g#vssrevis-logger
       72   .
       73   if  valid-handle(v-vssrevis-logger)
       74   and v-vssrevis-logger :get-signature("logevent") <> ""
       75   then do:
       76     assign
       77       v-vssrevis-logevent = true
       78     .
       79     run vss-logevent in this-procedure (input vss-description) .
       80   end.
       81   define new global shared variable g#language as character no-undo .
       82   if g#language <> '' and g#language <> 'rus':U then do:
       83     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       84   end.
       85   define new global shared variable g#library  as handle no-undo .
       86   define new global shared variable g#library2 as handle no-undo .
       87   procedure proc-alt-shift-f2:
       88     if not ibs.th.gbl.gbl-var:rcode
       89   then
       90     run gbl\inidebug.p .
       91   end.
       92   procedure proc-alt-shift-f3:
       93     run gbl/prvssinf.p
       94       ( input this-procedure
       95       ) .
       96   end.
       97   define variable v-inform-launched as logical no-undo initial false .
       98   procedure proc-alt-shift-f4:
       99     define variable v-action as character no-undo .
      100     if v-inform-launched = false then do:
      101       assign
      102         v-inform-launched = true
      103       .
      104       run gbl/d-inform.w
      105         (  input self
      106         ,  input this-procedure
      107         , output v-action
      108         ) no-error .
      109       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      110       assign
      111         v-inform-launched = false
      112       .
      113     end.
      114   end.
      115   procedure proc-alt-f1:
      116     run gbl/corrhelp.p
      117       (input this-procedure
      118       ) .
      119   end .
      120   on alt-shift-f2 anywhere do:
      121     run proc-alt-shift-f2.
      122   end.
      123   on alt-shift-f3 anywhere do:
      124     run proc-alt-shift-f3 in this-procedure .
      125   end.
      126   on alt-shift-f4 anywhere do:
      127     run proc-alt-shift-f4 in this-procedure.
      128   end.
      129   on alt-f1 anywhere do:
      130     run proc-alt-f1 in this-procedure .
      131   end.
      132   define variable v-tab-order as character no-undo.
      133   define variable v-db-num LIKE ub.db.db-num no-undo.
      134   DEFINE BUTTON B-exit AUTO-GO
      135        LABEL "&Ввод"
      136        SIZE 10 BY 1
      137        BGCOLOR 8 .
      138   DEFINE BUTTON B-gr-per-val
      139        IMAGE-UP FILE "btn-down-arrow":U
      140        IMAGE-DOWN FILE "btn-down-arrow":U
      141        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      142        LABEL "Btn 1"
      143        SIZE 3 BY 1.
      144   DEFINE BUTTON B-Help
      145        LABEL "Помо&щь"
      146        SIZE 3 BY 1
      147        BGCOLOR 8 .
      148   DEFINE BUTTON B-Hist
      149        LABEL "Ис&тория"
      150        SIZE 3 BY 1
      151        BGCOLOR 8 .
      152   DEFINE BUTTON b-quit AUTO-END-KEY
      153        LABEL "&Отмена"
      154        SIZE 10 BY 1
      155        BGCOLOR 8 .
      156   DEFINE BUTTON B-variant-delivery
      157        IMAGE-UP FILE "btn-down-arrow":U
      158        IMAGE-DOWN FILE "btn-down-arrow":U
      159        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      160        LABEL "Btn 1"
      161        SIZE 3 BY 1.
      162   DEFINE VARIABLE f-deliv-obj-name AS CHARACTER FORMAT "X(256)":U
      163        VIEW-AS FILL-IN
      164        SIZE 42.5 BY 1 NO-UNDO.
      165   DEFINE VARIABLE F-deliv-subj-name AS CHARACTER FORMAT "X(50)"
      166        LABEL "Название субъекта доставки"
      167        VIEW-AS FILL-IN
      168        SIZE 63 BY 1 NO-UNDO.
      169   DEFINE VARIABLE F-deliv-type-name AS CHARACTER FORMAT "X(50)"
      170        LABEL "Название типа доставки"
      171        VIEW-AS FILL-IN
      172        SIZE 63 BY 1.
      173   DEFINE VARIABLE f-gr-per-from AS INTEGER FORMAT ">,>>9":U INITIAL 0
      174        LABEL "Срок хранения(дни) от"
      175        VIEW-AS FILL-IN
      176        SIZE 9.5 BY 1 NO-UNDO.
      177   DEFINE VARIABLE f-gr-per-to AS INTEGER FORMAT ">,>>9":U INITIAL 0
      178        LABEL "до"
      179        VIEW-AS FILL-IN
      180        SIZE 9.5 BY 1 NO-UNDO.
      181   DEFINE VARIABLE F-gr-per-val-name AS CHARACTER FORMAT "X(256)":U
      182        LABEL "Назв. группы сроков хран."
      183        VIEW-AS FILL-IN
      184        SIZE 63 BY 1 NO-UNDO.
      185   DEFINE VARIABLE F-term-delivery AS INTEGER FORMAT ">,>>9" INITIAL 0
      186        LABEL "Срок доставки(дни)"
      187        VIEW-AS FILL-IN
      188        SIZE 17 BY 1.
      189   DEFINE QUERY Dialog-Frame FOR
      190         tt-var-deliv-gr-per-val,
      191         tt-variant-delivery SCROLLING.
      192   DEFINE FRAME Dialog-Frame
      193        B-exit AT ROW 1 COL 1
      194        b-quit AT ROW 1 COL 11
      195        B-Hist AT ROW 1 COL 92
      196        B-Help AT ROW 1 COL 95
      197        tt-var-deliv-gr-per-val.deliv-type-code AT ROW 3 COL 27.5 COLON-ALIGNED
      198             LABEL "Внутр.код типа доставки"
      199             VIEW-AS FILL-IN
      200             SIZE 11 BY 1
      201        tt-var-deliv-gr-per-val.deliv-subj-code AT ROW 3 COL 66.5 COLON-ALIGNED
      202             LABEL "Вн.код субъекта доставки"
      203             VIEW-AS FILL-IN
      204             SIZE 11 BY 1
      205        B-variant-delivery AT ROW 3 COL 80
      206        F-deliv-type-name AT ROW 4.27 COL 27.5 COLON-ALIGNED
      207        F-deliv-subj-name AT ROW 5.5 COL 27.5 COLON-ALIGNED
      208        tt-var-deliv-gr-per-val.obj-type AT ROW 6.77 COL 27.5 COLON-ALIGNED
      209             LABEL "Объект доставки"
      210             VIEW-AS FILL-IN
      211             SIZE 6 BY 1
      212        tt-var-deliv-gr-per-val.obj-code AT ROW 6.77 COL 34 COLON-ALIGNED NO-LABEL
      213             VIEW-AS FILL-IN
      214             SIZE 10 BY 1
      215        f-deliv-obj-name AT ROW 6.77 COL 48 COLON-ALIGNED NO-LABEL
      216        F-term-delivery AT ROW 8 COL 27.5 COLON-ALIGNED
      217        tt-var-deliv-gr-per-val.gr-per-val-code AT ROW 9.27 COL 33.5 COLON-ALIGNED
      218             LABEL "Внутр.код группы сроков хранения"
      219             VIEW-AS FILL-IN
      220             SIZE 11 BY 1
      221        B-gr-per-val AT ROW 9.27 COL 47.5
      222        F-gr-per-val-name AT ROW 10.5 COL 28 COLON-ALIGNED
      223        f-gr-per-from AT ROW 11.77 COL 28 COLON-ALIGNED
      224        f-gr-per-to AT ROW 11.77 COL 42.5 COLON-ALIGNED
      225        tt-var-deliv-gr-per-val.des AT ROW 14.5 COL 1 NO-LABEL
      226             VIEW-AS EDITOR SCROLLBAR-VERTICAL
      227             SIZE 98 BY 3.77
      228        "Описание" VIEW-AS TEXT
      229             SIZE 16 BY 1 AT ROW 13 COL 1.5
      230        SPACE(81.74) SKIP(4.45)
      231       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      232            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      233            TITLE "Тип доставки от субъекта"
      234            DEFAULT-BUTTON B-exit CANCEL-BUTTON b-quit.
      235   ASSIGN
      236          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      237          FRAME Dialog-Frame:HIDDEN           = TRUE.
      238   ASSIGN
      239          F-deliv-subj-name:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      240   ASSIGN
      241          F-deliv-type-name:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      242   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      243   DO:
      244     APPLY "END-ERROR":U TO SELF.
      245   END.
      246   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
      247   DO:
      248       run proc-save in this-procedure no-error.
      249     if error-status:error then return no-apply.
      250   END.
      251   ON CHOOSE OF B-gr-per-val IN FRAME Dialog-Frame
      252   DO:
      253     define variable v-rid-list as character no-undo.
      254     define variable v-sts as integer no-undo .
      255   define variable vss-include-info0 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      256   if lookup(self :type
      257            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      258            ) = 0
      259   then do:
      260     message
      261       "$Workfile$"
      262       "Указанному интерфейсному элементу фокус не может быть передан" skip
      263       "Интерфейсный элемент" self :name  skip
      264       "Тип" self :type  skip
      265       "Процедура" this-procedure :file-name skip
      266       view-as alert-box .
      267   end.
      268   else do:
      269     apply "entry":u to self  .
      270     if focus :handle <> self :handle  then do:
      271       return no-apply .
      272     end.
      273   end.
      274   if available locked_group-period-validity then v-rid-list = string(recid(locked_group-period-validity)).
      275   run ref/gpervals.w (input parParentProc
      276                 , p-curr-obj-type
      277                 , p-curr-obj-code
      278                 , "b-sel":U
      279                 , 'все':U
      280                 , input-output v-sts
      281                 , input-output v-rid-list ) no-error .
      282   if v-rid-list <> "":U then do:
      283   FIND FIRST LOCKED_group-period-validity WHERE
      284       recid( LOCKED_group-period-validity ) = integer(entry(1, v-rid-list)) NO-LOCK .
      285   if available LOCKED_group-period-validity then do:
      286       assign
      287       tt-var-deliv-gr-per-val.gr-per-val-code = locked_group-period-validity.gr-per-val-code
      288       f-gr-per-val-name = locked_group-period-validity.gr-per-val-name
      289       f-gr-per-from     = locked_group-period-validity.gr-per-from
      290       f-gr-per-to     = locked_group-period-validity.gr-per-to
      291       .
      292     end.
      293     else do:
      294     assign
      295     tt-var-deliv-gr-per-val.gr-per-val-code = ?
      296     f-gr-per-val-name = "":U
      297     f-gr-per-from = ?
      298     f-gr-per-to = ?
      299     .
      300     end.
      301     display
      302     tt-var-deliv-gr-per-val.gr-per-val-code
      303     f-gr-per-val-name
      304     f-gr-per-from
      305     f-gr-per-to
      306     with frame Dialog-Frame .
      307   end.
      308   END.
      309   ON CHOOSE OF B-Hist IN FRAME Dialog-Frame
      310   DO:
      311     define variable v-rid-list as character no-undo.
      312       run ref/varcdlvs.w
      313                   (
      314                    input parParentProc
      315                   ,INPUT p-curr-obj-type
      316                   ,INPUT p-curr-obj-code
      317                   ,input "":U
      318                   ,input "one":U
      319                   ,input locked_var-deliv-gr-per-val.deliv-type-code
      320                   ,input locked_var-deliv-gr-per-val.deliv-subj-code
      321                   ,input locked_var-deliv-gr-per-val.obj-type
      322                   ,input locked_var-deliv-gr-per-val.obj-code
      323                   ,input-output v-rid-list
      324                                 )
      325    .
      326   END.
      327   ON CHOOSE OF B-variant-delivery IN FRAME Dialog-Frame
      328   DO:
      329     define variable v-rid-list as character no-undo.
      330     define variable v-sts as integer no-undo . .
      331   define variable vss-include-info1 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      332   if lookup(self :type
      333            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      334            ) = 0
      335   then do:
      336     message
      337       "$Workfile$"
      338       "Указанному интерфейсному элементу фокус не может быть передан" skip
      339       "Интерфейсный элемент" self :name  skip
      340       "Тип" self :type  skip
      341       "Процедура" this-procedure :file-name skip
      342       view-as alert-box .
      343   end.
      344   else do:
      345     apply "entry":u to self  .
      346     if focus :handle <> self :handle  then do:
      347       return no-apply .
      348     end.
      349   end.
      350   if available locked_variant-delivery then
      351   assign
      352   v-rid-list = string(recid(locked_variant-delivery))
      353   v-sts = locked_variant-delivery.sts
      354   .
      355   run ref/vardelvs.w (input parParentProc
      356                 , p-curr-obj-type
      357                 , p-curr-obj-code
      358                 , "b-sel":U
      359                 , 'все':U
      360                 , p-deliv-type-code
      361                 , p-deliv-subj-code
      362                 , p-deliv-obj-type
      363                 , p-deliv-obj-code
      364                 , input-output v-sts
      365                 , input-output v-rid-list ) no-error .
      366   if v-rid-list <> "":U then do:
      367       FIND FIRST LOCKED_variant-delivery  WHERE
      368           recid( LOCKED_variant-delivery  ) = integer(entry(1, v-rid-list)) NO-LOCK .
      369       if available LOCKED_variant-delivery  then do:
      370         find first X_delivery-type no-lock where
      371                   X_delivery-type.deliv-type-code = locked_variant-delivery .deliv-type-code no-error .
      372         find first X_delivery-subject no-lock where
      373                   X_delivery-subject.deliv-subj-code = locked_variant-delivery .deliv-subj-code no-error .
      374         find first X_clients no-lock where
      375                   X_clients.obj-type = locked_variant-delivery.obj-type
      376              AND  X_clients.obj-code = locked_variant-delivery.obj-code   no-error .
      377         if available X_delivery-type
      378         and available X_delivery-subject
      379         and available X_clients
      380         then do:
      381           assign
      382           tt-var-deliv-gr-per-val.deliv-type-code = locked_variant-delivery.deliv-type-code
      383           tt-var-deliv-gr-per-val.deliv-subj-code = locked_variant-delivery.deliv-subj-code
      384           tt-var-deliv-gr-per-val.obj-type        = locked_variant-delivery.obj-type
      385           tt-var-deliv-gr-per-val.obj-code        = locked_variant-delivery.obj-code
      386           f-deliv-type-name = X_delivery-type.deliv-type-name
      387           f-deliv-subj-name = X_delivery-subject.deliv-subj-name
      388           f-deliv-obj-name = X_clients.obj-name
      389           .
      390        end.
      391        else do:
      392         assign
      393         tt-var-deliv-gr-per-val.deliv-type-code = ?
      394         tt-var-deliv-gr-per-val.deliv-subj-code = ?
      395         tt-var-deliv-gr-per-val.obj-type        = "":U
      396         tt-var-deliv-gr-per-val.obj-code        = ?
      397         f-deliv-type-name = "":U
      398         f-deliv-subj-name = "":U
      399         f-deliv-obj-name = "":U
      400         .
      401        end.
      402      end.
      403      else do:
      404       assign
      405       tt-var-deliv-gr-per-val.deliv-type-code = ?
      406       tt-var-deliv-gr-per-val.deliv-subj-code = ?
      407       tt-var-deliv-gr-per-val.obj-type        = "":U
      408       tt-var-deliv-gr-per-val.obj-code        = ?
      409       f-deliv-type-name = "":U
      410       f-deliv-subj-name = "":U
      411       f-deliv-obj-name = "":U
      412       .
      413      end.
      414     display
      415     tt-var-deliv-gr-per-val.deliv-type-code
      416     tt-var-deliv-gr-per-val.deliv-subj-code
      417     tt-var-deliv-gr-per-val.obj-type
      418     tt-var-deliv-gr-per-val.obj-code
      419     f-deliv-type-name
      420     f-deliv-subj-name
      421     f-deliv-obj-name
      422     with frame Dialog-Frame .
      423   end.
      424   END.
      425   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      426   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      427   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      428   on help of frame Dialog-Frame
      429   do:
      430     run gbl/app_help.p
      431       (input this-procedure :file-name
      432       ,input ''
      433       ,input ?
      434       ) no-error.
      435     if error-status :error then do:
      436       message
      437         "Ошибка при вызове помощи"
      438         error-status :get-message(1)
      439         view-as alert-box .
      440     end.
      441   end.
      442   run minbtn-set in this-procedure .
      443   on choose of b-help in frame Dialog-Frame
      444   do:
      445     apply "help":u to frame Dialog-Frame .
      446   end.
      447   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      448   procedure minbtn-set :
      449       do
      450           on error undo, return error return-value
      451           :
      452           define variable ii              as integer       no-undo .
      453           define variable fh              as widget-handle no-undo .
      454           define variable hh              as widget-handle no-undo .
      455           define variable v-h             as handle        extent 4 no-undo .
      456           define variable v-name-button   as character     no-undo .
      457           define variable v-help-old-x    as decimal       no-undo .
      458           define variable v-help-old-y    as decimal       no-undo .
      459           define variable v-help-old-size as decimal       no-undo .
      460           define variable v-frame-width   as decimal       no-undo .
      461           define variable jj              as integer       no-undo .
      462           do
      463               on error undo, return error
      464               :
      465               assign
      466                   v-frame-width = frame Dialog-Frame:width - 0.3
      467                   fh            = frame Dialog-Frame:first-child
      468                   hh            = fh:first-child
      469                   ii            = 1
      470                   .
      471               do while valid-handle(hh):
      472                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      473                   do:
      474                       case lc(hh:name) :
      475                           when "b-help" then
      476                               do:
      477                                   hh:load-image-up("cmp/b-help.bmp":u) .
      478                                   hh:load-image-down("cmp/b-help.bmp":u) .
      479                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      480                                   hh:TOOLTIP = "Помощь" .
      481                                   v-help-old-x = hh:column .
      482                                   v-help-old-y = hh:row    .
      483                                   v-help-old-size = hh:width .
      484                                   hh:width-chars = 2.5 .
      485                               end.
      486                           when "b-print" then
      487                               do:
      488                                   hh:load-image("cmp/b-print.bmp":u) .
      489                                   hh:TOOLTIP = "Печать" .
      490                                   v-h[ii] = hh:handle .
      491                                   ii = ii + 1 .
      492                                   hh:width-chars = 3 .
      493                               end.
      494                           when "b-history" or
      495                           when "b-hist" then
      496                               do:
      497                                   hh:load-image("cmp/b-hist.bmp":u) .
      498                                   hh:TOOLTIP = "История" .
      499                                   v-h[ii] = hh:handle .
      500                                   ii = ii + 1 .
      501                                   hh:width-chars = 3 .
      502                               end.
      503                           when "b-sch" then
      504                               do:
      505                                   hh:load-image("cmp/b-sch.bmp":u) .
      506                                   hh:TOOLTIP = "Установка Фильтра" .
      507                                   v-h[ii] = hh:handle .
      508                                   ii = ii + 1 .
      509                                   hh:width-chars = 3 .
      510                               end.
      511                           when "b-hist-user" then
      512                               do:
      513                                   hh:load-image("cmp/b-hist.bmp":u) .
      514                                   hh:TOOLTIP = "История пользователя" .
      515                                   ii = ii + 1 .
      516                               end.
      517                       end case.
      518                   end.
      519                   hh = hh:next-sibling.
      520               end.
      521               b-help:column = v-frame-width - b-help:width-chars.
      522               jj = 0.
      523               repeat ii = 4 to 1 by -1 :
      524                   if valid-handle (v-h[ii] ) then
      525                   do:
      526                       jj  = jj + 1 .
      527                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      528                       v-h[ii]:row    = v-help-old-y .
      529                   end.
      530               end.
      531           end.
      532       end.
      533   end procedure.
      534   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      535   ON TAB ANYWHERE
      536   DO:
      537   define variable ii as integer no-undo .
      538   define variable fh as widget-handle no-undo .
      539   define variable hh as widget-handle no-undo .
      540   define variable v-next-widget-name as character no-undo .
      541   if v-tab-order <> '' then do:
      542     if self:type = "TOGGLE-BOX" then
      543     self:BGCOLOR = ?.
      544     assign
      545     ii = lookup(self:name, v-tab-order).
      546     assign
      547     ii = ii + 1
      548     v-next-widget-name = entry(ii, v-tab-order)
      549     no-error .
      550     if error-status:error then do:
      551       assign
      552       ii = 1
      553       v-next-widget-name = entry( ii, v-tab-order)
      554       .
      555     end.
      556     assign
      557     fh = frame Dialog-Frame:first-child
      558     hh = fh:first-child
      559     .
      560     do while valid-handle(hh):
      561       if hh:name = v-next-widget-name then do:
      562         if hh:sensitive  = yes
      563         AND hh:visible = yes then do:
      564           APPLY "ENTRY" to hh.
      565           return no-apply.
      566         end.
      567         else do:
      568           APPLY "TAB" to hh.
      569           return no-apply.
      570         end.
      571       end.
      572       hh = hh:next-sibling.
      573     end.
      574   end.
      575   END.
      576   ON BACK-TAB ANYWHERE
      577   DO:
      578   define variable ii as integer no-undo .
      579   define variable fh as widget-handle no-undo .
      580   define variable hh as widget-handle no-undo .
      581   define variable v-next-widget-name as character no-undo .
      582   if v-tab-order <> '' then do:
      583     assign
      584     ii = lookup(self:name, v-tab-order).
      585     .
      586     assign
      587     ii = (if ii = 1
      588           then  num-entries(v-tab-order)
      589           else ii - 1
      590           )
      591     v-next-widget-name = entry(ii, v-tab-order)
      592     .
      593     assign
      594     fh = frame Dialog-Frame:first-child
      595     hh = fh:first-child
      596     .
      597     do while valid-handle(hh):
      598       if hh:name = v-next-widget-name then do:
      599         if hh:sensitive  = yes
      600         AND hh:visible = yes then do:
      601           APPLY "ENTRY" to hh.
      602           return no-apply.
      603         end.
      604         else do:
      605         APPLY "BACK-TAB" to hh.
      606         return no-apply.
      607         end.
      608       end.
      609       hh = hh:next-sibling.
      610     end.
      611     end.
      612   END.
      613   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      614   ON RETURN ANYWHERE
      615   DO:
      616   define variable ii as integer no-undo .
      617   define variable fh as widget-handle no-undo .
      618   define variable hh as widget-handle no-undo .
      619   define variable v-next-widget-name as character no-undo .
      620     if v-tab-order <> '' then do:
      621       assign
      622       ii = lookup(self:name, v-tab-order).
      623       if ii = num-entries(v-tab-order) then do:
      624           APPLY 'CHOOSE' TO b-exit in frame Dialog-Frame.
      625           return no-apply.
      626       end.
      627       if self:type <> "BUTTON" and
      628         self:type <> "EDITOR"  then do:
      629         run proc-move-forward in this-procedure .
      630         return no-apply.
      631       end.
      632       if self:type = "BUTTON" then do:
      633         APPLY "CHOOSE" to self.
      634       end.
      635       if self:type = "TOGGLE-BOX" then
      636       self:BGCOLOR = ?.
      637       assign
      638       ii = ii + 1
      639       v-next-widget-name = entry(ii, v-tab-order)
      640       no-error .
      641       if error-status:error then do:
      642         assign
      643         ii = 1
      644         v-next-widget-name = entry( ii, v-tab-order)
      645         .
      646       end.
      647       assign
      648       fh = frame Dialog-Frame:first-child
      649       hh = fh:first-child
      650       .
      651       do while valid-handle(hh):
      652         if hh:name = v-next-widget-name then do:
      653           if hh:sensitive  = yes
      654           AND hh:visible = yes then do:
      655             if hh:type = "TOGGLE-BOX":U then do:
      656               assign
      657               hh:BGcolor = 1
      658               .
      659             end.
      660             APPLY "ENTRY" to hh.
      661             return no-apply.
      662           end.
      663           else do:
      664             APPLY "TAB" to hh.
      665             return no-apply.
      666           end.
      667         end.
      668         hh = hh:next-sibling.
      669       end.
      670     end.
      671   END.
      672   procedure proc-move-forward :
      673   define variable ii as integer no-undo .
      674   define variable fh as widget-handle no-undo .
      675   define variable hh as widget-handle no-undo .
      676   define variable v-next-widget-name as character no-undo .
      677   do
      678   on error undo, return error
      679   :
      680     if v-tab-order <> '' then do:
      681       if self:type = "TOGGLE-BOX" then
      682       self:BGCOLOR = ?.
      683       assign
      684       ii = lookup(self:name, v-tab-order).
      685       assign
      686       ii = ii + 1
      687       v-next-widget-name = entry(ii, v-tab-order)
      688       no-error .
      689       if error-status:error then do:
      690         assign
      691         ii = 1
      692         v-next-widget-name = entry( ii, v-tab-order)
      693         .
      694       end.
      695       assign
      696       fh = frame Dialog-Frame:first-child
      697       hh = fh:first-child
      698       .
      699       do while valid-handle(hh):
      700         if hh:name = v-next-widget-name then do:
      701           if hh:sensitive  = yes
      702           AND hh:visible = yes then do:
      703             if hh:type = "TOGGLE-BOX":U then do:
      704               assign
      705               hh:BGcolor = 1
      706               .
      707             end.
      708             APPLY "ENTRY" to hh.
      709             return.
      710           end.
      711           else do:
      712             assign
      713             ii = ii + 1
      714             v-next-widget-name = entry(ii, v-tab-order)
      715             no-error .
      716             if error-status:error then do:
      717               assign
      718               ii = 1
      719               v-next-widget-name = entry( ii, v-tab-order)
      720               .
      721             end.
      722           end.
      723         end.
      724         hh = hh:next-sibling.
      725       end.
      726     end.
      727   end.
      728   end procedure.
      729   MAIN-BLOCK:
      730   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      731      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      732    if p-mode  <> 'ДОБАВЛЕНИЕ':U
      733    and p-mode <> 'ИЗМЕНЕНИЕ':U
      734    and p-mode <> 'ПРОСМОТР':U
      735    then do:
      736       message
      737       vss-workfile vss-revision vss-description skip
      738       "Неверное значение параметров вызова p-mode"  p-mode
      739       view-as alert-box ERROR.
      740       undo, return error.
      741    end.
      742      find first X_curr_clients no-lock where
      743               X_curr_clients.obj-type = p-curr-obj-type
      744          AND X_curr_clients.obj-code = p-curr-obj-code no-error.
      745     if not available X_curr_clients then do:
      746       message
      747       vss-workfile vss-revision vss-description skip
      748       "Неверное значение параметра вызова p-curr-obj-type p-curr-obj-code"
      749       p-curr-obj-type p-curr-obj-code
      750       view-as alert-box ERROR.
      751       return error .
      752     end.
      753   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      754   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
      755     (output v-db-num
      756     )  .
      757   IF v-db-num <> 0
      758   AND (p-mode = 'ДОБАВЛЕНИЕ':U
      759        OR p-mode = 'ИЗМЕНЕНИЕ':U ) THEN DO:
      760       message
      761       vss-workfile vss-revision vss-description skip
      762       "Неверное значение параметра вызова p-mode" p-mode skip
      763       "Нельзя редактировать запись ВАРИАНТ ДОСТАВКИ в УБД"
      764       view-as alert-box ERROR.
      765       return error .
      766   END.
      767   for each tt-variant-delivery:
      768     delete tt-variant-delivery.
      769   end.
      770   for each tt-var-deliv-gr-per-val:
      771     delete tt-var-deliv-gr-per-val.
      772   end.
      773   if p-deliv-obj-type <> "":U
      774   or p-deliv-obj-code <> 0 then do:
      775      find first X_clients no-lock where
      776               X_clients.obj-type = p-deliv-obj-type
      777          AND X_clients.obj-code = p-deliv-obj-code no-error.
      778     if not available X_clients then do:
      779       message
      780       vss-workfile vss-revision vss-description skip
      781       "Неверное значение параметра вызова p-deliv-obj-type p-deliv-obj-code"
      782       p-deliv-obj-type p-deliv-obj-code
      783       view-as alert-box ERROR.
      784       return error .
      785     end.
      786   end.
      787   if p-mode = 'ИЗМЕНЕНИЕ':U
      788   or p-mode = 'ПРОСМОТР':U
      789   or p-deliv-type-code  <> 0 then do:
      790     find first X_delivery-type no-lock where
      791                 X_delivery-type.deliv-type-code = p-deliv-type-code no-error .
      792       if not avail X_delivery-type then do:
      793         message
      794         vss-workfile vss-revision vss-description skip
      795         "Неверное значение параметра вызова p-deliv-type-code" p-deliv-type-code skip
      796         view-as alert-box ERROR.
      797         return error .
      798       end.
      799   end.
      800   if p-mode = 'ИЗМЕНЕНИЕ':U
      801   or p-mode = 'ПРОСМОТР':U
      802   or p-deliv-subj-code  <> 0 then do:
      803       find first X_delivery-subject no-lock where
      804                 X_delivery-subject.deliv-subj-code = p-deliv-subj-code no-error .
      805       if not avail X_delivery-subject then do:
      806         message
      807         vss-workfile vss-revision vss-description skip
      808         "Неверное значение параметра вызова p-deliv-subj-code" p-deliv-subj-code skip
      809         view-as alert-box ERROR.
      810         return error .
      811       end.
      812   end.
      813   IF (
      814       (p-deliv-type-code <> 0
      815         OR
      816       p-deliv-subj-code <> 0)
      817   AND (p-deliv-obj-type <> "":U
      818        or p-deliv-obj-code <> 0)
      819      )
      820   OR p-mode <> 'ДОБАВЛЕНИЕ':U
      821   THEN DO:
      822       IF p-mode = 'ДОБАВЛЕНИЕ':U OR p-mode = 'ИЗМЕНЕНИЕ':U  THEN DO:
      823         FIND FIRST LOCKED_variant-delivery EXCLUSIVE-LOCK WHERE
      824                   LOCKED_variant-delivery.deliv-type-code = p-deliv-type-code
      825               AND LOCKED_variant-delivery.deliv-subj-code = p-deliv-subj-code
      826               AND LOCKED_variant-delivery.obj-type = p-deliv-obj-type
      827               AND LOCKED_variant-delivery.obj-code = p-deliv-obj-code
      828             NO-ERROR.
      829       END.
      830       IF p-mode = 'ПРОСМОТР':U THEN DO:
      831           FIND FIRST LOCKED_variant-delivery no-lock WHERE
      832                   LOCKED_variant-delivery.deliv-type-code = p-deliv-type-code
      833               AND LOCKED_variant-delivery.deliv-subj-code = p-deliv-subj-code
      834               AND LOCKED_variant-delivery.obj-type = p-deliv-obj-type
      835               AND LOCKED_variant-delivery.obj-code = p-deliv-obj-code
      836             NO-ERROR.
      837      END.
      838      IF (p-mode = 'ДОБАВЛЕНИЕ':U
      839       OR p-mode = 'ИЗМЕНЕНИЕ':U )
      840       AND NOT AVAILABLE LOCKED_variant-delivery  THEN DO:
      841           IF LOCKED(LOCKED_variant-delivery) THEN DO:
      842               message
      843               vss-workfile vss-revision vss-description skip
      844                "Запись ВАРИАНТ ДОСТАВКИ занята"
      845               view-as alert-box error .
      846               undo, return error.
      847           END.
      848      END.
      849       ELSE DO:
      850         IF NOT AVAILABLE LOCKED_variant-delivery THEN DO:
      851             message
      852             vss-workfile vss-revision vss-description skip
      853             "Неверное значение параметра вызова p-deliv-type-code"  skip
      854             "и/или p-deliv-subj-code" skip
      855             "и/или p-deliv-obj-type p-deliv-obj-code"
      856             p-deliv-type-code p-deliv-subj-code p-deliv-obj-type p-deliv-obj-code skip
      857             view-as alert-box ERROR.
      858             return error .
      859        END.
      860       END.
      861       CREATE tt-variant-delivery.
      862       BUFFER-COPY LOCKED_variant-delivery TO tt-variant-delivery.
      863   END.
      864   if p-gr-per-val-code <> 0
      865   or p-mode <> 'ДОБАВЛЕНИЕ':U then do:
      866        IF p-mode = 'ДОБАВЛЕНИЕ':U OR p-mode = 'ИЗМЕНЕНИЕ':U  THEN DO:
      867           find first locked_group-period-validity exclusive-lock where
      868                     locked_group-period-validity.gr-per-val-code = p-gr-per-val-code  no-error .
      869       END.
      870       IF p-mode = 'ПРОСМОТР':U THEN DO:
      871           find first locked_group-period-validity no-lock where
      872                     locked_group-period-validity.gr-per-val-code = p-gr-per-val-code  no-error .
      873       END.
      874       IF (p-mode = 'ДОБАВЛЕНИЕ':U
      875       OR p-mode = 'ИЗМЕНЕНИЕ':U )
      876       AND NOT AVAILABLE LOCKED_group-period-validity  THEN DO:
      877           IF LOCKED(LOCKED_group-period-validity) THEN DO:
      878               message
      879               vss-workfile vss-revision vss-description skip
      880                "Запись ГРУППЫ СРОКОВ ХРАНЕНИЯ занята"
      881               view-as alert-box error .
      882               undo, return error.
      883           END.
      884      END.
      885      ELSE DO:
      886        if not avail locked_group-period-validity then do:
      887         message
      888         vss-workfile vss-revision vss-description skip
      889         "Неверное значение параметра вызова p-gr-per-val-code" p-gr-per-val-code skip
      890         view-as alert-box ERROR.
      891         return error .
      892       end.
      893     END.
      894     CREATE tt-group-period-validity.
      895     BUFFER-COPY LOCKED_group-period-validity TO tt-group-period-validity.
      896   end.
      897   if p-mode = 'ИЗМЕНЕНИЕ':U
      898     or p-mode = 'ПРОСМОТР':U then do:
      899       if p-mode = 'ИЗМЕНЕНИЕ':U then do:
      900         find first locked_var-deliv-gr-per-val EXclusive-lock where
      901                      recid(locked_var-deliv-gr-per-val) = p-doc-rec no-wait no-error.
      902         if locked locked_var-deliv-gr-per-val then do:
      903           message
      904           vss-workfile vss-revision vss-description skip
      905            "Запись ВАРИАНТ ДОСТАВКИ ПО ГРУППЕ СРОКОВ ГОДНОСТИ занята"
      906           view-as alert-box error .
      907           undo, return error.
      908         end.
      909       end.
      910       else do:
      911         find first locked_var-deliv-gr-per-val no-lock where
      912                          recid(locked_var-deliv-gr-per-val) = p-doc-rec no-error .
      913         if not avail locked_var-deliv-gr-per-val then do:
      914           find first locked_var-deliv-gr-per-val no-lock where
      915                      locked_var-deliv-gr-per-val.deliv-type-code = p-deliv-type-code no-error .
      916         end.
      917       end.
      918       if not available locked_var-deliv-gr-per-val then do:
      919         message
      920         vss-workfile vss-revision vss-description skip
      921         "Не найдена запись ВАРИАНТ ДОСТАВКИ ПО ГРУППЕ СРОКОВ ГОДНОСТИ"
      922         view-as alert-box error .
      923         undo, return error.
      924       end.
      925       create tt-var-deliv-gr-per-val.
      926       buffer-copy locked_var-deliv-gr-per-val to tt-var-deliv-gr-per-val.
      927      end.
      928      else do:
      929        create tt-var-deliv-gr-per-val.
      930        assign
      931        tt-var-deliv-gr-per-val.deliv-type-code = (IF p-mode = 'ДОБАВЛЕНИЕ':U AND p-deliv-type-code <> 0
      932                                                    THEN p-deliv-type-code
      933                                                    ELSE tt-var-deliv-gr-per-val.deliv-type-code)
      934        tt-var-deliv-gr-per-val.deliv-subj-code = (IF p-mode = 'ДОБАВЛЕНИЕ':U AND p-deliv-subj-code <> 0
      935                                                    THEN p-deliv-subj-code
      936                                                    ELSE tt-var-deliv-gr-per-val.deliv-type-code)
      937        tt-var-deliv-gr-per-val.obj-type        = (IF p-mode = 'ДОБАВЛЕНИЕ':U AND p-deliv-obj-type <> "":U
      938                                                    THEN p-deliv-obj-type
      939                                                    ELSE tt-var-deliv-gr-per-val.obj-type)
      940        tt-var-deliv-gr-per-val.obj-code        = (IF p-mode = 'ДОБАВЛЕНИЕ':U AND p-deliv-obj-code <> 0
      941                                                    THEN p-deliv-obj-code
      942                                                    ELSE tt-var-deliv-gr-per-val.obj-code)
      943        tt-var-deliv-gr-per-val.gr-per-val-code  = (IF p-mode = 'ДОБАВЛЕНИЕ':U AND p-gr-per-val-code <> 0
      944                                                    THEN p-gr-per-val-code
      945                                                    ELSE tt-var-deliv-gr-per-val.gr-per-val-code)
      946       .
      947      end.
      948     RUN Myenable.
      949     WAIT-FOR GO OF FRAME Dialog-Frame.
      950   END.
      951   RUN disable_UI.
      952   PROCEDURE disable_UI :
      953     HIDE FRAME Dialog-Frame.
      954   END PROCEDURE.
      955   PROCEDURE enable_UI :
      956     OPEN QUERY Dialog-Frame FOR EACH tt-var-deliv-gr-per-val SHARE-LOCK,       EACH tt-variant-delivery WHERE TRUE  SHARE-LOCK.
      957     GET FIRST Dialog-Frame.
      958     DISPLAY F-deliv-type-name F-deliv-subj-name f-deliv-obj-name F-term-delivery
      959             F-gr-per-val-name f-gr-per-from f-gr-per-to
      960         WITH FRAME Dialog-Frame.
      961     IF AVAILABLE tt-var-deliv-gr-per-val THEN
      962       DISPLAY tt-var-deliv-gr-per-val.deliv-type-code
      963             tt-var-deliv-gr-per-val.deliv-subj-code
      964             tt-var-deliv-gr-per-val.obj-type tt-var-deliv-gr-per-val.obj-code
      965             tt-var-deliv-gr-per-val.gr-per-val-code tt-var-deliv-gr-per-val.des
      966         WITH FRAME Dialog-Frame.
      967     ENABLE B-exit b-quit B-Hist B-Help B-variant-delivery f-deliv-obj-name
      968            tt-var-deliv-gr-per-val.gr-per-val-code B-gr-per-val
      969            tt-var-deliv-gr-per-val.des
      970         WITH FRAME Dialog-Frame.
      971     VIEW FRAME Dialog-Frame.
      972   END PROCEDURE.
      973   PROCEDURE MyENable :
      974   case p-mode:
      975     when 'ДОБАВЛЕНИЕ':U then do:
      976       display
      977       (IF tt-var-deliv-gr-per-val.deliv-type-code <> 0
      978        THEN tt-var-deliv-gr-per-val.deliv-type-code
      979        ELSE ?) @ tt-var-deliv-gr-per-val.deliv-type-code
      980       (IF tt-var-deliv-gr-per-val.deliv-subj-code <> 0
      981        THEN tt-var-deliv-gr-per-val.deliv-subj-code
      982        ELSE ?) @ tt-var-deliv-gr-per-val.deliv-subj-code
      983       (IF tt-var-deliv-gr-per-val.obj-type <> "":U
      984        THEN tt-var-deliv-gr-per-val.obj-type
      985        ELSE ?) @ tt-var-deliv-gr-per-val.obj-type
      986       (IF tt-var-deliv-gr-per-val.obj-code <> 0
      987        THEN tt-var-deliv-gr-per-val.obj-code
      988        ELSE ?) @ tt-var-deliv-gr-per-val.obj-code
      989        (if available locked_variant-delivery
      990        then locked_variant-delivery.term-delivery
      991        else ?) @ F-term-delivery
      992       (if available X_clients
      993       then X_clients.obj-name
      994       else "":U) @ f-deliv-obj-name
      995       (IF AVAILABLE X_delivery-type
      996        THEN X_delivery-type.deliv-type-name
      997        ELSE "":U) @ F-deliv-type-name
      998        (IF AVAILABLE X_delivery-subject
      999        THEN X_delivery-subject.deliv-subj-name
     1000        ELSE "":U) @ F-deliv-subj-name
     1001       WITH FRAME Dialog-Frame.
     1002     end.
     1003     otherwise do:
     1004       IF AVAILABLE tt-var-deliv-gr-per-val THEN
     1005       DISPLAY
     1006       tt-var-deliv-gr-per-val.deliv-type-code
     1007       tt-var-deliv-gr-per-val.deliv-subj-code
     1008       tt-var-deliv-gr-per-val.obj-type
     1009       tt-var-deliv-gr-per-val.obj-code
     1010       tt-variant-delivery.term-delivery
     1011       (if available  X_delivery-type then X_delivery-type.deliv-type-name else "":U) @ f-deliv-type-name
     1012       (if available X_delivery-subject then X_delivery-subject.deliv-subj-name else "":U) @ f-deliv-subj-name
     1013       locked_group-period-validity.gr-per-val-name @ f-gr-per-val-name
     1014       locked_group-period-validity.gr-per-from @ f-gr-per-from
     1015       locked_group-period-validity.gr-per-to @ f-gr-per-to
     1016       tt-var-deliv-gr-per-val.des
     1017       WITH FRAME Dialog-Frame.
     1018     end.
     1019   END CASE.
     1020   if p-mode = 'ПРОСМОТР':U then do:
     1021   assign
     1022   b-quit:label = "&Выход"
     1023   .
     1024   hide
     1025   b-exit in frame Dialog-Frame.
     1026   end.
     1027   ENABLE
     1028   B-exit when p-mode <> 'ПРОСМОТР':U
     1029   b-quit
     1030   B-Hist when p-mode <> 'ДОБАВЛЕНИЕ':U
     1031   B-Help
     1032   tt-var-deliv-gr-per-val.des when p-mode <> 'ПРОСМОТР':U
     1033   b-variant-delivery when (p-mode = 'ДОБАВЛЕНИЕ':U
     1034                            and
     1035                            (p-deliv-type-code = 0 and p-deliv-subj-code = 0 and p-deliv-obj-code = 0))
     1036   b-gr-per-val WHEN (p-mode = 'ДОБАВЛЕНИЕ':U AND p-gr-per-val-code = 0)
     1037   WITH FRAME Dialog-Frame.
     1038   VIEW FRAME Dialog-Frame.
     1039   END PROCEDURE.
     1040   PROCEDURE Proc-save :
     1041   if p-mode = 'ПРОСМОТР':U then do:
     1042       return error.
     1043   end.
     1044   if not available tt-var-deliv-gr-per-val then do:
     1045       create tt-var-deliv-gr-per-val.
     1046   end.
     1047   assign
     1048   frame Dialog-Frame
     1049   tt-var-deliv-gr-per-val.deliv-type-code
     1050   tt-var-deliv-gr-per-val.deliv-subj-code
     1051   tt-var-deliv-gr-per-val.des = tt-var-deliv-gr-per-val.des:SCREEN-VALUE
     1052   .
     1053    run ref/vrdlgrp1.p (
     1054   input-output p-doc-rec
     1055   ,input p-mode
     1056   ,input tt-var-deliv-gr-per-val.deliv-type-code
     1057   ,input tt-var-deliv-gr-per-val.deliv-subj-code
     1058   ,input tt-var-deliv-gr-per-val.obj-type
     1059   ,input tt-var-deliv-gr-per-val.obj-code
     1060   ,input tt-var-deliv-gr-per-val.gr-per-val-code
     1061   ,input tt-var-deliv-gr-per-val.des
     1062   )
     1063   no-error.
     1064   if error-status:error then do:
     1065   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1066   define variable fh as widget-handle no-undo .
     1067   define variable hh as widget-handle no-undo .
     1068   define variable rv as character no-undo .
     1069   assign
     1070   rv = entry(1, return-value , chr(4)).
     1071   if rv <> "":U then do:
     1072     assign
     1073     fh = frame Dialog-Frame:first-child
     1074     hh = fh:first-child
     1075     .
     1076     do while valid-handle(hh):
     1077       if hh:name = rv then do:
     1078         APPLY "ENTRY" to hh.
     1079         undo ,
     1080         return error.
     1081       end.
     1082       hh = hh:next-sibling.
     1083     end.
     1084   end.
     1085     undo, return error.
     1086   end.
     1087   END PROCEDURE.
