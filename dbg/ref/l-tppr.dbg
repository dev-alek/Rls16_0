        1   block-level on error undo, throw.
        2   define input  parameter parParentProc as handle no-undo .
        3   define input  parameter p-obj-type as character no-undo .
        4   define input  parameter p-obj-code as integer   no-undo .
        5   define input  parameter p-bttn as character no-undo .
        6   define output parameter p-recid as character no-undo .
        7   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        8   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        9   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       10   define variable vss-workfile    as character no-undo init "$Workfile: l-tppr.p $":U .
       11   define variable vss-archive     as character no-undo init "$Archive: ref/l-tppr.p $":U .
       12   define variable vss-description as character no-undo init "Процедура вызова и сбора recid по типам прайс-листов по одному клиенту".
       13   procedure vss-get-info :
       14     define output parameter p-vss-revision    like vss-revision    no-undo .
       15     define output parameter p-vss-author      like vss-author      no-undo .
       16     define output parameter p-vss-date        like vss-date        no-undo .
       17     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       18     define output parameter p-vss-archive     like vss-archive     no-undo .
       19     define output parameter p-vss-description like vss-description no-undo .
       20     assign
       21       p-vss-revision    = vss-revision
       22       p-vss-author      = vss-author
       23       p-vss-date        = vss-date
       24       p-vss-workfile    = vss-workfile
       25       p-vss-archive     = vss-archive
       26       p-vss-description = vss-description
       27     .
       28   end procedure.
       29   procedure vss-get-parameters :
       30     define output parameter p-vss-parameters as character no-undo .
       31   end procedure.
       32   define new global shared variable g#vssrevis-logger as handle    no-undo .
       33   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       34   define variable v-vssrevis-logger                   as handle    no-undo .
       35   procedure vss-logevent :
       36     define input  parameter p-extra-paramters as character no-undo .
       37     define variable v-vssrevis-parameters as character no-undo .
       38     do
       39     on error undo, return error return-value
       40     :
       41       if  valid-handle(v-vssrevis-logger)
       42       and v-vssrevis-logger :get-signature("logevent") <> ""
       43       then do:
       44         run vss-get-parameters in this-procedure
       45           (output v-vssrevis-parameters
       46           ).
       47         run logevent in v-vssrevis-logger
       48           (input vss-workfile
       49           ,input vss-revision
       50           ,input v-vssrevis-parameters
       51           ,input p-extra-paramters
       52           ).
       53       end.
       54     end.
       55   end procedure.
       56   assign
       57     v-vssrevis-logger = g#vssrevis-logger
       58   .
       59   if  valid-handle(v-vssrevis-logger)
       60   and v-vssrevis-logger :get-signature("logevent") <> ""
       61   then do:
       62     assign
       63       v-vssrevis-logevent = true
       64     .
       65     run vss-logevent in this-procedure (input vss-description) .
       66   end.
       67   define new global shared variable g#language as character no-undo .
       68   if g#language <> '' and g#language <> 'rus':U then do:
       69     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       70   end.
       71   define new global shared variable g#library  as handle no-undo .
       72   define new global shared variable g#library2 as handle no-undo .
       73   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       74     define variable v-cntxt-db-num        as integer   no-undo .
       75     define variable v-cntxt-userid        as character no-undo .
       76     define variable v-cntxt-level         as character no-undo .
       77     define variable v-cntxt-host-code-obj as integer   no-undo .
       78     define variable v-cntxt-obj-type      as character no-undo .
       79     define variable v-cntxt-obj-code      as integer   no-undo .
       80     define variable v-cntxt-db-num-obj    as integer   no-undo .
       81     define variable v-cntxt-is-admin      as logical   no-undo .
       82   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       83     run mainmenu_getcntxt in parparentproc
       84       (output v-cntxt-db-num
       85       ,output v-cntxt-userid
       86       ,output v-cntxt-level
       87       ,output v-cntxt-host-code-obj
       88       ,output v-cntxt-obj-type
       89       ,output v-cntxt-obj-code
       90       ,output v-cntxt-db-num-obj
       91       ,output v-cntxt-is-admin
       92       ) .
       93   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       94   define temp-table x_obj-group no-undo like ub.clients  .
       95   define temp-table x_grp-obj-price no-undo like ub.grp-obj-price .
       96   procedure metod-gop-obj :
       97     do
       98     on error undo, return error return-value
       99     :
      100   define input  parameter p-cntxt-db-num as integer   no-undo .
      101   define input  parameter p-gop-id       as integer   no-undo .
      102   define input  parameter p-gop-db-num   as integer   no-undo .
      103   define buffer buf1_clients for ub.clients  .
      104   define buffer buf_db-grp-obj-price   for ub.db-grp-obj-price  .
      105   define buffer buf_host-grp-obj-price for ub.host-grp-obj-price  .
      106   define buffer buf_obj-grp-obj-price  for ub.obj-grp-obj-price  .
      107   for each  x_obj-group : delete x_obj-group. end.
      108   if p-gop-id = 0 or p-gop-id = ?  then do:
      109      if p-cntxt-db-num = 0  then do:
      110           for each buf1_clients no-lock where
      111                   (buf1_clients.obj-type = 'маг':U  or
      112                    buf1_clients.obj-type = 'скл':U  )
      113                   and
      114                   buf1_clients.db-num >= 0  and
      115                   buf1_clients.stts = 0
      116                   :
      117             create x_obj-group .
      118             assign
      119               x_obj-group.obj-code   = buf1_clients.obj-code
      120               x_obj-group.obj-type   = buf1_clients.obj-type
      121               x_obj-group.obj-name   = buf1_clients.obj-name
      122               x_obj-group.db-num     = buf1_clients.db-num
      123             .
      124           end.
      125      end.
      126      else do:
      127           for each buf1_clients no-lock where
      128                   (buf1_clients.obj-type = 'маг':U  or
      129                    buf1_clients.obj-type = 'скл':U  ) and
      130                    buf1_clients.db-num = p-cntxt-db-num  and
      131                    buf1_clients.stts = 0
      132                   :
      133             create x_obj-group .
      134             assign
      135               x_obj-group.obj-code   = buf1_clients.obj-code
      136               x_obj-group.obj-type   = buf1_clients.obj-type
      137               x_obj-group.obj-name   = buf1_clients.obj-name
      138               x_obj-group.db-num     = buf1_clients.db-num
      139             .
      140           end.
      141      end.
      142   end.
      143   else do:
      144         for each buf_db-grp-obj-price  where
      145                 buf_db-grp-obj-price.gop-id     = p-gop-id and
      146                 buf_db-grp-obj-price.gop-db-num = p-gop-db-num and
      147                 buf_db-grp-obj-price.stts = 0  no-lock :
      148           for each buf1_clients no-lock where
      149                  (buf1_clients.obj-type = 'маг':U  or
      150                   buf1_clients.obj-type = 'скл':U  ) and
      151                   buf1_clients.db-num = buf_db-grp-obj-price.dgo-db-num  and
      152                   buf1_clients.stts = 0
      153                   :
      154             create x_obj-group .
      155             assign
      156               x_obj-group.obj-code   = buf1_clients.obj-code
      157               x_obj-group.obj-type   = buf1_clients.obj-type
      158               x_obj-group.obj-name   = buf1_clients.obj-name
      159               x_obj-group.db-num     = buf1_clients.db-num
      160             .
      161           end.
      162         end.
      163       for each buf_host-grp-obj-price where
      164               buf_host-grp-obj-price.gop-id     = p-gop-id and
      165               buf_host-grp-obj-price.gop-db-num = p-gop-db-num and
      166               buf_host-grp-obj-price.stts = 0
      167               no-lock :
      168         for each buf1_clients no-lock where
      169                (buf1_clients.obj-type = 'маг':U  or
      170                 buf1_clients.obj-type = 'скл':U  ) and
      171                 buf1_clients.host-code = buf_host-grp-obj-price.host-code and
      172                 buf1_clients.stts = 0
      173                 :
      174             find first x_obj-group no-lock  where
      175                       x_obj-group.obj-code   = buf1_clients.obj-code and
      176                       x_obj-group.obj-type   = buf1_clients.obj-type no-error .
      177             if not available  x_obj-group then   create x_obj-group .
      178             assign
      179               x_obj-group.obj-code   = buf1_clients.obj-code
      180               x_obj-group.obj-type   = buf1_clients.obj-type
      181               x_obj-group.obj-name   = buf1_clients.obj-name
      182               x_obj-group.db-num     = buf1_clients.db-num
      183             .
      184         end.
      185       end.
      186       for each buf_obj-grp-obj-price where
      187               buf_obj-grp-obj-price.gop-id     = p-gop-id and
      188               buf_obj-grp-obj-price.gop-db-num = p-gop-db-num and
      189               buf_obj-grp-obj-price.stts = 0
      190               no-lock :
      191         for each buf1_clients no-lock where
      192                   buf1_clients.obj-type = buf_obj-grp-obj-price.obj-type and
      193                   buf1_clients.obj-code = buf_obj-grp-obj-price.obj-code and
      194                   buf1_clients.stts     = 0
      195                   :
      196             find first  x_obj-group no-lock  where
      197                         x_obj-group.obj-code   = buf1_clients.obj-code and
      198                         x_obj-group.obj-type   = buf1_clients.obj-type no-error .
      199             if not available  x_obj-group then   create x_obj-group .
      200             assign
      201               x_obj-group.obj-code   = buf1_clients.obj-code
      202               x_obj-group.obj-type   = buf1_clients.obj-type
      203               x_obj-group.obj-name   = buf1_clients.obj-name
      204               x_obj-group.db-num     = buf1_clients.db-num
      205             .
      206         end.
      207       end.
      208   end.
      209   end.
      210   end procedure.
      211   procedure metod-obj-in-gop :
      212   define input  parameter p-curr-db-num as integer   no-undo .
      213   define input  parameter p-obj-type as character no-undo .
      214   define input  parameter p-obj-code as integer   no-undo .
      215   define buffer buf_grp-obj-price for ub.grp-obj-price  .
      216     do
      217     on error undo, return error return-value
      218     :
      219       empty temp-table x_grp-obj-price.
      220       for each buf_grp-obj-price where
      221                buf_grp-obj-price.stts = 0
      222                no-lock :
      223                  run metod-gop-obj (p-curr-db-num , buf_grp-obj-price.gop-id ,buf_grp-obj-price.gop-db-num) .
      224                  for each x_obj-group where
      225                           x_obj-group.obj-type = p-obj-type and
      226                           x_obj-group.obj-code = p-obj-code :
      227                       create  x_grp-obj-price.
      228                       buffer-copy buf_grp-obj-price to x_grp-obj-price .
      229                  end.
      230       end.
      231     end.
      232   end procedure.
      233   procedure metod-delobj-usr :
      234   define input  parameter p-pdf-id  as integer   no-undo .
      235   define input  parameter p-pdf-db  as integer   no-undo .
      236   define input  parameter p-plt-id  as integer   no-undo .
      237   define input  parameter p-plt-db-num as integer   no-undo .
      238   define buffer buf_price-doc-forming-attr for ub.price-doc-forming-attr  .
      239     do
      240     on error undo, return error return-value
      241     :
      242   for each buf_price-doc-forming-attr no-lock  where
      243            buf_price-doc-forming-attr.pdf-id =     p-pdf-id and
      244            buf_price-doc-forming-attr.pdf-db =     p-pdf-db and
      245            buf_price-doc-forming-attr.plt-id =     p-plt-id and
      246            buf_price-doc-forming-attr.plt-db-num = p-plt-db-num and
      247            buf_price-doc-forming-attr.attr-code begins "obj" :
      248      for each x_obj-group  where
      249               x_obj-group.obj-type = substring(buf_price-doc-forming-attr.attr-code,4,3) and
      250               x_obj-group.obj-code = int(substring(buf_price-doc-forming-attr.attr-code,7,20)) :
      251        delete x_obj-group.
      252      end.
      253   end.
      254     if not can-find (first x_obj-group) then do:
      255        return "nullobj" .
      256     end.
      257   end.
      258   end procedure.
      259   procedure metod-obj-pdf :
      260   define input  parameter p-cntxt-db-num as integer   no-undo .
      261   define input  parameter p-pdf-id     like ub.price-doc-forming.pdf-id   no-undo .
      262   define input  parameter p-pdf-db-num like ub.price-doc-forming.pdf-db   no-undo .
      263   define input  parameter p-plt-id     like ub.price-doc-forming.plt-id   no-undo .
      264   define input  parameter p-plt-db-num like ub.price-doc-forming.plt-db-num  no-undo .
      265   define buffer buf_price-list-type for ub.price-list-type  .
      266   define buffer buf_price-doc-forming for ub.price-doc-forming  .
      267     do
      268     on error undo, return error return-value
      269     :
      270    for each  x_obj-group : delete x_obj-group. end.
      271    find first buf_price-list-type no-lock where
      272               buf_price-list-type.plt-id = p-plt-id and
      273               buf_price-list-type.plt-db-num = p-plt-db-num no-error .
      274   if error-status :error then return error return-value .
      275    find first buf_price-doc-forming no-lock where
      276               buf_price-doc-forming.plt-id     = p-plt-id and
      277               buf_price-doc-forming.plt-db-num = p-plt-db-num and
      278               buf_price-doc-forming.pdf-id     = p-pdf-id and
      279               buf_price-doc-forming.pdf-db     = p-pdf-db-num
      280               no-error .
      281   if error-status :error then return error return-value .
      282     run metod-gop-obj in this-procedure (
      283         p-cntxt-db-num,
      284         buf_price-list-type.gop-id ,
      285         buf_price-list-type.gop-db-num
      286         ) no-error .
      287     run metod-delobj-usr in this-procedure (
      288       buf_price-doc-forming.pdf-id ,
      289       buf_price-doc-forming.pdf-db ,
      290       buf_price-doc-forming.plt-id ,
      291       buf_price-doc-forming.plt-db-num
      292       ) no-error .
      293     end.
      294   end procedure.
      295   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      296   define variable v-waitfram-action01         as character   no-undo .
      297   define variable v-waitfram-action02         as character   no-undo .
      298   define variable v-waitfram-action03         as character   no-undo .
      299   define variable mWaitFramTextBeg            as character   no-undo.
      300   define variable mWaitFramTextEnd            as character   no-undo.
      301   define variable mWaitFramView               as logical     no-undo.
      302   define variable mWaitProcEvent              as logical     no-undo init yes.
      303   define variable mWaitFramInterval           as integer     no-undo init 1 .
      304   define variable mWaitFramStop               as logical     no-undo.
      305   define variable mWaitFramStopUser           as logical     no-undo.
      306   define variable mWaitFramStopTimeOut        as logical     no-undo.
      307   define variable mWaitFramStartProc          as datetime-tz no-undo.
      308   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      309   define button B-WaitFramStop auto-end-key
      310        label "Стоп"
      311        size 10 by 1 tooltip "Остоновить процесс".
      312   define button B-viewProcInfo
      313        label "Информация"
      314        size 15 by 1 tooltip "Информация о процесс".
      315   define frame waitfram
      316     v-waitfram-action01 format "x(72)" no-label skip
      317     v-waitfram-action02 format "x(72)" no-label skip
      318     v-waitfram-action03 format "x(72)" no-label skip
      319     B-viewProcInfo
      320     B-WaitFramStop at row 4 col 30
      321     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      322     .
      323   define new global shared variable mBatchMode as logical no-undo init ?.
      324   define variable mFramBachModHandle as handle no-undo.
      325   mFramBachModHandle = frame waitfram:handle.
      326   define variable mFameOldVis as logical no-undo.
      327   define variable mVisCUrentVin as logical no-undo.
      328   if session:batch-mode
      329   then
      330      mBatchMode = yes.
      331   if mBatchMode = ? then do:
      332     mVisCUrentVin = current-window:visible.
      333     mFameOldVis = mFramBachModHandle:visible.
      334     mFramBachModHandle:visible  = yes.
      335     mBatchMode = mFramBachModHandle:visible ne yes.
      336     mFramBachModHandle:visible = mFameOldVis.
      337     current-window:visible = mVisCUrentVin.
      338   end.
      339    if  log-manager:logfile-name ne ?
      340     then DO:
      341         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      342         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      343         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      344     end.
      345   on choose of B-WaitFramStop in frame waitfram
      346   do:
      347     mWaitFramStop = yes.
      348     mWaitFramStopUser = yes.
      349   end.
      350   function waitfram-check-timeout returns logical():
      351      define variable vtime as int64 no-undo.
      352      if mWaitFramStopTimeOut
      353      then
      354         return yes.
      355      vtime = ( now - mWaitFramStartProc ) / 1000 .
      356      if     mWaitFramTimeOut ne ?
      357         and mWaitFramTimeOut ne 0
      358         and mWaitFramTimeOut lt vtime
      359      then do:
      360         mWaitFramStopTimeOut = yes.
      361      end.
      362      return mWaitFramStopTimeOut.
      363   end.
      364   procedure waitfram-hide :
      365     if not session:batch-mode
      366     then do
      367     on error undo, return error return-value
      368     :
      369       pause 0 before-hide .
      370       if not mBatchMode then
      371         hide frame waitfram .
      372     if     not mWaitFramView
      373        and mWaitProcEvent
      374     then
      375       process events .
      376     end.
      377   end procedure.
      378   procedure waitfram-show :
      379     define input  parameter p-message as character no-undo .
      380     define variable v-left-margin as integer   no-undo .
      381     if not session:batch-mode
      382     then do
      383     on error undo, return error return-value
      384     :
      385       if length(p-message) <= 70 then do:
      386         assign
      387           v-left-margin = integer((70 - length(p-message)) / 2)
      388         .
      389         assign
      390           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      391         .
      392         assign
      393           v-waitfram-action01 = " "
      394           v-waitfram-action02 = " "
      395                                    + fill(" ", v-left-margin)
      396                                    + p-message
      397           v-waitfram-action03 = " "
      398         .
      399       end.
      400       else do:
      401         define variable vRindex1 as integer no-undo.
      402         define variable vRindex2 as integer no-undo.
      403         vRindex1 = r-index(p-message," ",70).
      404         if vRindex1 = 0
      405         then
      406            vRindex1 = 70.
      407         if length(p-message)  <= vRindex1 + 70 then do:
      408           assign
      409             v-waitfram-action01 = " "
      410             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      411             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      412           .
      413         end.
      414         else do:
      415           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      416           if vRindex2 <= vRindex1
      417           then
      418              vRindex2 = vRindex1 + 70.
      419           assign
      420             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      421             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      422             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      423           .
      424         end.
      425       end.
      426       B-viewProcInfo:visible   in frame waitfram = no.
      427       B-viewProcInfo:sensitive in frame waitfram = no.
      428       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      429       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      430       if  (   mWaitFramView
      431          or  mWaitProcEvent)
      432          and not mBatchMode
      433       then
      434          display
      435             v-waitfram-action01 skip
      436             v-waitfram-action02 skip
      437             v-waitfram-action03 skip
      438          with frame waitfram .
      439       if     mWaitFramView
      440          then do:
      441             if     mWaitFramInterval ne ?
      442                and not mBatchMode
      443             then
      444                wait-for go of frame waitfram pause mWaitFramInterval.
      445          end.
      446          else
      447             if     mWaitProcEvent
      448                and not mBatchMode
      449             then
      450                process events .
      451     end.
      452   end procedure.
      453      procedure waitfram-show-this:
      454         define input  parameter iInterval as int64 no-undo.
      455         define variable vtime as int64 no-undo.
      456         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      457         mWaitFramInterval = iInterval.
      458         run waitfram-show (substitute("&1&2 &3&4" ,
      459                                       mWaitFramTextBeg ,
      460                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      461                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      462                                       mWaitFramTextEnd
      463                                      )
      464                           ).
      465      end.
      466      procedure WaitFramRunPause:
      467         define input  parameter iInterval as dec no-undo.
      468         define variable vStart  as datetime-tz no-undo.
      469         define variable vend    as datetime-tz no-undo.
      470         define variable vint as int64 no-undo.
      471         define variable vOk as logical no-undo.
      472         vStart = now.
      473         vend   = vStart.
      474         publish "WaitFramPause" (iInterval,output vOk).
      475         vend   =  now.
      476         vint = vend - vStart.
      477         vint = iInterval - vint / 1000.
      478         if     not mWaitFramStop
      479            and (   vint > 0
      480                 or (    not vOk
      481                     and iInterval eq ?
      482                     )
      483                 )
      484         then
      485            run waitfram-show-this (iInterval).
      486         vend   =  now.
      487         vint = vend - vStart.
      488         vint = iInterval - vint / 1000.
      489         if     not mWaitFramStop
      490            and vint > 0
      491         then do:
      492            run gbl/pause.p (vint * 1000).
      493         end.
      494         if iInterval ne ?
      495         then
      496            publish "WaitFramStop".
      497         waitfram-check-timeout().
      498      end.
      499      procedure WaitFramWaitFor:
      500         define input  parameter iInterval as dec no-undo.
      501         assign
      502            mWaitFramStartProc   = now
      503            mWaitFramStopUser    = no
      504            mWaitFramStopTimeOut = no
      505         .
      506         block-wait:
      507         do while not mWaitFramStop:
      508            run WaitFramRunPause (iInterval).
      509            if  waitfram-check-timeout()
      510            then do:
      511               leave block-wait.
      512            end.
      513         end.
      514         run waitfram-hide.
      515      end.
      516   procedure waitfram-join :
      517     define input  parameter p-line-1  as character no-undo .
      518     define input  parameter p-line-2  as character no-undo .
      519     define input  parameter p-line-3  as character no-undo .
      520     define output parameter p-message as character no-undo .
      521     do
      522     on error undo, return error return-value
      523     :
      524       assign
      525         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      526                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      527                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      528       .
      529     end.
      530   end procedure.
      531   function waitfram-join-function returns character
      532     (input p-line-1 as character
      533     ,input p-line-2 as character
      534     ,input p-line-3 as character
      535     ).
      536     define variable v-message as character no-undo .
      537     run waitfram-join in this-procedure
      538       (input  p-line-1
      539       ,input  p-line-2
      540       ,input  p-line-3
      541       ,output v-message
      542       ) .
      543     return v-message .
      544   end function .
      545   define buffer buf_clients for ub.clients  .
      546   define buffer buf_price-list-type for ub.price-list-type  .
      547   find first buf_clients no-lock where
      548              buf_clients.obj-type  = p-obj-type and
      549              buf_clients.obj-code  = p-obj-code no-error .
      550   if error-status :error then return error error-status :get-message(1)  .
      551   run waitfram-show in this-procedure ("Выборка типов прайс-листов...") .
      552   define variable v-par as character no-undo  init "" .
      553   if p-obj-type = 'орг':U or p-obj-type = 'чел':U then do:
      554   end.
      555   else do:
      556   define buffer buf_grp-obj-price for ub.grp-obj-price  .
      557   for each buf_price-list-type no-lock where
      558             buf_price-list-type.stts     = integer('0':U) and
      559             buf_price-list-type.use-obj  = 1
      560             :
      561             v-par = v-par + string(recid(buf_price-list-type)) +  "," .
      562   end.
      563   for each buf_grp-obj-price no-lock :
      564           empty temp-table x_obj-group.
      565           run metod-gop-obj in this-procedure ( v-cntxt-db-num,  buf_grp-obj-price.gop-id , buf_grp-obj-price.gop-db-num) .
      566           if can-find( first x_obj-group where
      567                     x_obj-group.obj-type = p-obj-type and
      568                     x_obj-group.obj-code = p-obj-code ) then do
      569                     :
      570                     for each buf_price-list-type no-lock where
      571                         buf_price-list-type.use-obj     = 2 and
      572                         buf_price-list-type.stts        = integer('0':U) and
      573                         buf_price-list-type.gop-id      = buf_grp-obj-price.gop-id and
      574                         buf_price-list-type.gop-db-num  = buf_grp-obj-price.gop-db-num
      575                         :
      576                         v-par = v-par + string(recid(buf_price-list-type)) +  "," .
      577                     end.
      578           end.
      579   end.
      580   end.
      581   run waitfram-hide in this-procedure .
      582   v-par = trim (v-par, "," ).
      583   if num-entries (v-par, "," ) = 1 then do:
      584      find first buf_price-list-type no-lock where recid(buf_price-list-type) = int(v-par)  no-error .
      585      if not error-status :error then  do:
      586         message "Найден 1 подходящий ТПЛ для объекта"
      587           p-obj-type
      588           p-obj-code
      589           skip
      590           buf_price-list-type.name skip
      591           view-as alert-box information .
      592         p-recid =  v-par .
      593         return .
      594      end.
      595   end.
      596   run ref/typepric.w (
      597       input parParentProc     ,
      598       input "mode=plt-id," + p-bttn + ",title=Типы Прайс-листов для " + caps(buf_clients.obj-name) + " endtitle" ,
      599       input-output v-par
      600       ) no-error .
      601   p-recid =  v-par .
