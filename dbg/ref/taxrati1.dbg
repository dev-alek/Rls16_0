        1   block-level on error undo, throw.
        2   define input-output parameter par-rid as recid no-undo .
        3   define input parameter par-mode       as character no-undo .
        4   define input parameter p-silent       as logical  no-undo .
        5   define input parameter partax-code    like ub.tax-rate.tax-code no-undo .
        6   define input parameter parrate-code   like ub.tax-rate.rate-code no-undo .
        7   define input parameter parrate-name   like ub.tax-rate.rate-name no-undo .
        8   define input parameter parstatus    like ub.tax-rate.status_   no-undo .
        9   def var vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       10   def var vss-author      as character no-undo init "$Author: expertek $":U .
       11   def var vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       12   def var vss-workfile    as character no-undo init "$Workfile: taxrati1.p $":U .
       13   def var vss-archive     as character no-undo init "$Archive: ref/taxrati1.p $":U .
       14   def var vss-description as character no-undo init "Сохранение изменений в карточке ставки налога".
       15   procedure vss-get-info :
       16     define output parameter p-vss-revision    like vss-revision    no-undo .
       17     define output parameter p-vss-author      like vss-author      no-undo .
       18     define output parameter p-vss-date        like vss-date        no-undo .
       19     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       20     define output parameter p-vss-archive     like vss-archive     no-undo .
       21     define output parameter p-vss-description like vss-description no-undo .
       22     assign
       23       p-vss-revision    = vss-revision
       24       p-vss-author      = vss-author
       25       p-vss-date        = vss-date
       26       p-vss-workfile    = vss-workfile
       27       p-vss-archive     = vss-archive
       28       p-vss-description = vss-description
       29     .
       30   end procedure.
       31   procedure vss-get-parameters :
       32     define output parameter p-vss-parameters as character no-undo .
       33   end procedure.
       34   define new global shared variable g#vssrevis-logger as handle    no-undo .
       35   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       36   define variable v-vssrevis-logger                   as handle    no-undo .
       37   procedure vss-logevent :
       38     define input  parameter p-extra-paramters as character no-undo .
       39     define variable v-vssrevis-parameters as character no-undo .
       40     do
       41     on error undo, return error return-value
       42     :
       43       if  valid-handle(v-vssrevis-logger)
       44       and v-vssrevis-logger :get-signature("logevent") <> ""
       45       then do:
       46         run vss-get-parameters in this-procedure
       47           (output v-vssrevis-parameters
       48           ).
       49         run logevent in v-vssrevis-logger
       50           (input vss-workfile
       51           ,input vss-revision
       52           ,input v-vssrevis-parameters
       53           ,input p-extra-paramters
       54           ).
       55       end.
       56     end.
       57   end procedure.
       58   assign
       59     v-vssrevis-logger = g#vssrevis-logger
       60   .
       61   if  valid-handle(v-vssrevis-logger)
       62   and v-vssrevis-logger :get-signature("logevent") <> ""
       63   then do:
       64     assign
       65       v-vssrevis-logevent = true
       66     .
       67     run vss-logevent in this-procedure (input vss-description) .
       68   end.
       69   define new global shared variable g#language as character no-undo .
       70   if g#language <> '' and g#language <> 'rus':U then do:
       71     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       72   end.
       73   define new global shared variable g#library  as handle no-undo .
       74   define new global shared variable g#library2 as handle no-undo .
       75   define   shared variable g#auto as logical no-undo.
       76   define   shared variable g#news as logical no-undo.
       77   define   shared variable g#oxml as logical no-undo.
       78   define   shared variable g#esys as logical no-undo.
       79   define   shared variable g#news-source-db as integer no-undo.
       80   define   shared variable g#esys-source-esys as integer no-undo.
       81   define   shared variable g#db-num as integer   no-undo .
       82   define   shared variable g#userid as character no-undo .
       83   define   shared variable g#passwd as character no-undo .
       84   define variable vss-include-info0 as character format "X(65)" no-undo
       85   initial "@(#)$Workfile$ $Revision$".
       86   define temp-table temp_grplib_grp no-undo
       87       field sel           as character
       88       field nabor         as character
       89       field full-name     as character
       90       field print-code    as character
       91       field sort-name     as character
       92       field node-code     as integer
       93       field upper-code    as integer
       94       field calc-method   as character
       95       field round-method  as character
       96       field increase-pc   as decimal
       97       field min-marg      as character
       98       field max-marg      as character
       99       field cli-type      as character
      100       field cli-code      as integer
      101       field notcorr      as character
      102       field name          as character
      103       field level         as integer
      104       field mark          as character
      105       index pi is primary unique sort-name
      106       index fn full-name
      107       index nc is unique node-code
      108       index sl sel
      109       index uc upper-code
      110   .
      111   define temp-table temp_grplib_found-grp no-undo
      112       field full-name   as character
      113       field sort-name   as character
      114       field node-code   as integer
      115       field level       as integer
      116       field is-terminal as logical
      117       index pi is primary unique sort-name
      118       index fn full-name
      119       index lv level
      120       index it is-terminal
      121   .
      122   define temp-table temp_found-result-nodelist no-undo
      123       field node-code     as recid
      124       field processed     as logical
      125       field sort-name     as character
      126       field full-name     as character
      127       index pi is primary unique node-code
      128       index ps processed
      129   .
      130   define variable v-grplib-not-fill-extra-info        as logical      no-undo.
      131   define variable v-grplib-no-warning-grp-amount      as logical      no-undo.
      132   define variable v-grplib-grp-amount-for-load        as integer      no-undo.
      133   procedure grplib-get-parameters :
      134   define input parameter p-store-type     as character        no-undo.
      135   define input parameter p-store-code     as integer          no-undo.
      136   do
      137   on error undo, return error
      138   :
      139       assign
      140           v-grplib-not-fill-extra-info = no
      141       .
      142   end.
      143   end procedure.
      144   procedure grplib-get-sort-name :
      145   do
      146   on error undo, return error
      147   :
      148   define input parameter p-node-code  as integer      no-undo.
      149   define output parameter p-sort-name as character    no-undo.
      150       define variable v-upper-code    as integer           no-undo.
      151       define buffer buf_gds-grp       for ub.gds-grp.
      152       define buffer buf_upper_gds-grp for ub.gds-grp.
      153       find first buf_gds-grp no-lock
      154            where buf_gds-grp.node-code = p-node-code
      155       no-error.
      156       if not available buf_gds-grp
      157       then do:
      158           undo, return error "grplib-get-sort-name: Не найдена группа товаров с кодом " + string( p-node-code ).
      159       end.
      160       assign
      161           p-sort-name  = ""
      162           v-upper-code = 1
      163       .
      164       do while buf_gds-grp.upper-code <> 0
      165       on error undo, return error "grplib-get-sort-name: Ошибка составления полного имени группы"
      166       :
      167           assign
      168               p-sort-name  = buf_gds-grp.node-name
      169                            + (if p-sort-name <> "" then chr(2) else "")
      170                            + p-sort-name
      171               v-upper-code = buf_gds-grp.upper-code
      172           .
      173           find first buf_gds-grp no-lock
      174                where buf_gds-grp.node-code = v-upper-code
      175           no-error.
      176           if not available buf_gds-grp
      177           then do:
      178               undo, return error "grplib-get-sort-name: Не найдена группа товаров с кодом "
      179                                   + string( v-upper-code )
      180                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
      181           end.
      182       end.
      183   end.
      184   end procedure.
      185   define variable vss-include-info1 as character format "X(65)" no-undo
      186   initial "@(#)$Workfile$ $Revision$".
      187   procedure grplib-get-full-name :
      188      define input parameter p-node-code  as integer      no-undo.
      189      define output parameter p-full-name as character    no-undo.
      190      do
      191   on error undo, return error
      192   :
      193       define variable v-upper-code    as integer           no-undo.
      194       define buffer buf_gds-grp       for ub.gds-grp.
      195       define buffer buf_upper_gds-grp for ub.gds-grp.
      196       find first buf_gds-grp no-lock
      197            where buf_gds-grp.node-code = p-node-code
      198       no-error.
      199       if not available buf_gds-grp
      200       then do:
      201           undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
      202       end.
      203       assign
      204           p-full-name  = ""
      205           v-upper-code = 1
      206       .
      207       do while buf_gds-grp.upper-code <> 0
      208       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
      209       :
      210           assign
      211               p-full-name  = buf_gds-grp.node-name
      212                            + (if p-full-name <> "" then chr(47) else "")
      213                            + p-full-name
      214               v-upper-code = buf_gds-grp.upper-code
      215           .
      216           find first buf_gds-grp no-lock
      217                where buf_gds-grp.node-code = v-upper-code
      218           no-error.
      219           if not available buf_gds-grp
      220           then do:
      221               undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом "
      222                                   + string( v-upper-code )
      223                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
      224           end.
      225       end.
      226       assign
      227       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
      228       .
      229   end.
      230   end .
      231   procedure grplib-get-node-from-full-name :
      232   define input parameter p-full-name as character no-undo .
      233   define output parameter p-node-code as integer no-undo .
      234   define variable v-ii as integer no-undo .
      235   define variable v-upper-code as integer no-undo .
      236   define variable v-root-code as integer no-undo .
      237   define variable v-entry as character no-undo .
      238   define buffer buf_gds-grp       for ub.gds-grp.
      239   do
      240   on error undo, return error
      241   :
      242     find first buf_gds-grp no-lock
      243         where buf_gds-grp.upper-code = 0
      244     no-error .
      245     if not available buf_gds-grp
      246     then do:
      247         undo, return error substitute("Не найдена корневая группа товаров (upper-code = 0)").
      248     end.
      249     else do:
      250       assign
      251       v-root-code = buf_gds-grp.node-code
      252       .
      253     end.
      254     v-upper-code = v-root-code.
      255     do v-ii = 1 to num-entries(p-full-name, chr(47)):
      256       assign
      257       v-entry = entry(v-ii, p-full-name, chr(47)).
      258       if v-entry = '' then leave.
      259       find first buf_gds-grp no-lock where
      260                 buf_gds-grp.node-name = v-entry
      261             and buf_gds-grp.upper-code = v-upper-code
      262             no-error.
      263       if not available buf_gds-grp then do:
      264         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
      265       end.
      266       else do:
      267         p-node-code = buf_gds-grp.node-code.
      268         v-upper-code = buf_gds-grp.node-code.
      269       end.
      270     end.
      271   end.
      272   end .
      273   procedure grplib-get-root-code :
      274   do
      275   on error undo, return error
      276   :
      277   define output parameter p-root-code as integer      no-undo.
      278       define buffer buf_gds-grp       for ub.gds-grp.
      279       find first buf_gds-grp no-lock
      280           where buf_gds-grp.upper-code = 0
      281       no-error .
      282       if not available buf_gds-grp
      283       then do:
      284           undo, return error .
      285       end.
      286       else do:
      287           assign
      288               p-root-code = buf_gds-grp.node-code
      289           .
      290       end.
      291   end.
      292   end procedure.
      293   procedure grplib-find-grp-by-full-name :
      294   do
      295   on error undo, return error
      296   :
      297   define input parameter p-search-name  as character    no-undo.
      298   define input parameter p-fill-path    as logical      no-undo.
      299   define output parameter p-found       as logical      no-undo.
      300       define variable v-upper-code    as integer          no-undo.
      301       define variable v-counter       as integer           no-undo.
      302       define variable v-level         as integer           no-undo.
      303       define variable v-full-name     as character         no-undo.
      304       define variable v-sort-name     as character         no-undo.
      305       define buffer buf_gds-grp       for ub.gds-grp.
      306       assign
      307           p-search-name = replace( p-search-name, chr(47), chr(2) )
      308       .
      309       run grplib-get-root-code ( output v-upper-code ) no-error .
      310       if error-status :error
      311       then do:
      312           undo, return error "grplib-expand-name: Ошибка при поиске корневого узла".
      313       end.
      314       assign
      315           v-full-name  = ""
      316           v-level      = num-entries( p-search-name, chr(2) )
      317       .
      318       for each temp_grplib_found-grp
      319       :
      320           delete temp_grplib_found-grp.
      321       end.
      322       start-name-analyze:
      323       do v-counter = 1 to v-level
      324       :
      325           if v-counter < v-level
      326           then do:
      327               find first buf_gds-grp no-lock
      328                    where buf_gds-grp.upper-code = v-upper-code
      329                      and buf_gds-grp.node-name  = entry( v-counter, p-search-name, chr(2) )
      330               no-error .
      331               if not available buf_gds-grp
      332               then do:
      333                   assign
      334                       v-full-name  = p-search-name
      335                       v-sort-name  = p-search-name
      336                   .
      337                   return error "grplib-expand-name: не найдена группа " + entry( v-level, p-search-name, chr(2) ).
      338               end.
      339               else do:
      340                   assign
      341                       v-full-name = v-full-name + ( if v-full-name = "" then "" else chr(47) )        + buf_gds-grp.node-name
      342                       v-sort-name = v-sort-name + ( if v-sort-name = "" then "" else chr(2) ) + buf_gds-grp.node-name
      343                       v-upper-code = buf_gds-grp.node-code
      344                   .
      345                   if p-fill-path = yes
      346                   then do:
      347                       create temp_grplib_found-grp.
      348                       assign
      349                           temp_grplib_found-grp.full-name = v-full-name + chr(47)
      350                           temp_grplib_found-grp.sort-name = v-sort-name
      351                           temp_grplib_found-grp.node-code = v-upper-code
      352                           temp_grplib_found-grp.level     = v-counter
      353                       .
      354                   end.
      355               end.
      356           end.
      357           else do:
      358               for each buf_gds-grp no-lock
      359                  where buf_gds-grp.upper-code = v-upper-code
      360                    and buf_gds-grp.node-name begins entry( v-counter, p-search-name, chr(2) )
      361               :
      362                   assign
      363                       p-found = yes
      364                   .
      365                   create temp_grplib_found-grp.
      366                   assign
      367                       temp_grplib_found-grp.full-name = v-full-name
      368                                                           + (if v-full-name = "" then "" else chr(47) )
      369                                                           + buf_gds-grp.node-name + chr(47)
      370                       temp_grplib_found-grp.sort-name = v-sort-name
      371                                                           + ( if v-sort-name = "" then "" else chr(2) )
      372                                                           + buf_gds-grp.node-name
      373                       temp_grplib_found-grp.node-code = buf_gds-grp.node-code
      374                       temp_grplib_found-grp.level     = v-level
      375                   .
      376               end.
      377               if p-found = no
      378               then do:
      379                   assign
      380                       v-full-name  = p-search-name
      381                       v-sort-name  = p-search-name
      382                   .
      383                   for each temp_grplib_found-grp
      384                   :
      385                       delete temp_grplib_found-grp.
      386                   end.
      387                   assign
      388                       p-found = no
      389                   .
      390               end.
      391           end.
      392       end.
      393   end.
      394   end procedure.
      395   procedure grplib-find-all-subgroup :
      396   do
      397   on error undo, return error
      398   :
      399   define input parameter p-start-node-code    as integer      no-undo.
      400   define input parameter p-terminal-only      as logical      no-undo.
      401       define variable v-start-full-name   as character     no-undo.
      402       define variable v-start-sort-name   as character     no-undo.
      403       define variable v-not-found         as logical       no-undo.
      404       define variable v-is-terminal       as logical       no-undo.
      405       define buffer buf_gds-grp           for ub.gds-grp.
      406       create temp_found-result-nodelist.
      407       assign
      408           temp_found-result-nodelist.node-code = p-start-node-code
      409           temp_found-result-nodelist.processed = no
      410       .
      411       run grplib-get-full-name in this-procedure (
      412             input p-start-node-code
      413           , output v-start-full-name
      414       ).
      415       run grplib-get-full-name in this-procedure (
      416             input p-start-node-code
      417           , output v-start-sort-name
      418       ).
      419       process-nodes:
      420       do while yes
      421       :
      422           find first temp_found-result-nodelist
      423                where temp_found-result-nodelist.node-code = p-start-node-code
      424           .
      425           assign
      426               temp_found-result-nodelist.processed = yes
      427           .
      428           for each buf_gds-grp no-lock
      429              where buf_gds-grp.upper-code = p-start-node-code
      430           on error undo, return error
      431           :
      432               run grplib-is-terminal in this-procedure (
      433                     input buf_gds-grp.node-code
      434                   , output v-is-terminal
      435               ).
      436               if v-is-terminal = yes
      437               then do:
      438                   create temp_grplib_found-grp.
      439                   assign
      440                       temp_grplib_found-grp.full-name   = right-trim(v-start-full-name, chr(47)) +
      441                                                           chr(47) + buf_gds-grp.node-name + chr(47)
      442                       temp_grplib_found-grp.sort-name   = right-trim(v-start-sort-name, chr(2)) +
      443                                                           chr(2) + buf_gds-grp.node-name + chr(2)
      444                       temp_grplib_found-grp.node-code   = buf_gds-grp.node-code
      445                       temp_grplib_found-grp.is-terminal = yes
      446                   .
      447               end.
      448               else do:
      449                   create temp_found-result-nodelist.
      450                   assign
      451                       temp_found-result-nodelist.node-code = buf_gds-grp.node-code
      452                       temp_found-result-nodelist.full-name = right-trim(v-start-full-name, chr(47)) +
      453                                                              chr(47) + buf_gds-grp.node-name + chr(47)
      454                       temp_found-result-nodelist.sort-name = right-trim(v-start-sort-name, chr(2)) +
      455                                                              chr(2) + buf_gds-grp.node-name + chr(2)
      456                       temp_found-result-nodelist.processed = no
      457                   .
      458                   if p-terminal-only = no
      459                   then do:
      460                       create temp_grplib_found-grp.
      461                       assign
      462                           temp_grplib_found-grp.full-name   = right-trim(v-start-full-name, chr(47)) +
      463                                                               chr(47) + buf_gds-grp.node-name + chr(47)
      464                           temp_grplib_found-grp.sort-name   = right-trim(v-start-sort-name, chr(2)) +
      465                                                               chr(2) + buf_gds-grp.node-name + chr(2)
      466                           temp_grplib_found-grp.node-code   = buf_gds-grp.node-code
      467                           temp_grplib_found-grp.is-terminal = no
      468                       .
      469                   end.
      470               end.
      471           end.
      472           find first temp_found-result-nodelist
      473                where temp_found-result-nodelist.processed = no
      474           no-error.
      475           if not available temp_found-result-nodelist
      476           then do:
      477               leave process-nodes.
      478           end.
      479           else do:
      480               assign
      481                   p-start-node-code = temp_found-result-nodelist.node-code
      482                   v-start-full-name = temp_found-result-nodelist.full-name
      483                   v-start-sort-name = temp_found-result-nodelist.sort-name
      484               .
      485           end.
      486       end.
      487   end.
      488   end procedure.
      489   procedure grplib-expand-name :
      490   define input parameter p-start-name as character        no-undo.
      491   define output parameter p-end-name  as character        no-undo.
      492       define variable v-is-terminal   as logical      no-undo.
      493       define variable v-found         as character    no-undo.
      494       define buffer buf_temp_grplib_found-grp     for temp_grplib_found-grp.
      495   do
      496   for buf_temp_grplib_found-grp
      497   on error undo, return error
      498   :
      499       run grplib-find-grp-by-full-name in this-procedure (
      500             input p-start-name
      501           , input no
      502           , output v-found
      503       ) no-error.
      504       run grplib-get-max-substring in this-procedure (
      505                   input length( p-start-name )
      506                 , output p-end-name
      507       ) no-error .
      508       if error-status :error
      509       then do:
      510           assign
      511               p-end-name = ""
      512           .
      513       end.
      514       else do:
      515           find first temp_grplib_found-grp
      516               where temp_grplib_found-grp.full-name = p-end-name
      517           no-error.
      518           if available temp_grplib_found-grp
      519           then do:
      520               find first buf_temp_grplib_found-grp
      521                   where buf_temp_grplib_found-grp.full-name begins p-end-name
      522                   and recid( buf_temp_grplib_found-grp ) <> recid( temp_grplib_found-grp )
      523               no-error.
      524               if not available buf_temp_grplib_found-grp
      525               then do:
      526                   run grplib-is-terminal in this-procedure (
      527                       input temp_grplib_found-grp.node-code
      528                       , output v-is-terminal
      529                   ).
      530               end.
      531           end.
      532       end.
      533   end.
      534   end procedure.
      535   procedure grplib-get-max-substring :
      536   do
      537   on error undo, return error
      538   :
      539   define input parameter p-min-substring-length   as integer      no-undo.
      540   define output parameter p-substring             as character    no-undo.
      541           define variable v-char-counter  as integer           no-undo.
      542           define variable v-current-char  as character         no-undo.
      543           define variable v-names-counter  as integer           no-undo.
      544           define variable v-base-string   as character         no-undo.
      545           assign
      546               v-char-counter  = p-min-substring-length
      547           .
      548           find first temp_grplib_found-grp no-error.
      549           if not available temp_grplib_found-grp
      550           then do:
      551               undo, return error "grplib-get-max-substring: Нет строк для вычисления общей подстроки".
      552           end.
      553           else do:
      554               assign
      555                   v-base-string  = temp_grplib_found-grp.full-name
      556                   v-char-counter = 0
      557               .
      558               counter-block:
      559               do while yes
      560               on error undo, return error "grplib-get-max-substring: Ошибка вычисления продолжения имени группы."
      561               :
      562                   assign
      563                       v-char-counter  = v-char-counter + 1
      564                       v-current-char  = substring( v-base-string, v-char-counter, 1 )
      565                       v-names-counter = 0
      566                   .
      567                   compare-block:
      568                   for each temp_grplib_found-grp
      569                   :
      570                       assign
      571                           v-names-counter = v-names-counter + 1
      572                       .
      573                       if v-names-counter = 1
      574                       then do:
      575                           next compare-block.
      576                       end.
      577                       if substring( temp_grplib_found-grp.full-name, v-char-counter, 1 ) <> v-current-char
      578                       then do:
      579                           leave counter-block.
      580                       end.
      581                   end.
      582                   if v-names-counter = 1
      583                   then do:
      584                       assign
      585                           p-substring = v-base-string
      586                       .
      587                       return.
      588                   end.
      589               end.
      590               assign
      591                   p-substring = substring( v-base-string, 1, v-char-counter - 1 )
      592               .
      593           end.
      594   end.
      595   end procedure.
      596   procedure grplib-is-terminal :
      597   do
      598   on error undo, return error "Ошибка процедуры grplib-is-terminal"
      599   :
      600   define input parameter p-node-code      as integer      no-undo.
      601   define output parameter p-is-terminal   as logical      no-undo.
      602       define buffer buf_gds-grp       for ub.gds-grp.
      603       find first buf_gds-grp no-lock
      604           where buf_gds-grp.upper-code = p-node-code
      605       no-error .
      606       if not available buf_gds-grp
      607       then do:
      608           assign
      609               p-is-terminal = yes
      610           .
      611       end.
      612       else do:
      613           assign
      614               p-is-terminal = no
      615           .
      616       end.
      617   end.
      618   end procedure.
      619   procedure grplib-have-goods :
      620   do
      621   on error undo, return error
      622   :
      623   define input parameter p-node-code      as integer      no-undo.
      624   define output parameter p-have-goods   as logical      no-undo.
      625       define buffer buf_goods         for ub.goods.
      626       find first buf_goods no-lock
      627            where buf_goods.grp-code = p-node-code
      628       no-error .
      629       if available buf_goods
      630       then do:
      631           assign
      632               p-have-goods = yes
      633           .
      634       end.
      635       else do:
      636           assign
      637               p-have-goods = no
      638           .
      639       end.
      640   end.
      641   end procedure.
      642   procedure grplib-find-by-substring :
      643   do
      644   on error undo, return error
      645   :
      646   define input parameter p-start-code         as integer      no-undo.
      647   define input parameter p-full-search-string as character    no-undo.
      648   define output parameter p-found-code        as integer      no-undo.
      649   define output parameter p-full-name         as character    no-undo.
      650       define variable v-start-code     as integer           no-undo.
      651       define variable v-found          as logical  init no  no-undo.
      652       define buffer buf_gds-grp       for ub.gds-grp.
      653       search-grp:
      654       for each buf_gds-grp no-lock
      655           where buf_gds-grp.node-code > p-start-code
      656       :
      657           if index( buf_gds-grp.node-name, p-full-search-string ) <> 0
      658           then do:
      659               assign
      660                   p-found-code = buf_gds-grp.node-code
      661                   v-found      = yes
      662               .
      663               run grplib-get-full-name in this-procedure (
      664                     input p-found-code
      665                   , output p-full-name
      666               ) no-error .
      667               if error-status :error
      668               then do:
      669                   undo, return error "grplib-find-by-substring: Ошибка вычисления полного имени группы." + chr(10) + return-value.
      670               end.
      671               leave search-grp.
      672           end.
      673       end.
      674       if v-found = yes
      675       then do:
      676       end.
      677       else do:
      678           assign
      679               p-full-name  = ""
      680               p-found-code = 0
      681           .
      682       end.
      683   end.
      684   end procedure.
      685   procedure grplib-analyze-grp-name :
      686   do
      687   on error undo, return error
      688   :
      689   define input parameter p-grp-name       as character            no-undo.
      690   define input parameter p-upper-code     as integer              no-undo.
      691   define output parameter p-error-message as character init ""    no-undo.
      692       define variable v-char-list     as character    no-undo.
      693       define variable v-char-counter  as integer      no-undo.
      694       define variable v-full-name     as character    no-undo.
      695       if p-grp-name = "" then do:
      696           assign
      697               p-error-message = "Название группы не может быть пустым.".
      698           .
      699       end.
      700       else do:
      701           assign
      702               v-char-list = "47,92,58,63,34,60,62,171,187,183"
      703           .
      704           do v-char-counter = 1 to num-entries( v-char-list )
      705           :
      706               if index( p-grp-name, chr( integer( entry( v-char-counter, v-char-list ) ) ) ) <> 0
      707               then do:
      708                   assign
      709                       p-error-message = 'Название группы не может содержать символы /\:*?"<>|«»·'
      710                   .
      711                   return.
      712               end.
      713           end.
      714           if p-upper-code > 0
      715           then do:
      716               run grplib-get-full-name in this-procedure (
      717                     input p-upper-code
      718                   , output v-full-name
      719               ) no-error .
      720               if error-status :error
      721               then do:
      722                   undo, return error "grplib-analyze-grp-name: Не удалось вычислить полное имя группы." + chr(10) + return-value.
      723               end.
      724               if length( v-full-name ) + 1 + length( p-grp-name ) > 350
      725               then do:
      726                   assign
      727                       p-error-message = 'Полное название группы не может содержать более 350 символов.'
      728                   .
      729               end.
      730           end.
      731       end.
      732   end.
      733   end procedure.
      734   procedure grplib-get-lvl-num :
      735   define input parameter p-node-code  as integer      no-undo.
      736   define output parameter p-lvl-num   as integer      no-undo.
      737       define variable v-full-name    as character    no-undo.
      738   do
      739   on error undo, return error
      740   :
      741       run grplib-get-full-name in this-procedure (
      742             input p-node-code
      743           , output v-full-name
      744       ).
      745       assign
      746           p-lvl-num = num-entries( v-full-name, chr(47) ) - 1
      747       .
      748       if p-lvl-num = -1
      749       then do:
      750           assign
      751               p-lvl-num = 0
      752           .
      753       end.
      754   end.
      755   end procedure.
      756   main-block:
      757   do
      758   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      759   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      760   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      761   :
      762     define variable v-mess    as character no-undo .
      763     define variable var-entry as character no-undo .
      764     define variable v-root-node as integer no-undo .
      765     define buffer buf_tax-rate      for ub.tax-rate .
      766     define buffer buf-next_tax-rate for ub.tax-rate .
      767     define buffer buf_tax-rate-gds-grp for ub.tax-rate-gds-grp.
      768     if g#db-num > 0 then do:
      769       assign
      770         v-mess = "Вызов процедуры в УБД запрещен"
      771       .
      772       run err-mess in this-procedure ( input-output v-mess ).
      773       undo main-block, return error (if p-silent = yes then v-mess else '':U).
      774     end.
      775     if parrate-name = "" then do:
      776       assign
      777         v-mess = "Не указано полное наименование ставки."
      778         var-entry = 'rate-name':U
      779       .
      780       run err-mess in this-procedure ( input-output v-mess ).
      781       undo main-block, return error (if p-silent = yes then v-mess else var-entry ).
      782     end.
      783     if parrate-code = 0 OR
      784       parrate-code = ? then do:
      785       assign
      786         v-mess = "Не указан код ставки."
      787         var-entry = "rate-code":U
      788       .
      789       run err-mess in this-procedure ( input-output v-mess ).
      790       undo main-block, return error (if p-silent = yes then v-mess else var-entry ).
      791     end.
      792     if par-mode = 'ДОБАВЛЕНИЕ':U then do:
      793       find first buf-next_tax-rate share-lock where
      794               buf-next_tax-rate.rate-code = parrate-code no-error .
      795       if available buf-next_tax-rate then do:
      796         assign
      797           v-mess = "Ставка налога с таким кодом уже есть."
      798           var-entry = "rate-code":U
      799         .
      800         run err-mess in this-procedure ( input-output v-mess ).
      801         undo main-block, return error (if p-silent = yes then v-mess else var-entry ).
      802       end.
      803       find first buf-next_tax-rate share-lock where
      804               buf-next_tax-rate.tax-code = partax-code
      805           and buf-next_tax-rate.rate-code = parrate-code
      806         no-error .
      807       if available buf-next_tax-rate then do:
      808         assign
      809           v-mess = "Ставка налога такого вида и с таким кодом уже есть."
      810           var-entry = "rate-code":U
      811         .
      812         run err-mess in this-procedure ( input-output v-mess ).
      813         undo main-block, return error (if p-silent = yes then v-mess else var-entry ).
      814       end.
      815       create buf_tax-rate.
      816       assign
      817       buf_tax-rate.tax-code = partax-code
      818       buf_tax-rate.rate-code = parrate-code
      819       buf_tax-rate.rate-name = parrate-name
      820       buf_tax-rate.status_   = parstatus
      821       par-rid = recid( buf_tax-rate )
      822       .
      823     end.
      824     else do:
      825       find first buf_tax-rate exclusive-lock where
      826                 recid(buf_tax-rate) = par-rid no-error.
      827       if not available buf_tax-rate then do:
      828         assign
      829           v-mess = "Ставка налога отсутствует."
      830         .
      831         run err-mess in this-procedure ( input-output v-mess ).
      832         undo main-block, return error (if p-silent = yes then v-mess else '':U ).
      833       end.
      834       if buf_tax-rate.status_ = 'удал':U then do:
      835         if buf_tax-rate.status_ <> parstatus then do:
      836           assign
      837             buf_tax-rate.status_ = parstatus
      838           .
      839         end.
      840         else do:
      841           assign
      842             v-mess = "Ставка удалена - изменение невозможно."
      843           .
      844           run err-mess in this-procedure ( input-output v-mess ).
      845           undo main-block, return error (if p-silent = yes then v-mess else '':U ).
      846         end.
      847       end.
      848       assign
      849       buf_tax-rate.rate-name = parrate-name
      850       .
      851     end.
      852     release buf_tax-rate no-error .
      853     if error-status:error then do:
      854       assign
      855         v-mess = substitute( "Ошибка при сохранении записи СТАВКА НАЛОГА.&1&2&1&3", chr(10), error-status:get-message(1), return-value )
      856       .
      857       run err-mess in this-procedure ( input-output v-mess ).
      858       undo main-block, return error (if p-silent = yes then v-mess else '':U ).
      859     end.
      860     if partax-code = integer('1':U)
      861     then do:
      862       run  grplib-get-root-code in this-procedure ( output v-root-node).
      863       if not can-find(first ub.tax-rate-gds-grp where
      864                               ub.tax-rate-gds-grp.tax-code = integer('1':U)
      865                           AND ub.tax-rate-gds-grp.node-code = v-root-node
      866                           AND ub.tax-rate-gds-grp.host-code = 0
      867                           AND ub.tax-rate-gds-grp.obj-type = "":U
      868                           AND ub.tax-rate-gds-grp.obj-code = 0
      869                               ) then do:
      870         create buf_tax-rate-gds-grp.
      871         assign
      872         buf_tax-rate-gds-grp.node-code = v-root-node
      873         buf_tax-rate-gds-grp.tax-code = integer('1':U)
      874         buf_tax-rate-gds-grp.rate-code = parrate-code
      875         .
      876         release buf_tax-rate-gds-grp no-error.
      877         if error-status:error then do:
      878           v-mess = substitute("Ошибка при сохранении записи СТАВКА НАЛОГА ДЛЯ ГРУППЫ ТОВАРОВ ПО УМОЛЧАНИЮ (группа с вн.кодом &4) .&1&2&1&3"
      879                                  , chr(10)
      880                                  , error-status:get-message(1)
      881                                  , return-value
      882                                  , v-root-node
      883                                  ).
      884           run err-mess in this-procedure ( input-output v-mess ).
      885           undo main-block, return error (if p-silent = yes then v-mess else '':U ).
      886         end.
      887       end.
      888     end.
      889     return '':U.
      890   end.
      891   procedure err-mess:
      892     define input-output parameter p-mess as character no-undo.
      893     case p-silent:
      894       when yes then do:
      895         assign
      896         p-mess = substitute("Сохранение изменений в карточке ставки налога &1Тип ставки &2&1Код ставки &3&1&4"
      897                            , chr(10)
      898                            , partax-code
      899                            , parrate-code
      900                            , p-mess)
      901         .
      902       end.
      903       when no then do:
      904         message
      905         p-mess
      906         view-as alert-box error .
      907       end.
      908     end.
      909   end procedure.
