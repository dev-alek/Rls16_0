     5424   PROCEDURE proc-cgh-Am :
     5425       do
     5426       on error undo, return error return-value
     5427       :
     5428   define input  parameter v-new as logical   no-undo .
     5429   define buffer buf_matrix                  for  ub.assortment-matrix .
     5430   define buffer buf2_assortment-matrix-goods for ub.assortment-matrix-goods .
     5431   define buffer buf_gds-obj for ub.gds-obj.
     5432   define variable p-doc-rec as recid no-undo .
     5433   define variable v-sts as integer   no-undo .
     5434   DEFINE VARIABLE cError as CHARACTER NO-UNDO INITIAL "".
     5435   DEFINE VARIABLE iDelta as INTEGER   NO-UNDO INITIAL 0.
     5436   v-err-ext = false  .
     5437   v-longchar = "" .
     5438   if (valid-handle(g#lib-Matrix) <> true) then do:   run ref/gds-mat1.p persistent no-error .   if error-status :error or (valid-handle(g#lib-Matrix) <> true) then do:     message       "Error starting library.p" skip       g#lib-Matrix skip       g#lib-Matrix :type skip       g#lib-Matrix :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run clear-longmess in g#lib-Matrix
     5439      .
     5440    run make-gds-list in this-procedure .
     5441    for each obj-list :
     5442         Label-AM:
     5443         for each  buf_matrix no-lock where
     5444             buf_matrix.asmt-status = 0 and
     5445             buf_matrix.obj-type = obj-list.obj-type and
     5446             buf_matrix.obj-code = obj-list.obj-code :
     5447              if v-new = true then do:
     5448                 run waitfram-show in this-procedure  ("Добавление товаров в ассортиментную матрицу  "  +
     5449                                                     buf_matrix.asmt-name +
     5450                                                     "  на объекте " +
     5451                                                     string( obj-list.obj-code )) .
     5452             end.
     5453             else do:
     5454                 run waitfram-show in this-procedure  ("Удаление товаров из ассортиментную матрицу  "  +
     5455                                                     buf_matrix.asmt-name +
     5456                                                     "  на объекте " +
     5457                                                     string( obj-list.obj-code )) .
     5458             end.
     5459             if v-new = true then do:
     5460                RUN Get-Gl-Param-Proc-Otkl in THIS-PROCEDURE(
     5461                    buf_matrix.asmt-id,
     5462                    buf_matrix.db-num,
     5463                    OUTPUT cError
     5464                    ).
     5465                if cError <> "" THEN DO:
     5466                   v-err-ext = true .
     5467                   v-longchar = v-longchar + cError + chr(10).
     5468                   NEXT Label-AM.
     5469                END.
     5470   DEFINE VARIABLE vss-include-info36 AS CHARACTER FORMAT "x(65)" NO-UNDO INITIAL "@(#)$Workfile$ $Revision$".
     5471   FOR EACH gds-list NO-LOCK:
     5472       IF NOT CAN-FIND(FIRST ub.Assortment-matrix-goods WHERE
     5473                             ub.Assortment-matrix-goods.Asmt-id      = buf_matrix.Asmt-id
     5474                         AND ub.Assortment-matrix-goods.Db-num       = buf_matrix.db-num
     5475                         AND ub.Assortment-matrix-goods.gds-code     = gds-list.gds-code
     5476                         AND ub.Assortment-matrix-goods.asmg-status  = INTEGER('0':U)
     5477                         NO-LOCK) THEN DO:
     5478          ASSIGN
     5479             iDelta = iDelta + 1.
     5480       END.
     5481   END.
     5482                RUN Cntrl-AM-Add-1 IN THIS-PROCEDURE(
     5483                    iDelta,
     5484                    OUTPUT cError
     5485                    ).
     5486                if cError <> "" THEN DO:
     5487                   v-err-ext = true .
     5488                   v-longchar = v-longchar + cError + chr(10).
     5489                   NEXT Label-AM.
     5490                END.
     5491             END.
     5492             for each gds-list :
     5493                   if v-new = true then do:
     5494   if (valid-handle(g#lib-Matrix) <> true) then do:   run ref/gds-mat1.p persistent no-error .   if error-status :error or (valid-handle(g#lib-Matrix) <> true) then do:     message       "Error starting library.p" skip       g#lib-Matrix skip       g#lib-Matrix :type skip       g#lib-Matrix :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run main_gds-mat1 in g#lib-Matrix
     5495    (input this-procedure
     5496    ,input-output p-doc-rec
     5497    ,input 'ДОБАВЛЕНИЕ':U
     5498    ,input buf_matrix.asmt-id
     5499    ,input buf_matrix.db-num
     5500    ,input gds-list.gds-code
     5501    ,input ''
     5502     ) no-error .
     5503                       if error-status :error then do:
     5504                         v-err-ext = true .
     5505                         v-longchar = v-longchar + return-value + chr(10).
     5506                       end.
     5507                   end.
     5508                   else do:
     5509                     find first buf2_assortment-matrix-goods no-lock where
     5510                                buf2_assortment-matrix-goods.asmt-id  = buf_matrix.asmt-id and
     5511                                buf2_assortment-matrix-goods.db-num   = buf_matrix.db-num  and
     5512                                buf2_assortment-matrix-goods.gds-code = gds-list.gds-code  and
     5513                                buf2_assortment-matrix-goods.asmg-status = 0
     5514                                no-error .
     5515                                 if available buf2_assortment-matrix-goods then do:
     5516                                     v-sts = int('1':U) .
     5517   if (valid-handle(g#lib-Matrix) <> true) then do:   run ref/gds-mat1.p persistent no-error .   if error-status :error or (valid-handle(g#lib-Matrix) <> true) then do:     message       "Error starting library.p" skip       g#lib-Matrix skip       g#lib-Matrix :type skip       g#lib-Matrix :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run main_gds-mat2 in g#lib-Matrix
     5518    (input this-procedure
     5519    ,input recid(buf2_assortment-matrix-goods)
     5520    ,input-output v-sts
     5521    ,input no
     5522     ) no-error .
     5523                                     if error-status :error then dO:
     5524                                         v-err-ext = true .
     5525                                         v-longchar = v-longchar + return-value + chr(10).
     5526                                     end.
     5527                                 end.
     5528                   end.
     5529             end.
     5530         end.
     5531     end.
     5532   run waitfram-hide in this-procedure .
     5533   if v-err-ext = true  then do:
     5534   define variable v-ok as logical   no-undo .
     5535     run gbl/d-longchar.w (
     5536           ?,
     5537           'Editor_row=2\':u
     5538         + 'title=При изменениях Ассортиментных матриц из ABC \':u
     5539         + 'Editor_col=1\':u
     5540         + 'Editor_width=96\':u
     5541         + 'Editor_height=21\':u
     5542         + 'readonly=yes\':u
     5543       ,input-output v-longchar
     5544       ,output v-ok ) no-error .
     5545       v-longchar = "" .
     5546   if (valid-handle(g#lib-Matrix) <> true) then do:   run ref/gds-mat1.p persistent no-error .   if error-status :error or (valid-handle(g#lib-Matrix) <> true) then do:     message       "Error starting library.p" skip       g#lib-Matrix skip       g#lib-Matrix :type skip       g#lib-Matrix :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run clear-longmess in g#lib-Matrix
     5547      .
     5548   end.
     5549   run OpenBr in this-procedure (yes, no, '':U).
     5550       end.
     5551   END PROCEDURE.
     5552   PROCEDURE proc-cgh-Amin :
     5553       do
     5554       on error undo, return error return-value
     5555       :
     5556   define input  parameter v-new as logical   no-undo .
     5557     run make-gds-list in this-procedure  .
     5558     run ref/chg-amin.p ( input v-new ) no-error  .
     5559         if error-status :error then
     5560             message vss-workfile vss-revision vss-description skip
     5561             error-status :get-message(1)
     5562             return-value
     5563             .
     5564     run OpenBr in this-procedure (yes, no, '':U).
     5565       end.
     5566   END PROCEDURE.
     5567   PROCEDURE proc-chg-abc :
     5568   END PROCEDURE.
     5569   PROCEDURE proc-chg-igt :
     5570       do
     5571       on error undo, return error return-value
     5572       :
     5573   define variable  v-old as character no-undo .
     5574   define variable  v-new as character no-undo .
     5575     run make-gds-list in this-procedure  .
     5576     run ref/graf-igt.w
     5577     ( output v-old, output v-new ).
     5578     if not(v-old = "" and v-new = "")  then do:
     5579         run ref/chg-igt.p
     5580          ( input v-old, input v-new , input true ) no-error  .
     5581             if error-status :error then
     5582                 message vss-workfile vss-revision vss-description skip
     5583                 error-status :get-message(1)
     5584                 return-value
     5585                 .
     5586     end.
     5587   run OpenBr in this-procedure (yes, no, '':U).
     5588       end.
     5589   END PROCEDURE.
     5590   PROCEDURE proc-disp-goods :
     5591   define variable   v-old-izt  as character no-undo .
     5592   define variable   v-old-amin  as character no-undo .
     5593   define variable   v-old-acc-mat  as character no-undo .
     5594   define variable   v-new-izt  as character no-undo .
     5595   define variable   v-new-amin  as character no-undo .
     5596   define variable   v-new-acc-mat  as character no-undo .
     5597   define variable vt-Amin as character no-undo .
     5598       assign
     5599       v-old-izt  = ""
     5600       v-izt      = ""
     5601       v-Amin     = ""
     5602       v-old-Amin = ""
     5603       v-acc-mat     =  ""
     5604       v-old-acc-mat = ""
     5605       .
     5606   OPEN QUERY BROWSE-obj       FOR EACH Buf_abc-analysis-obj WHERE                Buf_abc-analysis-obj.abc-id = v-id AND                Buf_abc-analysis-obj.db-num = v-db-num                NO-LOCK,                  EACH buf_abc-analysis-gds-obj WHERE                buf_abc-analysis-gds-obj.obj-type = Buf_abc-analysis-obj.obj-type AND                buf_abc-analysis-gds-obj.obj-code = Buf_abc-analysis-obj.obj-code AND                buf_abc-analysis-gds-obj.gds-code = Buf_abc-analysis-goods.gds-code AND                buf_abc-analysis-gds-obj.abc-id   = v-id AND                buf_abc-analysis-gds-obj.db-num   = v-db-num                OUTER-JOIN NO-LOCK,                  EACH Buf_gds-obj-prop WHERE                Buf_gds-obj-prop.obj-type =  Buf_abc-analysis-obj.obj-type AND                Buf_gds-obj-prop.obj-code =  Buf_abc-analysis-obj.obj-code AND                Buf_gds-obj-prop.gds-code =  Buf_abc-analysis-goods.gds-code                OUTER-JOIN NO-LOCK,                 first buf_assortment-matrix WHERE                buf_assortment-matrix.asmt-status        = 0  AND                buf_assortment-matrix.obj-type =  Buf_abc-analysis-obj.obj-type AND                buf_assortment-matrix.obj-code =  Buf_abc-analysis-obj.obj-code                OUTER-JOIN NO-LOCK,                 FIRST buf_assortment-matrix-goods WHERE                buf_assortment-matrix-goods.asmg-status        = 0  AND                buf_assortment-matrix-goods.asmt-id  =  buf_assortment-matrix.asmt-id AND                buf_assortment-matrix-goods.db-num   =  buf_assortment-matrix.db-num  AND                buf_assortment-matrix-goods.gds-code =  buf_abc-analysis-goods.gds-code                OUTER-JOIN NO-LOCK INDEXED-REPOSITION.
     5607       GET next BROWSE-obj.
     5608       assign
     5609       v-old-izt      =  if not available Buf_gds-obj-prop then "" else  Buf_gds-obj-prop.gdop-igt
     5610       v-izt          =  if not available Buf_gds-obj-prop then "" else Buf_gds-obj-prop.gdop-igt
     5611       v-Amin         =  if not available Buf_gds-obj-prop then "" else string (Buf_gds-obj-prop.gdop-assort-min)
     5612       v-old-Amin     =  if not available Buf_gds-obj-prop then "" else string (Buf_gds-obj-prop.gdop-assort-min)
     5613       v-acc-mat      =  if not available buf_assortment-matrix-goods then "" else string (buf_assortment-matrix-goods.asmt-id)
     5614       v-old-acc-mat  =  if not available buf_assortment-matrix-goods then "" else string (buf_assortment-matrix-goods.asmt-id)
     5615       no-error
     5616       .
     5617       if v-old-Amin = ?    or
     5618           v-old-Amin = "no" or
     5619           v-old-Amin = "?"  or
     5620           v-old-Amin = ""   then v-old-Amin = "" .
     5621       if v-izt = ? or v-izt = "" then v-izt = 'Пусто':U .
     5622       if v-old-izt = ? or v-old-izt = "" then v-old-izt = 'Пусто':U .
     5623       if v-Amin = ? or v-Amin = 'no' or v-Amin = "?" or v-Amin = "" then v-Amin = "не входит" .
     5624          else v-Amin = "входит" .
     5625       if v-acc-mat = ? or v-acc-mat = ""  then v-acc-mat = "не входит" .
     5626          else v-acc-mat = "входит" .
     5627       DO WHILE AVAILABLE(Buf_abc-analysis-obj):
     5628       assign
     5629           v-new-izt      =  if not available Buf_gds-obj-prop then 'Пусто':U else  Buf_gds-obj-prop.gdop-igt
     5630           v-new-Amin     =  if not available Buf_gds-obj-prop then "" else string (Buf_gds-obj-prop.gdop-assort-min)
     5631           v-new-acc-mat  =  if not available buf_assortment-matrix-goods then "" else string (buf_assortment-matrix-goods.asmt-id)
     5632           no-error.
     5633           if v-new-izt <> ? then
     5634           if v-old-izt     <> v-new-izt  then  v-izt = "разное" .
     5635           vt-amin = v-new-amin .
     5636           if vt-Amin = ?    or
     5637              vt-Amin = 'no' or
     5638              vt-Amin = "?"  or
     5639              vt-Amin = "" then vt-Amin = "" .
     5640           if v-old-Amin    <> vt-Amin  then  v-Amin = "разное" .
     5641           if v-old-acc-mat <> v-new-acc-mat
     5642             and (v-old-acc-mat = ? or v-new-acc-mat = ? or v-new-acc-mat = "" )
     5643             then  v-acc-mat = "разное" .
     5644         assign
     5645           v-old-izt     = v-new-izt
     5646           v-old-Amin    = v-new-Amin
     5647           v-old-acc-mat = v-new-acc-mat
     5648         .
     5649           if v-old-Amin = ? or
     5650              v-old-Amin = 'no' or
     5651              v-old-Amin = "?" or
     5652              v-old-Amin = "" then v-old-Amin = "" .
     5653           if v-old-izt = ? or v-old-izt = "" then v-old-izt = 'Пусто':U .
     5654         GET NEXT BROWSE-obj.
     5655       END.
     5656   END PROCEDURE.
     5657   PROCEDURE proc-save :
     5658     define variable v-list-doc as character no-undo .
     5659     define variable v-list-obj as character no-undo .
     5660     define variable v-possb-keep-string-obj as logical   no-undo .
     5661     define variable v-string-obj            as character no-undo .
     5662     define variable v-hash-string-obj       as character no-undo .
     5663     define variable v-recid as recid  no-undo .
     5664     define buffer x-abc-analysis for ub.abc-analysis.
     5665     define buffer x-abc-analysis-obj for ub.abc-analysis-obj .
     5666     define buffer x-abc-analysis-doc for ub.abc-analysis-doc .
     5667     run waitfram-show in this-procedure ( "Сохранение анализа по умолчанию ... ") .
     5668     v-list-obj = "" .
     5669     find first x-abc-analysis no-lock  where
     5670                x-abc-analysis.abc-id  = v-id and
     5671                x-abc-analysis.db-num  = v-db-num  no-error .
     5672                if error-status :error then return .
     5673     for each  x-abc-analysis-obj no-lock
     5674         where x-abc-analysis-obj.abc-id = x-abc-analysis.abc-id and
     5675               x-abc-analysis-obj.db-num = x-abc-analysis.db-num  :
     5676               v-list-obj = v-list-obj + x-abc-analysis-obj.obj-type + string(x-abc-analysis-obj.obj-code) + "," .
     5677     end.
     5678     run find-from-hash  in this-procedure  (
     5679        input v-list-obj
     5680       ,input "rang-abc-def"
     5681       ,input "raad-possb-keep-string-obj"
     5682       ,input "raad-string-obj"
     5683       ,input "raad-hash-string-obj"
     5684       ,input "rang-abc-def-obj"
     5685       ,output v-recid
     5686       ).
     5687     run update-rang-def  in this-procedure (
     5688        input v-recid
     5689       ,input v-list-obj
     5690       ,input x-abc-analysis.abc-a
     5691       ,input x-abc-analysis.abc-b
     5692       ,input x-abc-analysis.abc-c
     5693       ,input x-abc-analysis.abc-d
     5694       ,input x-abc-analysis.abc-e
     5695       ,input x-abc-analysis.abc-f
     5696       ).
     5697     v-list-doc = "".
     5698     for each x-abc-analysis-doc no-lock
     5699         where x-abc-analysis-doc.abc-id = x-abc-analysis.abc-id and
     5700               x-abc-analysis-doc.db-num = x-abc-analysis.db-num  :
     5701               v-list-doc = v-list-doc + x-abc-analysis-doc.abcd-ext-doc-type  + "," .
     5702     end.
     5703     run find-from-hash in this-procedure   (
     5704        input v-list-obj
     5705       ,input "doc-abc-def"
     5706       ,input "doad-possb-keep-string-obj"
     5707       ,input "doad-string-obj"
     5708       ,input "doad-hash-string-obj"
     5709       ,input "doc-abc-def-obj"
     5710       ,output v-recid
     5711       ).
     5712     run update-doc-def in this-procedure  (
     5713        input v-recid
     5714       ,input v-list-obj
     5715       ,input v-list-doc
     5716       ).
     5717     run waitfram-hide in this-procedure  .
     5718     define variable p-ok as logical   no-undo .
     5719       run save-def-analysis-obj in this-procedure  (
     5720         input "abc"
     5721       , input x-abc-analysis.db-num
     5722       , input x-abc-analysis.abc-id
     5723       , output p-ok) .
     5724      if p-ok then message
     5725      "Интервалы ранжирования и типы документов запомнены для данного списка объектов по умолчанию" skip
     5726      "Этот анализ будет использоваться в отчетах как анализ по умолчанию" skip
     5727      x-abc-analysis.abc-id skip
     5728      x-abc-analysis.abc-name
     5729     view-as alert-box information .
     5730   END PROCEDURE.
     5731   PROCEDURE prt-goods :
     5732   define variable   v-old-izt  as character no-undo .
     5733   define variable   v-old-amin  as character no-undo .
     5734   define variable   v-old-acc-mat  as character no-undo .
     5735   define variable vt-Amin as character no-undo .
     5736   define variable t-izt as character no-undo .
     5737   define variable t-Amin as character no-undo .
     5738   define variable t-asm as character no-undo .
     5739   define variable         v-gdop-min-stock     as decimal   no-undo .
     5740   define variable         v-grop-max-stock     as decimal   no-undo .
     5741   define variable         v-grop-level-always-presence as decimal   no-undo .
     5742   define variable         v-grop-min-order             as decimal   no-undo .
     5743       assign
     5744       v-old-izt  = ""
     5745       v-izt      = ""
     5746       v-Amin     = ""
     5747       v-old-Amin = ""
     5748       v-acc-mat     =  ""
     5749       v-old-acc-mat = ""
     5750       .
     5751   define buffer buf2_abc-analysis-gds-obj for ub.abc-analysis-gds-obj   .
     5752   define buffer buf2_assortment-matrix for ub.assortment-matrix.
     5753   define buffer buf2_assortment-matrix-goods for ub.assortment-matrix-goods.
     5754   define variable fl as logical   no-undo .
     5755   fl = true .
     5756   for each buf_abc-analysis-obj where
     5757            buf_abc-analysis-obj.abc-id = v-id and
     5758            buf_abc-analysis-obj.db-num = v-db-num
     5759            no-lock
     5760               :
     5761               find first buf2_abc-analysis-gds-obj where
     5762                           buf2_abc-analysis-gds-obj.obj-type = buf_abc-analysis-obj.obj-type and
     5763                           buf2_abc-analysis-gds-obj.obj-code = buf_abc-analysis-obj.obj-code and
     5764                           buf2_abc-analysis-gds-obj.gds-code = buf_abc-analysis-goods.gds-code and
     5765                           buf2_abc-analysis-gds-obj.abc-id   = v-id and
     5766                           buf2_abc-analysis-gds-obj.db-num   = v-db-num
     5767                           no-lock no-error .
     5768                   find first buf2_assortment-matrix where
     5769                         buf2_assortment-matrix.asmt-status        = 0  and
     5770                         buf2_assortment-matrix.obj-type =  buf_abc-analysis-obj.obj-type and
     5771                         buf2_assortment-matrix.obj-code =  buf_abc-analysis-obj.obj-code
     5772                         no-lock no-error .
     5773                   find first buf2_assortment-matrix-goods where
     5774                         buf2_assortment-matrix-goods.asmg-status        = 0  and
     5775                         buf2_assortment-matrix-goods.asmt-id  =  buf2_assortment-matrix.asmt-id and
     5776                         buf2_assortment-matrix-goods.db-num   =  buf2_assortment-matrix.db-num  and
     5777                         buf2_assortment-matrix-goods.gds-code =  buf_abc-analysis-goods.gds-code
     5778                         no-lock no-error .
     5779                   if available buf_abc-analysis-goods and available buf_abc-analysis-obj then do:
     5780   define variable vss-include-info37 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5781   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjpr in g#library
     5782     (input  buf_abc-analysis-obj.obj-type
     5783     ,input  buf_abc-analysis-obj.obj-code
     5784     ,input  ?
     5785     ,input  ?
     5786     ,input  ?
     5787     ,input  Buf_abc-analysis-goods.gds-code
     5788     ,output t-amin
     5789     ,output t-izt
     5790     ,output v-gdop-min-stock
     5791     ,output v-grop-max-stock
     5792     ,output v-grop-level-always-presence
     5793     ,output v-grop-min-order
     5794     )  .
     5795                    end.
     5796                if not available buf2_assortment-matrix-goods then t-asm = "0" .
     5797                                                              else t-asm = "1".
     5798               if fl = true then do:
     5799                     assign
     5800                     fl = false
     5801                     v-old-izt  =  t-izt
     5802                     v-izt      =  t-izt
     5803                     v-Amin     =  t-amin
     5804                     v-old-Amin =  t-amin
     5805                     v-acc-mat     =  t-asm
     5806                     v-old-acc-mat =  t-asm
     5807                     .
     5808                     if  v-Amin = 'no'  then v-Amin = "не входит" .
     5809                                        else v-Amin = "входит" .
     5810                     if v-acc-mat = "0" then v-acc-mat = "не входит" .
     5811                                        else v-acc-mat = "входит" .
     5812               end.
     5813           if v-old-izt     <> t-izt            then  v-izt = "разное" .
     5814           if v-old-Amin    <> t-Amin           then  v-Amin = "разное" .
     5815           if v-old-acc-mat <> t-asm            then  v-acc-mat = "разное" .
     5816         assign
     5817           v-old-izt     = t-izt
     5818           v-old-Amin    = t-Amin
     5819           v-old-acc-mat = t-asm
     5820         .
     5821   end.
     5822   END PROCEDURE.
     5823   PROCEDURE get-report-num :
     5824   define output parameter p-report-num as integer no-undo .
     5825     do
     5826     on error undo, return error return-value
     5827     :
     5828       run gbl/getrpnum.p (output p-report-num).
     5829     end.
     5830   END PROCEDURE.
     5831   FUNCTION mark-string RETURNS CHARACTER
     5832     ( BUFFER loc-buf FOR abc-analysis-goods, input mark-list as character  ) :
     5833       RETURN ( IF LOOKUP( STRING( RECID( loc-buf ) ), mark-list ) > 0 THEN "*" ELSE "":U ).
     5834   END FUNCTION.
