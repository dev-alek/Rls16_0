        5   DEFINE BUFFER buf_assortment-matrix FOR assortment-matrix.
        6   DEFINE BUFFER buf_assortment-matrix-goods FOR assortment-matrix-goods.
        7   DEFINE BUFFER Buf_gds-obj-prop FOR gds-obj-prop.
        8   DEFINE NEW SHARED BUFFER buf_goods FOR goods.
        9   define input  parameter parParentProc AS WIDGET-HANDLE NO-UNDO.
       10   define input  parameter v-id          as integer   no-undo .
       11   define input  parameter v-db-num      as integer   no-undo .
       12   define variable vss-revision    as character no-undo init "$Revision$":U .
       13   define variable vss-author      as character no-undo init "$Author$":U .
       14   define variable vss-date        as character no-undo init "$Date$":U .
       15   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       16   define variable vss-archive     as character no-undo init "$Archive$":U .
       17   define variable vss-description as character no-undo init "Просмотр результатов АВС анализа".
       18   procedure vss-get-info :
       19     define output parameter p-vss-revision    like vss-revision    no-undo .
       20     define output parameter p-vss-author      like vss-author      no-undo .
       21     define output parameter p-vss-date        like vss-date        no-undo .
       22     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       23     define output parameter p-vss-archive     like vss-archive     no-undo .
       24     define output parameter p-vss-description like vss-description no-undo .
       25     assign
       26       p-vss-revision    = vss-revision
       27       p-vss-author      = vss-author
       28       p-vss-date        = vss-date
       29       p-vss-workfile    = vss-workfile
       30       p-vss-archive     = vss-archive
       31       p-vss-description = vss-description
       32     .
       33   end procedure.
       34   procedure vss-get-parameters :
       35     define output parameter p-vss-parameters as character no-undo .
       36   end procedure.
       37   define new global shared variable g#vssrevis-logger as handle    no-undo .
       38   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       39   define variable v-vssrevis-logger                   as handle    no-undo .
       40   procedure vss-logevent :
       41     define input  parameter p-extra-paramters as character no-undo .
       42     define variable v-vssrevis-parameters as character no-undo .
       43     do
       44     on error undo, return error return-value
       45     :
       46       if  valid-handle(v-vssrevis-logger)
       47       and v-vssrevis-logger :get-signature("logevent") <> ""
       48       then do:
       49         run vss-get-parameters in this-procedure
       50           (output v-vssrevis-parameters
       51           ).
       52         run logevent in v-vssrevis-logger
       53           (input vss-workfile
       54           ,input vss-revision
       55           ,input v-vssrevis-parameters
       56           ,input p-extra-paramters
       57           ).
       58       end.
       59     end.
       60   end procedure.
       61   assign
       62     v-vssrevis-logger = g#vssrevis-logger
       63   .
       64   if  valid-handle(v-vssrevis-logger)
       65   and v-vssrevis-logger :get-signature("logevent") <> ""
       66   then do:
       67     assign
       68       v-vssrevis-logevent = true
       69     .
       70     run vss-logevent in this-procedure (input vss-description) .
       71   end.
       72   define new global shared variable g#language as character no-undo .
       73   if g#language <> '' and g#language <> 'rus':U then do:
       74     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       75   end.
       76   define new global shared variable g#library  as handle no-undo .
       77   define new global shared variable g#library2 as handle no-undo .
       78   define   shared variable g#auto as logical no-undo.
       79   define   shared variable g#news as logical no-undo.
       80   define   shared variable g#oxml as logical no-undo.
       81   define   shared variable g#esys as logical no-undo.
       82   define   shared variable g#news-source-db as integer no-undo.
       83   define   shared variable g#esys-source-esys as integer no-undo.
       84   define   shared variable g#db-num as integer   no-undo .
       85   define   shared variable g#userid as character no-undo .
       86   define   shared variable g#passwd as character no-undo .
       87   procedure proc-alt-shift-f2:
       88     if not ibs.th.gbl.gbl-var:rcode
       89   then
       90     run gbl\inidebug.p .
       91   end.
       92   procedure proc-alt-shift-f3:
       93     run gbl/prvssinf.p
       94       ( input this-procedure
       95       ) .
       96   end.
       97   define variable v-inform-launched as logical no-undo initial false .
       98   procedure proc-alt-shift-f4:
       99     define variable v-action as character no-undo .
      100     if v-inform-launched = false then do:
      101       assign
      102         v-inform-launched = true
      103       .
      104       run gbl/d-inform.w
      105         (  input self
      106         ,  input this-procedure
      107         , output v-action
      108         ) no-error .
      109       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      110       assign
      111         v-inform-launched = false
      112       .
      113     end.
      114   end.
      115   procedure proc-alt-f1:
      116     run gbl/corrhelp.p
      117       (input this-procedure
      118       ) .
      119   end .
      120   on alt-shift-f2 anywhere do:
      121     run proc-alt-shift-f2.
      122   end.
      123   on alt-shift-f3 anywhere do:
      124     run proc-alt-shift-f3 in this-procedure .
      125   end.
      126   on alt-shift-f4 anywhere do:
      127     run proc-alt-shift-f4 in this-procedure.
      128   end.
      129   on alt-f1 anywhere do:
      130     run proc-alt-f1 in this-procedure .
      131   end.
      132   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      133   define variable v-waitfram-action01         as character   no-undo .
      134   define variable v-waitfram-action02         as character   no-undo .
      135   define variable v-waitfram-action03         as character   no-undo .
      136   define variable mWaitFramTextBeg            as character   no-undo.
      137   define variable mWaitFramTextEnd            as character   no-undo.
      138   define variable mWaitFramView               as logical     no-undo.
      139   define variable mWaitProcEvent              as logical     no-undo init yes.
      140   define variable mWaitFramInterval           as integer     no-undo init 1 .
      141   define variable mWaitFramStop               as logical     no-undo.
      142   define variable mWaitFramStopUser           as logical     no-undo.
      143   define variable mWaitFramStopTimeOut        as logical     no-undo.
      144   define variable mWaitFramStartProc          as datetime-tz no-undo.
      145   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      146   define button B-WaitFramStop auto-end-key
      147        label "Стоп"
      148        size 10 by 1 tooltip "Остоновить процесс".
      149   define button B-viewProcInfo
      150        label "Информация"
      151        size 15 by 1 tooltip "Информация о процесс".
      152   define frame waitfram
      153     v-waitfram-action01 format "x(72)" no-label skip
      154     v-waitfram-action02 format "x(72)" no-label skip
      155     v-waitfram-action03 format "x(72)" no-label skip
      156     B-viewProcInfo
      157     B-WaitFramStop at row 4 col 30
      158     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      159     .
      160   define new global shared variable mBatchMode as logical no-undo init ?.
      161   define variable mFramBachModHandle as handle no-undo.
      162   mFramBachModHandle = frame waitfram:handle.
      163   define variable mFameOldVis as logical no-undo.
      164   define variable mVisCUrentVin as logical no-undo.
      165   if session:batch-mode
      166   then
      167      mBatchMode = yes.
      168   if mBatchMode = ? then do:
      169     mVisCUrentVin = current-window:visible.
      170     mFameOldVis = mFramBachModHandle:visible.
      171     mFramBachModHandle:visible  = yes.
      172     mBatchMode = mFramBachModHandle:visible ne yes.
      173     mFramBachModHandle:visible = mFameOldVis.
      174     current-window:visible = mVisCUrentVin.
      175   end.
      176    if  log-manager:logfile-name ne ?
      177     then DO:
      178         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      179         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      180         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      181     end.
      182   on choose of B-WaitFramStop in frame waitfram
      183   do:
      184     mWaitFramStop = yes.
      185     mWaitFramStopUser = yes.
      186   end.
      187   function waitfram-check-timeout returns logical():
      188      define variable vtime as int64 no-undo.
      189      if mWaitFramStopTimeOut
      190      then
      191         return yes.
      192      vtime = ( now - mWaitFramStartProc ) / 1000 .
      193      if     mWaitFramTimeOut ne ?
      194         and mWaitFramTimeOut ne 0
      195         and mWaitFramTimeOut lt vtime
      196      then do:
      197         mWaitFramStopTimeOut = yes.
      198      end.
      199      return mWaitFramStopTimeOut.
      200   end.
      201   procedure waitfram-hide :
      202     if not session:batch-mode
      203     then do
      204     on error undo, return error return-value
      205     :
      206       pause 0 before-hide .
      207       if not mBatchMode then
      208         hide frame waitfram .
      209     if     not mWaitFramView
      210        and mWaitProcEvent
      211     then
      212       process events .
      213     end.
      214   end procedure.
      215   procedure waitfram-show :
      216     define input  parameter p-message as character no-undo .
      217     define variable v-left-margin as integer   no-undo .
      218     if not session:batch-mode
      219     then do
      220     on error undo, return error return-value
      221     :
      222       if length(p-message) <= 70 then do:
      223         assign
      224           v-left-margin = integer((70 - length(p-message)) / 2)
      225         .
      226         assign
      227           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      228         .
      229         assign
      230           v-waitfram-action01 = " "
      231           v-waitfram-action02 = " "
      232                                    + fill(" ", v-left-margin)
      233                                    + p-message
      234           v-waitfram-action03 = " "
      235         .
      236       end.
      237       else do:
      238         define variable vRindex1 as integer no-undo.
      239         define variable vRindex2 as integer no-undo.
      240         vRindex1 = r-index(p-message," ",70).
      241         if vRindex1 = 0
      242         then
      243            vRindex1 = 70.
      244         if length(p-message)  <= vRindex1 + 70 then do:
      245           assign
      246             v-waitfram-action01 = " "
      247             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      248             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      249           .
      250         end.
      251         else do:
      252           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      253           if vRindex2 <= vRindex1
      254           then
      255              vRindex2 = vRindex1 + 70.
      256           assign
      257             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      258             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      259             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      260           .
      261         end.
      262       end.
      263       B-viewProcInfo:visible   in frame waitfram = no.
      264       B-viewProcInfo:sensitive in frame waitfram = no.
      265       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      266       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      267       if  (   mWaitFramView
      268          or  mWaitProcEvent)
      269          and not mBatchMode
      270       then
      271          display
      272             v-waitfram-action01 skip
      273             v-waitfram-action02 skip
      274             v-waitfram-action03 skip
      275          with frame waitfram .
      276       if     mWaitFramView
      277          then do:
      278             if     mWaitFramInterval ne ?
      279                and not mBatchMode
      280             then
      281                wait-for go of frame waitfram pause mWaitFramInterval.
      282          end.
      283          else
      284             if     mWaitProcEvent
      285                and not mBatchMode
      286             then
      287                process events .
      288     end.
      289   end procedure.
      290      procedure waitfram-show-this:
      291         define input  parameter iInterval as int64 no-undo.
      292         define variable vtime as int64 no-undo.
      293         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      294         mWaitFramInterval = iInterval.
      295         run waitfram-show (substitute("&1&2 &3&4" ,
      296                                       mWaitFramTextBeg ,
      297                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      298                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      299                                       mWaitFramTextEnd
      300                                      )
      301                           ).
      302      end.
      303      procedure WaitFramRunPause:
      304         define input  parameter iInterval as dec no-undo.
      305         define variable vStart  as datetime-tz no-undo.
      306         define variable vend    as datetime-tz no-undo.
      307         define variable vint as int64 no-undo.
      308         define variable vOk as logical no-undo.
      309         vStart = now.
      310         vend   = vStart.
      311         publish "WaitFramPause" (iInterval,output vOk).
      312         vend   =  now.
      313         vint = vend - vStart.
      314         vint = iInterval - vint / 1000.
      315         if     not mWaitFramStop
      316            and (   vint > 0
      317                 or (    not vOk
      318                     and iInterval eq ?
      319                     )
      320                 )
      321         then
      322            run waitfram-show-this (iInterval).
      323         vend   =  now.
      324         vint = vend - vStart.
      325         vint = iInterval - vint / 1000.
      326         if     not mWaitFramStop
      327            and vint > 0
      328         then do:
      329            run gbl/pause.p (vint * 1000).
      330         end.
      331         if iInterval ne ?
      332         then
      333            publish "WaitFramStop".
      334         waitfram-check-timeout().
      335      end.
      336      procedure WaitFramWaitFor:
      337         define input  parameter iInterval as dec no-undo.
      338         assign
      339            mWaitFramStartProc   = now
      340            mWaitFramStopUser    = no
      341            mWaitFramStopTimeOut = no
      342         .
      343         block-wait:
      344         do while not mWaitFramStop:
      345            run WaitFramRunPause (iInterval).
      346            if  waitfram-check-timeout()
      347            then do:
      348               leave block-wait.
      349            end.
      350         end.
      351         run waitfram-hide.
      352      end.
      353   procedure waitfram-join :
      354     define input  parameter p-line-1  as character no-undo .
      355     define input  parameter p-line-2  as character no-undo .
      356     define input  parameter p-line-3  as character no-undo .
      357     define output parameter p-message as character no-undo .
      358     do
      359     on error undo, return error return-value
      360     :
      361       assign
      362         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      363                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      364                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      365       .
      366     end.
      367   end procedure.
      368   function waitfram-join-function returns character
      369     (input p-line-1 as character
      370     ,input p-line-2 as character
      371     ,input p-line-3 as character
      372     ).
      373     define variable v-message as character no-undo .
      374     run waitfram-join in this-procedure
      375       (input  p-line-1
      376       ,input  p-line-2
      377       ,input  p-line-3
      378       ,output v-message
      379       ) .
      380     return v-message .
      381   end function .
      382   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      383   def
      384   new shared
      385   temp-table  obj-list no-undo
      386     field obj-type like ub.clients.obj-type
      387     field obj-code like ub.clients.obj-code
      388     field obj-name like ub.clients.obj-name
      389     field obj-id   as integer
      390     field db-num   as integer
      391     index pi is primary unique obj-id
      392     index ie1 obj-type obj-code
      393     index ie2 obj-name
      394   .
      395   procedure create_obj-list :
      396      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      397      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      398      do
      399      on error undo, return error return-value
      400      :
      401         define buffer cli-obj for ub.clients .
      402         define variable p-var as integer no-undo .
      403         define buffer buf_obj-list for obj-list .
      404         find last buf_obj-list  use-index pi no-error .
      405         if available buf_obj-list
      406         then
      407            p-var = buf_obj-list.obj-id + 1.
      408         else
      409            p-var = 1.
      410         find first cli-obj where
      411                   cli-obj.obj-type = p-obj-type
      412               and cli-obj.obj-code = p-obj-code
      413         no-lock no-error.
      414         if available cli-obj
      415         then do:
      416            create buf_obj-list.
      417            assign
      418               buf_obj-list.obj-id   = p-var
      419               buf_obj-list.obj-code = cli-obj.obj-code
      420               buf_obj-list.obj-type = cli-obj.obj-type
      421               buf_obj-list.obj-name = cli-obj.obj-name
      422               buf_obj-list.db-num   = cli-obj.db-num
      423            .
      424         end.
      425      end.
      426   end.
