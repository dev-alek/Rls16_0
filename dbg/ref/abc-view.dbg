     3142   ON CHOOSE OF b-filter-ext IN FRAME Dialog-Frame
     3143   DO:
     3144       if r-2 = 1 then r-2 = 2 .
     3145                else r-2 = 1.
     3146     if r-2 = 2 then do:
     3147       find first gds-list-flt where gds-list-flt.gds-code = 0 no-error .
     3148       if available gds-list-flt then delete gds-list-flt.
     3149       release gds-list-flt .
     3150       run str/fext-gds.w
     3151           ( parparentproc ,
     3152           v-cntxt-host-code-obj,
     3153           v-cntxt-obj-type,
     3154           v-cntxt-obj-code
     3155           ).
     3156       if not can-find (first gds-list-flt ) then  do:
     3157           create gds-list-flt.
     3158           gds-list-flt.gds-code = 0 .
     3159           release gds-list-flt .
     3160           message "Расширенный фильтр пуст!" view-as alert-box information .
     3161       end.
     3162       b-filter-ext:LOAD-IMAGE ("cmp/b-sche.bmp") .
     3163        find last gds-list-flt-hist.
     3164        b-filter-ext:tooltip =  gds-list-flt-hist.des .
     3165     end.
     3166     else do:
     3167        b-filter-ext:LOAD-IMAGE ("cmp/b-schef.bmp") .
     3168        b-filter-ext:tooltip = "Расширенный фильтр не установлен" .
     3169     end.
     3170     run OpenBr in this-procedure ( yes, no, '':U ) .
     3171   END.
     3172   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
     3173   DO:
     3174       if available Buf_abc-analysis-goods then do:
     3175   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
