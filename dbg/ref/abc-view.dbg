     2389   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
     2390   DEFINE VARIABLE vss-include-info22 AS CHARACTER FORMAT "x(65)" NO-UNDO INITIAL "@(#)$Workfile$ $Revision$".
     2391   FUNCTION indicator-life-gds-n RETURNS CHARACTER ( input p-rec as recid ) FORWARD.
     2392   DEFINE VARIABLE v-gl-iProc-Otkl AS DECIMAL NO-UNDO INITIAL 0.
     2393   DEFINE VARIABLE v-gl-lAM-Is-Obj         AS LOGICAL NO-UNDO INITIAL FALSE.
     2394   DEFINE VARIABLE v-gl-iAM-Gds-All        AS INTEGER NO-UNDO INITIAL 0.
     2395   DEFINE VARIABLE v-gl-iAM-Sbl-Gds-All    AS INTEGER NO-UNDO INITIAL 0.
     2396   DEFINE VARIABLE v-gl-iAM-Gds-Vyv        AS INTEGER NO-UNDO INITIAL 0.
     2397   DEFINE VARIABLE v-gl-lAM-Ref-Shablon    AS LOGICAL NO-UNDO INITIAL FALSE.
     2398   DEFINE VARIABLE v-gl-dAM-Proc-Otkl      AS DECIMAL NO-UNDO INITIAL 0.
     2399   DEFINE VARIABLE v-gl-dAM-Proc-Otkl-Ras  AS DECIMAL NO-UNDO INITIAL 0.
     2400   FUNCTION Is-Gds-In-AssMatr RETURN LOGICAL(
     2401      p-Gds-code AS INTEGER,
     2402      p-Asmt-id  AS INTEGER,
     2403      p-Db-num   AS INTEGER):
     2404      DEFINE BUFFER buf_Gds FOR Ub.Assortment-matrix-goods.
     2405      RETURN CAN-FIND(FIRST buf_Gds WHERE
     2406                            buf_Gds.Asmt-id     = p-Asmt-id
     2407                        AND buf_Gds.Db-num      = p-Db-num
     2408                        AND buf_Gds.Gds-code    = p-Gds-code
     2409                        AND buf_Gds.Asmg-status = INTEGER('0':U)
     2410                      NO-LOCK).
     2411   END FUNCTION.
     2412   PROCEDURE Get-Delta-Gds-2-Matrix:
     2413      DEFINE PARAMETER BUFFER buf_AM-1 FOR ub.Assortment-matrix.
     2414      DEFINE PARAMETER BUFFER buf_AM-2 FOR ub.Assortment-matrix.
     2415      DEFINE OUTPUT PARAMETER iDelta AS INTEGER NO-UNDO INITIAL 0.
     2416      DEFINE BUFFER buf_Gds-1 FOR ub.Assortment-matrix-goods.
     2417      DEFINE BUFFER buf_Gds-2 FOR ub.Assortment-matrix-goods.
     2418      FOR EACH buf_Gds-1 WHERE
     2419               buf_Gds-1.Asmt-id = buf_AM-1.Asmt-id
     2420           AND buf_Gds-1.Db-num  = buf_AM-1.Db-num
     2421           AND buf_Gds-1.Asmg-status = INTEGER('0':U)
     2422          NO-LOCK:
     2423          IF NOT CAN-FIND(FIRST buf_Gds-2 WHERE
     2424                                buf_Gds-2.Asmt-id     = buf_AM-2.Asmt-id
     2425                            AND buf_Gds-2.Db-num      = buf_AM-2.Db-num
     2426                            AND buf_Gds-2.Gds-code    = buf_Gds-1.Gds-code
     2427                            AND buf_Gds-2.Asmg-status = INTEGER('0':U)
     2428                            NO-LOCK) THEN DO:
     2429             ASSIGN
     2430                iDelta = iDelta + 1.
     2431          END.
     2432      END.
     2433      RETURN.
     2434   END PROCEDURE.
     2435   PROCEDURE Cntrl-AM-Add-1:
     2436      DEFINE INPUT PARAMETER iDelta  AS INTEGER   NO-UNDO.
     2437      DEFINE OUTPUT PARAMETER cError AS CHARACTER NO-UNDO INITIAL "".
     2438      IF v-gl-iProc-Otkl = 0      THEN RETURN.
     2439      IF NOT v-gl-lAM-Is-Obj      THEN RETURN.
     2440      IF NOT v-gl-lAM-Ref-Shablon THEN RETURN.
     2441      RUN Calc-Proc-Otkl IN THIS-PROCEDURE(iDelta).
     2442      IF iDelta = 0 THEN DO:
     2443         IF v-gl-dAM-Proc-Otkl >= v-gl-iProc-Otkl THEN DO:
     2444            cError = "В данной матрице процент отклонения товаров от шаблона (=" + STRING(v-gl-dAM-Proc-Otkl) + ")" + chr(10) +
     2445                     " больше допустимого (=" + STRING( v-gl-iProc-Otkl) +  ")." + chr(10) +
     2446                     "Добавление товаров невозможно !".
     2447         END.
     2448      END. ELSE DO:
     2449         IF v-gl-dAM-Proc-Otkl-Ras >= v-gl-iProc-Otkl THEN DO:
     2450            cError = "В данной матрице будущий расчетный процент отклонения товаров от шаблона (=" + STRING(v-gl-dAM-Proc-Otkl-Ras) + ")" + chr(10) +
     2451                     " больше допустимого (=" + STRING( v-gl-iProc-Otkl ) +  ")." + chr(10) +
     2452                     " Добавление товаров невозможно !".
     2453         END.
     2454      END.
     2455      RETURN.
     2456   END PROCEDURE.
     2457   PROCEDURE Get-Gl-Param-Proc-Otkl:
     2458      DEFINE INPUT PARAMETER   p-Asmt-Id AS INTEGER    NO-UNDO.
     2459      DEFINE INPUT PARAMETER   p-Db-num  AS INTEGER    NO-UNDO.
     2460      DEFINE OUTPUT PARAMETER  cError    AS CHARACTER  NO-UNDO INITIAL "".
     2461      DEFINE BUFFER buf_AM   FOR ub.Assortment-Matrix.
     2462      FIND FIRST buf_AM WHERE
     2463                 buf_AM.asmt-id = p-Asmt-id
     2464             AND buf_AM.db-num  = p-Db-num
     2465           NO-LOCK NO-ERROR.
     2466      IF NOT AVAILABLE buf_AM THEN DO:
     2467         cError = PROGRAM-NAME(1) +  ":Не найдена АМ id=" + STRING(p-Asmt-id) + " db-num=" + STRING(p-Db-num).
     2468         RETURN.
     2469      END.
     2470      RUN Get-Gl-Set-Proc-Otkl IN THIS-PROCEDURE(
     2471          buf_AM.obj-type,
     2472          buf_AM.obj-code
     2473          ).
     2474      RUN Get-Gl-Param-AM-All in THIS-PROCEDURE(
     2475          buf_AM.Asmt-id,
     2476          buf_AM.db-num
     2477          ).
     2478      RETURN.
     2479   END PROCEDURE.
     2480   PROCEDURE Get-Gl-Param-AM-All:
     2481      DEFINE INPUT PARAMETER   p-Asmt-Id AS INTEGER    NO-UNDO.
     2482      DEFINE INPUT PARAMETER   p-Db-num  AS INTEGER    NO-UNDO.
     2483      DEFINE VARIABLE lIsAmObj    AS LOGICAL    NO-UNDO INITIAL FALSE.
     2484      DEFINE VARIABLE iSh-Asmt-id AS INTEGER    NO-UNDO INITIAL 0.
     2485      DEFINE VARIABLE iSh-Db-num  AS INTEGER    NO-UNDO INITIAL 0.
     2486      DEFINE VARIABLE cSh-Type    AS CHARACTER  NO-UNDO INITIAL "".
     2487      DEFINE VARIABLE cError      AS CHARACTER  NO-UNDO INITIAL "".
     2488      DEFINE VARIABLE dAmt        AS DECIMAL    EXTENT 2  NO-UNDO INITIAL 0.
     2489      DEFINE VARIABLE cMode       AS CHARACTER  NO-UNDO INITIAL "".
     2490      ASSIGN
     2491         v-gl-iAM-Gds-All     = 0
     2492         v-gl-iAM-Sbl-Gds-All = 0
     2493         v-gl-iAM-Gds-Vyv     = 0
     2494         v-gl-dAM-Proc-Otkl   = 0
     2495         v-gl-lAM-Ref-Shablon = FALSE
     2496         .
     2497      RUN Get-Param-AM IN THIS-PROCEDURE (
     2498          p-Asmt-id,
     2499          p-Db-num,
     2500          OUTPUT lIsAmObj,
     2501          OUTPUT iSh-Asmt-id,
     2502          OUTPUT iSh-Db-num,
     2503          OUTPUT cSh-Type,
     2504          OUTPUT cError
     2505          ).
     2506      IF cError <> "" THEN DO:
     2507         MESSAGE
     2508            PROGRAM-NAME(1) ":" SKIP
     2509            "Такого быть не должно !!!" SKIP
     2510            cError SKIP
     2511            VIEW-AS ALERT-BOX INFO BUTTONS OK.
     2512         RETURN.
     2513      END.
     2514      ASSIGN
     2515         cMode                 = (IF lIsAmObj THEN "IL_GDS":U ELSE "")
     2516         v-gl-lAM-Ref-Shablon  = (IF iSh-Asmt-id = 0 THEN FALSE ELSE TRUE)
     2517         .
     2518      RUN Get-Param-AM-Gds IN THIS-PROCEDURE(
     2519          p-Asmt-Id,
     2520          p-Db-num,
     2521          '0':U,
     2522          cMode,
     2523          OUTPUT dAmt
     2524          ).
     2525      ASSIGN
     2526         v-gl-iAM-Gds-All = dAmt[1]
     2527         v-gl-iAM-Gds-Vyv = (IF lIsAmObj THEN dAmt[2] ELSE 0)
     2528         .
     2529       IF NOT v-gl-lAM-Ref-Shablon THEN DO:
     2530          RETURN.
     2531       END.
     2532      RUN Get-Param-AM-Gds IN THIS-PROCEDURE(
     2533          iSh-Asmt-id,
     2534          iSh-Db-num,
     2535          '0':U,
     2536          "",
     2537          OUTPUT dAmt
     2538          ).
     2539      ASSIGN
     2540         v-gl-iAM-Sbl-Gds-All = dAmt[1].
     2541      RUN Calc-Proc-Otkl IN THIS-PROCEDURE(0).
     2542      RETURN.
     2543   END PROCEDURE.
     2544   PROCEDURE Get-Param-AM-Gds:
     2545      DEFINE INPUT PARAMETER   p-Asmt-Id AS INTEGER    NO-UNDO.
     2546      DEFINE INPUT PARAMETER   p-Db-num  AS INTEGER    NO-UNDO.
     2547      DEFINE INPUT PARAMETER   p-Stat    AS INTEGER    NO-UNDO.
     2548      DEFINE INPUT PARAMETER   p-Mode    AS CHARACTER  NO-UNDO.
     2549      DEFINE OUTPUT PARAMETER  o-dAmt    AS DECIMAL    EXTENT 2 NO-UNDO INITIAL 0.
     2550      DEFINE BUFFER buf_AM-goods FOR ub.Assortment-matrix-goods.
     2551      FOR EACH buf_AM-goods WHERE
     2552               buf_AM-goods.Asmt-id      = p-Asmt-Id
     2553           AND buf_AM-goods.Db-num       = p-Db-num
     2554           AND buf_AM-goods.asmg-status  = p-Stat
     2555          NO-LOCK:
     2556          ASSIGN
     2557             o-dAmt[1] = o-dAmt[1] + 1.
     2558          IF CAN-DO("IL_GDS":U, p-Mode) THEN DO:
     2559             IF Indicator-life-gds-n(recid(buf_AM-goods)) = 'На вывод из ассортимента':U THEN DO:
     2560                ASSIGN
     2561                   o-dAmt[2] = o-dAmt[2] + 1.
     2562             END.
     2563          END.
     2564      END.
     2565      RETURN.
     2566   END PROCEDURE.
     2567   PROCEDURE Get-Param-AM:
     2568      DEFINE INPUT  PARAMETER  p-Asmt-id   AS INTEGER   NO-UNDO.
     2569      DEFINE INPUT  PARAMETER  p-Db-num    AS INTEGER   NO-UNDO.
     2570      DEFINE OUTPUT PARAMETER  lIsObj      AS LOGICAL   NO-UNDO INITIAL FALSE.
     2571      DEFINE OUTPUT PARAMETER  o-Asmt-id   AS INTEGER   NO-UNDO INITIAL 0.
     2572      DEFINE OUTPUT PARAMETER  o-Db-Num    AS INTEGER   NO-UNDO INITIAL 0.
     2573      DEFINE OUTPUT PARAMETER  v-Type      AS CHARACTER NO-UNDO INITIAL "".
     2574      DEFINE OUTPUT PARAMETER  cError      AS CHARACTER NO-UNDO INITIAL "".
     2575      DEFINE VARIABLE v-value AS  CHARACTER NO-UNDO INITIAL "".
     2576      DEFINE BUFFER buf_AM   FOR ub.Assortment-Matrix.
     2577      DEFINE BUFFER buf_AM-2 FOR ub.Assortment-Matrix.
     2578      ASSIGN
     2579         v-gl-lAM-Is-Obj = FALSE.
     2580      FIND FIRST buf_AM WHERE
     2581                 buf_AM.asmt-id = p-Asmt-id
     2582             AND buf_AM.db-num  = p-Db-num
     2583           NO-LOCK NO-ERROR.
     2584      IF NOT AVAILABLE buf_AM THEN DO:
     2585         cError = "Не найдена АМ id=" + STRING(p-Asmt-id) + " db-num=" + STRING(p-Db-num).
     2586         RETURN.
     2587      END.
     2588      IF buf_AM.asmt-type <> 'Объект':U THEN DO:
     2589         RETURN.
     2590      END. ELSE DO:
     2591         ASSIGN
     2592            lIsObj           = TRUE
     2593            v-gl-lAM-Is-Obj  = TRUE
     2594            .
     2595      END.
     2596      run assmatat-value (
     2597          input buf_AM.asmt-id
     2598         ,input buf_AM.db-num
     2599         ,input 'RootShablon':U
     2600         ,output v-value
     2601         ,output v-type
     2602         ) .
     2603      IF v-value = "" OR v-value = ? THEN DO:
     2604         RETURN.
     2605      END.
     2606      ASSIGN
     2607         o-Asmt-id = INTEGER(ENTRY(1, v-value, chr(4)))
     2608         o-Db-num  = INTEGER(ENTRY(2, v-value, chr(4)))
     2609         NO-ERROR.
     2610      IF ERROR-STATUS:ERROR THEN DO:
     2611         cError = PROGRAM-NAME(1) + ":" + ERROR-STATUS:GET-MESSAGE(1).
     2612         RETURN.
     2613      END.
     2614      FIND FIRST buf_AM-2 WHERE
     2615                 buf_AM-2.asmt-id = o-Asmt-id
     2616             AND buf_AM-2.db-num  = o-Db-num
     2617           NO-LOCK NO-ERROR.
     2618      IF NOT AVAILABLE buf_AM-2 THEN DO:
     2619         cError = "Не найден шаблон АМ id=" + STRING(o-Asmt-id) + " db-num=" + STRING(o-Db-num).
     2620         RETURN.
     2621      END.
     2622      RETURN.
     2623   END PROCEDURE.
     2624   PROCEDURE Get-Gl-Set-Proc-Otkl:
     2625      DEFINE INPUT PARAMETER  cObj-type AS CHARACTER NO-UNDO.
     2626      DEFINE INPUT PARAMETER  iObj-code AS INTEGER   NO-UNDO.
     2627      DEFINE VARIABLE v-Character   AS CHARACTER  NO-UNDO .
     2628      DEFINE VARIABLE v-Date        AS DATE       NO-UNDO .
     2629      DEFINE VARIABLE v-Decimal     AS DECIMAL    NO-UNDO .
     2630      DEFINE VARIABLE v-Integer     AS INTEGER    NO-UNDO .
     2631      DEFINE VARIABLE v-Logical     AS LOGICAL    NO-UNDO .
     2632      DEFINE VARIABLE v-Param-Type  AS CHARACTER  NO-UNDO .
     2633      ASSIGN
     2634         v-gl-iProc-Otkl = 0
     2635         .
     2636      EMPTY TEMP-TABLE thbjattr_thbj-attr .
     2637      RUN adm/shattri.p (
     2638              INPUT  "get":U,
     2639              INPUT  cObj-type,
     2640              INPUT  iObj-code,
     2641              INPUT  'Ass-obj':U,
     2642              INPUT  'ass-proc-matr-shabl':U ,
     2643              OUTPUT v-Character,
     2644              OUTPUT v-Date,
     2645              OUTPUT v-Decimal,
     2646              OUTPUT v-Integer,
     2647              OUTPUT v-Logical,
     2648              OUTPUT v-Param-Type,
     2649              INPUT-OUTPUT TABLE thbjattr_thbj-attr
     2650          ) NO-ERROR.
     2651      IF ERROR-STATUS:ERROR THEN DO:
     2652         ASSIGN
     2653            v-Integer  = 0
     2654            v-Decimal  = 0.
     2655      END. ELSE DO:
     2656         ASSIGN
     2657            v-gl-iProc-Otkl = v-Integer
     2658            .
     2659      END.
     2660      RETURN.
     2661   END PROCEDURE.
     2662   PROCEDURE Calc-Proc-Otkl:
     2663      DEFINE INPUT PARAMETER iDeltaGds AS INTEGER NO-UNDO.
     2664      DEFINE VARIABLE iTmp AS INTEGER NO-UNDO INITIAL 0.
     2665      ASSIGN
     2666         v-gl-dAM-Proc-Otkl     = 0
     2667         v-gl-dAM-Proc-Otkl-Ras = 0
     2668         .
     2669      IF NOT v-gl-lAM-Ref-Shablon THEN DO:
     2670         RETURN.
     2671      END.
     2672      IF v-gl-iAM-Sbl-Gds-All = 0 THEN DO:
     2673         ASSIGN
     2674            v-gl-dAM-Proc-Otkl     = 999999
     2675            v-gl-dAM-Proc-Otkl-Ras = 999999
     2676            .
     2677         RETURN.
     2678      END.
     2679      ASSIGN
     2680         iTmp = (v-gl-iAM-Gds-All - v-gl-iAM-Sbl-Gds-All)
     2681         v-gl-dAM-Proc-Otkl     = ROUND(iTmp * 100 / v-gl-iAM-Sbl-Gds-All, 2)
     2682         v-gl-dAM-Proc-Otkl-Ras = ROUND((iTmp + iDeltaGds)  * 100 / v-gl-iAM-Sbl-Gds-All, 2)
     2683         .
     2684      RETURN.
     2685   END PROCEDURE.
     2686   FUNCTION indicator-life-gds-n RETURNS CHARACTER
     2687   ( input p-rec as recid ) :
     2688   define buffer buf_matrix-goods for ub.assortment-matrix-goods .
     2689   define variable v-gdop-min-stock              as decimal   no-undo .
     2690   define variable v-grop-max-stock              as decimal   no-undo .
     2691   define variable v-grop-level-always-presence  as decimal   no-undo .
     2692   define variable v-grop-min-order              as decimal   no-undo .
     2693   define variable v-assort-min                  as LOGICAL   NO-UNDO.
     2694   DEFINE variable v-indicator-life-gds          as CHARACTER NO-UNDO.
     2695   find first buf_matrix-goods no-lock where recid (buf_matrix-goods) = p-rec no-error .
     2696   if error-status :error then return '' .
     2697   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2698   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjpr in g#library
     2699     (input  buf_Matrix-goods.obj-type
     2700     ,input  buf_Matrix-goods.obj-code
     2701     ,input  ?
     2702     ,input  ?
     2703     ,input  ?
     2704     ,input  buf_Matrix-goods.gds-code
     2705     ,output v-assort-min
     2706     ,output v-indicator-life-gds
     2707     ,output v-gdop-min-stock
     2708     ,output v-grop-max-stock
     2709     ,output v-grop-level-always-presence
     2710     ,output v-grop-min-order
     2711     )  .
     2712     return v-indicator-life-gds.
     2713   end function.
     2714   function fnc-convert-dot-to-colon returns character
     2715       (input p-data as decimal, input p-accur as character, input p-num as integer) forward.
     2716   function fnc-convert-dot-to-colon returns character
     2717   (input p-data as decimal, input p-accur as character, input p-num as integer):
     2718       define variable result as character no-undo.
     2719       define variable v-str-result as character no-undo.
     2720       if p-data = ? then p-data = 0 .
     2721       p-data = round(p-data, p-num).
     2722       v-str-result = trim(replace(string(p-data, p-accur), ".", ",")).
     2723       return v-str-result.
     2724   END FUNCTION.
