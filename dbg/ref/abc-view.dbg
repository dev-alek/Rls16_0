     3007   ON CHOOSE OF B-cancel IN FRAME Dialog-Frame
     3008   DO:
     3009   define variable cur-clmn-loc as integer   no-undo .
     3010   define variable column-handle as handle no-undo .
     3011   define variable v-list as character no-undo .
     3012     assign
     3013       cur-clmn-loc  = 1
     3014       column-handle = BROWSE-goods:first-column
     3015       v-list        = column-handle:label + "#"
     3016     .
     3017     do while valid-handle(column-handle) :
     3018       if cur-clmn-loc = BROWSE-goods:num-columns then do:
     3019         leave .
     3020       end.
     3021       assign
     3022         column-handle = column-handle:NEXT-COLUMN
     3023         cur-clmn-loc  = cur-clmn-loc + 1
     3024         v-list        = v-list + column-handle:label + "#"
     3025       .
     3026     end.
     3027      v-list = trim(v-list, "#") .
     3028      define variable v-i as integer   no-undo .
     3029      define variable v-pos as integer   no-undo .
     3030      define variable v-list-new as character no-undo .
     3031      define variable v-elem as character no-undo .
     3032      repeat v-i = 1 to BROWSE-goods:num-columns :
     3033         v-elem = entry( v-i, v-list , "#") .
     3034         v-pos = lookup( v-elem , '*! ! ' + '#' +  'Артикул! ! ' + '#' +  'Название! ! ' + '#' +  'A!B!C' + '#' +  '% по  !крите-!рию   ' + '#' +  'Сумма!для оценки!по критерию' + '#' +  'Заказанное!количество!товара' + '#' +  'Количество!по!реализации' + '#' +  'Остаток!количество!текущий' + '#' +  'Остаток!товара в!учет.ценах' + '#' +  'Сумма!реализации в!учет.ценах' + '#' +  'Сумма!реализации в!прод.ценах' + '#' +  'Сумма!реализации в!ценах докум.' + '#' +  'Темп!продаж!среднесут.' + '#' +  'ИЖТ! ! ' , "#") .
     3035         v-list-new = v-list-new + string(v-pos) + "," .
     3036      end.
     3037      define variable v-list-str as character no-undo .
     3038      v-list-str = "" .
     3039      repeat v-i = 1 to num-entries(v-list-new) :
     3040         v-elem = entry(v-i , v-list-new ) .
     3041         if int(v-elem) > 1 then
     3042         v-list-str  = v-list-str + v-elem + "," .
     3043      end.
     3044      v-list-new = trim(v-list-str ,",")  +  chr(4)
     3045                 + string(decimal( buf_goods.artic:width in browse BROWSE-goods)) +  chr(4)
     3046                 + string(decimal( buf_goods.gds-name:width     in browse BROWSE-goods)) +  chr(4)  .
     3047   run uf-set in this-procedure(
     3048       input  'abc-p':U
     3049       ,input g#userid
     3050       ,input v-list-new
     3051       ,input v-uf-Naim
     3052       ,input v-uf-print-graft
     3053       ,input v-uf-sort-gr
     3054       ,input v-uf-type-price
     3055       ,input v-uf-type-val
     3056   ) no-error    .
     3057       if error-status :error then
     3058       message
     3059         vss-workfile vss-revision vss-description skip
     3060         error-status :get-message(1) skip
     3061         return-value skip
     3062         "uf-set"
     3063         view-as alert-box error
     3064       .
     3065   END.
