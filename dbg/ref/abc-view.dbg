     3181   .
     3182   if v-num-entry27 > 0 then do:
     3183     assign
     3184       entry( v-num-entry27, rid-list ) = "":U
     3185       rid-list = trim( replace( rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     3186     .
     3187   end.
     3188   else do:
     3189     assign
     3190       rid-list = rid-list + ( if rid-list = "":U then "":U else chr(44) ) + v-str-recid27
     3191     .
     3192   end.
     3193           g-log = browse-goods:refresh() .
