     2178   procedure correct-message :
     2179   define input  parameter p-longchar as longchar no-undo .
     2180   define variable v-longchar as longchar no-undo .
     2181   define variable v-err-ext  as logical  no-undo .
     2182     do
     2183     on error undo, return error return-value
     2184     :
     2185      run get-long-message in this-procedure  (output v-longchar ).
     2186       v-longchar = v-longchar + p-longchar.
     2187       v-err-ext  = true .
     2188       run set-long-message  in this-procedure  (input v-longchar,  input v-err-ext ).
     2189     end.
     2190   end procedure.
     2191   define variable v-longchar as longchar no-undo .
     2192   define variable v-err-ext as logical   no-undo .
