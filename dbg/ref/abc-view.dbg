     1840   procedure uf-get :
     1841     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
     1842     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
     1843     define output parameter p-List_        like ubflt.usr-flt.List_        no-undo .
     1844     define output parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
     1845     define output parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
     1846     define output parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
     1847     define output parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
     1848     define output parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
     1849     do
     1850     on error undo, return error
     1851     :
     1852       define buffer buf_usr-flt for ubflt.usr-flt .
     1853       define variable v-use-List_     as logical   no-undo .
     1854       define variable v-type-List_     as character no-undo .
     1855       define variable v-format-List_   as character no-undo .
     1856       define variable v-use-Naim      as logical   no-undo .
     1857       define variable v-type-Naim      as character no-undo .
     1858       define variable v-format-Naim    as character no-undo .
     1859       define variable v-use-print-graft as logical   no-undo .
     1860       define variable v-use-sort-gr     as logical   no-undo .
     1861       define variable v-use-type-price  as logical   no-undo .
     1862       define variable v-use-type-val    as logical   no-undo .
     1863       define variable v-label          as character no-undo .
     1864       define variable v-tooltip        as character no-undo .
     1865       define variable v-user-can-edit  as logical   no-undo .
     1866       define variable v-output-display as logical   no-undo .
     1867       define variable v-other          as character no-undo .
     1868       run uf-name in this-procedure
     1869          (input  entry(1, p-code, chr(4))
     1870         ,output v-use-List_
     1871         ,output v-type-List_
     1872         ,output v-format-List_
     1873         ,output v-use-Naim
     1874         ,output v-type-Naim
     1875         ,output v-format-Naim
     1876         ,output v-use-print-graft
     1877         ,output v-use-sort-gr
     1878         ,output v-use-type-price
     1879         ,output v-use-type-val
     1880         ,output v-label
     1881         ,output v-tooltip
     1882         ,output v-user-can-edit
     1883         ,output v-output-display
     1884         ,output v-other
     1885         ) no-error .
     1886       if error-status :error then do:
     1887         undo, return error return-value .
     1888       end.
     1889       find first buf_usr-flt no-lock where
     1890                  buf_usr-flt.Call-point     = p-code AND
     1891                  buf_usr-flt.user-name       = p-user-name
     1892         no-error .
     1893       if avail buf_usr-flt then do:
     1894         assign
     1895         p-List_        = (if v-use-List_       then buf_usr-flt.List_       else ?)
     1896         p-Naim         = (if v-use-Naim        then buf_usr-flt.Naim        else ?)
     1897         p-print-graft  = (if v-use-print-graft then buf_usr-flt.print-graft else ?)
     1898         p-sort-gr      = (if v-use-sort-gr     then buf_usr-flt.sort-gr     else ?)
     1899         p-type-price   = (if v-use-type-price  then buf_usr-flt.type-price  else ?)
     1900         p-type-val     = (if v-use-List_       then buf_usr-flt.type-val    else ?)
     1901         .
     1902       end.
     1903       else do:
     1904         assign
     1905         p-List_        = (if v-use-List_       then "":U                    else ?)
     1906         p-Naim         = (if v-use-Naim        then "":U                    else ?)
     1907         p-print-graft  = (if v-use-print-graft then no                      else ?)
     1908         p-sort-gr      = (if v-use-sort-gr     then no                      else ?)
     1909         p-type-price   = (if v-use-type-price  then no                      else ?)
     1910         p-type-val     = (if v-use-List_       then no                      else ?)
     1911         .
     1912       end.
     1913     end.
     1914   end procedure.
     1915   procedure uf-set :
     1916     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
     1917     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
     1918     define input  parameter p-List_        like ubflt.usr-flt.List_        no-undo .
     1919     define input  parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
     1920     define input  parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
     1921     define input  parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
     1922     define input  parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
     1923     define input  parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
     1924     do
     1925     on error undo, return error
     1926     :
     1927       define buffer buf_usr-flt for ubflt.usr-flt .
     1928       define variable v-use-List_     as logical   no-undo .
     1929       define variable v-type-List_     as character no-undo .
     1930       define variable v-format-List_   as character no-undo .
     1931       define variable v-use-Naim      as logical   no-undo .
     1932       define variable v-type-Naim      as character no-undo .
     1933       define variable v-format-Naim    as character no-undo .
     1934       define variable v-use-print-graft as logical   no-undo .
     1935       define variable v-use-sort-gr   as logical   no-undo .
     1936       define variable v-use-type-price as logical   no-undo .
     1937       define variable v-use-type-val  as logical   no-undo .
     1938       define variable v-tooltip        as character no-undo .
     1939       define variable v-label          as character no-undo .
     1940       define variable v-user-can-edit  as logical   no-undo .
     1941       define variable v-output-display as logical   no-undo .
     1942       define variable v-other          as character no-undo .
     1943       run uf-name in this-procedure
     1944         (input  entry(1, p-code, chr(4))
     1945         ,output v-use-List_
     1946         ,output v-type-List_
     1947         ,output v-format-List_
     1948         ,output v-use-Naim
     1949         ,output v-type-Naim
     1950         ,output v-format-Naim
     1951         ,output v-use-print-graft
     1952         ,output v-use-sort-gr
     1953         ,output v-use-type-price
     1954         ,output v-use-type-val
     1955         ,output v-label
     1956         ,output v-tooltip
     1957         ,output v-user-can-edit
     1958         ,output v-output-display
     1959         ,output v-other
     1960         ) no-error .
     1961       if error-status :error then do:
     1962         undo, return error return-value .
     1963       end.
     1964       find first buf_usr-flt where
     1965                  buf_usr-flt.Call-point     = p-code AND
     1966                  buf_usr-flt.user-name       = p-user-name
     1967         no-error .
     1968       if not avail buf_usr-flt then do:
     1969           create buf_usr-flt .
     1970           assign
     1971           buf_usr-flt.call-point = p-code
     1972           buf_usr-flt.user-name  = p-user-name
     1973           .
     1974       end.
     1975       if avail buf_usr-flt then do:
     1976        assign
     1977        buf_usr-flt.List_       =  (if v-use-List_       then  p-List_        else ?)
     1978        buf_usr-flt.Naim        =  (if v-use-Naim        then  p-Naim         else ?)
     1979        buf_usr-flt.print-graft =  (if v-use-print-graft then  p-print-graft  else ?)
     1980        buf_usr-flt.sort-gr     =  (if v-use-sort-gr     then  p-sort-gr      else ?)
     1981        buf_usr-flt.type-price  =  (if v-use-type-price  then  p-type-price   else ?)
     1982        buf_usr-flt.type-val    =  (if v-use-List_       then  p-type-val     else ?)
     1983       .
     1984       release buf_usr-flt.
     1985       end.
     1986       else undo, return error ("Ошибка при записи usr-flt" + substitute(" call-point=&1, user-name=&2", p-code, p-user-name)).
     1987     end.
     1988   end procedure.
     1989   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1990     define variable v-cntxt-db-num        as integer   no-undo .
     1991     define variable v-cntxt-userid        as character no-undo .
     1992     define variable v-cntxt-level         as character no-undo .
     1993     define variable v-cntxt-host-code-obj as integer   no-undo .
     1994     define variable v-cntxt-obj-type      as character no-undo .
     1995     define variable v-cntxt-obj-code      as integer   no-undo .
     1996     define variable v-cntxt-db-num-obj    as integer   no-undo .
     1997     define variable v-cntxt-is-admin      as logical   no-undo .
     1998   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1999     run mainmenu_getcntxt in parparentproc
     2000       (output v-cntxt-db-num
     2001       ,output v-cntxt-userid
     2002       ,output v-cntxt-level
     2003       ,output v-cntxt-host-code-obj
     2004       ,output v-cntxt-obj-type
     2005       ,output v-cntxt-obj-code
     2006       ,output v-cntxt-db-num-obj
     2007       ,output v-cntxt-is-admin
     2008       ) .
     2009   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2010   define variable v-fltopend-rowid as rowid extent 18 no-undo .
     2011   procedure fltopend_fltopend :
     2012   define input parameter p-parent-handle as handle no-undo .
     2013   define input parameter p-qh as handle no-undo .
     2014   define input parameter p-flt-open-open-query  as character no-undo .
     2015   define input parameter p-where-cond as character no-undo .
     2016   define input parameter p-use-indFIRST-query-tail as character no-undo .
     2017   define input parameter p-use-ind-sort-clmn-by as character no-undo .
     2018   define input parameter p-indexed-reposition as character no-undo .
     2019     do
     2020     on error undo, return error
     2021     :
     2022   define variable v-prepare-string as character no-undo .
     2023   define variable glog as logical no-undo .
     2024   assign
     2025   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     2026                      p-where-cond + chr(32)  +
     2027                      p-use-indFIRST-query-tail + chr(32) +
     2028                      p-use-ind-sort-clmn-by + chr(32) +
     2029                      p-indexed-reposition
     2030   .
     2031   assign
     2032   glog = p-qh:query-prepare(v-prepare-string) no-error .
     2033   if not glog
     2034   or error-status:error then do:
     2035     message error-status:get-message(1) view-as alert-box .
     2036     undo, return error .
     2037   end.
     2038   assign
     2039   glog = p-qh:query-open no-error .
     2040   if not glog
     2041   or error-status:error then do:
     2042     message error-status:get-message(1) view-as alert-box .
     2043     undo, return error .
     2044   end.
     2045     end.
     2046   end procedure.
     2047   procedure fltopend_fltfindd :
     2048   define input parameter p-parent-handle as handle no-undo .
     2049   define input parameter p-qh as handle no-undo .
     2050   define input parameter p-rowid as rowid no-undo .
     2051   define input parameter p-next as logical no-undo .
     2052   define input parameter p-lock as integer no-undo .
     2053   define input parameter p-bh as handle no-undo .
     2054   define input parameter p-where-cond as character no-undo .
     2055   define input parameter p-use-index-phrase as character no-undo .
     2056   define variable glog as logical no-undo .
     2057   define variable v-qh as handle no-undo .
     2058   define variable v-bh as handle no-undo .
     2059   define variable v-recid as recid no-undo .
     2060   define variable v-prepare-string as character no-undo .
     2061   do
     2062   on error undo, return error
     2063   on stop undo, return error
     2064   :
     2065     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
     2066     create buffer v-bh for table p-bh buffer-name p-bh:name.
     2067     create query v-qh.
     2068     v-qh:set-buffers(v-bh).
     2069     v-prepare-string = substitute("for each &1 &2 &3"
     2070                                     ,v-bh:name
     2071                                     ,p-where-cond
     2072                                     ,p-use-index-phrase).
     2073     glog = v-qh:query-prepare(v-prepare-string) no-error.
     2074     if not glog then do:
     2075       delete object v-qh.
     2076       delete object v-bh.
     2077       undo, return error .
     2078     end.
     2079     glog = v-qh:query-open no-error .
     2080     if not glog then do:
     2081       delete object v-qh.
     2082       delete object v-bh.
     2083       undo, return error .
     2084     end.
     2085     if p-next then do:
     2086       v-qh:reposition-to-rowid(p-rowid) no-error .
     2087       glog = v-qh:get-next( p-lock) no-error .
     2088       glog = v-qh:get-next( p-lock) no-error .
     2089       if not glog or v-qh:query-off-end = yes then do:
     2090         glog = v-qh:get-first( p-lock) no-error .
     2091       end.
     2092     end.
     2093     else do:
     2094       glog = v-qh:get-first( p-lock) no-error .
     2095     end.
     2096     v-recid = v-bh:recid no-error .
     2097     delete object v-qh.
     2098     delete object v-bh.
     2099     return string(v-recid) .
     2100   end.
     2101   end procedure.
     2102   procedure fltopend_fltfindq :
     2103   define input parameter p-parent-handle as handle no-undo .
     2104   define input parameter p-qh as handle no-undo .
     2105   define input parameter p-next as logical no-undo .
     2106   define input parameter p-lock as integer no-undo .
     2107   define input parameter p-flt-open-open-query  as character no-undo .
     2108   define input parameter p-where-cond as character no-undo .
     2109   define input parameter p-use-indFIRST-query-tail as character no-undo .
     2110   define input parameter p-use-ind-sort-clmn-by as character no-undo .
     2111   define input parameter p-indexed-reposition as character no-undo .
     2112   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
     2113   define variable glog as logical no-undo .
     2114   define variable v-qh as handle no-undo .
     2115   define variable v-bh as handle no-undo extent 18.
     2116   define variable v-rowid as rowid no-undo extent 18.
     2117   define variable v-ii as integer no-undo .
     2118   define variable v-prepare-string as character no-undo .
     2119   do
     2120   on error undo, return error
     2121   on stop undo, return error
     2122   :
     2123     create query v-qh.
     2124     do v-ii = 1 to p-qh:num-buffers:
     2125       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
     2126       assign
     2127       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
     2128       no-error.
     2129       v-qh:add-buffer(v-bh[v-ii]).
     2130     end.
     2131     assign
     2132     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     2133                       p-where-cond + chr(32)  +
     2134                       p-use-indFIRST-query-tail + chr(32) +
     2135                       p-use-ind-sort-clmn-by + chr(32) +
     2136                       p-indexed-reposition
     2137     .
     2138     glog = v-qh:query-prepare( v-prepare-string) no-error .
     2139     if not glog then do:
     2140       delete object v-qh.
     2141       do v-ii = 1 to p-qh:num-buffers:
     2142         delete object v-bh[v-ii].
     2143       end.
     2144       undo, return error .
     2145     end.
     2146     glog = v-qh:query-open no-error .
     2147     if not glog then do:
     2148       delete object v-qh.
     2149       do v-ii = 1 to p-qh:num-buffers:
     2150         delete object v-bh[v-ii].
     2151       end.
     2152       undo, return error .
     2153     end.
     2154     if p-next then do:
     2155       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
     2156       glog = v-qh:get-next( p-lock) no-error .
     2157       glog = v-qh:get-next( p-lock) no-error .
     2158       if not glog or v-qh:query-off-end = yes then do:
     2159         glog = v-qh:get-first( p-lock) no-error .
     2160       end.
     2161     end.
     2162     else do:
     2163       glog = v-qh:get-first( p-lock) no-error .
     2164     end.
     2165     do v-ii = 1 to p-qh:num-buffers:
     2166       assign
     2167       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
     2168       no-error.
     2169     end.
     2170     delete object v-qh.
     2171     do v-ii = 1 to p-qh:num-buffers:
     2172       delete object v-bh[v-ii].
     2173     end.
     2174   end.
     2175   end procedure.
