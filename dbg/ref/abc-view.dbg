     3305            buf_goods.artic:fgcolor  in browse browse-goods  = 5
     3306            buf_goods.gds-name:fgcolor  in browse browse-goods  = 5
     3307            buf_abc-analysis-goods.abcg-abc:fgcolor  in browse browse-goods  = 5
     3308            buf_abc-analysis-goods.abcg-prcnt-for-estimate:fgcolor  in browse browse-goods  = 5
     3309            buf_abc-analysis-goods.abcg-prcnt-account:fgcolor in browse browse-goods  = 5
     3310          .
     3311       if buf_abc-analysis-goods.abcg-abc = "F" then
     3312          assign
     3313            buf_goods.artic:fgcolor  in browse browse-goods  = 7
     3314            buf_goods.gds-name:fgcolor  in browse browse-goods  = 7
     3315            buf_abc-analysis-goods.abcg-abc:fgcolor  in browse browse-goods  = 7
     3316            buf_abc-analysis-goods.abcg-prcnt-for-estimate:fgcolor  in browse browse-goods  = 7
     3317            buf_abc-analysis-goods.abcg-prcnt-account:fgcolor in browse browse-goods  = 7
     3318          .
     3319     END.
     3320   END.
     3321   ON VALUE-CHANGED OF BROWSE-goods IN FRAME Dialog-Frame
     3322   DO:
     3323     if available  buf_abc-analysis-goods then do:
     3324        OPEN QUERY BROWSE-obj       FOR EACH Buf_abc-analysis-obj WHERE                Buf_abc-analysis-obj.abc-id = v-id AND                Buf_abc-analysis-obj.db-num = v-db-num                NO-LOCK,                  EACH buf_abc-analysis-gds-obj WHERE                buf_abc-analysis-gds-obj.obj-type = Buf_abc-analysis-obj.obj-type AND                buf_abc-analysis-gds-obj.obj-code = Buf_abc-analysis-obj.obj-code AND                buf_abc-analysis-gds-obj.gds-code = Buf_abc-analysis-goods.gds-code AND                buf_abc-analysis-gds-obj.abc-id   = v-id AND                buf_abc-analysis-gds-obj.db-num   = v-db-num                OUTER-JOIN NO-LOCK,                  EACH Buf_gds-obj-prop WHERE                Buf_gds-obj-prop.obj-type =  Buf_abc-analysis-obj.obj-type AND                Buf_gds-obj-prop.obj-code =  Buf_abc-analysis-obj.obj-code AND                Buf_gds-obj-prop.gds-code =  Buf_abc-analysis-goods.gds-code                OUTER-JOIN NO-LOCK,                 first buf_assortment-matrix WHERE                buf_assortment-matrix.asmt-status        = 0  AND                buf_assortment-matrix.obj-type =  Buf_abc-analysis-obj.obj-type AND                buf_assortment-matrix.obj-code =  Buf_abc-analysis-obj.obj-code                OUTER-JOIN NO-LOCK,                 FIRST buf_assortment-matrix-goods WHERE                buf_assortment-matrix-goods.asmg-status        = 0  AND                buf_assortment-matrix-goods.asmt-id  =  buf_assortment-matrix.asmt-id AND                buf_assortment-matrix-goods.db-num   =  buf_assortment-matrix.db-num  AND                buf_assortment-matrix-goods.gds-code =  buf_abc-analysis-goods.gds-code                OUTER-JOIN NO-LOCK INDEXED-REPOSITION.
     3325     end.
     3326   END.
     3327   ON ROW-DISPLAY OF BROWSE-obj IN FRAME Dialog-Frame
     3328   DO:
     3329    RUN DISP-OBJ.
     3330   END.
     3331   ON CHOOSE OF MENU-ITEM m_goods
     3332   DO:
     3333     run print-proc in this-procedure ( NO ).
     3334   END.
     3335   ON CHOOSE OF MENU-ITEM m_obj
     3336   DO:
     3337     run print-proc in this-procedure ( true  ).
     3338   END.
     3339   on leave of Buf_abc-analysis-goods.abcg-abc in browse browse-goods DO:
     3340   run chg-abc in this-procedure  no-error .
     3341   if error-status :error then return no-apply.
     3342   END.
     3343   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     3344   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     3345   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3346   on help of frame Dialog-Frame
     3347   do:
     3348     run gbl/app_help.p
     3349       (input this-procedure :file-name
     3350       ,input ''
     3351       ,input ?
     3352       ) no-error.
     3353     if error-status :error then do:
     3354       message
     3355         "Ошибка при вызове помощи"
     3356         error-status :get-message(1)
     3357         view-as alert-box .
     3358     end.
     3359   end.
     3360   run minbtn-set in this-procedure .
     3361   on choose of b-help in frame Dialog-Frame
     3362   do:
     3363     apply "help":u to frame Dialog-Frame .
     3364   end.
     3365   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3366   procedure minbtn-set :
     3367       do
     3368           on error undo, return error return-value
     3369           :
     3370           define variable ii              as integer       no-undo .
     3371           define variable fh              as widget-handle no-undo .
     3372           define variable hh              as widget-handle no-undo .
     3373           define variable v-h             as handle        extent 4 no-undo .
     3374           define variable v-name-button   as character     no-undo .
     3375           define variable v-help-old-x    as decimal       no-undo .
     3376           define variable v-help-old-y    as decimal       no-undo .
     3377           define variable v-help-old-size as decimal       no-undo .
     3378           define variable v-frame-width   as decimal       no-undo .
     3379           define variable jj              as integer       no-undo .
     3380           do
     3381               on error undo, return error
     3382               :
     3383               assign
     3384                   v-frame-width = frame Dialog-Frame:width - 0.3
     3385                   fh            = frame Dialog-Frame:first-child
     3386                   hh            = fh:first-child
     3387                   ii            = 1
     3388                   .
     3389               do while valid-handle(hh):
     3390                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     3391                   do:
     3392                       case lc(hh:name) :
     3393                           when "b-help" then
     3394                               do:
     3395                                   hh:load-image-up("cmp/b-help.bmp":u) .
     3396                                   hh:load-image-down("cmp/b-help.bmp":u) .
     3397                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     3398                                   hh:TOOLTIP = "Помощь" .
     3399                                   v-help-old-x = hh:column .
     3400                                   v-help-old-y = hh:row    .
     3401                                   v-help-old-size = hh:width .
     3402                                   hh:width-chars = 2.5 .
     3403                               end.
     3404                           when "b-print" then
     3405                               do:
     3406                                   hh:load-image("cmp/b-print.bmp":u) .
     3407                                   hh:TOOLTIP = "Печать" .
     3408                                   v-h[ii] = hh:handle .
     3409                                   ii = ii + 1 .
     3410                                   hh:width-chars = 3 .
     3411                               end.
     3412                           when "b-history" or
     3413                           when "b-hist" then
     3414                               do:
     3415                                   hh:load-image("cmp/b-hist.bmp":u) .
     3416                                   hh:TOOLTIP = "История" .
     3417                                   v-h[ii] = hh:handle .
     3418                                   ii = ii + 1 .
     3419                                   hh:width-chars = 3 .
     3420                               end.
     3421                           when "b-sch" then
     3422                               do:
     3423                                   hh:load-image("cmp/b-sch.bmp":u) .
     3424                                   hh:TOOLTIP = "Установка Фильтра" .
     3425                                   v-h[ii] = hh:handle .
     3426                                   ii = ii + 1 .
     3427                                   hh:width-chars = 3 .
     3428                               end.
     3429                           when "b-hist-user" then
     3430                               do:
     3431                                   hh:load-image("cmp/b-hist.bmp":u) .
     3432                                   hh:TOOLTIP = "История пользователя" .
     3433                                   ii = ii + 1 .
     3434                               end.
     3435                       end case.
     3436                   end.
     3437                   hh = hh:next-sibling.
     3438               end.
     3439               b-help:column = v-frame-width - b-help:width-chars.
     3440               jj = 0.
     3441               repeat ii = 4 to 1 by -1 :
     3442                   if valid-handle (v-h[ii] ) then
     3443                   do:
     3444                       jj  = jj + 1 .
     3445                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     3446                       v-h[ii]:row    = v-help-old-y .
     3447                   end.
     3448               end.
     3449           end.
     3450       end.
     3451   end procedure.
     3452   define variable vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     3453   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     3454   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     3455   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     3456   define variable v-diasize-current-frame-width  as decimal   no-undo .
     3457   define variable v-diasize-current-frame-height as decimal   no-undo .
     3458   define variable v-diasize-change-size          as logical   no-undo .
     3459   define variable v-diasize-resize-button        as handle    no-undo .
     3460   define variable v-diasize-wndmax               as logical   no-undo .
     3461   define variable v-diasize-wndstore             as logical   no-undo .
     3462   define variable v-diasize-proc-name            as character no-undo .
     3463   define variable v-diasize-browse-handle        as handle    no-undo .
     3464   define variable v-diasize-browse-number        as integer   no-undo .
     3465   define variable v-diasize-need-full-display    as logical   no-undo init false .
     3466   define temp-table temp-diasize-handle no-undo
     3467     field handle-value  as handle
     3468     field save-position as decimal
     3469     index xpk is primary unique handle-value
     3470     .
     3471   define temp-table temp-browse-handle no-undo
     3472     field browse-type   as character
     3473     field browse-number as integer
     3474     field browse-handle as handle
     3475     field original-size as decimal
     3476     index xpk is primary unique browse-type browse-number
     3477     index xie browse-type browse-handle
     3478   .
     3479   procedure diasize_change-height :
     3480     define input  parameter p-change-value  as decimal   no-undo .
     3481     define input  parameter p-move-resize   as logical   no-undo .
     3482     define variable v-field-group-handle    as handle    no-undo .
     3483     define variable v-object-handle         as handle    no-undo .
     3484     define variable v-frame-height          as decimal   no-undo .
     3485     define variable v-frame-virtual-height  as decimal   no-undo .
     3486     define variable v-browse-height         as decimal   no-undo .
     3487     define variable v-window-height         as decimal   no-undo .
     3488     define variable v-window-virtual-height as decimal   no-undo .
     3489     define variable v-change-sign           as integer   no-undo .
     3490     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     3491     define buffer buf_temp-browse-handle  for temp-browse-handle .
     3492     if p-change-value > 0
     3493     then do:
     3494       if frame Dialog-Frame :height + p-change-value
     3495           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     3496       then do:
     3497         assign
     3498           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     3499                           - (frame Dialog-Frame :height-chars)
     3500         .
     3501         if p-change-value <= 0
     3502         then do:
     3503           run diasize_position-resize-button in this-procedure .
     3504           return .
     3505         end.
     3506       end.
     3507     end.
     3508     if p-change-value < 0
     3509     then do:
     3510       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     3511       then do:
     3512         assign
     3513           p-change-value = v-diasize-orig-frame-height
     3514                          - (frame Dialog-Frame :height-chars)
     3515         .
     3516         if p-change-value >= 0
     3517         then do:
     3518           run diasize_position-resize-button in this-procedure .
     3519           return .
     3520         end.
     3521       end.
     3522     end.
     3523     if p-change-value >= 0
     3524     then do:
     3525       assign
     3526         v-change-sign = 1
     3527       .
     3528     end.
     3529     else do:
     3530       assign
     3531         v-change-sign = -1
     3532       .
     3533     end.
     3534     assign
     3535       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     3536     .
     3537     if p-change-value = 0
     3538     then do:
     3539       run diasize_position-resize-button in this-procedure .
     3540       return .
     3541     end.
     3542     move_block:
     3543     do
     3544     on error undo move_block, retry move_block
     3545     :
     3546       if retry
     3547       then do:
     3548         do
     3549         on error undo move_block, leave move_block
     3550         :
     3551           if p-change-value > 0
     3552           then do:
     3553             for each buf_temp-diasize-handle
     3554             on error undo, next
     3555             :
     3556               assign
     3557                 v-object-handle = buf_temp-diasize-handle.handle-value
     3558               .
     3559               if v-object-handle <> v-diasize-resize-button
     3560               then do:
     3561                 assign
     3562                   v-object-handle :row = buf_temp-diasize-handle.save-position
     3563                 .
     3564               end.
     3565             end.
     3566             assign
     3567               v-diasize-browse-handle :height = v-browse-height
     3568             .
     3569             for each buf_temp-browse-handle
     3570               where buf_temp-browse-handle.browse-type = 'height':u
     3571             on error undo, next
     3572             :
     3573               assign
     3574                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     3575               .
     3576             end.
     3577             assign
     3578               frame Dialog-Frame :height = v-frame-height
     3579             .
     3580             if frame Dialog-Frame :scrollable = true
     3581             then do:
     3582               assign
     3583                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     3584               .
     3585             end.
     3586             run diasize_position-resize-button in this-procedure .
     3587           end.
     3588           else do:
     3589             if frame Dialog-Frame :scrollable = true
     3590             then do:
     3591               assign
     3592                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     3593               .
     3594             end.
     3595             assign
     3596               frame Dialog-Frame :height = v-frame-height
     3597             .
     3598             assign
     3599               v-diasize-browse-handle :height = v-browse-height
     3600             .
     3601             for each buf_temp-browse-handle
     3602               where buf_temp-browse-handle.browse-type = 'height':u
     3603             on error undo, next
     3604             :
     3605               assign
     3606                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     3607               .
     3608             end.
     3609             for each buf_temp-diasize-handle
     3610             on error undo, next
     3611             :
     3612               assign
     3613                 v-object-handle = buf_temp-diasize-handle.handle-value
     3614               .
     3615               if v-object-handle <> v-diasize-resize-button
     3616               then do:
     3617                 assign
     3618                   v-object-handle :row = buf_temp-diasize-handle.save-position
     3619                 .
     3620               end.
     3621             end.
     3622             run diasize_position-resize-button in this-procedure .
     3623           end.
     3624           assign
     3625             v-diasize-change-size = false
     3626           .
     3627           leave move_block .
     3628         end.
     3629       end.
     3630       assign
     3631         v-diasize-need-full-display = true
     3632       .
     3633       if v-diasize-change-size = false
     3634       then do:
     3635         assign
     3636           v-diasize-change-size = true
     3637         .
     3638       end.
     3639       else do:
     3640         return .
     3641       end.
     3642       assign
     3643         v-frame-height = frame Dialog-Frame :height
     3644         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     3645         v-browse-height = v-diasize-browse-handle :height
     3646       .
     3647       for each buf_temp-browse-handle
     3648         where buf_temp-browse-handle.browse-type = 'height':u
     3649       :
     3650         assign
     3651           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     3652         .
     3653       end.
     3654       for each buf_temp-diasize-handle
     3655       :
     3656         delete buf_temp-diasize-handle .
     3657       end.
     3658       assign
     3659         v-field-group-handle = frame Dialog-Frame :first-child
     3660       .
     3661       do while valid-handle(v-field-group-handle)
     3662       :
     3663         assign
     3664           v-object-handle = v-field-group-handle :first-child
     3665         .
     3666         do while valid-handle(v-object-handle)
     3667         :
     3668           if  v-object-handle <> v-diasize-browse-handle :handle
     3669           and can-query(v-object-handle, "row")
     3670           and can-query(v-object-handle, "height")
     3671           and ( v-object-handle :row > v-diasize-browse-handle :row )
     3672           then do:
     3673             find first buf_temp-browse-handle
     3674               where buf_temp-browse-handle.browse-type   = 'height':u
     3675                 and buf_temp-browse-handle.browse-handle = v-object-handle
     3676               no-error .
     3677             if available buf_temp-browse-handle
     3678             then do:
     3679             end.
     3680             else do:
     3681               create buf_temp-diasize-handle .
     3682               assign
     3683                 buf_temp-diasize-handle.handle-value  = v-object-handle
     3684                 buf_temp-diasize-handle.save-position = v-object-handle :row
     3685               .
     3686             end.
     3687           end.
     3688           assign
     3689             v-object-handle = v-object-handle :next-sibling
     3690           .
     3691         end.
     3692         assign
     3693           v-field-group-handle = v-field-group-handle :next-sibling
     3694         .
     3695       end.
     3696       do with frame Dialog-Frame
     3697       :
     3698         hide v-diasize-resize-button .
     3699         assign
     3700           v-diasize-resize-button :row    = 1
     3701           v-diasize-resize-button :column = 1
     3702         .
     3703       end.
     3704       if p-change-value > 0
     3705       then do:
     3706         if frame Dialog-Frame :scrollable = true
     3707         then do:
     3708           assign
     3709             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     3710             no-error .
     3711           if error-status :error
     3712           or error-status :get-message(1) <> ""
     3713           then do:
     3714             undo move_block, retry move_block .
     3715           end.
     3716         end.
     3717         assign
     3718           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     3719           no-error .
     3720         if error-status :error
     3721         or error-status :get-message(1) <> ""
     3722         then do:
     3723           undo move_block, retry move_block .
     3724         end.
     3725         assign
     3726           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     3727           no-error .
     3728         if error-status :error
     3729         or error-status :get-message(1) <> ""
     3730         then do:
     3731           undo move_block, retry move_block .
     3732         end.
     3733         for each buf_temp-browse-handle
     3734           where buf_temp-browse-handle.browse-type = 'height':u
     3735         on error undo move_block, retry move_block
     3736         :
     3737           assign
     3738             buf_temp-browse-handle.browse-handle :height
     3739               = buf_temp-browse-handle.browse-handle :height + p-change-value
     3740             no-error .
     3741           if error-status :error
     3742           or error-status :get-message(1) <> ""
     3743           then do:
     3744             undo move_block, retry move_block .
     3745           end.
     3746         end.
     3747         for each buf_temp-diasize-handle
     3748         on error undo move_block, retry move_block
     3749         :
     3750           assign
     3751             v-object-handle = buf_temp-diasize-handle.handle-value
     3752           .
     3753           if v-object-handle <> v-diasize-resize-button
     3754           then do:
     3755             assign
     3756               v-object-handle :row = v-object-handle :row + p-change-value
     3757               no-error .
     3758             if error-status :error
     3759             or error-status :get-message(1) <> ""
     3760             then do:
     3761               undo move_block, retry move_block .
     3762             end.
     3763           end.
     3764         end.
     3765       end.
     3766       else do:
     3767         for each buf_temp-diasize-handle
     3768         on error undo move_block, retry move_block
     3769         :
     3770           assign
     3771             v-object-handle = buf_temp-diasize-handle.handle-value
     3772           .
     3773           if v-object-handle <> v-diasize-resize-button
     3774           then do:
     3775             assign
     3776               v-object-handle :row = v-object-handle :row + p-change-value
     3777               no-error .
     3778             if error-status :error
     3779             or error-status :get-message(1) <> ""
     3780             then do:
     3781               undo move_block, retry move_block .
     3782             end.
     3783           end.
     3784         end.
     3785         assign
     3786           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     3787           no-error .
     3788         if error-status :error
     3789         or error-status :get-message(1) <> ""
     3790         then do:
     3791           undo move_block, retry move_block .
     3792         end.
     3793         for each buf_temp-browse-handle
     3794           where buf_temp-browse-handle.browse-type = 'height':u
     3795         on error undo move_block, retry move_block
     3796         :
     3797           assign
     3798             buf_temp-browse-handle.browse-handle :height
     3799               = buf_temp-browse-handle.browse-handle :height + p-change-value
     3800             no-error .
     3801           if error-status :error
     3802           or error-status :get-message(1) <> ""
     3803           then do:
     3804             undo move_block, retry move_block .
     3805           end.
     3806         end.
     3807         assign
     3808           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     3809           no-error .
     3810         if error-status :error
     3811         or error-status :get-message(1) <> ""
     3812         then do:
     3813           undo move_block, retry move_block .
     3814         end.
     3815         if frame Dialog-Frame :scrollable = true
     3816         then do:
     3817           assign
     3818             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     3819             no-error .
     3820           if error-status :error
     3821           or error-status :get-message(1) <> ""
     3822           then do:
     3823             undo move_block, retry move_block .
     3824           end.
     3825         end.
     3826       end.
     3827       if p-move-resize = true
     3828       then do:
     3829         run diasize_position-resize-button in this-procedure .
     3830       end.
     3831       if v-diasize-wndstore = true
     3832       then do:
     3833         if connected("ub") = true
     3834         then do:
     3835           define variable v-cntxt-db-num        as integer   no-undo .
     3836           define variable v-cntxt-userid        as character no-undo .
     3837           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3838                                             , OUTPUT v-cntxt-userid
     3839                                             ) .
     3840           run gbl/wndsizew.p
     3841             (input  v-cntxt-db-num
     3842             ,input  v-cntxt-userid
     3843             ,input  v-diasize-proc-name
     3844             ,input  'height':u
     3845             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     3846             ) .
     3847         end.
     3848       end.
     3849     end.
     3850     assign
     3851       v-diasize-change-size = false
     3852     .
     3853   end procedure.
     3854   procedure diasize_set-height :
     3855     define input  parameter p-new-height  as decimal   no-undo .
     3856     define input  parameter p-move-resize as logical   no-undo .
     3857     do
     3858     on error undo, return error return-value
     3859     :
     3860       run diasize_change-height in this-procedure
     3861         (input  (p-new-height - frame Dialog-Frame :height)
     3862         ,input  p-move-resize
     3863         ) .
     3864     end.
     3865   end procedure.
     3866   procedure diasize_change-width :
     3867     define input  parameter p-change-value as decimal   no-undo .
     3868     define input  parameter p-move-resize  as logical   no-undo .
     3869     define variable v-field-group-handle   as handle    no-undo .
     3870     define variable v-object-handle        as handle    no-undo .
     3871     define variable v-frame-width          as decimal   no-undo .
     3872     define variable v-frame-virtual-width  as decimal   no-undo .
     3873     define variable v-browse-width         as decimal   no-undo .
     3874     define variable v-window-width         as decimal   no-undo .
     3875     define variable v-window-virtual-width as decimal   no-undo .
     3876     define variable v-change-sign          as integer   no-undo .
     3877     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     3878     define buffer buf_temp-browse-handle  for temp-browse-handle .
     3879     if p-change-value > 0
     3880     then do:
     3881       if frame Dialog-Frame :width + p-change-value >
     3882           session :width-chars
     3883       then do:
     3884         assign
     3885           p-change-value = session :width-chars - frame Dialog-Frame :width
     3886         .
     3887         if p-change-value <= 0
     3888         then do:
     3889           run diasize_position-resize-button in this-procedure .
     3890           return .
     3891         end.
     3892       end.
     3893     end.
     3894     if p-change-value < 0
     3895     then do:
     3896       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     3897       then do:
     3898         assign
     3899           p-change-value = v-diasize-orig-frame-width
     3900                          - frame Dialog-Frame :width
     3901         .
     3902         if p-change-value >= 0
     3903         then do:
     3904           run diasize_position-resize-button in this-procedure .
     3905           return .
     3906         end.
     3907       end.
     3908     end.
     3909     if p-change-value >= 0
     3910     then do:
     3911       assign
     3912         v-change-sign = 1
     3913       .
     3914     end.
     3915     else do:
     3916       assign
     3917         v-change-sign = -1
     3918       .
     3919     end.
     3920     assign
     3921       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     3922     .
     3923     if p-change-value = 0
     3924     then do:
     3925       run diasize_position-resize-button in this-procedure .
     3926       return .
     3927     end.
     3928     move_block:
     3929     do
     3930     on error undo move_block, leave move_block
     3931     :
     3932       if retry
     3933       then do:
     3934         do
     3935         on error undo move_block, leave move_block
     3936         :
     3937           if p-change-value > 0
     3938           then do:
     3939             for each buf_temp-diasize-handle
     3940             on error undo, next
     3941             :
     3942               assign
     3943                 v-object-handle = buf_temp-diasize-handle.handle-value
     3944               .
     3945               if v-object-handle <> v-diasize-resize-button
     3946               then do:
     3947                 assign
     3948                   v-object-handle :col = buf_temp-diasize-handle.save-position
     3949                 .
     3950               end.
     3951             end.
     3952             assign
     3953               v-diasize-browse-handle :width = v-browse-width
     3954             .
     3955             for each buf_temp-browse-handle
     3956               where buf_temp-browse-handle.browse-type = 'width':u
     3957             on error undo, next
     3958             :
     3959               assign
     3960                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     3961               .
     3962             end.
     3963             assign
     3964               frame Dialog-Frame :width = v-frame-width
     3965             .
     3966             if frame Dialog-Frame :scrollable = true
     3967             then do:
     3968               assign
     3969                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     3970               .
     3971             end.
     3972             run diasize_position-resize-button in this-procedure .
     3973           end.
     3974           else do:
     3975             if frame Dialog-Frame :scrollable = true
     3976             then do:
     3977               assign
     3978                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     3979               .
     3980             end.
     3981             assign
     3982               frame Dialog-Frame :width = v-frame-width
     3983             .
     3984             for each buf_temp-browse-handle
     3985               where buf_temp-browse-handle.browse-type = 'width':u
     3986             on error undo, next
     3987             :
     3988               assign
     3989                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     3990               .
     3991             end.
     3992             assign
     3993               v-diasize-browse-handle :width = v-browse-width
     3994             .
     3995             for each buf_temp-diasize-handle
     3996             on error undo, next
     3997             :
     3998               assign
     3999                 v-object-handle = buf_temp-diasize-handle.handle-value
     4000               .
     4001               if v-object-handle <> v-diasize-resize-button
     4002               then do:
     4003                 assign
     4004                   v-object-handle :col = buf_temp-diasize-handle.save-position
     4005                 .
     4006               end.
     4007             end.
     4008             run diasize_position-resize-button in this-procedure .
     4009           end.
     4010           assign
     4011             v-diasize-change-size = false
     4012           .
     4013           leave move_block .
     4014         end.
     4015       end.
     4016       assign
     4017         v-diasize-need-full-display = true
     4018       .
     4019       if v-diasize-change-size = false
     4020       then do:
     4021         assign
     4022           v-diasize-change-size = true
     4023         .
     4024       end.
     4025       else do:
     4026         return .
     4027       end.
     4028       assign
     4029         v-frame-width = frame Dialog-Frame :width
     4030         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     4031         v-browse-width = v-diasize-browse-handle :width
     4032       .
     4033       for each buf_temp-browse-handle
     4034         where buf_temp-browse-handle.browse-type = 'width':u
     4035       :
     4036         assign
     4037           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     4038         .
     4039       end.
     4040       for each buf_temp-diasize-handle
     4041       :
     4042         delete buf_temp-diasize-handle .
     4043       end.
     4044       assign
     4045         v-field-group-handle = frame Dialog-Frame :first-child
     4046       .
     4047       do while valid-handle(v-field-group-handle)
     4048       :
     4049         assign
     4050           v-object-handle = v-field-group-handle :first-child
     4051         .
     4052         do while valid-handle(v-object-handle)
     4053         :
     4054           if  v-object-handle <> v-diasize-browse-handle :handle
     4055           and v-object-handle <> v-diasize-resize-button
     4056           and can-query(v-object-handle, "row")
     4057           and can-query(v-object-handle, "height")
     4058           and ( v-object-handle :col + v-object-handle :width
     4059                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     4060               )
     4061           then do:
     4062             find first buf_temp-browse-handle
     4063               where buf_temp-browse-handle.browse-type   = 'width':u
     4064                 and buf_temp-browse-handle.browse-handle = v-object-handle
     4065               no-error .
     4066             if available buf_temp-browse-handle
     4067             then do:
     4068             end.
     4069             else do:
     4070               create buf_temp-diasize-handle .
     4071               assign
     4072                 buf_temp-diasize-handle.handle-value  = v-object-handle
     4073                 buf_temp-diasize-handle.save-position = v-object-handle :col
     4074               .
     4075             end.
     4076           end.
     4077           assign
     4078             v-object-handle = v-object-handle :next-sibling
     4079           .
     4080         end.
     4081         assign
     4082           v-field-group-handle = v-field-group-handle :next-sibling
     4083         .
     4084       end.
     4085       do with frame Dialog-Frame
     4086       :
     4087         hide v-diasize-resize-button .
     4088         v-diasize-resize-button :row = 1.
     4089         v-diasize-resize-button :column = 1.
     4090       end.
     4091       if p-change-value > 0
     4092       then do:
     4093         if frame Dialog-Frame :scrollable = true
     4094         then do:
     4095           assign
     4096             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     4097             no-error .
     4098           if error-status :error
     4099           or error-status :get-message(1) <> ""
     4100           then do:
     4101             undo move_block, retry move_block.
     4102           end.
     4103         end.
     4104         assign
     4105           frame Dialog-Frame :width = v-frame-width + p-change-value
     4106           no-error .
     4107         if error-status :error
     4108         or error-status :get-message(1) <> ""
     4109         then do:
     4110           undo move_block, retry move_block.
     4111         end.
     4112         assign
     4113           v-diasize-browse-handle :width = v-browse-width + p-change-value
     4114         no-error .
     4115         if error-status :error
     4116         or error-status :get-message(1) <> ""
     4117         then do:
     4118           undo move_block, retry move_block.
     4119         end.
     4120         for each buf_temp-browse-handle
     4121           where buf_temp-browse-handle.browse-type = 'width':u
     4122         on error undo move_block, retry move_block
     4123         :
     4124           assign
     4125             buf_temp-browse-handle.browse-handle :width
     4126               = buf_temp-browse-handle.browse-handle :width + p-change-value
     4127             no-error .
     4128           if error-status :error
     4129           or error-status :get-message(1) <> ""
     4130           then do:
     4131             undo move_block, retry move_block .
     4132           end.
     4133         end.
     4134         for each buf_temp-diasize-handle
     4135         on error undo move_block, retry move_block
     4136         :
     4137           assign
     4138             v-object-handle = buf_temp-diasize-handle.handle-value
     4139           .
     4140           if v-object-handle <> v-diasize-resize-button
     4141           then do:
     4142             assign
     4143               v-object-handle :col = v-object-handle :col + p-change-value
     4144               no-error .
     4145             if error-status :error
     4146             or error-status :get-message(1) <> ""
     4147             then do:
     4148               undo move_block, retry move_block .
     4149             end.
     4150           end.
     4151         end.
     4152       end.
     4153       else do:
     4154         for each buf_temp-diasize-handle
     4155         on error undo move_block, retry move_block
     4156         :
     4157           assign
     4158             v-object-handle = buf_temp-diasize-handle.handle-value
     4159           .
     4160           if v-object-handle <> v-diasize-resize-button
     4161           then do:
     4162             assign
     4163               v-object-handle :col = v-object-handle :col + p-change-value
     4164               no-error .
     4165             if error-status :error
     4166             or error-status :get-message(1) <> ""
     4167             then do:
     4168               undo move_block, retry move_block .
     4169             end.
     4170           end.
     4171         end.
     4172         for each buf_temp-browse-handle
     4173           where buf_temp-browse-handle.browse-type = 'width':u
     4174         on error undo move_block, retry move_block
     4175         :
     4176           assign
     4177             buf_temp-browse-handle.browse-handle :width
     4178               = buf_temp-browse-handle.browse-handle :width + p-change-value
     4179             no-error .
     4180           if error-status :error
     4181           or error-status :get-message(1) <> ""
     4182           then do:
     4183             undo move_block, retry move_block .
     4184           end.
     4185         end.
     4186         assign
     4187           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     4188           no-error .
     4189         if error-status :error
     4190         or error-status :get-message(1) <> ""
     4191         then do:
     4192           undo move_block, retry move_block.
     4193         end.
     4194         assign
     4195           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     4196         no-error .
     4197         if error-status :error
     4198         or error-status :get-message(1) <> ""
     4199         then do:
     4200           undo move_block, retry move_block.
     4201         end.
     4202         if frame Dialog-Frame :scrollable = true
     4203         then do:
     4204           assign
     4205             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     4206           no-error .
     4207           if error-status :error
     4208           or error-status :get-message(1) <> ""
     4209           then do:
     4210             undo move_block, retry move_block.
     4211           end.
     4212         end.
     4213       end.
     4214       if p-move-resize
     4215       then do:
     4216         run diasize_position-resize-button in this-procedure .
     4217       end.
     4218       if v-diasize-wndstore = true
     4219       then do:
     4220         if connected("ub") = true
     4221         then do:
     4222           define variable v-cntxt-db-num        as integer   no-undo .
     4223           define variable v-cntxt-userid        as character no-undo .
     4224           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     4225                                             , OUTPUT v-cntxt-userid
     4226                                             ) .
     4227           run gbl/wndsizew.p
     4228             (input  v-cntxt-db-num
     4229             ,input  v-cntxt-userid
     4230             ,input  v-diasize-proc-name
     4231             ,input  'width':u
     4232             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     4233             ) .
     4234         end.
     4235       end.
     4236     end.
     4237     assign
     4238       v-diasize-change-size = false
     4239     .
     4240   end procedure.
     4241   procedure diasize_set-width :
     4242     define input  parameter p-new-width  as decimal   no-undo .
     4243     define input  parameter p-move-resize as logical   no-undo .
     4244     do
     4245     on error undo, return error return-value
     4246     :
     4247       run diasize_change-width in this-procedure
     4248         (input  (p-new-width - frame Dialog-Frame :width)
     4249         ,input  p-move-resize
     4250         ) .
     4251     end.
     4252   end procedure.
     4253   procedure diasize_position-resize-button :
     4254     do with frame Dialog-Frame
     4255     :
     4256       hide v-diasize-resize-button .
     4257       assign
     4258         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     4259                     - 1
     4260                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     4261         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     4262                     - 1
     4263                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     4264       .
     4265       view v-diasize-resize-button .
     4266     end.
     4267   end procedure.
     4268   on alt-right anywhere
     4269   do:
     4270     run diasize_change-width in this-procedure
     4271       (input 1
     4272       ,input true
     4273       ) .
     4274     return no-apply .
     4275   end.
     4276   on alt-left anywhere
     4277   do:
     4278     run diasize_change-width in this-procedure
     4279       (input -1
     4280       ,input true
     4281       ) .
     4282     return no-apply .
     4283   end.
     4284   on alt-down anywhere
     4285   do:
     4286     run diasize_change-height in this-procedure
     4287       (input 1
     4288       ,input true
     4289       ) .
     4290     return no-apply .
     4291   end.
     4292   on alt-up anywhere
     4293   do:
     4294     run diasize_change-height in this-procedure
     4295       (input -1
     4296       ,input true
     4297       ) .
     4298     return no-apply .
     4299   end.
     4300   on alt-enter of frame Dialog-Frame
     4301   do:
     4302     run diasize_maximize in this-procedure
     4303       (input  ?
     4304       ).
     4305     return no-apply .
     4306   end.
     4307   procedure diasize_end-move :
     4308     do
     4309     on error undo, return error return-value
     4310     :
     4311       define variable v-row-delta as decimal   no-undo .
     4312       define variable v-col-delta as decimal   no-undo .
     4313       define variable v-new-row as decimal   no-undo .
     4314       define variable v-new-col as decimal   no-undo .
     4315       assign
     4316         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     4317         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     4318       .
     4319       assign
     4320         v-row-delta = v-new-row - frame Dialog-Frame :height
     4321         v-col-delta = v-new-col - frame Dialog-Frame :width
     4322       .
     4323       run diasize_change-height in this-procedure
     4324         (input v-row-delta
     4325         ,input true
     4326         ) .
     4327       run diasize_change-width in this-procedure
     4328         (input v-col-delta
     4329         ,input true
     4330         ) .
     4331     end.
     4332   end procedure.
     4333   procedure diasize_maximize :
     4334     define input  parameter p-action as logical   no-undo .
     4335     do
     4336     on error undo, return error return-value
     4337     :
     4338       if p-action = ?
     4339       then do:
     4340         if v-diasize-need-maximize = true
     4341         then do:
     4342           assign
     4343             p-action = true
     4344           .
     4345         end.
     4346         else do:
     4347           assign
     4348             p-action = false
     4349           .
     4350         end.
     4351       end.
     4352       if p-action = true
     4353       then do:
     4354         run diasize_change-height in this-procedure
     4355           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     4356               - frame Dialog-Frame :height-chars
     4357           ,input true
     4358           ) .
     4359         run diasize_change-width in this-procedure
     4360           (input session :width-chars
     4361               - frame Dialog-Frame :width-chars
     4362           ,input true
     4363           ) .
     4364         assign
     4365           v-diasize-need-maximize = false
     4366         .
     4367       end.
     4368       else do:
     4369         run diasize_change-width in this-procedure
     4370           (input v-diasize-orig-frame-width
     4371               - frame Dialog-Frame :width-chars
     4372           ,input true
     4373           ) .
     4374         run diasize_change-height in this-procedure
     4375           (input v-diasize-orig-frame-height
     4376               - frame Dialog-Frame :height-chars
     4377           ,input true
     4378           ) .
     4379         assign
     4380           v-diasize-need-maximize = true
     4381         .
     4382       end.
     4383     end.
     4384   end procedure.
     4385   procedure diasize_restore-orig-size :
     4386     do
     4387     on error undo, return error return-value
     4388     :
     4389       assign
     4390         v-diasize-current-frame-width  = frame Dialog-Frame :width
     4391         v-diasize-current-frame-height = frame Dialog-Frame :height
     4392       .
     4393       run diasize_set-height in this-procedure
     4394         (input  v-diasize-orig-frame-height
     4395         ,input  true
     4396         ) .
     4397       run diasize_set-width in this-procedure
     4398         (input  v-diasize-orig-frame-width
     4399         ,input  true
     4400         ) .
     4401     end.
     4402   end procedure.
     4403   procedure diasize_restore-current-size :
     4404     do
     4405     on error undo, return error return-value
     4406     :
     4407       run diasize_set-height in this-procedure
     4408         (input  v-diasize-current-frame-height
     4409         ,input  true
     4410         ) .
     4411       run diasize_set-width in this-procedure
     4412         (input  v-diasize-current-frame-width
     4413         ,input  true
     4414         ) .
     4415     end.
     4416   end procedure.
     4417   procedure diasize_set-browse-handle :
     4418     define input  parameter p-browse-handle as handle   no-undo .
     4419     define buffer buf_temp-browse-handle for temp-browse-handle .
     4420     do
     4421     on error undo, return error return-value
     4422     :
     4423       assign
     4424         v-diasize-browse-handle = p-browse-handle
     4425       .
     4426       for each buf_temp-browse-handle
     4427       on error undo, return error return-value
     4428       :
     4429         delete buf_temp-browse-handle .
     4430       end.
     4431     end.
     4432   end procedure.
     4433   procedure diasize_add_browse :
     4434     define input  parameter p-browse-type   as character no-undo .
     4435     define input  parameter p-browse-handle as handle    no-undo .
     4436     define buffer buf_temp-browse-handle for temp-browse-handle .
     4437     do
     4438     on error undo, return error return-value
     4439     :
     4440       assign
     4441         v-diasize-browse-number = v-diasize-browse-number + 1
     4442       .
     4443       create buf_temp-browse-handle .
     4444       assign
     4445         buf_temp-browse-handle.browse-type   = p-browse-type
     4446         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     4447         buf_temp-browse-handle.browse-handle = p-browse-handle
     4448       .
     4449     end.
     4450   end procedure.
     4451   procedure diasize_init :
     4452     define variable v-default-value    as logical   no-undo .
     4453     define variable v-restore-saved    as logical   no-undo .
     4454     define variable v-resize-value-str as character no-undo .
     4455     do
     4456     on error undo, return error return-value
     4457     :
     4458       do with frame Dialog-Frame
     4459       :
     4460         assign
     4461           v-diasize-orig-frame-height = frame Dialog-Frame :height
     4462           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     4463           v-diasize-browse-handle     = browse browse-goods :handle
     4464         .
     4465         create button v-diasize-resize-button
     4466         assign
     4467           parent        = frame Dialog-Frame :first-child
     4468           label         = "s"
     4469           height-pixels = 16
     4470           width-pixels  = 16
     4471           visible       = true
     4472           sensitive     = true
     4473           movable       = true
     4474           triggers:
     4475             on end-move persistent run diasize_end-move in this-procedure .
     4476           end triggers.
     4477         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     4478         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     4479         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     4480         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     4481         assign
     4482           v-diasize-wndmax = false
     4483         .
     4484         if connected("ub") = true
     4485         then do:
     4486           define variable v-cntxt-db-num        as integer   no-undo .
     4487           define variable v-cntxt-userid        as character no-undo .
     4488           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     4489                                             , OUTPUT v-cntxt-userid
     4490                                             ) .
     4491           run gbl/wndpar_r.p
     4492             (input  v-cntxt-db-num
     4493             ,input  v-cntxt-userid
     4494             ,input  'wndmax':U
     4495             ,output v-diasize-wndmax
     4496             ,output v-default-value
     4497             ) .
     4498         end.
     4499         assign
     4500           v-diasize-wndstore = false
     4501         .
     4502         if connected("ub") = true
     4503         then do:
     4504           run gbl/wndpar_r.p
     4505             (input  v-cntxt-db-num
     4506             ,input  v-cntxt-userid
     4507             ,input  'wndstore':U
     4508             ,output v-diasize-wndstore
     4509             ,output v-default-value
     4510             ) .
     4511         end.
     4512         assign
     4513           v-diasize-proc-name = entry(1, program-name(2), '.')
     4514         .
     4515         if v-diasize-wndstore = true
     4516         then do:
     4517           assign
     4518             v-restore-saved = false
     4519           .
     4520           if connected("ub") = true
     4521           then do:
     4522             run gbl/wndsizer.p
     4523               (input  v-cntxt-db-num
     4524               ,input  v-cntxt-userid
     4525               ,input  v-diasize-proc-name
     4526               ,input  'height':u
     4527               ,output v-resize-value-str
     4528               ) .
     4529             if v-resize-value-str <> '':U
     4530             then do:
     4531               run diasize_change-height in this-procedure
     4532                 (input  integer(v-resize-value-str)
     4533                 ,input  true
     4534                 ) .
     4535               assign
     4536                 v-restore-saved = true
     4537               .
     4538             end.
     4539           end.
     4540           if connected("ub") = true
     4541           then do:
     4542             run gbl/wndsizer.p
     4543               (input  v-cntxt-db-num
     4544               ,input  v-cntxt-userid
     4545               ,input  v-diasize-proc-name
     4546               ,input  'width':u
     4547               ,output v-resize-value-str
     4548               ) .
     4549             if v-resize-value-str <> '':U
     4550             then do:
     4551               run diasize_change-width in this-procedure
     4552                 (input  integer(v-resize-value-str)
     4553                 ,input  true
     4554                 ) .
     4555               assign
     4556                 v-restore-saved = true
     4557               .
     4558             end.
     4559           end.
     4560           if v-restore-saved <> true
     4561           then do:
     4562             if v-diasize-wndmax = true
     4563             then do:
     4564               run diasize_maximize in this-procedure
     4565                 (input  true
     4566                 ) .
     4567             end.
     4568           end.
     4569         end.
     4570         else do:
     4571           if v-diasize-wndmax = true
     4572           then do:
     4573             run diasize_maximize in this-procedure
     4574               (input  true
     4575               ) .
     4576           end.
     4577         end.
     4578       end.
     4579     end.
     4580   end procedure.
     4581   procedure diasize_need-full-display :
     4582     define output parameter p-need-full-display as logical   no-undo .
     4583     do
     4584     on error undo, return error return-value
     4585     :
     4586       assign
     4587         p-need-full-display = v-diasize-need-full-display
     4588       .
     4589       assign
     4590         v-diasize-need-full-display = false
     4591       .
     4592     end.
     4593   end procedure.
     4594   procedure get-context :
     4595      define output parameter p-db-num as integer          no-undo.
     4596      define output parameter p-user-id as character        no-undo.
     4597      define variable v-login               as character    no-undo.
     4598      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     4599      define buffer buf_user-login  for ub.user-login .
     4600      do
     4601      on error undo, return error
     4602      :
     4603            FIND FIRST buf_sys-ctrl no-lock.
     4604            ASSIGN
     4605               v-login = USERID("ub")
     4606               p-db-num = buf_sys-ctrl.db-num
     4607            .
     4608            FIND FIRST buf_user-login
     4609                 WHERE buf_user-login.db-num = p-db-num
     4610                   AND buf_user-login.user-login = v-login
     4611                 no-lock
     4612                 no-error
     4613                 .
     4614            IF AVAILABLE buf_user-login
     4615            THEN DO:
     4616               assign
     4617                  p-user-id = buf_user-login.user-id
     4618               .
     4619            END.
     4620      end.
     4621   end procedure.
     4622   define variable vss-include-info32 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4623   on F9 of frame Dialog-Frame anywhere do:
     4624     run init-gds-rec.
     4625     if gds-rec = ? then
     4626       return no-apply.
     4627     run ref/gds-form.w ( input parParentProc
     4628                         ,input 'ПРОСМОТР':U
     4629                         ,input ?
     4630                         ,input ?
     4631                         ,input ?
     4632                         ,input-output gds-rec).
     4633     apply "entry" to browse-goods in frame Dialog-Frame.
     4634     return no-apply.
     4635   end.
     4636   run diasize_add_browse in this-procedure
     4637     (input  'width':u
     4638     ,input  browse BROWSE-obj :handle
     4639     ) .
     4640   run diasize_init in this-procedure .
     4641   def var sort-labelbrowse-goods   as character no-undo .
     4642   def var sort-clmnbrowse-goods    as handle    no-undo .
     4643   def var cur-clmnbrowse-goods     as handle    no-undo .
     4644   def var cur-clmn-locbrowse-goods as integer   no-undo .
     4645   def var re-querybrowse-goods     as logical   initial no no-undo .
     4646   on start-search, ctrl-o of browse-goods in frame Dialog-Frame do:
     4647      run sort-brbrowse-goods
     4648        (input (if available abc-analysis-goods
     4649                then recid(abc-analysis-goods)
     4650                else ?
     4651               )
     4652        ).
     4653   end.
     4654   PROCEDURE sort-brbrowse-goods :
     4655     define input parameter p-recid as recid no-undo .
     4656     if re-querybrowse-goods = no then do:
     4657       assign
     4658          cur-clmnbrowse-goods = browse-goods:current-column in frame Dialog-Frame
     4659       .
     4660       if sort-clmnbrowse-goods <> ? then sort-clmnbrowse-goods:column-fgcolor = 0.
     4661       if cur-clmnbrowse-goods = sort-clmnbrowse-goods then do:
     4662         assign
     4663            sort-labelbrowse-goods = ""
     4664            sort-clmnbrowse-goods = ?
     4665         .
     4666        end.
     4667        else do:
     4668          assign
     4669            sort-labelbrowse-goods = cur-clmnbrowse-goods:label
     4670            sort-clmnbrowse-goods  = cur-clmnbrowse-goods
     4671            sort-clmnbrowse-goods:column-fgcolor = 4
     4672          .
     4673        end.
     4674      end.
     4675     assign
     4676       cur-clmn-locbrowse-goods = 1
     4677     .
     4678     def var column-handle as handle no-undo .
     4679     column-handle = browse-goods:first-column.
     4680     do while valid-handle(column-handle) :
     4681       if column-handle = cur-clmnbrowse-goods then do:
     4682         leave .
     4683       end.
     4684       column-handle = column-handle:NEXT-COLUMN.
     4685       assign
     4686         cur-clmn-locbrowse-goods = cur-clmn-locbrowse-goods + 1
     4687       .
     4688     end.
     4689     case sort-labelbrowse-goods:
     4690           when '*! ! '  then DO:   assign       sort-column-name = substitute('dynamic-function(&1mark-string&1, recid(buf_abc-analysis-goods), &1&2&1)', chr(34), rid-list)     .     run OpenBr (yes, no, '':U).   . END.
     4691           when 'Артикул! ! '  then DO:    assign       sort-column-name = "buf_goods.artic"     .     run OpenBr (yes, no, '':U).   . END.
     4692           when 'Название! ! '  then DO:    assign       sort-column-name = "buf_goods.gds-name"     .     run OpenBr (yes, no, '':U).   . END.
     4693           when 'A!B!C'  then DO:    assign       sort-column-name = "buf_abc-analysis-goods.abcg-abc"     .     run OpenBr (yes, no, '':U).   . END.
     4694           when '% по  !крите-!рию   '  then DO:    assign       sort-column-name = "buf_abc-analysis-goods.abcg-prcnt-for-estimate"     .     run OpenBr (yes, no, '':U).   . END.
     4695           when 'Сумма!для оценки!по критерию'  then DO:    assign       sort-column-name = "buf_abc-analysis-goods.abcg-sum-for-estimate"     .     run OpenBr (yes, no, '':U).   . END.
     4696           when 'Заказанное!количество!товара'  then DO:    assign       sort-column-name = "buf_abc-analysis-goods.abcg-order-qnty"     .     run OpenBr (yes, no, '':U).   . END.
     4697           when 'Количество!по!реализации'  then DO:    assign       sort-column-name = "buf_abc-analysis-goods.abcg-qnty"     .     run OpenBr (yes, no, '':U).   . END.
     4698           when 'Остаток!количество!текущий'  then DO:    assign       sort-column-name = "buf_abc-analysis-goods.abcg-stock-qnty"     .     run OpenBr (yes, no, '':U).   . END.
     4699           when 'Остаток!товара в!учет.ценах'  then DO:    assign       sort-column-name = "buf_abc-analysis-goods.abcg-stock-price-acc"     .     run OpenBr (yes, no, '':U).   . END.
     4700           when 'Остаток!товара в!продаж.ценах'  then DO:    assign       sort-column-name = "buf_abc-analysis-goods.abcg-stock-price-sale"     .     run OpenBr (yes, no, '':U).   . END.
     4701           when 'Сумма!реализации в!учет.ценах'  then DO:    assign       sort-column-name = "buf_abc-analysis-goods.abcg-sum-acc"     .     run OpenBr (yes, no, '':U).   . END.
     4702           when 'Сумма!реализации в!прод.ценах'  then DO:    assign       sort-column-name = "buf_abc-analysis-goods.abcg-sum-cur"     .     run OpenBr (yes, no, '':U).   . END.
     4703           when 'Сумма!реализации в!ценах докум.'  then DO:    assign       sort-column-name = "buf_abc-analysis-goods.abcg-sum-doc"     .     run OpenBr (yes, no, '':U).   . END.
     4704           when 'Темп!продаж!среднесут.'  then DO:    assign       sort-column-name = "buf_abc-analysis-goods.abcg-temp-sale-goods"     .     run OpenBr (yes, no, '':U).   . END.
     4705           when '%  !нараст!итогом'  then DO:    assign       sort-column-name = "buf_abc-analysis-goods.abcg-prcnt-account"     .     run OpenBr (yes, no, '':U).   . END.
     4706       otherwise do:
     4707         assign
     4708           sort-column-name = ""
     4709         .
     4710         run OpenBr (yes, no, '':U).
     4711         if sort-labelbrowse-goods <> "" then do:
     4712           assign
     4713             cur-clmnbrowse-goods:column-fgcolor = 0
     4714           .
     4715         end.
     4716         assign
     4717           cur-clmn-locbrowse-goods = ?
     4718         .
     4719       end.
     4720     end case.
     4721     if p-recid <> ? then do:
     4722       reposition browse-goods to recid p-recid no-error.
     4723       apply "value-changed" to browse-goods in frame Dialog-Frame.
     4724     end.
     4725     apply "entry" to browse-goods in frame Dialog-Frame.
     4726   END PROCEDURE.
     4727   procedure re-open-query-srt-clmnbrowse-goods:
     4728   if cur-clmnbrowse-goods = ? then do:
     4729      run OpenBr (yes, no, '':U).
     4730   end.
     4731   else do:
     4732      assign re-querybrowse-goods = yes.
     4733      run sort-brbrowse-goods
     4734        (input (if available abc-analysis-goods
     4735                then recid(abc-analysis-goods)
     4736                else ?
     4737               )
     4738        ).
     4739      assign re-querybrowse-goods = no.
     4740   end.
     4741   end.
     4742   MAIN-BLOCK:
     4743   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     4744      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     4745      buf_goods.artic:resizable in browse BROWSE-goods = true .
     4746      buf_goods.gds-name:resizable in browse BROWSE-goods = true .
     4747      v-izt:resizable in browse BROWSE-goods = true .
     4748      buf_goods.artic:read-only in browse BROWSE-goods = true .
     4749      v-ass-name:resizable in browse BROWSE-obj = true .
     4750      v-obj-igt:resizable in browse BROWSE-obj = true .
     4751      buf_goods.artic:resizable in browse BROWSE-goods = true .
     4752      buf_goods.artic:width     in browse BROWSE-goods = v-size-col1 .
     4753      buf_goods.gds-name:resizable in browse BROWSE-goods = true .
     4754      buf_goods.gds-name:width     in browse BROWSE-goods = v-size-col2 .
     4755      buf_goods.artic:read-only in browse BROWSE-goods = true .
     4756      Buf_abc-analysis-goods.abcg-stock-price-acc:visible in browse BROWSE-goods = false .
     4757      Buf_abc-analysis-goods.abcg-stock-price-sale:visible in browse BROWSE-goods = false.
     4758   ASSIGN b-print:POPUP-MENU IN FRAME Dialog-Frame = MENU POPUP-MENU-B-print:HANDLE.
     4759   ASSIGN b-print:MENU-MOUSE = 1.
     4760     RUN my_enable.
     4761     WAIT-FOR GO OF FRAME Dialog-Frame.
     4762   END.
     4763   RUN disable_UI.
     4764   PROCEDURE calc-prc :
     4765   define input  parameter p-old as character no-undo .
     4766   define input  parameter p-new as character no-undo .
     4767   define input  parameter p-type as character no-undo .
     4768   define input  parameter p-all-sum as decimal   no-undo .
     4769   define input  parameter p-all-qnty as decimal   no-undo .
     4770   define input-output parameter  abc-prc-qnty  as decimal   no-undo .
     4771   define input-output parameter  abc-qnty      as decimal   no-undo .
     4772   define input-output parameter  abc-sum-prc   as decimal   no-undo .
     4773   define input-output parameter  abc-sum       as decimal   no-undo .
     4774   define input  parameter p-sum as decimal   no-undo .
     4775   if p-old  <> p-type and p-new <> p-type then return .
     4776   if p-old  = p-type then do:
     4777       assign
     4778         abc-qnty        = abc-qnty      - 1
     4779         abc-sum         = abc-sum       - p-sum
     4780         abc-sum-prc     = abc-sum  * 100 / p-all-sum
     4781         abc-prc-qnty    = abc-qnty * 100 / p-all-qnty
     4782       .
     4783   end.
     4784   if p-new  = p-type then do:
     4785       assign
     4786         abc-qnty        = abc-qnty      + 1
     4787         abc-sum         = abc-sum       + p-sum
     4788         abc-sum-prc     = abc-sum  * 100 / p-all-sum
     4789         abc-prc-qnty    = abc-qnty * 100 / p-all-qnty
     4790       .
     4791   end.
     4792   END PROCEDURE.
     4793   PROCEDURE chg-abc :
     4794   define variable old-val as character no-undo .
     4795   define variable v-all-sum  as decimal   no-undo .
     4796   define variable v-all-qnty as decimal   no-undo .
     4797      old-val  = Buf_abc-analysis-goods.abcg-abc .
     4798      if lookup ((Buf_abc-analysis-goods.abcg-abc:screen-value  in browse  browse-goods),"A,B,C,D,E,F") = 0 then do:
     4799         message "Значение группы может быть только A B C D E F (латинские буквы)" view-as alert-box information .
     4800          find current Buf_abc-analysis-goods exclusive-lock no-error .
     4801          assign
     4802          Buf_abc-analysis-goods.abcg-abc  = old-val.
     4803         display Buf_abc-analysis-goods.abcg-abc with browse browse-goods .
     4804         return error.
     4805      end.
     4806      IF  Buf_abc-analysis-goods.abcg-abc:screen-value  in browse  browse-goods  <> Buf_abc-analysis-goods.abcg-abc then do:
     4807          message "Вы изменили группу " Buf_abc-analysis-goods.abcg-abc "на"
     4808                   caps ( Buf_abc-analysis-goods.abcg-abc:screen-value  in browse  browse-goods) skip
     4809                   "Сохранить изменение ?"
     4810          view-as alert-box question
     4811          BUTTONS yes-no
     4812          TITLE "Изменение группы ABC"
     4813          UPDATE v-ok  as logical   .
     4814       if v-ok = false  then do:
     4815          find current Buf_abc-analysis-goods exclusive-lock no-error .
     4816          assign
     4817          Buf_abc-analysis-goods.abcg-abc  = old-val.
     4818       end.
     4819       if v-ok = true   then do:
     4820          find current Buf_abc-analysis-goods exclusive-lock no-error .
     4821          if available Buf_abc-analysis-goods then do:
     4822               assign
     4823                 Buf_abc-analysis-goods.abcg-abc-old = old-val
     4824                 Buf_abc-analysis-goods.abcg-abc = caps (Buf_abc-analysis-goods.abcg-abc:screen-value  in browse  browse-goods)
     4825                 .
     4826                 find current buf_abc-analysis exclusive-lock no-error .
     4827                 if available buf_abc-analysis then do:
     4828                     v-all-sum  = buf_abc-analysis.abc-a-sum  + buf_abc-analysis.abc-b-sum  + buf_abc-analysis.abc-c-sum  + buf_abc-analysis.abc-d-sum  + buf_abc-analysis.abc-e-sum  + buf_abc-analysis.abc-f-sum.
     4829                     v-all-qnty = buf_abc-analysis.abc-a-qnty + buf_abc-analysis.abc-b-qnty + buf_abc-analysis.abc-c-qnty + buf_abc-analysis.abc-d-qnty + buf_abc-analysis.abc-e-qnty + buf_abc-analysis.abc-f-qnty.
     4830                     run calc-prc in this-procedure  (
     4831                      input        Buf_abc-analysis-goods.abcg-abc-old
     4832                     ,input        Buf_abc-analysis-goods.abcg-ABC
     4833                     ,input        "A"
     4834                     ,input        v-all-sum
     4835                     ,input        v-all-qnty
     4836                     ,input-output buf_abc-analysis.abc-a-prc-qnty
     4837                     ,input-output buf_abc-analysis.abc-a-qnty
     4838                     ,input-output buf_abc-analysis.abc-a-sum-prc
     4839                     ,input-output buf_abc-analysis.abc-a-sum
     4840                     ,input        Buf_abc-analysis-goods.abcg-sum-for-estimate
     4841                      ).
     4842                     run calc-prc in this-procedure  (
     4843                      input        Buf_abc-analysis-goods.abcg-abc-old
     4844                     ,input        Buf_abc-analysis-goods.abcg-ABC
     4845                     ,input        "B"
     4846                     ,input        v-all-sum
     4847                     ,input        v-all-qnty
     4848                     ,input-output buf_abc-analysis.abc-b-prc-qnty
     4849                     ,input-output buf_abc-analysis.abc-b-qnty
     4850                     ,input-output buf_abc-analysis.abc-b-sum-prc
     4851                     ,input-output buf_abc-analysis.abc-b-sum
     4852                     ,input        Buf_abc-analysis-goods.abcg-sum-for-estimate
     4853                      ).
     4854                     run calc-prc in this-procedure  (
     4855                      input        Buf_abc-analysis-goods.abcg-abc-old
     4856                     ,input        Buf_abc-analysis-goods.abcg-ABC
     4857                     ,input        "C"
     4858                     ,input        v-all-sum
     4859                     ,input        v-all-qnty
     4860                     ,input-output buf_abc-analysis.abc-c-prc-qnty
     4861                     ,input-output buf_abc-analysis.abc-c-qnty
     4862                     ,input-output buf_abc-analysis.abc-c-sum-prc
     4863                     ,input-output buf_abc-analysis.abc-c-sum
     4864                     ,input        Buf_abc-analysis-goods.abcg-sum-for-estimate
     4865                      ).
     4866                     run calc-prc in this-procedure  (
     4867                      input        Buf_abc-analysis-goods.abcg-abc-old
     4868                     ,input        Buf_abc-analysis-goods.abcg-ABC
     4869                     ,input        "D"
     4870                     ,input        v-all-sum
     4871                     ,input        v-all-qnty
     4872                     ,input-output buf_abc-analysis.abc-d-prc-qnty
     4873                     ,input-output buf_abc-analysis.abc-d-qnty
     4874                     ,input-output buf_abc-analysis.abc-d-sum-prc
     4875                     ,input-output buf_abc-analysis.abc-d-sum
     4876                     ,input        Buf_abc-analysis-goods.abcg-sum-for-estimate
     4877                      ).
     4878                     run calc-prc in this-procedure  (
     4879                      input        Buf_abc-analysis-goods.abcg-abc-old
     4880                     ,input        Buf_abc-analysis-goods.abcg-ABC
     4881                     ,input        "E"
     4882                     ,input        v-all-sum
     4883                     ,input        v-all-qnty
     4884                     ,input-output buf_abc-analysis.abc-e-prc-qnty
     4885                     ,input-output buf_abc-analysis.abc-e-qnty
     4886                     ,input-output buf_abc-analysis.abc-e-sum-prc
     4887                     ,input-output buf_abc-analysis.abc-e-sum
     4888                     ,input        Buf_abc-analysis-goods.abcg-sum-for-estimate
     4889                      ).
     4890                     run calc-prc in this-procedure  (
     4891                      input        Buf_abc-analysis-goods.abcg-abc-old
     4892                     ,input        Buf_abc-analysis-goods.abcg-ABC
     4893                     ,input        "F"
     4894                     ,input        v-all-sum
     4895                     ,input        v-all-qnty
     4896                     ,input-output buf_abc-analysis.abc-f-prc-qnty
     4897                     ,input-output buf_abc-analysis.abc-f-qnty
     4898                     ,input-output buf_abc-analysis.abc-f-sum-prc
     4899                     ,input-output buf_abc-analysis.abc-f-sum
     4900                     ,input        Buf_abc-analysis-goods.abcg-sum-for-estimate
     4901                      ).
     4902                 end.
     4903          end.
     4904       end.
     4905      end.
     4906      display Buf_abc-analysis-goods.abcg-abc with browse browse-goods no-error .
     4907      apply "ROW-DISPLAY" to browse-goods in frame Dialog-Frame.
     4908   END PROCEDURE.
     4909   PROCEDURE disable_UI :
     4910     HIDE FRAME Dialog-Frame.
     4911   END PROCEDURE.
     4912   PROCEDURE DISP-OBJ :
     4913   define buffer buf2_assortment-matrix for ub.assortment-matrix.
     4914   define variable         v-gdop-min-stock     as decimal   no-undo .
     4915   define variable         v-grop-max-stock     as decimal   no-undo .
     4916   define variable         v-grop-level-always-presence as decimal   no-undo .
     4917   define variable         v-grop-min-order             as decimal   no-undo .
     4918         v-ass-name = "" .
     4919         IF AVAILABLE buf_assortment-matrix-goods  THEN DO:
     4920             find first buf2_assortment-matrix no-lock where
     4921                        buf2_assortment-matrix.asmt-id  =  buf_assortment-matrix-goods.asmt-id AND
     4922                        buf2_assortment-matrix.db-num   =  buf_assortment-matrix-goods.db-num no-error .
     4923                        if available buf2_assortment-matrix
     4924                           then  v-ass-name = buf2_assortment-matrix.asmt-name .
     4925         END.
     4926         if available buf_abc-analysis-obj and available buf_abc-analysis-goods then do:
     4927   define variable vss-include-info33 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4928   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjpr in g#library
     4929     (input  buf_abc-analysis-obj.obj-type
     4930     ,input  buf_abc-analysis-obj.obj-code
     4931     ,input  ?
     4932     ,input  ?
     4933     ,input  ?
     4934     ,input  buf_abc-analysis-goods.gds-code
     4935     ,output v-obj-AssMin
     4936     ,output v-obj-igt
     4937     ,output v-gdop-min-stock
     4938     ,output v-grop-max-stock
     4939     ,output v-grop-level-always-presence
     4940     ,output v-grop-min-order
     4941     )  .
     4942         end.
     4943   END PROCEDURE.
     4944   PROCEDURE enable_UI :
     4945     ENABLE B-cancel B-mark B-save B-chg-izt B-add-AM B-del-AM B-spis-ord
     4946            b-filter-ext B-Help B-chg-ABC B-add-AMin B-del-AMin B-ord B-print
     4947            BROWSE-goods BROWSE-obj
     4948         WITH FRAME Dialog-Frame.
     4949     VIEW FRAME Dialog-Frame.
     4950     OPEN QUERY BROWSE-goods FOR EACH Buf_abc-analysis-goods       WHERE Buf_abc-analysis-goods.abc-id = v-id and Buf_abc-analysis-goods.db-num = v-db-num NO-LOCK,              EACH buf_goods OF ub.Buf_abc-analysis-goods NO-LOCK  ,              first temp-trn-doc where (r-2 = 1 or buf_goods.gds-code = temp-trn-doc.gds-code )       INDEXED-REPOSITION.    OPEN QUERY BROWSE-obj       FOR EACH Buf_abc-analysis-obj WHERE                Buf_abc-analysis-obj.abc-id = v-id AND                Buf_abc-analysis-obj.db-num = v-db-num                NO-LOCK,                  EACH buf_abc-analysis-gds-obj WHERE                buf_abc-analysis-gds-obj.obj-type = Buf_abc-analysis-obj.obj-type AND                buf_abc-analysis-gds-obj.obj-code = Buf_abc-analysis-obj.obj-code AND                buf_abc-analysis-gds-obj.gds-code = Buf_abc-analysis-goods.gds-code AND                buf_abc-analysis-gds-obj.abc-id   = v-id AND                buf_abc-analysis-gds-obj.db-num   = v-db-num                OUTER-JOIN NO-LOCK,                  EACH Buf_gds-obj-prop WHERE                Buf_gds-obj-prop.obj-type =  Buf_abc-analysis-obj.obj-type AND                Buf_gds-obj-prop.obj-code =  Buf_abc-analysis-obj.obj-code AND                Buf_gds-obj-prop.gds-code =  Buf_abc-analysis-goods.gds-code                OUTER-JOIN NO-LOCK,                 first buf_assortment-matrix WHERE                buf_assortment-matrix.asmt-status        = 0  AND                buf_assortment-matrix.obj-type =  Buf_abc-analysis-obj.obj-type AND                buf_assortment-matrix.obj-code =  Buf_abc-analysis-obj.obj-code                OUTER-JOIN NO-LOCK,                 FIRST buf_assortment-matrix-goods WHERE                buf_assortment-matrix-goods.asmg-status        = 0  AND                buf_assortment-matrix-goods.asmt-id  =  buf_assortment-matrix.asmt-id AND                buf_assortment-matrix-goods.db-num   =  buf_assortment-matrix.db-num  AND                buf_assortment-matrix-goods.gds-code =  buf_abc-analysis-goods.gds-code                OUTER-JOIN NO-LOCK INDEXED-REPOSITION.
     4951   END PROCEDURE.
     4952   PROCEDURE init-gds-rec :
     4953   gds-rec = recid (buf_goods) .
     4954   find first goods no-lock  where recid(goods)  = gds-rec no-error .
     4955   END PROCEDURE.
     4956   PROCEDURE make-gds-list :
     4957   do
     4958     on error undo, return error return-value
     4959     :
     4960   define buffer buf2_goods for ub.goods.
     4961   define buffer buf2_abc-analysis-goods for ub.abc-analysis-goods.
     4962   define variable v-kol as integer   no-undo .
     4963   define variable i as integer   no-undo .
     4964   run waitfram-show in this-procedure ( "Подготовка временных таблиц.... ") .
     4965       for each gds-list : delete gds-list. end.
     4966       v-kol = num-entries( rid-list ) .
     4967       repeat i = 1 to v-kol :
     4968         find first buf2_abc-analysis-goods no-lock where recid(buf2_abc-analysis-goods) = integer(entry(i,rid-list)) no-error .
     4969         if available buf2_abc-analysis-goods then do:
     4970             find first buf2_goods no-lock where buf2_goods.gds-code = buf2_abc-analysis-goods.gds-code no-error .
     4971             if available buf2_goods then do:
     4972                 create gds-list.
     4973                 BUFFER-COPY buf2_goods TO gds-list .
     4974             end.
     4975         end.
     4976       end.
     4977    run waitfram-hide in this-procedure .
     4978     end.
     4979   END PROCEDURE.
     4980   PROCEDURE my_enable :
     4981   define buffer Buf2_abc-analysis-obj for ub.abc-analysis-obj.
     4982   hide B-chg-ABC in frame Dialog-Frame .
     4983     ENABLE B-Cancel
     4984            B-mark
     4985            B-save
     4986            B-chg-izt
     4987            B-add-AM
     4988            B-del-AM
     4989            B-spis-ord
     4990            B-Help
     4991            B-add-AMin
     4992            B-del-AMin
     4993            B-ord
     4994            B-print
     4995            b-filter-ext
     4996            BROWSE-goods
     4997            BROWSE-obj
     4998         WITH FRAME Dialog-Frame.
     4999     view frame dialog-frame.
     5000     FOR EACH Buf2_abc-analysis-obj WHERE
     5001              Buf2_abc-analysis-obj.abc-id = v-id AND
     5002              Buf2_abc-analysis-obj.db-num = v-db-num     NO-LOCK :
     5003       run create_obj-list in this-procedure (Buf2_abc-analysis-obj.obj-type , Buf2_abc-analysis-obj.obj-code ) .
     5004     end.
     5005     run openbr in this-procedure (yes, no, '':u).
     5006   END PROCEDURE.
     5007   PROCEDURE OPenbr :
     5008   define input  parameter p-open-query     as logical   no-undo .
     5009   define input  parameter p-find-next      as logical   no-undo .
     5010   define input  parameter p-find-condition as character no-undo .
     5011   define variable l-query-was-opened as logical no-undo .
     5012   define variable title0 as character no-undo.
     5013   define buffer buff_contract for contract.
     5014   define variable loc_contract-code as character no-undo .
     5015   define variable sort-column-phrase as character no-undo .
     5016   case sort-column-name :
     5017     when "" then do:
     5018       assign
     5019         sort-column-phrase = ""
     5020       .
     5021     end.
     5022     otherwise do:
     5023       assign
     5024         sort-column-phrase = "by " + sort-column-name
     5025       .
     5026     end.
     5027   end case.
     5028   define variable l-open-query as logical   no-undo .
     5029   define variable vss-include-info34 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5030   define variable  l-disable-where-35  as logical   no-undo .
     5031   define variable  l-filter-open-35    as logical   .
     5032   define variable  flt-rec-35       as recid     no-undo .
     5033   define variable  filter-name-35      as character no-undo .
     5034   define variable  where-phrase-35     as character no-undo .
     5035   define variable  sort-phrase-35      as character no-undo .
     5036   define variable  where-phrase-rus-35 as character no-undo .
     5037   define variable  sort-phrase-rus-35  as character no-undo .
     5038     run waitfram-show in this-procedure
     5039       (input "ЖДИТЕ ..."
     5040       ).
     5041   run gbl/flt-get.p
     5042     (input filter-point
     5043     ,output flt-rec-35
     5044     ,output filter-name-35
     5045     ,output where-phrase-35
     5046     ,output sort-phrase-35
     5047     ,output where-phrase-rus-35
     5048     ,output sort-phrase-rus-35
     5049     ).
     5050   if p-open-query then do:
     5051     assign
     5052       l-filter-open-35 = false
     5053     .
     5054     if flt-rec-35 <> ?
     5055       or sort-column-phrase > ""
     5056     then do:
     5057       define variable  parameter-2-35 as character no-undo .
     5058       define variable  parameter-3-35 as character no-undo .
     5059       define variable  parameter-4-35 as character no-undo .
     5060       define variable  parameter-5-35 as character no-undo .
     5061       define variable  parameter-6-35 as character no-undo .
     5062       define variable  parameter-7-35 as character no-undo .
     5063         assign
     5064         parameter-3-35 =
     5065                                 "FOR EACH Buf_abc-analysis-goods"
     5066         parameter-4-35 =
     5067           (
     5068             if (" Buf_abc-analysis-goods.abc-id = v-id  and Buf_abc-analysis-goods.db-num = v-db-num  " + " " + where-phrase-35) <> ""
     5069             then  substitute(' Buf_abc-analysis-goods.abc-id = &1 and Buf_abc-analysis-goods.db-num = &2 ' , v-id , v-db-num )  + " " + where-phrase-35
     5070             else "true"
     5071           )
     5072         parameter-5-35 = (" " + "" + " " + substitute(' , EACH buf_goods OF ub.Buf_abc-analysis-goods NO-LOCK , first temp-trn-doc where ( &1 = 1 or buf_goods.gds-code = temp-trn-doc.gds-code )',  r-2 ))
     5073         parameter-6-35 = if sort-phrase-35 = ''
     5074                              then
     5075           (
     5076           " " + "  " +
     5077             " " + sort-column-phrase +
     5078           " " + "  "
     5079           )
     5080                              else
     5081           (
     5082           " " + "  " +
     5083             " " + sort-column-phrase +
     5084           " " + sort-phrase-35
     5085           )
     5086         parameter-7-35 =
     5087           " indexed-reposition  "
     5088       .
     5089       do
     5090       on stop undo, leave
     5091       on error undo, leave
     5092       :
     5093         assign
     5094           l-disable-where-35 =
     5095             (" Buf_abc-analysis-goods.abc-id = v-id  and Buf_abc-analysis-goods.db-num = v-db-num  " + " " + where-phrase-35 = "")
     5096         .
     5097         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     5098                             ,input query BROWSE-goods:handle
     5099                             ,input parameter-3-35
     5100                             ,input parameter-4-35
     5101                             ,input parameter-5-35
     5102                             ,input parameter-6-35
     5103                             ,input parameter-7-35
     5104                             )
     5105         .
     5106         assign
     5107           l-filter-open-35 = true
     5108         .
     5109       end.
     5110       if l-filter-open-35 = false then do:
     5111         message
     5112           "Ошибка при фильтрации / сортировке" skip
     5113           "Будут показаны записи без учета фильтра" skip
     5114           view-as alert-box .
     5115       end.
     5116       else do:
     5117           assign
     5118             l-query-was-opened = true
     5119           .
     5120       end.
     5121     end.
     5122     if l-filter-open-35 = false then do:
     5123       OPEN QUERY browse-goods FOR EACH Buf_abc-analysis-goods no-lock use-index sort-pcnt
     5124         where  Buf_abc-analysis-goods.abc-id = v-id  and Buf_abc-analysis-goods.db-num = v-db-num
     5125       , EACH buf_goods OF ub.Buf_abc-analysis-goods NO-LOCK , first temp-trn-doc where (r-2 = 1 or buf_goods.gds-code = temp-trn-doc.gds-code )
     5126         indexed-reposition
     5127     .
     5128         assign
     5129           l-query-was-opened = true
     5130         .
     5131     end.
     5132   end.
     5133   else do:
     5134     assign
     5135       doc-rec = recid( Buf_abc-analysis-goods )
     5136     .
     5137     do
     5138     on stop undo, leave
     5139     on error undo, leave
     5140     :
     5141       if query BROWSE-goods:handle:get-buffer-handle(1) = (buffer Buf_abc-analysis-goods:handle) then do:
     5142         assign
     5143         parameter-2-35 = (if p-find-next then "true":u else "false":u )
     5144         parameter-4-35 =
     5145           "where ":u +  substitute(' Buf_abc-analysis-goods.abc-id = &1 and Buf_abc-analysis-goods.db-num = &2 ' , v-id , v-db-num )  + " ":u + where-phrase-35 + " ":u + p-find-condition + " " + ""
     5146         parameter-5-35 = "  "
     5147       .
     5148         run fltopend_fltfindd in this-procedure  (
     5149                             input this-procedure:handle
     5150                             ,input query BROWSE-goods:handle
     5151                             ,input rowid(Buf_abc-analysis-goods)
     5152                             ,input logical(parameter-2-35)
     5153                             ,input no-lock
     5154                             ,input (buffer Buf_abc-analysis-goods:handle)
     5155                             ,input parameter-4-35
     5156                             ,input parameter-5-35
     5157                             ) no-error.
     5158         .
     5159         assign
     5160           doc-rec = integer(return-value)
     5161           v-fltopend-rowid[1] = ?
     5162         .
     5163       end.
     5164       else do:
     5165         assign
     5166         parameter-2-35 = (if p-find-next then "true":u else "false":u )
     5167         parameter-3-35 =  "FOR EACH Buf_abc-analysis-goods"
     5168         parameter-4-35 =
     5169           (
     5170             if (" Buf_abc-analysis-goods.abc-id = v-id  and Buf_abc-analysis-goods.db-num = v-db-num  " + " " + where-phrase-35) <> ""
     5171             then  substitute(' Buf_abc-analysis-goods.abc-id = &1 and Buf_abc-analysis-goods.db-num = &2 ' , v-id , v-db-num )  + " " + where-phrase-35
     5172             else "true"
     5173           )
     5174         parameter-5-35 = (" " + "" + " " + substitute(' , EACH buf_goods OF ub.Buf_abc-analysis-goods NO-LOCK , first temp-trn-doc where ( &1 = 1 or buf_goods.gds-code = temp-trn-doc.gds-code )',  r-2 ) + " " + p-find-condition)
     5175         parameter-6-35 = if sort-phrase-35 = ''
     5176                              then
     5177           (
     5178           " " + "  " +
     5179             " " + sort-column-phrase +
     5180           " " + "  "
     5181           )
     5182                              else
     5183           (
     5184           " " + "  " +
     5185             " " + sort-column-phrase +
     5186           " " + sort-phrase-35
     5187           )
     5188         parameter-7-35 =
     5189           " indexed-reposition  "
     5190       .
     5191         run fltopend_fltfindq in this-procedure  (
     5192                             input this-procedure:handle
     5193                             ,input query BROWSE-goods:handle
     5194                             ,input logical(parameter-2-35)
     5195                             ,input no-lock
     5196                             ,input parameter-3-35
     5197                             ,input parameter-4-35
     5198                             ,input parameter-5-35
     5199                             ,input parameter-6-35
     5200                             ,input parameter-7-35
     5201                             ,output v-fltopend-rowid
     5202                             ) no-error.
     5203         .
     5204         doc-rec = ?.
     5205       end.
     5206       assign
     5207         l-query-was-opened = true
     5208       .
     5209     end.
     5210   end.
     5211     run waitfram-hide in this-procedure .
     5212   if not p-open-query AND  doc-rec <> ? then DO:
     5213   REPOSITION browse-goods to recid doc-rec No-ERROR.
     5214   END.
     5215   OPEN QUERY BROWSE-obj       FOR EACH Buf_abc-analysis-obj WHERE                Buf_abc-analysis-obj.abc-id = v-id AND                Buf_abc-analysis-obj.db-num = v-db-num                NO-LOCK,                  EACH buf_abc-analysis-gds-obj WHERE                buf_abc-analysis-gds-obj.obj-type = Buf_abc-analysis-obj.obj-type AND                buf_abc-analysis-gds-obj.obj-code = Buf_abc-analysis-obj.obj-code AND                buf_abc-analysis-gds-obj.gds-code = Buf_abc-analysis-goods.gds-code AND                buf_abc-analysis-gds-obj.abc-id   = v-id AND                buf_abc-analysis-gds-obj.db-num   = v-db-num                OUTER-JOIN NO-LOCK,                  EACH Buf_gds-obj-prop WHERE                Buf_gds-obj-prop.obj-type =  Buf_abc-analysis-obj.obj-type AND                Buf_gds-obj-prop.obj-code =  Buf_abc-analysis-obj.obj-code AND                Buf_gds-obj-prop.gds-code =  Buf_abc-analysis-goods.gds-code                OUTER-JOIN NO-LOCK,                 first buf_assortment-matrix WHERE                buf_assortment-matrix.asmt-status        = 0  AND                buf_assortment-matrix.obj-type =  Buf_abc-analysis-obj.obj-type AND                buf_assortment-matrix.obj-code =  Buf_abc-analysis-obj.obj-code                OUTER-JOIN NO-LOCK,                 FIRST buf_assortment-matrix-goods WHERE                buf_assortment-matrix-goods.asmg-status        = 0  AND                buf_assortment-matrix-goods.asmt-id  =  buf_assortment-matrix.asmt-id AND                buf_assortment-matrix-goods.db-num   =  buf_assortment-matrix.db-num  AND                buf_assortment-matrix-goods.gds-code =  buf_abc-analysis-goods.gds-code                OUTER-JOIN NO-LOCK INDEXED-REPOSITION.
     5216   END PROCEDURE.
     5217   PROCEDURE print-proc :
     5218   define input  parameter p-obj as logical   no-undo .
     5219   define variable date_string     as      char    no-undo.
     5220   define variable Line                as      char    no-undo.
     5221   define variable for-time as char.
     5222              run get-report-num (
     5223               output p-report-id
     5224           ).
     5225       v-file-name-rep-htm = session:temp-directory + string(p-report-id) + ".html".
     5226       output stream OutStr-html to value(v-file-name-rep-htm) convert target 'UTF-8'.
     5227       put stream OutStr-html unformatted
     5228                "<!DOCTYPE HTML>" skip
     5229                   ' <html>' skip
     5230                   '  <head>' skip
     5231                   '   <meta charset="utf-8">' skip
     5232                   '    <style type="text/css">' skip
