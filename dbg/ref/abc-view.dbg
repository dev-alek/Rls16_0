      550   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      551   procedure cur-time :
      552      define output parameter p-today as date      no-undo .
      553      define output parameter p-time  as integer   no-undo .
      554     do
      555     on error undo, return error
      556     :
      557       define variable v-date1 as date      no-undo .
      558       define variable v-date2 as date      no-undo .
      559       define variable v-time  as integer   no-undo .
      560       assign
      561         v-date1 = today
      562         v-time  = time
      563         v-date2 = today
      564       .
      565       if v-date1 <> v-date2
      566       then do:
      567         assign
      568           v-date1 = today
      569           v-time  = v-time
      570         .
      571       end.
      572       assign
      573         p-today = v-date1
      574         p-time  = v-time
      575       .
      576     end.
      577   end.
      578   function cur-time-date returns character
      579   :
      580     return string(today, '99/99/9999':U) .
      581   end.
      582   function cur-time-mjd returns decimal
      583   :
      584     define variable v-date as date      no-undo .
      585     define variable v-time as integer   no-undo .
      586     run cur-time in this-procedure
      587       (output v-date
      588       ,output v-time
      589       ) .
      590     return integer(v-date) - 2400002 + (v-time / 86400) .
      591   end.
      592   function cur-time-get-ending-index returns integer
      593   (input p-number as integer
      594   )
      595   :
      596     if p-number < 0
      597     or p-number = ?
      598     then do:
      599       return 1 .
      600     end.
      601     define variable v-rest as integer   no-undo .
      602     assign
      603       p-number = p-number modulo 100
      604     .
      605     if p-number < 20
      606     then do:
      607       assign
      608         v-rest = p-number
      609       .
      610     end.
      611     else do:
      612       assign
      613         v-rest = p-number modulo 10
      614       .
      615     end.
      616     case v-rest :
      617       when 1
      618       then do:
      619         return 2 .
      620       end.
      621       when 2 or
      622       when 3 or
      623       when 4
      624       then do:
      625         return 3 .
      626       end.
      627       otherwise do:
      628         return 1 .
      629       end.
      630     end case .
      631   end.
      632   procedure cur-time-mjd-to-date :
      633      define input  parameter i-mjd-diff as decimal no-undo.
      634      define output parameter o-Date     as date    no-undo.
      635      define output parameter o-Time     as integer no-undo.
      636      define variable v-day-number as integer   no-undo .
      637      if    i-mjd-diff < 0
      638         or i-mjd-diff = ?
      639      then do:
      640         return "?" .
      641      end.
      642      assign
      643         v-day-number = truncate(i-mjd-diff,0).
      644         o-Date = date(v-day-number + 2400002).
      645         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      646     .
      647   end.
      648   function cur-time-mjd-to-string returns character
      649   (input p-mjd-diff as decimal
      650   )
      651   :
      652     define variable v-day-number as integer   no-undo .
      653     define variable v-seconds    as integer   no-undo .
      654     define variable v-hour       as integer   no-undo .
      655     define variable v-min        as integer   no-undo .
      656     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      657     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      658     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      659     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      660     if p-mjd-diff < 0
      661     or p-mjd-diff = ?
      662     then do:
      663       return "?" .
      664     end.
      665     assign
      666       v-day-number = integer(truncate(p-mjd-diff,0))
      667       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      668     .
      669     if v-seconds > 86400
      670     then do:
      671       assign
      672         v-seconds = 86400 - 1
      673       .
      674     end.
      675     if v-seconds < 0
      676     then do:
      677       assign
      678         v-seconds = 0
      679       .
      680     end.
      681     assign
      682       v-hour = truncate(v-seconds / 3600, 0)
      683     .
      684     assign
      685       v-seconds = v-seconds modulo 3600
      686     .
      687     assign
      688       v-min = truncate(v-seconds / 60, 0)
      689     .
      690     assign
      691       v-seconds = v-seconds modulo 60
      692     .
      693     return
      694         (if v-day-number <> 0
      695           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      696           else ""
      697         )
      698       + (if v-day-number <> 0 or v-hour <> 0
      699           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      700           else ""
      701         )
      702       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      703           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      704           else ""
      705         )
      706       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      707       .
      708   end.
      709   function cur-time-string returns character
      710   :
      711     define variable v-date as date      no-undo .
      712     define variable v-time as integer   no-undo .
      713     run cur-time in this-procedure
      714       (output v-date
      715       ,output v-time
      716       ) .
      717     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      718   end.
      719   function cur-time-string-sec returns character
      720   :
      721     define variable v-date as date      no-undo .
      722     define variable v-time as integer   no-undo .
      723     run cur-time in this-procedure
      724       (output v-date
      725       ,output v-time
      726       ) .
      727     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      728   end.
      729   function cur-time-custom  returns character
      730   (input p-prefix as character
      731   ,input p-date-format as character
      732   ,input p-delimiter as character
      733   ,input p-time-format as character
      734   ,input p-suffix as character
      735   )
      736   :
      737     define variable v-date as date      no-undo .
      738     define variable v-time as integer   no-undo .
      739     run cur-time in this-procedure
      740       (output v-date
      741       ,output v-time
      742       ) .
      743     return
      744       p-prefix
      745       + string(v-date, p-date-format)
      746       + p-delimiter
      747       + string(v-time, p-time-format)
      748       + p-suffix
      749       .
      750   end.
      751   function cur-time-print  returns character
      752   :
      753     define variable v-date as date      no-undo .
      754     define variable v-time as integer   no-undo .
      755     run cur-time in this-procedure
      756       (output v-date
      757       ,output v-time
      758       ) .
      759     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      760   end.
      761   function cur-time-datetime returns datetime
      762   :
      763     define variable v-char as character no-undo .
      764     define variable v-datetime as datetime no-undo .
      765     v-char = cur-time-string().
      766     v-datetime = datetime(v-char).
      767     return  v-datetime.
      768   end.
      769   function cur-time-string-msec returns character
      770   :
      771     define variable v-date as datetime  no-undo .
      772     v-date = now.
      773     return string(v-date) .
      774   end.
      775   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      776   define temp-table temp-index_name-value no-undo
      777   field name-key  as character
      778   field value-key as character
      779   index pi name-key
      780   .
      781   define temp-table temp-sub-index_name no-undo
      782   field name-key  as character
      783   field nn as integer
      784   index pi nn
      785   .
      786   procedure def-hash :
      787     do
      788     on error undo, return error return-value
      789     :
      790     define input  parameter p-full-string as character no-undo .
      791     define output parameter p-possb-keep-string as logical   no-undo .
      792     define output parameter p-string            as character no-undo .
      793     define output parameter p-hash-string       as character no-undo .
      794       p-full-string = trim( p-full-string ) .
      795       if length (p-full-string ) > 150 then do:
      796       assign
      797         p-possb-keep-string =  false
      798         p-string            =  substring(p-full-string,1,150)
      799         p-hash-string       =  encode(p-full-string)
      800       .
      801       end.
      802       else do:
      803       assign
      804         p-possb-keep-string =  true
      805         p-string            =  p-full-string
      806         p-hash-string       =  encode(p-full-string)
      807       .
      808       end.
      809     end.
      810   end procedure.
      811   procedure find-from-hash :
      812     do
      813     on error undo, return error return-value
      814     :
      815   define input  parameter  p-full-string            as character no-undo .
      816   define input  parameter  p-table-name             as character no-undo .
      817   define input  parameter  p-field-possb-keep-name  as character no-undo .
      818   define input  parameter  p-field-string-name      as character no-undo .
      819   define input  parameter  p-field-hash-string-name as character no-undo .
      820   define input  parameter  p-sub-table-name         as character no-undo .
      821   define output parameter  p-recid                  as recid     no-undo .
      822   define variable v-possb-keep-string as logical   no-undo .
      823   define variable v-string            as character no-undo .
      824   define variable v-hash-string       as character no-undo .
      825   define variable v-query-prepare     as character no-undo .
      826   define variable i  as integer no-undo .
      827   define variable qh as widget-handle no-undo .
      828   define variable bh as widget-handle no-undo .
      829   define variable p-rez as logical   no-undo .
      830   run def-hash in this-procedure (input  p-full-string ,
      831                 output v-possb-keep-string ,
      832                 output v-string            ,
      833                 output v-hash-string
      834                 ).
      835   p-recid = ? .
      836   create buffer bh for table p-table-name.
      837   create query qh.
      838      v-query-prepare =
      839       "for each " + p-table-name + " no-lock where "
      840       + p-field-possb-keep-name   + " = "  + string(v-possb-keep-string) + " and "
      841       + p-field-string-name       + " = '" + v-string            + "' and "
      842       + p-field-hash-string-name  + " = '" + v-hash-string       + "'"
      843       .
      844   if v-possb-keep-string = true then do:
      845       qh:set-buffers(bh).
      846       qh:query-prepare(v-query-prepare).
      847       qh:query-open.
      848       qh:get-first.
      849       p-recid = bh:recid.
      850   end.
      851   else do:
      852   message false "анализ hash" .
      853     qh:set-buffers(bh).
      854     qh:query-prepare(v-query-prepare).
      855     qh:query-open.
      856     qh:get-first.
      857     p-recid = bh:recid.
      858     repeat :
      859       qh:get-next.
      860       if bh:available then do:
      861          qh:get-first.
      862          run ver-sub-table in this-procedure (
      863              input  p-full-string ,
      864              input  p-table-name ,
      865              input  p-sub-table-name ,
      866              input  bh:recid  ,
      867              output p-rez
      868              ).
      869          if p-rez = true  then do:
      870             p-recid = bh:recid .
      871             leave.
      872          end.
      873          else do:
      874            next.
      875          end.
      876       end.
      877       leave.
      878     end.
      879   end.
      880   delete widget bh.
      881   delete widget qh.
      882     end.
      883   end procedure.
      884   procedure ver-sub-table :
      885     do
      886     on error undo, return error return-value
      887     :
      888   define input  parameter p-full-string as character no-undo .
      889   define input  parameter p-name-table as character no-undo .
      890   define input  parameter p-sub-name-table as character no-undo .
      891   define input  parameter p-recid as recid no-undo .
      892   define output parameter p-ok as logical   no-undo .
      893   define variable v-query-prepare     as character no-undo .
      894   define variable i  as integer no-undo .
      895   define variable qh as widget-handle no-undo .
      896   define variable bh as widget-handle no-undo .
      897   define variable p-rez as logical   no-undo .
      898   for each temp-index_name-value : delete temp-index_name-value . end.
      899   for each temp-sub-index_name : delete temp-sub-index_name . end.
      900       create buffer bh for table p-name-table.
      901       create query qh.
      902       v-query-prepare = "for each " + p-name-table + " no-lock where recid(" + p-name-table + ") = " + string ( p-recid ) .
      903       qh:set-buffers(bh).
      904       qh:query-prepare(v-query-prepare).
      905       qh:query-open.
      906       qh:get-first.
      907       p-recid = bh:recid.
      908   define variable v-inf-ind AS CHAR NO-UNDO.
      909   define variable v-name-pi as character no-undo .
      910   define variable v-num-fl-inkey as integer   no-undo .
      911   define variable v-num-fl       as integer   no-undo .
      912   define variable j as integer   no-undo .
      913   v-name-pi = bh:PRIMARY .
      914   v-inf-ind = "1".
      915   i = 0.
      916   DO while ( v-inf-ind <> ? )
      917       on error undo, return error:
      918       i = i + 1 .
      919       v-inf-ind = bh:INDEX-INFORMATION(i) .
      920       if v-inf-ind = ? then leave.
      921       if entry( 1 , v-inf-ind ) = v-name-pi then do:
      922          v-num-fl-inkey = ( num-entries(v-inf-ind) - 4 ) / 2 .
      923          v-num-fl       = ( num-entries(v-inf-ind) - 4 )     .
      924         if v-num-fl-inkey >= 1 then do:
      925             do j = 5 to v-num-fl  by 2 :
      926                 create temp-index_name-value .
      927                 assign
      928                   temp-index_name-value.name-key  = entry( j , v-inf-ind )
      929                   temp-index_name-value.value-key = bh:BUFFER-FIELD(entry( j , v-inf-ind )):BUFFER-VALUE
      930                 .
      931             end.
      932          end.
      933       end.
      934   END.
      935   define variable qh-sub as widget-handle no-undo .
      936   define variable bh-sub as widget-handle no-undo .
      937       create buffer bh-sub for table p-sub-name-table.
      938       create query qh-sub.
      939   define variable k as integer   no-undo init 0 .
      940       v-query-prepare = "for each " + p-sub-name-table + " no-lock where " .
      941       for each temp-index_name-value :
      942           v-query-prepare = v-query-prepare  + p-sub-name-table + "." + temp-index_name-value.name-key +
      943                         " = " + temp-index_name-value.value-key + " and " .
      944       end.
      945       v-query-prepare = v-query-prepare + " true = true " .
      946       qh-sub:set-buffers(bh-sub).
      947       qh-sub:query-prepare(v-query-prepare).
      948       qh-sub:query-open.
      949         v-name-pi = bh-sub:PRIMARY .
      950         v-inf-ind = "1".
      951         i = 0.
      952         DO while ( v-inf-ind <> ? )
      953             on error undo, return error:
      954             i = i + 1 .
      955             v-inf-ind = bh-sub:INDEX-INFORMATION(i) .
      956             if v-inf-ind = ? then leave.
      957             if entry( 1 , v-inf-ind ) = v-name-pi then do:
      958               v-num-fl-inkey = ( num-entries(v-inf-ind) - 4 ) / 2 .
      959               v-num-fl       = ( num-entries(v-inf-ind) - 4 )     .
      960               if v-num-fl-inkey >= 1 then do:
      961                   do j = 5 to v-num-fl  by 2 :
      962                       if not can-find (first temp-index_name-value  where temp-index_name-value.name-key =  entry( j , v-inf-ind )) then do:
      963                           create temp-sub-index_name .
      964                           assign
      965                             temp-sub-index_name.name-key  = entry( j , v-inf-ind )
      966                             temp-sub-index_name.nn  = j
      967                           .
      968                       end.
      969                   end.
      970               end.
      971             end.
      972         END.
      973         define variable v-qw as character no-undo .
      974         v-qw = "".
      975         qh-sub:GET-first.
      976         DO WHILE (bh-sub:AVAILABLE):
      977           for each temp-sub-index_name :
      978               v-qw = v-qw + string(bh-sub:BUFFER-FIELD(temp-sub-index_name.name-key):BUFFER-VALUE) .
      979           end.
      980           v-qw = v-qw + ",".
      981           qh-sub:GET-NEXT.
      982         END.
      983         p-ok = false .
      984         if trim(p-full-string, ",")  =  trim (v-qw, ",") then p-ok = true  .
      985       delete widget bh-sub.
      986       delete widget qh-sub.
      987       delete widget bh.
      988       delete widget qh.
      989     end.
      990   end procedure.
      991   PROCEDURE update-rang-def :
      992   define input  parameter p-recid as recid     no-undo .
      993   define input  parameter p-list-obj as character no-undo .
      994   define input  parameter p-a as decimal   no-undo .
      995   define input  parameter p-b as decimal   no-undo .
      996   define input  parameter p-c as decimal   no-undo .
      997   define input  parameter p-d as decimal   no-undo .
      998   define input  parameter p-e as decimal   no-undo .
      999   define input  parameter p-f as decimal   no-undo .
     1000   define variable v-date as date no-undo .
     1001   define variable v-time as integer no-undo .
     1002   define variable v-exist as logical   no-undo .
     1003   define variable p-id as integer   no-undo .
     1004   define variable p-db as integer   no-undo .
     1005   define variable  p-possb-keep-string-obj as logical   no-undo .
     1006   define variable  p-string-obj            as character no-undo .
     1007   define variable  p-hash-string-obj       as character no-undo .
     1008   define buffer buf_rang-abc-def     for ub.rang-abc-def.
     1009   define buffer buf_rang-abc-def-obj for ub.rang-abc-def-obj.
     1010   find first buf_rang-abc-def exclusive-lock where recid(buf_rang-abc-def) = p-recid no-error .
     1011   if not available buf_rang-abc-def then do:
     1012       v-exist = false  .
     1013       assign
     1014         p-id = next-value(s-asmt, ub)
     1015         p-db = g#db-num
     1016       .
     1017       create buf_rang-abc-def.
     1018       run def-hash in this-procedure (
     1019            input   p-list-obj
     1020           ,output  p-possb-keep-string-obj
     1021           ,output  p-string-obj
     1022           ,output  p-hash-string-obj
     1023           ).
     1024   end.
     1025   else do:
     1026     assign
     1027         v-exist = true
     1028         p-id = buf_rang-abc-def.raad-id
     1029         p-db = buf_rang-abc-def.db-num
     1030         p-hash-string-obj       = buf_rang-abc-def.raad-hash-string-obj
     1031         p-possb-keep-string-obj = buf_rang-abc-def.raad-possb-keep-string-obj
     1032         p-string-obj            = buf_rang-abc-def.raad-string-obj
     1033     .
     1034   end.
     1035   run cur-time in this-procedure ( output v-date, output v-time ) .
     1036       assign
     1037             buf_rang-abc-def.raad-hash-string-obj       = p-hash-string-obj
     1038             buf_rang-abc-def.raad-possb-keep-string-obj = p-possb-keep-string-obj
     1039             buf_rang-abc-def.raad-string-obj            = p-string-obj
     1040             buf_rang-abc-def.raad-a                     = p-a
     1041             buf_rang-abc-def.raad-b                     = p-b
     1042             buf_rang-abc-def.raad-c                     = p-c
     1043             buf_rang-abc-def.raad-d                     = p-d
     1044             buf_rang-abc-def.raad-e                     = p-e
     1045             buf_rang-abc-def.raad-f                     = p-f
     1046             buf_rang-abc-def.raad-id                    = p-id
     1047             buf_rang-abc-def.raad-date                  = v-date
     1048             buf_rang-abc-def.raad-db-num                = g#db-num
     1049             buf_rang-abc-def.db-num                     = p-db
     1050             buf_rang-abc-def.raad-time                  = v-time
     1051             buf_rang-abc-def.raad-who                   = g#userid
     1052         .
     1053   if v-exist = true then do:
     1054      for each buf_rang-abc-def-obj exclusive-lock where
     1055               buf_rang-abc-def-obj.raad-id = buf_rang-abc-def.raad-id and
     1056               buf_rang-abc-def-obj.db-num  = buf_rang-abc-def.db-num :
     1057               delete buf_rang-abc-def-obj.
     1058      end.
     1059   end.
     1060   define variable i as integer   no-undo .
     1061   define variable k as integer   no-undo .
     1062   p-list-obj = trim(p-list-obj, "," ).
     1063   k = num-entries(p-list-obj, ",") .
     1064   repeat  i = 1 to k :
     1065     create buf_rang-abc-def-obj.
     1066     assign
     1067       buf_rang-abc-def-obj.raad-id  = buf_rang-abc-def.raad-id
     1068       buf_rang-abc-def-obj.db-num   = buf_rang-abc-def.db-num
     1069       buf_rang-abc-def-obj.obj-type = substring(entry(i, p-list-obj) , 1 , 3 )
     1070       buf_rang-abc-def-obj.obj-code = integer(substring(entry(i, p-list-obj) , 4 , 10 ))
     1071     .
     1072   end.
     1073   RELEASE buf_rang-abc-def .
     1074   END PROCEDURE.
     1075   PROCEDURE update-rang-xyz-def :
     1076   define input  parameter p-recid as recid     no-undo .
     1077   define input  parameter p-list-obj as character no-undo .
     1078   define input  parameter p-x as decimal   no-undo .
     1079   define input  parameter p-y as decimal   no-undo .
     1080   define input  parameter p-z as decimal   no-undo .
     1081   define variable v-date as date no-undo .
     1082   define variable v-time as integer no-undo .
     1083   define variable v-exist as logical   no-undo .
     1084   define variable p-id as integer   no-undo .
     1085   define variable p-db as integer   no-undo .
     1086   define variable  p-possb-keep-string-obj as logical   no-undo .
     1087   define variable  p-string-obj            as character no-undo .
     1088   define variable  p-hash-string-obj       as character no-undo .
     1089   define buffer buf_rang-xyz-def     for ub.rang-xyz-def.
     1090   define buffer buf_rang-xyz-def-obj for ub.rang-xyz-def-obj.
     1091   find first buf_rang-xyz-def exclusive-lock where recid(buf_rang-xyz-def) = p-recid no-error .
     1092   if not available buf_rang-xyz-def then do:
     1093       v-exist = false  .
     1094       assign
     1095         p-id = next-value(s-asmt, ub)
     1096         p-db = g#db-num
     1097       .
