     5234                   '      .class1 ' + chr(123) + ' border-collapse: collapse; ' + chr(125) skip
     5235                   '      tbody td, th ' + chr(123) + ' border-collapse: collapse; border: 1px solid black; height: 14px;' + chr(125) skip
     5236                   '   </style>' skip
     5237                   '  </head>' skip
     5238               .
     5239       put stream OutStr-html unformatted
     5240           '<body>' skip
     5241           '<TABLE name="1"  fit_to_page="true" orientation="landscape" CELLSPACING="0" BORDER="0">'skip
     5242           '<thead>' skip
     5243           '<TR class="set_columns">'skip
     5244               '<TD style="width: 60px;"></TD>'skip
     5245               '<TD style="width: 150px;"></TD>'skip
     5246               '<TD style="width: 30px;"></TD>'skip
     5247               '<TD style="width: 60px;"></TD>'skip
     5248               '<TD style="width: 60px;"></TD>'skip
     5249               '<TD style="width: 60px;"></TD>'skip
     5250               '<TD style="width: 80px;"></TD>'skip
     5251               '<TD style="width: 80px;"></TD>'skip
     5252               '<TD style="width: 60px;"></TD>'skip
     5253               '<TD style="width: 60px;"></TD>'skip
     5254               '<TD style="width: 60px;"></TD>'skip
     5255               '<TD style="width: 60px;"></TD>'skip
     5256               '<TD style="width: 60px;"></TD>'skip
     5257               '<TD style="width: 60px;"></TD>'skip
     5258               '<TD style="width: 60px;"></TD>'skip
     5259               '<TD style="width: 60px;"></TD>'skip
     5260               '<TD style="width: 60px;"></TD>'skip
     5261           '</TR>'skip
     5262           '<TR>'skip
     5263               '<TD colspan="17" STYLE="font-size: 14px;">Вн.Код     :' + string(buf_abc-analysis.abc-id) + '</TD>' skip
     5264           '</TR>'skip
     5265           '<TR>'skip
     5266               '<TD colspan="17" STYLE="font-size: 14px;">Название   :' + string(buf_abc-analysis.abc-name) + '</TD>' skip
     5267           '</TR>'skip
     5268           '<TR>'skip
     5269               '<TD colspan="17" STYLE="font-size: 14px;">Критерий   :' + string(buf_criterion-analysis.cral-name) + '</TD>' skip
     5270           '</TR>'skip
     5271           '<TR>'skip
     5272               '<TD colspan="17" STYLE="font-size: 14px;">Коментарии :' + string(buf_abc-analysis.abc-des) + '</TD>' skip
     5273           '</TR>'skip
     5274           '<TR>'skip
     5275               '<TD colspan="17" STYLE="font-size: 14px;">Создание анализа :' + string(buf_abc-analysis.abc-date-create,"99.99.9999") + '' + string(buf_abc-analysis.abc-time-create,"hh:mm") + '' + buf_abc-analysis.abc-who-create + '</TD>' skip
     5276           '</TR>'skip
     5277       .
     5278       define buffer bufp_abc-analysis-obj for ub.abc-analysis-obj.
