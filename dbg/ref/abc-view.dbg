     1349   PROCEDURE find-def-analysis-obj :
     1350   define input  parameter p-type     as character no-undo .
     1351   define input  parameter p-obj-type as character no-undo .
     1352   define input  parameter p-obj-code as integer   no-undo .
     1353   define output parameter p-abc-id   as integer   no-undo .
     1354   define output parameter p-db-num   as integer   no-undo .
     1355     do
     1356     on error undo, return error return-value
     1357     :
     1358     if p-type = "abc"  then do:
     1359         define buffer buf_abc-analysis-obj for ub.abc-analysis-obj  .
     1360         define buffer buf_abc-analysis     for ub.abc-analysis      .
     1361         find first buf_abc-analysis-obj no-lock where
     1362                   buf_abc-analysis-obj.obj-type = p-obj-type and
     1363                   buf_abc-analysis-obj.obj-code = p-obj-code and
     1364                   buf_abc-analysis-obj.is-def   = true use-index objdef no-error .
     1365                   if available buf_abc-analysis-obj then do:
     1366                       p-abc-id = buf_abc-analysis-obj.abc-id .
     1367                       p-db-num = buf_abc-analysis-obj.db-num .
     1368                   end.
     1369                   else do:
     1370                       p-abc-id = 0 .
     1371                       p-db-num = 0.
     1372                       return "На объекте нет анализа по умолчанию" .
     1373                   end.
     1374     end.
     1375     if p-type = "xyz"  then do:
     1376         define buffer buf_xyz-analysis-obj for ub.xyz-analysis-obj  .
     1377         define buffer buf_xyz-analysis     for ub.xyz-analysis      .
     1378         find first buf_xyz-analysis-obj no-lock where
     1379                   buf_xyz-analysis-obj.obj-type = p-obj-type and
     1380                   buf_xyz-analysis-obj.obj-code = p-obj-code and
     1381                   buf_xyz-analysis-obj.is-def   = true use-index objdef no-error .
     1382                   if available buf_xyz-analysis-obj then do:
     1383                       p-abc-id = buf_xyz-analysis-obj.xyz-id .
     1384                       p-db-num = buf_xyz-analysis-obj.db-num .
     1385                   end.
     1386                   else do:
     1387                       p-abc-id = 0 .
     1388                       p-db-num = 0 .
     1389                       return "На объекте нет анализа по умолчанию" .
     1390                   end.
     1391     end.
     1392     return .
     1393   end.
     1394   END PROCEDURE.
     1395   procedure save-def-analysis-obj :
     1396   define input  parameter p-type     as character no-undo .
     1397   define input  parameter p-db-num   as integer   no-undo .
     1398   define input  parameter p-abc-id   as integer   no-undo .
     1399   define output parameter v-log      as logical   no-undo .
     1400     do
     1401     on error undo, return error return-value
     1402     :
     1403     v-log = true .
     1404     if p-type = "abc"  then do:
     1405         define buffer buf_abc-analysis-obj for ub.abc-analysis-obj  .
     1406         define buffer buf_abc-obj          for ub.abc-analysis-obj  .
     1407         define buffer buf_abc-analysis     for ub.abc-analysis      .
     1408         for each buf_abc-obj no-lock where
     1409                  buf_abc-obj.abc-id = p-abc-id and
     1410                  buf_abc-obj.db-num = p-db-num :
     1411               define variable v-exist    as logical   no-undo init false .
     1412               define variable v-list-anal as character no-undo init ""    .
     1413               for each  buf_abc-analysis-obj no-lock where
     1414                         not (buf_abc-analysis-obj.abc-id = p-abc-id and
     1415                              buf_abc-analysis-obj.db-num = p-db-num) and
     1416                         buf_abc-analysis-obj.is-def   = true   and
     1417                         buf_abc-analysis-obj.obj-type = buf_abc-obj.obj-type and
     1418                         buf_abc-analysis-obj.obj-code = buf_abc-obj.obj-code
     1419                         :
     1420                   v-exist    = true .
     1421                   v-list-anal = string( buf_abc-analysis-obj.abc-id ) + "," .
     1422               end.
     1423               if v-exist then do:
     1424                   message "На объекте "
     1425                   buf_abc-obj.obj-type
     1426                   buf_abc-obj.obj-code
     1427                   skip
     1428                   "уже есть анализы по умолчанию , их внутренние номера :" skip
     1429                   v-list-anal                                              skip
     1430                   "Сделать по умолчанию анализ текущий " p-abc-id " ?"
     1431                   view-as alert-box question
     1432                   buttons yes-no update v-log .
     1433                   if v-log then do:
     1434                       for each  buf_abc-analysis-obj exclusive-lock where
     1435                                 buf_abc-analysis-obj.obj-type = buf_abc-obj.obj-type and
     1436                                 buf_abc-analysis-obj.obj-code = buf_abc-obj.obj-code :
     1437                         if ( buf_abc-analysis-obj.abc-id = p-abc-id and
     1438                              buf_abc-analysis-obj.db-num = p-db-num ) then
     1439                                 buf_abc-analysis-obj.is-def   = true .
     1440                         else buf_abc-analysis-obj.is-def   = false  .
     1441                       end.
     1442                   end.
     1443               end.
     1444               else do:
     1445                 for each  buf_abc-analysis-obj exclusive-lock where
     1446                           buf_abc-analysis-obj.obj-type = buf_abc-obj.obj-type and
     1447                           buf_abc-analysis-obj.obj-code = buf_abc-obj.obj-code and
     1448                           buf_abc-analysis-obj.abc-id = p-abc-id and
     1449                           buf_abc-analysis-obj.db-num = p-db-num
     1450                           :
     1451                     buf_abc-analysis-obj.is-def   = true .
     1452                 end.
     1453               end.
     1454         end.
     1455     end.
     1456     if p-type = "xyz"  then do:
     1457         define buffer buf_xyz-analysis-obj for ub.xyz-analysis-obj  .
     1458         define buffer buf_xyz-obj          for ub.xyz-analysis-obj  .
     1459         define buffer buf_xyz-analysis     for ub.xyz-analysis      .
     1460         for each buf_xyz-obj no-lock where
     1461                  buf_xyz-obj.xyz-id = p-abc-id and
     1462                  buf_xyz-obj.db-num = p-db-num :
     1463               v-exist = false .
     1464               v-list-anal = ""    .
     1465               for each  buf_xyz-analysis-obj no-lock where
     1466                         not (buf_xyz-analysis-obj.xyz-id = p-abc-id and
     1467                              buf_xyz-analysis-obj.db-num = p-db-num) and
     1468                         buf_xyz-analysis-obj.is-def   = true   and
     1469                         buf_xyz-analysis-obj.obj-type = buf_xyz-obj.obj-type and
     1470                         buf_xyz-analysis-obj.obj-code = buf_xyz-obj.obj-code
     1471                         :
     1472                   v-exist    = true .
     1473                   v-list-anal = string( buf_xyz-analysis-obj.xyz-id ) + "," .
     1474               end.
     1475               if v-exist then do:
     1476                   message "На объекте "
     1477                   buf_xyz-obj.obj-type
     1478                   buf_xyz-obj.obj-code
     1479                   skip
     1480                   "уже есть анализы по умолчанию , их внутренние номера :" skip
     1481                   v-list-anal                                              skip
     1482                   "Сделать по умолчанию анализ текущий " p-abc-id " ?"
     1483                   view-as alert-box question
     1484                   buttons yes-no update v-log .
     1485                   if v-log then do:
     1486                       for each  buf_xyz-analysis-obj exclusive-lock where
     1487                                 buf_xyz-analysis-obj.obj-type = buf_xyz-obj.obj-type and
     1488                                 buf_xyz-analysis-obj.obj-code = buf_xyz-obj.obj-code :
     1489                         if ( buf_xyz-analysis-obj.xyz-id = p-abc-id and
     1490                              buf_xyz-analysis-obj.db-num = p-db-num ) then
     1491                                 buf_xyz-analysis-obj.is-def   = true .
     1492                         else buf_xyz-analysis-obj.is-def   = false  .
     1493                       end.
     1494                   end.
     1495               end.
     1496               else do:
     1497                 for each  buf_xyz-analysis-obj exclusive-lock where
     1498                           buf_xyz-analysis-obj.obj-type = buf_xyz-obj.obj-type and
     1499                           buf_xyz-analysis-obj.obj-code = buf_xyz-obj.obj-code and
     1500                           buf_xyz-analysis-obj.xyz-id = p-abc-id and
     1501                           buf_xyz-analysis-obj.db-num = p-db-num
     1502                           :
     1503                     buf_xyz-analysis-obj.is-def   = true .
     1504                 end.
     1505               end.
     1506         end.
     1507     end.
     1508   end.
     1509   end procedure.
     1510   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1511   define new shared variable PrintCopiesCounter as integer   no-undo initial 1 .
     1512   define new shared variable RepPathName        as character no-undo .
     1513   define new shared variable PrintRubl          as logical   no-undo .
     1514   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1515   define  stream PrnLibStream.
     1516   procedure prn-lib-prn-file :
     1517     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1518     define input parameter p-DIsabledoptions as integer no-undo .
     1519     define variable v-report-name as character no-undo .
     1520     define variable v-user-action as character no-undo .
     1521     define variable v-printed     as logical   no-undo .
     1522     define variable v-exist       as logical   no-undo .
     1523     do
     1524       on error undo, return error
     1525       :
     1526       run prn-lib-get-report-name  in this-procedure (
     1527         input parParentProc
     1528         ,output v-report-name
     1529         ).
     1530   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1531   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
     1532     (input  v-report-name
     1533     ,input  2
     1534     ,output v-exist
     1535     )  .
     1536       if NOT v-exist then
     1537       DO:
     1538         Message
     1539           "Нет заданий на печать ! "
     1540           view-as alert-box .
     1541         Return  .
     1542       End.
     1543       run gbl/prnfilen.w
     1544         (input  ""
     1545         ,input  p-DisabledOptions
     1546         ,input  string(v-report-name )
     1547         ,input  7
     1548         ,output v-user-action
     1549         ,output v-printed
     1550         ) .
     1551       if v-printed then
     1552       do:
     1553         return "YES" .
     1554       end.
     1555       else
     1556       do:
     1557         return "NO" .
     1558       end.
     1559     end.
     1560   end procedure.
     1561   procedure prn-lib-open-stream :
     1562     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1563     define input parameter p-page-size    as integer no-undo .
     1564     define input parameter p-is-stream    as logical no-undo .
     1565     define input parameter p-append       as logical no-undo .
     1566     define variable v-report-name as character no-undo .
     1567     do
     1568       on error undo, return error
     1569       :
     1570       run prn-lib-get-report-name  in this-procedure (
     1571         input parParentProc
     1572         ,output v-report-name
     1573         ).
     1574       if p-is-stream then
     1575       do:
     1576         if p-append then
     1577         do:
     1578           output stream PrnLibStream to value( v-report-name )
     1579             page-size value(p-page-size) append .
     1580         end.
     1581         if not p-append then
     1582         do:
     1583           output stream PrnLibStream to value( v-report-name )
     1584             page-size value(p-page-size) .
     1585         end.
     1586       end.
     1587       if not p-is-stream then
     1588       do:
     1589         if p-append then
     1590         do:
     1591           output to value( v-report-name )
     1592             page-size value(p-page-size) append .
     1593         end.
     1594         if not p-append then
     1595         do:
     1596           output to value( v-report-name )
     1597             page-size value(p-page-size) .
     1598         end.
     1599       end.
     1600     end.
     1601   end procedure.
     1602   procedure prn-lib-open-exp :
     1603     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1604     define input parameter p-is-stream    as logical no-undo .
     1605     define input parameter p-is-append    as logical no-undo .
     1606     define output parameter p-ReportFileName as char init "report" no-undo.
     1607     define output parameter p-process as logical no-undo .
     1608     define variable glog as logical no-undo .
     1609     do
     1610       on error undo, return error
     1611       :
     1612       SYSTEM-DIALOG GET-FILE p-ReportFileName
     1613         TITLE      "Укажите путь"
     1614         FILTERS "Текстовый файл (*.txt)"   "*.txt"
     1615         ASK-OVERWRITE
     1616         CREATE-TEST-FILE
     1617         SAVE-AS
     1618         USE-FILENAME
     1619         DEFAULT-EXTENSION "txt"
     1620         UPDATE glog
     1621         .
     1622       if not glog then  return.
     1623       p-ReportFileName = trim( string( p-ReportFileName ) ) .
     1624       if p-is-stream then
     1625       do:
     1626         if p-is-append then
     1627         do:
     1628           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1629         end.
     1630         else
     1631         do:
     1632           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1633         end.
     1634       end.
     1635       else
     1636       do:
     1637         if p-is-append then
     1638         do:
     1639           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1640         end.
     1641         else
     1642         do:
     1643           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1644         end.
     1645       end.
     1646       p-process = yes.
     1647     end.
     1648   end procedure.
     1649   procedure prn-lib-get-report-name :
     1650     define input parameter parParentProc  as widget-handle no-undo.
     1651     define output parameter p-report-name as character no-undo .
     1652     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
     1653   end procedure.
     1654   procedure prn-lib-reportviewer-report-name :
     1655     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1656     define input parameter p-report-name-html as character no-undo .
     1657     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
     1658   end procedure.
     1659   procedure prn-lib-reportviewer :
     1660     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1661     define input parameter p-report-name-html as character no-undo .
     1662     define input parameter p-param        as character no-undo .
     1663     define variable v-excel           as character no-undo init 'TRUE' .
     1664     define variable v-value-character as character no-undo .
     1665     define variable v-value-integer   as character no-undo .
     1666     define variable v-value-date      as date      no-undo .
     1667     define variable v-value-decimal   as decimal   no-undo .
     1668     define variable rep-excel         as logical   no-undo .
     1669     define variable excel-string      as character no-undo .
     1670     define variable v-param-type      as character no-undo .
     1671     define variable v-tth             as handle    no-undo .
     1672     run adm/shattri.p (
     1673       input "get":U
     1674       ,input  ""
     1675       ,input  0
     1676       ,input  'report-glob':U
     1677       ,input  'rep-excel':U
     1678       ,output v-value-character
     1679       ,output v-value-date
     1680       ,output v-value-decimal
     1681       ,output v-value-integer
     1682       ,output rep-excel
     1683       ,output v-param-type
     1684       ,INPUT-OUTPUT table-handle v-tth
     1685       )  .
     1686     if rep-excel then v-excel = "TRUE" .
     1687     else v-excel = "FALSE" .
     1688     if p-param eq ""
     1689     then
     1690        p-param = "EXCEL:" + v-excel.
     1691     else
     1692        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
     1693     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
     1694   end procedure.
     1695   def var vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1696   function func-get-name-from-ext-type   returns char
     1697     ( p-ext-type as character   ,
     1698       p-caps     as logical ).
     1699   define variable v-ext-name as character no-undo .
     1700   run get-name-from-ext-type in this-procedure (
     1701       input p-ext-type  ,
     1702       input p-caps  ,
     1703       output v-ext-name )
     1704       no-error .
     1705       if error-status :error then do:
     1706          assign
     1707            v-ext-name = p-ext-type
     1708          .
     1709       end.
     1710    return (v-ext-name) .
     1711   end.
     1712   procedure get-name-from-ext-type :
     1713    do
     1714    on error undo, return error return-value
     1715    :
     1716   define input  parameter p-ext-type as character no-undo .
     1717   define input  parameter p-caps     as logical no-undo   .
     1718   define output parameter p-ext-name as character no-undo .
     1719   define variable v-num as integer no-undo .
     1720     if lookup ( p-ext-type , 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U ) = 0 then do :
     1721       message
     1722         vss-include-info13 skip
     1723         "Неправильно задано значение входящего параметра! "
     1724         "Нет такого типа документов " p-ext-type
     1725         view-as alert-box error .
     1726         undo, return error .
     1727     end.
     1728     v-num      = lookup ( p-ext-type , 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U ) .
     1729     p-ext-name = entry  ( v-num , 'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U ) .
     1730     if p-caps  = true then do :
     1731        p-ext-name = caps(substring(p-ext-name,1,1) ) + substring(p-ext-name, 2 , length (p-ext-name) - 1 ) .
     1732     end .
     1733     end.
     1734   end procedure.
     1735   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
