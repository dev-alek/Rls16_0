        1   DEFINE TEMP-TABLE tt-cash-desk NO-UNDO LIKE ub.cash-desk.
        2   DEFINE INPUT PARAMETER p-templ-rl-root AS integer NO-UNDO.
        3   DEFINE OUTPUT PARAMETER p-pos-type AS CHARACTER NO-UNDO.
        4   define variable vss-revision    as character no-undo init "$Revision$":U .
        5   define variable vss-author      as character no-undo init "$Author$":U .
        6   define variable vss-date        as character no-undo init "$Date$":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        8   define variable vss-archive     as character no-undo init "$Archive$":U .
        9   define variable vss-description as character no-undo init "Выбор места применения".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   procedure proc-alt-shift-f2:
       69     if not ibs.th.gbl.gbl-var:rcode
       70   then
       71     run gbl\inidebug.p .
       72   end.
       73   procedure proc-alt-shift-f3:
       74     run gbl/prvssinf.p
       75       ( input this-procedure
       76       ) .
       77   end.
       78   define variable v-inform-launched as logical no-undo initial false .
       79   procedure proc-alt-shift-f4:
       80     define variable v-action as character no-undo .
       81     if v-inform-launched = false then do:
       82       assign
       83         v-inform-launched = true
       84       .
       85       run gbl/d-inform.w
       86         (  input self
       87         ,  input this-procedure
       88         , output v-action
       89         ) no-error .
       90       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       91       assign
       92         v-inform-launched = false
       93       .
       94     end.
       95   end.
       96   procedure proc-alt-f1:
       97     run gbl/corrhelp.p
       98       (input this-procedure
       99       ) .
      100   end .
      101   on alt-shift-f2 anywhere do:
      102     run proc-alt-shift-f2.
      103   end.
      104   on alt-shift-f3 anywhere do:
      105     run proc-alt-shift-f3 in this-procedure .
      106   end.
      107   on alt-shift-f4 anywhere do:
      108     run proc-alt-shift-f4 in this-procedure.
      109   end.
      110   on alt-f1 anywhere do:
      111     run proc-alt-f1 in this-procedure .
      112   end.
      113   DEFINE BUTTON B-exit AUTO-GO
      114        LABEL "&Ввод"
      115        SIZE 10 BY 1
      116        BGCOLOR 8 .
      117   DEFINE BUTTON B-Help
      118        LABEL "Помо&щь"
      119        SIZE 10 BY 1
      120        BGCOLOR 8 .
      121   DEFINE BUTTON b-quit AUTO-END-KEY
      122        LABEL "&Отмена"
      123        SIZE 10 BY 1
      124        BGCOLOR 8 .
      125   DEFINE VARIABLE CB-dflt-cd AS CHARACTER FORMAT "X(20)"
      126        VIEW-AS COMBO-BOX INNER-LINES 7
      127        LIST-ITEM-PAIRS "1","1",
      128                        "2","2",
      129                        "3","3",
      130                        "4","4",
      131                        "5","5",
      132                        "6","6",
      133                        "7","7"
      134        DROP-DOWN-LIST
      135        SIZE 15 BY .93
      136        BGCOLOR 15 FGCOLOR 0 .
      137   DEFINE QUERY Dialog-Frame FOR
      138         tt-cash-desk SCROLLING.
      139   DEFINE FRAME Dialog-Frame
      140        B-exit AT ROW 1 COL 1
      141        b-quit AT ROW 1 COL 11
      142        B-Help AT ROW 1 COL 54.9
      143        CB-dflt-cd AT ROW 3.13 COL 11.5 COLON-ALIGNED NO-LABEL
      144        SPACE(38.59) SKIP(1.33)
      145       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      146            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      147            TITLE "Выбор места применения"
      148            DEFAULT-BUTTON B-exit CANCEL-BUTTON b-quit.
      149   ASSIGN
      150          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      151          FRAME Dialog-Frame:HIDDEN           = TRUE.
      152   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      153   DO:
      154     APPLY "END-ERROR":U TO SELF.
      155   END.
      156   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
      157   DO:
      158     ASSIGN
      159     CB-dflt-cd.
      160     IF cb-dflt-cd = '':U THEN DO:
      161       MESSAGE
      162       "Вы не выбрали тип кассы!"
      163       VIEW-AS ALERT-BOX ERROR.
      164       undo, RETURN NO-APPLY.
      165     END.
      166     p-pos-type = cb-dflt-cd.
      167   END.
      168   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      169   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      170   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      171   on help of frame Dialog-Frame
      172   do:
      173     run gbl/app_help.p
      174       (input this-procedure :file-name
      175       ,input ''
      176       ,input ?
      177       ) no-error.
      178     if error-status :error then do:
      179       message
      180         "Ошибка при вызове помощи"
      181         error-status :get-message(1)
      182         view-as alert-box .
      183     end.
      184   end.
      185   run minbtn-set in this-procedure .
      186   on choose of b-help in frame Dialog-Frame
      187   do:
      188     apply "help":u to frame Dialog-Frame .
      189   end.
      190   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      191   procedure minbtn-set :
      192       do
      193           on error undo, return error return-value
      194           :
      195           define variable ii              as integer       no-undo .
      196           define variable fh              as widget-handle no-undo .
      197           define variable hh              as widget-handle no-undo .
      198           define variable v-h             as handle        extent 4 no-undo .
      199           define variable v-name-button   as character     no-undo .
      200           define variable v-help-old-x    as decimal       no-undo .
      201           define variable v-help-old-y    as decimal       no-undo .
      202           define variable v-help-old-size as decimal       no-undo .
      203           define variable v-frame-width   as decimal       no-undo .
      204           define variable jj              as integer       no-undo .
      205           do
      206               on error undo, return error
      207               :
      208               assign
      209                   v-frame-width = frame Dialog-Frame:width - 0.3
      210                   fh            = frame Dialog-Frame:first-child
      211                   hh            = fh:first-child
      212                   ii            = 1
      213                   .
      214               do while valid-handle(hh):
      215                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      216                   do:
      217                       case lc(hh:name) :
      218                           when "b-help" then
      219                               do:
      220                                   hh:load-image-up("cmp/b-help.bmp":u) .
      221                                   hh:load-image-down("cmp/b-help.bmp":u) .
      222                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      223                                   hh:TOOLTIP = "Помощь" .
      224                                   v-help-old-x = hh:column .
      225                                   v-help-old-y = hh:row    .
      226                                   v-help-old-size = hh:width .
      227                                   hh:width-chars = 2.5 .
      228                               end.
      229                           when "b-print" then
      230                               do:
      231                                   hh:load-image("cmp/b-print.bmp":u) .
      232                                   hh:TOOLTIP = "Печать" .
      233                                   v-h[ii] = hh:handle .
      234                                   ii = ii + 1 .
      235                                   hh:width-chars = 3 .
      236                               end.
      237                           when "b-history" or
      238                           when "b-hist" then
      239                               do:
      240                                   hh:load-image("cmp/b-hist.bmp":u) .
      241                                   hh:TOOLTIP = "История" .
      242                                   v-h[ii] = hh:handle .
      243                                   ii = ii + 1 .
      244                                   hh:width-chars = 3 .
      245                               end.
      246                           when "b-sch" then
      247                               do:
      248                                   hh:load-image("cmp/b-sch.bmp":u) .
      249                                   hh:TOOLTIP = "Установка Фильтра" .
      250                                   v-h[ii] = hh:handle .
      251                                   ii = ii + 1 .
      252                                   hh:width-chars = 3 .
      253                               end.
      254                           when "b-hist-user" then
      255                               do:
      256                                   hh:load-image("cmp/b-hist.bmp":u) .
      257                                   hh:TOOLTIP = "История пользователя" .
      258                                   ii = ii + 1 .
      259                               end.
      260                       end case.
      261                   end.
      262                   hh = hh:next-sibling.
      263               end.
      264               b-help:column = v-frame-width - b-help:width-chars.
      265               jj = 0.
      266               repeat ii = 4 to 1 by -1 :
      267                   if valid-handle (v-h[ii] ) then
      268                   do:
      269                       jj  = jj + 1 .
      270                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      271                       v-h[ii]:row    = v-help-old-y .
      272                   end.
      273               end.
      274           end.
      275       end.
      276   end procedure.
      277   MAIN-BLOCK:
      278   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      279      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      280     RUN Myenable.
      281     WAIT-FOR GO OF FRAME Dialog-Frame.
      282   END.
      283   RUN disable_UI.
      284   PROCEDURE disable_UI :
      285     HIDE FRAME Dialog-Frame.
      286   END PROCEDURE.
      287   PROCEDURE enable_UI :
      288     OPEN QUERY Dialog-Frame FOR EACH tt-cash-desk SHARE-LOCK.
      289     GET FIRST Dialog-Frame.
      290     DISPLAY CB-dflt-cd
      291         WITH FRAME Dialog-Frame.
      292     ENABLE B-exit b-quit B-Help CB-dflt-cd
      293         WITH FRAME Dialog-Frame.
      294     VIEW FRAME Dialog-Frame.
      295   END PROCEDURE.
      296   PROCEDURE MyEnable :
      297   DEFINE VARIABLE v-list-items AS CHARACTER NO-UNDO.
      298   DEFINE VARIABLE v-ii         AS INTEGER   NO-UNDO.
      299   DEFINE BUFFER buf_dis-cfg-rule FOR ub.dis-cfg-rule.
      300   _v-ii:
      301   DO v-ii = 1 TO NUM-ENTRIES('IBM-XML,Autotank,IBM,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,r-keeper,MARIA,-,bo':U):
      302      IF p-templ-rl-root > 0  THEN DO:
      303      FIND FIRST buf_dis-cfg-rule NO-LOCK WHERE
      304               buf_dis-cfg-rule.templ-rl-root  = p-templ-rl-root
      305          AND  buf_dis-cfg-rule.pos-type  = ENTRY(v-ii, 'IBM-XML,Autotank,IBM,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,r-keeper,MARIA,-,bo':U) NO-ERROR.
      306      iF NOT AVAILABLE buf_dis-cfg-rule THEN NEXT _v-ii.
      307      END.
      308      ASSIGN
      309       v-list-items = v-list-items +  (IF v-list-items = '':U THEN '':U ELSE chr(44)) +
      310                      ENTRY(v-ii, 'IBM-XML,Autotank,IBM,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,R-KEEPER,MARIA,Накладная,Бэкофис':U) + chr(44) +
      311                      ENTRY(v-ii, 'IBM-XML,Autotank,IBM,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,r-keeper,MARIA,-,bo':U).
      312   END.
      313   assign
      314   cb-dflt-cd:list-item-pairs in frame Dialog-Frame = v-list-items.
      315   DISPLAY CB-dflt-cd
      316   WITH FRAME Dialog-Frame.
      317   ENABLE
      318   B-exit
      319   b-quit
      320   B-Help
      321   CB-dflt-cd
      322   WITH FRAME Dialog-Frame.
      323   VIEW FRAME Dialog-Frame.
      324   END PROCEDURE.
