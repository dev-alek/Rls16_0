        1   block-level on error undo, throw.
        2   define input-output parameter par-rid as recid no-undo .
        3   define input parameter par-mode as character no-undo .
        4   define input parameter p-db-num like ub.fbr-prn.db-num no-undo .
        5   define input parameter p-prn-num like ub.fbr-prn.prn-num no-undo .
        6   define input parameter p-prn-type like ub.fbr-prn.prn-type no-undo .
        7   define input parameter p-prn-name like ub.fbr-prn.prn-name no-undo .
        8   define input parameter p-fbr-obj-type like ub.fbr-prn.fbr-obj-type no-undo .
        9   define input parameter p-fbr-obj-code like ub.fbr-prn.fbr-obj-code no-undo .
       10   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       11   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       12   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       13   define variable vss-workfile    as character no-undo init "$Workfile: fbrprn01.p $":U .
       14   define variable vss-archive     as character no-undo init "$Archive: ref/fbrprn01.p $":U .
       15   define variable vss-description as character no-undo init "Сохранение изменений в карточке принтера кухни".
       16   procedure vss-get-info :
       17     define output parameter p-vss-revision    like vss-revision    no-undo .
       18     define output parameter p-vss-author      like vss-author      no-undo .
       19     define output parameter p-vss-date        like vss-date        no-undo .
       20     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       21     define output parameter p-vss-archive     like vss-archive     no-undo .
       22     define output parameter p-vss-description like vss-description no-undo .
       23     assign
       24       p-vss-revision    = vss-revision
       25       p-vss-author      = vss-author
       26       p-vss-date        = vss-date
       27       p-vss-workfile    = vss-workfile
       28       p-vss-archive     = vss-archive
       29       p-vss-description = vss-description
       30     .
       31   end procedure.
       32   procedure vss-get-parameters :
       33     define output parameter p-vss-parameters as character no-undo .
       34   end procedure.
       35   define new global shared variable g#vssrevis-logger as handle    no-undo .
       36   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       37   define variable v-vssrevis-logger                   as handle    no-undo .
       38   procedure vss-logevent :
       39     define input  parameter p-extra-paramters as character no-undo .
       40     define variable v-vssrevis-parameters as character no-undo .
       41     do
       42     on error undo, return error return-value
       43     :
       44       if  valid-handle(v-vssrevis-logger)
       45       and v-vssrevis-logger :get-signature("logevent") <> ""
       46       then do:
       47         run vss-get-parameters in this-procedure
       48           (output v-vssrevis-parameters
       49           ).
       50         run logevent in v-vssrevis-logger
       51           (input vss-workfile
       52           ,input vss-revision
       53           ,input v-vssrevis-parameters
       54           ,input p-extra-paramters
       55           ).
       56       end.
       57     end.
       58   end procedure.
       59   assign
       60     v-vssrevis-logger = g#vssrevis-logger
       61   .
       62   if  valid-handle(v-vssrevis-logger)
       63   and v-vssrevis-logger :get-signature("logevent") <> ""
       64   then do:
       65     assign
       66       v-vssrevis-logevent = true
       67     .
       68     run vss-logevent in this-procedure (input vss-description) .
       69   end.
       70   define new global shared variable g#language as character no-undo .
       71   if g#language <> '' and g#language <> 'rus':U then do:
       72     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       73   end.
       74   define variable var-entry as character no-undo .
       75   define buffer buf_fbr-prn for ub.fbr-prn .
       76   if par-mode <> 'ДОБАВЛЕНИЕ':U AND par-mode <> 'ИЗМЕНЕНИЕ':U then do:
       77     message vss-workfile vss-revision vss-description skip
       78             "Неверный параметр par-mode - " par-mode
       79     view-as alert-box error .
       80     return error '':u.
       81   end.
       82   if p-prn-num = 0 then do:
       83     assign
       84     var-entry = "prn-num":U
       85     .
       86     message
       87     "Укажите номер принтера"
       88     view-as alert-box error .
       89     return error var-entry.
       90   end.
       91   if p-prn-type = "":u then do:
       92     assign
       93     var-entry = "prn-type":U
       94     .
       95     message
       96     "Укажите тип принтера"
       97     view-as alert-box error .
       98     return error var-entry.
       99   end.
      100   if p-prn-name = "":u then do:
      101     assign
      102     var-entry = "prn-name":U
      103     .
      104     message
      105     "Укажите название принтера"
      106     view-as alert-box error .
      107     return error var-entry.
      108   end.
      109   if LOOKUP(p-fbr-obj-type, ('маг':U + chr(44) + 'скл':U)) = 0 then do:
      110     assign
      111     var-entry = "obj-type":U
      112     .
      113     message
      114     "Объект, на котором установлен принтер, может быть только " 'маг':U "или" 'скл':U
      115     view-as alert-box error .
      116     return error var-entry.
      117   end.
      118   find first ub.clients no-lock where
      119              ub.clients.obj-type = p-fbr-obj-type
      120         AND ub.clients.obj-code = p-fbr-obj-code no-error .
      121   if not available ub.clients then do:
      122     assign
      123     var-entry = "fbr-obj-code"
      124     .
      125     message
      126     "Укажите объект, на которой установлен принтер"
      127     view-as alert-box error .
      128     return error var-entry.
      129   end.
      130   _main:
      131   do
      132   on error undo _main, return error
      133   :
      134     CASE par-mode:
      135       when 'ДОБАВЛЕНИЕ':U then do:
      136         find first buf_fbr-prn no-lock where
      137                    buf_fbr-prn.db-num = p-db-num
      138                AND buf_fbr-prn.prn-num = p-prn-num no-error .
      139         if available buf_fbr-prn then do:
      140           assign
      141           var-entry = "p-prn-num"
      142           .
      143           message
      144           "Уже есть принтер кухни с номером" p-prn-num skip
      145           "в БД" p-db-num
      146           view-as alert-box error .
      147           return error var-entry.
      148         end.
      149         create ub.fbr-prn.
      150       end.
      151       when 'ИЗМЕНЕНИЕ':U then do:
      152         find first ub.fbr-prn exclusive-lock where
      153                   recid(ub.fbr-prn) = par-rid no-error .
      154         if not available ub.fbr-prn
      155         then do:
      156           assign
      157           var-entry = "prn-num":U
      158           .
      159           message
      160           "Нет принтера кухни с номером" p-prn-num skip
      161           "в БД" p-db-num
      162           view-as alert-box error .
      163           return error var-entry.
      164         end.
      165         IF ub.fbr-prn.db-num <> p-db-num
      166         OR ub.fbr-prn.prn-num <> p-prn-num
      167         then do:
      168           assign
      169           var-entry = "prn-num":U
      170           .
      171           message
      172           "Нельзя изменить номер принтера"  skip
      173           "в БД" p-db-num
      174           view-as alert-box error .
      175           return error var-entry.
      176         end.
      177       end.
      178     END CASE.
      179     assign
      180     ub.fbr-prn.db-num = p-db-num
      181     ub.fbr-prn.prn-num = p-prn-num
      182     ub.fbr-prn.prn-name = p-prn-name
      183     ub.fbr-prn.prn-type = p-prn-type
      184     ub.fbr-prn.fbr-obj-type = p-fbr-obj-type
      185     ub.fbr-prn.fbr-obj-code = p-fbr-obj-code
      186     par-rid = recid(ub.fbr-prn)
      187     .
      188   end.
