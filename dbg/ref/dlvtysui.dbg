      205   ON CHOOSE OF B-deliv-subj IN FRAME Dialog-Frame
      206   DO:
      207      define variable v-rid-list as character no-undo.
      208      define variable v-sts as integer no-undo .
      209   define variable vss-include-info0 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      210   if lookup(self :type
      211            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      212            ) = 0
      213   then do:
      214     message
      215       "$Workfile$"
      216       "Указанному интерфейсному элементу фокус не может быть передан" skip
      217       "Интерфейсный элемент" self :name  skip
      218       "Тип" self :type  skip
      219       "Процедура" this-procedure :file-name skip
      220       view-as alert-box .
      221   end.
      222   else do:
      223     apply "entry":u to self  .
      224     if focus :handle <> self :handle  then do:
      225       return no-apply .
      226     end.
      227   end.
      228   if available locked_delivery-subject then
      229   assign
      230   v-rid-list = string(recid(locked_delivery-subject))
      231   v-sts = locked_delivery-subject.sts
      232   .
      233   run ref/dlvsubjs.w (input parParentProc
      234                 , p-curr-obj-type
      235                 , p-curr-obj-code
      236                 , "b-sel":U
      237                 , 'все':U
      238                 , input-output v-sts
      239                 , input-output v-rid-list ) no-error .
      240   if v-rid-list <> "":U then do:
      241       FIND FIRST locked_delivery-subject WHERE
      242           recid( locked_delivery-subject ) = integer(entry(1, v-rid-list)) NO-LOCK .
      243       assign
      244       tt-delivery-type-subject.deliv-subj-code = locked_delivery-subject.deliv-subj-code
      245       f-deliv-subj-name = locked_delivery-subject.deliv-subj-name
      246   .
      247       display
      248       tt-delivery-type-subject.deliv-subj-code
      249       f-deliv-subj-name
      250       with frame Dialog-Frame .
      251   end.
      252   END.
      253   ON CHOOSE OF B-deliv-type IN FRAME Dialog-Frame
      254   DO:
      255     define variable v-rid-list as character no-undo.
      256     define variable v-sts as integer no-undo .
      257   define variable vss-include-info1 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      258   if lookup(self :type
      259            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      260            ) = 0
      261   then do:
      262     message
      263       "$Workfile$"
      264       "Указанному интерфейсному элементу фокус не может быть передан" skip
      265       "Интерфейсный элемент" self :name  skip
      266       "Тип" self :type  skip
      267       "Процедура" this-procedure :file-name skip
      268       view-as alert-box .
      269   end.
      270   else do:
      271     apply "entry":u to self  .
      272     if focus :handle <> self :handle  then do:
      273       return no-apply .
      274     end.
      275   end.
      276   if available locked_delivery-type then
      277   assign
      278   v-rid-list = string(recid(locked_delivery-type))
      279   v-sts = locked_delivery-type.sts
      280   .
      281   run ref/dlvtypes.w (input parParentProc
      282                 , p-curr-obj-type
      283                 , p-curr-obj-code
      284                 , "b-sel":U
      285                 , 'все':U
      286                 , input-output v-sts
      287                 , input-output v-rid-list ) no-error .
      288   if v-rid-list <> "":U then do:
      289       FIND FIRST locked_delivery-type WHERE
      290           recid( locked_delivery-type ) = integer(entry(1, v-rid-list)) NO-LOCK .
      291       assign
      292       tt-delivery-type-subject.deliv-type-code = locked_delivery-type.deliv-type-code
      293       f-deliv-type-name = locked_delivery-type.deliv-type-name
      294   .
      295       display
