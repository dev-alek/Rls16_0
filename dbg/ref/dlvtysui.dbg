      297       f-deliv-type-name
      298       with frame Dialog-Frame .
      299   end.
      300   END.
      301   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
      302   DO:
      303       run proc-save in this-procedure no-error.
      304     if error-status:error then return no-apply.
      305   END.
      306   ON CHOOSE OF B-Hist IN FRAME Dialog-Frame
      307   DO:
      308     define variable v-rid-list as character no-undo.
      309       run ref/dlvctyss.w
      310                   (
      311                    input parParentProc
      312                   ,INPUT p-curr-obj-type
      313                   ,INPUT p-curr-obj-code
      314                   ,input "":U
      315                   ,input "one":U
