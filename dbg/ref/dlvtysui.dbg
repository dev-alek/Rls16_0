      322   ON LEAVE OF tt-delivery-type-subject.deliv-subj-code IN FRAME Dialog-Frame
      323   DO:
      324    assign
      325   tt-delivery-type-subject.deliv-subj-code.
      326   FIND FIRST locked_delivery-subject WHERE
      327            locked_delivery-subject.deliv-subj-code  = tt-delivery-type-subject.deliv-subj-code
      328    NO-LOCK NO-error.
      329   if not available locked_delivery-subject then do:
      330     assign
      331     tt-delivery-type-subject.deliv-subj-code = ?
      332     f-deliv-subj-name = "":U
      333     .
      334       display
      335       tt-delivery-type-subject.deliv-subj-code
      336       f-deliv-subj-name
      337       with frame Dialog-Frame.
      338       .
      339   end.
      340   else do:
      341       assign
      342       f-deliv-subj-name = locked_delivery-subject.deliv-subj-name
      343       .
      344       display
      345       tt-delivery-type-subject.deliv-subj-code
      346       f-deliv-subj-name
      347       with frame Dialog-Frame.
      348       .
      349   end.
      350   END.
      351   ON LEAVE OF tt-delivery-type-subject.deliv-type-code IN FRAME Dialog-Frame
      352   DO:
      353     assign
      354   tt-delivery-type-subject.deliv-type-code.
      355   FIND FIRST locked_delivery-type WHERE
      356            locked_delivery-type.deliv-type-code  = tt-delivery-type-subject.deliv-type-code
      357    NO-LOCK NO-error.
      358   if not available locked_delivery-type then do:
      359     assign
      360     tt-delivery-type-subject.deliv-type-code = ?
      361     f-deliv-type-name = "":U
      362     .
      363       display
      364       tt-delivery-type-subject.deliv-type-code
      365       f-deliv-type-name
      366       with frame Dialog-Frame.
      367       .
      368   end.
      369   else do:
      370       assign
      371       f-deliv-type-name = locked_delivery-type.deliv-type-name
      372       .
      373       display
      374       tt-delivery-type-subject.deliv-type-code
      375       f-deliv-type-name
      376       with frame Dialog-Frame.
      377       .
      378   end.
      379   END.
      380   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      381   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      382   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      383   on help of frame Dialog-Frame
      384   do:
      385     run gbl/app_help.p
      386       (input this-procedure :file-name
      387       ,input ''
      388       ,input ?
      389       ) no-error.
      390     if error-status :error then do:
      391       message
      392         "Ошибка при вызове помощи"
      393         error-status :get-message(1)
      394         view-as alert-box .
      395     end.
      396   end.
      397   run minbtn-set in this-procedure .
      398   on choose of b-help in frame Dialog-Frame
      399   do:
      400     apply "help":u to frame Dialog-Frame .
      401   end.
      402   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      403   procedure minbtn-set :
      404       do
      405           on error undo, return error return-value
      406           :
      407           define variable ii              as integer       no-undo .
      408           define variable fh              as widget-handle no-undo .
      409           define variable hh              as widget-handle no-undo .
      410           define variable v-h             as handle        extent 4 no-undo .
      411           define variable v-name-button   as character     no-undo .
      412           define variable v-help-old-x    as decimal       no-undo .
      413           define variable v-help-old-y    as decimal       no-undo .
      414           define variable v-help-old-size as decimal       no-undo .
      415           define variable v-frame-width   as decimal       no-undo .
      416           define variable jj              as integer       no-undo .
      417           do
      418               on error undo, return error
      419               :
      420               assign
      421                   v-frame-width = frame Dialog-Frame:width - 0.3
      422                   fh            = frame Dialog-Frame:first-child
      423                   hh            = fh:first-child
      424                   ii            = 1
      425                   .
      426               do while valid-handle(hh):
      427                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      428                   do:
      429                       case lc(hh:name) :
      430                           when "b-help" then
      431                               do:
      432                                   hh:load-image-up("cmp/b-help.bmp":u) .
      433                                   hh:load-image-down("cmp/b-help.bmp":u) .
      434                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      435                                   hh:TOOLTIP = "Помощь" .
      436                                   v-help-old-x = hh:column .
      437                                   v-help-old-y = hh:row    .
      438                                   v-help-old-size = hh:width .
      439                                   hh:width-chars = 2.5 .
      440                               end.
      441                           when "b-print" then
      442                               do:
      443                                   hh:load-image("cmp/b-print.bmp":u) .
      444                                   hh:TOOLTIP = "Печать" .
      445                                   v-h[ii] = hh:handle .
      446                                   ii = ii + 1 .
      447                                   hh:width-chars = 3 .
      448                               end.
      449                           when "b-history" or
      450                           when "b-hist" then
      451                               do:
      452                                   hh:load-image("cmp/b-hist.bmp":u) .
      453                                   hh:TOOLTIP = "История" .
      454                                   v-h[ii] = hh:handle .
      455                                   ii = ii + 1 .
      456                                   hh:width-chars = 3 .
      457                               end.
      458                           when "b-sch" then
      459                               do:
      460                                   hh:load-image("cmp/b-sch.bmp":u) .
      461                                   hh:TOOLTIP = "Установка Фильтра" .
      462                                   v-h[ii] = hh:handle .
      463                                   ii = ii + 1 .
      464                                   hh:width-chars = 3 .
      465                               end.
      466                           when "b-hist-user" then
      467                               do:
      468                                   hh:load-image("cmp/b-hist.bmp":u) .
      469                                   hh:TOOLTIP = "История пользователя" .
      470                                   ii = ii + 1 .
      471                               end.
      472                       end case.
      473                   end.
      474                   hh = hh:next-sibling.
      475               end.
      476               b-help:column = v-frame-width - b-help:width-chars.
      477               jj = 0.
      478               repeat ii = 4 to 1 by -1 :
      479                   if valid-handle (v-h[ii] ) then
      480                   do:
      481                       jj  = jj + 1 .
      482                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      483                       v-h[ii]:row    = v-help-old-y .
      484                   end.
      485               end.
      486           end.
      487       end.
      488   end procedure.
      489   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      490   ON TAB ANYWHERE
      491   DO:
      492   define variable ii as integer no-undo .
      493   define variable fh as widget-handle no-undo .
      494   define variable hh as widget-handle no-undo .
      495   define variable v-next-widget-name as character no-undo .
      496   if v-tab-order <> '' then do:
      497     if self:type = "TOGGLE-BOX" then
      498     self:BGCOLOR = ?.
      499     assign
      500     ii = lookup(self:name, v-tab-order).
      501     assign
      502     ii = ii + 1
      503     v-next-widget-name = entry(ii, v-tab-order)
      504     no-error .
      505     if error-status:error then do:
      506       assign
      507       ii = 1
      508       v-next-widget-name = entry( ii, v-tab-order)
      509       .
      510     end.
      511     assign
      512     fh = frame Dialog-Frame:first-child
      513     hh = fh:first-child
      514     .
      515     do while valid-handle(hh):
      516       if hh:name = v-next-widget-name then do:
      517         if hh:sensitive  = yes
      518         AND hh:visible = yes then do:
      519           APPLY "ENTRY" to hh.
      520           return no-apply.
      521         end.
      522         else do:
      523           APPLY "TAB" to hh.
      524           return no-apply.
      525         end.
      526       end.
      527       hh = hh:next-sibling.
      528     end.
      529   end.
      530   END.
      531   ON BACK-TAB ANYWHERE
      532   DO:
      533   define variable ii as integer no-undo .
      534   define variable fh as widget-handle no-undo .
      535   define variable hh as widget-handle no-undo .
      536   define variable v-next-widget-name as character no-undo .
      537   if v-tab-order <> '' then do:
      538     assign
      539     ii = lookup(self:name, v-tab-order).
      540     .
      541     assign
      542     ii = (if ii = 1
      543           then  num-entries(v-tab-order)
      544           else ii - 1
      545           )
      546     v-next-widget-name = entry(ii, v-tab-order)
      547     .
      548     assign
      549     fh = frame Dialog-Frame:first-child
      550     hh = fh:first-child
      551     .
      552     do while valid-handle(hh):
      553       if hh:name = v-next-widget-name then do:
      554         if hh:sensitive  = yes
      555         AND hh:visible = yes then do:
      556           APPLY "ENTRY" to hh.
      557           return no-apply.
      558         end.
      559         else do:
      560         APPLY "BACK-TAB" to hh.
      561         return no-apply.
      562         end.
      563       end.
      564       hh = hh:next-sibling.
      565     end.
      566     end.
      567   END.
      568   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      569   ON RETURN ANYWHERE
      570   DO:
      571   define variable ii as integer no-undo .
      572   define variable fh as widget-handle no-undo .
      573   define variable hh as widget-handle no-undo .
      574   define variable v-next-widget-name as character no-undo .
      575     if v-tab-order <> '' then do:
      576       assign
      577       ii = lookup(self:name, v-tab-order).
      578       if ii = num-entries(v-tab-order) then do:
      579           APPLY 'CHOOSE' TO b-exit in frame Dialog-Frame.
      580           return no-apply.
      581       end.
      582       if self:type <> "BUTTON" and
      583         self:type <> "EDITOR"  then do:
      584         run proc-move-forward in this-procedure .
      585         return no-apply.
      586       end.
      587       if self:type = "BUTTON" then do:
      588         APPLY "CHOOSE" to self.
      589       end.
      590       if self:type = "TOGGLE-BOX" then
      591       self:BGCOLOR = ?.
      592       assign
      593       ii = ii + 1
      594       v-next-widget-name = entry(ii, v-tab-order)
      595       no-error .
      596       if error-status:error then do:
      597         assign
      598         ii = 1
      599         v-next-widget-name = entry( ii, v-tab-order)
      600         .
      601       end.
      602       assign
      603       fh = frame Dialog-Frame:first-child
      604       hh = fh:first-child
      605       .
      606       do while valid-handle(hh):
      607         if hh:name = v-next-widget-name then do:
      608           if hh:sensitive  = yes
      609           AND hh:visible = yes then do:
      610             if hh:type = "TOGGLE-BOX":U then do:
      611               assign
      612               hh:BGcolor = 1
      613               .
      614             end.
      615             APPLY "ENTRY" to hh.
      616             return no-apply.
      617           end.
      618           else do:
      619             APPLY "TAB" to hh.
      620             return no-apply.
      621           end.
      622         end.
      623         hh = hh:next-sibling.
      624       end.
      625     end.
      626   END.
      627   procedure proc-move-forward :
      628   define variable ii as integer no-undo .
      629   define variable fh as widget-handle no-undo .
      630   define variable hh as widget-handle no-undo .
      631   define variable v-next-widget-name as character no-undo .
      632   do
      633   on error undo, return error
      634   :
      635     if v-tab-order <> '' then do:
      636       if self:type = "TOGGLE-BOX" then
      637       self:BGCOLOR = ?.
      638       assign
      639       ii = lookup(self:name, v-tab-order).
      640       assign
      641       ii = ii + 1
      642       v-next-widget-name = entry(ii, v-tab-order)
      643       no-error .
      644       if error-status:error then do:
      645         assign
      646         ii = 1
      647         v-next-widget-name = entry( ii, v-tab-order)
      648         .
      649       end.
      650       assign
      651       fh = frame Dialog-Frame:first-child
      652       hh = fh:first-child
      653       .
      654       do while valid-handle(hh):
      655         if hh:name = v-next-widget-name then do:
      656           if hh:sensitive  = yes
      657           AND hh:visible = yes then do:
      658             if hh:type = "TOGGLE-BOX":U then do:
      659               assign
      660               hh:BGcolor = 1
      661               .
      662             end.
      663             APPLY "ENTRY" to hh.
      664             return.
      665           end.
      666           else do:
      667             assign
      668             ii = ii + 1
      669             v-next-widget-name = entry(ii, v-tab-order)
      670             no-error .
      671             if error-status:error then do:
      672               assign
      673               ii = 1
      674               v-next-widget-name = entry( ii, v-tab-order)
      675               .
      676             end.
      677           end.
      678         end.
      679         hh = hh:next-sibling.
      680       end.
      681     end.
      682   end.
      683   end procedure.
      684   MAIN-BLOCK:
      685   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      686      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      687    if p-mode  <> 'ДОБАВЛЕНИЕ':U
      688    and p-mode <> 'ИЗМЕНЕНИЕ':U
      689    and p-mode <> 'ПРОСМОТР':U
      690    then do:
      691       message
      692       vss-workfile vss-revision vss-description skip
      693       "Неверное значение параметров вызова p-mode"  p-mode
      694       view-as alert-box ERROR.
      695       undo, return error.
      696    end.
      697      find first X_curr_clients no-lock where
      698               X_curr_clients.obj-type = p-curr-obj-type
      699          AND X_curr_clients.obj-code = p-curr-obj-code no-error.
      700     if not available X_curr_clients then do:
      701       message
      702       vss-workfile vss-revision vss-description skip
      703       "Неверное значение параметра вызова p-curr-obj-type p-curr-obj-code"
      704       p-curr-obj-type p-curr-obj-code
      705       view-as alert-box ERROR.
      706       return error .
      707     end.
      708   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      709   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
      710     (output v-db-num
      711     )  .
      712   IF v-db-num <> 0
      713   AND (p-mode = 'ДОБАВЛЕНИЕ':U
      714        OR p-mode = 'ИЗМЕНЕНИЕ':U ) THEN DO:
      715       message
      716       vss-workfile vss-revision vss-description skip
      717       "Неверное значение параметра вызова p-mode" p-mode skip
      718       "Нельзя редактировать запись ТИП ДОСТАВКИ ОТ СУБЪЕКТОВ в УБД"
      719       view-as alert-box ERROR.
      720       return error .
      721   END.
      722     for each tt-delivery-type:
      723       delete tt-delivery-type.
      724     end.
      725     for each tt-delivery-subject:
      726       delete tt-delivery-subject.
      727     end.
      728     for each tt-delivery-type-subject:
      729       delete tt-delivery-type-subject.
      730     end.
      731   IF p-deliv-type-code <> 0  OR p-mode <> 'ДОБАВЛЕНИЕ':U THEN DO:
      732       IF p-mode = 'ДОБАВЛЕНИЕ':U OR p-mode = 'ИЗМЕНЕНИЕ':U  THEN DO:
      733         FIND FIRST LOCKED_delivery-type EXCLUSIVE-LOCK WHERE
      734                   LOCKED_delivery-type.deliv-type-code = p-deliv-type-code NO-ERROR.
      735       END.
      736       IF p-mode = 'ПРОСМОТР':U THEN DO:
      737           FIND FIRST LOCKED_delivery-type no-lock WHERE
      738                           LOCKED_delivery-type.deliv-type-code = p-deliv-type-code NO-ERROR.
      739      END.
      740      IF (p-mode = 'ДОБАВЛЕНИЕ':U
      741       OR p-mode = 'ИЗМЕНЕНИЕ':U )
      742       AND NOT AVAILABLE LOCKED_delivery-type  THEN DO:
      743           IF LOCKED(LOCKED_delivery-type) THEN DO:
      744               message
      745               vss-workfile vss-revision vss-description skip
      746                "Запись ТИП ДОСТАВКИ занята"
      747               view-as alert-box error .
      748               undo, return error.
      749           END.
      750      END.
      751       ELSE DO:
      752         IF NOT AVAILABLE LOCKED_delivery-type THEN DO:
      753               message
      754                   vss-workfile vss-revision vss-description skip
      755                   "Неверное значение параметра вызова p-deliv-type-code" p-deliv-type-code skip
      756                   view-as alert-box ERROR.
      757                   return error .
      758           END.
      759       END.
      760       CREATE tt-delivery-type.
      761       BUFFER-COPY LOCKED_delivery-type TO tt-delivery-type.
      762   END.
      763   IF p-deliv-subj-code <> 0
      764   OR p-mode <> 'ДОБАВЛЕНИЕ':U THEN DO:
      765       IF p-mode = 'ДОБАВЛЕНИЕ':U OR p-mode = 'ИЗМЕНЕНИЕ':U  THEN DO:
      766          FIND FIRST LOCKED_delivery-subject EXCLUSIVE-LOCK WHERE
      767                   LOCKED_delivery-subject.deliv-subj-code = p-deliv-subj-code NO-ERROR.
      768       END.
      769       IF p-mode = 'ПРОСМОТР':U  THEN DO:
      770           FIND FIRST LOCKED_delivery-subject NO-LOCK WHERE
      771                   LOCKED_delivery-subject.deliv-subj-code = p-deliv-subj-code NO-ERROR.
      772       END.
      773       IF (p-mode = 'ДОБАВЛЕНИЕ':U
      774       OR p-mode = 'ИЗМЕНЕНИЕ':U )
      775       AND NOT AVAILABLE LOCKED_delivery-subject  THEN DO:
      776           IF LOCKED(LOCKED_delivery-subject) THEN DO:
      777               message
      778               vss-workfile vss-revision vss-description skip
      779                "Запись СУБЪЕКТ ДОСТАВКИ занята"
      780               view-as alert-box error .
      781               undo, return error.
      782           END.
      783       END.
      784       ELSE DO:
      785           IF NOT AVAILABLE LOCKED_delivery-subject  THEN DO:
      786               message
      787               vss-workfile vss-revision vss-description skip
      788               "Неверное значение параметра вызова p-deliv-subj-code" p-deliv-subj-code skip
      789               view-as alert-box ERROR.
      790               return error .
      791           END.
      792       END.
      793       CREATE tt-delivery-subject.
      794       BUFFER-COPY LOCKED_delivery-subject TO tt-delivery-subject.
      795   END.
      796   if p-mode = 'ИЗМЕНЕНИЕ':U
      797     or p-mode = 'ПРОСМОТР':U then do:
      798       if p-mode = 'ИЗМЕНЕНИЕ':U then do:
      799         find first locked_delivery-type-subject EXclusive-lock where
      800                      recid(locked_delivery-type-subject) = p-doc-rec no-wait no-error.
      801         if locked locked_delivery-type-subject then do:
      802           message
      803           vss-workfile vss-revision vss-description skip
      804            "Запись ТИП ДОСТАВКИ ОТ СУБЪЕКТА занята"
      805           view-as alert-box error .
      806           undo, return error.
      807         end.
      808       end.
      809       else do:
      810         find first locked_delivery-type-subject no-lock where
      811                          recid(locked_delivery-type-subject) = p-doc-rec no-error .
      812         if not avail locked_delivery-type-subject then do:
      813           find first locked_delivery-type-subject no-lock where
      814                      locked_delivery-type-subject.deliv-type-code = p-deliv-type-code no-error .
      815         end.
      816       end.
      817       if not available locked_delivery-type-subject then do:
      818         message
      819         vss-workfile vss-revision vss-description skip
      820         "Не найдена запись ТИП ДОСТАВКИ ОТ СУБЪЕКТА"
      821         view-as alert-box error .
      822         undo, return error.
      823       end.
      824       create tt-delivery-type-subject.
      825       buffer-copy locked_delivery-type-subject to tt-delivery-type-subject.
      826      end.
      827      else do:
      828        create tt-delivery-type-subject.
      829        assign
      830        tt-delivery-type-subject.deliv-type-code = (IF p-mode = 'ДОБАВЛЕНИЕ':U AND p-deliv-type-code <> 0
      831                                                    THEN p-deliv-type-code
      832                                                    ELSE tt-delivery-type-subject.deliv-type-code)
      833        tt-delivery-type-subject.deliv-subj-code = (IF p-mode = 'ДОБАВЛЕНИЕ':U AND p-deliv-subj-code <> 0
      834                                                    THEN p-deliv-subj-code
      835                                                    ELSE tt-delivery-type-subject.deliv-type-code)
      836            .
      837      end.
      838     RUN Myenable.
      839     WAIT-FOR GO OF FRAME Dialog-Frame.
      840   END.
      841   RUN disable_UI.
      842   PROCEDURE disable_UI :
      843     HIDE FRAME Dialog-Frame.
      844   END PROCEDURE.
      845   PROCEDURE enable_UI :
      846     OPEN QUERY Dialog-Frame FOR EACH tt-delivery-type-subject SHARE-LOCK,       EACH tt-delivery-subject WHERE TRUE  SHARE-LOCK.
      847     GET FIRST Dialog-Frame.
      848     DISPLAY F-deliv-type-name F-deliv-subj-name
      849         WITH FRAME Dialog-Frame.
      850     IF AVAILABLE tt-delivery-type-subject THEN
      851       DISPLAY tt-delivery-type-subject.deliv-type-code
      852             tt-delivery-type-subject.deliv-subj-code tt-delivery-type-subject.des
      853         WITH FRAME Dialog-Frame.
      854     ENABLE B-exit b-quit B-Hist B-Help tt-delivery-type-subject.deliv-type-code
      855            B-deliv-type tt-delivery-type-subject.deliv-subj-code B-deliv-subj
      856            tt-delivery-type-subject.des
      857         WITH FRAME Dialog-Frame.
      858     VIEW FRAME Dialog-Frame.
      859   END PROCEDURE.
      860   PROCEDURE MyENable :
      861   case p-mode:
      862     when 'ДОБАВЛЕНИЕ':U then do:
      863       display
      864       (IF tt-delivery-type-subject.deliv-type-code <> 0
      865        THEN tt-delivery-type-subject.deliv-type-code
      866        ELSE ?) @ tt-delivery-type-subject.deliv-type-code
      867       (IF tt-delivery-type-subject.deliv-subj-code <> 0
      868        THEN tt-delivery-type-subject.deliv-subj-code
      869        ELSE ?) @ tt-delivery-type-subject.deliv-subj-code
      870       (if available locked_delivery-type
      871       then  locked_delivery-type.deliv-type-name
      872       else "":U ) @ f-deliv-type-name
      873       (if available locked_delivery-subject
      874       then  locked_delivery-subject.deliv-subj-name
      875       else "":U ) @ f-deliv-subj-name
      876       WITH FRAME Dialog-Frame.
      877     end.
      878     otherwise do:
      879       IF AVAILABLE tt-delivery-type-subject THEN
      880       DISPLAY
      881       tt-delivery-type-subject.deliv-type-code
      882       tt-delivery-type-subject.deliv-subj-code
      883       locked_delivery-type.deliv-type-name @ f-deliv-type-name
      884       locked_delivery-subject.deliv-subj-name @ f-deliv-subj-name
      885       tt-delivery-type-subject.des
      886       WITH FRAME Dialog-Frame.
      887     end.
      888   END CASE.
      889   if p-mode = 'ПРОСМОТР':U then do:
      890   assign
      891   b-quit:label = "&Выход"
      892   .
      893   hide
      894   b-exit in frame Dialog-Frame.
      895   end.
      896   ENABLE
      897   B-exit when p-mode <> 'ПРОСМОТР':U
      898   b-quit
      899   B-Hist when p-mode <> 'ДОБАВЛЕНИЕ':U
      900   B-Help
      901   tt-delivery-type-subject.des when p-mode <> 'ПРОСМОТР':U
      902   tt-delivery-type-subject.deliv-type-code when (p-mode = 'ДОБАВЛЕНИЕ':U and p-deliv-type-code = 0)
      903   tt-delivery-type-subject.deliv-subj-code when (p-mode = 'ДОБАВЛЕНИЕ':U and p-deliv-subj-code = 0)
      904   b-deliv-type when (p-mode = 'ДОБАВЛЕНИЕ':U and p-deliv-type-code = 0)
      905   b-deliv-subj when (p-mode = 'ДОБАВЛЕНИЕ':U and p-deliv-subj-code = 0)
      906   WITH FRAME Dialog-Frame.
      907   VIEW FRAME Dialog-Frame.
      908   END PROCEDURE.
      909   PROCEDURE Proc-save :
      910   if p-mode = 'ПРОСМОТР':U then do:
      911       return error.
      912   end.
      913   if not available tt-delivery-type-subject then do:
      914       create tt-delivery-type-subject.
      915   end.
      916   assign
      917   frame Dialog-Frame
      918   tt-delivery-type-subject.deliv-type-code
      919   tt-delivery-type-subject.deliv-subj-code
      920   tt-delivery-type-subject.des = tt-delivery-type-subject.des:SCREEN-VALUE
      921   .
      922    run ref/dlvtysu1.p (
      923   input-output p-doc-rec
      924   ,input p-mode
      925   ,input tt-delivery-type-subject.deliv-type-code
      926   ,input tt-delivery-type-subject.deliv-subj-code
      927   ,input tt-delivery-type-subject.des
      928   )
      929   no-error.
      930   if error-status:error then do:
      931   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      932   define variable fh as widget-handle no-undo .
      933   define variable hh as widget-handle no-undo .
      934   define variable rv as character no-undo .
      935   assign
      936   rv = entry(1, return-value , chr(4)).
      937   if rv <> "":U then do:
      938     assign
      939     fh = frame Dialog-Frame:first-child
      940     hh = fh:first-child
      941     .
      942     do while valid-handle(hh):
      943       if hh:name = rv then do:
      944         APPLY "ENTRY" to hh.
      945         undo ,
      946         return error.
      947       end.
      948       hh = hh:next-sibling.
      949     end.
      950   end.
      951     undo, return error.
      952   end.
      953   END PROCEDURE.
