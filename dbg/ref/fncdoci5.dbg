     1248   PROCEDURE fill-tables :
     1249   define buffer buf_c-fin-doc-tax for ub.c-fin-doc-tax.
     1250   define buffer buf_c-fin-doc-attr for ub.c-fin-doc-attr.
     1251   for each buf_c-fin-doc-tax no-lock where
     1252   buf_c-fin-doc-tax.host-code = tt-c-fin-doc.host-code
     1253   AND buf_c-fin-doc-tax.fin-doc-code = tt-c-fin-doc.fin-doc-code
     1254   AND buf_c-fin-doc-tax.chip-num = tt-c-fin-doc.chip-num
     1255    :
     1256       create tt0-fin-doc-tax.
     1257       buffer-copy buf_c-fin-doc-tax to tt0-fin-doc-tax.
     1258   end.
     1259   for each buf_c-fin-doc-attr no-lock where
     1260   buf_c-fin-doc-attr.host-code = tt-c-fin-doc.host-code
     1261   AND buf_c-fin-doc-attr.fin-doc-code = tt-c-fin-doc.fin-doc-code
     1262   AND buf_c-fin-doc-attr.chip-num = tt-c-fin-doc.chip-num
     1263   :
     1264       create tt0-fin-doc-attr.
     1265       buffer-copy buf_c-fin-doc-attr to tt0-fin-doc-attr.
     1266   end.
     1267   END PROCEDURE.
     1268   PROCEDURE hide-view-currency :
     1269   assign
     1270   v-rubf = no
     1271   v-exchf = no
     1272   v-basef = no
     1273   v-baseratef = no
     1274   v-contractf = no
     1275   v-contractratef = no
     1276   .
     1277   hide
     1278   tt-c-fin-doc.exch-rate in frame Dialog-Frame
     1279   tt-c-fin-doc.exch-scale
     1280   tt-c-fin-doc.sum-rubl
     1281   tt-c-fin-doc.sum-base
     1282   tt-c-fin-doc.base-rate
     1283   tt-c-fin-doc.base-scale
     1284   tt-c-fin-doc.sum-contr
     1285   tt-c-fin-doc.contract-rate
     1286   tt-c-fin-doc.contract-scale
     1287   in frame Dialog-Frame .
     1288   if tt-c-fin-doc.curr-code = 0
     1289   and v-base-code = 0
     1290   and
     1291   (tt-c-fin-doc.contract-code = 0
     1292   or tt-c-fin-doc.contract-curr = 0)
     1293   then do:
     1294       return.
     1295   end.
     1296   if tt-c-fin-doc.curr-code <> 0 then do:
     1297     if tt-c-fin-doc.curr-code:visible then
     1298     display
     1299     tt-c-fin-doc.exch-rate
     1300     tt-c-fin-doc.exch-scale
     1301     tt-c-fin-doc.sum-rubl
     1302     with frame Dialog-Frame.
     1303     assign
     1304     v-rubf = yes
     1305     v-exchf = yes
     1306     .
     1307   end.
     1308   if v-base-code <> 0 then do:
     1309     if tt-c-fin-doc.curr-code:visible then
     1310     display
     1311     tt-c-fin-doc.base-rate
     1312     tt-c-fin-doc.base-scale
     1313     tt-c-fin-doc.sum-base
     1314     with frame Dialog-Frame.
     1315     assign
     1316     v-basef = yes
     1317     v-baseratef = yes
     1318     .
     1319   end.
     1320   if tt-c-fin-doc.contract-code  <> 0 and
     1321     (tt-c-fin-doc.contract-curr <> 0  )
     1322     then do:
     1323       if tt-c-fin-doc.curr-code:visible then
     1324       display
     1325       tt-c-fin-doc.sum-contr
     1326       tt-c-fin-doc.contract-rate
     1327       tt-c-fin-doc.contract-scale
     1328       with frame Dialog-Frame.
     1329     assign
     1330     v-contractf = yes
     1331     v-contractratef = yes
     1332     .
     1333   end.
     1334   END PROCEDURE.
     1335   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1336   on help of frame Dialog-Frame
     1337   do:
     1338     run gbl/app_help.p
     1339       (input this-procedure :file-name
     1340       ,input ''
     1341       ,input ?
     1342       ) no-error.
     1343     if error-status :error then do:
     1344       message
     1345         "Ошибка при вызове помощи"
     1346         error-status :get-message(1)
     1347         view-as alert-box .
     1348     end.
     1349   end.
     1350   run minbtn-set in this-procedure .
     1351   on choose of b-help in frame Dialog-Frame
     1352   do:
     1353     apply "help":u to frame Dialog-Frame .
     1354   end.
     1355   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1356   procedure minbtn-set :
     1357       do
     1358           on error undo, return error return-value
     1359           :
     1360           define variable ii              as integer       no-undo .
     1361           define variable fh              as widget-handle no-undo .
     1362           define variable hh              as widget-handle no-undo .
     1363           define variable v-h             as handle        extent 4 no-undo .
     1364           define variable v-name-button   as character     no-undo .
     1365           define variable v-help-old-x    as decimal       no-undo .
     1366           define variable v-help-old-y    as decimal       no-undo .
     1367           define variable v-help-old-size as decimal       no-undo .
     1368           define variable v-frame-width   as decimal       no-undo .
     1369           define variable jj              as integer       no-undo .
     1370           do
     1371               on error undo, return error
     1372               :
     1373               assign
     1374                   v-frame-width = frame Dialog-Frame:width - 0.3
     1375                   fh            = frame Dialog-Frame:first-child
     1376                   hh            = fh:first-child
     1377                   ii            = 1
     1378                   .
     1379               do while valid-handle(hh):
     1380                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1381                   do:
     1382                       case lc(hh:name) :
     1383                           when "b-help" then
     1384                               do:
     1385                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1386                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1387                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1388                                   hh:TOOLTIP = "Помощь" .
     1389                                   v-help-old-x = hh:column .
     1390                                   v-help-old-y = hh:row    .
     1391                                   v-help-old-size = hh:width .
     1392                                   hh:width-chars = 2.5 .
     1393                               end.
     1394                           when "b-print" then
     1395                               do:
     1396                                   hh:load-image("cmp/b-print.bmp":u) .
     1397                                   hh:TOOLTIP = "Печать" .
     1398                                   v-h[ii] = hh:handle .
     1399                                   ii = ii + 1 .
     1400                                   hh:width-chars = 3 .
     1401                               end.
     1402                           when "b-history" or
     1403                           when "b-hist" then
     1404                               do:
     1405                                   hh:load-image("cmp/b-hist.bmp":u) .
     1406                                   hh:TOOLTIP = "История" .
     1407                                   v-h[ii] = hh:handle .
     1408                                   ii = ii + 1 .
     1409                                   hh:width-chars = 3 .
     1410                               end.
     1411                           when "b-sch" then
     1412                               do:
     1413                                   hh:load-image("cmp/b-sch.bmp":u) .
     1414                                   hh:TOOLTIP = "Установка Фильтра" .
     1415                                   v-h[ii] = hh:handle .
     1416                                   ii = ii + 1 .
     1417                                   hh:width-chars = 3 .
     1418                               end.
     1419                           when "b-hist-user" then
     1420                               do:
     1421                                   hh:load-image("cmp/b-hist.bmp":u) .
     1422                                   hh:TOOLTIP = "История пользователя" .
     1423                                   ii = ii + 1 .
     1424                               end.
     1425                       end case.
     1426                   end.
     1427                   hh = hh:next-sibling.
     1428               end.
     1429               b-help:column = v-frame-width - b-help:width-chars.
     1430               jj = 0.
     1431               repeat ii = 4 to 1 by -1 :
     1432                   if valid-handle (v-h[ii] ) then
     1433                   do:
     1434                       jj  = jj + 1 .
     1435                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1436                       v-h[ii]:row    = v-help-old-y .
     1437                   end.
     1438               end.
     1439           end.
     1440       end.
     1441   end procedure.
