     1608       f-contract-prn-code when tt-c-fin-doc.contract-code <> 0
     1609       f-contract-type when tt-c-fin-doc.contract-code <> 0
     1610       f-contract-curr-abbr when tt-c-fin-doc.contract-code <> 0
     1611       tt-c-fin-doc.contract-curr when tt-c-fin-doc.contract-code <> 0
     1612       with frame Dialog-Frame
     1613       .
     1614       ENABLE
     1615       b-contract-view
     1616       with frame Dialog-Frame.
     1617     end.
     1618   END CASE.
     1619   END PROCEDURE.
     1620   PROCEDURE disable_UI :
     1621     HIDE FRAME Dialog-Frame.
     1622   END PROCEDURE.
     1623   PROCEDURE enable_UI :
     1624     OPEN QUERY Dialog-Frame FOR EACH locked_c-fin-doc SHARE-LOCK.
     1625     GET FIRST Dialog-Frame.
     1626     DISPLAY RS-view f-cor-acc1-descr f-cel-nazn-descr f-contract-curr-abbr
     1627             f-contract-prn-code f-contract-date f-contract-type f-cor-acc-descr
     1628             f-an-uchet-descr F-curr-abbr F-debet F-credit
     1629         WITH FRAME Dialog-Frame.
     1630     IF AVAILABLE tt-c-fin-doc THEN
     1631       DISPLAY tt-c-fin-doc.perm-date tt-c-fin-doc.prn-doc-code
     1632             tt-c-fin-doc.fin-doc-code tt-c-fin-doc.user-name-perm
     1633             tt-c-fin-doc.doc-date tt-c-fin-doc.user-name-doc tt-c-fin-doc.obj-type
     1634             tt-c-fin-doc.obj-code tt-c-fin-doc.fact-date
     1635             tt-c-fin-doc.user-name-fact tt-c-fin-doc.receiver-type
     1636             tt-c-fin-doc.receiver-okpo tt-c-fin-doc.receiver-name
     1637             tt-c-fin-doc.receiver-code tt-c-fin-doc.str-podr-type
     1638             tt-c-fin-doc.str-podr-code tt-c-fin-doc.str-podr-name
     1639             tt-c-fin-doc.cor-acc1-value tt-c-fin-doc.cel-nazn-value
     1640             tt-c-fin-doc.contract-curr tt-c-fin-doc.cor-acc-value
     1641             tt-c-fin-doc.an-uchet-value tt-c-fin-doc.sum-doc
     1642             tt-c-fin-doc.curr-code tt-c-fin-doc.exch-rate tt-c-fin-doc.exch-scale
     1643             tt-c-fin-doc.sum-rubl tt-c-fin-doc.base-rate tt-c-fin-doc.base-scale
     1644             tt-c-fin-doc.sum-base tt-c-fin-doc.contract-rate
     1645             tt-c-fin-doc.contract-scale tt-c-fin-doc.sum-contr
     1646             tt-c-fin-doc.payer-type tt-c-fin-doc.payer-code
     1647             tt-c-fin-doc.payer-name tt-c-fin-doc.naznach-plat
     1648             tt-c-fin-doc.including tt-c-fin-doc.PS tt-c-fin-doc.payer-sign1
     1649             tt-c-fin-doc.receiver-sign1
     1650         WITH FRAME Dialog-Frame.
     1651     ENABLE B-exit b-quit B-tax B-Help RS-view tt-c-fin-doc.prn-doc-code
     1652            tt-c-fin-doc.doc-date tt-c-fin-doc.user-name-doc tt-c-fin-doc.obj-type
     1653            tt-c-fin-doc.obj-code B-receiver-view tt-c-fin-doc.str-podr-type
     1654            tt-c-fin-doc.str-podr-code tt-c-fin-doc.str-podr-name
     1655            tt-c-fin-doc.cor-acc1-value tt-c-fin-doc.cel-nazn-value
     1656            f-contract-curr-abbr B-contract-view tt-c-fin-doc.contract-curr
     1657            tt-c-fin-doc.cor-acc-value tt-c-fin-doc.an-uchet-value
     1658            tt-c-fin-doc.sum-doc tt-c-fin-doc.curr-code tt-c-fin-doc.exch-rate
     1659            tt-c-fin-doc.exch-scale tt-c-fin-doc.sum-rubl tt-c-fin-doc.sum-base
     1660            tt-c-fin-doc.contract-rate tt-c-fin-doc.contract-scale
     1661            tt-c-fin-doc.sum-contr tt-c-fin-doc.payer-type tt-c-fin-doc.payer-code
     1662            tt-c-fin-doc.payer-name B-payer-view tt-c-fin-doc.naznach-plat
     1663            tt-c-fin-doc.including tt-c-fin-doc.PS tt-c-fin-doc.payer-sign1
     1664            tt-c-fin-doc.receiver-sign1
     1665         WITH FRAME Dialog-Frame.
     1666     VIEW FRAME Dialog-Frame.
     1667   END PROCEDURE.
     1668   PROCEDURE fill-main-table :
     1669   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1670   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
     1671     (output v-db-num
     1672     )  .
     1673   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1674   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     1675     (input  p-host-code
     1676     ,output v-base-code
     1677     )  .
     1678     find first X_curr_sysconf no-lock where
     1679                     X_curr_sysconf.host-code = p-curr-host-code.
     1680     find first X_sysconf no-lock where
     1681                   X_sysconf.host-code = p-host-code.
     1682     if p-mode <> 'ПРОСМОТР':U then do:
     1683       if p-curr-host-code <> p-host-code
     1684       or (v-db-num <> X_sysconf.firm-db-num)
     1685       then do:
     1686         message
     1687         vss-workfile vss-revision vss-description skip
     1688         "Неверное значение параметров вызова p-mode и/или p-host-code и/или p-curr-host-code" p-mode p-host-code  p-curr-host-code
     1689         view-as alert-box ERROR.
     1690         undo, return error.
     1691       end.
     1692     end.
     1693     find first X_clients-host no-lock where
     1694                 X_clients-host.obj-type = 'орг':U
     1695             AND   X_clients-host.obj-code = p-host-code  no-error.
     1696     if not available X_clients-host then do:
     1697       message
     1698       vss-workfile vss-revision vss-description skip
     1699       "Неверное значение параметра вызова p-host-code"  p-host-code
     1700       view-as alert-box ERROR.
     1701       undo, return error.
     1702     end.
     1703     find first X_firm no-lock where
     1704                 X_firm.firm-code = p-host-code.
     1705     for each tt-c-fin-doc:
     1706       delete tt-c-fin-doc.
     1707     end.
     1708     for each tt0-fin-doc-attr:
     1709       delete tt0-fin-doc-attr.
     1710     end.
     1711     for each tt0-fin-doc-tax:
     1712       delete tt0-fin-doc-tax.
     1713     end.
     1714   find first locked_c-fin-doc no-lock where
     1715             recid(locked_c-fin-doc) = p-doc-rec no-error .
     1716   if not available locked_c-fin-doc then do:
     1717     find first locked_c-fin-doc no-lock where
     1718                 locked_c-fin-doc.host-code = p-host-code
     1719             AND locked_c-fin-doc.fin-doc-code = p-fin-doc-code no-error .
     1720   end.
     1721   if not available locked_c-fin-doc then do:
     1722     message
     1723     vss-workfile vss-revision vss-description skip
     1724     "Не найдена запись ИСТОРИИ ПРИХОДНОГО АПЗ"
     1725     view-as alert-box error .
     1726     undo, return error.
     1727   end.
     1728   create tt-c-fin-doc.
     1729   buffer-copy locked_c-fin-doc to tt-c-fin-doc.
     1730   END PROCEDURE.
     1731   PROCEDURE Myenable :
     1732   define variable g-log as logical no-undo.
     1733   assign
     1734       tt-c-fin-doc.sum-rubl :label in frame Dialog-Frame = "Рубли"
     1735   .
     1736   run uf-get in this-procedure(
     1737       input  ('findoci-p':U + chr(4) + 'апп':U)
     1738       ,input  v-cntxt-userid
     1739       ,output v-uf-List_
     1740       ,output v-uf-Naim
     1741       ,output v-uf-print-graft
     1742       ,output v-uf-sort-gr
     1743       ,output v-uf-type-price
     1744       ,output v-uf-type-val
     1745   )  no-error.
     1746   if not error-status:error
     1747   and not v-uf-LIst_ = "":U
     1748   then do:
     1749       assign
     1750       v-view =  entry(1, v-uf-List_, chr(4))
     1751       .
     1752   end.
     1753   assign
     1754   frame Dialog-Frame:title = frame Dialog-Frame:title + chr(32) + x_clients-host.obj-name
     1755   tt-c-fin-doc.payer-type:radio-buttons = "Орг" + chr(44) + 'орг':U + chr(44) +
     1756                                         "Чел" + chr(44) + 'чел':U
     1757   rs-view:radio-buttons = "&Полностью" + chr(44) + "full":U +  chr(44) +
     1758                                       "&Сокращ." + chr(44) + "brief":U + chr(44) +
     1759                                       "&Договор" + chr(44) + "contract":U
     1760   rs-view = v-view
     1761   tt-c-fin-doc.obj-type:radio-buttons = "Маг" + chr(44) + 'маг':U + chr(44) +
     1762                                         "Скл" + chr(44) + 'скл':U
     1763   .
     1764   if tt-c-fin-doc.contract-code = 0 then do:
     1765       assign
     1766       g-log = rs-view:disable(radio-label("contract":U, RS-view:radio-buttons))
     1767       .
     1768       if rs-view = "contract":U then
     1769       assign
     1770       rs-view = "full":U
     1771       v-not-uf-set = yes.
     1772   end.
     1773   find first X_currency no-lock where
     1774                 X_currency.curr-code = tt-c-fin-doc.curr-code.
     1775   assign
     1776   f-curr-abbr = X_Currency.curr-abbr.
     1777   if tt-c-fin-doc.contract-code <> 0 then do:
     1778     find first X_currency no-lock where
     1779                   X_currency.curr-code = tt-c-fin-doc.contract-curr.
     1780     assign
     1781     f-contract-curr-abbr = X_Currency.curr-abbr.
     1782   end.
     1783   if tt-c-fin-doc.cor-acc1 <> 0 then do:
     1784       find first X_fin-code-cor-acc1 no-lock where
     1785                   X_fin-code-cor-acc1.fin-code  = tt-c-fin-doc.cor-acc1 no-error.
     1786       if available X_fin-code-cor-acc1 then do:
     1787         assign
     1788         f-cor-acc1-descr = X_fin-code-cor-acc1.descr.
     1789       end.
     1790       if not available X_fin-code-cor-acc1 then do:
     1791         assign
     1792         f-cor-acc1-descr = "!!!Код больше не существует".
     1793       end.
     1794   end.
     1795   if tt-c-fin-doc.cor-acc <> 0 then do:
     1796       find first X_fin-code-cor-acc no-lock where
     1797                   X_fin-code-cor-acc.fin-code  = tt-c-fin-doc.cor-acc no-error.
     1798       if available X_fin-code-cor-acc then do:
     1799         assign
     1800         f-cor-acc-descr = X_fin-code-cor-acc.descr.
     1801       end.
     1802       if not available X_fin-code-cor-acc then do:
     1803         assign
     1804         f-cor-acc-descr = "!!!Код больше не существует".
     1805       end.
     1806   end.
     1807   if tt-c-fin-doc.an-uchet-code <> 0 then do:
     1808     find first X_fin-code-an-uchet no-lock where
     1809                   X_fin-code-an-uchet.fin-code  = tt-c-fin-doc.an-uchet-code no-error.
     1810       if available X_fin-code-an-uchet then do:
     1811         assign
     1812         f-an-uchet-descr = X_fin-code-an-uchet.descr.
     1813       end.
     1814       if not available X_fin-code-an-uchet then do:
     1815         assign
     1816         f-an-uchet-descr = "!!!Код больше не существует".
     1817       end.
     1818   end.
     1819   if tt-c-fin-doc.cel-nazn-code <> 0 then do:
     1820     find first X_fin-code-cel-nazn no-lock where
     1821                   X_fin-code-cel-nazn.fin-code  = tt-c-fin-doc.cel-nazn-code no-error.
     1822       if available X_fin-code-cel-nazn then do:
     1823         assign
     1824         f-cel-nazn-descr = X_fin-code-cel-nazn.descr.
     1825       end.
     1826       if not available X_fin-code-cel-nazn then do:
     1827         assign
     1828         f-cel-nazn-descr = "!!!Код больше не существует".
     1829       end.
     1830   end.
     1831   run proc-color-widgets in this-procedure("f-an-uchet-descr,f-cel-nazn-descr,f-contract-curr-abbr,f-contract-date,f-contract-prn-code,f-contract-rate," +                         "f-contract-scale,f-contract-type,f-cor-acc1-descr,f-cor-acc-descr,base-rate,base-scale,curr-code,exch-rate,exch-scale," +                         "fact-date,fin-doc-code,payer-code,payer-type,perm-date,PS,receiver-code,receiver-type,sum-base,sum-rubl," +                         "user-name-doc,user-name-fact,user-name-perm", no, yes, ?, grey_color).
     1832   run proc-color-widgets in this-procedure("F-curr-abbr,an-uchet-value,cel-nazn-value,cor-acc1-value,cor-acc-value,doc-date," +                       "including,naznach-plat,payer-name,prn-doc-code,receiver-name,receiver-okpo,payer-sign1,receiver-sign1," +                       "str-podr-code,str-podr-name,str-podr-type,sum-doc", no, yes, ?, grey_color).
     1833   run change-view in this-procedure(rs-view).
     1834   VIEW FRAME Dialog-Frame.
     1835   END PROCEDURE.
