     1519   tt-c-fin-doc.receiver-type
     1520   tt-c-fin-doc.receiver-code
     1521   tt-c-fin-doc.receiver-okpo
     1522   tt-c-fin-doc.receiver-name
     1523   tt-c-fin-doc.str-podr-type
     1524   tt-c-fin-doc.str-podr-code
     1525   tt-c-fin-doc.str-podr-name
     1526   IN FRAME Dialog-Frame.
     1527   display
     1528   F-curr-abbr
     1529   with frame Dialog-Frame
     1530   .
     1531   IF AVAILABLE tt-c-fin-doc THEN
     1532     display
     1533     tt-c-fin-doc.fin-doc-code
     1534     tt-c-fin-doc.prn-doc-code
     1535     tt-c-fin-doc.doc-date
     1536     tt-c-fin-doc.user-name-doc
     1537     tt-c-fin-doc.obj-type
     1538     tt-c-fin-doc.obj-code
     1539     tt-c-fin-doc.sum-rubl
     1540     tt-c-fin-doc.curr-code
     1541     tt-c-fin-doc.sum-doc
     1542     tt-c-fin-doc.payer-code
     1543     tt-c-fin-doc.payer-type
     1544     tt-c-fin-doc.payer-name
     1545     tt-c-fin-doc.including
     1546     tt-c-fin-doc.naznach-plat
     1547     tt-c-fin-doc.PS
     1548     tt-c-fin-doc.payer-sign1
     1549     tt-c-fin-doc.receiver-sign1
