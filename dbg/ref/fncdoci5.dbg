     1152   procedure proc-color-widgets :
     1153   define input parameter p-list as character no-undo .
     1154   define input parameter p-fg as logical no-undo .
     1155   define input parameter p-bg as logical no-undo .
     1156   define input parameter p-fgc as integer no-undo .
     1157   define input parameter p-bgc as integer no-undo .
     1158   define variable ii as integer no-undo .
     1159   define variable fh as widget-handle no-undo .
     1160   define variable hh as widget-handle no-undo .
     1161     do
     1162     on error undo, return error
     1163     :
     1164       assign
     1165       fh = frame Dialog-Frame:first-child
     1166       hh = fh:first-child
     1167       .
     1168       do while valid-handle(hh):
     1169         if LOOKUP(hh:name, p-list) > 0  then do:
     1170           assign
     1171           hh:fgcolor = (if p-fg then p-fgc else hh:fgcolor)
     1172           hh:bgcolor = (if p-bg then p-bgc else hh:bgcolor)
     1173           .
     1174         end.
     1175         hh = hh:next-sibling.
     1176       end.
     1177     end.
     1178   end procedure.
