     1590       f-credit                      when (X_sysconf.is-cassa-acc or X_sysconf.is-an-uchet)
     1591       tt-c-fin-doc.cor-acc1-value   when X_sysconf.is-cassa-acc
     1592       f-cor-acc1-descr              when X_sysconf.is-cassa-acc
     1593       tt-c-fin-doc.cor-acc-value    when X_sysconf.is-corr-acc
     1594       f-cor-acc-descr               when X_sysconf.is-corr-acc
