      507   procedure uf-get :
      508     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
      509     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
      510     define output parameter p-List_        like ubflt.usr-flt.List_        no-undo .
      511     define output parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
      512     define output parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
      513     define output parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
      514     define output parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
      515     define output parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
      516     do
      517     on error undo, return error
      518     :
      519       define buffer buf_usr-flt for ubflt.usr-flt .
      520       define variable v-use-List_     as logical   no-undo .
      521       define variable v-type-List_     as character no-undo .
      522       define variable v-format-List_   as character no-undo .
      523       define variable v-use-Naim      as logical   no-undo .
      524       define variable v-type-Naim      as character no-undo .
      525       define variable v-format-Naim    as character no-undo .
      526       define variable v-use-print-graft as logical   no-undo .
      527       define variable v-use-sort-gr     as logical   no-undo .
      528       define variable v-use-type-price  as logical   no-undo .
      529       define variable v-use-type-val    as logical   no-undo .
      530       define variable v-label          as character no-undo .
      531       define variable v-tooltip        as character no-undo .
      532       define variable v-user-can-edit  as logical   no-undo .
      533       define variable v-output-display as logical   no-undo .
      534       define variable v-other          as character no-undo .
      535       run uf-name in this-procedure
      536          (input  entry(1, p-code, chr(4))
      537         ,output v-use-List_
      538         ,output v-type-List_
      539         ,output v-format-List_
      540         ,output v-use-Naim
      541         ,output v-type-Naim
      542         ,output v-format-Naim
      543         ,output v-use-print-graft
      544         ,output v-use-sort-gr
      545         ,output v-use-type-price
      546         ,output v-use-type-val
      547         ,output v-label
      548         ,output v-tooltip
      549         ,output v-user-can-edit
      550         ,output v-output-display
      551         ,output v-other
      552         ) no-error .
      553       if error-status :error then do:
      554         undo, return error return-value .
      555       end.
      556       find first buf_usr-flt no-lock where
      557                  buf_usr-flt.Call-point     = p-code AND
      558                  buf_usr-flt.user-name       = p-user-name
      559         no-error .
      560       if avail buf_usr-flt then do:
      561         assign
      562         p-List_        = (if v-use-List_       then buf_usr-flt.List_       else ?)
      563         p-Naim         = (if v-use-Naim        then buf_usr-flt.Naim        else ?)
      564         p-print-graft  = (if v-use-print-graft then buf_usr-flt.print-graft else ?)
      565         p-sort-gr      = (if v-use-sort-gr     then buf_usr-flt.sort-gr     else ?)
      566         p-type-price   = (if v-use-type-price  then buf_usr-flt.type-price  else ?)
      567         p-type-val     = (if v-use-List_       then buf_usr-flt.type-val    else ?)
      568         .
      569       end.
      570       else do:
      571         assign
      572         p-List_        = (if v-use-List_       then "":U                    else ?)
      573         p-Naim         = (if v-use-Naim        then "":U                    else ?)
      574         p-print-graft  = (if v-use-print-graft then no                      else ?)
      575         p-sort-gr      = (if v-use-sort-gr     then no                      else ?)
      576         p-type-price   = (if v-use-type-price  then no                      else ?)
      577         p-type-val     = (if v-use-List_       then no                      else ?)
      578         .
      579       end.
      580     end.
      581   end procedure.
      582   procedure uf-set :
      583     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
      584     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
      585     define input  parameter p-List_        like ubflt.usr-flt.List_        no-undo .
      586     define input  parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
      587     define input  parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
      588     define input  parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
      589     define input  parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
      590     define input  parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
      591     do
      592     on error undo, return error
      593     :
      594       define buffer buf_usr-flt for ubflt.usr-flt .
      595       define variable v-use-List_     as logical   no-undo .
      596       define variable v-type-List_     as character no-undo .
      597       define variable v-format-List_   as character no-undo .
      598       define variable v-use-Naim      as logical   no-undo .
      599       define variable v-type-Naim      as character no-undo .
      600       define variable v-format-Naim    as character no-undo .
      601       define variable v-use-print-graft as logical   no-undo .
      602       define variable v-use-sort-gr   as logical   no-undo .
      603       define variable v-use-type-price as logical   no-undo .
      604       define variable v-use-type-val  as logical   no-undo .
      605       define variable v-tooltip        as character no-undo .
      606       define variable v-label          as character no-undo .
      607       define variable v-user-can-edit  as logical   no-undo .
      608       define variable v-output-display as logical   no-undo .
      609       define variable v-other          as character no-undo .
      610       run uf-name in this-procedure
      611         (input  entry(1, p-code, chr(4))
      612         ,output v-use-List_
      613         ,output v-type-List_
      614         ,output v-format-List_
      615         ,output v-use-Naim
      616         ,output v-type-Naim
      617         ,output v-format-Naim
      618         ,output v-use-print-graft
      619         ,output v-use-sort-gr
      620         ,output v-use-type-price
      621         ,output v-use-type-val
      622         ,output v-label
      623         ,output v-tooltip
      624         ,output v-user-can-edit
      625         ,output v-output-display
      626         ,output v-other
      627         ) no-error .
      628       if error-status :error then do:
      629         undo, return error return-value .
      630       end.
      631       find first buf_usr-flt where
      632                  buf_usr-flt.Call-point     = p-code AND
      633                  buf_usr-flt.user-name       = p-user-name
      634         no-error .
      635       if not avail buf_usr-flt then do:
      636           create buf_usr-flt .
      637           assign
      638           buf_usr-flt.call-point = p-code
      639           buf_usr-flt.user-name  = p-user-name
      640           .
      641       end.
      642       if avail buf_usr-flt then do:
      643        assign
      644        buf_usr-flt.List_       =  (if v-use-List_       then  p-List_        else ?)
      645        buf_usr-flt.Naim        =  (if v-use-Naim        then  p-Naim         else ?)
      646        buf_usr-flt.print-graft =  (if v-use-print-graft then  p-print-graft  else ?)
      647        buf_usr-flt.sort-gr     =  (if v-use-sort-gr     then  p-sort-gr      else ?)
      648        buf_usr-flt.type-price  =  (if v-use-type-price  then  p-type-price   else ?)
      649        buf_usr-flt.type-val    =  (if v-use-List_       then  p-type-val     else ?)
      650       .
      651       release buf_usr-flt.
      652       end.
      653       else undo, return error ("Ошибка при записи usr-flt" + substitute(" call-point=&1, user-name=&2", p-code, p-user-name)).
      654     end.
      655   end procedure.
      656   function diff-list returns character (
      657     input parfirst-list  as character,
      658     input parsecond-list as character,
      659     input pardelim       as character).
      660     if pardelim = ""
      661     or pardelim = ?
      662     then do:
      663       assign
      664         pardelim = ","
      665       .
      666     end.
      667     def var ind as integer no-undo .
      668     def var v-elem as character no-undo .
      669     def var v-result-list as character no-undo init "".
      670     def var v-num-parfirst-list as integer no-undo .
      671     assign
      672       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      673     .
      674     do ind = 1 to v-num-parfirst-list
      675     :
      676       assign
      677         v-elem = entry(ind, parfirst-list, pardelim)
      678       .
      679       if lookup(v-elem, parsecond-list, pardelim) = 0 then do:
      680         assign
      681           v-result-list = v-result-list
      682                         + (if v-result-list > "" then pardelim else "")
      683                         + v-elem
      684         .
      685       end.
      686     end.
      687     return v-result-list .
      688   end function.
      689   function add-list returns character (
      690    input parfirst-list  as character,
      691    input parsecond-list as character,
      692    input pardelim       as character).
      693     if pardelim = ""
      694     or pardelim = ?
      695     then do:
      696       assign
      697         pardelim = ","
      698       .
      699     end.
      700     def var ind as integer no-undo .
      701     def var v-elem as character no-undo .
      702     def var v-result-list as character no-undo init "".
      703     def var v-num-parfirst-list as integer no-undo .
      704     assign
      705       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      706     .
      707     do ind = 1 to v-num-parfirst-list
      708     :
      709       assign
      710         v-elem = entry(ind, parfirst-list, pardelim)
      711       .
      712       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
      713         assign
      714           v-result-list = v-result-list
      715                         + (if v-result-list > "" then pardelim else "")
      716                         + v-elem
      717         .
      718       end.
      719     end.
      720     def var v-num-parsecond-list as integer no-undo .
      721     assign
      722       v-num-parsecond-list = num-entries(parsecond-list, pardelim)
      723     .
      724     do ind = 1 to v-num-parsecond-list
      725     :
      726       assign
      727         v-elem = entry(ind, parsecond-list, pardelim)
      728       .
      729       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
      730         assign
      731           v-result-list = v-result-list
      732                         + (if v-result-list > "" then pardelim else "")
      733                         + v-elem
      734         .
      735       end.
      736     end.
      737     return v-result-list .
      738   end function.
      739   function cross-list returns character (
      740    input parfirst-list  as character,
      741    input parsecond-list as character,
      742    input pardelim       as character).
      743     if pardelim = ""
      744     or pardelim = ?
      745     then do:
      746       assign
      747         pardelim = ","
      748       .
      749     end.
      750     def var ind as integer no-undo .
      751     def var v-elem as character no-undo .
      752     def var v-result-list as character no-undo init "".
      753     def var v-num-parfirst-list as integer no-undo .
      754     assign
      755       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      756     .
      757     do ind = 1 to v-num-parfirst-list
      758     :
      759       assign
      760         v-elem = entry(ind, parfirst-list, pardelim)
      761       .
      762       if lookup(v-elem, v-result-list, pardelim) = 0
      763       and lookup(v-elem, parsecond-list, pardelim) > 0
      764       then do:
      765         assign
      766           v-result-list = v-result-list
      767                         + (if v-result-list > "" then pardelim else "")
      768                         + v-elem
      769         .
      770       end.
      771     end.
      772     return v-result-list .
      773   end function.
      774   function radio-label returns character (
      775    input par-rs-value  as character,
      776    input par-rs-radio-buttons as character)
      777    .
      778    DEFINE variable v-result-label as character no-undo.
      779    assign
      780    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons) MODULO 2 = 0)
      781                              then (LOOKUP(par-rs-value, par-rs-radio-buttons) - 1)
      782                              else LOOKUP(par-rs-value, par-rs-radio-buttons)
      783                             ), par-rs-radio-buttons
      784                           )
      785    v-result-label = REPLACE(v-result-label, "&":U, "":U)
      786    .
      787   return v-result-label.
      788   end function.
      789   function m-radio-label returns character (
      790    input par-rs-value  as character,
      791    input par-rs-radio-buttons as character,
      792    input par-delim as character
      793    )
      794    .
      795    DEFINE variable v-result-label as character no-undo.
      796    assign
      797    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) MODULO 2 = 0)
      798                              then (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) - 1)
      799                              else LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim)
      800                             ), par-rs-radio-buttons, par-delim
      801                           )
      802    v-result-label = REPLACE(v-result-label, "&":U, "":U)
      803    .
      804   return v-result-label.
      805   end function.
      806   FUNCTION mixlist returns character
      807   (
      808    input parfirst-list  as character
      809    ,input parsecond-list as character
      810    ,input pardelim       as character
      811    ,input pardelim-result as character ) :
      812     if pardelim = ""
      813     or pardelim = ?
      814     then do:
      815       assign
      816         pardelim = ","
      817       .
      818     end.
      819     def var ind as integer no-undo .
      820     def var v-elem1 as character no-undo .
      821     def var v-elem2 as character no-undo .
      822     def var v-result-list as character no-undo init "".
      823     do ind = 1 to num-entries(parfirst-list, pardelim)
      824     :
      825       assign
      826         v-elem1 = entry(ind, parfirst-list, pardelim)
      827         v-elem2 = entry(ind, parsecond-list, pardelim)
      828       .
      829         assign
      830           v-result-list = v-result-list
      831                         + (if v-result-list > "" then pardelim-result else "")
      832                         + v-elem1 + pardelim-result + v-elem2
      833         .
      834     end.
      835     return v-result-list .
      836   END FUNCTION.
