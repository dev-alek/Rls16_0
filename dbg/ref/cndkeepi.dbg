        1   DEFINE BUFFER locked_condition-keeping FOR ub.condition-keeping.
        2   DEFINE TEMP-TABLE tt-condition-keeping NO-UNDO LIKE ub.condition-keeping.
        3   DEFINE BUFFER X_curr_clients FOR ub.clients.
        4   DEFINE INPUT     PARAMETER parParentProc  AS WIDGET-HANDLE NO-UNDO.
        5   define input parameter p-curr-obj-type like ub.clients.obj-type no-undo.
        6   define input parameter p-curr-obj-code like ub.clients.obj-code no-undo.
        7   define input parameter p-mode as character no-undo.
        8   DEFINE INPUT PARAMETER p-cond-keep-code LIKE ub.condition-keeping.cond-keep-code NO-UNDO.
        9   define input-output parameter p-doc-rec as recid no-undo.
       10   define variable vss-revision    as character no-undo init "$Revision$":U .
       11   define variable vss-author      as character no-undo init "$Author$":U .
       12   define variable vss-date        as character no-undo init "$Date$":U .
       13   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       14   define variable vss-archive     as character no-undo init "$Archive$":U .
       15   define variable vss-description as character no-undo init "Карточка редактирования УСЛОВИЙ ХРАНЕНИЯ".
       16   procedure vss-get-info :
       17     define output parameter p-vss-revision    like vss-revision    no-undo .
       18     define output parameter p-vss-author      like vss-author      no-undo .
       19     define output parameter p-vss-date        like vss-date        no-undo .
       20     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       21     define output parameter p-vss-archive     like vss-archive     no-undo .
       22     define output parameter p-vss-description like vss-description no-undo .
       23     assign
       24       p-vss-revision    = vss-revision
       25       p-vss-author      = vss-author
       26       p-vss-date        = vss-date
       27       p-vss-workfile    = vss-workfile
       28       p-vss-archive     = vss-archive
       29       p-vss-description = vss-description
       30     .
       31   end procedure.
       32   procedure vss-get-parameters :
       33     define output parameter p-vss-parameters as character no-undo .
       34   end procedure.
       35   define new global shared variable g#vssrevis-logger as handle    no-undo .
       36   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       37   define variable v-vssrevis-logger                   as handle    no-undo .
       38   procedure vss-logevent :
       39     define input  parameter p-extra-paramters as character no-undo .
       40     define variable v-vssrevis-parameters as character no-undo .
       41     do
       42     on error undo, return error return-value
       43     :
       44       if  valid-handle(v-vssrevis-logger)
       45       and v-vssrevis-logger :get-signature("logevent") <> ""
       46       then do:
       47         run vss-get-parameters in this-procedure
       48           (output v-vssrevis-parameters
       49           ).
       50         run logevent in v-vssrevis-logger
       51           (input vss-workfile
       52           ,input vss-revision
       53           ,input v-vssrevis-parameters
       54           ,input p-extra-paramters
       55           ).
       56       end.
       57     end.
       58   end procedure.
       59   assign
       60     v-vssrevis-logger = g#vssrevis-logger
       61   .
       62   if  valid-handle(v-vssrevis-logger)
       63   and v-vssrevis-logger :get-signature("logevent") <> ""
       64   then do:
       65     assign
       66       v-vssrevis-logevent = true
       67     .
       68     run vss-logevent in this-procedure (input vss-description) .
       69   end.
       70   define new global shared variable g#language as character no-undo .
       71   if g#language <> '' and g#language <> 'rus':U then do:
       72     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       73   end.
       74   define new global shared variable g#library  as handle no-undo .
       75   define new global shared variable g#library2 as handle no-undo .
       76   define   shared variable g#auto as logical no-undo.
       77   define   shared variable g#news as logical no-undo.
       78   define   shared variable g#oxml as logical no-undo.
       79   define   shared variable g#esys as logical no-undo.
       80   define   shared variable g#news-source-db as integer no-undo.
       81   define   shared variable g#esys-source-esys as integer no-undo.
       82   define   shared variable g#db-num as integer   no-undo .
       83   define   shared variable g#userid as character no-undo .
       84   define   shared variable g#passwd as character no-undo .
       85   procedure proc-alt-shift-f2:
       86     if not ibs.th.gbl.gbl-var:rcode
       87   then
       88     run gbl\inidebug.p .
       89   end.
       90   procedure proc-alt-shift-f3:
       91     run gbl/prvssinf.p
       92       ( input this-procedure
       93       ) .
       94   end.
       95   define variable v-inform-launched as logical no-undo initial false .
       96   procedure proc-alt-shift-f4:
       97     define variable v-action as character no-undo .
       98     if v-inform-launched = false then do:
       99       assign
      100         v-inform-launched = true
      101       .
      102       run gbl/d-inform.w
      103         (  input self
      104         ,  input this-procedure
      105         , output v-action
      106         ) no-error .
      107       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      108       assign
      109         v-inform-launched = false
      110       .
      111     end.
      112   end.
      113   procedure proc-alt-f1:
      114     run gbl/corrhelp.p
      115       (input this-procedure
      116       ) .
      117   end .
      118   on alt-shift-f2 anywhere do:
      119     run proc-alt-shift-f2.
      120   end.
      121   on alt-shift-f3 anywhere do:
      122     run proc-alt-shift-f3 in this-procedure .
      123   end.
      124   on alt-shift-f4 anywhere do:
      125     run proc-alt-shift-f4 in this-procedure.
      126   end.
      127   on alt-f1 anywhere do:
      128     run proc-alt-f1 in this-procedure .
      129   end.
      130   define variable v-tab-order as character no-undo.
      131   define variable v-db-num LIKE ub.db.db-num no-undo.
      132   define variable v-last-code like ub.condition-keeping.cond-keep-code no-undo.
      133   DEFINE BUTTON B-exit AUTO-GO
      134        LABEL "&Ввод"
      135        SIZE 10 BY 1
      136        BGCOLOR 8 .
      137   DEFINE BUTTON B-Help
      138        LABEL "Помо&щь"
      139        SIZE 10 BY 1
      140        BGCOLOR 8 .
      141   DEFINE BUTTON B-Hist
      142        LABEL "Ис&тория"
      143        SIZE 10 BY 1
      144        BGCOLOR 8 .
      145   DEFINE BUTTON b-quit AUTO-END-KEY
      146        LABEL "&Отмена"
      147        SIZE 10 BY 1
      148        BGCOLOR 8 .
      149   DEFINE VARIABLE varsts AS CHARACTER FORMAT "X(3)":U
      150        LABEL "Статус"
      151        VIEW-AS FILL-IN
      152        SIZE 4 BY 1 NO-UNDO.
      153   DEFINE QUERY Dialog-Frame FOR
      154         tt-condition-keeping SCROLLING.
      155   DEFINE FRAME Dialog-Frame
      156        B-exit AT ROW 1 COL 1
      157        b-quit AT ROW 1 COL 11
      158        B-Hist AT ROW 1 COL 51
      159        B-Help AT ROW 1 COL 61
      160        tt-condition-keeping.cond-keep-code AT ROW 3 COL 34 COLON-ALIGNED
      161             LABEL "Внутр.код условий хранения"
      162             VIEW-AS FILL-IN
      163             SIZE 11 BY 1
      164        varsts AT ROW 3 COL 54 COLON-ALIGNED
      165        tt-condition-keeping.cond-keep-name AT ROW 4.25 COL 34 COLON-ALIGNED
      166             LABEL "Название условий хранения"
      167             VIEW-AS FILL-IN
      168             SIZE 63 BY 1
      169        tt-condition-keeping.t-mode-from AT ROW 5.5 COL 34 COLON-ALIGNED
      170             LABEL "Темп.режим: от(град C)"
      171             VIEW-AS FILL-IN
      172             SIZE 10 BY 1
      173        tt-condition-keeping.t-mode-to AT ROW 5.5 COL 60 COLON-ALIGNED
      174             LABEL "до (град C)"
      175             VIEW-AS FILL-IN
      176             SIZE 10 BY 1
      177        tt-condition-keeping.h-mode-from AT ROW 6.75 COL 34 COLON-ALIGNED
      178             LABEL "Влажность: от(%)" FORMAT ">9.99"
      179             VIEW-AS FILL-IN
      180             SIZE 10 BY 1
      181        tt-condition-keeping.h-mode-to AT ROW 6.75 COL 60 COLON-ALIGNED
      182             LABEL "до (%)" FORMAT ">9.99"
      183             VIEW-AS FILL-IN
      184             SIZE 10 BY 1
      185        tt-condition-keeping.des AT ROW 10 COL 1 NO-LABEL
      186             VIEW-AS EDITOR SCROLLBAR-VERTICAL
      187             SIZE 98 BY 3.75
      188        "Описание" VIEW-AS TEXT
      189             SIZE 16 BY 1 AT ROW 8.75 COL 1.5
      190        SPACE(81.74) SKIP(4.49)
      191       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      192            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      193            TITLE "Условия хранения"
      194            DEFAULT-BUTTON B-exit CANCEL-BUTTON b-quit.
      195   ASSIGN
      196          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      197          FRAME Dialog-Frame:HIDDEN           = TRUE.
      198   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      199   DO:
      200     APPLY "END-ERROR":U TO SELF.
      201   END.
      202   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
      203   DO:
      204     run proc-save in this-procedure no-error.
      205     if error-status:error then return no-apply.
      206   END.
      207   ON CHOOSE OF B-Hist IN FRAME Dialog-Frame
      208   DO:
      209     define variable v-rid-list as character no-undo.
      210       run ref/ccnkeeps.w
      211                   (
      212                    input parParentProc
      213                   ,INPUT p-curr-obj-type
      214                   ,INPUT p-curr-obj-code
      215                   ,input "":U
      216                   ,input "one":U
      217                   ,input locked_condition-keeping.cond-keep-code
      218                   ,input-output v-rid-list
      219                                 )
      220    .
      221   END.
      222   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      223   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      224   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      225   on help of frame Dialog-Frame
      226   do:
      227     run gbl/app_help.p
      228       (input this-procedure :file-name
      229       ,input ''
      230       ,input ?
      231       ) no-error.
      232     if error-status :error then do:
      233       message
      234         "Ошибка при вызове помощи"
      235         error-status :get-message(1)
      236         view-as alert-box .
      237     end.
      238   end.
      239   run minbtn-set in this-procedure .
      240   on choose of b-help in frame Dialog-Frame
      241   do:
      242     apply "help":u to frame Dialog-Frame .
      243   end.
      244   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      245   procedure minbtn-set :
      246       do
      247           on error undo, return error return-value
      248           :
      249           define variable ii              as integer       no-undo .
      250           define variable fh              as widget-handle no-undo .
      251           define variable hh              as widget-handle no-undo .
      252           define variable v-h             as handle        extent 4 no-undo .
      253           define variable v-name-button   as character     no-undo .
      254           define variable v-help-old-x    as decimal       no-undo .
      255           define variable v-help-old-y    as decimal       no-undo .
      256           define variable v-help-old-size as decimal       no-undo .
      257           define variable v-frame-width   as decimal       no-undo .
      258           define variable jj              as integer       no-undo .
      259           do
      260               on error undo, return error
      261               :
      262               assign
      263                   v-frame-width = frame Dialog-Frame:width - 0.3
      264                   fh            = frame Dialog-Frame:first-child
      265                   hh            = fh:first-child
      266                   ii            = 1
      267                   .
      268               do while valid-handle(hh):
      269                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      270                   do:
      271                       case lc(hh:name) :
      272                           when "b-help" then
      273                               do:
      274                                   hh:load-image-up("cmp/b-help.bmp":u) .
      275                                   hh:load-image-down("cmp/b-help.bmp":u) .
      276                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      277                                   hh:TOOLTIP = "Помощь" .
      278                                   v-help-old-x = hh:column .
      279                                   v-help-old-y = hh:row    .
      280                                   v-help-old-size = hh:width .
      281                                   hh:width-chars = 2.5 .
      282                               end.
      283                           when "b-print" then
      284                               do:
      285                                   hh:load-image("cmp/b-print.bmp":u) .
      286                                   hh:TOOLTIP = "Печать" .
      287                                   v-h[ii] = hh:handle .
      288                                   ii = ii + 1 .
      289                                   hh:width-chars = 3 .
      290                               end.
      291                           when "b-history" or
      292                           when "b-hist" then
      293                               do:
      294                                   hh:load-image("cmp/b-hist.bmp":u) .
      295                                   hh:TOOLTIP = "История" .
      296                                   v-h[ii] = hh:handle .
      297                                   ii = ii + 1 .
      298                                   hh:width-chars = 3 .
      299                               end.
      300                           when "b-sch" then
      301                               do:
      302                                   hh:load-image("cmp/b-sch.bmp":u) .
      303                                   hh:TOOLTIP = "Установка Фильтра" .
      304                                   v-h[ii] = hh:handle .
      305                                   ii = ii + 1 .
      306                                   hh:width-chars = 3 .
      307                               end.
      308                           when "b-hist-user" then
      309                               do:
      310                                   hh:load-image("cmp/b-hist.bmp":u) .
      311                                   hh:TOOLTIP = "История пользователя" .
      312                                   ii = ii + 1 .
      313                               end.
      314                       end case.
      315                   end.
      316                   hh = hh:next-sibling.
      317               end.
      318               b-help:column = v-frame-width - b-help:width-chars.
      319               jj = 0.
      320               repeat ii = 4 to 1 by -1 :
      321                   if valid-handle (v-h[ii] ) then
      322                   do:
      323                       jj  = jj + 1 .
      324                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      325                       v-h[ii]:row    = v-help-old-y .
      326                   end.
      327               end.
      328           end.
      329       end.
      330   end procedure.
      331   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      332   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      333   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      334   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      335   define variable v-diasize-current-frame-width  as decimal   no-undo .
      336   define variable v-diasize-current-frame-height as decimal   no-undo .
      337   define variable v-diasize-change-size          as logical   no-undo .
      338   define variable v-diasize-resize-button        as handle    no-undo .
      339   define variable v-diasize-wndmax               as logical   no-undo .
      340   define variable v-diasize-wndstore             as logical   no-undo .
      341   define variable v-diasize-proc-name            as character no-undo .
      342   define variable v-diasize-browse-handle        as handle    no-undo .
      343   define variable v-diasize-browse-number        as integer   no-undo .
      344   define variable v-diasize-need-full-display    as logical   no-undo init false .
      345   define temp-table temp-diasize-handle no-undo
      346     field handle-value  as handle
      347     field save-position as decimal
      348     index xpk is primary unique handle-value
      349     .
      350   define temp-table temp-browse-handle no-undo
      351     field browse-type   as character
      352     field browse-number as integer
      353     field browse-handle as handle
      354     field original-size as decimal
      355     index xpk is primary unique browse-type browse-number
      356     index xie browse-type browse-handle
      357   .
      358   procedure diasize_change-height :
      359     define input  parameter p-change-value  as decimal   no-undo .
      360     define input  parameter p-move-resize   as logical   no-undo .
      361     define variable v-field-group-handle    as handle    no-undo .
      362     define variable v-object-handle         as handle    no-undo .
      363     define variable v-frame-height          as decimal   no-undo .
      364     define variable v-frame-virtual-height  as decimal   no-undo .
      365     define variable v-browse-height         as decimal   no-undo .
      366     define variable v-window-height         as decimal   no-undo .
      367     define variable v-window-virtual-height as decimal   no-undo .
      368     define variable v-change-sign           as integer   no-undo .
      369     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      370     define buffer buf_temp-browse-handle  for temp-browse-handle .
      371     if p-change-value > 0
      372     then do:
      373       if frame Dialog-Frame :height + p-change-value
      374           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      375       then do:
      376         assign
      377           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      378                           - (frame Dialog-Frame :height-chars)
      379         .
      380         if p-change-value <= 0
      381         then do:
      382           run diasize_position-resize-button in this-procedure .
      383           return .
      384         end.
      385       end.
      386     end.
      387     if p-change-value < 0
      388     then do:
      389       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      390       then do:
      391         assign
      392           p-change-value = v-diasize-orig-frame-height
      393                          - (frame Dialog-Frame :height-chars)
      394         .
      395         if p-change-value >= 0
      396         then do:
      397           run diasize_position-resize-button in this-procedure .
      398           return .
      399         end.
      400       end.
      401     end.
      402     if p-change-value >= 0
      403     then do:
      404       assign
      405         v-change-sign = 1
      406       .
      407     end.
      408     else do:
      409       assign
      410         v-change-sign = -1
      411       .
      412     end.
      413     assign
      414       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      415     .
      416     if p-change-value = 0
      417     then do:
      418       run diasize_position-resize-button in this-procedure .
      419       return .
      420     end.
      421     move_block:
      422     do
      423     on error undo move_block, retry move_block
      424     :
      425       if retry
      426       then do:
      427         do
      428         on error undo move_block, leave move_block
      429         :
      430           if p-change-value > 0
      431           then do:
      432             for each buf_temp-diasize-handle
      433             on error undo, next
      434             :
      435               assign
      436                 v-object-handle = buf_temp-diasize-handle.handle-value
      437               .
      438               if v-object-handle <> v-diasize-resize-button
      439               then do:
      440                 assign
      441                   v-object-handle :row = buf_temp-diasize-handle.save-position
      442                 .
      443               end.
      444             end.
      445             assign
      446               v-diasize-browse-handle :height = v-browse-height
      447             .
      448             for each buf_temp-browse-handle
      449               where buf_temp-browse-handle.browse-type = 'height':u
      450             on error undo, next
      451             :
      452               assign
      453                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      454               .
      455             end.
      456             assign
      457               frame Dialog-Frame :height = v-frame-height
      458             .
      459             if frame Dialog-Frame :scrollable = true
      460             then do:
      461               assign
      462                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      463               .
      464             end.
      465             run diasize_position-resize-button in this-procedure .
      466           end.
      467           else do:
      468             if frame Dialog-Frame :scrollable = true
      469             then do:
      470               assign
      471                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      472               .
      473             end.
      474             assign
      475               frame Dialog-Frame :height = v-frame-height
      476             .
      477             assign
      478               v-diasize-browse-handle :height = v-browse-height
      479             .
      480             for each buf_temp-browse-handle
      481               where buf_temp-browse-handle.browse-type = 'height':u
      482             on error undo, next
      483             :
      484               assign
      485                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      486               .
      487             end.
      488             for each buf_temp-diasize-handle
      489             on error undo, next
      490             :
      491               assign
      492                 v-object-handle = buf_temp-diasize-handle.handle-value
      493               .
      494               if v-object-handle <> v-diasize-resize-button
      495               then do:
      496                 assign
      497                   v-object-handle :row = buf_temp-diasize-handle.save-position
      498                 .
      499               end.
      500             end.
      501             run diasize_position-resize-button in this-procedure .
      502           end.
      503           assign
      504             v-diasize-change-size = false
      505           .
      506           leave move_block .
      507         end.
      508       end.
      509       assign
      510         v-diasize-need-full-display = true
      511       .
      512       if v-diasize-change-size = false
      513       then do:
      514         assign
      515           v-diasize-change-size = true
      516         .
      517       end.
      518       else do:
      519         return .
      520       end.
      521       assign
      522         v-frame-height = frame Dialog-Frame :height
      523         v-frame-virtual-height = frame Dialog-Frame :virtual-height
      524         v-browse-height = v-diasize-browse-handle :height
      525       .
      526       for each buf_temp-browse-handle
      527         where buf_temp-browse-handle.browse-type = 'height':u
      528       :
      529         assign
      530           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
      531         .
      532       end.
      533       for each buf_temp-diasize-handle
      534       :
      535         delete buf_temp-diasize-handle .
      536       end.
      537       assign
      538         v-field-group-handle = frame Dialog-Frame :first-child
      539       .
      540       do while valid-handle(v-field-group-handle)
      541       :
      542         assign
      543           v-object-handle = v-field-group-handle :first-child
      544         .
      545         do while valid-handle(v-object-handle)
      546         :
      547           if  v-object-handle <> v-diasize-browse-handle :handle
      548           and can-query(v-object-handle, "row")
      549           and can-query(v-object-handle, "height")
      550           and ( v-object-handle :row > v-diasize-browse-handle :row )
      551           then do:
      552             find first buf_temp-browse-handle
      553               where buf_temp-browse-handle.browse-type   = 'height':u
      554                 and buf_temp-browse-handle.browse-handle = v-object-handle
      555               no-error .
      556             if available buf_temp-browse-handle
      557             then do:
      558             end.
      559             else do:
      560               create buf_temp-diasize-handle .
      561               assign
      562                 buf_temp-diasize-handle.handle-value  = v-object-handle
      563                 buf_temp-diasize-handle.save-position = v-object-handle :row
      564               .
      565             end.
      566           end.
      567           assign
      568             v-object-handle = v-object-handle :next-sibling
      569           .
      570         end.
      571         assign
      572           v-field-group-handle = v-field-group-handle :next-sibling
      573         .
      574       end.
      575       do with frame Dialog-Frame
      576       :
      577         hide v-diasize-resize-button .
      578         assign
      579           v-diasize-resize-button :row    = 1
      580           v-diasize-resize-button :column = 1
      581         .
      582       end.
      583       if p-change-value > 0
      584       then do:
      585         if frame Dialog-Frame :scrollable = true
      586         then do:
      587           assign
      588             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      589             no-error .
      590           if error-status :error
      591           or error-status :get-message(1) <> ""
      592           then do:
      593             undo move_block, retry move_block .
      594           end.
      595         end.
      596         assign
      597           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      598           no-error .
      599         if error-status :error
      600         or error-status :get-message(1) <> ""
      601         then do:
      602           undo move_block, retry move_block .
      603         end.
      604         assign
      605           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      606           no-error .
      607         if error-status :error
      608         or error-status :get-message(1) <> ""
      609         then do:
      610           undo move_block, retry move_block .
      611         end.
      612         for each buf_temp-browse-handle
      613           where buf_temp-browse-handle.browse-type = 'height':u
      614         on error undo move_block, retry move_block
      615         :
      616           assign
      617             buf_temp-browse-handle.browse-handle :height
      618               = buf_temp-browse-handle.browse-handle :height + p-change-value
      619             no-error .
      620           if error-status :error
      621           or error-status :get-message(1) <> ""
      622           then do:
      623             undo move_block, retry move_block .
      624           end.
      625         end.
      626         for each buf_temp-diasize-handle
      627         on error undo move_block, retry move_block
      628         :
      629           assign
      630             v-object-handle = buf_temp-diasize-handle.handle-value
      631           .
      632           if v-object-handle <> v-diasize-resize-button
      633           then do:
      634             assign
      635               v-object-handle :row = v-object-handle :row + p-change-value
      636               no-error .
      637             if error-status :error
      638             or error-status :get-message(1) <> ""
      639             then do:
      640               undo move_block, retry move_block .
      641             end.
      642           end.
      643         end.
      644       end.
      645       else do:
      646         for each buf_temp-diasize-handle
      647         on error undo move_block, retry move_block
      648         :
      649           assign
      650             v-object-handle = buf_temp-diasize-handle.handle-value
      651           .
      652           if v-object-handle <> v-diasize-resize-button
      653           then do:
      654             assign
      655               v-object-handle :row = v-object-handle :row + p-change-value
      656               no-error .
      657             if error-status :error
      658             or error-status :get-message(1) <> ""
      659             then do:
      660               undo move_block, retry move_block .
      661             end.
      662           end.
      663         end.
      664         assign
      665           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      666           no-error .
      667         if error-status :error
      668         or error-status :get-message(1) <> ""
      669         then do:
      670           undo move_block, retry move_block .
      671         end.
      672         for each buf_temp-browse-handle
      673           where buf_temp-browse-handle.browse-type = 'height':u
      674         on error undo move_block, retry move_block
      675         :
      676           assign
      677             buf_temp-browse-handle.browse-handle :height
      678               = buf_temp-browse-handle.browse-handle :height + p-change-value
      679             no-error .
      680           if error-status :error
      681           or error-status :get-message(1) <> ""
      682           then do:
      683             undo move_block, retry move_block .
      684           end.
      685         end.
      686         assign
      687           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      688           no-error .
      689         if error-status :error
      690         or error-status :get-message(1) <> ""
      691         then do:
      692           undo move_block, retry move_block .
      693         end.
      694         if frame Dialog-Frame :scrollable = true
      695         then do:
      696           assign
      697             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      698             no-error .
      699           if error-status :error
      700           or error-status :get-message(1) <> ""
      701           then do:
      702             undo move_block, retry move_block .
      703           end.
      704         end.
      705       end.
      706       if p-move-resize = true
      707       then do:
      708         run diasize_position-resize-button in this-procedure .
      709       end.
      710       if v-diasize-wndstore = true
      711       then do:
      712         if connected("ub") = true
      713         then do:
      714           define variable v-cntxt-db-num        as integer   no-undo .
      715           define variable v-cntxt-userid        as character no-undo .
      716           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
      717                                             , OUTPUT v-cntxt-userid
      718                                             ) .
      719           run gbl/wndsizew.p
      720             (input  v-cntxt-db-num
      721             ,input  v-cntxt-userid
      722             ,input  v-diasize-proc-name
      723             ,input  'height':u
      724             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
      725             ) .
      726         end.
      727       end.
      728     end.
      729     assign
      730       v-diasize-change-size = false
      731     .
      732   end procedure.
      733   procedure diasize_set-height :
      734     define input  parameter p-new-height  as decimal   no-undo .
      735     define input  parameter p-move-resize as logical   no-undo .
      736     do
      737     on error undo, return error return-value
      738     :
      739       run diasize_change-height in this-procedure
      740         (input  (p-new-height - frame Dialog-Frame :height)
      741         ,input  p-move-resize
      742         ) .
      743     end.
      744   end procedure.
      745   procedure diasize_change-width :
      746     define input  parameter p-change-value as decimal   no-undo .
      747     define input  parameter p-move-resize  as logical   no-undo .
      748     define variable v-field-group-handle   as handle    no-undo .
      749     define variable v-object-handle        as handle    no-undo .
      750     define variable v-frame-width          as decimal   no-undo .
      751     define variable v-frame-virtual-width  as decimal   no-undo .
      752     define variable v-browse-width         as decimal   no-undo .
      753     define variable v-window-width         as decimal   no-undo .
      754     define variable v-window-virtual-width as decimal   no-undo .
      755     define variable v-change-sign          as integer   no-undo .
      756     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      757     define buffer buf_temp-browse-handle  for temp-browse-handle .
      758     if p-change-value > 0
      759     then do:
      760       if frame Dialog-Frame :width + p-change-value >
      761           session :width-chars
      762       then do:
      763         assign
      764           p-change-value = session :width-chars - frame Dialog-Frame :width
      765         .
      766         if p-change-value <= 0
      767         then do:
      768           run diasize_position-resize-button in this-procedure .
      769           return .
      770         end.
      771       end.
      772     end.
      773     if p-change-value < 0
      774     then do:
      775       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
      776       then do:
      777         assign
      778           p-change-value = v-diasize-orig-frame-width
      779                          - frame Dialog-Frame :width
      780         .
      781         if p-change-value >= 0
      782         then do:
      783           run diasize_position-resize-button in this-procedure .
      784           return .
      785         end.
      786       end.
      787     end.
      788     if p-change-value >= 0
      789     then do:
      790       assign
      791         v-change-sign = 1
      792       .
      793     end.
      794     else do:
      795       assign
      796         v-change-sign = -1
      797       .
      798     end.
      799     assign
      800       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      801     .
      802     if p-change-value = 0
      803     then do:
      804       run diasize_position-resize-button in this-procedure .
      805       return .
      806     end.
      807     move_block:
      808     do
      809     on error undo move_block, leave move_block
      810     :
      811       if retry
      812       then do:
      813         do
      814         on error undo move_block, leave move_block
      815         :
      816           if p-change-value > 0
      817           then do:
      818             for each buf_temp-diasize-handle
      819             on error undo, next
      820             :
      821               assign
      822                 v-object-handle = buf_temp-diasize-handle.handle-value
      823               .
      824               if v-object-handle <> v-diasize-resize-button
      825               then do:
      826                 assign
      827                   v-object-handle :col = buf_temp-diasize-handle.save-position
      828                 .
      829               end.
      830             end.
      831             assign
      832               v-diasize-browse-handle :width = v-browse-width
      833             .
      834             for each buf_temp-browse-handle
      835               where buf_temp-browse-handle.browse-type = 'width':u
      836             on error undo, next
      837             :
      838               assign
      839                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
      840               .
      841             end.
      842             assign
      843               frame Dialog-Frame :width = v-frame-width
      844             .
      845             if frame Dialog-Frame :scrollable = true
      846             then do:
      847               assign
      848                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
      849               .
      850             end.
      851             run diasize_position-resize-button in this-procedure .
      852           end.
      853           else do:
      854             if frame Dialog-Frame :scrollable = true
      855             then do:
      856               assign
      857                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
      858               .
      859             end.
      860             assign
      861               frame Dialog-Frame :width = v-frame-width
      862             .
      863             for each buf_temp-browse-handle
      864               where buf_temp-browse-handle.browse-type = 'width':u
      865             on error undo, next
      866             :
      867               assign
      868                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
      869               .
      870             end.
      871             assign
      872               v-diasize-browse-handle :width = v-browse-width
      873             .
      874             for each buf_temp-diasize-handle
      875             on error undo, next
      876             :
      877               assign
      878                 v-object-handle = buf_temp-diasize-handle.handle-value
      879               .
      880               if v-object-handle <> v-diasize-resize-button
      881               then do:
      882                 assign
      883                   v-object-handle :col = buf_temp-diasize-handle.save-position
      884                 .
      885               end.
      886             end.
      887             run diasize_position-resize-button in this-procedure .
      888           end.
      889           assign
      890             v-diasize-change-size = false
      891           .
      892           leave move_block .
      893         end.
      894       end.
      895       assign
      896         v-diasize-need-full-display = true
      897       .
      898       if v-diasize-change-size = false
      899       then do:
      900         assign
      901           v-diasize-change-size = true
      902         .
      903       end.
      904       else do:
      905         return .
      906       end.
      907       assign
      908         v-frame-width = frame Dialog-Frame :width
      909         v-frame-virtual-width = frame Dialog-Frame :virtual-width
      910         v-browse-width = v-diasize-browse-handle :width
      911       .
      912       for each buf_temp-browse-handle
      913         where buf_temp-browse-handle.browse-type = 'width':u
      914       :
      915         assign
      916           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
      917         .
      918       end.
      919       for each buf_temp-diasize-handle
      920       :
      921         delete buf_temp-diasize-handle .
      922       end.
      923       assign
      924         v-field-group-handle = frame Dialog-Frame :first-child
      925       .
      926       do while valid-handle(v-field-group-handle)
      927       :
      928         assign
      929           v-object-handle = v-field-group-handle :first-child
      930         .
      931         do while valid-handle(v-object-handle)
      932         :
      933           if  v-object-handle <> v-diasize-browse-handle :handle
      934           and v-object-handle <> v-diasize-resize-button
      935           and can-query(v-object-handle, "row")
      936           and can-query(v-object-handle, "height")
      937           and ( v-object-handle :col + v-object-handle :width
      938                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
      939               )
      940           then do:
      941             find first buf_temp-browse-handle
      942               where buf_temp-browse-handle.browse-type   = 'width':u
      943                 and buf_temp-browse-handle.browse-handle = v-object-handle
      944               no-error .
      945             if available buf_temp-browse-handle
      946             then do:
      947             end.
      948             else do:
      949               create buf_temp-diasize-handle .
      950               assign
      951                 buf_temp-diasize-handle.handle-value  = v-object-handle
      952                 buf_temp-diasize-handle.save-position = v-object-handle :col
      953               .
      954             end.
      955           end.
      956           assign
      957             v-object-handle = v-object-handle :next-sibling
      958           .
      959         end.
      960         assign
      961           v-field-group-handle = v-field-group-handle :next-sibling
      962         .
      963       end.
      964       do with frame Dialog-Frame
      965       :
      966         hide v-diasize-resize-button .
      967         v-diasize-resize-button :row = 1.
      968         v-diasize-resize-button :column = 1.
      969       end.
      970       if p-change-value > 0
      971       then do:
      972         if frame Dialog-Frame :scrollable = true
      973         then do:
      974           assign
      975             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
      976             no-error .
      977           if error-status :error
      978           or error-status :get-message(1) <> ""
      979           then do:
      980             undo move_block, retry move_block.
      981           end.
      982         end.
      983         assign
      984           frame Dialog-Frame :width = v-frame-width + p-change-value
      985           no-error .
      986         if error-status :error
      987         or error-status :get-message(1) <> ""
      988         then do:
      989           undo move_block, retry move_block.
      990         end.
      991         assign
      992           v-diasize-browse-handle :width = v-browse-width + p-change-value
      993         no-error .
      994         if error-status :error
      995         or error-status :get-message(1) <> ""
      996         then do:
      997           undo move_block, retry move_block.
      998         end.
      999         for each buf_temp-browse-handle
     1000           where buf_temp-browse-handle.browse-type = 'width':u
     1001         on error undo move_block, retry move_block
     1002         :
     1003           assign
     1004             buf_temp-browse-handle.browse-handle :width
     1005               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1006             no-error .
     1007           if error-status :error
     1008           or error-status :get-message(1) <> ""
     1009           then do:
     1010             undo move_block, retry move_block .
     1011           end.
     1012         end.
     1013         for each buf_temp-diasize-handle
     1014         on error undo move_block, retry move_block
     1015         :
     1016           assign
     1017             v-object-handle = buf_temp-diasize-handle.handle-value
     1018           .
     1019           if v-object-handle <> v-diasize-resize-button
     1020           then do:
     1021             assign
     1022               v-object-handle :col = v-object-handle :col + p-change-value
     1023               no-error .
     1024             if error-status :error
     1025             or error-status :get-message(1) <> ""
     1026             then do:
     1027               undo move_block, retry move_block .
     1028             end.
     1029           end.
     1030         end.
     1031       end.
     1032       else do:
     1033         for each buf_temp-diasize-handle
     1034         on error undo move_block, retry move_block
     1035         :
     1036           assign
     1037             v-object-handle = buf_temp-diasize-handle.handle-value
     1038           .
     1039           if v-object-handle <> v-diasize-resize-button
     1040           then do:
     1041             assign
     1042               v-object-handle :col = v-object-handle :col + p-change-value
     1043               no-error .
     1044             if error-status :error
     1045             or error-status :get-message(1) <> ""
     1046             then do:
     1047               undo move_block, retry move_block .
     1048             end.
     1049           end.
     1050         end.
     1051         for each buf_temp-browse-handle
     1052           where buf_temp-browse-handle.browse-type = 'width':u
     1053         on error undo move_block, retry move_block
     1054         :
     1055           assign
     1056             buf_temp-browse-handle.browse-handle :width
     1057               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1058             no-error .
     1059           if error-status :error
     1060           or error-status :get-message(1) <> ""
     1061           then do:
     1062             undo move_block, retry move_block .
     1063           end.
     1064         end.
     1065         assign
     1066           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1067           no-error .
     1068         if error-status :error
     1069         or error-status :get-message(1) <> ""
     1070         then do:
     1071           undo move_block, retry move_block.
     1072         end.
     1073         assign
     1074           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1075         no-error .
     1076         if error-status :error
     1077         or error-status :get-message(1) <> ""
     1078         then do:
     1079           undo move_block, retry move_block.
     1080         end.
     1081         if frame Dialog-Frame :scrollable = true
     1082         then do:
     1083           assign
     1084             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1085           no-error .
     1086           if error-status :error
     1087           or error-status :get-message(1) <> ""
     1088           then do:
     1089             undo move_block, retry move_block.
     1090           end.
     1091         end.
     1092       end.
     1093       if p-move-resize
     1094       then do:
     1095         run diasize_position-resize-button in this-procedure .
     1096       end.
     1097       if v-diasize-wndstore = true
     1098       then do:
     1099         if connected("ub") = true
     1100         then do:
     1101           define variable v-cntxt-db-num        as integer   no-undo .
     1102           define variable v-cntxt-userid        as character no-undo .
     1103           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1104                                             , OUTPUT v-cntxt-userid
     1105                                             ) .
     1106           run gbl/wndsizew.p
     1107             (input  v-cntxt-db-num
     1108             ,input  v-cntxt-userid
     1109             ,input  v-diasize-proc-name
     1110             ,input  'width':u
     1111             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1112             ) .
     1113         end.
     1114       end.
     1115     end.
     1116     assign
     1117       v-diasize-change-size = false
     1118     .
     1119   end procedure.
     1120   procedure diasize_set-width :
     1121     define input  parameter p-new-width  as decimal   no-undo .
     1122     define input  parameter p-move-resize as logical   no-undo .
     1123     do
     1124     on error undo, return error return-value
     1125     :
     1126       run diasize_change-width in this-procedure
     1127         (input  (p-new-width - frame Dialog-Frame :width)
     1128         ,input  p-move-resize
     1129         ) .
     1130     end.
     1131   end procedure.
     1132   procedure diasize_position-resize-button :
     1133     do with frame Dialog-Frame
     1134     :
     1135       hide v-diasize-resize-button .
     1136       assign
     1137         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1138                     - 1
     1139                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1140         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1141                     - 1
     1142                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1143       .
     1144       view v-diasize-resize-button .
     1145     end.
     1146   end procedure.
     1147   on alt-right anywhere
     1148   do:
     1149     run diasize_change-width in this-procedure
     1150       (input 1
     1151       ,input true
     1152       ) .
     1153     return no-apply .
     1154   end.
     1155   on alt-left anywhere
     1156   do:
     1157     run diasize_change-width in this-procedure
     1158       (input -1
     1159       ,input true
     1160       ) .
     1161     return no-apply .
     1162   end.
     1163   on alt-down anywhere
     1164   do:
     1165     run diasize_change-height in this-procedure
     1166       (input 1
     1167       ,input true
     1168       ) .
     1169     return no-apply .
     1170   end.
     1171   on alt-up anywhere
     1172   do:
     1173     run diasize_change-height in this-procedure
     1174       (input -1
     1175       ,input true
     1176       ) .
     1177     return no-apply .
     1178   end.
     1179   on alt-enter of frame Dialog-Frame
     1180   do:
     1181     run diasize_maximize in this-procedure
     1182       (input  ?
     1183       ).
     1184     return no-apply .
     1185   end.
     1186   procedure diasize_end-move :
     1187     do
     1188     on error undo, return error return-value
     1189     :
     1190       define variable v-row-delta as decimal   no-undo .
     1191       define variable v-col-delta as decimal   no-undo .
     1192       define variable v-new-row as decimal   no-undo .
     1193       define variable v-new-col as decimal   no-undo .
     1194       assign
     1195         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1196         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1197       .
     1198       assign
     1199         v-row-delta = v-new-row - frame Dialog-Frame :height
     1200         v-col-delta = v-new-col - frame Dialog-Frame :width
     1201       .
     1202       run diasize_change-height in this-procedure
     1203         (input v-row-delta
     1204         ,input true
     1205         ) .
     1206       run diasize_change-width in this-procedure
     1207         (input v-col-delta
     1208         ,input true
     1209         ) .
     1210     end.
     1211   end procedure.
     1212   procedure diasize_maximize :
     1213     define input  parameter p-action as logical   no-undo .
     1214     do
     1215     on error undo, return error return-value
     1216     :
     1217       if p-action = ?
     1218       then do:
     1219         if v-diasize-need-maximize = true
     1220         then do:
     1221           assign
     1222             p-action = true
     1223           .
     1224         end.
     1225         else do:
     1226           assign
     1227             p-action = false
     1228           .
     1229         end.
     1230       end.
     1231       if p-action = true
     1232       then do:
     1233         run diasize_change-height in this-procedure
     1234           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1235               - frame Dialog-Frame :height-chars
     1236           ,input true
     1237           ) .
     1238         run diasize_change-width in this-procedure
     1239           (input session :width-chars
     1240               - frame Dialog-Frame :width-chars
     1241           ,input true
     1242           ) .
     1243         assign
     1244           v-diasize-need-maximize = false
     1245         .
     1246       end.
     1247       else do:
     1248         run diasize_change-width in this-procedure
     1249           (input v-diasize-orig-frame-width
     1250               - frame Dialog-Frame :width-chars
     1251           ,input true
     1252           ) .
     1253         run diasize_change-height in this-procedure
     1254           (input v-diasize-orig-frame-height
     1255               - frame Dialog-Frame :height-chars
     1256           ,input true
     1257           ) .
     1258         assign
     1259           v-diasize-need-maximize = true
     1260         .
     1261       end.
     1262     end.
     1263   end procedure.
     1264   procedure diasize_restore-orig-size :
     1265     do
     1266     on error undo, return error return-value
     1267     :
     1268       assign
     1269         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1270         v-diasize-current-frame-height = frame Dialog-Frame :height
     1271       .
     1272       run diasize_set-height in this-procedure
     1273         (input  v-diasize-orig-frame-height
     1274         ,input  true
     1275         ) .
     1276       run diasize_set-width in this-procedure
     1277         (input  v-diasize-orig-frame-width
     1278         ,input  true
     1279         ) .
     1280     end.
     1281   end procedure.
     1282   procedure diasize_restore-current-size :
     1283     do
     1284     on error undo, return error return-value
     1285     :
     1286       run diasize_set-height in this-procedure
     1287         (input  v-diasize-current-frame-height
     1288         ,input  true
     1289         ) .
     1290       run diasize_set-width in this-procedure
     1291         (input  v-diasize-current-frame-width
     1292         ,input  true
     1293         ) .
     1294     end.
     1295   end procedure.
     1296   procedure diasize_set-browse-handle :
     1297     define input  parameter p-browse-handle as handle   no-undo .
     1298     define buffer buf_temp-browse-handle for temp-browse-handle .
     1299     do
     1300     on error undo, return error return-value
     1301     :
     1302       assign
     1303         v-diasize-browse-handle = p-browse-handle
     1304       .
     1305       for each buf_temp-browse-handle
     1306       on error undo, return error return-value
     1307       :
     1308         delete buf_temp-browse-handle .
     1309       end.
     1310     end.
     1311   end procedure.
     1312   procedure diasize_add_browse :
     1313     define input  parameter p-browse-type   as character no-undo .
     1314     define input  parameter p-browse-handle as handle    no-undo .
     1315     define buffer buf_temp-browse-handle for temp-browse-handle .
     1316     do
     1317     on error undo, return error return-value
     1318     :
     1319       assign
     1320         v-diasize-browse-number = v-diasize-browse-number + 1
     1321       .
     1322       create buf_temp-browse-handle .
     1323       assign
     1324         buf_temp-browse-handle.browse-type   = p-browse-type
     1325         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1326         buf_temp-browse-handle.browse-handle = p-browse-handle
     1327       .
     1328     end.
     1329   end procedure.
     1330   procedure diasize_init :
     1331     define variable v-default-value    as logical   no-undo .
     1332     define variable v-restore-saved    as logical   no-undo .
     1333     define variable v-resize-value-str as character no-undo .
     1334     do
     1335     on error undo, return error return-value
     1336     :
     1337       do with frame Dialog-Frame
     1338       :
     1339         assign
     1340           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1341           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1342           v-diasize-browse-handle     = tt-condition-keeping.des :handle
     1343         .
     1344         create button v-diasize-resize-button
     1345         assign
     1346           parent        = frame Dialog-Frame :first-child
     1347           label         = "s"
     1348           height-pixels = 16
     1349           width-pixels  = 16
     1350           visible       = true
     1351           sensitive     = true
     1352           movable       = true
     1353           triggers:
     1354             on end-move persistent run diasize_end-move in this-procedure .
     1355           end triggers.
     1356         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1357         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1358         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1359         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1360         assign
     1361           v-diasize-wndmax = false
     1362         .
     1363         if connected("ub") = true
     1364         then do:
     1365           define variable v-cntxt-db-num        as integer   no-undo .
     1366           define variable v-cntxt-userid        as character no-undo .
     1367           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1368                                             , OUTPUT v-cntxt-userid
     1369                                             ) .
     1370           run gbl/wndpar_r.p
     1371             (input  v-cntxt-db-num
     1372             ,input  v-cntxt-userid
     1373             ,input  'wndmax':U
     1374             ,output v-diasize-wndmax
     1375             ,output v-default-value
     1376             ) .
     1377         end.
     1378         assign
     1379           v-diasize-wndstore = false
     1380         .
     1381         if connected("ub") = true
     1382         then do:
     1383           run gbl/wndpar_r.p
     1384             (input  v-cntxt-db-num
     1385             ,input  v-cntxt-userid
     1386             ,input  'wndstore':U
     1387             ,output v-diasize-wndstore
     1388             ,output v-default-value
     1389             ) .
     1390         end.
     1391         assign
     1392           v-diasize-proc-name = entry(1, program-name(2), '.')
     1393         .
     1394         if v-diasize-wndstore = true
     1395         then do:
     1396           assign
     1397             v-restore-saved = false
     1398           .
     1399           if connected("ub") = true
     1400           then do:
     1401             run gbl/wndsizer.p
     1402               (input  v-cntxt-db-num
     1403               ,input  v-cntxt-userid
     1404               ,input  v-diasize-proc-name
     1405               ,input  'height':u
     1406               ,output v-resize-value-str
     1407               ) .
     1408             if v-resize-value-str <> '':U
     1409             then do:
     1410               run diasize_change-height in this-procedure
     1411                 (input  integer(v-resize-value-str)
     1412                 ,input  true
     1413                 ) .
     1414               assign
     1415                 v-restore-saved = true
     1416               .
     1417             end.
     1418           end.
     1419           if connected("ub") = true
     1420           then do:
     1421             run gbl/wndsizer.p
     1422               (input  v-cntxt-db-num
     1423               ,input  v-cntxt-userid
     1424               ,input  v-diasize-proc-name
     1425               ,input  'width':u
     1426               ,output v-resize-value-str
     1427               ) .
     1428             if v-resize-value-str <> '':U
     1429             then do:
     1430               run diasize_change-width in this-procedure
     1431                 (input  integer(v-resize-value-str)
     1432                 ,input  true
     1433                 ) .
     1434               assign
     1435                 v-restore-saved = true
     1436               .
     1437             end.
     1438           end.
     1439           if v-restore-saved <> true
     1440           then do:
     1441             if v-diasize-wndmax = true
     1442             then do:
     1443               run diasize_maximize in this-procedure
     1444                 (input  true
     1445                 ) .
     1446             end.
     1447           end.
     1448         end.
     1449         else do:
     1450           if v-diasize-wndmax = true
     1451           then do:
     1452             run diasize_maximize in this-procedure
     1453               (input  true
     1454               ) .
     1455           end.
     1456         end.
     1457       end.
     1458     end.
     1459   end procedure.
     1460   procedure diasize_need-full-display :
     1461     define output parameter p-need-full-display as logical   no-undo .
     1462     do
     1463     on error undo, return error return-value
     1464     :
     1465       assign
     1466         p-need-full-display = v-diasize-need-full-display
     1467       .
     1468       assign
     1469         v-diasize-need-full-display = false
     1470       .
     1471     end.
     1472   end procedure.
     1473   procedure get-context :
     1474      define output parameter p-db-num as integer          no-undo.
     1475      define output parameter p-user-id as character        no-undo.
     1476      define variable v-login               as character    no-undo.
     1477      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1478      define buffer buf_user-login  for ub.user-login .
     1479      do
     1480      on error undo, return error
     1481      :
     1482            FIND FIRST buf_sys-ctrl no-lock.
     1483            ASSIGN
     1484               v-login = USERID("ub")
     1485               p-db-num = buf_sys-ctrl.db-num
     1486            .
     1487            FIND FIRST buf_user-login
     1488                 WHERE buf_user-login.db-num = p-db-num
     1489                   AND buf_user-login.user-login = v-login
     1490                 no-lock
     1491                 no-error
     1492                 .
     1493            IF AVAILABLE buf_user-login
     1494            THEN DO:
     1495               assign
     1496                  p-user-id = buf_user-login.user-id
     1497               .
     1498            END.
     1499      end.
     1500   end procedure.
     1501   run diasize_init in this-procedure .
     1502   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1503   ON TAB ANYWHERE
     1504   DO:
     1505   define variable ii as integer no-undo .
     1506   define variable fh as widget-handle no-undo .
     1507   define variable hh as widget-handle no-undo .
     1508   define variable v-next-widget-name as character no-undo .
     1509   if v-tab-order <> '' then do:
     1510     if self:type = "TOGGLE-BOX" then
     1511     self:BGCOLOR = ?.
     1512     assign
     1513     ii = lookup(self:name, v-tab-order).
     1514     assign
     1515     ii = ii + 1
     1516     v-next-widget-name = entry(ii, v-tab-order)
     1517     no-error .
     1518     if error-status:error then do:
     1519       assign
     1520       ii = 1
     1521       v-next-widget-name = entry( ii, v-tab-order)
     1522       .
     1523     end.
     1524     assign
     1525     fh = frame Dialog-Frame:first-child
     1526     hh = fh:first-child
     1527     .
     1528     do while valid-handle(hh):
     1529       if hh:name = v-next-widget-name then do:
     1530         if hh:sensitive  = yes
     1531         AND hh:visible = yes then do:
     1532           APPLY "ENTRY" to hh.
     1533           return no-apply.
     1534         end.
     1535         else do:
     1536           APPLY "TAB" to hh.
     1537           return no-apply.
     1538         end.
     1539       end.
     1540       hh = hh:next-sibling.
     1541     end.
     1542   end.
     1543   END.
     1544   ON BACK-TAB ANYWHERE
     1545   DO:
     1546   define variable ii as integer no-undo .
     1547   define variable fh as widget-handle no-undo .
     1548   define variable hh as widget-handle no-undo .
     1549   define variable v-next-widget-name as character no-undo .
     1550   if v-tab-order <> '' then do:
     1551     assign
     1552     ii = lookup(self:name, v-tab-order).
     1553     .
     1554     assign
     1555     ii = (if ii = 1
     1556           then  num-entries(v-tab-order)
     1557           else ii - 1
     1558           )
     1559     v-next-widget-name = entry(ii, v-tab-order)
     1560     .
     1561     assign
     1562     fh = frame Dialog-Frame:first-child
     1563     hh = fh:first-child
     1564     .
     1565     do while valid-handle(hh):
     1566       if hh:name = v-next-widget-name then do:
     1567         if hh:sensitive  = yes
     1568         AND hh:visible = yes then do:
     1569           APPLY "ENTRY" to hh.
     1570           return no-apply.
     1571         end.
     1572         else do:
     1573         APPLY "BACK-TAB" to hh.
     1574         return no-apply.
     1575         end.
     1576       end.
     1577       hh = hh:next-sibling.
     1578     end.
     1579     end.
     1580   END.
     1581   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1582   ON RETURN ANYWHERE
     1583   DO:
     1584   define variable ii as integer no-undo .
     1585   define variable fh as widget-handle no-undo .
     1586   define variable hh as widget-handle no-undo .
     1587   define variable v-next-widget-name as character no-undo .
     1588     if v-tab-order <> '' then do:
     1589       assign
     1590       ii = lookup(self:name, v-tab-order).
     1591       if ii = num-entries(v-tab-order) then do:
     1592           APPLY 'CHOOSE' TO b-exit in frame Dialog-Frame.
     1593           return no-apply.
     1594       end.
     1595       if self:type <> "BUTTON" and
     1596         self:type <> "EDITOR"  then do:
     1597         run proc-move-forward in this-procedure .
     1598         return no-apply.
     1599       end.
     1600       if self:type = "BUTTON" then do:
     1601         APPLY "CHOOSE" to self.
     1602       end.
     1603       if self:type = "TOGGLE-BOX" then
     1604       self:BGCOLOR = ?.
     1605       assign
     1606       ii = ii + 1
     1607       v-next-widget-name = entry(ii, v-tab-order)
     1608       no-error .
     1609       if error-status:error then do:
     1610         assign
     1611         ii = 1
     1612         v-next-widget-name = entry( ii, v-tab-order)
     1613         .
     1614       end.
     1615       assign
     1616       fh = frame Dialog-Frame:first-child
     1617       hh = fh:first-child
     1618       .
     1619       do while valid-handle(hh):
     1620         if hh:name = v-next-widget-name then do:
     1621           if hh:sensitive  = yes
     1622           AND hh:visible = yes then do:
     1623             if hh:type = "TOGGLE-BOX":U then do:
     1624               assign
     1625               hh:BGcolor = 1
     1626               .
     1627             end.
     1628             APPLY "ENTRY" to hh.
     1629             return no-apply.
     1630           end.
     1631           else do:
     1632             APPLY "TAB" to hh.
     1633             return no-apply.
     1634           end.
     1635         end.
     1636         hh = hh:next-sibling.
     1637       end.
     1638     end.
     1639   END.
     1640   procedure proc-move-forward :
     1641   define variable ii as integer no-undo .
     1642   define variable fh as widget-handle no-undo .
     1643   define variable hh as widget-handle no-undo .
     1644   define variable v-next-widget-name as character no-undo .
     1645   do
     1646   on error undo, return error
     1647   :
     1648     if v-tab-order <> '' then do:
     1649       if self:type = "TOGGLE-BOX" then
     1650       self:BGCOLOR = ?.
     1651       assign
     1652       ii = lookup(self:name, v-tab-order).
     1653       assign
     1654       ii = ii + 1
     1655       v-next-widget-name = entry(ii, v-tab-order)
     1656       no-error .
     1657       if error-status:error then do:
     1658         assign
     1659         ii = 1
     1660         v-next-widget-name = entry( ii, v-tab-order)
     1661         .
     1662       end.
     1663       assign
     1664       fh = frame Dialog-Frame:first-child
     1665       hh = fh:first-child
     1666       .
     1667       do while valid-handle(hh):
     1668         if hh:name = v-next-widget-name then do:
     1669           if hh:sensitive  = yes
     1670           AND hh:visible = yes then do:
     1671             if hh:type = "TOGGLE-BOX":U then do:
     1672               assign
     1673               hh:BGcolor = 1
     1674               .
     1675             end.
     1676             APPLY "ENTRY" to hh.
     1677             return.
     1678           end.
     1679           else do:
     1680             assign
     1681             ii = ii + 1
     1682             v-next-widget-name = entry(ii, v-tab-order)
     1683             no-error .
     1684             if error-status:error then do:
     1685               assign
     1686               ii = 1
     1687               v-next-widget-name = entry( ii, v-tab-order)
     1688               .
     1689             end.
     1690           end.
     1691         end.
     1692         hh = hh:next-sibling.
     1693       end.
     1694     end.
     1695   end.
     1696   end procedure.
     1697   MAIN-BLOCK:
     1698   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1699      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1700    if p-mode  <> 'ДОБАВЛЕНИЕ':U
     1701    and p-mode <> 'ИЗМЕНЕНИЕ':U
     1702    and p-mode <> 'ПРОСМОТР':U
     1703    then do:
     1704       message
     1705       vss-workfile vss-revision vss-description skip
     1706       "Неверное значение параметров вызова p-mode"  p-mode
     1707       view-as alert-box ERROR.
     1708       undo, return error.
     1709    end.
     1710      find first X_curr_clients no-lock where
     1711               X_curr_clients.obj-type = p-curr-obj-type
     1712          AND X_curr_clients.obj-code = p-curr-obj-code no-error.
     1713     if not available X_curr_clients then do:
     1714       message
     1715       vss-workfile vss-revision vss-description skip
     1716       "Неверное значение параметра вызова p-curr-obj-type p-curr-obj-code"
     1717       p-curr-obj-type p-curr-obj-code
     1718       view-as alert-box ERROR.
     1719       return error .
     1720     end.
     1721   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1722   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
     1723     (output v-db-num
     1724     )  .
     1725   IF v-db-num <> 0
     1726   AND (p-mode = 'ДОБАВЛЕНИЕ':U
     1727        OR p-mode = 'ИЗМЕНЕНИЕ':U ) THEN DO:
     1728         message
     1729       vss-workfile vss-revision vss-description skip
     1730       "Неверное значение параметра вызова p-mode" p-mode skip
     1731       "Нельзя редактировать запись УСЛОВИЯ ХРАНЕНИЯ в УБД"
     1732       view-as alert-box ERROR.
     1733       return error .
     1734   END.
     1735     for each tt-condition-keeping:
     1736       delete tt-condition-keeping.
     1737     end.
     1738     if p-mode = 'ИЗМЕНЕНИЕ':U
     1739     or p-mode = 'ПРОСМОТР':U then do:
     1740       if p-mode = 'ИЗМЕНЕНИЕ':U then do:
     1741         find first locked_condition-keeping EXclusive-lock where
     1742                      recid(locked_condition-keeping) = p-doc-rec no-wait no-error.
     1743         if locked locked_condition-keeping then do:
     1744           message
     1745           vss-workfile vss-revision vss-description skip
     1746            "Запись УСЛОВИЯ ХРАНЕНИЯ занята"
     1747           view-as alert-box error .
     1748           undo, return error.
     1749         end.
     1750       end.
     1751       else do:
     1752         find first locked_condition-keeping no-lock where
     1753                          recid(locked_condition-keeping) = p-doc-rec no-error .
     1754         if not avail locked_condition-keeping then do:
     1755           find first locked_condition-keeping no-lock where
     1756                      locked_condition-keeping.cond-keep-code = p-cond-keep-code no-error .
     1757         end.
     1758       end.
     1759       if not available locked_condition-keeping then do:
     1760         message
     1761         vss-workfile vss-revision vss-description skip
     1762         "Не найдена запись УСЛОВИЯ ХРАНЕНИЯ"
     1763         view-as alert-box error .
     1764         undo, return error.
     1765       end.
     1766       create tt-condition-keeping.
     1767       buffer-copy locked_condition-keeping to tt-condition-keeping.
     1768      end.
     1769      else do:
     1770             create tt-condition-keeping.
     1771             assign
     1772            tt-condition-keeping.cond-keep-code = v-last-code + 1
     1773            .
     1774      end.
     1775         ASSIGN varsts = entry (lookup (STRING(tt-condition-keeping.sts), '0,1,50,99':U), 'тек,удал,блок,удаление':U).
     1776     RUN Myenable.
     1777     WAIT-FOR GO OF FRAME Dialog-Frame.
     1778   END.
     1779   RUN disable_UI.
     1780   PROCEDURE disable_UI :
     1781     HIDE FRAME Dialog-Frame.
     1782   END PROCEDURE.
     1783   PROCEDURE enable_UI :
     1784     OPEN QUERY Dialog-Frame FOR EACH tt-condition-keeping SHARE-LOCK.
     1785     GET FIRST Dialog-Frame.
     1786     DISPLAY varsts
     1787         WITH FRAME Dialog-Frame.
     1788     IF AVAILABLE tt-condition-keeping THEN
     1789       DISPLAY tt-condition-keeping.cond-keep-code
     1790             tt-condition-keeping.cond-keep-name tt-condition-keeping.t-mode-from
     1791             tt-condition-keeping.t-mode-to tt-condition-keeping.h-mode-from
     1792             tt-condition-keeping.h-mode-to tt-condition-keeping.des
     1793         WITH FRAME Dialog-Frame.
     1794     ENABLE B-exit b-quit B-Hist B-Help tt-condition-keeping.cond-keep-code
     1795            tt-condition-keeping.cond-keep-name tt-condition-keeping.t-mode-from
     1796            tt-condition-keeping.t-mode-to tt-condition-keeping.h-mode-from
     1797            tt-condition-keeping.h-mode-to tt-condition-keeping.des
     1798         WITH FRAME Dialog-Frame.
     1799     VIEW FRAME Dialog-Frame.
     1800   END PROCEDURE.
     1801   PROCEDURE MyENable :
     1802   case p-mode:
     1803     when 'ДОБАВЛЕНИЕ':U then do:
     1804       display
     1805       ? @ tt-condition-keeping.cond-keep-code
     1806       WITH FRAME Dialog-Frame.
     1807     end.
     1808     otherwise do:
     1809       IF AVAILABLE tt-condition-keeping THEN
     1810       DISPLAY
     1811       tt-condition-keeping.cond-keep-code
     1812       tt-condition-keeping.cond-keep-name
     1813       tt-condition-keeping.h-mode-from
     1814       tt-condition-keeping.h-mode-to
     1815       tt-condition-keeping.t-mode-from
     1816       tt-condition-keeping.t-mode-to
     1817       tt-condition-keeping.des
     1818       varsts
     1819       WITH FRAME Dialog-Frame.
     1820     end.
     1821   END CASE.
     1822   if p-mode = 'ПРОСМОТР':U then do:
     1823   assign
     1824   b-quit:label = "&Выход"
     1825   .
     1826   hide
     1827   b-exit in frame Dialog-Frame.
     1828   end.
     1829   ENABLE
     1830   B-exit when p-mode <> 'ПРОСМОТР':U
     1831   b-quit
     1832   B-Hist when p-mode <> 'ДОБАВЛЕНИЕ':U
     1833   B-Help
     1834   tt-condition-keeping.cond-keep-name when p-mode <> 'ПРОСМОТР':U
     1835   tt-condition-keeping.des
     1836   tt-condition-keeping.h-mode-from  when p-mode <> 'ПРОСМОТР':U
     1837   tt-condition-keeping.h-mode-to    when p-mode <> 'ПРОСМОТР':U
     1838   tt-condition-keeping.t-mode-from  when p-mode <> 'ПРОСМОТР':U
     1839   tt-condition-keeping.t-mode-to    when p-mode <> 'ПРОСМОТР':U
     1840   WITH FRAME Dialog-Frame.
     1841   if p-mode = 'ПРОСМОТР':U then do:
     1842     assign
     1843       tt-condition-keeping.des:read-only in frame Dialog-Frame = yes.
     1844   end.
     1845   VIEW FRAME Dialog-Frame.
     1846   END PROCEDURE.
     1847   PROCEDURE Proc-save :
     1848   DEFINE BUFFER bf_condition-keeping FOR ub.condition-keeping.
     1849   if p-mode = 'ПРОСМОТР':U then do:
     1850      return error.
     1851   end.
     1852   FIND FIRST bf_condition-keeping WHERE bf_condition-keeping.sts            =  0 AND
     1853                                         bf_condition-keeping.cond-keep-name =  INPUT FRAME Dialog-Frame tt-condition-keeping.cond-keep-name AND
     1854                                         bf_condition-keeping.cond-keep-code <> tt-condition-keeping.cond-keep-code NO-LOCK NO-ERROR.
     1855   IF AVAILABLE bf_condition-keeping THEN DO:
     1856     MESSAGE "Уже есть условие хранение со статусом <тек> с таким названием." VIEW-AS ALERT-BOX.
     1857     RETURN ERROR.
     1858   END.
     1859   IF INPUT FRAME Dialog-Frame tt-condition-keeping.h-mode-to < INPUT FRAME Dialog-Frame tt-condition-keeping.h-mode-from THEN DO:
     1860       MESSAGE "Влажность 'до' меньше влажности 'от'." VIEW-AS ALERT-BOX.
     1861       RETURN ERROR.
     1862   END.
     1863   IF INPUT FRAME Dialog-Frame tt-condition-keeping.t-mode-to < INPUT FRAME Dialog-Frame tt-condition-keeping.t-mode-from THEN DO:
     1864       MESSAGE "Температура 'до' меньше температуры 'от'." VIEW-AS ALERT-BOX.
     1865       RETURN ERROR.
     1866   END.
     1867   if not available tt-condition-keeping then do:
     1868       create tt-condition-keeping.
     1869   end.
     1870   assign
     1871   frame Dialog-Frame
     1872   tt-condition-keeping.cond-keep-code
     1873   tt-condition-keeping.cond-keep-name
     1874   tt-condition-keeping.h-mode-from
     1875   tt-condition-keeping.h-mode-to
     1876   tt-condition-keeping.t-mode-from
     1877   tt-condition-keeping.t-mode-to
     1878   .
     1879   assign
     1880     tt-condition-keeping.des = tt-condition-keeping.des:SCREEN-VALUE.
     1881    run ref/cndkeep1.p (
     1882   input-output p-doc-rec
     1883   ,input p-mode
     1884   ,input tt-condition-keeping.cond-keep-code
     1885   ,input tt-condition-keeping.cond-keep-name
     1886   ,input tt-condition-keeping.des
     1887   ,input tt-condition-keeping.h-mode-from
     1888   ,input tt-condition-keeping.h-mode-to
     1889   ,input tt-condition-keeping.t-mode-from
     1890   ,input tt-condition-keeping.t-mode-to
     1891   )
     1892   no-error.
     1893   if error-status:error then do:
     1894   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1895   define variable fh as widget-handle no-undo .
     1896   define variable hh as widget-handle no-undo .
     1897   define variable rv as character no-undo .
     1898   assign
     1899   rv = entry(1, return-value , chr(4)).
     1900   if rv <> "":U then do:
     1901     assign
     1902     fh = frame Dialog-Frame:first-child
     1903     hh = fh:first-child
     1904     .
     1905     do while valid-handle(hh):
     1906       if hh:name = rv then do:
     1907         APPLY "ENTRY" to hh.
     1908         undo ,
     1909         return error.
     1910       end.
     1911       hh = hh:next-sibling.
     1912     end.
     1913   end.
     1914     undo, return error.
     1915   end.
     1916   END PROCEDURE.
