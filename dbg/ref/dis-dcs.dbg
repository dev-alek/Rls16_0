     2885       if l-filter-open-21 = false then do:
     2886         message
     2887           "Ошибка при фильтрации / сортировке" skip
     2888           "Будут показаны записи без учета фильтра" skip
     2889           view-as alert-box .
     2890       end.
     2891       else do:
     2892           assign
     2893             l-query-was-opened = true
     2894           .
     2895       end.
     2896     end.
     2897     if l-filter-open-21 = false then do:
     2898       OPEN QUERY br-dis-dc-rule FOR EACH X_dis-dc-rule
     2899         where  TRUE
     2900       , FIRST X_dis-card no-lock where X_dis-card.d-card = X_dis-dc-rule.d-card,                                  FIRST X_clients no-lock where X_clients.obj-type = X_Dis-card.cli-type and                                                                X_clients.obj-code = X_dis-card.cli-code
     2901         indexed-reposition
     2902     .
     2903         assign
     2904           l-query-was-opened = true
     2905         .
     2906     end.
     2907   end.
     2908   else do:
     2909     assign
     2910       v-doc-rec = recid( X_dis-dc-rule )
     2911     .
     2912     do
     2913     on stop undo, leave
     2914     on error undo, leave
     2915     :
     2916       if QUERY br-dis-dc-rule:handle:get-buffer-handle(1) = (buffer X_dis-dc-rule:handle) then do:
     2917         assign
     2918         parameter-2-21 = (if p-find-next then "true":u else "false":u )
     2919         parameter-4-21 =
     2920           "where ":u + " TRUE " + " ":u + where-phrase-21 + " ":u + p-find-condition + " " + ""
     2921         parameter-5-21 = "  "
     2922       .
     2923         run fltopend_fltfindd in this-procedure  (
     2924                             input this-procedure:handle
     2925                             ,input QUERY br-dis-dc-rule:handle
     2926                             ,input rowid(X_dis-dc-rule)
     2927                             ,input logical(parameter-2-21)
     2928                             ,input no-lock
     2929                             ,input (buffer X_dis-dc-rule:handle)
     2930                             ,input parameter-4-21
     2931                             ,input parameter-5-21
     2932                             ) no-error.
     2933         .
     2934         assign
     2935           v-doc-rec = integer(return-value)
     2936           v-fltopend-rowid[1] = ?
     2937         .
     2938       end.
     2939       else do:
     2940         assign
     2941         parameter-2-21 = (if p-find-next then "true":u else "false":u )
     2942         parameter-3-21 =  "FOR EACH X_dis-dc-rule"
     2943         parameter-4-21 =
     2944           (
     2945             if (" TRUE " + " " + where-phrase-21) <> ""
     2946             then " TRUE " + " " + where-phrase-21
     2947             else "true"
     2948           )
     2949         parameter-5-21 = (" " + "" + " " + ", FIRST X_dis-card no-lock where X_dis-card.d-card = X_dis-dc-rule.d-card,                                  FIRST X_clients no-lock where X_clients.obj-type = X_Dis-card.cli-type and                                                                X_clients.obj-code = X_dis-card.cli-code" + " " + p-find-condition)
     2950         parameter-6-21 = if sort-phrase-21 = ''
     2951                              then
     2952           (
     2953           " " + "  " +
     2954             " " + sort-column-phrase +
     2955           " " + "  "
     2956           )
     2957                              else
     2958           (
     2959           " " + "  " +
     2960             " " + sort-column-phrase +
     2961           " " + sort-phrase-21
     2962           )
     2963         parameter-7-21 =
     2964           " indexed-reposition  "
     2965       .
     2966         run fltopend_fltfindq in this-procedure  (
     2967                             input this-procedure:handle
     2968                             ,input QUERY br-dis-dc-rule:handle
     2969                             ,input logical(parameter-2-21)
     2970                             ,input no-lock
     2971                             ,input parameter-3-21
     2972                             ,input parameter-4-21
     2973                             ,input parameter-5-21
     2974                             ,input parameter-6-21
     2975                             ,input parameter-7-21
     2976                             ,output v-fltopend-rowid
     2977                             ) no-error.
     2978         .
     2979         v-doc-rec = ?.
     2980       end.
     2981       assign
     2982         l-query-was-opened = true
     2983       .
     2984     end.
     2985   end.
     2986     run waitfram-hide in this-procedure .
     2987     END.
     2988     WHEN 'объект':U        THEN DO:
     2989         ASSIGN
     2990         frame Dialog-Frame:TITLE =
