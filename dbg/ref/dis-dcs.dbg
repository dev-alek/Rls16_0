     4898     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4899     run fltfield-add in this-procedure('rule-num', '№ правила', '',
     4900     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4901     run fltfield-add in this-procedure('rl-root', '№ корн.правила', '',
     4902     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4903     run fltfield-add in this-procedure('pos-type', 'Место использ.', 'cd-types-discnt',
     4904     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4905     run fltfield-add in this-procedure('discnt-role', 'Тип скидки', '',
     4906     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4907     run fltfield-add in this-procedure('d-card', '№ карты', '',
     4908     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4909   Filter-Block:
     4910   DO ON STOP    UNDO Filter-Block, LEAVE Filter-Block
     4911       ON ERROR   UNDO Filter-Block, LEAVE Filter-Block
     4912       ON END-KEY UNDO Filter-Block, LEAVE Filter-Block :
     4913     run gbl/filter.w ( INPUT parparentproc
     4914                        ,INPUT (filter-point + chr(4) + filter-label)
     4915                        ,INPUT tbl
     4916                        ,INPUT join-tbl
     4917                        ,INPUT fld
     4918                        ,INPUT lab
     4919                        ,INPUT spr
     4920                        ,INPUT dim ).
     4921     RUN OpenBr in this-procedure ( input yes, input no, input '':U).
     4922   END.
     4923   END PROCEDURE.
