     4602       define variable  parameter-4-39 as character no-undo .
     4603       define variable  parameter-5-39 as character no-undo .
     4604       define variable  parameter-6-39 as character no-undo .
     4605       define variable  parameter-7-39 as character no-undo .
     4606         assign
     4607         parameter-3-39 =
     4608                                 "FOR EACH X_dis-dc-rule"
     4609         parameter-4-39 =
     4610           (
     4611             if (" X_dis-dc-rule.discnt-role = p-discnt-role " + " " + where-phrase-39) <> ""
     4612             then  substitute('X_dis-dc-rule.discnt-role = &1&2&1', chr(34), p-discnt-role)  + " " + where-phrase-39
     4613             else "true"
     4614           )
     4615         parameter-5-39 = (" " + "" + " " + ", FIRST X_dis-card no-lock where X_dis-card.d-card = X_dis-dc-rule.d-card,                                  FIRST X_clients no-lock where X_clients.obj-type = X_Dis-card.cli-type and                                                                X_clients.obj-code = X_dis-card.cli-code")
     4616         parameter-6-39 = if sort-phrase-39 = ''
     4617                              then
     4618           (
     4619           " " + "  " +
     4620             " " + sort-column-phrase +
     4621           " " + "  "
     4622           )
     4623                              else
     4624           (
     4625           " " + "  " +
     4626             " " + sort-column-phrase +
     4627           " " + sort-phrase-39
     4628           )
     4629         parameter-7-39 =
     4630           " indexed-reposition  "
     4631       .
     4632       do
     4633       on stop undo, leave
     4634       on error undo, leave
     4635       :
     4636         assign
     4637           l-disable-where-39 =
     4638             (" X_dis-dc-rule.discnt-role = p-discnt-role " + " " + where-phrase-39 = "")
     4639         .
     4640         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     4641                             ,input QUERY br-dis-dc-rule:handle
     4642                             ,input parameter-3-39
     4643                             ,input parameter-4-39
     4644                             ,input parameter-5-39
     4645                             ,input parameter-6-39
     4646                             ,input parameter-7-39
     4647                             )
     4648         .
     4649         assign
     4650           l-filter-open-39 = true
     4651         .
     4652       end.
     4653       if l-filter-open-39 = false then do:
     4654         message
     4655           "Ошибка при фильтрации / сортировке" skip
     4656           "Будут показаны записи без учета фильтра" skip
     4657           view-as alert-box .
     4658       end.
     4659       else do:
     4660           assign
     4661             l-query-was-opened = true
     4662           .
     4663       end.
     4664     end.
     4665     if l-filter-open-39 = false then do:
     4666       OPEN QUERY br-dis-dc-rule FOR EACH X_dis-dc-rule
     4667         where  X_dis-dc-rule.discnt-role = p-discnt-role
     4668       , FIRST X_dis-card no-lock where X_dis-card.d-card = X_dis-dc-rule.d-card,                                  FIRST X_clients no-lock where X_clients.obj-type = X_Dis-card.cli-type and                                                                X_clients.obj-code = X_dis-card.cli-code
     4669         indexed-reposition
     4670     .
     4671         assign
     4672           l-query-was-opened = true
     4673         .
     4674     end.
     4675   end.
     4676   else do:
     4677     assign
     4678       v-doc-rec = recid( X_dis-dc-rule )
     4679     .
     4680     do
     4681     on stop undo, leave
     4682     on error undo, leave
     4683     :
     4684       if QUERY br-dis-dc-rule:handle:get-buffer-handle(1) = (buffer X_dis-dc-rule:handle) then do:
     4685         assign
     4686         parameter-2-39 = (if p-find-next then "true":u else "false":u )
     4687         parameter-4-39 =
     4688           "where ":u +  substitute('X_dis-dc-rule.discnt-role = &1&2&1', chr(34), p-discnt-role)  + " ":u + where-phrase-39 + " ":u + p-find-condition + " " + ""
     4689         parameter-5-39 = "  "
     4690       .
     4691         run fltopend_fltfindd in this-procedure  (
     4692                             input this-procedure:handle
     4693                             ,input QUERY br-dis-dc-rule:handle
     4694                             ,input rowid(X_dis-dc-rule)
     4695                             ,input logical(parameter-2-39)
     4696                             ,input no-lock
     4697                             ,input (buffer X_dis-dc-rule:handle)
     4698                             ,input parameter-4-39
     4699                             ,input parameter-5-39
     4700                             ) no-error.
     4701         .
     4702         assign
     4703           v-doc-rec = integer(return-value)
     4704           v-fltopend-rowid[1] = ?
     4705         .
     4706       end.
     4707       else do:
     4708         assign
     4709         parameter-2-39 = (if p-find-next then "true":u else "false":u )
     4710         parameter-3-39 =  "FOR EACH X_dis-dc-rule"
     4711         parameter-4-39 =
     4712           (
     4713             if (" X_dis-dc-rule.discnt-role = p-discnt-role " + " " + where-phrase-39) <> ""
     4714             then  substitute('X_dis-dc-rule.discnt-role = &1&2&1', chr(34), p-discnt-role)  + " " + where-phrase-39
     4715             else "true"
     4716           )
     4717         parameter-5-39 = (" " + "" + " " + ", FIRST X_dis-card no-lock where X_dis-card.d-card = X_dis-dc-rule.d-card,                                  FIRST X_clients no-lock where X_clients.obj-type = X_Dis-card.cli-type and                                                                X_clients.obj-code = X_dis-card.cli-code" + " " + p-find-condition)
     4718         parameter-6-39 = if sort-phrase-39 = ''
     4719                              then
     4720           (
     4721           " " + "  " +
     4722             " " + sort-column-phrase +
     4723           " " + "  "
     4724           )
     4725                              else
     4726           (
     4727           " " + "  " +
     4728             " " + sort-column-phrase +
     4729           " " + sort-phrase-39
     4730           )
     4731         parameter-7-39 =
     4732           " indexed-reposition  "
     4733       .
     4734         run fltopend_fltfindq in this-procedure  (
     4735                             input this-procedure:handle
     4736                             ,input QUERY br-dis-dc-rule:handle
     4737                             ,input logical(parameter-2-39)
     4738                             ,input no-lock
     4739                             ,input parameter-3-39
     4740                             ,input parameter-4-39
     4741                             ,input parameter-5-39
     4742                             ,input parameter-6-39
     4743                             ,input parameter-7-39
     4744                             ,output v-fltopend-rowid
     4745                             ) no-error.
     4746         .
     4747         v-doc-rec = ?.
     4748       end.
     4749       assign
     4750         l-query-was-opened = true
     4751       .
     4752     end.
     4753   end.
     4754     run waitfram-hide in this-procedure .
     4755     END.
     4756   END CASE.
     4757   if not p-open-query then
     4758   REPOSITION br-dis-dc-rule to recid v-doc-rec No-ERROR.
     4759   if not p-open-query and v-fltopend-rowid[1] <> ? then
     4760   query br-dis-dc-rule:handle:reposition-to-rowid(v-fltopend-rowid) No-ERROR.
     4761   if error-status:error then do:
     4762     REPOSITION br-dis-dc-rule to row 1 No-ERROR.
     4763   end.
     4764   run waitfram-hide in this-procedure.
     4765   APPLY "VALUE-CHANGED" TO br-dis-dc-rule in frame Dialog-Frame.
     4766   APPLY "ENTRY" TO br-dis-dc-rule.
     4767   END PROCEDURE.
     4768   PROCEDURE proc-b-mark :
     4769   define variable loc#log as logical no-undo .
     4770   if available X_dis-dc-rule then do:
     4771   define variable vss-include-info40 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4772   define variable v-str-recid41 as character no-undo .
     4773   define variable v-num-entry41 as integer   no-undo .
     4774   assign
     4775     v-str-recid41 = trim( string( recid( X_dis-dc-rule ) , "->>>>>>>>>>>9":U ) )
     4776     v-num-entry41 = lookup( v-str-recid41 , v-rid-list )
     4777   .
     4778   if v-num-entry41 > 0 then do:
     4779     assign
     4780       entry( v-num-entry41, v-rid-list ) = "":U
     4781       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     4782     .
     4783   end.
     4784   else do:
     4785     assign
     4786       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid41
     4787     .
     4788   end.
     4789     loc#log = br-dis-dc-rule:refresh() IN FRAME Dialog-Frame .
     4790     if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
     4791         loc#log = br-dis-dc-rule:select-next-row ().
     4792         apply "VALUE-CHANGED" to br-dis-dc-rule in frame Dialog-Frame.
     4793     end.
     4794     if num-entries( v-rid-list ) = 0
     4795     then
     4796         hide mark-num in frame Dialog-Frame.
     4797     else
     4798         disp num-entries( v-rid-list ) @ mark-num with frame Dialog-Frame.
     4799   end.
     4800   apply "entry" to br-dis-dc-rule in frame Dialog-Frame.
     4801   END PROCEDURE.
     4802   PROCEDURE proc-b-print :
     4803   define variable Line                as char         no-undo.
     4804   define variable v-rec as recid no-undo .
     4805   define variable ii as integer no-undo .
     4806   define variable v-mark as character no-undo .
     4807   define variable v-prod as character no-undo .
     4808   define variable v-d-name as character no-undo .
     4809   define variable v-pos-type as character no-undo .
     4810   Line = fill( "-" , 140 ) .
     4811   define frame list
     4812   v-mark COLUMN-LABEL '*' FORMAT "X(1)"
     4813   X_dis-dc-rule.d-card COLUMN-LABEL '№ карты'
     4814   X_dis-card.emitent-host-code COLUMN-LABEL 'Эмитент' FORMAT ">>>>9"
     4815   X_dis-card.type COLUMN-LABEL 'Тип'
     4816   v-prod COLUMN-LABEL 'Держатель' FORMAT "X(12)"
     4817   X_clients.obj-name COLUMN-LABEL 'Держатель' FORMAT "X(40)"
     4818   X_dis-dc-rule.templ-rl-root COLUMN-LABEL 'Тип правила' FORMAT ">>>>>>>>9"
     4819   v-pos-type COLUMN-LABEL 'Место использ.' format "X(20)"
     4820   X_dis-dc-rule.obj-type COLUMN-LABEL 'Тип объ' FORMAT "X(3)"
     4821   X_dis-dc-rule.obj-code COLUMN-LABEL 'Код объ' FORMAT ">>>>>>>>9"
     4822   v-d-name COLUMN-LABEL 'Тип скидки' FORMAT "X(40)"
     4823   X_dis-dc-rule.rule-num COLUMN-LABEL '№ правила' FORMAT ">>>>>>>>9"
     4824   X_dis-dc-rule.rl-root COLUMN-LABEL '№ корн.!правила' FORMAT ">>>>>>>>9"
     4825   HEADER
     4826   cur-time-print() AT 5 format "X(35)"
     4827   string( "Страница " + string( PAGE-NUMBER( PrnLibStream ) , ">>9") )
     4828   AT 86 format "X(15)" SKIP
     4829   Line format "x(130)" AT 1
     4830   with width 235 down use-text stream-io no-box .
     4831   v-rec = recid(X_dis-dc-rule).
     4832   DO WHILE available X_dis-dc-rule :
     4833     GET prev br-dis-dc-rule NO-LOCK .
     4834   END.
     4835   GET next br-dis-dc-rule NO-LOCK .
     4836   run prn-lib-open-stream  in this-procedure (
     4837                                                input parParentProc
     4838                                               ,input 43
     4839                                               ,input yes
     4840                                               ,input no
     4841                                               ).
     4842   FORM HEADER
     4843   Line format "X(130)" SKIP
     4844   "Продолжение - на следующей странице" AT 30 SKIP
     4845   with FRAME BottomFrame width 160 PAGE-BOTTOM NO-LABELS no-box.
     4846   VIEW stream PrnLibStream FRAME CliBottomFrame .
     4847   PUT stream PrnLibStream space(30)
     4848   frame Dialog-Frame:title format "X(100)" SKIP(2) .
     4849   FORM with frame List .
     4850   DO WHILE available X_dis-dc-rule :
     4851     DISPLAY stream PrnLibStream
     4852     mark-string(recid(X_dis-dc-rule), v-rid-list) @ v-mark
     4853     X_dis-dc-rule.d-card
     4854     X_dis-card.emitent-host-code
     4855     X_dis-card.type
     4856     (X_dis-card.cli-type + string(X_dis-card.cli-code)) @ v-prod
     4857     X_clients.obj-name
     4858     X_dis-dc-rule.templ-rl-root
     4859     entry (lookup (X_dis-dc-rule.pos-type, 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,r-keeper,InfoKiosk,pricecheck-Servis+,Emulator-NKT-IBM,MARIA,-,bo,Autotank':U), 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,R-KEEPER,InfoKiosk,Прайс-чекер Servis+,Emulator-NKT-IBM,MARIA,Накладная,Бэкофис,Autotank':U) @ v-pos-type
     4860     X_dis-dc-rule.obj-type
     4861     X_dis-dc-rule.obj-code
     4862     entry (lookup (p-discnt-role, 'debet-pay-pcnt-disc,debet-pay-abs-disc,debet-pay-qnty-disc,debet-pay-sum-disc,debet-pay-free-disc,dc-d-pcnt,dc-cash-d-pcnt,credit-pay-pcnt-disc,credit-pay-abs-disc,credit-pay-qnty-disc,credit-pay-sum-disc,credit-pay-free-disc':u) + 1, ',' + '% Скидка при оплате топлива по дебет.ведомости,ABS Скидка при оплате топлива по дебет.ведомости,Скидка на кол-во при оплате топлива по дебет.ведомости,Скидка на сумму при оплате топлива по дебет.ведомости,Своб скидка при оплате топлива по дебет.ведомости,% скидка на товар по ДК,% скидка на итог чека по ДК,% Скидка при оплате топлива по кредит.ведомости,Abs Скидка при оплате топлива по кредит.ведомости,Скидка на кол-во при оплате топлива по кредит.ведомости,Скидка на сумму при оплате топлива по кредит.ведомости,Своб Скидка на сумму при оплате топлива по кредит.ведомости':u) @ v-d-name
     4863     X_dis-dc-rule.rule-num
     4864     X_dis-dc-rule.rl-root
     4865     with frame List .
     4866     DOWN stream PrnLibStream 1 with frame List .
     4867     ii =  ii + 1 .
     4868     if ( ( ii modulo 10 ) = 0 ) AND ( ii >= 10 ) then
     4869     run waitfram-show in this-procedure ( input ("Просмотрено строк : " + string( ii )) ) .
     4870     GET next br-dis-dc-rule .
     4871   END.
     4872   run waitfram-hide in this-procedure .
     4873   PUT stream PrnLibStream Line format "X(130)" SKIP.
     4874   HIDE stream PrnLibStream FRAME BottomFrame .
     4875   output stream PrnLibStream close .
     4876   run prn-lib-prn-file in this-procedure (
     4877                                             input parParentProc
     4878                                             ,input 0
     4879                                             ).
     4880   reposition br-dis-dc-rule to recid v-rec no-error.
     4881   if error-status:error then do:
     4882     reposition br-dis-dc-rule to row 1 no-error.
     4883   end.
     4884   APPLy "ENTRY" to br-dis-dc-rule.
     4885   END PROCEDURE.
     4886   PROCEDURE proc-b-sch :
     4887   assign
     4888     tbl = 'dis-dc-rule'
     4889     join-tbl = 'X_dis-dc-rule'
     4890     fld = ""
     4891     lab = ""
     4892     spr = ""
     4893     dim = '0'
     4894     .
     4895     run fltfield-add in this-procedure('templ-rl-root', 'Номер типа(шаблона) правила', '',
     4896     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
