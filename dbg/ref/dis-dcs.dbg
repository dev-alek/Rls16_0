      409   procedure fltfield-clear :
      410     define output parameter loc-fld as character no-undo.
      411     define output parameter loc-lab as character no-undo .
      412     define output parameter loc-spr as character no-undo .
      413     define output parameter loc-dim as character no-undo .
      414     assign
      415       loc-fld = ""
      416       loc-lab = ""
      417       loc-spr = ""
      418       loc-dim = "0"
      419     .
      420   end procedure .
      421   procedure fltfield-add :
      422     define input        parameter par-fld as character no-undo.
      423     define input        parameter par-lab as character no-undo .
      424     define input        parameter par-spr as character no-undo .
      425     define input-output parameter loc-fld as character no-undo.
      426     define input-output parameter loc-lab as character no-undo .
      427     define input-output parameter loc-spr as character no-undo .
      428     define input-output parameter loc-dim as character no-undo .
      429     do
      430     on error undo, return error
      431     :
      432       assign
      433       loc-fld = if loc-dim = '0'
      434                 then par-fld
      435                 else (loc-fld + chr(44) + par-fld)
      436       loc-lab = if loc-dim = '0'
      437                 then par-lab
      438                 else (loc-lab + chr(44) + par-lab)
      439       loc-spr = if loc-dim = '0'
      440                 then par-spr
      441                 else (loc-spr + chr(44) + par-spr)
      442       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
      443                 string(integer(if num-entries(loc-dim) > 1
      444                               then entry(2, loc-dim)
      445                               else entry(1, loc-dim)
      446                               ) + 1)
      447       no-error
      448       .
      449     end.
      450   end procedure.
      451   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      452   define  stream PrnLibStream.
      453   procedure prn-lib-prn-file :
      454     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      455     define input parameter p-DIsabledoptions as integer no-undo .
      456     define variable v-report-name as character no-undo .
      457     define variable v-user-action as character no-undo .
      458     define variable v-printed     as logical   no-undo .
      459     define variable v-exist       as logical   no-undo .
      460     do
      461       on error undo, return error
      462       :
      463       run prn-lib-get-report-name  in this-procedure (
      464         input parParentProc
      465         ,output v-report-name
      466         ).
      467   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      468   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      469     (input  v-report-name
      470     ,input  2
      471     ,output v-exist
      472     )  .
      473       if NOT v-exist then
      474       DO:
      475         Message
      476           "Нет заданий на печать ! "
      477           view-as alert-box .
      478         Return  .
      479       End.
      480       run gbl/prnfilen.w
      481         (input  ""
      482         ,input  p-DisabledOptions
      483         ,input  string(v-report-name )
      484         ,input  7
      485         ,output v-user-action
      486         ,output v-printed
      487         ) .
      488       if v-printed then
      489       do:
      490         return "YES" .
      491       end.
      492       else
      493       do:
      494         return "NO" .
      495       end.
      496     end.
      497   end procedure.
      498   procedure prn-lib-open-stream :
      499     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      500     define input parameter p-page-size    as integer no-undo .
      501     define input parameter p-is-stream    as logical no-undo .
      502     define input parameter p-append       as logical no-undo .
      503     define variable v-report-name as character no-undo .
      504     do
      505       on error undo, return error
      506       :
      507       run prn-lib-get-report-name  in this-procedure (
      508         input parParentProc
      509         ,output v-report-name
      510         ).
      511       if p-is-stream then
      512       do:
      513         if p-append then
      514         do:
      515           output stream PrnLibStream to value( v-report-name )
      516             page-size value(p-page-size) append .
      517         end.
      518         if not p-append then
      519         do:
      520           output stream PrnLibStream to value( v-report-name )
      521             page-size value(p-page-size) .
      522         end.
      523       end.
      524       if not p-is-stream then
      525       do:
      526         if p-append then
      527         do:
      528           output to value( v-report-name )
      529             page-size value(p-page-size) append .
      530         end.
      531         if not p-append then
      532         do:
      533           output to value( v-report-name )
      534             page-size value(p-page-size) .
      535         end.
      536       end.
      537     end.
      538   end procedure.
      539   procedure prn-lib-open-exp :
      540     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      541     define input parameter p-is-stream    as logical no-undo .
      542     define input parameter p-is-append    as logical no-undo .
      543     define output parameter p-ReportFileName as char init "report" no-undo.
      544     define output parameter p-process as logical no-undo .
      545     define variable glog as logical no-undo .
      546     do
      547       on error undo, return error
      548       :
      549       SYSTEM-DIALOG GET-FILE p-ReportFileName
      550         TITLE      "Укажите путь"
      551         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      552         ASK-OVERWRITE
      553         CREATE-TEST-FILE
      554         SAVE-AS
      555         USE-FILENAME
      556         DEFAULT-EXTENSION "txt"
      557         UPDATE glog
      558         .
      559       if not glog then  return.
      560       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      561       if p-is-stream then
      562       do:
      563         if p-is-append then
      564         do:
      565           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      566         end.
      567         else
      568         do:
      569           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      570         end.
      571       end.
      572       else
      573       do:
      574         if p-is-append then
      575         do:
      576           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      577         end.
      578         else
      579         do:
      580           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      581         end.
      582       end.
      583       p-process = yes.
      584     end.
      585   end procedure.
      586   procedure prn-lib-get-report-name :
      587     define input parameter parParentProc  as widget-handle no-undo.
      588     define output parameter p-report-name as character no-undo .
      589     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      590   end procedure.
      591   procedure prn-lib-reportviewer-report-name :
      592     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      593     define input parameter p-report-name-html as character no-undo .
      594     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      595   end procedure.
      596   procedure prn-lib-reportviewer :
      597     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      598     define input parameter p-report-name-html as character no-undo .
      599     define input parameter p-param        as character no-undo .
      600     define variable v-excel           as character no-undo init 'TRUE' .
      601     define variable v-value-character as character no-undo .
      602     define variable v-value-integer   as character no-undo .
      603     define variable v-value-date      as date      no-undo .
      604     define variable v-value-decimal   as decimal   no-undo .
      605     define variable rep-excel         as logical   no-undo .
      606     define variable excel-string      as character no-undo .
      607     define variable v-param-type      as character no-undo .
      608     define variable v-tth             as handle    no-undo .
      609     run adm/shattri.p (
      610       input "get":U
      611       ,input  ""
      612       ,input  0
      613       ,input  'report-glob':U
      614       ,input  'rep-excel':U
      615       ,output v-value-character
      616       ,output v-value-date
      617       ,output v-value-decimal
      618       ,output v-value-integer
      619       ,output rep-excel
      620       ,output v-param-type
      621       ,INPUT-OUTPUT table-handle v-tth
      622       )  .
      623     if rep-excel then v-excel = "TRUE" .
      624     else v-excel = "FALSE" .
      625     if p-param eq ""
      626     then
      627        p-param = "EXCEL:" + v-excel.
      628     else
      629        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      630     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      631   end procedure.
      632   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      633   FUNCTION mark-string RETURNS CHARACTER
      634     ( input p-recid as recid, input mark-list as character  ) :
      635     RETURN ( IF LOOKUP( STRING( p-recid), mark-list ) > 0 THEN '*' ELSE '':U ).
      636   END FUNCTION.
      637   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      638   procedure cur-time :
      639      define output parameter p-today as date      no-undo .
      640      define output parameter p-time  as integer   no-undo .
      641     do
      642     on error undo, return error
      643     :
      644       define variable v-date1 as date      no-undo .
      645       define variable v-date2 as date      no-undo .
      646       define variable v-time  as integer   no-undo .
      647       assign
      648         v-date1 = today
      649         v-time  = time
      650         v-date2 = today
      651       .
      652       if v-date1 <> v-date2
      653       then do:
      654         assign
      655           v-date1 = today
      656           v-time  = v-time
      657         .
      658       end.
      659       assign
      660         p-today = v-date1
      661         p-time  = v-time
      662       .
      663     end.
      664   end.
      665   function cur-time-date returns character
      666   :
      667     return string(today, '99/99/9999':U) .
      668   end.
      669   function cur-time-mjd returns decimal
      670   :
      671     define variable v-date as date      no-undo .
      672     define variable v-time as integer   no-undo .
      673     run cur-time in this-procedure
      674       (output v-date
      675       ,output v-time
      676       ) .
      677     return integer(v-date) - 2400002 + (v-time / 86400) .
      678   end.
      679   function cur-time-get-ending-index returns integer
      680   (input p-number as integer
      681   )
      682   :
      683     if p-number < 0
      684     or p-number = ?
      685     then do:
      686       return 1 .
      687     end.
      688     define variable v-rest as integer   no-undo .
      689     assign
      690       p-number = p-number modulo 100
      691     .
      692     if p-number < 20
      693     then do:
      694       assign
      695         v-rest = p-number
      696       .
      697     end.
      698     else do:
      699       assign
      700         v-rest = p-number modulo 10
      701       .
      702     end.
      703     case v-rest :
      704       when 1
      705       then do:
      706         return 2 .
      707       end.
      708       when 2 or
      709       when 3 or
      710       when 4
      711       then do:
      712         return 3 .
      713       end.
      714       otherwise do:
      715         return 1 .
      716       end.
      717     end case .
      718   end.
      719   procedure cur-time-mjd-to-date :
      720      define input  parameter i-mjd-diff as decimal no-undo.
      721      define output parameter o-Date     as date    no-undo.
      722      define output parameter o-Time     as integer no-undo.
      723      define variable v-day-number as integer   no-undo .
      724      if    i-mjd-diff < 0
      725         or i-mjd-diff = ?
      726      then do:
      727         return "?" .
      728      end.
      729      assign
      730         v-day-number = truncate(i-mjd-diff,0).
      731         o-Date = date(v-day-number + 2400002).
      732         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      733     .
      734   end.
      735   function cur-time-mjd-to-string returns character
      736   (input p-mjd-diff as decimal
      737   )
      738   :
      739     define variable v-day-number as integer   no-undo .
      740     define variable v-seconds    as integer   no-undo .
      741     define variable v-hour       as integer   no-undo .
      742     define variable v-min        as integer   no-undo .
      743     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      744     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      745     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      746     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      747     if p-mjd-diff < 0
      748     or p-mjd-diff = ?
      749     then do:
      750       return "?" .
      751     end.
      752     assign
      753       v-day-number = integer(truncate(p-mjd-diff,0))
      754       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      755     .
      756     if v-seconds > 86400
      757     then do:
      758       assign
      759         v-seconds = 86400 - 1
      760       .
      761     end.
      762     if v-seconds < 0
      763     then do:
      764       assign
      765         v-seconds = 0
      766       .
      767     end.
      768     assign
      769       v-hour = truncate(v-seconds / 3600, 0)
      770     .
      771     assign
      772       v-seconds = v-seconds modulo 3600
      773     .
      774     assign
      775       v-min = truncate(v-seconds / 60, 0)
      776     .
      777     assign
      778       v-seconds = v-seconds modulo 60
      779     .
      780     return
      781         (if v-day-number <> 0
      782           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      783           else ""
      784         )
      785       + (if v-day-number <> 0 or v-hour <> 0
      786           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      787           else ""
      788         )
      789       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      790           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      791           else ""
      792         )
      793       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      794       .
      795   end.
      796   function cur-time-string returns character
      797   :
      798     define variable v-date as date      no-undo .
      799     define variable v-time as integer   no-undo .
      800     run cur-time in this-procedure
      801       (output v-date
      802       ,output v-time
      803       ) .
      804     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      805   end.
      806   function cur-time-string-sec returns character
      807   :
      808     define variable v-date as date      no-undo .
      809     define variable v-time as integer   no-undo .
      810     run cur-time in this-procedure
      811       (output v-date
      812       ,output v-time
      813       ) .
      814     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      815   end.
      816   function cur-time-custom  returns character
      817   (input p-prefix as character
      818   ,input p-date-format as character
      819   ,input p-delimiter as character
      820   ,input p-time-format as character
      821   ,input p-suffix as character
      822   )
      823   :
      824     define variable v-date as date      no-undo .
      825     define variable v-time as integer   no-undo .
      826     run cur-time in this-procedure
      827       (output v-date
      828       ,output v-time
      829       ) .
      830     return
      831       p-prefix
      832       + string(v-date, p-date-format)
      833       + p-delimiter
      834       + string(v-time, p-time-format)
      835       + p-suffix
      836       .
      837   end.
      838   function cur-time-print  returns character
      839   :
      840     define variable v-date as date      no-undo .
      841     define variable v-time as integer   no-undo .
      842     run cur-time in this-procedure
      843       (output v-date
      844       ,output v-time
      845       ) .
      846     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      847   end.
      848   function cur-time-datetime returns datetime
      849   :
      850     define variable v-char as character no-undo .
      851     define variable v-datetime as datetime no-undo .
      852     v-char = cur-time-string().
      853     v-datetime = datetime(v-char).
      854     return  v-datetime.
      855   end.
      856   function cur-time-string-msec returns character
      857   :
      858     define variable v-date as datetime  no-undo .
      859     v-date = now.
      860     return string(v-date) .
      861   end.
      862   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      863   define variable v-fltopend-rowid as rowid extent 18 no-undo .
      864   procedure fltopend_fltopend :
      865   define input parameter p-parent-handle as handle no-undo .
      866   define input parameter p-qh as handle no-undo .
      867   define input parameter p-flt-open-open-query  as character no-undo .
      868   define input parameter p-where-cond as character no-undo .
      869   define input parameter p-use-indFIRST-query-tail as character no-undo .
      870   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      871   define input parameter p-indexed-reposition as character no-undo .
      872     do
      873     on error undo, return error
      874     :
      875   define variable v-prepare-string as character no-undo .
      876   define variable glog as logical no-undo .
      877   assign
      878   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      879                      p-where-cond + chr(32)  +
      880                      p-use-indFIRST-query-tail + chr(32) +
      881                      p-use-ind-sort-clmn-by + chr(32) +
      882                      p-indexed-reposition
      883   .
      884   assign
      885   glog = p-qh:query-prepare(v-prepare-string) no-error .
      886   if not glog
      887   or error-status:error then do:
      888     message error-status:get-message(1) view-as alert-box .
      889     undo, return error .
      890   end.
      891   assign
      892   glog = p-qh:query-open no-error .
      893   if not glog
      894   or error-status:error then do:
      895     message error-status:get-message(1) view-as alert-box .
      896     undo, return error .
      897   end.
      898     end.
      899   end procedure.
      900   procedure fltopend_fltfindd :
      901   define input parameter p-parent-handle as handle no-undo .
      902   define input parameter p-qh as handle no-undo .
      903   define input parameter p-rowid as rowid no-undo .
      904   define input parameter p-next as logical no-undo .
      905   define input parameter p-lock as integer no-undo .
      906   define input parameter p-bh as handle no-undo .
      907   define input parameter p-where-cond as character no-undo .
      908   define input parameter p-use-index-phrase as character no-undo .
      909   define variable glog as logical no-undo .
      910   define variable v-qh as handle no-undo .
      911   define variable v-bh as handle no-undo .
      912   define variable v-recid as recid no-undo .
      913   define variable v-prepare-string as character no-undo .
      914   do
      915   on error undo, return error
      916   on stop undo, return error
      917   :
      918     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
      919     create buffer v-bh for table p-bh buffer-name p-bh:name.
      920     create query v-qh.
      921     v-qh:set-buffers(v-bh).
      922     v-prepare-string = substitute("for each &1 &2 &3"
      923                                     ,v-bh:name
      924                                     ,p-where-cond
      925                                     ,p-use-index-phrase).
      926     glog = v-qh:query-prepare(v-prepare-string) no-error.
      927     if not glog then do:
      928       delete object v-qh.
      929       delete object v-bh.
      930       undo, return error .
      931     end.
      932     glog = v-qh:query-open no-error .
      933     if not glog then do:
      934       delete object v-qh.
      935       delete object v-bh.
      936       undo, return error .
      937     end.
      938     if p-next then do:
      939       v-qh:reposition-to-rowid(p-rowid) no-error .
      940       glog = v-qh:get-next( p-lock) no-error .
      941       glog = v-qh:get-next( p-lock) no-error .
      942       if not glog or v-qh:query-off-end = yes then do:
      943         glog = v-qh:get-first( p-lock) no-error .
      944       end.
      945     end.
      946     else do:
      947       glog = v-qh:get-first( p-lock) no-error .
      948     end.
      949     v-recid = v-bh:recid no-error .
      950     delete object v-qh.
      951     delete object v-bh.
      952     return string(v-recid) .
      953   end.
      954   end procedure.
      955   procedure fltopend_fltfindq :
      956   define input parameter p-parent-handle as handle no-undo .
      957   define input parameter p-qh as handle no-undo .
      958   define input parameter p-next as logical no-undo .
      959   define input parameter p-lock as integer no-undo .
      960   define input parameter p-flt-open-open-query  as character no-undo .
      961   define input parameter p-where-cond as character no-undo .
      962   define input parameter p-use-indFIRST-query-tail as character no-undo .
      963   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      964   define input parameter p-indexed-reposition as character no-undo .
      965   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
      966   define variable glog as logical no-undo .
      967   define variable v-qh as handle no-undo .
      968   define variable v-bh as handle no-undo extent 18.
      969   define variable v-rowid as rowid no-undo extent 18.
      970   define variable v-ii as integer no-undo .
      971   define variable v-prepare-string as character no-undo .
      972   do
      973   on error undo, return error
      974   on stop undo, return error
      975   :
      976     create query v-qh.
      977     do v-ii = 1 to p-qh:num-buffers:
      978       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
      979       assign
      980       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
      981       no-error.
      982       v-qh:add-buffer(v-bh[v-ii]).
      983     end.
      984     assign
      985     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      986                       p-where-cond + chr(32)  +
      987                       p-use-indFIRST-query-tail + chr(32) +
      988                       p-use-ind-sort-clmn-by + chr(32) +
      989                       p-indexed-reposition
      990     .
      991     glog = v-qh:query-prepare( v-prepare-string) no-error .
      992     if not glog then do:
      993       delete object v-qh.
      994       do v-ii = 1 to p-qh:num-buffers:
      995         delete object v-bh[v-ii].
      996       end.
      997       undo, return error .
      998     end.
      999     glog = v-qh:query-open no-error .
     1000     if not glog then do:
     1001       delete object v-qh.
     1002       do v-ii = 1 to p-qh:num-buffers:
     1003         delete object v-bh[v-ii].
     1004       end.
     1005       undo, return error .
     1006     end.
     1007     if p-next then do:
     1008       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
     1009       glog = v-qh:get-next( p-lock) no-error .
     1010       glog = v-qh:get-next( p-lock) no-error .
     1011       if not glog or v-qh:query-off-end = yes then do:
     1012         glog = v-qh:get-first( p-lock) no-error .
     1013       end.
     1014     end.
     1015     else do:
     1016       glog = v-qh:get-first( p-lock) no-error .
     1017     end.
     1018     do v-ii = 1 to p-qh:num-buffers:
     1019       assign
     1020       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
     1021       no-error.
     1022     end.
     1023     delete object v-qh.
     1024     do v-ii = 1 to p-qh:num-buffers:
     1025       delete object v-bh[v-ii].
     1026     end.
     1027   end.
     1028   end procedure.
