     2504   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2505   procedure set-filter-name :
     2506   define input parameter p-filter-name as character no-undo .
     2507     do with frame Dialog-Frame:
     2508       if p-filter-name > "" then do:
     2509         assign
     2510           frame Dialog-Frame:title
     2511             = frame Dialog-Frame:title + "   ФИЛЬТР: " + p-filter-name.
     2512         .
     2513         assign
     2514           b-sch :tooltip = "Установлен фильтр " + p-filter-name
     2515         .
     2516       end.
     2517       else do:
     2518         assign
     2519           b-sch :tooltip = ""
     2520         .
     2521       end.
     2522     end.
     2523   end procedure.
     2524   def var sort-labelbr-dis-dc-rule   as character no-undo .
     2525   def var sort-clmnbr-dis-dc-rule    as handle    no-undo .
     2526   def var cur-clmnbr-dis-dc-rule     as handle    no-undo .
     2527   def var cur-clmn-locbr-dis-dc-rule as integer   no-undo .
     2528   def var re-querybr-dis-dc-rule     as logical   initial no no-undo .
     2529   on start-search, ctrl-o of br-dis-dc-rule in frame Dialog-Frame do:
     2530      run sort-brbr-dis-dc-rule
     2531        (input (if available X_dis-dc-rule
     2532                then recid(X_dis-dc-rule)
     2533                else ?
     2534               )
     2535        ).
     2536   end.
     2537   PROCEDURE sort-brbr-dis-dc-rule :
     2538     define input parameter p-recid as recid no-undo .
     2539     if re-querybr-dis-dc-rule = no then do:
     2540       assign
     2541          cur-clmnbr-dis-dc-rule = br-dis-dc-rule:current-column in frame Dialog-Frame
     2542       .
     2543       if sort-clmnbr-dis-dc-rule <> ? then sort-clmnbr-dis-dc-rule:column-fgcolor = 0.
     2544       if cur-clmnbr-dis-dc-rule = sort-clmnbr-dis-dc-rule then do:
     2545         assign
     2546            sort-labelbr-dis-dc-rule = ""
     2547            sort-clmnbr-dis-dc-rule = ?
     2548         .
     2549        end.
     2550        else do:
     2551          assign
     2552            sort-labelbr-dis-dc-rule = cur-clmnbr-dis-dc-rule:label
     2553            sort-clmnbr-dis-dc-rule  = cur-clmnbr-dis-dc-rule
     2554            sort-clmnbr-dis-dc-rule:column-fgcolor = 4
     2555          .
     2556        end.
     2557      end.
     2558     assign
     2559       cur-clmn-locbr-dis-dc-rule = 1
     2560     .
     2561     def var column-handle as handle no-undo .
     2562     column-handle = br-dis-dc-rule:first-column.
     2563     do while valid-handle(column-handle) :
     2564       if column-handle = cur-clmnbr-dis-dc-rule then do:
     2565         leave .
     2566       end.
     2567       column-handle = column-handle:NEXT-COLUMN.
     2568       assign
     2569         cur-clmn-locbr-dis-dc-rule = cur-clmn-locbr-dis-dc-rule + 1
     2570       .
     2571     end.
     2572     case sort-labelbr-dis-dc-rule:
     2573           when '*'  then DO:    assign       sort-column-name = "mark-string(recid(X_dis-dc-rule), v-rid-list)"     .     run OpenBr in this-procedure ( input yes, input no, input no).   . END.
     2574           when '№ карты'  then DO:    assign       sort-column-name = "X_dis-dc-rule.d-card"     .     run OpenBr in this-procedure ( input yes, input no, input no).   . END.
     2575           when 'Эмитент'  then DO:    assign       sort-column-name = "X_dis-card.emitent-host-code"     .     run OpenBr in this-procedure ( input yes, input no, input no).   . END.
     2576           when 'Тип'  then DO:    assign       sort-column-name = "X_dis-card.type"     .     run OpenBr in this-procedure ( input yes, input no, input no).   . END.
     2577           when 'Держатель'  then DO:    assign       sort-column-name = "(X_dis-card.cli-type + string(X_dis-card.cli-code))"     .     run OpenBr in this-procedure ( input yes, input no, input no).   . END.
     2578           when 'Держатель'  then DO:    assign       sort-column-name = "X_clients.obj-name"     .     run OpenBr in this-procedure ( input yes, input no, input no).   . END.
     2579           when 'Тип правила'  then DO:    assign       sort-column-name = "X_dis-dc-rule.templ-rl-root"     .     run OpenBr in this-procedure ( input yes, input no, input no).   . END.
     2580           when 'Место использ.'  then DO:    assign       sort-column-name = "entry (lookup (X_dis-dc-rule.pos-type, 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,r-keeper,InfoKiosk,pricecheck-Servis+,Emulator-NKT-IBM,MARIA,-,bo,Autotank':U), 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,R-KEEPER,InfoKiosk,Прайс-чекер Servis+,Emulator-NKT-IBM,MARIA,Накладная,Бэкофис,Autotank':U)"     .     run OpenBr in this-procedure ( input yes, input no, input no).   . END.
     2581           when 'Тип объ'  then DO:    assign       sort-column-name = "X_dis-dc-rule.obj-type"     .     run OpenBr in this-procedure ( input yes, input no, input no).   . END.
     2582           when 'Код объ'  then DO:    assign       sort-column-name = "X_dis-dc-rule.obj-code"     .     run OpenBr in this-procedure ( input yes, input no, input no).   . END.
     2583           when 'Тип скидки'  then DO:    assign       sort-column-name = "entry (lookup (X_dis-dc-rule.discnt-role, 'debet-pay-pcnt-disc,debet-pay-abs-disc,debet-pay-qnty-disc,debet-pay-sum-disc,debet-pay-free-disc,dc-d-pcnt,dc-cash-d-pcnt,credit-pay-pcnt-disc,credit-pay-abs-disc,credit-pay-qnty-disc,credit-pay-sum-disc,credit-pay-free-disc':u) + 1, ',' + '% Скидка при оплате топлива по дебет.ведомости,ABS Скидка при оплате топлива по дебет.ведомости,Скидка на кол-во при оплате топлива по дебет.ведомости,Скидка на сумму при оплате топлива по дебет.ведомости,Своб скидка при оплате топлива по дебет.ведомости,% скидка на товар по ДК,% скидка на итог чека по ДК,% Скидка при оплате топлива по кредит.ведомости,Abs Скидка при оплате топлива по кредит.ведомости,Скидка на кол-во при оплате топлива по кредит.ведомости,Скидка на сумму при оплате топлива по кредит.ведомости,Своб Скидка на сумму при оплате топлива по кредит.ведомости':u)"     .     run OpenBr in this-procedure ( input yes, input no, input no).   . END.
     2584           when '№ правила'  then DO:    assign       sort-column-name = "X_dis-dc-rule.rule-num"     .     run OpenBr in this-procedure ( input yes, input no, input no).   . END.
     2585           when '№ корн.!правила'  then DO:    assign       sort-column-name = "X_dis-dc-rule.rl-root"     .     run OpenBr in this-procedure ( input yes, input no, input no).   . END.
     2586       otherwise do:
     2587         assign
     2588           sort-column-name = ""
     2589         .
     2590         run OpenBr in this-procedure ( input yes, input no, input no).
     2591         if sort-labelbr-dis-dc-rule <> "" then do:
     2592           assign
     2593             cur-clmnbr-dis-dc-rule:column-fgcolor = 0
     2594           .
     2595         end.
     2596         assign
     2597           cur-clmn-locbr-dis-dc-rule = ?
     2598         .
     2599       end.
     2600     end case.
     2601     if p-recid <> ? then do:
     2602       reposition br-dis-dc-rule to recid p-recid no-error.
     2603       apply "value-changed" to br-dis-dc-rule in frame Dialog-Frame.
     2604     end.
     2605     apply "entry" to br-dis-dc-rule in frame Dialog-Frame.
     2606   END PROCEDURE.
     2607   procedure re-open-query-srt-clmnbr-dis-dc-rule:
     2608   if cur-clmnbr-dis-dc-rule = ? then do:
     2609      run OpenBr in this-procedure ( input yes, input no, input no).
     2610   end.
     2611   else do:
     2612      assign re-querybr-dis-dc-rule = yes.
     2613      run sort-brbr-dis-dc-rule
     2614        (input (if available X_dis-dc-rule
     2615                then recid(X_dis-dc-rule)
     2616                else ?
     2617               )
     2618        ).
     2619      assign re-querybr-dis-dc-rule = no.
     2620   end.
     2621   end.
     2622   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2623   do:
     2624     BR-dis-dc-rule :SET-REPOSITIONED-ROW(5, "CONDITIONAL") .
     2625   end.
     2626   MAIN-BLOCK:
     2627   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2628      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2629   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2630     run mainmenu_getcntxt in parparentproc
     2631       (output v-cntxt-db-num
     2632       ,output v-cntxt-userid
     2633       ,output v-cntxt-level
     2634       ,output v-cntxt-host-code-obj
     2635       ,output v-cntxt-obj-type
     2636       ,output v-cntxt-obj-code
     2637       ,output v-cntxt-db-num-obj
     2638       ,output v-cntxt-is-admin
     2639       ) .
     2640       v-rid-list = p-rid-list.
     2641     IF lookup(p-list-mode, ('все':U + chr(4) +
     2642                             "pos" + chr(4) +
     2643                             "templ-rl-root" + chr(4) +
     2644                             "discnt-role" + chr(4) +
     2645                             'объект':U + chr(4) +
     2646                             ('объект':U + chr(44) + "pos-type":U) + chr(4) +
     2647                             ('объект':U + chr(44) + "templ-rl-root":U) + chr(4) +
     2648                             ('объект':U + chr(44) + "discnt-role":U) + chr(4) +
     2649                             "rule-num":U + chr(4) +
     2650                             "rl-root":U) , chr(4)) = 0
     2651     THEN DO:
     2652        MESSAGE
     2653        vss-workfile vss-revision vss-description skip
     2654        "Неверный параметр вызова p-list-mode " p-list-mode
     2655        VIEW-AS ALERT-BOX ERROR.
     2656        UNDO, RETURN ERROR.
     2657     END.
     2658     IF lookup('объект':U , p-list-mode) > 0 THEN DO:
     2659       IF p-curr-obj-type <> 'скл':U
     2660       AND p-curr-obj-type <> 'маг':U THEN DO:
     2661           MESSAGE
     2662           vss-workfile vss-revision vss-description skip
     2663           "Неверный параметр вызова p-curr-obj-type " p-curr-obj-type
     2664           VIEW-AS ALERT-BOX ERROR.
     2665           UNDO, RETURN ERROR.
     2666       END.
     2667       FIND FIRST X_clients-obj NO-LOCK WHERE
     2668                 X_clients-obj.obj-type = p-curr-obj-type
     2669            AND  X_clients-obj.obj-code = p-curr-obj-code NO-ERROR.
     2670       IF NOT AVAILABLE X_clients-obj THEN DO:
     2671           MESSAGE
     2672           vss-workfile vss-revision vss-description skip
     2673           "Неверные параметры вызова p-curr-obj-type p-curr-obj-code" p-curr-obj-type p-curr-obj-code
     2674           VIEW-AS ALERT-BOX ERROR.
     2675           UNDO, RETURN ERROR.
     2676       END.
     2677     end.
     2678     IF LOOKUP( "templ-rl-root", p-list-mode) > 0 THEN DO:
     2679         FIND FIRST PAR_dis-rule NO-LOCK WHERE
     2680                   par_dis-rule.rule-num = p-templ-rl-root no-error.
     2681         IF NOT AVAILABLE par_Dis-rule THEN DO:
     2682             MESSAGE
     2683             vss-workfile vss-revision vss-description skip
     2684             "Неверный параметр вызова p-templ-rl-root" p-templ-rl-root
     2685             VIEW-AS ALERT-BOX ERROR.
     2686             UNDO, RETURN ERROR.
     2687         END.
     2688     END.
     2689     IF LOOKUP( "pos-type", p-list-mode) > 0
     2690     AND lookup(p-pos-type, 'IBM-XML,Autotank,IBM,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,r-keeper,InfoKiosk,pricecheck-Servis+,Emulator-NKT-IBM,MARIA':U) = 0  THEN DO:
     2691         MESSAGE
     2692         vss-workfile vss-revision vss-description skip
     2693         "Неверный параметр вызова p-pos-type" p-pos-type
     2694         VIEW-AS ALERT-BOX ERROR.
     2695         UNDO, RETURN ERROR.
     2696     END.
     2697     IF LOOKUP( "discnt-role", p-list-mode) > 0 THEN DO:
     2698       FIND FIRST par_dis-cfg-rule NO-LOCK WHERE
     2699                 par_dis-cfg-rule.discnt-role = p-discnt-role
     2700             AND par_dis-cfg-rule.TABLE-name = 'dis-dc-rule':U NO-ERROR.
     2701       IF NOT AVAILABLE par_dis-cfg-rule  THEN DO:
     2702         MESSAGE
     2703         vss-workfile vss-revision vss-description skip
     2704         "Неверный параметр вызова p-discnt-role" p-discnt-role
     2705         VIEW-AS ALERT-BOX ERROR.
     2706         UNDO, RETURN ERROR.
     2707       END.
     2708     END.
     2709     RUN Myenable IN THIS-PROCEDURE NO-ERROR.
     2710     IF ERROR-STATUS:ERROR THEN UNDO, RETURN ERROR.
     2711     WAIT-FOR GO OF FRAME Dialog-Frame.
     2712   END.
     2713   RUN disable_UI.
     2714   PROCEDURE disable_UI :
     2715     HIDE FRAME Dialog-Frame.
     2716   END PROCEDURE.
     2717   PROCEDURE enable_UI :
     2718     DISPLAY mark-num
     2719         WITH FRAME Dialog-Frame.
     2720     ENABLE b-quit B-mark B-sel B-d-card b-dis-rule B-sch B-print b-history B-Help
     2721            BR-dis-dc-rule mark-num
     2722         WITH FRAME Dialog-Frame.
     2723     VIEW FRAME Dialog-Frame.
     2724     OPEN QUERY BR-dis-dc-rule FOR EACH X_dis-dc-rule NO-LOCK ,            FIRST X_dis-card NO-LOCK WHERE           X_dis-card.d-card = X_dis-dc-rule.d-card,            FIRST X_clients NO-LOCK where           X_clients.obj-type = X_dis-card.cli-type       AND X_clients.obj-code = X_dis-card.cli-code INDEXED-REPOSITION.
     2725   END PROCEDURE.
     2726   PROCEDURE MyEnable :
     2727   define variable v-h as handle no-undo .
     2728   define variable v-ii as integer no-undo .
     2729   v-h = BR-dis-dc-rule:FIRST-COLUMN IN FRAME Dialog-Frame.
     2730   DO while valid-handle(v-h)
     2731   and  v-ii < br-dis-dc-rule:num-COLUMNs IN FRAME Dialog-Frame:
     2732     v-ii = v-ii + 1.
     2733     if v-h:LABEL = 'Держатель'
     2734     or v-h:LABEL = 'Место использ.'
     2735     or v-h:LABEL = 'Тип скидки'
     2736     then do:
     2737       v-h:RESIZABLE = YES.
     2738     end.
     2739     ELSE DO:
     2740       v-h = v-h:NEXT-COLUMN.
     2741     END.
     2742   END.
     2743   DISPLAY
     2744   mark-num
     2745   WITH FRAME Dialog-Frame.
     2746   ENABLE
     2747   b-quit
     2748   B-mark WHEN LOOKUP("b-mark", bttn) > 0
     2749   B-sel WHEN LOOKUP("b-mark", bttn) > 0
     2750   b-d-card
     2751   b-dis-rule
     2752   B-sch
     2753   B-print
     2754   b-history
     2755   B-Help
     2756   BR-dis-dc-rule
     2757   WITH FRAME Dialog-Frame.
     2758   VIEW FRAME Dialog-Frame.
     2759   RUn Openbr in this-procedure ( input yes, input no, input '':U).
     2760   END PROCEDURE.
     2761   PROCEDURE OpenBr :
     2762   define input  parameter p-open-query     as logical   no-undo .
     2763   define input  parameter p-find-next      as logical   no-undo .
     2764   define input  parameter p-find-condition as character no-undo .
     2765   define variable l-query-was-opened as logical no-undo .
     2766   define variable title0 as character no-undo init "Скидки на ДК".
     2767   define variable p-host-code like ub.sysconf.host-code no-undo .
     2768   run waitfram-show in this-procedure ( input "Ждите...").
     2769   define variable sort-column-phrase as character no-undo .
     2770   case sort-column-name :
     2771     when "" then do:
     2772       assign
     2773         sort-column-phrase = ""
     2774       .
     2775     end.
     2776     otherwise do:
     2777       assign
     2778         sort-column-phrase = "by " + sort-column-name
     2779       .
     2780     end.
     2781   end case.
     2782   if not( p-curr-obj-type = "":U and p-curr-obj-code = 0 ) then do:
     2783   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2784   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2785     (input  p-curr-obj-type
     2786     ,input  p-curr-obj-code
     2787     ,output p-host-code
     2788     )  .
     2789   end.
     2790   define variable l-open-query as logical   no-undo .
     2791   filter-point = filter-point0 + p-list-mode.
     2792   CASE p-list-mode :
     2793     WHEN 'все':U        THEN DO:
     2794       ASSIGN
     2795       frame Dialog-Frame:TITLE =
     2796                                     substitute("&1"
     2797                                     , title0
     2798                                     )
     2799      filter-label = substitute("&1", filter-label0)
     2800                                     .
     2801   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2802   define variable  l-disable-where-21  as logical   no-undo .
     2803   define variable  l-filter-open-21    as logical   .
     2804   define variable  flt-rec-21       as recid     no-undo .
     2805   define variable  filter-name-21      as character no-undo .
