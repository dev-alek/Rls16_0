     2807   define variable  sort-phrase-21      as character no-undo .
     2808   define variable  where-phrase-rus-21 as character no-undo .
     2809   define variable  sort-phrase-rus-21  as character no-undo .
     2810     run waitfram-show in this-procedure
     2811       (input "ЖДИТЕ ..."
     2812       ).
     2813   run gbl/flt-get.p
     2814     (input filter-point
     2815     ,output flt-rec-21
     2816     ,output filter-name-21
     2817     ,output where-phrase-21
     2818     ,output sort-phrase-21
     2819     ,output where-phrase-rus-21
     2820     ,output sort-phrase-rus-21
     2821     ).
     2822   if p-open-query then do:
     2823       run set-filter-name in this-procedure
     2824         (INPUT filter-name-21
     2825         ) no-error .
     2826     assign
     2827       l-filter-open-21 = false
     2828     .
     2829     if flt-rec-21 <> ?
     2830       or sort-column-phrase > ""
     2831     then do:
     2832       define variable  parameter-2-21 as character no-undo .
     2833       define variable  parameter-3-21 as character no-undo .
     2834       define variable  parameter-4-21 as character no-undo .
     2835       define variable  parameter-5-21 as character no-undo .
     2836       define variable  parameter-6-21 as character no-undo .
     2837       define variable  parameter-7-21 as character no-undo .
     2838         assign
     2839         parameter-3-21 =
     2840                                 "FOR EACH X_dis-dc-rule"
     2841         parameter-4-21 =
     2842           (
     2843             if (" TRUE " + " " + where-phrase-21) <> ""
     2844             then " TRUE " + " " + where-phrase-21
     2845             else "true"
     2846           )
     2847         parameter-5-21 = (" " + "" + " " + ", FIRST X_dis-card no-lock where X_dis-card.d-card = X_dis-dc-rule.d-card,                                  FIRST X_clients no-lock where X_clients.obj-type = X_Dis-card.cli-type and                                                                X_clients.obj-code = X_dis-card.cli-code")
     2848         parameter-6-21 = if sort-phrase-21 = ''
     2849                              then
     2850           (
     2851           " " + "  " +
     2852             " " + sort-column-phrase +
     2853           " " + "  "
     2854           )
     2855                              else
     2856           (
     2857           " " + "  " +
     2858             " " + sort-column-phrase +
     2859           " " + sort-phrase-21
     2860           )
     2861         parameter-7-21 =
     2862           " indexed-reposition  "
     2863       .
     2864       do
     2865       on stop undo, leave
     2866       on error undo, leave
     2867       :
     2868         assign
     2869           l-disable-where-21 =
     2870             (" TRUE " + " " + where-phrase-21 = "")
     2871         .
     2872         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     2873                             ,input QUERY br-dis-dc-rule:handle
     2874                             ,input parameter-3-21
     2875                             ,input parameter-4-21
     2876                             ,input parameter-5-21
     2877                             ,input parameter-6-21
     2878                             ,input parameter-7-21
     2879                             )
     2880         .
     2881         assign
