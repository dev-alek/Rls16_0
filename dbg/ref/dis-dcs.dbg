     1081   X_dis-dc-rule.templ-rl-root COLUMN-LABEL 'Тип правила' FORMAT ">>>>>>>>9"
     1082   entry (lookup (X_dis-dc-rule.pos-type, 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,r-keeper,InfoKiosk,pricecheck-Servis+,Emulator-NKT-IBM,MARIA,-,bo,Autotank':U), 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,R-KEEPER,InfoKiosk,Прайс-чекер Servis+,Emulator-NKT-IBM,MARIA,Накладная,Бэкофис,Autotank':U) COLUMN-LABEL 'Место использ.' FORMAT "X(20)"
     1083   X_dis-dc-rule.obj-type COLUMN-LABEL 'Тип объ' FORMAT "X(3)"
     1084   X_dis-dc-rule.obj-code COLUMN-LABEL 'Код объ' FORMAT ">>>>>>>>9"
     1085   entry (lookup (X_dis-dc-rule.discnt-role, 'debet-pay-pcnt-disc,debet-pay-abs-disc,debet-pay-qnty-disc,debet-pay-sum-disc,debet-pay-free-disc,dc-d-pcnt,dc-cash-d-pcnt,credit-pay-pcnt-disc,credit-pay-abs-disc,credit-pay-qnty-disc,credit-pay-sum-disc,credit-pay-free-disc':u) + 1, ',' + '% Скидка при оплате топлива по дебет.ведомости,ABS Скидка при оплате топлива по дебет.ведомости,Скидка на кол-во при оплате топлива по дебет.ведомости,Скидка на сумму при оплате топлива по дебет.ведомости,Своб скидка при оплате топлива по дебет.ведомости,% скидка на товар по ДК,% скидка на итог чека по ДК,% Скидка при оплате топлива по кредит.ведомости,Abs Скидка при оплате топлива по кредит.ведомости,Скидка на кол-во при оплате топлива по кредит.ведомости,Скидка на сумму при оплате топлива по кредит.ведомости,Своб Скидка на сумму при оплате топлива по кредит.ведомости':u) COLUMN-LABEL 'Тип скидки' FORMAT "X(70)" WIDTH 40
     1086   X_dis-dc-rule.rule-num COLUMN-LABEL '№ правила' FORMAT ">>>>>>>>9"
     1087   X_dis-dc-rule.rl-root COLUMN-LABEL '№ корн.!правила' FORMAT ">>>>>>>>9"
     1088       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 20 FIT-LAST-COLUMN.
     1089   DEFINE FRAME Dialog-Frame
     1090        b-quit AT ROW 1 COL 1
     1091        B-mark AT ROW 1 COL 11 WIDGET-ID 4
     1092        B-sel AT ROW 1 COL 21 WIDGET-ID 10
     1093        B-d-card AT ROW 1 COL 41 WIDGET-ID 14
     1094        b-dis-rule AT ROW 1 COL 51 WIDGET-ID 16
     1095        B-sch AT ROW 1 COL 86 WIDGET-ID 8
     1096        B-print AT ROW 1 COL 89 WIDGET-ID 6
     1097        b-history AT ROW 1 COL 92 WIDGET-ID 2
     1098        B-Help AT ROW 1 COL 95
     1099        BR-dis-dc-rule AT ROW 3 COL 1 WIDGET-ID 100
     1100        mark-num AT ROW 1 COL 12.5 COLON-ALIGNED NO-LABEL WIDGET-ID 12
     1101        SPACE(78.69) SKIP(21.22)
     1102       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1103            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1104            TITLE "Скидки по ДК"
     1105            CANCEL-BUTTON b-quit.
     1106   ASSIGN
     1107          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1108          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1109   ON GO OF FRAME Dialog-Frame
     1110   DO:
     1111     p-rid-list = v-rid-list.
     1112   END.
     1113   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1114   DO:
     1115     APPLY "END-ERROR":U TO SELF.
     1116   END.
     1117   ON CHOOSE OF B-d-card IN FRAME Dialog-Frame
     1118   DO:
     1119   DEFINE VARIABLE v-ref-rec AS RECID NO-UNDO.
     1120   define buffer buf_dis-card for ub.dis-card.
     1121     IF NOT AVAILABLE X_dis-card THEN RETURN NO-APPLY.
     1122     FIND FIRST buf_dis-card No-LOCK WHERE
     1123               buf_dis-card.d-card = X_dis-card.d-card no-error .
     1124   if error-status:error then  return no-apply.
     1125   v-ref-rec = recid( buf_dis-card ) .
     1126   run ref/dcardi.w (
     1127                  input parparentproc
     1128                 ,input 'ПРОСМОТР':U
     1129                 ,input buf_dis-card.emitent-host-code
     1130                 ,input p-curr-host-code
     1131                 ,input p-curr-obj-type
     1132                 ,input p-curr-obj-code
     1133                 ,input ?
     1134                 ,input-output v-ref-rec ) .
     1135   apply "entry" to br-dis-dc-rule in frame Dialog-Frame.
     1136   END.
     1137   ON CHOOSE OF b-dis-rule IN FRAME Dialog-Frame
     1138   DO:
     1139     IF NOT AVAILABLE X_dis-dc-rule THEN RETURN NO-APPLY.
     1140     run ref/show-dr.p ( INPUT parparentproc
     1141                        ,INPUT X_dis-dc-rule.rule-num) NO-ERROR.
     1142     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1143   END.
     1144   ON CHOOSE OF b-history IN FRAME Dialog-Frame
     1145   DO:
     1146   define variable v-rid-list as character no-undo .
     1147   if not available X_dis-dc-rule then return no-apply.
     1148   run ref/cdchist.w (
     1149                     input parparentproc
     1150                   , input v-cntxt-host-code-obj
     1151                   , input v-cntxt-obj-type
     1152                   , input v-cntxt-obj-code
     1153                   , input "":U
     1154                   , input "subject":U
     1155                   , input X_dis-dc-rule.d-card
     1156                   , input X_dis-dc-rule.card-num
     1157                   , input X_dis-dc-rule.obj-type
     1158                   , input X_dis-dc-rule.obj-code
     1159                   , input X_dis-dc-rule.host-code
     1160                   , input ?
     1161                   , input "":U
     1162                   , input 'dis-dc-rule':U
     1163                   , input v-cntxt-db-num
     1164                   , input-output v-rid-list  ) no-error .
     1165   END.
     1166   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
     1167   DO:
     1168     RUN proc-b-mark IN THIS-PROCEDURE NO-ERROR.
     1169     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1170   END.
     1171   ON CHOOSE OF B-print IN FRAME Dialog-Frame
     1172   DO:
     1173     run proc-b-print in this-procedure no-error.
     1174     if error-status:error then do:
     1175       return no-apply.
     1176     end.
     1177     APPLY "ENTRY" to br-dis-dc-rule.
     1178   END.
     1179   ON CHOOSE OF B-sch IN FRAME Dialog-Frame
     1180   DO:
     1181     RUN proc-b-sch IN THIS-PROCEDURE NO-ERROR.
     1182     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1183   END.
     1184   ON CHOOSE OF B-sel IN FRAME Dialog-Frame
     1185   DO:
     1186       if ( available X_dis-dc-rule ) then do:
     1187       if  ( v-rid-list = "" ) or b-mark:sensitive = no
     1188       then
     1189       v-rid-list = string( recid( X_dis-dc-rule ) ) .
     1190     end.
     1191   END.
     1192   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1193   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1194   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1195   on help of frame Dialog-Frame
     1196   do:
     1197     run gbl/app_help.p
     1198       (input this-procedure :file-name
     1199       ,input ''
     1200       ,input ?
     1201       ) no-error.
     1202     if error-status :error then do:
     1203       message
     1204         "Ошибка при вызове помощи"
     1205         error-status :get-message(1)
     1206         view-as alert-box .
     1207     end.
     1208   end.
     1209   run minbtn-set in this-procedure .
     1210   on choose of b-help in frame Dialog-Frame
     1211   do:
     1212     apply "help":u to frame Dialog-Frame .
     1213   end.
     1214   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1215   procedure minbtn-set :
     1216       do
     1217           on error undo, return error return-value
     1218           :
     1219           define variable ii              as integer       no-undo .
     1220           define variable fh              as widget-handle no-undo .
     1221           define variable hh              as widget-handle no-undo .
     1222           define variable v-h             as handle        extent 4 no-undo .
     1223           define variable v-name-button   as character     no-undo .
     1224           define variable v-help-old-x    as decimal       no-undo .
     1225           define variable v-help-old-y    as decimal       no-undo .
     1226           define variable v-help-old-size as decimal       no-undo .
     1227           define variable v-frame-width   as decimal       no-undo .
     1228           define variable jj              as integer       no-undo .
     1229           do
     1230               on error undo, return error
     1231               :
     1232               assign
     1233                   v-frame-width = frame Dialog-Frame:width - 0.3
     1234                   fh            = frame Dialog-Frame:first-child
     1235                   hh            = fh:first-child
     1236                   ii            = 1
     1237                   .
     1238               do while valid-handle(hh):
     1239                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1240                   do:
     1241                       case lc(hh:name) :
     1242                           when "b-help" then
     1243                               do:
     1244                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1245                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1246                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1247                                   hh:TOOLTIP = "Помощь" .
     1248                                   v-help-old-x = hh:column .
     1249                                   v-help-old-y = hh:row    .
     1250                                   v-help-old-size = hh:width .
     1251                                   hh:width-chars = 2.5 .
     1252                               end.
     1253                           when "b-print" then
     1254                               do:
     1255                                   hh:load-image("cmp/b-print.bmp":u) .
     1256                                   hh:TOOLTIP = "Печать" .
     1257                                   v-h[ii] = hh:handle .
     1258                                   ii = ii + 1 .
     1259                                   hh:width-chars = 3 .
     1260                               end.
     1261                           when "b-history" or
     1262                           when "b-hist" then
     1263                               do:
     1264                                   hh:load-image("cmp/b-hist.bmp":u) .
     1265                                   hh:TOOLTIP = "История" .
     1266                                   v-h[ii] = hh:handle .
     1267                                   ii = ii + 1 .
     1268                                   hh:width-chars = 3 .
     1269                               end.
     1270                           when "b-sch" then
     1271                               do:
     1272                                   hh:load-image("cmp/b-sch.bmp":u) .
     1273                                   hh:TOOLTIP = "Установка Фильтра" .
     1274                                   v-h[ii] = hh:handle .
     1275                                   ii = ii + 1 .
     1276                                   hh:width-chars = 3 .
     1277                               end.
     1278                           when "b-hist-user" then
     1279                               do:
     1280                                   hh:load-image("cmp/b-hist.bmp":u) .
     1281                                   hh:TOOLTIP = "История пользователя" .
     1282                                   ii = ii + 1 .
     1283                               end.
     1284                       end case.
     1285                   end.
     1286                   hh = hh:next-sibling.
     1287               end.
     1288               b-help:column = v-frame-width - b-help:width-chars.
     1289               jj = 0.
     1290               repeat ii = 4 to 1 by -1 :
     1291                   if valid-handle (v-h[ii] ) then
     1292                   do:
     1293                       jj  = jj + 1 .
     1294                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1295                       v-h[ii]:row    = v-help-old-y .
     1296                   end.
     1297               end.
     1298           end.
     1299       end.
     1300   end procedure.
     1301   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1302   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1303   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1304   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1305   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1306   define variable v-diasize-current-frame-height as decimal   no-undo .
     1307   define variable v-diasize-change-size          as logical   no-undo .
     1308   define variable v-diasize-resize-button        as handle    no-undo .
     1309   define variable v-diasize-wndmax               as logical   no-undo .
     1310   define variable v-diasize-wndstore             as logical   no-undo .
     1311   define variable v-diasize-proc-name            as character no-undo .
     1312   define variable v-diasize-browse-handle        as handle    no-undo .
     1313   define variable v-diasize-browse-number        as integer   no-undo .
     1314   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1315   define temp-table temp-diasize-handle no-undo
     1316     field handle-value  as handle
     1317     field save-position as decimal
     1318     index xpk is primary unique handle-value
     1319     .
     1320   define temp-table temp-browse-handle no-undo
     1321     field browse-type   as character
     1322     field browse-number as integer
     1323     field browse-handle as handle
     1324     field original-size as decimal
     1325     index xpk is primary unique browse-type browse-number
     1326     index xie browse-type browse-handle
     1327   .
     1328   procedure diasize_change-height :
     1329     define input  parameter p-change-value  as decimal   no-undo .
     1330     define input  parameter p-move-resize   as logical   no-undo .
     1331     define variable v-field-group-handle    as handle    no-undo .
     1332     define variable v-object-handle         as handle    no-undo .
     1333     define variable v-frame-height          as decimal   no-undo .
     1334     define variable v-frame-virtual-height  as decimal   no-undo .
     1335     define variable v-browse-height         as decimal   no-undo .
     1336     define variable v-window-height         as decimal   no-undo .
     1337     define variable v-window-virtual-height as decimal   no-undo .
     1338     define variable v-change-sign           as integer   no-undo .
     1339     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1340     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1341     if p-change-value > 0
     1342     then do:
     1343       if frame Dialog-Frame :height + p-change-value
     1344           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1345       then do:
     1346         assign
     1347           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1348                           - (frame Dialog-Frame :height-chars)
     1349         .
     1350         if p-change-value <= 0
     1351         then do:
     1352           run diasize_position-resize-button in this-procedure .
     1353           return .
     1354         end.
     1355       end.
     1356     end.
     1357     if p-change-value < 0
     1358     then do:
     1359       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1360       then do:
     1361         assign
     1362           p-change-value = v-diasize-orig-frame-height
     1363                          - (frame Dialog-Frame :height-chars)
     1364         .
     1365         if p-change-value >= 0
     1366         then do:
     1367           run diasize_position-resize-button in this-procedure .
     1368           return .
     1369         end.
     1370       end.
     1371     end.
     1372     if p-change-value >= 0
     1373     then do:
     1374       assign
     1375         v-change-sign = 1
     1376       .
     1377     end.
     1378     else do:
     1379       assign
     1380         v-change-sign = -1
     1381       .
     1382     end.
     1383     assign
     1384       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1385     .
     1386     if p-change-value = 0
     1387     then do:
     1388       run diasize_position-resize-button in this-procedure .
     1389       return .
     1390     end.
     1391     move_block:
     1392     do
     1393     on error undo move_block, retry move_block
     1394     :
     1395       if retry
     1396       then do:
     1397         do
     1398         on error undo move_block, leave move_block
     1399         :
     1400           if p-change-value > 0
     1401           then do:
     1402             for each buf_temp-diasize-handle
     1403             on error undo, next
     1404             :
     1405               assign
     1406                 v-object-handle = buf_temp-diasize-handle.handle-value
     1407               .
     1408               if v-object-handle <> v-diasize-resize-button
     1409               then do:
     1410                 assign
     1411                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1412                 .
     1413               end.
     1414             end.
     1415             assign
     1416               v-diasize-browse-handle :height = v-browse-height
     1417             .
     1418             for each buf_temp-browse-handle
     1419               where buf_temp-browse-handle.browse-type = 'height':u
     1420             on error undo, next
     1421             :
     1422               assign
     1423                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1424               .
     1425             end.
     1426             assign
     1427               frame Dialog-Frame :height = v-frame-height
     1428             .
     1429             if frame Dialog-Frame :scrollable = true
     1430             then do:
     1431               assign
     1432                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1433               .
     1434             end.
     1435             run diasize_position-resize-button in this-procedure .
     1436           end.
     1437           else do:
     1438             if frame Dialog-Frame :scrollable = true
     1439             then do:
     1440               assign
     1441                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1442               .
     1443             end.
     1444             assign
     1445               frame Dialog-Frame :height = v-frame-height
     1446             .
     1447             assign
     1448               v-diasize-browse-handle :height = v-browse-height
     1449             .
     1450             for each buf_temp-browse-handle
     1451               where buf_temp-browse-handle.browse-type = 'height':u
     1452             on error undo, next
     1453             :
     1454               assign
     1455                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1456               .
     1457             end.
     1458             for each buf_temp-diasize-handle
     1459             on error undo, next
     1460             :
     1461               assign
     1462                 v-object-handle = buf_temp-diasize-handle.handle-value
     1463               .
     1464               if v-object-handle <> v-diasize-resize-button
     1465               then do:
     1466                 assign
     1467                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1468                 .
     1469               end.
     1470             end.
     1471             run diasize_position-resize-button in this-procedure .
     1472           end.
     1473           assign
     1474             v-diasize-change-size = false
     1475           .
     1476           leave move_block .
     1477         end.
     1478       end.
     1479       assign
     1480         v-diasize-need-full-display = true
     1481       .
     1482       if v-diasize-change-size = false
     1483       then do:
     1484         assign
     1485           v-diasize-change-size = true
     1486         .
     1487       end.
     1488       else do:
     1489         return .
     1490       end.
     1491       assign
     1492         v-frame-height = frame Dialog-Frame :height
     1493         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1494         v-browse-height = v-diasize-browse-handle :height
     1495       .
     1496       for each buf_temp-browse-handle
     1497         where buf_temp-browse-handle.browse-type = 'height':u
     1498       :
     1499         assign
     1500           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1501         .
     1502       end.
     1503       for each buf_temp-diasize-handle
     1504       :
     1505         delete buf_temp-diasize-handle .
     1506       end.
     1507       assign
     1508         v-field-group-handle = frame Dialog-Frame :first-child
     1509       .
     1510       do while valid-handle(v-field-group-handle)
     1511       :
     1512         assign
     1513           v-object-handle = v-field-group-handle :first-child
     1514         .
     1515         do while valid-handle(v-object-handle)
     1516         :
     1517           if  v-object-handle <> v-diasize-browse-handle :handle
     1518           and can-query(v-object-handle, "row")
     1519           and can-query(v-object-handle, "height")
     1520           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1521           then do:
     1522             find first buf_temp-browse-handle
     1523               where buf_temp-browse-handle.browse-type   = 'height':u
     1524                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1525               no-error .
     1526             if available buf_temp-browse-handle
     1527             then do:
     1528             end.
     1529             else do:
     1530               create buf_temp-diasize-handle .
     1531               assign
     1532                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1533                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1534               .
     1535             end.
     1536           end.
     1537           assign
     1538             v-object-handle = v-object-handle :next-sibling
     1539           .
     1540         end.
     1541         assign
     1542           v-field-group-handle = v-field-group-handle :next-sibling
     1543         .
     1544       end.
     1545       do with frame Dialog-Frame
     1546       :
     1547         hide v-diasize-resize-button .
     1548         assign
     1549           v-diasize-resize-button :row    = 1
     1550           v-diasize-resize-button :column = 1
     1551         .
     1552       end.
     1553       if p-change-value > 0
     1554       then do:
     1555         if frame Dialog-Frame :scrollable = true
     1556         then do:
     1557           assign
     1558             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1559             no-error .
     1560           if error-status :error
     1561           or error-status :get-message(1) <> ""
     1562           then do:
     1563             undo move_block, retry move_block .
     1564           end.
     1565         end.
     1566         assign
     1567           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1568           no-error .
     1569         if error-status :error
     1570         or error-status :get-message(1) <> ""
     1571         then do:
     1572           undo move_block, retry move_block .
     1573         end.
     1574         assign
     1575           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1576           no-error .
     1577         if error-status :error
     1578         or error-status :get-message(1) <> ""
     1579         then do:
     1580           undo move_block, retry move_block .
     1581         end.
     1582         for each buf_temp-browse-handle
     1583           where buf_temp-browse-handle.browse-type = 'height':u
     1584         on error undo move_block, retry move_block
     1585         :
     1586           assign
     1587             buf_temp-browse-handle.browse-handle :height
     1588               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1589             no-error .
     1590           if error-status :error
     1591           or error-status :get-message(1) <> ""
     1592           then do:
     1593             undo move_block, retry move_block .
     1594           end.
     1595         end.
     1596         for each buf_temp-diasize-handle
     1597         on error undo move_block, retry move_block
     1598         :
     1599           assign
     1600             v-object-handle = buf_temp-diasize-handle.handle-value
     1601           .
     1602           if v-object-handle <> v-diasize-resize-button
     1603           then do:
     1604             assign
     1605               v-object-handle :row = v-object-handle :row + p-change-value
     1606               no-error .
     1607             if error-status :error
     1608             or error-status :get-message(1) <> ""
     1609             then do:
     1610               undo move_block, retry move_block .
     1611             end.
     1612           end.
     1613         end.
     1614       end.
     1615       else do:
     1616         for each buf_temp-diasize-handle
     1617         on error undo move_block, retry move_block
     1618         :
     1619           assign
     1620             v-object-handle = buf_temp-diasize-handle.handle-value
     1621           .
     1622           if v-object-handle <> v-diasize-resize-button
     1623           then do:
     1624             assign
     1625               v-object-handle :row = v-object-handle :row + p-change-value
     1626               no-error .
     1627             if error-status :error
     1628             or error-status :get-message(1) <> ""
     1629             then do:
     1630               undo move_block, retry move_block .
     1631             end.
     1632           end.
     1633         end.
     1634         assign
     1635           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1636           no-error .
     1637         if error-status :error
     1638         or error-status :get-message(1) <> ""
     1639         then do:
     1640           undo move_block, retry move_block .
     1641         end.
     1642         for each buf_temp-browse-handle
     1643           where buf_temp-browse-handle.browse-type = 'height':u
     1644         on error undo move_block, retry move_block
     1645         :
     1646           assign
     1647             buf_temp-browse-handle.browse-handle :height
     1648               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1649             no-error .
     1650           if error-status :error
     1651           or error-status :get-message(1) <> ""
     1652           then do:
     1653             undo move_block, retry move_block .
     1654           end.
     1655         end.
     1656         assign
     1657           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1658           no-error .
     1659         if error-status :error
     1660         or error-status :get-message(1) <> ""
     1661         then do:
     1662           undo move_block, retry move_block .
     1663         end.
     1664         if frame Dialog-Frame :scrollable = true
     1665         then do:
     1666           assign
     1667             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1668             no-error .
     1669           if error-status :error
     1670           or error-status :get-message(1) <> ""
     1671           then do:
     1672             undo move_block, retry move_block .
     1673           end.
     1674         end.
     1675       end.
     1676       if p-move-resize = true
     1677       then do:
     1678         run diasize_position-resize-button in this-procedure .
     1679       end.
     1680       if v-diasize-wndstore = true
     1681       then do:
     1682         if connected("ub") = true
     1683         then do:
     1684           define variable v-cntxt-db-num        as integer   no-undo .
     1685           define variable v-cntxt-userid        as character no-undo .
     1686           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1687                                             , OUTPUT v-cntxt-userid
     1688                                             ) .
     1689           run gbl/wndsizew.p
     1690             (input  v-cntxt-db-num
     1691             ,input  v-cntxt-userid
     1692             ,input  v-diasize-proc-name
     1693             ,input  'height':u
     1694             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1695             ) .
     1696         end.
     1697       end.
     1698     end.
     1699     assign
     1700       v-diasize-change-size = false
     1701     .
     1702   end procedure.
     1703   procedure diasize_set-height :
     1704     define input  parameter p-new-height  as decimal   no-undo .
     1705     define input  parameter p-move-resize as logical   no-undo .
     1706     do
     1707     on error undo, return error return-value
     1708     :
     1709       run diasize_change-height in this-procedure
     1710         (input  (p-new-height - frame Dialog-Frame :height)
     1711         ,input  p-move-resize
     1712         ) .
     1713     end.
     1714   end procedure.
     1715   procedure diasize_change-width :
     1716     define input  parameter p-change-value as decimal   no-undo .
     1717     define input  parameter p-move-resize  as logical   no-undo .
     1718     define variable v-field-group-handle   as handle    no-undo .
     1719     define variable v-object-handle        as handle    no-undo .
     1720     define variable v-frame-width          as decimal   no-undo .
     1721     define variable v-frame-virtual-width  as decimal   no-undo .
     1722     define variable v-browse-width         as decimal   no-undo .
     1723     define variable v-window-width         as decimal   no-undo .
     1724     define variable v-window-virtual-width as decimal   no-undo .
     1725     define variable v-change-sign          as integer   no-undo .
     1726     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1727     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1728     if p-change-value > 0
     1729     then do:
     1730       if frame Dialog-Frame :width + p-change-value >
     1731           session :width-chars
     1732       then do:
     1733         assign
     1734           p-change-value = session :width-chars - frame Dialog-Frame :width
     1735         .
     1736         if p-change-value <= 0
     1737         then do:
     1738           run diasize_position-resize-button in this-procedure .
     1739           return .
     1740         end.
     1741       end.
     1742     end.
     1743     if p-change-value < 0
     1744     then do:
     1745       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1746       then do:
     1747         assign
     1748           p-change-value = v-diasize-orig-frame-width
     1749                          - frame Dialog-Frame :width
     1750         .
     1751         if p-change-value >= 0
     1752         then do:
     1753           run diasize_position-resize-button in this-procedure .
     1754           return .
     1755         end.
     1756       end.
     1757     end.
     1758     if p-change-value >= 0
     1759     then do:
     1760       assign
     1761         v-change-sign = 1
     1762       .
     1763     end.
     1764     else do:
     1765       assign
     1766         v-change-sign = -1
     1767       .
     1768     end.
     1769     assign
     1770       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1771     .
     1772     if p-change-value = 0
     1773     then do:
     1774       run diasize_position-resize-button in this-procedure .
     1775       return .
     1776     end.
     1777     move_block:
     1778     do
     1779     on error undo move_block, leave move_block
     1780     :
     1781       if retry
     1782       then do:
     1783         do
     1784         on error undo move_block, leave move_block
     1785         :
     1786           if p-change-value > 0
     1787           then do:
     1788             for each buf_temp-diasize-handle
     1789             on error undo, next
     1790             :
     1791               assign
     1792                 v-object-handle = buf_temp-diasize-handle.handle-value
     1793               .
     1794               if v-object-handle <> v-diasize-resize-button
     1795               then do:
     1796                 assign
     1797                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1798                 .
     1799               end.
     1800             end.
     1801             assign
     1802               v-diasize-browse-handle :width = v-browse-width
     1803             .
     1804             for each buf_temp-browse-handle
     1805               where buf_temp-browse-handle.browse-type = 'width':u
     1806             on error undo, next
     1807             :
     1808               assign
     1809                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1810               .
     1811             end.
     1812             assign
     1813               frame Dialog-Frame :width = v-frame-width
     1814             .
     1815             if frame Dialog-Frame :scrollable = true
     1816             then do:
     1817               assign
     1818                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1819               .
     1820             end.
     1821             run diasize_position-resize-button in this-procedure .
     1822           end.
     1823           else do:
     1824             if frame Dialog-Frame :scrollable = true
     1825             then do:
     1826               assign
     1827                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1828               .
     1829             end.
     1830             assign
     1831               frame Dialog-Frame :width = v-frame-width
     1832             .
     1833             for each buf_temp-browse-handle
     1834               where buf_temp-browse-handle.browse-type = 'width':u
     1835             on error undo, next
     1836             :
     1837               assign
     1838                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1839               .
     1840             end.
     1841             assign
     1842               v-diasize-browse-handle :width = v-browse-width
     1843             .
     1844             for each buf_temp-diasize-handle
     1845             on error undo, next
     1846             :
     1847               assign
     1848                 v-object-handle = buf_temp-diasize-handle.handle-value
     1849               .
     1850               if v-object-handle <> v-diasize-resize-button
     1851               then do:
     1852                 assign
     1853                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1854                 .
     1855               end.
     1856             end.
     1857             run diasize_position-resize-button in this-procedure .
     1858           end.
     1859           assign
     1860             v-diasize-change-size = false
     1861           .
     1862           leave move_block .
     1863         end.
     1864       end.
     1865       assign
     1866         v-diasize-need-full-display = true
     1867       .
     1868       if v-diasize-change-size = false
     1869       then do:
     1870         assign
     1871           v-diasize-change-size = true
     1872         .
     1873       end.
     1874       else do:
     1875         return .
     1876       end.
     1877       assign
     1878         v-frame-width = frame Dialog-Frame :width
     1879         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1880         v-browse-width = v-diasize-browse-handle :width
     1881       .
     1882       for each buf_temp-browse-handle
     1883         where buf_temp-browse-handle.browse-type = 'width':u
     1884       :
     1885         assign
     1886           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1887         .
     1888       end.
     1889       for each buf_temp-diasize-handle
     1890       :
     1891         delete buf_temp-diasize-handle .
     1892       end.
     1893       assign
     1894         v-field-group-handle = frame Dialog-Frame :first-child
     1895       .
     1896       do while valid-handle(v-field-group-handle)
     1897       :
     1898         assign
     1899           v-object-handle = v-field-group-handle :first-child
     1900         .
     1901         do while valid-handle(v-object-handle)
     1902         :
     1903           if  v-object-handle <> v-diasize-browse-handle :handle
     1904           and v-object-handle <> v-diasize-resize-button
     1905           and can-query(v-object-handle, "row")
     1906           and can-query(v-object-handle, "height")
     1907           and ( v-object-handle :col + v-object-handle :width
     1908                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1909               )
     1910           then do:
     1911             find first buf_temp-browse-handle
     1912               where buf_temp-browse-handle.browse-type   = 'width':u
     1913                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1914               no-error .
     1915             if available buf_temp-browse-handle
     1916             then do:
     1917             end.
     1918             else do:
     1919               create buf_temp-diasize-handle .
     1920               assign
     1921                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1922                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1923               .
     1924             end.
     1925           end.
     1926           assign
     1927             v-object-handle = v-object-handle :next-sibling
     1928           .
     1929         end.
     1930         assign
     1931           v-field-group-handle = v-field-group-handle :next-sibling
     1932         .
     1933       end.
     1934       do with frame Dialog-Frame
     1935       :
     1936         hide v-diasize-resize-button .
     1937         v-diasize-resize-button :row = 1.
     1938         v-diasize-resize-button :column = 1.
     1939       end.
     1940       if p-change-value > 0
     1941       then do:
     1942         if frame Dialog-Frame :scrollable = true
     1943         then do:
     1944           assign
     1945             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1946             no-error .
     1947           if error-status :error
     1948           or error-status :get-message(1) <> ""
     1949           then do:
     1950             undo move_block, retry move_block.
     1951           end.
     1952         end.
     1953         assign
     1954           frame Dialog-Frame :width = v-frame-width + p-change-value
     1955           no-error .
     1956         if error-status :error
     1957         or error-status :get-message(1) <> ""
     1958         then do:
     1959           undo move_block, retry move_block.
     1960         end.
     1961         assign
     1962           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1963         no-error .
     1964         if error-status :error
     1965         or error-status :get-message(1) <> ""
     1966         then do:
     1967           undo move_block, retry move_block.
     1968         end.
     1969         for each buf_temp-browse-handle
     1970           where buf_temp-browse-handle.browse-type = 'width':u
     1971         on error undo move_block, retry move_block
     1972         :
     1973           assign
     1974             buf_temp-browse-handle.browse-handle :width
     1975               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1976             no-error .
     1977           if error-status :error
     1978           or error-status :get-message(1) <> ""
     1979           then do:
     1980             undo move_block, retry move_block .
     1981           end.
     1982         end.
     1983         for each buf_temp-diasize-handle
     1984         on error undo move_block, retry move_block
     1985         :
     1986           assign
     1987             v-object-handle = buf_temp-diasize-handle.handle-value
     1988           .
     1989           if v-object-handle <> v-diasize-resize-button
     1990           then do:
     1991             assign
     1992               v-object-handle :col = v-object-handle :col + p-change-value
     1993               no-error .
     1994             if error-status :error
     1995             or error-status :get-message(1) <> ""
     1996             then do:
     1997               undo move_block, retry move_block .
     1998             end.
     1999           end.
     2000         end.
     2001       end.
     2002       else do:
     2003         for each buf_temp-diasize-handle
     2004         on error undo move_block, retry move_block
     2005         :
     2006           assign
     2007             v-object-handle = buf_temp-diasize-handle.handle-value
     2008           .
     2009           if v-object-handle <> v-diasize-resize-button
     2010           then do:
     2011             assign
     2012               v-object-handle :col = v-object-handle :col + p-change-value
     2013               no-error .
     2014             if error-status :error
     2015             or error-status :get-message(1) <> ""
     2016             then do:
     2017               undo move_block, retry move_block .
     2018             end.
     2019           end.
     2020         end.
     2021         for each buf_temp-browse-handle
     2022           where buf_temp-browse-handle.browse-type = 'width':u
     2023         on error undo move_block, retry move_block
     2024         :
     2025           assign
     2026             buf_temp-browse-handle.browse-handle :width
     2027               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2028             no-error .
     2029           if error-status :error
     2030           or error-status :get-message(1) <> ""
     2031           then do:
     2032             undo move_block, retry move_block .
     2033           end.
     2034         end.
     2035         assign
     2036           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2037           no-error .
     2038         if error-status :error
     2039         or error-status :get-message(1) <> ""
     2040         then do:
     2041           undo move_block, retry move_block.
     2042         end.
     2043         assign
     2044           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2045         no-error .
     2046         if error-status :error
     2047         or error-status :get-message(1) <> ""
     2048         then do:
     2049           undo move_block, retry move_block.
     2050         end.
     2051         if frame Dialog-Frame :scrollable = true
     2052         then do:
     2053           assign
     2054             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2055           no-error .
     2056           if error-status :error
     2057           or error-status :get-message(1) <> ""
     2058           then do:
     2059             undo move_block, retry move_block.
     2060           end.
     2061         end.
     2062       end.
     2063       if p-move-resize
     2064       then do:
     2065         run diasize_position-resize-button in this-procedure .
     2066       end.
     2067       if v-diasize-wndstore = true
     2068       then do:
     2069         if connected("ub") = true
     2070         then do:
     2071           define variable v-cntxt-db-num        as integer   no-undo .
     2072           define variable v-cntxt-userid        as character no-undo .
     2073           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2074                                             , OUTPUT v-cntxt-userid
     2075                                             ) .
     2076           run gbl/wndsizew.p
     2077             (input  v-cntxt-db-num
     2078             ,input  v-cntxt-userid
     2079             ,input  v-diasize-proc-name
     2080             ,input  'width':u
     2081             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2082             ) .
     2083         end.
     2084       end.
     2085     end.
     2086     assign
     2087       v-diasize-change-size = false
     2088     .
     2089   end procedure.
     2090   procedure diasize_set-width :
     2091     define input  parameter p-new-width  as decimal   no-undo .
     2092     define input  parameter p-move-resize as logical   no-undo .
     2093     do
     2094     on error undo, return error return-value
     2095     :
     2096       run diasize_change-width in this-procedure
     2097         (input  (p-new-width - frame Dialog-Frame :width)
     2098         ,input  p-move-resize
     2099         ) .
     2100     end.
     2101   end procedure.
     2102   procedure diasize_position-resize-button :
     2103     do with frame Dialog-Frame
     2104     :
     2105       hide v-diasize-resize-button .
     2106       assign
     2107         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2108                     - 1
     2109                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2110         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2111                     - 1
     2112                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2113       .
     2114       view v-diasize-resize-button .
     2115     end.
     2116   end procedure.
     2117   on alt-right anywhere
     2118   do:
     2119     run diasize_change-width in this-procedure
     2120       (input 1
     2121       ,input true
     2122       ) .
     2123     return no-apply .
     2124   end.
     2125   on alt-left anywhere
     2126   do:
     2127     run diasize_change-width in this-procedure
     2128       (input -1
     2129       ,input true
     2130       ) .
     2131     return no-apply .
     2132   end.
     2133   on alt-down anywhere
     2134   do:
     2135     run diasize_change-height in this-procedure
     2136       (input 1
     2137       ,input true
     2138       ) .
     2139     return no-apply .
     2140   end.
     2141   on alt-up anywhere
     2142   do:
     2143     run diasize_change-height in this-procedure
     2144       (input -1
     2145       ,input true
     2146       ) .
     2147     return no-apply .
     2148   end.
     2149   on alt-enter of frame Dialog-Frame
     2150   do:
     2151     run diasize_maximize in this-procedure
     2152       (input  ?
     2153       ).
     2154     return no-apply .
     2155   end.
     2156   procedure diasize_end-move :
     2157     do
     2158     on error undo, return error return-value
     2159     :
     2160       define variable v-row-delta as decimal   no-undo .
     2161       define variable v-col-delta as decimal   no-undo .
     2162       define variable v-new-row as decimal   no-undo .
     2163       define variable v-new-col as decimal   no-undo .
     2164       assign
     2165         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2166         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2167       .
     2168       assign
     2169         v-row-delta = v-new-row - frame Dialog-Frame :height
     2170         v-col-delta = v-new-col - frame Dialog-Frame :width
     2171       .
     2172       run diasize_change-height in this-procedure
     2173         (input v-row-delta
     2174         ,input true
     2175         ) .
     2176       run diasize_change-width in this-procedure
     2177         (input v-col-delta
     2178         ,input true
     2179         ) .
     2180     end.
     2181   end procedure.
     2182   procedure diasize_maximize :
     2183     define input  parameter p-action as logical   no-undo .
     2184     do
     2185     on error undo, return error return-value
     2186     :
     2187       if p-action = ?
     2188       then do:
     2189         if v-diasize-need-maximize = true
     2190         then do:
     2191           assign
     2192             p-action = true
     2193           .
     2194         end.
     2195         else do:
     2196           assign
     2197             p-action = false
     2198           .
     2199         end.
     2200       end.
     2201       if p-action = true
     2202       then do:
     2203         run diasize_change-height in this-procedure
     2204           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2205               - frame Dialog-Frame :height-chars
     2206           ,input true
     2207           ) .
     2208         run diasize_change-width in this-procedure
     2209           (input session :width-chars
     2210               - frame Dialog-Frame :width-chars
     2211           ,input true
     2212           ) .
     2213         assign
     2214           v-diasize-need-maximize = false
     2215         .
     2216       end.
     2217       else do:
     2218         run diasize_change-width in this-procedure
     2219           (input v-diasize-orig-frame-width
     2220               - frame Dialog-Frame :width-chars
     2221           ,input true
     2222           ) .
     2223         run diasize_change-height in this-procedure
     2224           (input v-diasize-orig-frame-height
     2225               - frame Dialog-Frame :height-chars
     2226           ,input true
     2227           ) .
     2228         assign
     2229           v-diasize-need-maximize = true
     2230         .
     2231       end.
     2232     end.
     2233   end procedure.
     2234   procedure diasize_restore-orig-size :
     2235     do
     2236     on error undo, return error return-value
     2237     :
     2238       assign
     2239         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2240         v-diasize-current-frame-height = frame Dialog-Frame :height
     2241       .
     2242       run diasize_set-height in this-procedure
     2243         (input  v-diasize-orig-frame-height
     2244         ,input  true
     2245         ) .
     2246       run diasize_set-width in this-procedure
     2247         (input  v-diasize-orig-frame-width
     2248         ,input  true
     2249         ) .
     2250     end.
     2251   end procedure.
     2252   procedure diasize_restore-current-size :
     2253     do
     2254     on error undo, return error return-value
     2255     :
     2256       run diasize_set-height in this-procedure
     2257         (input  v-diasize-current-frame-height
     2258         ,input  true
     2259         ) .
     2260       run diasize_set-width in this-procedure
     2261         (input  v-diasize-current-frame-width
     2262         ,input  true
     2263         ) .
     2264     end.
     2265   end procedure.
     2266   procedure diasize_set-browse-handle :
     2267     define input  parameter p-browse-handle as handle   no-undo .
     2268     define buffer buf_temp-browse-handle for temp-browse-handle .
     2269     do
     2270     on error undo, return error return-value
     2271     :
     2272       assign
     2273         v-diasize-browse-handle = p-browse-handle
     2274       .
     2275       for each buf_temp-browse-handle
     2276       on error undo, return error return-value
     2277       :
     2278         delete buf_temp-browse-handle .
     2279       end.
     2280     end.
     2281   end procedure.
     2282   procedure diasize_add_browse :
     2283     define input  parameter p-browse-type   as character no-undo .
     2284     define input  parameter p-browse-handle as handle    no-undo .
     2285     define buffer buf_temp-browse-handle for temp-browse-handle .
     2286     do
     2287     on error undo, return error return-value
     2288     :
     2289       assign
     2290         v-diasize-browse-number = v-diasize-browse-number + 1
     2291       .
     2292       create buf_temp-browse-handle .
     2293       assign
     2294         buf_temp-browse-handle.browse-type   = p-browse-type
     2295         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2296         buf_temp-browse-handle.browse-handle = p-browse-handle
     2297       .
     2298     end.
     2299   end procedure.
     2300   procedure diasize_init :
     2301     define variable v-default-value    as logical   no-undo .
     2302     define variable v-restore-saved    as logical   no-undo .
     2303     define variable v-resize-value-str as character no-undo .
     2304     do
     2305     on error undo, return error return-value
     2306     :
     2307       do with frame Dialog-Frame
     2308       :
     2309         assign
     2310           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2311           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2312           v-diasize-browse-handle     = browse br-dis-dc-rule :handle
     2313         .
     2314         create button v-diasize-resize-button
     2315         assign
     2316           parent        = frame Dialog-Frame :first-child
     2317           label         = "s"
     2318           height-pixels = 16
     2319           width-pixels  = 16
     2320           visible       = true
     2321           sensitive     = true
     2322           movable       = true
     2323           triggers:
     2324             on end-move persistent run diasize_end-move in this-procedure .
     2325           end triggers.
     2326         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2327         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2328         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2329         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2330         assign
     2331           v-diasize-wndmax = false
     2332         .
     2333         if connected("ub") = true
     2334         then do:
     2335           define variable v-cntxt-db-num        as integer   no-undo .
     2336           define variable v-cntxt-userid        as character no-undo .
     2337           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2338                                             , OUTPUT v-cntxt-userid
     2339                                             ) .
     2340           run gbl/wndpar_r.p
     2341             (input  v-cntxt-db-num
     2342             ,input  v-cntxt-userid
     2343             ,input  'wndmax':U
     2344             ,output v-diasize-wndmax
     2345             ,output v-default-value
     2346             ) .
     2347         end.
     2348         assign
     2349           v-diasize-wndstore = false
     2350         .
     2351         if connected("ub") = true
     2352         then do:
     2353           run gbl/wndpar_r.p
     2354             (input  v-cntxt-db-num
     2355             ,input  v-cntxt-userid
     2356             ,input  'wndstore':U
     2357             ,output v-diasize-wndstore
     2358             ,output v-default-value
     2359             ) .
     2360         end.
     2361         assign
     2362           v-diasize-proc-name = entry(1, program-name(2), '.')
     2363         .
     2364         if v-diasize-wndstore = true
     2365         then do:
     2366           assign
     2367             v-restore-saved = false
     2368           .
     2369           if connected("ub") = true
     2370           then do:
     2371             run gbl/wndsizer.p
     2372               (input  v-cntxt-db-num
     2373               ,input  v-cntxt-userid
     2374               ,input  v-diasize-proc-name
     2375               ,input  'height':u
     2376               ,output v-resize-value-str
     2377               ) .
     2378             if v-resize-value-str <> '':U
     2379             then do:
     2380               run diasize_change-height in this-procedure
     2381                 (input  integer(v-resize-value-str)
     2382                 ,input  true
     2383                 ) .
     2384               assign
     2385                 v-restore-saved = true
     2386               .
     2387             end.
     2388           end.
     2389           if connected("ub") = true
     2390           then do:
     2391             run gbl/wndsizer.p
     2392               (input  v-cntxt-db-num
     2393               ,input  v-cntxt-userid
     2394               ,input  v-diasize-proc-name
     2395               ,input  'width':u
     2396               ,output v-resize-value-str
     2397               ) .
     2398             if v-resize-value-str <> '':U
     2399             then do:
     2400               run diasize_change-width in this-procedure
     2401                 (input  integer(v-resize-value-str)
     2402                 ,input  true
     2403                 ) .
     2404               assign
     2405                 v-restore-saved = true
     2406               .
     2407             end.
     2408           end.
     2409           if v-restore-saved <> true
     2410           then do:
     2411             if v-diasize-wndmax = true
     2412             then do:
     2413               run diasize_maximize in this-procedure
     2414                 (input  true
     2415                 ) .
     2416             end.
     2417           end.
     2418         end.
     2419         else do:
     2420           if v-diasize-wndmax = true
     2421           then do:
     2422             run diasize_maximize in this-procedure
     2423               (input  true
     2424               ) .
     2425           end.
     2426         end.
     2427       end.
     2428     end.
     2429   end procedure.
     2430   procedure diasize_need-full-display :
     2431     define output parameter p-need-full-display as logical   no-undo .
     2432     do
     2433     on error undo, return error return-value
     2434     :
     2435       assign
     2436         p-need-full-display = v-diasize-need-full-display
     2437       .
     2438       assign
     2439         v-diasize-need-full-display = false
     2440       .
     2441     end.
     2442   end procedure.
     2443   procedure get-context :
     2444      define output parameter p-db-num as integer          no-undo.
     2445      define output parameter p-user-id as character        no-undo.
     2446      define variable v-login               as character    no-undo.
     2447      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2448      define buffer buf_user-login  for ub.user-login .
     2449      do
     2450      on error undo, return error
     2451      :
     2452            FIND FIRST buf_sys-ctrl no-lock.
     2453            ASSIGN
     2454               v-login = USERID("ub")
     2455               p-db-num = buf_sys-ctrl.db-num
     2456            .
     2457            FIND FIRST buf_user-login
     2458                 WHERE buf_user-login.db-num = p-db-num
     2459                   AND buf_user-login.user-login = v-login
     2460                 no-lock
     2461                 no-error
     2462                 .
     2463            IF AVAILABLE buf_user-login
     2464            THEN DO:
     2465               assign
     2466                  p-user-id = buf_user-login.user-id
     2467               .
     2468            END.
     2469      end.
     2470   end procedure.
     2471   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2472   on f5 of frame Dialog-Frame anywhere
     2473   do:
