        1   define input parameter parparentproc as widget-handle no-undo .
        2   define input parameter action        as character no-undo .
        3   define input parameter base-bc       like ub.bar-code.b-code no-undo .
        4   define input-output parameter rid    as recid no-undo .
        5   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        6   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        7   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        8   define variable vss-workfile    as character no-undo init "$Workfile: bc-form.w $":U .
        9   define variable vss-archive     as character no-undo init "$Archive: ref/bc-form.w $":U .
       10   define variable vss-description as character no-undo init "Форма работы с собственным бар-кодом".
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
       18     assign
       19       p-vss-revision    = vss-revision
       20       p-vss-author      = vss-author
       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29   end procedure.
       30   define new global shared variable g#vssrevis-logger as handle    no-undo .
       31   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       32   define variable v-vssrevis-logger                   as handle    no-undo .
       33   procedure vss-logevent :
       34     define input  parameter p-extra-paramters as character no-undo .
       35     define variable v-vssrevis-parameters as character no-undo .
       36     do
       37     on error undo, return error return-value
       38     :
       39       if  valid-handle(v-vssrevis-logger)
       40       and v-vssrevis-logger :get-signature("logevent") <> ""
       41       then do:
       42         run vss-get-parameters in this-procedure
       43           (output v-vssrevis-parameters
       44           ).
       45         run logevent in v-vssrevis-logger
       46           (input vss-workfile
       47           ,input vss-revision
       48           ,input v-vssrevis-parameters
       49           ,input p-extra-paramters
       50           ).
       51       end.
       52     end.
       53   end procedure.
       54   assign
       55     v-vssrevis-logger = g#vssrevis-logger
       56   .
       57   if  valid-handle(v-vssrevis-logger)
       58   and v-vssrevis-logger :get-signature("logevent") <> ""
       59   then do:
       60     assign
       61       v-vssrevis-logevent = true
       62     .
       63     run vss-logevent in this-procedure (input vss-description) .
       64   end.
       65   define new global shared variable g#language as character no-undo .
       66   if g#language <> '' and g#language <> 'rus':U then do:
       67     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       68   end.
       69   define new global shared variable g#library  as handle no-undo .
       70   define new global shared variable g#library2 as handle no-undo .
       71   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       72   procedure gen-b-code :
       73     define input  parameter type-code like ub.code-range.range-type no-undo .
       74     define output parameter p-b-code  like ub.bar-code.b-code       no-undo .
       75     do
       76     on error  undo, return error substitute( "&1 (gen-b-code). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
       77     on stop   undo, return error substitute( "&1 (gen-b-code). stop", vss-workfile )
       78     on endkey undo, return error substitute( "&1 (gen-b-code). endkey", vss-workfile )
       79     :
       80       define buffer buf_thbj-attr     for ub.thbj-attr .
       81       define buffer buf_sys-ctrl   for ub.sys-ctrl .
       82       define buffer buf_code-range for ub.code-range .
       83       define variable l-code         as   integer              no-undo .
       84       define variable v-db-num       like ub.db.db-num         no-undo .
       85       define variable cfg-param-code like ub.thbj-attr.prop-code no-undo .
       86       if type-code = 'sslc':U
       87       or type-code = 'ssgb':U
       88       then do:
       89         message
       90           "Нельзя генерировать локальный или глобальный взвешиваемый код." skip
       91           "Обратитесь к администратору системы."
       92           view-as alert-box error .
       93         undo, return error (if type-code = 'sslc':U then "loc-ss-code":U else "gbl-ss-code" ) .
       94       end.
       95       run trg/getpcode.p ( input  type-code
       96                      ,output cfg-param-code
       97                     ).
       98       run get-next-seq( input  type-code,
       99                         output l-code
      100                       ).
      101       find first buf_sys-ctrl no-lock.
      102       if type-code = 'sclc':U
      103       or type-code = 'pglc':U
      104       then do:
      105         assign
      106           v-db-num = 0
      107         .
      108       end.
      109       else do:
      110         assign
      111           v-db-num = buf_sys-ctrl.db-num
      112         .
      113       end.
      114       find first buf_code-range no-lock
      115         where buf_code-range.db-num     = v-db-num
      116           and buf_code-range.range-type = type-code
      117           and buf_code-range.stts       = "a"
      118         use-index stts
      119         no-error .
      120       if available buf_code-range
      121          and l-code <= buf_code-range.last-code
      122          and l-code >= buf_code-range.first-code then do:
      123         assign
      124           p-b-code = l-code
      125         .
      126       end.
      127       else do:
      128         if available buf_code-range
      129            and l-code < buf_code-range.last-code then do:
      130           message
      131             substitute( "Последовательность для создания кодов с типом &1 имеет неверное значение.", type-code ) skip
      132             "Обратитесь к администратору системы."
      133             view-as alert-box error .
      134           undo, return error "sequence":U .
      135         end.
      136         do transaction
      137         on error undo, return error
      138         :
      139           find first buf_thbj-attr exclusive-lock
      140             where buf_thbj-attr.upper-prop-code = 'code-range':U
      141               and buf_thbj-attr.prop-code = cfg-param-code
      142               and buf_thbj-attr.obj-type   = 'БД':U
      143               and buf_thbj-attr.obj-code   = v-db-num
      144             no-error .
      145           if not available buf_thbj-attr then do:
      146             find first buf_thbj-attr exclusive-lock
      147               where buf_thbj-attr.upper-prop-code = 'code-range':U
      148                 and buf_thbj-attr.prop-code = cfg-param-code
      149                 and buf_thbj-attr.obj-type   = ''
      150                 and buf_thbj-attr.obj-code   = 0
      151               no-error .
      152             if not available buf_thbj-attr then do:
      153               if not locked buf_thbj-attr then do:
      154                 message
      155                   substitute( "Отсутствует параметр 'длина диапазона кодов' (&1) для БД &2.", cfg-param-code, buf_sys-ctrl.db-num ) skip
      156                   "Обратитесь к администратору системы."
      157                   view-as alert-box error .
      158               end.
      159               undo, return error "config":U .
      160             end.
      161           end.
      162           run get-next-seq( input type-code,
      163                             output l-code
      164                           ).
      165           find first buf_code-range
      166             where buf_code-range.db-num     = v-db-num
      167               and buf_code-range.range-type = type-code
      168               and buf_code-range.stts       = "a"
      169             use-index stts
      170             no-error .
      171           if available buf_code-range
      172           and l-code <= buf_code-range.last-code
      173           and l-code >= buf_code-range.first-code
      174           then do:
      175             assign
      176               p-b-code = l-code
      177             .
      178           end.
      179           else do:
      180             if available buf_code-range then do:
      181               assign
      182                 buf_code-range.stts = "u"
      183               .
      184             end.
      185             find first buf_code-range
      186               where buf_code-range.db-num     = v-db-num
      187                 and buf_code-range.range-type = type-code
      188                 and buf_code-range.stts       = "f"
      189               use-index stts
      190               no-error .
      191             if not available buf_code-range then do:
      192               message
      193                 substitute( "Отсутствует свободный диапазон для кодов с типом &1.", type-code ) skip
      194                 "Обратитесь к администратору системы"
      195                 view-as alert-box error .
      196               undo, return error "code-range":U .
      197             end.
      198             assign
      199               buf_code-range.stts           = "a"
      200             .
      201             if buf_code-range.first-code = 1 then do:
      202               run set-seq-cr( input type-code,
      203                               input buf_code-range.first-code
      204                             ).
      205               assign
      206                 p-b-code = 1
      207               .
      208             end.
      209             else do:
      210               run set-seq-cr( input type-code,
      211                               input ( buf_code-range.first-code - 1 )
      212                             ).
      213               run get-next-seq( input type-code,
      214                                 output p-b-code
      215                               ).
      216             end.
      217           end.
      218         end.
      219       end.
      220     end.
      221   end procedure.
      222   procedure get-next-seq :
      223     define input  parameter type-code like ub.code-range.range-type no-undo .
      224     define output parameter next-seq  as   integer                  no-undo .
      225     do
      226     on error  undo, return error substitute( "&1 (get-next-seq). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      227     on stop   undo, return error substitute( "&1 (get-next-seq). stop", vss-workfile )
      228     on endkey undo, return error substitute( "&1 (get-next-seq). endkey", vss-workfile )
      229     :
      230       case type-code:
      231         when 'bcgb':U then do:
      232           assign
      233             next-seq = next-value(s-bcgb-code, ub)
      234           .
      235         end.
      236         when 'scgb':U then do:
      237           assign
      238             next-seq = next-value(s-scgb-code, ub)
      239           .
      240         end.
      241         when 'sclc':U then do:
      242           assign
      243             next-seq = next-value(s-sclc-code, ub)
      244           .
      245         end.
      246         when 'pglc':U then do:
      247           assign
      248             next-seq = next-value(s-pglc-code, ub)
      249           .
      250         end.
      251         when 'dcgb':U then do:
      252           assign
      253             next-seq = next-value(s-dcgb-code, ub)
      254           .
      255         end.
      256         when 'ctgb':U then do:
      257           assign
      258             next-seq = next-value(s-ctgb-code, ub)
      259           .
      260         end.
      261         when 'drgb':U then do:
      262           assign
      263             next-seq = next-value(s-drgb-code, ub)
      264           .
      265         end.
      266         when 'fmgb':U then do:
      267           assign
      268             next-seq = next-value(s-fmgb-code, ub)
      269           .
      270         end.
      271         when 'pngb':U then do:
      272           assign
      273             next-seq = next-value(s-pngb-code, ub)
      274           .
      275         end.
      276         when 'cagb':U then do:
      277           assign
      278             next-seq = next-value(s-cagb-code, ub)
      279           .
      280         end.
      281         when 'fdgb':U then do:
      282           assign
      283             next-seq = next-value(s-fin-doc, ub)
      284           .
      285         end.
      286       end case.
      287     end.
      288   end procedure.
      289   procedure set-seq-cr :
      290     define input parameter type-code like ub.code-range.range-type no-undo .
      291     define input parameter set-val   like ub.code-range.first-code no-undo .
      292     do
      293     on error  undo, return error substitute( "&1 (set-seq-cr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      294     on stop   undo, return error substitute( "&1 (set-seq-cr). stop", vss-workfile )
      295     on endkey undo, return error substitute( "&1 (set-seq-cr). endkey", vss-workfile )
      296     :
      297       case type-code:
      298         when 'bcgb':U then do:
      299           assign
      300             current-value(s-bcgb-code, ub) = set-val
      301           .
      302         end.
      303         when 'scgb':U then do:
      304           assign
      305             current-value(s-scgb-code, ub) = set-val
      306           .
      307         end.
      308         when 'sclc':U then do:
      309           assign
      310             current-value(s-sclc-code, ub) = set-val
      311           .
      312         end.
      313         when 'pglc':U then do:
      314           assign
      315             current-value(s-pglc-code, ub) = set-val
      316           .
      317         end.
      318         when 'dcgb':U then do:
      319           assign
      320             current-value(s-dcgb-code, ub) = set-val
      321           .
      322         end.
      323         when 'ctgb':U then do:
      324           assign
      325             current-value(s-ctgb-code, ub) = set-val
      326           .
      327         end.
      328         when 'drgb':U then do:
      329           assign
      330             current-value(s-drgb-code, ub) = set-val
      331           .
      332         end.
      333         when 'fmgb':U then do:
      334           assign
      335             current-value(s-fmgb-code, ub) = set-val
      336           .
      337         end.
      338         when 'pngb':U then do:
      339           assign
      340             current-value(s-pngb-code, ub) = set-val
      341           .
      342         end.
      343         when 'cagb':U then do:
      344           assign
      345             current-value(s-cagb-code, ub) = set-val
      346           .
      347         end.
      348         when 'fdgb':U then do:
      349           assign
      350             current-value(s-fin-doc, ub) = set-val
      351           .
      352         end.
      353       end case.
      354     end.
      355   end procedure.
      356   procedure new-bcod-gen-code-range :
      357     do
      358     on error  undo, return error substitute( "&1 (new-bcod-gen-code-range). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      359     on stop   undo, return error substitute( "&1 (new-bcod-gen-code-range). stop", vss-workfile )
      360     on endkey undo, return error substitute( "&1 (new-bcod-gen-code-range). endkey", vss-workfile )
      361     :
      362       define input parameter p-db-num  like ub.db.db-num             no-undo .
      363       define input parameter type-code like ub.code-range.range-type no-undo .
      364       define buffer buf_code-range      for ub.code-range .
      365       define buffer last_code-range     for ub.code-range .
      366       define buffer last-1_code-range   for ub.code-range .
      367       define buffer last-2_code-range   for ub.code-range .
      368       define buffer last-3_code-range   for ub.code-range .
      369       define buffer buf_sys-ctrl        for ub.sys-ctrl .
      370       define variable conf-par       as character no-undo .
      371       define variable par-type       as character no-undo .
      372       define variable cfg-param-code like ub.thbj-attr.prop-code no-undo .
      373       define variable v-cre-cdrg as logical   no-undo .
      374       define variable v-cre-str  as character no-undo .
      375       define variable v-cr1      as integer no-undo .
      376       define variable v-cr2      as integer no-undo .
      377       define variable v-cr3      as integer no-undo .
      378       define variable v-cmax     as integer no-undo .
      379       find first buf_sys-ctrl no-lock .
      380       if buf_sys-ctrl.db-num <> 0 and type-code <> 'cagb':U then do:
      381         undo, return error substitute("&1 &2 &3&4Диапазоны кодов можно создавать только в ГБД&4База данных &5"
      382                                       ,vss-workfile
      383                                       ,vss-revision
      384                                       ,vss-description
      385                                       ,chr(10)
      386                                       , p-db-num
      387                                      ).
      388       end.
      389       run trg/getpcode.p ( input  type-code
      390                      ,output cfg-param-code
      391                     ).
      392       for each buf_code-range
      393         where buf_code-range.db-num     = -1
      394           and buf_code-range.range-type = type-code
      395           and buf_code-range.stts       = "f"
      396       by buf_code-range.first-code
      397       on error  undo, return error substitute( "&1 (new-bcod-gen-code-range). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      398       on stop   undo, return error substitute( "&1 (new-bcod-gen-code-range). stop", vss-workfile )
      399       on endkey undo, return error substitute( "&1 (new-bcod-gen-code-range). endkey", vss-workfile )
      400       :
      401         assign
      402           buf_code-range.db-num = p-db-num
      403         .
      404         return .
      405       end.
      406       assign
      407         v-cre-cdrg = TRUE
      408       .
      409       case type-code:
      410         when 'sclc':U
      411         or when 'scgb':U
      412         or when 'pglc':U
      413         then do:
      414           find last last-1_code-range no-lock
      415             where last-1_code-range.range-type = 'sclc':U
      416             no-error .
      417           if available last-1_code-range then do:
      418             v-cr1 = last-1_code-range.last-code.
      419           end.
      420           find last last-2_code-range no-lock
      421             where last-2_code-range.range-type = 'scgb':U
      422             no-error .
      423           if available last-2_code-range then do:
      424             v-cr2 = last-2_code-range.last-code.
      425             end.
      426           find last last-3_code-range no-lock
      427             where last-3_code-range.range-type = 'pglc':U
      428             no-error .
      429           if available last-3_code-range then do:
      430             v-cr3 = last-3_code-range.last-code.
      431           end.
      432           v-cmax = maximum(v-cr1, v-cr2, v-cr3)
      433           .
      434           if v-cmax = v-cr1  then do:
      435               find last last_code-range no-lock
      436                 where recid( last_code-range ) = recid( last-1_code-range )
      437                 .
      438             end.
      439           if v-cmax = v-cr2  then do:
      440               find last last_code-range no-lock
      441                 where recid( last_code-range ) = recid( last-2_code-range )
      442                 .
      443             end.
      444           if v-cmax = v-cr3  then do:
      445             find last last_code-range no-lock
      446               where recid( last_code-range ) = recid( last-3_code-range )
      447               .
      448           end.
      449           if last_code-range.last-code + 1 > 99999 then do:
      450             assign
      451               v-cre-cdrg = FALSE
      452             .
      453           end.
      454         end.
      455         when 'bcgb':U
      456         or when 'sslc':U
      457         or when 'ssgb':U
      458         then do:
      459           find last last-1_code-range no-lock
      460             where last-1_code-range.range-type = 'sslc':U
      461             no-error .
      462           if available last-1_code-range then do:
      463             v-cr1 = last-1_code-range.last-code.
      464           end.
      465           find last last-2_code-range no-lock
      466             where last-2_code-range.range-type = 'bcgb':U
      467             no-error .
      468           if available last-2_code-range then do:
      469             v-cr2 = last-2_code-range.last-code.
      470             end.
      471           find last last-3_code-range no-lock
      472             where last-3_code-range.range-type = 'ssgb':U
      473             no-error .
      474           if available last-3_code-range then do:
      475             v-cr3 = last-3_code-range.last-code.
      476           end.
      477           v-cmax = maximum(v-cr1, v-cr2, v-cr3)
      478           .
      479           if v-cmax = v-cr1  then do:
      480               find last last_code-range no-lock
      481                 where recid( last_code-range ) = recid( last-1_code-range )
      482                 .
      483             end.
      484           if v-cmax = v-cr2  then do:
      485               find last last_code-range no-lock
      486                 where recid( last_code-range ) = recid( last-2_code-range )
      487                 .
      488             end.
      489           if v-cmax = v-cr3  then do:
      490             find last last_code-range no-lock
      491               where recid( last_code-range ) = recid( last-3_code-range )
      492               .
      493           end.
      494         end.
      495         otherwise do:
      496           find last last_code-range no-lock
      497             where last_code-range.range-type = type-code
      498             no-error .
      499         end.
      500       end case.
      501       if not available last_code-range then do:
      502         undo, return error substitute("&1 &2 &3&4В БД нет ни одного диапазона с типом &5&4Не была проведена инициализация диапазонов!"
      503                                       ,vss-workfile
      504                                       ,vss-revision
      505                                       ,vss-description
      506                                       , chr(10)
      507                                       , type-code
      508                                      ) .
      509       end.
      510       define variable v-mes0 as character no-undo .
      511       define variable v-param-type0 as character no-undo .
      512       define variable v-value-character0 as INTEGER no-undo .
      513       define variable v-value-date0 as date no-undo .
      514       define variable v-value-decimal0 as decimal no-undo .
      515       define variable v-value-integer0 AS integer no-undo .
      516       define variable v-value-logical0 AS LOGICAL no-undo .
      517       define variable v-tth0 as handle no-undo .
      518       run adm/shattri.p (
      519           input "get":U
      520           ,input  'БД':U
      521           ,input  p-db-num
      522           ,input  'code-range':U
      523           ,input  cfg-param-code
      524           ,output v-value-character0
      525           ,output v-value-date0
      526           ,output v-value-decimal0
      527           ,output v-value-integer0
      528           ,output v-value-logical0
      529           ,output v-param-type0
      530           ,INPUT-OUTPUT table-handle v-tth0
      531           ) no-error .
      532       if error-status :error then do:
      533         delete object v-tth0.
      534         v-mes0 = substitute("Ошибка при получении размера диапазона собственных глобальных кодов&2&1&2&3"
      535                            , error-status:get-message(1)
      536                            , chr(10)
      537                            , return-value ).
      538         undo, return error v-mes0.
      539       end.
      540       delete object v-tth0.
      541       if v-cre-cdrg = TRUE then do:
      542         create buf_code-range .
      543         assign
      544           buf_code-range.db-num     = p-db-num
      545           buf_code-range.range-type = type-code
      546           buf_code-range.stts       = "f"
      547           buf_code-range.first-code = last_code-range.last-code + 1
      548           buf_code-range.last-code  = last_code-range.last-code + integer(v-value-integer0)
      549           v-cre-str = "Свободный диапазон успешно создан"
      550         .
      551       end.
      552       else do:
      553         assign
      554           v-cre-str = "Нет возможности создать свободный диапазон." + chr(10)
      555                       + substitute( "Превышен предел диапазонов c типом &1", type-code )
      556         .
      557       end.
      558     end.
      559     return v-cre-str .
      560   end procedure.
      561   procedure gen-new-code-range-if-neces :
      562     define input parameter v-db-num           like ub.db.db-num             no-undo .
      563     define input parameter v-range-type       like ub.code-range.range-type no-undo .
      564     define input parameter v-cur-code         as   integer                  no-undo .
      565     define input parameter v-g#news           as   logical                  no-undo .
      566     define input parameter v-g#db-num         like ub.db.db-num             no-undo .
      567     define input parameter v-g#news-source-db like ub.db.db-num             no-undo .
      568     do
      569     on error  undo, return error substitute( "&1 (gen-new-code-range-if-neces). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      570     on stop   undo, return error substitute( "&1 (gen-new-code-range-if-neces). stop", vss-workfile )
      571     on endkey undo, return error substitute( "&1 (gen-new-code-range-if-neces). endkey", vss-workfile )
      572     :
      573       define variable l-code-range-exist as logical   no-undo init false .
      574       define variable v-db-for-send      as character no-undo .
      575       define buffer buf_code-range  for ub.code-range .
      576       define buffer buf1_code-range for ub.code-range .
      577       define buffer buf_db          for ub.db .
      578       find first buf_code-range
      579         where buf_code-range.range-type = v-range-type
      580           and buf_code-range.last-code >= v-cur-code
      581         use-index last-codei
      582         no-error .
      583       if
      584       (
      585          available buf_code-range
      586          and
      587         (buf_code-range.db-num = v-db-num
      588           and
      589         buf_code-range.first-code <= v-cur-code
      590         )
      591       or
      592         (
      593           v-range-type = 'drgb':U
      594           AND
      595           v-cur-code = 0
      596         )
      597      )
      598      then do:
      599         assign
      600           l-code-range-exist = true
      601         .
      602         if v-g#news
      603         and buf_code-range.stts = "f" then do:
      604           assign
      605             buf_code-range.stts = "u"
      606           .
      607         end.
      608       end.
      609       if not l-code-range-exist
      610          and v-g#news-source-db <> 0
      611       then do:
      612         undo, return error substitute("&1 &2 &3&4Отсутствует диапазон кодов для БД &5 Тип диапазона кодов &6 Код &7"
      613                                       ,vss-workfile
      614                                       ,vss-revision
      615                                       ,vss-description
      616                                       ,chr(10)
      617                                       ,v-db-num
      618                                       ,v-range-type
      619                                       ,v-cur-code
      620                                      ).
      621       end.
      622       if (not l-code-range-exist
      623           or ( v-cur-code >= int( (buf_code-range.first-code + buf_code-range.last-code) / 2 ) )
      624          )
      625       and ( not can-find (first buf1_code-range no-lock
      626                           where buf1_code-range.db-num = v-db-num
      627                             and buf1_code-range.range-type = v-range-type
      628                             and buf1_code-range.stts = "f"
      629                          )
      630           )
      631       then do:
      632         if v-g#db-num = 0 then do:
      633           run new-bcod-gen-code-range in this-procedure
      634             (input v-db-num,
      635              input v-range-type
      636             ) no-error .
      637           if error-status :error then do:
      638             undo, return error substitute("Ошибка при создании нового свободного диапазона &1 Тип диапазона кодов &2 Код &3:&4&5 &6"
      639                                           , substitute("&1 &2 &3", vss-workfile, vss-revision, vss-description)
      640                                           ,v-db-num
      641                                           ,v-range-type
      642                                           ,v-cur-code
      643                                           ,chr(10)
      644                                           ,error-status:get-message(1)
      645                                           ,return-value
      646                                          ).
      647           end.
      648         end.
      649         else do:
      650           if v-range-type = 'sclc':U
      651           or v-range-type = 'pglc':U
      652           then do:
      653             assign
      654               v-db-for-send = "":U
      655             .
      656             if v-g#db-num = 0 then do:
      657               for each buf_db no-lock
      658                 where buf_db.db-num > 0
      659                   and buf_db.db-num <> v-g#news-source-db
      660               on error  undo, return error substitute( "&1 (gen-new-code-range-if-neces). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      661               :
      662                 assign
      663                   v-db-for-send = v-db-for-send + chr(1) + string( buf_db.db-num )
      664                 .
      665               end.
      666               assign
      667                 v-db-for-send = right-trim( v-db-for-send, chr(1) )
      668               .
      669             end.
      670             else do:
      671               if not v-g#news then do:
      672                 assign
      673                   v-db-for-send = "0":U
      674                 .
      675               end.
      676             end.
      677             run nws/cr-route.p ( input 'send-cmd':U
      678                           ,input ("command":U + chr(1) + "create":U + chr(1) +
      679                                  "code-range":U + chr(1) +
      680                                  (if v-range-type = 'sclc':U
      681                                   then string( current-value(s-sclc-code, ub))
      682                                   else string( current-value(s-pglc-code, ub))
      683                                   ) + chr(1) +
      684                                   v-range-type)
      685                           ,input ?
      686                           ,input v-db-for-send
      687                           ) no-error .
      688             if error-status :error then do:
      689               undo, return error return-value.
      690             end.
      691           end.
      692         end.
      693       end.
      694     end.
      695   end procedure.
      696   procedure cre-loc-sc-code-range :
      697     define input parameter v-cur-code as integer no-undo .
      698   define input parameter p-cdrg-type as character no-undo .
      699     do
      700     on error  undo, return error substitute( "&1 (cre-loc-sc-code-range). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      701     on stop   undo, return error substitute( "&1 (cre-loc-sc-code-range). stop", vss-workfile )
      702     on endkey undo, return error substitute( "&1 (cre-loc-sc-code-range). endkey", vss-workfile )
      703     :
      704       define buffer buf_code-range for ub.code-range .
      705       find first buf_code-range
      706            where buf_code-range.range-type = p-cdrg-type
      707              and buf_code-range.first-code >= v-cur-code
      708            no-error .
      709       if not available buf_code-range then do:
      710         run new-bcod-gen-code-range in this-procedure
      711           ( input 0,
      712             input p-cdrg-type
      713           ) no-error .
      714         if error-status :error then do:
      715           undo, return error substitute( "Ошибка при создании нового свободного диапазона локальных весовых или штучных кодов&1"
      716                                          + "Код &2&1&3 &4"
      717                                         , chr(10)
      718                                         , v-cur-code
      719                                         , error-status:get-message(1)
      720                                         , return-value
      721                                        ) .
      722         end.
      723       end.
      724     end.
      725   end procedure.
      726   procedure mark-used-if-need :
      727   define input parameter p-cur-code as integer no-undo .
      728   define input parameter p-range-type like ub.code-range.range-type no-undo .
      729   define input parameter p-db-num like ub.code-range.db-num no-undo .
      730     do
      731     on error  undo, return error substitute( "&1 (mark-used-if-need). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      732     on stop   undo, return error substitute( "&1 (mark-used-if-need). stop", vss-workfile )
      733     on endkey undo, return error substitute( "&1 (mark-used-if-need). endkey", vss-workfile )
      734     :
      735       DEFINE VARIABLE v-db-num like ub.code-range.db-num no-undo .
      736       define buffer buf_code-range for ub.code-range .
      737       assign
      738       v-db-num = if p-range-type = 'sclc':U
      739                  then 0
      740                  else p-db-num
      741       .
      742   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      743   define buffer locK-batchprocess1 for ub.batchprocess.
      744   run gbl/lock-prc.p
      745       (input 'lscc':U
      746       ,input 0
      747       ,input 0
      748       ,input 0
      749       ,input ""
      750       ,input ""
      751       ,input ""
      752       ,input (
      753               ",,,Вкл/выкл лок. вес. кодов"
      754              )
      755       ,input true
      756       ,buffer lock-batchprocess1
      757       ) no-error .
      758     if error-status :error then do:
      759       message
      760         vss-workfile vss-revision vss-description skip
      761         "В данный момент идет процесс вкл/выкл лок. вес. кодов" skip
      762         view-as alert-box error .
      763       undo, return error .
      764     end.
      765       find first buf_code-range
      766            where buf_code-range.range-type = p-range-type
      767              and buf_code-range.first-code >= p-cur-code
      768              and buf_code-range.last-code <= p-cur-code
      769              and buf_code-range.db-num = v-db-num
      770            no-error .
      771       if not available buf_code-range then do:
      772         message
      773           vss-workfile vss-revision vss-description skip
      774           "Ошибка при создании поиске диапазона" skip
      775           "База данных" p-db-num skip
      776           "Код" p-cur-code skip
      777           "Тип" p-range-type
      778           error-status :get-message(1) skip
      779           return-value skip
      780           view-as alert-box error .
      781         undo, return error .
      782       end.
      783       if buf_code-range.stts = "f":U then do:
      784         assign
      785         buf_code-range.stts = "u":U
      786         .
      787       end.
      788     end.
      789   end procedure.
      790   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      791   define variable send-ref as logical no-undo.
      792     define variable dops as character no-undo format "X(250)".
      793     define variable dopst as character no-undo format "X(1)".
      794   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
      795     (input  'send-ref'
      796     ,input  0
      797     ,input  ''
      798     ,input  0
      799     ,input  ''
      800     ,input  ''
      801     ,input  ''
      802     ,input  no
      803     ,output dops
      804     ,output dopst
      805     ) no-error .
      806     send-ref = (IF error-status:error or dops <> "yes" then no else yes).
      807   procedure proc-alt-shift-f2:
      808     if not ibs.th.gbl.gbl-var:rcode
      809   then
      810     run gbl\inidebug.p .
      811   end.
      812   procedure proc-alt-shift-f3:
      813     run gbl/prvssinf.p
      814       ( input this-procedure
      815       ) .
      816   end.
      817   define variable v-inform-launched as logical no-undo initial false .
      818   procedure proc-alt-shift-f4:
      819     define variable v-action as character no-undo .
      820     if v-inform-launched = false then do:
      821       assign
      822         v-inform-launched = true
      823       .
      824       run gbl/d-inform.w
      825         (  input self
      826         ,  input this-procedure
      827         , output v-action
      828         ) no-error .
      829       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      830       assign
      831         v-inform-launched = false
      832       .
      833     end.
      834   end.
      835   procedure proc-alt-f1:
      836     run gbl/corrhelp.p
      837       (input this-procedure
      838       ) .
      839   end .
      840   on alt-shift-f2 anywhere do:
      841     run proc-alt-shift-f2.
      842   end.
      843   on alt-shift-f3 anywhere do:
      844     run proc-alt-shift-f3 in this-procedure .
      845   end.
      846   on alt-shift-f4 anywhere do:
      847     run proc-alt-shift-f4 in this-procedure.
      848   end.
      849   on alt-f1 anywhere do:
      850     run proc-alt-f1 in this-procedure .
      851   end.
      852   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      853     define variable v-cntxt-db-num        as integer   no-undo .
      854     define variable v-cntxt-userid        as character no-undo .
      855     define variable v-cntxt-level         as character no-undo .
      856     define variable v-cntxt-host-code-obj as integer   no-undo .
      857     define variable v-cntxt-obj-type      as character no-undo .
      858     define variable v-cntxt-obj-code      as integer   no-undo .
      859     define variable v-cntxt-db-num-obj    as integer   no-undo .
      860     define variable v-cntxt-is-admin      as logical   no-undo .
      861   define buffer base-bar-code for ub.bar-code.
      862   define buffer u-base    for ub.units.
      863   DEFINE BUTTON b-exit AUTO-GO
      864        LABEL "&Ввод"
      865        SIZE 10 BY 1
      866        BGCOLOR 8 .
      867   DEFINE BUTTON b-help
      868        LABEL "Помо&щь"
      869        SIZE 10 BY 1
      870        BGCOLOR 8 .
      871   DEFINE BUTTON b-quit AUTO-END-KEY
      872        LABEL "&Отмена"
      873        SIZE 10 BY 1
      874        BGCOLOR 8 .
      875   DEFINE BUTTON r-units
      876        IMAGE-UP FILE "btn-down-arrow":U
      877        IMAGE-DOWN FILE "btn-down-arrow":U
      878        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      879        LABEL "r-units"
      880        SIZE 3 BY .88.
      881   DEFINE FRAME d-bc-form
      882        b-exit AT ROW 1 COL 1
      883        b-quit AT ROW 1 COL 11
      884        b-help AT ROW 1 COL 21
      885        ub.bar-code.b-code AT ROW 2.25 COL 15 COLON-ALIGNED FORMAT ">>>>>>>>>>>>9"
      886             VIEW-AS FILL-IN
      887             SIZE 25 BY 1
      888             FGCOLOR 4
      889        ub.bar-code.unit-cli AT ROW 3.54 COL 15 COLON-ALIGNED
      890             LABEL "Ед.изм."
      891             VIEW-AS FILL-IN
      892             SIZE 5.5 BY 1
      893        r-units AT ROW 3.58 COL 22.63
      894        ub.units.long-name AT ROW 3.58 COL 23.75 COLON-ALIGNED NO-LABEL
      895             VIEW-AS FILL-IN
      896             SIZE 31.75 BY 1
      897             FGCOLOR 4
      898        ub.goods.unit-base AT ROW 4.92 COL 15 COLON-ALIGNED
      899             LABEL "Осн. ед. изм."
      900             VIEW-AS FILL-IN
      901             SIZE 5.25 BY 1
      902        ub.bar-code.cli-base-rate AT ROW 4.92 COL 36.5 COLON-ALIGNED FORMAT ">,>>9.9999999999"
      903             VIEW-AS FILL-IN
      904             SIZE 18.75 BY 1
      905        SPACE(1.49) SKIP(0.65)
      906       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      907            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      908            TITLE ""
      909            DEFAULT-BUTTON b-exit CANCEL-BUTTON b-quit.
      910   ASSIGN
      911          FRAME d-bc-form:SCROLLABLE       = FALSE
      912          FRAME d-bc-form:HIDDEN           = TRUE.
      913   ON GO OF FRAME d-bc-form
      914   DO:
      915     run create-bar-code no-error .
      916     if error-status :error
      917     then do:
      918       return no-apply .
      919     end.
      920   END.
      921   ON WINDOW-CLOSE OF FRAME d-bc-form
      922   DO:
      923     APPLY "END-ERROR":U TO SELF.
      924   END.
      925   ON RETURN OF ub.bar-code.cli-base-rate IN FRAME d-bc-form
      926   DO:
      927     apply "entry" to b-exit in frame d-bc-form.
      928     return no-apply.
      929   END.
      930   ON CHOOSE OF r-units IN FRAME d-bc-form
      931   do:
      932     define variable ref-rec as recid no-undo .
      933     run ref/units.w
      934       (input parparentproc
      935       ,input  yes
      936       ,output ref-rec
      937       ).
      938     if ref-rec = ?
      939     then do:
      940       apply "entry" to r-units in frame d-bc-form.
      941       return no-apply.
      942     end.
      943     find ub.units no-lock
      944       where recid (ub.units) = ref-rec
      945       .
      946     display
      947       ub.units.unit-name @ ub.bar-code.unit-cli
      948       ub.units.long-name
      949       with frame d-bc-form.
      950     apply "entry" to ub.bar-code.cli-base-rate in frame d-bc-form.
      951   end.
      952   ON RETURN OF ub.bar-code.unit-cli IN FRAME d-bc-form
      953   DO:
      954     define variable ref-rec as recid no-undo .
      955     if not can-FIND (ub.units where ub.units.unit-name = input frame d-bc-form ub.bar-code.unit-cli)
      956     then do:
      957       run ref/units.w ( input parparentproc
      958                        ,input yes
      959                        ,output ref-rec).
      960       if ref-rec = ?
      961       then do:
      962          apply "entry" to ub.bar-code.unit-cli in frame d-bc-form.
      963          return no-apply.
      964       end.
      965       FIND ub.units WHERE recid (ub.units) = ref-rec NO-LOCK.
      966       DISPLAY
      967       ub.units.unit-name @ ub.bar-code.unit-cli
      968       ub.units.long-name with frame d-bc-form.
      969     end.
      970     apply "entry" to ub.bar-code.cli-base-rate in frame d-bc-form.
      971     return no-apply.
      972   END.
      973   IF VALID-HANDLE (ACTIVE-WINDOW) AND FRAME d-bc-form:PARENT eq ?
      974   THEN FRAME d-bc-form:PARENT = ACTIVE-WINDOW.
      975   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      976   on help of frame d-bc-form
      977   do:
      978     run gbl/app_help.p
      979       (input this-procedure :file-name
      980       ,input ''
      981       ,input ?
      982       ) no-error.
      983     if error-status :error then do:
      984       message
      985         "Ошибка при вызове помощи"
      986         error-status :get-message(1)
      987         view-as alert-box .
      988     end.
      989   end.
      990   run minbtn-set in this-procedure .
      991   on choose of b-help in frame d-bc-form
      992   do:
      993     apply "help":u to frame d-bc-form .
      994   end.
      995   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      996   procedure minbtn-set :
      997       do
      998           on error undo, return error return-value
      999           :
     1000           define variable ii              as integer       no-undo .
     1001           define variable fh              as widget-handle no-undo .
     1002           define variable hh              as widget-handle no-undo .
     1003           define variable v-h             as handle        extent 4 no-undo .
     1004           define variable v-name-button   as character     no-undo .
     1005           define variable v-help-old-x    as decimal       no-undo .
     1006           define variable v-help-old-y    as decimal       no-undo .
     1007           define variable v-help-old-size as decimal       no-undo .
     1008           define variable v-frame-width   as decimal       no-undo .
     1009           define variable jj              as integer       no-undo .
     1010           do
     1011               on error undo, return error
     1012               :
     1013               assign
     1014                   v-frame-width = frame d-bc-form:width - 0.3
     1015                   fh            = frame d-bc-form:first-child
     1016                   hh            = fh:first-child
     1017                   ii            = 1
     1018                   .
     1019               do while valid-handle(hh):
     1020                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1021                   do:
     1022                       case lc(hh:name) :
     1023                           when "b-help" then
     1024                               do:
     1025                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1026                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1027                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1028                                   hh:TOOLTIP = "Помощь" .
     1029                                   v-help-old-x = hh:column .
     1030                                   v-help-old-y = hh:row    .
     1031                                   v-help-old-size = hh:width .
     1032                                   hh:width-chars = 2.5 .
     1033                               end.
     1034                           when "b-print" then
     1035                               do:
     1036                                   hh:load-image("cmp/b-print.bmp":u) .
     1037                                   hh:TOOLTIP = "Печать" .
     1038                                   v-h[ii] = hh:handle .
     1039                                   ii = ii + 1 .
     1040                                   hh:width-chars = 3 .
     1041                               end.
     1042                           when "b-history" or
     1043                           when "b-hist" then
     1044                               do:
     1045                                   hh:load-image("cmp/b-hist.bmp":u) .
     1046                                   hh:TOOLTIP = "История" .
     1047                                   v-h[ii] = hh:handle .
     1048                                   ii = ii + 1 .
     1049                                   hh:width-chars = 3 .
     1050                               end.
     1051                           when "b-sch" then
     1052                               do:
     1053                                   hh:load-image("cmp/b-sch.bmp":u) .
     1054                                   hh:TOOLTIP = "Установка Фильтра" .
     1055                                   v-h[ii] = hh:handle .
     1056                                   ii = ii + 1 .
     1057                                   hh:width-chars = 3 .
     1058                               end.
     1059                           when "b-hist-user" then
     1060                               do:
     1061                                   hh:load-image("cmp/b-hist.bmp":u) .
     1062                                   hh:TOOLTIP = "История пользователя" .
     1063                                   ii = ii + 1 .
     1064                               end.
     1065                       end case.
     1066                   end.
     1067                   hh = hh:next-sibling.
     1068               end.
     1069               b-help:column = v-frame-width - b-help:width-chars.
     1070               jj = 0.
     1071               repeat ii = 4 to 1 by -1 :
     1072                   if valid-handle (v-h[ii] ) then
     1073                   do:
     1074                       jj  = jj + 1 .
     1075                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1076                       v-h[ii]:row    = v-help-old-y .
     1077                   end.
     1078               end.
     1079           end.
     1080       end.
     1081   end procedure.
     1082   MAIN-BLOCK:
     1083   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1084      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1085   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1086     run mainmenu_getcntxt in parparentproc
     1087       (output v-cntxt-db-num
     1088       ,output v-cntxt-userid
     1089       ,output v-cntxt-level
     1090       ,output v-cntxt-host-code-obj
     1091       ,output v-cntxt-obj-type
     1092       ,output v-cntxt-obj-code
     1093       ,output v-cntxt-db-num-obj
     1094       ,output v-cntxt-is-admin
     1095       ) .
     1096     define variable v-ok as logical   no-undo .
     1097   define variable vss-include-info7 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1098   do:
     1099     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1100       (input  v-cntxt-db-num
     1101       ,input  v-cntxt-userid
     1102       ,input  0
     1103       ,input  'actn_main-barcode_preparation':U
     1104       ,input  'global':U
     1105       ,input  0
     1106       ,input  '':U
     1107       ,input  0
     1108       ,input  0
     1109       ,input  0
     1110       ,input  0
     1111       ,input  true
     1112       ,output v-ok
     1113       )  .
     1114   end.
     1115     if v-ok <> true
     1116     then do:
     1117       return.
     1118     end.
     1119     VIEW FRAME d-bc-form.
     1120     find base-bar-code no-lock where
     1121          base-bar-code.b-code = base-bc.
     1122     find ub.goods no-lock where
     1123          ub.goods.gds-code = base-bar-code.gds-code.
     1124     find ub.gds-prt no-lock where
     1125          ub.gds-prt.node-code = base-bar-code.node-code.
     1126     if action = 'ДОБАВЛЕНИЕ':U
     1127     then do:
     1128       ENABLE
     1129       ub.bar-code.unit-cli
     1130       r-units
     1131       WITH FRAME d-bc-form.
     1132       rid = ?.
     1133     end.
     1134     else do:
     1135       find ub.bar-code where recid (ub.bar-code) = rid no-error .
     1136       if not available ub.bar-code then do:
     1137         message
     1138         "Запись уже отсутствует или недоступна"
     1139         view-as alert-box warning.
     1140         return.
     1141       end.
     1142     end.
     1143     IF AVAILABLE ub.bar-code THEN
     1144       DISP
     1145       ub.bar-code.b-code
     1146       ub.bar-code.unit-cli
     1147       ub.bar-code.cli-base-rate
     1148       WITH FRAME d-bc-form.
     1149     find ub.units where
     1150          ub.units.unit-name = input frame d-bc-form ub.bar-code.unit-cli
     1151          no-lock no-error.
     1152     if available ub.units then
     1153       disp
     1154       ub.units.long-name with frame d-bc-form.
     1155     DISPLAY
     1156     ub.goods.unit-base WITH FRAME d-bc-form.
     1157     ENABLE b-exit
     1158            b-help
     1159            b-quit
     1160            ub.bar-code.cli-base-rate
     1161            WITH FRAME d-bc-form.
     1162     frame d-bc-form:title = "СОБСТВЕННЫЙ код              " + action.
     1163     WAIT-FOR GO OF FRAME d-bc-form focus bar-code.cli-base-rate.
     1164   END.
     1165   RUN disable_UI.
     1166   PROCEDURE create-bar-code :
     1167   define variable v-rid as recid no-undo .
     1168   run ref/barcode1.p (
     1169                        input action
     1170                       ,input no
     1171                       ,input (if action = 'ДОБАВЛЕНИЕ':U
     1172                               then 0
     1173                               else ub.bar-code.b-code)
     1174                       ,input ub.goods.gds-code
     1175                       ,input ub.gds-prt.node-code
     1176                       ,input base-bar-code.part-code
     1177                       ,input base-bar-code.in-code
     1178                       ,input (input frame d-bc-form ub.bar-code.unit-cli)
     1179                       ,input (input frame d-bc-form ub.bar-code.cli-base-rate)
     1180                       ,output v-rid) no-error.
     1181   if error-status :error then undo, return  error .
     1182   find first bar-code where recid(bar-code) = v-rid.
     1183   if send-ref
     1184   then do:
     1185     run str/diallog.w
     1186       (input  parparentproc
     1187       ,input  this-procedure
     1188       ,input  'str/send-bc.p':U
     1189       ,input  string(recid(ub.bar-code)) + chr(4) + 'U':U
     1190       ,input  yes
     1191       ,input  '':U
     1192       ,input  "Пересылка бар-кода на кассы"
     1193       ) .
     1194   end.
     1195   END PROCEDURE.
     1196   PROCEDURE disable_UI :
     1197     HIDE FRAME d-bc-form.
     1198   END PROCEDURE.
