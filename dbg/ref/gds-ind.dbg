        1   DEFINE BUFFER buf_goods FOR goods.
        2   DEFINE TEMP-TABLE tt-gds-obj-prop NO-UNDO LIKE gds-obj-prop.
        3   DEFINE TEMP-TABLE tt0-gds-obj-prop NO-UNDO LIKE gds-obj-prop.
        4   define input parameter parparentproc as widget-handle no-undo .
        5   define input parameter p-mode as character no-undo.
        6   define input parameter p-gds-code as integer no-undo.
        7   define input parameter p-host-code like ub.clients.obj-code no-undo.
        8   define input parameter p-obj-type like ub.clients.obj-type no-undo.
        9   define input parameter p-obj-code like ub.clients.obj-code no-undo.
       10   define input parameter p-update-instantly as logical no-undo .
       11   define output parameter p-updated AS LOGICAL no-undo.
       12   DEFINE INPUT-OUTPUT PARAMETER TABLE  FOR tt0-gds-obj-prop.
       13   def var vss-revision    as character no-undo init "$Revision$":U .
       14   def var vss-author      as character no-undo init "$Author$":U .
       15   def var vss-date        as character no-undo init "$Date$":U .
       16   def var vss-workfile    as character no-undo init "$Workfile$":U .
       17   def var vss-archive     as character no-undo init "$Archive$":U .
       18   def var vss-description as character no-undo init "Карточка редактирования индикаторов ".
       19   procedure vss-get-info :
       20     define output parameter p-vss-revision    like vss-revision    no-undo .
       21     define output parameter p-vss-author      like vss-author      no-undo .
       22     define output parameter p-vss-date        like vss-date        no-undo .
       23     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       24     define output parameter p-vss-archive     like vss-archive     no-undo .
       25     define output parameter p-vss-description like vss-description no-undo .
       26     assign
       27       p-vss-revision    = vss-revision
       28       p-vss-author      = vss-author
       29       p-vss-date        = vss-date
       30       p-vss-workfile    = vss-workfile
       31       p-vss-archive     = vss-archive
       32       p-vss-description = vss-description
       33     .
       34   end procedure.
       35   procedure vss-get-parameters :
       36     define output parameter p-vss-parameters as character no-undo .
       37   end procedure.
       38   define new global shared variable g#vssrevis-logger as handle    no-undo .
       39   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       40   define variable v-vssrevis-logger                   as handle    no-undo .
       41   procedure vss-logevent :
       42     define input  parameter p-extra-paramters as character no-undo .
       43     define variable v-vssrevis-parameters as character no-undo .
       44     do
       45     on error undo, return error return-value
       46     :
       47       if  valid-handle(v-vssrevis-logger)
       48       and v-vssrevis-logger :get-signature("logevent") <> ""
       49       then do:
       50         run vss-get-parameters in this-procedure
       51           (output v-vssrevis-parameters
       52           ).
       53         run logevent in v-vssrevis-logger
       54           (input vss-workfile
       55           ,input vss-revision
       56           ,input v-vssrevis-parameters
       57           ,input p-extra-paramters
       58           ).
       59       end.
       60     end.
       61   end procedure.
       62   assign
       63     v-vssrevis-logger = g#vssrevis-logger
       64   .
       65   if  valid-handle(v-vssrevis-logger)
       66   and v-vssrevis-logger :get-signature("logevent") <> ""
       67   then do:
       68     assign
       69       v-vssrevis-logevent = true
       70     .
       71     run vss-logevent in this-procedure (input vss-description) .
       72   end.
       73   define new global shared variable g#language as character no-undo .
       74   if g#language <> '' and g#language <> 'rus':U then do:
       75     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       76   end.
       77   define new global shared variable g#library  as handle no-undo .
       78   define new global shared variable g#library2 as handle no-undo .
       79   define   shared variable g#auto as logical no-undo.
       80   define   shared variable g#news as logical no-undo.
       81   define   shared variable g#oxml as logical no-undo.
       82   define   shared variable g#esys as logical no-undo.
       83   define   shared variable g#news-source-db as integer no-undo.
       84   define   shared variable g#esys-source-esys as integer no-undo.
       85   define   shared variable g#db-num as integer   no-undo .
       86   define   shared variable g#userid as character no-undo .
       87   define   shared variable g#passwd as character no-undo .
       88   procedure proc-alt-shift-f2:
       89     if not ibs.th.gbl.gbl-var:rcode
       90   then
       91     run gbl\inidebug.p .
       92   end.
       93   procedure proc-alt-shift-f3:
       94     run gbl/prvssinf.p
       95       ( input this-procedure
       96       ) .
       97   end.
       98   define variable v-inform-launched as logical no-undo initial false .
       99   procedure proc-alt-shift-f4:
      100     define variable v-action as character no-undo .
      101     if v-inform-launched = false then do:
      102       assign
      103         v-inform-launched = true
      104       .
      105       run gbl/d-inform.w
      106         (  input self
      107         ,  input this-procedure
      108         , output v-action
      109         ) no-error .
      110       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      111       assign
      112         v-inform-launched = false
      113       .
      114     end.
      115   end.
      116   procedure proc-alt-f1:
      117     run gbl/corrhelp.p
      118       (input this-procedure
      119       ) .
      120   end .
      121   on alt-shift-f2 anywhere do:
      122     run proc-alt-shift-f2.
      123   end.
      124   on alt-shift-f3 anywhere do:
      125     run proc-alt-shift-f3 in this-procedure .
      126   end.
      127   on alt-shift-f4 anywhere do:
      128     run proc-alt-shift-f4 in this-procedure.
      129   end.
      130   on alt-f1 anywhere do:
      131     run proc-alt-f1 in this-procedure .
      132   end.
      133   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      134   procedure cur-time :
      135      define output parameter p-today as date      no-undo .
      136      define output parameter p-time  as integer   no-undo .
      137     do
      138     on error undo, return error
      139     :
      140       define variable v-date1 as date      no-undo .
      141       define variable v-date2 as date      no-undo .
      142       define variable v-time  as integer   no-undo .
      143       assign
      144         v-date1 = today
      145         v-time  = time
      146         v-date2 = today
      147       .
      148       if v-date1 <> v-date2
      149       then do:
      150         assign
      151           v-date1 = today
      152           v-time  = v-time
      153         .
      154       end.
      155       assign
      156         p-today = v-date1
      157         p-time  = v-time
      158       .
      159     end.
      160   end.
      161   function cur-time-date returns character
      162   :
      163     return string(today, '99/99/9999':U) .
      164   end.
      165   function cur-time-mjd returns decimal
      166   :
      167     define variable v-date as date      no-undo .
      168     define variable v-time as integer   no-undo .
      169     run cur-time in this-procedure
      170       (output v-date
      171       ,output v-time
      172       ) .
      173     return integer(v-date) - 2400002 + (v-time / 86400) .
      174   end.
      175   function cur-time-get-ending-index returns integer
      176   (input p-number as integer
      177   )
      178   :
      179     if p-number < 0
      180     or p-number = ?
      181     then do:
      182       return 1 .
      183     end.
      184     define variable v-rest as integer   no-undo .
      185     assign
      186       p-number = p-number modulo 100
      187     .
      188     if p-number < 20
      189     then do:
      190       assign
      191         v-rest = p-number
      192       .
      193     end.
      194     else do:
      195       assign
      196         v-rest = p-number modulo 10
      197       .
      198     end.
      199     case v-rest :
      200       when 1
      201       then do:
      202         return 2 .
      203       end.
      204       when 2 or
      205       when 3 or
      206       when 4
      207       then do:
      208         return 3 .
      209       end.
      210       otherwise do:
      211         return 1 .
      212       end.
      213     end case .
      214   end.
      215   procedure cur-time-mjd-to-date :
      216      define input  parameter i-mjd-diff as decimal no-undo.
      217      define output parameter o-Date     as date    no-undo.
      218      define output parameter o-Time     as integer no-undo.
      219      define variable v-day-number as integer   no-undo .
      220      if    i-mjd-diff < 0
      221         or i-mjd-diff = ?
      222      then do:
      223         return "?" .
      224      end.
      225      assign
      226         v-day-number = truncate(i-mjd-diff,0).
      227         o-Date = date(v-day-number + 2400002).
      228         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      229     .
      230   end.
      231   function cur-time-mjd-to-string returns character
      232   (input p-mjd-diff as decimal
      233   )
      234   :
      235     define variable v-day-number as integer   no-undo .
      236     define variable v-seconds    as integer   no-undo .
      237     define variable v-hour       as integer   no-undo .
      238     define variable v-min        as integer   no-undo .
      239     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      240     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      241     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      242     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      243     if p-mjd-diff < 0
      244     or p-mjd-diff = ?
      245     then do:
      246       return "?" .
      247     end.
      248     assign
      249       v-day-number = integer(truncate(p-mjd-diff,0))
      250       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      251     .
      252     if v-seconds > 86400
      253     then do:
      254       assign
      255         v-seconds = 86400 - 1
      256       .
      257     end.
      258     if v-seconds < 0
      259     then do:
      260       assign
      261         v-seconds = 0
      262       .
      263     end.
      264     assign
      265       v-hour = truncate(v-seconds / 3600, 0)
      266     .
      267     assign
      268       v-seconds = v-seconds modulo 3600
      269     .
      270     assign
      271       v-min = truncate(v-seconds / 60, 0)
      272     .
      273     assign
      274       v-seconds = v-seconds modulo 60
      275     .
      276     return
      277         (if v-day-number <> 0
      278           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      279           else ""
      280         )
      281       + (if v-day-number <> 0 or v-hour <> 0
      282           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      283           else ""
      284         )
      285       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      286           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      287           else ""
      288         )
      289       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      290       .
      291   end.
      292   function cur-time-string returns character
      293   :
      294     define variable v-date as date      no-undo .
      295     define variable v-time as integer   no-undo .
      296     run cur-time in this-procedure
      297       (output v-date
      298       ,output v-time
      299       ) .
      300     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      301   end.
      302   function cur-time-string-sec returns character
      303   :
      304     define variable v-date as date      no-undo .
      305     define variable v-time as integer   no-undo .
      306     run cur-time in this-procedure
      307       (output v-date
      308       ,output v-time
      309       ) .
      310     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      311   end.
      312   function cur-time-custom  returns character
      313   (input p-prefix as character
      314   ,input p-date-format as character
      315   ,input p-delimiter as character
      316   ,input p-time-format as character
      317   ,input p-suffix as character
      318   )
      319   :
      320     define variable v-date as date      no-undo .
      321     define variable v-time as integer   no-undo .
      322     run cur-time in this-procedure
      323       (output v-date
      324       ,output v-time
      325       ) .
      326     return
      327       p-prefix
      328       + string(v-date, p-date-format)
      329       + p-delimiter
      330       + string(v-time, p-time-format)
      331       + p-suffix
      332       .
      333   end.
      334   function cur-time-print  returns character
      335   :
      336     define variable v-date as date      no-undo .
      337     define variable v-time as integer   no-undo .
      338     run cur-time in this-procedure
      339       (output v-date
      340       ,output v-time
      341       ) .
      342     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      343   end.
      344   function cur-time-datetime returns datetime
      345   :
      346     define variable v-char as character no-undo .
      347     define variable v-datetime as datetime no-undo .
      348     v-char = cur-time-string().
      349     v-datetime = datetime(v-char).
      350     return  v-datetime.
      351   end.
      352   function cur-time-string-msec returns character
      353   :
      354     define variable v-date as datetime  no-undo .
      355     v-date = now.
      356     return string(v-date) .
      357   end.
      358   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      359   procedure gds-ind1 :
      360   main-block:
      361     do
      362   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      363   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      364   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      365     :
      366   define input-output parameter p-doc-rec  as recid no-undo.
      367   define input  parameter p-gds-code                   like  ub.gds-obj-prop.gds-code no-undo.
      368   define input  parameter p-obj-type                   like  ub.gds-obj-prop.obj-type no-undo.
      369   define input  parameter p-obj-code                   like  ub.gds-obj-prop.obj-code no-undo.
      370   define input  parameter p-gdop-igt                   like  ub.gds-obj-prop.gdop-igt no-undo.
      371   define input  parameter p-gdop-assort-min            like  ub.gds-obj-prop.gdop-assort-min  no-undo.
      372   define input  parameter p-gdop-min-stock             like  ub.gds-obj-prop.gdop-min-stock   no-undo.
      373   define input  parameter p-grop-level-always-presence like  ub.gds-obj-prop.grop-level-always-presence  no-undo.
      374   define input  parameter p-grop-max-stock             like  ub.gds-obj-prop.grop-max-stock              no-undo.
      375   define input  parameter p-grop-min-order             like  ub.gds-obj-prop.grop-min-order              no-undo.
      376   define buffer bufs_gds-obj-prop for ub.gds-obj-prop.
      377   define variable v-db-num like ub.db.db-num no-undo .
      378   define variable v-db-num-obj like ub.db.db-num no-undo .
      379   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      380   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
      381     (output v-db-num
      382     )  .
      383   define variable v-date as date no-undo .
      384   define variable v-time as integer no-undo .
      385   run cur-time in this-procedure(output v-date, output v-time).
      386     find first bufs_gds-obj-prop exclusive-lock where
      387               bufs_gds-obj-prop.gds-code          = p-gds-code   and
      388               bufs_gds-obj-prop.obj-type          = p-obj-type   and
      389               bufs_gds-obj-prop.obj-code          = p-obj-code  no-error .
      390       if not available bufs_gds-obj-prop then do:
      391           create bufs_gds-obj-prop.
      392           assign
      393               bufs_gds-obj-prop.gds-code           = p-gds-code
      394               bufs_gds-obj-prop.grop-date-update   = v-date
      395               bufs_gds-obj-prop.grop-time-update   = v-time
      396               bufs_gds-obj-prop.grop-db-num-update = v-db-num
      397               bufs_gds-obj-prop.obj-type           = p-obj-type
      398               bufs_gds-obj-prop.obj-code           = p-obj-code
      399           no-error .
      400           if error-status :error then message "Ошибка при создании записи" error-status :error error-status :get-message(1) .
      401       end.
      402   if  p-gdop-igt                     <> ? then    bufs_gds-obj-prop.gdop-igt                   = p-gdop-igt.
      403   if  p-gdop-assort-min              <> ? then    bufs_gds-obj-prop.gdop-assort-min            = p-gdop-assort-min.
      404   if  p-gdop-min-stock               <> ? then    bufs_gds-obj-prop.gdop-min-stock             = p-gdop-min-stock  .
      405   if  p-grop-level-always-presence   <> ? then    bufs_gds-obj-prop.grop-level-always-presence = p-grop-level-always-presence.
      406   if  p-grop-max-stock               <> ? then    bufs_gds-obj-prop.grop-max-stock             = p-grop-max-stock           .
      407   if  p-grop-min-order               <> ? then    bufs_gds-obj-prop.grop-min-order             = p-grop-min-order           .
      408         p-doc-rec = recid(bufs_gds-obj-prop)    .
      409   end.
      410   end procedure.
      411   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
