      508             SIZE 5 BY .67
      509        SPACE(16.00) SKIP(0.57)
      510       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      511            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      512            TITLE "Индикаторы товара на объекте".
      513   ASSIGN
      514          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      515          FRAME Dialog-Frame:HIDDEN           = TRUE.
      516   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      517   DO:
      518     APPLY "END-ERROR":U TO SELF.
      519   END.
      520   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
      521   DO:
      522     run proc-save in this-procedure no-error.
      523     if error-status:error then return no-apply.
      524   END.
      525   ON CHOOSE OF B-Hist IN FRAME Dialog-Frame
      526   DO:
      527   define variable pp-rid-list as character no-undo .
      528    run ref/cgds-ind.w (
      529     input  parparentproc ,
      530     input  tt-gds-obj-prop.gds-code ,
      531     input  tt-gds-obj-prop.obj-type ,
      532     input  tt-gds-obj-prop.obj-code ,
      533     input-output pp-rid-list    ).
      534   END.
      535   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      536   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      537   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      538   on help of frame Dialog-Frame
      539   do:
      540     run gbl/app_help.p
      541       (input this-procedure :file-name
      542       ,input ''
      543       ,input ?
      544       ) no-error.
      545     if error-status :error then do:
      546       message
      547         "Ошибка при вызове помощи"
      548         error-status :get-message(1)
      549         view-as alert-box .
      550     end.
      551   end.
      552   run minbtn-set in this-procedure .
      553   on choose of b-help in frame Dialog-Frame
      554   do:
      555     apply "help":u to frame Dialog-Frame .
      556   end.
      557   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      558   procedure minbtn-set :
      559       do
      560           on error undo, return error return-value
      561           :
      562           define variable ii              as integer       no-undo .
      563           define variable fh              as widget-handle no-undo .
      564           define variable hh              as widget-handle no-undo .
      565           define variable v-h             as handle        extent 4 no-undo .
      566           define variable v-name-button   as character     no-undo .
      567           define variable v-help-old-x    as decimal       no-undo .
      568           define variable v-help-old-y    as decimal       no-undo .
      569           define variable v-help-old-size as decimal       no-undo .
      570           define variable v-frame-width   as decimal       no-undo .
      571           define variable jj              as integer       no-undo .
      572           do
      573               on error undo, return error
      574               :
      575               assign
      576                   v-frame-width = frame Dialog-Frame:width - 0.3
      577                   fh            = frame Dialog-Frame:first-child
      578                   hh            = fh:first-child
      579                   ii            = 1
      580                   .
      581               do while valid-handle(hh):
      582                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      583                   do:
      584                       case lc(hh:name) :
      585                           when "b-help" then
      586                               do:
      587                                   hh:load-image-up("cmp/b-help.bmp":u) .
      588                                   hh:load-image-down("cmp/b-help.bmp":u) .
      589                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      590                                   hh:TOOLTIP = "Помощь" .
      591                                   v-help-old-x = hh:column .
      592                                   v-help-old-y = hh:row    .
      593                                   v-help-old-size = hh:width .
      594                                   hh:width-chars = 2.5 .
      595                               end.
      596                           when "b-print" then
      597                               do:
      598                                   hh:load-image("cmp/b-print.bmp":u) .
      599                                   hh:TOOLTIP = "Печать" .
      600                                   v-h[ii] = hh:handle .
      601                                   ii = ii + 1 .
      602                                   hh:width-chars = 3 .
      603                               end.
      604                           when "b-history" or
      605                           when "b-hist" then
      606                               do:
      607                                   hh:load-image("cmp/b-hist.bmp":u) .
      608                                   hh:TOOLTIP = "История" .
      609                                   v-h[ii] = hh:handle .
      610                                   ii = ii + 1 .
      611                                   hh:width-chars = 3 .
      612                               end.
      613                           when "b-sch" then
      614                               do:
      615                                   hh:load-image("cmp/b-sch.bmp":u) .
      616                                   hh:TOOLTIP = "Установка Фильтра" .
      617                                   v-h[ii] = hh:handle .
      618                                   ii = ii + 1 .
      619                                   hh:width-chars = 3 .
      620                               end.
      621                           when "b-hist-user" then
      622                               do:
      623                                   hh:load-image("cmp/b-hist.bmp":u) .
      624                                   hh:TOOLTIP = "История пользователя" .
      625                                   ii = ii + 1 .
      626                               end.
      627                       end case.
      628                   end.
      629                   hh = hh:next-sibling.
      630               end.
      631               b-help:column = v-frame-width - b-help:width-chars.
      632               jj = 0.
      633               repeat ii = 4 to 1 by -1 :
      634                   if valid-handle (v-h[ii] ) then
      635                   do:
      636                       jj  = jj + 1 .
      637                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      638                       v-h[ii]:row    = v-help-old-y .
      639                   end.
      640               end.
      641           end.
      642       end.
      643   end procedure.
      644   MAIN-BLOCK:
      645   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      646      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      647      FRAME Dialog-Frame:title = FRAME Dialog-Frame:title + " " + p-obj-type + " " + string( p-obj-code ) .
      648     run init-proc no-error .
      649     if error-status :error then return error return-value .
      650     define variable v-user-name as character no-undo .
      651     run enable_ui.
      652     if available tt-gds-obj-prop then do:
      653   define variable vss-include-info7 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      654   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run usrfulnm in g#library
      655     (input  tt-gds-obj-prop.grop-who-update
      656     ,output v-user-name
      657     )  .
      658     end.
      659     display v-user-name @ tt-gds-obj-prop.grop-who-update with frame Dialog-Frame .
      660     if p-mode = 'ПРОСМОТР':U then do:
      661         assign
      662           b-quit:label = "&Выход"
      663           b-quit:col = 1
      664         .
      665         hide b-exit in frame Dialog-Frame.
      666     end.
      667     else do:
      668    define variable v-log as logical   no-undo .
      669   define variable vss-include-info8 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      670   do:
      671     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      672       (input  v-cntxt-db-num
      673       ,input  v-cntxt-userid
      674       ,input  0
      675       ,input  'actn_assort-izt_update':U
      676       ,input  'global':U
      677       ,input  0
      678       ,input  '':U
      679       ,input  0
      680       ,input  0
      681       ,input  0
      682       ,input  0
      683       ,input  true
      684       ,output v-log
      685       )  .
      686   end.
      687    if not v-log then return no-apply .
      688     end.
      689   find first tt-gds-obj-prop no-error .
      690   DISPLAY string(tt-gds-obj-prop.grop-time-update,"hh:mm") @ f-time WITH FRAME Dialog-Frame no-error .
      691   if error-status :error then message error-status :get-message(1) .
      692   enable
      693     b-exit when p-mode <> 'ПРОСМОТР':U
      694     b-quit
      695     b-hist when p-mode = 'ПРОСМОТР':U
      696     b-help
      697     tt-gds-obj-prop.gdop-assort-min  when p-mode <> 'ПРОСМОТР':U
      698     tt-gds-obj-prop.gdop-igt         when p-mode <> 'ПРОСМОТР':U
      699   with frame dialog-frame.
      700   view frame dialog-frame.
      701     WAIT-FOR GO OF FRAME Dialog-Frame FOCUS tt-gds-obj-prop.gdop-igt.
      702   END.
      703   run disable_ui.
      704   PROCEDURE disable_UI :
      705     HIDE FRAME Dialog-Frame.
      706   END PROCEDURE.
      707   PROCEDURE enable_UI :
      708     OPEN QUERY Dialog-Frame FOR EACH tt-gds-obj-prop NO-LOCK,       EACH buf_goods OF tt-gds-obj-prop NO-LOCK.
      709     GET FIRST Dialog-Frame.
      710     DISPLAY FILL-IN-5 FILL-IN-4 F-time
      711         WITH FRAME Dialog-Frame.
      712     IF AVAILABLE buf_goods THEN
      713       DISPLAY buf_goods.artic buf_goods.prod-type buf_goods.prod-code
      714             buf_goods.gds-code buf_goods.gds-name
      715         WITH FRAME Dialog-Frame.
      716     IF AVAILABLE tt-gds-obj-prop THEN
      717       DISPLAY tt-gds-obj-prop.gdop-igt tt-gds-obj-prop.gdop-assort-min
      718             tt-gds-obj-prop.grop-date-update tt-gds-obj-prop.grop-who-update
      719             tt-gds-obj-prop.grop-db-num-update
      720         WITH FRAME Dialog-Frame.
      721     ENABLE B-exit b-quit B-Help buf_goods.artic buf_goods.prod-type
      722            buf_goods.prod-code buf_goods.gds-code buf_goods.gds-name FILL-IN-5
      723            FILL-IN-4 tt-gds-obj-prop.grop-date-update F-time
      724            tt-gds-obj-prop.grop-who-update tt-gds-obj-prop.grop-db-num-update
      725         WITH FRAME Dialog-Frame.
      726     VIEW FRAME Dialog-Frame.
      727   END PROCEDURE.
      728   PROCEDURE init-proc :
      729   define variable v-date as date no-undo .
      730   define variable v-time as integer no-undo .
      731   if p-mode = 'ПРОСМОТР':U then
      732      find first tt0-gds-obj-prop no-lock where
      733                 tt0-gds-obj-prop.gds-code =  p-gds-code and
      734                 tt0-gds-obj-prop.obj-type =  p-obj-type and
      735                 tt0-gds-obj-prop.obj-code =  p-obj-code no-error .
      736   else
      737      find first tt0-gds-obj-prop exclusive-lock  where
      738                 tt0-gds-obj-prop.gds-code =  p-gds-code and
      739                 tt0-gds-obj-prop.obj-type =  p-obj-type and
      740                 tt0-gds-obj-prop.obj-code =  p-obj-code no-error .
      741    for each tt-gds-obj-prop : delete tt-gds-obj-prop. end.
      742     CREATE tt-gds-obj-prop.
      743     if available tt0-gds-obj-prop then
      744        BUFFER-COPY tt0-gds-obj-prop TO tt-gds-obj-prop .
      745     else do:
      746       if p-gds-code = 0 then p-gds-code = 1.
      747       run cur-time in this-procedure(output v-date, output v-time).
      748       assign
      749         tt-gds-obj-prop.gdop-assort-min    = no
      750         tt-gds-obj-prop.gdop-igt           = 'Пусто':U
      751         tt-gds-obj-prop.gds-code           = p-gds-code
      752         tt-gds-obj-prop.grop-date-update   = v-date
      753         tt-gds-obj-prop.grop-time-update   = v-time
      754         tt-gds-obj-prop.grop-db-num-update = g#db-num
      755         tt-gds-obj-prop.grop-who-update    = g#userid
      756         tt-gds-obj-prop.obj-code           = p-obj-code
      757         tt-gds-obj-prop.obj-type           = p-obj-type
      758       .
      759     end.
      760   if tt-gds-obj-prop.gdop-igt  = '' or tt-gds-obj-prop.gdop-igt  = ? then do:
      761      tt-gds-obj-prop.gdop-igt  = 'Пусто':U .
      762   end.
      763     tt-gds-obj-prop.gdop-igt:radio-buttons IN FRAME Dialog-Frame =
      764       'Новинка':U    + chr(44) +  'Новинка':U  + chr(44) +
      765       'Основная группа':U    + chr(44) +  'Основная группа':U  + chr(44) +
      766       'Нештатный':U   + chr(44) +  'Нештатный':U + chr(44) +
      767       'На вывод из ассортимента':U    + chr(44) +  'На вывод из ассортимента':U  + chr(44) +
      768       'Пусто':U  + chr(44) +  'Пусто':U .
      769   END PROCEDURE.
      770   PROCEDURE proc-save :
      771   assign frame Dialog-Frame  tt-gds-obj-prop.gdop-assort-min   no-error .
      772   if error-status :error then message error-status :get-message(1)  "gdop-assort-min" .
      773   assign frame Dialog-Frame  tt-gds-obj-prop.gdop-igt  no-error .
      774   if error-status :error then message  error-status :get-message(1) "gdop-igt " .
      775   define variable p-recid as recid no-undo.
      776   define variable v-ident as logical no-undo .
      777   if p-update-instantly then do:
      778       run gds-ind1
      779           (input-output p-recid
      780           ,tt-gds-obj-prop.gds-code
      781           ,tt-gds-obj-prop.obj-type
      782           ,tt-gds-obj-prop.obj-code
      783           ,tt-gds-obj-prop.gdop-igt
      784           ,tt-gds-obj-prop.gdop-assort-min
      785           ,tt-gds-obj-prop.gdop-min-stock
      786           ,tt-gds-obj-prop.grop-level-always-presence
      787           ,tt-gds-obj-prop.grop-max-stock
      788           ,tt-gds-obj-prop.grop-min-order
      789           ) no-error .
      790       if error-status :error then  do:
      791       message error-status :get-message(1) return-value .
      792       return error return-value .
      793       end.
      794   END.
      795   ELSE DO:
      796      if not available tt0-gds-obj-prop then
      797      create tt0-gds-obj-prop.
      798       if p-mode = 'ДОБАВЛЕНИЕ':U then do:
      799         p-updated = yes.
      800       end.
      801       else do:
      802         if available tt0-gds-obj-prop then do:
      803           buffer-compare tt0-gds-obj-prop
      804           to
      805           tt-gds-obj-prop save result in v-ident.
      806           assign
      807           p-updated = not v-ident.
      808         end.
      809         else do:
      810           if available tt-gds-obj-prop then p-updated = yes.
      811         end.
      812       end.
      813      buffer-copy tt-gds-obj-prop
      814      except gds-code
      815      to tt0-gds-obj-prop
      816      .
      817   END.
      818   END PROCEDURE.
