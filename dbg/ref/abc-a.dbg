     1753             ub.abc-analysis-gds-obj.abog-road-tax-cur   =temp-oborot1.road-tax-cur
     1754             ub.abc-analysis-gds-obj.abog-road-tax-doc   =temp-oborot1.road-tax-doc
     1755             ub.abc-analysis-gds-obj.abog-slt-acc        =temp-oborot1.slt-acc
     1756             ub.abc-analysis-gds-obj.abog-slt-cur        =temp-oborot1.slt-cur
     1757             ub.abc-analysis-gds-obj.abog-slt-doc        =temp-oborot1.slt-doc
     1758             ub.abc-analysis-gds-obj.abog-stock-qnty     =temp-oborot1.stock-qnty
     1759             ub.abc-analysis-gds-obj.abog-sum-acc        =temp-oborot1.sum-acc
     1760             ub.abc-analysis-gds-obj.abog-sum-cur        =temp-oborot1.sum-cur
     1761             ub.abc-analysis-gds-obj.abog-sum-doc        =temp-oborot1.sum-doc
     1762             ub.abc-analysis-gds-obj.abog-transport-acc  =temp-oborot1.transport-acc
     1763             ub.abc-analysis-gds-obj.abog-transport-cur   =temp-oborot1.transport-cur
     1764             ub.abc-analysis-gds-obj.abog-transport-doc   =temp-oborot1.transport-doc
     1765             ub.abc-analysis-gds-obj.abog-vat-acc     =temp-oborot1.vat-acc
     1766             ub.abc-analysis-gds-obj.abog-vat-cur     =temp-oborot1.vat-cur
     1767             ub.abc-analysis-gds-obj.abog-vat-doc     =temp-oborot1.vat-doc
     1768             ub.abc-analysis-gds-obj.abog-temp-sale-goods   = temp-oborot1.qnty / v-day
     1769           .
     1770   end.
     1771   for each temp-oborot2 ,
     1772       first temp-goods2 where
     1773             temp-goods2.gds-code = temp-oborot2.gds-code
     1774           :
     1775           create ub.abc-analysis-gds-obj.
     1776           assign
     1777             ub.abc-analysis-gds-obj.abc-id = p-id
     1778             ub.abc-analysis-gds-obj.db-num = p-db-num
     1779             ub.abc-analysis-gds-obj.gds-code     = temp-oborot2.gds-code
     1780             ub.abc-analysis-gds-obj.obj-code     = temp-oborot2.obj-code
     1781             ub.abc-analysis-gds-obj.obj-type     = temp-oborot2.obj-type
     1782             ub.abc-analysis-gds-obj.abog-other-acc      =temp-oborot2.other-acc
     1783             ub.abc-analysis-gds-obj.abog-other-cur      =temp-oborot2.other-cur
     1784             ub.abc-analysis-gds-obj.abog-other-doc      =temp-oborot2.other-doc
     1785             ub.abc-analysis-gds-obj.abog-qnty           =temp-oborot2.qnty
     1786             ub.abc-analysis-gds-obj.abog-price-crc      =temp-oborot2.price-crc
     1787             ub.abc-analysis-gds-obj.abog-reserve-day    =temp-oborot2.reserve-day
     1788             ub.abc-analysis-gds-obj.abog-road-tax-acc   =temp-oborot2.road-tax-acc
     1789             ub.abc-analysis-gds-obj.abog-road-tax-cur   =temp-oborot2.road-tax-cur
     1790             ub.abc-analysis-gds-obj.abog-road-tax-doc   =temp-oborot2.road-tax-doc
     1791             ub.abc-analysis-gds-obj.abog-slt-acc        =temp-oborot2.slt-acc
     1792             ub.abc-analysis-gds-obj.abog-slt-cur        =temp-oborot2.slt-cur
     1793             ub.abc-analysis-gds-obj.abog-slt-doc        =temp-oborot2.slt-doc
     1794             ub.abc-analysis-gds-obj.abog-stock-qnty     =temp-oborot2.stock-qnty
     1795             ub.abc-analysis-gds-obj.abog-sum-acc        =temp-oborot2.sum-acc
     1796             ub.abc-analysis-gds-obj.abog-sum-cur        =temp-oborot2.sum-cur
     1797             ub.abc-analysis-gds-obj.abog-sum-doc        =temp-oborot2.sum-doc
     1798             ub.abc-analysis-gds-obj.abog-transport-acc  =temp-oborot2.transport-acc
     1799             ub.abc-analysis-gds-obj.abog-transport-cur   =temp-oborot2.transport-cur
     1800             ub.abc-analysis-gds-obj.abog-transport-doc   =temp-oborot2.transport-doc
     1801             ub.abc-analysis-gds-obj.abog-vat-acc     =temp-oborot2.vat-acc
     1802             ub.abc-analysis-gds-obj.abog-vat-cur     =temp-oborot2.vat-cur
     1803             ub.abc-analysis-gds-obj.abog-vat-doc     =temp-oborot2.vat-doc
     1804             ub.abc-analysis-gds-obj.abog-temp-sale-goods   = temp-oborot2.qnty / v-day
     1805           .
     1806   end.
     1807   run waitfram-show in this-procedure  ("Сохранение результатов анализа по товарам в БД...").
     1808   define variable v-all-sum as decimal   no-undo .
     1809   define variable v-all-qnty as decimal   no-undo .
     1810   define variable v-a-sum  as decimal   no-undo .
     1811   define variable v-a-qnty as decimal   no-undo .
     1812   define variable v-b-sum  as decimal   no-undo .
     1813   define variable v-b-qnty as decimal   no-undo .
     1814   define variable v-c-sum  as decimal   no-undo .
     1815   define variable v-c-qnty as decimal   no-undo .
     1816   define variable v-d-sum  as decimal   no-undo .
     1817   define variable v-d-qnty as decimal   no-undo .
     1818   define variable v-e-sum  as decimal   no-undo .
     1819   define variable v-e-qnty as decimal   no-undo .
     1820   define variable v-f-sum  as decimal   no-undo .
     1821   define variable v-f-qnty as decimal   no-undo .
     1822   for each temp-goods1  :
     1823       v-all-sum  = v-all-sum  + temp-goods1.sum-crit .
     1824       v-all-qnty = v-all-qnty + 1.
     1825       case temp-goods1.crit :
     1826          when "A"
     1827          then do:
     1828               v-a-sum  = v-a-sum  + temp-goods1.sum-crit .
