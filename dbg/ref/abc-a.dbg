     1740           assign
     1741             ub.abc-analysis-gds-obj.abc-id              = p-id
     1742             ub.abc-analysis-gds-obj.db-num              = p-db-num
     1743             ub.abc-analysis-gds-obj.gds-code            = temp-oborot1.gds-code
