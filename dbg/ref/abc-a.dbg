      934        find first temp-tt where  temp-tt.id = recid(temp-goods) .
      935        temp-goods.crit = temp-tt.abc .
      936        if x-analysis.abc-type = "2"  then do:
      937          temp-goods.prcnt-account = temp-tt.proc-acc2.
      938        end.
      939        else do:
      940          temp-goods.prcnt-account = temp-tt.proc-acc1.
      941        end.
      942    end.
