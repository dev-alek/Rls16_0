      945   procedure make-tt :
      946     do
      947     on error undo, return error return-value
      948     :
      949   define buffer buf_gds-obj for ub.gds-obj.
      950   define variable v-sum-crit      as decimal   no-undo .
      951   define variable v-sum-qnty      as decimal   no-undo .
      952   define variable v-price-crc     as decimal   no-undo .
      953   define variable v-reserve-day   as decimal   no-undo .
      954   define variable v-stock-qnty    as decimal   no-undo .
      955   define variable v-sum-acc       as decimal   no-undo .
      956   define variable v-sum-cur       as decimal   no-undo .
      957   define variable v-sum-doc       as decimal   no-undo .
      958   define variable v-vat-acc       as decimal   no-undo .
      959   define variable v-vat-cur       as decimal   no-undo .
      960   define variable v-vat-doc       as decimal   no-undo .
      961   define variable v-transport-acc as decimal   no-undo .
      962   define variable v-transport-cur as decimal   no-undo .
      963   define variable v-transport-doc as decimal   no-undo .
      964   define variable v-other-acc     as decimal   no-undo .
      965   define variable v-other-cur     as decimal   no-undo .
      966   define variable v-other-doc     as decimal   no-undo .
      967   define variable v-road-tax-acc  as decimal   no-undo .
      968   define variable v-road-tax-cur  as decimal   no-undo .
      969   define variable v-road-tax-doc  as decimal   no-undo .
      970   define variable v-slt-acc       as decimal   no-undo .
      971   define variable v-slt-cur       as decimal   no-undo .
      972   define variable v-slt-doc       as decimal   no-undo .
      973   define variable v-exist         as logical   no-undo .
      974   run waitfram-show in this-procedure ("Формирование таблицы оборотов...").
      975       for each x-analysis-obj :
      976         run waitfram-show in this-procedure ("Формирование таблицы оборотов...По объекту " + x-analysis-obj.obj-type + " " + string(x-analysis-obj.obj-code)).
      977               for each buf_gds-obj no-lock where
      978                   buf_gds-obj.obj-type = x-analysis-obj.obj-type and
      979                   buf_gds-obj.obj-code = x-analysis-obj.obj-code
      980                   :
      981                   if x-analysis.r-goods = 2 then do:
      982                      if not can-find( first gds-list where buf_gds-obj.gds-code = gds-list.gds-code) then next .
      983                   end.
      984                   run def-sum in this-procedure (
      985                      input  x-analysis-obj.obj-type
      986                     ,input  x-analysis-obj.obj-code
      987                     ,input  buf_gds-obj.gds-code
      988                     ,output v-sum-crit
      989                     ,output v-sum-qnty
      990                     ,output v-price-crc
      991                     ,output v-reserve-day
      992                     ,output v-stock-qnty
      993                     ,output v-sum-acc
      994                     ,output v-sum-cur
      995                     ,output v-sum-doc
      996                     ,output v-vat-acc
      997                     ,output v-vat-cur
      998                     ,output v-vat-doc
      999                     ,output v-transport-acc
     1000                     ,output v-transport-cur
     1001                     ,output v-transport-doc
     1002                     ,output v-other-acc
     1003                     ,output v-other-cur
     1004                     ,output v-other-doc
     1005                     ,output v-road-tax-acc
     1006                     ,output v-road-tax-cur
     1007                     ,output v-road-tax-doc
     1008                     ,output v-slt-acc
     1009                     ,output v-slt-cur
     1010                     ,output v-slt-doc
     1011                     ,output v-exist
     1012                     ) .
     1013                     if v-exist  = true then do:
     1014                     find first  temp-oborot where
     1015                         temp-oborot.obj-type = buf_gds-obj.obj-type and
     1016                         temp-oborot.obj-code = buf_gds-obj.obj-code and
     1017                         temp-oborot.gds-code = buf_gds-obj.gds-code
     1018                         no-error .
     1019                         if not available temp-oborot then do:
     1020                           create temp-oborot.
     1021                         end.
     1022                         assign
     1023                             temp-oborot.obj-type      = buf_gds-obj.obj-type
     1024                             temp-oborot.obj-code      = buf_gds-obj.obj-code
     1025                             temp-oborot.gds-code      = buf_gds-obj.gds-code
     1026                             temp-oborot.sum-crit      = v-sum-crit
     1027                             temp-oborot.qnty          = v-sum-qnty
     1028                             temp-oborot.price-crc     = buf_gds-obj.price-sale
     1029                             temp-oborot.reserve-day   = v-reserve-day
     1030                             temp-oborot.stock-qnty    = buf_gds-obj.fact-qnty
     1031                             temp-oborot.sum-acc       = v-sum-acc
     1032                             temp-oborot.sum-cur       = v-sum-cur
     1033                             temp-oborot.sum-doc       = v-sum-doc
     1034                             temp-oborot.vat-acc       = v-vat-acc
     1035                             temp-oborot.vat-cur       = v-vat-cur
     1036                             temp-oborot.vat-doc       = v-vat-doc
     1037                             temp-oborot.transport-acc = v-transport-acc
     1038                             temp-oborot.transport-cur = v-transport-cur
     1039                             temp-oborot.transport-doc = v-transport-doc
     1040                             temp-oborot.other-acc     = v-other-acc
     1041                             temp-oborot.other-cur     = v-other-cur
     1042                             temp-oborot.other-doc     = v-other-doc
     1043                             temp-oborot.road-tax-acc  = v-road-tax-acc
     1044                             temp-oborot.road-tax-cur  = v-road-tax-cur
     1045                             temp-oborot.road-tax-doc  = v-road-tax-doc
     1046                             temp-oborot.slt-acc       = v-slt-acc
     1047                             temp-oborot.slt-cur       = v-slt-cur
     1048                             temp-oborot.slt-doc       = v-slt-doc
     1049                         .
     1050                       if lookup(string(x-analysis.cral-id) ,"5,6,7,9,11,13,15") = 0 then
     1051                                 temp-oborot.price-cost    = buf_gds-obj.fact-rubl .
     1052                           else temp-oborot.price-cost    = buf_gds-obj.fact-base .
     1053                         run def-order in this-procedure (
     1054                             input  buf_gds-obj.obj-type
     1055                             ,input  buf_gds-obj.obj-code
     1056                             ,input  buf_gds-obj.artic
     1057                             ,input  buf_gds-obj.prod-type
     1058                             ,input  buf_gds-obj.prod-code
     1059                             ,output temp-oborot.order-qnty  ) .
     1060                     end.
     1061           end.
     1062       end.
     1063     end.
     1064   end procedure.
     1065   procedure def-sum :
     1066   do
     1067   on error undo, return error return-value
     1068   :
     1069   define input  parameter p-obj-type as character no-undo .
     1070   define input  parameter p-obj-code as integer   no-undo .
     1071   define input  parameter p-gds-code as integer   no-undo .
     1072   define output parameter v-sum-crit       as decimal   no-undo .
     1073   define output parameter v-sum-qnty       as decimal   no-undo .
     1074   define output parameter v-price-crc      as decimal   no-undo .
     1075   define output parameter v-reserve-day    as decimal   no-undo .
     1076   define output parameter v-stock-qnty     as decimal   no-undo .
     1077   define output parameter v-sum-acc        as decimal   no-undo .
     1078   define output parameter v-sum-cur        as decimal   no-undo .
     1079   define output parameter v-sum-doc        as decimal   no-undo .
     1080   define output parameter v-vat-acc        as decimal   no-undo .
     1081   define output parameter v-vat-cur        as decimal   no-undo .
     1082   define output parameter v-vat-doc        as decimal   no-undo .
     1083   define output parameter v-transport-acc  as decimal   no-undo .
     1084   define output parameter v-transport-cur  as decimal   no-undo .
     1085   define output parameter v-transport-doc  as decimal   no-undo .
     1086   define output parameter v-other-acc      as decimal   no-undo .
     1087   define output parameter v-other-cur      as decimal   no-undo .
     1088   define output parameter v-other-doc      as decimal   no-undo .
     1089   define output parameter v-road-tax-acc   as decimal   no-undo .
     1090   define output parameter v-road-tax-cur   as decimal   no-undo .
     1091   define output parameter v-road-tax-doc   as decimal   no-undo .
     1092   define output parameter v-slt-acc        as decimal   no-undo .
     1093   define output parameter v-slt-cur        as decimal   no-undo .
     1094   define output parameter v-slt-doc        as decimal   no-undo .
     1095   define output parameter p-exist          as logical   no-undo .
     1096   define variable  p-date-1 as date   no-undo .
     1097   define variable  p-date-2 as date   no-undo .
     1098   define variable v-fact-order-1 as decimal   no-undo .
     1099   define variable v-fact-order-2 as decimal   no-undo .
     1100   define variable v-sum          as decimal   no-undo .
     1101   define buffer buf_aht-ot-line for ub.aht-ot-line.
     1102   p-exist = false .
     1103   find first x-analysis no-error .
     1104   if error-status :error then message error-status :get-message(1) "7770" view-as alert-box information .
     1105   for each tt-aht-ot-line : delete tt-aht-ot-line . end.
     1106       for each x-analysis-period :
     1107         assign
     1108           p-date-1 = x-analysis-period.abcp-start
     1109           p-date-2 = x-analysis-period.abcp-end
     1110         .
     1111         run day-begin-fact-order in this-procedure (input p-date-1 , output  v-fact-order-1).
     1112         run factord-end-day in this-procedure       (input p-date-2 , output  v-fact-order-2).
     1113         for each x-analysis-doc :
     1114           repeat i = 1 to 5 :
     1115               for each buf_aht-ot-line no-lock where
     1116                       buf_aht-ot-line.ext-doc-type = x-analysis-doc.abcd-ext-doc-type and
     1117                       buf_aht-ot-line.gds-code     = p-gds-code                       and
     1118                       buf_aht-ot-line.obj-code     = p-obj-code                       and
     1119                       buf_aht-ot-line.obj-type     = p-obj-type                       and
     1120                       buf_aht-ot-line.sum-type     = v-i[i]                           and
     1121                       buf_aht-ot-line.fact-order   >= v-fact-order-1                  and
     1122                       buf_aht-ot-line.fact-order   <= v-fact-order-2
     1123               :
     1124                   create tt-aht-ot-line.
     1125                   buffer-copy buf_aht-ot-line to tt-aht-ot-line .
     1126                   if buf_aht-ot-line.sum-type = 'b':U then do:
     1127                      tt-aht-ot-line.fact-qnty  = 0 .
     1128                   end.
     1129               end.
     1130           end.
     1131         end.
     1132       end.
     1133       define buffer buf_aht-stk-line for ub.aht-stk-line  .
     1134       repeat i = 1 to 5 :
     1135           find last buf_aht-stk-line no-lock where
     1136                           buf_aht-stk-line.gds-code     = p-gds-code and
     1137                           buf_aht-stk-line.obj-code     = p-obj-code and
     1138                           buf_aht-stk-line.obj-type     = p-obj-type and
     1139                           buf_aht-stk-line.sum-type     = v-i[i]     and
     1140                           buf_aht-stk-line.fact-order   <= v-fact-order-2  use-index category no-error .
     1141           if  available buf_aht-stk-line and buf_aht-stk-line.fact-qnty <> 0 then do:
     1142               p-exist = true  .
     1143               leave.
     1144           end.
     1145       end.
     1146   assign
     1147     v-sum-crit        = 0
     1148     v-sum-qnty        = 0
     1149     v-price-crc       = 0
     1150     v-reserve-day     = 0
     1151     v-stock-qnty      = 0
     1152     v-sum-acc         = 0
     1153     v-sum-cur         = 0
     1154     v-sum-doc         = 0
     1155     v-vat-acc         = 0
     1156     v-vat-cur         = 0
     1157     v-vat-doc         = 0
     1158     v-transport-acc   = 0
     1159     v-transport-cur   = 0
     1160     v-transport-doc   = 0
     1161     v-other-acc       = 0
     1162     v-other-cur       = 0
     1163     v-other-doc       = 0
     1164     v-road-tax-acc    = 0
     1165     v-road-tax-cur    = 0
     1166     v-road-tax-doc    = 0
     1167     v-slt-acc         = 0
     1168     v-slt-cur         = 0
     1169     v-slt-doc         = 0
     1170   .
     1171   for each tt-aht-ot-line :
     1172       p-exist = true  .
     1173       v-sum-qnty          = v-sum-qnty         + tt-aht-ot-line.fact-qnty .
     1174       if lookup(string(x-analysis.cral-id) ,"5,6,7,9,11,13,15") = 0 then
     1175       assign
     1176         v-sum-acc         = v-sum-acc         + tt-aht-ot-line.cost-sum-rubl
     1177         v-sum-cur         = v-sum-cur         + tt-aht-ot-line.crsa-sum-rubl
     1178         v-sum-doc         = v-sum-doc         + tt-aht-ot-line.sale-sum-rubl
     1179         v-vat-acc         = v-vat-acc         + tt-aht-ot-line.cost-vat-rubl
     1180         v-vat-cur         = v-vat-cur         + tt-aht-ot-line.crsa-vat-rubl
     1181         v-vat-doc         = v-vat-doc         + tt-aht-ot-line.sale-vat-rubl
     1182         v-transport-acc   = v-transport-acc   + tt-aht-ot-line.cost-transport-rubl
     1183         v-transport-cur   = v-transport-cur   + tt-aht-ot-line.crsa-transport-rubl
     1184         v-transport-doc   = v-transport-doc   + tt-aht-ot-line.sale-transport-rubl
     1185         v-other-acc       = v-other-acc       + tt-aht-ot-line.cost-other-rubl
     1186         v-other-cur       = v-other-cur       + tt-aht-ot-line.crsa-other-rubl
     1187         v-other-doc       = v-other-doc       + tt-aht-ot-line.sale-other-rubl
     1188         v-road-tax-acc    = v-road-tax-acc    + tt-aht-ot-line.cost-road-tax-rubl
     1189         v-road-tax-cur    = v-road-tax-cur    + tt-aht-ot-line.crsa-road-tax-rubl
     1190         v-road-tax-doc    = v-road-tax-doc    + tt-aht-ot-line.sale-road-tax-rubl
     1191         v-slt-acc         = v-slt-acc         + tt-aht-ot-line.cost-slt-rubl
     1192         v-slt-cur         = v-slt-cur         + tt-aht-ot-line.crsa-slt-rubl
     1193         v-slt-doc         = v-slt-doc         + tt-aht-ot-line.sale-slt-rubl
     1194       .
     1195       else
     1196       assign
     1197         v-sum-acc         = v-sum-acc         + tt-aht-ot-line.cost-sum-base
     1198         v-sum-cur         = v-sum-cur         + tt-aht-ot-line.crsa-sum-base
     1199         v-sum-doc         = v-sum-doc         + tt-aht-ot-line.sale-sum-base
     1200         v-vat-acc         = v-vat-acc         + tt-aht-ot-line.cost-vat-base
     1201         v-vat-cur         = v-vat-cur         + tt-aht-ot-line.crsa-vat-base
     1202         v-vat-doc         = v-vat-doc         + tt-aht-ot-line.sale-vat-base
     1203         v-transport-acc   = v-transport-acc   + tt-aht-ot-line.cost-transport-base
     1204         v-transport-cur   = v-transport-cur   + tt-aht-ot-line.crsa-transport-base
     1205         v-transport-doc   = v-transport-doc   + tt-aht-ot-line.sale-transport-base
     1206         v-other-acc       = v-other-acc       + tt-aht-ot-line.cost-other-base
     1207         v-other-cur       = v-other-cur       + tt-aht-ot-line.crsa-other-base
     1208         v-other-doc       = v-other-doc       + tt-aht-ot-line.sale-other-base
     1209         v-road-tax-acc    = v-road-tax-acc    + tt-aht-ot-line.cost-road-tax-base
     1210         v-road-tax-cur    = v-road-tax-cur    + tt-aht-ot-line.crsa-road-tax-base
     1211         v-road-tax-doc    = v-road-tax-doc    + tt-aht-ot-line.sale-road-tax-base
     1212         v-slt-acc         = v-slt-acc         + tt-aht-ot-line.cost-slt-base
     1213         v-slt-cur         = v-slt-cur         + tt-aht-ot-line.crsa-slt-base
     1214         v-slt-doc         = v-slt-doc         + tt-aht-ot-line.sale-slt-base
     1215       .
     1216         case x-analysis.cral-id :
     1217           when 1
     1218           then do:
     1219               run calc-qnty in this-procedure (output v-sum).
     1220           end.
     1221           when 2
     1222           then do:
     1223               run calc-str-oborot in this-procedure ( "rubl" , "cost" , "with-vat" , output v-sum).
     1224           end.
     1225           when 3
     1226           then do:
     1227               run calc-str-oborot in this-procedure  ( "rubl" , "sale" , "with-vat" , output v-sum).
     1228           end.
     1229           when 4
     1230           then do:
     1231               run calc-str-oborot in this-procedure  ( "rubl" , "crsa" , "with-vat" , output v-sum).
     1232           end.
     1233           when 5
     1234           then do:
     1235             run calc-str-oborot in this-procedure  ( "base" , "cost" , "with-vat" , output v-sum).
     1236           end.
     1237           when 6
     1238           then do:
     1239               run calc-str-oborot in this-procedure  ( "base" , "sale" , "with-vat" , output v-sum).
     1240           end.
     1241           when 7
     1242           then do:
     1243               run calc-str-oborot in this-procedure  ( "base" , "crsa" , "with-vat" , output v-sum).
     1244           end.
     1245           when 8
     1246           then do:
     1247             run calc-str-prib in this-procedure  ( "rubl" , "sale" , "cost" , "without-vat" , output v-sum).
     1248           end.
     1249           when 9
     1250           then do:
     1251               run calc-str-prib in this-procedure  ( "base" , "sale" , "cost" , "without-vat" , output v-sum).
     1252           end.
     1253           when 10
     1254           then do:
     1255                 run calc-str-prib in this-procedure  ( "rubl" , "sale" , "cost" , "with-vat" , output v-sum).
     1256           end.
     1257           when 11
     1258           then do:
     1259                 run calc-str-prib in this-procedure  ( "base" , "sale" , "cost" , "with-vat" , output v-sum).
     1260           end.
     1261           when 12
     1262           then do:
     1263                 run calc-str-prib in this-procedure  ( "rubl" , "crsa" , "cost" , "without-vat" , output v-sum).
     1264           end.
     1265           when 13
     1266           then do:
     1267                 run calc-str-prib in this-procedure  ( "base" , "crsa" , "cost" , "without-vat" , output v-sum).
     1268           end.
     1269           when 14
     1270           then do:
     1271                 run calc-str-prib in this-procedure  ( "rubl" , "crsa" , "cost" , "with-vat" , output v-sum).
     1272           end.
     1273           when 15
     1274           then do:
     1275                   run calc-str-prib in this-procedure  ( "base" , "crsa" , "cost" , "with-vat" , output v-sum).
     1276           end.
     1277         end case.
     1278        v-sum-crit = v-sum-crit + v-sum .
     1279   end.
     1280   assign
     1281     v-sum-crit      = (-1) * v-sum-crit
     1282     v-sum-qnty      = (-1) * v-sum-qnty
     1283     v-sum-acc       = (-1) * v-sum-acc
     1284     v-sum-cur       = (-1) * v-sum-cur
     1285     v-sum-doc       = (-1) * v-sum-doc
     1286     v-vat-acc       = (-1) * v-vat-acc
     1287     v-vat-cur       = (-1) * v-vat-cur
     1288     v-vat-doc       = (-1) * v-vat-doc
     1289     v-transport-acc = (-1) * v-transport-acc
     1290     v-transport-cur = (-1) * v-transport-cur
     1291     v-transport-doc = (-1) * v-transport-doc
     1292     v-other-acc     = (-1) * v-other-acc
     1293     v-other-cur     = (-1) * v-other-cur
     1294     v-other-doc     = (-1) * v-other-doc
     1295     v-road-tax-acc  = (-1) * v-road-tax-acc
     1296     v-road-tax-cur  = (-1) * v-road-tax-cur
     1297     v-road-tax-doc  = (-1) * v-road-tax-doc
     1298     v-slt-acc       = (-1) * v-slt-acc
     1299     v-slt-cur       = (-1) * v-slt-cur
     1300     v-slt-doc       = (-1) * v-slt-doc
     1301   .
     1302   end.
     1303   end procedure.
     1304   procedure calc-str-oborot :
     1305     do
     1306     on error undo, return error return-value
     1307     :
     1308   define input  parameter p-val as character no-undo .
     1309   define input  parameter p-sum-type as character no-undo .
     1310   define input  parameter p-vat as character no-undo .
     1311   define output parameter p-sum as decimal   no-undo .
     1312     case p-val :
     1313        when "rubl" then do:
     1314               case p-sum-type :
     1315                 when "crsa" then do:
     1316                       p-sum = tt-aht-ot-line.crsa-sum-rubl.
     1317                 end.
     1318                 when "cost" then do:
     1319                       p-sum = tt-aht-ot-line.cost-sum-rubl.
     1320                 end.
     1321                 when "sale" then do:
     1322                       p-sum = tt-aht-ot-line.sale-sum-rubl.
     1323                 end.
     1324               end case.
     1325        end.
     1326        when "base" then do:
     1327               case p-sum-type :
     1328                 when "crsa" then do:
     1329                       p-sum = tt-aht-ot-line.crsa-sum-base.
     1330                 end.
     1331                 when "cost" then do:
     1332                       p-sum = tt-aht-ot-line.cost-sum-base.
     1333                 end.
     1334                 when "sale" then do:
     1335                       p-sum = tt-aht-ot-line.sale-sum-base.
     1336                 end.
     1337               end case.
     1338        end.
     1339     end case.
     1340     end.
     1341   end procedure.
     1342   procedure calc-str-prib :
     1343     do
     1344     on error undo, return error return-value
     1345     :
     1346   define input  parameter p-val as character no-undo .
     1347   define input  parameter p-sum-type1 as character no-undo .
     1348   define input  parameter p-sum-type2 as character no-undo .
     1349   define input  parameter p-vat as character no-undo .
     1350   define output parameter p-sum as decimal   no-undo .
     1351         if p-vat = "with-vat" then do:
     1352           case p-val :
     1353             when "rubl" then do:
     1354                     case p-sum-type1 :
     1355                       when "crsa" then do:
     1356                             p-sum = tt-aht-ot-line.crsa-sum-rubl - tt-aht-ot-line.cost-sum-rubl.
     1357                       end.
     1358                       when "sale" then do:
     1359                             p-sum = tt-aht-ot-line.sale-sum-rubl - tt-aht-ot-line.cost-sum-rubl.
     1360                       end.
     1361                     end case.
     1362             end.
     1363             when "base" then do:
     1364                     case p-sum-type1 :
     1365                       when "crsa" then do:
     1366                             p-sum = tt-aht-ot-line.crsa-sum-base - tt-aht-ot-line.cost-sum-base.
     1367                       end.
     1368                       when "sale" then do:
     1369                             p-sum = tt-aht-ot-line.sale-sum-base - tt-aht-ot-line.cost-sum-base.
     1370                       end.
     1371                     end case.
     1372             end.
     1373           end case.
     1374         end.
     1375         else do:
     1376           case p-val :
     1377             when "rubl" then do:
     1378                     case p-sum-type1 :
     1379                       when "crsa" then do:
     1380                             p-sum = (tt-aht-ot-line.crsa-sum-rubl - tt-aht-ot-line.crsa-vat-rubl - tt-aht-ot-line.crsa-slt-rubl ) -
     1381                                     (tt-aht-ot-line.cost-sum-rubl - tt-aht-ot-line.cost-vat-rubl - tt-aht-ot-line.cost-slt-rubl ) .
     1382                       end.
     1383                       when "sale" then do:
     1384                             p-sum = ( tt-aht-ot-line.sale-sum-rubl - tt-aht-ot-line.sale-vat-rubl - tt-aht-ot-line.sale-slt-rubl ) -
     1385                                     ( tt-aht-ot-line.cost-sum-rubl - tt-aht-ot-line.cost-vat-rubl - tt-aht-ot-line.cost-slt-rubl ).
     1386                       end.
     1387                     end case.
     1388             end.
     1389             when "base" then do:
     1390                     case p-sum-type1 :
     1391                       when "crsa" then do:
     1392                             p-sum = (tt-aht-ot-line.crsa-sum-base - tt-aht-ot-line.crsa-vat-base - tt-aht-ot-line.crsa-slt-base ) -
     1393                                     (tt-aht-ot-line.cost-sum-base - tt-aht-ot-line.cost-vat-base - tt-aht-ot-line.cost-slt-base ) .
     1394                       end.
     1395                       when "sale" then do:
     1396                             p-sum = ( tt-aht-ot-line.sale-sum-base - tt-aht-ot-line.sale-vat-base - tt-aht-ot-line.sale-slt-base ) -
     1397                                     ( tt-aht-ot-line.cost-sum-base - tt-aht-ot-line.cost-vat-base - tt-aht-ot-line.cost-slt-base ).
     1398                       end.
     1399                     end case.
     1400             end.
     1401           end case.
     1402         end.
     1403     end.
     1404   end procedure.
     1405   procedure calc-qnty :
     1406   do
     1407   on error undo, return error return-value
     1408   :
     1409   define output parameter p-sum as decimal   no-undo .
     1410     p-sum = tt-aht-ot-line.fact-qnty.
     1411   end.
     1412   end procedure.
     1413   procedure ver-aht :
     1414     do
     1415     on error undo, return error return-value
     1416     :
     1417   define output parameter v-total-archive-ok as logical   no-undo  .
     1418   define variable  v-archive-ok  as logical   no-undo .
     1419   define variable  v-comment    as character no-undo .
     1420   define variable  v-can-print  as logical   no-undo .
     1421   for each x-analysis-period break by x-analysis-period.abcp-start desc :
     1422    v-date-1 = x-analysis-period.abcp-start.
     1423   end.
     1424   for each x-analysis-period break by x-analysis-period.abcp-end  :
     1425    v-date-2 = x-analysis-period.abcp-end.
     1426   end.
     1427   for each x-analysis-period break by x-analysis-period.abcp-start desc :
     1428    v-day = v-day + ( x-analysis-period.abcp-end -  x-analysis-period.abcp-start + 1) .
     1429   end.
     1430   if v-day = 0 or v-day = ? then v-day = 1.
     1431   v-total-archive-ok =  true .
     1432       for each x-analysis-obj :
     1433         run rep/chk-ahz.p
     1434           (input        x-analysis-obj.obj-type
     1435           ,input        x-analysis-obj.obj-code
     1436           ,input        false
     1437           ,input        false
     1438           ,input        false
     1439           ,input        true
     1440           ,input        true
     1441           ,input        v-cntxt-db-num
     1442           ,input        v-cntxt-userid
     1443           ,input-output v-date-1
     1444           ,input-output v-date-2
     1445           ,output       v-archive-ok
     1446           ,output       v-comment
     1447           ,output       v-can-print
     1448           ) .
     1449         if v-archive-ok = false  then
     1450         do:
     1451               if v-can-print = false
     1452               then do:
     1453                 message
     1454                   "ВНИМАНИЕ !!!" skip
     1455                   "Анализ не может быть сформирован!" skip
     1456                   "На запрошенную дату нет архивов или они сжаты" skip
     1457                   v-date-1 v-date-2 skip
     1458                   v-comment skip
     1459                   view-as alert-box information .
     1460                   return error return-value .
     1461               end.
     1462               else do:
     1463                 assign
     1464                   v-total-archive-ok = false
     1465                 .
     1466                 leave .
     1467               end.
     1468         end.
     1469       end.
     1470       if v-total-archive-ok = false
     1471       then do:
     1472         define variable v-period-description as character no-undo .
     1473           assign
     1474             v-period-description = substitute("с начала дня &1 по конец дня &2"
     1475                                              ,string(v-date-1, '99/99/9999':u)
     1476                                              ,string(v-date-2,   '99/99/9999':u)
     1477                                              )
     1478           .
     1479         message
     1480           "ВНИМАНИЕ!" skip
     1481           v-comment skip
     1482           "" skip
     1483           "Данные по выбранному периоду" v-period-description "могут быть неполными или некорректными." skip
     1484           "Продолжить формирование анализа?" skip
     1485           view-as alert-box question buttons yes-no update choice as logical  .
     1486             if choice = false
     1487             then do:
     1488               assign
     1489                 v-archive-ok = false
     1490               .
     1491               return.
     1492             end.
     1493             else do:
     1494               assign
     1495                 v-total-archive-ok = true
     1496               .
     1497             end.
     1498       end.
     1499     end.
     1500   end procedure.
     1501   procedure save-table :
     1502     do
     1503     on error undo, return error return-value
     1504     :
     1505   define buffer buf_goods for ub.goods  .
     1506   define variable ii as integer   no-undo .
     1507   run waitfram-show in this-procedure ("Сохранение результатов анализа по объектам в БД...").
     1508   for each temp-oborot ,
     1509       first temp-goods where
     1510             temp-goods.gds-code = temp-oborot.gds-code
     1511           :
     1512           create ub.abc-analysis-gds-obj.
     1513           assign
     1514             ub.abc-analysis-gds-obj.abc-id = p-id
     1515             ub.abc-analysis-gds-obj.db-num = p-db-num
     1516             ub.abc-analysis-gds-obj.gds-code     = temp-oborot.gds-code
     1517             ub.abc-analysis-gds-obj.obj-code     = temp-oborot.obj-code
     1518             ub.abc-analysis-gds-obj.obj-type     = temp-oborot.obj-type
     1519             ub.abc-analysis-gds-obj.abog-other-acc      =temp-oborot.other-acc
     1520             ub.abc-analysis-gds-obj.abog-other-cur      =temp-oborot.other-cur
     1521             ub.abc-analysis-gds-obj.abog-other-doc      =temp-oborot.other-doc
     1522             ub.abc-analysis-gds-obj.abog-qnty           =temp-oborot.qnty
     1523             ub.abc-analysis-gds-obj.abog-price-crc      =temp-oborot.price-crc
     1524             ub.abc-analysis-gds-obj.abog-reserve-day    =temp-oborot.reserve-day
     1525             ub.abc-analysis-gds-obj.abog-road-tax-acc   =temp-oborot.road-tax-acc
     1526             ub.abc-analysis-gds-obj.abog-road-tax-cur   =temp-oborot.road-tax-cur
     1527             ub.abc-analysis-gds-obj.abog-road-tax-doc   =temp-oborot.road-tax-doc
     1528             ub.abc-analysis-gds-obj.abog-slt-acc        =temp-oborot.slt-acc
     1529             ub.abc-analysis-gds-obj.abog-slt-cur        =temp-oborot.slt-cur
     1530             ub.abc-analysis-gds-obj.abog-slt-doc        =temp-oborot.slt-doc
     1531             ub.abc-analysis-gds-obj.abog-stock-qnty     =temp-oborot.stock-qnty
     1532             ub.abc-analysis-gds-obj.abog-sum-acc        =temp-oborot.sum-acc
     1533             ub.abc-analysis-gds-obj.abog-sum-cur        =temp-oborot.sum-cur
     1534             ub.abc-analysis-gds-obj.abog-sum-doc        =temp-oborot.sum-doc
     1535             ub.abc-analysis-gds-obj.abog-transport-acc  =temp-oborot.transport-acc
     1536             ub.abc-analysis-gds-obj.abog-transport-cur   =temp-oborot.transport-cur
     1537             ub.abc-analysis-gds-obj.abog-transport-doc   =temp-oborot.transport-doc
     1538             ub.abc-analysis-gds-obj.abog-vat-acc     =temp-oborot.vat-acc
     1539             ub.abc-analysis-gds-obj.abog-vat-cur     =temp-oborot.vat-cur
     1540             ub.abc-analysis-gds-obj.abog-vat-doc     =temp-oborot.vat-doc
     1541             ub.abc-analysis-gds-obj.abog-temp-sale-goods   = temp-oborot.qnty / v-day
     1542           .
     1543   end.
     1544   run waitfram-show in this-procedure ("Сохранение результатов анализа по товарам в БД...").
     1545   define variable v-all-sum as decimal   no-undo .
     1546   define variable v-all-qnty as decimal   no-undo .
     1547   define variable v-a-sum  as decimal   no-undo .
     1548   define variable v-a-qnty as decimal   no-undo .
     1549   define variable v-b-sum  as decimal   no-undo .
     1550   define variable v-b-qnty as decimal   no-undo .
     1551   define variable v-c-sum  as decimal   no-undo .
     1552   define variable v-c-qnty as decimal   no-undo .
     1553   define variable v-d-sum  as decimal   no-undo .
     1554   define variable v-d-qnty as decimal   no-undo .
     1555   define variable v-e-sum  as decimal   no-undo .
     1556   define variable v-e-qnty as decimal   no-undo .
     1557   define variable v-f-sum  as decimal   no-undo .
     1558   define variable v-f-qnty as decimal   no-undo .
     1559   for each temp-goods :
     1560       v-all-sum  = v-all-sum  + temp-goods.sum-crit .
     1561       v-all-qnty = v-all-qnty + 1.
     1562       case temp-goods.crit :
     1563          when "A"
     1564          then do:
     1565               v-a-sum  = v-a-sum  + temp-goods.sum-crit .
     1566               v-a-qnty = v-a-qnty + 1.
     1567          end.
     1568          when "B"
     1569          then do:
     1570               v-b-sum  = v-b-sum  + temp-goods.sum-crit .
     1571               v-b-qnty = v-b-qnty + 1.
     1572          end.
     1573          when "C"
     1574          then do:
     1575               v-c-sum  = v-c-sum  + temp-goods.sum-crit .
     1576               v-c-qnty = v-c-qnty + 1.
     1577          end.
     1578          when "D"
     1579          then do:
     1580               v-d-sum  = v-d-sum  + temp-goods.sum-crit .
     1581               v-d-qnty = v-d-qnty + 1.
     1582          end.
     1583          when "E"
     1584          then do:
     1585               v-e-sum  = v-e-sum  + temp-goods.sum-crit .
     1586               v-e-qnty = v-e-qnty + 1.
     1587          end.
     1588          when "F"
     1589          then do:
     1590               v-f-sum  = v-f-sum  + temp-goods.sum-crit .
     1591               v-f-qnty = v-f-qnty + 1.
     1592          end.
     1593       end case.
     1594       find first buf_goods no-lock  where  buf_goods.gds-code = temp-goods.gds-code no-error .
     1595       create ub.abc-analysis-goods.
     1596       assign
     1597         ub.abc-analysis-goods.abc-id                 = p-id
     1598         ub.abc-analysis-goods.db-num                 = p-db-num
     1599         ub.abc-analysis-goods.gds-code               = temp-goods.gds-code
     1600         ub.abc-analysis-goods.grp-code               = buf_goods.grp-code
     1601         ub.abc-analysis-goods.prod-type              = buf_goods.prod-type
     1602         ub.abc-analysis-goods.prod-code              = buf_goods.prod-code
     1603         ub.abc-analysis-goods.abcg-abc               = temp-goods.crit
     1604         ub.abc-analysis-goods.abcg-order-qnty        = temp-goods.order-qnty
     1605         ub.abc-analysis-goods.abcg-other-acc         = temp-goods.other-acc
     1606         ub.abc-analysis-goods.abcg-other-cur         = temp-goods.other-cur
     1607         ub.abc-analysis-goods.abcg-other-doc         = temp-goods.other-doc
     1608         ub.abc-analysis-goods.abcg-prcnt-for-estimate = temp-goods.crit-pr
     1609         ub.abc-analysis-goods.abcg-prcnt-account     = temp-goods.prcnt-account
     1610         ub.abc-analysis-goods.abcg-qnty              = temp-goods.qnty
     1611         ub.abc-analysis-goods.abcg-road-tax-acc      = temp-goods.road-tax-acc
     1612         ub.abc-analysis-goods.abcg-road-tax-cur      = temp-goods.road-tax-cur
     1613         ub.abc-analysis-goods.abcg-road-tax-doc      = temp-goods.road-tax-doc
     1614         ub.abc-analysis-goods.abcg-slt-acc           = temp-goods.slt-acc
     1615         ub.abc-analysis-goods.abcg-slt-cur           = temp-goods.slt-cur
     1616         ub.abc-analysis-goods.abcg-slt-doc           = temp-goods.slt-doc
     1617         ub.abc-analysis-goods.abcg-stock-qnty        = temp-goods.stock-qnty
     1618         ub.abc-analysis-goods.abcg-stock-price-acc   = temp-goods.stock-price-acc
     1619         ub.abc-analysis-goods.abcg-stock-price-sale  = temp-goods.stock-price-sale
     1620         ub.abc-analysis-goods.abcg-sum-acc           = temp-goods.sum-acc
     1621         ub.abc-analysis-goods.abcg-sum-cur           = temp-goods.sum-cur
     1622         ub.abc-analysis-goods.abcg-sum-doc           = temp-goods.sum-doc
     1623         ub.abc-analysis-goods.abcg-sum-for-estimate  = temp-goods.sum-crit
     1624         ub.abc-analysis-goods.abcg-temp-sale-goods   = temp-goods.qnty / v-day
     1625         ub.abc-analysis-goods.abcg-transport-acc     = temp-goods.transport-acc
     1626         ub.abc-analysis-goods.abcg-transport-cur     = temp-goods.transport-cur
     1627         ub.abc-analysis-goods.abcg-transport-doc     = temp-goods.transport-doc
     1628         ub.abc-analysis-goods.abcg-vat-acc           = temp-goods.vat-acc
     1629         ub.abc-analysis-goods.abcg-vat-cur           = temp-goods.vat-cur
     1630         ub.abc-analysis-goods.abcg-vat-doc           = temp-goods.vat-doc
     1631         .
     1632   end.
     1633   for each ub.abc-analysis-goods  exclusive-lock where
     1634         ub.abc-analysis-goods.abc-id  = p-id and
     1635         ub.abc-analysis-goods.db-num  = p-db-num  break
     1636           by ub.abc-analysis-goods.abcg-abc
     1637           by ub.abc-analysis-goods.abcg-prcnt-for-estimate desc :
     1638    if first-of (ub.abc-analysis-goods.abcg-abc ) then do:
     1639       ii = 0 .
     1640    end.
     1641    ii = ii + 1.
     1642    ub.abc-analysis-goods.proc-from-all =  ub.abc-analysis-goods.abcg-sum-for-estimate  * 100 / v-all-sum .
     1643    ub.abc-analysis-goods.rating = ii .
     1644   end.
     1645   find current x-analysis  no-error .
     1646   assign
     1647   x-analysis.abc-a-prc-qnty   = v-a-qnty * 100 / v-all-qnty
     1648   x-analysis.abc-a-qnty       = v-a-qnty
     1649   x-analysis.abc-a-sum-prc    = v-a-sum * 100 / v-all-sum
     1650   x-analysis.abc-a-sum        = v-a-sum
     1651   x-analysis.abc-b-prc-qnty   = v-b-qnty * 100 / v-all-qnty
     1652   x-analysis.abc-b-qnty       = v-b-qnty
     1653   x-analysis.abc-b-sum-prc    = v-b-sum * 100 / v-all-sum
     1654   x-analysis.abc-b-sum        = v-b-sum
     1655   x-analysis.abc-c-prc-qnty   = v-c-qnty * 100 / v-all-qnty
     1656   x-analysis.abc-c-qnty       = v-c-qnty
     1657   x-analysis.abc-c-sum-prc    = v-c-sum * 100 / v-all-sum
     1658   x-analysis.abc-c-sum        = v-c-sum
     1659   x-analysis.abc-d-prc-qnty   = v-d-qnty * 100 / v-all-qnty
     1660   x-analysis.abc-d-qnty       = v-d-qnty
     1661   x-analysis.abc-d-sum-prc    = v-d-sum * 100 / v-all-sum
     1662   x-analysis.abc-d-sum        = v-d-sum
     1663   x-analysis.abc-e-prc-qnty   = v-e-qnty * 100 / v-all-qnty
     1664   x-analysis.abc-e-qnty       = v-e-qnty
     1665   x-analysis.abc-e-sum-prc    = v-e-sum * 100 / v-all-sum
     1666   x-analysis.abc-e-sum        = v-e-sum
     1667   x-analysis.abc-f-prc-qnty   = v-f-qnty * 100 / v-all-qnty
     1668   x-analysis.abc-f-qnty       = v-f-qnty
     1669   x-analysis.abc-f-sum-prc    = v-f-sum * 100 / v-all-sum
     1670   x-analysis.abc-f-sum        = v-f-sum
     1671   .
     1672   define variable v-doc-rec as recid no-undo .
     1673   define buffer buf_abc-analysis for ub.abc-analysis.
     1674   find first buf_abc-analysis no-lock where
     1675               buf_abc-analysis.abc-id                 = p-id and
     1676               buf_abc-analysis.db-num                 = p-db-num no-error .
     1677    v-doc-rec = recid(buf_abc-analysis) .
     1678    run ref/abcanal1.p
     1679                 (  input-output v-doc-rec
     1680                   ,'ИЗМЕНЕНИЕ':U
     1681                   ,table x-analysis
     1682                   ,table x-analysis-doc
     1683                   ,table x-analysis-obj
     1684                   ,table x-analysis-period
     1685                   ) no-error .
     1686   if error-status :error then message
     1687   return-value
     1688   error-status :get-message(1)
     1689   222
     1690   .
     1691   run waitfram-hide in this-procedure .
     1692     end.
     1693   end procedure.
     1694   procedure def-order :
     1695     do
     1696     on error undo, return error return-value
     1697     :
     1698   define input  parameter p-obj-type  as character no-undo .
     1699   define input  parameter p-obj-code  as integer   no-undo .
     1700   define input  parameter p-artic     as char   no-undo .
     1701   define input  parameter p-prod-type as character no-undo .
     1702   define input  parameter p-prod-code as integer   no-undo .
     1703   define output parameter v-qnty       as decimal   no-undo .
     1704   define buffer buf-ord-line for ub.ord-line.
     1705   define buffer buf-ord-doc  for ub.ord-doc.
     1706         for each buf-ord-line no-lock where
     1707                 buf-ord-line.artic    =   p-artic              and
     1708                 buf-ord-line.prod-type          =   p-prod-type and
     1709                 buf-ord-line.prod-code          =   p-prod-code  ,
     1710             first buf-ord-doc no-lock where
     1711                   buf-ord-doc.doc-code          =   buf-ord-line.doc-code and
     1712                   buf-ord-doc.obj-type          =   p-obj-type and
     1713                   buf-ord-doc.obj-code          =   p-obj-code and
     1714                   buf-ord-doc.status_           <>   'факт':U    and
     1715                   buf-ord-doc.status_           <>   'новый':U  and
     1716                   buf-ord-doc.doc-date         <=  v-date-2   and
     1717                   buf-ord-doc.doc-date         >=  v-date-1
     1718                   :
     1719             for each x-analysis-period :
     1720               if buf-ord-doc.doc-date >= x-analysis-period.abcp-start and
     1721                  buf-ord-doc.doc-date <= x-analysis-period.abcp-end
     1722                   then do:
     1723                     v-qnty =  v-qnty + buf-ord-line.qnty .
     1724                   end.
     1725             end.
     1726         end.
     1727     end.
     1728   end procedure.
