     2124                     ub.abc-analysis-grp.abcg-transport-doc        =  ub.abc-analysis-grp.abcg-transport-doc       + buf_abc-analysis-goods.abcg-transport-doc
     2125                     ub.abc-analysis-grp.abcg-vat-acc              =  ub.abc-analysis-grp.abcg-vat-acc             + buf_abc-analysis-goods.abcg-vat-acc
     2126                     ub.abc-analysis-grp.abcg-vat-cur              =  ub.abc-analysis-grp.abcg-vat-cur             + buf_abc-analysis-goods.abcg-vat-cur
     2127                     ub.abc-analysis-grp.abcg-vat-doc              =  ub.abc-analysis-grp.abcg-vat-doc             + buf_abc-analysis-goods.abcg-vat-doc
     2128                     .
     2129     end.
     2130   for each temp-goods :
     2131       v-all-sum  = v-all-sum  + temp-goods.sum-crit .
     2132   end.
     2133   define variable ii as integer   no-undo .
     2134    for each temp-tt : delete temp-tt . end.
     2135    for each ub.abc-analysis-grp  no-lock where
     2136         ub.abc-analysis-grp.abc-id  = p-id and
     2137         ub.abc-analysis-grp.db-num  = p-db-num :
     2138        create temp-tt.
     2139        assign
     2140          temp-tt.id = recid(ub.abc-analysis-grp)
     2141          temp-tt.summa = ub.abc-analysis-grp.abcg-sum-for-estimate
     2142        .
     2143    end.
     2144    run ref/tt-abc.p
     2145         ( input table x-analysis
     2146         , input-output table temp-tt )
     2147     .
     2148   for each temp-tt  break
     2149           by temp-tt.abc
     2150           by temp-tt.proc desc :
     2151         if first-of (temp-tt.abc ) then do:
     2152             ii = 0 .
     2153         end.
     2154         ii = ii + 1.
     2155         find first ub.abc-analysis-grp  exclusive-lock where  recid (ub.abc-analysis-grp) = temp-tt.id no-error .
     2156             if available ub.abc-analysis-grp then do:
     2157                 ub.abc-analysis-grp.abcg-abc      =  temp-tt.abc.
     2158                 ub.abc-analysis-grp.proc-from-all =  ub.abc-analysis-grp.abcg-sum-for-estimate  * 100 / v-all-sum .
     2159                 ub.abc-analysis-grp.rating        = ii .
     2160             end.
     2161   end.
     2162    for each temp-tt : delete temp-tt . end.
     2163    for each ub.abc-analysis-prod  no-lock where
     2164         ub.abc-analysis-prod.abc-id  = p-id and
     2165         ub.abc-analysis-prod.db-num  = p-db-num :
     2166        create temp-tt.
     2167        assign
     2168          temp-tt.id = recid(ub.abc-analysis-prod)
     2169          temp-tt.summa = ub.abc-analysis-prod.abcg-sum-for-estimate
     2170        .
     2171    end.
     2172    run ref/tt-abc.p
     2173         ( input table x-analysis
     2174         , input-output table temp-tt )
     2175     .
     2176   for each temp-tt  break
     2177           by temp-tt.abc
     2178           by temp-tt.proc desc :
     2179         if first-of (temp-tt.abc ) then do:
     2180             ii = 0 .
     2181         end.
     2182         ii = ii + 1.
     2183         find first ub.abc-analysis-prod  exclusive-lock where  recid (ub.abc-analysis-prod) = temp-tt.id no-error .
     2184             if available ub.abc-analysis-prod then do:
     2185                 ub.abc-analysis-prod.abcg-abc      =  temp-tt.abc.
     2186                 ub.abc-analysis-prod.proc-from-all =  ub.abc-analysis-prod.abcg-sum-for-estimate  * 100 / v-all-sum .
     2187                 ub.abc-analysis-prod.rating        = ii .
     2188             end.
     2189   end.
     2190     run waitfram-hide in this-procedure .
     2191     end.
     2192   end procedure.
