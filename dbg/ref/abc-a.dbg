        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        3   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        4   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile: abc-a.p $":U .
        6   define variable vss-archive     as character no-undo init "$Archive: ref/abc-a.p $":U .
        7   define variable vss-description as character no-undo init "Формирование таблицы с оборотами и прибылями для ABC XYZ анализов".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   define new global shared variable g#library  as handle no-undo .
       67   define new global shared variable g#library2 as handle no-undo .
       68   define   shared variable g#auto as logical no-undo.
       69   define   shared variable g#news as logical no-undo.
       70   define   shared variable g#oxml as logical no-undo.
       71   define   shared variable g#esys as logical no-undo.
       72   define   shared variable g#news-source-db as integer no-undo.
       73   define   shared variable g#esys-source-esys as integer no-undo.
       74   define   shared variable g#db-num as integer   no-undo .
       75   define   shared variable g#userid as character no-undo .
       76   define   shared variable g#passwd as character no-undo .
       77   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       78   procedure factord :
       79     define input  parameter p-fact-date            as date    no-undo .
       80     define input  parameter p-fact-time            as integer no-undo .
       81     define input  parameter p-fact-num             as integer no-undo .
       82     define input  parameter p-shift-date           as date    no-undo .
       83     define input  parameter p-shift-num            as integer no-undo .
       84     define input  parameter p-shift-on             as logical no-undo .
       85     define output parameter p-fact-order           as decimal no-undo .
       86     define output parameter p-shift-end-fact-order as decimal no-undo .
       87     define output parameter p-day-end-fact-order   as decimal no-undo .
       88     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
       89     if p-fact-date = ?
       90     then do:
       91       return error "Не указана фактическая дата" .
       92     end.
       93     define variable v-fact-date-num as integer no-undo .
       94     assign
       95       v-fact-date-num = integer(p-fact-date)
       96     .
       97     if p-fact-num = ?
       98     or p-fact-num = 0
       99     then do:
      100       return error "Не задан p-fact-num " + string(p-fact-num) .
      101     end.
      102     if p-fact-num < 0
      103     then do:
      104       return error "Отрицательный fact-num " + string(p-fact-num) .
      105     end.
      106     if p-fact-num >= 100000000
      107     then do:
      108       return error "Недопустимо большой fact-num " + string(p-fact-num) .
      109     end.
      110     if p-shift-on = true
      111     then do:
      112       if p-shift-date = ?
      113       then do:
      114         return error "Не задана дата смены" .
      115       end.
      116       if p-shift-num = ?
      117       or p-shift-num = 0
      118       then do:
      119         return error "Не задан номер смены" .
      120       end.
      121     end.
      122     else do:
      123       assign
      124         p-shift-date = p-fact-date
      125         p-shift-num  = 24
      126       .
      127     end.
      128     define variable v-shift-offset as integer no-undo .
      129     if p-shift-date = p-fact-date
      130     then do:
      131       assign
      132         v-shift-offset = 1
      133       .
      134     end.
      135     if p-shift-date < p-fact-date
      136     then do:
      137       assign
      138         v-shift-offset = 0
      139       .
      140     end.
      141     if p-shift-date > p-fact-date
      142     then do:
      143       message
      144         vss-workfile vss-revision vss-description skip
      145         "Неправильная дата закрытия смены" skip
      146         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
      147         view-as alert-box error .
      148       undo, return error
      149         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
      150           ,string(p-fact-date, '99/99/9999':U)
      151           ,string(p-shift-date, '99/99/9999':U)
      152           )
      153       .
      154     end.
      155     if p-shift-num < 1
      156     or p-shift-num > 24
      157     then do:
      158       message
      159         vss-workfile vss-revision vss-description skip
      160         "Неправильный номер смены" skip
      161         "p-shift-num" p-shift-num skip
      162         view-as alert-box error .
      163       undo, return error return-value .
      164     end.
      165     assign
      166       p-fact-order           = v-fact-date-num
      167                              + v-shift-offset * 0.5
      168                              + p-shift-num    * 0.02 - 0.01
      169                              + p-fact-num     * 0.0000000001
      170       p-shift-end-fact-order = v-fact-date-num
      171                              + v-shift-offset * 0.5
      172                              + p-shift-num    * 0.02
      173       p-day-end-fact-order   = v-fact-date-num
      174                              + 0.99
      175     .
      176     if p-fact-order           <= v-fact-date-num
      177     or p-shift-end-fact-order <= v-fact-date-num
      178     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
      179     or p-shift-end-fact-order >= p-day-end-fact-order
      180     then do:
      181       message
      182         vss-workfile vss-revision vss-description skip
      183         "Внутренняя ошибка при генерации фактического номера" skip
      184         "p-fact-date"            p-fact-date            skip
      185         "p-fact-time"            p-fact-time            skip
      186         "p-fact-num"             p-fact-num             skip
      187         "p-shift-date"           p-shift-date           skip
      188         "p-shift-num"            p-shift-num            skip
      189         "p-shift-on"             p-shift-on             skip
      190         "p-shift-end-fact-order" p-shift-end-fact-order skip
      191         "p-day-end-fact-order"   p-day-end-fact-order   skip
      192         "v-fact-date-num"        v-fact-date-num        skip
      193         view-as alert-box error .
      194       undo, return error return-value .
      195     end.
      196   end procedure.
      197   procedure day-begin-fact-order :
      198     define input  parameter p-fact-date            as date    no-undo .
      199     define output parameter p-day-begin-fact-order as decimal no-undo .
      200     do
      201     on error undo, return error return-value
      202     :
      203       if p-fact-date = ?
      204       then do:
      205         assign
      206           p-day-begin-fact-order = 0
      207         .
      208       end.
      209       else do:
      210         assign
      211           p-day-begin-fact-order = integer(p-fact-date)
      212         .
      213       end.
      214     end.
      215   end procedure.
      216   procedure factord-max-fact-order :
      217     define output parameter p-max-fact-order as decimal   no-undo .
      218     do
      219     on error undo, return error return-value
      220     :
      221       run day-begin-fact-order in this-procedure
      222         (input  date(1, 1, 5000)
      223         ,output p-max-fact-order
      224         ) .
      225     end.
      226   end procedure.
      227   procedure factord-cut-archive :
      228     define input  parameter p-obj-type             as character no-undo .
      229     define input  parameter p-obj-code             as integer   no-undo .
      230     define input  parameter p-fact-date            as date      no-undo .
      231     define output parameter p-shift-on             as logical   no-undo .
      232     define output parameter p-shift-date           as date      no-undo .
      233     define output parameter p-shift-num            as integer   no-undo .
      234     define output parameter p-day-end-fact-order   as decimal   no-undo .
      235     define output parameter p-shift-end-fact-order as decimal   no-undo .
      236     define variable v-fact-order as decimal   no-undo .
      237     define buffer buf_shift-obj for ub.shift-obj .
      238     do
      239     on error undo, return error return-value
      240     :
      241   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      242   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      243     (input  p-obj-type
      244     ,input  p-obj-code
      245     ,input  'shift-on=request'
      246     ,output p-shift-on
      247     ) no-error .
      248       if error-status :error
      249       then do:
      250         message
      251           vss-workfile vss-revision vss-description skip
      252           "Ошибка при определении атрибута объекта" skip
      253           "Объект" p-obj-type p-obj-code skip
      254           error-status :get-message(1) skip
      255           return-value skip
      256           view-as alert-box error .
      257         undo, return error return-value .
      258       end.
      259       if p-shift-on = false
      260       then do:
      261         assign
      262           p-shift-date               = ?
      263           p-shift-num                = 0
      264         .
      265       end.
      266       else do:
      267         find first buf_shift-obj share-lock
      268           where buf_shift-obj.obj-type   = p-obj-type
      269             and buf_shift-obj.obj-code   = p-obj-code
      270             and buf_shift-obj.shift-date > p-fact-date
      271           use-index pi
      272           no-error .
      273         if not available buf_shift-obj
      274         or buf_shift-obj.status_ <> 'зкр':U
      275         then do:
      276           message
      277             vss-workfile vss-revision vss-description skip
      278             "Невозможно вычислить последнюю смену" skip
      279             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
      280             "Объект" p-obj-type p-obj-code skip
      281             "Дата" p-fact-date skip
      282             view-as alert-box error .
      283           undo, return error return-value .
      284         end.
      285         find last buf_shift-obj share-lock
      286           where buf_shift-obj.obj-type = p-obj-type
      287             and buf_shift-obj.obj-code = p-obj-code
      288             and buf_shift-obj.shift-date <= p-fact-date
      289           use-index pi
      290           no-error .
      291         if available buf_shift-obj
      292         then do:
      293           if  buf_shift-obj.status_ = 'зкр':U
      294           then do:
      295             assign
      296               p-shift-date = buf_shift-obj.shift-date
      297               p-shift-num  = buf_shift-obj.shift-num
      298             .
      299           end.
      300           else do:
      301             message
      302               vss-workfile vss-revision vss-description skip
      303               "Невозможно вычислить последнюю смену" skip
      304               "Статус смены отличен от статуса" 'зкр':U skip
      305               "Объект" p-obj-type p-obj-code skip
      306               "Дата" p-fact-date skip
      307               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
      308               view-as alert-box error .
      309             undo, return error return-value .
      310           end.
      311         end.
      312         else do:
      313           assign
      314             p-shift-date = p-fact-date - 1
      315             p-shift-num  = 1
      316           .
      317         end.
      318       end.
      319       run factord in this-procedure
      320         (input  p-fact-date
      321         ,input  1
      322         ,input  1
      323         ,input  p-shift-date
      324         ,input  p-shift-num
      325         ,input  p-shift-on
      326         ,output v-fact-order
      327         ,output p-shift-end-fact-order
      328         ,output p-day-end-fact-order
      329         ) no-error .
      330       if error-status :error
      331       then do:
      332         message
      333           vss-workfile vss-revision vss-description skip
      334           "Ошибка при вызове процедуры factord"
      335           error-status :get-message(1) skip
      336           return-value skip
      337           view-as alert-box error .
      338         undo, return error return-value .
      339       end.
      340     end.
      341   end procedure.
      342   procedure factord-lock-shift :
      343     define input  parameter p-obj-type  as character no-undo .
      344     define input  parameter p-obj-code  as integer   no-undo .
      345     define input  parameter p-fact-date as date      no-undo .
      346     define parameter buffer buf_shift-obj for ub.shift-obj .
      347     define variable v-shift-on      as logical   no-undo .
      348     define variable v-extra-message as character no-undo .
      349     define variable v-error as character no-undo .
      350     do
      351     on error undo, return error return-value
      352     :
      353   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      354   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      355     (input  p-obj-type
      356     ,input  p-obj-code
      357     ,input  'shift-on=request'
      358     ,output v-shift-on
      359     ) no-error .
      360       if error-status :error
      361       then do:
      362         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
      363         undo, return error v-error .
      364       end.
      365       if v-shift-on = true
      366       then do:
      367         find first buf_shift-obj share-lock
      368           where buf_shift-obj.obj-type   = p-obj-type
      369             and buf_shift-obj.obj-code   = p-obj-code
      370             and buf_shift-obj.shift-date > p-fact-date
      371           use-index pi
      372           no-error .
      373         if not available buf_shift-obj
      374         or buf_shift-obj.status_ <> 'зкр':U
      375         then do:
      376           find last buf_shift-obj
      377             where buf_shift-obj.obj-type = p-obj-type
      378               and buf_shift-obj.obj-code = p-obj-code
      379               and buf_shift-obj.status_  = 'зкр':U
      380             use-index stts
      381             no-error .
      382           if available buf_shift-obj
      383           then do:
      384             assign
      385               v-extra-message =
      386                     substitute("Дата начала последеней закрытой смены на объекте &1"
      387                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
      388                               )
      389             .
      390           end.
      391           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
      392           undo, return error v-error .
      393         end.
      394       end.
      395     end.
      396   end procedure.
      397   procedure factord-end-day :
      398     define input  parameter p-fact-date            as date    no-undo .
      399     define output parameter p-day-end-fact-order   as decimal no-undo .
      400     do
      401     on error undo, return error return-value
      402     :
      403       if p-fact-date = ?
      404       then do:
      405         return error "Не указана фактическая дата" .
      406       end.
      407       assign
      408         p-day-end-fact-order = integer(p-fact-date) + 0.99
      409       .
      410     end.
      411   end procedure.
      412   procedure factord-to-date :
      413     define input  parameter p-fact-order as decimal no-undo .
      414     define output parameter p-fact-date  as date    no-undo .
      415     define variable v-ref-date  as date      no-undo .
      416     define variable v-ref-delta as integer   no-undo .
      417     do
      418     on error undo, return error return-value
      419     :
      420       if p-fact-order = ?
      421       or p-fact-order = 0
      422       then do:
      423         return error "Не указан fact-order" .
      424       end.
      425       assign
      426         v-ref-date  = date(1, 1, 2000)
      427       .
      428       assign
      429         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
      430       .
      431       assign
      432         p-fact-date = v-ref-date + v-ref-delta
      433       .
      434     end.
      435   end procedure.
      436   procedure factord-to-fact-num :
      437     define input  parameter p-fact-order as decimal no-undo .
      438     define output parameter p-fact-num   as integer no-undo .
      439     define variable v-fact-order-trunc as decimal no-undo .
      440     do
      441     on error undo, return error return-value
      442     :
      443       if p-fact-order = ?
      444       or p-fact-order = 0
      445       then do:
      446         return error "Не указан fact-order" .
      447       end.
      448       assign
      449        v-fact-order-trunc = truncate(p-fact-order, 2)
      450       .
      451       assign
      452         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
      453       .
      454     end.
      455   end procedure.
      456   procedure factord-to-shift-num :
      457     define input  parameter p-fact-order as decimal no-undo .
      458     define output parameter p-shift-num   as integer no-undo .
      459     define variable  p-shift-numd  as decimal   no-undo .
      460     define variable v-fact-order-trunc as decimal no-undo .
      461     do
      462     on error undo, return error return-value
      463     :
      464       if p-fact-order = ?
      465       or p-fact-order = 0
      466       then do:
      467         return error "Не указан fact-order" .
      468       end.
      469       assign
      470        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
      471       .
      472       if v-fact-order-trunc < 0.5 then do:
      473         v-fact-order-trunc = v-fact-order-trunc + 0.5.
      474       end.
      475       assign
      476         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
      477         .
      478        assign
      479         p-shift-num = truncate (p-shift-numd , 0)
      480       .
      481     end.
      482   end procedure.
      483   define temp-table temp-oborot no-undo
      484   field gds-code       as integer
      485   field obj-type       as char
      486   field obj-code       as integer
      487   field sum-crit       as decimal
      488   field qnty           as decimal
      489   field price-crc      as decimal
      490   field price-cost     as decimal
      491   field reserve-day    as integer
      492   field stock-qnty     as decimal
      493   field sum-acc        as decimal
      494   field sum-cur        as decimal
      495   field sum-doc        as decimal
      496   field vat-acc        as decimal
      497   field vat-cur        as decimal
      498   field vat-doc        as decimal
      499   field transport-acc  as decimal
      500   field transport-cur  as decimal
      501   field transport-doc  as decimal
      502   field other-acc      as decimal
      503   field other-cur      as decimal
      504   field other-doc      as decimal
      505   field road-tax-acc   as decimal
      506   field road-tax-cur   as decimal
      507   field road-tax-doc   as decimal
      508   field slt-acc        as decimal
      509   field slt-cur        as decimal
      510   field slt-doc        as decimal
      511   field order-qnty     as decimal
      512   field temp-sale-goods  as decimal
      513   index pi as unique primary  gds-code obj-type obj-code
      514   .
      515   define temp-table temp-goods no-undo
      516   field gds-code       as integer
      517   field sum-crit       as decimal
      518   field crit-pr        as decimal
      519   field crit           as char
      520   field kol-period     as int
      521   field average-qnty   as decimal
      522   field sigma          as decimal
      523   field K_V            as decimal
      524   field qnty           as decimal
      525   field price-crc      as decimal
      526   field reserve-day    as integer
      527   field sum-acc        as decimal
      528   field sum-cur        as decimal
      529   field sum-doc        as decimal
      530   field vat-acc        as decimal
      531   field vat-cur        as decimal
      532   field vat-doc        as decimal
      533   field transport-acc  as decimal
      534   field transport-cur  as decimal
      535   field transport-doc  as decimal
