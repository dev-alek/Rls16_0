      398       define variable v-yesno    as logical      no-undo.
      399       message
      400           "Удаление акта проработки."
      401           skip (1)
      402           skip "Номер рецепта:  " p-recipe-code
      403           skip "Номер документа:" browse browse-1 temp_recipe-develop.doc-code
      404           skip "Дата документа: " browse browse-1 temp_recipe-develop.doc-date
      405           skip (1)
