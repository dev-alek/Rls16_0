      175   FUNCTION get-column-value RETURNS CHARACTER
      176     ( input p-column-num as integer, input p-gds-code as integer )  FORWARD.
      177   DEFINE BUTTON b-add
      178        LABEL "Добавить"
      179        SIZE 10 BY 1.
      180   DEFINE BUTTON b-chg
      181        LABEL "Изменить"
      182        SIZE 10 BY 1.
      183   DEFINE BUTTON b-chg-line
      184        LABEL "Изменить"
      185        SIZE 10 BY 1.
      186   DEFINE BUTTON b-del
      187        LABEL "Удалить"
      188        SIZE 10 BY 1.
      189   DEFINE BUTTON b-exit AUTO-GO
      190        LABEL "В&ыход"
      191        SIZE 10 BY 1
      192        BGCOLOR 8 .
      193   DEFINE BUTTON b-gds
      194        LABEL "&Товары"
      195        SIZE 10 BY 1.
      196   DEFINE BUTTON b-help
      197        LABEL "Помощ&ь"
      198        SIZE 10 BY 1
      199        BGCOLOR 8 .
      200   DEFINE QUERY BROWSE-1 FOR
      201         temp_recipe-develop SCROLLING.
      202   DEFINE QUERY BROWSE-2 FOR
      203         recipe-develop SCROLLING.
      204   DEFINE BROWSE BROWSE-1
      205     QUERY BROWSE-1 NO-LOCK DISPLAY
      206         temp_recipe-develop.doc-code format "X(25)" column-label "Номер"
      207         temp_recipe-develop.doc-date format "99.99.9999" column-label "Дата"
      208       WITH NO-ROW-MARKERS SEPARATORS SIZE 84.5 BY 7.25 ROW-HEIGHT-CHARS .58 EXPANDABLE.
      209   DEFINE BROWSE BROWSE-2
      210     QUERY BROWSE-2 NO-LOCK DISPLAY
      211         get-column-value( input 1, input recipe-develop.gds-code ) COLUMN-LABEL "Артикул" FORMAT "X(17)":U
      212               WIDTH 18
      213         get-column-value( input 2, input recipe-develop.gds-code ) COLUMN-LABEL "Наименование товара" FORMAT "X(30)":U
      214         recipe-develop.qnty COLUMN-LABEL "Нетто" FORMAT "->>,>>>,>>9.<<<":U
      215               WIDTH 16
      216         recipe-develop.brutto-qnty FORMAT "->>,>>>,>>9.<<<":U WIDTH 16
      217       WITH NO-ROW-MARKERS SEPARATORS SIZE 84.5 BY 10.25 EXPANDABLE.
      218   DEFINE FRAME Dialog-Frame
      219        b-exit AT ROW 1.25 COL 2
      220        b-add AT ROW 1.25 COL 26.5
      221        b-chg AT ROW 1.25 COL 36.5
      222        b-del AT ROW 1.25 COL 46.5
      223        b-help AT ROW 1.25 COL 76
      224        BROWSE-1 AT ROW 2.5 COL 2
      225        b-chg-line AT ROW 10 COL 26.5
      226        b-gds AT ROW 10 COL 36.5
      227        BROWSE-2 AT ROW 11.25 COL 2
      228        SPACE(1.24) SKIP(0.20)
      229       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      230            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      231            TITLE "Акты проработки"
      232            DEFAULT-BUTTON b-exit.
      233   ASSIGN
      234          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      235          FRAME Dialog-Frame:HIDDEN           = TRUE.
      236   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      237   DO:
      238     APPLY "END-ERROR":U TO SELF.
      239   END.
      240   ON CHOOSE OF b-add IN FRAME Dialog-Frame
      241   DO:
      242   define variable vss-include-info3 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      243   if lookup(self :type
      244            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      245            ) = 0
      246   then do:
      247     message
      248       "$Workfile$"
      249       "Указанному интерфейсному элементу фокус не может быть передан" skip
      250       "Интерфейсный элемент" self :name  skip
      251       "Тип" self :type  skip
      252       "Процедура" this-procedure :file-name skip
      253       view-as alert-box .
      254   end.
      255   else do:
      256     apply "entry":u to self  .
      257     if focus :handle <> self :handle  then do:
      258       return no-apply .
      259     end.
      260   end.
      261       define variable v-ok    as logical      no-undo.
      262       run add-akt in this-procedure (
      263             input p-recipe-code
      264           , output v-ok
      265       ) no-error.
      266       if error-status :error
      267       then do:
      268           message
      269                    vss-workfile vss-revision vss-description
      270               skip "Ошибка добавления акта проработки."
      271               skip return-value
      272               skip trim(error-status :get-message(1))
      273                    trim(error-status :get-message(2))
      274                    trim(error-status :get-message(3))
      275           view-as alert-box error.
      276           undo, return no-apply .
      277       end.
      278       if v-ok = yes
      279       then do:
      280           run init-fields in this-procedure.
      281           OPEN QUERY BROWSE-1 FOR EACH temp_recipe-develop NO-LOCK INDEXED-REPOSITION.    OPEN QUERY BROWSE-2 FOR EACH recipe-develop       WHERE recipe-develop.recipe-code = p-recipe-code  AND recipe-develop.doc-code = temp_recipe-develop.doc-code NO-LOCK INDEXED-REPOSITION.
      282       end.
      283   END.
