      504   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      505   procedure minbtn-set :
      506       do
      507           on error undo, return error return-value
      508           :
      509           define variable ii              as integer       no-undo .
      510           define variable fh              as widget-handle no-undo .
      511           define variable hh              as widget-handle no-undo .
      512           define variable v-h             as handle        extent 4 no-undo .
      513           define variable v-name-button   as character     no-undo .
      514           define variable v-help-old-x    as decimal       no-undo .
      515           define variable v-help-old-y    as decimal       no-undo .
      516           define variable v-help-old-size as decimal       no-undo .
      517           define variable v-frame-width   as decimal       no-undo .
      518           define variable jj              as integer       no-undo .
      519           do
      520               on error undo, return error
      521               :
      522               assign
      523                   v-frame-width = frame Dialog-Frame:width - 0.3
      524                   fh            = frame Dialog-Frame:first-child
      525                   hh            = fh:first-child
      526                   ii            = 1
      527                   .
      528               do while valid-handle(hh):
      529                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      530                   do:
      531                       case lc(hh:name) :
      532                           when "b-help" then
      533                               do:
      534                                   hh:load-image-up("cmp/b-help.bmp":u) .
      535                                   hh:load-image-down("cmp/b-help.bmp":u) .
      536                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      537                                   hh:TOOLTIP = "Помощь" .
      538                                   v-help-old-x = hh:column .
      539                                   v-help-old-y = hh:row    .
      540                                   v-help-old-size = hh:width .
      541                                   hh:width-chars = 2.5 .
      542                               end.
      543                           when "b-print" then
      544                               do:
      545                                   hh:load-image("cmp/b-print.bmp":u) .
      546                                   hh:TOOLTIP = "Печать" .
      547                                   v-h[ii] = hh:handle .
      548                                   ii = ii + 1 .
      549                                   hh:width-chars = 3 .
      550                               end.
      551                           when "b-history" or
      552                           when "b-hist" then
      553                               do:
      554                                   hh:load-image("cmp/b-hist.bmp":u) .
      555                                   hh:TOOLTIP = "История" .
      556                                   v-h[ii] = hh:handle .
      557                                   ii = ii + 1 .
      558                                   hh:width-chars = 3 .
      559                               end.
      560                           when "b-sch" then
      561                               do:
      562                                   hh:load-image("cmp/b-sch.bmp":u) .
      563                                   hh:TOOLTIP = "Установка Фильтра" .
      564                                   v-h[ii] = hh:handle .
      565                                   ii = ii + 1 .
      566                                   hh:width-chars = 3 .
      567                               end.
      568                           when "b-hist-user" then
      569                               do:
      570                                   hh:load-image("cmp/b-hist.bmp":u) .
      571                                   hh:TOOLTIP = "История пользователя" .
      572                                   ii = ii + 1 .
      573                               end.
      574                       end case.
      575                   end.
      576                   hh = hh:next-sibling.
      577               end.
      578               b-help:column = v-frame-width - b-help:width-chars.
      579               jj = 0.
      580               repeat ii = 4 to 1 by -1 :
      581                   if valid-handle (v-h[ii] ) then
      582                   do:
      583                       jj  = jj + 1 .
      584                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      585                       v-h[ii]:row    = v-help-old-y .
      586                   end.
      587               end.
      588           end.
      589       end.
      590   end procedure.
      591   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      592   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      593   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      594   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      595   define variable v-diasize-current-frame-width  as decimal   no-undo .
      596   define variable v-diasize-current-frame-height as decimal   no-undo .
      597   define variable v-diasize-change-size          as logical   no-undo .
      598   define variable v-diasize-resize-button        as handle    no-undo .
      599   define variable v-diasize-wndmax               as logical   no-undo .
      600   define variable v-diasize-wndstore             as logical   no-undo .
      601   define variable v-diasize-proc-name            as character no-undo .
      602   define variable v-diasize-browse-handle        as handle    no-undo .
      603   define variable v-diasize-browse-number        as integer   no-undo .
      604   define variable v-diasize-need-full-display    as logical   no-undo init false .
      605   define temp-table temp-diasize-handle no-undo
      606     field handle-value  as handle
      607     field save-position as decimal
      608     index xpk is primary unique handle-value
      609     .
      610   define temp-table temp-browse-handle no-undo
      611     field browse-type   as character
      612     field browse-number as integer
      613     field browse-handle as handle
      614     field original-size as decimal
      615     index xpk is primary unique browse-type browse-number
      616     index xie browse-type browse-handle
      617   .
      618   procedure diasize_change-height :
      619     define input  parameter p-change-value  as decimal   no-undo .
      620     define input  parameter p-move-resize   as logical   no-undo .
      621     define variable v-field-group-handle    as handle    no-undo .
      622     define variable v-object-handle         as handle    no-undo .
      623     define variable v-frame-height          as decimal   no-undo .
      624     define variable v-frame-virtual-height  as decimal   no-undo .
      625     define variable v-browse-height         as decimal   no-undo .
      626     define variable v-window-height         as decimal   no-undo .
      627     define variable v-window-virtual-height as decimal   no-undo .
      628     define variable v-change-sign           as integer   no-undo .
      629     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      630     define buffer buf_temp-browse-handle  for temp-browse-handle .
      631     if p-change-value > 0
      632     then do:
      633       if frame Dialog-Frame :height + p-change-value
      634           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      635       then do:
      636         assign
      637           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      638                           - (frame Dialog-Frame :height-chars)
      639         .
      640         if p-change-value <= 0
      641         then do:
      642           run diasize_position-resize-button in this-procedure .
      643           return .
      644         end.
      645       end.
      646     end.
      647     if p-change-value < 0
      648     then do:
      649       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      650       then do:
      651         assign
      652           p-change-value = v-diasize-orig-frame-height
      653                          - (frame Dialog-Frame :height-chars)
      654         .
      655         if p-change-value >= 0
      656         then do:
      657           run diasize_position-resize-button in this-procedure .
      658           return .
      659         end.
      660       end.
      661     end.
      662     if p-change-value >= 0
      663     then do:
      664       assign
      665         v-change-sign = 1
      666       .
      667     end.
      668     else do:
      669       assign
      670         v-change-sign = -1
      671       .
      672     end.
      673     assign
      674       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      675     .
      676     if p-change-value = 0
      677     then do:
      678       run diasize_position-resize-button in this-procedure .
      679       return .
      680     end.
      681     move_block:
      682     do
      683     on error undo move_block, retry move_block
      684     :
      685       if retry
      686       then do:
      687         do
      688         on error undo move_block, leave move_block
      689         :
      690           if p-change-value > 0
      691           then do:
      692             for each buf_temp-diasize-handle
      693             on error undo, next
      694             :
      695               assign
      696                 v-object-handle = buf_temp-diasize-handle.handle-value
      697               .
      698               if v-object-handle <> v-diasize-resize-button
      699               then do:
      700                 assign
      701                   v-object-handle :row = buf_temp-diasize-handle.save-position
      702                 .
      703               end.
      704             end.
      705             assign
      706               v-diasize-browse-handle :height = v-browse-height
      707             .
      708             for each buf_temp-browse-handle
      709               where buf_temp-browse-handle.browse-type = 'height':u
      710             on error undo, next
      711             :
      712               assign
      713                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      714               .
      715             end.
      716             assign
      717               frame Dialog-Frame :height = v-frame-height
      718             .
      719             if frame Dialog-Frame :scrollable = true
      720             then do:
      721               assign
      722                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      723               .
      724             end.
      725             run diasize_position-resize-button in this-procedure .
      726           end.
      727           else do:
      728             if frame Dialog-Frame :scrollable = true
      729             then do:
      730               assign
      731                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      732               .
      733             end.
      734             assign
      735               frame Dialog-Frame :height = v-frame-height
      736             .
      737             assign
      738               v-diasize-browse-handle :height = v-browse-height
      739             .
      740             for each buf_temp-browse-handle
      741               where buf_temp-browse-handle.browse-type = 'height':u
      742             on error undo, next
      743             :
      744               assign
      745                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      746               .
      747             end.
      748             for each buf_temp-diasize-handle
      749             on error undo, next
      750             :
      751               assign
      752                 v-object-handle = buf_temp-diasize-handle.handle-value
      753               .
      754               if v-object-handle <> v-diasize-resize-button
      755               then do:
      756                 assign
      757                   v-object-handle :row = buf_temp-diasize-handle.save-position
      758                 .
      759               end.
      760             end.
      761             run diasize_position-resize-button in this-procedure .
      762           end.
      763           assign
      764             v-diasize-change-size = false
      765           .
      766           leave move_block .
      767         end.
      768       end.
      769       assign
      770         v-diasize-need-full-display = true
      771       .
      772       if v-diasize-change-size = false
      773       then do:
      774         assign
      775           v-diasize-change-size = true
      776         .
      777       end.
      778       else do:
      779         return .
      780       end.
      781       assign
      782         v-frame-height = frame Dialog-Frame :height
      783         v-frame-virtual-height = frame Dialog-Frame :virtual-height
      784         v-browse-height = v-diasize-browse-handle :height
      785       .
      786       for each buf_temp-browse-handle
      787         where buf_temp-browse-handle.browse-type = 'height':u
      788       :
      789         assign
      790           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
      791         .
      792       end.
      793       for each buf_temp-diasize-handle
      794       :
      795         delete buf_temp-diasize-handle .
      796       end.
      797       assign
      798         v-field-group-handle = frame Dialog-Frame :first-child
      799       .
      800       do while valid-handle(v-field-group-handle)
      801       :
      802         assign
      803           v-object-handle = v-field-group-handle :first-child
      804         .
      805         do while valid-handle(v-object-handle)
      806         :
      807           if  v-object-handle <> v-diasize-browse-handle :handle
      808           and can-query(v-object-handle, "row")
      809           and can-query(v-object-handle, "height")
      810           and ( v-object-handle :row > v-diasize-browse-handle :row )
      811           then do:
      812             find first buf_temp-browse-handle
      813               where buf_temp-browse-handle.browse-type   = 'height':u
      814                 and buf_temp-browse-handle.browse-handle = v-object-handle
      815               no-error .
      816             if available buf_temp-browse-handle
      817             then do:
      818             end.
      819             else do:
      820               create buf_temp-diasize-handle .
      821               assign
      822                 buf_temp-diasize-handle.handle-value  = v-object-handle
      823                 buf_temp-diasize-handle.save-position = v-object-handle :row
      824               .
      825             end.
      826           end.
      827           assign
      828             v-object-handle = v-object-handle :next-sibling
      829           .
      830         end.
      831         assign
      832           v-field-group-handle = v-field-group-handle :next-sibling
      833         .
      834       end.
      835       do with frame Dialog-Frame
      836       :
      837         hide v-diasize-resize-button .
      838         assign
      839           v-diasize-resize-button :row    = 1
      840           v-diasize-resize-button :column = 1
      841         .
      842       end.
      843       if p-change-value > 0
      844       then do:
      845         if frame Dialog-Frame :scrollable = true
      846         then do:
      847           assign
      848             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      849             no-error .
      850           if error-status :error
      851           or error-status :get-message(1) <> ""
      852           then do:
      853             undo move_block, retry move_block .
      854           end.
      855         end.
      856         assign
      857           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      858           no-error .
      859         if error-status :error
      860         or error-status :get-message(1) <> ""
      861         then do:
      862           undo move_block, retry move_block .
      863         end.
      864         assign
      865           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      866           no-error .
      867         if error-status :error
      868         or error-status :get-message(1) <> ""
      869         then do:
      870           undo move_block, retry move_block .
      871         end.
      872         for each buf_temp-browse-handle
      873           where buf_temp-browse-handle.browse-type = 'height':u
      874         on error undo move_block, retry move_block
      875         :
      876           assign
      877             buf_temp-browse-handle.browse-handle :height
      878               = buf_temp-browse-handle.browse-handle :height + p-change-value
      879             no-error .
      880           if error-status :error
      881           or error-status :get-message(1) <> ""
      882           then do:
      883             undo move_block, retry move_block .
      884           end.
      885         end.
      886         for each buf_temp-diasize-handle
      887         on error undo move_block, retry move_block
      888         :
      889           assign
      890             v-object-handle = buf_temp-diasize-handle.handle-value
      891           .
      892           if v-object-handle <> v-diasize-resize-button
      893           then do:
      894             assign
      895               v-object-handle :row = v-object-handle :row + p-change-value
      896               no-error .
      897             if error-status :error
      898             or error-status :get-message(1) <> ""
      899             then do:
      900               undo move_block, retry move_block .
      901             end.
      902           end.
      903         end.
      904       end.
      905       else do:
      906         for each buf_temp-diasize-handle
      907         on error undo move_block, retry move_block
      908         :
      909           assign
      910             v-object-handle = buf_temp-diasize-handle.handle-value
      911           .
      912           if v-object-handle <> v-diasize-resize-button
      913           then do:
      914             assign
      915               v-object-handle :row = v-object-handle :row + p-change-value
      916               no-error .
      917             if error-status :error
      918             or error-status :get-message(1) <> ""
      919             then do:
      920               undo move_block, retry move_block .
      921             end.
      922           end.
      923         end.
      924         assign
      925           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      926           no-error .
      927         if error-status :error
      928         or error-status :get-message(1) <> ""
      929         then do:
      930           undo move_block, retry move_block .
      931         end.
      932         for each buf_temp-browse-handle
      933           where buf_temp-browse-handle.browse-type = 'height':u
      934         on error undo move_block, retry move_block
      935         :
      936           assign
      937             buf_temp-browse-handle.browse-handle :height
      938               = buf_temp-browse-handle.browse-handle :height + p-change-value
      939             no-error .
      940           if error-status :error
      941           or error-status :get-message(1) <> ""
      942           then do:
      943             undo move_block, retry move_block .
      944           end.
      945         end.
      946         assign
      947           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      948           no-error .
      949         if error-status :error
      950         or error-status :get-message(1) <> ""
      951         then do:
      952           undo move_block, retry move_block .
      953         end.
      954         if frame Dialog-Frame :scrollable = true
      955         then do:
      956           assign
      957             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      958             no-error .
      959           if error-status :error
      960           or error-status :get-message(1) <> ""
      961           then do:
      962             undo move_block, retry move_block .
      963           end.
      964         end.
      965       end.
      966       if p-move-resize = true
      967       then do:
      968         run diasize_position-resize-button in this-procedure .
      969       end.
      970       if v-diasize-wndstore = true
      971       then do:
      972         if connected("ub") = true
      973         then do:
      974           define variable v-cntxt-db-num        as integer   no-undo .
      975           define variable v-cntxt-userid        as character no-undo .
      976           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
      977                                             , OUTPUT v-cntxt-userid
      978                                             ) .
      979           run gbl/wndsizew.p
      980             (input  v-cntxt-db-num
      981             ,input  v-cntxt-userid
      982             ,input  v-diasize-proc-name
      983             ,input  'height':u
      984             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
      985             ) .
      986         end.
      987       end.
      988     end.
      989     assign
      990       v-diasize-change-size = false
      991     .
      992   end procedure.
      993   procedure diasize_set-height :
      994     define input  parameter p-new-height  as decimal   no-undo .
      995     define input  parameter p-move-resize as logical   no-undo .
      996     do
      997     on error undo, return error return-value
      998     :
      999       run diasize_change-height in this-procedure
     1000         (input  (p-new-height - frame Dialog-Frame :height)
     1001         ,input  p-move-resize
     1002         ) .
     1003     end.
     1004   end procedure.
     1005   procedure diasize_change-width :
     1006     define input  parameter p-change-value as decimal   no-undo .
     1007     define input  parameter p-move-resize  as logical   no-undo .
     1008     define variable v-field-group-handle   as handle    no-undo .
     1009     define variable v-object-handle        as handle    no-undo .
     1010     define variable v-frame-width          as decimal   no-undo .
     1011     define variable v-frame-virtual-width  as decimal   no-undo .
     1012     define variable v-browse-width         as decimal   no-undo .
     1013     define variable v-window-width         as decimal   no-undo .
     1014     define variable v-window-virtual-width as decimal   no-undo .
     1015     define variable v-change-sign          as integer   no-undo .
     1016     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1017     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1018     if p-change-value > 0
     1019     then do:
     1020       if frame Dialog-Frame :width + p-change-value >
     1021           session :width-chars
     1022       then do:
     1023         assign
     1024           p-change-value = session :width-chars - frame Dialog-Frame :width
     1025         .
     1026         if p-change-value <= 0
     1027         then do:
     1028           run diasize_position-resize-button in this-procedure .
     1029           return .
     1030         end.
     1031       end.
     1032     end.
     1033     if p-change-value < 0
     1034     then do:
     1035       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1036       then do:
     1037         assign
     1038           p-change-value = v-diasize-orig-frame-width
     1039                          - frame Dialog-Frame :width
     1040         .
     1041         if p-change-value >= 0
     1042         then do:
     1043           run diasize_position-resize-button in this-procedure .
     1044           return .
     1045         end.
     1046       end.
     1047     end.
     1048     if p-change-value >= 0
     1049     then do:
     1050       assign
     1051         v-change-sign = 1
     1052       .
     1053     end.
     1054     else do:
     1055       assign
     1056         v-change-sign = -1
     1057       .
     1058     end.
     1059     assign
     1060       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1061     .
     1062     if p-change-value = 0
     1063     then do:
     1064       run diasize_position-resize-button in this-procedure .
     1065       return .
     1066     end.
     1067     move_block:
     1068     do
     1069     on error undo move_block, leave move_block
     1070     :
     1071       if retry
     1072       then do:
     1073         do
     1074         on error undo move_block, leave move_block
     1075         :
     1076           if p-change-value > 0
     1077           then do:
     1078             for each buf_temp-diasize-handle
     1079             on error undo, next
     1080             :
     1081               assign
     1082                 v-object-handle = buf_temp-diasize-handle.handle-value
     1083               .
     1084               if v-object-handle <> v-diasize-resize-button
     1085               then do:
     1086                 assign
     1087                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1088                 .
     1089               end.
     1090             end.
     1091             assign
     1092               v-diasize-browse-handle :width = v-browse-width
     1093             .
     1094             for each buf_temp-browse-handle
     1095               where buf_temp-browse-handle.browse-type = 'width':u
     1096             on error undo, next
     1097             :
     1098               assign
     1099                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1100               .
     1101             end.
     1102             assign
     1103               frame Dialog-Frame :width = v-frame-width
     1104             .
     1105             if frame Dialog-Frame :scrollable = true
     1106             then do:
     1107               assign
     1108                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1109               .
     1110             end.
     1111             run diasize_position-resize-button in this-procedure .
     1112           end.
     1113           else do:
     1114             if frame Dialog-Frame :scrollable = true
     1115             then do:
     1116               assign
     1117                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1118               .
     1119             end.
     1120             assign
     1121               frame Dialog-Frame :width = v-frame-width
     1122             .
     1123             for each buf_temp-browse-handle
     1124               where buf_temp-browse-handle.browse-type = 'width':u
     1125             on error undo, next
     1126             :
     1127               assign
     1128                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1129               .
     1130             end.
     1131             assign
     1132               v-diasize-browse-handle :width = v-browse-width
     1133             .
     1134             for each buf_temp-diasize-handle
     1135             on error undo, next
     1136             :
     1137               assign
     1138                 v-object-handle = buf_temp-diasize-handle.handle-value
     1139               .
     1140               if v-object-handle <> v-diasize-resize-button
     1141               then do:
     1142                 assign
     1143                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1144                 .
     1145               end.
     1146             end.
     1147             run diasize_position-resize-button in this-procedure .
     1148           end.
     1149           assign
     1150             v-diasize-change-size = false
     1151           .
     1152           leave move_block .
     1153         end.
     1154       end.
     1155       assign
     1156         v-diasize-need-full-display = true
     1157       .
     1158       if v-diasize-change-size = false
     1159       then do:
     1160         assign
     1161           v-diasize-change-size = true
     1162         .
     1163       end.
     1164       else do:
     1165         return .
     1166       end.
     1167       assign
     1168         v-frame-width = frame Dialog-Frame :width
     1169         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1170         v-browse-width = v-diasize-browse-handle :width
     1171       .
     1172       for each buf_temp-browse-handle
     1173         where buf_temp-browse-handle.browse-type = 'width':u
     1174       :
     1175         assign
     1176           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1177         .
     1178       end.
     1179       for each buf_temp-diasize-handle
     1180       :
     1181         delete buf_temp-diasize-handle .
     1182       end.
     1183       assign
     1184         v-field-group-handle = frame Dialog-Frame :first-child
     1185       .
     1186       do while valid-handle(v-field-group-handle)
     1187       :
     1188         assign
     1189           v-object-handle = v-field-group-handle :first-child
     1190         .
     1191         do while valid-handle(v-object-handle)
     1192         :
     1193           if  v-object-handle <> v-diasize-browse-handle :handle
     1194           and v-object-handle <> v-diasize-resize-button
     1195           and can-query(v-object-handle, "row")
     1196           and can-query(v-object-handle, "height")
     1197           and ( v-object-handle :col + v-object-handle :width
     1198                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1199               )
     1200           then do:
     1201             find first buf_temp-browse-handle
     1202               where buf_temp-browse-handle.browse-type   = 'width':u
     1203                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1204               no-error .
     1205             if available buf_temp-browse-handle
     1206             then do:
     1207             end.
     1208             else do:
     1209               create buf_temp-diasize-handle .
     1210               assign
     1211                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1212                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1213               .
     1214             end.
     1215           end.
     1216           assign
     1217             v-object-handle = v-object-handle :next-sibling
     1218           .
     1219         end.
     1220         assign
     1221           v-field-group-handle = v-field-group-handle :next-sibling
     1222         .
     1223       end.
     1224       do with frame Dialog-Frame
     1225       :
     1226         hide v-diasize-resize-button .
     1227         v-diasize-resize-button :row = 1.
     1228         v-diasize-resize-button :column = 1.
     1229       end.
     1230       if p-change-value > 0
     1231       then do:
     1232         if frame Dialog-Frame :scrollable = true
     1233         then do:
     1234           assign
     1235             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1236             no-error .
     1237           if error-status :error
     1238           or error-status :get-message(1) <> ""
     1239           then do:
     1240             undo move_block, retry move_block.
     1241           end.
     1242         end.
     1243         assign
     1244           frame Dialog-Frame :width = v-frame-width + p-change-value
     1245           no-error .
     1246         if error-status :error
     1247         or error-status :get-message(1) <> ""
     1248         then do:
     1249           undo move_block, retry move_block.
     1250         end.
     1251         assign
     1252           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1253         no-error .
     1254         if error-status :error
     1255         or error-status :get-message(1) <> ""
     1256         then do:
     1257           undo move_block, retry move_block.
     1258         end.
     1259         for each buf_temp-browse-handle
     1260           where buf_temp-browse-handle.browse-type = 'width':u
     1261         on error undo move_block, retry move_block
     1262         :
     1263           assign
     1264             buf_temp-browse-handle.browse-handle :width
     1265               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1266             no-error .
     1267           if error-status :error
     1268           or error-status :get-message(1) <> ""
     1269           then do:
     1270             undo move_block, retry move_block .
     1271           end.
     1272         end.
     1273         for each buf_temp-diasize-handle
     1274         on error undo move_block, retry move_block
     1275         :
     1276           assign
     1277             v-object-handle = buf_temp-diasize-handle.handle-value
     1278           .
     1279           if v-object-handle <> v-diasize-resize-button
     1280           then do:
     1281             assign
     1282               v-object-handle :col = v-object-handle :col + p-change-value
     1283               no-error .
     1284             if error-status :error
     1285             or error-status :get-message(1) <> ""
     1286             then do:
     1287               undo move_block, retry move_block .
     1288             end.
     1289           end.
     1290         end.
     1291       end.
     1292       else do:
     1293         for each buf_temp-diasize-handle
     1294         on error undo move_block, retry move_block
     1295         :
     1296           assign
     1297             v-object-handle = buf_temp-diasize-handle.handle-value
     1298           .
     1299           if v-object-handle <> v-diasize-resize-button
     1300           then do:
     1301             assign
     1302               v-object-handle :col = v-object-handle :col + p-change-value
     1303               no-error .
     1304             if error-status :error
     1305             or error-status :get-message(1) <> ""
     1306             then do:
     1307               undo move_block, retry move_block .
     1308             end.
     1309           end.
     1310         end.
     1311         for each buf_temp-browse-handle
     1312           where buf_temp-browse-handle.browse-type = 'width':u
     1313         on error undo move_block, retry move_block
     1314         :
     1315           assign
     1316             buf_temp-browse-handle.browse-handle :width
     1317               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1318             no-error .
     1319           if error-status :error
     1320           or error-status :get-message(1) <> ""
     1321           then do:
     1322             undo move_block, retry move_block .
     1323           end.
     1324         end.
     1325         assign
     1326           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1327           no-error .
     1328         if error-status :error
     1329         or error-status :get-message(1) <> ""
     1330         then do:
     1331           undo move_block, retry move_block.
     1332         end.
     1333         assign
     1334           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1335         no-error .
     1336         if error-status :error
     1337         or error-status :get-message(1) <> ""
     1338         then do:
     1339           undo move_block, retry move_block.
     1340         end.
     1341         if frame Dialog-Frame :scrollable = true
     1342         then do:
     1343           assign
     1344             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1345           no-error .
     1346           if error-status :error
     1347           or error-status :get-message(1) <> ""
     1348           then do:
     1349             undo move_block, retry move_block.
     1350           end.
     1351         end.
     1352       end.
     1353       if p-move-resize
     1354       then do:
     1355         run diasize_position-resize-button in this-procedure .
     1356       end.
     1357       if v-diasize-wndstore = true
     1358       then do:
     1359         if connected("ub") = true
     1360         then do:
     1361           define variable v-cntxt-db-num        as integer   no-undo .
     1362           define variable v-cntxt-userid        as character no-undo .
     1363           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1364                                             , OUTPUT v-cntxt-userid
     1365                                             ) .
     1366           run gbl/wndsizew.p
     1367             (input  v-cntxt-db-num
     1368             ,input  v-cntxt-userid
     1369             ,input  v-diasize-proc-name
     1370             ,input  'width':u
     1371             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1372             ) .
     1373         end.
     1374       end.
     1375     end.
     1376     assign
     1377       v-diasize-change-size = false
     1378     .
     1379   end procedure.
     1380   procedure diasize_set-width :
     1381     define input  parameter p-new-width  as decimal   no-undo .
     1382     define input  parameter p-move-resize as logical   no-undo .
     1383     do
     1384     on error undo, return error return-value
     1385     :
     1386       run diasize_change-width in this-procedure
     1387         (input  (p-new-width - frame Dialog-Frame :width)
     1388         ,input  p-move-resize
     1389         ) .
     1390     end.
     1391   end procedure.
     1392   procedure diasize_position-resize-button :
     1393     do with frame Dialog-Frame
     1394     :
     1395       hide v-diasize-resize-button .
     1396       assign
     1397         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1398                     - 1
     1399                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1400         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1401                     - 1
     1402                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1403       .
     1404       view v-diasize-resize-button .
     1405     end.
     1406   end procedure.
     1407   on alt-right anywhere
     1408   do:
     1409     run diasize_change-width in this-procedure
     1410       (input 1
     1411       ,input true
     1412       ) .
     1413     return no-apply .
     1414   end.
     1415   on alt-left anywhere
     1416   do:
     1417     run diasize_change-width in this-procedure
     1418       (input -1
     1419       ,input true
     1420       ) .
     1421     return no-apply .
     1422   end.
     1423   on alt-down anywhere
     1424   do:
     1425     run diasize_change-height in this-procedure
     1426       (input 1
     1427       ,input true
     1428       ) .
     1429     return no-apply .
     1430   end.
     1431   on alt-up anywhere
     1432   do:
     1433     run diasize_change-height in this-procedure
     1434       (input -1
     1435       ,input true
     1436       ) .
     1437     return no-apply .
     1438   end.
     1439   on alt-enter of frame Dialog-Frame
     1440   do:
     1441     run diasize_maximize in this-procedure
     1442       (input  ?
     1443       ).
     1444     return no-apply .
     1445   end.
     1446   procedure diasize_end-move :
     1447     do
     1448     on error undo, return error return-value
     1449     :
     1450       define variable v-row-delta as decimal   no-undo .
     1451       define variable v-col-delta as decimal   no-undo .
     1452       define variable v-new-row as decimal   no-undo .
     1453       define variable v-new-col as decimal   no-undo .
     1454       assign
     1455         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1456         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1457       .
     1458       assign
     1459         v-row-delta = v-new-row - frame Dialog-Frame :height
     1460         v-col-delta = v-new-col - frame Dialog-Frame :width
     1461       .
     1462       run diasize_change-height in this-procedure
     1463         (input v-row-delta
     1464         ,input true
     1465         ) .
     1466       run diasize_change-width in this-procedure
     1467         (input v-col-delta
     1468         ,input true
     1469         ) .
     1470     end.
     1471   end procedure.
     1472   procedure diasize_maximize :
     1473     define input  parameter p-action as logical   no-undo .
     1474     do
     1475     on error undo, return error return-value
     1476     :
     1477       if p-action = ?
     1478       then do:
     1479         if v-diasize-need-maximize = true
     1480         then do:
     1481           assign
     1482             p-action = true
     1483           .
     1484         end.
     1485         else do:
     1486           assign
     1487             p-action = false
     1488           .
     1489         end.
     1490       end.
     1491       if p-action = true
     1492       then do:
     1493         run diasize_change-height in this-procedure
     1494           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1495               - frame Dialog-Frame :height-chars
     1496           ,input true
     1497           ) .
     1498         run diasize_change-width in this-procedure
     1499           (input session :width-chars
     1500               - frame Dialog-Frame :width-chars
     1501           ,input true
     1502           ) .
     1503         assign
     1504           v-diasize-need-maximize = false
     1505         .
     1506       end.
     1507       else do:
     1508         run diasize_change-width in this-procedure
     1509           (input v-diasize-orig-frame-width
     1510               - frame Dialog-Frame :width-chars
     1511           ,input true
     1512           ) .
     1513         run diasize_change-height in this-procedure
     1514           (input v-diasize-orig-frame-height
     1515               - frame Dialog-Frame :height-chars
     1516           ,input true
     1517           ) .
     1518         assign
     1519           v-diasize-need-maximize = true
     1520         .
     1521       end.
     1522     end.
     1523   end procedure.
     1524   procedure diasize_restore-orig-size :
     1525     do
     1526     on error undo, return error return-value
     1527     :
     1528       assign
     1529         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1530         v-diasize-current-frame-height = frame Dialog-Frame :height
     1531       .
     1532       run diasize_set-height in this-procedure
     1533         (input  v-diasize-orig-frame-height
     1534         ,input  true
     1535         ) .
     1536       run diasize_set-width in this-procedure
     1537         (input  v-diasize-orig-frame-width
     1538         ,input  true
     1539         ) .
     1540     end.
     1541   end procedure.
     1542   procedure diasize_restore-current-size :
     1543     do
     1544     on error undo, return error return-value
     1545     :
     1546       run diasize_set-height in this-procedure
     1547         (input  v-diasize-current-frame-height
     1548         ,input  true
     1549         ) .
     1550       run diasize_set-width in this-procedure
     1551         (input  v-diasize-current-frame-width
     1552         ,input  true
     1553         ) .
     1554     end.
     1555   end procedure.
     1556   procedure diasize_set-browse-handle :
     1557     define input  parameter p-browse-handle as handle   no-undo .
     1558     define buffer buf_temp-browse-handle for temp-browse-handle .
     1559     do
     1560     on error undo, return error return-value
     1561     :
     1562       assign
     1563         v-diasize-browse-handle = p-browse-handle
     1564       .
     1565       for each buf_temp-browse-handle
     1566       on error undo, return error return-value
     1567       :
     1568         delete buf_temp-browse-handle .
     1569       end.
     1570     end.
     1571   end procedure.
     1572   procedure diasize_add_browse :
     1573     define input  parameter p-browse-type   as character no-undo .
     1574     define input  parameter p-browse-handle as handle    no-undo .
     1575     define buffer buf_temp-browse-handle for temp-browse-handle .
     1576     do
     1577     on error undo, return error return-value
     1578     :
     1579       assign
     1580         v-diasize-browse-number = v-diasize-browse-number + 1
     1581       .
     1582       create buf_temp-browse-handle .
     1583       assign
     1584         buf_temp-browse-handle.browse-type   = p-browse-type
     1585         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1586         buf_temp-browse-handle.browse-handle = p-browse-handle
     1587       .
     1588     end.
     1589   end procedure.
     1590   procedure diasize_init :
     1591     define variable v-default-value    as logical   no-undo .
     1592     define variable v-restore-saved    as logical   no-undo .
     1593     define variable v-resize-value-str as character no-undo .
     1594     do
     1595     on error undo, return error return-value
     1596     :
     1597       do with frame Dialog-Frame
     1598       :
     1599         assign
     1600           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1601           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1602           v-diasize-browse-handle     = browse BROWSE-1 :handle
     1603         .
     1604         create button v-diasize-resize-button
     1605         assign
     1606           parent        = frame Dialog-Frame :first-child
     1607           label         = "s"
     1608           height-pixels = 16
     1609           width-pixels  = 16
     1610           visible       = true
     1611           sensitive     = true
     1612           movable       = true
     1613           triggers:
     1614             on end-move persistent run diasize_end-move in this-procedure .
     1615           end triggers.
     1616         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1617         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1618         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1619         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1620         assign
     1621           v-diasize-wndmax = false
     1622         .
     1623         if connected("ub") = true
     1624         then do:
     1625           define variable v-cntxt-db-num        as integer   no-undo .
     1626           define variable v-cntxt-userid        as character no-undo .
     1627           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1628                                             , OUTPUT v-cntxt-userid
     1629                                             ) .
     1630           run gbl/wndpar_r.p
     1631             (input  v-cntxt-db-num
     1632             ,input  v-cntxt-userid
     1633             ,input  'wndmax':U
     1634             ,output v-diasize-wndmax
     1635             ,output v-default-value
     1636             ) .
     1637         end.
     1638         assign
     1639           v-diasize-wndstore = false
     1640         .
     1641         if connected("ub") = true
     1642         then do:
     1643           run gbl/wndpar_r.p
     1644             (input  v-cntxt-db-num
     1645             ,input  v-cntxt-userid
     1646             ,input  'wndstore':U
     1647             ,output v-diasize-wndstore
     1648             ,output v-default-value
     1649             ) .
     1650         end.
     1651         assign
     1652           v-diasize-proc-name = entry(1, program-name(2), '.')
     1653         .
     1654         if v-diasize-wndstore = true
     1655         then do:
     1656           assign
     1657             v-restore-saved = false
     1658           .
     1659           if connected("ub") = true
     1660           then do:
     1661             run gbl/wndsizer.p
     1662               (input  v-cntxt-db-num
     1663               ,input  v-cntxt-userid
     1664               ,input  v-diasize-proc-name
     1665               ,input  'height':u
     1666               ,output v-resize-value-str
     1667               ) .
     1668             if v-resize-value-str <> '':U
     1669             then do:
     1670               run diasize_change-height in this-procedure
     1671                 (input  integer(v-resize-value-str)
     1672                 ,input  true
     1673                 ) .
     1674               assign
     1675                 v-restore-saved = true
     1676               .
     1677             end.
     1678           end.
     1679           if connected("ub") = true
     1680           then do:
     1681             run gbl/wndsizer.p
     1682               (input  v-cntxt-db-num
     1683               ,input  v-cntxt-userid
     1684               ,input  v-diasize-proc-name
     1685               ,input  'width':u
     1686               ,output v-resize-value-str
     1687               ) .
     1688             if v-resize-value-str <> '':U
     1689             then do:
     1690               run diasize_change-width in this-procedure
     1691                 (input  integer(v-resize-value-str)
     1692                 ,input  true
     1693                 ) .
     1694               assign
     1695                 v-restore-saved = true
     1696               .
     1697             end.
     1698           end.
     1699           if v-restore-saved <> true
     1700           then do:
     1701             if v-diasize-wndmax = true
     1702             then do:
     1703               run diasize_maximize in this-procedure
     1704                 (input  true
     1705                 ) .
     1706             end.
     1707           end.
     1708         end.
     1709         else do:
     1710           if v-diasize-wndmax = true
     1711           then do:
     1712             run diasize_maximize in this-procedure
     1713               (input  true
     1714               ) .
     1715           end.
     1716         end.
     1717       end.
     1718     end.
     1719   end procedure.
     1720   procedure diasize_need-full-display :
     1721     define output parameter p-need-full-display as logical   no-undo .
     1722     do
     1723     on error undo, return error return-value
     1724     :
     1725       assign
     1726         p-need-full-display = v-diasize-need-full-display
     1727       .
     1728       assign
     1729         v-diasize-need-full-display = false
     1730       .
     1731     end.
     1732   end procedure.
     1733   procedure get-context :
     1734      define output parameter p-db-num as integer          no-undo.
     1735      define output parameter p-user-id as character        no-undo.
     1736      define variable v-login               as character    no-undo.
     1737      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1738      define buffer buf_user-login  for ub.user-login .
     1739      do
     1740      on error undo, return error
     1741      :
     1742            FIND FIRST buf_sys-ctrl no-lock.
     1743            ASSIGN
     1744               v-login = USERID("ub")
     1745               p-db-num = buf_sys-ctrl.db-num
     1746            .
     1747            FIND FIRST buf_user-login
     1748                 WHERE buf_user-login.db-num = p-db-num
     1749                   AND buf_user-login.user-login = v-login
     1750                 no-lock
     1751                 no-error
     1752                 .
     1753            IF AVAILABLE buf_user-login
     1754            THEN DO:
     1755               assign
     1756                  p-user-id = buf_user-login.user-id
     1757               .
     1758            END.
     1759      end.
     1760   end procedure.
     1761       run diasize_init in this-procedure .
     1762   MAIN-BLOCK:
     1763   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1764      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1765      assign
     1766          frame Dialog-Frame :title = "Акты проработки для рецепта " + p-recipe-code
     1767      .
     1768      run init-fields in this-procedure.
     1769     RUN enable_UI.
     1770     WAIT-FOR GO OF FRAME Dialog-Frame.
     1771   END.
     1772   RUN disable_UI.
     1773   PROCEDURE add-akt :
     1774   define input parameter p-recipe-code    as character        no-undo.
     1775   define output parameter p-ok            as logical          no-undo.
     1776       define variable v-doc-code       as character    no-undo.
     1777       define variable v-doc-date       as date         no-undo.
     1778       define variable v-gds-code      as integer      no-undo.
     1779       define buffer buf_recipe-gds            for recipe-gds.
     1780       define buffer buf_recipe-develop        for recipe-develop.
     1781   do
     1782   for buf_recipe-gds
     1783     , buf_recipe-develop
     1784   on error undo, return error
     1785   :
     1786       run ref/rcpaktd.w (
     1787             input 'ДОБАВЛЕНИЕ':U
     1788           , input p-recipe-code
     1789           , input ""
     1790           , input ""
     1791           , output v-doc-code
     1792           , output v-doc-date
     1793           , output p-ok
     1794       ).
     1795       if p-ok = yes
     1796       and v-doc-code <> ""
     1797       then do:
     1798           for each buf_recipe-gds no-lock
     1799              where buf_recipe-gds.recipe-code = p-recipe-code
     1800           on error undo, return error
     1801           :
     1802   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1803   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
     1804     (input  buf_recipe-gds.artic
     1805     ,input  buf_recipe-gds.prod-type
     1806     ,input  buf_recipe-gds.prod-code
     1807     ,output v-gds-code
     1808     )  .
     1809               create buf_recipe-develop.
     1810               assign
     1811                   buf_recipe-develop.recipe-code = p-recipe-code
     1812                   buf_recipe-develop.doc-code    = v-doc-code
     1813                   buf_recipe-develop.doc-date    = v-doc-date
     1814                   buf_recipe-develop.gds-code    = v-gds-code
     1815                   buf_recipe-develop.qnty        = buf_recipe-gds.qnty
     1816                   buf_recipe-develop.brutto-qnty = buf_recipe-gds.brutto-qnty
     1817               .
     1818           end.
     1819       end.
     1820       if v-doc-code = ""
     1821       then do:
     1822           assign
     1823               p-ok = no
     1824           .
     1825       end.
     1826   end.
     1827   END PROCEDURE.
     1828   PROCEDURE change-akt :
     1829   define input parameter p-recipe-code    as character        no-undo.
     1830   define input parameter p-doc-code       as character        no-undo.
     1831   define input parameter p-doc-date       as date             no-undo.
     1832   define output parameter p-ok            as logical          no-undo.
     1833       define variable v-doc-code      as character    no-undo.
     1834       define variable v-doc-date      as date         no-undo.
     1835       define variable v-gds-code      as integer      no-undo.
     1836       define buffer buf_recipe-gds            for recipe-gds.
     1837       define buffer buf_recipe-develop        for recipe-develop.
     1838   do
     1839   for buf_recipe-gds
     1840     , buf_recipe-develop
     1841   on error undo, return error
     1842   :
     1843       run ref/rcpaktd.w (
     1844             input 'ИЗМЕНЕНИЕ':U
     1845           , input p-recipe-code
     1846           , input p-doc-code
     1847           , input p-doc-date
     1848           , output v-doc-code
     1849           , output v-doc-date
     1850           , output p-ok
     1851       ).
     1852       if p-ok = yes
     1853       and ( v-doc-code <> p-doc-code
     1854           or v-doc-date <> p-doc-date )
     1855       then do:
     1856           for each buf_recipe-develop exclusive-lock
     1857              where buf_recipe-develop.recipe-code = p-recipe-code
     1858                and buf_recipe-develop.doc-code    = p-doc-code
     1859           on error undo, return error
     1860           :
     1861               assign
     1862                   buf_recipe-develop.doc-code    = v-doc-code
     1863                   buf_recipe-develop.doc-date    = v-doc-date
     1864               .
     1865           end.
     1866       end.
     1867       if v-doc-code = p-doc-code
     1868       and v-doc-date = p-doc-date
     1869       then do:
     1870           assign
     1871               p-ok = no
     1872           .
     1873       end.
     1874   end.
     1875   END PROCEDURE.
     1876   PROCEDURE change-line :
     1877   define input parameter p-recipe-code    as character        no-undo.
     1878   define input parameter p-doc-code       as character        no-undo.
     1879   define input parameter p-gds-code       as integer          no-undo.
     1880   define input parameter p-qnty           as decimal          no-undo.
     1881   define input parameter p-brutto-qnty    as decimal          no-undo.
     1882   define output parameter p-ok            as logical          no-undo.
     1883       define variable v-brutto-qnty    as decimal      no-undo.
     1884       define variable v-qnty    as decimal      no-undo.
     1885       define buffer buf_recipe-develop        for recipe-develop.
     1886   do
     1887   for buf_recipe-develop
     1888   on error undo, return error
     1889   :
     1890       run ref/rcpaktdl.w (
     1891             input p-qnty
     1892           , input p-brutto-qnty
     1893           , output v-qnty
     1894           , output v-brutto-qnty
     1895           , output p-ok
     1896       ).
     1897       if p-ok = yes
     1898       and p-qnty <> v-qnty
     1899       or p-brutto-qnty <> v-brutto-qnty
     1900       then do:
     1901           find first buf_recipe-develop exclusive-lock
     1902                where buf_recipe-develop.recipe-code = p-recipe-code
     1903                  and buf_recipe-develop.doc-code    = p-doc-code
     1904                  and buf_recipe-develop.gds-code    = p-gds-code
     1905           .
     1906           assign
     1907               buf_recipe-develop.qnty         = v-qnty
     1908               buf_recipe-develop.brutto-qnty  = v-brutto-qnty
     1909           .
     1910       end.
     1911       if p-qnty = v-qnty
     1912       and p-brutto-qnty = v-brutto-qnty
     1913       then do:
     1914           assign
     1915               p-ok = no
     1916           .
     1917       end.
     1918   end.
     1919   END PROCEDURE.
     1920   PROCEDURE create-or-update-recipe-develop :
     1921   define input parameter p-recipe-code    as character        no-undo.
     1922   define input parameter p-doc-code       as character        no-undo.
     1923   define input parameter p-doc-date       as date             no-undo.
     1924   define input parameter p-gds-code       as integer          no-undo.
     1925   define input parameter p-new-qnty       as decimal          no-undo.
     1926       define buffer buf_recipe-develop        for recipe-develop.
     1927   do
     1928   for buf_recipe-develop
     1929   on error undo, return error
     1930   :
     1931       find first buf_recipe-develop no-lock
     1932            where buf_recipe-develop.recipe-code = p-recipe-code
     1933              and buf_recipe-develop.doc-code    = p-doc-code
     1934              and buf_recipe-develop.gds-code    = p-gds-code
     1935       no-error.
     1936       if not available buf_recipe-develop
     1937       or buf_recipe-develop.qnty <> p-new-qnty
     1938       then do:
     1939           find first buf_recipe-develop exclusive-lock
     1940                where buf_recipe-develop.recipe-code = p-recipe-code
     1941                  and buf_recipe-develop.doc-code    = p-doc-code
     1942                  and buf_recipe-develop.gds-code    = p-gds-code
     1943           no-error.
     1944           if not available buf_recipe-develop
     1945           then do:
     1946               create buf_recipe-develop.
     1947               assign
     1948                   buf_recipe-develop.recipe-code = p-recipe-code
     1949                   buf_recipe-develop.doc-code    = p-doc-code
     1950                   buf_recipe-develop.gds-code    = p-gds-code
     1951               .
     1952           end.
     1953           assign
     1954               buf_recipe-develop.doc-date     = p-doc-date
     1955               buf_recipe-develop.qnty         = p-new-qnty
     1956               buf_recipe-develop.brutto-qnty  = p-new-qnty
     1957           .
     1958       end.
     1959   end.
     1960   END PROCEDURE.
     1961   PROCEDURE delete-akt :
     1962   define input parameter p-recipe-code    as character        no-undo.
     1963   define input parameter p-doc-code       as character        no-undo.
     1964       define buffer buf_recipe-develop        for recipe-develop.
     1965   do
     1966   for buf_recipe-develop
     1967   on error undo, return error
     1968   :
     1969       for each buf_recipe-develop exclusive-lock
     1970          where buf_recipe-develop.recipe-code = p-recipe-code
     1971            and buf_recipe-develop.doc-code    = p-doc-code
     1972       on error undo, return error
     1973       :
     1974           delete buf_recipe-develop.
     1975       end.
     1976   end.
     1977   END PROCEDURE.
     1978   PROCEDURE disable_UI :
     1979     HIDE FRAME Dialog-Frame.
     1980   END PROCEDURE.
     1981   PROCEDURE enable_UI :
     1982     ENABLE b-exit b-add b-chg b-del b-help BROWSE-1 b-chg-line b-gds BROWSE-2
     1983         WITH FRAME Dialog-Frame.
     1984     VIEW FRAME Dialog-Frame.
     1985     OPEN QUERY BROWSE-1 FOR EACH temp_recipe-develop NO-LOCK INDEXED-REPOSITION.    OPEN QUERY BROWSE-2 FOR EACH recipe-develop       WHERE recipe-develop.recipe-code = p-recipe-code  AND recipe-develop.doc-code = temp_recipe-develop.doc-code NO-LOCK INDEXED-REPOSITION.
     1986   END PROCEDURE.
     1987   PROCEDURE form-gds-list :
     1988   define input parameter p-recipe-code    as character        no-undo.
     1989   define input parameter p-doc-code       as character        no-undo.
     1990   define input parameter p-doc-date       as character        no-undo.
     1991       define buffer buf_recipe-develop    for recipe-develop.
     1992       define buffer buf_recipe            for recipe.
     1993       define buffer buf_goods             for goods.
     1994   do
     1995   for buf_recipe-develop
     1996     , buf_recipe
     1997     , buf_goods
     1998   on error undo, return error
     1999   :
     2000       find first buf_recipe no-lock
     2001            where buf_recipe.recipe-code = p-recipe-code
     2002       .
     2003       for each buf_recipe-develop
     2004          where buf_recipe-develop.recipe-code = p-recipe-code
     2005            and buf_recipe-develop.doc-code    = p-doc-code
     2006         , each goods no-lock
     2007          where goods.gds-code     = buf_recipe-develop.gds-code
     2008       :
     2009   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2010   find scn-list
     2011     where scn-list.prod-type = goods.prod-type
     2012       and scn-list.prod-code = goods.prod-code
     2013       and scn-list.artic     = goods.artic
     2014     no-error .
     2015   if available scn-list then do:
     2016     assign
     2017       scn-list.to-del = no
     2018     .
     2019   end.
     2020   else do:
     2021     define variable v-last12 as integer no-undo .
     2022     find last scn-list use-index oi no-error.
     2023     if available scn-list then do:
     2024       v-last12 = scn-list.order-num .
     2025     end.
     2026     else do:
     2027       v-last12 = 0 .
     2028     end.
     2029     create scn-list .
     2030     buffer-copy goods to scn-list
     2031     assign
     2032       scn-list.to-del = no
     2033       scn-list.order-num = v-last12 + 1
     2034     .
     2035     assign
     2036       lns-cnt = lns-cnt + 1
     2037       line-rec = recid (scn-list)
     2038     .
     2039   end.
     2040           assign
     2041               scn-list.qnty = buf_recipe-develop.qnty
     2042           .
     2043       end.
     2044       for each scn-list
     2045          where scn-list.to-del = yes
     2046       :
     2047           delete scn-list.
     2048       end.
     2049   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2050     run mainmenu_getcntxt in parparentproc
     2051       (output v-cntxt-db-num
     2052       ,output v-cntxt-userid
     2053       ,output v-cntxt-level
     2054       ,output v-cntxt-host-code-obj
     2055       ,output v-cntxt-obj-type
     2056       ,output v-cntxt-obj-code
     2057       ,output v-cntxt-db-num-obj
     2058       ,output v-cntxt-is-admin
     2059       ) .
     2060       run str/scn-list.w (input parparentproc, input v-cntxt-host-code-obj, input v-cntxt-obj-type, input v-cntxt-obj-code) .
     2061       new-list-create:
     2062       for each scn-list
     2063       :
     2064           find first buf_goods no-lock
     2065                where buf_goods.gds-code = scn-list.gds-code
     2066           .
     2067           assign
     2068               scn-list.to-del = yes
     2069           .
     2070           if buf_goods.gds-type       = 'у':U
     2071           and buf_recipe.recipe-type  <> 'производство':U
     2072           and buf_recipe.recipe-type  <> 'топливо':U
     2073           then do:
     2074               next new-list-create.
     2075           end.
     2076           run create-or-update-recipe-develop in this-procedure (
     2077                 input p-recipe-code
     2078               , input p-doc-code
     2079               , input p-doc-date
     2080               , input scn-list.gds-code
     2081               , input scn-list.qnty
     2082           ).
     2083       end.
     2084       deleted-records:
     2085       for each buf_recipe-develop
     2086          where buf_recipe-develop.recipe-code = p-recipe-code
     2087            and buf_recipe-develop.doc-code    = p-doc-code
     2088       :
     2089           find first scn-list
     2090                where scn-list.gds-code = buf_recipe-develop.gds-code
     2091           no-error.
     2092           if not available scn-list
     2093           then do:
     2094               delete buf_recipe-develop.
     2095           end.
     2096       end.
     2097   end.
     2098   END PROCEDURE.
     2099   PROCEDURE get-gds-field :
     2100   define input parameter p-par-num        as integer          no-undo.
     2101   define input parameter p-gds-code       as integer          no-undo.
     2102   define output parameter p-out-string    as character        no-undo.
     2103       define buffer buf_goods     for goods.
     2104   do
     2105   for buf_goods
     2106   on error undo, return error
     2107   :
     2108       find first buf_goods no-lock
     2109            where buf_goods.gds-code = p-gds-code
     2110       no-error.
     2111       if available buf_goods
     2112       then do:
     2113           case p-par-num
     2114           :
     2115               when 1
     2116               then do:
     2117                   assign
     2118                       p-out-string = buf_goods.artic
     2119                   .
     2120               end.
     2121               when 2
     2122               then do:
     2123                   assign
     2124                       p-out-string = buf_goods.gds-name
     2125                   .
     2126               end.
     2127           end case.
     2128       end.
     2129       else do:
     2130           assign
     2131               p-out-string = ""
     2132           .
     2133       end.
     2134   end.
     2135   END PROCEDURE.
     2136   PROCEDURE init-fields :
     2137       define buffer buf_recipe-develop        for recipe-develop.
     2138       define buffer buf_temp_recipe-develop   for temp_recipe-develop.
     2139   do
     2140   for buf_recipe-develop
     2141     , buf_temp_recipe-develop
     2142   on error undo, return error
     2143   :
     2144       for each buf_temp_recipe-develop
     2145       on error undo, return error
     2146       :
     2147           delete buf_temp_recipe-develop.
     2148       end.
     2149       for each buf_recipe-develop no-lock
     2150          where buf_recipe-develop.recipe-code = p-recipe-code
     2151       on error undo, return error
     2152       :
     2153           find first buf_temp_recipe-develop
     2154                where buf_temp_recipe-develop.doc-code = buf_recipe-develop.doc-code
     2155           no-error.
     2156           if not available buf_temp_recipe-develop
     2157           then do:
     2158               create buf_temp_recipe-develop.
     2159               assign
     2160                   buf_temp_recipe-develop.doc-code = buf_recipe-develop.doc-code
     2161                   buf_temp_recipe-develop.doc-date = buf_recipe-develop.doc-date
     2162               .
     2163           end.
     2164       end.
     2165   end.
     2166   END PROCEDURE.
     2167   FUNCTION get-column-value RETURNS CHARACTER
     2168     ( input p-column-num as integer, input p-gds-code as integer ) :
     2169       define variable v-out-string    as character    no-undo.
     2170       run get-gds-field in this-procedure (
     2171             input p-column-num
     2172           , input p-gds-code
     2173           , output v-out-string
     2174       ).
     2175       return v-out-string.
     2176   END FUNCTION.
