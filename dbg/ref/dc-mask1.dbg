        1   block-level on error undo, throw.
        2   define input-output parameter p-doc-rec    as recid no-undo.
        3   define input parameter parparentproc       as widget-handle                        no-undo .
        4   define input parameter p-mode              as character no-undo .
        5   define input parameter p-use-on            like ub.dis-card-mask.use-on            no-undo .
        6   define input parameter p-cli-code          like ub.dis-card-mask.cli-code          no-undo .
        7   define input parameter p-cli-mask          like ub.dis-card-mask.cli-mask          no-undo .
        8   define input parameter p-cli-type          like ub.dis-card-mask.cli-type          no-undo .
        9   define input parameter p-emitent-host-code like ub.dis-card-mask.emitent-host-code no-undo .
       10   define input parameter p-host-code         like ub.dis-card-mask.host-code         no-undo .
       11   define input parameter p-mask-num          like ub.dis-card-mask.mask-num          no-undo .
       12   define input parameter p-mask              like ub.dis-card-mask.mask              no-undo .
       13   define input parameter p-obj-code          like ub.dis-card-mask.obj-code          no-undo .
       14   define input parameter p-obj-type          like ub.dis-card-mask.obj-type          no-undo .
       15   define input parameter p-rank              like ub.dis-card-mask.rank              no-undo .
       16   define input parameter p-type              like ub.dis-card-mask.type              no-undo .
       17   define input parameter p-cc-run            like ub.dis-card-mask.cc-run            no-undo .
       18   define input parameter p-reg-cash          as logical                              no-undo .
       19   define variable vss-revision    as character no-undo init "$Revision$":U .
       20   define variable vss-author      as character no-undo init "$Author$":U .
       21   define variable vss-date        as character no-undo init "$Date$":U .
       22   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       23   define variable vss-archive     as character no-undo init "$Archive$":U .
       24   define variable vss-description as character no-undo init "Сохранение изменений в карточке МАСКИ ДИСКОНТНОЙ КАРТЫ".
       25   procedure vss-get-info :
       26     define output parameter p-vss-revision    like vss-revision    no-undo .
       27     define output parameter p-vss-author      like vss-author      no-undo .
       28     define output parameter p-vss-date        like vss-date        no-undo .
       29     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       30     define output parameter p-vss-archive     like vss-archive     no-undo .
       31     define output parameter p-vss-description like vss-description no-undo .
       32     assign
       33       p-vss-revision    = vss-revision
       34       p-vss-author      = vss-author
       35       p-vss-date        = vss-date
       36       p-vss-workfile    = vss-workfile
       37       p-vss-archive     = vss-archive
       38       p-vss-description = vss-description
       39     .
       40   end procedure.
       41   procedure vss-get-parameters :
       42     define output parameter p-vss-parameters as character no-undo .
       43   end procedure.
       44   define new global shared variable g#vssrevis-logger as handle    no-undo .
       45   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       46   define variable v-vssrevis-logger                   as handle    no-undo .
       47   procedure vss-logevent :
       48     define input  parameter p-extra-paramters as character no-undo .
       49     define variable v-vssrevis-parameters as character no-undo .
       50     do
       51     on error undo, return error return-value
       52     :
       53       if  valid-handle(v-vssrevis-logger)
       54       and v-vssrevis-logger :get-signature("logevent") <> ""
       55       then do:
       56         run vss-get-parameters in this-procedure
       57           (output v-vssrevis-parameters
       58           ).
       59         run logevent in v-vssrevis-logger
       60           (input vss-workfile
       61           ,input vss-revision
       62           ,input v-vssrevis-parameters
       63           ,input p-extra-paramters
       64           ).
       65       end.
       66     end.
       67   end procedure.
       68   assign
       69     v-vssrevis-logger = g#vssrevis-logger
       70   .
       71   if  valid-handle(v-vssrevis-logger)
       72   and v-vssrevis-logger :get-signature("logevent") <> ""
       73   then do:
       74     assign
       75       v-vssrevis-logevent = true
       76     .
       77     run vss-logevent in this-procedure (input vss-description) .
       78   end.
       79   define new global shared variable g#language as character no-undo .
       80   if g#language <> '' and g#language <> 'rus':U then do:
       81     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       82   end.
       83   define new global shared variable g#library  as handle no-undo .
       84   define new global shared variable g#library2 as handle no-undo .
       85   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       86   procedure check-mask-card :
       87   define input parameter p-mask like ub.dis-card.d-card no-undo .
       88   define input parameter p-silence as logical no-undo .
       89   define output parameter p-ok as logical no-undo .
       90   define output parameter p-descr as character no-undo .
       91   define variable v-dec as decimal no-undo.
       92     do
       93     on error undo, return error
       94     :
       95       if length(p-mask) > 19 then do:
       96         assign
       97         p-descr = substitute("Маска &1 имеет длину более 19 символов", p-mask)
       98         .
       99         if not p-silence then do:  message p-descr view-as alert-box error . end.
      100         return.
      101       end.
      102       assign
      103       v-dec = decimal(p-mask)
      104       no-error .
      105       if not error-status:error and round(v-dec, 0) = v-dec and v-dec >= 0 then do:
      106         assign
      107         p-descr = substitute("Маска &1 не может быть числом", p-mask)
      108         .
      109         if not p-silence then do:  message p-descr view-as alert-box error . end.
      110         return.
      111       end.
      112       if index(p-mask, "*":U) > 0
      113       and index(substring(p-mask, index(p-mask, "*") + 1), "*") > 0 then do:
      114         assign
      115         p-descr = substitute("Маска &1 не может содержать более одного символа *", p-mask)
      116         .
      117         if not p-silence then do:  message p-descr view-as alert-box error . end.
      118         return.
      119       end.
      120       if index(p-mask, "*":U) > 0
      121       and index(p-mask, "*":U) <>  Length(p-mask)
      122       then do:
      123         assign
      124         p-descr = substitute("Символ * в маска &1 может стоять только в конце", p-mask)
      125         .
      126         if not p-silence then do:  message p-descr view-as alert-box error . end.
      127         return.
      128       end.
      129       assign
      130       v-dec = decimal(replace(replace(p-mask, chr(63), "0":U), "*":U, "0":U))
      131       no-error .
      132       if not error-status:error
      133       and round(v-dec, 0) = v-dec and v-dec >= 0 then do:
      134         assign
      135         p-ok = yes.
      136         return.
      137       end.
      138       else do:
      139         assign
      140         p-descr = substitute("Маска &1 содержит недопустимые символы - разрешенные символы: 1,2,3,4,5,6,7,8,9,0, * и ?", p-mask)
      141         .
      142         if not p-silence then do:  message p-descr view-as alert-box error . end.
      143         return.
      144       end.
      145     end.
      146   end procedure.
      147   procedure check-cli-mask :
      148   define input parameter p-mask like ub.dis-card-mask.mask no-undo .
      149   define input parameter p-silence as logical no-undo .
      150   define input parameter p-addvalidchars as character no-undo .
      151   define input parameter p-mask-type as character no-undo .
      152   define input parameter p-cc-run as integer no-undo .
      153   define output parameter p-ok as logical no-undo .
      154   define output parameter p-descr as character no-undo .
      155   define variable v-dec as decimal no-undo.
      156   define variable v-dec-dop as character no-undo .
      157   define variable v-old-dop as character no-undo .
      158   define variable ii as integer no-undo .
      159     do
      160     on error undo, return error
      161     :
      162       if length(p-mask) > 19 then do:
      163         assign
      164         p-descr = substitute("Маска &1 имеет длину более 19 символов", p-mask)
      165         .
      166         if not p-silence then do:  message p-descr view-as alert-box error . end.
      167         return.
      168       end.
      169       assign
      170       v-dec = decimal(p-mask)
      171       no-error .
      172       if not error-status:error and round(v-dec, 0) = v-dec and v-dec >= 0 then do:
      173         assign
      174         p-descr = substitute("Маска &1 не может быть числом", p-mask)
      175         .
      176         if not p-silence then do:  message p-descr view-as alert-box error . end.
      177         return.
      178       end.
      179       if index(p-mask, "*":U) > 0
      180       and index(p-addvalidchars, "*") > 0
      181       and index(substring(p-mask, index(p-mask, "*") + 1), "*") > 0 then do:
      182         assign
      183         p-descr = substitute("Маска &1 не может содержать более одного символа *", p-mask)
      184         .
      185         if not p-silence then do:  message p-descr view-as alert-box error . end.
      186         return.
      187       end.
      188       if index(p-addvalidchars, "*") > 0
      189       and index(p-mask, "*":U) > 0
      190       and index(p-mask, "*":U) <>  Length(p-mask)
      191       then do:
      192         assign
      193         p-descr = substitute("Символ * в маске &1 может стоять только в конце", p-mask)
      194         .
      195         if not p-silence then do:  message p-descr view-as alert-box error . end.
      196         return.
      197       end.
      198       assign
      199       v-dec-dop = replace(replace(p-mask, chr(63), "0":U), "*":U, "0":U)
      200       .
      201       do ii = 1 to num-entries(p-addvalidchars):
      202         assign
      203         v-old-dop = v-dec-dop
      204         v-dec-dop = replace(v-dec-dop, entry(ii, p-addvalidchars), "0":U)
      205         .
      206         if p-mask-type = entry(ii, p-addvalidchars)
      207         and (entry(ii, p-addvalidchars) <> 'C':U or p-cc-run > 0)
      208         and v-dec-dop = v-old-dop then do:
      209           assign
      210           p-descr = substitute("Маска &1 должна содержать хотя бы один символ &2", p-mask, p-mask-type)
      211           .
      212           if not p-silence then do:  message p-descr view-as alert-box error . end.
      213           return.
      214         end.
      215       end.
      216       assign
      217       v-dec = decimal(v-dec-dop)
      218       no-error .
      219       if not error-status:error
      220       and round(v-dec, 0) = v-dec and v-dec >= 0 then do:
      221         assign
      222         p-ok = yes.
      223         return.
      224       end.
      225       else do:
      226         assign
      227         p-descr = substitute("Маска &1 содержит недопустимые символы - разрешенные символы: 1,2,3,4,5,6,7,8,9,0,?&2"
      228                             , p-mask
      229                             , (if p-addvalidchars = "":u then "":U else (chr(44) + p-addvalidchars))
      230                             )
      231         .
      232         if not p-silence then do:  message p-descr view-as alert-box error . end.
      233         return.
      234       end.
      235     end.
      236   end procedure.
      237   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      238   define temp-table temp-mask-range no-undo
      239   field mask-original   like ub.dis-card-mask.mask
      240   field mask      like ub.dis-card-mask.mask
      241   field mask-num as integer
      242   field lvl-decompose as integer
      243   field host-code like ub.sysconf.host-code
      244   field obj-type like ub.clients.obj-type
      245   field obj-code like ub.clients.obj-code
      246   field first-code as decimal
      247   field last-code as decimal
      248   field to-check as logical
      249   index pi is unique mask-num lvl-decompose first-code last-code
      250   index iobj to-check first-code last-code host-code obj-type obj-code
      251   .
      252   procedure decompose-mask :
      253   define input parameter p-mask-num  like ub.dis-card-mask.mask-num no-undo .
      254   define input parameter p-mask      like ub.dis-card-mask.mask     no-undo .
      255   define input parameter p-mask-original like ub.dis-card-mask.mask     no-undo .
      256   define input parameter p-lvl-decompose  as integer no-undo .
      257   define input parameter p-host-code like ub.sysconf.host-code      no-undo .
      258   define input parameter p-obj-type  like ub.clients.obj-type       no-undo .
      259   define input parameter p-obj-code  like ub.clients.obj-code       no-undo .
      260   define variable v-ii as integer no-undo .
      261   define variable v-jj as integer no-undo .
      262   define variable v-kk as integer no-undo .
      263   define variable v-max as integer no-undo .
      264   define variable v-mask as character no-undo .
      265   define variable v-mask0 as character no-undo .
      266   define variable v-mask9 as character no-undo .
      267   define variable v-mask-char as character no-undo .
      268   define variable v-dec       as decimal no-undo .
      269     do
      270     on error undo, return error return-value
      271     :
      272       assign
      273       v-mask = p-mask
      274       v-max = length (p-mask).
      275       _do:
      276       do v-ii = 1 to v-max:
      277         assign
      278         v-mask-char = substring(p-mask, v-ii, 1)
      279         .
      280         if v-mask-char = chr(63) then do:
      281           do v-kk = 0 to 9:
      282             create temp-mask-range.
      283             assign
      284             substring(v-mask, v-ii, 1) = string(v-kk)
      285             temp-mask-range.mask     = v-mask
      286             temp-mask-range.mask-original = p-mask-original
      287             temp-mask-range.mask-num = p-mask-num
      288             temp-mask-range.host-code = p-host-code
      289             temp-mask-range.obj-type  = p-obj-type
      290             temp-mask-range.obj-code  = p-obj-code
      291             temp-mask-range.lvl-decompose = p-lvl-decompose + 1
      292             .
      293             assign
      294             v-dec = decimal(v-mask + "." ) no-error .
      295             if not error-status:error then
      296             assign
      297             temp-mask-range.first-code = decimal(v-mask + ".")
      298             temp-mask-range.last-code = decimal(v-mask + ".")
      299             temp-mask-range.to-check  = yes
      300             .
      301             else do:
      302               assign
      303               temp-mask-range.first-code = ?
      304               temp-mask-range.last-code = ?
      305               temp-mask-range.to-check  = no
      306               .
      307             end.
      308           end.
      309         end.
      310         if v-mask-char = "*":U then do:
      311           assign
      312           v-mask =  trim(v-mask, "*":U)
      313           v-mask0 = trim(v-mask, "*":U)
      314           v-mask9 = trim(v-mask, "*":U)
      315           .
      316           do v-jj = 1 to (19 - v-ii + 1) :
      317             create temp-mask-range.
      318             assign
      319             temp-mask-range.mask     = v-mask
      320             temp-mask-range.mask-original = p-mask-original
      321             temp-mask-range.mask-num = p-mask-num
      322             temp-mask-range.host-code = p-host-code
      323             temp-mask-range.obj-type  = p-obj-type
      324             temp-mask-range.obj-code  = p-obj-code
      325             temp-mask-range.lvl-decompose = p-lvl-decompose + 1
      326             v-mask  = v-mask + "0"
      327             v-mask0 = v-mask0 + "0"
      328             v-mask9 = v-mask9 + "9"
      329             .
      330             assign
      331             v-dec = decimal(v-mask0 + ".") no-error .
      332             if not error-status:error then
      333             assign
      334             temp-mask-range.first-code = decimal(v-mask0 + ".":U)
      335             temp-mask-range.last-code = decimal(v-mask9 + ".")
      336             temp-mask-range.to-check  = yes
      337             .
      338           end.
      339         end.
      340       end.
      341       for each temp-mask-range no-lock where
      342               temp-mask-range.mask-num = p-mask-num
      343           AND temp-mask-range.lvl-decompose = p-lvl-decompose + 1:
      344         if index(temp-mask-range.mask, "*":U) > 0 then
      345         run decompose-mask in this-procedure (
      346                                                  input temp-mask-range.mask-num
      347                                                 ,input temp-mask-range.mask
      348                                                 ,input temp-mask-range.mask-original
      349                                                 ,input temp-mask-range.lvl-decompose
      350                                                 ,input temp-mask-range.host-code
      351                                                 ,input temp-mask-range.obj-type
      352                                                 ,input temp-mask-range.obj-code  ).
      353       end.
      354     end.
      355   end procedure.
      356   procedure check-mask-correct-ho-join :
      357   define input parameter p-emitent-host-code like ub.dis-card-mask.emitent-host-code no-undo .
      358   define input parameter p-type              like ub.dis-card-mask.type no-undo .
      359   define input parameter p-new-mask          like ub.dis-card-mask.mask      no-undo .
      360   define input parameter p-new-host-code     like ub.dis-card-mask.host-code no-undo .
      361   define input parameter p-new-obj-type      like ub.dis-card-mask.obj-type  no-undo .
      362   define input parameter p-new-obj-code      like ub.dis-card-mask.obj-code  no-undo .
      363   define output parameter p-is-correct as logical no-undo .
      364   define variable v-found as logical no-undo .
      365   define buffer buf_temp-mask-range for temp-mask-range.
      366   define buffer buf_dis-card-mask for ub.dis-card-mask.
      367     do
      368     on error undo, return error
      369     :
      370       for each temp-mask-range:
      371         delete temp-mask-range.
      372       end.
      373       for each buf_dis-card-mask no-lock where
      374               buf_dis-card-mask.emitent-host-code = p-emitent-host-code
      375           AND buf_dis-card-mask.type = p-type
      376           AND buf_dis-card-mask.stts = integer('0':U)
      377           :
      378         if buf_dis-card-mask.use-on = integer('1':U) then NEXT.
      379         run decompose-mask in this-procedure (
      380                                                  input buf_dis-card-mask.mask-num
      381                                                 ,input buf_dis-card-mask.mask
      382                                                 ,input buf_dis-card-mask.mask
      383                                                 ,input 0
      384                                                 ,input buf_dis-card-mask.host-code
      385                                                 ,input buf_dis-card-mask.obj-type
      386                                                 ,input buf_dis-card-mask.obj-code  ).
      387       end.
      388       if p-new-mask <> "":U then do:
      389         run decompose-mask in this-procedure (
      390                                                  input 0
      391                                                 ,input p-new-mask
      392                                                 ,input p-new-mask
      393                                                 ,input 0
      394                                                 ,input p-new-host-code
      395                                                 ,input p-new-obj-type
      396                                                 ,input p-new-obj-code   ).
      397       end.
      398       for each temp-mask-range no-lock where
      399               temp-mask-range.to-check = yes
      400       break
      401       by temp-mask-range.host-code
      402       by temp-mask-range.obj-type
      403       by temp-mask-range.obj-code:
      404         for each buf_temp-mask-range where
      405                buf_temp-mask-range.to-check = yes
      406            AND
      407                (buf_temp-mask-range.first-code >= temp-mask-range.first-code
      408            AND buf_temp-mask-range.first-code <= temp-mask-range.last-code)
      409            OR
      410                (buf_temp-mask-range.last-code >= temp-mask-range.first-code
      411            AND buf_temp-mask-range.last-code <= temp-mask-range.last-code):
      412           if recid(buf_temp-mask-range) = recid(temp-mask-range) then Next.
      413           if temp-mask-range.host-code <> 0
      414           and (buf_temp-mask-range.host-code = temp-mask-range.host-code
      415           AND buf_temp-mask-range.obj-type = temp-mask-range.obj-type
      416           AND buf_temp-mask-range.obj-code = temp-mask-range.obj-code) then NEXT.
      417           assign
      418           v-found = yes.
      419           return substitute("Могут существовать номера карт, удовлетворяющих маске &1 по фирме &2 объект &3 и маске &4 по фирме &5 объект &6"
      420                              , temp-mask-range.mask-original
      421                              , temp-mask-range.host-code
      422                              , (temp-mask-range.obj-type + string(temp-mask-range.obj-code))
      423                              , buf_temp-mask-range.mask-original
      424                              , buf_temp-mask-range.host-code
      425                              , (buf_temp-mask-range.obj-type + string(buf_temp-mask-range.obj-code))
      426                                 ).
      427         end.
      428       end.
      429       assign
      430       p-is-correct = yes.
      431     end.
      432   end procedure.
      433   define variable v-db-num like ub.db.db-num no-undo .
      434   define variable v-ok as logical no-undo .
      435   define variable v-descr as character no-undo .
      436   define variable dc-ri as recid no-undo .
      437   define variable v-check-by-mask  as character no-undo .
      438   define variable v-type as character no-undo .
      439   define variable v-d-pcnt as decimal no-undo .
      440   define variable v-cash-d-pcnt as decimal no-undo .
      441   define variable v-categ as integer no-undo .
      442   define buffer buf_dis-card-type for ub.dis-card-type.
      443   define buffer buf_dis-card-mask for ub.dis-card-mask.
      444   define buffer buf_dis-card for ub.dis-card.
      445   define buffer buf_sysconf for ub.sysconf.
      446   define buffer buf_clients-obj for ub.clients.
      447   define buffer buf_clients for ub.clients.
      448   define buffer buf_dis-card-mask-attr  for ub.dis-card-mask-attr.
      449   DEFINE TEMP-TABLE tt0-dis-card-property NO-UNDO LIKE ub.dis-card-property.
      450   if p-mode <> 'ДОБАВЛЕНИЕ':U
      451   AND p-mode <> 'ИЗМЕНЕНИЕ':U then do:
      452     message
      453     vss-workfile vss-revision vss-description skip
      454     "Неверный параметр p-mode" p-mode
      455     view-as alert-box error .
      456     return error '':u.
      457   end.
      458   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      459   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
      460     (output v-db-num
      461     )  .
      462   if v-db-num <> 0 then do:
      463     run err-mess in this-procedure ( substitute("Нельзя изменять запись МАСКИ ДИКОНТНОЙ КАРТЫ в УБД: Номер текущей БД &1"
      464                   , v-db-num) ).
      465     undo, return error "":U.
      466   end.
      467   find first buf_dis-card-type no-lock where
      468             buf_dis-card-type.emitent-host-code = p-emitent-host-code
      469        AND buf_dis-card-type.type = p-type  no-error .
      470   if not available buf_dis-card-type then do:
      471     run err-mess  in this-procedure ( substitute("Неправильная ссылка на ТИП ДИСКОНТНОЙ КАРТЫ, код эмитента: &1, тип карты &2"
      472                   , p-emitent-host-code, p-type) ).
      473     undo, return error "type":U.
      474   end.
      475   if p-host-code <> 0 then do:
      476     find first buf_sysconf no-lock where
      477               buf_sysconf.host-code = p-host-code no-error .
      478     if not available buf_sysconf then do:
      479       run err-mess  in this-procedure ( substitute("Неправильная ссылка на ФИРМУ, код фирмы: &1"
      480                     , p-host-code) ).
      481       undo, return error "host-code":U.
      482     end.
      483   end.
      484   if p-obj-type <> "":U or p-obj-code <> 0 then do:
      485     find first buf_clients-obj no-lock where
      486               buf_clients-obj.obj-type = p-obj-type
      487           AND buf_clients-obj.obj-code = p-obj-code no-error .
      488     if not available buf_clients-obj then do:
      489       run err-mess  in this-procedure ( substitute("Неправильная ссылка на ОБЪЕКТ: &1&2"
      490                     , p-obj-type
      491                     , p-obj-code) ).
      492       undo, return error "obj-code":U.
      493     end.
      494   end.
      495   if p-cli-type <> "":U or p-cli-code <> 0 then do:
      496     find first buf_clients no-lock where
      497               buf_clients.obj-type = p-cli-type
      498           AND buf_clients.obj-code = p-cli-code no-error .
      499     if not available buf_clients then do:
      500       run err-mess  in this-procedure ( substitute("Неправильная ссылка на КОНТРАГЕНТА: &1&2"
      501                     , p-cli-type
      502                     , p-cli-code) ).
      503       undo, return error "cli-code":U.
      504     end.
      505   end.
      506   if lookup(string(p-use-on) , '0,1,2':U) = 0 then do:
      507       run err-mess  in this-procedure ( substitute("Неправильное значение поля ИСПОЛЬЗУЮТСЯ НА = &1"
      508                     , p-use-on) ).
      509       undo, return error "use-on":U.
      510   end.
      511   if lookup(string(p-cc-run) , '0,1':U) = 0 then do:
      512       run err-mess  in this-procedure ( substitute("Неправильное значение поля АЛГОРИТМ КЦ = &1"
      513                     , p-cc-run) ).
      514       undo, return error "cc-run":U.
      515   end.
      516   if p-cli-mask <> "":U then do:
      517     if (length(p-cli-mask) <> length(entry(1, p-mask))
      518     and index(p-mask, "*") = 0)
      519     or length(p-cli-mask) < length(entry(1, p-mask))
      520     then do:
      521         run err-mess in this-procedure (substitute("НЕВЕРНАЯ длина маски КОРОТКОГО № &1"
      522                       ,p-cli-mask) ).
      523         undo, return error "mask":U.
      524     end.
      525     run check-cli-mask in this-procedure (
      526                                            input p-cli-mask
      527                                           ,input yes
      528                                           ,input "D,C":U
      529                                           ,input "D":U
      530                                           ,input p-cc-run
      531                                           ,output v-ok
      532                                           ,output v-descr
      533                                           ) no-error .
      534     if error-status:error then do:
      535         run err-mess  in this-procedure ( substitute("Ошибка при проверке маски КОРОТКОГО № &1"
      536                       ,p-cli-mask) ).
      537         undo, return error "mask":U.
      538     end.
      539   end.
      540   if p-mode = 'ДОБАВЛЕНИЕ':U then do:
      541     find first buf_dis-card-mask no-lock where
      542               buf_dis-card-mask.mask-num = p-mask-num no-error.
      543     if available buf_dis-card-mask then do:
      544         run err-mess  in this-procedure ( substitute("Неверно задан номер маски, в БД уже есть маска с номером &1"
      545                       , abs(p-mask-num)
      546                       ) ).
      547         undo, return error "mask-num":U.
      548     end.
      549   end.
      550   if p-mask = "":U then do:
      551       run err-mess in this-procedure ( substitute("Маска карты не может быть пустой"
      552                     ) ).
      553       undo, return error "mask":U.
      554   end.
      555   run check-mask-card in this-procedure (
      556                                           input p-mask
      557                                          ,input yes
      558                                          ,output v-ok
      559                                          ,output v-descr
      560                                         ) no-error .
      561   if error-status:error then do:
      562       run err-mess  in this-procedure ( substitute("Ошибка при проверке маски &1"
      563                     ,p-mask) ).
      564       undo, return error "mask":U.
      565   end.
      566   if not v-ok then do:
      567       run err-mess  in this-procedure ( substitute("Неверная маска &1: &2"
      568                     ,p-mask
      569                     ,v-descr
      570                     ) ).
      571       undo, return error "mask":U.
      572   end.
      573   if p-mode = 'ДОБАВЛЕНИЕ':U then do:
      574     if buf_dis-card-type.check-by-mask = 1 then do:
      575       run check-mask-correct-ho-join in this-procedure (
      576                                                    input p-emitent-host-code
      577                                                   ,input p-type
      578                                                   ,input p-mask
      579                                                   ,input p-host-code
      580                                                   ,input p-obj-type
      581                                                   ,input p-obj-code
      582                                                   ,output v-ok
      583                                                   ) no-error .
      584       if error-status:error then do:
      585         run err-mess  in this-procedure ( substitute("Ввод маски &1 невозможен:&2&3 &4"
      586                                ,p-mask
      587                                , chr(10)
      588                                , error-status:get-message(1)
      589                                , return-value
      590                                ) ).
      591         undo, return error "mask":U.
      592       end.
      593       else do:
      594         if not v-ok then do:
      595           run err-mess  in this-procedure (substitute("Ввод маски &1 невозможен:&2&3"
      596                                ,p-mask
      597                                , chr(10)
      598                                , return-value
      599                                ) ).
      600           undo, return error "mask":U.
      601         end.
      602       end.
      603     end.
      604   end.
      605   _MAIN:
      606   DO ON ERROR UNDO _main, RETURN ERROR
      607   ON STOP UNDO _main, RETURN ERROR:
      608     if p-mode = 'ДОБАВЛЕНИЕ':U then do:
      609       create ub.dis-card-mask.
      610       assign
      611       ub.dis-card-mask.mask-num             =  p-mask-num
      612       p-doc-rec = recid(ub.dis-card-mask)
      613       .
      614     end.
      615     else do:
      616       FIND FIRST ub.dis-card-mask where
      617                 recid(ub.dis-card-mask) = p-doc-rec No-ERROR.
      618       if not available ub.dis-card-mask then do:
      619         message
      620         vss-workfile vss-revision vss-description skip
      621         "Не найдена запись МАСКА ДИСКОНТНОЙ КАРТЫ - p-doc-rec" p-doc-rec
      622         view-as alert-box error .
      623         undo _main, return error '':u.
      624       end.
      625       if ub.dis-card-mask.mask-num <> p-mask-num
      626       then do:
      627         message
      628         vss-workfile vss-revision vss-description skip
      629         "Для уже имеющейся записи нельзя изменить"
      630         "номер маски"
      631         view-as alert-box ERROR.
      632         undo _main, return error '':U.
      633       end.
      634     end.
      635     if can-find(first buf_dis-card-mask no-lock where
      636                       buf_dis-card-mask.rank = p-rank
      637                 AND (p-mode = 'ДОБАВЛЕНИЕ':U
      638                       or recid(buf_dis-card-mask) <> recid(ub.dis-card-mask)
      639                     )
      640                 AND buf_dis-card-mask.stts = integer('0':U)
      641                ) then do:
      642         run err-mess  in this-procedure ( substitute("Уже есть маска с рангом(приоритетом) поиска &1"
      643                       , p-rank
      644                       ) ).
      645         undo _main, return error "mask":U.
      646     end.
      647     if p-cli-code <> 0 then do:
      648       find first buf_dis-card no-lock where
      649                 buf_dis-card.d-card = p-mask  no-error .
      650       if not available buf_dis-card then do:
      651   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      652   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdpcnt in g#library
      653     (
      654      input  buf_dis-card-type.type
      655     ,input  buf_dis-card-type.emitent-host-code
      656     ,input  0
      657     ,input  '':U
      658     ,input  0
      659     ,input  'def-pcnt':U
      660     ,output v-d-pcnt
      661     )  .
      662   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      663   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdpcnt in g#library
      664     (
      665      input  buf_dis-card-type.type
      666     ,input  buf_dis-card-type.emitent-host-code
      667     ,input  0
      668     ,input  '':U
      669     ,input  0
      670     ,input  'def-pcnt':U
      671     ,output v-cash-d-pcnt
      672     )  .
      673   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      674   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdpcnt in g#library
      675     (
      676      input  buf_dis-card-type.type
      677     ,input  buf_dis-card-type.emitent-host-code
      678     ,input  0
      679     ,input  '':U
      680     ,input  0
      681     ,input  'def-categ':U
      682     ,output v-categ
      683     )  .
      684         if v-d-pcnt = ? then do:
      685           v-d-pcnt = 0.
      686         end.
      687         if v-cash-d-pcnt = ? then do:
      688           v-cash-d-pcnt = 0.
      689         end.
      690         if v-categ = ? then do:
      691           v-categ = 0.
      692         end.
      693         run ref/dcardi01.p (
      694                        input parparentproc
      695                       ,input this-procedure
      696                       ,input ?
      697                       ,input ?
      698                       ,input yes
      699                       ,input-output dc-ri
      700                       ,input 'ДОБАВЛЕНИЕ':U
      701                       ,input '':U
      702                       ,input "":U
      703                       ,input 0
      704                       ,input p-mask
      705                       ,input p-emitent-host-code
      706                       ,input p-cli-type
      707                       ,input p-cli-code
      708                       ,input 'тек':U
      709                       ,input p-type
      710                       ,input v-d-pcnt
      711                       ,input v-cash-d-pcnt
      712                       ,input v-categ
      713                       ,input buf_dis-card-type.dflt-d-pcnt-method
      714                       ,input buf_dis-card-type.dflt-credit-card
      715                       ,input buf_dis-card-type.lim-kr
      716                       ,input buf_dis-card-type.dflt-debet-card
      717                       ,input buf_dis-card-type.dflt-staff-card
      718                       ,input today
      719                       ,input (if p-obj-code <> 0 then p-obj-code else 0)
      720                       ,input today
      721                       ,input ?
      722                       ,input "":U
      723                       ,input "":U
      724                       ,input yes
      725                       ,input p-mask
      726                       ,input no
      727                       ,INPUT no
      728                       ,INPUT table tt0-dis-card-property
      729                         ) no-error.
      730         if error-status:error then do:
      731           message
      732           "Ошибка при сохранении записи КАРТЫ-МАСКИ" skip
      733           error-status:get-message(1) skip
      734           return-value
      735           view-as alert-box error .
      736           undo _main, return error 'mask':U.
      737         end.
      738       end.
      739       else do:
      740         if not (buf_dis-card.cli-type  = p-cli-type
      741               AND
      742               buf_dis-card.cli-code  = p-cli-code)
      743         or buf_dis-card.type <> p-type
      744         or buf_dis-card.emitent-host-code <> p-emitent-host-code then do:
      745         assign
      746         dc-ri = recid(buf_dis-card)
      747         .
