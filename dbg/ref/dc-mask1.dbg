      749   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdpcnt in g#library
      750     (
      751      input  buf_dis-card-type.type
      752     ,input  buf_dis-card-type.emitent-host-code
      753     ,input  0
      754     ,input  '':U
      755     ,input  0
      756     ,input  'def-pcnt':U
      757     ,output v-d-pcnt
      758     )  .
      759   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      760   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdpcnt in g#library
      761     (
      762      input  buf_dis-card-type.type
      763     ,input  buf_dis-card-type.emitent-host-code
      764     ,input  0
      765     ,input  '':U
      766     ,input  0
      767     ,input  'def-pcnt':U
      768     ,output v-cash-d-pcnt
      769     )  .
      770   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      771   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdpcnt in g#library
      772     (
      773      input  buf_dis-card-type.type
      774     ,input  buf_dis-card-type.emitent-host-code
      775     ,input  0
      776     ,input  '':U
      777     ,input  0
      778     ,input  'def-categ':U
      779     ,output v-categ
      780     )  .
      781         if v-d-pcnt = ? then do:
      782           v-d-pcnt = 0.
      783         end.
      784         if v-cash-d-pcnt = ? then do:
      785           v-cash-d-pcnt = 0.
      786         end.
      787         if buf_dis-card.category = ? then do:
      788           v-categ = 0.
      789         end.
      790         else do:
      791         v-categ = buf_dis-card.category.
      792         end.
      793         run ref/dcardi01.p (
      794                        input parparentproc
      795                       ,input this-procedure
      796                       ,input ?
      797                       ,input ?
      798                       ,input no
      799                       ,input-output dc-ri
      800                       ,input 'ИЗМЕНЕНИЕ':U
      801                       ,input '':U
      802                       ,input "":U
      803                       ,input 0
      804                       ,input p-mask
      805                       ,input p-emitent-host-code
      806                       ,input p-cli-type
      807                       ,input p-cli-code
      808                       ,input 'тек':U
      809                       ,input p-type
      810                       ,input v-d-pcnt
      811                       ,input v-cash-d-pcnt
      812                       ,input v-categ
      813                       ,input buf_dis-card-type.dflt-d-pcnt-method
      814                       ,input buf_dis-card-type.dflt-credit-card
      815                       ,input buf_dis-card-type.lim-kr
      816                       ,input buf_dis-card-type.dflt-debet-card
      817                       ,input buf_dis-card-type.dflt-staff-card
      818                       ,input today
      819                       ,input (if p-obj-code <> 0 then p-obj-code else 0)
      820                       ,input buf_dis-card.valid-from
      821                       ,input buf_dis-card.valid-date
      822                       ,input "":U
      823                       ,input "":U
      824                       ,input yes
      825                       ,input buf_dis-card.main-card
      826                       ,input no
      827                       ,INPUT no
      828                       ,INPUT table tt0-dis-card-property
      829                         ) no-error.
      830           if error-status:error then do:
      831             undo _main, return error 'mask':U.
      832           end.
      833         end.
      834       end.
      835     end.
      836     assign
      837     ub.dis-card-mask.cli-code             =  p-cli-code
      838     ub.dis-card-mask.cli-mask             =  p-cli-mask
      839     ub.dis-card-mask.cc-run               =  p-cc-run
      840     ub.dis-card-mask.cli-type             =  p-cli-type
      841     ub.dis-card-mask.emitent-host-code    =  p-emitent-host-code
      842     ub.dis-card-mask.host-code            =  p-host-code
      843     ub.dis-card-mask.mask                 =  p-mask
      844     ub.dis-card-mask.use-on               =  p-use-on
      845     ub.dis-card-mask.obj-code             =  p-obj-code
      846     ub.dis-card-mask.obj-type             =  p-obj-type
      847     ub.dis-card-mask.rank                 =  p-rank
      848     ub.dis-card-mask.type                 =  p-type
      849     ub.dis-card-mask.stts                 =  (if p-mode = 'ДОБАВЛЕНИЕ':U
      850                                then integer('0':U)
      851                                else ub.dis-card-mask.stts)
      852     .
      853     release ub.dis-card-mask no-error.
      854     if error-status:error then do:
      855        run err-mess  in this-procedure ( substitute("Ошибка при сохранении записи МАСКИ ДИСКОНТНОЙ КАРТЫ с номером маски &1: &2 -  &3"
      856                                , p-mask-num
      857                                , ERROR-STATUS:GET-message(1)
      858                                , return-value
      859                                )).
      860       undo _main, return error "":U.
      861    end.
      862     find first buf_dis-card-mask-attr exclusive-lock where buf_dis-card-mask-attr.attr-code = "reg-cash" and buf_dis-card-mask-attr.mask-num = p-mask-num no-error .
      863     if available (buf_dis-card-mask-attr) then do:
      864       if p-reg-cash = yes then buf_dis-card-mask-attr.attr-value = "yes" .
      865       else buf_dis-card-mask-attr.attr-value = "no" .
      866     end.
      867     else do:
      868       if p-reg-cash then do:
      869         create buf_dis-card-mask-attr .
      870         assign
      871         buf_dis-card-mask-attr.mask-num   = p-mask-num
      872         buf_dis-card-mask-attr.attr-code  = "reg-cash"
      873         buf_dis-card-mask-attr.attr-value = "yes"
      874         .
      875       end.
      876     end.
      877   end.
      878   PROCEDURE err-mess:
      879     DEFINE INPUT PARAMETER p-mess as character No-UNDO.
      880         message
      881         p-mess
      882         view-as alert-box error .
      883   END PROCEDURE.
