        1   DEFINE INPUT PARAMETER parparentproc AS WIDGET-HANDLE NO-UNDO.
        2   define input parameter p-mode as character no-undo.
        3   define input parameter p-parent as character no-undo.
        4   define input-output parameter p-rid as recid init ? no-undo.
        5   define buffer b3-code for code .
        6   define variable vss-revision    as character no-undo init "$Revision: $":U .
        7   define variable vss-author      as character no-undo init "$Author: $":U .
        8   define variable vss-date        as character no-undo init "$Date: $":U .
        9   define variable vss-workfile    as character no-undo init "$Workfile: $":U .
       10   define variable vss-archive     as character no-undo init "$Archive: $":U .
       11   define variable vss-description as character no-undo init "редактирование параметров".
       12   procedure vss-get-info :
       13     define output parameter p-vss-revision    like vss-revision    no-undo .
       14     define output parameter p-vss-author      like vss-author      no-undo .
       15     define output parameter p-vss-date        like vss-date        no-undo .
       16     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       17     define output parameter p-vss-archive     like vss-archive     no-undo .
       18     define output parameter p-vss-description like vss-description no-undo .
       19     assign
       20       p-vss-revision    = vss-revision
       21       p-vss-author      = vss-author
       22       p-vss-date        = vss-date
       23       p-vss-workfile    = vss-workfile
       24       p-vss-archive     = vss-archive
       25       p-vss-description = vss-description
       26     .
       27   end procedure.
       28   procedure vss-get-parameters :
       29     define output parameter p-vss-parameters as character no-undo .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define new global shared variable g#language as character no-undo .
       67   if g#language <> '' and g#language <> 'rus':U then do:
       68     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       69   end.
       70   define new global shared variable g#library  as handle no-undo .
       71   define new global shared variable g#library2 as handle no-undo .
       72   procedure proc-alt-shift-f2:
       73     if not ibs.th.gbl.gbl-var:rcode
       74   then
       75     run gbl\inidebug.p .
       76   end.
       77   procedure proc-alt-shift-f3:
       78     run gbl/prvssinf.p
       79       ( input this-procedure
       80       ) .
       81   end.
       82   define variable v-inform-launched as logical no-undo initial false .
       83   procedure proc-alt-shift-f4:
       84     define variable v-action as character no-undo .
       85     if v-inform-launched = false then do:
       86       assign
       87         v-inform-launched = true
       88       .
       89       run gbl/d-inform.w
       90         (  input self
       91         ,  input this-procedure
       92         , output v-action
       93         ) no-error .
       94       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       95       assign
       96         v-inform-launched = false
       97       .
       98     end.
       99   end.
      100   procedure proc-alt-f1:
      101     run gbl/corrhelp.p
      102       (input this-procedure
      103       ) .
      104   end .
      105   on alt-shift-f2 anywhere do:
      106     run proc-alt-shift-f2.
      107   end.
      108   on alt-shift-f3 anywhere do:
      109     run proc-alt-shift-f3 in this-procedure .
      110   end.
      111   on alt-shift-f4 anywhere do:
      112     run proc-alt-shift-f4 in this-procedure.
      113   end.
      114   on alt-f1 anywhere do:
      115     run proc-alt-f1 in this-procedure .
      116   end.
      117   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      118   procedure sel-date :
      119     define input  parameter p-date-handle as handle    no-undo .
      120     define input  parameter p-description as character no-undo .
      121     do
      122     on error undo, return error return-value
      123     :
      124       if (can-query (p-date-handle, "sensitive")
      125         and
      126         p-date-handle :sensitive = true
      127         )
      128       or (can-query (p-date-handle, "read-only")
      129         and
      130         p-date-handle :read-only = false
      131         )
      132       then do:
      133         if p-date-handle :handle <> focus :handle
      134         then do:
      135           apply "entry":u to p-date-handle .
      136         end.
      137         define variable v-ok            as logical no-undo .
      138         define variable v-curr-sv-date as date no-undo .
      139         assign
      140           v-curr-sv-date = date(p-date-handle :screen-value) no-error
      141         .
      142         if v-curr-sv-date = ?
      143         then do:
      144           run gbl/getcurdt.p
      145             (output v-curr-sv-date
      146             ) .
      147         end.
      148         if v-curr-sv-date <> ?
      149         then do:
      150           run gbl/d-inpday.w
      151             (input ?
      152             ,input "Выбор даты"
      153             ,input p-description
      154             ,input ""
      155             ,input-output v-curr-sv-date
      156             ,output v-ok
      157             ).
      158           if v-ok = true
      159           then do:
      160             assign
      161               p-date-handle :screen-value = string(v-curr-sv-date) .
      162             .
      163           end.
      164         end.
      165       end.
      166     end.
      167   end procedure.
      168   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      169   function is-numeral return logical
      170     (input p-string   as character ,
      171      input char-avail as character) :
      172     define variable p-replace-string as character no-undo .
      173     define variable log-result       as logical  no-undo .
      174     if p-string = ? then
      175       return false .
      176     p-replace-string = p-string.
      177     if lookup ("*", char-avail) > 0 then
      178         p-replace-string = replace (p-replace-string, '*', '9').
      179     if lookup ("digit", char-avail) > 0 then
      180       assign
      181         p-replace-string = replace (p-replace-string, '0', '9')
      182         p-replace-string = replace (p-replace-string, '1', '9')
      183         p-replace-string = replace (p-replace-string, '2', '9')
      184         p-replace-string = replace (p-replace-string, '3', '9')
      185         p-replace-string = replace (p-replace-string, '4', '9')
      186         p-replace-string = replace (p-replace-string, '5', '9')
      187         p-replace-string = replace (p-replace-string, '6', '9')
      188         p-replace-string = replace (p-replace-string, '7', '9')
      189         p-replace-string = replace (p-replace-string, '8', '9')
      190         .
      191     else
      192        p-replace-string = replace (p-replace-string, '9', chr(15))
      193         .
      194     if lookup ("letter", char-avail) > 0 then
      195       assign
      196         p-replace-string = replace (p-replace-string, 'A', '9')
      197         p-replace-string = replace (p-replace-string, 'B', '9')
      198         p-replace-string = replace (p-replace-string, 'C', '9')
      199         p-replace-string = replace (p-replace-string, 'D', '9')
      200         p-replace-string = replace (p-replace-string, 'E', '9')
      201         p-replace-string = replace (p-replace-string, 'F', '9')
      202         p-replace-string = replace (p-replace-string, 'G', '9')
      203         p-replace-string = replace (p-replace-string, 'H', '9')
      204         p-replace-string = replace (p-replace-string, 'I', '9')
      205         p-replace-string = replace (p-replace-string, 'J', '9')
      206         p-replace-string = replace (p-replace-string, 'K', '9')
      207         p-replace-string = replace (p-replace-string, 'L', '9')
      208         p-replace-string = replace (p-replace-string, 'M', '9')
      209         p-replace-string = replace (p-replace-string, 'N', '9')
      210         p-replace-string = replace (p-replace-string, 'O', '9')
      211         p-replace-string = replace (p-replace-string, 'P', '9')
      212         p-replace-string = replace (p-replace-string, 'Q', '9')
      213         p-replace-string = replace (p-replace-string, 'R', '9')
      214         p-replace-string = replace (p-replace-string, 'S', '9')
      215         p-replace-string = replace (p-replace-string, 'T', '9')
      216         p-replace-string = replace (p-replace-string, 'U', '9')
      217         p-replace-string = replace (p-replace-string, 'V', '9')
      218         p-replace-string = replace (p-replace-string, 'W', '9')
      219         p-replace-string = replace (p-replace-string, 'X', '9')
      220         p-replace-string = replace (p-replace-string, 'Y', '9')
      221         p-replace-string = replace (p-replace-string, 'Z', '9')
      222         p-replace-string = replace (p-replace-string, '_', '9')
      223         .
      224     return p-replace-string = fill ('9', length (p-string)).
      225   end.
      226   define variable v-db-num like ub.db.db-num no-undo .
      227   define variable v-name   as character no-undo .
      228   define variable vDateIsoOld as character no-undo.
      229   define variable mViewDop as logical no-undo.
      230   mViewDop = num-entries (p-parent,chr(4)) eq 2.
      231   DEFINE BUTTON B-Help
      232      LABEL "Помо&щь"
      233      SIZE 10 BY 1
      234      BGCOLOR 8 .
      235   DEFINE BUTTON b-quit AUTO-END-KEY
      236      LABEL "&Отмена"
      237      SIZE 10 BY 1
      238      BGCOLOR 8 .
      239   DEFINE BUTTON B-save AUTO-GO
      240      LABEL "&Ввод"
      241      SIZE 10 BY 1
      242      BGCOLOR 8 .
      243   DEFINE VARIABLE mParentCode   AS character       FORMAT "x(20)":U
      244      LABEL "Группа"
      245      VIEW-AS FILL-IN
      246      SIZE 20 BY 1 NO-UNDO.
      247   DEFINE VARIABLE mCode   AS character       FORMAT "x(20)":U
      248      LABEL "Название параметра"
      249      VIEW-AS FILL-IN
      250      SIZE 20 BY 1 NO-UNDO.
      251   DEFINE VARIABLE mZNACH  AS character    FORMAT "x(40)":U
      252      LABEL "Значение"
      253      VIEW-AS FILL-IN
      254      SIZE 40 BY 1 NO-UNDO.
      255   DEFINE VARIABLE mDecript  AS character    FORMAT "x(4000)":U
      256      LABEL "Описание параметра"
      257      VIEW-AS FILL-IN
      258      SIZE 80 BY 1 NO-UNDO.
      259   DEFINE VARIABLE fStatus AS integer   init '0':U
      260      LABEL "Статус"
      261      VIEW-AS COMBO-BOX INNER-LINES 2
      262      LIST-ITEM-PAIRS "Обязательный",'0':U,
      263      "Необязательный",'1':U
      264      DROP-DOWN-LIST
      265      SIZE 20 BY 1 NO-UNDO.
      266   DEFINE FRAME Dialog-Frame
      267      B-save AT ROW 1 COL 1
      268      b-quit AT ROW 1 COL 11
      269      B-Help AT ROW 1 COL 36
      270      mParentCode AT ROW 2.5 COL 25 COLON-ALIGNED WIDGET-ID 8
      271      mCode AT ROW 4 COL 25 COLON-ALIGNED WIDGET-ID 10
      272      mZNACH AT ROW 5.5 COL 25 COLON-ALIGNED WIDGET-ID 12
      273      mDecript AT ROW 7 COL 25 COLON-ALIGNED WIDGET-ID 14
      274      fStatus AT ROW 8.5 COL 20 COLON-ALIGNED WIDGET-ID 16
      275      WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      276      SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      277      TITLE "Редактирование параметра"
      278      DEFAULT-BUTTON B-save CANCEL-BUTTON b-quit.
      279   ASSIGN
      280      FRAME Dialog-Frame:SCROLLABLE = FALSE
      281      FRAME Dialog-Frame:HIDDEN     = TRUE.
      282   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      283      DO:
      284         APPLY "END-ERROR":U TO SELF.
      285      END.
      286   ON CHOOSE OF B-save IN FRAME Dialog-Frame
      287      DO:
      288         run proc-save in this-procedure no-error.
      289         if error-status:error then return no-apply.
      290      END.
      291   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      292      THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      293   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      294   on help of frame Dialog-Frame
      295   do:
      296     run gbl/app_help.p
      297       (input this-procedure :file-name
      298       ,input ''
      299       ,input ?
      300       ) no-error.
      301     if error-status :error then do:
      302       message
      303         "Ошибка при вызове помощи"
      304         error-status :get-message(1)
      305         view-as alert-box .
      306     end.
      307   end.
      308   run minbtn-set in this-procedure .
      309   on choose of b-help in frame Dialog-Frame
      310   do:
      311     apply "help":u to frame Dialog-Frame .
      312   end.
      313   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      314   procedure minbtn-set :
      315       do
      316           on error undo, return error return-value
      317           :
      318           define variable ii              as integer       no-undo .
      319           define variable fh              as widget-handle no-undo .
      320           define variable hh              as widget-handle no-undo .
      321           define variable v-h             as handle        extent 4 no-undo .
      322           define variable v-name-button   as character     no-undo .
      323           define variable v-help-old-x    as decimal       no-undo .
      324           define variable v-help-old-y    as decimal       no-undo .
      325           define variable v-help-old-size as decimal       no-undo .
      326           define variable v-frame-width   as decimal       no-undo .
      327           define variable jj              as integer       no-undo .
      328           do
      329               on error undo, return error
      330               :
      331               assign
      332                   v-frame-width = frame Dialog-Frame:width - 0.3
      333                   fh            = frame Dialog-Frame:first-child
      334                   hh            = fh:first-child
      335                   ii            = 1
      336                   .
      337               do while valid-handle(hh):
      338                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      339                   do:
      340                       case lc(hh:name) :
      341                           when "b-help" then
      342                               do:
      343                                   hh:load-image-up("cmp/b-help.bmp":u) .
      344                                   hh:load-image-down("cmp/b-help.bmp":u) .
      345                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      346                                   hh:TOOLTIP = "Помощь" .
      347                                   v-help-old-x = hh:column .
      348                                   v-help-old-y = hh:row    .
      349                                   v-help-old-size = hh:width .
      350                                   hh:width-chars = 2.5 .
      351                               end.
      352                           when "b-print" then
      353                               do:
      354                                   hh:load-image("cmp/b-print.bmp":u) .
      355                                   hh:TOOLTIP = "Печать" .
      356                                   v-h[ii] = hh:handle .
      357                                   ii = ii + 1 .
      358                                   hh:width-chars = 3 .
      359                               end.
      360                           when "b-history" or
      361                           when "b-hist" then
      362                               do:
      363                                   hh:load-image("cmp/b-hist.bmp":u) .
      364                                   hh:TOOLTIP = "История" .
      365                                   v-h[ii] = hh:handle .
      366                                   ii = ii + 1 .
      367                                   hh:width-chars = 3 .
      368                               end.
      369                           when "b-sch" then
      370                               do:
      371                                   hh:load-image("cmp/b-sch.bmp":u) .
      372                                   hh:TOOLTIP = "Установка Фильтра" .
      373                                   v-h[ii] = hh:handle .
      374                                   ii = ii + 1 .
      375                                   hh:width-chars = 3 .
      376                               end.
      377                           when "b-hist-user" then
      378                               do:
      379                                   hh:load-image("cmp/b-hist.bmp":u) .
      380                                   hh:TOOLTIP = "История пользователя" .
      381                                   ii = ii + 1 .
      382                               end.
      383                       end case.
      384                   end.
      385                   hh = hh:next-sibling.
      386               end.
      387               b-help:column = v-frame-width - b-help:width-chars.
      388               jj = 0.
      389               repeat ii = 4 to 1 by -1 :
      390                   if valid-handle (v-h[ii] ) then
      391                   do:
      392                       jj  = jj + 1 .
      393                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      394                       v-h[ii]:row    = v-help-old-y .
      395                   end.
      396               end.
      397           end.
      398       end.
      399   end procedure.
      400   MAIN-BLOCK:
      401   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      402      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      403      if p-mode <> 'ДОБАВЛЕНИЕ':U and
      404         p-mode <> 'ИЗМЕНЕНИЕ':U
      405         then
      406      do:
      407         message
      408            vss-workfile vss-revision vss-description skip
      409            "Неверное значение параметров вызова p-mode"  p-mode
      410            view-as alert-box ERROR.
      411         undo, return error.
      412      end.
      413   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      414   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
      415     (output v-db-num
      416     )  .
      417      define variable vparentpar as character no-undo.
      418      define variable vcodepar   as character no-undo.
      419      assign
      420         vparentpar = p-parent
      421         vcodepar   = entry(num-entries (vparentpar,chr(4)),vparentpar,chr(4))
      422         entry(num-entries (vparentpar,chr(4)),vparentpar,chr(4)) = ""
      423         vparentpar = trim(vparentpar,chr(4))
      424      no-error.
      425      if not error-status:error
      426      then do:
      427         find first b3-code where
      428            b3-code.parent  = vparentpar
      429            and b3-code.code    = vcodepar no-lock no-error.
      430         if available b3-code
      431            then
      432         do:
      433            FRAME Dialog-Frame:TITLE = "Редактирование параметра " + b3-code.code + "(" + b3-code.codename + ")".
      434            v-name = b3-code.CodeName .
      435         end.
      436      end.
      437      mParentCode = entry(num-entries (p-parent,chr(4)),p-parent,chr(4)).
      438      if p-mode = 'ИЗМЕНЕНИЕ':U then
      439      do:
      440         find first b3-code where
      441            recid(b3-code) = p-rid exclusive-lock no-wait no-error.
      442         if not available b3-code then
      443         do:
      444            message
      445               vss-workfile vss-revision vss-description skip
      446               "Не найдена запись параметра"
      447               view-as alert-box error .
      448            undo, return error.
      449         end.
      450         assign
      451            mCode    = b3-code.code
      452            mZNACH   = b3-code.CodeValue
      453            mDecript     = b3-code.CodeName
      454            Fstatus  = b3-code.status_
      455            .
      456      end.
      457      run enable_UI in this-procedure .
      458      if p-mode = 'ДОБАВЛЕНИЕ':U then
      459      do:
      460         ENABLE mCode WITH FRAME Dialog-Frame.
      461         apply "entry" to mCode in FRAME Dialog-Frame.
      462      end.
      463      WAIT-FOR GO OF FRAME Dialog-Frame.
      464   END.
      465   session:data-entry-return = no .
      466   RUN disable_UI.
      467   PROCEDURE disable_UI :
      468      HIDE FRAME Dialog-Frame.
      469   END PROCEDURE.
      470   PROCEDURE enable_UI :
      471      DISPLAY mCode mZNACH fStatus mDecript mParentCode
      472         WITH FRAME Dialog-Frame.
      473      ENABLE B-save b-quit B-Help mCode mZNACH fStatus mDecript
      474         WITH FRAME Dialog-Frame.
      475      VIEW FRAME Dialog-Frame.
      476      if mParentCode eq  ""
      477      then ENABLE mParentCode
      478         WITH FRAME Dialog-Frame.
      479   END PROCEDURE.
      480   PROCEDURE proc-save :
      481      define buffer b3-code for code.
      482      define buffer b2-code for code.
      483      assign frame Dialog-Frame
      484         mParentCode
      485         mCode
      486         mZNACH
      487         mDecript
      488         fStatus
      489         .
      490       if mcode = ""
      491       then do:
      492         message "Введите Название параметра ! " view-as  alert-box  error.
      493         apply "entry"  to mcode .
      494         return ERROR.
      495       end.
      496       if not is-numeral (mcode,
      497                      "letter,digit"
      498                      )
      499       then do:
      500         message "Название параметра может содержать латинские буквы и цифры! " view-as  alert-box  error.
      501         apply "entry"  to mcode .
      502         return ERROR.
      503       end.
      504      do on error undo, return error
      505         on stop undo, return error:
      506         entry(num-entries (p-parent,chr(4)),p-parent,chr(4)) = mParentCode.
      507         if mCode eq ?
      508         then do:
      509            message "Код не может быть пустой"
      510            view-as alert-box.
      511            return error.
      512         end.
      513         find first b3-code where
      514            b3-code.parent = p-parent
      515            and b3-code.code   = mcode
      516            and if p-rid eq ? then yes else recid(b3-code) ne p-rid
      517            no-lock no-error.
      518         if avail b3-code then
      519         do:
      520            message
      521               "Уже есть такаой параметр :" mCode
      522               view-as alert-box error .
      523            return error.
      524         end.
      525         find first b3-code where
      526            recid(b3-code) eq p-rid
      527            exclusive-lock no-error.
      528         if not avail b3-code then
      529         do:
      530            create b3-code.
      531         end.
      532         assign
      533            b3-code.parent    = p-parent
      534            b3-code.code      = mcode
      535            b3-code.codevalue = mZNACH
      536            b3-code.CodeName  = mDecript
      537            b3-code.status_   = fStatus
      538            b3-code.nwsgbd    = yes
      539            .
      540         p-rid = recid(b3-code).
      541      end.
      542   END PROCEDURE.
