      995   ON VALUE-CHANGED OF BROWSE-1grp IN FRAME Dialog-Frame
      996   DO:
      997     OPEN QUERY BROWSE-2cli FOR EACH buf_qnty-in-qnty-group OF buf_qnty-group      WHERE ( r-status = 2 OR buf_qnty-in-qnty-group.stts =  r-status )       NO-LOCK INDEXED-REPOSITION.
      998   END.
      999   ON VALUE-CHANGED OF R-status IN FRAME Dialog-Frame
     1000   DO:
     1001       ASSIGN R-status .
     1002     OPEN QUERY BROWSE-1grp FOR EACH buf_qnty-group WHERE   ( r-status = 2 OR buf_qnty-group.stts =  r-status ) and   ( r-find = no or (buf_qnty-group.qgr-db-num = find-db and                     buf_qnty-group.qgr-id = find-id )).
     1003     OPEN QUERY BROWSE-2cli FOR EACH buf_qnty-in-qnty-group OF buf_qnty-group      WHERE ( r-status = 2 OR buf_qnty-in-qnty-group.stts =  r-status )       NO-LOCK INDEXED-REPOSITION.
     1004   END.
     1005   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1006   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1007   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1008   on help of frame Dialog-Frame
     1009   do:
     1010     run gbl/app_help.p
     1011       (input this-procedure :file-name
     1012       ,input ''
     1013       ,input ?
     1014       ) no-error.
     1015     if error-status :error then do:
     1016       message
     1017         "Ошибка при вызове помощи"
     1018         error-status :get-message(1)
     1019         view-as alert-box .
     1020     end.
     1021   end.
     1022   run minbtn-set in this-procedure .
     1023   on choose of b-help in frame Dialog-Frame
     1024   do:
     1025     apply "help":u to frame Dialog-Frame .
     1026   end.
     1027   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1028   procedure minbtn-set :
     1029       do
     1030           on error undo, return error return-value
     1031           :
     1032           define variable ii              as integer       no-undo .
     1033           define variable fh              as widget-handle no-undo .
     1034           define variable hh              as widget-handle no-undo .
     1035           define variable v-h             as handle        extent 4 no-undo .
     1036           define variable v-name-button   as character     no-undo .
     1037           define variable v-help-old-x    as decimal       no-undo .
     1038           define variable v-help-old-y    as decimal       no-undo .
     1039           define variable v-help-old-size as decimal       no-undo .
     1040           define variable v-frame-width   as decimal       no-undo .
     1041           define variable jj              as integer       no-undo .
     1042           do
     1043               on error undo, return error
     1044               :
     1045               assign
     1046                   v-frame-width = frame Dialog-Frame:width - 0.3
     1047                   fh            = frame Dialog-Frame:first-child
     1048                   hh            = fh:first-child
     1049                   ii            = 1
     1050                   .
     1051               do while valid-handle(hh):
     1052                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1053                   do:
     1054                       case lc(hh:name) :
     1055                           when "b-help" then
     1056                               do:
     1057                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1058                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1059                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1060                                   hh:TOOLTIP = "Помощь" .
     1061                                   v-help-old-x = hh:column .
     1062                                   v-help-old-y = hh:row    .
     1063                                   v-help-old-size = hh:width .
     1064                                   hh:width-chars = 2.5 .
     1065                               end.
     1066                           when "b-print" then
     1067                               do:
     1068                                   hh:load-image("cmp/b-print.bmp":u) .
     1069                                   hh:TOOLTIP = "Печать" .
     1070                                   v-h[ii] = hh:handle .
     1071                                   ii = ii + 1 .
     1072                                   hh:width-chars = 3 .
     1073                               end.
     1074                           when "b-history" or
     1075                           when "b-hist" then
     1076                               do:
     1077                                   hh:load-image("cmp/b-hist.bmp":u) .
     1078                                   hh:TOOLTIP = "История" .
     1079                                   v-h[ii] = hh:handle .
     1080                                   ii = ii + 1 .
     1081                                   hh:width-chars = 3 .
     1082                               end.
     1083                           when "b-sch" then
     1084                               do:
     1085                                   hh:load-image("cmp/b-sch.bmp":u) .
     1086                                   hh:TOOLTIP = "Установка Фильтра" .
     1087                                   v-h[ii] = hh:handle .
     1088                                   ii = ii + 1 .
     1089                                   hh:width-chars = 3 .
     1090                               end.
     1091                           when "b-hist-user" then
     1092                               do:
     1093                                   hh:load-image("cmp/b-hist.bmp":u) .
     1094                                   hh:TOOLTIP = "История пользователя" .
     1095                                   ii = ii + 1 .
     1096                               end.
     1097                       end case.
     1098                   end.
     1099                   hh = hh:next-sibling.
     1100               end.
     1101               b-help:column = v-frame-width - b-help:width-chars.
     1102               jj = 0.
     1103               repeat ii = 4 to 1 by -1 :
     1104                   if valid-handle (v-h[ii] ) then
     1105                   do:
     1106                       jj  = jj + 1 .
     1107                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1108                       v-h[ii]:row    = v-help-old-y .
     1109                   end.
     1110               end.
     1111           end.
     1112       end.
     1113   end procedure.
     1114   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1115   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1116   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1117   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1118   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1119   define variable v-diasize-current-frame-height as decimal   no-undo .
     1120   define variable v-diasize-change-size          as logical   no-undo .
     1121   define variable v-diasize-resize-button        as handle    no-undo .
     1122   define variable v-diasize-wndmax               as logical   no-undo .
     1123   define variable v-diasize-wndstore             as logical   no-undo .
     1124   define variable v-diasize-proc-name            as character no-undo .
     1125   define variable v-diasize-browse-handle        as handle    no-undo .
     1126   define variable v-diasize-browse-number        as integer   no-undo .
     1127   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1128   define temp-table temp-diasize-handle no-undo
     1129     field handle-value  as handle
     1130     field save-position as decimal
     1131     index xpk is primary unique handle-value
     1132     .
     1133   define temp-table temp-browse-handle no-undo
     1134     field browse-type   as character
     1135     field browse-number as integer
     1136     field browse-handle as handle
     1137     field original-size as decimal
     1138     index xpk is primary unique browse-type browse-number
     1139     index xie browse-type browse-handle
     1140   .
     1141   procedure diasize_change-height :
     1142     define input  parameter p-change-value  as decimal   no-undo .
     1143     define input  parameter p-move-resize   as logical   no-undo .
     1144     define variable v-field-group-handle    as handle    no-undo .
     1145     define variable v-object-handle         as handle    no-undo .
     1146     define variable v-frame-height          as decimal   no-undo .
     1147     define variable v-frame-virtual-height  as decimal   no-undo .
     1148     define variable v-browse-height         as decimal   no-undo .
     1149     define variable v-window-height         as decimal   no-undo .
     1150     define variable v-window-virtual-height as decimal   no-undo .
     1151     define variable v-change-sign           as integer   no-undo .
     1152     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1153     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1154     if p-change-value > 0
     1155     then do:
     1156       if frame Dialog-Frame :height + p-change-value
     1157           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1158       then do:
     1159         assign
     1160           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1161                           - (frame Dialog-Frame :height-chars)
     1162         .
     1163         if p-change-value <= 0
     1164         then do:
     1165           run diasize_position-resize-button in this-procedure .
     1166           return .
     1167         end.
     1168       end.
     1169     end.
     1170     if p-change-value < 0
     1171     then do:
     1172       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1173       then do:
     1174         assign
     1175           p-change-value = v-diasize-orig-frame-height
     1176                          - (frame Dialog-Frame :height-chars)
     1177         .
     1178         if p-change-value >= 0
     1179         then do:
     1180           run diasize_position-resize-button in this-procedure .
     1181           return .
     1182         end.
     1183       end.
     1184     end.
     1185     if p-change-value >= 0
     1186     then do:
     1187       assign
     1188         v-change-sign = 1
     1189       .
     1190     end.
     1191     else do:
     1192       assign
     1193         v-change-sign = -1
     1194       .
     1195     end.
     1196     assign
     1197       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1198     .
     1199     if p-change-value = 0
     1200     then do:
     1201       run diasize_position-resize-button in this-procedure .
     1202       return .
     1203     end.
     1204     move_block:
     1205     do
     1206     on error undo move_block, retry move_block
     1207     :
     1208       if retry
     1209       then do:
     1210         do
     1211         on error undo move_block, leave move_block
     1212         :
     1213           if p-change-value > 0
     1214           then do:
     1215             for each buf_temp-diasize-handle
     1216             on error undo, next
     1217             :
     1218               assign
     1219                 v-object-handle = buf_temp-diasize-handle.handle-value
     1220               .
     1221               if v-object-handle <> v-diasize-resize-button
     1222               then do:
     1223                 assign
     1224                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1225                 .
     1226               end.
     1227             end.
     1228             assign
     1229               v-diasize-browse-handle :height = v-browse-height
     1230             .
     1231             for each buf_temp-browse-handle
     1232               where buf_temp-browse-handle.browse-type = 'height':u
     1233             on error undo, next
     1234             :
     1235               assign
     1236                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1237               .
     1238             end.
     1239             assign
     1240               frame Dialog-Frame :height = v-frame-height
     1241             .
     1242             if frame Dialog-Frame :scrollable = true
     1243             then do:
     1244               assign
     1245                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1246               .
     1247             end.
     1248             run diasize_position-resize-button in this-procedure .
     1249           end.
     1250           else do:
     1251             if frame Dialog-Frame :scrollable = true
     1252             then do:
     1253               assign
     1254                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1255               .
     1256             end.
     1257             assign
     1258               frame Dialog-Frame :height = v-frame-height
     1259             .
     1260             assign
     1261               v-diasize-browse-handle :height = v-browse-height
     1262             .
     1263             for each buf_temp-browse-handle
     1264               where buf_temp-browse-handle.browse-type = 'height':u
     1265             on error undo, next
     1266             :
     1267               assign
     1268                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1269               .
     1270             end.
     1271             for each buf_temp-diasize-handle
     1272             on error undo, next
     1273             :
     1274               assign
     1275                 v-object-handle = buf_temp-diasize-handle.handle-value
     1276               .
     1277               if v-object-handle <> v-diasize-resize-button
     1278               then do:
     1279                 assign
     1280                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1281                 .
     1282               end.
     1283             end.
     1284             run diasize_position-resize-button in this-procedure .
     1285           end.
     1286           assign
     1287             v-diasize-change-size = false
     1288           .
     1289           leave move_block .
     1290         end.
     1291       end.
     1292       assign
     1293         v-diasize-need-full-display = true
     1294       .
     1295       if v-diasize-change-size = false
     1296       then do:
     1297         assign
     1298           v-diasize-change-size = true
     1299         .
     1300       end.
     1301       else do:
     1302         return .
     1303       end.
     1304       assign
     1305         v-frame-height = frame Dialog-Frame :height
     1306         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1307         v-browse-height = v-diasize-browse-handle :height
     1308       .
     1309       for each buf_temp-browse-handle
     1310         where buf_temp-browse-handle.browse-type = 'height':u
     1311       :
     1312         assign
     1313           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1314         .
     1315       end.
     1316       for each buf_temp-diasize-handle
     1317       :
     1318         delete buf_temp-diasize-handle .
     1319       end.
     1320       assign
     1321         v-field-group-handle = frame Dialog-Frame :first-child
     1322       .
     1323       do while valid-handle(v-field-group-handle)
     1324       :
     1325         assign
     1326           v-object-handle = v-field-group-handle :first-child
     1327         .
     1328         do while valid-handle(v-object-handle)
     1329         :
     1330           if  v-object-handle <> v-diasize-browse-handle :handle
     1331           and can-query(v-object-handle, "row")
     1332           and can-query(v-object-handle, "height")
     1333           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1334           then do:
     1335             find first buf_temp-browse-handle
     1336               where buf_temp-browse-handle.browse-type   = 'height':u
     1337                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1338               no-error .
     1339             if available buf_temp-browse-handle
     1340             then do:
     1341             end.
     1342             else do:
     1343               create buf_temp-diasize-handle .
     1344               assign
     1345                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1346                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1347               .
     1348             end.
     1349           end.
     1350           assign
     1351             v-object-handle = v-object-handle :next-sibling
     1352           .
     1353         end.
     1354         assign
     1355           v-field-group-handle = v-field-group-handle :next-sibling
     1356         .
     1357       end.
     1358       do with frame Dialog-Frame
     1359       :
     1360         hide v-diasize-resize-button .
     1361         assign
     1362           v-diasize-resize-button :row    = 1
     1363           v-diasize-resize-button :column = 1
     1364         .
     1365       end.
     1366       if p-change-value > 0
     1367       then do:
     1368         if frame Dialog-Frame :scrollable = true
     1369         then do:
     1370           assign
     1371             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1372             no-error .
     1373           if error-status :error
     1374           or error-status :get-message(1) <> ""
     1375           then do:
     1376             undo move_block, retry move_block .
     1377           end.
     1378         end.
     1379         assign
     1380           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1381           no-error .
     1382         if error-status :error
     1383         or error-status :get-message(1) <> ""
     1384         then do:
     1385           undo move_block, retry move_block .
     1386         end.
     1387         assign
     1388           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1389           no-error .
     1390         if error-status :error
     1391         or error-status :get-message(1) <> ""
     1392         then do:
     1393           undo move_block, retry move_block .
     1394         end.
     1395         for each buf_temp-browse-handle
     1396           where buf_temp-browse-handle.browse-type = 'height':u
     1397         on error undo move_block, retry move_block
     1398         :
     1399           assign
     1400             buf_temp-browse-handle.browse-handle :height
     1401               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1402             no-error .
     1403           if error-status :error
     1404           or error-status :get-message(1) <> ""
     1405           then do:
     1406             undo move_block, retry move_block .
     1407           end.
     1408         end.
     1409         for each buf_temp-diasize-handle
     1410         on error undo move_block, retry move_block
     1411         :
     1412           assign
     1413             v-object-handle = buf_temp-diasize-handle.handle-value
     1414           .
     1415           if v-object-handle <> v-diasize-resize-button
     1416           then do:
     1417             assign
     1418               v-object-handle :row = v-object-handle :row + p-change-value
     1419               no-error .
     1420             if error-status :error
     1421             or error-status :get-message(1) <> ""
     1422             then do:
     1423               undo move_block, retry move_block .
     1424             end.
     1425           end.
     1426         end.
     1427       end.
     1428       else do:
     1429         for each buf_temp-diasize-handle
     1430         on error undo move_block, retry move_block
     1431         :
     1432           assign
     1433             v-object-handle = buf_temp-diasize-handle.handle-value
     1434           .
     1435           if v-object-handle <> v-diasize-resize-button
     1436           then do:
     1437             assign
     1438               v-object-handle :row = v-object-handle :row + p-change-value
     1439               no-error .
     1440             if error-status :error
     1441             or error-status :get-message(1) <> ""
     1442             then do:
     1443               undo move_block, retry move_block .
     1444             end.
     1445           end.
     1446         end.
     1447         assign
     1448           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1449           no-error .
     1450         if error-status :error
     1451         or error-status :get-message(1) <> ""
     1452         then do:
     1453           undo move_block, retry move_block .
     1454         end.
     1455         for each buf_temp-browse-handle
     1456           where buf_temp-browse-handle.browse-type = 'height':u
     1457         on error undo move_block, retry move_block
     1458         :
     1459           assign
     1460             buf_temp-browse-handle.browse-handle :height
     1461               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1462             no-error .
     1463           if error-status :error
     1464           or error-status :get-message(1) <> ""
     1465           then do:
     1466             undo move_block, retry move_block .
     1467           end.
     1468         end.
     1469         assign
     1470           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1471           no-error .
     1472         if error-status :error
     1473         or error-status :get-message(1) <> ""
     1474         then do:
     1475           undo move_block, retry move_block .
     1476         end.
     1477         if frame Dialog-Frame :scrollable = true
     1478         then do:
     1479           assign
     1480             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1481             no-error .
     1482           if error-status :error
     1483           or error-status :get-message(1) <> ""
     1484           then do:
     1485             undo move_block, retry move_block .
     1486           end.
     1487         end.
     1488       end.
     1489       if p-move-resize = true
     1490       then do:
     1491         run diasize_position-resize-button in this-procedure .
     1492       end.
     1493       if v-diasize-wndstore = true
     1494       then do:
     1495         if connected("ub") = true
     1496         then do:
     1497           define variable v-cntxt-db-num        as integer   no-undo .
     1498           define variable v-cntxt-userid        as character no-undo .
     1499           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1500                                             , OUTPUT v-cntxt-userid
     1501                                             ) .
     1502           run gbl/wndsizew.p
     1503             (input  v-cntxt-db-num
     1504             ,input  v-cntxt-userid
     1505             ,input  v-diasize-proc-name
     1506             ,input  'height':u
     1507             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1508             ) .
     1509         end.
     1510       end.
     1511     end.
     1512     assign
     1513       v-diasize-change-size = false
     1514     .
     1515   end procedure.
     1516   procedure diasize_set-height :
     1517     define input  parameter p-new-height  as decimal   no-undo .
     1518     define input  parameter p-move-resize as logical   no-undo .
     1519     do
     1520     on error undo, return error return-value
     1521     :
     1522       run diasize_change-height in this-procedure
     1523         (input  (p-new-height - frame Dialog-Frame :height)
     1524         ,input  p-move-resize
     1525         ) .
     1526     end.
     1527   end procedure.
     1528   procedure diasize_change-width :
     1529     define input  parameter p-change-value as decimal   no-undo .
     1530     define input  parameter p-move-resize  as logical   no-undo .
     1531     define variable v-field-group-handle   as handle    no-undo .
     1532     define variable v-object-handle        as handle    no-undo .
     1533     define variable v-frame-width          as decimal   no-undo .
     1534     define variable v-frame-virtual-width  as decimal   no-undo .
     1535     define variable v-browse-width         as decimal   no-undo .
     1536     define variable v-window-width         as decimal   no-undo .
     1537     define variable v-window-virtual-width as decimal   no-undo .
     1538     define variable v-change-sign          as integer   no-undo .
     1539     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1540     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1541     if p-change-value > 0
     1542     then do:
     1543       if frame Dialog-Frame :width + p-change-value >
     1544           session :width-chars
     1545       then do:
     1546         assign
     1547           p-change-value = session :width-chars - frame Dialog-Frame :width
     1548         .
     1549         if p-change-value <= 0
     1550         then do:
     1551           run diasize_position-resize-button in this-procedure .
     1552           return .
     1553         end.
     1554       end.
     1555     end.
     1556     if p-change-value < 0
     1557     then do:
     1558       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1559       then do:
     1560         assign
     1561           p-change-value = v-diasize-orig-frame-width
     1562                          - frame Dialog-Frame :width
     1563         .
     1564         if p-change-value >= 0
     1565         then do:
     1566           run diasize_position-resize-button in this-procedure .
     1567           return .
     1568         end.
     1569       end.
     1570     end.
     1571     if p-change-value >= 0
     1572     then do:
     1573       assign
     1574         v-change-sign = 1
     1575       .
     1576     end.
     1577     else do:
     1578       assign
     1579         v-change-sign = -1
     1580       .
     1581     end.
     1582     assign
     1583       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1584     .
     1585     if p-change-value = 0
     1586     then do:
     1587       run diasize_position-resize-button in this-procedure .
     1588       return .
     1589     end.
     1590     move_block:
     1591     do
     1592     on error undo move_block, leave move_block
     1593     :
     1594       if retry
     1595       then do:
     1596         do
     1597         on error undo move_block, leave move_block
     1598         :
     1599           if p-change-value > 0
     1600           then do:
     1601             for each buf_temp-diasize-handle
     1602             on error undo, next
     1603             :
     1604               assign
     1605                 v-object-handle = buf_temp-diasize-handle.handle-value
     1606               .
     1607               if v-object-handle <> v-diasize-resize-button
     1608               then do:
     1609                 assign
     1610                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1611                 .
     1612               end.
     1613             end.
     1614             assign
     1615               v-diasize-browse-handle :width = v-browse-width
     1616             .
     1617             for each buf_temp-browse-handle
     1618               where buf_temp-browse-handle.browse-type = 'width':u
     1619             on error undo, next
     1620             :
     1621               assign
     1622                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1623               .
     1624             end.
     1625             assign
     1626               frame Dialog-Frame :width = v-frame-width
     1627             .
     1628             if frame Dialog-Frame :scrollable = true
     1629             then do:
     1630               assign
     1631                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1632               .
     1633             end.
     1634             run diasize_position-resize-button in this-procedure .
     1635           end.
     1636           else do:
     1637             if frame Dialog-Frame :scrollable = true
     1638             then do:
     1639               assign
     1640                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1641               .
     1642             end.
     1643             assign
     1644               frame Dialog-Frame :width = v-frame-width
     1645             .
     1646             for each buf_temp-browse-handle
     1647               where buf_temp-browse-handle.browse-type = 'width':u
     1648             on error undo, next
     1649             :
     1650               assign
     1651                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1652               .
     1653             end.
     1654             assign
     1655               v-diasize-browse-handle :width = v-browse-width
     1656             .
     1657             for each buf_temp-diasize-handle
     1658             on error undo, next
     1659             :
     1660               assign
     1661                 v-object-handle = buf_temp-diasize-handle.handle-value
     1662               .
     1663               if v-object-handle <> v-diasize-resize-button
     1664               then do:
     1665                 assign
     1666                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1667                 .
     1668               end.
     1669             end.
     1670             run diasize_position-resize-button in this-procedure .
     1671           end.
     1672           assign
     1673             v-diasize-change-size = false
     1674           .
     1675           leave move_block .
     1676         end.
     1677       end.
     1678       assign
     1679         v-diasize-need-full-display = true
     1680       .
     1681       if v-diasize-change-size = false
     1682       then do:
     1683         assign
     1684           v-diasize-change-size = true
     1685         .
     1686       end.
     1687       else do:
     1688         return .
     1689       end.
     1690       assign
     1691         v-frame-width = frame Dialog-Frame :width
     1692         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1693         v-browse-width = v-diasize-browse-handle :width
     1694       .
     1695       for each buf_temp-browse-handle
     1696         where buf_temp-browse-handle.browse-type = 'width':u
     1697       :
     1698         assign
     1699           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1700         .
     1701       end.
     1702       for each buf_temp-diasize-handle
     1703       :
     1704         delete buf_temp-diasize-handle .
     1705       end.
     1706       assign
     1707         v-field-group-handle = frame Dialog-Frame :first-child
     1708       .
     1709       do while valid-handle(v-field-group-handle)
     1710       :
     1711         assign
     1712           v-object-handle = v-field-group-handle :first-child
     1713         .
     1714         do while valid-handle(v-object-handle)
     1715         :
     1716           if  v-object-handle <> v-diasize-browse-handle :handle
     1717           and v-object-handle <> v-diasize-resize-button
     1718           and can-query(v-object-handle, "row")
     1719           and can-query(v-object-handle, "height")
     1720           and ( v-object-handle :col + v-object-handle :width
     1721                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1722               )
     1723           then do:
     1724             find first buf_temp-browse-handle
     1725               where buf_temp-browse-handle.browse-type   = 'width':u
     1726                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1727               no-error .
     1728             if available buf_temp-browse-handle
     1729             then do:
     1730             end.
     1731             else do:
     1732               create buf_temp-diasize-handle .
     1733               assign
     1734                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1735                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1736               .
     1737             end.
     1738           end.
     1739           assign
     1740             v-object-handle = v-object-handle :next-sibling
     1741           .
     1742         end.
     1743         assign
     1744           v-field-group-handle = v-field-group-handle :next-sibling
     1745         .
     1746       end.
     1747       do with frame Dialog-Frame
     1748       :
     1749         hide v-diasize-resize-button .
     1750         v-diasize-resize-button :row = 1.
     1751         v-diasize-resize-button :column = 1.
     1752       end.
     1753       if p-change-value > 0
     1754       then do:
     1755         if frame Dialog-Frame :scrollable = true
     1756         then do:
     1757           assign
     1758             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1759             no-error .
     1760           if error-status :error
     1761           or error-status :get-message(1) <> ""
     1762           then do:
     1763             undo move_block, retry move_block.
     1764           end.
     1765         end.
     1766         assign
     1767           frame Dialog-Frame :width = v-frame-width + p-change-value
     1768           no-error .
     1769         if error-status :error
     1770         or error-status :get-message(1) <> ""
     1771         then do:
     1772           undo move_block, retry move_block.
     1773         end.
     1774         assign
     1775           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1776         no-error .
     1777         if error-status :error
     1778         or error-status :get-message(1) <> ""
     1779         then do:
     1780           undo move_block, retry move_block.
     1781         end.
     1782         for each buf_temp-browse-handle
     1783           where buf_temp-browse-handle.browse-type = 'width':u
     1784         on error undo move_block, retry move_block
     1785         :
     1786           assign
     1787             buf_temp-browse-handle.browse-handle :width
     1788               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1789             no-error .
     1790           if error-status :error
     1791           or error-status :get-message(1) <> ""
     1792           then do:
     1793             undo move_block, retry move_block .
     1794           end.
     1795         end.
     1796         for each buf_temp-diasize-handle
     1797         on error undo move_block, retry move_block
     1798         :
     1799           assign
     1800             v-object-handle = buf_temp-diasize-handle.handle-value
     1801           .
     1802           if v-object-handle <> v-diasize-resize-button
     1803           then do:
     1804             assign
     1805               v-object-handle :col = v-object-handle :col + p-change-value
     1806               no-error .
     1807             if error-status :error
     1808             or error-status :get-message(1) <> ""
     1809             then do:
     1810               undo move_block, retry move_block .
     1811             end.
     1812           end.
     1813         end.
     1814       end.
     1815       else do:
     1816         for each buf_temp-diasize-handle
     1817         on error undo move_block, retry move_block
     1818         :
     1819           assign
     1820             v-object-handle = buf_temp-diasize-handle.handle-value
     1821           .
     1822           if v-object-handle <> v-diasize-resize-button
     1823           then do:
     1824             assign
     1825               v-object-handle :col = v-object-handle :col + p-change-value
     1826               no-error .
     1827             if error-status :error
     1828             or error-status :get-message(1) <> ""
     1829             then do:
     1830               undo move_block, retry move_block .
     1831             end.
     1832           end.
     1833         end.
     1834         for each buf_temp-browse-handle
     1835           where buf_temp-browse-handle.browse-type = 'width':u
     1836         on error undo move_block, retry move_block
     1837         :
     1838           assign
     1839             buf_temp-browse-handle.browse-handle :width
     1840               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1841             no-error .
     1842           if error-status :error
     1843           or error-status :get-message(1) <> ""
     1844           then do:
     1845             undo move_block, retry move_block .
     1846           end.
     1847         end.
     1848         assign
     1849           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1850           no-error .
     1851         if error-status :error
     1852         or error-status :get-message(1) <> ""
     1853         then do:
     1854           undo move_block, retry move_block.
     1855         end.
     1856         assign
     1857           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1858         no-error .
     1859         if error-status :error
     1860         or error-status :get-message(1) <> ""
     1861         then do:
     1862           undo move_block, retry move_block.
     1863         end.
     1864         if frame Dialog-Frame :scrollable = true
     1865         then do:
     1866           assign
     1867             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1868           no-error .
     1869           if error-status :error
     1870           or error-status :get-message(1) <> ""
     1871           then do:
     1872             undo move_block, retry move_block.
     1873           end.
     1874         end.
     1875       end.
     1876       if p-move-resize
     1877       then do:
     1878         run diasize_position-resize-button in this-procedure .
     1879       end.
     1880       if v-diasize-wndstore = true
     1881       then do:
     1882         if connected("ub") = true
     1883         then do:
     1884           define variable v-cntxt-db-num        as integer   no-undo .
     1885           define variable v-cntxt-userid        as character no-undo .
     1886           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1887                                             , OUTPUT v-cntxt-userid
     1888                                             ) .
     1889           run gbl/wndsizew.p
     1890             (input  v-cntxt-db-num
     1891             ,input  v-cntxt-userid
     1892             ,input  v-diasize-proc-name
     1893             ,input  'width':u
     1894             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1895             ) .
     1896         end.
     1897       end.
     1898     end.
     1899     assign
     1900       v-diasize-change-size = false
     1901     .
     1902   end procedure.
     1903   procedure diasize_set-width :
     1904     define input  parameter p-new-width  as decimal   no-undo .
     1905     define input  parameter p-move-resize as logical   no-undo .
     1906     do
     1907     on error undo, return error return-value
     1908     :
     1909       run diasize_change-width in this-procedure
     1910         (input  (p-new-width - frame Dialog-Frame :width)
     1911         ,input  p-move-resize
     1912         ) .
     1913     end.
     1914   end procedure.
     1915   procedure diasize_position-resize-button :
     1916     do with frame Dialog-Frame
     1917     :
     1918       hide v-diasize-resize-button .
     1919       assign
     1920         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1921                     - 1
     1922                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1923         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1924                     - 1
     1925                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1926       .
     1927       view v-diasize-resize-button .
     1928     end.
     1929   end procedure.
     1930   on alt-right anywhere
     1931   do:
     1932     run diasize_change-width in this-procedure
     1933       (input 1
     1934       ,input true
     1935       ) .
     1936     return no-apply .
     1937   end.
     1938   on alt-left anywhere
     1939   do:
     1940     run diasize_change-width in this-procedure
     1941       (input -1
     1942       ,input true
     1943       ) .
     1944     return no-apply .
     1945   end.
     1946   on alt-down anywhere
     1947   do:
     1948     run diasize_change-height in this-procedure
     1949       (input 1
     1950       ,input true
     1951       ) .
     1952     return no-apply .
     1953   end.
     1954   on alt-up anywhere
     1955   do:
     1956     run diasize_change-height in this-procedure
     1957       (input -1
     1958       ,input true
     1959       ) .
     1960     return no-apply .
     1961   end.
     1962   on alt-enter of frame Dialog-Frame
     1963   do:
     1964     run diasize_maximize in this-procedure
     1965       (input  ?
     1966       ).
     1967     return no-apply .
     1968   end.
     1969   procedure diasize_end-move :
     1970     do
     1971     on error undo, return error return-value
     1972     :
     1973       define variable v-row-delta as decimal   no-undo .
     1974       define variable v-col-delta as decimal   no-undo .
     1975       define variable v-new-row as decimal   no-undo .
     1976       define variable v-new-col as decimal   no-undo .
     1977       assign
     1978         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1979         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1980       .
     1981       assign
     1982         v-row-delta = v-new-row - frame Dialog-Frame :height
     1983         v-col-delta = v-new-col - frame Dialog-Frame :width
     1984       .
     1985       run diasize_change-height in this-procedure
     1986         (input v-row-delta
     1987         ,input true
     1988         ) .
     1989       run diasize_change-width in this-procedure
     1990         (input v-col-delta
     1991         ,input true
     1992         ) .
     1993     end.
     1994   end procedure.
     1995   procedure diasize_maximize :
     1996     define input  parameter p-action as logical   no-undo .
     1997     do
     1998     on error undo, return error return-value
     1999     :
     2000       if p-action = ?
     2001       then do:
     2002         if v-diasize-need-maximize = true
     2003         then do:
     2004           assign
     2005             p-action = true
     2006           .
     2007         end.
     2008         else do:
     2009           assign
     2010             p-action = false
     2011           .
     2012         end.
     2013       end.
     2014       if p-action = true
     2015       then do:
     2016         run diasize_change-height in this-procedure
     2017           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2018               - frame Dialog-Frame :height-chars
     2019           ,input true
     2020           ) .
     2021         run diasize_change-width in this-procedure
     2022           (input session :width-chars
     2023               - frame Dialog-Frame :width-chars
     2024           ,input true
     2025           ) .
     2026         assign
     2027           v-diasize-need-maximize = false
     2028         .
     2029       end.
     2030       else do:
     2031         run diasize_change-width in this-procedure
     2032           (input v-diasize-orig-frame-width
     2033               - frame Dialog-Frame :width-chars
     2034           ,input true
     2035           ) .
     2036         run diasize_change-height in this-procedure
     2037           (input v-diasize-orig-frame-height
     2038               - frame Dialog-Frame :height-chars
     2039           ,input true
     2040           ) .
     2041         assign
     2042           v-diasize-need-maximize = true
     2043         .
     2044       end.
     2045     end.
     2046   end procedure.
     2047   procedure diasize_restore-orig-size :
     2048     do
     2049     on error undo, return error return-value
     2050     :
     2051       assign
     2052         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2053         v-diasize-current-frame-height = frame Dialog-Frame :height
     2054       .
     2055       run diasize_set-height in this-procedure
     2056         (input  v-diasize-orig-frame-height
     2057         ,input  true
     2058         ) .
     2059       run diasize_set-width in this-procedure
     2060         (input  v-diasize-orig-frame-width
     2061         ,input  true
     2062         ) .
     2063     end.
     2064   end procedure.
     2065   procedure diasize_restore-current-size :
     2066     do
     2067     on error undo, return error return-value
     2068     :
     2069       run diasize_set-height in this-procedure
     2070         (input  v-diasize-current-frame-height
     2071         ,input  true
     2072         ) .
     2073       run diasize_set-width in this-procedure
     2074         (input  v-diasize-current-frame-width
     2075         ,input  true
     2076         ) .
     2077     end.
     2078   end procedure.
     2079   procedure diasize_set-browse-handle :
     2080     define input  parameter p-browse-handle as handle   no-undo .
     2081     define buffer buf_temp-browse-handle for temp-browse-handle .
     2082     do
     2083     on error undo, return error return-value
     2084     :
     2085       assign
     2086         v-diasize-browse-handle = p-browse-handle
     2087       .
     2088       for each buf_temp-browse-handle
     2089       on error undo, return error return-value
     2090       :
     2091         delete buf_temp-browse-handle .
     2092       end.
     2093     end.
     2094   end procedure.
     2095   procedure diasize_add_browse :
     2096     define input  parameter p-browse-type   as character no-undo .
     2097     define input  parameter p-browse-handle as handle    no-undo .
     2098     define buffer buf_temp-browse-handle for temp-browse-handle .
     2099     do
     2100     on error undo, return error return-value
     2101     :
     2102       assign
     2103         v-diasize-browse-number = v-diasize-browse-number + 1
     2104       .
     2105       create buf_temp-browse-handle .
     2106       assign
     2107         buf_temp-browse-handle.browse-type   = p-browse-type
     2108         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2109         buf_temp-browse-handle.browse-handle = p-browse-handle
     2110       .
     2111     end.
     2112   end procedure.
     2113   procedure diasize_init :
     2114     define variable v-default-value    as logical   no-undo .
     2115     define variable v-restore-saved    as logical   no-undo .
     2116     define variable v-resize-value-str as character no-undo .
     2117     do
     2118     on error undo, return error return-value
     2119     :
     2120       do with frame Dialog-Frame
     2121       :
     2122         assign
     2123           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2124           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2125           v-diasize-browse-handle     = browse browse-1grp :handle
     2126         .
     2127         create button v-diasize-resize-button
     2128         assign
     2129           parent        = frame Dialog-Frame :first-child
     2130           label         = "s"
     2131           height-pixels = 16
     2132           width-pixels  = 16
     2133           visible       = true
     2134           sensitive     = true
     2135           movable       = true
     2136           triggers:
     2137             on end-move persistent run diasize_end-move in this-procedure .
     2138           end triggers.
     2139         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2140         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2141         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2142         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2143         assign
     2144           v-diasize-wndmax = false
     2145         .
     2146         if connected("ub") = true
     2147         then do:
     2148           define variable v-cntxt-db-num        as integer   no-undo .
     2149           define variable v-cntxt-userid        as character no-undo .
     2150           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2151                                             , OUTPUT v-cntxt-userid
     2152                                             ) .
     2153           run gbl/wndpar_r.p
     2154             (input  v-cntxt-db-num
     2155             ,input  v-cntxt-userid
     2156             ,input  'wndmax':U
     2157             ,output v-diasize-wndmax
     2158             ,output v-default-value
     2159             ) .
     2160         end.
     2161         assign
     2162           v-diasize-wndstore = false
     2163         .
     2164         if connected("ub") = true
     2165         then do:
     2166           run gbl/wndpar_r.p
     2167             (input  v-cntxt-db-num
     2168             ,input  v-cntxt-userid
     2169             ,input  'wndstore':U
     2170             ,output v-diasize-wndstore
     2171             ,output v-default-value
     2172             ) .
     2173         end.
     2174         assign
     2175           v-diasize-proc-name = entry(1, program-name(2), '.')
     2176         .
     2177         if v-diasize-wndstore = true
     2178         then do:
     2179           assign
     2180             v-restore-saved = false
     2181           .
     2182           if connected("ub") = true
     2183           then do:
     2184             run gbl/wndsizer.p
     2185               (input  v-cntxt-db-num
     2186               ,input  v-cntxt-userid
     2187               ,input  v-diasize-proc-name
     2188               ,input  'height':u
     2189               ,output v-resize-value-str
     2190               ) .
     2191             if v-resize-value-str <> '':U
     2192             then do:
     2193               run diasize_change-height in this-procedure
     2194                 (input  integer(v-resize-value-str)
     2195                 ,input  true
     2196                 ) .
     2197               assign
     2198                 v-restore-saved = true
     2199               .
     2200             end.
     2201           end.
     2202           if connected("ub") = true
     2203           then do:
     2204             run gbl/wndsizer.p
     2205               (input  v-cntxt-db-num
     2206               ,input  v-cntxt-userid
     2207               ,input  v-diasize-proc-name
     2208               ,input  'width':u
     2209               ,output v-resize-value-str
     2210               ) .
     2211             if v-resize-value-str <> '':U
     2212             then do:
     2213               run diasize_change-width in this-procedure
     2214                 (input  integer(v-resize-value-str)
     2215                 ,input  true
     2216                 ) .
     2217               assign
     2218                 v-restore-saved = true
     2219               .
     2220             end.
     2221           end.
     2222           if v-restore-saved <> true
     2223           then do:
     2224             if v-diasize-wndmax = true
     2225             then do:
     2226               run diasize_maximize in this-procedure
     2227                 (input  true
     2228                 ) .
     2229             end.
     2230           end.
     2231         end.
     2232         else do:
     2233           if v-diasize-wndmax = true
     2234           then do:
     2235             run diasize_maximize in this-procedure
     2236               (input  true
     2237               ) .
     2238           end.
     2239         end.
     2240       end.
     2241     end.
     2242   end procedure.
     2243   procedure diasize_need-full-display :
     2244     define output parameter p-need-full-display as logical   no-undo .
     2245     do
     2246     on error undo, return error return-value
     2247     :
     2248       assign
     2249         p-need-full-display = v-diasize-need-full-display
     2250       .
     2251       assign
     2252         v-diasize-need-full-display = false
     2253       .
     2254     end.
     2255   end procedure.
     2256   procedure get-context :
     2257      define output parameter p-db-num as integer          no-undo.
     2258      define output parameter p-user-id as character        no-undo.
     2259      define variable v-login               as character    no-undo.
     2260      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2261      define buffer buf_user-login  for ub.user-login .
     2262      do
     2263      on error undo, return error
     2264      :
     2265            FIND FIRST buf_sys-ctrl no-lock.
     2266            ASSIGN
     2267               v-login = USERID("ub")
     2268               p-db-num = buf_sys-ctrl.db-num
     2269            .
     2270            FIND FIRST buf_user-login
     2271                 WHERE buf_user-login.db-num = p-db-num
     2272                   AND buf_user-login.user-login = v-login
     2273                 no-lock
     2274                 no-error
     2275                 .
     2276            IF AVAILABLE buf_user-login
     2277            THEN DO:
     2278               assign
     2279                  p-user-id = buf_user-login.user-id
     2280               .
     2281            END.
     2282      end.
     2283   end procedure.
     2284   run diasize_add_browse in this-procedure
     2285     (input  'HEIGHT':U
     2286     ,input  browse browse-2cli :handle
     2287     ) .
     2288   run diasize_init in this-procedure .
     2289   MAIN-BLOCK:
     2290   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2291      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2292      define variable g#log as logical   no-undo .
     2293   define variable vss-include-info18 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2294   do:
     2295     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     2296       (input  v-cntxt-db-num
     2297       ,input  v-cntxt-userid
     2298       ,input  0
     2299       ,input  'actn_ref-mpl_lookup':U
     2300       ,input  'global':U
     2301       ,input  v-cntxt-host-code-obj
     2302       ,input  v-cntxt-obj-type
     2303       ,input  v-cntxt-obj-code
     2304       ,input  0
     2305       ,input  0
     2306       ,input  0
     2307       ,input  true
     2308       ,output g#log
     2309       )  .
     2310   end.
     2311     if not g#log then return .
     2312      buf_qnty-group.name:resizable in browse browse-1grp = true .
     2313      buf_qnty-group.name:width  in browse browse-1grp = 20 .
     2314     if p-rec-list <> "" and p-rec-list <> ? then run select_one .
     2315     RUN enable_UI.
     2316     disable
     2317        B-sel      when LOOKUP ("b-sel":U,    p-bttns) = 0
     2318        B-add      when LOOKUP ("b-add":U,    p-bttns) = 0
     2319        B-chg      when LOOKUP ("b-chg":U,    p-bttns) = 0
     2320        B-del      when LOOKUP ("b-del":U,    p-bttns) = 0
     2321        B-add-2    when LOOKUP ("b-add":U,    p-bttns) = 0
     2322        B-chg-2    when LOOKUP ("b-chg":U,    p-bttns) = 0
     2323        B-del-2    when LOOKUP ("b-del":U,    p-bttns) = 0
     2324        B-mark     when LOOKUP ("b-mark":U,   p-bttns) = 0
     2325        B-mark-2   when LOOKUP ("b-mark-2":U, p-bttns) = 0
     2326       with frame Dialog-Frame .
     2327     WAIT-FOR GO OF FRAME Dialog-Frame.
     2328   END.
     2329   RUN disable_UI.
     2330   PROCEDURE disable_UI :
     2331     HIDE FRAME Dialog-Frame.
     2332   END PROCEDURE.
     2333   PROCEDURE enable_UI :
     2334     DISPLAY R-status FILL-IN-1
     2335         WITH FRAME Dialog-Frame.
     2336     ENABLE B-Cancel B-sel B-add B-chg B-del B-history B-Help B-print R-status
     2337            B-mark-2 B-add-2 B-chg-2 B-del-2 B-mark BROWSE-1grp BROWSE-2cli
     2338            FILL-IN-1
     2339         WITH FRAME Dialog-Frame.
     2340     VIEW FRAME Dialog-Frame.
     2341     OPEN QUERY BROWSE-1grp FOR EACH buf_qnty-group WHERE   ( r-status = 2 OR buf_qnty-group.stts =  r-status ) and   ( r-find = no or (buf_qnty-group.qgr-db-num = find-db and                     buf_qnty-group.qgr-id = find-id )).    OPEN QUERY BROWSE-2cli FOR EACH buf_qnty-in-qnty-group OF buf_qnty-group      WHERE ( r-status = 2 OR buf_qnty-in-qnty-group.stts =  r-status )       NO-LOCK INDEXED-REPOSITION.
     2342   END PROCEDURE.
     2343   PROCEDURE select_one :
     2344   define buffer bufl_qnty-group for ub.qnty-group  .
     2345   find first bufl_qnty-group no-lock where recid(bufl_qnty-group) = int(p-rec-list) no-error .
     2346   if error-status :error then return .
     2347   r-find = true .
     2348   find-db = bufl_qnty-group.qgr-db-num  .
     2349   find-id = bufl_qnty-group.qgr-id      .
     2350   END PROCEDURE.
