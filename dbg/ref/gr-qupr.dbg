      723       ,output g#log
      724       )  .
      725   end.
      726     if not g#log then return .
      727   define variable v-rec-id as recid no-undo .
      728   if not available buf_qnty-group then return .
      729   if v-cntxt-db-num <> 0 then do :
      730      if buf_qnty-group.qgr-db-num <> v-cntxt-db-num then do:
      731         message substitute(" Группа создана в другой БД (&1) , корректировать ее в текущей БД нельзя !" , buf_qnty-group.qgr-db-num ) .
      732         return .
      733      end.
      734   end.
      735   if buf_qnty-group.stts <> 0 then do:
      736      message "В эту группу добавлять количества нельзя!" view-as alert-box error .
      737      return .
      738   end.
      739     run ref/gr-quprb.w (
