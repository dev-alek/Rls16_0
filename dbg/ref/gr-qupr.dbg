        1   DEFINE NEW SHARED BUFFER buf_qnty-group FOR ub.qnty-group.
        2   DEFINE BUFFER buf_qnty-in-qnty-group FOR ub.qnty-in-qnty-group.
        3   define input  parameter parParentProc as handle no-undo .
        4   define input  parameter p-bttns as character no-undo .
        5   define input-output parameter p-rec-list as character no-undo .
        6   define variable vss-revision    as character no-undo init "$Revision$":U .
        7   define variable vss-author      as character no-undo init "$Author$":U .
        8   define variable vss-date        as character no-undo init "$Date$":U .
        9   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       10   define variable vss-archive     as character no-undo init "$Archive$":U .
       11   define variable vss-description as character no-undo init "Справочник количественных групп для ценообразования".
       12   procedure vss-get-info :
       13     define output parameter p-vss-revision    like vss-revision    no-undo .
       14     define output parameter p-vss-author      like vss-author      no-undo .
       15     define output parameter p-vss-date        like vss-date        no-undo .
       16     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       17     define output parameter p-vss-archive     like vss-archive     no-undo .
       18     define output parameter p-vss-description like vss-description no-undo .
       19     assign
       20       p-vss-revision    = vss-revision
       21       p-vss-author      = vss-author
       22       p-vss-date        = vss-date
       23       p-vss-workfile    = vss-workfile
       24       p-vss-archive     = vss-archive
       25       p-vss-description = vss-description
       26     .
       27   end procedure.
       28   procedure vss-get-parameters :
       29     define output parameter p-vss-parameters as character no-undo .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define new global shared variable g#language as character no-undo .
       67   if g#language <> '' and g#language <> 'rus':U then do:
       68     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       69   end.
       70   procedure proc-alt-shift-f2:
       71     if not ibs.th.gbl.gbl-var:rcode
       72   then
       73     run gbl\inidebug.p .
       74   end.
       75   procedure proc-alt-shift-f3:
       76     run gbl/prvssinf.p
       77       ( input this-procedure
       78       ) .
       79   end.
       80   define variable v-inform-launched as logical no-undo initial false .
       81   procedure proc-alt-shift-f4:
       82     define variable v-action as character no-undo .
       83     if v-inform-launched = false then do:
       84       assign
       85         v-inform-launched = true
       86       .
       87       run gbl/d-inform.w
       88         (  input self
       89         ,  input this-procedure
       90         , output v-action
       91         ) no-error .
       92       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       93       assign
       94         v-inform-launched = false
       95       .
       96     end.
       97   end.
       98   procedure proc-alt-f1:
       99     run gbl/corrhelp.p
      100       (input this-procedure
      101       ) .
      102   end .
      103   on alt-shift-f2 anywhere do:
      104     run proc-alt-shift-f2.
      105   end.
      106   on alt-shift-f3 anywhere do:
      107     run proc-alt-shift-f3 in this-procedure .
      108   end.
      109   on alt-shift-f4 anywhere do:
      110     run proc-alt-shift-f4 in this-procedure.
      111   end.
      112   on alt-f1 anywhere do:
      113     run proc-alt-f1 in this-procedure .
      114   end.
      115   define new global shared variable g#library  as handle no-undo .
      116   define new global shared variable g#library2 as handle no-undo .
      117   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      118     define variable v-cntxt-db-num        as integer   no-undo .
      119     define variable v-cntxt-userid        as character no-undo .
      120     define variable v-cntxt-level         as character no-undo .
      121     define variable v-cntxt-host-code-obj as integer   no-undo .
      122     define variable v-cntxt-obj-type      as character no-undo .
      123     define variable v-cntxt-obj-code      as integer   no-undo .
      124     define variable v-cntxt-db-num-obj    as integer   no-undo .
      125     define variable v-cntxt-is-admin      as logical   no-undo .
      126   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      127     run mainmenu_getcntxt in parparentproc
      128       (output v-cntxt-db-num
      129       ,output v-cntxt-userid
      130       ,output v-cntxt-level
      131       ,output v-cntxt-host-code-obj
      132       ,output v-cntxt-obj-type
      133       ,output v-cntxt-obj-code
      134       ,output v-cntxt-db-num-obj
      135       ,output v-cntxt-is-admin
      136       ) .
      137   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      138   define variable v-waitfram-action01         as character   no-undo .
      139   define variable v-waitfram-action02         as character   no-undo .
      140   define variable v-waitfram-action03         as character   no-undo .
      141   define variable mWaitFramTextBeg            as character   no-undo.
      142   define variable mWaitFramTextEnd            as character   no-undo.
      143   define variable mWaitFramView               as logical     no-undo.
      144   define variable mWaitProcEvent              as logical     no-undo init yes.
      145   define variable mWaitFramInterval           as integer     no-undo init 1 .
      146   define variable mWaitFramStop               as logical     no-undo.
      147   define variable mWaitFramStopUser           as logical     no-undo.
      148   define variable mWaitFramStopTimeOut        as logical     no-undo.
      149   define variable mWaitFramStartProc          as datetime-tz no-undo.
      150   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      151   define button B-WaitFramStop auto-end-key
      152        label "Стоп"
      153        size 10 by 1 tooltip "Остоновить процесс".
      154   define button B-viewProcInfo
      155        label "Информация"
      156        size 15 by 1 tooltip "Информация о процесс".
      157   define frame waitfram
      158     v-waitfram-action01 format "x(72)" no-label skip
      159     v-waitfram-action02 format "x(72)" no-label skip
      160     v-waitfram-action03 format "x(72)" no-label skip
      161     B-viewProcInfo
      162     B-WaitFramStop at row 4 col 30
      163     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      164     .
      165   define new global shared variable mBatchMode as logical no-undo init ?.
      166   define variable mFramBachModHandle as handle no-undo.
      167   mFramBachModHandle = frame waitfram:handle.
      168   define variable mFameOldVis as logical no-undo.
      169   define variable mVisCUrentVin as logical no-undo.
      170   if session:batch-mode
      171   then
      172      mBatchMode = yes.
      173   if mBatchMode = ? then do:
      174     mVisCUrentVin = current-window:visible.
      175     mFameOldVis = mFramBachModHandle:visible.
      176     mFramBachModHandle:visible  = yes.
      177     mBatchMode = mFramBachModHandle:visible ne yes.
      178     mFramBachModHandle:visible = mFameOldVis.
      179     current-window:visible = mVisCUrentVin.
      180   end.
      181    if  log-manager:logfile-name ne ?
      182     then DO:
      183         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      184         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      185         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      186     end.
      187   on choose of B-WaitFramStop in frame waitfram
      188   do:
      189     mWaitFramStop = yes.
      190     mWaitFramStopUser = yes.
      191   end.
      192   function waitfram-check-timeout returns logical():
      193      define variable vtime as int64 no-undo.
      194      if mWaitFramStopTimeOut
      195      then
      196         return yes.
      197      vtime = ( now - mWaitFramStartProc ) / 1000 .
      198      if     mWaitFramTimeOut ne ?
      199         and mWaitFramTimeOut ne 0
      200         and mWaitFramTimeOut lt vtime
      201      then do:
      202         mWaitFramStopTimeOut = yes.
      203      end.
      204      return mWaitFramStopTimeOut.
      205   end.
      206   procedure waitfram-hide :
      207     if not session:batch-mode
      208     then do
      209     on error undo, return error return-value
      210     :
      211       pause 0 before-hide .
      212       if not mBatchMode then
      213         hide frame waitfram .
      214     if     not mWaitFramView
      215        and mWaitProcEvent
      216     then
      217       process events .
      218     end.
      219   end procedure.
      220   procedure waitfram-show :
      221     define input  parameter p-message as character no-undo .
      222     define variable v-left-margin as integer   no-undo .
      223     if not session:batch-mode
      224     then do
      225     on error undo, return error return-value
      226     :
      227       if length(p-message) <= 70 then do:
      228         assign
      229           v-left-margin = integer((70 - length(p-message)) / 2)
      230         .
      231         assign
      232           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      233         .
      234         assign
      235           v-waitfram-action01 = " "
      236           v-waitfram-action02 = " "
      237                                    + fill(" ", v-left-margin)
      238                                    + p-message
      239           v-waitfram-action03 = " "
      240         .
      241       end.
      242       else do:
      243         define variable vRindex1 as integer no-undo.
      244         define variable vRindex2 as integer no-undo.
      245         vRindex1 = r-index(p-message," ",70).
      246         if vRindex1 = 0
      247         then
      248            vRindex1 = 70.
      249         if length(p-message)  <= vRindex1 + 70 then do:
      250           assign
      251             v-waitfram-action01 = " "
      252             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      253             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      254           .
      255         end.
      256         else do:
      257           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      258           if vRindex2 <= vRindex1
      259           then
      260              vRindex2 = vRindex1 + 70.
      261           assign
      262             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      263             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      264             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      265           .
      266         end.
      267       end.
      268       B-viewProcInfo:visible   in frame waitfram = no.
      269       B-viewProcInfo:sensitive in frame waitfram = no.
      270       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      271       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      272       if  (   mWaitFramView
      273          or  mWaitProcEvent)
      274          and not mBatchMode
      275       then
      276          display
      277             v-waitfram-action01 skip
      278             v-waitfram-action02 skip
      279             v-waitfram-action03 skip
      280          with frame waitfram .
      281       if     mWaitFramView
      282          then do:
      283             if     mWaitFramInterval ne ?
      284                and not mBatchMode
      285             then
      286                wait-for go of frame waitfram pause mWaitFramInterval.
      287          end.
      288          else
      289             if     mWaitProcEvent
      290                and not mBatchMode
      291             then
      292                process events .
      293     end.
      294   end procedure.
      295      procedure waitfram-show-this:
      296         define input  parameter iInterval as int64 no-undo.
      297         define variable vtime as int64 no-undo.
      298         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      299         mWaitFramInterval = iInterval.
      300         run waitfram-show (substitute("&1&2 &3&4" ,
      301                                       mWaitFramTextBeg ,
      302                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      303                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      304                                       mWaitFramTextEnd
      305                                      )
      306                           ).
      307      end.
      308      procedure WaitFramRunPause:
      309         define input  parameter iInterval as dec no-undo.
      310         define variable vStart  as datetime-tz no-undo.
      311         define variable vend    as datetime-tz no-undo.
      312         define variable vint as int64 no-undo.
      313         define variable vOk as logical no-undo.
      314         vStart = now.
      315         vend   = vStart.
      316         publish "WaitFramPause" (iInterval,output vOk).
      317         vend   =  now.
      318         vint = vend - vStart.
      319         vint = iInterval - vint / 1000.
      320         if     not mWaitFramStop
      321            and (   vint > 0
      322                 or (    not vOk
      323                     and iInterval eq ?
      324                     )
      325                 )
      326         then
      327            run waitfram-show-this (iInterval).
      328         vend   =  now.
      329         vint = vend - vStart.
      330         vint = iInterval - vint / 1000.
      331         if     not mWaitFramStop
      332            and vint > 0
      333         then do:
      334            run gbl/pause.p (vint * 1000).
      335         end.
      336         if iInterval ne ?
      337         then
      338            publish "WaitFramStop".
      339         waitfram-check-timeout().
      340      end.
      341      procedure WaitFramWaitFor:
      342         define input  parameter iInterval as dec no-undo.
      343         assign
      344            mWaitFramStartProc   = now
      345            mWaitFramStopUser    = no
      346            mWaitFramStopTimeOut = no
      347         .
      348         block-wait:
      349         do while not mWaitFramStop:
      350            run WaitFramRunPause (iInterval).
      351            if  waitfram-check-timeout()
      352            then do:
      353               leave block-wait.
      354            end.
      355         end.
      356         run waitfram-hide.
      357      end.
      358   procedure waitfram-join :
      359     define input  parameter p-line-1  as character no-undo .
      360     define input  parameter p-line-2  as character no-undo .
      361     define input  parameter p-line-3  as character no-undo .
      362     define output parameter p-message as character no-undo .
      363     do
      364     on error undo, return error return-value
      365     :
      366       assign
      367         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      368                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      369                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      370       .
      371     end.
      372   end procedure.
      373   function waitfram-join-function returns character
      374     (input p-line-1 as character
      375     ,input p-line-2 as character
      376     ,input p-line-3 as character
      377     ).
      378     define variable v-message as character no-undo .
      379     run waitfram-join in this-procedure
      380       (input  p-line-1
      381       ,input  p-line-2
      382       ,input  p-line-3
      383       ,output v-message
      384       ) .
      385     return v-message .
      386   end function .
      387   define variable v-sec as integer   no-undo .
      388   PROCEDURE qIq-ADD :
      389   define input  parameter p-db-num       as integer   no-undo .
      390   define input  parameter p-id           as integer   no-undo .
      391   define input  parameter p-ggr-qnty    as decimal   no-undo .
      392   define input  parameter p-use-discnt           as logical   no-undo .
      393   define input  parameter p-discnt-pc            as decimal   no-undo .
      394   define input  parameter p-method-round  as character no-undo .
      395   define input  parameter p-stts         as integer   no-undo .
      396   define input  parameter p-db-num-usr   as integer   no-undo .
      397   define input  parameter p-userid       as character no-undo .
      398   define output parameter p-recid as recid no-undo .
      399     do
      400     on error undo, return error return-value
      401     :
      402   if v-cntxt-db-num <> 0 then do :
      403      if p-db-num <> v-cntxt-db-num then do:
      404         message substitute(" Группа создана в другой БД (&1) , корректировать ее в текущей БД нельзя !" , p-db-num ) .
      405         return error substitute(" Группа создана в другой БД (&1) , корректировать ее нельзя !" , p-db-num).
      406      end.
      407   end.
      408   find first ub.qnty-in-qnty-group exclusive-lock where
      409           ub.qnty-in-qnty-group.qgr-db-num   = p-db-num  and
      410           ub.qnty-in-qnty-group.qgr-id       = p-id      and
      411           ub.qnty-in-qnty-group.ggr-qnty    = p-ggr-qnty
      412           no-error .
      413         if not available ub.qnty-in-qnty-group then do:
      414             create ub.qnty-in-qnty-group.
      415               assign
      416                   ub.qnty-in-qnty-group.qgr-db-num          = p-db-num
      417                   ub.qnty-in-qnty-group.qgr-id              = p-id
      418                   ub.qnty-in-qnty-group.ggr-qnty            = p-ggr-qnty
      419               .
      420         end.
      421         assign
      422           ub.qnty-in-qnty-group.use-discnt          = p-use-discnt
      423           ub.qnty-in-qnty-group.discnt-pc           = p-discnt-pc
      424           ub.qnty-in-qnty-group.method-round        = p-method-round
      425           ub.qnty-in-qnty-group.db-num-chg    = p-db-num-usr
      426           ub.qnty-in-qnty-group.stts          = p-stts
      427           ub.qnty-in-qnty-group.sys-date      = today
      428           ub.qnty-in-qnty-group.sys-time      = time
      429           ub.qnty-in-qnty-group.sys-time-chr  = string ( ub.qnty-in-qnty-group.sys-time,"hh:mm" )
      430           ub.qnty-in-qnty-group.who           = p-userid
      431           p-recid = recid ( ub.qnty-in-qnty-group )
      432         .
      433           run ref/h-grqu.p (buffer ub.qnty-in-qnty-group , input-output v-sec )  .
      434     end.
      435   end procedure.
      436   PROCEDURE qIq-DEL :
      437   define input  parameter p-db-num       as integer   no-undo .
      438   define input  parameter p-id           as integer   no-undo .
      439   define input  parameter p-ggr-qnty     as decimal   no-undo .
      440   define input  parameter p-db-num-usr   as integer   no-undo .
      441   define input  parameter p-userid       as character no-undo .
      442     do
      443     on error undo, return error return-value
      444     :
      445   if v-cntxt-db-num <> 0 then do :
      446      if p-db-num <> v-cntxt-db-num then do:
      447         message substitute(" Группа создана в другой БД (&1) , удалять ее в текущей БД нельзя !" , p-db-num ) .
      448         return error substitute(" Группа создана в другой БД (&1) , удалять ее нельзя !" , p-db-num).
      449      end.
      450   end.
      451   find first ub.qnty-in-qnty-group exclusive-lock where
      452           ub.qnty-in-qnty-group.qgr-db-num   = p-db-num  and
      453           ub.qnty-in-qnty-group.qgr-id       = p-id      and
      454           ub.qnty-in-qnty-group.ggr-qnty = p-ggr-qnty
      455           no-error .
      456    if not available ub.qnty-in-qnty-group then  return error .
      457         assign
      458           ub.qnty-in-qnty-group.db-num-chg    = p-db-num-usr
      459           ub.qnty-in-qnty-group.stts          = 1
      460           ub.qnty-in-qnty-group.sys-date      = today
      461           ub.qnty-in-qnty-group.sys-time      = time
      462           ub.qnty-in-qnty-group.sys-time-chr  = string(ub.qnty-in-qnty-group.sys-time,"hh:mm")
      463           ub.qnty-in-qnty-group.who           = p-userid
      464         .
      465         run ref/h-grqu.p (buffer ub.qnty-in-qnty-group , input-output v-sec )  .
      466     end.
      467   end procedure.
      468   PROCEDURE qIq-update :
      469   define input  parameter p-recid as recid no-undo .
      470   define input  parameter p-db-num       as integer   no-undo .
      471   define input  parameter p-id           as integer   no-undo .
      472   define input  parameter p-ggr-qnty    as decimal   no-undo .
      473   define input  parameter p-use-discnt           as logical   no-undo .
      474   define input  parameter p-discnt-pc            as decimal   no-undo .
      475   define input  parameter p-method-round  as character no-undo .
      476   define input  parameter p-stts         as integer   no-undo .
      477   define input  parameter p-db-num-usr   as integer   no-undo .
      478   define input  parameter p-userid       as character no-undo .
      479     do
      480     on error undo, return error return-value
      481     :
      482   if v-cntxt-db-num <> 0 then do :
      483      if p-db-num <> v-cntxt-db-num then do:
      484         message substitute(" Группа создана в другой БД (&1) , корректировать ее в текущей БД нельзя !" , p-db-num ) .
      485         return error substitute(" Группа создана в другой БД (&1) , корректировать ее нельзя !" , p-db-num).
      486      end.
      487   end.
      488   find first ub.qnty-in-qnty-group exclusive-lock where
      489        recid(ub.qnty-in-qnty-group )  = p-recid
      490           no-error .
      491         if not available ub.qnty-in-qnty-group then do:
      492             create ub.qnty-in-qnty-group.
      493               assign
      494                   ub.qnty-in-qnty-group.qgr-db-num          = p-db-num
      495                   ub.qnty-in-qnty-group.qgr-id              = p-id
      496                   ub.qnty-in-qnty-group.ggr-qnty            = p-ggr-qnty
      497               .
      498         end.
      499         assign
      500           ub.qnty-in-qnty-group.use-discnt    = p-use-discnt
      501           ub.qnty-in-qnty-group.discnt-pc     = p-discnt-pc
      502           ub.qnty-in-qnty-group.method-round  = p-method-round
      503           ub.qnty-in-qnty-group.db-num-chg    = p-db-num-usr
      504           ub.qnty-in-qnty-group.stts          = p-stts
      505           ub.qnty-in-qnty-group.sys-date      = today
      506           ub.qnty-in-qnty-group.sys-time      = time
      507           ub.qnty-in-qnty-group.sys-time-chr  = string ( ub.qnty-in-qnty-group.sys-time,"hh:mm" )
      508           ub.qnty-in-qnty-group.who           = p-userid
      509           p-recid = recid ( ub.qnty-in-qnty-group )
      510         .
      511           run ref/h-grqu.p (buffer ub.qnty-in-qnty-group , input-output v-sec )  .
      512     end.
      513   end procedure.
      514   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      515   function usrfulnf returns character ( input p-user-id as character):
      516   define variable v-user-name as character no-undo .
      517   define variable vss-include-info4 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      518   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run usrfulnm in g#library
      519     (input  p-user-id
      520     ,output v-user-name
      521     ) no-error .
      522   if error-status:error
      523   or v-user-name = ""
      524   then do:
      525     return p-user-id.
      526   end.
      527   else do:
      528     return v-user-name.
      529   end.
      530   end function.
      531   define variable r-find  as logical   no-undo init false .
      532   define variable find-id as integer   no-undo .
      533   define variable find-db as integer   no-undo .
      534   define variable v-rec-list-cli as character no-undo .
      535   define variable g-log as logical   no-undo .
      536   function mark-string returns character
      537     ( buffer loc-table for ub.qnty-group, input mark-list as character  ) :
      538     return ( if lookup( string( recid( loc-table ) ), mark-list ) > 0 then "*" else "":U ).
      539   end function.
      540   function mark-string-2 returns character
      541     ( buffer loc-table for ub.qnty-in-qnty-group , input mark-list as character  ) :
      542     return ( if lookup( string( recid( loc-table ) ), mark-list ) > 0 then "*" else "":U ).
      543   end function.
      544   function stts-string-2 returns character
      545     ( buffer loc-table for ub.qnty-in-qnty-group   ) :
      546   return entry (lookup (string(loc-table.stts), '0,1,50,99':U), 'тек,удал,блок,удаление':U) .
      547   end function.
      548   function stts-string returns character
      549     ( buffer loc-table for ub.qnty-group   ) :
      550   return entry (lookup (string(loc-table.stts), '0,1,50,99':U), 'тек,удал,блок,удаление':U) .
      551   end function.
      552   DEFINE QUERY external_tables FOR buf_qnty-group.
      553   DEFINE BUTTON B-add
      554        LABEL "Добавить"
      555        SIZE 10 BY 1 TOOLTIP "Добавить группу"
      556        BGCOLOR 8 .
      557   DEFINE BUTTON B-add-2
      558        LABEL "Добавить"
      559        SIZE 10 BY 1 TOOLTIP "Добавить количество"
      560        BGCOLOR 8 .
      561   DEFINE BUTTON B-Cancel AUTO-END-KEY
      562        LABEL "Выход"
      563        SIZE 10 BY 1
      564        BGCOLOR 8 .
      565   DEFINE BUTTON B-chg
      566        LABEL "Изменить"
      567        SIZE 10 BY 1 TOOLTIP "Изменить название группы"
      568        BGCOLOR 8 .
      569   DEFINE BUTTON B-chg-2
      570        LABEL "Изменить"
      571        SIZE 10 BY 1 TOOLTIP "Изменить скидку"
      572        BGCOLOR 8 .
      573   DEFINE BUTTON B-del
      574        LABEL "Удалить"
      575        SIZE 10 BY 1 TOOLTIP "Удалить группу"
      576        BGCOLOR 8 .
      577   DEFINE BUTTON B-del-2
      578        LABEL "Удалить"
      579        SIZE 10 BY 1 TOOLTIP "Удалить количество"
      580        BGCOLOR 8 .
      581   DEFINE BUTTON B-Help
      582        LABEL "Помо&щь"
      583        SIZE 10 BY 1
      584        BGCOLOR 8 .
      585   DEFINE BUTTON B-history
      586        LABEL "История"
      587        SIZE 10 BY 1 TOOLTIP "История изменения справочника"
      588        BGCOLOR 8 .
      589   DEFINE BUTTON B-mark
      590        LABEL "*"
      591        SIZE 3.25 BY 1 TOOLTIP "Отметить группу"
      592        BGCOLOR 8 .
      593   DEFINE BUTTON B-mark-2
      594        LABEL "*"
      595        SIZE 3.25 BY 1 TOOLTIP "Отметить количество"
      596        BGCOLOR 8 .
      597   DEFINE BUTTON B-print
      598        LABEL "Печать"
      599        SIZE 10 BY 1 TOOLTIP "Печать справочника"
      600        BGCOLOR 8 .
      601   DEFINE BUTTON B-sel AUTO-GO
      602        LABEL "Выбор"
      603        SIZE 10 BY 1
      604        BGCOLOR 8 .
      605   DEFINE VARIABLE FILL-IN-1 AS CHARACTER FORMAT "X(256)":U INITIAL "Статус:"
      606         VIEW-AS TEXT
      607        SIZE 7.5 BY .67
      608        FGCOLOR 4  NO-UNDO.
      609   DEFINE VARIABLE R-status AS INTEGER
      610        VIEW-AS RADIO-SET HORIZONTAL
      611        RADIO-BUTTONS
      612             "Текущие", 0,
      613   "Все", 2,
      614   "Удаленные", 1
      615        SIZE 30.5 BY .67 TOOLTIP "Условие отбора записей" NO-UNDO.
      616   DEFINE QUERY BROWSE-1grp FOR
      617         buf_qnty-group SCROLLING.
      618   DEFINE QUERY BROWSE-2cli FOR
      619         buf_qnty-in-qnty-group SCROLLING.
      620   DEFINE BROWSE BROWSE-1grp
      621     QUERY BROWSE-1grp NO-LOCK DISPLAY
      622         mark-string(buffer buf_qnty-group, p-rec-list) COLUMN-LABEL "*! " FORMAT "x(1)":U
      623         stts-string(buffer buf_qnty-group) COLUMN-LABEL "Ста!тус" FORMAT "x(3)":U
      624         buf_qnty-group.qgr-id COLUMN-LABEL "Код! " FORMAT ">>9":U
      625         buf_qnty-group.name COLUMN-LABEL "Название!группы" FORMAT "X(80)":U
      626         usrfulnf(buf_qnty-group.who) COLUMN-LABEL "Кто!изменял" FORMAT "X(12)":U
      627         buf_qnty-group.sys-date COLUMN-LABEL "Дата!изменения" FORMAT "99/99/99":U
      628         buf_qnty-group.sys-time-chr COLUMN-LABEL "Время!изм" FORMAT "X(5)":U
      629         buf_qnty-group.db-num-chg COLUMN-LABEL "БД!изм" FORMAT ">>>>9":U
      630         buf_qnty-group.qgr-db-num COLUMN-LABEL "БД!соз" FORMAT ">>>>9":U
      631       WITH NO-ROW-MARKERS SEPARATORS SIZE 48.13 BY 19
      632            TITLE "Количественные группы" FIT-LAST-COLUMN.
      633   DEFINE BROWSE BROWSE-2cli
      634     QUERY BROWSE-2cli NO-LOCK DISPLAY
      635         mark-string-2(buffer buf_qnty-in-qnty-group, v-rec-list-cli) COLUMN-LABEL "*! " FORMAT "x(1)":U
      636   stts-string-2(buffer buf_qnty-in-qnty-group) COLUMN-LABEL "Ста!тус" FORMAT "x(3)":U
      637   buf_qnty-in-qnty-group.ggr-qnty COLUMN-LABEL "Количество! " FORMAT "->,>>>,>>>,>>>,>>9.99":U
      638   buf_qnty-in-qnty-group.discnt-pc COLUMN-LABEL "Скидка!% " FORMAT ">>9.99":U
      639   usrfulnf(buf_qnty-in-qnty-group.who) COLUMN-LABEL "Кто!изменял" FORMAT "X(12)":U
      640   buf_qnty-in-qnty-group.sys-date COLUMN-LABEL "Дата!изм" FORMAT "99/99/99":U
      641   buf_qnty-in-qnty-group.sys-time-chr COLUMN-LABEL "Время!изм" FORMAT "X(5)":U
      642   buf_qnty-in-qnty-group.db-num-chg COLUMN-LABEL "БД!изм" FORMAT ">>>>9":U
      643   buf_qnty-in-qnty-group.qgr-id COLUMN-LABEL "Гру!ппа" FORMAT ">>>>9":U
      644   buf_qnty-in-qnty-group.qgr-db-num FORMAT ">>>>9":U
      645       WITH NO-ROW-MARKERS SEPARATORS SIZE 50.5 BY 19
      646            TITLE "Количества в группе" FIT-LAST-COLUMN.
      647   DEFINE FRAME Dialog-Frame
      648        B-Cancel AT ROW 1 COL 1
      649        B-sel AT ROW 1 COL 11
      650        B-add AT ROW 1 COL 21
      651        B-chg AT ROW 1 COL 31 WIDGET-ID 2
      652        B-del AT ROW 1 COL 41
      653        B-history AT ROW 1 COL 79.88
      654        B-Help AT ROW 1 COL 90
      655        B-print AT ROW 2 COL 90
      656        R-status AT ROW 2.29 COL 9.63 NO-LABEL
      657        B-mark-2 AT ROW 2.92 COL 49.75
      658        B-add-2 AT ROW 2.92 COL 53
      659        B-chg-2 AT ROW 2.92 COL 63.13
      660        B-del-2 AT ROW 2.92 COL 73.25
      661        B-mark AT ROW 3 COL 1.75
      662        BROWSE-1grp AT ROW 4 COL 1.38
      663        BROWSE-2cli AT ROW 4 COL 49.5
      664        FILL-IN-1 AT ROW 2.25 COL 2 NO-LABEL
      665        SPACE(90.88) SKIP(20.21)
      666       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      667            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      668            TITLE "Количественные группы для ценообразования"
      669            DEFAULT-BUTTON B-sel CANCEL-BUTTON B-Cancel.
      670   ASSIGN
      671          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      672          FRAME Dialog-Frame:HIDDEN           = TRUE.
      673   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      674   DO:
      675     APPLY "END-ERROR":U TO SELF.
      676   END.
      677   ON CHOOSE OF B-add IN FRAME Dialog-Frame
      678   DO:
      679      define variable g#log as logical   no-undo .
      680   define variable vss-include-info5 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      681   do:
      682     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      683       (input  v-cntxt-db-num
      684       ,input  v-cntxt-userid
      685       ,input  0
      686       ,input  'actn_ref-mpl_update':U
      687       ,input  'global':U
      688       ,input  v-cntxt-host-code-obj
      689       ,input  v-cntxt-obj-type
      690       ,input  v-cntxt-obj-code
      691       ,input  0
      692       ,input  0
      693       ,input  0
      694       ,input  true
      695       ,output g#log
      696       )  .
      697   end.
      698     if not g#log then return .
      699   define variable v-rec-id as recid no-undo .
      700     run ref/gr-qupra.w (input parparentproc,input 'ДОБАВЛЕНИЕ':U , input-output v-rec-id) .
      701     OPEN QUERY BROWSE-1grp FOR EACH buf_qnty-group WHERE   ( r-status = 2 OR buf_qnty-group.stts =  r-status ) and   ( r-find = no or (buf_qnty-group.qgr-db-num = find-db and                     buf_qnty-group.qgr-id = find-id )).
      702     reposition BROWSE-1grp to recid v-rec-id no-error .
      703     apply "VALUE-CHANGED" to browse-1grp in frame Dialog-Frame.
      704   END.
      705   ON CHOOSE OF B-add-2 IN FRAME Dialog-Frame
      706   DO:
      707      define variable g#log as logical   no-undo .
      708   define variable vss-include-info6 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
