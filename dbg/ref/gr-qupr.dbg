      924   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
      925   DO:
      926       if available buf_qnty-group then do:
      927   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      928   define variable v-str-recid12 as character no-undo .
      929   define variable v-num-entry12 as integer   no-undo .
      930   assign
      931     v-str-recid12 = trim( string( recid( buf_qnty-group ) , "->>>>>>>>>>>9":U ) )
      932     v-num-entry12 = lookup( v-str-recid12 , p-rec-list )
      933   .
      934   if v-num-entry12 > 0 then do:
      935     assign
      936       entry( v-num-entry12, p-rec-list ) = "":U
      937       p-rec-list = trim( replace( p-rec-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
      938     .
      939   end.
      940   else do:
      941     assign
      942       p-rec-list = p-rec-list + ( if p-rec-list = "":U then "":U else chr(44) ) + v-str-recid12
      943     .
      944   end.
      945           g-log = browse-1grp:refresh() .
      946         if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
      947             g-log = browse-1grp:select-next-row ().
      948             apply "VALUE-CHANGED" to browse-1grp in frame Dialog-Frame.
      949         end.
      950       end.
      951       apply "display" to browse-1grp in frame Dialog-Frame.
      952   END.
      953   ON CHOOSE OF B-mark-2 IN FRAME Dialog-Frame
      954   DO:
      955       if available buf_qnty-in-qnty-group then do:
      956   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      957   define variable v-str-recid14 as character no-undo .
      958   define variable v-num-entry14 as integer   no-undo .
      959   assign
      960     v-str-recid14 = trim( string( recid( buf_qnty-in-qnty-group ) , "->>>>>>>>>>>9":U ) )
      961     v-num-entry14 = lookup( v-str-recid14 , v-rec-list-cli )
      962   .
      963   if v-num-entry14 > 0 then do:
