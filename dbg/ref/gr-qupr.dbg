      900     if not g#log then return .
      901     if not available buf_qnty-in-qnty-group then return .
      902     if v-cntxt-db-num <> 0 then do :
      903      if buf_qnty-group.qgr-db-num <> v-cntxt-db-num then do:
      904         message substitute(" Группа создана в другой БД (&1) , корректировать ее в текущей БД нельзя !" , buf_qnty-group.qgr-db-num ) .
      905         return .
      906      end.
      907   end.
      908           run qiq-del (
      909              input   buf_qnty-in-qnty-group.qgr-db-num
      910             ,input   buf_qnty-in-qnty-group.qgr-id
      911             ,input   buf_qnty-in-qnty-group.ggr-qnty
      912             ,input   v-cntxt-db-num
      913             ,input   v-cntxt-userid ) .
      914      OPEN QUERY BROWSE-2cli FOR EACH buf_qnty-in-qnty-group OF buf_qnty-group      WHERE ( r-status = 2 OR buf_qnty-in-qnty-group.stts =  r-status )       NO-LOCK INDEXED-REPOSITION.
      915   END.
      916   ON CHOOSE OF B-history IN FRAME Dialog-Frame
      917   DO:
      918     if not available buf_qnty-group then return .
      919     run ref/cgr-sqr.w (
      920         parParentProc ,
      921         buf_qnty-group.qgr-id ,
      922         buf_qnty-group.qgr-db-num ) .
