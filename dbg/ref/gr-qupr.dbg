      966       v-rec-list-cli = trim( replace( v-rec-list-cli , chr(44) + chr(44) , chr(44) ) , chr(44) )
      967     .
      968   end.
      969   else do:
      970     assign
      971       v-rec-list-cli = v-rec-list-cli + ( if v-rec-list-cli = "":U then "":U else chr(44) ) + v-str-recid14
      972     .
      973   end.
      974           g-log = browse-2cli:refresh() .
      975         if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
      976             g-log = browse-2cli:select-next-row ().
      977             apply "VALUE-CHANGED" to browse-2cli in frame Dialog-Frame.
      978         end.
      979       end.
      980       apply "entry" to browse-2cli in frame Dialog-Frame.
      981   END.
      982   ON CHOOSE OF B-print IN FRAME Dialog-Frame
      983   DO:
      984   if not available buf_qnty-group then return .
      985     run rep/g-prqnty.p
      986     ( parParentProc ,
      987       recid( buf_qnty-group )
      988     ).
      989   END.
      990   ON CHOOSE OF B-sel IN FRAME Dialog-Frame
      991   DO:
      992       if ( available buf_qnty-group ) AND ( p-rec-list = "" ) then
      993       p-rec-list = string( recid( buf_qnty-group ) ) .
