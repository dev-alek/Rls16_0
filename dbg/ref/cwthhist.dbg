     2936   procedure get-context :
     2937      define output parameter p-db-num as integer          no-undo.
     2938      define output parameter p-user-id as character        no-undo.
     2939      define variable v-login               as character    no-undo.
     2940      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2941      define buffer buf_user-login  for ub.user-login .
     2942      do
     2943      on error undo, return error
     2944      :
     2945            FIND FIRST buf_sys-ctrl no-lock.
     2946            ASSIGN
     2947               v-login = USERID("ub")
     2948               p-db-num = buf_sys-ctrl.db-num
     2949            .
     2950            FIND FIRST buf_user-login
     2951                 WHERE buf_user-login.db-num = p-db-num
     2952                   AND buf_user-login.user-login = v-login
     2953                 no-lock
     2954                 no-error
     2955                 .
     2956            IF AVAILABLE buf_user-login
     2957            THEN DO:
     2958               assign
     2959                  p-user-id = buf_user-login.user-id
     2960               .
     2961            END.
     2962      end.
     2963   end procedure.
