     3136        )
     3137     then do:
     3138       if self :handle <> focus :handle
     3139       then do:
     3140         apply "entry":u to self .
     3141       end.
     3142       define variable v-ok            as logical   no-undo .
     3143       define variable v-curr-sv-date  as date      no-undo .
     3144       define variable v-description   as character no-undo .
     3145       assign
