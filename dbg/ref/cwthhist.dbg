     3082           self :screen-value = string(v-new-sv-date) .
     3083         .
     3084       end.
     3085     end.
     3086     return no-apply .
     3087   end.
     3088   on ctrl-e of sch-corr-date in frame Dialog-Frame
     3089   do:
