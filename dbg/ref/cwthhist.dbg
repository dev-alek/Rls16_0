     2793   procedure diasize_init :
     2794     define variable v-default-value    as logical   no-undo .
     2795     define variable v-restore-saved    as logical   no-undo .
     2796     define variable v-resize-value-str as character no-undo .
     2797     do
     2798     on error undo, return error return-value
     2799     :
     2800       do with frame Dialog-Frame
     2801       :
     2802         assign
     2803           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2804           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2805           v-diasize-browse-handle     = browse br-wth-hist :handle
     2806         .
     2807         create button v-diasize-resize-button
     2808         assign
     2809           parent        = frame Dialog-Frame :first-child
     2810           label         = "s"
     2811           height-pixels = 16
     2812           width-pixels  = 16
     2813           visible       = true
     2814           sensitive     = true
     2815           movable       = true
     2816           triggers:
     2817             on end-move persistent run diasize_end-move in this-procedure .
     2818           end triggers.
     2819         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2820         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2821         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2822         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2823         assign
     2824           v-diasize-wndmax = false
     2825         .
     2826         if connected("ub") = true
     2827         then do:
     2828           define variable v-cntxt-db-num        as integer   no-undo .
     2829           define variable v-cntxt-userid        as character no-undo .
     2830           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2831                                             , OUTPUT v-cntxt-userid
     2832                                             ) .
     2833           run gbl/wndpar_r.p
     2834             (input  v-cntxt-db-num
     2835             ,input  v-cntxt-userid
     2836             ,input  'wndmax':U
     2837             ,output v-diasize-wndmax
     2838             ,output v-default-value
     2839             ) .
     2840         end.
     2841         assign
     2842           v-diasize-wndstore = false
     2843         .
     2844         if connected("ub") = true
     2845         then do:
     2846           run gbl/wndpar_r.p
     2847             (input  v-cntxt-db-num
     2848             ,input  v-cntxt-userid
     2849             ,input  'wndstore':U
     2850             ,output v-diasize-wndstore
     2851             ,output v-default-value
     2852             ) .
     2853         end.
     2854         assign
     2855           v-diasize-proc-name = entry(1, program-name(2), '.')
     2856         .
     2857         if v-diasize-wndstore = true
     2858         then do:
     2859           assign
     2860             v-restore-saved = false
     2861           .
     2862           if connected("ub") = true
     2863           then do:
     2864             run gbl/wndsizer.p
     2865               (input  v-cntxt-db-num
     2866               ,input  v-cntxt-userid
     2867               ,input  v-diasize-proc-name
     2868               ,input  'height':u
     2869               ,output v-resize-value-str
     2870               ) .
     2871             if v-resize-value-str <> '':U
     2872             then do:
     2873               run diasize_change-height in this-procedure
     2874                 (input  integer(v-resize-value-str)
     2875                 ,input  true
     2876                 ) .
     2877               assign
     2878                 v-restore-saved = true
     2879               .
     2880             end.
     2881           end.
     2882           if connected("ub") = true
     2883           then do:
     2884             run gbl/wndsizer.p
     2885               (input  v-cntxt-db-num
     2886               ,input  v-cntxt-userid
     2887               ,input  v-diasize-proc-name
     2888               ,input  'width':u
     2889               ,output v-resize-value-str
     2890               ) .
     2891             if v-resize-value-str <> '':U
     2892             then do:
     2893               run diasize_change-width in this-procedure
     2894                 (input  integer(v-resize-value-str)
     2895                 ,input  true
     2896                 ) .
     2897               assign
     2898                 v-restore-saved = true
     2899               .
     2900             end.
     2901           end.
     2902           if v-restore-saved <> true
     2903           then do:
     2904             if v-diasize-wndmax = true
     2905             then do:
     2906               run diasize_maximize in this-procedure
     2907                 (input  true
     2908                 ) .
     2909             end.
     2910           end.
     2911         end.
     2912         else do:
     2913           if v-diasize-wndmax = true
     2914           then do:
     2915             run diasize_maximize in this-procedure
     2916               (input  true
     2917               ) .
     2918           end.
     2919         end.
     2920       end.
     2921     end.
     2922   end procedure.
     2923   procedure diasize_need-full-display :
     2924     define output parameter p-need-full-display as logical   no-undo .
     2925     do
     2926     on error undo, return error return-value
     2927     :
     2928       assign
     2929         p-need-full-display = v-diasize-need-full-display
     2930       .
