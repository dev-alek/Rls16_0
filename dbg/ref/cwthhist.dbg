     3307   end.
     3308   end.
     3309   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3310   do:
     3311     BR-changes :SET-REPOSITIONED-ROW(5, "CONDITIONAL") .
     3312   end.
     3313   MAIN-BLOCK:
     3314   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     3315      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     3316   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3317     run mainmenu_getcntxt in parparentproc
     3318       (output v-cntxt-db-num
     3319       ,output v-cntxt-userid
     3320       ,output v-cntxt-level
     3321       ,output v-cntxt-host-code-obj
     3322       ,output v-cntxt-obj-type
     3323       ,output v-cntxt-obj-code
     3324       ,output v-cntxt-db-num-obj
     3325       ,output v-cntxt-is-admin
     3326       ) .
     3327      if p-mode <> 'все':U
     3328    and p-mode <> 'фирма':U
     3329    and p-mode <> "one":U
     3330    and p-mode <> 'объект':U
     3331    and p-mode <> "subject":U
     3332    then dO:
     3333       message
     3334       vss-workfile vss-revision vss-description skip
     3335       "Неверное значение параметров вызова p-mode"
     3336       p-mode
