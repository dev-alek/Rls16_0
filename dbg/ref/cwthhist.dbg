     3569     B-mark when lookup("b-mark":U, bttns) > 0
     3570     b-sel when lookup("b-sel":U, bttns) > 0
     3571     b-lkp
     3572     B-sch
     3573     b-wth-obj
     3574     B-Print
     3575     B-Help
     3576     br-wth-hist
     3577     sch-corr-date
     3578     sch-wth-code when p-mode = 'все':U
     3579     sch-db-num   when p-mode = 'все':U
     3580     sch-corr-user-name
     3581     BR-changes mark-num
     3582     WITH FRAME Dialog-Frame.
     3583     VIEW FRAME Dialog-Frame.
     3584     HIDE sch-corr-user-name IN FRAME Dialog-Frame.
     3585   END PROCEDURE.
     3586   PROCEDURE OpenBr :
     3587   define input  parameter p-open-query     as logical   no-undo .
     3588   define input  parameter p-find-next      as logical   no-undo .
     3589   define input  parameter p-find-condition as character no-undo .
     3590   define input  parameter p-db-num like ub.c-wth-hist.corr-user-db-num no-undo .
     3591   define variable l-query-was-opened as logical no-undo .
     3592   define variable title0 as character no-undo.
     3593   title0 = "Список полной истории товара" + chr(32).
     3594   run waitfram-show in this-procedure ("Ждите...").
     3595   define variable sort-column-phrase as character no-undo .
     3596   case sort-column-name :
     3597     when "" then do:
     3598       assign
     3599         sort-column-phrase = ""
     3600       .
     3601     end.
     3602     otherwise do:
     3603       assign
     3604         sort-column-phrase = "by " + sort-column-name
     3605       .
     3606     end.
     3607   end case.
     3608   define variable l-open-query as logical   no-undo .
     3609   CASE p-db-num :
     3610     when ? then do:
     3611       CASE p-mode :
     3612         WHEN 'все':U        THEN DO:
     3613           assign
     3614           filter-point = filter-point0 + p-mode
     3615           filter-label = substitute("&1", filter-label0)
     3616           .
     3617   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3618   define variable  l-disable-where-28  as logical   no-undo .
     3619   define variable  l-filter-open-28    as logical   .
     3620   define variable  flt-rec-28       as recid     no-undo .
     3621   define variable  filter-name-28      as character no-undo .
     3622   define variable  where-phrase-28     as character no-undo .
     3623   define variable  sort-phrase-28      as character no-undo .
     3624   define variable  where-phrase-rus-28 as character no-undo .
     3625   define variable  sort-phrase-rus-28  as character no-undo .
     3626     run waitfram-show in this-procedure
     3627       (input "ЖДИТЕ ..."
     3628       ).
     3629   run gbl/flt-get.p
     3630     (input filter-point
     3631     ,output flt-rec-28
     3632     ,output filter-name-28
     3633     ,output where-phrase-28
     3634     ,output sort-phrase-28
     3635     ,output where-phrase-rus-28
     3636     ,output sort-phrase-rus-28
     3637     ).
     3638   if p-open-query then do:
     3639       run set-filter-name in this-procedure
     3640         (INPUT filter-name-28
     3641         ) no-error .
     3642     assign
     3643       l-filter-open-28 = false
     3644     .
     3645     if flt-rec-28 <> ?
     3646       or sort-column-phrase > ""
     3647     then do:
     3648       define variable  parameter-2-28 as character no-undo .
     3649       define variable  parameter-3-28 as character no-undo .
     3650       define variable  parameter-4-28 as character no-undo .
     3651       define variable  parameter-5-28 as character no-undo .
     3652       define variable  parameter-6-28 as character no-undo .
     3653       define variable  parameter-7-28 as character no-undo .
     3654         assign
     3655         parameter-3-28 =
     3656                                 "FOR EACH X_c-wth-hist"
     3657         parameter-4-28 =
     3658           (
     3659             if (" TRUE " + " " + where-phrase-28) <> ""
     3660             then " TRUE " + " " + where-phrase-28
     3661             else "true"
     3662           )
     3663         parameter-5-28 = (" " + "" + " " + "")
     3664         parameter-6-28 = if sort-phrase-28 = ''
     3665                              then
     3666           (
     3667           " " + " use-index idate  " +
     3668             " " + sort-column-phrase +
     3669           " " + "  "
     3670           )
     3671                              else
     3672           (
     3673           " " + " use-index idate  " +
     3674             " " + sort-column-phrase +
     3675           " " + sort-phrase-28
     3676           )
     3677         parameter-7-28 =
     3678           " indexed-reposition  "
     3679       .
     3680       do
     3681       on stop undo, leave
     3682       on error undo, leave
     3683       :
     3684         assign
     3685           l-disable-where-28 =
     3686             (" TRUE " + " " + where-phrase-28 = "")
     3687         .
     3688         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     3689                             ,input query br-wth-hist:handle
     3690                             ,input parameter-3-28
     3691                             ,input parameter-4-28
     3692                             ,input parameter-5-28
     3693                             ,input parameter-6-28
     3694                             ,input parameter-7-28
     3695                             )
     3696         .
     3697         assign
     3698           l-filter-open-28 = true
     3699         .
     3700       end.
     3701       if l-filter-open-28 = false then do:
     3702         message
     3703           "Ошибка при фильтрации / сортировке" skip
     3704           "Будут показаны записи без учета фильтра" skip
     3705           view-as alert-box .
     3706       end.
     3707       else do:
     3708           assign
     3709             l-query-was-opened = true
     3710           .
     3711       end.
     3712     end.
     3713     if l-filter-open-28 = false then do:
     3714       OPEN QUERY br-wth-hist FOR EACH X_c-wth-hist
     3715         where  TRUE
     3716          use-index idate
     3717         indexed-reposition
     3718     .
     3719         assign
     3720           l-query-was-opened = true
     3721         .
     3722     end.
     3723   end.
     3724   else do:
     3725     assign
     3726       v-doc-rec = recid( X_c-wth-hist )
     3727     .
     3728     do
     3729     on stop undo, leave
     3730     on error undo, leave
     3731     :
     3732       if query br-wth-hist:handle:get-buffer-handle(1) = (buffer X_c-wth-hist:handle) then do:
     3733         assign
     3734         parameter-2-28 = (if p-find-next then "true":u else "false":u )
     3735         parameter-4-28 =
     3736           "where ":u + " TRUE " + " ":u + where-phrase-28 + " ":u + p-find-condition + " " + ""
     3737         parameter-5-28 = " use-index idate  "
     3738       .
     3739         run fltopend_fltfindd in this-procedure  (
     3740                             input this-procedure:handle
     3741                             ,input query br-wth-hist:handle
     3742                             ,input rowid(X_c-wth-hist)
     3743                             ,input logical(parameter-2-28)
     3744                             ,input no-lock
     3745                             ,input (buffer X_c-wth-hist:handle)
     3746                             ,input parameter-4-28
     3747                             ,input parameter-5-28
     3748                             ) no-error.
     3749         .
     3750         assign
     3751           v-doc-rec = integer(return-value)
     3752           v-fltopend-rowid[1] = ?
     3753         .
     3754       end.
     3755       else do:
     3756         assign
