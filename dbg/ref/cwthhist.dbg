     5590   PROCEDURE proc-b-print :
     5591   define variable date_string     as      char    no-undo.
     5592   define variable Line                as      char    no-undo.
     5593   define variable for-time as char.
     5594   define variable accum-count as integer.
     5595   define variable v-doc-rec as recid no-undo.
     5596   define variable v-prod as character no-undo .
     5597   define variable v-subject-chr as character no-undo .
     5598   define variable v-upd-time as character no-undo .
     5599   define variable v-obj as character no-undo .
     5600   define variable v-action-chr as character no-undo .
     5601   define variable v-source-type as character no-undo .
     5602   DEFINE VARIABLE v-for-user-name AS CHARACTER NO-UNDO.
     5603   DEFINE FRAME HistoryList
     5604   X_c-wth-hist.wth-code
     5605   v-action-chr FORMAT "X(10)"
     5606   v-wth-name COLUMN-LABEL "Назв. товара" FORMAT "X(20)"
     5607   v-wth-par-name COLUMN-LABEL "Номинал" FORMAT "X(14)"
     5608   v-prod COLUMN-LABEL "Пр-ль" FORMAT "X(12)"
     5609   v-subject-chr COLUMN-LABEL "Предмет изменений" FORMAT "X(20)"
     5610   X_c-wth-hist.is-news COLUMn-LABEL "СПН" FORMAT "+/ "
     5611   v-source-type COLUMn-LABEL "Источн.!измен"
     5612   X_c-wth-hist.source-ref COLUMn-LABEL "№"
     5613   X_c-wth-hist.corr-date
     5614   v-upd-time COLUMN-LABEL "Время изм." FORMAT "X(8)"
     5615   v-for-user-name COLUMN-LABEL "Изменил" FORMAT "X(15)"
     5616   X_c-wth-hist.corr-user-db-num
     5617   X_c-wth-hist.host-code COLUMN-LABEL "Фирма"
     5618   v-obj COLUMN-LABEL "Объект" FORMAT "X(8)"
     5619   HEADER  date_string AT 5 format "X(35)"
     5620   string( "Страница " ) format "X(9)" AT 115 PAGE-NUMBER(PrnLibStream) AT 125 FORMAT ">>9" SKIP
     5621   Line format "X(195)" AT 1
     5622   with width 232 down stream-io use-text    .
     5623   Line = fill("-", 195).
     5624   date_string = cur-time-print() .
     5625   assign
     5626   v-doc-rec = recid( X_c-wth-hist ).
     5627   DO WHILE available X_c-wth-hist :
     5628         GET prev br-wth-hist.
     5629   END.
     5630   run prn-lib-open-stream  in this-procedure (
     5631                                                input parparentProc
     5632                                               ,input 43
     5633                                               ,input yes
     5634                                               ,input no
     5635                                               ).
     5636   PUT  STREAM PrnLibStream
     5637   SPACE(25) ( frame Dialog-Frame:title )
     5638   format "x(90)" SKIP(1) .
     5639   FORM HEADER
     5640   Line format "X(180)" AT 1 SKIP
     5641   "Продолжение - на следующей странице" AT 30 SKIP
     5642   with FRAME BottomFrame width 232 PAGE-BOTTOM NO-LABELS NO-BOX .
     5643   VIEW  STREAM PrnLibStream FRAME BottomFrame .
     5644   FORM with FRAME HistoryList  .
     5645   run waitfram-show in this-procedure ("Ждите...").
     5646     GET next br-wth-hist.
     5647       DO WHILE available X_c-wth-hist :
     5648         Display STREAM PrnLibStream
     5649         X_c-wth-hist.wth-code
     5650         get-action(X_c-wth-hist.action) @ v-action-chr
     5651         (if v-find then get-wealth(X_c-wth-hist.wth-code, X_c-wth-hist.par-code, output v-wth-par-name) else "":U )
     5652         @ v-wth-name
     5653         v-wth-par-name
     5654         get-subject(X_c-wth-hist.subject) @ v-subject-chr
     5655         X_c-wth-hist.is-news
     5656         get-source-type(X_c-wth-hist.source-type) @ v-source-type
     5657         X_c-wth-hist.source-ref
     5658         X_c-wth-hist.corr-date
     5659         string(X_c-wth-hist.corr-time, "HH:MM:SS":U) @ v-upd-time
     5660         usrfulnf(X_c-wth-hist.corr-user-name) @ v-for-user-name
     5661         X_c-wth-hist.corr-user-db-num
     5662         X_c-wth-hist.host-code
     5663         X_c-wth-hist.obj-type + string(X_c-wth-hist.obj-code) @ v-obj
     5664         with FRAME HistoryList .
     5665     DOWN STREAM PrnLibStream 1 with FRAME HistoryList  .
     5666     assign
     5667     accum-count = accum-count + 1
     5668     .
     5669     GET next br-wth-hist.
     5670   END.
