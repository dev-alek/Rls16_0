     3044       assign
     3045         self :screen-value = string(v-curr-sv-date) .
     3046       .
     3047     end.
     3048     return no-apply.
     3049   end.
     3050   on ctrl-b of sch-corr-date in frame Dialog-Frame
     3051   do:
     3052     if (can-query (self, "sensitive")
     3053        and
     3054        self :sensitive = true
     3055        )
     3056     or (can-query (self, "read-only")
     3057        and
     3058        self :read-only = false
     3059        )
     3060     then do:
     3061       if self :handle <> focus :handle
     3062       then do:
     3063         apply "entry":u to self .
     3064       end.
     3065       define variable v-curr-sv-date as date no-undo .
