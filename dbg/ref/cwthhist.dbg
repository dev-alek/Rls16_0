     1084   index imain uniq-key-rec
     1085   .
     1086   FUNCTION get-all-fields returns character (p-file-name as character ):
     1087   define variable v-dop as character no-undo .
     1088     find first _file no-lock where _file._file-name = p-file-name no-error .
     1089     if not available _file then return "":U.
     1090     for each _field no-lock where
     1091              _field._file-recid = recid(_file) :
     1092       assign
     1093       v-dop = v-dop + _field._field-name + chr(44)
     1094       .
     1095     end.
     1096     return trim(v-dop).
     1097   END FUNCTION.
     1098   PROCEDURE proc-full-temp-changes :
     1099     define input  parameter p-hst-handle as handle    no-undo .
     1100     define input  parameter p-main-table as character no-undo .
     1101     define input  parameter p-field-list as character no-undo .
     1102     define input  parameter p-label-form as character no-undo .
     1103     define variable h-new-buf         as handle    no-undo .
     1104     define variable h-main-buf        as handle    no-undo .
     1105     define variable h-for-comp        as handle    no-undo .
     1106     define variable v-inform          as character no-undo .
     1107     define variable v-ind             as integer   no-undo .
     1108     define variable v-idx-field-qnty  as integer   no-undo .
     1109     define variable v-num-entries     as integer   no-undo .
     1110     define variable fh                as handle    no-undo .
     1111     define variable fh-main           as handle    no-undo .
     1112     define variable fh-old            as handle    no-undo .
     1113     define variable fh-new            as handle    no-undo .
     1114     define variable v-field-name      as character no-undo .
     1115     define variable v-field-lvl       as character no-undo .
     1116     define variable v-field-form      as character no-undo .
     1117     define variable v-search-exp      as character no-undo .
     1118     define variable v-srch-main       as character no-undo .
     1119     define variable v-word-link       as character no-undo .
     1120     define variable v-av-chip-num     as logical   no-undo .
     1121     define variable v-main-pi-fld-lst as character no-undo .
     1122     define variable v-main-fld-lst    as character no-undo .
     1123     define variable v-delim-list      as character no-undo .
     1124     define variable v-label           as character no-undo .
     1125     define variable v-old-value       as character no-undo case-sensitive.
     1126     define variable v-new-value       as character no-undo case-sensitive.
     1127     define variable v-chg-fields as character no-undo.
     1128     for each temp-changes:
     1129       delete temp-changes.
     1130     end.
     1131     if not p-hst-handle:available then do:
     1132       return .
     1133     end.
     1134     create buffer h-new-buf  for table p-hst-handle .
     1135     create buffer h-main-buf for table p-main-table .
     1136     assign
     1137       v-inform = h-main-buf:index-information(1)
     1138       v-ind    = 2
     1139     .
     1140     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1141     on error undo, return error
     1142     :
     1143       assign
     1144         v-inform = h-main-buf:index-information( v-ind )
     1145         v-ind    = v-ind + 1
     1146       .
     1147     end.
     1148     if v-inform = ?
     1149       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1150       or entry( 3, v-inform, ",":U ) <> "1":U
     1151     then do:
     1152       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, h-main-buf:name ).
     1153     end.
     1154     assign
     1155       v-idx-field-qnty = num-entries( v-inform ) - 4
     1156     .
     1157     if v-idx-field-qnty < 2 then do:
     1158       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, h-main-buf:name ).
     1159     end.
     1160     assign
     1161       v-srch-main   = "where":U
     1162       v-word-link   = "":U
     1163       v-av-chip-num = false
     1164       v-delim-list  = "":U
     1165     .
     1166     do v-ind = 1 to v-idx-field-qnty by 2
     1167     on error undo, return error
     1168     :
     1169       assign
     1170         v-field-name      = entry( 4 + v-ind, v-inform, ",":U )
     1171         fh                = p-hst-handle:buffer-field( v-field-name )
     1172         fh-main           = h-main-buf:buffer-field( v-field-name )
     1173         v-srch-main       = substitute( "&1 &2 &3.&4 =", v-srch-main, v-word-link, fh-main:table, v-field-name )
     1174         v-main-pi-fld-lst = v-main-pi-fld-lst + v-delim-list + v-field-name
     1175       .
     1176       if fh:data-type ="character":U then do:
     1177         assign
     1178           v-srch-main = substitute( '&1 "&2"', v-srch-main, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
     1179         .
     1180       end.
     1181       else do:
     1182         assign
     1183           v-srch-main = substitute( "&1 &2", v-srch-main, fh:buffer-value() )
     1184         .
     1185       end.
     1186       if v-delim-list = "":U then do:
     1187         assign
     1188           v-delim-list = ",":U
     1189         .
     1190       end.
     1191       if v-word-link = "":U then do:
     1192         assign
     1193           v-word-link = "and":U
     1194         .
     1195       end.
     1196     end.
     1197     assign
     1198       v-delim-list  = "":U
     1199     .
     1200     do v-ind = 1 to h-main-buf:num-fields
     1201     on error undo, return error
     1202     :
     1203       assign
     1204         fh-main      = h-main-buf:buffer-field( v-ind )
     1205         v-field-name = fh-main:name
     1206       .
     1207         assign
     1208           v-main-fld-lst = v-main-fld-lst + v-delim-list + v-field-name
     1209         .
     1210         if v-delim-list = "":U then do:
     1211           assign
     1212             v-delim-list = ",":U
     1213           .
     1214         end.
     1215     end.
     1216     assign
     1217       v-inform = p-hst-handle:index-information(1)
     1218       v-ind    = 2
     1219     .
     1220     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1221     on error undo, return error
     1222     :
     1223       assign
     1224         v-inform = p-hst-handle:index-information( v-ind )
     1225         v-ind    = v-ind + 1
     1226       .
     1227     end.
     1228     if v-inform = ?
     1229       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1230       or entry( 3, v-inform, ",":U ) <> "1":U
     1231     then do:
     1232       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, p-hst-handle:name ).
     1233     end.
     1234     assign
     1235       v-idx-field-qnty = num-entries( v-inform ) - 4
     1236     .
     1237     if v-idx-field-qnty < 2 then do:
     1238       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, p-hst-handle:name ).
     1239     end.
     1240     assign
     1241       v-search-exp  = "where":U
     1242       v-word-link   = "":U
     1243       v-av-chip-num = false
     1244     .
     1245     do v-ind = 1 to v-idx-field-qnty by 2
     1246     on error undo, return error
     1247     :
     1248       assign
     1249         v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     1250         fh           = p-hst-handle:buffer-field( v-field-name )
     1251         v-search-exp = substitute( "&1 &2 &3.&4", v-search-exp, v-word-link, fh:table, v-field-name )
     1252       .
     1253       if v-field-name = "chip-num":U then do:
     1254         assign
     1255           v-search-exp  = substitute( "&1 >", v-search-exp )
     1256           v-av-chip-num = true
     1257         .
     1258       end.
     1259       else do:
     1260         assign
     1261           v-search-exp = substitute( "&1 =", v-search-exp )
     1262         .
     1263       end.
     1264       if fh:data-type ="character":U then do:
     1265         assign
     1266           v-search-exp = substitute( '&1 "&2"', v-search-exp, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
     1267         .
     1268       end.
     1269       else do:
     1270         assign
     1271           v-search-exp = substitute( '&1 &2', v-search-exp, fh:buffer-value() )
     1272         .
     1273       end.
     1274       if v-word-link = "":U then do:
     1275         assign
     1276           v-word-link = "and":U
     1277         .
     1278       end.
     1279     end.
     1280     if v-av-chip-num = false then do:
     1281       message
     1282         vss-workfile vss-revision vss-description skip
     1283         substitute( "Таблица &2 не содержит поля chip-num.", vss-workfile, p-hst-handle:name ) skip
     1284         "Использование данной процедуры невозможно!" skip
     1285         view-as alert-box error .
     1286       return error .
     1287     end.
     1288     h-new-buf:find-first( v-search-exp, no-lock ) no-error .
     1289     if not h-new-buf:available then do:
     1290       h-main-buf:find-first( v-srch-main, no-lock ) no-error .
     1291       if not h-main-buf:available then do:
     1292         assign
     1293           h-for-comp = ?
     1294         .
     1295       end.
     1296       else do:
     1297         assign
     1298           h-for-comp = h-main-buf
     1299         .
     1300       end.
     1301     end.
     1302     else do:
     1303       assign
     1304         h-for-comp = h-new-buf
     1305       .
     1306     end.
     1307     assign
     1308       v-num-entries = num-entries( v-main-fld-lst, ",":U )
     1309     .
     1310     do v-ind = 1 to v-num-entries
     1311     on error undo, return error return-value
     1312     :
     1313       assign
     1314         v-field-name = entry( v-ind, v-main-fld-lst )
     1315         fh-old       = p-hst-handle:buffer-field( v-field-name )
     1316         v-old-value  = fh-old:buffer-value()
     1317         v-label      = trim( fh-old:label )
     1318       .
     1319       if ( trim( p-field-list ) <> "":U
     1320            and lookup( v-field-name, p-field-list ) > 0
     1321          )
     1322          or trim( p-field-list ) = "":U
     1323       then do:
     1324         if h-for-comp <> ? then do:
     1325           assign
     1326             fh-new      = h-for-comp:buffer-field( v-field-name )
     1327             v-new-value = fh-new:buffer-value()
     1328           .
     1329         end.
     1330         else do:
     1331           assign
     1332             v-new-value = "":U
     1333           .
     1334         end.
     1335         if v-old-value <> v-new-value
     1336         then do:
     1337           create temp-changes.
     1338           assign
     1339             temp-changes.t_name = p-main-table
     1340             temp-changes.f_name = v-field-name
     1341             temp-changes.l_name = replace( v-label, "&":U, "":U )
     1342             temp-changes.v_old  = trim( v-old-value )
     1343             temp-changes.v_new  = trim( v-new-value )
     1344             temp-changes.num_   = 0
     1345             temp-changes.fNotChange = v-old-value eq v-new-value
     1346           .
     1347         end.
     1348       end.
     1349     end.
     1350     assign
     1351       v-num-entries = num-entries( p-label-form, chr(8) )
     1352     .
     1353     do v-ind = 1 to v-num-entries
     1354     on error undo, return error return-value
     1355     :
     1356       if num-entries( entry( v-ind, p-label-form, chr(8) ), chr(4) ) = 3 then do:
     1357         assign
     1358           v-field-name = entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1359           v-field-lvl  = entry( 2, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1360           v-field-form = entry( 3, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1361         .
     1362         find first temp-changes
     1363           where temp-changes.f_name = v-field-name
     1364           no-error .
     1365         if available temp-changes then do:
     1366           if trim( v-field-lvl ) <> "":U then do:
     1367             assign
     1368               temp-changes.l_name = v-field-lvl
     1369             .
     1370           end.
     1371           if trim( v-field-form ) <> "":U then do:
     1372             assign
     1373               temp-changes.v_old = dynamic-function( v-field-form, temp-changes.v_old )
     1374             .
     1375             if h-for-comp <> ? then do:
     1376               assign
     1377                 temp-changes.v_new = dynamic-function( v-field-form, temp-changes.v_new )
     1378               .
     1379             end.
     1380           end.
     1381         end.
     1382       end.
     1383       else do:
     1384         message
     1385           vss-workfile vss-revision vss-description skip
     1386           "Ошибка! Список должен содержать три поля с разделителем delim-par!" skip
     1387           substitute( "список для поля '&1': '&2'"
     1388                       ,entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1389                       ,entry( v-ind, p-label-form, chr(8) )
     1390                     ) skip
     1391           substitute( "полный список: &2", p-label-form ) skip
     1392           view-as alert-box error .
     1393       end.
     1394     end.
     1395     delete object h-new-buf .
     1396     delete object h-main-buf .
     1397   END PROCEDURE.
     1398   FUNCTION get-action RETURNS CHARACTER
     1399     ( p-action as integer )  FORWARD.
     1400   FUNCTION get-source-type RETURNS CHARACTER
     1401     ( p-source-type as character )  FORWARD.
     1402   FUNCTION get-subject RETURNS CHARACTER
     1403     ( p-subject as character )  FORWARD.
     1404   FUNCTION get-wealth RETURNS CHARACTER
     1405     ( p-wth-code as integer, p-par-code as integer, output p-wth-par-name as character)  FORWARD.
     1406   DEFINE BUTTON B-Help
     1407        LABEL "Помо&щь"
     1408        SIZE 3 BY 1
     1409        BGCOLOR 8 .
     1410   DEFINE BUTTON b-lkp
     1411        LABEL "&МЦ"
     1412        SIZE 10 BY 1.
     1413   DEFINE BUTTON B-mark
     1414        LABEL "&*"
     1415        SIZE 3 BY 1.
     1416   DEFINE BUTTON B-print
     1417        LABEL "Пе&чать"
     1418        SIZE 3 BY 1.
     1419   DEFINE BUTTON b-quit AUTO-END-KEY
     1420        LABEL "&Выход"
     1421        SIZE 10 BY 1
     1422        BGCOLOR 8 .
     1423   DEFINE BUTTON B-sch
     1424        LABEL "&Фильтр"
     1425        SIZE 3 BY 1.
     1426   DEFINE BUTTON b-sel AUTO-GO
     1427        LABEL "Вы&бор"
     1428        SIZE 10 BY 1
     1429        BGCOLOR 8 .
     1430   DEFINE BUTTON b-wth-obj
     1431        LABEL "&Остатки"
     1432        SIZE 10 BY 1.
     1433   DEFINE VARIABLE mark-num AS CHARACTER FORMAT "X(256)":U
     1434         VIEW-AS TEXT
     1435        SIZE 6 BY 1
     1436        FGCOLOR 4  NO-UNDO.
     1437   DEFINE VARIABLE sch-corr-date AS DATE FORMAT "99/99/9999":U
     1438        LABEL "Дате изменения"
     1439        VIEW-AS FILL-IN
     1440        SIZE 11 BY 1 NO-UNDO.
     1441   DEFINE VARIABLE sch-corr-user-name AS CHARACTER FORMAT "X(9)":U
     1442        LABEL "пользователю"
     1443        VIEW-AS FILL-IN
     1444        SIZE 12 BY 1 TOOLTIP "Поиск первой записи - <ВВОД>; поиск следующей - <CTRL-J>" NO-UNDO.
     1445   DEFINE VARIABLE sch-db-num AS INTEGER FORMAT ">>>>>>9":U INITIAL 0
     1446        LABEL "БД"
     1447        VIEW-AS FILL-IN
     1448        SIZE 8 BY 1 TOOLTIP "Поиск первой записи - <ВВОД>; поиск следующей - <CTRL-J>" NO-UNDO.
     1449   DEFINE VARIABLE sch-wth-code AS INTEGER FORMAT ">>>>>>9":U INITIAL 0
     1450        LABEL "коду МЦ"
     1451        VIEW-AS FILL-IN
     1452        SIZE 8 BY 1 TOOLTIP "Поиск первой записи - <ВВОД>; поиск следующей - <CTRL-J>" NO-UNDO.
     1453   DEFINE VARIABLE v-corr-user-db-num AS INTEGER FORMAT ">>>>9":U INITIAL 0
     1454        LABEL "по БД"
     1455        VIEW-AS FILL-IN
     1456        SIZE 6.5 BY 1 NO-UNDO.
     1457   DEFINE QUERY BR-changes FOR
     1458         temp-changes SCROLLING.
     1459   DEFINE QUERY br-wth-hist FOR
     1460         X_c-wth-hist SCROLLING.
     1461   DEFINE BROWSE BR-changes
     1462     QUERY BR-changes DISPLAY
     1463         temp-changes.l_name COLUMn-LABEL "Изменилось" format "X(40)"
     1464   temp-changes.v_old COLUMn-LABEL "Было" format "X(70)"
     1465   temp-changes.v_new COLUMn-LABEL "Стало" format "X(70)"
     1466       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 7.25.
     1467   DEFINE BROWSE br-wth-hist
     1468     QUERY br-wth-hist NO-LOCK DISPLAY
     1469         mark-string(recid(X_c-wth-hist), v-rid-list) COLUMN-LABEL "*" FORMAT "X(1)":U
     1470         X_c-wth-hist.wth-code FORMAT "999999999":U
     1471         X_c-wth-hist.corr-date FORMAT "99/99/9999":U
     1472         string(X_c-wth-hist.corr-time, "HH:MM:SS":U) COLUMN-LABEL "Время изм." FORMAT "X(8)":U
     1473         usrfulnf(X_c-wth-hist.corr-user-name) FORMAT "X(18)":U
     1474         get-action(X_c-wth-hist.action) COLUMN-LABEL "Действие" FORMAT "X(10)":U
     1475         X_c-wth-hist.corr-user-db-num FORMAT ">>>>9":U
     1476         X_c-wth-hist.is-news FORMAT "+/":U
     1477         get-source-type(X_c-wth-hist.source-type) COLUMN-LABEL "Источн.!измен."
     1478         X_c-wth-hist.source-ref FORMAT "X(14)":U
     1479         if v-find then get-wealth(X_c-wth-hist.wth-code, X_c-wth-hist.par-code, output v-wth-par-name) else "":U COLUMN-LABEL "Назв. МЦ" FORMAT "X(25)":U
     1480         v-wth-par-name COLUMN-LABEL "Номинал" FORMAT "X(14)":U
     1481         get-subject(X_c-wth-hist.subject) COLUMN-LABEL "Предмет изменений" FORMAT "X(15)":U
     1482         X_c-wth-hist.host-code COLUMN-LABEL "Фирма" FORMAT "99999":U
     1483         X_c-wth-hist.obj-type + string(X_c-wth-hist.obj-code) COLUMN-LABEL "Объект" FORMAT "X(8)":U
     1484     ENABLE
     1485         X_c-wth-hist.corr-date
     1486       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 11.46.
     1487   DEFINE FRAME Dialog-Frame
     1488        b-quit AT ROW 1 COL 1
     1489        B-mark AT ROW 1 COL 11
     1490        b-sel AT ROW 1 COL 21
     1491        v-corr-user-db-num AT ROW 1 COL 36 COLON-ALIGNED
     1492        b-wth-obj AT ROW 1 COL 55
     1493        B-print AT ROW 1 COL 89
     1494        B-sch AT ROW 1 COL 92
     1495        B-Help AT ROW 1 COL 95
     1496        b-lkp AT ROW 1.04 COL 45
     1497        br-wth-hist AT ROW 2 COL 1
     1498        sch-db-num AT ROW 13.63 COL 60.13 COLON-ALIGNED
     1499        sch-corr-date AT ROW 13.63 COL 85.75 COLON-ALIGNED
     1500        sch-wth-code AT ROW 13.67 COL 48.13 COLON-ALIGNED
     1501        sch-corr-user-name AT ROW 13.71 COL 22.5 COLON-ALIGNED
     1502        BR-changes AT ROW 14.79 COL 1
     1503        mark-num AT ROW 1 COL 12.5 COLON-ALIGNED NO-LABEL
     1504        "ПОИСК ПО" VIEW-AS TEXT
     1505             SIZE 8.38 BY 1 AT ROW 13.63 COL 1.38
     1506             FGCOLOR 4
     1507        SPACE(89.48) SKIP(7.44)
     1508       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1509            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1510            TITLE "Полная история по МЦ"
     1511            CANCEL-BUTTON b-quit.
     1512   ASSIGN
     1513          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1514          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1515   ON GO OF FRAME Dialog-Frame
     1516   DO:
     1517     p-rid-list = v-rid-list.
     1518   END.
     1519   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1520   DO:
     1521     APPLY "END-ERROR":U TO SELF.
     1522   END.
     1523   ON CHOOSE OF b-lkp IN FRAME Dialog-Frame
     1524   DO:
     1525     define variable rep-rec as recid no-undo .
     1526     DEFINE BUFFER buf_wealth FOR ub.wealth.
     1527     IF NOT AVAILABLE X_c-wth-hist THEN RETURN NO-APPLY.
     1528     FIND FIRST buf_wealth NO-LOCK WHERE
     1529            buf_wealth.wth-code = X_c-wth-hist.wth-code NO-ERROR.
     1530     if available buf_wealth then do:
     1531       rep-rec = recid (buf_wealth).
     1532       run ref/wth-form.w (
     1533                        input parparentproc
     1534                      , input buf_wealth.wth-code
     1535                      , input 'ПРОСМОТР':U
     1536                      , output rep-rec) NO-ERROR.
     1537        apply "entry" to br-wth-hist in frame Dialog-Frame.
     1538        return no-apply.
     1539     END.
     1540     ELSE DO:
     1541        MESSAGE
     1542        substitute("Неизвестная МЦ с кодом &1", X_c-wth-hist.wth-code)
     1543        VIEW-AS ALERT-BOX.
     1544     END.
     1545   END.
     1546   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
     1547   DO:
     1548   define variable loc#log as logical no-undo .
     1549     if available X_c-wth-hist then do:
     1550   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1551   define variable v-str-recid15 as character no-undo .
     1552   define variable v-num-entry15 as integer   no-undo .
     1553   assign
     1554     v-str-recid15 = trim( string( recid( X_c-wth-hist ) , "->>>>>>>>>>>9":U ) )
     1555     v-num-entry15 = lookup( v-str-recid15 , v-rid-list )
     1556   .
     1557   if v-num-entry15 > 0 then do:
     1558     assign
     1559       entry( v-num-entry15, v-rid-list ) = "":U
     1560       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1561     .
     1562   end.
     1563   else do:
     1564     assign
     1565       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid15
     1566     .
     1567   end.
     1568       loc#log = br-wth-hist:refresh() .
     1569       if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
     1570           loc#log = br-wth-hist:select-next-row ().
     1571           apply "VALUE-CHANGED" to br-wth-hist in frame Dialog-Frame.
     1572       end.
     1573       if num-entries( v-rid-list ) = 0
     1574       then
     1575           hide mark-num in frame Dialog-Frame.
     1576       else
     1577           disp num-entries( v-rid-list ) @ mark-num with frame Dialog-Frame.
     1578     end.
     1579     apply "entry" to br-wth-hist in frame Dialog-Frame.
     1580   END.
     1581   ON CHOOSE OF B-print IN FRAME Dialog-Frame
     1582   DO:
     1583       run proc-b-print in this-procedure no-error.
     1584     if error-status:error then return no-apply.
     1585   END.
     1586   ON CHOOSE OF B-sch IN FRAME Dialog-Frame
     1587   DO:
     1588       run proc-b-sch in this-procedure no-error.
     1589     if error-status:error then return no-apply.
     1590   END.
     1591   ON CHOOSE OF b-sel IN FRAME Dialog-Frame
     1592   DO:
     1593     if ( available X_c-wth-hist ) then do:
     1594       if ( v-rid-list = "" ) or b-mark:sensitive = no
     1595       then
     1596       v-rid-list = string( recid( X_c-wth-hist ) ) .
     1597     end.
     1598   END.
     1599   ON CHOOSE OF b-wth-obj IN FRAME Dialog-Frame
     1600   DO:
     1601   define variable v-rid-list as character no-undo .
     1602     run ref/cwthobj.w (
     1603        INPUT parparentproc
     1604       ,INPUT p-obj-type
     1605       ,INPUT p-obj-code
     1606       ,input '':U
     1607       ,INPUT 'ONE':U
     1608       ,input (if not available X_c-wth-hist
     1609               or X_c-wth-hist.obj-type = ''
     1610               then v-cntxt-obj-type
     1611               else X_c-wth-hist.obj-type)
     1612       ,input (if not available X_c-wth-hist
     1613               or X_c-wth-hist.obj-code = 0
     1614               then v-cntxt-obj-code
     1615               else  X_c-wth-hist.obj-code)
     1616       ,INPUT X_c-wth-hist.wth-code
     1617       ,INPUT-OUTPUT v-rid-list
     1618       ) no-error .
     1619     if error-status :error
     1620     then do:
     1621       return no-apply.
     1622     end.
     1623   END.
     1624   ON MOUSE-SELECT-DBLCLICK OF br-wth-hist IN FRAME Dialog-Frame
     1625   DO:
     1626        run proc-br-wth-hist in this-procedure no-error.
     1627     if error-status:error then return no-apply.
     1628   END.
     1629   ON RETURN OF br-wth-hist IN FRAME Dialog-Frame
     1630   DO:
     1631       run proc-br-wth-hist in this-procedure no-error.
     1632     if error-status:error then return no-apply.
     1633   END.
     1634   ON VALUE-CHANGED OF br-wth-hist IN FRAME Dialog-Frame
     1635   DO:
     1636     run proc-view-changes in this-procedure no-error.
     1637   END.
     1638   ON CTRL-J OF sch-corr-date IN FRAME Dialog-Frame
     1639   DO:
     1640      run proc-find-corr-date in this-procedure(yes, input frame Dialog-Frame sch-corr-date) no-error.
     1641     if error-status:error then return no-apply.
     1642   END.
     1643   ON RETURN OF sch-corr-date IN FRAME Dialog-Frame
     1644   DO:
     1645     run proc-find-corr-date in this-procedure(no, input frame Dialog-Frame sch-corr-date) no-error.
     1646     if error-status:error then return no-apply.
     1647   END.
     1648   ON CTRL-J OF sch-corr-user-name IN FRAME Dialog-Frame
