     1660     run proc-find-db-num in this-procedure(yes, input frame Dialog-Frame sch-db-num) no-error.
     1661     if error-status:error then return no-apply.
     1662   END.
     1663   ON RETURN OF sch-db-num IN FRAME Dialog-Frame
     1664   DO:
     1665     run proc-find-db-num in this-procedure(no, input frame Dialog-Frame sch-db-num) no-error.
     1666     if error-status:error then return no-apply.
     1667   END.
     1668   ON CTRL-J OF sch-wth-code IN FRAME Dialog-Frame
     1669   DO:
     1670     run proc-find-wth-code in this-procedure(yes, input frame Dialog-Frame sch-wth-code) no-error.
     1671     if error-status:error then return no-apply.
     1672   END.
     1673   ON RETURN OF sch-wth-code IN FRAME Dialog-Frame
     1674   DO:
     1675     run proc-find-wth-code in this-procedure(no, input frame Dialog-Frame sch-wth-code) no-error.
     1676     if error-status:error then return no-apply.
     1677   END.
     1678   ON RETURN OF v-corr-user-db-num IN FRAME Dialog-Frame
     1679   DO:
     1680     assign
     1681     v-corr-user-db-num
     1682     .
     1683     RUn OpenBR in this-procedure ( input yes, input no, input '':U, input v-corr-user-db-num).
     1684   END.
     1685   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1686   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1687   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1688   on help of frame Dialog-Frame
     1689   do:
     1690     run gbl/app_help.p
     1691       (input this-procedure :file-name
     1692       ,input ''
     1693       ,input ?
     1694       ) no-error.
     1695     if error-status :error then do:
     1696       message
     1697         "Ошибка при вызове помощи"
     1698         error-status :get-message(1)
     1699         view-as alert-box .
     1700     end.
     1701   end.
     1702   run minbtn-set in this-procedure .
     1703   on choose of b-help in frame Dialog-Frame
     1704   do:
     1705     apply "help":u to frame Dialog-Frame .
     1706   end.
     1707   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1708   procedure minbtn-set :
     1709       do
     1710           on error undo, return error return-value
     1711           :
     1712           define variable ii              as integer       no-undo .
     1713           define variable fh              as widget-handle no-undo .
     1714           define variable hh              as widget-handle no-undo .
     1715           define variable v-h             as handle        extent 4 no-undo .
     1716           define variable v-name-button   as character     no-undo .
     1717           define variable v-help-old-x    as decimal       no-undo .
     1718           define variable v-help-old-y    as decimal       no-undo .
     1719           define variable v-help-old-size as decimal       no-undo .
     1720           define variable v-frame-width   as decimal       no-undo .
     1721           define variable jj              as integer       no-undo .
     1722           do
     1723               on error undo, return error
     1724               :
     1725               assign
     1726                   v-frame-width = frame Dialog-Frame:width - 0.3
     1727                   fh            = frame Dialog-Frame:first-child
     1728                   hh            = fh:first-child
     1729                   ii            = 1
     1730                   .
     1731               do while valid-handle(hh):
     1732                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1733                   do:
     1734                       case lc(hh:name) :
     1735                           when "b-help" then
     1736                               do:
     1737                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1738                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1739                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1740                                   hh:TOOLTIP = "Помощь" .
     1741                                   v-help-old-x = hh:column .
     1742                                   v-help-old-y = hh:row    .
     1743                                   v-help-old-size = hh:width .
     1744                                   hh:width-chars = 2.5 .
     1745                               end.
     1746                           when "b-print" then
     1747                               do:
     1748                                   hh:load-image("cmp/b-print.bmp":u) .
     1749                                   hh:TOOLTIP = "Печать" .
     1750                                   v-h[ii] = hh:handle .
     1751                                   ii = ii + 1 .
     1752                                   hh:width-chars = 3 .
     1753                               end.
     1754                           when "b-history" or
     1755                           when "b-hist" then
     1756                               do:
     1757                                   hh:load-image("cmp/b-hist.bmp":u) .
     1758                                   hh:TOOLTIP = "История" .
     1759                                   v-h[ii] = hh:handle .
     1760                                   ii = ii + 1 .
     1761                                   hh:width-chars = 3 .
     1762                               end.
     1763                           when "b-sch" then
     1764                               do:
     1765                                   hh:load-image("cmp/b-sch.bmp":u) .
     1766                                   hh:TOOLTIP = "Установка Фильтра" .
     1767                                   v-h[ii] = hh:handle .
     1768                                   ii = ii + 1 .
     1769                                   hh:width-chars = 3 .
     1770                               end.
     1771                           when "b-hist-user" then
     1772                               do:
     1773                                   hh:load-image("cmp/b-hist.bmp":u) .
     1774                                   hh:TOOLTIP = "История пользователя" .
     1775                                   ii = ii + 1 .
     1776                               end.
     1777                       end case.
     1778                   end.
     1779                   hh = hh:next-sibling.
     1780               end.
     1781               b-help:column = v-frame-width - b-help:width-chars.
     1782               jj = 0.
     1783               repeat ii = 4 to 1 by -1 :
     1784                   if valid-handle (v-h[ii] ) then
     1785                   do:
     1786                       jj  = jj + 1 .
     1787                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1788                       v-h[ii]:row    = v-help-old-y .
     1789                   end.
     1790               end.
     1791           end.
     1792       end.
     1793   end procedure.
     1794   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1795   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1796   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1797   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1798   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1799   define variable v-diasize-current-frame-height as decimal   no-undo .
     1800   define variable v-diasize-change-size          as logical   no-undo .
     1801   define variable v-diasize-resize-button        as handle    no-undo .
     1802   define variable v-diasize-wndmax               as logical   no-undo .
     1803   define variable v-diasize-wndstore             as logical   no-undo .
     1804   define variable v-diasize-proc-name            as character no-undo .
     1805   define variable v-diasize-browse-handle        as handle    no-undo .
     1806   define variable v-diasize-browse-number        as integer   no-undo .
     1807   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1808   define temp-table temp-diasize-handle no-undo
     1809     field handle-value  as handle
     1810     field save-position as decimal
     1811     index xpk is primary unique handle-value
     1812     .
     1813   define temp-table temp-browse-handle no-undo
     1814     field browse-type   as character
     1815     field browse-number as integer
     1816     field browse-handle as handle
     1817     field original-size as decimal
     1818     index xpk is primary unique browse-type browse-number
     1819     index xie browse-type browse-handle
     1820   .
     1821   procedure diasize_change-height :
     1822     define input  parameter p-change-value  as decimal   no-undo .
     1823     define input  parameter p-move-resize   as logical   no-undo .
     1824     define variable v-field-group-handle    as handle    no-undo .
     1825     define variable v-object-handle         as handle    no-undo .
     1826     define variable v-frame-height          as decimal   no-undo .
     1827     define variable v-frame-virtual-height  as decimal   no-undo .
     1828     define variable v-browse-height         as decimal   no-undo .
     1829     define variable v-window-height         as decimal   no-undo .
     1830     define variable v-window-virtual-height as decimal   no-undo .
     1831     define variable v-change-sign           as integer   no-undo .
     1832     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1833     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1834     if p-change-value > 0
     1835     then do:
     1836       if frame Dialog-Frame :height + p-change-value
     1837           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1838       then do:
     1839         assign
     1840           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1841                           - (frame Dialog-Frame :height-chars)
     1842         .
     1843         if p-change-value <= 0
     1844         then do:
     1845           run diasize_position-resize-button in this-procedure .
     1846           return .
     1847         end.
     1848       end.
     1849     end.
     1850     if p-change-value < 0
     1851     then do:
     1852       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1853       then do:
     1854         assign
     1855           p-change-value = v-diasize-orig-frame-height
     1856                          - (frame Dialog-Frame :height-chars)
     1857         .
     1858         if p-change-value >= 0
     1859         then do:
     1860           run diasize_position-resize-button in this-procedure .
     1861           return .
     1862         end.
     1863       end.
     1864     end.
     1865     if p-change-value >= 0
     1866     then do:
     1867       assign
     1868         v-change-sign = 1
     1869       .
     1870     end.
     1871     else do:
     1872       assign
     1873         v-change-sign = -1
     1874       .
     1875     end.
     1876     assign
     1877       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1878     .
     1879     if p-change-value = 0
     1880     then do:
     1881       run diasize_position-resize-button in this-procedure .
     1882       return .
     1883     end.
     1884     move_block:
     1885     do
     1886     on error undo move_block, retry move_block
     1887     :
     1888       if retry
     1889       then do:
     1890         do
     1891         on error undo move_block, leave move_block
     1892         :
     1893           if p-change-value > 0
     1894           then do:
     1895             for each buf_temp-diasize-handle
     1896             on error undo, next
     1897             :
     1898               assign
     1899                 v-object-handle = buf_temp-diasize-handle.handle-value
     1900               .
     1901               if v-object-handle <> v-diasize-resize-button
     1902               then do:
     1903                 assign
     1904                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1905                 .
     1906               end.
     1907             end.
     1908             assign
     1909               v-diasize-browse-handle :height = v-browse-height
     1910             .
     1911             for each buf_temp-browse-handle
     1912               where buf_temp-browse-handle.browse-type = 'height':u
     1913             on error undo, next
     1914             :
     1915               assign
     1916                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1917               .
     1918             end.
     1919             assign
     1920               frame Dialog-Frame :height = v-frame-height
     1921             .
     1922             if frame Dialog-Frame :scrollable = true
     1923             then do:
     1924               assign
     1925                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1926               .
     1927             end.
     1928             run diasize_position-resize-button in this-procedure .
     1929           end.
     1930           else do:
     1931             if frame Dialog-Frame :scrollable = true
     1932             then do:
     1933               assign
     1934                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1935               .
     1936             end.
     1937             assign
     1938               frame Dialog-Frame :height = v-frame-height
     1939             .
     1940             assign
     1941               v-diasize-browse-handle :height = v-browse-height
     1942             .
     1943             for each buf_temp-browse-handle
     1944               where buf_temp-browse-handle.browse-type = 'height':u
     1945             on error undo, next
     1946             :
     1947               assign
     1948                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1949               .
     1950             end.
     1951             for each buf_temp-diasize-handle
     1952             on error undo, next
     1953             :
     1954               assign
     1955                 v-object-handle = buf_temp-diasize-handle.handle-value
     1956               .
     1957               if v-object-handle <> v-diasize-resize-button
     1958               then do:
     1959                 assign
     1960                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1961                 .
     1962               end.
     1963             end.
     1964             run diasize_position-resize-button in this-procedure .
     1965           end.
     1966           assign
     1967             v-diasize-change-size = false
     1968           .
     1969           leave move_block .
     1970         end.
     1971       end.
     1972       assign
     1973         v-diasize-need-full-display = true
     1974       .
     1975       if v-diasize-change-size = false
     1976       then do:
     1977         assign
     1978           v-diasize-change-size = true
     1979         .
     1980       end.
     1981       else do:
     1982         return .
     1983       end.
     1984       assign
     1985         v-frame-height = frame Dialog-Frame :height
     1986         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1987         v-browse-height = v-diasize-browse-handle :height
     1988       .
     1989       for each buf_temp-browse-handle
     1990         where buf_temp-browse-handle.browse-type = 'height':u
     1991       :
     1992         assign
     1993           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1994         .
     1995       end.
     1996       for each buf_temp-diasize-handle
     1997       :
     1998         delete buf_temp-diasize-handle .
     1999       end.
     2000       assign
     2001         v-field-group-handle = frame Dialog-Frame :first-child
     2002       .
     2003       do while valid-handle(v-field-group-handle)
     2004       :
     2005         assign
     2006           v-object-handle = v-field-group-handle :first-child
     2007         .
     2008         do while valid-handle(v-object-handle)
     2009         :
     2010           if  v-object-handle <> v-diasize-browse-handle :handle
     2011           and can-query(v-object-handle, "row")
     2012           and can-query(v-object-handle, "height")
     2013           and ( v-object-handle :row > v-diasize-browse-handle :row )
     2014           then do:
     2015             find first buf_temp-browse-handle
     2016               where buf_temp-browse-handle.browse-type   = 'height':u
     2017                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2018               no-error .
     2019             if available buf_temp-browse-handle
     2020             then do:
     2021             end.
     2022             else do:
     2023               create buf_temp-diasize-handle .
     2024               assign
     2025                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2026                 buf_temp-diasize-handle.save-position = v-object-handle :row
     2027               .
     2028             end.
     2029           end.
     2030           assign
     2031             v-object-handle = v-object-handle :next-sibling
     2032           .
     2033         end.
     2034         assign
     2035           v-field-group-handle = v-field-group-handle :next-sibling
     2036         .
     2037       end.
     2038       do with frame Dialog-Frame
     2039       :
     2040         hide v-diasize-resize-button .
     2041         assign
     2042           v-diasize-resize-button :row    = 1
     2043           v-diasize-resize-button :column = 1
     2044         .
     2045       end.
     2046       if p-change-value > 0
     2047       then do:
     2048         if frame Dialog-Frame :scrollable = true
     2049         then do:
     2050           assign
     2051             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2052             no-error .
     2053           if error-status :error
     2054           or error-status :get-message(1) <> ""
     2055           then do:
     2056             undo move_block, retry move_block .
     2057           end.
     2058         end.
     2059         assign
     2060           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2061           no-error .
     2062         if error-status :error
     2063         or error-status :get-message(1) <> ""
     2064         then do:
     2065           undo move_block, retry move_block .
     2066         end.
     2067         assign
     2068           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2069           no-error .
     2070         if error-status :error
     2071         or error-status :get-message(1) <> ""
     2072         then do:
     2073           undo move_block, retry move_block .
     2074         end.
     2075         for each buf_temp-browse-handle
     2076           where buf_temp-browse-handle.browse-type = 'height':u
     2077         on error undo move_block, retry move_block
     2078         :
     2079           assign
     2080             buf_temp-browse-handle.browse-handle :height
     2081               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2082             no-error .
     2083           if error-status :error
     2084           or error-status :get-message(1) <> ""
     2085           then do:
     2086             undo move_block, retry move_block .
     2087           end.
     2088         end.
     2089         for each buf_temp-diasize-handle
     2090         on error undo move_block, retry move_block
     2091         :
     2092           assign
     2093             v-object-handle = buf_temp-diasize-handle.handle-value
     2094           .
     2095           if v-object-handle <> v-diasize-resize-button
     2096           then do:
     2097             assign
     2098               v-object-handle :row = v-object-handle :row + p-change-value
     2099               no-error .
     2100             if error-status :error
     2101             or error-status :get-message(1) <> ""
     2102             then do:
     2103               undo move_block, retry move_block .
     2104             end.
     2105           end.
     2106         end.
     2107       end.
     2108       else do:
     2109         for each buf_temp-diasize-handle
     2110         on error undo move_block, retry move_block
     2111         :
     2112           assign
     2113             v-object-handle = buf_temp-diasize-handle.handle-value
     2114           .
     2115           if v-object-handle <> v-diasize-resize-button
     2116           then do:
     2117             assign
     2118               v-object-handle :row = v-object-handle :row + p-change-value
     2119               no-error .
     2120             if error-status :error
     2121             or error-status :get-message(1) <> ""
     2122             then do:
     2123               undo move_block, retry move_block .
     2124             end.
     2125           end.
     2126         end.
     2127         assign
     2128           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2129           no-error .
     2130         if error-status :error
     2131         or error-status :get-message(1) <> ""
     2132         then do:
     2133           undo move_block, retry move_block .
     2134         end.
     2135         for each buf_temp-browse-handle
     2136           where buf_temp-browse-handle.browse-type = 'height':u
     2137         on error undo move_block, retry move_block
     2138         :
     2139           assign
     2140             buf_temp-browse-handle.browse-handle :height
     2141               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2142             no-error .
     2143           if error-status :error
     2144           or error-status :get-message(1) <> ""
     2145           then do:
     2146             undo move_block, retry move_block .
     2147           end.
     2148         end.
     2149         assign
     2150           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2151           no-error .
     2152         if error-status :error
     2153         or error-status :get-message(1) <> ""
     2154         then do:
     2155           undo move_block, retry move_block .
     2156         end.
     2157         if frame Dialog-Frame :scrollable = true
     2158         then do:
     2159           assign
     2160             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2161             no-error .
     2162           if error-status :error
     2163           or error-status :get-message(1) <> ""
     2164           then do:
     2165             undo move_block, retry move_block .
     2166           end.
     2167         end.
     2168       end.
     2169       if p-move-resize = true
     2170       then do:
     2171         run diasize_position-resize-button in this-procedure .
     2172       end.
     2173       if v-diasize-wndstore = true
     2174       then do:
     2175         if connected("ub") = true
     2176         then do:
     2177           define variable v-cntxt-db-num        as integer   no-undo .
     2178           define variable v-cntxt-userid        as character no-undo .
     2179           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2180                                             , OUTPUT v-cntxt-userid
     2181                                             ) .
     2182           run gbl/wndsizew.p
     2183             (input  v-cntxt-db-num
     2184             ,input  v-cntxt-userid
     2185             ,input  v-diasize-proc-name
     2186             ,input  'height':u
     2187             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     2188             ) .
     2189         end.
     2190       end.
     2191     end.
     2192     assign
     2193       v-diasize-change-size = false
     2194     .
     2195   end procedure.
     2196   procedure diasize_set-height :
     2197     define input  parameter p-new-height  as decimal   no-undo .
     2198     define input  parameter p-move-resize as logical   no-undo .
     2199     do
     2200     on error undo, return error return-value
     2201     :
     2202       run diasize_change-height in this-procedure
     2203         (input  (p-new-height - frame Dialog-Frame :height)
     2204         ,input  p-move-resize
     2205         ) .
     2206     end.
     2207   end procedure.
     2208   procedure diasize_change-width :
     2209     define input  parameter p-change-value as decimal   no-undo .
     2210     define input  parameter p-move-resize  as logical   no-undo .
     2211     define variable v-field-group-handle   as handle    no-undo .
     2212     define variable v-object-handle        as handle    no-undo .
     2213     define variable v-frame-width          as decimal   no-undo .
     2214     define variable v-frame-virtual-width  as decimal   no-undo .
     2215     define variable v-browse-width         as decimal   no-undo .
     2216     define variable v-window-width         as decimal   no-undo .
     2217     define variable v-window-virtual-width as decimal   no-undo .
     2218     define variable v-change-sign          as integer   no-undo .
     2219     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2220     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2221     if p-change-value > 0
     2222     then do:
     2223       if frame Dialog-Frame :width + p-change-value >
     2224           session :width-chars
     2225       then do:
     2226         assign
     2227           p-change-value = session :width-chars - frame Dialog-Frame :width
     2228         .
     2229         if p-change-value <= 0
     2230         then do:
     2231           run diasize_position-resize-button in this-procedure .
     2232           return .
     2233         end.
     2234       end.
     2235     end.
     2236     if p-change-value < 0
     2237     then do:
     2238       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     2239       then do:
     2240         assign
     2241           p-change-value = v-diasize-orig-frame-width
     2242                          - frame Dialog-Frame :width
     2243         .
     2244         if p-change-value >= 0
     2245         then do:
     2246           run diasize_position-resize-button in this-procedure .
     2247           return .
     2248         end.
     2249       end.
     2250     end.
     2251     if p-change-value >= 0
     2252     then do:
     2253       assign
     2254         v-change-sign = 1
     2255       .
     2256     end.
     2257     else do:
     2258       assign
     2259         v-change-sign = -1
     2260       .
     2261     end.
     2262     assign
     2263       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2264     .
     2265     if p-change-value = 0
     2266     then do:
     2267       run diasize_position-resize-button in this-procedure .
     2268       return .
     2269     end.
     2270     move_block:
     2271     do
     2272     on error undo move_block, leave move_block
     2273     :
     2274       if retry
     2275       then do:
     2276         do
     2277         on error undo move_block, leave move_block
     2278         :
     2279           if p-change-value > 0
     2280           then do:
     2281             for each buf_temp-diasize-handle
     2282             on error undo, next
     2283             :
     2284               assign
     2285                 v-object-handle = buf_temp-diasize-handle.handle-value
     2286               .
     2287               if v-object-handle <> v-diasize-resize-button
     2288               then do:
     2289                 assign
     2290                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2291                 .
     2292               end.
     2293             end.
     2294             assign
     2295               v-diasize-browse-handle :width = v-browse-width
     2296             .
     2297             for each buf_temp-browse-handle
     2298               where buf_temp-browse-handle.browse-type = 'width':u
     2299             on error undo, next
     2300             :
     2301               assign
     2302                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2303               .
     2304             end.
     2305             assign
     2306               frame Dialog-Frame :width = v-frame-width
     2307             .
     2308             if frame Dialog-Frame :scrollable = true
     2309             then do:
     2310               assign
     2311                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2312               .
     2313             end.
     2314             run diasize_position-resize-button in this-procedure .
     2315           end.
     2316           else do:
     2317             if frame Dialog-Frame :scrollable = true
     2318             then do:
     2319               assign
     2320                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2321               .
     2322             end.
     2323             assign
     2324               frame Dialog-Frame :width = v-frame-width
     2325             .
     2326             for each buf_temp-browse-handle
     2327               where buf_temp-browse-handle.browse-type = 'width':u
     2328             on error undo, next
     2329             :
     2330               assign
     2331                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2332               .
     2333             end.
     2334             assign
     2335               v-diasize-browse-handle :width = v-browse-width
     2336             .
     2337             for each buf_temp-diasize-handle
     2338             on error undo, next
     2339             :
     2340               assign
     2341                 v-object-handle = buf_temp-diasize-handle.handle-value
     2342               .
     2343               if v-object-handle <> v-diasize-resize-button
     2344               then do:
     2345                 assign
     2346                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2347                 .
     2348               end.
     2349             end.
     2350             run diasize_position-resize-button in this-procedure .
     2351           end.
     2352           assign
     2353             v-diasize-change-size = false
     2354           .
     2355           leave move_block .
     2356         end.
     2357       end.
     2358       assign
     2359         v-diasize-need-full-display = true
     2360       .
     2361       if v-diasize-change-size = false
     2362       then do:
     2363         assign
     2364           v-diasize-change-size = true
     2365         .
     2366       end.
     2367       else do:
     2368         return .
     2369       end.
     2370       assign
     2371         v-frame-width = frame Dialog-Frame :width
     2372         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     2373         v-browse-width = v-diasize-browse-handle :width
     2374       .
     2375       for each buf_temp-browse-handle
     2376         where buf_temp-browse-handle.browse-type = 'width':u
     2377       :
     2378         assign
     2379           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2380         .
     2381       end.
     2382       for each buf_temp-diasize-handle
     2383       :
     2384         delete buf_temp-diasize-handle .
     2385       end.
     2386       assign
     2387         v-field-group-handle = frame Dialog-Frame :first-child
     2388       .
     2389       do while valid-handle(v-field-group-handle)
     2390       :
     2391         assign
     2392           v-object-handle = v-field-group-handle :first-child
     2393         .
     2394         do while valid-handle(v-object-handle)
     2395         :
     2396           if  v-object-handle <> v-diasize-browse-handle :handle
     2397           and v-object-handle <> v-diasize-resize-button
     2398           and can-query(v-object-handle, "row")
     2399           and can-query(v-object-handle, "height")
     2400           and ( v-object-handle :col + v-object-handle :width
     2401                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2402               )
     2403           then do:
     2404             find first buf_temp-browse-handle
     2405               where buf_temp-browse-handle.browse-type   = 'width':u
     2406                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2407               no-error .
     2408             if available buf_temp-browse-handle
     2409             then do:
     2410             end.
     2411             else do:
     2412               create buf_temp-diasize-handle .
     2413               assign
     2414                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2415                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2416               .
     2417             end.
     2418           end.
     2419           assign
     2420             v-object-handle = v-object-handle :next-sibling
     2421           .
     2422         end.
     2423         assign
     2424           v-field-group-handle = v-field-group-handle :next-sibling
     2425         .
     2426       end.
     2427       do with frame Dialog-Frame
     2428       :
     2429         hide v-diasize-resize-button .
     2430         v-diasize-resize-button :row = 1.
     2431         v-diasize-resize-button :column = 1.
     2432       end.
     2433       if p-change-value > 0
     2434       then do:
     2435         if frame Dialog-Frame :scrollable = true
     2436         then do:
     2437           assign
     2438             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2439             no-error .
     2440           if error-status :error
     2441           or error-status :get-message(1) <> ""
     2442           then do:
     2443             undo move_block, retry move_block.
     2444           end.
     2445         end.
     2446         assign
     2447           frame Dialog-Frame :width = v-frame-width + p-change-value
     2448           no-error .
     2449         if error-status :error
     2450         or error-status :get-message(1) <> ""
     2451         then do:
     2452           undo move_block, retry move_block.
     2453         end.
     2454         assign
     2455           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2456         no-error .
     2457         if error-status :error
     2458         or error-status :get-message(1) <> ""
     2459         then do:
     2460           undo move_block, retry move_block.
     2461         end.
     2462         for each buf_temp-browse-handle
     2463           where buf_temp-browse-handle.browse-type = 'width':u
     2464         on error undo move_block, retry move_block
     2465         :
     2466           assign
     2467             buf_temp-browse-handle.browse-handle :width
     2468               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2469             no-error .
     2470           if error-status :error
     2471           or error-status :get-message(1) <> ""
     2472           then do:
     2473             undo move_block, retry move_block .
     2474           end.
     2475         end.
     2476         for each buf_temp-diasize-handle
     2477         on error undo move_block, retry move_block
     2478         :
     2479           assign
     2480             v-object-handle = buf_temp-diasize-handle.handle-value
     2481           .
     2482           if v-object-handle <> v-diasize-resize-button
     2483           then do:
     2484             assign
     2485               v-object-handle :col = v-object-handle :col + p-change-value
     2486               no-error .
     2487             if error-status :error
     2488             or error-status :get-message(1) <> ""
     2489             then do:
     2490               undo move_block, retry move_block .
     2491             end.
     2492           end.
     2493         end.
     2494       end.
     2495       else do:
     2496         for each buf_temp-diasize-handle
     2497         on error undo move_block, retry move_block
     2498         :
     2499           assign
     2500             v-object-handle = buf_temp-diasize-handle.handle-value
     2501           .
     2502           if v-object-handle <> v-diasize-resize-button
     2503           then do:
     2504             assign
     2505               v-object-handle :col = v-object-handle :col + p-change-value
     2506               no-error .
     2507             if error-status :error
     2508             or error-status :get-message(1) <> ""
     2509             then do:
     2510               undo move_block, retry move_block .
     2511             end.
     2512           end.
     2513         end.
     2514         for each buf_temp-browse-handle
     2515           where buf_temp-browse-handle.browse-type = 'width':u
     2516         on error undo move_block, retry move_block
     2517         :
     2518           assign
     2519             buf_temp-browse-handle.browse-handle :width
     2520               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2521             no-error .
     2522           if error-status :error
     2523           or error-status :get-message(1) <> ""
     2524           then do:
     2525             undo move_block, retry move_block .
     2526           end.
     2527         end.
     2528         assign
     2529           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2530           no-error .
     2531         if error-status :error
     2532         or error-status :get-message(1) <> ""
     2533         then do:
     2534           undo move_block, retry move_block.
     2535         end.
     2536         assign
     2537           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2538         no-error .
     2539         if error-status :error
     2540         or error-status :get-message(1) <> ""
     2541         then do:
     2542           undo move_block, retry move_block.
     2543         end.
     2544         if frame Dialog-Frame :scrollable = true
     2545         then do:
     2546           assign
     2547             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2548           no-error .
     2549           if error-status :error
     2550           or error-status :get-message(1) <> ""
     2551           then do:
     2552             undo move_block, retry move_block.
     2553           end.
     2554         end.
     2555       end.
     2556       if p-move-resize
     2557       then do:
     2558         run diasize_position-resize-button in this-procedure .
     2559       end.
     2560       if v-diasize-wndstore = true
     2561       then do:
     2562         if connected("ub") = true
     2563         then do:
     2564           define variable v-cntxt-db-num        as integer   no-undo .
     2565           define variable v-cntxt-userid        as character no-undo .
     2566           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2567                                             , OUTPUT v-cntxt-userid
     2568                                             ) .
     2569           run gbl/wndsizew.p
     2570             (input  v-cntxt-db-num
     2571             ,input  v-cntxt-userid
     2572             ,input  v-diasize-proc-name
     2573             ,input  'width':u
     2574             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2575             ) .
     2576         end.
     2577       end.
     2578     end.
     2579     assign
     2580       v-diasize-change-size = false
     2581     .
     2582   end procedure.
     2583   procedure diasize_set-width :
     2584     define input  parameter p-new-width  as decimal   no-undo .
     2585     define input  parameter p-move-resize as logical   no-undo .
     2586     do
     2587     on error undo, return error return-value
     2588     :
     2589       run diasize_change-width in this-procedure
     2590         (input  (p-new-width - frame Dialog-Frame :width)
     2591         ,input  p-move-resize
     2592         ) .
     2593     end.
     2594   end procedure.
     2595   procedure diasize_position-resize-button :
     2596     do with frame Dialog-Frame
     2597     :
     2598       hide v-diasize-resize-button .
     2599       assign
     2600         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2601                     - 1
     2602                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2603         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2604                     - 1
     2605                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2606       .
     2607       view v-diasize-resize-button .
     2608     end.
     2609   end procedure.
     2610   on alt-right anywhere
     2611   do:
     2612     run diasize_change-width in this-procedure
     2613       (input 1
     2614       ,input true
     2615       ) .
     2616     return no-apply .
     2617   end.
     2618   on alt-left anywhere
     2619   do:
     2620     run diasize_change-width in this-procedure
     2621       (input -1
     2622       ,input true
     2623       ) .
     2624     return no-apply .
     2625   end.
     2626   on alt-down anywhere
     2627   do:
     2628     run diasize_change-height in this-procedure
     2629       (input 1
     2630       ,input true
     2631       ) .
     2632     return no-apply .
     2633   end.
     2634   on alt-up anywhere
     2635   do:
     2636     run diasize_change-height in this-procedure
     2637       (input -1
     2638       ,input true
     2639       ) .
     2640     return no-apply .
     2641   end.
     2642   on alt-enter of frame Dialog-Frame
     2643   do:
     2644     run diasize_maximize in this-procedure
     2645       (input  ?
     2646       ).
     2647     return no-apply .
     2648   end.
     2649   procedure diasize_end-move :
     2650     do
     2651     on error undo, return error return-value
     2652     :
     2653       define variable v-row-delta as decimal   no-undo .
     2654       define variable v-col-delta as decimal   no-undo .
     2655       define variable v-new-row as decimal   no-undo .
     2656       define variable v-new-col as decimal   no-undo .
     2657       assign
     2658         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2659         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2660       .
     2661       assign
     2662         v-row-delta = v-new-row - frame Dialog-Frame :height
     2663         v-col-delta = v-new-col - frame Dialog-Frame :width
     2664       .
     2665       run diasize_change-height in this-procedure
     2666         (input v-row-delta
     2667         ,input true
     2668         ) .
     2669       run diasize_change-width in this-procedure
     2670         (input v-col-delta
     2671         ,input true
     2672         ) .
     2673     end.
     2674   end procedure.
     2675   procedure diasize_maximize :
     2676     define input  parameter p-action as logical   no-undo .
     2677     do
     2678     on error undo, return error return-value
     2679     :
     2680       if p-action = ?
     2681       then do:
     2682         if v-diasize-need-maximize = true
     2683         then do:
     2684           assign
     2685             p-action = true
     2686           .
     2687         end.
     2688         else do:
     2689           assign
     2690             p-action = false
     2691           .
     2692         end.
     2693       end.
     2694       if p-action = true
     2695       then do:
     2696         run diasize_change-height in this-procedure
     2697           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2698               - frame Dialog-Frame :height-chars
     2699           ,input true
     2700           ) .
     2701         run diasize_change-width in this-procedure
     2702           (input session :width-chars
     2703               - frame Dialog-Frame :width-chars
     2704           ,input true
     2705           ) .
     2706         assign
     2707           v-diasize-need-maximize = false
     2708         .
     2709       end.
     2710       else do:
     2711         run diasize_change-width in this-procedure
     2712           (input v-diasize-orig-frame-width
     2713               - frame Dialog-Frame :width-chars
     2714           ,input true
     2715           ) .
     2716         run diasize_change-height in this-procedure
     2717           (input v-diasize-orig-frame-height
     2718               - frame Dialog-Frame :height-chars
     2719           ,input true
     2720           ) .
     2721         assign
     2722           v-diasize-need-maximize = true
     2723         .
     2724       end.
     2725     end.
     2726   end procedure.
     2727   procedure diasize_restore-orig-size :
