     2996        )
     2997     or (can-query (self, "read-only")
     2998        and
     2999        self :read-only = false
     3000        )
     3001     then do:
     3002       assign
     3003         self :screen-value = ?
     3004       .
     3005     end.
     3006     return no-apply.
     3007   end.
     3008   on delete-character of sch-corr-date in frame Dialog-Frame
     3009   do:
