      625   procedure fltfield-clear :
      626     define output parameter loc-fld as character no-undo.
      627     define output parameter loc-lab as character no-undo .
      628     define output parameter loc-spr as character no-undo .
      629     define output parameter loc-dim as character no-undo .
      630     assign
      631       loc-fld = ""
      632       loc-lab = ""
      633       loc-spr = ""
      634       loc-dim = "0"
      635     .
      636   end procedure .
      637   procedure fltfield-add :
      638     define input        parameter par-fld as character no-undo.
      639     define input        parameter par-lab as character no-undo .
      640     define input        parameter par-spr as character no-undo .
      641     define input-output parameter loc-fld as character no-undo.
      642     define input-output parameter loc-lab as character no-undo .
      643     define input-output parameter loc-spr as character no-undo .
      644     define input-output parameter loc-dim as character no-undo .
      645     do
      646     on error undo, return error
      647     :
      648       assign
      649       loc-fld = if loc-dim = '0'
      650                 then par-fld
      651                 else (loc-fld + chr(44) + par-fld)
      652       loc-lab = if loc-dim = '0'
      653                 then par-lab
      654                 else (loc-lab + chr(44) + par-lab)
      655       loc-spr = if loc-dim = '0'
      656                 then par-spr
      657                 else (loc-spr + chr(44) + par-spr)
      658       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
      659                 string(integer(if num-entries(loc-dim) > 1
      660                               then entry(2, loc-dim)
      661                               else entry(1, loc-dim)
      662                               ) + 1)
      663       no-error
      664       .
      665     end.
      666   end procedure.
