     1650     run proc-find-user in this-procedure(yes, input frame Dialog-Frame sch-corr-user-name) no-error.
     1651     if error-status:error then return no-apply.
     1652   END.
     1653   ON RETURN OF sch-corr-user-name IN FRAME Dialog-Frame
     1654   DO:
     1655     run proc-find-user in this-procedure(no, input frame Dialog-Frame sch-corr-user-name) no-error.
     1656     if error-status:error then return no-apply.
     1657   END.
     1658   ON CTRL-J OF sch-db-num IN FRAME Dialog-Frame
