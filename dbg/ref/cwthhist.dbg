     3213   def var sort-labelbr-wth-hist   as character no-undo .
     3214   def var sort-clmnbr-wth-hist    as handle    no-undo .
     3215   def var cur-clmnbr-wth-hist     as handle    no-undo .
     3216   def var cur-clmn-locbr-wth-hist as integer   no-undo .
     3217   def var re-querybr-wth-hist     as logical   initial no no-undo .
     3218   on start-search, ctrl-o of br-wth-hist in frame Dialog-Frame do:
     3219      run sort-brbr-wth-hist
     3220        (input (if available X_c-wth-hist
     3221                then recid(X_c-wth-hist)
     3222                else ?
     3223               )
     3224        ).
     3225   end.
     3226   PROCEDURE sort-brbr-wth-hist :
     3227     define input parameter p-recid as recid no-undo .
     3228     if re-querybr-wth-hist = no then do:
     3229       assign
     3230          cur-clmnbr-wth-hist = br-wth-hist:current-column in frame Dialog-Frame
     3231       .
     3232       if sort-clmnbr-wth-hist <> ? then sort-clmnbr-wth-hist:column-fgcolor = 0.
     3233       if cur-clmnbr-wth-hist = sort-clmnbr-wth-hist then do:
     3234         assign
     3235            sort-labelbr-wth-hist = ""
     3236            sort-clmnbr-wth-hist = ?
     3237         .
     3238        end.
     3239        else do:
     3240          assign
     3241            sort-labelbr-wth-hist = cur-clmnbr-wth-hist:label
     3242            sort-clmnbr-wth-hist  = cur-clmnbr-wth-hist
     3243            sort-clmnbr-wth-hist:column-fgcolor = 4
     3244          .
     3245        end.
     3246      end.
     3247     assign
     3248       cur-clmn-locbr-wth-hist = 1
     3249     .
     3250     def var column-handle as handle no-undo .
     3251     column-handle = br-wth-hist:first-column.
     3252     do while valid-handle(column-handle) :
     3253       if column-handle = cur-clmnbr-wth-hist then do:
     3254         leave .
     3255       end.
     3256       column-handle = column-handle:NEXT-COLUMN.
     3257       assign
     3258         cur-clmn-locbr-wth-hist = cur-clmn-locbr-wth-hist + 1
     3259       .
     3260     end.
     3261     case sort-labelbr-wth-hist:
     3262           when X_c-wth-hist.wth-code:label in browse br-wth-hist then DO:    assign       sort-column-name = "X_c-wth-hist.wth-code"     .     run OpenBr in this-procedure ( input yes, input no, input no, input v-corr-user-db-num).   . END.
     3263           when X_c-wth-hist.corr-date:label in browse br-wth-hist then DO:    assign       sort-column-name = "X_c-wth-hist.corr-date"     .     run OpenBr in this-procedure ( input yes, input no, input no, input v-corr-user-db-num).   . END.
     3264           when X_c-wth-hist.corr-user-db-num:label in browse br-wth-hist then DO:    assign       sort-column-name = "X_c-wth-hist.corr-user-db-num"     .     run OpenBr in this-procedure ( input yes, input no, input no, input v-corr-user-db-num).   . END.
     3265       otherwise do:
     3266         assign
     3267           sort-column-name = ""
     3268         .
     3269         run OpenBr in this-procedure ( input yes, input no, input no, input v-corr-user-db-num).
     3270           if can-do( this-procedure:internal-entries, 'mv-brw-defaultbr-wth-hist') then do:
     3271             run mv-brw-defaultbr-wth-hist.
     3272           end.
     3273         if sort-labelbr-wth-hist <> "" then do:
     3274           assign
     3275             cur-clmnbr-wth-hist:column-fgcolor = 0
     3276           .
     3277         end.
     3278         assign
     3279           cur-clmn-locbr-wth-hist = ?
     3280         .
     3281       end.
     3282     end case.
     3283       if cur-clmn-locbr-wth-hist <> ? then do:
     3284         if can-do( this-procedure:internal-entries, 'ch-clmnbr-wth-hist') then do:
     3285           run ch-clmnbr-wth-hist in this-procedure (cur-clmn-locbr-wth-hist).
     3286         end.
     3287       end.
     3288     if p-recid <> ? then do:
     3289       reposition br-wth-hist to recid p-recid no-error.
     3290       apply "value-changed" to br-wth-hist in frame Dialog-Frame.
     3291     end.
     3292     apply "entry" to br-wth-hist in frame Dialog-Frame.
     3293   END PROCEDURE.
     3294   procedure re-open-query-srt-clmnbr-wth-hist:
     3295   if cur-clmnbr-wth-hist = ? then do:
     3296      run OpenBr in this-procedure ( input yes, input no, input no, input v-corr-user-db-num).
     3297   end.
     3298   else do:
