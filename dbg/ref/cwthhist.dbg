     3345       vss-workfile vss-revision vss-description skip
     3346       "Неверное значение параметра вызова p-curr-host-code"
     3347       p-curr-host-code
     3348       view-as alert-box ERROR.
     3349       return.
     3350     end.
     3351   end.
     3352    if p-mode = 'фирма':U then do:
     3353     find first X_clients no-lock where
     3354                   X_clients.obj-type = 'орг':U
     3355               and X_clients.obj-code = p-host-code no-error.
     3356       if not available X_clients then do:
     3357           message
     3358           vss-workfile vss-revision vss-description skip
     3359           "Неверное значение параметра вызова p-host-code"
     3360           p-curr-host-code
     3361           view-as alert-box ERROR.
     3362           return.
     3363       end.
     3364       find first X_sysconf no-lock where
     3365                       X_sysconf.host-code = p-host-code no-error.
     3366       if not available X_sysconf then do:
     3367         message
     3368         vss-workfile vss-revision vss-description skip
     3369         "Неверное значение параметра вызова p-host-code"
     3370         p-host-code
     3371         view-as alert-box ERROR.
     3372         return.
     3373       end.
     3374     end.
     3375    if p-mode = 'объект':U then do:
     3376     find first X_clients no-lock where
     3377                   X_clients.obj-type = p-obj-type
     3378               and X_clients.obj-code = p-obj-code no-error.
     3379       if not available X_clients then do:
     3380           message
     3381           vss-workfile vss-revision vss-description skip
     3382           "Неверное значение параметра вызова p-obj-type/p-obj-code"
     3383           p-obj-type p-obj-code
     3384           view-as alert-box ERROR.
     3385           return.
     3386       end.
     3387    end.
     3388    if p-mode = "one":U then do:
     3389     find first X_wealth no-lock where
     3390                   X_wealth.wth-code = p-wth-code no-error.
     3391       if not available X_wealth then do:
     3392           message
     3393           vss-workfile vss-revision vss-description skip
     3394           "Неверное значение параметра вызова p-wth-code" p-wth-code
     3395           view-as alert-box ERROR.
     3396           return.
     3397       end.
     3398     end.
     3399    if p-mode = "db-num":U then do:
     3400     find first X_db no-lock where
     3401                   X_db.db-num = p-corr-user-db-num no-error.
     3402       if not available X_db then do:
     3403           message
     3404           vss-workfile vss-revision vss-description skip
     3405           "Неверное значение параметра вызова p-corr-user-db-num" p-corr-user-db-num
     3406           view-as alert-box ERROR.
     3407           return.
     3408       end.
     3409     end.
     3410     v-rid-list = p-rid-list.
     3411     if v-rid-list <> "" then do:
     3412         FIND FIRST find_c-wth-hist No-LOCK where
     3413                    recid(find_c-wth-hist) = integer(entry(1, v-rid-list)) No-ERROR.
     3414         if not avail find_c-wth-hist then do:
     3415           message
     3416           vss-workfile vss-revision vss-description skip
     3417           "Неверное значение параметра вызова v-rid-list" v-rid-list
     3418           view-as alert-box error .
     3419           return error.
     3420         end.
     3421         v-doc-rec = integer(entry(1, v-rid-list)).
     3422       end.
     3423   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3424   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
     3425     (output v-db-num
     3426     )  .
     3427     if p-mode <> 'все':U then do:
     3428       assign
     3429       v-find = yes.
     3430       end.
     3431       else do:
     3432       assign
     3433       v-wth-name = get-wealth(p-wth-code, p-par-code, output v-wth-par-name)
     3434       .
