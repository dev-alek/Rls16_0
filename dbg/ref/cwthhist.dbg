      137   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      138   define variable c-point  as character no-undo .
      139   define variable tbl      as character no-undo .
      140   define variable join-tbl as character no-undo .
      141   define variable fld      as character no-undo .
      142   define variable lab      as character no-undo .
      143   define variable spr      as character no-undo .
      144   define variable dim      as character no-undo .
      145   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      146   procedure cur-time :
      147      define output parameter p-today as date      no-undo .
      148      define output parameter p-time  as integer   no-undo .
      149     do
      150     on error undo, return error
      151     :
      152       define variable v-date1 as date      no-undo .
      153       define variable v-date2 as date      no-undo .
      154       define variable v-time  as integer   no-undo .
      155       assign
      156         v-date1 = today
      157         v-time  = time
      158         v-date2 = today
      159       .
      160       if v-date1 <> v-date2
      161       then do:
      162         assign
      163           v-date1 = today
      164           v-time  = v-time
      165         .
      166       end.
      167       assign
      168         p-today = v-date1
      169         p-time  = v-time
      170       .
      171     end.
      172   end.
      173   function cur-time-date returns character
      174   :
      175     return string(today, '99/99/9999':U) .
      176   end.
      177   function cur-time-mjd returns decimal
      178   :
      179     define variable v-date as date      no-undo .
      180     define variable v-time as integer   no-undo .
      181     run cur-time in this-procedure
      182       (output v-date
      183       ,output v-time
      184       ) .
      185     return integer(v-date) - 2400002 + (v-time / 86400) .
      186   end.
      187   function cur-time-get-ending-index returns integer
      188   (input p-number as integer
      189   )
      190   :
      191     if p-number < 0
      192     or p-number = ?
      193     then do:
      194       return 1 .
      195     end.
      196     define variable v-rest as integer   no-undo .
      197     assign
      198       p-number = p-number modulo 100
      199     .
      200     if p-number < 20
      201     then do:
      202       assign
      203         v-rest = p-number
      204       .
      205     end.
      206     else do:
      207       assign
      208         v-rest = p-number modulo 10
      209       .
      210     end.
      211     case v-rest :
      212       when 1
      213       then do:
      214         return 2 .
      215       end.
      216       when 2 or
      217       when 3 or
      218       when 4
      219       then do:
      220         return 3 .
      221       end.
      222       otherwise do:
      223         return 1 .
      224       end.
      225     end case .
      226   end.
      227   procedure cur-time-mjd-to-date :
      228      define input  parameter i-mjd-diff as decimal no-undo.
      229      define output parameter o-Date     as date    no-undo.
      230      define output parameter o-Time     as integer no-undo.
      231      define variable v-day-number as integer   no-undo .
      232      if    i-mjd-diff < 0
      233         or i-mjd-diff = ?
      234      then do:
      235         return "?" .
      236      end.
      237      assign
      238         v-day-number = truncate(i-mjd-diff,0).
      239         o-Date = date(v-day-number + 2400002).
      240         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      241     .
      242   end.
      243   function cur-time-mjd-to-string returns character
      244   (input p-mjd-diff as decimal
      245   )
      246   :
      247     define variable v-day-number as integer   no-undo .
      248     define variable v-seconds    as integer   no-undo .
      249     define variable v-hour       as integer   no-undo .
      250     define variable v-min        as integer   no-undo .
      251     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      252     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      253     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      254     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      255     if p-mjd-diff < 0
      256     or p-mjd-diff = ?
      257     then do:
      258       return "?" .
      259     end.
      260     assign
      261       v-day-number = integer(truncate(p-mjd-diff,0))
      262       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      263     .
      264     if v-seconds > 86400
      265     then do:
      266       assign
      267         v-seconds = 86400 - 1
      268       .
      269     end.
      270     if v-seconds < 0
      271     then do:
      272       assign
      273         v-seconds = 0
      274       .
      275     end.
      276     assign
      277       v-hour = truncate(v-seconds / 3600, 0)
      278     .
      279     assign
      280       v-seconds = v-seconds modulo 3600
      281     .
      282     assign
      283       v-min = truncate(v-seconds / 60, 0)
      284     .
      285     assign
      286       v-seconds = v-seconds modulo 60
      287     .
      288     return
      289         (if v-day-number <> 0
      290           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      291           else ""
      292         )
      293       + (if v-day-number <> 0 or v-hour <> 0
      294           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      295           else ""
      296         )
      297       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      298           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      299           else ""
      300         )
      301       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      302       .
      303   end.
      304   function cur-time-string returns character
      305   :
      306     define variable v-date as date      no-undo .
      307     define variable v-time as integer   no-undo .
      308     run cur-time in this-procedure
      309       (output v-date
      310       ,output v-time
      311       ) .
      312     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      313   end.
      314   function cur-time-string-sec returns character
      315   :
      316     define variable v-date as date      no-undo .
      317     define variable v-time as integer   no-undo .
      318     run cur-time in this-procedure
      319       (output v-date
      320       ,output v-time
      321       ) .
      322     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      323   end.
      324   function cur-time-custom  returns character
      325   (input p-prefix as character
      326   ,input p-date-format as character
      327   ,input p-delimiter as character
      328   ,input p-time-format as character
      329   ,input p-suffix as character
      330   )
      331   :
      332     define variable v-date as date      no-undo .
      333     define variable v-time as integer   no-undo .
      334     run cur-time in this-procedure
      335       (output v-date
      336       ,output v-time
      337       ) .
      338     return
      339       p-prefix
      340       + string(v-date, p-date-format)
      341       + p-delimiter
      342       + string(v-time, p-time-format)
      343       + p-suffix
      344       .
      345   end.
      346   function cur-time-print  returns character
      347   :
      348     define variable v-date as date      no-undo .
      349     define variable v-time as integer   no-undo .
      350     run cur-time in this-procedure
      351       (output v-date
      352       ,output v-time
      353       ) .
      354     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      355   end.
      356   function cur-time-datetime returns datetime
      357   :
      358     define variable v-char as character no-undo .
      359     define variable v-datetime as datetime no-undo .
      360     v-char = cur-time-string().
      361     v-datetime = datetime(v-char).
      362     return  v-datetime.
      363   end.
      364   function cur-time-string-msec returns character
      365   :
      366     define variable v-date as datetime  no-undo .
      367     v-date = now.
      368     return string(v-date) .
      369   end.
      370   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      371   define new shared variable PrintCopiesCounter as integer   no-undo initial 1 .
      372   define new shared variable RepPathName        as character no-undo .
      373   define new shared variable PrintRubl          as logical   no-undo .
      374   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      375   define variable v-waitfram-action01         as character   no-undo .
      376   define variable v-waitfram-action02         as character   no-undo .
      377   define variable v-waitfram-action03         as character   no-undo .
      378   define variable mWaitFramTextBeg            as character   no-undo.
      379   define variable mWaitFramTextEnd            as character   no-undo.
      380   define variable mWaitFramView               as logical     no-undo.
      381   define variable mWaitProcEvent              as logical     no-undo init yes.
      382   define variable mWaitFramInterval           as integer     no-undo init 1 .
      383   define variable mWaitFramStop               as logical     no-undo.
      384   define variable mWaitFramStopUser           as logical     no-undo.
      385   define variable mWaitFramStopTimeOut        as logical     no-undo.
      386   define variable mWaitFramStartProc          as datetime-tz no-undo.
      387   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      388   define button B-WaitFramStop auto-end-key
      389        label "Стоп"
      390        size 10 by 1 tooltip "Остоновить процесс".
      391   define button B-viewProcInfo
      392        label "Информация"
      393        size 15 by 1 tooltip "Информация о процесс".
      394   define frame waitfram
      395     v-waitfram-action01 format "x(72)" no-label skip
      396     v-waitfram-action02 format "x(72)" no-label skip
      397     v-waitfram-action03 format "x(72)" no-label skip
      398     B-viewProcInfo
      399     B-WaitFramStop at row 4 col 30
      400     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      401     .
      402   define new global shared variable mBatchMode as logical no-undo init ?.
      403   define variable mFramBachModHandle as handle no-undo.
      404   mFramBachModHandle = frame waitfram:handle.
      405   define variable mFameOldVis as logical no-undo.
      406   define variable mVisCUrentVin as logical no-undo.
      407   if session:batch-mode
      408   then
      409      mBatchMode = yes.
      410   if mBatchMode = ? then do:
      411     mVisCUrentVin = current-window:visible.
      412     mFameOldVis = mFramBachModHandle:visible.
      413     mFramBachModHandle:visible  = yes.
      414     mBatchMode = mFramBachModHandle:visible ne yes.
      415     mFramBachModHandle:visible = mFameOldVis.
      416     current-window:visible = mVisCUrentVin.
      417   end.
      418    if  log-manager:logfile-name ne ?
      419     then DO:
      420         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      421         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      422         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      423     end.
      424   on choose of B-WaitFramStop in frame waitfram
      425   do:
      426     mWaitFramStop = yes.
      427     mWaitFramStopUser = yes.
      428   end.
      429   function waitfram-check-timeout returns logical():
      430      define variable vtime as int64 no-undo.
      431      if mWaitFramStopTimeOut
      432      then
      433         return yes.
      434      vtime = ( now - mWaitFramStartProc ) / 1000 .
      435      if     mWaitFramTimeOut ne ?
      436         and mWaitFramTimeOut ne 0
      437         and mWaitFramTimeOut lt vtime
      438      then do:
      439         mWaitFramStopTimeOut = yes.
      440      end.
      441      return mWaitFramStopTimeOut.
      442   end.
      443   procedure waitfram-hide :
      444     if not session:batch-mode
      445     then do
      446     on error undo, return error return-value
      447     :
      448       pause 0 before-hide .
      449       if not mBatchMode then
      450         hide frame waitfram .
      451     if     not mWaitFramView
      452        and mWaitProcEvent
      453     then
      454       process events .
      455     end.
      456   end procedure.
      457   procedure waitfram-show :
      458     define input  parameter p-message as character no-undo .
      459     define variable v-left-margin as integer   no-undo .
      460     if not session:batch-mode
      461     then do
      462     on error undo, return error return-value
      463     :
      464       if length(p-message) <= 70 then do:
      465         assign
      466           v-left-margin = integer((70 - length(p-message)) / 2)
      467         .
      468         assign
      469           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      470         .
      471         assign
      472           v-waitfram-action01 = " "
      473           v-waitfram-action02 = " "
      474                                    + fill(" ", v-left-margin)
      475                                    + p-message
      476           v-waitfram-action03 = " "
      477         .
      478       end.
      479       else do:
      480         define variable vRindex1 as integer no-undo.
      481         define variable vRindex2 as integer no-undo.
      482         vRindex1 = r-index(p-message," ",70).
      483         if vRindex1 = 0
      484         then
      485            vRindex1 = 70.
      486         if length(p-message)  <= vRindex1 + 70 then do:
      487           assign
      488             v-waitfram-action01 = " "
      489             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      490             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      491           .
      492         end.
      493         else do:
      494           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      495           if vRindex2 <= vRindex1
      496           then
      497              vRindex2 = vRindex1 + 70.
      498           assign
      499             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      500             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      501             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      502           .
      503         end.
      504       end.
      505       B-viewProcInfo:visible   in frame waitfram = no.
      506       B-viewProcInfo:sensitive in frame waitfram = no.
      507       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      508       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      509       if  (   mWaitFramView
      510          or  mWaitProcEvent)
      511          and not mBatchMode
      512       then
      513          display
      514             v-waitfram-action01 skip
      515             v-waitfram-action02 skip
      516             v-waitfram-action03 skip
      517          with frame waitfram .
      518       if     mWaitFramView
      519          then do:
      520             if     mWaitFramInterval ne ?
      521                and not mBatchMode
      522             then
      523                wait-for go of frame waitfram pause mWaitFramInterval.
      524          end.
      525          else
      526             if     mWaitProcEvent
      527                and not mBatchMode
      528             then
      529                process events .
      530     end.
      531   end procedure.
      532      procedure waitfram-show-this:
      533         define input  parameter iInterval as int64 no-undo.
      534         define variable vtime as int64 no-undo.
      535         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      536         mWaitFramInterval = iInterval.
      537         run waitfram-show (substitute("&1&2 &3&4" ,
      538                                       mWaitFramTextBeg ,
      539                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      540                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      541                                       mWaitFramTextEnd
      542                                      )
      543                           ).
      544      end.
      545      procedure WaitFramRunPause:
      546         define input  parameter iInterval as dec no-undo.
      547         define variable vStart  as datetime-tz no-undo.
      548         define variable vend    as datetime-tz no-undo.
      549         define variable vint as int64 no-undo.
      550         define variable vOk as logical no-undo.
      551         vStart = now.
      552         vend   = vStart.
      553         publish "WaitFramPause" (iInterval,output vOk).
      554         vend   =  now.
      555         vint = vend - vStart.
      556         vint = iInterval - vint / 1000.
      557         if     not mWaitFramStop
      558            and (   vint > 0
      559                 or (    not vOk
      560                     and iInterval eq ?
      561                     )
      562                 )
      563         then
      564            run waitfram-show-this (iInterval).
      565         vend   =  now.
      566         vint = vend - vStart.
      567         vint = iInterval - vint / 1000.
      568         if     not mWaitFramStop
      569            and vint > 0
      570         then do:
      571            run gbl/pause.p (vint * 1000).
      572         end.
      573         if iInterval ne ?
      574         then
      575            publish "WaitFramStop".
      576         waitfram-check-timeout().
      577      end.
      578      procedure WaitFramWaitFor:
      579         define input  parameter iInterval as dec no-undo.
      580         assign
      581            mWaitFramStartProc   = now
      582            mWaitFramStopUser    = no
      583            mWaitFramStopTimeOut = no
      584         .
      585         block-wait:
      586         do while not mWaitFramStop:
      587            run WaitFramRunPause (iInterval).
      588            if  waitfram-check-timeout()
      589            then do:
      590               leave block-wait.
      591            end.
      592         end.
      593         run waitfram-hide.
      594      end.
      595   procedure waitfram-join :
      596     define input  parameter p-line-1  as character no-undo .
      597     define input  parameter p-line-2  as character no-undo .
      598     define input  parameter p-line-3  as character no-undo .
      599     define output parameter p-message as character no-undo .
      600     do
      601     on error undo, return error return-value
      602     :
      603       assign
      604         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      605                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      606                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      607       .
      608     end.
      609   end procedure.
      610   function waitfram-join-function returns character
      611     (input p-line-1 as character
      612     ,input p-line-2 as character
      613     ,input p-line-3 as character
      614     ).
      615     define variable v-message as character no-undo .
      616     run waitfram-join in this-procedure
      617       (input  p-line-1
      618       ,input  p-line-2
      619       ,input  p-line-3
      620       ,output v-message
      621       ) .
      622     return v-message .
      623   end function .
