      714   procedure prn-lib-open-stream :
      715     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      716     define input parameter p-page-size    as integer no-undo .
      717     define input parameter p-is-stream    as logical no-undo .
      718     define input parameter p-append       as logical no-undo .
      719     define variable v-report-name as character no-undo .
      720     do
      721       on error undo, return error
      722       :
      723       run prn-lib-get-report-name  in this-procedure (
      724         input parParentProc
      725         ,output v-report-name
      726         ).
      727       if p-is-stream then
      728       do:
      729         if p-append then
      730         do:
      731           output stream PrnLibStream to value( v-report-name )
      732             page-size value(p-page-size) append .
      733         end.
      734         if not p-append then
      735         do:
      736           output stream PrnLibStream to value( v-report-name )
      737             page-size value(p-page-size) .
      738         end.
      739       end.
      740       if not p-is-stream then
      741       do:
      742         if p-append then
      743         do:
      744           output to value( v-report-name )
      745             page-size value(p-page-size) append .
      746         end.
      747         if not p-append then
      748         do:
      749           output to value( v-report-name )
      750             page-size value(p-page-size) .
      751         end.
      752       end.
      753     end.
      754   end procedure.
      755   procedure prn-lib-open-exp :
      756     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      757     define input parameter p-is-stream    as logical no-undo .
      758     define input parameter p-is-append    as logical no-undo .
      759     define output parameter p-ReportFileName as char init "report" no-undo.
      760     define output parameter p-process as logical no-undo .
      761     define variable glog as logical no-undo .
      762     do
      763       on error undo, return error
      764       :
      765       SYSTEM-DIALOG GET-FILE p-ReportFileName
      766         TITLE      "Укажите путь"
      767         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      768         ASK-OVERWRITE
      769         CREATE-TEST-FILE
      770         SAVE-AS
      771         USE-FILENAME
      772         DEFAULT-EXTENSION "txt"
      773         UPDATE glog
      774         .
      775       if not glog then  return.
      776       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      777       if p-is-stream then
      778       do:
      779         if p-is-append then
      780         do:
      781           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      782         end.
      783         else
      784         do:
      785           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      786         end.
      787       end.
      788       else
      789       do:
      790         if p-is-append then
      791         do:
      792           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      793         end.
      794         else
      795         do:
      796           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      797         end.
      798       end.
      799       p-process = yes.
      800     end.
      801   end procedure.
