     5685   v-obj
     5686   with FRAME HistoryList .
     5687   DISPLAY STREAM PrnLibStream
     5688   "ИТОГО"  @ X_c-wth-hist.wth-code
     5689   string(accum-count)  @ v-action-chr
     5690   with frame HistoryList.
     5691   HIDE  STREAM PrnLibStream FRAME BottomFrame .
     5692   HIDE  STREAM PrnLibStream FRAME CheckList.
     5693   output  STREAM PrnLibStream CLOSE.
     5694   run waitfram-hide in this-procedure.
     5695   run prn-lib-prn-file in this-procedure (
     5696                                             input parparentproc
     5697                                             ,input 8
     5698                                             ).
     5699   reposition br-wth-hist to recid v-doc-rec no-error.
     5700   apply "entry" to br-wth-hist in frame Dialog-Frame.
     5701   END PROCEDURE.
     5702   PROCEDURE proc-b-sch :
     5703   assign
     5704     tbl = 'c-wth-hist'
     5705     join-tbl = 'X_c-wth-hist'
     5706     fld = ""
     5707     lab = ""
     5708     spr = ""
     5709     dim = '0'
     5710     .
     5711   run fltfield-add in this-procedure('wth-code', 'Код товара', '',
     5712   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5713   run fltfield-add in this-procedure('host-code', '', '',
     5714   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5715   run fltfield-add in this-procedure('obj-type*obj-code', 'Объект', '',
     5716   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5717   run fltfield-add in this-procedure('corr-date', '', '',
     5718   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5719   run fltfield-add in this-procedure('corr-time', 'Время корр.', 'time',
     5720   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5721   run fltfield-add in this-procedure('corr-user-db-num', '', '',
     5722   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5723   run fltfield-add in this-procedure('corr-user-name', 'Изменил', 'usr',
     5724   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5725   run fltfield-add in this-procedure('subject', 'Предмет изменения', 'gds-hist-subject',
     5726   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5727   run fltfield-add in this-procedure('action', 'Действие', 'hist-action',
     5728   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5729   run fltfield-add in this-procedure('source-type', 'Источник_измен-я', 'hist-source-type',
     5730   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5731   run fltfield-add in this-procedure('source-ref', '', '',
     5732   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5733   Filter-Block:
     5734   DO ON STOP    UNDO Filter-Block, LEAVE Filter-Block
     5735       ON ERROR   UNDO Filter-Block, LEAVE Filter-Block
     5736       ON END-KEY UNDO Filter-Block, LEAVE Filter-Block :
     5737     run gbl/filter.w ( INPUT parparentproc
     5738                      , INPUT (filter-point + chr(4) + filter-label)
     5739                      , INPUT tbl
     5740                      , INPUT join-tbl
     5741                      , INPUT fld
     5742                      , INPUT lab
     5743                      , INPUT spr
     5744                      , INPUT dim ).
     5745     RUN OpenBr in this-procedure ( input yes, input no, input '':U, input v-corr-user-db-num).
     5746   END.
     5747   END PROCEDURE.
     5748   PROCEDURE proc-br-wth-hist :
     5749   define variable vss-include-info47 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5750   if b-sel:sensitive in frame Dialog-Frame then dO:
     5751       if b-mark:sensitive then do:
     5752           apply "choose" to b-mark in frame Dialog-Frame.
     5753       end.
     5754       else do:
     5755           apply "choose" to b-sel in frame Dialog-Frame.
     5756       end.
     5757   end.
     5758   else do:
     5759       if b-lkp:sensitive then
     5760       apply "choose" to b-lkp in frame Dialog-Frame.
     5761   end.
     5762   END PROCEDURE.
     5763   PROCEDURE proc-find-corr-date :
     5764   define input parameter p-next as logical no-undo.
     5765   define input parameter p-date like ub.fin-doc.doc-date no-undo.
     5766   define variable v-date-chr as character no-undo.
     5767   if p-date = ? then return .
     5768   display
     5769   0 @ sch-wth-code
     5770   0 @ sch-db-num
     5771   "":U @ sch-corr-user-name
     5772   with frame Dialog-Frame.
     5773   assign
     5774   v-date-chr = string(day(p-date)) + chr(47) +
     5775                    string(month(p-date)) + chr(47) +
     5776                    string(year(p-date)).
     5777          run OpenBr in this-procedure
     5778           (input false
     5779           ,input true
     5780           ,input substitute("and X_c-wth-hist.corr-date = &1 "
     5781             , v-date-chr)
     5782           ,input v-corr-user-db-num
     5783           ).
     5784         apply "entry":u to sch-corr-date in frame Dialog-Frame.
     5785   END PROCEDURE.
     5786   PROCEDURE proc-find-db-num :
     5787   define input parameter p-next as logical no-undo.
     5788   define input parameter p-db-num like ub.c-wth-hist.corr-user-db-num no-undo.
     5789   define variable v-db-num as character no-undo.
     5790   assign
     5791   sch-corr-date = ?
     5792   .
     5793   display
     5794   "":U @ sch-corr-user-name
     5795   0 @ sch-wth-code
     5796   sch-corr-date
     5797   with frame Dialog-Frame.
     5798   assign
     5799   v-db-num = string(p-db-num).
     5800   run OpenBr in this-procedure
     5801       (input false
     5802       ,input p-next
     5803       ,input substitute("and X_c-wth-hist.corr-user-db-num = &1 "
     5804         , v-db-num)
     5805       ,input v-corr-user-db-num
     5806       ).
     5807   apply "entry":u to sch-db-num in frame Dialog-Frame .
     5808   END PROCEDURE.
     5809   PROCEDURE proc-find-user :
     5810   define input parameter p-next as logical no-undo.
     5811   define input parameter p-user like ub.c-wth-hist.corr-user-name no-undo.
     5812   assign
     5813   sch-corr-date = ?.
     5814   display
     5815   0 @ sch-db-num
     5816   sch-corr-date
     5817   0 @ sch-wth-code
     5818   with frame Dialog-Frame.
     5819   p-user = chr(34) + p-user + chr(34).
     5820   run OpenBr in this-procedure
     5821       (input false
     5822       ,input p-next
     5823       ,input substitute("and X_c-wth-hist.corr-user-name = &1 "
     5824         , p-user)
     5825       ,input v-corr-user-db-num
     5826       ).
     5827   apply "entry":u to sch-corr-user-name in frame Dialog-Frame .
     5828   END PROCEDURE.
     5829   PROCEDURE proc-find-wth-code :
     5830   define input parameter p-next as logical no-undo.
     5831   define input parameter p-wth-code like ub.c-wth-hist.wth-code no-undo.
     5832   define variable v-wth-code as character no-undo.
     5833   assign
     5834   sch-corr-date = ?.
     5835   display
     5836   "":U @ sch-corr-user-name
     5837   0 @ sch-db-num
     5838   sch-corr-date
     5839   with frame Dialog-Frame.
     5840   assign
     5841   v-wth-code = string(p-wth-code).
     5842   run OpenBr in this-procedure
     5843       (input false
     5844       ,input p-next
     5845       ,input substitute("and X_c-wth-hist.wth-code = &1 "
     5846         , v-wth-code)
     5847       ,input v-corr-user-db-num
     5848       ).
     5849   apply "entry":u to sch-wth-code in frame Dialog-Frame .
     5850   END PROCEDURE.
     5851   PROCEDURE proc-view-changes :
     5852   define variable v-description as character no-undo .
     5853   FOR each temp-changes:
     5854       delete temp-changes.
     5855   END.
     5856   if not available X_c-wth-hist then do:
     5857     Open QUery br-changes for each temp-changes.
     5858     return.
     5859   end.
     5860   run ref/cwthhisv.p (
     5861                      input X_c-wth-hist.wth-code
     5862                     ,input X_c-wth-hist.par-code
     5863                     ,input X_c-wth-hist.chip-num
     5864                     ,input X_c-wth-hist.corr-user-db-num
     5865                     ,input X_c-wth-hist.host-code
     5866                     ,input X_c-wth-hist.obj-type
     5867                     ,input X_c-wth-hist.obj-code
     5868                     ,input X_c-wth-hist.subject
     5869                     ,input X_c-wth-hist.action
     5870                     ,input no
     5871                     ,input X_c-wth-hist.ser-code
     5872                     ,input X_c-wth-hist.db-num
     5873                     ,output v-description
     5874                  ) no-error .
     5875   Open QUery br-changes for each temp-changes.
     5876   assign
     5877   br-changes:title in frame Dialog-Frame = v-description
     5878   .
     5879   END PROCEDURE.
     5880   FUNCTION get-action RETURNS CHARACTER
     5881     ( p-action as integer ) :
     5882     define variable dops as character no-undo.
     5883   assign dops = entry (lookup (trim(string(p-action)), '99,1,2,3,4,9,51,79':U), 'Удаление,Создание,Изменение,Коррекция,Восстановление,Смена_кода,Смена_артик,Выключ.':U) no-error.
     5884   RETURN dops.
     5885   END FUNCTION.
     5886   FUNCTION get-source-type RETURNS CHARACTER
     5887     ( p-source-type as character ) :
     5888   define variable v-dop as character no-undo .
     5889   assign
     5890   v-dop =  entry (lookup (p-source-type, ',db,esys,trn-doc,payment,fin-doc,import,recalc,wth-doc,ren-gdsc,upgrade,grp-chg,stop-list,dis-card':U), ',БД,ВС,Документ,Платеж,Фин.док.,Импорт,Пересчет,Документ МЦ,Коллизия,Апгрейд,Изм.группы,Стоплист,ДК':U) no-error
     5891   .
     5892     RETURN v-dop .
     5893   END FUNCTION.
     5894   FUNCTION get-subject RETURNS CHARACTER
     5895     ( p-subject as character ) :
     5896     RETURN entry (lookup (p-subject, 'wealth,wth-par,wth-gds,wth-ser':U), 'МЦ,Номинал МЦ,Связь МЦ с товарами,Серии':U).
     5897   END FUNCTION.
     5898   FUNCTION get-wealth RETURNS CHARACTER
     5899     ( p-wth-code as integer, p-par-code as integer, output p-wth-par-name as character) :
     5900   define buffer buf_wealth for ub.wealth.
     5901   define buffer buf_wth-par for ub.wth-par.
     5902   find first buf_wealth no-lock where buf_wealth.wth-code = p-wth-code no-error.
     5903   if not available buf_wealth then do:
     5904       return "!!! Неизвестная МЦ!!!".
     5905   end.
     5906   if p-par-code <> ?
     5907   and p-par-code <> 0 then do:
     5908     find first buf_wth-par no-lock where
     5909               buf_wth-par.wth-code = p-wth-code
     5910         AND   buf_wth-par.par-code = p-par-code no-error .
     5911     if available buf_wth-par then do:
     5912       assign
     5913       p-wth-par-name = substitute("&1 &2", buf_wth-par.par-unit, buf_wth-par.par-val)
     5914       .
     5915     end.
     5916   end.
     5917     RETURN buf_wealth.wth-name.
     5918   END FUNCTION.
