        1   DEFINE BUFFER find_c-wth-hist FOR ub.c-wth-hist.
        2   DEFINE BUFFER X_c-wth-hist FOR ub.c-wth-hist.
        3   DEFINE BUFFER X_clients FOR ub.clients.
        4   DEFINE BUFFER X_curr-sysconf FOR ub.sysconf.
        5   DEFINE BUFFER X_db FOR ub.db.
        6   DEFINE BUFFER X_sysconf FOR ub.sysconf.
        7   DEFINE BUFFER X_wealth FOR ub.wealth.
        8   DEFINE INPUT     PARAMETER parParentProc  AS WIDGET-HANDLE NO-UNDO.
        9   define input parameter p-curr-host-code like ub.sysconf.host-code no-undo.
       10   define input parameter p-curr-obj-type like ub.clients.obj-type no-undo.
       11   define input parameter p-curr-obj-code like ub.clients.obj-code no-undo.
       12   define input parameter bttns  as char   no-undo .
       13   define input parameter p-mode  as char   no-undo .
       14   define input parameter p-wth-code     like ub.c-wth-hist.wth-code no-undo .
       15   define input parameter p-par-code     like ub.c-wth-hist.par-code no-undo .
       16   define input parameter p-host-code like ub.c-wth-hist.host-code no-undo.
       17   define input parameter p-obj-type like ub.c-wth-hist.obj-type no-undo.
       18   define input parameter p-obj-code like ub.c-wth-hist.obj-code no-undo.
       19   define input parameter p-corr-user-db-num  like ub.c-wth-hist.corr-user-db-num no-undo .
       20   define input parameter p-corr-user-name  like ub.c-wth-hist.corr-user-name no-undo .
       21   define input parameter p-subject  like ub.c-wth-hist.subject no-undo .
       22   define input parameter p-db-num    like ub.c-wth-hist.corr-user-db-num no-undo .
       23   define input parameter p-ser-code  like ub.c-wth-hist.ser-code no-undo .
       24   define input parameter p-serdb-num like ub.c-wth-hist.db-num no-undo .
       25   define input-output param p-rid-list    as  char no-undo .
       26   define variable vss-revision    AS CHAR NO-UNDO INIT "$Revision$":U.
       27   define variable vss-author      AS CHAR NO-UNDO INIT "$Author$":U.
       28   define variable vss-date        AS CHAR NO-UNDO INIT "$Date$":U.
       29   define variable vss-workfile    AS CHAR NO-UNDO INIT "$Workfile$":U.
       30   define variable vss-archive     AS CHAR NO-UNDO INIT "$Archive$":U.
       31   define variable vss-description AS CHAR NO-UNDO INIT "Список полной истории МЦ":U.
       32   procedure vss-get-info :
       33     define output parameter p-vss-revision    like vss-revision    no-undo .
       34     define output parameter p-vss-author      like vss-author      no-undo .
       35     define output parameter p-vss-date        like vss-date        no-undo .
       36     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       37     define output parameter p-vss-archive     like vss-archive     no-undo .
       38     define output parameter p-vss-description like vss-description no-undo .
       39     assign
       40       p-vss-revision    = vss-revision
       41       p-vss-author      = vss-author
       42       p-vss-date        = vss-date
       43       p-vss-workfile    = vss-workfile
       44       p-vss-archive     = vss-archive
       45       p-vss-description = vss-description
       46     .
       47   end procedure.
       48   procedure vss-get-parameters :
       49     define output parameter p-vss-parameters as character no-undo .
       50   end procedure.
       51   define new global shared variable g#vssrevis-logger as handle    no-undo .
       52   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       53   define variable v-vssrevis-logger                   as handle    no-undo .
       54   procedure vss-logevent :
       55     define input  parameter p-extra-paramters as character no-undo .
       56     define variable v-vssrevis-parameters as character no-undo .
       57     do
       58     on error undo, return error return-value
       59     :
       60       if  valid-handle(v-vssrevis-logger)
       61       and v-vssrevis-logger :get-signature("logevent") <> ""
       62       then do:
       63         run vss-get-parameters in this-procedure
       64           (output v-vssrevis-parameters
       65           ).
       66         run logevent in v-vssrevis-logger
       67           (input vss-workfile
       68           ,input vss-revision
       69           ,input v-vssrevis-parameters
       70           ,input p-extra-paramters
       71           ).
       72       end.
       73     end.
       74   end procedure.
       75   assign
       76     v-vssrevis-logger = g#vssrevis-logger
       77   .
       78   if  valid-handle(v-vssrevis-logger)
       79   and v-vssrevis-logger :get-signature("logevent") <> ""
       80   then do:
       81     assign
       82       v-vssrevis-logevent = true
       83     .
       84     run vss-logevent in this-procedure (input vss-description) .
       85   end.
       86   define new global shared variable g#language as character no-undo .
       87   if g#language <> '' and g#language <> 'rus':U then do:
       88     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       89   end.
       90   define new global shared variable g#library  as handle no-undo .
       91   define new global shared variable g#library2 as handle no-undo .
       92   procedure proc-alt-shift-f2:
       93     if not ibs.th.gbl.gbl-var:rcode
       94   then
       95     run gbl\inidebug.p .
       96   end.
       97   procedure proc-alt-shift-f3:
       98     run gbl/prvssinf.p
       99       ( input this-procedure
      100       ) .
      101   end.
      102   define variable v-inform-launched as logical no-undo initial false .
