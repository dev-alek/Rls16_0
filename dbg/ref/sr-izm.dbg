      990         :
      991           if  v-object-handle <> v-diasize-browse-handle :handle
      992           and can-query(v-object-handle, "row")
      993           and can-query(v-object-handle, "height")
      994           and ( v-object-handle :row > v-diasize-browse-handle :row )
      995           then do:
      996             find first buf_temp-browse-handle
      997               where buf_temp-browse-handle.browse-type   = 'height':u
      998                 and buf_temp-browse-handle.browse-handle = v-object-handle
      999               no-error .
     1000             if available buf_temp-browse-handle
     1001             then do:
     1002             end.
     1003             else do:
     1004               create buf_temp-diasize-handle .
     1005               assign
     1006                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1007                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1008               .
     1009             end.
     1010           end.
     1011           assign
     1012             v-object-handle = v-object-handle :next-sibling
     1013           .
     1014         end.
     1015         assign
     1016           v-field-group-handle = v-field-group-handle :next-sibling
     1017         .
     1018       end.
     1019       do with frame Dialog-Frame
     1020       :
     1021         hide v-diasize-resize-button .
     1022         assign
     1023           v-diasize-resize-button :row    = 1
     1024           v-diasize-resize-button :column = 1
     1025         .
     1026       end.
     1027       if p-change-value > 0
     1028       then do:
     1029         if frame Dialog-Frame :scrollable = true
     1030         then do:
     1031           assign
     1032             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1033             no-error .
     1034           if error-status :error
     1035           or error-status :get-message(1) <> ""
     1036           then do:
     1037             undo move_block, retry move_block .
     1038           end.
     1039         end.
     1040         assign
     1041           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1042           no-error .
     1043         if error-status :error
     1044         or error-status :get-message(1) <> ""
     1045         then do:
     1046           undo move_block, retry move_block .
     1047         end.
     1048         assign
     1049           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1050           no-error .
