     1281             :
     1282               assign
     1283                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1284               .
     1285             end.
     1286             assign
     1287               frame Dialog-Frame :width = v-frame-width
     1288             .
     1289             if frame Dialog-Frame :scrollable = true
     1290             then do:
     1291               assign
     1292                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1293               .
     1294             end.
     1295             run diasize_position-resize-button in this-procedure .
     1296           end.
     1297           else do:
     1298             if frame Dialog-Frame :scrollable = true
     1299             then do:
     1300               assign
     1301                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1302               .
     1303             end.
     1304             assign
     1305               frame Dialog-Frame :width = v-frame-width
     1306             .
     1307             for each buf_temp-browse-handle
     1308               where buf_temp-browse-handle.browse-type = 'width':u
