     1564   procedure diasize_set-width :
     1565     define input  parameter p-new-width  as decimal   no-undo .
     1566     define input  parameter p-move-resize as logical   no-undo .
     1567     do
     1568     on error undo, return error return-value
     1569     :
     1570       run diasize_change-width in this-procedure
     1571         (input  (p-new-width - frame Dialog-Frame :width)
     1572         ,input  p-move-resize
     1573         ) .
     1574     end.
     1575   end procedure.
     1576   procedure diasize_position-resize-button :
     1577     do with frame Dialog-Frame
     1578     :
     1579       hide v-diasize-resize-button .
     1580       assign
     1581         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1582                     - 1
     1583                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1584         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1585                     - 1
     1586                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1587       .
     1588       view v-diasize-resize-button .
     1589     end.
     1590   end procedure.
     1591   on alt-right anywhere
     1592   do:
     1593     run diasize_change-width in this-procedure
     1594       (input 1
     1595       ,input true
     1596       ) .
     1597     return no-apply .
     1598   end.
     1599   on alt-left anywhere
     1600   do:
     1601     run diasize_change-width in this-procedure
     1602       (input -1
     1603       ,input true
     1604       ) .
     1605     return no-apply .
     1606   end.
     1607   on alt-down anywhere
     1608   do:
     1609     run diasize_change-height in this-procedure
     1610       (input 1
     1611       ,input true
     1612       ) .
     1613     return no-apply .
     1614   end.
     1615   on alt-up anywhere
     1616   do:
     1617     run diasize_change-height in this-procedure
     1618       (input -1
     1619       ,input true
     1620       ) .
     1621     return no-apply .
     1622   end.
     1623   on alt-enter of frame Dialog-Frame
     1624   do:
     1625     run diasize_maximize in this-procedure
     1626       (input  ?
     1627       ).
     1628     return no-apply .
     1629   end.
     1630   procedure diasize_end-move :
     1631     do
     1632     on error undo, return error return-value
     1633     :
     1634       define variable v-row-delta as decimal   no-undo .
     1635       define variable v-col-delta as decimal   no-undo .
     1636       define variable v-new-row as decimal   no-undo .
     1637       define variable v-new-col as decimal   no-undo .
     1638       assign
     1639         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1640         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1641       .
     1642       assign
     1643         v-row-delta = v-new-row - frame Dialog-Frame :height
     1644         v-col-delta = v-new-col - frame Dialog-Frame :width
     1645       .
     1646       run diasize_change-height in this-procedure
     1647         (input v-row-delta
     1648         ,input true
     1649         ) .
     1650       run diasize_change-width in this-procedure
     1651         (input v-col-delta
     1652         ,input true
     1653         ) .
     1654     end.
     1655   end procedure.
     1656   procedure diasize_maximize :
     1657     define input  parameter p-action as logical   no-undo .
     1658     do
     1659     on error undo, return error return-value
     1660     :
     1661       if p-action = ?
     1662       then do:
     1663         if v-diasize-need-maximize = true
     1664         then do:
     1665           assign
     1666             p-action = true
     1667           .
     1668         end.
     1669         else do:
     1670           assign
     1671             p-action = false
     1672           .
     1673         end.
     1674       end.
     1675       if p-action = true
     1676       then do:
     1677         run diasize_change-height in this-procedure
     1678           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1679               - frame Dialog-Frame :height-chars
     1680           ,input true
     1681           ) .
     1682         run diasize_change-width in this-procedure
     1683           (input session :width-chars
     1684               - frame Dialog-Frame :width-chars
     1685           ,input true
     1686           ) .
     1687         assign
     1688           v-diasize-need-maximize = false
     1689         .
     1690       end.
     1691       else do:
     1692         run diasize_change-width in this-procedure
     1693           (input v-diasize-orig-frame-width
     1694               - frame Dialog-Frame :width-chars
     1695           ,input true
     1696           ) .
     1697         run diasize_change-height in this-procedure
     1698           (input v-diasize-orig-frame-height
     1699               - frame Dialog-Frame :height-chars
     1700           ,input true
     1701           ) .
     1702         assign
     1703           v-diasize-need-maximize = true
     1704         .
     1705       end.
     1706     end.
     1707   end procedure.
     1708   procedure diasize_restore-orig-size :
     1709     do
     1710     on error undo, return error return-value
     1711     :
     1712       assign
     1713         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1714         v-diasize-current-frame-height = frame Dialog-Frame :height
     1715       .
     1716       run diasize_set-height in this-procedure
     1717         (input  v-diasize-orig-frame-height
     1718         ,input  true
     1719         ) .
     1720       run diasize_set-width in this-procedure
     1721         (input  v-diasize-orig-frame-width
     1722         ,input  true
     1723         ) .
     1724     end.
     1725   end procedure.
     1726   procedure diasize_restore-current-size :
     1727     do
     1728     on error undo, return error return-value
     1729     :
     1730       run diasize_set-height in this-procedure
     1731         (input  v-diasize-current-frame-height
     1732         ,input  true
     1733         ) .
     1734       run diasize_set-width in this-procedure
     1735         (input  v-diasize-current-frame-width
     1736         ,input  true
     1737         ) .
     1738     end.
     1739   end procedure.
     1740   procedure diasize_set-browse-handle :
     1741     define input  parameter p-browse-handle as handle   no-undo .
     1742     define buffer buf_temp-browse-handle for temp-browse-handle .
     1743     do
     1744     on error undo, return error return-value
     1745     :
     1746       assign
     1747         v-diasize-browse-handle = p-browse-handle
     1748       .
     1749       for each buf_temp-browse-handle
     1750       on error undo, return error return-value
     1751       :
     1752         delete buf_temp-browse-handle .
     1753       end.
     1754     end.
     1755   end procedure.
     1756   procedure diasize_add_browse :
     1757     define input  parameter p-browse-type   as character no-undo .
     1758     define input  parameter p-browse-handle as handle    no-undo .
     1759     define buffer buf_temp-browse-handle for temp-browse-handle .
     1760     do
     1761     on error undo, return error return-value
     1762     :
     1763       assign
     1764         v-diasize-browse-number = v-diasize-browse-number + 1
     1765       .
     1766       create buf_temp-browse-handle .
     1767       assign
     1768         buf_temp-browse-handle.browse-type   = p-browse-type
     1769         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1770         buf_temp-browse-handle.browse-handle = p-browse-handle
     1771       .
     1772     end.
     1773   end procedure.
     1774   procedure diasize_init :
     1775     define variable v-default-value    as logical   no-undo .
     1776     define variable v-restore-saved    as logical   no-undo .
     1777     define variable v-resize-value-str as character no-undo .
     1778     do
     1779     on error undo, return error return-value
     1780     :
     1781       do with frame Dialog-Frame
     1782       :
     1783         assign
     1784           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1785           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1786           v-diasize-browse-handle     = browse BR-sr-izm :handle
     1787         .
     1788         create button v-diasize-resize-button
     1789         assign
     1790           parent        = frame Dialog-Frame :first-child
     1791           label         = "s"
     1792           height-pixels = 16
     1793           width-pixels  = 16
     1794           visible       = true
     1795           sensitive     = true
     1796           movable       = true
     1797           triggers:
     1798             on end-move persistent run diasize_end-move in this-procedure .
     1799           end triggers.
     1800         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1801         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1802         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1803         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1804         assign
     1805           v-diasize-wndmax = false
     1806         .
     1807         if connected("ub") = true
     1808         then do:
     1809           define variable v-cntxt-db-num        as integer   no-undo .
     1810           define variable v-cntxt-userid        as character no-undo .
     1811           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1812                                             , OUTPUT v-cntxt-userid
     1813                                             ) .
     1814           run gbl/wndpar_r.p
     1815             (input  v-cntxt-db-num
     1816             ,input  v-cntxt-userid
     1817             ,input  'wndmax':U
     1818             ,output v-diasize-wndmax
     1819             ,output v-default-value
     1820             ) .
     1821         end.
     1822         assign
     1823           v-diasize-wndstore = false
     1824         .
     1825         if connected("ub") = true
     1826         then do:
     1827           run gbl/wndpar_r.p
     1828             (input  v-cntxt-db-num
     1829             ,input  v-cntxt-userid
     1830             ,input  'wndstore':U
     1831             ,output v-diasize-wndstore
     1832             ,output v-default-value
     1833             ) .
     1834         end.
     1835         assign
     1836           v-diasize-proc-name = entry(1, program-name(2), '.')
     1837         .
     1838         if v-diasize-wndstore = true
     1839         then do:
     1840           assign
     1841             v-restore-saved = false
     1842           .
     1843           if connected("ub") = true
     1844           then do:
     1845             run gbl/wndsizer.p
     1846               (input  v-cntxt-db-num
     1847               ,input  v-cntxt-userid
     1848               ,input  v-diasize-proc-name
     1849               ,input  'height':u
     1850               ,output v-resize-value-str
     1851               ) .
     1852             if v-resize-value-str <> '':U
     1853             then do:
     1854               run diasize_change-height in this-procedure
     1855                 (input  integer(v-resize-value-str)
     1856                 ,input  true
     1857                 ) .
     1858               assign
     1859                 v-restore-saved = true
     1860               .
     1861             end.
     1862           end.
     1863           if connected("ub") = true
     1864           then do:
     1865             run gbl/wndsizer.p
     1866               (input  v-cntxt-db-num
     1867               ,input  v-cntxt-userid
     1868               ,input  v-diasize-proc-name
     1869               ,input  'width':u
     1870               ,output v-resize-value-str
     1871               ) .
     1872             if v-resize-value-str <> '':U
     1873             then do:
     1874               run diasize_change-width in this-procedure
     1875                 (input  integer(v-resize-value-str)
     1876                 ,input  true
     1877                 ) .
     1878               assign
     1879                 v-restore-saved = true
     1880               .
     1881             end.
     1882           end.
     1883           if v-restore-saved <> true
     1884           then do:
     1885             if v-diasize-wndmax = true
     1886             then do:
     1887               run diasize_maximize in this-procedure
     1888                 (input  true
     1889                 ) .
     1890             end.
     1891           end.
     1892         end.
     1893         else do:
     1894           if v-diasize-wndmax = true
     1895           then do:
     1896             run diasize_maximize in this-procedure
     1897               (input  true
     1898               ) .
     1899           end.
     1900         end.
     1901       end.
     1902     end.
     1903   end procedure.
     1904   procedure diasize_need-full-display :
     1905     define output parameter p-need-full-display as logical   no-undo .
     1906     do
     1907     on error undo, return error return-value
     1908     :
     1909       assign
     1910         p-need-full-display = v-diasize-need-full-display
     1911       .
     1912       assign
     1913         v-diasize-need-full-display = false
     1914       .
     1915     end.
     1916   end procedure.
     1917   procedure get-context :
     1918      define output parameter p-db-num as integer          no-undo.
     1919      define output parameter p-user-id as character        no-undo.
     1920      define variable v-login               as character    no-undo.
     1921      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1922      define buffer buf_user-login  for ub.user-login .
     1923      do
     1924      on error undo, return error
     1925      :
     1926            FIND FIRST buf_sys-ctrl no-lock.
     1927            ASSIGN
     1928               v-login = USERID("ub")
     1929               p-db-num = buf_sys-ctrl.db-num
     1930            .
     1931            FIND FIRST buf_user-login
     1932                 WHERE buf_user-login.db-num = p-db-num
     1933                   AND buf_user-login.user-login = v-login
     1934                 no-lock
     1935                 no-error
     1936                 .
     1937            IF AVAILABLE buf_user-login
     1938            THEN DO:
     1939               assign
     1940                  p-user-id = buf_user-login.user-id
     1941               .
     1942            END.
     1943      end.
     1944   end procedure.
     1945       run diasize_init in this-procedure .
     1946   MAIN-BLOCK:
     1947   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1948      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1949   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1950     run mainmenu_getcntxt in parparentproc
     1951       (output v-cntxt-db-num
     1952       ,output v-cntxt-userid
     1953       ,output v-cntxt-level
     1954       ,output v-cntxt-host-code-obj
     1955       ,output v-cntxt-obj-type
     1956       ,output v-cntxt-obj-code
     1957       ,output v-cntxt-db-num-obj
     1958       ,output v-cntxt-is-admin
     1959       ) .
     1960     IF LOOKUP(p-mode, 'ИЗМЕНЕНИЕ':U + chr(44) + 'ПРОСМОТР':U) = 0  THEN DO:
     1961       MESSAGE
     1962       substitute("Неверное значение параметров p-mode = &1"
     1963       , p-mode)
     1964       VIEW-AS alert-box.
     1965       UNDO, RETURN ERROR.
     1966     END.
     1967     IF p-mode = 'ИЗМЕНЕНИЕ':U
     1968     AND LOOKUP("b-sel", bttns) > 0   THEN DO:
     1969       MESSAGE
     1970       substitute("Неверное значение параметров bttns = &1 и/или p-mode = &2"
     1971                  , bttns
     1972                  , p-mode)
     1973       VIEW-AS alert-box.
     1974       UNDO, RETURN ERROR.
     1975     END.
     1976     v-node-code = p-node-code.
     1977     RUN Myenable.
     1978     WAIT-FOR GO OF FRAME Dialog-Frame.
     1979   END.
     1980   RUN disable_UI.
     1981   PROCEDURE disable_UI :
     1982     HIDE FRAME Dialog-Frame.
     1983   END PROCEDURE.
     1984   PROCEDURE enable_UI :
     1985     ENABLE b-quit b-sel b-add b-cng b-del B-hist B-Help
     1986         WITH FRAME Dialog-Frame.
     1987     VIEW FRAME Dialog-Frame.
     1988   END PROCEDURE.
     1989   PROCEDURE MyEnable :
     1990   assign
     1991     FRAME Dialog-Frame:visible = true
     1992   .
     1993   if p-mode = 'ИЗМЕНЕНИЕ':U then do:
     1994     v-edit-mode = yes.
     1995   end.
     1996   v-action-mode = "":U .
     1997   enable
     1998   br-sr-izm
     1999   b-add WHEN v-edit-mode and g#db-num = 0
     2000   b-cng WHEN v-edit-mode and g#db-num = 0
     2001   b-del WHEN v-edit-mode and g#db-num = 0
     2002   b-look
     2003   b-hist
     2004   b-help
     2005   b-quit
     2006   b-sel when not v-edit-mode
     2007   WITH FRAME Dialog-Frame
     2008   .
     2009   IF p-mode <> 'ИЗМЕНЕНИЕ':U THEN DO:
     2010     b-quit:COLUMN  = 1.
     2011     b-quit:label in frame Dialog-Frame = "&Выход".
     2012   END.
     2013   run reopen-query .
     2014   APPLY "value-changed" TO BROWSE br-sr-izm.
     2015   END PROCEDURE.
     2016   PROCEDURE proc-b-del :
     2017   DEFINE BUFFER buf_sr-izm FOR sr-izmerenia.
     2018   define variable v-del-confirm as logical no-undo.
     2019   define variable Msg as character no-undo.
     2020   define variable v-retfl as logical no-undo.
     2021   Msg = "".
     2022   v-retfl = false.
     2023     v-del-confirm = false.
     2024     message substitute("Удалить запись о средстве измерения &1 &2?", sr-izmerenia.node-code, sr-izmerenia.sr-model)
     2025       view-as alert-box question buttons yes-no update v-del-confirm .
     2026     if v-del-confirm then do transaction:
     2027       run ref/sr-izm03.p
     2028       (input sr-izmerenia.node-code
     2029       ) .
     2030       OPEN QUERY BR-sr-izm FOR EACH sr-izmerenia NO-LOCK .
     2031       APPLY "value-changed" TO BROWSE br-sr-izm.
     2032       v-retfl = true.
     2033       catch exAppErrors as class Progress.Lang.AppError :
     2034         Msg = exAppErrors:ReturnValue .
     2035         if Msg > "" then . else do :
     2036           Msg = exAppErrors:GetMessage(1) .
     2037           if Msg > "" then . else Msg = "AppError при удалении в sr-izmerenia" .
     2038         end .
     2039       end catch .
     2040       catch exProErrors as class Progress.Lang.ProError :
     2041         Msg = exProErrors:GetMessage(1) .
     2042         if Msg > "" then . else Msg = "ProError при удалении в sr-izmerenia" .
     2043       end catch .
     2044       catch exAnyErrors as class Progress.Lang.Error:
     2045         Msg = "Unexpected error при удалении в sr-izmerenia" .
     2046       end catch .
     2047       finally :
     2048         if v-retfl then .
     2049         else do:
     2050           message Msg view-as alert-box error.
     2051           return error.
     2052         end.
     2053       end finally .
     2054     end.
     2055     else return error.
     2056   END PROCEDURE.
     2057   PROCEDURE reopen-query :
     2058     if p-type-izm-list = ""
     2059     then do :
     2060       if p-izm-par = ""
     2061       then do :
     2062         OPEN QUERY BR-sr-izm FOR EACH sr-izmerenia NO-LOCK .
     2063       end .
     2064       else do :
     2065         open query BR-sr-izm for each sr-izmerenia no-lock where (sr-izmerenia.sr-level and p-izm-par = "lvl")
     2066                                                               or (sr-izmerenia.sr-density and p-izm-par = "dnst")
     2067                                                               or (sr-izmerenia.sr-temperature and p-izm-par = "tmp")
     2068                                                               .
     2069       end .
     2070     end .
     2071     else do :
     2072       if p-izm-par = ""
     2073       then do :
     2074         open query BR-sr-izm for each sr-izmerenia no-lock where can-do(p-type-izm-list, string(sr-izmerenia.sr-type-izm)) .
     2075       end .
     2076       else do :
     2077         open query BR-sr-izm for each sr-izmerenia no-lock where can-do(p-type-izm-list, string(sr-izmerenia.sr-type-izm))
     2078                                                              and ((sr-izmerenia.sr-level and p-izm-par = "lvl")
     2079                                                               or (sr-izmerenia.sr-density and p-izm-par = "dnst")
     2080                                                               or (sr-izmerenia.sr-temperature and p-izm-par = "tmp"))
     2081                                                               .
     2082       end .
     2083     end .
     2084   END PROCEDURE.
     2085   PROCEDURE proc-save-record :
     2086   define input parameter p-action as character no-undo.
     2087   define variable v-node-code as integer no-undo .
     2088   define variable v-rec       as recid no-undo .
     2089   define variable Msg         as character no-undo.
     2090   define variable v-retfl     as logical no-undo.
     2091   define variable v-err-field as character no-undo .
     2092   DEFINE BUFFER buf_sr-izm FOR sr-izmerenia.
     2093   ASSIGN
     2094   FRAME Dialog-Frame
     2095   dop-sr-izm.sr-model
     2096   cb-sr-type-id
     2097   dop-sr-izm.sr-abs-err-neft-water
     2098   dop-sr-izm.sr-abs-err-water
     2099   dop-sr-izm.sr-abs-err-dens
     2100   dop-sr-izm.sr-abs-err-temp-vol
     2101   dop-sr-izm.sr-abs-err-temp-dens
     2102   dop-sr-izm.sr-otnos
     2103   .
     2104   define variable v-msg2  as character no-undo .
     2105   define variable v-delta as decimal decimals 2 no-undo .
     2106     if dop-sr-izm.sr-model > "" then .
     2107     else do:
     2108       message "Пожалуйста заполните наименование модели средства измерения"
     2109       view-as alert-box.
     2110       apply "entry" to dop-sr-izm.sr-model in frame Dialog-Frame .
     2111       return error .
     2112     end .
     2113     assign
     2114       v-msg2 = "выходит за границы допустимого диапазона"
     2115       v-delta = 3
     2116     .
     2117     if dop-sr-izm.sr-abs-err-neft-water > v-delta or dop-sr-izm.sr-abs-err-neft-water < (-1) * v-delta then do :
     2118       message substitute("&1 &2&3(+/-)&4 мм",
     2119                    dop-sr-izm.sr-abs-err-neft-water:label in frame Dialog-Frame, v-msg2, chr(10), string(v-delta, "9") )
     2120       view-as alert-box.
     2121       apply "entry" to dop-sr-izm.sr-abs-err-neft-water in frame Dialog-Frame .
     2122       return error .
     2123     end.
     2124     if dop-sr-izm.sr-abs-err-water > v-delta or dop-sr-izm.sr-abs-err-water < (-1) * v-delta then do :
     2125       message substitute("&1 &2&3(+/-)&4 мм",
     2126                    dop-sr-izm.sr-abs-err-water:label in frame Dialog-Frame, v-msg2, chr(10), string(v-delta, "9") )
     2127       view-as alert-box.
     2128       apply "entry" to dop-sr-izm.sr-abs-err-water in frame Dialog-Frame .
     2129       return error .
     2130     end.
     2131     v-delta = 0.5 .
     2132     if dop-sr-izm.sr-abs-err-dens > v-delta or dop-sr-izm.sr-abs-err-dens < (-1) * v-delta then do :
     2133       message substitute("&1 &2&3(+/-)&4 кг/м3",
     2134                    dop-sr-izm.sr-abs-err-dens:label in frame Dialog-Frame, v-msg2, chr(10), string(v-delta, "9.9") )
     2135       view-as alert-box.
     2136       apply "entry" to dop-sr-izm.sr-abs-err-dens in frame Dialog-Frame .
     2137       return error .
     2138     end.
     2139     if dop-sr-izm.sr-abs-err-temp-vol > v-delta or dop-sr-izm.sr-abs-err-temp-vol < (-1) * v-delta then do :
     2140       message substitute("&1 &2&3(+/-)&4 °С",
     2141                    dop-sr-izm.sr-abs-err-temp-vol:label in frame Dialog-Frame, v-msg2, chr(10), string(v-delta, "9.9") )
     2142       view-as alert-box.
     2143       apply "entry" to dop-sr-izm.sr-abs-err-temp-vol in frame Dialog-Frame .
     2144       return error .
     2145     end.
     2146     if dop-sr-izm.sr-abs-err-temp-dens > v-delta or dop-sr-izm.sr-abs-err-temp-dens < (-1) * v-delta then do :
     2147       message substitute("&1 &2&3(+/-)&4 °С",
     2148                    dop-sr-izm.sr-abs-err-temp-dens:label in frame Dialog-Frame, v-msg2, chr(10), string(v-delta, "9.9") )
     2149       view-as alert-box.
     2150       apply "entry" to dop-sr-izm.sr-abs-err-temp-dens in frame Dialog-Frame .
     2151       return error .
     2152     end.
     2153     v-delta = 0.05 .
     2154     if dop-sr-izm.sr-otnos > v-delta or dop-sr-izm.sr-otnos < (-1) * v-delta then do :
     2155       message substitute("&1 &2&3(+/-)&4 %",
     2156                    dop-sr-izm.sr-otnos:label in frame Dialog-Frame, v-msg2, chr(10), string(v-delta, "9.99") )
     2157       view-as alert-box.
     2158       apply "entry" to dop-sr-izm.sr-otnos in frame Dialog-Frame .
     2159       return error .
     2160     end.
     2161     assign
     2162       dop-sr-izm.sr-type-id   = cb-sr-type-id
     2163       v-node-code = if p-action = 'ДОБАВЛЕНИЕ':U then next-value (s-sr-izmerenia, ub) else dop-sr-izm.node-code
     2164       Msg = "":U
     2165       v-retfl = false
     2166     .
     2167     do transaction :
     2168       run ref/sr-izm01.p
     2169       (input v-node-code
     2170       ,input dop-sr-izm.sr-model
     2171       ,input dop-sr-izm.sr-type-id
     2172       ,input dop-sr-izm.sr-abs-err-neft-water
     2173       ,input dop-sr-izm.sr-abs-err-water
     2174       ,input dop-sr-izm.sr-abs-err-dens
     2175       ,input dop-sr-izm.sr-abs-err-temp-vol
     2176       ,input dop-sr-izm.sr-abs-err-temp-dens
     2177       ,input dop-sr-izm.sr-otnos
     2178       ,input dop-sr-izm.sr-temp-line
     2179       ) .
     2180       DELETE dop-sr-izm.
     2181       find first buf_sr-izm no-lock where buf_sr-izm.node-code = v-node-code no-error .
     2182       v-rec = if available buf_sr-izm then RECID(buf_sr-izm) else ?.
     2183       v-retfl = true.
     2184       catch exAppErrors as class Progress.Lang.AppError :
     2185         Msg = exAppErrors:ReturnValue .
     2186         if Msg > "" then . else do :
     2187           Msg = exAppErrors:GetMessage(1) .
     2188           if Msg > "" then . else Msg = "AppError при добавлении в sr-izmerenia" .
     2189         end .
     2190       end catch .
     2191       catch exProErrors as class Progress.Lang.ProError :
     2192         Msg = exProErrors:GetMessage(1) .
     2193         if Msg > "" then . else Msg = "ProError при добавлении в sr-izmerenia" .
     2194       end catch .
     2195       catch exAnyErrors as class Progress.Lang.Error:
     2196         Msg = "Unexpected error при добавлении в sr-izmerenia" .
     2197       end catch .
     2198       finally :
     2199         if v-retfl then .
     2200         else do:
     2201           message Msg view-as alert-box error.
     2202           return error.
     2203         end.
     2204       end finally .
     2205     end .
     2206   disable dop-sr-izm.sr-model              cb-sr-type-id               dop-sr-izm.sr-abs-err-neft-water dop-sr-izm.sr-abs-err-water      dop-sr-izm.sr-abs-err-dens       dop-sr-izm.sr-abs-err-temp-vol   dop-sr-izm.sr-abs-err-temp-dens  dop-sr-izm.sr-otnos              with FRAME Dialog-Frame.
     2207   HIDE b-cancel IN FRAME Dialog-Frame.
     2208   OPEN QUERY BR-sr-izm FOR EACH sr-izmerenia NO-LOCK .
     2209   REPOSITION br-sr-izm TO RECID v-rec.
     2210   APPLY "value-changed" TO br-sr-izm.
     2211   END PROCEDURE.
     2212   PROCEDURE proc-undo-record :
     2213   delete dop-sr-izm.
     2214   disable dop-sr-izm.sr-model              cb-sr-type-id               dop-sr-izm.sr-abs-err-neft-water dop-sr-izm.sr-abs-err-water      dop-sr-izm.sr-abs-err-dens       dop-sr-izm.sr-abs-err-temp-vol   dop-sr-izm.sr-abs-err-temp-dens  dop-sr-izm.sr-otnos              with FRAME Dialog-Frame.
     2215   HIDE b-cancel IN FRAME Dialog-Frame.
     2216   APPLY "VALUE-CHANGED" TO br-sr-izm IN FRAME Dialog-Frame.
     2217   END PROCEDURE.
