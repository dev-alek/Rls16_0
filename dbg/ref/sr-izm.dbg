     1175     .
     1176   end procedure.
     1177   procedure diasize_set-height :
     1178     define input  parameter p-new-height  as decimal   no-undo .
     1179     define input  parameter p-move-resize as logical   no-undo .
     1180     do
     1181     on error undo, return error return-value
     1182     :
     1183       run diasize_change-height in this-procedure
     1184         (input  (p-new-height - frame Dialog-Frame :height)
     1185         ,input  p-move-resize
     1186         ) .
     1187     end.
     1188   end procedure.
     1189   procedure diasize_change-width :
     1190     define input  parameter p-change-value as decimal   no-undo .
     1191     define input  parameter p-move-resize  as logical   no-undo .
     1192     define variable v-field-group-handle   as handle    no-undo .
     1193     define variable v-object-handle        as handle    no-undo .
     1194     define variable v-frame-width          as decimal   no-undo .
     1195     define variable v-frame-virtual-width  as decimal   no-undo .
     1196     define variable v-browse-width         as decimal   no-undo .
     1197     define variable v-window-width         as decimal   no-undo .
     1198     define variable v-window-virtual-width as decimal   no-undo .
     1199     define variable v-change-sign          as integer   no-undo .
     1200     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1201     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1202     if p-change-value > 0
     1203     then do:
     1204       if frame Dialog-Frame :width + p-change-value >
     1205           session :width-chars
     1206       then do:
     1207         assign
     1208           p-change-value = session :width-chars - frame Dialog-Frame :width
     1209         .
     1210         if p-change-value <= 0
     1211         then do:
     1212           run diasize_position-resize-button in this-procedure .
     1213           return .
     1214         end.
     1215       end.
     1216     end.
     1217     if p-change-value < 0
     1218     then do:
     1219       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1220       then do:
     1221         assign
     1222           p-change-value = v-diasize-orig-frame-width
     1223                          - frame Dialog-Frame :width
     1224         .
     1225         if p-change-value >= 0
     1226         then do:
     1227           run diasize_position-resize-button in this-procedure .
     1228           return .
     1229         end.
     1230       end.
     1231     end.
     1232     if p-change-value >= 0
     1233     then do:
     1234       assign
     1235         v-change-sign = 1
     1236       .
     1237     end.
     1238     else do:
     1239       assign
     1240         v-change-sign = -1
     1241       .
     1242     end.
     1243     assign
     1244       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1245     .
     1246     if p-change-value = 0
     1247     then do:
     1248       run diasize_position-resize-button in this-procedure .
     1249       return .
     1250     end.
     1251     move_block:
     1252     do
     1253     on error undo move_block, leave move_block
     1254     :
     1255       if retry
     1256       then do:
     1257         do
     1258         on error undo move_block, leave move_block
     1259         :
     1260           if p-change-value > 0
     1261           then do:
     1262             for each buf_temp-diasize-handle
     1263             on error undo, next
     1264             :
     1265               assign
     1266                 v-object-handle = buf_temp-diasize-handle.handle-value
     1267               .
     1268               if v-object-handle <> v-diasize-resize-button
     1269               then do:
     1270                 assign
