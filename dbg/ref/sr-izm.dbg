      453   format "9.999" label "Относительная погрешность измерений плотности ЖФ продукта, %"
      454   view-as fill-in size 15  by 1
      455   field sr-abs-err-dens-lgas-vapor as decimal column-label " Абсолютная погрешность измерений плотности ПГФ продукта, кг/м3"
      456   format "9.999" initial 0 label "Абсолютная погрешность измерений плотности ПГФ продукта, кг/м3"
      457   view-as fill-in size 15  by 1
      458   field sr-otnos as decimal column-label "относительная погрешность измерения массы, %"
      459   format "9.999999" initial 0 label "относительная погрешность измерения массы, %"
      460   view-as fill-in size 15  by 1
      461   field node-code as integer  column-label "Код"
      462   format ">>>9" label "Код"
      463   fgcolor RED_COLOR
      464   index pi is unique primary
      465   node-code
      466   .
      467   define shared variable g#db-num as integer no-undo .
      468   DEFINE VARIABLE v-max-node-code AS INTEGER NO-UNDO.
      469   DEFINE VARIABLE v-node-code AS INTEGER NO-UNDO.
      470   define variable v-edit-mode as logical no-undo .
      471   define variable v-action-mode as character no-undo .
      472   define variable mNotUsedStr as character no-undo fgcolor 12.
      473   define buffer buf_clob-bind for ub.clob-bind.
      474   define variable cb-sr-type-id as integer column-label "Тип"
      475     format ">9" label "Тип"
      476     view-as combo-box list-item-pairs
      477       "Ареометр, отградуирован при 15°С",1,
      478       "Ареометр, отградуирован при 20°С",2,
      479       "Поточный плотномер",3,
      480       "Погружной плотномер",4,
      481       "Канал измерения плотности (с поточным плотномером)",5,
      482       "Канал измерения плотности (без поточного плотномера)",6
      483     inner-lines 5 drop-down-list size-chars 55 by 1
      484   .
      485   DEFINE BUTTON b-add
      486        LABEL "&Добавить"
      487        SIZE 10 BY 1.
      488   DEFINE BUTTON b-look
      489        LABEL "&Просмотр"
      490        SIZE 10 BY 1.
      491   DEFINE BUTTON b-cancel
      492        LABEL "Отмена"
      493        SIZE 10 BY 1.
      494   DEFINE BUTTON b-cng
      495        LABEL "&Изменить"
      496        SIZE 10 BY 1.
      497   DEFINE BUTTON b-del
      498        LABEL "&Удалить"
      499        SIZE 10 BY 1.
      500   DEFINE BUTTON b-sel
      501        LABEL "&Выбор"
      502        SIZE 10 BY 1.
      503   DEFINE BUTTON B-Help
      504        LABEL "Помо&щь"
      505        SIZE 3 BY 1
      506        BGCOLOR 8 .
      507   DEFINE BUTTON B-hist
      508        LABEL "Ис&тория"
      509        SIZE 3 BY 1.
      510   DEFINE BUTTON b-quit AUTO-GO
      511        LABEL "&Закрыть"
      512        SIZE 10 BY 1
      513        BGCOLOR 8 .
      514   DEFINE QUERY BR-sr-izm FOR
      515         sr-izmerenia SCROLLING.
      516   DEFINE BROWSE BR-sr-izm
      517      QUERY BR-sr-izm NO-LOCK DISPLAY
      518         sr-izmerenia.node-code
      519         sr-izmerenia.sr-model
      520         sr-izmerenia.sr-type-id
      521         sr-izmerenia.sr-abs-err-neft-water
      522         sr-izmerenia.sr-abs-err-water
      523         sr-izmerenia.sr-abs-err-dens
      524         sr-izmerenia.sr-abs-err-temp-vol
      525         sr-izmerenia.sr-abs-err-temp-dens
      526         sr-izmerenia.sr-otnos
      527         sr-izmerenia.sr-temp-line
      528       WITH NO-ROW-MARKERS SEPARATORS SIZE 142 BY 13 FIT-LAST-COLUMN.
      529   DEFINE FRAME Dialog-Frame
      530        b-quit AT ROW 1 COL 11 WIDGET-ID 6
      531        b-sel at row 1 col 26  WIDGET-ID 10
      532        b-add AT ROW 1 COL 45 WIDGET-ID 14
      533        b-cng AT ROW 1 COL 55 WIDGET-ID 4
      534        b-del AT ROW 1 COL 65 WIDGET-ID 22
      535        b-look AT ROW 1 COL 75 WIDGET-ID 22
      536        B-hist AT ROW 1 COL 137
      537        B-Help AT ROW 1 COL 140.5
      538        BR-sr-izm AT ROW 4.25 COL 1.5 WIDGET-ID 200
      539        b-cancel AT ROW 18 COL 88 WIDGET-ID 26
      540        SPACE(45.87) SKIP(8.74)
      541       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      542            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      543            TITLE "Справочник средств измерений" WIDGET-ID 100.
      544   ASSIGN
      545          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      546          FRAME Dialog-Frame:HIDDEN           = TRUE.
      547   ASSIGN
      548          b-cancel:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      549   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      550   DO:
      551     APPLY "END-ERROR":U TO SELF.
      552   END.
      553   ON CHOOSE OF b-add IN FRAME Dialog-Frame
      554   DO:
      555     v-action-mode = 'ДОБАВЛЕНИЕ':U .
      556     RUN ref\sr-izm-frm.w ('ДОБАВЛЕНИЕ':U, ?) no-error.
      557     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
      558     OPEN QUERY BR-sr-izm FOR EACH sr-izmerenia NO-LOCK .
      559       APPLY "value-changed" TO BROWSE br-sr-izm.
      560   END.
      561   ON CHOOSE OF b-cancel IN FRAME Dialog-Frame
      562   DO:
      563     RUN proc-undo-record IN THIS-PROCEDURE NO-ERROR.
      564     IF ERROR-STATUS:ERROR THEN do:
      565       enable
      566       b-add when v-edit-mode
      567       b-cng when v-edit-mode
      568       b-del when v-edit-mode
      569       with frame Dialog-Frame .
      570       RETURN NO-APPLY.
      571     end.
      572     v-action-mode= "":U.
      573     enable
      574     b-add when v-edit-mode
      575     b-cng when v-edit-mode
      576     b-del when v-edit-mode
      577     with frame Dialog-Frame .
      578   END.
      579   ON CHOOSE OF b-cng IN FRAME Dialog-Frame
      580   DO:
      581     define variable vnode-code as integer  no-undo.
      582     IF NOT AVAILABLE sr-izmerenia THEN RETURN NO-APPLY.
      583     vnode-code = sr-izmerenia.node-code.
      584     RUN ref\sr-izm-frm.w ('ИЗМЕНЕНИЕ':U, sr-izmerenia.node-code) no-error.
      585     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
      586     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
      587     run reopen-query .
      588     find first sr-izmerenia where sr-izmerenia.node-code eq  vnode-code no-lock.
      589     reposition BR-sr-izm to rowid rowid(sr-izmerenia) no-error .
      590       APPLY "value-changed" TO BROWSE br-sr-izm.
      591   END.
      592   ON CHOOSE OF b-del IN FRAME Dialog-Frame
      593   DO:
      594     IF NOT AVAILABLE sr-izmerenia  THEN RETURN NO-APPLY.
      595     RUN proc-b-del IN THIS-PROCEDURE NO-ERROR.
      596     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
      597     run reopen-query .
      598       APPLY "value-changed" TO BROWSE br-sr-izm.
      599   END.
      600   ON CHOOSE OF b-look IN FRAME Dialog-Frame
      601   DO:
      602     define variable vnode-code as integer  no-undo.
      603     IF NOT AVAILABLE sr-izmerenia THEN RETURN NO-APPLY.
      604     vnode-code = sr-izmerenia.node-code.
      605     RUN ref\sr-izm-frm.w ('ПРОСМОТР':U, sr-izmerenia.node-code) .
      606     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
      607     run reopen-query .
      608     find first sr-izmerenia where sr-izmerenia.node-code eq  vnode-code no-lock.
      609     reposition BR-sr-izm to rowid rowid(sr-izmerenia) no-error .
      610     APPLY "value-changed" TO BROWSE br-sr-izm.
      611   END.
      612   ON CHOOSE OF B-sel IN FRAME Dialog-Frame
      613   DO:
      614     if available sr-izmerenia then do :
      615       if sr-izmerenia.sr-not-used then do:
      616         message "Средство измерения отмечено как неиспользуемое. Выбор запрещен."
      617         view-as alert-box warning.
      618         return no-apply.
      619       end.
      620       p-node-code = sr-izmerenia.node-code.
      621       p-sr-type = string(sr-izmerenia.sr-type-id).
      622     end.
      623     else p-node-code = ? .
      624     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
      625     apply "choose" to b-quit .
      626   END.
      627   ON CHOOSE OF B-hist IN FRAME Dialog-Frame
      628   DO:
      629     DEFINE VARIABLE v-rid-list AS CHARACTER NO-UNDO.
      630     IF AVAILABLE sr-izmerenia THEN DO:
      631     run ref/csr-izm.w (
      632                       INPUT parParentProc
      633                      ,input '':U
      634                      ,input 'one':U
      635                      ,input  ''
      636                      ,input  0
      637                      ,INPUT sr-izmerenia.node-code
      638                      ,INPUT-OUTPUT v-rid-list) NO-ERROR.
      639     END.
      640   END.
      641   ON VALUE-CHANGED OF BR-sr-izm IN FRAME Dialog-Frame
      642   DO:
      643     define variable vNotUsedStr as character no-undo.
      644     if b-cancel:visible in frame Dialog-Frame  then do:
      645       return no-apply.
      646     end.
      647     IF AVAILABLE sr-izmerenia THEN do:
      648       assign
      649         cb-sr-type-id   = sr-izmerenia.sr-type-id
      650         vNotUsedStr     = if sr-izmerenia.sr-not-used then "!!! СРЕДСТВО ИЗМЕРЕНИЯ НЕ ИСПОЛЬЗУЕТСЯ !!!"  else ""
      651       .
      652       DISPLAY
      653         sr-izmerenia.node-code @ dop-sr-izm.node-code AT ROW 18 COL 5 LEFT-ALIGNED  SKIP
      654         vNotUsedStr @ mNotUsedStr  AT ROW 18 COL 45 LEFT-ALIGNED format "x(42)" no-label SKIP
      655         sr-izmerenia.sr-model  @ dop-sr-izm.sr-model  AT ROW 19 COL 5 LEFT-ALIGNED  SKIP
      656         cb-sr-type-id    AT ROW 20 COL 5 LEFT-ALIGNED  SKIP
      657         sr-izmerenia.sr-abs-err-neft-water @ dop-sr-izm.sr-abs-err-neft-water AT ROW 21 COL 5 LEFT-ALIGNED  SKIP
      658         sr-izmerenia.sr-abs-err-water      @ dop-sr-izm.sr-abs-err-water      AT ROW 22 COL 5 LEFT-ALIGNED  SKIP
      659         sr-izmerenia.sr-abs-err-dens       @ dop-sr-izm.sr-abs-err-dens       AT ROW 23 COL 5 LEFT-ALIGNED  SKIP
      660         sr-izmerenia.sr-abs-err-temp-vol   @ dop-sr-izm.sr-abs-err-temp-vol   AT ROW 24 COL 5 LEFT-ALIGNED  SKIP
      661         sr-izmerenia.sr-abs-err-temp-dens  @ dop-sr-izm.sr-abs-err-temp-dens  AT ROW 25 COL 5 LEFT-ALIGNED  SKIP
      662         sr-izmerenia.sr-otnos              @ dop-sr-izm.sr-otnos              AT ROW 26 COL 5 LEFT-ALIGNED  SKIP
      663       with FRAME Dialog-Frame .
      664     END.
      665   END.
      666   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      667   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      668   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      669   on help of frame Dialog-Frame
      670   do:
      671     run gbl/app_help.p
      672       (input this-procedure :file-name
      673       ,input ''
      674       ,input ?
      675       ) no-error.
      676     if error-status :error then do:
      677       message
      678         "Ошибка при вызове помощи"
      679         error-status :get-message(1)
      680         view-as alert-box .
      681     end.
      682   end.
      683   run minbtn-set in this-procedure .
      684   on choose of b-help in frame Dialog-Frame
      685   do:
      686     apply "help":u to frame Dialog-Frame .
      687   end.
      688   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      689   procedure minbtn-set :
      690       do
      691           on error undo, return error return-value
      692           :
      693           define variable ii              as integer       no-undo .
      694           define variable fh              as widget-handle no-undo .
      695           define variable hh              as widget-handle no-undo .
      696           define variable v-h             as handle        extent 4 no-undo .
      697           define variable v-name-button   as character     no-undo .
      698           define variable v-help-old-x    as decimal       no-undo .
      699           define variable v-help-old-y    as decimal       no-undo .
      700           define variable v-help-old-size as decimal       no-undo .
      701           define variable v-frame-width   as decimal       no-undo .
      702           define variable jj              as integer       no-undo .
      703           do
      704               on error undo, return error
      705               :
      706               assign
      707                   v-frame-width = frame Dialog-Frame:width - 0.3
      708                   fh            = frame Dialog-Frame:first-child
      709                   hh            = fh:first-child
      710                   ii            = 1
      711                   .
      712               do while valid-handle(hh):
      713                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      714                   do:
      715                       case lc(hh:name) :
      716                           when "b-help" then
      717                               do:
      718                                   hh:load-image-up("cmp/b-help.bmp":u) .
      719                                   hh:load-image-down("cmp/b-help.bmp":u) .
      720                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      721                                   hh:TOOLTIP = "Помощь" .
      722                                   v-help-old-x = hh:column .
      723                                   v-help-old-y = hh:row    .
      724                                   v-help-old-size = hh:width .
      725                                   hh:width-chars = 2.5 .
      726                               end.
      727                           when "b-print" then
      728                               do:
      729                                   hh:load-image("cmp/b-print.bmp":u) .
      730                                   hh:TOOLTIP = "Печать" .
      731                                   v-h[ii] = hh:handle .
      732                                   ii = ii + 1 .
      733                                   hh:width-chars = 3 .
      734                               end.
      735                           when "b-history" or
      736                           when "b-hist" then
      737                               do:
      738                                   hh:load-image("cmp/b-hist.bmp":u) .
      739                                   hh:TOOLTIP = "История" .
      740                                   v-h[ii] = hh:handle .
      741                                   ii = ii + 1 .
      742                                   hh:width-chars = 3 .
      743                               end.
      744                           when "b-sch" then
      745                               do:
      746                                   hh:load-image("cmp/b-sch.bmp":u) .
      747                                   hh:TOOLTIP = "Установка Фильтра" .
      748                                   v-h[ii] = hh:handle .
      749                                   ii = ii + 1 .
      750                                   hh:width-chars = 3 .
      751                               end.
      752                           when "b-hist-user" then
      753                               do:
      754                                   hh:load-image("cmp/b-hist.bmp":u) .
      755                                   hh:TOOLTIP = "История пользователя" .
      756                                   ii = ii + 1 .
      757                               end.
      758                       end case.
      759                   end.
      760                   hh = hh:next-sibling.
      761               end.
      762               b-help:column = v-frame-width - b-help:width-chars.
      763               jj = 0.
      764               repeat ii = 4 to 1 by -1 :
      765                   if valid-handle (v-h[ii] ) then
      766                   do:
      767                       jj  = jj + 1 .
      768                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      769                       v-h[ii]:row    = v-help-old-y .
      770                   end.
      771               end.
      772           end.
      773       end.
      774   end procedure.
      775   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      776   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      777   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      778   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      779   define variable v-diasize-current-frame-width  as decimal   no-undo .
      780   define variable v-diasize-current-frame-height as decimal   no-undo .
      781   define variable v-diasize-change-size          as logical   no-undo .
      782   define variable v-diasize-resize-button        as handle    no-undo .
      783   define variable v-diasize-wndmax               as logical   no-undo .
      784   define variable v-diasize-wndstore             as logical   no-undo .
      785   define variable v-diasize-proc-name            as character no-undo .
      786   define variable v-diasize-browse-handle        as handle    no-undo .
      787   define variable v-diasize-browse-number        as integer   no-undo .
      788   define variable v-diasize-need-full-display    as logical   no-undo init false .
      789   define temp-table temp-diasize-handle no-undo
      790     field handle-value  as handle
      791     field save-position as decimal
      792     index xpk is primary unique handle-value
      793     .
      794   define temp-table temp-browse-handle no-undo
      795     field browse-type   as character
      796     field browse-number as integer
      797     field browse-handle as handle
      798     field original-size as decimal
      799     index xpk is primary unique browse-type browse-number
      800     index xie browse-type browse-handle
      801   .
      802   procedure diasize_change-height :
      803     define input  parameter p-change-value  as decimal   no-undo .
      804     define input  parameter p-move-resize   as logical   no-undo .
      805     define variable v-field-group-handle    as handle    no-undo .
      806     define variable v-object-handle         as handle    no-undo .
      807     define variable v-frame-height          as decimal   no-undo .
      808     define variable v-frame-virtual-height  as decimal   no-undo .
      809     define variable v-browse-height         as decimal   no-undo .
      810     define variable v-window-height         as decimal   no-undo .
      811     define variable v-window-virtual-height as decimal   no-undo .
      812     define variable v-change-sign           as integer   no-undo .
      813     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      814     define buffer buf_temp-browse-handle  for temp-browse-handle .
      815     if p-change-value > 0
      816     then do:
      817       if frame Dialog-Frame :height + p-change-value
      818           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      819       then do:
      820         assign
      821           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      822                           - (frame Dialog-Frame :height-chars)
      823         .
      824         if p-change-value <= 0
      825         then do:
      826           run diasize_position-resize-button in this-procedure .
      827           return .
      828         end.
      829       end.
      830     end.
      831     if p-change-value < 0
      832     then do:
      833       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      834       then do:
      835         assign
      836           p-change-value = v-diasize-orig-frame-height
      837                          - (frame Dialog-Frame :height-chars)
      838         .
      839         if p-change-value >= 0
      840         then do:
      841           run diasize_position-resize-button in this-procedure .
      842           return .
      843         end.
      844       end.
      845     end.
      846     if p-change-value >= 0
      847     then do:
      848       assign
      849         v-change-sign = 1
      850       .
      851     end.
      852     else do:
      853       assign
      854         v-change-sign = -1
      855       .
      856     end.
      857     assign
      858       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      859     .
      860     if p-change-value = 0
      861     then do:
      862       run diasize_position-resize-button in this-procedure .
      863       return .
      864     end.
      865     move_block:
      866     do
      867     on error undo move_block, retry move_block
      868     :
      869       if retry
      870       then do:
      871         do
      872         on error undo move_block, leave move_block
      873         :
      874           if p-change-value > 0
      875           then do:
      876             for each buf_temp-diasize-handle
      877             on error undo, next
      878             :
      879               assign
      880                 v-object-handle = buf_temp-diasize-handle.handle-value
      881               .
      882               if v-object-handle <> v-diasize-resize-button
      883               then do:
      884                 assign
      885                   v-object-handle :row = buf_temp-diasize-handle.save-position
      886                 .
      887               end.
      888             end.
      889             assign
      890               v-diasize-browse-handle :height = v-browse-height
      891             .
      892             for each buf_temp-browse-handle
      893               where buf_temp-browse-handle.browse-type = 'height':u
      894             on error undo, next
      895             :
      896               assign
      897                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      898               .
      899             end.
      900             assign
      901               frame Dialog-Frame :height = v-frame-height
      902             .
      903             if frame Dialog-Frame :scrollable = true
      904             then do:
      905               assign
      906                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      907               .
      908             end.
      909             run diasize_position-resize-button in this-procedure .
      910           end.
      911           else do:
      912             if frame Dialog-Frame :scrollable = true
      913             then do:
      914               assign
      915                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      916               .
      917             end.
      918             assign
      919               frame Dialog-Frame :height = v-frame-height
      920             .
      921             assign
      922               v-diasize-browse-handle :height = v-browse-height
      923             .
      924             for each buf_temp-browse-handle
      925               where buf_temp-browse-handle.browse-type = 'height':u
      926             on error undo, next
      927             :
      928               assign
      929                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      930               .
      931             end.
      932             for each buf_temp-diasize-handle
      933             on error undo, next
      934             :
      935               assign
      936                 v-object-handle = buf_temp-diasize-handle.handle-value
      937               .
      938               if v-object-handle <> v-diasize-resize-button
      939               then do:
      940                 assign
      941                   v-object-handle :row = buf_temp-diasize-handle.save-position
      942                 .
      943               end.
      944             end.
      945             run diasize_position-resize-button in this-procedure .
      946           end.
      947           assign
      948             v-diasize-change-size = false
      949           .
      950           leave move_block .
      951         end.
      952       end.
      953       assign
      954         v-diasize-need-full-display = true
      955       .
      956       if v-diasize-change-size = false
      957       then do:
      958         assign
      959           v-diasize-change-size = true
      960         .
      961       end.
      962       else do:
      963         return .
      964       end.
      965       assign
      966         v-frame-height = frame Dialog-Frame :height
      967         v-frame-virtual-height = frame Dialog-Frame :virtual-height
      968         v-browse-height = v-diasize-browse-handle :height
      969       .
      970       for each buf_temp-browse-handle
      971         where buf_temp-browse-handle.browse-type = 'height':u
      972       :
      973         assign
      974           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
      975         .
      976       end.
      977       for each buf_temp-diasize-handle
      978       :
      979         delete buf_temp-diasize-handle .
      980       end.
      981       assign
