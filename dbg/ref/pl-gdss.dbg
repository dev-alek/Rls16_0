      760                 input 'update':U
      761                 , input 'pl-gds':U
      762                 , input ( buffer X_pl-gds :handle )
      763                 , input ?
      764                 , input ""
      765                 ) no-error.
      766               if error-status :error
      767                 then
      768               do:
      769                 undo, return substitute( "&2&1Ошибка при записи истории пользователя&1&3&1&4"
      770                   , chr(10)
      771                   , vss-workfile
      772                   , return-value
      773                   , error-status :get-message ( 1 ) ).
      774               end.
      775             end.
      776         end case.
      777       end.
      778     END.
      779   ON CHOOSE OF B-add IN FRAME Dialog-Frame
      780     DO:
      781       define variable loc-rid-list as char    no-undo.
      782       define variable ii           as integer no-undo.
      783       define variable kk           as integer no-undo.
      784       define variable glog         as logical no-undo .
      785       define variable individ      as logical no-undo.
      786       define buffer buf_pl-gds for ub.pl-gds .
      787       define buffer buf_goods  for ub.goods.
      788       define buffer buf_units  for ub.units.
      789   define variable vss-include-info8 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      790   do:
      791     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      792       (input  v-cntxt-db-num
      793       ,input  v-cntxt-userid
      794       ,input  0
      795       ,input  'actn_place-reference_work':U
      796       ,input  'object':U
      797       ,input  v-chk-act-host-code
      798       ,input  p-obj-type
      799       ,input  p-obj-code
      800       ,input  0
      801       ,input  0
      802       ,input  0
      803       ,input  true
      804       ,output glog
      805       )  .
      806   end.
      807       if NOT glog then return no-apply.
      808       run ref/gds-ref.p (
      809         input parparentproc
      810         ,input "b-sel,b-add"
      811         ,input ?
      812         ,input ?
      813         ,input ?
      814         ,input ?
      815         ,input ?
      816         ,input ?
      817         ,input ?
      818         ,input p-obj-type
      819         ,input p-obj-code
      820         ,input ?
      821         ,output loc-rID-list).
      822       apply "entry" to br-pl-gds in frame Dialog-Frame.
      823       if loc-rid-list = "" then
      824         return no-apply.
      825       run waitfram-show in this-procedure ( input "Ждите...").
      826       _ii:
      827       do ii = 1 to num-entries(loc-rid-list):
      828         find buf_goods where recid (buf_goods) = integer (ENTRY(ii, loc-rid-list)) no-lock.
      829         if avail buf_goods then
      830         do:
      831           FIND FIRST buf_units No-LOCK where
      832             buf_units.unit-name = buf_goods.unit-base No-ERROR.
      833           if not avail buf_units then NEXT.
      834           if LOOKUP('топ':U, buf_units.type) > 0  and lookup('дро':U, buf_units.type) > 0
      835             then
      836             assign
      837               individ = yes.
      838           else
      839             assign
      840               individ = no.
      841           do transaction on error undo, next :
      842             find first buf_pl-gds no-lock
      843               where buf_pl-gds.obj-type = shop-type
      844               and buf_pl-gds.obj-code = shop-code
      845               and buf_pl-gds.pl-code  = plcode
      846               and buf_pl-gds.gds-code = buf_goods.gds-code no-error.
      847             if not available buf_pl-gds then
      848             do:
      849               if lookup('топ':U, buf_units.type) > 0
      850                 and lookup('дро':U, buf_units.type) > 0 then
      851               do:
      852                 run trg/plgdpmvc.p (
      853                   input  shop-type,
      854                   input  shop-code,
      855                   input  plcode,
      856                   input  buf_goods.gds-code,
      857                   output glog) no-error.
      858                 if error-status:error then
      859                 do:
      860                   message
      861                     "Ошибка при привязке товара к резервуару." skip
      862                     return-value skip
      863                     error-status:get-message(1)
      864                     view-as alert-box error.
      865                   undo, next.
      866                 end.
      867                 if not glog then
      868                 do:
      869                   if return-value <> "" then
      870                     message return-value view-as alert-box ERROR.
      871                   undo , next .
      872                 end.
      873                 if glog then kk = kk + 1.
      874               END.
      875               else
      876               do:
      877                 run trg/plgdpmv0.p (
      878                   input shop-type,
      879                   input shop-code,
      880                   input plcode,
      881                   input buf_goods.gds-code,
      882                   output glog) no-error.
      883                 if error-status:error then
      884                 do:
      885                   undo, next.
      886                 end.
      887                 if not glog then
      888                 do:
      889                   if return-value <> "" then
      890                     message return-value view-as alert-box ERROR.
      891                   undo , next .
      892                 end.
      893                 if glog then kk = kk + 1.
      894               end.
      895             end.
      896             else
      897             do:
      898               message
      899                 "Уже есть привязка резервуара " buf_pl-gds.pl-code
      900                 " с товаром " buf_goods.artic " " buf_goods.prod-type " " buf_goods.prod-code " " buf_goods.gds-name " ."
      901                 view-as alert-box error.
      902               next.
      903             end.
      904           end.
      905         end.
      906       end.
      907       run waitfram-hide in this-procedure .
      908       if kk < num-entries(loc-rid-list) then
      909       do:
      910         message
      911           "Из выбранных " num-entries(loc-rid-list) " товаров " skip
      912           "к данному складскому месту удалось привязать "
      913           kk " товаров " view-as alert-box
      914           WARNING.
      915       end.
      916       v-ok-mode = 'ДОБАВЛЕНИЕ':U .
      917       run OpenBr in this-procedure ( input yes, input no, input '':U).
      918       APPLY "ENTRY" to br-pl-gds.
      919     END.
      920   ON CHOOSE OF B-chg IN FRAME Dialog-Frame
      921     DO:
      922   define variable vss-include-info9 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      923   do:
      924     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      925       (input  v-cntxt-db-num
      926       ,input  v-cntxt-userid
      927       ,input  0
      928       ,input  'actn_place-reference_work':U
      929       ,input  'object':U
      930       ,input  v-chk-act-host-code
      931       ,input  p-obj-type
      932       ,input  p-obj-code
      933       ,input  0
      934       ,input  0
      935       ,input  0
      936       ,input  true
      937       ,output glog
      938       )  .
      939   end.
      940       if NOT glog then return no-apply.
      941       assign
      942         X_pl-gds.tolerance :read-only in browse BR-pl-gds = NOT
      943     X_pl-gds.tolerance :read-only in browse BR-pl-gds .
      944       APPLY "ENTRY" to browse BR-pl-gds.
      945       IF  X_pl-gds.tolerance :read-only in browse BR-pl-gds = FALSE THEN
      946       do:
      947         RECT-tolerance:BGCOLOR = GREEN_COLOR.
      948         APPLY "ENTRY" to X_pl-gds.tolerance in browse BR-pl-gds.
      949       end.
      950       else
