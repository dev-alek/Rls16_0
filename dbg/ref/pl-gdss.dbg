      150   procedure fltfield-clear :
      151     define output parameter loc-fld as character no-undo.
      152     define output parameter loc-lab as character no-undo .
      153     define output parameter loc-spr as character no-undo .
      154     define output parameter loc-dim as character no-undo .
      155     assign
      156       loc-fld = ""
      157       loc-lab = ""
      158       loc-spr = ""
      159       loc-dim = "0"
      160     .
      161   end procedure .
      162   procedure fltfield-add :
      163     define input        parameter par-fld as character no-undo.
      164     define input        parameter par-lab as character no-undo .
      165     define input        parameter par-spr as character no-undo .
      166     define input-output parameter loc-fld as character no-undo.
      167     define input-output parameter loc-lab as character no-undo .
      168     define input-output parameter loc-spr as character no-undo .
      169     define input-output parameter loc-dim as character no-undo .
      170     do
      171     on error undo, return error
      172     :
      173       assign
      174       loc-fld = if loc-dim = '0'
      175                 then par-fld
      176                 else (loc-fld + chr(44) + par-fld)
      177       loc-lab = if loc-dim = '0'
      178                 then par-lab
      179                 else (loc-lab + chr(44) + par-lab)
      180       loc-spr = if loc-dim = '0'
      181                 then par-spr
      182                 else (loc-spr + chr(44) + par-spr)
      183       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
      184                 string(integer(if num-entries(loc-dim) > 1
      185                               then entry(2, loc-dim)
      186                               else entry(1, loc-dim)
      187                               ) + 1)
      188       no-error
      189       .
      190     end.
      191   end procedure.
      192   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      193   define variable v-waitfram-action01         as character   no-undo .
      194   define variable v-waitfram-action02         as character   no-undo .
      195   define variable v-waitfram-action03         as character   no-undo .
      196   define variable mWaitFramTextBeg            as character   no-undo.
      197   define variable mWaitFramTextEnd            as character   no-undo.
      198   define variable mWaitFramView               as logical     no-undo.
      199   define variable mWaitProcEvent              as logical     no-undo init yes.
      200   define variable mWaitFramInterval           as integer     no-undo init 1 .
      201   define variable mWaitFramStop               as logical     no-undo.
      202   define variable mWaitFramStopUser           as logical     no-undo.
      203   define variable mWaitFramStopTimeOut        as logical     no-undo.
      204   define variable mWaitFramStartProc          as datetime-tz no-undo.
      205   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      206   define button B-WaitFramStop auto-end-key
      207        label "Стоп"
      208        size 10 by 1 tooltip "Остоновить процесс".
      209   define button B-viewProcInfo
      210        label "Информация"
      211        size 15 by 1 tooltip "Информация о процесс".
      212   define frame waitfram
      213     v-waitfram-action01 format "x(72)" no-label skip
      214     v-waitfram-action02 format "x(72)" no-label skip
      215     v-waitfram-action03 format "x(72)" no-label skip
      216     B-viewProcInfo
      217     B-WaitFramStop at row 4 col 30
      218     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      219     .
      220   define new global shared variable mBatchMode as logical no-undo init ?.
      221   define variable mFramBachModHandle as handle no-undo.
      222   mFramBachModHandle = frame waitfram:handle.
      223   define variable mFameOldVis as logical no-undo.
      224   define variable mVisCUrentVin as logical no-undo.
      225   if session:batch-mode
      226   then
      227      mBatchMode = yes.
      228   if mBatchMode = ? then do:
      229     mVisCUrentVin = current-window:visible.
      230     mFameOldVis = mFramBachModHandle:visible.
      231     mFramBachModHandle:visible  = yes.
      232     mBatchMode = mFramBachModHandle:visible ne yes.
      233     mFramBachModHandle:visible = mFameOldVis.
      234     current-window:visible = mVisCUrentVin.
      235   end.
      236    if  log-manager:logfile-name ne ?
      237     then DO:
      238         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      239         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      240         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      241     end.
      242   on choose of B-WaitFramStop in frame waitfram
      243   do:
      244     mWaitFramStop = yes.
      245     mWaitFramStopUser = yes.
      246   end.
      247   function waitfram-check-timeout returns logical():
      248      define variable vtime as int64 no-undo.
      249      if mWaitFramStopTimeOut
      250      then
      251         return yes.
      252      vtime = ( now - mWaitFramStartProc ) / 1000 .
      253      if     mWaitFramTimeOut ne ?
      254         and mWaitFramTimeOut ne 0
      255         and mWaitFramTimeOut lt vtime
      256      then do:
      257         mWaitFramStopTimeOut = yes.
      258      end.
      259      return mWaitFramStopTimeOut.
      260   end.
      261   procedure waitfram-hide :
      262     if not session:batch-mode
      263     then do
      264     on error undo, return error return-value
      265     :
      266       pause 0 before-hide .
      267       if not mBatchMode then
      268         hide frame waitfram .
      269     if     not mWaitFramView
      270        and mWaitProcEvent
      271     then
      272       process events .
      273     end.
      274   end procedure.
      275   procedure waitfram-show :
      276     define input  parameter p-message as character no-undo .
      277     define variable v-left-margin as integer   no-undo .
      278     if not session:batch-mode
      279     then do
      280     on error undo, return error return-value
      281     :
      282       if length(p-message) <= 70 then do:
      283         assign
      284           v-left-margin = integer((70 - length(p-message)) / 2)
      285         .
      286         assign
      287           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      288         .
      289         assign
      290           v-waitfram-action01 = " "
      291           v-waitfram-action02 = " "
      292                                    + fill(" ", v-left-margin)
      293                                    + p-message
      294           v-waitfram-action03 = " "
      295         .
      296       end.
      297       else do:
      298         define variable vRindex1 as integer no-undo.
      299         define variable vRindex2 as integer no-undo.
      300         vRindex1 = r-index(p-message," ",70).
      301         if vRindex1 = 0
      302         then
      303            vRindex1 = 70.
      304         if length(p-message)  <= vRindex1 + 70 then do:
      305           assign
      306             v-waitfram-action01 = " "
      307             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      308             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      309           .
      310         end.
      311         else do:
      312           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      313           if vRindex2 <= vRindex1
      314           then
      315              vRindex2 = vRindex1 + 70.
      316           assign
      317             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      318             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      319             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      320           .
      321         end.
      322       end.
      323       B-viewProcInfo:visible   in frame waitfram = no.
      324       B-viewProcInfo:sensitive in frame waitfram = no.
      325       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      326       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      327       if  (   mWaitFramView
      328          or  mWaitProcEvent)
      329          and not mBatchMode
      330       then
      331          display
      332             v-waitfram-action01 skip
      333             v-waitfram-action02 skip
      334             v-waitfram-action03 skip
      335          with frame waitfram .
      336       if     mWaitFramView
      337          then do:
      338             if     mWaitFramInterval ne ?
      339                and not mBatchMode
      340             then
      341                wait-for go of frame waitfram pause mWaitFramInterval.
      342          end.
      343          else
      344             if     mWaitProcEvent
      345                and not mBatchMode
      346             then
      347                process events .
      348     end.
      349   end procedure.
      350      procedure waitfram-show-this:
      351         define input  parameter iInterval as int64 no-undo.
      352         define variable vtime as int64 no-undo.
      353         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      354         mWaitFramInterval = iInterval.
      355         run waitfram-show (substitute("&1&2 &3&4" ,
      356                                       mWaitFramTextBeg ,
      357                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      358                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      359                                       mWaitFramTextEnd
      360                                      )
      361                           ).
      362      end.
      363      procedure WaitFramRunPause:
      364         define input  parameter iInterval as dec no-undo.
      365         define variable vStart  as datetime-tz no-undo.
      366         define variable vend    as datetime-tz no-undo.
      367         define variable vint as int64 no-undo.
      368         define variable vOk as logical no-undo.
      369         vStart = now.
      370         vend   = vStart.
      371         publish "WaitFramPause" (iInterval,output vOk).
      372         vend   =  now.
      373         vint = vend - vStart.
      374         vint = iInterval - vint / 1000.
      375         if     not mWaitFramStop
      376            and (   vint > 0
      377                 or (    not vOk
      378                     and iInterval eq ?
      379                     )
      380                 )
      381         then
      382            run waitfram-show-this (iInterval).
      383         vend   =  now.
      384         vint = vend - vStart.
      385         vint = iInterval - vint / 1000.
      386         if     not mWaitFramStop
      387            and vint > 0
      388         then do:
      389            run gbl/pause.p (vint * 1000).
      390         end.
      391         if iInterval ne ?
      392         then
      393            publish "WaitFramStop".
      394         waitfram-check-timeout().
      395      end.
      396      procedure WaitFramWaitFor:
      397         define input  parameter iInterval as dec no-undo.
      398         assign
      399            mWaitFramStartProc   = now
      400            mWaitFramStopUser    = no
      401            mWaitFramStopTimeOut = no
      402         .
      403         block-wait:
      404         do while not mWaitFramStop:
      405            run WaitFramRunPause (iInterval).
      406            if  waitfram-check-timeout()
      407            then do:
      408               leave block-wait.
      409            end.
      410         end.
      411         run waitfram-hide.
      412      end.
      413   procedure waitfram-join :
      414     define input  parameter p-line-1  as character no-undo .
      415     define input  parameter p-line-2  as character no-undo .
      416     define input  parameter p-line-3  as character no-undo .
      417     define output parameter p-message as character no-undo .
      418     do
      419     on error undo, return error return-value
      420     :
      421       assign
      422         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      423                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      424                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      425       .
      426     end.
      427   end procedure.
      428   function waitfram-join-function returns character
      429     (input p-line-1 as character
      430     ,input p-line-2 as character
      431     ,input p-line-3 as character
      432     ).
      433     define variable v-message as character no-undo .
      434     run waitfram-join in this-procedure
      435       (input  p-line-1
      436       ,input  p-line-2
      437       ,input  p-line-3
      438       ,output v-message
      439       ) .
      440     return v-message .
      441   end function .
      442   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      443   FUNCTION mark-string RETURNS CHARACTER
      444     ( input p-recid as recid, input mark-list as character  ) :
      445     RETURN ( IF LOOKUP( STRING( p-recid), mark-list ) > 0 THEN '*' ELSE '':U ).
      446   END FUNCTION.
      447   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      448     define variable v-cntxt-db-num        as integer   no-undo .
      449     define variable v-cntxt-userid        as character no-undo .
      450     define variable v-cntxt-level         as character no-undo .
      451     define variable v-cntxt-host-code-obj as integer   no-undo .
      452     define variable v-cntxt-obj-type      as character no-undo .
      453     define variable v-cntxt-obj-code      as integer   no-undo .
      454     define variable v-cntxt-db-num-obj    as integer   no-undo .
      455     define variable v-cntxt-is-admin      as logical   no-undo .
      456   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      457   define variable v-fltopend-rowid as rowid extent 18 no-undo .
      458   procedure fltopend_fltopend :
      459   define input parameter p-parent-handle as handle no-undo .
      460   define input parameter p-qh as handle no-undo .
      461   define input parameter p-flt-open-open-query  as character no-undo .
      462   define input parameter p-where-cond as character no-undo .
      463   define input parameter p-use-indFIRST-query-tail as character no-undo .
      464   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      465   define input parameter p-indexed-reposition as character no-undo .
      466     do
      467     on error undo, return error
      468     :
      469   define variable v-prepare-string as character no-undo .
      470   define variable glog as logical no-undo .
      471   assign
      472   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      473                      p-where-cond + chr(32)  +
      474                      p-use-indFIRST-query-tail + chr(32) +
      475                      p-use-ind-sort-clmn-by + chr(32) +
      476                      p-indexed-reposition
      477   .
      478   assign
      479   glog = p-qh:query-prepare(v-prepare-string) no-error .
      480   if not glog
      481   or error-status:error then do:
      482     message error-status:get-message(1) view-as alert-box .
      483     undo, return error .
      484   end.
      485   assign
      486   glog = p-qh:query-open no-error .
      487   if not glog
      488   or error-status:error then do:
      489     message error-status:get-message(1) view-as alert-box .
      490     undo, return error .
      491   end.
      492     end.
      493   end procedure.
      494   procedure fltopend_fltfindd :
      495   define input parameter p-parent-handle as handle no-undo .
      496   define input parameter p-qh as handle no-undo .
      497   define input parameter p-rowid as rowid no-undo .
      498   define input parameter p-next as logical no-undo .
      499   define input parameter p-lock as integer no-undo .
      500   define input parameter p-bh as handle no-undo .
      501   define input parameter p-where-cond as character no-undo .
      502   define input parameter p-use-index-phrase as character no-undo .
      503   define variable glog as logical no-undo .
      504   define variable v-qh as handle no-undo .
      505   define variable v-bh as handle no-undo .
      506   define variable v-recid as recid no-undo .
      507   define variable v-prepare-string as character no-undo .
      508   do
      509   on error undo, return error
      510   on stop undo, return error
      511   :
      512     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
      513     create buffer v-bh for table p-bh buffer-name p-bh:name.
      514     create query v-qh.
      515     v-qh:set-buffers(v-bh).
      516     v-prepare-string = substitute("for each &1 &2 &3"
      517                                     ,v-bh:name
      518                                     ,p-where-cond
      519                                     ,p-use-index-phrase).
      520     glog = v-qh:query-prepare(v-prepare-string) no-error.
      521     if not glog then do:
      522       delete object v-qh.
      523       delete object v-bh.
      524       undo, return error .
      525     end.
      526     glog = v-qh:query-open no-error .
      527     if not glog then do:
      528       delete object v-qh.
      529       delete object v-bh.
      530       undo, return error .
      531     end.
      532     if p-next then do:
      533       v-qh:reposition-to-rowid(p-rowid) no-error .
      534       glog = v-qh:get-next( p-lock) no-error .
      535       glog = v-qh:get-next( p-lock) no-error .
      536       if not glog or v-qh:query-off-end = yes then do:
      537         glog = v-qh:get-first( p-lock) no-error .
      538       end.
      539     end.
      540     else do:
      541       glog = v-qh:get-first( p-lock) no-error .
      542     end.
      543     v-recid = v-bh:recid no-error .
      544     delete object v-qh.
      545     delete object v-bh.
      546     return string(v-recid) .
      547   end.
      548   end procedure.
      549   procedure fltopend_fltfindq :
      550   define input parameter p-parent-handle as handle no-undo .
      551   define input parameter p-qh as handle no-undo .
      552   define input parameter p-next as logical no-undo .
      553   define input parameter p-lock as integer no-undo .
      554   define input parameter p-flt-open-open-query  as character no-undo .
      555   define input parameter p-where-cond as character no-undo .
      556   define input parameter p-use-indFIRST-query-tail as character no-undo .
      557   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      558   define input parameter p-indexed-reposition as character no-undo .
      559   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
      560   define variable glog as logical no-undo .
      561   define variable v-qh as handle no-undo .
      562   define variable v-bh as handle no-undo extent 18.
      563   define variable v-rowid as rowid no-undo extent 18.
      564   define variable v-ii as integer no-undo .
      565   define variable v-prepare-string as character no-undo .
      566   do
      567   on error undo, return error
      568   on stop undo, return error
      569   :
      570     create query v-qh.
      571     do v-ii = 1 to p-qh:num-buffers:
      572       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
      573       assign
      574       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
      575       no-error.
      576       v-qh:add-buffer(v-bh[v-ii]).
      577     end.
      578     assign
      579     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      580                       p-where-cond + chr(32)  +
      581                       p-use-indFIRST-query-tail + chr(32) +
      582                       p-use-ind-sort-clmn-by + chr(32) +
      583                       p-indexed-reposition
      584     .
      585     glog = v-qh:query-prepare( v-prepare-string) no-error .
      586     if not glog then do:
      587       delete object v-qh.
      588       do v-ii = 1 to p-qh:num-buffers:
      589         delete object v-bh[v-ii].
      590       end.
      591       undo, return error .
      592     end.
      593     glog = v-qh:query-open no-error .
      594     if not glog then do:
      595       delete object v-qh.
      596       do v-ii = 1 to p-qh:num-buffers:
      597         delete object v-bh[v-ii].
      598       end.
      599       undo, return error .
      600     end.
      601     if p-next then do:
      602       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
      603       glog = v-qh:get-next( p-lock) no-error .
      604       glog = v-qh:get-next( p-lock) no-error .
      605       if not glog or v-qh:query-off-end = yes then do:
      606         glog = v-qh:get-first( p-lock) no-error .
      607       end.
      608     end.
      609     else do:
      610       glog = v-qh:get-first( p-lock) no-error .
      611     end.
      612     do v-ii = 1 to p-qh:num-buffers:
      613       assign
      614       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
      615       no-error.
      616     end.
      617     delete object v-qh.
      618     do v-ii = 1 to p-qh:num-buffers:
      619       delete object v-bh[v-ii].
      620     end.
      621   end.
      622   end procedure.
      623   define variable filter-point  as character no-undo init "pl-gdss" .
      624   define variable filter-point0 as character no-undo init "pl-gdss" .
      625   define variable filter-label  as character no-undo init "Товар-Склд. место" .
      626   define variable filter-label0 as character no-undo init "Товар-Склд. место" .
      627   define buffer b-goods for goods.
      628   define buffer b-place for place.
      629   define VARIABLE shop-type           as char      no-undo .
      630   define VARIABLE shop-code           as integer   no-undo .
      631   define VARIABLE gdscode             as integer   no-undo .
      632   define VARIABLE plcode              as integer   no-undo .
      633   define variable sort-column-name    as character no-undo .
      634   define variable v-rid-list          as character no-undo .
      635   define variable v-ok-mode           as character no-undo .
      636   define variable v-chk-act-host-code as integer   no-undo .
