      732     END.
      733   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
      734     DO:
      735       if v-ok-mode <> "" then
      736       do:
      737         case v-ok-mode:
      738           when 'ДОБАВЛЕНИЕ':U then
      739             do:
      740               run trg/userlog.p (
      741                 input 'create':U
      742                 , input 'pl-gds':U
      743                 , input ( buffer X_pl-gds :handle )
      744                 , input ?
      745                 , input ""
      746                 ) no-error.
      747               if error-status :error
      748                 then
      749               do:
      750                 undo, return substitute( "&2&1Ошибка при записи истории пользователя&1&3&1&4"
      751                   , chr(10)
      752                   , vss-workfile
      753                   , return-value
      754                   , error-status :get-message ( 1 ) ).
      755               end.
      756             end.
      757           when 'ИЗМЕНЕНИЕ':U then
      758             do:
