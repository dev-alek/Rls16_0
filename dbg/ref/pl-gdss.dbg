      692     X_goods.prod-code FORMAT ">>>>>>>>9":U
      693     X_pl-gds.free-qnty FORMAT "->>,>>>,>>9.999":U
      694     X_pl-gds.fact-qnty FORMAT "->>,>>>,>>9.999":U
      695     X_pl-gds.cli-free-qnty FORMAT "->>,>>>,>>9.999":U
      696     X_pl-gds.cli-fact-qnty FORMAT "->>,>>>,>>9.999":U
      697     X_pl-gds.tolerance COLUMN-LABEL "Допуст.отклонение" FORMAT "->>,>>>,>>9.<<<":U
      698     X_pl-gds.status_ FORMAT "X(8)":U
      699   ENABLE
      700   X_pl-gds.tolerance
      701       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 18.
      702   DEFINE FRAME Dialog-Frame
      703     B-exit AT ROW 1 COL 1.13
      704     B-sel AT ROW 1 COL 11
      705     B-mark AT ROW 1 COL 21
      706     B-add AT ROW 1 COL 31
      707     B-chg AT ROW 1 COL 41
      708     B-del AT ROW 1 COL 51
      709     B-hist AT ROW 1 COL 89
      710     B-sch AT ROW 1 COL 92
      711     B-Help AT ROW 1 COL 95
      712     BR-pl-gds AT ROW 3.96 COL 1
