     2675             sort-column-phrase = ""
     2676             .
     2677         end.
     2678       otherwise
     2679       do:
     2680         assign
     2681           sort-column-phrase = "by " + sort-column-name
     2682           .
     2683       end.
     2684     end case.
     2685     CASE p-mode:
     2686       when 'объект':U then
     2687         do:
     2688           FIND FIRST buf_clients NO-LOCK WHERE
     2689             BUF_clients.obj-type = p-obj-type
     2690             AND BUF_clients.obj-code = p-obj-code NO-ERROR.
     2691           ASSIGN
     2692             frame
