      641   DEFINE BUTTON B-chg
      642     LABEL "&Изменить"
      643     SIZE 10 BY 1.
      644   DEFINE BUTTON B-del
      645     LABEL "&Удалить"
      646     SIZE 10 BY 1.
      647   DEFINE BUTTON B-exit AUTO-GO
      648     LABEL "&Выход"
      649     SIZE 10 BY 1
      650     BGCOLOR 8 .
      651   DEFINE BUTTON B-Help
      652     LABEL "Помо&щь"
      653     SIZE 3 BY 1
      654     BGCOLOR 8 .
      655   DEFINE BUTTON B-hist
      656     LABEL "Ис&тория"
      657     SIZE 3 BY 1.
      658   DEFINE BUTTON B-mark
      659     LABEL "*"
      660     SIZE 3 BY 1.
      661   DEFINE BUTTON B-sch
      662     LABEL "&Фильтр"
      663     SIZE 3 BY 1.
      664   DEFINE BUTTON B-sel AUTO-GO
      665     LABEL "Вы&бор"
      666     SIZE 10 BY 1.
      667   DEFINE VARIABLE mark-num AS INTEGER FORMAT ">>>9":U INITIAL 0
      668     VIEW-AS TEXT
      669     SIZE 6.25 BY .67
      670     FGCOLOR 4 NO-UNDO.
      671   DEFINE RECTANGLE RECT-tolerance
      672     EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      673     SIZE 10.13 BY 1.13
      674     BGCOLOR 8 .
      675   DEFINE QUERY BR-pl-gds FOR
      676     X_pl-gds,
      677     X_goods,
      678     X_place SCROLLING.
      679   DEFINE BROWSE BR-pl-gds
