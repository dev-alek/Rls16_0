        1   DEFINE BUFFER X_goods  FOR goods.
        2   DEFINE BUFFER X_pl-gds FOR pl-gds.
        3   DEFINE BUFFER X_place  FOR place.
        4   define input  parameter parparentproc  as widget-handle no-undo .
        5   define input  parameter bttns      as   character           no-undo .
        6   define input  parameter p-obj-type like ub.clients.obj-type no-undo .
        7   define input  parameter p-obj-code like ub.clients.obj-code no-undo .
        8   define input  parameter p-mode     as character no-undo .
        9   define input  parameter p-gds-rec   as recid      no-undo .
       10   define input  parameter p-doc-rec   as recid      no-undo .
       11   define output parameter p-rid-list   as   character           no-undo .
       12   define variable vss-revision    as character no-undo init "$Revision$":u .
       13   define variable vss-author      as character no-undo init "$Author$":u .
       14   define variable vss-date        as character no-undo init "$Date$":u .
       15   define variable vss-workfile    as character no-undo init "$Workfile$":u .
