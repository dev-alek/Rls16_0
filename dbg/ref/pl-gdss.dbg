      681     mark-string(RECID(X_pl-gds), v-rid-list) COLUMN-LABEL "*" FORMAT "X(1)":U
      682     X_pl-gds.pl-code COLUMN-LABEL "Склд.место" FORMAT ">>>>>>>>>>9":U
      683     X_place.pl-name FORMAT "X(40)":U
      684     X_place.loc1 FORMAT "X(8)":U
      685     X_place.loc2 FORMAT "X(8)":U
      686     X_place.loc3 FORMAT "X(8)":U
      687     X_place.loc4 FORMAT "X(8)":U
