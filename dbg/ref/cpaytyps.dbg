      120   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      121   define new shared variable PrintCopiesCounter as integer   no-undo initial 1 .
      122   define new shared variable RepPathName        as character no-undo .
      123   define new shared variable PrintRubl          as logical   no-undo .
      124   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      125   define variable v-waitfram-action01         as character   no-undo .
      126   define variable v-waitfram-action02         as character   no-undo .
      127   define variable v-waitfram-action03         as character   no-undo .
      128   define variable mWaitFramTextBeg            as character   no-undo.
      129   define variable mWaitFramTextEnd            as character   no-undo.
      130   define variable mWaitFramView               as logical     no-undo.
      131   define variable mWaitProcEvent              as logical     no-undo init yes.
      132   define variable mWaitFramInterval           as integer     no-undo init 1 .
      133   define variable mWaitFramStop               as logical     no-undo.
      134   define variable mWaitFramStopUser           as logical     no-undo.
      135   define variable mWaitFramStopTimeOut        as logical     no-undo.
      136   define variable mWaitFramStartProc          as datetime-tz no-undo.
      137   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      138   define button B-WaitFramStop auto-end-key
      139        label "Стоп"
      140        size 10 by 1 tooltip "Остоновить процесс".
      141   define button B-viewProcInfo
      142        label "Информация"
      143        size 15 by 1 tooltip "Информация о процесс".
      144   define frame waitfram
      145     v-waitfram-action01 format "x(72)" no-label skip
      146     v-waitfram-action02 format "x(72)" no-label skip
      147     v-waitfram-action03 format "x(72)" no-label skip
      148     B-viewProcInfo
      149     B-WaitFramStop at row 4 col 30
      150     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      151     .
      152   define new global shared variable mBatchMode as logical no-undo init ?.
      153   define variable mFramBachModHandle as handle no-undo.
      154   mFramBachModHandle = frame waitfram:handle.
      155   define variable mFameOldVis as logical no-undo.
      156   define variable mVisCUrentVin as logical no-undo.
      157   if session:batch-mode
      158   then
      159      mBatchMode = yes.
      160   if mBatchMode = ? then do:
      161     mVisCUrentVin = current-window:visible.
      162     mFameOldVis = mFramBachModHandle:visible.
      163     mFramBachModHandle:visible  = yes.
      164     mBatchMode = mFramBachModHandle:visible ne yes.
      165     mFramBachModHandle:visible = mFameOldVis.
      166     current-window:visible = mVisCUrentVin.
      167   end.
      168    if  log-manager:logfile-name ne ?
      169     then DO:
      170         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      171         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      172         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      173     end.
      174   on choose of B-WaitFramStop in frame waitfram
      175   do:
      176     mWaitFramStop = yes.
      177     mWaitFramStopUser = yes.
      178   end.
      179   function waitfram-check-timeout returns logical():
      180      define variable vtime as int64 no-undo.
      181      if mWaitFramStopTimeOut
      182      then
      183         return yes.
      184      vtime = ( now - mWaitFramStartProc ) / 1000 .
      185      if     mWaitFramTimeOut ne ?
      186         and mWaitFramTimeOut ne 0
      187         and mWaitFramTimeOut lt vtime
      188      then do:
      189         mWaitFramStopTimeOut = yes.
      190      end.
      191      return mWaitFramStopTimeOut.
      192   end.
      193   procedure waitfram-hide :
      194     if not session:batch-mode
      195     then do
      196     on error undo, return error return-value
      197     :
      198       pause 0 before-hide .
      199       if not mBatchMode then
      200         hide frame waitfram .
      201     if     not mWaitFramView
      202        and mWaitProcEvent
      203     then
      204       process events .
      205     end.
      206   end procedure.
      207   procedure waitfram-show :
      208     define input  parameter p-message as character no-undo .
      209     define variable v-left-margin as integer   no-undo .
      210     if not session:batch-mode
      211     then do
      212     on error undo, return error return-value
      213     :
      214       if length(p-message) <= 70 then do:
      215         assign
      216           v-left-margin = integer((70 - length(p-message)) / 2)
      217         .
      218         assign
      219           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      220         .
      221         assign
      222           v-waitfram-action01 = " "
      223           v-waitfram-action02 = " "
      224                                    + fill(" ", v-left-margin)
      225                                    + p-message
      226           v-waitfram-action03 = " "
      227         .
      228       end.
      229       else do:
      230         define variable vRindex1 as integer no-undo.
      231         define variable vRindex2 as integer no-undo.
      232         vRindex1 = r-index(p-message," ",70).
      233         if vRindex1 = 0
      234         then
      235            vRindex1 = 70.
      236         if length(p-message)  <= vRindex1 + 70 then do:
      237           assign
      238             v-waitfram-action01 = " "
      239             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      240             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      241           .
      242         end.
      243         else do:
      244           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      245           if vRindex2 <= vRindex1
      246           then
      247              vRindex2 = vRindex1 + 70.
      248           assign
      249             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      250             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      251             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      252           .
      253         end.
      254       end.
      255       B-viewProcInfo:visible   in frame waitfram = no.
      256       B-viewProcInfo:sensitive in frame waitfram = no.
      257       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      258       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      259       if  (   mWaitFramView
      260          or  mWaitProcEvent)
      261          and not mBatchMode
      262       then
      263          display
      264             v-waitfram-action01 skip
      265             v-waitfram-action02 skip
      266             v-waitfram-action03 skip
      267          with frame waitfram .
      268       if     mWaitFramView
      269          then do:
      270             if     mWaitFramInterval ne ?
      271                and not mBatchMode
      272             then
      273                wait-for go of frame waitfram pause mWaitFramInterval.
      274          end.
      275          else
      276             if     mWaitProcEvent
      277                and not mBatchMode
      278             then
      279                process events .
      280     end.
      281   end procedure.
      282      procedure waitfram-show-this:
      283         define input  parameter iInterval as int64 no-undo.
      284         define variable vtime as int64 no-undo.
      285         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      286         mWaitFramInterval = iInterval.
      287         run waitfram-show (substitute("&1&2 &3&4" ,
      288                                       mWaitFramTextBeg ,
      289                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      290                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      291                                       mWaitFramTextEnd
      292                                      )
      293                           ).
      294      end.
      295      procedure WaitFramRunPause:
      296         define input  parameter iInterval as dec no-undo.
      297         define variable vStart  as datetime-tz no-undo.
      298         define variable vend    as datetime-tz no-undo.
      299         define variable vint as int64 no-undo.
      300         define variable vOk as logical no-undo.
      301         vStart = now.
      302         vend   = vStart.
      303         publish "WaitFramPause" (iInterval,output vOk).
      304         vend   =  now.
      305         vint = vend - vStart.
      306         vint = iInterval - vint / 1000.
      307         if     not mWaitFramStop
      308            and (   vint > 0
      309                 or (    not vOk
      310                     and iInterval eq ?
      311                     )
      312                 )
      313         then
      314            run waitfram-show-this (iInterval).
      315         vend   =  now.
      316         vint = vend - vStart.
      317         vint = iInterval - vint / 1000.
      318         if     not mWaitFramStop
      319            and vint > 0
      320         then do:
      321            run gbl/pause.p (vint * 1000).
      322         end.
      323         if iInterval ne ?
      324         then
      325            publish "WaitFramStop".
      326         waitfram-check-timeout().
      327      end.
      328      procedure WaitFramWaitFor:
      329         define input  parameter iInterval as dec no-undo.
      330         assign
      331            mWaitFramStartProc   = now
      332            mWaitFramStopUser    = no
      333            mWaitFramStopTimeOut = no
      334         .
      335         block-wait:
      336         do while not mWaitFramStop:
      337            run WaitFramRunPause (iInterval).
      338            if  waitfram-check-timeout()
      339            then do:
      340               leave block-wait.
      341            end.
      342         end.
      343         run waitfram-hide.
      344      end.
      345   procedure waitfram-join :
      346     define input  parameter p-line-1  as character no-undo .
      347     define input  parameter p-line-2  as character no-undo .
      348     define input  parameter p-line-3  as character no-undo .
      349     define output parameter p-message as character no-undo .
      350     do
      351     on error undo, return error return-value
      352     :
      353       assign
      354         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      355                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      356                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      357       .
      358     end.
      359   end procedure.
      360   function waitfram-join-function returns character
      361     (input p-line-1 as character
      362     ,input p-line-2 as character
      363     ,input p-line-3 as character
      364     ).
      365     define variable v-message as character no-undo .
      366     run waitfram-join in this-procedure
      367       (input  p-line-1
      368       ,input  p-line-2
      369       ,input  p-line-3
      370       ,output v-message
      371       ) .
      372     return v-message .
      373   end function .
      374   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      375   define  stream PrnLibStream.
      376   procedure prn-lib-prn-file :
      377     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      378     define input parameter p-DIsabledoptions as integer no-undo .
      379     define variable v-report-name as character no-undo .
      380     define variable v-user-action as character no-undo .
      381     define variable v-printed     as logical   no-undo .
      382     define variable v-exist       as logical   no-undo .
      383     do
      384       on error undo, return error
      385       :
      386       run prn-lib-get-report-name  in this-procedure (
      387         input parParentProc
      388         ,output v-report-name
      389         ).
      390   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      391   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      392     (input  v-report-name
      393     ,input  2
      394     ,output v-exist
      395     )  .
      396       if NOT v-exist then
      397       DO:
      398         Message
      399           "Нет заданий на печать ! "
      400           view-as alert-box .
      401         Return  .
      402       End.
      403       run gbl/prnfilen.w
      404         (input  ""
      405         ,input  p-DisabledOptions
      406         ,input  string(v-report-name )
      407         ,input  7
      408         ,output v-user-action
      409         ,output v-printed
      410         ) .
      411       if v-printed then
      412       do:
      413         return "YES" .
      414       end.
      415       else
      416       do:
      417         return "NO" .
      418       end.
      419     end.
      420   end procedure.
      421   procedure prn-lib-open-stream :
      422     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      423     define input parameter p-page-size    as integer no-undo .
      424     define input parameter p-is-stream    as logical no-undo .
      425     define input parameter p-append       as logical no-undo .
      426     define variable v-report-name as character no-undo .
      427     do
      428       on error undo, return error
      429       :
      430       run prn-lib-get-report-name  in this-procedure (
      431         input parParentProc
      432         ,output v-report-name
      433         ).
      434       if p-is-stream then
      435       do:
      436         if p-append then
      437         do:
      438           output stream PrnLibStream to value( v-report-name )
      439             page-size value(p-page-size) append .
      440         end.
      441         if not p-append then
      442         do:
      443           output stream PrnLibStream to value( v-report-name )
      444             page-size value(p-page-size) .
      445         end.
      446       end.
      447       if not p-is-stream then
      448       do:
      449         if p-append then
      450         do:
      451           output to value( v-report-name )
      452             page-size value(p-page-size) append .
      453         end.
      454         if not p-append then
      455         do:
      456           output to value( v-report-name )
      457             page-size value(p-page-size) .
      458         end.
      459       end.
      460     end.
      461   end procedure.
      462   procedure prn-lib-open-exp :
      463     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      464     define input parameter p-is-stream    as logical no-undo .
      465     define input parameter p-is-append    as logical no-undo .
      466     define output parameter p-ReportFileName as char init "report" no-undo.
      467     define output parameter p-process as logical no-undo .
      468     define variable glog as logical no-undo .
      469     do
      470       on error undo, return error
      471       :
      472       SYSTEM-DIALOG GET-FILE p-ReportFileName
      473         TITLE      "Укажите путь"
      474         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      475         ASK-OVERWRITE
      476         CREATE-TEST-FILE
      477         SAVE-AS
      478         USE-FILENAME
      479         DEFAULT-EXTENSION "txt"
      480         UPDATE glog
      481         .
      482       if not glog then  return.
      483       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      484       if p-is-stream then
      485       do:
      486         if p-is-append then
      487         do:
      488           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      489         end.
      490         else
      491         do:
      492           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      493         end.
      494       end.
      495       else
      496       do:
      497         if p-is-append then
      498         do:
      499           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      500         end.
      501         else
      502         do:
      503           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      504         end.
      505       end.
      506       p-process = yes.
      507     end.
      508   end procedure.
      509   procedure prn-lib-get-report-name :
      510     define input parameter parParentProc  as widget-handle no-undo.
      511     define output parameter p-report-name as character no-undo .
      512     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      513   end procedure.
      514   procedure prn-lib-reportviewer-report-name :
      515     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      516     define input parameter p-report-name-html as character no-undo .
      517     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      518   end procedure.
      519   procedure prn-lib-reportviewer :
      520     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      521     define input parameter p-report-name-html as character no-undo .
      522     define input parameter p-param        as character no-undo .
      523     define variable v-excel           as character no-undo init 'TRUE' .
      524     define variable v-value-character as character no-undo .
      525     define variable v-value-integer   as character no-undo .
      526     define variable v-value-date      as date      no-undo .
      527     define variable v-value-decimal   as decimal   no-undo .
      528     define variable rep-excel         as logical   no-undo .
      529     define variable excel-string      as character no-undo .
      530     define variable v-param-type      as character no-undo .
      531     define variable v-tth             as handle    no-undo .
      532     run adm/shattri.p (
      533       input "get":U
      534       ,input  ""
      535       ,input  0
      536       ,input  'report-glob':U
      537       ,input  'rep-excel':U
      538       ,output v-value-character
      539       ,output v-value-date
      540       ,output v-value-decimal
      541       ,output v-value-integer
      542       ,output rep-excel
      543       ,output v-param-type
      544       ,INPUT-OUTPUT table-handle v-tth
      545       )  .
      546     if rep-excel then v-excel = "TRUE" .
      547     else v-excel = "FALSE" .
      548     if p-param eq ""
      549     then
      550        p-param = "EXCEL:" + v-excel.
      551     else
      552        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      553     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      554   end procedure.
      555   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      556   procedure cur-time :
      557      define output parameter p-today as date      no-undo .
      558      define output parameter p-time  as integer   no-undo .
      559     do
      560     on error undo, return error
      561     :
      562       define variable v-date1 as date      no-undo .
      563       define variable v-date2 as date      no-undo .
      564       define variable v-time  as integer   no-undo .
      565       assign
      566         v-date1 = today
      567         v-time  = time
      568         v-date2 = today
      569       .
      570       if v-date1 <> v-date2
      571       then do:
      572         assign
      573           v-date1 = today
      574           v-time  = v-time
      575         .
      576       end.
      577       assign
      578         p-today = v-date1
      579         p-time  = v-time
      580       .
      581     end.
      582   end.
      583   function cur-time-date returns character
      584   :
      585     return string(today, '99/99/9999':U) .
      586   end.
      587   function cur-time-mjd returns decimal
      588   :
      589     define variable v-date as date      no-undo .
      590     define variable v-time as integer   no-undo .
      591     run cur-time in this-procedure
      592       (output v-date
      593       ,output v-time
      594       ) .
      595     return integer(v-date) - 2400002 + (v-time / 86400) .
      596   end.
      597   function cur-time-get-ending-index returns integer
      598   (input p-number as integer
      599   )
      600   :
      601     if p-number < 0
      602     or p-number = ?
      603     then do:
      604       return 1 .
      605     end.
      606     define variable v-rest as integer   no-undo .
      607     assign
      608       p-number = p-number modulo 100
      609     .
      610     if p-number < 20
      611     then do:
      612       assign
      613         v-rest = p-number
      614       .
      615     end.
      616     else do:
      617       assign
      618         v-rest = p-number modulo 10
      619       .
      620     end.
      621     case v-rest :
      622       when 1
      623       then do:
      624         return 2 .
      625       end.
      626       when 2 or
      627       when 3 or
      628       when 4
      629       then do:
      630         return 3 .
      631       end.
      632       otherwise do:
      633         return 1 .
      634       end.
      635     end case .
      636   end.
      637   procedure cur-time-mjd-to-date :
      638      define input  parameter i-mjd-diff as decimal no-undo.
      639      define output parameter o-Date     as date    no-undo.
      640      define output parameter o-Time     as integer no-undo.
      641      define variable v-day-number as integer   no-undo .
      642      if    i-mjd-diff < 0
      643         or i-mjd-diff = ?
      644      then do:
      645         return "?" .
      646      end.
      647      assign
      648         v-day-number = truncate(i-mjd-diff,0).
      649         o-Date = date(v-day-number + 2400002).
      650         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      651     .
      652   end.
      653   function cur-time-mjd-to-string returns character
      654   (input p-mjd-diff as decimal
      655   )
      656   :
      657     define variable v-day-number as integer   no-undo .
      658     define variable v-seconds    as integer   no-undo .
      659     define variable v-hour       as integer   no-undo .
      660     define variable v-min        as integer   no-undo .
      661     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      662     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      663     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      664     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      665     if p-mjd-diff < 0
      666     or p-mjd-diff = ?
      667     then do:
      668       return "?" .
      669     end.
      670     assign
      671       v-day-number = integer(truncate(p-mjd-diff,0))
      672       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      673     .
      674     if v-seconds > 86400
      675     then do:
      676       assign
      677         v-seconds = 86400 - 1
      678       .
      679     end.
      680     if v-seconds < 0
      681     then do:
      682       assign
      683         v-seconds = 0
      684       .
      685     end.
      686     assign
      687       v-hour = truncate(v-seconds / 3600, 0)
      688     .
      689     assign
      690       v-seconds = v-seconds modulo 3600
      691     .
      692     assign
      693       v-min = truncate(v-seconds / 60, 0)
      694     .
      695     assign
      696       v-seconds = v-seconds modulo 60
      697     .
      698     return
      699         (if v-day-number <> 0
      700           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      701           else ""
      702         )
      703       + (if v-day-number <> 0 or v-hour <> 0
      704           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      705           else ""
      706         )
      707       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      708           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      709           else ""
      710         )
      711       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      712       .
      713   end.
      714   function cur-time-string returns character
      715   :
      716     define variable v-date as date      no-undo .
      717     define variable v-time as integer   no-undo .
      718     run cur-time in this-procedure
      719       (output v-date
      720       ,output v-time
      721       ) .
      722     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      723   end.
      724   function cur-time-string-sec returns character
      725   :
      726     define variable v-date as date      no-undo .
      727     define variable v-time as integer   no-undo .
      728     run cur-time in this-procedure
      729       (output v-date
      730       ,output v-time
      731       ) .
      732     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      733   end.
      734   function cur-time-custom  returns character
      735   (input p-prefix as character
      736   ,input p-date-format as character
      737   ,input p-delimiter as character
      738   ,input p-time-format as character
      739   ,input p-suffix as character
      740   )
      741   :
      742     define variable v-date as date      no-undo .
      743     define variable v-time as integer   no-undo .
      744     run cur-time in this-procedure
      745       (output v-date
      746       ,output v-time
      747       ) .
      748     return
      749       p-prefix
      750       + string(v-date, p-date-format)
      751       + p-delimiter
      752       + string(v-time, p-time-format)
      753       + p-suffix
      754       .
      755   end.
      756   function cur-time-print  returns character
      757   :
      758     define variable v-date as date      no-undo .
      759     define variable v-time as integer   no-undo .
      760     run cur-time in this-procedure
      761       (output v-date
      762       ,output v-time
      763       ) .
      764     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      765   end.
      766   function cur-time-datetime returns datetime
      767   :
      768     define variable v-char as character no-undo .
      769     define variable v-datetime as datetime no-undo .
      770     v-char = cur-time-string().
      771     v-datetime = datetime(v-char).
      772     return  v-datetime.
      773   end.
      774   function cur-time-string-msec returns character
      775   :
      776     define variable v-date as datetime  no-undo .
      777     v-date = now.
      778     return string(v-date) .
      779   end.
      780   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      781   FUNCTION mark-string RETURNS CHARACTER
      782     ( input p-recid as recid, input mark-list as character  ) :
      783     RETURN ( IF LOOKUP( STRING( p-recid), mark-list ) > 0 THEN '*' ELSE '':U ).
      784   END FUNCTION.
      785   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      786   function usrfulnf returns character ( input p-user-id as character):
      787   define variable v-user-name as character no-undo .
      788   define variable vss-include-info7 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      789   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run usrfulnm in g#library
      790     (input  p-user-id
      791     ,output v-user-name
      792     ) no-error .
      793   if error-status:error
      794   or v-user-name = ""
      795   then do:
      796     return p-user-id.
      797   end.
      798   else do:
      799     return v-user-name.
      800   end.
      801   end function.
      802   define variable v-rid-list as character no-undo .
      803   DEFINE VARIABLE v-doc-rec AS RECID NO-UNDO.
      804   define variable sort-column-name as character no-undo .
      805   define variable v-db-num LIKE ub.db.db-num no-undo.
      806   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      807   define   temp-table temp-changes no-undo
      808   field f_name as character
      809   field l_name as character
      810   field v_old as character
      811   field v_new as character
      812   field t_name as character
      813   field num_ as integer
      814   field uniq-key-rec as character
      815   field action as integer
      816   field fNotChange as logical
      817   index pi is unique primary
      818   num_
      819   t_name
      820   f_name
      821   index
      822   Chan
      823   fnotChange
      824   t_name
      825   f_name
      826   index imain uniq-key-rec
      827   .
      828   FUNCTION get-all-fields returns character (p-file-name as character ):
      829   define variable v-dop as character no-undo .
      830     find first _file no-lock where _file._file-name = p-file-name no-error .
      831     if not available _file then return "":U.
      832     for each _field no-lock where
      833              _field._file-recid = recid(_file) :
      834       assign
      835       v-dop = v-dop + _field._field-name + chr(44)
      836       .
      837     end.
      838     return trim(v-dop).
      839   END FUNCTION.
      840   PROCEDURE proc-full-temp-changes :
      841     define input  parameter p-act-create as logical   no-undo .
      842     define input  parameter p-act-delete as logical   no-undo .
      843     define input  parameter p-hst-handle as handle    no-undo .
      844     define input  parameter p-main-table as character no-undo .
      845     define input  parameter p-field-list as character no-undo .
      846     define input  parameter p-label-form as character no-undo .
      847     define variable h-new-buf         as handle    no-undo .
      848     define variable h-main-buf        as handle    no-undo .
      849     define variable h-for-comp        as handle    no-undo .
      850     define variable v-inform          as character no-undo .
      851     define variable v-ind             as integer   no-undo .
      852     define variable v-idx-field-qnty  as integer   no-undo .
      853     define variable v-num-entries     as integer   no-undo .
      854     define variable fh                as handle    no-undo .
      855     define variable fh-main           as handle    no-undo .
      856     define variable fh-old            as handle    no-undo .
      857     define variable fh-new            as handle    no-undo .
      858     define variable v-field-name      as character no-undo .
      859     define variable v-field-lvl       as character no-undo .
      860     define variable v-field-form      as character no-undo .
      861     define variable v-search-exp      as character no-undo .
      862     define variable v-srch-main       as character no-undo .
      863     define variable v-word-link       as character no-undo .
      864     define variable v-av-chip-num     as logical   no-undo .
      865     define variable v-main-pi-fld-lst as character no-undo .
      866     define variable v-main-fld-lst    as character no-undo .
      867     define variable v-delim-list      as character no-undo .
      868     define variable v-label           as character no-undo .
      869     define variable v-old-value       as character no-undo case-sensitive.
      870     define variable v-new-value       as character no-undo case-sensitive.
      871     define variable v-chg-fields as character no-undo.
      872     for each temp-changes:
      873       delete temp-changes.
      874     end.
      875     if not p-hst-handle:available then do:
      876       return .
      877     end.
      878     create buffer h-new-buf  for table p-hst-handle .
      879     create buffer h-main-buf for table p-main-table .
      880     assign
      881       v-inform = h-main-buf:index-information(1)
      882       v-ind    = 2
      883     .
      884     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      885     on error undo, return error
      886     :
      887       assign
      888         v-inform = h-main-buf:index-information( v-ind )
      889         v-ind    = v-ind + 1
      890       .
      891     end.
      892     if v-inform = ?
      893       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      894       or entry( 3, v-inform, ",":U ) <> "1":U
      895     then do:
      896       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, h-main-buf:name ).
      897     end.
      898     assign
      899       v-idx-field-qnty = num-entries( v-inform ) - 4
      900     .
      901     if v-idx-field-qnty < 2 then do:
      902       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, h-main-buf:name ).
      903     end.
      904     assign
      905       v-srch-main   = "where":U
      906       v-word-link   = "":U
      907       v-av-chip-num = false
      908       v-delim-list  = "":U
      909     .
      910     do v-ind = 1 to v-idx-field-qnty by 2
      911     on error undo, return error
      912     :
      913       assign
      914         v-field-name      = entry( 4 + v-ind, v-inform, ",":U )
      915         fh                = p-hst-handle:buffer-field( v-field-name )
      916         fh-main           = h-main-buf:buffer-field( v-field-name )
      917         v-srch-main       = substitute( "&1 &2 &3.&4 =", v-srch-main, v-word-link, fh-main:table, v-field-name )
      918         v-main-pi-fld-lst = v-main-pi-fld-lst + v-delim-list + v-field-name
      919       .
      920       if fh:data-type ="character":U then do:
      921         assign
      922           v-srch-main = substitute( '&1 "&2"', v-srch-main, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
      923         .
      924       end.
      925       else do:
      926         assign
      927           v-srch-main = substitute( "&1 &2", v-srch-main, fh:buffer-value() )
      928         .
      929       end.
      930       if v-delim-list = "":U then do:
      931         assign
      932           v-delim-list = ",":U
      933         .
      934       end.
      935       if v-word-link = "":U then do:
      936         assign
      937           v-word-link = "and":U
      938         .
      939       end.
      940     end.
      941     assign
      942       v-delim-list  = "":U
      943     .
      944     do v-ind = 1 to h-main-buf:num-fields
      945     on error undo, return error
      946     :
      947       assign
      948         fh-main      = h-main-buf:buffer-field( v-ind )
      949         v-field-name = fh-main:name
      950       .
      951         assign
      952           v-main-fld-lst = v-main-fld-lst + v-delim-list + v-field-name
      953         .
      954         if v-delim-list = "":U then do:
      955           assign
      956             v-delim-list = ",":U
      957           .
      958         end.
      959     end.
      960     assign
      961       v-inform = p-hst-handle:index-information(1)
      962       v-ind    = 2
      963     .
      964     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      965     on error undo, return error
      966     :
      967       assign
      968         v-inform = p-hst-handle:index-information( v-ind )
      969         v-ind    = v-ind + 1
      970       .
      971     end.
      972     if v-inform = ?
      973       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      974       or entry( 3, v-inform, ",":U ) <> "1":U
      975     then do:
      976       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, p-hst-handle:name ).
      977     end.
      978     assign
      979       v-idx-field-qnty = num-entries( v-inform ) - 4
      980     .
      981     if v-idx-field-qnty < 2 then do:
      982       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, p-hst-handle:name ).
      983     end.
      984     assign
      985       v-search-exp  = "where":U
      986       v-word-link   = "":U
      987       v-av-chip-num = false
      988     .
      989     do v-ind = 1 to v-idx-field-qnty by 2
      990     on error undo, return error
      991     :
      992       assign
      993         v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      994         fh           = p-hst-handle:buffer-field( v-field-name )
      995         v-search-exp = substitute( "&1 &2 &3.&4", v-search-exp, v-word-link, fh:table, v-field-name )
      996       .
      997       if v-field-name = "chip-num":U then do:
      998         assign
      999           v-search-exp  = substitute( "&1 >", v-search-exp )
     1000           v-av-chip-num = true
     1001         .
     1002       end.
     1003       else do:
     1004         assign
     1005           v-search-exp = substitute( "&1 =", v-search-exp )
     1006         .
     1007       end.
     1008       if fh:data-type ="character":U then do:
     1009         assign
     1010           v-search-exp = substitute( '&1 "&2"', v-search-exp, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
     1011         .
     1012       end.
     1013       else do:
     1014         assign
     1015           v-search-exp = substitute( '&1 &2', v-search-exp, fh:buffer-value() )
     1016         .
     1017       end.
     1018       if v-word-link = "":U then do:
     1019         assign
     1020           v-word-link = "and":U
     1021         .
     1022       end.
     1023     end.
     1024     if v-av-chip-num = false then do:
     1025       message
     1026         vss-workfile vss-revision vss-description skip
     1027         substitute( "Таблица &2 не содержит поля chip-num.", vss-workfile, p-hst-handle:name ) skip
     1028         "Использование данной процедуры невозможно!" skip
     1029         view-as alert-box error .
     1030       return error .
     1031     end.
     1032     h-new-buf:find-first( v-search-exp, no-lock ) no-error .
     1033     if not h-new-buf:available then do:
     1034       h-main-buf:find-first( v-srch-main, no-lock ) no-error .
     1035       if not h-main-buf:available then do:
     1036         assign
     1037           h-for-comp = ?
     1038         .
     1039       end.
     1040       else do:
     1041         assign
     1042           h-for-comp = h-main-buf
     1043         .
     1044       end.
     1045     end.
     1046     else do:
     1047       assign
     1048         h-for-comp = h-new-buf
     1049       .
     1050     end.
     1051     assign
     1052       v-num-entries = num-entries( v-main-fld-lst, ",":U )
     1053     .
     1054     do v-ind = 1 to v-num-entries
     1055     on error undo, return error return-value
     1056     :
     1057       assign
     1058         v-field-name = entry( v-ind, v-main-fld-lst )
     1059         fh-old       = p-hst-handle:buffer-field( v-field-name )
     1060         v-old-value  = fh-old:buffer-value()
     1061         v-label      = trim( fh-old:label )
     1062       .
     1063       if ( trim( p-field-list ) <> "":U
     1064            and lookup( v-field-name, p-field-list ) > 0
     1065          )
     1066          or trim( p-field-list ) = "":U
     1067       then do:
     1068         if h-for-comp <> ? then do:
     1069           assign
     1070             fh-new      = h-for-comp:buffer-field( v-field-name )
     1071             v-new-value = fh-new:buffer-value()
     1072           .
     1073         end.
     1074         else do:
     1075           assign
     1076             v-new-value = "":U
     1077           .
     1078         end.
     1079           if p-act-create = true then do:
     1080             assign
     1081               v-old-value = "":U
     1082             .
     1083           end.
     1084           if p-act-delete = true then do:
     1085             assign
     1086               v-new-value = "":U
     1087             .
     1088           end.
     1089         if v-old-value <> v-new-value
     1090         then do:
     1091           create temp-changes.
     1092           assign
     1093             temp-changes.t_name = p-main-table
     1094             temp-changes.f_name = v-field-name
     1095             temp-changes.l_name = replace( v-label, "&":U, "":U )
     1096             temp-changes.v_old  = trim( v-old-value )
     1097             temp-changes.v_new  = trim( v-new-value )
     1098             temp-changes.num_   = 0
     1099             temp-changes.fNotChange = v-old-value eq v-new-value
     1100           .
     1101         end.
     1102       end.
     1103     end.
     1104     assign
     1105       v-num-entries = num-entries( p-label-form, chr(8) )
     1106     .
     1107     do v-ind = 1 to v-num-entries
     1108     on error undo, return error return-value
     1109     :
     1110       if num-entries( entry( v-ind, p-label-form, chr(8) ), chr(4) ) = 3 then do:
     1111         assign
     1112           v-field-name = entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1113           v-field-lvl  = entry( 2, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1114           v-field-form = entry( 3, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1115         .
     1116         find first temp-changes
     1117           where temp-changes.f_name = v-field-name
     1118           no-error .
     1119         if available temp-changes then do:
     1120           if trim( v-field-lvl ) <> "":U then do:
     1121             assign
     1122               temp-changes.l_name = v-field-lvl
     1123             .
     1124           end.
     1125           if trim( v-field-form ) <> "":U then do:
     1126             assign
     1127               temp-changes.v_old = dynamic-function( v-field-form, temp-changes.v_old )
     1128             .
     1129             if h-for-comp <> ? then do:
     1130               assign
     1131                 temp-changes.v_new = dynamic-function( v-field-form, temp-changes.v_new )
     1132               .
     1133             end.
     1134           end.
     1135         end.
     1136       end.
     1137       else do:
     1138         message
     1139           vss-workfile vss-revision vss-description skip
     1140           "Ошибка! Список должен содержать три поля с разделителем delim-par!" skip
     1141           substitute( "список для поля '&1': '&2'"
     1142                       ,entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1143                       ,entry( v-ind, p-label-form, chr(8) )
     1144                     ) skip
     1145           substitute( "полный список: &2", p-label-form ) skip
     1146           view-as alert-box error .
     1147       end.
     1148     end.
     1149     delete object h-new-buf .
     1150     delete object h-main-buf .
     1151   END PROCEDURE.
     1152   FUNCTION get-action RETURNS CHARACTER
     1153     ( p-action as integer )  FORWARD.
     1154   DEFINE BUTTON B-Help
     1155        LABEL "Помо&щь"
     1156        SIZE 3 BY 1
     1157        BGCOLOR 8 .
     1158   DEFINE BUTTON B-lookup
     1159        LABEL "&Просмотр"
     1160        SIZE 10 BY 1.
     1161   DEFINE BUTTON B-mark
     1162        LABEL "&*"
     1163        SIZE 3 BY 1.
     1164   DEFINE BUTTON b-quit AUTO-END-KEY
     1165        LABEL "&Выход"
     1166        SIZE 10 BY 1
     1167        BGCOLOR 8 .
     1168   DEFINE BUTTON B-sel AUTO-GO
     1169        LABEL "Вы&бор"
     1170        SIZE 10 BY 1.
     1171   DEFINE VARIABLE mark-num AS CHARACTER FORMAT "X(256)":U
     1172         VIEW-AS TEXT
     1173        SIZE 6 BY 1
     1174        FGCOLOR 4  NO-UNDO.
     1175   DEFINE QUERY BR-changes FOR
     1176         temp-changes SCROLLING.
     1177   DEFINE QUERY br-cpay-type FOR
     1178         X_c-pay-type SCROLLING.
     1179   DEFINE BROWSE BR-changes
     1180     QUERY BR-changes DISPLAY
     1181         temp-changes.l_name COLUMn-LABEL "Изменилось" format "X(40)"
     1182   temp-changes.v_old COLUMn-LABEL "Было" format "X(70)"
     1183   temp-changes.v_new COLUMn-LABEL "Стало" format "X(70)"
     1184       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 9.04.
     1185   DEFINE BROWSE br-cpay-type
     1186     QUERY br-cpay-type NO-LOCK DISPLAY
     1187         mark-string(recid(X_c-pay-type), v-rid-list) COLUMN-LABEL "*" FORMAT "X(1)":U
     1188         get-action(X_c-pay-type.action) COLUMN-LABEL "Действие" FORMAT "X(10)":U
     1189         usrfulnf(X_c-pay-type.corr-user-name) COLUMN-LABEL "Изменил" FORMAT "X(18)":U
     1190         X_c-pay-type.corr-date COLUMN-LABEL "Дата!измен" FORMAT "99/99/9999":U
     1191         X_c-pay-type.obj-name FORMAT "X(40)":U
     1192         X_c-pay-type.obj-code COLUMN-LABEL "Код вида!оплаты" FORMAT "99999":U
     1193         string(X_c-pay-type.corr-time, "HH:MM") COLUMN-LABEL "Время!измен" FORMAT "X(5)":U
     1194       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 9.25 FIT-LAST-COLUMN.
     1195   DEFINE FRAME Dialog-Frame
     1196        b-quit AT ROW 1 COL 1
     1197        B-mark AT ROW 1 COL 11
     1198        B-sel AT ROW 1 COL 21
     1199        B-lookup AT ROW 1 COL 61
     1200        B-Help AT ROW 1 COL 95
     1201        br-cpay-type AT ROW 3 COL 1
     1202        BR-changes AT ROW 13 COL 1
     1203        mark-num AT ROW 1 COL 12.5 COLON-ALIGNED NO-LABEL
     1204        SPACE(78.62) SKIP(20.04)
     1205       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1206            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1207            TITLE "История видов оплат"
     1208            CANCEL-BUTTON b-quit.
     1209   ASSIGN
     1210          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1211          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1212   ASSIGN
     1213          B-lookup:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     1214   ON GO OF FRAME Dialog-Frame
     1215   DO:
     1216     p-rid-list = v-rid-list.
     1217   END.
     1218   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1219   DO:
     1220     APPLY "END-ERROR":U TO SELF.
     1221   END.
     1222   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
     1223   DO:
     1224     define variable loc#log as logical no-undo .
     1225     if available X_c-pay-type then do:
     1226   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1227   define variable v-str-recid10 as character no-undo .
     1228   define variable v-num-entry10 as integer   no-undo .
     1229   assign
     1230     v-str-recid10 = trim( string( recid( X_c-pay-type ) , "->>>>>>>>>>>9":U ) )
     1231     v-num-entry10 = lookup( v-str-recid10 , v-rid-list )
     1232   .
     1233   if v-num-entry10 > 0 then do:
     1234     assign
     1235       entry( v-num-entry10, v-rid-list ) = "":U
     1236       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1237     .
     1238   end.
     1239   else do:
     1240     assign
     1241       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid10
     1242     .
     1243   end.
     1244       loc#log = br-cpay-type:refresh() .
     1245       if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
     1246           loc#log = br-cpay-type:select-next-row ().
     1247           apply "VALUE-CHANGED" to br-cpay-type in frame Dialog-Frame.
     1248       end.
     1249       if num-entries( v-rid-list ) = 0
     1250       then
     1251           hide mark-num in frame Dialog-Frame.
     1252       else
     1253           disp num-entries( v-rid-list ) @ mark-num with frame Dialog-Frame.
     1254     end.
     1255     apply "entry" to br-cpay-type in frame Dialog-Frame.
     1256   END.
     1257   ON CHOOSE OF B-sel IN FRAME Dialog-Frame
     1258   DO:
     1259       if ( available X_c-pay-type ) then do:
     1260       if  ( v-rid-list = "" ) or b-mark:sensitive = no
     1261       then
     1262       v-rid-list = string( recid( X_c-pay-type ) ) .
     1263     end.
     1264   END.
     1265   ON RETURN OF br-cpay-type IN FRAME Dialog-Frame
     1266   or MOUSE-SELECT-DBLCLICK OF br-cpay-type IN FRAME Dialog-Frame
     1267       DO:
     1268       run proc-br-cpay-type no-error.
     1269     if error-status:error then return no-apply.
     1270   END.
     1271   ON VALUE-CHANGED OF br-cpay-type IN FRAME Dialog-Frame
     1272   DO:
     1273     run proc-view-changes in this-procedure no-error.
     1274   END.
     1275   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1276   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1277   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1278   on help of frame Dialog-Frame
     1279   do:
     1280     run gbl/app_help.p
     1281       (input this-procedure :file-name
     1282       ,input ''
     1283       ,input ?
     1284       ) no-error.
     1285     if error-status :error then do:
     1286       message
     1287         "Ошибка при вызове помощи"
     1288         error-status :get-message(1)
     1289         view-as alert-box .
     1290     end.
     1291   end.
     1292   run minbtn-set in this-procedure .
     1293   on choose of b-help in frame Dialog-Frame
     1294   do:
     1295     apply "help":u to frame Dialog-Frame .
     1296   end.
     1297   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1298   procedure minbtn-set :
     1299       do
     1300           on error undo, return error return-value
     1301           :
     1302           define variable ii              as integer       no-undo .
     1303           define variable fh              as widget-handle no-undo .
     1304           define variable hh              as widget-handle no-undo .
     1305           define variable v-h             as handle        extent 4 no-undo .
     1306           define variable v-name-button   as character     no-undo .
     1307           define variable v-help-old-x    as decimal       no-undo .
     1308           define variable v-help-old-y    as decimal       no-undo .
     1309           define variable v-help-old-size as decimal       no-undo .
     1310           define variable v-frame-width   as decimal       no-undo .
     1311           define variable jj              as integer       no-undo .
     1312           do
     1313               on error undo, return error
     1314               :
     1315               assign
     1316                   v-frame-width = frame Dialog-Frame:width - 0.3
     1317                   fh            = frame Dialog-Frame:first-child
     1318                   hh            = fh:first-child
     1319                   ii            = 1
     1320                   .
     1321               do while valid-handle(hh):
     1322                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1323                   do:
     1324                       case lc(hh:name) :
     1325                           when "b-help" then
     1326                               do:
     1327                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1328                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1329                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1330                                   hh:TOOLTIP = "Помощь" .
     1331                                   v-help-old-x = hh:column .
     1332                                   v-help-old-y = hh:row    .
     1333                                   v-help-old-size = hh:width .
     1334                                   hh:width-chars = 2.5 .
     1335                               end.
     1336                           when "b-print" then
     1337                               do:
     1338                                   hh:load-image("cmp/b-print.bmp":u) .
     1339                                   hh:TOOLTIP = "Печать" .
     1340                                   v-h[ii] = hh:handle .
     1341                                   ii = ii + 1 .
     1342                                   hh:width-chars = 3 .
     1343                               end.
     1344                           when "b-history" or
     1345                           when "b-hist" then
     1346                               do:
     1347                                   hh:load-image("cmp/b-hist.bmp":u) .
     1348                                   hh:TOOLTIP = "История" .
     1349                                   v-h[ii] = hh:handle .
     1350                                   ii = ii + 1 .
     1351                                   hh:width-chars = 3 .
     1352                               end.
     1353                           when "b-sch" then
     1354                               do:
     1355                                   hh:load-image("cmp/b-sch.bmp":u) .
     1356                                   hh:TOOLTIP = "Установка Фильтра" .
     1357                                   v-h[ii] = hh:handle .
     1358                                   ii = ii + 1 .
     1359                                   hh:width-chars = 3 .
     1360                               end.
     1361                           when "b-hist-user" then
     1362                               do:
     1363                                   hh:load-image("cmp/b-hist.bmp":u) .
     1364                                   hh:TOOLTIP = "История пользователя" .
     1365                                   ii = ii + 1 .
     1366                               end.
     1367                       end case.
     1368                   end.
     1369                   hh = hh:next-sibling.
     1370               end.
     1371               b-help:column = v-frame-width - b-help:width-chars.
     1372               jj = 0.
     1373               repeat ii = 4 to 1 by -1 :
     1374                   if valid-handle (v-h[ii] ) then
     1375                   do:
     1376                       jj  = jj + 1 .
     1377                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1378                       v-h[ii]:row    = v-help-old-y .
     1379                   end.
     1380               end.
     1381           end.
     1382       end.
     1383   end procedure.
     1384   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1385   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1386   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1387   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1388   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1389   define variable v-diasize-current-frame-height as decimal   no-undo .
     1390   define variable v-diasize-change-size          as logical   no-undo .
     1391   define variable v-diasize-resize-button        as handle    no-undo .
     1392   define variable v-diasize-wndmax               as logical   no-undo .
     1393   define variable v-diasize-wndstore             as logical   no-undo .
     1394   define variable v-diasize-proc-name            as character no-undo .
     1395   define variable v-diasize-browse-handle        as handle    no-undo .
     1396   define variable v-diasize-browse-number        as integer   no-undo .
     1397   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1398   define temp-table temp-diasize-handle no-undo
     1399     field handle-value  as handle
     1400     field save-position as decimal
     1401     index xpk is primary unique handle-value
     1402     .
     1403   define temp-table temp-browse-handle no-undo
     1404     field browse-type   as character
     1405     field browse-number as integer
     1406     field browse-handle as handle
     1407     field original-size as decimal
     1408     index xpk is primary unique browse-type browse-number
     1409     index xie browse-type browse-handle
     1410   .
     1411   procedure diasize_change-height :
     1412     define input  parameter p-change-value  as decimal   no-undo .
     1413     define input  parameter p-move-resize   as logical   no-undo .
     1414     define variable v-field-group-handle    as handle    no-undo .
     1415     define variable v-object-handle         as handle    no-undo .
     1416     define variable v-frame-height          as decimal   no-undo .
     1417     define variable v-frame-virtual-height  as decimal   no-undo .
     1418     define variable v-browse-height         as decimal   no-undo .
     1419     define variable v-window-height         as decimal   no-undo .
     1420     define variable v-window-virtual-height as decimal   no-undo .
     1421     define variable v-change-sign           as integer   no-undo .
     1422     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1423     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1424     if p-change-value > 0
     1425     then do:
     1426       if frame Dialog-Frame :height + p-change-value
     1427           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1428       then do:
     1429         assign
     1430           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1431                           - (frame Dialog-Frame :height-chars)
     1432         .
     1433         if p-change-value <= 0
     1434         then do:
     1435           run diasize_position-resize-button in this-procedure .
     1436           return .
     1437         end.
     1438       end.
     1439     end.
     1440     if p-change-value < 0
     1441     then do:
     1442       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1443       then do:
     1444         assign
     1445           p-change-value = v-diasize-orig-frame-height
     1446                          - (frame Dialog-Frame :height-chars)
     1447         .
     1448         if p-change-value >= 0
     1449         then do:
     1450           run diasize_position-resize-button in this-procedure .
     1451           return .
     1452         end.
     1453       end.
     1454     end.
     1455     if p-change-value >= 0
     1456     then do:
     1457       assign
     1458         v-change-sign = 1
     1459       .
     1460     end.
     1461     else do:
     1462       assign
     1463         v-change-sign = -1
     1464       .
     1465     end.
     1466     assign
     1467       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1468     .
     1469     if p-change-value = 0
     1470     then do:
     1471       run diasize_position-resize-button in this-procedure .
     1472       return .
     1473     end.
     1474     move_block:
     1475     do
     1476     on error undo move_block, retry move_block
     1477     :
     1478       if retry
     1479       then do:
     1480         do
     1481         on error undo move_block, leave move_block
     1482         :
     1483           if p-change-value > 0
     1484           then do:
     1485             for each buf_temp-diasize-handle
     1486             on error undo, next
     1487             :
     1488               assign
     1489                 v-object-handle = buf_temp-diasize-handle.handle-value
     1490               .
     1491               if v-object-handle <> v-diasize-resize-button
     1492               then do:
     1493                 assign
     1494                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1495                 .
     1496               end.
     1497             end.
     1498             assign
     1499               v-diasize-browse-handle :height = v-browse-height
     1500             .
     1501             for each buf_temp-browse-handle
     1502               where buf_temp-browse-handle.browse-type = 'height':u
     1503             on error undo, next
     1504             :
     1505               assign
     1506                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1507               .
     1508             end.
     1509             assign
     1510               frame Dialog-Frame :height = v-frame-height
     1511             .
     1512             if frame Dialog-Frame :scrollable = true
     1513             then do:
     1514               assign
     1515                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1516               .
     1517             end.
     1518             run diasize_position-resize-button in this-procedure .
     1519           end.
     1520           else do:
     1521             if frame Dialog-Frame :scrollable = true
     1522             then do:
     1523               assign
     1524                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1525               .
     1526             end.
     1527             assign
     1528               frame Dialog-Frame :height = v-frame-height
     1529             .
     1530             assign
     1531               v-diasize-browse-handle :height = v-browse-height
     1532             .
     1533             for each buf_temp-browse-handle
     1534               where buf_temp-browse-handle.browse-type = 'height':u
     1535             on error undo, next
     1536             :
     1537               assign
     1538                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1539               .
     1540             end.
     1541             for each buf_temp-diasize-handle
     1542             on error undo, next
     1543             :
     1544               assign
     1545                 v-object-handle = buf_temp-diasize-handle.handle-value
     1546               .
     1547               if v-object-handle <> v-diasize-resize-button
     1548               then do:
     1549                 assign
     1550                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1551                 .
     1552               end.
     1553             end.
     1554             run diasize_position-resize-button in this-procedure .
     1555           end.
     1556           assign
     1557             v-diasize-change-size = false
     1558           .
     1559           leave move_block .
     1560         end.
     1561       end.
     1562       assign
     1563         v-diasize-need-full-display = true
     1564       .
     1565       if v-diasize-change-size = false
     1566       then do:
     1567         assign
     1568           v-diasize-change-size = true
     1569         .
     1570       end.
     1571       else do:
     1572         return .
     1573       end.
     1574       assign
     1575         v-frame-height = frame Dialog-Frame :height
     1576         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1577         v-browse-height = v-diasize-browse-handle :height
     1578       .
     1579       for each buf_temp-browse-handle
     1580         where buf_temp-browse-handle.browse-type = 'height':u
     1581       :
     1582         assign
     1583           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1584         .
     1585       end.
     1586       for each buf_temp-diasize-handle
     1587       :
     1588         delete buf_temp-diasize-handle .
     1589       end.
     1590       assign
     1591         v-field-group-handle = frame Dialog-Frame :first-child
     1592       .
     1593       do while valid-handle(v-field-group-handle)
     1594       :
     1595         assign
     1596           v-object-handle = v-field-group-handle :first-child
     1597         .
     1598         do while valid-handle(v-object-handle)
     1599         :
     1600           if  v-object-handle <> v-diasize-browse-handle :handle
     1601           and can-query(v-object-handle, "row")
     1602           and can-query(v-object-handle, "height")
     1603           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1604           then do:
     1605             find first buf_temp-browse-handle
     1606               where buf_temp-browse-handle.browse-type   = 'height':u
     1607                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1608               no-error .
     1609             if available buf_temp-browse-handle
     1610             then do:
     1611             end.
     1612             else do:
     1613               create buf_temp-diasize-handle .
     1614               assign
     1615                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1616                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1617               .
     1618             end.
     1619           end.
     1620           assign
     1621             v-object-handle = v-object-handle :next-sibling
     1622           .
     1623         end.
     1624         assign
     1625           v-field-group-handle = v-field-group-handle :next-sibling
     1626         .
     1627       end.
     1628       do with frame Dialog-Frame
     1629       :
     1630         hide v-diasize-resize-button .
     1631         assign
     1632           v-diasize-resize-button :row    = 1
     1633           v-diasize-resize-button :column = 1
     1634         .
     1635       end.
     1636       if p-change-value > 0
     1637       then do:
     1638         if frame Dialog-Frame :scrollable = true
     1639         then do:
     1640           assign
     1641             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1642             no-error .
     1643           if error-status :error
     1644           or error-status :get-message(1) <> ""
     1645           then do:
     1646             undo move_block, retry move_block .
     1647           end.
     1648         end.
     1649         assign
     1650           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1651           no-error .
     1652         if error-status :error
     1653         or error-status :get-message(1) <> ""
     1654         then do:
     1655           undo move_block, retry move_block .
     1656         end.
     1657         assign
     1658           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1659           no-error .
     1660         if error-status :error
     1661         or error-status :get-message(1) <> ""
     1662         then do:
     1663           undo move_block, retry move_block .
     1664         end.
     1665         for each buf_temp-browse-handle
     1666           where buf_temp-browse-handle.browse-type = 'height':u
     1667         on error undo move_block, retry move_block
     1668         :
     1669           assign
     1670             buf_temp-browse-handle.browse-handle :height
     1671               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1672             no-error .
     1673           if error-status :error
     1674           or error-status :get-message(1) <> ""
     1675           then do:
     1676             undo move_block, retry move_block .
     1677           end.
     1678         end.
     1679         for each buf_temp-diasize-handle
     1680         on error undo move_block, retry move_block
     1681         :
     1682           assign
     1683             v-object-handle = buf_temp-diasize-handle.handle-value
     1684           .
     1685           if v-object-handle <> v-diasize-resize-button
     1686           then do:
     1687             assign
     1688               v-object-handle :row = v-object-handle :row + p-change-value
     1689               no-error .
     1690             if error-status :error
     1691             or error-status :get-message(1) <> ""
     1692             then do:
     1693               undo move_block, retry move_block .
     1694             end.
     1695           end.
     1696         end.
     1697       end.
     1698       else do:
     1699         for each buf_temp-diasize-handle
     1700         on error undo move_block, retry move_block
     1701         :
     1702           assign
     1703             v-object-handle = buf_temp-diasize-handle.handle-value
     1704           .
     1705           if v-object-handle <> v-diasize-resize-button
     1706           then do:
     1707             assign
     1708               v-object-handle :row = v-object-handle :row + p-change-value
     1709               no-error .
     1710             if error-status :error
     1711             or error-status :get-message(1) <> ""
     1712             then do:
     1713               undo move_block, retry move_block .
     1714             end.
     1715           end.
     1716         end.
     1717         assign
     1718           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1719           no-error .
     1720         if error-status :error
     1721         or error-status :get-message(1) <> ""
     1722         then do:
     1723           undo move_block, retry move_block .
     1724         end.
     1725         for each buf_temp-browse-handle
     1726           where buf_temp-browse-handle.browse-type = 'height':u
     1727         on error undo move_block, retry move_block
     1728         :
     1729           assign
     1730             buf_temp-browse-handle.browse-handle :height
     1731               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1732             no-error .
     1733           if error-status :error
     1734           or error-status :get-message(1) <> ""
     1735           then do:
     1736             undo move_block, retry move_block .
     1737           end.
     1738         end.
     1739         assign
     1740           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1741           no-error .
     1742         if error-status :error
     1743         or error-status :get-message(1) <> ""
     1744         then do:
     1745           undo move_block, retry move_block .
     1746         end.
     1747         if frame Dialog-Frame :scrollable = true
     1748         then do:
     1749           assign
     1750             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1751             no-error .
     1752           if error-status :error
     1753           or error-status :get-message(1) <> ""
     1754           then do:
     1755             undo move_block, retry move_block .
     1756           end.
     1757         end.
     1758       end.
     1759       if p-move-resize = true
     1760       then do:
     1761         run diasize_position-resize-button in this-procedure .
     1762       end.
     1763       if v-diasize-wndstore = true
     1764       then do:
     1765         if connected("ub") = true
     1766         then do:
     1767           define variable v-cntxt-db-num        as integer   no-undo .
     1768           define variable v-cntxt-userid        as character no-undo .
     1769           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1770                                             , OUTPUT v-cntxt-userid
     1771                                             ) .
     1772           run gbl/wndsizew.p
     1773             (input  v-cntxt-db-num
     1774             ,input  v-cntxt-userid
     1775             ,input  v-diasize-proc-name
     1776             ,input  'height':u
     1777             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1778             ) .
     1779         end.
     1780       end.
     1781     end.
     1782     assign
     1783       v-diasize-change-size = false
     1784     .
     1785   end procedure.
     1786   procedure diasize_set-height :
     1787     define input  parameter p-new-height  as decimal   no-undo .
     1788     define input  parameter p-move-resize as logical   no-undo .
     1789     do
     1790     on error undo, return error return-value
     1791     :
     1792       run diasize_change-height in this-procedure
     1793         (input  (p-new-height - frame Dialog-Frame :height)
     1794         ,input  p-move-resize
     1795         ) .
     1796     end.
     1797   end procedure.
     1798   procedure diasize_change-width :
     1799     define input  parameter p-change-value as decimal   no-undo .
     1800     define input  parameter p-move-resize  as logical   no-undo .
     1801     define variable v-field-group-handle   as handle    no-undo .
     1802     define variable v-object-handle        as handle    no-undo .
     1803     define variable v-frame-width          as decimal   no-undo .
     1804     define variable v-frame-virtual-width  as decimal   no-undo .
     1805     define variable v-browse-width         as decimal   no-undo .
     1806     define variable v-window-width         as decimal   no-undo .
     1807     define variable v-window-virtual-width as decimal   no-undo .
     1808     define variable v-change-sign          as integer   no-undo .
     1809     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1810     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1811     if p-change-value > 0
     1812     then do:
     1813       if frame Dialog-Frame :width + p-change-value >
     1814           session :width-chars
     1815       then do:
     1816         assign
     1817           p-change-value = session :width-chars - frame Dialog-Frame :width
     1818         .
     1819         if p-change-value <= 0
     1820         then do:
     1821           run diasize_position-resize-button in this-procedure .
     1822           return .
     1823         end.
     1824       end.
     1825     end.
     1826     if p-change-value < 0
     1827     then do:
     1828       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1829       then do:
     1830         assign
     1831           p-change-value = v-diasize-orig-frame-width
     1832                          - frame Dialog-Frame :width
     1833         .
     1834         if p-change-value >= 0
     1835         then do:
     1836           run diasize_position-resize-button in this-procedure .
     1837           return .
     1838         end.
     1839       end.
     1840     end.
     1841     if p-change-value >= 0
     1842     then do:
     1843       assign
     1844         v-change-sign = 1
     1845       .
     1846     end.
     1847     else do:
     1848       assign
     1849         v-change-sign = -1
     1850       .
     1851     end.
     1852     assign
     1853       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1854     .
     1855     if p-change-value = 0
     1856     then do:
     1857       run diasize_position-resize-button in this-procedure .
     1858       return .
     1859     end.
     1860     move_block:
     1861     do
     1862     on error undo move_block, leave move_block
     1863     :
     1864       if retry
     1865       then do:
     1866         do
     1867         on error undo move_block, leave move_block
     1868         :
     1869           if p-change-value > 0
     1870           then do:
     1871             for each buf_temp-diasize-handle
     1872             on error undo, next
     1873             :
     1874               assign
     1875                 v-object-handle = buf_temp-diasize-handle.handle-value
     1876               .
     1877               if v-object-handle <> v-diasize-resize-button
     1878               then do:
     1879                 assign
     1880                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1881                 .
     1882               end.
     1883             end.
     1884             assign
     1885               v-diasize-browse-handle :width = v-browse-width
     1886             .
     1887             for each buf_temp-browse-handle
     1888               where buf_temp-browse-handle.browse-type = 'width':u
     1889             on error undo, next
     1890             :
     1891               assign
     1892                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1893               .
     1894             end.
     1895             assign
     1896               frame Dialog-Frame :width = v-frame-width
     1897             .
     1898             if frame Dialog-Frame :scrollable = true
     1899             then do:
     1900               assign
     1901                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1902               .
     1903             end.
     1904             run diasize_position-resize-button in this-procedure .
     1905           end.
     1906           else do:
     1907             if frame Dialog-Frame :scrollable = true
     1908             then do:
     1909               assign
     1910                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1911               .
     1912             end.
     1913             assign
     1914               frame Dialog-Frame :width = v-frame-width
     1915             .
     1916             for each buf_temp-browse-handle
     1917               where buf_temp-browse-handle.browse-type = 'width':u
     1918             on error undo, next
     1919             :
     1920               assign
     1921                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1922               .
     1923             end.
     1924             assign
     1925               v-diasize-browse-handle :width = v-browse-width
     1926             .
     1927             for each buf_temp-diasize-handle
     1928             on error undo, next
     1929             :
     1930               assign
     1931                 v-object-handle = buf_temp-diasize-handle.handle-value
     1932               .
     1933               if v-object-handle <> v-diasize-resize-button
     1934               then do:
     1935                 assign
     1936                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1937                 .
     1938               end.
     1939             end.
     1940             run diasize_position-resize-button in this-procedure .
     1941           end.
     1942           assign
     1943             v-diasize-change-size = false
     1944           .
     1945           leave move_block .
     1946         end.
     1947       end.
     1948       assign
     1949         v-diasize-need-full-display = true
     1950       .
     1951       if v-diasize-change-size = false
     1952       then do:
     1953         assign
     1954           v-diasize-change-size = true
     1955         .
     1956       end.
     1957       else do:
     1958         return .
     1959       end.
     1960       assign
     1961         v-frame-width = frame Dialog-Frame :width
     1962         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1963         v-browse-width = v-diasize-browse-handle :width
     1964       .
     1965       for each buf_temp-browse-handle
     1966         where buf_temp-browse-handle.browse-type = 'width':u
     1967       :
     1968         assign
     1969           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1970         .
     1971       end.
     1972       for each buf_temp-diasize-handle
     1973       :
     1974         delete buf_temp-diasize-handle .
     1975       end.
     1976       assign
     1977         v-field-group-handle = frame Dialog-Frame :first-child
     1978       .
     1979       do while valid-handle(v-field-group-handle)
     1980       :
     1981         assign
     1982           v-object-handle = v-field-group-handle :first-child
     1983         .
     1984         do while valid-handle(v-object-handle)
     1985         :
     1986           if  v-object-handle <> v-diasize-browse-handle :handle
     1987           and v-object-handle <> v-diasize-resize-button
     1988           and can-query(v-object-handle, "row")
     1989           and can-query(v-object-handle, "height")
     1990           and ( v-object-handle :col + v-object-handle :width
     1991                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1992               )
     1993           then do:
     1994             find first buf_temp-browse-handle
     1995               where buf_temp-browse-handle.browse-type   = 'width':u
     1996                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1997               no-error .
     1998             if available buf_temp-browse-handle
     1999             then do:
     2000             end.
     2001             else do:
     2002               create buf_temp-diasize-handle .
     2003               assign
     2004                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2005                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2006               .
     2007             end.
     2008           end.
     2009           assign
     2010             v-object-handle = v-object-handle :next-sibling
     2011           .
     2012         end.
     2013         assign
     2014           v-field-group-handle = v-field-group-handle :next-sibling
     2015         .
     2016       end.
     2017       do with frame Dialog-Frame
     2018       :
     2019         hide v-diasize-resize-button .
     2020         v-diasize-resize-button :row = 1.
     2021         v-diasize-resize-button :column = 1.
     2022       end.
     2023       if p-change-value > 0
     2024       then do:
     2025         if frame Dialog-Frame :scrollable = true
     2026         then do:
     2027           assign
     2028             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2029             no-error .
     2030           if error-status :error
     2031           or error-status :get-message(1) <> ""
     2032           then do:
     2033             undo move_block, retry move_block.
     2034           end.
     2035         end.
     2036         assign
     2037           frame Dialog-Frame :width = v-frame-width + p-change-value
     2038           no-error .
     2039         if error-status :error
     2040         or error-status :get-message(1) <> ""
     2041         then do:
     2042           undo move_block, retry move_block.
     2043         end.
     2044         assign
     2045           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2046         no-error .
     2047         if error-status :error
     2048         or error-status :get-message(1) <> ""
     2049         then do:
     2050           undo move_block, retry move_block.
     2051         end.
     2052         for each buf_temp-browse-handle
     2053           where buf_temp-browse-handle.browse-type = 'width':u
     2054         on error undo move_block, retry move_block
     2055         :
     2056           assign
     2057             buf_temp-browse-handle.browse-handle :width
     2058               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2059             no-error .
     2060           if error-status :error
     2061           or error-status :get-message(1) <> ""
     2062           then do:
     2063             undo move_block, retry move_block .
     2064           end.
     2065         end.
     2066         for each buf_temp-diasize-handle
     2067         on error undo move_block, retry move_block
     2068         :
     2069           assign
     2070             v-object-handle = buf_temp-diasize-handle.handle-value
     2071           .
     2072           if v-object-handle <> v-diasize-resize-button
     2073           then do:
     2074             assign
     2075               v-object-handle :col = v-object-handle :col + p-change-value
     2076               no-error .
     2077             if error-status :error
     2078             or error-status :get-message(1) <> ""
     2079             then do:
     2080               undo move_block, retry move_block .
     2081             end.
     2082           end.
     2083         end.
     2084       end.
     2085       else do:
     2086         for each buf_temp-diasize-handle
     2087         on error undo move_block, retry move_block
     2088         :
     2089           assign
     2090             v-object-handle = buf_temp-diasize-handle.handle-value
     2091           .
     2092           if v-object-handle <> v-diasize-resize-button
     2093           then do:
     2094             assign
     2095               v-object-handle :col = v-object-handle :col + p-change-value
     2096               no-error .
     2097             if error-status :error
     2098             or error-status :get-message(1) <> ""
     2099             then do:
     2100               undo move_block, retry move_block .
     2101             end.
     2102           end.
     2103         end.
     2104         for each buf_temp-browse-handle
     2105           where buf_temp-browse-handle.browse-type = 'width':u
     2106         on error undo move_block, retry move_block
     2107         :
     2108           assign
     2109             buf_temp-browse-handle.browse-handle :width
     2110               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2111             no-error .
     2112           if error-status :error
     2113           or error-status :get-message(1) <> ""
     2114           then do:
     2115             undo move_block, retry move_block .
     2116           end.
     2117         end.
     2118         assign
     2119           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2120           no-error .
     2121         if error-status :error
     2122         or error-status :get-message(1) <> ""
     2123         then do:
     2124           undo move_block, retry move_block.
     2125         end.
     2126         assign
     2127           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2128         no-error .
     2129         if error-status :error
     2130         or error-status :get-message(1) <> ""
     2131         then do:
     2132           undo move_block, retry move_block.
     2133         end.
     2134         if frame Dialog-Frame :scrollable = true
     2135         then do:
     2136           assign
     2137             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2138           no-error .
     2139           if error-status :error
     2140           or error-status :get-message(1) <> ""
     2141           then do:
     2142             undo move_block, retry move_block.
     2143           end.
     2144         end.
     2145       end.
     2146       if p-move-resize
     2147       then do:
     2148         run diasize_position-resize-button in this-procedure .
     2149       end.
     2150       if v-diasize-wndstore = true
     2151       then do:
     2152         if connected("ub") = true
     2153         then do:
     2154           define variable v-cntxt-db-num        as integer   no-undo .
     2155           define variable v-cntxt-userid        as character no-undo .
     2156           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2157                                             , OUTPUT v-cntxt-userid
     2158                                             ) .
     2159           run gbl/wndsizew.p
     2160             (input  v-cntxt-db-num
     2161             ,input  v-cntxt-userid
     2162             ,input  v-diasize-proc-name
     2163             ,input  'width':u
     2164             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2165             ) .
     2166         end.
     2167       end.
     2168     end.
     2169     assign
     2170       v-diasize-change-size = false
     2171     .
     2172   end procedure.
     2173   procedure diasize_set-width :
     2174     define input  parameter p-new-width  as decimal   no-undo .
     2175     define input  parameter p-move-resize as logical   no-undo .
     2176     do
     2177     on error undo, return error return-value
     2178     :
     2179       run diasize_change-width in this-procedure
     2180         (input  (p-new-width - frame Dialog-Frame :width)
     2181         ,input  p-move-resize
     2182         ) .
     2183     end.
     2184   end procedure.
     2185   procedure diasize_position-resize-button :
     2186     do with frame Dialog-Frame
     2187     :
     2188       hide v-diasize-resize-button .
     2189       assign
     2190         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2191                     - 1
     2192                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2193         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2194                     - 1
     2195                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2196       .
     2197       view v-diasize-resize-button .
     2198     end.
     2199   end procedure.
     2200   on alt-right anywhere
     2201   do:
     2202     run diasize_change-width in this-procedure
     2203       (input 1
     2204       ,input true
     2205       ) .
     2206     return no-apply .
     2207   end.
     2208   on alt-left anywhere
     2209   do:
     2210     run diasize_change-width in this-procedure
     2211       (input -1
     2212       ,input true
     2213       ) .
     2214     return no-apply .
     2215   end.
     2216   on alt-down anywhere
     2217   do:
     2218     run diasize_change-height in this-procedure
     2219       (input 1
     2220       ,input true
     2221       ) .
     2222     return no-apply .
     2223   end.
     2224   on alt-up anywhere
     2225   do:
     2226     run diasize_change-height in this-procedure
     2227       (input -1
     2228       ,input true
     2229       ) .
     2230     return no-apply .
     2231   end.
     2232   on alt-enter of frame Dialog-Frame
     2233   do:
     2234     run diasize_maximize in this-procedure
     2235       (input  ?
     2236       ).
     2237     return no-apply .
     2238   end.
     2239   procedure diasize_end-move :
     2240     do
     2241     on error undo, return error return-value
     2242     :
     2243       define variable v-row-delta as decimal   no-undo .
     2244       define variable v-col-delta as decimal   no-undo .
     2245       define variable v-new-row as decimal   no-undo .
     2246       define variable v-new-col as decimal   no-undo .
     2247       assign
     2248         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2249         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2250       .
     2251       assign
     2252         v-row-delta = v-new-row - frame Dialog-Frame :height
     2253         v-col-delta = v-new-col - frame Dialog-Frame :width
     2254       .
     2255       run diasize_change-height in this-procedure
     2256         (input v-row-delta
     2257         ,input true
     2258         ) .
     2259       run diasize_change-width in this-procedure
     2260         (input v-col-delta
     2261         ,input true
     2262         ) .
     2263     end.
     2264   end procedure.
     2265   procedure diasize_maximize :
     2266     define input  parameter p-action as logical   no-undo .
     2267     do
     2268     on error undo, return error return-value
     2269     :
     2270       if p-action = ?
     2271       then do:
     2272         if v-diasize-need-maximize = true
     2273         then do:
     2274           assign
     2275             p-action = true
     2276           .
     2277         end.
     2278         else do:
     2279           assign
     2280             p-action = false
     2281           .
     2282         end.
     2283       end.
     2284       if p-action = true
     2285       then do:
     2286         run diasize_change-height in this-procedure
     2287           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2288               - frame Dialog-Frame :height-chars
     2289           ,input true
     2290           ) .
     2291         run diasize_change-width in this-procedure
     2292           (input session :width-chars
     2293               - frame Dialog-Frame :width-chars
     2294           ,input true
     2295           ) .
     2296         assign
     2297           v-diasize-need-maximize = false
     2298         .
     2299       end.
     2300       else do:
     2301         run diasize_change-width in this-procedure
     2302           (input v-diasize-orig-frame-width
     2303               - frame Dialog-Frame :width-chars
     2304           ,input true
     2305           ) .
     2306         run diasize_change-height in this-procedure
     2307           (input v-diasize-orig-frame-height
     2308               - frame Dialog-Frame :height-chars
     2309           ,input true
     2310           ) .
     2311         assign
     2312           v-diasize-need-maximize = true
     2313         .
     2314       end.
     2315     end.
     2316   end procedure.
     2317   procedure diasize_restore-orig-size :
     2318     do
     2319     on error undo, return error return-value
     2320     :
     2321       assign
     2322         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2323         v-diasize-current-frame-height = frame Dialog-Frame :height
     2324       .
     2325       run diasize_set-height in this-procedure
     2326         (input  v-diasize-orig-frame-height
     2327         ,input  true
     2328         ) .
     2329       run diasize_set-width in this-procedure
     2330         (input  v-diasize-orig-frame-width
     2331         ,input  true
     2332         ) .
     2333     end.
     2334   end procedure.
     2335   procedure diasize_restore-current-size :
     2336     do
     2337     on error undo, return error return-value
     2338     :
     2339       run diasize_set-height in this-procedure
     2340         (input  v-diasize-current-frame-height
     2341         ,input  true
     2342         ) .
     2343       run diasize_set-width in this-procedure
     2344         (input  v-diasize-current-frame-width
     2345         ,input  true
     2346         ) .
     2347     end.
     2348   end procedure.
     2349   procedure diasize_set-browse-handle :
     2350     define input  parameter p-browse-handle as handle   no-undo .
     2351     define buffer buf_temp-browse-handle for temp-browse-handle .
     2352     do
     2353     on error undo, return error return-value
     2354     :
     2355       assign
     2356         v-diasize-browse-handle = p-browse-handle
     2357       .
     2358       for each buf_temp-browse-handle
     2359       on error undo, return error return-value
     2360       :
     2361         delete buf_temp-browse-handle .
     2362       end.
     2363     end.
     2364   end procedure.
     2365   procedure diasize_add_browse :
     2366     define input  parameter p-browse-type   as character no-undo .
     2367     define input  parameter p-browse-handle as handle    no-undo .
     2368     define buffer buf_temp-browse-handle for temp-browse-handle .
     2369     do
     2370     on error undo, return error return-value
     2371     :
     2372       assign
     2373         v-diasize-browse-number = v-diasize-browse-number + 1
     2374       .
     2375       create buf_temp-browse-handle .
     2376       assign
     2377         buf_temp-browse-handle.browse-type   = p-browse-type
     2378         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2379         buf_temp-browse-handle.browse-handle = p-browse-handle
     2380       .
     2381     end.
     2382   end procedure.
     2383   procedure diasize_init :
     2384     define variable v-default-value    as logical   no-undo .
     2385     define variable v-restore-saved    as logical   no-undo .
     2386     define variable v-resize-value-str as character no-undo .
     2387     do
     2388     on error undo, return error return-value
     2389     :
     2390       do with frame Dialog-Frame
     2391       :
     2392         assign
     2393           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2394           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2395           v-diasize-browse-handle     = browse br-cpay-type :handle
     2396         .
     2397         create button v-diasize-resize-button
     2398         assign
     2399           parent        = frame Dialog-Frame :first-child
     2400           label         = "s"
     2401           height-pixels = 16
     2402           width-pixels  = 16
     2403           visible       = true
     2404           sensitive     = true
     2405           movable       = true
     2406           triggers:
     2407             on end-move persistent run diasize_end-move in this-procedure .
     2408           end triggers.
     2409         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2410         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2411         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2412         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2413         assign
     2414           v-diasize-wndmax = false
     2415         .
     2416         if connected("ub") = true
     2417         then do:
     2418           define variable v-cntxt-db-num        as integer   no-undo .
     2419           define variable v-cntxt-userid        as character no-undo .
     2420           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2421                                             , OUTPUT v-cntxt-userid
     2422                                             ) .
     2423           run gbl/wndpar_r.p
     2424             (input  v-cntxt-db-num
     2425             ,input  v-cntxt-userid
     2426             ,input  'wndmax':U
     2427             ,output v-diasize-wndmax
     2428             ,output v-default-value
     2429             ) .
     2430         end.
     2431         assign
     2432           v-diasize-wndstore = false
     2433         .
     2434         if connected("ub") = true
     2435         then do:
     2436           run gbl/wndpar_r.p
     2437             (input  v-cntxt-db-num
     2438             ,input  v-cntxt-userid
     2439             ,input  'wndstore':U
     2440             ,output v-diasize-wndstore
     2441             ,output v-default-value
     2442             ) .
     2443         end.
     2444         assign
     2445           v-diasize-proc-name = entry(1, program-name(2), '.')
     2446         .
     2447         if v-diasize-wndstore = true
     2448         then do:
     2449           assign
     2450             v-restore-saved = false
     2451           .
     2452           if connected("ub") = true
     2453           then do:
     2454             run gbl/wndsizer.p
     2455               (input  v-cntxt-db-num
     2456               ,input  v-cntxt-userid
     2457               ,input  v-diasize-proc-name
     2458               ,input  'height':u
     2459               ,output v-resize-value-str
     2460               ) .
     2461             if v-resize-value-str <> '':U
     2462             then do:
     2463               run diasize_change-height in this-procedure
     2464                 (input  integer(v-resize-value-str)
     2465                 ,input  true
     2466                 ) .
     2467               assign
     2468                 v-restore-saved = true
     2469               .
     2470             end.
     2471           end.
     2472           if connected("ub") = true
     2473           then do:
     2474             run gbl/wndsizer.p
     2475               (input  v-cntxt-db-num
     2476               ,input  v-cntxt-userid
     2477               ,input  v-diasize-proc-name
     2478               ,input  'width':u
     2479               ,output v-resize-value-str
     2480               ) .
     2481             if v-resize-value-str <> '':U
     2482             then do:
     2483               run diasize_change-width in this-procedure
     2484                 (input  integer(v-resize-value-str)
     2485                 ,input  true
     2486                 ) .
     2487               assign
     2488                 v-restore-saved = true
     2489               .
     2490             end.
     2491           end.
     2492           if v-restore-saved <> true
     2493           then do:
     2494             if v-diasize-wndmax = true
     2495             then do:
     2496               run diasize_maximize in this-procedure
     2497                 (input  true
     2498                 ) .
     2499             end.
     2500           end.
     2501         end.
     2502         else do:
     2503           if v-diasize-wndmax = true
     2504           then do:
     2505             run diasize_maximize in this-procedure
     2506               (input  true
     2507               ) .
     2508           end.
     2509         end.
     2510       end.
     2511     end.
     2512   end procedure.
     2513   procedure diasize_need-full-display :
     2514     define output parameter p-need-full-display as logical   no-undo .
     2515     do
     2516     on error undo, return error return-value
     2517     :
     2518       assign
     2519         p-need-full-display = v-diasize-need-full-display
     2520       .
     2521       assign
     2522         v-diasize-need-full-display = false
     2523       .
     2524     end.
     2525   end procedure.
     2526   procedure get-context :
     2527      define output parameter p-db-num as integer          no-undo.
     2528      define output parameter p-user-id as character        no-undo.
     2529      define variable v-login               as character    no-undo.
     2530      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2531      define buffer buf_user-login  for ub.user-login .
     2532      do
     2533      on error undo, return error
     2534      :
     2535            FIND FIRST buf_sys-ctrl no-lock.
     2536            ASSIGN
     2537               v-login = USERID("ub")
     2538               p-db-num = buf_sys-ctrl.db-num
     2539            .
     2540            FIND FIRST buf_user-login
     2541                 WHERE buf_user-login.db-num = p-db-num
     2542                   AND buf_user-login.user-login = v-login
     2543                 no-lock
     2544                 no-error
     2545                 .
     2546            IF AVAILABLE buf_user-login
     2547            THEN DO:
     2548               assign
     2549                  p-user-id = buf_user-login.user-id
     2550               .
     2551            END.
     2552      end.
     2553   end procedure.
     2554   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2555   on f5 of frame Dialog-Frame anywhere
     2556   do:
     2557     v-doc-rec = recid(X_pay-type). run openbr in this-procedure. reposition br-cpay-type to recid v-doc-rec no-error.               apply 'value-changed' to br-cpay-type.
     2558       apply "VALUE-CHANGED" to BR-changes.
     2559   end.
     2560   def var sort-labelbr-cpay-type   as character no-undo .
     2561   def var sort-clmnbr-cpay-type    as handle    no-undo .
     2562   def var cur-clmnbr-cpay-type     as handle    no-undo .
     2563   def var cur-clmn-locbr-cpay-type as integer   no-undo .
     2564   def var re-querybr-cpay-type     as logical   initial no no-undo .
     2565   on start-search, ctrl-o of br-cpay-type in frame Dialog-Frame do:
     2566      run sort-brbr-cpay-type
     2567        (input (if available temp-changes
     2568                then recid(temp-changes)
     2569                else ?
     2570               )
     2571        ).
     2572   end.
     2573   PROCEDURE sort-brbr-cpay-type :
     2574     define input parameter p-recid as recid no-undo .
     2575     if re-querybr-cpay-type = no then do:
     2576       assign
     2577          cur-clmnbr-cpay-type = br-cpay-type:current-column in frame Dialog-Frame
     2578       .
     2579       if sort-clmnbr-cpay-type <> ? then sort-clmnbr-cpay-type:column-fgcolor = 0.
     2580       if cur-clmnbr-cpay-type = sort-clmnbr-cpay-type then do:
     2581         assign
     2582            sort-labelbr-cpay-type = ""
     2583            sort-clmnbr-cpay-type = ?
     2584         .
     2585        end.
     2586        else do:
     2587          assign
     2588            sort-labelbr-cpay-type = cur-clmnbr-cpay-type:label
     2589            sort-clmnbr-cpay-type  = cur-clmnbr-cpay-type
     2590            sort-clmnbr-cpay-type:column-fgcolor = 4
     2591          .
     2592        end.
     2593      end.
     2594     assign
     2595       cur-clmn-locbr-cpay-type = 1
     2596     .
     2597     def var column-handle as handle no-undo .
     2598     column-handle = br-cpay-type:first-column.
     2599     do while valid-handle(column-handle) :
     2600       if column-handle = cur-clmnbr-cpay-type then do:
     2601         leave .
     2602       end.
     2603       column-handle = column-handle:NEXT-COLUMN.
     2604       assign
     2605         cur-clmn-locbr-cpay-type = cur-clmn-locbr-cpay-type + 1
     2606       .
     2607     end.
     2608     case sort-labelbr-cpay-type:
     2609           when X_c-pay-type.obj-name:label in browse br-cpay-type then DO:   assign     sort-column-name = "X_c-pay-type.obj-name"   .   run OpenBr.   . END.
     2610           when X_c-pay-type.corr-date:label in browse br-cpay-type then DO:   assign     sort-column-name = "X_c-pay-type.corr-date"   .   run OpenBr.   . END.
     2611       otherwise do:
     2612         assign
     2613           sort-column-name = ""
     2614         .
     2615         run OpenBr.
     2616           if can-do( this-procedure:internal-entries, 'mv-brw-defaultbr-cpay-type') then do:
     2617             run mv-brw-defaultbr-cpay-type.
     2618           end.
     2619         if sort-labelbr-cpay-type <> "" then do:
     2620           assign
     2621             cur-clmnbr-cpay-type:column-fgcolor = 0
     2622           .
     2623         end.
     2624         assign
     2625           cur-clmn-locbr-cpay-type = ?
     2626         .
     2627       end.
     2628     end case.
     2629       if cur-clmn-locbr-cpay-type <> ? then do:
     2630         if can-do( this-procedure:internal-entries, 'ch-clmnbr-cpay-type') then do:
     2631           run ch-clmnbr-cpay-type in this-procedure (cur-clmn-locbr-cpay-type).
     2632         end.
     2633       end.
     2634     if p-recid <> ? then do:
     2635       reposition br-cpay-type to recid p-recid no-error.
     2636       apply "value-changed" to br-cpay-type in frame Dialog-Frame.
     2637     end.
     2638     apply "entry" to br-cpay-type in frame Dialog-Frame.
     2639   END PROCEDURE.
     2640   procedure re-open-query-srt-clmnbr-cpay-type:
     2641   if cur-clmnbr-cpay-type = ? then do:
     2642      run OpenBr.
     2643   end.
     2644   else do:
     2645      assign re-querybr-cpay-type = yes.
     2646      run sort-brbr-cpay-type
     2647        (input (if available temp-changes
     2648                then recid(temp-changes)
     2649                else ?
     2650               )
     2651        ).
     2652      assign re-querybr-cpay-type = no.
     2653   end.
     2654   end.
     2655   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2656   do:
     2657     BR-changes :SET-REPOSITIONED-ROW(5, "CONDITIONAL") .
     2658   end.
     2659   MAIN-BLOCK:
     2660   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2661      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2662    if LOOKUP(p-mode, 'one':U,
     2663                   chr(4)) = 0
     2664        then dO:
     2665       message
     2666       vss-workfile vss-revision vss-description skip
     2667       "Неверное значение параметров вызова p-mode"
     2668       p-mode
     2669       view-as alert-box ERROR.
     2670       return error .
     2671    end.
     2672    if p-mode = "one":U then do:
     2673     find first X_pay-type no-lock where
     2674                   X_pay-type.obj-code = p-obj-code no-error.
     2675       if not available X_pay-type then do:
     2676           message
     2677           vss-workfile vss-revision vss-description skip
     2678           "Неверное значение параметра вызова p-obj-code"
     2679           p-obj-code
     2680           view-as alert-box ERROR.
     2681           return.
     2682       end.
     2683     end.
     2684     v-rid-list = p-rid-list.
     2685   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2686   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
     2687     (output v-db-num
     2688     )  .
     2689     RUN MyEnable.
     2690     RUn OpenBR.
     2691     HIDE mark-num in frame Dialog-Frame .
     2692     if v-doc-rec <> ? then
     2693     REPOSITION br-cpay-type to recid v-doc-rec No-ERROR.
     2694   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2695   DEF VAR cur-clmn-numbr-cpay-type as INT EXTENT 7 no-undo.
     2696   DEF VAR varmvibr-cpay-type       as INT no-undo.
     2697   DEF VAR varmvjbr-cpay-type       as INT no-undo.
     2698   DEF VAR varmvkbr-cpay-type       as INT no-undo.
     2699   DEF VAR varmvlbr-cpay-type       as INT no-undo.
     2700   DEF VAR move-elementbr-cpay-type as INT no-undo.
     2701   def var jjbr-cpay-type           as int no-undo.
     2702   do varmvibr-cpay-type = 1 to EXTENT(cur-clmn-numbr-cpay-type):
     2703     ASSIGN cur-clmn-numbr-cpay-type[varmvibr-cpay-type] = varmvibr-cpay-type.
     2704   END.
     2705   RUN start-mv-clmnbr-cpay-type.
     2706   PROCEDURE start-mv-clmnbr-cpay-type:
     2707   def var old-session as logical no-undo.
     2708      old-session = SESSION:IMMEDIATE-DISPLAY.
     2709      IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     2710          IF  p-mode = 'one'  THEN DO:
     2711      DO jjbr-cpay-type = NUM-ENTRIES('1,2,3,4,5,6,7') TO 1 BY -1:
     2712        RUN re-move-clmnbr-cpay-type ( cur-clmn-numbr-cpay-type[INTEGER(ENTRY (jjbr-cpay-type, '1,2,3,4,5,6,7'))] , 1).
     2713      END.
     2714          END.
     2715      SESSION:IMMEDIATE-DISPLAY = old-session.
     2716   END.
     2717   ON ctrl-cursor-right OF BROWSE br-cpay-type do:
     2718     RUN re-move-clmnbr-cpay-type ( 1, 7).
     2719   END.
     2720   ON ctrl-cursor-left OF BROWSE br-cpay-type do:
     2721     RUN re-move-clmnbr-cpay-type (7, 1).
     2722   END.
     2723   PROCEDURE re-move-clmnbr-cpay-type:
     2724     DEFINE INPUT PARAMETER source-column as INTEGER NO-UNDO.
     2725     DEFINE INPUT PARAMETER target-column as INTEGER NO-UNDO.
     2726     DO varmvibr-cpay-type = 1 TO EXTENT(cur-clmn-numbr-cpay-type):
     2727       if cur-clmn-numbr-cpay-type[varmvibr-cpay-type] = source-column THEN cur-clmn-numbr-cpay-type[varmvibr-cpay-type] = -1.
     2728     END.
     2729     if br-cpay-type:MOVE-COLUMN(source-column, target-column) IN FRAME Dialog-Frame then.
     2730     if source-column > target-column THEN
     2731     DO varmvjbr-cpay-type = source-column - 1 to target-column BY -1:
     2732       DO varmvibr-cpay-type = 1 TO EXTENT(cur-clmn-numbr-cpay-type):
     2733           if cur-clmn-numbr-cpay-type[varmvibr-cpay-type] = varmvjbr-cpay-type THEN DO:
     2734             cur-clmn-numbr-cpay-type[varmvibr-cpay-type] = cur-clmn-numbr-cpay-type[varmvibr-cpay-type] + 1.
     2735           END.
     2736       END.
     2737     END.
     2738     ELSE
     2739     DO varmvjbr-cpay-type = source-column + 1 to target-column:
     2740       DO varmvibr-cpay-type = 1 TO EXTENT(cur-clmn-numbr-cpay-type):
     2741         if cur-clmn-numbr-cpay-type[varmvibr-cpay-type] = varmvjbr-cpay-type THEN DO:
     2742           cur-clmn-numbr-cpay-type[varmvibr-cpay-type] = cur-clmn-numbr-cpay-type[varmvibr-cpay-type] - 1.
     2743         END.
     2744       END.
     2745     END.
     2746     DO varmvibr-cpay-type = 1 TO EXTENT(cur-clmn-numbr-cpay-type):
     2747       if cur-clmn-numbr-cpay-type[varmvibr-cpay-type] = -1 THEN cur-clmn-numbr-cpay-type[varmvibr-cpay-type] = target-column.
     2748     END.
     2749   END PROCEDURE.
     2750   PROCEDURE ch-clmnbr-cpay-type:
     2751     DEFINE INPUT PARAMETER cur-clmn-loc as INTEGER NO-UNDO.
     2752     if cur-clmn-loc <= 1 then do:
     2753       return .
     2754     end.
     2755     DO varmvibr-cpay-type = 1 TO EXTENT(cur-clmn-numbr-cpay-type):
     2756       if cur-clmn-numbr-cpay-type[varmvibr-cpay-type] = cur-clmn-loc THEN move-elementbr-cpay-type = varmvibr-cpay-type.
     2757     END.
     2758     RUN re-move-clmnbr-cpay-type (cur-clmn-loc, 1).
     2759   END PROCEDURE.
     2760   PROCEDURE mv-brw-defaultbr-cpay-type:
     2761   def var old-session as logical no-undo.
     2762     old-session = SESSION:IMMEDIATE-DISPLAY.
     2763     IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     2764     do varmvlbr-cpay-type = 1 to EXTENT(cur-clmn-numbr-cpay-type):
     2765       RUN re-move-clmnbr-cpay-type (cur-clmn-numbr-cpay-type[varmvlbr-cpay-type], varmvlbr-cpay-type).
     2766     END.
     2767     RUN start-mv-clmnbr-cpay-type.
     2768     SESSION:IMMEDIATE-DISPLAY = old-session.
     2769   END PROCEDURE.
     2770   .
     2771    run diasize_add_browse in this-procedure
     2772       (input  'width':u
     2773       ,input  browse br-changes :handle
     2774       ) .
     2775    run diasize_init in this-procedure .
     2776   WAIT-FOR GO OF FRAME Dialog-Frame.
     2777   END.
     2778   RUN disable_UI.
     2779   PROCEDURE disable_UI :
     2780     HIDE FRAME Dialog-Frame.
     2781   END PROCEDURE.
     2782   PROCEDURE enable_UI :
     2783     DISPLAY mark-num
     2784         WITH FRAME Dialog-Frame.
     2785     ENABLE b-quit B-mark B-sel B-Help br-cpay-type BR-changes mark-num
     2786         WITH FRAME Dialog-Frame.
     2787     VIEW FRAME Dialog-Frame.
     2788     OPEN QUERY br-cpay-type FOR EACH X_c-pay-type NO-LOCK INDEXED-REPOSITION.
     2789   END PROCEDURE.
     2790   PROCEDURE MyEnable :
     2791   assign
     2792   temp-changes.l_name:resizable in browse br-changes = true
     2793   temp-changes.v_old:resizable in browse br-changes = true
     2794   temp-changes.v_new:resizable in browse br-changes = true
     2795   temp-changes.l_name:width in browse br-changes = 30
     2796   temp-changes.v_old:width in browse br-changes = 40
     2797   temp-changes.v_new:width in browse br-changes = 40
     2798   .
     2799   DISPLAY mark-num
     2800   WITH FRAME Dialog-Frame.
     2801   ENABLE
     2802   b-quit
     2803   B-mark when LOOKUP("b-mark":U, bttns) > 0
     2804   B-sel when LOOKUP("b-sel":U, bttns) > 0
     2805   B-Help
     2806   br-cpay-type mark-num
     2807   br-changes
     2808   with FRAME Dialog-Frame.
     2809   VIEW FRAME Dialog-Frame.
     2810   END PROCEDURE.
     2811   PROCEDURE OpenBr :
     2812   OPEN QUERY br-cpay-type FOR EACH X_c-pay-type NO-LOCK where
     2813                                  X_c-pay-type.obj-code = p-obj-code
     2814                              AND X_c-pay-type.corr-user-db-num = 0
     2815                                 INDEXED-REPOSITION.
     2816   APPLY "VALUE-CHANGED" TO br-cpay-type in frame Dialog-Frame.
     2817   APPLY "ENTRY" TO br-cpay-type.
     2818   END PROCEDURE.
     2819   PROCEDURE proc-br-cpay-type :
     2820   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2821   if b-sel:sensitive in frame Dialog-Frame then dO:
     2822       if b-mark:sensitive then do:
     2823           apply "choose" to b-mark in frame Dialog-Frame.
     2824       end.
     2825       else do:
     2826           apply "choose" to b-sel in frame Dialog-Frame.
     2827       end.
     2828   end.
     2829   else do:
     2830       if b-lookup:sensitive then
     2831       apply "choose" to b-lookup in frame Dialog-Frame.
     2832   end.
     2833   END PROCEDURE.
     2834   PROCEDURE proc-view-changes :
     2835   define buffer new_c-pay-type for ub.c-pay-type.
     2836   define buffer current_pay-type for ub.pay-type.
     2837   define variable v-chg-fields as character no-undo.
     2838   define variable v-old-fields as character no-undo.
     2839   define variable v-new-fields as character no-undo.
     2840   define variable ii as integer no-undo.
     2841   define variable jj as integer no-undo .
     2842   define variable v-field-name as character no-undo .
     2843   define variable v-field-label as character no-undo .
     2844   for each temp-changes:
     2845       delete temp-changes.
     2846   END.
     2847   if not available X_c-pay-type then do:
     2848     Open QUery br-changes for each temp-changes.
     2849     return.
     2850   end.
     2851   define variable v-label-param as character no-undo .
     2852   v-label-param =
     2853     "obj-name" + chr(4) + "Название" + chr(4) + "" + chr(8)
     2854    + "obj-code" + chr(4) + "Код" + chr(4) + ""  .
     2855    run proc-full-temp-changes in this-procedure (
     2856                                                input  (X_c-pay-type.action = integer('1':U))
     2857                                               ,input  (X_c-pay-type.action = integer('99':U))
     2858                                               ,input  buffer X_c-pay-type:handle
     2859                                               ,input  'pay-type':U
     2860                                               ,input  "obj-name,obj-code"
     2861                                               ,input  v-label-param).
     2862   Open QUery br-changes for each temp-changes.
     2863   END PROCEDURE.
     2864   FUNCTION get-action RETURNS CHARACTER
     2865     ( p-action as integer ) :
     2866     define variable dops as character no-undo.
     2867   assign dops = entry (lookup (trim(string(p-action)), '99,1,2,3,4,9,51,79':U), 'Удаление,Создание,Изменение,Коррекция,Восстановление,Смена_кода,Смена_артик,Выключ.':U) no-error.
     2868   END FUNCTION.
