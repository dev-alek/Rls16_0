      501   procedure thobjs :
      502      define input        parameter parparentproc     as widget-handle no-undo .
      503      define input        parameter i-bttns           as character     no-undo .
      504      define input        parameter i-list-mode       as character     no-undo.
      505      define input        parameter i-obj-type        as character     no-undo.
