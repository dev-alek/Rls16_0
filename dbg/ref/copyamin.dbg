      519   define buffer buf_gds-obj-prop  for ub.gds-obj-prop .
      520   define buffer curr_gds-obj-prop for ub.gds-obj-prop .
      521   define buffer buf_assortment-matrix for ub.assortment-matrix  .
      522   define buffer buf_assortment-matrix-goods for ub.assortment-matrix-goods  .
      523   define temp-table temp-err no-undo  LIKE ub.rep-line
      524     field str as character
      525     field gds-code as integer
      526   index pi is primary unique  gds-code
      527   .
      528   empty temp-table temp-err.
      529   do
      530   on error undo, return error return-value
      531   :
      532   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      533     run mainmenu_getcntxt in parparentproc
      534       (output v-cntxt-db-num
      535       ,output v-cntxt-userid
      536       ,output v-cntxt-level
      537       ,output v-cntxt-host-code-obj
      538       ,output v-cntxt-obj-type
      539       ,output v-cntxt-obj-code
      540       ,output v-cntxt-db-num-obj
      541       ,output v-cntxt-is-admin
      542       ) .
      543    define variable v-log1 as logical   no-undo .
      544   define variable vss-include-info4 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      545   do:
