      584     )  .
      585   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      586   run userobjs_select-one in this-procedure
      587     (input  parparentproc
      588     ,input  v-cntxt-db-num
      589     ,input  v-cntxt-userid
      590     ,input  v-host-code
      591     ,input  p-curr-obj-type
      592     ,input  p-curr-obj-code
