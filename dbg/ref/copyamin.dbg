      627   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      628   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      629     (input  v-obj-type
      630     ,input  v-obj-code
      631     ,output v-host-code
      632     )  .
      633   define variable  v-str as character no-undo .
      634   v-str = "" .
      635   run waitfram-show ("Ждите....").
      636   define variable is-am       as logical   no-undo .
      637   define variable asmt-id     as integer   no-undo .
      638   define variable asmt-db-num as integer   no-undo .
      639   is-am = false .
      640   find first buf_assortment-matrix no-lock where
      641              buf_assortment-matrix.asmt-status = 0 and
      642              buf_assortment-matrix.obj-code = v-obj-code and
      643              buf_assortment-matrix.obj-type = v-obj-type
      644              no-error .
      645           if available buf_assortment-matrix then do:
      646           assign
      647               is-am          = true
      648               asmt-id        = buf_assortment-matrix.asmt-id
      649               asmt-db-num    = buf_assortment-matrix.db-num
      650           .
      651           end.
      652     for each curr_gds-obj-prop exclusive-lock
      653       where curr_gds-obj-prop.obj-type = v-obj-type
      654         and curr_gds-obj-prop.obj-code = v-obj-code
      655         and curr_gds-obj-prop.gdop-assort-min = true
      656     on error undo, return error return-value
      657     :
      658       curr_gds-obj-prop.gdop-assort-min = false .
      659     end.
      660     for each buf_gds-obj-prop no-lock
      661       where buf_gds-obj-prop.obj-type =  p-curr-obj-type
      662         and buf_gds-obj-prop.obj-code =  p-curr-obj-code
      663         and buf_gds-obj-prop.gdop-assort-min = true
      664     on error undo, return error return-value
      665     :
      666     if is-am then do:
      667         find first buf_assortment-matrix-goods no-lock  where
      668                    buf_assortment-matrix-goods.asmg-status = 0 and
      669                    buf_assortment-matrix-goods.gds-code    =  buf_gds-obj-prop.gds-code and
      670                    buf_assortment-matrix-goods.asmt-id     =  asmt-id and
      671                    buf_assortment-matrix-goods.db-num      =  asmt-db-num
      672                    no-error .
      673         if not available  buf_assortment-matrix-goods then do:
      674             create temp-err.
      675             assign
      676               temp-err.gds-code = buf_gds-obj-prop.gds-code
      677           .
      678   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      679   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-cdnm in g#library
      680     (input  buf_gds-obj-prop.gds-code
      681     ,output temp-err.str
      682     )  .
      683            v-str = '---' .
      684            next.
      685         end.
      686     end.
      687       find first ub.gds-obj-prop exclusive-lock
      688         where ub.gds-obj-prop.gds-code = buf_gds-obj-prop.gds-code
      689           and ub.gds-obj-prop.obj-type = v-obj-type
      690           and ub.gds-obj-prop.obj-code = v-obj-code
      691         no-error .
      692       if available ub.gds-obj-prop then do:
      693             assign
      694               ub.gds-obj-prop.gdop-assort-min = buf_gds-obj-prop.gdop-assort-min
      695             .
      696       end.
      697       else do:
      698             create ub.gds-obj-prop no-error .
      699             assign
      700               ub.gds-obj-prop.gds-code        = buf_gds-obj-prop.gds-code
      701               ub.gds-obj-prop.obj-type        = v-obj-type
      702               ub.gds-obj-prop.obj-code        = v-obj-code
      703               ub.gds-obj-prop.gdop-assort-min = buf_gds-obj-prop.gdop-assort-min
      704               .
      705       end.
      706     end.
      707     run waitfram-hide.
      708     define variable loc-ok1 as logical   no-undo .
      709     if v-str <> "" then do:
      710        message "Не все Товары Ассортиментного МИН удалось скопировать на объект" skip
      711               v-obj-type skip
      712               v-obj-code skip
      713               "Они не вошли в Ассортиментную матрицу объекта." skip
      714               "Просмотреть товары не вошедшие в список ?"
      715               view-as alert-box question
      716               buttons yes-no
      717               update loc-ok1
      718       .
      719       if loc-ok1 then
