     6870   PROCEDURE proc-br-fin-doc :
     6871   define variable vss-include-info48 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6872   if b-sel:sensitive in frame Dialog-Frame then dO:
     6873       if b-mark:sensitive then do:
     6874           apply "choose" to b-mark in frame Dialog-Frame.
     6875       end.
     6876       else do:
     6877           apply "choose" to b-sel in frame Dialog-Frame.
     6878       end.
     6879   end.
     6880   else do:
     6881       if b-lookup:sensitive then
     6882       apply "choose" to b-lookup in frame Dialog-Frame.
     6883   end.
     6884   END PROCEDURE.
     6885   PROCEDURE proc-buttons :
     6886   define input parameter p-is-batch as logical no-undo.
     6887   ENABLE
     6888   b-close when (is-fact-mode = no
     6889                 AND not transaction
     6890                 AND
     6891                 (not p-is-batch
     6892                 or
     6893                 (
     6894                 is-stat-mode = yes
     6895                   AND
     6896                 is-type-mode = yes
     6897                 ))
     6898                 AND (p-curr-host-code = p-host-code
     6899                     AND available X_sysconf
     6900                     AND (X_sysconf.firm-db-num = v-db-num or v-cntxt-db-num = v-obj-db-num)))
     6901   b-open when (is-fact-mode = no
     6902               AND not transaction
     6903               AND
     6904                 (not p-is-batch
     6905                 or
     6906                 (
     6907                 is-stat-mode = yes
     6908                   AND
     6909                 is-type-mode = yes
     6910                 ))
     6911               AND (p-curr-host-code = p-host-code
     6912                   AND available X_sysconf
     6913                   AND (X_sysconf.firm-db-num = v-db-num or v-cntxt-db-num = v-obj-db-num)) )
     6914   b-reject when (is-fact-mode = no
     6915                 AND not transaction
     6916                 AND
     6917                 (not p-is-batch
     6918                 or
     6919                 (
     6920                 is-stat-mode = yes
     6921                   AND
     6922                 is-type-mode = yes
     6923                 ))
     6924                 AND (p-curr-host-code = p-host-code
     6925                       AND available X_sysconf
     6926                       AND X_sysconf.firm-db-num = v-db-num) )
     6927   with frame Dialog-Frame .
     6928   CASE p-is-batch:
     6929       when yes then do:
     6930           ENABLE
     6931           B-mark
     6932           with frame Dialog-Frame.
     6933           disable
     6934           b-add
     6935           b-incas
     6936           b-chg with frame Dialog-Frame.
     6937         assign
     6938         menu-item m_one:sensitive in menu menu-b-print = (is-type-mode = yes).
     6939         menu-item m_one-graphics:sensitive in menu menu-b-print = (is-type-mode = yes).
     6940         menu-item m_form:sensitive in menu menu-b-print = no.
     6941       end.
     6942       when no then do:
     6943           ENABLE
     6944           B-mark when lookup("b-mark":U, bttns) > 0
     6945           B-add  when (p-curr-host-code = p-host-code
     6946                       AND available X_sysconf
     6947                       AND (X_sysconf.firm-db-num = v-db-num or v-cntxt-db-num = v-obj-db-num)
     6948                       AND not p-is-batch
     6949                       AND not(is-stat-mode = yes and p-status_ <> 'новый':U)
     6950                       AND not transaction
     6951                       )
     6952           b-incas when (p-curr-host-code = p-host-code
     6953                       AND available X_sysconf
     6954                       AND (X_sysconf.firm-db-num = v-db-num or v-cntxt-db-num = v-obj-db-num)
     6955                       AND not p-is-batch
     6956                       AND not(is-stat-mode = yes and p-status_ <> 'новый':U)
     6957                       AND not transaction
     6958                       )
     6959           B-chg when (p-curr-host-code = p-host-code
     6960                       AND available X_sysconf
     6961                       AND (X_sysconf.firm-db-num = v-db-num or v-cntxt-db-num = v-obj-db-num)
     6962                       AND not transaction
     6963                       )
     6964           with frame Dialog-Frame.
     6965           DISABLE
     6966           b-mark when lookup("b-mark":U, bttns) = 0
     6967           with frame Dialog-Frame.
     6968           assign
     6969         menu-item m_one:sensitive in menu menu-b-print = no.
     6970         menu-item m_one-graphics:sensitive in menu menu-b-print = no.
     6971         menu-item m_form:sensitive in menu menu-b-print = yes.
     6972       end.
     6973   END CASE.
     6974   END PROCEDURE.
     6975   PROCEDURE proc-close-open :
     6976   define input parameter p-close-mode as character no-undo .
     6977   define input parameter p-is-batch as logical no-undo .
     6978   define variable v-status_ as character no-undo .
     6979   define variable v-old-status_ as character no-undo .
     6980   define variable v-fin-doc-type as character no-undo .
     6981   define variable v-ask-date as logical no-undo .
     6982   define variable v-ask-message as character no-undo .
     6983   define variable v-status-date-chr as character no-undo.
     6984   define variable v-date as date no-undo .
     6985   define variable v-time as integer no-undo .
     6986   define variable ok as logical no-undo .
     6987   define variable ii as integer no-undo.
     6988   define variable ok-ii as integer no-undo.
     6989   define variable v-new-rid-list as character no-undo .
     6990   define variable v-doc-rec as recid no-undo .
     6991   define variable conf-par as character no-undo .
     6992   define variable par-type as character no-undo .
     6993   define variable glog as logical no-undo .
     6994   define buffer buf_fin-doc for ub.fin-doc.
     6995   if t-batch = no then do:
     6996       if not available X_fin-doc then return error.
     6997       assign
     6998       v-doc-rec = recid(X_fin-doc).
     6999   end.
     7000   if t-batch = yes then do:
     7001   if v-rid-list = "":U then do:
     7002       message
     7003       "Вы не отметили ни одного платежа"
     7004       view-as alert-box error.
     7005       return error.
     7006     end.
     7007   end.
     7008   do
     7009   on error undo, return error
     7010   :
     7011     CASE t-batch:
     7012       when no then do:
     7013         find first buf_fin-doc where
     7014                   recid(buf_fin-doc) = recid(X_fin-doc) exclusive-lock no-error .
     7015         if not avail buf_fin-doc then return error.
     7016         assign
     7017         v-old-status_ = buf_fin-doc.status_
     7018         .
     7019       end.
     7020       when yes then do:
     7021         _do:
     7022         do ii = 1 to num-entries(v-rid-list):
     7023           find first buf_fin-doc where
     7024               recid(buf_fin-doc) = integer(entry(ii, v-rid-list)) exclusive-lock no-error .
     7025           if ii = 1 then do:
     7026             assign
     7027             v-old-status_ = buf_fin-doc.status_
     7028             V-FIN-DOC-TYPE = BUF_FIN-DOC.fin-doc-type
     7029             v-doc-rec = recid(buf_fin-doc)
     7030             .
     7031           end.
     7032           if not avail buf_fin-doc
     7033           or (avail buf_fin-doc and v-old-status_ <> "":U and buf_fin-doc.status_ <> v-old-status_)
     7034           or (avail buf_fin-doc and v-fin-doc-type <> "":U aND buf_fin-doc.fin-doc-type <> v-fin-doc-type)
     7035           then NEXT _do.
     7036           LEAVE _do.
     7037         end.
     7038       end.
     7039     END CASE.
     7040   end.
     7041   run trg/findgraf.p (
     7042                   input  buf_fin-doc.host-code
     7043                   ,input  buf_fin-doc.fin-doc-code
     7044                   ,input  p-close-mode
     7045                   ,input  ''
     7046                   ,input  v-old-status_
     7047                   ,input  ?
     7048                   ,output v-status_
     7049                   ,output v-ask-date
     7050                   ,output v-ask-message
     7051                   ) no-error.
     7052   if error-status:error then do:
     7053     message
     7054     "Ошибка при проверке возможности" p-close-mode skip
     7055     return-value
     7056     view-as alert-box error.
     7057     return error.
     7058   end.
     7059   if v-status_ = 'факт':U
     7060   then do:
     7061     case buf_fin-doc.fin-doc-type
     7062     :
     7063       when 'пко':U
     7064       then do:
     7065   define variable vss-include-info49 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7066   do:
