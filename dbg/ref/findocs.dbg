     7068       (input  v-cntxt-db-num
     7069       ,input  v-cntxt-userid
     7070       ,input  0
     7071       ,input  'actn_income-cash_close-fact':U
     7072       ,input  'firm':U
     7073       ,input  buf_fin-doc.host-code
     7074       ,input  '':U
     7075       ,input  0
     7076       ,input  0
