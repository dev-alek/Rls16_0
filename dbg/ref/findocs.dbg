     6312                               ,input 0
     6313                               ,input '':U
     6314                               ,input "":U
     6315                               ,input 0
     6316                               ,input ?
     6317                               ,input 0
     6318                               ,input 0
     6319                               ,input 0
     6320                               ,input 0
     6321                               ,input (if lock-obj then "lock-obj":U else '')
     6322                               ,input-output loc-doc-rec
     6323                                           ) no-error
