      137     run proc-alt-shift-f3 in this-procedure .
      138   end.
      139   on alt-shift-f4 anywhere do:
      140     run proc-alt-shift-f4 in this-procedure.
      141   end.
      142   on alt-f1 anywhere do:
      143     run proc-alt-f1 in this-procedure .
      144   end.
      145   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      146   define variable c-point  as character no-undo .
      147   define variable tbl      as character no-undo .
      148   define variable join-tbl as character no-undo .
      149   define variable fld      as character no-undo .
      150   define variable lab      as character no-undo .
      151   define variable spr      as character no-undo .
      152   define variable dim      as character no-undo .
      153   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      154   procedure cur-time :
      155      define output parameter p-today as date      no-undo .
      156      define output parameter p-time  as integer   no-undo .
      157     do
      158     on error undo, return error
      159     :
      160       define variable v-date1 as date      no-undo .
      161       define variable v-date2 as date      no-undo .
      162       define variable v-time  as integer   no-undo .
      163       assign
      164         v-date1 = today
      165         v-time  = time
      166         v-date2 = today
      167       .
      168       if v-date1 <> v-date2
      169       then do:
      170         assign
      171           v-date1 = today
      172           v-time  = v-time
      173         .
      174       end.
      175       assign
      176         p-today = v-date1
      177         p-time  = v-time
      178       .
      179     end.
      180   end.
      181   function cur-time-date returns character
      182   :
      183     return string(today, '99/99/9999':U) .
      184   end.
      185   function cur-time-mjd returns decimal
      186   :
      187     define variable v-date as date      no-undo .
      188     define variable v-time as integer   no-undo .
      189     run cur-time in this-procedure
      190       (output v-date
      191       ,output v-time
      192       ) .
      193     return integer(v-date) - 2400002 + (v-time / 86400) .
      194   end.
      195   function cur-time-get-ending-index returns integer
      196   (input p-number as integer
      197   )
      198   :
      199     if p-number < 0
      200     or p-number = ?
      201     then do:
      202       return 1 .
      203     end.
      204     define variable v-rest as integer   no-undo .
      205     assign
      206       p-number = p-number modulo 100
      207     .
      208     if p-number < 20
      209     then do:
      210       assign
      211         v-rest = p-number
      212       .
      213     end.
      214     else do:
      215       assign
      216         v-rest = p-number modulo 10
      217       .
      218     end.
      219     case v-rest :
      220       when 1
      221       then do:
      222         return 2 .
      223       end.
      224       when 2 or
      225       when 3 or
      226       when 4
      227       then do:
      228         return 3 .
      229       end.
      230       otherwise do:
      231         return 1 .
      232       end.
      233     end case .
      234   end.
      235   procedure cur-time-mjd-to-date :
      236      define input  parameter i-mjd-diff as decimal no-undo.
      237      define output parameter o-Date     as date    no-undo.
      238      define output parameter o-Time     as integer no-undo.
      239      define variable v-day-number as integer   no-undo .
      240      if    i-mjd-diff < 0
      241         or i-mjd-diff = ?
      242      then do:
      243         return "?" .
      244      end.
      245      assign
      246         v-day-number = truncate(i-mjd-diff,0).
      247         o-Date = date(v-day-number + 2400002).
      248         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      249     .
      250   end.
      251   function cur-time-mjd-to-string returns character
      252   (input p-mjd-diff as decimal
      253   )
      254   :
      255     define variable v-day-number as integer   no-undo .
      256     define variable v-seconds    as integer   no-undo .
      257     define variable v-hour       as integer   no-undo .
      258     define variable v-min        as integer   no-undo .
      259     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      260     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      261     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      262     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      263     if p-mjd-diff < 0
      264     or p-mjd-diff = ?
      265     then do:
      266       return "?" .
      267     end.
      268     assign
      269       v-day-number = integer(truncate(p-mjd-diff,0))
      270       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      271     .
      272     if v-seconds > 86400
      273     then do:
      274       assign
      275         v-seconds = 86400 - 1
      276       .
      277     end.
      278     if v-seconds < 0
      279     then do:
      280       assign
      281         v-seconds = 0
      282       .
      283     end.
      284     assign
      285       v-hour = truncate(v-seconds / 3600, 0)
      286     .
      287     assign
      288       v-seconds = v-seconds modulo 3600
      289     .
      290     assign
      291       v-min = truncate(v-seconds / 60, 0)
      292     .
      293     assign
      294       v-seconds = v-seconds modulo 60
      295     .
      296     return
      297         (if v-day-number <> 0
      298           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      299           else ""
      300         )
      301       + (if v-day-number <> 0 or v-hour <> 0
      302           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      303           else ""
      304         )
      305       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      306           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      307           else ""
      308         )
      309       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      310       .
      311   end.
      312   function cur-time-string returns character
      313   :
      314     define variable v-date as date      no-undo .
      315     define variable v-time as integer   no-undo .
      316     run cur-time in this-procedure
      317       (output v-date
      318       ,output v-time
      319       ) .
      320     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      321   end.
      322   function cur-time-string-sec returns character
      323   :
      324     define variable v-date as date      no-undo .
      325     define variable v-time as integer   no-undo .
      326     run cur-time in this-procedure
      327       (output v-date
      328       ,output v-time
      329       ) .
      330     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      331   end.
      332   function cur-time-custom  returns character
      333   (input p-prefix as character
      334   ,input p-date-format as character
      335   ,input p-delimiter as character
      336   ,input p-time-format as character
      337   ,input p-suffix as character
      338   )
      339   :
      340     define variable v-date as date      no-undo .
      341     define variable v-time as integer   no-undo .
      342     run cur-time in this-procedure
      343       (output v-date
      344       ,output v-time
      345       ) .
      346     return
      347       p-prefix
      348       + string(v-date, p-date-format)
      349       + p-delimiter
      350       + string(v-time, p-time-format)
      351       + p-suffix
      352       .
      353   end.
      354   function cur-time-print  returns character
      355   :
      356     define variable v-date as date      no-undo .
      357     define variable v-time as integer   no-undo .
      358     run cur-time in this-procedure
      359       (output v-date
      360       ,output v-time
      361       ) .
      362     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      363   end.
      364   function cur-time-datetime returns datetime
      365   :
      366     define variable v-char as character no-undo .
      367     define variable v-datetime as datetime no-undo .
      368     v-char = cur-time-string().
      369     v-datetime = datetime(v-char).
      370     return  v-datetime.
      371   end.
      372   function cur-time-string-msec returns character
      373   :
      374     define variable v-date as datetime  no-undo .
      375     v-date = now.
      376     return string(v-date) .
      377   end.
      378   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      379   define new shared variable PrintCopiesCounter as integer   no-undo initial 1 .
      380   define new shared variable RepPathName        as character no-undo .
      381   define new shared variable PrintRubl          as logical   no-undo .
      382   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      383   define variable v-waitfram-action01         as character   no-undo .
      384   define variable v-waitfram-action02         as character   no-undo .
      385   define variable v-waitfram-action03         as character   no-undo .
      386   define variable mWaitFramTextBeg            as character   no-undo.
      387   define variable mWaitFramTextEnd            as character   no-undo.
      388   define variable mWaitFramView               as logical     no-undo.
      389   define variable mWaitProcEvent              as logical     no-undo init yes.
      390   define variable mWaitFramInterval           as integer     no-undo init 1 .
      391   define variable mWaitFramStop               as logical     no-undo.
      392   define variable mWaitFramStopUser           as logical     no-undo.
      393   define variable mWaitFramStopTimeOut        as logical     no-undo.
      394   define variable mWaitFramStartProc          as datetime-tz no-undo.
      395   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      396   define button B-WaitFramStop auto-end-key
      397        label "Стоп"
      398        size 10 by 1 tooltip "Остоновить процесс".
      399   define button B-viewProcInfo
      400        label "Информация"
      401        size 15 by 1 tooltip "Информация о процесс".
      402   define frame waitfram
      403     v-waitfram-action01 format "x(72)" no-label skip
      404     v-waitfram-action02 format "x(72)" no-label skip
      405     v-waitfram-action03 format "x(72)" no-label skip
      406     B-viewProcInfo
      407     B-WaitFramStop at row 4 col 30
      408     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      409     .
      410   define new global shared variable mBatchMode as logical no-undo init ?.
      411   define variable mFramBachModHandle as handle no-undo.
      412   mFramBachModHandle = frame waitfram:handle.
      413   define variable mFameOldVis as logical no-undo.
      414   define variable mVisCUrentVin as logical no-undo.
      415   if session:batch-mode
      416   then
      417      mBatchMode = yes.
      418   if mBatchMode = ? then do:
      419     mVisCUrentVin = current-window:visible.
      420     mFameOldVis = mFramBachModHandle:visible.
      421     mFramBachModHandle:visible  = yes.
      422     mBatchMode = mFramBachModHandle:visible ne yes.
      423     mFramBachModHandle:visible = mFameOldVis.
      424     current-window:visible = mVisCUrentVin.
      425   end.
      426    if  log-manager:logfile-name ne ?
      427     then DO:
      428         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      429         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      430         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      431     end.
      432   on choose of B-WaitFramStop in frame waitfram
      433   do:
      434     mWaitFramStop = yes.
      435     mWaitFramStopUser = yes.
      436   end.
      437   function waitfram-check-timeout returns logical():
      438      define variable vtime as int64 no-undo.
      439      if mWaitFramStopTimeOut
      440      then
      441         return yes.
      442      vtime = ( now - mWaitFramStartProc ) / 1000 .
      443      if     mWaitFramTimeOut ne ?
      444         and mWaitFramTimeOut ne 0
      445         and mWaitFramTimeOut lt vtime
      446      then do:
      447         mWaitFramStopTimeOut = yes.
      448      end.
      449      return mWaitFramStopTimeOut.
      450   end.
      451   procedure waitfram-hide :
      452     if not session:batch-mode
      453     then do
      454     on error undo, return error return-value
      455     :
      456       pause 0 before-hide .
      457       if not mBatchMode then
      458         hide frame waitfram .
      459     if     not mWaitFramView
      460        and mWaitProcEvent
      461     then
      462       process events .
      463     end.
      464   end procedure.
      465   procedure waitfram-show :
      466     define input  parameter p-message as character no-undo .
      467     define variable v-left-margin as integer   no-undo .
      468     if not session:batch-mode
      469     then do
      470     on error undo, return error return-value
      471     :
      472       if length(p-message) <= 70 then do:
      473         assign
      474           v-left-margin = integer((70 - length(p-message)) / 2)
      475         .
      476         assign
      477           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      478         .
      479         assign
      480           v-waitfram-action01 = " "
      481           v-waitfram-action02 = " "
      482                                    + fill(" ", v-left-margin)
      483                                    + p-message
      484           v-waitfram-action03 = " "
      485         .
      486       end.
      487       else do:
      488         define variable vRindex1 as integer no-undo.
      489         define variable vRindex2 as integer no-undo.
      490         vRindex1 = r-index(p-message," ",70).
      491         if vRindex1 = 0
      492         then
      493            vRindex1 = 70.
      494         if length(p-message)  <= vRindex1 + 70 then do:
      495           assign
      496             v-waitfram-action01 = " "
      497             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      498             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      499           .
      500         end.
      501         else do:
      502           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      503           if vRindex2 <= vRindex1
      504           then
      505              vRindex2 = vRindex1 + 70.
      506           assign
      507             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      508             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      509             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      510           .
      511         end.
      512       end.
      513       B-viewProcInfo:visible   in frame waitfram = no.
      514       B-viewProcInfo:sensitive in frame waitfram = no.
      515       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      516       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      517       if  (   mWaitFramView
      518          or  mWaitProcEvent)
      519          and not mBatchMode
      520       then
      521          display
      522             v-waitfram-action01 skip
      523             v-waitfram-action02 skip
      524             v-waitfram-action03 skip
      525          with frame waitfram .
      526       if     mWaitFramView
      527          then do:
      528             if     mWaitFramInterval ne ?
      529                and not mBatchMode
      530             then
      531                wait-for go of frame waitfram pause mWaitFramInterval.
      532          end.
      533          else
      534             if     mWaitProcEvent
      535                and not mBatchMode
      536             then
      537                process events .
      538     end.
      539   end procedure.
      540      procedure waitfram-show-this:
      541         define input  parameter iInterval as int64 no-undo.
      542         define variable vtime as int64 no-undo.
      543         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      544         mWaitFramInterval = iInterval.
      545         run waitfram-show (substitute("&1&2 &3&4" ,
      546                                       mWaitFramTextBeg ,
      547                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      548                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      549                                       mWaitFramTextEnd
      550                                      )
      551                           ).
      552      end.
      553      procedure WaitFramRunPause:
      554         define input  parameter iInterval as dec no-undo.
      555         define variable vStart  as datetime-tz no-undo.
      556         define variable vend    as datetime-tz no-undo.
      557         define variable vint as int64 no-undo.
      558         define variable vOk as logical no-undo.
      559         vStart = now.
      560         vend   = vStart.
      561         publish "WaitFramPause" (iInterval,output vOk).
      562         vend   =  now.
      563         vint = vend - vStart.
      564         vint = iInterval - vint / 1000.
      565         if     not mWaitFramStop
      566            and (   vint > 0
      567                 or (    not vOk
      568                     and iInterval eq ?
      569                     )
      570                 )
      571         then
      572            run waitfram-show-this (iInterval).
      573         vend   =  now.
      574         vint = vend - vStart.
      575         vint = iInterval - vint / 1000.
      576         if     not mWaitFramStop
      577            and vint > 0
      578         then do:
      579            run gbl/pause.p (vint * 1000).
      580         end.
      581         if iInterval ne ?
      582         then
      583            publish "WaitFramStop".
      584         waitfram-check-timeout().
      585      end.
      586      procedure WaitFramWaitFor:
      587         define input  parameter iInterval as dec no-undo.
      588         assign
      589            mWaitFramStartProc   = now
      590            mWaitFramStopUser    = no
      591            mWaitFramStopTimeOut = no
      592         .
      593         block-wait:
      594         do while not mWaitFramStop:
      595            run WaitFramRunPause (iInterval).
      596            if  waitfram-check-timeout()
      597            then do:
      598               leave block-wait.
      599            end.
      600         end.
      601         run waitfram-hide.
      602      end.
      603   procedure waitfram-join :
      604     define input  parameter p-line-1  as character no-undo .
      605     define input  parameter p-line-2  as character no-undo .
      606     define input  parameter p-line-3  as character no-undo .
      607     define output parameter p-message as character no-undo .
      608     do
      609     on error undo, return error return-value
      610     :
      611       assign
      612         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      613                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      614                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      615       .
      616     end.
      617   end procedure.
      618   function waitfram-join-function returns character
      619     (input p-line-1 as character
      620     ,input p-line-2 as character
      621     ,input p-line-3 as character
      622     ).
      623     define variable v-message as character no-undo .
      624     run waitfram-join in this-procedure
      625       (input  p-line-1
      626       ,input  p-line-2
      627       ,input  p-line-3
      628       ,output v-message
      629       ) .
      630     return v-message .
      631   end function .
      632   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      633   procedure fltfield-clear :
      634     define output parameter loc-fld as character no-undo.
      635     define output parameter loc-lab as character no-undo .
      636     define output parameter loc-spr as character no-undo .
      637     define output parameter loc-dim as character no-undo .
      638     assign
      639       loc-fld = ""
      640       loc-lab = ""
      641       loc-spr = ""
      642       loc-dim = "0"
      643     .
      644   end procedure .
      645   procedure fltfield-add :
      646     define input        parameter par-fld as character no-undo.
      647     define input        parameter par-lab as character no-undo .
      648     define input        parameter par-spr as character no-undo .
      649     define input-output parameter loc-fld as character no-undo.
      650     define input-output parameter loc-lab as character no-undo .
      651     define input-output parameter loc-spr as character no-undo .
      652     define input-output parameter loc-dim as character no-undo .
      653     do
      654     on error undo, return error
      655     :
      656       assign
      657       loc-fld = if loc-dim = '0'
      658                 then par-fld
      659                 else (loc-fld + chr(44) + par-fld)
      660       loc-lab = if loc-dim = '0'
      661                 then par-lab
      662                 else (loc-lab + chr(44) + par-lab)
      663       loc-spr = if loc-dim = '0'
      664                 then par-spr
      665                 else (loc-spr + chr(44) + par-spr)
      666       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
      667                 string(integer(if num-entries(loc-dim) > 1
      668                               then entry(2, loc-dim)
      669                               else entry(1, loc-dim)
      670                               ) + 1)
      671       no-error
      672       .
      673     end.
      674   end procedure.
      675   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      676   define  stream PrnLibStream.
      677   procedure prn-lib-prn-file :
      678     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      679     define input parameter p-DIsabledoptions as integer no-undo .
      680     define variable v-report-name as character no-undo .
      681     define variable v-user-action as character no-undo .
      682     define variable v-printed     as logical   no-undo .
      683     define variable v-exist       as logical   no-undo .
      684     do
      685       on error undo, return error
      686       :
      687       run prn-lib-get-report-name  in this-procedure (
      688         input parParentProc
      689         ,output v-report-name
      690         ).
      691   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      692   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      693     (input  v-report-name
      694     ,input  2
      695     ,output v-exist
      696     )  .
      697       if NOT v-exist then
      698       DO:
      699         Message
      700           "Нет заданий на печать ! "
      701           view-as alert-box .
      702         Return  .
      703       End.
      704       run gbl/prnfilen.w
      705         (input  ""
      706         ,input  p-DisabledOptions
      707         ,input  string(v-report-name )
      708         ,input  7
      709         ,output v-user-action
      710         ,output v-printed
      711         ) .
      712       if v-printed then
      713       do:
      714         return "YES" .
      715       end.
      716       else
      717       do:
      718         return "NO" .
      719       end.
      720     end.
      721   end procedure.
      722   procedure prn-lib-open-stream :
      723     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      724     define input parameter p-page-size    as integer no-undo .
      725     define input parameter p-is-stream    as logical no-undo .
      726     define input parameter p-append       as logical no-undo .
      727     define variable v-report-name as character no-undo .
      728     do
      729       on error undo, return error
      730       :
      731       run prn-lib-get-report-name  in this-procedure (
      732         input parParentProc
      733         ,output v-report-name
      734         ).
      735       if p-is-stream then
      736       do:
      737         if p-append then
      738         do:
      739           output stream PrnLibStream to value( v-report-name )
      740             page-size value(p-page-size) append .
      741         end.
      742         if not p-append then
      743         do:
      744           output stream PrnLibStream to value( v-report-name )
      745             page-size value(p-page-size) .
      746         end.
      747       end.
      748       if not p-is-stream then
      749       do:
      750         if p-append then
      751         do:
      752           output to value( v-report-name )
      753             page-size value(p-page-size) append .
      754         end.
      755         if not p-append then
      756         do:
      757           output to value( v-report-name )
      758             page-size value(p-page-size) .
      759         end.
      760       end.
      761     end.
      762   end procedure.
      763   procedure prn-lib-open-exp :
      764     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      765     define input parameter p-is-stream    as logical no-undo .
      766     define input parameter p-is-append    as logical no-undo .
      767     define output parameter p-ReportFileName as char init "report" no-undo.
      768     define output parameter p-process as logical no-undo .
      769     define variable glog as logical no-undo .
      770     do
      771       on error undo, return error
      772       :
      773       SYSTEM-DIALOG GET-FILE p-ReportFileName
      774         TITLE      "Укажите путь"
      775         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      776         ASK-OVERWRITE
      777         CREATE-TEST-FILE
      778         SAVE-AS
      779         USE-FILENAME
      780         DEFAULT-EXTENSION "txt"
      781         UPDATE glog
      782         .
      783       if not glog then  return.
      784       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      785       if p-is-stream then
      786       do:
      787         if p-is-append then
      788         do:
      789           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      790         end.
      791         else
      792         do:
      793           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      794         end.
      795       end.
      796       else
      797       do:
      798         if p-is-append then
      799         do:
      800           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      801         end.
      802         else
      803         do:
      804           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      805         end.
      806       end.
      807       p-process = yes.
      808     end.
      809   end procedure.
      810   procedure prn-lib-get-report-name :
      811     define input parameter parParentProc  as widget-handle no-undo.
      812     define output parameter p-report-name as character no-undo .
      813     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      814   end procedure.
      815   procedure prn-lib-reportviewer-report-name :
      816     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      817     define input parameter p-report-name-html as character no-undo .
      818     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
