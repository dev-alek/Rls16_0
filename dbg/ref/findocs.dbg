     2404   ON VALUE-CHANGED OF RS-list IN FRAME Dialog-Frame
     2405   DO:
     2406   define variable i-rs-list like rs-list no-undo .
     2407   define variable old-rs-list like rs-list no-undo .
     2408   define variable rid-list as character no-undo.
     2409   define buffer buf_fin-code-cor-acc for ub.fin-code-cor-acc.
     2410   define buffer buf_fin-code-cel-nazn for ub.fin-code-cel-nazn.
     2411   define buffer buf_fin-code-an-uchet for ub.fin-code-an-uchet.
     2412   assign
     2413   old-rs-list = rs-list
     2414   i-rs-list = input frame Dialog-Frame rs-list .
     2415   CASE i-rs-list :
     2416       when 'все':U then do:
     2417           assign
     2418           rs-list
     2419           p-list = rs-list
     2420           v-for-title = "":U
     2421           .
     2422       end.
     2423       when 'cor-acc':U or when 'cor-acc1':U then do:
     2424           rid-list = "":U .
     2425           run ref/fwcode-1.w (
     2426                           input parParentProc
     2427                         ,input "b-sel"
     2428                         ,input (if p-mode = 'все':U then 'все':U  else 'фирма':U)
     2429                         ,input ?
     2430                         ,input p-curr-host-code
     2431                         ,output rid-list ).
     2432           if rid-list <> "":U then do:
     2433               FIND FIRST buf_fin-code-cor-acc WHERE
     2434                   recid( buf_fin-code-cor-acc ) = integer(entry(1, rid-list)) NO-LOCK .
     2435               assign
     2436               p-cor-acc = (if i-rs-list = 'cor-acc':U
     2437                           then buf_fin-code-cor-acc.fin-code
     2438                           else 0)
     2439               p-cor-acc1 = (if i-rs-list = 'cor-acc1':U
     2440                           then buf_fin-code-cor-acc.fin-code
     2441                           else 0)
     2442               rs-list
     2443               p-list =  rs-list
     2444               v-for-title = (if i-rs-list = 'cor-acc':U
     2445                              then "Корреспонд. счет"
     2446                              else "Код кассы")
     2447                              + chr(32) + buf_fin-code-cor-acc.code-value
     2448               .
     2449           end.
     2450           else do:
     2451               assign
     2452               rs-list:screen-value = old-rs-list.
     2453               return no-apply.
     2454           end.
     2455       end.
     2456       when 'an-uchet-code':U then do:
     2457           rid-list = "":U .
     2458           run ref/fwcode-3.w (
     2459                           input  parParentProc
     2460                          ,input "b-sel"
     2461                          ,input (if p-mode = 'все':U then 'все':U  else 'фирма':U)
     2462                          ,input ?
     2463                          ,input p-curr-host-code
     2464                          ,output rid-list ).
     2465           if rid-list <> "":U then do:
     2466               FIND FIRST buf_fin-code-an-uchet WHERE
     2467                    recid( buf_fin-code-an-uchet ) = integer(entry(1, rid-list)) NO-LOCK .
     2468               assign
     2469               p-an-uchet-code = buf_fin-code-an-uchet.fin-code
     2470               rs-list
     2471               p-list =  rs-list
     2472              v-for-title = "Код ан. учета" + chr(32) + buf_fin-code-an-uchet.code-value
     2473               .
     2474           end.
     2475           else do:
     2476              assign
     2477               rs-list:screen-value = old-rs-list.
     2478               return no-apply.
     2479           end.
     2480       end.
     2481       when 'cel-nazn-code':U then do:
     2482               rid-list = "":U .
     2483           run ref/fwcode-2.w (
     2484                            parParentProc
     2485                          ,"b-sel"
     2486                          ,(if p-mode = 'все':U then 'все':U  else 'фирма':U)
     2487                          ,input ?
     2488                          ,input p-curr-host-code
     2489                          ,output rid-list ).
     2490           if rid-list <> "":U then do:
     2491               FIND FIRST buf_fin-code-cel-nazn WHERE
     2492                    recid( buf_fin-code-cel-nazn ) = integer(entry(1, rid-list)) NO-LOCK .
     2493               assign
     2494               p-cel-nazn-code = buf_fin-code-cel-nazn.fin-code
     2495               rs-list
     2496               p-list =  rs-list
     2497               v-for-title = "Код целев.назнач." + chr(32) + buf_fin-code-cel-nazn.code-value
     2498               .
     2499           end.
     2500           else do:
     2501              assign
     2502               rs-list:screen-value = old-rs-list.
     2503               return no-apply.
     2504           end.
     2505       end.
     2506   END CASE.
     2507   RUn OpenBR in this-procedure ( input yes, input no, input '':U).
     2508   END.
