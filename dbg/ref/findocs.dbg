     3918           b-sch :tooltip = "Установлен фильтр " + p-filter-name
     3919         .
     3920       end.
     3921       else do:
     3922         assign
     3923           b-sch :tooltip = ""
     3924         .
     3925       end.
     3926     end.
     3927   end procedure.
     3928   def var sort-labelbr-fin-doc   as character no-undo .
     3929   def var sort-clmnbr-fin-doc    as handle    no-undo .
     3930   def var cur-clmnbr-fin-doc     as handle    no-undo .
     3931   def var cur-clmn-locbr-fin-doc as integer   no-undo .
     3932   def var re-querybr-fin-doc     as logical   initial no no-undo .
     3933   on start-search, ctrl-o of br-fin-doc in frame Dialog-Frame do:
     3934      run sort-brbr-fin-doc
     3935        (input (if available X_fin-doc
     3936                then recid(X_fin-doc)
     3937                else ?
     3938               )
     3939        ).
     3940   end.
     3941   PROCEDURE sort-brbr-fin-doc :
     3942     define input parameter p-recid as recid no-undo .
     3943     if re-querybr-fin-doc = no then do:
     3944       assign
     3945          cur-clmnbr-fin-doc = br-fin-doc:current-column in frame Dialog-Frame
     3946       .
     3947       if sort-clmnbr-fin-doc <> ? then sort-clmnbr-fin-doc:column-fgcolor = 0.
     3948       if cur-clmnbr-fin-doc = sort-clmnbr-fin-doc then do:
     3949         assign
     3950            sort-labelbr-fin-doc = ""
     3951            sort-clmnbr-fin-doc = ?
     3952         .
     3953        end.
     3954        else do:
     3955          assign
     3956            sort-labelbr-fin-doc = cur-clmnbr-fin-doc:label
     3957            sort-clmnbr-fin-doc  = cur-clmnbr-fin-doc
     3958            sort-clmnbr-fin-doc:column-fgcolor = 4
     3959          .
     3960        end.
     3961      end.
     3962     assign
     3963       cur-clmn-locbr-fin-doc = 1
     3964     .
     3965     def var column-handle as handle no-undo .
     3966     column-handle = br-fin-doc:first-column.
     3967     do while valid-handle(column-handle) :
     3968       if column-handle = cur-clmnbr-fin-doc then do:
     3969         leave .
     3970       end.
     3971       column-handle = column-handle:NEXT-COLUMN.
     3972       assign
     3973         cur-clmn-locbr-fin-doc = cur-clmn-locbr-fin-doc + 1
     3974       .
     3975     end.
     3976     case sort-labelbr-fin-doc:
     3977           when X_fin-doc.prn-doc-code:label in browse br-fin-doc then DO:   assign     sort-column-name = "X_fin-doc.prn-doc-code"   .   run OpenBr in this-procedure ( input yes, input no, input '':U).   . END.
     3978       otherwise do:
     3979         assign
     3980           sort-column-name = ""
     3981         .
     3982         run OpenBr in this-procedure ( input  yes, input no, input '':U ).
     3983           if can-do( this-procedure:internal-entries, 'mv-brw-defaultbr-fin-doc') then do:
     3984             run mv-brw-defaultbr-fin-doc.
     3985           end.
     3986         if sort-labelbr-fin-doc <> "" then do:
     3987           assign
     3988             cur-clmnbr-fin-doc:column-fgcolor = 0
     3989           .
     3990         end.
     3991         assign
     3992           cur-clmn-locbr-fin-doc = ?
     3993         .
     3994       end.
     3995     end case.
     3996       if cur-clmn-locbr-fin-doc <> ? then do:
     3997         if can-do( this-procedure:internal-entries, 'ch-clmnbr-fin-doc') then do:
     3998           run ch-clmnbr-fin-doc in this-procedure (cur-clmn-locbr-fin-doc).
     3999         end.
     4000       end.
     4001     if p-recid <> ? then do:
     4002       reposition br-fin-doc to recid p-recid no-error.
     4003       apply "value-changed" to br-fin-doc in frame Dialog-Frame.
     4004     end.
     4005     apply "entry" to br-fin-doc in frame Dialog-Frame.
     4006   END PROCEDURE.
     4007   procedure re-open-query-srt-clmnbr-fin-doc:
     4008   if cur-clmnbr-fin-doc = ? then do:
     4009      run OpenBr in this-procedure ( input  yes, input no, input '':U ).
     4010   end.
     4011   else do:
     4012      assign re-querybr-fin-doc = yes.
     4013      run sort-brbr-fin-doc
     4014        (input (if available X_fin-doc
     4015                then recid(X_fin-doc)
     4016                else ?
     4017               )
     4018        ).
     4019      assign re-querybr-fin-doc = no.
     4020   end.
     4021   end.
