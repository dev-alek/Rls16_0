     6381               run ref/findoci5.w
     6382                             (
     6383                               input parParentProc
     6384                               ,input p-curr-host-code
     6385                               ,input p-change-mode
     6386                               ,input X_fin-doc.host-code
     6387                               ,input X_fin-doc.fin-doc-code
     6388                               ,input X_fin-doc.obj-type
