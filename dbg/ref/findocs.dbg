     2204   ON CHOOSE OF B-schet IN FRAME Dialog-Frame
     2205   DO:
     2206   define variable loc-doc-rec as recid no-undo.
     2207   if not available X_fin-doc then return no-apply.
     2208   if schet-option = '':U then do:
     2209     run gbl/pop-up.p ( input  self:handle, no) no-error.
     2210   end.
     2211   if schet-option = '':U then return no-apply.
     2212   if X_fin-doc.fin-doc-type = 'пко':U
     2213   or X_fin-doc.fin-doc-type = 'апп':U
     2214   or X_fin-doc.fin-doc-type = 'рко':U
     2215   or X_fin-doc.fin-doc-type = 'апр':U
     2216   then do:
     2217     message
     2218     "Нельзя посмотреть счет по платежу" skip
     2219     "платеж имеет тип" entry (lookup (X_fin-doc.fin-doc-type, 'пко,рко,ппп,рпп,апп,апр':U) + 1, ',':U + 'приходный кассовый ордер,расходный кассовый ордер,приходное платежное поручение,расходное платежное поручение,приходный АПЗ,расходный АПЗ':U)
     2220     view-as alert-box.
     2221     return no-apply.
     2222   end.
     2223   run ref/finschti.w
     2224                 (
     2225                    input parParentProc
     2226                   ,input p-curr-host-code
     2227                   ,input 'ПРОСМОТР':U
     2228                   ,input X_fin-doc.host-code
     2229                   ,input (if schet-option = "payer":U
     2230                           then X_fin-doc.payer-code-schet
     2231                           else X_fin-doc.receiver-code-schet )
     2232                   ,input 0
     2233                   ,input (if schet-option = "payer":U
     2234                          then X_fin-doc.payer-type
     2235                          else X_fin-doc.receiver-type)
     2236                   ,input (if schet-option = "payer":U
     2237                          then X_fin-doc.payer-code
     2238                          else X_fin-doc.receiver-code)
     2239                   ,input X_fin-doc.curr-code
     2240                   ,input-output loc-doc-rec
     2241                               )
     2242   .
     2243    schet-option = '':U.
     2244    APPLY "ENTRY" to br-fin-doc.
     2245   END.
