     2168     end.
     2169     if print-option = '':U then return no-apply.
     2170     run proc-b-print in this-procedure ( input print-option) no-error.
     2171     if error-status:error then do:
     2172       print-option = '':U.
     2173       return no-apply.
     2174     end.
     2175     APPLY "ENTRY" to br-fin-doc.
     2176   END.
