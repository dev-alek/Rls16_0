       12   define input parameter p-obj-code  like ub.fin-doc.obj-code no-undo .
       13   define input parameter p-status_ like ub.fin-doc.status_ no-undo.
       14   define input parameter p-fin-doc-type like ub.fin-doc.fin-doc-type no-undo.
       15   define input parameter p-fin-ext-doc-type like ub.fin-doc.fin-ext-doc-type no-undo.
       16   define input parameter p-start-date   like ub.fin-doc.doc-date no-undo .
       17   define input parameter p-end-date   like ub.fin-doc.doc-date no-undo .
