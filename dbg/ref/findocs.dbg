     7564   if not ok then return error.
     7565   ok = no.
     7566   message
     7567   v-ask-message skip(1)
     7568   (if t-batch
     7569   then
     7570   substitute("Все платежи, которые Вы отметили, но которые к настоящему моменту не находятся в статусе <&1>,&2 &3 обработаны не будут "
     7571               , v-old-status_
     7572               , chr(10)
     7573               , (if is-type-mode = no
     7574                 then substitute("или не имеют типа <&1>,", v-fin-doc-type)
     7575                 else "":U)
     7576               )
     7577     else "":U
     7578   )
     7579   view-as alert-box QUESTION buttons Yes-NO update ok.
     7580   if not ok then return error.
     7581   if v-ask-date then do:
     7582     run cur-time in this-procedure ( output v-date, output v-time).
     7583     assign
     7584     v-status-date-chr = string(v-date, "99/99/9999":U)
     7585     .
     7586     run gbl/d-prompt.w (
     7587         'title=':u + "Введите дату смены статуса платежа" + '\':u
     7588       + 'text1=':u + "Дата смены статуса" + '\':u
     7589       + 'format=99/99/9999\'
     7590       + 'type=' + 'T':U + '\':u
     7591       + 'fillin_row=2\':u
     7592       + 'fillin_col=4\':u
     7593       + 'fillin_width=20\':u
     7594       + 'fillin_height=1\':u
     7595       + 'max-chars=70\':u
     7596       + 'readonly=no\'
     7597       , input-output v-status-date-chr
     7598       ).
     7599     if return-value = 'false':u then return error.
     7600     assign
     7601     v-date = date(integer(substr(v-status-date-chr, 4, 2)),
     7602                   integer(substr(v-status-date-chr, 1, 2)),
     7603                   integer(substr(v-status-date-chr, 7, 4))
     7604                  )
     7605     no-error .
     7606     if error-status:error then do:
     7607       message
     7608       "Неверная дата для смены статуса"
     7609       view-as alert-box error .
     7610       return error.
     7611     end.
     7612   end.
     7613   else do:
     7614     DEFINE VARIABLE v-today as date no-undo .
     7615     DEFINE VARIABLE v-to-time as integer no-undo .
     7616     if not (buf_fin-doc.obj-type = ''
     7617     and buf_fin-doc.obj-code = 0) then do:
     7618   define variable vss-include-info69 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7619   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
     7620     (input  buf_fin-doc.obj-type
     7621     ,input  buf_fin-doc.obj-code
     7622     ,output v-today
     7623     ) no-error .
     7624     end.
     7625     else do:
     7626       run cur-time in this-procedure ( output v-today, output v-to-time).
     7627     end.
     7628     if buf_fin-doc.doc-date = v-today
     7629     then do:
     7630     end.
     7631     else do:
     7632     message
     7633     "Дата смены статуса платежа будет установлена равной дате составления документа"
     7634     view-as alert-box QUESTION buttons YES-no update glog.
     7635     if not glog then undo, return error .
     7636   end.
     7637   end.
     7638   run waitfram-show in this-procedure ( input "Ждите..." ).
     7639   CASE t-batch:
     7640     when no then do:
     7641       define variable v-date1 as date no-undo .
     7642       v-date1 = (if v-ask-date then v-date else buf_fin-doc.doc-date).
     7643       run trg/findstat.p (
     7644                        input parparentproc
     7645                       ,input buf_fin-doc.host-code
     7646                       ,input buf_fin-doc.fin-doc-code
     7647                       ,input p-close-mode
     7648                       ,input '':U
     7649                       ,input v-status_
     7650                       ,input-output v-date1
     7651                       ,input no
     7652                      ) no-error .
     7653       if error-status:error then do:
     7654         run waitfram-hide in this-procedure .
     7655         if error-status:get-message(1) <> "":u then
     7656         message
     7657         error-status:get-message(1)  skip
     7658         return-value view-as alert-box .
     7659         return error .
     7660       end.
     7661       run waitfram-hide in this-procedure .
     7662       RUN OpenBr in this-procedure ( input yes, input no, input '':U).
     7663       reposition br-fin-doc to recid v-doc-rec No-ERROR.
     7664     end.
     7665     when yes then do:
     7666       _do1:
     7667       do ii = 1 to num-entries(v-rid-list):
     7668         run waitfram-show in this-procedure ( substitute("Обрабатывается &1 платеж списка", ii)).
     7669         find first buf_fin-doc where
     7670                   recid(buf_fin-doc) = integer(entry(ii, v-rid-list)) exclusive-lock no-error .
     7671         if not avail buf_fin-doc
     7672         or (avail buf_fin-doc and buf_fin-doc.status_ <> v-old-status_)
     7673         or (avail buf_fin-doc and buf_fin-doc.fin-doc-type <> v-fin-doc-type)
     7674         then DO:
     7675           assign
     7676           v-new-rid-list = v-new-rid-list + (if v-new-rid-list = "":U then "":U else chr(44)) + entry(ii, v-rid-list)
     7677           .
     7678           NEXT _do1.
     7679         END.
     7680         run trg/findstat.p (
     7681                          input parparentproc
     7682                         ,input buf_fin-doc.host-code
     7683                         ,input buf_fin-doc.fin-doc-code
     7684                         ,input p-close-mode
     7685                         ,input '':U
     7686                         ,input v-status_
     7687                         ,input-output v-date
     7688                         ,input no
     7689                       ) no-error .
     7690         if error-status:error then do:
     7691           assign
     7692           v-new-rid-list = v-new-rid-list + (if v-new-rid-list = "":U then "":U else chr(44)) + entry(ii, v-rid-list)
     7693           .
     7694           NEXT _do1 .
     7695         end.
     7696         assign
     7697         ok-ii = ok-ii + 1
     7698         v-new-rid-list = v-new-rid-list
     7699         .
     7700       end.
     7701       run waitfram-hide in this-procedure .
     7702       assign
     7703       v-rid-list = v-new-rid-list
     7704       .
     7705       RUN OpenBr in this-procedure ( input yes, input no, input '':U).
     7706       reposition br-fin-doc to recid v-doc-rec No-ERROR.
     7707       message
     7708       substitute("Из &1 выбранных Вами платежей удалось сменить статус на &2 у &3 платежей", ii - 1, v-status_, ok-ii)
     7709       view-as alert-box.
     7710     end.
     7711   END CASE.
     7712   END PROCEDURE.
     7713   PROCEDURE proc-factura :
     7714   do on error undo, return error return-value :
     7715   define buffer bf_fin-doc  for ub.fin-doc .
     7716   define variable vari as integer no-undo.
     7717   define variable vardoc-code as integer no-undo.
     7718   define variable v-loc-rid-list as character no-undo .
     7719       if factura-option = "option-lkp":U then do:
     7720           run str/s-f-docs.w
     7721             ( input parparentproc
     7722               ,input v-cntxt-host-code-obj
     7723               ,input ?
     7724               ,input ?
     7725               ,input ?
     7726               ,input "fd"
     7727               ,input X_fin-doc.fin-doc-type
     7728               ,input X_fin-doc.fin-doc-code
     7729               ,input ""
     7730               ,input "in-doc"
     7731               ,input-output v-loc-rid-list
     7732               ) .
     7733       end.
     7734       else do:
     7735       if factura-option = "option1":U then do:
     7736         if t-batch = no then do:
     7737           message "Не выделено ни одного ФО для генерации счетов-фактур !".
     7738           return error .
     7739         end.
     7740         define variable varlog as logical   no-undo .
     7741         varlog = yes.
     7742         message
     7743         substitute("Выбрано &1 платежей . Провести генерацию счетов-фактур?&2"
     7744                    ,num-entries( v-rid-list)
     7745                    ,chr(10)
     7746                    )
     7747         view-as alert-box question buttons OK-Cancel update varlog.
     7748         if not varlog then return no-apply.
     7749         do vari = 1 to num-entries (v-rid-list):
     7750           assign vardoc-code = integer(entry (vari, v-rid-list)).
     7751           find first bf_fin-doc where recid(bf_fin-doc) = vardoc-code no-lock.
     7752           if bf_fin-doc.status_ <> 'факт':U then do:
     7753             message
     7754             substitute("Документ &1 статус &2 не в статусе &3 . Пропускаем."
     7755                        ,bf_fin-doc.prn-doc-code
     7756                        ,bf_fin-doc.status_
     7757                        ,'факт':U)
     7758             view-as alert-box.
     7759             next .
     7760           end.
     7761           if bf_fin-doc.cr-factur = yes then do:
     7762             message
     7763             substitute("По документу &1 уже создавался счет-фактура от &2."
     7764                       ,bf_fin-doc.prn-doc-code
     7765                       ,string(bf_fin-doc.factur-date, "99/99/9999"))
     7766             view-as alert-box.
     7767           end.
     7768           else do:
     7769             if bf_fin-doc.need-factur = 1 or bf_fin-doc.need-factur = 2 then do :
     7770               define variable v-list as character no-undo .
     7771               run str/gen-scf.p ( input parParentProc, input vardoc-code, input "fin-doc", output v-list) no-error .
     7772               if error-status:error then message
     7773               substitute("Ошибка создания счета-фактуры по платежу &1"
     7774                        , bf_fin-doc.prn-doc-code)
     7775               return-value view-as alert-box.
     7776               assign v-rid-list = "" .
     7777             end.
     7778             else do:
     7779               message "Данный документ не нуждался в генерации счета-фактуры." view-as alert-box.
     7780             end.
     7781           end.
     7782         end.
     7783       end.
     7784       else do:
     7785         if v-rid-list = "" then do:
     7786           if available X_fin-doc then assign v-rid-list = string(recid(X_fin-doc)).
     7787         end.
     7788   vari-cycle:
     7789         do vari = 1 to num-entries (v-rid-list):
     7790           find first bf_fin-doc where recid(bf_fin-doc) = integer(entry (vari, v-rid-list)) exclusive-lock.
     7791           if bf_fin-doc.status_ <> 'факт':U then do:
     7792             message
     7793             substitute("Документ &1 не в статусе &2. Пропускаем."
     7794                        ,bf_fin-doc.status_
     7795                        ,'факт':U
     7796                        )
     7797             view-as alert-box.
     7798             next vari-cycle.
     7799           end.
     7800           if bf_fin-doc.user-db-num-doc <> v-db-num then do:
     7801             message
     7802             substitute("БД документа с кодом &1 не coвпадает с текущей БД.&2" +
     7803                        "Текущая БД: &3&2БД док-та: &4&2.Пропускаем."
     7804                       ,bf_fin-doc.fin-doc-code
     7805                       ,chr(10)
     7806                       ,v-db-num
     7807                       ,bf_fin-doc.user-db-num-doc
     7808                       )
     7809             view-as alert-box error.
     7810             next vari-cycle.
     7811           end.
     7812           case factura-option :
     7813             when "option2":U then do:
     7814               if bf_fin-doc.cr-factur = yes then do:
     7815                 message
     7816                 substitute("По документу &1 уже генерился счет-фактура от &2."
     7817                          ,bf_fin-doc.fin-doc-code
     7818                          ,bf_fin-doc.factur-date
     7819                          )
     7820                 view-as alert-box.
     7821                 next vari-cycle.
     7822               end.
     7823               else do:
     7824                 if bf_fin-doc.need-factur = 1 or bf_fin-doc.need-factur = 2 then assign  bf_fin-doc.need-factur = 0.
     7825                 else do:
     7826                   message
     7827                   "Данный документ не нуждался в генерации счета-фактуры."
     7828                   view-as alert-box.
     7829                   next vari-cycle.
     7830                 end.
     7831                 reposition br-fin-doc to recid recid(bf_fin-doc) no-error.
     7832               end.
     7833             end.
     7834             when "option3":U then do:
     7835               if bf_fin-doc.cr-factur = yes then do:
     7836                 assign varlog = no.
     7837                 message
     7838                 substitute("По документу &1 был создан счет-фактура от &2.&3" +
     7839                            "Вы действительно хотите снять признак, что по этому документу был счет-фактура?"
     7840                           ,bf_fin-doc.fin-doc-code
     7841                           ,string(bf_fin-doc.factur-date, "99/99/9999")
     7842                           ,chr(10))
     7843                 view-as alert-box question buttons yes-no update varlog.
     7844                 if varlog <> yes then  next vari-cycle.
     7845                 assign
     7846                   bf_fin-doc.cr-factur   = no
     7847                   bf_fin-doc.factur-date = 01/01/1990
     7848                 .
     7849                 reposition br-fin-doc to recid recid(bf_fin-doc) no-error.
     7850               end.
     7851               else message
     7852                    substitute("По документу &1 не было генерации."
     7853                              , bf_fin-doc.fin-doc-code)
     7854                    view-as alert-box.
     7855             end.
     7856             when "option4":U then do:
     7857               if bf_fin-doc.need-factur = 2 then do:
     7858                 if bf_fin-doc.contract-code <> 0 then do:
     7859                   if X_contract.gen-factur = 3 or X_contract.gen-factur = 13 or X_contract.gen-factur = 103 or X_contract.gen-factur = 113 then do:
     7860                     assign bf_fin-doc.need-factur = 1  .
     7861                     reposition br-fin-doc to recid recid(bf_fin-doc) no-error.
     7862                   end.
     7863                   else message
     7864                        substitute("По документу &1 нет договоров для генерации счета-фактуры."
     7865                                   ,bf_fin-doc.fin-doc-code
     7866                                   )
     7867                        view-as alert-box.
     7868                 end.
     7869               end.
     7870               else do:
     7871                 message
     7872                 substitute("Документ &1 не имеет признака 'не опред' генерация счета-фактуры."
     7873                            ,bf_fin-doc.fin-doc-code)
     7874                 view-as alert-box.
     7875                 next vari-cycle.
     7876               end.
     7877             end.
     7878           end.
     7879         end.
     7880       end.
     7881     end.
     7882     end.
     7883   end procedure.
     7884   PROCEDURE proc-find-bik :
