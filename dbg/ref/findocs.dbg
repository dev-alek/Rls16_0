     6331                               ,input p-change-mode
     6332                               ,input X_fin-doc.host-code
     6333                               ,input X_fin-doc.fin-doc-code
     6334                               ,input X_fin-doc.obj-type
     6335                               ,input X_fin-doc.obj-code
     6336                               ,input X_fin-doc.fin-ext-doc-type
     6337                               ,input 0
     6338                               ,input '':U
