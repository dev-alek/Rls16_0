      961   procedure uf-get :
      962     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
      963     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
      964     define output parameter p-List_        like ubflt.usr-flt.List_        no-undo .
      965     define output parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
      966     define output parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
      967     define output parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
      968     define output parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
      969     define output parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
      970     do
      971     on error undo, return error
      972     :
      973       define buffer buf_usr-flt for ubflt.usr-flt .
      974       define variable v-use-List_     as logical   no-undo .
      975       define variable v-type-List_     as character no-undo .
      976       define variable v-format-List_   as character no-undo .
      977       define variable v-use-Naim      as logical   no-undo .
      978       define variable v-type-Naim      as character no-undo .
      979       define variable v-format-Naim    as character no-undo .
      980       define variable v-use-print-graft as logical   no-undo .
      981       define variable v-use-sort-gr     as logical   no-undo .
      982       define variable v-use-type-price  as logical   no-undo .
      983       define variable v-use-type-val    as logical   no-undo .
      984       define variable v-label          as character no-undo .
      985       define variable v-tooltip        as character no-undo .
      986       define variable v-user-can-edit  as logical   no-undo .
      987       define variable v-output-display as logical   no-undo .
      988       define variable v-other          as character no-undo .
      989       run uf-name in this-procedure
      990          (input  entry(1, p-code, chr(4))
      991         ,output v-use-List_
      992         ,output v-type-List_
      993         ,output v-format-List_
      994         ,output v-use-Naim
      995         ,output v-type-Naim
      996         ,output v-format-Naim
      997         ,output v-use-print-graft
      998         ,output v-use-sort-gr
      999         ,output v-use-type-price
     1000         ,output v-use-type-val
     1001         ,output v-label
     1002         ,output v-tooltip
     1003         ,output v-user-can-edit
     1004         ,output v-output-display
     1005         ,output v-other
     1006         ) no-error .
     1007       if error-status :error then do:
     1008         undo, return error return-value .
     1009       end.
     1010       find first buf_usr-flt no-lock where
     1011                  buf_usr-flt.Call-point     = p-code AND
     1012                  buf_usr-flt.user-name       = p-user-name
     1013         no-error .
     1014       if avail buf_usr-flt then do:
     1015         assign
     1016         p-List_        = (if v-use-List_       then buf_usr-flt.List_       else ?)
     1017         p-Naim         = (if v-use-Naim        then buf_usr-flt.Naim        else ?)
     1018         p-print-graft  = (if v-use-print-graft then buf_usr-flt.print-graft else ?)
     1019         p-sort-gr      = (if v-use-sort-gr     then buf_usr-flt.sort-gr     else ?)
     1020         p-type-price   = (if v-use-type-price  then buf_usr-flt.type-price  else ?)
     1021         p-type-val     = (if v-use-List_       then buf_usr-flt.type-val    else ?)
     1022         .
     1023       end.
     1024       else do:
     1025         assign
     1026         p-List_        = (if v-use-List_       then "":U                    else ?)
     1027         p-Naim         = (if v-use-Naim        then "":U                    else ?)
     1028         p-print-graft  = (if v-use-print-graft then no                      else ?)
     1029         p-sort-gr      = (if v-use-sort-gr     then no                      else ?)
     1030         p-type-price   = (if v-use-type-price  then no                      else ?)
     1031         p-type-val     = (if v-use-List_       then no                      else ?)
     1032         .
     1033       end.
     1034     end.
     1035   end procedure.
     1036   procedure uf-set :
     1037     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
     1038     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
     1039     define input  parameter p-List_        like ubflt.usr-flt.List_        no-undo .
     1040     define input  parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
     1041     define input  parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
     1042     define input  parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
     1043     define input  parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
     1044     define input  parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
     1045     do
     1046     on error undo, return error
     1047     :
     1048       define buffer buf_usr-flt for ubflt.usr-flt .
     1049       define variable v-use-List_     as logical   no-undo .
     1050       define variable v-type-List_     as character no-undo .
     1051       define variable v-format-List_   as character no-undo .
     1052       define variable v-use-Naim      as logical   no-undo .
     1053       define variable v-type-Naim      as character no-undo .
     1054       define variable v-format-Naim    as character no-undo .
     1055       define variable v-use-print-graft as logical   no-undo .
     1056       define variable v-use-sort-gr   as logical   no-undo .
     1057       define variable v-use-type-price as logical   no-undo .
     1058       define variable v-use-type-val  as logical   no-undo .
     1059       define variable v-tooltip        as character no-undo .
     1060       define variable v-label          as character no-undo .
     1061       define variable v-user-can-edit  as logical   no-undo .
     1062       define variable v-output-display as logical   no-undo .
     1063       define variable v-other          as character no-undo .
     1064       run uf-name in this-procedure
     1065         (input  entry(1, p-code, chr(4))
     1066         ,output v-use-List_
     1067         ,output v-type-List_
     1068         ,output v-format-List_
     1069         ,output v-use-Naim
     1070         ,output v-type-Naim
     1071         ,output v-format-Naim
     1072         ,output v-use-print-graft
     1073         ,output v-use-sort-gr
     1074         ,output v-use-type-price
     1075         ,output v-use-type-val
     1076         ,output v-label
     1077         ,output v-tooltip
     1078         ,output v-user-can-edit
     1079         ,output v-output-display
     1080         ,output v-other
     1081         ) no-error .
     1082       if error-status :error then do:
     1083         undo, return error return-value .
     1084       end.
     1085       find first buf_usr-flt where
     1086                  buf_usr-flt.Call-point     = p-code AND
     1087                  buf_usr-flt.user-name       = p-user-name
     1088         no-error .
     1089       if not avail buf_usr-flt then do:
     1090           create buf_usr-flt .
     1091           assign
     1092           buf_usr-flt.call-point = p-code
     1093           buf_usr-flt.user-name  = p-user-name
     1094           .
     1095       end.
     1096       if avail buf_usr-flt then do:
     1097        assign
     1098        buf_usr-flt.List_       =  (if v-use-List_       then  p-List_        else ?)
     1099        buf_usr-flt.Naim        =  (if v-use-Naim        then  p-Naim         else ?)
     1100        buf_usr-flt.print-graft =  (if v-use-print-graft then  p-print-graft  else ?)
     1101        buf_usr-flt.sort-gr     =  (if v-use-sort-gr     then  p-sort-gr      else ?)
     1102        buf_usr-flt.type-price  =  (if v-use-type-price  then  p-type-price   else ?)
     1103        buf_usr-flt.type-val    =  (if v-use-List_       then  p-type-val     else ?)
     1104       .
     1105       release buf_usr-flt.
     1106       end.
     1107       else undo, return error ("Ошибка при записи usr-flt" + substitute(" call-point=&1, user-name=&2", p-code, p-user-name)).
     1108     end.
     1109   end procedure.
     1110   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1111   procedure factord :
     1112     define input  parameter p-fact-date            as date    no-undo .
     1113     define input  parameter p-fact-time            as integer no-undo .
     1114     define input  parameter p-fact-num             as integer no-undo .
     1115     define input  parameter p-shift-date           as date    no-undo .
     1116     define input  parameter p-shift-num            as integer no-undo .
     1117     define input  parameter p-shift-on             as logical no-undo .
     1118     define output parameter p-fact-order           as decimal no-undo .
     1119     define output parameter p-shift-end-fact-order as decimal no-undo .
     1120     define output parameter p-day-end-fact-order   as decimal no-undo .
     1121     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
     1122     if p-fact-date = ?
     1123     then do:
     1124       return error "Не указана фактическая дата" .
     1125     end.
     1126     define variable v-fact-date-num as integer no-undo .
     1127     assign
     1128       v-fact-date-num = integer(p-fact-date)
     1129     .
     1130     if p-fact-num = ?
     1131     or p-fact-num = 0
     1132     then do:
     1133       return error "Не задан p-fact-num " + string(p-fact-num) .
     1134     end.
     1135     if p-fact-num < 0
     1136     then do:
     1137       return error "Отрицательный fact-num " + string(p-fact-num) .
     1138     end.
     1139     if p-fact-num >= 100000000
     1140     then do:
     1141       return error "Недопустимо большой fact-num " + string(p-fact-num) .
     1142     end.
     1143     if p-shift-on = true
     1144     then do:
     1145       if p-shift-date = ?
     1146       then do:
     1147         return error "Не задана дата смены" .
     1148       end.
     1149       if p-shift-num = ?
     1150       or p-shift-num = 0
     1151       then do:
     1152         return error "Не задан номер смены" .
     1153       end.
     1154     end.
     1155     else do:
     1156       assign
     1157         p-shift-date = p-fact-date
     1158         p-shift-num  = 24
     1159       .
     1160     end.
     1161     define variable v-shift-offset as integer no-undo .
     1162     if p-shift-date = p-fact-date
     1163     then do:
     1164       assign
     1165         v-shift-offset = 1
     1166       .
     1167     end.
     1168     if p-shift-date < p-fact-date
     1169     then do:
     1170       assign
     1171         v-shift-offset = 0
     1172       .
     1173     end.
     1174     if p-shift-date > p-fact-date
     1175     then do:
     1176       message
     1177         vss-workfile vss-revision vss-description skip
     1178         "Неправильная дата закрытия смены" skip
     1179         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
     1180         view-as alert-box error .
     1181       undo, return error
     1182         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
     1183           ,string(p-fact-date, '99/99/9999':U)
     1184           ,string(p-shift-date, '99/99/9999':U)
     1185           )
     1186       .
     1187     end.
     1188     if p-shift-num < 1
     1189     or p-shift-num > 24
     1190     then do:
     1191       message
     1192         vss-workfile vss-revision vss-description skip
     1193         "Неправильный номер смены" skip
     1194         "p-shift-num" p-shift-num skip
     1195         view-as alert-box error .
     1196       undo, return error return-value .
     1197     end.
     1198     assign
     1199       p-fact-order           = v-fact-date-num
     1200                              + v-shift-offset * 0.5
     1201                              + p-shift-num    * 0.02 - 0.01
     1202                              + p-fact-num     * 0.0000000001
     1203       p-shift-end-fact-order = v-fact-date-num
     1204                              + v-shift-offset * 0.5
     1205                              + p-shift-num    * 0.02
     1206       p-day-end-fact-order   = v-fact-date-num
     1207                              + 0.99
     1208     .
     1209     if p-fact-order           <= v-fact-date-num
     1210     or p-shift-end-fact-order <= v-fact-date-num
     1211     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
     1212     or p-shift-end-fact-order >= p-day-end-fact-order
     1213     then do:
     1214       message
     1215         vss-workfile vss-revision vss-description skip
     1216         "Внутренняя ошибка при генерации фактического номера" skip
     1217         "p-fact-date"            p-fact-date            skip
     1218         "p-fact-time"            p-fact-time            skip
     1219         "p-fact-num"             p-fact-num             skip
     1220         "p-shift-date"           p-shift-date           skip
     1221         "p-shift-num"            p-shift-num            skip
     1222         "p-shift-on"             p-shift-on             skip
     1223         "p-shift-end-fact-order" p-shift-end-fact-order skip
     1224         "p-day-end-fact-order"   p-day-end-fact-order   skip
     1225         "v-fact-date-num"        v-fact-date-num        skip
     1226         view-as alert-box error .
     1227       undo, return error return-value .
     1228     end.
     1229   end procedure.
     1230   procedure day-begin-fact-order :
     1231     define input  parameter p-fact-date            as date    no-undo .
     1232     define output parameter p-day-begin-fact-order as decimal no-undo .
     1233     do
     1234     on error undo, return error return-value
     1235     :
     1236       if p-fact-date = ?
     1237       then do:
     1238         assign
     1239           p-day-begin-fact-order = 0
     1240         .
     1241       end.
     1242       else do:
     1243         assign
     1244           p-day-begin-fact-order = integer(p-fact-date)
     1245         .
     1246       end.
     1247     end.
     1248   end procedure.
     1249   procedure factord-max-fact-order :
     1250     define output parameter p-max-fact-order as decimal   no-undo .
     1251     do
     1252     on error undo, return error return-value
     1253     :
     1254       run day-begin-fact-order in this-procedure
     1255         (input  date(1, 1, 5000)
     1256         ,output p-max-fact-order
     1257         ) .
     1258     end.
     1259   end procedure.
     1260   procedure factord-cut-archive :
     1261     define input  parameter p-obj-type             as character no-undo .
     1262     define input  parameter p-obj-code             as integer   no-undo .
     1263     define input  parameter p-fact-date            as date      no-undo .
     1264     define output parameter p-shift-on             as logical   no-undo .
     1265     define output parameter p-shift-date           as date      no-undo .
     1266     define output parameter p-shift-num            as integer   no-undo .
     1267     define output parameter p-day-end-fact-order   as decimal   no-undo .
     1268     define output parameter p-shift-end-fact-order as decimal   no-undo .
     1269     define variable v-fact-order as decimal   no-undo .
     1270     define buffer buf_shift-obj for ub.shift-obj .
     1271     do
     1272     on error undo, return error return-value
     1273     :
     1274   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1275   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1276     (input  p-obj-type
     1277     ,input  p-obj-code
     1278     ,input  'shift-on=request'
     1279     ,output p-shift-on
     1280     ) no-error .
     1281       if error-status :error
     1282       then do:
     1283         message
     1284           vss-workfile vss-revision vss-description skip
     1285           "Ошибка при определении атрибута объекта" skip
     1286           "Объект" p-obj-type p-obj-code skip
     1287           error-status :get-message(1) skip
     1288           return-value skip
     1289           view-as alert-box error .
     1290         undo, return error return-value .
     1291       end.
     1292       if p-shift-on = false
     1293       then do:
     1294         assign
     1295           p-shift-date               = ?
     1296           p-shift-num                = 0
     1297         .
     1298       end.
     1299       else do:
     1300         find first buf_shift-obj share-lock
     1301           where buf_shift-obj.obj-type   = p-obj-type
     1302             and buf_shift-obj.obj-code   = p-obj-code
     1303             and buf_shift-obj.shift-date > p-fact-date
     1304           use-index pi
     1305           no-error .
     1306         if not available buf_shift-obj
     1307         or buf_shift-obj.status_ <> 'зкр':U
     1308         then do:
     1309           message
     1310             vss-workfile vss-revision vss-description skip
     1311             "Невозможно вычислить последнюю смену" skip
     1312             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
     1313             "Объект" p-obj-type p-obj-code skip
     1314             "Дата" p-fact-date skip
     1315             view-as alert-box error .
     1316           undo, return error return-value .
     1317         end.
     1318         find last buf_shift-obj share-lock
     1319           where buf_shift-obj.obj-type = p-obj-type
     1320             and buf_shift-obj.obj-code = p-obj-code
     1321             and buf_shift-obj.shift-date <= p-fact-date
     1322           use-index pi
     1323           no-error .
     1324         if available buf_shift-obj
     1325         then do:
     1326           if  buf_shift-obj.status_ = 'зкр':U
     1327           then do:
     1328             assign
     1329               p-shift-date = buf_shift-obj.shift-date
     1330               p-shift-num  = buf_shift-obj.shift-num
     1331             .
     1332           end.
     1333           else do:
     1334             message
     1335               vss-workfile vss-revision vss-description skip
     1336               "Невозможно вычислить последнюю смену" skip
     1337               "Статус смены отличен от статуса" 'зкр':U skip
     1338               "Объект" p-obj-type p-obj-code skip
     1339               "Дата" p-fact-date skip
     1340               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
     1341               view-as alert-box error .
     1342             undo, return error return-value .
     1343           end.
     1344         end.
     1345         else do:
     1346           assign
     1347             p-shift-date = p-fact-date - 1
     1348             p-shift-num  = 1
     1349           .
     1350         end.
     1351       end.
     1352       run factord in this-procedure
     1353         (input  p-fact-date
     1354         ,input  1
     1355         ,input  1
     1356         ,input  p-shift-date
     1357         ,input  p-shift-num
     1358         ,input  p-shift-on
     1359         ,output v-fact-order
     1360         ,output p-shift-end-fact-order
     1361         ,output p-day-end-fact-order
     1362         ) no-error .
     1363       if error-status :error
     1364       then do:
     1365         message
     1366           vss-workfile vss-revision vss-description skip
     1367           "Ошибка при вызове процедуры factord"
     1368           error-status :get-message(1) skip
     1369           return-value skip
     1370           view-as alert-box error .
     1371         undo, return error return-value .
     1372       end.
     1373     end.
     1374   end procedure.
     1375   procedure factord-lock-shift :
     1376     define input  parameter p-obj-type  as character no-undo .
     1377     define input  parameter p-obj-code  as integer   no-undo .
     1378     define input  parameter p-fact-date as date      no-undo .
     1379     define parameter buffer buf_shift-obj for ub.shift-obj .
     1380     define variable v-shift-on      as logical   no-undo .
     1381     define variable v-extra-message as character no-undo .
     1382     define variable v-error as character no-undo .
     1383     do
     1384     on error undo, return error return-value
     1385     :
     1386   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1387   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1388     (input  p-obj-type
     1389     ,input  p-obj-code
     1390     ,input  'shift-on=request'
     1391     ,output v-shift-on
     1392     ) no-error .
     1393       if error-status :error
     1394       then do:
     1395         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
     1396         undo, return error v-error .
     1397       end.
     1398       if v-shift-on = true
     1399       then do:
     1400         find first buf_shift-obj share-lock
     1401           where buf_shift-obj.obj-type   = p-obj-type
     1402             and buf_shift-obj.obj-code   = p-obj-code
     1403             and buf_shift-obj.shift-date > p-fact-date
     1404           use-index pi
     1405           no-error .
     1406         if not available buf_shift-obj
     1407         or buf_shift-obj.status_ <> 'зкр':U
     1408         then do:
     1409           find last buf_shift-obj
     1410             where buf_shift-obj.obj-type = p-obj-type
     1411               and buf_shift-obj.obj-code = p-obj-code
     1412               and buf_shift-obj.status_  = 'зкр':U
     1413             use-index stts
     1414             no-error .
     1415           if available buf_shift-obj
     1416           then do:
     1417             assign
     1418               v-extra-message =
     1419                     substitute("Дата начала последеней закрытой смены на объекте &1"
     1420                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
     1421                               )
     1422             .
     1423           end.
     1424           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
     1425           undo, return error v-error .
     1426         end.
     1427       end.
     1428     end.
     1429   end procedure.
     1430   procedure factord-end-day :
     1431     define input  parameter p-fact-date            as date    no-undo .
     1432     define output parameter p-day-end-fact-order   as decimal no-undo .
     1433     do
     1434     on error undo, return error return-value
     1435     :
     1436       if p-fact-date = ?
     1437       then do:
     1438         return error "Не указана фактическая дата" .
     1439       end.
     1440       assign
     1441         p-day-end-fact-order = integer(p-fact-date) + 0.99
     1442       .
     1443     end.
     1444   end procedure.
     1445   procedure factord-to-date :
     1446     define input  parameter p-fact-order as decimal no-undo .
     1447     define output parameter p-fact-date  as date    no-undo .
     1448     define variable v-ref-date  as date      no-undo .
     1449     define variable v-ref-delta as integer   no-undo .
     1450     do
     1451     on error undo, return error return-value
     1452     :
     1453       if p-fact-order = ?
     1454       or p-fact-order = 0
     1455       then do:
     1456         return error "Не указан fact-order" .
     1457       end.
     1458       assign
     1459         v-ref-date  = date(1, 1, 2000)
     1460       .
     1461       assign
     1462         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
     1463       .
     1464       assign
     1465         p-fact-date = v-ref-date + v-ref-delta
     1466       .
     1467     end.
     1468   end procedure.
     1469   procedure factord-to-fact-num :
     1470     define input  parameter p-fact-order as decimal no-undo .
     1471     define output parameter p-fact-num   as integer no-undo .
     1472     define variable v-fact-order-trunc as decimal no-undo .
     1473     do
     1474     on error undo, return error return-value
     1475     :
     1476       if p-fact-order = ?
     1477       or p-fact-order = 0
     1478       then do:
     1479         return error "Не указан fact-order" .
     1480       end.
     1481       assign
     1482        v-fact-order-trunc = truncate(p-fact-order, 2)
     1483       .
     1484       assign
     1485         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
     1486       .
     1487     end.
     1488   end procedure.
     1489   procedure factord-to-shift-num :
     1490     define input  parameter p-fact-order as decimal no-undo .
     1491     define output parameter p-shift-num   as integer no-undo .
     1492     define variable  p-shift-numd  as decimal   no-undo .
     1493     define variable v-fact-order-trunc as decimal no-undo .
     1494     do
     1495     on error undo, return error return-value
     1496     :
     1497       if p-fact-order = ?
     1498       or p-fact-order = 0
     1499       then do:
     1500         return error "Не указан fact-order" .
     1501       end.
     1502       assign
     1503        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
     1504       .
     1505       if v-fact-order-trunc < 0.5 then do:
     1506         v-fact-order-trunc = v-fact-order-trunc + 0.5.
     1507       end.
     1508       assign
     1509         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
     1510         .
     1511        assign
     1512         p-shift-num = truncate (p-shift-numd , 0)
     1513       .
     1514     end.
     1515   end procedure.
     1516   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1517     define variable v-cntxt-db-num        as integer   no-undo .
     1518     define variable v-cntxt-userid        as character no-undo .
     1519     define variable v-cntxt-level         as character no-undo .
     1520     define variable v-cntxt-host-code-obj as integer   no-undo .
     1521     define variable v-cntxt-obj-type      as character no-undo .
     1522     define variable v-cntxt-obj-code      as integer   no-undo .
     1523     define variable v-cntxt-db-num-obj    as integer   no-undo .
     1524     define variable v-cntxt-is-admin      as logical   no-undo .
     1525   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1526   FUNCTION mark-string RETURNS CHARACTER
     1527     ( input p-recid as recid, input mark-list as character  ) :
     1528     RETURN ( IF LOOKUP( STRING( p-recid), mark-list ) > 0 THEN '*' ELSE '':U ).
     1529   END FUNCTION.
     1530   define new global shared variable g#lib-trn  as handle no-undo .
     1531   define new global shared variable g#lib-trn2 as handle no-undo .
     1532   define new global shared variable g#lib-trn3 as handle no-undo .
     1533   define new global shared variable g#lib-trn4 as handle no-undo .
     1534   FUNCTION uf-convert-mode returns character(
     1535                                               input p-mode as character):
     1536   CASE p-mode:
     1537     when 'все':U
     1538     or
     1539     when "receiver":U
     1540     or
     1541     when "receiver-host":U
     1542     or
     1543     when "receiver-r-schet":U
     1544     or
     1545     when "payer":U
     1546     or
     1547     when "payer-host"
     1548     or
     1549     when "payer-r-schet":U
     1550     or
     1551     when "currency":U
     1552     or
     1553     when "receiver-schet":U
     1554     or
     1555     when "payer-schet":U
     1556     then do:
     1557       return p-mode.
     1558     end.
     1559     when "type":U
     1560     or
     1561     when "type-date":U
     1562     or
     1563     when "type-object":U
     1564     then do:
     1565       return (p-mode + chr(4) + p-fin-doc-type).
     1566     end.
     1567     when "ext-type":U
     1568     or
     1569     when "ext-type-date":U
     1570     then do:
     1571       return (p-mode + chr(4) + p-fin-ext-doc-type).
     1572     end.
     1573     when "type-stat":U
     1574     or
     1575     when "type-stat-date":U
     1576     or
     1577     when "type-stat-object"
     1578     then do:
     1579        return (p-mode + chr(4) + p-fin-doc-type + p-status_).
     1580     end.
     1581     when "ext-type-stat":U
     1582     or
     1583     when "ext-type-stat-date":U
     1584     then do:
     1585       return (p-mode + chr(4) + p-fin-ext-doc-type + p-status_).
     1586     end.
     1587     when 'фирма':U then do:
     1588       return (p-mode + chr(4) + string(p-host-code)).
     1589     end.
     1590     when 'объект':U then do:
     1591       return (p-mode + chr(4) + p-obj-type + string(p-obj-code)).
     1592     end.
     1593   END CASE.
     1594   END FUNCTION.
