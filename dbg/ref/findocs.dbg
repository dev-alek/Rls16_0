     6368                               ,input 0
     6369                               ,input 0
     6370                               ,input ?
     6371                               ,input 0
     6372                               ,input 0
     6373                               ,input 0
     6374                               ,input 0
     6375                               ,input "":U
     6376                               ,input-output loc-doc-rec
     6377                                           ) no-error
     6378               .
