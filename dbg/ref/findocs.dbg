     5581     run ref/findcsqc.p ( input  p-open-query , input  p-find-next ,  input  p-find-condition ,  INPUT parParentProc ,  INPUT this-procedure:handle ,  input p-curr-host-code ,  input p-mode ,  input p-list  ,  input p-host-code ,  input p-obj-type ,  input p-obj-code ,  input p-status_    ,  input p-fin-doc-type ,  input p-fin-ext-doc-type ,  input p-start-date ,  input p-end-date    ,  input p-trn-doc-code ,  input p-receiver-type ,  input p-receiver-code  ,  input p-receiver-r-schet ,  input p-payer-type ,  input p-payer-code  ,  input p-payer-r-schet ,  input p-curr-code  ,  input p-receiver-code-schet ,  input p-payer-code-schet ,  input p-contract-code ,  input p-cor-acc ,  input p-cor-acc1  ,  input p-an-uchet-code ,  input p-cel-nazn-code ,  input-output v-rid-list ,  input filter-point  ,  input filter-point0 ,  input sort-column-name ,  output v-filter-name ,  input-output v-doc-rec ) .
     5582   end.
     5583   if p-open-query then do:
     5584     CASE p-mode :
     5585       WHEN 'фирма':U THEN DO:
     5586           ASSIGN
     5587           frame Dialog-Frame:TITLE = title0 +
     5588                                       substitute(" Фирма: (&1) &2", p-host-code, X_clients-host.obj-name).
     5589       END.
     5590       WHEN 'объект':U THEN DO:
     5591           ASSIGN
     5592           frame Dialog-Frame:TITLE = title0 +
     5593                                       substitute(" Фирма: (&1) &2 &3&4", p-host-code, X_clients-host.obj-name, p-obj-type, p-obj-code).
     5594       END.
     5595       WHEN "receiver-host":U THEN DO:
     5596           ASSIGN
     5597           frame Dialog-Frame:TITLE = title0 +
     5598                                       substitute(" Фирма: (&1) &2 Получатель &3&4 &5",
     5599                                       p-host-code, X_clients-host.obj-name,
     5600                                       p-receiver-type, p-receiver-code, X_clients.obj-name) .
     5601       END.
     5602       WHEN "receiver":U THEN DO:
     5603           ASSIGN
     5604           frame Dialog-Frame:TITLE = title0 +
     5605                                       substitute(" Получатель &1&2 &3",
     5606                                       p-receiver-type, p-receiver-code, X_clients.obj-name) .
     5607       END.
     5608       WHEN "receiver-r-schet":U THEN DO:
     5609           ASSIGN
     5610           frame Dialog-Frame:TITLE = title0 +
     5611                                       substitute(" Получатель &1&2 &3 Р/с ?4",
     5612                                       p-receiver-type, p-receiver-code, X_clients.obj-name, p-receiver-r-schet) .
     5613       END.
     5614       WHEN "payer-r-schet":U THEN DO:
     5615           ASSIGN
     5616           frame Dialog-Frame:TITLE = title0 +
     5617                                       substitute(" Плательщик &1&2 &3 Р/с ?4",
     5618                                       p-payer-type, p-payer-code, X_clients.obj-name, p-payer-r-schet) .
     5619       END.
     5620       WHEN "payer-host":U THEN DO:
     5621           ASSIGN
     5622           frame Dialog-Frame:TITLE = title0 +
     5623                                       substitute(" Фирма: (&1) &2 Плательщик &3&4 &5",
     5624                                       p-host-code, X_clients-host.obj-name,
     5625                                       p-payer-type, p-payer-code, X_clients.obj-name) .
     5626       END.
     5627       WHEN "payer":U THEN DO:
     5628           ASSIGN
     5629           frame Dialog-Frame:TITLE = title0 +
     5630                                       substitute(" Плательщик &1&2 &3",
     5631                                       p-payer-type, p-payer-code, X_clients.obj-name) .
     5632       END.
     5633       WHEN "currency":U THEN DO:
     5634           ASSIGN
     5635           frame Dialog-Frame:TITLE = title0 +
     5636                                       substitute(" Фирма: (&1) &2 &3",
     5637                                       p-host-code, X_clients-host.obj-name, X_currency.curr-abbr).
     5638       END.
     5639       WHEN "contract-host":U THEN DO:
     5640           ASSIGN
     5641           frame Dialog-Frame:TITLE = title0 +
     5642                                       substitute(" Фирма: (&1) &2 Контракт &3",
     5643                                       p-host-code, X_clients-host.obj-name, X_contract.contract-prn-code).
     5644       END.
     5645       WHEN "receiver-schet":U THEN DO:
     5646           ASSIGN
     5647           frame Dialog-Frame:TITLE = title0 +
     5648                                       substitute(" Фирма: (&1) &2 Р/c Получателя &3",
     5649                                       p-host-code,  X_clients-host.obj-name, X_fin-schet.r-schet).
     5650       END.
     5651       WHEN "payer-schet":U THEN DO:
     5652           ASSIGN
     5653           frame Dialog-Frame:TITLE = title0 +
     5654                                       substitute(" Фирма: (&1) &2 Р/c Плательщика &3",
     5655                                       p-host-code,  X_clients-host.obj-name, X_fin-schet.r-schet).
     5656       END.
     5657       WHEN 'type' THEN DO:
     5658           ASSIGN
     5659           frame Dialog-Frame:TITLE = title0 +
     5660                                       substitute(" Фирма: (&1) &2 &3",
     5661                                       p-host-code, X_clients-host.obj-name, entry (lookup (p-fin-doc-type, 'пко,рко,ппп,рпп,апп,апр':U) + 1, ',':U + 'приходный кассовый ордер,расходный кассовый ордер,приходное платежное поручение,расходное платежное поручение,приходный АПЗ,расходный АПЗ':U)).
     5662       END.
     5663       WHEN 'type-stat' THEN DO:
     5664           ASSIGN
     5665           frame Dialog-Frame:TITLE = title0 +
     5666                                       substitute(" Фирма: (&1) &2 &3 &4",
     5667                                       p-host-code, X_clients-host.obj-name, entry (lookup (p-fin-doc-type, 'пко,рко,ппп,рпп,апп,апр':U) + 1, ',':U + 'приходный кассовый ордер,расходный кассовый ордер,приходное платежное поручение,расходное платежное поручение,приходный АПЗ,расходный АПЗ':U), p-status_).
     5668       END.
     5669       WHEN 'type-object' THEN DO:
     5670         case p-fin-doc-type:
     5671           when "cash" then do:
     5672             ASSIGN
     5673             frame Dialog-Frame:TITLE = title0 +
     5674                                         substitute(" Фирма: (&1) &2 &3 &4&5 Наличные платежи",
     5675                                         p-host-code, X_clients-host.obj-name, entry (lookup (p-fin-doc-type, 'пко,рко,ппп,рпп,апп,апр':U) + 1, ',':U + 'приходный кассовый ордер,расходный кассовый ордер,приходное платежное поручение,расходное платежное поручение,приходный АПЗ,расходный АПЗ':U), p-obj-type, p-obj-code).
     5676           end.
     5677           otherwise do:
     5678             ASSIGN
     5679             frame Dialog-Frame:TITLE = title0 +
     5680                                         substitute(" Фирма: (&1) &2 &3 &4&5",
     5681                                         p-host-code, X_clients-host.obj-name, entry (lookup (p-fin-doc-type, 'пко,рко,ппп,рпп,апп,апр':U) + 1, ',':U + 'приходный кассовый ордер,расходный кассовый ордер,приходное платежное поручение,расходное платежное поручение,приходный АПЗ,расходный АПЗ':U), p-obj-type, p-obj-code).
     5682           end.
     5683         end case.
     5684       END.
     5685       WHEN 'type-stat-object' THEN DO:
     5686           ASSIGN
     5687           frame Dialog-Frame:TITLE = title0 +
     5688                                       substitute(" Фирма: (&1) &2 &3 &4&5 &6",
     5689                                       p-host-code, X_clients-host.obj-name, entry (lookup (p-fin-doc-type, 'пко,рко,ппп,рпп,апп,апр':U) + 1, ',':U + 'приходный кассовый ордер,расходный кассовый ордер,приходное платежное поручение,расходное платежное поручение,приходный АПЗ,расходный АПЗ':U), p-obj-type, p-obj-code, p-status_).
     5690       END.
     5691       WHEN 'type-stat-date' THEN DO:
     5692           ASSIGN
     5693           frame Dialog-Frame:TITLE = title0 +
     5694                                       substitute(" Фирма: (&1) &2 &3 &4 &5-&6",
     5695                                       p-host-code, X_clients-host.obj-name, entry (lookup (p-fin-doc-type, 'пко,рко,ппп,рпп,апп,апр':U) + 1, ',':U + 'приходный кассовый ордер,расходный кассовый ордер,приходное платежное поручение,расходное платежное поручение,приходный АПЗ,расходный АПЗ':U), p-status_,
     5696                                       p-start-date, "99/99/9999",
     5697                                       p-end-date, "99/99/9999").
     5698       END.
     5699       WHEN 'type-date' THEN DO:
     5700           ASSIGN
     5701           frame Dialog-Frame:TITLE = title0 +
     5702                                       substitute(" Фирма: (&1) &2 &3 &5-&6",
     5703                                       p-host-code, X_clients-host.obj-name, entry (lookup (p-fin-doc-type, 'пко,рко,ппп,рпп,апп,апр':U) + 1, ',':U + 'приходный кассовый ордер,расходный кассовый ордер,приходное платежное поручение,расходное платежное поручение,приходный АПЗ,расходный АПЗ':U),
     5704                                       p-start-date, "99/99/9999",
     5705                                       p-end-date, "99/99/9999").
     5706       END.
     5707       WHEN 'ext-type' THEN DO:
     5708           ASSIGN
     5709           frame Dialog-Frame:TITLE = title0 +
     5710                                       substitute(" Фирма: (&1) &2 &3",
     5711                                       p-host-code, X_clients-host.obj-name, p-fin-ext-doc-type).
     5712       END.
     5713       WHEN 'ext-type-stat' THEN DO:
     5714           ASSIGN
     5715           frame Dialog-Frame:TITLE = title0 +
     5716                                       substitute(" Фирма: (&1) &2 &3 &4",
     5717                                       p-host-code, X_clients-host.obj-name, p-fin-ext-doc-type, p-status_).
     5718       END.
     5719       WHEN 'ext-type-stat-date' THEN DO:
     5720           ASSIGN
     5721           frame Dialog-Frame:TITLE = title0 +
     5722                                       substitute(" Фирма: (&1) &2 &3 &4 &5-&6",
     5723                                       p-host-code, X_clients-host.obj-name, p-fin-ext-doc-type, p-status_,
     5724                                       string(p-start-date, "99/99/9999"),
     5725                                       string(p-end-date, "99/99/9999")).
     5726       END.
     5727       WHEN 'ext-type-date' THEN DO:
     5728           ASSIGN
     5729           frame Dialog-Frame:TITLE = title0 +
     5730                                       substitute(" Фирма: (&1) &2 &3 &4-&5",
     5731                                       p-host-code, X_clients-host.obj-name, p-fin-ext-doc-type,
     5732                                       string(p-start-date, "99/99/9999"),
     5733                                       string(p-end-date, "99/99/9999")).
     5734       END.
     5735       WHEN 'schet-fact-order-income-cashless'
     5736       or
     5737       WHEN 'schet-fact-order-expense-cashless'
     5738       THEN DO:
     5739           ASSIGN
     5740           frame Dialog-Frame:TITLE = title0 +
     5741                                       substitute(" Фирма: (&1) &2 СЧЕТ &3 &4 &5 &6-&7"
     5742                                                 ,p-host-code
     5743                                                 ,X_clients-host.obj-name
     5744                                                 ,X_fin-schet.r-schet
     5745                                                 ,p-fin-ext-doc-type
     5746                                                 ,p-status_
     5747                                                 ,string(p-start-date, "99/99/9999")
     5748                                                 ,string(p-end-date, "99/99/9999")).
     5749       END.
     5750     END CASE.
     5751     ASSIGN frame Dialog-Frame:TITLE =
     5752     frame Dialog-Frame:TITLE + chr(32) + v-for-title.
     5753     run set-filter-name in this-procedure ( INPUT v-filter-name) no-error .
     5754   end.
     5755   if not p-open-query and v-doc-rec <> ? then
     5756   REPOSITION br-fin-doc to recid v-doc-rec No-ERROR.
     5757   run waitfram-hide in this-procedure .
     5758   APPLY "VALUE-CHANGED" TO br-fin-doc in frame Dialog-Frame.
     5759   APPLY "ENTRY" TO br-fin-doc.
     5760   END PROCEDURE.
     5761   PROCEDURE proc-b-add :
     5762   define input parameter p-option as character no-undo.
     5763   define variable loc#log as logical no-undo.
     5764   define variable loc-doc-rec as recid no-undo .
     5765   define variable v-contract-code like ub.fin-doc.contract-code no-undo .
     5766   define variable v-ob-doc-code like ub.fin-ob.doc-code no-undo .
     5767   define variable v-receiver-type like ub.fin-doc.receiver-type no-undo .
     5768   define variable v-receiver-code like ub.fin-doc.receiver-code no-undo .
     5769   define variable v-payer-type like ub.fin-doc.payer-type no-undo .
     5770   define variable v-payer-code like ub.fin-doc.payer-code no-undo .
     5771   define variable v-receiver-code-schet like ub.fin-doc.receiver-code-schet no-undo.
     5772   define variable v-payer-code-schet like ub.fin-doc.payer-code-schet no-undo.
     5773   define variable v-curr-code like ub.fin-doc.curr-code no-undo .
     5774   define variable v-obj-type like ub.fin-doc.obj-type no-undo .
     5775   define variable v-obj-code like ub.fin-doc.obj-code no-undo .
     5776   define variable v-cor-acc like ub.fin-doc.cor-acc no-undo.
     5777   define variable v-cor-acc1 like ub.fin-doc.cor-acc1 no-undo.
     5778   define variable v-an-uchet-code like ub.fin-doc.an-uchet-code no-undo.
     5779   define variable v-cel-nazn-code like ub.fin-doc.cel-nazn-code no-undo.
     5780   define variable v-mode as character no-undo.
     5781   define variable vlog as logical no-undo .
     5782   define variable choice as integer no-undo .
     5783   define variable v-rid-list as character no-undo .
     5784   define variable v-contract-type as character no-undo .
     5785   define variable v-contract-cli-type like ub.contract.cli-type no-undo .
     5786   define variable v-contract-cli-code like ub.contract.cli-code no-undo .
     5787   define variable lock-obj as logical no-undo .
     5788   define buffer buf_contract for ub.contract.
     5789   define variable vss-include-info43 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5790   do:
     5791     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     5792       (input  v-cntxt-db-num
     5793       ,input  v-cntxt-userid
     5794       ,input  0
     5795       ,input  'actn_fin-doc_add-def':U
     5796       ,input  'firm':U
     5797       ,input  p-curr-host-code
     5798       ,input  '':U
     5799       ,input  0
     5800       ,input  0
     5801       ,input  0
     5802       ,input  0
     5803       ,input  true
     5804       ,output loc#log
     5805       )  .
     5806   end.
     5807   if not loc#log then return error.
     5808   if p-option = 'КОПИРОВАНИЕ':U then do:
     5809       assign
     5810       p-option = X_fin-doc.fin-doc-type
     5811       v-mode = 'КОПИРОВАНИЕ':U
     5812       loc-doc-rec = recid(X_fin-doc)
     5813       .
     5814   end.
     5815   else do:
     5816       assign
     5817       v-mode = 'ДОБАВЛЕНИЕ':U
     5818       .
     5819   end.
     5820   CASE RS-list :
     5821     when 'все':U then do:
     5822       assign
     5823       v-cor-acc = 0
     5824       v-cor-acc1 = 0
     5825       v-an-uchet-code = 0
     5826       v-cel-nazn-code  = 0
     5827       .
     5828     end.
     5829     when 'cor-acc':U  then do:
     5830       assign
     5831       v-cor-acc = p-cor-acc
     5832       v-cor-acc1 = 0
     5833       v-an-uchet-code = 0
     5834       v-cel-nazn-code  = 0
     5835       .
     5836     end.
     5837     when 'cor-acc1':U then do:
     5838       assign
     5839       v-cor-acc = 0
     5840       v-cor-acc1 = p-cor-acc1
     5841       v-an-uchet-code = 0
     5842       v-cel-nazn-code  = 0
     5843       .
     5844     end.
     5845     when 'an-uchet-code':U then do:
     5846       assign
     5847       v-cor-acc = 0
     5848       v-cor-acc1 = 0
     5849       v-an-uchet-code = p-an-uchet-code
     5850       v-cel-nazn-code  = 0
     5851       .
     5852     end.
     5853     when 'cel-nazn-code':U then do:
     5854       assign
     5855       v-cor-acc = 0
     5856       v-cor-acc1 = 0
     5857       v-an-uchet-code = 0
     5858       v-cel-nazn-code  = p-cel-nazn-code
     5859       .
     5860     end.
     5861   END CASE.
     5862   CASE p-mode :
     5863     WHEN 'фирма':U THEN DO:
     5864       assign
     5865       v-contract-code = 0
     5866       v-receiver-type = "":U
     5867       v-receiver-code = 0
     5868       v-payer-type = "":U
     5869       v-payer-code = 0
     5870       v-receiver-code-schet = 0
     5871       v-payer-code-schet = 0
     5872       v-curr-code     = ?
     5873       v-obj-type = "":U
     5874       v-obj-code = 0
     5875       .
     5876     END.
     5877     WHEN 'объект':U
     5878     or
     5879     when "type-object"
     5880     or
     5881     when "type-stat-object"
     5882     THEN DO:
     5883       assign
     5884       v-contract-code = 0
     5885       v-receiver-type = "":U
     5886       v-receiver-code = 0
     5887       v-payer-type = "":U
     5888       v-payer-code = 0
     5889       v-receiver-code-schet = 0
     5890       v-payer-code-schet = 0
     5891       v-curr-code     = ?
     5892       v-obj-type = p-obj-type
     5893       v-obj-code = p-obj-code
     5894       lock-obj = yes
     5895       .
     5896     END.
     5897     WHEN "receiver-host":U THEN DO:
     5898       assign
     5899       v-contract-code = 0
     5900       v-receiver-type = p-receiver-type
     5901       v-receiver-code = p-receiver-code
     5902       v-payer-type = "":U
     5903       v-payer-code = 0
     5904       v-receiver-code-schet = 0
     5905       v-payer-code-schet = 0
     5906       v-curr-code     = ?
     5907       v-obj-type = "":U
     5908       v-obj-code = 0
     5909       .
     5910     END.
     5911     WHEN "payer-host":U THEN DO:
     5912       assign
     5913       v-contract-code = 0
     5914       v-receiver-type = "":U
     5915       v-receiver-code = 0
     5916       v-payer-type = p-payer-type
     5917       v-payer-code = p-payer-code
     5918       v-receiver-code-schet = 0
     5919       v-payer-code-schet = 0
     5920       v-curr-code     = ?
     5921       v-obj-type = "":U
     5922       v-obj-code = 0
     5923       .
     5924     END.
     5925     WHEN "currency":U THEN DO:
     5926       assign
     5927       v-contract-code = 0
     5928       v-receiver-type = "":U
     5929       v-receiver-code = 0
     5930       v-payer-type = "":U
     5931       v-payer-code = 0
     5932       v-receiver-code-schet = 0
     5933       v-payer-code-schet = 0
     5934       v-curr-code     = p-curr-code
     5935       v-obj-type = "":U
     5936       v-obj-code = 0
     5937       .
     5938     END.
     5939     WHEN "contract-host":U THEN DO:
     5940       assign
     5941       v-contract-code = p-contract-code
     5942       v-receiver-type = "":U
     5943       v-receiver-code = 0
     5944       v-payer-type = "":U
     5945       v-payer-code = 0
     5946       v-receiver-code-schet = 0
     5947       v-payer-code-schet = 0
     5948       v-curr-code     = ?
     5949       v-obj-type = "":U
     5950       v-obj-code = 0
     5951       .
     5952     END.
     5953     WHEN "receiver-schet":U THEN DO:
     5954       assign
     5955       v-contract-code = 0
     5956       v-receiver-type = "":U
     5957       v-receiver-code = 0
     5958       v-payer-type = "":U
     5959       v-payer-code = 0
     5960       v-receiver-code-schet = p-receiver-code-schet
     5961       v-payer-code-schet = 0
     5962       v-curr-code     = ?
     5963       v-obj-type = "":U
     5964       v-obj-code = 0
     5965       .
     5966     END.
     5967     WHEN "payer-schet":U THEN DO:
     5968       assign
     5969       v-contract-code = 0
     5970       v-receiver-type = "":U
     5971       v-receiver-code = 0
     5972       v-payer-type = "":U
     5973       v-payer-code = 0
     5974       v-receiver-code-schet = 0
     5975       v-payer-code-schet = p-payer-code-schet
     5976       v-curr-code     = ?
     5977       v-obj-type = "":U
     5978       v-obj-code = 0
     5979       .
     5980     END.
     5981   END CASE.
     5982   if v-contract-code = 0
     5983   and v-mode <> 'КОПИРОВАНИЕ':U
     5984   and (not is-obj-mode  or is-fin)
     5985   then do:
     5986     run gbl/d-askw.w
     5987                  ( input "Выбор договора для платежа",
     5988                           input  ("Выберите договор, по которому Вы будете создавать платеж" + chr(10)
     5989                                   + "или создайте платеж без указания договора"),
     5990                           input "|",
     5991                           input "Выбрать договор с поставщиком|Выбрать договор с покупателем|Без договора|Отменить",
     5992                           input "|||",
     5993                           input 3,
     5994                           input 4,
     5995                           output choice).
     5996     if choice = 4 then return.
     5997     if choice = 1 or
     5998     choice = 2 then do:
     5999       assign
     6000       v-contract-type = if choice = 1
     6001                         then 'при':U
     6002                         else (if choice = 2
     6003                               then 'рас':U
     6004                               else "all":U
     6005                               )
     6006       v-contract-cli-type = if v-contract-type = 'при':U
     6007                             then v-payer-type
     6008                             else (if v-contract-type = 'рас':U
     6009                                   then v-receiver-type
     6010                                   else "":U)
     6011       v-contract-cli-code = if v-contract-type = 'при':U
     6012                             then v-payer-code
     6013                             else (if v-contract-type = 'рас':U
     6014                                   then v-receiver-code
     6015                                   else 0)
     6016       .
     6017       run str/cont-all.w (
     6018                       input  parParentProc
     6019                      , input  p-curr-host-code
     6020                      , input  "b-sel":U
     6021                      , input  'фирма':U
     6022                      , input  (if is-cli-mode then v-contract-cli-type else ?)
     6023                      , input  (if is-cli-mode then v-contract-cli-code else ?)
     6024                      , input  ?
     6025                      , input  ?
     6026                      , input  "current"
     6027                      , input  v-contract-type
     6028                      , input-output v-rid-list   ) no-error .
     6029      if error-status:error then undo, return error.
     6030      if v-rid-list = "":U then do:
     6031        message
     6032        "Хотите создать платеж без указания договора?"
     6033        view-as alert-box QUESTION buttons YES-NO update vlog.
     6034        if not vlog then undo, return .
     6035      end.
     6036      else do:
     6037         find first buf_contract no-lock where
     6038                   recid(buf_contract) = integer(v-rid-list)  no-error .
     6039         if error-status:error then do:
     6040           undo, return error .
     6041         end.
     6042         assign
     6043         v-contract-code = buf_contract.contract-code
     6044         .
     6045      end.
     6046     end.
     6047   end.
     6048   CASE p-option:
     6049       when 'пко':U then do:
     6050           run ref/findoci1.w
     6051                         (
     6052                           input parParentProc
     6053                           ,input p-curr-host-code
     6054                           ,input v-mode
     6055                           ,input p-host-code
     6056                           ,input 0
     6057                           ,input v-obj-type
     6058                           ,input v-obj-code
     6059                           ,input "":U
     6060                           ,input v-contract-code
     6061                           ,input '':U
     6062                           ,input v-payer-type
     6063                           ,input v-payer-code
     6064                           ,input v-curr-code
     6065                           ,input v-cor-acc
     6066                           ,input v-cor-acc1
     6067                           ,input v-an-uchet-code
     6068                           ,input v-cel-nazn-code
     6069                           ,input (if lock-obj then "lock-obj":U else '')
     6070                           ,input-output loc-doc-rec
     6071                                       ) no-error
     6072           .
     6073       end.
     6074       when 'рко':U then do:
