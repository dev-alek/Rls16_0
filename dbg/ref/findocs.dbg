     6094                           ,input (if lock-obj then "lock-obj":U else '')
     6095                           ,input-output loc-doc-rec
     6096                                       ) no-error
     6097           .
     6098       end.
     6099       when 'ппп':U then do:
     6100               run ref/findoci3.w
