     6283                               ,input X_fin-doc.fin-doc-code
     6284                               ,input X_fin-doc.obj-type
     6285                               ,input X_fin-doc.obj-code
     6286                               ,input X_fin-doc.fin-ext-doc-type
     6287                               ,input 0
     6288                               ,input '':U
     6289                               ,input "":U
     6290                               ,input 0
     6291                               ,input ?
     6292                               ,input 0
     6293                               ,input 0
     6294                               ,input 0
     6295                               ,input 0
     6296                               ,input (if lock-obj then "lock-obj":U else '')
     6297                               ,input-output loc-doc-rec
     6298                                           ) no-error
     6299               .
     6300       end.
     6301       when 'рко':U then do:
