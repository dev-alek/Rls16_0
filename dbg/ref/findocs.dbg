     6135                           ,input v-obj-code
     6136                                                   ,input "":U
     6137                           ,input v-contract-code
     6138                           ,input '':U
     6139                           ,input v-receiver-type
     6140                           ,input v-receiver-code
     6141                           ,input v-receiver-code-schet
     6142                           ,input v-payer-code-schet
     6143                           ,input v-curr-code
     6144                           ,input v-cor-acc
     6145                           ,input v-cor-acc1
     6146                           ,input v-an-uchet-code
     6147                           ,input v-cel-nazn-code
     6148                           ,input "":U
