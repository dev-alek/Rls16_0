     6409                               ,input p-curr-host-code
     6410                               ,input p-change-mode
     6411                               ,input X_fin-doc.host-code
     6412                               ,input X_fin-doc.fin-doc-code
     6413                               ,input X_fin-doc.obj-type
     6414                               ,input X_fin-doc.obj-code
     6415                               ,input X_fin-doc.fin-ext-doc-type
     6416                               ,input 0
     6417                               ,input '':U
     6418                               ,input "":U
     6419                               ,input 0
     6420                               ,input ?
