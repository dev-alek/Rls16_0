     2628   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     2629   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     2630   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2631   on help of frame Dialog-Frame
     2632   do:
     2633     run gbl/app_help.p
     2634       (input this-procedure :file-name
     2635       ,input ''
     2636       ,input ?
     2637       ) no-error.
     2638     if error-status :error then do:
     2639       message
     2640         "Ошибка при вызове помощи"
     2641         error-status :get-message(1)
     2642         view-as alert-box .
     2643     end.
     2644   end.
     2645   run minbtn-set in this-procedure .
     2646   on choose of b-help in frame Dialog-Frame
     2647   do:
     2648     apply "help":u to frame Dialog-Frame .
     2649   end.
     2650   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2651   procedure minbtn-set :
     2652       do
     2653           on error undo, return error return-value
     2654           :
     2655           define variable ii              as integer       no-undo .
     2656           define variable fh              as widget-handle no-undo .
     2657           define variable hh              as widget-handle no-undo .
     2658           define variable v-h             as handle        extent 4 no-undo .
     2659           define variable v-name-button   as character     no-undo .
     2660           define variable v-help-old-x    as decimal       no-undo .
     2661           define variable v-help-old-y    as decimal       no-undo .
     2662           define variable v-help-old-size as decimal       no-undo .
     2663           define variable v-frame-width   as decimal       no-undo .
     2664           define variable jj              as integer       no-undo .
     2665           do
     2666               on error undo, return error
     2667               :
     2668               assign
     2669                   v-frame-width = frame Dialog-Frame:width - 0.3
     2670                   fh            = frame Dialog-Frame:first-child
     2671                   hh            = fh:first-child
     2672                   ii            = 1
     2673                   .
     2674               do while valid-handle(hh):
     2675                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     2676                   do:
     2677                       case lc(hh:name) :
     2678                           when "b-help" then
     2679                               do:
     2680                                   hh:load-image-up("cmp/b-help.bmp":u) .
     2681                                   hh:load-image-down("cmp/b-help.bmp":u) .
     2682                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     2683                                   hh:TOOLTIP = "Помощь" .
     2684                                   v-help-old-x = hh:column .
     2685                                   v-help-old-y = hh:row    .
     2686                                   v-help-old-size = hh:width .
     2687                                   hh:width-chars = 2.5 .
     2688                               end.
     2689                           when "b-print" then
     2690                               do:
     2691                                   hh:load-image("cmp/b-print.bmp":u) .
     2692                                   hh:TOOLTIP = "Печать" .
     2693                                   v-h[ii] = hh:handle .
     2694                                   ii = ii + 1 .
     2695                                   hh:width-chars = 3 .
     2696                               end.
     2697                           when "b-history" or
     2698                           when "b-hist" then
     2699                               do:
     2700                                   hh:load-image("cmp/b-hist.bmp":u) .
     2701                                   hh:TOOLTIP = "История" .
     2702                                   v-h[ii] = hh:handle .
     2703                                   ii = ii + 1 .
     2704                                   hh:width-chars = 3 .
     2705                               end.
     2706                           when "b-sch" then
     2707                               do:
     2708                                   hh:load-image("cmp/b-sch.bmp":u) .
     2709                                   hh:TOOLTIP = "Установка Фильтра" .
     2710                                   v-h[ii] = hh:handle .
     2711                                   ii = ii + 1 .
     2712                                   hh:width-chars = 3 .
     2713                               end.
     2714                           when "b-hist-user" then
     2715                               do:
     2716                                   hh:load-image("cmp/b-hist.bmp":u) .
     2717                                   hh:TOOLTIP = "История пользователя" .
     2718                                   ii = ii + 1 .
     2719                               end.
     2720                       end case.
     2721                   end.
     2722                   hh = hh:next-sibling.
     2723               end.
     2724               b-help:column = v-frame-width - b-help:width-chars.
     2725               jj = 0.
     2726               repeat ii = 4 to 1 by -1 :
     2727                   if valid-handle (v-h[ii] ) then
     2728                   do:
     2729                       jj  = jj + 1 .
     2730                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     2731                       v-h[ii]:row    = v-help-old-y .
     2732                   end.
     2733               end.
     2734           end.
     2735       end.
     2736   end procedure.
     2737   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     2738   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     2739   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     2740   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     2741   define variable v-diasize-current-frame-width  as decimal   no-undo .
     2742   define variable v-diasize-current-frame-height as decimal   no-undo .
     2743   define variable v-diasize-change-size          as logical   no-undo .
     2744   define variable v-diasize-resize-button        as handle    no-undo .
     2745   define variable v-diasize-wndmax               as logical   no-undo .
     2746   define variable v-diasize-wndstore             as logical   no-undo .
     2747   define variable v-diasize-proc-name            as character no-undo .
     2748   define variable v-diasize-browse-handle        as handle    no-undo .
     2749   define variable v-diasize-browse-number        as integer   no-undo .
     2750   define variable v-diasize-need-full-display    as logical   no-undo init false .
     2751   define temp-table temp-diasize-handle no-undo
     2752     field handle-value  as handle
     2753     field save-position as decimal
     2754     index xpk is primary unique handle-value
     2755     .
     2756   define temp-table temp-browse-handle no-undo
     2757     field browse-type   as character
     2758     field browse-number as integer
     2759     field browse-handle as handle
     2760     field original-size as decimal
     2761     index xpk is primary unique browse-type browse-number
     2762     index xie browse-type browse-handle
     2763   .
     2764   procedure diasize_change-height :
     2765     define input  parameter p-change-value  as decimal   no-undo .
     2766     define input  parameter p-move-resize   as logical   no-undo .
     2767     define variable v-field-group-handle    as handle    no-undo .
     2768     define variable v-object-handle         as handle    no-undo .
     2769     define variable v-frame-height          as decimal   no-undo .
     2770     define variable v-frame-virtual-height  as decimal   no-undo .
     2771     define variable v-browse-height         as decimal   no-undo .
     2772     define variable v-window-height         as decimal   no-undo .
     2773     define variable v-window-virtual-height as decimal   no-undo .
     2774     define variable v-change-sign           as integer   no-undo .
     2775     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2776     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2777     if p-change-value > 0
     2778     then do:
     2779       if frame Dialog-Frame :height + p-change-value
     2780           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     2781       then do:
     2782         assign
     2783           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     2784                           - (frame Dialog-Frame :height-chars)
     2785         .
     2786         if p-change-value <= 0
     2787         then do:
     2788           run diasize_position-resize-button in this-procedure .
     2789           return .
     2790         end.
     2791       end.
     2792     end.
     2793     if p-change-value < 0
     2794     then do:
     2795       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     2796       then do:
     2797         assign
     2798           p-change-value = v-diasize-orig-frame-height
     2799                          - (frame Dialog-Frame :height-chars)
     2800         .
     2801         if p-change-value >= 0
     2802         then do:
     2803           run diasize_position-resize-button in this-procedure .
     2804           return .
     2805         end.
     2806       end.
     2807     end.
     2808     if p-change-value >= 0
     2809     then do:
     2810       assign
     2811         v-change-sign = 1
     2812       .
     2813     end.
     2814     else do:
     2815       assign
     2816         v-change-sign = -1
     2817       .
     2818     end.
     2819     assign
     2820       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2821     .
     2822     if p-change-value = 0
     2823     then do:
     2824       run diasize_position-resize-button in this-procedure .
     2825       return .
     2826     end.
     2827     move_block:
     2828     do
     2829     on error undo move_block, retry move_block
     2830     :
     2831       if retry
     2832       then do:
     2833         do
     2834         on error undo move_block, leave move_block
     2835         :
     2836           if p-change-value > 0
     2837           then do:
     2838             for each buf_temp-diasize-handle
     2839             on error undo, next
     2840             :
     2841               assign
     2842                 v-object-handle = buf_temp-diasize-handle.handle-value
     2843               .
     2844               if v-object-handle <> v-diasize-resize-button
     2845               then do:
     2846                 assign
     2847                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2848                 .
     2849               end.
     2850             end.
     2851             assign
     2852               v-diasize-browse-handle :height = v-browse-height
     2853             .
     2854             for each buf_temp-browse-handle
     2855               where buf_temp-browse-handle.browse-type = 'height':u
     2856             on error undo, next
     2857             :
     2858               assign
     2859                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2860               .
     2861             end.
     2862             assign
     2863               frame Dialog-Frame :height = v-frame-height
     2864             .
     2865             if frame Dialog-Frame :scrollable = true
     2866             then do:
     2867               assign
     2868                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     2869               .
     2870             end.
     2871             run diasize_position-resize-button in this-procedure .
     2872           end.
     2873           else do:
     2874             if frame Dialog-Frame :scrollable = true
     2875             then do:
     2876               assign
     2877                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     2878               .
     2879             end.
     2880             assign
     2881               frame Dialog-Frame :height = v-frame-height
     2882             .
     2883             assign
     2884               v-diasize-browse-handle :height = v-browse-height
     2885             .
     2886             for each buf_temp-browse-handle
     2887               where buf_temp-browse-handle.browse-type = 'height':u
     2888             on error undo, next
     2889             :
     2890               assign
     2891                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2892               .
     2893             end.
     2894             for each buf_temp-diasize-handle
     2895             on error undo, next
     2896             :
     2897               assign
     2898                 v-object-handle = buf_temp-diasize-handle.handle-value
     2899               .
     2900               if v-object-handle <> v-diasize-resize-button
     2901               then do:
     2902                 assign
     2903                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2904                 .
     2905               end.
     2906             end.
     2907             run diasize_position-resize-button in this-procedure .
     2908           end.
     2909           assign
     2910             v-diasize-change-size = false
     2911           .
     2912           leave move_block .
     2913         end.
     2914       end.
     2915       assign
     2916         v-diasize-need-full-display = true
     2917       .
     2918       if v-diasize-change-size = false
     2919       then do:
     2920         assign
     2921           v-diasize-change-size = true
     2922         .
     2923       end.
     2924       else do:
     2925         return .
     2926       end.
     2927       assign
     2928         v-frame-height = frame Dialog-Frame :height
     2929         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     2930         v-browse-height = v-diasize-browse-handle :height
     2931       .
     2932       for each buf_temp-browse-handle
     2933         where buf_temp-browse-handle.browse-type = 'height':u
     2934       :
     2935         assign
     2936           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     2937         .
     2938       end.
     2939       for each buf_temp-diasize-handle
     2940       :
     2941         delete buf_temp-diasize-handle .
     2942       end.
     2943       assign
     2944         v-field-group-handle = frame Dialog-Frame :first-child
     2945       .
     2946       do while valid-handle(v-field-group-handle)
     2947       :
     2948         assign
     2949           v-object-handle = v-field-group-handle :first-child
     2950         .
     2951         do while valid-handle(v-object-handle)
     2952         :
     2953           if  v-object-handle <> v-diasize-browse-handle :handle
     2954           and can-query(v-object-handle, "row")
     2955           and can-query(v-object-handle, "height")
     2956           and ( v-object-handle :row > v-diasize-browse-handle :row )
     2957           then do:
     2958             find first buf_temp-browse-handle
     2959               where buf_temp-browse-handle.browse-type   = 'height':u
     2960                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2961               no-error .
     2962             if available buf_temp-browse-handle
     2963             then do:
     2964             end.
     2965             else do:
     2966               create buf_temp-diasize-handle .
     2967               assign
     2968                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2969                 buf_temp-diasize-handle.save-position = v-object-handle :row
     2970               .
     2971             end.
     2972           end.
     2973           assign
     2974             v-object-handle = v-object-handle :next-sibling
     2975           .
     2976         end.
     2977         assign
     2978           v-field-group-handle = v-field-group-handle :next-sibling
     2979         .
     2980       end.
     2981       do with frame Dialog-Frame
     2982       :
     2983         hide v-diasize-resize-button .
     2984         assign
     2985           v-diasize-resize-button :row    = 1
     2986           v-diasize-resize-button :column = 1
     2987         .
     2988       end.
     2989       if p-change-value > 0
     2990       then do:
     2991         if frame Dialog-Frame :scrollable = true
     2992         then do:
     2993           assign
     2994             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2995             no-error .
     2996           if error-status :error
     2997           or error-status :get-message(1) <> ""
     2998           then do:
     2999             undo move_block, retry move_block .
     3000           end.
     3001         end.
     3002         assign
     3003           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     3004           no-error .
     3005         if error-status :error
     3006         or error-status :get-message(1) <> ""
     3007         then do:
     3008           undo move_block, retry move_block .
     3009         end.
     3010         assign
     3011           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     3012           no-error .
     3013         if error-status :error
     3014         or error-status :get-message(1) <> ""
     3015         then do:
     3016           undo move_block, retry move_block .
     3017         end.
     3018         for each buf_temp-browse-handle
     3019           where buf_temp-browse-handle.browse-type = 'height':u
     3020         on error undo move_block, retry move_block
     3021         :
     3022           assign
     3023             buf_temp-browse-handle.browse-handle :height
     3024               = buf_temp-browse-handle.browse-handle :height + p-change-value
     3025             no-error .
     3026           if error-status :error
     3027           or error-status :get-message(1) <> ""
     3028           then do:
     3029             undo move_block, retry move_block .
     3030           end.
     3031         end.
     3032         for each buf_temp-diasize-handle
     3033         on error undo move_block, retry move_block
     3034         :
     3035           assign
     3036             v-object-handle = buf_temp-diasize-handle.handle-value
     3037           .
     3038           if v-object-handle <> v-diasize-resize-button
     3039           then do:
     3040             assign
     3041               v-object-handle :row = v-object-handle :row + p-change-value
     3042               no-error .
     3043             if error-status :error
     3044             or error-status :get-message(1) <> ""
     3045             then do:
     3046               undo move_block, retry move_block .
     3047             end.
     3048           end.
     3049         end.
     3050       end.
     3051       else do:
     3052         for each buf_temp-diasize-handle
     3053         on error undo move_block, retry move_block
     3054         :
     3055           assign
     3056             v-object-handle = buf_temp-diasize-handle.handle-value
     3057           .
     3058           if v-object-handle <> v-diasize-resize-button
     3059           then do:
     3060             assign
     3061               v-object-handle :row = v-object-handle :row + p-change-value
     3062               no-error .
     3063             if error-status :error
     3064             or error-status :get-message(1) <> ""
     3065             then do:
     3066               undo move_block, retry move_block .
     3067             end.
     3068           end.
     3069         end.
     3070         assign
     3071           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     3072           no-error .
     3073         if error-status :error
     3074         or error-status :get-message(1) <> ""
     3075         then do:
     3076           undo move_block, retry move_block .
     3077         end.
     3078         for each buf_temp-browse-handle
     3079           where buf_temp-browse-handle.browse-type = 'height':u
     3080         on error undo move_block, retry move_block
     3081         :
     3082           assign
     3083             buf_temp-browse-handle.browse-handle :height
     3084               = buf_temp-browse-handle.browse-handle :height + p-change-value
     3085             no-error .
     3086           if error-status :error
     3087           or error-status :get-message(1) <> ""
     3088           then do:
     3089             undo move_block, retry move_block .
     3090           end.
     3091         end.
     3092         assign
     3093           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     3094           no-error .
     3095         if error-status :error
     3096         or error-status :get-message(1) <> ""
     3097         then do:
     3098           undo move_block, retry move_block .
     3099         end.
     3100         if frame Dialog-Frame :scrollable = true
     3101         then do:
     3102           assign
     3103             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     3104             no-error .
     3105           if error-status :error
     3106           or error-status :get-message(1) <> ""
     3107           then do:
     3108             undo move_block, retry move_block .
     3109           end.
     3110         end.
     3111       end.
     3112       if p-move-resize = true
     3113       then do:
     3114         run diasize_position-resize-button in this-procedure .
     3115       end.
     3116       if v-diasize-wndstore = true
     3117       then do:
     3118         if connected("ub") = true
     3119         then do:
     3120           define variable v-cntxt-db-num        as integer   no-undo .
     3121           define variable v-cntxt-userid        as character no-undo .
     3122           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3123                                             , OUTPUT v-cntxt-userid
     3124                                             ) .
     3125           run gbl/wndsizew.p
     3126             (input  v-cntxt-db-num
     3127             ,input  v-cntxt-userid
     3128             ,input  v-diasize-proc-name
     3129             ,input  'height':u
     3130             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     3131             ) .
     3132         end.
     3133       end.
     3134     end.
     3135     assign
     3136       v-diasize-change-size = false
     3137     .
     3138   end procedure.
     3139   procedure diasize_set-height :
     3140     define input  parameter p-new-height  as decimal   no-undo .
     3141     define input  parameter p-move-resize as logical   no-undo .
     3142     do
     3143     on error undo, return error return-value
     3144     :
     3145       run diasize_change-height in this-procedure
     3146         (input  (p-new-height - frame Dialog-Frame :height)
     3147         ,input  p-move-resize
     3148         ) .
     3149     end.
     3150   end procedure.
     3151   procedure diasize_change-width :
     3152     define input  parameter p-change-value as decimal   no-undo .
     3153     define input  parameter p-move-resize  as logical   no-undo .
     3154     define variable v-field-group-handle   as handle    no-undo .
     3155     define variable v-object-handle        as handle    no-undo .
     3156     define variable v-frame-width          as decimal   no-undo .
     3157     define variable v-frame-virtual-width  as decimal   no-undo .
     3158     define variable v-browse-width         as decimal   no-undo .
     3159     define variable v-window-width         as decimal   no-undo .
     3160     define variable v-window-virtual-width as decimal   no-undo .
     3161     define variable v-change-sign          as integer   no-undo .
     3162     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     3163     define buffer buf_temp-browse-handle  for temp-browse-handle .
     3164     if p-change-value > 0
     3165     then do:
     3166       if frame Dialog-Frame :width + p-change-value >
     3167           session :width-chars
     3168       then do:
     3169         assign
     3170           p-change-value = session :width-chars - frame Dialog-Frame :width
     3171         .
     3172         if p-change-value <= 0
     3173         then do:
     3174           run diasize_position-resize-button in this-procedure .
     3175           return .
     3176         end.
     3177       end.
     3178     end.
     3179     if p-change-value < 0
     3180     then do:
     3181       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     3182       then do:
     3183         assign
     3184           p-change-value = v-diasize-orig-frame-width
     3185                          - frame Dialog-Frame :width
     3186         .
     3187         if p-change-value >= 0
     3188         then do:
     3189           run diasize_position-resize-button in this-procedure .
     3190           return .
     3191         end.
     3192       end.
     3193     end.
     3194     if p-change-value >= 0
     3195     then do:
     3196       assign
     3197         v-change-sign = 1
     3198       .
     3199     end.
     3200     else do:
     3201       assign
     3202         v-change-sign = -1
     3203       .
     3204     end.
     3205     assign
     3206       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     3207     .
     3208     if p-change-value = 0
     3209     then do:
     3210       run diasize_position-resize-button in this-procedure .
     3211       return .
     3212     end.
     3213     move_block:
     3214     do
     3215     on error undo move_block, leave move_block
     3216     :
     3217       if retry
     3218       then do:
     3219         do
     3220         on error undo move_block, leave move_block
     3221         :
     3222           if p-change-value > 0
     3223           then do:
     3224             for each buf_temp-diasize-handle
     3225             on error undo, next
     3226             :
     3227               assign
     3228                 v-object-handle = buf_temp-diasize-handle.handle-value
     3229               .
     3230               if v-object-handle <> v-diasize-resize-button
     3231               then do:
     3232                 assign
     3233                   v-object-handle :col = buf_temp-diasize-handle.save-position
     3234                 .
     3235               end.
     3236             end.
     3237             assign
     3238               v-diasize-browse-handle :width = v-browse-width
     3239             .
     3240             for each buf_temp-browse-handle
     3241               where buf_temp-browse-handle.browse-type = 'width':u
     3242             on error undo, next
     3243             :
     3244               assign
     3245                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     3246               .
     3247             end.
     3248             assign
     3249               frame Dialog-Frame :width = v-frame-width
     3250             .
     3251             if frame Dialog-Frame :scrollable = true
     3252             then do:
     3253               assign
     3254                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     3255               .
     3256             end.
     3257             run diasize_position-resize-button in this-procedure .
     3258           end.
     3259           else do:
     3260             if frame Dialog-Frame :scrollable = true
     3261             then do:
     3262               assign
     3263                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     3264               .
     3265             end.
     3266             assign
     3267               frame Dialog-Frame :width = v-frame-width
     3268             .
     3269             for each buf_temp-browse-handle
     3270               where buf_temp-browse-handle.browse-type = 'width':u
     3271             on error undo, next
     3272             :
     3273               assign
     3274                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     3275               .
     3276             end.
     3277             assign
     3278               v-diasize-browse-handle :width = v-browse-width
     3279             .
     3280             for each buf_temp-diasize-handle
     3281             on error undo, next
     3282             :
     3283               assign
     3284                 v-object-handle = buf_temp-diasize-handle.handle-value
     3285               .
     3286               if v-object-handle <> v-diasize-resize-button
     3287               then do:
     3288                 assign
     3289                   v-object-handle :col = buf_temp-diasize-handle.save-position
     3290                 .
     3291               end.
     3292             end.
     3293             run diasize_position-resize-button in this-procedure .
     3294           end.
     3295           assign
     3296             v-diasize-change-size = false
     3297           .
     3298           leave move_block .
     3299         end.
     3300       end.
     3301       assign
     3302         v-diasize-need-full-display = true
     3303       .
     3304       if v-diasize-change-size = false
     3305       then do:
     3306         assign
     3307           v-diasize-change-size = true
     3308         .
     3309       end.
     3310       else do:
     3311         return .
     3312       end.
     3313       assign
     3314         v-frame-width = frame Dialog-Frame :width
     3315         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     3316         v-browse-width = v-diasize-browse-handle :width
     3317       .
     3318       for each buf_temp-browse-handle
     3319         where buf_temp-browse-handle.browse-type = 'width':u
     3320       :
     3321         assign
     3322           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     3323         .
     3324       end.
     3325       for each buf_temp-diasize-handle
     3326       :
     3327         delete buf_temp-diasize-handle .
     3328       end.
     3329       assign
     3330         v-field-group-handle = frame Dialog-Frame :first-child
     3331       .
     3332       do while valid-handle(v-field-group-handle)
     3333       :
     3334         assign
     3335           v-object-handle = v-field-group-handle :first-child
     3336         .
     3337         do while valid-handle(v-object-handle)
     3338         :
     3339           if  v-object-handle <> v-diasize-browse-handle :handle
     3340           and v-object-handle <> v-diasize-resize-button
     3341           and can-query(v-object-handle, "row")
     3342           and can-query(v-object-handle, "height")
     3343           and ( v-object-handle :col + v-object-handle :width
     3344                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     3345               )
     3346           then do:
     3347             find first buf_temp-browse-handle
     3348               where buf_temp-browse-handle.browse-type   = 'width':u
     3349                 and buf_temp-browse-handle.browse-handle = v-object-handle
     3350               no-error .
     3351             if available buf_temp-browse-handle
     3352             then do:
     3353             end.
     3354             else do:
     3355               create buf_temp-diasize-handle .
     3356               assign
     3357                 buf_temp-diasize-handle.handle-value  = v-object-handle
     3358                 buf_temp-diasize-handle.save-position = v-object-handle :col
     3359               .
     3360             end.
     3361           end.
     3362           assign
     3363             v-object-handle = v-object-handle :next-sibling
     3364           .
     3365         end.
     3366         assign
     3367           v-field-group-handle = v-field-group-handle :next-sibling
     3368         .
     3369       end.
     3370       do with frame Dialog-Frame
     3371       :
     3372         hide v-diasize-resize-button .
     3373         v-diasize-resize-button :row = 1.
     3374         v-diasize-resize-button :column = 1.
     3375       end.
     3376       if p-change-value > 0
     3377       then do:
     3378         if frame Dialog-Frame :scrollable = true
     3379         then do:
     3380           assign
     3381             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     3382             no-error .
     3383           if error-status :error
     3384           or error-status :get-message(1) <> ""
     3385           then do:
     3386             undo move_block, retry move_block.
     3387           end.
     3388         end.
     3389         assign
     3390           frame Dialog-Frame :width = v-frame-width + p-change-value
     3391           no-error .
     3392         if error-status :error
     3393         or error-status :get-message(1) <> ""
     3394         then do:
     3395           undo move_block, retry move_block.
     3396         end.
     3397         assign
     3398           v-diasize-browse-handle :width = v-browse-width + p-change-value
     3399         no-error .
     3400         if error-status :error
     3401         or error-status :get-message(1) <> ""
     3402         then do:
     3403           undo move_block, retry move_block.
     3404         end.
     3405         for each buf_temp-browse-handle
     3406           where buf_temp-browse-handle.browse-type = 'width':u
     3407         on error undo move_block, retry move_block
     3408         :
     3409           assign
     3410             buf_temp-browse-handle.browse-handle :width
     3411               = buf_temp-browse-handle.browse-handle :width + p-change-value
     3412             no-error .
     3413           if error-status :error
     3414           or error-status :get-message(1) <> ""
     3415           then do:
     3416             undo move_block, retry move_block .
     3417           end.
     3418         end.
     3419         for each buf_temp-diasize-handle
     3420         on error undo move_block, retry move_block
     3421         :
     3422           assign
     3423             v-object-handle = buf_temp-diasize-handle.handle-value
     3424           .
     3425           if v-object-handle <> v-diasize-resize-button
     3426           then do:
     3427             assign
     3428               v-object-handle :col = v-object-handle :col + p-change-value
     3429               no-error .
     3430             if error-status :error
     3431             or error-status :get-message(1) <> ""
     3432             then do:
     3433               undo move_block, retry move_block .
     3434             end.
     3435           end.
     3436         end.
     3437       end.
     3438       else do:
     3439         for each buf_temp-diasize-handle
     3440         on error undo move_block, retry move_block
     3441         :
     3442           assign
     3443             v-object-handle = buf_temp-diasize-handle.handle-value
     3444           .
     3445           if v-object-handle <> v-diasize-resize-button
     3446           then do:
     3447             assign
     3448               v-object-handle :col = v-object-handle :col + p-change-value
     3449               no-error .
     3450             if error-status :error
     3451             or error-status :get-message(1) <> ""
     3452             then do:
     3453               undo move_block, retry move_block .
     3454             end.
     3455           end.
     3456         end.
     3457         for each buf_temp-browse-handle
     3458           where buf_temp-browse-handle.browse-type = 'width':u
     3459         on error undo move_block, retry move_block
     3460         :
     3461           assign
     3462             buf_temp-browse-handle.browse-handle :width
     3463               = buf_temp-browse-handle.browse-handle :width + p-change-value
     3464             no-error .
     3465           if error-status :error
     3466           or error-status :get-message(1) <> ""
     3467           then do:
     3468             undo move_block, retry move_block .
     3469           end.
     3470         end.
     3471         assign
     3472           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     3473           no-error .
     3474         if error-status :error
     3475         or error-status :get-message(1) <> ""
     3476         then do:
     3477           undo move_block, retry move_block.
     3478         end.
     3479         assign
     3480           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     3481         no-error .
     3482         if error-status :error
     3483         or error-status :get-message(1) <> ""
     3484         then do:
     3485           undo move_block, retry move_block.
     3486         end.
     3487         if frame Dialog-Frame :scrollable = true
     3488         then do:
     3489           assign
     3490             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     3491           no-error .
     3492           if error-status :error
     3493           or error-status :get-message(1) <> ""
     3494           then do:
     3495             undo move_block, retry move_block.
     3496           end.
     3497         end.
     3498       end.
     3499       if p-move-resize
     3500       then do:
     3501         run diasize_position-resize-button in this-procedure .
     3502       end.
     3503       if v-diasize-wndstore = true
     3504       then do:
     3505         if connected("ub") = true
     3506         then do:
     3507           define variable v-cntxt-db-num        as integer   no-undo .
     3508           define variable v-cntxt-userid        as character no-undo .
     3509           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3510                                             , OUTPUT v-cntxt-userid
     3511                                             ) .
     3512           run gbl/wndsizew.p
     3513             (input  v-cntxt-db-num
     3514             ,input  v-cntxt-userid
     3515             ,input  v-diasize-proc-name
     3516             ,input  'width':u
     3517             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     3518             ) .
     3519         end.
     3520       end.
     3521     end.
     3522     assign
     3523       v-diasize-change-size = false
     3524     .
     3525   end procedure.
     3526   procedure diasize_set-width :
     3527     define input  parameter p-new-width  as decimal   no-undo .
     3528     define input  parameter p-move-resize as logical   no-undo .
     3529     do
     3530     on error undo, return error return-value
     3531     :
     3532       run diasize_change-width in this-procedure
     3533         (input  (p-new-width - frame Dialog-Frame :width)
     3534         ,input  p-move-resize
     3535         ) .
     3536     end.
     3537   end procedure.
     3538   procedure diasize_position-resize-button :
     3539     do with frame Dialog-Frame
     3540     :
     3541       hide v-diasize-resize-button .
     3542       assign
     3543         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     3544                     - 1
     3545                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     3546         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     3547                     - 1
     3548                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     3549       .
     3550       view v-diasize-resize-button .
     3551     end.
     3552   end procedure.
     3553   on alt-right anywhere
     3554   do:
     3555     run diasize_change-width in this-procedure
     3556       (input 1
     3557       ,input true
     3558       ) .
     3559     return no-apply .
     3560   end.
     3561   on alt-left anywhere
     3562   do:
     3563     run diasize_change-width in this-procedure
     3564       (input -1
     3565       ,input true
     3566       ) .
     3567     return no-apply .
     3568   end.
     3569   on alt-down anywhere
     3570   do:
     3571     run diasize_change-height in this-procedure
     3572       (input 1
     3573       ,input true
     3574       ) .
     3575     return no-apply .
     3576   end.
     3577   on alt-up anywhere
     3578   do:
     3579     run diasize_change-height in this-procedure
     3580       (input -1
     3581       ,input true
     3582       ) .
     3583     return no-apply .
     3584   end.
     3585   on alt-enter of frame Dialog-Frame
     3586   do:
     3587     run diasize_maximize in this-procedure
     3588       (input  ?
     3589       ).
     3590     return no-apply .
     3591   end.
     3592   procedure diasize_end-move :
     3593     do
     3594     on error undo, return error return-value
     3595     :
     3596       define variable v-row-delta as decimal   no-undo .
     3597       define variable v-col-delta as decimal   no-undo .
     3598       define variable v-new-row as decimal   no-undo .
     3599       define variable v-new-col as decimal   no-undo .
     3600       assign
     3601         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     3602         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     3603       .
     3604       assign
     3605         v-row-delta = v-new-row - frame Dialog-Frame :height
     3606         v-col-delta = v-new-col - frame Dialog-Frame :width
     3607       .
     3608       run diasize_change-height in this-procedure
     3609         (input v-row-delta
     3610         ,input true
     3611         ) .
     3612       run diasize_change-width in this-procedure
     3613         (input v-col-delta
     3614         ,input true
     3615         ) .
     3616     end.
     3617   end procedure.
     3618   procedure diasize_maximize :
     3619     define input  parameter p-action as logical   no-undo .
     3620     do
     3621     on error undo, return error return-value
     3622     :
     3623       if p-action = ?
     3624       then do:
     3625         if v-diasize-need-maximize = true
     3626         then do:
     3627           assign
     3628             p-action = true
     3629           .
     3630         end.
     3631         else do:
     3632           assign
     3633             p-action = false
     3634           .
     3635         end.
     3636       end.
     3637       if p-action = true
     3638       then do:
     3639         run diasize_change-height in this-procedure
     3640           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     3641               - frame Dialog-Frame :height-chars
     3642           ,input true
     3643           ) .
     3644         run diasize_change-width in this-procedure
     3645           (input session :width-chars
     3646               - frame Dialog-Frame :width-chars
     3647           ,input true
     3648           ) .
     3649         assign
     3650           v-diasize-need-maximize = false
     3651         .
     3652       end.
     3653       else do:
     3654         run diasize_change-width in this-procedure
     3655           (input v-diasize-orig-frame-width
     3656               - frame Dialog-Frame :width-chars
     3657           ,input true
     3658           ) .
     3659         run diasize_change-height in this-procedure
     3660           (input v-diasize-orig-frame-height
     3661               - frame Dialog-Frame :height-chars
     3662           ,input true
     3663           ) .
     3664         assign
     3665           v-diasize-need-maximize = true
     3666         .
     3667       end.
     3668     end.
     3669   end procedure.
     3670   procedure diasize_restore-orig-size :
     3671     do
     3672     on error undo, return error return-value
     3673     :
     3674       assign
     3675         v-diasize-current-frame-width  = frame Dialog-Frame :width
     3676         v-diasize-current-frame-height = frame Dialog-Frame :height
     3677       .
     3678       run diasize_set-height in this-procedure
     3679         (input  v-diasize-orig-frame-height
     3680         ,input  true
     3681         ) .
     3682       run diasize_set-width in this-procedure
     3683         (input  v-diasize-orig-frame-width
     3684         ,input  true
     3685         ) .
     3686     end.
     3687   end procedure.
     3688   procedure diasize_restore-current-size :
     3689     do
     3690     on error undo, return error return-value
     3691     :
     3692       run diasize_set-height in this-procedure
     3693         (input  v-diasize-current-frame-height
     3694         ,input  true
     3695         ) .
     3696       run diasize_set-width in this-procedure
     3697         (input  v-diasize-current-frame-width
     3698         ,input  true
     3699         ) .
     3700     end.
     3701   end procedure.
     3702   procedure diasize_set-browse-handle :
     3703     define input  parameter p-browse-handle as handle   no-undo .
     3704     define buffer buf_temp-browse-handle for temp-browse-handle .
     3705     do
     3706     on error undo, return error return-value
     3707     :
     3708       assign
     3709         v-diasize-browse-handle = p-browse-handle
     3710       .
     3711       for each buf_temp-browse-handle
     3712       on error undo, return error return-value
     3713       :
     3714         delete buf_temp-browse-handle .
     3715       end.
     3716     end.
     3717   end procedure.
     3718   procedure diasize_add_browse :
     3719     define input  parameter p-browse-type   as character no-undo .
     3720     define input  parameter p-browse-handle as handle    no-undo .
     3721     define buffer buf_temp-browse-handle for temp-browse-handle .
     3722     do
     3723     on error undo, return error return-value
     3724     :
     3725       assign
     3726         v-diasize-browse-number = v-diasize-browse-number + 1
     3727       .
     3728       create buf_temp-browse-handle .
     3729       assign
     3730         buf_temp-browse-handle.browse-type   = p-browse-type
     3731         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     3732         buf_temp-browse-handle.browse-handle = p-browse-handle
     3733       .
     3734     end.
     3735   end procedure.
     3736   procedure diasize_init :
     3737     define variable v-default-value    as logical   no-undo .
     3738     define variable v-restore-saved    as logical   no-undo .
     3739     define variable v-resize-value-str as character no-undo .
     3740     do
     3741     on error undo, return error return-value
     3742     :
     3743       do with frame Dialog-Frame
     3744       :
     3745         assign
     3746           v-diasize-orig-frame-height = frame Dialog-Frame :height
     3747           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     3748           v-diasize-browse-handle     = browse br-fin-doc :handle
     3749         .
     3750         create button v-diasize-resize-button
     3751         assign
     3752           parent        = frame Dialog-Frame :first-child
     3753           label         = "s"
     3754           height-pixels = 16
     3755           width-pixels  = 16
     3756           visible       = true
     3757           sensitive     = true
     3758           movable       = true
     3759           triggers:
     3760             on end-move persistent run diasize_end-move in this-procedure .
     3761           end triggers.
     3762         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     3763         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     3764         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     3765         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     3766         assign
     3767           v-diasize-wndmax = false
     3768         .
     3769         if connected("ub") = true
     3770         then do:
     3771           define variable v-cntxt-db-num        as integer   no-undo .
     3772           define variable v-cntxt-userid        as character no-undo .
     3773           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3774                                             , OUTPUT v-cntxt-userid
     3775                                             ) .
     3776           run gbl/wndpar_r.p
     3777             (input  v-cntxt-db-num
     3778             ,input  v-cntxt-userid
     3779             ,input  'wndmax':U
     3780             ,output v-diasize-wndmax
     3781             ,output v-default-value
     3782             ) .
     3783         end.
     3784         assign
     3785           v-diasize-wndstore = false
     3786         .
     3787         if connected("ub") = true
     3788         then do:
     3789           run gbl/wndpar_r.p
     3790             (input  v-cntxt-db-num
     3791             ,input  v-cntxt-userid
     3792             ,input  'wndstore':U
     3793             ,output v-diasize-wndstore
     3794             ,output v-default-value
     3795             ) .
     3796         end.
     3797         assign
     3798           v-diasize-proc-name = entry(1, program-name(2), '.')
     3799         .
     3800         if v-diasize-wndstore = true
     3801         then do:
     3802           assign
     3803             v-restore-saved = false
     3804           .
     3805           if connected("ub") = true
     3806           then do:
     3807             run gbl/wndsizer.p
     3808               (input  v-cntxt-db-num
     3809               ,input  v-cntxt-userid
     3810               ,input  v-diasize-proc-name
     3811               ,input  'height':u
     3812               ,output v-resize-value-str
     3813               ) .
     3814             if v-resize-value-str <> '':U
     3815             then do:
     3816               run diasize_change-height in this-procedure
     3817                 (input  integer(v-resize-value-str)
     3818                 ,input  true
     3819                 ) .
     3820               assign
     3821                 v-restore-saved = true
     3822               .
     3823             end.
     3824           end.
     3825           if connected("ub") = true
     3826           then do:
     3827             run gbl/wndsizer.p
     3828               (input  v-cntxt-db-num
     3829               ,input  v-cntxt-userid
     3830               ,input  v-diasize-proc-name
     3831               ,input  'width':u
     3832               ,output v-resize-value-str
     3833               ) .
     3834             if v-resize-value-str <> '':U
     3835             then do:
     3836               run diasize_change-width in this-procedure
     3837                 (input  integer(v-resize-value-str)
     3838                 ,input  true
     3839                 ) .
     3840               assign
     3841                 v-restore-saved = true
     3842               .
     3843             end.
     3844           end.
     3845           if v-restore-saved <> true
     3846           then do:
     3847             if v-diasize-wndmax = true
     3848             then do:
     3849               run diasize_maximize in this-procedure
     3850                 (input  true
     3851                 ) .
     3852             end.
     3853           end.
     3854         end.
     3855         else do:
     3856           if v-diasize-wndmax = true
     3857           then do:
     3858             run diasize_maximize in this-procedure
     3859               (input  true
     3860               ) .
     3861           end.
     3862         end.
     3863       end.
     3864     end.
     3865   end procedure.
     3866   procedure diasize_need-full-display :
     3867     define output parameter p-need-full-display as logical   no-undo .
     3868     do
     3869     on error undo, return error return-value
     3870     :
     3871       assign
     3872         p-need-full-display = v-diasize-need-full-display
     3873       .
     3874       assign
     3875         v-diasize-need-full-display = false
     3876       .
     3877     end.
     3878   end procedure.
     3879   procedure get-context :
     3880      define output parameter p-db-num as integer          no-undo.
     3881      define output parameter p-user-id as character        no-undo.
     3882      define variable v-login               as character    no-undo.
     3883      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     3884      define buffer buf_user-login  for ub.user-login .
     3885      do
     3886      on error undo, return error
     3887      :
     3888            FIND FIRST buf_sys-ctrl no-lock.
     3889            ASSIGN
     3890               v-login = USERID("ub")
     3891               p-db-num = buf_sys-ctrl.db-num
     3892            .
     3893            FIND FIRST buf_user-login
     3894                 WHERE buf_user-login.db-num = p-db-num
     3895                   AND buf_user-login.user-login = v-login
     3896                 no-lock
     3897                 no-error
     3898                 .
     3899            IF AVAILABLE buf_user-login
     3900            THEN DO:
     3901               assign
     3902                  p-user-id = buf_user-login.user-id
     3903               .
     3904            END.
     3905      end.
     3906   end procedure.
     3907       run diasize_init in this-procedure .
