     8250   PROCEDURE proc-print-list :
     8251   define variable v-doc-rec as recid no-undo .
     8252   define variable accum-count as integer.
     8253   define variable date_string     as      char    no-undo.
     8254   define variable Line            as      char    no-undo.
     8255   define variable v-receiver as character no-undo.
     8256   define variable v-payer as character no-undo.
     8257   define variable v-contract as character no-undo.
     8258   define variable v-curr-abbr as character no-undo.
     8259   define variable v-obj as character no-undo .
     8260   run rep/g-fin-doc-list.p (parParentProc) no-error.
     8261   END PROCEDURE.
     8262   PROCEDURE proc-print-one :
     8263   define variable v-doc-rec as recid no-undo .
     8264   define variable accum-count as integer no-undo .
     8265   define variable v-format as integer no-undo .
     8266   define variable ii as integer no-undo .
     8267   if not available X_fin-doc then return error.
     8268   define buffer buf_fin-doc  for ub.fin-doc.
     8269   CASE t-batch:
     8270     when no then do:
     8271       run rep/findocp.p (
     8272                       INPUT parParentProc
     8273                       ,input X_fin-doc.host-code
     8274                       ,input X_fin-doc.fin-doc-code
     8275                       ,input T-batch
     8276                       ,input no
     8277                       ,input no
     8278                       ,input-output v-format
     8279                     ) no-error.
     8280       if error-status:error then do:
     8281         return error.
     8282       end.
     8283     end.
     8284     when  yes then do:
     8285       if v-rid-list = "":U then do:
     8286           message
     8287           "Вы не отметили ни одного платежа"
     8288           view-as alert-box error.
     8289           return error.
     8290       end.
     8291       run waitfram-show in this-procedure ( input "Ждите...").
     8292       v-doc-rec = recid(X_fin-doc).
     8293       run prn-lib-open-stream  in this-procedure (
     8294                                                   input parParentProc
     8295                                                   ,input 43
     8296                                                   ,input yes
     8297                                                   ,input no
     8298                                                   ).
     8299       output  STREAM PrnLibStream CLOSE.
     8300       assign
     8301       v-format = ?
     8302       .
     8303       _do:
     8304       do ii = 1 to num-entries(v-rid-list):
     8305         find first buf_fin-doc no-lock where
     8306                   recid(buf_fin-doc) = integer(entry(ii, v-rid-list)) no-error .
     8307         if available buf_fin-doc then do:
     8308           run rep/findocp.p (
     8309                           INPUT parParentProc
     8310                           ,input buf_fin-doc.host-code
     8311                           ,input buf_fin-doc.fin-doc-code
     8312                           ,input T-batch
     8313                           ,input (if T-batch and (ii = num-entries(v-rid-list))
     8314                             then yes
     8315                             else no)
     8316                           ,input no
     8317                           ,input-output v-format
     8318                         ) no-error.
     8319           if error-status:error or v-format = ? then do:
     8320             next _do .
     8321           end.
     8322           assign
     8323           accum-count = accum-count + 1
     8324           .
     8325         end.
     8326       end.
     8327       run prn-lib-prn-file in this-procedure (
     8328                                                      input parParentProc
     8329                                                     ,input (if v-format = 0 then 0 else 8)
     8330                                                    ).
     8331       run waitfram-hide in this-procedure .
     8332       APPLY "entry" to br-fin-doc in frame Dialog-Frame .
     8333     end.
     8334   END CASE.
     8335   END PROCEDURE.
     8336   PROCEDURE proc-print-one-graphics :
     8337   define variable varxmldocfl      as character no-undo.
     8338   define variable varxmldocfl-type as character no-undo.
     8339   define variable varpar-type as character no-undo.
     8340   define variable for-dir as character no-undo .
     8341   define variable accum-count as integer no-undo .
     8342   define variable accum-count-ok as integer no-undo .
     8343   define variable loclog as logical no-undo .
     8344   define variable ii as integer no-undo .
     8345   define variable ii0 as integer no-undo .
     8346   define variable v-template-code as character no-undo .
     8347   define variable v-copy-nums as integer no-undo .
     8348   define variable v-add-info as character no-undo .
     8349   define variable v-full-path        as character no-undo .
     8350   define variable v-path             as character no-undo .
     8351   define variable v-file-name        as character no-undo .
     8352   define variable v-file-name-no-ext as character no-undo .
     8353   define variable v-file-name-ext    as character no-undo .
     8354   define buffer buf_fin-doc for ub.fin-doc.
     8355   if not available X_fin-doc then do:
     8356     message "Неправильный выбор документа.".
     8357     return no-apply.
     8358   end.
     8359   run gbl/filename.p (
     8360                   input "fxmldoc.bat"
     8361                   ,output v-full-path
     8362                   ,output v-path
     8363                   ,output v-file-name
     8364                   ,output v-file-name-no-ext
     8365                   ,output v-file-name-ext
     8366                   ) no-error .
     8367   if error-status:error  = ? then do:
     8368     message
     8369     substitute("Не найден командный файл для графической печати платежей fxmldoc.bat:&1 &2", chr(10), return-value )
     8370     view-as alert-box error .
     8371     return error .
     8372   end.
     8373   if t-batch then
     8374   ii0 = num-entries(v-rid-list).
     8375   else ii0 = 1.
     8376   run ref/findocgp.w (
     8377                   input X_fin-doc.fin-doc-type
     8378                  ,input X_fin-doc.fin-ext-doc-type
     8379                  ,input ii0
     8380                  ,output v-template-code
     8381                  ,output v-copy-nums
     8382                  ,output v-add-info) no-error.
     8383   if error-status:error
     8384   or v-template-code = "":U
     8385   then do:
     8386     undo, return error.
     8387   end.
     8388   CASE t-batch:
     8389     when no then do:
     8390       assign
     8391       v-file-name = ?
     8392       .
     8393       run str/xmlfdoc.p ( input X_fin-doc.host-code
     8394                          ,input  X_fin-doc.fin-doc-code
     8395                          ,input-output v-file-name
     8396                          ,input  yes
     8397                          ,input  yes) no-error .
     8398       if not error-status:error then do:
     8399         os-command silent value(search ("fxmldoc.bat") + chr(32)
     8400                                        + v-full-path + chr(32)
     8401                                        + v-file-name + chr(32)
     8402                                        + v-template-code + chr(32)
     8403                                        + string(v-copy-nums) + chr(32)
     8404                                        + v-add-info
     8405                                        ).
     8406         if os-error = 0 then
     8407         assign
     8408         accum-count-ok = accum-count-ok + 1
     8409         .
     8410       end.
     8411     end.
     8412     when  yes then do:
     8413       if v-rid-list = "":U then do:
     8414           message
     8415           "Вы не отметили ни одного платежа"
     8416           view-as alert-box error.
     8417           return error.
     8418       end.
     8419       run waitfram-show in this-procedure ( input "Ждите...").
     8420       assign
     8421       v-doc-rec = recid(X_fin-doc)
     8422       .
     8423       _do:
     8424       do ii = 1 to ii0:
     8425         run waitfram-show in this-procedure ( substitute("Ждите... Обрабатывается &1-й документ, всего &2", accum-count + 1, ii0)).
     8426         find first buf_fin-doc no-lock where
     8427                   recid(buf_fin-doc) = integer(entry(ii, v-rid-list)) no-error .
     8428         if available buf_fin-doc then do:
     8429           assign
     8430           accum-count = accum-count + 1
     8431           .
     8432           assign
     8433           v-file-name = ?
     8434           .
     8435           run str/xmlfdoc.p (
     8436                           input buf_fin-doc.host-code
     8437                         , input buf_fin-doc.fin-doc-code
     8438                         , input-output v-file-name
     8439                         , input yes
     8440                         , input yes
     8441                         ) no-error .
     8442           if not error-status:error then do:
     8443             os-command silent value(search ("fxmldoc.bat") + chr(32)
     8444                                           + v-full-path + chr(32)
     8445                                           + v-file-name + chr(32)
     8446                                           + v-template-code + chr(32)
     8447                                           + string(v-copy-nums) + chr(32)
     8448                                           + v-add-info
     8449                                           ).
     8450             if os-error = 0 then
     8451             assign
     8452             accum-count-ok = accum-count-ok + 1
     8453             .
     8454           end.
     8455         end.
     8456       end.
     8457       run waitfram-hide in this-procedure .
     8458     end.
     8459   END CASE.
     8460   if error-status:error
     8461   or (t-batch and accum-count <> accum-count-ok)
     8462   then do:
     8463     message
     8464     "Ошибка при печати платежа(-ей) в графике" skip
     8465     string(if t-batch then substitute("Напечатано &1 платежей из &2", accum-count-ok, accum-count) else "":U)
     8466     view-as alert-box .
     8467     if not t-batch then
     8468     return error .
     8469   end.
     8470   END PROCEDURE.
     8471   FUNCTION f-factur RETURNS CHARACTER
     8472     ( buffer loc-t-doc for ub.fin-doc ) :
     8473    if loc-t-doc.cr-factur = yes then do:
     8474      return string (loc-t-doc.factur-date, "99/99/99").
     8475    end.
     8476    else do:
     8477      if loc-t-doc.need-factur = 0 then return "--------".
     8478      if loc-t-doc.need-factur = 1 then return "".
     8479      if loc-t-doc.need-factur = 2 then return "не опред".
     8480    end.
     8481   END FUNCTION.
     8482   FUNCTION factur RETURNS CHARACTER
     8483     ( BUFFER loc-fin-doc FOR ub.fin-doc ) :
     8484    if loc-fin-doc.cr-factur = yes then do:
     8485      return string (loc-fin-doc.factur-date, "99/99/99").
     8486    end.
     8487    else do:
     8488      if loc-fin-doc.need-factur = 0 then return "--------".
     8489      if loc-fin-doc.need-factur = 1 then return "".
     8490      if loc-fin-doc.need-factur = 2 then return "не опред".
     8491    end.
     8492    RETURN "".
     8493   END FUNCTION.
     8494   FUNCTION get-cashbookname RETURNS CHARACTER
     8495     ( input iCashbookID as int64) :
     8496   define buffer buf_cashbook for ub.cashbook.
     8497     find first buf_cashbook no-lock where
     8498                   buf_cashbook.id = iCashbookID
     8499        no-error.
     8500     if available buf_cashbook
     8501     then return buf_cashbook.CashBookName.
     8502     else return string(iCashbookID).
     8503   END FUNCTION.
     8504   FUNCTION get-contract RETURNS CHARACTER
     8505     ( BUFFER loc-fin-doc FOR ub.fin-doc ) :
     8506   define buffer buf_contract for ub.contract.
     8507     find first buf_contract no-lock where
     8508                   buf_contract.host-code = loc-fin-doc.host-code
     8509               AND buf_contract.contract-code = loc-fin-doc.contract-code no-error.
     8510       if available buf_contract then return buf_contract.contract-prn-code.
     8511     RETURN "".
     8512   END FUNCTION.
     8513   FUNCTION get-currency RETURNS CHARACTER
     8514     ( BUFFER loc-fin-doc FOR ub.fin-doc ) :
     8515    define buffer buf_currency for ub.currency.
     8516     find first buf_currency no-lock where
     8517                   buf_currency.curr-code = loc-fin-doc.curr-code no-error.
     8518       if available buf_currency then return buf_currency.curr-abbr.
     8519     RETURN string(loc-fin-doc.curr-code).
     8520   END FUNCTION.
     8521   FUNCTION get-shift RETURNS DATE
     8522     ( BUFFER buf_fin-doc FOR ub.fin-doc, OUTPUT p-shift-name-num AS CHARACTER) :
     8523   define variable v-fin-doc-shift-name-num as character no-undo.
     8524   define variable v-fin-doc-shift-name as character no-undo .
     8525   IF buf_fin-doc.shift-date = ? THEN DO:
     8526      RETURN ?.
     8527   END.
     8528   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:   run str/lib-trn3.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:     message       "Error starting lib-trn3.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn3_shiftnam in g#lib-trn3
     8529     (
     8530        input buf_fin-doc.obj-type
     8531     ,  input buf_fin-doc.obj-code
     8532     ,  input buf_fin-doc.shift-date
     8533     ,  input buf_fin-doc.shift-num
     8534     , output v-fin-doc-shift-name
     8535     , output v-fin-doc-shift-name-num
     8536     )        no-error .
     8537   ASSIGN
     8538   p-shift-name-num = v-fin-doc-shift-name-num
     8539    .
     8540   RETURN buf_fin-doc.shift-date.
     8541   END FUNCTION.
