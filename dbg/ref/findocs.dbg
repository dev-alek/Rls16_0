     1678        IMAGE-UP FILE "btn-down-arrow":U
     1679        IMAGE-DOWN FILE "btn-down-arrow":U
     1680        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
     1681        LABEL "Btn 1"
     1682        SIZE 3 BY 1.
     1683   DEFINE BUTTON B-client
     1684        LABEL "&Контраг."
     1685        SIZE 10 BY 1.
     1686   DEFINE BUTTON B-close
     1687        LABEL "&Закрыть"
     1688        SIZE 10 BY 1.
     1689   DEFINE BUTTON B-curr
     1690        IMAGE-UP FILE "btn-down-arrow":U
     1691        IMAGE-DOWN FILE "btn-down-arrow":U
     1692        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
     1693        LABEL "Btn 1"
     1694        SIZE 3 BY 1.
     1695   DEFINE BUTTON B-del
     1696        LABEL "&Удалить"
     1697        SIZE 10 BY 1.
     1698   DEFINE BUTTON B-exp
     1699        LABEL "&Экспорт"
     1700        SIZE 10 BY 1.
     1701   DEFINE BUTTON B-factura
     1702        LABEL "Счет-факт"
     1703        SIZE 10 BY 1.
     1704   DEFINE BUTTON B-Help
     1705        LABEL "Помо&щь"
     1706        SIZE 3 BY 1
     1707        BGCOLOR 8 .
     1708   DEFINE BUTTON B-hist
     1709        LABEL "Ис&тория"
     1710        SIZE 3 BY 1.
     1711   DEFINE BUTTON b-incas
     1712        LABEL "Инкассация"
     1713        SIZE 14 BY 1.
     1714   DEFINE BUTTON b-lookup
     1715        LABEL "&Просмотр"
     1716        SIZE 10 BY 1.
     1717   DEFINE BUTTON B-mark
     1718        LABEL "&*"
     1719        SIZE 3 BY 1.
     1720   DEFINE BUTTON B-open
     1721        LABEL "&Открыть"
     1722        SIZE 10 BY 1.
     1723   DEFINE BUTTON B-print
     1724        LABEL "Пе&чать"
     1725        SIZE 3 BY 1.
     1726   DEFINE BUTTON b-quit AUTO-END-KEY
     1727        LABEL "&Выход"
     1728        SIZE 10 BY 1
     1729        BGCOLOR 8 .
     1730   DEFINE BUTTON B-reject
     1731        LABEL "&-Отказ"
     1732        SIZE 10 BY 1.
     1733   DEFINE BUTTON B-sch
     1734        LABEL "&Фильтр"
     1735        SIZE 3 BY 1.
     1736   DEFINE BUTTON B-schet
     1737        LABEL "&Счета"
     1738        SIZE 10 BY 1.
     1739   DEFINE BUTTON b-sel AUTO-GO
     1740        LABEL "Вы&бор"
     1741        SIZE 10 BY 1
     1742        BGCOLOR 8 .
     1743   DEFINE VARIABLE ED-notes AS CHARACTER
     1744        VIEW-AS EDITOR SCROLLBAR-VERTICAL
     1745        SIZE 98 BY 2
     1746        BGCOLOR 8 FGCOLOR 4  NO-UNDO.
     1747   DEFINE VARIABLE mark-num AS CHARACTER FORMAT "X(256)":U
     1748         VIEW-AS TEXT
     1749        SIZE 6 BY 1
     1750        FGCOLOR 4  NO-UNDO.
     1751   DEFINE VARIABLE sch-BIK AS CHARACTER FORMAT "X(9)":U
     1752        LABEL "БИК"
     1753        VIEW-AS FILL-IN
     1754        SIZE 12 BY 1 TOOLTIP "Поиск первой записи - <ВВОД>; поиск следующей - <CTRL-J>" NO-UNDO.
     1755   DEFINE VARIABLE sch-c-schet AS CHARACTER FORMAT "X(9)":U
     1756        LABEL "Корр.счет"
     1757        VIEW-AS FILL-IN
     1758        SIZE 22 BY 1 TOOLTIP "Поиск первой записи - <ВВОД>; поиск следующей - <CTRL-J>" NO-UNDO.
     1759   DEFINE VARIABLE sch-cli-code AS INTEGER FORMAT ">>>>>>>>9":U INITIAL 0
     1760        LABEL "код"
     1761        VIEW-AS FILL-IN
     1762        SIZE 11 BY .91 NO-UNDO.
     1763   DEFINE VARIABLE sch-curr-code AS INTEGER FORMAT ">>9":U INITIAL 0
     1764        LABEL "коду вал"
     1765        VIEW-AS FILL-IN
     1766        SIZE 4 BY 1 NO-UNDO.
     1767   DEFINE VARIABLE sch-doc-date AS DATE FORMAT "99/99/9999":U
     1768        LABEL "Дате док-та"
     1769        VIEW-AS FILL-IN
     1770        SIZE 11 BY 1 NO-UNDO.
     1771   DEFINE VARIABLE sch-fact-date AS DATE FORMAT "99/99/9999":U
     1772        LABEL "Дате факт."
     1773        VIEW-AS FILL-IN
     1774        SIZE 11 BY 1 NO-UNDO.
     1775   DEFINE VARIABLE sch-name AS CHARACTER FORMAT "X(35)":U
     1776        LABEL "нач.назв."
     1777        VIEW-AS FILL-IN
     1778        SIZE 31 BY 1 TOOLTIP "Поиск первой записи - <ВВОД>; поиск следующей - <CTRL-J>" NO-UNDO.
     1779   DEFINE VARIABLE sch-pay-date AS DATE FORMAT "99/99/9999":U
     1780        LABEL "Дате плат."
     1781        VIEW-AS FILL-IN
     1782        SIZE 11 BY 1 NO-UNDO.
     1783   DEFINE VARIABLE sch-prn-doc-code AS CHARACTER FORMAT "X(16)":U
     1784        LABEL "номеру"
     1785        VIEW-AS FILL-IN
     1786        SIZE 8 BY 1 TOOLTIP "Поиск первой записи - <ВВОД>; поиск следующей - <CTRL-J>" NO-UNDO.
     1787   DEFINE VARIABLE sch-r-schet AS CHARACTER FORMAT "X(35)":U
     1788        LABEL "Расч.счет"
     1789        VIEW-AS FILL-IN
     1790        SIZE 22 BY 1 TOOLTIP "Поиск первой записи - <ВВОД>; поиск следующей - <CTRL-J>" NO-UNDO.
     1791   DEFINE VARIABLE RS-cli-type AS CHARACTER
     1792        VIEW-AS RADIO-SET HORIZONTAL
     1793        RADIO-BUTTONS
     1794             "Item 1", "1",
     1795   "Item 1", "2"
     1796        SIZE 14.2 BY 1.05 NO-UNDO.
     1797   DEFINE VARIABLE RS-list AS CHARACTER
     1798        VIEW-AS RADIO-SET HORIZONTAL
     1799        RADIO-BUTTONS
     1800             "Item 1", "1",
     1801   "Item 2", "2",
     1802   "Item 3", "3",
     1803   "Item 4", "4"
     1804        SIZE 72.2 BY .86
     1805        FGCOLOR 4  NO-UNDO.
     1806   DEFINE VARIABLE RS-receiver-payer AS CHARACTER
     1807        VIEW-AS RADIO-SET HORIZONTAL
     1808        RADIO-BUTTONS
     1809             "Item 1", "1",
     1810   "Item 1", "2"
     1811        SIZE 26.8 BY 1 NO-UNDO.
     1812   DEFINE VARIABLE T-batch AS LOGICAL INITIAL no
     1813        LABEL "Пктн.рж"
     1814        VIEW-AS TOGGLE-BOX
     1815        SIZE 10.6 BY 1 TOOLTIP "Пакетная обработка выбранных платежей" NO-UNDO.
     1816   DEFINE NEW SHARED QUERY br-fin-doc FOR
     1817                   X_fin-doc SCROLLING.
     1818   DEFINE BROWSE br-fin-doc
     1819     QUERY br-fin-doc DISPLAY
     1820         mark-string(recid(X_fin-doc), v-rid-list) FORMAT "X(1)":U
     1821   X_fin-doc.host-code COLUMN-LABEL "Код!фирмы" FORMAT "999999999":U
     1822   X_fin-doc.prn-doc-code FORMAT "X(16)":U
     1823   X_fin-doc.fin-doc-type FORMAT "X(3)":U
     1824   X_fin-doc.doc-date FORMAT "99/99/9999":U
     1825   X_fin-doc.status_ FORMAT "X(8)":U
     1826   X_fin-doc.receiver-type + string(X_fin-doc.receiver-code) COLUMN-LABEL "Получатель" FORMAT "X(12)":U
     1827   X_fin-doc.receiver-name COLUMN-LABEL "Название ПОЛУЧАТЕЛЯ" FORMAT "X(40)":U
     1828   X_fin-doc.perm-date FORMAT "99/99/9999":U
     1829   X_fin-doc.pay-date COLUMN-LABEL "Дата платежа!(пост.в банк)" FORMAT "99/99/9999":U
     1830   X_fin-doc.fact-date FORMAT "99/99/9999":U
     1831   X_fin-doc.sttm-code COLUMn-LABEL "Выписка"
     1832   X_fin-doc.sum-doc FORMAT ">,>>>,>>>,>>>,>>9.99":U
     1833   X_fin-doc.fin-ext-doc-type COLUMN-LABEL "Расш.тип" FORMAT "X(8)":U
     1834   get-contract(buffer X_fin-doc) COLUMN-LABEL "Договор" FORMAT "X(16)":U
     1835   X_fin-doc.payer-type + string(X_fin-doc.payer-code) COLUMN-LABEL "Плательщик" FORMAT "X(12)":U
     1836   X_fin-doc.payer-name COLUMN-LABEL "Название ПЛАТЕЛЬЩИКА" FORMAT "X(40)":U
     1837   get-currency(buffer X_fin-doc) COLUMN-LABEL "Вал" FORMAT "X(3)":U
     1838   if X_fin-doc.obj-code <> 0 then (X_fin-doc.obj-type + string(X_fin-doc.obj-code)) else "":U COLUMN-LABEL "Объект" FORMAT "X(12)":U
     1839   X_fin-doc.fin-doc-code COLUMN-LABEL "Вн.N" FORMAT "999999999":U
     1840   f-factur(buffer X_fin-doc) COLUMN-LABEL "Счет-фактура" FORMAT "X(8)":U
     1841   get-shift(BUFFER X_fin-doc, OUTPUT v-fin-doc-shift-name-num) COLUMN-LABEL "Дата смены" FORMAT "99/99/9999":U
     1842   v-fin-doc-shift-name-num COLUMN-LABEL "Смена" FORMAT "X(6)"
     1843   X_fin-doc.trn-doc-code COLUMN-LABEL "Опер.касса" FORMAT "X(8)"
     1844   get-CashbookName(X_fin-doc.cashbookid) COLUMN-LABEL "Кассовая книга" FORMAT "x(30)":U
     1845   ENABLE
     1846   X_fin-doc.prn-doc-code
     1847       WITH NO-ROW-MARKERS SEPARATORS SIZE 97.6 BY 12.38.
     1848   DEFINE FRAME Dialog-Frame
     1849        b-quit AT ROW 1 COL 1
     1850        B-mark AT ROW 1 COL 11
     1851        b-sel AT ROW 1 COL 21
     1852        B-add AT ROW 1 COL 31
     1853        b-lookup AT ROW 1 COL 41
     1854        B-chg AT ROW 1 COL 51
     1855        B-del AT ROW 1 COL 61
     1856        B-factura AT ROW 1 COL 71
     1857        B-print AT ROW 1 COL 86
     1858        B-hist AT ROW 1 COL 89
     1859        B-sch AT ROW 1 COL 92
     1860        B-Help AT ROW 1 COL 95
     1861        T-batch AT ROW 2 COL 1
     1862        B-close AT ROW 2 COL 11
     1863        B-open AT ROW 2 COL 21
     1864        B-reject AT ROW 2 COL 31
     1865        B-client AT ROW 2 COL 41
     1866        B-schet AT ROW 2 COL 51
     1867        B-attr AT ROW 2 COL 61
     1868        B-exp AT ROW 2 COL 71
     1869        b-incas AT ROW 2 COL 81 WIDGET-ID 2
     1870        br-fin-doc AT ROW 3.05 COL 1.4
     1871        ED-notes AT ROW 15.52 COL 1 NO-LABEL
     1872        RS-list AT ROW 17.57 COL 1.2 NO-LABEL
     1873        sch-prn-doc-code AT ROW 17.57 COL 88.6 COLON-ALIGNED
     1874        sch-curr-code AT ROW 18.57 COL 9 COLON-ALIGNED
     1875        B-curr AT ROW 18.57 COL 15.6
     1876        sch-doc-date AT ROW 18.57 COL 38.2 COLON-ALIGNED
     1877        sch-fact-date AT ROW 18.57 COL 62 COLON-ALIGNED
     1878        sch-pay-date AT ROW 18.57 COL 86 COLON-ALIGNED
     1879        sch-c-schet AT ROW 19.76 COL 40.8 COLON-ALIGNED
     1880        RS-receiver-payer AT ROW 19.81 COL 1.6 NO-LABEL
     1881        sch-r-schet AT ROW 19.81 COL 75.2 COLON-ALIGNED
     1882        sch-BIK AT ROW 20.91 COL 7.6 COLON-ALIGNED
     1883        sch-cli-code AT ROW 20.91 COL 26 COLON-ALIGNED
     1884        RS-cli-type AT ROW 20.91 COL 39.6 NO-LABEL
     1885        sch-name AT ROW 20.91 COL 66.2 COLON-ALIGNED
     1886        B-cli AT ROW 20.95 COL 53
     1887        mark-num AT ROW 1 COL 12.6 COLON-ALIGNED NO-LABEL
     1888        "ПОИСК ПО" VIEW-AS TEXT
     1889             SIZE 8.4 BY 1 AT ROW 17.57 COL 73.8
     1890        SPACE(17.10) SKIP(3.46)
     1891       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1892            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1893            TITLE "Список платежей"
     1894            CANCEL-BUTTON b-quit.
     1895   ASSIGN
     1896          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1897          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1898   ASSIGN
     1899          B-add:POPUP-MENU IN FRAME Dialog-Frame       = MENU MENU-B-add:HANDLE.
     1900   ASSIGN
     1901          B-client:POPUP-MENU IN FRAME Dialog-Frame       = MENU MENU-B-client:HANDLE.
     1902   ASSIGN
     1903          B-factura:POPUP-MENU IN FRAME Dialog-Frame       = MENU MENU-B-factura:HANDLE.
     1904   ASSIGN
     1905          B-print:POPUP-MENU IN FRAME Dialog-Frame       = MENU MENU-B-print:HANDLE.
     1906   ASSIGN
     1907          B-schet:POPUP-MENU IN FRAME Dialog-Frame       = MENU MENU-B-schet:HANDLE.
     1908   ASSIGN
     1909          br-fin-doc:NUM-LOCKED-COLUMNS IN FRAME Dialog-Frame     = 1.
     1910   ON ENDKEY OF FRAME Dialog-Frame
     1911   DO:
     1912       run gbl/markqwa.p (
     1913                              input b-mark:sensitive
     1914                             , input v-rid-list) no-error.
     1915     if error-status:error then return no-apply.
     1916   END.
     1917   ON GO OF FRAME Dialog-Frame
     1918   DO:
     1919     p-rid-list = v-rid-list.
     1920   END.
     1921   ON CHOOSE OF B-add IN FRAME Dialog-Frame
     1922   DO:
     1923     if add-option = '':U then do:
     1924           run gbl/pop-up.p ( input self:handle, input no) no-error.
     1925     end.
     1926     if add-option = '':U then return no-apply.
     1927     run proc-b-add in this-procedure ( input add-option) no-error.
     1928     if error-status:error then do:
     1929       add-option = (if is-type-mode then p-fin-doc-type else  '':U).
     1930       return no-apply.
     1931     end.
     1932     add-option = (if is-type-mode then p-fin-doc-type else "":U).
     1933     APPLY "ENTRY" to br-fin-doc.
     1934   END.
     1935   ON CHOOSE OF B-attr IN FRAME Dialog-Frame
     1936   DO:
     1937   define variable loc-doc-rec as recid no-undo .
     1938     if NOT available X_fin-doc then do:
     1939       message
     1940       "Неправильно выбран платеж."
     1941       view-as alert-box ERROR.
     1942       return no-apply.
     1943     end.
     1944     run ref/fd-atti.w (   input parparentproc
     1945                     ,input 'ПРОСМОТР':U
     1946                     ,input X_fin-doc.host-code
     1947                     ,input X_fin-doc.fin-doc-code
     1948                    ) NO-ERROR.
     1949     apply "entry" to br-fin-doc in frame Dialog-Frame.
     1950   END.
     1951   ON CHOOSE OF B-chg IN FRAME Dialog-Frame
     1952   DO:
     1953   if not available X_fin-doc then return no-apply.
     1954   run proc-b-chg-lookup in this-procedure ( input 'ИЗМЕНЕНИЕ':U) no-error.
     1955   if error-status:error then do:
     1956     return no-apply.
     1957   end.
     1958   END.
     1959   ON CHOOSE OF B-cli IN FRAME Dialog-Frame
     1960   DO:
     1961   define variable ref-list as character no-undo.
     1962   define variable ref-rec as recid no-undo.
     1963   define buffer buf_clients for ub.clients.
     1964     run ref/cli-all.w (
     1965                       input parParentProc
     1966                     ,input "b-sel"
     1967                     ,input RS-cli-type
     1968                     ,input ?
     1969                     ,input ?
     1970                     ,input ?
     1971                     ,input ?
     1972                     ,input "without-obj":U
     1973                     ,output ref-list) .
     1974       if ref-list = "" then   do:
     1975         apply "entry" to b-cli in frame Dialog-Frame.
     1976         return no-apply.
     1977        end.
     1978       ref-rec = integer( ref-list ).
     1979       FIND FIRST buf_clients WHERE recid (buf_clients) = ref-rec NO-LOCK .
     1980       if NOT (buf_clients.obj-type = 'орг':U
     1981               or
     1982               buf_clients.obj-type = 'чел':U ) then do:
     1983         message
     1984         "Выберите контрагента типа" 'орг':U "или" 'чел':U
     1985         view-as alert-box error .
     1986         return no-apply.
     1987       end.
     1988       assign
     1989       RS-cli-type =  buf_clients.obj-type
     1990       sch-cli-code = buf_clients.obj-code
     1991       .
     1992       display
     1993       RS-cli-type
     1994       sch-cli-code
     1995       with frame Dialog-Frame.
     1996   END.
     1997   ON CHOOSE OF B-client IN FRAME Dialog-Frame
     1998   DO:
     1999   define variable v-rid-list as character no-undo.
     2000   if not available X_fin-doc then return no-apply.
     2001   if client-option = '':U then do:
     2002           run gbl/pop-up.p ( input self:handle, input no) no-error.
     2003   end.
     2004   if client-option = '':U then return no-apply.
     2005     run ref/showcli.p ( input parParentProc
     2006                  ,input (if client-option = "receiver" then X_fin-doc.receiver-type else X_fin-doc.payer-type)
     2007                  ,input (if client-option = "receiver" then X_fin-doc.receiver-code else X_fin-doc.payer-code)
     2008                                   ) no-error.
     2009    client-option = '':U.
     2010    APPLY "ENTRY" to br-fin-doc.
     2011   END.
     2012   ON CHOOSE OF B-close IN FRAME Dialog-Frame
     2013   DO:
     2014     if not available X_fin-doc then return no-apply.
     2015     run proc-close-open in this-procedure ( input '<закрытие документа>':U, input t-batch) no-error.
     2016     if error-status:error then return no-apply.
     2017   END.
     2018   ON CHOOSE OF B-curr IN FRAME Dialog-Frame
     2019   DO:
     2020   define variable rr as recid no-undo.
     2021   define buffer buf_currency for ub.currency.
     2022       rr = ? .
     2023       run ref/currency.w ( input parparentproc, input "b-sel", input-output rr ).
     2024       if rr <> ? then do:
     2025         FIND FIRST buf_currency WHERE
     2026               recid( buf_currency ) = rr NO-LOCK .
     2027         DISPLAY
     2028         buf_currency.curr-code @ sch-curr-code
     2029         with frame Dialog-Frame .
     2030       end.
     2031   END.
     2032   ON CHOOSE OF B-del IN FRAME Dialog-Frame
     2033   DO:
     2034     run proc-b-del in this-procedure ( input t-batch) no-error.
     2035     if error-status:error then return no-apply.
     2036   END.
     2037   ON CHOOSE OF B-exp IN FRAME Dialog-Frame
     2038   DO:
     2039     RUN proc-b-exp IN THIS-PROCEDURE NO-ERROR.
     2040     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     2041   END.
     2042   ON CHOOSE OF B-factura IN FRAME Dialog-Frame
     2043   DO:
     2044     if factura-option = '':U then do:
     2045     run gbl/pop-up.p ( input self:handle, input no) no-error.
     2046   end.
     2047   if factura-option = '':U then return no-apply.
     2048   IF NOT AVAILABLE X_fin-doc THEN RETURN NO-APPLY.
     2049   RUN proc-factura IN THIS-PROCEDURE NO-ERROR.
     2050   factura-option = '':U.
     2051   APPLY "ENTRY" to br-fin-doc.
     2052   END.
     2053   ON CHOOSE OF B-hist IN FRAME Dialog-Frame
     2054   DO:
     2055   define variable loc-doc-rec as recid no-undo .
     2056   define variable v-rid-list as character no-undo.
     2057     if NOT available X_fin-doc then do:
     2058       message
     2059       "Неправильно выбран платеж."
     2060       view-as alert-box ERROR.
     2061       return no-apply.
     2062     end.
     2063     loc-doc-rec = recid (X_fin-doc).
     2064     .
     2065     run ref/fincdocs.w
     2066                   (
     2067                    input parParentProc
     2068                   ,input p-curr-host-code
     2069                   ,input "":U
     2070                   ,input "one":U
     2071                   ,input X_fin-doc.host-code
     2072                   ,input p-obj-type
     2073                   ,input p-obj-code
     2074                   ,input X_fin-doc.fin-doc-code
     2075                   ,input-output v-rid-list
     2076                                 )
     2077     .
     2078     reposition br-fin-doc to recid loc-doc-rec no-error.
     2079     apply "entry" to br-fin-doc in frame Dialog-Frame.
     2080     apply "value-changed" to br-fin-doc in frame Dialog-Frame.
     2081   END.
     2082   ON CHOOSE OF b-incas IN FRAME Dialog-Frame
     2083   DO:
     2084     def var loc#log as logical no-undo.
     2085   define variable vss-include-info13 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2086   do:
     2087     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     2088       (input  v-cntxt-db-num
     2089       ,input  v-cntxt-userid
     2090       ,input  0
     2091       ,input  'actn_fin-doc_add-def':U
     2092       ,input  'firm':U
     2093       ,input  p-curr-host-code
     2094       ,input  '':U
     2095       ,input  0
     2096       ,input  0
     2097       ,input  0
     2098       ,input  0
     2099       ,input  true
     2100       ,output loc#log
     2101       )  .
     2102   end.
     2103   if not loc#log then return .
     2104     run utl/rkocollection.p(parparentproc,this-procedure,?) no-error.
     2105     if error-status:error then
     2106       message if return-value <> ""
     2107               then return-value
     2108               else if error-status:get-message(1) <> ""
     2109                    then error-status:get-message(1)
     2110                    else "Неизвестная ошибка"
     2111       view-as alert-box error.
     2112     RUn OpenBR in this-procedure ( input yes, input no, input '':U).
     2113   END.
     2114   ON CHOOSE OF b-lookup IN FRAME Dialog-Frame
     2115   DO:
     2116   if not available X_fin-doc then return no-apply.
     2117   run proc-b-chg-lookup in this-procedure ( input 'ПРОСМОТР':U) no-error.
     2118   if error-status:error then do:
     2119     return no-apply.
     2120   end.
     2121   END.
     2122   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
     2123   DO:
     2124   define variable loc#log as logical no-undo .
     2125     if available X_fin-doc then do:
     2126   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2127   define variable v-str-recid15 as character no-undo .
     2128   define variable v-num-entry15 as integer   no-undo .
     2129   assign
     2130     v-str-recid15 = trim( string( recid( X_fin-doc ) , "->>>>>>>>>>>9":U ) )
     2131     v-num-entry15 = lookup( v-str-recid15 , v-rid-list )
     2132   .
     2133   if v-num-entry15 > 0 then do:
     2134     assign
     2135       entry( v-num-entry15, v-rid-list ) = "":U
     2136       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     2137     .
     2138   end.
     2139   else do:
     2140     assign
     2141       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid15
     2142     .
     2143   end.
     2144       loc#log = br-fin-doc:refresh() .
     2145       if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
     2146           loc#log = br-fin-doc:select-next-row ().
     2147           apply "VALUE-CHANGED" to br-fin-doc in frame Dialog-Frame.
     2148       end.
     2149       if num-entries( v-rid-list ) = 0
     2150       then
     2151           hide mark-num in frame Dialog-Frame.
     2152       else
     2153           disp num-entries( v-rid-list ) @ mark-num with frame Dialog-Frame.
     2154     end.
     2155     apply "entry" to br-fin-doc in frame Dialog-Frame.
     2156   END.
     2157   ON CHOOSE OF B-open IN FRAME Dialog-Frame
     2158   DO:
     2159     if not available X_fin-doc then return no-apply.
     2160     run proc-close-open in this-procedure( input '<открытие документа>':U, input t-batch ) no-error .
     2161     if error-status:error then return no-apply.
     2162   END.
