     8052   PROCEDURE proc-find-date :
     8053   define input parameter p-next as logical no-undo.
     8054   define input parameter p-date like ub.fin-doc.doc-date no-undo.
     8055   define input parameter p-what-date as character no-undo.
     8056   define variable v-date-chr as character no-undo.
     8057   if p-date = ? then return .
     8058   display
     8059   "":U @ sch-BIK
     8060   "":U @ sch-name
     8061   0 @ sch-cli-code
     8062   "":U @ sch-c-schet
     8063   0 @ sch-curr-code
     8064   "":U @ sch-prn-doc-code
     8065   "":U @ sch-r-schet
     8066   with frame Dialog-Frame.
     8067   CASE p-what-date:
     8068       when "doc-date":U then do:
     8069         assign
     8070         sch-pay-date = ?
     8071         sch-fact-date = ?
     8072         .
     8073         display
     8074         sch-fact-date
     8075         sch-pay-date
     8076         with frame Dialog-Frame.
     8077       end.
     8078       when "fact-date":U then do:
     8079         assign
     8080         sch-doc-date = ?
     8081         sch-pay-date = ?
     8082         .
     8083         display
     8084         sch-doc-date
     8085         sch-pay-date
     8086         with frame Dialog-Frame.
     8087       end.
     8088       when "pay-date":U then do:
     8089         assign
     8090         sch-doc-date = ?
     8091         sch-fact-date = ?
     8092         .
     8093         display
     8094         sch-fact-date
     8095         sch-doc-date
     8096         with frame Dialog-Frame.
     8097       end.
     8098   END CASE.
     8099   assign
     8100   v-date-chr = string(day(p-date)) + chr(47) +
     8101                    string(month(p-date)) + chr(47) +
     8102                    string(year(p-date)).
     8103   CASE p-what-date:
     8104       when "doc-date":U then do:
     8105          run OpenBr in this-procedure
     8106           (input false
     8107           ,input true
     8108           ,input substitute("and X_fin-doc.doc-date = &1 "
     8109             , v-date-chr)
     8110           ).
     8111         apply "entry":u to sch-doc-date in frame Dialog-Frame.
     8112       end.
     8113       when "fact-date":U then do:
     8114          run OpenBr in this-procedure
     8115           (input false
     8116           ,input true
     8117           ,input substitute("and X_fin-doc.fact-date = &1 "
     8118             , v-date-chr)
     8119           ).
     8120         apply "entry":u to sch-fact-date in frame Dialog-Frame.
     8121       end.
     8122           when "pay-date":U then do:
     8123          run OpenBr in this-procedure
     8124           (input false
     8125           ,input true
     8126           ,input substitute("and X_fin-doc.pay-date = &1 "
     8127             , v-date-chr)
     8128           ).
     8129         apply "entry":u to sch-pay-date in frame Dialog-Frame.
     8130       end.
     8131   END CASE.
     8132   END PROCEDURE.
