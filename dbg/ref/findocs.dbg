     6441   PROCEDURE proc-b-del :
     6442   define input parameter p-is-batch as logical no-undo .
     6443   define variable loc#log as logical no-undo.
     6444   define variable ii as integer no-undo .
     6445   define variable ok-ii as integer no-undo .
     6446   define variable v-new-rid-list as character no-undo .
     6447   define variable v-doc-rec as recid no-undo.
     6448   define variable v-found-fact as integer no-undo .
     6449   define buffer buf_fin-doc for ub.fin-doc.
     6450   if not available X_fin-doc then return error.
     6451   define variable vss-include-info46 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6452   do:
     6453     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     6454       (input  v-cntxt-db-num
     6455       ,input  v-cntxt-userid
     6456       ,input  0
     6457       ,input  'actn_fin-doc_deletion':U
     6458       ,input  'firm':U
     6459       ,input  p-curr-host-code
     6460       ,input  '':U
     6461       ,input  0
     6462       ,input  0
     6463       ,input  0
     6464       ,input  0
     6465       ,input  true
     6466       ,output loc#log
     6467       )  .
     6468   end.
     6469   if not loc#log then return error.
     6470   CASE p-is-batch:
     6471     when no then do:
     6472         find first buf_fin-doc exclusive-lock where
     6473         recid(buf_fin-doc) = recid(X_fin-doc) NO-ERROR.
     6474         if not avail buf_fin-doc then return no-apply.
     6475         IF buf_fin-doc.status_ <> 'новый':U
     6476         and buf_fin-doc.status_ <> 'факт':U
     6477         THEN DO:
     6478           MESSAGE
     6479           "Платеж закрыт - удалять нельзя!"
     6480           VIEW-AS ALERT-BOX ERROR.
     6481           RETURN error.
     6482         END.
     6483         loc#log = no.
     6484         MESSAGE
     6485         "Вы уверены, что хотите удалить платеж?" skip(0)
     6486         string(if buf_fin-doc.status_ = 'факт':U then "Платеж закрыт до статуса <факт>, удаление повлечет за собой перерасчет архивов" else "")
     6487         VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE loc#log.
     6488         IF loc#log <> YES THEN DO:
     6489           RETURN error.
     6490         END.
     6491       do
     6492       on error undo, return error
     6493       on stop undo, return error
     6494       :
     6495         if buf_fin-doc.status_ = 'факт':U then do:
     6496           run trg/findocdl.p (
     6497                           input parparentproc
     6498                          ,input buf_fin-doc.host-code
     6499                          ,input buf_fin-doc.fin-doc-code
     6500                          ,input yes
     6501                          ,input no) no-error.
     6502           if error-status:error then do:
     6503             message
     6504             "Ошибка при удалении платежа, закрытого до статуса факт" skip
     6505             error-status:get-message(1) skip
     6506             return-value
     6507             view-as alert-box error .
     6508           end.
     6509         end.
     6510         else do:
     6511           run trg/findocdl.p (
     6512                           input parparentproc
     6513                          ,input buf_fin-doc.host-code
     6514                          ,input buf_fin-doc.fin-doc-code
     6515                          ,input no
     6516                          ,input no) no-error.
     6517         end.
     6518       end.
     6519       RUN OpenBr in this-procedure ( input yes, input no, input '':U).
     6520       reposition br-fin-doc to row 1 No-ERROR.
     6521     end.
     6522     when yes then do:
     6523         loc#log = no.
     6524         MESSAGE
     6525         "Вы уверены, что хотите удалить ВСЕ отмеченные ВАМИ платеж?"
     6526         VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE loc#log.
     6527         IF loc#log <> YES THEN DO:
     6528           RETURN error.
     6529         END.
     6530       do
     6531       on error undo, return error
     6532       on stop undo, return error
     6533       :
     6534         _do:
     6535         do ii = 1 to num-entries(v-rid-list):
     6536           run waitfram-show in this-procedure ( substitute("Обрабатывается &1 платеж списка", ii)).
     6537           find first buf_fin-doc where
     6538               recid(buf_fin-doc) = integer(entry(ii, v-rid-list)) exclusive-lock no-error .
     6539           if ii = 1 then do:
     6540             assign
     6541             v-doc-rec = recid(buf_fin-doc)
     6542             .
     6543           end.
     6544           if not avail buf_fin-doc
     6545           or (buf_fin-doc.status_ <> 'новый':U
     6546           and buf_fin-doc.status_ <> "":U)
     6547           then do:
     6548             assign
     6549             v-new-rid-list = v-new-rid-list + (if v-new-rid-list = "":U then "":U else chr(44)) + entry(ii, v-rid-list)
     6550             .
     6551             if buf_fin-doc.status_ = 'факт':U then do:
     6552               v-found-fact = v-found-fact + 1.
     6553             end.
     6554             NEXT _do.
     6555           end.
     6556           run trg/findocdl.p (
     6557                          input parparentproc
     6558                         ,input buf_fin-doc.host-code
     6559                         ,input buf_fin-doc.fin-doc-code
     6560                         ,input no
     6561                         ,input yes ) no-error.
     6562           if error-status:error then do:
     6563             assign
     6564             v-new-rid-list = v-new-rid-list + (if v-new-rid-list = "":U then "":U else chr(44)) + entry(ii, v-rid-list)
     6565             .
     6566             NEXT _do.
     6567           end.
     6568           else do:
     6569             assign
     6570             ok-ii = ok-ii + 1
     6571             .
     6572           end.
     6573         end.
     6574       end.
     6575       run waitfram-hide in this-procedure .
     6576       assign
     6577       v-rid-list = v-new-rid-list
     6578       .
     6579       RUN OpenBr in this-procedure ( input yes, input no, input '':U).
     6580       reposition br-fin-doc to recid integer(entry(1, v-rid-list)) No-ERROR.
     6581       message
     6582       substitute("Из &1 выбранных Вами платежей удалось удалить &2&3"
     6583             , ii - 1
     6584             , ok-ii
     6585             , chr(10))
     6586       (if v-found-fact > 0
     6587       then substitute("В т.ч. было выбрано &1 платежей в статусе <факт>,&2Удаление платежей в статусе <факт> в  пакетном режиме ЗАПРЕЩЕНО"
     6588                       , v-found-fact
     6589                       , chr(10)
     6590                       )
     6591       else '':U
     6592       )
     6593       view-as alert-box.
     6594     end.
     6595   END CASE.
     6596   APPLY "Value-CHanged" to br-fin-doc in frame Dialog-Frame.
     6597   APPLY "ENTRY" to br-fin-doc in frame Dialog-Frame.
     6598   END PROCEDURE.
     6599   PROCEDURE proc-b-exp :
     6600   define variable varxmldocfl      as character no-undo.
     6601   define variable varxmldocfl-type as character no-undo.
     6602   define variable varpar-type as character no-undo.
     6603   define variable v-file-name as character no-undo .
     6604   define variable for-dir as character no-undo .
     6605   define variable accum-count as integer no-undo .
     6606   define variable accum-count-ok as integer no-undo .
     6607   define variable loclog as logical no-undo .
     6608   define variable ii as integer no-undo .
     6609   define variable ii0 as integer no-undo .
     6610   define buffer buf_fin-doc for ub.fin-doc.
     6611   if not available X_fin-doc then do:
     6612     message "Неправильный выбор документа.".
     6613     return no-apply.
     6614   end.
     6615   define variable v-sys-key   as character         no-undo.
     6616   define variable vss-include-info47 as character format "x(65)" no-undo initial "@(#)$Workfile:currsysk.i $ $Revision: $".
     6617   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run currsysk in g#library
     6618     (output v-sys-key
     6619     ) no-error .
     6620   CASE t-batch:
     6621     when no then do:
     6622       assign
     6623       v-file-name =  ?
     6624       .
     6625       run str/xmlfdoc.p ( input X_fin-doc.host-code
     6626                          ,input  X_fin-doc.fin-doc-code
     6627                          ,input-output v-file-name
     6628                          ,input  yes
     6629                          ,input  yes) no-error .
     6630     end.
     6631     when  yes then do:
     6632       if v-rid-list = "":U then do:
     6633           message
     6634           "Вы не отметили ни одного платежа"
     6635           view-as alert-box error.
     6636           return error.
     6637       end.
     6638       run gbl/d-file.p
     6639         (
     6640          input-output v-file-name
     6641         ,input-output for-dir
     6642         ,input  (" Все файлы XML (*.xml) ")
     6643         ,input  ("*.xml":U)
     6644         ,input  chr(44)
     6645         ,input  (".xml":U)
     6646         ,input  no
     6647         ,input  yes
     6648         ,input  yes
     6649         ,input  "Введите имя файла"
     6650         ,output loclog
     6651         ) .
     6652       if not loclog then do:
     6653         return .
     6654       end.
     6655       run waitfram-show in this-procedure ( input "Ждите...").
     6656       assign
     6657       v-doc-rec = recid(X_fin-doc)
     6658       ii0 = num-entries(v-rid-list)
     6659       .
     6660       _do:
     6661       do ii = 1 to ii0:
     6662         find first buf_fin-doc no-lock where
     6663                   recid(buf_fin-doc) = integer(entry(ii, v-rid-list)) no-error .
     6664         if available buf_fin-doc then do:
     6665           assign
     6666           accum-count = accum-count + 1
     6667           .
     6668           run str/xmlfdoc.p (
     6669                           input buf_fin-doc.host-code
     6670                         , input buf_fin-doc.fin-doc-code
     6671                         , input-output v-file-name
     6672                         , input (accum-count-ok = 0)
     6673                         , input ii = ii0
     6674                         ) no-error .
     6675           if not error-status:error then
     6676           assign
     6677           accum-count-ok = accum-count-ok + 1
     6678           .
     6679         end.
     6680       end.
     6681       run waitfram-hide in this-procedure .
     6682     end.
     6683   END CASE.
     6684   if error-status:error
     6685   or (t-batch and accum-count <> accum-count-ok)
     6686   then do:
     6687     message
     6688     "Ошибка при выгрузке платежа(-ей) в XML-формате" skip
     6689     string(if t-batch then substitute("Выгружено &1 платежей из &2", accum-count-ok, accum-count) else "":U)
     6690     view-as alert-box .
     6691     if not t-batch then
     6692     return error .
     6693   end.
     6694   if search ("exmldoc.bat") <> ? then do:
     6695     os-command silent value(search ("exmldoc.bat") + " " + v-file-name + " " + v-sys-key).
     6696   end.
     6697   else do:
     6698     if search (v-file-name ) <> ? then do:
     6699       message "Документ(-ы) выгружен(-ы) в файл " v-file-name view-as alert-box.
     6700     end.
     6701   end.
     6702   END PROCEDURE.
     6703   PROCEDURE proc-b-print :
     6704   DEFINE INPUT PARAMETER loc-option as character no-undo.
     6705   if loc-option = '':U then return error.
     6706   CASE loc-option:
     6707   when 'ONE':U then do:
     6708     run proc-print-one in this-procedure .
     6709   end.
     6710   when 'ONE-GRAPHICS':U then do:
     6711     RUN proc-print-one-graphics IN THIS-PROCEDURE.
     6712   end.
     6713   when 'LIST':U then do:
     6714     run proc-print-list no-error.
     6715   end.
     6716   when 'form':U then do:
     6717     if available X_fin-doc then do:
     6718       run ref/fdoc-prn.p (
     6719             input parparentproc
     6720           , input this-procedure
     6721           , input string(recid(X_fin-doc))
     6722       ).
     6723     end.
     6724   end.
     6725   end case.
     6726   loc-option = ''.
     6727   END PROCEDURE.
