        1   DEFINE TEMP-TABLE Temp-hattr NO-UNDO LIKE ub.scales-attr
        2          field user-can-edit as log
        3          field code as character
        4          field value_ as character.
        5   define input parameter parparentproc as widget-handle no-undo .
        6   define input parameter mode as char no-undo.
        7   define input parameter p-db-num like ub.scales-attr.db-num no-undo.
        8   define input parameter p-scales-num like ub.scales-attr.scales-num no-undo .
        9   define variable vss-revision    as character no-undo init "$Revision$":U .
       10   define variable vss-author      as character no-undo init "$Author$":U .
       11   define variable vss-date        as character no-undo init "$Date$":U .
       12   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       13   define variable vss-archive     as character no-undo init "$Archive$":U .
       14   define variable vss-description as character no-undo init "Атрибуты весов".
       15   procedure vss-get-info :
       16     define output parameter p-vss-revision    like vss-revision    no-undo .
       17     define output parameter p-vss-author      like vss-author      no-undo .
       18     define output parameter p-vss-date        like vss-date        no-undo .
       19     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       20     define output parameter p-vss-archive     like vss-archive     no-undo .
       21     define output parameter p-vss-description like vss-description no-undo .
       22     assign
       23       p-vss-revision    = vss-revision
       24       p-vss-author      = vss-author
       25       p-vss-date        = vss-date
       26       p-vss-workfile    = vss-workfile
       27       p-vss-archive     = vss-archive
       28       p-vss-description = vss-description
       29     .
       30   end procedure.
       31   procedure vss-get-parameters :
       32     define output parameter p-vss-parameters as character no-undo .
       33   end procedure.
       34   define new global shared variable g#vssrevis-logger as handle    no-undo .
       35   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       36   define variable v-vssrevis-logger                   as handle    no-undo .
       37   procedure vss-logevent :
       38     define input  parameter p-extra-paramters as character no-undo .
       39     define variable v-vssrevis-parameters as character no-undo .
       40     do
       41     on error undo, return error return-value
       42     :
       43       if  valid-handle(v-vssrevis-logger)
       44       and v-vssrevis-logger :get-signature("logevent") <> ""
       45       then do:
       46         run vss-get-parameters in this-procedure
       47           (output v-vssrevis-parameters
       48           ).
       49         run logevent in v-vssrevis-logger
       50           (input vss-workfile
       51           ,input vss-revision
       52           ,input v-vssrevis-parameters
       53           ,input p-extra-paramters
       54           ).
       55       end.
       56     end.
       57   end procedure.
       58   assign
       59     v-vssrevis-logger = g#vssrevis-logger
       60   .
       61   if  valid-handle(v-vssrevis-logger)
       62   and v-vssrevis-logger :get-signature("logevent") <> ""
       63   then do:
       64     assign
       65       v-vssrevis-logevent = true
       66     .
       67     run vss-logevent in this-procedure (input vss-description) .
       68   end.
       69   define new global shared variable g#language as character no-undo .
       70   if g#language <> '' and g#language <> 'rus':U then do:
       71     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       72   end.
       73   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       74   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       75   procedure cur-time :
       76      define output parameter p-today as date      no-undo .
       77      define output parameter p-time  as integer   no-undo .
       78     do
       79     on error undo, return error
       80     :
       81       define variable v-date1 as date      no-undo .
       82       define variable v-date2 as date      no-undo .
       83       define variable v-time  as integer   no-undo .
       84       assign
       85         v-date1 = today
       86         v-time  = time
       87         v-date2 = today
       88       .
       89       if v-date1 <> v-date2
       90       then do:
       91         assign
       92           v-date1 = today
       93           v-time  = v-time
       94         .
       95       end.
       96       assign
       97         p-today = v-date1
       98         p-time  = v-time
       99       .
      100     end.
      101   end.
      102   function cur-time-date returns character
      103   :
      104     return string(today, '99/99/9999':U) .
      105   end.
      106   function cur-time-mjd returns decimal
      107   :
      108     define variable v-date as date      no-undo .
      109     define variable v-time as integer   no-undo .
      110     run cur-time in this-procedure
      111       (output v-date
      112       ,output v-time
      113       ) .
      114     return integer(v-date) - 2400002 + (v-time / 86400) .
      115   end.
      116   function cur-time-get-ending-index returns integer
      117   (input p-number as integer
      118   )
      119   :
      120     if p-number < 0
      121     or p-number = ?
      122     then do:
      123       return 1 .
      124     end.
      125     define variable v-rest as integer   no-undo .
      126     assign
      127       p-number = p-number modulo 100
      128     .
      129     if p-number < 20
      130     then do:
      131       assign
      132         v-rest = p-number
      133       .
      134     end.
      135     else do:
      136       assign
      137         v-rest = p-number modulo 10
      138       .
      139     end.
      140     case v-rest :
      141       when 1
      142       then do:
      143         return 2 .
      144       end.
      145       when 2 or
      146       when 3 or
      147       when 4
      148       then do:
      149         return 3 .
      150       end.
      151       otherwise do:
      152         return 1 .
      153       end.
      154     end case .
      155   end.
      156   procedure cur-time-mjd-to-date :
      157      define input  parameter i-mjd-diff as decimal no-undo.
      158      define output parameter o-Date     as date    no-undo.
      159      define output parameter o-Time     as integer no-undo.
      160      define variable v-day-number as integer   no-undo .
      161      if    i-mjd-diff < 0
      162         or i-mjd-diff = ?
      163      then do:
      164         return "?" .
      165      end.
      166      assign
      167         v-day-number = truncate(i-mjd-diff,0).
      168         o-Date = date(v-day-number + 2400002).
      169         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      170     .
      171   end.
      172   function cur-time-mjd-to-string returns character
      173   (input p-mjd-diff as decimal
      174   )
      175   :
      176     define variable v-day-number as integer   no-undo .
      177     define variable v-seconds    as integer   no-undo .
      178     define variable v-hour       as integer   no-undo .
      179     define variable v-min        as integer   no-undo .
      180     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      181     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      182     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      183     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      184     if p-mjd-diff < 0
      185     or p-mjd-diff = ?
      186     then do:
      187       return "?" .
      188     end.
      189     assign
      190       v-day-number = integer(truncate(p-mjd-diff,0))
      191       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      192     .
      193     if v-seconds > 86400
      194     then do:
      195       assign
      196         v-seconds = 86400 - 1
      197       .
      198     end.
      199     if v-seconds < 0
      200     then do:
      201       assign
      202         v-seconds = 0
      203       .
      204     end.
      205     assign
      206       v-hour = truncate(v-seconds / 3600, 0)
      207     .
      208     assign
      209       v-seconds = v-seconds modulo 3600
      210     .
      211     assign
      212       v-min = truncate(v-seconds / 60, 0)
      213     .
      214     assign
      215       v-seconds = v-seconds modulo 60
      216     .
      217     return
      218         (if v-day-number <> 0
      219           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      220           else ""
      221         )
      222       + (if v-day-number <> 0 or v-hour <> 0
      223           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      224           else ""
      225         )
      226       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      227           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      228           else ""
      229         )
      230       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      231       .
      232   end.
      233   function cur-time-string returns character
      234   :
      235     define variable v-date as date      no-undo .
      236     define variable v-time as integer   no-undo .
      237     run cur-time in this-procedure
      238       (output v-date
      239       ,output v-time
      240       ) .
      241     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      242   end.
      243   function cur-time-string-sec returns character
      244   :
      245     define variable v-date as date      no-undo .
      246     define variable v-time as integer   no-undo .
      247     run cur-time in this-procedure
      248       (output v-date
      249       ,output v-time
      250       ) .
      251     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      252   end.
      253   function cur-time-custom  returns character
      254   (input p-prefix as character
      255   ,input p-date-format as character
      256   ,input p-delimiter as character
      257   ,input p-time-format as character
      258   ,input p-suffix as character
      259   )
      260   :
      261     define variable v-date as date      no-undo .
      262     define variable v-time as integer   no-undo .
      263     run cur-time in this-procedure
      264       (output v-date
      265       ,output v-time
      266       ) .
      267     return
      268       p-prefix
      269       + string(v-date, p-date-format)
      270       + p-delimiter
      271       + string(v-time, p-time-format)
      272       + p-suffix
      273       .
      274   end.
      275   function cur-time-print  returns character
      276   :
      277     define variable v-date as date      no-undo .
      278     define variable v-time as integer   no-undo .
      279     run cur-time in this-procedure
      280       (output v-date
      281       ,output v-time
      282       ) .
      283     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      284   end.
      285   function cur-time-datetime returns datetime
      286   :
      287     define variable v-char as character no-undo .
      288     define variable v-datetime as datetime no-undo .
      289     v-char = cur-time-string().
      290     v-datetime = datetime(v-char).
      291     return  v-datetime.
      292   end.
      293   function cur-time-string-msec returns character
      294   :
      295     define variable v-date as datetime  no-undo .
      296     v-date = now.
      297     return string(v-date) .
      298   end.
      299   procedure scl-attr-code :
      300     do
      301     on error undo, return error
      302     :
      303       define input  parameter p-code           as character no-undo .
      304       define output parameter p-type           as character no-undo .
      305       define output parameter p-format         as character no-undo .
      306       define output parameter p-label          as character no-undo .
      307       define output parameter p-user-can-edit  as logical   no-undo .
      308       define output parameter p-output-display as logical   no-undo .
      309       define output parameter p-other          as character no-undo .
      310       case p-code :
      311               when 'tare-weight':U then do:     assign     p-label = "Веса и коды тары"     p-type = 'C':U      p-format = "X(32)"     p-label = "Веса и коды тары"     p-user-can-edit  = yes     p-output-display = true     p-other = 'scl=TIGER,MIRA,TIGER2,TIGER-SPCT2/spr=scl-attr-tare-weight':u      .   end.
      312         otherwise do:
      313           undo, return error "неизвестный атрибут весов" + " " + p-code .
      314         end.
      315       end.
      316     end.
      317   end procedure.
      318   procedure scl-attr-tooltip :
      319     do
      320     on error undo, return error
      321     :
      322       define input  parameter p-code    as character no-undo .
      323       define output parameter p-tooltip as character no-undo .
      324       define output parameter p-label   as character no-undo .
      325       case p-code :
      326               when 'tare-weight':U then do:     assign     p-tooltip = "Веса и коды тары"     p-label = "Веса и коды тары" .   end.
      327         otherwise do:
      328           undo, return error "неизвестный атрибут весов" + " " + p-code .
      329         end.
      330       end.
      331     end.
      332   end procedure.
      333   procedure scl-attr-value :
      334     do
      335     on error undo, return error
      336     :
      337       define input  parameter p-db-num   like ub.scales-attr.db-num        no-undo .
      338       define input  parameter p-scales-num like ub.scales-attr.scales-num      no-undo .
      339       define input  parameter p-code     like ub.scales-attr.attr-code      no-undo .
      340       define output parameter p-value    like ub.scales-attr.attr-value    no-undo .
      341       define output parameter p-type     as character no-undo .
      342       define buffer buf_scales-attr for ub.scales-attr .
      343       define variable v-format         as character no-undo .
      344       define variable v-label          as character no-undo .
      345       define variable v-user-can-edit  as logical   no-undo .
      346       define variable v-output-display as logical   no-undo .
      347       define variable v-other          as character no-undo .
      348       run scl-attr-code in this-procedure
      349         (input  p-code
      350         ,output p-type
      351         ,output v-format
      352         ,output v-label
      353         ,output v-user-can-edit
      354         ,output v-output-display
      355         ,output v-other
      356         ) no-error .
      357       if error-status :error then do:
      358         undo, return error return-value .
      359       end.
      360       find first buf_scales-attr no-lock
      361         where buf_scales-attr.db-num    = p-db-num
      362           and buf_scales-attr.scales-num  = p-scales-num
      363           and buf_scales-attr.attr-code = p-code
      364         no-error .
      365       if avail buf_scales-attr then do:
      366         assign
      367           p-value =  buf_scales-attr.attr-value
      368         .
      369       end.
      370       else do:
      371         assign
      372           p-value = if p-type = 'L':U then "no":U else ""
      373         .
      374       end.
      375     end.
      376   end procedure.
      377   procedure scl-attr-write :
      378     do
      379     on error undo, return error
      380     :
      381       define input parameter p-db-num   like ub.scales-attr.db-num     no-undo .
      382       define input parameter p-scales-num like ub.scales-attr.scales-num   no-undo .
      383       define input parameter p-code     like ub.scales-attr.attr-code  no-undo .
      384       define input parameter p-value    like ub.scales-attr.attr-value no-undo .
      385       define buffer buf_scales-attr for ub.scales-attr .
      386       define variable v-type           as character no-undo .
      387       define variable v-format         as character no-undo .
      388       define variable v-label          as character no-undo .
      389       define variable v-user-can-edit  as logical   no-undo .
      390       define variable v-output-display as logical   no-undo .
      391       define variable v-other          as character no-undo .
      392       run scl-attr-code in this-procedure
      393         (input  p-code
      394         ,output v-type
      395         ,output v-format
      396         ,output v-label
      397         ,output v-user-can-edit
      398         ,output v-output-display
      399         ,output v-other
      400         ) no-error .
      401       if error-status :error then do:
      402         undo, return error return-value .
      403       end.
      404       find first buf_scales-attr exclusive-lock
      405         where buf_scales-attr.db-num  = p-db-num
      406           and buf_scales-attr.scales-num  = p-scales-num
      407           and buf_scales-attr.attr-code = p-code
      408         no-error .
      409       if not available buf_scales-attr then do:
      410         create buf_scales-attr .
      411         assign
      412           buf_scales-attr.db-num    = p-db-num
      413           buf_scales-attr.scales-num  = p-scales-num
      414           buf_scales-attr.attr-code = p-code
      415         .
      416       end.
      417       assign
      418         buf_scales-attr.attr-value = p-value
      419       .
      420       release buf_scales-attr no-error .
      421       if error-status:error then do:
      422         undo, return error return-value .
      423       end.
      424     end.
      425   end procedure.
      426   procedure scl-attr-exist :
      427     do
      428     on error undo, return error
      429     :
      430       define input parameter p-db-num   like ub.scales-attr.db-num     no-undo .
      431       define input parameter p-scales-num like ub.scales-attr.scales-num   no-undo .
      432       define input parameter p-code     like ub.scales-attr.attr-code  no-undo .
      433       define output parameter p-exist   as logical  no-undo .
      434       define buffer buf_scales-attr for ub.scales-attr .
      435       define variable v-type           as character no-undo .
      436       define variable v-format         as character no-undo .
      437       define variable v-label          as character no-undo .
      438       define variable v-user-can-edit  as logical   no-undo .
      439       define variable v-output-display as logical   no-undo .
      440       define variable v-other          as character no-undo .
      441       run scl-attr-code in this-procedure
      442         (input  p-code
      443         ,output v-type
      444         ,output v-format
      445         ,output v-label
      446         ,output v-user-can-edit
      447         ,output v-output-display
      448         ,output v-other
      449         ) no-error .
      450       if error-status :error then do:
      451         undo, return error return-value .
      452       end.
      453       find first buf_scales-attr exclusive-lock
      454         where buf_scales-attr.db-num  = p-db-num
      455           and buf_scales-attr.scales-num  = p-scales-num
      456           and buf_scales-attr.attr-code = p-code
      457         no-error .
      458       if  available buf_scales-attr then do:
      459         p-exist = yes.
      460       end.
      461     end.
      462   end procedure.
      463   procedure scl-attr-delete :
      464     do
      465     on error undo, return error
      466     :
      467       define input parameter p-db-num   like ub.scales-attr.db-num     no-undo .
      468       define input parameter p-scales-num like ub.scales-attr.scales-num   no-undo .
      469       define input parameter p-code     like ub.scales-attr.attr-code  no-undo .
      470       define output parameter p-deleted  as logical no-undo.
      471       define buffer buf_scales-attr for ub.scales-attr .
      472       define variable v-type           as character no-undo .
      473       define variable v-format         as character no-undo .
      474       define variable v-label          as character no-undo .
      475       define variable v-user-can-edit  as logical   no-undo .
      476       define variable v-output-display as logical   no-undo .
      477       define variable v-other          as character no-undo .
      478       run scl-attr-code in this-procedure
      479         (input  p-code
      480         ,output v-type
      481         ,output v-format
      482         ,output v-label
      483         ,output v-user-can-edit
      484         ,output v-output-display
      485         ,output v-other
      486         ) no-error .
      487       if error-status :error then do:
      488         undo, return error return-value .
      489       end.
      490       find first buf_scales-attr exclusive-lock
      491         where buf_scales-attr.db-num  = p-db-num
      492           and buf_scales-attr.scales-num  = p-scales-num
      493           and buf_scales-attr.attr-code = p-code
      494         no-error NO-WAIT.
      495       if not available buf_scales-attr then do:
      496         p-deleted = no.
      497       end.
      498       else do:
      499         delete buf_scales-attr no-error .
      500         if error-status:error then do:
      501           undo, return error return-value .
      502         end.
      503         p-deleted = yes.
      504       end.
      505     end.
      506   end procedure.
      507   procedure scl-attr-news :
      508     do
      509     on error undo, return error
      510     :
      511       define input  parameter p-code           as character no-undo .
      512       define output parameter p-news           as logical   no-undo .
      513       case p-code :
      514               when 'tare-weight':U then do:     assign     p-news = yes.   end.
      515         otherwise do:
      516           p-news = no.
      517         end.
      518       end.
      519     end.
      520   end procedure.
      521   procedure scl-attr-hist :
      522     do
      523     on error undo, return error
      524     :
      525       define input  parameter p-code           as character no-undo .
      526       define output parameter p-hist           as logical   no-undo .
      527       case p-code :
      528               when 'tare-weight':U then do:     assign     p-hist = yes.   end.
      529         otherwise do:
      530           p-hist = no.
      531         end.
      532       end.
      533     end.
      534   end procedure.
      535   procedure scl-attr-tare-weight:
      536   define input parameter p-db-num like ub.scales.db-num no-undo .
      537   define input parameter p-scales-num like ub.scales.scales-num no-undo .
      538   define input-output parameter p-value as character no-undo .
      539   define output parameter p-setted as logical no-undo .
      540   DEFINE VARIABLE v-value as character no-undo .
      541     do
      542     on error undo, return error
      543     :
      544       assign
      545       v-value = p-value.
      546       run ref/tiger-w.w (
      547                       input p-db-num
      548                      ,input p-scales-num
      549                      ,input-output v-value).
      550       if p-value <> v-value then do:
      551         assign
      552         p-setted = yes
      553         p-value = v-value
      554         .
      555       end.
      556     end.
      557   end procedure.
      558   define new global shared variable g#library  as handle no-undo .
      559   define new global shared variable g#library2 as handle no-undo .
      560   procedure proc-alt-shift-f2:
      561     if not ibs.th.gbl.gbl-var:rcode
      562   then
      563     run gbl\inidebug.p .
      564   end.
      565   procedure proc-alt-shift-f3:
      566     run gbl/prvssinf.p
      567       ( input this-procedure
      568       ) .
      569   end.
      570   define variable v-inform-launched as logical no-undo initial false .
      571   procedure proc-alt-shift-f4:
      572     define variable v-action as character no-undo .
      573     if v-inform-launched = false then do:
      574       assign
      575         v-inform-launched = true
      576       .
      577       run gbl/d-inform.w
      578         (  input self
      579         ,  input this-procedure
      580         , output v-action
      581         ) no-error .
      582       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      583       assign
      584         v-inform-launched = false
      585       .
      586     end.
      587   end.
      588   procedure proc-alt-f1:
      589     run gbl/corrhelp.p
      590       (input this-procedure
      591       ) .
      592   end .
      593   on alt-shift-f2 anywhere do:
      594     run proc-alt-shift-f2.
      595   end.
      596   on alt-shift-f3 anywhere do:
      597     run proc-alt-shift-f3 in this-procedure .
      598   end.
      599   on alt-shift-f4 anywhere do:
      600     run proc-alt-shift-f4 in this-procedure.
      601   end.
      602   on alt-f1 anywhere do:
      603     run proc-alt-f1 in this-procedure .
      604   end.
      605   define variable updated as logical no-undo.
      606   DEFINE VARIABLE added  as logical no-undo .
      607   define variable add-option as char no-undo.
      608   define variable temp-doc-rec as recid no-undo.
      609   define buffer buf_scales for ub.scales.
      610   DEFINE MENU MENU-b-ins
      611          MENU-ITEM m_tara-weight  LABEL "Веса и коды тары".
      612   DEFINE BUTTON b-chg
      613        LABEL "&Изменить":L
      614        SIZE 10 BY 1 TOOLTIP "Изменить атрибут весов".
      615   DEFINE BUTTON b-del
      616        LABEL "&Удалить":L
      617        SIZE 10 BY 1 TOOLTIP "Удалить  атрибут весов".
      618   DEFINE BUTTON b-help
      619        LABEL "Помо&щь":L
      620        SIZE 10 BY 1.
      621   DEFINE BUTTON b-ins
      622        LABEL "&Добавить":L
      623        SIZE 10 BY 1 TOOLTIP "Добавить атрибут весов".
      624   DEFINE BUTTON b-quit AUTO-GO
      625        LABEL "&Выход ":L
      626        SIZE 10 BY 1 TOOLTIP "Выход из режима".
      627   DEFINE VARIABLE scl-db-num AS INTEGER FORMAT ">>>>9":U INITIAL 0
      628        LABEL "БД"
      629         VIEW-AS TEXT
      630        SIZE 9.63 BY 1
      631        BGCOLOR 3 FGCOLOR 15  NO-UNDO.
      632   DEFINE VARIABLE scl-scales-name AS CHARACTER FORMAT "X(256)":U
      633        LABEL "Название"
      634         VIEW-AS TEXT
      635        SIZE 43 BY 1
      636        BGCOLOR 3 FGCOLOR 15  NO-UNDO.
      637   DEFINE VARIABLE scl-scales-num AS INTEGER FORMAT ">>>9":U INITIAL 0
      638        LABEL "№"
      639         VIEW-AS TEXT
      640        SIZE 6 BY 1
      641        BGCOLOR 3 FGCOLOR 15  NO-UNDO.
      642   DEFINE VARIABLE scl-scales-type AS CHARACTER FORMAT "X(256)":U
      643        LABEL "Тип"
      644         VIEW-AS TEXT
      645        SIZE 21.5 BY 1
      646        BGCOLOR 3 FGCOLOR 15  NO-UNDO.
      647   DEFINE QUERY BR-SCL-ATTRS FOR
      648         Temp-hattr SCROLLING.
      649   DEFINE BROWSE BR-SCL-ATTRS
      650     QUERY BR-SCL-ATTRS DISPLAY
      651         Temp-hattr.attr-code COLUMN-LABEL "Атрибут" FORMAT "X(50)":U
      652         Temp-hattr.attr-value COLUMN-LABEL "Значение" FORMAT "X(50)":U
      653       WITH NO-ROW-MARKERS SEPARATORS SIZE 91 BY 15.33.
      654   DEFINE FRAME Dialog-Frame
      655        b-quit AT ROW 1 COL 1
      656        b-ins AT ROW 1 COL 21
      657        b-chg AT ROW 1 COL 31
      658        b-del AT ROW 1 COL 41
      659        b-help AT ROW 1.04 COL 70.13
      660        BR-SCL-ATTRS AT ROW 4.46 COL 2
      661        scl-db-num AT ROW 2.13 COL 1
      662        scl-scales-type AT ROW 2.13 COL 19.5 COLON-ALIGNED
      663        scl-scales-num AT ROW 3.25 COL 2
      664        scl-scales-name AT ROW 3.29 COL 19.5 COLON-ALIGNED
      665        SPACE(28.50) SKIP(15.66)
      666       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      667            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      668            TITLE "Атрибуты весов".
      669   ASSIGN
      670          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      671          FRAME Dialog-Frame:HIDDEN           = TRUE.
      672   ASSIGN
      673          b-ins:POPUP-MENU IN FRAME Dialog-Frame       = MENU MENU-b-ins:HANDLE.
      674   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      675   DO:
      676     APPLY "END-ERROR":U TO SELF.
      677   END.
      678   ON CHOOSE OF b-chg IN FRAME Dialog-Frame
      679   DO:
      680     if not avail temp-hattr then return no-apply.
      681     run proc-add-chg in this-procedure (no ) no-error.
      682     if error-status:error then return no-apply.
      683     RUN init-proc.
      684   END.
      685   ON CHOOSE OF b-del IN FRAME Dialog-Frame
      686   DO:
      687   define variable loc#log as logical no-undo.
      688   define variable attr-type as character no-undo .
      689   define variable attr-format as character no-undo .
      690   define variable attr-label as character no-undo .
      691   define variable attr-user-can-edit as logical no-undo .
      692   define variable attr-output-display as logical no-undo .
      693   define variable attr-other as char no-undo .
      694   define variable glog as logical no-undo .
      695   DEFINE VARIABLE v-check AS CHARACTER NO-UNDO.
      696   define variable v-correct as logical no-undo .
      697   define variable v-error-code as character no-undo .
      698   DEFINE VARIABLE jj AS INTEGER NO-UNDO.
      699     if not avail temp-hattr then return no-apply.
      700     run scl-attr-code (
      701       input  temp-hattr.code
      702       ,output attr-type
      703       ,output attr-format
      704       ,output attr-label
      705       ,output attr-user-can-edit
      706       ,output attr-output-display
      707       ,output attr-other
      708       ) .
      709     if not attr-user-can-edit then do:
      710       message
      711       "Атрибут нельзя удалить вручную"
      712       view-as alert-box error .
      713       return no-apply.
      714     end.
      715        do jj = 1 to num-entries(attr-other, chr(47)):
      716       if entry(1, entry(jj, attr-other, chr(47)), "=":U) = "check":U then do:
      717         assign
      718         v-check = string(entry(2, entry(jj, attr-other, chr(47)), "=":U))
      719         .
      720       end.
      721     end.
      722     if v-check <> "":U then do:
      723       run value(v-check)(
      724                          input p-db-num
      725                         ,INPUT p-scales-num
      726                         ,input temp-hattr.code
      727                         ,input "0":U
      728                         ,input 'удаление':U
      729                         ,output v-correct
      730                         ,output v-error-code) no-error.
      731       if error-status:error then do:
      732         message
      733         "Ошибка при проверке корректности удаления атрибута" skip
      734         error-status:get-message(1) skip
      735         view-as alert-box error .
      736         undo, return no-apply .
      737       end.
      738       if not v-correct then do:
      739         message
      740         "Удаление атрибута некорректно" skip
      741         return-value
      742         view-as alert-box error .
      743         undo, return no-apply .
      744       end.
      745     end.
      746     glog = no.
      747     message
      748     "Вы уверены, что хотите удалить атрибут " temp-hattr.attr-code skip
      749     " для весов"
      750     view-as alert-box QUESTIOn buttons YES-NO update glog.
      751     if NOT glog then return no-apply.
      752       run scl-attr-delete in this-procedure(
      753                                       input p-db-num,
      754                                       input p-scales-num,
      755                                       input temp-hattr.code,
      756                                       output loc#log) no-error .
      757       if error-status:error or not loc#log then do:
      758          message "Ошибка при удалении атрибута весов!"         "Обратитесь к администратору системы" skip error-status:get-message(1) skip         return-value skip view-as alert-box ERROR.
      759          return no-apply.
      760       end.
      761       delete temp-hattr.
      762       updated = yes.
      763       run init-proc.
      764   END.
      765   ON CHOOSE OF b-ins IN FRAME Dialog-Frame
      766   DO:
      767   define variable attr-type as character no-undo .
      768   define variable attr-format as character no-undo .
      769   define variable attr-label as character no-undo .
      770   define variable attr-user-can-edit as logical no-undo .
      771   define variable attr-output-display as logical no-undo .
      772   define variable attr-other as char no-undo .
      773   define variable loc#log as logical no-undo.
      774   define buffer buf_temp-hattr for temp-hattr.
      775   if add-option = "" then do:
      776     run gbl/pop-up.p (self:handle, no) no-error.
      777   end.
      778   if add-option = "":U then return no-apply.
      779   run proc-add-chg in this-procedure (yes) no-error .
      780   if error-status:error then do:
      781     add-option = "":U.
      782     return no-apply.
      783   end.
      784   Run init-proc.
      785   find first buf_temp-hattr no-lock where
      786                           buf_temp-hattr.code = add-option no-error.
      787   add-option = "":U.
      788   if avail buf_temp-hattr then
      789       temp-doc-rec = recid(buf_temp-hattr).
      790       else temp-doc-rec = ?.
      791   reposition BR-SCL-ATTRS to recid temp-doc-rec no-error.
      792   if error-status:error then return no-apply.
      793   END.
      794   ON CHOOSE OF b-quit IN FRAME Dialog-Frame
      795   DO:
      796   END.
      797   ON CHOOSE OF MENU-ITEM m_tara-weight
      798   DO:
      799     add-option = 'tare-weight':U.
      800      apply "CHOOSE" to b-ins in frame Dialog-Frame.
      801   END.
      802   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      803   on help of frame Dialog-Frame
      804   do:
      805     run gbl/app_help.p
      806       (input this-procedure :file-name
      807       ,input ''
      808       ,input ?
      809       ) no-error.
      810     if error-status :error then do:
      811       message
      812         "Ошибка при вызове помощи"
      813         error-status :get-message(1)
      814         view-as alert-box .
      815     end.
      816   end.
      817   run minbtn-set in this-procedure .
      818   on choose of b-help in frame Dialog-Frame
      819   do:
      820     apply "help":u to frame Dialog-Frame .
      821   end.
      822   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      823   procedure minbtn-set :
      824       do
      825           on error undo, return error return-value
      826           :
      827           define variable ii              as integer       no-undo .
      828           define variable fh              as widget-handle no-undo .
      829           define variable hh              as widget-handle no-undo .
      830           define variable v-h             as handle        extent 4 no-undo .
      831           define variable v-name-button   as character     no-undo .
      832           define variable v-help-old-x    as decimal       no-undo .
      833           define variable v-help-old-y    as decimal       no-undo .
      834           define variable v-help-old-size as decimal       no-undo .
      835           define variable v-frame-width   as decimal       no-undo .
      836           define variable jj              as integer       no-undo .
      837           do
      838               on error undo, return error
      839               :
      840               assign
      841                   v-frame-width = frame Dialog-Frame:width - 0.3
      842                   fh            = frame Dialog-Frame:first-child
      843                   hh            = fh:first-child
      844                   ii            = 1
      845                   .
      846               do while valid-handle(hh):
      847                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      848                   do:
      849                       case lc(hh:name) :
      850                           when "b-help" then
      851                               do:
      852                                   hh:load-image-up("cmp/b-help.bmp":u) .
      853                                   hh:load-image-down("cmp/b-help.bmp":u) .
      854                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      855                                   hh:TOOLTIP = "Помощь" .
      856                                   v-help-old-x = hh:column .
      857                                   v-help-old-y = hh:row    .
      858                                   v-help-old-size = hh:width .
      859                                   hh:width-chars = 2.5 .
      860                               end.
      861                           when "b-print" then
      862                               do:
      863                                   hh:load-image("cmp/b-print.bmp":u) .
      864                                   hh:TOOLTIP = "Печать" .
      865                                   v-h[ii] = hh:handle .
      866                                   ii = ii + 1 .
      867                                   hh:width-chars = 3 .
      868                               end.
      869                           when "b-history" or
      870                           when "b-hist" then
      871                               do:
      872                                   hh:load-image("cmp/b-hist.bmp":u) .
      873                                   hh:TOOLTIP = "История" .
      874                                   v-h[ii] = hh:handle .
      875                                   ii = ii + 1 .
      876                                   hh:width-chars = 3 .
      877                               end.
      878                           when "b-sch" then
      879                               do:
      880                                   hh:load-image("cmp/b-sch.bmp":u) .
      881                                   hh:TOOLTIP = "Установка Фильтра" .
      882                                   v-h[ii] = hh:handle .
      883                                   ii = ii + 1 .
      884                                   hh:width-chars = 3 .
      885                               end.
      886                           when "b-hist-user" then
      887                               do:
      888                                   hh:load-image("cmp/b-hist.bmp":u) .
      889                                   hh:TOOLTIP = "История пользователя" .
      890                                   ii = ii + 1 .
      891                               end.
      892                       end case.
      893                   end.
      894                   hh = hh:next-sibling.
      895               end.
      896               b-help:column = v-frame-width - b-help:width-chars.
      897               jj = 0.
      898               repeat ii = 4 to 1 by -1 :
      899                   if valid-handle (v-h[ii] ) then
      900                   do:
      901                       jj  = jj + 1 .
      902                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      903                       v-h[ii]:row    = v-help-old-y .
      904                   end.
      905               end.
      906           end.
      907       end.
      908   end procedure.
      909   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      910   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      911   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      912   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      913   define variable v-diasize-current-frame-width  as decimal   no-undo .
      914   define variable v-diasize-current-frame-height as decimal   no-undo .
      915   define variable v-diasize-change-size          as logical   no-undo .
      916   define variable v-diasize-resize-button        as handle    no-undo .
      917   define variable v-diasize-wndmax               as logical   no-undo .
      918   define variable v-diasize-wndstore             as logical   no-undo .
      919   define variable v-diasize-proc-name            as character no-undo .
      920   define variable v-diasize-browse-handle        as handle    no-undo .
      921   define variable v-diasize-browse-number        as integer   no-undo .
      922   define variable v-diasize-need-full-display    as logical   no-undo init false .
      923   define temp-table temp-diasize-handle no-undo
      924     field handle-value  as handle
      925     field save-position as decimal
      926     index xpk is primary unique handle-value
      927     .
      928   define temp-table temp-browse-handle no-undo
      929     field browse-type   as character
      930     field browse-number as integer
      931     field browse-handle as handle
      932     field original-size as decimal
      933     index xpk is primary unique browse-type browse-number
      934     index xie browse-type browse-handle
      935   .
      936   procedure diasize_change-height :
      937     define input  parameter p-change-value  as decimal   no-undo .
      938     define input  parameter p-move-resize   as logical   no-undo .
      939     define variable v-field-group-handle    as handle    no-undo .
      940     define variable v-object-handle         as handle    no-undo .
      941     define variable v-frame-height          as decimal   no-undo .
      942     define variable v-frame-virtual-height  as decimal   no-undo .
      943     define variable v-browse-height         as decimal   no-undo .
      944     define variable v-window-height         as decimal   no-undo .
      945     define variable v-window-virtual-height as decimal   no-undo .
      946     define variable v-change-sign           as integer   no-undo .
      947     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      948     define buffer buf_temp-browse-handle  for temp-browse-handle .
      949     if p-change-value > 0
      950     then do:
      951       if frame Dialog-Frame :height + p-change-value
      952           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      953       then do:
      954         assign
      955           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      956                           - (frame Dialog-Frame :height-chars)
      957         .
      958         if p-change-value <= 0
      959         then do:
      960           run diasize_position-resize-button in this-procedure .
      961           return .
      962         end.
      963       end.
      964     end.
      965     if p-change-value < 0
      966     then do:
      967       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      968       then do:
      969         assign
      970           p-change-value = v-diasize-orig-frame-height
      971                          - (frame Dialog-Frame :height-chars)
      972         .
      973         if p-change-value >= 0
      974         then do:
      975           run diasize_position-resize-button in this-procedure .
      976           return .
      977         end.
      978       end.
      979     end.
      980     if p-change-value >= 0
      981     then do:
      982       assign
      983         v-change-sign = 1
      984       .
      985     end.
      986     else do:
      987       assign
      988         v-change-sign = -1
      989       .
      990     end.
      991     assign
      992       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      993     .
      994     if p-change-value = 0
      995     then do:
      996       run diasize_position-resize-button in this-procedure .
      997       return .
      998     end.
      999     move_block:
     1000     do
     1001     on error undo move_block, retry move_block
     1002     :
     1003       if retry
     1004       then do:
     1005         do
     1006         on error undo move_block, leave move_block
     1007         :
     1008           if p-change-value > 0
     1009           then do:
     1010             for each buf_temp-diasize-handle
     1011             on error undo, next
     1012             :
     1013               assign
     1014                 v-object-handle = buf_temp-diasize-handle.handle-value
     1015               .
     1016               if v-object-handle <> v-diasize-resize-button
     1017               then do:
     1018                 assign
     1019                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1020                 .
     1021               end.
     1022             end.
     1023             assign
     1024               v-diasize-browse-handle :height = v-browse-height
     1025             .
     1026             for each buf_temp-browse-handle
     1027               where buf_temp-browse-handle.browse-type = 'height':u
     1028             on error undo, next
     1029             :
     1030               assign
     1031                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1032               .
     1033             end.
     1034             assign
     1035               frame Dialog-Frame :height = v-frame-height
     1036             .
     1037             if frame Dialog-Frame :scrollable = true
     1038             then do:
     1039               assign
     1040                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1041               .
     1042             end.
     1043             run diasize_position-resize-button in this-procedure .
     1044           end.
     1045           else do:
     1046             if frame Dialog-Frame :scrollable = true
     1047             then do:
     1048               assign
     1049                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1050               .
     1051             end.
     1052             assign
     1053               frame Dialog-Frame :height = v-frame-height
     1054             .
     1055             assign
     1056               v-diasize-browse-handle :height = v-browse-height
     1057             .
     1058             for each buf_temp-browse-handle
     1059               where buf_temp-browse-handle.browse-type = 'height':u
     1060             on error undo, next
     1061             :
     1062               assign
     1063                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1064               .
     1065             end.
     1066             for each buf_temp-diasize-handle
     1067             on error undo, next
     1068             :
     1069               assign
     1070                 v-object-handle = buf_temp-diasize-handle.handle-value
     1071               .
     1072               if v-object-handle <> v-diasize-resize-button
     1073               then do:
     1074                 assign
     1075                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1076                 .
     1077               end.
     1078             end.
     1079             run diasize_position-resize-button in this-procedure .
     1080           end.
     1081           assign
     1082             v-diasize-change-size = false
     1083           .
     1084           leave move_block .
     1085         end.
     1086       end.
     1087       assign
     1088         v-diasize-need-full-display = true
     1089       .
     1090       if v-diasize-change-size = false
     1091       then do:
     1092         assign
     1093           v-diasize-change-size = true
     1094         .
     1095       end.
     1096       else do:
     1097         return .
     1098       end.
     1099       assign
     1100         v-frame-height = frame Dialog-Frame :height
     1101         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1102         v-browse-height = v-diasize-browse-handle :height
     1103       .
     1104       for each buf_temp-browse-handle
     1105         where buf_temp-browse-handle.browse-type = 'height':u
     1106       :
     1107         assign
     1108           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1109         .
     1110       end.
     1111       for each buf_temp-diasize-handle
     1112       :
     1113         delete buf_temp-diasize-handle .
     1114       end.
     1115       assign
     1116         v-field-group-handle = frame Dialog-Frame :first-child
     1117       .
     1118       do while valid-handle(v-field-group-handle)
     1119       :
     1120         assign
     1121           v-object-handle = v-field-group-handle :first-child
     1122         .
     1123         do while valid-handle(v-object-handle)
     1124         :
     1125           if  v-object-handle <> v-diasize-browse-handle :handle
     1126           and can-query(v-object-handle, "row")
     1127           and can-query(v-object-handle, "height")
     1128           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1129           then do:
     1130             find first buf_temp-browse-handle
     1131               where buf_temp-browse-handle.browse-type   = 'height':u
     1132                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1133               no-error .
     1134             if available buf_temp-browse-handle
     1135             then do:
     1136             end.
     1137             else do:
     1138               create buf_temp-diasize-handle .
     1139               assign
     1140                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1141                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1142               .
     1143             end.
     1144           end.
     1145           assign
     1146             v-object-handle = v-object-handle :next-sibling
     1147           .
     1148         end.
     1149         assign
     1150           v-field-group-handle = v-field-group-handle :next-sibling
     1151         .
     1152       end.
     1153       do with frame Dialog-Frame
     1154       :
     1155         hide v-diasize-resize-button .
     1156         assign
     1157           v-diasize-resize-button :row    = 1
     1158           v-diasize-resize-button :column = 1
     1159         .
     1160       end.
     1161       if p-change-value > 0
     1162       then do:
     1163         if frame Dialog-Frame :scrollable = true
     1164         then do:
     1165           assign
     1166             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1167             no-error .
     1168           if error-status :error
     1169           or error-status :get-message(1) <> ""
     1170           then do:
     1171             undo move_block, retry move_block .
     1172           end.
     1173         end.
     1174         assign
     1175           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1176           no-error .
     1177         if error-status :error
     1178         or error-status :get-message(1) <> ""
     1179         then do:
     1180           undo move_block, retry move_block .
     1181         end.
     1182         assign
     1183           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1184           no-error .
     1185         if error-status :error
     1186         or error-status :get-message(1) <> ""
     1187         then do:
     1188           undo move_block, retry move_block .
     1189         end.
     1190         for each buf_temp-browse-handle
     1191           where buf_temp-browse-handle.browse-type = 'height':u
     1192         on error undo move_block, retry move_block
     1193         :
     1194           assign
     1195             buf_temp-browse-handle.browse-handle :height
     1196               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1197             no-error .
     1198           if error-status :error
     1199           or error-status :get-message(1) <> ""
     1200           then do:
     1201             undo move_block, retry move_block .
     1202           end.
     1203         end.
     1204         for each buf_temp-diasize-handle
     1205         on error undo move_block, retry move_block
     1206         :
     1207           assign
     1208             v-object-handle = buf_temp-diasize-handle.handle-value
     1209           .
     1210           if v-object-handle <> v-diasize-resize-button
     1211           then do:
     1212             assign
     1213               v-object-handle :row = v-object-handle :row + p-change-value
     1214               no-error .
     1215             if error-status :error
     1216             or error-status :get-message(1) <> ""
     1217             then do:
     1218               undo move_block, retry move_block .
     1219             end.
     1220           end.
     1221         end.
     1222       end.
     1223       else do:
     1224         for each buf_temp-diasize-handle
     1225         on error undo move_block, retry move_block
     1226         :
     1227           assign
     1228             v-object-handle = buf_temp-diasize-handle.handle-value
     1229           .
     1230           if v-object-handle <> v-diasize-resize-button
     1231           then do:
     1232             assign
     1233               v-object-handle :row = v-object-handle :row + p-change-value
     1234               no-error .
     1235             if error-status :error
     1236             or error-status :get-message(1) <> ""
     1237             then do:
     1238               undo move_block, retry move_block .
     1239             end.
     1240           end.
     1241         end.
     1242         assign
     1243           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1244           no-error .
     1245         if error-status :error
     1246         or error-status :get-message(1) <> ""
     1247         then do:
     1248           undo move_block, retry move_block .
     1249         end.
     1250         for each buf_temp-browse-handle
     1251           where buf_temp-browse-handle.browse-type = 'height':u
     1252         on error undo move_block, retry move_block
     1253         :
     1254           assign
     1255             buf_temp-browse-handle.browse-handle :height
     1256               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1257             no-error .
     1258           if error-status :error
     1259           or error-status :get-message(1) <> ""
     1260           then do:
     1261             undo move_block, retry move_block .
     1262           end.
     1263         end.
     1264         assign
     1265           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1266           no-error .
     1267         if error-status :error
     1268         or error-status :get-message(1) <> ""
     1269         then do:
     1270           undo move_block, retry move_block .
     1271         end.
     1272         if frame Dialog-Frame :scrollable = true
     1273         then do:
     1274           assign
     1275             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1276             no-error .
     1277           if error-status :error
     1278           or error-status :get-message(1) <> ""
     1279           then do:
     1280             undo move_block, retry move_block .
     1281           end.
     1282         end.
     1283       end.
     1284       if p-move-resize = true
     1285       then do:
     1286         run diasize_position-resize-button in this-procedure .
     1287       end.
     1288       if v-diasize-wndstore = true
     1289       then do:
     1290         if connected("ub") = true
     1291         then do:
     1292           define variable v-cntxt-db-num        as integer   no-undo .
     1293           define variable v-cntxt-userid        as character no-undo .
     1294           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1295                                             , OUTPUT v-cntxt-userid
     1296                                             ) .
     1297           run gbl/wndsizew.p
     1298             (input  v-cntxt-db-num
     1299             ,input  v-cntxt-userid
     1300             ,input  v-diasize-proc-name
     1301             ,input  'height':u
     1302             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1303             ) .
     1304         end.
     1305       end.
     1306     end.
     1307     assign
     1308       v-diasize-change-size = false
     1309     .
     1310   end procedure.
     1311   procedure diasize_set-height :
     1312     define input  parameter p-new-height  as decimal   no-undo .
     1313     define input  parameter p-move-resize as logical   no-undo .
     1314     do
     1315     on error undo, return error return-value
     1316     :
     1317       run diasize_change-height in this-procedure
     1318         (input  (p-new-height - frame Dialog-Frame :height)
     1319         ,input  p-move-resize
     1320         ) .
     1321     end.
     1322   end procedure.
     1323   procedure diasize_change-width :
     1324     define input  parameter p-change-value as decimal   no-undo .
     1325     define input  parameter p-move-resize  as logical   no-undo .
     1326     define variable v-field-group-handle   as handle    no-undo .
     1327     define variable v-object-handle        as handle    no-undo .
     1328     define variable v-frame-width          as decimal   no-undo .
     1329     define variable v-frame-virtual-width  as decimal   no-undo .
     1330     define variable v-browse-width         as decimal   no-undo .
     1331     define variable v-window-width         as decimal   no-undo .
     1332     define variable v-window-virtual-width as decimal   no-undo .
     1333     define variable v-change-sign          as integer   no-undo .
     1334     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1335     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1336     if p-change-value > 0
     1337     then do:
     1338       if frame Dialog-Frame :width + p-change-value >
     1339           session :width-chars
     1340       then do:
     1341         assign
     1342           p-change-value = session :width-chars - frame Dialog-Frame :width
     1343         .
     1344         if p-change-value <= 0
     1345         then do:
     1346           run diasize_position-resize-button in this-procedure .
     1347           return .
     1348         end.
     1349       end.
     1350     end.
     1351     if p-change-value < 0
     1352     then do:
     1353       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1354       then do:
     1355         assign
     1356           p-change-value = v-diasize-orig-frame-width
     1357                          - frame Dialog-Frame :width
     1358         .
     1359         if p-change-value >= 0
     1360         then do:
     1361           run diasize_position-resize-button in this-procedure .
     1362           return .
     1363         end.
     1364       end.
     1365     end.
     1366     if p-change-value >= 0
     1367     then do:
     1368       assign
     1369         v-change-sign = 1
     1370       .
     1371     end.
     1372     else do:
     1373       assign
     1374         v-change-sign = -1
     1375       .
     1376     end.
     1377     assign
     1378       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1379     .
     1380     if p-change-value = 0
     1381     then do:
     1382       run diasize_position-resize-button in this-procedure .
     1383       return .
     1384     end.
     1385     move_block:
     1386     do
     1387     on error undo move_block, leave move_block
     1388     :
     1389       if retry
     1390       then do:
     1391         do
     1392         on error undo move_block, leave move_block
     1393         :
     1394           if p-change-value > 0
     1395           then do:
     1396             for each buf_temp-diasize-handle
     1397             on error undo, next
     1398             :
     1399               assign
     1400                 v-object-handle = buf_temp-diasize-handle.handle-value
     1401               .
     1402               if v-object-handle <> v-diasize-resize-button
     1403               then do:
     1404                 assign
     1405                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1406                 .
     1407               end.
     1408             end.
     1409             assign
     1410               v-diasize-browse-handle :width = v-browse-width
     1411             .
     1412             for each buf_temp-browse-handle
     1413               where buf_temp-browse-handle.browse-type = 'width':u
     1414             on error undo, next
     1415             :
     1416               assign
     1417                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1418               .
     1419             end.
     1420             assign
     1421               frame Dialog-Frame :width = v-frame-width
     1422             .
     1423             if frame Dialog-Frame :scrollable = true
     1424             then do:
     1425               assign
     1426                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1427               .
     1428             end.
     1429             run diasize_position-resize-button in this-procedure .
     1430           end.
     1431           else do:
     1432             if frame Dialog-Frame :scrollable = true
     1433             then do:
     1434               assign
     1435                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1436               .
     1437             end.
     1438             assign
     1439               frame Dialog-Frame :width = v-frame-width
     1440             .
     1441             for each buf_temp-browse-handle
     1442               where buf_temp-browse-handle.browse-type = 'width':u
     1443             on error undo, next
     1444             :
     1445               assign
     1446                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1447               .
     1448             end.
     1449             assign
     1450               v-diasize-browse-handle :width = v-browse-width
     1451             .
     1452             for each buf_temp-diasize-handle
     1453             on error undo, next
     1454             :
     1455               assign
     1456                 v-object-handle = buf_temp-diasize-handle.handle-value
     1457               .
     1458               if v-object-handle <> v-diasize-resize-button
     1459               then do:
     1460                 assign
     1461                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1462                 .
     1463               end.
     1464             end.
     1465             run diasize_position-resize-button in this-procedure .
     1466           end.
     1467           assign
     1468             v-diasize-change-size = false
     1469           .
     1470           leave move_block .
     1471         end.
     1472       end.
     1473       assign
     1474         v-diasize-need-full-display = true
     1475       .
     1476       if v-diasize-change-size = false
     1477       then do:
     1478         assign
     1479           v-diasize-change-size = true
     1480         .
     1481       end.
     1482       else do:
     1483         return .
     1484       end.
     1485       assign
     1486         v-frame-width = frame Dialog-Frame :width
     1487         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1488         v-browse-width = v-diasize-browse-handle :width
     1489       .
     1490       for each buf_temp-browse-handle
     1491         where buf_temp-browse-handle.browse-type = 'width':u
     1492       :
     1493         assign
     1494           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1495         .
     1496       end.
     1497       for each buf_temp-diasize-handle
     1498       :
     1499         delete buf_temp-diasize-handle .
     1500       end.
     1501       assign
     1502         v-field-group-handle = frame Dialog-Frame :first-child
     1503       .
     1504       do while valid-handle(v-field-group-handle)
     1505       :
     1506         assign
     1507           v-object-handle = v-field-group-handle :first-child
     1508         .
     1509         do while valid-handle(v-object-handle)
     1510         :
     1511           if  v-object-handle <> v-diasize-browse-handle :handle
     1512           and v-object-handle <> v-diasize-resize-button
     1513           and can-query(v-object-handle, "row")
     1514           and can-query(v-object-handle, "height")
     1515           and ( v-object-handle :col + v-object-handle :width
     1516                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1517               )
     1518           then do:
     1519             find first buf_temp-browse-handle
     1520               where buf_temp-browse-handle.browse-type   = 'width':u
     1521                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1522               no-error .
     1523             if available buf_temp-browse-handle
     1524             then do:
     1525             end.
     1526             else do:
     1527               create buf_temp-diasize-handle .
     1528               assign
     1529                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1530                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1531               .
     1532             end.
     1533           end.
     1534           assign
     1535             v-object-handle = v-object-handle :next-sibling
     1536           .
     1537         end.
     1538         assign
     1539           v-field-group-handle = v-field-group-handle :next-sibling
     1540         .
     1541       end.
     1542       do with frame Dialog-Frame
     1543       :
     1544         hide v-diasize-resize-button .
     1545         v-diasize-resize-button :row = 1.
     1546         v-diasize-resize-button :column = 1.
     1547       end.
     1548       if p-change-value > 0
     1549       then do:
     1550         if frame Dialog-Frame :scrollable = true
     1551         then do:
     1552           assign
     1553             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1554             no-error .
     1555           if error-status :error
     1556           or error-status :get-message(1) <> ""
     1557           then do:
     1558             undo move_block, retry move_block.
     1559           end.
     1560         end.
     1561         assign
     1562           frame Dialog-Frame :width = v-frame-width + p-change-value
     1563           no-error .
     1564         if error-status :error
     1565         or error-status :get-message(1) <> ""
     1566         then do:
     1567           undo move_block, retry move_block.
     1568         end.
     1569         assign
     1570           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1571         no-error .
     1572         if error-status :error
     1573         or error-status :get-message(1) <> ""
     1574         then do:
     1575           undo move_block, retry move_block.
     1576         end.
     1577         for each buf_temp-browse-handle
     1578           where buf_temp-browse-handle.browse-type = 'width':u
     1579         on error undo move_block, retry move_block
     1580         :
     1581           assign
     1582             buf_temp-browse-handle.browse-handle :width
     1583               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1584             no-error .
     1585           if error-status :error
     1586           or error-status :get-message(1) <> ""
     1587           then do:
     1588             undo move_block, retry move_block .
     1589           end.
     1590         end.
     1591         for each buf_temp-diasize-handle
     1592         on error undo move_block, retry move_block
     1593         :
     1594           assign
     1595             v-object-handle = buf_temp-diasize-handle.handle-value
     1596           .
     1597           if v-object-handle <> v-diasize-resize-button
     1598           then do:
     1599             assign
     1600               v-object-handle :col = v-object-handle :col + p-change-value
     1601               no-error .
     1602             if error-status :error
     1603             or error-status :get-message(1) <> ""
     1604             then do:
     1605               undo move_block, retry move_block .
     1606             end.
     1607           end.
     1608         end.
     1609       end.
     1610       else do:
     1611         for each buf_temp-diasize-handle
     1612         on error undo move_block, retry move_block
     1613         :
     1614           assign
     1615             v-object-handle = buf_temp-diasize-handle.handle-value
     1616           .
     1617           if v-object-handle <> v-diasize-resize-button
     1618           then do:
     1619             assign
     1620               v-object-handle :col = v-object-handle :col + p-change-value
     1621               no-error .
     1622             if error-status :error
     1623             or error-status :get-message(1) <> ""
     1624             then do:
     1625               undo move_block, retry move_block .
     1626             end.
     1627           end.
     1628         end.
     1629         for each buf_temp-browse-handle
     1630           where buf_temp-browse-handle.browse-type = 'width':u
     1631         on error undo move_block, retry move_block
     1632         :
     1633           assign
     1634             buf_temp-browse-handle.browse-handle :width
     1635               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1636             no-error .
     1637           if error-status :error
     1638           or error-status :get-message(1) <> ""
     1639           then do:
     1640             undo move_block, retry move_block .
     1641           end.
     1642         end.
     1643         assign
     1644           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1645           no-error .
     1646         if error-status :error
     1647         or error-status :get-message(1) <> ""
     1648         then do:
     1649           undo move_block, retry move_block.
     1650         end.
     1651         assign
     1652           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1653         no-error .
     1654         if error-status :error
     1655         or error-status :get-message(1) <> ""
     1656         then do:
     1657           undo move_block, retry move_block.
     1658         end.
     1659         if frame Dialog-Frame :scrollable = true
     1660         then do:
     1661           assign
     1662             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1663           no-error .
     1664           if error-status :error
     1665           or error-status :get-message(1) <> ""
     1666           then do:
     1667             undo move_block, retry move_block.
     1668           end.
     1669         end.
     1670       end.
     1671       if p-move-resize
     1672       then do:
     1673         run diasize_position-resize-button in this-procedure .
     1674       end.
     1675       if v-diasize-wndstore = true
     1676       then do:
     1677         if connected("ub") = true
     1678         then do:
     1679           define variable v-cntxt-db-num        as integer   no-undo .
     1680           define variable v-cntxt-userid        as character no-undo .
     1681           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1682                                             , OUTPUT v-cntxt-userid
     1683                                             ) .
     1684           run gbl/wndsizew.p
     1685             (input  v-cntxt-db-num
     1686             ,input  v-cntxt-userid
     1687             ,input  v-diasize-proc-name
     1688             ,input  'width':u
     1689             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1690             ) .
     1691         end.
     1692       end.
     1693     end.
     1694     assign
     1695       v-diasize-change-size = false
     1696     .
     1697   end procedure.
     1698   procedure diasize_set-width :
     1699     define input  parameter p-new-width  as decimal   no-undo .
     1700     define input  parameter p-move-resize as logical   no-undo .
     1701     do
     1702     on error undo, return error return-value
     1703     :
     1704       run diasize_change-width in this-procedure
     1705         (input  (p-new-width - frame Dialog-Frame :width)
     1706         ,input  p-move-resize
     1707         ) .
     1708     end.
     1709   end procedure.
     1710   procedure diasize_position-resize-button :
     1711     do with frame Dialog-Frame
     1712     :
     1713       hide v-diasize-resize-button .
     1714       assign
     1715         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1716                     - 1
     1717                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1718         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1719                     - 1
     1720                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1721       .
     1722       view v-diasize-resize-button .
     1723     end.
     1724   end procedure.
     1725   on alt-right anywhere
     1726   do:
     1727     run diasize_change-width in this-procedure
     1728       (input 1
     1729       ,input true
     1730       ) .
     1731     return no-apply .
     1732   end.
     1733   on alt-left anywhere
     1734   do:
     1735     run diasize_change-width in this-procedure
     1736       (input -1
     1737       ,input true
     1738       ) .
     1739     return no-apply .
     1740   end.
     1741   on alt-down anywhere
     1742   do:
     1743     run diasize_change-height in this-procedure
     1744       (input 1
     1745       ,input true
     1746       ) .
     1747     return no-apply .
     1748   end.
     1749   on alt-up anywhere
     1750   do:
     1751     run diasize_change-height in this-procedure
     1752       (input -1
     1753       ,input true
     1754       ) .
     1755     return no-apply .
     1756   end.
     1757   on alt-enter of frame Dialog-Frame
     1758   do:
     1759     run diasize_maximize in this-procedure
     1760       (input  ?
     1761       ).
     1762     return no-apply .
     1763   end.
     1764   procedure diasize_end-move :
     1765     do
     1766     on error undo, return error return-value
     1767     :
     1768       define variable v-row-delta as decimal   no-undo .
     1769       define variable v-col-delta as decimal   no-undo .
     1770       define variable v-new-row as decimal   no-undo .
     1771       define variable v-new-col as decimal   no-undo .
     1772       assign
     1773         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1774         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1775       .
     1776       assign
     1777         v-row-delta = v-new-row - frame Dialog-Frame :height
     1778         v-col-delta = v-new-col - frame Dialog-Frame :width
     1779       .
     1780       run diasize_change-height in this-procedure
     1781         (input v-row-delta
     1782         ,input true
     1783         ) .
     1784       run diasize_change-width in this-procedure
     1785         (input v-col-delta
     1786         ,input true
     1787         ) .
     1788     end.
     1789   end procedure.
     1790   procedure diasize_maximize :
     1791     define input  parameter p-action as logical   no-undo .
     1792     do
     1793     on error undo, return error return-value
     1794     :
     1795       if p-action = ?
     1796       then do:
     1797         if v-diasize-need-maximize = true
     1798         then do:
     1799           assign
     1800             p-action = true
     1801           .
     1802         end.
     1803         else do:
     1804           assign
     1805             p-action = false
     1806           .
     1807         end.
     1808       end.
     1809       if p-action = true
     1810       then do:
     1811         run diasize_change-height in this-procedure
     1812           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1813               - frame Dialog-Frame :height-chars
     1814           ,input true
     1815           ) .
     1816         run diasize_change-width in this-procedure
     1817           (input session :width-chars
     1818               - frame Dialog-Frame :width-chars
     1819           ,input true
     1820           ) .
     1821         assign
     1822           v-diasize-need-maximize = false
     1823         .
     1824       end.
     1825       else do:
     1826         run diasize_change-width in this-procedure
     1827           (input v-diasize-orig-frame-width
     1828               - frame Dialog-Frame :width-chars
     1829           ,input true
     1830           ) .
     1831         run diasize_change-height in this-procedure
     1832           (input v-diasize-orig-frame-height
     1833               - frame Dialog-Frame :height-chars
     1834           ,input true
     1835           ) .
     1836         assign
     1837           v-diasize-need-maximize = true
     1838         .
     1839       end.
     1840     end.
     1841   end procedure.
     1842   procedure diasize_restore-orig-size :
     1843     do
     1844     on error undo, return error return-value
     1845     :
     1846       assign
     1847         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1848         v-diasize-current-frame-height = frame Dialog-Frame :height
     1849       .
     1850       run diasize_set-height in this-procedure
     1851         (input  v-diasize-orig-frame-height
     1852         ,input  true
     1853         ) .
     1854       run diasize_set-width in this-procedure
     1855         (input  v-diasize-orig-frame-width
     1856         ,input  true
     1857         ) .
     1858     end.
     1859   end procedure.
     1860   procedure diasize_restore-current-size :
     1861     do
     1862     on error undo, return error return-value
     1863     :
     1864       run diasize_set-height in this-procedure
     1865         (input  v-diasize-current-frame-height
     1866         ,input  true
     1867         ) .
     1868       run diasize_set-width in this-procedure
     1869         (input  v-diasize-current-frame-width
     1870         ,input  true
     1871         ) .
     1872     end.
     1873   end procedure.
     1874   procedure diasize_set-browse-handle :
     1875     define input  parameter p-browse-handle as handle   no-undo .
     1876     define buffer buf_temp-browse-handle for temp-browse-handle .
     1877     do
     1878     on error undo, return error return-value
     1879     :
     1880       assign
     1881         v-diasize-browse-handle = p-browse-handle
     1882       .
     1883       for each buf_temp-browse-handle
     1884       on error undo, return error return-value
     1885       :
     1886         delete buf_temp-browse-handle .
     1887       end.
     1888     end.
     1889   end procedure.
     1890   procedure diasize_add_browse :
     1891     define input  parameter p-browse-type   as character no-undo .
     1892     define input  parameter p-browse-handle as handle    no-undo .
     1893     define buffer buf_temp-browse-handle for temp-browse-handle .
     1894     do
     1895     on error undo, return error return-value
     1896     :
     1897       assign
     1898         v-diasize-browse-number = v-diasize-browse-number + 1
     1899       .
     1900       create buf_temp-browse-handle .
     1901       assign
     1902         buf_temp-browse-handle.browse-type   = p-browse-type
     1903         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1904         buf_temp-browse-handle.browse-handle = p-browse-handle
     1905       .
     1906     end.
     1907   end procedure.
     1908   procedure diasize_init :
     1909     define variable v-default-value    as logical   no-undo .
     1910     define variable v-restore-saved    as logical   no-undo .
     1911     define variable v-resize-value-str as character no-undo .
     1912     do
     1913     on error undo, return error return-value
     1914     :
     1915       do with frame Dialog-Frame
     1916       :
     1917         assign
     1918           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1919           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1920           v-diasize-browse-handle     = browse BR-SCL-ATTRS :handle
     1921         .
     1922         create button v-diasize-resize-button
     1923         assign
     1924           parent        = frame Dialog-Frame :first-child
     1925           label         = "s"
     1926           height-pixels = 16
     1927           width-pixels  = 16
     1928           visible       = true
     1929           sensitive     = true
     1930           movable       = true
     1931           triggers:
     1932             on end-move persistent run diasize_end-move in this-procedure .
     1933           end triggers.
     1934         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1935         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1936         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1937         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1938         assign
     1939           v-diasize-wndmax = false
     1940         .
     1941         if connected("ub") = true
     1942         then do:
     1943           define variable v-cntxt-db-num        as integer   no-undo .
     1944           define variable v-cntxt-userid        as character no-undo .
     1945           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1946                                             , OUTPUT v-cntxt-userid
     1947                                             ) .
     1948           run gbl/wndpar_r.p
     1949             (input  v-cntxt-db-num
     1950             ,input  v-cntxt-userid
     1951             ,input  'wndmax':U
     1952             ,output v-diasize-wndmax
     1953             ,output v-default-value
     1954             ) .
     1955         end.
     1956         assign
     1957           v-diasize-wndstore = false
     1958         .
     1959         if connected("ub") = true
     1960         then do:
     1961           run gbl/wndpar_r.p
     1962             (input  v-cntxt-db-num
     1963             ,input  v-cntxt-userid
     1964             ,input  'wndstore':U
     1965             ,output v-diasize-wndstore
     1966             ,output v-default-value
     1967             ) .
     1968         end.
     1969         assign
     1970           v-diasize-proc-name = entry(1, program-name(2), '.')
     1971         .
     1972         if v-diasize-wndstore = true
     1973         then do:
     1974           assign
     1975             v-restore-saved = false
     1976           .
     1977           if connected("ub") = true
     1978           then do:
     1979             run gbl/wndsizer.p
     1980               (input  v-cntxt-db-num
     1981               ,input  v-cntxt-userid
     1982               ,input  v-diasize-proc-name
     1983               ,input  'height':u
     1984               ,output v-resize-value-str
     1985               ) .
     1986             if v-resize-value-str <> '':U
     1987             then do:
     1988               run diasize_change-height in this-procedure
     1989                 (input  integer(v-resize-value-str)
     1990                 ,input  true
     1991                 ) .
     1992               assign
     1993                 v-restore-saved = true
     1994               .
     1995             end.
     1996           end.
     1997           if connected("ub") = true
     1998           then do:
     1999             run gbl/wndsizer.p
     2000               (input  v-cntxt-db-num
     2001               ,input  v-cntxt-userid
     2002               ,input  v-diasize-proc-name
     2003               ,input  'width':u
     2004               ,output v-resize-value-str
     2005               ) .
     2006             if v-resize-value-str <> '':U
     2007             then do:
     2008               run diasize_change-width in this-procedure
     2009                 (input  integer(v-resize-value-str)
     2010                 ,input  true
     2011                 ) .
     2012               assign
     2013                 v-restore-saved = true
     2014               .
     2015             end.
     2016           end.
     2017           if v-restore-saved <> true
     2018           then do:
     2019             if v-diasize-wndmax = true
     2020             then do:
     2021               run diasize_maximize in this-procedure
     2022                 (input  true
     2023                 ) .
     2024             end.
     2025           end.
     2026         end.
     2027         else do:
     2028           if v-diasize-wndmax = true
     2029           then do:
     2030             run diasize_maximize in this-procedure
     2031               (input  true
     2032               ) .
     2033           end.
     2034         end.
     2035       end.
     2036     end.
     2037   end procedure.
     2038   procedure diasize_need-full-display :
     2039     define output parameter p-need-full-display as logical   no-undo .
     2040     do
     2041     on error undo, return error return-value
     2042     :
     2043       assign
     2044         p-need-full-display = v-diasize-need-full-display
     2045       .
     2046       assign
     2047         v-diasize-need-full-display = false
     2048       .
     2049     end.
     2050   end procedure.
     2051   procedure get-context :
     2052      define output parameter p-db-num as integer          no-undo.
     2053      define output parameter p-user-id as character        no-undo.
     2054      define variable v-login               as character    no-undo.
     2055      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2056      define buffer buf_user-login  for ub.user-login .
     2057      do
     2058      on error undo, return error
     2059      :
     2060            FIND FIRST buf_sys-ctrl no-lock.
     2061            ASSIGN
     2062               v-login = USERID("ub")
     2063               p-db-num = buf_sys-ctrl.db-num
     2064            .
     2065            FIND FIRST buf_user-login
     2066                 WHERE buf_user-login.db-num = p-db-num
     2067                   AND buf_user-login.user-login = v-login
     2068                 no-lock
     2069                 no-error
     2070                 .
     2071            IF AVAILABLE buf_user-login
     2072            THEN DO:
     2073               assign
     2074                  p-user-id = buf_user-login.user-id
     2075               .
     2076            END.
     2077      end.
     2078   end procedure.
     2079       run diasize_init in this-procedure .
     2080    frame Dialog-Frame:TITLE = frame Dialog-Frame:TITLE.
     2081   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     2082   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     2083   MAIN-BLOCK:
     2084   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2085      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2086      IF mode <> 'ИЗМЕНЕНИЕ':U
     2087      AND mode <> 'ПРОСМОТР':U THEN DO:
     2088         MESSAGE
     2089         substitute("Неверное значение параметра p-mode = &1", mode)
     2090         VIEW-AS ALERT-BOX ERROR.
     2091         RETURN ERROR.
     2092      END.
     2093     find first buf_scales
     2094     where buf_scales.db-num =  p-db-num
     2095       AND buf_scales.scales-num = p-scales-num
     2096       no-lock  .
     2097     RUN MyEnable no-error.
     2098     if error-status:error then return error.
     2099     Run init-proc.
     2100     view frame Dialog-Frame .
     2101     WAIT-FOR GO OF FRAME Dialog-Frame.
     2102   END.
     2103   RUN disable_UI.
     2104   if updated then return 'ИЗМЕНЕНИЕ':U.
     2105   PROCEDURE disable_UI :
     2106     HIDE FRAME Dialog-Frame.
     2107   END PROCEDURE.
     2108   PROCEDURE enable_UI :
     2109     DISPLAY scl-db-num scl-scales-type scl-scales-num scl-scales-name
     2110         WITH FRAME Dialog-Frame.
     2111     ENABLE b-quit b-ins b-chg b-del b-help scl-db-num scl-scales-type
     2112            scl-scales-num scl-scales-name
     2113         WITH FRAME Dialog-Frame.
     2114     VIEW FRAME Dialog-Frame.
     2115     OPEN QUERY BR-SCL-ATTRS FOR EACH Temp-hattr NO-LOCK.
     2116   END PROCEDURE.
     2117   PROCEDURE init-proc :
     2118   define var  attr-type as character no-undo .
     2119   define var  attr-format as character no-undo .
     2120   define var  attr-label as character no-undo .
     2121   define var  attr-value as character no-undo .
     2122   define var  attr-user-can-edit as logical no-undo .
     2123   define var  attr-output-display as logical no-undo .
     2124   define var  attr-other as char no-undo .
     2125   define buffer buf_scales-attr for ub.scales-attr.
     2126   for each  Temp-hattr share-lock: delete Temp-hattr. end.
     2127   add-option = "".
     2128   Assign
     2129       scl-db-num = buf_scales.db-num
     2130       scl-scales-num = buf_scales.scales-num
     2131       scl-scales-type = buf_scales.scales-type
     2132       scl-scales-name = buf_scales.scales-name
     2133       .
     2134   display scl-db-num scl-scales-num scl-scales-type scl-scales-name
     2135     with frame Dialog-Frame  .
     2136      For each buf_scales-attr where
     2137               buf_scales-attr.db-num  = p-db-num
     2138          and  buf_scales-attr.scales-num  = p-scales-num
     2139               no-lock :
     2140             run scl-attr-code ( input buf_scales-attr.attr-code ,
     2141                                 output attr-type ,
     2142                                 output attr-format,
     2143                                 output attr-label,
     2144                                 output attr-user-can-edit,
     2145                                 output attr-output-display,
     2146                                 output attr-other ).
     2147             if attr-output-display = true then DO:
     2148                 run scl-attr-value ( input buf_scales-attr.db-num,
     2149                                     input buf_scales-attr.scales-num,
     2150                                     input buf_scales-attr.attr-code,
     2151                                     output attr-value,
     2152                                     output attr-type ).
     2153                 create Temp-hattr.
     2154                 assign Temp-hattr.attr-code = attr-label
     2155                        Temp-hattr.value_ = buf_scales-attr.attr-value
     2156                        Temp-hattr.attr-value = (if attr-type = 'L':U
     2157                                                 then string(attr-value = "yes":U, attr-format)
     2158                                                 else attr-value)
     2159                        Temp-hattr.user-can-edit = attr-user-can-edit
     2160                        Temp-hattr.code = buf_scales-attr.attr-code
     2161                       .
     2162                   End.
     2163       End.
     2164       OPEN QUERY BR-SCL-ATTRS FOR EACH Temp-hattr NO-LOCK.
     2165   END PROCEDURE.
     2166   PROCEDURE MyEnable :
     2167   define var  attr-type as character no-undo .
     2168   define var  attr-format as character no-undo .
     2169   define var  attr-label as character no-undo .
     2170   define var  attr-value as character no-undo .
     2171   define var  attr-user-can-edit as logical no-undo .
     2172   define var  attr-output-display as logical no-undo .
     2173   define var  attr-other as char no-undo .
     2174   define variable ii as integer no-undo .
     2175   define variable jj as integer no-undo .
     2176   define variable v-scl as character no-undo .
     2177   define variable v-scl-list as character no-undo .
     2178   if mode <> 'ПРОСМОТР':U then do:
     2179     do ii = 1 to num-entries('tare-weight':u):
     2180       run scl-attr-code (
     2181         input  entry(ii, 'tare-weight':u)
     2182         ,output attr-type
     2183         ,output attr-format
     2184         ,output attr-label
     2185         ,output attr-user-can-edit
     2186         ,output attr-output-display
     2187         ,output attr-other
     2188         ) .
     2189       do jj = 1 to num-entries(attr-other, chr(47)):
     2190         if entry(1, entry(jj, attr-other, chr(47)), "=":U) = "scl":U then do:
     2191           assign
     2192           v-scl = string(entry(2, entry(jj, attr-other, chr(47)), "=":U))
     2193           v-scl-list = v-scl-list + (if ii = 1 then "":U else chr(47)) + v-scl
     2194           .
     2195         end.
     2196       end.
     2197     end.
     2198       assign
     2199       MENU-ITEM m_tara-weight:private-data in menu MENU-b-ins = 'tare-weight':U
     2200       .
     2201       assign
     2202       ii = LOOKUP(MENU-ITEM m_tara-weight:private-data in menu MENU-b-ins, 'tare-weight':u)
     2203       v-scl = entry(ii, v-scl-list, chr(47))
     2204       MENU-ITEM m_tara-weight:sensitive in menu MENU-b-ins = (LOOKUP(buf_scales.scales-type, v-scl)  > 0)
     2205       .
     2206     end.
     2207     ENABLE
     2208     b-quit
     2209     b-del when mode = 'ИЗМЕНЕНИЕ':U
     2210     b-ins when mode = 'ИЗМЕНЕНИЕ':U
     2211     b-chg when mode = 'ИЗМЕНЕНИЕ':U
     2212     b-help BR-SCL-ATTRS
     2213     WITH FRAME Dialog-Frame .
     2214     VIEW FRAME Dialog-Frame .
     2215     OPEN QUERY BR-SCL-ATTRS FOR EACH Temp-hattr NO-LOCK.
     2216     ASSIGN b-ins:MENU-MOUSE = 1.
     2217   END PROCEDURE.
     2218   PROCEDURE proc-add-chg :
     2219   define input parameter p-add as logical no-undo .
     2220   define variable attr-type as character no-undo .
     2221   define variable attr-format as character no-undo .
     2222   define variable attr-label as character no-undo .
     2223   define variable attr-user-can-edit as logical no-undo .
     2224   define variable attr-output-display as logical no-undo .
     2225   define variable attr-other as char no-undo .
     2226   define variable attr-value as character no-undo .
     2227   define variable v-attr-value as character no-undo .
     2228   define variable v-init as character no-undo .
     2229   define variable jj as integer no-undo.
     2230   DEFINE VARIABLE v-spr as character no-undo .
     2231   DEFINE VARIABLE v-setted as logical no-undo .
     2232   DEFINE VARIABLE v-deleted as logical no-undo .
     2233   define variable v-check as character no-undo .
     2234   define variable v-error-code as character no-undo .
     2235   define variable v-correct as logical no-undo .
     2236   define var loc#log as logical no-undo.
     2237   case p-add:
     2238     when yes then do:
     2239       if mode <> 'ДОБАВЛЕНИЕ':U then do:
     2240         run temp-scl-attr-exist in this-procedure(
     2241                                       input p-db-num,
     2242                                       input p-scales-num,
     2243                                       input add-option,
     2244                                       output loc#log)  no-error.
     2245         if error-status:error then return error.
     2246         if loc#log then do:
     2247           message
     2248           "Данный атрибут уже существует"
     2249           view-as alert-box error .
     2250           return error.
     2251         end.
     2252       end.
     2253       run scl-attr-code in this-procedure
     2254         (input  add-option
     2255         ,output attr-type
     2256         ,output attr-format
     2257         ,output attr-label
     2258         ,output attr-user-can-edit
     2259         ,output attr-output-display
     2260         ,output attr-other
     2261         ) no-error .
     2262       if error-status :error then do:
     2263         return error .
     2264       end.
     2265       assign
     2266       added = yes.
     2267       do jj = 1 to num-entries(attr-other, chr(47)):
     2268         if entry(1, entry(jj, attr-other, chr(47)), "=":U) = "init":U then do:
     2269           assign
     2270           v-init = string(entry(2, entry(jj, attr-other, chr(47)), "=":U))
     2271           .
     2272         end.
     2273       end.
     2274       if  v-init <> "":U then do:
     2275           run  value(v-init)
     2276                       in this-procedure (
     2277                                             p-db-num
     2278                                           , p-scales-num
     2279                                           , output attr-value) no-error .
     2280             if error-status:error then do:
     2281                 assign
     2282                 attr-value = "":U
     2283                 .
     2284             end.
     2285       end.
     2286       CASE attr-type:
     2287         when 'L':U then do:
     2288           assign
     2289           v-attr-value = "yes":U
     2290           .
     2291         end.
     2292         when 'I':U or when 'D':U then do:
     2293           assign
     2294           v-attr-value = if v-init <> "":U
     2295                         then attr-value
     2296                         else string(0)
     2297           .
     2298         end.
     2299         when 'T':U then do:
     2300           assign
     2301           v-attr-value = ?
     2302           .
     2303         end.
     2304         when 'C':U then do:
     2305           assign
     2306           v-attr-value = if v-init <> "":U
     2307                         then attr-value
     2308                         else "":U
     2309           .
     2310         end.
     2311       END CASE.
     2312       assign
     2313       attr-value = v-attr-value
     2314       .
     2315     end.
     2316     when no then do:
     2317       run scl-attr-code in this-procedure(input TEMP-hattr.code,
     2318                                       output attr-type,
     2319                                       output attr-format,
     2320                                       output attr-label,
     2321                                       output attr-user-can-edit,
     2322                                       output attr-output-display,
     2323                                       output attr-other) no-error.
     2324       IF ERROR-STATUS:ERROR THEN DO:
     2325           message "Ошибка при определении названия и типа атрибута весов!"         "Обратитесь к администратору системы" skip error-status:get-message(1) skip         return-value skip view-as alert-box ERROR.
     2326           return error.
     2327       END.
     2328       RUN scl-attr-VALUE IN THIS-PROCEDURE(
     2329                                            INPUT p-db-num,
     2330                                            input p-scales-num,
     2331                                            input TEMP-hattr.code,
     2332                                            OUTPUT ATTR-VALUE,
     2333                                            OUTPUT attr-type) NO-ERROR.
     2334       IF ERROR-STATUS:ERROR THEN DO:
     2335           message "Ошибка при определении значения атрибута весов!"         "Обратитесь к администратору системы" skip error-status:get-message(1) skip         return-value skip view-as alert-box ERROR.
     2336           return error.
     2337       END.
     2338     end.
     2339   END CASE.
     2340   IF attr-user-can-edit Then DO:
     2341     do jj = 1 to num-entries(attr-other, chr(47)):
     2342       if entry(1, entry(jj, attr-other, chr(47)), "=":U) = "spr":U then do:
     2343         assign
     2344         v-spr = string(entry(2, entry(jj, attr-other, chr(47)), "=":U))
     2345         .
     2346       end.
     2347       if entry(1, entry(jj, attr-other, chr(47)), "=":U) = "check":U then do:
     2348         assign
     2349         v-check = string(entry(2, entry(jj, attr-other, chr(47)), "=":U))
     2350         .
     2351       end.
     2352     end.
     2353     if v-spr = "":U then do:
     2354     run gbl/d-prompt.w (
     2355       'title=':u + "Изменение атрибута весов" + '\':u
     2356     + 'text1=':u + attr-label + '\':u
     2357     + 'format=' + (if attr-type = 'L':U then "yes/no" else attr-format) + '\':u
     2358     + 'type=' + attr-type + '\':u
     2359     + 'fillin_row=2\':u
     2360     + 'fillin_col=4\':u
     2361     + 'fillin_width=20\':u
     2362     + 'fillin_height=1\':u
     2363     + 'max-chars=70\':u
     2364     + 'readonly=' + (if mode <> 'ИЗМЕНЕНИЕ':U then 'yes':u else 'no':u) + '\':u
     2365     , input-output attr-value
     2366         ).
     2367     if return-value = 'false':u then return error.
     2368     END.
     2369     ELSE DO:
     2370         run  value(v-spr)
     2371                     in this-procedure (
     2372                                          input p-db-num
     2373                                         ,INPUT p-scales-num
     2374                                         ,input-output attr-value
     2375                                         ,output v-setted) no-error .
     2376         if not v-setted then return error.
     2377     end.
     2378     if v-check <> "":U then do:
     2379       run value(v-check)(
     2380                          input p-db-num
     2381                         ,input p-scales-num
     2382                         ,input (if p-add = yes then add-option else temp-hattr.attr-code)
     2383                         ,input attr-value
     2384                         ,input (if p-add then 'ДОБАВЛЕНИЕ':U else 'ИЗМЕНЕНИЕ':U)
     2385                         ,output v-correct
     2386                         ,output v-error-code) no-error.
     2387       if error-status:error then do:
     2388         message
     2389         "Ошибка при проверке корректности задаваемого значения атрибута" skip
     2390         error-status:get-message(1) skip
     2391         view-as alert-box error .
     2392         undo, return error .
     2393       end.
     2394       if not v-correct then do:
     2395         message
     2396         "Задаваемое значение атрибута некорректно" skip
     2397         return-value
     2398         view-as alert-box error .
     2399         undo, return error .
     2400       end.
     2401     end.
     2402     run scl-attr-write in this-procedure(
     2403                                       input p-db-num,
     2404                                       input p-scales-num,
     2405                                       input (if p-add then add-option else temp-hattr.code),
     2406                                       input attr-value
     2407                                      ) no-error .
     2408     IF NOT error-status:error then do:
     2409         assign
     2410         updated = yes
     2411         .
     2412     END.
     2413     else do:
     2414         message "Ошибка при изменении значения атрибута весов!"         "Обратитесь к администратору системы" skip error-status:get-message(1) skip         return-value skip view-as alert-box ERROR.
     2415     end.
     2416   End.
     2417   Else message "Изменение атрибута невозможно !" view-as alert-box error.
     2418   END PROCEDURE.
     2419   PROCEDURE temp-scl-attr-exist :
     2420     do
     2421     on error undo, return error
     2422     :
     2423       define input parameter p-db-num   like ub.scales-attr.db-num     no-undo .
     2424       define input parameter p-scales-num like ub.scales-attr.scales-num   no-undo .
     2425       define input parameter p-code     like ub.scales-attr.attr-code  no-undo .
     2426       define output parameter p-exist   as logical  no-undo .
     2427       define buffer buf_temp-hattr for temp-hattr .
     2428       define variable v-type           as character no-undo .
     2429       define variable v-format         as character no-undo .
     2430       define variable v-label          as character no-undo .
     2431       define variable v-user-can-edit  as logical   no-undo .
     2432       define variable v-output-display as logical   no-undo .
     2433       define variable v-other          as character no-undo .
     2434       run scl-attr-code in this-procedure
     2435         (input  p-code
     2436         ,output v-type
     2437         ,output v-format
     2438         ,output v-label
     2439         ,output v-user-can-edit
     2440         ,output v-output-display
     2441         ,output v-other
     2442         ) no-error .
     2443       if error-status :error then do:
     2444         undo, return error return-value .
     2445       end.
     2446       find first buf_temp-hattr exclusive-lock
     2447         where buf_temp-hattr.db-num  = p-db-num
     2448           and buf_temp-hattr.scales-num  = p-scales-num
     2449           and buf_temp-hattr.attr-code = p-code
     2450         no-error .
     2451       if  available buf_temp-hattr then do:
     2452         p-exist = yes.
     2453       end.
     2454     end.
     2455   END PROCEDURE.
