     1560   PROCEDURE ProcPricePrint.
     1561   define input parameter par-print-option as character no-undo .
     1562   define parameter buffer locked_scales for ub.scales.
     1563   define variable print-mode as char init "bar"   no-undo .
     1564   define variable sym1 as char init ":"   no-undo.
     1565   define variable sym2 as char init ":"   no-undo.
     1566   define variable sym3 as char init ":"   no-undo.
     1567   define variable sym4 as char init ":"   no-undo.
     1568   define variable sym5 as char init ":"   no-undo.
     1569   define variable sym6 as char init ":"   no-undo.
     1570   define variable Line   as char              no-undo.
     1571   define variable bar_code as char              no-undo.
     1572   define variable obj-attr as char              no-undo.
     1573   define variable price as char no-undo .
     1574   define variable g#report-num as integer no-undo .
     1575   define variable v-type as character no-undo .
     1576   DEFINE BUFFER buf_gds-obj-attr FOR ub.gds-obj-attr.
