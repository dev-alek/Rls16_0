     1591   sym6 column-label ":" format "x(1)"
     1592   HEADER
     1593   cur-time-print() AT 5 format "X(35)"
     1594   string( "Страница " + string( PAGE-NUMBER( PrnLibStream ) , ">>9") )
     1595   AT 56 format "X(15)" SKIP
     1596   Line format "x(103)" AT 1
     1597   with width 160 down use-text stream-io no-box.
