     2242   buf_goods.gds-name COLUMN-LABEL "Название" format "x(40)"
     2243   price COLUMN-LABEL "Цена продажи" format "x(15)"
     2244   sym5 column-label ":" format "x(1)"
     2245   obj-attr COLUMN-LABEL "Объект" format "x(9)"
     2246   sym6 column-label ":" format "x(1)"
     2247   HEADER
     2248   cur-time-print() AT 5 format "X(35)"
     2249   string( "Страница " + string( PAGE-NUMBER( PrnLibStream ) , ">>9") )
     2250   AT 56 format "X(15)" SKIP
     2251   Line format "x(103)" AT 1
     2252   with width 160 down use-text stream-io no-box.
     2253   DEFINE FRAME List-NAME
     2254   sym1 column-label ":" format "x(1)"
     2255   buf_goods.artic COLUMN-LABEL "Артикул" format "x(16)"
     2256   buf_goods.gds-name COLUMN-LABEL "Название" format "x(40)" space(2)
     2257   buf_scales-gds.PLU-code column-label "PLU" format ">>>9"
     2258   v-type COLUMN-LABEL "Тип" format "x(3)"
     2259   bar_code COLUMN-LABEL "Вес.код" format "x(7)"
     2260   price COLUMN-LABEL "Цена продажи" format "x(15)"
     2261   sym5 column-label ":" format "x(1)"
     2262   obj-attr COLUMN-LABEL "Объект" format "x(9)"
     2263   sym6 column-label ":" format "x(1)"
     2264   HEADER
     2265   cur-time-print() AT 5 format "X(35)"
     2266   string( "Страница " + string( PAGE-NUMBER( PrnLibStream ) , ">>9") )
     2267   AT 56 format "X(15)" SKIP
     2268   Line format "x(103)" AT 1
     2269   with width 160 down use-text stream-io no-box.
     2270   Line = fill( "-" , 103 ) .
     2271   run ref/scprmode.w ( output print-mode ) .
     2272   if print-mode = "отказ" then
     2273       return error .
     2274   run waitfram-show in this-procedure ( input "ЖДИТЕ.  Список подготавливается к печати...").
     2275   run get-report-num  in parParentProc(output g#report-num).
     2276   CASE par-print-option:
     2277     when "scalesman" then do:
     2278       output stream PrnLibStream to value( string( session:temp-directory +
     2279                                           "rpt" + string( g#report-num ) ) )
     2280                                           page-size 24 .
     2281     end.
     2282     when "normal" then dO:
     2283       output stream PrnLibStream to value( string( session:temp-directory +
     2284                                           "rpt" + string( g#report-num ) ) )
     2285                                           page-size 62 .
     2286     end.
     2287   end CASE.
     2288   FORM HEADER
     2289       Line format "x(103)" AT 1 SKIP
     2290       "Продолжение - на следующей странице" AT 10 SKIP
     2291       with FRAME CliBottomFrame width 103 PAGE-BOTTOM use-text stream-io NO-LABELS no-box.
     2292   VIEW stream PrnLibStream FRAME CliBottomFrame .
     2293   PUT stream PrnLibStream
     2294   substitute( "СПИСОК  КОДОВ  на весах N &1 (БД &2) / &3"
     2295              ,locked_scales.scales-num
     2296              ,locked_scales.db-num
     2297              ,locked_scales.scales-name ) format "x(103)" SKIP.
     2298   CASE print-mode :
     2299     when "plu" then do:
     2300       PUT stream PrnLibStream space(4) "( Упорядочен по коду на весах )" SKIP.
     2301       FORM with frame List-PLU .
     2302       FOR EACH buf_scales-gds WHERE
     2303              buf_scales-gds.db-num = locked_scales.db-num AND
     2304              buf_scales-gds.scales-num = locked_scales.scales-num NO-LOCK ,
     2305           FIRST buf_bar-code WHERE
     2306                 buf_bar-code.b-code = buf_scales-gds.b-code NO-LOCK,
     2307           FIRST buf_goods WHERE
     2308                 buf_goods.gds-code = buf_bar-code.gds-code NO-LOCK,
     2309           FIRST buf_gds-obj-attr WHERE
     2310                 buf_gds-obj-attr.gds-code = buf_bar-code.gds-code AND
     2311                 buf_gds-obj-attr.attr-code = 'scales-code':U AND
     2312                 buf_gds-obj-attr.obj-type = buf_scales-gds.obj-type AND
     2313                 buf_gds-obj-attr.obj-code = buf_scales-gds.obj-code
     2314                 NO-LOCK
     2315         BY buf_scales-gds.PLU-code :
     2316           find FIRST buf_prod-bc-db no-lock WHERE
     2317                 buf_prod-bc-db.b-str = buf_gds-obj-attr.attr-value
     2318             and buf_prod-bc-db.db-num = locked_scales.db-num  no-error.
     2319          if not available buf_prod-bc-db then do:
     2320            find first buf_prod-bc no-lock where
     2321                     buf_prod-bc.b-code = buf_bar-code.b-code
     2322                 and buf_prod-bc.b-str = buf_gds-obj-attr.attr-value no-error.
     2323            if not available buf_prod-bc then next.
     2324          end.
