     6062     run waitfram-show in this-procedure ("ЖДИТЕ.  Началось изменение справочника.").
     6063     CASE ChangeOption :
     6064       when "WeightValueList":U then do:
     6065         Wvl:
     6066         DO ON ERROR undo Wvl, return error :
     6067           v-rep-rec = recid (locked_scales).
     6068           FIND FIRST b-scales WHERE recid (b-scales) = v-rep-rec exclusive-lock no-wait no-error.
     6069           if locked(b-scales) then do:
     6070             run waitfram-hide in this-procedure .
     6071             message "В настоящий момент запись весов занята!" view-as alert-box ERROR.
     6072             undo WVL, return error.
     6073           end.
     6074           FOR EACH gds-list,
     6075               FIRST buf_goods WHERE
     6076                     buf_goods.gds-code = gds-list.gds-code NO-LOCK,
     6077               FIRST buf_gds-prt No-LOCK WHERE
     6078                     buf_gds-prt.upper-code = buf_goods.prt-root,
     6079               FIRST buf_bar-code No-LOCK WHERE
     6080                     buf_bar-code.gds-code = buf_goods.gds-code AND
     6081                     buf_bar-code.in-code = "":U and
     6082                     buf_bar-code.part-code = "":U and
     6083                     buf_bar-code.node-code = buf_gds-prt.node-code and
     6084                     buf_bar-code.unit-cli = buf_goods.unit-base,
     6085               FIRST buf_scales-gds WHERE
     6086                     buf_scales-gds.db-num = locked_scales.db-num AND
     6087                     buf_scales-gds.scales-num = locked_scales.scales-num AND
     6088                     buf_scales-gds.b-code = buf_bar-code.b-code
     6089            on error  undo wvl, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     6090            on stop   undo wvl, return error substitute( "&1. stop", vss-workfile )
     6091            on endkey undo wvl, return error substitute( "&1. endkey", vss-workfile )
     6092            :
     6093               ACCUMULATE gds-list.artic ( count ).
     6094               if ( accum count gds-list.artic ) modulo 10 = 0 then
     6095                 run waitfram-show in this-procedure ("Обработано товаров : " +
     6096                                               string ( accum count gds-list.artic ) ) .
     6097               if buf_scales-gds.plu-type <> integer('0':U) then next.
     6098               assign
     6099               buf_scales-gds.to-send = TRUE
     6100               buf_scales-gds.to-del = no
     6101               buf_scales-gds.wt-cart = if from-card then buf_goods.wt-cart else WeightValue .
     6102               b-scales.to-send = yes.
     6103           END .
     6104           release b-scales.
     6105         END .
     6106       end.
     6107       when "DeadValueList":U then do:
     6108         DVL:
     6109         DO ON error undo Dvl, return error :
     6110           v-rep-rec = recid (locked_scales).
     6111           FIND FIRST b-scales WHERE recid (b-scales) = v-rep-rec exclusive-lock no-wait no-error.
     6112           if locked(b-scales) then do:
     6113             run waitfram-hide in this-procedure .
     6114             message "В настоящий момент запись весов занята!" view-as alert-box ERROR.
     6115             undo DVL, return error.
     6116           end.
     6117           FOR EACH gds-list,
     6118             FIRST buf_goods WHERE
     6119                   buf_goods.gds-code = gds-list.gds-code NO-LOCK,
     6120             FIRST buf_gds-prt No-LOCK WHERE
     6121                   buf_gds-prt.upper-code = buf_goods.prt-root,
     6122             FIRST buf_bar-code No-LOCK WHERE
     6123                   buf_bar-code.gds-code = buf_goods.gds-code AND
     6124                   buf_bar-code.in-code = "":U and
     6125                   buf_bar-code.part-code = "":U and
     6126                   buf_bar-code.node-code = buf_gds-prt.node-code and
     6127                   buf_bar-code.unit-cli = buf_goods.unit-base,
     6128             FIRST buf_scales-gds WHERE
     6129                   buf_scales-gds.db-num = locked_scales.db-num AND
     6130                   buf_scales-gds.scales-num = locked_scales.scales-num AND
     6131                   buf_scales-gds.b-code = buf_bar-code.b-code
     6132          on error  undo dvl, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     6133          on stop   undo dvl, return error substitute( "&1. stop", vss-workfile )
     6134          on endkey undo dvl, return error substitute( "&1. endkey", vss-workfile )
     6135          :
     6136             ACCUMULATE gds-list.artic ( count ).
     6137             if ( accum count gds-list.artic ) modulo 10 = 0 then
     6138               run waitfram-show in this-procedure ("Обработано товаров : " +
     6139                                             string ( accum count gds-list.artic ) ) .
     6140             assign
     6141             buf_scales-gds.to-send = TRUE
     6142             buf_scales-gds.to-del = no
     6143             b-scales.to-send = yes
     6144             buf_scales-gds.deadflag = DeadValueRS
     6145             .
     6146             if buf_scales-gds.deadflag = integer('0':U) then do:
     6147               assign
     6148               buf_scales-gds.deadline = if from-card
     6149                                         then buf_goods.deadline
     6150                                         else deadvalue
     6151              .
     6152             end.
     6153             else do:
     6154               assign
     6155               buf_scales-gds.deaddate = if from-parts
     6156                                         then scl-gds-ld-parts-date  ( buffer buf_scales-gds, input sclin-ld )
     6157                                         else scl-gds-ld-to-date  ( input deadvalue)
     6158               .
     6159             end.
     6160         END .
     6161         release b-scales.
     6162       end.
     6163     END .
     6164     when "GDS-LIST":U then  do:
     6165       v-rep-rec = recid (locked_scales).
     6166       _gds-list:
     6167       do transaction:
     6168         FIND FIRST b-scales WHERE recid (b-scales) = v-rep-rec exclusive-lock no-wait no-error.
     6169         if locked(b-scales) then do:
     6170           run waitfram-hide in this-procedure .
     6171           message "В настоящий момент запись весов занята!" view-as alert-box ERROR.
     6172           return error.
     6173         end.
     6174         ves-err = 0.
     6175         _TO-GDS:
     6176         FOR EACH gds-list,
     6177           FIRST buf_goods WHERE
     6178                 buf_goods.gds-code = gds-list.gds-code NO-LOCK,
     6179           FIRST buf_gds-prt No-LOCK WHERE
     6180                 buf_gds-prt.upper-code = buf_goods.prt-root,
     6181           FIRST buf_bar-code No-LOCK WHERE
     6182                 buf_bar-code.gds-code = buf_goods.gds-code AND
     6183                 buf_bar-code.in-code = "":U and
     6184                 buf_bar-code.part-code = "":U and
     6185                 buf_bar-code.node-code = buf_gds-prt.node-code and
     6186                 buf_bar-code.unit-cli = buf_goods.unit-base
     6187         on error  undo _gds-list, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     6188         on stop   undo _gds-list, return error substitute( "&1. stop", vss-workfile )
     6189         on endkey undo _gds-list, return error substitute( "&1. endkey", vss-workfile )
     6190         :
     6191           ACCUMULATE gds-list.artic ( count ).
     6192           if ( accum count gds-list.artic ) modulo 100 = 0 then
     6193           run waitfram-show in this-procedure ("ЖДИТЕ.  Обработано строк списка : " +
     6194                                         string ( accum count gds-list.artic ) ) .
     6195           if can-do( 'у':U, buf_goods.gds-type ) then
     6196             NEXT _To-gds.
     6197           FIND FIRST buf_units WHERE
     6198                     buf_units.unit-name = buf_goods.unit-base NO-LOCK NO-ERROR.
     6199           if buf_goods.unit-base <> b-scales.unit-base
     6200           and lookup('вес':U, buf_units.type) > 0
     6201           then do:
     6202             ves-err = ves-err + 1.
     6203             NEXT _to-gds.
     6204           end.
     6205           if lookup('вес':U, buf_units.type) = 0 then  do:
     6206             if lookup(b-scales.scales-type, 'DIGI-SM,CAS_CL5000J,CAS_CL5000,TIGER-SPCT1,TIGER-SPCT2':U) = 0 then do:
     6207               ves-err = ves-err + 1.
     6208               NEXT _to-gds.
     6209             end.
     6210             if lookup('шту':U, buf_units.type) > 0 then do:
     6211               run trg/ispgwcod.p (input buf_bar-code.b-code
     6212                                 ,input yes
     6213                                 ,input no
     6214                                 ,input yes
     6215                                 ,input ""
     6216                                 ,output is-pgweight
     6217                                 ,output v-on
     6218                                 ,output v-b-str ) no-error.
     6219               if error-status:error
     6220               or not (is-pgweight and v-on) then do:
     6221                 ves-err = ves-err + 1.
     6222                 NEXT _to-gds.
     6223               end.
     6224             end.
     6225             else do:
     6226               ves-err = ves-err + 1.
     6227               NEXT _to-gds.
     6228             end.
     6229           end.
     6230           do on stop undo, retry:
     6231             if retry then do:
     6232               ves-err = ves-err + 1.
     6233               next _TO-GDS.
     6234             end.
     6235             FIND FIRST buf_scales-gds share-lock WHERE
     6236                         buf_scales-gds.scales-num = b-scales.scales-num
     6237                     AND buf_scales-gds.db-num = b-scales.db-num
     6238                     and buf_scales-gds.b-code = buf_bar-code.b-code  NO-ERROR.
     6239             if available buf_scales-gds then do:
     6240               find first save-list where
     6241                         save-list.gds-code = gds-list.gds-code no-error.
     6242               if available save-list then do:
     6243                 save-list.to-del = no.
     6244               end.
     6245               buf_scales-gds.to-del = no.
     6246             end.
     6247             else do:
     6248               if v-skip-next then do:
     6249                 delete gds-list.
     6250               end.
     6251               else do:
     6252         _parts:
     6253               for each buf_gds-obj no-lock where
     6254                   buf_gds-obj.obj-type  = p-obj-type
     6255               and buf_gds-obj.obj-code  = p-obj-code
     6256               and buf_gds-obj.artic     = buf_goods.artic
     6257               and buf_gds-obj.prod-type = buf_goods.prod-type
     6258               and buf_gds-obj.prod-code = buf_goods.prod-code:
     6259               for each buf_parts no-lock where
     6260               buf_parts.artic     = buf_gds-obj.artic
     6261               and buf_parts.prod-type = buf_gds-obj.prod-type
     6262               and buf_parts.prod-code = buf_gds-obj.prod-code
     6263               and buf_parts.out-code  = buf_gds-obj.in-code :
     6264             if v-last-date = ? then next _parts.
     6265             assign
     6266             v-last-date = (if v-last-date = ?
     6267                                             or (v-last-date <> ?
     6268                                                 and sclin-ld = 1
     6269                                                 and v-last-date > buf_parts.last-date)
     6270                                             or (v-last-date <> ?
     6271                                                 and sclin-ld = 2
     6272                                                 and v-last-date < buf_parts.last-date)
     6273                                                 then buf_parts.last-date
     6274                                                 else v-last-date)
     6275             .
     6276           end.
     6277           end.
     6278                 run ref/ves-pbc.p (
     6279                                 input parparentproc
     6280                               , input 'ДОБАВЛЕНИЕ':U
     6281                               , input p-obj-type
     6282                               , input p-obj-code
     6283                               , input (if sclin-ld > 0 then ? else buf_goods.deadline)
     6284                               , input (if sclin-ld > 0 then (v-last-date - 01/01/2000 + 1) * 24 else ?)
     6285                               , input (if sclin-ld > 0 then integer('1':U) else integer('0':U))
     6286                               , input (if from-card then ? else 0)
     6287                               , buffer buf_bar-code
     6288                               , buffer b-scales) no-error.
     6289                 if error-status:error then do:
     6290                   if return-value = "max-gds":U or return-value = "code-range":U then dO:
     6291                     assign
     6292                     v-skip-next = yes
     6293                     ves-err = ves-err + 1.
     6294                     NEXT _to-gds.
     6295                   end.
     6296                   else do:
     6297                                   v-mess =  return-value .
     6298                                   ves-err = ves-err + 1.
     6299                     next _TO-GDS.
     6300                   end.
     6301                 end.
     6302                 else do:
     6303                   delete gds-list.
     6304                 end.
     6305                 if sclin-ld > 0 then do:
     6306                   find first buf2_scales-gds where
     6307                             buf2_scales-gds.scales-num = b-scales.scales-num
     6308                           and buf2_scales-gds.b-code = buf_bar-code.b-code
     6309                           and buf2_scales-gds.db-num = b-scales.db-num no-error.
     6310                   if available buf2_scales-gds then do:
     6311                     buf2_scales-gds.deaddate = scl-gds-ld-parts-date ( buffer buf2_scales-gds, input sclin-ld ).
     6312                   end.
     6313                 end.
     6314               end.
     6315             end.
     6316           end.
     6317         END .
     6318         if ves-err > 0 then do:
     6319           message
     6320           substitute("При добавления товаров на весы №&1 встретилось &2 НЕВЕСОВЫХ товаров&3" +
     6321                       "или товаров, у которых ЕД. ИЗМ. НЕ СОВПАДАЕТ с ЕД. ИЗМ. ВЕСОВ&3" +
     6322                       "или товаров, для которых не удалось создать весовой код&3" +
     6323                       "или товаров, при добавлении которых было превышено количество товаров на весах&3&3" +
     6324                       "или штучных товаров, которые не могут быть добавлены на весы данного типа&3&3" +
     6325                       "                  Эти товары на весы НЕ ДОБАВЛЕНЫ !!!!"
     6326                     ,b-scales.scales-num
     6327                     ,ves-err
     6328                     ,chr(10)
     6329                                     ,v-mess)
     6330           view-as alert-box warning.
     6331         end.
     6332         _scales-gds:
     6333         FOR EACH save-list WHERE
     6334               save-list.to-del = yes,
     6335            FIRST buf_goods WHERE
     6336               buf_goods.gds-code = save-list.gds-code NO-LOCK,
     6337             FIRST buf_gds-prt No-LOCK WHERE
     6338                   buf_gds-prt.upper-code = buf_goods.prt-root,
     6339             FIRST buf_bar-code No-LOCK WHERE
     6340                   buf_bar-code.gds-code = buf_goods.gds-code AND
     6341                   buf_bar-code.in-code = "":U and
     6342                   buf_bar-code.part-code = "":U and
     6343                   buf_bar-code.node-code = buf_gds-prt.node-code and
     6344                   buf_bar-code.unit-cli = buf_goods.unit-base,
     6345             first buf_scales-gds share-lock where
     6346                   buf_scales-gds.db-num = b-scales.db-num
     6347               AND buf_scales-gds.scales-num = b-scales.scales-num
     6348               AND buf_scales-gds.b-code = buf_bar-code.b-code
     6349           on error  undo _gds-list, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     6350           on stop   undo _gds-list, return error substitute( "&1. stop", vss-workfile )
     6351           on endkey undo _gds-list, return error substitute( "&1. endkey", vss-workfile )
     6352           :
     6353           if obj-list and ( buf_scales-gds.obj-type <> p-obj-type or
     6354                             buf_scales-gds.obj-code <> p-obj-code ) then
     6355               NEXT _SCALES-GDS.
     6356           find first gds-list where
     6357                     gds-list.gds-code = save-list.gds-code no-error.
     6358           if not available gds-list then do:
     6359             assign
     6360             buf_scales-gds.to-del = yes
     6361             buf_scales-gds.to-send = no
     6362             .
     6363           end.
     6364         END .
     6365         if b-scales.tot-gds <> 0 then  do:
     6366           FIND LAST buf_scales-gds WHERE
     6367                     buf_scales-gds.db-num = b-scales.db-num AND
     6368                     buf_scales-gds.scales-num = b-scales.scales-num NO-LOCK use-index pi.
     6369           if b-scales.max-plu < buf_scales-gds.PLU-code then
     6370               b-scales.max-plu = buf_scales-gds.PLU-code .
     6371           IF CAN-FIND(FIRST ub.scales-gds where
     6372                           ub.scales-gds.db-num = b-scales.db-num AND
     6373                           ub.scales-gds.scales-num = b-scales.scales-num AND
     6374                           ub.scales-gds.to-send = yes) OR
     6375             CAN-FIND(FIRST ub.scales-gds where
     6376                           ub.scales-gds.db-num = b-scales.db-num AND
     6377                           ub.scales-gds.scales-num = b-scales.scales-num AND
     6378                           ub.scales-gds.to-del = yes)  then do:
     6379             assign
     6380             b-scales.to-send = yes.
     6381           end.
     6382         end.
     6383         else b-scales.to-send = no.
     6384         release b-scales.
     6385       end.
     6386     end.
     6387   END CASE .
     6388   run waitfram-hide in this-procedure .
     6389   RUN OpenBr .
     6390   END PROCEDURE.
     6391   PROCEDURE ChangeOption-proc :
     6392   CASE ChangeOption :
     6393     when "GDS-LIST":U or when "":U then
     6394       HIDE
     6395       DeadValue in frame Dialog-Frame
     6396       WeightValue in FRAME Dialog-Frame
     6397       DeadValueDate in frame Dialog-Frame
     6398       DeadValueRS
     6399       .
     6400     when "WeightValue":U or when "WeightValueList" then  do:
     6401       HIDE
     6402       DeadValue
     6403       DeadValueDAte
     6404       DeadValueRS
     6405       in FRAME Dialog-Frame.
     6406       if available X_scales-gds then assign
     6407       WeightValue = X_scales-gds.wt-cart .
     6408       VIEW WeightValue         in FRAME Dialog-Frame.
     6409       DISPLAY WeightValue with FRAME Dialog-Frame.
     6410       apply "entry" to WeightValue in FRAME Dialog-Frame.
     6411     end.
     6412     when "DEadValue":U or when "DeadValueList" then  do:
     6413       HIDE WeightValue in FRAME Dialog-Frame.
     6414       if available X_scales-gds then
     6415       assign
     6416       DeadValue = scl-gds-ld2(X_scales-gds.deadline, X_scales-gds.deaddate,  X_scales-gds.deadflag).
     6417       VIEW
     6418       DeadValue
     6419       DeadValueDAte
     6420       DeadValueRS
     6421       in FRAME Dialog-Frame.
     6422       APPLY "VALUE-CHANGED" to DEadValueRS.
     6423       DISPLAY
     6424       DeadValue
     6425       (TOday + DeadValue) @ DeadValueDate
     6426       with FRAME Dialog-Frame.
     6427       apply "entry" to DeadValueRS in FRAME Dialog-Frame.
     6428     end.
     6429   END CASE .
     6430   END.
     6431   PROCEDURE DeadValue-Proc :
     6432   define variable  src as recid no-undo.
     6433   define variable  dv as integer no-undo.
     6434   define variable dv-date as date no-undo .
     6435   define variable v-rep-rec as recid no-undo .
     6436   define buffer b-scales for ub.scales.
     6437   if CHangeOption = "DeadValue":U then do:
     6438   if available X_scales-gds then do:
     6439       assign
     6440       v-rep-rec = recid( X_scales-gds )
     6441       src = recid(locked_scales)
     6442       .
     6443       if deadvaluers = integer('1':U) then do:
     6444         dv-date = scl-gds-ld-parts-date ( buffer X_scales-gds, input sclin-ld ).
     6445       end.
     6446       else do:
     6447         dv = X_goods.deadline.
     6448       end.
     6449       DO on stop UNDO, return error :
     6450         FIND FIRST b-scales-gds WHERE recid( b-scales-gds ) = v-rep-rec .
     6451         FIND FIRST b-scales WHERE recid( b-scales ) = src Exclusive-lock no-wait no-error.
     6452         if locked(b-scales) then do:
     6453             run waitfram-hide in this-procedure .
     6454             message
     6455             "В настоящий момент запись весов занята!" view-as alert-box ERROR.
     6456             undo , return no-apply.
     6457         end.
     6458         assign
     6459         b-scales-gds.to-send = TRUE
     6460         b-scales.to-send = TRUE
     6461         b-scales-gds.deadflag = deadvaluers
     6462         .
     6463         if b-scales-gds.deadflag = integer('0':U) then do:
     6464           b-scales-gds.deadline = if from-card
     6465                                   then dv
     6466                                   else deadvalue.
     6467         end.
     6468         else do:
     6469           b-scales-gds.deaddate = scl-gds-ld-to-date (deadvalue).
     6470         end.
     6471       END.
     6472       RUN OpenBr IN THIS-PROCEDURE.
     6473       reposition br-lst to recid v-rep-rec .
     6474   end.
     6475   end.
     6476   else do:
     6477       run b-chg-proc no-error.
     6478   end.
     6479   ChangeOption = "".
     6480   END PROCEDURE.
     6481   PROCEDURE disable_UI :
     6482     HIDE FRAME Dialog-Frame.
     6483   END PROCEDURE.
     6484   PROCEDURE enable_UI :
     6485     DISPLAY a-n-c loc-code loc-name loc-art DeadValueRS WeightValue DeadValue
     6486             DeadValueDate mark-num
     6487         WITH FRAME Dialog-Frame.
     6488     ENABLE b-quit b-sel b-mark b-ticket b-chg PricePrint B-send b-hist b-help
     6489            a-n-c loc-code loc-name loc-art DeadValueRS WeightValue DeadValue
     6490            DeadValueDate br-lst-db br-lst mark-num
     6491         WITH FRAME Dialog-Frame.
     6492     VIEW FRAME Dialog-Frame.
     6493   END PROCEDURE.
     6494   PROCEDURE gds-recid :
     6495   DEFINE variable glog as logical no-undo .
     6496   if available X_goods then do:
     6497     gds-rec = recid(X_goods).
     6498   end.
     6499   else do:
     6500     gds-rec = ?.
     6501   end.
     6502   END PROCEDURE.
     6503   PROCEDURE MyEnable :
     6504   define variable v-ii as integer no-undo .
     6505   define variable v-list-items as character no-undo .
     6506   FIND FIRST locked_scales no-lock WHERE
     6507            locked_scales.db-num = p-db-num
     6508        AND  locked_scales.scales-num = scalenum .
     6509   WeightValue:label IN FRAME Dialog-Frame = substitute("&1(&2)"
     6510                                                         ,WeightValue:label
     6511                                                         ,locked_scales.unit-base ) .
     6512   if db-mode = "self" then do:
     6513     hide
     6514     br-lst-db
     6515     in frame Dialog-Frame .
     6516   end.
     6517   else do:
     6518     hide
     6519     br-lst
     6520     in frame Dialog-Frame .
     6521   end.
     6522   hide
     6523   loc-art in frame Dialog-Frame
     6524   loc-name
     6525   loc-code in frame Dialog-Frame.
     6526   do v-ii = 1 to num-entries ('0,1':U):
     6527     v-list-items = v-list-items  + (if v-ii = 1 then "" else chr(44)) +
     6528                    entry(v-ii, 'Дни,Дата':U) + chr(44) +
     6529                    entry(v-ii, '0,1':U).
     6530   end.
     6531   assign
     6532   deadvaluers:radio-buttons in frame Dialog-Frame = v-list-items.
     6533   assign
     6534   deadvaluers = if sclin-ld > 0
     6535                 then integer('1':U)
     6536                 else integer('0':U)
     6537   .
     6538   HIDE
     6539   mark-num
     6540   DeadValue
     6541   DeadValueDAte
     6542   DeadValueRS
     6543   WeightValue in FRAME Dialog-Frame.
     6544   rid-list = p-rid-list.
     6545   DISABLE
     6546   b-mark WHEN lookup("b-mark", bttns ) = 0
     6547   b-sel WHEN lookup("b-sel", bttns ) = 0
     6548   b-chg WHEN lookup("b-chg", bttns ) = 0 or v-cntxt-db-num <> p-db-num
     6549   b-send WHEN lookup("b-chg", bttns ) = 0 or v-cntxt-db-num <> p-db-num
     6550   b-ticket when v-cntxt-db-num <> p-db-num
     6551   with FRAME Dialog-Frame.
     6552   if db-mode = "self" then do:
     6553     apply "entry" to br-lst in frame Dialog-Frame.
     6554   end.
     6555   else do:
     6556     apply "entry" to br-lst-db in frame Dialog-Frame.
     6557   end.
     6558   if sclin-ld > 0 then do:
     6559     assign
     6560     menu-item m_from-parts:sensitive in menu menu-b-chg = yes
     6561     menu-item m_from-card:label in menu menu-b-chg = "Вес <----из карточки товара"
     6562     .
     6563   end.
     6564   else do:
     6565     assign
     6566     menu-item m_from-parts:sensitive in menu menu-b-chg = no
     6567     menu-item m_from-card:label in menu menu-b-chg = "Вес и С.Г. <----из карточки товара"
     6568     .
     6569   end.
     6570   FRAME Dialog-Frame:title = substitute("&1  N &2 (&3 БД &4)"
     6571                                         , FRAME Dialog-Frame:title
     6572                                         , string( scalenum )
     6573                                         , locked_scales.scales-name
     6574                                         , locked_scales.db-num).
     6575   run OpenBr in this-procedure .
     6576   END PROCEDURE.
     6577   PROCEDURE OpenBr :
     6578   DEFINE variable glog as logical no-undo .
     6579   IF db-mode = "self" THEN DO:
     6580     OPEN QUERY br-lst
     6581       FOR EACH X_scales-gds WHERE
     6582               X_scales-gds.db-num = p-db-num  AND
     6583               X_scales-gds.scales-num = scalenum NO-LOCK,
     6584         FIRST X_bar-code WHERE
     6585               X_bar-code.b-code = X_scales-gds.b-code NO-LOCK,
     6586         FIRST X_goods WHERE
     6587               X_goods.gds-code = X_bar-code.gds-code NO-LOCK,
     6588         FIRST X_gds-obj-attr WHERE
     6589               X_gds-obj-attr.gds-code = X_bar-code.gds-code AND
     6590               X_gds-obj-attr.obj-type = X_scales-gds.obj-type AND
     6591               X_gds-obj-attr.obj-code = X_scales-gds.obj-code AND
     6592               X_gds-obj-attr.attr-code = 'scales-code':U NO-LOCK,
     6593         FIRST X_prod-bc WHERE
     6594               X_prod-bc.b-str = X_gds-obj-attr.attr-value NO-LOCK
     6595         BY X_scales-gds.PLU-code.
     6596       if num-entries( rid-list ) = 0 then
     6597           HIDE mark-num in frame Dialog-Frame.
     6598       else
     6599           DISPLAY num-entries( rid-list ) @ mark-num with frame Dialog-Frame.
     6600       apply "entry" to br-lst in frame Dialog-Frame .
     6601       if num-results( "br-lst" ) > 0 then
     6602           assign
     6603               glog = br-lst:select-row( 1 )
     6604               glog = br-lst:scroll-to-selected-row( 1 ) .
     6605       if rid-list <> '':U then do:
     6606         REPOSITION br-lst to recid integer(entry(1, rid-list)) No-ERROR.
     6607       end.
     6608   END.
     6609   else DO:
     6610       OPEN QUERY br-lst-db
     6611       FOR EACH X_scales-gds WHERE
     6612               X_scales-gds.db-num = p-db-num  AND
     6613               X_scales-gds.scales-num = scalenum NO-LOCK,
     6614         FIRST X_bar-code WHERE
     6615               X_bar-code.b-code = X_scales-gds.b-code NO-LOCK,
     6616         FIRST X_goods WHERE
     6617               X_goods.gds-code = X_bar-code.gds-code NO-LOCK,
     6618         FIRST X_gds-obj-attr WHERE
     6619               X_gds-obj-attr.gds-code = X_bar-code.gds-code AND
     6620               X_gds-obj-attr.obj-type = X_scales-gds.obj-type AND
     6621               X_gds-obj-attr.obj-code = X_scales-gds.obj-code AND
     6622               X_gds-obj-attr.attr-code = 'scales-code':U NO-LOCK,
     6623         FIRST X_prod-bc-db NO-LOCK WHERE
     6624               X_prod-bc-db.b-str = X_gds-obj-attr.attr-value
     6625           AND X_prod-bc-db.db-num = p-db-num OUTER-JOIN
     6626         BY X_scales-gds.PLU-code.
     6627       if num-entries( rid-list ) = 0 then
     6628           HIDE mark-num in frame Dialog-Frame.
     6629       else
     6630           DISPLAY num-entries( rid-list ) @ mark-num with frame Dialog-Frame.
     6631       apply "entry" to br-lst-db in frame Dialog-Frame .
     6632       if num-results( "br-lst-db" ) > 0 then
     6633           assign
     6634               glog = br-lst-db:select-row( 1 )
     6635               glog = br-lst-db:scroll-to-selected-row( 1 ) .
     6636       if rid-list <> '':U then do:
     6637         REPOSITION br-lst-db to recid integer(entry(1, rid-list)) No-ERROR.
     6638       end.
     6639   END.
     6640   END PROCEDURE.
     6641   PROCEDURE reposition-goods :
     6642   define input  parameter p-direction   as character no-undo .
     6643   define output parameter p-recid as recid no-undo .
     6644   case db-mode:
     6645     when "self" then do:
     6646       case p-direction :
     6647         when "first":U
     6648         then do:
     6649           get first br-lst.
     6650         end.
     6651         when "last":U
     6652         then do:
     6653           get last br-lst.
     6654         end.
     6655         when "prev":U
     6656         then do:
     6657           get prev br-lst.
     6658           if not available X_scales-gds then do:
     6659             message
     6660             "Это первый товар списка"
     6661             view-as alert-box.
     6662           end.
     6663         end.
     6664         when "next":U
     6665         then do:
     6666           get next br-lst.
     6667           if not available X_scales-gds then do:
     6668             message
     6669             "Это последний товар списка"
     6670             view-as alert-box.
     6671           end.
     6672         end.
     6673       end case .
     6674     end.
     6675     otherwise  do:
     6676       case p-direction :
     6677         when "first":U
     6678         then do:
     6679           get first br-lst-db.
     6680         end.
     6681         when "last":U
     6682         then do:
     6683           get last br-lst-db.
     6684         end.
     6685         when "prev":U
     6686         then do:
     6687           get prev br-lst-db.
     6688           if not available X_scales-gds then do:
     6689             message
     6690             "Это первый товар списка"
     6691             view-as alert-box.
     6692           end.
     6693         end.
     6694         when "next":U
     6695         then do:
     6696           get next br-lst-db.
     6697           if not available X_scales-gds then do:
     6698             message
     6699             "Это последний товар списка"
     6700             view-as alert-box.
     6701           end.
     6702         end.
     6703       end case .
     6704     end.
     6705   end case.
     6706   assign
     6707   p-recid = recid(X_goods)
     6708   .
     6709   if db-mode = "self" then do:
     6710     run reposition-query in this-procedure
     6711       (input recid(X_scales-gds)
     6712       ).
     6713   end.
     6714   else do:
     6715     run reposition-query-db in this-procedure
     6716       (input recid(X_scales-gds)
     6717       ).
     6718   end.
     6719   END PROCEDURE.
     6720   PROCEDURE reposition-query :
     6721   define input parameter p-recid as recid no-undo .
     6722   if p-recid <> ?
     6723   then do:
     6724     reposition br-lst to recid p-recid no-error.
     6725   end.
     6726   do with frame Dialog-Frame:
     6727     apply "entry":u to browse br-lst .
     6728     apply "VALUE-CHANGED":u to browse br-lst .
     6729   end.
     6730   END PROCEDURE.
     6731   PROCEDURE reposition-query-db :
     6732   define input parameter p-recid as recid no-undo .
     6733   if p-recid <> ?
     6734   then do:
     6735     reposition br-lst-db to recid p-recid no-error.
     6736   end.
     6737   do with frame Dialog-Frame:
     6738     apply "entry":u to browse br-lst .
     6739     apply "VALUE-CHANGED":u to browse br-lst .
     6740   end.
     6741   END PROCEDURE.
     6742   PROCEDURE WeightValue-proc :
     6743   define variable  src as recid no-undo.
     6744   define variable  wv as decimal no-undo.
     6745   define variable v-rep-rec as recid no-undo .
     6746   define buffer b-scales for ub.scales.
     6747   if CHangeOption = "WeightValue":U then do:
     6748     if available X_scales-gds then do:
     6749       if X_scales-gds.plu-type <> integer('0':U) then do:
     6750         bell.
     6751         message
     6752         "Нельзя установить вес тары для PLU этого типа"
     6753         view-as alert-box error  .
     6754         undo, return error .
     6755       end.
     6756       assign
     6757       v-rep-rec = recid( X_scales-gds )
     6758       src = recid(locked_scales)
     6759       wv = X_goods.wt-cart
     6760       .
     6761       DO on stop UNDO, return error :
     6762           FIND FIRST b-scales-gds WHERE recid( b-scales-gds ) = v-rep-rec .
     6763           FIND FIRST b-scales WHERE recid( b-scales ) = src Exclusive-lock No-WAit No-ERROR.
     6764           if locked(b-scales) then do:
     6765               run waitfram-hide in this-procedure .
     6766               message
     6767               "В настоящий момент запись весов занята!" view-as alert-box ERROR.
     6768               undo , return no-apply.
     6769           end.
     6770           if b-scales-gds.plu-type <> integer('0':U) then next.
     6771           assign
     6772               b-scales-gds.to-send = TRUE
     6773               b-scales-gds.wt-cart = IF from-card then wv else WeightValue
     6774               locked_scales.to-send = TRUE .
     6775       END.
     6776       RUN OpenBr IN THIS-PROCEDURE .
     6777       reposition br-lst to recid v-rep-rec .
     6778     end.
     6779   end.
     6780   else do:
     6781               run b-chg-proc no-error.
     6782   end.
     6783     ChangeOption = "".
     6784   END PROCEDURE.
     6785   FUNCTION get-scl-code RETURNS CHARACTER
     6786      (    INPUT p-b-code AS INTEGER
     6787        , INPUT p-b-str AS CHARACTER
     6788        , BUFFER buf_prod-bc-db FOR ub.prod-bc-db ) :
     6789   DEFINE BUFFER buf_prod-bc FOR ub.prod-bc.
     6790   IF AVAILABLE buf_prod-bc-db  THEN RETURN buf_prod-bc-db.b-str.
     6791   FIND FIRST buf_prod-bc NO-LOCK WHERE buf_prod-bc.b-code = p-b-code AND buf_prod-bc.b-str = p-b-str NO-ERROR.
     6792   IF AVAILABLE buf_prod-bc  THEN RETURN p-b-str.
     6793   RETURN chr(63).
     6794   END FUNCTION.
