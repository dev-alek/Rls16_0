      570   mFramBachModHandle = frame waitfram:handle.
      571   define variable mFameOldVis as logical no-undo.
      572   define variable mVisCUrentVin as logical no-undo.
      573   if session:batch-mode
      574   then
      575      mBatchMode = yes.
      576   if mBatchMode = ? then do:
      577     mVisCUrentVin = current-window:visible.
      578     mFameOldVis = mFramBachModHandle:visible.
      579     mFramBachModHandle:visible  = yes.
      580     mBatchMode = mFramBachModHandle:visible ne yes.
      581     mFramBachModHandle:visible = mFameOldVis.
      582     current-window:visible = mVisCUrentVin.
      583   end.
      584    if  log-manager:logfile-name ne ?
      585     then DO:
      586         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      587         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      588         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      589     end.
      590   on choose of B-WaitFramStop in frame waitfram
      591   do:
      592     mWaitFramStop = yes.
      593     mWaitFramStopUser = yes.
      594   end.
      595   function waitfram-check-timeout returns logical():
      596      define variable vtime as int64 no-undo.
      597      if mWaitFramStopTimeOut
      598      then
      599         return yes.
      600      vtime = ( now - mWaitFramStartProc ) / 1000 .
      601      if     mWaitFramTimeOut ne ?
      602         and mWaitFramTimeOut ne 0
      603         and mWaitFramTimeOut lt vtime
      604      then do:
      605         mWaitFramStopTimeOut = yes.
      606      end.
      607      return mWaitFramStopTimeOut.
      608   end.
      609   procedure waitfram-hide :
      610     if not session:batch-mode
      611     then do
      612     on error undo, return error return-value
      613     :
      614       pause 0 before-hide .
      615       if not mBatchMode then
      616         hide frame waitfram .
      617     if     not mWaitFramView
      618        and mWaitProcEvent
      619     then
      620       process events .
      621     end.
      622   end procedure.
      623   procedure waitfram-show :
      624     define input  parameter p-message as character no-undo .
      625     define variable v-left-margin as integer   no-undo .
      626     if not session:batch-mode
      627     then do
      628     on error undo, return error return-value
      629     :
      630       if length(p-message) <= 70 then do:
      631         assign
      632           v-left-margin = integer((70 - length(p-message)) / 2)
      633         .
      634         assign
      635           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      636         .
      637         assign
      638           v-waitfram-action01 = " "
      639           v-waitfram-action02 = " "
      640                                    + fill(" ", v-left-margin)
      641                                    + p-message
      642           v-waitfram-action03 = " "
      643         .
      644       end.
      645       else do:
      646         define variable vRindex1 as integer no-undo.
      647         define variable vRindex2 as integer no-undo.
      648         vRindex1 = r-index(p-message," ",70).
      649         if vRindex1 = 0
      650         then
      651            vRindex1 = 70.
      652         if length(p-message)  <= vRindex1 + 70 then do:
      653           assign
      654             v-waitfram-action01 = " "
      655             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      656             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      657           .
      658         end.
      659         else do:
      660           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      661           if vRindex2 <= vRindex1
      662           then
      663              vRindex2 = vRindex1 + 70.
      664           assign
      665             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      666             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      667             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      668           .
      669         end.
      670       end.
      671       B-viewProcInfo:visible   in frame waitfram = no.
      672       B-viewProcInfo:sensitive in frame waitfram = no.
      673       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      674       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      675       if  (   mWaitFramView
      676          or  mWaitProcEvent)
      677          and not mBatchMode
      678       then
      679          display
      680             v-waitfram-action01 skip
      681             v-waitfram-action02 skip
      682             v-waitfram-action03 skip
      683          with frame waitfram .
      684       if     mWaitFramView
      685          then do:
      686             if     mWaitFramInterval ne ?
      687                and not mBatchMode
      688             then
      689                wait-for go of frame waitfram pause mWaitFramInterval.
      690          end.
      691          else
      692             if     mWaitProcEvent
      693                and not mBatchMode
      694             then
      695                process events .
      696     end.
      697   end procedure.
      698      procedure waitfram-show-this:
      699         define input  parameter iInterval as int64 no-undo.
      700         define variable vtime as int64 no-undo.
      701         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      702         mWaitFramInterval = iInterval.
      703         run waitfram-show (substitute("&1&2 &3&4" ,
      704                                       mWaitFramTextBeg ,
      705                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      706                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      707                                       mWaitFramTextEnd
      708                                      )
      709                           ).
      710      end.
      711      procedure WaitFramRunPause:
      712         define input  parameter iInterval as dec no-undo.
      713         define variable vStart  as datetime-tz no-undo.
      714         define variable vend    as datetime-tz no-undo.
      715         define variable vint as int64 no-undo.
      716         define variable vOk as logical no-undo.
      717         vStart = now.
      718         vend   = vStart.
      719         publish "WaitFramPause" (iInterval,output vOk).
      720         vend   =  now.
      721         vint = vend - vStart.
      722         vint = iInterval - vint / 1000.
      723         if     not mWaitFramStop
      724            and (   vint > 0
      725                 or (    not vOk
      726                     and iInterval eq ?
      727                     )
      728                 )
      729         then
      730            run waitfram-show-this (iInterval).
      731         vend   =  now.
      732         vint = vend - vStart.
      733         vint = iInterval - vint / 1000.
      734         if     not mWaitFramStop
      735            and vint > 0
      736         then do:
      737            run gbl/pause.p (vint * 1000).
      738         end.
      739         if iInterval ne ?
      740         then
      741            publish "WaitFramStop".
      742         waitfram-check-timeout().
      743      end.
      744      procedure WaitFramWaitFor:
      745         define input  parameter iInterval as dec no-undo.
      746         assign
      747            mWaitFramStartProc   = now
      748            mWaitFramStopUser    = no
      749            mWaitFramStopTimeOut = no
      750         .
      751         block-wait:
      752         do while not mWaitFramStop:
      753            run WaitFramRunPause (iInterval).
      754            if  waitfram-check-timeout()
      755            then do:
      756               leave block-wait.
      757            end.
      758         end.
      759         run waitfram-hide.
      760      end.
      761   procedure waitfram-join :
      762     define input  parameter p-line-1  as character no-undo .
      763     define input  parameter p-line-2  as character no-undo .
      764     define input  parameter p-line-3  as character no-undo .
      765     define output parameter p-message as character no-undo .
      766     do
      767     on error undo, return error return-value
      768     :
      769       assign
      770         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      771                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      772                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      773       .
      774     end.
      775   end procedure.
      776   function waitfram-join-function returns character
      777     (input p-line-1 as character
      778     ,input p-line-2 as character
      779     ,input p-line-3 as character
      780     ).
      781     define variable v-message as character no-undo .
      782     run waitfram-join in this-procedure
      783       (input  p-line-1
      784       ,input  p-line-2
      785       ,input  p-line-3
      786       ,output v-message
      787       ) .
      788     return v-message .
      789   end function .
