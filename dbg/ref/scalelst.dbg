     1212     ,input  gp-b-code
     1213     ,input  0
     1214     ,input  gp-fact-order
     1215     ,output gp-doc-num
     1216     ,output gp-price-sale-parts
     1217     ,output gp-road-tax
     1218     ,output gp-excise
     1219     ) no-error .
     1220   if error-status:error then do:
     1221     return ?.
