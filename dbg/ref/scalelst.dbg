     1618   buf_goods.gds-name COLUMN-LABEL "Название" format "x(40)" space(2)
     1619   buf_scales-gds.PLU-code column-label "PLU" format ">>>9"
     1620   v-type COLUMN-LABEL "Тип" format "x(3)"
     1621   bar_code COLUMN-LABEL "Вес.код" format "x(7)"
     1622   price COLUMN-LABEL "Цена продажи" format "x(15)"
     1623   sym5 column-label ":" format "x(1)"
     1624   obj-attr COLUMN-LABEL "Объект" format "x(9)"
     1625   sym6 column-label ":" format "x(1)"
     1626   HEADER
     1627   cur-time-print() AT 5 format "X(35)"
