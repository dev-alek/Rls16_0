     2222   v-type COLUMN-LABEL "Тип" format "x(3)"
     2223   bar_code COLUMN-LABEL "Вес.код" format "x(7)" space(2)
     2224   buf_goods.artic COLUMN-LABEL "Артикул" format "x(16)"
     2225   buf_goods.gds-name COLUMN-LABEL "Название" format "x(40)"
     2226   price COLUMN-LABEL "Цена продажи" format "x(15)"
     2227   sym5 column-label ":" format "x(1)"
     2228   obj-attr COLUMN-LABEL "Объект" format "x(9)"
     2229   sym6 column-label ":" format "x(1)"
