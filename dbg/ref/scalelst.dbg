      130   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      131   procedure cur-time :
      132      define output parameter p-today as date      no-undo .
      133      define output parameter p-time  as integer   no-undo .
      134     do
      135     on error undo, return error
      136     :
      137       define variable v-date1 as date      no-undo .
      138       define variable v-date2 as date      no-undo .
      139       define variable v-time  as integer   no-undo .
      140       assign
      141         v-date1 = today
      142         v-time  = time
      143         v-date2 = today
      144       .
      145       if v-date1 <> v-date2
      146       then do:
      147         assign
      148           v-date1 = today
      149           v-time  = v-time
      150         .
      151       end.
      152       assign
      153         p-today = v-date1
      154         p-time  = v-time
      155       .
      156     end.
      157   end.
      158   function cur-time-date returns character
      159   :
      160     return string(today, '99/99/9999':U) .
      161   end.
      162   function cur-time-mjd returns decimal
      163   :
      164     define variable v-date as date      no-undo .
      165     define variable v-time as integer   no-undo .
      166     run cur-time in this-procedure
      167       (output v-date
      168       ,output v-time
      169       ) .
      170     return integer(v-date) - 2400002 + (v-time / 86400) .
      171   end.
      172   function cur-time-get-ending-index returns integer
      173   (input p-number as integer
      174   )
      175   :
      176     if p-number < 0
      177     or p-number = ?
      178     then do:
      179       return 1 .
      180     end.
      181     define variable v-rest as integer   no-undo .
      182     assign
      183       p-number = p-number modulo 100
      184     .
      185     if p-number < 20
      186     then do:
      187       assign
      188         v-rest = p-number
      189       .
      190     end.
      191     else do:
      192       assign
      193         v-rest = p-number modulo 10
      194       .
      195     end.
      196     case v-rest :
      197       when 1
      198       then do:
      199         return 2 .
      200       end.
      201       when 2 or
      202       when 3 or
      203       when 4
      204       then do:
      205         return 3 .
      206       end.
      207       otherwise do:
      208         return 1 .
      209       end.
      210     end case .
      211   end.
      212   procedure cur-time-mjd-to-date :
      213      define input  parameter i-mjd-diff as decimal no-undo.
      214      define output parameter o-Date     as date    no-undo.
      215      define output parameter o-Time     as integer no-undo.
      216      define variable v-day-number as integer   no-undo .
      217      if    i-mjd-diff < 0
      218         or i-mjd-diff = ?
      219      then do:
      220         return "?" .
      221      end.
      222      assign
      223         v-day-number = truncate(i-mjd-diff,0).
      224         o-Date = date(v-day-number + 2400002).
      225         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      226     .
      227   end.
      228   function cur-time-mjd-to-string returns character
      229   (input p-mjd-diff as decimal
      230   )
      231   :
      232     define variable v-day-number as integer   no-undo .
      233     define variable v-seconds    as integer   no-undo .
      234     define variable v-hour       as integer   no-undo .
      235     define variable v-min        as integer   no-undo .
      236     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      237     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      238     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      239     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      240     if p-mjd-diff < 0
      241     or p-mjd-diff = ?
      242     then do:
      243       return "?" .
      244     end.
      245     assign
      246       v-day-number = integer(truncate(p-mjd-diff,0))
      247       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      248     .
      249     if v-seconds > 86400
      250     then do:
      251       assign
      252         v-seconds = 86400 - 1
      253       .
      254     end.
      255     if v-seconds < 0
      256     then do:
      257       assign
      258         v-seconds = 0
      259       .
      260     end.
      261     assign
      262       v-hour = truncate(v-seconds / 3600, 0)
      263     .
      264     assign
      265       v-seconds = v-seconds modulo 3600
      266     .
      267     assign
      268       v-min = truncate(v-seconds / 60, 0)
      269     .
      270     assign
      271       v-seconds = v-seconds modulo 60
      272     .
      273     return
      274         (if v-day-number <> 0
      275           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      276           else ""
      277         )
      278       + (if v-day-number <> 0 or v-hour <> 0
      279           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      280           else ""
      281         )
      282       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      283           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      284           else ""
      285         )
      286       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      287       .
      288   end.
      289   function cur-time-string returns character
      290   :
      291     define variable v-date as date      no-undo .
      292     define variable v-time as integer   no-undo .
      293     run cur-time in this-procedure
      294       (output v-date
      295       ,output v-time
      296       ) .
      297     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      298   end.
      299   function cur-time-string-sec returns character
      300   :
      301     define variable v-date as date      no-undo .
      302     define variable v-time as integer   no-undo .
      303     run cur-time in this-procedure
      304       (output v-date
      305       ,output v-time
      306       ) .
      307     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      308   end.
      309   function cur-time-custom  returns character
      310   (input p-prefix as character
      311   ,input p-date-format as character
      312   ,input p-delimiter as character
      313   ,input p-time-format as character
      314   ,input p-suffix as character
      315   )
      316   :
      317     define variable v-date as date      no-undo .
      318     define variable v-time as integer   no-undo .
      319     run cur-time in this-procedure
      320       (output v-date
      321       ,output v-time
      322       ) .
      323     return
      324       p-prefix
      325       + string(v-date, p-date-format)
      326       + p-delimiter
      327       + string(v-time, p-time-format)
      328       + p-suffix
      329       .
      330   end.
      331   function cur-time-print  returns character
      332   :
      333     define variable v-date as date      no-undo .
      334     define variable v-time as integer   no-undo .
      335     run cur-time in this-procedure
      336       (output v-date
      337       ,output v-time
      338       ) .
      339     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      340   end.
      341   function cur-time-datetime returns datetime
      342   :
      343     define variable v-char as character no-undo .
      344     define variable v-datetime as datetime no-undo .
      345     v-char = cur-time-string().
      346     v-datetime = datetime(v-char).
      347     return  v-datetime.
      348   end.
      349   function cur-time-string-msec returns character
      350   :
      351     define variable v-date as datetime  no-undo .
      352     v-date = now.
      353     return string(v-date) .
      354   end.
