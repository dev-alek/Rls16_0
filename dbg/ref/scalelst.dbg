     1629   AT 56 format "X(15)" SKIP
     1630   Line format "x(103)" AT 1
     1631   with width 160 down use-text stream-io no-box.
     1632   Line = fill( "-" , 103 ) .
     1633   run ref/scprmode.w ( output print-mode ) .
     1634   if print-mode = "отказ" then
     1635       return error .
     1636   run waitfram-show in this-procedure ( input "ЖДИТЕ.  Список подготавливается к печати...").
     1637   run get-report-num  in parParentProc(output g#report-num).
     1638   CASE par-print-option:
     1639     when "scalesman" then do:
     1640       output stream PrnLibStream to value( string( session:temp-directory +
     1641                                           "rpt" + string( g#report-num ) ) )
     1642                                           page-size 24 .
     1643     end.
     1644     when "normal" then dO:
     1645       output stream PrnLibStream to value( string( session:temp-directory +
     1646                                           "rpt" + string( g#report-num ) ) )
     1647                                           page-size 62 .
     1648     end.
     1649   end CASE.
     1650   FORM HEADER
     1651       Line format "x(103)" AT 1 SKIP
     1652       "Продолжение - на следующей странице" AT 10 SKIP
     1653       with FRAME CliBottomFrame width 103 PAGE-BOTTOM use-text stream-io NO-LABELS no-box.
     1654   VIEW stream PrnLibStream FRAME CliBottomFrame .
     1655   PUT stream PrnLibStream
     1656   substitute( "СПИСОК  КОДОВ  на весах N &1 (БД &2) / &3"
     1657              ,locked_scales.scales-num
     1658              ,locked_scales.db-num
     1659              ,locked_scales.scales-name ) format "x(103)" SKIP.
     1660   CASE print-mode :
     1661     when "plu" then do:
     1662       PUT stream PrnLibStream space(4) "( Упорядочен по коду на весах )" SKIP.
     1663       FORM with frame List-PLU .
     1664       FOR EACH buf_scales-gds WHERE
     1665              buf_scales-gds.db-num = locked_scales.db-num AND
     1666              buf_scales-gds.scales-num = locked_scales.scales-num NO-LOCK ,
     1667           FIRST buf_bar-code WHERE
     1668                 buf_bar-code.b-code = buf_scales-gds.b-code NO-LOCK,
     1669           FIRST buf_goods WHERE
     1670                 buf_goods.gds-code = buf_bar-code.gds-code NO-LOCK,
     1671           FIRST buf_gds-obj-attr WHERE
     1672                 buf_gds-obj-attr.gds-code = buf_bar-code.gds-code AND
     1673                 buf_gds-obj-attr.attr-code = 'scales-code':U AND
     1674                 buf_gds-obj-attr.obj-type = buf_scales-gds.obj-type AND
     1675                 buf_gds-obj-attr.obj-code = buf_scales-gds.obj-code
     1676                 NO-LOCK
     1677           , FIRST buf_prod-bc no-lock WHERE
     1678                 buf_prod-bc.b-str = buf_gds-obj-attr.attr-value
     1679           BY buf_scales-gds.PLU-code :
     1680   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1681   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1682   gp-fact-order = 0 .
