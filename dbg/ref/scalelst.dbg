     2869   FUNCTION get-scl-code RETURNS CHARACTER
     2870      (    INPUT p-b-code AS INTEGER
     2871        , INPUT p-b-str AS CHARACTER
     2872        , BUFFER buf_prod-bc-db FOR ub.prod-bc-db )  FORWARD.
     2873   DEFINE MENU MENU-b-chg
     2874          MENU-ITEM m_gds-list     LABEL "Список товаров"
     2875          MENU-ITEM m_WeightValue  LABEL "Вес упаковки товара"
     2876          MENU-ITEM m_WeightValueList LABEL "Вес упаковки списком"
     2877          MENU-ITEM m_DeadValue    LABEL "Срок годности товара"
     2878          MENU-ITEM m_DeadValueList LABEL "Срок годности списком"
     2879          RULE
     2880          MENU-ITEM m_from-card    LABEL "Из карточки товара"
     2881                 TOGGLE-BOX
     2882          MENU-ITEM m_from-parts   LABEL "С.Г. <---из последнего прихода"
     2883                 TOGGLE-BOX.
     2884   DEFINE MENU MENU-b-price
     2885          MENU-ITEM m_scalesman    LABEL "Для весовщика"
     2886          MENU-ITEM m_normal       LABEL "Обычный"       .
     2887   DEFINE MENU MENU-B-send
     2888          MENU-ITEM m_send_all     LABEL "Все"
     2889          MENU-ITEM m_send_changed LABEL "Измененные"
     2890          MENU-ITEM m_send_current LABEL "Текущий товар"
     2891          RULE
     2892          MENU-ITEM m_send_resend  LABEL "Повторно"      .
     2893   DEFINE BUTTON b-chg
     2894        LABEL "&Изменить"
     2895        SIZE 10 BY 1
     2896        BGCOLOR 8 .
     2897   DEFINE BUTTON b-help
     2898        LABEL "Помо&щь"
     2899        SIZE 3 BY 1
     2900        BGCOLOR 8 .
     2901   DEFINE BUTTON b-hist
     2902        LABEL "Ис&тория"
     2903        SIZE 3 BY 1.
     2904   DEFINE BUTTON b-mark
     2905        LABEL "&*"
     2906        SIZE 3 BY 1.
     2907   DEFINE BUTTON b-quit AUTO-GO
     2908        LABEL "&Выход "
     2909        SIZE 10 BY 1
     2910        BGCOLOR 8 .
     2911   DEFINE BUTTON b-sel AUTO-GO
     2912        LABEL "Вы&бор "
     2913        SIZE 10 BY 1.
     2914   DEFINE BUTTON B-send
     2915        LABEL "Пере&слать"
     2916        SIZE 10 BY 1.
     2917   DEFINE BUTTON b-ticket
     2918        LABEL "&Ценники"
     2919        SIZE 10 BY 1.
     2920   DEFINE BUTTON PricePrint
     2921        LABEL "Пра&йслист"
     2922        SIZE 10 BY 1.
     2923   DEFINE VARIABLE DeadValue AS INTEGER FORMAT ">>>>>9":U INITIAL 30
     2924        LABEL "Срок(дней)"
     2925        VIEW-AS FILL-IN
     2926        SIZE 7.3 BY 1
     2927        BGCOLOR 15 FGCOLOR 0  NO-UNDO.
     2928   DEFINE VARIABLE DeadValueDate AS DATE FORMAT "99/99/9999":U
     2929        LABEL "Срок(до)"
     2930        VIEW-AS FILL-IN
     2931        SIZE 13.8 BY 1
     2932        BGCOLOR 15 FGCOLOR 0  NO-UNDO.
     2933   DEFINE VARIABLE loc-art AS CHARACTER FORMAT "x(16)"
     2934        LABEL "Начало артикула"
     2935        VIEW-AS FILL-IN
     2936        SIZE 20 BY 1
     2937        FGCOLOR 12  NO-UNDO.
     2938   DEFINE VARIABLE loc-code AS CHARACTER FORMAT "x(13)"
     2939        LABEL "Бар-код (весь)"
     2940        VIEW-AS FILL-IN
     2941        SIZE 20 BY 1
     2942        FGCOLOR 12  NO-UNDO.
     2943   DEFINE VARIABLE loc-name AS CHARACTER FORMAT "x(40)"
     2944        LABEL "Начало названия"
     2945        VIEW-AS FILL-IN
     2946        SIZE 20 BY 1
     2947        FGCOLOR 12  NO-UNDO.
