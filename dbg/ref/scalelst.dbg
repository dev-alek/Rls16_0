     2949         VIEW-AS TEXT
     2950        SIZE 4.8 BY 1
     2951        FGCOLOR 10  NO-UNDO.
     2952   DEFINE VARIABLE WeightValue AS DECIMAL FORMAT "->>>>9.999":U INITIAL 30
     2953        LABEL "Вес"
     2954        VIEW-AS FILL-IN
     2955        SIZE 12 BY 1
     2956        BGCOLOR 15 FGCOLOR 0  NO-UNDO.
     2957   DEFINE VARIABLE a-n-c AS CHARACTER
