     1758                 buf_scales-gds.db-num = locked_scales.db-num AND
     1759                 buf_scales-gds.scales-num = locked_scales.scales-num NO-LOCK ,
     1760           FIRST buf_bar-code WHERE
     1761                 buf_bar-code.b-code = buf_scales-gds.b-code NO-LOCK,
     1762           FIRST buf_goods WHERE
     1763                 buf_goods.gds-code = buf_bar-code.gds-code NO-LOCK,
     1764           FIRST buf_gds-obj-attr WHERE
     1765                 buf_gds-obj-attr.gds-code = buf_bar-code.gds-code AND
     1766                 buf_gds-obj-attr.attr-code = 'scales-code':U AND
     1767                 buf_gds-obj-attr.obj-type = buf_scales-gds.obj-type AND
     1768                 buf_gds-obj-attr.obj-code = buf_scales-gds.obj-code
     1769                 NO-LOCK
     1770         , FIRST buf_prod-bc no-lock WHERE
     1771                 buf_prod-bc.b-str = buf_gds-obj-attr.attr-value
     1772            BY buf_prod-bc.b-str :
