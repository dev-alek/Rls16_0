     1610   cur-time-print() AT 5 format "X(35)"
     1611   string( "Страница " + string( PAGE-NUMBER( PrnLibStream ) , ">>9") )
     1612   AT 56 format "X(15)" SKIP
     1613   Line format "x(103)" AT 1
