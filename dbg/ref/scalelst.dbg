     4304             cur-clmn-numbr-lst-db[varmvibr-lst-db] = cur-clmn-numbr-lst-db[varmvibr-lst-db] + 1.
     4305           END.
     4306       END.
     4307     END.
     4308     ELSE
     4309     DO varmvjbr-lst-db = source-column + 1 to target-column:
     4310       DO varmvibr-lst-db = 1 TO EXTENT(cur-clmn-numbr-lst-db):
     4311         if cur-clmn-numbr-lst-db[varmvibr-lst-db] = varmvjbr-lst-db THEN DO:
     4312           cur-clmn-numbr-lst-db[varmvibr-lst-db] = cur-clmn-numbr-lst-db[varmvibr-lst-db] - 1.
     4313         END.
     4314       END.
     4315     END.
     4316     DO varmvibr-lst-db = 1 TO EXTENT(cur-clmn-numbr-lst-db):
     4317       if cur-clmn-numbr-lst-db[varmvibr-lst-db] = -1 THEN cur-clmn-numbr-lst-db[varmvibr-lst-db] = target-column.
     4318     END.
     4319   END PROCEDURE.
     4320   PROCEDURE ch-clmnbr-lst-db:
     4321     DEFINE INPUT PARAMETER cur-clmn-loc as INTEGER NO-UNDO.
     4322     if cur-clmn-loc <= 3 then do:
     4323       return .
     4324     end.
     4325     DO varmvibr-lst-db = 1 TO EXTENT(cur-clmn-numbr-lst-db):
     4326       if cur-clmn-numbr-lst-db[varmvibr-lst-db] = cur-clmn-loc THEN move-elementbr-lst-db = varmvibr-lst-db.
     4327     END.
     4328     RUN re-move-clmnbr-lst-db (cur-clmn-loc, 3).
     4329   END PROCEDURE.
     4330   PROCEDURE mv-brw-defaultbr-lst-db:
     4331   def var old-session as logical no-undo.
     4332     old-session = SESSION:IMMEDIATE-DISPLAY.
     4333     IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     4334     do varmvlbr-lst-db = 3 to EXTENT(cur-clmn-numbr-lst-db):
     4335       RUN re-move-clmnbr-lst-db (cur-clmn-numbr-lst-db[varmvlbr-lst-db], varmvlbr-lst-db).
     4336     END.
     4337     RUN start-mv-clmnbr-lst-db.
     4338     SESSION:IMMEDIATE-DISPLAY = old-session.
     4339   END PROCEDURE.
     4340   .
     4341   define variable vss-include-info68 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4342   on help of frame Dialog-Frame
     4343   do:
     4344     run gbl/app_help.p
     4345       (input this-procedure :file-name
     4346       ,input ''
     4347       ,input ?
     4348       ) no-error.
     4349     if error-status :error then do:
     4350       message
     4351         "Ошибка при вызове помощи"
     4352         error-status :get-message(1)
     4353         view-as alert-box .
     4354     end.
     4355   end.
     4356   run minbtn-set in this-procedure .
     4357   on choose of b-help in frame Dialog-Frame
     4358   do:
     4359     apply "help":u to frame Dialog-Frame .
     4360   end.
     4361   define variable vss-include-info69 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4362   procedure minbtn-set :
     4363       do
     4364           on error undo, return error return-value
     4365           :
     4366           define variable ii              as integer       no-undo .
     4367           define variable fh              as widget-handle no-undo .
     4368           define variable hh              as widget-handle no-undo .
     4369           define variable v-h             as handle        extent 4 no-undo .
     4370           define variable v-name-button   as character     no-undo .
     4371           define variable v-help-old-x    as decimal       no-undo .
     4372           define variable v-help-old-y    as decimal       no-undo .
     4373           define variable v-help-old-size as decimal       no-undo .
     4374           define variable v-frame-width   as decimal       no-undo .
     4375           define variable jj              as integer       no-undo .
     4376           do
     4377               on error undo, return error
     4378               :
     4379               assign
     4380                   v-frame-width = frame Dialog-Frame:width - 0.3
     4381                   fh            = frame Dialog-Frame:first-child
     4382                   hh            = fh:first-child
     4383                   ii            = 1
     4384                   .
     4385               do while valid-handle(hh):
     4386                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     4387                   do:
     4388                       case lc(hh:name) :
     4389                           when "b-help" then
     4390                               do:
     4391                                   hh:load-image-up("cmp/b-help.bmp":u) .
     4392                                   hh:load-image-down("cmp/b-help.bmp":u) .
     4393                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     4394                                   hh:TOOLTIP = "Помощь" .
     4395                                   v-help-old-x = hh:column .
     4396                                   v-help-old-y = hh:row    .
     4397                                   v-help-old-size = hh:width .
     4398                                   hh:width-chars = 2.5 .
     4399                               end.
     4400                           when "b-print" then
     4401                               do:
     4402                                   hh:load-image("cmp/b-print.bmp":u) .
     4403                                   hh:TOOLTIP = "Печать" .
     4404                                   v-h[ii] = hh:handle .
     4405                                   ii = ii + 1 .
     4406                                   hh:width-chars = 3 .
     4407                               end.
     4408                           when "b-history" or
     4409                           when "b-hist" then
     4410                               do:
     4411                                   hh:load-image("cmp/b-hist.bmp":u) .
     4412                                   hh:TOOLTIP = "История" .
     4413                                   v-h[ii] = hh:handle .
     4414                                   ii = ii + 1 .
     4415                                   hh:width-chars = 3 .
     4416                               end.
     4417                           when "b-sch" then
     4418                               do:
     4419                                   hh:load-image("cmp/b-sch.bmp":u) .
     4420                                   hh:TOOLTIP = "Установка Фильтра" .
     4421                                   v-h[ii] = hh:handle .
     4422                                   ii = ii + 1 .
     4423                                   hh:width-chars = 3 .
     4424                               end.
     4425                           when "b-hist-user" then
     4426                               do:
     4427                                   hh:load-image("cmp/b-hist.bmp":u) .
     4428                                   hh:TOOLTIP = "История пользователя" .
     4429                                   ii = ii + 1 .
     4430                               end.
     4431                       end case.
     4432                   end.
     4433                   hh = hh:next-sibling.
     4434               end.
     4435               b-help:column = v-frame-width - b-help:width-chars.
     4436               jj = 0.
     4437               repeat ii = 4 to 1 by -1 :
     4438                   if valid-handle (v-h[ii] ) then
     4439                   do:
     4440                       jj  = jj + 1 .
     4441                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     4442                       v-h[ii]:row    = v-help-old-y .
     4443                   end.
     4444               end.
     4445           end.
     4446       end.
     4447   end procedure.
     4448   define variable vss-include-info70 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     4449   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     4450   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     4451   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     4452   define variable v-diasize-current-frame-width  as decimal   no-undo .
     4453   define variable v-diasize-current-frame-height as decimal   no-undo .
     4454   define variable v-diasize-change-size          as logical   no-undo .
     4455   define variable v-diasize-resize-button        as handle    no-undo .
     4456   define variable v-diasize-wndmax               as logical   no-undo .
     4457   define variable v-diasize-wndstore             as logical   no-undo .
     4458   define variable v-diasize-proc-name            as character no-undo .
     4459   define variable v-diasize-browse-handle        as handle    no-undo .
     4460   define variable v-diasize-browse-number        as integer   no-undo .
     4461   define variable v-diasize-need-full-display    as logical   no-undo init false .
     4462   define temp-table temp-diasize-handle no-undo
     4463     field handle-value  as handle
     4464     field save-position as decimal
     4465     index xpk is primary unique handle-value
     4466     .
     4467   define temp-table temp-browse-handle no-undo
     4468     field browse-type   as character
     4469     field browse-number as integer
     4470     field browse-handle as handle
     4471     field original-size as decimal
     4472     index xpk is primary unique browse-type browse-number
     4473     index xie browse-type browse-handle
     4474   .
     4475   procedure diasize_change-height :
     4476     define input  parameter p-change-value  as decimal   no-undo .
     4477     define input  parameter p-move-resize   as logical   no-undo .
     4478     define variable v-field-group-handle    as handle    no-undo .
     4479     define variable v-object-handle         as handle    no-undo .
     4480     define variable v-frame-height          as decimal   no-undo .
     4481     define variable v-frame-virtual-height  as decimal   no-undo .
     4482     define variable v-browse-height         as decimal   no-undo .
     4483     define variable v-window-height         as decimal   no-undo .
     4484     define variable v-window-virtual-height as decimal   no-undo .
     4485     define variable v-change-sign           as integer   no-undo .
     4486     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     4487     define buffer buf_temp-browse-handle  for temp-browse-handle .
     4488     if p-change-value > 0
     4489     then do:
     4490       if frame Dialog-Frame :height + p-change-value
     4491           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     4492       then do:
     4493         assign
     4494           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     4495                           - (frame Dialog-Frame :height-chars)
     4496         .
     4497         if p-change-value <= 0
     4498         then do:
     4499           run diasize_position-resize-button in this-procedure .
     4500           return .
     4501         end.
     4502       end.
     4503     end.
     4504     if p-change-value < 0
     4505     then do:
     4506       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     4507       then do:
     4508         assign
     4509           p-change-value = v-diasize-orig-frame-height
     4510                          - (frame Dialog-Frame :height-chars)
     4511         .
     4512         if p-change-value >= 0
     4513         then do:
     4514           run diasize_position-resize-button in this-procedure .
     4515           return .
     4516         end.
     4517       end.
     4518     end.
     4519     if p-change-value >= 0
     4520     then do:
     4521       assign
     4522         v-change-sign = 1
     4523       .
     4524     end.
     4525     else do:
     4526       assign
     4527         v-change-sign = -1
     4528       .
     4529     end.
     4530     assign
     4531       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     4532     .
     4533     if p-change-value = 0
     4534     then do:
     4535       run diasize_position-resize-button in this-procedure .
     4536       return .
     4537     end.
     4538     move_block:
     4539     do
     4540     on error undo move_block, retry move_block
     4541     :
     4542       if retry
     4543       then do:
     4544         do
     4545         on error undo move_block, leave move_block
     4546         :
     4547           if p-change-value > 0
     4548           then do:
     4549             for each buf_temp-diasize-handle
     4550             on error undo, next
     4551             :
     4552               assign
     4553                 v-object-handle = buf_temp-diasize-handle.handle-value
     4554               .
     4555               if v-object-handle <> v-diasize-resize-button
     4556               then do:
     4557                 assign
     4558                   v-object-handle :row = buf_temp-diasize-handle.save-position
     4559                 .
     4560               end.
     4561             end.
     4562             assign
     4563               v-diasize-browse-handle :height = v-browse-height
     4564             .
     4565             for each buf_temp-browse-handle
     4566               where buf_temp-browse-handle.browse-type = 'height':u
     4567             on error undo, next
     4568             :
     4569               assign
     4570                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     4571               .
     4572             end.
     4573             assign
     4574               frame Dialog-Frame :height = v-frame-height
     4575             .
     4576             if frame Dialog-Frame :scrollable = true
     4577             then do:
     4578               assign
     4579                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     4580               .
     4581             end.
     4582             run diasize_position-resize-button in this-procedure .
     4583           end.
     4584           else do:
     4585             if frame Dialog-Frame :scrollable = true
     4586             then do:
     4587               assign
     4588                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     4589               .
     4590             end.
     4591             assign
     4592               frame Dialog-Frame :height = v-frame-height
     4593             .
     4594             assign
     4595               v-diasize-browse-handle :height = v-browse-height
     4596             .
     4597             for each buf_temp-browse-handle
     4598               where buf_temp-browse-handle.browse-type = 'height':u
     4599             on error undo, next
     4600             :
     4601               assign
     4602                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     4603               .
     4604             end.
     4605             for each buf_temp-diasize-handle
     4606             on error undo, next
     4607             :
     4608               assign
     4609                 v-object-handle = buf_temp-diasize-handle.handle-value
     4610               .
     4611               if v-object-handle <> v-diasize-resize-button
     4612               then do:
     4613                 assign
     4614                   v-object-handle :row = buf_temp-diasize-handle.save-position
     4615                 .
     4616               end.
     4617             end.
     4618             run diasize_position-resize-button in this-procedure .
     4619           end.
     4620           assign
     4621             v-diasize-change-size = false
     4622           .
     4623           leave move_block .
     4624         end.
     4625       end.
     4626       assign
     4627         v-diasize-need-full-display = true
     4628       .
     4629       if v-diasize-change-size = false
     4630       then do:
     4631         assign
     4632           v-diasize-change-size = true
     4633         .
     4634       end.
     4635       else do:
     4636         return .
     4637       end.
     4638       assign
     4639         v-frame-height = frame Dialog-Frame :height
     4640         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     4641         v-browse-height = v-diasize-browse-handle :height
     4642       .
     4643       for each buf_temp-browse-handle
     4644         where buf_temp-browse-handle.browse-type = 'height':u
     4645       :
     4646         assign
     4647           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     4648         .
     4649       end.
     4650       for each buf_temp-diasize-handle
     4651       :
     4652         delete buf_temp-diasize-handle .
     4653       end.
     4654       assign
     4655         v-field-group-handle = frame Dialog-Frame :first-child
     4656       .
     4657       do while valid-handle(v-field-group-handle)
     4658       :
     4659         assign
     4660           v-object-handle = v-field-group-handle :first-child
     4661         .
     4662         do while valid-handle(v-object-handle)
     4663         :
     4664           if  v-object-handle <> v-diasize-browse-handle :handle
     4665           and can-query(v-object-handle, "row")
     4666           and can-query(v-object-handle, "height")
     4667           and ( v-object-handle :row > v-diasize-browse-handle :row )
     4668           then do:
     4669             find first buf_temp-browse-handle
     4670               where buf_temp-browse-handle.browse-type   = 'height':u
     4671                 and buf_temp-browse-handle.browse-handle = v-object-handle
     4672               no-error .
     4673             if available buf_temp-browse-handle
     4674             then do:
     4675             end.
     4676             else do:
     4677               create buf_temp-diasize-handle .
     4678               assign
     4679                 buf_temp-diasize-handle.handle-value  = v-object-handle
     4680                 buf_temp-diasize-handle.save-position = v-object-handle :row
     4681               .
     4682             end.
     4683           end.
     4684           assign
     4685             v-object-handle = v-object-handle :next-sibling
     4686           .
     4687         end.
     4688         assign
     4689           v-field-group-handle = v-field-group-handle :next-sibling
     4690         .
     4691       end.
     4692       do with frame Dialog-Frame
     4693       :
     4694         hide v-diasize-resize-button .
     4695         assign
     4696           v-diasize-resize-button :row    = 1
     4697           v-diasize-resize-button :column = 1
     4698         .
     4699       end.
     4700       if p-change-value > 0
     4701       then do:
     4702         if frame Dialog-Frame :scrollable = true
     4703         then do:
     4704           assign
     4705             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     4706             no-error .
     4707           if error-status :error
     4708           or error-status :get-message(1) <> ""
     4709           then do:
     4710             undo move_block, retry move_block .
     4711           end.
     4712         end.
     4713         assign
     4714           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     4715           no-error .
     4716         if error-status :error
     4717         or error-status :get-message(1) <> ""
     4718         then do:
     4719           undo move_block, retry move_block .
     4720         end.
     4721         assign
     4722           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     4723           no-error .
     4724         if error-status :error
     4725         or error-status :get-message(1) <> ""
     4726         then do:
     4727           undo move_block, retry move_block .
     4728         end.
     4729         for each buf_temp-browse-handle
     4730           where buf_temp-browse-handle.browse-type = 'height':u
     4731         on error undo move_block, retry move_block
     4732         :
     4733           assign
     4734             buf_temp-browse-handle.browse-handle :height
     4735               = buf_temp-browse-handle.browse-handle :height + p-change-value
     4736             no-error .
     4737           if error-status :error
     4738           or error-status :get-message(1) <> ""
     4739           then do:
     4740             undo move_block, retry move_block .
     4741           end.
     4742         end.
     4743         for each buf_temp-diasize-handle
     4744         on error undo move_block, retry move_block
     4745         :
     4746           assign
     4747             v-object-handle = buf_temp-diasize-handle.handle-value
     4748           .
     4749           if v-object-handle <> v-diasize-resize-button
     4750           then do:
     4751             assign
     4752               v-object-handle :row = v-object-handle :row + p-change-value
     4753               no-error .
     4754             if error-status :error
     4755             or error-status :get-message(1) <> ""
     4756             then do:
     4757               undo move_block, retry move_block .
     4758             end.
     4759           end.
     4760         end.
     4761       end.
     4762       else do:
     4763         for each buf_temp-diasize-handle
     4764         on error undo move_block, retry move_block
     4765         :
     4766           assign
     4767             v-object-handle = buf_temp-diasize-handle.handle-value
     4768           .
     4769           if v-object-handle <> v-diasize-resize-button
     4770           then do:
     4771             assign
     4772               v-object-handle :row = v-object-handle :row + p-change-value
     4773               no-error .
     4774             if error-status :error
     4775             or error-status :get-message(1) <> ""
     4776             then do:
     4777               undo move_block, retry move_block .
     4778             end.
     4779           end.
     4780         end.
     4781         assign
     4782           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     4783           no-error .
     4784         if error-status :error
     4785         or error-status :get-message(1) <> ""
     4786         then do:
     4787           undo move_block, retry move_block .
     4788         end.
     4789         for each buf_temp-browse-handle
     4790           where buf_temp-browse-handle.browse-type = 'height':u
     4791         on error undo move_block, retry move_block
     4792         :
     4793           assign
     4794             buf_temp-browse-handle.browse-handle :height
     4795               = buf_temp-browse-handle.browse-handle :height + p-change-value
     4796             no-error .
     4797           if error-status :error
     4798           or error-status :get-message(1) <> ""
     4799           then do:
     4800             undo move_block, retry move_block .
     4801           end.
     4802         end.
     4803         assign
     4804           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     4805           no-error .
     4806         if error-status :error
     4807         or error-status :get-message(1) <> ""
     4808         then do:
     4809           undo move_block, retry move_block .
     4810         end.
     4811         if frame Dialog-Frame :scrollable = true
     4812         then do:
     4813           assign
     4814             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     4815             no-error .
     4816           if error-status :error
     4817           or error-status :get-message(1) <> ""
     4818           then do:
     4819             undo move_block, retry move_block .
     4820           end.
     4821         end.
     4822       end.
     4823       if p-move-resize = true
     4824       then do:
     4825         run diasize_position-resize-button in this-procedure .
     4826       end.
     4827       if v-diasize-wndstore = true
     4828       then do:
     4829         if connected("ub") = true
     4830         then do:
     4831           define variable v-cntxt-db-num        as integer   no-undo .
     4832           define variable v-cntxt-userid        as character no-undo .
     4833           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     4834                                             , OUTPUT v-cntxt-userid
     4835                                             ) .
     4836           run gbl/wndsizew.p
     4837             (input  v-cntxt-db-num
     4838             ,input  v-cntxt-userid
     4839             ,input  v-diasize-proc-name
     4840             ,input  'height':u
     4841             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     4842             ) .
     4843         end.
     4844       end.
     4845     end.
     4846     assign
     4847       v-diasize-change-size = false
     4848     .
     4849   end procedure.
     4850   procedure diasize_set-height :
     4851     define input  parameter p-new-height  as decimal   no-undo .
     4852     define input  parameter p-move-resize as logical   no-undo .
     4853     do
     4854     on error undo, return error return-value
     4855     :
     4856       run diasize_change-height in this-procedure
     4857         (input  (p-new-height - frame Dialog-Frame :height)
     4858         ,input  p-move-resize
     4859         ) .
     4860     end.
     4861   end procedure.
     4862   procedure diasize_change-width :
     4863     define input  parameter p-change-value as decimal   no-undo .
     4864     define input  parameter p-move-resize  as logical   no-undo .
     4865     define variable v-field-group-handle   as handle    no-undo .
     4866     define variable v-object-handle        as handle    no-undo .
     4867     define variable v-frame-width          as decimal   no-undo .
     4868     define variable v-frame-virtual-width  as decimal   no-undo .
     4869     define variable v-browse-width         as decimal   no-undo .
     4870     define variable v-window-width         as decimal   no-undo .
     4871     define variable v-window-virtual-width as decimal   no-undo .
     4872     define variable v-change-sign          as integer   no-undo .
     4873     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     4874     define buffer buf_temp-browse-handle  for temp-browse-handle .
     4875     if p-change-value > 0
     4876     then do:
     4877       if frame Dialog-Frame :width + p-change-value >
     4878           session :width-chars
     4879       then do:
     4880         assign
     4881           p-change-value = session :width-chars - frame Dialog-Frame :width
     4882         .
     4883         if p-change-value <= 0
     4884         then do:
     4885           run diasize_position-resize-button in this-procedure .
     4886           return .
     4887         end.
     4888       end.
     4889     end.
     4890     if p-change-value < 0
     4891     then do:
     4892       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     4893       then do:
     4894         assign
     4895           p-change-value = v-diasize-orig-frame-width
     4896                          - frame Dialog-Frame :width
     4897         .
     4898         if p-change-value >= 0
     4899         then do:
     4900           run diasize_position-resize-button in this-procedure .
     4901           return .
     4902         end.
     4903       end.
     4904     end.
     4905     if p-change-value >= 0
     4906     then do:
     4907       assign
     4908         v-change-sign = 1
     4909       .
     4910     end.
     4911     else do:
     4912       assign
     4913         v-change-sign = -1
     4914       .
     4915     end.
     4916     assign
     4917       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     4918     .
     4919     if p-change-value = 0
     4920     then do:
     4921       run diasize_position-resize-button in this-procedure .
     4922       return .
     4923     end.
     4924     move_block:
     4925     do
     4926     on error undo move_block, leave move_block
     4927     :
     4928       if retry
     4929       then do:
     4930         do
     4931         on error undo move_block, leave move_block
     4932         :
     4933           if p-change-value > 0
     4934           then do:
     4935             for each buf_temp-diasize-handle
     4936             on error undo, next
     4937             :
     4938               assign
     4939                 v-object-handle = buf_temp-diasize-handle.handle-value
     4940               .
     4941               if v-object-handle <> v-diasize-resize-button
     4942               then do:
     4943                 assign
     4944                   v-object-handle :col = buf_temp-diasize-handle.save-position
     4945                 .
     4946               end.
     4947             end.
     4948             assign
     4949               v-diasize-browse-handle :width = v-browse-width
     4950             .
     4951             for each buf_temp-browse-handle
     4952               where buf_temp-browse-handle.browse-type = 'width':u
     4953             on error undo, next
     4954             :
     4955               assign
     4956                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     4957               .
     4958             end.
     4959             assign
     4960               frame Dialog-Frame :width = v-frame-width
     4961             .
     4962             if frame Dialog-Frame :scrollable = true
     4963             then do:
     4964               assign
     4965                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     4966               .
     4967             end.
     4968             run diasize_position-resize-button in this-procedure .
     4969           end.
     4970           else do:
     4971             if frame Dialog-Frame :scrollable = true
     4972             then do:
     4973               assign
     4974                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     4975               .
     4976             end.
     4977             assign
     4978               frame Dialog-Frame :width = v-frame-width
     4979             .
     4980             for each buf_temp-browse-handle
     4981               where buf_temp-browse-handle.browse-type = 'width':u
     4982             on error undo, next
     4983             :
     4984               assign
     4985                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     4986               .
     4987             end.
     4988             assign
     4989               v-diasize-browse-handle :width = v-browse-width
     4990             .
     4991             for each buf_temp-diasize-handle
     4992             on error undo, next
     4993             :
     4994               assign
     4995                 v-object-handle = buf_temp-diasize-handle.handle-value
     4996               .
     4997               if v-object-handle <> v-diasize-resize-button
     4998               then do:
     4999                 assign
     5000                   v-object-handle :col = buf_temp-diasize-handle.save-position
     5001                 .
     5002               end.
     5003             end.
     5004             run diasize_position-resize-button in this-procedure .
     5005           end.
     5006           assign
     5007             v-diasize-change-size = false
     5008           .
     5009           leave move_block .
     5010         end.
     5011       end.
     5012       assign
     5013         v-diasize-need-full-display = true
     5014       .
     5015       if v-diasize-change-size = false
     5016       then do:
     5017         assign
     5018           v-diasize-change-size = true
     5019         .
     5020       end.
     5021       else do:
     5022         return .
     5023       end.
     5024       assign
     5025         v-frame-width = frame Dialog-Frame :width
     5026         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     5027         v-browse-width = v-diasize-browse-handle :width
     5028       .
     5029       for each buf_temp-browse-handle
     5030         where buf_temp-browse-handle.browse-type = 'width':u
     5031       :
     5032         assign
     5033           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     5034         .
     5035       end.
     5036       for each buf_temp-diasize-handle
     5037       :
     5038         delete buf_temp-diasize-handle .
     5039       end.
     5040       assign
     5041         v-field-group-handle = frame Dialog-Frame :first-child
     5042       .
     5043       do while valid-handle(v-field-group-handle)
     5044       :
     5045         assign
     5046           v-object-handle = v-field-group-handle :first-child
     5047         .
     5048         do while valid-handle(v-object-handle)
     5049         :
     5050           if  v-object-handle <> v-diasize-browse-handle :handle
     5051           and v-object-handle <> v-diasize-resize-button
     5052           and can-query(v-object-handle, "row")
     5053           and can-query(v-object-handle, "height")
     5054           and ( v-object-handle :col + v-object-handle :width
     5055                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     5056               )
     5057           then do:
     5058             find first buf_temp-browse-handle
     5059               where buf_temp-browse-handle.browse-type   = 'width':u
     5060                 and buf_temp-browse-handle.browse-handle = v-object-handle
     5061               no-error .
     5062             if available buf_temp-browse-handle
     5063             then do:
     5064             end.
     5065             else do:
     5066               create buf_temp-diasize-handle .
     5067               assign
     5068                 buf_temp-diasize-handle.handle-value  = v-object-handle
     5069                 buf_temp-diasize-handle.save-position = v-object-handle :col
     5070               .
     5071             end.
     5072           end.
     5073           assign
     5074             v-object-handle = v-object-handle :next-sibling
     5075           .
     5076         end.
     5077         assign
     5078           v-field-group-handle = v-field-group-handle :next-sibling
     5079         .
     5080       end.
     5081       do with frame Dialog-Frame
     5082       :
     5083         hide v-diasize-resize-button .
     5084         v-diasize-resize-button :row = 1.
     5085         v-diasize-resize-button :column = 1.
     5086       end.
     5087       if p-change-value > 0
     5088       then do:
     5089         if frame Dialog-Frame :scrollable = true
     5090         then do:
     5091           assign
     5092             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     5093             no-error .
     5094           if error-status :error
     5095           or error-status :get-message(1) <> ""
     5096           then do:
     5097             undo move_block, retry move_block.
     5098           end.
     5099         end.
     5100         assign
     5101           frame Dialog-Frame :width = v-frame-width + p-change-value
     5102           no-error .
     5103         if error-status :error
     5104         or error-status :get-message(1) <> ""
     5105         then do:
     5106           undo move_block, retry move_block.
     5107         end.
     5108         assign
     5109           v-diasize-browse-handle :width = v-browse-width + p-change-value
     5110         no-error .
     5111         if error-status :error
     5112         or error-status :get-message(1) <> ""
     5113         then do:
     5114           undo move_block, retry move_block.
     5115         end.
     5116         for each buf_temp-browse-handle
     5117           where buf_temp-browse-handle.browse-type = 'width':u
     5118         on error undo move_block, retry move_block
     5119         :
     5120           assign
     5121             buf_temp-browse-handle.browse-handle :width
     5122               = buf_temp-browse-handle.browse-handle :width + p-change-value
     5123             no-error .
     5124           if error-status :error
     5125           or error-status :get-message(1) <> ""
     5126           then do:
     5127             undo move_block, retry move_block .
     5128           end.
     5129         end.
     5130         for each buf_temp-diasize-handle
     5131         on error undo move_block, retry move_block
     5132         :
     5133           assign
     5134             v-object-handle = buf_temp-diasize-handle.handle-value
     5135           .
     5136           if v-object-handle <> v-diasize-resize-button
     5137           then do:
     5138             assign
     5139               v-object-handle :col = v-object-handle :col + p-change-value
     5140               no-error .
     5141             if error-status :error
     5142             or error-status :get-message(1) <> ""
     5143             then do:
     5144               undo move_block, retry move_block .
     5145             end.
     5146           end.
     5147         end.
     5148       end.
     5149       else do:
     5150         for each buf_temp-diasize-handle
     5151         on error undo move_block, retry move_block
     5152         :
     5153           assign
     5154             v-object-handle = buf_temp-diasize-handle.handle-value
     5155           .
     5156           if v-object-handle <> v-diasize-resize-button
     5157           then do:
     5158             assign
     5159               v-object-handle :col = v-object-handle :col + p-change-value
     5160               no-error .
     5161             if error-status :error
     5162             or error-status :get-message(1) <> ""
     5163             then do:
     5164               undo move_block, retry move_block .
     5165             end.
     5166           end.
     5167         end.
     5168         for each buf_temp-browse-handle
     5169           where buf_temp-browse-handle.browse-type = 'width':u
     5170         on error undo move_block, retry move_block
     5171         :
     5172           assign
     5173             buf_temp-browse-handle.browse-handle :width
     5174               = buf_temp-browse-handle.browse-handle :width + p-change-value
     5175             no-error .
     5176           if error-status :error
     5177           or error-status :get-message(1) <> ""
     5178           then do:
     5179             undo move_block, retry move_block .
     5180           end.
     5181         end.
     5182         assign
     5183           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     5184           no-error .
     5185         if error-status :error
     5186         or error-status :get-message(1) <> ""
     5187         then do:
     5188           undo move_block, retry move_block.
     5189         end.
     5190         assign
     5191           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     5192         no-error .
     5193         if error-status :error
     5194         or error-status :get-message(1) <> ""
     5195         then do:
     5196           undo move_block, retry move_block.
     5197         end.
     5198         if frame Dialog-Frame :scrollable = true
     5199         then do:
     5200           assign
     5201             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     5202           no-error .
     5203           if error-status :error
     5204           or error-status :get-message(1) <> ""
     5205           then do:
     5206             undo move_block, retry move_block.
     5207           end.
     5208         end.
     5209       end.
     5210       if p-move-resize
     5211       then do:
     5212         run diasize_position-resize-button in this-procedure .
     5213       end.
     5214       if v-diasize-wndstore = true
     5215       then do:
     5216         if connected("ub") = true
     5217         then do:
     5218           define variable v-cntxt-db-num        as integer   no-undo .
     5219           define variable v-cntxt-userid        as character no-undo .
     5220           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     5221                                             , OUTPUT v-cntxt-userid
     5222                                             ) .
     5223           run gbl/wndsizew.p
     5224             (input  v-cntxt-db-num
     5225             ,input  v-cntxt-userid
     5226             ,input  v-diasize-proc-name
     5227             ,input  'width':u
     5228             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     5229             ) .
     5230         end.
     5231       end.
     5232     end.
     5233     assign
     5234       v-diasize-change-size = false
     5235     .
     5236   end procedure.
     5237   procedure diasize_set-width :
     5238     define input  parameter p-new-width  as decimal   no-undo .
     5239     define input  parameter p-move-resize as logical   no-undo .
     5240     do
     5241     on error undo, return error return-value
     5242     :
     5243       run diasize_change-width in this-procedure
     5244         (input  (p-new-width - frame Dialog-Frame :width)
     5245         ,input  p-move-resize
     5246         ) .
     5247     end.
     5248   end procedure.
     5249   procedure diasize_position-resize-button :
     5250     do with frame Dialog-Frame
     5251     :
     5252       hide v-diasize-resize-button .
     5253       assign
     5254         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     5255                     - 1
     5256                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     5257         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     5258                     - 1
     5259                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     5260       .
     5261       view v-diasize-resize-button .
     5262     end.
     5263   end procedure.
     5264   on alt-right anywhere
     5265   do:
     5266     run diasize_change-width in this-procedure
     5267       (input 1
     5268       ,input true
     5269       ) .
     5270     return no-apply .
     5271   end.
     5272   on alt-left anywhere
     5273   do:
     5274     run diasize_change-width in this-procedure
     5275       (input -1
     5276       ,input true
     5277       ) .
     5278     return no-apply .
     5279   end.
     5280   on alt-down anywhere
     5281   do:
     5282     run diasize_change-height in this-procedure
     5283       (input 1
     5284       ,input true
     5285       ) .
     5286     return no-apply .
     5287   end.
     5288   on alt-up anywhere
     5289   do:
     5290     run diasize_change-height in this-procedure
     5291       (input -1
     5292       ,input true
     5293       ) .
     5294     return no-apply .
     5295   end.
     5296   on alt-enter of frame Dialog-Frame
     5297   do:
     5298     run diasize_maximize in this-procedure
     5299       (input  ?
     5300       ).
     5301     return no-apply .
     5302   end.
     5303   procedure diasize_end-move :
     5304     do
     5305     on error undo, return error return-value
     5306     :
     5307       define variable v-row-delta as decimal   no-undo .
     5308       define variable v-col-delta as decimal   no-undo .
     5309       define variable v-new-row as decimal   no-undo .
     5310       define variable v-new-col as decimal   no-undo .
     5311       assign
     5312         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     5313         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     5314       .
     5315       assign
     5316         v-row-delta = v-new-row - frame Dialog-Frame :height
     5317         v-col-delta = v-new-col - frame Dialog-Frame :width
     5318       .
     5319       run diasize_change-height in this-procedure
     5320         (input v-row-delta
     5321         ,input true
     5322         ) .
     5323       run diasize_change-width in this-procedure
     5324         (input v-col-delta
     5325         ,input true
     5326         ) .
     5327     end.
     5328   end procedure.
     5329   procedure diasize_maximize :
     5330     define input  parameter p-action as logical   no-undo .
     5331     do
     5332     on error undo, return error return-value
     5333     :
     5334       if p-action = ?
     5335       then do:
     5336         if v-diasize-need-maximize = true
     5337         then do:
     5338           assign
     5339             p-action = true
     5340           .
     5341         end.
     5342         else do:
     5343           assign
     5344             p-action = false
     5345           .
     5346         end.
     5347       end.
     5348       if p-action = true
     5349       then do:
     5350         run diasize_change-height in this-procedure
     5351           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     5352               - frame Dialog-Frame :height-chars
     5353           ,input true
     5354           ) .
     5355         run diasize_change-width in this-procedure
     5356           (input session :width-chars
     5357               - frame Dialog-Frame :width-chars
     5358           ,input true
     5359           ) .
     5360         assign
     5361           v-diasize-need-maximize = false
     5362         .
     5363       end.
     5364       else do:
     5365         run diasize_change-width in this-procedure
     5366           (input v-diasize-orig-frame-width
     5367               - frame Dialog-Frame :width-chars
     5368           ,input true
     5369           ) .
     5370         run diasize_change-height in this-procedure
     5371           (input v-diasize-orig-frame-height
     5372               - frame Dialog-Frame :height-chars
     5373           ,input true
     5374           ) .
     5375         assign
     5376           v-diasize-need-maximize = true
     5377         .
     5378       end.
     5379     end.
     5380   end procedure.
     5381   procedure diasize_restore-orig-size :
     5382     do
     5383     on error undo, return error return-value
     5384     :
     5385       assign
     5386         v-diasize-current-frame-width  = frame Dialog-Frame :width
     5387         v-diasize-current-frame-height = frame Dialog-Frame :height
     5388       .
     5389       run diasize_set-height in this-procedure
     5390         (input  v-diasize-orig-frame-height
     5391         ,input  true
     5392         ) .
     5393       run diasize_set-width in this-procedure
     5394         (input  v-diasize-orig-frame-width
     5395         ,input  true
     5396         ) .
     5397     end.
     5398   end procedure.
     5399   procedure diasize_restore-current-size :
     5400     do
     5401     on error undo, return error return-value
     5402     :
     5403       run diasize_set-height in this-procedure
     5404         (input  v-diasize-current-frame-height
     5405         ,input  true
     5406         ) .
     5407       run diasize_set-width in this-procedure
     5408         (input  v-diasize-current-frame-width
     5409         ,input  true
     5410         ) .
     5411     end.
     5412   end procedure.
     5413   procedure diasize_set-browse-handle :
     5414     define input  parameter p-browse-handle as handle   no-undo .
     5415     define buffer buf_temp-browse-handle for temp-browse-handle .
     5416     do
     5417     on error undo, return error return-value
     5418     :
     5419       assign
     5420         v-diasize-browse-handle = p-browse-handle
     5421       .
     5422       for each buf_temp-browse-handle
     5423       on error undo, return error return-value
     5424       :
     5425         delete buf_temp-browse-handle .
     5426       end.
     5427     end.
     5428   end procedure.
     5429   procedure diasize_add_browse :
     5430     define input  parameter p-browse-type   as character no-undo .
     5431     define input  parameter p-browse-handle as handle    no-undo .
     5432     define buffer buf_temp-browse-handle for temp-browse-handle .
     5433     do
     5434     on error undo, return error return-value
     5435     :
     5436       assign
     5437         v-diasize-browse-number = v-diasize-browse-number + 1
     5438       .
     5439       create buf_temp-browse-handle .
     5440       assign
     5441         buf_temp-browse-handle.browse-type   = p-browse-type
     5442         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     5443         buf_temp-browse-handle.browse-handle = p-browse-handle
     5444       .
     5445     end.
     5446   end procedure.
     5447   procedure diasize_init :
     5448     define variable v-default-value    as logical   no-undo .
     5449     define variable v-restore-saved    as logical   no-undo .
     5450     define variable v-resize-value-str as character no-undo .
     5451     do
     5452     on error undo, return error return-value
     5453     :
     5454       do with frame Dialog-Frame
     5455       :
     5456         assign
     5457           v-diasize-orig-frame-height = frame Dialog-Frame :height
     5458           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     5459           v-diasize-browse-handle     = browse br-lst :handle
     5460         .
     5461         create button v-diasize-resize-button
     5462         assign
     5463           parent        = frame Dialog-Frame :first-child
     5464           label         = "s"
     5465           height-pixels = 16
     5466           width-pixels  = 16
     5467           visible       = true
     5468           sensitive     = true
     5469           movable       = true
     5470           triggers:
     5471             on end-move persistent run diasize_end-move in this-procedure .
     5472           end triggers.
     5473         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     5474         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     5475         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     5476         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     5477         assign
     5478           v-diasize-wndmax = false
     5479         .
     5480         if connected("ub") = true
     5481         then do:
     5482           define variable v-cntxt-db-num        as integer   no-undo .
     5483           define variable v-cntxt-userid        as character no-undo .
     5484           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     5485                                             , OUTPUT v-cntxt-userid
     5486                                             ) .
     5487           run gbl/wndpar_r.p
     5488             (input  v-cntxt-db-num
     5489             ,input  v-cntxt-userid
     5490             ,input  'wndmax':U
     5491             ,output v-diasize-wndmax
     5492             ,output v-default-value
     5493             ) .
     5494         end.
     5495         assign
     5496           v-diasize-wndstore = false
     5497         .
     5498         if connected("ub") = true
     5499         then do:
     5500           run gbl/wndpar_r.p
     5501             (input  v-cntxt-db-num
     5502             ,input  v-cntxt-userid
     5503             ,input  'wndstore':U
     5504             ,output v-diasize-wndstore
     5505             ,output v-default-value
     5506             ) .
     5507         end.
     5508         assign
     5509           v-diasize-proc-name = entry(1, program-name(2), '.')
     5510         .
     5511         if v-diasize-wndstore = true
     5512         then do:
     5513           assign
     5514             v-restore-saved = false
     5515           .
     5516           if connected("ub") = true
     5517           then do:
     5518             run gbl/wndsizer.p
     5519               (input  v-cntxt-db-num
     5520               ,input  v-cntxt-userid
     5521               ,input  v-diasize-proc-name
     5522               ,input  'height':u
     5523               ,output v-resize-value-str
     5524               ) .
     5525             if v-resize-value-str <> '':U
     5526             then do:
     5527               run diasize_change-height in this-procedure
     5528                 (input  integer(v-resize-value-str)
     5529                 ,input  true
     5530                 ) .
     5531               assign
     5532                 v-restore-saved = true
     5533               .
     5534             end.
     5535           end.
     5536           if connected("ub") = true
     5537           then do:
     5538             run gbl/wndsizer.p
     5539               (input  v-cntxt-db-num
     5540               ,input  v-cntxt-userid
     5541               ,input  v-diasize-proc-name
     5542               ,input  'width':u
     5543               ,output v-resize-value-str
     5544               ) .
     5545             if v-resize-value-str <> '':U
     5546             then do:
     5547               run diasize_change-width in this-procedure
     5548                 (input  integer(v-resize-value-str)
     5549                 ,input  true
     5550                 ) .
     5551               assign
     5552                 v-restore-saved = true
     5553               .
     5554             end.
     5555           end.
     5556           if v-restore-saved <> true
     5557           then do:
     5558             if v-diasize-wndmax = true
     5559             then do:
     5560               run diasize_maximize in this-procedure
     5561                 (input  true
     5562                 ) .
     5563             end.
     5564           end.
     5565         end.
     5566         else do:
     5567           if v-diasize-wndmax = true
     5568           then do:
     5569             run diasize_maximize in this-procedure
     5570               (input  true
     5571               ) .
     5572           end.
     5573         end.
     5574       end.
     5575     end.
     5576   end procedure.
     5577   procedure diasize_need-full-display :
     5578     define output parameter p-need-full-display as logical   no-undo .
     5579     do
     5580     on error undo, return error return-value
     5581     :
     5582       assign
     5583         p-need-full-display = v-diasize-need-full-display
     5584       .
     5585       assign
     5586         v-diasize-need-full-display = false
     5587       .
     5588     end.
     5589   end procedure.
     5590   procedure get-context :
     5591      define output parameter p-db-num as integer          no-undo.
     5592      define output parameter p-user-id as character        no-undo.
     5593      define variable v-login               as character    no-undo.
     5594      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     5595      define buffer buf_user-login  for ub.user-login .
     5596      do
     5597      on error undo, return error
     5598      :
     5599            FIND FIRST buf_sys-ctrl no-lock.
     5600            ASSIGN
     5601               v-login = USERID("ub")
     5602               p-db-num = buf_sys-ctrl.db-num
     5603            .
     5604            FIND FIRST buf_user-login
     5605                 WHERE buf_user-login.db-num = p-db-num
     5606                   AND buf_user-login.user-login = v-login
     5607                 no-lock
     5608                 no-error
     5609                 .
     5610            IF AVAILABLE buf_user-login
     5611            THEN DO:
     5612               assign
     5613                  p-user-id = buf_user-login.user-id
     5614               .
     5615            END.
     5616      end.
     5617   end procedure.
     5618       run diasize_init in this-procedure .
     5619   define variable vss-include-info71 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5620   on INS of frame Dialog-Frame anywhere do:
     5621     if b-mark :sensitive then DO: apply "CHOOSE":U to b-mark in frame Dialog-Frame. END.
     5622     return no-apply.
     5623   end.
