     3006     QUERY br-lst-db NO-LOCK DISPLAY
     3007         IF ( CAN-DO (rid-list, STRING ( recid( X_scales-gds) ) ) ) THEN ("*") ELSE (" ") COLUMN-LABEL "*" FORMAT "X(1)":U
     3008   X_scales-gds.PLU-code COLUMN-LABEL "PLU" FORMAT "99999":U
     3009   get-scl-code( INPUT X_bar-code.b-code, INPUT X_gds-obj-attr.attr-value, BUFFER X_prod-bc-db) COLUMN-LABEL "Вес.код" FORMAT "X(7)":U
     3010   entry (lookup (string(X_scales-gds.plu-type), '0,1':U) + 1, ',' + 'Весовой,Штучный':U) COLUMN-LABEL "Тип" FORMAT "X(3)":U
     3011   X_scales-gds.to-del COLUMN-LABEL "У" FORMAT "!/":U
     3012   X_scales-gds.to-send COLUMN-LABEL "И" FORMAT "+/-":U
     3013   X_goods.gds-name FORMAT "X(30)":U
     3014   X_scales-gds.wt-cart COLUMN-LABEL "Вес упак-ки" FORMAT "->>>>9.999":U
     3015   entry (lookup (STRING(X_scales-gds.deadflag), '0,1':U) + 1, ',' + 'Дни,Дата':U) COLUMN-LABEL "Тип ср.!годности" FORMAT "X(4)"
     3016   scl-gds-deadvalue( X_scales-gds.deadline,  X_scales-gds.deaddate, X_scales-gds.deadflag) COLUMN-LABEL "Срок годн." FORMAT "X(10)":U
     3017   X_bar-code.b-code FORMAT "999999999":U
     3018   X_scales-gds.obj-code FORMAT "99999":U COLUMN-LABEL "Маг"
     3019   X_goods.grp-name FORMAT "X(40)":U
     3020   get-price(buffer X_goods , input X_scales-gds.obj-type, input X_scales-gds.obj-code, input X_scales-gds.b-code) COLUMN-LABEL "Цена" FORMAT ">>>,>>9.99":U
     3021   X_goods.artic FORMAT "X(16)":U
     3022   X_goods.unit-base FORMAT "X(3)":U
     3023       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 18.5
     3024            BGCOLOR 15 FGCOLOR 0 .
     3025   DEFINE FRAME Dialog-Frame
     3026        b-quit AT ROW 1 COL 1
     3027        b-sel AT ROW 1 COL 11
     3028        b-mark AT ROW 1 COL 21
     3029        b-ticket AT ROW 1 COL 34
     3030        b-chg AT ROW 1 COL 44
     3031        PricePrint AT ROW 1 COL 54
     3032        B-send AT ROW 1 COL 64
     3033        b-hist AT ROW 1 COL 92
     3034        b-help AT ROW 1 COL 95
     3035        a-n-c AT ROW 2.77 COL 14 NO-LABEL
     3036        loc-code AT ROW 3.93 COL 21 COLON-ALIGNED
     3037        loc-name AT ROW 3.93 COL 21 COLON-ALIGNED
     3038        loc-art AT ROW 3.93 COL 21 COLON-ALIGNED
     3039        DeadValueRS AT ROW 3.93 COL 28 NO-LABEL
     3040        WeightValue AT ROW 3.93 COL 40.6 COLON-ALIGNED
     3041        DeadValue AT ROW 3.93 COL 61.1 COLON-ALIGNED
     3042        DeadValueDate AT ROW 3.93 COL 78.5 COLON-ALIGNED
     3043        br-lst-db AT ROW 5 COL 1 WIDGET-ID 100
     3044        br-lst AT ROW 5 COL 1
     3045        mark-num AT ROW 1.27 COL 25.3 COLON-ALIGNED NO-LABEL
     3046        "Поиск :" VIEW-AS TEXT
     3047             SIZE 7.9 BY 1 AT ROW 2.77 COL 4.8
     3048             BGCOLOR 8 FGCOLOR 0
     3049        SPACE(86.30) SKIP(19.79)
     3050       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     3051            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     3052            BGCOLOR 8 FGCOLOR 0
     3053            TITLE "Товары на весах"
     3054            DEFAULT-BUTTON b-chg.
     3055   ASSIGN
     3056          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     3057          FRAME Dialog-Frame:HIDDEN           = TRUE.
     3058   ASSIGN
     3059          b-chg:POPUP-MENU IN FRAME Dialog-Frame       = MENU MENU-b-chg:HANDLE.
     3060   ASSIGN
     3061          B-send:POPUP-MENU IN FRAME Dialog-Frame       = MENU MENU-B-send:HANDLE.
     3062   ASSIGN
     3063          br-lst:NUM-LOCKED-COLUMNS IN FRAME Dialog-Frame     = 3.
     3064   ASSIGN
     3065          br-lst-db:NUM-LOCKED-COLUMNS IN FRAME Dialog-Frame     = 3.
     3066   ASSIGN
     3067          PricePrint:POPUP-MENU IN FRAME Dialog-Frame       = MENU MENU-b-price:HANDLE.
     3068   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     3069   DO:
     3070     APPLY "END-ERROR":U TO SELF.
     3071   END.
     3072   ON CHOOSE OF b-chg IN FRAME Dialog-Frame
     3073   DO:
     3074   if ChangeOption = "" then dO:
     3075     run gbl/pop-up.p ( input self:handle, input yes).
     3076   end.
     3077   if ChangeOption = "" then return no-apply.
     3078   if can-do( "GDS-LIST":U, ChangeOption )  then do:
     3079     run b-chg-proc in this-procedure no-error.
     3080     ChangeOption = "".
     3081   end.
     3082   else do:
     3083     if (not from-card and not from-parts) then
     3084     run ChangeOption-Proc in this-procedure no-error.
     3085     else do:
     3086       CASE ChangeOption:
     3087           when "DeadValue":U then do:
     3088               run DeadValue-proc in this-procedure no-error.
     3089           end.
     3090           when "WeightValue":U then do:
     3091               run WeightValue-proc in this-procedure no-error.
     3092           end.
     3093           when "DeadValuelist":U OR when "WeightValueList":U then do:
     3094               run b-chg-proc in this-procedure no-error.
     3095               ChangeOption = "".
     3096           end.
     3097       END CASE.
     3098     end.
     3099   end.
     3100   run ChangeOption-Proc in this-procedure no-error.
     3101   END.
     3102   ON CHOOSE OF b-hist IN FRAME Dialog-Frame
     3103   DO:
     3104   define variable rid-list as character no-undo .
     3105   if available X_scales-gds THEN
     3106   run ref/cscalgds.w (
     3107                         input parparentproc
     3108                       , INPUT "":U
     3109                       , INPUT "one":U
     3110                       , OUTPUT  rid-list
     3111                       , INPUT X_scales-gds.db-num
     3112                       , input X_scales-gds.scales-num
     3113                       , input X_scales-gds.plu-code
     3114                       ).
     3115   if db-mode = "self" then do:
     3116     apply "entry" to br-lst.
     3117   end.
     3118   else do:
     3119     apply "entry" to br-lst-db.
     3120   end.
     3121   END.
     3122   ON CHOOSE OF b-mark IN FRAME Dialog-Frame
     3123   DO:
     3124   define variable glog as logical no-undo .
     3125    if available X_scales-gds then  do:
     3126   define variable vss-include-info61 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3127   define variable v-str-recid62 as character no-undo .
     3128   define variable v-num-entry62 as integer   no-undo .
     3129   assign
     3130     v-str-recid62 = trim( string( recid( X_scales-gds ) , "->>>>>>>>>>>9":U ) )
     3131     v-num-entry62 = lookup( v-str-recid62 , rid-list )
     3132   .
     3133   if v-num-entry62 > 0 then do:
     3134     assign
     3135       entry( v-num-entry62, rid-list ) = "":U
     3136       rid-list = trim( replace( rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     3137     .
     3138   end.
     3139   else do:
     3140     assign
     3141       rid-list = rid-list + ( if rid-list = "":U then "":U else chr(44) ) + v-str-recid62
     3142     .
     3143   end.
     3144       IF db-mode = "self" THEN DO:
     3145           glog = br-lst:refresh() .
     3146           if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
     3147                   glog = br-lst:select-next-row ().
     3148                   apply "iteration-changed" to br-lst in frame Dialog-Frame.
     3149           end.
     3150           if num-entries( rid-list ) = 0 then
     3151               hide mark-num in frame Dialog-Frame.
     3152           else
     3153               disp num-entries( rid-list ) @ mark-num with frame Dialog-Frame.
     3154           apply "entry" to br-lst in frame Dialog-Frame.
     3155       END.
     3156       ELSE DO:
     3157           glog = br-lst-db:refresh() .
     3158           if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
     3159                   glog = br-lst-db:select-next-row ().
     3160                   apply "iteration-changed" to br-lst-db in frame Dialog-Frame.
     3161           end.
     3162           if num-entries( rid-list ) = 0 then
     3163               hide mark-num in frame Dialog-Frame.
     3164           else
     3165               disp num-entries( rid-list ) @ mark-num with frame Dialog-Frame.
     3166           apply "entry" to br-lst-db in frame Dialog-Frame.
     3167       END.
     3168   end.
     3169   END.
     3170   ON CHOOSE OF b-sel IN FRAME Dialog-Frame
     3171   DO:
     3172     if ( available X_scales-gds ) then do:
     3173       if  ( rid-list = "" ) or b-mark:sensitive = no
     3174       then
     3175       assign
     3176       rid-list = string( recid( X_scales-gds ) ).
     3177       p-rid-list = rid-list.
     3178     end.
     3179   END.
     3180   ON CHOOSE OF B-send IN FRAME Dialog-Frame
     3181   DO:
     3182   define variable glog as logical no-undo .
     3183   define variable rep-rec as recid no-undo .
     3184   define variable object-option as character no-undo .
     3185   define variable choice as integer no-undo .
     3186   if SendOption = "" then
     3187   run gbl/pop-up.p ( input self:handle, input yes) no-error.
     3188   if SendOption = "" then return no-apply.
     3189   rep-rec = recid(X_scales-gds).
     3190   if locked_scales.master > 0 then do:
     3191     message
     3192     "Пересылка товаров на подчиненные весы осуществляется при пересылке товаров на главные весы"
     3193     view-as alert-box.
     3194     SendOption = "".
     3195     return no-apply.
     3196   end.
     3197   define variable vss-include-info63 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3198   do:
     3199     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     3200       (input  v-cntxt-db-num
     3201       ,input  v-cntxt-userid
     3202       ,input  0
     3203       ,input  'actn_scales_sending':U
     3204       ,input  'global':U
     3205       ,input  0
     3206       ,input  '':U
     3207       ,input  0
     3208       ,input  0
     3209       ,input  0
     3210       ,input  0
     3211       ,input  true
     3212       ,output glog
     3213       )  .
     3214   end.
     3215   if NOT glog then do:
     3216       SendOption = "".
     3217       return no-apply.
     3218   end.
     3219   glog = yes.
     3220   if sendoption = "current" then do:
     3221     OBJECT-option = 'текущие':U.
     3222   end.
     3223   else do:
     3224   define variable vss-include-info64 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3225   do:
     3226     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     3227       (input  v-cntxt-db-num
     3228       ,input  v-cntxt-userid
     3229       ,input  0
     3230       ,input  'actn_scales_another_obj':U
     3231       ,input  'global':U
     3232       ,input  0
     3233       ,input  '':U
     3234       ,input  0
     3235       ,input  0
     3236       ,input  0
     3237       ,input  0
     3238       ,input  false
     3239       ,output glog
     3240       )  .
     3241   end.
     3242     if not glog then do :
     3243       run gbl/d-askw.w (
     3244                   input "Выбор типа пересылки товаров"
     3245                   ,input substitute("Выберите товары на весах на весы №&1 &2 для пересылки"
     3246                                     ,locked_scales.scales-num
     3247                                     ,locked_scales.scales-name
     3248                                     )
     3249                   ,input "|"
     3250                   ,input substitute("&1&2|Отказ"
     3251                                     , p-obj-type
     3252                                     , p-obj-code)
     3253                   ,input "По текущему объекту|Отказ от пересылки"
     3254                   ,input 1
     3255                   ,input 2
     3256                   ,output choice).
     3257       if choice = 2 then do:
     3258         assign
     3259         sendoption = '':U.
     3260         return no-apply.
     3261       end.
     3262       IF choice = 1 THEN OBJECT-option = 'текущие':U.
     3263     end.
     3264     else do :
     3265       run gbl/d-askw.w (
     3266                   input "Выбор типа пересылки товаров"
     3267                   ,input substitute("Выберите товары на весах на весы №&1 &2 для пересылки"
     3268                                     ,locked_scales.scales-num
     3269                                     ,locked_scales.scales-name
     3270                                     )
     3271                   ,input "|"
     3272                   ,input substitute("&1&2|Все|Отказ"
     3273                                     , p-obj-type
     3274                                     , p-obj-code)
     3275                   ,input "По текущему объекту|Полный список|Отказ от пересылки"
     3276                   ,input 1
     3277                   ,input 3
     3278                   ,output choice).
     3279       if choice = 3 then do:
     3280         assign
     3281         sendoption = '':U.
     3282         return no-apply.
     3283       end.
     3284       IF choice = 1 THEN OBJECT-option = 'текущие':U.
     3285       IF choice = 2 THEN OBJECT-option = 'все':U.
     3286     end.
     3287   end.
     3288   run str/diallog.w (
     3289         input parparentproc
     3290       , input this-procedure
     3291       , input "ref/sendscal.p":U
     3292       , input (p-obj-type + chr(4) + string(p-obj-code) + chr(4) + string(recid(locked_scales)) + chr(4) +
     3293                 sendoption + chr(4) + send-rid-list + chr(4) + object-option + chr(4) +
     3294                 string(0))
     3295       , input no
     3296       , input "":U
     3297       , input substitute("Отсылка данных на весы")
     3298   ) no-error.
     3299   if error-status:error then do:
     3300       Sendoption = "".
     3301       return no-apply.
     3302   end.
     3303   SendOption = "".
     3304   RUN OpenBr in this-procedure .
     3305   reposition br-lst to recid rep-rec no-error.
     3306   END.
     3307   ON CHOOSE OF b-ticket IN FRAME Dialog-Frame
     3308   DO:
     3309     if available X_scales-gds then  do:
     3310       if rid-list = "" then do:
     3311             run rep/tick-scl.p (
     3312                             input parparentproc
     3313                           ,input p-obj-type
     3314                           ,input p-obj-code
     3315                           ,input recid( X_bar-code )
     3316                           ,input X_scales-gds.db-num
     3317                           ,input X_scales-gds.scales-num
     3318                           ,input "" ) .
     3319       end.
     3320       else do:
     3321         run rep/tick-scl.p (
     3322                         input parparentproc
     3323                       ,input p-obj-type
     3324                       ,input p-obj-code
     3325                       ,input ?
     3326                       ,input X_scales-gds.db-num
     3327                       ,input ?
     3328                       ,input rid-list ) .
     3329       end.
     3330       rid-list = "" .
     3331       RUN OpenBr  in this-procedure .
     3332     end.
     3333     if db-mode = "self" then do:
     3334       apply "entry" to br-lst in frame Dialog-Frame.
     3335     end.
     3336     else do:
     3337       apply "entry" to br-lst-db in frame Dialog-Frame.
     3338     end.
     3339   END.
     3340   ON INSERT OF br-lst IN FRAME Dialog-Frame
     3341   DO:
     3342       apply "CHOOSE" to b-mark in frame Dialog-Frame .
     3343   END.
     3344   ON MOUSE-SELECT-DBLCLICK OF br-lst IN FRAME Dialog-Frame
     3345   OR RETURN OF br-lst DO:
     3346   define variable v-gds-rec as recid no-undo .
     3347   if available X_scales-gds then  do:
     3348     v-gds-rec = recid(X_goods).
     3349     run ref/gds-form.w (
     3350                         input parparentproc
     3351                       , input 'ПРОСМОТР':U
     3352                       , input X_scales-gds.obj-type
     3353                       , input X_scales-gds.obj-code
     3354                       , input this-procedure:handle
     3355                       , input-output v-gds-rec).
     3356   end.
     3357   apply "entry" to br-lst in frame Dialog-Frame .
     3358   END.
     3359   ON RETURN OF br-lst IN FRAME Dialog-Frame
     3360   DO:
     3361   define variable v-gds-rec as recid no-undo .
     3362   if available X_scales-gds then do:
     3363     v-gds-rec = recid(X_goods).
     3364     run ref/gds-form.w (
     3365                         input parparentproc
     3366                       , input 'ПРОСМОТР':U
     3367                       , input X_scales-gds.obj-type
     3368                       , input X_scales-gds.obj-code
     3369                       , input this-procedure:handle
     3370                       , input-output v-gds-rec).
     3371   end.
     3372    apply "entry" to br-lst in frame Dialog-Frame .
     3373   END.
     3374   ON INSERT OF br-lst-db IN FRAME Dialog-Frame
     3375   DO:
     3376       apply "CHOOSE" to b-mark in frame Dialog-Frame .
     3377   END.
     3378   ON MOUSE-SELECT-DBLCLICK OF br-lst-db IN FRAME Dialog-Frame
     3379   OR RETURN OF br-lst-db DO:
     3380   define variable v-gds-rec as recid no-undo .
     3381   if available X_scales-gds then  do:
     3382     v-gds-rec = recid(X_goods).
     3383     run ref/gds-form.w (
     3384                         input parparentproc
     3385                       , input 'ПРОСМОТР':U
     3386                       , input X_scales-gds.obj-type
     3387                       , input X_scales-gds.obj-code
     3388                       , input this-procedure:handle
     3389                       , input-output v-gds-rec).
     3390   end.
     3391   apply "entry" to br-lst-db in frame Dialog-Frame .
     3392   END.
     3393   ON ESCAPE OF DeadValue IN FRAME Dialog-Frame
     3394   DO:
     3395       ChangeOption = "".
     3396       run ChangeOption-Proc.
     3397   END.
     3398   ON LEAVE OF DeadValue IN FRAME Dialog-Frame
     3399   DO:
     3400     if DeadvalueRs = integer('0':U) then
     3401     APPLY "RETURN" to DeadValue.
     3402   END.
     3403   ON RETURN OF DeadValue IN FRAME Dialog-Frame
     3404   DO:
     3405       assign
     3406       DeadValue
     3407       DeadValueDate
     3408       .
     3409       CAse deadValueRS:
     3410         when integer('0':U) then do:
     3411         end.
     3412         when integer('1':U) then do:
     3413           assign
     3414           Deadvalue = DeadValueDAte - today
     3415           .
     3416           if DeadValue < 0 then do:
     3417             message
     3418             "Неверный срок годности"
     3419             view-as alert-box error .
     3420             APPLY "ENTRY" to DeadValueDate.
     3421             return no-apply.
     3422           end.
     3423           display
     3424           deadvalue
     3425           with frame Dialog-Frame.
     3426         end.
     3427       END CASE.
     3428       run deadvalue-proc in this-procedure no-error.
     3429       if error-status:error then do:
     3430           ChangeOption = "".
     3431           return no-apply.
     3432       end.
     3433       run ChangeOption-Proc no-error.
     3434   END.
     3435   ON LEAVE OF DeadValueDate IN FRAME Dialog-Frame
     3436   DO:
     3437     if DeadvalueRs = integer('1':U) then
     3438     APPLY "RETURN" to DeadValue.
     3439   END.
     3440   ON RETURN OF DeadValueDate IN FRAME Dialog-Frame
     3441   DO:
     3442     APPLY "RETURN" to Deadvalue.
     3443   END.
     3444   ON VALUE-CHANGED OF DeadValueRS IN FRAME Dialog-Frame
     3445   DO:
     3446     assign
     3447     DeadValueRS.
     3448     CASE DeadValueRS:
     3449       when integer('0':U) then do:
     3450         DISABLE
     3451         DeadValueDAte
     3452         with frame Dialog-Frame.
     3453         Enable
     3454         DeadValue
     3455         with frame Dialog-Frame.
     3456       end.
     3457       when integer('1':U) then do:
     3458         DISABLE
     3459         DeadValue
     3460         with frame Dialog-Frame.
     3461         Enable
     3462         DeadValueDate
     3463         with frame Dialog-Frame.
     3464       end.
     3465     END CASE.
     3466   END.
     3467   ON MENU-DROP OF MENU MENU-b-chg
     3468   DO:
     3469     ChangeOption = "".
     3470   END.
     3471   ON MENU-DROP OF MENU MENU-b-price
     3472   DO:
     3473     PrintOption = "".
     3474   END.
     3475   ON MENU-DROP OF MENU MENU-B-send
     3476   DO:
     3477     assign
     3478     SendOption = ""
     3479     send-rid-list  = '':U
     3480     .
     3481   END.
     3482   ON CHOOSE OF MENU-ITEM m_DeadValue
     3483   DO:
     3484     if avail X_scales-gds and X_scales-gds.to-del = yes then do:
     3485       BELL.
     3486       return no-apply.
     3487     end.
     3488     assign
     3489     ChangeOption = "DeadValue":U.
     3490     APPLY "CHOOSE" to b-chg in frame Dialog-Frame.
     3491   END.
     3492   ON CHOOSE OF MENU-ITEM m_DeadValueList
     3493   DO:
     3494     assign
     3495     ChangeOption = "DeadValueList":U.
     3496     APPLY "CHOOSE" to b-chg in frame Dialog-Frame.
     3497   END.
     3498   ON VALUE-CHANGED OF MENU-ITEM m_from-card
     3499   DO:
     3500   if avail X_scales-gds
     3501   and X_scales-gds.to-del = yes
     3502   then do:
     3503       BELL.
     3504       return no-apply.
     3505   end.
     3506     from-card = not from-card.
     3507     if from-card then do:
     3508         CASE ChangeOption:
     3509             when "DeadValue" then do:
     3510                 deadValue =  X_goods.deadline.
     3511                 display deadvalue with frame Dialog-Frame.
     3512             end.
     3513             when "DeadValueList" then do:
     3514                 deadValue = ?.
     3515                 display deadvalue with frame Dialog-Frame.
     3516             end.
     3517             when "WeightValue" then do:
     3518                 WeightValue = X_goods.wt-cart.
     3519                 display Weightvalue with frame Dialog-Frame.
     3520             end.
     3521             when "WeightValueList" then do:
     3522                 WeightValue = ?.
     3523                 display Weightvalue with frame Dialog-Frame.
     3524             end.
     3525         END CASE.
     3526     end.
     3527     else do:
     3528     end.
     3529   END.
     3530   ON VALUE-CHANGED OF MENU-ITEM m_from-parts
     3531   DO:
     3532     if avail X_scales-gds and X_scales-gds.to-del = yes then do:
     3533       BELL.
     3534       return no-apply.
     3535     end.
     3536     from-parts = not from-parts.
     3537     if from-parts then do:
     3538       CASE ChangeOption:
     3539         when "DeadValue" then do:
     3540           assign
     3541           deadvalue =  scl-gds-ld-parts ( buffer X_scales-gds , input sclin-ld ).
     3542           display deadvalue with frame Dialog-Frame.
     3543         end.
     3544         when "DeadValueList" then do:
     3545           deadValue = ?.
     3546           display deadvalue with frame Dialog-Frame.
     3547         end.
     3548       END CASE.
     3549     end.
     3550     else do:
     3551     end.
     3552   END.
     3553   ON CHOOSE OF MENU-ITEM m_gds-list
     3554   DO:
     3555     assign
     3556     ChangeOption = "GDS-LIST":U.
     3557     APPLY "CHOOSE" to b-chg in frame Dialog-Frame.
     3558   END.
     3559   ON CHOOSE OF MENU-ITEM m_normal
     3560   DO:
     3561     assign
     3562     PrintOption = "NORMAL":U.
     3563     APPLY "CHOOSE" to PricePrint in frame Dialog-Frame.
     3564   END.
     3565   ON CHOOSE OF MENU-ITEM m_scalesman
     3566   DO:
     3567     assign
     3568     PrintOption = "scalesman":U.
     3569     APPLY "CHOOSE" to PricePrint in frame Dialog-Frame.
     3570   END.
     3571   ON CHOOSE OF MENU-ITEM m_send_all
     3572   DO:
     3573     assign
     3574     SendOption = "ALL":U
     3575     send-rid-list  = '':U
     3576     .
     3577     APPLY "CHOOSE" to b-send  in frame Dialog-Frame.
     3578   END.
     3579   ON CHOOSE OF MENU-ITEM m_send_changed
     3580   DO:
     3581     assign
     3582     SendOption = "CHANGED":U
     3583     send-rid-list  = '':U
     3584     .
     3585     APPLY "CHOOSE" to b-send  in frame Dialog-Frame.
     3586   END.
     3587   ON CHOOSE OF MENU-ITEM m_send_current
     3588   DO:
     3589     assign
     3590     SendOption = "current":U
     3591     send-rid-list = (if available X_scales-gds then string(recid(X_scales-gds)) else '':U)
     3592     .
     3593     APPLY "CHOOSE" to b-send  in frame Dialog-Frame.
     3594   END.
     3595   ON CHOOSE OF MENU-ITEM m_send_resend
     3596   DO:
     3597     assign
     3598     SendOption = "RESEND":U
     3599     send-rid-list  = '':U
     3600     .
     3601     APPLY "CHOOSE" to b-send  in frame Dialog-Frame.
     3602   END.
     3603   ON CHOOSE OF MENU-ITEM m_WeightValue
     3604   DO:
     3605     if avail X_scales-gds and X_scales-gds.to-del = yes then do:
     3606       BELL.
     3607       return no-apply.
     3608     end.
     3609     assign
     3610     ChangeOption = "WeightValue":U.
     3611     APPLY "CHOOSE" to b-chg in frame Dialog-Frame.
     3612   END.
     3613   ON CHOOSE OF MENU-ITEM m_WeightValueList
     3614   DO:
     3615     assign
     3616     ChangeOption = "WeightValueList":U.
     3617     APPLY "CHOOSE" to b-chg in frame Dialog-Frame.
     3618   END.
     3619   ON CHOOSE OF PricePrint IN FRAME Dialog-Frame
     3620   DO:
     3621   define variable g#report-num as integer no-undo .
     3622   define variable glog as logical no-undo .
     3623       if PrintOption = "" then do:
     3624           run gbl/pop-up.p (self:handle, yes) no-error .
     3625       end.
     3626       if PrintOption = "" then return no-apply.
     3627       if v-cntxt-db-num = p-db-num then do:
     3628       RUN ProcPricePrint in this-procedure ( input PrintOption
     3629                                             ,buffer locked_scales) No-ERROR.
     3630       end.
     3631       else do:
     3632         RUN ProcPricePrint-db in this-procedure ( input PrintOption
     3633                                               ,buffer locked_scales) No-ERROR.
     3634       end.
     3635       IF ERROR-status:error then do:
     3636         PrintOption = "":U.
     3637         return No-APPLY.
     3638       end.
     3639       if PrintOption = "scalesman":U then do:
     3640           run get-report-num  in parParentProc(output g#report-num).
     3641           run adecomm/_osprint.p ( INPUT  ?,
     3642                                     INPUT  string( session:temp-directory + "rpt" + string( g#report-num ) ),
     3643                                     INPUT  8,
     3644                                     INPUT  2,
     3645                                     INPUT  0,
     3646                                     INPUT  0,
     3647                                     OUTPUT glog ).
     3648       end.
     3649       else do:
     3650           run prn-lib-prn-file in this-procedure (parparentproc,  0 ) .
     3651       end.
     3652       PrintOption = "".
     3653   if db-mode = "self" then do:
     3654     apply "entry" to br-lst in frame Dialog-Frame .
     3655   end.
     3656   else do:
     3657     apply "entry" to br-lst-db in frame Dialog-Frame .
     3658   end.
     3659   END.
     3660   ON ESCAPE OF WeightValue IN FRAME Dialog-Frame
     3661   DO:
     3662       ChangeOption = "".
     3663       run ChangeOption-Proc.
     3664   END.
     3665   ON LEAVE OF WeightValue IN FRAME Dialog-Frame
     3666   DO:
     3667       APPLY "RETURN" TO WeightValue.
     3668   END.
     3669   ON RETURN OF WeightValue IN FRAME Dialog-Frame
     3670   DO:
     3671       assign WeightValue.
     3672       run Weightvalue-proc no-error.
     3673       if error-status:error then do:
     3674           ChangeOption = "".
     3675           return no-apply.
     3676       end.
     3677       run ChangeOption-Proc no-error.
     3678   END.
     3679   define variable vss-include-info65 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3680   on value-changed of a-n-c in frame Dialog-Frame do:
     3681     case input frame Dialog-Frame a-n-c :
     3682       when "art" then do:
     3683        if db-mode = "self" then do:
     3684         apply "entry" to br-lst in frame Dialog-Frame.
     3685        end.
     3686        else do:
     3687          apply "entry" to br-lst-db in frame Dialog-Frame.
     3688        end.
     3689         hide loc-name loc-code in frame Dialog-Frame.
     3690         loc-art = "".
     3691       end.
     3692       when "name" then do:
     3693         enable loc-name with frame Dialog-Frame.
     3694         disp loc-name with frame Dialog-Frame.
     3695         hide loc-art loc-code in frame Dialog-Frame.
     3696         apply "entry" to loc-name in frame Dialog-Frame.
     3697       end.
     3698       when "code" then do:
     3699         enable loc-code with frame Dialog-Frame.
     3700         loc-code:label = "Бар-код (весь)".
     3701         disp loc-code with frame Dialog-Frame.
     3702         hide loc-art loc-name in frame Dialog-Frame.
     3703         apply "entry" to loc-code in frame Dialog-Frame.
     3704       end.
     3705       when "ves" then do:
     3706         enable loc-code with frame Dialog-Frame.
     3707         loc-code:label = "Вес. код".
     3708         disp loc-code with frame Dialog-Frame.
     3709         hide loc-art loc-name in frame Dialog-Frame.
     3710         apply "entry" to loc-code in frame Dialog-Frame.
     3711       end.
     3712       when "PLU" then do:
     3713         enable loc-code with frame Dialog-Frame.
     3714         loc-code:label = "PLU".
     3715         disp loc-code with frame Dialog-Frame.
     3716         hide loc-art loc-name in frame Dialog-Frame.
     3717         apply "entry" to loc-code in frame Dialog-Frame.
     3718       end.
     3719       when "shtrih" then do:
     3720         enable loc-code with frame Dialog-Frame.
     3721         loc-code:label = "Штрих.код".
     3722         disp loc-code with frame Dialog-Frame.
     3723         hide loc-art loc-name in frame Dialog-Frame.
     3724         apply "entry" to loc-code in frame Dialog-Frame.
     3725       end.
     3726     end.
     3727   end.
     3728   on any-printable of br-lst in frame Dialog-Frame,
     3729                       br-lst-db in frame Dialog-Frame
     3730     do:
     3731     if input frame Dialog-Frame a-n-c = "art" then do:
     3732       if last-event:label = " " and loc-art = "" then return no-apply.
     3733       if db-mode = "self" then do:
     3734         FOR EACH l-scales-gds WHERE l-scales-gds.db-num = p-db-num and l-scales-gds.scales-num = scalenum NO-LOCK ,
     3735                             FIRST l-bar-code WHERE
     3736                                   l-bar-code.b-code = l-scales-gds.b-code NO-LOCK,
     3737                             FIRST l-goods NO-LOCK WHERE
     3738                                   l-goods.gds-code = l-bar-code.gds-code AND
     3739                                   l-goods.artic begins (loc-art + last-event:label),
     3740                             FIRST l-gds-obj-attr WHERE
     3741                                   l-gds-obj-attr.gds-code = l-bar-code.gds-code AND
     3742                                   l-gds-obj-attr.attr-code = 'scales-code':U No-LOCK,
     3743                             FIRST l-prod-bc WHERE
     3744                                   l-prod-bc.b-str = l-gds-obj-attr.attr-value NO-LOCK
     3745                           BY l-scales-gds.db-num
     3746                           BY l-scales-gds.scales-num
     3747                           BY l-scales-gds.plu-code:
     3748                           LEAVE.
     3749         END.
     3750       end.
     3751       else do:
     3752         FOR EACH l-scales-gds WHERE l-scales-gds.db-num = p-db-num and l-scales-gds.scales-num = scalenum NO-LOCK ,
     3753                             FIRST l-bar-code WHERE
     3754                                   l-bar-code.b-code = l-scales-gds.b-code NO-LOCK,
     3755                             FIRST l-goods NO-LOCK WHERE
     3756                                   l-goods.gds-code = l-bar-code.gds-code AND
     3757                                   l-goods.artic begins (loc-art + last-event:label),
     3758                             FIRST l-gds-obj-attr WHERE
     3759                                   l-gds-obj-attr.gds-code = l-bar-code.gds-code AND
     3760               l-gds-obj-attr.attr-code = 'scales-code':U No-LOCK
     3761                           BY l-scales-gds.db-num
     3762                           BY l-scales-gds.scales-num
     3763                           BY l-scales-gds.plu-code:
     3764             find  FIRST l-prod-bc-db no-lock WHERE
     3765                   l-prod-bc-db.b-str = l-gds-obj-attr.attr-value
     3766               and l-prod-bc-db.db-num = l-scales-gds.db-num no-error.
     3767           if not available l-prod-bc-db then do:
     3768             find first l-prod-bc no-lock where
     3769                       l-prod-bc.b-code = l-bar-code.b-code
     3770                   and l-prod-bc.b-str = l-gds-obj-attr.attr-value no-error.
     3771             if not available l-prod-bc then next.
     3772           end.
     3773                           LEAVE.
     3774         END.
     3775       end.
     3776       if avail l-scales-gds then do:
     3777         loc-art = loc-art + last-event:label.
     3778         disp loc-art with frame Dialog-Frame.
     3779         line-rec = recid (l-scales-gds).
     3780         if db-mode = "self" then do:
     3781         reposition br-lst to recid line-rec no-error.
     3782         end.
     3783         else do:
     3784           reposition br-lst-db to recid line-rec no-error.
     3785         end.
     3786       end.
     3787       else do:
     3788         bell.
     3789       end.
     3790     end.
     3791   end.
     3792   on backspace of br-lst in frame Dialog-Frame,
     3793                   br-lst-db in frame Dialog-Frame
     3794   do:
     3795     if input frame Dialog-Frame a-n-c = "art" then do:
     3796       if loc-art = "" then return no-apply.
     3797       loc-art = substr (loc-art, 1, length (loc-art) - 1).
     3798       if db-mode = "self" then do:
     3799         FOR EACH l-scales-gds WHERE l-scales-gds.db-num = p-db-num and l-scales-gds.scales-num = scalenum NO-LOCK,
     3800                             FIRST l-bar-code WHERE
     3801                                   l-bar-code.b-code = l-scales-gds.b-code NO-LOCK,
     3802                             FIRST l-goods WHERE
     3803                                   l-goods.gds-code = l-bar-code.gds-code AND
     3804                                   l-goods.artic begins loc-art NO-LOCK,
     3805                             FIRST l-gds-obj-attr WHERE
     3806                                   l-gds-obj-attr.gds-code = l-bar-code.gds-code AND
     3807                                   l-gds-obj-attr.attr-code = 'scales-code':U No-LOCK,
     3808                             FIRST l-prod-bc WHERE
     3809                                   l-prod-bc.b-str = l-gds-obj-attr.attr-value NO-LOCK
     3810                           BY l-scales-gds.db-num
     3811                           BY l-scales-gds.scales-num
     3812                           BY l-scales-gds.plu-code:
     3813                           LEAVE.
     3814         END.
     3815       end.
     3816       else do:
     3817         FOR EACH l-scales-gds WHERE l-scales-gds.db-num = p-db-num and l-scales-gds.scales-num = scalenum NO-LOCK,
     3818                             FIRST l-bar-code WHERE
     3819                                   l-bar-code.b-code = l-scales-gds.b-code NO-LOCK,
     3820                             FIRST l-goods WHERE
     3821                                   l-goods.gds-code = l-bar-code.gds-code AND
     3822                                   l-goods.artic begins loc-art NO-LOCK,
     3823                             FIRST l-gds-obj-attr WHERE
     3824                                   l-gds-obj-attr.gds-code = l-bar-code.gds-code AND
     3825                                   l-gds-obj-attr.attr-code = 'scales-code':U No-LOCK
     3826                           BY l-scales-gds.db-num
     3827                           BY l-scales-gds.scales-num
     3828                           BY l-scales-gds.plu-code:
     3829           find  FIRST l-prod-bc-db no-lock WHERE
     3830                 l-prod-bc-db.b-str = l-gds-obj-attr.attr-value
     3831             and l-prod-bc-db.db-num = l-scales-gds.db-num no-error.
     3832           if not available l-prod-bc-db then do:
     3833             find first l-prod-bc no-lock where
     3834                       l-prod-bc.b-code = l-bar-code.b-code
     3835                   and l-prod-bc.b-str = l-gds-obj-attr.attr-value no-error.
     3836             if not available l-prod-bc then next.
     3837           end.
     3838                           LEAVE.
     3839         END.
     3840       end.
     3841       display
     3842       loc-art with frame Dialog-Frame.
     3843       line-rec = recid (l-scales-gds).
     3844       if db-mode = "self" then do:
     3845       reposition br-lst to recid line-rec no-error.
     3846       end.
     3847       else do:
     3848         reposition br-lst-db to recid line-rec no-error.
     3849       end.
     3850     end.
     3851   end.
     3852   ON MOUSE-SELECT-DBLCLICK, return OF loc-code IN FRAME Dialog-Frame do:
     3853   define variable str-code    as integer           no-undo.
     3854   define variable r-bar-code  like ub.bar-code.b-code no-undo.
     3855   define variable varresult   as character         no-undo.
     3856   define variable vartype-bc  as character         no-undo.
     3857   define variable varweight   as decimal           no-undo.
     3858     assign loc-code a-n-c.
     3859     case a-n-c:
     3860       when "code" or when "shtrih"  then do:
     3861   if (valid-handle(g#libbcrcn) <> true) then do:   run str/libbcrcn.p persistent no-error .   if error-status :error or (valid-handle(g#libbcrcn) <> true) then do:     message       "Error starting libbcrcn.p" skip       g#libbcrcn skip       g#libbcrcn :type skip       g#libbcrcn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run libbcrcn_bc-rcnz in g#libbcrcn
     3862   (
     3863    input  parparentproc
     3864   ,input  loc-code
     3865   ,input  ?
     3866   ,input  p-obj-type
     3867   ,input  p-obj-code
     3868   ,input  yes
     3869   ,input  no
     3870   ,input  varscales-pref
     3871   ,input  varpgscales-pref
     3872   ,output varresult
     3873   ,output vartype-bc
     3874   ,output varweight
     3875   ,buffer l-bar-code
     3876   ,buffer ub.prod-bc
     3877   ,buffer ub.place
     3878   ) no-error.
     3879        if error-status:error then do:
     3880          message "Ошибка при разборе бар-кода".
     3881          return no-apply.
     3882        end.
     3883        IF AVAIl l-bar-code then do:
     3884   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     3885     (input  l-bar-code.gds-code
     3886     ,input  ?
     3887     ,output r-bar-code
     3888     ) no-error .
     3889           if error-status:error then do:
     3890              message "Бар-код не найден.".
     3891             return no-apply.
     3892           end.
     3893           if db-mode = "self" then do:
     3894             FOR EACH l-scales-gds WHERE l-scales-gds.db-num = p-db-num and l-scales-gds.scales-num = scalenum NO-LOCK,
     3895                 FIRST l-bar-code WHERE
     3896                       l-bar-code.b-code = l-scales-gds.b-code AND
     3897                       l-bar-code.b-code = integer (r-bar-code) NO-LOCK,
     3898                 FIRST l-gds-obj-attr WHERE
     3899                       l-gds-obj-attr.gds-code = l-bar-code.gds-code AND
     3900                       l-gds-obj-attr.attr-code = 'scales-code':U No-LOCK,
     3901                 FIRST l-prod-bc WHERE
     3902                       l-prod-bc.b-str = l-gds-obj-attr.attr-value NO-LOCK
     3903                 BY l-scales-gds.db-num
     3904                 BY l-scales-gds.scales-num
     3905                 BY l-scales-gds.plu-code:
     3906                 LEAVE.
     3907            END.
     3908          end.
     3909          else do:
     3910             FOR EACH l-scales-gds WHERE l-scales-gds.db-num = p-db-num and l-scales-gds.scales-num = scalenum NO-LOCK,
     3911                 FIRST l-bar-code WHERE
     3912                       l-bar-code.b-code = l-scales-gds.b-code AND
     3913                       l-bar-code.b-code = integer (r-bar-code) NO-LOCK,
     3914                 FIRST l-gds-obj-attr WHERE
     3915                       l-gds-obj-attr.gds-code = l-bar-code.gds-code AND
     3916                       l-gds-obj-attr.attr-code = 'scales-code':U No-LOCK
     3917                 BY l-scales-gds.db-num
     3918                 BY l-scales-gds.scales-num
     3919                 BY l-scales-gds.plu-code:
     3920             find  FIRST l-prod-bc-db no-lock WHERE
     3921                   l-prod-bc-db.b-str = l-gds-obj-attr.attr-value
     3922               and l-prod-bc-db.db-num = l-scales-gds.db-num no-error.
     3923             if not available l-prod-bc-db then do:
     3924               find first l-prod-bc no-lock where
     3925                         l-prod-bc.b-code = l-bar-code.b-code
     3926                     and l-prod-bc.b-str = l-gds-obj-attr.attr-value no-error.
     3927               if not available l-prod-bc then next.
     3928             end.
     3929                 LEAVE.
     3930            END.
     3931          end.
     3932          if avail l-scales-gds then do:
     3933            line-rec = recid (l-scales-gds).
     3934            if db-mode = "self" then do:
     3935            reposition br-lst to recid line-rec no-error.
     3936            end.
     3937            else do:
     3938              reposition br-lst-db to recid line-rec no-error.
     3939            end.
     3940           end.
     3941           else do:
     3942             message "Строка не найдена.".
     3943           end.
     3944         end.
     3945         else DO:
     3946            message "Бар-код не найден.".
     3947         end.
     3948       end.
     3949       when "ves" then do:
     3950         if db-mode = "self" then do:
     3951           FIND FIRST l-prod-bc WHERE l-prod-bc.b-str = string(integer(loc-code), "99999") NO-LOCK No-ERROR.
     3952           IF AVAIl l-prod-bc then do:
     3953               FOR EACH l-scales-gds WHERE l-scales-gds.db-num = p-db-num and l-scales-gds.scales-num = scalenum NO-LOCK,
     3954                               FIRST l-prod-bc WHERE
     3955                                     l-prod-bc.b-code = l-scales-gds.b-code AND
     3956                                     l-prod-bc.bc-on = TRUE AND
     3957                                     l-prod-bc.b-str = string(integer(loc-code), "99999") NO-LOCK,
     3958                               FIRST l-bar-code WHERE
     3959                                     l-bar-code.b-code = l-scales-gds.b-code NO-LOCK,
     3960                               FIRST l-goods WHERE
     3961                                     l-goods.gds-code = l-bar-code.gds-code NO-LOCK
     3962                             BY l-scales-gds.db-num
     3963                             BY l-scales-gds.scales-num
     3964                             BY l-scales-gds.plu-code:
     3965                   LEAVE.
     3966           END.
     3967           if avail l-scales-gds then do:
     3968               line-rec = recid (l-scales-gds).
     3969               if db-mode = "self" then do:
     3970               reposition br-lst to recid line-rec no-error.
     3971               end.
     3972               else do:
     3973                 reposition br-lst-db to recid line-rec no-error.
     3974               end.
     3975             end.
     3976             else message "Строка не найдена.".
     3977           end.
     3978           else do:
     3979             message "Весовой код не найден.".
     3980           end.
     3981         end.
     3982         else do:
     3983           FIND FIRST l-prod-bc-db WHERE
     3984                  l-prod-bc-db.b-str = string(integer(loc-code), "99999")
     3985              and l-prod-bc-db.db-num = p-db-num  NO-LOCK No-ERROR.
     3986           IF AVAIl l-prod-bc-db then do:
     3987               FOR EACH l-scales-gds WHERE l-scales-gds.db-num = p-db-num and l-scales-gds.scales-num = scalenum NO-LOCK,
     3988                               FIRST l-prod-bc-db WHERE
     3989                                     l-prod-bc-db.b-code = l-scales-gds.b-code AND
     3990                                     l-prod-bc-db.bc-on = TRUE AND
     3991                                     l-prod-bc-db.b-str = string(integer(loc-code), "99999")
     3992                                     and l-prod-bc-db.db-num = l-scales-gds.db-num
     3993                                     NO-LOCK,
     3994                               FIRST l-bar-code WHERE
     3995                                     l-bar-code.b-code = l-scales-gds.b-code NO-LOCK,
     3996                               FIRST l-goods WHERE
     3997                                     l-goods.gds-code = l-bar-code.gds-code NO-LOCK
     3998                             BY l-scales-gds.db-num
     3999                             BY l-scales-gds.scales-num
     4000                             BY l-scales-gds.plu-code:
     4001                   LEAVE.
     4002             END.
     4003             if avail l-scales-gds then do:
     4004                 line-rec = recid (l-scales-gds).
     4005                 if db-mode = "self" then do:
     4006                 reposition br-lst to recid line-rec no-error.
     4007                 end.
     4008                 else do:
     4009                   reposition br-lst-db to recid line-rec no-error.
     4010                 end.
     4011             end.
     4012             else do:
     4013               message "Строка не найдена.".
     4014             end.
     4015           end.
     4016           else do:
     4017             find first l-prod-bc where
     4018                  l-prod-bc.b-str = string(integer(loc-code), "99999")  NO-LOCK No-ERROR.
     4019             if available l-prod-bc then do:
     4020               FOR EACH l-scales-gds WHERE l-scales-gds.db-num = p-db-num and l-scales-gds.scales-num = scalenum NO-LOCK,
     4021               FIRST l-prod-bc WHERE
     4022                     l-prod-bc.b-code = l-scales-gds.b-code AND
     4023                     l-prod-bc.bc-on = TRUE AND
     4024                     l-prod-bc.b-str = string(integer(loc-code), "99999")
     4025                     NO-LOCK,
     4026               FIRST l-bar-code WHERE
     4027                     l-bar-code.b-code = l-scales-gds.b-code NO-LOCK,
     4028               FIRST l-goods WHERE
     4029                     l-goods.gds-code = l-bar-code.gds-code NO-LOCK
     4030               BY l-scales-gds.db-num
     4031               BY l-scales-gds.scales-num
     4032               BY l-scales-gds.plu-code:
     4033                 LEAVE.
     4034               END.
     4035               if avail l-scales-gds then do:
     4036                   line-rec = recid (l-scales-gds).
     4037                   if db-mode = "self" then do:
     4038                   reposition br-lst to recid line-rec no-error.
     4039                   end.
     4040                   else do:
     4041                     reposition br-lst-db to recid line-rec no-error.
     4042                   end.
     4043               end.
     4044             end.
     4045             else do:
     4046               message "Весовой код не найден.".
     4047           end.
     4048           end.
     4049         end.
     4050       end.
     4051       when "PLU" then do:
     4052         FIND FIRST l-scales-gds WHERE
     4053                  l-scales-gds.db-num = p-db-num and l-scales-gds.scales-num = scalenum
     4054              AND l-scales-gds.plu-code = integer(loc-code) NO-LOCK No-ERROR.
     4055        IF AVAIl l-scales-gds then do:
     4056           line-rec = recid (l-scales-gds).
     4057           if db-mode = "self" then do:
     4058           reposition br-lst to recid line-rec no-error.
     4059           end.
     4060           else do:
     4061             reposition br-lst-db to recid line-rec no-error.
     4062           end.
     4063        end.
     4064        else message "PLU не найден.".
     4065       end.
     4066     end case.
     4067     apply "entry" to loc-code in frame Dialog-Frame.
     4068     return no-apply.
     4069   end.
     4070   ON MOUSE-SELECT-DBLCLICK, return, Ctrl-J OF loc-name IN FRAME Dialog-Frame do:
     4071     assign loc-name.
     4072     if last-event:label = "Ctrl-J" then do:
     4073      if db-mode = "self" then do:
     4074         FOR EACH l-scales-gds WHERE
     4075                 ((l-scales-gds.db-num = current-db-num AND  l-scales-gds.scales-num = current-scales AND l-scales-gds.b-code > current-b-code ) OR
     4076                   l-scales-gds.scales-num > current-scales)
     4077                                                         NO-LOCK,
     4078                             FIRST l-bar-code WHERE
     4079                                   l-bar-code.b-code = l-scales-gds.b-code NO-LOCK,
     4080                             FIRST l-goods WHERE
     4081                                   l-goods.gds-code = l-bar-code.gds-code AND
     4082                                   l-goods.gds-name begins loc-name NO-LOCK,
     4083                             FIRST l-gds-obj-attr WHERE
     4084                                   l-gds-obj-attr.gds-code = l-bar-code.gds-code AND
     4085                                   l-gds-obj-attr.attr-code = 'scales-code':U No-LOCK,
     4086                             FIRST l-prod-bc WHERE
     4087                                   l-prod-bc.b-str = l-gds-obj-attr.attr-value NO-LOCK
     4088                           BY l-scales-gds.db-num
     4089                           BY l-scales-gds.scales-num
     4090                           BY l-scales-gds.plu-code:
     4091                           LEAVE.
     4092         END.
     4093      end.
     4094      else do:
     4095         FOR EACH l-scales-gds WHERE
     4096                 ((l-scales-gds.db-num = current-db-num AND  l-scales-gds.scales-num = current-scales AND l-scales-gds.b-code > current-b-code ) OR
     4097                   l-scales-gds.scales-num > current-scales) NO-LOCK,
     4098                             FIRST l-bar-code WHERE
     4099                                   l-bar-code.b-code = l-scales-gds.b-code NO-LOCK,
     4100                             FIRST l-goods WHERE
     4101                                   l-goods.gds-code = l-bar-code.gds-code AND
     4102                                   l-goods.gds-name begins loc-name NO-LOCK,
     4103                             FIRST l-gds-obj-attr WHERE
     4104                                   l-gds-obj-attr.gds-code = l-bar-code.gds-code AND
     4105               l-gds-obj-attr.attr-code = 'scales-code':U No-LOCK
     4106         BY l-scales-gds.db-num
     4107         BY l-scales-gds.scales-num
     4108         BY l-scales-gds.plu-code:
     4109          find FIRST l-prod-bc-db no-lock WHERE
     4110               l-prod-bc-db.b-str = l-gds-obj-attr.attr-value
     4111           and l-prod-bc-db.db-num = l-scales-gds.db-num no-error.
     4112           if not available l-prod-bc-db then do:
     4113             find first l-prod-bc no-lock where
     4114                       l-prod-bc.b-code = l-bar-code.b-code
     4115                   and l-prod-bc.b-str = l-gds-obj-attr.attr-value no-error.
     4116             if not available l-prod-bc then next.
     4117           end.
     4118           LEAVE.
     4119         END.
     4120      end.
     4121     end.
     4122     else do:
     4123       if db-mode = "self" then do:
     4124         FOR EACH l-scales-gds WHERE l-scales-gds.db-num = p-db-num and l-scales-gds.scales-num = scalenum NO-LOCK,
     4125                             FIRST l-bar-code WHERE
     4126                                   l-bar-code.b-code = l-scales-gds.b-code NO-LOCK,
     4127                             FIRST l-goods WHERE
     4128                                   l-goods.gds-code = l-bar-code.gds-code AND
     4129                                   l-goods.gds-name begins loc-name NO-LOCK,
     4130                             FIRST l-gds-obj-attr WHERE
     4131                                   l-gds-obj-attr.gds-code = l-bar-code.gds-code AND
     4132                                   l-gds-obj-attr.attr-code = 'scales-code':U No-LOCK,
     4133                             FIRST l-prod-bc WHERE
     4134                                   l-prod-bc.b-str = l-gds-obj-attr.attr-value NO-LOCK
     4135                           BY l-scales-gds.db-num
     4136                           BY l-scales-gds.scales-num
     4137                           BY l-scales-gds.plu-code:
     4138                           LEAVE.
     4139         END.
     4140       end.
     4141       else do:
     4142         FOR EACH l-scales-gds WHERE l-scales-gds.db-num = p-db-num and l-scales-gds.scales-num = scalenum NO-LOCK,
     4143                             FIRST l-bar-code WHERE
     4144                                   l-bar-code.b-code = l-scales-gds.b-code NO-LOCK,
     4145                             FIRST l-goods WHERE
     4146                                   l-goods.gds-code = l-bar-code.gds-code AND
     4147                                   l-goods.gds-name begins loc-name NO-LOCK,
     4148                             FIRST l-gds-obj-attr WHERE
     4149                                   l-gds-obj-attr.gds-code = l-bar-code.gds-code AND
     4150               l-gds-obj-attr.attr-code = 'scales-code':U No-LOCK
     4151                           BY l-scales-gds.db-num
     4152                           BY l-scales-gds.scales-num
     4153                           BY l-scales-gds.plu-code:
     4154           find FIRST l-prod-bc-db no-lock WHERE
     4155               l-prod-bc-db.b-str = l-gds-obj-attr.attr-value
     4156           and l-prod-bc-db.db-num = l-scales-gds.db-num no-error.
     4157           if not available l-prod-bc-db then do:
     4158             find first l-prod-bc no-lock where
     4159                       l-prod-bc.b-code = l-bar-code.b-code
     4160                   and l-prod-bc.b-str = l-gds-obj-attr.attr-value no-error.
     4161             if not available l-prod-bc then next.
     4162           end.
     4163                           LEAVE.
     4164         END.
     4165       end.
     4166     end.
     4167     if avail l-scales-gds then do:
     4168       assign
     4169       current-db-num = l-scales-gds.db-num
     4170       current-plu = l-scales-gds.plu-code
     4171       current-scales = l-scales-gds.scales-num
     4172       current-b-code =l-scales-gds.b-code
     4173       line-rec = recid (l-scales-gds).
     4174       if db-mode = "self" then do:
     4175       reposition br-lst to recid line-rec no-error.
     4176       end.
     4177       else do:
     4178         reposition br-lst-db to recid line-rec no-error.
     4179       end.
     4180     end.
     4181     else do:
     4182          message "Строка не найдена.".
     4183      end.
     4184     apply "entry" to loc-name in frame Dialog-Frame.
     4185     return no-apply.
     4186   end.
     4187   on iteration-changed of br-lst in frame Dialog-Frame,
     4188                           br-lst-db in frame Dialog-Frame
     4189   do:
     4190     if not avail X_scales-gds or recid (X_scales-gds) <> line-rec then do:
     4191       hide loc-art in frame Dialog-Frame.
     4192       loc-art = "".
     4193     end.
     4194   end.
     4195   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     4196   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     4197   define variable vss-include-info66 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4198   DEF VAR cur-clmn-numbr-lst as INT EXTENT 14 no-undo.
     4199   DEF VAR varmvibr-lst       as INT no-undo.
     4200   DEF VAR varmvjbr-lst       as INT no-undo.
     4201   DEF VAR varmvkbr-lst       as INT no-undo.
     4202   DEF VAR varmvlbr-lst       as INT no-undo.
     4203   DEF VAR move-elementbr-lst as INT no-undo.
     4204   def var jjbr-lst           as int no-undo.
     4205   do varmvibr-lst = 1 to EXTENT(cur-clmn-numbr-lst):
     4206     ASSIGN cur-clmn-numbr-lst[varmvibr-lst] = varmvibr-lst.
     4207   END.
     4208   RUN start-mv-clmnbr-lst.
     4209   PROCEDURE start-mv-clmnbr-lst:
     4210   def var old-session as logical no-undo.
     4211      old-session = SESSION:IMMEDIATE-DISPLAY.
     4212      IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     4213      SESSION:IMMEDIATE-DISPLAY = old-session.
     4214   END.
     4215   ON ctrl-cursor-right OF BROWSE br-lst do:
     4216     RUN re-move-clmnbr-lst ( 3, 14).
     4217   END.
     4218   ON ctrl-cursor-left OF BROWSE br-lst do:
     4219     RUN re-move-clmnbr-lst (14, 3).
     4220   END.
     4221   PROCEDURE re-move-clmnbr-lst:
     4222     DEFINE INPUT PARAMETER source-column as INTEGER NO-UNDO.
     4223     DEFINE INPUT PARAMETER target-column as INTEGER NO-UNDO.
     4224     DO varmvibr-lst = 1 TO EXTENT(cur-clmn-numbr-lst):
     4225       if cur-clmn-numbr-lst[varmvibr-lst] = source-column THEN cur-clmn-numbr-lst[varmvibr-lst] = -1.
     4226     END.
     4227     if br-lst:MOVE-COLUMN(source-column, target-column) IN FRAME Dialog-Frame then.
     4228     if source-column > target-column THEN
     4229     DO varmvjbr-lst = source-column - 1 to target-column BY -1:
     4230       DO varmvibr-lst = 1 TO EXTENT(cur-clmn-numbr-lst):
     4231           if cur-clmn-numbr-lst[varmvibr-lst] = varmvjbr-lst THEN DO:
     4232             cur-clmn-numbr-lst[varmvibr-lst] = cur-clmn-numbr-lst[varmvibr-lst] + 1.
     4233           END.
     4234       END.
     4235     END.
     4236     ELSE
     4237     DO varmvjbr-lst = source-column + 1 to target-column:
     4238       DO varmvibr-lst = 1 TO EXTENT(cur-clmn-numbr-lst):
     4239         if cur-clmn-numbr-lst[varmvibr-lst] = varmvjbr-lst THEN DO:
     4240           cur-clmn-numbr-lst[varmvibr-lst] = cur-clmn-numbr-lst[varmvibr-lst] - 1.
     4241         END.
     4242       END.
     4243     END.
     4244     DO varmvibr-lst = 1 TO EXTENT(cur-clmn-numbr-lst):
     4245       if cur-clmn-numbr-lst[varmvibr-lst] = -1 THEN cur-clmn-numbr-lst[varmvibr-lst] = target-column.
     4246     END.
     4247   END PROCEDURE.
     4248   PROCEDURE ch-clmnbr-lst:
     4249     DEFINE INPUT PARAMETER cur-clmn-loc as INTEGER NO-UNDO.
     4250     if cur-clmn-loc <= 3 then do:
     4251       return .
     4252     end.
     4253     DO varmvibr-lst = 1 TO EXTENT(cur-clmn-numbr-lst):
     4254       if cur-clmn-numbr-lst[varmvibr-lst] = cur-clmn-loc THEN move-elementbr-lst = varmvibr-lst.
     4255     END.
     4256     RUN re-move-clmnbr-lst (cur-clmn-loc, 3).
     4257   END PROCEDURE.
     4258   PROCEDURE mv-brw-defaultbr-lst:
     4259   def var old-session as logical no-undo.
     4260     old-session = SESSION:IMMEDIATE-DISPLAY.
     4261     IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     4262     do varmvlbr-lst = 3 to EXTENT(cur-clmn-numbr-lst):
     4263       RUN re-move-clmnbr-lst (cur-clmn-numbr-lst[varmvlbr-lst], varmvlbr-lst).
     4264     END.
     4265     RUN start-mv-clmnbr-lst.
     4266     SESSION:IMMEDIATE-DISPLAY = old-session.
     4267   END PROCEDURE.
     4268   .
     4269   define variable vss-include-info67 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4270   DEF VAR cur-clmn-numbr-lst-db as INT EXTENT 14 no-undo.
     4271   DEF VAR varmvibr-lst-db       as INT no-undo.
     4272   DEF VAR varmvjbr-lst-db       as INT no-undo.
     4273   DEF VAR varmvkbr-lst-db       as INT no-undo.
     4274   DEF VAR varmvlbr-lst-db       as INT no-undo.
     4275   DEF VAR move-elementbr-lst-db as INT no-undo.
     4276   def var jjbr-lst-db           as int no-undo.
     4277   do varmvibr-lst-db = 1 to EXTENT(cur-clmn-numbr-lst-db):
     4278     ASSIGN cur-clmn-numbr-lst-db[varmvibr-lst-db] = varmvibr-lst-db.
     4279   END.
     4280   RUN start-mv-clmnbr-lst-db.
     4281   PROCEDURE start-mv-clmnbr-lst-db:
     4282   def var old-session as logical no-undo.
     4283      old-session = SESSION:IMMEDIATE-DISPLAY.
     4284      IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     4285      SESSION:IMMEDIATE-DISPLAY = old-session.
     4286   END.
     4287   ON ctrl-cursor-right OF BROWSE br-lst-db do:
