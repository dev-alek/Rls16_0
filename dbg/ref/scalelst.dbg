     1314   FUNCTION scl-gds-ld returns integer ( input p-raw-dead-line as integer, input p-sclin-ld as integer):
     1315   define variable v-dead-line as integer no-undo .
     1316   define variable v-dead-line-date as integer no-undo .
     1317   DEFINE VARIABLE v-today as date no-undo .
     1318   DEFINE VARIABLE v-time as integer no-undo .
     1319   if p-sclin-ld > 0 then do:
     1320     run cur-time in this-procedure ( output v-today, output v-time).
     1321     assign
     1322     v-dead-line = p-raw-dead-line / 24  + 01/01/2000 - v-today
     1323     v-dead-line = if v-dead-line < 0 then 0 else v-dead-line
     1324     .
     1325   end.
     1326   else v-dead-line = p-raw-dead-line.
     1327   return v-dead-line .
     1328   end.
     1329   FUNCTION scl-gds-ld2 returns integer ( input p-deadline as integer
     1330                                        , input p-deaddate as date
     1331                                        , input p-deadflag as integer):
     1332   define variable v-dead-line as integer no-undo .
     1333   define variable v-dead-line-date as integer no-undo .
     1334   DEFINE VARIABLE v-today as date no-undo .
     1335   DEFINE VARIABLE v-time as integer no-undo .
     1336   if p-deadflag > 0 then do:
     1337     if p-deaddate = ? then return 0.
     1338     run cur-time in this-procedure ( output v-today, output v-time).
     1339     assign
     1340     v-dead-line = p-deaddate - v-today + 1
     1341     v-dead-line = if v-dead-line < 0 then 0 else v-dead-line
     1342     .
     1343   end.
     1344   else v-dead-line = (if p-deadline = ? then 0 else p-deadline).
     1345   return v-dead-line .
     1346   end.
     1347   FUNCTION scl-gds-ld-date returns date ( input p-raw-dead-line as integer, input p-sclin-ld as integer):
     1348   define variable v-dead-line-date as date no-undo .
     1349   DEFINE VARIABLE v-today as date no-undo .
     1350   DEFINE VARIABLE v-time as integer no-undo .
     1351   run cur-time in this-procedure ( output v-today, output v-time).
     1352   if p-sclin-ld > 0 then do:
     1353     if p-raw-dead-line > 0 then do:
     1354       assign
     1355       v-dead-line-date = p-raw-dead-line / 24  + 01/01/2000 - 1
     1356       .
     1357     end.
     1358     else  do:
     1359       assign
     1360       v-dead-line-date = ?
     1361       .
     1362     end.
     1363   end.
     1364   else do:
     1365     if p-raw-dead-line > 0 then do:
     1366       assign
     1367       v-dead-line-date = p-raw-dead-line  + v-today - 1
     1368       .
     1369     end.
     1370     else do:
     1371       assign
     1372       v-dead-line-date = ?
     1373       .
     1374     end.
     1375   end.
     1376   return v-dead-line-date.
     1377   end.
     1378   FUNCTION scl-gds-ld-parts returns integer ( buffer buf_scales-gds for ub.scales-gds, input sclin-ld as integer):
     1379   define buffer buf_gds-obj for ub.gds-obj.
     1380   define buffer buf_bar-code for ub.bar-code.
     1381   define buffer buf_parts for ub.parts .
     1382   define buffer buf_goods for ub.goods.
     1383   define variable v-last-date as date no-undo.
     1384   find first buf_bar-code no-lock where
     1385             buf_bar-code.b-code = buf_scales-gds.b-code no-error.
     1386   if not available buf_bar-code then return ?.
     1387   if sclin-ld > 0 then do:
     1388     find first buf_gds-obj no-lock where
     1389               buf_gds-obj.gds-code = buf_bar-code.gds-code
     1390         and  buf_gds-obj.obj-type = buf_scales-gds.obj-type
     1391         and  buf_gds-obj.obj-code = buf_scales-gds.obj-code no-error .
     1392     if not available buf_gds-obj then return ?.
     1393     _parts:
     1394     for each buf_parts no-lock where
     1395             buf_parts.obj-type  = buf_gds-obj.obj-type
     1396         and buf_parts.obj-code  = buf_gds-obj.obj-code
     1397         and buf_parts.artic     = buf_gds-obj.artic
     1398         and buf_parts.prod-type = buf_gds-obj.prod-type
     1399         and buf_parts.prod-code = buf_gds-obj.prod-code
     1400         and buf_parts.out-code  = buf_gds-obj.in-code:
     1401       if buf_parts.last-date = ? then next _parts.
     1402       assign
     1403       v-last-date = (if v-last-date = ?
     1404                     or (v-last-date <> ?
     1405                         and sclin-ld = 1
     1406                         and v-last-date > buf_parts.last-date)
     1407                     or (v-last-date <> ?
     1408                         and sclin-ld = 2
     1409                         and v-last-date < buf_parts.last-date)
     1410                     then buf_parts.last-date
     1411                     else v-last-date)
     1412       .
     1413     end.
     1414     if v-last-date <> ? then do:
     1415       return (v-last-date - 01/01/2000 + 1) * 24.
     1416     end.
     1417     else do:
     1418       return 0.
     1419     end.
     1420   end.
     1421   else do:
     1422     find first buf_goods no-lock where
     1423               buf_goods.gds-code = buf_bar-code.gds-code no-error.
     1424     if available buf_goods then do:
     1425       return buf_goods.deadline.
     1426     end.
     1427     else return 0.
     1428   end.
     1429   END FUNCTION.
     1430   FUNCTION scl-gds-ld-parts-date returns date ( buffer buf_scales-gds for ub.scales-gds, input sclin-ld as integer):
     1431   define buffer buf_gds-obj for ub.gds-obj.
     1432   define buffer buf_bar-code for ub.bar-code.
     1433   define buffer buf_parts for ub.parts .
     1434   define buffer buf_goods for ub.goods.
     1435   define variable v-last-date as date no-undo.
     1436   DEFINE VARIABLE v-today as date no-undo .
     1437   DEFINE VARIABLE v-time as integer no-undo .
     1438   find first buf_bar-code no-lock where
     1439             buf_bar-code.b-code = buf_scales-gds.b-code no-error.
     1440   if not available buf_bar-code then return ?.
     1441   if sclin-ld > 0 then do:
     1442     find first buf_gds-obj no-lock where
     1443               buf_gds-obj.gds-code = buf_bar-code.gds-code
     1444         and  buf_gds-obj.obj-type = buf_scales-gds.obj-type
     1445         and  buf_gds-obj.obj-code = buf_scales-gds.obj-code no-error .
     1446     if not available buf_gds-obj then return ?.
     1447     _parts:
     1448     for each buf_parts no-lock where
     1449             buf_parts.obj-type  = buf_gds-obj.obj-type
     1450         and buf_parts.obj-code  = buf_gds-obj.obj-code
     1451         and buf_parts.artic     = buf_gds-obj.artic
     1452         and buf_parts.prod-type = buf_gds-obj.prod-type
     1453         and buf_parts.prod-code = buf_gds-obj.prod-code
     1454         and buf_parts.out-code  = buf_gds-obj.in-code:
     1455       if buf_parts.last-date = ? then next _parts.
     1456       assign
     1457       v-last-date = (if v-last-date = ?
     1458                     or (v-last-date <> ?
     1459                         and sclin-ld = 1
     1460                         and v-last-date > buf_parts.last-date)
     1461                     or (v-last-date <> ?
     1462                         and sclin-ld = 2
     1463                         and v-last-date < buf_parts.last-date)
     1464                     then buf_parts.last-date
     1465                     else v-last-date)
     1466       .
     1467     end.
     1468     if v-last-date <> ? then do:
     1469       return v-last-date.
     1470     end.
     1471     else do:
     1472       run cur-time in this-procedure ( output v-today, output v-time).
     1473       return v-today.
     1474     end.
     1475   end.
     1476   else do:
     1477     run cur-time in this-procedure ( output v-today, output v-time).
     1478     find first buf_goods no-lock where
     1479               buf_goods.gds-code = buf_bar-code.gds-code no-error.
     1480     if available buf_goods then do:
     1481       return (v-today + buf_goods.deadline).
     1482     end.
     1483     else return v-today.
     1484   end.
     1485   END FUNCTION.
     1486   FUNCTION scl-gds-ld-to-raw returns integer ( input p-dead-line as integer, input p-sclin-ld as integer):
     1487   define variable v-dead-line as integer no-undo .
     1488   define variable v-dead-line-date as integer no-undo .
     1489   DEFINE VARIABLE v-today as date no-undo .
     1490   DEFINE VARIABLE v-time as integer no-undo .
     1491   run cur-time in this-procedure ( output v-today, output v-time).
     1492   if p-sclin-ld > 0 then do:
     1493     run cur-time in this-procedure ( output v-today, output v-time).
     1494     if p-dead-line = 0 then do:
     1495       assign
     1496       v-dead-line = 0
     1497       .
     1498     end.
     1499     else do:
     1500       assign
     1501       v-dead-line = (v-today + p-dead-line - 01/01/2000) * 24
     1502       .
     1503     end.
     1504   end.
     1505   else v-dead-line = p-dead-line.
     1506   return v-dead-line.
     1507   end.
     1508   FUNCTION scl-gds-ld-to-date returns date ( input p-dead-line as integer):
     1509   define variable v-dead-line as integer no-undo .
     1510   define variable v-dead-line-date as integer no-undo .
     1511   DEFINE VARIABLE v-today as date no-undo .
     1512   DEFINE VARIABLE v-time as integer no-undo .
     1513   run cur-time in this-procedure ( output v-today, output v-time).
     1514   return (v-today  + p-dead-line - 1).
     1515   end.
     1516   FUNCTION scl-gds-deadvalue returns character ( input p-deadline as integer
     1517                                                 ,input p-deaddate as date
     1518                                                 ,input p-deadflag as integer):
     1519   if p-deadflag = integer('0':U) then return string((if p-deadline = ? then 0 else p-deadline)).
     1520   else return string(p-deaddate, "99/99/9999").
     1521   end function.
