     1223   if gp-price-sale-parts <> 0 and gp-price-sale-parts <> ? then do:
     1224       gp-price-sale = gp-price-sale-parts.
     1225    end.
     1226     if  gp-price-sale <> ? then do:
     1227       define variable l-in-ov as logical no-undo .
     1228   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1229   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjat in g#library
     1230     (input  shop-type
     1231     ,input  shop-code
     1232     ,input  loc-good.artic
     1233     ,input  loc-good.prod-type
     1234     ,input  loc-good.prod-code
     1235     ,input  'in-ov=request'
     1236     ,output l-in-ov
     1237     ) no-error .
     1238       if error-status:error then do:
     1239         message
     1240           vss-workfile vss-revision vss-description skip
     1241           "Ошибка получения признака товара на объекте" skip
     1242           error-status :get-message(1) skip
     1243           return-value skip
     1244           view-as alert-box error .
     1245         undo, return no-apply .
     1246       end.
     1247       find first buf_shop no-lock where buf_shop.obj-code = shop-code .
     1248       if not (buf_shop.in-ov AND l-in-ov) then do:
     1249         assign
     1250           scale-price = gp-price-sale
     1251         .
     1252       end.
     1253       else do:
     1254         assign
     1255           scale-price = ?
     1256         .
     1257       end.
     1258     end.
     1259     else do:
     1260       assign
     1261         scale-price = ?
     1262       .
     1263     end.
     1264     RETURN scale-price.
     1265   END FUNCTION.
