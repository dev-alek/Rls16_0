     1747   sym6 with frame List-PLU .
     1748   DOWN stream PrnLibStream 1 with frame List-PLU .
     1749   ACCUMULATE buf_goods.artic( count ).
     1750   if ( accum count buf_goods.artic ) modulo 20 = 0 then
     1751   run waitfram-show in this-procedure ("Обработано строк списка : " + string ((accum count buf_goods.artic))).
     1752       END.
     1753     end.
     1754     when "bar" then do:
