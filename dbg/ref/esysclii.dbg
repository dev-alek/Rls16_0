        1   DEFINE INPUT PARAMETER parparentproc AS WIDGET-HANDLE NO-UNDO.
        2   DEFINE INPUT PARAMETER p-mode AS CHARACTER NO-UNDO.
        3   DEFINE INPUT PARAMETER p-title AS CHARACTER NO-UNDO.
        4   DEFINE INPUT PARAMETER p-esys-type AS INTEGER NO-UNDO.
        5   DEFINE INPUT-OUTPUT PARAMETER p-ext-obj-type AS CHARACTER .
        6   DEFINE INPUT-OUTPUT PARAMETER p-ext-obj-code AS CHARACTER .
        7   DEFINE INPUT-OUTPUT PARAMETER p-ext-guid     AS CHARACTER .
        8   DEFINE OUTPUT PARAMETER p-ok AS LOGICAL NO-UNDO.
        9   define variable vss-revision    as character no-undo init "$Revision$":U .
       10   define variable vss-author      as character no-undo init "$Author$":U .
       11   define variable vss-date        as character no-undo init "$Date$":U .
       12   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       13   define variable vss-archive     as character no-undo init "$Archive$":U .
       14   define variable vss-description as character no-undo init "Форма задания типа/кода объекта во внешней системе".
       15   procedure vss-get-info :
       16     define output parameter p-vss-revision    like vss-revision    no-undo .
       17     define output parameter p-vss-author      like vss-author      no-undo .
       18     define output parameter p-vss-date        like vss-date        no-undo .
       19     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       20     define output parameter p-vss-archive     like vss-archive     no-undo .
       21     define output parameter p-vss-description like vss-description no-undo .
       22     assign
       23       p-vss-revision    = vss-revision
       24       p-vss-author      = vss-author
       25       p-vss-date        = vss-date
       26       p-vss-workfile    = vss-workfile
       27       p-vss-archive     = vss-archive
       28       p-vss-description = vss-description
       29     .
       30   end procedure.
       31   procedure vss-get-parameters :
       32     define output parameter p-vss-parameters as character no-undo .
       33   end procedure.
       34   define new global shared variable g#vssrevis-logger as handle    no-undo .
       35   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       36   define variable v-vssrevis-logger                   as handle    no-undo .
       37   procedure vss-logevent :
       38     define input  parameter p-extra-paramters as character no-undo .
       39     define variable v-vssrevis-parameters as character no-undo .
       40     do
       41     on error undo, return error return-value
       42     :
       43       if  valid-handle(v-vssrevis-logger)
       44       and v-vssrevis-logger :get-signature("logevent") <> ""
       45       then do:
       46         run vss-get-parameters in this-procedure
       47           (output v-vssrevis-parameters
       48           ).
       49         run logevent in v-vssrevis-logger
       50           (input vss-workfile
       51           ,input vss-revision
       52           ,input v-vssrevis-parameters
       53           ,input p-extra-paramters
       54           ).
       55       end.
       56     end.
       57   end procedure.
       58   assign
       59     v-vssrevis-logger = g#vssrevis-logger
       60   .
       61   if  valid-handle(v-vssrevis-logger)
       62   and v-vssrevis-logger :get-signature("logevent") <> ""
       63   then do:
       64     assign
       65       v-vssrevis-logevent = true
       66     .
       67     run vss-logevent in this-procedure (input vss-description) .
       68   end.
       69   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       70   define variable v-waitfram-action01         as character   no-undo .
       71   define variable v-waitfram-action02         as character   no-undo .
       72   define variable v-waitfram-action03         as character   no-undo .
       73   define variable mWaitFramTextBeg            as character   no-undo.
       74   define variable mWaitFramTextEnd            as character   no-undo.
       75   define variable mWaitFramView               as logical     no-undo.
       76   define variable mWaitProcEvent              as logical     no-undo init yes.
       77   define variable mWaitFramInterval           as integer     no-undo init 1 .
       78   define variable mWaitFramStop               as logical     no-undo.
       79   define variable mWaitFramStopUser           as logical     no-undo.
       80   define variable mWaitFramStopTimeOut        as logical     no-undo.
       81   define variable mWaitFramStartProc          as datetime-tz no-undo.
       82   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
       83   define button B-WaitFramStop auto-end-key
       84        label "Стоп"
       85        size 10 by 1 tooltip "Остоновить процесс".
       86   define button B-viewProcInfo
       87        label "Информация"
       88        size 15 by 1 tooltip "Информация о процесс".
       89   define frame waitfram
       90     v-waitfram-action01 format "x(72)" no-label skip
       91     v-waitfram-action02 format "x(72)" no-label skip
       92     v-waitfram-action03 format "x(72)" no-label skip
       93     B-viewProcInfo
       94     B-WaitFramStop at row 4 col 30
       95     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
       96     .
       97   define new global shared variable mBatchMode as logical no-undo init ?.
       98   define variable mFramBachModHandle as handle no-undo.
       99   mFramBachModHandle = frame waitfram:handle.
      100   define variable mFameOldVis as logical no-undo.
      101   define variable mVisCUrentVin as logical no-undo.
      102   if session:batch-mode
      103   then
      104      mBatchMode = yes.
      105   if mBatchMode = ? then do:
      106     mVisCUrentVin = current-window:visible.
      107     mFameOldVis = mFramBachModHandle:visible.
      108     mFramBachModHandle:visible  = yes.
      109     mBatchMode = mFramBachModHandle:visible ne yes.
      110     mFramBachModHandle:visible = mFameOldVis.
      111     current-window:visible = mVisCUrentVin.
      112   end.
      113    if  log-manager:logfile-name ne ?
      114     then DO:
      115         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      116         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      117         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      118     end.
      119   on choose of B-WaitFramStop in frame waitfram
      120   do:
      121     mWaitFramStop = yes.
      122     mWaitFramStopUser = yes.
      123   end.
      124   function waitfram-check-timeout returns logical():
      125      define variable vtime as int64 no-undo.
      126      if mWaitFramStopTimeOut
      127      then
      128         return yes.
      129      vtime = ( now - mWaitFramStartProc ) / 1000 .
      130      if     mWaitFramTimeOut ne ?
      131         and mWaitFramTimeOut ne 0
      132         and mWaitFramTimeOut lt vtime
      133      then do:
      134         mWaitFramStopTimeOut = yes.
      135      end.
      136      return mWaitFramStopTimeOut.
      137   end.
      138   procedure waitfram-hide :
      139     if not session:batch-mode
      140     then do
      141     on error undo, return error return-value
      142     :
      143       pause 0 before-hide .
      144       if not mBatchMode then
      145         hide frame waitfram .
      146     if     not mWaitFramView
      147        and mWaitProcEvent
      148     then
      149       process events .
      150     end.
      151   end procedure.
      152   procedure waitfram-show :
      153     define input  parameter p-message as character no-undo .
      154     define variable v-left-margin as integer   no-undo .
      155     if not session:batch-mode
      156     then do
      157     on error undo, return error return-value
      158     :
      159       if length(p-message) <= 70 then do:
      160         assign
      161           v-left-margin = integer((70 - length(p-message)) / 2)
      162         .
      163         assign
      164           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      165         .
      166         assign
      167           v-waitfram-action01 = " "
      168           v-waitfram-action02 = " "
      169                                    + fill(" ", v-left-margin)
      170                                    + p-message
      171           v-waitfram-action03 = " "
      172         .
      173       end.
      174       else do:
      175         define variable vRindex1 as integer no-undo.
      176         define variable vRindex2 as integer no-undo.
      177         vRindex1 = r-index(p-message," ",70).
      178         if vRindex1 = 0
      179         then
      180            vRindex1 = 70.
      181         if length(p-message)  <= vRindex1 + 70 then do:
      182           assign
      183             v-waitfram-action01 = " "
      184             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      185             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      186           .
      187         end.
      188         else do:
      189           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      190           if vRindex2 <= vRindex1
      191           then
      192              vRindex2 = vRindex1 + 70.
      193           assign
      194             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      195             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      196             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      197           .
      198         end.
      199       end.
      200       B-viewProcInfo:visible   in frame waitfram = no.
      201       B-viewProcInfo:sensitive in frame waitfram = no.
      202       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      203       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      204       if  (   mWaitFramView
      205          or  mWaitProcEvent)
      206          and not mBatchMode
      207       then
      208          display
      209             v-waitfram-action01 skip
      210             v-waitfram-action02 skip
      211             v-waitfram-action03 skip
      212          with frame waitfram .
      213       if     mWaitFramView
      214          then do:
      215             if     mWaitFramInterval ne ?
      216                and not mBatchMode
      217             then
      218                wait-for go of frame waitfram pause mWaitFramInterval.
      219          end.
      220          else
      221             if     mWaitProcEvent
      222                and not mBatchMode
      223             then
      224                process events .
      225     end.
      226   end procedure.
      227      procedure waitfram-show-this:
      228         define input  parameter iInterval as int64 no-undo.
      229         define variable vtime as int64 no-undo.
      230         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      231         mWaitFramInterval = iInterval.
      232         run waitfram-show (substitute("&1&2 &3&4" ,
      233                                       mWaitFramTextBeg ,
      234                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      235                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      236                                       mWaitFramTextEnd
      237                                      )
      238                           ).
      239      end.
      240      procedure WaitFramRunPause:
      241         define input  parameter iInterval as dec no-undo.
      242         define variable vStart  as datetime-tz no-undo.
      243         define variable vend    as datetime-tz no-undo.
      244         define variable vint as int64 no-undo.
      245         define variable vOk as logical no-undo.
      246         vStart = now.
      247         vend   = vStart.
      248         publish "WaitFramPause" (iInterval,output vOk).
      249         vend   =  now.
      250         vint = vend - vStart.
      251         vint = iInterval - vint / 1000.
      252         if     not mWaitFramStop
      253            and (   vint > 0
      254                 or (    not vOk
      255                     and iInterval eq ?
      256                     )
      257                 )
      258         then
      259            run waitfram-show-this (iInterval).
      260         vend   =  now.
      261         vint = vend - vStart.
      262         vint = iInterval - vint / 1000.
      263         if     not mWaitFramStop
      264            and vint > 0
      265         then do:
      266            run gbl/pause.p (vint * 1000).
      267         end.
      268         if iInterval ne ?
      269         then
      270            publish "WaitFramStop".
      271         waitfram-check-timeout().
      272      end.
      273      procedure WaitFramWaitFor:
      274         define input  parameter iInterval as dec no-undo.
      275         assign
      276            mWaitFramStartProc   = now
      277            mWaitFramStopUser    = no
      278            mWaitFramStopTimeOut = no
      279         .
      280         block-wait:
      281         do while not mWaitFramStop:
      282            run WaitFramRunPause (iInterval).
      283            if  waitfram-check-timeout()
      284            then do:
      285               leave block-wait.
      286            end.
      287         end.
      288         run waitfram-hide.
      289      end.
      290   procedure waitfram-join :
      291     define input  parameter p-line-1  as character no-undo .
      292     define input  parameter p-line-2  as character no-undo .
      293     define input  parameter p-line-3  as character no-undo .
      294     define output parameter p-message as character no-undo .
      295     do
      296     on error undo, return error return-value
      297     :
      298       assign
      299         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      300                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      301                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      302       .
      303     end.
      304   end procedure.
      305   function waitfram-join-function returns character
      306     (input p-line-1 as character
      307     ,input p-line-2 as character
      308     ,input p-line-3 as character
      309     ).
      310     define variable v-message as character no-undo .
      311     run waitfram-join in this-procedure
      312       (input  p-line-1
      313       ,input  p-line-2
      314       ,input  p-line-3
      315       ,output v-message
      316       ) .
      317     return v-message .
      318   end function .
      319   define new global shared variable g#language as character no-undo .
      320   if g#language <> '' and g#language <> 'rus':U then do:
      321     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      322   end.
      323   procedure proc-alt-shift-f2:
      324     if not ibs.th.gbl.gbl-var:rcode
      325   then
      326     run gbl\inidebug.p .
      327   end.
      328   procedure proc-alt-shift-f3:
      329     run gbl/prvssinf.p
      330       ( input this-procedure
      331       ) .
      332   end.
      333   define variable v-inform-launched as logical no-undo initial false .
      334   procedure proc-alt-shift-f4:
      335     define variable v-action as character no-undo .
      336     if v-inform-launched = false then do:
      337       assign
      338         v-inform-launched = true
      339       .
      340       run gbl/d-inform.w
      341         (  input self
      342         ,  input this-procedure
      343         , output v-action
      344         ) no-error .
      345       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      346       assign
      347         v-inform-launched = false
      348       .
      349     end.
      350   end.
      351   procedure proc-alt-f1:
      352     run gbl/corrhelp.p
      353       (input this-procedure
      354       ) .
      355   end .
      356   on alt-shift-f2 anywhere do:
      357     run proc-alt-shift-f2.
      358   end.
      359   on alt-shift-f3 anywhere do:
      360     run proc-alt-shift-f3 in this-procedure .
      361   end.
      362   on alt-shift-f4 anywhere do:
      363     run proc-alt-shift-f4 in this-procedure.
      364   end.
      365   on alt-f1 anywhere do:
      366     run proc-alt-f1 in this-procedure .
      367   end.
      368   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      369     define variable v-cntxt-db-num        as integer   no-undo .
      370     define variable v-cntxt-userid        as character no-undo .
      371     define variable v-cntxt-level         as character no-undo .
      372     define variable v-cntxt-host-code-obj as integer   no-undo .
      373     define variable v-cntxt-obj-type      as character no-undo .
      374     define variable v-cntxt-obj-code      as integer   no-undo .
      375     define variable v-cntxt-db-num-obj    as integer   no-undo .
      376     define variable v-cntxt-is-admin      as logical   no-undo .
      377   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      378     run mainmenu_getcntxt in parparentproc
      379       (output v-cntxt-db-num
      380       ,output v-cntxt-userid
      381       ,output v-cntxt-level
      382       ,output v-cntxt-host-code-obj
      383       ,output v-cntxt-obj-type
      384       ,output v-cntxt-obj-code
      385       ,output v-cntxt-db-num-obj
      386       ,output v-cntxt-is-admin
      387       ) .
      388   PROCEDURE checkguid :
      389     define INPUT-output parameter guid_ as CHARACTER NO-UNDO .
      390     define OUTPUT parameter Msg as CHARACTER  NO-UNDO .
      391     def var ii      as int       no-undo.
      392     def var err     as logical   no-undo.
      393     def var str     as character no-undo.
      394     def var numentr as integer   no-undo.
      395     numentr = num-entries (guid_, "-") no-error.
      396     if numentr = 8
      397       then
      398     do:
      399       do ii = 1 to numentr:
      400         if length (trim (entry (ii, guid_, "-"))) <> 4
      401           then err = true.
      402         str = str + trim (entry (ii, guid_, "-")).
      403         if ii = 2 or ii = 3 or ii = 4 or ii = 5
      404           then
      405         do:
      406           str = str + "-".
      407         end.
      408       end.
      409       guid_ = str.
      410     end.
      411     numentr = num-entries (guid_, "-") no-error.
      412     do ii = 1 to numentr:
      413       case ii:
      414         when 1 then
      415           do:
      416             if length (trim (entry (ii, guid_, "-"))) <> 8
      417               then err = true.
      418           end.
      419         when 2 or
      420         when 3 or
      421         when 4 then
      422           do:
      423             if length (entry (ii, guid_, "-")) <> 4
      424               then err = true.
      425           end.
      426         when 5 then
      427           do:
      428             if length (entry (ii, guid_, "-")) <> 12
      429               then err = true.
      430           end.
      431       end case.
      432     end.
      433     if ii <> 6
      434       then err = true.
      435     if err then Msg = "Неверный формат GUID".
      436   END PROCEDURE.
      437   define variable ii            as integer   no-undo .
      438   define variable v-ext-guidobj as character no-undo .
      439   define variable v-ext-guid    as character no-undo .
      440   DEFINE BUFFER X_ext-classif FOR ub.ext-classif.
      441   DEFINE BUTTON B-exit AUTO-GO
      442     LABEL "&Ввод"
      443     SIZE 10 BY 1
      444     BGCOLOR 8 .
      445   DEFINE BUTTON B-Help
      446     LABEL "Помо&щь"
      447     SIZE 3 BY 1
      448     BGCOLOR 8 .
      449   DEFINE BUTTON b-quit AUTO-END-KEY
      450     LABEL "&Отмена"
      451     SIZE 10 BY 1
      452     BGCOLOR 8 .
      453   DEFINE VARIABLE f-ext-obj-code    AS CHARACTER FORMAT "X(16)"
      454     LABEL "Код объекта во внешней системе"
      455     VIEW-AS FILL-IN
      456     SIZE 16 BY 1 NO-UNDO.
      457   DEFINE VARIABLE f-ext-obj-guid    AS CHARACTER FORMAT "X(39)"
      458     LABEL "GUID площадки"
      459     VIEW-AS FILL-IN
      460     SIZE 40.88 BY 1 NO-UNDO.
      461   DEFINE VARIABLE f-ext-obj-guidobj AS CHARACTER FORMAT "X(39)"
      462     LABEL "GUID хоз. Субъекта"
      463     VIEW-AS FILL-IN
      464     SIZE 40.88 BY 1 NO-UNDO.
      465   DEFINE VARIABLE rs-ext-obj-type   AS CHARACTER
      466     VIEW-AS RADIO-SET HORIZONTAL
      467     RADIO-BUTTONS
      468     "Item 1", "1",
      469     "Item 2", "2",
      470     "Item 3", "3"
      471     SIZE 64 BY 1.25 NO-UNDO.
      472   DEFINE FRAME Dialog-Frame
      473     B-exit AT ROW 1 COL 1
      474     b-quit AT ROW 1 COL 11
      475     B-Help AT ROW 1 COL 71.5
      476     rs-ext-obj-type AT ROW 2.5 COL 6.88 NO-LABEL WIDGET-ID 4
      477     f-ext-obj-code AT ROW 4.25 COL 31.75 COLON-ALIGNED WIDGET-ID 2
      478     f-ext-obj-guidobj AT ROW 5.42 COL 31.63 COLON-ALIGNED WIDGET-ID 8
      479     f-ext-obj-guid AT ROW 6.5 COL 31.63 COLON-ALIGNED WIDGET-ID 10
      480     SPACE(0.23) SKIP(0.66)
      481     WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      482     SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      483     TITLE ""
      484     DEFAULT-BUTTON B-exit CANCEL-BUTTON b-quit.
      485   ASSIGN
      486     FRAME Dialog-Frame:SCROLLABLE = FALSE
      487     FRAME Dialog-Frame:HIDDEN     = TRUE.
      488   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      489     DO:
      490       APPLY "END-ERROR":U TO SELF.
      491     END.
      492   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
      493     DO:
      494       RUN proc-save IN THIS-PROCEDURE NO-ERROR.
      495       IF ERROR-STATUS:error THEN RETURN NO-APPLY.
      496     END.
      497   ON LEAVE OF f-ext-obj-guid IN FRAME Dialog-Frame
      498     DO:
      499       define variable Msg as character no-undo .
      500       assign f-ext-obj-guid .
      501       run checkguid(INPUT-OUTPUT f-ext-obj-guid, OUTPUT Msg) no-error .
      502       if Msg <> "" then
      503       do:
      504         MESSAGE Msg
      505           VIEW-AS ALERT-BOX.
      506         RETURN NO-APPLY .
      507       end.
      508     END.
      509   ON LEAVE OF f-ext-obj-guidobj IN FRAME Dialog-Frame
      510     DO:
      511       define variable Msg as character no-undo .
      512       assign f-ext-obj-guidobj .
      513       run checkguid(INPUT-OUTPUT f-ext-obj-guidobj, OUTPUT Msg) no-error .
      514       if Msg <> "" then
      515       do:
      516         MESSAGE Msg
      517           VIEW-AS ALERT-BOX.
      518         RETURN NO-APPLY .
      519       end.
      520     END.
      521   ON VALUE-CHANGED OF rs-ext-obj-type IN FRAME Dialog-Frame
      522     DO:
      523       ASSIGN
      524         rs-ext-obj-type.
      525       CASE rs-ext-obj-type:
      526         WHEN "+100000" THEN
      527           DO:
      528             ASSIGN
      529               f-ext-obj-code = string( integer(p-ext-obj-code) + 100000 ) no-error.
      530             DISPLAY
      531               f-ext-obj-code
      532               WITH FRAME Dialog-Frame.
      533           END.
      534         OTHERWISE
      535         DO:
      536           ASSIGN
      537             f-ext-obj-code = p-ext-obj-code.
      538           DISPLAY
      539             f-ext-obj-code
      540             WITH FRAME Dialog-Frame.
      541         END.
      542       END CASE.
      543     END.
      544   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      545     THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      546   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      547   on help of frame Dialog-Frame
      548   do:
      549     run gbl/app_help.p
      550       (input this-procedure :file-name
      551       ,input ''
      552       ,input ?
      553       ) no-error.
      554     if error-status :error then do:
      555       message
      556         "Ошибка при вызове помощи"
      557         error-status :get-message(1)
      558         view-as alert-box .
      559     end.
      560   end.
      561   run minbtn-set in this-procedure .
      562   on choose of b-help in frame Dialog-Frame
      563   do:
      564     apply "help":u to frame Dialog-Frame .
      565   end.
      566   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      567   procedure minbtn-set :
      568       do
      569           on error undo, return error return-value
      570           :
      571           define variable ii              as integer       no-undo .
      572           define variable fh              as widget-handle no-undo .
      573           define variable hh              as widget-handle no-undo .
      574           define variable v-h             as handle        extent 4 no-undo .
      575           define variable v-name-button   as character     no-undo .
      576           define variable v-help-old-x    as decimal       no-undo .
      577           define variable v-help-old-y    as decimal       no-undo .
      578           define variable v-help-old-size as decimal       no-undo .
      579           define variable v-frame-width   as decimal       no-undo .
      580           define variable jj              as integer       no-undo .
      581           do
      582               on error undo, return error
      583               :
      584               assign
      585                   v-frame-width = frame Dialog-Frame:width - 0.3
      586                   fh            = frame Dialog-Frame:first-child
      587                   hh            = fh:first-child
      588                   ii            = 1
      589                   .
      590               do while valid-handle(hh):
      591                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      592                   do:
      593                       case lc(hh:name) :
      594                           when "b-help" then
      595                               do:
      596                                   hh:load-image-up("cmp/b-help.bmp":u) .
      597                                   hh:load-image-down("cmp/b-help.bmp":u) .
      598                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      599                                   hh:TOOLTIP = "Помощь" .
      600                                   v-help-old-x = hh:column .
      601                                   v-help-old-y = hh:row    .
      602                                   v-help-old-size = hh:width .
      603                                   hh:width-chars = 2.5 .
      604                               end.
      605                           when "b-print" then
      606                               do:
      607                                   hh:load-image("cmp/b-print.bmp":u) .
      608                                   hh:TOOLTIP = "Печать" .
      609                                   v-h[ii] = hh:handle .
      610                                   ii = ii + 1 .
      611                                   hh:width-chars = 3 .
      612                               end.
      613                           when "b-history" or
      614                           when "b-hist" then
      615                               do:
      616                                   hh:load-image("cmp/b-hist.bmp":u) .
      617                                   hh:TOOLTIP = "История" .
      618                                   v-h[ii] = hh:handle .
      619                                   ii = ii + 1 .
      620                                   hh:width-chars = 3 .
      621                               end.
      622                           when "b-sch" then
      623                               do:
      624                                   hh:load-image("cmp/b-sch.bmp":u) .
      625                                   hh:TOOLTIP = "Установка Фильтра" .
      626                                   v-h[ii] = hh:handle .
      627                                   ii = ii + 1 .
      628                                   hh:width-chars = 3 .
      629                               end.
      630                           when "b-hist-user" then
      631                               do:
      632                                   hh:load-image("cmp/b-hist.bmp":u) .
      633                                   hh:TOOLTIP = "История пользователя" .
      634                                   ii = ii + 1 .
      635                               end.
      636                       end case.
      637                   end.
      638                   hh = hh:next-sibling.
      639               end.
      640               b-help:column = v-frame-width - b-help:width-chars.
      641               jj = 0.
      642               repeat ii = 4 to 1 by -1 :
      643                   if valid-handle (v-h[ii] ) then
      644                   do:
      645                       jj  = jj + 1 .
      646                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      647                       v-h[ii]:row    = v-help-old-y .
      648                   end.
      649               end.
      650           end.
      651       end.
      652   end procedure.
      653   MAIN-BLOCK:
      654   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      655     ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      656     IF lookup(p-mode, 'ИЗМЕНЕНИЕ':U + chr(44) + 'ДОБАВЛЕНИЕ':U + chr(44) + 'ПРОСМОТР':U ) = 0  THEN
      657     DO:
      658       MESSAGE
      659         SUBSTITUTE("Неверное значение параметра p-mode=&1", p-mode)
      660         VIEW-AS ALERT-BOX ERROR.
      661       UNDO, RETURN ERROR.
      662     END.
      663     RUN Myenable IN THIS-PROCEDURE.
      664     WAIT-FOR GO OF FRAME Dialog-Frame.
      665   END.
      666   RUN disable_UI.
      667   PROCEDURE disable_UI :
      668     HIDE FRAME Dialog-Frame.
      669   END PROCEDURE.
      670   PROCEDURE enable_UI :
      671     DISPLAY rs-ext-obj-type f-ext-obj-code f-ext-obj-guidobj f-ext-obj-guid
      672       WITH FRAME Dialog-Frame.
      673     ENABLE B-exit b-quit B-Help rs-ext-obj-type f-ext-obj-code f-ext-obj-guidobj
      674       f-ext-obj-guid
      675       WITH FRAME Dialog-Frame.
      676     VIEW FRAME Dialog-Frame.
      677   END PROCEDURE.
      678   PROCEDURE MyEnable :
      679     ASSIGN
      680       rs-ext-obj-type:RADIO-BUTTONS IN FRAME Dialog-Frame = 'маг':U + chr(44) + 'маг':U + chr(44) +
      681       'скл':U + chr(44) + 'скл':U + chr(44) +
      682       "Нет деления на типы объектов" + chr(44) + "" +
      683       (if p-ext-obj-type = 'скл':U
      684       then  (chr(44) +
      685       "+100000 (для DKlink)" + chr(44) + "+100000")
      686       else '')
      687       .
      688     if p-esys-type = integer('10':U) then
      689     do:
      690       if p-ext-guid <> "" then
      691       do:
      692         do ii = 1 to NUM-ENTRIES (p-ext-guid,chr(6)):
      693           if ii = 1 then v-ext-guidobj = ENTRY (ii,p-ext-guid,chr(6)) .
      694           else v-ext-guid = ENTRY (ii,p-ext-guid,chr(6)) .
      695         end.
      696       end.
      697       ASSIGN
      698         rs-ext-obj-type           = ''
      699         f-ext-obj-code            = p-ext-obj-code
      700         f-ext-obj-guidobj         = v-ext-guidobj
      701         f-ext-obj-guid            = v-ext-guid
      702         FRAME Dialog-Frame:TITLE = p-title
      703         .
      704       DISPLAY
      705         rs-ext-obj-type
      706         f-ext-obj-code
      707         f-ext-obj-guid
      708         f-ext-obj-guidobj
      709         WITH FRAME Dialog-Frame.
      710       ENABLE
      711         B-exit
      712         b-quit
      713         B-Help
      714         WITH FRAME Dialog-Frame.
      715       if p-mode = 'ПРОСМОТР':U then
      716       do:
      717         DISABLE
      718           rs-ext-obj-type
      719           f-ext-obj-code
      720           f-ext-obj-guid
      721           f-ext-obj-guidobj
      722           WITH FRAME Dialog-Frame.
      723       end.
      724       else
      725       do:
      726         DISABLE
      727           rs-ext-obj-type
      728           f-ext-obj-code
      729           WITH FRAME Dialog-Frame.
      730         if p-ext-obj-type = 'маг':U or p-ext-obj-type = 'скл':U then
      731         do:
      732           ENABLE
      733             f-ext-obj-guid
      734             WITH FRAME Dialog-Frame.
      735           HIDE
      736             f-ext-obj-guidobj
      737             IN frame Dialog-Frame .
      738         end.
      739         else
      740         do:
      741           if p-ext-obj-type = 'орг':U and p-ext-obj-code = STRING (v-cntxt-host-code-obj) then
      742           do:
      743             ENABLE
      744               f-ext-obj-guidobj
      745               WITH FRAME Dialog-Frame.
      746             HIDE
      747               f-ext-obj-guid
      748               IN frame Dialog-Frame .
      749           end.
      750           else
      751           do:
      752             ENABLE
      753               f-ext-obj-guid
      754               f-ext-obj-guidobj
      755               WITH FRAME Dialog-Frame.
      756           end.
      757         end.
      758         VIEW FRAME Dialog-Frame.
      759       end.
      760     end.
      761     else
      762     do:
      763       ASSIGN
      764         rs-ext-obj-type           = ''
      765         f-ext-obj-code            = p-ext-obj-code
      766         FRAME Dialog-Frame:TITLE = p-title
      767         .
      768       DISPLAY
      769         rs-ext-obj-type
      770         f-ext-obj-code
      771         WITH FRAME Dialog-Frame.
      772       ENABLE
      773         B-exit
      774         b-quit
      775         B-Help
      776         WITH FRAME Dialog-Frame.
      777       if p-mode = 'ПРОСМОТР':U then
      778       do:
      779         DISABLE
      780           rs-ext-obj-type
      781           f-ext-obj-code
      782           WITH FRAME Dialog-Frame.
      783       end.
      784       else
      785       do:
      786         ENABLE
      787           rs-ext-obj-type
      788           f-ext-obj-code
      789           WITH FRAME Dialog-Frame.
      790       end.
      791       HIDE
      792         f-ext-obj-guid
      793         f-ext-obj-guidobj
      794         IN frame Dialog-Frame .
      795     end.
      796     VIEW FRAME Dialog-Frame.
      797   END PROCEDURE.
      798   PROCEDURE proc-save :
      799     ASSIGN
      800       FRAME Dialog-Frame
      801       rs-ext-obj-type
      802       f-ext-obj-code
      803       f-ext-obj-guid
      804       f-ext-obj-guidobj
      805       .
      806     if p-ext-obj-type = 'скл':U
      807       and rs-ext-obj-type = "+100000"
      808       and f-ext-obj-code <> string ( integer(p-ext-obj-code) + 100000 ) then
      809     do:
      810       MESSAGE
      811         "Неверно определен код объекта во внешней системе" skip
      812         "Для склада он должен равняться номеру склада + 100000"
      813         VIEW-AS ALERT-BOX ERROR.
      814       UNDO, RETURN ERROR.
      815     end.
      816     if p-ext-obj-type = 'маг':U
      817       and rs-ext-obj-type = "+100000"
      818       and f-ext-obj-code <> p-ext-obj-code then
      819     do:
      820       MESSAGE
      821         "Неверно определен код объекта во внешней системе" skip
      822         "Для магазина он должен равняться номеру магазина"
      823         VIEW-AS ALERT-BOX ERROR.
      824       UNDO, RETURN ERROR.
      825     end.
      826     IF f-ext-obj-code = ?
      827       OR f-ext-obj-code = "" THEN
      828     DO:
      829       MESSAGE
      830         "Неверно определен код объекта во внешней системе"
      831         VIEW-AS ALERT-BOX ERROR.
      832       UNDO, RETURN ERROR.
      833     END.
      834     ASSIGN
      835       p-ext-obj-type = (if rs-ext-obj-type = "+100000"
      836                     then ""
      837                     ELSE rs-ext-obj-type)
      838       p-ext-obj-code = f-ext-obj-code
      839       p-ext-guid     = f-ext-obj-guidobj + chr(6) + f-ext-obj-guid
      840       p-ok           = YES
      841       .
      842   END PROCEDURE.
