        1   DEFINE TEMP-TABLE tt-wealth NO-UNDO LIKE ub.wealth.
        2   DEFINE TEMP-TABLE tt-wth-gds NO-UNDO LIKE ub.wth-gds.
        3   define input parameter parparentproc as widget-handle no-undo .
        4   define input parameter pwth-code as integer no-undo.
        5   define input parameter par-mode as character no-undo.
        6   define output PARAMETER p-rec as recid no-undo.
        7   define variable vss-revision    as character no-undo init "$Revision$":U .
        8   define variable vss-author      as character no-undo init "$Author$":U .
        9   define variable vss-date        as character no-undo init "$Date$":U .
       10   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       11   define variable vss-archive     as character no-undo init "$Archive$":U .
       12   define variable vss-description as character no-undo init "Карточка материальной ценности ".
       13   procedure vss-get-info :
       14     define output parameter p-vss-revision    like vss-revision    no-undo .
       15     define output parameter p-vss-author      like vss-author      no-undo .
       16     define output parameter p-vss-date        like vss-date        no-undo .
       17     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       18     define output parameter p-vss-archive     like vss-archive     no-undo .
       19     define output parameter p-vss-description like vss-description no-undo .
       20     assign
       21       p-vss-revision    = vss-revision
       22       p-vss-author      = vss-author
       23       p-vss-date        = vss-date
       24       p-vss-workfile    = vss-workfile
       25       p-vss-archive     = vss-archive
       26       p-vss-description = vss-description
       27     .
       28   end procedure.
       29   procedure vss-get-parameters :
       30     define output parameter p-vss-parameters as character no-undo .
       31   end procedure.
       32   define new global shared variable g#vssrevis-logger as handle    no-undo .
       33   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       34   define variable v-vssrevis-logger                   as handle    no-undo .
       35   procedure vss-logevent :
       36     define input  parameter p-extra-paramters as character no-undo .
       37     define variable v-vssrevis-parameters as character no-undo .
       38     do
       39     on error undo, return error return-value
       40     :
       41       if  valid-handle(v-vssrevis-logger)
       42       and v-vssrevis-logger :get-signature("logevent") <> ""
       43       then do:
       44         run vss-get-parameters in this-procedure
       45           (output v-vssrevis-parameters
       46           ).
       47         run logevent in v-vssrevis-logger
       48           (input vss-workfile
       49           ,input vss-revision
       50           ,input v-vssrevis-parameters
       51           ,input p-extra-paramters
       52           ).
       53       end.
       54     end.
       55   end procedure.
       56   assign
       57     v-vssrevis-logger = g#vssrevis-logger
       58   .
       59   if  valid-handle(v-vssrevis-logger)
       60   and v-vssrevis-logger :get-signature("logevent") <> ""
       61   then do:
       62     assign
       63       v-vssrevis-logevent = true
       64     .
       65     run vss-logevent in this-procedure (input vss-description) .
       66   end.
       67   define new global shared variable g#language as character no-undo .
       68   if g#language <> '' and g#language <> 'rus':U then do:
       69     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       70   end.
       71   procedure proc-alt-shift-f2:
       72     if not ibs.th.gbl.gbl-var:rcode
       73   then
       74     run gbl\inidebug.p .
       75   end.
       76   procedure proc-alt-shift-f3:
       77     run gbl/prvssinf.p
       78       ( input this-procedure
       79       ) .
       80   end.
       81   define variable v-inform-launched as logical no-undo initial false .
       82   procedure proc-alt-shift-f4:
       83     define variable v-action as character no-undo .
       84     if v-inform-launched = false then do:
       85       assign
       86         v-inform-launched = true
       87       .
       88       run gbl/d-inform.w
       89         (  input self
       90         ,  input this-procedure
       91         , output v-action
       92         ) no-error .
       93       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       94       assign
       95         v-inform-launched = false
       96       .
       97     end.
       98   end.
       99   procedure proc-alt-f1:
      100     run gbl/corrhelp.p
      101       (input this-procedure
      102       ) .
      103   end .
      104   on alt-shift-f2 anywhere do:
      105     run proc-alt-shift-f2.
      106   end.
      107   on alt-shift-f3 anywhere do:
      108     run proc-alt-shift-f3 in this-procedure .
      109   end.
      110   on alt-shift-f4 anywhere do:
      111     run proc-alt-shift-f4 in this-procedure.
      112   end.
      113   on alt-f1 anywhere do:
      114     run proc-alt-f1 in this-procedure .
      115   end.
      116   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      117     define variable v-cntxt-db-num        as integer   no-undo .
      118     define variable v-cntxt-userid        as character no-undo .
      119     define variable v-cntxt-level         as character no-undo .
      120     define variable v-cntxt-host-code-obj as integer   no-undo .
      121     define variable v-cntxt-obj-type      as character no-undo .
      122     define variable v-cntxt-obj-code      as integer   no-undo .
      123     define variable v-cntxt-db-num-obj    as integer   no-undo .
      124     define variable v-cntxt-is-admin      as logical   no-undo .
      125   define new global shared variable g#library  as handle no-undo .
      126   define new global shared variable g#library2 as handle no-undo .
      127   DEF TEMP-TABLE tt-gds NO-UNDO
      128       FIELD gds-code LIKE ub.goods.gds-code.
      129   DEF BUFFER LOCKED_wealth FOR ub.wealth.
      130   DEF BUFFER LOCKED_wth-gds FOR ub.wth-gds.
      131   define variable ser-wth  as logical   no-undo.
      132   define variable conf-par as character no-undo.
      133   define variable par-type as character no-undo.
      134   DEFINE BUTTON b-add
      135        LABEL "Добавить"
      136        SIZE 10 BY 1.
      137   DEFINE BUTTON b-chg
      138        LABEL "Изменить"
      139        SIZE 10 BY 1.
      140   DEFINE BUTTON B-curr
      141        IMAGE-UP FILE "btn-down-arrow":U
      142        IMAGE-DOWN FILE "btn-down-arrow":U
      143        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      144        LABEL "":L
      145        SIZE 3.13 BY 1.04
      146        BGCOLOR 8 FGCOLOR 0 .
      147   DEFINE BUTTON b-del
      148        LABEL "Удалить"
      149        SIZE 10 BY 1.
      150   DEFINE BUTTON B-exit AUTO-GO
      151        LABEL "&Ввод"
      152        SIZE 10 BY 1
      153        BGCOLOR 8 .
      154   DEFINE BUTTON B-Help
      155        LABEL "Помо&щь"
      156        SIZE 3 BY 1
      157        BGCOLOR 8 .
      158   DEFINE BUTTON B-hist
      159        LABEL "Ис&тория"
      160        SIZE 3 BY 1.
      161   DEFINE BUTTON b-quit AUTO-END-KEY
      162        LABEL "&Отмена"
      163        SIZE 10 BY 1
      164        BGCOLOR 8 .
      165   DEFINE BUTTON B-unit
      166        IMAGE-UP FILE "btn-down-arrow":U
      167        IMAGE-DOWN FILE "btn-down-arrow":U
      168        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      169        LABEL "":L
      170        SIZE 3.13 BY 1.04
      171        BGCOLOR 8 FGCOLOR 0 .
      172   DEFINE VARIABLE fcurr-abbr AS CHARACTER FORMAT "X(256)":U
      173         VIEW-AS TEXT
      174        SIZE 7.88 BY 1 NO-UNDO.
      175   DEFINE VARIABLE FILL-IN-1 AS CHARACTER FORMAT "X(256)":U INITIAL "Опред. кол-ва"
      176        VIEW-AS FILL-IN
      177        SIZE 15.5 BY 1 NO-UNDO.
      178   DEFINE QUERY BR-wth-gds FOR
      179         tt-wth-gds,
      180         ub.goods SCROLLING.
      181   DEFINE QUERY Dialog-Frame FOR
      182         tt-wealth SCROLLING.
      183   DEFINE BROWSE BR-wth-gds
      184     QUERY BR-wth-gds NO-LOCK DISPLAY
      185         ub.goods.artic FORMAT "X(16)":U WIDTH 12
      186         ub.goods.prod-type FORMAT "X(3)":U
      187         ub.goods.prod-code FORMAT ">>>>>>>>9":U
      188         ub.goods.gds-name FORMAT "X(30)":U WIDTH 36.25
      189       WITH NO-ROW-MARKERS SEPARATORS SIZE 68.5 BY 3.25 ROW-HEIGHT-CHARS .58 FIT-LAST-COLUMN.
      190   DEFINE FRAME Dialog-Frame
      191        B-exit AT ROW 1 COL 1.13
      192        b-quit AT ROW 1 COL 11.13
      193        B-hist AT ROW 1 COL 92
      194        B-Help AT ROW 1 COL 95
      195        tt-wealth.wth-name AT ROW 2.42 COL 1.88
      196             LABEL "Название" FORMAT "X(40)"
      197             VIEW-AS FILL-IN
      198             SIZE 41.38 BY 1
      199        tt-wealth.is-money AT ROW 2.42 COL 55.25
      200             LABEL "Деньги или денежный эквивалент"
      201             VIEW-AS TOGGLE-BOX
      202             SIZE 33.13 BY 1
      203        tt-wealth.curr-code AT ROW 3.75 COL 10 COLON-ALIGNED
      204             LABEL "Валюта" FORMAT ">>9"
      205             VIEW-AS FILL-IN
      206             SIZE 5.13 BY .96
      207        tt-wealth.unit-base AT ROW 3.75 COL 42.75 COLON-ALIGNED
      208             LABEL "Ед.изм"
      209             VIEW-AS FILL-IN
      210             SIZE 5.5 BY 1
      211        B-unit AT ROW 3.79 COL 51.13
      212        B-curr AT ROW 3.83 COL 17.75
      213        FILL-IN-1 AT ROW 5 COL 1.5 NO-LABEL WIDGET-ID 16
      214        tt-wealth.get-qnty-method AT ROW 5 COL 19 NO-LABEL WIDGET-ID 12
      215             VIEW-AS RADIO-SET VERTICAL
      216             RADIO-BUTTONS
      217                       "Item 1", "1",
      218   "Item 2", "2",
      219   "Item 3", "3"
      220             SIZE 72.5 BY 3.5 TOOLTIP "Как определить кол-во МЦ по ее сумме и пр."
      221        tt-wealth.is-ser AT ROW 8.75 COL 10 COLON-ALIGNED WIDGET-ID 10
      222             LABEL "Серийная" FORMAT "9"
      223             VIEW-AS COMBO-BOX INNER-LINES 5
      224             LIST-ITEM-PAIRS "Нет",0,
      225                        "Да",1
      226             DROP-DOWN-LIST
      227             SIZE 7 BY 1
      228        BR-wth-gds AT ROW 8.75 COL 22.5 WIDGET-ID 100
      229        b-add AT ROW 12 COL 22.5 WIDGET-ID 4
      230        b-chg AT ROW 12 COL 32.5 WIDGET-ID 8
      231        b-del AT ROW 12 COL 42.5 WIDGET-ID 6
      232        tt-wealth.PS AT ROW 13 COL 1 NO-LABEL
      233             VIEW-AS EDITOR SCROLLBAR-VERTICAL
      234             SIZE 97.63 BY 1.71
      235        tt-wealth.wth-code AT ROW 1.08 COL 28.5 COLON-ALIGNED NO-LABEL FORMAT "999999999"
      236              VIEW-AS TEXT
      237             SIZE 13 BY 1
      238             FGCOLOR 4
      239        fcurr-abbr AT ROW 3.92 COL 20.63 COLON-ALIGNED NO-LABEL
      240        "Код" VIEW-AS TEXT
      241             SIZE 6.13 BY 1.08 AT ROW 1 COL 22.88
      242        SPACE(69.98) SKIP(12.99)
      243       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      244            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      245            TITLE "Материальная ценность"
      246            DEFAULT-BUTTON B-exit CANCEL-BUTTON b-quit.
      247   ASSIGN
      248          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      249          FRAME Dialog-Frame:HIDDEN           = TRUE.
      250   ASSIGN
      251          b-add:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      252   ASSIGN
      253          b-chg:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      254   ASSIGN
      255          b-del:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      256   ASSIGN
      257          BR-wth-gds:HIDDEN  IN FRAME Dialog-Frame                = TRUE.
      258   ASSIGN
      259          tt-wealth.is-ser:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      260   ON GO OF FRAME Dialog-Frame
      261   DO:
      262     run proc-save in this-procedure no-error .
      263     if error-status:error then return no-apply.
      264   END.
      265   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      266   DO:
      267     APPLY "END-ERROR":U TO SELF.
      268   END.
      269   ON CHOOSE OF b-add IN FRAME Dialog-Frame
      270   DO:
      271       EMPTY TEMP-TABLE tt-gds.
      272       run str/sel-gds.w (parparentproc, INPUT-OUTPUT table tt-gds ).
      273       for each tt-gds:
      274         create tt-wth-gds  .
      275         assign tt-wth-gds.gds-code = tt-gds.gds-code.
      276       end.
      277       OPEN QUERY BR-wth-gds FOR EACH tt-wth-gds       WHERE tt-wth-gds.stts = 0 NO-LOCK,       EACH ub.goods WHERE TRUE        AND ub.goods.gds-code = tt-wth-gds.gds-code NO-LOCK INDEXED-REPOSITION.
      278       run GdsEnable.
      279   END.
      280   ON CHOOSE OF b-chg IN FRAME Dialog-Frame
      281   DO:
      282       IF NOT AVAILABLE tt-wth-gds THEN DO:
      283           MESSAGE 'Неправильно выбрана строка'
      284               VIEW-AS ALERT-BOX.
      285           RETURN NO-APPLY.
      286       END.
      287       EMPTY TEMP-TABLE tt-gds.
      288       CREATE tt-gds.
      289       tt-gds.gds-code = tt-wth-gds.gds-code.
      290       RELEASE tt-gds.
      291       run str/sel-gds.w (parparentproc, INPUT-OUTPUT table tt-gds ).
      292       for FIRST tt-gds:
      293         assign tt-wth-gds.gds-code = tt-gds.gds-code.
      294       end.
      295       OPEN QUERY BR-wth-gds FOR EACH tt-wth-gds       WHERE tt-wth-gds.stts = 0 NO-LOCK,       EACH ub.goods WHERE TRUE        AND ub.goods.gds-code = tt-wth-gds.gds-code NO-LOCK INDEXED-REPOSITION.
      296       run GdsEnable.
      297   END.
      298   ON CHOOSE OF B-curr IN FRAME Dialog-Frame
      299   DO:
      300   define variable rr as recid no-undo.
      301       rr = ? .
      302       run ref/currency.w (input parparentproc, "b-sel", input-output rr ).
      303       if rr <> ? then do:
      304           FIND FIRST ub.currency WHERE
      305                recid( ub.currency ) = rr NO-LOCK .
      306           DISPLAY
      307           ub.currency.curr-code @ tt-wealth.curr-code
      308           ub.currency.curr-abbr @ fcurr-abbr
      309           with frame Dialog-Frame .
      310       end.
      311   END.
      312   ON CHOOSE OF b-del IN FRAME Dialog-Frame
      313   DO:
      314   define variable del-rec as recid no-undo.
      315   define variable glog as logical no-undo .
      316   define variable rep-rec as recid no-undo .
      317   define buffer buf_wealth for ub.wealth.
      318   if not available tt-wth-gds then do:
      319     message "Неправильно выбрана строка.".
      320     return no-apply.
      321   end.
      322   rep-rec = recid (tt-wth-gds).
      323   glog = no.
      324   FIND FIRST tt-wth-gds WHERE recid (tt-wth-gds) = rep-rec.
      325   if tt-wth-gds.stts <> 0 then do:
      326       glog = no.
      327       message
      328       SUBSTITUTE('Товар с кодом &1 уже удален.~nВосстановить?',tt-wth-gds.gds-code)
      329       view-as alert-box question buttons Yes-No update glog.
      330       if not glog then do:
      331         apply "entry" to br-wth-gds in frame Dialog-Frame.
      332         return no-apply.
      333       end.
      334       assign
      335       tt-wth-gds.stts = 0
      336       .
      337       BR-wth-gds:REFRESH() NO-ERROR.
      338   end.
      339   else do:
      340         glog = no.
      341         MESSAGE SUBSTITUTE('Удалить товар с кодом &1 из списка~nВы уверены?',tt-wth-gds.gds-code)
      342         view-as alert-box question buttons OK-Cancel update glog.
      343         if not glog then do:
      344           apply "entry" to BR-wth-gds in frame Dialog-Frame.
      345           return no-apply.
      346         end.
      347         delete   tt-wth-gds.
      348       OPEN QUERY BR-wth-gds FOR EACH tt-wth-gds       WHERE tt-wth-gds.stts = 0 NO-LOCK,       EACH ub.goods WHERE TRUE        AND ub.goods.gds-code = tt-wth-gds.gds-code NO-LOCK INDEXED-REPOSITION.
      349       run GdsEnable.
      350    end.
      351    apply "entry" to BR-wth-gds in frame Dialog-Frame.
      352   END.
      353   ON CHOOSE OF B-hist IN FRAME Dialog-Frame
      354   DO:
      355     define variable v-rid-list  as   character            no-undo .
      356     define variable v-host-code like ub.sysconf.host-code no-undo .
      357     run ref/cwthhist.w (
      358                      input        parparentproc
      359                    , input        ?
      360                    , input        '':U
      361                    , input        0
      362                    , input        "":U
      363                    , input        "subject":U
      364                    , input        tt-wealth.wth-code
      365                    , INPUT        0
      366                    , input        ?
      367                    , input        ?
      368                    , input        ?
      369                    , input        ?
      370                    , input        "":U
      371                    , input        'wealth':U
      372                    , input        v-cntxt-db-num
      373                    , input ?
      374                    , input ?
      375                    , input-output v-rid-list
      376                    ) no-error .
      377   if error-status:error then do:
      378     message return-value skip
      379             error-status:get-message(1)
      380     view-as alert-box.
      381   end.
      382   END.
      383   ON CHOOSE OF B-unit IN FRAME Dialog-Frame
      384   DO:
      385       run ch-units.
      386       apply "entry" to tt-wealth.unit-base in frame Dialog-Frame.
      387   END.
      388   ON LEAVE OF tt-wealth.curr-code IN FRAME Dialog-Frame
      389   DO:
      390     assign
      391     tt-wealth.curr-code.
      392     if tt-wealth.is-money = yes and tt-wealth.curr-code = ? then do:
      393       message "Для материальных ценностей - денежных средств или имеющих денежный эквивалент" skip
      394               "необходимо ввести код валюты"
      395       view-as alert-box ERROR.
      396       return no-apply.
      397     end.
      398     if tt-wealth.curr-code <> ? then do:
      399       FIND FIRST ub.currency WHERE
      400                  ub.currency.curr-code = tt-wealth.curr-code NO-LOCK .
      401       if not avail ub.currency then do:
      402           message "Не найдена валюта с кодом " tt-wealth.curr-code skip
      403           view-as alert-box ERROR.
      404           return no-apply.
      405       end.
      406       DISPLAY
      407       ub.currency.curr-code @ tt-wealth.curr-code
      408       ub.currency.curr-abbr @ fcurr-abbr
      409       with frame Dialog-Frame .
      410     end.
      411   END.
      412   ON VALUE-CHANGED OF tt-wealth.is-money IN FRAME Dialog-Frame
      413   DO:
      414     assign
      415     tt-wealth.is-money.
      416     if tt-wealth.is-money = yes then do:
      417       ENABLE
      418       tt-wealth.curr-code
      419       b-curr
      420       with frame Dialog-Frame.
      421       DISABLE
      422       tt-wealth.unit-base
      423       b-unit
      424       tt-wealth.is-ser
      425       with frame Dialog-Frame.
      426     end.
      427     else do:
      428       display
      429       ? @ tt-wealth.curr-code
      430       "" @ fcurr-abbr
      431       with frame Dialog-Frame.
      432       DISABLE
      433       tt-wealth.curr-code
      434       b-curr
      435       with frame Dialog-Frame.
      436       ENABLE
      437       tt-wealth.unit-base
      438       b-unit
      439       tt-wealth.is-ser WHEN ser-wth
      440       with frame Dialog-Frame.
      441     end.
      442   END.
      443   ON VALUE-CHANGED OF tt-wealth.is-ser IN FRAME Dialog-Frame
      444   DO:
      445     ASSIGN tt-wealth.is-ser.
      446     IF tt-wealth.is-ser = 1 THEN DO:
      447       DISABLE tt-wealth.is-money
      448               tt-wealth.curr-code
      449               b-curr
      450       WITH FRAME Dialog-Frame.
      451     END.
      452     ELSE IF tt-wealth.is-ser = 0 THEN DO:
      453       ENABLE tt-wealth.is-money tt-wealth.curr-code b-curr WITH FRAME Dialog-Frame.
      454       APPLY "VALUE-CHANGED":U TO tt-wealth.is-money.
      455     END.
      456     run gdsEnable.
      457   END.
      458   ON LEAVE OF tt-wealth.unit-base IN FRAME Dialog-Frame
      459   DO:
      460       if not can-FIND( ub.units where ub.units.unit-name = input frame Dialog-Frame tt-wealth.unit-base )
      461        then do:
      462        tt-wealth.unit-base = "?".
      463        DISPLAY tt-wealth.unit-base WITH FRAME Dialog-Frame.
      464        run ch-units.
      465      end.
      466   END.
      467   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      468   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      469   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      470   on help of frame Dialog-Frame
      471   do:
      472     run gbl/app_help.p
      473       (input this-procedure :file-name
      474       ,input ''
      475       ,input ?
      476       ) no-error.
      477     if error-status :error then do:
      478       message
      479         "Ошибка при вызове помощи"
      480         error-status :get-message(1)
      481         view-as alert-box .
      482     end.
      483   end.
      484   run minbtn-set in this-procedure .
      485   on choose of b-help in frame Dialog-Frame
      486   do:
      487     apply "help":u to frame Dialog-Frame .
      488   end.
      489   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      490   procedure minbtn-set :
      491       do
      492           on error undo, return error return-value
      493           :
      494           define variable ii              as integer       no-undo .
      495           define variable fh              as widget-handle no-undo .
      496           define variable hh              as widget-handle no-undo .
      497           define variable v-h             as handle        extent 4 no-undo .
      498           define variable v-name-button   as character     no-undo .
      499           define variable v-help-old-x    as decimal       no-undo .
      500           define variable v-help-old-y    as decimal       no-undo .
      501           define variable v-help-old-size as decimal       no-undo .
      502           define variable v-frame-width   as decimal       no-undo .
      503           define variable jj              as integer       no-undo .
      504           do
      505               on error undo, return error
      506               :
      507               assign
      508                   v-frame-width = frame Dialog-Frame:width - 0.3
      509                   fh            = frame Dialog-Frame:first-child
      510                   hh            = fh:first-child
      511                   ii            = 1
      512                   .
      513               do while valid-handle(hh):
      514                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      515                   do:
      516                       case lc(hh:name) :
      517                           when "b-help" then
      518                               do:
      519                                   hh:load-image-up("cmp/b-help.bmp":u) .
      520                                   hh:load-image-down("cmp/b-help.bmp":u) .
      521                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      522                                   hh:TOOLTIP = "Помощь" .
      523                                   v-help-old-x = hh:column .
      524                                   v-help-old-y = hh:row    .
      525                                   v-help-old-size = hh:width .
      526                                   hh:width-chars = 2.5 .
      527                               end.
      528                           when "b-print" then
      529                               do:
      530                                   hh:load-image("cmp/b-print.bmp":u) .
      531                                   hh:TOOLTIP = "Печать" .
      532                                   v-h[ii] = hh:handle .
      533                                   ii = ii + 1 .
      534                                   hh:width-chars = 3 .
      535                               end.
      536                           when "b-history" or
      537                           when "b-hist" then
      538                               do:
      539                                   hh:load-image("cmp/b-hist.bmp":u) .
      540                                   hh:TOOLTIP = "История" .
      541                                   v-h[ii] = hh:handle .
      542                                   ii = ii + 1 .
      543                                   hh:width-chars = 3 .
      544                               end.
      545                           when "b-sch" then
      546                               do:
      547                                   hh:load-image("cmp/b-sch.bmp":u) .
      548                                   hh:TOOLTIP = "Установка Фильтра" .
      549                                   v-h[ii] = hh:handle .
      550                                   ii = ii + 1 .
      551                                   hh:width-chars = 3 .
      552                               end.
      553                           when "b-hist-user" then
      554                               do:
      555                                   hh:load-image("cmp/b-hist.bmp":u) .
      556                                   hh:TOOLTIP = "История пользователя" .
      557                                   ii = ii + 1 .
      558                               end.
      559                       end case.
      560                   end.
      561                   hh = hh:next-sibling.
      562               end.
      563               b-help:column = v-frame-width - b-help:width-chars.
      564               jj = 0.
      565               repeat ii = 4 to 1 by -1 :
      566                   if valid-handle (v-h[ii] ) then
      567                   do:
      568                       jj  = jj + 1 .
      569                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      570                       v-h[ii]:row    = v-help-old-y .
      571                   end.
      572               end.
      573           end.
      574       end.
      575   end procedure.
      576   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      577   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      578   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      579   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      580   define variable v-diasize-current-frame-width  as decimal   no-undo .
      581   define variable v-diasize-current-frame-height as decimal   no-undo .
      582   define variable v-diasize-change-size          as logical   no-undo .
      583   define variable v-diasize-resize-button        as handle    no-undo .
      584   define variable v-diasize-wndmax               as logical   no-undo .
      585   define variable v-diasize-wndstore             as logical   no-undo .
      586   define variable v-diasize-proc-name            as character no-undo .
      587   define variable v-diasize-browse-handle        as handle    no-undo .
      588   define variable v-diasize-browse-number        as integer   no-undo .
      589   define variable v-diasize-need-full-display    as logical   no-undo init false .
      590   define temp-table temp-diasize-handle no-undo
      591     field handle-value  as handle
      592     field save-position as decimal
      593     index xpk is primary unique handle-value
      594     .
      595   define temp-table temp-browse-handle no-undo
      596     field browse-type   as character
      597     field browse-number as integer
      598     field browse-handle as handle
      599     field original-size as decimal
      600     index xpk is primary unique browse-type browse-number
      601     index xie browse-type browse-handle
      602   .
      603   procedure diasize_change-height :
      604     define input  parameter p-change-value  as decimal   no-undo .
      605     define input  parameter p-move-resize   as logical   no-undo .
      606     define variable v-field-group-handle    as handle    no-undo .
      607     define variable v-object-handle         as handle    no-undo .
      608     define variable v-frame-height          as decimal   no-undo .
      609     define variable v-frame-virtual-height  as decimal   no-undo .
      610     define variable v-browse-height         as decimal   no-undo .
      611     define variable v-window-height         as decimal   no-undo .
      612     define variable v-window-virtual-height as decimal   no-undo .
      613     define variable v-change-sign           as integer   no-undo .
      614     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      615     define buffer buf_temp-browse-handle  for temp-browse-handle .
      616     if p-change-value > 0
      617     then do:
      618       if frame Dialog-Frame :height + p-change-value
      619           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      620       then do:
      621         assign
      622           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      623                           - (frame Dialog-Frame :height-chars)
      624         .
      625         if p-change-value <= 0
      626         then do:
      627           run diasize_position-resize-button in this-procedure .
      628           return .
      629         end.
      630       end.
      631     end.
      632     if p-change-value < 0
      633     then do:
      634       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      635       then do:
      636         assign
      637           p-change-value = v-diasize-orig-frame-height
      638                          - (frame Dialog-Frame :height-chars)
      639         .
      640         if p-change-value >= 0
      641         then do:
      642           run diasize_position-resize-button in this-procedure .
      643           return .
      644         end.
      645       end.
      646     end.
      647     if p-change-value >= 0
      648     then do:
      649       assign
      650         v-change-sign = 1
      651       .
      652     end.
      653     else do:
      654       assign
      655         v-change-sign = -1
      656       .
      657     end.
      658     assign
      659       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      660     .
      661     if p-change-value = 0
      662     then do:
      663       run diasize_position-resize-button in this-procedure .
      664       return .
      665     end.
      666     move_block:
      667     do
      668     on error undo move_block, retry move_block
      669     :
      670       if retry
      671       then do:
      672         do
      673         on error undo move_block, leave move_block
      674         :
      675           if p-change-value > 0
      676           then do:
      677             for each buf_temp-diasize-handle
      678             on error undo, next
      679             :
      680               assign
      681                 v-object-handle = buf_temp-diasize-handle.handle-value
      682               .
      683               if v-object-handle <> v-diasize-resize-button
      684               then do:
      685                 assign
      686                   v-object-handle :row = buf_temp-diasize-handle.save-position
      687                 .
      688               end.
      689             end.
      690             assign
      691               v-diasize-browse-handle :height = v-browse-height
      692             .
      693             for each buf_temp-browse-handle
      694               where buf_temp-browse-handle.browse-type = 'height':u
      695             on error undo, next
      696             :
      697               assign
      698                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      699               .
      700             end.
      701             assign
      702               frame Dialog-Frame :height = v-frame-height
      703             .
      704             if frame Dialog-Frame :scrollable = true
      705             then do:
      706               assign
      707                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      708               .
      709             end.
      710             run diasize_position-resize-button in this-procedure .
      711           end.
      712           else do:
      713             if frame Dialog-Frame :scrollable = true
      714             then do:
      715               assign
      716                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      717               .
      718             end.
      719             assign
      720               frame Dialog-Frame :height = v-frame-height
      721             .
      722             assign
      723               v-diasize-browse-handle :height = v-browse-height
      724             .
      725             for each buf_temp-browse-handle
      726               where buf_temp-browse-handle.browse-type = 'height':u
      727             on error undo, next
      728             :
      729               assign
      730                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      731               .
      732             end.
      733             for each buf_temp-diasize-handle
      734             on error undo, next
      735             :
      736               assign
      737                 v-object-handle = buf_temp-diasize-handle.handle-value
      738               .
      739               if v-object-handle <> v-diasize-resize-button
      740               then do:
      741                 assign
      742                   v-object-handle :row = buf_temp-diasize-handle.save-position
      743                 .
      744               end.
      745             end.
      746             run diasize_position-resize-button in this-procedure .
      747           end.
      748           assign
      749             v-diasize-change-size = false
      750           .
      751           leave move_block .
      752         end.
      753       end.
      754       assign
      755         v-diasize-need-full-display = true
      756       .
      757       if v-diasize-change-size = false
      758       then do:
      759         assign
      760           v-diasize-change-size = true
      761         .
      762       end.
      763       else do:
      764         return .
      765       end.
      766       assign
      767         v-frame-height = frame Dialog-Frame :height
      768         v-frame-virtual-height = frame Dialog-Frame :virtual-height
      769         v-browse-height = v-diasize-browse-handle :height
      770       .
      771       for each buf_temp-browse-handle
      772         where buf_temp-browse-handle.browse-type = 'height':u
      773       :
      774         assign
      775           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
      776         .
      777       end.
      778       for each buf_temp-diasize-handle
      779       :
      780         delete buf_temp-diasize-handle .
      781       end.
      782       assign
      783         v-field-group-handle = frame Dialog-Frame :first-child
      784       .
      785       do while valid-handle(v-field-group-handle)
      786       :
      787         assign
      788           v-object-handle = v-field-group-handle :first-child
      789         .
      790         do while valid-handle(v-object-handle)
      791         :
      792           if  v-object-handle <> v-diasize-browse-handle :handle
      793           and can-query(v-object-handle, "row")
      794           and can-query(v-object-handle, "height")
      795           and ( v-object-handle :row > v-diasize-browse-handle :row )
      796           then do:
      797             find first buf_temp-browse-handle
      798               where buf_temp-browse-handle.browse-type   = 'height':u
      799                 and buf_temp-browse-handle.browse-handle = v-object-handle
      800               no-error .
      801             if available buf_temp-browse-handle
      802             then do:
      803             end.
      804             else do:
      805               create buf_temp-diasize-handle .
      806               assign
      807                 buf_temp-diasize-handle.handle-value  = v-object-handle
      808                 buf_temp-diasize-handle.save-position = v-object-handle :row
      809               .
      810             end.
      811           end.
      812           assign
      813             v-object-handle = v-object-handle :next-sibling
      814           .
      815         end.
      816         assign
      817           v-field-group-handle = v-field-group-handle :next-sibling
      818         .
      819       end.
      820       do with frame Dialog-Frame
      821       :
      822         hide v-diasize-resize-button .
      823         assign
      824           v-diasize-resize-button :row    = 1
      825           v-diasize-resize-button :column = 1
      826         .
      827       end.
      828       if p-change-value > 0
      829       then do:
      830         if frame Dialog-Frame :scrollable = true
      831         then do:
      832           assign
      833             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      834             no-error .
      835           if error-status :error
      836           or error-status :get-message(1) <> ""
      837           then do:
      838             undo move_block, retry move_block .
      839           end.
      840         end.
      841         assign
      842           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      843           no-error .
      844         if error-status :error
      845         or error-status :get-message(1) <> ""
      846         then do:
      847           undo move_block, retry move_block .
      848         end.
      849         assign
      850           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      851           no-error .
      852         if error-status :error
      853         or error-status :get-message(1) <> ""
      854         then do:
      855           undo move_block, retry move_block .
      856         end.
      857         for each buf_temp-browse-handle
      858           where buf_temp-browse-handle.browse-type = 'height':u
      859         on error undo move_block, retry move_block
      860         :
      861           assign
      862             buf_temp-browse-handle.browse-handle :height
      863               = buf_temp-browse-handle.browse-handle :height + p-change-value
      864             no-error .
      865           if error-status :error
      866           or error-status :get-message(1) <> ""
      867           then do:
      868             undo move_block, retry move_block .
      869           end.
      870         end.
      871         for each buf_temp-diasize-handle
      872         on error undo move_block, retry move_block
      873         :
      874           assign
      875             v-object-handle = buf_temp-diasize-handle.handle-value
      876           .
      877           if v-object-handle <> v-diasize-resize-button
      878           then do:
      879             assign
      880               v-object-handle :row = v-object-handle :row + p-change-value
      881               no-error .
      882             if error-status :error
      883             or error-status :get-message(1) <> ""
      884             then do:
      885               undo move_block, retry move_block .
      886             end.
      887           end.
      888         end.
      889       end.
      890       else do:
      891         for each buf_temp-diasize-handle
      892         on error undo move_block, retry move_block
      893         :
      894           assign
      895             v-object-handle = buf_temp-diasize-handle.handle-value
      896           .
      897           if v-object-handle <> v-diasize-resize-button
      898           then do:
      899             assign
      900               v-object-handle :row = v-object-handle :row + p-change-value
      901               no-error .
      902             if error-status :error
      903             or error-status :get-message(1) <> ""
      904             then do:
      905               undo move_block, retry move_block .
      906             end.
      907           end.
      908         end.
      909         assign
      910           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      911           no-error .
      912         if error-status :error
      913         or error-status :get-message(1) <> ""
      914         then do:
      915           undo move_block, retry move_block .
      916         end.
      917         for each buf_temp-browse-handle
      918           where buf_temp-browse-handle.browse-type = 'height':u
      919         on error undo move_block, retry move_block
      920         :
      921           assign
      922             buf_temp-browse-handle.browse-handle :height
      923               = buf_temp-browse-handle.browse-handle :height + p-change-value
      924             no-error .
      925           if error-status :error
      926           or error-status :get-message(1) <> ""
      927           then do:
      928             undo move_block, retry move_block .
      929           end.
      930         end.
      931         assign
      932           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      933           no-error .
      934         if error-status :error
      935         or error-status :get-message(1) <> ""
      936         then do:
      937           undo move_block, retry move_block .
      938         end.
      939         if frame Dialog-Frame :scrollable = true
      940         then do:
      941           assign
      942             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      943             no-error .
      944           if error-status :error
      945           or error-status :get-message(1) <> ""
      946           then do:
      947             undo move_block, retry move_block .
      948           end.
      949         end.
      950       end.
      951       if p-move-resize = true
      952       then do:
      953         run diasize_position-resize-button in this-procedure .
      954       end.
      955       if v-diasize-wndstore = true
      956       then do:
      957         if connected("ub") = true
      958         then do:
      959           define variable v-cntxt-db-num        as integer   no-undo .
      960           define variable v-cntxt-userid        as character no-undo .
      961           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
      962                                             , OUTPUT v-cntxt-userid
      963                                             ) .
      964           run gbl/wndsizew.p
      965             (input  v-cntxt-db-num
      966             ,input  v-cntxt-userid
      967             ,input  v-diasize-proc-name
      968             ,input  'height':u
      969             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
      970             ) .
      971         end.
      972       end.
      973     end.
      974     assign
      975       v-diasize-change-size = false
      976     .
      977   end procedure.
      978   procedure diasize_set-height :
      979     define input  parameter p-new-height  as decimal   no-undo .
      980     define input  parameter p-move-resize as logical   no-undo .
      981     do
      982     on error undo, return error return-value
      983     :
      984       run diasize_change-height in this-procedure
      985         (input  (p-new-height - frame Dialog-Frame :height)
      986         ,input  p-move-resize
      987         ) .
      988     end.
      989   end procedure.
      990   procedure diasize_change-width :
      991     define input  parameter p-change-value as decimal   no-undo .
      992     define input  parameter p-move-resize  as logical   no-undo .
      993     define variable v-field-group-handle   as handle    no-undo .
      994     define variable v-object-handle        as handle    no-undo .
      995     define variable v-frame-width          as decimal   no-undo .
      996     define variable v-frame-virtual-width  as decimal   no-undo .
      997     define variable v-browse-width         as decimal   no-undo .
      998     define variable v-window-width         as decimal   no-undo .
      999     define variable v-window-virtual-width as decimal   no-undo .
     1000     define variable v-change-sign          as integer   no-undo .
     1001     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1002     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1003     if p-change-value > 0
     1004     then do:
     1005       if frame Dialog-Frame :width + p-change-value >
     1006           session :width-chars
     1007       then do:
     1008         assign
     1009           p-change-value = session :width-chars - frame Dialog-Frame :width
     1010         .
     1011         if p-change-value <= 0
     1012         then do:
     1013           run diasize_position-resize-button in this-procedure .
     1014           return .
     1015         end.
     1016       end.
     1017     end.
     1018     if p-change-value < 0
     1019     then do:
     1020       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1021       then do:
     1022         assign
     1023           p-change-value = v-diasize-orig-frame-width
     1024                          - frame Dialog-Frame :width
     1025         .
     1026         if p-change-value >= 0
     1027         then do:
     1028           run diasize_position-resize-button in this-procedure .
     1029           return .
     1030         end.
     1031       end.
     1032     end.
     1033     if p-change-value >= 0
     1034     then do:
     1035       assign
     1036         v-change-sign = 1
     1037       .
     1038     end.
     1039     else do:
     1040       assign
     1041         v-change-sign = -1
     1042       .
     1043     end.
     1044     assign
     1045       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1046     .
     1047     if p-change-value = 0
     1048     then do:
     1049       run diasize_position-resize-button in this-procedure .
     1050       return .
     1051     end.
     1052     move_block:
     1053     do
     1054     on error undo move_block, leave move_block
     1055     :
     1056       if retry
     1057       then do:
     1058         do
     1059         on error undo move_block, leave move_block
     1060         :
     1061           if p-change-value > 0
     1062           then do:
     1063             for each buf_temp-diasize-handle
     1064             on error undo, next
     1065             :
     1066               assign
     1067                 v-object-handle = buf_temp-diasize-handle.handle-value
     1068               .
     1069               if v-object-handle <> v-diasize-resize-button
     1070               then do:
     1071                 assign
     1072                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1073                 .
     1074               end.
     1075             end.
     1076             assign
     1077               v-diasize-browse-handle :width = v-browse-width
     1078             .
     1079             for each buf_temp-browse-handle
     1080               where buf_temp-browse-handle.browse-type = 'width':u
     1081             on error undo, next
     1082             :
     1083               assign
     1084                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1085               .
     1086             end.
     1087             assign
     1088               frame Dialog-Frame :width = v-frame-width
     1089             .
     1090             if frame Dialog-Frame :scrollable = true
     1091             then do:
     1092               assign
     1093                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1094               .
     1095             end.
     1096             run diasize_position-resize-button in this-procedure .
     1097           end.
     1098           else do:
     1099             if frame Dialog-Frame :scrollable = true
     1100             then do:
     1101               assign
     1102                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1103               .
     1104             end.
     1105             assign
     1106               frame Dialog-Frame :width = v-frame-width
     1107             .
     1108             for each buf_temp-browse-handle
     1109               where buf_temp-browse-handle.browse-type = 'width':u
     1110             on error undo, next
     1111             :
     1112               assign
     1113                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1114               .
     1115             end.
     1116             assign
     1117               v-diasize-browse-handle :width = v-browse-width
     1118             .
     1119             for each buf_temp-diasize-handle
     1120             on error undo, next
     1121             :
     1122               assign
     1123                 v-object-handle = buf_temp-diasize-handle.handle-value
     1124               .
     1125               if v-object-handle <> v-diasize-resize-button
     1126               then do:
     1127                 assign
     1128                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1129                 .
     1130               end.
     1131             end.
     1132             run diasize_position-resize-button in this-procedure .
     1133           end.
     1134           assign
     1135             v-diasize-change-size = false
     1136           .
     1137           leave move_block .
     1138         end.
     1139       end.
     1140       assign
     1141         v-diasize-need-full-display = true
     1142       .
     1143       if v-diasize-change-size = false
     1144       then do:
     1145         assign
     1146           v-diasize-change-size = true
     1147         .
     1148       end.
     1149       else do:
     1150         return .
     1151       end.
     1152       assign
     1153         v-frame-width = frame Dialog-Frame :width
     1154         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1155         v-browse-width = v-diasize-browse-handle :width
     1156       .
     1157       for each buf_temp-browse-handle
     1158         where buf_temp-browse-handle.browse-type = 'width':u
     1159       :
     1160         assign
     1161           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1162         .
     1163       end.
     1164       for each buf_temp-diasize-handle
     1165       :
     1166         delete buf_temp-diasize-handle .
     1167       end.
     1168       assign
     1169         v-field-group-handle = frame Dialog-Frame :first-child
     1170       .
     1171       do while valid-handle(v-field-group-handle)
     1172       :
     1173         assign
     1174           v-object-handle = v-field-group-handle :first-child
     1175         .
     1176         do while valid-handle(v-object-handle)
     1177         :
     1178           if  v-object-handle <> v-diasize-browse-handle :handle
     1179           and v-object-handle <> v-diasize-resize-button
     1180           and can-query(v-object-handle, "row")
     1181           and can-query(v-object-handle, "height")
     1182           and ( v-object-handle :col + v-object-handle :width
     1183                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1184               )
     1185           then do:
     1186             find first buf_temp-browse-handle
     1187               where buf_temp-browse-handle.browse-type   = 'width':u
     1188                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1189               no-error .
     1190             if available buf_temp-browse-handle
     1191             then do:
     1192             end.
     1193             else do:
     1194               create buf_temp-diasize-handle .
     1195               assign
     1196                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1197                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1198               .
     1199             end.
     1200           end.
     1201           assign
     1202             v-object-handle = v-object-handle :next-sibling
     1203           .
     1204         end.
     1205         assign
     1206           v-field-group-handle = v-field-group-handle :next-sibling
     1207         .
     1208       end.
     1209       do with frame Dialog-Frame
     1210       :
     1211         hide v-diasize-resize-button .
     1212         v-diasize-resize-button :row = 1.
     1213         v-diasize-resize-button :column = 1.
     1214       end.
     1215       if p-change-value > 0
     1216       then do:
     1217         if frame Dialog-Frame :scrollable = true
     1218         then do:
     1219           assign
     1220             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1221             no-error .
     1222           if error-status :error
     1223           or error-status :get-message(1) <> ""
     1224           then do:
     1225             undo move_block, retry move_block.
     1226           end.
     1227         end.
     1228         assign
     1229           frame Dialog-Frame :width = v-frame-width + p-change-value
     1230           no-error .
     1231         if error-status :error
     1232         or error-status :get-message(1) <> ""
     1233         then do:
     1234           undo move_block, retry move_block.
     1235         end.
     1236         assign
     1237           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1238         no-error .
     1239         if error-status :error
     1240         or error-status :get-message(1) <> ""
     1241         then do:
     1242           undo move_block, retry move_block.
     1243         end.
     1244         for each buf_temp-browse-handle
     1245           where buf_temp-browse-handle.browse-type = 'width':u
     1246         on error undo move_block, retry move_block
     1247         :
     1248           assign
     1249             buf_temp-browse-handle.browse-handle :width
     1250               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1251             no-error .
     1252           if error-status :error
     1253           or error-status :get-message(1) <> ""
     1254           then do:
     1255             undo move_block, retry move_block .
     1256           end.
     1257         end.
     1258         for each buf_temp-diasize-handle
     1259         on error undo move_block, retry move_block
     1260         :
     1261           assign
     1262             v-object-handle = buf_temp-diasize-handle.handle-value
     1263           .
     1264           if v-object-handle <> v-diasize-resize-button
     1265           then do:
     1266             assign
     1267               v-object-handle :col = v-object-handle :col + p-change-value
     1268               no-error .
     1269             if error-status :error
     1270             or error-status :get-message(1) <> ""
     1271             then do:
     1272               undo move_block, retry move_block .
     1273             end.
     1274           end.
     1275         end.
     1276       end.
     1277       else do:
     1278         for each buf_temp-diasize-handle
     1279         on error undo move_block, retry move_block
     1280         :
     1281           assign
     1282             v-object-handle = buf_temp-diasize-handle.handle-value
     1283           .
     1284           if v-object-handle <> v-diasize-resize-button
     1285           then do:
     1286             assign
     1287               v-object-handle :col = v-object-handle :col + p-change-value
     1288               no-error .
     1289             if error-status :error
     1290             or error-status :get-message(1) <> ""
     1291             then do:
     1292               undo move_block, retry move_block .
     1293             end.
     1294           end.
     1295         end.
     1296         for each buf_temp-browse-handle
     1297           where buf_temp-browse-handle.browse-type = 'width':u
     1298         on error undo move_block, retry move_block
     1299         :
     1300           assign
     1301             buf_temp-browse-handle.browse-handle :width
     1302               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1303             no-error .
     1304           if error-status :error
     1305           or error-status :get-message(1) <> ""
     1306           then do:
     1307             undo move_block, retry move_block .
     1308           end.
     1309         end.
     1310         assign
     1311           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1312           no-error .
     1313         if error-status :error
     1314         or error-status :get-message(1) <> ""
     1315         then do:
     1316           undo move_block, retry move_block.
     1317         end.
     1318         assign
     1319           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1320         no-error .
     1321         if error-status :error
     1322         or error-status :get-message(1) <> ""
     1323         then do:
     1324           undo move_block, retry move_block.
     1325         end.
     1326         if frame Dialog-Frame :scrollable = true
     1327         then do:
     1328           assign
     1329             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1330           no-error .
     1331           if error-status :error
     1332           or error-status :get-message(1) <> ""
     1333           then do:
     1334             undo move_block, retry move_block.
     1335           end.
     1336         end.
     1337       end.
     1338       if p-move-resize
     1339       then do:
     1340         run diasize_position-resize-button in this-procedure .
     1341       end.
     1342       if v-diasize-wndstore = true
     1343       then do:
     1344         if connected("ub") = true
     1345         then do:
     1346           define variable v-cntxt-db-num        as integer   no-undo .
     1347           define variable v-cntxt-userid        as character no-undo .
     1348           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1349                                             , OUTPUT v-cntxt-userid
     1350                                             ) .
     1351           run gbl/wndsizew.p
     1352             (input  v-cntxt-db-num
     1353             ,input  v-cntxt-userid
     1354             ,input  v-diasize-proc-name
     1355             ,input  'width':u
     1356             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1357             ) .
     1358         end.
     1359       end.
     1360     end.
     1361     assign
     1362       v-diasize-change-size = false
     1363     .
     1364   end procedure.
     1365   procedure diasize_set-width :
     1366     define input  parameter p-new-width  as decimal   no-undo .
     1367     define input  parameter p-move-resize as logical   no-undo .
     1368     do
     1369     on error undo, return error return-value
     1370     :
     1371       run diasize_change-width in this-procedure
     1372         (input  (p-new-width - frame Dialog-Frame :width)
     1373         ,input  p-move-resize
     1374         ) .
     1375     end.
     1376   end procedure.
     1377   procedure diasize_position-resize-button :
     1378     do with frame Dialog-Frame
     1379     :
     1380       hide v-diasize-resize-button .
     1381       assign
     1382         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1383                     - 1
     1384                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1385         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1386                     - 1
     1387                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1388       .
     1389       view v-diasize-resize-button .
     1390     end.
     1391   end procedure.
     1392   on alt-right anywhere
     1393   do:
     1394     run diasize_change-width in this-procedure
     1395       (input 1
     1396       ,input true
     1397       ) .
     1398     return no-apply .
     1399   end.
     1400   on alt-left anywhere
     1401   do:
     1402     run diasize_change-width in this-procedure
     1403       (input -1
     1404       ,input true
     1405       ) .
     1406     return no-apply .
     1407   end.
     1408   on alt-down anywhere
     1409   do:
     1410     run diasize_change-height in this-procedure
     1411       (input 1
     1412       ,input true
     1413       ) .
     1414     return no-apply .
     1415   end.
     1416   on alt-up anywhere
     1417   do:
     1418     run diasize_change-height in this-procedure
     1419       (input -1
     1420       ,input true
     1421       ) .
     1422     return no-apply .
     1423   end.
     1424   on alt-enter of frame Dialog-Frame
     1425   do:
     1426     run diasize_maximize in this-procedure
     1427       (input  ?
     1428       ).
     1429     return no-apply .
     1430   end.
     1431   procedure diasize_end-move :
     1432     do
     1433     on error undo, return error return-value
     1434     :
     1435       define variable v-row-delta as decimal   no-undo .
     1436       define variable v-col-delta as decimal   no-undo .
     1437       define variable v-new-row as decimal   no-undo .
     1438       define variable v-new-col as decimal   no-undo .
     1439       assign
     1440         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1441         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1442       .
     1443       assign
     1444         v-row-delta = v-new-row - frame Dialog-Frame :height
     1445         v-col-delta = v-new-col - frame Dialog-Frame :width
     1446       .
     1447       run diasize_change-height in this-procedure
     1448         (input v-row-delta
     1449         ,input true
     1450         ) .
     1451       run diasize_change-width in this-procedure
     1452         (input v-col-delta
     1453         ,input true
     1454         ) .
     1455     end.
     1456   end procedure.
     1457   procedure diasize_maximize :
     1458     define input  parameter p-action as logical   no-undo .
     1459     do
     1460     on error undo, return error return-value
     1461     :
     1462       if p-action = ?
     1463       then do:
     1464         if v-diasize-need-maximize = true
     1465         then do:
     1466           assign
     1467             p-action = true
     1468           .
     1469         end.
     1470         else do:
     1471           assign
     1472             p-action = false
     1473           .
     1474         end.
     1475       end.
     1476       if p-action = true
     1477       then do:
     1478         run diasize_change-height in this-procedure
     1479           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1480               - frame Dialog-Frame :height-chars
     1481           ,input true
     1482           ) .
     1483         run diasize_change-width in this-procedure
     1484           (input session :width-chars
     1485               - frame Dialog-Frame :width-chars
     1486           ,input true
     1487           ) .
     1488         assign
     1489           v-diasize-need-maximize = false
     1490         .
     1491       end.
     1492       else do:
     1493         run diasize_change-width in this-procedure
     1494           (input v-diasize-orig-frame-width
     1495               - frame Dialog-Frame :width-chars
     1496           ,input true
     1497           ) .
     1498         run diasize_change-height in this-procedure
     1499           (input v-diasize-orig-frame-height
     1500               - frame Dialog-Frame :height-chars
     1501           ,input true
     1502           ) .
     1503         assign
     1504           v-diasize-need-maximize = true
     1505         .
     1506       end.
     1507     end.
     1508   end procedure.
     1509   procedure diasize_restore-orig-size :
     1510     do
     1511     on error undo, return error return-value
     1512     :
     1513       assign
     1514         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1515         v-diasize-current-frame-height = frame Dialog-Frame :height
     1516       .
     1517       run diasize_set-height in this-procedure
     1518         (input  v-diasize-orig-frame-height
     1519         ,input  true
     1520         ) .
     1521       run diasize_set-width in this-procedure
     1522         (input  v-diasize-orig-frame-width
     1523         ,input  true
     1524         ) .
     1525     end.
     1526   end procedure.
     1527   procedure diasize_restore-current-size :
     1528     do
     1529     on error undo, return error return-value
     1530     :
     1531       run diasize_set-height in this-procedure
     1532         (input  v-diasize-current-frame-height
     1533         ,input  true
     1534         ) .
     1535       run diasize_set-width in this-procedure
     1536         (input  v-diasize-current-frame-width
     1537         ,input  true
     1538         ) .
     1539     end.
     1540   end procedure.
     1541   procedure diasize_set-browse-handle :
     1542     define input  parameter p-browse-handle as handle   no-undo .
     1543     define buffer buf_temp-browse-handle for temp-browse-handle .
     1544     do
     1545     on error undo, return error return-value
     1546     :
     1547       assign
     1548         v-diasize-browse-handle = p-browse-handle
     1549       .
     1550       for each buf_temp-browse-handle
     1551       on error undo, return error return-value
     1552       :
     1553         delete buf_temp-browse-handle .
     1554       end.
     1555     end.
     1556   end procedure.
     1557   procedure diasize_add_browse :
     1558     define input  parameter p-browse-type   as character no-undo .
     1559     define input  parameter p-browse-handle as handle    no-undo .
     1560     define buffer buf_temp-browse-handle for temp-browse-handle .
     1561     do
     1562     on error undo, return error return-value
     1563     :
     1564       assign
     1565         v-diasize-browse-number = v-diasize-browse-number + 1
     1566       .
     1567       create buf_temp-browse-handle .
     1568       assign
     1569         buf_temp-browse-handle.browse-type   = p-browse-type
     1570         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1571         buf_temp-browse-handle.browse-handle = p-browse-handle
     1572       .
     1573     end.
     1574   end procedure.
     1575   procedure diasize_init :
     1576     define variable v-default-value    as logical   no-undo .
     1577     define variable v-restore-saved    as logical   no-undo .
     1578     define variable v-resize-value-str as character no-undo .
     1579     do
     1580     on error undo, return error return-value
     1581     :
     1582       do with frame Dialog-Frame
     1583       :
     1584         assign
     1585           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1586           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1587           v-diasize-browse-handle     = browse BR-wth-gds :handle
     1588         .
     1589         create button v-diasize-resize-button
     1590         assign
     1591           parent        = frame Dialog-Frame :first-child
     1592           label         = "s"
     1593           height-pixels = 16
     1594           width-pixels  = 16
     1595           visible       = true
     1596           sensitive     = true
     1597           movable       = true
     1598           triggers:
     1599             on end-move persistent run diasize_end-move in this-procedure .
     1600           end triggers.
     1601         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1602         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1603         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1604         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1605         assign
     1606           v-diasize-wndmax = false
     1607         .
     1608         if connected("ub") = true
     1609         then do:
     1610           define variable v-cntxt-db-num        as integer   no-undo .
     1611           define variable v-cntxt-userid        as character no-undo .
     1612           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1613                                             , OUTPUT v-cntxt-userid
     1614                                             ) .
     1615           run gbl/wndpar_r.p
     1616             (input  v-cntxt-db-num
     1617             ,input  v-cntxt-userid
     1618             ,input  'wndmax':U
     1619             ,output v-diasize-wndmax
     1620             ,output v-default-value
     1621             ) .
     1622         end.
     1623         assign
     1624           v-diasize-wndstore = false
     1625         .
     1626         if connected("ub") = true
     1627         then do:
     1628           run gbl/wndpar_r.p
     1629             (input  v-cntxt-db-num
     1630             ,input  v-cntxt-userid
     1631             ,input  'wndstore':U
     1632             ,output v-diasize-wndstore
     1633             ,output v-default-value
     1634             ) .
     1635         end.
     1636         assign
     1637           v-diasize-proc-name = entry(1, program-name(2), '.')
     1638         .
     1639         if v-diasize-wndstore = true
     1640         then do:
     1641           assign
     1642             v-restore-saved = false
     1643           .
     1644           if connected("ub") = true
     1645           then do:
     1646             run gbl/wndsizer.p
     1647               (input  v-cntxt-db-num
     1648               ,input  v-cntxt-userid
     1649               ,input  v-diasize-proc-name
     1650               ,input  'height':u
     1651               ,output v-resize-value-str
     1652               ) .
     1653             if v-resize-value-str <> '':U
     1654             then do:
     1655               run diasize_change-height in this-procedure
     1656                 (input  integer(v-resize-value-str)
     1657                 ,input  true
     1658                 ) .
     1659               assign
     1660                 v-restore-saved = true
     1661               .
     1662             end.
     1663           end.
     1664           if connected("ub") = true
     1665           then do:
     1666             run gbl/wndsizer.p
     1667               (input  v-cntxt-db-num
     1668               ,input  v-cntxt-userid
     1669               ,input  v-diasize-proc-name
     1670               ,input  'width':u
     1671               ,output v-resize-value-str
     1672               ) .
     1673             if v-resize-value-str <> '':U
     1674             then do:
     1675               run diasize_change-width in this-procedure
     1676                 (input  integer(v-resize-value-str)
     1677                 ,input  true
     1678                 ) .
     1679               assign
     1680                 v-restore-saved = true
     1681               .
     1682             end.
     1683           end.
     1684           if v-restore-saved <> true
     1685           then do:
     1686             if v-diasize-wndmax = true
     1687             then do:
     1688               run diasize_maximize in this-procedure
     1689                 (input  true
     1690                 ) .
     1691             end.
     1692           end.
     1693         end.
     1694         else do:
     1695           if v-diasize-wndmax = true
     1696           then do:
     1697             run diasize_maximize in this-procedure
     1698               (input  true
     1699               ) .
     1700           end.
     1701         end.
     1702       end.
     1703     end.
     1704   end procedure.
     1705   procedure diasize_need-full-display :
     1706     define output parameter p-need-full-display as logical   no-undo .
     1707     do
     1708     on error undo, return error return-value
     1709     :
     1710       assign
     1711         p-need-full-display = v-diasize-need-full-display
     1712       .
     1713       assign
     1714         v-diasize-need-full-display = false
     1715       .
     1716     end.
     1717   end procedure.
     1718   procedure get-context :
     1719      define output parameter p-db-num as integer          no-undo.
     1720      define output parameter p-user-id as character        no-undo.
     1721      define variable v-login               as character    no-undo.
     1722      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1723      define buffer buf_user-login  for ub.user-login .
     1724      do
     1725      on error undo, return error
     1726      :
     1727            FIND FIRST buf_sys-ctrl no-lock.
     1728            ASSIGN
     1729               v-login = USERID("ub")
     1730               p-db-num = buf_sys-ctrl.db-num
     1731            .
     1732            FIND FIRST buf_user-login
     1733                 WHERE buf_user-login.db-num = p-db-num
     1734                   AND buf_user-login.user-login = v-login
     1735                 no-lock
     1736                 no-error
     1737                 .
     1738            IF AVAILABLE buf_user-login
     1739            THEN DO:
     1740               assign
     1741                  p-user-id = buf_user-login.user-id
     1742               .
     1743            END.
     1744      end.
     1745   end procedure.
     1746       run diasize_init in this-procedure .
     1747   MAIN-BLOCK:
     1748   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1749      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1750    IF lookup(par-mode, 'ДОБАВЛЕНИЕ':U + chr(44) +
     1751                         'ИЗМЕНЕНИЕ':U + chr(44) +
     1752                         'ПРОСМОТР':U) = 0 THEN DO:
     1753       MESSAGE
     1754       "Неверное значение параметра par-mode" par-mode
     1755       VIEW-AS ALERT-BOX ERROR.
     1756       UNDO main-block, RETURN ERROR.
     1757     END.
     1758   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     1759     (input  'ser-wth'
     1760     ,input  0
     1761     ,input  ''
     1762     ,input  0
     1763     ,input  ''
     1764     ,input  ''
     1765     ,input  ''
     1766     ,input  NO
     1767     ,output conf-par
     1768     ,output par-type
     1769     ) no-error .
     1770       IF not error-status:error then
     1771       assign
     1772       ser-wth = (conf-par = "yes":U).
     1773     RUN Myenable no-error.
     1774     if error-status:error then return error.
     1775     WAIT-FOR GO OF FRAME Dialog-Frame.
     1776   END.
     1777   RUN disable_UI.
     1778   PROCEDURE ch-units :
     1779   define variable ref-rec as recid no-undo .
     1780      run ref/units.w ( input parparentproc, input yes, output ref-rec ).
     1781       if ref-rec = ? then do:
     1782               apply "entry" to b-unit in frame Dialog-Frame.
     1783               return no-apply.
     1784       end.
     1785       FIND ub.units WHERE recid (ub.units) = ref-rec NO-LOCK.
     1786       DISPLAY ub.units.unit-name @ tt-wealth.unit-base with frame Dialog-Frame.
     1787   END PROCEDURE.
     1788   PROCEDURE disable_UI :
     1789     HIDE FRAME Dialog-Frame.
     1790   END PROCEDURE.
     1791   PROCEDURE enable_UI :
     1792     OPEN QUERY Dialog-Frame FOR EACH tt-wealth SHARE-LOCK.
     1793     GET FIRST Dialog-Frame.
     1794     DISPLAY FILL-IN-1 fcurr-abbr
     1795         WITH FRAME Dialog-Frame.
     1796     IF AVAILABLE tt-wealth THEN
     1797       DISPLAY tt-wealth.wth-name tt-wealth.is-money tt-wealth.curr-code
     1798             tt-wealth.unit-base tt-wealth.get-qnty-method tt-wealth.is-ser
     1799             tt-wealth.PS tt-wealth.wth-code
     1800         WITH FRAME Dialog-Frame.
     1801     ENABLE B-exit b-quit B-hist B-Help tt-wealth.wth-name tt-wealth.is-money
     1802            tt-wealth.curr-code tt-wealth.unit-base B-unit B-curr FILL-IN-1
     1803            tt-wealth.get-qnty-method b-del tt-wealth.PS tt-wealth.wth-code
     1804            fcurr-abbr
     1805         WITH FRAME Dialog-Frame.
     1806     VIEW FRAME Dialog-Frame.
     1807     OPEN QUERY BR-wth-gds FOR EACH tt-wth-gds       WHERE tt-wth-gds.stts = 0 NO-LOCK,       EACH ub.goods WHERE TRUE        AND ub.goods.gds-code = tt-wth-gds.gds-code NO-LOCK INDEXED-REPOSITION.
     1808   END PROCEDURE.
     1809   PROCEDURE GdsEnable :
     1810   IF ser-wth and tt-wealth.is-ser:SCREEN-VALUE IN FRAME Dialog-Frame = '1' AND CAN-FIND(FIRST tt-wth-gds NO-LOCK where tt-wth-gds.stts = 0) THEN DO WITH FRAME Dialog-Frame:
     1811       DISABLE b-add .
     1812       if par-mode = 'ДОБАВЛЕНИЕ':U then ENABLE b-chg b-del BR-wth-gds.
     1813       else disable b-chg b-del BR-wth-gds.
     1814   END.
     1815   ELSE IF ser-wth and tt-wealth.is-ser:SCREEN-VALUE = '1'  THEN DO WITH FRAME Dialog-Frame:
     1816       ENABLE b-add.
     1817       DISABLE b-chg b-del WITH FRAME Dialog-Frame.
     1818   END.
     1819   ELSE DISABLE BR-wth-gds b-add b-chg b-del WITH FRAME Dialog-Frame.
     1820   apply 'entry':U to   BR-wth-gds in frame Dialog-Frame.
     1821   END PROCEDURE.
     1822   PROCEDURE MyEnable :
     1823   define variable v-list-items as character no-undo.
     1824   define variable v-ii as integer no-undo.
     1825     if par-mode = 'ИЗМЕНЕНИЕ':U or par-mode = 'ПРОСМОТР':U then do:
     1826       IF par-mode = 'ИЗМЕНЕНИЕ':U THEN FIND FIRST locked_wealth Exclusive-lock where
     1827                   locked_wealth.wth-code = pwth-code NO-ERROR.
     1828       ELSE FIND FIRST locked_wealth NO-LOCK where
     1829                   locked_wealth.wth-code = pwth-code NO-ERROR.
     1830       if not avail locked_wealth then do:
     1831           message vss-workfile vss-revision vss-description skip
     1832           "Не найдена материальная ценность с кодом " pwth-code
     1833           view-as alert-box error.
     1834           return error.
     1835       end.
     1836       if locked_wealth.curr-code <> ? then do:
     1837           FIND FIRST ub.currency No-LOCK WHERE
     1838                       ub.currency.curr-code = locked_wealth.curr-code NO-ERROR.
     1839           if not avail ub.currency then do:
     1840              message vss-workfile vss-revision vss-description skip
     1841              "Не найдена валюта с кодом " locked_wealth.curr-code
     1842              "для материальной ценности с кодом " pwth-code
     1843               view-as alert-box error.
     1844               return error.
     1845           end.
     1846       end.
     1847       else if locked_wealth.is-ser = 0 then do:
     1848           FIND FIRST ub.units NO-LOCK WHERE
     1849                      ub.units.unit-name = locked_wealth.unit-base No-ERROR.
     1850           if not avail ub.units then do:
     1851              message vss-workfile vss-revision vss-description skip
     1852              "Не найдена единица измерения " locked_wealth.unit-base
     1853              "для материальной ценности с кодом " pwth-code
     1854               view-as alert-box error.
     1855           end.
     1856       end.
     1857       FOR EACH ub.wth-gds NO-LOCK WHERE ub.wth-gds.wth-code = Locked_wealth.wth-code:
     1858           CREATE tt-wth-gds.
     1859           BUFFER-COPY wth-gds TO tt-wth-gds.
     1860       END.
     1861       IF LOCKED_wealth.is-ser = 1 THEN DO:
     1862           FIND FIRST LOCKED_wth-gds WHERE LOCKED_wth-gds.wth-code = LOCKED_wealth.wth-code EXCLUSIVE-LOCK NO-ERROR.
     1863           if not avail locked_wth-gds then do:
     1864           message vss-workfile vss-revision vss-description skip
     1865           substitute("Не найдена связь МЦ (&1) с товарами",LOCKED_wealth.wth-code )
     1866           view-as alert-box error.
     1867           return error.
     1868       end.
     1869       END.
     1870       CREATE tt-wealth.
     1871       BUFFER-COPY LOCKED_wealth TO tt-wealth.
     1872     end.
     1873   IF par-mode = 'ДОБАВЛЕНИЕ':U THEN do:
     1874       CREATE tt-wealth.
     1875       tt-wealth.curr-code = ?.
     1876   END.
     1877   do v-ii = 1 to num-entries('=sum,=1,=val-qnty':U):
     1878     v-list-items = v-list-items + (if v-ii = 1 then '' else chr(44)) +
     1879                     entry(v-ii, '=Сумма,=1,По номиналу и кол-ву':U) + chr(44) +
     1880                     entry(v-ii, '=sum,=1,=val-qnty':U).
     1881   end.
     1882   assign
     1883   tt-wealth.get-qnty-method:radio-buttons in frame Dialog-Frame = v-list-items
     1884   .
     1885   if par-mode = 'ДОБАВЛЕНИЕ':U then do:
     1886     assign
     1887     tt-wealth.get-qnty-method = '=sum':U.
     1888   end.
     1889   DISPLAY
     1890   tt-wealth.wth-code
     1891   tt-wealth.wth-name
     1892   tt-wealth.curr-code
     1893   tt-wealth.is-money
     1894   tt-wealth.PS
     1895   tt-wealth.is-ser
     1896   tt-wealth.unit-base WHEN (NOT tt-wealth.is-money )
     1897   tt-wealth.get-qnty-method
     1898   (if avail currency then currency.curr-abbr else "" ) @ fcurr-abbr
     1899   WITH FRAME Dialog-Frame
     1900     .
     1901   if not ser-wth then hide tt-wealth.is-ser BR-wth-gds b-add b-chg b-del BR-wth-gds in frame   Dialog-Frame.
     1902   else view tt-wealth.is-ser BR-wth-gds b-add b-chg b-del BR-wth-gds in frame   Dialog-Frame.
     1903   frame Dialog-Frame:title = frame Dialog-Frame:title + chr(32) + par-mode.
     1904   if par-mode = 'ПРОСМОТР':U then
     1905   enable b-quit  b-help b-hist WITH FRAME Dialog-Frame .
     1906   else do:
     1907     ENABLE
     1908     B-exit
     1909     b-quit
     1910     B-Help
     1911     tt-wealth.is-money when par-mode = 'ДОБАВЛЕНИЕ':U
     1912     b-unit when (par-mode = 'ДОБАВЛЕНИЕ':U OR (NOT tt-wealth.is-money ))
     1913     tt-wealth.unit-base when (par-mode = 'ДОБАВЛЕНИЕ':U OR (NOT tt-wealth.is-money ))
     1914     tt-wealth.wth-name
     1915     tt-wealth.ps
     1916     b-hist WHEN par-mode <> 'ДОБАВЛЕНИЕ':U
     1917     tt-wealth.is-ser WHEN (par-mode = 'ДОБАВЛЕНИЕ':U AND ser-wth)
     1918     tt-wealth.get-qnty-method when par-mode <> 'ПРОСМОТР':U
     1919     WITH FRAME Dialog-Frame.
     1920   end.
     1921   VIEW FRAME Dialog-Frame.
     1922     OPEN QUERY BR-wth-gds FOR EACH tt-wth-gds       WHERE tt-wth-gds.stts = 0 NO-LOCK,       EACH ub.goods WHERE TRUE        AND ub.goods.gds-code = tt-wth-gds.gds-code NO-LOCK INDEXED-REPOSITION.
     1923     APPLY "entry":U to tt-wealth.wth-name.
     1924   END PROCEDURE.
     1925   PROCEDURE proc-save :
     1926   DEFINE VARIABLE v-rec AS RECID NO-UNDO.
     1927   DEF VAR wg-rec AS RECID NO-UNDO.
     1928   IF par-mode = 'ПРОСМОТР':U THEN UNDO, RETURN ERROR.
     1929   ASSIGN FRAME Dialog-Frame
     1930   tt-wealth.curr-code
     1931   tt-wealth.is-money
     1932   tt-wealth.is-ser
     1933   tt-wealth.unit-base
     1934   tt-wealth.wth-name
     1935   fcurr-abbr
     1936   tt-wealth.get-qnty-method
     1937   .
     1938   IF tt-wealth.is-ser = 1 AND NOT CAN-FIND(FIRST tt-wth-gds NO-LOCK where tt-wth-gds.stts = 0) THEN DO:
     1939       MESSAGE 'Для серийной МЦ должен быть указан товар!' VIEW-AS ALERT-BOX ERROR.
     1940       APPLY 'entry':U TO b-add.
     1941       RETURN NO-APPLY.
     1942   END.
     1943   save-block: do transaction  on error undo save-block, return error
     1944   on stop undo  save-block, return error
     1945   on endkey undo save-block, return error :
     1946     if available locked_wealth then v-rec = recid(locked_wealth).
     1947     run ref/wealth.p ( INPUT par-mode
     1948                         ,INPUT NO
     1949                         ,INPUT-OUTPUT v-rec
     1950                         ,INPUT tt-wealth.wth-code
     1951                         ,INPUT tt-wealth.is-money
     1952                         ,INPUT tt-wealth.is-ser
     1953                         ,INPUT (if tt-wealth.is-money
     1954                                 then fcurr-abbr
     1955                                 else tt-wealth.unit-base )
     1956                         ,INPUT tt-wealth.curr-code
     1957                         ,INPUT tt-wealth.wth-name
     1958                         ,INPUT tt-wealth.get-qnty-method
     1959                         ,INPUT tt-wealth.ps ) NO-ERROR.
     1960     if error-status:error then do:
     1961   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1962   define variable fh as widget-handle no-undo .
     1963   define variable hh as widget-handle no-undo .
     1964   define variable rv as character no-undo .
     1965   assign
     1966   rv = entry(1, return-value , chr(4)).
     1967   if rv <> "":U then do:
     1968     assign
     1969     fh = frame Dialog-Frame:first-child
     1970     hh = fh:first-child
     1971     .
     1972     do while valid-handle(hh):
     1973       if hh:name = rv then do:
     1974         APPLY "ENTRY" to hh.
     1975         undo ,
     1976         return error.
     1977       end.
     1978       hh = hh:next-sibling.
     1979     end.
     1980   end.
     1981       undo save-block, return error.
     1982     end.
     1983     p-rec = v-rec.
     1984     IF tt-wealth.is-ser = 0 THEN LEAVE.
     1985     if par-mode = 'ДОБАВЛЕНИЕ':U then find first locked_wealth where recid(locked_wealth) = v-rec exclusive-lock.
     1986       FIND FIRST tt-wth-gds.
     1987       IF AVAILABLE locked_wth-gds AND LOCKED_wth-gds.gds-code <> tt-wth-gds.gds-code THEN do:
     1988           wg-rec = RECID(locked_wth-gds).
     1989           run ref/wth-gds.p ( INPUT par-mode
     1990                             ,INPUT YES
     1991                             ,INPUT-OUTPUT wg-rec
     1992                             ,INPUT locked_wealth.wth-code
     1993                             ,INPUT tt-wth-gds.gds-code
     1994                             ,INPUT 1 )  NO-ERROR.
     1995           if error-status:error then do:
     1996            MESSAGE error-status:get-message(1) SKIP RETURN-VALUE VIEW-AS ALERT-BOX ERROR.
     1997            undo, return error.
     1998           end.
     1999           wg-rec = ?.
     2000           run ref/wth-gds.p ( INPUT par-mode
     2001                             ,INPUT YES
     2002                             ,INPUT-OUTPUT wg-rec
     2003                             ,INPUT locked_wealth.wth-code
     2004                             ,INPUT tt-wth-gds.gds-code
     2005                             ,INPUT 0 )  NO-ERROR.
     2006           if error-status:error then do:
     2007            MESSAGE error-status:get-message(1) SKIP RETURN-VALUE VIEW-AS ALERT-BOX ERROR.
     2008            undo, return error.
     2009           end.
     2010       END.
     2011       IF NOT AVAILABLE LOCKED_wth-gds THEN DO:
     2012           run ref/wth-gds.p ( INPUT par-mode
     2013                             ,INPUT NO
     2014                             ,INPUT-OUTPUT wg-rec
     2015                             ,INPUT locked_wealth.wth-code
     2016                             ,INPUT tt-wth-gds.gds-code
     2017                             ,INPUT tt-wth-gds.stts ) NO-ERROR.
     2018         if error-status:error then do:
     2019           undo, return error.
     2020         end.
     2021       END.
     2022   end.
     2023   END PROCEDURE.
