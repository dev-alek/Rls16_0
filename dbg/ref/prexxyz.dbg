      822   def var vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      823   define temp-table temp-param no-undo   field param-code     as character   field param-sub-code as character   field param-value    as character   index xpk is primary unique param-code param-sub-code   .
      824   procedure paramls-clear :
      825     define buffer buf_temp-param for temp-param .
      826     do
      827     on error undo, return error return-value
      828     :
      829       for each buf_temp-param
      830       on error undo, return error
      831       :
      832         delete buf_temp-param .
      833       end.
      834     end.
      835   end procedure.
      836   procedure paramls-write :
      837     define input  parameter p-code     as character no-undo .
      838     define input  parameter p-sub-code as character no-undo .
      839     define input  parameter p-value    as character no-undo .
      840     define buffer buf_temp-param for temp-param .
      841     do
      842     on error undo, return error return-value
      843     :
      844       find first buf_temp-param
      845         where buf_temp-param.param-code     = p-code
      846           and buf_temp-param.param-sub-code = p-sub-code
      847         no-error .
      848       if not available buf_temp-param then do:
      849         create buf_temp-param .
      850         assign
      851           buf_temp-param.param-code     = p-code
      852           buf_temp-param.param-sub-code = p-sub-code
      853         .
      854       end.
      855       assign
      856         buf_temp-param.param-value = p-value
      857       .
      858     end.
      859   end procedure.
      860   procedure paramls-read :
      861     define input  parameter p-code          as character no-undo .
      862     define input  parameter p-sub-code      as character no-undo .
      863     define input  parameter p-default-value as character no-undo .
      864     define output parameter p-value         as character no-undo .
      865     define buffer buf_temp-param for temp-param .
      866     do
      867     on error undo, return error return-value
      868     :
      869       find first buf_temp-param
      870         where buf_temp-param.param-code     = p-code
      871           and buf_temp-param.param-sub-code = p-sub-code
      872         no-error .
      873       if available buf_temp-param then do:
      874         assign
      875           p-value = buf_temp-param.param-value
      876         .
      877       end.
      878       else do:
      879         assign
      880           p-value = p-default-value
      881         .
      882       end.
      883     end.
      884   end procedure.
      885   procedure paramls-append :
      886     define input  parameter p-code     as character no-undo .
      887     define input  parameter p-sub-code as character no-undo .
      888     define input  parameter p-value    as character no-undo .
      889     define buffer buf_temp-param for temp-param .
      890     do
      891     on error undo, return error return-value
      892     :
      893       find first buf_temp-param
      894            where buf_temp-param.param-code     = p-code
      895              and buf_temp-param.param-sub-code = p-sub-code
      896         no-error .
      897       if not available buf_temp-param then do:
      898         create buf_temp-param .
      899         assign
      900           buf_temp-param.param-code     = p-code
      901           buf_temp-param.param-sub-code = p-sub-code
      902           buf_temp-param.param-value    = p-value
      903         .
      904       end.
      905       else do:
      906           assign
      907               buf_temp-param.param-value = buf_temp-param.param-value + ",":U + p-value
      908           .
      909       end.
      910     end.
      911   end procedure.
      912   function excel-format-dec-to-char returns char (input p-dec as decimal ).
      913     if num-entries(string(p-dec), '.') = 2
      914       then return( entry(1, string(p-dec), '.') + v-delim + entry(2, string(p-dec), '.')) .
      915       else return( string(p-dec)) .
      916   end function.
      917   function format-point-to-comma returns char (input orig as char ) .
      918   define variable rtext as character no-undo .
      919   define variable strt as integer no-undo .
      920   define variable leng as integer no-undo .
      921   assign rtext = orig .
      922   repeat:
      923     strt =  index(rtext,'.').
      924     if strt = 0 then leave.
      925     leng = 1.
      926     substring(rtext,strt,leng,"character") = v-delim .
      927   end.
      928   return rtext.
      929   end function.
      930   function format-excel-text returns char ( input start-text as char ) :
      931   def var  i    as int no-undo.
      932   def var  ch   as char no-undo.
      933   def var  n    as int no-undo.
      934   def var  ipos as int no-undo.
      935     n = num-entries(trim(start-text), chr(10)) - 1 .
      936     do i = 1 to n :
      937       ipos = index( start-text, chr(10)).
      938       if ipos > 0 then
      939         substr( start-text, ipos, 1 ) = ' '.
      940     end.
      941     n = num-entries(trim(start-text), chr(13)) - 1 .
      942     do i = 1 to n :
      943       ipos = index( start-text, chr(13)).
      944       if ipos > 0 then
      945         substr( start-text, ipos, 1 ) = ' '.
      946     end.
      947     if index( start-text, '"' ) = 0 then
      948       start-text =  '="'   + trim( start-text) + '"'   .
      949       else do:
      950         n = num-entries(trim(start-text), '"') - 1.
      951         do i = 1 to n :
      952           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
      953         end.
      954         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
      955         start-text = '="'  + ch  + '"' .
      956       end.
      957     return start-text.
      958   end.
      959   function excel-sum returns char (input p-dec as decimal ).
      960     return(format-excel-text(excel-format-dec-to-char(round(p-dec,2)))) .
      961   end function.
      962   function excel-qnty returns char (input p-dec as decimal ).
      963     return(format-excel-text(excel-format-dec-to-char(round(p-dec,3)))) .
      964   end function.
      965   function format-excel-text-macr returns char ( input start-text as char ) :
      966   def var  i    as int no-undo.
      967   def var  ch   as char no-undo.
      968   def var  n    as int no-undo.
      969   def var  ipos as int no-undo.
      970     n = num-entries(trim(start-text), chr(10)) - 1 .
      971     do i = 1 to n :
      972       ipos = index( start-text, chr(10)).
      973       if ipos > 0 then
      974         substring( start-text, ipos , 1 ) = ' '.
      975     end.
      976     n = num-entries(trim(start-text), chr(13)) - 1 .
      977     do i = 1 to n :
      978       ipos = index( start-text, chr(13)).
      979       if ipos > 0 then
      980         substring( start-text, ipos, 1 ) = ' '.
      981     end.
      982     if index( start-text, '"' ) = 0 then
      983       start-text =  '"'   + trim( start-text) + '"'   .
      984       else do:
      985         n = num-entries(trim(start-text), '"') - 1.
      986         do i = 1 to n :
      987           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
      988         end.
      989         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
      990         start-text = '"'  + ch  + '"' .
      991       end.
      992     n = num-entries(trim(start-text), chr(10)) - 1 .
      993     do i = 1 to n :
      994       ipos = index( start-text, chr(10)).
      995       if ipos > 0 then
      996         substring( start-text, ipos , 1 ) = ' '.
      997     end.
      998       if num-entries(trim(start-text), chr(10)) > 1 then  message num-entries(trim(start-text), chr(10)) start-text.
      999     return start-text.
     1000   end.
     1001   def var vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1002   function func-get-name-from-ext-type   returns char
     1003     ( p-ext-type as character   ,
     1004       p-caps     as logical ).
     1005   define variable v-ext-name as character no-undo .
     1006   run get-name-from-ext-type in this-procedure (
     1007       input p-ext-type  ,
     1008       input p-caps  ,
     1009       output v-ext-name )
     1010       no-error .
     1011       if error-status :error then do:
     1012          assign
     1013            v-ext-name = p-ext-type
     1014          .
     1015       end.
     1016    return (v-ext-name) .
     1017   end.
     1018   procedure get-name-from-ext-type :
     1019    do
     1020    on error undo, return error return-value
     1021    :
     1022   define input  parameter p-ext-type as character no-undo .
     1023   define input  parameter p-caps     as logical no-undo   .
     1024   define output parameter p-ext-name as character no-undo .
     1025   define variable v-num as integer no-undo .
     1026     if lookup ( p-ext-type , 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U ) = 0 then do :
     1027       message
     1028         vss-include-info10 skip
     1029         "Неправильно задано значение входящего параметра! "
     1030         "Нет такого типа документов " p-ext-type
     1031         view-as alert-box error .
     1032         undo, return error .
     1033     end.
     1034     v-num      = lookup ( p-ext-type , 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U ) .
     1035     p-ext-name = entry  ( v-num , 'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U ) .
     1036     if p-caps  = true then do :
     1037        p-ext-name = caps(substring(p-ext-name,1,1) ) + substring(p-ext-name, 2 , length (p-ext-name) - 1 ) .
     1038     end .
     1039     end.
     1040   end procedure.
     1041   Make-Excel      = true.
     1042   Make-Excel-com  = false .
     1043   define buffer buf_xyz-analysis            for ub.xyz-analysis.
     1044   define buffer buf_xyz-analysis-goods      for ub.xyz-analysis-goods.
     1045   define buffer buf_xyz-analysis-gds-obj    for ub.xyz-analysis-gds-obj.
     1046   define buffer buf_xyz-analysis-obj        for ub.xyz-analysis-obj.
     1047   define buffer buf_assortment-matrix       for ub.assortment-matrix.
     1048   define buffer buf_assortment-matrix-goods for ub.assortment-matrix-goods.
     1049   define buffer buf_gds-obj-prop            for ub.gds-obj-prop.
     1050   define buffer buf_criterion-analysis      for ub.criterion-analysis.
     1051   DEFINE temp-table temp-str no-undo
     1052     field   gds-code           as integer
     1053     field   artic              as char
     1054     field   gds-name           as char
     1055     field   acc_min            as char
     1056     field   acc_matr           as char
     1057     field   izt                as char
     1058   .
     1059   define temp-table temp-abc no-undo
     1060     field nn           as integer
     1061     field id           as integer
     1062     field  db-num      like ub.xyz-analysis.db-num
     1063     field  name        like ub.xyz-analysis.xyz-name
     1064     field  des         like ub.xyz-analysis.xyz-des
     1065     field  name-cral   like ub.criterion-analysis.cral-name
     1066     field  A           like ub.xyz-analysis.xyz-x
     1067     field  B           like ub.xyz-analysis.xyz-y
     1068     field  C           like ub.xyz-analysis.xyz-z
     1069     field  date-cr     like ub.xyz-analysis.xyz-date-create
     1070     field  period       as character
     1071     field  ext-doc-type as character
     1072     field  obj          as character
     1073     index pi nn
     1074     index pi2 id db-num
     1075   .
     1076   define variable var-i as integer   no-undo .
     1077   define variable var-kol as integer   no-undo .
     1078   var-kol = num-entries (p-rez).
     1079   repeat var-i = 1 to var-kol :
     1080      find first buf_xyz-analysis no-lock where recid(buf_xyz-analysis) = int(entry(var-i,p-rez )) no-error .
     1081      if not available buf_xyz-analysis  then next.
     1082      find first  buf_criterion-analysis no-lock where buf_criterion-analysis.cral-id = buf_xyz-analysis.cral-id no-error .
     1083      if not available buf_criterion-analysis  then next.
     1084       create temp-abc.
     1085       assign
     1086       temp-abc.nn           = var-i
     1087       temp-abc.id           = buf_xyz-analysis.xyz-id
     1088       temp-abc.db-num       = buf_xyz-analysis.db-num
     1089       temp-abc.name         = buf_xyz-analysis.xyz-name
     1090       temp-abc.des          = buf_xyz-analysis.xyz-des
     1091       temp-abc.name-cral   = buf_criterion-analysis.cral-name
     1092       temp-abc.A           = buf_xyz-analysis.xyz-x
     1093       temp-abc.B           = buf_xyz-analysis.xyz-y
     1094       temp-abc.C           = buf_xyz-analysis.xyz-z
     1095       temp-abc.date-cr     = buf_xyz-analysis.xyz-date-create
     1096       temp-abc.period      = buf_xyz-analysis.xyz-string-period
     1097       temp-abc.ext-doc-type = ""
     1098       .
     1099       define buffer buf_xyz-analysis-doc for ub.xyz-analysis-doc.
     1100        for each buf_xyz-analysis-doc no-lock where
     1101                 buf_xyz-analysis-doc.xyz-id = buf_xyz-analysis.xyz-id and
     1102                 buf_xyz-analysis-doc.db-num = buf_xyz-analysis.db-num
     1103        :
     1104        temp-abc.ext-doc-type = temp-abc.ext-doc-type + func-get-name-from-ext-type (buf_xyz-analysis-doc.xyzd-ext-doc-type , true ) + "," .
     1105        end.
     1106        for each buf_xyz-analysis-obj no-lock where
     1107                 buf_xyz-analysis-obj.xyz-id = buf_xyz-analysis.xyz-id and
     1108                 buf_xyz-analysis-obj.db-num = buf_xyz-analysis.db-num
     1109        :
     1110        temp-abc.obj = temp-abc.obj +  buf_xyz-analysis-obj.obj-type + " " + string(buf_xyz-analysis-obj.obj-code) + "," .
     1111        end.
     1112   end.
     1113   define stream  macr_excel .
     1114   define variable g#report-num  as integer   no-undo .
     1115   define variable v-file-name as character no-undo .
     1116   define variable p-file-name as character no-undo .
     1117   define variable v-ind       as integer   no-undo .
     1118   define variable num#col#    as integer no-undo .
     1119   define variable C-c         as integer no-undo .
     1120   define variable C-str       as character no-undo .
     1121   define variable str--1      as character Format "x(60)" no-undo.
     1122   define variable str--2      as integer no-undo .
     1123   define variable C-i         as integer no-undo .
     1124   define variable p-var       as integer no-undo .
     1125   define variable var-1       as integer no-undo .
     1126   define variable var-2       as integer no-undo .
     1127   def buffer buf_clients for ub.clients .
     1128   def buffer This_Object for ub.clients .
     1129   def buffer buf_goods   for ub.goods .
     1130   define variable qnty as decimal   no-undo .
     1131   define variable sum  as decimal   no-undo .
     1132   define variable vv-qnty1 as decimal   no-undo .
     1133   define variable vv-qnty2 as decimal   no-undo .
     1134   define variable num-ln as integer   no-undo .
     1135   def var i as int no-undo.
     1136   def var j as int no-undo.
     1137   define variable Counter1 as integer init 0  no-undo .
     1138   def var LineBuf       as char    no-undo.
     1139   def var Line       as char    no-undo.
     1140   def var UndLine    as char    no-undo.
     1141   def var Lines_Counter as   int  init 0  no-undo.
     1142   def var Tmp_Counter   as   int  init 0  no-undo.
     1143   def var tdoc-date     as date      no-undo .
     1144   def var tdoc-code     as character no-undo .
     1145   def var  abbr              as  char no-undo.
     1146   def var  pp                as  char no-undo.
     1147     if session:set-wait-state("compiler") then.
     1148     define variable v-prn0 as character no-undo .
     1149     if var-report-r-b = "rubl" then assign pp = "Цены руб.".
     1150                                else assign pp = "Цены  баз.вал." .
     1151   define variable v-account as integer init 0 no-undo .
     1152   define variable v-account-lavel as character no-undo .
     1153   define variable v-button-stop as logical no-undo .
     1154   define variable v-kol-spice as integer no-undo .
     1155   define variable v-kol-spice2 as integer no-undo .
     1156   define variable v-kol-spice3 as integer no-undo .
     1157   DEFINE VARIABLE StopProcessing AS LOGICAL NO-UNDO.
     1158   DEFINE BUTTON StopBtn AUTO-END-KEY
     1159        LABEL "Стоп"
     1160        SIZE 10 BY 1.
     1161   DEFINE VARIABLE RecordsDone AS INTEGER FORMAT ">,>>>,>>>,>>9":U INITIAL 0
     1162        LABEL "Обработано записей"
     1163         VIEW-AS TEXT
     1164        SIZE 14 BY .67 NO-UNDO.
     1165   DEFINE VARIABLE RecordsString AS CHARACTER FORMAT "X(60)"
     1166         VIEW-AS TEXT
     1167        SIZE 53.25 BY .67
     1168        FGCOLOR 1  NO-UNDO.
     1169   DEFINE VARIABLE RecordsString2 AS CHARACTER FORMAT "X(60)"
     1170         VIEW-AS TEXT
     1171        SIZE 53.25 BY .67
     1172        FGCOLOR 1  NO-UNDO.
     1173   DEFINE VARIABLE RecordsString3 AS CHARACTER FORMAT "X(60)"
     1174         VIEW-AS TEXT
     1175        SIZE 53.25 BY .67
     1176        FGCOLOR 1  NO-UNDO.
     1177   DEFINE RECTANGLE RECT-1
     1178        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     1179        SIZE 55.13 BY 4.46.
     1180   DEFINE FRAME InfoFrame
     1181        StopBtn AT ROW 4.25 COL 21.75
     1182        RecordsString AT ROW 1.21 COL 2 NO-LABEL
     1183        RecordsString2 AT ROW 1.96 COL 2 NO-LABEL
     1184        RecordsString3 AT ROW 2.58 COL 2 NO-LABEL
     1185        RecordsDone AT ROW 3.42 COL 24.88 COLON-ALIGNED
     1186        RECT-1 AT ROW 1 COL 1
     1187       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1188            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1189            TITLE "Процесс"
     1190            DEFAULT-BUTTON StopBtn CANCEL-BUTTON StopBtn.
     1191   define variable mFrameView      as logical   no-undo init yes.
     1192     define variable mFramHandle as handle no-undo.
     1193     mFramHandle = frame InfoFrame:handle.
     1194     if  log-manager:logfile-name ne ?
     1195     then DO:
     1196         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1197         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1198         log-manager:write-message("visible-frame-mod=" + string(mFramHandle:visible), "frameRepError").
     1199     end.
     1200     mFrameView = not session:batch-mode and mFramHandle:visible.
     1201     if mFrameView
     1202     then do:
     1203       ASSIGN
     1204          FRAME InfoFrame:HIDDEN                           = TRUE
     1205          StopBtn:sensitive IN FRAME InfoFrame             = TRUE.
     1206     end.
     1207   ON CHOOSE OF StopBtn IN FRAME InfoFrame
     1208   DO:
     1209     IF not StopProcessing THEN
     1210       Message "Вы действительно хотите прервать" SKIP
     1211               "процесс проверки?" view-as alert-box QUESTION BUTTONS yes-no
     1212                 UPDATE StopProcessing.
     1213     IF StopProcessing THEN do:
     1214        if mFrameView
     1215        then do:
     1216           HIDE FRAME InfoFrame.
     1217        end.
     1218     End.
     1219   END.
     1220   assign v-account = ( if integer( 25 ) = 0 then 100 else integer( 25 ) ).
     1221     if  log-manager:logfile-name ne ?
     1222     then DO:
     1223         log-manager:write-message("ON mFrameView=" + string(mFrameView), "frameRepError").
     1224     end.
     1225     if not session:batch-mode then
     1226     do:
     1227       VIEW FRAME InfoFrame.
     1228       mFrameView = true.
     1229     end.
     1230      v-button-stop = false .
     1231         if mFrameView
     1232         then do:
     1233         if v-button-stop then view STOPBTN in frame InfoFrame.
     1234                          else Hide STOPBTN in frame InfoFrame.
     1235         end.
     1236   v-ind = 0    .
     1237       Output stream Macr_Excel  close .
     1238       num#str# = 0 .
     1239       run gbl/_tmpfile.p ( "wb", ".txt", output v-file-name) .
     1240       output stream macr_excel to value(v-file-name)   .
     1241       v-ind = v-ind + 1.
     1242    run get-report-num  in parParentProc(output g#report-num).
     1243       define stream  Stream-rpt .
     1244       p-file-name =  string( session:temp-directory +
     1245                     "rpt" + string( g#report-num ) + ".txt" ) .
     1246       output stream stream-rpt to value(p-file-name)   .
     1247       output stream stream-rpt close  .
     1248     run PrintTitul in this-procedure .
     1249     for each temp-str :  delete temp-str.  end.
     1250     run make-tt.
     1251     for each temp-str no-lock :
     1252          run print-line in this-procedure .
     1253     end.
     1254     run PrintPodval in this-procedure .
     1255     run paramls-write in this-procedure
     1256       (input "file"
     1257       ,input string(v-ind)
     1258       ,input v-file-name
     1259       ) .
     1260   Output stream Macr_Excel  close .
     1261   if mFrameView
     1262   then do:
     1263      HIDE FRAME InfoFrame.
     1264   end.
     1265       run paramls-write in this-procedure
     1266           (input "charcol"
     1267           ,input ""
     1268           ,input "1,3,4,5,6"
     1269           ) .
     1270     run end-proc .
     1271     run rep/runexcel.p (p-file-name ).
     1272   procedure print-line :
     1273     do on error undo, return error return-value :
     1274   num#str# = num#str# + 1.
     1275   num#col# = 1.
     1276   run macr_excel_char ( temp-str.artic     , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1277   run macr_excel_char ( temp-str.gds-code  , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1278   run macr_excel_char ( temp-str.gds-name  , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1279   run macr_excel_char ( temp-str.acc_min   , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1280   run macr_excel_char ( temp-str.acc_matr  , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1281   run macr_excel_char ( temp-str.izt       , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1282   for each temp-abc:
     1283     find first ub.xyz-analysis-goods no-lock where
     1284                ub.xyz-analysis-goods.xyz-id = temp-abc.id and
     1285                ub.xyz-analysis-goods.db-num = temp-abc.db-num and
     1286                ub.xyz-analysis-goods.gds-code = temp-STR.gds-code no-error .
     1287     if available ub.xyz-analysis-goods then do:
     1288        run macr_excel_char ( ub.xyz-analysis-goods.xyzg-xyz                , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1289        run macr_excel_DEC ( ub.xyz-analysis-goods.xyzg-prcnt-for-estimate , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1290        run macr_excel_DEC ( ub.xyz-analysis-goods.xyzg-sum-for-estimate   , num#str# , num#col#   ) .
     1291   define variable v-color as integer   no-undo .
     1292       if ub.xyz-analysis-goods.xyzg-xyz = "X" then
     1293          assign
     1294            v-color = 3
     1295          .
     1296       if ub.xyz-analysis-goods.xyzg-xyz = "Y" then
     1297          assign
     1298             v-color = 41
     1299          .
     1300       if ub.xyz-analysis-goods.xyzg-xyz = "Z" then
     1301          assign
     1302            v-color = 0
     1303          .
     1304      put  stream macr_excel unformatted
     1305           substitute('select("r&1c&2:r&3c&4 ")' , num#str# , num#col# - 2 , num#str# , num#col# ) + chr(10)
     1306           substitute('font.properties(,,,,,,,,,&1,,,)', v-color ) + chr(10) .
     1307        assign    num#col# = num#col# + 1 .
     1308     end.
     1309     ELSE
     1310     num#col# = num#col# + 3 .
     1311   end.
     1312     end.
     1313   end procedure.
     1314   procedure print-all-itog :
     1315   end procedure.
     1316   procedure PrintTitul :
     1317     do  on error undo, return error return-value  :
     1318     define variable cc as integer no-undo .
     1319     define variable tt as integer no-undo .
     1320       num#str# = num#str# + 1.
     1321       num#col# = 2.
     1322       cc = num#str# .
     1323       run macr_excel_char ( "Сравнение XYZ анализов"  , num#str# , num#col#   ) .
     1324       num#str# = num#str# + 1.
     1325       num#col# = 2.
     1326       run macr_excel_char ("Печать " + cur-time-date()  , num#str# , num#col#   ) .
     1327       run macr_cell_format
     1328           ( 12     ,
     1329             true   ,
     1330             false  ,
     1331             ?      ,
     1332             cc     ,
     1333             2      ,
     1334             num#str# ,
     1335             2 ) .
     1336       run pshap.
     1337        num#str# = num#str# + 1.
     1338       num#col# = 1.
     1339       run macr_excel_char ( "Артикул товара"   , num#str# , num#col#   ) .
     1340       run macr_cell_size ( 10 , ? , num#str# , num#col# , ?, ? ) .
     1341       num#col# = 2.
     1342       run macr_excel_char ( "Код"   , num#str# , num#col#   ) .
     1343       run macr_cell_size ( 10 , ? , num#str# , num#col# , ?, ? ) .
     1344       num#col# = 3.
     1345       run macr_excel_char ( "Наименование товара"   , num#str# , num#col#   ) .
     1346       run macr_cell_size ( 25 , ? , num#str# , num#col# , ?, ? ) .
     1347       num#col# = 4.
     1348       run macr_excel_char ( "Ассортиментный минимум"   , num#str# , num#col#   ) .
     1349       run macr_cell_size ( 10 , ? , num#str# , num#col# , ?, ? ) .
     1350       num#col# = 5.
     1351       run macr_excel_char ( "Ассортиментная матрица"   , num#str# , num#col#   ) .
     1352       run macr_cell_size ( 10 , ? , num#str# , num#col# , ?, ? ) .
     1353       num#col# = 6.
     1354       run macr_excel_char ( "ИЖТ"   , num#str# , num#col#   ) .
     1355       run macr_cell_size ( 15 , ? , num#str# , num#col# , ?, ? ) .
     1356       for each temp-abc :
     1357           num#col# = num#col# + 1.
     1358           run macr_excel_char ( "Анализ № " + string(temp-abc.nn) , num#str# , num#col#   ) .
     1359           run macr_cell_size ( 10 , ? , num#str# , num#col# , ?, ? ) .
     1360           num#col# = num#col# + 1.
     1361           run macr_excel_char (  "%"  , num#str# , num#col#   ) .
     1362           run macr_cell_size ( 5 , ? , num#str# , num#col# , ?, ? ) .
     1363           num#col# = num#col# + 1.
     1364           run macr_excel_char ( "Сумма по критерию"  , num#str# , num#col#   ) .
     1365           run macr_cell_size ( 15 , ? , num#str# , num#col# , ?, ? ) .
     1366           if temp-abc.nn modulo 2 = 0 then do:
     1367               run macr_cell_format
     1368               ( 10    ,
     1369                 true  ,
     1370                 false  ,
     1371                 33    ,
     1372                 num#str# ,
     1373                 num#col# - 2 ,
     1374                 num#str# ,
     1375                 num#col# ) .
     1376           end.
     1377           else do:
     1378               run macr_cell_format
     1379               ( 10    ,
     1380                 true  ,
     1381                 false  ,
     1382                 34    ,
     1383                 num#str# ,
     1384                 num#col# - 2 ,
     1385                 num#str# ,
     1386                 num#col# ) .
     1387           end.
     1388       end.
     1389       run macr_cell_format
     1390       ( 10    ,
     1391         true  ,
     1392         false  ,
     1393         ?    ,
     1394         num#str# ,
     1395         1 ,
     1396         num#str# ,
     1397         14 ) .
     1398        put  stream macr_excel unformatted
     1399          substitute('select("r&1c&2:r&3c&4 ")' , num#str# , 1 , num#str# ,  num#col# ) + chr(10)  +
     1400          'BORDER( 2 , 2 , 2 , 2 , 2 , ,0,0,0,0,0) '  + chr(10) +
     1401          'ALIGNMENT(3 , , 4 , 4 ,)'  + chr(10)
     1402          .
     1403     end.
     1404   end procedure.
     1405   procedure PrintPodval :
     1406     do on error undo, return error return-value  :
     1407       num#str# = num#str# + 3.
     1408       num#col# = 1.
     1409       run macr_excel_char ( "Исполнитель"   , num#str# , num#col#   ) .
     1410       num#col# = 3.
     1411       run macr_excel_char ( p-user-name , num#str# , num#col#   ) .
     1412     end.
     1413   end procedure.
     1414   procedure make-tt :
     1415     do
     1416     on error undo, return error return-value
     1417     :
     1418   define buffer buf_xyz-analysis-goods for ub.xyz-analysis-goods.
     1419   define buffer buf_goods for ub.goods.
     1420   define variable  v-izt      as character no-undo .
     1421   define variable  v-acc-mat as character no-undo .
     1422   define variable  v-Amin    as character no-undo .
     1423   for each temp-abc :
     1424     for each buf_xyz-analysis-goods no-lock where
     1425              buf_xyz-analysis-goods.xyz-id = temp-abc.id  and
     1426              buf_xyz-analysis-goods.db-num = temp-abc.db-num :
     1427       if not can-find ( first temp-str where temp-str.gds-code  = buf_xyz-analysis-goods.gds-code) then do:
     1428           find first buf_goods no-lock where buf_goods.gds-code =  buf_xyz-analysis-goods.gds-code no-error .
     1429           create temp-str .
     1430           run proc-disp-goods (
     1431                 input buf_goods.gds-code
     1432               , output v-izt
     1433               , output v-acc-mat
     1434               , output v-Amin      ).
     1435           assign
     1436               temp-str.gds-code = buf_xyz-analysis-goods.gds-code
     1437               temp-str.artic    = buf_goods.artic
     1438               temp-str.gds-name = buf_goods.gds-name
     1439               temp-str.acc_min  = v-Amin
     1440               temp-str.acc_matr = v-acc-mat
     1441               temp-str.izt      = v-izt
     1442           .
     1443       end.
     1444     end.
     1445   end.
     1446     end.
     1447    end procedure.
     1448   procedure pshap :
     1449     do
     1450     on error undo, return error return-value
     1451     :
     1452     define variable tt as integer   no-undo .
     1453       num#str# = num#str# + 1.
     1454       num#col# = 1.
     1455       tt = num#str# .
     1456       for each temp-abc :
     1457           run macr_excel_char ( "Анализ № " + string(temp-abc.nn )                , num#str# , num#col#   ) .
     1458               run macr_cell_format
     1459               ( 10    ,
     1460                 true  ,
     1461                 false  ,
     1462                 ?    ,
     1463                 num#str# ,
     1464                 num#col#  ,
     1465                 num#str# ,
     1466                 num#col# ) .
     1467           num#str# = num#str# + 1.
     1468           run macr_excel_char ( temp-abc.name               , num#str# , num#col#   ) . num#str# = num#str# + 1.
     1469           if temp-abc.des <> "" then do:  run macr_excel_char ( temp-abc.des                , num#str# , num#col#   ) . num#str# = num#str# + 1. end.
     1470           run macr_excel_char ( temp-abc.name-cral          , num#str# , num#col#   ) . num#str# = num#str# + 1.
     1471           run macr_excel_char ( "X меньше     : " + string( temp-abc.A )                 , num#str# , num#col#   ) . num#str# = num#str# + 1.
     1472           run macr_excel_char ( "Y в интервале: " + string( temp-abc.A ) + " по " + string( temp-abc.C )    , num#str# , num#col#   ) . num#str# = num#str# + 1.
     1473           run macr_excel_char ( "Z больше     : " + string( temp-abc.C )                 , num#str# , num#col#   ) . num#str# = num#str# + 1.
     1474           run macr_excel_char ( "создан : " + string(temp-abc.date-cr , "99/99/9999")            , num#str# , num#col#   ) . num#str# = num#str# + 1.
     1475           run macr_excel_char ( temp-abc.period             , num#str# , num#col#   ) .  num#str# = num#str# + 1.
     1476           run macr_excel_char ( temp-abc.ext-doc-type       , num#str# , num#col#   ) .  num#str# = num#str# + 1.
     1477           run macr_excel_char ( temp-abc.obj                , num#str# , num#col#   ) .  num#str# = num#str# + 1.
     1478       end.
     1479     end.
     1480   end procedure.
     1481   PROCEDURE proc-disp-goods :
     1482   define input  parameter p-gds-code as integer   no-undo .
     1483   define output parameter  v-izt      as character no-undo .
     1484   define output parameter  v-acc-mat as character no-undo .
     1485   define output parameter  v-Amin    as character no-undo .
     1486   define variable   v-old-izt  as character no-undo .
     1487   define variable   v-old-amin  as character no-undo .
     1488   define variable   v-old-acc-mat  as character no-undo .
     1489   define variable vt-Amin as character no-undo .
     1490   define variable v-id    as integer   no-undo .
     1491   define variable v-db-num  as integer   no-undo .
     1492   define variable t-izt as character no-undo .
     1493   define variable t-Amin as character no-undo .
     1494   define variable t-asm as character no-undo .
     1495       assign
     1496       v-old-izt  = ""
     1497       v-izt      = ""
     1498       v-Amin     = ""
     1499       v-old-Amin = ""
     1500       v-acc-mat     =  ""
     1501       v-old-acc-mat = ""
     1502       .
     1503   define buffer buf2_xyz-analysis-gds-obj for ub.xyz-analysis-gds-obj   .
     1504   define buffer buf2_assortment-matrix for ub.assortment-matrix.
     1505   define buffer buf2_assortment-matrix-goods for ub.assortment-matrix-goods.
     1506   define variable            v-gdop-min-stock                as decimal   no-undo .
     1507   define variable            v-grop-max-stock                as decimal   no-undo .
     1508   define variable            v-grop-level-always-presence    as decimal   no-undo .
     1509   define variable            v-grop-min-order                as decimal   no-undo .
     1510   FOR EACH Buf_xyz-analysis-obj WHERE
     1511            Buf_xyz-analysis-obj.xyz-id = TEMP-ABC.id AND
     1512            Buf_xyz-analysis-obj.db-num = TEMP-ABC.db-num
     1513            NO-LOCK ,
     1514           EACH buf2_xyz-analysis-gds-obj WHERE
     1515               buf2_xyz-analysis-gds-obj.obj-type = Buf_xyz-analysis-obj.obj-type AND
     1516               buf2_xyz-analysis-gds-obj.obj-code = Buf_xyz-analysis-obj.obj-code AND
     1517               buf2_xyz-analysis-gds-obj.gds-code = p-gds-code AND
     1518               buf2_xyz-analysis-gds-obj.xyz-id   = TEMP-ABC.id AND
     1519               buf2_xyz-analysis-gds-obj.db-num   = TEMP-ABC.db-num
     1520               NO-LOCK break
     1521               by Buf2_xyz-analysis-gds-OBJ.gds-code
     1522               :
     1523                   find first buf2_assortment-matrix WHERE
     1524                         buf2_assortment-matrix.asmt-status        = 0  AND
     1525                         buf2_assortment-matrix.obj-type =  Buf_xyz-analysis-obj.obj-type AND
     1526                         buf2_assortment-matrix.obj-code =  Buf_xyz-analysis-obj.obj-code
     1527                         NO-LOCK no-error .
     1528                   find first buf2_assortment-matrix-goods WHERE
     1529                         buf2_assortment-matrix-goods.asmg-status        = 0  AND
     1530                         buf2_assortment-matrix-goods.asmt-id  =  buf2_assortment-matrix.asmt-id AND
     1531                         buf2_assortment-matrix-goods.db-num   =  buf2_assortment-matrix.db-num  AND
     1532                         buf2_assortment-matrix-goods.gds-code =  p-gds-code
     1533                         NO-LOCK no-error .
     1534   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1535   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjpr in g#library
     1536     (input  Buf_xyz-analysis-obj.obj-type
     1537     ,input  Buf_xyz-analysis-obj.obj-code
     1538     ,input  ?
     1539     ,input  ?
     1540     ,input  ?
     1541     ,input  p-gds-code
     1542     ,output t-amin
     1543     ,output t-izt
     1544     ,output v-gdop-min-stock
     1545     ,output v-grop-max-stock
     1546     ,output v-grop-level-always-presence
     1547     ,output v-grop-min-order
     1548     )  .
     1549                if not available buf2_assortment-matrix-goods then t-asm = "0" .
     1550                                                              else t-asm = string(buf2_assortment-matrix-goods.asmt-id).
     1551               if first-of(Buf2_xyz-analysis-gds-OBJ.gds-code) then do:
     1552                     assign
     1553                     v-old-izt  =  t-izt
     1554                     v-izt      =  t-izt
     1555                     v-Amin     =  t-amin
     1556                     v-old-Amin =  t-amin
     1557                     v-acc-mat     =  t-asm
     1558                     v-old-acc-mat =  t-asm
     1559                     .
     1560                     if  v-Amin = 'no'  then v-Amin = "не входит" .
     1561                                        else v-Amin = "входит" .
     1562                     if v-acc-mat = "0" then v-acc-mat = "не входит" .
     1563                                        else v-acc-mat = "входит" .
     1564               end.
     1565           if v-old-izt     <> t-izt            then  v-izt = "разное" .
     1566           if v-old-Amin    <> t-Amin           then  v-Amin = "разное" .
     1567           if v-old-acc-mat <> t-asm            then  v-acc-mat = "разное" .
     1568         assign
     1569           v-old-izt     = t-izt
     1570           v-old-Amin    = t-Amin
     1571           v-old-acc-mat = t-asm
     1572         .
     1573   end.
     1574   END PROCEDURE.
     1575   def var vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1576   procedure macr_excel_char :
     1577    do
     1578    on error undo, return error return-value
     1579    :
     1580    define input parameter  p-val as character no-undo .
     1581    define input parameter  p-row as integer no-undo .
     1582    define input parameter  p-col as integer no-undo .
     1583    if p-val = ? then p-val = "" .
     1584       put stream macr_excel unformatted
     1585             substitute('formula(&3,"r&1c&2")', p-row , p-col , format-excel-text-macr ( p-val) ) + chr(10)  .
     1586    end.
     1587   end procedure.
     1588   procedure macr_excel_char_with_format :
     1589    do
     1590    on error undo, return error return-value
     1591    :
     1592    define input parameter  p-val as character no-undo .
     1593    define input parameter  p-row as integer no-undo .
     1594    define input parameter  p-col as integer no-undo .
     1595    if p-val = ? then p-val = "" .
     1596       put stream macr_excel unformatted
     1597             substitute('select("r&1c&2")', p-row , p-col ) + chr(10) .
     1598       put stream macr_excel unformatted 'format.number("@")' + chr(10) .
     1599       put stream macr_excel unformatted
     1600             substitute('formula(&3,"r&1c&2")', p-row , p-col , format-excel-text-macr ( p-val) ) + chr(10)  .
     1601    end.
     1602   end procedure.
     1603   procedure macr_excel_cell_format :
     1604    do
     1605    on error undo, return error return-value
     1606    :
     1607    define input parameter  p-val    as character no-undo .
     1608    define input parameter  p-row    as integer   no-undo .
     1609    define input parameter  p-col    as integer   no-undo .
     1610    define input parameter  p-format as character no-undo .
     1611    if p-val = ? then p-val = "" .
     1612       put stream macr_excel unformatted
     1613             substitute('select("r&1c&2")', p-row , p-col ) + chr(10) .
     1614       put stream macr_excel unformatted substitute('format.number("&1")', p-format) + chr(10) .
     1615       put stream macr_excel unformatted
     1616             substitute('formula(&3,"r&1c&2")', p-row , p-col , format-excel-text-macr ( p-val) ) + chr(10)  .
     1617    end.
     1618   end procedure.
     1619   procedure macr_excel_sum :
     1620    do
     1621    on error undo, return error return-value
     1622    :
     1623    define input parameter  p-row as integer no-undo .
     1624    define input parameter  p-col as integer no-undo .
     1625    define input parameter  p-row1 as integer no-undo .
     1626    define input parameter  p-col1 as integer no-undo .
     1627    define input parameter  p-row2 as integer no-undo .
     1628    define input parameter  p-col2 as integer no-undo .
     1629       put stream macr_excel unformatted
     1630             substitute('formula("=sum(r&3c&4:r&5c&6)","r&1c&2")', p-row , p-col , p-row1 , p-col1 ,p-row2 , p-col2 ) + chr(10)  .
     1631    end.
     1632   end procedure.
     1633   procedure macr_excel_dec :
     1634    do
     1635    on error undo, return error return-value
     1636    :
     1637    define input parameter  p-val as character no-undo .
     1638    define input parameter  p-row as integer   no-undo .
     1639    define input parameter  p-col as integer   no-undo .
     1640     if p-val = ? then p-val =  "" .
     1641      put  stream macr_excel unformatted
     1642           substitute('formula(&3,"r&1c&2")', p-row , p-col ,  p-val )  + chr(10) .
     1643    end.
     1644   end procedure.
     1645   procedure macr_cell_format :
     1646    do
     1647    on error undo, return error return-value
     1648    :
     1649    define input parameter  p-size   as integer   no-undo .
     1650    define input parameter  p-bold   as logical   no-undo .
     1651    define input parameter  p-italic as logical   no-undo .
     1652    define input parameter  p-color  as integer   no-undo .
     1653    define input parameter  p-row    as integer   no-undo .
     1654    define input parameter  p-col    as integer   no-undo .
     1655    define input parameter  p-row-2  as integer   no-undo .
     1656    define input parameter  p-col-2  as integer   no-undo .
     1657     if p-size = ? then p-size = 10 .
     1658     if p-bold = ? then p-bold = false .
     1659     if p-italic = ? then p-italic = false .
     1660     if p-row-2 = ? then p-row-2 = p-row .
     1661     if p-col-2 = ? then p-col-2 = p-col .
     1662     put  stream macr_excel unformatted
     1663      substitute('select("r&1c&2:r&3c&4 ")' , p-row , p-col , p-row-2 , p-col-2 ) + chr(10) .
     1664     if p-color <> ? then do:
     1665        put  stream macr_excel unformatted
     1666          substitute('patterns(1,,&1,true)', p-color ) + chr(10)  .
     1667     end.
     1668     put  stream macr_excel unformatted
     1669          substitute('format.font(,&1,&2,&3)' , p-size,
     1670                                           string ( p-bold  , "true/false" ) ,
     1671                                           string ( p-italic , "true/false" )
     1672                                           ) + chr(10) .
     1673    end.
     1674   end procedure.
     1675   procedure macr_cell_size :
     1676    do
     1677    on error undo, return error return-value
     1678    :
     1679    define input parameter  p-w   as integer   no-undo .
     1680    define input parameter  p-l   as integer   no-undo .
     1681    define input parameter  p-row    as integer   no-undo .
     1682    define input parameter  p-col    as integer   no-undo .
     1683    define input parameter  p-row-2  as integer   no-undo .
     1684    define input parameter  p-col-2  as integer   no-undo .
     1685     if p-row-2 = ? then p-row-2 = p-row .
     1686     if p-col-2 = ? then p-col-2 = p-col .
     1687     if p-w = ? then    p-w = 0 .
     1688     if p-l = ? then    p-l = 0 .
     1689    define variable s-w as character no-undo .
     1690    define variable s-l as character no-undo .
     1691    if p-w = 0 then s-w = "" .
     1692               else s-w = string(p-w)  .
     1693    if p-l = 0 then s-l = "" .
     1694               else s-l = string(p-l)  .
     1695   put  stream macr_excel unformatted
     1696        substitute('select("r&1c&2:r&3c&4 ")' , p-row , p-col , p-row-2 , p-col-2 )  skip .
     1697   put  stream macr_excel unformatted
     1698        substitute('COLUMN.WIDTH(&1,,,,)' , s-w  )  skip.
     1699   put  stream macr_excel unformatted
     1700        'FORMAT.TEXT(2,2,0,,,,,)'  skip.
     1701    end.
     1702   end procedure.
     1703   procedure proc-print-header :
     1704    do
     1705    on error undo, return error return-value
     1706    :
     1707      find first sheetf .
     1708        sheetf.excel-row-heder =  num-entries( c-str ,chr(10)) + 1.
     1709        sheetf.excel-row-title =  num-entries( sheetf.excel-column-lable , chr(10) ).
     1710        var-1 =  num#str# .
     1711        repeat c-c = 1 to sheetf.excel-row-title :
     1712        num#str# = num#str# + 1 .
     1713        p-var = num-entries( entry (c-c, sheetf.excel-column-lable, chr(10)) , chr(44) ) .
     1714        do c-i = 1 to p-var :
     1715           str--1 = entry( c-i, entry (c-c,sheetf.excel-column-lable, chr(10)) , chr(44)) .
     1716           str--2 = integer(entry( c-i, sheetf.sizes )) .
     1717           num#col# = c-i .
     1718           run macr_excel_char_with_format ( str--1  , num#str# , num#col#  ) .
     1719           run macr_cell_size ( str--2 , ? , num#str# , num#col# , ?, ? ) .
     1720        end.
     1721       c-i = 0.
     1722       end.
     1723       run macr_cell_format (
     1724           10       ,
     1725           true     ,
     1726           false    ,
     1727           35       ,
     1728           var-1 + 1,
     1729           1        ,
     1730           num#str# ,
     1731           num#col# )
     1732           .
     1733     put  stream macr_excel unformatted
     1734          substitute('select("r&1c&2:r&3c&4 ")' , var-1 + 1 , 1 , num#str# ,  num#col# ) + chr(10)  +
     1735          'ALIGNMENT(3 , , 4 , 4 ,)'  + chr(10)
     1736          .
     1737    end.
     1738   end procedure.
     1739   procedure end-proc :
     1740    do
     1741    on error undo, return error return-value
     1742    :
     1743     v-file-name = ( string( session:temp-directory + "rpt" + string( g#report-num ) ) + ".t-t").
     1744     OUTPUT to VALUE (v-file-name) .
     1745     for each temp-param :
     1746       export  temp-param  .
     1747     end.
     1748    end.
     1749   end procedure.
