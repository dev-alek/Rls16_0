     1872     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1873     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1874     if p-change-value > 0
     1875     then do:
     1876       if frame Dialog-Frame :width + p-change-value >
     1877           session :width-chars
     1878       then do:
     1879         assign
     1880           p-change-value = session :width-chars - frame Dialog-Frame :width
     1881         .
     1882         if p-change-value <= 0
     1883         then do:
     1884           run diasize_position-resize-button in this-procedure .
     1885           return .
     1886         end.
     1887       end.
     1888     end.
     1889     if p-change-value < 0
     1890     then do:
     1891       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1892       then do:
     1893         assign
     1894           p-change-value = v-diasize-orig-frame-width
     1895                          - frame Dialog-Frame :width
     1896         .
     1897         if p-change-value >= 0
     1898         then do:
     1899           run diasize_position-resize-button in this-procedure .
     1900           return .
     1901         end.
     1902       end.
     1903     end.
     1904     if p-change-value >= 0
     1905     then do:
     1906       assign
     1907         v-change-sign = 1
     1908       .
     1909     end.
     1910     else do:
     1911       assign
     1912         v-change-sign = -1
     1913       .
     1914     end.
     1915     assign
     1916       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1917     .
     1918     if p-change-value = 0
     1919     then do:
     1920       run diasize_position-resize-button in this-procedure .
     1921       return .
     1922     end.
