     2208       end.
     2209       if p-move-resize
     2210       then do:
     2211         run diasize_position-resize-button in this-procedure .
     2212       end.
     2213       if v-diasize-wndstore = true
     2214       then do:
     2215         if connected("ub") = true
     2216         then do:
     2217           define variable v-cntxt-db-num        as integer   no-undo .
     2218           define variable v-cntxt-userid        as character no-undo .
     2219           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2220                                             , OUTPUT v-cntxt-userid
     2221                                             ) .
     2222           run gbl/wndsizew.p
     2223             (input  v-cntxt-db-num
     2224             ,input  v-cntxt-userid
     2225             ,input  v-diasize-proc-name
     2226             ,input  'width':u
     2227             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2228             ) .
     2229         end.
     2230       end.
     2231     end.
     2232     assign
     2233       v-diasize-change-size = false
     2234     .
     2235   end procedure.
     2236   procedure diasize_set-width :
     2237     define input  parameter p-new-width  as decimal   no-undo .
     2238     define input  parameter p-move-resize as logical   no-undo .
     2239     do
     2240     on error undo, return error return-value
     2241     :
     2242       run diasize_change-width in this-procedure
     2243         (input  (p-new-width - frame Dialog-Frame :width)
     2244         ,input  p-move-resize
     2245         ) .
     2246     end.
     2247   end procedure.
     2248   procedure diasize_position-resize-button :
     2249     do with frame Dialog-Frame
     2250     :
     2251       hide v-diasize-resize-button .
     2252       assign
     2253         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2254                     - 1
     2255                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2256         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2257                     - 1
     2258                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2259       .
     2260       view v-diasize-resize-button .
     2261     end.
     2262   end procedure.
     2263   on alt-right anywhere
     2264   do:
     2265     run diasize_change-width in this-procedure
     2266       (input 1
     2267       ,input true
     2268       ) .
     2269     return no-apply .
     2270   end.
     2271   on alt-left anywhere
     2272   do:
     2273     run diasize_change-width in this-procedure
     2274       (input -1
     2275       ,input true
     2276       ) .
     2277     return no-apply .
     2278   end.
     2279   on alt-down anywhere
     2280   do:
     2281     run diasize_change-height in this-procedure
     2282       (input 1
     2283       ,input true
     2284       ) .
     2285     return no-apply .
     2286   end.
     2287   on alt-up anywhere
     2288   do:
     2289     run diasize_change-height in this-procedure
     2290       (input -1
     2291       ,input true
     2292       ) .
     2293     return no-apply .
     2294   end.
     2295   on alt-enter of frame Dialog-Frame
     2296   do:
     2297     run diasize_maximize in this-procedure
     2298       (input  ?
     2299       ).
     2300     return no-apply .
     2301   end.
     2302   procedure diasize_end-move :
     2303     do
     2304     on error undo, return error return-value
     2305     :
     2306       define variable v-row-delta as decimal   no-undo .
     2307       define variable v-col-delta as decimal   no-undo .
     2308       define variable v-new-row as decimal   no-undo .
     2309       define variable v-new-col as decimal   no-undo .
     2310       assign
     2311         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2312         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2313       .
     2314       assign
     2315         v-row-delta = v-new-row - frame Dialog-Frame :height
     2316         v-col-delta = v-new-col - frame Dialog-Frame :width
     2317       .
     2318       run diasize_change-height in this-procedure
     2319         (input v-row-delta
     2320         ,input true
     2321         ) .
     2322       run diasize_change-width in this-procedure
     2323         (input v-col-delta
     2324         ,input true
     2325         ) .
     2326     end.
     2327   end procedure.
     2328   procedure diasize_maximize :
     2329     define input  parameter p-action as logical   no-undo .
     2330     do
     2331     on error undo, return error return-value
     2332     :
     2333       if p-action = ?
     2334       then do:
     2335         if v-diasize-need-maximize = true
     2336         then do:
     2337           assign
     2338             p-action = true
     2339           .
     2340         end.
     2341         else do:
     2342           assign
     2343             p-action = false
     2344           .
     2345         end.
     2346       end.
     2347       if p-action = true
     2348       then do:
     2349         run diasize_change-height in this-procedure
     2350           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2351               - frame Dialog-Frame :height-chars
     2352           ,input true
     2353           ) .
     2354         run diasize_change-width in this-procedure
     2355           (input session :width-chars
     2356               - frame Dialog-Frame :width-chars
     2357           ,input true
     2358           ) .
     2359         assign
     2360           v-diasize-need-maximize = false
     2361         .
     2362       end.
     2363       else do:
     2364         run diasize_change-width in this-procedure
     2365           (input v-diasize-orig-frame-width
     2366               - frame Dialog-Frame :width-chars
     2367           ,input true
     2368           ) .
     2369         run diasize_change-height in this-procedure
     2370           (input v-diasize-orig-frame-height
     2371               - frame Dialog-Frame :height-chars
     2372           ,input true
     2373           ) .
     2374         assign
     2375           v-diasize-need-maximize = true
     2376         .
     2377       end.
     2378     end.
     2379   end procedure.
     2380   procedure diasize_restore-orig-size :
     2381     do
     2382     on error undo, return error return-value
     2383     :
     2384       assign
     2385         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2386         v-diasize-current-frame-height = frame Dialog-Frame :height
     2387       .
     2388       run diasize_set-height in this-procedure
     2389         (input  v-diasize-orig-frame-height
     2390         ,input  true
     2391         ) .
     2392       run diasize_set-width in this-procedure
     2393         (input  v-diasize-orig-frame-width
     2394         ,input  true
     2395         ) .
     2396     end.
     2397   end procedure.
     2398   procedure diasize_restore-current-size :
     2399     do
     2400     on error undo, return error return-value
     2401     :
     2402       run diasize_set-height in this-procedure
     2403         (input  v-diasize-current-frame-height
     2404         ,input  true
     2405         ) .
     2406       run diasize_set-width in this-procedure
     2407         (input  v-diasize-current-frame-width
     2408         ,input  true
     2409         ) .
     2410     end.
     2411   end procedure.
     2412   procedure diasize_set-browse-handle :
     2413     define input  parameter p-browse-handle as handle   no-undo .
     2414     define buffer buf_temp-browse-handle for temp-browse-handle .
     2415     do
     2416     on error undo, return error return-value
     2417     :
     2418       assign
     2419         v-diasize-browse-handle = p-browse-handle
     2420       .
     2421       for each buf_temp-browse-handle
     2422       on error undo, return error return-value
     2423       :
     2424         delete buf_temp-browse-handle .
     2425       end.
     2426     end.
     2427   end procedure.
     2428   procedure diasize_add_browse :
     2429     define input  parameter p-browse-type   as character no-undo .
     2430     define input  parameter p-browse-handle as handle    no-undo .
     2431     define buffer buf_temp-browse-handle for temp-browse-handle .
     2432     do
     2433     on error undo, return error return-value
     2434     :
     2435       assign
     2436         v-diasize-browse-number = v-diasize-browse-number + 1
     2437       .
     2438       create buf_temp-browse-handle .
     2439       assign
     2440         buf_temp-browse-handle.browse-type   = p-browse-type
     2441         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2442         buf_temp-browse-handle.browse-handle = p-browse-handle
     2443       .
     2444     end.
     2445   end procedure.
     2446   procedure diasize_init :
     2447     define variable v-default-value    as logical   no-undo .
     2448     define variable v-restore-saved    as logical   no-undo .
     2449     define variable v-resize-value-str as character no-undo .
     2450     do
     2451     on error undo, return error return-value
     2452     :
     2453       do with frame Dialog-Frame
     2454       :
     2455         assign
     2456           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2457           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2458           v-diasize-browse-handle     = browse br-delivsubject :handle
     2459         .
     2460         create button v-diasize-resize-button
     2461         assign
     2462           parent        = frame Dialog-Frame :first-child
     2463           label         = "s"
     2464           height-pixels = 16
     2465           width-pixels  = 16
     2466           visible       = true
     2467           sensitive     = true
     2468           movable       = true
     2469           triggers:
     2470             on end-move persistent run diasize_end-move in this-procedure .
     2471           end triggers.
     2472         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2473         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2474         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2475         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2476         assign
     2477           v-diasize-wndmax = false
     2478         .
     2479         if connected("ub") = true
     2480         then do:
     2481           define variable v-cntxt-db-num        as integer   no-undo .
     2482           define variable v-cntxt-userid        as character no-undo .
     2483           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2484                                             , OUTPUT v-cntxt-userid
     2485                                             ) .
     2486           run gbl/wndpar_r.p
     2487             (input  v-cntxt-db-num
     2488             ,input  v-cntxt-userid
     2489             ,input  'wndmax':U
     2490             ,output v-diasize-wndmax
     2491             ,output v-default-value
     2492             ) .
     2493         end.
     2494         assign
     2495           v-diasize-wndstore = false
     2496         .
     2497         if connected("ub") = true
     2498         then do:
     2499           run gbl/wndpar_r.p
     2500             (input  v-cntxt-db-num
     2501             ,input  v-cntxt-userid
     2502             ,input  'wndstore':U
     2503             ,output v-diasize-wndstore
     2504             ,output v-default-value
     2505             ) .
     2506         end.
     2507         assign
     2508           v-diasize-proc-name = entry(1, program-name(2), '.')
     2509         .
     2510         if v-diasize-wndstore = true
     2511         then do:
     2512           assign
     2513             v-restore-saved = false
     2514           .
     2515           if connected("ub") = true
     2516           then do:
     2517             run gbl/wndsizer.p
     2518               (input  v-cntxt-db-num
     2519               ,input  v-cntxt-userid
     2520               ,input  v-diasize-proc-name
     2521               ,input  'height':u
     2522               ,output v-resize-value-str
     2523               ) .
     2524             if v-resize-value-str <> '':U
     2525             then do:
     2526               run diasize_change-height in this-procedure
     2527                 (input  integer(v-resize-value-str)
     2528                 ,input  true
     2529                 ) .
     2530               assign
     2531                 v-restore-saved = true
     2532               .
     2533             end.
     2534           end.
     2535           if connected("ub") = true
     2536           then do:
     2537             run gbl/wndsizer.p
     2538               (input  v-cntxt-db-num
     2539               ,input  v-cntxt-userid
     2540               ,input  v-diasize-proc-name
     2541               ,input  'width':u
     2542               ,output v-resize-value-str
     2543               ) .
     2544             if v-resize-value-str <> '':U
     2545             then do:
     2546               run diasize_change-width in this-procedure
     2547                 (input  integer(v-resize-value-str)
     2548                 ,input  true
     2549                 ) .
     2550               assign
     2551                 v-restore-saved = true
     2552               .
     2553             end.
     2554           end.
     2555           if v-restore-saved <> true
     2556           then do:
     2557             if v-diasize-wndmax = true
     2558             then do:
     2559               run diasize_maximize in this-procedure
     2560                 (input  true
     2561                 ) .
     2562             end.
     2563           end.
     2564         end.
     2565         else do:
     2566           if v-diasize-wndmax = true
     2567           then do:
     2568             run diasize_maximize in this-procedure
     2569               (input  true
     2570               ) .
     2571           end.
     2572         end.
     2573       end.
     2574     end.
     2575   end procedure.
     2576   procedure diasize_need-full-display :
     2577     define output parameter p-need-full-display as logical   no-undo .
     2578     do
     2579     on error undo, return error return-value
     2580     :
     2581       assign
     2582         p-need-full-display = v-diasize-need-full-display
     2583       .
     2584       assign
     2585         v-diasize-need-full-display = false
     2586       .
     2587     end.
     2588   end procedure.
     2589   procedure get-context :
     2590      define output parameter p-db-num as integer          no-undo.
     2591      define output parameter p-user-id as character        no-undo.
     2592      define variable v-login               as character    no-undo.
     2593      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2594      define buffer buf_user-login  for ub.user-login .
     2595      do
     2596      on error undo, return error
     2597      :
     2598            FIND FIRST buf_sys-ctrl no-lock.
     2599            ASSIGN
     2600               v-login = USERID("ub")
     2601               p-db-num = buf_sys-ctrl.db-num
     2602            .
     2603            FIND FIRST buf_user-login
     2604                 WHERE buf_user-login.db-num = p-db-num
     2605                   AND buf_user-login.user-login = v-login
     2606                 no-lock
     2607                 no-error
     2608                 .
     2609            IF AVAILABLE buf_user-login
     2610            THEN DO:
     2611               assign
     2612                  p-user-id = buf_user-login.user-id
     2613               .
     2614            END.
     2615      end.
     2616   end procedure.
     2617       run diasize_init in this-procedure .
     2618   def var sort-labelbr-delivsubject   as character no-undo .
     2619   def var sort-clmnbr-delivsubject    as handle    no-undo .
     2620   def var cur-clmnbr-delivsubject     as handle    no-undo .
     2621   def var cur-clmn-locbr-delivsubject as integer   no-undo .
     2622   def var re-querybr-delivsubject     as logical   initial no no-undo .
     2623   on start-search, ctrl-o of br-delivsubject in frame Dialog-Frame do:
     2624      run sort-brbr-delivsubject
     2625        (input (if available X_delivery-subject
     2626                then recid(X_delivery-subject)
     2627                else ?
     2628               )
     2629        ).
     2630   end.
     2631   PROCEDURE sort-brbr-delivsubject :
     2632     define input parameter p-recid as recid no-undo .
     2633     if re-querybr-delivsubject = no then do:
     2634       assign
     2635          cur-clmnbr-delivsubject = br-delivsubject:current-column in frame Dialog-Frame
     2636       .
     2637       if sort-clmnbr-delivsubject <> ? then sort-clmnbr-delivsubject:column-fgcolor = 0.
     2638       if cur-clmnbr-delivsubject = sort-clmnbr-delivsubject then do:
     2639         assign
     2640            sort-labelbr-delivsubject = ""
     2641            sort-clmnbr-delivsubject = ?
     2642         .
     2643        end.
     2644        else do:
     2645          assign
     2646            sort-labelbr-delivsubject = cur-clmnbr-delivsubject:label
     2647            sort-clmnbr-delivsubject  = cur-clmnbr-delivsubject
     2648            sort-clmnbr-delivsubject:column-fgcolor = 4
     2649          .
     2650        end.
     2651      end.
     2652     assign
     2653       cur-clmn-locbr-delivsubject = 1
     2654     .
     2655     def var column-handle as handle no-undo .
     2656     column-handle = br-delivsubject:first-column.
     2657     do while valid-handle(column-handle) :
     2658       if column-handle = cur-clmnbr-delivsubject then do:
     2659         leave .
     2660       end.
     2661       column-handle = column-handle:NEXT-COLUMN.
     2662       assign
     2663         cur-clmn-locbr-delivsubject = cur-clmn-locbr-delivsubject + 1
     2664       .
     2665     end.
     2666     case sort-labelbr-delivsubject:
     2667           when X_delivery-subject.deliv-subj-code:label in browse br-delivsubject then DO:    assign       sort-column-name = "X_delivery-subject.deliv-subj-code"     .     run OpenBr ( input yes, input no, input no).   . END.
     2668           when X_delivery-subject.deliv-subj-name:label in browse br-delivsubject then DO:    assign       sort-column-name = "X_delivery-subject.deliv-subj-name"     .     run OpenBr ( input yes, input no, input no).   . END.
     2669           when X_delivery-subject.reg-code:label in browse br-delivsubject then DO:    assign       sort-column-name = "X_delivery-subject.reg-code"     .     run OpenBr ( input yes, input no, input no).   . END.
     2670       otherwise do:
     2671         assign
     2672           sort-column-name = ""
     2673         .
     2674         run OpenBr ( input yes, input no, input no).
     2675           if can-do( this-procedure:internal-entries, 'mv-brw-defaultbr-delivsubject') then do:
     2676             run mv-brw-defaultbr-delivsubject.
     2677           end.
     2678         if sort-labelbr-delivsubject <> "" then do:
     2679           assign
     2680             cur-clmnbr-delivsubject:column-fgcolor = 0
     2681           .
     2682         end.
     2683         assign
     2684           cur-clmn-locbr-delivsubject = ?
     2685         .
     2686       end.
     2687     end case.
     2688       if cur-clmn-locbr-delivsubject <> ? then do:
     2689         if can-do( this-procedure:internal-entries, 'ch-clmnbr-delivsubject') then do:
     2690           run ch-clmnbr-delivsubject in this-procedure (cur-clmn-locbr-delivsubject).
     2691         end.
     2692       end.
     2693     if p-recid <> ? then do:
     2694       reposition br-delivsubject to recid p-recid no-error.
     2695       apply "value-changed" to br-delivsubject in frame Dialog-Frame.
     2696     end.
     2697     apply "entry" to br-delivsubject in frame Dialog-Frame.
     2698   END PROCEDURE.
     2699   procedure re-open-query-srt-clmnbr-delivsubject:
     2700   if cur-clmnbr-delivsubject = ? then do:
     2701      run OpenBr ( input yes, input no, input no).
     2702   end.
     2703   else do:
     2704      assign re-querybr-delivsubject = yes.
     2705      run sort-brbr-delivsubject
     2706        (input (if available X_delivery-subject
     2707                then recid(X_delivery-subject)
     2708                else ?
     2709               )
     2710        ).
     2711      assign re-querybr-delivsubject = no.
     2712   end.
     2713   end.
