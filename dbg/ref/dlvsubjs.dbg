     2914   END PROCEDURE.
     2915   PROCEDURE MyENable :
     2916   ASSIGN
     2917   rs-sts:RADIO-BUTTONS IN FRAME Dialog-Frame
     2918                          = "Текущие&+" + chr(44) +  '0':U + chr(44) +
     2919                          "Все&!" + chr(44) + 'все':U + chr(44) +
     2920                           "Удаленные&-" + chr(44) + '1':U
     2921   rs-sts = (IF p-sts = ? THEN 'все':U ELSE string(p-sts))
     2922   X_delivery-subject.reg-code:read-only in browse br-delivsubject  = yes
     2923   .
     2924   DISPLAY mark-num
     2925   WITH FRAME Dialog-Frame.
