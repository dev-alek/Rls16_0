      791   FUNCTION mark-string RETURNS CHARACTER
      792     ( input p-recid as recid, input mark-list as character  ) :
      793     RETURN ( IF LOOKUP( STRING( p-recid), mark-list ) > 0 THEN '*' ELSE '':U ).
      794   END FUNCTION.
      795   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      796   define variable c-point  as character no-undo .
      797   define variable tbl      as character no-undo .
      798   define variable join-tbl as character no-undo .
