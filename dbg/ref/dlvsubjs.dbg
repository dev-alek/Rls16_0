     2928   B-mark when LOOKUP("b-mark":U, bttns) > 0
     2929   B-sel when LOOKUP("b-sel":U, bttns) > 0
     2930   B-add when LOOKUP("b-add":U, bttns) > 0 and v-db-num = 0
     2931   b-lkp
     2932   B-chg when LOOKUP("b-add":U, bttns) > 0 and v-db-num = 0
     2933   B-del when LOOKUP("b-add":U, bttns) > 0 and v-db-num = 0
     2934   b-sch
     2935   B-print
     2936   B-Help
     2937   B-hist
     2938   B-delivtype
     2939   br-delivsubject
     2940   mark-num
     2941   rs-sts
     2942   with FRAME Dialog-Frame.
     2943   VIEW FRAME Dialog-Frame.
     2944   END PROCEDURE.
     2945   PROCEDURE OpenBr :
