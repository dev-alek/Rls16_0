     1337   END.
     1338   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1339   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1340   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1341   on help of frame Dialog-Frame
     1342   do:
     1343     run gbl/app_help.p
     1344       (input this-procedure :file-name
     1345       ,input ''
     1346       ,input ?
     1347       ) no-error.
     1348     if error-status :error then do:
     1349       message
     1350         "Ошибка при вызове помощи"
     1351         error-status :get-message(1)
     1352         view-as alert-box .
     1353     end.
     1354   end.
     1355   run minbtn-set in this-procedure .
     1356   on choose of b-help in frame Dialog-Frame
     1357   do:
     1358     apply "help":u to frame Dialog-Frame .
     1359   end.
     1360   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1361   procedure minbtn-set :
     1362       do
     1363           on error undo, return error return-value
     1364           :
     1365           define variable ii              as integer       no-undo .
     1366           define variable fh              as widget-handle no-undo .
     1367           define variable hh              as widget-handle no-undo .
     1368           define variable v-h             as handle        extent 4 no-undo .
     1369           define variable v-name-button   as character     no-undo .
     1370           define variable v-help-old-x    as decimal       no-undo .
     1371           define variable v-help-old-y    as decimal       no-undo .
     1372           define variable v-help-old-size as decimal       no-undo .
     1373           define variable v-frame-width   as decimal       no-undo .
     1374           define variable jj              as integer       no-undo .
     1375           do
     1376               on error undo, return error
     1377               :
     1378               assign
     1379                   v-frame-width = frame Dialog-Frame:width - 0.3
     1380                   fh            = frame Dialog-Frame:first-child
     1381                   hh            = fh:first-child
     1382                   ii            = 1
     1383                   .
     1384               do while valid-handle(hh):
     1385                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1386                   do:
     1387                       case lc(hh:name) :
     1388                           when "b-help" then
     1389                               do:
     1390                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1391                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1392                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1393                                   hh:TOOLTIP = "Помощь" .
     1394                                   v-help-old-x = hh:column .
     1395                                   v-help-old-y = hh:row    .
     1396                                   v-help-old-size = hh:width .
     1397                                   hh:width-chars = 2.5 .
     1398                               end.
     1399                           when "b-print" then
     1400                               do:
     1401                                   hh:load-image("cmp/b-print.bmp":u) .
     1402                                   hh:TOOLTIP = "Печать" .
     1403                                   v-h[ii] = hh:handle .
     1404                                   ii = ii + 1 .
     1405                                   hh:width-chars = 3 .
     1406                               end.
     1407                           when "b-history" or
     1408                           when "b-hist" then
     1409                               do:
     1410                                   hh:load-image("cmp/b-hist.bmp":u) .
     1411                                   hh:TOOLTIP = "История" .
     1412                                   v-h[ii] = hh:handle .
     1413                                   ii = ii + 1 .
     1414                                   hh:width-chars = 3 .
     1415                               end.
     1416                           when "b-sch" then
     1417                               do:
     1418                                   hh:load-image("cmp/b-sch.bmp":u) .
     1419                                   hh:TOOLTIP = "Установка Фильтра" .
     1420                                   v-h[ii] = hh:handle .
     1421                                   ii = ii + 1 .
     1422                                   hh:width-chars = 3 .
     1423                               end.
     1424                           when "b-hist-user" then
     1425                               do:
     1426                                   hh:load-image("cmp/b-hist.bmp":u) .
     1427                                   hh:TOOLTIP = "История пользователя" .
     1428                                   ii = ii + 1 .
     1429                               end.
     1430                       end case.
     1431                   end.
     1432                   hh = hh:next-sibling.
     1433               end.
     1434               b-help:column = v-frame-width - b-help:width-chars.
     1435               jj = 0.
     1436               repeat ii = 4 to 1 by -1 :
     1437                   if valid-handle (v-h[ii] ) then
     1438                   do:
     1439                       jj  = jj + 1 .
     1440                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1441                       v-h[ii]:row    = v-help-old-y .
     1442                   end.
     1443               end.
     1444           end.
     1445       end.
     1446   end procedure.
     1447   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1448   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1449   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1450   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1451   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1452   define variable v-diasize-current-frame-height as decimal   no-undo .
     1453   define variable v-diasize-change-size          as logical   no-undo .
     1454   define variable v-diasize-resize-button        as handle    no-undo .
     1455   define variable v-diasize-wndmax               as logical   no-undo .
     1456   define variable v-diasize-wndstore             as logical   no-undo .
     1457   define variable v-diasize-proc-name            as character no-undo .
     1458   define variable v-diasize-browse-handle        as handle    no-undo .
     1459   define variable v-diasize-browse-number        as integer   no-undo .
     1460   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1461   define temp-table temp-diasize-handle no-undo
     1462     field handle-value  as handle
     1463     field save-position as decimal
     1464     index xpk is primary unique handle-value
     1465     .
     1466   define temp-table temp-browse-handle no-undo
     1467     field browse-type   as character
     1468     field browse-number as integer
     1469     field browse-handle as handle
     1470     field original-size as decimal
     1471     index xpk is primary unique browse-type browse-number
     1472     index xie browse-type browse-handle
     1473   .
     1474   procedure diasize_change-height :
     1475     define input  parameter p-change-value  as decimal   no-undo .
     1476     define input  parameter p-move-resize   as logical   no-undo .
     1477     define variable v-field-group-handle    as handle    no-undo .
     1478     define variable v-object-handle         as handle    no-undo .
     1479     define variable v-frame-height          as decimal   no-undo .
     1480     define variable v-frame-virtual-height  as decimal   no-undo .
     1481     define variable v-browse-height         as decimal   no-undo .
     1482     define variable v-window-height         as decimal   no-undo .
     1483     define variable v-window-virtual-height as decimal   no-undo .
     1484     define variable v-change-sign           as integer   no-undo .
     1485     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1486     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1487     if p-change-value > 0
     1488     then do:
     1489       if frame Dialog-Frame :height + p-change-value
     1490           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1491       then do:
     1492         assign
     1493           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1494                           - (frame Dialog-Frame :height-chars)
     1495         .
     1496         if p-change-value <= 0
     1497         then do:
     1498           run diasize_position-resize-button in this-procedure .
     1499           return .
     1500         end.
     1501       end.
     1502     end.
     1503     if p-change-value < 0
     1504     then do:
     1505       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1506       then do:
     1507         assign
     1508           p-change-value = v-diasize-orig-frame-height
     1509                          - (frame Dialog-Frame :height-chars)
     1510         .
     1511         if p-change-value >= 0
     1512         then do:
     1513           run diasize_position-resize-button in this-procedure .
     1514           return .
     1515         end.
     1516       end.
     1517     end.
     1518     if p-change-value >= 0
     1519     then do:
     1520       assign
     1521         v-change-sign = 1
     1522       .
     1523     end.
     1524     else do:
     1525       assign
     1526         v-change-sign = -1
     1527       .
     1528     end.
     1529     assign
     1530       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1531     .
     1532     if p-change-value = 0
     1533     then do:
     1534       run diasize_position-resize-button in this-procedure .
     1535       return .
     1536     end.
     1537     move_block:
     1538     do
     1539     on error undo move_block, retry move_block
     1540     :
     1541       if retry
     1542       then do:
     1543         do
     1544         on error undo move_block, leave move_block
     1545         :
     1546           if p-change-value > 0
     1547           then do:
     1548             for each buf_temp-diasize-handle
     1549             on error undo, next
     1550             :
     1551               assign
     1552                 v-object-handle = buf_temp-diasize-handle.handle-value
     1553               .
     1554               if v-object-handle <> v-diasize-resize-button
     1555               then do:
     1556                 assign
     1557                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1558                 .
     1559               end.
     1560             end.
     1561             assign
     1562               v-diasize-browse-handle :height = v-browse-height
     1563             .
     1564             for each buf_temp-browse-handle
     1565               where buf_temp-browse-handle.browse-type = 'height':u
     1566             on error undo, next
     1567             :
     1568               assign
     1569                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1570               .
     1571             end.
     1572             assign
     1573               frame Dialog-Frame :height = v-frame-height
     1574             .
     1575             if frame Dialog-Frame :scrollable = true
     1576             then do:
     1577               assign
     1578                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1579               .
     1580             end.
     1581             run diasize_position-resize-button in this-procedure .
     1582           end.
     1583           else do:
     1584             if frame Dialog-Frame :scrollable = true
     1585             then do:
     1586               assign
     1587                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1588               .
     1589             end.
     1590             assign
