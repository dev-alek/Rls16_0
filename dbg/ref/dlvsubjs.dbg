     1849   procedure diasize_set-height :
     1850     define input  parameter p-new-height  as decimal   no-undo .
     1851     define input  parameter p-move-resize as logical   no-undo .
     1852     do
     1853     on error undo, return error return-value
     1854     :
     1855       run diasize_change-height in this-procedure
     1856         (input  (p-new-height - frame Dialog-Frame :height)
     1857         ,input  p-move-resize
     1858         ) .
     1859     end.
     1860   end procedure.
     1861   procedure diasize_change-width :
     1862     define input  parameter p-change-value as decimal   no-undo .
     1863     define input  parameter p-move-resize  as logical   no-undo .
