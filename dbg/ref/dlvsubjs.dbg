     1268   DO:
     1269     define variable loc#log as logical no-undo .
     1270     if available X_delivery-subject then do:
     1271   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1272   define variable v-str-recid14 as character no-undo .
     1273   define variable v-num-entry14 as integer   no-undo .
     1274   assign
     1275     v-str-recid14 = trim( string( recid( X_delivery-subject ) , "->>>>>>>>>>>9":U ) )
     1276     v-num-entry14 = lookup( v-str-recid14 , v-rid-list )
     1277   .
     1278   if v-num-entry14 > 0 then do:
     1279     assign
     1280       entry( v-num-entry14, v-rid-list ) = "":U
     1281       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1282     .
     1283   end.
     1284   else do:
     1285     assign
     1286       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid14
     1287     .
     1288   end.
     1289       loc#log = br-delivsubject:refresh() .
     1290       if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
     1291           loc#log = br-delivsubject:select-next-row ().
     1292           apply "VALUE-CHANGED" to br-delivsubject in frame Dialog-Frame.
     1293       end.
     1294       if num-entries( v-rid-list ) = 0
     1295       then
     1296           hide mark-num in frame Dialog-Frame.
     1297       else
     1298           disp num-entries( v-rid-list ) @ mark-num with frame Dialog-Frame.
     1299     end.
     1300     apply "entry" to br-delivsubject in frame Dialog-Frame.
     1301   END.
