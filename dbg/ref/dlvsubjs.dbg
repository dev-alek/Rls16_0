     2759   procedure set-filter-name :
     2760   define input parameter p-filter-name as character no-undo .
     2761     do with frame Dialog-Frame:
     2762       if p-filter-name > "" then do:
     2763         assign
     2764           frame Dialog-Frame:title
     2765             = frame Dialog-Frame:title + "   ФИЛЬТР: " + p-filter-name.
     2766         .
     2767         assign
     2768           b-sch :tooltip = "Установлен фильтр " + p-filter-name
     2769         .
     2770       end.
     2771       else do:
     2772         assign
     2773           b-sch :tooltip = ""
     2774         .
     2775       end.
     2776     end.
     2777   end procedure.
     2778   MAIN-BLOCK:
     2779   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2780      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2781   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2782     run mainmenu_getcntxt in parparentproc
     2783       (output v-cntxt-db-num
     2784       ,output v-cntxt-userid
     2785       ,output v-cntxt-level
     2786       ,output v-cntxt-host-code-obj
     2787       ,output v-cntxt-obj-type
     2788       ,output v-cntxt-obj-code
     2789       ,output v-cntxt-db-num-obj
     2790       ,output v-cntxt-is-admin
     2791       ) .
     2792     find first X_curr_clients no-lock where
     2793               X_curr_clients.obj-type = p-curr-obj-type
     2794          AND X_curr_clients.obj-code = p-curr-obj-code no-error.
     2795     if not available X_curr_clients then do:
     2796       message
     2797       vss-workfile vss-revision vss-description skip
     2798       "Неверное значение параметра вызова p-curr-obj-type p-curr-obj-code"
     2799       p-curr-obj-type p-curr-obj-code
     2800       view-as alert-box ERROR.
     2801       return error .
     2802     end.
     2803    if LOOKUP(p-mode, 'все':U,
     2804                   chr(4)) = 0
     2805        then dO:
     2806       message
     2807       vss-workfile vss-revision vss-description skip
     2808       "Неверное значение параметров вызова p-mode"
     2809       p-mode
     2810       view-as alert-box ERROR.
     2811       return error .
     2812    end.
     2813    v-rid-list = p-rid-list.
     2814   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2815   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
     2816     (output v-db-num
     2817     )  .
     2818     RUN MyEnable.
     2819     RUn OpenBR in this-procedure ( input yes, input no, input no).
     2820     HIDE mark-num in frame Dialog-Frame .
     2821     if v-doc-rec <> ? then
     2822     REPOSITION br-delivsubject to recid v-doc-rec No-ERROR.
     2823   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2824   DEF VAR cur-clmn-numbr-delivsubject as INT EXTENT 5 no-undo.
     2825   DEF VAR varmvibr-delivsubject       as INT no-undo.
     2826   DEF VAR varmvjbr-delivsubject       as INT no-undo.
     2827   DEF VAR varmvkbr-delivsubject       as INT no-undo.
     2828   DEF VAR varmvlbr-delivsubject       as INT no-undo.
     2829   DEF VAR move-elementbr-delivsubject as INT no-undo.
     2830   def var jjbr-delivsubject           as int no-undo.
     2831   do varmvibr-delivsubject = 1 to EXTENT(cur-clmn-numbr-delivsubject):
     2832     ASSIGN cur-clmn-numbr-delivsubject[varmvibr-delivsubject] = varmvibr-delivsubject.
     2833   END.
     2834   RUN start-mv-clmnbr-delivsubject.
     2835   PROCEDURE start-mv-clmnbr-delivsubject:
     2836   def var old-session as logical no-undo.
     2837      old-session = SESSION:IMMEDIATE-DISPLAY.
     2838      IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     2839          IF  p-mode = 'все':U  THEN DO:
     2840      DO jjbr-delivsubject = NUM-ENTRIES('1,2,3,4,5') TO 1 BY -1:
     2841        RUN re-move-clmnbr-delivsubject ( cur-clmn-numbr-delivsubject[INTEGER(ENTRY (jjbr-delivsubject, '1,2,3,4,5'))] , 1).
     2842      END.
     2843          END.
     2844      SESSION:IMMEDIATE-DISPLAY = old-session.
     2845   END.
     2846   ON ctrl-cursor-right OF BROWSE br-delivsubject do:
     2847     RUN re-move-clmnbr-delivsubject ( 1, 5).
     2848   END.
     2849   ON ctrl-cursor-left OF BROWSE br-delivsubject do:
     2850     RUN re-move-clmnbr-delivsubject (5, 1).
     2851   END.
     2852   PROCEDURE re-move-clmnbr-delivsubject:
     2853     DEFINE INPUT PARAMETER source-column as INTEGER NO-UNDO.
     2854     DEFINE INPUT PARAMETER target-column as INTEGER NO-UNDO.
     2855     DO varmvibr-delivsubject = 1 TO EXTENT(cur-clmn-numbr-delivsubject):
     2856       if cur-clmn-numbr-delivsubject[varmvibr-delivsubject] = source-column THEN cur-clmn-numbr-delivsubject[varmvibr-delivsubject] = -1.
     2857     END.
     2858     if br-delivsubject:MOVE-COLUMN(source-column, target-column) IN FRAME Dialog-Frame then.
     2859     if source-column > target-column THEN
     2860     DO varmvjbr-delivsubject = source-column - 1 to target-column BY -1:
     2861       DO varmvibr-delivsubject = 1 TO EXTENT(cur-clmn-numbr-delivsubject):
     2862           if cur-clmn-numbr-delivsubject[varmvibr-delivsubject] = varmvjbr-delivsubject THEN DO:
     2863             cur-clmn-numbr-delivsubject[varmvibr-delivsubject] = cur-clmn-numbr-delivsubject[varmvibr-delivsubject] + 1.
     2864           END.
     2865       END.
     2866     END.
     2867     ELSE
     2868     DO varmvjbr-delivsubject = source-column + 1 to target-column:
     2869       DO varmvibr-delivsubject = 1 TO EXTENT(cur-clmn-numbr-delivsubject):
     2870         if cur-clmn-numbr-delivsubject[varmvibr-delivsubject] = varmvjbr-delivsubject THEN DO:
     2871           cur-clmn-numbr-delivsubject[varmvibr-delivsubject] = cur-clmn-numbr-delivsubject[varmvibr-delivsubject] - 1.
     2872         END.
     2873       END.
     2874     END.
     2875     DO varmvibr-delivsubject = 1 TO EXTENT(cur-clmn-numbr-delivsubject):
     2876       if cur-clmn-numbr-delivsubject[varmvibr-delivsubject] = -1 THEN cur-clmn-numbr-delivsubject[varmvibr-delivsubject] = target-column.
     2877     END.
     2878   END PROCEDURE.
     2879   PROCEDURE ch-clmnbr-delivsubject:
     2880     DEFINE INPUT PARAMETER cur-clmn-loc as INTEGER NO-UNDO.
     2881     if cur-clmn-loc <= 1 then do:
     2882       return .
     2883     end.
     2884     DO varmvibr-delivsubject = 1 TO EXTENT(cur-clmn-numbr-delivsubject):
     2885       if cur-clmn-numbr-delivsubject[varmvibr-delivsubject] = cur-clmn-loc THEN move-elementbr-delivsubject = varmvibr-delivsubject.
     2886     END.
     2887     RUN re-move-clmnbr-delivsubject (cur-clmn-loc, 1).
     2888   END PROCEDURE.
     2889   PROCEDURE mv-brw-defaultbr-delivsubject:
     2890   def var old-session as logical no-undo.
     2891     old-session = SESSION:IMMEDIATE-DISPLAY.
     2892     IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     2893     do varmvlbr-delivsubject = 1 to EXTENT(cur-clmn-numbr-delivsubject):
     2894       RUN re-move-clmnbr-delivsubject (cur-clmn-numbr-delivsubject[varmvlbr-delivsubject], varmvlbr-delivsubject).
     2895     END.
     2896     RUN start-mv-clmnbr-delivsubject.
     2897     SESSION:IMMEDIATE-DISPLAY = old-session.
     2898   END PROCEDURE.
     2899   .
     2900   WAIT-FOR GO OF FRAME Dialog-Frame.
     2901   END.
     2902   RUN disable_UI.
     2903   PROCEDURE disable_UI :
