      804   procedure fltfield-clear :
      805     define output parameter loc-fld as character no-undo.
      806     define output parameter loc-lab as character no-undo .
      807     define output parameter loc-spr as character no-undo .
      808     define output parameter loc-dim as character no-undo .
      809     assign
      810       loc-fld = ""
      811       loc-lab = ""
      812       loc-spr = ""
      813       loc-dim = "0"
      814     .
      815   end procedure .
      816   procedure fltfield-add :
      817     define input        parameter par-fld as character no-undo.
      818     define input        parameter par-lab as character no-undo .
      819     define input        parameter par-spr as character no-undo .
      820     define input-output parameter loc-fld as character no-undo.
      821     define input-output parameter loc-lab as character no-undo .
      822     define input-output parameter loc-spr as character no-undo .
      823     define input-output parameter loc-dim as character no-undo .
      824     do
      825     on error undo, return error
      826     :
      827       assign
      828       loc-fld = if loc-dim = '0'
      829                 then par-fld
      830                 else (loc-fld + chr(44) + par-fld)
      831       loc-lab = if loc-dim = '0'
      832                 then par-lab
      833                 else (loc-lab + chr(44) + par-lab)
      834       loc-spr = if loc-dim = '0'
      835                 then par-spr
      836                 else (loc-spr + chr(44) + par-spr)
      837       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
      838                 string(integer(if num-entries(loc-dim) > 1
      839                               then entry(2, loc-dim)
      840                               else entry(1, loc-dim)
      841                               ) + 1)
      842       no-error
      843       .
      844     end.
      845   end procedure.
      846   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      847   define variable v-fltopend-rowid as rowid extent 18 no-undo .
      848   procedure fltopend_fltopend :
      849   define input parameter p-parent-handle as handle no-undo .
      850   define input parameter p-qh as handle no-undo .
      851   define input parameter p-flt-open-open-query  as character no-undo .
      852   define input parameter p-where-cond as character no-undo .
      853   define input parameter p-use-indFIRST-query-tail as character no-undo .
      854   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      855   define input parameter p-indexed-reposition as character no-undo .
      856     do
      857     on error undo, return error
      858     :
      859   define variable v-prepare-string as character no-undo .
      860   define variable glog as logical no-undo .
      861   assign
      862   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      863                      p-where-cond + chr(32)  +
      864                      p-use-indFIRST-query-tail + chr(32) +
      865                      p-use-ind-sort-clmn-by + chr(32) +
      866                      p-indexed-reposition
      867   .
      868   assign
      869   glog = p-qh:query-prepare(v-prepare-string) no-error .
      870   if not glog
      871   or error-status:error then do:
      872     message error-status:get-message(1) view-as alert-box .
      873     undo, return error .
      874   end.
      875   assign
      876   glog = p-qh:query-open no-error .
      877   if not glog
      878   or error-status:error then do:
      879     message error-status:get-message(1) view-as alert-box .
      880     undo, return error .
      881   end.
      882     end.
      883   end procedure.
      884   procedure fltopend_fltfindd :
      885   define input parameter p-parent-handle as handle no-undo .
      886   define input parameter p-qh as handle no-undo .
      887   define input parameter p-rowid as rowid no-undo .
      888   define input parameter p-next as logical no-undo .
      889   define input parameter p-lock as integer no-undo .
      890   define input parameter p-bh as handle no-undo .
      891   define input parameter p-where-cond as character no-undo .
      892   define input parameter p-use-index-phrase as character no-undo .
      893   define variable glog as logical no-undo .
      894   define variable v-qh as handle no-undo .
      895   define variable v-bh as handle no-undo .
      896   define variable v-recid as recid no-undo .
      897   define variable v-prepare-string as character no-undo .
      898   do
      899   on error undo, return error
      900   on stop undo, return error
      901   :
      902     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
      903     create buffer v-bh for table p-bh buffer-name p-bh:name.
      904     create query v-qh.
      905     v-qh:set-buffers(v-bh).
      906     v-prepare-string = substitute("for each &1 &2 &3"
      907                                     ,v-bh:name
      908                                     ,p-where-cond
      909                                     ,p-use-index-phrase).
      910     glog = v-qh:query-prepare(v-prepare-string) no-error.
      911     if not glog then do:
      912       delete object v-qh.
      913       delete object v-bh.
      914       undo, return error .
      915     end.
      916     glog = v-qh:query-open no-error .
      917     if not glog then do:
      918       delete object v-qh.
      919       delete object v-bh.
      920       undo, return error .
      921     end.
      922     if p-next then do:
      923       v-qh:reposition-to-rowid(p-rowid) no-error .
      924       glog = v-qh:get-next( p-lock) no-error .
      925       glog = v-qh:get-next( p-lock) no-error .
      926       if not glog or v-qh:query-off-end = yes then do:
      927         glog = v-qh:get-first( p-lock) no-error .
      928       end.
      929     end.
      930     else do:
      931       glog = v-qh:get-first( p-lock) no-error .
      932     end.
      933     v-recid = v-bh:recid no-error .
      934     delete object v-qh.
      935     delete object v-bh.
      936     return string(v-recid) .
      937   end.
      938   end procedure.
      939   procedure fltopend_fltfindq :
      940   define input parameter p-parent-handle as handle no-undo .
      941   define input parameter p-qh as handle no-undo .
      942   define input parameter p-next as logical no-undo .
      943   define input parameter p-lock as integer no-undo .
      944   define input parameter p-flt-open-open-query  as character no-undo .
      945   define input parameter p-where-cond as character no-undo .
      946   define input parameter p-use-indFIRST-query-tail as character no-undo .
      947   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      948   define input parameter p-indexed-reposition as character no-undo .
      949   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
      950   define variable glog as logical no-undo .
      951   define variable v-qh as handle no-undo .
      952   define variable v-bh as handle no-undo extent 18.
      953   define variable v-rowid as rowid no-undo extent 18.
      954   define variable v-ii as integer no-undo .
      955   define variable v-prepare-string as character no-undo .
      956   do
      957   on error undo, return error
      958   on stop undo, return error
      959   :
      960     create query v-qh.
      961     do v-ii = 1 to p-qh:num-buffers:
      962       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
      963       assign
      964       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
      965       no-error.
      966       v-qh:add-buffer(v-bh[v-ii]).
      967     end.
      968     assign
      969     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      970                       p-where-cond + chr(32)  +
      971                       p-use-indFIRST-query-tail + chr(32) +
      972                       p-use-ind-sort-clmn-by + chr(32) +
      973                       p-indexed-reposition
      974     .
      975     glog = v-qh:query-prepare( v-prepare-string) no-error .
      976     if not glog then do:
      977       delete object v-qh.
      978       do v-ii = 1 to p-qh:num-buffers:
      979         delete object v-bh[v-ii].
      980       end.
      981       undo, return error .
      982     end.
      983     glog = v-qh:query-open no-error .
      984     if not glog then do:
      985       delete object v-qh.
      986       do v-ii = 1 to p-qh:num-buffers:
      987         delete object v-bh[v-ii].
      988       end.
      989       undo, return error .
      990     end.
      991     if p-next then do:
      992       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
      993       glog = v-qh:get-next( p-lock) no-error .
      994       glog = v-qh:get-next( p-lock) no-error .
      995       if not glog or v-qh:query-off-end = yes then do:
      996         glog = v-qh:get-first( p-lock) no-error .
      997       end.
      998     end.
      999     else do:
     1000       glog = v-qh:get-first( p-lock) no-error .
     1001     end.
     1002     do v-ii = 1 to p-qh:num-buffers:
     1003       assign
     1004       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
     1005       no-error.
     1006     end.
     1007     delete object v-qh.
     1008     do v-ii = 1 to p-qh:num-buffers:
     1009       delete object v-bh[v-ii].
     1010     end.
     1011   end.
     1012   end procedure.
