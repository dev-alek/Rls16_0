     3263     if l-filter-open-34 = false then do:
     3264       OPEN QUERY br-delivsubject FOR  EACH  X_delivery-subject no-lock
     3265         where  X_delivery-subject.sts = p-sts
     3266         indexed-reposition
     3267     .
     3268         assign
     3269           l-query-was-opened = true
     3270         .
     3271     end.
     3272   end.
     3273   else do:
     3274     assign
     3275       v-doc-rec = recid( X_delivery-subject )
     3276     .
     3277     do
     3278     on stop undo, leave
     3279     on error undo, leave
     3280     :
     3281       if query br-delivsubject:handle:get-buffer-handle(1) = (buffer X_delivery-subject:handle) then do:
     3282         assign
     3283         parameter-2-34 = (if p-find-next then "true":u else "false":u )
     3284         parameter-4-34 =
     3285           "where ":u +  substitute('X_delivery-subject.sts = &1', p-sts)  + " ":u + where-phrase-34 + " ":u + p-find-condition + " " + ""
     3286         parameter-5-34 = "  "
     3287       .
     3288         run fltopend_fltfindd in this-procedure  (
     3289                             input this-procedure:handle
     3290                             ,input query br-delivsubject:handle
     3291                             ,input rowid(X_delivery-subject)
     3292                             ,input logical(parameter-2-34)
     3293                             ,input no-lock
     3294                             ,input (buffer X_delivery-subject:handle)
     3295                             ,input parameter-4-34
     3296                             ,input parameter-5-34
     3297                             ) no-error.
     3298         .
     3299         assign
     3300           v-doc-rec = integer(return-value)
     3301           v-fltopend-rowid[1] = ?
     3302         .
     3303       end.
     3304       else do:
     3305         assign
     3306         parameter-2-34 = (if p-find-next then "true":u else "false":u )
     3307         parameter-3-34 =  "FOR EACH X_delivery-subject"
     3308         parameter-4-34 =
     3309           (
     3310             if (" X_delivery-subject.sts = p-sts " + " " + where-phrase-34) <> ""
     3311             then  substitute('X_delivery-subject.sts = &1', p-sts)  + " " + where-phrase-34
     3312             else "true"
     3313           )
     3314         parameter-5-34 = (" " + "" + " " + "" + " " + p-find-condition)
     3315         parameter-6-34 = if sort-phrase-34 = ''
     3316                              then
     3317           (
     3318           " " + "  " +
     3319             " " + sort-column-phrase +
     3320           " " + "  "
     3321           )
     3322                              else
     3323           (
     3324           " " + "  " +
     3325             " " + sort-column-phrase +
     3326           " " + sort-phrase-34
     3327           )
     3328         parameter-7-34 =
     3329           " indexed-reposition  "
     3330       .
     3331         run fltopend_fltfindq in this-procedure  (
     3332                             input this-procedure:handle
     3333                             ,input query br-delivsubject:handle
     3334                             ,input logical(parameter-2-34)
     3335                             ,input no-lock
     3336                             ,input parameter-3-34
     3337                             ,input parameter-4-34
     3338                             ,input parameter-5-34
     3339                             ,input parameter-6-34
     3340                             ,input parameter-7-34
     3341                             ,output v-fltopend-rowid
     3342                             ) no-error.
     3343         .
     3344         v-doc-rec = ?.
     3345       end.
     3346       assign
     3347         l-query-was-opened = true
     3348       .
     3349     end.
     3350   end.
     3351     run waitfram-hide in this-procedure .
     3352   end.
     3353   if not p-open-query then
     3354   REPOSITION br-delivsubject to recid v-doc-rec No-ERROR.
     3355   if not p-open-query and v-fltopend-rowid[1] <> ? then
     3356   query br-delivsubject:handle:reposition-to-rowid(v-fltopend-rowid) No-ERROR.
     3357   run waitfram-hide in this-procedure.
     3358   APPLY "VALUE-CHANGED" TO br-delivsubject in frame Dialog-Frame.
     3359   APPLY "ENTRY" TO br-delivsubject.
     3360   END PROCEDURE.
     3361   PROCEDURE proc-b-del :
     3362   define variable loc#log as logical no-undo.
     3363   define variable v-sts like ub.delivery-subject.sts no-undo .
     3364   DEFINE VARIABLE loc-doc-rec AS RECID NO-UNDO.
     3365   if not available X_delivery-subject then return error.
     3366   do
     3367   on error undo, return error
     3368   on stop undo, return error
     3369   :
     3370   define variable vss-include-info35 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3371   do:
     3372     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     3373       (input  v-cntxt-db-num
     3374       ,input  v-cntxt-userid
     3375       ,input  0
     3376       ,input  'actn_delivery-storage_work':U
     3377       ,input  'global':U
     3378       ,input  0
     3379       ,input  '':U
     3380       ,input  0
     3381       ,input  0
     3382       ,input  0
     3383       ,input  0
     3384       ,input  true
     3385       ,output loc#log
     3386       )  .
     3387   end.
     3388   if not loc#log then return error.
     3389     assign
     3390     v-sts = ?
     3391     loc-doc-rec = RECID(X_delivery-subject)
     3392     .
     3393     run ref/dlvsubj2.p (
     3394                     input recid(X_delivery-subject)
     3395                     ,input-output v-sts
     3396                    ) no-error .
     3397     if error-status:error then undo, return error.
     3398     RUN OpenBr ( input yes, input no, input no).
     3399     REPOSITION br-delivsubject to recid loc-doc-rec No-error.
     3400     if error-status:error then do:                           find first pos_delivery-subject no-lock where                                   recid(pos_delivery-subject) = loc-doc-rec no-error .                             message                             "Невозможно позиционироваться на записи СУБЪЕКТА ДОСТАВКИ" skip                            string(if avail pos_delivery-subject                                     then  substitute("Вн код субъекта доставки: &1"                                                     , pos_delivery-subject.deliv-subj-code)                                     else "":U) skip                             "Запись была добавлена (или изменена или удалена) -" skip                             "и теперь не попадает в текущую выборку"                             view-as alert-box WARNING.                           end.
     3401     if available X_delivery-subject then do:
     3402       loc#log = br-delivsubject:select-focused-row( ) IN FRAME Dialog-Frame.
     3403     end.
     3404     apply "ENTRY" to br-delivsubject.
     3405   end.
     3406   END PROCEDURE.
     3407   PROCEDURE proc-b-print :
     3408   define variable v-doc-rec as recid no-undo .
     3409   define variable accum-count as integer.
     3410   define variable date_string     as      char    no-undo.
     3411   define variable Line            as      char    no-undo.
     3412   DEFINE VARIABLE v-sts-chr AS CHARACTER NO-UNDO.
     3413   DEFINE FRAME delivery-subject-list
     3414   X_delivery-subject.deliv-subj-name
     3415   v-sts-chr FORMAT "X(8)" COLUMN-LABEL "Статус"
     3416   X_delivery-subject.des FORMAT "X(100)"
     3417   X_delivery-subject.deliv-subj-code COLUMN-LABEL "Вн.код!группы"
     3418   HEADER  date_string AT 5 format "X(35)"
     3419    string( "Страница " ) format "X(9)" AT 115 PAGE-NUMBER(PrnLibStream) AT 125 FORMAT ">>9" SKIP
     3420   Line format "X(195)" AT 1
     3421   with width 232 down stream-io use-text    .
     3422   Line = fill("-", 195).
     3423   date_string = cur-time-print() .
     3424   run prn-lib-open-stream  in this-procedure (
     3425                                                input parParentProc
     3426                                               ,input 43
     3427                                               ,input yes
     3428                                               ,input no
     3429                                               ).
     3430   PUT  STREAM PrnLibStream
     3431   SPACE(25) ( frame Dialog-Frame:title )
     3432   format "x(90)" SKIP(1) .
     3433   FORM HEADER
     3434   Line format "X(195)" AT 1 SKIP
     3435   "Продолжение - на следующей странице" AT 30 SKIP
     3436   with FRAME BottomFrame width 232 PAGE-BOTTOM NO-LABELS NO-BOX .
     3437   VIEW  STREAM PrnLibStream FRAME BottomFrame .
     3438   FORM with FRAME delivery-subject-list  .
     3439   run waitfram-show in this-procedure ("Ждите...").
     3440   v-doc-rec = recid(X_delivery-subject).
     3441   DO WHILE available X_delivery-subject :
     3442     GET prev br-delivsubject.
     3443   END.
     3444   GET next br-delivsubject.
     3445   DO WHILE available X_delivery-subject :
     3446     Display STREAM PrnLibStream
     3447      X_delivery-subject.deliv-subj-name
     3448     entry (lookup (STRING(p-sts), '0,1,50,99':U), 'тек,удал,блок,удаление':U) @ v-sts-chr
     3449     X_delivery-subject.des
     3450     X_delivery-subject.deliv-subj-code
     3451   with FRAME delivery-subject-list .
     3452     DOWN STREAM PrnLibStream 1
     3453     with FRAME delivery-subject-list  .
     3454     assign
     3455     accum-count = accum-count + 1
     3456     .
     3457     GET next br-delivsubject.
     3458   END.
     3459   UNDERLINE  STREAM PrnLibStream
     3460   X_delivery-subject.deliv-subj-name
     3461   v-sts-chr
     3462   X_delivery-subject.des
     3463   X_delivery-subject.deliv-subj-code
     3464   with FRAME delivery-subject-list .
     3465   DISPLAY STREAM PrnLibStream
     3466   "ИТОГО" @ X_delivery-subject.deliv-subj-name
     3467   accum-count @ v-sts-chr
     3468   with frame delivery-subject-list.
     3469   HIDE  STREAM PrnLibStream FRAME BottomFrame .
     3470   HIDE  STREAM PrnLibStream FRAME delivery-subject-List.
     3471   output  STREAM PrnLibStream CLOSE.
     3472   REPOSITION br-delivsubject to recid v-doc-rec no-error.
     3473   APPLY "entry" to br-delivsubject.
     3474   run waitfram-hide in this-procedure .
     3475   run prn-lib-prn-file in this-procedure (
     3476                                             input parParentProc
     3477                                             ,input 8
     3478                                             ).
     3479   END PROCEDURE.
     3480   PROCEDURE proc-b-sch :
     3481   assign
     3482     tbl = 'delivery-subject'
     3483     join-tbl = 'X_delivery-subject'
     3484     fld = ""
     3485     lab = ""
     3486     spr = ""
     3487     dim = '0'
     3488     .
     3489   run fltfield-add in this-procedure('deliv-subj-code', 'Код субъекта доставки', '',
     3490   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3491   run fltfield-add in this-procedure('reg-code', 'Регион', '',
     3492   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3493   run fltfield-add in this-procedure('deliv-subj-name', 'Название', '',
     3494   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3495   Filter-Block:
     3496   DO ON STOP    UNDO Filter-Block, LEAVE Filter-Block
     3497       ON ERROR   UNDO Filter-Block, LEAVE Filter-Block
     3498       ON END-KEY UNDO Filter-Block, LEAVE Filter-Block :
     3499     run gbl/filter.w ( INPUT parparentproc
     3500                       , INPUT (filter-point + chr(4) +
     3501                               filter-point-name)
     3502                       , INPUT tbl
     3503                       , INPUT join-tbl
     3504                       , INPUT fld
     3505                       , INPUT lab
     3506                       , INPUT spr
     3507                       , INPUT dim ).
     3508     run OpenBr in this-procedure ( input yes, input no, input '':U).
     3509   END.
     3510   END PROCEDURE.
     3511   PROCEDURE proc-br-delivsubject :
     3512   define variable vss-include-info36 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3513   if b-sel:sensitive in frame Dialog-Frame then dO:
     3514       if b-mark:sensitive then do:
     3515           apply "choose" to b-mark in frame Dialog-Frame.
     3516       end.
     3517       else do:
     3518           apply "choose" to b-sel in frame Dialog-Frame.
     3519       end.
     3520   end.
     3521   else do:
     3522       if b-lkp:sensitive then
     3523       apply "choose" to b-lkp in frame Dialog-Frame.
     3524   end.
     3525   END PROCEDURE.
