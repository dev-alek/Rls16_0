      395   define variable v-start as logical no-undo init yes.
      396   FUNCTION rule-name RETURNS CHARACTER
      397     ( INPUT p-table-name AS character, input p-classif-type as character, input p-discnt-role AS character )  FORWARD.
      398   DEFINE BUTTON B-Help
      399        LABEL "Помо&щь"
      400        SIZE 3 BY 1
      401        BGCOLOR 8 .
      402   DEFINE BUTTON B-mark
      403        LABEL "&*"
      404        SIZE 3 BY 1.
      405   DEFINE BUTTON b-quit AUTO-END-KEY
      406        LABEL "&Выход"
      407        SIZE 10 BY 1
      408        BGCOLOR 8 .
      409   DEFINE BUTTON B-sel AUTO-GO
      410        LABEL "Вы&бор"
      411        SIZE 10 BY 1.
      412   DEFINE VARIABLE mark-num AS CHARACTER FORMAT "X(256)":U
      413         VIEW-AS TEXT
      414        SIZE 6 BY 1
      415        FGCOLOR 4  NO-UNDO.
      416   DEFINE QUERY br-dis-pos FOR
      417         tt-dis-pos,
      418         X_dis-rule,
      419         X_dis-time-rule SCROLLING.
      420   DEFINE BROWSE br-dis-pos
      421     QUERY br-dis-pos NO-LOCK DISPLAY
      422         entry (lookup (tt-dis-pos.pos-type, 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,r-keeper,InfoKiosk,pricecheck-Servis+,Emulator-NKT-IBM,MARIA,-,bo,Autotank':U), 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,R-KEEPER,InfoKiosk,Прайс-чекер Servis+,Emulator-NKT-IBM,MARIA,Накладная,Бэкофис,Autotank':U) FORMAT "X(15)":U COLUMN-LABEL "Тип POS!(место использ)"
      423   rule-name( INPUT tt-dis-pos.table-name, INPUT tt-dis-pos.self-nonunique, INPUT tt-dis-pos.discnt-role) COLUMN-LABEL "Роль скидки" FORMAT "X(255)":U WIDTH 35
      424   (tt-dis-pos.has-global = 1) FORMAT "+":U COLUMN-LABEL "Глоб"
      425   (tt-dis-pos.has-host = 1) FORMAT "+":U COLUMN-LABEL "Фирма"
      426   (tt-dis-pos.has-obj = 1) FORMAT "+":U COLUMN-LABEL "Объ."
      427   tt-dis-pos.templ-rl-root FORMAT ">>>9":U COLUMN-LABEL "Код!шабл."
      428   tt-dis-pos.time-templ-rl-root FORMAT "->>>>9":U COLUMN-LABEL "Код!шабл.!распис"
      429   (IF AVAILABLE X_dis-time-rule
      430    THEN X_dis-time-rule.des
      431    ELSE "") FORMAT "X(80)":U COLUMN-LABEL "Тип расписания" WIDTH 20
      432   X_dis-rule.des FORMAT "X(255)":U column-label "Описание" WIDTH 45
      433       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 12.
      434   DEFINE FRAME Dialog-Frame
      435        b-quit AT ROW 1 COL 1
      436        B-mark AT ROW 1 COL 11
      437        B-sel AT ROW 1 COL 21
      438        B-Help AT ROW 1 COL 95
      439        br-dis-pos AT ROW 3 COL 1
      440        mark-num AT ROW 1 COL 12.5 COLON-ALIGNED NO-LABEL
      441        SPACE(78.50) SKIP(13.66)
      442       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      443            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      444            TITLE "Возможные типы скидок на товар"
      445            CANCEL-BUTTON b-quit.
      446   ASSIGN
      447          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      448          FRAME Dialog-Frame:HIDDEN           = TRUE.
      449   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      450   DO:
      451     APPLY "END-ERROR":U TO SELF.
      452   END.
      453   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
      454   DO:
      455     define variable loc#log as logical no-undo .
      456     if available tt-dis-pos then do:
      457   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      458   define variable v-str-recid3 as character no-undo .
      459   define variable v-num-entry3 as integer   no-undo .
      460   assign
      461     v-str-recid3 = trim( string( tt-dis-pos.recid_ , "->>>>>>>>>>>9":U ) )
      462     v-num-entry3 = lookup( v-str-recid3 , p-rid-list )
      463   .
      464   if v-num-entry3 > 0 then do:
      465     assign
      466       entry( v-num-entry3, p-rid-list ) = "":U
      467       p-rid-list = trim( replace( p-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
      468     .
      469   end.
      470   else do:
      471     assign
      472       p-rid-list = p-rid-list + ( if p-rid-list = "":U then "":U else chr(44) ) + v-str-recid3
      473     .
      474   end.
      475       loc#log = br-dis-pos:refresh() .
      476       if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
      477           loc#log = br-dis-pos:select-next-row ().
      478           apply "VALUE-CHANGED" to br-dis-pos in frame Dialog-Frame.
      479       end.
      480       if num-entries( p-rid-list ) = 0
      481       then
      482           hide mark-num in frame Dialog-Frame.
      483       else
      484           DISPLAY num-entries( p-rid-list ) @ mark-num with frame Dialog-Frame.
      485     end.
      486     apply "entry" to br-dis-pos in frame Dialog-Frame.
      487   END.
      488   ON CHOOSE OF B-sel IN FRAME Dialog-Frame
      489   DO:
      490       if ( available tt-dis-pos ) then do:
      491       if  ( p-rid-list = "" ) or b-mark:sensitive = no
      492       then
      493       p-rid-list = string( tt-dis-pos.recid_ ) .
      494     end.
      495   END.
      496   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      497   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      498   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      499   on help of frame Dialog-Frame
      500   do:
      501     run gbl/app_help.p
      502       (input this-procedure :file-name
      503       ,input ''
      504       ,input ?
      505       ) no-error.
      506     if error-status :error then do:
      507       message
      508         "Ошибка при вызове помощи"
      509         error-status :get-message(1)
      510         view-as alert-box .
      511     end.
      512   end.
      513   run minbtn-set in this-procedure .
      514   on choose of b-help in frame Dialog-Frame
      515   do:
      516     apply "help":u to frame Dialog-Frame .
      517   end.
      518   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      519   procedure minbtn-set :
      520       do
      521           on error undo, return error return-value
      522           :
      523           define variable ii              as integer       no-undo .
      524           define variable fh              as widget-handle no-undo .
      525           define variable hh              as widget-handle no-undo .
      526           define variable v-h             as handle        extent 4 no-undo .
      527           define variable v-name-button   as character     no-undo .
      528           define variable v-help-old-x    as decimal       no-undo .
      529           define variable v-help-old-y    as decimal       no-undo .
      530           define variable v-help-old-size as decimal       no-undo .
      531           define variable v-frame-width   as decimal       no-undo .
      532           define variable jj              as integer       no-undo .
      533           do
      534               on error undo, return error
      535               :
      536               assign
      537                   v-frame-width = frame Dialog-Frame:width - 0.3
      538                   fh            = frame Dialog-Frame:first-child
      539                   hh            = fh:first-child
      540                   ii            = 1
      541                   .
      542               do while valid-handle(hh):
      543                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      544                   do:
      545                       case lc(hh:name) :
      546                           when "b-help" then
      547                               do:
      548                                   hh:load-image-up("cmp/b-help.bmp":u) .
      549                                   hh:load-image-down("cmp/b-help.bmp":u) .
      550                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      551                                   hh:TOOLTIP = "Помощь" .
      552                                   v-help-old-x = hh:column .
      553                                   v-help-old-y = hh:row    .
      554                                   v-help-old-size = hh:width .
      555                                   hh:width-chars = 2.5 .
      556                               end.
      557                           when "b-print" then
      558                               do:
      559                                   hh:load-image("cmp/b-print.bmp":u) .
      560                                   hh:TOOLTIP = "Печать" .
      561                                   v-h[ii] = hh:handle .
      562                                   ii = ii + 1 .
      563                                   hh:width-chars = 3 .
      564                               end.
      565                           when "b-history" or
      566                           when "b-hist" then
      567                               do:
      568                                   hh:load-image("cmp/b-hist.bmp":u) .
      569                                   hh:TOOLTIP = "История" .
      570                                   v-h[ii] = hh:handle .
      571                                   ii = ii + 1 .
      572                                   hh:width-chars = 3 .
      573                               end.
      574                           when "b-sch" then
      575                               do:
      576                                   hh:load-image("cmp/b-sch.bmp":u) .
      577                                   hh:TOOLTIP = "Установка Фильтра" .
      578                                   v-h[ii] = hh:handle .
      579                                   ii = ii + 1 .
      580                                   hh:width-chars = 3 .
      581                               end.
      582                           when "b-hist-user" then
      583                               do:
      584                                   hh:load-image("cmp/b-hist.bmp":u) .
      585                                   hh:TOOLTIP = "История пользователя" .
      586                                   ii = ii + 1 .
      587                               end.
      588                       end case.
      589                   end.
      590                   hh = hh:next-sibling.
      591               end.
      592               b-help:column = v-frame-width - b-help:width-chars.
      593               jj = 0.
      594               repeat ii = 4 to 1 by -1 :
      595                   if valid-handle (v-h[ii] ) then
      596                   do:
      597                       jj  = jj + 1 .
      598                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      599                       v-h[ii]:row    = v-help-old-y .
      600                   end.
      601               end.
      602           end.
      603       end.
      604   end procedure.
      605   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      606   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      607   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      608   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      609   define variable v-diasize-current-frame-width  as decimal   no-undo .
      610   define variable v-diasize-current-frame-height as decimal   no-undo .
      611   define variable v-diasize-change-size          as logical   no-undo .
      612   define variable v-diasize-resize-button        as handle    no-undo .
      613   define variable v-diasize-wndmax               as logical   no-undo .
      614   define variable v-diasize-wndstore             as logical   no-undo .
      615   define variable v-diasize-proc-name            as character no-undo .
      616   define variable v-diasize-browse-handle        as handle    no-undo .
      617   define variable v-diasize-browse-number        as integer   no-undo .
      618   define variable v-diasize-need-full-display    as logical   no-undo init false .
      619   define temp-table temp-diasize-handle no-undo
      620     field handle-value  as handle
      621     field save-position as decimal
      622     index xpk is primary unique handle-value
      623     .
      624   define temp-table temp-browse-handle no-undo
      625     field browse-type   as character
      626     field browse-number as integer
      627     field browse-handle as handle
      628     field original-size as decimal
      629     index xpk is primary unique browse-type browse-number
      630     index xie browse-type browse-handle
      631   .
      632   procedure diasize_change-height :
      633     define input  parameter p-change-value  as decimal   no-undo .
      634     define input  parameter p-move-resize   as logical   no-undo .
      635     define variable v-field-group-handle    as handle    no-undo .
      636     define variable v-object-handle         as handle    no-undo .
      637     define variable v-frame-height          as decimal   no-undo .
      638     define variable v-frame-virtual-height  as decimal   no-undo .
      639     define variable v-browse-height         as decimal   no-undo .
      640     define variable v-window-height         as decimal   no-undo .
      641     define variable v-window-virtual-height as decimal   no-undo .
      642     define variable v-change-sign           as integer   no-undo .
      643     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      644     define buffer buf_temp-browse-handle  for temp-browse-handle .
      645     if p-change-value > 0
      646     then do:
      647       if frame Dialog-Frame :height + p-change-value
      648           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      649       then do:
      650         assign
      651           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      652                           - (frame Dialog-Frame :height-chars)
      653         .
      654         if p-change-value <= 0
      655         then do:
      656           run diasize_position-resize-button in this-procedure .
      657           return .
      658         end.
      659       end.
      660     end.
      661     if p-change-value < 0
      662     then do:
      663       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      664       then do:
      665         assign
      666           p-change-value = v-diasize-orig-frame-height
      667                          - (frame Dialog-Frame :height-chars)
      668         .
      669         if p-change-value >= 0
      670         then do:
      671           run diasize_position-resize-button in this-procedure .
      672           return .
      673         end.
      674       end.
      675     end.
      676     if p-change-value >= 0
      677     then do:
      678       assign
      679         v-change-sign = 1
      680       .
      681     end.
      682     else do:
      683       assign
      684         v-change-sign = -1
      685       .
      686     end.
      687     assign
      688       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      689     .
      690     if p-change-value = 0
      691     then do:
      692       run diasize_position-resize-button in this-procedure .
      693       return .
      694     end.
      695     move_block:
      696     do
      697     on error undo move_block, retry move_block
      698     :
      699       if retry
      700       then do:
      701         do
      702         on error undo move_block, leave move_block
      703         :
      704           if p-change-value > 0
      705           then do:
      706             for each buf_temp-diasize-handle
      707             on error undo, next
      708             :
      709               assign
      710                 v-object-handle = buf_temp-diasize-handle.handle-value
      711               .
      712               if v-object-handle <> v-diasize-resize-button
      713               then do:
      714                 assign
      715                   v-object-handle :row = buf_temp-diasize-handle.save-position
      716                 .
      717               end.
      718             end.
      719             assign
      720               v-diasize-browse-handle :height = v-browse-height
      721             .
      722             for each buf_temp-browse-handle
      723               where buf_temp-browse-handle.browse-type = 'height':u
      724             on error undo, next
      725             :
      726               assign
      727                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      728               .
      729             end.
      730             assign
      731               frame Dialog-Frame :height = v-frame-height
      732             .
      733             if frame Dialog-Frame :scrollable = true
      734             then do:
      735               assign
      736                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      737               .
      738             end.
      739             run diasize_position-resize-button in this-procedure .
      740           end.
      741           else do:
      742             if frame Dialog-Frame :scrollable = true
      743             then do:
      744               assign
      745                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      746               .
      747             end.
      748             assign
      749               frame Dialog-Frame :height = v-frame-height
      750             .
      751             assign
      752               v-diasize-browse-handle :height = v-browse-height
      753             .
      754             for each buf_temp-browse-handle
      755               where buf_temp-browse-handle.browse-type = 'height':u
      756             on error undo, next
      757             :
      758               assign
      759                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      760               .
      761             end.
      762             for each buf_temp-diasize-handle
      763             on error undo, next
      764             :
      765               assign
      766                 v-object-handle = buf_temp-diasize-handle.handle-value
      767               .
      768               if v-object-handle <> v-diasize-resize-button
      769               then do:
      770                 assign
      771                   v-object-handle :row = buf_temp-diasize-handle.save-position
      772                 .
      773               end.
      774             end.
      775             run diasize_position-resize-button in this-procedure .
      776           end.
      777           assign
      778             v-diasize-change-size = false
      779           .
      780           leave move_block .
      781         end.
      782       end.
      783       assign
      784         v-diasize-need-full-display = true
      785       .
      786       if v-diasize-change-size = false
      787       then do:
      788         assign
      789           v-diasize-change-size = true
      790         .
      791       end.
      792       else do:
      793         return .
      794       end.
      795       assign
      796         v-frame-height = frame Dialog-Frame :height
      797         v-frame-virtual-height = frame Dialog-Frame :virtual-height
      798         v-browse-height = v-diasize-browse-handle :height
      799       .
      800       for each buf_temp-browse-handle
      801         where buf_temp-browse-handle.browse-type = 'height':u
      802       :
      803         assign
      804           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
      805         .
      806       end.
      807       for each buf_temp-diasize-handle
      808       :
      809         delete buf_temp-diasize-handle .
      810       end.
      811       assign
      812         v-field-group-handle = frame Dialog-Frame :first-child
      813       .
      814       do while valid-handle(v-field-group-handle)
      815       :
      816         assign
      817           v-object-handle = v-field-group-handle :first-child
      818         .
      819         do while valid-handle(v-object-handle)
      820         :
      821           if  v-object-handle <> v-diasize-browse-handle :handle
      822           and can-query(v-object-handle, "row")
      823           and can-query(v-object-handle, "height")
      824           and ( v-object-handle :row > v-diasize-browse-handle :row )
      825           then do:
      826             find first buf_temp-browse-handle
      827               where buf_temp-browse-handle.browse-type   = 'height':u
      828                 and buf_temp-browse-handle.browse-handle = v-object-handle
      829               no-error .
      830             if available buf_temp-browse-handle
      831             then do:
      832             end.
      833             else do:
      834               create buf_temp-diasize-handle .
      835               assign
      836                 buf_temp-diasize-handle.handle-value  = v-object-handle
      837                 buf_temp-diasize-handle.save-position = v-object-handle :row
      838               .
      839             end.
      840           end.
      841           assign
      842             v-object-handle = v-object-handle :next-sibling
      843           .
      844         end.
      845         assign
      846           v-field-group-handle = v-field-group-handle :next-sibling
      847         .
      848       end.
      849       do with frame Dialog-Frame
      850       :
      851         hide v-diasize-resize-button .
      852         assign
      853           v-diasize-resize-button :row    = 1
      854           v-diasize-resize-button :column = 1
      855         .
      856       end.
      857       if p-change-value > 0
      858       then do:
      859         if frame Dialog-Frame :scrollable = true
      860         then do:
      861           assign
      862             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      863             no-error .
      864           if error-status :error
      865           or error-status :get-message(1) <> ""
      866           then do:
      867             undo move_block, retry move_block .
      868           end.
      869         end.
      870         assign
      871           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      872           no-error .
      873         if error-status :error
      874         or error-status :get-message(1) <> ""
      875         then do:
      876           undo move_block, retry move_block .
      877         end.
      878         assign
      879           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      880           no-error .
      881         if error-status :error
      882         or error-status :get-message(1) <> ""
      883         then do:
      884           undo move_block, retry move_block .
      885         end.
      886         for each buf_temp-browse-handle
      887           where buf_temp-browse-handle.browse-type = 'height':u
      888         on error undo move_block, retry move_block
      889         :
      890           assign
      891             buf_temp-browse-handle.browse-handle :height
      892               = buf_temp-browse-handle.browse-handle :height + p-change-value
      893             no-error .
      894           if error-status :error
      895           or error-status :get-message(1) <> ""
      896           then do:
      897             undo move_block, retry move_block .
      898           end.
      899         end.
      900         for each buf_temp-diasize-handle
      901         on error undo move_block, retry move_block
      902         :
      903           assign
      904             v-object-handle = buf_temp-diasize-handle.handle-value
      905           .
      906           if v-object-handle <> v-diasize-resize-button
      907           then do:
      908             assign
      909               v-object-handle :row = v-object-handle :row + p-change-value
      910               no-error .
      911             if error-status :error
      912             or error-status :get-message(1) <> ""
      913             then do:
      914               undo move_block, retry move_block .
      915             end.
      916           end.
      917         end.
      918       end.
      919       else do:
      920         for each buf_temp-diasize-handle
      921         on error undo move_block, retry move_block
      922         :
      923           assign
      924             v-object-handle = buf_temp-diasize-handle.handle-value
      925           .
      926           if v-object-handle <> v-diasize-resize-button
      927           then do:
      928             assign
      929               v-object-handle :row = v-object-handle :row + p-change-value
      930               no-error .
      931             if error-status :error
      932             or error-status :get-message(1) <> ""
      933             then do:
      934               undo move_block, retry move_block .
      935             end.
      936           end.
      937         end.
      938         assign
      939           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      940           no-error .
      941         if error-status :error
      942         or error-status :get-message(1) <> ""
      943         then do:
      944           undo move_block, retry move_block .
      945         end.
      946         for each buf_temp-browse-handle
      947           where buf_temp-browse-handle.browse-type = 'height':u
      948         on error undo move_block, retry move_block
      949         :
      950           assign
      951             buf_temp-browse-handle.browse-handle :height
      952               = buf_temp-browse-handle.browse-handle :height + p-change-value
      953             no-error .
      954           if error-status :error
      955           or error-status :get-message(1) <> ""
      956           then do:
      957             undo move_block, retry move_block .
      958           end.
      959         end.
      960         assign
      961           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      962           no-error .
      963         if error-status :error
      964         or error-status :get-message(1) <> ""
      965         then do:
      966           undo move_block, retry move_block .
      967         end.
      968         if frame Dialog-Frame :scrollable = true
      969         then do:
      970           assign
      971             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      972             no-error .
      973           if error-status :error
      974           or error-status :get-message(1) <> ""
      975           then do:
      976             undo move_block, retry move_block .
      977           end.
      978         end.
      979       end.
      980       if p-move-resize = true
      981       then do:
      982         run diasize_position-resize-button in this-procedure .
      983       end.
      984       if v-diasize-wndstore = true
      985       then do:
      986         if connected("ub") = true
      987         then do:
      988           define variable v-cntxt-db-num        as integer   no-undo .
      989           define variable v-cntxt-userid        as character no-undo .
      990           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
      991                                             , OUTPUT v-cntxt-userid
      992                                             ) .
      993           run gbl/wndsizew.p
      994             (input  v-cntxt-db-num
      995             ,input  v-cntxt-userid
      996             ,input  v-diasize-proc-name
      997             ,input  'height':u
      998             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
      999             ) .
     1000         end.
     1001       end.
     1002     end.
     1003     assign
     1004       v-diasize-change-size = false
     1005     .
     1006   end procedure.
     1007   procedure diasize_set-height :
     1008     define input  parameter p-new-height  as decimal   no-undo .
     1009     define input  parameter p-move-resize as logical   no-undo .
     1010     do
     1011     on error undo, return error return-value
     1012     :
     1013       run diasize_change-height in this-procedure
     1014         (input  (p-new-height - frame Dialog-Frame :height)
     1015         ,input  p-move-resize
     1016         ) .
     1017     end.
     1018   end procedure.
     1019   procedure diasize_change-width :
     1020     define input  parameter p-change-value as decimal   no-undo .
     1021     define input  parameter p-move-resize  as logical   no-undo .
     1022     define variable v-field-group-handle   as handle    no-undo .
     1023     define variable v-object-handle        as handle    no-undo .
     1024     define variable v-frame-width          as decimal   no-undo .
     1025     define variable v-frame-virtual-width  as decimal   no-undo .
     1026     define variable v-browse-width         as decimal   no-undo .
     1027     define variable v-window-width         as decimal   no-undo .
     1028     define variable v-window-virtual-width as decimal   no-undo .
     1029     define variable v-change-sign          as integer   no-undo .
     1030     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1031     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1032     if p-change-value > 0
     1033     then do:
     1034       if frame Dialog-Frame :width + p-change-value >
     1035           session :width-chars
     1036       then do:
     1037         assign
     1038           p-change-value = session :width-chars - frame Dialog-Frame :width
     1039         .
     1040         if p-change-value <= 0
     1041         then do:
     1042           run diasize_position-resize-button in this-procedure .
     1043           return .
     1044         end.
     1045       end.
     1046     end.
     1047     if p-change-value < 0
     1048     then do:
     1049       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1050       then do:
     1051         assign
     1052           p-change-value = v-diasize-orig-frame-width
     1053                          - frame Dialog-Frame :width
     1054         .
     1055         if p-change-value >= 0
     1056         then do:
     1057           run diasize_position-resize-button in this-procedure .
     1058           return .
     1059         end.
     1060       end.
     1061     end.
     1062     if p-change-value >= 0
     1063     then do:
     1064       assign
     1065         v-change-sign = 1
     1066       .
     1067     end.
     1068     else do:
     1069       assign
     1070         v-change-sign = -1
     1071       .
     1072     end.
     1073     assign
     1074       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1075     .
     1076     if p-change-value = 0
     1077     then do:
     1078       run diasize_position-resize-button in this-procedure .
     1079       return .
     1080     end.
     1081     move_block:
     1082     do
     1083     on error undo move_block, leave move_block
     1084     :
     1085       if retry
     1086       then do:
     1087         do
     1088         on error undo move_block, leave move_block
     1089         :
     1090           if p-change-value > 0
     1091           then do:
     1092             for each buf_temp-diasize-handle
     1093             on error undo, next
     1094             :
     1095               assign
     1096                 v-object-handle = buf_temp-diasize-handle.handle-value
     1097               .
     1098               if v-object-handle <> v-diasize-resize-button
     1099               then do:
     1100                 assign
     1101                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1102                 .
     1103               end.
     1104             end.
     1105             assign
     1106               v-diasize-browse-handle :width = v-browse-width
     1107             .
     1108             for each buf_temp-browse-handle
     1109               where buf_temp-browse-handle.browse-type = 'width':u
     1110             on error undo, next
     1111             :
     1112               assign
     1113                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1114               .
     1115             end.
     1116             assign
     1117               frame Dialog-Frame :width = v-frame-width
     1118             .
     1119             if frame Dialog-Frame :scrollable = true
     1120             then do:
     1121               assign
     1122                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1123               .
     1124             end.
     1125             run diasize_position-resize-button in this-procedure .
     1126           end.
     1127           else do:
     1128             if frame Dialog-Frame :scrollable = true
     1129             then do:
     1130               assign
     1131                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1132               .
     1133             end.
     1134             assign
     1135               frame Dialog-Frame :width = v-frame-width
     1136             .
     1137             for each buf_temp-browse-handle
     1138               where buf_temp-browse-handle.browse-type = 'width':u
     1139             on error undo, next
     1140             :
     1141               assign
     1142                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1143               .
     1144             end.
     1145             assign
     1146               v-diasize-browse-handle :width = v-browse-width
     1147             .
     1148             for each buf_temp-diasize-handle
     1149             on error undo, next
     1150             :
     1151               assign
     1152                 v-object-handle = buf_temp-diasize-handle.handle-value
     1153               .
     1154               if v-object-handle <> v-diasize-resize-button
     1155               then do:
     1156                 assign
     1157                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1158                 .
     1159               end.
     1160             end.
     1161             run diasize_position-resize-button in this-procedure .
     1162           end.
     1163           assign
     1164             v-diasize-change-size = false
     1165           .
     1166           leave move_block .
     1167         end.
     1168       end.
     1169       assign
     1170         v-diasize-need-full-display = true
     1171       .
     1172       if v-diasize-change-size = false
     1173       then do:
     1174         assign
     1175           v-diasize-change-size = true
     1176         .
     1177       end.
     1178       else do:
     1179         return .
     1180       end.
     1181       assign
     1182         v-frame-width = frame Dialog-Frame :width
     1183         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1184         v-browse-width = v-diasize-browse-handle :width
     1185       .
     1186       for each buf_temp-browse-handle
     1187         where buf_temp-browse-handle.browse-type = 'width':u
     1188       :
     1189         assign
     1190           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1191         .
     1192       end.
     1193       for each buf_temp-diasize-handle
     1194       :
     1195         delete buf_temp-diasize-handle .
     1196       end.
     1197       assign
     1198         v-field-group-handle = frame Dialog-Frame :first-child
     1199       .
     1200       do while valid-handle(v-field-group-handle)
     1201       :
     1202         assign
     1203           v-object-handle = v-field-group-handle :first-child
     1204         .
     1205         do while valid-handle(v-object-handle)
     1206         :
     1207           if  v-object-handle <> v-diasize-browse-handle :handle
     1208           and v-object-handle <> v-diasize-resize-button
     1209           and can-query(v-object-handle, "row")
     1210           and can-query(v-object-handle, "height")
     1211           and ( v-object-handle :col + v-object-handle :width
     1212                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1213               )
     1214           then do:
     1215             find first buf_temp-browse-handle
     1216               where buf_temp-browse-handle.browse-type   = 'width':u
     1217                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1218               no-error .
     1219             if available buf_temp-browse-handle
     1220             then do:
     1221             end.
     1222             else do:
     1223               create buf_temp-diasize-handle .
     1224               assign
     1225                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1226                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1227               .
     1228             end.
     1229           end.
     1230           assign
     1231             v-object-handle = v-object-handle :next-sibling
     1232           .
     1233         end.
     1234         assign
     1235           v-field-group-handle = v-field-group-handle :next-sibling
     1236         .
     1237       end.
     1238       do with frame Dialog-Frame
     1239       :
     1240         hide v-diasize-resize-button .
     1241         v-diasize-resize-button :row = 1.
     1242         v-diasize-resize-button :column = 1.
     1243       end.
     1244       if p-change-value > 0
     1245       then do:
     1246         if frame Dialog-Frame :scrollable = true
     1247         then do:
     1248           assign
     1249             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1250             no-error .
     1251           if error-status :error
     1252           or error-status :get-message(1) <> ""
     1253           then do:
     1254             undo move_block, retry move_block.
     1255           end.
     1256         end.
     1257         assign
     1258           frame Dialog-Frame :width = v-frame-width + p-change-value
     1259           no-error .
     1260         if error-status :error
     1261         or error-status :get-message(1) <> ""
     1262         then do:
     1263           undo move_block, retry move_block.
     1264         end.
     1265         assign
     1266           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1267         no-error .
     1268         if error-status :error
     1269         or error-status :get-message(1) <> ""
     1270         then do:
     1271           undo move_block, retry move_block.
     1272         end.
     1273         for each buf_temp-browse-handle
     1274           where buf_temp-browse-handle.browse-type = 'width':u
     1275         on error undo move_block, retry move_block
     1276         :
     1277           assign
     1278             buf_temp-browse-handle.browse-handle :width
     1279               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1280             no-error .
     1281           if error-status :error
     1282           or error-status :get-message(1) <> ""
     1283           then do:
     1284             undo move_block, retry move_block .
     1285           end.
     1286         end.
     1287         for each buf_temp-diasize-handle
     1288         on error undo move_block, retry move_block
     1289         :
     1290           assign
     1291             v-object-handle = buf_temp-diasize-handle.handle-value
     1292           .
     1293           if v-object-handle <> v-diasize-resize-button
     1294           then do:
     1295             assign
     1296               v-object-handle :col = v-object-handle :col + p-change-value
     1297               no-error .
     1298             if error-status :error
     1299             or error-status :get-message(1) <> ""
     1300             then do:
     1301               undo move_block, retry move_block .
     1302             end.
     1303           end.
     1304         end.
     1305       end.
     1306       else do:
     1307         for each buf_temp-diasize-handle
     1308         on error undo move_block, retry move_block
     1309         :
     1310           assign
     1311             v-object-handle = buf_temp-diasize-handle.handle-value
     1312           .
     1313           if v-object-handle <> v-diasize-resize-button
     1314           then do:
     1315             assign
     1316               v-object-handle :col = v-object-handle :col + p-change-value
     1317               no-error .
     1318             if error-status :error
     1319             or error-status :get-message(1) <> ""
     1320             then do:
     1321               undo move_block, retry move_block .
     1322             end.
     1323           end.
     1324         end.
     1325         for each buf_temp-browse-handle
     1326           where buf_temp-browse-handle.browse-type = 'width':u
     1327         on error undo move_block, retry move_block
     1328         :
     1329           assign
     1330             buf_temp-browse-handle.browse-handle :width
     1331               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1332             no-error .
     1333           if error-status :error
     1334           or error-status :get-message(1) <> ""
     1335           then do:
     1336             undo move_block, retry move_block .
     1337           end.
     1338         end.
     1339         assign
     1340           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1341           no-error .
     1342         if error-status :error
     1343         or error-status :get-message(1) <> ""
     1344         then do:
     1345           undo move_block, retry move_block.
     1346         end.
     1347         assign
     1348           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1349         no-error .
     1350         if error-status :error
     1351         or error-status :get-message(1) <> ""
     1352         then do:
     1353           undo move_block, retry move_block.
     1354         end.
     1355         if frame Dialog-Frame :scrollable = true
     1356         then do:
     1357           assign
     1358             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1359           no-error .
     1360           if error-status :error
     1361           or error-status :get-message(1) <> ""
     1362           then do:
     1363             undo move_block, retry move_block.
     1364           end.
     1365         end.
     1366       end.
     1367       if p-move-resize
     1368       then do:
     1369         run diasize_position-resize-button in this-procedure .
     1370       end.
     1371       if v-diasize-wndstore = true
     1372       then do:
     1373         if connected("ub") = true
     1374         then do:
     1375           define variable v-cntxt-db-num        as integer   no-undo .
     1376           define variable v-cntxt-userid        as character no-undo .
     1377           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1378                                             , OUTPUT v-cntxt-userid
     1379                                             ) .
     1380           run gbl/wndsizew.p
     1381             (input  v-cntxt-db-num
     1382             ,input  v-cntxt-userid
     1383             ,input  v-diasize-proc-name
     1384             ,input  'width':u
     1385             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1386             ) .
     1387         end.
     1388       end.
     1389     end.
     1390     assign
     1391       v-diasize-change-size = false
     1392     .
     1393   end procedure.
     1394   procedure diasize_set-width :
     1395     define input  parameter p-new-width  as decimal   no-undo .
     1396     define input  parameter p-move-resize as logical   no-undo .
     1397     do
     1398     on error undo, return error return-value
     1399     :
     1400       run diasize_change-width in this-procedure
     1401         (input  (p-new-width - frame Dialog-Frame :width)
     1402         ,input  p-move-resize
     1403         ) .
     1404     end.
     1405   end procedure.
     1406   procedure diasize_position-resize-button :
     1407     do with frame Dialog-Frame
     1408     :
     1409       hide v-diasize-resize-button .
     1410       assign
     1411         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1412                     - 1
     1413                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1414         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1415                     - 1
     1416                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1417       .
     1418       view v-diasize-resize-button .
     1419     end.
     1420   end procedure.
     1421   on alt-right anywhere
     1422   do:
     1423     run diasize_change-width in this-procedure
     1424       (input 1
     1425       ,input true
     1426       ) .
     1427     return no-apply .
     1428   end.
     1429   on alt-left anywhere
     1430   do:
     1431     run diasize_change-width in this-procedure
     1432       (input -1
     1433       ,input true
     1434       ) .
     1435     return no-apply .
     1436   end.
     1437   on alt-down anywhere
     1438   do:
     1439     run diasize_change-height in this-procedure
     1440       (input 1
     1441       ,input true
     1442       ) .
     1443     return no-apply .
     1444   end.
     1445   on alt-up anywhere
     1446   do:
     1447     run diasize_change-height in this-procedure
     1448       (input -1
     1449       ,input true
     1450       ) .
     1451     return no-apply .
     1452   end.
     1453   on alt-enter of frame Dialog-Frame
     1454   do:
     1455     run diasize_maximize in this-procedure
     1456       (input  ?
     1457       ).
     1458     return no-apply .
     1459   end.
     1460   procedure diasize_end-move :
     1461     do
     1462     on error undo, return error return-value
     1463     :
     1464       define variable v-row-delta as decimal   no-undo .
     1465       define variable v-col-delta as decimal   no-undo .
     1466       define variable v-new-row as decimal   no-undo .
     1467       define variable v-new-col as decimal   no-undo .
     1468       assign
     1469         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1470         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1471       .
     1472       assign
     1473         v-row-delta = v-new-row - frame Dialog-Frame :height
     1474         v-col-delta = v-new-col - frame Dialog-Frame :width
     1475       .
     1476       run diasize_change-height in this-procedure
     1477         (input v-row-delta
     1478         ,input true
     1479         ) .
     1480       run diasize_change-width in this-procedure
     1481         (input v-col-delta
     1482         ,input true
     1483         ) .
     1484     end.
     1485   end procedure.
     1486   procedure diasize_maximize :
     1487     define input  parameter p-action as logical   no-undo .
     1488     do
     1489     on error undo, return error return-value
     1490     :
     1491       if p-action = ?
     1492       then do:
     1493         if v-diasize-need-maximize = true
     1494         then do:
     1495           assign
     1496             p-action = true
     1497           .
     1498         end.
     1499         else do:
     1500           assign
     1501             p-action = false
     1502           .
     1503         end.
     1504       end.
     1505       if p-action = true
     1506       then do:
     1507         run diasize_change-height in this-procedure
     1508           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1509               - frame Dialog-Frame :height-chars
     1510           ,input true
     1511           ) .
     1512         run diasize_change-width in this-procedure
     1513           (input session :width-chars
     1514               - frame Dialog-Frame :width-chars
     1515           ,input true
     1516           ) .
     1517         assign
     1518           v-diasize-need-maximize = false
     1519         .
     1520       end.
     1521       else do:
     1522         run diasize_change-width in this-procedure
     1523           (input v-diasize-orig-frame-width
     1524               - frame Dialog-Frame :width-chars
     1525           ,input true
     1526           ) .
     1527         run diasize_change-height in this-procedure
     1528           (input v-diasize-orig-frame-height
     1529               - frame Dialog-Frame :height-chars
     1530           ,input true
     1531           ) .
     1532         assign
     1533           v-diasize-need-maximize = true
     1534         .
     1535       end.
     1536     end.
     1537   end procedure.
     1538   procedure diasize_restore-orig-size :
     1539     do
     1540     on error undo, return error return-value
     1541     :
     1542       assign
     1543         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1544         v-diasize-current-frame-height = frame Dialog-Frame :height
     1545       .
     1546       run diasize_set-height in this-procedure
     1547         (input  v-diasize-orig-frame-height
     1548         ,input  true
     1549         ) .
     1550       run diasize_set-width in this-procedure
     1551         (input  v-diasize-orig-frame-width
     1552         ,input  true
     1553         ) .
     1554     end.
     1555   end procedure.
     1556   procedure diasize_restore-current-size :
     1557     do
     1558     on error undo, return error return-value
     1559     :
     1560       run diasize_set-height in this-procedure
     1561         (input  v-diasize-current-frame-height
     1562         ,input  true
     1563         ) .
     1564       run diasize_set-width in this-procedure
     1565         (input  v-diasize-current-frame-width
     1566         ,input  true
     1567         ) .
     1568     end.
     1569   end procedure.
     1570   procedure diasize_set-browse-handle :
     1571     define input  parameter p-browse-handle as handle   no-undo .
     1572     define buffer buf_temp-browse-handle for temp-browse-handle .
     1573     do
     1574     on error undo, return error return-value
     1575     :
     1576       assign
     1577         v-diasize-browse-handle = p-browse-handle
     1578       .
     1579       for each buf_temp-browse-handle
     1580       on error undo, return error return-value
     1581       :
     1582         delete buf_temp-browse-handle .
     1583       end.
     1584     end.
     1585   end procedure.
     1586   procedure diasize_add_browse :
     1587     define input  parameter p-browse-type   as character no-undo .
     1588     define input  parameter p-browse-handle as handle    no-undo .
     1589     define buffer buf_temp-browse-handle for temp-browse-handle .
     1590     do
     1591     on error undo, return error return-value
     1592     :
     1593       assign
     1594         v-diasize-browse-number = v-diasize-browse-number + 1
     1595       .
     1596       create buf_temp-browse-handle .
     1597       assign
     1598         buf_temp-browse-handle.browse-type   = p-browse-type
     1599         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1600         buf_temp-browse-handle.browse-handle = p-browse-handle
     1601       .
     1602     end.
     1603   end procedure.
     1604   procedure diasize_init :
     1605     define variable v-default-value    as logical   no-undo .
     1606     define variable v-restore-saved    as logical   no-undo .
     1607     define variable v-resize-value-str as character no-undo .
     1608     do
     1609     on error undo, return error return-value
     1610     :
     1611       do with frame Dialog-Frame
     1612       :
     1613         assign
     1614           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1615           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1616           v-diasize-browse-handle     = browse br-dis-pos :handle
     1617         .
     1618         create button v-diasize-resize-button
     1619         assign
     1620           parent        = frame Dialog-Frame :first-child
     1621           label         = "s"
     1622           height-pixels = 16
     1623           width-pixels  = 16
     1624           visible       = true
     1625           sensitive     = true
     1626           movable       = true
     1627           triggers:
     1628             on end-move persistent run diasize_end-move in this-procedure .
     1629           end triggers.
     1630         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1631         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1632         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1633         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1634         assign
     1635           v-diasize-wndmax = false
     1636         .
     1637         if connected("ub") = true
     1638         then do:
     1639           define variable v-cntxt-db-num        as integer   no-undo .
     1640           define variable v-cntxt-userid        as character no-undo .
     1641           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1642                                             , OUTPUT v-cntxt-userid
     1643                                             ) .
     1644           run gbl/wndpar_r.p
     1645             (input  v-cntxt-db-num
     1646             ,input  v-cntxt-userid
     1647             ,input  'wndmax':U
     1648             ,output v-diasize-wndmax
     1649             ,output v-default-value
     1650             ) .
     1651         end.
     1652         assign
     1653           v-diasize-wndstore = false
     1654         .
     1655         if connected("ub") = true
     1656         then do:
     1657           run gbl/wndpar_r.p
     1658             (input  v-cntxt-db-num
     1659             ,input  v-cntxt-userid
     1660             ,input  'wndstore':U
     1661             ,output v-diasize-wndstore
     1662             ,output v-default-value
     1663             ) .
     1664         end.
     1665         assign
     1666           v-diasize-proc-name = entry(1, program-name(2), '.')
     1667         .
     1668         if v-diasize-wndstore = true
     1669         then do:
     1670           assign
     1671             v-restore-saved = false
     1672           .
     1673           if connected("ub") = true
     1674           then do:
     1675             run gbl/wndsizer.p
     1676               (input  v-cntxt-db-num
     1677               ,input  v-cntxt-userid
     1678               ,input  v-diasize-proc-name
     1679               ,input  'height':u
     1680               ,output v-resize-value-str
     1681               ) .
     1682             if v-resize-value-str <> '':U
     1683             then do:
     1684               run diasize_change-height in this-procedure
     1685                 (input  integer(v-resize-value-str)
     1686                 ,input  true
     1687                 ) .
     1688               assign
     1689                 v-restore-saved = true
     1690               .
     1691             end.
     1692           end.
     1693           if connected("ub") = true
     1694           then do:
     1695             run gbl/wndsizer.p
     1696               (input  v-cntxt-db-num
     1697               ,input  v-cntxt-userid
     1698               ,input  v-diasize-proc-name
     1699               ,input  'width':u
     1700               ,output v-resize-value-str
     1701               ) .
     1702             if v-resize-value-str <> '':U
     1703             then do:
     1704               run diasize_change-width in this-procedure
     1705                 (input  integer(v-resize-value-str)
     1706                 ,input  true
     1707                 ) .
     1708               assign
     1709                 v-restore-saved = true
     1710               .
     1711             end.
     1712           end.
     1713           if v-restore-saved <> true
     1714           then do:
     1715             if v-diasize-wndmax = true
     1716             then do:
     1717               run diasize_maximize in this-procedure
     1718                 (input  true
     1719                 ) .
     1720             end.
     1721           end.
     1722         end.
     1723         else do:
     1724           if v-diasize-wndmax = true
     1725           then do:
     1726             run diasize_maximize in this-procedure
     1727               (input  true
     1728               ) .
     1729           end.
     1730         end.
     1731       end.
     1732     end.
     1733   end procedure.
     1734   procedure diasize_need-full-display :
     1735     define output parameter p-need-full-display as logical   no-undo .
     1736     do
     1737     on error undo, return error return-value
     1738     :
     1739       assign
     1740         p-need-full-display = v-diasize-need-full-display
     1741       .
     1742       assign
     1743         v-diasize-need-full-display = false
     1744       .
     1745     end.
     1746   end procedure.
     1747   procedure get-context :
     1748      define output parameter p-db-num as integer          no-undo.
     1749      define output parameter p-user-id as character        no-undo.
     1750      define variable v-login               as character    no-undo.
     1751      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1752      define buffer buf_user-login  for ub.user-login .
     1753      do
     1754      on error undo, return error
     1755      :
     1756            FIND FIRST buf_sys-ctrl no-lock.
     1757            ASSIGN
     1758               v-login = USERID("ub")
     1759               p-db-num = buf_sys-ctrl.db-num
     1760            .
     1761            FIND FIRST buf_user-login
     1762                 WHERE buf_user-login.db-num = p-db-num
     1763                   AND buf_user-login.user-login = v-login
     1764                 no-lock
     1765                 no-error
     1766                 .
     1767            IF AVAILABLE buf_user-login
     1768            THEN DO:
     1769               assign
     1770                  p-user-id = buf_user-login.user-id
     1771               .
     1772            END.
     1773      end.
     1774   end procedure.
     1775       run diasize_init in this-procedure .
     1776   define variable vss-include-info7 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1777   on INS of frame Dialog-Frame anywhere do:
     1778     if b-mark :sensitive then DO: apply "CHOOSE":U to b-mark in frame Dialog-Frame. END.
     1779     return no-apply.
     1780   end.
     1781   define variable vss-include-info8 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1782   on F2 of frame Dialog-Frame anywhere do:
     1783     if b-sel :sensitive then DO: apply "CHOOSE":U to b-sel in frame Dialog-Frame. END.
     1784     return no-apply.
     1785   end.
     1786   define variable vss-include-info9 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1787   on F2 of frame Dialog-Frame anywhere do:
     1788     if b-quit :sensitive then DO: apply "CHOOSE":U to b-quit in frame Dialog-Frame. END.
     1789     return no-apply.
     1790   end.
     1791   MAIN-BLOCK:
     1792   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1793      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1794   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1795     run mainmenu_getcntxt in parparentproc
     1796       (output v-cntxt-db-num
     1797       ,output v-cntxt-userid
     1798       ,output v-cntxt-level
     1799       ,output v-cntxt-host-code-obj
     1800       ,output v-cntxt-obj-type
     1801       ,output v-cntxt-obj-code
     1802       ,output v-cntxt-db-num-obj
     1803       ,output v-cntxt-is-admin
     1804       ) .
     1805     if lookup( p-mode, 'все':U + chr(44) +
     1806                        'маг':U + chr(44) +
     1807                        'скл':U + chr(44) +
     1808                        "cd-type-list" + chr(44) +
     1809                        "cd-type-list-without-template-pos" + chr(44) +
     1810                        "rum") = 0 then do:
     1811       message
     1812       substitute("Неверное значение параметра p-mode=&1", p-mode)
     1813       view-as alert-box error .
     1814       undo main-block, return error .
     1815     end.
     1816     run fill-table in this-procedure ( input p-table-name) no-error .
     1817     if error-status:error then undo, return error .
     1818     if return-value = "return" then return '':U.
     1819     RUN Myenable IN THIS-PROCEDURE .
     1820     run openbr in this-procedure .
     1821     if return-value = "return" then return '':U.
     1822     WAIT-FOR GO OF FRAME Dialog-Frame.
     1823   END.
     1824   RUN disable_UI.
     1825   PROCEDURE disable_UI :
     1826     HIDE FRAME Dialog-Frame.
     1827   END PROCEDURE.
     1828   PROCEDURE enable_UI :
     1829     DISPLAY mark-num
     1830         WITH FRAME Dialog-Frame.
     1831     ENABLE b-quit B-mark B-sel B-Help br-dis-pos mark-num
     1832         WITH FRAME Dialog-Frame.
     1833     VIEW FRAME Dialog-Frame.
     1834   END PROCEDURE.
     1835   PROCEDURE fill-table :
     1836   DEFINE INPUT PARAMETER p-table-name AS CHARACTER NO-UNDO.
     1837   define variable v-found as logical no-undo .
     1838   define buffer buf_tt-dis-pos for tt-dis-pos.
     1839   FOR EACH tt-dis-pos:
     1840     DELETE tt-dis-pos.
     1841   END.
     1842   case p-mode:
     1843     when "rum" then do:
     1844       for each X_dis-cfg-rule no-lock where
     1845             X_dis-cfg-rule.pos-type = p-pos-type:
     1846         if lookup(string(X_dis-cfg-rule.subject-type), p-subject-type-list) = 0  then next.
     1847         find first buf_tt-dis-pos no-lock where
     1848                   buf_tt-dis-pos.discnt-role = X_dis-cfg-rule.discnt-role no-error.
     1849         if available buf_tt-dis-pos then next.
     1850         if X_dis-cfg-rule.link-prop <> integer('0':U)
     1851         and X_dis-cfg-rule.link-prop <> integer('-1':U) then next.
     1852         if p-has-glob = 1
     1853         and p-has-host = 0
     1854         and p-has-obj = 0
     1855         and X_dis-cfg-rule.has-glob = 0 then next.
     1856         if p-has-glob = 0
     1857         and p-has-host = 1
     1858         and p-has-obj = 0
     1859         and X_dis-cfg-rule.has-host = 0 then next.
     1860         if p-has-glob = 0
     1861         and p-has-host = 0
     1862         and p-has-obj = 1
     1863         and X_dis-cfg-rule.has-obj = 0 then next.
     1864         if p-discnt-role-list <> '':U
     1865         and lookup( X_dis-cfg-rule.discnt-role, p-discnt-role-list) = 0 then next.
     1866         CREATE tt-dis-pos.
     1867         BUFFER-COPY
     1868         X_dis-cfg-rule TO tt-dis-pos
     1869         ASSIGN
     1870         tt-dis-pos.RECID_ = RECID(X_dis-cfg-rule)
     1871         .
     1872         v-found = yes.
     1873       end.
     1874     end.
     1875     when "cd-type-list-without-template-pos" then do:
     1876       for each X_dis-cfg-rule no-lock where
     1877               X_dis-cfg-rule.table-name = p-table-name
     1878           and X_dis-cfg-rule.pos-type > "":U
     1879               :
     1880         if LOOKUP(X_dis-cfg-rule.pos-type, P-POS-TYPE) = 0 then next.
     1881         find first buf_tt-dis-pos no-lock where
     1882                   buf_tt-dis-pos.discnt-role = X_dis-cfg-rule.discnt-role
     1883                   no-error.
     1884         if available buf_tt-dis-pos then next.
     1885         if X_dis-cfg-rule.link-prop <> integer('0':U) then next.
     1886         if p-has-glob = 1
     1887         and p-has-host = 0
     1888         and p-has-obj = 0
     1889         and X_dis-cfg-rule.has-glob = 0 then next.
     1890         if p-has-glob = 0
     1891         and p-has-host = 1
     1892         and p-has-obj = 0
     1893         and X_dis-cfg-rule.has-host = 0 then next.
     1894         if p-has-glob = 0
     1895         and p-has-host = 0
     1896         and p-has-obj = 1
     1897         and X_dis-cfg-rule.has-obj = 0 then next.
     1898         if p-discnt-role-list <> '':U
     1899         and lookup( X_dis-cfg-rule.discnt-role, p-discnt-role-list) = 0 then next.
     1900         CREATE tt-dis-pos.
     1901         BUFFER-COPY
     1902         X_dis-cfg-rule TO tt-dis-pos
     1903         ASSIGN
     1904         tt-dis-pos.RECID_ = RECID(X_dis-cfg-rule)
     1905         .
     1906         v-found = yes.
     1907       end.
     1908     end.
     1909     otherwise do:
     1910       for each X_dis-cfg-rule no-lock where
     1911               X_dis-cfg-rule.table-name = p-table-name
     1912           and X_dis-cfg-rule.pos-type > "":U
     1913               :
     1914         if X_dis-cfg-rule.link-prop <> integer('0':U) then next.
     1915         if p-has-glob = 1
     1916         and p-has-host = 0
     1917         and p-has-obj = 0
     1918         and X_dis-cfg-rule.has-glob = 0 then next.
     1919         if p-has-glob = 0
     1920         and p-has-host = 1
     1921         and p-has-obj = 0
     1922         and X_dis-cfg-rule.has-host = 0 then next.
     1923         if p-has-glob = 0
     1924         and p-has-host = 0
     1925         and p-has-obj = 1
     1926         and X_dis-cfg-rule.has-obj = 0 then next.
     1927         if p-discnt-role-list <> '':U
     1928         and lookup( X_dis-cfg-rule.discnt-role, p-discnt-role-list) = 0 then next.
     1929         CREATE tt-dis-pos.
     1930         BUFFER-COPY
     1931         X_dis-cfg-rule TO tt-dis-pos
     1932         ASSIGN
     1933         tt-dis-pos.RECID_ = RECID(X_dis-cfg-rule)
     1934         .
     1935         v-found = yes.
     1936       end.
     1937     end.
     1938   end case.
     1939   if not v-found then do:
     1940     message
     1941     "Нет ни одного (Доступного для редактирования) типа скидки с такими параметрами"
     1942     view-as alert-box error .
     1943     return "return".
     1944   end.
     1945   END PROCEDURE.
     1946   PROCEDURE MyEnable :
     1947   DEFINE VARIABLE ii AS INTEGER NO-UNDO.
     1948   DEFINE VARIABLE ch AS WIDGET-HANDLE NO-UNDO.
     1949   ch = br-dis-pos:FIRST-COLUMN IN FRAME Dialog-Frame.
     1950   DO ii = 1 TO br-dis-pos:NUM-COLUMNS IN FRAME Dialog-Frame:
     1951       ASSIGN
     1952       ch:RESIZABLE = YES.
     1953       if p-mode = "rum"
     1954       or p-mode = "cd-type-list-without-template-pos"
     1955       then do:
     1956          if ch:label = "Код!шабл."
     1957          or ch:label = "Код!шабл.!распис"
     1958          or ch:label = "Тип расписания"
     1959          or ch:label = "Описание" then do:
     1960            ch:visible = no.
     1961          end.
     1962       end.
     1963       if p-mode = "cd-type-list-without-template-pos" then do:
     1964         if ch:label = "Тип POS!(место использ)" then do:
     1965           ch:visible = no.
     1966         end.
     1967       end.
     1968       ch = ch:NEXT-COLUMN.
     1969   END.
     1970   DISPLAY mark-num
     1971   WITH FRAME Dialog-Frame.
     1972   ENABLE
     1973   b-quit
     1974   B-mark WHEn LOOKUP("b-mark", bttns) > 0
     1975   B-sel WHEN LOOKUP("b-sel", bttns) > 0
     1976   B-Help
     1977   br-dis-pos
     1978   mark-num
     1979   WITH FRAME Dialog-Frame.
     1980   VIEW FRAME Dialog-Frame.
     1981   HIDE
     1982   mark-num
     1983   IN FRAME Dialog-Frame.
     1984   CASE p-table-name:
     1985     WHEN 'dis-gds-rule':U THEN DO:
     1986        ASSIGN
     1987        FRAME Dialog-Frame:TITLE = "Возможные типы скидок на товар".
     1988     END.
     1989     WHEN 'dis-thbj-rule':U THEN DO:
     1990        ASSIGN
     1991        FRAME Dialog-Frame:TITLE = "Возможные типы общих скидок".
     1992     END.
     1993     WHEN 'dis-cp-rule':U THEN DO:
     1994        ASSIGN
     1995        FRAME Dialog-Frame:TITLE = "Возможные типы скидок на платеж".
     1996     END.
     1997     WHEN 'dis-dc-rule':U THEN DO:
     1998        ASSIGN
     1999        FRAME Dialog-Frame:TITLE = "Возможные типы скидок на отдельную ДК".
     2000     END.
     2001     WHEN 'dis-dct-rule':U THEN DO:
     2002        ASSIGN
     2003        FRAME Dialog-Frame:TITLE = "Возможные типы скидок на тип ДК".
     2004     END.
     2005     WHEN 'dis-grp-rule':U THEN DO:
     2006       case p-classif-type:
     2007        when 'sum-grp':U then do:
     2008         ASSIGN
     2009         FRAME Dialog-Frame:TITLE = "Возможные типы скидок на группы товаров (на кассе)".
     2010        end.
     2011        when 'cli-grp':U then do:
     2012         ASSIGN
     2013         FRAME Dialog-Frame:TITLE = "Возможные типы скидок на группы клиентов".
     2014        end.
     2015       end case.
     2016     END.
     2017     WHEN 'dis-some-rule':U THEN DO:
     2018        ASSIGN
     2019        FRAME Dialog-Frame:TITLE = "Возможные типы скидок на что-то там".
     2020     END.
     2021   END CASE.
     2022   END PROCEDURE.
     2023   PROCEDURE openbr :
     2024   if p-mode = 'все':U then do:
     2025     OPEN QUERY br-dis-pos
     2026         FOR EACH tt-dis-pos NO-LOCK ,
     2027             first X_dis-rule NO-LOCK WHERE
     2028             X_dis-rule.rule-num  = tt-dis-pos.templ-rl-root,
     2029              FIRST X_dis-time-rule NO-LOCK WHERE
     2030               X_dis-time-rule.time-rule-num = tt-dis-pos.time-templ-rl-root outer-join
     2031             INDEXED-REPOSITION.
     2032   end.
     2033   IF P-MODE = 'маг':U THEN DO:
     2034       OPEN QUERY br-dis-pos
     2035           FOR EACH tt-dis-pos NO-LOCK where
     2036                 (tt-dis-pos.pos-type = p-pos-type
     2037                 OR tt-dis-pos.pos-type = '-':U),
     2038               first X_dis-rule NO-LOCK WHERE
     2039              X_dis-rule.rule-num  = tt-dis-pos.templ-rl-root,
     2040           FIRST X_dis-time-rule NO-LOCK where
     2041           X_dis-time-rule.time-rule-num = tt-dis-pos.time-templ-rl-root outer-join
     2042              INDEXED-REPOSITION.
     2043   END.
     2044   IF P-MODE = 'скл':U THEN DO:
     2045       OPEN QUERY br-dis-pos
     2046           FOR EACH tt-dis-pos NO-LOCK where
     2047               tt-dis-pos.pos-type = '-':U,
     2048               first X_dis-rule NO-LOCK WHERE
     2049              X_dis-rule.rule-num  = tt-dis-pos.templ-rl-root,
     2050           FIRST X_dis-time-rule NO-LOCK where
     2051            X_dis-time-rule.time-rule-num = tt-dis-pos.time-templ-rl-root outer-join
     2052              INDEXED-REPOSITION.
     2053   END.
     2054   IF P-MODE = "CD-TYPE-LIST"
     2055   or p-mode = "rum"
     2056   THEN DO:
     2057       OPEN QUERY br-dis-pos
     2058           FOR EACH tt-dis-pos NO-LOCK where
     2059               LOOKUP(tt-dis-pos.pos-type, P-POS-TYPE) > 0,
     2060               first X_dis-rule NO-LOCK WHERE
     2061              X_dis-rule.rule-num  = tt-dis-pos.templ-rl-root,
     2062           FIRST X_dis-time-rule NO-LOCK where
     2063            X_dis-time-rule.time-rule-num = tt-dis-pos.time-templ-rl-root outer-join
     2064              INDEXED-REPOSITION.
     2065   END.
     2066   IF p-mode = "cd-type-list-without-template-pos"
     2067   THEN DO:
     2068       OPEN QUERY br-dis-pos
     2069           FOR EACH tt-dis-pos NO-LOCK,
     2070               first X_dis-rule NO-LOCK ,
     2071           FIRST X_dis-time-rule NO-LOCK outer-join
     2072              INDEXED-REPOSITION.
     2073   END.
     2074   if not available tt-dis-pos and v-start then do:
     2075     message
     2076     "Нет ни одного (доступного для редактирования) типа скидки с такими параметрами"
     2077     view-as alert-box error .
     2078     return "return".
     2079   end.
     2080   v-start = no.
     2081   END PROCEDURE.
     2082   FUNCTION rule-name RETURNS CHARACTER
     2083     ( INPUT p-table-name AS character, input p-classif-type as character, input p-discnt-role AS character ) :
     2084   DEFINE VARIABLE v-rule-name AS CHARACTER NO-UNDO.
     2085   CASE p-table-name :
     2086     WHEN 'dis-gds-rule':U THEN DO:
     2087       v-rule-name = entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u).
     2088     END.
     2089     WHEN 'dis-thbj-rule':U THEN DO:
     2090       v-rule-name = entry (lookup (p-discnt-role, 'pcnt-tot-kateg,dflt-gds-temp-disc,abs-tot-kateg,pcnt-codes,kateg-codes,free-discnt-flag,pmnt-discnt-flag,kat-gds-grp,temp-disc-pdf,pcnt-kat-pdf,bonus-tot,bonus-all':u) + 1, ',' + '% Скидка на итог,Временная скидка на товар по умолчанию,Abs Скидка на итог,Коды % скидок,Коды категорий,Флаг своб.скидки,Флаг уст. скидки на платеж,Ск-ка на группу товаров для кат.клиентов,Временная через ТПЛ,Категорийная через ТПЛ,Начисление бонусов на сумму чека,Правило-итого бонусов по чеку':u).
     2091     END.
     2092     WHEN 'dis-cp-rule':U THEN DO:
     2093       v-rule-name = entry (lookup (p-discnt-role, 'simple-pay,qnty-pay':u) + 1, ',' + 'Скидка при оплате,Скидка на количество при оплате':u).
     2094     END.
     2095     WHEN 'dis-dc-rule':U THEN DO:
     2096       v-rule-name = entry (lookup (p-discnt-role, 'debet-pay-pcnt-disc,debet-pay-abs-disc,debet-pay-qnty-disc,debet-pay-sum-disc,debet-pay-free-disc,dc-d-pcnt,dc-cash-d-pcnt,credit-pay-pcnt-disc,credit-pay-abs-disc,credit-pay-qnty-disc,credit-pay-sum-disc,credit-pay-free-disc':u) + 1, ',' + '% Скидка при оплате топлива по дебет.ведомости,ABS Скидка при оплате топлива по дебет.ведомости,Скидка на кол-во при оплате топлива по дебет.ведомости,Скидка на сумму при оплате топлива по дебет.ведомости,Своб скидка при оплате топлива по дебет.ведомости,% скидка на товар по ДК,% скидка на итог чека по ДК,% Скидка при оплате топлива по кредит.ведомости,Abs Скидка при оплате топлива по кредит.ведомости,Скидка на кол-во при оплате топлива по кредит.ведомости,Скидка на сумму при оплате топлива по кредит.ведомости,Своб Скидка на сумму при оплате топлива по кредит.ведомости':u).
     2097     END.
     2098     WHEN 'dis-dct-rule':U THEN DO:
     2099       v-rule-name = entry (lookup (p-discnt-role, 'calc-d-pcnt,calc-cash-d-pcnt,calc-categ,dis-tot-flag,def-categ,def-pcnt,def-cash-pcnt':u) + 1, ',' + 'Расчет %скидки ДК на товар,Расчет %скидки ДК на итог,Расчет категории ДК,Участие в итогах по ДК,Категория ДК по умолчанию,% скидки ДК на товар по умолч.,% скидки ДК на итог по умолч.':u).
     2100     END.
     2101     WHEN 'dis-grp-rule':U THEN DO:
     2102       case p-classif-type:
     2103         when 'sum-grp':U then do:
     2104           v-rule-name = entry (lookup (p-discnt-role, 'gds-grp-pcnt,gds-grp-pcnt-kat,gds-grp-abs,gds-grp-qnty,gds-grp-sum':u) + 1, ',' + '% скидка на группу товара,% скидка на группу товара для кат.клиентов,Abs скидка на группу товара,% Скидка на группу товара по кол-ву,% Скидка на группу товара на сумму':u).
     2105         end.
     2106         when 'cli-grp':U then do:
     2107           v-rule-name = entry (lookup (p-discnt-role, 'cli-grp-pcnt':u) + 1, ',' + '% скидка на группу клиентов':u).
     2108         end.
     2109       end case.
     2110     END.
     2111   END CASE.
     2112   RETURN v-RULE-name.
     2113   END FUNCTION.
