      556   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      557      DEFINE NEW GLOBAL SHARED VARIABLE hpApi AS HANDLE NO-UNDO.
      558      IF NOT VALID-HANDLE(hpApi) THEN run gbl/windows.p PERSISTENT SET hpApi.
      559   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      560   DEFINE NEW GLOBAL SHARED VARIABLE hpWinFunc AS HANDLE NO-UNDO.
      561     IF NOT VALID-HANDLE(hpWinFunc) THEN run gbl/winfunc.p PERSISTENT SET hpWinFunc.
      562   FUNCTION GetLastError
      563            RETURNS INTEGER
      564            ()
      565            IN hpWinFunc.
      566   FUNCTION GetParent
      567            RETURNS INTEGER
      568            (input hwnd as INTEGER)
      569            IN hpWinFunc.
      570   FUNCTION ShowLastError
      571            RETURNS INTEGER
      572            ()
      573            IN hpWinFunc.
      574   FUNCTION CreateProcess
      575            RETURNS INTEGER
      576            (input CommandLine as CHAR,
      577             input CurrentDir  as CHAR,
      578             input wShowWindow as INTEGER)
      579            in hpWinFunc.
      580   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      581   function IsProcessRunning return integer
      582     (PID AS INTEGER) :
      583     DEFINE VARIABLE IsRunning   AS LOGICAL NO-UNDO INITIAL NO.
      584     DEFINE VARIABLE hProcess    AS INTEGER NO-UNDO.
      585     DEFINE VARIABLE ExitCode    AS INTEGER NO-UNDO.
      586     DEFINE VARIABLE ReturnValue AS INTEGER NO-UNDO.
      587     define variable rv          as integer no-undo .
      588     RUN OpenProcess in hpapi
      589                     ( 1024,
      590                       0,
      591                       PID,
      592                       OUTPUT hProcess).
      593     IF hProcess NE 0 THEN DO:
      594        RUN GetExitcodeProcess in hpapi
      595                     ( hProcess,
      596                       OUTPUT ExitCode,
      597                       OUTPUT ReturnValue).
      598        rv = (if (ExitCode=259) AND (ReturnValue NE 0)
      599             then  - 1
      600             else ReturnValue).
      601        RUN CloseHandle in hpapi (hProcess, OUTPUT ReturnValue).
      602     END.
      603     RETURN rv.
      604   end.
      605   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      606   FUNCTION mark-string RETURNS CHARACTER
      607     ( input p-recid as recid, input mark-list as character  ) :
      608     RETURN ( IF LOOKUP( STRING( p-recid), mark-list ) > 0 THEN '*' ELSE '':U ).
      609   END FUNCTION.
      610   define temp-table tt-tso no-undo
      611     field db-num        as integer
      612     field obj-code      as integer
      613     field tso-num       as integer
      614     field tso-addr      as character
      615     field PosStatus     as character
      616     field FiscalStatus  as character
      617     field zReportDate   as character
