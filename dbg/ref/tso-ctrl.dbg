      642   define variable v-post-file-name  as character  no-undo .
      643   define variable v-cmd-file-name   as character  no-undo .
      644   define variable v-command         as character  no-undo .
      645   define variable v-out-str         as character  no-undo .
      646   define variable v-pid-list        as character  no-undo .
      647   define variable v-time-str        as character  no-undo .
      648   define variable v-del-file        as character  no-undo .
      649   define variable v-parsesub        as character  no-undo .
      650   define variable hDoc              as handle     no-undo .
      651   define variable hRoot             as handle     no-undo .
      652   define variable good              as logical    no-undo .
      653   define variable v-temp-dir        as character  no-undo .
      654   define variable rv                as integer    no-undo .
      655   define variable cash-recids       as character  no-undo .
      656   define variable ii                as integer    no-undo .
      657   define variable rid-list          as character  no-undo .
      658   define buffer buf_cash-desk for ub.cash-desk .
      659   define buffer buf_cash-desk-attr for ub.cash-desk-attr .
      660   define buffer buf_clients for ub.clients .
      661   define buffer buf_pump for ub.pump .
      662   DEFINE BUTTON b-close
      663        LABEL "Закрыть смену"
      664        SIZE 18 BY 1
      665        BGCOLOR 8 .
      666   DEFINE BUTTON b-exit AUTO-END-KEY
      667        LABEL "Выход"
      668        SIZE 10 BY 1
      669        BGCOLOR 8 .
      670   DEFINE BUTTON b-open
      671        LABEL "Открыть смену"
      672        SIZE 18 BY 1
      673        BGCOLOR 8 .
      674   DEFINE BUTTON b-start
      675        LABEL "Запустить смену"
      676        SIZE 18 BY 1
      677        BGCOLOR 8 .
      678   DEFINE BUTTON b-stop
      679        LABEL "Остановить смену"
      680        SIZE 18 BY 1
      681        BGCOLOR 8 .
      682   DEFINE BUTTON b-z-report
      683        LABEL "Снять Z-отчет"
      684        SIZE 18 BY 1
      685        BGCOLOR 8 .
      686   DEFINE BUTTON b-cashier
      687        IMAGE-UP FILE "btn-down-arrow":U
      688        IMAGE-DOWN FILE "btn-down-arrow":U
      689        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      690        LABEL "Btn 1"
      691        SIZE 3 BY 1.
      692   DEFINE VARIABLE f-cashier AS INTEGER FORMAT ">>>>9":U
      693        label "Кассир"
      694        VIEW-AS FILL-IN
      695        SIZE 5.5 BY 1 NO-UNDO.
      696   DEFINE BUTTON b-mark
      697        LABEL "&*"
      698        SIZE 3 BY 1.
      699   define query br-tso for tt-tso scrolling .
      700   define browse br-tso
      701     query br-tso no-lock display
      702       mark-string ( INPUT RECID( tt-tso ), INPUT rid-list) format "X(1)" label "*"
      703       tt-tso.db-num format "999" label "БД"
      704       tt-tso.obj-code format "99999" label "Магазин"
      705       tt-tso.tso-num format ">>>>9" label "№ ТСО"
      706       tt-tso.tso-addr format "X(27)" label "Адрес ТСО"
      707       tt-tso.FiscalStatus format "X(11)" label "Статус ФР"
      708       tt-tso.zReportDate format "X(20)" label "Посл. Z-отчет"
      709       tt-tso.FiscalQueue format ">>>9" label "Очередь ФР"
      710       tt-tso.ShiftNum format ">>9" label "№ Смены"
      711       tt-tso.ShiftState format "X(11)" label "Статус Смены"
      712       tt-tso.ShiftBegin format "X(20)" label "Начало Смены"
      713       tt-tso.CashierNum format ">>>>>>9" label "Кассир"
      714   WITH NO-ROW-MARKERS SEPARATORS SIZE 143 BY 6
      715            TITLE "ТСО" FIT-LAST-COLUMN.
      716   define query br-pump for tt-pump scrolling .
      717   define browse br-pump
      718     query br-pump no-lock display
      719       tt-pump.obj-code format "99999" label "Магазин"
      720       tt-pump.pump-code format ">>9" label "№ ТРК"
      721       tt-pump.status_ format "X(24)" label "Статус"
      722       tt-pump.numTr   format ">>>>>>9" label "Кол-во транзакций"
      723   WITH NO-ROW-MARKERS SEPARATORS SIZE 143 BY 8
      724            TITLE "ТРК" FIT-LAST-COLUMN.
      725   DEFINE FRAME Dialog-Frame
      726        b-exit AT ROW 1.24 COL 2
      727        b-mark at row 1.24 col 12
      728        b-stop AT ROW 1.24 COL 21 WIDGET-ID 2
      729        b-start AT ROW 1.24 COL 39 WIDGET-ID 4
      730        b-close AT ROW 1.24 COL 57 WIDGET-ID 6
      731        b-open AT ROW 1.24 COL 75 WIDGET-ID 8
      732        b-z-report AT ROW 1.24 COL 93 WIDGET-ID 10
      733        f-cashier at row 1.24 col 118
      734        b-cashier at row 1.24 col 130
      735        br-tso at row 3 col 2
      736        br-pump at row 9.2 col 2
      737        SPACE(1)
      738       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      739            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      740            TITLE "Управление ТСО"
      741            CANCEL-BUTTON b-exit WIDGET-ID 100.
      742   ASSIGN
      743          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      744          FRAME Dialog-Frame:HIDDEN           = TRUE.
      745   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      746   DO:
      747     APPLY "END-ERROR":U TO SELF.
      748   END.
      749   ON CHOOSE OF b-cashier IN FRAME Dialog-Frame
      750   DO:
      751     cash-recids = "" .
      752     run ref/staffs.w ( input parparentproc
      753                 , input "b-sel"
      754                 , input 'C':U
      755                 , input (if v-cntxt-db-num = 0 then ? else v-cntxt-db-num)
      756                 , input 0
      757                 , output cash-recids ) .
      758     if cash-recids = "" then do:
      759     end.
      760     else do:
      761       do ii = 1 to num-entries( cash-recids ) :
      762          FIND FIRST ub.staff no-lock WHERE
      763                       recid( ub.staff ) = integer( entry( ii, cash-recids ) ) .
      764          f-cashier = ub.staff.staff-code .
      765          display f-cashier with frame Dialog-Frame.
      766       end.
      767     end.
      768   END.
      769   ON CHOOSE OF b-open IN FRAME Dialog-Frame
      770   DO:
      771     assign f-cashier .
      772     if f-cashier = ? or f-cashier <= 0
      773     then do :
      774       message "Сначала выберите кассира" view-as alert-box .
      775       return no-apply .
      776     end.
      777     define variable v-shift-num as integer no-undo .
      778     define variable v-ok as logical no-undo .
      779     run ref/tso-shift.w (input parparentproc,
      780                          output v-shift-num,
      781                          output v-ok) .
      782     if not v-ok
      783     then do :
      784       return no-apply .
      785     end.
      786     v-cmd-file-name = "tso-shift-open.xml" .
      787     v-command = substitute('<?xml version="1.0" encoding="UTF-8"?><control type="REQUEST">  <Command ctrl="ADD">    <CommType>tsoOperate</CommType>    <CommValue>shift_open</CommValue>    <CashierCode>&1</CashierCode>    <ShiftNumber>&2</ShiftNumber>  </Command></control>', string(f-cashier), string(v-shift-num)) .
      788     output to value (v-cmd-file-name) .
      789     put unformatted v-command skip .
      790     output close .
      791     if trim(rid-list) > ""
      792     then do :
      793       do ii = 1 to num-entries(rid-list) :
      794         find first tt-tso no-lock where recid(tt-tso) = integer( entry( ii, rid-list ) ) .
      795         if tt-tso.ShiftState = "Running" or tt-tso.ShiftState = "ОК" then next .
      796         v-command = substitute('&1 -0 --connect-timeout 5 -X POST -H "Content-Type: text/xml" -d @"&2" &3 >&4'
      797                           , curl-path
      798                           , v-cmd-file-name
      799                           , tt-tso.tso-addr
      800                           , "tso-temp.xml") + chr(10)  .
      801         os-command silent value (v-command) .
      802       end.
      803     end.
      804     else do :
      805       for each tt-tso no-lock :
      806         if tt-tso.ShiftState = "Running" or tt-tso.ShiftState = "ОК" then next .
      807         v-command = substitute('&1 -0 --connect-timeout 5 -X POST -H "Content-Type: text/xml" -d @"&2" &3 >&4'
      808                           , curl-path
      809                           , v-cmd-file-name
      810                           , tt-tso.tso-addr
      811                           , "tso-temp.xml") .
      812         os-command silent value (v-command) .
      813       end.
      814     end.
      815     run tso-send-cmd .
      816   END.
      817   ON CHOOSE OF b-close IN FRAME Dialog-Frame
      818   DO:
      819     assign f-cashier .
      820     if f-cashier = ? or f-cashier <= 0
      821     then do :
      822       message "Сначала выберите кассира" view-as alert-box .
      823       return no-apply .
      824     end.
      825     v-cmd-file-name = "tso-shift-close.xml" .
      826     v-command = substitute('<?xml version="1.0" encoding="UTF-8"?><control type="REQUEST">  <Command ctrl="ADD">    <CommType>tsoOperate</CommType>    <CommValue>&1</CommValue>    <CashierCode>&2</CashierCode>  </Command></control>', "shift_close", string(f-cashier)) .
      827     output to value (v-cmd-file-name) .
      828     put unformatted v-command skip .
      829     output close .
      830     if trim(rid-list) > ""
      831     then do :
      832       do ii = 1 to num-entries(rid-list) :
      833         find first tt-tso no-lock where recid(tt-tso) = integer( entry( ii, rid-list ) ) .
      834         v-command = substitute('&1 -0 --connect-timeout 5 -X POST -H "Content-Type: text/xml" -d @"&2" &3 >&4'
      835                           , curl-path
      836                           , v-cmd-file-name
      837                           , tt-tso.tso-addr
      838                           , "tso-temp.xml") .
      839         os-command silent value (v-command) .
      840       end.
      841     end.
      842     else do :
      843       for each tt-tso no-lock :
      844         v-command = substitute('&1 -0 --connect-timeout 5 -X POST -H "Content-Type: text/xml" -d @"&2" &3 >&4'
      845                           , curl-path
      846                           , v-cmd-file-name
      847                           , tt-tso.tso-addr
      848                           , "tso-temp.xml") .
      849         os-command silent value (v-command) .
      850       end.
      851     end.
      852     run tso-send-cmd .
      853   END.
      854   ON CHOOSE OF b-start IN FRAME Dialog-Frame
      855   DO:
      856     assign f-cashier .
      857     if f-cashier = ? or f-cashier <= 0
      858     then do :
      859       message "Сначала выберите кассира" view-as alert-box .
      860       return no-apply .
      861     end.
      862     v-cmd-file-name = "tso-shift-start.xml" .
      863     v-command = substitute('<?xml version="1.0" encoding="UTF-8"?><control type="REQUEST">  <Command ctrl="ADD">    <CommType>tsoOperate</CommType>    <CommValue>&1</CommValue>    <CashierCode>&2</CashierCode>  </Command></control>', "shift_start", string(f-cashier)) .
      864     output to value (v-cmd-file-name) .
      865     put unformatted v-command skip .
      866     output close .
      867     if trim(rid-list) > ""
      868     then do :
      869       do ii = 1 to num-entries(rid-list) :
      870         find first tt-tso no-lock where recid(tt-tso) = integer( entry( ii, rid-list ) ) .
      871         v-command = substitute('&1 -0 --connect-timeout 5 -X POST -H "Content-Type: text/xml" -d @"&2" &3 >&4'
      872                           , curl-path
      873                           , v-cmd-file-name
      874                           , tt-tso.tso-addr
      875                           , "tso-temp.xml") .
      876         os-command silent value (v-command) .
      877       end.
      878     end.
      879     else do :
      880       for each tt-tso no-lock :
      881         v-command = substitute('&1 -0 --connect-timeout 5 -X POST -H "Content-Type: text/xml" -d @"&2" &3 >&4'
      882                           , curl-path
      883                           , v-cmd-file-name
      884                           , tt-tso.tso-addr
      885                           , "tso-temp.xml") .
      886         os-command silent value (v-command) .
      887       end.
      888     end.
      889     run tso-send-cmd .
      890   END.
      891   ON CHOOSE OF b-stop IN FRAME Dialog-Frame
      892   DO:
      893     assign f-cashier .
      894     if f-cashier = ? or f-cashier <= 0
      895     then do :
      896       message "Сначала выберите кассира" view-as alert-box .
      897       return no-apply .
      898     end.
      899     v-cmd-file-name = "tso-shift-stop.xml" .
      900     v-command = substitute('<?xml version="1.0" encoding="UTF-8"?><control type="REQUEST">  <Command ctrl="ADD">    <CommType>tsoOperate</CommType>    <CommValue>&1</CommValue>    <CashierCode>&2</CashierCode>  </Command></control>', "shift_stop", string(f-cashier)) .
      901     output to value (v-cmd-file-name) .
      902     put unformatted v-command skip .
      903     output close .
      904     if trim(rid-list) > ""
      905     then do :
      906       do ii = 1 to num-entries(rid-list) :
      907         find first tt-tso no-lock where recid(tt-tso) = integer( entry( ii, rid-list ) ) .
      908         v-command = substitute('&1 -0 --connect-timeout 5 -X POST -H "Content-Type: text/xml" -d @"&2" &3 >&4'
      909                           , curl-path
      910                           , v-cmd-file-name
      911                           , tt-tso.tso-addr
      912                           , "tso-temp.xml") .
      913         os-command silent value (v-command) .
      914       end.
      915     end.
      916     else do :
      917       for each tt-tso no-lock :
      918         v-command = substitute('&1 -0 --connect-timeout 5 -X POST -H "Content-Type: text/xml" -d @"&2" &3 >&4'
      919                           , curl-path
      920                           , v-cmd-file-name
      921                           , tt-tso.tso-addr
      922                           , "tso-temp.xml") .
      923         os-command silent value (v-command) .
      924       end.
      925     end.
      926     run tso-send-cmd .
      927   END.
      928   ON CHOOSE OF b-z-report IN FRAME Dialog-Frame
      929   DO:
      930     assign f-cashier .
      931     if f-cashier = ? or f-cashier <= 0
      932     then do :
      933       message "Сначала выберите кассира" view-as alert-box .
      934       return no-apply .
      935     end.
      936     v-cmd-file-name = "tso-z-report.xml" .
      937     v-command = substitute('<?xml version="1.0" encoding="UTF-8"?><control type="REQUEST">  <Command ctrl="ADD">    <CommType>tsoOperate</CommType>    <CommValue>&1</CommValue>    <CashierCode>&2</CashierCode>  </Command></control>', "print_z_report", string(f-cashier)) .
      938     output to value (v-cmd-file-name) .
      939     put unformatted v-command skip .
      940     output close .
      941     if trim(rid-list) > ""
      942     then do :
      943       do ii = 1 to num-entries(rid-list) :
      944         find first tt-tso no-lock where recid(tt-tso) = integer( entry( ii, rid-list ) ) .
      945         v-command = substitute('&1 -0 --connect-timeout 5 -X POST -H "Content-Type: text/xml" -d @"&2" &3 >&4'
      946                           , curl-path
      947                           , v-cmd-file-name
      948                           , tt-tso.tso-addr
      949                           , "tso-temp.xml") .
      950         os-command silent value (v-command) .
      951       end.
      952     end.
      953     else do :
      954       for each tt-tso no-lock :
      955         v-command = substitute('&1 -0 --connect-timeout 5 -X POST -H "Content-Type: text/xml" -d @"&2" &3 >&4'
      956                           , curl-path
      957                           , v-cmd-file-name
      958                           , tt-tso.tso-addr
      959                           , "tso-temp.xml") .
      960         os-command silent value (v-command) .
      961       end.
      962     end.
      963     run tso-send-cmd .
      964   END.
      965   ON CHOOSE OF b-mark IN FRAME Dialog-Frame
      966   DO:
      967   define variable glog as logical no-undo .
      968   if available tt-tso then  do:
      969   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      970   define variable v-str-recid7 as character no-undo .
      971   define variable v-num-entry7 as integer   no-undo .
      972   assign
      973     v-str-recid7 = trim( string( recid( tt-tso ) , "->>>>>>>>>>>9":U ) )
      974     v-num-entry7 = lookup( v-str-recid7 , rid-list )
      975   .
      976   if v-num-entry7 > 0 then do:
      977     assign
      978       entry( v-num-entry7, rid-list ) = "":U
      979       rid-list = trim( replace( rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
      980     .
      981   end.
      982   else do:
      983     assign
      984       rid-list = rid-list + ( if rid-list = "":U then "":U else chr(44) ) + v-str-recid7
      985     .
      986   end.
      987     glog = br-tso:refresh() .
      988     if last-event:function <> "MOUSE-SELECT-DBLCLICK"
      989     then do:
      990       glog = br-tso:select-next-row ().
      991       apply "iteration-changed" to br-tso in frame Dialog-Frame.
      992     end.
      993   end.
      994   apply "entry" to br-tso in frame Dialog-Frame.
      995   END.
      996   ON CHOOSE OF b-exit IN FRAME Dialog-Frame
      997   DO:
      998     for each tt-tso no-lock :
      999       v-del-file = v-temp-dir + "\tsoresp_" + string(tt-tso.db-num) + "_" + string(tt-tso.obj-code) + "_" + string(tt-tso.tso-num) + ".xml" .
     1000       v-del-file = search(v-del-file) .
     1001       if v-del-file = ? or trim(v-del-file) = ""
     1002       then next .
     1003       os-delete value(v-del-file) .
     1004       v-del-file = v-temp-dir + "\tsoreq_" + string(tt-tso.db-num) + "_" + string(tt-tso.obj-code) + "_" + string(tt-tso.tso-num) + ".bat" .
     1005       v-del-file = search(v-del-file) .
     1006       if v-del-file = ? or trim(v-del-file) = ""
     1007       then next .
     1008       os-delete value(v-del-file) .
     1009     end.
     1010     pause 1 .
     1011     os-delete value (search(v-temp-dir)) recursive .
     1012     assign
     1013       log-exit = true
     1014     .
     1015   END.
     1016   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1017   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1018   MAIN-BLOCK:
     1019   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1020      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1021   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1022     run mainmenu_getcntxt in parparentproc
     1023       (output v-cntxt-db-num
     1024       ,output v-cntxt-userid
     1025       ,output v-cntxt-level
     1026       ,output v-cntxt-host-code-obj
     1027       ,output v-cntxt-obj-type
     1028       ,output v-cntxt-obj-code
     1029       ,output v-cntxt-db-num-obj
     1030       ,output v-cntxt-is-admin
     1031       ) .
     1032     v-temp-dir = "TSO_temp-cmd" .
     1033     os-delete value (v-temp-dir) recursive no-error .
     1034     os-create-dir value(v-temp-dir) .
     1035     empty temp-table tt-pids .
     1036     assign
     1037       curl-path = search("exe/curl.exe")
     1038     .
     1039     v-post-file-name = "tso-stat.xml" .
     1040     v-out-str = '<?xml version="1.0" encoding="UTF-8"?><control type="REQUEST">  <Status ctrl="READ">    <PumpStatus></PumpStatus>    <PosStatus></PosStatus>    <FiscalStatus></FiscalStatus>    <ShiftStatus></ShiftStatus>    <StatCashier></StatCashier>  </Status></control>' .
     1041     output to value (v-post-file-name) .
     1042     put unformatted v-out-str skip .
     1043     output close .
     1044     run init-tt .
     1045     run tso-send-cmd .
     1046     RUN enable_UI.
     1047     open query br-tso for each tt-tso indexed-reposition .
     1048     open query br-pump for each tt-pump indexed-reposition .
     1049     do while not log-exit
     1050     on error undo, return error
     1051     :
     1052       wait-for
     1053         go of frame Dialog-Frame
     1054         or close of this-procedure
     1055         or value-changed of br-tso in frame Dialog-Frame
     1056         or value-changed of br-pump in frame Dialog-Frame
     1057         focus frame Dialog-Frame
     1058         pause 1
     1059       .
     1060       v-time-str = string(time, "HH:MM:SS") .
     1061       if substring(v-time-str, 7) = "01"
     1062       then do :
     1063         run tso-send-cmd .
     1064       end.
     1065       run tso-read-sts .
     1066     end.
     1067   END.
     1068   RUN disable_UI.
     1069   procedure tso-send-cmd :
     1070     define variable bat-file              as character    no-undo .
     1071     define variable cmd                   as character    no-undo .
     1072     define variable v-response-file-name  as character    no-undo .
     1073     define variable v-pid                 as integer      no-undo .
     1074     for each tt-tso no-lock :
     1075       v-response-file-name = v-temp-dir + "\tsoresp_" + string(tt-tso.db-num) + "_" + string(tt-tso.obj-code) + "_" + string(tt-tso.tso-num) + ".xml" .
     1076       cmd = substitute('"&1" -0 --connect-timeout 5 -X POST -H "Content-Type: text/xml" -d @"&2" &3 >&4'
     1077                       , curl-path
     1078                       , v-post-file-name
     1079                       , tt-tso.tso-addr
     1080                       , v-response-file-name) .
     1081       bat-file = v-temp-dir + "\tsoreq_" + string(tt-tso.db-num) + "_" + string(tt-tso.obj-code) + "_" + string(tt-tso.tso-num) + ".bat" .
     1082       output to value(bat-file) .
     1083       put unformatted cmd skip .
     1084       output close .
     1085       run gbl/run-gpid.p (  input bat-file
     1086                            ,input '':U
     1087                            ,output v-pid).
     1088       pause 1 no-message .
     1089       rv = IsProcessRunning(v-pid).
     1090       if rv >= 0 then do :
     1091       end.
     1092       else do :
     1093         os-delete value(bat-file) .
     1094       end.
     1095       find first tt-pids no-lock where tt-pids.pid = v-pid no-error .
     1096       if not available tt-pids
     1097       then do :
     1098         create tt-pids.
     1099         tt-pids.pid = v-pid .
     1100       end.
     1101     end.
     1102   end procedure .
     1103   procedure tso-read-sts :
     1104     define variable v-file    as character no-undo .
     1105     for each tt-tso exclusive-lock :
     1106       v-file = v-temp-dir + "\tsoresp_" + string(tt-tso.db-num) + "_" + string(tt-tso.obj-code) + "_" + string(tt-tso.tso-num) + ".xml" .
     1107       v-file = search(v-file) .
     1108       if v-file = ? or trim(v-file) = ""
     1109       then next .
     1110       file-info:file-name = v-file .
     1111       if file-info:file-size = 0
     1112       then do :
     1113         tt-tso.FiscalStatus = "НЕ ОТВЕЧАЕТ" .
     1114         os-delete value(v-file) .
     1115         next.
     1116       end.
     1117       run parse-xml (input v-file,
     1118                      input-output table tt-tso) .
     1119       os-delete value(v-file) .
     1120     end.
     1121     define buffer buf_tt-tso for tt-tso .
     1122     find first buf_tt-tso no-error .
     1123     if available buf_tt-tso
     1124     then
     1125     br-tso:refresh () in frame Dialog-Frame .
     1126     br-pump:refresh () in frame Dialog-Frame .
     1127   end procedure .
     1128   procedure parse-xml :
     1129     define input parameter p-file as character .
     1130     define input-output parameter table for tt-tso .
     1131     CREATE X-DOCUMENT hDoc.
     1132     CREATE X-NODEREF hRoot.
     1133     hDoc:LOAD("file",p-file,FALSE).
     1134     hDoc:GET-DOCUMENT-ELEMENT(hRoot).
     1135     RUN GetChildren(hRoot, 1).
     1136     DELETE OBJECT hDoc.
     1137     DELETE OBJECT hRoot.
     1138   end procedure .
     1139   PROCEDURE GetChildren:
     1140   DEFINE INPUT PARAMETER hParent AS HANDLE NO-UNDO.
     1141   DEFINE INPUT PARAMETER level AS INTEGER NO-UNDO.
     1142   DEFINE VARIABLE i AS INTEGER NO-UNDO.
     1143   DEFINE VARIABLE hNoderef AS HANDLE NO-UNDO.
     1144   DEFINE VARIABLE hText AS HANDLE NO-UNDO.
     1145   define variable client as character no-undo.
     1146   CREATE X-NODEREF hNoderef.
     1147   CREATE X-NODEREF hText .
     1148   REPEAT i = 1 TO hParent:NUM-CHILDREN:
     1149       good = hParent:GET-CHILD(hNoderef,i).
     1150       IF NOT good THEN
     1151           LEAVE.
     1152       IF hNoderef:SUBTYPE <> "element" THEN
     1153           NEXT.
     1154       hNoderef:GET-CHILD(hText, 1) no-error .
     1155       IF hNoderef:NAME = "PumpStatus"
     1156       then do :
     1157         assign v-parsesub = "Pump" .
     1158         find first tt-pump exclusive-lock where tt-pump.pump-code = integer(hNoderef:get-attribute("num"))
     1159                                             and tt-pump.obj-type  = v-cntxt-obj-type
     1160                                             and tt-pump.obj-code  = v-cntxt-obj-code
     1161                                             no-error .
     1162       end.
     1163       IF hNoderef:NAME = "PosStatus" then assign tt-tso.PosStatus = hText:node-value no-error .
     1164       IF hNoderef:NAME = "FiscalStatus" then assign v-parsesub = "Fiscal" .
     1165       IF hNoderef:NAME = "ShiftState"
     1166       then do :
     1167         tt-tso.ShiftBegin = hNoderef:get-attribute("begin") no-error .
     1168         tt-tso.ShiftNum   = integer(hNoderef:get-attribute("num")) no-error .
     1169         tt-tso.ShiftState = hText:node-value no-error .
     1170         if tt-tso.ShiftState = "Running" then tt-tso.ShiftState = "Запущена и открыта" .
     1171         if tt-tso.ShiftState = "Unknown" then tt-tso.ShiftState = "?" .
     1172         if tt-tso.ShiftState = "Closed"  then tt-tso.ShiftState = "Закрыта" .
     1173         if tt-tso.ShiftState = "Stopped" then tt-tso.ShiftState = "Остановлена и открыта" .
     1174       end.
     1175       IF hNoderef:NAME = "StatCashier" then assign tt-tso.CashierNum = integer(hText:node-value) no-error .
     1176       IF hNoderef:NAME = "State"
     1177       then do :
     1178         case v-parsesub :
     1179           when "Pump"
     1180           then do :
     1181             if available tt-pump
     1182             then do :
     1183               tt-pump.status_ = hText:node-value no-error .
     1184               if tt-pump.status_ = 'Idle' then tt-pump.status_ = 'Незанята' .
     1185               if tt-pump.status_ = 'Unreacable' then tt-pump.status_ = 'Недоступна' .
     1186               if tt-pump.status_ = 'Inoperative' then tt-pump.status_ = 'Не работает' .
     1187               if tt-pump.status_ = 'Closed' then tt-pump.status_ = 'Закрыта' .
     1188               if tt-pump.status_ = 'Calling' then tt-pump.status_ = 'Вызов' .
     1189               if tt-pump.status_ = 'Authorized' then tt-pump.status_ = 'Авторизована' .
     1190               if tt-pump.status_ = 'Started' then tt-pump.status_ = 'Запущена' .
     1191               if tt-pump.status_ = 'Started_susp' then tt-pump.status_ = 'Приостановлена' .
     1192               if tt-pump.status_ = 'Fueling' then tt-pump.status_ = 'Заправка' .
     1193               if tt-pump.status_ = 'Fueling_susp' then tt-pump.status_ = 'Заправка приостановлена' .
     1194             end.
     1195           end.
     1196           when "Fiscal"
     1197           then do :
     1198             tt-tso.FiscalStatus = hText:node-value no-error .
     1199           end.
     1200         end case .
     1201       end.
     1202       IF hNoderef:NAME = "ErrorText"
     1203       and v-parsesub = "Fiscal"
     1204       and tt-tso.FiscalStatus = "Error"
     1205       then do :
     1206         tt-tso.FiscalStatus = hText:node-value no-error .
     1207       end.
     1208       IF hNoderef:NAME = "LastZreportDate" then assign tt-tso.zReportDate = hText:node-value no-error .
     1209       IF hNoderef:NAME = "QueueSize" then assign tt-tso.FiscalQueue = integer(hText:node-value) no-error .
     1210       IF hNoderef:NAME = "NumTrans"
     1211       and available tt-pump
     1212       then assign tt-pump.numTr = integer(hText:node-value) no-error .
     1213       RUN GetChildren(hNoderef, (level + 1)).
     1214   END.
     1215   DELETE OBJECT hNoderef.
     1216   DELETE OBJECT hText.
     1217   END PROCEDURE.
     1218   procedure init-tt :
     1219     CASE parref-mode:
     1220       when 'все':U then do:
     1221         for each buf_cash-desk no-lock where buf_cash-desk.device-kind = 2
     1222                                          and buf_cash-desk.is-del   = no :
     1223             create tt-tso.
     1224             assign
     1225               tt-tso.db-num       = buf_cash-desk.db-num
     1226               tt-tso.obj-code     = buf_cash-desk.obj-code
     1227               tt-tso.tso-num      = buf_cash-desk.cash-num
     1228               tt-tso.tso-addr     = replace(buf_cash-desk.addr-path, chr(4), '://')
     1229             .
     1230           end.
     1231         for each buf_pump no-lock :
     1232           create tt-pump .
     1233           assign
     1234             tt-pump.pump-code = buf_pump.pump-code
     1235             tt-pump.obj-type  = buf_pump.obj-type
     1236             tt-pump.obj-code  = buf_pump.obj-code
     1237           .
     1238         end.
     1239       end.
     1240       when 'объект':U then do:
     1241           for each buf_cash-desk no-lock where buf_cash-desk.obj-code = v-cntxt-obj-code
     1242                                              and buf_cash-desk.is-del   = no
     1243                                              and buf_cash-desk.device-kind = 2:
     1244             create tt-tso.
     1245             assign
     1246               tt-tso.db-num       = buf_cash-desk.db-num
     1247               tt-tso.obj-code     = buf_cash-desk.obj-code
     1248               tt-tso.tso-num      = buf_cash-desk.cash-num
     1249               tt-tso.tso-addr     = replace(buf_cash-desk.addr-path, chr(4), '://')
     1250             .
     1251           end.
     1252         for each buf_pump no-lock where buf_pump.obj-type = v-cntxt-obj-type
     1253                                     and buf_pump.obj-code = v-cntxt-obj-code :
     1254           create tt-pump .
     1255           assign
     1256             tt-pump.pump-code = buf_pump.pump-code
     1257             tt-pump.obj-type  = buf_pump.obj-type
     1258             tt-pump.obj-code  = buf_pump.obj-code
     1259           .
     1260         end.
     1261       end.
     1262       when "db":U then do:
     1263         for each buf_cash-desk no-lock where buf_cash-desk.db-num   = v-cntxt-db-num
     1264                                              and buf_cash-desk.is-del   = no
     1265                                              and buf_cash-desk.device-kind = 2
     1266                                              :
     1267             create tt-tso.
     1268             assign
     1269               tt-tso.db-num       = buf_cash-desk.db-num
     1270               tt-tso.obj-code     = buf_cash-desk.obj-code
     1271               tt-tso.tso-num      = buf_cash-desk.cash-num
     1272               tt-tso.tso-addr     = replace(buf_cash-desk.addr-path, chr(4), '://')
     1273             .
     1274         end.
     1275         for each buf_clients no-lock where buf_clients.db-num = v-cntxt-db-num :
     1276           for each buf_pump no-lock where buf_pump.obj-type = buf_clients.obj-type
     1277                                       and buf_pump.obj-code = buf_clients.obj-code :
     1278             create tt-pump .
     1279             assign
     1280               tt-pump.pump-code = buf_pump.pump-code
     1281               tt-pump.obj-type  = buf_pump.obj-type
     1282               tt-pump.obj-code  = buf_pump.obj-code
     1283             .
     1284           end.
     1285         end.
     1286       end.
     1287     END CASE.
     1288   end procedure.
     1289   PROCEDURE disable_UI :
     1290     HIDE FRAME Dialog-Frame.
     1291   END PROCEDURE.
     1292   PROCEDURE enable_UI :
     1293     ENABLE b-exit b-stop b-start b-close b-open br-tso br-pump b-z-report
     1294            b-cashier b-mark
     1295         WITH FRAME Dialog-Frame.
     1296     VIEW FRAME Dialog-Frame.
     1297   END PROCEDURE.
