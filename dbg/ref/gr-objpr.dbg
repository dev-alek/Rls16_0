      994         buf_host-grp-obj-price,
      995         host-name SCROLLING.
      996   DEFINE QUERY BROWSE-4obj FOR
      997         buf_obj-grp-obj-price,
      998         buf_obj-name SCROLLING.
      999   DEFINE QUERY BROWSE-5all FOR
     1000         x_obj-grp-obj-price,
     1001         buf_clients SCROLLING.
     1002   DEFINE BROWSE BROWSE-1grp
     1003     QUERY BROWSE-1grp NO-LOCK DISPLAY
     1004         mark-string(buffer buf_grp-obj-price, p-rec-list) COLUMN-LABEL "*! " FORMAT "x(1)":U
     1005         buf_grp-obj-price.gop-id COLUMN-LABEL "Код! " FORMAT ">>>>>9":U
     1006         stts-string(buffer buf_grp-obj-price) COLUMN-LABEL "Ста!тус" FORMAT "x(3)":U
     1007         buf_grp-obj-price.name-group COLUMN-LABEL "Название!группы" FORMAT "X(30)":U
     1008         usrfulnf( buf_grp-obj-price.who) COLUMN-LABEL "Кто!изменял" FORMAT "X(15)":U
     1009         buf_grp-obj-price.sys-date COLUMN-LABEL "Дата!изм" FORMAT "99/99/99":U
     1010         buf_grp-obj-price.sys-time-chr COLUMN-LABEL "Время!изм" FORMAT "X(5)":U
     1011         buf_grp-obj-price.db-num-chg COLUMN-LABEL "БД!изм" FORMAT ">>>>9":U
     1012         buf_grp-obj-price.gop-db-num FORMAT ">>>>9":U COLUMN-LABEL "БД!созд"
     1013     ENABLE
     1014         buf_grp-obj-price.name
     1015       WITH NO-ROW-MARKERS SEPARATORS SIZE 49.13 BY 8
     1016            TITLE "Группы объектов" ROW-HEIGHT-CHARS .6 FIT-LAST-COLUMN.
     1017   DEFINE BROWSE BROWSE-2db
     1018     QUERY BROWSE-2db NO-LOCK DISPLAY
     1019         mark-string-2(buffer buf_db-grp-obj-price, v-rec-list-cli) COLUMN-LABEL "*! " FORMAT "x(1)":U
     1020         buf_db-grp-obj-price.dgo-db-num COLUMN-LABEL "БД! " FORMAT ">>>>9":U
     1021         usrfulnf(buf_db-grp-obj-price.who) COLUMN-LABEL "Кто!изменял" FORMAT "X(20)":U
     1022               WIDTH 10
     1023         buf_db-grp-obj-price.sys-date COLUMN-LABEL "Дата!изм" FORMAT "99/99/99":U
     1024               WIDTH 12
     1025         buf_db-grp-obj-price.sys-time-chr COLUMN-LABEL "Время!изм" FORMAT "X(5)":U
     1026               WIDTH 12
     1027         buf_db-grp-obj-price.num-chg COLUMN-LABEL "БД!изм" FORMAT ">>>>9":U
     1028         stts-string-2(buffer buf_db-grp-obj-price) COLUMN-LABEL "Ста!тус" FORMAT "x(6)":U
     1029         buf_db-grp-obj-price.gop-id COLUMN-LABEL "Гру!ппа" FORMAT ">>>>>9":U
     1030         buf_db-grp-obj-price.gop-db-num FORMAT ">>>>9":U
     1031       WITH NO-ROW-MARKERS SEPARATORS SIZE 11 BY 7.75
     1032            TITLE "БД в группе" ROW-HEIGHT-CHARS .6 FIT-LAST-COLUMN.
     1033   DEFINE BROWSE BROWSE-3frm
     1034     QUERY BROWSE-3frm NO-LOCK DISPLAY
     1035         mark-string-3(buffer buf_host-grp-obj-price, v-rec-list-cli) COLUMN-LABEL "*! " FORMAT "x(1)":U
     1036         buf_host-grp-obj-price.host-code COLUMN-LABEL "Код!фирмы" FORMAT ">>>>>>>>9":U
     1037         host-name.obj-name COLUMN-LABEL "Имя!фирмы" FORMAT  "X(20)":U
     1038         usrfulnf(buf_host-grp-obj-price.who) COLUMN-LABEL "Кто!изменял" FORMAT "X(20)":U
     1039               WIDTH 10
     1040         buf_host-grp-obj-price.sys-date COLUMN-LABEL "Дата!изм" FORMAT "99/99/99":U
     1041               WIDTH 12
     1042         buf_host-grp-obj-price.sys-time-chr COLUMN-LABEL "Время!изм" FORMAT "X(5)":U
     1043               WIDTH 12
     1044         buf_host-grp-obj-price.db-num-chg COLUMN-LABEL "БД!изм" FORMAT ">>>>9":U
     1045               WIDTH 3
     1046         stts-string-3(buffer buf_host-grp-obj-price) COLUMN-LABEL "Ста!тус" FORMAT "x(6)":U
     1047         buf_host-grp-obj-price.gop-id COLUMN-LABEL "Гру!ппа" FORMAT ">>>>>9":U
     1048         buf_host-grp-obj-price.gop-db-num FORMAT ">>>>9":U
     1049       WITH NO-ROW-MARKERS SEPARATORS SIZE 38.5 BY 7.75
     1050            TITLE "Фирмы в группе" ROW-HEIGHT-CHARS .6 FIT-LAST-COLUMN.
     1051   DEFINE BROWSE BROWSE-4obj
     1052     QUERY BROWSE-4obj NO-LOCK DISPLAY
     1053         mark-string-4(buffer buf_obj-grp-obj-price, v-rec-list-cli) COLUMN-LABEL "*! " FORMAT "x(1)":U
     1054         buf_obj-grp-obj-price.obj-type + " "  + STRING( buf_obj-grp-obj-price.obj-code)  COLUMN-LABEL "Объект! " FORMAT "x(11)":U
     1055         buf_obj-name.obj-name COLUMN-LABEL "Имя!объекта" FORMAT  "X(20)":U
     1056         usrfulnf(buf_obj-grp-obj-price.who) COLUMN-LABEL "Кто!изменял" FORMAT "X(20)":U
     1057               WIDTH 10
     1058         buf_obj-grp-obj-price.sys-date COLUMN-LABEL "Дата!изм" FORMAT "99/99/99":U
     1059               WIDTH 12
     1060         buf_obj-grp-obj-price.sys-time-chr COLUMN-LABEL "Время!изм" FORMAT "X(5)":U
     1061               WIDTH 12
     1062         buf_obj-grp-obj-price.db-num-chg COLUMN-LABEL "БД!изм" FORMAT ">>>>9":U
     1063               WIDTH 3
     1064         stts-string-4(buffer buf_obj-grp-obj-price) COLUMN-LABEL "Ста!тус" FORMAT "x(3)":U
     1065         buf_obj-grp-obj-price.gop-id COLUMN-LABEL "Гру!ппа" FORMAT ">>>>>9":U
     1066              buf_obj-grp-obj-price.gop-db-num FORMAT ">>>>9":U
     1067       WITH NO-ROW-MARKERS SEPARATORS SIZE 49.5 BY 10
     1068            TITLE "Объекты в группе" ROW-HEIGHT-CHARS .6 FIT-LAST-COLUMN.
     1069   DEFINE BROWSE BROWSE-5all
     1070     QUERY BROWSE-5all NO-LOCK DISPLAY
     1071         buf_clients.obj-type + " "  + STRING( buf_clients.obj-code )  COLUMN-LABEL "Объект" FORMAT "X(11)":U
     1072         buf_clients.obj-name  COLUMN-LABEL "Имя объекта" FORMAT  "X(20)":U
     1073         buf_clients.host-code COLUMN-LABEL "Фирма" FORMAT  ">>>>>>>>9":U
     1074         buf_clients.db-num    COLUMN-LABEL "БД" FORMAT  ">>>>>>>>9":U
     1075         stts-string-5(buffer x_obj-grp-obj-price ) COLUMN-LABEL "Статус" FORMAT  "X(6)":U
     1076         ENABLE
     1077         buf_clients.db-num
     1078       WITH NO-ROW-MARKERS SEPARATORS SIZE 49.13 BY 11
     1079            TITLE "Совокупность объектов в группе" ROW-HEIGHT-CHARS .6 FIT-LAST-COLUMN.
     1080   DEFINE FRAME Dialog-Frame
     1081        B-Cancel AT ROW 1 COL 1
     1082        B-sel AT ROW 1 COL 11
     1083        B-add AT ROW 1 COL 21
     1084        B-del AT ROW 1 COL 31
     1085        B-price-type AT ROW 1 COL 41
     1086        b-more AT ROW 1 COL 47.13
     1087        B-history AT ROW 1 COL 66.5
     1088        B-print AT ROW 1 COL 76.5
     1089        B-Help AT ROW 1 COL 86.75
     1090        R-status AT ROW 2.13 COL 9.63 NO-LABEL
     1091        B-mark AT ROW 2.83 COL 1.63
     1092        B-find-obj AT ROW 2.83 COL 4.63
     1093        B-all AT ROW 2.83 COL 7.75
     1094        B-mark-2 AT ROW 3 COL 51.5
     1095        B-add-DB AT ROW 3 COL 54.63
     1096        B-del-DB AT ROW 3 COL 57.75
     1097        B-mark-3 AT ROW 3 COL 62.38
     1098        B-add-frm AT ROW 3 COL 65.75
     1099        B-del-frm AT ROW 3 COL 68.88
     1100        BROWSE-1grp AT ROW 4 COL 1.75
     1101        BROWSE-2db AT ROW 4 COL 51.5
     1102        BROWSE-3frm AT ROW 4 COL 62.38
     1103        BROWSE-5all AT ROW 12 COL 1.75
     1104        B-mark-4 AT ROW 12 COL 51.5
     1105        B-add-obj AT ROW 12 COL 54.88
     1106        B-del-obj AT ROW 12 COL 58
     1107        BROWSE-4obj AT ROW 13 COL 51.5
     1108        FILL-IN-1 AT ROW 2.13 COL 2 NO-LABEL
     1109        F-obj AT ROW 3.04 COL 8.88 COLON-ALIGNED NO-LABEL
     1110        RECT-1 AT ROW 3.75 COL 1
     1111        SPACE(49.99) SKIP(0.00)
     1112       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1113            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1114            TITLE "Группы объектов для ценообразования"
     1115            DEFAULT-BUTTON B-sel CANCEL-BUTTON B-Cancel.
     1116   ASSIGN
     1117          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1118          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1119   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1120   DO:
     1121     APPLY "END-ERROR":U TO SELF.
     1122   END.
     1123   ON CHOOSE OF B-add IN FRAME Dialog-Frame
     1124   DO:
     1125      define variable g#log as logical   no-undo .
     1126   define variable vss-include-info6 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1127   do:
     1128     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1129       (input  v-cntxt-db-num
     1130       ,input  v-cntxt-userid
     1131       ,input  0
     1132       ,input  'actn_ref-mpl_update':U
     1133       ,input  'global':U
     1134       ,input  v-cntxt-host-code-obj
     1135       ,input  v-cntxt-obj-type
     1136       ,input  v-cntxt-obj-code
     1137       ,input  0
     1138       ,input  0
     1139       ,input  0
     1140       ,input  true
     1141       ,output g#log
     1142       )  .
     1143   end.
     1144     if not g#log then return .
     1145   define variable v-rec-id as recid no-undo .
     1146     run ref/gr-ogr.w (input parparentproc,input 'ДОБАВЛЕНИЕ':U , input-output v-rec-id) .
     1147     OPEN QUERY BROWSE-1grp FOR EACH buf_grp-obj-price WHERE     ( r-status = 2 OR buf_grp-obj-price.stts =  r-status ) AND     ( g-find = NO OR       LOOKUP (string(buf_grp-obj-price.gop-id) + ";"  + string(buf_grp-obj-price.gop-db-num)  ,        tt-grp-obj ) > 0 )                .
     1148     reposition BROWSE-1grp to recid v-rec-id no-error .
     1149     OPEN QUERY BROWSE-2db FOR EACH buf_db-grp-obj-price OF buf_grp-obj-price      WHERE ( r-status = 2 OR buf_db-grp-obj-price.stts =  r-status )       NO-LOCK INDEXED-REPOSITION.
     1150     OPEN QUERY BROWSE-3frm FOR EACH buf_host-grp-obj-price OF buf_grp-obj-price      WHERE ( r-status = 2 OR buf_host-grp-obj-price.stts =  r-status )       NO-LOCK ,            FIRST host-name NO-LOCK WHERE       host-name.obj-code = buf_host-grp-obj-price.host-code AND       host-name.obj-type = 'орг':U     INDEXED-REPOSITION.
     1151     OPEN QUERY BROWSE-4obj FOR EACH buf_obj-grp-obj-price OF buf_grp-obj-price      WHERE ( r-status = 2 OR buf_obj-grp-obj-price.stts =  r-status )       NO-LOCK,            FIRST buf_obj-name NO-LOCK WHERE       buf_obj-name.obj-code = buf_obj-grp-obj-price.obj-code AND       buf_obj-name.obj-type = buf_obj-grp-obj-price.obj-type     INDEXED-REPOSITION.
     1152     OPEN QUERY BROWSE-5all FOR EACH x_obj-grp-obj-price OF buf_grp-obj-price      WHERE ( r-status = 2 OR x_obj-grp-obj-price.stts =  r-status )       NO-LOCK ,            FIRST buf_clients NO-LOCK WHERE       buf_clients.obj-code = x_obj-grp-obj-price.obj-code AND       buf_clients.obj-type = x_obj-grp-obj-price.obj-type        .
     1153   END.
     1154   ON CHOOSE OF B-add-DB IN FRAME Dialog-Frame
     1155   DO:
     1156      define variable g#log as logical   no-undo .
     1157   define variable vss-include-info7 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1158   do:
     1159     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1160       (input  v-cntxt-db-num
     1161       ,input  v-cntxt-userid
     1162       ,input  0
