     1645       end.
     1646       else do:
     1647       HIDE B-history B-print B-Help B-mark-2 B-add-DB B-del-DB B-mark-3 B-add-frm B-del-frm BROWSE-2db BROWSE-3frm B-mark-4 B-add-obj B-del-obj BROWSE-4obj IN FRAME Dialog-Frame .
     1648       ASSIGN frame Dialog-Frame:WIDTH   = 51.50 .
     1649       v-full = false  .
     1650       end.
     1651   END.
     1652   ON CHOOSE OF B-price-type IN FRAME Dialog-Frame
     1653   DO:
     1654     define variable g#log   as logical   no-undo .
     1655     define variable v-recid as character no-undo .
     1656         assign v-recid = string(RECID (buf_grp-obj-price)) .
     1657         find first buf_obj-grp-obj-price
     1658         where buf_obj-grp-obj-price.gop-id     = buf_grp-obj-price.gop-id
     1659           and buf_obj-grp-obj-price.gop-db-num = buf_grp-obj-price.gop-db-num
     1660           and buf_obj-grp-obj-price.obj-type   = v-cntxt-obj-type
     1661           and buf_obj-grp-obj-price.obj-code   = v-cntxt-obj-code
     1662           and buf_obj-grp-obj-price.stts       = 0
     1663           no-error.
     1664         if available buf_obj-grp-obj-price then do:
     1665           run ref/typepric.w (
     1666                   input parParentProc     ,
     1667                   input "mode=gop-id,b-del,b-chg" ,
     1668                   input-output v-recid
     1669                   ) no-error .
     1670         end.
     1671         else do:
     1672   define variable vss-include-info24 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1673   do:
     1674     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1675       (input  v-cntxt-db-num
     1676       ,input  v-cntxt-userid
     1677       ,input  0
     1678       ,input  'actn_documents_all':U
     1679       ,input  'global':U
     1680       ,input  0
     1681       ,input  '':U
     1682       ,input  0
     1683       ,input  0
     1684       ,input  0
     1685       ,input  0
     1686       ,input  true
     1687       ,output g#log
     1688       )  .
     1689   end.
     1690           if g#log = true
     1691           then do:
     1692             run ref/typepric.w (
     1693                     input parParentProc     ,
     1694                     input "mode=gop-id,b-del,b-chg" ,
     1695                     input-output v-recid
     1696                     ) no-error .
     1697           end.
     1698         end.
     1699   END.
     1700   ON CHOOSE OF B-print IN FRAME Dialog-Frame
     1701   DO:
     1702   END.
