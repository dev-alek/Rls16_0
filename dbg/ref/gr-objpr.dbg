        1   DEFINE BUFFER buf_clients FOR ub.clients.
        2   DEFINE BUFFER buf_db-grp-obj-price FOR ub.db-grp-obj-price.
        3   DEFINE NEW SHARED BUFFER buf_grp-obj-price FOR ub.grp-obj-price.
        4   DEFINE BUFFER Buf_host-grp-obj-price FOR ub.host-grp-obj-price.
        5   DEFINE BUFFER buf_obj-grp-obj-price FOR ub.obj-grp-obj-price.
        6   DEFINE BUFFER buf_obj-name FOR ub.clients.
        7   DEFINE BUFFER host-name FOR ub.clients.
        8   DEFINE TEMP-TABLE x_obj-grp-obj-price NO-UNDO LIKE ub.obj-grp-obj-price.
        9   define input  parameter parParentProc as handle no-undo .
       10   define input  parameter p-bttns    as character no-undo .
       11   define input-output parameter p-rec-list as character no-undo .
       12   define variable vss-revision    as character no-undo init "$Revision: d47c064bc860, 1107, rls $":U .
       13   define variable vss-author      as character no-undo init "$Author: SMMolotkov $":U .
       14   define variable vss-date        as character no-undo init "$Date: Thu Dec 14 02:13:53 2017 +0300 $":U .
       15   define variable vss-workfile    as character no-undo init "$Workfile: gr-objpr.w $":U .
       16   define variable vss-archive     as character no-undo init "$Archive: ref/gr-objpr.w $":U .
       17   define variable vss-description as character no-undo init "Справочник групп объектов для ценообразования ".
       18   procedure vss-get-info :
