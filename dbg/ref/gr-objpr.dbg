      665   PROCEDURE objf-add :
      666   define input  parameter p-db-num       as integer   no-undo .
      667   define input  parameter p-id           as integer   no-undo .
      668   define input  parameter p-host-code    as integer   no-undo .
      669   define input  parameter p-stts         as integer   no-undo .
      670   define input  parameter p-db-num-usr   as integer   no-undo .
      671   define input  parameter p-userid       as character no-undo .
      672   define output parameter p-recid as recid no-undo .
      673     do
      674     on error undo, return error return-value
      675     :
      676   find first ub.sysconf no-lock where recid(ub.sysconf) = p-host-code .
      677   if available ub.sysconf then do:
      678      p-host-code = ub.sysconf.host-code .
      679   end.
      680   find first ub.grp-obj-price exclusive-lock where
      681           ub.grp-obj-price.gop-db-num   = p-db-num  and
      682           ub.grp-obj-price.gop-id       = p-id
      683           .
      684   find first ub.host-grp-obj-price exclusive-lock where
      685           ub.host-grp-obj-price.gop-db-num   = p-db-num  and
      686           ub.host-grp-obj-price.gop-id       = p-id      and
      687           ub.host-grp-obj-price.host-code    = p-host-code
      688           no-error .
      689         if not available ub.host-grp-obj-price then do:
      690             create ub.host-grp-obj-price.
      691               assign
      692                   ub.host-grp-obj-price.gop-db-num   = p-db-num
      693                   ub.host-grp-obj-price.gop-id       = p-id
      694                   ub.host-grp-obj-price.host-code    = p-host-code
      695               .
      696         end.
      697         assign
      698           ub.host-grp-obj-price.db-num-chg    = p-db-num-usr
      699           ub.host-grp-obj-price.stts          = p-stts
      700           ub.host-grp-obj-price.sys-date      = today
      701           ub.host-grp-obj-price.sys-time      = time
      702           ub.host-grp-obj-price.sys-time-chr  = string ( ub.host-grp-obj-price.sys-time,"hh:mm" )
      703           ub.host-grp-obj-price.who           = p-userid
      704           p-recid = recid ( ub.host-grp-obj-price )
      705         .
      706         ub.grp-obj-price.sys-time = time .
      707         run ref/h-grph.p (buffer ub.host-grp-obj-price , input-output v-sec )  .
      708     end.
      709   end procedure.
