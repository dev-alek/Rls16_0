     1354       ,input  0
     1355       ,input  0
     1356       ,input  true
     1357       ,output g#log
     1358       )  .
     1359   end.
     1360     if not g#log then return .
     1361     if not available buf_grp-obj-price then return .
     1362      if buf_grp-obj-price.stts <> 0 then do:
     1363         message " Группа удалена " .
     1364         return .
     1365      end.
     1366     if v-cntxt-db-num <> 0 then do :
     1367       if buf_grp-obj-price.gop-db-num <> v-cntxt-db-num then do:
     1368         message substitute(" Группа создана в другой БД (&1) , корректировать ее в текущей БД нельзя !" , buf_grp-obj-price.gop-db-num ) .
     1369         return .
     1370       end.
     1371     end.
