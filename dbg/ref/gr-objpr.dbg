     1216       ,input  v-cntxt-obj-type
     1217       ,input  v-cntxt-obj-code
     1218       ,input  0
     1219       ,input  0
     1220       ,input  0
     1221       ,input  true
     1222       ,output g#log
     1223       )  .
     1224   end.
     1225     if not g#log then return .
     1226   define variable v-rec-id as recid no-undo .
     1227   if not available buf_grp-obj-price then return .
