      144   define temp-table userobjs_temp-user-obj no-undo
      145     field obj-type as character
      146     field obj-code as integer
      147     index xpk is primary unique obj-type obj-code
      148     .
      149   procedure userobjs_clear :
      150     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      151     do
      152     on error undo, return error return-value
      153     :
      154       for each buf_userobjs_temp-user-obj
      155       on error undo, return error return-value
      156       :
      157         delete buf_userobjs_temp-user-obj .
      158       end.
      159     end.
      160   end .
      161   procedure userobjs_object-count :
      162     define output parameter p-total-count as integer   no-undo .
      163     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      164     do
      165     on error undo, return error return-value
      166     :
      167       assign
      168         p-total-count = 0
      169       .
      170       for each buf_userobjs_temp-user-obj
      171       on error undo, return error return-value
      172       :
      173         assign
      174           p-total-count = p-total-count + 1
      175         .
      176       end.
      177     end.
      178   end.
      179   procedure userobjs_append :
      180      define input  parameter p-obj-type as character no-undo .
      181      define input  parameter p-obj-code as integer   no-undo .
      182     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      183     do
      184     on error undo, return error return-value
      185     :
      186       find first buf_userobjs_temp-user-obj
      187         where buf_userobjs_temp-user-obj.obj-type = p-obj-type
      188           and buf_userobjs_temp-user-obj.obj-code = p-obj-code
      189         no-error .
      190       if not available buf_userobjs_temp-user-obj
      191       then do:
      192         create buf_userobjs_temp-user-obj .
      193         assign
      194           buf_userobjs_temp-user-obj.obj-type = p-obj-type
      195           buf_userobjs_temp-user-obj.obj-code = p-obj-code
      196         .
      197       end.
      198     end.
      199   end.
      200   procedure userobjs_object-exist :
      201     define output parameter p-object-exist as logical   no-undo .
      202     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      203     do
      204     on error undo, return error return-value
      205     :
      206       find first buf_userobjs_temp-user-obj
      207         no-error .
      208       if not available buf_userobjs_temp-user-obj
      209       then do:
      210         assign
      211           p-object-exist = false
      212         .
      213       end.
      214       else do:
      215         assign
      216           p-object-exist = true
      217         .
      218       end.
      219     end.
      220   end.
      221   procedure userobjs_transfer :
      222     define input  parameter p-callback-handle as handle no-undo .
      223     define variable vss-description as character no-undo init "userobjs_transfer: Передача списка объектов".
      224     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      225     do
      226     on error undo, return error return-value
      227     :
      228       if valid-handle(p-callback-handle) <> true
      229       then do:
      230         message
      231           vss-workfile vss-revision vss-description skip
      232           "Ошибка задания входных параметров" skip
      233           "Неизвестный указатель на процедуру" skip
      234           view-as alert-box error .
      235         undo, return error return-value .
      236       end.
      237       if p-callback-handle :get-signature("userobjs_append") = ""
      238       then do:
      239         message
      240           vss-workfile vss-revision vss-description skip
      241           "Ошибка задания входных параметров" skip
      242           substitute("В процедуре &1 не найдена внутренняя процедура userobjs_append"
      243                     ,p-callback-handle :file-name
      244                     ) skip
      245           view-as alert-box error .
      246         undo, return error return-value .
      247       end.
      248       for each buf_userobjs_temp-user-obj
      249       on error undo, return error return-value
      250       :
      251         run userobjs_append in p-callback-handle
      252           (input  buf_userobjs_temp-user-obj.obj-type
      253           ,input  buf_userobjs_temp-user-obj.obj-code
      254           ) .
      255       end.
      256     end.
      257   end procedure.
      258   procedure userobjs_select-one :
