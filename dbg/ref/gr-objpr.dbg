     1716   ON VALUE-CHANGED OF BROWSE-1grp IN FRAME Dialog-Frame
     1717   DO:
     1718     OPEN QUERY BROWSE-2db FOR EACH buf_db-grp-obj-price OF buf_grp-obj-price      WHERE ( r-status = 2 OR buf_db-grp-obj-price.stts =  r-status )       NO-LOCK INDEXED-REPOSITION.
     1719     OPEN QUERY BROWSE-3frm FOR EACH buf_host-grp-obj-price OF buf_grp-obj-price      WHERE ( r-status = 2 OR buf_host-grp-obj-price.stts =  r-status )       NO-LOCK ,            FIRST host-name NO-LOCK WHERE       host-name.obj-code = buf_host-grp-obj-price.host-code AND       host-name.obj-type = 'орг':U     INDEXED-REPOSITION.
     1720     OPEN QUERY BROWSE-4obj FOR EACH buf_obj-grp-obj-price OF buf_grp-obj-price      WHERE ( r-status = 2 OR buf_obj-grp-obj-price.stts =  r-status )       NO-LOCK,            FIRST buf_obj-name NO-LOCK WHERE       buf_obj-name.obj-code = buf_obj-grp-obj-price.obj-code AND       buf_obj-name.obj-type = buf_obj-grp-obj-price.obj-type     INDEXED-REPOSITION.
     1721     OPEN QUERY BROWSE-5all FOR EACH x_obj-grp-obj-price OF buf_grp-obj-price      WHERE ( r-status = 2 OR x_obj-grp-obj-price.stts =  r-status )       NO-LOCK ,            FIRST buf_clients NO-LOCK WHERE       buf_clients.obj-code = x_obj-grp-obj-price.obj-code AND       buf_clients.obj-type = x_obj-grp-obj-price.obj-type        .
     1722   END.
     1723   ON VALUE-CHANGED OF R-status IN FRAME Dialog-Frame
     1724   DO:
     1725      ASSIGN R-status .
     1726     OPEN QUERY BROWSE-1grp FOR EACH buf_grp-obj-price WHERE     ( r-status = 2 OR buf_grp-obj-price.stts =  r-status ) AND     ( g-find = NO OR       LOOKUP (string(buf_grp-obj-price.gop-id) + ";"  + string(buf_grp-obj-price.gop-db-num)  ,        tt-grp-obj ) > 0 )                .
     1727     OPEN QUERY BROWSE-2db FOR EACH buf_db-grp-obj-price OF buf_grp-obj-price      WHERE ( r-status = 2 OR buf_db-grp-obj-price.stts =  r-status )       NO-LOCK INDEXED-REPOSITION.
     1728     OPEN QUERY BROWSE-3frm FOR EACH buf_host-grp-obj-price OF buf_grp-obj-price      WHERE ( r-status = 2 OR buf_host-grp-obj-price.stts =  r-status )       NO-LOCK ,            FIRST host-name NO-LOCK WHERE       host-name.obj-code = buf_host-grp-obj-price.host-code AND       host-name.obj-type = 'орг':U     INDEXED-REPOSITION.
     1729     OPEN QUERY BROWSE-4obj FOR EACH buf_obj-grp-obj-price OF buf_grp-obj-price      WHERE ( r-status = 2 OR buf_obj-grp-obj-price.stts =  r-status )       NO-LOCK,            FIRST buf_obj-name NO-LOCK WHERE       buf_obj-name.obj-code = buf_obj-grp-obj-price.obj-code AND       buf_obj-name.obj-type = buf_obj-grp-obj-price.obj-type     INDEXED-REPOSITION.
     1730     OPEN QUERY BROWSE-5all FOR EACH x_obj-grp-obj-price OF buf_grp-obj-price      WHERE ( r-status = 2 OR x_obj-grp-obj-price.stts =  r-status )       NO-LOCK ,            FIRST buf_clients NO-LOCK WHERE       buf_clients.obj-code = x_obj-grp-obj-price.obj-code AND       buf_clients.obj-type = x_obj-grp-obj-price.obj-type        .
     1731   END.
     1732   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1733   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1734   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1735   on help of frame Dialog-Frame
     1736   do:
     1737     run gbl/app_help.p
     1738       (input this-procedure :file-name
     1739       ,input ''
     1740       ,input ?
     1741       ) no-error.
     1742     if error-status :error then do:
     1743       message
     1744         "Ошибка при вызове помощи"
     1745         error-status :get-message(1)
     1746         view-as alert-box .
     1747     end.
     1748   end.
     1749   run minbtn-set in this-procedure .
     1750   on choose of b-help in frame Dialog-Frame
     1751   do:
     1752     apply "help":u to frame Dialog-Frame .
     1753   end.
     1754   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1755   procedure minbtn-set :
     1756       do
     1757           on error undo, return error return-value
     1758           :
     1759           define variable ii              as integer       no-undo .
     1760           define variable fh              as widget-handle no-undo .
     1761           define variable hh              as widget-handle no-undo .
     1762           define variable v-h             as handle        extent 4 no-undo .
     1763           define variable v-name-button   as character     no-undo .
     1764           define variable v-help-old-x    as decimal       no-undo .
     1765           define variable v-help-old-y    as decimal       no-undo .
     1766           define variable v-help-old-size as decimal       no-undo .
     1767           define variable v-frame-width   as decimal       no-undo .
     1768           define variable jj              as integer       no-undo .
     1769           do
     1770               on error undo, return error
     1771               :
     1772               assign
     1773                   v-frame-width = frame Dialog-Frame:width - 0.3
     1774                   fh            = frame Dialog-Frame:first-child
     1775                   hh            = fh:first-child
     1776                   ii            = 1
     1777                   .
     1778               do while valid-handle(hh):
     1779                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1780                   do:
     1781                       case lc(hh:name) :
     1782                           when "b-help" then
     1783                               do:
     1784                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1785                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1786                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1787                                   hh:TOOLTIP = "Помощь" .
     1788                                   v-help-old-x = hh:column .
     1789                                   v-help-old-y = hh:row    .
     1790                                   v-help-old-size = hh:width .
     1791                                   hh:width-chars = 2.5 .
     1792                               end.
     1793                           when "b-print" then
     1794                               do:
     1795                                   hh:load-image("cmp/b-print.bmp":u) .
     1796                                   hh:TOOLTIP = "Печать" .
     1797                                   v-h[ii] = hh:handle .
     1798                                   ii = ii + 1 .
     1799                                   hh:width-chars = 3 .
     1800                               end.
     1801                           when "b-history" or
     1802                           when "b-hist" then
     1803                               do:
     1804                                   hh:load-image("cmp/b-hist.bmp":u) .
     1805                                   hh:TOOLTIP = "История" .
     1806                                   v-h[ii] = hh:handle .
     1807                                   ii = ii + 1 .
     1808                                   hh:width-chars = 3 .
     1809                               end.
     1810                           when "b-sch" then
     1811                               do:
     1812                                   hh:load-image("cmp/b-sch.bmp":u) .
     1813                                   hh:TOOLTIP = "Установка Фильтра" .
     1814                                   v-h[ii] = hh:handle .
     1815                                   ii = ii + 1 .
     1816                                   hh:width-chars = 3 .
     1817                               end.
     1818                           when "b-hist-user" then
     1819                               do:
     1820                                   hh:load-image("cmp/b-hist.bmp":u) .
     1821                                   hh:TOOLTIP = "История пользователя" .
     1822                                   ii = ii + 1 .
     1823                               end.
     1824                       end case.
     1825                   end.
     1826                   hh = hh:next-sibling.
     1827               end.
     1828               b-help:column = v-frame-width - b-help:width-chars.
     1829               jj = 0.
     1830               repeat ii = 4 to 1 by -1 :
     1831                   if valid-handle (v-h[ii] ) then
     1832                   do:
     1833                       jj  = jj + 1 .
     1834                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1835                       v-h[ii]:row    = v-help-old-y .
     1836                   end.
     1837               end.
     1838           end.
     1839       end.
     1840   end procedure.
     1841   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1842   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1843   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1844   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1845   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1846   define variable v-diasize-current-frame-height as decimal   no-undo .
     1847   define variable v-diasize-change-size          as logical   no-undo .
     1848   define variable v-diasize-resize-button        as handle    no-undo .
     1849   define variable v-diasize-wndmax               as logical   no-undo .
     1850   define variable v-diasize-wndstore             as logical   no-undo .
     1851   define variable v-diasize-proc-name            as character no-undo .
     1852   define variable v-diasize-browse-handle        as handle    no-undo .
     1853   define variable v-diasize-browse-number        as integer   no-undo .
     1854   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1855   define temp-table temp-diasize-handle no-undo
     1856     field handle-value  as handle
     1857     field save-position as decimal
     1858     index xpk is primary unique handle-value
     1859     .
     1860   define temp-table temp-browse-handle no-undo
     1861     field browse-type   as character
     1862     field browse-number as integer
     1863     field browse-handle as handle
     1864     field original-size as decimal
     1865     index xpk is primary unique browse-type browse-number
     1866     index xie browse-type browse-handle
     1867   .
     1868   procedure diasize_change-height :
     1869     define input  parameter p-change-value  as decimal   no-undo .
     1870     define input  parameter p-move-resize   as logical   no-undo .
     1871     define variable v-field-group-handle    as handle    no-undo .
     1872     define variable v-object-handle         as handle    no-undo .
     1873     define variable v-frame-height          as decimal   no-undo .
     1874     define variable v-frame-virtual-height  as decimal   no-undo .
     1875     define variable v-browse-height         as decimal   no-undo .
     1876     define variable v-window-height         as decimal   no-undo .
     1877     define variable v-window-virtual-height as decimal   no-undo .
     1878     define variable v-change-sign           as integer   no-undo .
     1879     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1880     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1881     if p-change-value > 0
     1882     then do:
     1883       if frame Dialog-Frame :height + p-change-value
     1884           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1885       then do:
     1886         assign
     1887           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1888                           - (frame Dialog-Frame :height-chars)
     1889         .
     1890         if p-change-value <= 0
     1891         then do:
     1892           run diasize_position-resize-button in this-procedure .
     1893           return .
     1894         end.
     1895       end.
     1896     end.
     1897     if p-change-value < 0
     1898     then do:
     1899       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1900       then do:
     1901         assign
     1902           p-change-value = v-diasize-orig-frame-height
     1903                          - (frame Dialog-Frame :height-chars)
     1904         .
     1905         if p-change-value >= 0
     1906         then do:
     1907           run diasize_position-resize-button in this-procedure .
     1908           return .
     1909         end.
     1910       end.
     1911     end.
     1912     if p-change-value >= 0
     1913     then do:
     1914       assign
     1915         v-change-sign = 1
     1916       .
     1917     end.
     1918     else do:
     1919       assign
     1920         v-change-sign = -1
     1921       .
     1922     end.
     1923     assign
     1924       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1925     .
     1926     if p-change-value = 0
     1927     then do:
     1928       run diasize_position-resize-button in this-procedure .
     1929       return .
     1930     end.
     1931     move_block:
     1932     do
     1933     on error undo move_block, retry move_block
     1934     :
     1935       if retry
     1936       then do:
     1937         do
     1938         on error undo move_block, leave move_block
     1939         :
     1940           if p-change-value > 0
     1941           then do:
     1942             for each buf_temp-diasize-handle
     1943             on error undo, next
     1944             :
     1945               assign
     1946                 v-object-handle = buf_temp-diasize-handle.handle-value
     1947               .
     1948               if v-object-handle <> v-diasize-resize-button
     1949               then do:
     1950                 assign
     1951                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1952                 .
     1953               end.
     1954             end.
     1955             assign
     1956               v-diasize-browse-handle :height = v-browse-height
     1957             .
     1958             for each buf_temp-browse-handle
     1959               where buf_temp-browse-handle.browse-type = 'height':u
     1960             on error undo, next
     1961             :
     1962               assign
     1963                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1964               .
     1965             end.
     1966             assign
     1967               frame Dialog-Frame :height = v-frame-height
     1968             .
     1969             if frame Dialog-Frame :scrollable = true
     1970             then do:
     1971               assign
     1972                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1973               .
     1974             end.
     1975             run diasize_position-resize-button in this-procedure .
     1976           end.
     1977           else do:
     1978             if frame Dialog-Frame :scrollable = true
     1979             then do:
     1980               assign
     1981                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1982               .
     1983             end.
     1984             assign
     1985               frame Dialog-Frame :height = v-frame-height
     1986             .
     1987             assign
     1988               v-diasize-browse-handle :height = v-browse-height
     1989             .
     1990             for each buf_temp-browse-handle
     1991               where buf_temp-browse-handle.browse-type = 'height':u
     1992             on error undo, next
     1993             :
     1994               assign
     1995                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1996               .
     1997             end.
     1998             for each buf_temp-diasize-handle
     1999             on error undo, next
     2000             :
     2001               assign
     2002                 v-object-handle = buf_temp-diasize-handle.handle-value
     2003               .
     2004               if v-object-handle <> v-diasize-resize-button
     2005               then do:
     2006                 assign
     2007                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2008                 .
     2009               end.
     2010             end.
     2011             run diasize_position-resize-button in this-procedure .
     2012           end.
     2013           assign
     2014             v-diasize-change-size = false
     2015           .
     2016           leave move_block .
     2017         end.
     2018       end.
     2019       assign
     2020         v-diasize-need-full-display = true
     2021       .
     2022       if v-diasize-change-size = false
     2023       then do:
     2024         assign
     2025           v-diasize-change-size = true
     2026         .
     2027       end.
     2028       else do:
     2029         return .
     2030       end.
     2031       assign
     2032         v-frame-height = frame Dialog-Frame :height
     2033         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     2034         v-browse-height = v-diasize-browse-handle :height
     2035       .
     2036       for each buf_temp-browse-handle
     2037         where buf_temp-browse-handle.browse-type = 'height':u
     2038       :
     2039         assign
     2040           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     2041         .
     2042       end.
     2043       for each buf_temp-diasize-handle
     2044       :
     2045         delete buf_temp-diasize-handle .
     2046       end.
     2047       assign
     2048         v-field-group-handle = frame Dialog-Frame :first-child
     2049       .
     2050       do while valid-handle(v-field-group-handle)
     2051       :
     2052         assign
     2053           v-object-handle = v-field-group-handle :first-child
     2054         .
     2055         do while valid-handle(v-object-handle)
     2056         :
     2057           if  v-object-handle <> v-diasize-browse-handle :handle
     2058           and can-query(v-object-handle, "row")
     2059           and can-query(v-object-handle, "height")
     2060           and ( v-object-handle :row > v-diasize-browse-handle :row )
     2061           then do:
     2062             find first buf_temp-browse-handle
     2063               where buf_temp-browse-handle.browse-type   = 'height':u
     2064                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2065               no-error .
     2066             if available buf_temp-browse-handle
     2067             then do:
     2068             end.
     2069             else do:
     2070               create buf_temp-diasize-handle .
     2071               assign
     2072                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2073                 buf_temp-diasize-handle.save-position = v-object-handle :row
     2074               .
     2075             end.
     2076           end.
     2077           assign
     2078             v-object-handle = v-object-handle :next-sibling
     2079           .
     2080         end.
     2081         assign
     2082           v-field-group-handle = v-field-group-handle :next-sibling
     2083         .
     2084       end.
     2085       do with frame Dialog-Frame
     2086       :
     2087         hide v-diasize-resize-button .
     2088         assign
     2089           v-diasize-resize-button :row    = 1
     2090           v-diasize-resize-button :column = 1
     2091         .
     2092       end.
     2093       if p-change-value > 0
     2094       then do:
     2095         if frame Dialog-Frame :scrollable = true
     2096         then do:
     2097           assign
     2098             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2099             no-error .
     2100           if error-status :error
     2101           or error-status :get-message(1) <> ""
     2102           then do:
     2103             undo move_block, retry move_block .
     2104           end.
     2105         end.
     2106         assign
     2107           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2108           no-error .
     2109         if error-status :error
     2110         or error-status :get-message(1) <> ""
     2111         then do:
     2112           undo move_block, retry move_block .
     2113         end.
     2114         assign
     2115           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2116           no-error .
     2117         if error-status :error
     2118         or error-status :get-message(1) <> ""
     2119         then do:
     2120           undo move_block, retry move_block .
     2121         end.
     2122         for each buf_temp-browse-handle
     2123           where buf_temp-browse-handle.browse-type = 'height':u
     2124         on error undo move_block, retry move_block
     2125         :
     2126           assign
     2127             buf_temp-browse-handle.browse-handle :height
     2128               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2129             no-error .
     2130           if error-status :error
     2131           or error-status :get-message(1) <> ""
     2132           then do:
     2133             undo move_block, retry move_block .
     2134           end.
     2135         end.
     2136         for each buf_temp-diasize-handle
     2137         on error undo move_block, retry move_block
     2138         :
     2139           assign
     2140             v-object-handle = buf_temp-diasize-handle.handle-value
     2141           .
     2142           if v-object-handle <> v-diasize-resize-button
     2143           then do:
     2144             assign
     2145               v-object-handle :row = v-object-handle :row + p-change-value
     2146               no-error .
     2147             if error-status :error
     2148             or error-status :get-message(1) <> ""
     2149             then do:
     2150               undo move_block, retry move_block .
     2151             end.
     2152           end.
     2153         end.
     2154       end.
     2155       else do:
     2156         for each buf_temp-diasize-handle
     2157         on error undo move_block, retry move_block
     2158         :
     2159           assign
     2160             v-object-handle = buf_temp-diasize-handle.handle-value
     2161           .
     2162           if v-object-handle <> v-diasize-resize-button
     2163           then do:
     2164             assign
     2165               v-object-handle :row = v-object-handle :row + p-change-value
     2166               no-error .
     2167             if error-status :error
     2168             or error-status :get-message(1) <> ""
     2169             then do:
     2170               undo move_block, retry move_block .
     2171             end.
     2172           end.
     2173         end.
     2174         assign
     2175           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2176           no-error .
     2177         if error-status :error
     2178         or error-status :get-message(1) <> ""
     2179         then do:
     2180           undo move_block, retry move_block .
     2181         end.
     2182         for each buf_temp-browse-handle
     2183           where buf_temp-browse-handle.browse-type = 'height':u
     2184         on error undo move_block, retry move_block
     2185         :
     2186           assign
     2187             buf_temp-browse-handle.browse-handle :height
     2188               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2189             no-error .
     2190           if error-status :error
     2191           or error-status :get-message(1) <> ""
     2192           then do:
     2193             undo move_block, retry move_block .
     2194           end.
     2195         end.
     2196         assign
     2197           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2198           no-error .
     2199         if error-status :error
     2200         or error-status :get-message(1) <> ""
     2201         then do:
     2202           undo move_block, retry move_block .
     2203         end.
     2204         if frame Dialog-Frame :scrollable = true
     2205         then do:
     2206           assign
     2207             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2208             no-error .
     2209           if error-status :error
     2210           or error-status :get-message(1) <> ""
     2211           then do:
     2212             undo move_block, retry move_block .
     2213           end.
     2214         end.
     2215       end.
     2216       if p-move-resize = true
     2217       then do:
     2218         run diasize_position-resize-button in this-procedure .
     2219       end.
     2220       if v-diasize-wndstore = true
     2221       then do:
     2222         if connected("ub") = true
     2223         then do:
     2224           define variable v-cntxt-db-num        as integer   no-undo .
     2225           define variable v-cntxt-userid        as character no-undo .
     2226           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2227                                             , OUTPUT v-cntxt-userid
     2228                                             ) .
     2229           run gbl/wndsizew.p
     2230             (input  v-cntxt-db-num
     2231             ,input  v-cntxt-userid
     2232             ,input  v-diasize-proc-name
     2233             ,input  'height':u
     2234             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     2235             ) .
     2236         end.
     2237       end.
     2238     end.
     2239     assign
     2240       v-diasize-change-size = false
     2241     .
     2242   end procedure.
     2243   procedure diasize_set-height :
     2244     define input  parameter p-new-height  as decimal   no-undo .
     2245     define input  parameter p-move-resize as logical   no-undo .
     2246     do
     2247     on error undo, return error return-value
     2248     :
     2249       run diasize_change-height in this-procedure
     2250         (input  (p-new-height - frame Dialog-Frame :height)
     2251         ,input  p-move-resize
     2252         ) .
     2253     end.
     2254   end procedure.
     2255   procedure diasize_change-width :
     2256     define input  parameter p-change-value as decimal   no-undo .
     2257     define input  parameter p-move-resize  as logical   no-undo .
     2258     define variable v-field-group-handle   as handle    no-undo .
     2259     define variable v-object-handle        as handle    no-undo .
     2260     define variable v-frame-width          as decimal   no-undo .
     2261     define variable v-frame-virtual-width  as decimal   no-undo .
     2262     define variable v-browse-width         as decimal   no-undo .
     2263     define variable v-window-width         as decimal   no-undo .
     2264     define variable v-window-virtual-width as decimal   no-undo .
     2265     define variable v-change-sign          as integer   no-undo .
     2266     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2267     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2268     if p-change-value > 0
     2269     then do:
     2270       if frame Dialog-Frame :width + p-change-value >
     2271           session :width-chars
     2272       then do:
     2273         assign
     2274           p-change-value = session :width-chars - frame Dialog-Frame :width
     2275         .
     2276         if p-change-value <= 0
     2277         then do:
     2278           run diasize_position-resize-button in this-procedure .
     2279           return .
     2280         end.
     2281       end.
     2282     end.
     2283     if p-change-value < 0
     2284     then do:
     2285       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     2286       then do:
     2287         assign
     2288           p-change-value = v-diasize-orig-frame-width
     2289                          - frame Dialog-Frame :width
     2290         .
     2291         if p-change-value >= 0
     2292         then do:
     2293           run diasize_position-resize-button in this-procedure .
     2294           return .
     2295         end.
     2296       end.
     2297     end.
     2298     if p-change-value >= 0
     2299     then do:
     2300       assign
     2301         v-change-sign = 1
     2302       .
     2303     end.
     2304     else do:
     2305       assign
     2306         v-change-sign = -1
     2307       .
     2308     end.
     2309     assign
     2310       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2311     .
     2312     if p-change-value = 0
     2313     then do:
     2314       run diasize_position-resize-button in this-procedure .
     2315       return .
     2316     end.
     2317     move_block:
     2318     do
     2319     on error undo move_block, leave move_block
     2320     :
     2321       if retry
     2322       then do:
     2323         do
     2324         on error undo move_block, leave move_block
     2325         :
     2326           if p-change-value > 0
     2327           then do:
     2328             for each buf_temp-diasize-handle
     2329             on error undo, next
     2330             :
     2331               assign
     2332                 v-object-handle = buf_temp-diasize-handle.handle-value
     2333               .
     2334               if v-object-handle <> v-diasize-resize-button
     2335               then do:
     2336                 assign
     2337                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2338                 .
     2339               end.
     2340             end.
     2341             assign
     2342               v-diasize-browse-handle :width = v-browse-width
     2343             .
     2344             for each buf_temp-browse-handle
     2345               where buf_temp-browse-handle.browse-type = 'width':u
     2346             on error undo, next
     2347             :
     2348               assign
     2349                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2350               .
     2351             end.
     2352             assign
     2353               frame Dialog-Frame :width = v-frame-width
     2354             .
     2355             if frame Dialog-Frame :scrollable = true
     2356             then do:
     2357               assign
     2358                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2359               .
     2360             end.
     2361             run diasize_position-resize-button in this-procedure .
     2362           end.
     2363           else do:
     2364             if frame Dialog-Frame :scrollable = true
     2365             then do:
     2366               assign
     2367                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2368               .
     2369             end.
     2370             assign
     2371               frame Dialog-Frame :width = v-frame-width
     2372             .
     2373             for each buf_temp-browse-handle
     2374               where buf_temp-browse-handle.browse-type = 'width':u
     2375             on error undo, next
     2376             :
     2377               assign
     2378                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2379               .
     2380             end.
     2381             assign
     2382               v-diasize-browse-handle :width = v-browse-width
     2383             .
     2384             for each buf_temp-diasize-handle
     2385             on error undo, next
     2386             :
     2387               assign
     2388                 v-object-handle = buf_temp-diasize-handle.handle-value
     2389               .
     2390               if v-object-handle <> v-diasize-resize-button
     2391               then do:
     2392                 assign
     2393                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2394                 .
     2395               end.
     2396             end.
     2397             run diasize_position-resize-button in this-procedure .
     2398           end.
     2399           assign
     2400             v-diasize-change-size = false
     2401           .
     2402           leave move_block .
     2403         end.
     2404       end.
     2405       assign
     2406         v-diasize-need-full-display = true
     2407       .
     2408       if v-diasize-change-size = false
     2409       then do:
     2410         assign
     2411           v-diasize-change-size = true
     2412         .
     2413       end.
     2414       else do:
     2415         return .
     2416       end.
     2417       assign
     2418         v-frame-width = frame Dialog-Frame :width
     2419         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     2420         v-browse-width = v-diasize-browse-handle :width
     2421       .
     2422       for each buf_temp-browse-handle
     2423         where buf_temp-browse-handle.browse-type = 'width':u
     2424       :
     2425         assign
     2426           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2427         .
     2428       end.
     2429       for each buf_temp-diasize-handle
     2430       :
     2431         delete buf_temp-diasize-handle .
     2432       end.
     2433       assign
     2434         v-field-group-handle = frame Dialog-Frame :first-child
     2435       .
     2436       do while valid-handle(v-field-group-handle)
     2437       :
     2438         assign
     2439           v-object-handle = v-field-group-handle :first-child
     2440         .
     2441         do while valid-handle(v-object-handle)
     2442         :
     2443           if  v-object-handle <> v-diasize-browse-handle :handle
     2444           and v-object-handle <> v-diasize-resize-button
     2445           and can-query(v-object-handle, "row")
     2446           and can-query(v-object-handle, "height")
     2447           and ( v-object-handle :col + v-object-handle :width
     2448                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2449               )
     2450           then do:
     2451             find first buf_temp-browse-handle
     2452               where buf_temp-browse-handle.browse-type   = 'width':u
     2453                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2454               no-error .
     2455             if available buf_temp-browse-handle
     2456             then do:
     2457             end.
     2458             else do:
     2459               create buf_temp-diasize-handle .
     2460               assign
     2461                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2462                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2463               .
     2464             end.
     2465           end.
     2466           assign
     2467             v-object-handle = v-object-handle :next-sibling
     2468           .
     2469         end.
     2470         assign
     2471           v-field-group-handle = v-field-group-handle :next-sibling
     2472         .
     2473       end.
     2474       do with frame Dialog-Frame
     2475       :
     2476         hide v-diasize-resize-button .
     2477         v-diasize-resize-button :row = 1.
     2478         v-diasize-resize-button :column = 1.
     2479       end.
     2480       if p-change-value > 0
     2481       then do:
     2482         if frame Dialog-Frame :scrollable = true
     2483         then do:
     2484           assign
     2485             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2486             no-error .
     2487           if error-status :error
     2488           or error-status :get-message(1) <> ""
     2489           then do:
     2490             undo move_block, retry move_block.
     2491           end.
     2492         end.
     2493         assign
     2494           frame Dialog-Frame :width = v-frame-width + p-change-value
     2495           no-error .
     2496         if error-status :error
     2497         or error-status :get-message(1) <> ""
     2498         then do:
     2499           undo move_block, retry move_block.
     2500         end.
     2501         assign
     2502           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2503         no-error .
     2504         if error-status :error
     2505         or error-status :get-message(1) <> ""
     2506         then do:
     2507           undo move_block, retry move_block.
     2508         end.
     2509         for each buf_temp-browse-handle
     2510           where buf_temp-browse-handle.browse-type = 'width':u
     2511         on error undo move_block, retry move_block
     2512         :
     2513           assign
     2514             buf_temp-browse-handle.browse-handle :width
     2515               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2516             no-error .
     2517           if error-status :error
     2518           or error-status :get-message(1) <> ""
     2519           then do:
     2520             undo move_block, retry move_block .
     2521           end.
     2522         end.
     2523         for each buf_temp-diasize-handle
     2524         on error undo move_block, retry move_block
     2525         :
     2526           assign
     2527             v-object-handle = buf_temp-diasize-handle.handle-value
     2528           .
     2529           if v-object-handle <> v-diasize-resize-button
     2530           then do:
     2531             assign
     2532               v-object-handle :col = v-object-handle :col + p-change-value
     2533               no-error .
     2534             if error-status :error
     2535             or error-status :get-message(1) <> ""
     2536             then do:
     2537               undo move_block, retry move_block .
     2538             end.
     2539           end.
     2540         end.
     2541       end.
     2542       else do:
     2543         for each buf_temp-diasize-handle
     2544         on error undo move_block, retry move_block
     2545         :
     2546           assign
     2547             v-object-handle = buf_temp-diasize-handle.handle-value
     2548           .
     2549           if v-object-handle <> v-diasize-resize-button
     2550           then do:
     2551             assign
     2552               v-object-handle :col = v-object-handle :col + p-change-value
     2553               no-error .
     2554             if error-status :error
     2555             or error-status :get-message(1) <> ""
     2556             then do:
     2557               undo move_block, retry move_block .
     2558             end.
     2559           end.
     2560         end.
     2561         for each buf_temp-browse-handle
     2562           where buf_temp-browse-handle.browse-type = 'width':u
     2563         on error undo move_block, retry move_block
     2564         :
     2565           assign
     2566             buf_temp-browse-handle.browse-handle :width
     2567               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2568             no-error .
     2569           if error-status :error
     2570           or error-status :get-message(1) <> ""
     2571           then do:
     2572             undo move_block, retry move_block .
     2573           end.
     2574         end.
     2575         assign
     2576           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2577           no-error .
     2578         if error-status :error
     2579         or error-status :get-message(1) <> ""
     2580         then do:
     2581           undo move_block, retry move_block.
     2582         end.
     2583         assign
     2584           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2585         no-error .
     2586         if error-status :error
     2587         or error-status :get-message(1) <> ""
     2588         then do:
     2589           undo move_block, retry move_block.
     2590         end.
     2591         if frame Dialog-Frame :scrollable = true
     2592         then do:
     2593           assign
     2594             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2595           no-error .
     2596           if error-status :error
     2597           or error-status :get-message(1) <> ""
     2598           then do:
     2599             undo move_block, retry move_block.
     2600           end.
     2601         end.
     2602       end.
     2603       if p-move-resize
     2604       then do:
     2605         run diasize_position-resize-button in this-procedure .
     2606       end.
     2607       if v-diasize-wndstore = true
     2608       then do:
     2609         if connected("ub") = true
     2610         then do:
     2611           define variable v-cntxt-db-num        as integer   no-undo .
     2612           define variable v-cntxt-userid        as character no-undo .
     2613           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2614                                             , OUTPUT v-cntxt-userid
     2615                                             ) .
     2616           run gbl/wndsizew.p
     2617             (input  v-cntxt-db-num
     2618             ,input  v-cntxt-userid
     2619             ,input  v-diasize-proc-name
     2620             ,input  'width':u
     2621             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2622             ) .
     2623         end.
     2624       end.
     2625     end.
     2626     assign
     2627       v-diasize-change-size = false
     2628     .
     2629   end procedure.
     2630   procedure diasize_set-width :
     2631     define input  parameter p-new-width  as decimal   no-undo .
     2632     define input  parameter p-move-resize as logical   no-undo .
     2633     do
     2634     on error undo, return error return-value
     2635     :
     2636       run diasize_change-width in this-procedure
     2637         (input  (p-new-width - frame Dialog-Frame :width)
     2638         ,input  p-move-resize
     2639         ) .
     2640     end.
     2641   end procedure.
     2642   procedure diasize_position-resize-button :
     2643     do with frame Dialog-Frame
     2644     :
     2645       hide v-diasize-resize-button .
     2646       assign
     2647         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2648                     - 1
     2649                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2650         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2651                     - 1
     2652                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2653       .
     2654       view v-diasize-resize-button .
     2655     end.
     2656   end procedure.
     2657   on alt-right anywhere
     2658   do:
     2659     run diasize_change-width in this-procedure
     2660       (input 1
     2661       ,input true
     2662       ) .
     2663     return no-apply .
     2664   end.
     2665   on alt-left anywhere
     2666   do:
     2667     run diasize_change-width in this-procedure
     2668       (input -1
     2669       ,input true
     2670       ) .
     2671     return no-apply .
     2672   end.
     2673   on alt-down anywhere
     2674   do:
     2675     run diasize_change-height in this-procedure
     2676       (input 1
     2677       ,input true
     2678       ) .
     2679     return no-apply .
     2680   end.
     2681   on alt-up anywhere
     2682   do:
     2683     run diasize_change-height in this-procedure
     2684       (input -1
     2685       ,input true
     2686       ) .
     2687     return no-apply .
     2688   end.
     2689   on alt-enter of frame Dialog-Frame
     2690   do:
     2691     run diasize_maximize in this-procedure
     2692       (input  ?
     2693       ).
     2694     return no-apply .
     2695   end.
     2696   procedure diasize_end-move :
     2697     do
     2698     on error undo, return error return-value
     2699     :
     2700       define variable v-row-delta as decimal   no-undo .
     2701       define variable v-col-delta as decimal   no-undo .
     2702       define variable v-new-row as decimal   no-undo .
     2703       define variable v-new-col as decimal   no-undo .
     2704       assign
     2705         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2706         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2707       .
     2708       assign
     2709         v-row-delta = v-new-row - frame Dialog-Frame :height
     2710         v-col-delta = v-new-col - frame Dialog-Frame :width
     2711       .
     2712       run diasize_change-height in this-procedure
     2713         (input v-row-delta
     2714         ,input true
     2715         ) .
     2716       run diasize_change-width in this-procedure
     2717         (input v-col-delta
     2718         ,input true
     2719         ) .
     2720     end.
     2721   end procedure.
     2722   procedure diasize_maximize :
     2723     define input  parameter p-action as logical   no-undo .
     2724     do
     2725     on error undo, return error return-value
     2726     :
     2727       if p-action = ?
     2728       then do:
     2729         if v-diasize-need-maximize = true
     2730         then do:
     2731           assign
     2732             p-action = true
     2733           .
     2734         end.
     2735         else do:
     2736           assign
     2737             p-action = false
     2738           .
     2739         end.
     2740       end.
     2741       if p-action = true
     2742       then do:
     2743         run diasize_change-height in this-procedure
     2744           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2745               - frame Dialog-Frame :height-chars
     2746           ,input true
     2747           ) .
     2748         run diasize_change-width in this-procedure
     2749           (input session :width-chars
     2750               - frame Dialog-Frame :width-chars
     2751           ,input true
     2752           ) .
     2753         assign
     2754           v-diasize-need-maximize = false
     2755         .
     2756       end.
     2757       else do:
     2758         run diasize_change-width in this-procedure
     2759           (input v-diasize-orig-frame-width
     2760               - frame Dialog-Frame :width-chars
     2761           ,input true
     2762           ) .
     2763         run diasize_change-height in this-procedure
     2764           (input v-diasize-orig-frame-height
     2765               - frame Dialog-Frame :height-chars
     2766           ,input true
     2767           ) .
     2768         assign
     2769           v-diasize-need-maximize = true
     2770         .
     2771       end.
     2772     end.
     2773   end procedure.
     2774   procedure diasize_restore-orig-size :
     2775     do
     2776     on error undo, return error return-value
     2777     :
     2778       assign
     2779         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2780         v-diasize-current-frame-height = frame Dialog-Frame :height
     2781       .
     2782       run diasize_set-height in this-procedure
     2783         (input  v-diasize-orig-frame-height
     2784         ,input  true
     2785         ) .
     2786       run diasize_set-width in this-procedure
     2787         (input  v-diasize-orig-frame-width
     2788         ,input  true
     2789         ) .
     2790     end.
     2791   end procedure.
     2792   procedure diasize_restore-current-size :
     2793     do
     2794     on error undo, return error return-value
     2795     :
     2796       run diasize_set-height in this-procedure
     2797         (input  v-diasize-current-frame-height
     2798         ,input  true
     2799         ) .
     2800       run diasize_set-width in this-procedure
     2801         (input  v-diasize-current-frame-width
     2802         ,input  true
     2803         ) .
     2804     end.
     2805   end procedure.
     2806   procedure diasize_set-browse-handle :
     2807     define input  parameter p-browse-handle as handle   no-undo .
     2808     define buffer buf_temp-browse-handle for temp-browse-handle .
     2809     do
     2810     on error undo, return error return-value
     2811     :
     2812       assign
     2813         v-diasize-browse-handle = p-browse-handle
     2814       .
     2815       for each buf_temp-browse-handle
     2816       on error undo, return error return-value
     2817       :
     2818         delete buf_temp-browse-handle .
     2819       end.
     2820     end.
     2821   end procedure.
     2822   procedure diasize_add_browse :
     2823     define input  parameter p-browse-type   as character no-undo .
     2824     define input  parameter p-browse-handle as handle    no-undo .
     2825     define buffer buf_temp-browse-handle for temp-browse-handle .
     2826     do
     2827     on error undo, return error return-value
     2828     :
     2829       assign
     2830         v-diasize-browse-number = v-diasize-browse-number + 1
     2831       .
     2832       create buf_temp-browse-handle .
     2833       assign
     2834         buf_temp-browse-handle.browse-type   = p-browse-type
     2835         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2836         buf_temp-browse-handle.browse-handle = p-browse-handle
     2837       .
     2838     end.
     2839   end procedure.
     2840   procedure diasize_init :
     2841     define variable v-default-value    as logical   no-undo .
     2842     define variable v-restore-saved    as logical   no-undo .
     2843     define variable v-resize-value-str as character no-undo .
     2844     do
     2845     on error undo, return error return-value
     2846     :
     2847       do with frame Dialog-Frame
     2848       :
     2849         assign
     2850           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2851           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2852           v-diasize-browse-handle     = browse BROWSE-1grp :handle
     2853         .
     2854         create button v-diasize-resize-button
     2855         assign
     2856           parent        = frame Dialog-Frame :first-child
     2857           label         = "s"
     2858           height-pixels = 16
     2859           width-pixels  = 16
     2860           visible       = true
     2861           sensitive     = true
     2862           movable       = true
     2863           triggers:
     2864             on end-move persistent run diasize_end-move in this-procedure .
     2865           end triggers.
     2866         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2867         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2868         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2869         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2870         assign
     2871           v-diasize-wndmax = false
     2872         .
     2873         if connected("ub") = true
     2874         then do:
     2875           define variable v-cntxt-db-num        as integer   no-undo .
     2876           define variable v-cntxt-userid        as character no-undo .
     2877           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2878                                             , OUTPUT v-cntxt-userid
     2879                                             ) .
     2880           run gbl/wndpar_r.p
     2881             (input  v-cntxt-db-num
     2882             ,input  v-cntxt-userid
     2883             ,input  'wndmax':U
     2884             ,output v-diasize-wndmax
     2885             ,output v-default-value
     2886             ) .
     2887         end.
     2888         assign
     2889           v-diasize-wndstore = false
     2890         .
     2891         if connected("ub") = true
     2892         then do:
     2893           run gbl/wndpar_r.p
     2894             (input  v-cntxt-db-num
     2895             ,input  v-cntxt-userid
     2896             ,input  'wndstore':U
     2897             ,output v-diasize-wndstore
     2898             ,output v-default-value
     2899             ) .
     2900         end.
     2901         assign
     2902           v-diasize-proc-name = entry(1, program-name(2), '.')
     2903         .
     2904         if v-diasize-wndstore = true
     2905         then do:
     2906           assign
     2907             v-restore-saved = false
     2908           .
     2909           if connected("ub") = true
     2910           then do:
     2911             run gbl/wndsizer.p
     2912               (input  v-cntxt-db-num
     2913               ,input  v-cntxt-userid
     2914               ,input  v-diasize-proc-name
     2915               ,input  'height':u
     2916               ,output v-resize-value-str
     2917               ) .
     2918             if v-resize-value-str <> '':U
     2919             then do:
     2920               run diasize_change-height in this-procedure
     2921                 (input  integer(v-resize-value-str)
     2922                 ,input  true
     2923                 ) .
     2924               assign
     2925                 v-restore-saved = true
     2926               .
     2927             end.
     2928           end.
     2929           if connected("ub") = true
     2930           then do:
     2931             run gbl/wndsizer.p
     2932               (input  v-cntxt-db-num
     2933               ,input  v-cntxt-userid
     2934               ,input  v-diasize-proc-name
     2935               ,input  'width':u
     2936               ,output v-resize-value-str
     2937               ) .
     2938             if v-resize-value-str <> '':U
     2939             then do:
     2940               run diasize_change-width in this-procedure
     2941                 (input  integer(v-resize-value-str)
     2942                 ,input  true
     2943                 ) .
     2944               assign
     2945                 v-restore-saved = true
     2946               .
     2947             end.
     2948           end.
     2949           if v-restore-saved <> true
     2950           then do:
     2951             if v-diasize-wndmax = true
     2952             then do:
     2953               run diasize_maximize in this-procedure
     2954                 (input  true
     2955                 ) .
     2956             end.
     2957           end.
     2958         end.
     2959         else do:
     2960           if v-diasize-wndmax = true
     2961           then do:
     2962             run diasize_maximize in this-procedure
     2963               (input  true
     2964               ) .
     2965           end.
     2966         end.
     2967       end.
     2968     end.
     2969   end procedure.
     2970   procedure diasize_need-full-display :
     2971     define output parameter p-need-full-display as logical   no-undo .
     2972     do
     2973     on error undo, return error return-value
     2974     :
     2975       assign
     2976         p-need-full-display = v-diasize-need-full-display
     2977       .
     2978       assign
     2979         v-diasize-need-full-display = false
     2980       .
     2981     end.
     2982   end procedure.
     2983   procedure get-context :
     2984      define output parameter p-db-num as integer          no-undo.
     2985      define output parameter p-user-id as character        no-undo.
     2986      define variable v-login               as character    no-undo.
     2987      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2988      define buffer buf_user-login  for ub.user-login .
     2989      do
     2990      on error undo, return error
     2991      :
     2992            FIND FIRST buf_sys-ctrl no-lock.
     2993            ASSIGN
     2994               v-login = USERID("ub")
     2995               p-db-num = buf_sys-ctrl.db-num
     2996            .
     2997            FIND FIRST buf_user-login
     2998                 WHERE buf_user-login.db-num = p-db-num
     2999                   AND buf_user-login.user-login = v-login
     3000                 no-lock
     3001                 no-error
     3002                 .
     3003            IF AVAILABLE buf_user-login
     3004            THEN DO:
     3005               assign
     3006                  p-user-id = buf_user-login.user-id
     3007               .
     3008            END.
     3009      end.
     3010   end procedure.
     3011       run diasize_init in this-procedure .
     3012   def var sort-labelBROWSE-5all   as character no-undo .
     3013   def var sort-clmnBROWSE-5all    as handle    no-undo .
     3014   def var cur-clmnBROWSE-5all     as handle    no-undo .
     3015   def var cur-clmn-locBROWSE-5all as integer   no-undo .
     3016   def var re-queryBROWSE-5all     as logical   initial no no-undo .
     3017   on start-search, ctrl-o of BROWSE-5all in frame Dialog-Frame do:
     3018      run sort-brBROWSE-5all
     3019        (input (if available x_obj-grp-obj-price
     3020                then recid(x_obj-grp-obj-price)
     3021                else ?
     3022               )
     3023        ).
     3024   end.
     3025   PROCEDURE sort-brBROWSE-5all :
     3026     define input parameter p-recid as recid no-undo .
     3027     if re-queryBROWSE-5all = no then do:
     3028       assign
     3029          cur-clmnBROWSE-5all = BROWSE-5all:current-column in frame Dialog-Frame
     3030       .
     3031       if sort-clmnBROWSE-5all <> ? then sort-clmnBROWSE-5all:column-fgcolor = 0.
     3032       if cur-clmnBROWSE-5all = sort-clmnBROWSE-5all then do:
     3033         assign
     3034            sort-labelBROWSE-5all = ""
     3035            sort-clmnBROWSE-5all = ?
     3036         .
     3037        end.
     3038        else do:
     3039          assign
     3040            sort-labelBROWSE-5all = cur-clmnBROWSE-5all:label
     3041            sort-clmnBROWSE-5all  = cur-clmnBROWSE-5all
     3042            sort-clmnBROWSE-5all:column-fgcolor = 4
     3043          .
     3044        end.
     3045      end.
     3046     assign
     3047       cur-clmn-locBROWSE-5all = 1
     3048     .
     3049     def var column-handle as handle no-undo .
     3050     column-handle = BROWSE-5all:first-column.
     3051     do while valid-handle(column-handle) :
     3052       if column-handle = cur-clmnBROWSE-5all then do:
     3053         leave .
     3054       end.
     3055       column-handle = column-handle:NEXT-COLUMN.
     3056       assign
     3057         cur-clmn-locBROWSE-5all = cur-clmn-locBROWSE-5all + 1
     3058       .
     3059     end.
     3060     case sort-labelBROWSE-5all:
     3061           when 'Объект'  then DO:   assign     sort-column-name = "buf_clients.obj-code"   .   run open-5all .   . END.
     3062           when 'Имя объекта'  then DO:   assign     sort-column-name = "buf_clients.obj-name"   .   run open-5all .   . END.
     3063           when 'Фирма'  then DO:   assign     sort-column-name = "buf_clients.host-code"   .   run open-5all .   . END.
     3064           when 'БД'  then DO:   assign     sort-column-name = "buf_clients.db-num"   .   run open-5all .   . END.
     3065           when 'Статус'  then DO:   assign     sort-column-name = "x_obj-grp-obj-price.stts"   .   run open-5all .   . END.
     3066       otherwise do:
     3067         assign
     3068           sort-column-name = ""
     3069         .
     3070         run open-5all .
     3071         if sort-labelBROWSE-5all <> "" then do:
     3072           assign
     3073             cur-clmnBROWSE-5all:column-fgcolor = 0
     3074           .
     3075         end.
     3076         assign
     3077           cur-clmn-locBROWSE-5all = ?
     3078         .
     3079       end.
     3080     end case.
     3081     if p-recid <> ? then do:
     3082       reposition BROWSE-5all to recid p-recid no-error.
     3083       apply "value-changed" to BROWSE-5all in frame Dialog-Frame.
     3084     end.
     3085     apply "entry" to BROWSE-5all in frame Dialog-Frame.
     3086   END PROCEDURE.
     3087   procedure re-open-query-srt-clmnBROWSE-5all:
     3088   if cur-clmnBROWSE-5all = ? then do:
     3089      run open-5all .
     3090   end.
     3091   else do:
     3092      assign re-queryBROWSE-5all = yes.
     3093      run sort-brBROWSE-5all
     3094        (input (if available x_obj-grp-obj-price
     3095                then recid(x_obj-grp-obj-price)
     3096                else ?
     3097               )
     3098        ).
     3099      assign re-queryBROWSE-5all = no.
     3100   end.
     3101   end.
     3102    buf_clients.db-num:read-only           in browse BROWSE-5all = true .
     3103    buf_grp-obj-price.name-group:resizable in browse BROWSE-1grp   = true .
     3104    buf_clients.obj-name:resizable         in browse BROWSE-5all   = true .
     3105   MAIN-BLOCK:
     3106   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     3107      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     3108      define variable g#log as logical   no-undo .
     3109   define variable vss-include-info28 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3110   do:
     3111     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     3112       (input  v-cntxt-db-num
     3113       ,input  v-cntxt-userid
     3114       ,input  0
     3115       ,input  'actn_ref-mpl_lookup':U
     3116       ,input  'global':U
     3117       ,input  v-cntxt-host-code-obj
     3118       ,input  v-cntxt-obj-type
     3119       ,input  v-cntxt-obj-code
     3120       ,input  0
     3121       ,input  0
     3122       ,input  0
     3123       ,input  true
     3124       ,output g#log
     3125       )  .
     3126   end.
     3127     if not g#log then return .
     3128   define variable vss-include-info29 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3129   do:
     3130     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     3131       (input  v-cntxt-db-num
     3132       ,input  v-cntxt-userid
     3133       ,input  0
     3134       ,input  'actn_ref-mpl_update':U
     3135       ,input  'global':U
     3136       ,input  v-cntxt-host-code-obj
     3137       ,input  v-cntxt-obj-type
     3138       ,input  v-cntxt-obj-code
     3139       ,input  0
     3140       ,input  0
     3141       ,input  0
     3142       ,input  false
     3143       ,output g#log
     3144       )  .
     3145   end.
     3146     if not g#log then buf_grp-obj-price.name:read-only in browse BROWSE-1grp .
     3147     run init-5obj.
     3148     if p-rec-list <> "" and p-rec-list <> ? then run select_one.
     3149     RUN enable_UI.
     3150     disable
     3151        B-sel      when LOOKUP ("b-sel":U,   p-bttns) = 0
     3152        B-add      when LOOKUP ("b-add":U,   p-bttns) = 0
     3153        B-del      when LOOKUP ("b-del":U,   p-bttns) = 0
     3154        B-mark     when LOOKUP ("b-mark":U,  p-bttns) = 0
     3155        B-mark-2   when LOOKUP ("b-mark-2":U,p-bttns) = 0
     3156        B-add-DB   when LOOKUP ("b-add":U,   p-bttns) = 0
     3157        B-del-DB   when LOOKUP ("b-del":U,   p-bttns) = 0
     3158        B-mark-3   when LOOKUP ("b-mark-3":U,p-bttns) = 0
     3159        B-add-frm  when LOOKUP ("b-add":U,   p-bttns) = 0
     3160        B-del-frm  when LOOKUP ("b-del":U,   p-bttns) = 0
     3161        B-mark-4   when LOOKUP ("b-mark-4":U,p-bttns) = 0
     3162        B-add-obj  when LOOKUP ("b-add":U,   p-bttns) = 0
     3163        B-del-obj  when LOOKUP ("b-del":U,   p-bttns) = 0
     3164     with frame Dialog-Frame .
     3165     if lookup ("b-add":U,   p-bttns) = 0 then v-full = true  .
     3166                                          else v-full = false  .
     3167     apply "CHOOSE" to b-more IN FRAME Dialog-Frame .
     3168     WAIT-FOR GO OF FRAME Dialog-Frame.
     3169   END.
     3170   RUN disable_UI.
     3171   PROCEDURE disable_UI :
     3172     HIDE FRAME Dialog-Frame.
     3173   END PROCEDURE.
     3174   PROCEDURE enable_UI :
     3175     DISPLAY R-status FILL-IN-1 F-obj
     3176         WITH FRAME Dialog-Frame.
     3177     ENABLE B-Cancel RECT-1 B-sel B-add B-del B-price-type b-more B-history
     3178            B-print B-Help R-status B-mark B-find-obj B-all B-mark-2 B-add-DB
     3179            B-del-DB B-mark-3 B-add-frm B-del-frm BROWSE-1grp BROWSE-2db
     3180            BROWSE-3frm BROWSE-5all B-mark-4 B-add-obj B-del-obj BROWSE-4obj
     3181            FILL-IN-1 F-obj
     3182         WITH FRAME Dialog-Frame.
     3183     VIEW FRAME Dialog-Frame.
     3184     OPEN QUERY BROWSE-1grp FOR EACH buf_grp-obj-price WHERE     ( r-status = 2 OR buf_grp-obj-price.stts =  r-status ) AND     ( g-find = NO OR       LOOKUP (string(buf_grp-obj-price.gop-id) + ";"  + string(buf_grp-obj-price.gop-db-num)  ,        tt-grp-obj ) > 0 )                .    OPEN QUERY BROWSE-2db FOR EACH buf_db-grp-obj-price OF buf_grp-obj-price      WHERE ( r-status = 2 OR buf_db-grp-obj-price.stts =  r-status )       NO-LOCK INDEXED-REPOSITION.    OPEN QUERY BROWSE-3frm FOR EACH buf_host-grp-obj-price OF buf_grp-obj-price      WHERE ( r-status = 2 OR buf_host-grp-obj-price.stts =  r-status )       NO-LOCK ,            FIRST host-name NO-LOCK WHERE       host-name.obj-code = buf_host-grp-obj-price.host-code AND       host-name.obj-type = 'орг':U     INDEXED-REPOSITION.    OPEN QUERY BROWSE-4obj FOR EACH buf_obj-grp-obj-price OF buf_grp-obj-price      WHERE ( r-status = 2 OR buf_obj-grp-obj-price.stts =  r-status )       NO-LOCK,            FIRST buf_obj-name NO-LOCK WHERE       buf_obj-name.obj-code = buf_obj-grp-obj-price.obj-code AND       buf_obj-name.obj-type = buf_obj-grp-obj-price.obj-type     INDEXED-REPOSITION.    OPEN QUERY BROWSE-5all FOR EACH x_obj-grp-obj-price OF buf_grp-obj-price      WHERE ( r-status = 2 OR x_obj-grp-obj-price.stts =  r-status )       NO-LOCK ,            FIRST buf_clients NO-LOCK WHERE       buf_clients.obj-code = x_obj-grp-obj-price.obj-code AND       buf_clients.obj-type = x_obj-grp-obj-price.obj-type        .
     3185   END PROCEDURE.
     3186   PROCEDURE init-5obj :
     3187   run waitfram-show in this-procedure  ( "Сбор объектов по группам...." ) .
     3188   define buffer buf1_clients for ub.clients  .
     3189   for each  x_obj-grp-obj-price : delete x_obj-grp-obj-price. end.
     3190   for each buf_db-grp-obj-price  no-lock :
     3191     for each buf1_clients no-lock where
     3192              buf1_clients.db-num = buf_db-grp-obj-price.dgo-db-num and
     3193              buf1_clients.stts = 0 :
     3194       create x_obj-grp-obj-price .
     3195       assign
     3196         x_obj-grp-obj-price.gop-db-num = buf_db-grp-obj-price.gop-db-num
     3197         x_obj-grp-obj-price.gop-id     = buf_db-grp-obj-price.gop-id
     3198         x_obj-grp-obj-price.obj-code   = buf1_clients.obj-code
     3199         x_obj-grp-obj-price.obj-type   = buf1_clients.obj-type
     3200         x_obj-grp-obj-price.stts       = buf_db-grp-obj-price.stts
     3201       .
     3202     end.
     3203   end.
     3204   for each buf_host-grp-obj-price no-lock :
     3205     for each buf1_clients no-lock where
     3206              buf1_clients.host-code = buf_host-grp-obj-price.host-code and
     3207              buf1_clients.stts      = 0 :
     3208         find first x_obj-grp-obj-price no-lock  where
     3209                    x_obj-grp-obj-price.gop-db-num = buf_host-grp-obj-price.gop-db-num and
     3210                    x_obj-grp-obj-price.gop-id     = buf_host-grp-obj-price.gop-id and
     3211                    x_obj-grp-obj-price.obj-code   = buf1_clients.obj-code and
     3212                    x_obj-grp-obj-price.obj-type   = buf1_clients.obj-type no-error .
     3213         if not available  x_obj-grp-obj-price then   create x_obj-grp-obj-price .
     3214         assign
     3215           x_obj-grp-obj-price.gop-db-num = buf_host-grp-obj-price.gop-db-num
     3216           x_obj-grp-obj-price.gop-id     = buf_host-grp-obj-price.gop-id
     3217           x_obj-grp-obj-price.obj-code   = buf1_clients.obj-code
     3218           x_obj-grp-obj-price.obj-type   = buf1_clients.obj-type
     3219         .
     3220     end.
     3221   end.
     3222   for each buf_obj-grp-obj-price no-lock :
     3223     for each buf1_clients no-lock where
     3224               buf1_clients.obj-type = buf_obj-grp-obj-price.obj-type and
     3225               buf1_clients.obj-code = buf_obj-grp-obj-price.obj-code and
     3226               buf1_clients.stts = 0:
     3227         find first  x_obj-grp-obj-price no-lock  where
     3228                     x_obj-grp-obj-price.gop-db-num = buf_obj-grp-obj-price.gop-db-num and
     3229                     x_obj-grp-obj-price.gop-id     = buf_obj-grp-obj-price.gop-id and
     3230                     x_obj-grp-obj-price.obj-code   = buf1_clients.obj-code and
     3231                     x_obj-grp-obj-price.obj-type   = buf1_clients.obj-type no-error .
     3232         if not available  x_obj-grp-obj-price then   create x_obj-grp-obj-price .
     3233         assign
     3234           x_obj-grp-obj-price.gop-db-num = buf_obj-grp-obj-price.gop-db-num
     3235           x_obj-grp-obj-price.gop-id     = buf_obj-grp-obj-price.gop-id
     3236           x_obj-grp-obj-price.obj-code   = buf1_clients.obj-code
     3237           x_obj-grp-obj-price.obj-type   = buf1_clients.obj-type
     3238         .
     3239     end.
     3240   end.
     3241   for each x_obj-grp-obj-price :
     3242     run ver-stts in this-procedure (
     3243       input x_obj-grp-obj-price.gop-db-num ,
     3244       input x_obj-grp-obj-price.gop-id     ,
     3245       input x_obj-grp-obj-price.obj-code   ,
     3246       input x_obj-grp-obj-price.obj-type   ,
     3247       output x_obj-grp-obj-price.stts
     3248       ).
     3249   end.
     3250   run open-5all in this-procedure .
     3251   run waitfram-hide in this-procedure .
     3252   END PROCEDURE.
     3253   PROCEDURE m-tt :
     3254    define variable v-user-select as logical   no-undo .
     3255   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3256   run userobjs_select-one in this-procedure
     3257     (input  parparentproc
     3258     ,input  v-cntxt-db-num
     3259     ,input  v-cntxt-userid
     3260     ,input  v-cntxt-host-code-obj
     3261     ,input  v-cntxt-obj-type
     3262     ,input  v-cntxt-obj-code
     3263     ,output v-user-select
     3264     ,output v-obj-type
     3265     ,output v-obj-code
     3266     )  .
     3267       if v-user-select = false
     3268       then do:
     3269         v-obj-type = ""  .
     3270         v-obj-code = ?   .
     3271       end.
     3272     tt-grp-obj = "".
     3273     for each x_obj-grp-obj-price  where
     3274              x_obj-grp-obj-price.stts = 0 and
     3275              x_obj-grp-obj-price.obj-type = v-obj-type and
     3276              x_obj-grp-obj-price.obj-code = v-obj-code :
     3277              tt-grp-obj = tt-grp-obj + string(x_obj-grp-obj-price.gop-id ) + ";"  + string (x_obj-grp-obj-price.gop-db-num) + "," .
     3278     end.
     3279   END PROCEDURE.
     3280   PROCEDURE open-5all :
     3281    case sort-column-name :
     3282     when ""  then do:
     3283       OPEN QUERY BROWSE-5all  FOR EACH x_obj-grp-obj-price OF buf_grp-obj-price      WHERE ( r-status = 2 OR x_obj-grp-obj-price.stts =  r-status )       NO-LOCK ,            FIRST buf_clients NO-LOCK WHERE       buf_clients.obj-code = x_obj-grp-obj-price.obj-code AND       buf_clients.obj-type = x_obj-grp-obj-price.obj-type .
     3284     end.
     3285     when "buf_clients.obj-code"  then do:
     3286       OPEN QUERY BROWSE-5all  FOR EACH x_obj-grp-obj-price OF buf_grp-obj-price      WHERE ( r-status = 2 OR x_obj-grp-obj-price.stts =  r-status )       NO-LOCK ,            FIRST buf_clients NO-LOCK WHERE       buf_clients.obj-code = x_obj-grp-obj-price.obj-code AND       buf_clients.obj-type = x_obj-grp-obj-price.obj-type by buf_clients.obj-code.
     3287     end.
     3288     when "buf_clients.obj-name"  then do:
     3289       OPEN QUERY BROWSE-5all  FOR EACH x_obj-grp-obj-price OF buf_grp-obj-price      WHERE ( r-status = 2 OR x_obj-grp-obj-price.stts =  r-status )       NO-LOCK ,            FIRST buf_clients NO-LOCK WHERE       buf_clients.obj-code = x_obj-grp-obj-price.obj-code AND       buf_clients.obj-type = x_obj-grp-obj-price.obj-type by buf_clients.obj-name.
     3290     end.
     3291     when "buf_clients.host-code"  then do:
     3292       OPEN QUERY BROWSE-5all  FOR EACH x_obj-grp-obj-price OF buf_grp-obj-price      WHERE ( r-status = 2 OR x_obj-grp-obj-price.stts =  r-status )       NO-LOCK ,            FIRST buf_clients NO-LOCK WHERE       buf_clients.obj-code = x_obj-grp-obj-price.obj-code AND       buf_clients.obj-type = x_obj-grp-obj-price.obj-type by buf_clients.host-code.
     3293     end.
     3294     when "buf_clients.db-num"  then do:
     3295       OPEN QUERY BROWSE-5all  FOR EACH x_obj-grp-obj-price OF buf_grp-obj-price      WHERE ( r-status = 2 OR x_obj-grp-obj-price.stts =  r-status )       NO-LOCK ,            FIRST buf_clients NO-LOCK WHERE       buf_clients.obj-code = x_obj-grp-obj-price.obj-code AND       buf_clients.obj-type = x_obj-grp-obj-price.obj-type by buf_clients.db-num.
     3296     end.
     3297     when "x_obj-grp-obj-price.stts"  then do:
     3298       OPEN QUERY BROWSE-5all  FOR EACH x_obj-grp-obj-price OF buf_grp-obj-price      WHERE ( r-status = 2 OR x_obj-grp-obj-price.stts =  r-status )       NO-LOCK ,            FIRST buf_clients NO-LOCK WHERE       buf_clients.obj-code = x_obj-grp-obj-price.obj-code AND       buf_clients.obj-type = x_obj-grp-obj-price.obj-type by x_obj-grp-obj-price.stts.
     3299     end.
     3300    end case.
     3301   END PROCEDURE.
     3302   PROCEDURE proc-add-db :
     3303   define input  parameter p-recid-db as recid no-undo .
     3304   define input  parameter p-db-num  as integer   no-undo .
     3305   define input  parameter p-id     as integer   no-undo .
     3306   define input  parameter p-name as character no-undo .
     3307   define input-output parameter p-recid as recid no-undo .
     3308   define buffer buf_db for ub.db  .
     3309   find buf_db no-lock where recid(buf_db) = p-recid-db no-error .
     3310   run obji-ADD (
     3311    input  p-db-num        ,
     3312    input  p-id            ,
     3313    input  buf_db.db-num    ,
     3314    input  0               ,
     3315    input  v-cntxt-db-num  ,
     3316    input  v-cntxt-userid  ,
     3317    output p-recid ) .
     3318   END PROCEDURE.
     3319   PROCEDURE proc-add-firm :
     3320   define input  parameter p-firm as CHAR no-undo .
     3321   define input  parameter p-db-num  as integer   no-undo .
     3322   define input  parameter p-id     as integer   no-undo .
     3323   define input  parameter p-name as character no-undo .
     3324   define input-output parameter p-recid as recid no-undo .
     3325   define variable v-i as integer   no-undo .
     3326   define variable v-nn as integer   no-undo .
     3327   v-nn = num-entries(p-firm) .
     3328   repeat v-i = 1 to v-nn :
     3329       run objf-ADD (
     3330       input  p-db-num        ,
     3331       input  p-id            ,
     3332       input  integer(entry(v-i , p-firm ))   ,
     3333       input  0               ,
     3334       input  v-cntxt-db-num  ,
     3335       input  v-cntxt-userid  ,
     3336       output p-recid ) .
     3337   end.
     3338   END PROCEDURE.
     3339   PROCEDURE ver-stts :
     3340   define input  parameter p-gop-db-num as integer   no-undo .
     3341   define input  parameter p-gop-id     as integer   no-undo .
     3342   define input  parameter p-obj-code   as integer   no-undo .
     3343   define input  parameter p-obj-type   as character no-undo .
     3344   define output parameter p-stts       as integer   no-undo .
     3345   define variable v-1 as logical   no-undo init false .
     3346   define variable v-2 as logical   no-undo init false.
     3347   define variable v-3 as logical   no-undo init false.
     3348   define buffer buf_CLIENTS for ub.clients  .
     3349   find first buf_clients no-lock where
     3350               buf_clients.obj-type = p-obj-type and
     3351               buf_clients.obj-code = p-obj-code
     3352                no-error .
     3353   define buffer buf_db-grp-obj-price for ub.db-grp-obj-price  .
     3354     find first buf_db-grp-obj-price no-lock where
     3355                buf_db-grp-obj-price.gop-db-num = p-gop-db-num  and
     3356                buf_db-grp-obj-price.gop-id     = p-gop-id      and
     3357                buf_db-grp-obj-price.dgo-db-num    = buf_clients.db-num   and
     3358                buf_db-grp-obj-price.stts       = 0  no-error .
     3359   if available buf_db-grp-obj-price then v-1 = true .
     3360   define buffer buf_host-grp-obj-price for ub.host-grp-obj-price  .
     3361      find first buf_host-grp-obj-price no-lock where
     3362                 buf_host-grp-obj-price.gop-db-num = p-gop-db-num  and
     3363                 buf_host-grp-obj-price.gop-id     = p-gop-id      and
     3364                 buf_host-grp-obj-price.host-code  = buf_clients.host-code  and
     3365                 buf_host-grp-obj-price.stts       = 0  no-error .
     3366    if available buf_host-grp-obj-price then v-2 = true .
     3367   define buffer buf_obj-grp-obj-price for ub.obj-grp-obj-price  .
     3368     find first buf_obj-grp-obj-price no-lock where
     3369                buf_obj-grp-obj-price.gop-db-num = p-gop-db-num  and
     3370                buf_obj-grp-obj-price.gop-id     = p-gop-id      and
     3371                buf_obj-grp-obj-price.obj-code   = buf_clients.obj-code    and
     3372                buf_obj-grp-obj-price.obj-type   = buf_clients.obj-type    and
     3373                buf_obj-grp-obj-price.stts       = 0  no-error .
     3374   if available buf_obj-grp-obj-price then v-3 = true .
     3375   if v-1 or v-2 or  v-3  then p-stts = 0 .
     3376                          else p-stts = 1 .
     3377   END PROCEDURE.
     3378   PROCEDURE select_one :
     3379   define buffer bufl_grp-obj-price for ub.grp-obj-price  .
     3380   find first bufl_grp-obj-price no-lock  where recid(bufl_grp-obj-price) = int(p-rec-list) no-error .
     3381   if error-status :error then return .
     3382     g-find = true  .
     3383     F-obj = bufl_grp-obj-price.name-group .
     3384     tt-grp-obj = string(bufl_grp-obj-price.gop-id ) + ";"  + string (bufl_grp-obj-price.gop-db-num) .
     3385     display F-obj  with frame Dialog-Frame .
     3386     OPEN QUERY BROWSE-1grp FOR EACH buf_grp-obj-price WHERE     ( r-status = 2 OR buf_grp-obj-price.stts =  r-status ) AND     ( g-find = NO OR       LOOKUP (string(buf_grp-obj-price.gop-id) + ";"  + string(buf_grp-obj-price.gop-db-num)  ,        tt-grp-obj ) > 0 )                .
     3387     OPEN QUERY BROWSE-2db FOR EACH buf_db-grp-obj-price OF buf_grp-obj-price      WHERE ( r-status = 2 OR buf_db-grp-obj-price.stts =  r-status )       NO-LOCK INDEXED-REPOSITION.
     3388     OPEN QUERY BROWSE-3frm FOR EACH buf_host-grp-obj-price OF buf_grp-obj-price      WHERE ( r-status = 2 OR buf_host-grp-obj-price.stts =  r-status )       NO-LOCK ,            FIRST host-name NO-LOCK WHERE       host-name.obj-code = buf_host-grp-obj-price.host-code AND       host-name.obj-type = 'орг':U     INDEXED-REPOSITION.
     3389     OPEN QUERY BROWSE-4obj FOR EACH buf_obj-grp-obj-price OF buf_grp-obj-price      WHERE ( r-status = 2 OR buf_obj-grp-obj-price.stts =  r-status )       NO-LOCK,            FIRST buf_obj-name NO-LOCK WHERE       buf_obj-name.obj-code = buf_obj-grp-obj-price.obj-code AND       buf_obj-name.obj-type = buf_obj-grp-obj-price.obj-type     INDEXED-REPOSITION.
     3390     OPEN QUERY BROWSE-5all FOR EACH x_obj-grp-obj-price OF buf_grp-obj-price      WHERE ( r-status = 2 OR x_obj-grp-obj-price.stts =  r-status )       NO-LOCK ,            FIRST buf_clients NO-LOCK WHERE       buf_clients.obj-code = x_obj-grp-obj-price.obj-code AND       buf_clients.obj-type = x_obj-grp-obj-price.obj-type        .
     3391   END PROCEDURE.
