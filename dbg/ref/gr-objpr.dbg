     1166       ,input  v-cntxt-obj-type
     1167       ,input  v-cntxt-obj-code
     1168       ,input  0
     1169       ,input  0
     1170       ,input  0
     1171       ,input  true
     1172       ,output g#log
     1173       )  .
     1174   end.
     1175     if not g#log then return .
     1176   define variable v-rec-id as recid no-undo .
     1177   if not available buf_grp-obj-price then return .
     1178     if v-cntxt-db-num <> 0 then do :
     1179       if buf_grp-obj-price.gop-db-num <> v-cntxt-db-num then do:
     1180         message substitute(" Группа создана в другой БД (&1) , корректировать ее в текущей БД нельзя !" , buf_grp-obj-price.gop-db-num ) .
     1181         return .
     1182       end.
     1183     end.
     1184   if buf_grp-obj-price.stts <> 0 then do:
     1185      message "В эту группу добавлять БД нельзя!" view-as alert-box error .
     1186      return .
     1187   end.
     1188   DEFINE VARIABLE p-db-recid AS RECID NO-UNDO.
     1189   run adm/dbs.w (
     1190                 input parparentproc
     1191                ,input 'ПРОСМОТР':U
     1192                ,OUTPUT p-db-recid) .
     1193   if p-db-recid = ? then return no-apply .
     1194   run proc-add-db (
     1195         input p-db-recid   ,
     1196         input buf_grp-obj-price.gop-db-num ,
     1197         input buf_grp-obj-price.gop-id     ,
     1198         input buf_grp-obj-price.name-group ,
     1199         input-output v-rec-id ) .
     1200   run init-5obj.
     1201     OPEN QUERY BROWSE-2db FOR EACH buf_db-grp-obj-price OF buf_grp-obj-price      WHERE ( r-status = 2 OR buf_db-grp-obj-price.stts =  r-status )       NO-LOCK INDEXED-REPOSITION.
     1202     reposition BROWSE-2db to recid v-rec-id no-error .
     1203   END.
