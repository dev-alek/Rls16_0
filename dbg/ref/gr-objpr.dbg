      314   procedure thobjs :
      315      define input        parameter parparentproc     as widget-handle no-undo .
      316      define input        parameter i-bttns           as character     no-undo .
      317      define input        parameter i-list-mode       as character     no-undo.
      318      define input        parameter i-obj-type        as character     no-undo.
      319      define input        parameter i-db-num          as integer       no-undo.
      320      define input        parameter i-host-code       as integer       no-undo.
      321      define input-output parameter p-rid-list        as character     no-undo .
      322   run ref/thobjs.p
      323           ( input parparentproc
      324            ,input  this-procedure :handle
      325           , input i-bttns
      326           , input i-list-mode
      327           , input i-obj-type
      328           , input i-db-num
