     1292   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1293   run userobjs_clear in this-procedure  .
     1294     define variable v-user-select as logical   no-undo .
     1295   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1296   run userobjs_select-many in this-procedure
     1297     (input  parparentproc
     1298     ,input  v-cntxt-db-num
     1299     ,input  v-cntxt-userid
     1300     ,input  v-cntxt-host-code-obj
     1301     ,input  v-cntxt-obj-type
