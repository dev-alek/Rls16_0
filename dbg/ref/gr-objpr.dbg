     1523   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
     1524   DO:
     1525       if available buf_grp-obj-price then do:
     1526   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1527   define variable v-str-recid17 as character no-undo .
     1528   define variable v-num-entry17 as integer   no-undo .
     1529   assign
     1530     v-str-recid17 = trim( string( recid( buf_grp-obj-price ) , "->>>>>>>>>>>9":U ) )
     1531     v-num-entry17 = lookup( v-str-recid17 , p-rec-list )
     1532   .
     1533   if v-num-entry17 > 0 then do:
     1534     assign
     1535       entry( v-num-entry17, p-rec-list ) = "":U
     1536       p-rec-list = trim( replace( p-rec-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1537     .
     1538   end.
     1539   else do:
     1540     assign
     1541       p-rec-list = p-rec-list + ( if p-rec-list = "":U then "":U else chr(44) ) + v-str-recid17
     1542     .
     1543   end.
     1544           g-log = browse-1grp:refresh() .
     1545         if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
     1546             g-log = browse-1grp:select-next-row ().
     1547             apply "VALUE-CHANGED" to browse-1grp in frame Dialog-Frame.
     1548         end.
     1549       end.
     1550       apply "display" to browse-1grp in frame Dialog-Frame.
     1551   END.
