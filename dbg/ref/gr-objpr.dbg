      638   define input  parameter p-db-num-usr   as integer   no-undo .
      639   define input  parameter p-userid       as character no-undo .
      640     do
      641     on error undo, return error return-value
      642     :
      643   find first ub.grp-obj-price exclusive-lock where
      644           ub.grp-obj-price.gop-db-num   = p-db-num  and
      645           ub.grp-obj-price.gop-id       = p-id
      646           .
      647   find first ub.db-grp-obj-price exclusive-lock where
      648           ub.db-grp-obj-price.gop-db-num   = p-db-num  and
      649           ub.db-grp-obj-price.gop-id       = p-id      and
      650           ub.db-grp-obj-price.dgo-db-num = p-dgo-db-num
      651           no-error .
