      332   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      333   define variable v-waitfram-action01         as character   no-undo .
      334   define variable v-waitfram-action02         as character   no-undo .
      335   define variable v-waitfram-action03         as character   no-undo .
      336   define variable mWaitFramTextBeg            as character   no-undo.
      337   define variable mWaitFramTextEnd            as character   no-undo.
      338   define variable mWaitFramView               as logical     no-undo.
      339   define variable mWaitProcEvent              as logical     no-undo init yes.
      340   define variable mWaitFramInterval           as integer     no-undo init 1 .
      341   define variable mWaitFramStop               as logical     no-undo.
      342   define variable mWaitFramStopUser           as logical     no-undo.
      343   define variable mWaitFramStopTimeOut        as logical     no-undo.
      344   define variable mWaitFramStartProc          as datetime-tz no-undo.
      345   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      346   define button B-WaitFramStop auto-end-key
      347        label "Стоп"
      348        size 10 by 1 tooltip "Остоновить процесс".
      349   define button B-viewProcInfo
      350        label "Информация"
      351        size 15 by 1 tooltip "Информация о процесс".
      352   define frame waitfram
      353     v-waitfram-action01 format "x(72)" no-label skip
      354     v-waitfram-action02 format "x(72)" no-label skip
      355     v-waitfram-action03 format "x(72)" no-label skip
      356     B-viewProcInfo
      357     B-WaitFramStop at row 4 col 30
      358     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      359     .
      360   define new global shared variable mBatchMode as logical no-undo init ?.
      361   define variable mFramBachModHandle as handle no-undo.
      362   mFramBachModHandle = frame waitfram:handle.
      363   define variable mFameOldVis as logical no-undo.
      364   define variable mVisCUrentVin as logical no-undo.
      365   if session:batch-mode
      366   then
      367      mBatchMode = yes.
      368   if mBatchMode = ? then do:
      369     mVisCUrentVin = current-window:visible.
      370     mFameOldVis = mFramBachModHandle:visible.
      371     mFramBachModHandle:visible  = yes.
      372     mBatchMode = mFramBachModHandle:visible ne yes.
      373     mFramBachModHandle:visible = mFameOldVis.
      374     current-window:visible = mVisCUrentVin.
      375   end.
      376    if  log-manager:logfile-name ne ?
      377     then DO:
      378         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      379         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      380         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      381     end.
      382   on choose of B-WaitFramStop in frame waitfram
      383   do:
      384     mWaitFramStop = yes.
      385     mWaitFramStopUser = yes.
      386   end.
      387   function waitfram-check-timeout returns logical():
      388      define variable vtime as int64 no-undo.
      389      if mWaitFramStopTimeOut
      390      then
      391         return yes.
      392      vtime = ( now - mWaitFramStartProc ) / 1000 .
      393      if     mWaitFramTimeOut ne ?
      394         and mWaitFramTimeOut ne 0
      395         and mWaitFramTimeOut lt vtime
      396      then do:
      397         mWaitFramStopTimeOut = yes.
      398      end.
      399      return mWaitFramStopTimeOut.
      400   end.
      401   procedure waitfram-hide :
      402     if not session:batch-mode
      403     then do
      404     on error undo, return error return-value
      405     :
      406       pause 0 before-hide .
      407       if not mBatchMode then
      408         hide frame waitfram .
      409     if     not mWaitFramView
      410        and mWaitProcEvent
      411     then
      412       process events .
      413     end.
      414   end procedure.
      415   procedure waitfram-show :
      416     define input  parameter p-message as character no-undo .
      417     define variable v-left-margin as integer   no-undo .
      418     if not session:batch-mode
      419     then do
      420     on error undo, return error return-value
      421     :
      422       if length(p-message) <= 70 then do:
      423         assign
      424           v-left-margin = integer((70 - length(p-message)) / 2)
      425         .
      426         assign
      427           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      428         .
      429         assign
      430           v-waitfram-action01 = " "
      431           v-waitfram-action02 = " "
      432                                    + fill(" ", v-left-margin)
      433                                    + p-message
      434           v-waitfram-action03 = " "
      435         .
      436       end.
      437       else do:
      438         define variable vRindex1 as integer no-undo.
      439         define variable vRindex2 as integer no-undo.
      440         vRindex1 = r-index(p-message," ",70).
      441         if vRindex1 = 0
      442         then
      443            vRindex1 = 70.
      444         if length(p-message)  <= vRindex1 + 70 then do:
      445           assign
      446             v-waitfram-action01 = " "
      447             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      448             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      449           .
      450         end.
      451         else do:
      452           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      453           if vRindex2 <= vRindex1
      454           then
      455              vRindex2 = vRindex1 + 70.
      456           assign
      457             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      458             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      459             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      460           .
      461         end.
      462       end.
      463       B-viewProcInfo:visible   in frame waitfram = no.
      464       B-viewProcInfo:sensitive in frame waitfram = no.
      465       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      466       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      467       if  (   mWaitFramView
      468          or  mWaitProcEvent)
      469          and not mBatchMode
      470       then
      471          display
      472             v-waitfram-action01 skip
      473             v-waitfram-action02 skip
      474             v-waitfram-action03 skip
      475          with frame waitfram .
      476       if     mWaitFramView
      477          then do:
      478             if     mWaitFramInterval ne ?
      479                and not mBatchMode
      480             then
      481                wait-for go of frame waitfram pause mWaitFramInterval.
      482          end.
      483          else
      484             if     mWaitProcEvent
      485                and not mBatchMode
      486             then
      487                process events .
      488     end.
      489   end procedure.
      490      procedure waitfram-show-this:
      491         define input  parameter iInterval as int64 no-undo.
      492         define variable vtime as int64 no-undo.
      493         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      494         mWaitFramInterval = iInterval.
      495         run waitfram-show (substitute("&1&2 &3&4" ,
      496                                       mWaitFramTextBeg ,
      497                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      498                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      499                                       mWaitFramTextEnd
      500                                      )
      501                           ).
      502      end.
      503      procedure WaitFramRunPause:
      504         define input  parameter iInterval as dec no-undo.
      505         define variable vStart  as datetime-tz no-undo.
      506         define variable vend    as datetime-tz no-undo.
      507         define variable vint as int64 no-undo.
      508         define variable vOk as logical no-undo.
      509         vStart = now.
      510         vend   = vStart.
      511         publish "WaitFramPause" (iInterval,output vOk).
      512         vend   =  now.
      513         vint = vend - vStart.
      514         vint = iInterval - vint / 1000.
      515         if     not mWaitFramStop
      516            and (   vint > 0
      517                 or (    not vOk
      518                     and iInterval eq ?
      519                     )
      520                 )
      521         then
      522            run waitfram-show-this (iInterval).
      523         vend   =  now.
      524         vint = vend - vStart.
      525         vint = iInterval - vint / 1000.
      526         if     not mWaitFramStop
      527            and vint > 0
      528         then do:
      529            run gbl/pause.p (vint * 1000).
      530         end.
      531         if iInterval ne ?
      532         then
      533            publish "WaitFramStop".
      534         waitfram-check-timeout().
      535      end.
      536      procedure WaitFramWaitFor:
      537         define input  parameter iInterval as dec no-undo.
      538         assign
      539            mWaitFramStartProc   = now
      540            mWaitFramStopUser    = no
      541            mWaitFramStopTimeOut = no
      542         .
      543         block-wait:
      544         do while not mWaitFramStop:
      545            run WaitFramRunPause (iInterval).
      546            if  waitfram-check-timeout()
      547            then do:
      548               leave block-wait.
      549            end.
      550         end.
      551         run waitfram-hide.
      552      end.
      553   procedure waitfram-join :
      554     define input  parameter p-line-1  as character no-undo .
      555     define input  parameter p-line-2  as character no-undo .
      556     define input  parameter p-line-3  as character no-undo .
      557     define output parameter p-message as character no-undo .
      558     do
      559     on error undo, return error return-value
      560     :
      561       assign
      562         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      563                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      564                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      565       .
      566     end.
      567   end procedure.
      568   function waitfram-join-function returns character
      569     (input p-line-1 as character
      570     ,input p-line-2 as character
      571     ,input p-line-3 as character
      572     ).
      573     define variable v-message as character no-undo .
      574     run waitfram-join in this-procedure
      575       (input  p-line-1
      576       ,input  p-line-2
      577       ,input  p-line-3
      578       ,output v-message
      579       ) .
      580     return v-message .
      581   end function .
      582   define variable v-sec as integer   no-undo .
      583   PROCEDURE obji-add :
      584   define input  parameter p-db-num       as integer   no-undo .
      585   define input  parameter p-id           as integer   no-undo .
      586   define input  parameter p-dgo-db-num   as integer   no-undo .
      587   define input  parameter p-stts         as integer   no-undo .
      588   define input  parameter p-db-num-usr   as integer   no-undo .
      589   define input  parameter p-userid       as character no-undo .
      590   define output parameter p-recid as recid no-undo .
      591     do
      592     on error undo, return error return-value
      593     :
      594   find first ub.grp-obj-price exclusive-lock where
      595           ub.grp-obj-price.gop-db-num   = p-db-num  and
      596           ub.grp-obj-price.gop-id       = p-id
      597           no-error .
      598     if error-status :error then do:
      599         message
      600           vss-workfile vss-revision vss-description skip
      601           error-status :get-message(1) skip
      602           return-value skip
      603           ""
      604           view-as alert-box error
      605         .
      606         return error .
      607     end.
      608   find first ub.db-grp-obj-price exclusive-lock where
      609           ub.db-grp-obj-price.gop-db-num   = p-db-num  and
      610           ub.db-grp-obj-price.gop-id       = p-id      and
      611           ub.db-grp-obj-price.dgo-db-num   = p-dgo-db-num
      612           no-error .
      613         if not available ub.db-grp-obj-price then do:
      614             create ub.db-grp-obj-price.
      615               assign
      616                   ub.db-grp-obj-price.gop-db-num = p-db-num
      617                   ub.db-grp-obj-price.gop-id     = p-id
      618                   ub.db-grp-obj-price.dgo-db-num = p-dgo-db-num
      619               .
      620         end.
      621         assign
      622           ub.db-grp-obj-price.num-chg    = p-db-num-usr
      623           ub.db-grp-obj-price.stts          = p-stts
      624           ub.db-grp-obj-price.sys-date      = today
      625           ub.db-grp-obj-price.sys-time      = time
      626           ub.db-grp-obj-price.sys-time-chr  = string ( ub.db-grp-obj-price.sys-time,"hh:mm" )
      627           ub.db-grp-obj-price.who           = p-userid
      628           p-recid = recid ( ub.db-grp-obj-price )
      629         .
      630         ub.grp-obj-price.sys-time = time .
      631         run ref/h-grpo.p (buffer ub.db-grp-obj-price , input-output v-sec )  .
      632     end.
      633   end procedure.
      634   PROCEDURE obji-del :
      635   define input  parameter p-db-num       as integer   no-undo .
      636   define input  parameter p-id           as integer   no-undo .
