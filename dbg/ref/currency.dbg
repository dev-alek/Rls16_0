      343   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      344     define variable v-cntxt-db-num        as integer   no-undo .
      345     define variable v-cntxt-userid        as character no-undo .
      346     define variable v-cntxt-level         as character no-undo .
