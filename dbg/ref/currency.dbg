      762   THEN CURRENT-WINDOW:WINDOW-STATE = WINDOW-NORMAL.
      763   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      764   on help of frame d-currency
      765   do:
      766     run gbl/app_help.p
      767       (input this-procedure :file-name
      768       ,input ''
      769       ,input ?
      770       ) no-error.
      771     if error-status :error then do:
      772       message
      773         "Ошибка при вызове помощи"
      774         error-status :get-message(1)
      775         view-as alert-box .
      776     end.
      777   end.
      778   run minbtn-set in this-procedure .
      779   on choose of b-help in frame d-currency
      780   do:
      781     apply "help":u to frame d-currency .
      782   end.
      783   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      784   procedure minbtn-set :
      785       do
      786           on error undo, return error return-value
      787           :
      788           define variable ii              as integer       no-undo .
      789           define variable fh              as widget-handle no-undo .
      790           define variable hh              as widget-handle no-undo .
      791           define variable v-h             as handle        extent 4 no-undo .
      792           define variable v-name-button   as character     no-undo .
      793           define variable v-help-old-x    as decimal       no-undo .
      794           define variable v-help-old-y    as decimal       no-undo .
      795           define variable v-help-old-size as decimal       no-undo .
      796           define variable v-frame-width   as decimal       no-undo .
      797           define variable jj              as integer       no-undo .
      798           do
      799               on error undo, return error
      800               :
      801               assign
      802                   v-frame-width = frame d-currency:width - 0.3
      803                   fh            = frame d-currency:first-child
      804                   hh            = fh:first-child
      805                   ii            = 1
      806                   .
      807               do while valid-handle(hh):
      808                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      809                   do:
      810                       case lc(hh:name) :
      811                           when "b-help" then
      812                               do:
      813                                   hh:load-image-up("cmp/b-help.bmp":u) .
      814                                   hh:load-image-down("cmp/b-help.bmp":u) .
      815                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      816                                   hh:TOOLTIP = "Помощь" .
      817                                   v-help-old-x = hh:column .
      818                                   v-help-old-y = hh:row    .
      819                                   v-help-old-size = hh:width .
      820                                   hh:width-chars = 2.5 .
      821                               end.
      822                           when "b-print" then
      823                               do:
      824                                   hh:load-image("cmp/b-print.bmp":u) .
      825                                   hh:TOOLTIP = "Печать" .
      826                                   v-h[ii] = hh:handle .
      827                                   ii = ii + 1 .
      828                                   hh:width-chars = 3 .
      829                               end.
      830                           when "b-history" or
      831                           when "b-hist" then
      832                               do:
      833                                   hh:load-image("cmp/b-hist.bmp":u) .
      834                                   hh:TOOLTIP = "История" .
      835                                   v-h[ii] = hh:handle .
      836                                   ii = ii + 1 .
      837                                   hh:width-chars = 3 .
      838                               end.
      839                           when "b-sch" then
      840                               do:
      841                                   hh:load-image("cmp/b-sch.bmp":u) .
      842                                   hh:TOOLTIP = "Установка Фильтра" .
      843                                   v-h[ii] = hh:handle .
      844                                   ii = ii + 1 .
      845                                   hh:width-chars = 3 .
      846                               end.
      847                           when "b-hist-user" then
      848                               do:
      849                                   hh:load-image("cmp/b-hist.bmp":u) .
      850                                   hh:TOOLTIP = "История пользователя" .
      851                                   ii = ii + 1 .
      852                               end.
      853                       end case.
      854                   end.
      855                   hh = hh:next-sibling.
      856               end.
      857               b-help:column = v-frame-width - b-help:width-chars.
      858               jj = 0.
      859               repeat ii = 4 to 1 by -1 :
      860                   if valid-handle (v-h[ii] ) then
      861                   do:
      862                       jj  = jj + 1 .
      863                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      864                       v-h[ii]:row    = v-help-old-y .
      865                   end.
      866               end.
      867           end.
      868       end.
      869   end procedure.
      870   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      871   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      872   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      873   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      874   define variable v-diasize-current-frame-width  as decimal   no-undo .
      875   define variable v-diasize-current-frame-height as decimal   no-undo .
      876   define variable v-diasize-change-size          as logical   no-undo .
      877   define variable v-diasize-resize-button        as handle    no-undo .
      878   define variable v-diasize-wndmax               as logical   no-undo .
      879   define variable v-diasize-wndstore             as logical   no-undo .
      880   define variable v-diasize-proc-name            as character no-undo .
      881   define variable v-diasize-browse-handle        as handle    no-undo .
      882   define variable v-diasize-browse-number        as integer   no-undo .
      883   define variable v-diasize-need-full-display    as logical   no-undo init false .
      884   define temp-table temp-diasize-handle no-undo
      885     field handle-value  as handle
      886     field save-position as decimal
      887     index xpk is primary unique handle-value
      888     .
      889   define temp-table temp-browse-handle no-undo
      890     field browse-type   as character
      891     field browse-number as integer
      892     field browse-handle as handle
      893     field original-size as decimal
      894     index xpk is primary unique browse-type browse-number
      895     index xie browse-type browse-handle
      896   .
      897   procedure diasize_change-height :
      898     define input  parameter p-change-value  as decimal   no-undo .
      899     define input  parameter p-move-resize   as logical   no-undo .
      900     define variable v-field-group-handle    as handle    no-undo .
      901     define variable v-object-handle         as handle    no-undo .
      902     define variable v-frame-height          as decimal   no-undo .
      903     define variable v-frame-virtual-height  as decimal   no-undo .
      904     define variable v-browse-height         as decimal   no-undo .
      905     define variable v-window-height         as decimal   no-undo .
      906     define variable v-window-virtual-height as decimal   no-undo .
      907     define variable v-change-sign           as integer   no-undo .
      908     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      909     define buffer buf_temp-browse-handle  for temp-browse-handle .
      910     if p-change-value > 0
      911     then do:
      912       if frame d-currency :height + p-change-value
      913           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      914       then do:
      915         assign
      916           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      917                           - (frame d-currency :height-chars)
      918         .
      919         if p-change-value <= 0
      920         then do:
      921           run diasize_position-resize-button in this-procedure .
      922           return .
      923         end.
      924       end.
      925     end.
      926     if p-change-value < 0
      927     then do:
      928       if frame d-currency :height + p-change-value < v-diasize-orig-frame-height
      929       then do:
      930         assign
      931           p-change-value = v-diasize-orig-frame-height
      932                          - (frame d-currency :height-chars)
      933         .
      934         if p-change-value >= 0
      935         then do:
      936           run diasize_position-resize-button in this-procedure .
      937           return .
      938         end.
      939       end.
      940     end.
      941     if p-change-value >= 0
      942     then do:
      943       assign
      944         v-change-sign = 1
      945       .
      946     end.
      947     else do:
      948       assign
      949         v-change-sign = -1
      950       .
      951     end.
      952     assign
      953       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      954     .
      955     if p-change-value = 0
      956     then do:
      957       run diasize_position-resize-button in this-procedure .
      958       return .
      959     end.
      960     move_block:
      961     do
      962     on error undo move_block, retry move_block
      963     :
      964       if retry
      965       then do:
      966         do
      967         on error undo move_block, leave move_block
      968         :
      969           if p-change-value > 0
      970           then do:
      971             for each buf_temp-diasize-handle
      972             on error undo, next
      973             :
      974               assign
      975                 v-object-handle = buf_temp-diasize-handle.handle-value
      976               .
      977               if v-object-handle <> v-diasize-resize-button
      978               then do:
      979                 assign
      980                   v-object-handle :row = buf_temp-diasize-handle.save-position
      981                 .
      982               end.
      983             end.
      984             assign
      985               v-diasize-browse-handle :height = v-browse-height
      986             .
      987             for each buf_temp-browse-handle
      988               where buf_temp-browse-handle.browse-type = 'height':u
      989             on error undo, next
      990             :
      991               assign
      992                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      993               .
      994             end.
      995             assign
      996               frame d-currency :height = v-frame-height
      997             .
      998             if frame d-currency :scrollable = true
      999             then do:
     1000               assign
     1001                 frame d-currency :virtual-height = v-frame-virtual-height
     1002               .
     1003             end.
     1004             run diasize_position-resize-button in this-procedure .
     1005           end.
     1006           else do:
     1007             if frame d-currency :scrollable = true
     1008             then do:
     1009               assign
     1010                 frame d-currency :virtual-height = v-frame-virtual-height
     1011               .
     1012             end.
     1013             assign
     1014               frame d-currency :height = v-frame-height
     1015             .
     1016             assign
     1017               v-diasize-browse-handle :height = v-browse-height
     1018             .
     1019             for each buf_temp-browse-handle
     1020               where buf_temp-browse-handle.browse-type = 'height':u
     1021             on error undo, next
     1022             :
     1023               assign
     1024                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1025               .
     1026             end.
     1027             for each buf_temp-diasize-handle
     1028             on error undo, next
     1029             :
     1030               assign
     1031                 v-object-handle = buf_temp-diasize-handle.handle-value
     1032               .
     1033               if v-object-handle <> v-diasize-resize-button
     1034               then do:
     1035                 assign
     1036                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1037                 .
     1038               end.
     1039             end.
     1040             run diasize_position-resize-button in this-procedure .
     1041           end.
     1042           assign
     1043             v-diasize-change-size = false
     1044           .
     1045           leave move_block .
     1046         end.
     1047       end.
     1048       assign
     1049         v-diasize-need-full-display = true
     1050       .
     1051       if v-diasize-change-size = false
     1052       then do:
     1053         assign
     1054           v-diasize-change-size = true
     1055         .
     1056       end.
     1057       else do:
     1058         return .
     1059       end.
     1060       assign
     1061         v-frame-height = frame d-currency :height
     1062         v-frame-virtual-height = frame d-currency :virtual-height
     1063         v-browse-height = v-diasize-browse-handle :height
     1064       .
     1065       for each buf_temp-browse-handle
     1066         where buf_temp-browse-handle.browse-type = 'height':u
     1067       :
     1068         assign
     1069           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1070         .
     1071       end.
     1072       for each buf_temp-diasize-handle
     1073       :
     1074         delete buf_temp-diasize-handle .
     1075       end.
     1076       assign
     1077         v-field-group-handle = frame d-currency :first-child
     1078       .
     1079       do while valid-handle(v-field-group-handle)
     1080       :
     1081         assign
     1082           v-object-handle = v-field-group-handle :first-child
     1083         .
     1084         do while valid-handle(v-object-handle)
     1085         :
     1086           if  v-object-handle <> v-diasize-browse-handle :handle
     1087           and can-query(v-object-handle, "row")
     1088           and can-query(v-object-handle, "height")
     1089           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1090           then do:
     1091             find first buf_temp-browse-handle
     1092               where buf_temp-browse-handle.browse-type   = 'height':u
     1093                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1094               no-error .
     1095             if available buf_temp-browse-handle
     1096             then do:
     1097             end.
     1098             else do:
     1099               create buf_temp-diasize-handle .
     1100               assign
     1101                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1102                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1103               .
     1104             end.
     1105           end.
     1106           assign
     1107             v-object-handle = v-object-handle :next-sibling
     1108           .
     1109         end.
     1110         assign
     1111           v-field-group-handle = v-field-group-handle :next-sibling
     1112         .
     1113       end.
     1114       do with frame d-currency
     1115       :
     1116         hide v-diasize-resize-button .
     1117         assign
     1118           v-diasize-resize-button :row    = 1
     1119           v-diasize-resize-button :column = 1
     1120         .
     1121       end.
     1122       if p-change-value > 0
     1123       then do:
     1124         if frame d-currency :scrollable = true
     1125         then do:
     1126           assign
     1127             frame d-currency :virtual-height = frame d-currency :virtual-height + p-change-value
     1128             no-error .
     1129           if error-status :error
     1130           or error-status :get-message(1) <> ""
     1131           then do:
     1132             undo move_block, retry move_block .
     1133           end.
     1134         end.
     1135         assign
     1136           frame d-currency :height = frame d-currency :height + p-change-value
     1137           no-error .
     1138         if error-status :error
     1139         or error-status :get-message(1) <> ""
     1140         then do:
     1141           undo move_block, retry move_block .
     1142         end.
     1143         assign
     1144           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1145           no-error .
     1146         if error-status :error
     1147         or error-status :get-message(1) <> ""
     1148         then do:
     1149           undo move_block, retry move_block .
     1150         end.
     1151         for each buf_temp-browse-handle
     1152           where buf_temp-browse-handle.browse-type = 'height':u
     1153         on error undo move_block, retry move_block
     1154         :
     1155           assign
     1156             buf_temp-browse-handle.browse-handle :height
     1157               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1158             no-error .
     1159           if error-status :error
     1160           or error-status :get-message(1) <> ""
     1161           then do:
     1162             undo move_block, retry move_block .
     1163           end.
     1164         end.
     1165         for each buf_temp-diasize-handle
     1166         on error undo move_block, retry move_block
     1167         :
     1168           assign
     1169             v-object-handle = buf_temp-diasize-handle.handle-value
     1170           .
     1171           if v-object-handle <> v-diasize-resize-button
     1172           then do:
     1173             assign
     1174               v-object-handle :row = v-object-handle :row + p-change-value
     1175               no-error .
     1176             if error-status :error
     1177             or error-status :get-message(1) <> ""
     1178             then do:
     1179               undo move_block, retry move_block .
     1180             end.
     1181           end.
     1182         end.
     1183       end.
     1184       else do:
     1185         for each buf_temp-diasize-handle
     1186         on error undo move_block, retry move_block
     1187         :
     1188           assign
     1189             v-object-handle = buf_temp-diasize-handle.handle-value
     1190           .
     1191           if v-object-handle <> v-diasize-resize-button
     1192           then do:
     1193             assign
     1194               v-object-handle :row = v-object-handle :row + p-change-value
     1195               no-error .
     1196             if error-status :error
     1197             or error-status :get-message(1) <> ""
     1198             then do:
     1199               undo move_block, retry move_block .
     1200             end.
     1201           end.
     1202         end.
     1203         assign
     1204           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1205           no-error .
     1206         if error-status :error
     1207         or error-status :get-message(1) <> ""
     1208         then do:
     1209           undo move_block, retry move_block .
     1210         end.
     1211         for each buf_temp-browse-handle
     1212           where buf_temp-browse-handle.browse-type = 'height':u
     1213         on error undo move_block, retry move_block
     1214         :
     1215           assign
     1216             buf_temp-browse-handle.browse-handle :height
     1217               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1218             no-error .
     1219           if error-status :error
     1220           or error-status :get-message(1) <> ""
     1221           then do:
     1222             undo move_block, retry move_block .
     1223           end.
     1224         end.
     1225         assign
     1226           frame d-currency :height = frame d-currency :height + p-change-value
     1227           no-error .
     1228         if error-status :error
     1229         or error-status :get-message(1) <> ""
     1230         then do:
     1231           undo move_block, retry move_block .
     1232         end.
     1233         if frame d-currency :scrollable = true
     1234         then do:
     1235           assign
     1236             frame d-currency :virtual-height = frame d-currency :virtual-height + p-change-value
     1237             no-error .
     1238           if error-status :error
     1239           or error-status :get-message(1) <> ""
     1240           then do:
     1241             undo move_block, retry move_block .
     1242           end.
     1243         end.
     1244       end.
     1245       if p-move-resize = true
     1246       then do:
     1247         run diasize_position-resize-button in this-procedure .
     1248       end.
     1249       if v-diasize-wndstore = true
     1250       then do:
     1251         if connected("ub") = true
     1252         then do:
     1253           define variable v-cntxt-db-num        as integer   no-undo .
     1254           define variable v-cntxt-userid        as character no-undo .
     1255           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1256                                             , OUTPUT v-cntxt-userid
     1257                                             ) .
     1258           run gbl/wndsizew.p
     1259             (input  v-cntxt-db-num
     1260             ,input  v-cntxt-userid
     1261             ,input  v-diasize-proc-name
     1262             ,input  'height':u
     1263             ,input  string(frame d-currency :height - v-diasize-orig-frame-height)
     1264             ) .
     1265         end.
     1266       end.
     1267     end.
     1268     assign
     1269       v-diasize-change-size = false
     1270     .
     1271   end procedure.
     1272   procedure diasize_set-height :
     1273     define input  parameter p-new-height  as decimal   no-undo .
     1274     define input  parameter p-move-resize as logical   no-undo .
     1275     do
     1276     on error undo, return error return-value
     1277     :
     1278       run diasize_change-height in this-procedure
     1279         (input  (p-new-height - frame d-currency :height)
     1280         ,input  p-move-resize
     1281         ) .
     1282     end.
     1283   end procedure.
     1284   procedure diasize_change-width :
     1285     define input  parameter p-change-value as decimal   no-undo .
     1286     define input  parameter p-move-resize  as logical   no-undo .
     1287     define variable v-field-group-handle   as handle    no-undo .
     1288     define variable v-object-handle        as handle    no-undo .
     1289     define variable v-frame-width          as decimal   no-undo .
     1290     define variable v-frame-virtual-width  as decimal   no-undo .
     1291     define variable v-browse-width         as decimal   no-undo .
     1292     define variable v-window-width         as decimal   no-undo .
     1293     define variable v-window-virtual-width as decimal   no-undo .
     1294     define variable v-change-sign          as integer   no-undo .
     1295     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1296     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1297     if p-change-value > 0
     1298     then do:
     1299       if frame d-currency :width + p-change-value >
     1300           session :width-chars
     1301       then do:
     1302         assign
     1303           p-change-value = session :width-chars - frame d-currency :width
     1304         .
     1305         if p-change-value <= 0
     1306         then do:
     1307           run diasize_position-resize-button in this-procedure .
     1308           return .
     1309         end.
     1310       end.
     1311     end.
     1312     if p-change-value < 0
     1313     then do:
     1314       if frame d-currency :width + p-change-value < v-diasize-orig-frame-width
     1315       then do:
     1316         assign
     1317           p-change-value = v-diasize-orig-frame-width
     1318                          - frame d-currency :width
     1319         .
     1320         if p-change-value >= 0
     1321         then do:
     1322           run diasize_position-resize-button in this-procedure .
     1323           return .
     1324         end.
     1325       end.
     1326     end.
     1327     if p-change-value >= 0
     1328     then do:
     1329       assign
     1330         v-change-sign = 1
     1331       .
     1332     end.
     1333     else do:
     1334       assign
     1335         v-change-sign = -1
     1336       .
     1337     end.
     1338     assign
     1339       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1340     .
     1341     if p-change-value = 0
     1342     then do:
     1343       run diasize_position-resize-button in this-procedure .
     1344       return .
     1345     end.
     1346     move_block:
     1347     do
     1348     on error undo move_block, leave move_block
     1349     :
     1350       if retry
     1351       then do:
     1352         do
     1353         on error undo move_block, leave move_block
     1354         :
     1355           if p-change-value > 0
     1356           then do:
     1357             for each buf_temp-diasize-handle
     1358             on error undo, next
     1359             :
     1360               assign
     1361                 v-object-handle = buf_temp-diasize-handle.handle-value
     1362               .
     1363               if v-object-handle <> v-diasize-resize-button
     1364               then do:
     1365                 assign
     1366                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1367                 .
     1368               end.
     1369             end.
     1370             assign
     1371               v-diasize-browse-handle :width = v-browse-width
     1372             .
     1373             for each buf_temp-browse-handle
     1374               where buf_temp-browse-handle.browse-type = 'width':u
     1375             on error undo, next
     1376             :
     1377               assign
     1378                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1379               .
     1380             end.
     1381             assign
     1382               frame d-currency :width = v-frame-width
     1383             .
     1384             if frame d-currency :scrollable = true
     1385             then do:
     1386               assign
     1387                 frame d-currency :virtual-width = v-frame-virtual-width
     1388               .
     1389             end.
     1390             run diasize_position-resize-button in this-procedure .
     1391           end.
     1392           else do:
     1393             if frame d-currency :scrollable = true
     1394             then do:
     1395               assign
     1396                 frame d-currency :virtual-width = v-frame-virtual-width
     1397               .
     1398             end.
     1399             assign
     1400               frame d-currency :width = v-frame-width
     1401             .
     1402             for each buf_temp-browse-handle
     1403               where buf_temp-browse-handle.browse-type = 'width':u
     1404             on error undo, next
     1405             :
     1406               assign
     1407                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1408               .
     1409             end.
     1410             assign
     1411               v-diasize-browse-handle :width = v-browse-width
     1412             .
     1413             for each buf_temp-diasize-handle
     1414             on error undo, next
     1415             :
     1416               assign
     1417                 v-object-handle = buf_temp-diasize-handle.handle-value
     1418               .
     1419               if v-object-handle <> v-diasize-resize-button
     1420               then do:
     1421                 assign
     1422                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1423                 .
     1424               end.
     1425             end.
     1426             run diasize_position-resize-button in this-procedure .
     1427           end.
     1428           assign
     1429             v-diasize-change-size = false
     1430           .
     1431           leave move_block .
     1432         end.
     1433       end.
     1434       assign
     1435         v-diasize-need-full-display = true
     1436       .
     1437       if v-diasize-change-size = false
     1438       then do:
     1439         assign
     1440           v-diasize-change-size = true
     1441         .
     1442       end.
     1443       else do:
     1444         return .
     1445       end.
     1446       assign
     1447         v-frame-width = frame d-currency :width
     1448         v-frame-virtual-width = frame d-currency :virtual-width
     1449         v-browse-width = v-diasize-browse-handle :width
     1450       .
     1451       for each buf_temp-browse-handle
     1452         where buf_temp-browse-handle.browse-type = 'width':u
     1453       :
     1454         assign
     1455           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1456         .
     1457       end.
     1458       for each buf_temp-diasize-handle
     1459       :
     1460         delete buf_temp-diasize-handle .
     1461       end.
     1462       assign
     1463         v-field-group-handle = frame d-currency :first-child
     1464       .
     1465       do while valid-handle(v-field-group-handle)
     1466       :
     1467         assign
     1468           v-object-handle = v-field-group-handle :first-child
     1469         .
     1470         do while valid-handle(v-object-handle)
     1471         :
     1472           if  v-object-handle <> v-diasize-browse-handle :handle
     1473           and v-object-handle <> v-diasize-resize-button
     1474           and can-query(v-object-handle, "row")
     1475           and can-query(v-object-handle, "height")
     1476           and ( v-object-handle :col + v-object-handle :width
     1477                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1478               )
     1479           then do:
     1480             find first buf_temp-browse-handle
     1481               where buf_temp-browse-handle.browse-type   = 'width':u
     1482                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1483               no-error .
     1484             if available buf_temp-browse-handle
     1485             then do:
     1486             end.
     1487             else do:
     1488               create buf_temp-diasize-handle .
     1489               assign
     1490                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1491                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1492               .
     1493             end.
     1494           end.
     1495           assign
     1496             v-object-handle = v-object-handle :next-sibling
     1497           .
     1498         end.
     1499         assign
     1500           v-field-group-handle = v-field-group-handle :next-sibling
     1501         .
     1502       end.
     1503       do with frame d-currency
     1504       :
     1505         hide v-diasize-resize-button .
     1506         v-diasize-resize-button :row = 1.
     1507         v-diasize-resize-button :column = 1.
     1508       end.
     1509       if p-change-value > 0
     1510       then do:
     1511         if frame d-currency :scrollable = true
     1512         then do:
     1513           assign
     1514             frame d-currency :virtual-width = frame d-currency :virtual-width + p-change-value
     1515             no-error .
     1516           if error-status :error
     1517           or error-status :get-message(1) <> ""
     1518           then do:
     1519             undo move_block, retry move_block.
     1520           end.
     1521         end.
     1522         assign
     1523           frame d-currency :width = v-frame-width + p-change-value
     1524           no-error .
     1525         if error-status :error
     1526         or error-status :get-message(1) <> ""
     1527         then do:
     1528           undo move_block, retry move_block.
     1529         end.
     1530         assign
     1531           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1532         no-error .
     1533         if error-status :error
     1534         or error-status :get-message(1) <> ""
     1535         then do:
     1536           undo move_block, retry move_block.
     1537         end.
     1538         for each buf_temp-browse-handle
     1539           where buf_temp-browse-handle.browse-type = 'width':u
     1540         on error undo move_block, retry move_block
     1541         :
     1542           assign
     1543             buf_temp-browse-handle.browse-handle :width
     1544               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1545             no-error .
     1546           if error-status :error
     1547           or error-status :get-message(1) <> ""
     1548           then do:
     1549             undo move_block, retry move_block .
     1550           end.
     1551         end.
     1552         for each buf_temp-diasize-handle
     1553         on error undo move_block, retry move_block
     1554         :
     1555           assign
     1556             v-object-handle = buf_temp-diasize-handle.handle-value
     1557           .
     1558           if v-object-handle <> v-diasize-resize-button
     1559           then do:
     1560             assign
     1561               v-object-handle :col = v-object-handle :col + p-change-value
     1562               no-error .
     1563             if error-status :error
     1564             or error-status :get-message(1) <> ""
     1565             then do:
     1566               undo move_block, retry move_block .
     1567             end.
     1568           end.
     1569         end.
     1570       end.
     1571       else do:
     1572         for each buf_temp-diasize-handle
     1573         on error undo move_block, retry move_block
     1574         :
     1575           assign
     1576             v-object-handle = buf_temp-diasize-handle.handle-value
     1577           .
     1578           if v-object-handle <> v-diasize-resize-button
     1579           then do:
     1580             assign
     1581               v-object-handle :col = v-object-handle :col + p-change-value
     1582               no-error .
     1583             if error-status :error
     1584             or error-status :get-message(1) <> ""
     1585             then do:
     1586               undo move_block, retry move_block .
     1587             end.
     1588           end.
     1589         end.
     1590         for each buf_temp-browse-handle
     1591           where buf_temp-browse-handle.browse-type = 'width':u
     1592         on error undo move_block, retry move_block
     1593         :
     1594           assign
     1595             buf_temp-browse-handle.browse-handle :width
     1596               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1597             no-error .
     1598           if error-status :error
     1599           or error-status :get-message(1) <> ""
     1600           then do:
     1601             undo move_block, retry move_block .
     1602           end.
     1603         end.
     1604         assign
     1605           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1606           no-error .
     1607         if error-status :error
     1608         or error-status :get-message(1) <> ""
     1609         then do:
     1610           undo move_block, retry move_block.
     1611         end.
     1612         assign
     1613           frame d-currency :width = frame d-currency :width + p-change-value
     1614         no-error .
     1615         if error-status :error
     1616         or error-status :get-message(1) <> ""
     1617         then do:
     1618           undo move_block, retry move_block.
     1619         end.
     1620         if frame d-currency :scrollable = true
     1621         then do:
     1622           assign
     1623             frame d-currency :virtual-width = frame d-currency :virtual-width + p-change-value
     1624           no-error .
     1625           if error-status :error
     1626           or error-status :get-message(1) <> ""
     1627           then do:
     1628             undo move_block, retry move_block.
     1629           end.
     1630         end.
     1631       end.
     1632       if p-move-resize
     1633       then do:
     1634         run diasize_position-resize-button in this-procedure .
     1635       end.
     1636       if v-diasize-wndstore = true
     1637       then do:
     1638         if connected("ub") = true
     1639         then do:
     1640           define variable v-cntxt-db-num        as integer   no-undo .
     1641           define variable v-cntxt-userid        as character no-undo .
     1642           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1643                                             , OUTPUT v-cntxt-userid
     1644                                             ) .
     1645           run gbl/wndsizew.p
     1646             (input  v-cntxt-db-num
     1647             ,input  v-cntxt-userid
     1648             ,input  v-diasize-proc-name
     1649             ,input  'width':u
     1650             ,input  string(frame d-currency :width - v-diasize-orig-frame-width)
     1651             ) .
     1652         end.
     1653       end.
     1654     end.
     1655     assign
     1656       v-diasize-change-size = false
     1657     .
     1658   end procedure.
     1659   procedure diasize_set-width :
     1660     define input  parameter p-new-width  as decimal   no-undo .
     1661     define input  parameter p-move-resize as logical   no-undo .
     1662     do
     1663     on error undo, return error return-value
     1664     :
     1665       run diasize_change-width in this-procedure
     1666         (input  (p-new-width - frame d-currency :width)
     1667         ,input  p-move-resize
     1668         ) .
     1669     end.
     1670   end procedure.
     1671   procedure diasize_position-resize-button :
     1672     do with frame d-currency
     1673     :
     1674       hide v-diasize-resize-button .
     1675       assign
     1676         v-diasize-resize-button :row = frame d-currency :height - v-diasize-resize-button :height
     1677                     - 1
     1678                     - (frame d-currency :border-bottom-pixels / session :pixels-per-row)
     1679         v-diasize-resize-button :col = frame d-currency :width - v-diasize-resize-button :width
     1680                     - 1
     1681                     - (frame d-currency :border-right-pixels / session :pixels-per-column)
     1682       .
     1683       view v-diasize-resize-button .
     1684     end.
     1685   end procedure.
     1686   on alt-right anywhere
     1687   do:
     1688     run diasize_change-width in this-procedure
     1689       (input 1
     1690       ,input true
     1691       ) .
     1692     return no-apply .
     1693   end.
     1694   on alt-left anywhere
     1695   do:
     1696     run diasize_change-width in this-procedure
     1697       (input -1
     1698       ,input true
     1699       ) .
     1700     return no-apply .
     1701   end.
     1702   on alt-down anywhere
     1703   do:
     1704     run diasize_change-height in this-procedure
     1705       (input 1
     1706       ,input true
     1707       ) .
     1708     return no-apply .
     1709   end.
     1710   on alt-up anywhere
     1711   do:
     1712     run diasize_change-height in this-procedure
     1713       (input -1
     1714       ,input true
     1715       ) .
     1716     return no-apply .
     1717   end.
     1718   on alt-enter of frame d-currency
     1719   do:
     1720     run diasize_maximize in this-procedure
     1721       (input  ?
     1722       ).
     1723     return no-apply .
     1724   end.
     1725   procedure diasize_end-move :
     1726     do
     1727     on error undo, return error return-value
     1728     :
     1729       define variable v-row-delta as decimal   no-undo .
     1730       define variable v-col-delta as decimal   no-undo .
     1731       define variable v-new-row as decimal   no-undo .
     1732       define variable v-new-col as decimal   no-undo .
     1733       assign
     1734         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1735         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1736       .
     1737       assign
     1738         v-row-delta = v-new-row - frame d-currency :height
     1739         v-col-delta = v-new-col - frame d-currency :width
     1740       .
     1741       run diasize_change-height in this-procedure
     1742         (input v-row-delta
     1743         ,input true
     1744         ) .
     1745       run diasize_change-width in this-procedure
     1746         (input v-col-delta
     1747         ,input true
     1748         ) .
     1749     end.
     1750   end procedure.
     1751   procedure diasize_maximize :
     1752     define input  parameter p-action as logical   no-undo .
     1753     do
     1754     on error undo, return error return-value
     1755     :
     1756       if p-action = ?
     1757       then do:
     1758         if v-diasize-need-maximize = true
     1759         then do:
     1760           assign
     1761             p-action = true
     1762           .
     1763         end.
     1764         else do:
     1765           assign
     1766             p-action = false
     1767           .
     1768         end.
     1769       end.
     1770       if p-action = true
     1771       then do:
     1772         run diasize_change-height in this-procedure
     1773           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1774               - frame d-currency :height-chars
     1775           ,input true
     1776           ) .
     1777         run diasize_change-width in this-procedure
     1778           (input session :width-chars
     1779               - frame d-currency :width-chars
     1780           ,input true
     1781           ) .
     1782         assign
     1783           v-diasize-need-maximize = false
     1784         .
     1785       end.
     1786       else do:
     1787         run diasize_change-width in this-procedure
     1788           (input v-diasize-orig-frame-width
     1789               - frame d-currency :width-chars
     1790           ,input true
     1791           ) .
     1792         run diasize_change-height in this-procedure
     1793           (input v-diasize-orig-frame-height
     1794               - frame d-currency :height-chars
     1795           ,input true
     1796           ) .
     1797         assign
     1798           v-diasize-need-maximize = true
     1799         .
     1800       end.
     1801     end.
     1802   end procedure.
     1803   procedure diasize_restore-orig-size :
     1804     do
     1805     on error undo, return error return-value
     1806     :
     1807       assign
     1808         v-diasize-current-frame-width  = frame d-currency :width
     1809         v-diasize-current-frame-height = frame d-currency :height
     1810       .
     1811       run diasize_set-height in this-procedure
     1812         (input  v-diasize-orig-frame-height
     1813         ,input  true
     1814         ) .
     1815       run diasize_set-width in this-procedure
     1816         (input  v-diasize-orig-frame-width
     1817         ,input  true
     1818         ) .
     1819     end.
     1820   end procedure.
     1821   procedure diasize_restore-current-size :
     1822     do
     1823     on error undo, return error return-value
     1824     :
     1825       run diasize_set-height in this-procedure
     1826         (input  v-diasize-current-frame-height
     1827         ,input  true
     1828         ) .
     1829       run diasize_set-width in this-procedure
     1830         (input  v-diasize-current-frame-width
     1831         ,input  true
     1832         ) .
     1833     end.
     1834   end procedure.
     1835   procedure diasize_set-browse-handle :
     1836     define input  parameter p-browse-handle as handle   no-undo .
     1837     define buffer buf_temp-browse-handle for temp-browse-handle .
     1838     do
     1839     on error undo, return error return-value
     1840     :
     1841       assign
     1842         v-diasize-browse-handle = p-browse-handle
     1843       .
     1844       for each buf_temp-browse-handle
     1845       on error undo, return error return-value
     1846       :
     1847         delete buf_temp-browse-handle .
     1848       end.
     1849     end.
     1850   end procedure.
     1851   procedure diasize_add_browse :
     1852     define input  parameter p-browse-type   as character no-undo .
     1853     define input  parameter p-browse-handle as handle    no-undo .
     1854     define buffer buf_temp-browse-handle for temp-browse-handle .
     1855     do
     1856     on error undo, return error return-value
     1857     :
     1858       assign
     1859         v-diasize-browse-number = v-diasize-browse-number + 1
     1860       .
     1861       create buf_temp-browse-handle .
     1862       assign
     1863         buf_temp-browse-handle.browse-type   = p-browse-type
     1864         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1865         buf_temp-browse-handle.browse-handle = p-browse-handle
     1866       .
     1867     end.
     1868   end procedure.
     1869   procedure diasize_init :
     1870     define variable v-default-value    as logical   no-undo .
     1871     define variable v-restore-saved    as logical   no-undo .
     1872     define variable v-resize-value-str as character no-undo .
     1873     do
     1874     on error undo, return error return-value
     1875     :
     1876       do with frame d-currency
     1877       :
     1878         assign
     1879           v-diasize-orig-frame-height = frame d-currency :height
     1880           v-diasize-orig-frame-width  = frame d-currency :width
     1881           v-diasize-browse-handle     = browse br-currency :handle
     1882         .
     1883         create button v-diasize-resize-button
     1884         assign
     1885           parent        = frame d-currency :first-child
     1886           label         = "s"
     1887           height-pixels = 16
     1888           width-pixels  = 16
     1889           visible       = true
     1890           sensitive     = true
     1891           movable       = true
     1892           triggers:
     1893             on end-move persistent run diasize_end-move in this-procedure .
     1894           end triggers.
     1895         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1896         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1897         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1898         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1899         assign
     1900           v-diasize-wndmax = false
     1901         .
     1902         if connected("ub") = true
     1903         then do:
     1904           define variable v-cntxt-db-num        as integer   no-undo .
     1905           define variable v-cntxt-userid        as character no-undo .
     1906           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1907                                             , OUTPUT v-cntxt-userid
     1908                                             ) .
     1909           run gbl/wndpar_r.p
     1910             (input  v-cntxt-db-num
     1911             ,input  v-cntxt-userid
     1912             ,input  'wndmax':U
     1913             ,output v-diasize-wndmax
     1914             ,output v-default-value
     1915             ) .
     1916         end.
     1917         assign
     1918           v-diasize-wndstore = false
     1919         .
     1920         if connected("ub") = true
     1921         then do:
     1922           run gbl/wndpar_r.p
     1923             (input  v-cntxt-db-num
     1924             ,input  v-cntxt-userid
     1925             ,input  'wndstore':U
     1926             ,output v-diasize-wndstore
     1927             ,output v-default-value
     1928             ) .
     1929         end.
     1930         assign
     1931           v-diasize-proc-name = entry(1, program-name(2), '.')
     1932         .
     1933         if v-diasize-wndstore = true
     1934         then do:
     1935           assign
     1936             v-restore-saved = false
     1937           .
     1938           if connected("ub") = true
     1939           then do:
     1940             run gbl/wndsizer.p
     1941               (input  v-cntxt-db-num
     1942               ,input  v-cntxt-userid
     1943               ,input  v-diasize-proc-name
     1944               ,input  'height':u
     1945               ,output v-resize-value-str
     1946               ) .
     1947             if v-resize-value-str <> '':U
     1948             then do:
     1949               run diasize_change-height in this-procedure
     1950                 (input  integer(v-resize-value-str)
     1951                 ,input  true
     1952                 ) .
     1953               assign
     1954                 v-restore-saved = true
     1955               .
     1956             end.
     1957           end.
     1958           if connected("ub") = true
     1959           then do:
     1960             run gbl/wndsizer.p
     1961               (input  v-cntxt-db-num
     1962               ,input  v-cntxt-userid
     1963               ,input  v-diasize-proc-name
     1964               ,input  'width':u
     1965               ,output v-resize-value-str
     1966               ) .
     1967             if v-resize-value-str <> '':U
     1968             then do:
     1969               run diasize_change-width in this-procedure
     1970                 (input  integer(v-resize-value-str)
     1971                 ,input  true
     1972                 ) .
     1973               assign
     1974                 v-restore-saved = true
     1975               .
     1976             end.
     1977           end.
     1978           if v-restore-saved <> true
     1979           then do:
     1980             if v-diasize-wndmax = true
     1981             then do:
     1982               run diasize_maximize in this-procedure
     1983                 (input  true
     1984                 ) .
     1985             end.
     1986           end.
     1987         end.
     1988         else do:
     1989           if v-diasize-wndmax = true
     1990           then do:
     1991             run diasize_maximize in this-procedure
     1992               (input  true
     1993               ) .
     1994           end.
     1995         end.
     1996       end.
     1997     end.
     1998   end procedure.
     1999   procedure diasize_need-full-display :
     2000     define output parameter p-need-full-display as logical   no-undo .
     2001     do
     2002     on error undo, return error return-value
     2003     :
     2004       assign
     2005         p-need-full-display = v-diasize-need-full-display
     2006       .
     2007       assign
     2008         v-diasize-need-full-display = false
     2009       .
     2010     end.
     2011   end procedure.
     2012   procedure get-context :
     2013      define output parameter p-db-num as integer          no-undo.
     2014      define output parameter p-user-id as character        no-undo.
     2015      define variable v-login               as character    no-undo.
     2016      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2017      define buffer buf_user-login  for ub.user-login .
     2018      do
     2019      on error undo, return error
     2020      :
     2021            FIND FIRST buf_sys-ctrl no-lock.
     2022            ASSIGN
     2023               v-login = USERID("ub")
     2024               p-db-num = buf_sys-ctrl.db-num
     2025            .
     2026            FIND FIRST buf_user-login
     2027                 WHERE buf_user-login.db-num = p-db-num
     2028                   AND buf_user-login.user-login = v-login
     2029                 no-lock
     2030                 no-error
     2031                 .
     2032            IF AVAILABLE buf_user-login
     2033            THEN DO:
     2034               assign
     2035                  p-user-id = buf_user-login.user-id
     2036               .
     2037            END.
     2038      end.
     2039   end procedure.
     2040   run diasize_add_browse in this-procedure
     2041     (input  'height':u
     2042     ,input  browse br-curr-accnt :handle
     2043     ) .
     2044   run diasize_add_browse in this-procedure
     2045     (input  'height':u
     2046     ,input  browse br-curr-bank :handle
     2047     ) .
     2048   run diasize_init in this-procedure .
     2049   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2050   do:
     2051     br-currency :SET-REPOSITIONED-ROW(5, "CONDITIONAL") .
     2052   end.
     2053   ON WINDOW-CLOSE OF FRAME d-currency APPLY "END-ERROR":U TO SELF.
     2054   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2055     run mainmenu_getcntxt in parparentproc
     2056       (output v-cntxt-db-num
     2057       ,output v-cntxt-userid
     2058       ,output v-cntxt-level
     2059       ,output v-cntxt-host-code-obj
     2060       ,output v-cntxt-obj-type
     2061       ,output v-cntxt-obj-code
     2062       ,output v-cntxt-db-num-obj
     2063       ,output v-cntxt-is-admin
     2064       ) .
     2065   RUN enable_UI.
     2066   do   on endkey  undo, leave   on error undo, leave:
     2067     if lookup('s-deploy', bttns) > 0 then do:
     2068       assign
     2069       v-is-deploy = yes.
     2070     end.
     2071     WAIT-FOR GO OF FRAME d-currency.
     2072   end.
     2073   RUN disable_UI.
     2074   PROCEDURE add-curr-accnt :
     2075   define output parameter rid as recid no-undo init ?.
     2076     do
     2077     on error undo, return error return-value
     2078     :
     2079       define variable v-today as date      no-undo .
     2080       define variable v-time  as integer   no-undo .
     2081       run cur-time in this-procedure
     2082         (output v-today
     2083         ,output v-time
     2084         ).
     2085       define variable v-exch-date   as date      no-undo .
     2086       define variable v-exch-rate   as decimal   no-undo .
     2087       define variable v-exch-scale  as integer   no-undo .
     2088       define variable v-data-update as logical   no-undo .
     2089       assign
     2090         v-exch-date  = v-today
     2091         v-exch-rate  = 1
     2092         v-exch-scale = 1
     2093       .
     2094       run ref/d-inexch.w
     2095         (input        ?
     2096         ,input        "Курс ММВБ: ВВОД"
     2097         ,input        true
     2098         ,input        true
     2099         ,input-output v-exch-date
     2100         ,input-output v-exch-rate
     2101         ,input-output v-exch-scale
     2102         ,output       v-data-update
     2103         ) .
     2104       if v-data-update = true
     2105       then do:
     2106         define buffer buf_currency   for ub.currency .
     2107         find buf_currency exclusive-lock
     2108           where rowid(buf_currency) = rowid(X_currency)
     2109           .
     2110         assign
     2111           rid = ?
     2112         .
     2113         run ref/curracc1.p
     2114           ( input-output rid
     2115           , input 'ДОБАВЛЕНИЕ':U
     2116           , input false
     2117           , input X_currency.curr-code
     2118           , input v-exch-date
     2119           , input v-exch-rate
     2120           , input v-exch-scale
     2121           ) .
     2122       end.
     2123     end.
     2124   END PROCEDURE.
     2125   PROCEDURE add-curr-bank :
     2126   define output param rid as recid no-undo init ?.
     2127     do
     2128     on error undo, return error return-value
     2129     :
     2130       define variable v-today       as date      no-undo .
     2131       define variable v-time        as integer   no-undo .
     2132       define variable v-exch-date   as date      no-undo .
     2133       define variable v-exch-rate   as decimal   no-undo .
     2134       define variable v-exch-scale  as integer   no-undo .
     2135       define variable v-data-update as logical   no-undo .
     2136       run cur-time in this-procedure
     2137         (output v-today
     2138         ,output v-time
     2139         ).
     2140       assign
     2141         v-exch-date  = v-today
     2142         v-exch-rate  = 1
     2143         v-exch-scale = 1
     2144       .
     2145       run ref/d-inexch.w
     2146         (input        ?
     2147         ,input        "Банковский курс: ВВОД"
     2148         ,input        true
     2149         ,input        true
     2150         ,input-output v-exch-date
     2151         ,input-output v-exch-rate
     2152         ,input-output v-exch-scale
     2153         ,output       v-data-update
     2154         ) .
     2155       if v-data-update = true
     2156       then do:
     2157         define buffer buf_currency for ub.currency .
     2158         find buf_currency exclusive-lock
     2159           where rowid(buf_currency) = rowid(X_currency)
     2160           .
     2161         assign
     2162           rid = ?
     2163         .
     2164         run ref/currbnk1.p
     2165           ( input-output rid
     2166           , input 'ДОБАВЛЕНИЕ':U
     2167           , input false
     2168           , input X_currency.curr-code
     2169           , input v-exch-date
     2170           , input v-exch-rate
     2171           , input v-exch-scale
     2172           ) .
     2173       end.
     2174     end.
     2175   END PROCEDURE.
     2176   PROCEDURE disable_UI :
     2177     HIDE FRAME d-currency.
     2178   END PROCEDURE.
     2179   PROCEDURE enable_UI :
     2180     define variable log-res as log no-undo.
     2181     ENABLE
     2182         br-currency
     2183         br-curr-accnt
     2184         br-curr-bank
     2185         b-exit
     2186         b-help
     2187         b-add            when lookup("b-add", bttns) > 0 and v-cntxt-db-num = 0
     2188         b-upd-curr-accnt when v-cntxt-db-num = 0
     2189         b-upd            when lookup("b-add", bttns) > 0 and v-cntxt-db-num = 0
     2190         b-upd-curr-bank  when v-cntxt-db-num = 0
     2191         b-sel            when lookup("b-sel", bttns) > 0
     2192         b-add-curr-accnt when v-cntxt-db-num = 0
     2193         b-add-curr-bank  when v-cntxt-db-num = 0
     2194         b-hist           when not v-is-deploy
     2195         b-hist-curr-accnt when not v-is-deploy
     2196         b-hist-curr-bank  when not v-is-deploy
     2197         WITH FRAME d-currency.
     2198     OPEN QUERY br-currency FOR EACH X_currency NO-LOCK.
     2199     if  rid-sel <> ?
     2200     and lookup("b-sel", bttns) > 0
     2201     then do:
     2202       reposition br-currency to recid rid-sel no-error.
     2203     end.
     2204     apply "ITERATION-CHANGED":U to br-currency.
     2205     if available X_currency
     2206         then log-res = br-currency:select-focused-row( ).
     2207   END PROCEDURE.
     2208   PROCEDURE upd-curr-accnt :
     2209   do
     2210     on error undo, return error return-value
     2211     :
     2212       define variable rid           as recid     no-undo .
     2213       define variable v-today       as date      no-undo .
     2214       define variable v-time        as integer   no-undo .
     2215       define variable v-exch-date   as date      no-undo .
     2216       define variable v-exch-rate   as decimal   no-undo .
     2217       define variable v-exch-scale  as integer   no-undo .
     2218       define variable v-data-update as logical   no-undo .
     2219       define buffer buf_currency   for ub.currency .
     2220       define buffer buf_curr-accnt for ub.curr-accnt .
     2221       if available X_curr-accnt then do:
     2222         find buf_currency exclusive-lock
     2223           where rowid(buf_currency) = rowid(X_currency)
     2224           .
     2225         run cur-time in this-procedure
     2226           (output v-today
     2227           ,output v-time
     2228           ).
     2229         if X_curr-accnt.exch-date < v-today
     2230         then do:
     2231           message
     2232             "Разрешается редактировать курс начиная только с текущей даты!"
     2233             view-as alert-box error.
     2234           return .
     2235         end.
     2236         find current X_curr-accnt exclusive-lock .
     2237         assign
     2238           v-exch-date  = X_curr-accnt.exch-date
     2239           v-exch-rate  = X_curr-accnt.exch-rate
     2240           v-exch-scale = X_curr-accnt.exch-scale
     2241         .
     2242         run ref/d-inexch.w
     2243           (input        ?
     2244           ,input        "Курс ММВБ: ИЗМЕНЕНИЕ"
     2245           ,input        true
     2246           ,input        false
     2247           ,input-output v-exch-date
     2248           ,input-output v-exch-rate
     2249           ,input-output v-exch-scale
     2250           ,output       v-data-update
     2251           ) .
     2252         if v-data-update = true
     2253         then do:
     2254           assign
     2255             rid = recid( X_curr-accnt )
     2256           .
     2257           run ref/curracc1.p
     2258             ( input-output rid
     2259             , input 'ИЗМЕНЕНИЕ':U
     2260             , input false
     2261             , input X_curr-accnt.curr-code
     2262             , input v-exch-date
     2263             , input v-exch-rate
     2264             , input v-exch-scale
     2265             ) .
     2266           display
     2267             X_curr-accnt.exch-rate
     2268             X_curr-accnt.exch-scale
     2269             with browse br-curr-accnt .
     2270         end.
     2271       end.
     2272     end.
     2273   END PROCEDURE.
     2274   PROCEDURE upd-curr-bank :
     2275   define buffer buf_currency  for ub.currency .
     2276     define buffer buf_curr-bank for ub.curr-bank .
     2277     do
     2278     on error undo, return error return-value
     2279     :
     2280       define variable rid           as recid     no-undo .
     2281       define variable v-today       as date      no-undo .
     2282       define variable v-time        as integer   no-undo .
     2283       define variable v-exch-date   as date      no-undo .
     2284       define variable v-exch-rate   as decimal   no-undo .
     2285       define variable v-exch-scale  as integer   no-undo .
     2286       define variable v-data-update as logical   no-undo .
     2287       if available X_curr-bank then do:
     2288         find buf_currency exclusive-lock
     2289           where rowid(buf_currency) = rowid(X_currency)
     2290           .
     2291         run cur-time in this-procedure
     2292           (output v-today
     2293           ,output v-time
     2294           ).
     2295         if X_curr-bank.exch-date <= v-today
     2296         then do:
     2297           message
     2298             "Разрешается редактировать курс только с будущей датой!"
     2299             view-as alert-box error.
     2300           return .
     2301         end.
     2302         find current X_curr-bank exclusive-lock .
     2303         assign
     2304           v-exch-date  = X_curr-bank.exch-date
     2305           v-exch-rate  = X_curr-bank.exch-rate
     2306           v-exch-scale = X_curr-bank.exch-scale
     2307         .
     2308         run ref/d-inexch.w
     2309           (input        ?
     2310           ,input        "Банковский курс: ИЗМЕНЕНИЕ"
     2311           ,input        true
     2312           ,input        false
     2313           ,input-output v-exch-date
     2314           ,input-output v-exch-rate
     2315           ,input-output v-exch-scale
     2316           ,output       v-data-update
     2317           ) .
     2318         if v-data-update = true
     2319         then do:
     2320           assign
     2321             rid = recid( X_curr-bank )
     2322           .
     2323           run ref/currbnk1.p
     2324             ( input-output rid
     2325             , input 'ИЗМЕНЕНИЕ':U
     2326             , input false
     2327             , input X_curr-bank.curr-code
     2328             , input v-exch-date
     2329             , input v-exch-rate
     2330             , input v-exch-scale
     2331             ) .
     2332           display
     2333             X_curr-bank.exch-rate
     2334             X_curr-bank.exch-scale
