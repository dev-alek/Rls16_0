      635       ,input  'actn_currency-reference_work':U
      636       ,input  'global':U
      637       ,input  0
      638       ,input  '':U
      639       ,input  0
      640       ,input  0
      641       ,input  0
      642       ,input  0
      643       ,input  true
      644       ,output v-ok
      645       )  .
