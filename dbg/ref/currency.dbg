      308   define variable v-inform-launched as logical no-undo initial false .
      309   procedure proc-alt-shift-f4:
      310     define variable v-action as character no-undo .
      311     if v-inform-launched = false then do:
      312       assign
      313         v-inform-launched = true
      314       .
      315       run gbl/d-inform.w
      316         (  input self
      317         ,  input this-procedure
      318         , output v-action
      319         ) no-error .
      320       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      321       assign
      322         v-inform-launched = false
      323       .
      324     end.
      325   end.
      326   procedure proc-alt-f1:
