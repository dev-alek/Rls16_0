      382        SIZE 10 BY 1.
      383   DEFINE BUTTON b-upd
      384        LABEL "&Изменить":L
      385        SIZE 10 BY 1.
      386   DEFINE BUTTON b-upd-curr-accnt
      387        LABEL "И&зменить"
      388        SIZE 10 BY 1.
      389   DEFINE BUTTON b-upd-curr-bank
      390        LABEL "Из&менить"
      391        SIZE 10 BY 1.
      392   DEFINE QUERY br-curr-accnt FOR
      393         X_curr-accnt SCROLLING.
      394   DEFINE QUERY br-curr-bank FOR
      395         X_curr-bank SCROLLING.
      396   DEFINE QUERY br-currency FOR
      397         X_currency SCROLLING.
      398   DEFINE BROWSE br-curr-accnt
      399     QUERY br-curr-accnt NO-LOCK DISPLAY
      400         X_curr-accnt.exch-date FORMAT "99/99/9999":U
      401         X_curr-accnt.exch-rate FORMAT ">>,>>9.9999":U
      402         X_curr-accnt.exch-scale FORMAT ">>>9":U
      403       WITH SEPARATORS SIZE 32 BY 14
      404            TITLE "Курс ММВБ".
      405   DEFINE BROWSE br-curr-bank
      406     QUERY br-curr-bank NO-LOCK DISPLAY
      407         X_curr-bank.exch-date FORMAT "99/99/9999":U
      408         X_curr-bank.exch-rate FORMAT ">>,>>9.9999":U
      409         X_curr-bank.exch-scale FORMAT ">>>9":U
      410       WITH SEPARATORS SIZE 32 BY 14
      411            TITLE "Курс ЦБ".
      412   DEFINE BROWSE br-currency
      413     QUERY br-currency NO-LOCK DISPLAY
      414         X_currency.curr-code FORMAT ">>9":U
      415         X_currency.curr-abbr FORMAT "X(3)":U
      416         X_currency.okv-code FORMAT ">>9":U  COLUMN-LABEL "Код!ОКВ"
      417         (IF num-entries(X_currency.curr-eng-name, chr(4)) > 1
      418          THEN entry(2, X_currency.curr-eng-name, chr(4))
      419          ELSE '') COLUMN-LABEL "Букв.код!по ОКВ"
      420       WITH SEPARATORS SIZE 22.5 BY 13.
      421   DEFINE FRAME d-currency
      422        b-exit AT ROW 1 COL 1
      423        b-sel AT ROW 1 COL 11
      424        b-help AT ROW 1 COL 71
      425        b-add AT ROW 3 COL 1
      426        b-upd AT ROW 3 COL 11
      427        b-add-curr-accnt AT ROW 3 COL 24
      428        b-upd-curr-accnt AT ROW 3 COL 34
      429        b-hist-curr-accnt AT ROW 3 COL 44
      430        b-add-curr-bank AT ROW 3 COL 57
      431        b-upd-curr-bank AT ROW 3 COL 67
      432        b-hist-curr-bank AT ROW 3 COL 77
      433        b-hist AT ROW 4 COL 11
      434        br-curr-accnt AT ROW 4 COL 24
      435        br-curr-bank AT ROW 4 COL 57
      436        br-currency AT ROW 5 COL 1
      437        SPACE(66.73) SKIP(0.78)
      438       WITH VIEW-AS DIALOG-BOX
      439            SIDE-LABELS THREE-D  SCROLLABLE
      440            TITLE "С П Р А В О Ч Н И К   В А Л Ю Т":L.
      441   ASSIGN
      442          FRAME d-currency:SCROLLABLE       = FALSE.
      443   ON CHOOSE OF b-add IN FRAME d-currency
      444   DO:
      445     define variable v-ok as logical no-undo .
      446   define variable vss-include-info2 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      447   do:
      448     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      449       (input  v-cntxt-db-num
      450       ,input  v-cntxt-userid
      451       ,input  0
      452       ,input  'actn_currency-reference_work':U
      453       ,input  'global':U
      454       ,input  0
      455       ,input  '':U
      456       ,input  0
      457       ,input  0
      458       ,input  0
      459       ,input  0
      460       ,input  true
      461       ,output v-ok
      462       )  .
      463   end.
      464     if v-ok <> true
      465     then do:
      466       undo, return no-apply .
      467     end.
      468       if v-cntxt-db-num = 0 then do:
      469         run ref/currenci.w (
      470                         input parparentproc
      471                        ,input 'ДОБАВЛЕНИЕ':U
      472                        ,input ?
      473                        ,input-output ri ).
      474         if ri <> ? then do:
      475           OPEN QUERY br-currency FOR EACH X_currency NO-LOCK.
      476           reposition br-currency to recid ri.
      477           log-res = br-currency:select-focused-row( ).
      478           apply "ENTRY":U to br-currency.
      479           apply "VALUE-CHANGED":U to br-currency.
      480         end.
      481       end.
      482   END.
      483   ON CHOOSE OF b-add-curr-accnt IN FRAME d-currency
      484   DO:
      485     define variable v-ok as logical no-undo .
      486   define variable vss-include-info3 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      487   do:
      488     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      489       (input  v-cntxt-db-num
      490       ,input  v-cntxt-userid
      491       ,input  0
      492       ,input  'actn_micex-rate_update':U
      493       ,input  'global':U
      494       ,input  0
      495       ,input  '':U
      496       ,input  0
      497       ,input  0
      498       ,input  0
      499       ,input  0
      500       ,input  true
      501       ,output v-ok
      502       )  .
      503   end.
      504     if v-ok <> true
      505     then do:
      506       undo, return no-apply .
      507     end.
      508     if X_currency.curr-code = 0
      509     and can-find( first X_curr-accnt )
      510     then do:
      511       message
      512         "Для валюты с кодом 0 -  - установлен фиксированный курс - 1!" skip
      513         view-as alert-box WARNING.
      514       return no-apply.
      515     end.
      516     if v-cntxt-db-num = 0
      517     then do:
      518       run add-curr-accnt in this-procedure
      519         (output ri
      520         ).
      521       if ri <> ?
      522       then do:
      523         if ri <> ? then do:
      524           OPEN QUERY br-curr-accnt FOR EACH X_curr-accnt       WHERE X_curr-accnt.curr-code = X_currency.curr-code NO-LOCK     BY X_curr-accnt.exch-date DESCENDING.
      525           reposition br-curr-accnt to recid ri no-error.
      526         end.
      527         apply 'entry':u to br-currency .
      528         apply 'iteration-changed':u to br-currency .
      529       end.
      530     end.
      531   END.
      532   ON CHOOSE OF b-add-curr-bank IN FRAME d-currency
      533   DO:
      534     define variable v-ok as logical no-undo .
      535   define variable vss-include-info4 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      536   do:
      537     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      538       (input  v-cntxt-db-num
      539       ,input  v-cntxt-userid
      540       ,input  0
      541       ,input  'actn_cb-rate_update':U
      542       ,input  'global':U
      543       ,input  0
      544       ,input  '':U
      545       ,input  0
      546       ,input  0
      547       ,input  0
      548       ,input  0
      549       ,input  true
      550       ,output v-ok
      551       )  .
      552   end.
      553     if v-ok <> true
      554     then do:
      555       undo, return no-apply .
      556     end.
      557     if  X_currency.curr-code = 0
      558     and can-find(first X_curr-bank)
      559     then do:
      560       message
      561         "Для валюты с кодом 0 - Рубли - установлен фиксированный курс - 1!" skip
      562         view-as alert-box WARNING .
      563       return no-apply.
      564     end.
      565     if v-cntxt-db-num = 0
      566     then do:
