      355   define variable v-is-deploy as logical no-undo .
      356   DEFINE BUTTON b-add
      357        LABEL "&Добавить":L
      358        SIZE 10 BY 1.
      359   DEFINE BUTTON b-add-curr-accnt
      360        LABEL "Д&обавить":L
      361        SIZE 10 BY 1.
      362   DEFINE BUTTON b-add-curr-bank
      363        LABEL "Доб&авить":L
      364        SIZE 10 BY 1.
      365   DEFINE BUTTON b-exit AUTO-GO
      366        LABEL "&Выход ":L
      367        SIZE 10 BY 1.
      368   DEFINE BUTTON b-help
      369        LABEL "Помо&щь"
      370        SIZE 10 BY 1.
      371   DEFINE BUTTON b-hist
      372        LABEL "Ис&тория":L
      373        SIZE 10 BY 1.
      374   DEFINE BUTTON b-hist-curr-accnt
      375        LABEL "Ис&тория":L
      376        SIZE 10 BY 1.
      377   DEFINE BUTTON b-hist-curr-bank
      378        LABEL "Ис&тория":L
