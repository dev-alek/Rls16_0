      756           do:
      757               OPEN QUERY br-curr-accnt FOR EACH X_curr-accnt       WHERE X_curr-accnt.curr-code = X_currency.curr-code NO-LOCK     BY X_curr-accnt.exch-date DESCENDING.
      758               OPEN QUERY br-curr-bank FOR EACH X_curr-bank       WHERE X_curr-bank.curr-code =  X_currency.curr-code NO-LOCK     BY X_curr-bank.exch-date DESCENDING.
      759           end.
