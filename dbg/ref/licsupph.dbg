        1   def var vss-revision    as character no-undo init "$Revision$":U .
        2   def var vss-author      as character no-undo init "$Author$":U .
        3   def var vss-date        as character no-undo init "$Date$":U .
        4   def var vss-workfile    as character no-undo init "$Workfile$":U .
        5   def var vss-archive     as character no-undo init "$Archive$":U .
        6   def var vss-description as character no-undo init "История  лицензий на поставку алкоголя".
        7   procedure vss-get-info :
        8     define output parameter p-vss-revision    like vss-revision    no-undo .
        9     define output parameter p-vss-author      like vss-author      no-undo .
       10     define output parameter p-vss-date        like vss-date        no-undo .
       11     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       12     define output parameter p-vss-archive     like vss-archive     no-undo .
       13     define output parameter p-vss-description like vss-description no-undo .
       14     assign
       15       p-vss-revision    = vss-revision
       16       p-vss-author      = vss-author
       17       p-vss-date        = vss-date
       18       p-vss-workfile    = vss-workfile
       19       p-vss-archive     = vss-archive
       20       p-vss-description = vss-description
       21     .
       22   end procedure.
       23   procedure vss-get-parameters :
       24     define output parameter p-vss-parameters as character no-undo .
       25   end procedure.
       26   define new global shared variable g#vssrevis-logger as handle    no-undo .
       27   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       28   define variable v-vssrevis-logger                   as handle    no-undo .
       29   procedure vss-logevent :
       30     define input  parameter p-extra-paramters as character no-undo .
       31     define variable v-vssrevis-parameters as character no-undo .
       32     do
       33     on error undo, return error return-value
       34     :
       35       if  valid-handle(v-vssrevis-logger)
       36       and v-vssrevis-logger :get-signature("logevent") <> ""
       37       then do:
       38         run vss-get-parameters in this-procedure
       39           (output v-vssrevis-parameters
       40           ).
       41         run logevent in v-vssrevis-logger
       42           (input vss-workfile
       43           ,input vss-revision
       44           ,input v-vssrevis-parameters
       45           ,input p-extra-paramters
       46           ).
       47       end.
       48     end.
       49   end procedure.
       50   assign
       51     v-vssrevis-logger = g#vssrevis-logger
       52   .
       53   if  valid-handle(v-vssrevis-logger)
       54   and v-vssrevis-logger :get-signature("logevent") <> ""
       55   then do:
       56     assign
       57       v-vssrevis-logevent = true
       58     .
       59     run vss-logevent in this-procedure (input vss-description) .
       60   end.
       61   define input parameter  parparentproc           as   widget-handle no-undo.
       62   define input parameter  par-alc-supp-lic-code like ub.alc-supp-lic.alc-supp-lic-code no-undo .
       63   define input parameter  par-db-num              like ub.alc-supp-lic.create-user-db-num no-undo .
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   define new global shared variable g#library  as handle no-undo .
       69   define new global shared variable g#library2 as handle no-undo .
       70   define   shared variable g#auto as logical no-undo.
       71   define   shared variable g#news as logical no-undo.
       72   define   shared variable g#oxml as logical no-undo.
       73   define   shared variable g#esys as logical no-undo.
       74   define   shared variable g#news-source-db as integer no-undo.
       75   define   shared variable g#esys-source-esys as integer no-undo.
       76   define   shared variable g#db-num as integer   no-undo .
       77   define   shared variable g#userid as character no-undo .
       78   define   shared variable g#passwd as character no-undo .
       79   procedure proc-alt-shift-f2:
       80     if not ibs.th.gbl.gbl-var:rcode
       81   then
       82     run gbl\inidebug.p .
       83   end.
       84   procedure proc-alt-shift-f3:
       85     run gbl/prvssinf.p
       86       ( input this-procedure
       87       ) .
       88   end.
       89   define variable v-inform-launched as logical no-undo initial false .
       90   procedure proc-alt-shift-f4:
       91     define variable v-action as character no-undo .
       92     if v-inform-launched = false then do:
       93       assign
       94         v-inform-launched = true
       95       .
       96       run gbl/d-inform.w
       97         (  input self
       98         ,  input this-procedure
       99         , output v-action
      100         ) no-error .
      101       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      102       assign
      103         v-inform-launched = false
      104       .
      105     end.
      106   end.
      107   procedure proc-alt-f1:
      108     run gbl/corrhelp.p
      109       (input this-procedure
      110       ) .
      111   end .
      112   on alt-shift-f2 anywhere do:
      113     run proc-alt-shift-f2.
      114   end.
      115   on alt-shift-f3 anywhere do:
      116     run proc-alt-shift-f3 in this-procedure .
      117   end.
      118   on alt-shift-f4 anywhere do:
      119     run proc-alt-shift-f4 in this-procedure.
      120   end.
      121   on alt-f1 anywhere do:
      122     run proc-alt-f1 in this-procedure .
      123   end.
      124   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      125   define variable c-point  as character no-undo .
      126   define variable tbl      as character no-undo .
      127   define variable join-tbl as character no-undo .
      128   define variable fld      as character no-undo .
      129   define variable lab      as character no-undo .
      130   define variable spr      as character no-undo .
      131   define variable dim      as character no-undo .
      132   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      133   procedure cur-time :
      134      define output parameter p-today as date      no-undo .
      135      define output parameter p-time  as integer   no-undo .
      136     do
      137     on error undo, return error
      138     :
      139       define variable v-date1 as date      no-undo .
      140       define variable v-date2 as date      no-undo .
      141       define variable v-time  as integer   no-undo .
      142       assign
      143         v-date1 = today
      144         v-time  = time
      145         v-date2 = today
      146       .
      147       if v-date1 <> v-date2
      148       then do:
      149         assign
      150           v-date1 = today
      151           v-time  = v-time
      152         .
      153       end.
      154       assign
      155         p-today = v-date1
      156         p-time  = v-time
      157       .
      158     end.
      159   end.
      160   function cur-time-date returns character
      161   :
      162     return string(today, '99/99/9999':U) .
      163   end.
      164   function cur-time-mjd returns decimal
      165   :
      166     define variable v-date as date      no-undo .
      167     define variable v-time as integer   no-undo .
      168     run cur-time in this-procedure
      169       (output v-date
      170       ,output v-time
      171       ) .
      172     return integer(v-date) - 2400002 + (v-time / 86400) .
      173   end.
      174   function cur-time-get-ending-index returns integer
      175   (input p-number as integer
      176   )
      177   :
      178     if p-number < 0
      179     or p-number = ?
      180     then do:
      181       return 1 .
      182     end.
      183     define variable v-rest as integer   no-undo .
      184     assign
      185       p-number = p-number modulo 100
      186     .
      187     if p-number < 20
      188     then do:
      189       assign
      190         v-rest = p-number
      191       .
      192     end.
      193     else do:
      194       assign
      195         v-rest = p-number modulo 10
      196       .
      197     end.
      198     case v-rest :
      199       when 1
      200       then do:
      201         return 2 .
      202       end.
      203       when 2 or
      204       when 3 or
      205       when 4
      206       then do:
      207         return 3 .
      208       end.
      209       otherwise do:
      210         return 1 .
      211       end.
      212     end case .
      213   end.
      214   procedure cur-time-mjd-to-date :
      215      define input  parameter i-mjd-diff as decimal no-undo.
      216      define output parameter o-Date     as date    no-undo.
      217      define output parameter o-Time     as integer no-undo.
      218      define variable v-day-number as integer   no-undo .
      219      if    i-mjd-diff < 0
      220         or i-mjd-diff = ?
      221      then do:
      222         return "?" .
      223      end.
      224      assign
      225         v-day-number = truncate(i-mjd-diff,0).
      226         o-Date = date(v-day-number + 2400002).
      227         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      228     .
      229   end.
      230   function cur-time-mjd-to-string returns character
      231   (input p-mjd-diff as decimal
      232   )
      233   :
      234     define variable v-day-number as integer   no-undo .
      235     define variable v-seconds    as integer   no-undo .
      236     define variable v-hour       as integer   no-undo .
      237     define variable v-min        as integer   no-undo .
      238     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      239     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      240     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      241     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      242     if p-mjd-diff < 0
      243     or p-mjd-diff = ?
      244     then do:
      245       return "?" .
      246     end.
      247     assign
      248       v-day-number = integer(truncate(p-mjd-diff,0))
      249       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      250     .
      251     if v-seconds > 86400
      252     then do:
      253       assign
      254         v-seconds = 86400 - 1
      255       .
      256     end.
      257     if v-seconds < 0
      258     then do:
      259       assign
      260         v-seconds = 0
      261       .
      262     end.
      263     assign
      264       v-hour = truncate(v-seconds / 3600, 0)
      265     .
      266     assign
      267       v-seconds = v-seconds modulo 3600
      268     .
      269     assign
      270       v-min = truncate(v-seconds / 60, 0)
      271     .
      272     assign
      273       v-seconds = v-seconds modulo 60
      274     .
      275     return
      276         (if v-day-number <> 0
      277           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      278           else ""
      279         )
      280       + (if v-day-number <> 0 or v-hour <> 0
      281           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      282           else ""
      283         )
      284       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      285           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      286           else ""
      287         )
      288       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      289       .
      290   end.
      291   function cur-time-string returns character
      292   :
      293     define variable v-date as date      no-undo .
      294     define variable v-time as integer   no-undo .
      295     run cur-time in this-procedure
      296       (output v-date
      297       ,output v-time
      298       ) .
      299     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      300   end.
      301   function cur-time-string-sec returns character
      302   :
      303     define variable v-date as date      no-undo .
      304     define variable v-time as integer   no-undo .
      305     run cur-time in this-procedure
      306       (output v-date
      307       ,output v-time
      308       ) .
      309     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      310   end.
      311   function cur-time-custom  returns character
      312   (input p-prefix as character
      313   ,input p-date-format as character
      314   ,input p-delimiter as character
      315   ,input p-time-format as character
      316   ,input p-suffix as character
      317   )
      318   :
      319     define variable v-date as date      no-undo .
      320     define variable v-time as integer   no-undo .
      321     run cur-time in this-procedure
      322       (output v-date
      323       ,output v-time
      324       ) .
      325     return
      326       p-prefix
      327       + string(v-date, p-date-format)
      328       + p-delimiter
      329       + string(v-time, p-time-format)
      330       + p-suffix
      331       .
      332   end.
      333   function cur-time-print  returns character
      334   :
      335     define variable v-date as date      no-undo .
      336     define variable v-time as integer   no-undo .
      337     run cur-time in this-procedure
      338       (output v-date
      339       ,output v-time
      340       ) .
      341     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      342   end.
      343   function cur-time-datetime returns datetime
      344   :
      345     define variable v-char as character no-undo .
      346     define variable v-datetime as datetime no-undo .
      347     v-char = cur-time-string().
      348     v-datetime = datetime(v-char).
      349     return  v-datetime.
      350   end.
      351   function cur-time-string-msec returns character
      352   :
      353     define variable v-date as datetime  no-undo .
      354     v-date = now.
      355     return string(v-date) .
      356   end.
      357   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      358   define variable v-waitfram-action01         as character   no-undo .
      359   define variable v-waitfram-action02         as character   no-undo .
      360   define variable v-waitfram-action03         as character   no-undo .
      361   define variable mWaitFramTextBeg            as character   no-undo.
      362   define variable mWaitFramTextEnd            as character   no-undo.
      363   define variable mWaitFramView               as logical     no-undo.
      364   define variable mWaitProcEvent              as logical     no-undo init yes.
      365   define variable mWaitFramInterval           as integer     no-undo init 1 .
      366   define variable mWaitFramStop               as logical     no-undo.
      367   define variable mWaitFramStopUser           as logical     no-undo.
      368   define variable mWaitFramStopTimeOut        as logical     no-undo.
      369   define variable mWaitFramStartProc          as datetime-tz no-undo.
      370   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      371   define button B-WaitFramStop auto-end-key
      372        label "Стоп"
      373        size 10 by 1 tooltip "Остоновить процесс".
      374   define button B-viewProcInfo
      375        label "Информация"
      376        size 15 by 1 tooltip "Информация о процесс".
      377   define frame waitfram
      378     v-waitfram-action01 format "x(72)" no-label skip
      379     v-waitfram-action02 format "x(72)" no-label skip
      380     v-waitfram-action03 format "x(72)" no-label skip
      381     B-viewProcInfo
      382     B-WaitFramStop at row 4 col 30
      383     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      384     .
      385   define new global shared variable mBatchMode as logical no-undo init ?.
      386   define variable mFramBachModHandle as handle no-undo.
      387   mFramBachModHandle = frame waitfram:handle.
      388   define variable mFameOldVis as logical no-undo.
      389   define variable mVisCUrentVin as logical no-undo.
      390   if session:batch-mode
      391   then
      392      mBatchMode = yes.
      393   if mBatchMode = ? then do:
      394     mVisCUrentVin = current-window:visible.
      395     mFameOldVis = mFramBachModHandle:visible.
      396     mFramBachModHandle:visible  = yes.
      397     mBatchMode = mFramBachModHandle:visible ne yes.
      398     mFramBachModHandle:visible = mFameOldVis.
      399     current-window:visible = mVisCUrentVin.
      400   end.
      401    if  log-manager:logfile-name ne ?
      402     then DO:
      403         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      404         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      405         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      406     end.
      407   on choose of B-WaitFramStop in frame waitfram
      408   do:
      409     mWaitFramStop = yes.
      410     mWaitFramStopUser = yes.
      411   end.
      412   function waitfram-check-timeout returns logical():
      413      define variable vtime as int64 no-undo.
      414      if mWaitFramStopTimeOut
      415      then
      416         return yes.
      417      vtime = ( now - mWaitFramStartProc ) / 1000 .
      418      if     mWaitFramTimeOut ne ?
      419         and mWaitFramTimeOut ne 0
      420         and mWaitFramTimeOut lt vtime
      421      then do:
      422         mWaitFramStopTimeOut = yes.
      423      end.
      424      return mWaitFramStopTimeOut.
      425   end.
      426   procedure waitfram-hide :
      427     if not session:batch-mode
      428     then do
      429     on error undo, return error return-value
      430     :
      431       pause 0 before-hide .
      432       if not mBatchMode then
      433         hide frame waitfram .
      434     if     not mWaitFramView
      435        and mWaitProcEvent
      436     then
      437       process events .
      438     end.
      439   end procedure.
      440   procedure waitfram-show :
      441     define input  parameter p-message as character no-undo .
      442     define variable v-left-margin as integer   no-undo .
      443     if not session:batch-mode
      444     then do
      445     on error undo, return error return-value
      446     :
      447       if length(p-message) <= 70 then do:
      448         assign
      449           v-left-margin = integer((70 - length(p-message)) / 2)
      450         .
      451         assign
      452           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      453         .
      454         assign
      455           v-waitfram-action01 = " "
      456           v-waitfram-action02 = " "
      457                                    + fill(" ", v-left-margin)
      458                                    + p-message
      459           v-waitfram-action03 = " "
      460         .
      461       end.
      462       else do:
      463         define variable vRindex1 as integer no-undo.
      464         define variable vRindex2 as integer no-undo.
      465         vRindex1 = r-index(p-message," ",70).
      466         if vRindex1 = 0
      467         then
      468            vRindex1 = 70.
      469         if length(p-message)  <= vRindex1 + 70 then do:
      470           assign
      471             v-waitfram-action01 = " "
      472             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      473             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      474           .
      475         end.
      476         else do:
      477           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      478           if vRindex2 <= vRindex1
      479           then
      480              vRindex2 = vRindex1 + 70.
      481           assign
      482             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      483             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      484             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      485           .
      486         end.
      487       end.
      488       B-viewProcInfo:visible   in frame waitfram = no.
      489       B-viewProcInfo:sensitive in frame waitfram = no.
      490       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      491       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      492       if  (   mWaitFramView
      493          or  mWaitProcEvent)
      494          and not mBatchMode
      495       then
      496          display
      497             v-waitfram-action01 skip
      498             v-waitfram-action02 skip
      499             v-waitfram-action03 skip
      500          with frame waitfram .
      501       if     mWaitFramView
      502          then do:
      503             if     mWaitFramInterval ne ?
      504                and not mBatchMode
      505             then
      506                wait-for go of frame waitfram pause mWaitFramInterval.
      507          end.
      508          else
      509             if     mWaitProcEvent
      510                and not mBatchMode
      511             then
      512                process events .
      513     end.
      514   end procedure.
      515      procedure waitfram-show-this:
      516         define input  parameter iInterval as int64 no-undo.
      517         define variable vtime as int64 no-undo.
      518         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      519         mWaitFramInterval = iInterval.
      520         run waitfram-show (substitute("&1&2 &3&4" ,
      521                                       mWaitFramTextBeg ,
      522                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      523                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      524                                       mWaitFramTextEnd
      525                                      )
      526                           ).
      527      end.
      528      procedure WaitFramRunPause:
      529         define input  parameter iInterval as dec no-undo.
      530         define variable vStart  as datetime-tz no-undo.
      531         define variable vend    as datetime-tz no-undo.
      532         define variable vint as int64 no-undo.
      533         define variable vOk as logical no-undo.
      534         vStart = now.
      535         vend   = vStart.
      536         publish "WaitFramPause" (iInterval,output vOk).
      537         vend   =  now.
      538         vint = vend - vStart.
      539         vint = iInterval - vint / 1000.
      540         if     not mWaitFramStop
      541            and (   vint > 0
      542                 or (    not vOk
      543                     and iInterval eq ?
      544                     )
      545                 )
      546         then
      547            run waitfram-show-this (iInterval).
      548         vend   =  now.
      549         vint = vend - vStart.
      550         vint = iInterval - vint / 1000.
      551         if     not mWaitFramStop
      552            and vint > 0
      553         then do:
      554            run gbl/pause.p (vint * 1000).
      555         end.
      556         if iInterval ne ?
      557         then
      558            publish "WaitFramStop".
      559         waitfram-check-timeout().
      560      end.
      561      procedure WaitFramWaitFor:
      562         define input  parameter iInterval as dec no-undo.
      563         assign
      564            mWaitFramStartProc   = now
      565            mWaitFramStopUser    = no
      566            mWaitFramStopTimeOut = no
      567         .
      568         block-wait:
      569         do while not mWaitFramStop:
      570            run WaitFramRunPause (iInterval).
      571            if  waitfram-check-timeout()
      572            then do:
      573               leave block-wait.
      574            end.
      575         end.
      576         run waitfram-hide.
      577      end.
      578   procedure waitfram-join :
      579     define input  parameter p-line-1  as character no-undo .
      580     define input  parameter p-line-2  as character no-undo .
      581     define input  parameter p-line-3  as character no-undo .
      582     define output parameter p-message as character no-undo .
      583     do
      584     on error undo, return error return-value
      585     :
      586       assign
      587         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      588                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      589                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      590       .
      591     end.
      592   end procedure.
      593   function waitfram-join-function returns character
      594     (input p-line-1 as character
      595     ,input p-line-2 as character
      596     ,input p-line-3 as character
      597     ).
      598     define variable v-message as character no-undo .
      599     run waitfram-join in this-procedure
      600       (input  p-line-1
      601       ,input  p-line-2
      602       ,input  p-line-3
      603       ,output v-message
      604       ) .
      605     return v-message .
      606   end function .
      607   define variable del-type as character no-undo.
      608   define variable deleted as logical no-undo init no.
      609   DEFINE VARIABLE change-type as character init "" no-undo .
      610   DEFINE NEW SHARED BUFFER buf_c-alc-supp-lic FOR ub.c-alc-supp-lic .
      611   define temp-table temp-changes no-undo
      612   field f_name as character
      613   field l_name as character
      614   field v_old as character
      615   field v_new as character
      616   index pi is unique primary
      617   f_name.
      618   DEFINE BUTTON B-Cancel AUTO-END-KEY
      619        LABEL "Выход"
      620        SIZE 10 BY 1
      621        BGCOLOR 8 .
      622   DEFINE BUTTON B-Help
      623        LABEL "Помощь"
      624        SIZE 10 BY 1
      625        BGCOLOR 8 .
      626   DEFINE VARIABLE mark-num AS CHARACTER FORMAT "X(256)":U
      627         VIEW-AS TEXT
      628        SIZE 6 BY 1
      629        FGCOLOR 4  NO-UNDO.
      630   DEFINE QUERY BR-changes FOR
      631         temp-changes SCROLLING.
      632   DEFINE QUERY BR-docs FOR
      633         buf_c-alc-supp-lic SCROLLING.
      634   DEFINE QUERY Dialog-Frame FOR
      635         ub.c-alc-supp-lic SCROLLING.
      636   DEFINE BROWSE BR-changes
      637     QUERY BR-changes DISPLAY
      638         temp-changes.l_name COLUMn-LABEL "Изменилось" format "X(25)"
      639         temp-changes.v_old COLUMn-LABEL "Было" format "X(35)"
      640         temp-changes.v_new COLUMn-LABEL "Стало" format "X(35)"
      641       WITH NO-ROW-MARKERS SEPARATORS SIZE 90.8 BY 11.5.
      642   DEFINE BROWSE BR-docs
      643     QUERY BR-docs DISPLAY
      644         buf_c-alc-supp-lic.chip-num  format ">>>>>>>>>>9"
      645        buf_c-alc-supp-lic.alc-supp-lic-code COLUMN-LABEL "Код"  format ">>>>>>>>>>>>>9"
      646       WITH NO-ROW-MARKERS NO-COLUMN-SCROLLING SEPARATORS SIZE 90 BY 8.93.
      647   DEFINE FRAME Dialog-Frame
      648        B-Cancel AT ROW 1 COL 1
      649        B-Help AT ROW 1 COL 81.5
      650        BR-docs AT ROW 2.2 COL 1.3
      651        BR-changes AT ROW 12 COL 1
      652        mark-num AT ROW 1 COL 14.9 NO-LABEL
      653        SPACE(70.85) SKIP(21.59)
      654       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      655            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      656            TITLE "История изменений сезонов/коллекций"
      657            CANCEL-BUTTON B-Cancel.
      658   ASSIGN
      659          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      660          FRAME Dialog-Frame:HIDDEN           = TRUE.
      661   ASSIGN
      662          BR-docs:NUM-LOCKED-COLUMNS IN FRAME Dialog-Frame     = 2.
      663   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      664   DO:
      665     APPLY "END-ERROR":U TO SELF.
      666   END.
      667   ON VALUE-CHANGED OF BR-docs IN FRAME Dialog-Frame
      668   DO:
      669   if available buf_c-alc-supp-lic then do:
      670      run proc-view-changes in this-procedure no-error.
      671   END.
      672   END.
      673   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      674   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      675   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      676   on help of frame Dialog-Frame
      677   do:
      678     run gbl/app_help.p
      679       (input this-procedure :file-name
      680       ,input ''
      681       ,input ?
      682       ) no-error.
      683     if error-status :error then do:
      684       message
      685         "Ошибка при вызове помощи"
      686         error-status :get-message(1)
      687         view-as alert-box .
      688     end.
      689   end.
      690   run minbtn-set in this-procedure .
      691   on choose of b-help in frame Dialog-Frame
      692   do:
      693     apply "help":u to frame Dialog-Frame .
      694   end.
      695   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      696   procedure minbtn-set :
      697       do
      698           on error undo, return error return-value
      699           :
      700           define variable ii              as integer       no-undo .
      701           define variable fh              as widget-handle no-undo .
      702           define variable hh              as widget-handle no-undo .
      703           define variable v-h             as handle        extent 4 no-undo .
      704           define variable v-name-button   as character     no-undo .
      705           define variable v-help-old-x    as decimal       no-undo .
      706           define variable v-help-old-y    as decimal       no-undo .
      707           define variable v-help-old-size as decimal       no-undo .
      708           define variable v-frame-width   as decimal       no-undo .
      709           define variable jj              as integer       no-undo .
      710           do
      711               on error undo, return error
      712               :
      713               assign
      714                   v-frame-width = frame Dialog-Frame:width - 0.3
      715                   fh            = frame Dialog-Frame:first-child
      716                   hh            = fh:first-child
      717                   ii            = 1
      718                   .
      719               do while valid-handle(hh):
      720                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      721                   do:
      722                       case lc(hh:name) :
      723                           when "b-help" then
      724                               do:
      725                                   hh:load-image-up("cmp/b-help.bmp":u) .
      726                                   hh:load-image-down("cmp/b-help.bmp":u) .
      727                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      728                                   hh:TOOLTIP = "Помощь" .
      729                                   v-help-old-x = hh:column .
      730                                   v-help-old-y = hh:row    .
      731                                   v-help-old-size = hh:width .
      732                                   hh:width-chars = 2.5 .
      733                               end.
      734                           when "b-print" then
      735                               do:
      736                                   hh:load-image("cmp/b-print.bmp":u) .
      737                                   hh:TOOLTIP = "Печать" .
      738                                   v-h[ii] = hh:handle .
      739                                   ii = ii + 1 .
      740                                   hh:width-chars = 3 .
      741                               end.
      742                           when "b-history" or
      743                           when "b-hist" then
      744                               do:
      745                                   hh:load-image("cmp/b-hist.bmp":u) .
      746                                   hh:TOOLTIP = "История" .
      747                                   v-h[ii] = hh:handle .
      748                                   ii = ii + 1 .
      749                                   hh:width-chars = 3 .
      750                               end.
      751                           when "b-sch" then
      752                               do:
      753                                   hh:load-image("cmp/b-sch.bmp":u) .
      754                                   hh:TOOLTIP = "Установка Фильтра" .
      755                                   v-h[ii] = hh:handle .
      756                                   ii = ii + 1 .
      757                                   hh:width-chars = 3 .
      758                               end.
      759                           when "b-hist-user" then
      760                               do:
      761                                   hh:load-image("cmp/b-hist.bmp":u) .
      762                                   hh:TOOLTIP = "История пользователя" .
      763                                   ii = ii + 1 .
      764                               end.
      765                       end case.
      766                   end.
      767                   hh = hh:next-sibling.
      768               end.
      769               b-help:column = v-frame-width - b-help:width-chars.
      770               jj = 0.
      771               repeat ii = 4 to 1 by -1 :
      772                   if valid-handle (v-h[ii] ) then
      773                   do:
      774                       jj  = jj + 1 .
      775                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      776                       v-h[ii]:row    = v-help-old-y .
      777                   end.
      778               end.
      779           end.
      780       end.
      781   end procedure.
      782   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      783   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      784   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      785   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      786   define variable v-diasize-current-frame-width  as decimal   no-undo .
      787   define variable v-diasize-current-frame-height as decimal   no-undo .
      788   define variable v-diasize-change-size          as logical   no-undo .
      789   define variable v-diasize-resize-button        as handle    no-undo .
      790   define variable v-diasize-wndmax               as logical   no-undo .
      791   define variable v-diasize-wndstore             as logical   no-undo .
      792   define variable v-diasize-proc-name            as character no-undo .
      793   define variable v-diasize-browse-handle        as handle    no-undo .
      794   define variable v-diasize-browse-number        as integer   no-undo .
      795   define variable v-diasize-need-full-display    as logical   no-undo init false .
      796   define temp-table temp-diasize-handle no-undo
      797     field handle-value  as handle
      798     field save-position as decimal
      799     index xpk is primary unique handle-value
      800     .
      801   define temp-table temp-browse-handle no-undo
      802     field browse-type   as character
      803     field browse-number as integer
      804     field browse-handle as handle
      805     field original-size as decimal
      806     index xpk is primary unique browse-type browse-number
      807     index xie browse-type browse-handle
      808   .
      809   procedure diasize_change-height :
      810     define input  parameter p-change-value  as decimal   no-undo .
      811     define input  parameter p-move-resize   as logical   no-undo .
      812     define variable v-field-group-handle    as handle    no-undo .
      813     define variable v-object-handle         as handle    no-undo .
      814     define variable v-frame-height          as decimal   no-undo .
      815     define variable v-frame-virtual-height  as decimal   no-undo .
      816     define variable v-browse-height         as decimal   no-undo .
      817     define variable v-window-height         as decimal   no-undo .
      818     define variable v-window-virtual-height as decimal   no-undo .
      819     define variable v-change-sign           as integer   no-undo .
      820     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      821     define buffer buf_temp-browse-handle  for temp-browse-handle .
      822     if p-change-value > 0
      823     then do:
      824       if frame Dialog-Frame :height + p-change-value
      825           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      826       then do:
      827         assign
      828           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      829                           - (frame Dialog-Frame :height-chars)
      830         .
      831         if p-change-value <= 0
      832         then do:
      833           run diasize_position-resize-button in this-procedure .
      834           return .
      835         end.
      836       end.
      837     end.
      838     if p-change-value < 0
      839     then do:
      840       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      841       then do:
      842         assign
      843           p-change-value = v-diasize-orig-frame-height
      844                          - (frame Dialog-Frame :height-chars)
      845         .
      846         if p-change-value >= 0
      847         then do:
      848           run diasize_position-resize-button in this-procedure .
      849           return .
      850         end.
      851       end.
      852     end.
      853     if p-change-value >= 0
      854     then do:
      855       assign
      856         v-change-sign = 1
      857       .
      858     end.
      859     else do:
      860       assign
      861         v-change-sign = -1
      862       .
      863     end.
      864     assign
      865       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      866     .
      867     if p-change-value = 0
      868     then do:
      869       run diasize_position-resize-button in this-procedure .
      870       return .
      871     end.
      872     move_block:
      873     do
      874     on error undo move_block, retry move_block
      875     :
      876       if retry
      877       then do:
      878         do
      879         on error undo move_block, leave move_block
      880         :
      881           if p-change-value > 0
      882           then do:
      883             for each buf_temp-diasize-handle
      884             on error undo, next
      885             :
      886               assign
      887                 v-object-handle = buf_temp-diasize-handle.handle-value
      888               .
      889               if v-object-handle <> v-diasize-resize-button
      890               then do:
      891                 assign
      892                   v-object-handle :row = buf_temp-diasize-handle.save-position
      893                 .
      894               end.
      895             end.
      896             assign
      897               v-diasize-browse-handle :height = v-browse-height
      898             .
      899             for each buf_temp-browse-handle
      900               where buf_temp-browse-handle.browse-type = 'height':u
      901             on error undo, next
      902             :
      903               assign
      904                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      905               .
      906             end.
      907             assign
      908               frame Dialog-Frame :height = v-frame-height
      909             .
      910             if frame Dialog-Frame :scrollable = true
      911             then do:
      912               assign
      913                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      914               .
      915             end.
      916             run diasize_position-resize-button in this-procedure .
      917           end.
      918           else do:
      919             if frame Dialog-Frame :scrollable = true
      920             then do:
      921               assign
      922                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      923               .
      924             end.
      925             assign
      926               frame Dialog-Frame :height = v-frame-height
      927             .
      928             assign
      929               v-diasize-browse-handle :height = v-browse-height
      930             .
      931             for each buf_temp-browse-handle
      932               where buf_temp-browse-handle.browse-type = 'height':u
      933             on error undo, next
      934             :
      935               assign
      936                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      937               .
      938             end.
      939             for each buf_temp-diasize-handle
      940             on error undo, next
      941             :
      942               assign
      943                 v-object-handle = buf_temp-diasize-handle.handle-value
      944               .
      945               if v-object-handle <> v-diasize-resize-button
      946               then do:
      947                 assign
      948                   v-object-handle :row = buf_temp-diasize-handle.save-position
      949                 .
      950               end.
      951             end.
      952             run diasize_position-resize-button in this-procedure .
      953           end.
      954           assign
      955             v-diasize-change-size = false
      956           .
      957           leave move_block .
      958         end.
      959       end.
      960       assign
      961         v-diasize-need-full-display = true
      962       .
      963       if v-diasize-change-size = false
      964       then do:
      965         assign
      966           v-diasize-change-size = true
      967         .
      968       end.
      969       else do:
      970         return .
      971       end.
      972       assign
      973         v-frame-height = frame Dialog-Frame :height
      974         v-frame-virtual-height = frame Dialog-Frame :virtual-height
      975         v-browse-height = v-diasize-browse-handle :height
      976       .
      977       for each buf_temp-browse-handle
      978         where buf_temp-browse-handle.browse-type = 'height':u
      979       :
      980         assign
      981           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
      982         .
      983       end.
      984       for each buf_temp-diasize-handle
      985       :
      986         delete buf_temp-diasize-handle .
      987       end.
      988       assign
      989         v-field-group-handle = frame Dialog-Frame :first-child
      990       .
      991       do while valid-handle(v-field-group-handle)
      992       :
      993         assign
      994           v-object-handle = v-field-group-handle :first-child
      995         .
      996         do while valid-handle(v-object-handle)
      997         :
      998           if  v-object-handle <> v-diasize-browse-handle :handle
      999           and can-query(v-object-handle, "row")
     1000           and can-query(v-object-handle, "height")
     1001           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1002           then do:
     1003             find first buf_temp-browse-handle
     1004               where buf_temp-browse-handle.browse-type   = 'height':u
     1005                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1006               no-error .
     1007             if available buf_temp-browse-handle
     1008             then do:
     1009             end.
     1010             else do:
     1011               create buf_temp-diasize-handle .
     1012               assign
     1013                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1014                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1015               .
     1016             end.
     1017           end.
     1018           assign
     1019             v-object-handle = v-object-handle :next-sibling
     1020           .
     1021         end.
     1022         assign
     1023           v-field-group-handle = v-field-group-handle :next-sibling
     1024         .
     1025       end.
     1026       do with frame Dialog-Frame
     1027       :
     1028         hide v-diasize-resize-button .
     1029         assign
     1030           v-diasize-resize-button :row    = 1
     1031           v-diasize-resize-button :column = 1
     1032         .
     1033       end.
     1034       if p-change-value > 0
     1035       then do:
     1036         if frame Dialog-Frame :scrollable = true
     1037         then do:
     1038           assign
     1039             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1040             no-error .
     1041           if error-status :error
     1042           or error-status :get-message(1) <> ""
     1043           then do:
     1044             undo move_block, retry move_block .
     1045           end.
     1046         end.
     1047         assign
     1048           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1049           no-error .
     1050         if error-status :error
     1051         or error-status :get-message(1) <> ""
     1052         then do:
     1053           undo move_block, retry move_block .
     1054         end.
     1055         assign
     1056           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1057           no-error .
     1058         if error-status :error
     1059         or error-status :get-message(1) <> ""
     1060         then do:
     1061           undo move_block, retry move_block .
     1062         end.
     1063         for each buf_temp-browse-handle
     1064           where buf_temp-browse-handle.browse-type = 'height':u
     1065         on error undo move_block, retry move_block
     1066         :
     1067           assign
     1068             buf_temp-browse-handle.browse-handle :height
     1069               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1070             no-error .
     1071           if error-status :error
     1072           or error-status :get-message(1) <> ""
     1073           then do:
     1074             undo move_block, retry move_block .
     1075           end.
     1076         end.
     1077         for each buf_temp-diasize-handle
     1078         on error undo move_block, retry move_block
     1079         :
     1080           assign
     1081             v-object-handle = buf_temp-diasize-handle.handle-value
     1082           .
     1083           if v-object-handle <> v-diasize-resize-button
     1084           then do:
     1085             assign
     1086               v-object-handle :row = v-object-handle :row + p-change-value
     1087               no-error .
     1088             if error-status :error
     1089             or error-status :get-message(1) <> ""
     1090             then do:
     1091               undo move_block, retry move_block .
     1092             end.
     1093           end.
     1094         end.
     1095       end.
     1096       else do:
     1097         for each buf_temp-diasize-handle
     1098         on error undo move_block, retry move_block
     1099         :
     1100           assign
     1101             v-object-handle = buf_temp-diasize-handle.handle-value
     1102           .
     1103           if v-object-handle <> v-diasize-resize-button
     1104           then do:
     1105             assign
     1106               v-object-handle :row = v-object-handle :row + p-change-value
     1107               no-error .
     1108             if error-status :error
     1109             or error-status :get-message(1) <> ""
     1110             then do:
     1111               undo move_block, retry move_block .
     1112             end.
     1113           end.
     1114         end.
     1115         assign
     1116           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1117           no-error .
     1118         if error-status :error
     1119         or error-status :get-message(1) <> ""
     1120         then do:
     1121           undo move_block, retry move_block .
     1122         end.
     1123         for each buf_temp-browse-handle
     1124           where buf_temp-browse-handle.browse-type = 'height':u
     1125         on error undo move_block, retry move_block
     1126         :
     1127           assign
     1128             buf_temp-browse-handle.browse-handle :height
     1129               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1130             no-error .
     1131           if error-status :error
     1132           or error-status :get-message(1) <> ""
     1133           then do:
     1134             undo move_block, retry move_block .
     1135           end.
     1136         end.
     1137         assign
     1138           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1139           no-error .
     1140         if error-status :error
     1141         or error-status :get-message(1) <> ""
     1142         then do:
     1143           undo move_block, retry move_block .
     1144         end.
     1145         if frame Dialog-Frame :scrollable = true
     1146         then do:
     1147           assign
     1148             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1149             no-error .
     1150           if error-status :error
     1151           or error-status :get-message(1) <> ""
     1152           then do:
     1153             undo move_block, retry move_block .
     1154           end.
     1155         end.
     1156       end.
     1157       if p-move-resize = true
     1158       then do:
     1159         run diasize_position-resize-button in this-procedure .
     1160       end.
     1161       if v-diasize-wndstore = true
     1162       then do:
     1163         if connected("ub") = true
     1164         then do:
     1165           define variable v-cntxt-db-num        as integer   no-undo .
     1166           define variable v-cntxt-userid        as character no-undo .
     1167           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1168                                             , OUTPUT v-cntxt-userid
     1169                                             ) .
     1170           run gbl/wndsizew.p
     1171             (input  v-cntxt-db-num
     1172             ,input  v-cntxt-userid
     1173             ,input  v-diasize-proc-name
     1174             ,input  'height':u
     1175             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1176             ) .
     1177         end.
     1178       end.
     1179     end.
     1180     assign
     1181       v-diasize-change-size = false
     1182     .
     1183   end procedure.
     1184   procedure diasize_set-height :
     1185     define input  parameter p-new-height  as decimal   no-undo .
     1186     define input  parameter p-move-resize as logical   no-undo .
     1187     do
     1188     on error undo, return error return-value
     1189     :
     1190       run diasize_change-height in this-procedure
     1191         (input  (p-new-height - frame Dialog-Frame :height)
     1192         ,input  p-move-resize
     1193         ) .
     1194     end.
     1195   end procedure.
     1196   procedure diasize_change-width :
     1197     define input  parameter p-change-value as decimal   no-undo .
     1198     define input  parameter p-move-resize  as logical   no-undo .
     1199     define variable v-field-group-handle   as handle    no-undo .
     1200     define variable v-object-handle        as handle    no-undo .
     1201     define variable v-frame-width          as decimal   no-undo .
     1202     define variable v-frame-virtual-width  as decimal   no-undo .
     1203     define variable v-browse-width         as decimal   no-undo .
     1204     define variable v-window-width         as decimal   no-undo .
     1205     define variable v-window-virtual-width as decimal   no-undo .
     1206     define variable v-change-sign          as integer   no-undo .
     1207     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1208     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1209     if p-change-value > 0
     1210     then do:
     1211       if frame Dialog-Frame :width + p-change-value >
     1212           session :width-chars
     1213       then do:
     1214         assign
     1215           p-change-value = session :width-chars - frame Dialog-Frame :width
     1216         .
     1217         if p-change-value <= 0
     1218         then do:
     1219           run diasize_position-resize-button in this-procedure .
     1220           return .
     1221         end.
     1222       end.
     1223     end.
     1224     if p-change-value < 0
     1225     then do:
     1226       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1227       then do:
     1228         assign
     1229           p-change-value = v-diasize-orig-frame-width
     1230                          - frame Dialog-Frame :width
     1231         .
     1232         if p-change-value >= 0
     1233         then do:
     1234           run diasize_position-resize-button in this-procedure .
     1235           return .
     1236         end.
     1237       end.
     1238     end.
     1239     if p-change-value >= 0
     1240     then do:
     1241       assign
     1242         v-change-sign = 1
     1243       .
     1244     end.
     1245     else do:
     1246       assign
     1247         v-change-sign = -1
     1248       .
     1249     end.
     1250     assign
     1251       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1252     .
     1253     if p-change-value = 0
     1254     then do:
     1255       run diasize_position-resize-button in this-procedure .
     1256       return .
     1257     end.
     1258     move_block:
     1259     do
     1260     on error undo move_block, leave move_block
     1261     :
     1262       if retry
     1263       then do:
     1264         do
     1265         on error undo move_block, leave move_block
     1266         :
     1267           if p-change-value > 0
     1268           then do:
     1269             for each buf_temp-diasize-handle
     1270             on error undo, next
     1271             :
     1272               assign
     1273                 v-object-handle = buf_temp-diasize-handle.handle-value
     1274               .
     1275               if v-object-handle <> v-diasize-resize-button
     1276               then do:
     1277                 assign
     1278                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1279                 .
     1280               end.
     1281             end.
     1282             assign
     1283               v-diasize-browse-handle :width = v-browse-width
     1284             .
     1285             for each buf_temp-browse-handle
     1286               where buf_temp-browse-handle.browse-type = 'width':u
     1287             on error undo, next
     1288             :
     1289               assign
     1290                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1291               .
     1292             end.
     1293             assign
     1294               frame Dialog-Frame :width = v-frame-width
     1295             .
     1296             if frame Dialog-Frame :scrollable = true
     1297             then do:
     1298               assign
     1299                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1300               .
     1301             end.
     1302             run diasize_position-resize-button in this-procedure .
     1303           end.
     1304           else do:
     1305             if frame Dialog-Frame :scrollable = true
     1306             then do:
     1307               assign
     1308                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1309               .
     1310             end.
     1311             assign
     1312               frame Dialog-Frame :width = v-frame-width
     1313             .
     1314             for each buf_temp-browse-handle
     1315               where buf_temp-browse-handle.browse-type = 'width':u
     1316             on error undo, next
     1317             :
     1318               assign
     1319                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1320               .
     1321             end.
     1322             assign
     1323               v-diasize-browse-handle :width = v-browse-width
     1324             .
     1325             for each buf_temp-diasize-handle
     1326             on error undo, next
     1327             :
     1328               assign
     1329                 v-object-handle = buf_temp-diasize-handle.handle-value
     1330               .
     1331               if v-object-handle <> v-diasize-resize-button
     1332               then do:
     1333                 assign
     1334                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1335                 .
     1336               end.
     1337             end.
     1338             run diasize_position-resize-button in this-procedure .
     1339           end.
     1340           assign
     1341             v-diasize-change-size = false
     1342           .
     1343           leave move_block .
     1344         end.
     1345       end.
     1346       assign
     1347         v-diasize-need-full-display = true
     1348       .
     1349       if v-diasize-change-size = false
     1350       then do:
     1351         assign
     1352           v-diasize-change-size = true
     1353         .
     1354       end.
     1355       else do:
     1356         return .
     1357       end.
     1358       assign
     1359         v-frame-width = frame Dialog-Frame :width
     1360         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1361         v-browse-width = v-diasize-browse-handle :width
     1362       .
     1363       for each buf_temp-browse-handle
     1364         where buf_temp-browse-handle.browse-type = 'width':u
     1365       :
     1366         assign
     1367           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1368         .
     1369       end.
     1370       for each buf_temp-diasize-handle
     1371       :
     1372         delete buf_temp-diasize-handle .
     1373       end.
     1374       assign
     1375         v-field-group-handle = frame Dialog-Frame :first-child
     1376       .
     1377       do while valid-handle(v-field-group-handle)
     1378       :
     1379         assign
     1380           v-object-handle = v-field-group-handle :first-child
     1381         .
     1382         do while valid-handle(v-object-handle)
     1383         :
     1384           if  v-object-handle <> v-diasize-browse-handle :handle
     1385           and v-object-handle <> v-diasize-resize-button
     1386           and can-query(v-object-handle, "row")
     1387           and can-query(v-object-handle, "height")
     1388           and ( v-object-handle :col + v-object-handle :width
     1389                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1390               )
     1391           then do:
     1392             find first buf_temp-browse-handle
     1393               where buf_temp-browse-handle.browse-type   = 'width':u
     1394                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1395               no-error .
     1396             if available buf_temp-browse-handle
     1397             then do:
     1398             end.
     1399             else do:
     1400               create buf_temp-diasize-handle .
     1401               assign
     1402                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1403                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1404               .
     1405             end.
     1406           end.
     1407           assign
     1408             v-object-handle = v-object-handle :next-sibling
     1409           .
     1410         end.
     1411         assign
     1412           v-field-group-handle = v-field-group-handle :next-sibling
     1413         .
     1414       end.
     1415       do with frame Dialog-Frame
     1416       :
     1417         hide v-diasize-resize-button .
     1418         v-diasize-resize-button :row = 1.
     1419         v-diasize-resize-button :column = 1.
     1420       end.
     1421       if p-change-value > 0
     1422       then do:
     1423         if frame Dialog-Frame :scrollable = true
     1424         then do:
     1425           assign
     1426             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1427             no-error .
     1428           if error-status :error
     1429           or error-status :get-message(1) <> ""
     1430           then do:
     1431             undo move_block, retry move_block.
     1432           end.
     1433         end.
     1434         assign
     1435           frame Dialog-Frame :width = v-frame-width + p-change-value
     1436           no-error .
     1437         if error-status :error
     1438         or error-status :get-message(1) <> ""
     1439         then do:
     1440           undo move_block, retry move_block.
     1441         end.
     1442         assign
     1443           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1444         no-error .
     1445         if error-status :error
     1446         or error-status :get-message(1) <> ""
     1447         then do:
     1448           undo move_block, retry move_block.
     1449         end.
     1450         for each buf_temp-browse-handle
     1451           where buf_temp-browse-handle.browse-type = 'width':u
     1452         on error undo move_block, retry move_block
     1453         :
     1454           assign
     1455             buf_temp-browse-handle.browse-handle :width
     1456               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1457             no-error .
     1458           if error-status :error
     1459           or error-status :get-message(1) <> ""
     1460           then do:
     1461             undo move_block, retry move_block .
     1462           end.
     1463         end.
     1464         for each buf_temp-diasize-handle
     1465         on error undo move_block, retry move_block
     1466         :
     1467           assign
     1468             v-object-handle = buf_temp-diasize-handle.handle-value
     1469           .
     1470           if v-object-handle <> v-diasize-resize-button
     1471           then do:
     1472             assign
     1473               v-object-handle :col = v-object-handle :col + p-change-value
     1474               no-error .
     1475             if error-status :error
     1476             or error-status :get-message(1) <> ""
     1477             then do:
     1478               undo move_block, retry move_block .
     1479             end.
     1480           end.
     1481         end.
     1482       end.
     1483       else do:
     1484         for each buf_temp-diasize-handle
     1485         on error undo move_block, retry move_block
     1486         :
     1487           assign
     1488             v-object-handle = buf_temp-diasize-handle.handle-value
     1489           .
     1490           if v-object-handle <> v-diasize-resize-button
     1491           then do:
     1492             assign
     1493               v-object-handle :col = v-object-handle :col + p-change-value
     1494               no-error .
     1495             if error-status :error
     1496             or error-status :get-message(1) <> ""
     1497             then do:
     1498               undo move_block, retry move_block .
     1499             end.
     1500           end.
     1501         end.
     1502         for each buf_temp-browse-handle
     1503           where buf_temp-browse-handle.browse-type = 'width':u
     1504         on error undo move_block, retry move_block
     1505         :
     1506           assign
     1507             buf_temp-browse-handle.browse-handle :width
     1508               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1509             no-error .
     1510           if error-status :error
     1511           or error-status :get-message(1) <> ""
     1512           then do:
     1513             undo move_block, retry move_block .
     1514           end.
     1515         end.
     1516         assign
     1517           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1518           no-error .
     1519         if error-status :error
     1520         or error-status :get-message(1) <> ""
     1521         then do:
     1522           undo move_block, retry move_block.
     1523         end.
     1524         assign
     1525           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1526         no-error .
     1527         if error-status :error
     1528         or error-status :get-message(1) <> ""
     1529         then do:
     1530           undo move_block, retry move_block.
     1531         end.
     1532         if frame Dialog-Frame :scrollable = true
     1533         then do:
     1534           assign
     1535             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1536           no-error .
     1537           if error-status :error
     1538           or error-status :get-message(1) <> ""
     1539           then do:
     1540             undo move_block, retry move_block.
     1541           end.
     1542         end.
     1543       end.
     1544       if p-move-resize
     1545       then do:
     1546         run diasize_position-resize-button in this-procedure .
     1547       end.
     1548       if v-diasize-wndstore = true
     1549       then do:
     1550         if connected("ub") = true
     1551         then do:
     1552           define variable v-cntxt-db-num        as integer   no-undo .
     1553           define variable v-cntxt-userid        as character no-undo .
     1554           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1555                                             , OUTPUT v-cntxt-userid
     1556                                             ) .
     1557           run gbl/wndsizew.p
     1558             (input  v-cntxt-db-num
     1559             ,input  v-cntxt-userid
     1560             ,input  v-diasize-proc-name
     1561             ,input  'width':u
     1562             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1563             ) .
     1564         end.
     1565       end.
     1566     end.
     1567     assign
     1568       v-diasize-change-size = false
     1569     .
     1570   end procedure.
     1571   procedure diasize_set-width :
     1572     define input  parameter p-new-width  as decimal   no-undo .
     1573     define input  parameter p-move-resize as logical   no-undo .
     1574     do
     1575     on error undo, return error return-value
     1576     :
     1577       run diasize_change-width in this-procedure
     1578         (input  (p-new-width - frame Dialog-Frame :width)
     1579         ,input  p-move-resize
     1580         ) .
     1581     end.
     1582   end procedure.
     1583   procedure diasize_position-resize-button :
     1584     do with frame Dialog-Frame
     1585     :
     1586       hide v-diasize-resize-button .
     1587       assign
     1588         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1589                     - 1
     1590                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1591         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1592                     - 1
     1593                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1594       .
     1595       view v-diasize-resize-button .
     1596     end.
     1597   end procedure.
     1598   on alt-right anywhere
     1599   do:
     1600     run diasize_change-width in this-procedure
     1601       (input 1
     1602       ,input true
     1603       ) .
     1604     return no-apply .
     1605   end.
     1606   on alt-left anywhere
     1607   do:
     1608     run diasize_change-width in this-procedure
     1609       (input -1
     1610       ,input true
     1611       ) .
     1612     return no-apply .
     1613   end.
     1614   on alt-down anywhere
     1615   do:
     1616     run diasize_change-height in this-procedure
     1617       (input 1
     1618       ,input true
     1619       ) .
     1620     return no-apply .
     1621   end.
     1622   on alt-up anywhere
     1623   do:
     1624     run diasize_change-height in this-procedure
     1625       (input -1
     1626       ,input true
     1627       ) .
     1628     return no-apply .
     1629   end.
     1630   on alt-enter of frame Dialog-Frame
     1631   do:
     1632     run diasize_maximize in this-procedure
     1633       (input  ?
     1634       ).
     1635     return no-apply .
     1636   end.
     1637   procedure diasize_end-move :
     1638     do
     1639     on error undo, return error return-value
     1640     :
     1641       define variable v-row-delta as decimal   no-undo .
     1642       define variable v-col-delta as decimal   no-undo .
     1643       define variable v-new-row as decimal   no-undo .
     1644       define variable v-new-col as decimal   no-undo .
     1645       assign
     1646         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1647         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1648       .
     1649       assign
     1650         v-row-delta = v-new-row - frame Dialog-Frame :height
     1651         v-col-delta = v-new-col - frame Dialog-Frame :width
     1652       .
     1653       run diasize_change-height in this-procedure
     1654         (input v-row-delta
     1655         ,input true
     1656         ) .
     1657       run diasize_change-width in this-procedure
     1658         (input v-col-delta
     1659         ,input true
     1660         ) .
     1661     end.
     1662   end procedure.
     1663   procedure diasize_maximize :
     1664     define input  parameter p-action as logical   no-undo .
     1665     do
     1666     on error undo, return error return-value
     1667     :
     1668       if p-action = ?
     1669       then do:
     1670         if v-diasize-need-maximize = true
     1671         then do:
     1672           assign
     1673             p-action = true
     1674           .
     1675         end.
     1676         else do:
     1677           assign
     1678             p-action = false
     1679           .
     1680         end.
     1681       end.
     1682       if p-action = true
     1683       then do:
     1684         run diasize_change-height in this-procedure
     1685           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1686               - frame Dialog-Frame :height-chars
     1687           ,input true
     1688           ) .
     1689         run diasize_change-width in this-procedure
     1690           (input session :width-chars
     1691               - frame Dialog-Frame :width-chars
     1692           ,input true
     1693           ) .
     1694         assign
     1695           v-diasize-need-maximize = false
     1696         .
     1697       end.
     1698       else do:
     1699         run diasize_change-width in this-procedure
     1700           (input v-diasize-orig-frame-width
     1701               - frame Dialog-Frame :width-chars
     1702           ,input true
     1703           ) .
     1704         run diasize_change-height in this-procedure
     1705           (input v-diasize-orig-frame-height
     1706               - frame Dialog-Frame :height-chars
     1707           ,input true
     1708           ) .
     1709         assign
     1710           v-diasize-need-maximize = true
     1711         .
     1712       end.
     1713     end.
     1714   end procedure.
     1715   procedure diasize_restore-orig-size :
     1716     do
     1717     on error undo, return error return-value
     1718     :
     1719       assign
     1720         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1721         v-diasize-current-frame-height = frame Dialog-Frame :height
     1722       .
     1723       run diasize_set-height in this-procedure
     1724         (input  v-diasize-orig-frame-height
     1725         ,input  true
     1726         ) .
     1727       run diasize_set-width in this-procedure
     1728         (input  v-diasize-orig-frame-width
     1729         ,input  true
     1730         ) .
     1731     end.
     1732   end procedure.
     1733   procedure diasize_restore-current-size :
     1734     do
     1735     on error undo, return error return-value
     1736     :
     1737       run diasize_set-height in this-procedure
     1738         (input  v-diasize-current-frame-height
     1739         ,input  true
     1740         ) .
     1741       run diasize_set-width in this-procedure
     1742         (input  v-diasize-current-frame-width
     1743         ,input  true
     1744         ) .
     1745     end.
     1746   end procedure.
     1747   procedure diasize_set-browse-handle :
     1748     define input  parameter p-browse-handle as handle   no-undo .
     1749     define buffer buf_temp-browse-handle for temp-browse-handle .
     1750     do
     1751     on error undo, return error return-value
     1752     :
     1753       assign
     1754         v-diasize-browse-handle = p-browse-handle
     1755       .
     1756       for each buf_temp-browse-handle
     1757       on error undo, return error return-value
     1758       :
     1759         delete buf_temp-browse-handle .
     1760       end.
     1761     end.
     1762   end procedure.
     1763   procedure diasize_add_browse :
     1764     define input  parameter p-browse-type   as character no-undo .
     1765     define input  parameter p-browse-handle as handle    no-undo .
     1766     define buffer buf_temp-browse-handle for temp-browse-handle .
     1767     do
     1768     on error undo, return error return-value
     1769     :
     1770       assign
     1771         v-diasize-browse-number = v-diasize-browse-number + 1
     1772       .
     1773       create buf_temp-browse-handle .
     1774       assign
     1775         buf_temp-browse-handle.browse-type   = p-browse-type
     1776         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1777         buf_temp-browse-handle.browse-handle = p-browse-handle
     1778       .
     1779     end.
     1780   end procedure.
     1781   procedure diasize_init :
     1782     define variable v-default-value    as logical   no-undo .
     1783     define variable v-restore-saved    as logical   no-undo .
     1784     define variable v-resize-value-str as character no-undo .
     1785     do
     1786     on error undo, return error return-value
     1787     :
     1788       do with frame Dialog-Frame
     1789       :
     1790         assign
     1791           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1792           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1793           v-diasize-browse-handle     = browse BR-changes :handle
     1794         .
     1795         create button v-diasize-resize-button
     1796         assign
     1797           parent        = frame Dialog-Frame :first-child
     1798           label         = "s"
     1799           height-pixels = 16
     1800           width-pixels  = 16
     1801           visible       = true
     1802           sensitive     = true
     1803           movable       = true
     1804           triggers:
     1805             on end-move persistent run diasize_end-move in this-procedure .
     1806           end triggers.
     1807         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1808         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1809         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1810         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1811         assign
     1812           v-diasize-wndmax = false
     1813         .
     1814         if connected("ub") = true
     1815         then do:
     1816           define variable v-cntxt-db-num        as integer   no-undo .
     1817           define variable v-cntxt-userid        as character no-undo .
     1818           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1819                                             , OUTPUT v-cntxt-userid
     1820                                             ) .
     1821           run gbl/wndpar_r.p
     1822             (input  v-cntxt-db-num
     1823             ,input  v-cntxt-userid
     1824             ,input  'wndmax':U
     1825             ,output v-diasize-wndmax
     1826             ,output v-default-value
     1827             ) .
     1828         end.
     1829         assign
     1830           v-diasize-wndstore = false
     1831         .
     1832         if connected("ub") = true
     1833         then do:
     1834           run gbl/wndpar_r.p
     1835             (input  v-cntxt-db-num
     1836             ,input  v-cntxt-userid
     1837             ,input  'wndstore':U
     1838             ,output v-diasize-wndstore
     1839             ,output v-default-value
     1840             ) .
     1841         end.
     1842         assign
     1843           v-diasize-proc-name = entry(1, program-name(2), '.')
     1844         .
     1845         if v-diasize-wndstore = true
     1846         then do:
     1847           assign
     1848             v-restore-saved = false
     1849           .
     1850           if connected("ub") = true
     1851           then do:
     1852             run gbl/wndsizer.p
     1853               (input  v-cntxt-db-num
     1854               ,input  v-cntxt-userid
     1855               ,input  v-diasize-proc-name
     1856               ,input  'height':u
     1857               ,output v-resize-value-str
     1858               ) .
     1859             if v-resize-value-str <> '':U
     1860             then do:
     1861               run diasize_change-height in this-procedure
     1862                 (input  integer(v-resize-value-str)
     1863                 ,input  true
     1864                 ) .
     1865               assign
     1866                 v-restore-saved = true
     1867               .
     1868             end.
     1869           end.
     1870           if connected("ub") = true
     1871           then do:
     1872             run gbl/wndsizer.p
     1873               (input  v-cntxt-db-num
     1874               ,input  v-cntxt-userid
     1875               ,input  v-diasize-proc-name
     1876               ,input  'width':u
     1877               ,output v-resize-value-str
     1878               ) .
     1879             if v-resize-value-str <> '':U
     1880             then do:
     1881               run diasize_change-width in this-procedure
     1882                 (input  integer(v-resize-value-str)
     1883                 ,input  true
     1884                 ) .
     1885               assign
     1886                 v-restore-saved = true
     1887               .
     1888             end.
     1889           end.
     1890           if v-restore-saved <> true
     1891           then do:
     1892             if v-diasize-wndmax = true
     1893             then do:
     1894               run diasize_maximize in this-procedure
     1895                 (input  true
     1896                 ) .
     1897             end.
     1898           end.
     1899         end.
     1900         else do:
     1901           if v-diasize-wndmax = true
     1902           then do:
     1903             run diasize_maximize in this-procedure
     1904               (input  true
     1905               ) .
     1906           end.
     1907         end.
     1908       end.
     1909     end.
     1910   end procedure.
     1911   procedure diasize_need-full-display :
     1912     define output parameter p-need-full-display as logical   no-undo .
     1913     do
     1914     on error undo, return error return-value
     1915     :
     1916       assign
     1917         p-need-full-display = v-diasize-need-full-display
     1918       .
     1919       assign
     1920         v-diasize-need-full-display = false
     1921       .
     1922     end.
     1923   end procedure.
     1924   procedure get-context :
     1925      define output parameter p-db-num as integer          no-undo.
     1926      define output parameter p-user-id as character        no-undo.
     1927      define variable v-login               as character    no-undo.
     1928      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1929      define buffer buf_user-login  for ub.user-login .
     1930      do
     1931      on error undo, return error
     1932      :
     1933            FIND FIRST buf_sys-ctrl no-lock.
     1934            ASSIGN
     1935               v-login = USERID("ub")
     1936               p-db-num = buf_sys-ctrl.db-num
     1937            .
     1938            FIND FIRST buf_user-login
     1939                 WHERE buf_user-login.db-num = p-db-num
     1940                   AND buf_user-login.user-login = v-login
     1941                 no-lock
     1942                 no-error
     1943                 .
     1944            IF AVAILABLE buf_user-login
     1945            THEN DO:
     1946               assign
     1947                  p-user-id = buf_user-login.user-id
     1948               .
     1949            END.
     1950      end.
     1951   end procedure.
     1952       run diasize_init in this-procedure .
     1953   MAIN-BLOCK:
     1954   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1955      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1956   define variable p-file-label as character no-undo .
     1957     run my-enable_ui in this-procedure .
     1958     run openbr in this-procedure .
     1959     hide mark-num in frame Dialog-Frame .
     1960     apply "VALUE-CHANGED" to br-docs in frame Dialog-Frame.
     1961     wait-for go of frame Dialog-Frame.
     1962   END.
     1963   run disable_UI in this-procedure .
     1964   PROCEDURE disable_UI :
     1965     HIDE FRAME Dialog-Frame.
     1966   END PROCEDURE.
     1967   PROCEDURE enable_UI :
     1968     OPEN QUERY Dialog-Frame FOR EACH ub.c-alc-supp-lic SHARE-LOCK.
     1969     GET FIRST Dialog-Frame.
     1970     DISPLAY mark-num
     1971         WITH FRAME Dialog-Frame.
     1972     ENABLE B-Cancel B-Help BR-docs BR-changes mark-num
     1973         WITH FRAME Dialog-Frame.
     1974     VIEW FRAME Dialog-Frame.
     1975     OPEN QUERY BR-docs FOR EACH buf_c-alc-supp-lic no-lock.
     1976   END PROCEDURE.
     1977   PROCEDURE my-enable_UI :
     1978   DISPLAY   mark-num
     1979         WITH FRAME Dialog-Frame.
     1980     ENABLE B-Cancel
     1981            B-Help
     1982            BR-docs
     1983            BR-changes
     1984         WITH FRAME Dialog-Frame.
     1985     VIEW FRAME Dialog-Frame.
     1986   END PROCEDURE.
     1987   PROCEDURE OpenBr :
     1988   OPEN QUERY BR-docs FOR EACH buf_c-alc-supp-lic where
     1989              buf_c-alc-supp-lic.alc-supp-lic-code = par-alc-supp-lic-code and
     1990              buf_c-alc-supp-lic.create-user-db-num   = par-db-num
     1991              no-lock.
     1992   APPLY "VALUE-CHANGED" TO br-docs in frame Dialog-Frame.
     1993   APPLY "ENTRY" TO br-docs.
     1994   END PROCEDURE.
     1995   PROCEDURE proc-view-changes :
     1996   define buffer new_c-alc-supp-lic for ub.c-alc-supp-lic.
     1997   define buffer current_alc-supp-lic for ub.alc-supp-lic.
     1998   define variable v-chg-fields as character no-undo.
     1999   define variable v-old-fields as character no-undo.
     2000   define variable v-new-fields as character no-undo.
     2001   define variable ii as integer no-undo.
     2002   for each temp-changes:
     2003       delete temp-changes.
     2004   END.
     2005   if not available buf_c-alc-supp-lic then do:
     2006     Open QUery br-changes for each temp-changes.
     2007     return.
     2008   end.
     2009   find first new_c-alc-supp-lic no-lock where
     2010              new_c-alc-supp-lic.alc-supp-lic-code  = buf_c-alc-supp-lic.alc-supp-lic-code
     2011          and new_c-alc-supp-lic.create-user-db-num    = buf_c-alc-supp-lic.create-user-db-num
     2012          AND new_c-alc-supp-lic.chip-num  > buf_c-alc-supp-lic.chip-num no-error.
     2013   if not available new_c-alc-supp-lic then do:
     2014       find first current_alc-supp-lic no-lock where
     2015                  current_alc-supp-lic.alc-supp-lic-code  = buf_c-alc-supp-lic.alc-supp-lic-code and
     2016                  current_alc-supp-lic.create-user-db-num    = buf_c-alc-supp-lic.create-user-db-num no-error.
     2017            if not available current_alc-supp-lic then do:
     2018            return error.
     2019       end.
     2020       buffer-compare current_alc-supp-lic to buf_c-alc-supp-lic
     2021       CASE-SENSITIVE
     2022       save result in v-chg-fields.
     2023   end.
     2024   else do:
     2025       buffer-compare new_c-alc-supp-lic except chip-num corr-date corr-user-name corr-user-db-num to buf_c-alc-supp-lic
     2026       CASE-SENSITIVE
     2027       save result in v-chg-fields.
     2028   end.
     2029   define variable v-nn as integer   no-undo .
     2030   v-nn = num-entries(v-chg-fields).
     2031   do ii = 1 to v-nn :
     2032   CASE entry(ii, v-chg-fields):
     2033   when "alc-supp-lic-code":U then do:     create temp-changes.     assign     temp-changes.f_name = "alc-supp-lic-code":U     temp-changes.l_name = "Код"     temp-changes.v_old = string(buf_c-alc-supp-lic.alc-supp-lic-code)     temp-changes.v_new = (if available new_c-alc-supp-lic                               then string(new_c-alc-supp-lic.alc-supp-lic-code)                               else string(current_alc-supp-lic.alc-supp-lic-code))     .   end.
     2034   when "create-user-db-num":U then do:     create temp-changes.     assign     temp-changes.f_name = "create-user-db-num":U     temp-changes.l_name = "БД"     temp-changes.v_old = string(buf_c-alc-supp-lic.create-user-db-num)     temp-changes.v_new = (if available new_c-alc-supp-lic                               then string(new_c-alc-supp-lic.create-user-db-num)                               else string(current_alc-supp-lic.create-user-db-num))     .   end.
     2035   END CASE.
     2036   end.
     2037   Open QUery br-changes for each temp-changes.
     2038   END PROCEDURE.
