     3136   procedure get-context :
     3137      define output parameter p-db-num as integer          no-undo.
     3138      define output parameter p-user-id as character        no-undo.
     3139      define variable v-login               as character    no-undo.
     3140      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     3141      define buffer buf_user-login  for ub.user-login .
     3142      do
     3143      on error undo, return error
     3144      :
     3145            FIND FIRST buf_sys-ctrl no-lock.
     3146            ASSIGN
     3147               v-login = USERID("ub")
     3148               p-db-num = buf_sys-ctrl.db-num
     3149            .
     3150            FIND FIRST buf_user-login
     3151                 WHERE buf_user-login.db-num = p-db-num
     3152                   AND buf_user-login.user-login = v-login
     3153                 no-lock
     3154                 no-error
     3155                 .
     3156            IF AVAILABLE buf_user-login
     3157            THEN DO:
     3158               assign
     3159                  p-user-id = buf_user-login.user-id
     3160               .
     3161            END.
     3162      end.
     3163   end procedure.
