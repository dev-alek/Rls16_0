       77   procedure gds-attr-name :
       78     define input  parameter p-code           as character no-undo .
       79     define output parameter p-type           as character no-undo .
       80     define output parameter p-format         as character no-undo .
       81     define output parameter p-label          as character no-undo .
       82     define output parameter p-user-can-edit  as logical   no-undo .
       83     define output parameter p-output-display as logical   no-undo .
       84     define output parameter p-other          as character no-undo .
       85     do
       86     on error undo, return error
       87     :
       88           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-name in g#attr-lib
       89         (input  p-code
       90         ,output p-type
       91         ,output p-format
       92         ,output p-label
       93         ,output p-user-can-edit
       94         ,output p-output-display
       95         ,output p-other
       96         ) no-error .
       97       if error-status :error
       98       then do:
       99         undo, return error return-value .
      100       end.
      101     end.
      102   end procedure.
