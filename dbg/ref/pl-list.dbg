     1648   ON CHOOSE OF B-hist IN FRAME d-pl-list
     1649     DO:
     1650       define variable loc-rid-list as character no-undo .
     1651       if available X_place THEN
     1652         run ref/cplchist.w (
     1653           INPUT parParentProc
     1654           , input p-obj-type
     1655           , input p-obj-code
     1656           , input "":U
     1657           , input "one":U
     1658           , input X_place.obj-type
     1659           , input X_place.obj-code
     1660           , input X_place.pl-code
     1661           , input 0
     1662           , input 0
     1663           , input 0
     1664           , input '':U
     1665           , input-output loc-rid-list
     1666           ) no-error .
     1667       apply "entry" to br-pl.
     1668     END.
     1669   ON CHOOSE OF b-level IN FRAME d-pl-list
     1670     DO:
     1671       define variable v-recid as recid no-undo .
     1672       if not avail X_place then return no-apply.
     1673       run ref/pl-lvls.w   ( input parparentproc
     1674         , input p-obj-type
     1675         , input p-obj-code
     1676         , input X_place.pl-code
     1677         ) no-error.
     1678       IF ERROR-STATUS:ERROR THEN
     1679       DO:
     1680         message
     1681           error-status:get-message(1) skip
     1682           return-value
     1683           view-as alert-box error .
