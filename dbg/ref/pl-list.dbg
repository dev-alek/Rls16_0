     1457       if error-status :error then
     1458       do:
     1459         return no-apply.
     1460       end.
     1461     END.
     1462   ON CHOOSE OF b-chg IN FRAME d-pl-list
     1463     DO:
     1464       define variable v-rep-rec as recid no-undo .
