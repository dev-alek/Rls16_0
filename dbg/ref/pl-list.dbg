     1419       (input  v-cntxt-db-num
     1420       ,input  v-cntxt-userid
     1421       ,input  0
     1422       ,input  'actn_place-reference_work':U
     1423       ,input  'object':U
     1424       ,input  v-chk-act-host-code
     1425       ,input  p-obj-type
     1426       ,input  p-obj-code
     1427       ,input  0
     1428       ,input  0
     1429       ,input  0
     1430       ,input  true
     1431       ,output glog
     1432       )  .
     1433   end.
     1434       if NOT glog then return no-apply.
     1435       run ref/pl-form.w (
     1436         input parparentproc
     1437         ,input 'ДОБАВЛЕНИЕ':U
     1438         ,input p-obj-type
     1439         ,input p-obj-code
     1440         ,input 0
     1441         ,input-output v-rep-rec).
     1442       if v-rep-rec <> ? then
