     1509   ON CHOOSE OF b-del IN FRAME d-pl-list
     1510     DO:
     1511       define variable placelog as logical no-undo.
     1512       define variable new-rec  as recid   no-undo.
     1513       define buffer buf_place for ub.place.
     1514       assign rs-stat.
     1515       if not available X_place then
     1516       do:
     1517         message "Неправильно выбрана строка." view-as alert-box .
     1518         return no-apply.
     1519       end.
     1520   define variable vss-include-info10 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1521   do:
     1522     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1523       (input  v-cntxt-db-num
     1524       ,input  v-cntxt-userid
     1525       ,input  0
     1526       ,input  'actn_place-reference_work':U
     1527       ,input  'object':U
     1528       ,input  v-chk-act-host-code
     1529       ,input  p-obj-type
     1530       ,input  p-obj-code
     1531       ,input  0
     1532       ,input  0
     1533       ,input  0
     1534       ,input  true
     1535       ,output glog
     1536       )  .
     1537   end.
     1538       if not glog then
     1539       do:
     1540         return no-apply.
     1541       end.
     1542       v-doc-rec = recid (X_place).
     1543       assign
     1544         glog = no
     1545         .
     1546       find buf_place exclusive-lock
     1547         where recid(buf_place) = v-doc-rec
     1548         .
     1549       _deletion:
     1550       do on stop undo _deletion, return no-apply:
     1551         assign
     1552           glog = no
     1553           .
     1554         find first pl-gds-pump where pl-gds-pump.obj-type = buf_place.obj-type and
     1555           pl-gds-pump.obj-code = buf_place.obj-code and
     1556           pl-gds-pump.pl-code = buf_place.pl-code
     1557           no-error.
     1558         if available pl-gds-pump then
     1559         do:
     1560           message "К резервуару привязан товар!" skip
     1561             "Для удаления данного резервуара удалите данную связку!"
     1562             view-as alert-box ERROR.
     1563           return no-apply.
     1564         end.
     1565         if  buf_place.status_ <> 'удал':U then
     1566         do:
     1567           message  "Удалить складское место?" skip(0)
     1568             view-as alert-box QUestion buttons yes-no update del-choice.
     1569           if del-choice = yes then
     1570           do:
     1571             run trg/placedv.p
     1572               ( input buf_place.obj-type
     1573               ,input buf_place.obj-code
     1574               ,input buf_place.pl-code
     1575               ,output glog
     1576               ) no-error.
     1577             if glog = yes then
     1578             do:
     1579               buf_place.status_ = "".
     1580               delete buf_place.
     1581               br-pl:delete-current-row().
     1582             end.
     1583             else
     1584             do:
     1585               buf_place.status_ = 'удал':U.
     1586   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rum-runa in g#library
     1587     (input ?
     1588     ,input this-procedure:handle
     1589     ,input ?
     1590     ,input 'ref-event':U
     1591     ,input  buffer buf_place:handle
     1592     ,input ''
     1593     ,input ''
     1594     ,input ''
     1595     ) no-error .
