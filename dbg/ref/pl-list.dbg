     3694       end.
     3695     end.
     3696     case sort-column-name :
     3697       when "" then
     3698         do:
     3699           assign
     3700             sort-column-phrase = ""
     3701             .
     3702         end.
     3703       otherwise
     3704       do:
     3705         assign
     3706           sort-column-phrase = "by " + sort-column-name
     3707           .
     3708       end.
     3709     end case.
     3710     CASE p-mode:
     3711       when 'объект':U then
     3712         do:
     3713           FIND FIRST clients NO-LOCK WHERE clients.obj-type = p-obj-type AND
     3714             clients.obj-code = p-obj-code NO-ERROR.
     3715           ASSIGN
     3716             frame d-pl-list:TITLE = "Складские места " + clients.obj-name
     3717             filter-point              = filter-point0 + p-mode
     3718             filter-label              = substitute("&1", filter-label0)
     3719             .
     3720   define variable vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3721   define variable  l-disable-where-32  as logical   no-undo .
     3722   define variable  l-filter-open-32    as logical   .
     3723   define variable  flt-rec-32       as recid     no-undo .
     3724   define variable  filter-name-32      as character no-undo .
     3725   define variable  where-phrase-32     as character no-undo .
     3726   define variable  sort-phrase-32      as character no-undo .
     3727   define variable  where-phrase-rus-32 as character no-undo .
     3728   define variable  sort-phrase-rus-32  as character no-undo .
     3729     run waitfram-show in this-procedure
     3730       (input "ЖДИТЕ ..."
     3731       ).
     3732   run gbl/flt-get.p
     3733     (input filter-point
     3734     ,output flt-rec-32
     3735     ,output filter-name-32
     3736     ,output where-phrase-32
     3737     ,output sort-phrase-32
     3738     ,output where-phrase-rus-32
     3739     ,output sort-phrase-rus-32
     3740     ).
     3741       run set-filter-name in this-procedure
     3742         (INPUT filter-name-32
     3743         ) no-error .
     3744     assign
     3745       l-filter-open-32 = false
     3746     .
     3747     if flt-rec-32 <> ?
     3748       or sort-column-phrase > ""
     3749     then do:
     3750       define variable  parameter-2-32 as character no-undo .
     3751       define variable  parameter-3-32 as character no-undo .
     3752       define variable  parameter-4-32 as character no-undo .
     3753       define variable  parameter-5-32 as character no-undo .
     3754       define variable  parameter-6-32 as character no-undo .
     3755       define variable  parameter-7-32 as character no-undo .
     3756         assign
     3757         parameter-3-32 =
     3758                                 "FOR EACH X_place"
     3759         parameter-4-32 =
     3760           (
     3761             if (" X_place.obj-type = p-obj-type AND X_place.obj-code = p-obj-code " + " " + where-phrase-32) <> ""
     3762             then  substitute('X_place.obj-type = &1&2&1 AND X_place.obj-code = &3 ', chr(34), p-obj-type, p-obj-code) + " " + where-phrase-32
     3763             else "true"
     3764           )
     3765         parameter-5-32 = (" " + "" + " " + substitute(', first tt-place-attr no-lock where tt-place-attr.pl-code = X_place.pl-code' ))
     3766         parameter-6-32 = if sort-phrase-32 = ''
     3767                              then
     3768           (
     3769           " " + "  " +
     3770             " " + sort-column-phrase +
     3771           " " + "  "
     3772           )
     3773                              else
     3774           (
     3775           " " + "  " +
     3776             " " + sort-column-phrase +
     3777           " " + sort-phrase-32
     3778           )
     3779         parameter-7-32 =
     3780           " indexed-reposition  "
     3781       .
     3782       do
     3783       on stop undo, leave
     3784       on error undo, leave
     3785       :
     3786         assign
     3787           l-disable-where-32 =
     3788             (" X_place.obj-type = p-obj-type AND X_place.obj-code = p-obj-code " + " " + where-phrase-32 = "")
     3789         .
     3790         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     3791                             ,input QUERY br-pl:handle
     3792                             ,input parameter-3-32
     3793                             ,input parameter-4-32
     3794                             ,input parameter-5-32
     3795                             ,input parameter-6-32
     3796                             ,input parameter-7-32
     3797                             )
     3798         .
     3799         assign
     3800           l-filter-open-32 = true
     3801         .
     3802       end.
     3803       if l-filter-open-32 = false then do:
     3804         message
     3805           "Ошибка при фильтрации / сортировке" skip
     3806           "Будут показаны записи без учета фильтра" skip
     3807           view-as alert-box .
     3808       end.
     3809       else do:
     3810           assign
     3811             l-query-was-opened = true
     3812           .
     3813       end.
     3814     end.
     3815     if l-filter-open-32 = false then do:
     3816       OPEN QUERY br-pl FOR EACH X_place
     3817         where  X_place.obj-type = p-obj-type AND X_place.obj-code = p-obj-code
     3818       , first tt-place-attr no-lock where tt-place-attr.pl-code = X_place.pl-code
     3819         indexed-reposition
     3820     .
     3821         assign
     3822           l-query-was-opened = true
     3823         .
     3824     end.
     3825     run waitfram-hide in this-procedure .
     3826         end.
     3827       when 'все':U then
     3828         do:
     3829           ASSIGN
     3830             frame d-pl-list:TITLE = "Складские места "
     3831             filter-point              = filter-point0 + p-mode
     3832             filter-label              = substitute("&1", filter-label0)
     3833             .
     3834   define variable vss-include-info33 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3835   define variable  l-disable-where-34  as logical   no-undo .
     3836   define variable  l-filter-open-34    as logical   .
     3837   define variable  flt-rec-34       as recid     no-undo .
     3838   define variable  filter-name-34      as character no-undo .
     3839   define variable  where-phrase-34     as character no-undo .
     3840   define variable  sort-phrase-34      as character no-undo .
     3841   define variable  where-phrase-rus-34 as character no-undo .
     3842   define variable  sort-phrase-rus-34  as character no-undo .
     3843     run waitfram-show in this-procedure
     3844       (input "ЖДИТЕ ..."
     3845       ).
     3846   run gbl/flt-get.p
     3847     (input filter-point
     3848     ,output flt-rec-34
     3849     ,output filter-name-34
     3850     ,output where-phrase-34
     3851     ,output sort-phrase-34
     3852     ,output where-phrase-rus-34
     3853     ,output sort-phrase-rus-34
     3854     ).
     3855       run set-filter-name in this-procedure
     3856         (INPUT filter-name-34
     3857         ) no-error .
     3858     assign
     3859       l-filter-open-34 = false
     3860     .
     3861     if flt-rec-34 <> ?
     3862       or sort-column-phrase > ""
     3863     then do:
     3864       define variable  parameter-2-34 as character no-undo .
     3865       define variable  parameter-3-34 as character no-undo .
     3866       define variable  parameter-4-34 as character no-undo .
     3867       define variable  parameter-5-34 as character no-undo .
     3868       define variable  parameter-6-34 as character no-undo .
     3869       define variable  parameter-7-34 as character no-undo .
     3870         assign
     3871         parameter-3-34 =
     3872                                 "FOR EACH X_place"
     3873         parameter-4-34 =
     3874           (
     3875             if (" TRUE " + " " + where-phrase-34) <> ""
     3876             then " TRUE " + " " + where-phrase-34
     3877             else "true"
     3878           )
     3879         parameter-5-34 = (" " + "" + " " + substitute(', first tt-place-attr no-lock where tt-place-attr.pl-code = X_place.pl-code' ))
     3880         parameter-6-34 = if sort-phrase-34 = ''
     3881                              then
     3882           (
     3883           " " + "  " +
     3884             " " + sort-column-phrase +
     3885           " " + "  "
     3886           )
     3887                              else
     3888           (
     3889           " " + "  " +
     3890             " " + sort-column-phrase +
     3891           " " + sort-phrase-34
     3892           )
     3893         parameter-7-34 =
     3894           " indexed-reposition  "
     3895       .
     3896       do
     3897       on stop undo, leave
     3898       on error undo, leave
     3899       :
     3900         assign
     3901           l-disable-where-34 =
     3902             (" TRUE " + " " + where-phrase-34 = "")
     3903         .
     3904         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     3905                             ,input QUERY br-pl:handle
     3906                             ,input parameter-3-34
     3907                             ,input parameter-4-34
     3908                             ,input parameter-5-34
     3909                             ,input parameter-6-34
     3910                             ,input parameter-7-34
     3911                             )
     3912         .
     3913         assign
     3914           l-filter-open-34 = true
     3915         .
     3916       end.
     3917       if l-filter-open-34 = false then do:
     3918         message
     3919           "Ошибка при фильтрации / сортировке" skip
     3920           "Будут показаны записи без учета фильтра" skip
     3921           view-as alert-box .
     3922       end.
     3923       else do:
     3924           assign
     3925             l-query-was-opened = true
     3926           .
     3927       end.
     3928     end.
     3929     if l-filter-open-34 = false then do:
     3930       OPEN QUERY br-pl FOR EACH X_place
     3931         where  TRUE
     3932       , first tt-place-attr no-lock where tt-place-attr.pl-code = X_place.pl-code
     3933         indexed-reposition
     3934     .
     3935         assign
     3936           l-query-was-opened = true
     3937         .
     3938     end.
     3939     run waitfram-hide in this-procedure .
     3940         end.
     3941     END CASE.
     3942     if v-doc-rec <> ? then reposition br-pl to recid v-doc-rec no-error.
     3943     if not p-open-query and v-fltopend-rowid[1] <> ? then
     3944       query br-pl:handle:reposition-to-rowid(v-fltopend-rowid) No-ERROR.
     3945     apply "entry" to br-pl in frame d-pl-list.
     3946     if avail X_place then
     3947       APPLY "VALUE-CHANGED":U to br-pl.
     3948     run waitfram-hide in this-procedure .
     3949     apply "value-changed" to br-pl in frame d-pl-list.
     3950   END PROCEDURE.
