      656   procedure proc-alt-shift-f2:
      657     if not ibs.th.gbl.gbl-var:rcode
      658   then
      659     run gbl\inidebug.p .
      660   end.
      661   procedure proc-alt-shift-f3:
      662     run gbl/prvssinf.p
      663       ( input this-procedure
      664       ) .
      665   end.
      666   define variable v-inform-launched as logical no-undo initial false .
      667   procedure proc-alt-shift-f4:
      668     define variable v-action as character no-undo .
      669     if v-inform-launched = false then do:
      670       assign
      671         v-inform-launched = true
      672       .
      673       run gbl/d-inform.w
      674         (  input self
      675         ,  input this-procedure
      676         , output v-action
      677         ) no-error .
      678       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      679       assign
      680         v-inform-launched = false
      681       .
      682     end.
      683   end.
      684   procedure proc-alt-f1:
      685     run gbl/corrhelp.p
      686       (input this-procedure
      687       ) .
      688   end .
      689   on alt-shift-f2 anywhere do:
      690     run proc-alt-shift-f2.
      691   end.
      692   on alt-shift-f3 anywhere do:
      693     run proc-alt-shift-f3 in this-procedure .
      694   end.
      695   on alt-shift-f4 anywhere do:
      696     run proc-alt-shift-f4 in this-procedure.
      697   end.
      698   on alt-f1 anywhere do:
      699     run proc-alt-f1 in this-procedure .
      700   end.
      701   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      702   define variable c-point  as character no-undo .
      703   define variable tbl      as character no-undo .
      704   define variable join-tbl as character no-undo .
      705   define variable fld      as character no-undo .
      706   define variable lab      as character no-undo .
      707   define variable spr      as character no-undo .
      708   define variable dim      as character no-undo .
      709   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      710   procedure fltfield-clear :
      711     define output parameter loc-fld as character no-undo.
      712     define output parameter loc-lab as character no-undo .
      713     define output parameter loc-spr as character no-undo .
      714     define output parameter loc-dim as character no-undo .
      715     assign
      716       loc-fld = ""
      717       loc-lab = ""
      718       loc-spr = ""
      719       loc-dim = "0"
      720     .
      721   end procedure .
      722   procedure fltfield-add :
      723     define input        parameter par-fld as character no-undo.
      724     define input        parameter par-lab as character no-undo .
      725     define input        parameter par-spr as character no-undo .
      726     define input-output parameter loc-fld as character no-undo.
      727     define input-output parameter loc-lab as character no-undo .
      728     define input-output parameter loc-spr as character no-undo .
      729     define input-output parameter loc-dim as character no-undo .
      730     do
      731     on error undo, return error
      732     :
      733       assign
      734       loc-fld = if loc-dim = '0'
      735                 then par-fld
      736                 else (loc-fld + chr(44) + par-fld)
      737       loc-lab = if loc-dim = '0'
      738                 then par-lab
      739                 else (loc-lab + chr(44) + par-lab)
      740       loc-spr = if loc-dim = '0'
      741                 then par-spr
      742                 else (loc-spr + chr(44) + par-spr)
      743       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
      744                 string(integer(if num-entries(loc-dim) > 1
      745                               then entry(2, loc-dim)
      746                               else entry(1, loc-dim)
      747                               ) + 1)
      748       no-error
      749       .
      750     end.
      751   end procedure.
      752   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      753   define variable v-waitfram-action01         as character   no-undo .
      754   define variable v-waitfram-action02         as character   no-undo .
      755   define variable v-waitfram-action03         as character   no-undo .
      756   define variable mWaitFramTextBeg            as character   no-undo.
      757   define variable mWaitFramTextEnd            as character   no-undo.
      758   define variable mWaitFramView               as logical     no-undo.
      759   define variable mWaitProcEvent              as logical     no-undo init yes.
      760   define variable mWaitFramInterval           as integer     no-undo init 1 .
      761   define variable mWaitFramStop               as logical     no-undo.
      762   define variable mWaitFramStopUser           as logical     no-undo.
      763   define variable mWaitFramStopTimeOut        as logical     no-undo.
      764   define variable mWaitFramStartProc          as datetime-tz no-undo.
      765   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      766   define button B-WaitFramStop auto-end-key
      767        label "Стоп"
      768        size 10 by 1 tooltip "Остоновить процесс".
      769   define button B-viewProcInfo
      770        label "Информация"
      771        size 15 by 1 tooltip "Информация о процесс".
      772   define frame waitfram
      773     v-waitfram-action01 format "x(72)" no-label skip
      774     v-waitfram-action02 format "x(72)" no-label skip
      775     v-waitfram-action03 format "x(72)" no-label skip
      776     B-viewProcInfo
      777     B-WaitFramStop at row 4 col 30
      778     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      779     .
      780   define new global shared variable mBatchMode as logical no-undo init ?.
      781   define variable mFramBachModHandle as handle no-undo.
      782   mFramBachModHandle = frame waitfram:handle.
      783   define variable mFameOldVis as logical no-undo.
      784   define variable mVisCUrentVin as logical no-undo.
      785   if session:batch-mode
      786   then
      787      mBatchMode = yes.
      788   if mBatchMode = ? then do:
      789     mVisCUrentVin = current-window:visible.
      790     mFameOldVis = mFramBachModHandle:visible.
      791     mFramBachModHandle:visible  = yes.
      792     mBatchMode = mFramBachModHandle:visible ne yes.
      793     mFramBachModHandle:visible = mFameOldVis.
      794     current-window:visible = mVisCUrentVin.
      795   end.
      796    if  log-manager:logfile-name ne ?
      797     then DO:
      798         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      799         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      800         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      801     end.
      802   on choose of B-WaitFramStop in frame waitfram
      803   do:
      804     mWaitFramStop = yes.
      805     mWaitFramStopUser = yes.
      806   end.
      807   function waitfram-check-timeout returns logical():
      808      define variable vtime as int64 no-undo.
      809      if mWaitFramStopTimeOut
      810      then
      811         return yes.
      812      vtime = ( now - mWaitFramStartProc ) / 1000 .
      813      if     mWaitFramTimeOut ne ?
      814         and mWaitFramTimeOut ne 0
      815         and mWaitFramTimeOut lt vtime
      816      then do:
      817         mWaitFramStopTimeOut = yes.
      818      end.
      819      return mWaitFramStopTimeOut.
      820   end.
      821   procedure waitfram-hide :
      822     if not session:batch-mode
      823     then do
      824     on error undo, return error return-value
      825     :
      826       pause 0 before-hide .
      827       if not mBatchMode then
      828         hide frame waitfram .
      829     if     not mWaitFramView
      830        and mWaitProcEvent
      831     then
      832       process events .
      833     end.
      834   end procedure.
      835   procedure waitfram-show :
      836     define input  parameter p-message as character no-undo .
      837     define variable v-left-margin as integer   no-undo .
      838     if not session:batch-mode
      839     then do
      840     on error undo, return error return-value
      841     :
      842       if length(p-message) <= 70 then do:
      843         assign
      844           v-left-margin = integer((70 - length(p-message)) / 2)
      845         .
      846         assign
      847           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      848         .
      849         assign
      850           v-waitfram-action01 = " "
      851           v-waitfram-action02 = " "
      852                                    + fill(" ", v-left-margin)
      853                                    + p-message
      854           v-waitfram-action03 = " "
      855         .
      856       end.
      857       else do:
      858         define variable vRindex1 as integer no-undo.
      859         define variable vRindex2 as integer no-undo.
      860         vRindex1 = r-index(p-message," ",70).
      861         if vRindex1 = 0
      862         then
      863            vRindex1 = 70.
      864         if length(p-message)  <= vRindex1 + 70 then do:
      865           assign
      866             v-waitfram-action01 = " "
      867             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      868             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      869           .
      870         end.
      871         else do:
      872           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      873           if vRindex2 <= vRindex1
      874           then
      875              vRindex2 = vRindex1 + 70.
      876           assign
      877             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      878             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      879             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      880           .
      881         end.
      882       end.
      883       B-viewProcInfo:visible   in frame waitfram = no.
      884       B-viewProcInfo:sensitive in frame waitfram = no.
      885       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      886       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      887       if  (   mWaitFramView
      888          or  mWaitProcEvent)
      889          and not mBatchMode
      890       then
      891          display
      892             v-waitfram-action01 skip
      893             v-waitfram-action02 skip
      894             v-waitfram-action03 skip
      895          with frame waitfram .
      896       if     mWaitFramView
      897          then do:
      898             if     mWaitFramInterval ne ?
      899                and not mBatchMode
      900             then
      901                wait-for go of frame waitfram pause mWaitFramInterval.
      902          end.
      903          else
      904             if     mWaitProcEvent
      905                and not mBatchMode
      906             then
      907                process events .
      908     end.
      909   end procedure.
      910      procedure waitfram-show-this:
      911         define input  parameter iInterval as int64 no-undo.
      912         define variable vtime as int64 no-undo.
      913         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      914         mWaitFramInterval = iInterval.
      915         run waitfram-show (substitute("&1&2 &3&4" ,
      916                                       mWaitFramTextBeg ,
      917                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      918                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      919                                       mWaitFramTextEnd
      920                                      )
      921                           ).
      922      end.
      923      procedure WaitFramRunPause:
      924         define input  parameter iInterval as dec no-undo.
      925         define variable vStart  as datetime-tz no-undo.
      926         define variable vend    as datetime-tz no-undo.
      927         define variable vint as int64 no-undo.
      928         define variable vOk as logical no-undo.
      929         vStart = now.
      930         vend   = vStart.
      931         publish "WaitFramPause" (iInterval,output vOk).
      932         vend   =  now.
      933         vint = vend - vStart.
      934         vint = iInterval - vint / 1000.
      935         if     not mWaitFramStop
      936            and (   vint > 0
      937                 or (    not vOk
      938                     and iInterval eq ?
      939                     )
      940                 )
      941         then
      942            run waitfram-show-this (iInterval).
      943         vend   =  now.
      944         vint = vend - vStart.
      945         vint = iInterval - vint / 1000.
      946         if     not mWaitFramStop
      947            and vint > 0
      948         then do:
      949            run gbl/pause.p (vint * 1000).
      950         end.
      951         if iInterval ne ?
      952         then
      953            publish "WaitFramStop".
      954         waitfram-check-timeout().
      955      end.
      956      procedure WaitFramWaitFor:
      957         define input  parameter iInterval as dec no-undo.
      958         assign
      959            mWaitFramStartProc   = now
      960            mWaitFramStopUser    = no
      961            mWaitFramStopTimeOut = no
      962         .
      963         block-wait:
      964         do while not mWaitFramStop:
      965            run WaitFramRunPause (iInterval).
      966            if  waitfram-check-timeout()
      967            then do:
      968               leave block-wait.
      969            end.
      970         end.
      971         run waitfram-hide.
      972      end.
      973   procedure waitfram-join :
      974     define input  parameter p-line-1  as character no-undo .
      975     define input  parameter p-line-2  as character no-undo .
      976     define input  parameter p-line-3  as character no-undo .
      977     define output parameter p-message as character no-undo .
      978     do
      979     on error undo, return error return-value
      980     :
      981       assign
      982         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      983                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      984                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      985       .
      986     end.
      987   end procedure.
      988   function waitfram-join-function returns character
      989     (input p-line-1 as character
      990     ,input p-line-2 as character
      991     ,input p-line-3 as character
      992     ).
      993     define variable v-message as character no-undo .
      994     run waitfram-join in this-procedure
      995       (input  p-line-1
      996       ,input  p-line-2
      997       ,input  p-line-3
      998       ,output v-message
      999       ) .
     1000     return v-message .
     1001   end function .
     1002   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1003     define variable v-cntxt-db-num        as integer   no-undo .
     1004     define variable v-cntxt-userid        as character no-undo .
     1005     define variable v-cntxt-level         as character no-undo .
     1006     define variable v-cntxt-host-code-obj as integer   no-undo .
     1007     define variable v-cntxt-obj-type      as character no-undo .
     1008     define variable v-cntxt-obj-code      as integer   no-undo .
     1009     define variable v-cntxt-db-num-obj    as integer   no-undo .
     1010     define variable v-cntxt-is-admin      as logical   no-undo .
     1011   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1012   FUNCTION mark-string RETURNS CHARACTER
     1013     ( input p-recid as recid, input mark-list as character  ) :
     1014     RETURN ( IF LOOKUP( STRING( p-recid), mark-list ) > 0 THEN '*' ELSE '':U ).
     1015   END FUNCTION.
     1016   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1017   define variable v-fltopend-rowid as rowid extent 18 no-undo .
     1018   procedure fltopend_fltopend :
     1019   define input parameter p-parent-handle as handle no-undo .
     1020   define input parameter p-qh as handle no-undo .
     1021   define input parameter p-flt-open-open-query  as character no-undo .
     1022   define input parameter p-where-cond as character no-undo .
     1023   define input parameter p-use-indFIRST-query-tail as character no-undo .
     1024   define input parameter p-use-ind-sort-clmn-by as character no-undo .
     1025   define input parameter p-indexed-reposition as character no-undo .
     1026     do
     1027     on error undo, return error
     1028     :
     1029   define variable v-prepare-string as character no-undo .
     1030   define variable glog as logical no-undo .
     1031   assign
     1032   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     1033                      p-where-cond + chr(32)  +
     1034                      p-use-indFIRST-query-tail + chr(32) +
     1035                      p-use-ind-sort-clmn-by + chr(32) +
     1036                      p-indexed-reposition
     1037   .
     1038   assign
     1039   glog = p-qh:query-prepare(v-prepare-string) no-error .
     1040   if not glog
     1041   or error-status:error then do:
     1042     message error-status:get-message(1) view-as alert-box .
     1043     undo, return error .
     1044   end.
     1045   assign
     1046   glog = p-qh:query-open no-error .
     1047   if not glog
     1048   or error-status:error then do:
     1049     message error-status:get-message(1) view-as alert-box .
     1050     undo, return error .
     1051   end.
     1052     end.
     1053   end procedure.
     1054   procedure fltopend_fltfindd :
     1055   define input parameter p-parent-handle as handle no-undo .
     1056   define input parameter p-qh as handle no-undo .
     1057   define input parameter p-rowid as rowid no-undo .
     1058   define input parameter p-next as logical no-undo .
     1059   define input parameter p-lock as integer no-undo .
     1060   define input parameter p-bh as handle no-undo .
     1061   define input parameter p-where-cond as character no-undo .
     1062   define input parameter p-use-index-phrase as character no-undo .
     1063   define variable glog as logical no-undo .
     1064   define variable v-qh as handle no-undo .
     1065   define variable v-bh as handle no-undo .
     1066   define variable v-recid as recid no-undo .
     1067   define variable v-prepare-string as character no-undo .
     1068   do
     1069   on error undo, return error
     1070   on stop undo, return error
     1071   :
     1072     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
     1073     create buffer v-bh for table p-bh buffer-name p-bh:name.
     1074     create query v-qh.
     1075     v-qh:set-buffers(v-bh).
     1076     v-prepare-string = substitute("for each &1 &2 &3"
     1077                                     ,v-bh:name
     1078                                     ,p-where-cond
     1079                                     ,p-use-index-phrase).
     1080     glog = v-qh:query-prepare(v-prepare-string) no-error.
     1081     if not glog then do:
     1082       delete object v-qh.
     1083       delete object v-bh.
     1084       undo, return error .
     1085     end.
     1086     glog = v-qh:query-open no-error .
     1087     if not glog then do:
     1088       delete object v-qh.
     1089       delete object v-bh.
     1090       undo, return error .
     1091     end.
     1092     if p-next then do:
     1093       v-qh:reposition-to-rowid(p-rowid) no-error .
     1094       glog = v-qh:get-next( p-lock) no-error .
     1095       glog = v-qh:get-next( p-lock) no-error .
     1096       if not glog or v-qh:query-off-end = yes then do:
     1097         glog = v-qh:get-first( p-lock) no-error .
     1098       end.
     1099     end.
     1100     else do:
     1101       glog = v-qh:get-first( p-lock) no-error .
     1102     end.
     1103     v-recid = v-bh:recid no-error .
     1104     delete object v-qh.
     1105     delete object v-bh.
     1106     return string(v-recid) .
     1107   end.
     1108   end procedure.
     1109   procedure fltopend_fltfindq :
     1110   define input parameter p-parent-handle as handle no-undo .
     1111   define input parameter p-qh as handle no-undo .
     1112   define input parameter p-next as logical no-undo .
     1113   define input parameter p-lock as integer no-undo .
     1114   define input parameter p-flt-open-open-query  as character no-undo .
     1115   define input parameter p-where-cond as character no-undo .
     1116   define input parameter p-use-indFIRST-query-tail as character no-undo .
     1117   define input parameter p-use-ind-sort-clmn-by as character no-undo .
     1118   define input parameter p-indexed-reposition as character no-undo .
     1119   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
     1120   define variable glog as logical no-undo .
     1121   define variable v-qh as handle no-undo .
     1122   define variable v-bh as handle no-undo extent 18.
     1123   define variable v-rowid as rowid no-undo extent 18.
     1124   define variable v-ii as integer no-undo .
     1125   define variable v-prepare-string as character no-undo .
     1126   do
     1127   on error undo, return error
     1128   on stop undo, return error
     1129   :
     1130     create query v-qh.
     1131     do v-ii = 1 to p-qh:num-buffers:
     1132       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
     1133       assign
     1134       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
     1135       no-error.
     1136       v-qh:add-buffer(v-bh[v-ii]).
     1137     end.
     1138     assign
     1139     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     1140                       p-where-cond + chr(32)  +
     1141                       p-use-indFIRST-query-tail + chr(32) +
     1142                       p-use-ind-sort-clmn-by + chr(32) +
     1143                       p-indexed-reposition
     1144     .
     1145     glog = v-qh:query-prepare( v-prepare-string) no-error .
     1146     if not glog then do:
     1147       delete object v-qh.
     1148       do v-ii = 1 to p-qh:num-buffers:
     1149         delete object v-bh[v-ii].
     1150       end.
     1151       undo, return error .
     1152     end.
     1153     glog = v-qh:query-open no-error .
     1154     if not glog then do:
     1155       delete object v-qh.
     1156       do v-ii = 1 to p-qh:num-buffers:
     1157         delete object v-bh[v-ii].
     1158       end.
     1159       undo, return error .
     1160     end.
     1161     if p-next then do:
     1162       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
     1163       glog = v-qh:get-next( p-lock) no-error .
     1164       glog = v-qh:get-next( p-lock) no-error .
     1165       if not glog or v-qh:query-off-end = yes then do:
     1166         glog = v-qh:get-first( p-lock) no-error .
     1167       end.
     1168     end.
     1169     else do:
     1170       glog = v-qh:get-first( p-lock) no-error .
     1171     end.
     1172     do v-ii = 1 to p-qh:num-buffers:
     1173       assign
     1174       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
     1175       no-error.
     1176     end.
     1177     delete object v-qh.
     1178     do v-ii = 1 to p-qh:num-buffers:
     1179       delete object v-bh[v-ii].
     1180     end.
     1181   end.
     1182   end procedure.
     1183   procedure placelib_write-attr:
     1184   define input  parameter p-code     like ub.place-attr.attr-code .
     1185   define input  parameter p-obj-code like ub.place-attr.obj-code .
     1186   define input  parameter p-obj-type like ub.place-attr.obj-type .
     1187   define input  parameter p-pl-code  like ub.place-attr.pl-code .
     1188   define input  parameter p-value    like ub.place-attr.attr-value .
     1189   define output parameter p-ok       as logical.
     1190   define buffer buf_place-attr for ub.place-attr .
     1191     do on error undo, return error return-value :
     1192        p-ok = false.
     1193        find first buf_place-attr exclusive-lock where buf_place-attr.attr-code   = p-code
     1194                                                   and buf_place-attr.obj-code    = p-obj-code
     1195                                                   and buf_place-attr.obj-type    = p-obj-type
     1196                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
     1197        if not available buf_place-attr then do :
     1198           create buf_place-attr.
     1199           assign
     1200             buf_place-attr.attr-code   = p-code
     1201             buf_place-attr.attr-value  = p-value
     1202             buf_place-attr.obj-code    = p-obj-code
     1203             buf_place-attr.obj-type    = p-obj-type
     1204             buf_place-attr.pl-code     = p-pl-code
     1205           .
     1206           p-ok = true.
     1207        end.
     1208        else do:
     1209           buf_place-attr.attr-value  = p-value .
     1210           p-ok = true.
     1211        end.
     1212     end.
     1213   end.
     1214   procedure placelib_get-attr:
     1215   define input  parameter  p-code     like ub.place-attr.attr-code .
     1216   define input  parameter  p-obj-code like ub.place-attr.obj-code .
     1217   define input  parameter  p-obj-type like ub.place-attr.obj-type .
     1218   define input  parameter  p-pl-code  like ub.place-attr.pl-code .
     1219   define output parameter  p-value    like ub.place-attr.attr-value .
     1220   define output parameter  p-ok       as logical.
     1221   define buffer buf_place-attr for ub.place-attr .
     1222     do on error undo, return error return-value :
     1223        p-ok = false.
     1224        find first buf_place-attr no-lock where buf_place-attr.attr-code   = p-code
     1225                                                   and buf_place-attr.obj-code    = p-obj-code
     1226                                                   and buf_place-attr.obj-type    = p-obj-type
     1227                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
     1228        if available buf_place-attr then do :
     1229          p-value = buf_place-attr.attr-value.
     1230          p-ok = true.
     1231        end.
     1232        else do :
     1233          p-ok = false.
     1234        end.
     1235     end.
     1236   end.
     1237   procedure placelib_del-attr:
     1238   define input parameter  p-code     like ub.place-attr.attr-code .
     1239   define input parameter  p-obj-code like ub.place-attr.obj-code .
     1240   define input parameter  p-obj-type like ub.place-attr.obj-type .
     1241   define input parameter  p-pl-code  like ub.place-attr.pl-code .
     1242   define input parameter  p-value    like ub.place-attr.attr-value .
     1243   define output parameter p-ok       as logical.
     1244   define buffer buf_place-attr for ub.place-attr .
     1245     do on error undo, return error return-value :
     1246        p-ok = false.
     1247        find first buf_place-attr exclusive-lock where buf_place-attr.attr-code   = p-code
     1248                                                   and buf_place-attr.obj-code    = p-obj-code
     1249                                                   and buf_place-attr.obj-type    = p-obj-type
     1250                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
     1251        if available buf_place-attr then do :
     1252           delete buf_place-attr.
     1253           p-ok = true.
     1254        end.
     1255     end.
     1256   end.
