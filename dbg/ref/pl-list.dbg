     3633               ,input p-obj-type
     3634               ,input buf_place.pl-code
     3635               ,output v-value
     3636               ,output v-ok      ) no-error.
     3637             case v-code :
     3638               when "place-type" then
     3639                 do :
     3640                   if v-ok then
     3641                   do :
     3642                     if integer(v-value) = 1 then tt-place-attr.place-type = "Вертикальный"  .
     3643                     if integer(v-value) = 2 then tt-place-attr.place-type = "Горизонтальный"  .
