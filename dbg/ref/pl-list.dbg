     1685       end.
     1686     END.
     1687   ON CHOOSE OF B-mark IN FRAME d-pl-list
     1688     DO:
     1689       define variable glog as logical no-undo .
     1690       if available X_place then
     1691       do:
     1692   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1693   define variable v-str-recid12 as character no-undo .
     1694   define variable v-num-entry12 as integer   no-undo .
     1695   assign
     1696     v-str-recid12 = trim( string( recid( X_place ) , "->>>>>>>>>>>9":U ) )
     1697     v-num-entry12 = lookup( v-str-recid12 , v-rid-list )
     1698   .
     1699   if v-num-entry12 > 0 then do:
     1700     assign
     1701       entry( v-num-entry12, v-rid-list ) = "":U
     1702       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1703     .
     1704   end.
     1705   else do:
     1706     assign
     1707       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid12
     1708     .
     1709   end.
     1710         br-pl:refresh().
     1711         if last-event:function <> "MOUSE-SELECT-DBLCLICK" then
     1712         do:
     1713           glog = br-pl:select-next-row ().
     1714           apply "iteration-changed" to br-pl in frame d-pl-list.
     1715         end.
     1716         if num-entries( v-rid-list ) = 0 then
     1717           hide mark-num in frame d-pl-list.
     1718         else
     1719           disp num-entries( v-rid-list ) @ mark-num with frame d-pl-list.
     1720       end.
     1721       apply "entry" to br-pl in frame d-pl-list.
     1722     END.
     1723   ON MOUSE-SELECT-DBLCLICK OF br-pl IN FRAME d-pl-list
     1724     DO:
     1725       if (lookup("b-sel", bttns) > 0 and lookup("b-mark", bttns) = 0) then APPLY "CHOOSE" to b-sel.
     1726     END.
     1727   ON CHOOSE OF b-print IN FRAME d-pl-list
     1728     DO:
     1729       if available X_place then
     1730       do:
     1731         message "Еще не реализовано!" view-as alert-box.
     1732         return no-apply.
     1733       end.
     1734     END.
     1735   ON CHOOSE OF b-rest IN FRAME d-pl-list
     1736     DO:
     1737       if not avail X_place then return no-apply.
     1738       define variable loc-rid-list as character no-undo .
     1739       run ref/pl-gdss.w (
     1740         input parparentproc
     1741         ,input (if lookup("b-add", bttns) > 0 then "b-add" else "")
     1742         ,input p-obj-type
     1743         ,input p-obj-code
     1744         ,input 'склд.место':U
     1745         ,input ?
     1746         ,input recid(X_place)
     1747         ,output loc-rid-list).
     1748     END.
     1749   ON CHOOSE OF B-sch IN FRAME d-pl-list
     1750     DO:
     1751       assign
     1752         tbl      = 'place'
     1753         join-tbl = 'X_pLACE'
     1754         fld      = "":U
     1755         lab      = '':U
     1756         spr      = '':U
     1757         dim      = '0':U
     1758         .
     1759       run fltfield-add in this-procedure('obj-code', 'Код объекта', '',
     1760         input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     1761       run fltfield-add in this-procedure('obj-type', 'Тип объекта', '',
     1762         input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     1763       run fltfield-add in this-procedure('pl-code', 'Код места', '',
     1764         input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     1765       run fltfield-add in this-procedure('pl-name', 'Название места', '',
     1766         input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     1767       run fltfield-add in this-procedure('loc1', 'Коорд1', '',
     1768         input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     1769       run fltfield-add in this-procedure('loc2', 'Коорд2', '',
     1770         input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     1771       run fltfield-add in this-procedure('loc3', 'Коорд3', '',
     1772         input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     1773       run fltfield-add in this-procedure('loc4', 'Коорд4', '',
     1774         input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     1775       run fltfield-add in this-procedure('PS', 'Примечание', '',
     1776         input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     1777       DO on stop undo, leave:
     1778         run gbl/filter.w (
     1779           input parparentproc
     1780           ,input (filter-point + chr(4) + filter-label)
     1781           ,input tbl
     1782           ,input join-tbl
     1783           ,input fld
     1784           ,input lab
     1785           ,input spr
     1786           ,input dim).
     1787         RUN OpenBr in this-procedure (  input yes, input no, input '':U).
     1788       END .
     1789     END.
     1790   ON CHOOSE OF b-sel IN FRAME d-pl-list
     1791     DO:
     1792       if ( available X_place
     1793         AND (v-rid-list = ""
     1794         or b-mark:sensitive = no
     1795         ) ) then
     1796         v-rid-list = string( recid( X_place ) ) .
     1797     END.
     1798   ON CHOOSE OF b-quit IN FRAME d-pl-list
     1799     DO:
     1800         p-rid-list = "cancel" .
     1801     END.
