     3094                 (input  integer(v-resize-value-str)
     3095                 ,input  true
     3096                 ) .
     3097               assign
     3098                 v-restore-saved = true
     3099               .
     3100             end.
     3101           end.
     3102           if v-restore-saved <> true
     3103           then do:
     3104             if v-diasize-wndmax = true
