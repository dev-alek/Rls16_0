     3391     display rs-stat with frame d-pl-list.
     3392     enable rs-stat with frame d-pl-list.
     3393     RUN enable_UI in this-procedure .
     3394     RUN OpenBR in this-procedure (  input yes, input no, input '':U).
     3395   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3396   DEF VAR cur-clmn-numbr-pl as INT EXTENT 12 no-undo.
     3397   DEF VAR varmvibr-pl       as INT no-undo.
     3398   DEF VAR varmvjbr-pl       as INT no-undo.
     3399   DEF VAR varmvkbr-pl       as INT no-undo.
     3400   DEF VAR varmvlbr-pl       as INT no-undo.
     3401   DEF VAR move-elementbr-pl as INT no-undo.
     3402   def var jjbr-pl           as int no-undo.
     3403   do varmvibr-pl = 1 to EXTENT(cur-clmn-numbr-pl):
     3404     ASSIGN cur-clmn-numbr-pl[varmvibr-pl] = varmvibr-pl.
     3405   END.
     3406   RUN start-mv-clmnbr-pl.
     3407   PROCEDURE start-mv-clmnbr-pl:
     3408   def var old-session as logical no-undo.
     3409      old-session = SESSION:IMMEDIATE-DISPLAY.
     3410      IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     3411          IF  p-mode = 'объект':U  THEN DO:
     3412      DO jjbr-pl = NUM-ENTRIES('1,2,3,4,5,6,7,10,11,12,8,9') TO 1 BY -1:
     3413        RUN re-move-clmnbr-pl ( cur-clmn-numbr-pl[INTEGER(ENTRY (jjbr-pl, '1,2,3,4,5,6,7,10,11,12,8,9'))] , 1 ).
     3414      END.
     3415          END.
     3416          IF  p-mode = 'все':U  THEN DO:
     3417      DO jjbr-pl = NUM-ENTRIES('1,8,9,2,3,4,5,6,7,10,11,12') TO 1 BY -1:
     3418        RUN re-move-clmnbr-pl ( cur-clmn-numbr-pl[INTEGER(ENTRY (jjbr-pl, '1,8,9,2,3,4,5,6,7,10,11,12'))] , 1 ).
     3419      END.
     3420          END.
     3421      SESSION:IMMEDIATE-DISPLAY = old-session.
     3422   END.
     3423   ON ctrl-cursor-right OF BROWSE br-pl do:
     3424     RUN re-move-clmnbr-pl ( 1 , 12).
     3425   END.
     3426   ON ctrl-cursor-left OF BROWSE br-pl do:
     3427     RUN re-move-clmnbr-pl (12, 1 ).
     3428   END.
     3429   PROCEDURE re-move-clmnbr-pl:
     3430     DEFINE INPUT PARAMETER source-column as INTEGER NO-UNDO.
     3431     DEFINE INPUT PARAMETER target-column as INTEGER NO-UNDO.
     3432     DO varmvibr-pl = 1 TO EXTENT(cur-clmn-numbr-pl):
     3433       if cur-clmn-numbr-pl[varmvibr-pl] = source-column THEN cur-clmn-numbr-pl[varmvibr-pl] = -1.
     3434     END.
     3435     if br-pl:MOVE-COLUMN(source-column, target-column) IN FRAME d-pl-list then.
     3436     if source-column > target-column THEN
     3437     DO varmvjbr-pl = source-column - 1 to target-column BY -1:
     3438       DO varmvibr-pl = 1 TO EXTENT(cur-clmn-numbr-pl):
     3439           if cur-clmn-numbr-pl[varmvibr-pl] = varmvjbr-pl THEN DO:
     3440             cur-clmn-numbr-pl[varmvibr-pl] = cur-clmn-numbr-pl[varmvibr-pl] + 1.
     3441           END.
     3442       END.
     3443     END.
     3444     ELSE
     3445     DO varmvjbr-pl = source-column + 1 to target-column:
     3446       DO varmvibr-pl = 1 TO EXTENT(cur-clmn-numbr-pl):
     3447         if cur-clmn-numbr-pl[varmvibr-pl] = varmvjbr-pl THEN DO:
     3448           cur-clmn-numbr-pl[varmvibr-pl] = cur-clmn-numbr-pl[varmvibr-pl] - 1.
     3449         END.
     3450       END.
     3451     END.
     3452     DO varmvibr-pl = 1 TO EXTENT(cur-clmn-numbr-pl):
     3453       if cur-clmn-numbr-pl[varmvibr-pl] = -1 THEN cur-clmn-numbr-pl[varmvibr-pl] = target-column.
     3454     END.
     3455   END PROCEDURE.
     3456   PROCEDURE ch-clmnbr-pl:
     3457     DEFINE INPUT PARAMETER cur-clmn-loc as INTEGER NO-UNDO.
     3458     if cur-clmn-loc <= 1  then do:
     3459       return .
     3460     end.
     3461     DO varmvibr-pl = 1 TO EXTENT(cur-clmn-numbr-pl):
     3462       if cur-clmn-numbr-pl[varmvibr-pl] = cur-clmn-loc THEN move-elementbr-pl = varmvibr-pl.
     3463     END.
     3464     RUN re-move-clmnbr-pl (cur-clmn-loc, 1 ).
     3465   END PROCEDURE.
     3466   PROCEDURE mv-brw-defaultbr-pl:
     3467   def var old-session as logical no-undo.
     3468     old-session = SESSION:IMMEDIATE-DISPLAY.
     3469     IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     3470     do varmvlbr-pl = 1  to EXTENT(cur-clmn-numbr-pl):
     3471       RUN re-move-clmnbr-pl (cur-clmn-numbr-pl[varmvlbr-pl], varmvlbr-pl).
     3472     END.
     3473     RUN start-mv-clmnbr-pl.
     3474     SESSION:IMMEDIATE-DISPLAY = old-session.
     3475   END PROCEDURE.
     3476   .
     3477     APPLY "ENTRY" to br-pl.
     3478     WAIT-FOR GO OF FRAME d-pl-list focus br-pl.
     3479   END.
     3480   RUN disable_UI in this-procedure .
     3481   PROCEDURE disable_UI :
     3482     HIDE FRAME d-pl-list.
     3483   END PROCEDURE.
     3484   PROCEDURE enable_UI :
     3485     assign
     3486       X_place.pl-name:read-only in browse br-pl = true.
     3487     ENABLE
     3488       b-quit
     3489       b-rest
     3490       when lookup("b-add", bttns) > 0
     3491       b-print
     3492       b-help
     3493       br-pl
     3494       X_place.PS
     3495       b-sel
     3496       when lookup ("b-sel", bttns) > 0
     3497       b-mark
     3498       when lookup ("b-mark", bttns) > 0
     3499       b-add
     3500       when lookup ("b-add", bttns) > 0
     3501       b-chg
     3502       when lookup ("b-add", bttns) > 0
     3503       b-del
     3504       when lookup ("b-add", bttns) > 0
     3505       b-ATD
     3506       when lookup ("b-sel", bttns) = 0
     3507       b-level
     3508       when lookup ("b-add", bttns) > 0
     3509       b-sch
     3510       b-hist
     3511       with frame d-pl-list.
     3512     HIDE
     3513       b-print
     3514       in frame d-pl-list.
     3515   END PROCEDURE.
     3516   PROCEDURE proc-rs-stat:
     3517     ASSIGN
     3518       FRAME d-pl-list
     3519       rs-stat.
     3520     RUN openbr IN THIS-PROCEDURE (   input yes, input no, input '':U ).
     3521   END PROCEDURE.
     3522   PROCEDURE OpenBr :
     3523     define input  parameter p-open-query     as logical   no-undo .
     3524     define input  parameter p-find-next      as logical   no-undo .
     3525     define input  parameter p-find-condition as character no-undo .
     3526     define variable l-query-was-opened as logical no-undo .
     3527     define buffer buf_place for ub.place.
     3528     assign FRAME d-pl-list   rs-stat.
     3529     run waitfram-show in this-procedure ( input "Ждите...").
     3530     define variable sort-column-phrase as character no-undo .
     3531     for each tt-place-attr :
     3532       delete tt-place-attr.
     3533     end.
     3534     if p-mode = 'объект':U  then
     3535     do:
     3536       for each buf_place where buf_place.obj-code = p-obj-code and buf_place.obj-type = p-obj-type and (if rs-stat = 'все':U then true else  buf_place.status_ = (if rs-stat =  'текущие':U then "" else 'удал':U)) no-lock :
     3537         find first tt-place-attr exclusive-lock where tt-place-attr.pl-code = buf_place.pl-code no-error.
     3538         if not available tt-place-attr then
     3539         do :
     3540           create tt-place-attr.
     3541           tt-place-attr.pl-code = buf_place.pl-code.
     3542           ii = 0.
     3543           do ii = 1 to num-entries('place-type,place-SI,place-diameter,dead-balance,water-level,dens-prov,place-virtual,place-twice-code,place-sert-urov,place-local,place-error-mass,place-asi-sertif,place-rvd-dnsty,place-rvd-lvl,place-rvd-tmp,place-SI-dens,place-SI-level,place-SI-temp,place-passp-num,place-passp-type,place-dead-high,place-temp-coef,disable-water-alarm,disable-level-alarm,place-ponton,place-ponton-mass,place-ponton-height,place-com-vessel,place-com-tanks,place-is-main,place-gate-valve,place-gate-valve-tanks,place-auto-gate-valve':u):
     3544             v-code = entry(ii,'place-type,place-SI,place-diameter,dead-balance,water-level,dens-prov,place-virtual,place-twice-code,place-sert-urov,place-local,place-error-mass,place-asi-sertif,place-rvd-dnsty,place-rvd-lvl,place-rvd-tmp,place-SI-dens,place-SI-level,place-SI-temp,place-passp-num,place-passp-type,place-dead-high,place-temp-coef,disable-water-alarm,disable-level-alarm,place-ponton,place-ponton-mass,place-ponton-height,place-com-vessel,place-com-tanks,place-is-main,place-gate-valve,place-gate-valve-tanks,place-auto-gate-valve':u) .
     3545             run placelib_get-attr in this-procedure  (
     3546               input v-code
     3547               ,input buf_place.obj-code
     3548               ,input buf_place.obj-type
     3549               ,input buf_place.pl-code
     3550               ,output v-value
     3551               ,output v-ok      ) no-error.
     3552             case v-code :
     3553               when "place-type" then
     3554                 do :
     3555                   if v-ok then
     3556                   do :
     3557                     if integer(v-value) = 1 then tt-place-attr.place-type = "Вертикальный"  .
     3558                     if integer(v-value) = 2 then tt-place-attr.place-type = "Горизонтальный"  .
     3559                   end.
     3560                 end.
     3561               when "place-SI" then
     3562                 do :
     3563                   if v-ok then tt-place-attr.place-Si = integer(v-value) .
     3564                 end.
     3565               when "place-diameter" then
     3566                 do :
     3567                   if v-ok then tt-place-attr.place-diameter = decimal(v-value) .
     3568                 end.
     3569               when "dead-balance" then
     3570                 do :
     3571                   if v-ok then tt-place-attr.dead-balance = decimal(v-value) .
     3572                 end.
     3573               when "dens-prov" then
     3574                 do :
     3575                   if v-ok then tt-place-attr.place-dens-prov = decimal(v-value) .
     3576                 end.
     3577               when "place-twice-code" then
     3578                 do:
