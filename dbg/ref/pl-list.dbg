     1841       (input  v-cntxt-db-num
     1842       ,input  v-cntxt-userid
     1843       ,input  0
     1844       ,input  'actn_atd-pl-alarm':U
     1845       ,input  'object':U
     1846       ,input  v-cntxt-host-code-obj
     1847       ,input  v-cntxt-obj-type
     1848       ,input  v-cntxt-obj-code
     1849       ,input  0
     1850       ,input  0
     1851       ,input  0
     1852       ,input  true
     1853       ,output varlog
     1854       )  .
     1855   end.
     1856     if varlog <> yes then return no-apply .
     1857     v-pl-rowid = rowid (X_place).
     1858     run ref/atd-pl-alarm.w (input parparentproc,
     1859                             input p-obj-type,
     1860                             input p-obj-code,
     1861                             input v-pl-rowid)
     1862                             .
     1863   END.
     1864   ON VALUE-CHANGED OF br-pl IN FRAME d-pl-list
     1865     DO:
     1866       if available X_place then
     1867       do:
     1868         display
     1869           X_place.PS with frame d-pl-list.
     1870       end.
     1871     END.
     1872   ON ENTRY OF X_place.PS IN FRAME d-pl-list
     1873     DO:
     1874       v-doc-rec = recid (X_place).
     1875     END.
     1876   ON LEAVE OF X_place.PS IN FRAME d-pl-list
     1877     DO:
     1878       define buffer buf_place for ub.place.
     1879       find buf_place where recid (buf_place) = recid(X_place) no-error.
     1880       if available buf_place and input frame d-pl-list X_place.PS <> buf_place.PS then
     1881       do:
     1882         assign X_place.PS.
     1883       end.
     1884     END.
     1885   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME d-pl-list:PARENT eq ?
     1886     THEN FRAME d-pl-list:PARENT = ACTIVE-WINDOW.
     1887   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1888   on help of frame d-pl-list
     1889   do:
     1890     run gbl/app_help.p
     1891       (input this-procedure :file-name
     1892       ,input ''
     1893       ,input ?
     1894       ) no-error.
     1895     if error-status :error then do:
     1896       message
     1897         "Ошибка при вызове помощи"
     1898         error-status :get-message(1)
     1899         view-as alert-box .
     1900     end.
     1901   end.
     1902   run minbtn-set in this-procedure .
     1903   on choose of b-help in frame d-pl-list
     1904   do:
     1905     apply "help":u to frame d-pl-list .
     1906   end.
     1907   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1908   procedure minbtn-set :
     1909       do
     1910           on error undo, return error return-value
     1911           :
     1912           define variable ii              as integer       no-undo .
     1913           define variable fh              as widget-handle no-undo .
     1914           define variable hh              as widget-handle no-undo .
     1915           define variable v-h             as handle        extent 4 no-undo .
     1916           define variable v-name-button   as character     no-undo .
     1917           define variable v-help-old-x    as decimal       no-undo .
     1918           define variable v-help-old-y    as decimal       no-undo .
     1919           define variable v-help-old-size as decimal       no-undo .
     1920           define variable v-frame-width   as decimal       no-undo .
     1921           define variable jj              as integer       no-undo .
     1922           do
     1923               on error undo, return error
     1924               :
     1925               assign
     1926                   v-frame-width = frame d-pl-list:width - 0.3
     1927                   fh            = frame d-pl-list:first-child
     1928                   hh            = fh:first-child
     1929                   ii            = 1
     1930                   .
     1931               do while valid-handle(hh):
     1932                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1933                   do:
     1934                       case lc(hh:name) :
     1935                           when "b-help" then
     1936                               do:
     1937                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1938                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1939                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1940                                   hh:TOOLTIP = "Помощь" .
     1941                                   v-help-old-x = hh:column .
     1942                                   v-help-old-y = hh:row    .
     1943                                   v-help-old-size = hh:width .
     1944                                   hh:width-chars = 2.5 .
     1945                               end.
     1946                           when "b-print" then
     1947                               do:
     1948                                   hh:load-image("cmp/b-print.bmp":u) .
     1949                                   hh:TOOLTIP = "Печать" .
     1950                                   v-h[ii] = hh:handle .
     1951                                   ii = ii + 1 .
     1952                                   hh:width-chars = 3 .
     1953                               end.
     1954                           when "b-history" or
     1955                           when "b-hist" then
     1956                               do:
     1957                                   hh:load-image("cmp/b-hist.bmp":u) .
     1958                                   hh:TOOLTIP = "История" .
     1959                                   v-h[ii] = hh:handle .
     1960                                   ii = ii + 1 .
     1961                                   hh:width-chars = 3 .
     1962                               end.
     1963                           when "b-sch" then
     1964                               do:
     1965                                   hh:load-image("cmp/b-sch.bmp":u) .
     1966                                   hh:TOOLTIP = "Установка Фильтра" .
     1967                                   v-h[ii] = hh:handle .
     1968                                   ii = ii + 1 .
     1969                                   hh:width-chars = 3 .
     1970                               end.
     1971                           when "b-hist-user" then
     1972                               do:
     1973                                   hh:load-image("cmp/b-hist.bmp":u) .
     1974                                   hh:TOOLTIP = "История пользователя" .
     1975                                   ii = ii + 1 .
     1976                               end.
     1977                       end case.
     1978                   end.
     1979                   hh = hh:next-sibling.
     1980               end.
     1981               b-help:column = v-frame-width - b-help:width-chars.
     1982               jj = 0.
     1983               repeat ii = 4 to 1 by -1 :
     1984                   if valid-handle (v-h[ii] ) then
     1985                   do:
     1986                       jj  = jj + 1 .
     1987                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1988                       v-h[ii]:row    = v-help-old-y .
     1989                   end.
     1990               end.
     1991           end.
     1992       end.
     1993   end procedure.
     1994   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1995   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1996   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1997   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1998   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1999   define variable v-diasize-current-frame-height as decimal   no-undo .
     2000   define variable v-diasize-change-size          as logical   no-undo .
     2001   define variable v-diasize-resize-button        as handle    no-undo .
     2002   define variable v-diasize-wndmax               as logical   no-undo .
     2003   define variable v-diasize-wndstore             as logical   no-undo .
     2004   define variable v-diasize-proc-name            as character no-undo .
     2005   define variable v-diasize-browse-handle        as handle    no-undo .
     2006   define variable v-diasize-browse-number        as integer   no-undo .
     2007   define variable v-diasize-need-full-display    as logical   no-undo init false .
     2008   define temp-table temp-diasize-handle no-undo
     2009     field handle-value  as handle
     2010     field save-position as decimal
     2011     index xpk is primary unique handle-value
     2012     .
     2013   define temp-table temp-browse-handle no-undo
     2014     field browse-type   as character
     2015     field browse-number as integer
     2016     field browse-handle as handle
     2017     field original-size as decimal
     2018     index xpk is primary unique browse-type browse-number
     2019     index xie browse-type browse-handle
     2020   .
     2021   procedure diasize_change-height :
     2022     define input  parameter p-change-value  as decimal   no-undo .
     2023     define input  parameter p-move-resize   as logical   no-undo .
     2024     define variable v-field-group-handle    as handle    no-undo .
     2025     define variable v-object-handle         as handle    no-undo .
     2026     define variable v-frame-height          as decimal   no-undo .
     2027     define variable v-frame-virtual-height  as decimal   no-undo .
     2028     define variable v-browse-height         as decimal   no-undo .
     2029     define variable v-window-height         as decimal   no-undo .
     2030     define variable v-window-virtual-height as decimal   no-undo .
     2031     define variable v-change-sign           as integer   no-undo .
     2032     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2033     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2034     if p-change-value > 0
     2035     then do:
     2036       if frame d-pl-list :height + p-change-value
     2037           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     2038       then do:
     2039         assign
     2040           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     2041                           - (frame d-pl-list :height-chars)
     2042         .
     2043         if p-change-value <= 0
     2044         then do:
     2045           run diasize_position-resize-button in this-procedure .
     2046           return .
     2047         end.
     2048       end.
     2049     end.
     2050     if p-change-value < 0
     2051     then do:
     2052       if frame d-pl-list :height + p-change-value < v-diasize-orig-frame-height
     2053       then do:
     2054         assign
     2055           p-change-value = v-diasize-orig-frame-height
     2056                          - (frame d-pl-list :height-chars)
     2057         .
     2058         if p-change-value >= 0
     2059         then do:
     2060           run diasize_position-resize-button in this-procedure .
     2061           return .
     2062         end.
     2063       end.
     2064     end.
     2065     if p-change-value >= 0
     2066     then do:
     2067       assign
     2068         v-change-sign = 1
     2069       .
     2070     end.
     2071     else do:
     2072       assign
     2073         v-change-sign = -1
     2074       .
     2075     end.
     2076     assign
     2077       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2078     .
     2079     if p-change-value = 0
     2080     then do:
     2081       run diasize_position-resize-button in this-procedure .
     2082       return .
     2083     end.
     2084     move_block:
     2085     do
     2086     on error undo move_block, retry move_block
     2087     :
     2088       if retry
     2089       then do:
     2090         do
     2091         on error undo move_block, leave move_block
     2092         :
     2093           if p-change-value > 0
     2094           then do:
     2095             for each buf_temp-diasize-handle
     2096             on error undo, next
     2097             :
     2098               assign
     2099                 v-object-handle = buf_temp-diasize-handle.handle-value
     2100               .
     2101               if v-object-handle <> v-diasize-resize-button
     2102               then do:
     2103                 assign
     2104                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2105                 .
     2106               end.
     2107             end.
     2108             assign
     2109               v-diasize-browse-handle :height = v-browse-height
     2110             .
     2111             for each buf_temp-browse-handle
     2112               where buf_temp-browse-handle.browse-type = 'height':u
     2113             on error undo, next
     2114             :
     2115               assign
     2116                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2117               .
     2118             end.
     2119             assign
     2120               frame d-pl-list :height = v-frame-height
     2121             .
     2122             if frame d-pl-list :scrollable = true
     2123             then do:
     2124               assign
     2125                 frame d-pl-list :virtual-height = v-frame-virtual-height
     2126               .
     2127             end.
     2128             run diasize_position-resize-button in this-procedure .
     2129           end.
     2130           else do:
     2131             if frame d-pl-list :scrollable = true
     2132             then do:
     2133               assign
     2134                 frame d-pl-list :virtual-height = v-frame-virtual-height
     2135               .
     2136             end.
     2137             assign
     2138               frame d-pl-list :height = v-frame-height
     2139             .
     2140             assign
     2141               v-diasize-browse-handle :height = v-browse-height
     2142             .
     2143             for each buf_temp-browse-handle
     2144               where buf_temp-browse-handle.browse-type = 'height':u
     2145             on error undo, next
     2146             :
     2147               assign
     2148                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2149               .
     2150             end.
     2151             for each buf_temp-diasize-handle
     2152             on error undo, next
     2153             :
     2154               assign
     2155                 v-object-handle = buf_temp-diasize-handle.handle-value
     2156               .
     2157               if v-object-handle <> v-diasize-resize-button
     2158               then do:
     2159                 assign
     2160                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2161                 .
     2162               end.
     2163             end.
     2164             run diasize_position-resize-button in this-procedure .
     2165           end.
     2166           assign
     2167             v-diasize-change-size = false
     2168           .
     2169           leave move_block .
     2170         end.
     2171       end.
     2172       assign
     2173         v-diasize-need-full-display = true
     2174       .
     2175       if v-diasize-change-size = false
     2176       then do:
     2177         assign
     2178           v-diasize-change-size = true
     2179         .
     2180       end.
     2181       else do:
     2182         return .
     2183       end.
     2184       assign
     2185         v-frame-height = frame d-pl-list :height
     2186         v-frame-virtual-height = frame d-pl-list :virtual-height
     2187         v-browse-height = v-diasize-browse-handle :height
     2188       .
     2189       for each buf_temp-browse-handle
     2190         where buf_temp-browse-handle.browse-type = 'height':u
     2191       :
     2192         assign
     2193           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     2194         .
     2195       end.
     2196       for each buf_temp-diasize-handle
     2197       :
     2198         delete buf_temp-diasize-handle .
     2199       end.
     2200       assign
     2201         v-field-group-handle = frame d-pl-list :first-child
     2202       .
     2203       do while valid-handle(v-field-group-handle)
     2204       :
     2205         assign
     2206           v-object-handle = v-field-group-handle :first-child
     2207         .
     2208         do while valid-handle(v-object-handle)
     2209         :
     2210           if  v-object-handle <> v-diasize-browse-handle :handle
     2211           and can-query(v-object-handle, "row")
     2212           and can-query(v-object-handle, "height")
     2213           and ( v-object-handle :row > v-diasize-browse-handle :row )
     2214           then do:
     2215             find first buf_temp-browse-handle
     2216               where buf_temp-browse-handle.browse-type   = 'height':u
     2217                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2218               no-error .
     2219             if available buf_temp-browse-handle
     2220             then do:
     2221             end.
     2222             else do:
     2223               create buf_temp-diasize-handle .
     2224               assign
     2225                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2226                 buf_temp-diasize-handle.save-position = v-object-handle :row
     2227               .
     2228             end.
     2229           end.
     2230           assign
     2231             v-object-handle = v-object-handle :next-sibling
     2232           .
     2233         end.
     2234         assign
     2235           v-field-group-handle = v-field-group-handle :next-sibling
     2236         .
     2237       end.
     2238       do with frame d-pl-list
     2239       :
     2240         hide v-diasize-resize-button .
     2241         assign
     2242           v-diasize-resize-button :row    = 1
     2243           v-diasize-resize-button :column = 1
     2244         .
     2245       end.
     2246       if p-change-value > 0
     2247       then do:
     2248         if frame d-pl-list :scrollable = true
     2249         then do:
     2250           assign
     2251             frame d-pl-list :virtual-height = frame d-pl-list :virtual-height + p-change-value
     2252             no-error .
     2253           if error-status :error
     2254           or error-status :get-message(1) <> ""
     2255           then do:
     2256             undo move_block, retry move_block .
     2257           end.
     2258         end.
     2259         assign
     2260           frame d-pl-list :height = frame d-pl-list :height + p-change-value
     2261           no-error .
     2262         if error-status :error
     2263         or error-status :get-message(1) <> ""
     2264         then do:
     2265           undo move_block, retry move_block .
     2266         end.
     2267         assign
     2268           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2269           no-error .
     2270         if error-status :error
     2271         or error-status :get-message(1) <> ""
     2272         then do:
     2273           undo move_block, retry move_block .
     2274         end.
     2275         for each buf_temp-browse-handle
     2276           where buf_temp-browse-handle.browse-type = 'height':u
     2277         on error undo move_block, retry move_block
     2278         :
     2279           assign
     2280             buf_temp-browse-handle.browse-handle :height
     2281               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2282             no-error .
     2283           if error-status :error
     2284           or error-status :get-message(1) <> ""
     2285           then do:
     2286             undo move_block, retry move_block .
     2287           end.
     2288         end.
     2289         for each buf_temp-diasize-handle
     2290         on error undo move_block, retry move_block
     2291         :
     2292           assign
     2293             v-object-handle = buf_temp-diasize-handle.handle-value
     2294           .
     2295           if v-object-handle <> v-diasize-resize-button
     2296           then do:
     2297             assign
     2298               v-object-handle :row = v-object-handle :row + p-change-value
     2299               no-error .
     2300             if error-status :error
     2301             or error-status :get-message(1) <> ""
     2302             then do:
     2303               undo move_block, retry move_block .
     2304             end.
     2305           end.
     2306         end.
     2307       end.
     2308       else do:
     2309         for each buf_temp-diasize-handle
     2310         on error undo move_block, retry move_block
     2311         :
     2312           assign
     2313             v-object-handle = buf_temp-diasize-handle.handle-value
     2314           .
     2315           if v-object-handle <> v-diasize-resize-button
     2316           then do:
     2317             assign
     2318               v-object-handle :row = v-object-handle :row + p-change-value
     2319               no-error .
     2320             if error-status :error
     2321             or error-status :get-message(1) <> ""
     2322             then do:
     2323               undo move_block, retry move_block .
     2324             end.
     2325           end.
     2326         end.
     2327         assign
     2328           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2329           no-error .
     2330         if error-status :error
     2331         or error-status :get-message(1) <> ""
     2332         then do:
     2333           undo move_block, retry move_block .
     2334         end.
     2335         for each buf_temp-browse-handle
     2336           where buf_temp-browse-handle.browse-type = 'height':u
     2337         on error undo move_block, retry move_block
     2338         :
     2339           assign
     2340             buf_temp-browse-handle.browse-handle :height
     2341               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2342             no-error .
     2343           if error-status :error
     2344           or error-status :get-message(1) <> ""
     2345           then do:
     2346             undo move_block, retry move_block .
     2347           end.
     2348         end.
     2349         assign
     2350           frame d-pl-list :height = frame d-pl-list :height + p-change-value
     2351           no-error .
     2352         if error-status :error
     2353         or error-status :get-message(1) <> ""
     2354         then do:
     2355           undo move_block, retry move_block .
     2356         end.
     2357         if frame d-pl-list :scrollable = true
     2358         then do:
     2359           assign
     2360             frame d-pl-list :virtual-height = frame d-pl-list :virtual-height + p-change-value
     2361             no-error .
     2362           if error-status :error
     2363           or error-status :get-message(1) <> ""
     2364           then do:
     2365             undo move_block, retry move_block .
     2366           end.
     2367         end.
     2368       end.
     2369       if p-move-resize = true
     2370       then do:
     2371         run diasize_position-resize-button in this-procedure .
     2372       end.
     2373       if v-diasize-wndstore = true
     2374       then do:
     2375         if connected("ub") = true
     2376         then do:
     2377           define variable v-cntxt-db-num        as integer   no-undo .
     2378           define variable v-cntxt-userid        as character no-undo .
     2379           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2380                                             , OUTPUT v-cntxt-userid
     2381                                             ) .
     2382           run gbl/wndsizew.p
     2383             (input  v-cntxt-db-num
     2384             ,input  v-cntxt-userid
     2385             ,input  v-diasize-proc-name
     2386             ,input  'height':u
     2387             ,input  string(frame d-pl-list :height - v-diasize-orig-frame-height)
     2388             ) .
     2389         end.
     2390       end.
     2391     end.
     2392     assign
     2393       v-diasize-change-size = false
     2394     .
     2395   end procedure.
     2396   procedure diasize_set-height :
     2397     define input  parameter p-new-height  as decimal   no-undo .
     2398     define input  parameter p-move-resize as logical   no-undo .
     2399     do
     2400     on error undo, return error return-value
     2401     :
     2402       run diasize_change-height in this-procedure
     2403         (input  (p-new-height - frame d-pl-list :height)
     2404         ,input  p-move-resize
     2405         ) .
     2406     end.
     2407   end procedure.
     2408   procedure diasize_change-width :
     2409     define input  parameter p-change-value as decimal   no-undo .
     2410     define input  parameter p-move-resize  as logical   no-undo .
     2411     define variable v-field-group-handle   as handle    no-undo .
     2412     define variable v-object-handle        as handle    no-undo .
     2413     define variable v-frame-width          as decimal   no-undo .
     2414     define variable v-frame-virtual-width  as decimal   no-undo .
     2415     define variable v-browse-width         as decimal   no-undo .
     2416     define variable v-window-width         as decimal   no-undo .
     2417     define variable v-window-virtual-width as decimal   no-undo .
     2418     define variable v-change-sign          as integer   no-undo .
     2419     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2420     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2421     if p-change-value > 0
     2422     then do:
     2423       if frame d-pl-list :width + p-change-value >
     2424           session :width-chars
     2425       then do:
     2426         assign
     2427           p-change-value = session :width-chars - frame d-pl-list :width
     2428         .
     2429         if p-change-value <= 0
     2430         then do:
     2431           run diasize_position-resize-button in this-procedure .
     2432           return .
     2433         end.
     2434       end.
     2435     end.
     2436     if p-change-value < 0
     2437     then do:
     2438       if frame d-pl-list :width + p-change-value < v-diasize-orig-frame-width
     2439       then do:
     2440         assign
     2441           p-change-value = v-diasize-orig-frame-width
     2442                          - frame d-pl-list :width
     2443         .
     2444         if p-change-value >= 0
     2445         then do:
     2446           run diasize_position-resize-button in this-procedure .
     2447           return .
     2448         end.
     2449       end.
     2450     end.
     2451     if p-change-value >= 0
     2452     then do:
     2453       assign
     2454         v-change-sign = 1
     2455       .
     2456     end.
     2457     else do:
     2458       assign
     2459         v-change-sign = -1
     2460       .
     2461     end.
     2462     assign
     2463       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2464     .
     2465     if p-change-value = 0
     2466     then do:
     2467       run diasize_position-resize-button in this-procedure .
     2468       return .
     2469     end.
     2470     move_block:
     2471     do
     2472     on error undo move_block, leave move_block
     2473     :
     2474       if retry
     2475       then do:
     2476         do
     2477         on error undo move_block, leave move_block
     2478         :
     2479           if p-change-value > 0
     2480           then do:
     2481             for each buf_temp-diasize-handle
     2482             on error undo, next
     2483             :
     2484               assign
     2485                 v-object-handle = buf_temp-diasize-handle.handle-value
     2486               .
     2487               if v-object-handle <> v-diasize-resize-button
     2488               then do:
     2489                 assign
     2490                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2491                 .
     2492               end.
     2493             end.
     2494             assign
     2495               v-diasize-browse-handle :width = v-browse-width
     2496             .
     2497             for each buf_temp-browse-handle
     2498               where buf_temp-browse-handle.browse-type = 'width':u
     2499             on error undo, next
     2500             :
     2501               assign
     2502                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2503               .
     2504             end.
     2505             assign
     2506               frame d-pl-list :width = v-frame-width
     2507             .
     2508             if frame d-pl-list :scrollable = true
     2509             then do:
     2510               assign
     2511                 frame d-pl-list :virtual-width = v-frame-virtual-width
     2512               .
     2513             end.
     2514             run diasize_position-resize-button in this-procedure .
     2515           end.
     2516           else do:
     2517             if frame d-pl-list :scrollable = true
     2518             then do:
     2519               assign
     2520                 frame d-pl-list :virtual-width = v-frame-virtual-width
     2521               .
     2522             end.
     2523             assign
     2524               frame d-pl-list :width = v-frame-width
     2525             .
     2526             for each buf_temp-browse-handle
     2527               where buf_temp-browse-handle.browse-type = 'width':u
     2528             on error undo, next
     2529             :
     2530               assign
     2531                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2532               .
     2533             end.
     2534             assign
     2535               v-diasize-browse-handle :width = v-browse-width
     2536             .
     2537             for each buf_temp-diasize-handle
     2538             on error undo, next
     2539             :
     2540               assign
     2541                 v-object-handle = buf_temp-diasize-handle.handle-value
     2542               .
     2543               if v-object-handle <> v-diasize-resize-button
     2544               then do:
     2545                 assign
     2546                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2547                 .
     2548               end.
     2549             end.
     2550             run diasize_position-resize-button in this-procedure .
     2551           end.
     2552           assign
     2553             v-diasize-change-size = false
     2554           .
     2555           leave move_block .
     2556         end.
     2557       end.
     2558       assign
     2559         v-diasize-need-full-display = true
     2560       .
     2561       if v-diasize-change-size = false
     2562       then do:
     2563         assign
     2564           v-diasize-change-size = true
     2565         .
     2566       end.
     2567       else do:
     2568         return .
     2569       end.
     2570       assign
     2571         v-frame-width = frame d-pl-list :width
     2572         v-frame-virtual-width = frame d-pl-list :virtual-width
     2573         v-browse-width = v-diasize-browse-handle :width
     2574       .
     2575       for each buf_temp-browse-handle
     2576         where buf_temp-browse-handle.browse-type = 'width':u
     2577       :
     2578         assign
     2579           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2580         .
     2581       end.
     2582       for each buf_temp-diasize-handle
     2583       :
     2584         delete buf_temp-diasize-handle .
     2585       end.
     2586       assign
     2587         v-field-group-handle = frame d-pl-list :first-child
     2588       .
     2589       do while valid-handle(v-field-group-handle)
     2590       :
     2591         assign
     2592           v-object-handle = v-field-group-handle :first-child
     2593         .
     2594         do while valid-handle(v-object-handle)
     2595         :
     2596           if  v-object-handle <> v-diasize-browse-handle :handle
     2597           and v-object-handle <> v-diasize-resize-button
     2598           and can-query(v-object-handle, "row")
     2599           and can-query(v-object-handle, "height")
     2600           and ( v-object-handle :col + v-object-handle :width
     2601                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2602               )
     2603           then do:
     2604             find first buf_temp-browse-handle
     2605               where buf_temp-browse-handle.browse-type   = 'width':u
     2606                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2607               no-error .
     2608             if available buf_temp-browse-handle
     2609             then do:
     2610             end.
     2611             else do:
     2612               create buf_temp-diasize-handle .
     2613               assign
     2614                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2615                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2616               .
     2617             end.
     2618           end.
     2619           assign
     2620             v-object-handle = v-object-handle :next-sibling
     2621           .
     2622         end.
     2623         assign
     2624           v-field-group-handle = v-field-group-handle :next-sibling
     2625         .
     2626       end.
     2627       do with frame d-pl-list
     2628       :
     2629         hide v-diasize-resize-button .
     2630         v-diasize-resize-button :row = 1.
     2631         v-diasize-resize-button :column = 1.
     2632       end.
     2633       if p-change-value > 0
     2634       then do:
     2635         if frame d-pl-list :scrollable = true
     2636         then do:
     2637           assign
     2638             frame d-pl-list :virtual-width = frame d-pl-list :virtual-width + p-change-value
     2639             no-error .
     2640           if error-status :error
     2641           or error-status :get-message(1) <> ""
     2642           then do:
     2643             undo move_block, retry move_block.
     2644           end.
     2645         end.
     2646         assign
     2647           frame d-pl-list :width = v-frame-width + p-change-value
     2648           no-error .
     2649         if error-status :error
     2650         or error-status :get-message(1) <> ""
     2651         then do:
     2652           undo move_block, retry move_block.
     2653         end.
     2654         assign
     2655           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2656         no-error .
     2657         if error-status :error
     2658         or error-status :get-message(1) <> ""
     2659         then do:
     2660           undo move_block, retry move_block.
     2661         end.
     2662         for each buf_temp-browse-handle
     2663           where buf_temp-browse-handle.browse-type = 'width':u
     2664         on error undo move_block, retry move_block
     2665         :
     2666           assign
     2667             buf_temp-browse-handle.browse-handle :width
     2668               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2669             no-error .
     2670           if error-status :error
     2671           or error-status :get-message(1) <> ""
     2672           then do:
     2673             undo move_block, retry move_block .
     2674           end.
     2675         end.
     2676         for each buf_temp-diasize-handle
     2677         on error undo move_block, retry move_block
     2678         :
     2679           assign
     2680             v-object-handle = buf_temp-diasize-handle.handle-value
     2681           .
     2682           if v-object-handle <> v-diasize-resize-button
     2683           then do:
     2684             assign
     2685               v-object-handle :col = v-object-handle :col + p-change-value
     2686               no-error .
     2687             if error-status :error
     2688             or error-status :get-message(1) <> ""
     2689             then do:
     2690               undo move_block, retry move_block .
     2691             end.
     2692           end.
     2693         end.
     2694       end.
     2695       else do:
     2696         for each buf_temp-diasize-handle
     2697         on error undo move_block, retry move_block
     2698         :
     2699           assign
     2700             v-object-handle = buf_temp-diasize-handle.handle-value
     2701           .
     2702           if v-object-handle <> v-diasize-resize-button
     2703           then do:
     2704             assign
     2705               v-object-handle :col = v-object-handle :col + p-change-value
     2706               no-error .
     2707             if error-status :error
     2708             or error-status :get-message(1) <> ""
     2709             then do:
     2710               undo move_block, retry move_block .
     2711             end.
     2712           end.
     2713         end.
     2714         for each buf_temp-browse-handle
     2715           where buf_temp-browse-handle.browse-type = 'width':u
     2716         on error undo move_block, retry move_block
     2717         :
     2718           assign
     2719             buf_temp-browse-handle.browse-handle :width
     2720               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2721             no-error .
     2722           if error-status :error
     2723           or error-status :get-message(1) <> ""
     2724           then do:
     2725             undo move_block, retry move_block .
     2726           end.
     2727         end.
     2728         assign
     2729           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2730           no-error .
     2731         if error-status :error
     2732         or error-status :get-message(1) <> ""
     2733         then do:
     2734           undo move_block, retry move_block.
     2735         end.
     2736         assign
     2737           frame d-pl-list :width = frame d-pl-list :width + p-change-value
     2738         no-error .
     2739         if error-status :error
     2740         or error-status :get-message(1) <> ""
     2741         then do:
     2742           undo move_block, retry move_block.
     2743         end.
     2744         if frame d-pl-list :scrollable = true
     2745         then do:
     2746           assign
     2747             frame d-pl-list :virtual-width = frame d-pl-list :virtual-width + p-change-value
     2748           no-error .
     2749           if error-status :error
     2750           or error-status :get-message(1) <> ""
     2751           then do:
     2752             undo move_block, retry move_block.
     2753           end.
     2754         end.
     2755       end.
     2756       if p-move-resize
     2757       then do:
     2758         run diasize_position-resize-button in this-procedure .
     2759       end.
     2760       if v-diasize-wndstore = true
     2761       then do:
     2762         if connected("ub") = true
     2763         then do:
     2764           define variable v-cntxt-db-num        as integer   no-undo .
     2765           define variable v-cntxt-userid        as character no-undo .
     2766           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2767                                             , OUTPUT v-cntxt-userid
     2768                                             ) .
     2769           run gbl/wndsizew.p
     2770             (input  v-cntxt-db-num
     2771             ,input  v-cntxt-userid
     2772             ,input  v-diasize-proc-name
     2773             ,input  'width':u
     2774             ,input  string(frame d-pl-list :width - v-diasize-orig-frame-width)
     2775             ) .
     2776         end.
     2777       end.
     2778     end.
     2779     assign
     2780       v-diasize-change-size = false
     2781     .
     2782   end procedure.
     2783   procedure diasize_set-width :
     2784     define input  parameter p-new-width  as decimal   no-undo .
     2785     define input  parameter p-move-resize as logical   no-undo .
     2786     do
     2787     on error undo, return error return-value
     2788     :
     2789       run diasize_change-width in this-procedure
     2790         (input  (p-new-width - frame d-pl-list :width)
     2791         ,input  p-move-resize
     2792         ) .
     2793     end.
     2794   end procedure.
     2795   procedure diasize_position-resize-button :
     2796     do with frame d-pl-list
     2797     :
     2798       hide v-diasize-resize-button .
     2799       assign
     2800         v-diasize-resize-button :row = frame d-pl-list :height - v-diasize-resize-button :height
     2801                     - 1
     2802                     - (frame d-pl-list :border-bottom-pixels / session :pixels-per-row)
     2803         v-diasize-resize-button :col = frame d-pl-list :width - v-diasize-resize-button :width
     2804                     - 1
     2805                     - (frame d-pl-list :border-right-pixels / session :pixels-per-column)
     2806       .
     2807       view v-diasize-resize-button .
     2808     end.
     2809   end procedure.
     2810   on alt-right anywhere
     2811   do:
     2812     run diasize_change-width in this-procedure
     2813       (input 1
     2814       ,input true
     2815       ) .
     2816     return no-apply .
     2817   end.
     2818   on alt-left anywhere
     2819   do:
     2820     run diasize_change-width in this-procedure
     2821       (input -1
     2822       ,input true
     2823       ) .
     2824     return no-apply .
     2825   end.
     2826   on alt-down anywhere
     2827   do:
     2828     run diasize_change-height in this-procedure
     2829       (input 1
     2830       ,input true
     2831       ) .
     2832     return no-apply .
     2833   end.
     2834   on alt-up anywhere
     2835   do:
     2836     run diasize_change-height in this-procedure
     2837       (input -1
     2838       ,input true
     2839       ) .
     2840     return no-apply .
     2841   end.
     2842   on alt-enter of frame d-pl-list
     2843   do:
     2844     run diasize_maximize in this-procedure
     2845       (input  ?
     2846       ).
     2847     return no-apply .
     2848   end.
     2849   procedure diasize_end-move :
     2850     do
     2851     on error undo, return error return-value
     2852     :
     2853       define variable v-row-delta as decimal   no-undo .
     2854       define variable v-col-delta as decimal   no-undo .
     2855       define variable v-new-row as decimal   no-undo .
     2856       define variable v-new-col as decimal   no-undo .
     2857       assign
     2858         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2859         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2860       .
     2861       assign
     2862         v-row-delta = v-new-row - frame d-pl-list :height
     2863         v-col-delta = v-new-col - frame d-pl-list :width
     2864       .
     2865       run diasize_change-height in this-procedure
     2866         (input v-row-delta
     2867         ,input true
     2868         ) .
     2869       run diasize_change-width in this-procedure
     2870         (input v-col-delta
     2871         ,input true
     2872         ) .
     2873     end.
     2874   end procedure.
     2875   procedure diasize_maximize :
     2876     define input  parameter p-action as logical   no-undo .
     2877     do
     2878     on error undo, return error return-value
     2879     :
     2880       if p-action = ?
     2881       then do:
     2882         if v-diasize-need-maximize = true
     2883         then do:
     2884           assign
     2885             p-action = true
     2886           .
     2887         end.
     2888         else do:
     2889           assign
     2890             p-action = false
     2891           .
     2892         end.
     2893       end.
     2894       if p-action = true
     2895       then do:
     2896         run diasize_change-height in this-procedure
     2897           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2898               - frame d-pl-list :height-chars
     2899           ,input true
     2900           ) .
     2901         run diasize_change-width in this-procedure
     2902           (input session :width-chars
     2903               - frame d-pl-list :width-chars
     2904           ,input true
     2905           ) .
     2906         assign
     2907           v-diasize-need-maximize = false
     2908         .
     2909       end.
     2910       else do:
     2911         run diasize_change-width in this-procedure
     2912           (input v-diasize-orig-frame-width
     2913               - frame d-pl-list :width-chars
     2914           ,input true
     2915           ) .
     2916         run diasize_change-height in this-procedure
     2917           (input v-diasize-orig-frame-height
     2918               - frame d-pl-list :height-chars
     2919           ,input true
     2920           ) .
     2921         assign
     2922           v-diasize-need-maximize = true
     2923         .
     2924       end.
     2925     end.
     2926   end procedure.
     2927   procedure diasize_restore-orig-size :
     2928     do
     2929     on error undo, return error return-value
     2930     :
     2931       assign
     2932         v-diasize-current-frame-width  = frame d-pl-list :width
     2933         v-diasize-current-frame-height = frame d-pl-list :height
     2934       .
     2935       run diasize_set-height in this-procedure
     2936         (input  v-diasize-orig-frame-height
     2937         ,input  true
     2938         ) .
     2939       run diasize_set-width in this-procedure
     2940         (input  v-diasize-orig-frame-width
     2941         ,input  true
     2942         ) .
     2943     end.
     2944   end procedure.
     2945   procedure diasize_restore-current-size :
     2946     do
     2947     on error undo, return error return-value
     2948     :
     2949       run diasize_set-height in this-procedure
     2950         (input  v-diasize-current-frame-height
     2951         ,input  true
     2952         ) .
     2953       run diasize_set-width in this-procedure
     2954         (input  v-diasize-current-frame-width
     2955         ,input  true
     2956         ) .
     2957     end.
     2958   end procedure.
     2959   procedure diasize_set-browse-handle :
     2960     define input  parameter p-browse-handle as handle   no-undo .
     2961     define buffer buf_temp-browse-handle for temp-browse-handle .
     2962     do
     2963     on error undo, return error return-value
     2964     :
     2965       assign
     2966         v-diasize-browse-handle = p-browse-handle
     2967       .
     2968       for each buf_temp-browse-handle
     2969       on error undo, return error return-value
     2970       :
     2971         delete buf_temp-browse-handle .
     2972       end.
     2973     end.
     2974   end procedure.
     2975   procedure diasize_add_browse :
     2976     define input  parameter p-browse-type   as character no-undo .
     2977     define input  parameter p-browse-handle as handle    no-undo .
     2978     define buffer buf_temp-browse-handle for temp-browse-handle .
     2979     do
     2980     on error undo, return error return-value
     2981     :
     2982       assign
     2983         v-diasize-browse-number = v-diasize-browse-number + 1
     2984       .
     2985       create buf_temp-browse-handle .
     2986       assign
     2987         buf_temp-browse-handle.browse-type   = p-browse-type
     2988         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2989         buf_temp-browse-handle.browse-handle = p-browse-handle
     2990       .
     2991     end.
     2992   end procedure.
     2993   procedure diasize_init :
     2994     define variable v-default-value    as logical   no-undo .
     2995     define variable v-restore-saved    as logical   no-undo .
     2996     define variable v-resize-value-str as character no-undo .
     2997     do
     2998     on error undo, return error return-value
     2999     :
     3000       do with frame d-pl-list
     3001       :
     3002         assign
     3003           v-diasize-orig-frame-height = frame d-pl-list :height
     3004           v-diasize-orig-frame-width  = frame d-pl-list :width
     3005           v-diasize-browse-handle     = browse br-pl :handle
     3006         .
     3007         create button v-diasize-resize-button
     3008         assign
     3009           parent        = frame d-pl-list :first-child
     3010           label         = "s"
     3011           height-pixels = 16
     3012           width-pixels  = 16
     3013           visible       = true
     3014           sensitive     = true
     3015           movable       = true
     3016           triggers:
     3017             on end-move persistent run diasize_end-move in this-procedure .
     3018           end triggers.
     3019         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     3020         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     3021         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     3022         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     3023         assign
