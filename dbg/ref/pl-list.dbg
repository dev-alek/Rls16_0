     3580                 end.
     3581               when "place-asi-sertif" then
     3582                 do:
     3583                   if v-ok then tt-place-attr.asi-sertif = logical(v-value) .
     3584                 end.
     3585             end case.
     3586           end.
     3587           if v-is-only-np
     3588           then do :
     3589             find first buf_pl-gds no-lock where buf_pl-gds.pl-code = tt-place-attr.pl-code no-error .
     3590             if not available buf_pl-gds
     3591             then do :
     3592               delete tt-place-attr .
     3593             end .
     3594             else do :
     3595                           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     3596                 (input  buf_pl-gds.gds-code
     3597                 ,input  'fuel-type':U
     3598                 ,output v-value
     3599                 ,output par-type) no-error.
     3600               if v-value = "lgas"
     3601               or v-value = "metan"
     3602               or v-value = "propan"
     3603               then do :
     3604                 delete tt-place-attr .
     3605               end .
     3606             end .
     3607           end .
     3608           if v-is-np-list
     3609           then do :
     3610             find first tt-pl-list where tt-pl-list.pl-code = tt-place-attr.pl-code no-error .
     3611             if not available tt-pl-list
     3612             then do :
     3613               delete tt-place-attr .
     3614             end .
     3615           end .
     3616         end.
     3617       end.
     3618     end.
     3619     else
     3620     do:
     3621       for each buf_place where  (if rs-stat = 'все':U then true else  buf_place.status_ = (if rs-stat =  'текущие':U then "" else 'удал':U)) no-lock :
     3622         find first tt-place-attr exclusive-lock where tt-place-attr.pl-code = buf_place.pl-code no-error.
