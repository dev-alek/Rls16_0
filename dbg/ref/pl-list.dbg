     3230   def var sort-labelbr-pl   as character no-undo .
     3231   def var sort-clmnbr-pl    as handle    no-undo .
     3232   def var cur-clmnbr-pl     as handle    no-undo .
     3233   def var cur-clmn-locbr-pl as integer   no-undo .
     3234   def var re-querybr-pl     as logical   initial no no-undo .
     3235   on start-search, ctrl-o of br-pl in frame d-pl-list do:
     3236      run sort-brbr-pl
     3237        (input (if available X_place
     3238                then recid(X_place)
     3239                else ?
     3240               )
     3241        ).
     3242   end.
     3243   PROCEDURE sort-brbr-pl :
     3244     define input parameter p-recid as recid no-undo .
     3245     if re-querybr-pl = no then do:
     3246       assign
     3247          cur-clmnbr-pl = br-pl:current-column in frame d-pl-list
     3248       .
     3249       if sort-clmnbr-pl <> ? then sort-clmnbr-pl:column-fgcolor = 0.
     3250       if cur-clmnbr-pl = sort-clmnbr-pl then do:
     3251         assign
     3252            sort-labelbr-pl = ""
     3253            sort-clmnbr-pl = ?
     3254         .
     3255        end.
     3256        else do:
     3257          assign
     3258            sort-labelbr-pl = cur-clmnbr-pl:label
     3259            sort-clmnbr-pl  = cur-clmnbr-pl
     3260            sort-clmnbr-pl:column-fgcolor = 4
     3261          .
     3262        end.
     3263      end.
     3264     assign
     3265       cur-clmn-locbr-pl = 1
     3266     .
     3267     def var column-handle as handle no-undo .
     3268     column-handle = br-pl:first-column.
     3269     do while valid-handle(column-handle) :
     3270       if column-handle = cur-clmnbr-pl then do:
     3271         leave .
     3272       end.
     3273       column-handle = column-handle:NEXT-COLUMN.
     3274       assign
     3275         cur-clmn-locbr-pl = cur-clmn-locbr-pl + 1
     3276       .
     3277     end.
     3278     case sort-labelbr-pl:
     3279           when X_place.pl-code:label in browse br-pl then DO:    assign       sort-column-name = "X_place.pl-code"     .     run OpenBr in this-procedure ( input yes, input no, input '':U).   . END.
     3280           when X_place.pl-name:label in browse br-pl then DO:    assign       sort-column-name = "X_place.pl-name"     .     run OpenBr in this-procedure ( input yes, input no, input '':U).   . END.
     3281           when X_place.loc1:label in browse br-pl then DO:    assign       sort-column-name = "X_place.loc1"     .     run OpenBr in this-procedure ( input yes, input no, input '':U).   . END.
     3282           when X_place.loc2:label in browse br-pl then DO:    assign       sort-column-name = "X_place.loc2"     .     run OpenBr in this-procedure ( input yes, input no, input '':U).   . END.
     3283           when X_place.loc3:label in browse br-pl then DO:    assign       sort-column-name = "X_place.loc3"     .     run OpenBr in this-procedure ( input yes, input no, input '':U).   . END.
     3284           when X_place.loc4:label in browse br-pl then DO:    assign       sort-column-name = "X_place.loc4"     .     run OpenBr in this-procedure ( input yes, input no, input '':U).   . END.
     3285       otherwise do:
     3286         assign
     3287           sort-column-name = ""
     3288         .
     3289         run OpenBr in this-procedure (  input yes, input no, input '':U).
     3290           if can-do( this-procedure:internal-entries, 'mv-brw-defaultbr-pl') then do:
     3291             run mv-brw-defaultbr-pl.
     3292           end.
     3293         if sort-labelbr-pl <> "" then do:
     3294           assign
     3295             cur-clmnbr-pl:column-fgcolor = 0
     3296           .
     3297         end.
     3298         assign
     3299           cur-clmn-locbr-pl = ?
     3300         .
     3301       end.
     3302     end case.
     3303       if cur-clmn-locbr-pl <> ? then do:
     3304         if can-do( this-procedure:internal-entries, 'ch-clmnbr-pl') then do:
     3305           run ch-clmnbr-pl in this-procedure (cur-clmn-locbr-pl).
     3306         end.
     3307       end.
     3308     if p-recid <> ? then do:
     3309       reposition br-pl to recid p-recid no-error.
     3310       apply "value-changed" to br-pl in frame d-pl-list.
     3311     end.
     3312     apply "entry" to br-pl in frame d-pl-list.
     3313   END PROCEDURE.
     3314   procedure re-open-query-srt-clmnbr-pl:
     3315   if cur-clmnbr-pl = ? then do:
     3316      run OpenBr in this-procedure (  input yes, input no, input '':U).
     3317   end.
     3318   else do:
     3319      assign re-querybr-pl = yes.
     3320      run sort-brbr-pl
     3321        (input (if available X_place
     3322                then recid(X_place)
     3323                else ?
     3324               )
     3325        ).
     3326      assign re-querybr-pl = no.
     3327   end.
     3328   end.
