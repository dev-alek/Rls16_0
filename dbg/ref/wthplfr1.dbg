        1   block-level on error undo, throw.
        2   define input-output parameter par-rid as recid no-undo .
        3   define input parameter par-mode as character no-undo .
        4   define input parameter parw-p-code      like ub.wth-place.w-p-code no-undo .
        5   define input parameter parhost-code     like ub.wth-place.host-code no-undo .
        6   define input parameter parobj-type      like ub.wth-place.obj-type no-undo .
