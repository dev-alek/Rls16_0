      159   FUNCTION get-curr RETURNS CHARACTER
      160     (buffer loc-wealth for ub.wealth ) :
      161   define buffer buf_currency for ub.currency.
      162   if loc-wealth.curr-code = ? or loc-wealth.is-money = no then
      163   return loc-wealth.unit-base.
      164   FIND FIRST buf_currency no-lock where
      165             buf_currency.curr-code = loc-wealth.curr-code No-ERROR.
      166   if avail buf_currency then
      167     RETURN buf_currency.curr-abbr.
      168   else return "".
      169   END FUNCTION.
      170   DEFINE VARIABLE var-entry as character no-undo .
      171   DEFINE VARIABLE parstock like ub.wth-pobj.income-pl no-undo .
      172   if NOT (par-mode = 'ДОБАВЛЕНИЕ':U OR par-mode = 'ИЗМЕНЕНИЕ':U) then do:
      173     message
      174     vss-workfile vss-revision vss-description skip
      175     "Неверный параметр вызова par-mode" par-mode
      176     view-as alert-box ERROR.
      177     return error '':U.
      178   end.
      179   if par-mode = 'ДОБАВЛЕНИЕ':U AND
      180     can-find(FIRST ub.wth-place where
      181                    ub.wth-place.host-code = parhost-code AND
      182                    ub.wth-place.obj-code = parobj-code AND
      183                    ub.wth-place.obj-type = parobj-type AND
      184                    ub.wth-place.w-p-code = parw-p-code
      185                    ) then do:
      186     message
      187     vss-workfile vss-revision vss-description skip
      188     "Неверный параметр вызова parhost-code " parhost-code
      189     "и/или parobj-type " parobj-type SKIP
      190     "и/или parobj-code " parobj-code SKIP
      191     "и/или parw-p-code " parw-p-code SKIP
      192     "Уже есть МХ МЦ:"  skip
      193     "Код фирмы" parhost-code skip
      194     "Тип объекта" parobj-type skip
      195     "Код объекта" parobj-code skip
      196     "Код МХ" parw-p-code
      197     view-as alert-box ERROR.
      198     return error '':U.
      199   end.
      200   run trg/wthplfr3.p (
      201                    INPUT parw-p-code
      202                   ,INPUT parhost-code
      203                   ,INPUT parobj-type
      204                   ,INPUT parobj-code
      205                   ,INPUT parw-p-name
      206                   ,INPUT par-status_
      207                   ,INPUT parcash-desk
      208                   ,INPUT parmain-cash-desk
      209                   ,INPUT par-PS
      210                   ) no-error.
      211   if error-status:error then do:
      212     return error return-value.
      213   end.
      214   if par-mode = 'ДОБАВЛЕНИЕ':U then do:
      215     create ub.wth-place.
      216     assign par-rid = recid(ub.wth-place).
      217   end.
      218   else do:
      219     FIND FIRST ub.wth-place EXCLUSIVE-LOCK WHERE
      220               recid(ub.wth-place) = par-rid NO-WAIT No-ERROR.
      221     if locked ub.wth-place then do:
      222       message "Запись МХ МЦ занята"
      223       view-as alert-box error .
      224       return error.
      225     end.
      226     if not avail ub.wth-place then do:
      227       message "Не найдена запись МХ МЦ"
      228       view-as alert-box error .
      229       return error.
      230     end.
      231     if ub.wth-place.w-p-code <> parw-p-code OR
      232         ub.wth-place.host-code <> parhost-code OR
      233         ub.wth-place.obj-type <> parobj-type OR
      234         ub.wth-place.obj-code <> parobj-code then do:
      235         message
      236         vss-workfile vss-revision vss-description skip
      237         "Для уже имеющейся записи нельзя изменить"
      238         "код фирмы и/или объект и/или код МХ" skip
      239         view-as alert-box ERROR.
      240         return error '':U.
      241     end.
      242     if ub.wth-place.cash-desk <> parcash-desk and
      243        ub.wth-place.cash-desk <> 0 then do:
      244       for each ub.wth-pobj No-LOCK WHERE
      245                ub.wth-pobj.obj-type = parobj-type AND
      246                ub.wth-pobj.obj-code = parobj-code AND
      247                ub.wth-pobj.w-p-code = parw-p-code
      248                :
      249         run wth-lib_cur-stock-place in this-procedure (
      250                                                          input parobj-type
      251                                                         ,input parobj-code
      252                                                         ,input parw-p-code
      253                                                         ,input ub.wth-pobj.wth-code
      254                                                         ,output parstock) no-error .
      255         if parstock <> 0 then do:
      256           message
      257           vss-workfile vss-revision vss-description skip
      258           "Для уже имеющейся записи нельзя изменить"
      259           "номер кассы если было движение на это МХ МЦ или остаток МЦ на нем <> 0"
      260           view-as alert-box error .
      261           return error '':U.
      262         end.
      263       END.
      264     end.
      265   end.
      266   assign
      267   ub.wth-place.w-p-code =  (if par-mode = 'ДОБАВЛЕНИЕ':U
      268                             then next-value(s-wth-place, ub)
      269                             else parw-p-code)
      270   ub.wth-place.host-code =  parhost-code
      271   ub.wth-place.obj-type =  parobj-type
      272   ub.wth-place.obj-code =  parobj-code
      273   ub.wth-place.w-p-name =  parw-p-name
      274   ub.wth-place.status_ =  par-status_
      275   ub.wth-place.PS =  par-pS
      276   ub.wth-place.cash-desk = parcash-desk
      277   ub.wth-place.main-cash-desk = parmain-cash-desk
      278   .
      279   return '':U.
