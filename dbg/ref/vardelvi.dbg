        1   DEFINE BUFFER locked_delivery-type-subject FOR ub.delivery-type-subject.
        2   DEFINE BUFFER locked_variant-delivery FOR ub.variant-delivery.
        3   DEFINE TEMP-TABLE tt-delivery-type-subject NO-UNDO LIKE ub.delivery-type-subject.
        4   DEFINE TEMP-TABLE tt-variant-delivery NO-UNDO LIKE ub.variant-delivery.
        5   DEFINE BUFFER X_clients FOR ub.clients.
        6   DEFINE BUFFER X_curr_clients FOR ub.clients.
        7   DEFINE BUFFER X_delivery-subject FOR ub.delivery-subject.
        8   DEFINE BUFFER X_delivery-type FOR ub.delivery-type.
        9   DEFINE INPUT     PARAMETER parParentProc  AS WIDGET-HANDLE NO-UNDO.
       10   define input parameter p-curr-obj-type like ub.clients.obj-type no-undo.
       11   define input parameter p-curr-obj-code like ub.clients.obj-code no-undo.
       12   define input parameter p-mode as character no-undo.
       13   DEFINE INPUT PARAMETER p-deliv-type-code LIKE ub.variant-delivery.deliv-type-code NO-UNDO.
       14   DEFINE INPUT PARAMETER p-deliv-subj-code LIKE ub.variant-delivery.deliv-subj-code NO-UNDO.
       15   DEFINE INPUT PARAMETER p-deliv-obj-type  LIKE ub.variant-delivery.obj-type NO-UNDO.
       16   DEFINE INPUT PARAMETER p-deliv-obj-code  LIKE ub.variant-delivery.obj-code NO-UNDO.
       17   define input-output parameter p-doc-rec as recid no-undo.
       18   def var vss-revision    as character no-undo init "$Revision$":U .
       19   def var vss-author      as character no-undo init "$Author$":U .
       20   def var vss-date        as character no-undo init "$Date$":U .
       21   def var vss-workfile    as character no-undo init "$Workfile$":U .
       22   def var vss-archive     as character no-undo init "$Archive$":U .
       23   def var vss-description as character no-undo init "Карточка редактирования ВАРИАНТА ДОСТАВКИ".
       24   procedure vss-get-info :
       25     define output parameter p-vss-revision    like vss-revision    no-undo .
       26     define output parameter p-vss-author      like vss-author      no-undo .
       27     define output parameter p-vss-date        like vss-date        no-undo .
       28     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       29     define output parameter p-vss-archive     like vss-archive     no-undo .
       30     define output parameter p-vss-description like vss-description no-undo .
       31     assign
       32       p-vss-revision    = vss-revision
       33       p-vss-author      = vss-author
       34       p-vss-date        = vss-date
       35       p-vss-workfile    = vss-workfile
       36       p-vss-archive     = vss-archive
       37       p-vss-description = vss-description
       38     .
       39   end procedure.
       40   procedure vss-get-parameters :
       41     define output parameter p-vss-parameters as character no-undo .
       42   end procedure.
       43   define new global shared variable g#vssrevis-logger as handle    no-undo .
       44   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       45   define variable v-vssrevis-logger                   as handle    no-undo .
       46   procedure vss-logevent :
       47     define input  parameter p-extra-paramters as character no-undo .
       48     define variable v-vssrevis-parameters as character no-undo .
       49     do
       50     on error undo, return error return-value
       51     :
       52       if  valid-handle(v-vssrevis-logger)
       53       and v-vssrevis-logger :get-signature("logevent") <> ""
       54       then do:
       55         run vss-get-parameters in this-procedure
       56           (output v-vssrevis-parameters
       57           ).
       58         run logevent in v-vssrevis-logger
       59           (input vss-workfile
       60           ,input vss-revision
       61           ,input v-vssrevis-parameters
       62           ,input p-extra-paramters
       63           ).
       64       end.
       65     end.
       66   end procedure.
       67   assign
       68     v-vssrevis-logger = g#vssrevis-logger
       69   .
       70   if  valid-handle(v-vssrevis-logger)
       71   and v-vssrevis-logger :get-signature("logevent") <> ""
       72   then do:
       73     assign
       74       v-vssrevis-logevent = true
       75     .
       76     run vss-logevent in this-procedure (input vss-description) .
       77   end.
       78   define new global shared variable g#language as character no-undo .
       79   if g#language <> '' and g#language <> 'rus':U then do:
       80     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       81   end.
       82   define new global shared variable g#library  as handle no-undo .
       83   define new global shared variable g#library2 as handle no-undo .
       84   procedure proc-alt-shift-f2:
       85     if not ibs.th.gbl.gbl-var:rcode
       86   then
       87     run gbl\inidebug.p .
       88   end.
       89   procedure proc-alt-shift-f3:
       90     run gbl/prvssinf.p
       91       ( input this-procedure
       92       ) .
       93   end.
       94   define variable v-inform-launched as logical no-undo initial false .
       95   procedure proc-alt-shift-f4:
       96     define variable v-action as character no-undo .
       97     if v-inform-launched = false then do:
       98       assign
       99         v-inform-launched = true
      100       .
      101       run gbl/d-inform.w
      102         (  input self
      103         ,  input this-procedure
      104         , output v-action
      105         ) no-error .
      106       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      107       assign
      108         v-inform-launched = false
      109       .
      110     end.
      111   end.
      112   procedure proc-alt-f1:
      113     run gbl/corrhelp.p
      114       (input this-procedure
      115       ) .
      116   end .
      117   on alt-shift-f2 anywhere do:
      118     run proc-alt-shift-f2.
      119   end.
      120   on alt-shift-f3 anywhere do:
      121     run proc-alt-shift-f3 in this-procedure .
      122   end.
      123   on alt-shift-f4 anywhere do:
      124     run proc-alt-shift-f4 in this-procedure.
      125   end.
      126   on alt-f1 anywhere do:
      127     run proc-alt-f1 in this-procedure .
      128   end.
      129   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      130     define variable v-cntxt-db-num        as integer   no-undo .
      131     define variable v-cntxt-userid        as character no-undo .
      132     define variable v-cntxt-level         as character no-undo .
      133     define variable v-cntxt-host-code-obj as integer   no-undo .
      134     define variable v-cntxt-obj-type      as character no-undo .
      135     define variable v-cntxt-obj-code      as integer   no-undo .
      136     define variable v-cntxt-db-num-obj    as integer   no-undo .
      137     define variable v-cntxt-is-admin      as logical   no-undo .
      138   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      139   define temp-table userobjs_temp-user-obj no-undo
      140     field obj-type as character
      141     field obj-code as integer
      142     index xpk is primary unique obj-type obj-code
      143     .
      144   procedure userobjs_clear :
      145     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      146     do
      147     on error undo, return error return-value
      148     :
      149       for each buf_userobjs_temp-user-obj
      150       on error undo, return error return-value
      151       :
      152         delete buf_userobjs_temp-user-obj .
      153       end.
      154     end.
      155   end .
      156   procedure userobjs_object-count :
      157     define output parameter p-total-count as integer   no-undo .
      158     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      159     do
      160     on error undo, return error return-value
      161     :
      162       assign
      163         p-total-count = 0
      164       .
      165       for each buf_userobjs_temp-user-obj
      166       on error undo, return error return-value
      167       :
      168         assign
      169           p-total-count = p-total-count + 1
      170         .
      171       end.
      172     end.
      173   end.
      174   procedure userobjs_append :
      175      define input  parameter p-obj-type as character no-undo .
      176      define input  parameter p-obj-code as integer   no-undo .
      177     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      178     do
      179     on error undo, return error return-value
      180     :
      181       find first buf_userobjs_temp-user-obj
      182         where buf_userobjs_temp-user-obj.obj-type = p-obj-type
      183           and buf_userobjs_temp-user-obj.obj-code = p-obj-code
      184         no-error .
      185       if not available buf_userobjs_temp-user-obj
      186       then do:
      187         create buf_userobjs_temp-user-obj .
      188         assign
      189           buf_userobjs_temp-user-obj.obj-type = p-obj-type
      190           buf_userobjs_temp-user-obj.obj-code = p-obj-code
      191         .
      192       end.
      193     end.
      194   end.
      195   procedure userobjs_object-exist :
      196     define output parameter p-object-exist as logical   no-undo .
      197     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      198     do
      199     on error undo, return error return-value
      200     :
      201       find first buf_userobjs_temp-user-obj
      202         no-error .
      203       if not available buf_userobjs_temp-user-obj
      204       then do:
      205         assign
      206           p-object-exist = false
      207         .
      208       end.
      209       else do:
      210         assign
      211           p-object-exist = true
      212         .
      213       end.
      214     end.
      215   end.
      216   procedure userobjs_transfer :
      217     define input  parameter p-callback-handle as handle no-undo .
      218     define variable vss-description as character no-undo init "userobjs_transfer: Передача списка объектов".
      219     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      220     do
      221     on error undo, return error return-value
      222     :
      223       if valid-handle(p-callback-handle) <> true
      224       then do:
      225         message
      226           vss-workfile vss-revision vss-description skip
      227           "Ошибка задания входных параметров" skip
      228           "Неизвестный указатель на процедуру" skip
      229           view-as alert-box error .
      230         undo, return error return-value .
      231       end.
      232       if p-callback-handle :get-signature("userobjs_append") = ""
      233       then do:
      234         message
      235           vss-workfile vss-revision vss-description skip
      236           "Ошибка задания входных параметров" skip
      237           substitute("В процедуре &1 не найдена внутренняя процедура userobjs_append"
      238                     ,p-callback-handle :file-name
      239                     ) skip
      240           view-as alert-box error .
      241         undo, return error return-value .
      242       end.
      243       for each buf_userobjs_temp-user-obj
      244       on error undo, return error return-value
      245       :
      246         run userobjs_append in p-callback-handle
      247           (input  buf_userobjs_temp-user-obj.obj-type
      248           ,input  buf_userobjs_temp-user-obj.obj-code
      249           ) .
      250       end.
      251     end.
      252   end procedure.
      253   procedure userobjs_select-one :
      254      define input  parameter parparentproc     as widget-handle no-undo .
      255      define input  parameter p-db-num          as integer   no-undo .
      256      define input  parameter p-user-id         as character no-undo .
      257      define input  parameter p-host-code-obj   as integer   no-undo .
      258      define input  parameter p-obj-type        as character no-undo .
      259      define input  parameter p-obj-code        as integer   no-undo .
      260      define output parameter p-user-select     as logical   no-undo .
      261      define output parameter p-select-obj-type as character no-undo .
      262      define output parameter p-select-obj-code as character no-undo .
      263     do
      264     on error undo, return error return-value
      265     :
      266       run gbl/userobjs.w
      267         (input  parparentproc
      268         ,input  this-procedure :handle
      269         ,input  p-db-num
      270         ,input  p-user-id
      271         ,input  p-host-code-obj
      272         ,input  p-obj-type
      273         ,input  p-obj-code
      274         ,INPUT  "b-sel"
      275         ,output p-user-select
      276         ,output p-select-obj-type
      277         ,output p-select-obj-code
      278         ) .
      279     end.
      280   end.
      281   procedure userobjs_select-many :
      282     define input  parameter parparentproc   as widget-handle no-undo .
      283     define input  parameter p-db-num        as integer   no-undo .
      284     define input  parameter p-user-id       as character no-undo .
      285     define input  parameter p-host-code-obj as integer   no-undo .
      286     define input  parameter p-obj-type      as character no-undo .
      287     define input  parameter p-obj-code      as integer   no-undo .
      288     define output parameter p-user-select   as logical   no-undo .
      289     define variable v-select-obj-type as character no-undo .
      290     define variable v-select-obj-code as integer   no-undo .
      291     do
      292     on error undo, return error return-value
      293     :
      294       run gbl/userobjs.w
      295         (input  parparentproc
      296         ,input  this-procedure :handle
      297         ,input  p-db-num
      298         ,input  p-user-id
      299         ,input  p-host-code-obj
      300         ,input  p-obj-type
      301         ,input  p-obj-code
      302         ,INPUT  "b-sel,b-mark"
      303         ,output p-user-select
      304         ,output v-select-obj-type
      305         ,output v-select-obj-code
      306         ) .
      307     end.
      308   end.
      309   procedure thobjs :
      310      define input        parameter parparentproc     as widget-handle no-undo .
      311      define input        parameter i-bttns           as character     no-undo .
      312      define input        parameter i-list-mode       as character     no-undo.
      313      define input        parameter i-obj-type        as character     no-undo.
      314      define input        parameter i-db-num          as integer       no-undo.
      315      define input        parameter i-host-code       as integer       no-undo.
      316      define input-output parameter p-rid-list        as character     no-undo .
      317   run ref/thobjs.p
      318           ( input parparentproc
      319            ,input  this-procedure :handle
      320           , input i-bttns
      321           , input i-list-mode
      322           , input i-obj-type
      323           , input i-db-num
      324           , input i-host-code
      325           , input-output p-rid-list ) no-error .
      326   end.
      327   define variable v-tab-order as character no-undo.
      328   define variable v-db-num LIKE ub.db.db-num no-undo.
      329   DEFINE BUTTON b-deliv-obj
      330        IMAGE-UP FILE "btn-down-arrow":U
      331        IMAGE-DOWN FILE "btn-down-arrow":U
      332        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      333        LABEL "Btn 1"
      334        SIZE 3 BY 1.
      335   DEFINE BUTTON B-deliv-type-subject
      336        IMAGE-UP FILE "btn-down-arrow":U
      337        IMAGE-DOWN FILE "btn-down-arrow":U
      338        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      339        LABEL "Btn 1"
      340        SIZE 3 BY 1.
      341   DEFINE BUTTON B-exit AUTO-GO
      342        LABEL "&Ввод"
      343        SIZE 10 BY 1
      344        BGCOLOR 8 .
      345   DEFINE BUTTON B-Help
      346        LABEL "Помо&щь"
      347        SIZE 10 BY 1
      348        BGCOLOR 8 .
      349   DEFINE BUTTON B-Hist
      350        LABEL "Ис&тория"
      351        SIZE 10 BY 1
      352        BGCOLOR 8 .
      353   DEFINE BUTTON b-quit AUTO-END-KEY
      354        LABEL "&Отмена"
      355        SIZE 10 BY 1
      356        BGCOLOR 8 .
      357   DEFINE VARIABLE f-deliv-obj-name AS CHARACTER FORMAT "X(256)":U
      358        VIEW-AS FILL-IN
      359        SIZE 42.5 BY 1 NO-UNDO.
      360   DEFINE VARIABLE F-deliv-subj-name AS CHARACTER FORMAT "X(50)"
      361        LABEL "Название субъекта доставки"
      362        VIEW-AS FILL-IN
      363        SIZE 63 BY 1 NO-UNDO.
      364   DEFINE VARIABLE F-deliv-type-name AS CHARACTER FORMAT "X(50)"
      365        LABEL "Название типа доставки"
      366        VIEW-AS FILL-IN
      367        SIZE 63 BY 1.
      368   DEFINE QUERY Dialog-Frame FOR
      369         tt-variant-delivery,
      370         tt-delivery-type-subject SCROLLING.
      371   DEFINE FRAME Dialog-Frame
      372        B-exit AT ROW 1 COL 1
      373        b-quit AT ROW 1 COL 11
      374        B-Hist AT ROW 1 COL 51
      375        B-Help AT ROW 1 COL 61
      376        tt-variant-delivery.deliv-type-code AT ROW 3 COL 27.5 COLON-ALIGNED
      377             LABEL "Внутр.код типа доставки"
      378             VIEW-AS FILL-IN
      379             SIZE 11 BY 1
      380        tt-variant-delivery.deliv-subj-code AT ROW 3 COL 66.5 COLON-ALIGNED
      381             LABEL "Вн.код субъекта доставки"
      382             VIEW-AS FILL-IN
      383             SIZE 11 BY 1
      384        B-deliv-type-subject AT ROW 3 COL 80
      385        F-deliv-type-name AT ROW 4.25 COL 27.5 COLON-ALIGNED
      386        F-deliv-subj-name AT ROW 5.5 COL 27.5 COLON-ALIGNED
      387        tt-variant-delivery.obj-type AT ROW 6.75 COL 27.5 COLON-ALIGNED
      388             LABEL "Объект доставки"
      389             VIEW-AS FILL-IN
      390             SIZE 6 BY 1
      391        tt-variant-delivery.obj-code AT ROW 6.75 COL 34 COLON-ALIGNED NO-LABEL
      392             VIEW-AS FILL-IN
      393             SIZE 10 BY 1
      394        b-deliv-obj AT ROW 6.75 COL 46.5
      395        f-deliv-obj-name AT ROW 6.75 COL 48 COLON-ALIGNED NO-LABEL
      396        tt-variant-delivery.term-delivery AT ROW 8 COL 27.5 COLON-ALIGNED
      397             LABEL "Срок доставки(дни)"
      398             VIEW-AS FILL-IN
      399             SIZE 17 BY 1
      400        tt-variant-delivery.des AT ROW 11.5 COL 1 NO-LABEL
      401             VIEW-AS EDITOR SCROLLBAR-VERTICAL
      402             SIZE 98 BY 3.75
      403        "Описание" VIEW-AS TEXT
      404             SIZE 16 BY 1 AT ROW 10 COL 1.5
      405        SPACE(81.74) SKIP(4.66)
      406       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      407            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      408            TITLE "Тип доставки от субъекта"
      409            DEFAULT-BUTTON B-exit CANCEL-BUTTON b-quit.
      410   ASSIGN
      411          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      412          FRAME Dialog-Frame:HIDDEN           = TRUE.
      413   ASSIGN
      414          F-deliv-subj-name:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      415   ASSIGN
      416          F-deliv-type-name:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      417   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      418   DO:
      419     APPLY "END-ERROR":U TO SELF.
      420   END.
      421   ON CHOOSE OF b-deliv-obj IN FRAME Dialog-Frame
      422   DO:
      423     define variable v-user-select as logical   no-undo .
      424     define variable v-host-code   as integer   no-undo .
      425     define variable v-obj-type    as character no-undo .
      426     define variable v-obj-code    as integer   no-undo .
      427   define variable vss-include-info2 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      428   if lookup(self :type
      429            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      430            ) = 0
      431   then do:
      432     message
      433       "$Workfile$"
      434       "Указанному интерфейсному элементу фокус не может быть передан" skip
      435       "Интерфейсный элемент" self :name  skip
      436       "Тип" self :type  skip
      437       "Процедура" this-procedure :file-name skip
      438       view-as alert-box .
      439   end.
      440   else do:
      441     apply "entry":u to self  .
      442     if focus :handle <> self :handle  then do:
      443       return no-apply .
      444     end.
      445   end.
      446   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      447   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      448     (input  p-curr-obj-type
      449     ,input  p-curr-obj-code
      450     ,output v-host-code
      451     )  .
      452   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      453   run userobjs_select-one in this-procedure
      454     (input  parparentproc
      455     ,input  v-cntxt-db-num
      456     ,input  v-cntxt-userid
      457     ,input  v-host-code
      458     ,input  p-curr-obj-type
      459     ,input  p-curr-obj-code
      460     ,output v-user-select
      461     ,output v-obj-type
      462     ,output v-obj-code
      463     )  .
      464     if v-user-select <> true
      465     then do:
      466         assign
      467         tt-variant-delivery.obj-type = "":U
      468         tt-variant-delivery.obj-code = 0
      469         f-deliv-obj-name = "":U
      470         .
      471     end.
      472     else do:
      473       find first x_clients no-lock
      474         where x_clients.obj-type = v-obj-type
      475           and x_clients.obj-code = v-obj-code
      476         .
      477       assign
      478         tt-variant-delivery.obj-type = v-obj-type
      479         tt-variant-delivery.obj-code = v-obj-code
      480         f-deliv-obj-name             = x_clients.obj-name
      481       .
      482     end.
      483     display
      484       tt-variant-delivery.obj-type = v-obj-type
      485       tt-variant-delivery.obj-code = v-obj-code
      486       f-deliv-obj-name             = X_clients.obj-name
      487       with frame Dialog-Frame .
      488   END.
      489   ON CHOOSE OF B-deliv-type-subject IN FRAME Dialog-Frame
      490   DO:
      491     define variable v-rid-list as character no-undo.
      492     define variable v-sts as integer no-undo .
      493   define variable vss-include-info5 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      494   if lookup(self :type
      495            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      496            ) = 0
      497   then do:
      498     message
      499       "$Workfile$"
      500       "Указанному интерфейсному элементу фокус не может быть передан" skip
      501       "Интерфейсный элемент" self :name  skip
      502       "Тип" self :type  skip
      503       "Процедура" this-procedure :file-name skip
      504       view-as alert-box .
      505   end.
      506   else do:
      507     apply "entry":u to self  .
      508     if focus :handle <> self :handle  then do:
      509       return no-apply .
      510     end.
      511   end.
      512   if available locked_delivery-type-subject then
      513   assign
      514   v-rid-list = string(recid(locked_delivery-type-subject))
      515   v-sts = locked_delivery-type-subject.sts
      516   .
      517   run ref/dlvtysus.w (input parParentProc
      518                 , p-curr-obj-type
      519                 , p-curr-obj-code
      520                 , "b-sel":U
      521                 , 'все':U
      522                 , 0
      523                 , 0
      524                 , input-output v-sts
      525                 , input-output v-rid-list ) no-error .
      526   if v-rid-list <> "":U then do:
      527       FIND FIRST LOCKED_delivery-type-subject WHERE
      528           recid( LOCKED_delivery-type-subject ) = integer(entry(1, v-rid-list)) NO-LOCK .
      529       if available LOCKED_delivery-type-subject then do:
      530         find first X_delivery-type no-lock where
      531                   X_delivery-type.deliv-type-code = locked_delivery-type-subject.deliv-type-code no-error .
      532         find first X_delivery-subject no-lock where
      533                   X_delivery-subject.deliv-subj-code = locked_delivery-type-subject.deliv-subj-code no-error .
      534         if available X_delivery-type
      535         and available X_delivery-subject
      536         then do:
      537           assign
      538           tt-variant-delivery.deliv-type-code = locked_delivery-type-subject.deliv-type-code
      539           tt-variant-delivery.deliv-subj-code = locked_delivery-type-subject.deliv-subj-code
      540           f-deliv-type-name = X_delivery-type.deliv-type-name
      541           f-deliv-subj-name = X_delivery-subject.deliv-subj-name
      542           .
      543        end.
      544        else do:
      545         assign
      546         tt-variant-delivery.deliv-type-code = ?
      547         tt-variant-delivery.deliv-subj-code = ?
      548         f-deliv-type-name = "":U
      549         f-deliv-subj-name = "":U
      550         .
      551        end.
      552      end.
      553      else do:
      554       assign
      555       tt-variant-delivery.deliv-type-code = ?
      556       tt-variant-delivery.deliv-subj-code = ?
      557       f-deliv-type-name = "":U
      558       f-deliv-subj-name = "":U
      559       .
      560      end.
      561     display
      562     tt-variant-delivery.deliv-type-code
      563     tt-variant-delivery.deliv-subj-code
      564     f-deliv-type-name
      565     f-deliv-subj-name
      566     with frame Dialog-Frame .
      567   end.
      568   END.
      569   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
      570   DO:
      571       run proc-save in this-procedure no-error.
      572     if error-status:error then return no-apply.
      573   END.
      574   ON CHOOSE OF B-Hist IN FRAME Dialog-Frame
      575   DO:
      576     define variable v-rid-list as character no-undo.
      577       run ref/varcdlvs.w
      578                   (
      579                    input parParentProc
      580                   ,INPUT p-curr-obj-type
      581                   ,INPUT p-curr-obj-code
      582                   ,input "":U
      583                   ,input "one":U
      584                   ,input locked_variant-delivery.deliv-type-code
      585                   ,input locked_variant-delivery.deliv-subj-code
      586                   ,input locked_variant-delivery.obj-type
      587                   ,input locked_variant-delivery.obj-code
      588                   ,input-output v-rid-list
      589                                 )
      590    .
      591   END.
      592   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      593   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      594   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      595   on help of frame Dialog-Frame
      596   do:
      597     run gbl/app_help.p
      598       (input this-procedure :file-name
      599       ,input ''
      600       ,input ?
      601       ) no-error.
      602     if error-status :error then do:
      603       message
      604         "Ошибка при вызове помощи"
      605         error-status :get-message(1)
      606         view-as alert-box .
      607     end.
      608   end.
      609   run minbtn-set in this-procedure .
      610   on choose of b-help in frame Dialog-Frame
      611   do:
      612     apply "help":u to frame Dialog-Frame .
      613   end.
      614   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      615   procedure minbtn-set :
      616       do
      617           on error undo, return error return-value
      618           :
      619           define variable ii              as integer       no-undo .
      620           define variable fh              as widget-handle no-undo .
      621           define variable hh              as widget-handle no-undo .
      622           define variable v-h             as handle        extent 4 no-undo .
      623           define variable v-name-button   as character     no-undo .
      624           define variable v-help-old-x    as decimal       no-undo .
      625           define variable v-help-old-y    as decimal       no-undo .
      626           define variable v-help-old-size as decimal       no-undo .
      627           define variable v-frame-width   as decimal       no-undo .
      628           define variable jj              as integer       no-undo .
      629           do
      630               on error undo, return error
      631               :
      632               assign
      633                   v-frame-width = frame Dialog-Frame:width - 0.3
      634                   fh            = frame Dialog-Frame:first-child
      635                   hh            = fh:first-child
      636                   ii            = 1
      637                   .
      638               do while valid-handle(hh):
      639                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      640                   do:
      641                       case lc(hh:name) :
      642                           when "b-help" then
      643                               do:
      644                                   hh:load-image-up("cmp/b-help.bmp":u) .
      645                                   hh:load-image-down("cmp/b-help.bmp":u) .
      646                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      647                                   hh:TOOLTIP = "Помощь" .
      648                                   v-help-old-x = hh:column .
      649                                   v-help-old-y = hh:row    .
      650                                   v-help-old-size = hh:width .
      651                                   hh:width-chars = 2.5 .
      652                               end.
      653                           when "b-print" then
      654                               do:
      655                                   hh:load-image("cmp/b-print.bmp":u) .
      656                                   hh:TOOLTIP = "Печать" .
      657                                   v-h[ii] = hh:handle .
      658                                   ii = ii + 1 .
      659                                   hh:width-chars = 3 .
      660                               end.
      661                           when "b-history" or
      662                           when "b-hist" then
      663                               do:
      664                                   hh:load-image("cmp/b-hist.bmp":u) .
      665                                   hh:TOOLTIP = "История" .
      666                                   v-h[ii] = hh:handle .
      667                                   ii = ii + 1 .
      668                                   hh:width-chars = 3 .
      669                               end.
      670                           when "b-sch" then
      671                               do:
      672                                   hh:load-image("cmp/b-sch.bmp":u) .
      673                                   hh:TOOLTIP = "Установка Фильтра" .
      674                                   v-h[ii] = hh:handle .
      675                                   ii = ii + 1 .
      676                                   hh:width-chars = 3 .
      677                               end.
      678                           when "b-hist-user" then
      679                               do:
      680                                   hh:load-image("cmp/b-hist.bmp":u) .
      681                                   hh:TOOLTIP = "История пользователя" .
      682                                   ii = ii + 1 .
      683                               end.
      684                       end case.
      685                   end.
      686                   hh = hh:next-sibling.
      687               end.
      688               b-help:column = v-frame-width - b-help:width-chars.
      689               jj = 0.
      690               repeat ii = 4 to 1 by -1 :
      691                   if valid-handle (v-h[ii] ) then
      692                   do:
      693                       jj  = jj + 1 .
      694                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      695                       v-h[ii]:row    = v-help-old-y .
      696                   end.
      697               end.
      698           end.
      699       end.
      700   end procedure.
      701   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      702   ON TAB ANYWHERE
      703   DO:
      704   define variable ii as integer no-undo .
      705   define variable fh as widget-handle no-undo .
      706   define variable hh as widget-handle no-undo .
      707   define variable v-next-widget-name as character no-undo .
      708   if v-tab-order <> '' then do:
      709     if self:type = "TOGGLE-BOX" then
      710     self:BGCOLOR = ?.
      711     assign
      712     ii = lookup(self:name, v-tab-order).
      713     assign
      714     ii = ii + 1
      715     v-next-widget-name = entry(ii, v-tab-order)
      716     no-error .
      717     if error-status:error then do:
      718       assign
      719       ii = 1
      720       v-next-widget-name = entry( ii, v-tab-order)
      721       .
      722     end.
      723     assign
      724     fh = frame Dialog-Frame:first-child
      725     hh = fh:first-child
      726     .
      727     do while valid-handle(hh):
      728       if hh:name = v-next-widget-name then do:
      729         if hh:sensitive  = yes
      730         AND hh:visible = yes then do:
      731           APPLY "ENTRY" to hh.
      732           return no-apply.
      733         end.
      734         else do:
      735           APPLY "TAB" to hh.
      736           return no-apply.
      737         end.
      738       end.
      739       hh = hh:next-sibling.
      740     end.
      741   end.
      742   END.
      743   ON BACK-TAB ANYWHERE
      744   DO:
      745   define variable ii as integer no-undo .
      746   define variable fh as widget-handle no-undo .
      747   define variable hh as widget-handle no-undo .
      748   define variable v-next-widget-name as character no-undo .
      749   if v-tab-order <> '' then do:
      750     assign
      751     ii = lookup(self:name, v-tab-order).
      752     .
      753     assign
      754     ii = (if ii = 1
      755           then  num-entries(v-tab-order)
      756           else ii - 1
      757           )
      758     v-next-widget-name = entry(ii, v-tab-order)
      759     .
      760     assign
      761     fh = frame Dialog-Frame:first-child
      762     hh = fh:first-child
      763     .
      764     do while valid-handle(hh):
      765       if hh:name = v-next-widget-name then do:
      766         if hh:sensitive  = yes
      767         AND hh:visible = yes then do:
      768           APPLY "ENTRY" to hh.
      769           return no-apply.
      770         end.
      771         else do:
      772         APPLY "BACK-TAB" to hh.
      773         return no-apply.
      774         end.
      775       end.
      776       hh = hh:next-sibling.
      777     end.
      778     end.
      779   END.
      780   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      781   ON RETURN ANYWHERE
      782   DO:
      783   define variable ii as integer no-undo .
      784   define variable fh as widget-handle no-undo .
      785   define variable hh as widget-handle no-undo .
      786   define variable v-next-widget-name as character no-undo .
      787     if v-tab-order <> '' then do:
      788       assign
      789       ii = lookup(self:name, v-tab-order).
      790       if ii = num-entries(v-tab-order) then do:
      791           APPLY 'CHOOSE' TO b-exit in frame Dialog-Frame.
      792           return no-apply.
      793       end.
      794       if self:type <> "BUTTON" and
      795         self:type <> "EDITOR"  then do:
      796         run proc-move-forward in this-procedure .
      797         return no-apply.
      798       end.
      799       if self:type = "BUTTON" then do:
      800         APPLY "CHOOSE" to self.
      801       end.
      802       if self:type = "TOGGLE-BOX" then
      803       self:BGCOLOR = ?.
      804       assign
      805       ii = ii + 1
      806       v-next-widget-name = entry(ii, v-tab-order)
      807       no-error .
      808       if error-status:error then do:
      809         assign
      810         ii = 1
      811         v-next-widget-name = entry( ii, v-tab-order)
      812         .
      813       end.
      814       assign
      815       fh = frame Dialog-Frame:first-child
      816       hh = fh:first-child
      817       .
      818       do while valid-handle(hh):
      819         if hh:name = v-next-widget-name then do:
      820           if hh:sensitive  = yes
      821           AND hh:visible = yes then do:
      822             if hh:type = "TOGGLE-BOX":U then do:
      823               assign
      824               hh:BGcolor = 1
      825               .
      826             end.
      827             APPLY "ENTRY" to hh.
      828             return no-apply.
      829           end.
      830           else do:
      831             APPLY "TAB" to hh.
      832             return no-apply.
      833           end.
      834         end.
      835         hh = hh:next-sibling.
      836       end.
      837     end.
      838   END.
      839   procedure proc-move-forward :
      840   define variable ii as integer no-undo .
      841   define variable fh as widget-handle no-undo .
      842   define variable hh as widget-handle no-undo .
      843   define variable v-next-widget-name as character no-undo .
      844   do
      845   on error undo, return error
      846   :
      847     if v-tab-order <> '' then do:
      848       if self:type = "TOGGLE-BOX" then
      849       self:BGCOLOR = ?.
      850       assign
      851       ii = lookup(self:name, v-tab-order).
      852       assign
      853       ii = ii + 1
      854       v-next-widget-name = entry(ii, v-tab-order)
      855       no-error .
      856       if error-status:error then do:
      857         assign
      858         ii = 1
      859         v-next-widget-name = entry( ii, v-tab-order)
      860         .
      861       end.
      862       assign
      863       fh = frame Dialog-Frame:first-child
      864       hh = fh:first-child
      865       .
      866       do while valid-handle(hh):
      867         if hh:name = v-next-widget-name then do:
      868           if hh:sensitive  = yes
      869           AND hh:visible = yes then do:
      870             if hh:type = "TOGGLE-BOX":U then do:
      871               assign
      872               hh:BGcolor = 1
      873               .
      874             end.
      875             APPLY "ENTRY" to hh.
      876             return.
      877           end.
      878           else do:
      879             assign
      880             ii = ii + 1
      881             v-next-widget-name = entry(ii, v-tab-order)
      882             no-error .
      883             if error-status:error then do:
      884               assign
      885               ii = 1
      886               v-next-widget-name = entry( ii, v-tab-order)
      887               .
      888             end.
      889           end.
      890         end.
      891         hh = hh:next-sibling.
      892       end.
      893     end.
      894   end.
      895   end procedure.
      896   MAIN-BLOCK:
      897   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      898      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      899   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      900     run mainmenu_getcntxt in parparentproc
      901       (output v-cntxt-db-num
      902       ,output v-cntxt-userid
      903       ,output v-cntxt-level
      904       ,output v-cntxt-host-code-obj
      905       ,output v-cntxt-obj-type
      906       ,output v-cntxt-obj-code
      907       ,output v-cntxt-db-num-obj
      908       ,output v-cntxt-is-admin
      909       ) .
      910    if p-mode  <> 'ДОБАВЛЕНИЕ':U
      911    and p-mode <> 'ИЗМЕНЕНИЕ':U
      912    and p-mode <> 'ПРОСМОТР':U
      913    then do:
      914       message
      915       vss-workfile vss-revision vss-description skip
      916       "Неверное значение параметров вызова p-mode"  p-mode
      917       view-as alert-box ERROR.
      918       undo, return error.
      919    end.
      920      find first X_curr_clients no-lock where
      921               X_curr_clients.obj-type = p-curr-obj-type
      922          AND X_curr_clients.obj-code = p-curr-obj-code no-error.
      923     if not available X_curr_clients then do:
      924       message
      925       vss-workfile vss-revision vss-description skip
      926       "Неверное значение параметра вызова p-curr-obj-type p-curr-obj-code"
      927       p-curr-obj-type p-curr-obj-code
      928       view-as alert-box ERROR.
      929       return error .
      930     end.
      931   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      932   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
      933     (output v-db-num
      934     )  .
      935   IF v-db-num <> 0
      936   AND (p-mode = 'ДОБАВЛЕНИЕ':U
      937        OR p-mode = 'ИЗМЕНЕНИЕ':U ) THEN DO:
      938       message
      939       vss-workfile vss-revision vss-description skip
      940       "Неверное значение параметра вызова p-mode" p-mode skip
      941       "Нельзя редактировать запись ВАРИАНТ ДОСТАВКИ в УБД"
      942       view-as alert-box ERROR.
      943       return error .
      944   END.
      945     for each tt-delivery-type-subject:
      946       delete tt-delivery-type-subject.
      947     end.
      948     for each tt-variant-delivery:
      949       delete tt-variant-delivery.
      950     end.
      951   IF p-deliv-type-code <> 0  OR p-mode <> 'ДОБАВЛЕНИЕ':U THEN DO:
      952       IF p-mode = 'ДОБАВЛЕНИЕ':U OR p-mode = 'ИЗМЕНЕНИЕ':U  THEN DO:
      953         FIND FIRST LOCKED_delivery-type-subject EXCLUSIVE-LOCK WHERE
      954                   LOCKED_delivery-type-subject.deliv-type-code = p-deliv-type-code
      955               AND LOCKED_delivery-type-subject.deliv-subj-code = p-deliv-subj-code  NO-ERROR.
      956       END.
      957       IF p-mode = 'ПРОСМОТР':U THEN DO:
      958           FIND FIRST LOCKED_delivery-type-subject no-lock WHERE
      959                     LOCKED_delivery-type-subject.deliv-type-code = p-deliv-type-code
      960                 AND LOCKED_delivery-type-subject.deliv-subj-code = p-deliv-subj-code  NO-ERROR.
      961      END.
      962      IF (p-mode = 'ДОБАВЛЕНИЕ':U
      963       OR p-mode = 'ИЗМЕНЕНИЕ':U )
      964       AND NOT AVAILABLE LOCKED_delivery-type-subject  THEN DO:
      965           IF LOCKED(LOCKED_delivery-type-subject) THEN DO:
      966               message
      967               vss-workfile vss-revision vss-description skip
      968                "Запись ТИП ДОСТАВКИ ОТ СУБЪЕКТА занята"
      969               view-as alert-box error .
      970               undo, return error.
      971           END.
      972      END.
      973       ELSE DO:
      974         IF NOT AVAILABLE LOCKED_delivery-type-subject THEN DO:
      975             message
      976             vss-workfile vss-revision vss-description skip
      977             "Неверное значение параметра вызова p-deliv-type-code и/или p-deliv-subj-code" p-deliv-type-code p-deliv-subj-code skip
      978             view-as alert-box ERROR.
      979             return error .
      980           END.
      981       END.
      982       CREATE tt-delivery-type-subject.
      983       BUFFER-COPY LOCKED_delivery-type-subject TO tt-delivery-type-subject.
      984   END.
      985   IF p-deliv-obj-type <> "":U
      986   or p-deliv-obj-code  <> 0
      987   OR p-mode <> 'ДОБАВЛЕНИЕ':U THEN DO:
      988       FIND FIRST X_clients NO-LOCK WHERE
      989               X_clients.obj-type = p-deliv-obj-type
      990          AND  X_clients.obj-code = p-deliv-obj-code NO-ERROR.
      991       IF NOT AVAILABLE X_clients  THEN DO:
      992           message
      993           vss-workfile vss-revision vss-description skip
      994           "Неверное значение параметра вызова p-deliv-obj-type и/или p-deliv-obj-code" p-deliv-obj-type p-deliv-obj-code skip
      995           view-as alert-box ERROR.
      996           return error .
      997       END.
      998   END.
      999   if p-mode = 'ИЗМЕНЕНИЕ':U
     1000   or p-mode = 'ПРОСМОТР':U
     1001   or p-deliv-type-code  <> 0 then do:
     1002       find first X_delivery-type no-lock where
     1003                 X_delivery-type.deliv-type-code = p-deliv-type-code no-error .
     1004       if not avail X_delivery-type then do:
     1005         message
     1006         vss-workfile vss-revision vss-description skip
     1007         "Неверное значение параметра вызова p-deliv-type-code" p-deliv-type-code skip
     1008         view-as alert-box ERROR.
     1009         return error .
     1010       end.
     1011   end.
     1012   if p-mode = 'ИЗМЕНЕНИЕ':U
     1013   or p-mode = 'ПРОСМОТР':U
     1014   or p-deliv-subj-code  <> 0 then do:
     1015       find first X_delivery-subject no-lock where
     1016                 X_delivery-subject.deliv-subj-code = p-deliv-subj-code no-error .
     1017       if not avail X_delivery-subject then do:
     1018         message
     1019         vss-workfile vss-revision vss-description skip
     1020         "Неверное значение параметра вызова p-deliv-subj-code" p-deliv-subj-code skip
     1021         view-as alert-box ERROR.
     1022         return error .
     1023       end.
     1024   end.
     1025   if p-mode = 'ИЗМЕНЕНИЕ':U
     1026   or p-mode = 'ПРОСМОТР':U  then do:
     1027       if p-mode = 'ИЗМЕНЕНИЕ':U then do:
     1028         find first locked_variant-delivery EXclusive-lock where
     1029                      recid(locked_variant-delivery) = p-doc-rec no-wait no-error.
     1030         if locked locked_variant-delivery then do:
     1031           message
     1032           vss-workfile vss-revision vss-description skip
     1033            "Запись ВАРИАНТ ДОСТАВКИ занята"
     1034           view-as alert-box error .
     1035           undo, return error.
     1036         end.
     1037       end.
     1038       else do:
     1039         find first locked_variant-delivery no-lock where
     1040                          recid(locked_variant-delivery) = p-doc-rec no-error .
     1041         if not avail locked_variant-delivery then do:
     1042           find first locked_variant-delivery no-lock where
     1043                      locked_variant-delivery.deliv-type-code = p-deliv-type-code no-error .
     1044         end.
     1045       end.
     1046       if not available locked_variant-delivery then do:
     1047         message
     1048         vss-workfile vss-revision vss-description skip
     1049         "Не найдена запись ВАРИАНТ ДОСТАВКИ ОТ СУБЪЕКТА"
     1050         view-as alert-box error .
     1051         undo, return error.
     1052       end.
     1053       create tt-variant-delivery.
     1054       buffer-copy locked_variant-delivery to tt-variant-delivery.
     1055      end.
     1056      else do:
     1057        create tt-variant-delivery.
     1058        assign
     1059        tt-variant-delivery.deliv-type-code = (IF p-mode = 'ДОБАВЛЕНИЕ':U AND p-deliv-type-code <> 0
     1060                                                    THEN p-deliv-type-code
     1061                                                    ELSE tt-variant-delivery.deliv-type-code)
     1062        tt-variant-delivery.deliv-subj-code = (IF p-mode = 'ДОБАВЛЕНИЕ':U AND p-deliv-subj-code <> 0
     1063                                                    THEN p-deliv-subj-code
     1064                                                    ELSE tt-variant-delivery.deliv-type-code)
     1065        tt-variant-delivery.obj-type        = (IF p-mode = 'ДОБАВЛЕНИЕ':U AND p-deliv-obj-type <> "":U
     1066                                                    THEN p-deliv-obj-type
     1067                                                    ELSE tt-variant-delivery.obj-type)
     1068        tt-variant-delivery.obj-code        = (IF p-mode = 'ДОБАВЛЕНИЕ':U AND p-deliv-obj-code <> 0
     1069                                                    THEN p-deliv-obj-code
     1070                                                    ELSE tt-variant-delivery.obj-code)
     1071       .
     1072      end.
     1073     RUN Myenable.
     1074     WAIT-FOR GO OF FRAME Dialog-Frame.
     1075   END.
     1076   RUN disable_UI.
     1077   PROCEDURE disable_UI :
     1078     HIDE FRAME Dialog-Frame.
     1079   END PROCEDURE.
     1080   PROCEDURE enable_UI :
     1081     OPEN QUERY Dialog-Frame FOR EACH tt-variant-delivery SHARE-LOCK,       EACH tt-delivery-type-subject WHERE TRUE  SHARE-LOCK.
     1082     GET FIRST Dialog-Frame.
     1083     DISPLAY F-deliv-type-name F-deliv-subj-name f-deliv-obj-name
     1084         WITH FRAME Dialog-Frame.
     1085     IF AVAILABLE tt-variant-delivery THEN
     1086       DISPLAY tt-variant-delivery.deliv-type-code
     1087             tt-variant-delivery.deliv-subj-code tt-variant-delivery.obj-type
     1088             tt-variant-delivery.obj-code tt-variant-delivery.term-delivery
     1089             tt-variant-delivery.des
     1090         WITH FRAME Dialog-Frame.
     1091     ENABLE B-exit b-quit B-Hist B-Help B-deliv-type-subject b-deliv-obj
     1092            f-deliv-obj-name tt-variant-delivery.term-delivery
     1093            tt-variant-delivery.des
     1094         WITH FRAME Dialog-Frame.
     1095     VIEW FRAME Dialog-Frame.
     1096   END PROCEDURE.
     1097   PROCEDURE MyENable :
     1098   case p-mode:
     1099     when 'ДОБАВЛЕНИЕ':U then do:
     1100       display
     1101       (IF tt-variant-delivery.deliv-type-code <> 0
     1102        THEN tt-variant-delivery.deliv-type-code
     1103        ELSE ?) @ tt-variant-delivery.deliv-type-code
     1104       (IF tt-variant-delivery.deliv-subj-code <> 0
     1105        THEN tt-variant-delivery.deliv-subj-code
     1106        ELSE ?) @ tt-variant-delivery.deliv-subj-code
     1107       (IF tt-variant-delivery.obj-type <> "":U
     1108        THEN tt-variant-delivery.obj-type
     1109        ELSE ?) @ tt-variant-delivery.obj-type
     1110       (IF tt-variant-delivery.obj-code <> 0
     1111        THEN tt-variant-delivery.obj-code
     1112        ELSE ?) @ tt-variant-delivery.obj-code
     1113       tt-variant-delivery.term-delivery
     1114       (if available X_clients
     1115       then X_clients.obj-name
     1116       else "":U) @ f-deliv-obj-name
     1117       WITH FRAME Dialog-Frame.
     1118     end.
     1119     otherwise do:
     1120       IF AVAILABLE tt-variant-delivery THEN
     1121       DISPLAY
     1122       tt-variant-delivery.deliv-type-code
     1123       tt-variant-delivery.deliv-subj-code
     1124       tt-variant-delivery.obj-type
     1125       tt-variant-delivery.obj-code
     1126       tt-variant-delivery.term-delivery
     1127       X_delivery-type.deliv-type-name @ f-deliv-type-name
     1128       X_delivery-subject.deliv-subj-name @ f-deliv-subj-name
     1129       tt-variant-delivery.des
     1130       WITH FRAME Dialog-Frame.
     1131     end.
     1132   END CASE.
     1133   if p-mode = 'ПРОСМОТР':U then do:
     1134   assign
     1135   b-quit:label = "&Выход"
     1136   .
     1137   hide
     1138   b-exit in frame Dialog-Frame.
     1139   end.
     1140   ENABLE
     1141   B-exit when p-mode <> 'ПРОСМОТР':U
     1142   b-quit
     1143   B-Hist when p-mode <> 'ДОБАВЛЕНИЕ':U
     1144   B-Help
     1145   tt-variant-delivery.des when p-mode <> 'ПРОСМОТР':U
     1146   tt-variant-delivery.term-delivery when p-mode <> 'ПРОСМОТР':U
     1147   b-deliv-type-subject when (p-mode = 'ДОБАВЛЕНИЕ':U and p-deliv-type-code = 0)
     1148   b-deliv-obj when (p-mode = 'ДОБАВЛЕНИЕ':U and p-deliv-obj-code = 0)
     1149   WITH FRAME Dialog-Frame.
     1150   VIEW FRAME Dialog-Frame.
     1151   END PROCEDURE.
     1152   PROCEDURE Proc-save :
     1153   if p-mode = 'ПРОСМОТР':U then do:
     1154       return error.
     1155   end.
     1156   if not available tt-variant-delivery then do:
     1157       create tt-variant-delivery.
     1158   end.
     1159   assign
     1160   frame Dialog-Frame
     1161   tt-variant-delivery.deliv-type-code
     1162   tt-variant-delivery.deliv-subj-code
     1163   tt-variant-delivery.term-delivery
     1164   tt-variant-delivery.des = tt-variant-delivery.des:SCREEN-VALUE
     1165   .
     1166    run ref/vardelv1.p (
     1167   input-output p-doc-rec
     1168   ,input p-mode
     1169   ,input tt-variant-delivery.deliv-type-code
     1170   ,input tt-variant-delivery.deliv-subj-code
     1171   ,input tt-variant-delivery.obj-type
     1172   ,input tt-variant-delivery.obj-code
     1173   ,input tt-variant-delivery.term-delivery
     1174   ,input tt-variant-delivery.des
     1175   )
     1176   no-error.
     1177   if error-status:error then do:
     1178   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1179   define variable fh as widget-handle no-undo .
     1180   define variable hh as widget-handle no-undo .
     1181   define variable rv as character no-undo .
     1182   assign
     1183   rv = entry(1, return-value , chr(4)).
     1184   if rv <> "":U then do:
     1185     assign
     1186     fh = frame Dialog-Frame:first-child
     1187     hh = fh:first-child
     1188     .
     1189     do while valid-handle(hh):
     1190       if hh:name = rv then do:
     1191         APPLY "ENTRY" to hh.
     1192         undo ,
     1193         return error.
     1194       end.
     1195       hh = hh:next-sibling.
     1196     end.
     1197   end.
     1198     undo, return error.
     1199   end.
     1200   END PROCEDURE.
