      124   define variable log-res as log no-undo.
      125   define variable rr as recid no-undo.
      126   define variable v-log as logical no-undo.
      127   define variable RowID-list as character no-undo.
      128   define variable v-ok as logical no-undo.
      129   define stream ListStream.
      130   define variable sort-column-name as character no-undo.
      131   define buffer buf_alc-supp-lic for ub.alc-supp-lic.
      132   define buffer br_clients for ub.clients.
      133   DEFINE BUTTON b-add
      134        LABEL "&Добавить":L
      135        SIZE 10 BY 1.
      136   DEFINE BUTTON b-del
      137        LABEL "&Удалить"
      138        SIZE 10 BY 1.
      139   DEFINE BUTTON b-exit AUTO-GO
      140        LABEL "&Выход ":L
      141        SIZE 10 BY 1.
      142   DEFINE BUTTON b-help
      143        LABEL "Помо&щь":L
      144        SIZE 10 BY 1.
      145   DEFINE BUTTON b-hist
      146        LABEL "Ис&тория"
      147        SIZE 10 BY 1.
      148   DEFINE BUTTON b-print
      149        LABEL "Пе&чать"
      150        SIZE 3 BY 1.05.
      151   DEFINE BUTTON b-upd
      152        LABEL "&Изменить":L
      153        SIZE 10 BY 1.
      154   DEFINE QUERY br-alc-supp-lic FOR
      155         buf_alc-supp-lic,
      156         br_clients SCROLLING.
      157   DEFINE BROWSE br-alc-supp-lic
      158     QUERY br-alc-supp-lic NO-LOCK DISPLAY
      159         br_clients.obj-name COLUMN-LABEL "Поставщик" FORMAT "x(20)":U
      160         buf_alc-supp-lic.date-from COLUMN-LABEL "c" FORMAT "99/99/9999":U
      161         buf_alc-supp-lic.date-to COLUMN-LABEL "по" FORMAT "99/99/9999":U
      162         buf_alc-supp-lic.number FORMAT "x(16)":U
      163         buf_alc-supp-lic.seria FORMAT "x(16)":U
      164         buf_alc-supp-lic.date-get FORMAT "99/99/9999":U
      165         buf_alc-supp-lic.who-are-got FORMAT "x(30)":U
      166         IF buf_alc-supp-lic.all-type > 0 then "+" ELSE "-" column-label "На все типы"
      167       WITH SEPARATORS SIZE 83.38 BY 18.46
      168            BGCOLOR 15 FGCOLOR 0 .
      169   DEFINE FRAME f-alc-supp-lic
      170        b-exit AT ROW 1 COL 1
      171        b-print AT ROW 1 COL 33 WIDGET-ID 2
      172        b-hist AT ROW 1 COL 36
      173        b-help AT ROW 1 COL 46
      174        b-add AT ROW 2 COL 1
      175        b-upd AT ROW 2 COL 11
      176        b-del AT ROW 2 COL 21
      177        br-alc-supp-lic AT ROW 3.25 COL 1.63
      178        SPACE(0.18) SKIP(0.28)
      179       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      180            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      181            TITLE "Лицензии на поставку алкогольной продкуции":L.
      182   ASSIGN
      183          FRAME f-alc-supp-lic:SCROLLABLE       = FALSE.
      184   ASSIGN
      185          br-alc-supp-lic:NUM-LOCKED-COLUMNS IN FRAME f-alc-supp-lic     = 3.
      186   ON CHOOSE OF b-add IN FRAME f-alc-supp-lic
      187   DO:
      188    assign
      189      rr = ?
      190    .
      191    run ref/licsuppi.w ( parParentProc , 'ДОБАВЛЕНИЕ':U, input-output rr ).
      192    if rr <> ? then
      193       do:
      194           run refresh-query in this-procedure.
      195           reposition br-alc-supp-lic to recid rr.
      196           log-res  = br-alc-supp-lic:select-focused-row( ).
      197       end.
      198   END.
      199   ON CHOOSE OF b-del IN FRAME f-alc-supp-lic
      200   DO:
      201   define variable g-log as logical   no-undo .
      202   define variable v-recid as integer no-undo .
      203   define variable ii as integer no-undo .
      204   define buffer del_alc-supp-lic for ub.alc-supp-lic.
      205   if available buf_alc-supp-lic then do:
      206      message substitute("Удалить лицензию серия &1 №&2 ?", buf_alc-supp-lic.seria, buf_alc-supp-lic.number)
      207               view-as alert-box question
      208               buttons yes-no
      209               update g-log.
      210               if g-log = false then return no-apply.
      211      do transaction
      212         :
      213         find first del_alc-supp-lic
      214            where recid(del_alc-supp-lic)  = recid(buf_alc-supp-lic)
      215            exclusive-lock no-error .
      216         if available del_alc-supp-lic then do:
      217            delete del_alc-supp-lic.
      218         end.
      219      end.
      220   end.
      221   run refresh-query in this-procedure.
      222   END.
      223   ON CHOOSE OF b-hist IN FRAME f-alc-supp-lic
      224   DO:
      225      if available buf_alc-supp-lic THEN do:
      226         run ref/licsupph.w
      227         ( input parParentProc ,
      228           input buf_alc-supp-lic.alc-supp-lic-code,
      229           input buf_alc-supp-lic.create-user-db-num
      230           ).
      231      end.
      232   END.
      233   ON CHOOSE OF b-print IN FRAME f-alc-supp-lic
      234   DO:
      235       run ref/p-licsu.p(input parparentproc, input p-cli-type, input p-cli-code).
      236   END.
      237   ON CHOOSE OF b-upd IN FRAME f-alc-supp-lic
      238   DO:
      239      if not available buf_alc-supp-lic
      240      then do:
      241         return no-apply.
      242      end.
      243      rr = recid( buf_alc-supp-lic ).
      244      run ref/licsuppi.w ( parParentProc
      245                        , 'ИЗМЕНЕНИЕ':U
      246                        , input-output rr
      247                        ) .
      248      run refresh-query in this-procedure.
      249      reposition br-alc-supp-lic to recid rr .
      250    END.
      251   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME f-alc-supp-lic:PARENT eq ?
      252   THEN FRAME f-alc-supp-lic:PARENT = ACTIVE-WINDOW.
      253   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      254     run mainmenu_getcntxt in parparentproc
      255       (output v-cntxt-db-num
      256       ,output v-cntxt-userid
      257       ,output v-cntxt-level
      258       ,output v-cntxt-host-code-obj
      259       ,output v-cntxt-obj-type
      260       ,output v-cntxt-obj-code
      261       ,output v-cntxt-db-num-obj
      262       ,output v-cntxt-is-admin
      263       ) .
      264   define variable vss-include-info2 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      265   do:
      266     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      267       (input  v-cntxt-db-num
      268       ,input  v-cntxt-userid
      269       ,input  0
      270       ,input  'actn_lic-supp-lookup':U
      271       ,input  'object':U
      272       ,input  0
      273       ,input  v-cntxt-obj-type
      274       ,input  v-cntxt-obj-code
      275       ,input  0
      276       ,input  0
      277       ,input  0
      278       ,input  TRUE
      279       ,output v-ok
      280       )  .
      281   end.
      282       IF NOT v-ok then do:
      283          return.
      284       end.
      285   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      286   on help of frame f-alc-supp-lic
      287   do:
      288     run gbl/app_help.p
      289       (input this-procedure :file-name
      290       ,input ''
      291       ,input ?
      292       ) no-error.
      293     if error-status :error then do:
      294       message
      295         "Ошибка при вызове помощи"
      296         error-status :get-message(1)
      297         view-as alert-box .
      298     end.
      299   end.
      300   run minbtn-set in this-procedure .
      301   on choose of b-help in frame f-alc-supp-lic
      302   do:
      303     apply "help":u to frame f-alc-supp-lic .
      304   end.
      305   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      306   procedure minbtn-set :
      307       do
      308           on error undo, return error return-value
      309           :
      310           define variable ii              as integer       no-undo .
      311           define variable fh              as widget-handle no-undo .
      312           define variable hh              as widget-handle no-undo .
      313           define variable v-h             as handle        extent 4 no-undo .
      314           define variable v-name-button   as character     no-undo .
      315           define variable v-help-old-x    as decimal       no-undo .
      316           define variable v-help-old-y    as decimal       no-undo .
      317           define variable v-help-old-size as decimal       no-undo .
      318           define variable v-frame-width   as decimal       no-undo .
      319           define variable jj              as integer       no-undo .
      320           do
      321               on error undo, return error
      322               :
      323               assign
      324                   v-frame-width = frame f-alc-supp-lic:width - 0.3
      325                   fh            = frame f-alc-supp-lic:first-child
      326                   hh            = fh:first-child
      327                   ii            = 1
      328                   .
      329               do while valid-handle(hh):
      330                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      331                   do:
      332                       case lc(hh:name) :
      333                           when "b-help" then
      334                               do:
      335                                   hh:load-image-up("cmp/b-help.bmp":u) .
      336                                   hh:load-image-down("cmp/b-help.bmp":u) .
      337                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      338                                   hh:TOOLTIP = "Помощь" .
      339                                   v-help-old-x = hh:column .
      340                                   v-help-old-y = hh:row    .
      341                                   v-help-old-size = hh:width .
      342                                   hh:width-chars = 2.5 .
      343                               end.
      344                           when "b-print" then
      345                               do:
      346                                   hh:load-image("cmp/b-print.bmp":u) .
      347                                   hh:TOOLTIP = "Печать" .
      348                                   v-h[ii] = hh:handle .
      349                                   ii = ii + 1 .
      350                                   hh:width-chars = 3 .
      351                               end.
      352                           when "b-history" or
      353                           when "b-hist" then
      354                               do:
      355                                   hh:load-image("cmp/b-hist.bmp":u) .
      356                                   hh:TOOLTIP = "История" .
      357                                   v-h[ii] = hh:handle .
      358                                   ii = ii + 1 .
      359                                   hh:width-chars = 3 .
      360                               end.
      361                           when "b-sch" then
      362                               do:
      363                                   hh:load-image("cmp/b-sch.bmp":u) .
      364                                   hh:TOOLTIP = "Установка Фильтра" .
      365                                   v-h[ii] = hh:handle .
      366                                   ii = ii + 1 .
      367                                   hh:width-chars = 3 .
      368                               end.
      369                           when "b-hist-user" then
      370                               do:
      371                                   hh:load-image("cmp/b-hist.bmp":u) .
      372                                   hh:TOOLTIP = "История пользователя" .
      373                                   ii = ii + 1 .
      374                               end.
      375                       end case.
      376                   end.
      377                   hh = hh:next-sibling.
      378               end.
      379               b-help:column = v-frame-width - b-help:width-chars.
      380               jj = 0.
      381               repeat ii = 4 to 1 by -1 :
      382                   if valid-handle (v-h[ii] ) then
      383                   do:
      384                       jj  = jj + 1 .
      385                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      386                       v-h[ii]:row    = v-help-old-y .
      387                   end.
      388               end.
      389           end.
      390       end.
      391   end procedure.
      392   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      393   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      394   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      395   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      396   define variable v-diasize-current-frame-width  as decimal   no-undo .
      397   define variable v-diasize-current-frame-height as decimal   no-undo .
      398   define variable v-diasize-change-size          as logical   no-undo .
      399   define variable v-diasize-resize-button        as handle    no-undo .
      400   define variable v-diasize-wndmax               as logical   no-undo .
      401   define variable v-diasize-wndstore             as logical   no-undo .
      402   define variable v-diasize-proc-name            as character no-undo .
      403   define variable v-diasize-browse-handle        as handle    no-undo .
      404   define variable v-diasize-browse-number        as integer   no-undo .
      405   define variable v-diasize-need-full-display    as logical   no-undo init false .
      406   define temp-table temp-diasize-handle no-undo
      407     field handle-value  as handle
      408     field save-position as decimal
      409     index xpk is primary unique handle-value
      410     .
      411   define temp-table temp-browse-handle no-undo
      412     field browse-type   as character
      413     field browse-number as integer
      414     field browse-handle as handle
      415     field original-size as decimal
      416     index xpk is primary unique browse-type browse-number
      417     index xie browse-type browse-handle
      418   .
      419   procedure diasize_change-height :
      420     define input  parameter p-change-value  as decimal   no-undo .
      421     define input  parameter p-move-resize   as logical   no-undo .
      422     define variable v-field-group-handle    as handle    no-undo .
      423     define variable v-object-handle         as handle    no-undo .
      424     define variable v-frame-height          as decimal   no-undo .
      425     define variable v-frame-virtual-height  as decimal   no-undo .
      426     define variable v-browse-height         as decimal   no-undo .
      427     define variable v-window-height         as decimal   no-undo .
      428     define variable v-window-virtual-height as decimal   no-undo .
      429     define variable v-change-sign           as integer   no-undo .
      430     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      431     define buffer buf_temp-browse-handle  for temp-browse-handle .
      432     if p-change-value > 0
      433     then do:
      434       if frame f-alc-supp-lic :height + p-change-value
      435           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      436       then do:
      437         assign
      438           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      439                           - (frame f-alc-supp-lic :height-chars)
      440         .
      441         if p-change-value <= 0
      442         then do:
      443           run diasize_position-resize-button in this-procedure .
      444           return .
      445         end.
      446       end.
      447     end.
      448     if p-change-value < 0
      449     then do:
      450       if frame f-alc-supp-lic :height + p-change-value < v-diasize-orig-frame-height
      451       then do:
      452         assign
      453           p-change-value = v-diasize-orig-frame-height
      454                          - (frame f-alc-supp-lic :height-chars)
      455         .
      456         if p-change-value >= 0
      457         then do:
      458           run diasize_position-resize-button in this-procedure .
      459           return .
      460         end.
      461       end.
      462     end.
      463     if p-change-value >= 0
      464     then do:
      465       assign
      466         v-change-sign = 1
      467       .
      468     end.
      469     else do:
      470       assign
      471         v-change-sign = -1
      472       .
      473     end.
      474     assign
      475       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      476     .
      477     if p-change-value = 0
      478     then do:
      479       run diasize_position-resize-button in this-procedure .
      480       return .
      481     end.
      482     move_block:
      483     do
      484     on error undo move_block, retry move_block
      485     :
      486       if retry
      487       then do:
      488         do
      489         on error undo move_block, leave move_block
      490         :
      491           if p-change-value > 0
      492           then do:
      493             for each buf_temp-diasize-handle
      494             on error undo, next
      495             :
      496               assign
      497                 v-object-handle = buf_temp-diasize-handle.handle-value
      498               .
      499               if v-object-handle <> v-diasize-resize-button
      500               then do:
      501                 assign
      502                   v-object-handle :row = buf_temp-diasize-handle.save-position
      503                 .
      504               end.
      505             end.
      506             assign
      507               v-diasize-browse-handle :height = v-browse-height
      508             .
      509             for each buf_temp-browse-handle
      510               where buf_temp-browse-handle.browse-type = 'height':u
      511             on error undo, next
      512             :
      513               assign
      514                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      515               .
      516             end.
      517             assign
      518               frame f-alc-supp-lic :height = v-frame-height
      519             .
      520             if frame f-alc-supp-lic :scrollable = true
      521             then do:
      522               assign
      523                 frame f-alc-supp-lic :virtual-height = v-frame-virtual-height
      524               .
      525             end.
      526             run diasize_position-resize-button in this-procedure .
      527           end.
      528           else do:
      529             if frame f-alc-supp-lic :scrollable = true
      530             then do:
      531               assign
      532                 frame f-alc-supp-lic :virtual-height = v-frame-virtual-height
      533               .
      534             end.
