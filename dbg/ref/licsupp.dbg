     1159       then do:
     1160         if connected("ub") = true
     1161         then do:
     1162           define variable v-cntxt-db-num        as integer   no-undo .
     1163           define variable v-cntxt-userid        as character no-undo .
     1164           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1165                                             , OUTPUT v-cntxt-userid
     1166                                             ) .
     1167           run gbl/wndsizew.p
     1168             (input  v-cntxt-db-num
     1169             ,input  v-cntxt-userid
     1170             ,input  v-diasize-proc-name
     1171             ,input  'width':u
     1172             ,input  string(frame f-alc-supp-lic :width - v-diasize-orig-frame-width)
     1173             ) .
     1174         end.
     1175       end.
     1176     end.
     1177     assign
     1178       v-diasize-change-size = false
     1179     .
     1180   end procedure.
     1181   procedure diasize_set-width :
     1182     define input  parameter p-new-width  as decimal   no-undo .
     1183     define input  parameter p-move-resize as logical   no-undo .
     1184     do
     1185     on error undo, return error return-value
     1186     :
     1187       run diasize_change-width in this-procedure
     1188         (input  (p-new-width - frame f-alc-supp-lic :width)
     1189         ,input  p-move-resize
     1190         ) .
     1191     end.
     1192   end procedure.
     1193   procedure diasize_position-resize-button :
     1194     do with frame f-alc-supp-lic
     1195     :
     1196       hide v-diasize-resize-button .
     1197       assign
     1198         v-diasize-resize-button :row = frame f-alc-supp-lic :height - v-diasize-resize-button :height
     1199                     - 1
     1200                     - (frame f-alc-supp-lic :border-bottom-pixels / session :pixels-per-row)
     1201         v-diasize-resize-button :col = frame f-alc-supp-lic :width - v-diasize-resize-button :width
     1202                     - 1
     1203                     - (frame f-alc-supp-lic :border-right-pixels / session :pixels-per-column)
     1204       .
     1205       view v-diasize-resize-button .
     1206     end.
     1207   end procedure.
     1208   on alt-right anywhere
     1209   do:
     1210     run diasize_change-width in this-procedure
     1211       (input 1
     1212       ,input true
     1213       ) .
     1214     return no-apply .
     1215   end.
     1216   on alt-left anywhere
     1217   do:
     1218     run diasize_change-width in this-procedure
     1219       (input -1
     1220       ,input true
     1221       ) .
     1222     return no-apply .
     1223   end.
     1224   on alt-down anywhere
     1225   do:
     1226     run diasize_change-height in this-procedure
     1227       (input 1
     1228       ,input true
     1229       ) .
     1230     return no-apply .
     1231   end.
     1232   on alt-up anywhere
     1233   do:
     1234     run diasize_change-height in this-procedure
     1235       (input -1
     1236       ,input true
     1237       ) .
     1238     return no-apply .
     1239   end.
     1240   on alt-enter of frame f-alc-supp-lic
     1241   do:
     1242     run diasize_maximize in this-procedure
     1243       (input  ?
     1244       ).
     1245     return no-apply .
     1246   end.
     1247   procedure diasize_end-move :
     1248     do
     1249     on error undo, return error return-value
     1250     :
     1251       define variable v-row-delta as decimal   no-undo .
     1252       define variable v-col-delta as decimal   no-undo .
     1253       define variable v-new-row as decimal   no-undo .
     1254       define variable v-new-col as decimal   no-undo .
     1255       assign
     1256         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1257         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1258       .
     1259       assign
     1260         v-row-delta = v-new-row - frame f-alc-supp-lic :height
     1261         v-col-delta = v-new-col - frame f-alc-supp-lic :width
     1262       .
     1263       run diasize_change-height in this-procedure
     1264         (input v-row-delta
     1265         ,input true
     1266         ) .
     1267       run diasize_change-width in this-procedure
     1268         (input v-col-delta
     1269         ,input true
     1270         ) .
     1271     end.
     1272   end procedure.
     1273   procedure diasize_maximize :
     1274     define input  parameter p-action as logical   no-undo .
     1275     do
     1276     on error undo, return error return-value
     1277     :
     1278       if p-action = ?
     1279       then do:
     1280         if v-diasize-need-maximize = true
     1281         then do:
     1282           assign
     1283             p-action = true
     1284           .
     1285         end.
     1286         else do:
     1287           assign
     1288             p-action = false
     1289           .
     1290         end.
     1291       end.
     1292       if p-action = true
     1293       then do:
     1294         run diasize_change-height in this-procedure
     1295           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1296               - frame f-alc-supp-lic :height-chars
     1297           ,input true
     1298           ) .
     1299         run diasize_change-width in this-procedure
     1300           (input session :width-chars
     1301               - frame f-alc-supp-lic :width-chars
     1302           ,input true
     1303           ) .
     1304         assign
     1305           v-diasize-need-maximize = false
     1306         .
     1307       end.
     1308       else do:
     1309         run diasize_change-width in this-procedure
     1310           (input v-diasize-orig-frame-width
     1311               - frame f-alc-supp-lic :width-chars
     1312           ,input true
     1313           ) .
     1314         run diasize_change-height in this-procedure
     1315           (input v-diasize-orig-frame-height
     1316               - frame f-alc-supp-lic :height-chars
     1317           ,input true
     1318           ) .
     1319         assign
     1320           v-diasize-need-maximize = true
     1321         .
     1322       end.
     1323     end.
     1324   end procedure.
     1325   procedure diasize_restore-orig-size :
     1326     do
     1327     on error undo, return error return-value
     1328     :
     1329       assign
     1330         v-diasize-current-frame-width  = frame f-alc-supp-lic :width
     1331         v-diasize-current-frame-height = frame f-alc-supp-lic :height
     1332       .
     1333       run diasize_set-height in this-procedure
     1334         (input  v-diasize-orig-frame-height
     1335         ,input  true
     1336         ) .
     1337       run diasize_set-width in this-procedure
     1338         (input  v-diasize-orig-frame-width
     1339         ,input  true
     1340         ) .
     1341     end.
     1342   end procedure.
     1343   procedure diasize_restore-current-size :
     1344     do
     1345     on error undo, return error return-value
     1346     :
     1347       run diasize_set-height in this-procedure
     1348         (input  v-diasize-current-frame-height
     1349         ,input  true
     1350         ) .
     1351       run diasize_set-width in this-procedure
     1352         (input  v-diasize-current-frame-width
     1353         ,input  true
     1354         ) .
     1355     end.
     1356   end procedure.
     1357   procedure diasize_set-browse-handle :
     1358     define input  parameter p-browse-handle as handle   no-undo .
     1359     define buffer buf_temp-browse-handle for temp-browse-handle .
     1360     do
     1361     on error undo, return error return-value
     1362     :
     1363       assign
     1364         v-diasize-browse-handle = p-browse-handle
     1365       .
     1366       for each buf_temp-browse-handle
     1367       on error undo, return error return-value
     1368       :
     1369         delete buf_temp-browse-handle .
     1370       end.
     1371     end.
     1372   end procedure.
     1373   procedure diasize_add_browse :
     1374     define input  parameter p-browse-type   as character no-undo .
     1375     define input  parameter p-browse-handle as handle    no-undo .
     1376     define buffer buf_temp-browse-handle for temp-browse-handle .
     1377     do
     1378     on error undo, return error return-value
     1379     :
     1380       assign
     1381         v-diasize-browse-number = v-diasize-browse-number + 1
     1382       .
     1383       create buf_temp-browse-handle .
     1384       assign
     1385         buf_temp-browse-handle.browse-type   = p-browse-type
     1386         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1387         buf_temp-browse-handle.browse-handle = p-browse-handle
     1388       .
     1389     end.
     1390   end procedure.
     1391   procedure diasize_init :
     1392     define variable v-default-value    as logical   no-undo .
     1393     define variable v-restore-saved    as logical   no-undo .
     1394     define variable v-resize-value-str as character no-undo .
     1395     do
     1396     on error undo, return error return-value
     1397     :
     1398       do with frame f-alc-supp-lic
     1399       :
     1400         assign
     1401           v-diasize-orig-frame-height = frame f-alc-supp-lic :height
     1402           v-diasize-orig-frame-width  = frame f-alc-supp-lic :width
     1403           v-diasize-browse-handle     = browse br-alc-supp-lic :handle
     1404         .
     1405         create button v-diasize-resize-button
     1406         assign
     1407           parent        = frame f-alc-supp-lic :first-child
     1408           label         = "s"
     1409           height-pixels = 16
     1410           width-pixels  = 16
     1411           visible       = true
     1412           sensitive     = true
     1413           movable       = true
     1414           triggers:
     1415             on end-move persistent run diasize_end-move in this-procedure .
     1416           end triggers.
     1417         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1418         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1419         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1420         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1421         assign
     1422           v-diasize-wndmax = false
     1423         .
     1424         if connected("ub") = true
     1425         then do:
     1426           define variable v-cntxt-db-num        as integer   no-undo .
     1427           define variable v-cntxt-userid        as character no-undo .
     1428           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1429                                             , OUTPUT v-cntxt-userid
     1430                                             ) .
     1431           run gbl/wndpar_r.p
     1432             (input  v-cntxt-db-num
     1433             ,input  v-cntxt-userid
     1434             ,input  'wndmax':U
     1435             ,output v-diasize-wndmax
     1436             ,output v-default-value
     1437             ) .
     1438         end.
     1439         assign
     1440           v-diasize-wndstore = false
     1441         .
     1442         if connected("ub") = true
     1443         then do:
     1444           run gbl/wndpar_r.p
     1445             (input  v-cntxt-db-num
     1446             ,input  v-cntxt-userid
     1447             ,input  'wndstore':U
     1448             ,output v-diasize-wndstore
     1449             ,output v-default-value
     1450             ) .
     1451         end.
     1452         assign
     1453           v-diasize-proc-name = entry(1, program-name(2), '.')
     1454         .
     1455         if v-diasize-wndstore = true
     1456         then do:
     1457           assign
     1458             v-restore-saved = false
     1459           .
     1460           if connected("ub") = true
     1461           then do:
     1462             run gbl/wndsizer.p
     1463               (input  v-cntxt-db-num
     1464               ,input  v-cntxt-userid
     1465               ,input  v-diasize-proc-name
     1466               ,input  'height':u
     1467               ,output v-resize-value-str
     1468               ) .
     1469             if v-resize-value-str <> '':U
     1470             then do:
     1471               run diasize_change-height in this-procedure
     1472                 (input  integer(v-resize-value-str)
     1473                 ,input  true
     1474                 ) .
     1475               assign
     1476                 v-restore-saved = true
     1477               .
     1478             end.
     1479           end.
     1480           if connected("ub") = true
     1481           then do:
     1482             run gbl/wndsizer.p
     1483               (input  v-cntxt-db-num
     1484               ,input  v-cntxt-userid
     1485               ,input  v-diasize-proc-name
     1486               ,input  'width':u
     1487               ,output v-resize-value-str
     1488               ) .
     1489             if v-resize-value-str <> '':U
     1490             then do:
     1491               run diasize_change-width in this-procedure
     1492                 (input  integer(v-resize-value-str)
     1493                 ,input  true
     1494                 ) .
     1495               assign
     1496                 v-restore-saved = true
     1497               .
     1498             end.
     1499           end.
     1500           if v-restore-saved <> true
     1501           then do:
     1502             if v-diasize-wndmax = true
     1503             then do:
     1504               run diasize_maximize in this-procedure
     1505                 (input  true
     1506                 ) .
     1507             end.
     1508           end.
     1509         end.
     1510         else do:
     1511           if v-diasize-wndmax = true
     1512           then do:
     1513             run diasize_maximize in this-procedure
     1514               (input  true
     1515               ) .
     1516           end.
     1517         end.
     1518       end.
     1519     end.
     1520   end procedure.
     1521   procedure diasize_need-full-display :
     1522     define output parameter p-need-full-display as logical   no-undo .
     1523     do
     1524     on error undo, return error return-value
     1525     :
     1526       assign
     1527         p-need-full-display = v-diasize-need-full-display
     1528       .
     1529       assign
     1530         v-diasize-need-full-display = false
     1531       .
     1532     end.
     1533   end procedure.
     1534   procedure get-context :
     1535      define output parameter p-db-num as integer          no-undo.
     1536      define output parameter p-user-id as character        no-undo.
     1537      define variable v-login               as character    no-undo.
     1538      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1539      define buffer buf_user-login  for ub.user-login .
     1540      do
     1541      on error undo, return error
     1542      :
     1543            FIND FIRST buf_sys-ctrl no-lock.
     1544            ASSIGN
     1545               v-login = USERID("ub")
     1546               p-db-num = buf_sys-ctrl.db-num
     1547            .
     1548            FIND FIRST buf_user-login
     1549                 WHERE buf_user-login.db-num = p-db-num
     1550                   AND buf_user-login.user-login = v-login
     1551                 no-lock
     1552                 no-error
     1553                 .
     1554            IF AVAILABLE buf_user-login
     1555            THEN DO:
     1556               assign
     1557                  p-user-id = buf_user-login.user-id
     1558               .
     1559            END.
     1560      end.
     1561   end procedure.
     1562       run diasize_init in this-procedure .
     1563   ON WINDOW-CLOSE OF FRAME f-alc-supp-lic APPLY "END-ERROR":U TO SELF.
     1564   MAIN-BLOCK:
     1565   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1566      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1567       run enable_ui.
     1568       run post_enable_UI in this-procedure .
     1569       WAIT-FOR GO OF FRAME f-alc-supp-lic.
     1570   END.
     1571   run disable_ui.
     1572   PROCEDURE disable_UI :
     1573     HIDE FRAME f-alc-supp-lic.
     1574   END PROCEDURE.
     1575   PROCEDURE enable_UI :
     1576       ENABLE
     1577           br-alc-supp-lic
     1578           b-exit
     1579           b-add
     1580           b-upd
     1581           b-del
     1582           b-hist
     1583           b-help
     1584           b-print
     1585           WITH FRAME  f-alc-supp-lic.
     1586       if available buf_alc-supp-lic then
     1587           log-res  = br-alc-supp-lic:select-focused-row( ) in frame f-alc-supp-lic.
     1588        run refresh-query in this-procedure.
     1589   END PROCEDURE.
     1590   PROCEDURE post_enable_UI :
     1591   do
     1592   on error undo, return error
     1593   :
     1594   define variable vss-include-info6 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1595   do:
     1596     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1597       (input  v-cntxt-db-num
     1598       ,input  v-cntxt-userid
     1599       ,input  0
     1600       ,input  'actn_lic-supp-update':U
     1601       ,input  'object':U
     1602       ,input  0
     1603       ,input  v-cntxt-obj-type
     1604       ,input  v-cntxt-obj-code
     1605       ,input  0
     1606       ,input  0
     1607       ,input  0
     1608       ,input  false
     1609       ,output v-ok
     1610       )  .
     1611   end.
     1612       IF NOT v-ok then do:
     1613         DISABLE
     1614            b-add
     1615            b-upd
     1616            b-del
     1617         WITH FRAME  f-alc-supp-lic.
     1618       end.
     1619   end.
     1620   END PROCEDURE.
     1621   PROCEDURE refresh-query :
     1622   if p-cli-type = ?
     1623   or p-cli-code = ?
     1624   then do:
     1625    OPEN QUERY br-alc-supp-lic
     1626         FOR EACH buf_alc-supp-lic
     1627             NO-LOCK,
     1628             first br_clients
     1629             where br_clients.obj-type = buf_alc-supp-lic.cli-type
     1630               and br_clients.obj-code = buf_alc-supp-lic.cli-code
     1631             no-lock
     1632             .
     1633   end.
     1634   else do:
     1635    OPEN QUERY br-alc-supp-lic FOR
     1636             EACH buf_alc-supp-lic
     1637             WHERE buf_alc-supp-lic.cli-type = p-cli-type
     1638               AND buf_alc-supp-lic.cli-code = p-cli-code
     1639             NO-LOCK,
     1640             first br_clients
     1641             where br_clients.obj-type = p-cli-type
     1642               and br_clients.obj-code = p-cli-code
     1643             no-lock
     1644             .
     1645   end.
     1646   END PROCEDURE.
