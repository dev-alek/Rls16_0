      818     define buffer buf_temp-browse-handle  for temp-browse-handle .
      819     if p-change-value > 0
      820     then do:
      821       if frame f-alc-supp-lic :width + p-change-value >
      822           session :width-chars
      823       then do:
      824         assign
      825           p-change-value = session :width-chars - frame f-alc-supp-lic :width
      826         .
      827         if p-change-value <= 0
      828         then do:
      829           run diasize_position-resize-button in this-procedure .
      830           return .
      831         end.
      832       end.
      833     end.
      834     if p-change-value < 0
      835     then do:
      836       if frame f-alc-supp-lic :width + p-change-value < v-diasize-orig-frame-width
      837       then do:
      838         assign
      839           p-change-value = v-diasize-orig-frame-width
      840                          - frame f-alc-supp-lic :width
      841         .
      842         if p-change-value >= 0
      843         then do:
      844           run diasize_position-resize-button in this-procedure .
      845           return .
      846         end.
      847       end.
      848     end.
      849     if p-change-value >= 0
      850     then do:
      851       assign
      852         v-change-sign = 1
      853       .
      854     end.
      855     else do:
      856       assign
      857         v-change-sign = -1
      858       .
      859     end.
      860     assign
      861       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      862     .
      863     if p-change-value = 0
      864     then do:
      865       run diasize_position-resize-button in this-procedure .
      866       return .
      867     end.
