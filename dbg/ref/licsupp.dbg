      801         (input  (p-new-height - frame f-alc-supp-lic :height)
      802         ,input  p-move-resize
      803         ) .
      804     end.
      805   end procedure.
      806   procedure diasize_change-width :
      807     define input  parameter p-change-value as decimal   no-undo .
      808     define input  parameter p-move-resize  as logical   no-undo .
