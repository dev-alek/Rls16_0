        1   DEFINE NEW SHARED TEMP-TABLE tt0-rule-call-param NO-UNDO LIKE ub.rule-call-param.
        2   DEFINE NEW SHARED BUFFER X_dis-card-type FOR ub.dis-card-type.
        3   DEFINE BUFFER X_rp-by-call FOR ub.rp-by-call.
        4   DEFINE BUFFER X_rule-by-call FOR ub.rule-by-call.
        5   DEFINE BUFFER X_rule-profile FOR ub.rule-profile.
        6   define input parameter parparentproc as widget-handle no-undo .
        7   define input parameter p-mode as character no-undo .
        8   DEFINE INPUT PARAMETER BTTNS AS CHAR NO-UNDO.
        9   DEFINE INPUT PARAMETER paremitent-code like ub.sysconf.host-code no-undo.
       10   DEFINE INPUT PARAMETER parhost-code like ub.sysconf.host-code no-undo.
       11   DEFINE INPUT PARAMETER parobj-type like ub.clients.obj-type no-undo.
       12   DEFINE INPUT PARAMETER parobj-code like ub.clients.obj-code no-undo.
       13   DEFINE input-OUTPUT PARAMETER p-rid-list As char NO-UNDO.
       14   define variable vss-revision    as character no-undo init "$Revision$":u .
       15   define variable vss-author      as character no-undo init "$Author$":u .
       16   define variable vss-date        as character no-undo init "$Date$":u .
       17   define variable vss-workfile    as character no-undo init "$Workfile$":u .
       18   define variable vss-archive     as character no-undo init "$Archive$":u .
       19   define variable vss-description as character no-undo init "Справочник типов дисконтных карт " .
       20   procedure vss-get-info :
       21     define output parameter p-vss-revision    like vss-revision    no-undo .
       22     define output parameter p-vss-author      like vss-author      no-undo .
       23     define output parameter p-vss-date        like vss-date        no-undo .
       24     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       25     define output parameter p-vss-archive     like vss-archive     no-undo .
       26     define output parameter p-vss-description like vss-description no-undo .
       27     assign
       28       p-vss-revision    = vss-revision
       29       p-vss-author      = vss-author
       30       p-vss-date        = vss-date
       31       p-vss-workfile    = vss-workfile
       32       p-vss-archive     = vss-archive
       33       p-vss-description = vss-description
       34     .
       35   end procedure.
       36   procedure vss-get-parameters :
       37     define output parameter p-vss-parameters as character no-undo .
       38   end procedure.
       39   define new global shared variable g#vssrevis-logger as handle    no-undo .
       40   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       41   define variable v-vssrevis-logger                   as handle    no-undo .
       42   procedure vss-logevent :
       43     define input  parameter p-extra-paramters as character no-undo .
       44     define variable v-vssrevis-parameters as character no-undo .
       45     do
       46     on error undo, return error return-value
       47     :
       48       if  valid-handle(v-vssrevis-logger)
       49       and v-vssrevis-logger :get-signature("logevent") <> ""
       50       then do:
       51         run vss-get-parameters in this-procedure
       52           (output v-vssrevis-parameters
       53           ).
       54         run logevent in v-vssrevis-logger
       55           (input vss-workfile
       56           ,input vss-revision
       57           ,input v-vssrevis-parameters
       58           ,input p-extra-paramters
       59           ).
       60       end.
       61     end.
       62   end procedure.
       63   assign
       64     v-vssrevis-logger = g#vssrevis-logger
       65   .
       66   if  valid-handle(v-vssrevis-logger)
       67   and v-vssrevis-logger :get-signature("logevent") <> ""
       68   then do:
       69     assign
       70       v-vssrevis-logevent = true
       71     .
       72     run vss-logevent in this-procedure (input vss-description) .
       73   end.
       74   define new global shared variable g#language as character no-undo .
       75   if g#language <> '' and g#language <> 'rus':U then do:
       76     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       77   end.
       78   define new global shared variable g#library  as handle no-undo .
       79   define new global shared variable g#library2 as handle no-undo .
       80   define   shared variable g#auto as logical no-undo.
       81   define   shared variable g#news as logical no-undo.
       82   define   shared variable g#oxml as logical no-undo.
       83   define   shared variable g#esys as logical no-undo.
       84   define   shared variable g#news-source-db as integer no-undo.
       85   define   shared variable g#esys-source-esys as integer no-undo.
       86   define   shared variable g#db-num as integer   no-undo .
       87   define   shared variable g#userid as character no-undo .
       88   define   shared variable g#passwd as character no-undo .
       89   procedure proc-alt-shift-f2:
       90     if not ibs.th.gbl.gbl-var:rcode
       91   then
       92     run gbl\inidebug.p .
       93   end.
       94   procedure proc-alt-shift-f3:
       95     run gbl/prvssinf.p
       96       ( input this-procedure
       97       ) .
       98   end.
       99   define variable v-inform-launched as logical no-undo initial false .
      100   procedure proc-alt-shift-f4:
      101     define variable v-action as character no-undo .
      102     if v-inform-launched = false then do:
      103       assign
      104         v-inform-launched = true
      105       .
      106       run gbl/d-inform.w
      107         (  input self
      108         ,  input this-procedure
      109         , output v-action
      110         ) no-error .
      111       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      112       assign
      113         v-inform-launched = false
      114       .
      115     end.
      116   end.
      117   procedure proc-alt-f1:
      118     run gbl/corrhelp.p
      119       (input this-procedure
      120       ) .
      121   end .
      122   on alt-shift-f2 anywhere do:
      123     run proc-alt-shift-f2.
      124   end.
      125   on alt-shift-f3 anywhere do:
      126     run proc-alt-shift-f3 in this-procedure .
      127   end.
      128   on alt-shift-f4 anywhere do:
      129     run proc-alt-shift-f4 in this-procedure.
      130   end.
      131   on alt-f1 anywhere do:
      132     run proc-alt-f1 in this-procedure .
      133   end.
      134   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      135     define variable v-cntxt-db-num        as integer   no-undo .
      136     define variable v-cntxt-userid        as character no-undo .
      137     define variable v-cntxt-level         as character no-undo .
      138     define variable v-cntxt-host-code-obj as integer   no-undo .
      139     define variable v-cntxt-obj-type      as character no-undo .
      140     define variable v-cntxt-obj-code      as integer   no-undo .
      141     define variable v-cntxt-db-num-obj    as integer   no-undo .
      142     define variable v-cntxt-is-admin      as logical   no-undo .
      143   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      144   def var vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      145   procedure gen-key-rec :
      146     define input  parameter p-tbl-name    as character no-undo.
      147     define input  parameter p-bh_tbl-name as handle    no-undo.
      148     define output parameter p-key-rec     as character no-undo.
      149     do
      150     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      151     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      152     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      153     :
      154       define variable fh               as handle    no-undo .
      155       define variable v-ok             as logical   no-undo .
      156       define variable v-inform         as character no-undo .
      157       define variable v-ind            as integer   no-undo .
      158       define variable v-idx-field-qnty as integer   no-undo .
      159       if p-tbl-name = ?
      160         or p-tbl-name = "":U
      161       then do:
      162         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info2 ).
      163       end.
      164       if not p-bh_tbl-name:available then do:
      165         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info2, p-tbl-name ).
      166       end.
      167       assign
      168         p-key-rec = p-tbl-name
      169         v-inform  = p-bh_tbl-name:index-information(1)
      170         v-ind     = 2
      171       .
      172       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      173       on error undo, return error
      174       :
      175         assign
      176           v-inform = p-bh_tbl-name:index-information( v-ind )
      177           v-ind    = v-ind + 1
      178         .
      179       end.
      180       if v-inform = ?
      181         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      182         or entry( 3, v-inform, ",":U ) <> "1":U
      183       then do:
      184         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info2, p-tbl-name ).
      185       end.
      186       else do:
      187         assign
      188           v-idx-field-qnty = num-entries( v-inform ) - 4
      189         .
      190         if v-idx-field-qnty < 2 then do:
      191           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info2, v-inform, p-tbl-name ).
      192         end.
      193         do v-ind = 1 to v-idx-field-qnty by 2
      194         on error undo, return error
      195         :
      196           assign
      197             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      198             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      199           .
      200         end.
      201       end.
      202       if p-key-rec = ? then do:
      203         assign
      204           p-key-rec = "":U
      205         .
      206         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info2, p-tbl-name ).
      207       end.
      208     end.
      209     return.
      210   end procedure.
      211   procedure gen-where-keyr-tab :
      212     define input  parameter i-tableSerach as character no-undo.
      213     define input  parameter i-tablekey   as character  no-undo.
      214     define input  parameter p-key-rec    as character  no-undo.
      215     define input  parameter p-key-handle as handle     no-undo .
      216     define input  parameter p-db-name    as character  no-undo .
      217     define input  parameter p-tt-handle  as handle     no-undo .
      218     define output parameter o-Where      as character  no-undo.
      219     do
      220     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      221     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      222     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      223     :
      224       define variable v-full-tbl-name  as character no-undo .
      225       define variable bh_tbl-name      as handle    no-undo .
      226       define variable fh_key           as handle    no-undo .
      227       define variable fh_search        as handle    no-undo .
      228       define variable v-field-num      as integer   no-undo .
      229       define variable v-count-fld      as integer   no-undo .
      230       define variable v-inform         as character no-undo .
      231       define variable v-ind            as integer   no-undo .
      232       define variable v-idx-field-qnty as integer   no-undo .
      233       define variable v-field-name     as character no-undo .
      234       define variable v-field-val      as character no-undo .
      235       define variable v-word-link      as character no-undo .
      236       define variable vTable           as character no-undo.
      237       define variable bh_tbl-key       as handle    no-undo .
      238       assign
      239         p-key-rec = trim( p-key-rec )
      240       .
      241       if p-key-handle <> ? then do:
      242         if not valid-handle(p-key-handle)
      243            or p-key-handle:type <> "buffer"
      244         then do:
      245           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info2 ).
      246         end.
      247         if num-entries( p-key-rec, chr(3) ) > 1
      248           or p-key-rec = ?
      249           or p-key-rec = "":U
      250         then do:
      251           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info2, p-key-rec ).
      252         end.
      253       end.
      254       else do:
      255         if p-key-rec = ?
      256           or p-key-rec = "":U
      257         then do:
      258           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info2 ).
      259         end.
      260       end.
      261       assign
      262         vTable = entry( 1 , p-key-rec, chr(3) )
      263       .
      264       if p-tt-handle <> ?
      265         and ( not valid-handle(p-tt-handle)
      266               or p-tt-handle:type <> "buffer"
      267             )
      268       then do:
      269         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info2, vTable, chr(10) ).
      270       end.
      271       if p-tt-handle = ? then do:
      272         assign
      273           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      274         .
      275         create buffer bh_tbl-name for table v-full-tbl-name .
      276       end.
      277       else do:
      278         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      279       end.
      280       assign
      281         v-inform = bh_tbl-name:index-information(1)
      282         v-ind    = 2
      283       .
      284       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      285       on error undo, return error
      286       :
      287         assign
      288           v-inform = bh_tbl-name:index-information( v-ind )
      289           v-ind    = v-ind + 1
      290         .
      291       end.
      292       if v-inform = ?
      293         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      294         or entry( 3, v-inform, ",":U ) <> "1":U
      295       then do:
      296         delete object bh_tbl-name no-error.
      297         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info2, vTable ).
      298       end.
      299       assign
      300         v-idx-field-qnty = num-entries( v-inform ) - 4
      301       .
      302       if v-idx-field-qnty < 2 then do:
      303         delete object bh_tbl-name no-error.
      304         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info2, v-inform, vTable ).
      305       end.
      306       assign
      307         o-where     = "where":U
      308         v-word-link = "":U
      309         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      310         v-count-fld = 0
      311       .
      312       if i-tablekey ne "" and i-tablekey ne ?
      313       then do:
      314         assign
      315           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      316         .
      317         create buffer bh_tbl-key for table v-full-tbl-name .
      318       end.
      319       if i-tableSerach ne "" and i-tableSerach ne ?
      320       then do:
      321         delete object bh_tbl-name no-error.
      322         assign
      323           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      324         .
      325         create buffer bh_tbl-name for table v-full-tbl-name .
      326       end.
      327       block_where:
      328       do v-ind = 1 to v-idx-field-qnty by 2
      329       on error undo, return error
      330       :
      331         assign
      332           v-count-fld = v-count-fld + 1
      333         .
      334         if p-key-handle = ?
      335           and v-count-fld > v-field-num
      336         then do:
      337           leave block_where.
      338         end.
      339         define variable VfieldKeyTable as handle no-undo.
      340         assign
      341           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      342           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      343         .
      344         if     bh_tbl-key ne ?
      345         then do:
      346            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      347            if VfieldKeyTable eq ?
      348            then next block_where.
      349         end.
      350         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      351         then
      352            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      353         else
      354            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      355         if p-key-handle = ? then do:
      356           assign
      357             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      358           .
      359         end.
      360         else do:
      361           assign
      362             fh_key = p-key-handle:buffer-field( v-field-name )
      363           .
      364           if fh_key = ?
      365             or not valid-handle( fh_key )
      366           then do:
      367             delete object bh_tbl-name.
      368             if     bh_tbl-key ne ?
      369             then
      370                delete object bh_tbl-key.
      371             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info2, p-key-handle:name, v-field-name ).
      372           end.
      373           assign
      374             v-field-val = fh_key:buffer-value
      375           .
      376         end.
      377         if fh_search:data-type ="character":U then do:
      378           assign
      379             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      380             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      381             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      382             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      383             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      384             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      385             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      386             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      387             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      388             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      389             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      390             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      391             v-field-val = substitute( '"&1"', v-field-val )
      392           .
      393         end.
      394         assign
      395           o-where = substitute( "&1 &2", o-where, v-field-val )
      396         .
      397         if v-word-link = "":U then do:
      398           assign
      399             v-word-link = "and":U
      400           .
      401         end.
      402       end.
      403       delete object bh_tbl-name.
      404       if     bh_tbl-key ne ?
      405       then
      406          delete object bh_tbl-key.
      407       if p-key-handle = ?
      408         and v-count-fld <> v-field-num
      409       then do:
      410         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info2, vTable ).
      411       end.
      412     end.
      413   end procedure.
      414   procedure gen-hn-keyr-tab :
      415     define input  parameter i-tableSerach as character no-undo.
      416     define input  parameter i-tablekey   as character no-undo.
      417     define input  parameter p-key-rec    as character no-undo.
      418     define input  parameter p-key-handle as handle    no-undo .
      419     define input  parameter p-db-name    as character no-undo .
      420     define input  parameter p-tt-handle  as handle    no-undo .
      421     define input  parameter p-stts-lock  as integer   no-undo .
      422     define output parameter o-hn         as handle    no-undo.
      423     define variable v-full-tbl-name as character no-undo.
      424     define variable v-where         as character no-undo.
      425     define variable bh_tbl-name     as handle    no-undo.
      426     define variable vTable          as character no-undo.
      427     do
      428     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      429     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      430     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      431         run gen-where-keyr-tab(i-tableSerach,
      432                                i-tablekey,
      433                                p-key-rec,
      434                                p-key-handle,
      435                                p-db-name,
      436                                p-tt-handle,
      437                                output v-where).
      438         if i-tableSerach ne "" and i-tableSerach ne ?
      439         then do:
      440            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      441            create buffer bh_tbl-name for table v-full-tbl-name .
      442         end.
      443         else do:
      444            if p-tt-handle = ? then do:
      445               assign
      446                  vTable = entry( 1 , p-key-rec, chr(3) )
      447               .
      448               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      449               create buffer bh_tbl-name for table v-full-tbl-name .
      450            end.
      451            else do:
      452               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      453            end.
      454         end.
      455         if p-tt-handle = ? then do:
      456            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      457         end.
      458         else do:
      459            bh_tbl-name:find-first( v-where ) no-error .
      460         end.
      461         o-hn = bh_tbl-name.
      462      end.
      463   end procedure.
      464   procedure gen-hn-keyr :
      465     define input  parameter p-key-rec    as character no-undo.
      466     define input  parameter p-key-handle as handle    no-undo .
      467     define input  parameter p-db-name    as character no-undo .
      468     define input  parameter p-tt-handle  as handle    no-undo .
      469     define input  parameter p-stts-lock  as integer   no-undo .
      470     define output parameter o-hn         as handle    no-undo.
      471     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      472   end.
      473   procedure gen-row-keyr :
      474     define input  parameter p-key-rec    as character no-undo.
      475     define input  parameter p-key-handle as handle    no-undo .
      476     define input  parameter p-db-name    as character no-undo .
      477     define input  parameter p-tt-handle  as handle    no-undo .
      478     define input  parameter p-stts-lock  as integer   no-undo .
      479     define output parameter p-tbl-row    as rowid     no-undo.
      480     define output parameter p-tbl-name   as character no-undo.
      481     define variable vHn as handle no-undo.
      482       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      483       p-tbl-row = if vHn:available then vHn:rowid else ?.
      484       p-tbl-name =  vHn:table.
      485       delete object vHn no-error.
      486     if p-tbl-row = ? then do:
      487       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info2, p-tbl-name, p-key-rec ).
      488     end.
      489     else do:
      490       return.
      491     end.
      492   end procedure.
      493   procedure gen-key-fv :
      494     define input  parameter p-key-rec    as character no-undo .
      495     define output parameter p-field-list as character no-undo .
      496     define output parameter p-value-list as character no-undo.
      497     do
      498     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      499     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      500     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      501     :
      502       define variable v-full-tbl-name  as character no-undo .
      503       define variable bh_tbl-name      as handle    no-undo .
      504       define variable v-tbl-name       as character no-undo .
      505       define variable v-field-num      as integer   no-undo .
      506       define variable v-count-fld      as integer   no-undo .
      507       define variable v-inform         as character no-undo .
      508       define variable v-ind            as integer   no-undo .
      509       define variable v-idx-field-qnty as integer   no-undo .
      510       define variable v-delim-key      as character no-undo .
      511       if p-key-rec = ?
      512         or p-key-rec = "":U
      513       then do:
      514         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info2 ).
      515       end.
      516       assign
      517         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      518         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      519       .
      520       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      521       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info2 ).
      522       assign
      523         v-inform = bh_tbl-name:index-information(1)
      524         v-ind    = 2
      525       .
      526       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      527       on error undo, return error
      528       :
      529         assign
      530           v-inform = bh_tbl-name:index-information( v-ind )
      531           v-ind    = v-ind + 1
      532         .
      533       end.
      534       if v-inform = ?
      535         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      536         or entry( 3, v-inform, ",":U ) <> "1":U
      537       then do:
      538         delete object bh_tbl-name no-error.
      539         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info2, v-tbl-name ).
      540       end.
      541       assign
      542         v-idx-field-qnty = num-entries( v-inform ) - 4
      543       .
      544       if v-idx-field-qnty < 2 then do:
      545         delete object bh_tbl-name no-error.
      546         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info2, v-inform, v-tbl-name ).
      547       end.
      548       assign
      549         p-field-list = "":U
      550         p-value-list = "":U
      551         v-delim-key  = "":U
      552         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      553         v-count-fld  = 0
      554       .
      555       block_where:
      556       do v-ind = 1 to v-idx-field-qnty by 2
      557       on error undo, return error
      558       :
      559         assign
      560           v-count-fld = v-count-fld + 1
      561         .
      562         if v-count-fld > v-field-num then do:
      563           leave block_where.
      564         end.
      565         assign
      566           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      567           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      568         .
      569         if v-ind = 1 then do:
      570           assign
      571             v-delim-key = chr(3)
      572           .
      573         end.
      574       end.
      575       delete object bh_tbl-name.
      576       if v-count-fld <> v-field-num then do:
      577         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info2, v-tbl-name ).
      578       end.
      579     end.
      580   end procedure.
      581   procedure gen-key-field :
      582     define input  parameter p-table      as character no-undo .
      583     define output parameter p-field-list as character no-undo .
      584     do
      585     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      586     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      587     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      588     :
      589       define variable v-full-tbl-name  as character no-undo .
      590       define variable bh_tbl-name      as handle    no-undo .
      591       define variable v-tbl-name       as character no-undo .
      592       define variable v-field-num      as integer   no-undo .
      593       define variable v-count-fld      as integer   no-undo .
      594       define variable v-inform         as character no-undo .
      595       define variable v-ind            as integer   no-undo .
      596       define variable v-idx-field-qnty as integer   no-undo .
      597       define variable v-delim-key      as character no-undo .
      598       if p-table = ?
      599         or p-table = "":U
      600       then do:
      601         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info2 ).
      602       end.
      603       assign
      604         v-tbl-name      = p-table
      605         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      606       .
      607       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      608       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info2 ).
      609       assign
      610         v-inform = bh_tbl-name:index-information(1)
      611         v-ind    = 2
      612       .
      613       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      614       on error undo, return error
      615       :
      616         assign
      617           v-inform = bh_tbl-name:index-information( v-ind )
      618           v-ind    = v-ind + 1
      619         .
      620       end.
      621       if v-inform = ?
      622         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      623         or entry( 3, v-inform, ",":U ) <> "1":U
      624       then do:
      625         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info2, v-tbl-name ).
      626       end.
      627       assign
      628         v-idx-field-qnty = num-entries( v-inform ) - 4
      629       .
      630       if v-idx-field-qnty < 2 then do:
      631         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info2, v-inform, v-tbl-name ).
      632       end.
      633       assign
      634         p-field-list = "":U
      635         v-delim-key  = "":U
      636         v-count-fld  = 0
      637       .
      638       block_where:
      639       do v-ind = 1 to v-idx-field-qnty by 2
      640       on error undo, return error
      641       :
      642         assign
      643           v-count-fld = v-count-fld + 1
      644         .
      645         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      646         if v-ind = 1 then do:
      647           assign
      648             v-delim-key = chr(3)
      649           .
      650         end.
      651       end.
      652       delete object bh_tbl-name.
      653     end.
      654   end procedure.
      655   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      656   FUNCTION get-region RETURNS CHARACTER
      657     ( input parhost-code as integer, input parobj-type as character, input parobj-code as integer ) :
      658     define variable par-region as character no-undo.
      659     if parhost-code = 0 and
      660          parobj-type = "":U and
      661          parobj-code = 0 then do:
      662          par-region = "Глобально".
      663          return par-region.
      664       end.
      665       if parobj-type = 'орг':U then do:
      666          par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(parhost-code).
      667          return par-region.
      668       end.
      669       if parobj-type = 'регион':U
      670       then do:
      671          par-region = fill(chr(32), 2) + "Регион" + chr(32) + string(parobj-code).
      672          return par-region.
      673       end.
      674       par-region = fill(chr(32), 4) + parobj-type + chr(32) + string(parobj-code).
      675       return par-region.
      676   END FUNCTION.
      677   FUNCTION get-objregion RETURNS CHARACTER
      678     (  input parobj-type as character, input parobj-code as integer ) :
      679     define variable par-region as character no-undo.
      680     if  parobj-type = "":U and
      681         parobj-code = 0
      682     then do:
      683        par-region = "Глобально".
      684     end.
      685     else if parobj-type = 'орг':U
      686     then do:
      687        par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(parobj-code).
      688     end.
      689     else if parobj-type = 'регион':U
      690     then do:
      691        par-region = fill(chr(32), 2) + "Регион" + chr(32) + string(parobj-code).
      692     end.
      693     else
      694        par-region = fill(chr(32), 4) + parobj-type + chr(32) + string(parobj-code).
      695     return par-region.
      696   END FUNCTION.
      697   FUNCTION calldscr returns character ( input p-call-id as character):
      698   define variable v-descr as character no-undo .
      699   define variable v-field-list as character no-undo .
      700   define variable v-value-list as character no-undo.
      701   define variable v-prop-label as character no-undo .
      702   define variable v-node-label as character no-undo .
      703   define variable v-dt-code as integer no-undo .
      704   define variable v-host-code as integer no-undo .
      705   define variable v-obj-type as character no-undo .
      706   define variable v-obj-code as integer no-undo .
      707   define variable v-label as character no-undo .
      708   define variable v-node-code as integer no-undo .
      709   define buffer buf_prop-head for ub.prop-head.
      710   define buffer buf_prop-ref for ub.prop-ref.
      711   define buffer buf_prop-map for ub.prop-map.
      712   run gen-key-fv in this-procedure ( input p-call-id
      713                                     ,output v-field-list
      714                                     ,output v-value-list) no-error .
      715   if error-status:error then return p-call-id.
      716   CASE entry(1, p-call-id, chr(3)):
      717     when 'dis-card-type':U then do:
      718       v-descr = substitute("Тип ДК: эмитент &1 тип: &2"
      719                            ,integer(entry(lookup("emitent-host-code", v-field-list, chr(3)), v-value-list, chr(3)) )
      720                            ,entry(lookup("type", v-field-list, chr(3)), v-value-list, chr(3))
      721                            ).
      722     end.
      723     when 'dis-card':U then do:
      724       v-descr = substitute("ДК: № &1"
      725                            ,entry(lookup("d-card", v-field-list, chr(3)), v-value-list, chr(3))
      726                            ).
      727     end.
      728     when 'dis-card-property':U then do:
      729       v-dt-code = integer(entry(lookup("dt-code", v-field-list, chr(3)), v-value-list, chr(3)) ).
      730       v-node-code = integer(entry(lookup("node-code", v-field-list, chr(3)), v-value-list, chr(3)) ).
      731       v-host-code = integer(entry(lookup("host-code", v-field-list, chr(3)), v-value-list, chr(3)) ).
      732       v-obj-type = entry(lookup("obj-type", v-field-list, chr(3)), v-value-list, chr(3)) .
      733       v-obj-code = integer(entry(lookup("obj-code", v-field-list, chr(3)), v-value-list, chr(3)) ).
      734       find first buf_prop-ref no-lock where
      735                 buf_prop-ref.dt-code = v-dt-code no-error .
      736       if available buf_prop-ref then do:
      737         find first buf_prop-head no-lock where
      738                   buf_prop-head.dtm-code = buf_prop-ref.dtm-code no-error .
      739         v-prop-label = buf_prop-head.prop-label.
      740         find first buf_prop-map no-lock where
      741                   buf_prop-map.dtm-code = buf_prop-ref.dtm-code
      742               and buf_prop-map.node-code = v-node-code no-error .
      743         if available buf_prop-map then do:
      744           v-label = buf_prop-map.node-label.
      745         end.
      746       end.
      747       v-descr = substitute("ДК: № &1 &2:&3 &4"
      748                            ,entry(lookup("d-card", v-field-list, chr(3)), v-value-list, chr(3))
      749                            ,v-prop-label
      750                            ,v-label
      751                            ,get-region(v-host-code, v-obj-type, v-obj-code)
      752                            ).
      753     end.
      754     when 'clients':U then do:
      755       v-descr = substitute("&1&2"
      756                            ,entry(lookup("obj-type", v-field-list, chr(3)), v-value-list, chr(3))
      757                            ,integer(entry(lookup("obj-code", v-field-list, chr(3)), v-value-list, chr(3)) )
      758                            ).
      759     end.
      760     when 'ext-system':U then do:
      761       v-descr = substitute("Внешняя система &1"
      762                            ,integer(entry(lookup("esys-id", v-field-list, chr(3)), v-value-list, chr(3)))
      763                            ).
      764     end.
      765     WHEN 'thbj-attr':U then do:
      766       if entry(lookup("upper-prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'rum':U
      767       or entry(lookup("upper-prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'rum_obj':U
      768       then do:
      769         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'goods':U then do:
      770           v-descr = "Операции с товарами".
      771         end.
      772         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'clients':U then do:
      773           v-descr = "Операции с клиентами".
      774         end.
      775         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'gds-grp':U then do:
      776           v-descr = "Операции с группами товаров".
      777         end.
      778         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'cli-grp':U then do:
      779           v-descr = "Операции с группами клиентов".
      780         end.
      781         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'chk-doc_ibs-th':U then do:
      782           v-descr = "Операции с чеками на POS IBS-TH".
      783         end.
      784         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'chk-doc_ibs-th-mob':U then do:
      785           v-descr = "Операции с чеками на POS IBS-TH-MOB".
      786         end.
      787         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'edoc':U then do:
      788           v-descr = "Операции в системе электронного документооборота".
      789         end.
      790         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'thref':U then do:
      791           v-descr = "Операции со справочниками".
      792         end.
      793         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'pdf':U then do:
      794           v-descr = "Операции с ДНЦ и переоценками".
      795         end.
      796         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'rep':U then do:
      797           v-descr = "Отчеты".
      798         end.
      799         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'ord':U then do:
      800           v-descr = "Операции с заказами".
      801         end.
      802       end.
      803     end.
      804     when 'cash-desk':U then do:
      805       v-descr = substitute("БД &1 Маг &2 Касса № &4 &3"
      806                            ,entry(lookup("db-num", v-field-list, chr(3)), v-value-list, chr(3))
      807                            ,entry(lookup("obj-code", v-field-list, chr(3)), v-value-list, chr(3))
      808                            ,entry(lookup("cash-num", v-field-list, chr(3)), v-value-list, chr(3))
      809                            ,entry(lookup("pos-type", v-field-list, chr(3)), v-value-list, chr(3))
      810                            ).
      811     end.
      812     when 'ext-file':U then do:
      813       v-descr = substitute("БД &1 Файл № &3 (из БД &2)"
      814                            ,entry(lookup("db-num", v-field-list, chr(3)), v-value-list, chr(3))
      815                            ,entry(lookup("from-db-num", v-field-list, chr(3)), v-value-list, chr(3))
      816                            ,entry(lookup("file-num", v-field-list, chr(3)), v-value-list, chr(3))
      817                            ).
      818     end.
      819   end case.
      820   return v-descr.
      821   end function.
      822   def var vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      823   define variable ri as recid no-undo.
      824   define variable v-is-dc as character no-undo .
      825   define variable v-conf-type as character no-undo .
      826   define variable v-rid-list as character no-undo .
