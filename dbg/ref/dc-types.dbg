      903   DEFINE VARIABLE E-rule-name AS CHARACTER
      904        VIEW-AS EDITOR SCROLLBAR-VERTICAL
      905        SIZE 98 BY 2.17
      906        FGCOLOR 4  NO-UNDO.
      907   DEFINE VARIABLE mark-num AS INTEGER FORMAT ">>>9":U INITIAL 0
      908         VIEW-AS TEXT
      909        SIZE 9.88 BY 1 NO-UNDO.
      910   DEFINE VARIABLE Rs-algo-profile AS CHARACTER
      911        VIEW-AS RADIO-SET HORIZONTAL
      912        RADIO-BUTTONS
      913             "Item 1", "1",
      914   "Item 2", "2"
      915        SIZE 28 BY 1 NO-UNDO.
      916   DEFINE VARIABLE rs-algo-types AS INTEGER INITIAL 2
      917        VIEW-AS RADIO-SET HORIZONTAL
      918        RADIO-BUTTONS
      919             "Все", 1,
      920   "Определенные пользователем", 2
      921        SIZE 36 BY .75 NO-UNDO.
      922   DEFINE QUERY BR-dctype FOR
      923         x_dis-card-type SCROLLING.
      924   DEFINE QUERY br-profile FOR
      925         X_rp-by-call SCROLLING.
      926   DEFINE QUERY br-rule-by-call FOR
      927         X_rule-by-call,
      928         X_rule-profile SCROLLING.
      929   DEFINE BROWSE BR-dctype
      930     QUERY BR-dctype DISPLAY
      931         get-mark(recid(X_dis-card-type), v-rid-list) COLUMN-LABEL "*" FORMAT "X(1)":U
      932   X_dis-card-type.type COLUMN-LABEL "Тип" FORMAT "X(8)":U
      933   X_dis-card-type.emitent-host-code COLUMN-LABEL "Код!эмитента" FORMAT ">>>>99999":U
      934   get-emitent(X_dis-card-type.emitent-host-code) COLUMN-LABEL "Эмитент" FORMAT "X(15)":U
      935   get-dflt-dct-rule ( INPUT X_dis-card-type.emitent-host-code
      936                       ,INPUT X_dis-card-type.type
      937                       ,INPUT X_dis-card-type.host-code
      938                       ,INPUT X_dis-card-type.obj-type
      939                       ,INPUT X_dis-card-type.obj-code
      940                       ,INPUT 'def-pcnt':U)
      941    COLUMN-LABEL "%скидки!по умолч!на товар" FORMAT "X(7)":U
      942   X_dis-card-type.d-pcnt-byshop COLUMN-LABEL "Скидка!по!объ./фирм." FORMAT "+/":U
      943   X_dis-card-type.dflt-credit-card COLUMN-LABEL "Кре!дит!ная" FORMAT "+/":U
      944   X_dis-card-type.lim-kr FORMAT ">>>,>>>,>>>,>>9.99":U
      945   get-dflt-dct-rule ( INPUT X_dis-card-type.emitent-host-code
      946                     ,INPUT X_dis-card-type.type
      947                     ,INPUT X_dis-card-type.host-code
      948                     ,INPUT X_dis-card-type.obj-type
      949                     ,INPUT X_dis-card-type.obj-code
      950                     ,INPUT 'def-cash-pcnt':U)
      951   COLUMN-LABEL "%скидки!по умолч!на итог" FORMAT "X(7)":U
      952   get-dflt-dct-rule ( INPUT X_dis-card-type.emitent-host-code
      953                   ,INPUT X_dis-card-type.type
      954                   ,INPUT X_dis-card-type.host-code
      955                   ,INPUT X_dis-card-type.obj-type
      956                   ,INPUT X_dis-card-type.obj-code
      957                   ,input 'def-categ':U)
      958   COLUMN-LABEL "кате!гория!по умолч" FORMAT "X(4)":U
      959   entry (lookup (string(X_dis-card-type.dflt-d-pcnt-method), '1,2,3':U), 'Товар,Итог_чека,Товары_и_итог_чека':U) COLUMN-LABEL "Использ.скидки" FORMAT "X(12)":U
      960       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 9.
      961   DEFINE BROWSE br-profile
      962     QUERY br-profile NO-LOCK DISPLAY
      963         X_rp-by-call.profile_id COLUMN-LABEL "Про!файл" FORMAT ">>9"
      964   get-profile-name ( INPUT X_rp-by-call.profile_id) COLUMN-LABEL "Название" FORMAT "X(255)"
      965   get-profile-dynamic ( INPUT X_rp-by-call.profile_id) COLUMN-LABEL "Отклю!чаемый" FORMAT "+/":U
      966   X_rp-by-call.once-more COLUMN-LABEL "№!привязки" FORMAT ">9"
      967       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 7.88
      968            TITLE "Алгоритмы" ROW-HEIGHT-CHARS .67.
      969   DEFINE BROWSE br-rule-by-call
      970     QUERY br-rule-by-call NO-LOCK DISPLAY
      971         X_rule-by-call.can-calc COLUMN-LABEL "Включен?" FORMAT "+/":U
      972   X_rule-by-call.algo-des FORMAT "X(255)":U COLUMN-LABEL "Описание алгоритма/правила" WIDTH 56
      973   X_rule-by-call.is_dynamic COLUMN-LABEL "Отклю!чаемое" FORMAT "+/":U
      974   X_rule-by-call.codex_id COLUMN-LABEL "Кодекс!правил" FORMAT ">>>>>>9":U WIDTH 7
      975   X_rule-by-call.ruleset_id COLUMN-LABEL "Набор!правил" FORMAT ">>>>>>9":U width 7
      976   X_rule-by-call.order_id COLUMN-LABEL "Порядок!вызова" FORMAT ">>9":U WIDTH 9
      977   X_rule-by-call.rule_id COLUMN-LABEL "Код!правила" FORMAT ">>>>>>>>9":U WIDTH 9
      978   X_rule-by-call.profile_id COLUMN-LABEL "Алгоритм" FORMAT ">>9":U WIDTH 8
      979       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 7.88
      980            FONT 4
      981            TITLE "Правила" ROW-HEIGHT-CHARS .67.
      982   DEFINE FRAME Dialog-Frame
      983        B-exit AT ROW 1 COL 1.13
      984        B-mark AT ROW 1 COL 11
      985        B-sel AT ROW 1 COL 14
      986        B-add AT ROW 1 COL 24
      987        B-lookup AT ROW 1 COL 34
      988        B-chg AT ROW 1 COL 44
      989        B-del AT ROW 1 COL 54 WIDGET-ID 16
      990        b-prop-ref AT ROW 1 COL 64 WIDGET-ID 8
      991        b-disc AT ROW 1 COL 79 WIDGET-ID 10
      992        B-hist AT ROW 1 COL 92
      993        B-Help AT ROW 1 COL 95
      994        B-mask AT ROW 2 COL 64
      995        b-ruleproc AT ROW 2 COL 79 WIDGET-ID 14
      996        BR-dctype AT ROW 3.46 COL 1
      997        Rs-algo-profile AT ROW 12.5 COL 1.5 NO-LABEL WIDGET-ID 2
      998        rs-algo-types AT ROW 12.5 COL 29 NO-LABEL
      999        b-rule AT ROW 12.5 COL 65
     1000        b-params AT ROW 12.5 COL 75 WIDGET-ID 6
     1001        B-ruleset AT ROW 12.5 COL 85 WIDGET-ID 12
     1002        br-rule-by-call AT ROW 13.5 COL 1
     1003        br-profile AT ROW 13.5 COL 1 WIDGET-ID 100
     1004        E-rule-name AT ROW 21.5 COL 1 NO-LABEL
     1005        mark-num AT ROW 2.17 COL 2.88 NO-LABEL
     1006        SPACE(86.24) SKIP(20.50)
     1007       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1008            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1009            TITLE "Типы дисконтных карт"
     1010            DEFAULT-BUTTON B-exit.
     1011   ASSIGN
     1012          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1013          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1014   ASSIGN
     1015          b-rule:POPUP-MENU IN FRAME Dialog-Frame       = MENU MENU-b-rule:HANDLE.
     1016   ASSIGN
     1017          b-ruleproc:POPUP-MENU IN FRAME Dialog-Frame       = MENU menu-b-ruleproc:HANDLE.
     1018   ASSIGN
     1019          E-rule-name:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
     1020   ON GO OF FRAME Dialog-Frame
     1021   DO:
     1022     ASSIGN
     1023     p-rid-list = v-rid-list.
     1024   END.
     1025   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1026   DO:
     1027     APPLY "END-ERROR":U TO SELF.
     1028   END.
     1029   ON CHOOSE OF B-add IN FRAME Dialog-Frame
     1030   DO:
     1031   define variable glog as logical no-undo .
     1032   define variable vss-include-info5 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1033   do:
     1034     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1035       (input  v-cntxt-db-num
     1036       ,input  v-cntxt-userid
     1037       ,input  0
     1038       ,input  'actn_reference-dc-type_input-deletion-updating':U
     1039       ,input  'global':U
     1040       ,input  0
     1041       ,input  '':U
     1042       ,input  0
     1043       ,input  0
     1044       ,input  0
     1045       ,input  0
     1046       ,input  true
     1047       ,output glog
     1048       )  .
     1049   end.
     1050     if NOT glog then
     1051     return no-apply .
     1052     ri = ?.
     1053     run ref/dc-typei.w (  input parparentproc
     1054                       ,input 'ДОБАВЛЕНИЕ':U
     1055                       ,input parhost-code
     1056                       ,input parobj-type
     1057                       ,input parobj-code
     1058                       ,input-output ri ).
     1059     if ri <> ? then do:
     1060       run OpenBr in this-procedure .
     1061       reposition br-dctype to recid ri no-error.
     1062       apply "ENTRY" to br-dctype.
     1063       apply "VALUE-CHANGED" to br-dctype.
     1064     end.
     1065   END.
     1066   ON CHOOSE OF B-chg IN FRAME Dialog-Frame
     1067   DO:
     1068     define variable cur-ri as recid no-undo.
     1069     define variable glog as logical no-undo .
     1070   define variable vss-include-info6 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1071   do:
     1072     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1073       (input  v-cntxt-db-num
     1074       ,input  v-cntxt-userid
     1075       ,input  0
     1076       ,input  'actn_reference-dc-type_input-deletion-updating':U
     1077       ,input  'global':U
     1078       ,input  0
     1079       ,input  '':U
     1080       ,input  0
     1081       ,input  0
     1082       ,input  0
     1083       ,input  0
     1084       ,input  true
     1085       ,output glog
     1086       )  .
     1087   end.
     1088       if NOT glog then return no-apply .
     1089       If available X_dis-card-type then do:
     1090           cur-ri = recid( X_dis-card-type ).
     1091           ri = recid( X_dis-card-type ) .
     1092          run ref/dc-typei.w ( input parparentproc
     1093                           ,input 'ИЗМЕНЕНИЕ':U
     1094                          ,input parhost-code
     1095                          ,input parobj-type
     1096                          ,input parobj-code
     1097                          ,input-output ri ).
     1098           RUn openBr in this-procedure .
     1099           reposition br-dctype to recid cur-ri no-error.
     1100           apply "ENTRY" to br-dctype.
     1101           apply "VALUE-CHANGED" to br-dctype.
     1102       end.
     1103   END.
     1104   ON CHOOSE OF B-del IN FRAME Dialog-Frame
     1105   DO:
     1106     define variable cur-ri as recid no-undo.
     1107     define variable glog as logical no-undo .
     1108   define variable vss-include-info7 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1109   do:
     1110     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1111       (input  v-cntxt-db-num
     1112       ,input  v-cntxt-userid
     1113       ,input  0
     1114       ,input  'actn_reference-dc-type_input-deletion-updating':U
     1115       ,input  'global':U
     1116       ,input  0
     1117       ,input  '':U
     1118       ,input  0
     1119       ,input  0
     1120       ,input  0
     1121       ,input  0
     1122       ,input  true
     1123       ,output glog
     1124       )  .
     1125   end.
     1126   if NOT glog then return no-apply .
     1127   If available X_dis-card-type then do:
     1128       glog = NO.
     1129       MESSAGE
     1130       substitute("Вы действительно хотите удалить тип ДК &1 эмитент &3"
     1131                  , X_dis-card-type.TYPE
     1132                  , X_dis-card-type.emitent-host-code)
     1133       VIEW-AS ALERT-BOX QUESTION buttons YES-NO UPDATE glog.
     1134       IF NOT glog THEN UNDO, RETURN NO-APPLY.
     1135       cur-ri = recid(X_dis-card-type).
     1136       run ref/dctypei3.p ( INPUT NO
     1137                            ,INPUT cur-ri) NO-ERROR.
     1138       IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1139       RUn openBr in this-procedure .
     1140       reposition br-dctype to row 1 no-error.
     1141       apply "ENTRY" to br-dctype.
     1142       apply "VALUE-CHANGED" to br-dctype.
     1143   end.
     1144   END.
     1145   ON CHOOSE OF b-disc IN FRAME Dialog-Frame
     1146   DO:
     1147     DEFINE VARIABLE v-loc-rid-list AS CHARACTER NO-UNDO.
     1148     IF NOT AVAILABLE X_dis-card-type THEN RETURN NO-APPLY.
     1149           run ref/dis-dcts.w (
     1150                                INPUT parparentproc
     1151                               ,INPUT '':U
     1152                               ,INPUT 'dis-card-type':U
     1153                               ,input X_dis-card-type.emitent-host-code
     1154                               ,input X_dis-card-type.type
     1155                               ,input 0
     1156                               ,input '':U
     1157                               ,input 0
     1158                               ,input 0
     1159                               ,input '':U
     1160                               ,input '':U
     1161                               ,input 0
     1162                               ,input-output v-loc-rid-list ) no-error.
     1163   END.
     1164   ON CHOOSE OF B-hist IN FRAME Dialog-Frame
     1165   DO:
     1166   define variable v-ri-list AS CHARACTER NO-UNDO.
     1167     IF NOT AVAIL X_dis-card-type THEN RETURN NO-APPLY.
     1168     run ref/dcctypes.w ( input parparentproc
     1169                       , input '':U
     1170                       , input ?
     1171                       , input X_dis-card-type.emitent-host-code
     1172                       , input parhost-code
     1173                       , input parobj-type
     1174                       , input parobj-code
     1175                       , input X_dis-card-type.TYPE
     1176                       , input "one":U
     1177                       , input "subject"
     1178                       , output v-ri-list ) no-error .
     1179   END.
     1180   ON CHOOSE OF B-lookup IN FRAME Dialog-Frame
     1181   DO:
     1182    If available X_dis-card-type then do:
     1183      ri = recid( X_dis-card-type ) .
     1184      run ref/dc-typei.w ( input parparentproc
     1185                         , input 'ПРОСМОТР':U
     1186                         , input parhost-code
     1187                         , input parobj-type
     1188                         , input parobj-code
     1189                         , input-output ri ).
     1190      apply "ENTRY" to br-dctype.
     1191    end.
     1192   END.
     1193   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
     1194   DO:
     1195   DEFINE VARIABLE loc#log as logical no-undo.
     1196   if available X_dis-card-type then do:
     1197   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1198   define variable v-str-recid9 as character no-undo .
     1199   define variable v-num-entry9 as integer   no-undo .
     1200   assign
     1201     v-str-recid9 = trim( string( recid( X_dis-card-type ) , "->>>>>>>>>>>9":U ) )
     1202     v-num-entry9 = lookup( v-str-recid9 , v-rid-list )
     1203   .
     1204   if v-num-entry9 > 0 then do:
     1205     assign
     1206       entry( v-num-entry9, v-rid-list ) = "":U
     1207       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1208     .
     1209   end.
     1210   else do:
     1211     assign
     1212       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid9
     1213     .
     1214   end.
     1215     loc#log = br-dctype:refresh() .
     1216     if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
     1217         loc#log = br-dctype:select-next-row ().
     1218         apply "iteration-changed" to br-dctype in frame Dialog-Frame.
     1219     end.
     1220     if num-entries( v-rid-list ) = 0
     1221     then
     1222         hide mark-num in frame Dialog-Frame.
     1223     else
     1224         disp num-entries( v-rid-list ) @ mark-num with frame Dialog-Frame.
     1225   end.
     1226   apply "entry" to br-dctype in frame Dialog-Frame.
     1227   END.
     1228   ON CHOOSE OF B-mask IN FRAME Dialog-Frame
     1229   DO:
     1230   define variable v-rid-list AS CHARACTER NO-UNDO.
     1231   IF NOT AVAIL X_dis-card-type THEN RETURN NO-APPLY.
     1232     run ref/dc-masks.w (
     1233                       INPUT parparentproc
     1234                      ,INPUT parhost-code
     1235                      ,INPUT parobj-type
     1236                      ,INPUT parobj-code
     1237                      ,input "b-add":U
     1238                      ,INPUT "one":U
     1239                      ,INPUT X_dis-card-type.TYPE
     1240                      ,INPUT X_dis-card-type.emitent-host-code
     1241                      ,INPUT ?
     1242                      ,input-output v-rid-list
     1243                       ) NO-ERROR.
     1244   IF ERROR-STATUS:error  THEN RETURN NO-APPLY.
     1245   END.
     1246   ON CHOOSE OF b-params IN FRAME Dialog-Frame
     1247   DO:
     1248   DEFINE BUFFER buf_rule-call-param FOR ub.rule-call-param.
     1249   define buffer buf_rule-by-call for ub.rule-by-call.
     1250     CASE Rs-algo-profile:
     1251       when 'rule-by-call':U then do:
     1252         IF NOT AVAILABLE X_rule-by-call THEN RETURN NO-APPLY.
     1253         FOR EACH tt0-rule-call-param NO-LOCK:
     1254           DELETE tt0-rule-call-param.
     1255         END.
     1256         FOR EACH buf_rule-call-param NO-LOCK WHERE
     1257                 buf_rule-call-param.codex_id = X_rule-by-call.codex_id
     1258             AND buf_rule-call-param.ruleset_id = X_rule-by-call.ruleset_id
     1259             AND buf_rule-call-param.call_id = X_rule-by-call.call_id:
     1260             CREATE tt0-rule-call-param.
     1261             BUFFER-COPY buf_rule-call-param TO tt0-rule-call-param.
     1262         END.
     1263         run ref/rulercps.w (
     1264                                  input parparentproc
     1265                                 ,input this-procedure:handle
     1266                                 ,input '':U
     1267                                 ,input 'ПРОСМОТР':U
     1268                                 ,input 'rule-call-param':U
     1269                                 ,input 0
     1270                                 ,input ?
     1271                                 ,input X_rule-by-call.call_id
     1272                                 ,input X_rule-by-call.codex_id
     1273                                 ,input X_rule-by-call.ruleset_id
     1274                                 ,input X_rule-by-call.order_id
     1275                                 ,input X_rule-by-call.RULE_id
     1276                                 ,INput substitute("Правило &1", X_rule-by-call.RULE_id)
     1277                                 ,input-output table tt0-rule-call-param  ) no-error.
     1278         IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1279       end.
     1280       when 'rp-by-call':U then do:
     1281         IF NOT AVAILABLE X_rp-by-call THEN RETURN NO-APPLY.
     1282         FOR EACH tt0-rule-call-param NO-LOCK:
     1283           DELETE tt0-rule-call-param.
     1284         END.
     1285         for each buf_rule-by-call no-lock where
     1286               buf_rule-by-call.call_id = X_rp-by-call.call_id
     1287           and buf_rule-by-call.profile_id = X_rp-by-call.profile_id
     1288           and buf_rule-by-call.once-more = X_rp-by-call.once-more,
     1289            EACH buf_rule-call-param NO-LOCK WHERE
     1290                 buf_rule-call-param.call_id = buf_rule-by-call.call_id
     1291             AND buf_rule-call-param.codex_id = buf_rule-by-call.codex_id
     1292             AND buf_rule-call-param.ruleset_id = buf_rule-by-call.ruleset_id
     1293             AND buf_rule-call-param.order_id = buf_rule-by-call.order_id :
     1294             CREATE tt0-rule-call-param.
     1295             BUFFER-COPY buf_rule-call-param TO tt0-rule-call-param.
     1296         END.
     1297         define variable v-param-form as character no-undo .
     1298         define buffer buf_rule-profile for ub.rule-profile.
     1299         find first buf_rule-profile no-lock where
     1300                   buf_rule-profile.profile_id = X_rp-by-call.profile_id.
     1301         assign
     1302         v-param-form = (if buf_rule-profile.custom-param-form > 0
     1303                         then  substitute("rul/rcps-&1.w", buf_rule-profile.profile_id)
     1304                         else "ref/rulercps.w")
     1305         .
     1306         run value(v-param-form) (
     1307                                  input parparentproc
     1308                                 ,input this-procedure:handle
     1309                                 ,input '':U
     1310                                 ,input 'ПРОСМОТР':U
     1311                                 ,input 'rp-rule-param':U
     1312                                 ,input X_rp-by-call.profile_id
     1313                                 ,input X_rp-by-call.once-more
     1314                                 ,input X_rp-by-call.call_id
     1315                                 ,input 0
     1316                                 ,input 0
     1317                                 ,input ?
     1318                                 ,input 0
     1319                                 ,INput substitute("Профайл &1 Номер привязки &2 &3"
     1320                                       , X_rp-by-call.profile_id
     1321                                       , X_rp-by-call.once-more
     1322                                       , calldscr(X_rp-by-call.call_id)
     1323                                       )
     1324                                 ,input-output table tt0-rule-call-param  ) no-error.
     1325         IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1326       end.
     1327     end case.
     1328   END.
     1329   ON CHOOSE OF b-prop-ref IN FRAME Dialog-Frame
     1330   DO:
     1331     IF NOT AVAILABLE X_dis-card-type  THEN RETURN NO-APPLY.
     1332     DEFINE VARIABLE v-rid-list AS CHARACTER NO-UNDO.
     1333     run ref/proprefs.w ( INPUT parparentproc
     1334                     ,INPUT (if v-cntxt-db-num = 0
     1335                            and lookup("b-add", bttns) > 0
     1336                            then "b-add":U
     1337                            else '':U)
     1338                     ,INPUT "call_id"
     1339                     ,INPUT 0
     1340                     ,input '':U
     1341                     ,INPUT X_dis-card-type.uniq-key-rec
     1342                     ,INPUT-OUTPUT v-rid-list) NO-ERROR.
     1343   END.
     1344   ON CHOOSE OF b-rule IN FRAME Dialog-Frame
     1345   DO:
     1346     IF NOT AVAILABLE X_rule-by-call THEN RETURN NO-APPLY.
     1347     IF rule-display-option = "" THEN DO:
     1348      run gbl/pop-up.p ( input self:handle, input no) no-error.
     1349     END.
     1350     IF rule-display-option = "" THEN DO:
     1351       RETURN NO-APPLY.
     1352     END.
     1353     RUN proc-display-rule IN THIS-PROCEDURE (
     1354                                               INPUT rule-display-option
     1355                                              ,INPUT X_rule-by-call.codex_id
     1356                                              ,INPUT X_rule-by-call.ruleset_id
     1357                                              ,INPUT X_rule-by-call.call_Id
     1358                                              ,INPUT X_rule-by-call.order_id
     1359                                              ,INPUT X_rule-by-call.rule_id) NO-ERROR.
     1360     IF ERROR-STATUS:ERROR THEN DO:
     1361       ASSIGN
     1362       rule-display-option = "".
     1363       RETURN NO-APPLY.
     1364     END.
     1365     ASSIGN
     1366     rule-display-option = "".
     1367   END.
     1368   ON CHOOSE OF b-ruleproc IN FRAME Dialog-Frame
     1369   DO:
     1370     IF NOT AVAILABLE X_dis-card-type THEN RETURN NO-APPLY.
     1371   IF rule-proc-option = '':U THEN DO:
     1372      run gbl/pop-up.p ( INPUT SELF:handle, input no ) no-error.
     1373      if error-status :error then do: return no-apply. end.
     1374   end.
     1375   if rule-proc-option = "":U then do:
     1376         return no-apply.
     1377   end.
     1378   run rule-proc IN THIS-PROCEDURE ( BUFFER X_dis-card-type, INPUT rule-proc-option) no-error .
     1379   IF ERROR-STATUS:ERROR THEN DO:
     1380       rule-proc-option = '':U.
     1381       RETURN NO-APPLY.
     1382   END.
     1383   rule-proc-option = '':U.
     1384   END.
     1385   ON CHOOSE OF B-ruleset IN FRAME Dialog-Frame
     1386   DO:
     1387     DEFINE VARIABLE v-rec AS RECID NO-UNDO.
     1388   define buffer buf_ruleset for ub.ruleset.
     1389     IF NOT AVAILABLe X_rule-by-call THEN DO:
     1390         RETURN NO-APPLY.
     1391     END.
     1392     FIND FIRST buf_ruleset NO-LOCK WHERE
     1393               buf_ruleset.codex_id = X_rule-by-call.codex_id
     1394           AND buf_ruleset.ruleset_id = X_rule-by-call.ruleset_id.
     1395     run rul/ruleset-i.w ( input parparentproc
     1396                          ,input 'ПРОСМОТР':U
     1397                          ,input buf_ruleset.codex_id
     1398                          ,input buf_ruleset.ruleset_id
     1399                          ,input-output v-rec) no-error.
     1400   END.
     1401   ON CHOOSE OF B-sel IN FRAME Dialog-Frame
     1402   DO:
     1403     if available X_dis-card-type then do:
     1404       if  ( v-rid-list = "" ) or b-mark:sensitive = no
     1405        then  v-rid-list = string( recid( X_dis-card-type ) ) .
     1406     end.
     1407   END.
     1408   ON VALUE-CHANGED OF BR-dctype IN FRAME Dialog-Frame
     1409   DO:
     1410     RUN proc-value-changed IN THIS-PROCEDURE NO-ERROR.
     1411     IF ERROR-STATUS:ERROR  THEN RETURN NO-APPLY.
     1412   END.
     1413   ON VALUE-CHANGED OF br-profile IN FRAME Dialog-Frame
     1414   DO:
     1415     IF NOT AVAILABLE X_rp-by-call THEN DO:
     1416        e-rule-name:SCREEN-VALUE = ''.
     1417     END.
     1418     ELSE DO:
     1419       e-rule-name:SCREEN-VALUE = X_rp-by-call.ps.
     1420     END.
     1421   END.
     1422   ON VALUE-CHANGED OF br-rule-by-call IN FRAME Dialog-Frame
     1423   DO:
     1424     DEFINE BUFFER buf_rule FOR ub.RULE.
     1425     IF NOT AVAILABLE X_rule-by-call THEN RETURN NO-APPLY.
     1426     FIND FIRST buf_rule NO-LOCK WHERE
     1427               buf_rule.RULE_id = X_rule-by-call.RULE_id NO-ERROR.
     1428     IF NOT AVAILABLE buf_rule THEN DO:
     1429        e-rule-name:SCREEN-VALUE = SUBSTITUTE("!!!Правило &1 не найдено", X_rule-by-call.RULE_Id).
     1430     END.
     1431     ELSE DO:
     1432       e-rule-name:SCREEN-VALUE = buf_rule.name + chr(10) + buf_rule.documentation.
     1433     END.
     1434   END.
     1435   ON CHOOSE OF MENU-ITEM m_graph
     1436   DO:
     1437     IF NOT AVAILABLE X_rule-by-call THEN RETURN NO-APPLY.
     1438     ASSIGN
     1439     rule-display-option = "graph".
     1440     RUN proc-display-rule IN THIS-PROCEDURE (  INPUT rule-display-option
     1441                                                 ,INPUT X_rule-by-call.codex_id
     1442                                                 ,INPUT X_rule-by-call.ruleset_id
     1443                                                 ,INPUT X_rule-by-call.call_Id
     1444                                                 ,INPUT X_rule-by-call.order_id
     1445                                                 ,INPUT X_rule-by-call.rule_id) NO-ERROR.
     1446     ASSIGN
     1447     rule-display-option = "".
     1448   END.
     1449   ON CHOOSE OF MENU-ITEM m_rpoc_graph
     1450   DO:
     1451     IF NOT AVAILABLE X_dis-card-type THEN RETURN NO-APPLY.
     1452     ASSIGN
     1453     rule-proc-option = "graph".
     1454     run rule-proc IN THIS-PROCEDURE ( BUFFER X_dis-card-type, INPUT rule-proc-option) NO-ERROR.
     1455     IF ERROR-STATUS:ERROR THEN DO:
     1456         rule-proc-option = '':U.
     1457         RETURN NO-APPLY.
     1458     END.
     1459     rule-proc-option = '':U.
     1460   END.
     1461   ON CHOOSE OF MENU-ITEM m_rpoc_text
     1462   DO:
     1463      IF NOT AVAILABLE X_dis-card-type THEN RETURN NO-APPLY.
     1464     ASSIGN
     1465     rule-proc-option = "text".
     1466     run rule-proc IN THIS-PROCEDURE ( BUFFER X_dis-card-type, INPUT rule-proc-option) NO-ERROR.
     1467     IF ERROR-STATUS:ERROR THEN DO:
     1468         rule-proc-option = '':U.
     1469         RETURN NO-APPLY.
     1470     END.
     1471     rule-proc-option = '':U.
     1472   END.
     1473   ON CHOOSE OF MENU-ITEM m_text
     1474   DO:
     1475   IF NOT AVAILABLE X_rule-by-call THEN RETURN NO-APPLY.
     1476     ASSIGN
     1477     rule-display-option = "text".
     1478     RUN proc-display-rule IN THIS-PROCEDURE (  INPUT rule-display-option
     1479                                               ,INPUT X_rule-by-call.codex_id
     1480                                               ,INPUT X_rule-by-call.ruleset_id
     1481                                               ,INPUT X_rule-by-call.call_Id
     1482                                               ,INPUT X_rule-by-call.order_id
     1483                                               ,INPUT X_rule-by-call.rule_id) NO-ERROR.
     1484     ASSIGN
     1485     rule-display-option = "".
     1486   END.
     1487   ON VALUE-CHANGED OF Rs-algo-profile IN FRAME Dialog-Frame
     1488   DO:
     1489     ASSIGN
     1490     rs-algo-profile.
     1491     CASE rs-algo-profile:
     1492       WHEN 'rule-by-call':U THEN DO:
     1493         HIDE
     1494         br-profile
     1495         IN FRAME Dialog-Frame.
     1496         .
     1497         DISPLAY
     1498         rs-algo-types
     1499         br-rule-by-call
     1500         b-rule
     1501         b-ruleset
     1502         WITH FRAME Dialog-Frame.
     1503       END.
     1504       WHEN 'rp-by-call':U THEN DO:
     1505           HIDE
     1506           br-rule-by-call
     1507           rs-algo-types
     1508           b-rule
     1509           b-ruleset
     1510           IN FRAME Dialog-Frame.
     1511           DISPLAY
     1512           br-profile
     1513           WITH FRAME Dialog-Frame.
     1514       END.
     1515     END CASE.
     1516   END.
     1517   ON VALUE-CHANGED OF rs-algo-types IN FRAME Dialog-Frame
     1518   DO:
     1519     ASSIGN
     1520     rs-algo-types.
     1521     OPEN QUERY br-rule-by-call FOR EACH X_rule-by-call       WHERE X_rule-by-call.call_id = x_dis-card-type.uniq-key-rec,            FIRST X_rule-profile NO-LOCK WHERE          X_rule-profile.profile_id = X_rule-by-call.profile_id      AND (rs-algo-types = 1 OR          X_rule-profile.is_dynamic = yes) BY X_rule-by-call.codex_id BY X_rule-by-call.ruleset_id BY X_rule-by-call.order_id INDEXED-REPOSITION.
     1522     APPLY "VALUE-CHANGED" TO br-rule-by-call IN FRAME Dialog-Frame.
     1523   END.
     1524   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1525   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1526   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1527   on help of frame Dialog-Frame
     1528   do:
     1529     run gbl/app_help.p
     1530       (input this-procedure :file-name
     1531       ,input ''
     1532       ,input ?
     1533       ) no-error.
     1534     if error-status :error then do:
     1535       message
     1536         "Ошибка при вызове помощи"
     1537         error-status :get-message(1)
     1538         view-as alert-box .
     1539     end.
     1540   end.
     1541   run minbtn-set in this-procedure .
     1542   on choose of b-help in frame Dialog-Frame
     1543   do:
     1544     apply "help":u to frame Dialog-Frame .
     1545   end.
     1546   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1547   procedure minbtn-set :
     1548       do
     1549           on error undo, return error return-value
     1550           :
     1551           define variable ii              as integer       no-undo .
     1552           define variable fh              as widget-handle no-undo .
     1553           define variable hh              as widget-handle no-undo .
     1554           define variable v-h             as handle        extent 4 no-undo .
     1555           define variable v-name-button   as character     no-undo .
     1556           define variable v-help-old-x    as decimal       no-undo .
     1557           define variable v-help-old-y    as decimal       no-undo .
     1558           define variable v-help-old-size as decimal       no-undo .
     1559           define variable v-frame-width   as decimal       no-undo .
     1560           define variable jj              as integer       no-undo .
     1561           do
     1562               on error undo, return error
     1563               :
     1564               assign
     1565                   v-frame-width = frame Dialog-Frame:width - 0.3
     1566                   fh            = frame Dialog-Frame:first-child
     1567                   hh            = fh:first-child
     1568                   ii            = 1
     1569                   .
     1570               do while valid-handle(hh):
     1571                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1572                   do:
     1573                       case lc(hh:name) :
     1574                           when "b-help" then
     1575                               do:
     1576                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1577                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1578                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1579                                   hh:TOOLTIP = "Помощь" .
     1580                                   v-help-old-x = hh:column .
     1581                                   v-help-old-y = hh:row    .
     1582                                   v-help-old-size = hh:width .
     1583                                   hh:width-chars = 2.5 .
     1584                               end.
     1585                           when "b-print" then
     1586                               do:
     1587                                   hh:load-image("cmp/b-print.bmp":u) .
     1588                                   hh:TOOLTIP = "Печать" .
     1589                                   v-h[ii] = hh:handle .
     1590                                   ii = ii + 1 .
     1591                                   hh:width-chars = 3 .
     1592                               end.
     1593                           when "b-history" or
     1594                           when "b-hist" then
     1595                               do:
     1596                                   hh:load-image("cmp/b-hist.bmp":u) .
     1597                                   hh:TOOLTIP = "История" .
     1598                                   v-h[ii] = hh:handle .
     1599                                   ii = ii + 1 .
     1600                                   hh:width-chars = 3 .
     1601                               end.
     1602                           when "b-sch" then
     1603                               do:
     1604                                   hh:load-image("cmp/b-sch.bmp":u) .
     1605                                   hh:TOOLTIP = "Установка Фильтра" .
     1606                                   v-h[ii] = hh:handle .
     1607                                   ii = ii + 1 .
     1608                                   hh:width-chars = 3 .
     1609                               end.
     1610                           when "b-hist-user" then
     1611                               do:
     1612                                   hh:load-image("cmp/b-hist.bmp":u) .
     1613                                   hh:TOOLTIP = "История пользователя" .
     1614                                   ii = ii + 1 .
     1615                               end.
     1616                       end case.
     1617                   end.
     1618                   hh = hh:next-sibling.
     1619               end.
     1620               b-help:column = v-frame-width - b-help:width-chars.
     1621               jj = 0.
     1622               repeat ii = 4 to 1 by -1 :
     1623                   if valid-handle (v-h[ii] ) then
     1624                   do:
     1625                       jj  = jj + 1 .
     1626                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1627                       v-h[ii]:row    = v-help-old-y .
     1628                   end.
     1629               end.
     1630           end.
     1631       end.
     1632   end procedure.
     1633   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1634   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1635   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1636   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1637   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1638   define variable v-diasize-current-frame-height as decimal   no-undo .
     1639   define variable v-diasize-change-size          as logical   no-undo .
     1640   define variable v-diasize-resize-button        as handle    no-undo .
     1641   define variable v-diasize-wndmax               as logical   no-undo .
     1642   define variable v-diasize-wndstore             as logical   no-undo .
     1643   define variable v-diasize-proc-name            as character no-undo .
     1644   define variable v-diasize-browse-handle        as handle    no-undo .
     1645   define variable v-diasize-browse-number        as integer   no-undo .
     1646   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1647   define temp-table temp-diasize-handle no-undo
     1648     field handle-value  as handle
     1649     field save-position as decimal
     1650     index xpk is primary unique handle-value
     1651     .
     1652   define temp-table temp-browse-handle no-undo
     1653     field browse-type   as character
     1654     field browse-number as integer
     1655     field browse-handle as handle
     1656     field original-size as decimal
     1657     index xpk is primary unique browse-type browse-number
     1658     index xie browse-type browse-handle
     1659   .
     1660   procedure diasize_change-height :
     1661     define input  parameter p-change-value  as decimal   no-undo .
     1662     define input  parameter p-move-resize   as logical   no-undo .
     1663     define variable v-field-group-handle    as handle    no-undo .
     1664     define variable v-object-handle         as handle    no-undo .
     1665     define variable v-frame-height          as decimal   no-undo .
     1666     define variable v-frame-virtual-height  as decimal   no-undo .
     1667     define variable v-browse-height         as decimal   no-undo .
     1668     define variable v-window-height         as decimal   no-undo .
     1669     define variable v-window-virtual-height as decimal   no-undo .
     1670     define variable v-change-sign           as integer   no-undo .
     1671     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1672     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1673     if p-change-value > 0
     1674     then do:
     1675       if frame Dialog-Frame :height + p-change-value
     1676           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1677       then do:
     1678         assign
     1679           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1680                           - (frame Dialog-Frame :height-chars)
     1681         .
     1682         if p-change-value <= 0
     1683         then do:
     1684           run diasize_position-resize-button in this-procedure .
     1685           return .
     1686         end.
     1687       end.
     1688     end.
     1689     if p-change-value < 0
     1690     then do:
     1691       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1692       then do:
     1693         assign
     1694           p-change-value = v-diasize-orig-frame-height
     1695                          - (frame Dialog-Frame :height-chars)
     1696         .
     1697         if p-change-value >= 0
     1698         then do:
     1699           run diasize_position-resize-button in this-procedure .
     1700           return .
     1701         end.
     1702       end.
     1703     end.
     1704     if p-change-value >= 0
     1705     then do:
     1706       assign
     1707         v-change-sign = 1
     1708       .
     1709     end.
     1710     else do:
     1711       assign
     1712         v-change-sign = -1
     1713       .
     1714     end.
     1715     assign
     1716       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1717     .
     1718     if p-change-value = 0
     1719     then do:
     1720       run diasize_position-resize-button in this-procedure .
     1721       return .
     1722     end.
     1723     move_block:
     1724     do
     1725     on error undo move_block, retry move_block
     1726     :
     1727       if retry
     1728       then do:
     1729         do
     1730         on error undo move_block, leave move_block
     1731         :
     1732           if p-change-value > 0
     1733           then do:
     1734             for each buf_temp-diasize-handle
     1735             on error undo, next
     1736             :
     1737               assign
     1738                 v-object-handle = buf_temp-diasize-handle.handle-value
     1739               .
     1740               if v-object-handle <> v-diasize-resize-button
     1741               then do:
     1742                 assign
     1743                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1744                 .
     1745               end.
     1746             end.
     1747             assign
     1748               v-diasize-browse-handle :height = v-browse-height
     1749             .
     1750             for each buf_temp-browse-handle
     1751               where buf_temp-browse-handle.browse-type = 'height':u
     1752             on error undo, next
     1753             :
     1754               assign
     1755                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1756               .
     1757             end.
     1758             assign
     1759               frame Dialog-Frame :height = v-frame-height
     1760             .
     1761             if frame Dialog-Frame :scrollable = true
     1762             then do:
     1763               assign
     1764                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1765               .
     1766             end.
     1767             run diasize_position-resize-button in this-procedure .
     1768           end.
     1769           else do:
     1770             if frame Dialog-Frame :scrollable = true
     1771             then do:
     1772               assign
     1773                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1774               .
     1775             end.
     1776             assign
     1777               frame Dialog-Frame :height = v-frame-height
     1778             .
     1779             assign
     1780               v-diasize-browse-handle :height = v-browse-height
     1781             .
     1782             for each buf_temp-browse-handle
     1783               where buf_temp-browse-handle.browse-type = 'height':u
     1784             on error undo, next
     1785             :
     1786               assign
     1787                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1788               .
     1789             end.
     1790             for each buf_temp-diasize-handle
     1791             on error undo, next
     1792             :
     1793               assign
     1794                 v-object-handle = buf_temp-diasize-handle.handle-value
     1795               .
     1796               if v-object-handle <> v-diasize-resize-button
     1797               then do:
     1798                 assign
     1799                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1800                 .
     1801               end.
     1802             end.
     1803             run diasize_position-resize-button in this-procedure .
     1804           end.
     1805           assign
     1806             v-diasize-change-size = false
     1807           .
     1808           leave move_block .
     1809         end.
     1810       end.
     1811       assign
     1812         v-diasize-need-full-display = true
     1813       .
     1814       if v-diasize-change-size = false
     1815       then do:
     1816         assign
     1817           v-diasize-change-size = true
     1818         .
     1819       end.
     1820       else do:
     1821         return .
     1822       end.
     1823       assign
     1824         v-frame-height = frame Dialog-Frame :height
     1825         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1826         v-browse-height = v-diasize-browse-handle :height
     1827       .
     1828       for each buf_temp-browse-handle
     1829         where buf_temp-browse-handle.browse-type = 'height':u
     1830       :
     1831         assign
     1832           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1833         .
     1834       end.
     1835       for each buf_temp-diasize-handle
     1836       :
     1837         delete buf_temp-diasize-handle .
     1838       end.
     1839       assign
     1840         v-field-group-handle = frame Dialog-Frame :first-child
     1841       .
     1842       do while valid-handle(v-field-group-handle)
     1843       :
     1844         assign
     1845           v-object-handle = v-field-group-handle :first-child
     1846         .
     1847         do while valid-handle(v-object-handle)
     1848         :
     1849           if  v-object-handle <> v-diasize-browse-handle :handle
     1850           and can-query(v-object-handle, "row")
     1851           and can-query(v-object-handle, "height")
     1852           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1853           then do:
     1854             find first buf_temp-browse-handle
     1855               where buf_temp-browse-handle.browse-type   = 'height':u
     1856                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1857               no-error .
     1858             if available buf_temp-browse-handle
     1859             then do:
     1860             end.
     1861             else do:
     1862               create buf_temp-diasize-handle .
     1863               assign
     1864                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1865                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1866               .
     1867             end.
     1868           end.
     1869           assign
     1870             v-object-handle = v-object-handle :next-sibling
     1871           .
     1872         end.
     1873         assign
     1874           v-field-group-handle = v-field-group-handle :next-sibling
     1875         .
     1876       end.
     1877       do with frame Dialog-Frame
     1878       :
     1879         hide v-diasize-resize-button .
     1880         assign
     1881           v-diasize-resize-button :row    = 1
     1882           v-diasize-resize-button :column = 1
     1883         .
     1884       end.
     1885       if p-change-value > 0
     1886       then do:
     1887         if frame Dialog-Frame :scrollable = true
     1888         then do:
     1889           assign
     1890             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1891             no-error .
     1892           if error-status :error
     1893           or error-status :get-message(1) <> ""
     1894           then do:
     1895             undo move_block, retry move_block .
     1896           end.
     1897         end.
     1898         assign
     1899           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1900           no-error .
     1901         if error-status :error
     1902         or error-status :get-message(1) <> ""
     1903         then do:
     1904           undo move_block, retry move_block .
     1905         end.
     1906         assign
     1907           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1908           no-error .
     1909         if error-status :error
     1910         or error-status :get-message(1) <> ""
     1911         then do:
     1912           undo move_block, retry move_block .
     1913         end.
     1914         for each buf_temp-browse-handle
     1915           where buf_temp-browse-handle.browse-type = 'height':u
     1916         on error undo move_block, retry move_block
     1917         :
     1918           assign
     1919             buf_temp-browse-handle.browse-handle :height
     1920               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1921             no-error .
     1922           if error-status :error
     1923           or error-status :get-message(1) <> ""
     1924           then do:
     1925             undo move_block, retry move_block .
     1926           end.
     1927         end.
     1928         for each buf_temp-diasize-handle
     1929         on error undo move_block, retry move_block
     1930         :
     1931           assign
     1932             v-object-handle = buf_temp-diasize-handle.handle-value
     1933           .
     1934           if v-object-handle <> v-diasize-resize-button
     1935           then do:
     1936             assign
     1937               v-object-handle :row = v-object-handle :row + p-change-value
     1938               no-error .
     1939             if error-status :error
     1940             or error-status :get-message(1) <> ""
     1941             then do:
     1942               undo move_block, retry move_block .
     1943             end.
     1944           end.
     1945         end.
     1946       end.
     1947       else do:
     1948         for each buf_temp-diasize-handle
     1949         on error undo move_block, retry move_block
     1950         :
     1951           assign
     1952             v-object-handle = buf_temp-diasize-handle.handle-value
     1953           .
     1954           if v-object-handle <> v-diasize-resize-button
     1955           then do:
     1956             assign
     1957               v-object-handle :row = v-object-handle :row + p-change-value
     1958               no-error .
     1959             if error-status :error
     1960             or error-status :get-message(1) <> ""
     1961             then do:
     1962               undo move_block, retry move_block .
     1963             end.
     1964           end.
     1965         end.
     1966         assign
     1967           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1968           no-error .
     1969         if error-status :error
     1970         or error-status :get-message(1) <> ""
     1971         then do:
     1972           undo move_block, retry move_block .
     1973         end.
     1974         for each buf_temp-browse-handle
     1975           where buf_temp-browse-handle.browse-type = 'height':u
     1976         on error undo move_block, retry move_block
     1977         :
     1978           assign
     1979             buf_temp-browse-handle.browse-handle :height
     1980               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1981             no-error .
     1982           if error-status :error
     1983           or error-status :get-message(1) <> ""
     1984           then do:
     1985             undo move_block, retry move_block .
     1986           end.
     1987         end.
     1988         assign
     1989           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1990           no-error .
     1991         if error-status :error
     1992         or error-status :get-message(1) <> ""
     1993         then do:
     1994           undo move_block, retry move_block .
     1995         end.
     1996         if frame Dialog-Frame :scrollable = true
     1997         then do:
     1998           assign
     1999             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2000             no-error .
     2001           if error-status :error
     2002           or error-status :get-message(1) <> ""
     2003           then do:
     2004             undo move_block, retry move_block .
     2005           end.
     2006         end.
     2007       end.
     2008       if p-move-resize = true
     2009       then do:
     2010         run diasize_position-resize-button in this-procedure .
     2011       end.
     2012       if v-diasize-wndstore = true
     2013       then do:
     2014         if connected("ub") = true
     2015         then do:
     2016           define variable v-cntxt-db-num        as integer   no-undo .
     2017           define variable v-cntxt-userid        as character no-undo .
     2018           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2019                                             , OUTPUT v-cntxt-userid
     2020                                             ) .
     2021           run gbl/wndsizew.p
     2022             (input  v-cntxt-db-num
     2023             ,input  v-cntxt-userid
     2024             ,input  v-diasize-proc-name
     2025             ,input  'height':u
     2026             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     2027             ) .
     2028         end.
     2029       end.
     2030     end.
     2031     assign
     2032       v-diasize-change-size = false
     2033     .
     2034   end procedure.
     2035   procedure diasize_set-height :
     2036     define input  parameter p-new-height  as decimal   no-undo .
     2037     define input  parameter p-move-resize as logical   no-undo .
     2038     do
     2039     on error undo, return error return-value
     2040     :
     2041       run diasize_change-height in this-procedure
     2042         (input  (p-new-height - frame Dialog-Frame :height)
     2043         ,input  p-move-resize
     2044         ) .
     2045     end.
     2046   end procedure.
     2047   procedure diasize_change-width :
     2048     define input  parameter p-change-value as decimal   no-undo .
     2049     define input  parameter p-move-resize  as logical   no-undo .
     2050     define variable v-field-group-handle   as handle    no-undo .
     2051     define variable v-object-handle        as handle    no-undo .
     2052     define variable v-frame-width          as decimal   no-undo .
     2053     define variable v-frame-virtual-width  as decimal   no-undo .
     2054     define variable v-browse-width         as decimal   no-undo .
     2055     define variable v-window-width         as decimal   no-undo .
     2056     define variable v-window-virtual-width as decimal   no-undo .
     2057     define variable v-change-sign          as integer   no-undo .
     2058     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2059     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2060     if p-change-value > 0
     2061     then do:
     2062       if frame Dialog-Frame :width + p-change-value >
     2063           session :width-chars
     2064       then do:
     2065         assign
     2066           p-change-value = session :width-chars - frame Dialog-Frame :width
     2067         .
     2068         if p-change-value <= 0
     2069         then do:
     2070           run diasize_position-resize-button in this-procedure .
     2071           return .
     2072         end.
     2073       end.
     2074     end.
     2075     if p-change-value < 0
     2076     then do:
     2077       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     2078       then do:
     2079         assign
     2080           p-change-value = v-diasize-orig-frame-width
     2081                          - frame Dialog-Frame :width
     2082         .
     2083         if p-change-value >= 0
     2084         then do:
     2085           run diasize_position-resize-button in this-procedure .
     2086           return .
     2087         end.
     2088       end.
     2089     end.
     2090     if p-change-value >= 0
     2091     then do:
     2092       assign
     2093         v-change-sign = 1
     2094       .
     2095     end.
     2096     else do:
     2097       assign
     2098         v-change-sign = -1
     2099       .
     2100     end.
     2101     assign
     2102       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2103     .
     2104     if p-change-value = 0
     2105     then do:
     2106       run diasize_position-resize-button in this-procedure .
     2107       return .
     2108     end.
     2109     move_block:
     2110     do
     2111     on error undo move_block, leave move_block
     2112     :
     2113       if retry
     2114       then do:
     2115         do
     2116         on error undo move_block, leave move_block
     2117         :
     2118           if p-change-value > 0
     2119           then do:
     2120             for each buf_temp-diasize-handle
     2121             on error undo, next
     2122             :
     2123               assign
     2124                 v-object-handle = buf_temp-diasize-handle.handle-value
     2125               .
     2126               if v-object-handle <> v-diasize-resize-button
     2127               then do:
     2128                 assign
     2129                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2130                 .
     2131               end.
     2132             end.
     2133             assign
     2134               v-diasize-browse-handle :width = v-browse-width
     2135             .
     2136             for each buf_temp-browse-handle
     2137               where buf_temp-browse-handle.browse-type = 'width':u
     2138             on error undo, next
     2139             :
     2140               assign
     2141                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2142               .
     2143             end.
     2144             assign
     2145               frame Dialog-Frame :width = v-frame-width
     2146             .
     2147             if frame Dialog-Frame :scrollable = true
     2148             then do:
     2149               assign
     2150                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2151               .
     2152             end.
     2153             run diasize_position-resize-button in this-procedure .
     2154           end.
     2155           else do:
     2156             if frame Dialog-Frame :scrollable = true
     2157             then do:
     2158               assign
     2159                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2160               .
     2161             end.
     2162             assign
     2163               frame Dialog-Frame :width = v-frame-width
     2164             .
     2165             for each buf_temp-browse-handle
     2166               where buf_temp-browse-handle.browse-type = 'width':u
     2167             on error undo, next
     2168             :
     2169               assign
     2170                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2171               .
     2172             end.
     2173             assign
     2174               v-diasize-browse-handle :width = v-browse-width
     2175             .
     2176             for each buf_temp-diasize-handle
     2177             on error undo, next
     2178             :
     2179               assign
     2180                 v-object-handle = buf_temp-diasize-handle.handle-value
     2181               .
     2182               if v-object-handle <> v-diasize-resize-button
     2183               then do:
     2184                 assign
     2185                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2186                 .
     2187               end.
     2188             end.
     2189             run diasize_position-resize-button in this-procedure .
     2190           end.
     2191           assign
     2192             v-diasize-change-size = false
     2193           .
     2194           leave move_block .
     2195         end.
     2196       end.
     2197       assign
     2198         v-diasize-need-full-display = true
     2199       .
     2200       if v-diasize-change-size = false
     2201       then do:
     2202         assign
     2203           v-diasize-change-size = true
     2204         .
     2205       end.
     2206       else do:
     2207         return .
     2208       end.
     2209       assign
     2210         v-frame-width = frame Dialog-Frame :width
     2211         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     2212         v-browse-width = v-diasize-browse-handle :width
     2213       .
     2214       for each buf_temp-browse-handle
     2215         where buf_temp-browse-handle.browse-type = 'width':u
     2216       :
     2217         assign
     2218           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2219         .
     2220       end.
     2221       for each buf_temp-diasize-handle
     2222       :
     2223         delete buf_temp-diasize-handle .
     2224       end.
     2225       assign
     2226         v-field-group-handle = frame Dialog-Frame :first-child
     2227       .
     2228       do while valid-handle(v-field-group-handle)
     2229       :
     2230         assign
     2231           v-object-handle = v-field-group-handle :first-child
     2232         .
     2233         do while valid-handle(v-object-handle)
     2234         :
     2235           if  v-object-handle <> v-diasize-browse-handle :handle
     2236           and v-object-handle <> v-diasize-resize-button
     2237           and can-query(v-object-handle, "row")
     2238           and can-query(v-object-handle, "height")
     2239           and ( v-object-handle :col + v-object-handle :width
     2240                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2241               )
     2242           then do:
     2243             find first buf_temp-browse-handle
     2244               where buf_temp-browse-handle.browse-type   = 'width':u
     2245                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2246               no-error .
     2247             if available buf_temp-browse-handle
     2248             then do:
     2249             end.
     2250             else do:
     2251               create buf_temp-diasize-handle .
     2252               assign
     2253                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2254                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2255               .
     2256             end.
     2257           end.
     2258           assign
     2259             v-object-handle = v-object-handle :next-sibling
     2260           .
     2261         end.
     2262         assign
     2263           v-field-group-handle = v-field-group-handle :next-sibling
     2264         .
     2265       end.
     2266       do with frame Dialog-Frame
     2267       :
     2268         hide v-diasize-resize-button .
     2269         v-diasize-resize-button :row = 1.
     2270         v-diasize-resize-button :column = 1.
     2271       end.
     2272       if p-change-value > 0
     2273       then do:
     2274         if frame Dialog-Frame :scrollable = true
     2275         then do:
     2276           assign
     2277             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2278             no-error .
     2279           if error-status :error
     2280           or error-status :get-message(1) <> ""
     2281           then do:
     2282             undo move_block, retry move_block.
     2283           end.
     2284         end.
     2285         assign
     2286           frame Dialog-Frame :width = v-frame-width + p-change-value
     2287           no-error .
     2288         if error-status :error
     2289         or error-status :get-message(1) <> ""
     2290         then do:
     2291           undo move_block, retry move_block.
     2292         end.
     2293         assign
     2294           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2295         no-error .
     2296         if error-status :error
     2297         or error-status :get-message(1) <> ""
     2298         then do:
     2299           undo move_block, retry move_block.
     2300         end.
     2301         for each buf_temp-browse-handle
     2302           where buf_temp-browse-handle.browse-type = 'width':u
     2303         on error undo move_block, retry move_block
     2304         :
     2305           assign
     2306             buf_temp-browse-handle.browse-handle :width
     2307               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2308             no-error .
     2309           if error-status :error
     2310           or error-status :get-message(1) <> ""
     2311           then do:
     2312             undo move_block, retry move_block .
     2313           end.
     2314         end.
     2315         for each buf_temp-diasize-handle
     2316         on error undo move_block, retry move_block
     2317         :
     2318           assign
     2319             v-object-handle = buf_temp-diasize-handle.handle-value
     2320           .
     2321           if v-object-handle <> v-diasize-resize-button
     2322           then do:
     2323             assign
     2324               v-object-handle :col = v-object-handle :col + p-change-value
     2325               no-error .
     2326             if error-status :error
     2327             or error-status :get-message(1) <> ""
     2328             then do:
     2329               undo move_block, retry move_block .
     2330             end.
     2331           end.
     2332         end.
     2333       end.
     2334       else do:
     2335         for each buf_temp-diasize-handle
     2336         on error undo move_block, retry move_block
     2337         :
     2338           assign
     2339             v-object-handle = buf_temp-diasize-handle.handle-value
     2340           .
     2341           if v-object-handle <> v-diasize-resize-button
     2342           then do:
     2343             assign
     2344               v-object-handle :col = v-object-handle :col + p-change-value
     2345               no-error .
     2346             if error-status :error
     2347             or error-status :get-message(1) <> ""
     2348             then do:
     2349               undo move_block, retry move_block .
     2350             end.
     2351           end.
     2352         end.
     2353         for each buf_temp-browse-handle
     2354           where buf_temp-browse-handle.browse-type = 'width':u
     2355         on error undo move_block, retry move_block
     2356         :
     2357           assign
     2358             buf_temp-browse-handle.browse-handle :width
     2359               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2360             no-error .
     2361           if error-status :error
     2362           or error-status :get-message(1) <> ""
     2363           then do:
     2364             undo move_block, retry move_block .
     2365           end.
     2366         end.
     2367         assign
     2368           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2369           no-error .
     2370         if error-status :error
     2371         or error-status :get-message(1) <> ""
     2372         then do:
     2373           undo move_block, retry move_block.
     2374         end.
     2375         assign
     2376           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2377         no-error .
     2378         if error-status :error
     2379         or error-status :get-message(1) <> ""
     2380         then do:
     2381           undo move_block, retry move_block.
     2382         end.
     2383         if frame Dialog-Frame :scrollable = true
     2384         then do:
     2385           assign
     2386             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2387           no-error .
     2388           if error-status :error
     2389           or error-status :get-message(1) <> ""
     2390           then do:
     2391             undo move_block, retry move_block.
     2392           end.
     2393         end.
     2394       end.
     2395       if p-move-resize
     2396       then do:
     2397         run diasize_position-resize-button in this-procedure .
     2398       end.
     2399       if v-diasize-wndstore = true
     2400       then do:
     2401         if connected("ub") = true
     2402         then do:
     2403           define variable v-cntxt-db-num        as integer   no-undo .
     2404           define variable v-cntxt-userid        as character no-undo .
     2405           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2406                                             , OUTPUT v-cntxt-userid
     2407                                             ) .
     2408           run gbl/wndsizew.p
     2409             (input  v-cntxt-db-num
     2410             ,input  v-cntxt-userid
     2411             ,input  v-diasize-proc-name
     2412             ,input  'width':u
     2413             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2414             ) .
     2415         end.
     2416       end.
     2417     end.
     2418     assign
     2419       v-diasize-change-size = false
     2420     .
     2421   end procedure.
     2422   procedure diasize_set-width :
     2423     define input  parameter p-new-width  as decimal   no-undo .
     2424     define input  parameter p-move-resize as logical   no-undo .
     2425     do
     2426     on error undo, return error return-value
     2427     :
     2428       run diasize_change-width in this-procedure
     2429         (input  (p-new-width - frame Dialog-Frame :width)
     2430         ,input  p-move-resize
     2431         ) .
     2432     end.
     2433   end procedure.
     2434   procedure diasize_position-resize-button :
     2435     do with frame Dialog-Frame
     2436     :
     2437       hide v-diasize-resize-button .
     2438       assign
     2439         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2440                     - 1
     2441                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2442         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2443                     - 1
     2444                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2445       .
     2446       view v-diasize-resize-button .
     2447     end.
     2448   end procedure.
     2449   on alt-right anywhere
     2450   do:
     2451     run diasize_change-width in this-procedure
     2452       (input 1
     2453       ,input true
     2454       ) .
     2455     return no-apply .
     2456   end.
     2457   on alt-left anywhere
     2458   do:
     2459     run diasize_change-width in this-procedure
     2460       (input -1
     2461       ,input true
     2462       ) .
     2463     return no-apply .
     2464   end.
     2465   on alt-down anywhere
     2466   do:
     2467     run diasize_change-height in this-procedure
     2468       (input 1
     2469       ,input true
     2470       ) .
     2471     return no-apply .
     2472   end.
     2473   on alt-up anywhere
     2474   do:
     2475     run diasize_change-height in this-procedure
     2476       (input -1
     2477       ,input true
     2478       ) .
     2479     return no-apply .
     2480   end.
     2481   on alt-enter of frame Dialog-Frame
     2482   do:
     2483     run diasize_maximize in this-procedure
     2484       (input  ?
     2485       ).
     2486     return no-apply .
     2487   end.
     2488   procedure diasize_end-move :
     2489     do
     2490     on error undo, return error return-value
     2491     :
     2492       define variable v-row-delta as decimal   no-undo .
     2493       define variable v-col-delta as decimal   no-undo .
     2494       define variable v-new-row as decimal   no-undo .
     2495       define variable v-new-col as decimal   no-undo .
     2496       assign
     2497         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2498         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2499       .
     2500       assign
     2501         v-row-delta = v-new-row - frame Dialog-Frame :height
     2502         v-col-delta = v-new-col - frame Dialog-Frame :width
     2503       .
     2504       run diasize_change-height in this-procedure
     2505         (input v-row-delta
     2506         ,input true
     2507         ) .
     2508       run diasize_change-width in this-procedure
     2509         (input v-col-delta
     2510         ,input true
     2511         ) .
     2512     end.
     2513   end procedure.
     2514   procedure diasize_maximize :
     2515     define input  parameter p-action as logical   no-undo .
     2516     do
     2517     on error undo, return error return-value
     2518     :
     2519       if p-action = ?
     2520       then do:
     2521         if v-diasize-need-maximize = true
     2522         then do:
     2523           assign
     2524             p-action = true
     2525           .
     2526         end.
     2527         else do:
     2528           assign
     2529             p-action = false
     2530           .
     2531         end.
     2532       end.
     2533       if p-action = true
     2534       then do:
     2535         run diasize_change-height in this-procedure
     2536           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2537               - frame Dialog-Frame :height-chars
     2538           ,input true
     2539           ) .
     2540         run diasize_change-width in this-procedure
     2541           (input session :width-chars
     2542               - frame Dialog-Frame :width-chars
     2543           ,input true
     2544           ) .
     2545         assign
     2546           v-diasize-need-maximize = false
     2547         .
     2548       end.
     2549       else do:
     2550         run diasize_change-width in this-procedure
     2551           (input v-diasize-orig-frame-width
     2552               - frame Dialog-Frame :width-chars
     2553           ,input true
     2554           ) .
     2555         run diasize_change-height in this-procedure
     2556           (input v-diasize-orig-frame-height
     2557               - frame Dialog-Frame :height-chars
     2558           ,input true
     2559           ) .
     2560         assign
     2561           v-diasize-need-maximize = true
     2562         .
     2563       end.
     2564     end.
     2565   end procedure.
     2566   procedure diasize_restore-orig-size :
     2567     do
     2568     on error undo, return error return-value
     2569     :
     2570       assign
     2571         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2572         v-diasize-current-frame-height = frame Dialog-Frame :height
     2573       .
     2574       run diasize_set-height in this-procedure
     2575         (input  v-diasize-orig-frame-height
     2576         ,input  true
     2577         ) .
     2578       run diasize_set-width in this-procedure
     2579         (input  v-diasize-orig-frame-width
     2580         ,input  true
     2581         ) .
     2582     end.
     2583   end procedure.
     2584   procedure diasize_restore-current-size :
     2585     do
     2586     on error undo, return error return-value
     2587     :
     2588       run diasize_set-height in this-procedure
     2589         (input  v-diasize-current-frame-height
     2590         ,input  true
     2591         ) .
     2592       run diasize_set-width in this-procedure
     2593         (input  v-diasize-current-frame-width
     2594         ,input  true
     2595         ) .
     2596     end.
     2597   end procedure.
     2598   procedure diasize_set-browse-handle :
     2599     define input  parameter p-browse-handle as handle   no-undo .
     2600     define buffer buf_temp-browse-handle for temp-browse-handle .
     2601     do
     2602     on error undo, return error return-value
     2603     :
     2604       assign
     2605         v-diasize-browse-handle = p-browse-handle
     2606       .
     2607       for each buf_temp-browse-handle
     2608       on error undo, return error return-value
     2609       :
     2610         delete buf_temp-browse-handle .
     2611       end.
     2612     end.
     2613   end procedure.
     2614   procedure diasize_add_browse :
     2615     define input  parameter p-browse-type   as character no-undo .
     2616     define input  parameter p-browse-handle as handle    no-undo .
     2617     define buffer buf_temp-browse-handle for temp-browse-handle .
     2618     do
     2619     on error undo, return error return-value
     2620     :
     2621       assign
     2622         v-diasize-browse-number = v-diasize-browse-number + 1
     2623       .
     2624       create buf_temp-browse-handle .
     2625       assign
     2626         buf_temp-browse-handle.browse-type   = p-browse-type
     2627         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2628         buf_temp-browse-handle.browse-handle = p-browse-handle
     2629       .
     2630     end.
     2631   end procedure.
     2632   procedure diasize_init :
     2633     define variable v-default-value    as logical   no-undo .
     2634     define variable v-restore-saved    as logical   no-undo .
     2635     define variable v-resize-value-str as character no-undo .
     2636     do
     2637     on error undo, return error return-value
     2638     :
     2639       do with frame Dialog-Frame
     2640       :
     2641         assign
     2642           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2643           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2644           v-diasize-browse-handle     = browse BR-dctype :handle
     2645         .
     2646         create button v-diasize-resize-button
     2647         assign
     2648           parent        = frame Dialog-Frame :first-child
     2649           label         = "s"
     2650           height-pixels = 16
     2651           width-pixels  = 16
     2652           visible       = true
     2653           sensitive     = true
     2654           movable       = true
     2655           triggers:
     2656             on end-move persistent run diasize_end-move in this-procedure .
     2657           end triggers.
     2658         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2659         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2660         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2661         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2662         assign
     2663           v-diasize-wndmax = false
     2664         .
     2665         if connected("ub") = true
     2666         then do:
     2667           define variable v-cntxt-db-num        as integer   no-undo .
     2668           define variable v-cntxt-userid        as character no-undo .
     2669           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2670                                             , OUTPUT v-cntxt-userid
     2671                                             ) .
     2672           run gbl/wndpar_r.p
     2673             (input  v-cntxt-db-num
     2674             ,input  v-cntxt-userid
     2675             ,input  'wndmax':U
     2676             ,output v-diasize-wndmax
     2677             ,output v-default-value
     2678             ) .
     2679         end.
     2680         assign
     2681           v-diasize-wndstore = false
     2682         .
     2683         if connected("ub") = true
     2684         then do:
     2685           run gbl/wndpar_r.p
     2686             (input  v-cntxt-db-num
     2687             ,input  v-cntxt-userid
     2688             ,input  'wndstore':U
     2689             ,output v-diasize-wndstore
     2690             ,output v-default-value
     2691             ) .
     2692         end.
     2693         assign
     2694           v-diasize-proc-name = entry(1, program-name(2), '.')
     2695         .
     2696         if v-diasize-wndstore = true
     2697         then do:
     2698           assign
     2699             v-restore-saved = false
     2700           .
     2701           if connected("ub") = true
     2702           then do:
     2703             run gbl/wndsizer.p
     2704               (input  v-cntxt-db-num
     2705               ,input  v-cntxt-userid
     2706               ,input  v-diasize-proc-name
     2707               ,input  'height':u
     2708               ,output v-resize-value-str
     2709               ) .
     2710             if v-resize-value-str <> '':U
     2711             then do:
     2712               run diasize_change-height in this-procedure
     2713                 (input  integer(v-resize-value-str)
     2714                 ,input  true
     2715                 ) .
     2716               assign
     2717                 v-restore-saved = true
     2718               .
     2719             end.
     2720           end.
     2721           if connected("ub") = true
     2722           then do:
     2723             run gbl/wndsizer.p
     2724               (input  v-cntxt-db-num
     2725               ,input  v-cntxt-userid
     2726               ,input  v-diasize-proc-name
     2727               ,input  'width':u
     2728               ,output v-resize-value-str
     2729               ) .
     2730             if v-resize-value-str <> '':U
     2731             then do:
     2732               run diasize_change-width in this-procedure
     2733                 (input  integer(v-resize-value-str)
     2734                 ,input  true
     2735                 ) .
     2736               assign
     2737                 v-restore-saved = true
     2738               .
     2739             end.
     2740           end.
     2741           if v-restore-saved <> true
     2742           then do:
     2743             if v-diasize-wndmax = true
     2744             then do:
     2745               run diasize_maximize in this-procedure
     2746                 (input  true
     2747                 ) .
     2748             end.
     2749           end.
     2750         end.
     2751         else do:
     2752           if v-diasize-wndmax = true
     2753           then do:
     2754             run diasize_maximize in this-procedure
     2755               (input  true
     2756               ) .
     2757           end.
     2758         end.
     2759       end.
     2760     end.
     2761   end procedure.
     2762   procedure diasize_need-full-display :
     2763     define output parameter p-need-full-display as logical   no-undo .
     2764     do
     2765     on error undo, return error return-value
     2766     :
     2767       assign
     2768         p-need-full-display = v-diasize-need-full-display
     2769       .
     2770       assign
     2771         v-diasize-need-full-display = false
     2772       .
     2773     end.
     2774   end procedure.
     2775   procedure get-context :
     2776      define output parameter p-db-num as integer          no-undo.
     2777      define output parameter p-user-id as character        no-undo.
     2778      define variable v-login               as character    no-undo.
     2779      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2780      define buffer buf_user-login  for ub.user-login .
     2781      do
     2782      on error undo, return error
     2783      :
     2784            FIND FIRST buf_sys-ctrl no-lock.
     2785            ASSIGN
     2786               v-login = USERID("ub")
     2787               p-db-num = buf_sys-ctrl.db-num
     2788            .
     2789            FIND FIRST buf_user-login
     2790                 WHERE buf_user-login.db-num = p-db-num
     2791                   AND buf_user-login.user-login = v-login
     2792                 no-lock
     2793                 no-error
     2794                 .
     2795            IF AVAILABLE buf_user-login
     2796            THEN DO:
     2797               assign
     2798                  p-user-id = buf_user-login.user-id
     2799               .
     2800            END.
     2801      end.
     2802   end procedure.
     2803       run diasize_init in this-procedure .
     2804   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2805   on f5 of frame Dialog-Frame anywhere
     2806   do:
     2807      RUN proc-refresh IN THIS-PROCEDURE.
     2808       apply "VALUE-CHANGED" to BR-dctype.
     2809   end.
     2810   procedure rcpscont_get-rule-on-off :
     2811   define input parameter p-codex-id as integer no-undo .
     2812   define input parameter p-ruleset-id as integer no-undo .
     2813   define input parameter p-rule-id as integer no-undo .
     2814   define input parameter p-profile-id as integer no-undo .
     2815   define input parameter p-once-more as integer no-undo .
     2816   define output parameter p-on-off as logical no-undo .
     2817   define buffer buf_tt0-rule-by-call for ub.rule-by-call.
     2818   find first buf_tt0-rule-by-call where
     2819            buf_tt0-rule-by-call.codex_id = p-codex-id
     2820        and buf_tt0-rule-by-call.ruleset_id = p-ruleset-id
     2821        and buf_tt0-rule-by-call.profile_id = p-profile-id
     2822        and buf_tt0-rule-by-call.once-more = p-once-more
     2823        and buf_tt0-rule-by-call.rule_id = p-rule-id
     2824        no-error .
     2825   if available buf_tt0-rule-by-call then do:
     2826      p-on-off = buf_tt0-rule-by-call.can-calc.
     2827   end.
     2828   end procedure.
     2829   procedure rcpscont_set-rule-on-off :
     2830   define input parameter p-codex-id as integer no-undo .
     2831   define input parameter p-ruleset-id as integer no-undo .
     2832   define input parameter p-rule-id as integer no-undo .
     2833   define input parameter p-profile-id as integer no-undo .
     2834   define input parameter p-once-more as integer no-undo .
     2835   define input parameter p-on-off as logical no-undo .
     2836   define variable v-h as handle no-undo .
     2837   define buffer buf_tt0-rule-by-call for ub.rule-by-call.
     2838   v-h = buffer ub.rule-by-call:handle.
     2839   if v-h:table <> ''
     2840   and v-h:table <> ? then do:
     2841     find first buf_tt0-rule-by-call where
     2842             buf_tt0-rule-by-call.codex_id = p-codex-id
     2843         and buf_tt0-rule-by-call.ruleset_id = p-ruleset-id
     2844         and buf_tt0-rule-by-call.profile_id = p-profile-id
     2845         and buf_tt0-rule-by-call.once-more = p-once-more
     2846         and buf_tt0-rule-by-call.rule_id = p-rule-id   no-error .
     2847     if not available buf_tt0-rule-by-call then do:
     2848       undo, return error .
     2849     end.
     2850     buf_tt0-rule-by-call.can-calc = p-on-off .
     2851     release buf_tt0-rule-by-call.
     2852   end.
     2853   end procedure.
     2854   MAIN-BLOCK:
     2855   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2856      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2857   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2858     run mainmenu_getcntxt in parparentproc
     2859       (output v-cntxt-db-num
     2860       ,output v-cntxt-userid
     2861       ,output v-cntxt-level
     2862       ,output v-cntxt-host-code-obj
     2863       ,output v-cntxt-obj-type
     2864       ,output v-cntxt-obj-code
     2865       ,output v-cntxt-db-num-obj
     2866       ,output v-cntxt-is-admin
     2867       ) .
     2868   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     2869     (input  'is-dc'
     2870     ,input  0
     2871     ,input  '':U
     2872     ,input  0
     2873     ,input  '':U
     2874     ,input  '':U
     2875     ,input  '':U
     2876     ,input  NO
     2877     ,output v-is-dc
     2878     ,output v-conf-type
     2879     ) NO-ERROR .
     2880     IF ERROR-STATUS:ERROR OR
     2881       v-conf-type <> 'L':U THEN
     2882       v-is-dc = "no".
     2883     if logical(v-is-dc) = no then do:
     2884       message
     2885       "В Вашей системе недоступна функциональность работы с дисконтными картами"
     2886       view-as alert-box WARNING.
     2887       undo main-block, return error .
     2888     end.
     2889     v-rid-list = p-rid-list.
     2890     RUN Myenable in this-procedure .
     2891     Run OpenBR in this-procedure .
     2892     if v-rid-list <> '':U then do:
     2893       reposition br-dctype to recid( integer(entry(1, v-rid-list))) no-error .
     2894     end.
     2895     HIDE mark-num in frame Dialog-Frame .
     2896     APPLY "ENTRY" TO br-dctype.
     2897     APPLY "VALUE-CHANGED" TO br-dctype.
     2898     WAIT-FOR GO OF FRAME Dialog-Frame.
     2899   END.
     2900   RUN disable_UI.
     2901   PROCEDURE disable_UI :
     2902     HIDE FRAME Dialog-Frame.
     2903   END PROCEDURE.
     2904   PROCEDURE enable_UI :
     2905     DISPLAY Rs-algo-profile rs-algo-types E-rule-name mark-num
     2906         WITH FRAME Dialog-Frame.
     2907     ENABLE B-exit B-mark B-sel B-add B-lookup B-chg B-del b-prop-ref b-disc
     2908            B-hist B-Help B-mask b-ruleproc BR-dctype Rs-algo-profile
     2909            rs-algo-types b-rule b-params B-ruleset br-rule-by-call br-profile
     2910            E-rule-name mark-num
     2911         WITH FRAME Dialog-Frame.
     2912     VIEW FRAME Dialog-Frame.
     2913     OPEN QUERY br-profile FOR EACH X_rp-by-call WHERE          X_rp-by-call.call_id = x_dis-card-type.uniq-key-rec NO-LOCK INDEXED-REPOSITION.    OPEN QUERY br-rule-by-call FOR EACH X_rule-by-call       WHERE X_rule-by-call.call_id = x_dis-card-type.uniq-key-rec,            FIRST X_rule-profile NO-LOCK WHERE          X_rule-profile.profile_id = X_rule-by-call.profile_id      AND (rs-algo-types = 1 OR          X_rule-profile.is_dynamic = yes) BY X_rule-by-call.codex_id BY X_rule-by-call.ruleset_id BY X_rule-by-call.order_id INDEXED-REPOSITION.
     2914   END PROCEDURE.
     2915   PROCEDURE get-dis-dct-value :
     2916   DEFINE INPUT PARAMETER p-emitent-host-code AS integer no-undo.
     2917   DEFINE INPUT PARAMETER p-type AS CHARACTER no-undo.
     2918   DEFINE INPUT PARAMETER p-host-code AS integer no-undo.
     2919   DEFINE INPUT PARAMETER p-obj-type AS character no-undo.
     2920   DEFINE INPUT PARAMETER p-obj-code AS integer no-undo.
     2921   DEFINE INPUT PARAMETER p-discnt-role AS CHARACTER NO-UNDO.
     2922   DEFINE output PARAMETER p-discnt-value AS CHARACTER NO-UNDO.
     2923   DEFINE BUFFER buf_dis-dct-rule FOR ub.dis-dct-rule.
     2924   define buffer buf_dis-rule for ub.dis-rule.
     2925   find first buf_dis-dct-rule no-lock where
     2926             buf_dis-dct-rule.emitent-host-code = p-emitent-host-code
     2927         and buf_dis-dct-rule.type = p-TYPE
     2928         and buf_dis-dct-rule.host-code = p-host-code
     2929         and buf_dis-dct-rule.obj-type = p-obj-type
     2930         and buf_dis-dct-rule.obj-code = p-obj-code
     2931         and buf_dis-dct-rule.pos-type = 'bo':U
     2932         and buf_dis-dct-rule.discnt-role = p-discnt-role no-error.
     2933   if available buf_dis-dct-rule then do:
     2934     find first buf_dis-rule no-lock where
     2935               buf_dis-rule.rule-num = buf_dis-dct-rule.rule-num no-error.
     2936     if available buf_dis-rule then do:
     2937       assign
     2938       p-discnt-value        = (IF p-discnt-role = 'def-categ':U
     2939                                THEN string(buf_dis-rule.dis-kat)
     2940                                ELSE string(buf_dis-rule.discnt-value, "->9.99%")).
     2941       .
     2942     end.
     2943   end.
     2944   END PROCEDURE.
     2945   PROCEDURE MyEnable :
     2946   DEFINE VARIABLE clh AS WIDGET-HANDLE NO-UNDO.
     2947   DEFINE VARIABLE ii AS integer NO-UNDO.
     2948   DO ii = 1 TO br-profile:NUM-COLUMNS IN FRAME Dialog-Frame:
     2949       clh = BROWSE br-profile:get-browse-column(ii).
     2950       IF clh:LABEL BEGINS "Название" THEN DO:
     2951         ASSIGN
     2952         clh:RESIZABLE = YES
     2953         clh:width = 72
     2954         .
     2955       END.
     2956   END.
     2957   ASSIGN
     2958   rs-algo-profile:RADIO-BUTTONS = "Алгоритмы" + chr(44) +
     2959                                    'rp-by-call':U + chr(44) +
     2960                                   "Правила" + chr(44) + 'rule-by-call':U.
     2961   rs-algo-profile = 'rp-by-call':U.
     2962   ASSIGN
     2963   X_rule-by-call.algo-des:RESIZABLE IN BROWSE br-rule-by-call = YES
     2964   b-rule:menu-mouse in frame Dialog-Frame = 1
     2965   b-ruleproc:menu-mouse in frame Dialog-Frame = 1
     2966   .
     2967   DISPLAY
     2968   rs-algo-profile
     2969   rs-algo-types
     2970   WITH FRAME Dialog-Frame.
     2971   ENABLE
     2972   B-exit
     2973   b-sel when lookup("b-sel":U, bttns) > 0
     2974   b-mark when lookup("b-mark":U, bttns) > 0
     2975   B-add when lookup("b-add":U, bttns) > 0 and v-cntxt-db-num = 0
     2976   B-chg when lookup("b-add":U, bttns) > 0 and v-cntxt-db-num = 0
     2977   B-del when lookup("b-add":U, bttns) > 0 and v-cntxt-db-num = 0
     2978   b-lookup
     2979   B-Help
     2980   b-mask
     2981   b-hist
     2982   BR-dctype
     2983   br-rule-by-call
     2984   br-profile
     2985   b-params
     2986   b-rule
     2987   b-ruleset
     2988   b-prop-ref
     2989   b-disc
     2990   b-ruleproc
     2991   rs-algo-types
     2992   rs-algo-profile
     2993   e-rule-name
     2994   WITH FRAME Dialog-Frame.
     2995   VIEW FRAME Dialog-Frame.
     2996   APPLY "VALUE-CHANGED" TO rs-algo-profile.
     2997   END PROCEDURE.
     2998   PROCEDURE OpenBr :
     2999   CASE p-mode:
     3000     when 'все':U then do:
     3001       Open query br-dctype
     3002       for each X_dis-card-type No-LOCK where
     3003               X_dis-card-type.emitent-host-code = 0
     3004           AND X_dis-card-type.host-code = 0
     3005           AND X_dis-card-type.obj-type = "":U
     3006           and X_dis-card-type.obj-code = 0.
     3007    end.
     3008    when 'фирма':U then do:
     3009       Open query br-dctype
     3010       for each X_dis-card-type No-LOCK where
     3011               X_dis-card-type.emitent-host-code = paremitent-code
     3012           and X_dis-card-type.host-code = 0
     3013           AND X_dis-card-type.obj-type = "":U
     3014           and X_dis-card-type.obj-code = 0.
     3015    end.
     3016    otherwise do:
     3017       Open query br-dctype
     3018       for each X_dis-card-type NO-LOCK WHERE
     3019               X_dis-card-type.host-code = 0
     3020           AND X_dis-card-type.obj-type = "":U
     3021           and X_dis-card-type.obj-code = 0.
     3022     end.
     3023   END.
     3024   END PROCEDURE.
     3025   PROCEDURE proc-display-rule :
     3026   DEFINE INPUT PARAMETER p-DISPLAY-MODE AS CHARACTER NO-UNDO.
     3027   DEFINE INPUT PARAMETER p-codex-id AS INTEGER NO-UNDO.
     3028   DEFINE INPUT PARAMETER p-ruleset-id AS INTEGER NO-UNDO.
     3029   DEFINE INPUT PARAMETER p-call-id AS CHARACTER NO-UNDO.
     3030   DEFINE INPUT PARAMETER p-order-id AS INTEGER NO-UNDO.
     3031   DEFINE INPUT PARAMETER p-rule-id AS INTEGER NO-UNDO.
     3032   run rul/disprule.p (
     3033                          input p-DISPLAY-MODE
     3034                         ,input p-rule-id
     3035                         ,input p-codex-id
     3036                         ,input p-ruleset-id
     3037                         ,input p-call-id
     3038                         ,input p-order-id
     3039                          ).
     3040   END PROCEDURE.
     3041   PROCEDURE proc-refresh :
     3042   DEFINE VARIABLE v-doc-rec as RECID NO-UNDO.
     3043   if available X_dis-card-type then do:
     3044        v-doc-rec = recid(X_dis-card-type).
     3045   END.
     3046   RUN Openbr in this-procedure.
     3047   REPOSITION br-dctype TO RECID v-doc-rec NO-ERROR.
     3048   APPLY 'ENTRY' to br-dctype IN FRAME Dialog-Frame.
     3049   APPLY 'VALUE-CHANGED' to br-dctype.
     3050   END PROCEDURE.
     3051   PROCEDURE proc-value-changed :
     3052   OPEN QUERY br-rule-by-call FOR EACH X_rule-by-call       WHERE X_rule-by-call.call_id = x_dis-card-type.uniq-key-rec,            FIRST X_rule-profile NO-LOCK WHERE          X_rule-profile.profile_id = X_rule-by-call.profile_id      AND (rs-algo-types = 1 OR          X_rule-profile.is_dynamic = yes) BY X_rule-by-call.codex_id BY X_rule-by-call.ruleset_id BY X_rule-by-call.order_id INDEXED-REPOSITION.
     3053   OPEN QUERY br-profile FOR EACH X_rp-by-call WHERE          X_rp-by-call.call_id = x_dis-card-type.uniq-key-rec NO-LOCK INDEXED-REPOSITION.
     3054   IF rs-algo-profile = 'rule-by-call':U THEN DO:
     3055     APPLY "VAlue-changed" TO br-rule-by-call IN FRAME Dialog-Frame.
     3056   END.
     3057   IF rs-algo-profile = 'rp-by-call':U THEN DO:
     3058     APPLY "VAlue-changed" TO br-profile IN FRAME Dialog-Frame.
     3059   END.
     3060   END PROCEDURE.
     3061   PROCEDURE rule-proc :
     3062   DEFINE PARAMETER BUFFER buf_dis-card-type FOR ub.dis-card-type.
     3063   DEFINE INPUT PARAMETER p-option AS CHARACTER NO-UNDO.
     3064   run rul/run-rule-proc-view.p ( INPUT 'dis-card-type':U
     3065                                 ,INPUT buf_dis-card-type.uniq-key-rec
     3066                                 ,INPUT 0
     3067                                 ,INPUT p-option
     3068                                 ) NO-ERROR.
     3069   IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     3070   END PROCEDURE.
     3071   FUNCTION get-dflt-dct-rule RETURNS CHARACTER
     3072     (
     3073        INPUT p-emitent-host-code AS INTEGER
     3074       ,INPUT p-type AS CHARACTER
     3075       ,INPUT p-host-code AS INTEGER
     3076       ,INPUT p-obj-type AS CHARACTER
     3077       ,INPUT p-obj-code AS INTEGER
     3078       ,INPUT p-discnt-role AS CHARACTER) :
     3079   DEFINE variable v-discnt-value AS CHARACTER NO-UNDO .
     3080   v-discnt-value = chr(63).
     3081   RUN get-dis-dct-value IN THIS-PROCEDURE (
     3082                                                INPUT p-emitent-host-code
     3083                                               ,INPUT p-type
     3084                                               ,INPUT p-host-code
     3085                                               ,INPUT p-obj-type
     3086                                               ,INPUT p-obj-code
     3087                                               ,INPUT p-discnt-role
     3088                                               ,OUTPUT v-discnt-value) NO-ERROR.
     3089   RETURN v-discnt-value.
     3090   END FUNCTION.
     3091   FUNCTION get-emitent RETURNS CHARACTER
     3092     ( input par-emitent-host-code  as integer) :
     3093   define buffer buf_clients for ub.clients.
     3094     if par-emitent-host-code = 0 then return "Глобальная".
     3095     find first buf_clients no-lock where
     3096                    buf_clients.obj-type = 'орг':U and
     3097                     buf_clients.obj-code = par-emitent-host-code no-error.
     3098        if not avail buf_clients then return "?".
     3099        return buf_clients.obj-name.
     3100   END FUNCTION.
     3101   FUNCTION get-mark RETURNS CHARACTER
     3102     ( par-rid as recid, parv-rid-list as character  ) :
     3103   if lookup(string(par-rid), parv-rid-list) > 0 then return "*":U.
     3104   RETURN "".
     3105   END FUNCTION.
     3106   FUNCTION get-profile-dynamic RETURNS LOGICAL
     3107     ( p-profile_id AS INTEGER ) :
     3108   DEFINE BUFFER buf_rule-profile FOR ub.rule-profile.
     3109   FIND FIRST buf_rule-profile NO-LOCK WHERE
     3110             buf_rule-profile.profile_id = p-profile_id NO-ERROR.
     3111   IF NOT AVAILABLE buf_rule-profile THEN RETURN ?.
     3112   RETURN buf_rule-profile.is_dynamic.
     3113   END FUNCTION.
     3114   FUNCTION get-profile-name RETURNS CHARACTER
     3115     ( p-profile_id AS INTEGER ) :
     3116   DEFINE BUFFER buf_rule-profile FOR ub.rule-profile.
     3117   FIND FIRST buf_rule-profile NO-LOCK WHERE
     3118             buf_rule-profile.profile_id = p-profile_id NO-ERROR.
     3119   IF NOT AVAILABLE buf_rule-profile THEN RETURN chr(63).
     3120   RETURN buf_rule-profile.NAME.
     3121   END FUNCTION.
