        1   define input-output parameter p-value as character no-undo.
        2   define variable vss-revision    as character no-undo init "$Revision$":U .
        3   define variable vss-author      as character no-undo init "$Author$":U .
        4   define variable vss-date        as character no-undo init "$Date$":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        6   define variable vss-archive     as character no-undo init "$Archive$":U .
        7   define variable vss-description as character no-undo init "Редактор атрибута <Метод округления>".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   procedure proc-alt-shift-f2:
       67     if not ibs.th.gbl.gbl-var:rcode
       68   then
       69     run gbl\inidebug.p .
       70   end.
       71   procedure proc-alt-shift-f3:
       72     run gbl/prvssinf.p
       73       ( input this-procedure
       74       ) .
       75   end.
       76   define variable v-inform-launched as logical no-undo initial false .
       77   procedure proc-alt-shift-f4:
       78     define variable v-action as character no-undo .
       79     if v-inform-launched = false then do:
       80       assign
       81         v-inform-launched = true
       82       .
       83       run gbl/d-inform.w
       84         (  input self
       85         ,  input this-procedure
       86         , output v-action
       87         ) no-error .
       88       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       89       assign
       90         v-inform-launched = false
       91       .
       92     end.
       93   end.
       94   procedure proc-alt-f1:
       95     run gbl/corrhelp.p
       96       (input this-procedure
       97       ) .
       98   end .
       99   on alt-shift-f2 anywhere do:
      100     run proc-alt-shift-f2.
      101   end.
      102   on alt-shift-f3 anywhere do:
      103     run proc-alt-shift-f3 in this-procedure .
      104   end.
      105   on alt-shift-f4 anywhere do:
      106     run proc-alt-shift-f4 in this-procedure.
      107   end.
      108   on alt-f1 anywhere do:
      109     run proc-alt-f1 in this-procedure .
      110   end.
      111   define variable v-round-method as character no-undo.
      112   define variable v-base as decimal no-undo.
      113   DEFINE BUTTON B-exit AUTO-GO
      114        LABEL "&Ввод"
      115        SIZE 10 BY 1
      116        BGCOLOR 8 .
      117   DEFINE BUTTON B-Help
      118        LABEL "Помо&щь"
      119        SIZE 10 BY 1
      120        BGCOLOR 8 .
      121   DEFINE BUTTON b-quit AUTO-END-KEY
      122        LABEL "&Отмена"
      123        SIZE 10 BY 1
      124        BGCOLOR 8 .
      125   DEFINE VARIABLE f-base AS DECIMAL FORMAT "->>>>9.99":U INITIAL 0
      126        VIEW-AS FILL-IN
      127        SIZE 15.38 BY 1
      128        BGCOLOR 15  NO-UNDO.
      129   DEFINE VARIABLE S-round-method AS CHARACTER
      130        VIEW-AS SELECTION-LIST SINGLE SCROLLBAR-VERTICAL
      131        SIZE 24.38 BY 6.42
      132        BGCOLOR 15  NO-UNDO.
      133   DEFINE FRAME Dialog-Frame
      134        b-quit AT ROW 1 COL 1
      135        B-exit AT ROW 1 COL 11
      136        B-Help AT ROW 1 COL 41
      137        S-round-method AT ROW 2.88 COL 2.63 NO-LABEL
      138        f-base AT ROW 2.88 COL 27.75 COLON-ALIGNED NO-LABEL
      139        SPACE(8.11) SKIP(5.78)
      140       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      141            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      142            TITLE "Метод наценки"
      143            DEFAULT-BUTTON B-exit CANCEL-BUTTON b-quit.
      144   ASSIGN
      145          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      146          FRAME Dialog-Frame:HIDDEN           = TRUE.
      147   ON GO OF FRAME Dialog-Frame
      148   DO:
      149   define variable v-base-str as character no-undo.
      150     assign
      151     S-round-method
      152     f-base
      153     .
      154     if LOOKUP(S-round-method, 'Произвольно,Вверх,Коэффициент,9-99окончание':U) > 0 then do:
      155       if f-base = 0 then do:
      156         message
      157         "Введите ненулевое значение коэффициента"
      158         view-as alert-box error .
      159         return no-apply.
      160       end.
      161     END.
      162     assign
      163      v-base-str = (if f-base:visible in frame Dialog-Frame
      164                       then string(f-base, "->>>>9.99":U)
      165                       else "":U)
      166                       .
      167     assign
      168     p-value = s-round-method + chr(32) + v-base-str
      169     .
      170   END.
      171   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      172   DO:
      173     APPLY "END-ERROR":U TO SELF.
      174   END.
      175   ON VALUE-CHANGED OF S-round-method IN FRAME Dialog-Frame
      176   DO:
      177     assign
      178     S-round-method
      179     .
      180     if lookup(S-round-method, 'Произвольно,Вверх,Коэффициент,9-99окончание':U) > 0 then do:
      181       display
      182       f-base
      183       with frame Dialog-Frame.
      184       enable
      185       f-base
      186       with frame Dialog-Frame.
      187     end.
      188     else do:
      189       hide
      190       f-base
      191       in frame Dialog-Frame.
      192       disable
      193       f-base
      194       with frame Dialog-Frame.
      195     end.
      196   END.
      197   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      198   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      199   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      200   on help of frame Dialog-Frame
      201   do:
      202     run gbl/app_help.p
      203       (input this-procedure :file-name
      204       ,input ''
      205       ,input ?
      206       ) no-error.
      207     if error-status :error then do:
      208       message
      209         "Ошибка при вызове помощи"
      210         error-status :get-message(1)
      211         view-as alert-box .
      212     end.
      213   end.
      214   run minbtn-set in this-procedure .
      215   on choose of b-help in frame Dialog-Frame
      216   do:
      217     apply "help":u to frame Dialog-Frame .
      218   end.
      219   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      220   procedure minbtn-set :
      221       do
      222           on error undo, return error return-value
      223           :
      224           define variable ii              as integer       no-undo .
      225           define variable fh              as widget-handle no-undo .
      226           define variable hh              as widget-handle no-undo .
      227           define variable v-h             as handle        extent 4 no-undo .
      228           define variable v-name-button   as character     no-undo .
      229           define variable v-help-old-x    as decimal       no-undo .
      230           define variable v-help-old-y    as decimal       no-undo .
      231           define variable v-help-old-size as decimal       no-undo .
      232           define variable v-frame-width   as decimal       no-undo .
      233           define variable jj              as integer       no-undo .
      234           do
      235               on error undo, return error
      236               :
      237               assign
      238                   v-frame-width = frame Dialog-Frame:width - 0.3
      239                   fh            = frame Dialog-Frame:first-child
      240                   hh            = fh:first-child
      241                   ii            = 1
      242                   .
      243               do while valid-handle(hh):
      244                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      245                   do:
      246                       case lc(hh:name) :
      247                           when "b-help" then
      248                               do:
      249                                   hh:load-image-up("cmp/b-help.bmp":u) .
      250                                   hh:load-image-down("cmp/b-help.bmp":u) .
      251                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      252                                   hh:TOOLTIP = "Помощь" .
      253                                   v-help-old-x = hh:column .
      254                                   v-help-old-y = hh:row    .
      255                                   v-help-old-size = hh:width .
      256                                   hh:width-chars = 2.5 .
      257                               end.
      258                           when "b-print" then
      259                               do:
      260                                   hh:load-image("cmp/b-print.bmp":u) .
      261                                   hh:TOOLTIP = "Печать" .
      262                                   v-h[ii] = hh:handle .
      263                                   ii = ii + 1 .
      264                                   hh:width-chars = 3 .
      265                               end.
      266                           when "b-history" or
      267                           when "b-hist" then
      268                               do:
      269                                   hh:load-image("cmp/b-hist.bmp":u) .
      270                                   hh:TOOLTIP = "История" .
      271                                   v-h[ii] = hh:handle .
      272                                   ii = ii + 1 .
      273                                   hh:width-chars = 3 .
      274                               end.
      275                           when "b-sch" then
      276                               do:
      277                                   hh:load-image("cmp/b-sch.bmp":u) .
      278                                   hh:TOOLTIP = "Установка Фильтра" .
      279                                   v-h[ii] = hh:handle .
      280                                   ii = ii + 1 .
      281                                   hh:width-chars = 3 .
      282                               end.
      283                           when "b-hist-user" then
      284                               do:
      285                                   hh:load-image("cmp/b-hist.bmp":u) .
      286                                   hh:TOOLTIP = "История пользователя" .
      287                                   ii = ii + 1 .
      288                               end.
      289                       end case.
      290                   end.
      291                   hh = hh:next-sibling.
      292               end.
      293               b-help:column = v-frame-width - b-help:width-chars.
      294               jj = 0.
      295               repeat ii = 4 to 1 by -1 :
      296                   if valid-handle (v-h[ii] ) then
      297                   do:
      298                       jj  = jj + 1 .
      299                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      300                       v-h[ii]:row    = v-help-old-y .
      301                   end.
      302               end.
      303           end.
      304       end.
      305   end procedure.
      306   MAIN-BLOCK:
      307   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      308      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      309   assign
      310   v-round-method = entry(1, p-value, chr(32))
      311   v-base = decimal(entry(2, p-value, chr(32)))
      312   no-error.
      313   if error-status:error and num-entries(p-value, chr(32)) > 0 then do:
      314       message
      315       "Неверное значение параметра p-value" p-value
      316       view-as alert-box ERROR.
      317       return error.
      318   end.
      319   assign
      320   p-value = ?
      321   .
      322     RUN Myenable.
      323     WAIT-FOR GO OF FRAME Dialog-Frame.
      324   END.
      325   RUN disable_UI.
      326   PROCEDURE disable_UI :
      327     HIDE FRAME Dialog-Frame.
      328   END PROCEDURE.
      329   PROCEDURE enable_UI :
      330     DISPLAY S-round-method f-base
      331         WITH FRAME Dialog-Frame.
      332     ENABLE b-quit B-exit B-Help S-round-method f-base
      333         WITH FRAME Dialog-Frame.
      334     VIEW FRAME Dialog-Frame.
      335   END PROCEDURE.
      336   PROCEDURE MyEnable :
      337   s-round-method:list-items in frame Dialog-Frame = '9-окончание,9-99окончание,Без-дробных,Произвольно,Вверх,Коэффициент,Отключено':U.
      338   DISPLAY S-round-method f-base
      339         WITH FRAME Dialog-Frame.
      340     ENABLE b-quit B-exit B-Help S-round-method f-base
      341         WITH FRAME Dialog-Frame.
      342     VIEW FRAME Dialog-Frame.
      343   s-round-method:screen-value in frame Dialog-Frame = v-round-method.
      344   f-base = v-base.
      345   APPLY "VALUE-CHANGED" to S-round-method.
      346   END PROCEDURE.
