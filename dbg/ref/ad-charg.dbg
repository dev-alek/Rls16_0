      128     run proc-alt-f1 in this-procedure .
      129   end.
      130   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      131   procedure cur-time :
      132      define output parameter p-today as date      no-undo .
      133      define output parameter p-time  as integer   no-undo .
      134     do
      135     on error undo, return error
      136     :
      137       define variable v-date1 as date      no-undo .
      138       define variable v-date2 as date      no-undo .
      139       define variable v-time  as integer   no-undo .
      140       assign
      141         v-date1 = today
      142         v-time  = time
      143         v-date2 = today
      144       .
      145       if v-date1 <> v-date2
      146       then do:
      147         assign
      148           v-date1 = today
      149           v-time  = v-time
      150         .
      151       end.
      152       assign
      153         p-today = v-date1
      154         p-time  = v-time
      155       .
      156     end.
      157   end.
      158   function cur-time-date returns character
      159   :
      160     return string(today, '99/99/9999':U) .
      161   end.
      162   function cur-time-mjd returns decimal
      163   :
      164     define variable v-date as date      no-undo .
      165     define variable v-time as integer   no-undo .
      166     run cur-time in this-procedure
      167       (output v-date
      168       ,output v-time
      169       ) .
      170     return integer(v-date) - 2400002 + (v-time / 86400) .
      171   end.
      172   function cur-time-get-ending-index returns integer
      173   (input p-number as integer
      174   )
      175   :
      176     if p-number < 0
      177     or p-number = ?
      178     then do:
      179       return 1 .
      180     end.
      181     define variable v-rest as integer   no-undo .
      182     assign
      183       p-number = p-number modulo 100
      184     .
      185     if p-number < 20
      186     then do:
      187       assign
      188         v-rest = p-number
      189       .
      190     end.
      191     else do:
      192       assign
      193         v-rest = p-number modulo 10
      194       .
      195     end.
      196     case v-rest :
      197       when 1
      198       then do:
      199         return 2 .
      200       end.
      201       when 2 or
      202       when 3 or
      203       when 4
      204       then do:
      205         return 3 .
      206       end.
      207       otherwise do:
      208         return 1 .
      209       end.
      210     end case .
      211   end.
      212   procedure cur-time-mjd-to-date :
      213      define input  parameter i-mjd-diff as decimal no-undo.
      214      define output parameter o-Date     as date    no-undo.
      215      define output parameter o-Time     as integer no-undo.
      216      define variable v-day-number as integer   no-undo .
      217      if    i-mjd-diff < 0
      218         or i-mjd-diff = ?
      219      then do:
      220         return "?" .
      221      end.
      222      assign
      223         v-day-number = truncate(i-mjd-diff,0).
      224         o-Date = date(v-day-number + 2400002).
      225         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      226     .
      227   end.
      228   function cur-time-mjd-to-string returns character
      229   (input p-mjd-diff as decimal
      230   )
      231   :
      232     define variable v-day-number as integer   no-undo .
      233     define variable v-seconds    as integer   no-undo .
      234     define variable v-hour       as integer   no-undo .
      235     define variable v-min        as integer   no-undo .
      236     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      237     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      238     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      239     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      240     if p-mjd-diff < 0
      241     or p-mjd-diff = ?
      242     then do:
      243       return "?" .
      244     end.
      245     assign
      246       v-day-number = integer(truncate(p-mjd-diff,0))
      247       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      248     .
      249     if v-seconds > 86400
      250     then do:
      251       assign
      252         v-seconds = 86400 - 1
      253       .
      254     end.
      255     if v-seconds < 0
      256     then do:
      257       assign
      258         v-seconds = 0
      259       .
      260     end.
      261     assign
      262       v-hour = truncate(v-seconds / 3600, 0)
      263     .
      264     assign
      265       v-seconds = v-seconds modulo 3600
      266     .
      267     assign
      268       v-min = truncate(v-seconds / 60, 0)
      269     .
      270     assign
      271       v-seconds = v-seconds modulo 60
      272     .
      273     return
      274         (if v-day-number <> 0
      275           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      276           else ""
      277         )
      278       + (if v-day-number <> 0 or v-hour <> 0
      279           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      280           else ""
      281         )
      282       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      283           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      284           else ""
      285         )
      286       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      287       .
      288   end.
      289   function cur-time-string returns character
      290   :
      291     define variable v-date as date      no-undo .
      292     define variable v-time as integer   no-undo .
      293     run cur-time in this-procedure
      294       (output v-date
      295       ,output v-time
      296       ) .
      297     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      298   end.
      299   function cur-time-string-sec returns character
      300   :
      301     define variable v-date as date      no-undo .
      302     define variable v-time as integer   no-undo .
      303     run cur-time in this-procedure
      304       (output v-date
      305       ,output v-time
      306       ) .
      307     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      308   end.
      309   function cur-time-custom  returns character
      310   (input p-prefix as character
      311   ,input p-date-format as character
      312   ,input p-delimiter as character
      313   ,input p-time-format as character
      314   ,input p-suffix as character
      315   )
      316   :
      317     define variable v-date as date      no-undo .
      318     define variable v-time as integer   no-undo .
      319     run cur-time in this-procedure
      320       (output v-date
      321       ,output v-time
      322       ) .
      323     return
      324       p-prefix
      325       + string(v-date, p-date-format)
      326       + p-delimiter
      327       + string(v-time, p-time-format)
      328       + p-suffix
      329       .
      330   end.
      331   function cur-time-print  returns character
      332   :
      333     define variable v-date as date      no-undo .
      334     define variable v-time as integer   no-undo .
      335     run cur-time in this-procedure
      336       (output v-date
      337       ,output v-time
      338       ) .
      339     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      340   end.
      341   function cur-time-datetime returns datetime
      342   :
      343     define variable v-char as character no-undo .
      344     define variable v-datetime as datetime no-undo .
      345     v-char = cur-time-string().
      346     v-datetime = datetime(v-char).
      347     return  v-datetime.
      348   end.
      349   function cur-time-string-msec returns character
      350   :
      351     define variable v-date as datetime  no-undo .
      352     v-date = now.
      353     return string(v-date) .
      354   end.
      355   DEFINE BUTTON B-exit AUTO-GO
      356        LABEL "&Ввод"
      357        SIZE 10 BY 1
      358        BGCOLOR 8 .
      359   DEFINE BUTTON B-Help
      360        LABEL "Помо&щь"
      361        SIZE 10 BY 1
      362        BGCOLOR 8 .
      363   DEFINE BUTTON b-quit AUTO-END-KEY
      364        LABEL "&Отмена"
      365        SIZE 10 BY 1
      366        BGCOLOR 8 .
      367   DEFINE VARIABLE FILL-IN-8 AS CHARACTER FORMAT "X(256)":U INITIAL "Алгоритм включения в учетную цену"
      368         VIEW-AS TEXT
      369        SIZE 49 BY .67
      370        FGCOLOR 4  NO-UNDO.
      371   DEFINE QUERY Dialog-Frame FOR
      372         tt-gds-add-charges,
      373         buf_goods SCROLLING.
      374   DEFINE FRAME Dialog-Frame
      375        B-exit AT ROW 1 COL 1
      376        b-quit AT ROW 1 COL 11
      377        B-Help AT ROW 1 COL 88.5
      378        tt-gds-add-charges.cost-include AT ROW 6.25 COL 8 WIDGET-ID 6
      379             VIEW-AS TOGGLE-BOX
      380             SIZE 32.5 BY .83
      381        tt-gds-add-charges.algoritm AT ROW 8 COL 26.5 COLON-ALIGNED WIDGET-ID 8
      382             LABEL "Пропорционально"
      383             VIEW-AS COMBO-BOX INNER-LINES 5
      384             LIST-ITEM-PAIRS "сумме приходных цен","1",
      385                        "количеству(в баз. ед.изм.)","2",
      386                        "количеству(в пост. ед.изм.)","3",
      387                        "весу","4"
      388             DROP-DOWN
      389             SIZE 32.63 BY 1 TOOLTIP "Как включать дополнительные расходы в учетную цену"
      390        buf_goods.artic AT ROW 2 COL 24 COLON-ALIGNED
      391              VIEW-AS TEXT
      392             SIZE 17 BY .67
      393        buf_goods.prod-type AT ROW 2 COL 41.5 COLON-ALIGNED NO-LABEL
      394              VIEW-AS TEXT
      395             SIZE 4 BY .67
      396        buf_goods.prod-code AT ROW 2 COL 46 COLON-ALIGNED NO-LABEL
      397              VIEW-AS TEXT
      398             SIZE 10 BY .67
      399        buf_goods.gds-code AT ROW 2.75 COL 24 COLON-ALIGNED
      400             LABEL "Код услуги"
      401              VIEW-AS TEXT
      402             SIZE 10 BY .67
      403        buf_goods.gds-name AT ROW 3.75 COL 24 COLON-ALIGNED
      404             LABEL "Название доп.расхода"
      405              VIEW-AS TEXT
      406             SIZE 71.5 BY 1
      407             BGCOLOR 3 FGCOLOR 15
      408        FILL-IN-8 AT ROW 7.25 COL 9.75 COLON-ALIGNED NO-LABEL WIDGET-ID 10
      409        SPACE(37.75) SKIP(2.65)
      410       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      411            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      412            TITLE "Дополнительные расходы".
      413   ASSIGN
      414          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      415          FRAME Dialog-Frame:HIDDEN           = TRUE.
      416   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      417   DO:
      418     APPLY "END-ERROR":U TO SELF.
      419   END.
      420   ON VALUE-CHANGED OF tt-gds-add-charges.algoritm IN FRAME Dialog-Frame
      421   DO:
      422     ASSIGN tt-gds-add-charges.algoritm.
      423   END.
      424   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
      425   DO:
      426     run proc-save in this-procedure no-error.
      427     if error-status :error then return no-apply.
      428   END.
      429   ON VALUE-CHANGED OF tt-gds-add-charges.cost-include IN FRAME Dialog-Frame
      430   DO:
      431     ASSIGN tt-gds-add-charges.cost-include.
      432     IF tt-gds-add-charges.cost-include = TRUE THEN DO:
      433         ENABLE tt-gds-add-charges.algoritm WITH FRAME Dialog-Frame.
      434         DISPLAY FILL-IN-8 tt-gds-add-charges.algoritm WITH FRAME Dialog-Frame.
      435     END.
      436     ELSE DO:
      437       HIDE FILL-IN-8 tt-gds-add-charges.algoritm IN FRAME Dialog-Frame.
      438     END.
      439   END.
      440   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      441   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      442   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      443   on help of frame Dialog-Frame
      444   do:
      445     run gbl/app_help.p
      446       (input this-procedure :file-name
      447       ,input ''
      448       ,input ?
      449       ) no-error.
      450     if error-status :error then do:
      451       message
      452         "Ошибка при вызове помощи"
      453         error-status :get-message(1)
      454         view-as alert-box .
      455     end.
      456   end.
      457   run minbtn-set in this-procedure .
      458   on choose of b-help in frame Dialog-Frame
      459   do:
      460     apply "help":u to frame Dialog-Frame .
      461   end.
      462   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      463   procedure minbtn-set :
      464       do
      465           on error undo, return error return-value
      466           :
      467           define variable ii              as integer       no-undo .
      468           define variable fh              as widget-handle no-undo .
      469           define variable hh              as widget-handle no-undo .
      470           define variable v-h             as handle        extent 4 no-undo .
      471           define variable v-name-button   as character     no-undo .
      472           define variable v-help-old-x    as decimal       no-undo .
      473           define variable v-help-old-y    as decimal       no-undo .
      474           define variable v-help-old-size as decimal       no-undo .
      475           define variable v-frame-width   as decimal       no-undo .
      476           define variable jj              as integer       no-undo .
      477           do
      478               on error undo, return error
      479               :
      480               assign
      481                   v-frame-width = frame Dialog-Frame:width - 0.3
      482                   fh            = frame Dialog-Frame:first-child
      483                   hh            = fh:first-child
      484                   ii            = 1
      485                   .
      486               do while valid-handle(hh):
      487                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      488                   do:
      489                       case lc(hh:name) :
      490                           when "b-help" then
      491                               do:
      492                                   hh:load-image-up("cmp/b-help.bmp":u) .
      493                                   hh:load-image-down("cmp/b-help.bmp":u) .
      494                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      495                                   hh:TOOLTIP = "Помощь" .
      496                                   v-help-old-x = hh:column .
      497                                   v-help-old-y = hh:row    .
      498                                   v-help-old-size = hh:width .
      499                                   hh:width-chars = 2.5 .
      500                               end.
      501                           when "b-print" then
      502                               do:
      503                                   hh:load-image("cmp/b-print.bmp":u) .
      504                                   hh:TOOLTIP = "Печать" .
      505                                   v-h[ii] = hh:handle .
      506                                   ii = ii + 1 .
      507                                   hh:width-chars = 3 .
      508                               end.
      509                           when "b-history" or
      510                           when "b-hist" then
      511                               do:
      512                                   hh:load-image("cmp/b-hist.bmp":u) .
      513                                   hh:TOOLTIP = "История" .
      514                                   v-h[ii] = hh:handle .
      515                                   ii = ii + 1 .
      516                                   hh:width-chars = 3 .
      517                               end.
      518                           when "b-sch" then
      519                               do:
      520                                   hh:load-image("cmp/b-sch.bmp":u) .
      521                                   hh:TOOLTIP = "Установка Фильтра" .
      522                                   v-h[ii] = hh:handle .
      523                                   ii = ii + 1 .
      524                                   hh:width-chars = 3 .
      525                               end.
      526                           when "b-hist-user" then
      527                               do:
      528                                   hh:load-image("cmp/b-hist.bmp":u) .
      529                                   hh:TOOLTIP = "История пользователя" .
      530                                   ii = ii + 1 .
      531                               end.
      532                       end case.
      533                   end.
      534                   hh = hh:next-sibling.
      535               end.
      536               b-help:column = v-frame-width - b-help:width-chars.
      537               jj = 0.
      538               repeat ii = 4 to 1 by -1 :
      539                   if valid-handle (v-h[ii] ) then
      540                   do:
      541                       jj  = jj + 1 .
      542                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      543                       v-h[ii]:row    = v-help-old-y .
      544                   end.
      545               end.
      546           end.
      547       end.
      548   end procedure.
      549   MAIN-BLOCK:
      550   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      551      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      552     run init-proc no-error .
      553     if error-status :error then return error return-value .
      554     define variable v-user-name as character no-undo .
      555     run enable_ui.
      556     if p-mode = 'ПРОСМОТР':U then do:
      557         assign
      558           b-quit:label = "&Выход"
      559           b-quit:col = 1
      560         .
      561         disable
      562             tt-gds-add-charges.algoritm
      563             tt-gds-add-charges.cost-include  with frame Dialog-Frame.
      564         hide b-exit in frame Dialog-Frame.
      565     end.
      566   find first tt-gds-add-charges no-error .
      567   if error-status :error then message error-status :get-message(1) .
      568   enable
      569     b-exit when p-mode <> 'ПРОСМОТР':U
      570     b-quit
      571     b-help
      572     tt-gds-add-charges.algoritm  when p-mode <> 'ПРОСМОТР':U
      573     tt-gds-add-charges.cost-include         when p-mode <> 'ПРОСМОТР':U
      574    with frame dialog-frame.
      575   view frame dialog-frame.
      576     WAIT-FOR GO OF FRAME Dialog-Frame FOCUS tt-gds-add-charges.cost-include.
      577   END.
      578   run disable_ui.
      579   PROCEDURE disable_UI :
      580     HIDE FRAME Dialog-Frame.
      581   END PROCEDURE.
      582   PROCEDURE enable_UI :
      583     OPEN QUERY Dialog-Frame FOR EACH tt-gds-add-charges NO-LOCK,              EACH buf_goods          OF tt-gds-add-charges NO-LOCK.
      584     GET FIRST Dialog-Frame.
      585     DISPLAY FILL-IN-8
      586         WITH FRAME Dialog-Frame.
      587     IF AVAILABLE buf_goods THEN
      588       DISPLAY buf_goods.artic buf_goods.prod-type buf_goods.prod-code
      589             buf_goods.gds-code buf_goods.gds-name
      590         WITH FRAME Dialog-Frame.
      591     IF AVAILABLE tt-gds-add-charges THEN
      592       DISPLAY tt-gds-add-charges.cost-include tt-gds-add-charges.algoritm
      593         WITH FRAME Dialog-Frame.
      594     ENABLE B-exit b-quit B-Help tt-gds-add-charges.cost-include
      595            tt-gds-add-charges.algoritm buf_goods.artic buf_goods.prod-type
      596            buf_goods.prod-code buf_goods.gds-code buf_goods.gds-name FILL-IN-8
      597         WITH FRAME Dialog-Frame.
      598     VIEW FRAME Dialog-Frame.
      599   END PROCEDURE.
      600   PROCEDURE init-proc :
      601   define variable v-date as date no-undo .
      602   define variable v-time as integer no-undo .
      603   if p-mode = 'ПРОСМОТР':U then
      604      find first tt0-gds-add-charges no-lock where
      605                 tt0-gds-add-charges.gds-code =  p-gds-code
      606                 no-error .
      607   else
      608      find first tt0-gds-add-charges exclusive-lock  where
      609                 tt0-gds-add-charges.gds-code =  p-gds-code
      610                 no-error .
      611     if p-gds-code = 0 then do:
      612       if not available tt0-gds-add-charges then do:
      613          create tt0-gds-add-charges .
      614       end.
      615     end.
      616    for each tt-gds-add-charges : delete tt-gds-add-charges. end.
      617     CREATE tt-gds-add-charges.
      618     if available tt0-gds-add-charges then
      619        BUFFER-COPY tt0-gds-add-charges TO tt-gds-add-charges .
      620     else do:
      621       if p-mode = 'ПРОСМОТР':U then do:
      622           if p-gds-code = 0 then p-gds-code = 1.
      623           run cur-time in this-procedure(output v-date, output v-time).
      624           assign
      625             tt-gds-add-charges.algoritm           = ""
      626             tt-gds-add-charges.cost-include       = false
      627             tt-gds-add-charges.gds-code           = p-gds-code
      628           .
      629       end.
      630       else do:
      631       message "Значений нет в БД , будут установлены по умолчанию" view-as alert-box information .
      632       if p-gds-code = 0 then p-gds-code = 1.
      633       run cur-time in this-procedure(output v-date, output v-time).
      634       assign
      635         tt-gds-add-charges.algoritm           = "1"
      636         tt-gds-add-charges.cost-include       = true
      637         tt-gds-add-charges.gds-code           = p-gds-code
      638       .
      639       end.
      640     end.
      641   END PROCEDURE.
      642   PROCEDURE proc-save :
      643   define variable p-recid as recid no-undo.
      644   define variable v-ident as logical no-undo .
      645   if p-update-instantly then do:
      646       assign frame Dialog-Frame
      647       tt-gds-add-charges.algoritm
      648       tt-gds-add-charges.cost-include.
      649       run ref/adcharg1.p
      650           (input-output p-recid
      651           ,input tt-gds-add-charges.gds-code
      652           ,input tt-gds-add-charges.algoritm
      653           ,input tt-gds-add-charges.cost-include
      654           ) no-error .
      655       if error-status :error then  do:
      656           message error-status :get-message(1) return-value .
      657           return error return-value .
      658       end.
      659   END.
      660   ELSE DO:
      661      if not available tt0-gds-add-charges then
      662      create tt0-gds-add-charges.
      663       if p-mode = 'ДОБАВЛЕНИЕ':U then do:
      664         p-updated = yes.
      665       end.
      666       else do:
      667         if available tt0-gds-add-charges then do:
      668           buffer-compare tt0-gds-add-charges
      669           to
      670           tt-gds-add-charges save result in v-ident.
      671           assign
      672           p-updated = not v-ident.
      673         end.
      674         else do:
      675           if available tt-gds-add-charges then p-updated = yes.
      676         end.
      677       end.
      678      buffer-copy tt-gds-add-charges
      679      except gds-code
      680      to tt0-gds-add-charges
      681      .
      682   END.
      683   END PROCEDURE.
