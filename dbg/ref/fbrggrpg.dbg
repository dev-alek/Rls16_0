     1104   .
     1105   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1106   define variable v-waitfram-action01         as character   no-undo .
     1107   define variable v-waitfram-action02         as character   no-undo .
     1108   define variable v-waitfram-action03         as character   no-undo .
     1109   define variable mWaitFramTextBeg            as character   no-undo.
     1110   define variable mWaitFramTextEnd            as character   no-undo.
     1111   define variable mWaitFramView               as logical     no-undo.
     1112   define variable mWaitProcEvent              as logical     no-undo init yes.
     1113   define variable mWaitFramInterval           as integer     no-undo init 1 .
     1114   define variable mWaitFramStop               as logical     no-undo.
     1115   define variable mWaitFramStopUser           as logical     no-undo.
     1116   define variable mWaitFramStopTimeOut        as logical     no-undo.
     1117   define variable mWaitFramStartProc          as datetime-tz no-undo.
     1118   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
     1119   define button B-WaitFramStop auto-end-key
     1120        label "Стоп"
     1121        size 10 by 1 tooltip "Остоновить процесс".
     1122   define button B-viewProcInfo
     1123        label "Информация"
     1124        size 15 by 1 tooltip "Информация о процесс".
     1125   define frame waitfram
     1126     v-waitfram-action01 format "x(72)" no-label skip
     1127     v-waitfram-action02 format "x(72)" no-label skip
     1128     v-waitfram-action03 format "x(72)" no-label skip
     1129     B-viewProcInfo
     1130     B-WaitFramStop at row 4 col 30
     1131     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     1132     .
     1133   define new global shared variable mBatchMode as logical no-undo init ?.
     1134   define variable mFramBachModHandle as handle no-undo.
     1135   mFramBachModHandle = frame waitfram:handle.
     1136   define variable mFameOldVis as logical no-undo.
     1137   define variable mVisCUrentVin as logical no-undo.
     1138   if session:batch-mode
     1139   then
     1140      mBatchMode = yes.
     1141   if mBatchMode = ? then do:
     1142     mVisCUrentVin = current-window:visible.
     1143     mFameOldVis = mFramBachModHandle:visible.
     1144     mFramBachModHandle:visible  = yes.
     1145     mBatchMode = mFramBachModHandle:visible ne yes.
     1146     mFramBachModHandle:visible = mFameOldVis.
     1147     current-window:visible = mVisCUrentVin.
     1148   end.
     1149    if  log-manager:logfile-name ne ?
     1150     then DO:
     1151         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1152         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1153         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     1154     end.
     1155   on choose of B-WaitFramStop in frame waitfram
     1156   do:
     1157     mWaitFramStop = yes.
     1158     mWaitFramStopUser = yes.
     1159   end.
     1160   function waitfram-check-timeout returns logical():
     1161      define variable vtime as int64 no-undo.
     1162      if mWaitFramStopTimeOut
     1163      then
     1164         return yes.
     1165      vtime = ( now - mWaitFramStartProc ) / 1000 .
     1166      if     mWaitFramTimeOut ne ?
     1167         and mWaitFramTimeOut ne 0
     1168         and mWaitFramTimeOut lt vtime
     1169      then do:
     1170         mWaitFramStopTimeOut = yes.
     1171      end.
     1172      return mWaitFramStopTimeOut.
     1173   end.
     1174   procedure waitfram-hide :
     1175     if not session:batch-mode
     1176     then do
     1177     on error undo, return error return-value
     1178     :
     1179       pause 0 before-hide .
     1180       if not mBatchMode then
     1181         hide frame waitfram .
     1182     if     not mWaitFramView
     1183        and mWaitProcEvent
     1184     then
     1185       process events .
     1186     end.
     1187   end procedure.
     1188   procedure waitfram-show :
     1189     define input  parameter p-message as character no-undo .
     1190     define variable v-left-margin as integer   no-undo .
     1191     if not session:batch-mode
     1192     then do
     1193     on error undo, return error return-value
     1194     :
     1195       if length(p-message) <= 70 then do:
     1196         assign
     1197           v-left-margin = integer((70 - length(p-message)) / 2)
     1198         .
     1199         assign
     1200           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     1201         .
     1202         assign
     1203           v-waitfram-action01 = " "
     1204           v-waitfram-action02 = " "
     1205                                    + fill(" ", v-left-margin)
     1206                                    + p-message
     1207           v-waitfram-action03 = " "
     1208         .
     1209       end.
     1210       else do:
     1211         define variable vRindex1 as integer no-undo.
     1212         define variable vRindex2 as integer no-undo.
     1213         vRindex1 = r-index(p-message," ",70).
     1214         if vRindex1 = 0
     1215         then
     1216            vRindex1 = 70.
     1217         if length(p-message)  <= vRindex1 + 70 then do:
     1218           assign
     1219             v-waitfram-action01 = " "
     1220             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     1221             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     1222           .
     1223         end.
     1224         else do:
     1225           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     1226           if vRindex2 <= vRindex1
     1227           then
     1228              vRindex2 = vRindex1 + 70.
     1229           assign
     1230             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     1231             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     1232             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     1233           .
     1234         end.
     1235       end.
     1236       B-viewProcInfo:visible   in frame waitfram = no.
     1237       B-viewProcInfo:sensitive in frame waitfram = no.
     1238       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1239       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1240       if  (   mWaitFramView
     1241          or  mWaitProcEvent)
     1242          and not mBatchMode
     1243       then
     1244          display
     1245             v-waitfram-action01 skip
     1246             v-waitfram-action02 skip
     1247             v-waitfram-action03 skip
     1248          with frame waitfram .
     1249       if     mWaitFramView
     1250          then do:
     1251             if     mWaitFramInterval ne ?
     1252                and not mBatchMode
     1253             then
     1254                wait-for go of frame waitfram pause mWaitFramInterval.
     1255          end.
     1256          else
     1257             if     mWaitProcEvent
     1258                and not mBatchMode
     1259             then
     1260                process events .
     1261     end.
     1262   end procedure.
     1263      procedure waitfram-show-this:
     1264         define input  parameter iInterval as int64 no-undo.
     1265         define variable vtime as int64 no-undo.
     1266         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1267         mWaitFramInterval = iInterval.
     1268         run waitfram-show (substitute("&1&2 &3&4" ,
     1269                                       mWaitFramTextBeg ,
     1270                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1271                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1272                                       mWaitFramTextEnd
     1273                                      )
     1274                           ).
     1275      end.
     1276      procedure WaitFramRunPause:
     1277         define input  parameter iInterval as dec no-undo.
     1278         define variable vStart  as datetime-tz no-undo.
     1279         define variable vend    as datetime-tz no-undo.
     1280         define variable vint as int64 no-undo.
     1281         define variable vOk as logical no-undo.
     1282         vStart = now.
     1283         vend   = vStart.
     1284         publish "WaitFramPause" (iInterval,output vOk).
     1285         vend   =  now.
     1286         vint = vend - vStart.
     1287         vint = iInterval - vint / 1000.
     1288         if     not mWaitFramStop
     1289            and (   vint > 0
     1290                 or (    not vOk
     1291                     and iInterval eq ?
     1292                     )
     1293                 )
     1294         then
     1295            run waitfram-show-this (iInterval).
     1296         vend   =  now.
     1297         vint = vend - vStart.
     1298         vint = iInterval - vint / 1000.
     1299         if     not mWaitFramStop
     1300            and vint > 0
     1301         then do:
     1302            run gbl/pause.p (vint * 1000).
     1303         end.
     1304         if iInterval ne ?
     1305         then
     1306            publish "WaitFramStop".
     1307         waitfram-check-timeout().
     1308      end.
     1309      procedure WaitFramWaitFor:
     1310         define input  parameter iInterval as dec no-undo.
     1311         assign
     1312            mWaitFramStartProc   = now
     1313            mWaitFramStopUser    = no
     1314            mWaitFramStopTimeOut = no
     1315         .
     1316         block-wait:
     1317         do while not mWaitFramStop:
     1318            run WaitFramRunPause (iInterval).
     1319            if  waitfram-check-timeout()
     1320            then do:
     1321               leave block-wait.
     1322            end.
     1323         end.
     1324         run waitfram-hide.
     1325      end.
     1326   procedure waitfram-join :
     1327     define input  parameter p-line-1  as character no-undo .
     1328     define input  parameter p-line-2  as character no-undo .
     1329     define input  parameter p-line-3  as character no-undo .
     1330     define output parameter p-message as character no-undo .
     1331     do
     1332     on error undo, return error return-value
     1333     :
     1334       assign
     1335         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1336                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1337                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1338       .
     1339     end.
     1340   end procedure.
     1341   function waitfram-join-function returns character
     1342     (input p-line-1 as character
     1343     ,input p-line-2 as character
     1344     ,input p-line-3 as character
     1345     ).
     1346     define variable v-message as character no-undo .
     1347     run waitfram-join in this-procedure
     1348       (input  p-line-1
     1349       ,input  p-line-2
     1350       ,input  p-line-3
     1351       ,output v-message
     1352       ) .
     1353     return v-message .
     1354   end function .
     1355   DEFINE BUTTON b-add
     1356        LABEL "&Добавить"
     1357        SIZE 10 BY 1.
     1358   DEFINE BUTTON b-del
     1359        LABEL "&Удалить"
     1360        SIZE 10 BY 1.
     1361   DEFINE BUTTON b-exit
     1362        LABEL "&Выход"
     1363        SIZE 10 BY 1
     1364        BGCOLOR 8 .
     1365   DEFINE BUTTON b-help
     1366        LABEL "Помощ&ь"
     1367        SIZE 3 BY 1
     1368        BGCOLOR 8 .
     1369   DEFINE QUERY br-table FOR
     1370         ub.fbr-gds-obj,
     1371         ub.goods SCROLLING.
     1372   DEFINE BROWSE br-table
     1373     QUERY br-table NO-LOCK DISPLAY
     1374         ub.goods.gds-code FORMAT "999999999":U
     1375         ub.goods.artic FORMAT "X(16)":U
     1376         goods.prod-type +  STRING (goods.prod-code) COLUMN-LABEL "Производитель" FORMAT "X(15)":U
     1377         ub.goods.gds-name FORMAT "X(48)":U
     1378         ub.goods.unit-base FORMAT "X(3)":U
     1379         ub.goods.grp-name COLUMN-LABEL "Группа" FORMAT "X(40)":U
     1380       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 17.7.
     1381   DEFINE FRAME Dialog-Frame
     1382        b-exit AT ROW 1 COL 1
     1383        b-add AT ROW 1 COL 11
     1384        b-del AT ROW 1 COL 21
     1385        b-help AT ROW 1 COL 95
     1386        br-table AT ROW 2 COL 1
     1387        SPACE(0.09) SKIP(0.66)
     1388       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1389            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1390            TITLE "Товары для группы блюд"
     1391            DEFAULT-BUTTON b-exit.
     1392   ASSIGN
     1393          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1394          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1395   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1396   DO:
     1397     APPLY "END-ERROR":U TO SELF.
     1398   END.
     1399   ON CHOOSE OF b-add IN FRAME Dialog-Frame
     1400   DO:
     1401       run add-goods in this-procedure (
     1402           input p-node-code
     1403       ) no-error .
     1404       if error-status :error
     1405       then do:
     1406           message
     1407           vss-workfile vss-revision vss-description
     1408           skip "Ошибка добавления товаров в группу блюд."
     1409           skip return-value
     1410           skip trim(error-status :get-message(1))
     1411           trim(error-status :get-message(2))
     1412           trim(error-status :get-message(3))
     1413           trim(error-status :get-message(4))
     1414           trim(error-status :get-message(5))
     1415           view-as alert-box error.
     1416           undo, return no-apply .
     1417       end.
     1418       OPEN QUERY br-table FOR EACH ub.fbr-gds-obj       WHERE fbr-gds-obj.obj-type = p-store-type  AND fbr-gds-obj.obj-code = p-store-code  AND fbr-gds-obj.fbr-grp-code = p-node-code NO-LOCK,       EACH ub.goods OF ub.fbr-gds-obj NO-LOCK.
     1419   END.
     1420   ON CHOOSE OF b-del IN FRAME Dialog-Frame
     1421   DO:
     1422       if available ub.fbr-gds-obj
     1423       then do:
     1424           run unattach-goods in this-procedure (
     1425                 input fbr-gds-obj.obj-type
     1426               , input fbr-gds-obj.obj-code
     1427               , input fbr-gds-obj.gds-code
     1428           ) no-error .
     1429           if error-status :error
     1430           then do:
     1431               message
     1432                   vss-workfile vss-revision vss-description
     1433                   skip "Ошибка удаления записи."
     1434                   skip return-value
     1435                   skip trim(error-status :get-message(1))
     1436                   trim(error-status :get-message(2))
     1437                   trim(error-status :get-message(3))
     1438               view-as alert-box error.
     1439               undo, return no-apply .
     1440           end.
     1441           OPEN QUERY br-table FOR EACH ub.fbr-gds-obj       WHERE fbr-gds-obj.obj-type = p-store-type  AND fbr-gds-obj.obj-code = p-store-code  AND fbr-gds-obj.fbr-grp-code = p-node-code NO-LOCK,       EACH ub.goods OF ub.fbr-gds-obj NO-LOCK.
     1442       end.
     1443   END.
     1444   ON CHOOSE OF b-exit IN FRAME Dialog-Frame
     1445   DO:
     1446       assign
     1447           p-cancel = no
     1448       .
     1449       apply "WINDOW-CLOSE" TO FRAME Dialog-Frame .
     1450   END.
     1451   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1452   on help of frame Dialog-Frame
     1453   do:
     1454     run gbl/app_help.p
     1455       (input this-procedure :file-name
     1456       ,input ''
     1457       ,input ?
     1458       ) no-error.
     1459     if error-status :error then do:
     1460       message
     1461         "Ошибка при вызове помощи"
     1462         error-status :get-message(1)
     1463         view-as alert-box .
     1464     end.
     1465   end.
     1466   run minbtn-set in this-procedure .
     1467   on choose of b-help in frame Dialog-Frame
     1468   do:
     1469     apply "help":u to frame Dialog-Frame .
     1470   end.
     1471   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1472   procedure minbtn-set :
     1473       do
     1474           on error undo, return error return-value
     1475           :
     1476           define variable ii              as integer       no-undo .
     1477           define variable fh              as widget-handle no-undo .
     1478           define variable hh              as widget-handle no-undo .
     1479           define variable v-h             as handle        extent 4 no-undo .
     1480           define variable v-name-button   as character     no-undo .
     1481           define variable v-help-old-x    as decimal       no-undo .
     1482           define variable v-help-old-y    as decimal       no-undo .
     1483           define variable v-help-old-size as decimal       no-undo .
     1484           define variable v-frame-width   as decimal       no-undo .
     1485           define variable jj              as integer       no-undo .
     1486           do
     1487               on error undo, return error
     1488               :
     1489               assign
     1490                   v-frame-width = frame Dialog-Frame:width - 0.3
     1491                   fh            = frame Dialog-Frame:first-child
     1492                   hh            = fh:first-child
     1493                   ii            = 1
     1494                   .
     1495               do while valid-handle(hh):
     1496                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1497                   do:
     1498                       case lc(hh:name) :
     1499                           when "b-help" then
     1500                               do:
     1501                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1502                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1503                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1504                                   hh:TOOLTIP = "Помощь" .
     1505                                   v-help-old-x = hh:column .
     1506                                   v-help-old-y = hh:row    .
     1507                                   v-help-old-size = hh:width .
     1508                                   hh:width-chars = 2.5 .
     1509                               end.
     1510                           when "b-print" then
     1511                               do:
     1512                                   hh:load-image("cmp/b-print.bmp":u) .
     1513                                   hh:TOOLTIP = "Печать" .
     1514                                   v-h[ii] = hh:handle .
     1515                                   ii = ii + 1 .
     1516                                   hh:width-chars = 3 .
     1517                               end.
     1518                           when "b-history" or
     1519                           when "b-hist" then
     1520                               do:
     1521                                   hh:load-image("cmp/b-hist.bmp":u) .
     1522                                   hh:TOOLTIP = "История" .
     1523                                   v-h[ii] = hh:handle .
     1524                                   ii = ii + 1 .
     1525                                   hh:width-chars = 3 .
     1526                               end.
     1527                           when "b-sch" then
     1528                               do:
     1529                                   hh:load-image("cmp/b-sch.bmp":u) .
     1530                                   hh:TOOLTIP = "Установка Фильтра" .
     1531                                   v-h[ii] = hh:handle .
     1532                                   ii = ii + 1 .
     1533                                   hh:width-chars = 3 .
     1534                               end.
     1535                           when "b-hist-user" then
     1536                               do:
     1537                                   hh:load-image("cmp/b-hist.bmp":u) .
     1538                                   hh:TOOLTIP = "История пользователя" .
     1539                                   ii = ii + 1 .
     1540                               end.
     1541                       end case.
     1542                   end.
     1543                   hh = hh:next-sibling.
     1544               end.
     1545               b-help:column = v-frame-width - b-help:width-chars.
     1546               jj = 0.
     1547               repeat ii = 4 to 1 by -1 :
     1548                   if valid-handle (v-h[ii] ) then
     1549                   do:
     1550                       jj  = jj + 1 .
     1551                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1552                       v-h[ii]:row    = v-help-old-y .
     1553                   end.
     1554               end.
     1555           end.
     1556       end.
     1557   end procedure.
     1558   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1559   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1560   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1561   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1562   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1563   define variable v-diasize-current-frame-height as decimal   no-undo .
     1564   define variable v-diasize-change-size          as logical   no-undo .
     1565   define variable v-diasize-resize-button        as handle    no-undo .
     1566   define variable v-diasize-wndmax               as logical   no-undo .
     1567   define variable v-diasize-wndstore             as logical   no-undo .
     1568   define variable v-diasize-proc-name            as character no-undo .
     1569   define variable v-diasize-browse-handle        as handle    no-undo .
     1570   define variable v-diasize-browse-number        as integer   no-undo .
     1571   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1572   define temp-table temp-diasize-handle no-undo
     1573     field handle-value  as handle
     1574     field save-position as decimal
     1575     index xpk is primary unique handle-value
     1576     .
     1577   define temp-table temp-browse-handle no-undo
     1578     field browse-type   as character
     1579     field browse-number as integer
     1580     field browse-handle as handle
     1581     field original-size as decimal
     1582     index xpk is primary unique browse-type browse-number
     1583     index xie browse-type browse-handle
     1584   .
     1585   procedure diasize_change-height :
     1586     define input  parameter p-change-value  as decimal   no-undo .
     1587     define input  parameter p-move-resize   as logical   no-undo .
     1588     define variable v-field-group-handle    as handle    no-undo .
     1589     define variable v-object-handle         as handle    no-undo .
     1590     define variable v-frame-height          as decimal   no-undo .
     1591     define variable v-frame-virtual-height  as decimal   no-undo .
     1592     define variable v-browse-height         as decimal   no-undo .
     1593     define variable v-window-height         as decimal   no-undo .
     1594     define variable v-window-virtual-height as decimal   no-undo .
     1595     define variable v-change-sign           as integer   no-undo .
     1596     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1597     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1598     if p-change-value > 0
     1599     then do:
     1600       if frame Dialog-Frame :height + p-change-value
     1601           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1602       then do:
     1603         assign
     1604           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1605                           - (frame Dialog-Frame :height-chars)
     1606         .
     1607         if p-change-value <= 0
     1608         then do:
     1609           run diasize_position-resize-button in this-procedure .
     1610           return .
     1611         end.
     1612       end.
     1613     end.
     1614     if p-change-value < 0
     1615     then do:
     1616       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1617       then do:
     1618         assign
     1619           p-change-value = v-diasize-orig-frame-height
     1620                          - (frame Dialog-Frame :height-chars)
     1621         .
     1622         if p-change-value >= 0
     1623         then do:
     1624           run diasize_position-resize-button in this-procedure .
     1625           return .
     1626         end.
     1627       end.
     1628     end.
     1629     if p-change-value >= 0
     1630     then do:
     1631       assign
     1632         v-change-sign = 1
     1633       .
     1634     end.
     1635     else do:
     1636       assign
     1637         v-change-sign = -1
     1638       .
     1639     end.
     1640     assign
     1641       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1642     .
     1643     if p-change-value = 0
     1644     then do:
     1645       run diasize_position-resize-button in this-procedure .
     1646       return .
     1647     end.
     1648     move_block:
     1649     do
     1650     on error undo move_block, retry move_block
     1651     :
     1652       if retry
     1653       then do:
     1654         do
     1655         on error undo move_block, leave move_block
     1656         :
     1657           if p-change-value > 0
     1658           then do:
     1659             for each buf_temp-diasize-handle
     1660             on error undo, next
     1661             :
     1662               assign
     1663                 v-object-handle = buf_temp-diasize-handle.handle-value
     1664               .
     1665               if v-object-handle <> v-diasize-resize-button
     1666               then do:
     1667                 assign
     1668                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1669                 .
     1670               end.
     1671             end.
     1672             assign
     1673               v-diasize-browse-handle :height = v-browse-height
     1674             .
     1675             for each buf_temp-browse-handle
     1676               where buf_temp-browse-handle.browse-type = 'height':u
     1677             on error undo, next
     1678             :
     1679               assign
     1680                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1681               .
     1682             end.
     1683             assign
     1684               frame Dialog-Frame :height = v-frame-height
     1685             .
     1686             if frame Dialog-Frame :scrollable = true
     1687             then do:
     1688               assign
     1689                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1690               .
     1691             end.
     1692             run diasize_position-resize-button in this-procedure .
     1693           end.
     1694           else do:
     1695             if frame Dialog-Frame :scrollable = true
     1696             then do:
     1697               assign
     1698                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1699               .
     1700             end.
     1701             assign
     1702               frame Dialog-Frame :height = v-frame-height
     1703             .
     1704             assign
     1705               v-diasize-browse-handle :height = v-browse-height
     1706             .
     1707             for each buf_temp-browse-handle
     1708               where buf_temp-browse-handle.browse-type = 'height':u
     1709             on error undo, next
     1710             :
     1711               assign
     1712                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1713               .
     1714             end.
     1715             for each buf_temp-diasize-handle
     1716             on error undo, next
     1717             :
     1718               assign
     1719                 v-object-handle = buf_temp-diasize-handle.handle-value
     1720               .
     1721               if v-object-handle <> v-diasize-resize-button
     1722               then do:
     1723                 assign
     1724                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1725                 .
     1726               end.
     1727             end.
     1728             run diasize_position-resize-button in this-procedure .
     1729           end.
     1730           assign
     1731             v-diasize-change-size = false
     1732           .
     1733           leave move_block .
     1734         end.
     1735       end.
     1736       assign
     1737         v-diasize-need-full-display = true
     1738       .
     1739       if v-diasize-change-size = false
     1740       then do:
     1741         assign
     1742           v-diasize-change-size = true
     1743         .
     1744       end.
     1745       else do:
     1746         return .
     1747       end.
     1748       assign
     1749         v-frame-height = frame Dialog-Frame :height
     1750         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1751         v-browse-height = v-diasize-browse-handle :height
     1752       .
     1753       for each buf_temp-browse-handle
     1754         where buf_temp-browse-handle.browse-type = 'height':u
     1755       :
     1756         assign
     1757           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1758         .
     1759       end.
     1760       for each buf_temp-diasize-handle
     1761       :
     1762         delete buf_temp-diasize-handle .
     1763       end.
     1764       assign
     1765         v-field-group-handle = frame Dialog-Frame :first-child
     1766       .
     1767       do while valid-handle(v-field-group-handle)
     1768       :
     1769         assign
     1770           v-object-handle = v-field-group-handle :first-child
     1771         .
     1772         do while valid-handle(v-object-handle)
     1773         :
     1774           if  v-object-handle <> v-diasize-browse-handle :handle
     1775           and can-query(v-object-handle, "row")
     1776           and can-query(v-object-handle, "height")
     1777           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1778           then do:
     1779             find first buf_temp-browse-handle
     1780               where buf_temp-browse-handle.browse-type   = 'height':u
     1781                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1782               no-error .
     1783             if available buf_temp-browse-handle
     1784             then do:
     1785             end.
     1786             else do:
     1787               create buf_temp-diasize-handle .
     1788               assign
     1789                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1790                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1791               .
     1792             end.
     1793           end.
     1794           assign
     1795             v-object-handle = v-object-handle :next-sibling
     1796           .
     1797         end.
     1798         assign
     1799           v-field-group-handle = v-field-group-handle :next-sibling
     1800         .
     1801       end.
     1802       do with frame Dialog-Frame
     1803       :
     1804         hide v-diasize-resize-button .
     1805         assign
     1806           v-diasize-resize-button :row    = 1
     1807           v-diasize-resize-button :column = 1
     1808         .
     1809       end.
     1810       if p-change-value > 0
     1811       then do:
     1812         if frame Dialog-Frame :scrollable = true
     1813         then do:
     1814           assign
     1815             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1816             no-error .
     1817           if error-status :error
     1818           or error-status :get-message(1) <> ""
     1819           then do:
     1820             undo move_block, retry move_block .
     1821           end.
     1822         end.
     1823         assign
     1824           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1825           no-error .
     1826         if error-status :error
     1827         or error-status :get-message(1) <> ""
     1828         then do:
     1829           undo move_block, retry move_block .
     1830         end.
     1831         assign
     1832           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1833           no-error .
     1834         if error-status :error
     1835         or error-status :get-message(1) <> ""
     1836         then do:
     1837           undo move_block, retry move_block .
     1838         end.
     1839         for each buf_temp-browse-handle
     1840           where buf_temp-browse-handle.browse-type = 'height':u
     1841         on error undo move_block, retry move_block
     1842         :
     1843           assign
     1844             buf_temp-browse-handle.browse-handle :height
     1845               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1846             no-error .
     1847           if error-status :error
     1848           or error-status :get-message(1) <> ""
     1849           then do:
     1850             undo move_block, retry move_block .
     1851           end.
     1852         end.
     1853         for each buf_temp-diasize-handle
     1854         on error undo move_block, retry move_block
     1855         :
     1856           assign
     1857             v-object-handle = buf_temp-diasize-handle.handle-value
     1858           .
     1859           if v-object-handle <> v-diasize-resize-button
     1860           then do:
     1861             assign
     1862               v-object-handle :row = v-object-handle :row + p-change-value
     1863               no-error .
     1864             if error-status :error
     1865             or error-status :get-message(1) <> ""
     1866             then do:
     1867               undo move_block, retry move_block .
     1868             end.
     1869           end.
     1870         end.
     1871       end.
     1872       else do:
     1873         for each buf_temp-diasize-handle
     1874         on error undo move_block, retry move_block
     1875         :
     1876           assign
     1877             v-object-handle = buf_temp-diasize-handle.handle-value
     1878           .
     1879           if v-object-handle <> v-diasize-resize-button
     1880           then do:
     1881             assign
     1882               v-object-handle :row = v-object-handle :row + p-change-value
     1883               no-error .
     1884             if error-status :error
     1885             or error-status :get-message(1) <> ""
     1886             then do:
     1887               undo move_block, retry move_block .
     1888             end.
     1889           end.
     1890         end.
     1891         assign
     1892           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1893           no-error .
     1894         if error-status :error
     1895         or error-status :get-message(1) <> ""
     1896         then do:
     1897           undo move_block, retry move_block .
     1898         end.
     1899         for each buf_temp-browse-handle
     1900           where buf_temp-browse-handle.browse-type = 'height':u
     1901         on error undo move_block, retry move_block
     1902         :
     1903           assign
     1904             buf_temp-browse-handle.browse-handle :height
     1905               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1906             no-error .
     1907           if error-status :error
     1908           or error-status :get-message(1) <> ""
     1909           then do:
     1910             undo move_block, retry move_block .
     1911           end.
     1912         end.
     1913         assign
     1914           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1915           no-error .
     1916         if error-status :error
     1917         or error-status :get-message(1) <> ""
     1918         then do:
     1919           undo move_block, retry move_block .
     1920         end.
     1921         if frame Dialog-Frame :scrollable = true
     1922         then do:
     1923           assign
     1924             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1925             no-error .
     1926           if error-status :error
     1927           or error-status :get-message(1) <> ""
     1928           then do:
     1929             undo move_block, retry move_block .
     1930           end.
     1931         end.
     1932       end.
     1933       if p-move-resize = true
     1934       then do:
     1935         run diasize_position-resize-button in this-procedure .
     1936       end.
     1937       if v-diasize-wndstore = true
     1938       then do:
     1939         if connected("ub") = true
     1940         then do:
     1941           define variable v-cntxt-db-num        as integer   no-undo .
     1942           define variable v-cntxt-userid        as character no-undo .
     1943           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1944                                             , OUTPUT v-cntxt-userid
     1945                                             ) .
     1946           run gbl/wndsizew.p
     1947             (input  v-cntxt-db-num
     1948             ,input  v-cntxt-userid
     1949             ,input  v-diasize-proc-name
     1950             ,input  'height':u
     1951             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1952             ) .
     1953         end.
     1954       end.
     1955     end.
     1956     assign
     1957       v-diasize-change-size = false
     1958     .
     1959   end procedure.
     1960   procedure diasize_set-height :
     1961     define input  parameter p-new-height  as decimal   no-undo .
     1962     define input  parameter p-move-resize as logical   no-undo .
     1963     do
     1964     on error undo, return error return-value
     1965     :
     1966       run diasize_change-height in this-procedure
     1967         (input  (p-new-height - frame Dialog-Frame :height)
     1968         ,input  p-move-resize
     1969         ) .
     1970     end.
     1971   end procedure.
     1972   procedure diasize_change-width :
     1973     define input  parameter p-change-value as decimal   no-undo .
     1974     define input  parameter p-move-resize  as logical   no-undo .
     1975     define variable v-field-group-handle   as handle    no-undo .
     1976     define variable v-object-handle        as handle    no-undo .
     1977     define variable v-frame-width          as decimal   no-undo .
     1978     define variable v-frame-virtual-width  as decimal   no-undo .
     1979     define variable v-browse-width         as decimal   no-undo .
     1980     define variable v-window-width         as decimal   no-undo .
     1981     define variable v-window-virtual-width as decimal   no-undo .
     1982     define variable v-change-sign          as integer   no-undo .
     1983     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1984     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1985     if p-change-value > 0
     1986     then do:
     1987       if frame Dialog-Frame :width + p-change-value >
     1988           session :width-chars
     1989       then do:
     1990         assign
     1991           p-change-value = session :width-chars - frame Dialog-Frame :width
     1992         .
     1993         if p-change-value <= 0
     1994         then do:
     1995           run diasize_position-resize-button in this-procedure .
     1996           return .
     1997         end.
     1998       end.
     1999     end.
     2000     if p-change-value < 0
     2001     then do:
     2002       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     2003       then do:
     2004         assign
     2005           p-change-value = v-diasize-orig-frame-width
     2006                          - frame Dialog-Frame :width
     2007         .
     2008         if p-change-value >= 0
     2009         then do:
     2010           run diasize_position-resize-button in this-procedure .
     2011           return .
     2012         end.
     2013       end.
     2014     end.
     2015     if p-change-value >= 0
     2016     then do:
     2017       assign
     2018         v-change-sign = 1
     2019       .
     2020     end.
     2021     else do:
     2022       assign
     2023         v-change-sign = -1
     2024       .
     2025     end.
     2026     assign
     2027       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2028     .
     2029     if p-change-value = 0
     2030     then do:
     2031       run diasize_position-resize-button in this-procedure .
     2032       return .
     2033     end.
     2034     move_block:
     2035     do
     2036     on error undo move_block, leave move_block
     2037     :
     2038       if retry
     2039       then do:
     2040         do
     2041         on error undo move_block, leave move_block
     2042         :
     2043           if p-change-value > 0
     2044           then do:
     2045             for each buf_temp-diasize-handle
     2046             on error undo, next
     2047             :
     2048               assign
     2049                 v-object-handle = buf_temp-diasize-handle.handle-value
     2050               .
     2051               if v-object-handle <> v-diasize-resize-button
     2052               then do:
     2053                 assign
     2054                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2055                 .
     2056               end.
     2057             end.
     2058             assign
     2059               v-diasize-browse-handle :width = v-browse-width
     2060             .
     2061             for each buf_temp-browse-handle
     2062               where buf_temp-browse-handle.browse-type = 'width':u
     2063             on error undo, next
     2064             :
     2065               assign
     2066                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2067               .
     2068             end.
     2069             assign
     2070               frame Dialog-Frame :width = v-frame-width
     2071             .
     2072             if frame Dialog-Frame :scrollable = true
     2073             then do:
     2074               assign
     2075                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2076               .
     2077             end.
     2078             run diasize_position-resize-button in this-procedure .
     2079           end.
     2080           else do:
     2081             if frame Dialog-Frame :scrollable = true
     2082             then do:
     2083               assign
     2084                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2085               .
     2086             end.
     2087             assign
     2088               frame Dialog-Frame :width = v-frame-width
     2089             .
     2090             for each buf_temp-browse-handle
     2091               where buf_temp-browse-handle.browse-type = 'width':u
     2092             on error undo, next
     2093             :
     2094               assign
     2095                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2096               .
     2097             end.
     2098             assign
     2099               v-diasize-browse-handle :width = v-browse-width
     2100             .
     2101             for each buf_temp-diasize-handle
     2102             on error undo, next
     2103             :
     2104               assign
     2105                 v-object-handle = buf_temp-diasize-handle.handle-value
     2106               .
     2107               if v-object-handle <> v-diasize-resize-button
     2108               then do:
     2109                 assign
     2110                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2111                 .
     2112               end.
     2113             end.
     2114             run diasize_position-resize-button in this-procedure .
     2115           end.
     2116           assign
     2117             v-diasize-change-size = false
     2118           .
     2119           leave move_block .
     2120         end.
     2121       end.
     2122       assign
     2123         v-diasize-need-full-display = true
     2124       .
     2125       if v-diasize-change-size = false
     2126       then do:
     2127         assign
     2128           v-diasize-change-size = true
     2129         .
     2130       end.
     2131       else do:
     2132         return .
     2133       end.
     2134       assign
     2135         v-frame-width = frame Dialog-Frame :width
     2136         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     2137         v-browse-width = v-diasize-browse-handle :width
     2138       .
     2139       for each buf_temp-browse-handle
     2140         where buf_temp-browse-handle.browse-type = 'width':u
     2141       :
     2142         assign
     2143           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2144         .
     2145       end.
     2146       for each buf_temp-diasize-handle
     2147       :
     2148         delete buf_temp-diasize-handle .
     2149       end.
     2150       assign
     2151         v-field-group-handle = frame Dialog-Frame :first-child
     2152       .
     2153       do while valid-handle(v-field-group-handle)
     2154       :
     2155         assign
     2156           v-object-handle = v-field-group-handle :first-child
     2157         .
     2158         do while valid-handle(v-object-handle)
     2159         :
     2160           if  v-object-handle <> v-diasize-browse-handle :handle
     2161           and v-object-handle <> v-diasize-resize-button
     2162           and can-query(v-object-handle, "row")
     2163           and can-query(v-object-handle, "height")
     2164           and ( v-object-handle :col + v-object-handle :width
     2165                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2166               )
     2167           then do:
     2168             find first buf_temp-browse-handle
     2169               where buf_temp-browse-handle.browse-type   = 'width':u
     2170                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2171               no-error .
     2172             if available buf_temp-browse-handle
     2173             then do:
     2174             end.
     2175             else do:
     2176               create buf_temp-diasize-handle .
     2177               assign
     2178                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2179                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2180               .
     2181             end.
     2182           end.
     2183           assign
     2184             v-object-handle = v-object-handle :next-sibling
     2185           .
     2186         end.
     2187         assign
     2188           v-field-group-handle = v-field-group-handle :next-sibling
     2189         .
     2190       end.
     2191       do with frame Dialog-Frame
     2192       :
     2193         hide v-diasize-resize-button .
     2194         v-diasize-resize-button :row = 1.
     2195         v-diasize-resize-button :column = 1.
     2196       end.
     2197       if p-change-value > 0
     2198       then do:
     2199         if frame Dialog-Frame :scrollable = true
     2200         then do:
     2201           assign
     2202             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2203             no-error .
     2204           if error-status :error
     2205           or error-status :get-message(1) <> ""
     2206           then do:
     2207             undo move_block, retry move_block.
     2208           end.
     2209         end.
     2210         assign
     2211           frame Dialog-Frame :width = v-frame-width + p-change-value
     2212           no-error .
     2213         if error-status :error
     2214         or error-status :get-message(1) <> ""
     2215         then do:
     2216           undo move_block, retry move_block.
     2217         end.
     2218         assign
     2219           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2220         no-error .
     2221         if error-status :error
     2222         or error-status :get-message(1) <> ""
     2223         then do:
     2224           undo move_block, retry move_block.
     2225         end.
     2226         for each buf_temp-browse-handle
     2227           where buf_temp-browse-handle.browse-type = 'width':u
     2228         on error undo move_block, retry move_block
     2229         :
     2230           assign
     2231             buf_temp-browse-handle.browse-handle :width
     2232               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2233             no-error .
     2234           if error-status :error
     2235           or error-status :get-message(1) <> ""
     2236           then do:
     2237             undo move_block, retry move_block .
     2238           end.
     2239         end.
     2240         for each buf_temp-diasize-handle
     2241         on error undo move_block, retry move_block
     2242         :
     2243           assign
     2244             v-object-handle = buf_temp-diasize-handle.handle-value
     2245           .
     2246           if v-object-handle <> v-diasize-resize-button
     2247           then do:
     2248             assign
     2249               v-object-handle :col = v-object-handle :col + p-change-value
     2250               no-error .
     2251             if error-status :error
     2252             or error-status :get-message(1) <> ""
     2253             then do:
     2254               undo move_block, retry move_block .
     2255             end.
     2256           end.
     2257         end.
     2258       end.
     2259       else do:
     2260         for each buf_temp-diasize-handle
     2261         on error undo move_block, retry move_block
     2262         :
     2263           assign
     2264             v-object-handle = buf_temp-diasize-handle.handle-value
     2265           .
     2266           if v-object-handle <> v-diasize-resize-button
     2267           then do:
     2268             assign
     2269               v-object-handle :col = v-object-handle :col + p-change-value
     2270               no-error .
     2271             if error-status :error
     2272             or error-status :get-message(1) <> ""
     2273             then do:
     2274               undo move_block, retry move_block .
     2275             end.
     2276           end.
     2277         end.
     2278         for each buf_temp-browse-handle
     2279           where buf_temp-browse-handle.browse-type = 'width':u
     2280         on error undo move_block, retry move_block
     2281         :
     2282           assign
     2283             buf_temp-browse-handle.browse-handle :width
     2284               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2285             no-error .
     2286           if error-status :error
     2287           or error-status :get-message(1) <> ""
     2288           then do:
     2289             undo move_block, retry move_block .
     2290           end.
     2291         end.
     2292         assign
     2293           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2294           no-error .
     2295         if error-status :error
     2296         or error-status :get-message(1) <> ""
     2297         then do:
     2298           undo move_block, retry move_block.
     2299         end.
     2300         assign
     2301           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2302         no-error .
     2303         if error-status :error
     2304         or error-status :get-message(1) <> ""
     2305         then do:
     2306           undo move_block, retry move_block.
     2307         end.
     2308         if frame Dialog-Frame :scrollable = true
     2309         then do:
     2310           assign
     2311             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2312           no-error .
     2313           if error-status :error
     2314           or error-status :get-message(1) <> ""
     2315           then do:
     2316             undo move_block, retry move_block.
     2317           end.
     2318         end.
     2319       end.
     2320       if p-move-resize
     2321       then do:
     2322         run diasize_position-resize-button in this-procedure .
     2323       end.
     2324       if v-diasize-wndstore = true
     2325       then do:
     2326         if connected("ub") = true
     2327         then do:
     2328           define variable v-cntxt-db-num        as integer   no-undo .
     2329           define variable v-cntxt-userid        as character no-undo .
     2330           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2331                                             , OUTPUT v-cntxt-userid
     2332                                             ) .
     2333           run gbl/wndsizew.p
     2334             (input  v-cntxt-db-num
     2335             ,input  v-cntxt-userid
     2336             ,input  v-diasize-proc-name
     2337             ,input  'width':u
     2338             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2339             ) .
     2340         end.
     2341       end.
     2342     end.
     2343     assign
     2344       v-diasize-change-size = false
     2345     .
     2346   end procedure.
     2347   procedure diasize_set-width :
     2348     define input  parameter p-new-width  as decimal   no-undo .
     2349     define input  parameter p-move-resize as logical   no-undo .
     2350     do
     2351     on error undo, return error return-value
     2352     :
     2353       run diasize_change-width in this-procedure
     2354         (input  (p-new-width - frame Dialog-Frame :width)
     2355         ,input  p-move-resize
     2356         ) .
     2357     end.
     2358   end procedure.
     2359   procedure diasize_position-resize-button :
     2360     do with frame Dialog-Frame
     2361     :
     2362       hide v-diasize-resize-button .
     2363       assign
     2364         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2365                     - 1
     2366                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2367         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2368                     - 1
     2369                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2370       .
     2371       view v-diasize-resize-button .
     2372     end.
     2373   end procedure.
     2374   on alt-right anywhere
     2375   do:
     2376     run diasize_change-width in this-procedure
     2377       (input 1
     2378       ,input true
     2379       ) .
     2380     return no-apply .
     2381   end.
     2382   on alt-left anywhere
     2383   do:
     2384     run diasize_change-width in this-procedure
     2385       (input -1
     2386       ,input true
     2387       ) .
     2388     return no-apply .
     2389   end.
     2390   on alt-down anywhere
     2391   do:
     2392     run diasize_change-height in this-procedure
     2393       (input 1
     2394       ,input true
     2395       ) .
     2396     return no-apply .
     2397   end.
     2398   on alt-up anywhere
     2399   do:
     2400     run diasize_change-height in this-procedure
     2401       (input -1
     2402       ,input true
     2403       ) .
     2404     return no-apply .
     2405   end.
     2406   on alt-enter of frame Dialog-Frame
     2407   do:
     2408     run diasize_maximize in this-procedure
     2409       (input  ?
     2410       ).
     2411     return no-apply .
     2412   end.
     2413   procedure diasize_end-move :
     2414     do
     2415     on error undo, return error return-value
     2416     :
     2417       define variable v-row-delta as decimal   no-undo .
     2418       define variable v-col-delta as decimal   no-undo .
     2419       define variable v-new-row as decimal   no-undo .
     2420       define variable v-new-col as decimal   no-undo .
     2421       assign
     2422         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2423         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2424       .
     2425       assign
     2426         v-row-delta = v-new-row - frame Dialog-Frame :height
     2427         v-col-delta = v-new-col - frame Dialog-Frame :width
     2428       .
     2429       run diasize_change-height in this-procedure
     2430         (input v-row-delta
     2431         ,input true
     2432         ) .
     2433       run diasize_change-width in this-procedure
     2434         (input v-col-delta
     2435         ,input true
     2436         ) .
     2437     end.
     2438   end procedure.
     2439   procedure diasize_maximize :
     2440     define input  parameter p-action as logical   no-undo .
     2441     do
     2442     on error undo, return error return-value
     2443     :
     2444       if p-action = ?
     2445       then do:
     2446         if v-diasize-need-maximize = true
     2447         then do:
     2448           assign
     2449             p-action = true
     2450           .
     2451         end.
     2452         else do:
     2453           assign
     2454             p-action = false
     2455           .
     2456         end.
     2457       end.
     2458       if p-action = true
     2459       then do:
     2460         run diasize_change-height in this-procedure
     2461           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2462               - frame Dialog-Frame :height-chars
     2463           ,input true
     2464           ) .
     2465         run diasize_change-width in this-procedure
     2466           (input session :width-chars
     2467               - frame Dialog-Frame :width-chars
     2468           ,input true
     2469           ) .
     2470         assign
     2471           v-diasize-need-maximize = false
     2472         .
     2473       end.
     2474       else do:
     2475         run diasize_change-width in this-procedure
     2476           (input v-diasize-orig-frame-width
     2477               - frame Dialog-Frame :width-chars
     2478           ,input true
     2479           ) .
     2480         run diasize_change-height in this-procedure
     2481           (input v-diasize-orig-frame-height
     2482               - frame Dialog-Frame :height-chars
     2483           ,input true
     2484           ) .
     2485         assign
     2486           v-diasize-need-maximize = true
     2487         .
     2488       end.
     2489     end.
     2490   end procedure.
     2491   procedure diasize_restore-orig-size :
     2492     do
     2493     on error undo, return error return-value
     2494     :
     2495       assign
     2496         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2497         v-diasize-current-frame-height = frame Dialog-Frame :height
     2498       .
     2499       run diasize_set-height in this-procedure
     2500         (input  v-diasize-orig-frame-height
     2501         ,input  true
     2502         ) .
     2503       run diasize_set-width in this-procedure
     2504         (input  v-diasize-orig-frame-width
     2505         ,input  true
     2506         ) .
     2507     end.
     2508   end procedure.
     2509   procedure diasize_restore-current-size :
     2510     do
     2511     on error undo, return error return-value
     2512     :
     2513       run diasize_set-height in this-procedure
     2514         (input  v-diasize-current-frame-height
     2515         ,input  true
     2516         ) .
     2517       run diasize_set-width in this-procedure
     2518         (input  v-diasize-current-frame-width
     2519         ,input  true
     2520         ) .
     2521     end.
     2522   end procedure.
     2523   procedure diasize_set-browse-handle :
     2524     define input  parameter p-browse-handle as handle   no-undo .
     2525     define buffer buf_temp-browse-handle for temp-browse-handle .
     2526     do
     2527     on error undo, return error return-value
     2528     :
     2529       assign
     2530         v-diasize-browse-handle = p-browse-handle
     2531       .
     2532       for each buf_temp-browse-handle
     2533       on error undo, return error return-value
     2534       :
     2535         delete buf_temp-browse-handle .
     2536       end.
     2537     end.
     2538   end procedure.
     2539   procedure diasize_add_browse :
     2540     define input  parameter p-browse-type   as character no-undo .
     2541     define input  parameter p-browse-handle as handle    no-undo .
     2542     define buffer buf_temp-browse-handle for temp-browse-handle .
     2543     do
     2544     on error undo, return error return-value
     2545     :
     2546       assign
     2547         v-diasize-browse-number = v-diasize-browse-number + 1
     2548       .
     2549       create buf_temp-browse-handle .
     2550       assign
     2551         buf_temp-browse-handle.browse-type   = p-browse-type
     2552         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2553         buf_temp-browse-handle.browse-handle = p-browse-handle
     2554       .
     2555     end.
     2556   end procedure.
     2557   procedure diasize_init :
     2558     define variable v-default-value    as logical   no-undo .
     2559     define variable v-restore-saved    as logical   no-undo .
     2560     define variable v-resize-value-str as character no-undo .
     2561     do
     2562     on error undo, return error return-value
     2563     :
     2564       do with frame Dialog-Frame
     2565       :
     2566         assign
     2567           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2568           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2569           v-diasize-browse-handle     = browse br-table :handle
     2570         .
     2571         create button v-diasize-resize-button
     2572         assign
     2573           parent        = frame Dialog-Frame :first-child
     2574           label         = "s"
     2575           height-pixels = 16
     2576           width-pixels  = 16
     2577           visible       = true
     2578           sensitive     = true
     2579           movable       = true
     2580           triggers:
     2581             on end-move persistent run diasize_end-move in this-procedure .
     2582           end triggers.
     2583         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2584         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2585         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2586         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2587         assign
     2588           v-diasize-wndmax = false
     2589         .
     2590         if connected("ub") = true
     2591         then do:
     2592           define variable v-cntxt-db-num        as integer   no-undo .
     2593           define variable v-cntxt-userid        as character no-undo .
     2594           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2595                                             , OUTPUT v-cntxt-userid
     2596                                             ) .
     2597           run gbl/wndpar_r.p
     2598             (input  v-cntxt-db-num
     2599             ,input  v-cntxt-userid
     2600             ,input  'wndmax':U
     2601             ,output v-diasize-wndmax
     2602             ,output v-default-value
     2603             ) .
     2604         end.
     2605         assign
     2606           v-diasize-wndstore = false
     2607         .
     2608         if connected("ub") = true
     2609         then do:
     2610           run gbl/wndpar_r.p
     2611             (input  v-cntxt-db-num
     2612             ,input  v-cntxt-userid
     2613             ,input  'wndstore':U
     2614             ,output v-diasize-wndstore
     2615             ,output v-default-value
     2616             ) .
     2617         end.
     2618         assign
     2619           v-diasize-proc-name = entry(1, program-name(2), '.')
     2620         .
     2621         if v-diasize-wndstore = true
     2622         then do:
     2623           assign
     2624             v-restore-saved = false
     2625           .
     2626           if connected("ub") = true
     2627           then do:
     2628             run gbl/wndsizer.p
     2629               (input  v-cntxt-db-num
     2630               ,input  v-cntxt-userid
     2631               ,input  v-diasize-proc-name
     2632               ,input  'height':u
     2633               ,output v-resize-value-str
     2634               ) .
     2635             if v-resize-value-str <> '':U
     2636             then do:
     2637               run diasize_change-height in this-procedure
     2638                 (input  integer(v-resize-value-str)
     2639                 ,input  true
     2640                 ) .
     2641               assign
     2642                 v-restore-saved = true
     2643               .
     2644             end.
     2645           end.
     2646           if connected("ub") = true
     2647           then do:
     2648             run gbl/wndsizer.p
     2649               (input  v-cntxt-db-num
     2650               ,input  v-cntxt-userid
     2651               ,input  v-diasize-proc-name
     2652               ,input  'width':u
     2653               ,output v-resize-value-str
     2654               ) .
     2655             if v-resize-value-str <> '':U
     2656             then do:
     2657               run diasize_change-width in this-procedure
     2658                 (input  integer(v-resize-value-str)
     2659                 ,input  true
     2660                 ) .
     2661               assign
     2662                 v-restore-saved = true
     2663               .
     2664             end.
     2665           end.
     2666           if v-restore-saved <> true
     2667           then do:
     2668             if v-diasize-wndmax = true
     2669             then do:
     2670               run diasize_maximize in this-procedure
     2671                 (input  true
     2672                 ) .
     2673             end.
     2674           end.
     2675         end.
     2676         else do:
     2677           if v-diasize-wndmax = true
     2678           then do:
     2679             run diasize_maximize in this-procedure
     2680               (input  true
     2681               ) .
     2682           end.
     2683         end.
     2684       end.
     2685     end.
     2686   end procedure.
     2687   procedure diasize_need-full-display :
     2688     define output parameter p-need-full-display as logical   no-undo .
     2689     do
     2690     on error undo, return error return-value
     2691     :
     2692       assign
     2693         p-need-full-display = v-diasize-need-full-display
     2694       .
     2695       assign
     2696         v-diasize-need-full-display = false
     2697       .
     2698     end.
     2699   end procedure.
     2700   procedure get-context :
     2701      define output parameter p-db-num as integer          no-undo.
     2702      define output parameter p-user-id as character        no-undo.
     2703      define variable v-login               as character    no-undo.
     2704      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2705      define buffer buf_user-login  for ub.user-login .
     2706      do
     2707      on error undo, return error
     2708      :
     2709            FIND FIRST buf_sys-ctrl no-lock.
     2710            ASSIGN
     2711               v-login = USERID("ub")
     2712               p-db-num = buf_sys-ctrl.db-num
     2713            .
     2714            FIND FIRST buf_user-login
     2715                 WHERE buf_user-login.db-num = p-db-num
     2716                   AND buf_user-login.user-login = v-login
     2717                 no-lock
     2718                 no-error
     2719                 .
     2720            IF AVAILABLE buf_user-login
     2721            THEN DO:
     2722               assign
     2723                  p-user-id = buf_user-login.user-id
     2724               .
     2725            END.
     2726      end.
     2727   end procedure.
     2728       run diasize_init in this-procedure .
     2729   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     2730   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     2731   MAIN-BLOCK:
     2732   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2733      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2734      define variable v-root-code    as integer     no-undo.
     2735       run fbrglib-get-root-code in this-procedure ( output v-root-code ) no-error.
     2736       if error-status :error
     2737       then do:
     2738           undo, return error "Не найден корневой узел." + chr(10) + return-value.
     2739       end.
     2740       if p-node-code = v-root-code
     2741       then do:
     2742           message
     2743               skip "Товары не могут принадлежать корневому узлу дерева."
     2744           view-as alert-box error.
     2745           assign
     2746               p-cancel = yes
     2747           .
     2748           undo, return .
     2749       end.
     2750       RUN enable_UI.
     2751       define variable v-current-db-num    as integer        no-undo.
     2752       define buffer buf_clients       for ub.clients.
     2753   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2754   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
     2755     (output v-current-db-num
     2756     )  .
     2757       find first buf_clients no-lock
     2758            where buf_clients.obj-type = p-store-type
     2759              and buf_clients.obj-code = p-store-code
     2760       .
     2761       if v-current-db-num <> buf_clients.db-num
     2762       then do:
     2763           disable
     2764               b-add
     2765               b-del
     2766           with frame Dialog-Frame .
     2767       end.
     2768       apply "entry" to br-table.
     2769       WAIT-FOR GO OF FRAME Dialog-Frame.
     2770   END.
     2771   RUN disable_UI.
     2772   PROCEDURE add-goods :
     2773   do
     2774   on error undo, return error
     2775   :
     2776   define input parameter p-node-code   as integer      no-undo.
     2777       define variable v-artic                 as character    no-undo.
     2778       define variable v-goods-recid-list      as character    no-undo.
     2779       define variable v-counter               as integer      no-undo.
     2780       define variable v-goods-recid           as recid        no-undo.
     2781       define variable v-fbr-gds-obj-recid     as recid        no-undo.
     2782       define buffer buf_goods         for ub.goods.
     2783       define buffer buf_fbr-gds-obj   for ub.fbr-gds-obj.
     2784       run str/chs-gds.w (
     2785             input parparentproc
     2786           , input p-store-type
     2787           , input p-store-code
     2788           , input '':U
     2789           , input '':U
     2790           , input "Группа блюд: " + string( p-node-code )
     2791           , input 'объект':U
     2792           , input ?
     2793           , input ?
     2794           , input ?
     2795           , input ?
     2796           , input-output v-artic
     2797           , output v-goods-recid-list
     2798       ) .
     2799       if v-goods-recid-list <> ''
     2800       then do:
     2801           IF v-goods-recid-list <> "cb_create_gds-list_from-chs-gds" THEN DO:
     2802             do while v-counter <= num-entries ( v-goods-recid-list )
     2803             :
     2804                 assign
     2805                     v-goods-recid   = integer( entry ( v-counter, v-goods-recid-list ) )
     2806                     v-counter       = v-counter + 1
     2807                 .
     2808                 find first buf_goods no-lock
     2809                     where recid( buf_goods ) = v-goods-recid
     2810                 .
     2811                 RUN cb_create_gds-list_from-chs-gds IN THIS-PROCEDURE ( INPUT (buffer buf_goods:handle)).
     2812             END.
     2813          end.
     2814          v-counter = 0.
     2815           FOR EACH gds-list NO-LOCK:
     2816             if v-counter modulo 10 = 0 then do:
     2817               run waitfram-show in this-procedure ( input substitute("Обработано &1 ", v-counter)).
     2818             end.
     2819             v-counter = v-counter + 1.
     2820             find first buf_fbr-gds-obj exclusive-lock
     2821                    where buf_fbr-gds-obj.obj-type = p-store-type
     2822                      and buf_fbr-gds-obj.obj-code = p-store-code
     2823                      and buf_fbr-gds-obj.gds-code = gds-list.gds-code
     2824               no-error.
     2825               if not available buf_fbr-gds-obj
     2826               then do:
     2827                   run ref/fgdsobj1.p (
     2828                         input-output v-fbr-gds-obj-recid
     2829                       , input 'ДОБАВЛЕНИЕ':U
     2830                       , input no
     2831                       , input gds-list.gds-code
     2832                       , input p-store-type
     2833                       , input p-store-code
     2834                       , input p-node-code
     2835                       , input ""
     2836                       , input 0
     2837                       , input no
     2838                       , input no
     2839                       , input no
     2840                       , input no
     2841                       , input no
     2842                       , input no
     2843                  ) no-error.
     2844                  if error-status :error
     2845                  then do:
     2846                     run waitfram-hide in this-procedure .
     2847                      message
     2848                            vss-workfile vss-revision vss-description
     2849                       skip "Ошибка при создании записи товара производства на объекте."
     2850                       skip return-value
     2851                       skip trim(error-status :get-message(1))
     2852                            trim(error-status :get-message(2))
     2853                            trim(error-status :get-message(3))
     2854                      view-as alert-box error.
     2855                      undo, return error .
     2856                  end.
     2857               end.
     2858               else do:
     2859                   assign
     2860                       v-fbr-gds-obj-recid = recid( buf_fbr-gds-obj )
     2861                   .
     2862                   run ref/fgdsobj1.p (
     2863                         input-output v-fbr-gds-obj-recid
     2864                       , input 'ИЗМЕНЕНИЕ':U
     2865                       , input no
     2866                       , input buf_fbr-gds-obj.gds-code
     2867                       , input buf_fbr-gds-obj.obj-type
     2868                       , input buf_fbr-gds-obj.obj-code
     2869                       , input p-node-code
     2870                       , input buf_fbr-gds-obj.fbr-obj-type
     2871                       , input buf_fbr-gds-obj.fbr-obj-code
     2872                       , input buf_fbr-gds-obj.is-cd
     2873                       , input buf_fbr-gds-obj.is-menu
     2874                       , input buf_fbr-gds-obj.is-modificator
     2875                       , input buf_fbr-gds-obj.is-null-price
     2876                       , input buf_fbr-gds-obj.is-season
     2877                       , input buf_fbr-gds-obj.is-semi-finished
     2878                  ) no-error.
     2879                  if error-status :error
     2880                  then do:
     2881                     run waitfram-hide in this-procedure .
     2882                      message
     2883                            vss-workfile vss-revision vss-description
     2884                       skip "Ошибка при изменении записи товара производства на объекте."
     2885                       skip return-value
     2886                       skip trim(error-status :get-message(1))
     2887                            trim(error-status :get-message(2))
     2888                            trim(error-status :get-message(3))
     2889                      view-as alert-box error.
     2890                      undo, return error .
     2891                  end.
     2892               end.
     2893             delete gds-list.
     2894           end.
     2895         run waitfram-hide in this-procedure .
     2896       end.
     2897   end.
     2898   END PROCEDURE.
     2899   PROCEDURE cb_create_gds-list_from-chs-gds :
     2900   DEFINE INPUT PARAMETER p-bh AS handle NO-UNDO.
     2901   if p-bh:available = no then return .
     2902   FIND FIRST gds-list NO-LOCK WHERE
     2903             gds-list.gds-code = p-bh::gds-code NO-ERROR.
     2904   IF NOT AVAILABLE gds-list THEN DO:
     2905      CREATE gds-list.
     2906      buffer gds-list:handle:buffer-copy(p-bh).
     2907      release gds-list.
     2908   END.
     2909   END PROCEDURE.
     2910   PROCEDURE disable_UI :
     2911     HIDE FRAME Dialog-Frame.
     2912   END PROCEDURE.
     2913   PROCEDURE enable_UI :
     2914     ENABLE b-exit b-add b-del b-help br-table
     2915         WITH FRAME Dialog-Frame.
     2916     VIEW FRAME Dialog-Frame.
     2917     OPEN QUERY br-table FOR EACH ub.fbr-gds-obj       WHERE fbr-gds-obj.obj-type = p-store-type  AND fbr-gds-obj.obj-code = p-store-code  AND fbr-gds-obj.fbr-grp-code = p-node-code NO-LOCK,       EACH ub.goods OF ub.fbr-gds-obj NO-LOCK.
     2918   END PROCEDURE.
     2919   PROCEDURE unattach-goods :
     2920   do
     2921   on error undo, return error
     2922   :
     2923   define input parameter p-obj-type   as character    no-undo.
     2924   define input parameter p-obj-code   as integer      no-undo.
     2925   define input parameter p-gds-code   as integer      no-undo.
     2926       define buffer buf_fbr-gds-obj       for ub.fbr-gds-obj.
     2927       find first buf_fbr-gds-obj exclusive-lock
     2928            where buf_fbr-gds-obj.obj-type = p-obj-type
     2929              and buf_fbr-gds-obj.obj-code = p-obj-code
     2930              and buf_fbr-gds-obj.gds-code = p-gds-code
     2931       .
     2932       assign
     2933           buf_fbr-gds-obj.fbr-grp-code = 0
     2934       .
     2935   end.
     2936   END PROCEDURE.
