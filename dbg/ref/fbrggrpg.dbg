        1   define input parameter parparentproc as widget-handle no-undo .
        2   define input parameter p-store-type as character    no-undo.
        3   define input parameter p-store-code as integer      no-undo.
        4   define input parameter p-node-code  as integer      no-undo.
        5   define output parameter p-cancel    as logical      no-undo.
        6   define variable vss-revision    as character no-undo init "$Revision$":U .
        7   define variable vss-author      as character no-undo init "$Author$":U .
        8   define variable vss-date        as character no-undo init "$Date$":U .
        9   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       10   define variable vss-archive     as character no-undo init "$Archive$":U .
       11   define variable vss-description as character no-undo init "Привязка товаров к группе блюд.".
       12   procedure vss-get-info :
       13     define output parameter p-vss-revision    like vss-revision    no-undo .
       14     define output parameter p-vss-author      like vss-author      no-undo .
       15     define output parameter p-vss-date        like vss-date        no-undo .
       16     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       17     define output parameter p-vss-archive     like vss-archive     no-undo .
       18     define output parameter p-vss-description like vss-description no-undo .
       19     assign
       20       p-vss-revision    = vss-revision
       21       p-vss-author      = vss-author
       22       p-vss-date        = vss-date
       23       p-vss-workfile    = vss-workfile
       24       p-vss-archive     = vss-archive
       25       p-vss-description = vss-description
       26     .
       27   end procedure.
       28   procedure vss-get-parameters :
       29     define output parameter p-vss-parameters as character no-undo .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define new global shared variable g#language as character no-undo .
       67   if g#language <> '' and g#language <> 'rus':U then do:
       68     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       69   end.
       70   define new global shared variable g#library  as handle no-undo .
       71   define new global shared variable g#library2 as handle no-undo .
       72   define   shared variable g#auto as logical no-undo.
       73   define   shared variable g#news as logical no-undo.
       74   define   shared variable g#oxml as logical no-undo.
       75   define   shared variable g#esys as logical no-undo.
       76   define   shared variable g#news-source-db as integer no-undo.
       77   define   shared variable g#esys-source-esys as integer no-undo.
       78   define   shared variable g#db-num as integer   no-undo .
       79   define   shared variable g#userid as character no-undo .
       80   define   shared variable g#passwd as character no-undo .
       81   procedure proc-alt-shift-f2:
       82     if not ibs.th.gbl.gbl-var:rcode
       83   then
       84     run gbl\inidebug.p .
       85   end.
       86   procedure proc-alt-shift-f3:
       87     run gbl/prvssinf.p
       88       ( input this-procedure
       89       ) .
       90   end.
       91   define variable v-inform-launched as logical no-undo initial false .
       92   procedure proc-alt-shift-f4:
       93     define variable v-action as character no-undo .
       94     if v-inform-launched = false then do:
       95       assign
       96         v-inform-launched = true
       97       .
       98       run gbl/d-inform.w
       99         (  input self
      100         ,  input this-procedure
      101         , output v-action
      102         ) no-error .
      103       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      104       assign
      105         v-inform-launched = false
      106       .
      107     end.
      108   end.
      109   procedure proc-alt-f1:
      110     run gbl/corrhelp.p
      111       (input this-procedure
      112       ) .
      113   end .
      114   on alt-shift-f2 anywhere do:
      115     run proc-alt-shift-f2.
      116   end.
      117   on alt-shift-f3 anywhere do:
      118     run proc-alt-shift-f3 in this-procedure .
      119   end.
      120   on alt-shift-f4 anywhere do:
      121     run proc-alt-shift-f4 in this-procedure.
      122   end.
      123   on alt-f1 anywhere do:
      124     run proc-alt-f1 in this-procedure .
      125   end.
      126   define variable vss-include-info0 as character format "X(65)" no-undo
      127   initial "@(#)$Workfile$ $Revision$".
      128   define temp-table temp_fbrglib_grp no-undo
      129       field sel           as character
      130       field full-name     as character
      131       field out-code      as integer
      132       field sort-name     as character
      133       field node-code     as integer
      134       field upper-code    as integer
      135       field name          as character
      136       field level         as integer
      137       field mark          as character
      138       field obj-type      as character
      139       field obj-code      as integer
      140       field global-code   as integer
      141       index pi is primary unique obj-type obj-code sort-name
      142       index fn obj-type obj-code full-name
      143       index nc is unique obj-type obj-code node-code
      144       index sl obj-type obj-code sel
      145       index uc obj-type obj-code upper-code
      146   .
      147   define temp-table temp_fbrglib_found-grp no-undo
      148       field full-name   as character
      149       field sort-name   as character
      150       field node-code   as integer
      151       field level       as integer
      152       field is-terminal as logical
      153       field obj-type      as character
      154       field obj-code      as integer
      155       index pi is primary unique obj-type obj-code sort-name
      156       index fn obj-type obj-code full-name
      157       index lv obj-type obj-code level
      158       index it obj-type obj-code is-terminal
      159   .
      160   define temp-table temp_found-result-nodelist no-undo
      161       field node-code     as integer
      162       field processed     as logical
      163       field sort-name     as character
      164       field full-name     as character
      165       index pi is primary unique node-code
      166       index ps processed
      167   .
      168   procedure fbrglib-get-sort-name :
      169   do
      170   on error undo, return error
      171   :
      172   define input parameter p-obj-type   as character    no-undo.
      173   define input parameter p-obj-code   as integer      no-undo.
      174   define input parameter p-node-code  as integer      no-undo.
      175   define output parameter p-sort-name as character    no-undo.
      176       define variable v-upper-code    as integer           no-undo.
      177       define buffer buf_fbr-gds-grp       for ub.fbr-gds-grp.
      178       define buffer buf_upper_fbr-gds-grp for ub.fbr-gds-grp.
      179       find first buf_fbr-gds-grp no-lock
      180            where buf_fbr-gds-grp.obj-type  = p-obj-type
      181              and buf_fbr-gds-grp.obj-code  = p-obj-code
      182              and buf_fbr-gds-grp.node-code = p-node-code
      183       no-error.
      184       if not available buf_fbr-gds-grp
      185       then do:
      186           undo, return error "fbrglib-get-sort-name: Не найдена группа товаров с кодом " + string( p-node-code ).
      187       end.
      188       assign
      189           p-sort-name  = ""
      190           v-upper-code = 1
      191       .
      192       do while true
      193       on error undo, return error "fbrglib-get-sort-name: Ошибка составления полного имени группы"
      194       :
      195           assign
      196               p-sort-name  = buf_fbr-gds-grp.node-name
      197                            + (if p-sort-name <> "" then chr(2) else "")
      198                            + p-sort-name
      199               v-upper-code = buf_fbr-gds-grp.upper-code
      200           .
      201           if buf_fbr-gds-grp.upper-code = 1
      202           then do:
      203               leave.
      204           end.
      205           find first buf_fbr-gds-grp no-lock
      206                where buf_fbr-gds-grp.obj-type  = p-obj-type
      207                  and buf_fbr-gds-grp.obj-code  = p-obj-code
      208                  and buf_fbr-gds-grp.node-code = v-upper-code
      209           no-error.
      210           if not available buf_fbr-gds-grp
      211           then do:
      212               undo, return error "fbrglib-get-sort-name: Не найдена группа товаров с кодом "
      213                                   + string( v-upper-code )
      214                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
      215           end.
      216       end.
      217   end.
      218   end procedure.
      219   procedure fbrglib-get-full-name :
      220   do
      221   on error undo, return error
      222   :
      223   define input parameter p-obj-type   as character    no-undo.
      224   define input parameter p-obj-code   as integer      no-undo.
      225   define input parameter p-node-code  as integer      no-undo.
      226   define output parameter p-full-name as character    no-undo.
      227       define variable v-upper-code    as integer           no-undo.
      228       define buffer buf_fbr-gds-grp       for ub.fbr-gds-grp.
      229       define buffer buf_upper_fbr-gds-grp for ub.fbr-gds-grp.
      230       if p-node-code = 1
      231       then do:
      232           assign
      233               p-full-name = ""
      234           .
      235       end.
      236       else do:
      237           find first buf_fbr-gds-grp no-lock
      238                where buf_fbr-gds-grp.obj-type  = p-obj-type
      239                  and buf_fbr-gds-grp.obj-code  = p-obj-code
      240                  and buf_fbr-gds-grp.node-code = p-node-code
      241           no-error.
      242           if not available buf_fbr-gds-grp
      243           then do:
      244               undo, return error "fbrglib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
      245           end.
      246           assign
      247               p-full-name  = ""
      248               v-upper-code = 1
      249           .
      250           do while true
      251           on error undo, return error "fbrglib-get-full-name: Ошибка составления полного имени группы"
      252           :
      253               assign
      254                   p-full-name  = buf_fbr-gds-grp.node-name
      255                               + (if p-full-name <> "" then chr(47) else "")
      256                               + p-full-name
      257                   v-upper-code = buf_fbr-gds-grp.upper-code
      258               .
      259               if buf_fbr-gds-grp.upper-code = 1
      260               then do:
      261                   leave.
      262               end.
      263               find first buf_fbr-gds-grp no-lock
      264                    where buf_fbr-gds-grp.obj-type  = p-obj-type
      265                      and buf_fbr-gds-grp.obj-code  = p-obj-code
      266                      and buf_fbr-gds-grp.node-code = v-upper-code
      267               no-error.
      268               if not available buf_fbr-gds-grp
      269               then do:
      270                   undo, return error "fbrglib-get-full-name: Не найдена группа товаров с кодом "
      271                                       + string( v-upper-code )
      272                                       + ". Ошибка ссылки в дереве товаров для узла p-node-code".
      273               end.
      274           end.
      275           assign
      276               p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
      277           .
      278       end.
      279   end.
      280   end procedure.
      281   procedure fbrglib-get-root-code :
      282   do
      283   on error undo, return error
      284   :
      285   define output parameter p-root-code as integer      no-undo.
      286       define buffer buf_fbr-gds-grp       for ub.fbr-gds-grp.
      287       find first buf_fbr-gds-grp no-lock
      288            where buf_fbr-gds-grp.upper-code = 0
      289       no-error .
      290       if not available buf_fbr-gds-grp
      291       then do:
      292           undo, return error .
      293       end.
      294       else do:
      295           assign
      296               p-root-code = buf_fbr-gds-grp.node-code
      297           .
      298       end.
      299   end.
      300   end procedure.
      301   procedure fbrglib-find-grp-by-full-name :
      302   do
      303   on error undo, return error
      304   :
      305   define input parameter p-obj-type     as character    no-undo.
      306   define input parameter p-obj-code     as integer      no-undo.
      307   define input parameter p-search-name  as character    no-undo.
      308   define input parameter p-fill-path    as logical      no-undo.
      309       define variable v-upper-code    as integer          no-undo.
      310       define variable v-not-found     as logical init yes no-undo.
      311       define variable v-counter       as integer           no-undo.
      312       define variable v-level         as integer           no-undo.
      313       define variable v-full-name     as character         no-undo.
      314       define variable v-sort-name     as character         no-undo.
      315       define variable v-node-name     as character      no-undo.
      316       define buffer buf_fbr-gds-grp       for ub.fbr-gds-grp.
      317       assign
      318           p-search-name = replace( p-search-name, chr(47), chr(2) )
      319       .
      320       run fbrglib-get-root-code ( output v-upper-code ) no-error .
      321       if error-status :error
      322       then do:
      323           undo, return error "fbrglib-find-grp-by-full-name: Ошибка при поиске корневого узла".
      324       end.
      325       assign
      326           v-full-name  = ""
      327           v-level      = num-entries( p-search-name, chr(2) )
      328       .
      329       for each temp_fbrglib_found-grp
      330       :
      331           delete temp_fbrglib_found-grp.
      332       end.
      333       start-name-analyze:
      334       do v-counter = 1 to v-level
      335       :
      336           if v-counter < v-level
      337           then do:
      338               assign
      339                   v-node-name = entry( v-counter, p-search-name, chr(2) )
      340               .
      341               find first buf_fbr-gds-grp no-lock
      342                    where buf_fbr-gds-grp.obj-type   = p-obj-type
      343                      and buf_fbr-gds-grp.obj-code   = p-obj-code
      344                      and buf_fbr-gds-grp.upper-code = v-upper-code
      345                      and buf_fbr-gds-grp.node-name  = v-node-name
      346               no-error .
      347               if not available buf_fbr-gds-grp
      348               then do:
      349                   assign
      350                       v-full-name  = p-search-name
      351                       v-sort-name  = p-search-name
      352                   .
      353                   return error "fbrglib-find-grp-by-full-name: не найдена группа " + entry( v-level, p-search-name, chr(47) ).
      354               end.
      355               else do:
      356                   assign
      357                       v-full-name = v-full-name + ( if v-full-name = "" then "" else chr(47) )        + buf_fbr-gds-grp.node-name
      358                       v-sort-name = v-sort-name + ( if v-sort-name = "" then "" else chr(2) ) + buf_fbr-gds-grp.node-name
      359                       v-upper-code = buf_fbr-gds-grp.node-code
      360                   .
      361                   if p-fill-path = yes
      362                   then do:
      363                       create temp_fbrglib_found-grp.
      364                       assign
      365                           temp_fbrglib_found-grp.full-name = v-full-name + chr(47)
      366                           temp_fbrglib_found-grp.sort-name = v-sort-name
      367                           temp_fbrglib_found-grp.node-code = v-upper-code
      368                           temp_fbrglib_found-grp.level     = v-counter
      369                           temp_fbrglib_found-grp.obj-type  = p-obj-type
      370                           temp_fbrglib_found-grp.obj-code  = p-obj-code
      371                       .
      372                   end.
      373               end.
      374           end.
      375           else do:
      376               for each buf_fbr-gds-grp no-lock
      377                  where buf_fbr-gds-grp.obj-type   = p-obj-type
      378                    and buf_fbr-gds-grp.obj-code   = p-obj-code
      379                    and buf_fbr-gds-grp.upper-code = v-upper-code
      380                    and buf_fbr-gds-grp.node-name begins entry( v-counter, p-search-name, chr(2) )
      381               :
      382                   assign
      383                       v-not-found = no
      384                   .
      385                   create temp_fbrglib_found-grp.
      386                   assign
      387                       temp_fbrglib_found-grp.full-name = v-full-name
      388                                                           + (if v-full-name = "" then "" else chr(47) )
      389                                                           + buf_fbr-gds-grp.node-name + chr(47)
      390                       temp_fbrglib_found-grp.sort-name = v-sort-name
      391                                                           + ( if v-sort-name = "" then "" else chr(2) )
      392                                                           + buf_fbr-gds-grp.node-name
      393                       temp_fbrglib_found-grp.node-code = buf_fbr-gds-grp.node-code
      394                       temp_fbrglib_found-grp.level     = v-level
      395                       temp_fbrglib_found-grp.obj-type  = p-obj-type
      396                       temp_fbrglib_found-grp.obj-code  = p-obj-code
      397                   .
      398               end.
      399               if v-not-found = yes
      400               then do:
      401                   assign
      402                       v-full-name  = p-search-name
      403                       v-sort-name  = p-search-name
      404                   .
      405                   for each temp_fbrglib_found-grp
      406                   :
      407                       delete temp_fbrglib_found-grp.
      408                   end.
      409                   return error "fbrglib-find-grp-by-full-name: не найдена группа " + entry( v-level, p-search-name, chr(2) ).
      410               end.
      411           end.
      412       end.
      413   end.
      414   end procedure.
      415   procedure fbrglib-find-all-subgroup :
      416   do
      417   on error undo, return error
      418   :
      419   define input parameter p-start-obj-type     as character    no-undo.
      420   define input parameter p-start-obj-code     as integer      no-undo.
      421   define input parameter p-start-node-code    as integer      no-undo.
      422   define input parameter p-terminal-only      as logical      no-undo.
      423       define variable v-start-full-name   as character     no-undo.
      424       define variable v-start-sort-name   as character     no-undo.
      425       define variable v-not-found         as logical       no-undo.
      426       define variable v-is-terminal       as logical       no-undo.
      427       define buffer buf_fbr-gds-grp           for ub.fbr-gds-grp.
      428       create temp_found-result-nodelist.
      429       assign
      430           temp_found-result-nodelist.node-code = p-start-node-code
      431           temp_found-result-nodelist.processed = no
      432       .
      433       run fbrglib-get-full-name in this-procedure (
      434             input p-start-obj-type
      435           , input p-start-obj-code
      436           , input p-start-node-code
      437           , output v-start-full-name
      438       ).
      439       run fbrglib-get-full-name in this-procedure (
      440             input p-start-obj-type
      441           , input p-start-obj-code
      442           , input p-start-node-code
      443           , output v-start-sort-name
      444       ).
      445       process-nodes:
      446       do while yes
      447       :
      448           find first temp_found-result-nodelist
      449                where temp_found-result-nodelist.node-code = p-start-node-code
      450           .
      451           assign
      452               temp_found-result-nodelist.processed = yes
      453           .
      454           for each buf_fbr-gds-grp no-lock
      455              where buf_fbr-gds-grp.obj-type   = p-start-obj-type
      456                and buf_fbr-gds-grp.obj-code   = p-start-obj-code
      457                and buf_fbr-gds-grp.upper-code = p-start-node-code
      458           on error undo, return error
      459           :
      460               run fbrglib-is-terminal in this-procedure (
      461                     input buf_fbr-gds-grp.obj-type
      462                   , input buf_fbr-gds-grp.obj-code
      463                   , input buf_fbr-gds-grp.node-code
      464                   , output v-is-terminal
      465               ).
      466               if v-is-terminal = yes
      467               then do:
      468                   create temp_fbrglib_found-grp.
      469                   assign
      470                       temp_fbrglib_found-grp.full-name   = right-trim(v-start-full-name, chr(47)) +
      471                                                           chr(47) + buf_fbr-gds-grp.node-name + chr(47)
      472                       temp_fbrglib_found-grp.sort-name   = right-trim(v-start-sort-name, chr(2)) +
      473                                                           chr(2) + buf_fbr-gds-grp.node-name + chr(2)
      474                       temp_fbrglib_found-grp.node-code   = buf_fbr-gds-grp.node-code
      475                       temp_fbrglib_found-grp.is-terminal = yes
      476                       temp_fbrglib_found-grp.obj-type  = p-start-obj-type
      477                       temp_fbrglib_found-grp.obj-code  = p-start-obj-code
      478                   .
      479               end.
      480               else do:
      481                   create temp_found-result-nodelist.
      482                   assign
      483                       temp_found-result-nodelist.node-code = buf_fbr-gds-grp.node-code
      484                       temp_found-result-nodelist.full-name = right-trim(v-start-full-name, chr(47)) +
      485                                                              chr(47) + buf_fbr-gds-grp.node-name + chr(47)
      486                       temp_found-result-nodelist.sort-name = right-trim(v-start-sort-name, chr(2)) +
      487                                                              chr(2) + buf_fbr-gds-grp.node-name + chr(2)
      488                       temp_found-result-nodelist.processed = no
      489                   .
      490                   if p-terminal-only = no
      491                   then do:
      492                       create temp_fbrglib_found-grp.
      493                       assign
      494                           temp_fbrglib_found-grp.full-name   = right-trim(v-start-full-name, chr(47)) +
      495                                                               chr(47) + buf_fbr-gds-grp.node-name + chr(47)
      496                           temp_fbrglib_found-grp.sort-name   = right-trim(v-start-sort-name, chr(2)) +
      497                                                               chr(2) + buf_fbr-gds-grp.node-name + chr(2)
      498                           temp_fbrglib_found-grp.node-code   = buf_fbr-gds-grp.node-code
      499                           temp_fbrglib_found-grp.is-terminal = no
      500                           temp_fbrglib_found-grp.obj-type  = p-start-obj-type
      501                           temp_fbrglib_found-grp.obj-code  = p-start-obj-code
      502                       .
      503                   end.
      504               end.
      505           end.
      506           find first temp_found-result-nodelist
      507                where temp_found-result-nodelist.processed = no
      508           no-error.
      509           if not available temp_found-result-nodelist
      510           then do:
      511               leave process-nodes.
      512           end.
      513           else do:
      514               assign
      515                   p-start-node-code = temp_found-result-nodelist.node-code
      516                   v-start-full-name = temp_found-result-nodelist.full-name
      517                   v-start-sort-name = temp_found-result-nodelist.sort-name
      518               .
      519           end.
      520       end.
      521   end.
      522   end procedure.
      523   procedure fbrglib-expand-name :
      524   do
      525   on error undo, return error
      526   :
      527   define input parameter p-obj-type   as character    no-undo.
      528   define input parameter p-obj-code   as integer      no-undo.
      529   define input parameter p-start-name as character    no-undo.
      530   define output parameter p-end-name  as character    no-undo.
      531       define variable v-is-terminal     as logical           no-undo.
      532       define buffer buf_temp_fbrglib_found-grp     for temp_fbrglib_found-grp.
      533       run fbrglib-find-grp-by-full-name in this-procedure (
      534             input p-obj-type
      535           , input p-obj-code
      536           , input p-start-name
      537           , input no
      538       ) no-error.
      539       run fbrglib-get-max-substring in this-procedure (
      540              input p-obj-type
      541           ,  input p-obj-code
      542           ,  input length( p-start-name )
      543           , output p-end-name
      544       ) no-error .
      545       if error-status :error
      546       then do:
      547           assign
      548               p-end-name = ""
      549           .
      550       end.
      551       else do:
      552           find first temp_fbrglib_found-grp
      553                where temp_fbrglib_found-grp.full-name = p-end-name
      554                   AND temp_fbrglib_found-grp.obj-type  = p-obj-type
      555                   AND temp_fbrglib_found-grp.obj-code  = p-obj-code
      556                        no-error.
      557           if available temp_fbrglib_found-grp
      558           then do:
      559               find first buf_temp_fbrglib_found-grp
      560                    where buf_temp_fbrglib_found-grp.full-name begins p-end-name
      561                      and recid( buf_temp_fbrglib_found-grp ) <> recid( temp_fbrglib_found-grp )
      562                   AND temp_fbrglib_found-grp.obj-type  = p-obj-type
      563                   AND temp_fbrglib_found-grp.obj-code  = p-obj-code
      564               no-error.
      565               if not available buf_temp_fbrglib_found-grp
      566               then do:
      567                   run fbrglib-is-terminal in this-procedure (
      568                         input p-obj-type
      569                       , input p-obj-code
      570                       , input temp_fbrglib_found-grp.node-code
      571                       , output v-is-terminal
      572                   ).
      573               end.
      574           end.
      575       end.
      576   end.
      577   end procedure.
      578   procedure fbrglib-get-max-substring :
      579   do
      580   on error undo, return error
      581   :
      582   define input parameter p-obj-type as character no-undo .
      583   define input parameter p-obj-code as integer no-undo .
      584   define input parameter p-min-substring-length   as integer      no-undo.
      585   define output parameter p-substring             as character    no-undo.
      586           define variable v-char-counter  as integer           no-undo.
      587           define variable v-current-char  as character         no-undo.
      588           define variable v-names-counter  as integer           no-undo.
      589           define variable v-base-string   as character         no-undo.
      590           assign
      591               v-char-counter  = p-min-substring-length
      592           .
      593           find first temp_fbrglib_found-grp  where
      594                      temp_fbrglib_found-grp.obj-type  = p-obj-type
      595                   AND temp_fbrglib_found-grp.obj-code  = p-obj-code
      596           no-error.
      597           if not available temp_fbrglib_found-grp
      598           then do:
      599               undo, return error "fbrglib-get-max-substring: Нет строк для вычисления общей подстроки".
      600           end.
      601           else do:
      602               assign
      603                   v-base-string = temp_fbrglib_found-grp.full-name
      604               .
      605               counter-block:
      606               do while yes
      607               on error undo, return error "fbrglib-get-max-substring: Ошибка вычисления продолжения имени группы."
      608               :
      609                   assign
      610                       v-char-counter  = v-char-counter + 1
      611                       v-current-char  = substring( v-base-string, v-char-counter, 1 )
      612                       v-names-counter = 0
      613                   .
      614                   compare-block:
      615                   for each temp_fbrglib_found-grp
      616                   where temp_fbrglib_found-grp.obj-type  = p-obj-type
      617                   AND temp_fbrglib_found-grp.obj-code  = p-obj-code
      618                   :
      619                       assign
      620                           v-names-counter = v-names-counter + 1
      621                       .
      622                       if v-names-counter = 1
      623                       then do:
      624                           next compare-block.
      625                       end.
      626                       if substring( temp_fbrglib_found-grp.full-name, v-char-counter, 1 ) <> v-current-char
      627                       then do:
      628                           leave counter-block.
      629                       end.
      630                   end.
      631                   if v-names-counter = 1
      632                   then do:
      633                       assign
      634                           p-substring = v-base-string
      635                       .
      636                       return.
      637                   end.
      638               end.
      639               assign
      640                   p-substring = substring( v-base-string, 1, v-char-counter - 1 )
      641               .
      642           end.
      643   end.
      644   end procedure.
      645   procedure fbrglib-is-terminal :
      646   do
      647   on error undo, return error "Ошибка процедуры fbrglib-is-terminal"
      648   :
      649   define input parameter p-obj-type       as character    no-undo.
      650   define input parameter p-obj-code       as integer      no-undo.
      651   define input parameter p-node-code      as integer      no-undo.
      652   define output parameter p-is-terminal   as logical      no-undo.
      653       define buffer buf_fbr-gds-grp       for ub.fbr-gds-grp.
      654       find first buf_fbr-gds-grp no-lock
      655            where buf_fbr-gds-grp.obj-type   = p-obj-type
      656              and buf_fbr-gds-grp.obj-code   = p-obj-code
      657              and buf_fbr-gds-grp.upper-code = p-node-code
      658       no-error .
      659       if not available buf_fbr-gds-grp
      660       then do:
      661           assign
      662               p-is-terminal = yes
      663           .
      664       end.
      665       else do:
      666           assign
      667               p-is-terminal = no
      668           .
      669       end.
      670   end.
      671   end procedure.
      672   procedure fbrglib-have-goods :
      673   do
      674   on error undo, return error
      675   :
      676   define input parameter p-obj-type           as character    no-undo.
      677   define input parameter p-obj-code           as integer      no-undo.
      678   define input parameter p-node-code          as integer      no-undo.
      679   define output parameter p-have-fbr-gds-obj  as logical      no-undo.
      680       define buffer buf_fbr-gds-obj         for ub.fbr-gds-obj.
      681       find first buf_fbr-gds-obj no-lock
      682            where buf_fbr-gds-obj.obj-type     = p-obj-type
      683              and buf_fbr-gds-obj.obj-code     = p-obj-code
      684              and buf_fbr-gds-obj.fbr-grp-code = p-node-code
      685       no-error .
      686       if available buf_fbr-gds-obj
      687       then do:
      688           assign
      689               p-have-fbr-gds-obj = yes
      690           .
      691       end.
      692       else do:
      693           assign
      694               p-have-fbr-gds-obj = no
      695           .
      696       end.
      697   end.
      698   end procedure.
      699   procedure fbrglib-find-by-substring :
      700   do
      701   on error undo, return error
      702   :
      703   define input parameter p-start-obj-type     as character    no-undo.
      704   define input parameter p-start-obj-code     as integer      no-undo.
      705   define input parameter p-start-code         as integer      no-undo.
      706   define input parameter p-full-search-string as character    no-undo.
      707   define output parameter p-found-code        as integer      no-undo.
      708   define output parameter p-full-name         as character    no-undo.
      709       define variable v-start-code     as integer           no-undo.
      710       define variable v-found          as logical  init no  no-undo.
      711       define buffer buf_fbr-gds-grp       for ub.fbr-gds-grp.
      712       search-grp:
      713       for each buf_fbr-gds-grp no-lock
      714           where buf_fbr-gds-grp.obj-type  = p-start-obj-type
      715             and buf_fbr-gds-grp.obj-code  = p-start-obj-code
      716             and buf_fbr-gds-grp.node-code > p-start-code
      717       :
      718           if index( buf_fbr-gds-grp.node-name, p-full-search-string ) <> 0
      719           then do:
      720               assign
      721                   p-found-code = buf_fbr-gds-grp.node-code
      722                   v-found      = yes
      723               .
      724               run fbrglib-get-full-name in this-procedure (
      725                     input p-start-obj-type
      726                   , input p-start-obj-code
      727                   , input p-found-code
      728                   , output p-full-name
      729               ) no-error .
      730               if error-status :error
      731               then do:
      732                   undo, return error "fbrglib-find-by-substring: Ошибка вычисления полного имени группы." + chr(10) + return-value.
      733               end.
      734               leave search-grp.
      735           end.
      736       end.
      737       if v-found = yes
      738       then do:
      739       end.
      740       else do:
      741           assign
      742               p-full-name  = ""
      743               p-found-code = 0
      744           .
      745       end.
      746   end.
      747   end procedure.
      748   procedure fbrglib-analyze-grp-name :
      749   do
      750   on error undo, return error
      751   :
      752   define input parameter p-grp-name       as character            no-undo.
      753   define input parameter p-obj-type       as character            no-undo.
      754   define input parameter p-obj-code       as integer              no-undo.
      755   define input parameter p-upper-code     as integer              no-undo.
      756   define output parameter p-error-message as character init ""    no-undo.
      757       define variable v-char-list     as character    no-undo.
      758       define variable v-char-counter  as integer      no-undo.
      759       define variable v-full-name     as character    no-undo.
      760       if p-grp-name = "" then do:
      761           assign
      762               p-error-message = "Название группы не может быть пустым.".
      763           .
      764       end.
      765       else do:
      766           assign
      767               v-char-list = "47,92,58,63,34,60,62,171,187,183"
      768           .
      769           do v-char-counter = 1 to num-entries( v-char-list )
      770           :
      771               if index( p-grp-name, chr( integer( entry( v-char-counter, v-char-list ) ) ) ) <> 0
      772               then do:
      773                   assign
      774                       p-error-message = 'Название группы не может содержать символы /\:*?"<>|«»·'
      775                   .
      776                   return.
      777               end.
      778           end.
      779           run fbrglib-get-full-name in this-procedure (
      780                 input p-obj-type
      781               , input p-obj-code
      782               , input p-upper-code
      783               , output v-full-name
      784           ) no-error .
      785           if error-status :error
      786           then do:
      787               undo, return error "fbrglib-analyze-grp-name: Не удалось вычислить полное имя группы." + chr(10) + return-value.
      788           end.
      789           if length( v-full-name ) + 1 + length( p-grp-name ) > 120
      790           then do:
      791               assign
      792                   p-error-message = 'Полное название группы не может содержать более 120 символов.'
      793               .
      794           end.
      795       end.
      796   end.
      797   end procedure.
      798   procedure fbrglib-delete-grp :
      799   do
      800   on error undo, return error
      801   :
      802   define input parameter p-obj-type   as character    no-undo.
      803   define input parameter p-obj-code   as integer      no-undo.
      804   define input parameter p-node-code  as integer      no-undo.
      805   define output parameter p-deleted   as logical      no-undo.
      806       define variable v-have-goods    as logical        no-undo.
      807       define variable v-yesno         as logical        no-undo.
      808       define variable v-upper-code    as integer        no-undo.
      809       define variable v-root-code     as integer        no-undo.
      810       define buffer buf_fbr-gds-grp           for ub.fbr-gds-grp.
      811       define buffer buf_fbr-gds-obj           for ub.fbr-gds-obj.
      812       define buffer buf_second_fbr-gds-grp    for ub.fbr-gds-grp.
      813       run fbrglib-get-root-code in this-procedure (
      814           output v-root-code
      815       ) no-error.
      816       if error-status :error
      817       then do:
      818           undo, return error "Не найден корневой узел." + chr(10) + return-value.
      819       end.
      820       if p-node-code = v-root-code
      821       then do:
      822           message
      823               "Корневую группу удалить невозможно."
      824           view-as alert-box error.
      825           assign
      826               p-deleted = no
      827           .
      828           undo, return.
      829       end.
      830       find first buf_fbr-gds-grp no-lock
      831            where buf_fbr-gds-grp.obj-type     = p-obj-type
      832              and buf_fbr-gds-grp.obj-code     = p-obj-code
      833              and buf_fbr-gds-grp.upper-code   = p-node-code
      834       no-error.
      835       if available buf_fbr-gds-grp
      836       then do:
      837           message
      838               "Не терминальную группу удалить невозможно."
      839           view-as alert-box error.
      840           assign
      841               p-deleted = no
      842           .
      843           undo, return.
      844       end.
      845       find first buf_fbr-gds-grp no-lock
      846            where buf_fbr-gds-grp.obj-type     = p-obj-type
      847              and buf_fbr-gds-grp.obj-code     = p-obj-code
      848              and buf_fbr-gds-grp.node-code    = p-node-code
      849       .
      850       assign
      851           v-upper-code = buf_fbr-gds-grp.upper-code
      852       .
      853       run fbrglib-have-goods in this-procedure (
      854             input p-obj-type
      855           , input p-obj-code
      856           , input p-node-code
      857           , output v-have-goods
      858       ).
      859       if v-have-goods = yes
      860       then do:
      861           find first buf_second_fbr-gds-grp no-lock
      862                where buf_second_fbr-gds-grp.obj-type      = buf_fbr-gds-grp.obj-type
      863                  and buf_second_fbr-gds-grp.obj-code      = buf_fbr-gds-grp.obj-code
      864                  and buf_second_fbr-gds-grp.upper-code    = buf_fbr-gds-grp.upper-code
      865                  and recid( buf_second_fbr-gds-grp )      <> recid( buf_fbr-gds-grp )
      866           no-error.
      867           if available buf_second_fbr-gds-grp
      868           then do:
      869               message
      870                   "В группе есть товары,"
      871                   skip "которые нельзя перенести в родительскую группу,"
      872                   skip "потому что у родительской группы есть еще одна подгруппа."
      873                   skip(1)
      874                   skip "Перенесите товары в другую группу"
      875                   skip "или удалите все остальные подгруппы родительской группы."
      876               view-as alert-box error.
      877               assign
      878                   p-deleted = no
      879               .
      880               undo, return.
      881           end.
      882           message
      883               "В группе есть товары."
      884               skip "После удаления группы"
      885               skip "все ее товары будут привязаны"
      886               skip "к ее родительской группе."
      887               skip(1)
      888               skip "Удалить группу?"
      889           view-as alert-box warning
      890           buttons yes-no
      891           title "Удаление группы"
      892           update v-yesno
      893           .
      894           if v-yesno = yes
      895           then do:
      896               do transaction
      897               on error undo, return error
      898               :
      899                   for each buf_fbr-gds-obj exclusive-lock
      900                      where buf_fbr-gds-obj.obj-type     = p-obj-type
      901                        and buf_fbr-gds-obj.obj-code     = p-obj-code
      902                        and buf_fbr-gds-obj.fbr-grp-code = p-node-code
      903                   on error undo, return error
      904                   :
      905                       assign
      906                           buf_fbr-gds-obj.fbr-grp-code = v-upper-code
      907                       .
      908                   end.
      909               end.
      910               do transaction
      911               on error undo, return error
      912               :
      913                   find current buf_fbr-gds-grp exclusive-lock .
      914                   delete buf_fbr-gds-grp no-error .
      915                   if error-status:error then do:
      916                     undo, return error return-value .
      917                   end.
      918               end.
      919           end.
      920       end.
      921       else do:
      922           message
      923               "Имя группы: " buf_fbr-gds-grp.node-name
      924               "Код группы: " buf_fbr-gds-grp.node-code
      925               skip(1)
      926               skip "Удалить группу?"
      927           view-as alert-box warning
      928           buttons yes-no
      929           title "Удаление группы"
      930           update v-yesno
      931           .
      932           if v-yesno = yes
      933           then do:
      934               do transaction
      935               on error undo, return error
      936               :
      937                   find current buf_fbr-gds-grp exclusive-lock .
      938                   delete buf_fbr-gds-grp no-error.
      939                   if error-status:error then do:
      940                     undo, return error return-value .
      941                   end.
      942               end.
      943           end.
      944       end.
      945   end.
      946   end procedure.
      947   procedure fbrglib-add-grp :
      948   do
      949   on error undo, return error
      950   :
      951   define input parameter p-obj-type       as character    no-undo.
      952   define input parameter p-obj-code       as integer      no-undo.
      953   define input parameter p-node-code      as integer      no-undo.
      954   define input parameter p-interface      as logical      no-undo.
      955   define input parameter p-node-name      as character    no-undo.
      956   define input parameter p-out-code       as integer      no-undo.
      957   define input parameter p-global-code    as integer      no-undo.
      958   define output parameter p-new-node-code as integer      no-undo.
      959   define output parameter p-cancel        as logical      no-undo.
      960       define variable v-have-goods    as logical  no-undo.
      961       define variable v-host-code     as integer        no-undo.
      962       define buffer buf_fbr-gds-grp       for ub.fbr-gds-grp.
      963       define buffer bf_fbr-gds-grp        for ub.fbr-gds-grp.
      964       define buffer buf_fbr-gds-obj       for ub.fbr-gds-obj.
      965       run fbrglib-have-goods in this-procedure (
      966             input p-obj-type
      967           , input p-obj-code
      968           , input p-node-code
      969           , output v-have-goods
      970       ) no-error .
      971       if error-status :error
      972       then do:
      973           message
      974                    vss-workfile vss-revision vss-description
      975               skip "Ошибка определения наличия товаров в группе."
      976               skip return-value
      977               skip trim(error-status :get-message(1))
      978                    trim(error-status :get-message(2))
      979                    trim(error-status :get-message(3))
      980           view-as alert-box error.
      981           undo, return error .
      982       end.
      983   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      984   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      985     (input  p-obj-type
      986     ,input  p-obj-code
      987     ,output v-host-code
      988     )  .
      989       find first buf_fbr-gds-grp no-lock where
      990                 buf_fbr-gds-grp.upper-code = p-node-code
      991             AND buf_fbr-gds-grp.obj-type   = p-obj-type
      992             AND buf_fbr-gds-grp.obj-code   = p-obj-code
      993             AND buf_fbr-gds-grp.node-name  = p-node-name no-error .
      994       if available buf_fbr-gds-grp then do:
      995           if p-node-code <> 1 then do:
      996             find first buf_fbr-gds-grp no-lock where
      997                       buf_fbr-gds-grp.node-code = p-node-code
      998                   AND buf_fbr-gds-grp.obj-type   = p-obj-type
      999                   AND buf_fbr-gds-grp.obj-code   = p-obj-code  .
     1000           end.
     1001                   message
     1002           "Для объекта" p-obj-type p-obj-code
     1003           "уже есть группа блюд" p-node-name "в подгруппе" (if p-node-code = 1 then "БЛЮДА" else buf_Fbr-gds-grp.node-name)
     1004           view-as alert-box error .
     1005           undo, return error .
     1006       end.
     1007       do transaction
     1008       on error undo, return error
     1009       :
     1010           create buf_fbr-gds-grp.
     1011           assign
     1012               buf_fbr-gds-grp.node-code   = next-value( s-gds-grp, ub )
     1013               p-new-node-code             = buf_fbr-gds-grp.node-code
     1014               buf_fbr-gds-grp.upper-code  = p-node-code
     1015               buf_fbr-gds-grp.host-code   = v-host-code
     1016               buf_fbr-gds-grp.obj-type    = p-obj-type
     1017               buf_fbr-gds-grp.obj-code    = p-obj-code
     1018               buf_fbr-gds-grp.node-name    = ""
     1019               buf_fbr-gds-grp.out-code    = 0
     1020           .
     1021           if p-interface then do:
     1022             run ref/fbrggrpd.w (
     1023                   input parparentproc
     1024                 , input 'ИЗМЕНЕНИЕ':U
     1025                 , input p-obj-type
     1026                 , input p-obj-code
     1027                 , input buf_fbr-gds-grp.node-code
     1028                 , input buf_fbr-gds-grp.upper-code
     1029                 , input buf_fbr-gds-grp.node-name
     1030                 , input buf_fbr-gds-grp.out-code
     1031                 , output buf_fbr-gds-grp.node-name
     1032                 , output buf_fbr-gds-grp.out-code
     1033                 , output p-cancel
     1034             ).
     1035             if p-cancel = yes
     1036             then do:
     1037                 delete buf_fbr-gds-grp.
     1038                 undo, return.
     1039             end.
     1040           end.
     1041           else do:
     1042             find first bf_fbr-gds-grp no-lock
     1043                 where bf_fbr-gds-grp.obj-type   = p-obj-type
     1044                   and bf_fbr-gds-grp.obj-code   = p-obj-code
     1045                   and bf_fbr-gds-grp.out-code   = p-out-code
     1046             no-error.
     1047             assign
     1048             buf_fbr-gds-grp.node-name    = p-node-name
     1049             buf_fbr-gds-grp.global-code  = p-global-code
     1050             buf_fbr-gds-grp.out-code     = (if available bf_fbr-gds-grp then 0 else p-out-code)
     1051             .
     1052           end.
     1053           if v-have-goods = yes
     1054           then do:
     1055               for each buf_fbr-gds-obj exclusive-lock
     1056                  where buf_fbr-gds-obj.obj-type      = p-obj-type
     1057                    and buf_fbr-gds-obj.obj-code      = p-obj-code
     1058                    and buf_fbr-gds-obj.fbr-grp-code  = p-node-code
     1059               on error undo, return error
     1060               :
     1061                   assign
     1062                       buf_fbr-gds-obj.fbr-grp-code = p-new-node-code
     1063                   .
     1064               end.
     1065           end.
     1066       end.
     1067   end.
     1068   end procedure.
     1069   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1070   define  temp-table gds-list no-undo like ub.goods
