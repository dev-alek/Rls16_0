     5618         (if v-find then get-good(X_c-gds-hist.gds-code, output v-artic, output v-prod-type, output v-prod-code) else "":U )
     5619         @ v-gds-name
     5620         v-artic
     5621         (v-prod-type + string(v-prod-code)) @ v-prod
