     3151     then do:
     3152       ASSIGN
     3153         sch-corr-date :POPUP-MENU in frame Dialog-Frame = MENU m-ed-date21 :HANDLE
     3154         sch-corr-date :MENU-MOUSE in frame Dialog-Frame = 3
     3155       .
     3156     end.
