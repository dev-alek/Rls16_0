     1630     run proc-find-db-num in this-procedure(yes, input frame Dialog-Frame sch-db-num) no-error.
     1631     if error-status:error then return no-apply.
     1632   END.
     1633   ON RETURN OF sch-db-num IN FRAME Dialog-Frame
     1634   DO:
     1635     run proc-find-db-num in this-procedure(no, input frame Dialog-Frame sch-db-num) no-error.
     1636     if error-status:error then return no-apply.
     1637   END.
     1638   ON CTRL-J OF sch-gds-code IN FRAME Dialog-Frame
     1639   DO:
     1640     run proc-find-gds-code in this-procedure(yes, input frame Dialog-Frame sch-gds-code) no-error.
     1641     if error-status:error then return no-apply.
     1642   END.
     1643   ON RETURN OF sch-gds-code IN FRAME Dialog-Frame
     1644   DO:
     1645     run proc-find-gds-code in this-procedure(no, input frame Dialog-Frame sch-gds-code) no-error.
     1646     if error-status:error then return no-apply.
     1647   END.
     1648   ON RETURN OF v-corr-user-db-num IN FRAME Dialog-Frame
     1649   DO:
     1650     assign
     1651     v-corr-user-db-num
