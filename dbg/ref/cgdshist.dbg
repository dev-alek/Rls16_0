     1076   FUNCTION get-all-fields returns character (p-file-name as character ):
     1077   define variable v-dop as character no-undo .
     1078     find first _file no-lock where _file._file-name = p-file-name no-error .
     1079     if not available _file then return "":U.
     1080     for each _field no-lock where
     1081              _field._file-recid = recid(_file) :
     1082       assign
     1083       v-dop = v-dop + _field._field-name + chr(44)
     1084       .
     1085     end.
     1086     return trim(v-dop).
     1087   END FUNCTION.
     1088   PROCEDURE proc-full-temp-changes :
     1089     define input  parameter p-hst-handle as handle    no-undo .
     1090     define input  parameter p-main-table as character no-undo .
     1091     define input  parameter p-field-list as character no-undo .
     1092     define input  parameter p-label-form as character no-undo .
     1093     define variable h-new-buf         as handle    no-undo .
     1094     define variable h-main-buf        as handle    no-undo .
     1095     define variable h-for-comp        as handle    no-undo .
     1096     define variable v-inform          as character no-undo .
     1097     define variable v-ind             as integer   no-undo .
     1098     define variable v-idx-field-qnty  as integer   no-undo .
     1099     define variable v-num-entries     as integer   no-undo .
     1100     define variable fh                as handle    no-undo .
     1101     define variable fh-main           as handle    no-undo .
     1102     define variable fh-old            as handle    no-undo .
     1103     define variable fh-new            as handle    no-undo .
     1104     define variable v-field-name      as character no-undo .
     1105     define variable v-field-lvl       as character no-undo .
     1106     define variable v-field-form      as character no-undo .
     1107     define variable v-search-exp      as character no-undo .
     1108     define variable v-srch-main       as character no-undo .
     1109     define variable v-word-link       as character no-undo .
     1110     define variable v-av-chip-num     as logical   no-undo .
     1111     define variable v-main-pi-fld-lst as character no-undo .
     1112     define variable v-main-fld-lst    as character no-undo .
     1113     define variable v-delim-list      as character no-undo .
     1114     define variable v-label           as character no-undo .
     1115     define variable v-old-value       as character no-undo case-sensitive.
     1116     define variable v-new-value       as character no-undo case-sensitive.
     1117     define variable v-chg-fields as character no-undo.
     1118     for each temp-changes:
     1119       delete temp-changes.
     1120     end.
     1121     if not p-hst-handle:available then do:
     1122       return .
     1123     end.
     1124     create buffer h-new-buf  for table p-hst-handle .
     1125     create buffer h-main-buf for table p-main-table .
     1126     assign
     1127       v-inform = h-main-buf:index-information(1)
     1128       v-ind    = 2
     1129     .
     1130     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1131     on error undo, return error
     1132     :
     1133       assign
     1134         v-inform = h-main-buf:index-information( v-ind )
     1135         v-ind    = v-ind + 1
     1136       .
     1137     end.
     1138     if v-inform = ?
     1139       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1140       or entry( 3, v-inform, ",":U ) <> "1":U
     1141     then do:
     1142       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, h-main-buf:name ).
     1143     end.
     1144     assign
     1145       v-idx-field-qnty = num-entries( v-inform ) - 4
     1146     .
     1147     if v-idx-field-qnty < 2 then do:
     1148       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, h-main-buf:name ).
     1149     end.
     1150     assign
     1151       v-srch-main   = "where":U
     1152       v-word-link   = "":U
     1153       v-av-chip-num = false
     1154       v-delim-list  = "":U
     1155     .
     1156     do v-ind = 1 to v-idx-field-qnty by 2
     1157     on error undo, return error
     1158     :
     1159       assign
     1160         v-field-name      = entry( 4 + v-ind, v-inform, ",":U )
     1161         fh                = p-hst-handle:buffer-field( v-field-name )
     1162         fh-main           = h-main-buf:buffer-field( v-field-name )
     1163         v-srch-main       = substitute( "&1 &2 &3.&4 =", v-srch-main, v-word-link, fh-main:table, v-field-name )
     1164         v-main-pi-fld-lst = v-main-pi-fld-lst + v-delim-list + v-field-name
     1165       .
     1166       if fh:data-type ="character":U then do:
     1167         assign
     1168           v-srch-main = substitute( '&1 "&2"', v-srch-main, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
     1169         .
     1170       end.
     1171       else do:
     1172         assign
     1173           v-srch-main = substitute( "&1 &2", v-srch-main, fh:buffer-value() )
     1174         .
     1175       end.
     1176       if v-delim-list = "":U then do:
     1177         assign
     1178           v-delim-list = ",":U
     1179         .
     1180       end.
     1181       if v-word-link = "":U then do:
     1182         assign
     1183           v-word-link = "and":U
     1184         .
     1185       end.
     1186     end.
     1187     assign
     1188       v-delim-list  = "":U
     1189     .
     1190     do v-ind = 1 to h-main-buf:num-fields
     1191     on error undo, return error
     1192     :
     1193       assign
     1194         fh-main      = h-main-buf:buffer-field( v-ind )
     1195         v-field-name = fh-main:name
     1196       .
     1197         assign
     1198           v-main-fld-lst = v-main-fld-lst + v-delim-list + v-field-name
     1199         .
     1200         if v-delim-list = "":U then do:
     1201           assign
     1202             v-delim-list = ",":U
     1203           .
     1204         end.
     1205     end.
     1206     assign
     1207       v-inform = p-hst-handle:index-information(1)
     1208       v-ind    = 2
     1209     .
     1210     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1211     on error undo, return error
     1212     :
     1213       assign
     1214         v-inform = p-hst-handle:index-information( v-ind )
     1215         v-ind    = v-ind + 1
     1216       .
     1217     end.
     1218     if v-inform = ?
     1219       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1220       or entry( 3, v-inform, ",":U ) <> "1":U
     1221     then do:
     1222       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, p-hst-handle:name ).
     1223     end.
     1224     assign
     1225       v-idx-field-qnty = num-entries( v-inform ) - 4
     1226     .
     1227     if v-idx-field-qnty < 2 then do:
     1228       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, p-hst-handle:name ).
     1229     end.
     1230     assign
     1231       v-search-exp  = "where":U
     1232       v-word-link   = "":U
     1233       v-av-chip-num = false
     1234     .
     1235     do v-ind = 1 to v-idx-field-qnty by 2
     1236     on error undo, return error
     1237     :
     1238       assign
     1239         v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     1240         fh           = p-hst-handle:buffer-field( v-field-name )
     1241         v-search-exp = substitute( "&1 &2 &3.&4", v-search-exp, v-word-link, fh:table, v-field-name )
     1242       .
     1243       if v-field-name = "chip-num":U then do:
     1244         assign
     1245           v-search-exp  = substitute( "&1 >", v-search-exp )
     1246           v-av-chip-num = true
     1247         .
     1248       end.
     1249       else do:
     1250         assign
     1251           v-search-exp = substitute( "&1 =", v-search-exp )
     1252         .
     1253       end.
     1254       if fh:data-type ="character":U then do:
     1255         assign
     1256           v-search-exp = substitute( '&1 "&2"', v-search-exp, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
     1257         .
     1258       end.
     1259       else do:
     1260         assign
     1261           v-search-exp = substitute( '&1 &2', v-search-exp, fh:buffer-value() )
     1262         .
     1263       end.
     1264       if v-word-link = "":U then do:
     1265         assign
     1266           v-word-link = "and":U
     1267         .
     1268       end.
     1269     end.
     1270     if v-av-chip-num = false then do:
     1271       message
     1272         vss-workfile vss-revision vss-description skip
     1273         substitute( "Таблица &2 не содержит поля chip-num.", vss-workfile, p-hst-handle:name ) skip
     1274         "Использование данной процедуры невозможно!" skip
     1275         view-as alert-box error .
     1276       return error .
     1277     end.
     1278     h-new-buf:find-first( v-search-exp, no-lock ) no-error .
     1279     if not h-new-buf:available then do:
     1280       h-main-buf:find-first( v-srch-main, no-lock ) no-error .
     1281       if not h-main-buf:available then do:
     1282         assign
     1283           h-for-comp = ?
     1284         .
     1285       end.
     1286       else do:
     1287         assign
     1288           h-for-comp = h-main-buf
     1289         .
     1290       end.
     1291     end.
     1292     else do:
     1293       assign
     1294         h-for-comp = h-new-buf
     1295       .
     1296     end.
     1297     assign
     1298       v-num-entries = num-entries( v-main-fld-lst, ",":U )
     1299     .
     1300     do v-ind = 1 to v-num-entries
     1301     on error undo, return error return-value
     1302     :
     1303       assign
     1304         v-field-name = entry( v-ind, v-main-fld-lst )
     1305         fh-old       = p-hst-handle:buffer-field( v-field-name )
     1306         v-old-value  = fh-old:buffer-value()
     1307         v-label      = trim( fh-old:label )
     1308       .
     1309       if ( trim( p-field-list ) <> "":U
     1310            and lookup( v-field-name, p-field-list ) > 0
     1311          )
     1312          or trim( p-field-list ) = "":U
     1313       then do:
     1314         if h-for-comp <> ? then do:
     1315           assign
     1316             fh-new      = h-for-comp:buffer-field( v-field-name )
     1317             v-new-value = fh-new:buffer-value()
     1318           .
     1319         end.
     1320         else do:
     1321           assign
     1322             v-new-value = "":U
     1323           .
     1324         end.
     1325         if v-old-value <> v-new-value
     1326         then do:
     1327           create temp-changes.
     1328           assign
     1329             temp-changes.t_name = p-main-table
     1330             temp-changes.f_name = v-field-name
     1331             temp-changes.l_name = replace( v-label, "&":U, "":U )
     1332             temp-changes.v_old  = trim( v-old-value )
     1333             temp-changes.v_new  = trim( v-new-value )
     1334             temp-changes.num_   = 0
     1335             temp-changes.fNotChange = v-old-value eq v-new-value
     1336           .
     1337         end.
     1338       end.
     1339     end.
     1340     assign
     1341       v-num-entries = num-entries( p-label-form, chr(8) )
     1342     .
     1343     do v-ind = 1 to v-num-entries
     1344     on error undo, return error return-value
     1345     :
     1346       if num-entries( entry( v-ind, p-label-form, chr(8) ), chr(4) ) = 3 then do:
     1347         assign
     1348           v-field-name = entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1349           v-field-lvl  = entry( 2, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1350           v-field-form = entry( 3, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1351         .
     1352         find first temp-changes
     1353           where temp-changes.f_name = v-field-name
     1354           no-error .
     1355         if available temp-changes then do:
     1356           if trim( v-field-lvl ) <> "":U then do:
     1357             assign
     1358               temp-changes.l_name = v-field-lvl
     1359             .
     1360           end.
     1361           if trim( v-field-form ) <> "":U then do:
     1362             assign
     1363               temp-changes.v_old = dynamic-function( v-field-form, temp-changes.v_old )
     1364             .
     1365             if h-for-comp <> ? then do:
     1366               assign
     1367                 temp-changes.v_new = dynamic-function( v-field-form, temp-changes.v_new )
     1368               .
     1369             end.
     1370           end.
     1371         end.
     1372       end.
     1373       else do:
     1374         message
     1375           vss-workfile vss-revision vss-description skip
     1376           "Ошибка! Список должен содержать три поля с разделителем delim-par!" skip
     1377           substitute( "список для поля '&1': '&2'"
     1378                       ,entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1379                       ,entry( v-ind, p-label-form, chr(8) )
     1380                     ) skip
     1381           substitute( "полный список: &2", p-label-form ) skip
     1382           view-as alert-box error .
     1383       end.
     1384     end.
     1385     delete object h-new-buf .
     1386     delete object h-main-buf .
     1387   END PROCEDURE.
     1388   FUNCTION get-action RETURNS CHARACTER
     1389     ( p-action as integer )  FORWARD.
     1390   FUNCTION get-good RETURNS CHARACTER
     1391     ( p-gds-code as integer, output p-artic as character, output p-prod-type as character, output p-prod-code as integer )  FORWARD.
     1392   FUNCTION get-source-type RETURNS CHARACTER
     1393     ( p-source-type as character )  FORWARD.
     1394   FUNCTION get-subject RETURNS CHARACTER
     1395     ( p-subject as character )  FORWARD.
     1396   DEFINE BUTTON B-gds-obj
     1397        LABEL "&Остатки"
     1398        SIZE 10 BY 1.
     1399   DEFINE BUTTON B-Help
     1400        LABEL "Помо&щь"
     1401        SIZE 3 BY 1
     1402        BGCOLOR 8 .
     1403   DEFINE BUTTON B-lookup
     1404        LABEL "&Товар"
     1405        SIZE 10 BY 1.
     1406   DEFINE BUTTON B-mark
     1407        LABEL "&*"
     1408        SIZE 3 BY 1.
     1409   DEFINE BUTTON B-print
     1410        LABEL "Пе&чать"
     1411        SIZE 3 BY 1.
     1412   DEFINE BUTTON b-quit AUTO-END-KEY
     1413        LABEL "&Выход"
     1414        SIZE 10 BY 1
     1415        BGCOLOR 8 .
     1416   DEFINE BUTTON B-sch
     1417        LABEL "&Фильтр"
     1418        SIZE 3 BY 1.
     1419   DEFINE BUTTON b-sel AUTO-GO
     1420        LABEL "Вы&бор"
     1421        SIZE 10 BY 1
     1422        BGCOLOR 8 .
     1423   DEFINE VARIABLE mark-num AS CHARACTER FORMAT "X(256)":U
     1424         VIEW-AS TEXT
     1425        SIZE 6 BY 1
     1426        FGCOLOR 4  NO-UNDO.
     1427   DEFINE VARIABLE sch-corr-date AS DATE FORMAT "99/99/9999":U
     1428        LABEL "Дате изменения"
     1429        VIEW-AS FILL-IN
     1430        SIZE 11 BY 1 NO-UNDO.
     1431   DEFINE VARIABLE sch-corr-user-name AS CHARACTER FORMAT "X(9)":U
     1432        LABEL "пользователю"
     1433        VIEW-AS FILL-IN
     1434        SIZE 9 BY 1 TOOLTIP "Поиск первой записи - <ВВОД>; поиск следующей - <CTRL-J>" NO-UNDO.
     1435   DEFINE VARIABLE sch-db-num AS INTEGER FORMAT ">>>>>>9":U INITIAL 0
     1436        LABEL "БД"
     1437        VIEW-AS FILL-IN
     1438        SIZE 8 BY 1 TOOLTIP "Поиск первой записи - <ВВОД>; поиск следующей - <CTRL-J>" NO-UNDO.
     1439   DEFINE VARIABLE sch-gds-code AS INTEGER FORMAT ">>>>>>>>>9":U INITIAL 0
     1440        LABEL "коду товара"
     1441        VIEW-AS FILL-IN
     1442        SIZE 11 BY 1 TOOLTIP "Поиск первой записи - <ВВОД>; поиск следующей - <CTRL-J>" NO-UNDO.
     1443   DEFINE VARIABLE v-corr-user-db-num AS INTEGER FORMAT ">>>>9":U INITIAL 0
     1444        LABEL "по БД"
     1445        VIEW-AS FILL-IN
     1446        SIZE 5 BY 1 NO-UNDO.
     1447   DEFINE QUERY BR-changes FOR
     1448         temp-changes SCROLLING.
     1449   DEFINE QUERY BR-gds-hist FOR
     1450         X_c-gds-hist SCROLLING.
     1451   DEFINE BROWSE BR-changes
     1452     QUERY BR-changes DISPLAY
     1453         temp-changes.l_name COLUMn-LABEL "Изменилось" format "X(40)"
     1454   temp-changes.v_old COLUMn-LABEL "Было" format "X(70)"
     1455   temp-changes.v_new COLUMn-LABEL "Стало" format "X(70)"
     1456       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 7.25.
     1457   DEFINE BROWSE BR-gds-hist
     1458     QUERY BR-gds-hist NO-LOCK DISPLAY
     1459         mark-string(recid(X_c-gds-hist), v-rid-list) COLUMN-LABEL "*" FORMAT "X(1)":U
     1460     X_c-gds-hist.gds-code FORMAT "9999999999":U
     1461     X_c-gds-hist.corr-date FORMAT "99/99/9999":U
     1462     string(X_c-gds-hist.corr-time, "HH:MM:SS":U) COLUMN-LABEL "Время изм." FORMAT "X(8)":U
     1463     usrfulnf(X_c-gds-hist.corr-user-name) column-label 'Изменил' FORMAT "X(8)":U
     1464     get-action(X_c-gds-hist.action) COLUMN-LABEL "Действие" FORMAT "X(10)":U
     1465     X_c-gds-hist.corr-user-db-num FORMAT ">>>>9":U
     1466     X_c-gds-hist.is-news FORMAT "+/":U
     1467     get-source-type(X_c-gds-hist.source-type) COLUMN-LABEL "Источн.!измен."
     1468     X_c-gds-hist.source-ref FORMAT "X(14)":U
     1469     if v-find then get-good(X_c-gds-hist.gds-code, output v-artic, output v-prod-type, output v-prod-code) else "":U COLUMN-LABEL "Назв. товара" FORMAT "X(25)":U
     1470     v-artic COLUMN-LABEL "Артикул" FORMAT "X(14)":U
     1471     v-prod-type + string(v-prod-code) COLUMN-LABEL "Пр-ль" FORMAT "X(12)":U
     1472     get-subject(X_c-gds-hist.subject) COLUMN-LABEL "Предмет изменений" FORMAT "X(55)":U width 15
     1473     X_c-gds-hist.host-code COLUMN-LABEL "Фирма" FORMAT "999999999":U
     1474     X_c-gds-hist.obj-type + string(X_c-gds-hist.obj-code) COLUMN-LABEL "Объект" FORMAT "X(8)":U
     1475   ENABLE
     1476     X_c-gds-hist.is-news
     1477       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 11.46.
     1478   DEFINE FRAME Dialog-Frame
     1479        b-quit AT ROW 1 COL 1
     1480        B-mark AT ROW 1 COL 11
     1481        b-sel AT ROW 1 COL 21
     1482        v-corr-user-db-num AT ROW 1 COL 37 COLON-ALIGNED
     1483        B-gds-obj AT ROW 1 COL 55
     1484        B-print AT ROW 1 COL 89
     1485        B-sch AT ROW 1 COL 92
     1486        B-Help AT ROW 1 COL 95
     1487        B-lookup AT ROW 1.04 COL 45
     1488        BR-gds-hist AT ROW 2 COL 1
     1489        sch-db-num AT ROW 13.63 COL 60.13 COLON-ALIGNED
     1490        sch-corr-date AT ROW 13.63 COL 85.75 COLON-ALIGNED
     1491        sch-gds-code AT ROW 13.67 COL 44.75 COLON-ALIGNED
     1492        sch-corr-user-name AT ROW 13.71 COL 22.5 COLON-ALIGNED
     1493        BR-changes AT ROW 14.79 COL 1
     1494        mark-num AT ROW 1 COL 12.5 COLON-ALIGNED NO-LABEL
     1495        "ПОИСК ПО" VIEW-AS TEXT
     1496             SIZE 8.38 BY 1 AT ROW 13.63 COL 1.38
     1497             FGCOLOR 4
     1498        SPACE(89.48) SKIP(7.44)
     1499       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1500            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1501            TITLE "Полная история по товару"
     1502            CANCEL-BUTTON b-quit.
     1503   ASSIGN
     1504          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1505          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1506   ASSIGN
     1507          BR-gds-hist:COLUMN-RESIZABLE IN FRAME Dialog-Frame       = TRUE.
     1508   ON GO OF FRAME Dialog-Frame
     1509   DO:
     1510     p-rid-list = v-rid-list.
     1511   END.
     1512   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1513   DO:
     1514     APPLY "END-ERROR":U TO SELF.
     1515   END.
     1516   ON CHOOSE OF B-gds-obj IN FRAME Dialog-Frame
     1517   DO:
     1518     if avail X_c-gds-hist or p-gds-code <> ? then
     1519     do:
     1520     run ref/cgdsobj.w
     1521       (
     1522        input parparentproc
     1523       ,input p-curr-obj-type
     1524       ,input p-curr-obj-code
     1525       ,input if p-gds-code <> ? then p-gds-code else X_c-gds-hist.gds-code
     1526       ) no-error.
     1527     if error-status :error
     1528     then do:
     1529       return no-apply.
     1530     end.
     1531     end.
     1532   END.
     1533   ON CHOOSE OF B-lookup IN FRAME Dialog-Frame
     1534   DO:
     1535   run str/showgds.p (input parparentproc
     1536                 ,input ?
     1537                 ,input X_c-gds-hist.gds-code
     1538                 ,input 'ПРОСМОТР':U) no-error.
     1539   if error-status:error then return no-apply.
     1540   END.
     1541   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
     1542   DO:
     1543   define variable loc#log as logical no-undo .
     1544     if available X_c-gds-hist then do:
     1545   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1546   define variable v-str-recid14 as character no-undo .
     1547   define variable v-num-entry14 as integer   no-undo .
     1548   assign
     1549     v-str-recid14 = trim( string( recid( X_c-gds-hist ) , "->>>>>>>>>>>9":U ) )
     1550     v-num-entry14 = lookup( v-str-recid14 , v-rid-list )
     1551   .
     1552   if v-num-entry14 > 0 then do:
     1553     assign
     1554       entry( v-num-entry14, v-rid-list ) = "":U
     1555       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1556     .
     1557   end.
     1558   else do:
     1559     assign
     1560       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid14
     1561     .
     1562   end.
     1563       loc#log = br-gds-hist:refresh() .
     1564       if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
     1565           loc#log = br-gds-hist:select-next-row ().
     1566           apply "VALUE-CHANGED" to br-gds-hist in frame Dialog-Frame.
     1567       end.
     1568       if num-entries( v-rid-list ) = 0
     1569       then
     1570           hide mark-num in frame Dialog-Frame.
     1571       else
     1572           disp num-entries( v-rid-list ) @ mark-num with frame Dialog-Frame.
     1573     end.
     1574     apply "entry" to br-gds-hist in frame Dialog-Frame.
     1575   END.
     1576   ON CHOOSE OF B-print IN FRAME Dialog-Frame
     1577   DO:
     1578       run proc-b-print in this-procedure no-error.
     1579     if error-status:error then return no-apply.
     1580   END.
     1581   ON CHOOSE OF B-sch IN FRAME Dialog-Frame
     1582   DO:
     1583       run proc-b-sch in this-procedure no-error.
     1584     if error-status:error then return no-apply.
     1585   END.
     1586   ON CHOOSE OF b-sel IN FRAME Dialog-Frame
     1587   DO:
     1588     if ( available X_c-gds-hist ) then do:
     1589       if ( v-rid-list = "" ) or b-mark:sensitive = no
     1590       then
     1591       v-rid-list = string( recid( X_c-gds-hist ) ) .
     1592     end.
     1593   END.
     1594   ON MOUSE-SELECT-DBLCLICK OF BR-gds-hist IN FRAME Dialog-Frame
     1595   DO:
     1596        run proc-br-gds-hist in this-procedure no-error.
     1597     if error-status:error then return no-apply.
