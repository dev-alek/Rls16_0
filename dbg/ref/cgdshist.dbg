     1620     run proc-find-user in this-procedure(yes, input frame Dialog-Frame sch-corr-user-name) no-error.
     1621     if error-status:error then return no-apply.
     1622   END.
     1623   ON RETURN OF sch-corr-user-name IN FRAME Dialog-Frame
     1624   DO:
     1625     run proc-find-user in this-procedure(no, input frame Dialog-Frame sch-corr-user-name) no-error.
     1626     if error-status:error then return no-apply.
     1627   END.
     1628   ON CTRL-J OF sch-db-num IN FRAME Dialog-Frame
