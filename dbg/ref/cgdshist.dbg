     3089           ).
     3090         assign
     3091           self :screen-value = string(v-new-sv-date) .
     3092         .
     3093       end.
     3094     end.
     3095     return no-apply .
     3096   end.
     3097   on ctrl-f of sch-corr-date in frame Dialog-Frame
     3098   do:
     3099     if (can-query (self, "sensitive")
     3100        and
     3101        self :sensitive = true
     3102        )
     3103     or (can-query (self, "read-only")
     3104        and
     3105        self :read-only = false
     3106        )
     3107     then do:
     3108       if self :handle <> focus :handle
     3109       then do:
     3110         apply "entry":u to self .
     3111       end.
     3112       define variable v-ok            as logical   no-undo .
     3113       define variable v-curr-sv-date  as date      no-undo .
     3114       define variable v-description   as character no-undo .
     3115       assign
     3116         v-curr-sv-date = date(self :screen-value) no-error
     3117       .
     3118       if v-curr-sv-date = ?
     3119       then do:
     3120         run gbl/getcurdt.p
     3121           (output v-curr-sv-date
     3122           ) .
     3123       end.
     3124       if v-curr-sv-date <> ?
     3125       then do:
     3126         run gbl/d-inpday.w
     3127           (input ?
     3128           ,input "Выбор даты"
     3129           ,input v-description
     3130           ,input ""
     3131           ,input-output v-curr-sv-date
     3132           ,output v-ok
     3133           ).
     3134         if v-ok = true
     3135         then do:
     3136           assign
     3137             self :screen-value = string(v-curr-sv-date) .
     3138           .
     3139         end.
     3140       end.
     3141     end.
     3142     return no-apply .
     3143   end.
     3144     define MENU m-ed-date21
     3145       MENU-ITEM m-ed-date21-1 LABEL "Начало месяца" ACCELERATOR "ALT-1"
     3146       MENU-ITEM m-ed-date21-2 LABEL "Сегодня"       ACCELERATOR "ALT-2"
     3147       MENU-ITEM m-ed-date21-3 LABEL "Конец месяца"  ACCELERATOR "ALT-3"
     3148       MENU-ITEM m-ed-date21-4 LABEL "Календарь"     ACCELERATOR "ALT-4"
     3149       .
