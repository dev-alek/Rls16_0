     2960   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2961   on ' ' of sch-corr-date in frame Dialog-Frame
     2962   do:
     2963     if (can-query (self, "sensitive")
     2964        and
     2965        self :sensitive = true
     2966        )
     2967     or (can-query (self, "read-only")
     2968        and
     2969        self :read-only = false
     2970        )
     2971     then do:
     2972       assign
     2973         self :screen-value = ?
     2974       .
     2975     end.
     2976     return no-apply.
     2977   end.
     2978   on delete-character of sch-corr-date in frame Dialog-Frame
     2979   do:
     2980     if (can-query (self, "sensitive")
     2981        and
     2982        self :sensitive = true
     2983        )
     2984     or (can-query (self, "read-only")
     2985        and
     2986        self :read-only = false
     2987        )
     2988     then do:
     2989       assign
     2990         self :screen-value = ?
     2991       .
     2992     end.
     2993     return no-apply.
     2994   end.
     2995   on ctrl-d of sch-corr-date in frame Dialog-Frame
     2996   do:
     2997     define variable v-curr-sv-date as date no-undo .
     2998     if (can-query (self, "sensitive")
     2999        and
     3000        self :sensitive = true
     3001        )
     3002     or (can-query (self, "read-only")
     3003        and
     3004        self :read-only = false
     3005        )
     3006     then do:
     3007       if self :handle <> focus :handle
     3008       then do:
     3009         apply "entry":u to self .
     3010       end.
     3011       run gbl/getcurdt.p
     3012         (output v-curr-sv-date
     3013         ) .
     3014       assign
     3015         self :screen-value = string(v-curr-sv-date) .
     3016       .
     3017     end.
     3018     return no-apply.
     3019   end.
     3020   on ctrl-b of sch-corr-date in frame Dialog-Frame
     3021   do:
     3022     if (can-query (self, "sensitive")
     3023        and
     3024        self :sensitive = true
     3025        )
     3026     or (can-query (self, "read-only")
     3027        and
     3028        self :read-only = false
     3029        )
     3030     then do:
     3031       if self :handle <> focus :handle
     3032       then do:
     3033         apply "entry":u to self .
     3034       end.
     3035       define variable v-curr-sv-date as date no-undo .
     3036       define variable v-new-sv-date  as date no-undo .
     3037       assign
     3038         v-curr-sv-date = date(self :screen-value) no-error
     3039       .
     3040       if v-curr-sv-date = ?
     3041       then do:
     3042         run gbl/getcurdt.p
     3043           (output v-curr-sv-date
     3044           ) .
     3045       end.
     3046       if v-curr-sv-date <> ?
     3047       then do:
     3048         assign
     3049           v-new-sv-date = date( month(v-curr-sv-date), 1, year(v-curr-sv-date))
     3050         .
     3051         assign
     3052           self :screen-value = string(v-new-sv-date) .
     3053         .
     3054       end.
     3055     end.
     3056     return no-apply .
     3057   end.
     3058   on ctrl-e of sch-corr-date in frame Dialog-Frame
     3059   do:
     3060     if (can-query (self, "sensitive")
     3061        and
     3062        self :sensitive = true
     3063        )
     3064     or (can-query (self, "read-only")
     3065        and
     3066        self :read-only = false
     3067        )
     3068     then do:
     3069       if self :handle <> focus :handle
     3070       then do:
     3071         apply "entry":u to self .
     3072       end.
     3073       define variable v-curr-sv-date as date no-undo .
     3074       define variable v-new-sv-date  as date no-undo .
     3075       assign
     3076         v-curr-sv-date = date(self :screen-value) no-error
     3077       .
     3078       if v-curr-sv-date = ?
     3079       then do:
     3080         run gbl/getcurdt.p
     3081           (output v-curr-sv-date
     3082           ) .
     3083       end.
     3084       if v-curr-sv-date <> ?
     3085       then do:
