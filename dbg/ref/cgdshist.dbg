     1653     RUn OpenBR(yes, no, '':U, v-corr-user-db-num).
     1654   END.
     1655   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1656   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1657   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1658   on help of frame Dialog-Frame
     1659   do:
     1660     run gbl/app_help.p
     1661       (input this-procedure :file-name
     1662       ,input ''
     1663       ,input ?
     1664       ) no-error.
     1665     if error-status :error then do:
     1666       message
     1667         "Ошибка при вызове помощи"
     1668         error-status :get-message(1)
     1669         view-as alert-box .
     1670     end.
     1671   end.
     1672   run minbtn-set in this-procedure .
     1673   on choose of b-help in frame Dialog-Frame
     1674   do:
     1675     apply "help":u to frame Dialog-Frame .
     1676   end.
     1677   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1678   procedure minbtn-set :
     1679       do
     1680           on error undo, return error return-value
     1681           :
     1682           define variable ii              as integer       no-undo .
     1683           define variable fh              as widget-handle no-undo .
     1684           define variable hh              as widget-handle no-undo .
     1685           define variable v-h             as handle        extent 4 no-undo .
     1686           define variable v-name-button   as character     no-undo .
     1687           define variable v-help-old-x    as decimal       no-undo .
     1688           define variable v-help-old-y    as decimal       no-undo .
     1689           define variable v-help-old-size as decimal       no-undo .
     1690           define variable v-frame-width   as decimal       no-undo .
     1691           define variable jj              as integer       no-undo .
     1692           do
     1693               on error undo, return error
     1694               :
     1695               assign
     1696                   v-frame-width = frame Dialog-Frame:width - 0.3
     1697                   fh            = frame Dialog-Frame:first-child
     1698                   hh            = fh:first-child
     1699                   ii            = 1
     1700                   .
     1701               do while valid-handle(hh):
     1702                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1703                   do:
     1704                       case lc(hh:name) :
     1705                           when "b-help" then
     1706                               do:
     1707                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1708                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1709                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1710                                   hh:TOOLTIP = "Помощь" .
     1711                                   v-help-old-x = hh:column .
     1712                                   v-help-old-y = hh:row    .
     1713                                   v-help-old-size = hh:width .
     1714                                   hh:width-chars = 2.5 .
     1715                               end.
     1716                           when "b-print" then
     1717                               do:
     1718                                   hh:load-image("cmp/b-print.bmp":u) .
     1719                                   hh:TOOLTIP = "Печать" .
     1720                                   v-h[ii] = hh:handle .
     1721                                   ii = ii + 1 .
     1722                                   hh:width-chars = 3 .
     1723                               end.
     1724                           when "b-history" or
     1725                           when "b-hist" then
     1726                               do:
     1727                                   hh:load-image("cmp/b-hist.bmp":u) .
     1728                                   hh:TOOLTIP = "История" .
     1729                                   v-h[ii] = hh:handle .
     1730                                   ii = ii + 1 .
     1731                                   hh:width-chars = 3 .
     1732                               end.
     1733                           when "b-sch" then
     1734                               do:
     1735                                   hh:load-image("cmp/b-sch.bmp":u) .
     1736                                   hh:TOOLTIP = "Установка Фильтра" .
     1737                                   v-h[ii] = hh:handle .
     1738                                   ii = ii + 1 .
     1739                                   hh:width-chars = 3 .
     1740                               end.
     1741                           when "b-hist-user" then
     1742                               do:
     1743                                   hh:load-image("cmp/b-hist.bmp":u) .
     1744                                   hh:TOOLTIP = "История пользователя" .
     1745                                   ii = ii + 1 .
     1746                               end.
     1747                       end case.
     1748                   end.
     1749                   hh = hh:next-sibling.
     1750               end.
     1751               b-help:column = v-frame-width - b-help:width-chars.
     1752               jj = 0.
     1753               repeat ii = 4 to 1 by -1 :
     1754                   if valid-handle (v-h[ii] ) then
     1755                   do:
     1756                       jj  = jj + 1 .
     1757                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1758                       v-h[ii]:row    = v-help-old-y .
     1759                   end.
     1760               end.
     1761           end.
     1762       end.
     1763   end procedure.
     1764   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1765   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1766   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1767   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1768   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1769   define variable v-diasize-current-frame-height as decimal   no-undo .
     1770   define variable v-diasize-change-size          as logical   no-undo .
     1771   define variable v-diasize-resize-button        as handle    no-undo .
     1772   define variable v-diasize-wndmax               as logical   no-undo .
     1773   define variable v-diasize-wndstore             as logical   no-undo .
     1774   define variable v-diasize-proc-name            as character no-undo .
     1775   define variable v-diasize-browse-handle        as handle    no-undo .
     1776   define variable v-diasize-browse-number        as integer   no-undo .
     1777   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1778   define temp-table temp-diasize-handle no-undo
     1779     field handle-value  as handle
     1780     field save-position as decimal
     1781     index xpk is primary unique handle-value
     1782     .
     1783   define temp-table temp-browse-handle no-undo
     1784     field browse-type   as character
     1785     field browse-number as integer
     1786     field browse-handle as handle
     1787     field original-size as decimal
     1788     index xpk is primary unique browse-type browse-number
     1789     index xie browse-type browse-handle
     1790   .
     1791   procedure diasize_change-height :
     1792     define input  parameter p-change-value  as decimal   no-undo .
     1793     define input  parameter p-move-resize   as logical   no-undo .
     1794     define variable v-field-group-handle    as handle    no-undo .
     1795     define variable v-object-handle         as handle    no-undo .
     1796     define variable v-frame-height          as decimal   no-undo .
     1797     define variable v-frame-virtual-height  as decimal   no-undo .
     1798     define variable v-browse-height         as decimal   no-undo .
     1799     define variable v-window-height         as decimal   no-undo .
     1800     define variable v-window-virtual-height as decimal   no-undo .
     1801     define variable v-change-sign           as integer   no-undo .
     1802     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1803     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1804     if p-change-value > 0
     1805     then do:
     1806       if frame Dialog-Frame :height + p-change-value
     1807           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1808       then do:
     1809         assign
     1810           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1811                           - (frame Dialog-Frame :height-chars)
     1812         .
     1813         if p-change-value <= 0
     1814         then do:
     1815           run diasize_position-resize-button in this-procedure .
     1816           return .
     1817         end.
     1818       end.
     1819     end.
     1820     if p-change-value < 0
     1821     then do:
     1822       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1823       then do:
     1824         assign
     1825           p-change-value = v-diasize-orig-frame-height
     1826                          - (frame Dialog-Frame :height-chars)
     1827         .
     1828         if p-change-value >= 0
     1829         then do:
     1830           run diasize_position-resize-button in this-procedure .
     1831           return .
     1832         end.
     1833       end.
     1834     end.
     1835     if p-change-value >= 0
     1836     then do:
     1837       assign
     1838         v-change-sign = 1
     1839       .
     1840     end.
     1841     else do:
     1842       assign
     1843         v-change-sign = -1
     1844       .
     1845     end.
     1846     assign
     1847       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1848     .
     1849     if p-change-value = 0
     1850     then do:
     1851       run diasize_position-resize-button in this-procedure .
     1852       return .
     1853     end.
     1854     move_block:
     1855     do
     1856     on error undo move_block, retry move_block
     1857     :
     1858       if retry
     1859       then do:
     1860         do
     1861         on error undo move_block, leave move_block
     1862         :
     1863           if p-change-value > 0
     1864           then do:
     1865             for each buf_temp-diasize-handle
     1866             on error undo, next
     1867             :
     1868               assign
     1869                 v-object-handle = buf_temp-diasize-handle.handle-value
     1870               .
     1871               if v-object-handle <> v-diasize-resize-button
     1872               then do:
     1873                 assign
     1874                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1875                 .
     1876               end.
     1877             end.
     1878             assign
     1879               v-diasize-browse-handle :height = v-browse-height
     1880             .
     1881             for each buf_temp-browse-handle
     1882               where buf_temp-browse-handle.browse-type = 'height':u
     1883             on error undo, next
     1884             :
     1885               assign
     1886                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1887               .
     1888             end.
     1889             assign
     1890               frame Dialog-Frame :height = v-frame-height
     1891             .
     1892             if frame Dialog-Frame :scrollable = true
     1893             then do:
     1894               assign
     1895                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1896               .
     1897             end.
     1898             run diasize_position-resize-button in this-procedure .
     1899           end.
     1900           else do:
     1901             if frame Dialog-Frame :scrollable = true
     1902             then do:
     1903               assign
     1904                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1905               .
     1906             end.
     1907             assign
     1908               frame Dialog-Frame :height = v-frame-height
     1909             .
     1910             assign
     1911               v-diasize-browse-handle :height = v-browse-height
     1912             .
     1913             for each buf_temp-browse-handle
     1914               where buf_temp-browse-handle.browse-type = 'height':u
     1915             on error undo, next
     1916             :
     1917               assign
     1918                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1919               .
     1920             end.
     1921             for each buf_temp-diasize-handle
     1922             on error undo, next
     1923             :
     1924               assign
     1925                 v-object-handle = buf_temp-diasize-handle.handle-value
     1926               .
     1927               if v-object-handle <> v-diasize-resize-button
     1928               then do:
     1929                 assign
     1930                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1931                 .
     1932               end.
     1933             end.
     1934             run diasize_position-resize-button in this-procedure .
     1935           end.
     1936           assign
     1937             v-diasize-change-size = false
     1938           .
     1939           leave move_block .
     1940         end.
     1941       end.
     1942       assign
     1943         v-diasize-need-full-display = true
     1944       .
     1945       if v-diasize-change-size = false
     1946       then do:
     1947         assign
     1948           v-diasize-change-size = true
     1949         .
     1950       end.
     1951       else do:
     1952         return .
     1953       end.
     1954       assign
     1955         v-frame-height = frame Dialog-Frame :height
     1956         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1957         v-browse-height = v-diasize-browse-handle :height
     1958       .
     1959       for each buf_temp-browse-handle
     1960         where buf_temp-browse-handle.browse-type = 'height':u
     1961       :
     1962         assign
     1963           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1964         .
     1965       end.
     1966       for each buf_temp-diasize-handle
     1967       :
     1968         delete buf_temp-diasize-handle .
     1969       end.
     1970       assign
     1971         v-field-group-handle = frame Dialog-Frame :first-child
     1972       .
     1973       do while valid-handle(v-field-group-handle)
     1974       :
     1975         assign
     1976           v-object-handle = v-field-group-handle :first-child
     1977         .
     1978         do while valid-handle(v-object-handle)
     1979         :
     1980           if  v-object-handle <> v-diasize-browse-handle :handle
     1981           and can-query(v-object-handle, "row")
     1982           and can-query(v-object-handle, "height")
     1983           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1984           then do:
     1985             find first buf_temp-browse-handle
     1986               where buf_temp-browse-handle.browse-type   = 'height':u
     1987                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1988               no-error .
     1989             if available buf_temp-browse-handle
     1990             then do:
     1991             end.
     1992             else do:
     1993               create buf_temp-diasize-handle .
     1994               assign
     1995                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1996                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1997               .
     1998             end.
     1999           end.
     2000           assign
     2001             v-object-handle = v-object-handle :next-sibling
     2002           .
     2003         end.
     2004         assign
     2005           v-field-group-handle = v-field-group-handle :next-sibling
     2006         .
     2007       end.
     2008       do with frame Dialog-Frame
     2009       :
     2010         hide v-diasize-resize-button .
     2011         assign
     2012           v-diasize-resize-button :row    = 1
     2013           v-diasize-resize-button :column = 1
     2014         .
     2015       end.
     2016       if p-change-value > 0
     2017       then do:
     2018         if frame Dialog-Frame :scrollable = true
     2019         then do:
     2020           assign
     2021             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2022             no-error .
     2023           if error-status :error
     2024           or error-status :get-message(1) <> ""
     2025           then do:
     2026             undo move_block, retry move_block .
     2027           end.
     2028         end.
     2029         assign
     2030           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2031           no-error .
     2032         if error-status :error
     2033         or error-status :get-message(1) <> ""
     2034         then do:
     2035           undo move_block, retry move_block .
     2036         end.
     2037         assign
     2038           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2039           no-error .
     2040         if error-status :error
     2041         or error-status :get-message(1) <> ""
     2042         then do:
     2043           undo move_block, retry move_block .
     2044         end.
     2045         for each buf_temp-browse-handle
     2046           where buf_temp-browse-handle.browse-type = 'height':u
     2047         on error undo move_block, retry move_block
     2048         :
     2049           assign
     2050             buf_temp-browse-handle.browse-handle :height
     2051               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2052             no-error .
     2053           if error-status :error
     2054           or error-status :get-message(1) <> ""
     2055           then do:
     2056             undo move_block, retry move_block .
     2057           end.
     2058         end.
     2059         for each buf_temp-diasize-handle
     2060         on error undo move_block, retry move_block
     2061         :
     2062           assign
     2063             v-object-handle = buf_temp-diasize-handle.handle-value
     2064           .
     2065           if v-object-handle <> v-diasize-resize-button
     2066           then do:
     2067             assign
     2068               v-object-handle :row = v-object-handle :row + p-change-value
     2069               no-error .
     2070             if error-status :error
     2071             or error-status :get-message(1) <> ""
     2072             then do:
     2073               undo move_block, retry move_block .
     2074             end.
     2075           end.
     2076         end.
     2077       end.
     2078       else do:
     2079         for each buf_temp-diasize-handle
     2080         on error undo move_block, retry move_block
     2081         :
     2082           assign
     2083             v-object-handle = buf_temp-diasize-handle.handle-value
     2084           .
     2085           if v-object-handle <> v-diasize-resize-button
     2086           then do:
     2087             assign
     2088               v-object-handle :row = v-object-handle :row + p-change-value
     2089               no-error .
     2090             if error-status :error
     2091             or error-status :get-message(1) <> ""
     2092             then do:
     2093               undo move_block, retry move_block .
     2094             end.
     2095           end.
     2096         end.
     2097         assign
     2098           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2099           no-error .
     2100         if error-status :error
     2101         or error-status :get-message(1) <> ""
     2102         then do:
     2103           undo move_block, retry move_block .
     2104         end.
     2105         for each buf_temp-browse-handle
     2106           where buf_temp-browse-handle.browse-type = 'height':u
     2107         on error undo move_block, retry move_block
     2108         :
     2109           assign
     2110             buf_temp-browse-handle.browse-handle :height
     2111               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2112             no-error .
     2113           if error-status :error
     2114           or error-status :get-message(1) <> ""
     2115           then do:
     2116             undo move_block, retry move_block .
     2117           end.
     2118         end.
     2119         assign
     2120           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2121           no-error .
     2122         if error-status :error
     2123         or error-status :get-message(1) <> ""
     2124         then do:
     2125           undo move_block, retry move_block .
     2126         end.
     2127         if frame Dialog-Frame :scrollable = true
     2128         then do:
     2129           assign
     2130             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2131             no-error .
     2132           if error-status :error
     2133           or error-status :get-message(1) <> ""
     2134           then do:
     2135             undo move_block, retry move_block .
     2136           end.
     2137         end.
     2138       end.
     2139       if p-move-resize = true
     2140       then do:
     2141         run diasize_position-resize-button in this-procedure .
     2142       end.
     2143       if v-diasize-wndstore = true
     2144       then do:
     2145         if connected("ub") = true
     2146         then do:
     2147           define variable v-cntxt-db-num        as integer   no-undo .
     2148           define variable v-cntxt-userid        as character no-undo .
     2149           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2150                                             , OUTPUT v-cntxt-userid
     2151                                             ) .
     2152           run gbl/wndsizew.p
     2153             (input  v-cntxt-db-num
     2154             ,input  v-cntxt-userid
     2155             ,input  v-diasize-proc-name
     2156             ,input  'height':u
     2157             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     2158             ) .
     2159         end.
     2160       end.
     2161     end.
     2162     assign
     2163       v-diasize-change-size = false
     2164     .
     2165   end procedure.
     2166   procedure diasize_set-height :
     2167     define input  parameter p-new-height  as decimal   no-undo .
     2168     define input  parameter p-move-resize as logical   no-undo .
     2169     do
     2170     on error undo, return error return-value
     2171     :
     2172       run diasize_change-height in this-procedure
     2173         (input  (p-new-height - frame Dialog-Frame :height)
     2174         ,input  p-move-resize
     2175         ) .
     2176     end.
     2177   end procedure.
     2178   procedure diasize_change-width :
     2179     define input  parameter p-change-value as decimal   no-undo .
     2180     define input  parameter p-move-resize  as logical   no-undo .
     2181     define variable v-field-group-handle   as handle    no-undo .
     2182     define variable v-object-handle        as handle    no-undo .
     2183     define variable v-frame-width          as decimal   no-undo .
     2184     define variable v-frame-virtual-width  as decimal   no-undo .
     2185     define variable v-browse-width         as decimal   no-undo .
     2186     define variable v-window-width         as decimal   no-undo .
     2187     define variable v-window-virtual-width as decimal   no-undo .
     2188     define variable v-change-sign          as integer   no-undo .
     2189     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2190     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2191     if p-change-value > 0
     2192     then do:
     2193       if frame Dialog-Frame :width + p-change-value >
     2194           session :width-chars
     2195       then do:
     2196         assign
     2197           p-change-value = session :width-chars - frame Dialog-Frame :width
     2198         .
     2199         if p-change-value <= 0
     2200         then do:
     2201           run diasize_position-resize-button in this-procedure .
     2202           return .
     2203         end.
     2204       end.
     2205     end.
     2206     if p-change-value < 0
     2207     then do:
     2208       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     2209       then do:
     2210         assign
     2211           p-change-value = v-diasize-orig-frame-width
     2212                          - frame Dialog-Frame :width
     2213         .
     2214         if p-change-value >= 0
     2215         then do:
     2216           run diasize_position-resize-button in this-procedure .
     2217           return .
     2218         end.
     2219       end.
     2220     end.
     2221     if p-change-value >= 0
     2222     then do:
     2223       assign
     2224         v-change-sign = 1
     2225       .
     2226     end.
     2227     else do:
     2228       assign
     2229         v-change-sign = -1
     2230       .
     2231     end.
     2232     assign
     2233       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2234     .
     2235     if p-change-value = 0
     2236     then do:
     2237       run diasize_position-resize-button in this-procedure .
     2238       return .
     2239     end.
     2240     move_block:
     2241     do
     2242     on error undo move_block, leave move_block
     2243     :
     2244       if retry
     2245       then do:
     2246         do
     2247         on error undo move_block, leave move_block
     2248         :
     2249           if p-change-value > 0
     2250           then do:
     2251             for each buf_temp-diasize-handle
     2252             on error undo, next
     2253             :
     2254               assign
     2255                 v-object-handle = buf_temp-diasize-handle.handle-value
     2256               .
     2257               if v-object-handle <> v-diasize-resize-button
     2258               then do:
     2259                 assign
     2260                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2261                 .
     2262               end.
     2263             end.
     2264             assign
     2265               v-diasize-browse-handle :width = v-browse-width
     2266             .
     2267             for each buf_temp-browse-handle
     2268               where buf_temp-browse-handle.browse-type = 'width':u
     2269             on error undo, next
     2270             :
     2271               assign
     2272                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2273               .
     2274             end.
     2275             assign
     2276               frame Dialog-Frame :width = v-frame-width
     2277             .
     2278             if frame Dialog-Frame :scrollable = true
     2279             then do:
     2280               assign
     2281                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2282               .
     2283             end.
     2284             run diasize_position-resize-button in this-procedure .
     2285           end.
     2286           else do:
     2287             if frame Dialog-Frame :scrollable = true
     2288             then do:
     2289               assign
     2290                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2291               .
     2292             end.
     2293             assign
     2294               frame Dialog-Frame :width = v-frame-width
     2295             .
     2296             for each buf_temp-browse-handle
     2297               where buf_temp-browse-handle.browse-type = 'width':u
     2298             on error undo, next
     2299             :
     2300               assign
     2301                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2302               .
     2303             end.
     2304             assign
     2305               v-diasize-browse-handle :width = v-browse-width
     2306             .
     2307             for each buf_temp-diasize-handle
     2308             on error undo, next
     2309             :
     2310               assign
     2311                 v-object-handle = buf_temp-diasize-handle.handle-value
     2312               .
     2313               if v-object-handle <> v-diasize-resize-button
     2314               then do:
     2315                 assign
     2316                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2317                 .
     2318               end.
     2319             end.
     2320             run diasize_position-resize-button in this-procedure .
     2321           end.
     2322           assign
     2323             v-diasize-change-size = false
     2324           .
     2325           leave move_block .
     2326         end.
     2327       end.
     2328       assign
     2329         v-diasize-need-full-display = true
     2330       .
     2331       if v-diasize-change-size = false
     2332       then do:
     2333         assign
     2334           v-diasize-change-size = true
     2335         .
     2336       end.
     2337       else do:
     2338         return .
     2339       end.
     2340       assign
     2341         v-frame-width = frame Dialog-Frame :width
     2342         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     2343         v-browse-width = v-diasize-browse-handle :width
     2344       .
     2345       for each buf_temp-browse-handle
     2346         where buf_temp-browse-handle.browse-type = 'width':u
     2347       :
     2348         assign
     2349           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2350         .
     2351       end.
     2352       for each buf_temp-diasize-handle
     2353       :
     2354         delete buf_temp-diasize-handle .
     2355       end.
     2356       assign
     2357         v-field-group-handle = frame Dialog-Frame :first-child
     2358       .
     2359       do while valid-handle(v-field-group-handle)
     2360       :
     2361         assign
     2362           v-object-handle = v-field-group-handle :first-child
     2363         .
     2364         do while valid-handle(v-object-handle)
     2365         :
     2366           if  v-object-handle <> v-diasize-browse-handle :handle
     2367           and v-object-handle <> v-diasize-resize-button
     2368           and can-query(v-object-handle, "row")
     2369           and can-query(v-object-handle, "height")
     2370           and ( v-object-handle :col + v-object-handle :width
     2371                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2372               )
     2373           then do:
     2374             find first buf_temp-browse-handle
     2375               where buf_temp-browse-handle.browse-type   = 'width':u
     2376                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2377               no-error .
     2378             if available buf_temp-browse-handle
     2379             then do:
     2380             end.
     2381             else do:
     2382               create buf_temp-diasize-handle .
     2383               assign
     2384                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2385                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2386               .
     2387             end.
     2388           end.
     2389           assign
     2390             v-object-handle = v-object-handle :next-sibling
     2391           .
     2392         end.
     2393         assign
     2394           v-field-group-handle = v-field-group-handle :next-sibling
     2395         .
     2396       end.
     2397       do with frame Dialog-Frame
     2398       :
     2399         hide v-diasize-resize-button .
     2400         v-diasize-resize-button :row = 1.
     2401         v-diasize-resize-button :column = 1.
     2402       end.
     2403       if p-change-value > 0
     2404       then do:
     2405         if frame Dialog-Frame :scrollable = true
     2406         then do:
     2407           assign
     2408             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2409             no-error .
     2410           if error-status :error
     2411           or error-status :get-message(1) <> ""
     2412           then do:
     2413             undo move_block, retry move_block.
     2414           end.
     2415         end.
     2416         assign
     2417           frame Dialog-Frame :width = v-frame-width + p-change-value
     2418           no-error .
     2419         if error-status :error
     2420         or error-status :get-message(1) <> ""
     2421         then do:
     2422           undo move_block, retry move_block.
     2423         end.
     2424         assign
     2425           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2426         no-error .
     2427         if error-status :error
     2428         or error-status :get-message(1) <> ""
     2429         then do:
     2430           undo move_block, retry move_block.
     2431         end.
     2432         for each buf_temp-browse-handle
     2433           where buf_temp-browse-handle.browse-type = 'width':u
     2434         on error undo move_block, retry move_block
     2435         :
     2436           assign
     2437             buf_temp-browse-handle.browse-handle :width
     2438               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2439             no-error .
     2440           if error-status :error
     2441           or error-status :get-message(1) <> ""
     2442           then do:
     2443             undo move_block, retry move_block .
     2444           end.
     2445         end.
     2446         for each buf_temp-diasize-handle
     2447         on error undo move_block, retry move_block
     2448         :
     2449           assign
     2450             v-object-handle = buf_temp-diasize-handle.handle-value
     2451           .
     2452           if v-object-handle <> v-diasize-resize-button
     2453           then do:
     2454             assign
     2455               v-object-handle :col = v-object-handle :col + p-change-value
     2456               no-error .
     2457             if error-status :error
     2458             or error-status :get-message(1) <> ""
     2459             then do:
     2460               undo move_block, retry move_block .
     2461             end.
     2462           end.
     2463         end.
     2464       end.
     2465       else do:
     2466         for each buf_temp-diasize-handle
     2467         on error undo move_block, retry move_block
     2468         :
     2469           assign
     2470             v-object-handle = buf_temp-diasize-handle.handle-value
     2471           .
     2472           if v-object-handle <> v-diasize-resize-button
     2473           then do:
     2474             assign
     2475               v-object-handle :col = v-object-handle :col + p-change-value
     2476               no-error .
     2477             if error-status :error
     2478             or error-status :get-message(1) <> ""
     2479             then do:
     2480               undo move_block, retry move_block .
     2481             end.
     2482           end.
     2483         end.
     2484         for each buf_temp-browse-handle
     2485           where buf_temp-browse-handle.browse-type = 'width':u
     2486         on error undo move_block, retry move_block
     2487         :
     2488           assign
     2489             buf_temp-browse-handle.browse-handle :width
     2490               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2491             no-error .
     2492           if error-status :error
     2493           or error-status :get-message(1) <> ""
     2494           then do:
     2495             undo move_block, retry move_block .
     2496           end.
     2497         end.
     2498         assign
     2499           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2500           no-error .
     2501         if error-status :error
     2502         or error-status :get-message(1) <> ""
     2503         then do:
     2504           undo move_block, retry move_block.
     2505         end.
     2506         assign
     2507           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2508         no-error .
     2509         if error-status :error
     2510         or error-status :get-message(1) <> ""
     2511         then do:
     2512           undo move_block, retry move_block.
     2513         end.
     2514         if frame Dialog-Frame :scrollable = true
     2515         then do:
     2516           assign
     2517             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2518           no-error .
     2519           if error-status :error
     2520           or error-status :get-message(1) <> ""
     2521           then do:
     2522             undo move_block, retry move_block.
     2523           end.
     2524         end.
     2525       end.
     2526       if p-move-resize
     2527       then do:
     2528         run diasize_position-resize-button in this-procedure .
     2529       end.
     2530       if v-diasize-wndstore = true
     2531       then do:
     2532         if connected("ub") = true
     2533         then do:
     2534           define variable v-cntxt-db-num        as integer   no-undo .
     2535           define variable v-cntxt-userid        as character no-undo .
     2536           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2537                                             , OUTPUT v-cntxt-userid
     2538                                             ) .
     2539           run gbl/wndsizew.p
     2540             (input  v-cntxt-db-num
     2541             ,input  v-cntxt-userid
     2542             ,input  v-diasize-proc-name
     2543             ,input  'width':u
     2544             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2545             ) .
     2546         end.
     2547       end.
     2548     end.
     2549     assign
     2550       v-diasize-change-size = false
     2551     .
     2552   end procedure.
     2553   procedure diasize_set-width :
     2554     define input  parameter p-new-width  as decimal   no-undo .
     2555     define input  parameter p-move-resize as logical   no-undo .
     2556     do
     2557     on error undo, return error return-value
     2558     :
     2559       run diasize_change-width in this-procedure
     2560         (input  (p-new-width - frame Dialog-Frame :width)
     2561         ,input  p-move-resize
     2562         ) .
     2563     end.
     2564   end procedure.
     2565   procedure diasize_position-resize-button :
     2566     do with frame Dialog-Frame
     2567     :
     2568       hide v-diasize-resize-button .
     2569       assign
     2570         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2571                     - 1
     2572                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2573         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2574                     - 1
     2575                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2576       .
     2577       view v-diasize-resize-button .
     2578     end.
     2579   end procedure.
     2580   on alt-right anywhere
     2581   do:
     2582     run diasize_change-width in this-procedure
     2583       (input 1
     2584       ,input true
     2585       ) .
     2586     return no-apply .
     2587   end.
     2588   on alt-left anywhere
     2589   do:
     2590     run diasize_change-width in this-procedure
     2591       (input -1
     2592       ,input true
     2593       ) .
     2594     return no-apply .
     2595   end.
     2596   on alt-down anywhere
     2597   do:
     2598     run diasize_change-height in this-procedure
     2599       (input 1
     2600       ,input true
     2601       ) .
     2602     return no-apply .
     2603   end.
     2604   on alt-up anywhere
     2605   do:
     2606     run diasize_change-height in this-procedure
     2607       (input -1
     2608       ,input true
     2609       ) .
     2610     return no-apply .
     2611   end.
     2612   on alt-enter of frame Dialog-Frame
     2613   do:
     2614     run diasize_maximize in this-procedure
     2615       (input  ?
     2616       ).
     2617     return no-apply .
     2618   end.
     2619   procedure diasize_end-move :
     2620     do
     2621     on error undo, return error return-value
     2622     :
     2623       define variable v-row-delta as decimal   no-undo .
     2624       define variable v-col-delta as decimal   no-undo .
     2625       define variable v-new-row as decimal   no-undo .
     2626       define variable v-new-col as decimal   no-undo .
     2627       assign
     2628         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2629         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2630       .
     2631       assign
     2632         v-row-delta = v-new-row - frame Dialog-Frame :height
     2633         v-col-delta = v-new-col - frame Dialog-Frame :width
     2634       .
     2635       run diasize_change-height in this-procedure
     2636         (input v-row-delta
     2637         ,input true
     2638         ) .
     2639       run diasize_change-width in this-procedure
     2640         (input v-col-delta
     2641         ,input true
     2642         ) .
     2643     end.
     2644   end procedure.
     2645   procedure diasize_maximize :
     2646     define input  parameter p-action as logical   no-undo .
     2647     do
     2648     on error undo, return error return-value
     2649     :
     2650       if p-action = ?
     2651       then do:
     2652         if v-diasize-need-maximize = true
     2653         then do:
     2654           assign
     2655             p-action = true
     2656           .
     2657         end.
     2658         else do:
     2659           assign
     2660             p-action = false
     2661           .
     2662         end.
     2663       end.
     2664       if p-action = true
     2665       then do:
     2666         run diasize_change-height in this-procedure
     2667           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2668               - frame Dialog-Frame :height-chars
     2669           ,input true
     2670           ) .
     2671         run diasize_change-width in this-procedure
     2672           (input session :width-chars
     2673               - frame Dialog-Frame :width-chars
     2674           ,input true
     2675           ) .
     2676         assign
     2677           v-diasize-need-maximize = false
     2678         .
     2679       end.
     2680       else do:
     2681         run diasize_change-width in this-procedure
     2682           (input v-diasize-orig-frame-width
     2683               - frame Dialog-Frame :width-chars
     2684           ,input true
     2685           ) .
     2686         run diasize_change-height in this-procedure
     2687           (input v-diasize-orig-frame-height
     2688               - frame Dialog-Frame :height-chars
     2689           ,input true
     2690           ) .
     2691         assign
     2692           v-diasize-need-maximize = true
     2693         .
     2694       end.
     2695     end.
     2696   end procedure.
     2697   procedure diasize_restore-orig-size :
     2698     do
     2699     on error undo, return error return-value
     2700     :
     2701       assign
     2702         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2703         v-diasize-current-frame-height = frame Dialog-Frame :height
     2704       .
     2705       run diasize_set-height in this-procedure
     2706         (input  v-diasize-orig-frame-height
     2707         ,input  true
     2708         ) .
     2709       run diasize_set-width in this-procedure
     2710         (input  v-diasize-orig-frame-width
     2711         ,input  true
     2712         ) .
     2713     end.
     2714   end procedure.
     2715   procedure diasize_restore-current-size :
     2716     do
     2717     on error undo, return error return-value
     2718     :
     2719       run diasize_set-height in this-procedure
     2720         (input  v-diasize-current-frame-height
     2721         ,input  true
     2722         ) .
     2723       run diasize_set-width in this-procedure
     2724         (input  v-diasize-current-frame-width
     2725         ,input  true
     2726         ) .
     2727     end.
     2728   end procedure.
     2729   procedure diasize_set-browse-handle :
     2730     define input  parameter p-browse-handle as handle   no-undo .
     2731     define buffer buf_temp-browse-handle for temp-browse-handle .
     2732     do
     2733     on error undo, return error return-value
     2734     :
     2735       assign
     2736         v-diasize-browse-handle = p-browse-handle
     2737       .
     2738       for each buf_temp-browse-handle
     2739       on error undo, return error return-value
     2740       :
     2741         delete buf_temp-browse-handle .
     2742       end.
     2743     end.
     2744   end procedure.
     2745   procedure diasize_add_browse :
     2746     define input  parameter p-browse-type   as character no-undo .
     2747     define input  parameter p-browse-handle as handle    no-undo .
     2748     define buffer buf_temp-browse-handle for temp-browse-handle .
     2749     do
     2750     on error undo, return error return-value
     2751     :
     2752       assign
     2753         v-diasize-browse-number = v-diasize-browse-number + 1
     2754       .
     2755       create buf_temp-browse-handle .
     2756       assign
     2757         buf_temp-browse-handle.browse-type   = p-browse-type
     2758         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2759         buf_temp-browse-handle.browse-handle = p-browse-handle
     2760       .
     2761     end.
     2762   end procedure.
     2763   procedure diasize_init :
     2764     define variable v-default-value    as logical   no-undo .
     2765     define variable v-restore-saved    as logical   no-undo .
     2766     define variable v-resize-value-str as character no-undo .
     2767     do
     2768     on error undo, return error return-value
     2769     :
     2770       do with frame Dialog-Frame
     2771       :
     2772         assign
     2773           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2774           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2775           v-diasize-browse-handle     = browse br-gds-hist :handle
     2776         .
     2777         create button v-diasize-resize-button
     2778         assign
     2779           parent        = frame Dialog-Frame :first-child
     2780           label         = "s"
     2781           height-pixels = 16
     2782           width-pixels  = 16
     2783           visible       = true
     2784           sensitive     = true
     2785           movable       = true
     2786           triggers:
     2787             on end-move persistent run diasize_end-move in this-procedure .
     2788           end triggers.
     2789         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2790         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2791         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2792         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2793         assign
     2794           v-diasize-wndmax = false
     2795         .
     2796         if connected("ub") = true
     2797         then do:
     2798           define variable v-cntxt-db-num        as integer   no-undo .
     2799           define variable v-cntxt-userid        as character no-undo .
     2800           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2801                                             , OUTPUT v-cntxt-userid
     2802                                             ) .
     2803           run gbl/wndpar_r.p
     2804             (input  v-cntxt-db-num
     2805             ,input  v-cntxt-userid
     2806             ,input  'wndmax':U
     2807             ,output v-diasize-wndmax
     2808             ,output v-default-value
     2809             ) .
     2810         end.
     2811         assign
     2812           v-diasize-wndstore = false
     2813         .
     2814         if connected("ub") = true
     2815         then do:
     2816           run gbl/wndpar_r.p
     2817             (input  v-cntxt-db-num
     2818             ,input  v-cntxt-userid
     2819             ,input  'wndstore':U
     2820             ,output v-diasize-wndstore
     2821             ,output v-default-value
     2822             ) .
     2823         end.
     2824         assign
     2825           v-diasize-proc-name = entry(1, program-name(2), '.')
     2826         .
     2827         if v-diasize-wndstore = true
     2828         then do:
     2829           assign
     2830             v-restore-saved = false
     2831           .
     2832           if connected("ub") = true
     2833           then do:
     2834             run gbl/wndsizer.p
     2835               (input  v-cntxt-db-num
     2836               ,input  v-cntxt-userid
     2837               ,input  v-diasize-proc-name
     2838               ,input  'height':u
     2839               ,output v-resize-value-str
     2840               ) .
     2841             if v-resize-value-str <> '':U
     2842             then do:
     2843               run diasize_change-height in this-procedure
     2844                 (input  integer(v-resize-value-str)
     2845                 ,input  true
     2846                 ) .
     2847               assign
     2848                 v-restore-saved = true
     2849               .
     2850             end.
     2851           end.
     2852           if connected("ub") = true
     2853           then do:
     2854             run gbl/wndsizer.p
     2855               (input  v-cntxt-db-num
     2856               ,input  v-cntxt-userid
     2857               ,input  v-diasize-proc-name
     2858               ,input  'width':u
     2859               ,output v-resize-value-str
     2860               ) .
     2861             if v-resize-value-str <> '':U
     2862             then do:
     2863               run diasize_change-width in this-procedure
     2864                 (input  integer(v-resize-value-str)
     2865                 ,input  true
     2866                 ) .
     2867               assign
     2868                 v-restore-saved = true
     2869               .
     2870             end.
     2871           end.
     2872           if v-restore-saved <> true
     2873           then do:
     2874             if v-diasize-wndmax = true
     2875             then do:
     2876               run diasize_maximize in this-procedure
     2877                 (input  true
     2878                 ) .
     2879             end.
     2880           end.
     2881         end.
     2882         else do:
     2883           if v-diasize-wndmax = true
     2884           then do:
     2885             run diasize_maximize in this-procedure
     2886               (input  true
     2887               ) .
     2888           end.
     2889         end.
     2890       end.
     2891     end.
     2892   end procedure.
     2893   procedure diasize_need-full-display :
     2894     define output parameter p-need-full-display as logical   no-undo .
     2895     do
     2896     on error undo, return error return-value
     2897     :
     2898       assign
     2899         p-need-full-display = v-diasize-need-full-display
     2900       .
     2901       assign
     2902         v-diasize-need-full-display = false
     2903       .
     2904     end.
