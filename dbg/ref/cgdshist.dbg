     2906   procedure get-context :
     2907      define output parameter p-db-num as integer          no-undo.
     2908      define output parameter p-user-id as character        no-undo.
     2909      define variable v-login               as character    no-undo.
     2910      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2911      define buffer buf_user-login  for ub.user-login .
     2912      do
     2913      on error undo, return error
     2914      :
     2915            FIND FIRST buf_sys-ctrl no-lock.
     2916            ASSIGN
     2917               v-login = USERID("ub")
     2918               p-db-num = buf_sys-ctrl.db-num
     2919            .
     2920            FIND FIRST buf_user-login
     2921                 WHERE buf_user-login.db-num = p-db-num
     2922                   AND buf_user-login.user-login = v-login
     2923                 no-lock
     2924                 no-error
     2925                 .
     2926            IF AVAILABLE buf_user-login
     2927            THEN DO:
     2928               assign
     2929                  p-user-id = buf_user-login.user-id
     2930               .
     2931            END.
     2932      end.
     2933   end procedure.
