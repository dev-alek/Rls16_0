     5558   PROCEDURE proc-b-print :
     5559   define variable date_string     as      char    no-undo.
     5560   define variable Line                as      char    no-undo.
     5561   define variable for-time as char.
     5562   define variable accum-count as integer.
     5563   define variable v-doc-rec as recid no-undo.
     5564   define variable v-prod as character no-undo .
     5565   define variable v-subject-chr as character no-undo .
     5566   define variable v-upd-time as character no-undo .
     5567   define variable v-obj as character no-undo .
     5568   define variable v-action-chr as character no-undo .
     5569   define variable v-source-type as character no-undo .
     5570   DEFINE FRAME HistoryList
     5571   X_c-gds-hist.gds-code
     5572   v-action-chr FORMAT "X(10)"
     5573   v-gds-name COLUMN-LABEL "Назв. товара" FORMAT "X(20)"
     5574   v-artic COLUMN-LABEL "Артикул" FORMAT "X(14)"
     5575   v-prod COLUMN-LABEL "Пр-ль" FORMAT "X(12)"
     5576   v-subject-chr COLUMN-LABEL "Предмет изменений" FORMAT "X(20)"
     5577   X_c-gds-hist.is-news COLUMn-LABEL "СПН" FORMAT "+/ "
     5578   v-source-type COLUMn-LABEL "Источн.!измен"
     5579   X_c-gds-hist.source-ref COLUMn-LABEL "№"
     5580   X_c-gds-hist.corr-date
     5581   v-upd-time COLUMN-LABEL "Время изм." FORMAT "X(8)"
     5582   X_c-gds-hist.corr-user-name
     5583   X_c-gds-hist.corr-user-db-num
     5584   X_c-gds-hist.host-code COLUMN-LABEL "Фирма"
     5585   v-obj COLUMN-LABEL "Объект" FORMAT "X(8)"
     5586   HEADER  date_string AT 5 format "X(35)"
     5587   string( "Страница " ) format "X(9)" AT 115 PAGE-NUMBER(PrnLibStream) AT 125 FORMAT ">>9" SKIP
     5588   Line format "X(192)" AT 1
     5589   with width 232 down stream-io use-text    .
     5590   Line = fill("-", 192).
     5591   date_string = cur-time-print() .
     5592   assign
     5593   v-doc-rec = recid( X_c-gds-hist ).
     5594   DO WHILE available X_c-gds-hist :
     5595         GET prev br-gds-hist.
     5596   END.
     5597   run prn-lib-open-stream  in this-procedure (
     5598                                                input parparentProc
     5599                                               ,input 43
     5600                                               ,input yes
     5601                                               ,input no
