     5678     dim = '0'
     5679     .
     5680   run fltfield-add in this-procedure('gds-code', 'Код товара', '',
     5681   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5682   run fltfield-add in this-procedure('host-code', '', '',
     5683   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5684   run fltfield-add in this-procedure('obj-type*obj-code', 'Объект', '',
     5685   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5686   run fltfield-add in this-procedure('corr-date', '', '',
     5687   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5688   run fltfield-add in this-procedure('corr-time', 'Время корр.', 'time',
     5689   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5690   run fltfield-add in this-procedure('corr-user-db-num', '', '',
     5691   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5692   run fltfield-add in this-procedure('corr-user-name', 'Изменил', 'usr',
     5693   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5694   run fltfield-add in this-procedure('subject', 'Предмет изменения', 'gds-hist-subject',
     5695   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5696   run fltfield-add in this-procedure('action', 'Действие', 'hist-action',
     5697   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5698   run fltfield-add in this-procedure('source-type', 'Источник_измен-я', 'hist-source-type',
     5699   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5700   run fltfield-add in this-procedure('source-ref', '', '',
     5701   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5702   run fltfield-add in this-procedure('b-code', 'Бар-код', '',
     5703   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5704   run fltfield-add in this-procedure('b-str', 'ДопБК', '',
     5705   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5706   Filter-Block:
     5707   DO ON STOP    UNDO Filter-Block, LEAVE Filter-Block
     5708       ON ERROR   UNDO Filter-Block, LEAVE Filter-Block
     5709       ON END-KEY UNDO Filter-Block, LEAVE Filter-Block :
     5710     run gbl/filter.w ( INPUT parparentproc
     5711                       ,INPUT (filter-point + chr(4) +
     5712                                 filter-label0 + chr(4) +
     5713                                 string(yes))
     5714                       ,INPUT tbl
     5715                       ,INPUT join-tbl
     5716                       ,INPUT fld
     5717                       ,INPUT lab
     5718                       ,INPUT spr
     5719                       ,INPUT dim ).
     5720     run OpenBr in this-procedure ( input yes, input no, input '':U, input v-corr-user-db-num).
     5721   END.
     5722   END PROCEDURE.
     5723   PROCEDURE proc-br-gds-hist :
     5724   define variable vss-include-info45 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5725   if b-sel:sensitive in frame Dialog-Frame then dO:
     5726       if b-mark:sensitive then do:
     5727           apply "choose" to b-mark in frame Dialog-Frame.
     5728       end.
     5729       else do:
     5730           apply "choose" to b-sel in frame Dialog-Frame.
     5731       end.
     5732   end.
     5733   else do:
     5734       if b-lookup:sensitive then
     5735       apply "choose" to b-lookup in frame Dialog-Frame.
     5736   end.
     5737   END PROCEDURE.
     5738   PROCEDURE proc-find-corr-date :
     5739   define input parameter p-next as logical no-undo.
     5740   define input parameter p-date like ub.fin-doc.doc-date no-undo.
     5741   define variable v-date-chr as character no-undo.
     5742   if p-date = ? then return .
     5743   display
     5744   0 @ sch-gds-code
     5745   0 @ sch-db-num
     5746   "":U @ sch-corr-user-name
     5747   with frame Dialog-Frame.
     5748   assign
     5749   v-date-chr = string(day(p-date)) + chr(47) +
     5750                    string(month(p-date)) + chr(47) +
     5751                    string(year(p-date)).
     5752          run OpenBr in this-procedure
     5753           (input false
     5754           ,input true
     5755           ,input substitute("and X_c-gds-hist.corr-date = &1 "
     5756             , v-date-chr)
     5757           ,input v-corr-user-db-num
     5758           ).
     5759         apply "entry":u to sch-corr-date in frame Dialog-Frame.
     5760   END PROCEDURE.
     5761   PROCEDURE proc-find-db-num :
     5762   define input parameter p-next as logical no-undo.
     5763   define input parameter p-db-num like ub.c-gds-hist.corr-user-db-num no-undo.
     5764   define variable v-db-num as character no-undo.
     5765   assign
     5766   sch-corr-date = ?
     5767   .
     5768   display
     5769   "":U @ sch-corr-user-name
     5770   0 @ sch-gds-code
     5771   sch-corr-date
     5772   with frame Dialog-Frame.
     5773   assign
     5774   v-db-num = string(p-db-num).
     5775   run OpenBr in this-procedure
     5776       (input false
     5777       ,input p-next
     5778       ,input substitute("and X_c-gds-hist.corr-user-db-num = &1 "
     5779         , v-db-num)
     5780       ,input v-corr-user-db-num
     5781       ).
     5782   apply "entry":u to sch-db-num in frame Dialog-Frame .
     5783   END PROCEDURE.
     5784   PROCEDURE proc-find-gds-code :
     5785   define input parameter p-next as logical no-undo.
     5786   define input parameter p-gds-code like ub.c-gds-hist.gds-code no-undo.
     5787   define variable v-gds-code as character no-undo.
     5788   assign
     5789   sch-corr-date = ?.
     5790   display
     5791   "":U @ sch-corr-user-name
     5792   0 @ sch-db-num
     5793   sch-corr-date
     5794   with frame Dialog-Frame.
     5795   assign
     5796   v-gds-code = string(p-gds-code).
     5797   run OpenBr in this-procedure
     5798       (input false
     5799       ,input p-next
     5800       ,input substitute("and X_c-gds-hist.gds-code = &1 "
     5801         , v-gds-code)
     5802       ,input v-corr-user-db-num
     5803       ).
     5804   apply "entry":u to sch-gds-code in frame Dialog-Frame .
     5805   END PROCEDURE.
     5806   PROCEDURE proc-find-user :
     5807   define input parameter p-next as logical no-undo.
     5808   define input parameter p-user like ub.c-gds-hist.corr-user-name no-undo.
     5809   assign
     5810   sch-corr-date = ?.
     5811   display
     5812   0 @ sch-db-num
     5813   sch-corr-date
     5814   0 @ sch-gds-code
     5815   with frame Dialog-Frame.
     5816   p-user = chr(34) + p-user + chr(34).
     5817   run OpenBr in this-procedure
     5818       (input false
     5819       ,input p-next
     5820       ,input substitute("and X_c-gds-hist.corr-user-name = &1 "
     5821         , p-user)
     5822       ,input v-corr-user-db-num
     5823       ).
     5824   apply "entry":u to sch-corr-user-name in frame Dialog-Frame .
     5825   END PROCEDURE.
     5826   PROCEDURE proc-view-changes :
     5827   define variable v-description as character no-undo .
     5828   for each temp-changes:
     5829       delete temp-changes.
     5830   END.
     5831   if not available X_c-gds-hist then do:
     5832     Open QUery br-changes for each temp-changes.
     5833     return.
     5834   end.
     5835   run ref/cgdshisv.p (
     5836                      input X_c-gds-hist.gds-code
     5837                     ,input X_c-gds-hist.chip-num
     5838                     ,input X_c-gds-hist.corr-user-db-num
     5839                     ,input X_c-gds-hist.host-code
     5840                     ,input X_c-gds-hist.obj-type
     5841                     ,input X_c-gds-hist.obj-code
     5842                     ,input X_c-gds-hist.subject
     5843                     ,input X_c-gds-hist.action
     5844                     ,input no
     5845                     ,input "":U
     5846                     ,output v-description
     5847                  ) no-error .
     5848   Open QUery br-changes for each temp-changes.
     5849   assign
     5850   br-changes:title in frame Dialog-Frame = v-description
     5851   .
     5852   END PROCEDURE.
     5853   FUNCTION get-action RETURNS CHARACTER
     5854     ( p-action as integer ) :
     5855     define variable dops as character no-undo.
     5856   assign dops = entry (lookup (trim(string(p-action)), '99,1,2,3,4,9,51,79':U), 'Удаление,Создание,Изменение,Коррекция,Восстановление,Смена_кода,Смена_артик,Выключ.':U) no-error.
     5857   RETURN dops.
     5858   END FUNCTION.
     5859   FUNCTION get-good RETURNS CHARACTER
     5860     ( p-gds-code as integer, output p-artic as character, output p-prod-type as character, output p-prod-code as integer ) :
     5861   define buffer buf_goods for ub.goods.
     5862   find first buf_goods no-lock where buf_goods.gds-code = p-gds-code no-error.
     5863   if not available buf_goods then do:
     5864       return "!!! Неизвестный товар!!!".
     5865   end.
     5866   assign
     5867   p-artic =  buf_goods.artic
     5868   p-prod-type =  buf_goods.prod-type
     5869   p-prod-code =  buf_goods.prod-code
     5870   .
     5871     RETURN buf_goods.gds-name.
     5872   END FUNCTION.
     5873   FUNCTION get-source-type RETURNS CHARACTER
     5874     ( p-source-type as character ) :
     5875   define variable v-dop as character no-undo .
     5876   assign
     5877   v-dop =  entry (lookup (p-source-type, ',db,esys,trn-doc,payment,fin-doc,import,recalc,wth-doc,ren-gdsc,upgrade,grp-chg,stop-list,dis-card':U), ',БД,ВС,Документ,Платеж,Фин.док.,Импорт,Пересчет,Документ МЦ,Коллизия,Апгрейд,Изм.группы,Стоплист,ДК':U) no-error
     5878   .
     5879     RETURN v-dop .
     5880   END FUNCTION.
     5881   FUNCTION get-subject RETURNS CHARACTER
     5882     ( p-subject as character ) :
     5883   define variable v-return as character no-undo .
     5884   assign
     5885   v-return =  entry (lookup (p-subject, 'goods,goods-attr,gds-host-attr,gds-obj-attr,fbr-gds-obj,s-coeff,bar-code,bar-code-attr,bar-code-obj-attr,prod-bc,varianty-delivery-gds-obj,gds-season,tax-rate-gds,assortment-matrix-goods,gds-obj-prop,pl-gds,pl-gds-pump,sert-join,pl-gds-attr,dis-gds-rule,ext-artic,ext-classif,recipe,recipe-gds,gds-obj,gds-obj-prop-attr':U), 'Товар,Атр-т товара,Атр-т тов. на фирме,Атр-т тов. на объекте,Атрибут РЕСТОРАНа,Сезонный коэфф,Бар-код,Атрибуты бар-кодов,Атрибуты бар-кода на объекте,ДопБК,Варианты доставки,Сезон товара,Ставки налогов,Содержимое ассортиментных матр,Индикаторы,Товар на складском месте,Товар на ТРК,Сертификат на товар,АттрТовара на скл.месте,Скидка Товара на объ.,Внешний артикул товара,Внешний классификатор,Рецепт,Товар рецепта,Товар на объекте,Атр-т тов. для заказов':U) no-error.
     5886   if error-status:error then  do:
     5887     message error-status:get-message(1) view-as alert-box .
     5888     RETURN p-subject.
     5889   end.
     5890   else return v-return.
     5891   END FUNCTION.
