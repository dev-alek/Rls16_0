      549   ON CHOOSE OF B-hist IN FRAME Dialog-Frame
      550   DO:
      551     define variable v-rid-list as character no-undo.
      552     if NOT available locked_dis-rule then return no-apply.
      553     run ref/discruls.w (
      554                      INPUT parParentProc
      555                     ,input "":U
      556                     ,input "rl-root":U
      557                     ,input tt-dis-rule.rule-num
      558                     ,input tt-dis-rule.upper-rule-num
      559                     ,input "":U
      560                     ,input 0
      561                     ,input-output v-rid-list ).
      562   END.
      563   ON CHOOSE OF B-plt IN FRAME Dialog-Frame
      564   DO:
      565    DEFINE VARIABLE v-charkey_one AS CHARACTER NO-UNDO.
      566    DEFINE VARIABLE v-rid-list AS CHARACTER NO-UNDO.
      567    DEFINE BUFFER local_price-list-type FOR ub.price-list-type.
      568    DEFINE BUFFER local2_price-list-type FOR ub.price-list-type.
      569    IF AVAILABLE tt0-term_dis-rule
      570    and tt0-term_dis-rule.charkey_one <> '' then do:
      571       find first local_price-list-type no-lock where
      572                 local_price-list-type.plt-id = integer(entry(1, tt0-term_dis-rule.charkey_one, "-") )
      573             and local_price-list-type.plt-db-num = integer(entry(2, tt0-term_dis-rule.charkey_one, "-") ) no-error.
      574       if available local_price-list-type then do:
      575         v-rid-list = STRING(RECID(local_price-list-type)).
      576         charkey_one-name =     local_price-list-type.NAME .
      577         display
      578         tt0-term_dis-rule.charkey_one @ tt-dis-rule.charkey_one
      579         charkey_one-name
      580         with frame Dialog-Frame .
      581       end.
      582    END.
      583    v-rid-list = string(p-templ-rl-root).
      584    run ref/typepric.w (
      585                         input  parParentProc
      586                        ,INPUT "b-sel,mode=ban-discnt"
      587                        ,INPUT-OUTPUT v-rid-list ) NO-ERROR.
      588   IF error-status:error
      589   or v-rid-list = ""
      590   THEN RETURN NO-APPLY.
      591    IF (available local_price-list-type and v-rid-list <> string(p-templ-rl-root))
      592    or not available local_price-list-type
      593    THEN DO:
      594        FIND FIRST local2_price-list-type NO-LOCK WHERE
      595                   recid(local2_price-list-type) = INTEGER(v-rid-list) NO-ERROR.
      596       IF AVAILABLE local2_price-list-type THEN DO:
      597           ASSIGN
      598           tt-dis-rule.charkey_one = SUBSTITUTE("&1-&2"
      599                                                , local2_price-list-type.plt-id
      600                                                , local2_price-list-type.plt-db-num)
      601           charkey_one-name =     local2_price-list-type.NAME
      602           .
      603           DISPLAY
      604           tt-dis-rule.charkey_one
      605           charkey_one-name
      606           WITH FRAME Dialog-Frame.
      607       END.
      608       ELSE DO:
      609           MESSAGE
      610           substitute("Не удалось найти ТПЛ с recid=&1", v-rid-list)
      611           VIEW-AS ALERT-BOX ERROR.
      612       END.
      613    END.
      614    apply "entry" to tt-dis-rule.charkey_one in FRAME Dialog-Frame.
      615    return no-apply.
      616   END.
      617   ON CHOOSE OF b-plt-lookup IN FRAME Dialog-Frame
      618   DO:
      619   DEFINE VARIABLE v-recid AS RECID NO-UNDO.
      620   define buffer loc_price-list-type for ub.price-list-type.
      621     IF AVAILABLE tt0-term_dis-rule then do:
      622       if tt0-term_dis-rule.charkey_one <> '' then do:
      623           find first loc_price-list-type where
      624                     loc_price-list-type.plt-id = integer(entry(1, tt0-term_dis-rule.charkey_one, "-"))
      625                  and loc_price-list-type.plt-db-num = integer(entry(2, tt0-term_dis-rule.charkey_one, "-")) no-error.
      626           if available loc_price-list-type then do:
      627               v-recid = RECID(loc_price-list-type).
      628               run ref/tp-price.w ( input parparentproc
      629                                 ,input NO
      630                                 ,INPUT 'ПРОСМОТР':U
      631                                  ,INPUT-OUTPUT v-recid ) NO-ERROR.
      632           end.
      633           ELSE DO:
      634              MESSAGE
      635              "Тип прайс-листа не определен, возможно удален"
      636              VIEW-AS ALERT-BOX ERROR.
      637            END.
      638       end.
      639       ELSE DO:
      640         MESSAGE
      641         "Тип прайс-листа не определен"
      642         VIEW-AS ALERT-BOX ERROR.
      643       END.
      644     END.
      645   END.
