      720   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      721   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      722   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      723   on help of frame Dialog-Frame
      724   do:
      725     run gbl/app_help.p
      726       (input this-procedure :file-name
      727       ,input ''
      728       ,input ?
      729       ) no-error.
      730     if error-status :error then do:
      731       message
      732         "Ошибка при вызове помощи"
      733         error-status :get-message(1)
      734         view-as alert-box .
      735     end.
      736   end.
      737   run minbtn-set in this-procedure .
      738   on choose of b-help in frame Dialog-Frame
      739   do:
      740     apply "help":u to frame Dialog-Frame .
      741   end.
      742   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      743   procedure minbtn-set :
      744       do
      745           on error undo, return error return-value
      746           :
      747           define variable ii              as integer       no-undo .
      748           define variable fh              as widget-handle no-undo .
      749           define variable hh              as widget-handle no-undo .
      750           define variable v-h             as handle        extent 4 no-undo .
      751           define variable v-name-button   as character     no-undo .
      752           define variable v-help-old-x    as decimal       no-undo .
      753           define variable v-help-old-y    as decimal       no-undo .
      754           define variable v-help-old-size as decimal       no-undo .
      755           define variable v-frame-width   as decimal       no-undo .
      756           define variable jj              as integer       no-undo .
      757           do
      758               on error undo, return error
      759               :
      760               assign
      761                   v-frame-width = frame Dialog-Frame:width - 0.3
      762                   fh            = frame Dialog-Frame:first-child
      763                   hh            = fh:first-child
      764                   ii            = 1
      765                   .
      766               do while valid-handle(hh):
      767                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      768                   do:
      769                       case lc(hh:name) :
      770                           when "b-help" then
      771                               do:
      772                                   hh:load-image-up("cmp/b-help.bmp":u) .
      773                                   hh:load-image-down("cmp/b-help.bmp":u) .
      774                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      775                                   hh:TOOLTIP = "Помощь" .
      776                                   v-help-old-x = hh:column .
      777                                   v-help-old-y = hh:row    .
      778                                   v-help-old-size = hh:width .
      779                                   hh:width-chars = 2.5 .
      780                               end.
      781                           when "b-print" then
      782                               do:
      783                                   hh:load-image("cmp/b-print.bmp":u) .
      784                                   hh:TOOLTIP = "Печать" .
      785                                   v-h[ii] = hh:handle .
      786                                   ii = ii + 1 .
      787                                   hh:width-chars = 3 .
      788                               end.
      789                           when "b-history" or
      790                           when "b-hist" then
      791                               do:
      792                                   hh:load-image("cmp/b-hist.bmp":u) .
      793                                   hh:TOOLTIP = "История" .
      794                                   v-h[ii] = hh:handle .
      795                                   ii = ii + 1 .
      796                                   hh:width-chars = 3 .
      797                               end.
      798                           when "b-sch" then
      799                               do:
      800                                   hh:load-image("cmp/b-sch.bmp":u) .
      801                                   hh:TOOLTIP = "Установка Фильтра" .
      802                                   v-h[ii] = hh:handle .
      803                                   ii = ii + 1 .
      804                                   hh:width-chars = 3 .
      805                               end.
      806                           when "b-hist-user" then
      807                               do:
      808                                   hh:load-image("cmp/b-hist.bmp":u) .
      809                                   hh:TOOLTIP = "История пользователя" .
      810                                   ii = ii + 1 .
      811                               end.
      812                       end case.
      813                   end.
      814                   hh = hh:next-sibling.
      815               end.
      816               b-help:column = v-frame-width - b-help:width-chars.
      817               jj = 0.
      818               repeat ii = 4 to 1 by -1 :
      819                   if valid-handle (v-h[ii] ) then
      820                   do:
      821                       jj  = jj + 1 .
      822                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      823                       v-h[ii]:row    = v-help-old-y .
      824                   end.
      825               end.
      826           end.
      827       end.
      828   end procedure.
      829   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      830   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      831   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      832   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      833   define variable v-diasize-current-frame-width  as decimal   no-undo .
      834   define variable v-diasize-current-frame-height as decimal   no-undo .
      835   define variable v-diasize-change-size          as logical   no-undo .
      836   define variable v-diasize-resize-button        as handle    no-undo .
      837   define variable v-diasize-wndmax               as logical   no-undo .
      838   define variable v-diasize-wndstore             as logical   no-undo .
      839   define variable v-diasize-proc-name            as character no-undo .
      840   define variable v-diasize-browse-handle        as handle    no-undo .
      841   define variable v-diasize-browse-number        as integer   no-undo .
      842   define variable v-diasize-need-full-display    as logical   no-undo init false .
      843   define temp-table temp-diasize-handle no-undo
      844     field handle-value  as handle
      845     field save-position as decimal
      846     index xpk is primary unique handle-value
      847     .
      848   define temp-table temp-browse-handle no-undo
      849     field browse-type   as character
      850     field browse-number as integer
      851     field browse-handle as handle
      852     field original-size as decimal
      853     index xpk is primary unique browse-type browse-number
      854     index xie browse-type browse-handle
      855   .
      856   procedure diasize_change-height :
      857     define input  parameter p-change-value  as decimal   no-undo .
      858     define input  parameter p-move-resize   as logical   no-undo .
      859     define variable v-field-group-handle    as handle    no-undo .
      860     define variable v-object-handle         as handle    no-undo .
      861     define variable v-frame-height          as decimal   no-undo .
      862     define variable v-frame-virtual-height  as decimal   no-undo .
      863     define variable v-browse-height         as decimal   no-undo .
      864     define variable v-window-height         as decimal   no-undo .
      865     define variable v-window-virtual-height as decimal   no-undo .
      866     define variable v-change-sign           as integer   no-undo .
      867     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      868     define buffer buf_temp-browse-handle  for temp-browse-handle .
      869     if p-change-value > 0
      870     then do:
      871       if frame Dialog-Frame :height + p-change-value
      872           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      873       then do:
      874         assign
      875           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      876                           - (frame Dialog-Frame :height-chars)
      877         .
      878         if p-change-value <= 0
      879         then do:
      880           run diasize_position-resize-button in this-procedure .
      881           return .
      882         end.
      883       end.
      884     end.
      885     if p-change-value < 0
      886     then do:
      887       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      888       then do:
      889         assign
      890           p-change-value = v-diasize-orig-frame-height
      891                          - (frame Dialog-Frame :height-chars)
      892         .
      893         if p-change-value >= 0
      894         then do:
      895           run diasize_position-resize-button in this-procedure .
      896           return .
      897         end.
      898       end.
      899     end.
      900     if p-change-value >= 0
      901     then do:
      902       assign
      903         v-change-sign = 1
      904       .
      905     end.
      906     else do:
      907       assign
      908         v-change-sign = -1
      909       .
      910     end.
      911     assign
      912       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      913     .
      914     if p-change-value = 0
      915     then do:
      916       run diasize_position-resize-button in this-procedure .
      917       return .
      918     end.
      919     move_block:
      920     do
      921     on error undo move_block, retry move_block
      922     :
      923       if retry
      924       then do:
      925         do
      926         on error undo move_block, leave move_block
      927         :
      928           if p-change-value > 0
      929           then do:
      930             for each buf_temp-diasize-handle
      931             on error undo, next
      932             :
      933               assign
      934                 v-object-handle = buf_temp-diasize-handle.handle-value
      935               .
      936               if v-object-handle <> v-diasize-resize-button
      937               then do:
      938                 assign
      939                   v-object-handle :row = buf_temp-diasize-handle.save-position
      940                 .
      941               end.
      942             end.
      943             assign
      944               v-diasize-browse-handle :height = v-browse-height
      945             .
      946             for each buf_temp-browse-handle
      947               where buf_temp-browse-handle.browse-type = 'height':u
      948             on error undo, next
      949             :
      950               assign
      951                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      952               .
      953             end.
      954             assign
      955               frame Dialog-Frame :height = v-frame-height
      956             .
      957             if frame Dialog-Frame :scrollable = true
      958             then do:
      959               assign
      960                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      961               .
      962             end.
      963             run diasize_position-resize-button in this-procedure .
      964           end.
      965           else do:
      966             if frame Dialog-Frame :scrollable = true
      967             then do:
      968               assign
      969                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      970               .
      971             end.
      972             assign
      973               frame Dialog-Frame :height = v-frame-height
      974             .
      975             assign
      976               v-diasize-browse-handle :height = v-browse-height
      977             .
      978             for each buf_temp-browse-handle
      979               where buf_temp-browse-handle.browse-type = 'height':u
      980             on error undo, next
      981             :
      982               assign
      983                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      984               .
      985             end.
      986             for each buf_temp-diasize-handle
      987             on error undo, next
      988             :
      989               assign
      990                 v-object-handle = buf_temp-diasize-handle.handle-value
      991               .
      992               if v-object-handle <> v-diasize-resize-button
      993               then do:
      994                 assign
      995                   v-object-handle :row = buf_temp-diasize-handle.save-position
      996                 .
      997               end.
      998             end.
      999             run diasize_position-resize-button in this-procedure .
     1000           end.
     1001           assign
     1002             v-diasize-change-size = false
     1003           .
     1004           leave move_block .
     1005         end.
     1006       end.
     1007       assign
     1008         v-diasize-need-full-display = true
     1009       .
     1010       if v-diasize-change-size = false
     1011       then do:
     1012         assign
     1013           v-diasize-change-size = true
     1014         .
     1015       end.
     1016       else do:
     1017         return .
     1018       end.
     1019       assign
     1020         v-frame-height = frame Dialog-Frame :height
     1021         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1022         v-browse-height = v-diasize-browse-handle :height
     1023       .
     1024       for each buf_temp-browse-handle
     1025         where buf_temp-browse-handle.browse-type = 'height':u
     1026       :
     1027         assign
     1028           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1029         .
     1030       end.
     1031       for each buf_temp-diasize-handle
     1032       :
     1033         delete buf_temp-diasize-handle .
     1034       end.
     1035       assign
     1036         v-field-group-handle = frame Dialog-Frame :first-child
     1037       .
     1038       do while valid-handle(v-field-group-handle)
     1039       :
     1040         assign
     1041           v-object-handle = v-field-group-handle :first-child
     1042         .
     1043         do while valid-handle(v-object-handle)
     1044         :
     1045           if  v-object-handle <> v-diasize-browse-handle :handle
     1046           and can-query(v-object-handle, "row")
     1047           and can-query(v-object-handle, "height")
     1048           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1049           then do:
     1050             find first buf_temp-browse-handle
     1051               where buf_temp-browse-handle.browse-type   = 'height':u
     1052                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1053               no-error .
     1054             if available buf_temp-browse-handle
     1055             then do:
     1056             end.
     1057             else do:
     1058               create buf_temp-diasize-handle .
     1059               assign
     1060                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1061                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1062               .
     1063             end.
     1064           end.
     1065           assign
     1066             v-object-handle = v-object-handle :next-sibling
     1067           .
     1068         end.
     1069         assign
     1070           v-field-group-handle = v-field-group-handle :next-sibling
     1071         .
     1072       end.
     1073       do with frame Dialog-Frame
     1074       :
     1075         hide v-diasize-resize-button .
     1076         assign
     1077           v-diasize-resize-button :row    = 1
     1078           v-diasize-resize-button :column = 1
     1079         .
     1080       end.
     1081       if p-change-value > 0
     1082       then do:
     1083         if frame Dialog-Frame :scrollable = true
     1084         then do:
     1085           assign
     1086             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1087             no-error .
     1088           if error-status :error
     1089           or error-status :get-message(1) <> ""
     1090           then do:
     1091             undo move_block, retry move_block .
     1092           end.
     1093         end.
     1094         assign
     1095           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1096           no-error .
     1097         if error-status :error
     1098         or error-status :get-message(1) <> ""
     1099         then do:
     1100           undo move_block, retry move_block .
     1101         end.
     1102         assign
     1103           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1104           no-error .
     1105         if error-status :error
     1106         or error-status :get-message(1) <> ""
     1107         then do:
     1108           undo move_block, retry move_block .
     1109         end.
     1110         for each buf_temp-browse-handle
     1111           where buf_temp-browse-handle.browse-type = 'height':u
     1112         on error undo move_block, retry move_block
     1113         :
     1114           assign
     1115             buf_temp-browse-handle.browse-handle :height
     1116               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1117             no-error .
     1118           if error-status :error
     1119           or error-status :get-message(1) <> ""
     1120           then do:
     1121             undo move_block, retry move_block .
     1122           end.
     1123         end.
     1124         for each buf_temp-diasize-handle
     1125         on error undo move_block, retry move_block
     1126         :
     1127           assign
     1128             v-object-handle = buf_temp-diasize-handle.handle-value
     1129           .
     1130           if v-object-handle <> v-diasize-resize-button
     1131           then do:
     1132             assign
     1133               v-object-handle :row = v-object-handle :row + p-change-value
     1134               no-error .
     1135             if error-status :error
     1136             or error-status :get-message(1) <> ""
     1137             then do:
     1138               undo move_block, retry move_block .
     1139             end.
     1140           end.
     1141         end.
     1142       end.
     1143       else do:
     1144         for each buf_temp-diasize-handle
     1145         on error undo move_block, retry move_block
     1146         :
     1147           assign
     1148             v-object-handle = buf_temp-diasize-handle.handle-value
     1149           .
     1150           if v-object-handle <> v-diasize-resize-button
     1151           then do:
     1152             assign
     1153               v-object-handle :row = v-object-handle :row + p-change-value
     1154               no-error .
     1155             if error-status :error
     1156             or error-status :get-message(1) <> ""
     1157             then do:
     1158               undo move_block, retry move_block .
     1159             end.
     1160           end.
     1161         end.
     1162         assign
     1163           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1164           no-error .
     1165         if error-status :error
     1166         or error-status :get-message(1) <> ""
     1167         then do:
     1168           undo move_block, retry move_block .
     1169         end.
     1170         for each buf_temp-browse-handle
     1171           where buf_temp-browse-handle.browse-type = 'height':u
     1172         on error undo move_block, retry move_block
     1173         :
     1174           assign
     1175             buf_temp-browse-handle.browse-handle :height
     1176               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1177             no-error .
     1178           if error-status :error
     1179           or error-status :get-message(1) <> ""
     1180           then do:
     1181             undo move_block, retry move_block .
     1182           end.
     1183         end.
     1184         assign
     1185           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1186           no-error .
     1187         if error-status :error
     1188         or error-status :get-message(1) <> ""
     1189         then do:
     1190           undo move_block, retry move_block .
     1191         end.
     1192         if frame Dialog-Frame :scrollable = true
     1193         then do:
     1194           assign
     1195             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1196             no-error .
     1197           if error-status :error
     1198           or error-status :get-message(1) <> ""
     1199           then do:
     1200             undo move_block, retry move_block .
     1201           end.
     1202         end.
     1203       end.
     1204       if p-move-resize = true
     1205       then do:
     1206         run diasize_position-resize-button in this-procedure .
     1207       end.
     1208       if v-diasize-wndstore = true
     1209       then do:
     1210         if connected("ub") = true
     1211         then do:
     1212           define variable v-cntxt-db-num        as integer   no-undo .
     1213           define variable v-cntxt-userid        as character no-undo .
     1214           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1215                                             , OUTPUT v-cntxt-userid
     1216                                             ) .
     1217           run gbl/wndsizew.p
     1218             (input  v-cntxt-db-num
     1219             ,input  v-cntxt-userid
     1220             ,input  v-diasize-proc-name
     1221             ,input  'height':u
     1222             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1223             ) .
     1224         end.
     1225       end.
     1226     end.
     1227     assign
     1228       v-diasize-change-size = false
     1229     .
     1230   end procedure.
     1231   procedure diasize_set-height :
     1232     define input  parameter p-new-height  as decimal   no-undo .
     1233     define input  parameter p-move-resize as logical   no-undo .
     1234     do
     1235     on error undo, return error return-value
     1236     :
     1237       run diasize_change-height in this-procedure
     1238         (input  (p-new-height - frame Dialog-Frame :height)
     1239         ,input  p-move-resize
     1240         ) .
     1241     end.
     1242   end procedure.
     1243   procedure diasize_change-width :
     1244     define input  parameter p-change-value as decimal   no-undo .
     1245     define input  parameter p-move-resize  as logical   no-undo .
     1246     define variable v-field-group-handle   as handle    no-undo .
     1247     define variable v-object-handle        as handle    no-undo .
     1248     define variable v-frame-width          as decimal   no-undo .
     1249     define variable v-frame-virtual-width  as decimal   no-undo .
     1250     define variable v-browse-width         as decimal   no-undo .
     1251     define variable v-window-width         as decimal   no-undo .
     1252     define variable v-window-virtual-width as decimal   no-undo .
     1253     define variable v-change-sign          as integer   no-undo .
     1254     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1255     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1256     if p-change-value > 0
     1257     then do:
     1258       if frame Dialog-Frame :width + p-change-value >
     1259           session :width-chars
     1260       then do:
     1261         assign
     1262           p-change-value = session :width-chars - frame Dialog-Frame :width
     1263         .
     1264         if p-change-value <= 0
     1265         then do:
     1266           run diasize_position-resize-button in this-procedure .
     1267           return .
     1268         end.
     1269       end.
     1270     end.
     1271     if p-change-value < 0
     1272     then do:
     1273       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1274       then do:
     1275         assign
     1276           p-change-value = v-diasize-orig-frame-width
     1277                          - frame Dialog-Frame :width
     1278         .
     1279         if p-change-value >= 0
     1280         then do:
     1281           run diasize_position-resize-button in this-procedure .
     1282           return .
     1283         end.
     1284       end.
     1285     end.
     1286     if p-change-value >= 0
     1287     then do:
     1288       assign
     1289         v-change-sign = 1
     1290       .
     1291     end.
     1292     else do:
     1293       assign
     1294         v-change-sign = -1
     1295       .
     1296     end.
     1297     assign
     1298       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1299     .
     1300     if p-change-value = 0
     1301     then do:
     1302       run diasize_position-resize-button in this-procedure .
     1303       return .
     1304     end.
     1305     move_block:
     1306     do
     1307     on error undo move_block, leave move_block
     1308     :
     1309       if retry
     1310       then do:
     1311         do
     1312         on error undo move_block, leave move_block
     1313         :
     1314           if p-change-value > 0
     1315           then do:
     1316             for each buf_temp-diasize-handle
     1317             on error undo, next
     1318             :
     1319               assign
     1320                 v-object-handle = buf_temp-diasize-handle.handle-value
     1321               .
     1322               if v-object-handle <> v-diasize-resize-button
     1323               then do:
     1324                 assign
     1325                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1326                 .
     1327               end.
     1328             end.
     1329             assign
     1330               v-diasize-browse-handle :width = v-browse-width
     1331             .
     1332             for each buf_temp-browse-handle
     1333               where buf_temp-browse-handle.browse-type = 'width':u
     1334             on error undo, next
     1335             :
     1336               assign
     1337                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1338               .
     1339             end.
     1340             assign
     1341               frame Dialog-Frame :width = v-frame-width
     1342             .
     1343             if frame Dialog-Frame :scrollable = true
     1344             then do:
     1345               assign
     1346                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1347               .
     1348             end.
     1349             run diasize_position-resize-button in this-procedure .
     1350           end.
     1351           else do:
     1352             if frame Dialog-Frame :scrollable = true
     1353             then do:
     1354               assign
     1355                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1356               .
     1357             end.
     1358             assign
     1359               frame Dialog-Frame :width = v-frame-width
     1360             .
     1361             for each buf_temp-browse-handle
     1362               where buf_temp-browse-handle.browse-type = 'width':u
     1363             on error undo, next
     1364             :
     1365               assign
     1366                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1367               .
     1368             end.
     1369             assign
     1370               v-diasize-browse-handle :width = v-browse-width
     1371             .
     1372             for each buf_temp-diasize-handle
     1373             on error undo, next
     1374             :
     1375               assign
     1376                 v-object-handle = buf_temp-diasize-handle.handle-value
     1377               .
     1378               if v-object-handle <> v-diasize-resize-button
     1379               then do:
     1380                 assign
     1381                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1382                 .
     1383               end.
     1384             end.
     1385             run diasize_position-resize-button in this-procedure .
     1386           end.
     1387           assign
     1388             v-diasize-change-size = false
     1389           .
     1390           leave move_block .
     1391         end.
     1392       end.
     1393       assign
     1394         v-diasize-need-full-display = true
     1395       .
     1396       if v-diasize-change-size = false
     1397       then do:
     1398         assign
     1399           v-diasize-change-size = true
     1400         .
     1401       end.
     1402       else do:
     1403         return .
     1404       end.
     1405       assign
     1406         v-frame-width = frame Dialog-Frame :width
     1407         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1408         v-browse-width = v-diasize-browse-handle :width
     1409       .
     1410       for each buf_temp-browse-handle
     1411         where buf_temp-browse-handle.browse-type = 'width':u
     1412       :
     1413         assign
     1414           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1415         .
     1416       end.
     1417       for each buf_temp-diasize-handle
     1418       :
     1419         delete buf_temp-diasize-handle .
     1420       end.
     1421       assign
     1422         v-field-group-handle = frame Dialog-Frame :first-child
     1423       .
     1424       do while valid-handle(v-field-group-handle)
     1425       :
     1426         assign
     1427           v-object-handle = v-field-group-handle :first-child
     1428         .
     1429         do while valid-handle(v-object-handle)
     1430         :
     1431           if  v-object-handle <> v-diasize-browse-handle :handle
     1432           and v-object-handle <> v-diasize-resize-button
     1433           and can-query(v-object-handle, "row")
     1434           and can-query(v-object-handle, "height")
     1435           and ( v-object-handle :col + v-object-handle :width
     1436                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1437               )
     1438           then do:
     1439             find first buf_temp-browse-handle
     1440               where buf_temp-browse-handle.browse-type   = 'width':u
     1441                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1442               no-error .
     1443             if available buf_temp-browse-handle
     1444             then do:
     1445             end.
     1446             else do:
     1447               create buf_temp-diasize-handle .
     1448               assign
     1449                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1450                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1451               .
     1452             end.
     1453           end.
     1454           assign
     1455             v-object-handle = v-object-handle :next-sibling
     1456           .
     1457         end.
     1458         assign
     1459           v-field-group-handle = v-field-group-handle :next-sibling
     1460         .
     1461       end.
     1462       do with frame Dialog-Frame
     1463       :
     1464         hide v-diasize-resize-button .
     1465         v-diasize-resize-button :row = 1.
     1466         v-diasize-resize-button :column = 1.
     1467       end.
     1468       if p-change-value > 0
     1469       then do:
     1470         if frame Dialog-Frame :scrollable = true
     1471         then do:
     1472           assign
     1473             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1474             no-error .
     1475           if error-status :error
     1476           or error-status :get-message(1) <> ""
     1477           then do:
     1478             undo move_block, retry move_block.
     1479           end.
     1480         end.
     1481         assign
     1482           frame Dialog-Frame :width = v-frame-width + p-change-value
     1483           no-error .
     1484         if error-status :error
     1485         or error-status :get-message(1) <> ""
     1486         then do:
     1487           undo move_block, retry move_block.
     1488         end.
     1489         assign
     1490           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1491         no-error .
     1492         if error-status :error
     1493         or error-status :get-message(1) <> ""
     1494         then do:
     1495           undo move_block, retry move_block.
     1496         end.
     1497         for each buf_temp-browse-handle
     1498           where buf_temp-browse-handle.browse-type = 'width':u
     1499         on error undo move_block, retry move_block
     1500         :
     1501           assign
     1502             buf_temp-browse-handle.browse-handle :width
     1503               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1504             no-error .
     1505           if error-status :error
     1506           or error-status :get-message(1) <> ""
     1507           then do:
     1508             undo move_block, retry move_block .
     1509           end.
     1510         end.
     1511         for each buf_temp-diasize-handle
     1512         on error undo move_block, retry move_block
     1513         :
     1514           assign
     1515             v-object-handle = buf_temp-diasize-handle.handle-value
     1516           .
     1517           if v-object-handle <> v-diasize-resize-button
     1518           then do:
     1519             assign
     1520               v-object-handle :col = v-object-handle :col + p-change-value
     1521               no-error .
     1522             if error-status :error
     1523             or error-status :get-message(1) <> ""
     1524             then do:
     1525               undo move_block, retry move_block .
     1526             end.
     1527           end.
     1528         end.
     1529       end.
     1530       else do:
     1531         for each buf_temp-diasize-handle
     1532         on error undo move_block, retry move_block
     1533         :
     1534           assign
     1535             v-object-handle = buf_temp-diasize-handle.handle-value
     1536           .
     1537           if v-object-handle <> v-diasize-resize-button
     1538           then do:
     1539             assign
     1540               v-object-handle :col = v-object-handle :col + p-change-value
     1541               no-error .
     1542             if error-status :error
     1543             or error-status :get-message(1) <> ""
     1544             then do:
     1545               undo move_block, retry move_block .
     1546             end.
     1547           end.
     1548         end.
     1549         for each buf_temp-browse-handle
     1550           where buf_temp-browse-handle.browse-type = 'width':u
     1551         on error undo move_block, retry move_block
     1552         :
     1553           assign
     1554             buf_temp-browse-handle.browse-handle :width
     1555               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1556             no-error .
     1557           if error-status :error
     1558           or error-status :get-message(1) <> ""
     1559           then do:
     1560             undo move_block, retry move_block .
     1561           end.
     1562         end.
     1563         assign
     1564           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1565           no-error .
     1566         if error-status :error
     1567         or error-status :get-message(1) <> ""
     1568         then do:
     1569           undo move_block, retry move_block.
     1570         end.
     1571         assign
     1572           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1573         no-error .
     1574         if error-status :error
     1575         or error-status :get-message(1) <> ""
     1576         then do:
