      455   END.
      456   ON CHOOSE OF B-add IN FRAME Dialog-Frame
      457   DO:
      458   define variable vss-include-info2 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      459   if lookup(self :type
      460            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      461            ) = 0
      462   then do:
      463     message
      464       "$Workfile$"
      465       "Указанному интерфейсному элементу фокус не может быть передан" skip
      466       "Интерфейсный элемент" self :name  skip
      467       "Тип" self :type  skip
      468       "Процедура" this-procedure :file-name skip
