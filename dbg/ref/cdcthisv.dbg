     2165   procedure rule-call-param-proc :
     2166   define output parameter p-description as character no-undo .
     2167   define buffer current_c-rule-call-param for ub.c-rule-call-param .
     2168     do
     2169     on error undo, return error
     2170     :
     2171       find first current_c-rule-call-param no-lock where
     2172                  current_c-rule-call-param.chip-num = buf_c-dis-card-type.chip-num
     2173              AND current_c-rule-call-param.corr-user-db-num = buf_c-dis-card-type.corr-user-db-num
     2174              AND current_c-rule-call-param.call_id = buf_c-dis-card-type.uniq-key-rec no-error .
     2175       if not avail current_c-rule-call-param then do:
     2176          v-mess = "Неверная ссылка на c-rule-call-param в таблице c-dis-card-type".
     2177          run err-mess(input-output v-mess).
     2178       end.
     2179   define variable v-label-param as character no-undo .
     2180   v-label-param =
     2181     "call_id" + chr(4) + "Точка вызова" + chr(4) + "calldscr" + chr(8)
     2182    + "call#_id" + chr(4) + "Уник.идент.точки вызова" + chr(4) + "" + chr(8)
     2183    + "profile_id" + chr(4) + "Профайл" + chr(4) + ""  + chr(8)
     2184    + "codex_id" + chr(4) + "Кодекс" + chr(4) + ""  + chr(8)
     2185    + "ruleset_id" + chr(4) + "Набор правил" + chr(4) + ""  + chr(8)
     2186    + "order_id" + chr(4) + "Порядок вызова" + chr(4) + ""  + chr(8)
     2187    + "rule_id" + chr(4) + "№ правила" + chr(4) + ""  + chr(8)
