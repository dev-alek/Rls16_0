     2189    + "param-data-type" + chr(4) + "Тип данных" + chr(4) + ""  + chr(8)
     2190    + "param-2-data-type" + chr(4) + "Тип данных2" + chr(4) + ""  + chr(8)
     2191    + "param-3-data-type" + chr(4) + "Тип данных3" + chr(4) + ""  + chr(8)
     2192    + "param-label" + chr(4) + "Лейбл параметра" + chr(4) + ""  + chr(8)
     2193    + "param-mode" + chr(4) + "Мода параметра" + chr(4) + ""  + chr(8)
     2194    + "param-name" + chr(4) + "Имя параметра" + chr(4) + ""  + chr(8)
     2195    + "p-index" + chr(4) + "Индекс" + chr(4) + ""  + chr(8)
     2196    + "param-num" + chr(4) + "№ параметра" + chr(4) + ""  + chr(8)
     2197    + "param-value-character" + chr(4) + "Значение параметра" + chr(4) + ""  + chr(8)
     2198    + "param-value-date" + chr(4) + "Значение параметра" + chr(4) + ""  + chr(8)
     2199    + "param-value-decimal" + chr(4) + "Значение параметра" + chr(4) + ""  + chr(8)
     2200    + "param-value-integer" + chr(4) + "Значение параметра" + chr(4) + ""  + chr(8)
     2201    + "param-value-logical" + chr(4) + "Значение параметра" + chr(4) + ""
     2202    .
     2203    run proc-full-temp-changes in this-procedure (
     2204                                                input  (buf_c-dis-card-type.action = integer('1':U))
     2205                                               ,input  (buf_c-dis-card-type.action = integer('99':U))
     2206                                               ,input  buffer current_c-rule-call-param:handle
     2207                                               ,input  'rule-call-param':U
     2208                                               ,input  "call_id,call#_id,profile_id,codex_id,ruleset_id,order_id,rule_id,param-des,param-data-type,param-label,param-mode,param-name,param-num,param-value-character,param-value-date,param-value-decimal,param-value-integer,param-value-logical"
     2209                                               ,input  v-label-param).
     2210   end.
     2211   end procedure.
     2212   procedure dis-dct-rule-proc :
     2213   define output parameter p-description as character no-undo .
     2214   define variable v-label as character no-undo .
     2215   define buffer current_c-dis-dct-rule for ub.c-dis-dct-rule  .
     2216   do
     2217   on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     2218   :
     2219       find first current_c-dis-dct-rule no-lock where
     2220                  current_c-dis-dct-rule.type = p-type
     2221              and current_c-dis-dct-rule.emitent-host-code = p-emitent-host-code
     2222              AND current_c-dis-dct-rule.chip-num = p-chip-num
     2223              AND current_c-dis-dct-rule.corr-user-db-num = p-corr-user-db-num    no-error .
     2224       if not avail current_c-dis-dct-rule then do:
     2225          v-mess = "Неверная ссылка на c-dis-dct-rule в таблице c-dc-hist".
     2226          run err-mess in this-procedure ( input-output v-mess).
     2227          return error v-mess.
     2228       end.
     2229       run disdctru-name in this-procedure (
     2230                   input  current_c-dis-dct-rule.templ-rl-root
     2231                   ,output v-label
     2232                   ) no-error .
     2233       assign
     2234       p-description = substitute("Тип скидки &1", v-label)
     2235       .
     2236   define variable v-label-param as character no-undo .
     2237   v-label-param =
     2238     "rule-num" + chr(4) + "Номер правила скидки" + chr(4) + "" + chr(8)
     2239    + "pos-type" + chr(4) + "Место использ" + chr(4) + "cd-type-name-f" + chr(8)
     2240    + "templ-rl-root" + chr(4) + "Тип шаблона" + chr(4) + "disdctru-get-disc-label"  + chr(8)
     2241    + "discnt-role" + chr(4) + "Тип скидки" + chr(4) + "disdctru-get-disc-role-label" + chr(8)
     2242    + "host-code" + chr(4) + "Код фирмы" + chr(4) + "" + chr(8)
     2243    + "obj-type" + chr(4) + "Тип объекта" + chr(4) + "" + chr(8)
     2244    + "obj-code" + chr(4) + "Код объекта" + chr(4)  + ""
     2245    .
     2246     run proc-full-temp-changes in this-procedure (
     2247                                                input  (buf_c-dis-card-type.action = integer('1':U))
     2248                                               ,input  (buf_c-dis-card-type.action = integer('99':U))
     2249                                               ,input  buffer current_c-dis-dct-rule:handle
     2250                                               ,input  'dis-dct-rule':U
     2251                                               ,input  "rule-num,pos-type,templ-rl-root,discnt-role,host-code,obj-type,obj-code"
     2252                                               ,input  v-label-param).
     2253   end.
     2254   end procedure.
     2255   FUNCTION get-hn-label RETURNS CHARACTER
     2256     ( INPUT p-hn-option AS character ) :
     2257     RETURN entry (lookup (p-hn-option, '0,-1,1,10,-10':U) + 1, ',' + 'Да,Нет,Смарт2,Всегда,Никогда':U).
     2258   END FUNCTION.
     2259   function cd-type-name-f returns character ( input p-cd-type-code as character):
     2260   if p-cd-type-code = '':U then return '':U.
     2261   return entry (lookup (p-cd-type-code, 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,r-keeper,InfoKiosk,pricecheck-Servis+,Emulator-NKT-IBM,MARIA,-,bo,Autotank':U), 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,R-KEEPER,InfoKiosk,Прайс-чекер Servis+,Emulator-NKT-IBM,MARIA,Накладная,Бэкофис,Autotank':U).
     2262   end function.
     2263   procedure hist-nws-option-proc :
     2264   define output parameter p-description as character no-undo .
     2265   define buffer buf_c-table-bind for ub.c-table-bind.
     2266   define buffer curr_c-hist-nws-option for ub.c-hist-nws-option .
     2267   do
     2268   on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     2269   :
     2270       find first buf_c-table-bind no-lock where
     2271                 buf_c-table-bind.corr-user-db-num = buf_c-dis-card-type.corr-user-db-num
     2272             AND buf_c-table-bind.tbl-name-rec     = 'c-dis-card-type':U
     2273             AND buf_c-table-bind.chip-num-rec     = buf_c-dis-card-type.chip-num no-error .
     2274       if not available buf_c-table-bind then do:
     2275         v-mess = "Неверная ссылка на c-table-bind в таблице c-dis-card-type".
     2276         run err-mess in this-procedure ( input-output v-mess).
     2277         return error v-mess.
     2278       end.
     2279       find first curr_c-hist-nws-option no-lock where
     2280                  curr_c-hist-nws-option.subject-group = 'c-dc-hist':U
     2281              AND curr_c-hist-nws-option.charkey_one = buf_c-dis-card-type.type
     2282              AND curr_c-hist-nws-option.host-code = buf_c-dis-card-type.emitent-host-code
     2283              AND curr_c-hist-nws-option.corr-user-db-num = buf_c-table-bind.corr-user-db-num
     2284              AND curr_c-hist-nws-option.chip-num = buf_c-table-bind.chip-num-src  no-error .
     2285       if not avail curr_c-hist-nws-option then do:
     2286         v-mess = "Неверная ссылка на c-hist-nws-option в таблице c-table-bind".
     2287         run err-mess in this-procedure ( input-output v-mess).
     2288         return error v-mess.
     2289       end.
     2290       assign
     2291       p-description = substitute("&1 (для БД &2)", curr_C-hist-nws-option.option-descr, curr_C-hist-nws-option.db-num).
     2292   define variable v-label-param as character no-undo .
     2293   v-label-param =
     2294     "option-descr" + chr(4) + "Описание" + chr(4) + "" + chr(8)
     2295    + "db-num" + chr(4) + "БД" + chr(4) + "" + chr(8)
     2296    + "hn-id" + chr(4) + "ID" + chr(4) + "" + chr(8)
     2297    + "table-name" + chr(4) + "Таблица/Сущность" + chr(4) + "" + chr(8)
     2298    + "subject-group" + chr(4) + "Группа данных" + chr(4) + "" + chr(8)
     2299    + "get-hist-from-nws" + chr(4) + "Прием истории из другой УБД" + chr(4) + "get-hn-label" + chr(8)
     2300    + "hist-from-prim" + chr(4) + "Запись истории при непосред.изменении" + chr(4) + "get-hn-label" + chr(8)
     2301    + "hist-to-nws" + chr(4) + "Пересылка ист. в другие БД" + chr(4) + "get-hn-label" + chr(8)
     2302    + "nws-to-hist" + chr(4) + "Создание ист. при приеме по СПН" + chr(4) + "get-hn-label" + chr(8)
     2303    + "smart-nws" + chr(4) + "Оптимизированная маршрутизация" + chr(4) + "get-hn-label" + chr(8)
     2304    + "nws-to-cd" + chr(4) + "Активация посылки на кассу при приеме из СПН" + chr(4) + "get-hn-label"
     2305    .
     2306    run proc-full-temp-changes in this-procedure (
     2307                                                input  (buf_c-dis-card-type.action = integer('1':U))
     2308                                               ,input  (buf_c-dis-card-type.action = integer('99':U))
     2309                                               ,input  buffer curr_c-hist-nws-option:handle
     2310                                               ,input  'hist-nws-option':U
     2311                                               ,input  "option-descr,db-num,hn-id,table-name,subject-group,get-hist-form-nws,hist-from-prim,hist-to-nws,nws-to-hist,smart-nws,nws-to-cd"
     2312                                               ,input  v-label-param).
     2313     end.
     2314   end procedure.
     2315   PROCEDURE err-mess:
     2316     DEFINE INPUT-output PARAMETER p-mess as character No-UNDO.
     2317     p-mess =
     2318     substitute("История типов ДК: Эмитент &1 тип &2: щепка &6 БД:&7 фирма: &3 объект: &4&5 Предмет изменений &8"
     2319                 ,p-emitent-host-code
     2320                 ,p-type
     2321                 ,p-host-code
     2322                 ,p-obj-type
     2323                 ,p-obj-code
     2324                 ,p-chip-num
     2325                 ,p-corr-user-db-num
     2326                 ,p-subject) + chr(10) + p-mess
     2327                 .
     2328     CASE p-silent:
     2329       when yes then do:
     2330       end.
     2331       otherwise do:
     2332         message
     2333         p-mess
     2334         view-as alert-box error .
     2335       end.
     2336     end.
     2337   END PROCEDURE.
