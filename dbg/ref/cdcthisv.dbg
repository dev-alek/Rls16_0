     2046                                               ,input  buffer current_c-dis-card-type-attr:handle
     2047                                               ,input  'dis-card-type-attr':U
     2048                                               ,input  "attr-value,obj-type,obj-code,host-code,attr-code,type,emitent-host-code"
     2049                                               ,input  v-label-param).
     2050   end.
     2051   end procedure.
     2052   function view-cc-run returns character ( input p-cc-run-chr as character):
     2053   if p-cc-run-chr = '' then p-cc-run-chr = '0':U.
     2054   return  entry (lookup (p-cc-run-chr, '0,1':U), 'Нет_алгоритма,Алгоритм_Луна':U).
     2055   end.
     2056   function view-use-on returns character ( input p-use-on-chr as character):
     2057   if p-use-on-chr = '' then p-use-on-chr = '0':U.
     2058   return  entry (lookup (p-use-on-chr, '0,1,2':U), 'Касса_и_TH,ТОЛЬКО_касса,ТОЛЬКО_TH':U).
     2059   end.
     2060   procedure dis-card-mask-proc :
