        1   block-level on error undo, throw.
        2   define input parameter p-emitent-host-code  like ub.c-dis-card-type.emitent-host-code no-undo .
        3   define input parameter p-type               like ub.c-dis-card-type.type no-undo .
        4   define input parameter p-chip-num like ub.c-cli-hist.chip-num no-undo .
        5   define input parameter p-corr-user-db-num like ub.c-dis-card-type.corr-user-db-num no-undo .
        6   define input parameter p-obj-type like ub.c-dis-card-type.obj-type no-undo .
        7   define input parameter p-obj-code like ub.c-dis-card-type.obj-code no-undo .
        8   define input parameter p-host-code like ub.c-dis-card-type.host-code no-undo .
        9   define input parameter p-subject like ub.c-dis-card-type.subject no-undo .
       10   define input parameter p-action   like ub.c-dis-card-type.action no-undo .
       11   define input parameter p-silent  as logical no-undo .
       12   define output parameter p-description as character no-undo .
       13   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       14   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       15   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       16   define variable vss-workfile    as character no-undo init "$Workfile: cdcthisv.p $":U .
       17   define variable vss-archive     as character no-undo init "$Archive: ref/cdcthisv.p $":U .
       18   define variable vss-description as character no-undo init "Заполнение временной таблицы для показа изменений по таблицам истории ДК".
       19   procedure vss-get-info :
       20     define output parameter p-vss-revision    like vss-revision    no-undo .
       21     define output parameter p-vss-author      like vss-author      no-undo .
       22     define output parameter p-vss-date        like vss-date        no-undo .
       23     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       24     define output parameter p-vss-archive     like vss-archive     no-undo .
       25     define output parameter p-vss-description like vss-description no-undo .
       26     assign
       27       p-vss-revision    = vss-revision
       28       p-vss-author      = vss-author
       29       p-vss-date        = vss-date
       30       p-vss-workfile    = vss-workfile
       31       p-vss-archive     = vss-archive
       32       p-vss-description = vss-description
       33     .
       34   end procedure.
       35   procedure vss-get-parameters :
       36     define output parameter p-vss-parameters as character no-undo .
       37   end procedure.
       38   define new global shared variable g#vssrevis-logger as handle    no-undo .
       39   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       40   define variable v-vssrevis-logger                   as handle    no-undo .
       41   procedure vss-logevent :
       42     define input  parameter p-extra-paramters as character no-undo .
       43     define variable v-vssrevis-parameters as character no-undo .
       44     do
       45     on error undo, return error return-value
       46     :
       47       if  valid-handle(v-vssrevis-logger)
       48       and v-vssrevis-logger :get-signature("logevent") <> ""
       49       then do:
       50         run vss-get-parameters in this-procedure
       51           (output v-vssrevis-parameters
       52           ).
       53         run logevent in v-vssrevis-logger
       54           (input vss-workfile
       55           ,input vss-revision
       56           ,input v-vssrevis-parameters
       57           ,input p-extra-paramters
       58           ).
       59       end.
       60     end.
       61   end procedure.
       62   assign
       63     v-vssrevis-logger = g#vssrevis-logger
       64   .
       65   if  valid-handle(v-vssrevis-logger)
       66   and v-vssrevis-logger :get-signature("logevent") <> ""
       67   then do:
       68     assign
       69       v-vssrevis-logevent = true
       70     .
       71     run vss-logevent in this-procedure (input vss-description) .
       72   end.
       73   define new global shared variable g#language as character no-undo .
       74   if g#language <> '' and g#language <> 'rus':U then do:
       75     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       76   end.
       77   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       78   def var vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       79   procedure gen-key-rec :
       80     define input  parameter p-tbl-name    as character no-undo.
       81     define input  parameter p-bh_tbl-name as handle    no-undo.
       82     define output parameter p-key-rec     as character no-undo.
       83     do
       84     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
       85     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
       86     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
       87     :
       88       define variable fh               as handle    no-undo .
       89       define variable v-ok             as logical   no-undo .
       90       define variable v-inform         as character no-undo .
       91       define variable v-ind            as integer   no-undo .
       92       define variable v-idx-field-qnty as integer   no-undo .
       93       if p-tbl-name = ?
       94         or p-tbl-name = "":U
       95       then do:
       96         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info1 ).
       97       end.
       98       if not p-bh_tbl-name:available then do:
       99         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info1, p-tbl-name ).
      100       end.
      101       assign
      102         p-key-rec = p-tbl-name
      103         v-inform  = p-bh_tbl-name:index-information(1)
      104         v-ind     = 2
      105       .
      106       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      107       on error undo, return error
      108       :
      109         assign
      110           v-inform = p-bh_tbl-name:index-information( v-ind )
      111           v-ind    = v-ind + 1
      112         .
      113       end.
      114       if v-inform = ?
      115         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      116         or entry( 3, v-inform, ",":U ) <> "1":U
      117       then do:
      118         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info1, p-tbl-name ).
      119       end.
      120       else do:
      121         assign
      122           v-idx-field-qnty = num-entries( v-inform ) - 4
      123         .
      124         if v-idx-field-qnty < 2 then do:
      125           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, p-tbl-name ).
      126         end.
      127         do v-ind = 1 to v-idx-field-qnty by 2
      128         on error undo, return error
      129         :
      130           assign
      131             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      132             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      133           .
      134         end.
      135       end.
      136       if p-key-rec = ? then do:
      137         assign
      138           p-key-rec = "":U
      139         .
      140         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info1, p-tbl-name ).
      141       end.
      142     end.
      143     return.
      144   end procedure.
      145   procedure gen-where-keyr-tab :
      146     define input  parameter i-tableSerach as character no-undo.
      147     define input  parameter i-tablekey   as character  no-undo.
      148     define input  parameter p-key-rec    as character  no-undo.
      149     define input  parameter p-key-handle as handle     no-undo .
      150     define input  parameter p-db-name    as character  no-undo .
      151     define input  parameter p-tt-handle  as handle     no-undo .
      152     define output parameter o-Where      as character  no-undo.
      153     do
      154     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      155     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      156     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      157     :
      158       define variable v-full-tbl-name  as character no-undo .
      159       define variable bh_tbl-name      as handle    no-undo .
      160       define variable fh_key           as handle    no-undo .
      161       define variable fh_search        as handle    no-undo .
      162       define variable v-field-num      as integer   no-undo .
      163       define variable v-count-fld      as integer   no-undo .
      164       define variable v-inform         as character no-undo .
      165       define variable v-ind            as integer   no-undo .
      166       define variable v-idx-field-qnty as integer   no-undo .
      167       define variable v-field-name     as character no-undo .
      168       define variable v-field-val      as character no-undo .
      169       define variable v-word-link      as character no-undo .
      170       define variable vTable           as character no-undo.
      171       define variable bh_tbl-key       as handle    no-undo .
      172       assign
      173         p-key-rec = trim( p-key-rec )
      174       .
      175       if p-key-handle <> ? then do:
      176         if not valid-handle(p-key-handle)
      177            or p-key-handle:type <> "buffer"
      178         then do:
      179           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info1 ).
      180         end.
      181         if num-entries( p-key-rec, chr(3) ) > 1
      182           or p-key-rec = ?
      183           or p-key-rec = "":U
      184         then do:
      185           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info1, p-key-rec ).
      186         end.
      187       end.
      188       else do:
      189         if p-key-rec = ?
      190           or p-key-rec = "":U
      191         then do:
      192           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info1 ).
      193         end.
      194       end.
      195       assign
      196         vTable = entry( 1 , p-key-rec, chr(3) )
      197       .
      198       if p-tt-handle <> ?
      199         and ( not valid-handle(p-tt-handle)
      200               or p-tt-handle:type <> "buffer"
      201             )
      202       then do:
      203         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info1, vTable, chr(10) ).
      204       end.
      205       if p-tt-handle = ? then do:
      206         assign
      207           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      208         .
      209         create buffer bh_tbl-name for table v-full-tbl-name .
      210       end.
      211       else do:
      212         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      213       end.
      214       assign
      215         v-inform = bh_tbl-name:index-information(1)
      216         v-ind    = 2
      217       .
      218       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      219       on error undo, return error
      220       :
      221         assign
      222           v-inform = bh_tbl-name:index-information( v-ind )
      223           v-ind    = v-ind + 1
      224         .
      225       end.
      226       if v-inform = ?
      227         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      228         or entry( 3, v-inform, ",":U ) <> "1":U
      229       then do:
      230         delete object bh_tbl-name no-error.
      231         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info1, vTable ).
      232       end.
      233       assign
      234         v-idx-field-qnty = num-entries( v-inform ) - 4
      235       .
      236       if v-idx-field-qnty < 2 then do:
      237         delete object bh_tbl-name no-error.
      238         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, vTable ).
      239       end.
      240       assign
      241         o-where     = "where":U
      242         v-word-link = "":U
      243         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      244         v-count-fld = 0
      245       .
      246       if i-tablekey ne "" and i-tablekey ne ?
      247       then do:
      248         assign
      249           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      250         .
      251         create buffer bh_tbl-key for table v-full-tbl-name .
      252       end.
      253       if i-tableSerach ne "" and i-tableSerach ne ?
      254       then do:
      255         delete object bh_tbl-name no-error.
      256         assign
      257           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      258         .
      259         create buffer bh_tbl-name for table v-full-tbl-name .
      260       end.
      261       block_where:
      262       do v-ind = 1 to v-idx-field-qnty by 2
      263       on error undo, return error
      264       :
      265         assign
      266           v-count-fld = v-count-fld + 1
      267         .
      268         if p-key-handle = ?
      269           and v-count-fld > v-field-num
      270         then do:
      271           leave block_where.
      272         end.
      273         define variable VfieldKeyTable as handle no-undo.
      274         assign
      275           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      276           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      277         .
      278         if     bh_tbl-key ne ?
      279         then do:
      280            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      281            if VfieldKeyTable eq ?
      282            then next block_where.
      283         end.
      284         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      285         then
      286            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      287         else
      288            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      289         if p-key-handle = ? then do:
      290           assign
      291             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      292           .
      293         end.
      294         else do:
      295           assign
      296             fh_key = p-key-handle:buffer-field( v-field-name )
      297           .
      298           if fh_key = ?
      299             or not valid-handle( fh_key )
      300           then do:
      301             delete object bh_tbl-name.
      302             if     bh_tbl-key ne ?
      303             then
      304                delete object bh_tbl-key.
      305             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info1, p-key-handle:name, v-field-name ).
      306           end.
      307           assign
      308             v-field-val = fh_key:buffer-value
      309           .
      310         end.
      311         if fh_search:data-type ="character":U then do:
      312           assign
      313             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      314             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      315             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      316             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      317             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      318             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      319             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      320             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      321             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      322             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      323             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      324             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      325             v-field-val = substitute( '"&1"', v-field-val )
      326           .
      327         end.
      328         assign
      329           o-where = substitute( "&1 &2", o-where, v-field-val )
      330         .
      331         if v-word-link = "":U then do:
      332           assign
      333             v-word-link = "and":U
      334           .
      335         end.
      336       end.
      337       delete object bh_tbl-name.
      338       if     bh_tbl-key ne ?
      339       then
      340          delete object bh_tbl-key.
      341       if p-key-handle = ?
      342         and v-count-fld <> v-field-num
      343       then do:
      344         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info1, vTable ).
      345       end.
      346     end.
      347   end procedure.
      348   procedure gen-hn-keyr-tab :
      349     define input  parameter i-tableSerach as character no-undo.
      350     define input  parameter i-tablekey   as character no-undo.
      351     define input  parameter p-key-rec    as character no-undo.
      352     define input  parameter p-key-handle as handle    no-undo .
      353     define input  parameter p-db-name    as character no-undo .
      354     define input  parameter p-tt-handle  as handle    no-undo .
      355     define input  parameter p-stts-lock  as integer   no-undo .
      356     define output parameter o-hn         as handle    no-undo.
      357     define variable v-full-tbl-name as character no-undo.
      358     define variable v-where         as character no-undo.
      359     define variable bh_tbl-name     as handle    no-undo.
      360     define variable vTable          as character no-undo.
      361     do
      362     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      363     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      364     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      365         run gen-where-keyr-tab(i-tableSerach,
      366                                i-tablekey,
      367                                p-key-rec,
      368                                p-key-handle,
      369                                p-db-name,
      370                                p-tt-handle,
      371                                output v-where).
      372         if i-tableSerach ne "" and i-tableSerach ne ?
      373         then do:
      374            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      375            create buffer bh_tbl-name for table v-full-tbl-name .
      376         end.
      377         else do:
      378            if p-tt-handle = ? then do:
      379               assign
      380                  vTable = entry( 1 , p-key-rec, chr(3) )
      381               .
      382               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      383               create buffer bh_tbl-name for table v-full-tbl-name .
      384            end.
      385            else do:
      386               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      387            end.
      388         end.
      389         if p-tt-handle = ? then do:
      390            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      391         end.
      392         else do:
      393            bh_tbl-name:find-first( v-where ) no-error .
      394         end.
      395         o-hn = bh_tbl-name.
      396      end.
      397   end procedure.
      398   procedure gen-hn-keyr :
      399     define input  parameter p-key-rec    as character no-undo.
      400     define input  parameter p-key-handle as handle    no-undo .
      401     define input  parameter p-db-name    as character no-undo .
      402     define input  parameter p-tt-handle  as handle    no-undo .
      403     define input  parameter p-stts-lock  as integer   no-undo .
      404     define output parameter o-hn         as handle    no-undo.
      405     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      406   end.
      407   procedure gen-row-keyr :
      408     define input  parameter p-key-rec    as character no-undo.
      409     define input  parameter p-key-handle as handle    no-undo .
      410     define input  parameter p-db-name    as character no-undo .
      411     define input  parameter p-tt-handle  as handle    no-undo .
      412     define input  parameter p-stts-lock  as integer   no-undo .
      413     define output parameter p-tbl-row    as rowid     no-undo.
      414     define output parameter p-tbl-name   as character no-undo.
      415     define variable vHn as handle no-undo.
      416       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      417       p-tbl-row = if vHn:available then vHn:rowid else ?.
      418       p-tbl-name =  vHn:table.
      419       delete object vHn no-error.
      420     if p-tbl-row = ? then do:
      421       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info1, p-tbl-name, p-key-rec ).
      422     end.
      423     else do:
      424       return.
      425     end.
      426   end procedure.
      427   procedure gen-key-fv :
      428     define input  parameter p-key-rec    as character no-undo .
      429     define output parameter p-field-list as character no-undo .
      430     define output parameter p-value-list as character no-undo.
      431     do
      432     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      433     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      434     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      435     :
      436       define variable v-full-tbl-name  as character no-undo .
      437       define variable bh_tbl-name      as handle    no-undo .
      438       define variable v-tbl-name       as character no-undo .
      439       define variable v-field-num      as integer   no-undo .
      440       define variable v-count-fld      as integer   no-undo .
      441       define variable v-inform         as character no-undo .
      442       define variable v-ind            as integer   no-undo .
      443       define variable v-idx-field-qnty as integer   no-undo .
      444       define variable v-delim-key      as character no-undo .
      445       if p-key-rec = ?
      446         or p-key-rec = "":U
      447       then do:
      448         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info1 ).
      449       end.
      450       assign
      451         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      452         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      453       .
      454       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      455       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info1 ).
      456       assign
      457         v-inform = bh_tbl-name:index-information(1)
      458         v-ind    = 2
      459       .
      460       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      461       on error undo, return error
      462       :
      463         assign
      464           v-inform = bh_tbl-name:index-information( v-ind )
      465           v-ind    = v-ind + 1
      466         .
      467       end.
      468       if v-inform = ?
      469         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      470         or entry( 3, v-inform, ",":U ) <> "1":U
      471       then do:
      472         delete object bh_tbl-name no-error.
      473         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info1, v-tbl-name ).
      474       end.
      475       assign
      476         v-idx-field-qnty = num-entries( v-inform ) - 4
      477       .
      478       if v-idx-field-qnty < 2 then do:
      479         delete object bh_tbl-name no-error.
      480         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, v-tbl-name ).
      481       end.
      482       assign
      483         p-field-list = "":U
      484         p-value-list = "":U
      485         v-delim-key  = "":U
      486         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      487         v-count-fld  = 0
      488       .
      489       block_where:
      490       do v-ind = 1 to v-idx-field-qnty by 2
      491       on error undo, return error
      492       :
      493         assign
      494           v-count-fld = v-count-fld + 1
      495         .
      496         if v-count-fld > v-field-num then do:
      497           leave block_where.
      498         end.
      499         assign
      500           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      501           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      502         .
      503         if v-ind = 1 then do:
      504           assign
      505             v-delim-key = chr(3)
      506           .
      507         end.
      508       end.
      509       delete object bh_tbl-name.
      510       if v-count-fld <> v-field-num then do:
      511         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info1, v-tbl-name ).
      512       end.
      513     end.
      514   end procedure.
      515   procedure gen-key-field :
      516     define input  parameter p-table      as character no-undo .
      517     define output parameter p-field-list as character no-undo .
      518     do
      519     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      520     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      521     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      522     :
      523       define variable v-full-tbl-name  as character no-undo .
      524       define variable bh_tbl-name      as handle    no-undo .
      525       define variable v-tbl-name       as character no-undo .
      526       define variable v-field-num      as integer   no-undo .
      527       define variable v-count-fld      as integer   no-undo .
      528       define variable v-inform         as character no-undo .
      529       define variable v-ind            as integer   no-undo .
      530       define variable v-idx-field-qnty as integer   no-undo .
      531       define variable v-delim-key      as character no-undo .
      532       if p-table = ?
      533         or p-table = "":U
      534       then do:
      535         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info1 ).
      536       end.
      537       assign
      538         v-tbl-name      = p-table
      539         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      540       .
      541       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      542       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info1 ).
      543       assign
      544         v-inform = bh_tbl-name:index-information(1)
      545         v-ind    = 2
      546       .
      547       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      548       on error undo, return error
      549       :
      550         assign
      551           v-inform = bh_tbl-name:index-information( v-ind )
      552           v-ind    = v-ind + 1
      553         .
      554       end.
      555       if v-inform = ?
      556         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      557         or entry( 3, v-inform, ",":U ) <> "1":U
      558       then do:
      559         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info1, v-tbl-name ).
      560       end.
      561       assign
      562         v-idx-field-qnty = num-entries( v-inform ) - 4
      563       .
      564       if v-idx-field-qnty < 2 then do:
      565         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, v-tbl-name ).
      566       end.
      567       assign
      568         p-field-list = "":U
      569         v-delim-key  = "":U
      570         v-count-fld  = 0
      571       .
      572       block_where:
      573       do v-ind = 1 to v-idx-field-qnty by 2
      574       on error undo, return error
      575       :
      576         assign
      577           v-count-fld = v-count-fld + 1
      578         .
      579         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      580         if v-ind = 1 then do:
      581           assign
      582             v-delim-key = chr(3)
      583           .
      584         end.
      585       end.
      586       delete object bh_tbl-name.
      587     end.
      588   end procedure.
      589   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      590   FUNCTION get-region RETURNS CHARACTER
      591     ( input parhost-code as integer, input parobj-type as character, input parobj-code as integer ) :
      592     define variable par-region as character no-undo.
      593     if parhost-code = 0 and
      594          parobj-type = "":U and
      595          parobj-code = 0 then do:
      596          par-region = "Глобально".
      597          return par-region.
      598       end.
      599       if parobj-type = 'орг':U then do:
      600          par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(parhost-code).
      601          return par-region.
      602       end.
      603       if parobj-type = 'регион':U
      604       then do:
      605          par-region = fill(chr(32), 2) + "Регион" + chr(32) + string(parobj-code).
      606          return par-region.
      607       end.
      608       par-region = fill(chr(32), 4) + parobj-type + chr(32) + string(parobj-code).
      609       return par-region.
      610   END FUNCTION.
      611   FUNCTION get-objregion RETURNS CHARACTER
      612     (  input parobj-type as character, input parobj-code as integer ) :
      613     define variable par-region as character no-undo.
      614     if  parobj-type = "":U and
      615         parobj-code = 0
      616     then do:
      617        par-region = "Глобально".
      618     end.
      619     else if parobj-type = 'орг':U
      620     then do:
      621        par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(parobj-code).
      622     end.
      623     else if parobj-type = 'регион':U
      624     then do:
      625        par-region = fill(chr(32), 2) + "Регион" + chr(32) + string(parobj-code).
      626     end.
      627     else
      628        par-region = fill(chr(32), 4) + parobj-type + chr(32) + string(parobj-code).
      629     return par-region.
      630   END FUNCTION.
      631   FUNCTION calldscr returns character ( input p-call-id as character):
      632   define variable v-descr as character no-undo .
      633   define variable v-field-list as character no-undo .
      634   define variable v-value-list as character no-undo.
      635   define variable v-prop-label as character no-undo .
      636   define variable v-node-label as character no-undo .
      637   define variable v-dt-code as integer no-undo .
      638   define variable v-host-code as integer no-undo .
      639   define variable v-obj-type as character no-undo .
      640   define variable v-obj-code as integer no-undo .
      641   define variable v-label as character no-undo .
      642   define variable v-node-code as integer no-undo .
      643   define buffer buf_prop-head for ub.prop-head.
      644   define buffer buf_prop-ref for ub.prop-ref.
      645   define buffer buf_prop-map for ub.prop-map.
      646   run gen-key-fv in this-procedure ( input p-call-id
      647                                     ,output v-field-list
      648                                     ,output v-value-list) no-error .
      649   if error-status:error then return p-call-id.
      650   CASE entry(1, p-call-id, chr(3)):
      651     when 'dis-card-type':U then do:
      652       v-descr = substitute("Тип ДК: эмитент &1 тип: &2"
      653                            ,integer(entry(lookup("emitent-host-code", v-field-list, chr(3)), v-value-list, chr(3)) )
      654                            ,entry(lookup("type", v-field-list, chr(3)), v-value-list, chr(3))
      655                            ).
      656     end.
      657     when 'dis-card':U then do:
      658       v-descr = substitute("ДК: № &1"
      659                            ,entry(lookup("d-card", v-field-list, chr(3)), v-value-list, chr(3))
      660                            ).
      661     end.
      662     when 'dis-card-property':U then do:
      663       v-dt-code = integer(entry(lookup("dt-code", v-field-list, chr(3)), v-value-list, chr(3)) ).
      664       v-node-code = integer(entry(lookup("node-code", v-field-list, chr(3)), v-value-list, chr(3)) ).
      665       v-host-code = integer(entry(lookup("host-code", v-field-list, chr(3)), v-value-list, chr(3)) ).
      666       v-obj-type = entry(lookup("obj-type", v-field-list, chr(3)), v-value-list, chr(3)) .
      667       v-obj-code = integer(entry(lookup("obj-code", v-field-list, chr(3)), v-value-list, chr(3)) ).
      668       find first buf_prop-ref no-lock where
      669                 buf_prop-ref.dt-code = v-dt-code no-error .
      670       if available buf_prop-ref then do:
      671         find first buf_prop-head no-lock where
      672                   buf_prop-head.dtm-code = buf_prop-ref.dtm-code no-error .
      673         v-prop-label = buf_prop-head.prop-label.
      674         find first buf_prop-map no-lock where
      675                   buf_prop-map.dtm-code = buf_prop-ref.dtm-code
      676               and buf_prop-map.node-code = v-node-code no-error .
      677         if available buf_prop-map then do:
      678           v-label = buf_prop-map.node-label.
      679         end.
      680       end.
      681       v-descr = substitute("ДК: № &1 &2:&3 &4"
      682                            ,entry(lookup("d-card", v-field-list, chr(3)), v-value-list, chr(3))
      683                            ,v-prop-label
      684                            ,v-label
      685                            ,get-region(v-host-code, v-obj-type, v-obj-code)
      686                            ).
      687     end.
      688     when 'clients':U then do:
      689       v-descr = substitute("&1&2"
      690                            ,entry(lookup("obj-type", v-field-list, chr(3)), v-value-list, chr(3))
      691                            ,integer(entry(lookup("obj-code", v-field-list, chr(3)), v-value-list, chr(3)) )
      692                            ).
      693     end.
      694     when 'ext-system':U then do:
      695       v-descr = substitute("Внешняя система &1"
      696                            ,integer(entry(lookup("esys-id", v-field-list, chr(3)), v-value-list, chr(3)))
      697                            ).
      698     end.
      699     WHEN 'thbj-attr':U then do:
      700       if entry(lookup("upper-prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'rum':U
      701       or entry(lookup("upper-prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'rum_obj':U
      702       then do:
      703         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'goods':U then do:
      704           v-descr = "Операции с товарами".
      705         end.
      706         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'clients':U then do:
      707           v-descr = "Операции с клиентами".
      708         end.
      709         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'gds-grp':U then do:
      710           v-descr = "Операции с группами товаров".
      711         end.
      712         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'cli-grp':U then do:
      713           v-descr = "Операции с группами клиентов".
      714         end.
      715         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'chk-doc_ibs-th':U then do:
      716           v-descr = "Операции с чеками на POS IBS-TH".
      717         end.
      718         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'chk-doc_ibs-th-mob':U then do:
      719           v-descr = "Операции с чеками на POS IBS-TH-MOB".
      720         end.
      721         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'edoc':U then do:
      722           v-descr = "Операции в системе электронного документооборота".
      723         end.
      724         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'thref':U then do:
      725           v-descr = "Операции со справочниками".
      726         end.
      727         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'pdf':U then do:
      728           v-descr = "Операции с ДНЦ и переоценками".
      729         end.
      730         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'rep':U then do:
      731           v-descr = "Отчеты".
      732         end.
      733         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'ord':U then do:
      734           v-descr = "Операции с заказами".
      735         end.
      736       end.
      737     end.
      738     when 'cash-desk':U then do:
      739       v-descr = substitute("БД &1 Маг &2 Касса № &4 &3"
      740                            ,entry(lookup("db-num", v-field-list, chr(3)), v-value-list, chr(3))
      741                            ,entry(lookup("obj-code", v-field-list, chr(3)), v-value-list, chr(3))
      742                            ,entry(lookup("cash-num", v-field-list, chr(3)), v-value-list, chr(3))
      743                            ,entry(lookup("pos-type", v-field-list, chr(3)), v-value-list, chr(3))
      744                            ).
      745     end.
      746     when 'ext-file':U then do:
      747       v-descr = substitute("БД &1 Файл № &3 (из БД &2)"
      748                            ,entry(lookup("db-num", v-field-list, chr(3)), v-value-list, chr(3))
      749                            ,entry(lookup("from-db-num", v-field-list, chr(3)), v-value-list, chr(3))
      750                            ,entry(lookup("file-num", v-field-list, chr(3)), v-value-list, chr(3))
      751                            ).
      752     end.
      753   end case.
      754   return v-descr.
      755   end function.
      756   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      757   def var vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      758   define temp-table temp-drt-prop no-undo like ub.drt-prop.
      759   procedure disrules-fill-properties:
      760   define input  parameter p-templ-rl-root as integer   no-undo .
      761   define buffer buf_drt-prop for ub.drt-prop.
      762   define buffer buf_temp-drt-prop for temp-drt-prop.
      763   do
      764   on error undo, return error return-value
      765   :
      766     for each buf_temp-drt-prop:
      767       delete buf_temp-drt-prop.
      768     end.
      769     for each buf_drt-prop where buf_drt-prop.templ-rl-root = p-templ-rl-root:
      770       create buf_temp-drt-prop.
      771       buffer-copy buf_drt-prop to buf_temp-drt-prop.
      772     end.
      773   end.
      774   end procedure.
      775   ~
      776   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      777   procedure discfgru-check :
      778   define input parameter p-table-name as character no-undo .
      779   define input parameter p-templ-rl-root as integer no-undo .
      780   define input parameter p-time-templ-rl-root as integer no-undo .
      781   define input parameter p-pos-type as character no-undo .
      782   define output parameter p-disnct-role as character no-undo .
      783   define buffer buf_dis-cfg-rule for ub.dis-cfg-rule.
      784     do
      785     on error undo, return error return-value
      786     :
      787       find first buf_dis-cfg-rule no-lock where
      788               buf_dis-cfg-rule.table-name = p-table-name
      789           and buf_dis-cfg-rule.templ-rl-root = p-templ-rl-root
      790           and (p-time-templ-rl-root = ? or  buf_dis-cfg-rule.time-templ-rl-root = p-time-templ-rl-root)
      791           and buf_dis-cfg-rule.pos-type = p-pos-type no-error.
      792       if not available buf_dis-cfg-rule
      793       or p-pos-type = "":U
      794       then do:
      795          return error substitute("Для места использования типа &1 не определен тип скидки с шаблоном &2 &3"
      796                                  ,entry (lookup (p-pos-type, 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,r-keeper,InfoKiosk,pricecheck-Servis+,Emulator-NKT-IBM,MARIA,-,bo,Autotank':U), 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,R-KEEPER,InfoKiosk,Прайс-чекер Servis+,Emulator-NKT-IBM,MARIA,Накладная,Бэкофис,Autotank':U)
      797                                  , p-templ-rl-root
      798                                  , (if p-time-templ-rl-root = ?
      799                                     then '':U
      800                                     else substitute("с расписанием типа &1", p-time-templ-rl-root)
      801                                     )
      802                                  ).
      803       end.
      804       assign
      805       p-disnct-role = buf_dis-cfg-rule.discnt-role
      806       .
      807     end.
      808   end procedure.
      809   procedure disdctru-name :
      810   define buffer buf_dis-rule for ub.dis-rule.
      811   do
      812     on error undo, return error
      813     :
      814     define input  parameter p-templ-rl-root  as integer no-undo .
      815     define output parameter p-label          as character no-undo .
      816     find first buf_dis-rule no-lock where
      817               buf_dis-rule.rule-num = p-templ-rl-root no-error.
      818     if available buf_dis-rule then do:
      819       p-label = buf_dis-rule.des.
      820     end.
      821     else do:
      822       p-label = substitute("Неизвестный тип правила скидки &1", p-templ-rl-root).
      823     end.
      824   end.
      825   end procedure.
      826   function disdctru-get-disc-label returns character ( input p-templ-rl-root as integer):
      827   define variable v-rule-label as character no-undo .
      828   run disdctru-name in this-procedure ( input p-templ-rl-root
      829                                        ,output v-rule-label) no-error.
      830   return v-rule-label.
      831   end function.
      832   function disdctru-get-disc-role-label returns character ( input p-discnt-role as character):
      833   define variable v-rule-label as character no-undo .
      834   return entry (lookup (p-discnt-role, 'calc-d-pcnt,calc-cash-d-pcnt,calc-categ,dis-tot-flag,def-categ,def-pcnt,def-cash-pcnt':u) + 1, ',' + 'Расчет %скидки ДК на товар,Расчет %скидки ДК на итог,Расчет категории ДК,Участие в итогах по ДК,Категория ДК по умолчанию,% скидки ДК на товар по умолч.,% скидки ДК на итог по умолч.':u).
      835   end function.
      836   procedure disdctru-write :
      837     do
      838     on error undo, return error
      839     :
      840       define input parameter p-type           like ub.dis-dct-rule.type       no-undo .
      841       define input parameter p-emitent-host-code      like ub.dis-dct-rule.emitent-host-code  no-undo .
      842       define input parameter p-host-code      like ub.dis-dct-rule.host-code  no-undo .
      843       define input parameter p-obj-type       like ub.dis-dct-rule.obj-type   no-undo .
      844       define input parameter p-obj-code       like ub.dis-dct-rule.obj-code   no-undo .
      845       define input parameter p-pos-type       like ub.dis-dct-rule.pos-type   no-undo .
      846       define input parameter p-discnt-role    like ub.dis-dct-rule.discnt-role no-undo .
      847       define input parameter p-templ-rl-root  like ub.dis-dct-rule.templ-rl-root  no-undo .
      848       define input parameter p-time-templ-rl-root  like ub.dis-dct-rule.time-templ-rl-root  no-undo .
      849       define input parameter p-rule-num       like ub.dis-dct-rule.rule-num    no-undo .
      850       define input parameter p-NONUNIQUE as character no-undo .
      851       define buffer buf_dis-dct-rule for ub.dis-dct-rule .
      852       define buffer lock_dis-dct-rule for ub.dis-dct-rule .
      853       define buffer buf_dis-rule for ub.dis-rule.
      854       define variable v-label          as character no-undo .
      855       define variable v-discnt-role as character no-undo .
      856       run discfgru-check in this-procedure (
      857                                             input 'dis-dct-rule':U
      858                                            ,input p-templ-rl-root
      859                                            ,input p-time-templ-rl-root
      860                                            ,input p-pos-type
      861                                            ,output v-discnt-role
      862                                             ) no-error .
      863       if error-status :error then do:
      864         undo, return error return-value .
      865       end.
      866       if p-discnt-role = ? then do:
      867         p-discnt-role = v-discnt-role.
      868       end.
      869       if p-discnt-role <> v-discnt-role then do:
      870         undo, return error substitute("Тип ДК &1 код валюты &2 фирма &3 &4 место использ. &5 скидка типа &6&7не может быть по шаблону &8 и расписанию &9"
      871                                 ,p-type
      872                                 ,p-emitent-host-code
      873                                 ,p-host-code
      874                                 ,p-obj-type + string(p-obj-code)
      875                                 ,p-pos-type
      876                                 ,entry (lookup (p-discnt-role, 'calc-d-pcnt,calc-cash-d-pcnt,calc-categ,dis-tot-flag,def-categ,def-pcnt,def-cash-pcnt':u) + 1, ',' + 'Расчет %скидки ДК на товар,Расчет %скидки ДК на итог,Расчет категории ДК,Участие в итогах по ДК,Категория ДК по умолчанию,% скидки ДК на товар по умолч.,% скидки ДК на итог по умолч.':u)
      877                                 ,chr(10)
      878                                 ,p-templ-rl-root
      879                                 ,p-rule-num).
      880       end.
      881       if p-pos-type = ? then do:
      882   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      883   define variable v-param-type6 as character no-undo .
      884   define variable v-value-date6 as date no-undo .
      885   define variable v-value-decimal6 as decimal no-undo .
      886   define variable v-value-integer6 as INTEGER no-undo .
      887   define variable v-value-logical6 AS LOGICAL no-undo .
      888   define variable v-tth6 as handle no-undo .
      889   run adm/shattri.p (
      890       input "get":U
      891       ,input  p-obj-type
      892       ,input  p-obj-code
      893       ,input  'cd-sending':U
      894       ,input  'dflt-cd':U
      895       ,output p-pos-type
      896       ,output v-value-date6
      897       ,output v-value-decimal6
      898       ,output v-value-integer6
      899       ,output v-value-logical6
      900       ,output v-param-type6
      901       ,INPUT-OUTPUT table-handle v-tth6
      902       )  .
      903   delete object v-tth6 no-error.
      904       end.
      905       find first buf_dis-rule no-lock where
      906                 buf_dis-rule.rule-num = p-rule-num no-error.
      907       if not available buf_Dis-rule then do:
      908         undo, return error substitute("Тип ДК &1 код валюты &2 фирма &3 &4 место использ. &5 скидка типа &6&7не найдено правило скидки &9"
      909                                 ,p-type
      910                                 ,p-emitent-host-code
      911                                 ,p-host-code
      912                                 ,p-obj-type + string(p-obj-code)
      913                                 ,p-pos-type
      914                                 ,entry (lookup (p-discnt-role, 'calc-d-pcnt,calc-cash-d-pcnt,calc-categ,dis-tot-flag,def-categ,def-pcnt,def-cash-pcnt':u) + 1, ',' + 'Расчет %скидки ДК на товар,Расчет %скидки ДК на итог,Расчет категории ДК,Участие в итогах по ДК,Категория ДК по умолчанию,% скидки ДК на товар по умолч.,% скидки ДК на итог по умолч.':u)
      915                                 ,chr(10)
      916                                 ,p-templ-rl-root
      917                                 ,p-rule-num).
      918       end.
      919       if buf_dis-rule.root <> yes then do:
      920         undo, return error substitute("Тип ДК &1 код валюты &2 фирма &3 &4 место использ. &5 скидка типа &6&7правило скидки &9 - некорневое"
      921                                 ,p-type
      922                                 ,p-emitent-host-code
      923                                 ,p-host-code
      924                                 ,p-obj-type + string(p-obj-code)
      925                                 ,p-pos-type
      926                                 ,entry (lookup (p-discnt-role, 'calc-d-pcnt,calc-cash-d-pcnt,calc-categ,dis-tot-flag,def-categ,def-pcnt,def-cash-pcnt':u) + 1, ',' + 'Расчет %скидки ДК на товар,Расчет %скидки ДК на итог,Расчет категории ДК,Участие в итогах по ДК,Категория ДК по умолчанию,% скидки ДК на товар по умолч.,% скидки ДК на итог по умолч.':u)
      927                                 ,chr(10)
      928                                 ,p-templ-rl-root
      929                                 ,p-rule-num).
      930       end.
      931       find first buf_dis-dct-rule exclusive-lock where
      932                  buf_dis-dct-rule.type  = p-type
      933              AND buf_dis-dct-rule.emitent-host-code = p-emitent-host-code
      934              AND buf_dis-dct-rule.obj-type  = p-obj-type
      935              AND buf_dis-dct-rule.host-code = p-host-code
      936              AND buf_dis-dct-rule.obj-code  = p-obj-code
      937              AND buf_dis-dct-rule.pos-type  = p-pos-type
      938              AND buf_dis-dct-rule.discnt-role = p-discnt-role  no-error .
      939       if not available buf_dis-dct-rule then do:
      940         create buf_dis-dct-rule .
      941         assign
      942         buf_dis-dct-rule.type  = p-type
      943         buf_dis-dct-rule.emitent-host-code  = p-emitent-host-code
      944         buf_dis-dct-rule.host-code  = p-host-code
      945         buf_dis-dct-rule.obj-type  = p-obj-type
      946         buf_dis-dct-rule.obj-code  = p-obj-code
      947         buf_dis-dct-rule.pos-type = p-pos-type
      948         buf_dis-dct-rule.discnt-role = v-discnt-role
      949         buf_dis-dct-rule.rule-num = p-rule-num no-error
      950         .
      951       end.
      952       ELSE
      953       ASSIGN
      954       buf_dis-dct-rule.rule-num = p-rule-num
      955       buf_dis-dct-rule.rl-root = buf_Dis-rule.rl-root
      956       buf_dis-dct-rule.time-templ-rl-root = p-time-templ-rl-root
      957       buf_dis-dct-rule.templ-rl-root = p-templ-rl-root
      958       buf_dis-dct-rule.nonunique = p-nonunique
      959       no-error.
      960     end.
      961   end procedure.
      962   procedure disdctru-delete :
      963   define input parameter p-cdpay-code     like ub.dis-dct-rule.emitent-host-code no-undo .
      964   define input parameter p-curr-code      like ub.dis-dct-rule.type no-undo .
      965   define input parameter p-host-code      like ub.dis-dct-rule.host-code   no-undo .
      966   define input parameter p-obj-type       like ub.dis-dct-rule.obj-type   no-undo .
      967   define input parameter p-obj-code       like ub.dis-dct-rule.obj-code   no-undo .
      968   define input parameter p-pos-type       like ub.dis-dct-rule.pos-type   no-undo .
      969   define input parameter p-discnt-role    like ub.dis-dct-rule.discnt-role no-undo .
      970   define input parameter p-nonunique      like ub.dis-dct-rule.nonunique   no-undo .
      971   define output parameter p-deleted       as logical no-undo .
      972   define variable v-rule-label as character no-undo .
      973   define buffer buf_dis-dct-rule for ub.dis-dct-rule.
      974   do
      975   on error undo, return error
      976   :
      977   find first buf_dis-dct-rule exclusive-lock where
      978               buf_dis-dct-rule.emitent-host-code  = p-host-code
      979           AND buf_dis-dct-rule.type  = p-type
      980           AND buf_dis-dct-rule.obj-type  = p-obj-type
      981           AND buf_dis-dct-rule.host-code = p-host-code
      982           AND buf_dis-dct-rule.obj-code  = p-obj-code
      983           AND buf_dis-dct-rule.pos-type  = p-pos-type
      984           AND buf_dis-dct-rule.discnt-role = p-discnt-role
      985           and buf_dis-dct-rule.nonunique = p-nonunique
      986           no-error .
      987   if not available buf_dis-dct-rule then do:
      988     return '':U.
      989   end.
      990   delete buf_dis-dct-rule no-error.
      991   if error-status:error then do:
      992     run disdctru-name in this-procedure
      993       (input  buf_dis-dct-rule.templ-rl-root
      994       ,output v-rule-label
      995       ) no-error .
      996     undo, return error substitute("Ошибка при удалении скидки по типу ДК:&1" +
      997                                  "скидка &2 (POS &3) на фирме &4 &5&6 для платежа&1&7&1&8"
      998                                   ,chr(10)
      999                                   ,v-rule-label
     1000                                   ,p-pos-type
     1001                                   ,p-host-code
     1002                                   ,p-obj-type
     1003                                   ,p-obj-code
     1004                                   ,error-status:get-message(1)
     1005                                   ,return-value ).
     1006   end.
     1007   p-deleted = yes.
     1008   return '':U.
     1009   end.
     1010   end procedure.
     1011   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1012   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1013   procedure cur-time :
     1014      define output parameter p-today as date      no-undo .
     1015      define output parameter p-time  as integer   no-undo .
     1016     do
     1017     on error undo, return error
     1018     :
     1019       define variable v-date1 as date      no-undo .
     1020       define variable v-date2 as date      no-undo .
     1021       define variable v-time  as integer   no-undo .
     1022       assign
     1023         v-date1 = today
     1024         v-time  = time
     1025         v-date2 = today
     1026       .
     1027       if v-date1 <> v-date2
     1028       then do:
     1029         assign
     1030           v-date1 = today
     1031           v-time  = v-time
     1032         .
     1033       end.
     1034       assign
     1035         p-today = v-date1
     1036         p-time  = v-time
     1037       .
     1038     end.
     1039   end.
     1040   function cur-time-date returns character
     1041   :
     1042     return string(today, '99/99/9999':U) .
     1043   end.
     1044   function cur-time-mjd returns decimal
     1045   :
     1046     define variable v-date as date      no-undo .
     1047     define variable v-time as integer   no-undo .
     1048     run cur-time in this-procedure
     1049       (output v-date
     1050       ,output v-time
     1051       ) .
     1052     return integer(v-date) - 2400002 + (v-time / 86400) .
     1053   end.
     1054   function cur-time-get-ending-index returns integer
     1055   (input p-number as integer
     1056   )
     1057   :
     1058     if p-number < 0
     1059     or p-number = ?
     1060     then do:
     1061       return 1 .
     1062     end.
     1063     define variable v-rest as integer   no-undo .
     1064     assign
     1065       p-number = p-number modulo 100
     1066     .
     1067     if p-number < 20
     1068     then do:
     1069       assign
     1070         v-rest = p-number
     1071       .
     1072     end.
     1073     else do:
     1074       assign
     1075         v-rest = p-number modulo 10
     1076       .
     1077     end.
     1078     case v-rest :
     1079       when 1
     1080       then do:
     1081         return 2 .
     1082       end.
     1083       when 2 or
     1084       when 3 or
     1085       when 4
     1086       then do:
     1087         return 3 .
     1088       end.
     1089       otherwise do:
     1090         return 1 .
     1091       end.
     1092     end case .
     1093   end.
     1094   procedure cur-time-mjd-to-date :
     1095      define input  parameter i-mjd-diff as decimal no-undo.
     1096      define output parameter o-Date     as date    no-undo.
     1097      define output parameter o-Time     as integer no-undo.
     1098      define variable v-day-number as integer   no-undo .
     1099      if    i-mjd-diff < 0
     1100         or i-mjd-diff = ?
     1101      then do:
     1102         return "?" .
     1103      end.
     1104      assign
     1105         v-day-number = truncate(i-mjd-diff,0).
     1106         o-Date = date(v-day-number + 2400002).
     1107         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
     1108     .
     1109   end.
     1110   function cur-time-mjd-to-string returns character
     1111   (input p-mjd-diff as decimal
     1112   )
     1113   :
     1114     define variable v-day-number as integer   no-undo .
     1115     define variable v-seconds    as integer   no-undo .
     1116     define variable v-hour       as integer   no-undo .
     1117     define variable v-min        as integer   no-undo .
     1118     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
     1119     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
     1120     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
     1121     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
     1122     if p-mjd-diff < 0
     1123     or p-mjd-diff = ?
     1124     then do:
     1125       return "?" .
     1126     end.
     1127     assign
     1128       v-day-number = integer(truncate(p-mjd-diff,0))
     1129       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     1130     .
     1131     if v-seconds > 86400
     1132     then do:
     1133       assign
     1134         v-seconds = 86400 - 1
     1135       .
     1136     end.
     1137     if v-seconds < 0
     1138     then do:
     1139       assign
     1140         v-seconds = 0
     1141       .
     1142     end.
     1143     assign
     1144       v-hour = truncate(v-seconds / 3600, 0)
     1145     .
     1146     assign
     1147       v-seconds = v-seconds modulo 3600
     1148     .
     1149     assign
     1150       v-min = truncate(v-seconds / 60, 0)
     1151     .
     1152     assign
     1153       v-seconds = v-seconds modulo 60
     1154     .
     1155     return
     1156         (if v-day-number <> 0
     1157           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     1158           else ""
     1159         )
     1160       + (if v-day-number <> 0 or v-hour <> 0
     1161           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     1162           else ""
     1163         )
     1164       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     1165           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     1166           else ""
     1167         )
     1168       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     1169       .
     1170   end.
     1171   function cur-time-string returns character
     1172   :
     1173     define variable v-date as date      no-undo .
     1174     define variable v-time as integer   no-undo .
     1175     run cur-time in this-procedure
     1176       (output v-date
     1177       ,output v-time
     1178       ) .
     1179     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     1180   end.
     1181   function cur-time-string-sec returns character
     1182   :
     1183     define variable v-date as date      no-undo .
     1184     define variable v-time as integer   no-undo .
     1185     run cur-time in this-procedure
     1186       (output v-date
     1187       ,output v-time
     1188       ) .
     1189     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     1190   end.
     1191   function cur-time-custom  returns character
     1192   (input p-prefix as character
     1193   ,input p-date-format as character
     1194   ,input p-delimiter as character
     1195   ,input p-time-format as character
     1196   ,input p-suffix as character
     1197   )
     1198   :
     1199     define variable v-date as date      no-undo .
     1200     define variable v-time as integer   no-undo .
     1201     run cur-time in this-procedure
     1202       (output v-date
     1203       ,output v-time
     1204       ) .
     1205     return
     1206       p-prefix
     1207       + string(v-date, p-date-format)
     1208       + p-delimiter
     1209       + string(v-time, p-time-format)
     1210       + p-suffix
     1211       .
     1212   end.
     1213   function cur-time-print  returns character
     1214   :
     1215     define variable v-date as date      no-undo .
     1216     define variable v-time as integer   no-undo .
     1217     run cur-time in this-procedure
     1218       (output v-date
     1219       ,output v-time
     1220       ) .
     1221     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     1222   end.
     1223   function cur-time-datetime returns datetime
     1224   :
     1225     define variable v-char as character no-undo .
     1226     define variable v-datetime as datetime no-undo .
     1227     v-char = cur-time-string().
     1228     v-datetime = datetime(v-char).
     1229     return  v-datetime.
     1230   end.
     1231   function cur-time-string-msec returns character
     1232   :
     1233     define variable v-date as datetime  no-undo .
     1234     v-date = now.
     1235     return string(v-date) .
     1236   end.
     1237   procedure dct-attr-code :
     1238     do
     1239     on error undo, return error return-value
     1240     :
     1241       define input  parameter p-code           as character no-undo .
     1242       define output parameter p-type           as character no-undo .
     1243       define output parameter p-format         as character no-undo .
     1244       define output parameter p-label          as character no-undo .
     1245       define output parameter p-range          as integer   no-undo .
     1246       define output parameter p-user-can-edit  as logical   no-undo .
     1247       define output parameter p-output-display as logical   no-undo .
     1248       define output parameter p-other          as character no-undo .
     1249       if index(p-code, chr(4)) > 0 then do:
     1250         p-code = entry(1, p-code, chr(4)).
     1251       end.
     1252       case p-code :
     1253         otherwise do:
     1254           undo, return error substitute("неизвестный атрибут типа дисконтной карты &1", p-code ).
     1255         end.
     1256       end.
     1257     end.
     1258   end procedure.
     1259   procedure dct-attr-tooltip :
     1260     do
     1261     on error undo, return error return-value
     1262     :
     1263       define input  parameter p-code    as character no-undo .
     1264       define output parameter p-tooltip as character no-undo .
     1265       define output parameter p-label   as character no-undo .
     1266       if index(p-code, chr(4)) > 0 then do:
     1267         p-code = entry(1, p-code, chr(4)).
     1268       end.
     1269       case p-code :
     1270         otherwise do:
     1271           undo, return error substitute("неизвестный атрибут типа дисконтной карты &1",  p-code ).
     1272         end.
     1273       end.
     1274     end.
     1275   end procedure.
     1276   procedure dct-attr-value :
     1277     do
     1278     on error undo, return error return-value
     1279     :
     1280       define input parameter p-emitent-host-code  like ub.dis-card-type.emitent-host-code no-undo .
     1281       define input parameter p-type-card               like ub.dis-card-type.type no-undo .
     1282       define input  parameter p-host-code like ub.dis-card-type-attr.host-code  no-undo .
     1283       define input  parameter p-obj-type  like ub.dis-card-type-attr.obj-type   no-undo .
     1284       define input  parameter p-obj-code  like ub.dis-card-type-attr.obj-code   no-undo .
     1285       define input  parameter p-code      like ub.dis-card-type-attr.attr-code  no-undo .
     1286       define output parameter p-value     like ub.dis-card-type-attr.attr-value no-undo .
     1287       define output parameter p-type      as character no-undo .
     1288       define buffer buf_dis-card-type-attr for ub.dis-card-type-attr .
     1289       define variable v-format         as character no-undo .
     1290       define variable v-label          as character no-undo .
     1291       define variable v-user-can-edit  as logical   no-undo .
     1292       define variable v-output-display as logical   no-undo .
     1293       define variable v-other          as character no-undo .
     1294       define variable v-range          as integer   no-undo .
     1295       run dct-attr-code in this-procedure
     1296         (input  p-code
     1297         ,output p-type
     1298         ,output v-format
     1299         ,output v-label
     1300         ,output v-range
     1301         ,output v-user-can-edit
     1302         ,output v-output-display
     1303         ,output v-other
     1304         ) no-error .
     1305       if error-status :error then do:
     1306         undo, return error return-value .
     1307       end.
     1308       if v-range <= 4 then do:
     1309         CASE v-range:
     1310           when 1 then do:
     1311             assign
     1312             p-host-code = 0
     1313             p-obj-type = "":U
     1314             p-obj-code = 0
     1315             .
     1316           end.
     1317           when 2 then do:
     1318             assign
     1319             p-obj-type = "":U
     1320             p-obj-code = 0
     1321             .
     1322           end.
     1323           when 4 then do:
     1324           end.
     1325         END CASE.
     1326       end.
     1327       find first buf_dis-card-type-attr no-lock
     1328         where
     1329               buf_dis-card-type-attr.emitent-host-code   = p-emitent-host-code
     1330           and buf_dis-card-type-attr.type                = p-type-card
     1331           and buf_dis-card-type-attr.host-code = p-host-code
     1332           and buf_dis-card-type-attr.obj-type  = p-obj-type
     1333           and buf_dis-card-type-attr.obj-code  = p-obj-code
     1334           and buf_dis-card-type-attr.attr-code = p-code
     1335         no-error .
     1336       if avail buf_dis-card-type-attr then do:
     1337         assign
     1338           p-value =  buf_dis-card-type-attr.attr-value
     1339         .
     1340       end.
     1341       else do:
     1342         assign
     1343           p-value = if p-type = 'L':U then "no":U else ""
     1344         .
     1345       end.
     1346     end.
     1347   end procedure.
     1348   procedure dct-attr-write :
     1349     do
     1350     on error undo, return error return-value
     1351     :
     1352       define input parameter p-emitent-host-code  like ub.dis-card-type.emitent-host-code no-undo .
     1353       define input parameter p-type               like ub.dis-card-type.type no-undo .
     1354       define input parameter p-host-code like ub.dis-card-type-attr.host-code  no-undo .
     1355       define input parameter p-obj-type  like ub.dis-card-type-attr.obj-type   no-undo .
     1356       define input parameter p-obj-code  like ub.dis-card-type-attr.obj-code   no-undo .
     1357       define input parameter p-code      like ub.dis-card-type-attr.attr-code  no-undo .
     1358       define input parameter p-value     like ub.dis-card-type-attr.attr-value no-undo .
     1359       define input parameter p-cmd-proc-handle as handle no-undo .
     1360       define input parameter p-cmd-code as integer no-undo .
     1361       define buffer buf_dis-card-type-attr for ub.dis-card-type-attr .
     1362       define buffer buf_dis-card-type for ub.dis-card-type.
     1363       define variable v-type           as character no-undo .
     1364       define variable v-format         as character no-undo .
     1365       define variable v-label          as character no-undo .
     1366       define variable v-range          as integer no-undo .
     1367       define variable v-user-can-edit  as logical   no-undo .
     1368       define variable v-output-display as logical   no-undo .
     1369       define variable v-other          as character no-undo .
     1370       define variable v-send           as logical   no-undo .
     1371       run dct-attr-code in this-procedure
     1372         (input  p-code
     1373         ,output v-type
     1374         ,output v-format
     1375         ,output v-label
     1376         ,output v-range
     1377         ,output v-user-can-edit
     1378         ,output v-output-display
     1379         ,output v-other
     1380         ) no-error .
     1381       if error-status :error then do:
     1382         undo, return error return-value .
     1383       end.
     1384       find first buf_dis-card-type-attr exclusive-lock
     1385         where
     1386               buf_dis-card-type-attr.emitent-host-code   = p-emitent-host-code
     1387           and buf_dis-card-type-attr.type                = p-type
     1388           and buf_dis-card-type-attr.host-code = p-host-code
     1389           and buf_dis-card-type-attr.obj-type  = p-obj-type
     1390           and buf_dis-card-type-attr.obj-code  = p-obj-code
     1391           and buf_dis-card-type-attr.attr-code = p-code
     1392         no-error .
     1393       if not available buf_dis-card-type-attr then do:
     1394         find first buf_dis-card-type no-lock where
     1395               buf_dis-card-type.emitent-host-code   = p-emitent-host-code
     1396           and buf_dis-card-type.type                = p-type
     1397                    .
     1398         create buf_dis-card-type-attr .
     1399         assign
     1400           buf_dis-card-type-attr.emitent-host-code = p-emitent-host-code
     1401           buf_dis-card-type-attr.type = p-type
     1402           buf_dis-card-type-attr.host-code = p-host-code
     1403           buf_dis-card-type-attr.emitent-host-code = p-emitent-host-code
     1404           buf_dis-card-type-attr.obj-type  = p-obj-type
     1405           buf_dis-card-type-attr.obj-code  = p-obj-code
     1406           buf_dis-card-type-attr.attr-code = p-code
     1407         .
     1408         assign
     1409         v-send = yes.
     1410       end.
     1411       else do:
     1412         if p-value <> buf_Dis-card-type-attr.attr-value then do:
     1413           v-send = yes.
     1414         end.
     1415       end.
     1416       assign
     1417         buf_dis-card-type-attr.attr-value = p-value
     1418       .
     1419       if v-send
     1420       and valid-handle(p-cmd-proc-handle) then do:
     1421         run add-dump in p-cmd-proc-handle
     1422           (input p-cmd-code
     1423           ,input 'dis-card-type-attr':U
     1424           ,input '+update'
     1425           ,input buffer buf_dis-card-type-attr:handle
     1426           ,input '':U
     1427           ) no-error .
     1428         if error-status:error then do:
     1429             undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1)).
     1430         end.
     1431       end.
     1432     end.
     1433   end procedure.
     1434   procedure dct-attr-exist :
     1435     do
     1436     on error undo, return error return-value
     1437     :
     1438       define input parameter p-emitent-host-code  like ub.dis-card-type.emitent-host-code no-undo .
     1439       define input parameter p-type               like ub.dis-card-type.type no-undo .
     1440       define input parameter p-host-code like ub.dis-card-type-attr.host-code  no-undo .
     1441       define input parameter p-obj-type  like ub.dis-card-type-attr.obj-type   no-undo .
     1442       define input parameter p-obj-code  like ub.dis-card-type-attr.obj-code   no-undo .
     1443       define input parameter p-code      like ub.dis-card-type-attr.attr-code  no-undo .
     1444       define output parameter p-exist    as logical  no-undo .
     1445       define buffer buf_dis-card-type-attr for ub.dis-card-type-attr .
     1446       define variable v-type           as character no-undo .
     1447       define variable v-format         as character no-undo .
     1448       define variable v-label          as character no-undo .
     1449       define variable V-RANGE          as integer   no-undo .
     1450       define variable v-user-can-edit  as logical   no-undo .
     1451       define variable v-output-display as logical   no-undo .
     1452       define variable v-other          as character no-undo .
     1453       run dct-attr-code in this-procedure
     1454         (input  p-code
     1455         ,output v-type
     1456         ,output v-format
     1457         ,output v-label
     1458         ,OUTPUT V-RANGE
     1459         ,output v-user-can-edit
     1460         ,output v-output-display
     1461         ,output v-other
     1462         ) no-error .
     1463       if error-status :error then do:
     1464         undo, return error return-value .
     1465       end.
     1466       find first buf_dis-card-type-attr no-lock
     1467         where
     1468               buf_dis-card-type-attr.emitent-host-code   = p-emitent-host-code
     1469           and buf_dis-card-type-attr.type                = p-type
     1470          and buf_dis-card-type-attr.host-code = p-host-code
     1471           and buf_dis-card-type-attr.obj-type  = p-obj-type
     1472           and buf_dis-card-type-attr.obj-code  = p-obj-code
     1473           and buf_dis-card-type-attr.attr-code = p-code
     1474         no-error .
     1475       if  available buf_dis-card-type-attr then do:
     1476         p-exist = yes.
     1477       end.
     1478     end.
     1479   end procedure.
     1480   procedure dct-attr-delete :
     1481     do
     1482     on error undo, return error return-value
     1483     :
     1484       define input parameter p-emitent-host-code  like ub.dis-card-type.emitent-host-code no-undo .
     1485       define input parameter p-type               like ub.dis-card-type.type no-undo .
     1486       define input parameter p-host-code like ub.dis-card-type-attr.host-code  no-undo .
     1487       define input parameter p-obj-type like ub.dis-card-type-attr.obj-type   no-undo .
     1488       define input parameter p-obj-code like ub.dis-card-type-attr.obj-code   no-undo .
     1489       define input parameter p-code     like ub.dis-card-type-attr.attr-code  no-undo .
     1490       define input parameter p-cmd-proc-handle as handle no-undo .
     1491       define input parameter p-cmd-code as integer no-undo .
     1492       define output parameter p-deleted  as logical no-undo.
     1493       define buffer buf_dis-card-type-attr for ub.dis-card-type-attr .
     1494       define variable v-type           as character no-undo .
     1495       define variable v-format         as character no-undo .
     1496       define variable v-label          as character no-undo .
     1497       define variable v-range          as integer   no-undo .
     1498       define variable v-user-can-edit  as logical   no-undo .
     1499       define variable v-output-display as logical   no-undo .
     1500       define variable v-other          as character no-undo .
     1501       define variable v-rec-ord_        as integer no-undo .
     1502       run dct-attr-code in this-procedure
     1503         (input  p-code
     1504         ,output v-type
     1505         ,output v-format
     1506         ,output v-label
     1507         ,output v-range
     1508         ,output v-user-can-edit
     1509         ,output v-output-display
     1510         ,output v-other
     1511         ) no-error .
     1512       if error-status :error then do:
     1513         undo, return error return-value .
     1514       end.
     1515       find first buf_dis-card-type-attr exclusive-lock
     1516         where
     1517               buf_dis-card-type-attr.emitent-host-code   = p-emitent-host-code
     1518           and buf_dis-card-type-attr.type                = p-type
     1519           and buf_dis-card-type-attr.host-code = p-host-code
     1520           and buf_dis-card-type-attr.obj-type  = p-obj-type
     1521           and buf_dis-card-type-attr.obj-code  = p-obj-code
     1522           and buf_dis-card-type-attr.attr-code = p-code
     1523         no-error NO-WAIT.
     1524       if not available buf_dis-card-type-attr then do:
     1525         p-deleted = no.
     1526       end.
     1527       else do:
     1528         if valid-handle(p-cmd-proc-handle) then do:
     1529           run add-dump in p-cmd-proc-handle
     1530             (input p-cmd-code
     1531             ,input 'dis-card-type-attr':U
     1532             ,input '+delete'
     1533             ,input buffer buf_dis-card-type-attr:handle
     1534             ,input '':U
     1535             ,output v-rec-ord_
     1536             ) no-error .
     1537           if error-status:error then do:
     1538             undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1)).
     1539           end.
     1540         end.
     1541         delete buf_dis-card-type-attr.
     1542         p-deleted = yes.
     1543       end.
     1544     end.
     1545   end procedure.
     1546   procedure dct-attr-news :
     1547     do
     1548     on error undo, return error return-value
     1549     :
     1550       define input  parameter p-code           as character no-undo .
     1551       define output parameter p-news           as logical   no-undo .
     1552       if index(p-code, chr(4)) > 0 then do:
     1553         p-code = entry(1, p-code, chr(4)).
     1554       end.
     1555       case p-code :
     1556         otherwise do:
     1557           undo, return error substitute("неизвестный атрибут типа дисконтной карты &1", p-code ).
     1558         end.
     1559       end.
     1560     end.
     1561   end procedure.
     1562   define variable v-chg-fields as character no-undo.
     1563   define variable v-old-fields as character no-undo.
     1564   define variable v-new-fields as character no-undo.
     1565   define variable ii as integer no-undo.
     1566   define variable v-mess  as character no-undo .
     1567   define buffer buf_c-dis-card-type for ub.c-dis-card-type.
     1568   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1569   define SHARED temp-table temp-changes no-undo
     1570   field f_name as character
     1571   field l_name as character
     1572   field v_old as character
     1573   field v_new as character
     1574   field t_name as character
     1575   field num_ as integer
     1576   field uniq-key-rec as character
     1577   field action as integer
     1578   field fNotChange as logical
     1579   index pi is unique primary
     1580   num_
     1581   t_name
     1582   f_name
     1583   index
     1584   Chan
     1585   fnotChange
     1586   t_name
     1587   f_name
     1588   index imain uniq-key-rec
     1589   .
     1590   FUNCTION get-all-fields returns character (p-file-name as character ):
     1591   define variable v-dop as character no-undo .
     1592     find first _file no-lock where _file._file-name = p-file-name no-error .
     1593     if not available _file then return "":U.
     1594     for each _field no-lock where
     1595              _field._file-recid = recid(_file) :
     1596       assign
     1597       v-dop = v-dop + _field._field-name + chr(44)
     1598       .
     1599     end.
     1600     return trim(v-dop).
     1601   END FUNCTION.
     1602   PROCEDURE proc-full-temp-changes :
     1603     define input  parameter p-act-create as logical   no-undo .
     1604     define input  parameter p-act-delete as logical   no-undo .
     1605     define input  parameter p-hst-handle as handle    no-undo .
     1606     define input  parameter p-main-table as character no-undo .
     1607     define input  parameter p-field-list as character no-undo .
     1608     define input  parameter p-label-form as character no-undo .
     1609     define variable h-new-buf         as handle    no-undo .
     1610     define variable h-main-buf        as handle    no-undo .
     1611     define variable h-for-comp        as handle    no-undo .
     1612     define variable v-inform          as character no-undo .
     1613     define variable v-ind             as integer   no-undo .
     1614     define variable v-idx-field-qnty  as integer   no-undo .
     1615     define variable v-num-entries     as integer   no-undo .
     1616     define variable fh                as handle    no-undo .
     1617     define variable fh-main           as handle    no-undo .
     1618     define variable fh-old            as handle    no-undo .
     1619     define variable fh-new            as handle    no-undo .
     1620     define variable v-field-name      as character no-undo .
     1621     define variable v-field-lvl       as character no-undo .
     1622     define variable v-field-form      as character no-undo .
     1623     define variable v-search-exp      as character no-undo .
     1624     define variable v-srch-main       as character no-undo .
     1625     define variable v-word-link       as character no-undo .
     1626     define variable v-av-chip-num     as logical   no-undo .
     1627     define variable v-main-pi-fld-lst as character no-undo .
     1628     define variable v-main-fld-lst    as character no-undo .
     1629     define variable v-delim-list      as character no-undo .
     1630     define variable v-label           as character no-undo .
     1631     define variable v-old-value       as character no-undo case-sensitive.
     1632     define variable v-new-value       as character no-undo case-sensitive.
     1633     define variable v-chg-fields as character no-undo.
     1634     for each temp-changes:
     1635       delete temp-changes.
     1636     end.
     1637     if not p-hst-handle:available then do:
     1638       return .
     1639     end.
     1640     create buffer h-new-buf  for table p-hst-handle .
     1641     create buffer h-main-buf for table p-main-table .
     1642     assign
     1643       v-inform = h-main-buf:index-information(1)
     1644       v-ind    = 2
     1645     .
     1646     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1647     on error undo, return error
     1648     :
     1649       assign
     1650         v-inform = h-main-buf:index-information( v-ind )
     1651         v-ind    = v-ind + 1
     1652       .
     1653     end.
     1654     if v-inform = ?
     1655       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1656       or entry( 3, v-inform, ",":U ) <> "1":U
     1657     then do:
     1658       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, h-main-buf:name ).
     1659     end.
     1660     assign
     1661       v-idx-field-qnty = num-entries( v-inform ) - 4
     1662     .
     1663     if v-idx-field-qnty < 2 then do:
     1664       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, h-main-buf:name ).
     1665     end.
     1666     assign
     1667       v-srch-main   = "where":U
     1668       v-word-link   = "":U
     1669       v-av-chip-num = false
     1670       v-delim-list  = "":U
     1671     .
     1672     do v-ind = 1 to v-idx-field-qnty by 2
     1673     on error undo, return error
     1674     :
     1675       assign
     1676         v-field-name      = entry( 4 + v-ind, v-inform, ",":U )
     1677         fh                = p-hst-handle:buffer-field( v-field-name )
     1678         fh-main           = h-main-buf:buffer-field( v-field-name )
     1679         v-srch-main       = substitute( "&1 &2 &3.&4 =", v-srch-main, v-word-link, fh-main:table, v-field-name )
     1680         v-main-pi-fld-lst = v-main-pi-fld-lst + v-delim-list + v-field-name
     1681       .
     1682       if fh:data-type ="character":U then do:
     1683         assign
     1684           v-srch-main = substitute( '&1 "&2"', v-srch-main, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
     1685         .
     1686       end.
     1687       else do:
     1688         assign
     1689           v-srch-main = substitute( "&1 &2", v-srch-main, fh:buffer-value() )
     1690         .
     1691       end.
     1692       if v-delim-list = "":U then do:
     1693         assign
     1694           v-delim-list = ",":U
     1695         .
     1696       end.
     1697       if v-word-link = "":U then do:
     1698         assign
     1699           v-word-link = "and":U
     1700         .
     1701       end.
     1702     end.
     1703     assign
     1704       v-delim-list  = "":U
     1705     .
     1706     do v-ind = 1 to h-main-buf:num-fields
     1707     on error undo, return error
     1708     :
     1709       assign
     1710         fh-main      = h-main-buf:buffer-field( v-ind )
     1711         v-field-name = fh-main:name
     1712       .
     1713         assign
     1714           v-main-fld-lst = v-main-fld-lst + v-delim-list + v-field-name
     1715         .
     1716         if v-delim-list = "":U then do:
     1717           assign
     1718             v-delim-list = ",":U
     1719           .
     1720         end.
     1721     end.
     1722     assign
     1723       v-inform = p-hst-handle:index-information(1)
     1724       v-ind    = 2
     1725     .
     1726     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1727     on error undo, return error
     1728     :
     1729       assign
     1730         v-inform = p-hst-handle:index-information( v-ind )
     1731         v-ind    = v-ind + 1
     1732       .
     1733     end.
     1734     if v-inform = ?
     1735       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1736       or entry( 3, v-inform, ",":U ) <> "1":U
     1737     then do:
     1738       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, p-hst-handle:name ).
     1739     end.
     1740     assign
     1741       v-idx-field-qnty = num-entries( v-inform ) - 4
     1742     .
     1743     if v-idx-field-qnty < 2 then do:
     1744       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, p-hst-handle:name ).
     1745     end.
     1746     assign
     1747       v-search-exp  = "where":U
     1748       v-word-link   = "":U
     1749       v-av-chip-num = false
     1750     .
     1751     do v-ind = 1 to v-idx-field-qnty by 2
     1752     on error undo, return error
     1753     :
     1754       assign
     1755         v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     1756         fh           = p-hst-handle:buffer-field( v-field-name )
     1757         v-search-exp = substitute( "&1 &2 &3.&4", v-search-exp, v-word-link, fh:table, v-field-name )
     1758       .
     1759       if v-field-name = "chip-num":U then do:
     1760         assign
     1761           v-search-exp  = substitute( "&1 >", v-search-exp )
     1762           v-av-chip-num = true
     1763         .
     1764       end.
     1765       else do:
     1766         assign
     1767           v-search-exp = substitute( "&1 =", v-search-exp )
     1768         .
     1769       end.
     1770       if fh:data-type ="character":U then do:
     1771         assign
     1772           v-search-exp = substitute( '&1 "&2"', v-search-exp, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
     1773         .
     1774       end.
     1775       else do:
     1776         assign
     1777           v-search-exp = substitute( '&1 &2', v-search-exp, fh:buffer-value() )
     1778         .
     1779       end.
     1780       if v-word-link = "":U then do:
     1781         assign
     1782           v-word-link = "and":U
     1783         .
     1784       end.
     1785     end.
     1786     if v-av-chip-num = false then do:
     1787       message
     1788         vss-workfile vss-revision vss-description skip
     1789         substitute( "Таблица &2 не содержит поля chip-num.", vss-workfile, p-hst-handle:name ) skip
     1790         "Использование данной процедуры невозможно!" skip
     1791         view-as alert-box error .
     1792       return error .
     1793     end.
     1794     h-new-buf:find-first( v-search-exp, no-lock ) no-error .
     1795     if not h-new-buf:available then do:
     1796       h-main-buf:find-first( v-srch-main, no-lock ) no-error .
     1797       if not h-main-buf:available then do:
     1798         assign
     1799           h-for-comp = ?
     1800         .
     1801       end.
     1802       else do:
     1803         assign
     1804           h-for-comp = h-main-buf
     1805         .
     1806       end.
     1807     end.
     1808     else do:
     1809       assign
     1810         h-for-comp = h-new-buf
     1811       .
     1812     end.
     1813     assign
     1814       v-num-entries = num-entries( v-main-fld-lst, ",":U )
     1815     .
     1816     do v-ind = 1 to v-num-entries
     1817     on error undo, return error return-value
     1818     :
     1819       assign
     1820         v-field-name = entry( v-ind, v-main-fld-lst )
     1821         fh-old       = p-hst-handle:buffer-field( v-field-name )
     1822         v-old-value  = fh-old:buffer-value()
     1823         v-label      = trim( fh-old:label )
     1824       .
     1825       if ( trim( p-field-list ) <> "":U
     1826            and lookup( v-field-name, p-field-list ) > 0
     1827          )
     1828          or trim( p-field-list ) = "":U
     1829       then do:
     1830         if h-for-comp <> ? then do:
     1831           assign
     1832             fh-new      = h-for-comp:buffer-field( v-field-name )
     1833             v-new-value = fh-new:buffer-value()
     1834           .
     1835         end.
     1836         else do:
     1837           assign
     1838             v-new-value = "":U
     1839           .
     1840         end.
     1841           if p-act-create = true then do:
     1842             assign
     1843               v-old-value = "":U
     1844             .
     1845           end.
     1846           if p-act-delete = true then do:
     1847             assign
     1848               v-new-value = "":U
     1849             .
     1850           end.
     1851         if v-old-value <> v-new-value
     1852         then do:
     1853           create temp-changes.
     1854           assign
     1855             temp-changes.t_name = p-main-table
     1856             temp-changes.f_name = v-field-name
     1857             temp-changes.l_name = replace( v-label, "&":U, "":U )
     1858             temp-changes.v_old  = trim( v-old-value )
     1859             temp-changes.v_new  = trim( v-new-value )
     1860             temp-changes.num_   = 0
     1861             temp-changes.fNotChange = v-old-value eq v-new-value
     1862           .
     1863         end.
     1864       end.
     1865     end.
     1866     assign
     1867       v-num-entries = num-entries( p-label-form, chr(8) )
     1868     .
     1869     do v-ind = 1 to v-num-entries
     1870     on error undo, return error return-value
     1871     :
     1872       if num-entries( entry( v-ind, p-label-form, chr(8) ), chr(4) ) = 3 then do:
     1873         assign
     1874           v-field-name = entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1875           v-field-lvl  = entry( 2, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1876           v-field-form = entry( 3, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1877         .
     1878         find first temp-changes
     1879           where temp-changes.f_name = v-field-name
     1880           no-error .
     1881         if available temp-changes then do:
     1882           if trim( v-field-lvl ) <> "":U then do:
     1883             assign
     1884               temp-changes.l_name = v-field-lvl
     1885             .
     1886           end.
     1887           if trim( v-field-form ) <> "":U then do:
     1888             assign
     1889               temp-changes.v_old = dynamic-function( v-field-form, temp-changes.v_old )
     1890             .
     1891             if h-for-comp <> ? then do:
     1892               assign
     1893                 temp-changes.v_new = dynamic-function( v-field-form, temp-changes.v_new )
     1894               .
     1895             end.
     1896           end.
     1897         end.
     1898       end.
     1899       else do:
     1900         message
     1901           vss-workfile vss-revision vss-description skip
     1902           "Ошибка! Список должен содержать три поля с разделителем delim-par!" skip
     1903           substitute( "список для поля '&1': '&2'"
     1904                       ,entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1905                       ,entry( v-ind, p-label-form, chr(8) )
     1906                     ) skip
     1907           substitute( "полный список: &2", p-label-form ) skip
     1908           view-as alert-box error .
     1909       end.
     1910     end.
     1911     delete object h-new-buf .
     1912     delete object h-main-buf .
     1913   END PROCEDURE.
     1914   find first buf_c-dis-card-type no-lock where
     1915             buf_c-dis-card-type.emitent-host-code = p-emitent-host-code
     1916         AND buf_c-dis-card-type.type              = p-type
     1917         AND buf_c-dis-card-type.host-code         = p-host-code
     1918         AND buf_c-dis-card-type.obj-type          = p-obj-type
     1919         AND buf_c-dis-card-type.obj-code          = p-obj-code
     1920         AND buf_c-dis-card-type.chip-num = p-chip-num
     1921         AND buf_c-dis-card-type.corr-user-db-num = p-corr-user-db-num  no-error .
     1922   if not available buf_c-dis-card-type then do:
     1923     return error .
     1924   end.
     1925   CASE p-subject:
     1926     when 'dis-card-type':U then do:
     1927       run dis-card-type-proc in this-procedure(output p-description) no-error .
     1928     end.
     1929     when 'dis-card-type-attr':U then do:
     1930       run dis-card-type-attr-proc in this-procedure(output p-description) no-error .
     1931     end.
     1932     when 'dis-card-mask':U then do:
     1933       run dis-card-mask-proc in this-procedure(output p-description) no-error .
     1934     end.
     1935     when 'rp-by-call':U then do:
     1936       run rp-by-call-proc in this-procedure(output p-description) no-error .
     1937     end.
     1938     when 'rule-by-call':U then do:
     1939       run rule-by-call-proc in this-procedure(output p-description) no-error .
     1940     end.
     1941     when 'rule-call-param':U then do:
     1942       run rule-call-param-proc in this-procedure(output p-description) no-error .
     1943     end.
     1944     when 'dis-dct-rule':U then do:
     1945       run dis-dct-rule-proc in this-procedure(output p-description) no-error .
     1946     end.
     1947     when 'hist-nws-option':U then do:
     1948       run hist-nws-option-proc in this-procedure(output p-description) no-error .
     1949     end.
     1950   END CASE.
     1951   if error-status:error then do:
     1952     return error .
     1953   end.
     1954   procedure dis-card-type-proc :
     1955   define output parameter p-description as character no-undo .
     1956   define buffer current_c-dis-card-type for ub.c-dis-card-type  .
     1957     do
     1958     on error undo, return error return-value
     1959     :
     1960       find first current_c-dis-card-type no-lock where
     1961                  current_c-dis-card-type.emitent-host-code = p-emitent-host-code
     1962              AND current_c-dis-card-type.type              = p-type
     1963              AND current_c-dis-card-type.host-code         = p-host-code
     1964              AND current_c-dis-card-type.obj-type          = p-obj-type
     1965              AND current_c-dis-card-type.obj-code          = p-obj-code
     1966              AND current_c-dis-card-type.chip-num          = p-chip-num
     1967              AND current_c-dis-card-type.corr-user-db-num  = p-corr-user-db-num no-error .
     1968       if not avail current_c-dis-card-type then do:
     1969          v-mess = "Неверная ссылка на c-dis-card-type в таблице c-dis-card-type".
     1970          run err-mess(input-output v-mess).
     1971          return error.
     1972       end.
     1973   define variable v-label-param as character no-undo .
     1974   v-label-param =
     1975     "card-media" + chr(4) + "Тип носителя карты" + chr(4) + "" + chr(8)
     1976    + "cardname-sent" + chr(4) + "На кассу в поле ИМЯ" + chr(4) + "" + chr(8)
     1977    + "custom-sent" + chr(4) + "На кассу в настраиваемом поле" + chr(4) + "" + chr(8)
     1978    + "d-pcnt-byshop" + chr(4) + "Скидка по объектам" + chr(4) + "" + chr(8)
     1979    + "dc-pfx" + chr(4) + "Префикс карты" + chr(4) + "" + chr(8)
     1980    + "dcbyshop" + chr(4) + "Только СВОИ карты" + chr(4) + "" + chr(8)
     1981    + "dflt-credit-card" + chr(4) + "Кредитная карта" + chr(4) + "" + chr(8)
     1982    + "dflt-d-pcnt-method" + chr(4) + "Тип скидки" + chr(4) + "" + chr(8)
     1983    + "dflt-debet-card" + chr(4) + "Дебетовая карта" + chr(4) + "" + chr(8)
     1984    + "dflt-staff-card" + chr(4) + "Карта персонала" + chr(4) + "" + chr(8)
     1985    + "emitent-host-code" + chr(4) + "Код фирмы-эмитента" + chr(4) + "" + chr(8)
     1986    + "fiscal-pay" + chr(4) + "Фискальный платеж" + chr(4) + "" + chr(8)
     1987    + "host-code" + chr(4) + "Своя организация (код)" + chr(4) + "" + chr(8)
     1988    + "lim-kr" + chr(4) + "Лимит кредита по умолчанию" + chr(4) + "" + chr(8)
     1989    + "mixed-pay" + chr(4) + "Смешанная оплата" + chr(4) + "" + chr(8)
     1990    + "obj-code" + chr(4) + "Код объекта учета" + chr(4) + "" + chr(8)
     1991    + "obj-type" + chr(4) + "Тип объекта" + chr(4) + "" + chr(8)
     1992    + "pay-code" + chr(4) + "Касс.платеж" + chr(4) + "" + chr(8)
     1993    + "service-db-num" + chr(4) + "№ обслуживающей БД" + chr(4) + "" + chr(8)
     1994    + "type" + chr(4) + "Тип карты" + chr(4) + ""  .
     1995    run proc-full-temp-changes in this-procedure (
     1996                                                input  (buf_c-dis-card-type.action = integer('1':U))
     1997                                               ,input  (buf_c-dis-card-type.action = integer('99':U))
     1998                                               ,input  buffer current_c-dis-card-type:handle
     1999                                               ,input  'dis-card-type':U
     2000                                               ,input  "card-media,cardname-sent,d-pcnt-byshop,dc-pfx,dcbyshop,dflt-cash-pcnt,dflt-credit-card," +          "dflt-d-pcnt-method,dflt-debet-card,dflt-pcnt,dflt-pcnt-kat,dflt-staff-card,emitent-host-code,fiscal-pay,host-code,lim-kr,mixed-pay," +          "obj-code,obj-type,pay-code,type"
     2001                                               ,input  v-label-param).
     2002   end.
     2003   end procedure.
     2004   procedure dis-card-type-attr-proc :
