     2151    + "order_id" + chr(4) + "Порядок вызова" + chr(4) + ""  + chr(8)
     2152    + "rule_id" + chr(4) + "№ правила" + chr(4) + ""  + chr(8)
     2153    + "algo-des" + chr(4) + "Описание правила" + chr(4) + ""  + chr(8)
     2154    + "is_dynamic" + chr(4) + "Отключаемое" + chr(4) + ""
     2155    .
     2156    run proc-full-temp-changes in this-procedure (
     2157                                                input  (buf_c-dis-card-type.action = integer('1':U))
     2158                                               ,input  (buf_c-dis-card-type.action = integer('99':U))
     2159                                               ,input  buffer current_c-rule-by-call:handle
