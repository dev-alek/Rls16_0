     2014              AND current_c-dis-card-type-attr.type = p-type
     2015              AND current_c-dis-card-type-attr.host-code = p-host-code
     2016              AND current_c-dis-card-type-attr.obj-type = p-obj-type
     2017              AND current_c-dis-card-type-attr.obj-code = p-obj-code
     2018              AND current_c-dis-card-type-attr.chip-num = p-chip-num
