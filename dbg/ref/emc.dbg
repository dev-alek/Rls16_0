     1445   procedure diasize_set-height :
     1446     define input  parameter p-new-height  as decimal   no-undo .
     1447     define input  parameter p-move-resize as logical   no-undo .
     1448     do
     1449     on error undo, return error return-value
     1450     :
     1451       run diasize_change-height in this-procedure
     1452         (input  (p-new-height - frame f-okei2 :height)
     1453         ,input  p-move-resize
     1454         ) .
     1455     end.
     1456   end procedure.
     1457   procedure diasize_change-width :
     1458     define input  parameter p-change-value as decimal   no-undo .
     1459     define input  parameter p-move-resize  as logical   no-undo .
     1460     define variable v-field-group-handle   as handle    no-undo .
     1461     define variable v-object-handle        as handle    no-undo .
