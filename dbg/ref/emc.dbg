     1729             v-object-handle = buf_temp-diasize-handle.handle-value
     1730           .
     1731           if v-object-handle <> v-diasize-resize-button
     1732           then do:
     1733             assign
     1734               v-object-handle :col = v-object-handle :col + p-change-value
     1735               no-error .
     1736             if error-status :error
     1737             or error-status :get-message(1) <> ""
     1738             then do:
     1739               undo move_block, retry move_block .
     1740             end.
     1741           end.
     1742         end.
     1743       end.
     1744       else do:
     1745         for each buf_temp-diasize-handle
     1746         on error undo move_block, retry move_block
     1747         :
     1748           assign
     1749             v-object-handle = buf_temp-diasize-handle.handle-value
     1750           .
     1751           if v-object-handle <> v-diasize-resize-button
     1752           then do:
     1753             assign
     1754               v-object-handle :col = v-object-handle :col + p-change-value
     1755               no-error .
     1756             if error-status :error
     1757             or error-status :get-message(1) <> ""
     1758             then do:
     1759               undo move_block, retry move_block .
     1760             end.
     1761           end.
     1762         end.
     1763         for each buf_temp-browse-handle
     1764           where buf_temp-browse-handle.browse-type = 'width':u
     1765         on error undo move_block, retry move_block
     1766         :
     1767           assign
     1768             buf_temp-browse-handle.browse-handle :width
     1769               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1770             no-error .
     1771           if error-status :error
     1772           or error-status :get-message(1) <> ""
     1773           then do:
     1774             undo move_block, retry move_block .
     1775           end.
     1776         end.
     1777         assign
     1778           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1779           no-error .
     1780         if error-status :error
     1781         or error-status :get-message(1) <> ""
     1782         then do:
     1783           undo move_block, retry move_block.
     1784         end.
     1785         assign
     1786           frame f-okei2 :width = frame f-okei2 :width + p-change-value
     1787         no-error .
     1788         if error-status :error
     1789         or error-status :get-message(1) <> ""
     1790         then do:
     1791           undo move_block, retry move_block.
     1792         end.
     1793         if frame f-okei2 :scrollable = true
     1794         then do:
     1795           assign
     1796             frame f-okei2 :virtual-width = frame f-okei2 :virtual-width + p-change-value
     1797           no-error .
     1798           if error-status :error
     1799           or error-status :get-message(1) <> ""
     1800           then do:
     1801             undo move_block, retry move_block.
     1802           end.
     1803         end.
     1804       end.
     1805       if p-move-resize
     1806       then do:
     1807         run diasize_position-resize-button in this-procedure .
     1808       end.
     1809       if v-diasize-wndstore = true
     1810       then do:
     1811         if connected("ub") = true
     1812         then do:
     1813           define variable v-cntxt-db-num        as integer   no-undo .
     1814           define variable v-cntxt-userid        as character no-undo .
     1815           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1816                                             , OUTPUT v-cntxt-userid
     1817                                             ) .
     1818           run gbl/wndsizew.p
     1819             (input  v-cntxt-db-num
     1820             ,input  v-cntxt-userid
     1821             ,input  v-diasize-proc-name
     1822             ,input  'width':u
     1823             ,input  string(frame f-okei2 :width - v-diasize-orig-frame-width)
     1824             ) .
     1825         end.
     1826       end.
     1827     end.
     1828     assign
     1829       v-diasize-change-size = false
     1830     .
     1831   end procedure.
     1832   procedure diasize_set-width :
     1833     define input  parameter p-new-width  as decimal   no-undo .
     1834     define input  parameter p-move-resize as logical   no-undo .
     1835     do
     1836     on error undo, return error return-value
     1837     :
     1838       run diasize_change-width in this-procedure
     1839         (input  (p-new-width - frame f-okei2 :width)
     1840         ,input  p-move-resize
     1841         ) .
     1842     end.
     1843   end procedure.
     1844   procedure diasize_position-resize-button :
     1845     do with frame f-okei2
     1846     :
     1847       hide v-diasize-resize-button .
     1848       assign
     1849         v-diasize-resize-button :row = frame f-okei2 :height - v-diasize-resize-button :height
     1850                     - 1
     1851                     - (frame f-okei2 :border-bottom-pixels / session :pixels-per-row)
     1852         v-diasize-resize-button :col = frame f-okei2 :width - v-diasize-resize-button :width
     1853                     - 1
     1854                     - (frame f-okei2 :border-right-pixels / session :pixels-per-column)
     1855       .
     1856       view v-diasize-resize-button .
     1857     end.
     1858   end procedure.
     1859   on alt-right anywhere
     1860   do:
     1861     run diasize_change-width in this-procedure
     1862       (input 1
     1863       ,input true
     1864       ) .
     1865     return no-apply .
     1866   end.
     1867   on alt-left anywhere
     1868   do:
     1869     run diasize_change-width in this-procedure
     1870       (input -1
     1871       ,input true
     1872       ) .
     1873     return no-apply .
     1874   end.
     1875   on alt-down anywhere
     1876   do:
     1877     run diasize_change-height in this-procedure
     1878       (input 1
     1879       ,input true
     1880       ) .
     1881     return no-apply .
     1882   end.
     1883   on alt-up anywhere
     1884   do:
     1885     run diasize_change-height in this-procedure
     1886       (input -1
     1887       ,input true
     1888       ) .
     1889     return no-apply .
     1890   end.
     1891   on alt-enter of frame f-okei2
     1892   do:
     1893     run diasize_maximize in this-procedure
     1894       (input  ?
     1895       ).
     1896     return no-apply .
     1897   end.
     1898   procedure diasize_end-move :
     1899     do
     1900     on error undo, return error return-value
     1901     :
     1902       define variable v-row-delta as decimal   no-undo .
     1903       define variable v-col-delta as decimal   no-undo .
     1904       define variable v-new-row as decimal   no-undo .
     1905       define variable v-new-col as decimal   no-undo .
     1906       assign
     1907         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1908         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1909       .
     1910       assign
     1911         v-row-delta = v-new-row - frame f-okei2 :height
     1912         v-col-delta = v-new-col - frame f-okei2 :width
     1913       .
     1914       run diasize_change-height in this-procedure
     1915         (input v-row-delta
     1916         ,input true
     1917         ) .
     1918       run diasize_change-width in this-procedure
     1919         (input v-col-delta
     1920         ,input true
     1921         ) .
     1922     end.
     1923   end procedure.
     1924   procedure diasize_maximize :
     1925     define input  parameter p-action as logical   no-undo .
     1926     do
     1927     on error undo, return error return-value
     1928     :
     1929       if p-action = ?
     1930       then do:
     1931         if v-diasize-need-maximize = true
     1932         then do:
     1933           assign
     1934             p-action = true
     1935           .
     1936         end.
     1937         else do:
     1938           assign
     1939             p-action = false
     1940           .
     1941         end.
     1942       end.
     1943       if p-action = true
     1944       then do:
     1945         run diasize_change-height in this-procedure
     1946           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1947               - frame f-okei2 :height-chars
     1948           ,input true
     1949           ) .
     1950         run diasize_change-width in this-procedure
     1951           (input session :width-chars
     1952               - frame f-okei2 :width-chars
     1953           ,input true
     1954           ) .
     1955         assign
     1956           v-diasize-need-maximize = false
     1957         .
     1958       end.
     1959       else do:
     1960         run diasize_change-width in this-procedure
     1961           (input v-diasize-orig-frame-width
     1962               - frame f-okei2 :width-chars
     1963           ,input true
     1964           ) .
     1965         run diasize_change-height in this-procedure
     1966           (input v-diasize-orig-frame-height
     1967               - frame f-okei2 :height-chars
     1968           ,input true
     1969           ) .
     1970         assign
     1971           v-diasize-need-maximize = true
     1972         .
     1973       end.
     1974     end.
     1975   end procedure.
     1976   procedure diasize_restore-orig-size :
     1977     do
     1978     on error undo, return error return-value
     1979     :
     1980       assign
     1981         v-diasize-current-frame-width  = frame f-okei2 :width
     1982         v-diasize-current-frame-height = frame f-okei2 :height
     1983       .
     1984       run diasize_set-height in this-procedure
     1985         (input  v-diasize-orig-frame-height
     1986         ,input  true
     1987         ) .
     1988       run diasize_set-width in this-procedure
     1989         (input  v-diasize-orig-frame-width
     1990         ,input  true
     1991         ) .
     1992     end.
     1993   end procedure.
     1994   procedure diasize_restore-current-size :
     1995     do
     1996     on error undo, return error return-value
     1997     :
     1998       run diasize_set-height in this-procedure
     1999         (input  v-diasize-current-frame-height
     2000         ,input  true
     2001         ) .
     2002       run diasize_set-width in this-procedure
     2003         (input  v-diasize-current-frame-width
     2004         ,input  true
     2005         ) .
     2006     end.
     2007   end procedure.
     2008   procedure diasize_set-browse-handle :
     2009     define input  parameter p-browse-handle as handle   no-undo .
     2010     define buffer buf_temp-browse-handle for temp-browse-handle .
     2011     do
     2012     on error undo, return error return-value
     2013     :
     2014       assign
     2015         v-diasize-browse-handle = p-browse-handle
     2016       .
     2017       for each buf_temp-browse-handle
     2018       on error undo, return error return-value
     2019       :
     2020         delete buf_temp-browse-handle .
     2021       end.
     2022     end.
     2023   end procedure.
     2024   procedure diasize_add_browse :
     2025     define input  parameter p-browse-type   as character no-undo .
     2026     define input  parameter p-browse-handle as handle    no-undo .
     2027     define buffer buf_temp-browse-handle for temp-browse-handle .
     2028     do
     2029     on error undo, return error return-value
     2030     :
     2031       assign
     2032         v-diasize-browse-number = v-diasize-browse-number + 1
     2033       .
     2034       create buf_temp-browse-handle .
     2035       assign
     2036         buf_temp-browse-handle.browse-type   = p-browse-type
     2037         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2038         buf_temp-browse-handle.browse-handle = p-browse-handle
     2039       .
     2040     end.
     2041   end procedure.
     2042   procedure diasize_init :
     2043     define variable v-default-value    as logical   no-undo .
     2044     define variable v-restore-saved    as logical   no-undo .
     2045     define variable v-resize-value-str as character no-undo .
     2046     do
     2047     on error undo, return error return-value
     2048     :
     2049       do with frame f-okei2
     2050       :
     2051         assign
     2052           v-diasize-orig-frame-height = frame f-okei2 :height
     2053           v-diasize-orig-frame-width  = frame f-okei2 :width
     2054           v-diasize-browse-handle     = browse BROWSE-5 :handle
     2055         .
     2056         create button v-diasize-resize-button
     2057         assign
     2058           parent        = frame f-okei2 :first-child
     2059           label         = "s"
     2060           height-pixels = 16
     2061           width-pixels  = 16
     2062           visible       = true
     2063           sensitive     = true
     2064           movable       = true
     2065           triggers:
     2066             on end-move persistent run diasize_end-move in this-procedure .
     2067           end triggers.
     2068         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2069         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2070         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2071         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2072         assign
     2073           v-diasize-wndmax = false
     2074         .
     2075         if connected("ub") = true
     2076         then do:
     2077           define variable v-cntxt-db-num        as integer   no-undo .
     2078           define variable v-cntxt-userid        as character no-undo .
     2079           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2080                                             , OUTPUT v-cntxt-userid
     2081                                             ) .
     2082           run gbl/wndpar_r.p
     2083             (input  v-cntxt-db-num
     2084             ,input  v-cntxt-userid
     2085             ,input  'wndmax':U
     2086             ,output v-diasize-wndmax
     2087             ,output v-default-value
     2088             ) .
     2089         end.
     2090         assign
     2091           v-diasize-wndstore = false
     2092         .
     2093         if connected("ub") = true
     2094         then do:
     2095           run gbl/wndpar_r.p
     2096             (input  v-cntxt-db-num
     2097             ,input  v-cntxt-userid
     2098             ,input  'wndstore':U
     2099             ,output v-diasize-wndstore
     2100             ,output v-default-value
     2101             ) .
     2102         end.
     2103         assign
     2104           v-diasize-proc-name = entry(1, program-name(2), '.')
     2105         .
     2106         if v-diasize-wndstore = true
     2107         then do:
     2108           assign
     2109             v-restore-saved = false
     2110           .
     2111           if connected("ub") = true
     2112           then do:
     2113             run gbl/wndsizer.p
     2114               (input  v-cntxt-db-num
     2115               ,input  v-cntxt-userid
     2116               ,input  v-diasize-proc-name
     2117               ,input  'height':u
     2118               ,output v-resize-value-str
     2119               ) .
     2120             if v-resize-value-str <> '':U
     2121             then do:
     2122               run diasize_change-height in this-procedure
     2123                 (input  integer(v-resize-value-str)
     2124                 ,input  true
     2125                 ) .
     2126               assign
     2127                 v-restore-saved = true
     2128               .
     2129             end.
     2130           end.
     2131           if connected("ub") = true
     2132           then do:
     2133             run gbl/wndsizer.p
     2134               (input  v-cntxt-db-num
     2135               ,input  v-cntxt-userid
     2136               ,input  v-diasize-proc-name
     2137               ,input  'width':u
     2138               ,output v-resize-value-str
     2139               ) .
     2140             if v-resize-value-str <> '':U
     2141             then do:
     2142               run diasize_change-width in this-procedure
     2143                 (input  integer(v-resize-value-str)
     2144                 ,input  true
     2145                 ) .
     2146               assign
     2147                 v-restore-saved = true
     2148               .
     2149             end.
     2150           end.
     2151           if v-restore-saved <> true
     2152           then do:
     2153             if v-diasize-wndmax = true
     2154             then do:
     2155               run diasize_maximize in this-procedure
     2156                 (input  true
     2157                 ) .
     2158             end.
     2159           end.
     2160         end.
     2161         else do:
     2162           if v-diasize-wndmax = true
     2163           then do:
     2164             run diasize_maximize in this-procedure
     2165               (input  true
     2166               ) .
     2167           end.
     2168         end.
     2169       end.
     2170     end.
     2171   end procedure.
     2172   procedure diasize_need-full-display :
     2173     define output parameter p-need-full-display as logical   no-undo .
     2174     do
     2175     on error undo, return error return-value
     2176     :
     2177       assign
     2178         p-need-full-display = v-diasize-need-full-display
     2179       .
     2180       assign
     2181         v-diasize-need-full-display = false
     2182       .
     2183     end.
     2184   end procedure.
     2185   procedure get-context :
     2186      define output parameter p-db-num as integer          no-undo.
     2187      define output parameter p-user-id as character        no-undo.
     2188      define variable v-login               as character    no-undo.
     2189      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2190      define buffer buf_user-login  for ub.user-login .
     2191      do
     2192      on error undo, return error
     2193      :
     2194            FIND FIRST buf_sys-ctrl no-lock.
     2195            ASSIGN
     2196               v-login = USERID("ub")
     2197               p-db-num = buf_sys-ctrl.db-num
     2198            .
     2199            FIND FIRST buf_user-login
     2200                 WHERE buf_user-login.db-num = p-db-num
     2201                   AND buf_user-login.user-login = v-login
     2202                 no-lock
     2203                 no-error
     2204                 .
     2205            IF AVAILABLE buf_user-login
     2206            THEN DO:
     2207               assign
     2208                  p-user-id = buf_user-login.user-id
     2209               .
     2210            END.
     2211      end.
     2212   end procedure.
     2213       run diasize_init in this-procedure .
     2214   on window-close of frame f-okei2
     2215     apply "END-ERROR":U to self.
     2216   MAIN-BLOCK:
     2217   do on error   undo MAIN-BLOCK, leave MAIN-BLOCK
     2218     on end-key undo MAIN-BLOCK, leave MAIN-BLOCK:
     2219   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2220     run mainmenu_getcntxt in parparentproc
     2221       (output v-cntxt-db-num
     2222       ,output v-cntxt-userid
     2223       ,output v-cntxt-level
     2224       ,output v-cntxt-host-code-obj
     2225       ,output v-cntxt-obj-type
     2226       ,output v-cntxt-obj-code
     2227       ,output v-cntxt-db-num-obj
     2228       ,output v-cntxt-is-admin
     2229       ) .
     2230   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2231   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
     2232     (output v-db-num
     2233     )  .
     2234     run enable_UI in this-procedure .
     2235     wait-for go of frame f-okei2 focus BROWSE-5.
     2236   end.
     2237   run disable_UI in this-procedure .
     2238   PROCEDURE disable_UI :
     2239     HIDE FRAME f-okei2.
     2240   END PROCEDURE.
     2241   PROCEDURE enable_UI :
     2242     enable
     2243       BROWSE-5
     2244       b-exit
     2245       b-add2
     2246       b-sel
     2247       when imode eq 'ВЫБОР':U
     2248       b-add
     2249       when imode eq 'ИЗМЕНЕНИЕ':U and v-db-num = 0
     2250       b-del
     2251       when imode eq 'ИЗМЕНЕНИЕ':U and v-db-num = 0
     2252       b-upd
     2253       when imode eq 'ИЗМЕНЕНИЕ':U and v-db-num = 0
     2254       b-help
     2255       with frame f-okei2.
     2256     OPEN QUERY BROWSE-5 FOR EACH Code       WHERE Code.parent = "EMC" NO-LOCK INDEXED-REPOSITION.
     2257   end procedure.
