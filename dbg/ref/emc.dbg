     1467     define variable v-change-sign          as integer   no-undo .
     1468     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1469     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1470     if p-change-value > 0
     1471     then do:
     1472       if frame f-okei2 :width + p-change-value >
     1473           session :width-chars
     1474       then do:
     1475         assign
     1476           p-change-value = session :width-chars - frame f-okei2 :width
     1477         .
     1478         if p-change-value <= 0
     1479         then do:
     1480           run diasize_position-resize-button in this-procedure .
     1481           return .
     1482         end.
     1483       end.
     1484     end.
     1485     if p-change-value < 0
     1486     then do:
     1487       if frame f-okei2 :width + p-change-value < v-diasize-orig-frame-width
     1488       then do:
     1489         assign
     1490           p-change-value = v-diasize-orig-frame-width
     1491                          - frame f-okei2 :width
     1492         .
     1493         if p-change-value >= 0
     1494         then do:
     1495           run diasize_position-resize-button in this-procedure .
     1496           return .
     1497         end.
     1498       end.
     1499     end.
     1500     if p-change-value >= 0
     1501     then do:
     1502       assign
     1503         v-change-sign = 1
     1504       .
     1505     end.
     1506     else do:
     1507       assign
     1508         v-change-sign = -1
     1509       .
     1510     end.
     1511     assign
     1512       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1513     .
     1514     if p-change-value = 0
     1515     then do:
     1516       run diasize_position-resize-button in this-procedure .
     1517       return .
     1518     end.
     1519     move_block:
