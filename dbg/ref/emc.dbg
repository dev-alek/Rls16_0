      570   if session:batch-mode
      571   then
      572      mBatchMode = yes.
      573   if mBatchMode = ? then do:
      574     mVisCUrentVin = current-window:visible.
      575     mFameOldVis = mFramBachModHandle:visible.
      576     mFramBachModHandle:visible  = yes.
      577     mBatchMode = mFramBachModHandle:visible ne yes.
      578     mFramBachModHandle:visible = mFameOldVis.
      579     current-window:visible = mVisCUrentVin.
      580   end.
      581    if  log-manager:logfile-name ne ?
      582     then DO:
      583         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      584         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      585         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      586     end.
      587   on choose of B-WaitFramStop in frame waitfram
      588   do:
      589     mWaitFramStop = yes.
      590     mWaitFramStopUser = yes.
      591   end.
      592   function waitfram-check-timeout returns logical():
      593      define variable vtime as int64 no-undo.
      594      if mWaitFramStopTimeOut
      595      then
      596         return yes.
      597      vtime = ( now - mWaitFramStartProc ) / 1000 .
      598      if     mWaitFramTimeOut ne ?
      599         and mWaitFramTimeOut ne 0
      600         and mWaitFramTimeOut lt vtime
      601      then do:
      602         mWaitFramStopTimeOut = yes.
      603      end.
      604      return mWaitFramStopTimeOut.
      605   end.
      606   procedure waitfram-hide :
      607     if not session:batch-mode
      608     then do
      609     on error undo, return error return-value
      610     :
      611       pause 0 before-hide .
      612       if not mBatchMode then
      613         hide frame waitfram .
      614     if     not mWaitFramView
      615        and mWaitProcEvent
      616     then
      617       process events .
      618     end.
      619   end procedure.
      620   procedure waitfram-show :
      621     define input  parameter p-message as character no-undo .
      622     define variable v-left-margin as integer   no-undo .
      623     if not session:batch-mode
      624     then do
      625     on error undo, return error return-value
      626     :
      627       if length(p-message) <= 70 then do:
      628         assign
      629           v-left-margin = integer((70 - length(p-message)) / 2)
      630         .
      631         assign
      632           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      633         .
      634         assign
      635           v-waitfram-action01 = " "
      636           v-waitfram-action02 = " "
      637                                    + fill(" ", v-left-margin)
      638                                    + p-message
      639           v-waitfram-action03 = " "
      640         .
      641       end.
      642       else do:
      643         define variable vRindex1 as integer no-undo.
      644         define variable vRindex2 as integer no-undo.
      645         vRindex1 = r-index(p-message," ",70).
      646         if vRindex1 = 0
      647         then
      648            vRindex1 = 70.
      649         if length(p-message)  <= vRindex1 + 70 then do:
      650           assign
      651             v-waitfram-action01 = " "
      652             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      653             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      654           .
      655         end.
      656         else do:
      657           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      658           if vRindex2 <= vRindex1
      659           then
      660              vRindex2 = vRindex1 + 70.
      661           assign
      662             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      663             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      664             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      665           .
      666         end.
      667       end.
      668       B-viewProcInfo:visible   in frame waitfram = no.
      669       B-viewProcInfo:sensitive in frame waitfram = no.
      670       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      671       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      672       if  (   mWaitFramView
      673          or  mWaitProcEvent)
      674          and not mBatchMode
      675       then
      676          display
      677             v-waitfram-action01 skip
      678             v-waitfram-action02 skip
      679             v-waitfram-action03 skip
      680          with frame waitfram .
      681       if     mWaitFramView
      682          then do:
      683             if     mWaitFramInterval ne ?
      684                and not mBatchMode
      685             then
      686                wait-for go of frame waitfram pause mWaitFramInterval.
      687          end.
      688          else
      689             if     mWaitProcEvent
      690                and not mBatchMode
      691             then
      692                process events .
      693     end.
      694   end procedure.
      695      procedure waitfram-show-this:
      696         define input  parameter iInterval as int64 no-undo.
      697         define variable vtime as int64 no-undo.
      698         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      699         mWaitFramInterval = iInterval.
      700         run waitfram-show (substitute("&1&2 &3&4" ,
      701                                       mWaitFramTextBeg ,
      702                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      703                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      704                                       mWaitFramTextEnd
      705                                      )
      706                           ).
      707      end.
      708      procedure WaitFramRunPause:
      709         define input  parameter iInterval as dec no-undo.
      710         define variable vStart  as datetime-tz no-undo.
      711         define variable vend    as datetime-tz no-undo.
      712         define variable vint as int64 no-undo.
      713         define variable vOk as logical no-undo.
      714         vStart = now.
      715         vend   = vStart.
      716         publish "WaitFramPause" (iInterval,output vOk).
      717         vend   =  now.
      718         vint = vend - vStart.
      719         vint = iInterval - vint / 1000.
      720         if     not mWaitFramStop
      721            and (   vint > 0
      722                 or (    not vOk
      723                     and iInterval eq ?
      724                     )
      725                 )
      726         then
      727            run waitfram-show-this (iInterval).
      728         vend   =  now.
      729         vint = vend - vStart.
      730         vint = iInterval - vint / 1000.
      731         if     not mWaitFramStop
      732            and vint > 0
      733         then do:
      734            run gbl/pause.p (vint * 1000).
      735         end.
      736         if iInterval ne ?
      737         then
      738            publish "WaitFramStop".
      739         waitfram-check-timeout().
      740      end.
      741      procedure WaitFramWaitFor:
      742         define input  parameter iInterval as dec no-undo.
      743         assign
      744            mWaitFramStartProc   = now
      745            mWaitFramStopUser    = no
      746            mWaitFramStopTimeOut = no
      747         .
      748         block-wait:
      749         do while not mWaitFramStop:
      750            run WaitFramRunPause (iInterval).
      751            if  waitfram-check-timeout()
      752            then do:
      753               leave block-wait.
      754            end.
      755         end.
      756         run waitfram-hide.
      757      end.
      758   procedure waitfram-join :
      759     define input  parameter p-line-1  as character no-undo .
      760     define input  parameter p-line-2  as character no-undo .
      761     define input  parameter p-line-3  as character no-undo .
      762     define output parameter p-message as character no-undo .
      763     do
      764     on error undo, return error return-value
      765     :
      766       assign
      767         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      768                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      769                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      770       .
      771     end.
      772   end procedure.
      773   function waitfram-join-function returns character
      774     (input p-line-1 as character
      775     ,input p-line-2 as character
      776     ,input p-line-3 as character
      777     ).
      778     define variable v-message as character no-undo .
      779     run waitfram-join in this-procedure
      780       (input  p-line-1
      781       ,input  p-line-2
      782       ,input  p-line-3
      783       ,output v-message
      784       ) .
      785     return v-message .
      786   end function .
      787   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      788   FUNCTION mark-string RETURNS CHARACTER
      789     ( input p-recid as recid, input mark-list as character  ) :
      790     RETURN ( IF LOOKUP( STRING( p-recid), mark-list ) > 0 THEN '*' ELSE '':U ).
      791   END FUNCTION.
      792   define variable log-res     as log       no-undo.
      793   define variable ri          as recid     no-undo.
      794   define variable v-rid       as recid     no-undo .
      795   define variable v-db-num like ub.db.db-num no-undo .
      796   DEFINE BUTTON b-add
      797        LABEL "&Добавить":L
      798        SIZE 10 BY 1.
      799   DEFINE BUTTON b-add2
      800        LABEL "Значение ЕМЦ"
      801        SIZE 15 BY 1.
      802   DEFINE BUTTON b-del
      803        LABEL "&Удалить":L
      804        SIZE 10 BY 1.
      805   DEFINE BUTTON b-exit AUTO-GO
      806        LABEL "&Выход ":L
      807        SIZE 10 BY 1.
      808   DEFINE BUTTON b-help
      809        LABEL "Помо&щь":L
      810        SIZE 3 BY 1.
      811   DEFINE BUTTON b-hist
      812        LABEL "Ис&тория"
      813        SIZE 3 BY 1.
      814   DEFINE BUTTON b-print
      815        LABEL "Пе&чать":L
      816        SIZE 3 BY 1.
      817   DEFINE BUTTON b-sel AUTO-GO
      818        LABEL "Вы&бор ":L
      819        SIZE 10 BY 1.
      820   DEFINE BUTTON b-upd
      821        LABEL "&Изменить":L
      822        SIZE 10 BY 1.
      823   DEFINE QUERY BROWSE-5 FOR
      824         Code SCROLLING.
      825   DEFINE BROWSE BROWSE-5
      826     QUERY BROWSE-5 NO-LOCK DISPLAY
      827         Code.code FORMAT "x(8)":U
      828         Code.CodeName FORMAT "x(60)":U WIDTH 54.13
      829       WITH NO-ROW-MARKERS SEPARATORS SIZE 73 BY 11 ROW-HEIGHT-CHARS .67 FIT-LAST-COLUMN.
      830   DEFINE FRAME f-okei2
      831        b-exit AT ROW 1 COL 1
      832        b-sel AT ROW 1 COL 14
      833        b-add AT ROW 1 COL 24
      834        b-del AT ROW 1 COL 34 WIDGET-ID 2
      835        b-upd AT ROW 1 COL 44.13
      836        b-print AT ROW 1 COL 65
      837        b-help AT ROW 1 COL 71
      838        b-add2 AT ROW 2.25 COL 14.13 WIDGET-ID 10
      839        BROWSE-5 AT ROW 4 COL 1 WIDGET-ID 300
      840       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      841            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      842            TITLE "Тип ЕМЦ":L.
      843   ASSIGN
      844          FRAME f-okei2:SCROLLABLE       = FALSE.
      845   ON go OF FRAME f-okei2
      846   do:
      847   end.
      848   ON choose OF b-add IN FRAME f-okei2
      849   do:
      850      define buffer b1-code for code.
      851      define buffer btt-code for code.
      852      define variable vRec as recid no-undo.
      853      define variable v-ok as logical no-undo.
      854      run ref/emc-add.w (
      855                               input parparentproc
      856                             , input 'ДОБАВЛЕНИЕ':U
      857                             , input-output ri).
      858      if ri <> ? then  do:
      859            OPEN QUERY BROWSE-5 FOR EACH Code       WHERE Code.parent = "EMC" NO-LOCK INDEXED-REPOSITION.
      860            reposition BROWSE-5 to recid ri.
      861            apply "ENTRY" to BROWSE-5.
      862      end.
      863   end.
      864   ON choose OF b-add2 IN FRAME f-okei2
      865   do:
      866      define buffer b1-code for code.
      867      define buffer btt-code for code.
      868      define variable vRec as recid no-undo.
      869      define variable v-ok as logical no-undo.
      870      if avail code
      871      then
      872      run ref/emc-value.w (
      873                               input parparentproc
      874                             , input iMode
      875                             , input code.parent
      876                             , input code.code
      877                             , input ?).
      878   end.
      879   ON choose OF b-del IN FRAME f-okei2
      880   do:
      881      define buffer b1-code for code.
      882      if not avail code then return.
      883      define variable v-ok as logical no-undo.
      884      message "Удалить запись Тип ЕМЦ - Код:" code.code "Тип ЕМЦ - Наименование:" code.codename "?"
      885         view-as alert-box question
      886         buttons yes-no
      887         title "Удаление"
      888         update v-ok .
      889      if not v-ok then return no-apply.
      890      do on error undo, return
      891      on stop undo, return:
      892         find first b1-code of code exclusive-lock no-wait no-error.
      893         if locked b1-code then do:
      894            message
      895               vss-workfile vss-revision vss-description skip
      896               "Запись <им ЕМЦ Код>> занята"
      897            view-as alert-box error .
      898            undo, return.
      899         end.
      900         if not available b1-code then do:
      901            message
      902               vss-workfile vss-revision vss-description skip
      903               "Не найдена запись <Тим ЕМЦ Код>"
      904            view-as alert-box error .
      905            undo, return.
      906         end.
      907         delete b1-code.
      908         OPEN QUERY BROWSE-5 FOR EACH Code       WHERE Code.parent = "EMC" NO-LOCK INDEXED-REPOSITION.
      909         apply "ENTRY" to BROWSE-5.
      910      end.
      911   end.
      912   ON choose OF b-sel IN FRAME f-okei2
      913   do:
      914      define buffer b1-code for code.
      915      if not avail buf-code then return.
      916      find first b1-code of buf-code no-lock no-error.
      917      if avail b1-code then
      918         v-rid = recid(b1-code).
      919   end.
      920   ON choose OF b-upd IN FRAME f-okei2
      921   do:
      922      define variable vRec as recid no-undo.
      923      if not avail code then return.
      924      define variable v-ok as logical no-undo.
      925      vRec = recid(code).
      926      run ref/emc-upd.w (
      927                               input parparentproc
      928                             , input 'ИЗМЕНЕНИЕ':U
      929                             , input-output vRec).
      930            OPEN QUERY BROWSE-5 FOR EACH Code       WHERE Code.parent = "EMC" NO-LOCK INDEXED-REPOSITION.
      931            reposition BROWSE-5 to recid vRec.
      932            apply "ENTRY" to BROWSE-5.
      933         end.
      934   if valid-handle(active-window) and frame f-okei2:PARENT eq ?
      935     then frame f-okei2:PARENT = active-window.
      936   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      937   on help of frame f-okei2
      938   do:
      939     run gbl/app_help.p
      940       (input this-procedure :file-name
      941       ,input ''
      942       ,input ?
      943       ) no-error.
      944     if error-status :error then do:
      945       message
      946         "Ошибка при вызове помощи"
      947         error-status :get-message(1)
      948         view-as alert-box .
      949     end.
      950   end.
      951   run minbtn-set in this-procedure .
      952   on choose of b-help in frame f-okei2
      953   do:
      954     apply "help":u to frame f-okei2 .
      955   end.
      956   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      957   procedure minbtn-set :
      958       do
      959           on error undo, return error return-value
      960           :
      961           define variable ii              as integer       no-undo .
      962           define variable fh              as widget-handle no-undo .
      963           define variable hh              as widget-handle no-undo .
      964           define variable v-h             as handle        extent 4 no-undo .
      965           define variable v-name-button   as character     no-undo .
      966           define variable v-help-old-x    as decimal       no-undo .
      967           define variable v-help-old-y    as decimal       no-undo .
      968           define variable v-help-old-size as decimal       no-undo .
      969           define variable v-frame-width   as decimal       no-undo .
      970           define variable jj              as integer       no-undo .
      971           do
      972               on error undo, return error
      973               :
      974               assign
      975                   v-frame-width = frame f-okei2:width - 0.3
      976                   fh            = frame f-okei2:first-child
      977                   hh            = fh:first-child
      978                   ii            = 1
      979                   .
      980               do while valid-handle(hh):
      981                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      982                   do:
      983                       case lc(hh:name) :
      984                           when "b-help" then
      985                               do:
      986                                   hh:load-image-up("cmp/b-help.bmp":u) .
      987                                   hh:load-image-down("cmp/b-help.bmp":u) .
      988                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      989                                   hh:TOOLTIP = "Помощь" .
      990                                   v-help-old-x = hh:column .
      991                                   v-help-old-y = hh:row    .
      992                                   v-help-old-size = hh:width .
      993                                   hh:width-chars = 2.5 .
      994                               end.
      995                           when "b-print" then
      996                               do:
      997                                   hh:load-image("cmp/b-print.bmp":u) .
      998                                   hh:TOOLTIP = "Печать" .
      999                                   v-h[ii] = hh:handle .
     1000                                   ii = ii + 1 .
     1001                                   hh:width-chars = 3 .
     1002                               end.
     1003                           when "b-history" or
     1004                           when "b-hist" then
     1005                               do:
     1006                                   hh:load-image("cmp/b-hist.bmp":u) .
     1007                                   hh:TOOLTIP = "История" .
     1008                                   v-h[ii] = hh:handle .
     1009                                   ii = ii + 1 .
     1010                                   hh:width-chars = 3 .
     1011                               end.
     1012                           when "b-sch" then
     1013                               do:
     1014                                   hh:load-image("cmp/b-sch.bmp":u) .
     1015                                   hh:TOOLTIP = "Установка Фильтра" .
     1016                                   v-h[ii] = hh:handle .
     1017                                   ii = ii + 1 .
     1018                                   hh:width-chars = 3 .
     1019                               end.
     1020                           when "b-hist-user" then
     1021                               do:
     1022                                   hh:load-image("cmp/b-hist.bmp":u) .
     1023                                   hh:TOOLTIP = "История пользователя" .
     1024                                   ii = ii + 1 .
     1025                               end.
     1026                       end case.
     1027                   end.
     1028                   hh = hh:next-sibling.
     1029               end.
     1030               b-help:column = v-frame-width - b-help:width-chars.
     1031               jj = 0.
     1032               repeat ii = 4 to 1 by -1 :
     1033                   if valid-handle (v-h[ii] ) then
     1034                   do:
     1035                       jj  = jj + 1 .
     1036                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1037                       v-h[ii]:row    = v-help-old-y .
     1038                   end.
     1039               end.
     1040           end.
     1041       end.
     1042   end procedure.
     1043   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1044   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1045   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1046   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1047   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1048   define variable v-diasize-current-frame-height as decimal   no-undo .
     1049   define variable v-diasize-change-size          as logical   no-undo .
     1050   define variable v-diasize-resize-button        as handle    no-undo .
     1051   define variable v-diasize-wndmax               as logical   no-undo .
     1052   define variable v-diasize-wndstore             as logical   no-undo .
     1053   define variable v-diasize-proc-name            as character no-undo .
     1054   define variable v-diasize-browse-handle        as handle    no-undo .
     1055   define variable v-diasize-browse-number        as integer   no-undo .
     1056   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1057   define temp-table temp-diasize-handle no-undo
     1058     field handle-value  as handle
     1059     field save-position as decimal
     1060     index xpk is primary unique handle-value
     1061     .
     1062   define temp-table temp-browse-handle no-undo
     1063     field browse-type   as character
     1064     field browse-number as integer
     1065     field browse-handle as handle
     1066     field original-size as decimal
     1067     index xpk is primary unique browse-type browse-number
     1068     index xie browse-type browse-handle
     1069   .
     1070   procedure diasize_change-height :
     1071     define input  parameter p-change-value  as decimal   no-undo .
     1072     define input  parameter p-move-resize   as logical   no-undo .
     1073     define variable v-field-group-handle    as handle    no-undo .
     1074     define variable v-object-handle         as handle    no-undo .
     1075     define variable v-frame-height          as decimal   no-undo .
     1076     define variable v-frame-virtual-height  as decimal   no-undo .
     1077     define variable v-browse-height         as decimal   no-undo .
     1078     define variable v-window-height         as decimal   no-undo .
     1079     define variable v-window-virtual-height as decimal   no-undo .
     1080     define variable v-change-sign           as integer   no-undo .
     1081     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1082     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1083     if p-change-value > 0
     1084     then do:
     1085       if frame f-okei2 :height + p-change-value
     1086           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1087       then do:
     1088         assign
     1089           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1090                           - (frame f-okei2 :height-chars)
     1091         .
     1092         if p-change-value <= 0
     1093         then do:
     1094           run diasize_position-resize-button in this-procedure .
     1095           return .
     1096         end.
     1097       end.
     1098     end.
     1099     if p-change-value < 0
     1100     then do:
     1101       if frame f-okei2 :height + p-change-value < v-diasize-orig-frame-height
     1102       then do:
     1103         assign
     1104           p-change-value = v-diasize-orig-frame-height
     1105                          - (frame f-okei2 :height-chars)
     1106         .
     1107         if p-change-value >= 0
     1108         then do:
     1109           run diasize_position-resize-button in this-procedure .
     1110           return .
     1111         end.
     1112       end.
     1113     end.
     1114     if p-change-value >= 0
     1115     then do:
     1116       assign
     1117         v-change-sign = 1
     1118       .
     1119     end.
     1120     else do:
     1121       assign
     1122         v-change-sign = -1
     1123       .
     1124     end.
     1125     assign
     1126       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1127     .
     1128     if p-change-value = 0
     1129     then do:
     1130       run diasize_position-resize-button in this-procedure .
