     4924       tt-fin-doc.receiver-code
     4925       tt-fin-doc.receiver-okpo
     4926       tt-fin-doc.receiver-name
     4927       tt-fin-doc.str-podr-type
     4928       tt-fin-doc.str-podr-code
     4929       tt-fin-doc.str-podr-name
     4930       with frame Dialog-Frame
     4931       .
     4932       display
     4933       f-debet
     4934       f-credit
     4935       tt-fin-doc.cor-acc1-value
     4936       f-cor-acc1-descr
     4937       tt-fin-doc.cor-acc-value
     4938       f-cor-acc-descr
     4939       tt-fin-doc.an-uchet-value
     4940       f-an-uchet-descr
     4941       tt-fin-doc.cel-nazn-value
     4942       f-cel-nazn-descr
     4943       with frame Dialog-Frame
     4944       .
     4945       display
     4946       f-debet
     4947       f-credit
     4948       tt-fin-doc.cor-acc1-value
     4949       f-cor-acc1-descr
     4950       tt-fin-doc.cor-acc-value
     4951       f-cor-acc-descr
     4952       tt-fin-doc.an-uchet-value
     4953       f-an-uchet-descr
     4954       tt-fin-doc.cel-nazn-value
     4955       f-cel-nazn-descr
     4956       with frame Dialog-Frame
     4957       .
     4958       if v-limit-access = 0 then do:
     4959         ENABLE
     4960         tt-fin-doc.str-podr-type
     4961         tt-fin-doc.str-podr-code
     4962         tt-fin-doc.str-podr-name
     4963         WITH FRAME Dialog-Frame.
     4964       end.
     4965       if v-limit-access < 2 then do:
     4966         ENABLE
     4967         B-cor-acc1
     4968         tt-fin-doc.cor-acc1-value
     4969         tt-fin-doc.cor-acc-value
     4970         B-cor-acc
     4971         tt-fin-doc.an-uchet-value
     4972         B-an-uchet
     4973         tt-fin-doc.cel-nazn-value
     4974         B-cel-nazn
     4975         WITH FRAME Dialog-Frame.
     4976       end.
     4977     end.
     4978     when "brief":U then do:
     4979        assign
     4980        v-tab-order = "b-exit,b-quit,b-tax,b-cards,b-print,b-hist,b-help," +                             "prn-doc-code,doc-date,obj-type,obj-code,b-obj,b-receiver-view," +                              v-sum-curr-tab-order +                            "payer-type,payer-code,b-payer,payer-name,b-payer-view,naznach-plat," +                            "PS,payer-sign1,receiver-sign1"
     4981        .
     4982     end.
     4983     when "contract":U then do:
     4984       assign
     4985       v-tab-order = "b-exit,b-quit,b-tax,b-cards,b-print,b-hist,b-help," +                               "prn-doc-code,doc-date,obj-type,obj-code,b-obj,b-receiver-view," +                                v-contract-tab-order + v-sum-curr-tab-order +                                "payer-type,payer-code,b-payer,payer-name,b-payer-view,naznach-plat," +                                 "PS,payer-sign1,receiver-sign1"
     4986       .
     4987       display
     4988       b-contract-view
     4989       f-contract-date when tt-fin-doc.contract-code <> 0
     4990       f-contract-prn-code when tt-fin-doc.contract-code <> 0
     4991       f-contract-type when tt-fin-doc.contract-code <> 0
     4992       f-contract-curr-abbr when tt-fin-doc.contract-code <> 0
     4993       tt-fin-doc.contract-curr when tt-fin-doc.contract-code <> 0
     4994       with frame Dialog-Frame
     4995       .
     4996       ENABLE
     4997       b-contract-view
     4998       with frame Dialog-Frame.
     4999     end.
     5000   END CASE.
     5001   END PROCEDURE.
     5002   PROCEDURE disable_UI :
     5003     HIDE FRAME Dialog-Frame.
     5004   END PROCEDURE.
     5005   PROCEDURE enable_UI :
     5006     OPEN QUERY Dialog-Frame FOR EACH locked_fin-doc SHARE-LOCK.
     5007     GET FIRST Dialog-Frame.
     5008     DISPLAY RS-view f-cor-acc1-descr f-cel-nazn-descr f-contract-curr-abbr
     5009             f-contract-prn-code f-contract-date f-contract-type f-cor-acc-descr
     5010             f-an-uchet-descr f-rest-con-sum F-curr-abbr F-debet F-credit
     5011         WITH FRAME Dialog-Frame.
     5012     IF AVAILABLE tt-fin-doc THEN
     5013       DISPLAY tt-fin-doc.perm-date tt-fin-doc.prn-doc-code tt-fin-doc.fin-doc-code
     5014             tt-fin-doc.user-name-perm tt-fin-doc.doc-date tt-fin-doc.user-name-doc
     5015             tt-fin-doc.obj-type tt-fin-doc.obj-code tt-fin-doc.fact-date
     5016             tt-fin-doc.user-name-fact tt-fin-doc.receiver-type
     5017             tt-fin-doc.receiver-okpo tt-fin-doc.receiver-name
     5018             tt-fin-doc.receiver-code tt-fin-doc.str-podr-type
     5019             tt-fin-doc.str-podr-code tt-fin-doc.str-podr-name
     5020             tt-fin-doc.cor-acc1-value tt-fin-doc.cel-nazn-value
     5021             tt-fin-doc.contract-curr tt-fin-doc.cor-acc-value
     5022             tt-fin-doc.an-uchet-value tt-fin-doc.sum-doc tt-fin-doc.curr-code
     5023             tt-fin-doc.exch-rate tt-fin-doc.exch-scale tt-fin-doc.sum-rubl
     5024             tt-fin-doc.base-rate tt-fin-doc.base-scale tt-fin-doc.sum-base
     5025             tt-fin-doc.contract-rate tt-fin-doc.contract-scale
     5026             tt-fin-doc.sum-contr tt-fin-doc.payer-type tt-fin-doc.payer-code
     5027             tt-fin-doc.payer-name tt-fin-doc.naznach-plat tt-fin-doc.PS
     5028             tt-fin-doc.payer-sign1 tt-fin-doc.receiver-sign1
     5029         WITH FRAME Dialog-Frame.
     5030     ENABLE B-exit b-quit B-tax B-cards B-print B-hist B-Help RS-view
     5031            tt-fin-doc.prn-doc-code tt-fin-doc.doc-date tt-fin-doc.user-name-doc
     5032            tt-fin-doc.obj-type tt-fin-doc.obj-code B-obj B-receiver-view
     5033            tt-fin-doc.str-podr-type tt-fin-doc.str-podr-code
     5034            tt-fin-doc.str-podr-name tt-fin-doc.cor-acc1-value B-cor-acc1
     5035            tt-fin-doc.cel-nazn-value B-cel-nazn f-contract-curr-abbr
     5036            B-contract-view tt-fin-doc.contract-curr tt-fin-doc.cor-acc-value
     5037            B-cor-acc tt-fin-doc.an-uchet-value B-an-uchet tt-fin-doc.sum-doc
     5038            f-rest-con-sum tt-fin-doc.curr-code B-currency B-calc
     5039            tt-fin-doc.exch-rate tt-fin-doc.exch-scale tt-fin-doc.sum-rubl
     5040            tt-fin-doc.sum-base tt-fin-doc.contract-rate tt-fin-doc.contract-scale
     5041            tt-fin-doc.sum-contr B-payer tt-fin-doc.payer-type
     5042            tt-fin-doc.payer-code tt-fin-doc.payer-name B-payer-view
     5043            tt-fin-doc.naznach-plat tt-fin-doc.PS tt-fin-doc.payer-sign1
     5044            tt-fin-doc.receiver-sign1
     5045         WITH FRAME Dialog-Frame.
     5046     VIEW FRAME Dialog-Frame.
     5047   END PROCEDURE.
     5048   PROCEDURE fill-main-table :
     5049   define variable vss-include-info56 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5050   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
     5051     (output v-db-num
     5052     )  .
     5053   define variable vss-include-info57 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5054   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     5055     (input  p-host-code
     5056     ,output v-base-code
     5057     )  .
     5058     for each tt-fin-doc:
     5059       delete tt-fin-doc.
     5060     end.
     5061     for each tt0-fin-doc-attr:
     5062       delete tt0-fin-doc-attr.
     5063     end.
     5064     for each tt0-fin-doc-tax:
     5065       delete tt0-fin-doc-tax.
     5066     end.
     5067   if p-mode = 'ИЗМЕНЕНИЕ':U
     5068   or p-mode = 'ПРОСМОТР':U
     5069   or p-mode = 'КОПИРОВАНИЕ':U
     5070   then do:
     5071     if p-mode = 'ИЗМЕНЕНИЕ':U then do:
     5072       find first locked_fin-doc EXclusive-lock where
     5073                     recid(locked_fin-doc) = p-doc-rec no-wait no-error.
     5074       if locked locked_fin-doc then do:
     5075         message
     5076         substitute("Запись &1 занята", p-fin-doc-code)
     5077         view-as alert-box error .
     5078         undo, return error.
     5079       end.
     5080     end.
     5081     else do:
     5082       find first locked_fin-doc no-lock where
     5083                   recid(locked_fin-doc) = p-doc-rec no-error .
     5084         if not available locked_fin-doc then do:
     5085           find first locked_fin-doc no-lock where
     5086                       locked_fin-doc.host-code = p-host-code
     5087                   AND locked_fin-doc.fin-doc-code = p-fin-doc-code no-error .
     5088         end.
     5089     end.
     5090     if not available locked_fin-doc then do:
     5091       message
     5092       substitute("&1 &2 &3&4 Не найдена запись &5"
     5093                   ,vss-workfile
     5094                   ,vss-revision
     5095                   ,vss-description
     5096                   ,chr(10)
     5097                   ,p-fin-doc-code)
     5098       view-as alert-box error .
     5099       undo, return error.
     5100     end.
     5101     if p-mode = 'ИЗМЕНЕНИЕ':U
     5102     AND not (locked_fin-doc.status_ = 'новый':U
     5103               or locked_fin-doc.status_ = 'разрешен':U )
     5104     then do:
     5105       message
     5106       substitute("Финансовый документ &1 находится в статусе &2&3Изменение невозможно"
     5107                 ,p-fin-doc-code
     5108                 ,locked_fin-doc.status_
     5109                 ,chr(10))
     5110       view-as alert-box error .
     5111       undo, return error.
     5112     end.
     5113     create tt-fin-doc.
     5114     if p-mode = 'КОПИРОВАНИЕ':U then do:
     5115       buffer-copy locked_fin-doc
     5116       using
     5117       obj-type
     5118       obj-code
     5119       payer-type
     5120       payer-code
     5121       receiver-type
     5122       receiver-code
     5123       receiver-name
     5124       receiver-sign1
     5125       receiver-okpo
     5126       payer-name
     5127       payer-sign1
     5128       an-uchet-code
     5129       an-uchet-value
     5130       cel-nazn-code
     5131       cel-nazn-value
     5132       contract-code
     5133       contract-curr
     5134       cor-acc-value
     5135       cor-acc1-value
     5136       cor-acc1
     5137       cor-acc
     5138       curr-code
     5139       naznach-plat
     5140       str-podr-code
     5141       str-podr-name
     5142       str-podr-type
     5143       sum-doc
     5144       CashBookId
     5145       to tt-fin-doc
     5146       assign
     5147       tt-fin-doc.host-code = p-host-code
     5148       .
     5149     end.
     5150     else do:
     5151       buffer-copy locked_fin-doc to tt-fin-doc.
     5152     end.
     5153   end.
     5154   if p-mode = 'ДОБАВЛЕНИЕ':U
     5155   or p-mode = 'КОПИРОВАНИЕ':U then do:
     5156     run ref/finfnoco.p (
     5157                     INPUT parParentProc
     5158                   ,INPUT this-procedure:handle
     5159                   ,input p-curr-host-code
     5160                   ,input p-mode  + chr(4) + 'manual':U
     5161                   ,input p-host-code
     5162                   ,input p-doc-rec
     5163                   ,input p-fin-doc-code
     5164                   ,input 'апп':U
     5165                   ,input 'апп':U
     5166                   ,input p-obj-type
     5167                   ,input p-obj-code
     5168                   ,input p-contract-code
     5169                   ,input p-ob-doc-code
     5170                   ,input p-payer-type
     5171                   ,input p-payer-code
     5172                   ,input 0
     5173                   ,input 'орг':U
     5174                   ,input p-host-code
     5175                   ,input 0
     5176                   ,input p-curr-code
     5177                   ,input p-cor-acc
     5178                   ,input p-cor-acc1
     5179                   ,input p-an-uchet-code
     5180                   ,input p-cel-nazn-code
     5181                   ,input (if available tt-fin-doc then tt-fin-doc.CashBookId else 0)
     5182                   ,input ""
     5183                   ,INPUT-OUTPUT table tt-fin-doc
     5184                   ,INPUT-OUTPUT table ttc-fin-doc
     5185                   ,output table tt0-fin-doc-attr
     5186                   ,output v-limit-access ) no-error .
     5187   end.
     5188   else do:
     5189     run ref/finfnoco.p (
     5190                     INPUT parParentProc
     5191                   ,INPUT this-procedure:handle
     5192                   ,input p-curr-host-code
     5193                   ,input p-mode  + chr(4) + 'manual':U
     5194                   ,input p-host-code
     5195                   ,input p-doc-rec
     5196                   ,input tt-fin-doc.fin-doc-code
     5197                   ,input 'апп':U
     5198                   ,input tt-fin-doc.fin-ext-doc-type
     5199                   ,input tt-fin-doc.obj-type
     5200                   ,input tt-fin-doc.obj-code
     5201                   ,input tt-fin-doc.contract-code
     5202                   ,input p-ob-doc-code
     5203                   ,input tt-fin-doc.payer-type
     5204                   ,input tt-fin-doc.payer-code
     5205                   ,input 0
     5206                   ,input 'орг':U
     5207                   ,input p-host-code
     5208                   ,input 0
     5209                   ,input tt-fin-doc.curr-code
     5210                   ,input tt-fin-doc.cor-acc
     5211                   ,input tt-fin-doc.cor-acc1
     5212                   ,input tt-fin-doc.an-uchet-code
     5213                   ,input tt-fin-doc.cel-nazn-code
     5214                   ,input tt-fin-doc.CashBookId
     5215                   ,input ""
     5216                   ,INPUT-OUTPUT table ttc-fin-doc
     5217                   ,INPUT-OUTPUT table tt-fin-doc
     5218                   ,output table tt0-fin-doc-attr
     5219                   ,output v-limit-access ) no-error .
     5220   end.
     5221   if error-status:error then do:
     5222     if not return-value = "exit" then do:
     5223       message
     5224       vss-workfile vss-revision vss-description skip
     5225       error-status:get-message(1) skip
     5226       return-value
     5227       view-as alert-box .
     5228     end.
     5229     undo, return error.
     5230   end.
     5231   find first tt-fin-doc.
     5232   run recalc in this-procedure ( input "curr-code":U).
     5233   if p-mode = 'КОПИРОВАНИЕ':U then do:
     5234     assign
     5235     v-copy-mode = yes
     5236     p-mode = 'ДОБАВЛЕНИЕ':U.
     5237     if tt-fin-doc.curr-code = 0  then
     5238     run recalc in this-procedure ( input "sum-doc").
     5239   end.
     5240   END PROCEDURE.
     5241   PROCEDURE Myenable :
     5242   define variable g-log as logical no-undo.
     5243   define variable v-inn like ub.firm.inn no-undo .
     5244   define variable v-kpp like ub.firm.kpp no-undo .
     5245   assign
     5246       tt-fin-doc.sum-rubl :label in frame Dialog-Frame = "Рубли"
     5247   .
     5248   run uf-get in this-procedure(
     5249       input  ('findoci-p':U + chr(4) + 'апп':U)
     5250       ,input  g#userid
     5251       ,output v-uf-List_
     5252       ,output v-uf-Naim
     5253       ,output v-uf-print-graft
     5254       ,output v-uf-sort-gr
     5255       ,output v-uf-type-price
     5256       ,output v-uf-type-val
     5257   )  no-error.
     5258   if not error-status:error
     5259   and not v-uf-LIst_ = "":U
     5260   then do:
     5261       assign
     5262       v-view =  entry(1, v-uf-List_, chr(4))
     5263       .
     5264   end.
     5265   assign
     5266   frame Dialog-Frame:title = frame Dialog-Frame:title + chr(32) + x_clients-host.obj-name
     5267   tt-fin-doc.payer-type:radio-buttons = "Орг" + chr(44) + 'орг':U + chr(44) +
     5268                                         "Чел" + chr(44) + 'чел':U
     5269   rs-view:radio-buttons = "&Полн." + chr(44) + "full":U +  chr(44) +
     5270                                       "&Сокращ." + chr(44) + "brief":U + chr(44) +
     5271                                       "&Дог-р" + chr(44) + "contract":U
     5272   tt-fin-doc.obj-type:radio-buttons = "Маг" + chr(44) + 'маг':U + chr(44) +
     5273                                       "Скл" + chr(44) + 'скл':U
     5274   rs-view = v-view
     5275   v-an-uchet-tab-order = (if X_sysconf.is-cassa-acc then "cor-acc1-value,b-cor-acc1," else "":U) +
     5276                          (if X_sysconf.is-code-cel-nazn then "cel-nazn-value,b-cel-nazn," else "":U) +
     5277                          (if X_sysconf.is-corr-acc then "cor-acc-value,b-cor-acc," else "":U) +
     5278                          (if X_sysconf.is-an-uchet then "an-uchet-value,b-an-uchet," else "":U)
     5279   v-an-uchet-tab-order = "cor-acc1-value,b-cor-acc1," +
     5280                          "cel-nazn-value,b-cel-nazn,"  +
     5281                          "cor-acc-value,b-cor-acc,"   +
     5282                          "an-uchet-value,b-an-uchet,"
     5283   v-limit-access = (if p-mode = 'ПРОСМОТР':U then 10 else v-limit-access)
     5284   tt-fin-doc.obj-type:screen-value  = (if tt-fin-doc.obj-type = 'маг':U
     5285                                       or tt-fin-doc.obj-type = 'скл':U
     5286                                       then tt-fin-doc.obj-type
     5287                                       else tt-fin-doc.obj-type:screen-value)
     5288   .
     5289   if p-mode = 'ПРОСМОТР':U and
     5290   tt-fin-doc.contract-code = 0 then do:
     5291       assign
     5292       g-log = rs-view:disable(radio-label("contract":U, RS-view:radio-buttons))
     5293       .
     5294       if rs-view = "contract":U then
     5295       assign
     5296       rs-view = "full":U
     5297       v-not-uf-set = yes.
     5298   end.
     5299   find first X_currency no-lock where
     5300                 X_currency.curr-code = tt-fin-doc.curr-code.
     5301   assign
     5302   f-curr-abbr = X_Currency.curr-abbr.
     5303   if p-mode = 'ДОБАВЛЕНИЕ':U and tt-fin-doc.contract-code = 0 then do:
     5304     assign
     5305     tt-fin-doc.payer-type = (if tt-fin-doc.payer-type = "":U then 'орг':U else tt-fin-doc.payer-type)
     5306     .
     5307   end.
     5308   assign
     5309   v-head-position = (if num-entries(tt-fin-doc.receiver-sign1, chr(4)) > 1
     5310                       then entry(1, tt-fin-doc.receiver-sign1, chr(4))
     5311                       else "":U)
     5312   tt-fin-doc.receiver-sign1:label  = tt-fin-doc.receiver-sign1:label  + " - ":U +
     5313                             v-head-position
     5314   tt-fin-doc.receiver-sign1 =   (if num-entries(tt-fin-doc.receiver-sign1, chr(4)) > 1
     5315                                     then entry(2, tt-fin-doc.receiver-sign1, chr(4))
     5316                                     else entry(1, tt-fin-doc.receiver-sign1, chr(4)))
     5317   .
     5318   if p-mode = 'ПРОСМОТР':U then do:
     5319       run proc-color-widgets in this-procedure("f-an-uchet-descr,f-cel-nazn-descr,f-contract-curr-abbr,f-contract-date,f-contract-prn-code,f-contract-rate," +                         "f-contract-scale,f-contract-type,f-cor-acc1-descr,f-cor-acc-descr,base-rate,base-scale,curr-code,exch-rate,exch-scale," +                         "fact-date,fin-doc-code,payer-code,payer-type,perm-date,PS,receiver-code,receiver-type,sum-base,sum-rubl," +                         "user-name-doc,user-name-fact,user-name-perm", no, yes, ?, ?).
     5320       run proc-color-widgets in this-procedure("F-curr-abbr,an-uchet-value,cel-nazn-value,cor-acc1-value,cor-acc-value,doc-date," +                       "naznach-plat,payer-name,prn-doc-code,receiver-name,receiver-okpo,payer-sign1,receiver-sign1," +                       "str-podr-code,str-podr-name,str-podr-type,sum-doc", no, yes, ?, ?).
     5321   end.
     5322   display
     5323   tt-fin-doc.exch-rate
     5324   tt-fin-doc.exch-scale
     5325   tt-fin-doc.sum-doc
     5326   (tt-fin-doc.sum-contr - tt-fin-doc.con-sum-contr ) @ f-rest-con-sum
     5327   tt-fin-doc.prn-doc-code
     5328   tt-fin-doc.payer-name
     5329   tt-fin-doc.naznach-plat
     5330   tt-fin-doc.payer-sign1
     5331   tt-fin-doc.receiver-sign1
     5332   tt-fin-doc.PS
     5333   with frame Dialog-Frame
     5334   .
     5335   if tt-fin-doc.contract-code <> 0 then do:
     5336       find first X_contract-currency no-lock where
     5337                 X_contract-currency.curr-code = tt-fin-doc.contract-curr .
     5338       assign
     5339       f-contract-prn-code = X_contract.contract-prn-code
     5340       f-contract-date     = X_contract.contract-date
     5341       f-contract-type     = X_contract.contract-type
     5342       f-contract-curr-abbr = X_contract-currency.curr-abbr
     5343       .
     5344   end.
     5345   run change-view in this-procedure(rs-view).
     5346   VIEW FRAME Dialog-Frame.
     5347   if p-mode <> 'ПРОСМОТР':U then APPLY "ENTRY" to tt-fin-doc.prn-doc-code.
     5348   END PROCEDURE.
     5349   PROCEDURE proc-save :
     5350   define input parameter p-save as logical no-undo .
     5351   if p-mode = 'ПРОСМОТР':U or not available tt-fin-doc then do:
     5352       return error.
