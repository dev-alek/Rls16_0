     3753   ON LEAVE OF tt-fin-doc.curr-code IN FRAME Dialog-Frame
     3754     DO:
     3755       define variable v-curr-code like ub.fin-doc.curr-code no-undo.
     3756   define variable vss-include-info42 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3757   if lookup(self :type
     3758            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     3759            ) = 0
