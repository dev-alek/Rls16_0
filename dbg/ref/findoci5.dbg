     3345   ON CHOOSE OF B-currency IN FRAME Dialog-Frame
     3346     DO:
     3347       define variable rr          as recid no-undo.
     3348       define variable v-curr-code like ub.fin-doc.curr-code no-undo.
     3349   define variable vss-include-info33 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3350   if lookup(self :type
     3351            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     3352            ) = 0
     3353   then do:
