     2701   find first X_fin-code-cor-acc no-lock where X_fin-code-cor-acc.code-value = tt-fin-doc.cor-acc-value
     2702     and X_fin-code-cor-acc.host-code = tt-fin-doc.host-code
     2703     and X_fin-code-cor-acc.status_ = integer('0':U)
     2704     no-error .
     2705   if available X_fin-code-cor-acc
