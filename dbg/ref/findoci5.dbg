     3772       return no-apply .
     3773     end.
     3774   end.
     3775   assign
     3776     v-curr-code = tt-fin-doc.curr-code
     3777     tt-fin-doc.curr-code.
     3778   FIND FIRST X_currency WHERE
     3779     X_currency.curr-code = tt-fin-doc.curr-code NO-LOCK NO-error.
     3780   if not available X_currency then
     3781   do:
     3782     message
     3783       "Нет валюты с кодом"   tt-fin-doc.curr-code
     3784       view-as alert-box error.
     3785     assign
     3786       tt-fin-doc.curr-code = v-curr-code.
     3787     display
     3788       tt-fin-doc.curr-code
     3789       with frame Dialog-Frame.
     3790     .
     3791   end.
     3792   else
     3793   do:
     3794     assign
     3795       f-curr-abbr = X_currency.curr-abbr
     3796       .
     3797     display
     3798       f-curr-abbr
     3799       tt-fin-doc.curr-code
     3800       with frame Dialog-Frame.
     3801     .
     3802     if tt-fin-doc.curr-code <> v-curr-code then
     3803     do:
     3804       run recalc in this-procedure("curr-code":U) no-error.
     3805       if error-status:error then
     3806       do:
     3807         assign
     3808           tt-fin-doc.curr-code = v-curr-code
     3809           .
     3810         display tt-fin-doc.curr-code
     3811           with frame Dialog-Frame.
     3812       end.
     3813       run hide-view-currency in this-procedure .
     3814     end.
     3815   end.
     3816   END.
     3817   ON LEAVE OF tt-fin-doc.doc-date IN FRAME Dialog-Frame
     3818     DO:
     3819   define variable vss-include-info43 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3820   if lookup(self :type
     3821            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     3822            ) = 0
     3823   then do:
