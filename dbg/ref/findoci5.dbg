     3905   PROCEDURE check-sums-rate :
     3906     define variable v-exch-rate  like ub.fin-doc.sum-doc no-undo .
     3907     define variable v-exch-scale like ub.fin-doc.sum-doc no-undo .
     3908   END PROCEDURE.
     3909   PROCEDURE disable-enable :
     3910     define input parameter p-main-widget as character no-undo.
     3911     define input parameter p-main-curr as character no-undo .
     3912     disable
     3913       tt-fin-doc.sum-doc
     3914       tt-fin-doc.sum-rubl
     3915       tt-fin-doc.sum-base
     3916       tt-fin-doc.base-rate
     3917       tt-fin-doc.base-scale
     3918       tt-fin-doc.exch-rate
     3919       tt-fin-doc.exch-scale
     3920       tt-fin-doc.sum-contr
     3921       tt-fin-doc.contract-rate
     3922       tt-fin-doc.contract-scale
     3923       with frame Dialog-Frame .
     3924     assign
     3925       v-main-sum  = if p-main-widget <> "":U then p-main-widget else v-main-sum
     3926       v-main-curr = if p-main-curr <> "":U then p-main-curr else v-main-curr
     3927       .
     3928     if v-limit-access > 0 then
     3929     do:
     3930       display
     3931         tt-fin-doc.sum-rubl
     3932         when v-rubf
     3933         tt-fin-doc.sum-base
     3934         when v-basef
     3935         tt-fin-doc.exch-rate
     3936         when v-exchf
     3937         tt-fin-doc.exch-scale
     3938         when v-exchf
     3939         tt-fin-doc.base-rate
     3940         when v-basef
     3941         tt-fin-doc.base-scale
     3942         when v-basef
     3943         tt-fin-doc.sum-contr
     3944         when v-contractf
     3945         tt-fin-doc.contract-rate
     3946         when v-contractratef
     3947         tt-fin-doc.contract-scale
     3948         when v-contractratef
     3949         with frame Dialog-Frame.
     3950       return.
     3951     end.
     3952     CASE p-main-widget:
     3953       when "sum-doc" then
     3954         do:
     3955           enable
     3956             tt-fin-doc.sum-doc
     3957             with frame Dialog-Frame.
     3958           APPLY "ENTRY" to tt-fin-doc.sum-doc.
     3959         end.
     3960     END CASE.
     3961     display
     3962       tt-fin-doc.sum-rubl
     3963       when v-rubf
     3964       tt-fin-doc.sum-base
     3965       when v-basef
     3966       tt-fin-doc.exch-rate
     3967       when v-exchf
     3968       tt-fin-doc.exch-scale
     3969       when v-exchf
     3970       tt-fin-doc.base-rate
     3971       when v-basef
     3972       tt-fin-doc.base-scale
     3973       when v-basef
     3974       tt-fin-doc.sum-contr
     3975       when v-contractf
     3976       tt-fin-doc.contract-rate
     3977       when v-contractratef
     3978       tt-fin-doc.contract-scale
     3979       when v-contractratef
     3980       with frame Dialog-Frame.
     3981     CASE rs-view:
     3982       when "full":u then
     3983         do:
     3984           assign
     3985             v-tab-order = "b-exit,b-quit,b-tax,b-cards,b-print,b-hist,b-help," +                            "prn-doc-code,doc-date,obj-type,obj-code,b-obj,b-receiver-view,str-podr-type,str-podr-code,str-podr-name," +                             v-an-uchet-tab-order +  v-sum-curr-tab-order +                            "payer-type,payer-code,b-payer,payer-name,b-payer-view,naznach-plat," +                            "PS,payer-sign1,receiver-sign1"
     3986             .
     3987         end.
     3988       when "brief":u then
     3989         do:
     3990           assign
     3991             v-tab-order = "b-exit,b-quit,b-tax,b-cards,b-print,b-hist,b-help," +                             "prn-doc-code,doc-date,obj-type,obj-code,b-obj,b-receiver-view," +                              v-sum-curr-tab-order +                            "payer-type,payer-code,b-payer,payer-name,b-payer-view,naznach-plat," +                            "PS,payer-sign1,receiver-sign1"
     3992             .
     3993         end.
     3994       when "contract":u then
     3995         do:
     3996           assign
     3997             v-tab-order = "b-exit,b-quit,b-tax,b-cards,b-print,b-hist,b-help," +                               "prn-doc-code,doc-date,obj-type,obj-code,b-obj,b-receiver-view," +                                v-contract-tab-order + v-sum-curr-tab-order +                                "payer-type,payer-code,b-payer,payer-name,b-payer-view,naznach-plat," +                                 "PS,payer-sign1,receiver-sign1"
     3998             .
     3999         end.
     4000     END CASE.
     4001   END PROCEDURE.
     4002   define new global shared variable g#lib-farh as handle no-undo .
     4003   PROCEDURE fill-tables :
     4004     define buffer buf_fin-doc-tax  for ub.fin-doc-tax.
     4005     define buffer buf_fin-doc-attr for ub.fin-doc-attr.
     4006     define buffer buf_fin-ob-tax   for ub.fin-ob-tax.
     4007     define buffer buf_fin-connect  for ub.fin-connect.
     4008     define buffer buf_fin-ob       for ub.fin-ob.
     4009     define buffer buf_payment      for ub.payment.
     4010     if p-mode = 'ДОБАВЛЕНИЕ':U
     4011       AND p-ob-doc-code <> "" then
     4012     do:
     4013       for each buf_fin-ob-tax no-lock where
     4014         buf_fin-ob-tax.host-code = tt-fin-doc.fin-doc-code
     4015         AND buf_fin-ob-tax.doc-code = p-ob-doc-code:
     4016         create tt0-fin-doc-tax.
     4017         buffer-copy buf_fin-ob-tax to tt0-fin-doc-tax.
     4018       end.
     4019       return.
     4020     end.
     4021     if p-mode = 'ДОБАВЛЕНИЕ':U
     4022       and v-copy-mode = yes then
     4023     do:
     4024       for each buf_fin-doc-tax no-lock where
     4025         buf_fin-doc-tax.host-code = locked_fin-doc.host-code
     4026         AND buf_fin-doc-tax.fin-doc-code = locked_fin-doc.fin-doc-code
     4027         :
     4028         create tt0-fin-doc-tax.
     4029         buffer-copy buf_fin-doc-tax except fin-doc-code to tt0-fin-doc-tax
     4030           assign
     4031           tt0-fin-doc-tax.fin-doc-code = tt-fin-doc.fin-doc-code
     4032           .
     4033       end.
     4034       for each buf_payment no-lock where
     4035         buf_payment.source-type = 'платеж':U
     4036         AND buf_payment.source-ref = string(locked_fin-doc.fin-doc-code)
     4037         :
     4038         create tt0-payment.
     4039         buffer-copy buf_payment except source-ref to tt0-payment
     4040           assign
     4041           tt0-payment.source-ref = string(tt-fin-doc.fin-doc-code)
     4042           .
     4043       end.
     4044       for each buf_fin-doc-attr no-lock where
     4045         buf_fin-doc-attr.host-code = locked_fin-doc.host-code
     4046         AND buf_fin-doc-attr.fin-doc-code = locked_fin-doc.fin-doc-code
     4047         :
     4048         create tt0-fin-doc-attr.
     4049         buffer-copy buf_fin-doc-attr to tt0-fin-doc-attr
     4050           assign
     4051           tt0-fin-doc-attr.fin-doc-code = tt-fin-doc.fin-doc-code
     4052           .
     4053       end.
     4054     end.
     4055     else
     4056     do:
     4057       for each buf_fin-doc-tax no-lock where
     4058         buf_fin-doc-tax.host-code = tt-fin-doc.host-code
     4059         AND buf_fin-doc-tax.fin-doc-code = tt-fin-doc.fin-doc-code
     4060         :
     4061         create tt0-fin-doc-tax.
     4062         buffer-copy buf_fin-doc-tax to tt0-fin-doc-tax.
     4063       end.
     4064       for each buf_payment no-lock where
     4065         buf_payment.source-type = 'платеж':U
     4066         AND buf_payment.source-ref = string(tt-fin-doc.fin-doc-code)
     4067         :
     4068         create tt0-payment.
     4069         buffer-copy buf_payment to tt0-payment.
     4070       end.
     4071       for each buf_fin-doc-attr no-lock where
     4072         buf_fin-doc-attr.host-code = tt-fin-doc.host-code
     4073         AND buf_fin-doc-attr.fin-doc-code = tt-fin-doc.fin-doc-code
     4074         :
     4075         create tt0-fin-doc-attr.
     4076         buffer-copy buf_fin-doc-attr to tt0-fin-doc-attr.
     4077       end.
     4078       for each tt0-fin-doc-attr no-lock where
     4079         tt0-fin-doc-attr.host-code = tt-fin-doc.host-code
     4080         AND tt0-fin-doc-attr.fin-doc-code = tt-fin-doc.fin-doc-code
     4081         :
     4082       end.
     4083     end.
     4084   if (valid-handle(g#lib-farh) <> true) then do:   run str/lib-farh.p persistent no-error .   if error-status :error or (valid-handle(g#lib-farh) <> true) then do:     message       "Error starting lib-farh.p" skip       g#lib-farh skip       g#lib-farh :type skip       g#lib-farh :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-farh_fautoobj in g#lib-farh
     4085   (input tt-fin-doc.host-code
     4086   ,input tt-fin-doc.fin-doc-code
     4087   ,output v-is-auto-obj
     4088   )
     4089   .
     4090     if getCliKassa(tt-fin-doc.payer-type, tt-fin-doc.payer-code, "Vnecli", tt-fin-doc.cashbookId) then paramVne = "vne" .
     4091     else if getCliKassa(tt-fin-doc.payer-type, tt-fin-doc.payer-code, "Avanscli", tt-fin-doc.cashbookId) then paramVne = "avans" .
     4092     else paramVne = "" .
     4093     run proc-update-sum-vat-chr in this-procedure (input-output v-start).
     4094   END PROCEDURE.
     4095   PROCEDURE hide-view-currency :
     4096     define buffer buf_currency for ub.currency.
     4097     assign
     4098       v-rubf          = no
     4099       v-exchf         = no
     4100       v-basef         = no
     4101       v-baseratef     = no
     4102       v-contractf     = no
     4103       v-contractratef = no
     4104       .
     4105     hide
     4106       tt-fin-doc.sum-rubl in frame Dialog-Frame
     4107       tt-fin-doc.exch-rate
     4108       tt-fin-doc.exch-scale
     4109       tt-fin-doc.sum-base
     4110       tt-fin-doc.base-rate
     4111       tt-fin-doc.base-scale
     4112       tt-fin-doc.sum-contr
     4113       tt-fin-doc.contract-rate
     4114       tt-fin-doc.contract-scale
     4115       in frame Dialog-Frame .
     4116     if tt-fin-doc.curr-code <> 0 then
     4117     do:
     4118       if tt-fin-doc.curr-code:visible then
     4119         display
     4120           tt-fin-doc.exch-rate
     4121           tt-fin-doc.exch-scale
     4122           tt-fin-doc.sum-rubl
     4123           with frame Dialog-Frame.
     4124       assign
     4125         v-rubf  = yes
     4126         v-exchf = yes
     4127         .
     4128     end.
     4129     if v-base-code <> tt-fin-doc.curr-code
     4130       and v-base-code <> 0
     4131       then
     4132     do:
     4133       find first buf_currency no-lock where
     4134         buf_currency.curr-code = v-base-code .
     4135       assign
     4136         tt-fin-doc.sum-base:label = "Б.в.("  + buf_currency.curr-abbr + ")":U
     4137         .
     4138       if tt-fin-doc.curr-code:visible then
     4139         display
     4140           tt-fin-doc.base-rate
     4141           tt-fin-doc.base-scale
     4142           tt-fin-doc.sum-base
     4143           with frame Dialog-Frame.
     4144       assign
     4145         v-basef     = yes
     4146         v-baseratef = yes
     4147         .
     4148     end.
     4149     if tt-fin-doc.contract-code  <> 0 and
     4150       (tt-fin-doc.contract-curr <> 0
     4151       and tt-fin-doc.contract-curr <> tt-fin-doc.curr-code
     4152       and tt-fin-doc.contract-curr <> v-base-code
     4153       )
     4154       then
     4155     do:
     4156       find first buf_currency no-lock where
     4157         buf_currency.curr-code = tt-fin-doc.contract-curr .
     4158       assign
     4159         tt-fin-doc.sum-contr:label = "Вал.дог.("  + buf_currency.curr-abbr + ")":U
     4160         .
     4161       if tt-fin-doc.curr-code:visible then
     4162         display
     4163           tt-fin-doc.sum-contr
     4164           tt-fin-doc.contract-rate
     4165           tt-fin-doc.contract-scale
     4166           with frame Dialog-Frame.
     4167       assign
     4168         v-contractf     = yes
     4169         v-contractratef = yes
     4170         .
     4171     end.
     4172     assign
     4173       v-sum-curr-tab-order = v-sum-doc-tab-order
     4174       .
     4175     run disable-enable in this-procedure (v-main-sum, v-main-curr).
     4176   END PROCEDURE.
