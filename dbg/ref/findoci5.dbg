      145   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      146   define variable v-waitfram-action01         as character   no-undo .
      147   define variable v-waitfram-action02         as character   no-undo .
      148   define variable v-waitfram-action03         as character   no-undo .
      149   define variable mWaitFramTextBeg            as character   no-undo.
      150   define variable mWaitFramTextEnd            as character   no-undo.
      151   define variable mWaitFramView               as logical     no-undo.
      152   define variable mWaitProcEvent              as logical     no-undo init yes.
      153   define variable mWaitFramInterval           as integer     no-undo init 1 .
      154   define variable mWaitFramStop               as logical     no-undo.
      155   define variable mWaitFramStopUser           as logical     no-undo.
      156   define variable mWaitFramStopTimeOut        as logical     no-undo.
      157   define variable mWaitFramStartProc          as datetime-tz no-undo.
      158   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      159   define button B-WaitFramStop auto-end-key
      160        label "Стоп"
      161        size 10 by 1 tooltip "Остоновить процесс".
      162   define button B-viewProcInfo
      163        label "Информация"
      164        size 15 by 1 tooltip "Информация о процесс".
      165   define frame waitfram
      166     v-waitfram-action01 format "x(72)" no-label skip
      167     v-waitfram-action02 format "x(72)" no-label skip
      168     v-waitfram-action03 format "x(72)" no-label skip
      169     B-viewProcInfo
      170     B-WaitFramStop at row 4 col 30
      171     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      172     .
      173   define new global shared variable mBatchMode as logical no-undo init ?.
      174   define variable mFramBachModHandle as handle no-undo.
      175   mFramBachModHandle = frame waitfram:handle.
      176   define variable mFameOldVis as logical no-undo.
      177   define variable mVisCUrentVin as logical no-undo.
      178   if session:batch-mode
      179   then
      180      mBatchMode = yes.
      181   if mBatchMode = ? then do:
      182     mVisCUrentVin = current-window:visible.
      183     mFameOldVis = mFramBachModHandle:visible.
      184     mFramBachModHandle:visible  = yes.
      185     mBatchMode = mFramBachModHandle:visible ne yes.
      186     mFramBachModHandle:visible = mFameOldVis.
      187     current-window:visible = mVisCUrentVin.
      188   end.
      189    if  log-manager:logfile-name ne ?
      190     then DO:
      191         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      192         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      193         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      194     end.
      195   on choose of B-WaitFramStop in frame waitfram
      196   do:
      197     mWaitFramStop = yes.
      198     mWaitFramStopUser = yes.
      199   end.
      200   function waitfram-check-timeout returns logical():
      201      define variable vtime as int64 no-undo.
      202      if mWaitFramStopTimeOut
      203      then
      204         return yes.
      205      vtime = ( now - mWaitFramStartProc ) / 1000 .
      206      if     mWaitFramTimeOut ne ?
      207         and mWaitFramTimeOut ne 0
      208         and mWaitFramTimeOut lt vtime
      209      then do:
      210         mWaitFramStopTimeOut = yes.
      211      end.
      212      return mWaitFramStopTimeOut.
      213   end.
      214   procedure waitfram-hide :
      215     if not session:batch-mode
      216     then do
      217     on error undo, return error return-value
      218     :
      219       pause 0 before-hide .
      220       if not mBatchMode then
      221         hide frame waitfram .
      222     if     not mWaitFramView
      223        and mWaitProcEvent
      224     then
      225       process events .
      226     end.
      227   end procedure.
      228   procedure waitfram-show :
      229     define input  parameter p-message as character no-undo .
      230     define variable v-left-margin as integer   no-undo .
      231     if not session:batch-mode
      232     then do
      233     on error undo, return error return-value
      234     :
      235       if length(p-message) <= 70 then do:
      236         assign
      237           v-left-margin = integer((70 - length(p-message)) / 2)
      238         .
      239         assign
      240           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      241         .
      242         assign
      243           v-waitfram-action01 = " "
      244           v-waitfram-action02 = " "
      245                                    + fill(" ", v-left-margin)
      246                                    + p-message
      247           v-waitfram-action03 = " "
      248         .
      249       end.
      250       else do:
      251         define variable vRindex1 as integer no-undo.
      252         define variable vRindex2 as integer no-undo.
      253         vRindex1 = r-index(p-message," ",70).
      254         if vRindex1 = 0
      255         then
      256            vRindex1 = 70.
      257         if length(p-message)  <= vRindex1 + 70 then do:
      258           assign
      259             v-waitfram-action01 = " "
      260             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      261             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      262           .
      263         end.
      264         else do:
      265           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      266           if vRindex2 <= vRindex1
      267           then
      268              vRindex2 = vRindex1 + 70.
      269           assign
      270             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      271             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      272             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      273           .
      274         end.
      275       end.
      276       B-viewProcInfo:visible   in frame waitfram = no.
      277       B-viewProcInfo:sensitive in frame waitfram = no.
      278       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      279       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      280       if  (   mWaitFramView
      281          or  mWaitProcEvent)
      282          and not mBatchMode
      283       then
      284          display
      285             v-waitfram-action01 skip
      286             v-waitfram-action02 skip
      287             v-waitfram-action03 skip
      288          with frame waitfram .
      289       if     mWaitFramView
      290          then do:
      291             if     mWaitFramInterval ne ?
      292                and not mBatchMode
      293             then
      294                wait-for go of frame waitfram pause mWaitFramInterval.
      295          end.
      296          else
      297             if     mWaitProcEvent
      298                and not mBatchMode
      299             then
      300                process events .
      301     end.
      302   end procedure.
      303      procedure waitfram-show-this:
      304         define input  parameter iInterval as int64 no-undo.
      305         define variable vtime as int64 no-undo.
      306         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      307         mWaitFramInterval = iInterval.
      308         run waitfram-show (substitute("&1&2 &3&4" ,
      309                                       mWaitFramTextBeg ,
      310                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      311                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      312                                       mWaitFramTextEnd
      313                                      )
      314                           ).
      315      end.
      316      procedure WaitFramRunPause:
      317         define input  parameter iInterval as dec no-undo.
      318         define variable vStart  as datetime-tz no-undo.
      319         define variable vend    as datetime-tz no-undo.
      320         define variable vint as int64 no-undo.
      321         define variable vOk as logical no-undo.
      322         vStart = now.
      323         vend   = vStart.
      324         publish "WaitFramPause" (iInterval,output vOk).
      325         vend   =  now.
      326         vint = vend - vStart.
      327         vint = iInterval - vint / 1000.
      328         if     not mWaitFramStop
      329            and (   vint > 0
      330                 or (    not vOk
      331                     and iInterval eq ?
      332                     )
      333                 )
      334         then
      335            run waitfram-show-this (iInterval).
      336         vend   =  now.
      337         vint = vend - vStart.
      338         vint = iInterval - vint / 1000.
      339         if     not mWaitFramStop
      340            and vint > 0
      341         then do:
      342            run gbl/pause.p (vint * 1000).
      343         end.
      344         if iInterval ne ?
      345         then
      346            publish "WaitFramStop".
      347         waitfram-check-timeout().
      348      end.
      349      procedure WaitFramWaitFor:
      350         define input  parameter iInterval as dec no-undo.
      351         assign
      352            mWaitFramStartProc   = now
      353            mWaitFramStopUser    = no
      354            mWaitFramStopTimeOut = no
      355         .
      356         block-wait:
      357         do while not mWaitFramStop:
      358            run WaitFramRunPause (iInterval).
      359            if  waitfram-check-timeout()
      360            then do:
      361               leave block-wait.
      362            end.
      363         end.
      364         run waitfram-hide.
      365      end.
      366   procedure waitfram-join :
      367     define input  parameter p-line-1  as character no-undo .
      368     define input  parameter p-line-2  as character no-undo .
      369     define input  parameter p-line-3  as character no-undo .
      370     define output parameter p-message as character no-undo .
      371     do
      372     on error undo, return error return-value
      373     :
      374       assign
      375         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      376                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      377                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      378       .
      379     end.
      380   end procedure.
      381   function waitfram-join-function returns character
      382     (input p-line-1 as character
      383     ,input p-line-2 as character
      384     ,input p-line-3 as character
      385     ).
      386     define variable v-message as character no-undo .
      387     run waitfram-join in this-procedure
      388       (input  p-line-1
      389       ,input  p-line-2
      390       ,input  p-line-3
      391       ,output v-message
      392       ) .
      393     return v-message .
      394   end function .
      395   procedure proc-alt-shift-f2:
      396     if not ibs.th.gbl.gbl-var:rcode
      397   then
      398     run gbl\inidebug.p .
      399   end.
      400   procedure proc-alt-shift-f3:
      401     run gbl/prvssinf.p
      402       ( input this-procedure
      403       ) .
      404   end.
      405   define variable v-inform-launched as logical no-undo initial false .
      406   procedure proc-alt-shift-f4:
      407     define variable v-action as character no-undo .
      408     if v-inform-launched = false then do:
      409       assign
      410         v-inform-launched = true
      411       .
      412       run gbl/d-inform.w
      413         (  input self
      414         ,  input this-procedure
      415         , output v-action
      416         ) no-error .
      417       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      418       assign
      419         v-inform-launched = false
      420       .
      421     end.
      422   end.
      423   procedure proc-alt-f1:
      424     run gbl/corrhelp.p
      425       (input this-procedure
      426       ) .
      427   end .
      428   on alt-shift-f2 anywhere do:
      429     run proc-alt-shift-f2.
      430   end.
      431   on alt-shift-f3 anywhere do:
      432     run proc-alt-shift-f3 in this-procedure .
      433   end.
      434   on alt-shift-f4 anywhere do:
      435     run proc-alt-shift-f4 in this-procedure.
      436   end.
      437   on alt-f1 anywhere do:
      438     run proc-alt-f1 in this-procedure .
      439   end.
      440   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      441   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      442   define variable v-uf-List_        like ubflt.usr-flt.List_        no-undo .
      443   define variable v-uf-Naim         like ubflt.usr-flt.Naim         no-undo .
      444   define variable v-uf-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
      445   define variable v-uf-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
      446   define variable v-uf-type-price   like ubflt.usr-flt.type-price   no-undo .
      447   define variable v-uf-type-val     like ubflt.usr-flt.type-val     no-undo .
      448   define temp-table usr-flt_custom-labels no-undo like ub.custom-labels.
      449   procedure uf-name :
      450     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
      451     define output parameter p-use-List_     as logical   no-undo .
      452     define output parameter p-type-List_     as character no-undo .
      453     define output parameter p-format-List_   as character no-undo .
      454     define output parameter p-use-Naim      as logical   no-undo .
      455     define output parameter p-type-Naim      as character no-undo .
      456     define output parameter p-format-Naim    as character no-undo .
      457     define output parameter p-use-print-graft as logical   no-undo .
      458     define output parameter p-use-sort-gr   as logical   no-undo .
      459     define output parameter p-use-type-price as logical   no-undo .
      460     define output parameter p-use-type-val  as logical   no-undo .
      461     define output parameter p-label          as character no-undo .
      462     define output parameter p-tooltip        as character no-undo .
      463     define output parameter p-user-can-edit  as logical   no-undo .
      464     define output parameter p-output-display as logical   no-undo .
      465     define output parameter p-other          as character no-undo .
      466     do
      467     on error undo, return error
      468     :
