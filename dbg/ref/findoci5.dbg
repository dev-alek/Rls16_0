     2591   PROCEDURE check-payer :
     2592     define buffer buf_clients for ub.clients.
     2593     find first buf_clients no-lock where
     2594       buf_clients.obj-code = input frame Dialog-Frame tt-fin-doc.payer-code
     2595       and buf_clients.obj-type = input frame Dialog-Frame tt-fin-doc.payer-type no-error.
     2596     if not available buf_clients then
     2597     do:
     2598       if input frame Dialog-Frame tt-fin-doc.payer-code <> ?  then
     2599         message "Неправильный код или тип " 'ПЛАТЕЛЬЩИКА'.
     2600       apply "entry" to tt-fin-doc.payer-code in frame Dialog-Frame.
     2601       return error.
     2602     end.
     2603     find first X_payer no-lock where recid(X_payer) = recid(buf_clients).
     2604     assign
     2605       tt-fin-doc.payer-type = buf_clients.obj-type
     2606       tt-fin-doc.payer-code = buf_clients.obj-code
     2607       tt-fin-doc.payer-name = buf_clients.obj-name
     2608       .
     2609   find first ub.CashBook no-lock where ub.CashBook.id = tt-fin-doc.cashbookId no-error .
     2610   if ub.CashBook.cli-code = tt-fin-doc.payer-code and ub.CashBook.cli-type = tt-fin-doc.payer-type then do:
     2611   assign
     2612     tt-fin-doc.cor-acc1-value = ub.CashBook.OsnAcct
     2613     tt-fin-doc.cor-acc-value  = ub.CashBook.corrPko
     2614     tt-fin-doc.naznach-plat   = ub.CashBook.RuleOsnPko
     2615     .
     2616   find first X_fin-code-cor-acc no-lock where X_fin-code-cor-acc.code-value = tt-fin-doc.cor-acc-value
     2617     and X_fin-code-cor-acc.host-code = tt-fin-doc.host-code
     2618     and X_fin-code-cor-acc.status_ = integer('0':U)
     2619     no-error .
     2620   if available X_fin-code-cor-acc
     2621     then
     2622   do :
     2623     assign
     2624       f-cor-acc-descr    = X_fin-code-cor-acc.descr
     2625       tt-fin-doc.cor-acc = X_fin-code-cor-acc.fin-code
     2626       .
     2627   end.
     2628   find first X_fin-code-cor-acc1 no-lock where X_fin-code-cor-acc1.code-value = tt-fin-doc.cor-acc1-value
     2629     and X_fin-code-cor-acc1.host-code = tt-fin-doc.host-code
     2630     and X_fin-code-cor-acc1.status_ = integer('0':U)
     2631     no-error .
     2632   if available X_fin-code-cor-acc1
     2633     then
     2634   do :
     2635     assign
     2636       f-cor-acc1-descr   = X_fin-code-cor-acc1.descr
     2637       tt-fin-doc.cor-acc = X_fin-code-cor-acc1.fin-code
     2638       .
     2639   end.
     2640   end.
     2641   else
     2642   do:
     2643   if getCliKassa(tt-fin-doc.payer-type, tt-fin-doc.payer-code, "Vnecli", tt-fin-doc.cashbookId) then do:
     2644   assign
     2645     tt-fin-doc.cor-acc1-value = ub.CashBook.OsnAcct
     2646     .
     2647   find first ub.CashBookRule no-lock where ub.CashBookRule.CashBookID = tt-fin-doc.cashbookId
     2648     and ub.CashBookRule.Obj-type   = 'всем':U
     2649     and ub.CashBookRule.Obj-code   = 0
     2650     and ub.CashBookRule.Code       = "corrPkoVne"
     2651     no-error.
     2652   if available (ub.CashBookRule) then tt-fin-doc.cor-acc-value = ub.CashBookRule.RuleValue .
     2653   find first ub.CashBookRule no-lock where ub.CashBookRule.CashBookID = tt-fin-doc.cashbookId
     2654     and ub.CashBookRule.Obj-type   = 'всем':U
     2655     and ub.CashBookRule.Obj-code   = 0
     2656     and ub.CashBookRule.Code       = "RuleOsnPkoVne"
     2657     no-error.
     2658   if available (ub.CashBookRule) then tt-fin-doc.naznach-plat = ub.CashBookRule.RuleValue .
     2659   find first X_fin-code-cor-acc no-lock where X_fin-code-cor-acc.code-value = tt-fin-doc.cor-acc-value
     2660     and X_fin-code-cor-acc.host-code = tt-fin-doc.host-code
     2661     and X_fin-code-cor-acc.status_ = integer('0':U)
     2662     no-error .
     2663   if available X_fin-code-cor-acc
     2664     then
     2665   do :
     2666     assign
     2667       f-cor-acc-descr    = X_fin-code-cor-acc.descr
     2668       tt-fin-doc.cor-acc = X_fin-code-cor-acc.fin-code
     2669       .
     2670   end.
     2671   find first X_fin-code-cor-acc1 no-lock where X_fin-code-cor-acc1.code-value = tt-fin-doc.cor-acc1-value
     2672     and X_fin-code-cor-acc1.host-code = tt-fin-doc.host-code
     2673     and X_fin-code-cor-acc1.status_ = integer('0':U)
     2674     no-error .
