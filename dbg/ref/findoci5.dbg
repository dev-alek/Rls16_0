     4263       if tt-fin-doc.exch-rate:visible in frame Dialog-Frame then
     4264       do:
     4265         display
     4266           tt-fin-doc.exch-rate
     4267           tt-fin-doc.exch-scale
     4268           with frame Dialog-Frame.
     4269         assign
     4270           p-main-widget = "sum-doc":U.
     4271       end.
     4272       if tt-fin-doc.contract-rate:visible in frame Dialog-Frame then
     4273       do:
     4274         display
     4275           tt-fin-doc.contract-rate
     4276           tt-fin-doc.contract-scale
     4277           with frame Dialog-Frame.
     4278         assign
     4279           p-main-widget = "sum-doc":U.
     4280       end.
     4281     end.
     4282     CASE p-main-widget:
     4283       when "sum-doc" then
     4284         do:
     4285           assign
     4286             frame Dialog-Frame
     4287             tt-fin-doc.exch-rate
     4288             tt-fin-doc.exch-scale
     4289             tt-fin-doc.sum-doc
     4290             .
     4291           CASE tt-fin-doc.curr-code:
     4292             when 0 then
     4293               do:
     4294                 assign
     4295                   tt-fin-doc.sum-rubl = tt-fin-doc.sum-doc
     4296                   tt-fin-doc.sum-base = tt-fin-doc.sum-doc / tt-fin-doc.base-rate * tt-fin-doc.base-scale
     4297                   tt-fin-doc.sum-contr = (if tt-fin-doc.contract-curr = 0                                                       then tt-fin-doc.sum-rubl                                                       else tt-fin-doc.sum-rubl / (tt-fin-doc.contract-rate / tt-fin-doc.contract-scale)                                                     )
     4298                   .
     4299               end.
     4300             when v-base-code then
     4301               do:
     4302                 assign
     4303                   tt-fin-doc.sum-rubl = tt-fin-doc.sum-doc * tt-fin-doc.exch-rate / tt-fin-doc.exch-scale
     4304                   tt-fin-doc.sum-base = tt-fin-doc.sum-rubl / tt-fin-doc.base-rate * tt-fin-doc.base-scale
     4305                   tt-fin-doc.sum-contr = (if tt-fin-doc.contract-curr = 0                                                       then tt-fin-doc.sum-rubl                                                       else tt-fin-doc.sum-rubl / (tt-fin-doc.contract-rate / tt-fin-doc.contract-scale)                                                     )
     4306                   .
     4307               end.
     4308             otherwise
     4309             do:
     4310               assign
     4311                 tt-fin-doc.sum-rubl = tt-fin-doc.sum-doc * tt-fin-doc.exch-rate / tt-fin-doc.exch-scale
     4312                 tt-fin-doc.sum-base = tt-fin-doc.sum-rubl / tt-fin-doc.base-rate * tt-fin-doc.base-scale
     4313                 tt-fin-doc.sum-contr = (if tt-fin-doc.contract-curr = 0                                                       then tt-fin-doc.sum-rubl                                                       else tt-fin-doc.sum-rubl / (tt-fin-doc.contract-rate / tt-fin-doc.contract-scale)                                                     )
     4314                 .
     4315             end.
     4316           END CASE.
     4317         end.
     4318     END CASE.
     4319     assign
     4320       f-rest-con-sum = tt-fin-doc.sum-contr - tt-fin-doc.con-sum-contr
     4321       .
     4322     display
     4323       f-rest-con-sum
     4324       with frame Dialog-Frame.
     4325     if tt-fin-doc.sum-doc:visible in frame Dialog-Frame then
     4326       display
     4327         tt-fin-doc.sum-doc
     4328         tt-fin-doc.curr-code
     4329         with frame Dialog-Frame.
     4330     if tt-fin-doc.sum-rubl:visible in frame Dialog-Frame then
     4331       display
     4332         tt-fin-doc.sum-rubl
     4333         tt-fin-doc.exch-rate
     4334         tt-fin-doc.exch-scale
     4335         with frame Dialog-Frame.
     4336     if tt-fin-doc.sum-base:visible in frame Dialog-Frame then
     4337       display
     4338         tt-fin-doc.sum-base
     4339         tt-fin-doc.base-rate
     4340         tt-fin-doc.base-scale
     4341         with frame Dialog-Frame.
     4342     if tt-fin-doc.sum-contr:visible in frame Dialog-Frame then
     4343       display
     4344         tt-fin-doc.sum-contr
     4345         tt-fin-doc.contract-rate
     4346         tt-fin-doc.contract-scale
     4347         with frame Dialog-Frame.
     4348     if not v-first-start then
     4349       run proc-update-sum-vat-chr in this-procedure (input-output v-start).
     4350   END PROCEDURE.
     4351   procedure proc-create-default-tax :
     4352     do
     4353       on error undo, return error
     4354       :
     4355       If p-mode = 'ДОБАВЛЕНИЕ':U then
     4356       do:
     4357         if p-ob-doc-code = "" then
     4358         do:
     4359           find tt0-fin-doc-tax where
     4360             tt0-fin-doc-tax.fin-doc-code = tt-fin-doc.fin-doc-code
     4361             AND tt0-fin-doc-tax.host-code = tt-fin-doc.host-code no-error .
     4362           if not avail tt0-fin-doc-tax
     4363             and not AMBIGUOUS tt0-fin-doc-tax
     4364             then
     4365           do:
     4366             create tt0-fin-doc-tax.
     4367           end.
     4368           if AMBIGUOUS tt0-fin-doc-tax then return.
     4369           assign
     4370             tt0-fin-doc-tax.fin-doc-code     = tt-fin-doc.fin-doc-code
     4371             tt0-fin-doc-tax.host-code        = tt-fin-doc.host-code
     4372             tt0-fin-doc-tax.line-num         = 1
     4373             tt0-fin-doc-tax.slt-pc           = 0
     4374             tt0-fin-doc-tax.sum-line-doc     = tt-fin-doc.sum-doc
     4375             tt0-fin-doc-tax.sum-slt-line-doc = 0
     4376             tt0-fin-doc-tax.with-slt         = no
     4377             .
     4378           case paramVne:
     4379             when "vne" then do:
     4380             assign
     4381               tt0-fin-doc-tax.sum-vat-line-doc = 0
     4382               tt0-fin-doc-tax.vat-pc           = -1
     4383               tt0-fin-doc-tax.with-vat         = no
     4384               .
     4385             end.
     4386             when "avans" then do:
     4387             assign
     4388               tt0-fin-doc-tax.vat-pc           = 22
     4389               tt0-fin-doc-tax.sum-vat-line-doc = (tt-fin-doc.sum-doc * tt0-fin-doc-tax.vat-pc)/(100 + tt0-fin-doc-tax.vat-pc)
     4390               tt0-fin-doc-tax.with-vat         = yes
     4391               .
     4392             end.
     4393             otherwise do:
     4394             assign
     4395               tt0-fin-doc-tax.sum-vat-line-doc = 0
     4396               tt0-fin-doc-tax.vat-pc           = 0
     4397               tt0-fin-doc-tax.with-vat         = no
     4398               .
     4399             end.
     4400           end case .
     4401           release tt0-fin-doc-tax.
     4402         end.
     4403       end.
     4404     end.
     4405   end procedure.
     4406   procedure proc-update-sum-vat-chr :
