     2029   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
     2030     (input  tt-fin-doc.obj-type
     2031     ,input  tt-fin-doc.obj-code
     2032     ,output v-obj-db-num
     2033     )  .
     2034       define variable l-shift-on as logical no-undo .
     2035   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2036   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     2037     (input  tt-fin-doc.obj-type
     2038     ,input  tt-fin-doc.obj-code
     2039     ,input  'shift-on=request'
     2040     ,output l-shift-on
