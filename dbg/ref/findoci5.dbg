     1650       find first X_payer-fin-schet no-lock where                recid(X_payer-fin-schet)       = X_payer-fin-schet-recid no-error .
     1651       find first X_payer-fin-bank no-lock where                 recid(X_payer-fin-bank)        = X_payer-fin-bank-recid no-error .
     1652       find first X_payer-firm no-lock where                     recid(X_payer-firm)            = X_payer-firm-recid no-error .
     1653       find first X_payer-person no-lock where                   recid(X_payer-person)          = X_payer-person-recid no-error .
