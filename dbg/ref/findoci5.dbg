     3838   define variable v-doc-date as date    no-undo.
     3839   define variable vlog       as logical no-undo .
     3840   assign
     3841     v-doc-date = tt-fin-doc.doc-date
     3842     tt-fin-doc.doc-date
     3843     .
     3844   if tt-fin-doc.doc-date <> v-doc-date
     3845     and (input frame Dialog-Frame   tt-fin-doc.sum-doc <> 0
     3846     or tt-fin-doc.sum-doc <> 0)
     3847     then
     3848   do:
     3849     message
     3850       "Пересчитать суммы документа в соответствии с курсами на новую дату?"
     3851       view-as alert-box QUESTION buttons YEs-NO update vlog.
     3852     if  vlog then
     3853     do:
     3854       run recalc in this-procedure ("doc-date":U) no-error.
     3855       if error-status:error then
     3856       do:
     3857         assign
     3858           tt-fin-doc.doc-date = v-doc-date
     3859           .
     3860         display tt-fin-doc.doc-date
     3861           with frame Dialog-Frame.
     3862       end.
     3863     end.
     3864   end.
     3865   END.
