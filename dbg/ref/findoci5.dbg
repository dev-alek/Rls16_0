     1540   ASSIGN
     1541          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1542          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1543   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1544   DO:
     1545     APPLY "END-ERROR":U TO SELF.
     1546   END.
     1547   ON CHOOSE OF B-print IN FRAME Dialog-Frame
     1548   DO:
     1549   define variable v-format as integer no-undo .
     1550   define variable v-log as logical no-undo .
     1551   define variable v-cmp as character no-undo .
     1552   buffer-compare tt-fin-doc except receiver-sign1
     1553   to locked_fin-doc
     1554   case-sensitive
     1555   save result in v-cmp .
     1556   if v-cmp <> "":U
     1557   or  entry((if num-entries(locked_fin-doc.receiver-sign1, chr(4)) > 1
     1558              then 2
     1559              else 1)
     1560              , locked_fin-doc.receiver-sign1, chr(4)
     1561            ) <> tt-fin-doc.receiver-sign1
     1562   then do:
     1563     message
     1564     "Вы изменили ПЛАТЕЖ, но не сохранили его" skip
     1565     "сохранить перед печатью?"
     1566     view-as alert-box QUESTION buttons YES-NO update v-log.
     1567   end.
     1568   run proc-save in this-procedure (v-log) no-error.
     1569   run ref/fdoc-prn.p (
     1570           input parparentproc
     1571         , input this-procedure
     1572         , input string(recid(locked_fin-doc))
     1573                         ) no-error.
     1574   if error-status:error then return no-apply.
     1575   END.
     1576   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1577   procedure proc-color-widgets :
     1578   define input parameter p-list as character no-undo .
     1579   define input parameter p-fg as logical no-undo .
     1580   define input parameter p-bg as logical no-undo .
     1581   define input parameter p-fgc as integer no-undo .
     1582   define input parameter p-bgc as integer no-undo .
     1583   define variable ii as integer no-undo .
     1584   define variable fh as widget-handle no-undo .
     1585   define variable hh as widget-handle no-undo .
     1586     do
     1587     on error undo, return error
     1588     :
     1589       assign
     1590       fh = frame Dialog-Frame:first-child
     1591       hh = fh:first-child
     1592       .
     1593       do while valid-handle(hh):
     1594         if LOOKUP(hh:name, p-list) > 0  then do:
     1595           assign
     1596           hh:fgcolor = (if p-fg then p-fgc else hh:fgcolor)
     1597           hh:bgcolor = (if p-bg then p-bgc else hh:bgcolor)
     1598           .
     1599         end.
     1600         hh = hh:next-sibling.
     1601       end.
     1602     end.
     1603   end procedure.
     1604   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile: findocip.i $ $Revision: ff8019e24d02, 2996, rls $".
     1605   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1606   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
