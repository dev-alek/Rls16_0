     4433   define variable vss-include-info52 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4434   procedure minbtn-set :
     4435       do
     4436           on error undo, return error return-value
     4437           :
     4438           define variable ii              as integer       no-undo .
     4439           define variable fh              as widget-handle no-undo .
     4440           define variable hh              as widget-handle no-undo .
     4441           define variable v-h             as handle        extent 4 no-undo .
     4442           define variable v-name-button   as character     no-undo .
     4443           define variable v-help-old-x    as decimal       no-undo .
     4444           define variable v-help-old-y    as decimal       no-undo .
     4445           define variable v-help-old-size as decimal       no-undo .
     4446           define variable v-frame-width   as decimal       no-undo .
     4447           define variable jj              as integer       no-undo .
     4448           do
     4449               on error undo, return error
     4450               :
     4451               assign
     4452                   v-frame-width = frame Dialog-Frame:width - 0.3
     4453                   fh            = frame Dialog-Frame:first-child
     4454                   hh            = fh:first-child
     4455                   ii            = 1
     4456                   .
     4457               do while valid-handle(hh):
     4458                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     4459                   do:
     4460                       case lc(hh:name) :
     4461                           when "b-help" then
     4462                               do:
     4463                                   hh:load-image-up("cmp/b-help.bmp":u) .
     4464                                   hh:load-image-down("cmp/b-help.bmp":u) .
     4465                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     4466                                   hh:TOOLTIP = "Помощь" .
     4467                                   v-help-old-x = hh:column .
     4468                                   v-help-old-y = hh:row    .
     4469                                   v-help-old-size = hh:width .
     4470                                   hh:width-chars = 2.5 .
     4471                               end.
     4472                           when "b-print" then
     4473                               do:
     4474                                   hh:load-image("cmp/b-print.bmp":u) .
     4475                                   hh:TOOLTIP = "Печать" .
     4476                                   v-h[ii] = hh:handle .
     4477                                   ii = ii + 1 .
     4478                                   hh:width-chars = 3 .
     4479                               end.
     4480                           when "b-history" or
     4481                           when "b-hist" then
     4482                               do:
     4483                                   hh:load-image("cmp/b-hist.bmp":u) .
     4484                                   hh:TOOLTIP = "История" .
     4485                                   v-h[ii] = hh:handle .
     4486                                   ii = ii + 1 .
     4487                                   hh:width-chars = 3 .
     4488                               end.
     4489                           when "b-sch" then
     4490                               do:
     4491                                   hh:load-image("cmp/b-sch.bmp":u) .
     4492                                   hh:TOOLTIP = "Установка Фильтра" .
     4493                                   v-h[ii] = hh:handle .
     4494                                   ii = ii + 1 .
     4495                                   hh:width-chars = 3 .
     4496                               end.
     4497                           when "b-hist-user" then
     4498                               do:
     4499                                   hh:load-image("cmp/b-hist.bmp":u) .
     4500                                   hh:TOOLTIP = "История пользователя" .
     4501                                   ii = ii + 1 .
     4502                               end.
     4503                       end case.
     4504                   end.
     4505                   hh = hh:next-sibling.
     4506               end.
     4507               b-help:column = v-frame-width - b-help:width-chars.
     4508               jj = 0.
     4509               repeat ii = 4 to 1 by -1 :
     4510                   if valid-handle (v-h[ii] ) then
     4511                   do:
     4512                       jj  = jj + 1 .
     4513                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     4514                       v-h[ii]:row    = v-help-old-y .
     4515                   end.
     4516               end.
     4517           end.
     4518       end.
     4519   end procedure.
     4520   define variable vss-include-info53 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4521   ON TAB ANYWHERE
     4522   DO:
     4523   define variable ii as integer no-undo .
     4524   define variable fh as widget-handle no-undo .
     4525   define variable hh as widget-handle no-undo .
     4526   define variable v-next-widget-name as character no-undo .
     4527   if v-tab-order <> '' then do:
     4528     if self:type = "TOGGLE-BOX" then
     4529     self:BGCOLOR = ?.
     4530     assign
     4531     ii = lookup(self:name, v-tab-order).
     4532     assign
     4533     ii = ii + 1
     4534     v-next-widget-name = entry(ii, v-tab-order)
     4535     no-error .
     4536     if error-status:error then do:
     4537       assign
     4538       ii = 1
     4539       v-next-widget-name = entry( ii, v-tab-order)
     4540       .
     4541     end.
     4542     assign
     4543     fh = frame Dialog-Frame:first-child
     4544     hh = fh:first-child
     4545     .
     4546     do while valid-handle(hh):
     4547       if hh:name = v-next-widget-name then do:
     4548         if hh:sensitive  = yes
     4549         AND hh:visible = yes then do:
     4550           if hh:type = "TOGGLE-BOX":U then do:
     4551             assign
     4552             hh:BGcolor = 1
     4553             .
     4554           end.
     4555           APPLY "ENTRY" to hh.
     4556           return no-apply.
     4557         end.
     4558         else do:
     4559           APPLY "TAB" to hh.
     4560           return no-apply.
     4561         end.
     4562       end.
     4563       hh = hh:next-sibling.
     4564     end.
     4565   end.
     4566   END.
     4567   ON BACK-TAB ANYWHERE
     4568   DO:
     4569   define variable ii as integer no-undo .
     4570   define variable fh as widget-handle no-undo .
     4571   define variable hh as widget-handle no-undo .
     4572   define variable v-next-widget-name as character no-undo .
     4573   if v-tab-order <> '' then do:
     4574     assign
     4575     ii = lookup(self:name, v-tab-order).
     4576     .
     4577     assign
     4578     ii = (if ii = 1
     4579           then  num-entries(v-tab-order)
     4580           else ii - 1
     4581           )
     4582     v-next-widget-name = entry(ii, v-tab-order)
     4583     .
     4584     assign
     4585     fh = frame Dialog-Frame:first-child
     4586     hh = fh:first-child
     4587     .
     4588     do while valid-handle(hh):
     4589       if hh:name = v-next-widget-name then do:
     4590         if hh:sensitive  = yes
     4591         AND hh:visible = yes then do:
     4592           if hh:type = "TOGGLE-BOX":U then do:
     4593             assign
     4594             hh:BGcolor = 1
     4595             .
     4596           end.
     4597           APPLY "ENTRY" to hh.
     4598           return no-apply.
     4599         end.
     4600         else do:
     4601         APPLY "BACK-TAB" to hh.
     4602         return no-apply.
     4603         end.
     4604       end.
     4605       hh = hh:next-sibling.
     4606     end.
     4607     end.
     4608   END.
     4609   define variable vss-include-info54 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4610   ON RETURN ANYWHERE
     4611   DO:
     4612   define variable ii as integer no-undo .
     4613   define variable fh as widget-handle no-undo .
     4614   define variable hh as widget-handle no-undo .
     4615   define variable v-next-widget-name as character no-undo .
     4616     if v-tab-order <> '' then do:
     4617       assign
     4618       ii = lookup(self:name, v-tab-order).
     4619       if ii = num-entries(v-tab-order) then do:
     4620           APPLY 'CHOOSE' TO b-exit in frame Dialog-Frame.
     4621           return no-apply.
     4622       end.
     4623       if self:type <> "BUTTON" and
     4624         self:type <> "EDITOR"  then do:
     4625         run proc-move-forward in this-procedure .
     4626         return no-apply.
     4627       end.
     4628       if self:type = "BUTTON" then do:
     4629         APPLY "CHOOSE" to self.
     4630       end.
     4631       if self:type = "TOGGLE-BOX" then
     4632       self:BGCOLOR = ?.
     4633       assign
     4634       ii = ii + 1
     4635       v-next-widget-name = entry(ii, v-tab-order)
     4636       no-error .
     4637       if error-status:error then do:
     4638         assign
     4639         ii = 1
     4640         v-next-widget-name = entry( ii, v-tab-order)
     4641         .
     4642       end.
     4643       assign
     4644       fh = frame Dialog-Frame:first-child
     4645       hh = fh:first-child
     4646       .
     4647       do while valid-handle(hh):
     4648         if hh:name = v-next-widget-name then do:
     4649           if hh:sensitive  = yes
     4650           AND hh:visible = yes then do:
     4651             if hh:type = "TOGGLE-BOX":U then do:
     4652               assign
     4653               hh:BGcolor = 1
     4654               .
     4655             end.
     4656             APPLY "ENTRY" to hh.
     4657             return no-apply.
     4658           end.
     4659           else do:
     4660             APPLY "TAB" to hh.
     4661             return no-apply.
     4662           end.
     4663         end.
     4664         hh = hh:next-sibling.
     4665       end.
     4666     end.
     4667   END.
     4668   procedure proc-move-forward :
     4669   define variable ii as integer no-undo .
     4670   define variable fh as widget-handle no-undo .
     4671   define variable hh as widget-handle no-undo .
     4672   define variable v-next-widget-name as character no-undo .
     4673   do
     4674   on error undo, return error
     4675   :
     4676     if v-tab-order <> '' then do:
     4677       if self:type = "TOGGLE-BOX" then
     4678       self:BGCOLOR = ?.
     4679       assign
     4680       ii = lookup(self:name, v-tab-order).
     4681       assign
     4682       ii = ii + 1
     4683       v-next-widget-name = entry(ii, v-tab-order)
     4684       no-error .
     4685       if error-status:error then do:
     4686         assign
     4687         ii = 1
     4688         v-next-widget-name = entry( ii, v-tab-order)
     4689         .
     4690       end.
     4691       assign
     4692       fh = frame Dialog-Frame:first-child
     4693       hh = fh:first-child
     4694       .
     4695       do while valid-handle(hh):
     4696         if hh:name = v-next-widget-name then do:
     4697           if hh:sensitive  = yes
     4698           AND hh:visible = yes then do:
     4699             if hh:type = "TOGGLE-BOX":U then do:
     4700               assign
     4701               hh:BGcolor = 1
     4702               .
     4703             end.
     4704             APPLY "ENTRY" to hh.
     4705             return.
     4706           end.
     4707           else do:
     4708             assign
     4709             ii = ii + 1
     4710             v-next-widget-name = entry(ii, v-tab-order)
     4711             no-error .
     4712             if error-status:error then do:
     4713               assign
     4714               ii = 1
     4715               v-next-widget-name = entry( ii, v-tab-order)
     4716               .
     4717             end.
     4718           end.
     4719         end.
     4720         hh = hh:next-sibling.
     4721       end.
     4722     end.
     4723   end.
     4724   end procedure.
