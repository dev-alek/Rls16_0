     3356       "Указанному интерфейсному элементу фокус не может быть передан" skip
     3357       "Интерфейсный элемент" self :name  skip
     3358       "Тип" self :type  skip
     3359       "Процедура" this-procedure :file-name skip
     3360       view-as alert-box .
     3361   end.
     3362   else do:
     3363     apply "entry":u to self  .
     3364     if focus :handle <> self :handle  then do:
     3365       return no-apply .
     3366     end.
     3367   end.
     3368   assign
     3369     v-curr-code = tt-fin-doc.curr-code
     3370     tt-fin-doc.curr-code.
     3371   if available X_currency then rr = recid(X_currency).
     3372   else rr = ?.
     3373   run ref/currency.w (parparentproc, "b-sel", input-output rr ).
     3374   if rr <> ? then
     3375   do:
     3376     FIND FIRST X_currency WHERE
     3377       recid( X_currency ) = rr NO-LOCK .
     3378     assign
     3379       tt-fin-doc.curr-code = X_currency.curr-code
     3380       f-curr-abbr          = X_currency.curr-abbr
     3381       .
     3382     DISPLAY
     3383       tt-fin-doc.curr-code
     3384       f-curr-abbr
     3385       with frame Dialog-Frame .
     3386   end.
     3387   if tt-fin-doc.curr-code <> v-curr-code then
     3388   do:
     3389     run recalc in this-procedure("curr-code":U) no-error.
     3390     if error-status:error then
     3391     do:
     3392       assign
     3393         tt-fin-doc.curr-code = v-curr-code
     3394         .
     3395       display tt-fin-doc.curr-code
     3396         with frame Dialog-Frame.
     3397     end.
     3398     run hide-view-currency in this-procedure .
     3399   end.
     3400   END.
