     1625     define input parameter X_receiver-fin-bank-recid as recid no-undo .
     1626     define input parameter X_receiver-firm-recid as recid no-undo .
     1627     define input parameter X_receiver-person-recid as recid no-undo .
     1628     define input parameter X_contract-recid as recid no-undo .
     1629     define input parameter X_fin-ob-recid as recid no-undo .
