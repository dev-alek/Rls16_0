     2690     and ub.CashBookRule.Obj-type   = 'всем':U
     2691     and ub.CashBookRule.Obj-code   = 0
     2692     and ub.CashBookRule.Code       = "corrPkoAvans"
     2693     no-error.
     2694   if available (ub.CashBookRule) then tt-fin-doc.cor-acc-value = ub.CashBookRule.RuleValue .
     2695   find first ub.CashBookRule no-lock where ub.CashBookRule.CashBookID = tt-fin-doc.cashbookId
     2696     and ub.CashBookRule.Obj-type   = 'всем':U
     2697     and ub.CashBookRule.Obj-code   = 0
