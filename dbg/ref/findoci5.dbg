     2574     CASE X_payer.obj-type:   when 'чел':U then do:              find first X_payer-person no-lock where               X_payer-person.psn-code = X_payer.obj-code .   end.   when 'орг':U then do:     find first X_payer-firm no-lock where               X_payer-firm.firm-code = X_payer.obj-code .   end. END CASE. assign tt-fin-doc.payer-sign1  = if X_payer.obj-type = 'орг':U                              then X_payer-firm.director                             else X_payer.obj-name . display tt-fin-doc.payer-sign1 with frame Dialog-Frame.
