     2083       mCashBook = new ibs.th.ref.cashbookstorage () .
     2084       v-dpt-option    = mCashBook:getSinglRule(tt-fin-doc.CashBookId, tt-fin-doc.obj-type, tt-fin-doc.obj-code, "Struct") .
     2085       v-dpt-dflt-name = mCashBook:getSinglRule(tt-fin-doc.CashBookId, tt-fin-doc.obj-type, tt-fin-doc.obj-code, "DptName") .
     2086       v-dpt-dflt-type = mCashBook:getSinglRule(tt-fin-doc.CashBookId, tt-fin-doc.obj-type, tt-fin-doc.obj-code, "DptType") .
     2087       v-dpt-dflt-code = integer(mCashBook:getSinglRule(tt-fin-doc.CashBookId, tt-fin-doc.obj-type, tt-fin-doc.obj-code, "DptCode")) .
     2088       o-head-position = mCashBook:getSinglRule(tt-fin-doc.CashBookId, tt-fin-doc.obj-type, tt-fin-doc.obj-code, "ManagerPosition") .
     2089       o-director      = mCashBook:getSinglRule(tt-fin-doc.CashBookId, tt-fin-doc.obj-type, tt-fin-doc.obj-code, "ManagerFIO") .
     2090       o-snr-accnt     = mCashBook:getSinglRule(tt-fin-doc.CashBookId, tt-fin-doc.obj-type, tt-fin-doc.obj-code, "BuhFIO") .
     2091       delete object mCashBook no-error .
     2092       case v-dpt-option:
     2093         when "1" then
     2094           do:
     2095             for first ub.db-attr no-lock where ub.db-attr.db-num = v-cntxt-db-num
     2096             and ub.db-attr.attr-code = 'hist-code':U:
     2097               v-hist-code = ub.db-attr.attr-value .
     2098             end.
     2099             for first ub.db-attr no-lock where ub.db-attr.db-num = v-cntxt-db-num
     2100             and ub.db-attr.attr-code = 'hist-name':U:
     2101               v-hist-name = ub.db-attr.attr-value .
     2102             end.
     2103             if v-hist-code = "" then v-dpt-dflt-code = X_clients-obj.obj-code .
     2104             if v-hist-name = "" then v-dpt-dflt-name = X_clients-obj.obj-name .
     2105             v-dpt-dflt-type = X_clients-obj.obj-type  .
     2106           end.
     2107         when "0" then
     2108           do:
     2109             assign
     2110               v-dpt-dflt-name = ''
     2111               v-dpt-dflt-type = ''
     2112               v-dpt-dflt-code = 0
     2113               .
     2114           end.
     2115         otherwise
     2116         do:
     2117           assign
     2118             v-dpt-dflt-name = v-dpt-dflt-name
     2119             v-dpt-dflt-type = v-dpt-dflt-type
     2120             v-dpt-dflt-code = v-dpt-dflt-code
     2121             .
     2122         end.
     2123       end case.
     2124       find first buf_sysconf no-error .
     2125       case o-head-position:
     2126         when '0':U then
     2127           do:
     2128             v-head-position = buf_sysconf.head-position.
     2129           end.
     2130         when '1':U then
     2131           do:
     2132             v-head-position = "Директор".
     2133           end.
     2134         when '2':U then
     2135           do:
     2136             v-head-position = "Управляющий".
     2137           end.
     2138         otherwise
     2139         do :
     2140           v-head-position = o-head-position.
     2141         end.
     2142       end case.
     2143       find first buf_firm no-lock where
     2144         buf_firm.firm-code = buf_sysconf.host-code.
     2145       case o-director:
     2146         when '1':U then
     2147           do:
     2148             if p-obj-type = 'маг':U then
     2149             do:
     2150               find first buf_shop no-lock where
     2151                 buf_shop.obj-code = p-obj-code no-error .
     2152               if available buf_shop then
     2153               do:
     2154                 v-director = buf_shop.director.
     2155               end.
     2156             end.
     2157             if p-obj-type = 'скл':U then
     2158             do:
     2159               find first buf_store no-lock where
     2160                 buf_store.obj-code = p-obj-code no-error .
     2161               if available buf_store then
     2162               do:
     2163                 v-director = buf_store.store-boss.
     2164               end.
     2165             end.
     2166           end.
     2167         when '0':U then
     2168           do:
     2169             v-director = buf_firm.director.
     2170           end.
     2171         otherwise
     2172         do:
     2173           v-director = o-director .
     2174         end.
     2175       end case.
     2176       case o-snr-accnt:
     2177         when '1':U then
     2178           do:
     2179             if p-obj-type = 'маг':U then
     2180             do:
     2181               find first buf_shop no-lock where
     2182                 buf_shop.obj-code = p-obj-code no-error .
     2183               if available buf_shop then
     2184               do:
     2185                 v-snr-accnt = entry(1,buf_shop.acct,"|").
     2186               end.
     2187             end.
     2188             if p-obj-type = 'скл':U then
     2189             do:
     2190               v-snr-accnt = ''.
     2191             end.
     2192           end.
     2193         when '2':U then
     2194           do:
     2195             v-snr-accnt = buf_sysconf.snr-accnt.
     2196           end.
     2197         otherwise
     2198         do:
     2199           v-snr-accnt = o-snr-accnt .
     2200         end.
     2201       end case.
     2202     FIND FIRST ub.shift-staff No-LOCK WHERE
     2203       ub.shift-staff.obj-type   = p-obj-type AND
     2204       ub.shift-staff.obj-code   = p-obj-code AND
     2205       ub.shift-staff.shift-date = tt-fin-doc.shift-date AND
     2206       ub.shift-staff.shift-num  = tt-fin-doc.shift-num AND
     2207       ub.shift-staff.staff-role = no and
     2208       ub.shift-staff.psn-num    >= 0 No-ERROR.
     2209     assign
     2210       v-cashier = if available ub.shift-staff then string(ub.shift-staff.name, "X(30)") else "".
     2211     .
     2212     if tt-fin-doc.fin-ext-doc-type = 'рко':U then
     2213     do:
     2214       assign
     2215         tt-fin-doc.payer-sign1 = v-director
     2216         tt-fin-doc.payer-sign2 = v-snr-accnt
     2217         tt-fin-doc.payer-sign3 = v-cashier
     2218         .
     2219     end.
     2220     if tt-fin-doc.fin-ext-doc-type = 'пко':U then
     2221     do:
     2222       assign
     2223         tt-fin-doc.receiver-sign2 = v-snr-accnt
     2224         tt-fin-doc.receiver-sign3 = v-cashier
     2225         .
     2226     end.
     2227     find first ub.CashBook no-lock where ub.CashBook.id = tt-fin-doc.CashBookId no-error .
     2228     if available (ub.CashBook) then
     2229     do:
     2230       case ub.CashBook.RuleOsnRko:
     2231         when "0" then
     2232           tt-fin-doc.naznach-plat = "Выручка от реализации" .
     2233         when "1" or
     2234         when "2" then
     2235           tt-fin-doc.naznach-plat = "" .
     2236         otherwise
     2237         tt-fin-doc.naznach-plat = ub.CashBook.RuleOsnRko .
     2238       end case .
     2239       case ub.CashBook.RulePril:
     2240         when '0' then
     2241           do:
     2242             tt-fin-doc.enclosure = v-naznach-plat .
     2243           end.
     2244         when '1' then
     2245           do:
     2246             tt-fin-doc.enclosure = "" .
     2247           end.
     2248         otherwise
     2249         tt-fin-doc.enclosure = ub.CashBook.RulePril .
     2250       end case.
     2251       if ub.CashBook.CorrRko <> "" then
     2252       do:
     2253         for first ub.fin-code-cor-acc no-lock where ub.fin-code-cor-acc.code-value = ub.CashBook.CorrRko
     2254           and ub.fin-code-cor-acc.host-code = p-curr-host-code :
     2255           tt-fin-doc.cor-acc = ub.fin-code-cor-acc.fin-code .
     2256           tt-fin-doc.cor-acc-value = ub.fin-code-cor-acc.code-value .
     2257         end.
     2258       end.
     2259       if tt-fin-doc.cor-acc = ? or tt-fin-doc.cor-acc = 0 then
     2260       do:
     2261         for first ub.fin-code-cor-acc no-lock where ub.fin-code-cor-acc.code-value = "57.01"
     2262           and ub.fin-code-cor-acc.host-code = p-curr-host-code :
     2263           tt-fin-doc.cor-acc = ub.fin-code-cor-acc.fin-code .
     2264           tt-fin-doc.cor-acc-value = ub.fin-code-cor-acc.code-value .
     2265         end.
     2266       end.
     2267       if ub.CashBook.OsnAcct <> "" then
     2268       do:
     2269         for first ub.fin-code-cor-acc no-lock where ub.fin-code-cor-acc.code-value = ub.CashBook.OsnAcct
     2270           and ub.fin-code-cor-acc.host-code = p-curr-host-code :
     2271           tt-fin-doc.cor-acc1 = ub.fin-code-cor-acc.fin-code .
     2272           tt-fin-doc.cor-acc1-value = ub.fin-code-cor-acc.code-value .
     2273         end.
     2274       end.
     2275     end.
     2276     assign
     2277       tt-fin-doc.str-podr-name = if v-hist-name = "" then v-dpt-dflt-name else v-hist-name
     2278       tt-fin-doc.str-podr-type = v-dpt-dflt-type
     2279       tt-fin-doc.str-podr-code = v-dpt-dflt-code
     2280       .
     2281     display
     2282       tt-fin-doc.str-podr-name
     2283       tt-fin-doc.str-podr-type
     2284       tt-fin-doc.str-podr-code
     2285       tt-fin-doc.enclosure
     2286       tt-fin-doc.naznach-plat
     2287       tt-fin-doc.cor-acc
     2288       tt-fin-doc.cor-acc1
     2289       tt-fin-doc.cor-acc1-value
     2290       tt-fin-doc.cor-acc-value
     2291       with frame Dialog-Frame .
     2292     end.
     2293     else
     2294     do:
     2295       assign
     2296         tt-fin-doc.shift-flag = 0
     2297         .
     2298     end.
     2299   END PROCEDURE.
     2300   ON CHOOSE OF B-calc IN FRAME Dialog-Frame
     2301     DO:
     2302       run ref/findclci.w (
     2303         INPUT          parParentProc
     2304         ,input          "":U
     2305         ,INPUT          tt-fin-doc.doc-date
     2306         ,INPUT          tt-fin-doc.curr-code
     2307         ,INPUT          v-base-code
     2308         ,INPUT          tt-fin-doc.contract-curr
     2309         ,INPUT-OUTPUT   tt-fin-doc.sum-doc
     2310         ,INPUT-OUTPUT   tt-fin-doc.exch-rate
     2311         ,INPUT-OUTPUT   tt-fin-doc.exch-scale
     2312         ,INPUT-OUTPUT   tt-fin-doc.sum-rubl
     2313         ,INPUT-OUTPUT   tt-fin-doc.sum-base
     2314         ,INPUT-OUTPUT   tt-fin-doc.base-rate
     2315         ,INPUT-OUTPUT   tt-fin-doc.base-scale
     2316         ,INPUT-OUTPUT   tt-fin-doc.sum-contr
     2317         ,INPUT-OUTPUT   tt-fin-doc.contract-rate
     2318         ,INPUT-OUTPUT   tt-fin-doc.contract-scale ) no-error.
     2319       if error-status:error then return no-apply.
     2320       assign
     2321         f-rest-con-sum = tt-fin-doc.sum-contr - tt-fin-doc.con-sum-contr
     2322         .
     2323       display
     2324         tt-fin-doc.sum-rubl
     2325         when v-rubf
     2326         tt-fin-doc.sum-doc
     2327         tt-fin-doc.exch-rate
     2328         when v-exchf
     2329         tt-fin-doc.exch-scale
     2330         when v-exchf
     2331         tt-fin-doc.sum-base
     2332         when v-basef
     2333         tt-fin-doc.base-rate
     2334         when v-baseratef
     2335         tt-fin-doc.base-scale
     2336         when v-baseratef
     2337         tt-fin-doc.sum-contr
     2338         when v-contractf
     2339         tt-fin-doc.contract-rate
     2340         when v-contractratef
     2341         tt-fin-doc.contract-scale
     2342         when v-contractratef
     2343         f-rest-con-sum
     2344         with frame Dialog-Frame .
     2345     END.
     2346   ON CHOOSE OF B-payer IN FRAME Dialog-Frame
     2347     DO:
     2348       define variable ref-list as character no-undo.
     2349       define variable ref-rec  as recid     no-undo.
     2350       define variable v-sum-vat-chr  as character no-undo .
     2351       define variable v-each-vat-chr as character no-undo.
     2352       define variable v-sum-vat      like ub.fin-doc-tax.sum-vat-line-doc no-undo .
     2353       define buffer buf_clients for ub.clients.
     2354   define variable vss-include-info23 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2355   if lookup(self :type
     2356            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     2357            ) = 0
     2358   then do:
     2359     message
     2360       "$Workfile$"
     2361       "Указанному интерфейсному элементу фокус не может быть передан" skip
     2362       "Интерфейсный элемент" self :name  skip
     2363       "Тип" self :type  skip
     2364       "Процедура" this-procedure :file-name skip
     2365       view-as alert-box .
     2366   end.
     2367   else do:
     2368     apply "entry":u to self  .
     2369     if focus :handle <> self :handle  then do:
     2370       return no-apply .
     2371     end.
     2372   end.
     2373   run ref/cli-all.w ( parParentProc
     2374     ,"b-sel"
     2375     , tt-fin-doc.payer-type
     2376     , ?
     2377     , ?
     2378     , (if available X_payer then recid(X_payer) else ?)
     2379     , ?
     2380     , "without-obj":U
     2381     , output ref-list) .
     2382   if ref-list = "" then
     2383   do:
     2384     return no-apply.
     2385   end.
     2386   ref-rec = integer( ref-list ).
     2387   FIND FIRST buf_clients WHERE recid (buf_clients) = ref-rec NO-LOCK .
     2388   if NOT (buf_clients.obj-type = 'орг':U
     2389     or
     2390     buf_clients.obj-type = 'чел':U ) then
     2391   do:
     2392     message
     2393       "Выберите контрагента типа" 'орг':U "или" 'чел':U
     2394       view-as alert-box error .
     2395     return no-apply.
     2396   end.
     2397   find first X_payer no-lock where
     2398     recid(X_payer) = recid(buf_clients).
     2399   assign
     2400     tt-fin-doc.payer-type = buf_clients.obj-type
     2401     tt-fin-doc.payer-code = buf_clients.obj-code
     2402     tt-fin-doc.payer-name = buf_clients.obj-name
     2403     .
     2404   display
     2405     tt-fin-doc.payer-type
     2406     tt-fin-doc.payer-code
     2407     tt-fin-doc.payer-name
     2408     with frame Dialog-Frame.
     2409   CASE X_payer.obj-type:   when 'чел':U then do:              find first X_payer-person no-lock where               X_payer-person.psn-code = X_payer.obj-code .   end.   when 'орг':U then do:     find first X_payer-firm no-lock where               X_payer-firm.firm-code = X_payer.obj-code .   end. END CASE. assign tt-fin-doc.payer-sign1  = if X_payer.obj-type = 'орг':U                              then X_payer-firm.director                             else X_payer.obj-name . display tt-fin-doc.payer-sign1 with frame Dialog-Frame.
     2410   find first ub.CashBook no-lock where ub.CashBook.id = tt-fin-doc.cashbookId no-error .
     2411   if ub.CashBook.cli-code = tt-fin-doc.payer-code and ub.CashBook.cli-type = tt-fin-doc.payer-type then do:
     2412   assign
     2413     tt-fin-doc.cor-acc1-value = ub.CashBook.OsnAcct
     2414     tt-fin-doc.cor-acc-value  = ub.CashBook.corrPko
     2415     tt-fin-doc.naznach-plat   = ub.CashBook.RuleOsnPko
     2416     .
     2417   find first X_fin-code-cor-acc no-lock where X_fin-code-cor-acc.code-value = tt-fin-doc.cor-acc-value
     2418     and X_fin-code-cor-acc.host-code = tt-fin-doc.host-code
     2419     and X_fin-code-cor-acc.status_ = integer('0':U)
     2420     no-error .
     2421   if available X_fin-code-cor-acc
     2422     then
     2423   do :
     2424     assign
     2425       f-cor-acc-descr    = X_fin-code-cor-acc.descr
     2426       tt-fin-doc.cor-acc = X_fin-code-cor-acc.fin-code
     2427       .
     2428   end.
     2429   find first X_fin-code-cor-acc1 no-lock where X_fin-code-cor-acc1.code-value = tt-fin-doc.cor-acc1-value
     2430     and X_fin-code-cor-acc1.host-code = tt-fin-doc.host-code
     2431     and X_fin-code-cor-acc1.status_ = integer('0':U)
     2432     no-error .
     2433   if available X_fin-code-cor-acc1
     2434     then
     2435   do :
     2436     assign
     2437       f-cor-acc1-descr   = X_fin-code-cor-acc1.descr
     2438       tt-fin-doc.cor-acc = X_fin-code-cor-acc1.fin-code
     2439       .
     2440   end.
     2441   assign
     2442     tt-fin-doc.including = "@, в том числе НДС" .
     2443     paramVne = "" .
     2444   end.
     2445   else
     2446   do:
     2447     if getCliKassa(tt-fin-doc.payer-type, tt-fin-doc.payer-code, "Vnecli", tt-fin-doc.cashbookId) then do:
     2448   assign
     2449     tt-fin-doc.cor-acc1-value = ub.CashBook.OsnAcct
     2450     .
     2451   find first ub.CashBookRule no-lock where ub.CashBookRule.CashBookID = tt-fin-doc.cashbookId
     2452     and ub.CashBookRule.Obj-type   = 'всем':U
     2453     and ub.CashBookRule.Obj-code   = 0
     2454     and ub.CashBookRule.Code       = "corrPkoVne"
     2455     no-error.
     2456   if available (ub.CashBookRule) then tt-fin-doc.cor-acc-value = ub.CashBookRule.RuleValue .
     2457   find first ub.CashBookRule no-lock where ub.CashBookRule.CashBookID = tt-fin-doc.cashbookId
     2458     and ub.CashBookRule.Obj-type   = 'всем':U
     2459     and ub.CashBookRule.Obj-code   = 0
     2460     and ub.CashBookRule.Code       = "RuleOsnPkoVne"
     2461     no-error.
     2462   if available (ub.CashBookRule) then tt-fin-doc.naznach-plat = ub.CashBookRule.RuleValue .
     2463   find first X_fin-code-cor-acc no-lock where X_fin-code-cor-acc.code-value = tt-fin-doc.cor-acc-value
     2464     and X_fin-code-cor-acc.host-code = tt-fin-doc.host-code
     2465     and X_fin-code-cor-acc.status_ = integer('0':U)
     2466     no-error .
     2467   if available X_fin-code-cor-acc
     2468     then
     2469   do :
     2470     assign
     2471       f-cor-acc-descr    = X_fin-code-cor-acc.descr
     2472       tt-fin-doc.cor-acc = X_fin-code-cor-acc.fin-code
     2473       .
     2474   end.
     2475   find first X_fin-code-cor-acc1 no-lock where X_fin-code-cor-acc1.code-value = tt-fin-doc.cor-acc1-value
     2476     and X_fin-code-cor-acc1.host-code = tt-fin-doc.host-code
     2477     and X_fin-code-cor-acc1.status_ = integer('0':U)
     2478     no-error .
     2479   if available X_fin-code-cor-acc1
     2480     then
     2481   do :
     2482     assign
     2483       f-cor-acc1-descr   = X_fin-code-cor-acc1.descr
     2484       tt-fin-doc.cor-acc = X_fin-code-cor-acc1.fin-code
     2485       .
     2486   end.
     2487   assign
     2488     tt-fin-doc.including = "@, в т.ч.: без налога (НДС)" .
     2489     paramVne = "vne" .
     2490   end.
     2491   else do:
     2492     if getCliKassa(tt-fin-doc.payer-type, tt-fin-doc.payer-code, "Avanscli", tt-fin-doc.cashbookId) then do:
     2493   assign
     2494     tt-fin-doc.cor-acc1-value = ub.CashBook.OsnAcct
     2495     .
     2496   find first ub.CashBookRule no-lock where ub.CashBookRule.CashBookID = tt-fin-doc.cashbookId
     2497     and ub.CashBookRule.Obj-type   = 'всем':U
     2498     and ub.CashBookRule.Obj-code   = 0
     2499     and ub.CashBookRule.Code       = "corrPkoAvans"
     2500     no-error.
     2501   if available (ub.CashBookRule) then tt-fin-doc.cor-acc-value = ub.CashBookRule.RuleValue .
     2502   find first ub.CashBookRule no-lock where ub.CashBookRule.CashBookID = tt-fin-doc.cashbookId
     2503     and ub.CashBookRule.Obj-type   = 'всем':U
     2504     and ub.CashBookRule.Obj-code   = 0
     2505     and ub.CashBookRule.Code       = "RuleOsnPkoAvans"
     2506     no-error.
     2507   if available (ub.CashBookRule) then tt-fin-doc.naznach-plat = ub.CashBookRule.RuleValue .
     2508   find first X_fin-code-cor-acc no-lock where X_fin-code-cor-acc.code-value = tt-fin-doc.cor-acc-value
     2509     and X_fin-code-cor-acc.host-code = tt-fin-doc.host-code
     2510     and X_fin-code-cor-acc.status_ = integer('0':U)
     2511     no-error .
     2512   if available X_fin-code-cor-acc
     2513     then
     2514   do :
     2515     assign
     2516       f-cor-acc-descr    = X_fin-code-cor-acc.descr
     2517       tt-fin-doc.cor-acc = X_fin-code-cor-acc.fin-code
     2518       .
     2519   end.
     2520   find first X_fin-code-cor-acc1 no-lock where X_fin-code-cor-acc1.code-value = tt-fin-doc.cor-acc1-value
     2521     and X_fin-code-cor-acc1.host-code = tt-fin-doc.host-code
     2522     and X_fin-code-cor-acc1.status_ = integer('0':U)
     2523     no-error .
     2524   if available X_fin-code-cor-acc1
     2525     then
     2526   do :
     2527     assign
     2528       f-cor-acc1-descr   = X_fin-code-cor-acc1.descr
     2529       tt-fin-doc.cor-acc = X_fin-code-cor-acc1.fin-code
     2530       .
     2531   end.
     2532   assign
     2533     tt-fin-doc.including = "@, в т.ч. 22/122 (НДС)" .
