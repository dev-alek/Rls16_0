     2001   PROCEDURE check-obj :
     2002     define input parameter p-check-obj-type as character no-undo .
     2003     define input parameter p-check-obj-code as integer no-undo .
     2004     define variable v-obj-db-num as integer no-undo init -1.
     2005     define variable v-cash-book  as integer no-undo .
     2006     define buffer buf_clients for ub.clients.
     2007     find first buf_clients no-lock where
     2008       buf_clients.obj-code = p-check-obj-code
     2009       and buf_clients.obj-type = p-check-obj-type no-error.
     2010     if not available buf_clients then
     2011     do:
     2012       if p-check-obj-code <> ?  then
     2013         message "Неправильный код или тип объекта" .
     2014       apply "entry" to tt-fin-doc.obj-code in frame Dialog-Frame.
     2015       return error.
     2016     end.
     2017     find first X_clients-obj no-lock where recid(X_clients-obj) = recid(buf_clients).
     2018     assign
     2019       tt-fin-doc.obj-type = buf_clients.obj-type
     2020       tt-fin-doc.obj-code = buf_clients.obj-code
     2021       .
