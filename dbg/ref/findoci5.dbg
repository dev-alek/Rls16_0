     5417   define variable vss-include-info58 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5418   define variable fh as widget-handle no-undo .
     5419   define variable hh as widget-handle no-undo .
     5420   define variable rv as character no-undo .
     5421   assign
     5422   rv = entry(1, return-value , chr(4)).
     5423   if rv <> "":U then do:
     5424     assign
     5425     fh = frame Dialog-Frame:first-child
     5426     hh = fh:first-child
     5427     .
     5428     do while valid-handle(hh):
     5429       if hh:name = rv then do:
     5430         APPLY "ENTRY" to hh.
     5431         undo ,
     5432         return error.
     5433       end.
     5434       hh = hh:next-sibling.
     5435     end.
     5436   end.
     5437     undo, return error.
     5438   end.
     5439   END PROCEDURE.
