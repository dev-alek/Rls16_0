     3005   ON CHOOSE OF B-cashbook IN FRAME Dialog-Frame
     3006     DO:
     3007       define variable v-cb-brw as class ibs.th.ref.cashbookbrw no-undo .
     3008       v-cb-brw = new ibs.th.ref.cashbookbrw ( 'ВЫБОР':U, parparentproc ).
     3009       wait-for  v-cb-brw:ShowDialog() .
     3010       if v-cb-brw:out-list-id > ""
     3011         then
     3012       do :
     3013         find first ub.cashbook no-lock where ub.cashbook.id = int64(v-cb-brw:out-list-id) .
     3014         tt-fin-doc.cashbookId = ub.cashbook.id .
     3015         f-cashbook = ub.CashBook.CashBookName .
     3016         display
     3017           f-cashbook
     3018           with frame Dialog-Frame .
     3019         IF LOOKUP("update_prc-doc-code-mask", THIS-PROCEDURE:INTERNAL-ENTRIES) >  0
     3020           THEN
     3021           run update_prc-doc-code-mask (no).
     3022         run check-obj in this-procedure (   input tt-fin-doc.obj-type
     3023           ,input tt-fin-doc.obj-code
     3024           )
     3025           no-error.
     3026         find first X_fin-code-cor-acc no-lock where X_fin-code-cor-acc.code-value = (if tt-fin-doc.fin-doc-type eq 'рко':U then ub.cashbook.corrRko else ub.cashbook.corrPko)
     3027           and X_fin-code-cor-acc.host-code = tt-fin-doc.host-code
     3028           and X_fin-code-cor-acc.status_ = integer('0':U)
     3029           no-error .
     3030         if available X_fin-code-cor-acc
     3031           then
     3032         do :
     3033           assign
     3034             tt-fin-doc.cor-acc-value = X_fin-code-cor-acc.code-value
     3035             f-cor-acc-descr          = X_fin-code-cor-acc.descr
     3036             tt-fin-doc.cor-acc       = X_fin-code-cor-acc.fin-code
     3037             .
     3038         end.
     3039         else
     3040         do:
     3041           if ub.cashbook.corrRko = "" then
     3042           do:
     3043             for first ub.fin-code-cor-acc no-lock where ub.fin-code-cor-acc.code-value = "57.01"
     3044               and ub.fin-code-cor-acc.host-code = p-curr-host-code :
     3045               tt-fin-doc.cor-acc = ub.fin-code-cor-acc.fin-code .
     3046               tt-fin-doc.cor-acc-value = ub.fin-code-cor-acc.code-value .
     3047             end.
     3048           end.
     3049         end.
     3050         if ub.CashBook.OsnAcct <> "" then
     3051         do:
     3052           find first X_fin-code-cor-acc no-lock where X_fin-code-cor-acc.code-value = ub.CashBook.OsnAcct
     3053             and X_fin-code-cor-acc.host-code = tt-fin-doc.host-code
     3054             and X_fin-code-cor-acc.status_ = integer('0':U)
     3055             no-error .
     3056           if available X_fin-code-cor-acc
     3057             then
     3058           do :
     3059             assign
     3060               tt-fin-doc.cor-acc1-value = X_fin-code-cor-acc.code-value
     3061               f-cor-acc1-descr          = X_fin-code-cor-acc.descr
     3062               tt-fin-doc.cor-acc1       = X_fin-code-cor-acc.fin-code
     3063               .
     3064           end.
     3065           else
     3066           do:
     3067             assign
     3068               tt-fin-doc.cor-acc1-value = ""
     3069               f-cor-acc1-descr          = ""
     3070               tt-fin-doc.cor-acc1       = ?
     3071               .
     3072           end.
     3073         end.
     3074       end.
     3075       display
     3076         tt-fin-doc.cor-acc-value
     3077         f-cor-acc-descr
     3078         tt-fin-doc.cor-acc
     3079         tt-fin-doc.cor-acc1-value
     3080         f-cor-acc1-descr
     3081         tt-fin-doc.cor-acc1
     3082         with frame Dialog-Frame .
     3083     END.
