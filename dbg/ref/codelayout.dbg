        1   block-level on error undo, throw.
        2   define new global shared variable g#language as character no-undo .
        3   if g#language <> '' and g#language <> 'rus':U then do:
        4     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
        5   end.
        6    define new shared temp-table tmprecid
        7       field Frecid as recid init ?
        8       field fnum as character
        9       field fTable as character
       10    index num  fnum Frecid
       11    index itable is primary unique fTable Frecid
       12    .
       13   define variable fSelect as logical no-undo format "*/" column-label "".
       14   function isSelect return logical
       15       (iBuffer as handle  ):
       16       define buffer tmprecid for tmprecid.
       17       if iBuffer:available
       18       then
       19          find first tmprecid where tmprecid.fTable = iBuffer:TABLE
       20                                and tmprecid.Frecid = iBuffer:recid
       21          no-lock no-error.
       22       return available tmprecid.
       23    end.
       24   function setSelect return logical
       25       (iBuffer as handle  ):
       26       define buffer tmprecid for tmprecid.
       27       if iBuffer:available
       28       then do:
       29          find first tmprecid where tmprecid.fTable = iBuffer:TABLE
       30                                and tmprecid.Frecid = iBuffer:recid
       31          no-lock no-error.
       32          if available tmprecid
       33          then
       34             delete tmprecid.
       35          else do:
       36             create tmprecid.
       37             assign
       38                tmprecid.fTable = iBuffer:TABLE
       39                tmprecid.Frecid = iBuffer:recid
       40             .
       41          end.
       42       end.
       43       return available tmprecid.
       44    end.
       45    procedure rid-keep :
       46        run gbl/rid-keep.p (input table tmprecid) no-error.
       47    end.
       48    procedure rid-rest :
       49         run gbl/rid-rest.p (output table tmprecid) no-error.
       50    end.
       51   define input  parameter Parparentproc  as handle    no-undo.
       52   define input  parameter iMode          as character no-undo.
       53   define input  parameter iParent        as character no-undo.
       54   define input  parameter iCode          as character no-undo.
       55   define input  parameter ititle         as character no-undo.
       56   define variable vss-revision    as character no-undo init "$Revision:$":U .
       57   define variable vss-author      as character no-undo init "$Author:$":U .
       58   define variable vss-date        as character no-undo init "$Date:$":U .
       59   define variable vss-workfile    as character no-undo init "$Workfile:$":U .
       60   define variable vss-archive     as character no-undo init "$Archive:$":U .
       61   define variable vss-description as character no-undo init "".
       62   procedure vss-get-info :
       63     define output parameter p-vss-revision    like vss-revision    no-undo .
       64     define output parameter p-vss-author      like vss-author      no-undo .
       65     define output parameter p-vss-date        like vss-date        no-undo .
       66     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       67     define output parameter p-vss-archive     like vss-archive     no-undo .
       68     define output parameter p-vss-description like vss-description no-undo .
       69     assign
       70       p-vss-revision    = vss-revision
       71       p-vss-author      = vss-author
       72       p-vss-date        = vss-date
       73       p-vss-workfile    = vss-workfile
       74       p-vss-archive     = vss-archive
       75       p-vss-description = vss-description
       76     .
       77   end procedure.
       78   procedure vss-get-parameters :
       79     define output parameter p-vss-parameters as character no-undo .
       80   end procedure.
       81   define new global shared variable g#vssrevis-logger as handle    no-undo .
       82   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       83   define variable v-vssrevis-logger                   as handle    no-undo .
       84   procedure vss-logevent :
       85     define input  parameter p-extra-paramters as character no-undo .
       86     define variable v-vssrevis-parameters as character no-undo .
       87     do
       88     on error undo, return error return-value
       89     :
       90       if  valid-handle(v-vssrevis-logger)
       91       and v-vssrevis-logger :get-signature("logevent") <> ""
       92       then do:
       93         run vss-get-parameters in this-procedure
       94           (output v-vssrevis-parameters
       95           ).
       96         run logevent in v-vssrevis-logger
       97           (input vss-workfile
       98           ,input vss-revision
       99           ,input v-vssrevis-parameters
      100           ,input p-extra-paramters
      101           ).
      102       end.
      103     end.
      104   end procedure.
      105   assign
      106     v-vssrevis-logger = g#vssrevis-logger
      107   .
      108   if  valid-handle(v-vssrevis-logger)
      109   and v-vssrevis-logger :get-signature("logevent") <> ""
      110   then do:
      111     assign
      112       v-vssrevis-logevent = true
      113     .
      114     run vss-logevent in this-procedure (input vss-description) .
      115   end.
      116   function objExists return character
      117   (input  ifolder as character,
      118    input  iType   as character  ):
      119       define variable vFileType as character no-undo init "D,F".
      120       define variable vi        as integer no-undo.
      121       define variable vtype as character no-undo.
      122       if iType ne ?
      123       then
      124          vFileType = iType.
      125       do vi = 1 to num-entries(vFileType):
      126          file-information:file-name = ".\" + right-trim(replace(ifolder,"/","\"),"\").
      127          vtype = file-information:file-type.
      128          if entry(num-entries(file-information:file-name, "\"), file-information:file-name, "\")
      129             = entry(num-entries(file-information:full-pathname, "\"), file-information:full-pathname ,"\") and
      130             index(vtype , entry(vi,vFileType )) > 0
      131          then return file-information:full-pathname .
      132          file-information:file-name = right-trim(replace(ifolder,"/","\"),"\").
      133          vtype = file-information:file-type.
      134          if file-information:file-name <> "" and
      135             entry(num-entries(file-information:file-name, "\"), file-information:file-name, "\")
      136             = entry(num-entries(file-information:full-pathname, "\"), file-information:full-pathname ,"\") and
      137             index( vtype, entry(vi,vFileType )) > 0
      138          then return file-information:full-pathname .
      139       end.
      140       return ? .
      141   end.
      142   function SearchFile return character
      143   (input  ifile as character):
      144      return objExists(ifile,?).
      145   end.
      146   function SearchPFile return character
      147   (input inFile as char):
      148        define variable oFile       as character no-undo.
      149        define variable vFileSearch as character no-undo.
      150        define variable vNumEntry   as integer no-undo.
      151        if inFile = "" then return ?.
      152        vNumEntry = num-entries(inFile,".").
      153        vFileSearch = inFile.
      154        if    vNumEntry > 0
      155           and (   entry(vNumEntry,inFile,".") eq "p"
      156                or entry(vNumEntry,inFile,".") eq "w")
      157        then do:
      158           entry(vNumEntry,vFileSearch, ".") = "r".
      159           oFile = search(vFileSearch ).
      160           if oFile eq ?
      161           then
      162              oFile = search(inFile).
      163        end.
      164        else
      165           oFile = search(vFileSearch).
      166        return oFile.
      167     end.
      168   find first code where code.parent eq iparent
      169                     and code.code   eq icode
      170                     no-lock no-error.
      171   if     available code
      172      and code.procview ne ""
      173      and code.procview ne ?
      174      and SearchPFile(code.procview)  ne ?
      175   then do:
      176      run value( code.procview) (Parparentproc, imode, code.parent , code.code,Code.CodeName).
      177   end.
      178   else do on error undo, leave:
      179      define variable mCodeTrg as class ibs.th.ref.code.code_trg no-undo.
      180      mCodeTrg = new ibs.th.ref.code.code_trg(imode).
      181      mCodeTrg:codeProcViewSet(iparent, icode).
      182      mCodeTrg:parent = left-trim(iparent + chr(4) + icode,chr(4)).
      183      mCodeTrg:startlevel = num-entries(mCodeTrg:parent,chr(4)).
      184      mCodeTrg:parparentproc = Parparentproc.
      185      if ititle ne "" and ititle ne ?
      186      then mCodeTrg:title = entry(1,ititle,chr(4)).
      187      else if available code
      188      then mCodeTrg:title = code.codename.
      189      if num-entries(ititle,chr(4)) > 1 then
      190        mCodeTrg:filter = entry(2,ititle,chr(4)).
      191      mCodeTrg:brwcode().
      192      finally:
      193          delete object mCodeTrg.
      194      end finally.
      195   end.
      196   define output  parameter table    for tmprecid.
