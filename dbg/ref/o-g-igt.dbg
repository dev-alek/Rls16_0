      151     run proc-alt-shift-f2.
      152   end.
      153   on alt-shift-f3 anywhere do:
      154     run proc-alt-shift-f3 in this-procedure .
      155   end.
      156   on alt-shift-f4 anywhere do:
      157     run proc-alt-shift-f4 in this-procedure.
      158   end.
      159   on alt-f1 anywhere do:
      160     run proc-alt-f1 in this-procedure .
      161   end.
      162   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      163   procedure gds-ind1 :
      164   main-block:
      165     do
      166   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      167   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      168   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      169     :
      170   define input-output parameter p-doc-rec  as recid no-undo.
      171   define input  parameter p-gds-code                   like  ub.gds-obj-prop.gds-code no-undo.
      172   define input  parameter p-obj-type                   like  ub.gds-obj-prop.obj-type no-undo.
      173   define input  parameter p-obj-code                   like  ub.gds-obj-prop.obj-code no-undo.
      174   define input  parameter p-gdop-igt                   like  ub.gds-obj-prop.gdop-igt no-undo.
      175   define input  parameter p-gdop-assort-min            like  ub.gds-obj-prop.gdop-assort-min  no-undo.
      176   define input  parameter p-gdop-min-stock             like  ub.gds-obj-prop.gdop-min-stock   no-undo.
      177   define input  parameter p-grop-level-always-presence like  ub.gds-obj-prop.grop-level-always-presence  no-undo.
      178   define input  parameter p-grop-max-stock             like  ub.gds-obj-prop.grop-max-stock              no-undo.
      179   define input  parameter p-grop-min-order             like  ub.gds-obj-prop.grop-min-order              no-undo.
      180   define buffer bufs_gds-obj-prop for ub.gds-obj-prop.
      181   define variable v-db-num like ub.db.db-num no-undo .
      182   define variable v-db-num-obj like ub.db.db-num no-undo .
      183   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      184   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
      185     (output v-db-num
      186     )  .
      187   define variable v-date as date no-undo .
      188   define variable v-time as integer no-undo .
      189   run cur-time in this-procedure(output v-date, output v-time).
      190     find first bufs_gds-obj-prop exclusive-lock where
      191               bufs_gds-obj-prop.gds-code          = p-gds-code   and
      192               bufs_gds-obj-prop.obj-type          = p-obj-type   and
      193               bufs_gds-obj-prop.obj-code          = p-obj-code  no-error .
      194       if not available bufs_gds-obj-prop then do:
      195           create bufs_gds-obj-prop.
      196           assign
      197               bufs_gds-obj-prop.gds-code           = p-gds-code
      198               bufs_gds-obj-prop.grop-date-update   = v-date
      199               bufs_gds-obj-prop.grop-time-update   = v-time
      200               bufs_gds-obj-prop.grop-db-num-update = v-db-num
      201               bufs_gds-obj-prop.obj-type           = p-obj-type
      202               bufs_gds-obj-prop.obj-code           = p-obj-code
      203           no-error .
      204           if error-status :error then message "Ошибка при создании записи" error-status :error error-status :get-message(1) .
      205       end.
      206   if  p-gdop-igt                     <> ? then    bufs_gds-obj-prop.gdop-igt                   = p-gdop-igt.
      207   if  p-gdop-assort-min              <> ? then    bufs_gds-obj-prop.gdop-assort-min            = p-gdop-assort-min.
      208   if  p-gdop-min-stock               <> ? then    bufs_gds-obj-prop.gdop-min-stock             = p-gdop-min-stock  .
      209   if  p-grop-level-always-presence   <> ? then    bufs_gds-obj-prop.grop-level-always-presence = p-grop-level-always-presence.
      210   if  p-grop-max-stock               <> ? then    bufs_gds-obj-prop.grop-max-stock             = p-grop-max-stock           .
      211   if  p-grop-min-order               <> ? then    bufs_gds-obj-prop.grop-min-order             = p-grop-min-order           .
      212         p-doc-rec = recid(bufs_gds-obj-prop)    .
      213   end.
      214   end procedure.
      215   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      216   def
      217   new shared
      218   temp-table  obj-list no-undo
      219     field obj-type like ub.clients.obj-type
      220     field obj-code like ub.clients.obj-code
      221     field obj-name like ub.clients.obj-name
      222     field obj-id   as integer
      223     field db-num   as integer
      224     index pi is primary unique obj-id
      225     index ie1 obj-type obj-code
      226     index ie2 obj-name
      227   .
      228   procedure create_obj-list :
      229      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      230      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      231      do
      232      on error undo, return error return-value
      233      :
      234         define buffer cli-obj for ub.clients .
      235         define variable p-var as integer no-undo .
      236         define buffer buf_obj-list for obj-list .
      237         find last buf_obj-list  use-index pi no-error .
      238         if available buf_obj-list
      239         then
      240            p-var = buf_obj-list.obj-id + 1.
      241         else
      242            p-var = 1.
      243         find first cli-obj where
      244                   cli-obj.obj-type = p-obj-type
      245               and cli-obj.obj-code = p-obj-code
      246         no-lock no-error.
      247         if available cli-obj
      248         then do:
      249            create buf_obj-list.
      250            assign
      251               buf_obj-list.obj-id   = p-var
      252               buf_obj-list.obj-code = cli-obj.obj-code
      253               buf_obj-list.obj-type = cli-obj.obj-type
      254               buf_obj-list.obj-name = cli-obj.obj-name
      255               buf_obj-list.db-num   = cli-obj.db-num
      256            .
      257         end.
      258      end.
      259   end.
      260   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      261     define variable v-cntxt-db-num        as integer   no-undo .
      262     define variable v-cntxt-userid        as character no-undo .
      263     define variable v-cntxt-level         as character no-undo .
      264     define variable v-cntxt-host-code-obj as integer   no-undo .
      265     define variable v-cntxt-obj-type      as character no-undo .
      266     define variable v-cntxt-obj-code      as integer   no-undo .
      267     define variable v-cntxt-db-num-obj    as integer   no-undo .
      268     define variable v-cntxt-is-admin      as logical   no-undo .
      269   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      270     run mainmenu_getcntxt in parparentproc
      271       (output v-cntxt-db-num
      272       ,output v-cntxt-userid
      273       ,output v-cntxt-level
      274       ,output v-cntxt-host-code-obj
      275       ,output v-cntxt-obj-type
      276       ,output v-cntxt-obj-code
      277       ,output v-cntxt-db-num-obj
      278       ,output v-cntxt-is-admin
      279       ) .
      280   assign
      281   p-old = ""
      282   p-new = ""
      283   p-obj-list = ""
      284   .
      285   DEFINE BUTTON B-Cancel AUTO-END-KEY
      286        LABEL "&Отмена"
      287        SIZE 10 BY 1
      288        BGCOLOR 8 .
      289   DEFINE BUTTON B-gds
      290        LABEL "Список товаров"
      291        SIZE 17 BY 1 TOOLTIP "Задания списка товаров"
      292        BGCOLOR 8 .
      293   DEFINE BUTTON B-Help
      294        LABEL "Помо&щь"
      295        SIZE 3 BY 1
      296        BGCOLOR 8 .
      297   DEFINE BUTTON B-obj
      298        LABEL "Список объектов"
      299        SIZE 17 BY 1 TOOLTIP "Задание списка объектов"
      300        BGCOLOR 8 .
      301   DEFINE BUTTON B-save AUTO-GO
      302        LABEL "&Ввод"
      303        SIZE 10 BY 1
      304        BGCOLOR 8 .
      305   DEFINE VARIABLE FILL-IN-1 AS CHARACTER FORMAT "X(256)":U INITIAL "Текущий ИЖТ:"
      306         VIEW-AS TEXT
      307        SIZE 14 BY .67
      308        FGCOLOR 4  NO-UNDO.
      309   DEFINE VARIABLE FILL-IN-2 AS CHARACTER FORMAT "X(256)":U INITIAL "Новый ИЖТ:"
      310         VIEW-AS TEXT
      311        SIZE 14 BY .67
      312        FGCOLOR 4  NO-UNDO.
      313   DEFINE VARIABLE R-new AS CHARACTER
      314        VIEW-AS RADIO-SET VERTICAL
      315        RADIO-BUTTONS
      316             "Основная группа", "2",
      317    "На вывод из ассортимента", "3"
      318        SIZE 29.5 BY 2.25 NO-UNDO.
      319   DEFINE VARIABLE R-old AS CHARACTER
      320        VIEW-AS RADIO-SET VERTICAL
      321        RADIO-BUTTONS
      322             "Новинка", "1",
      323     "Основная группа", "2"
      324        SIZE 29 BY 2.25 NO-UNDO.
      325   DEFINE FRAME Dialog-Frame
      326        B-save AT ROW 1 COL 1
      327        B-Cancel AT ROW 1 COL 11
      328        B-gds AT ROW 1 COL 26.5 WIDGET-ID 2
      329        B-obj AT ROW 1 COL 43.5 WIDGET-ID 4
      330        B-Help AT ROW 1 COL 61
      331        R-old AT ROW 3.75 COL 13 NO-LABEL
      332        R-new AT ROW 8.75 COL 13 NO-LABEL
      333        FILL-IN-1 AT ROW 2.75 COL 3 COLON-ALIGNED NO-LABEL
      334        FILL-IN-2 AT ROW 7.75 COL 3 COLON-ALIGNED NO-LABEL
      335        SPACE(46.12) SKIP(3.86)
      336       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      337            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      338            TITLE "Определение перехода ИЖТ у товаров"
      339            DEFAULT-BUTTON B-save CANCEL-BUTTON B-Cancel.
      340   ASSIGN
      341          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      342          FRAME Dialog-Frame:HIDDEN           = TRUE.
      343   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      344   DO:
      345     APPLY "END-ERROR":U TO SELF.
      346   END.
      347   ON CHOOSE OF B-Cancel IN FRAME Dialog-Frame
      348   DO:
      349     RETURN "no" .
      350   END.
      351   ON CHOOSE OF B-gds IN FRAME Dialog-Frame
      352   DO:
      353     run str/gds-list.w (input parparentproc, input v-cntxt-host-code-obj, input v-cntxt-obj-type, input v-cntxt-obj-code ) .
      354   END.
      355   ON CHOOSE OF B-obj IN FRAME Dialog-Frame
      356   DO:
      357   define buffer buf_clients for ub.clients  .
      358   define buffer buf_sysconf for ub.sysconf  .
      359   define variable v-list as character no-undo .
      360   define variable v-host-code as integer   no-undo .
      361   define variable v-num as integer no-undo .
      362   define variable ii    as integer no-undo .
      363      if v-cntxt-db-num = 0 then
      364       run ref/cli-all.w
      365         ( input parParentProc,
      366           input "b-sel,b-mark",
      367           input 'объект':U,
      368           input 'все':U,
      369           input 'текущие':U,
      370           input ?,
      371           input ?,
      372           input ?,
      373           output v-list
      374           ) .
      375         else
      376       run ref/cli-all.w
      377         ( input parParentProc,
      378           input "b-sel,b-mark",
      379           input "db",
      380           input 'все':U,
      381           input 'текущие':U,
      382           input ?,
      383           input ?,
      384           input ?,
      385           output v-list
      386           ) .
      387         if v-list = "" then return no-apply .
      388         assign p-obj-list = v-list .
      389   END.
      390   ON CHOOSE OF B-save IN FRAME Dialog-Frame
      391   DO:
      392     ASSIGN R-new R-old.
      393     if R-new =  R-old then do:
      394        MESSAGE "Вы выбрали одинаковые ИЖТ : " R-old  view-as alert-box information .
      395        return no-apply.
      396     end.
      397     assign
      398       p-old = r-old
      399       p-new = r-new
      400     .
      401   END.
      402   ON VALUE-CHANGED OF R-old IN FRAME Dialog-Frame
      403   DO:
      404     ASSIGN r-old .
      405     IF r-old = 'Основная группа':U THEN DO:
      406         r-new = 'На вывод из ассортимента':U.
      407         DISPLAY r-new with FRAME Dialog-Frame.
      408         END.
      409   END.
      410   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      411   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      412   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      413   on help of frame Dialog-Frame
      414   do:
      415     run gbl/app_help.p
      416       (input this-procedure :file-name
      417       ,input ''
      418       ,input ?
      419       ) no-error.
      420     if error-status :error then do:
      421       message
      422         "Ошибка при вызове помощи"
      423         error-status :get-message(1)
      424         view-as alert-box .
      425     end.
      426   end.
      427   run minbtn-set in this-procedure .
      428   on choose of b-help in frame Dialog-Frame
      429   do:
      430     apply "help":u to frame Dialog-Frame .
      431   end.
      432   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      433   procedure minbtn-set :
      434       do
      435           on error undo, return error return-value
      436           :
      437           define variable ii              as integer       no-undo .
      438           define variable fh              as widget-handle no-undo .
      439           define variable hh              as widget-handle no-undo .
      440           define variable v-h             as handle        extent 4 no-undo .
      441           define variable v-name-button   as character     no-undo .
      442           define variable v-help-old-x    as decimal       no-undo .
      443           define variable v-help-old-y    as decimal       no-undo .
      444           define variable v-help-old-size as decimal       no-undo .
      445           define variable v-frame-width   as decimal       no-undo .
      446           define variable jj              as integer       no-undo .
      447           do
      448               on error undo, return error
      449               :
      450               assign
      451                   v-frame-width = frame Dialog-Frame:width - 0.3
      452                   fh            = frame Dialog-Frame:first-child
      453                   hh            = fh:first-child
      454                   ii            = 1
      455                   .
      456               do while valid-handle(hh):
      457                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      458                   do:
      459                       case lc(hh:name) :
      460                           when "b-help" then
      461                               do:
      462                                   hh:load-image-up("cmp/b-help.bmp":u) .
      463                                   hh:load-image-down("cmp/b-help.bmp":u) .
      464                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      465                                   hh:TOOLTIP = "Помощь" .
      466                                   v-help-old-x = hh:column .
      467                                   v-help-old-y = hh:row    .
      468                                   v-help-old-size = hh:width .
      469                                   hh:width-chars = 2.5 .
      470                               end.
      471                           when "b-print" then
      472                               do:
      473                                   hh:load-image("cmp/b-print.bmp":u) .
      474                                   hh:TOOLTIP = "Печать" .
      475                                   v-h[ii] = hh:handle .
      476                                   ii = ii + 1 .
      477                                   hh:width-chars = 3 .
      478                               end.
      479                           when "b-history" or
      480                           when "b-hist" then
      481                               do:
      482                                   hh:load-image("cmp/b-hist.bmp":u) .
      483                                   hh:TOOLTIP = "История" .
      484                                   v-h[ii] = hh:handle .
      485                                   ii = ii + 1 .
      486                                   hh:width-chars = 3 .
      487                               end.
      488                           when "b-sch" then
      489                               do:
      490                                   hh:load-image("cmp/b-sch.bmp":u) .
      491                                   hh:TOOLTIP = "Установка Фильтра" .
      492                                   v-h[ii] = hh:handle .
      493                                   ii = ii + 1 .
      494                                   hh:width-chars = 3 .
      495                               end.
      496                           when "b-hist-user" then
      497                               do:
      498                                   hh:load-image("cmp/b-hist.bmp":u) .
      499                                   hh:TOOLTIP = "История пользователя" .
      500                                   ii = ii + 1 .
      501                               end.
      502                       end case.
      503                   end.
      504                   hh = hh:next-sibling.
      505               end.
      506               b-help:column = v-frame-width - b-help:width-chars.
      507               jj = 0.
      508               repeat ii = 4 to 1 by -1 :
      509                   if valid-handle (v-h[ii] ) then
      510                   do:
      511                       jj  = jj + 1 .
      512                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      513                       v-h[ii]:row    = v-help-old-y .
      514                   end.
      515               end.
      516           end.
      517       end.
      518   end procedure.
      519   MAIN-BLOCK:
      520   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      521      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      522     r-old:RADIO-BUTTONS in  frame Dialog-Frame = 'Новинка':U  + "," + 'Новинка':U  + "," +
      523                                                   'Нештатный':U + "," + 'Нештатный':U + "," +
      524                                                   'Основная группа':U  + "," + 'Основная группа':U
      525     .
      526     r-new:RADIO-BUTTONS in  frame Dialog-Frame = 'Основная группа':U  + "," + 'Основная группа':U  + "," +
      527                                                   'Нештатный':U + "," + 'Нештатный':U + "," +
      528                                                   'На вывод из ассортимента':U  + "," + 'На вывод из ассортимента':U
      529     .
      530    define variable v-log as logical   no-undo .
      531   define variable vss-include-info9 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      532   do:
      533     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      534       (input  g#db-num
      535       ,input  g#userid
      536       ,input  0
      537       ,input  'actn_assort-izt_update':U
      538       ,input  'global':U
      539       ,input  0
      540       ,input  '':U
      541       ,input  0
      542       ,input  0
      543       ,input  0
      544       ,input  0
      545       ,input  true
      546       ,output v-log
      547       )  .
      548   end.
      549    if not v-log then return no-apply .
      550     run enable_ui.
      551     WAIT-FOR GO OF FRAME Dialog-Frame.
      552   END.
      553   run disable_ui.
      554   PROCEDURE disable_UI :
      555     HIDE FRAME Dialog-Frame.
      556   END PROCEDURE.
      557   PROCEDURE enable_UI :
      558     DISPLAY R-old R-new FILL-IN-1 FILL-IN-2
      559         WITH FRAME Dialog-Frame.
      560     ENABLE B-save B-Cancel B-gds B-obj B-Help R-old R-new FILL-IN-1 FILL-IN-2
      561         WITH FRAME Dialog-Frame.
      562     VIEW FRAME Dialog-Frame.
      563   END PROCEDURE.
