      117   procedure proc-alt-shift-f2:
      118     if not ibs.th.gbl.gbl-var:rcode
      119   then
      120     run gbl\inidebug.p .
      121   end.
      122   procedure proc-alt-shift-f3:
      123     run gbl/prvssinf.p
      124       ( input this-procedure
      125       ) .
      126   end.
      127   define variable v-inform-launched as logical no-undo initial false .
      128   procedure proc-alt-shift-f4:
      129     define variable v-action as character no-undo .
      130     if v-inform-launched = false then do:
      131       assign
      132         v-inform-launched = true
      133       .
      134       run gbl/d-inform.w
      135         (  input self
      136         ,  input this-procedure
      137         , output v-action
      138         ) no-error .
      139       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      140       assign
      141         v-inform-launched = false
      142       .
      143     end.
      144   end.
