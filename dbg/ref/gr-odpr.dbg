        1   block-level on error undo, throw.
        2   define input  parameter parparentproc  as handle no-undo .
        3   define input  parameter p-db-num  like ub.sum-group.sgr-db-num no-undo .
        4   define input  parameter p-id      like ub.sum-group.sgr-id     no-undo .
        5   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        6   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        7   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        8   define variable vss-workfile    as character no-undo init "$Workfile: gr-odpr.p $":U .
        9   define variable vss-archive     as character no-undo init "$Archive: ref/gr-odpr.p $":U .
       10   define variable vss-description as character no-undo init "Удаление группы объектов для ценообразования".
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
       18     assign
       19       p-vss-revision    = vss-revision
       20       p-vss-author      = vss-author
       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29   end procedure.
       30   define new global shared variable g#vssrevis-logger as handle    no-undo .
       31   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       32   define variable v-vssrevis-logger                   as handle    no-undo .
       33   procedure vss-logevent :
       34     define input  parameter p-extra-paramters as character no-undo .
       35     define variable v-vssrevis-parameters as character no-undo .
       36     do
       37     on error undo, return error return-value
       38     :
       39       if  valid-handle(v-vssrevis-logger)
       40       and v-vssrevis-logger :get-signature("logevent") <> ""
       41       then do:
       42         run vss-get-parameters in this-procedure
       43           (output v-vssrevis-parameters
       44           ).
       45         run logevent in v-vssrevis-logger
       46           (input vss-workfile
       47           ,input vss-revision
       48           ,input v-vssrevis-parameters
       49           ,input p-extra-paramters
       50           ).
       51       end.
       52     end.
       53   end procedure.
       54   assign
       55     v-vssrevis-logger = g#vssrevis-logger
       56   .
       57   if  valid-handle(v-vssrevis-logger)
       58   and v-vssrevis-logger :get-signature("logevent") <> ""
       59   then do:
       60     assign
       61       v-vssrevis-logevent = true
       62     .
       63     run vss-logevent in this-procedure (input vss-description) .
       64   end.
       65   define new global shared variable g#language as character no-undo .
       66   if g#language <> '' and g#language <> 'rus':U then do:
       67     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       68   end.
       69   define new global shared variable g#library  as handle no-undo .
       70   define new global shared variable g#library2 as handle no-undo .
       71   procedure proc-alt-shift-f2:
       72     if not ibs.th.gbl.gbl-var:rcode
       73   then
       74     run gbl\inidebug.p .
       75   end.
       76   procedure proc-alt-shift-f3:
       77     run gbl/prvssinf.p
       78       ( input this-procedure
       79       ) .
       80   end.
       81   define variable v-inform-launched as logical no-undo initial false .
       82   procedure proc-alt-shift-f4:
       83     define variable v-action as character no-undo .
       84     if v-inform-launched = false then do:
       85       assign
       86         v-inform-launched = true
       87       .
       88       run gbl/d-inform.w
       89         (  input self
       90         ,  input this-procedure
       91         , output v-action
       92         ) no-error .
       93       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       94       assign
       95         v-inform-launched = false
       96       .
       97     end.
       98   end.
       99   procedure proc-alt-f1:
      100     run gbl/corrhelp.p
      101       (input this-procedure
      102       ) .
      103   end .
      104   on alt-shift-f2 anywhere do:
      105     run proc-alt-shift-f2.
      106   end.
      107   on alt-shift-f3 anywhere do:
      108     run proc-alt-shift-f3 in this-procedure .
      109   end.
      110   on alt-shift-f4 anywhere do:
      111     run proc-alt-shift-f4 in this-procedure.
      112   end.
      113   on alt-f1 anywhere do:
      114     run proc-alt-f1 in this-procedure .
      115   end.
      116   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      117     define variable v-cntxt-db-num        as integer   no-undo .
      118     define variable v-cntxt-userid        as character no-undo .
      119     define variable v-cntxt-level         as character no-undo .
      120     define variable v-cntxt-host-code-obj as integer   no-undo .
      121     define variable v-cntxt-obj-type      as character no-undo .
      122     define variable v-cntxt-obj-code      as integer   no-undo .
      123     define variable v-cntxt-db-num-obj    as integer   no-undo .
      124     define variable v-cntxt-is-admin      as logical   no-undo .
      125   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      126     run mainmenu_getcntxt in parparentproc
      127       (output v-cntxt-db-num
      128       ,output v-cntxt-userid
      129       ,output v-cntxt-level
      130       ,output v-cntxt-host-code-obj
      131       ,output v-cntxt-obj-type
      132       ,output v-cntxt-obj-code
      133       ,output v-cntxt-db-num-obj
      134       ,output v-cntxt-is-admin
      135       ) .
      136   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      137   define variable v-waitfram-action01         as character   no-undo .
      138   define variable v-waitfram-action02         as character   no-undo .
      139   define variable v-waitfram-action03         as character   no-undo .
      140   define variable mWaitFramTextBeg            as character   no-undo.
      141   define variable mWaitFramTextEnd            as character   no-undo.
      142   define variable mWaitFramView               as logical     no-undo.
      143   define variable mWaitProcEvent              as logical     no-undo init yes.
      144   define variable mWaitFramInterval           as integer     no-undo init 1 .
      145   define variable mWaitFramStop               as logical     no-undo.
      146   define variable mWaitFramStopUser           as logical     no-undo.
      147   define variable mWaitFramStopTimeOut        as logical     no-undo.
      148   define variable mWaitFramStartProc          as datetime-tz no-undo.
      149   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      150   define button B-WaitFramStop auto-end-key
      151        label "Стоп"
      152        size 10 by 1 tooltip "Остоновить процесс".
      153   define button B-viewProcInfo
      154        label "Информация"
      155        size 15 by 1 tooltip "Информация о процесс".
      156   define frame waitfram
      157     v-waitfram-action01 format "x(72)" no-label skip
      158     v-waitfram-action02 format "x(72)" no-label skip
      159     v-waitfram-action03 format "x(72)" no-label skip
      160     B-viewProcInfo
      161     B-WaitFramStop at row 4 col 30
      162     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      163     .
      164   define new global shared variable mBatchMode as logical no-undo init ?.
      165   define variable mFramBachModHandle as handle no-undo.
      166   mFramBachModHandle = frame waitfram:handle.
      167   define variable mFameOldVis as logical no-undo.
      168   define variable mVisCUrentVin as logical no-undo.
      169   if session:batch-mode
      170   then
      171      mBatchMode = yes.
      172   if mBatchMode = ? then do:
      173     mVisCUrentVin = current-window:visible.
      174     mFameOldVis = mFramBachModHandle:visible.
      175     mFramBachModHandle:visible  = yes.
      176     mBatchMode = mFramBachModHandle:visible ne yes.
      177     mFramBachModHandle:visible = mFameOldVis.
      178     current-window:visible = mVisCUrentVin.
      179   end.
      180    if  log-manager:logfile-name ne ?
      181     then DO:
      182         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      183         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      184         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      185     end.
      186   on choose of B-WaitFramStop in frame waitfram
      187   do:
      188     mWaitFramStop = yes.
      189     mWaitFramStopUser = yes.
      190   end.
      191   function waitfram-check-timeout returns logical():
      192      define variable vtime as int64 no-undo.
      193      if mWaitFramStopTimeOut
      194      then
      195         return yes.
      196      vtime = ( now - mWaitFramStartProc ) / 1000 .
      197      if     mWaitFramTimeOut ne ?
      198         and mWaitFramTimeOut ne 0
      199         and mWaitFramTimeOut lt vtime
      200      then do:
      201         mWaitFramStopTimeOut = yes.
      202      end.
      203      return mWaitFramStopTimeOut.
      204   end.
      205   procedure waitfram-hide :
      206     if not session:batch-mode
      207     then do
      208     on error undo, return error return-value
      209     :
      210       pause 0 before-hide .
      211       if not mBatchMode then
      212         hide frame waitfram .
      213     if     not mWaitFramView
      214        and mWaitProcEvent
      215     then
      216       process events .
      217     end.
      218   end procedure.
      219   procedure waitfram-show :
      220     define input  parameter p-message as character no-undo .
      221     define variable v-left-margin as integer   no-undo .
      222     if not session:batch-mode
      223     then do
      224     on error undo, return error return-value
      225     :
      226       if length(p-message) <= 70 then do:
      227         assign
      228           v-left-margin = integer((70 - length(p-message)) / 2)
      229         .
      230         assign
      231           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      232         .
      233         assign
      234           v-waitfram-action01 = " "
      235           v-waitfram-action02 = " "
      236                                    + fill(" ", v-left-margin)
      237                                    + p-message
      238           v-waitfram-action03 = " "
      239         .
      240       end.
      241       else do:
      242         define variable vRindex1 as integer no-undo.
      243         define variable vRindex2 as integer no-undo.
      244         vRindex1 = r-index(p-message," ",70).
      245         if vRindex1 = 0
      246         then
      247            vRindex1 = 70.
      248         if length(p-message)  <= vRindex1 + 70 then do:
      249           assign
      250             v-waitfram-action01 = " "
      251             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      252             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      253           .
      254         end.
      255         else do:
      256           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      257           if vRindex2 <= vRindex1
      258           then
      259              vRindex2 = vRindex1 + 70.
      260           assign
      261             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      262             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      263             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      264           .
      265         end.
      266       end.
      267       B-viewProcInfo:visible   in frame waitfram = no.
      268       B-viewProcInfo:sensitive in frame waitfram = no.
      269       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      270       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      271       if  (   mWaitFramView
      272          or  mWaitProcEvent)
      273          and not mBatchMode
      274       then
      275          display
      276             v-waitfram-action01 skip
      277             v-waitfram-action02 skip
      278             v-waitfram-action03 skip
      279          with frame waitfram .
      280       if     mWaitFramView
      281          then do:
      282             if     mWaitFramInterval ne ?
      283                and not mBatchMode
      284             then
      285                wait-for go of frame waitfram pause mWaitFramInterval.
      286          end.
      287          else
      288             if     mWaitProcEvent
      289                and not mBatchMode
      290             then
      291                process events .
      292     end.
      293   end procedure.
      294      procedure waitfram-show-this:
      295         define input  parameter iInterval as int64 no-undo.
      296         define variable vtime as int64 no-undo.
      297         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      298         mWaitFramInterval = iInterval.
      299         run waitfram-show (substitute("&1&2 &3&4" ,
      300                                       mWaitFramTextBeg ,
      301                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      302                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      303                                       mWaitFramTextEnd
      304                                      )
      305                           ).
      306      end.
      307      procedure WaitFramRunPause:
      308         define input  parameter iInterval as dec no-undo.
      309         define variable vStart  as datetime-tz no-undo.
      310         define variable vend    as datetime-tz no-undo.
      311         define variable vint as int64 no-undo.
      312         define variable vOk as logical no-undo.
      313         vStart = now.
      314         vend   = vStart.
      315         publish "WaitFramPause" (iInterval,output vOk).
      316         vend   =  now.
      317         vint = vend - vStart.
      318         vint = iInterval - vint / 1000.
      319         if     not mWaitFramStop
      320            and (   vint > 0
      321                 or (    not vOk
      322                     and iInterval eq ?
      323                     )
      324                 )
      325         then
      326            run waitfram-show-this (iInterval).
      327         vend   =  now.
      328         vint = vend - vStart.
      329         vint = iInterval - vint / 1000.
      330         if     not mWaitFramStop
      331            and vint > 0
      332         then do:
      333            run gbl/pause.p (vint * 1000).
      334         end.
      335         if iInterval ne ?
      336         then
      337            publish "WaitFramStop".
      338         waitfram-check-timeout().
      339      end.
      340      procedure WaitFramWaitFor:
      341         define input  parameter iInterval as dec no-undo.
      342         assign
      343            mWaitFramStartProc   = now
      344            mWaitFramStopUser    = no
      345            mWaitFramStopTimeOut = no
      346         .
      347         block-wait:
      348         do while not mWaitFramStop:
      349            run WaitFramRunPause (iInterval).
      350            if  waitfram-check-timeout()
      351            then do:
      352               leave block-wait.
      353            end.
      354         end.
      355         run waitfram-hide.
      356      end.
      357   procedure waitfram-join :
      358     define input  parameter p-line-1  as character no-undo .
      359     define input  parameter p-line-2  as character no-undo .
      360     define input  parameter p-line-3  as character no-undo .
      361     define output parameter p-message as character no-undo .
      362     do
      363     on error undo, return error return-value
      364     :
      365       assign
      366         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      367                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      368                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      369       .
      370     end.
      371   end procedure.
      372   function waitfram-join-function returns character
      373     (input p-line-1 as character
      374     ,input p-line-2 as character
      375     ,input p-line-3 as character
      376     ).
      377     define variable v-message as character no-undo .
      378     run waitfram-join in this-procedure
      379       (input  p-line-1
      380       ,input  p-line-2
      381       ,input  p-line-3
      382       ,output v-message
      383       ) .
      384     return v-message .
      385   end function .
      386   define variable v-sec as integer   no-undo .
      387   PROCEDURE obji-add :
      388   define input  parameter p-db-num       as integer   no-undo .
      389   define input  parameter p-id           as integer   no-undo .
      390   define input  parameter p-dgo-db-num   as integer   no-undo .
      391   define input  parameter p-stts         as integer   no-undo .
      392   define input  parameter p-db-num-usr   as integer   no-undo .
      393   define input  parameter p-userid       as character no-undo .
      394   define output parameter p-recid as recid no-undo .
      395     do
      396     on error undo, return error return-value
      397     :
      398   find first ub.grp-obj-price exclusive-lock where
      399           ub.grp-obj-price.gop-db-num   = p-db-num  and
      400           ub.grp-obj-price.gop-id       = p-id
      401           no-error .
      402     if error-status :error then do:
      403         message
      404           vss-workfile vss-revision vss-description skip
      405           error-status :get-message(1) skip
      406           return-value skip
      407           ""
      408           view-as alert-box error
      409         .
      410         return error .
      411     end.
      412   find first ub.db-grp-obj-price exclusive-lock where
      413           ub.db-grp-obj-price.gop-db-num   = p-db-num  and
      414           ub.db-grp-obj-price.gop-id       = p-id      and
      415           ub.db-grp-obj-price.dgo-db-num   = p-dgo-db-num
      416           no-error .
      417         if not available ub.db-grp-obj-price then do:
      418             create ub.db-grp-obj-price.
      419               assign
      420                   ub.db-grp-obj-price.gop-db-num = p-db-num
      421                   ub.db-grp-obj-price.gop-id     = p-id
      422                   ub.db-grp-obj-price.dgo-db-num = p-dgo-db-num
      423               .
      424         end.
      425         assign
      426           ub.db-grp-obj-price.num-chg    = p-db-num-usr
      427           ub.db-grp-obj-price.stts          = p-stts
      428           ub.db-grp-obj-price.sys-date      = today
      429           ub.db-grp-obj-price.sys-time      = time
      430           ub.db-grp-obj-price.sys-time-chr  = string ( ub.db-grp-obj-price.sys-time,"hh:mm" )
      431           ub.db-grp-obj-price.who           = p-userid
      432           p-recid = recid ( ub.db-grp-obj-price )
      433         .
      434         ub.grp-obj-price.sys-time = time .
      435         run ref/h-grpo.p (buffer ub.db-grp-obj-price , input-output v-sec )  .
      436     end.
      437   end procedure.
      438   PROCEDURE obji-del :
      439   define input  parameter p-db-num       as integer   no-undo .
      440   define input  parameter p-id           as integer   no-undo .
      441   define input  parameter p-dgo-db-num   as integer   no-undo .
      442   define input  parameter p-db-num-usr   as integer   no-undo .
      443   define input  parameter p-userid       as character no-undo .
      444     do
      445     on error undo, return error return-value
      446     :
      447   find first ub.grp-obj-price exclusive-lock where
      448           ub.grp-obj-price.gop-db-num   = p-db-num  and
      449           ub.grp-obj-price.gop-id       = p-id
      450           .
      451   find first ub.db-grp-obj-price exclusive-lock where
      452           ub.db-grp-obj-price.gop-db-num   = p-db-num  and
      453           ub.db-grp-obj-price.gop-id       = p-id      and
      454           ub.db-grp-obj-price.dgo-db-num = p-dgo-db-num
      455           no-error .
      456    if not available ub.db-grp-obj-price then  return error .
      457         assign
      458           ub.db-grp-obj-price.num-chg    = p-db-num-usr
      459           ub.db-grp-obj-price.stts          = 1
      460           ub.db-grp-obj-price.sys-date      = today
      461           ub.db-grp-obj-price.sys-time      = time
      462           ub.db-grp-obj-price.sys-time-chr  = string(ub.db-grp-obj-price.sys-time,"hh:mm")
      463           ub.db-grp-obj-price.who           = p-userid
      464         .
      465         run ref/h-grpo.p (buffer ub.db-grp-obj-price , input-output v-sec )  .
      466         ub.grp-obj-price.sys-time = time .
      467     end.
      468   end procedure.
      469   PROCEDURE objf-add :
      470   define input  parameter p-db-num       as integer   no-undo .
      471   define input  parameter p-id           as integer   no-undo .
      472   define input  parameter p-host-code    as integer   no-undo .
      473   define input  parameter p-stts         as integer   no-undo .
      474   define input  parameter p-db-num-usr   as integer   no-undo .
      475   define input  parameter p-userid       as character no-undo .
      476   define output parameter p-recid as recid no-undo .
      477     do
      478     on error undo, return error return-value
      479     :
      480   find first ub.sysconf no-lock where recid(ub.sysconf) = p-host-code .
      481   if available ub.sysconf then do:
      482      p-host-code = ub.sysconf.host-code .
      483   end.
      484   find first ub.grp-obj-price exclusive-lock where
      485           ub.grp-obj-price.gop-db-num   = p-db-num  and
      486           ub.grp-obj-price.gop-id       = p-id
      487           .
      488   find first ub.host-grp-obj-price exclusive-lock where
      489           ub.host-grp-obj-price.gop-db-num   = p-db-num  and
      490           ub.host-grp-obj-price.gop-id       = p-id      and
      491           ub.host-grp-obj-price.host-code    = p-host-code
      492           no-error .
      493         if not available ub.host-grp-obj-price then do:
      494             create ub.host-grp-obj-price.
      495               assign
      496                   ub.host-grp-obj-price.gop-db-num   = p-db-num
      497                   ub.host-grp-obj-price.gop-id       = p-id
      498                   ub.host-grp-obj-price.host-code    = p-host-code
      499               .
      500         end.
      501         assign
      502           ub.host-grp-obj-price.db-num-chg    = p-db-num-usr
      503           ub.host-grp-obj-price.stts          = p-stts
      504           ub.host-grp-obj-price.sys-date      = today
      505           ub.host-grp-obj-price.sys-time      = time
      506           ub.host-grp-obj-price.sys-time-chr  = string ( ub.host-grp-obj-price.sys-time,"hh:mm" )
      507           ub.host-grp-obj-price.who           = p-userid
      508           p-recid = recid ( ub.host-grp-obj-price )
      509         .
      510         ub.grp-obj-price.sys-time = time .
      511         run ref/h-grph.p (buffer ub.host-grp-obj-price , input-output v-sec )  .
      512     end.
      513   end procedure.
      514   PROCEDURE objf-del :
      515   define input  parameter p-db-num       as integer   no-undo .
      516   define input  parameter p-id           as integer   no-undo .
      517   define input  parameter p-host-code   as integer   no-undo .
      518   define input  parameter p-db-num-usr   as integer   no-undo .
      519   define input  parameter p-userid       as character no-undo .
      520     do
      521     on error undo, return error return-value
      522     :
      523   find first ub.grp-obj-price exclusive-lock where
      524           ub.grp-obj-price.gop-db-num   = p-db-num  and
      525           ub.grp-obj-price.gop-id       = p-id
      526           .
      527   find first ub.host-grp-obj-price exclusive-lock where
      528           ub.host-grp-obj-price.gop-db-num   = p-db-num  and
      529           ub.host-grp-obj-price.gop-id       = p-id      and
      530           ub.host-grp-obj-price.host-code    = p-host-code
      531           no-error .
      532    if not available ub.host-grp-obj-price then  return error .
      533         assign
      534           ub.host-grp-obj-price.db-num-chg    = p-db-num-usr
      535           ub.host-grp-obj-price.stts          = 1
      536           ub.host-grp-obj-price.sys-date      = today
      537           ub.host-grp-obj-price.sys-time      = time
      538           ub.host-grp-obj-price.sys-time-chr  = string(ub.host-grp-obj-price.sys-time,"hh:mm")
      539           ub.host-grp-obj-price.who           = p-userid
      540         .
      541          ub.grp-obj-price.sys-time = time .
      542          run ref/h-grph.p (buffer ub.host-grp-obj-price , input-output v-sec )  .
      543     end.
      544   end procedure.
      545   PROCEDURE objo-add :
      546   define input  parameter p-db-num       as integer   no-undo .
      547   define input  parameter p-id           as integer   no-undo .
      548   define input  parameter p-obj-type     as character no-undo .
      549   define input  parameter p-obj-code     as integer   no-undo .
      550   define input  parameter p-stts         as integer   no-undo .
      551   define input  parameter p-db-num-usr   as integer   no-undo .
      552   define input  parameter p-userid       as character no-undo .
      553   define output parameter p-recid as recid no-undo .
      554     do
      555     on error undo, return error return-value
      556     :
      557   find first ub.grp-obj-price exclusive-lock where
      558           ub.grp-obj-price.gop-db-num   = p-db-num  and
      559           ub.grp-obj-price.gop-id       = p-id
      560           .
      561   find first ub.obj-grp-obj-price exclusive-lock where
      562           ub.obj-grp-obj-price.gop-db-num   = p-db-num  and
      563           ub.obj-grp-obj-price.gop-id       = p-id      and
      564           ub.obj-grp-obj-price.obj-type    = p-obj-type and
      565           ub.obj-grp-obj-price.obj-code    = p-obj-code
      566           no-error .
      567         if not available ub.obj-grp-obj-price then do:
      568             create ub.obj-grp-obj-price.
      569               assign
      570                   ub.obj-grp-obj-price.gop-db-num   = p-db-num
      571                   ub.obj-grp-obj-price.gop-id       = p-id
      572                   ub.obj-grp-obj-price.obj-type    = p-obj-type
      573                   ub.obj-grp-obj-price.obj-code    = p-obj-code
      574               .
      575         end.
      576         assign
      577           ub.obj-grp-obj-price.db-num-chg    = p-db-num-usr
      578           ub.obj-grp-obj-price.stts          = p-stts
      579           ub.obj-grp-obj-price.sys-date      = today
      580           ub.obj-grp-obj-price.sys-time      = time
      581           ub.obj-grp-obj-price.sys-time-chr  = string ( ub.obj-grp-obj-price.sys-time,"hh:mm" )
      582           ub.obj-grp-obj-price.who           = p-userid
      583           p-recid = recid ( ub.obj-grp-obj-price )
      584         .
      585         ub.grp-obj-price.sys-time = time .
      586         run ref/h-grpi.p (buffer ub.obj-grp-obj-price , input-output v-sec )  .
      587     end.
      588   end procedure.
      589   PROCEDURE objo-del :
      590   define input  parameter p-db-num       as integer   no-undo .
      591   define input  parameter p-id           as integer   no-undo .
      592   define input  parameter p-obj-type   as character no-undo .
      593   define input  parameter p-obj-code   as integer   no-undo .
      594   define input  parameter p-db-num-usr   as integer   no-undo .
      595   define input  parameter p-userid       as character no-undo .
      596     do
      597     on error undo, return error return-value
      598     :
      599   find first ub.grp-obj-price exclusive-lock where
      600           ub.grp-obj-price.gop-db-num   = p-db-num  and
      601           ub.grp-obj-price.gop-id       = p-id
      602           .
      603   find first ub.obj-grp-obj-price exclusive-lock where
      604           ub.obj-grp-obj-price.gop-db-num   = p-db-num  and
      605           ub.obj-grp-obj-price.gop-id       = p-id      and
      606           ub.obj-grp-obj-price.obj-type    = p-obj-type and
      607           ub.obj-grp-obj-price.obj-code    = p-obj-code
      608           no-error .
      609    if not available ub.obj-grp-obj-price then  return error .
      610         assign
      611           ub.obj-grp-obj-price.db-num-chg    = p-db-num-usr
      612           ub.obj-grp-obj-price.stts          = 1
      613           ub.obj-grp-obj-price.sys-date      = today
      614           ub.obj-grp-obj-price.sys-time      = time
      615           ub.obj-grp-obj-price.sys-time-chr  = string(ub.obj-grp-obj-price.sys-time,"hh:mm")
      616           ub.obj-grp-obj-price.who           = p-userid
      617         .
      618        ub.grp-obj-price.sys-time = time .
      619        run ref/h-grpi.p (buffer ub.obj-grp-obj-price , input-output v-sec )  .
      620     end.
      621   end procedure.
      622   find first ub.grp-obj-price no-lock where
      623              ub.grp-obj-price.gop-db-num = p-db-num    and
      624              ub.grp-obj-price.gop-id     = p-id
      625              no-error .
      626   find first ub.price-list-type no-lock where
      627              ub.price-list-type.stts = integer('0':U) and
      628              ub.price-list-type.gop-db-num = p-db-num    and
      629              ub.price-list-type.gop-id     = p-id no-error .
      630             if available ub.price-list-type then do:
      631             message "По этой группе объектов есть ТПЛ (Справочник типов прайс-листов) . Удалять нельзя !" skip
      632                     "ТПЛ " ub.price-list-type.plt-id skip
      633                     "БД"   ub.price-list-type.plt-db-num
      634                     view-as alert-box information  .
      635             return .
      636             end.
      637   find first ub.price-list-type no-lock where
      638              ub.price-list-type.stts = integer('0':U) and
      639              ub.price-list-type.gop-db-num-for-calc-turnover = p-db-num    and
      640              ub.price-list-type.gop-id-for-calc-turnover     = p-id no-error .
      641             if available ub.price-list-type then do:
      642             message "На эту группу ссылается ТПЛ (Справочник типов прайс-листов) . Удалять нельзя !" skip
      643                     "ТПЛ " ub.price-list-type.plt-id skip
      644                     "БД"   ub.price-list-type.plt-db-num
      645                     view-as alert-box information  .
      646             return .
      647             end.
      648   find first ub.grp-obj-price exclusive-lock where
      649              ub.grp-obj-price.gop-db-num = p-db-num    and
      650              ub.grp-obj-price.gop-id     = p-id
      651              no-error .
      652   run waitfram-show ("Ждите...") .
      653     ub.grp-obj-price.stts = 1.
      654     for each  ub.db-grp-obj-price exclusive-lock where
      655               ub.db-grp-obj-price.gop-db-num = p-db-num    and
      656               ub.db-grp-obj-price.gop-id     = p-id
      657               :
      658           run obji-del(
      659              input   ub.db-grp-obj-price.gop-db-num
      660             ,input   ub.db-grp-obj-price.gop-id
      661             ,input   ub.db-grp-obj-price.dgo-db-num
      662             ,input   v-cntxt-db-num
      663             ,input   v-cntxt-userid ) .
      664     end.
      665     for each  ub.host-grp-obj-price exclusive-lock where
      666               ub.host-grp-obj-price.gop-db-num = p-db-num    and
      667               ub.host-grp-obj-price.gop-id     = p-id
      668               :
      669           run objf-del(
      670              input   ub.host-grp-obj-price.gop-db-num
      671             ,input   ub.host-grp-obj-price.gop-id
      672             ,input   ub.host-grp-obj-price.host-code
      673             ,input   v-cntxt-db-num
      674             ,input   v-cntxt-userid ) .
      675     end.
      676     for each  ub.obj-grp-obj-price exclusive-lock where
      677               ub.obj-grp-obj-price.gop-db-num = p-db-num    and
      678               ub.obj-grp-obj-price.gop-id     = p-id
      679               :
      680           run objo-del(
      681              input   ub.obj-grp-obj-price.gop-db-num
      682             ,input   ub.obj-grp-obj-price.gop-id
      683             ,input   ub.obj-grp-obj-price.obj-type
      684             ,input   ub.obj-grp-obj-price.obj-code
      685             ,input   v-cntxt-db-num
      686             ,input   v-cntxt-userid ) .
      687     end.
      688   run waitfram-hide .
