     1412   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1413   define temp-table temp-diasize-handle no-undo
     1414     field handle-value  as handle
     1415     field save-position as decimal
     1416     index xpk is primary unique handle-value
     1417     .
     1418   define temp-table temp-browse-handle no-undo
     1419     field browse-type   as character
     1420     field browse-number as integer
     1421     field browse-handle as handle
     1422     field original-size as decimal
     1423     index xpk is primary unique browse-type browse-number
     1424     index xie browse-type browse-handle
     1425   .
     1426   procedure diasize_change-height :
     1427     define input  parameter p-change-value  as decimal   no-undo .
     1428     define input  parameter p-move-resize   as logical   no-undo .
     1429     define variable v-field-group-handle    as handle    no-undo .
     1430     define variable v-object-handle         as handle    no-undo .
     1431     define variable v-frame-height          as decimal   no-undo .
     1432     define variable v-frame-virtual-height  as decimal   no-undo .
     1433     define variable v-browse-height         as decimal   no-undo .
     1434     define variable v-window-height         as decimal   no-undo .
     1435     define variable v-window-virtual-height as decimal   no-undo .
     1436     define variable v-change-sign           as integer   no-undo .
     1437     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1438     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1439     if p-change-value > 0
     1440     then do:
     1441       if frame Dialog-Frame :height + p-change-value
     1442           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1443       then do:
     1444         assign
     1445           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1446                           - (frame Dialog-Frame :height-chars)
     1447         .
     1448         if p-change-value <= 0
     1449         then do:
     1450           run diasize_position-resize-button in this-procedure .
     1451           return .
     1452         end.
     1453       end.
     1454     end.
     1455     if p-change-value < 0
     1456     then do:
     1457       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1458       then do:
     1459         assign
     1460           p-change-value = v-diasize-orig-frame-height
     1461                          - (frame Dialog-Frame :height-chars)
     1462         .
     1463         if p-change-value >= 0
     1464         then do:
     1465           run diasize_position-resize-button in this-procedure .
     1466           return .
     1467         end.
     1468       end.
     1469     end.
     1470     if p-change-value >= 0
     1471     then do:
     1472       assign
     1473         v-change-sign = 1
     1474       .
     1475     end.
     1476     else do:
     1477       assign
     1478         v-change-sign = -1
     1479       .
     1480     end.
     1481     assign
     1482       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1483     .
     1484     if p-change-value = 0
     1485     then do:
     1486       run diasize_position-resize-button in this-procedure .
     1487       return .
     1488     end.
     1489     move_block:
     1490     do
     1491     on error undo move_block, retry move_block
     1492     :
     1493       if retry
     1494       then do:
     1495         do
     1496         on error undo move_block, leave move_block
     1497         :
     1498           if p-change-value > 0
     1499           then do:
     1500             for each buf_temp-diasize-handle
     1501             on error undo, next
     1502             :
     1503               assign
     1504                 v-object-handle = buf_temp-diasize-handle.handle-value
     1505               .
     1506               if v-object-handle <> v-diasize-resize-button
     1507               then do:
     1508                 assign
     1509                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1510                 .
     1511               end.
     1512             end.
     1513             assign
     1514               v-diasize-browse-handle :height = v-browse-height
     1515             .
     1516             for each buf_temp-browse-handle
     1517               where buf_temp-browse-handle.browse-type = 'height':u
     1518             on error undo, next
     1519             :
     1520               assign
     1521                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1522               .
     1523             end.
     1524             assign
     1525               frame Dialog-Frame :height = v-frame-height
     1526             .
     1527             if frame Dialog-Frame :scrollable = true
     1528             then do:
     1529               assign
     1530                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1531               .
     1532             end.
     1533             run diasize_position-resize-button in this-procedure .
     1534           end.
     1535           else do:
     1536             if frame Dialog-Frame :scrollable = true
     1537             then do:
     1538               assign
     1539                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1540               .
     1541             end.
     1542             assign
     1543               frame Dialog-Frame :height = v-frame-height
     1544             .
     1545             assign
     1546               v-diasize-browse-handle :height = v-browse-height
     1547             .
     1548             for each buf_temp-browse-handle
     1549               where buf_temp-browse-handle.browse-type = 'height':u
     1550             on error undo, next
     1551             :
     1552               assign
     1553                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1554               .
     1555             end.
     1556             for each buf_temp-diasize-handle
     1557             on error undo, next
     1558             :
     1559               assign
     1560                 v-object-handle = buf_temp-diasize-handle.handle-value
     1561               .
     1562               if v-object-handle <> v-diasize-resize-button
     1563               then do:
     1564                 assign
     1565                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1566                 .
     1567               end.
     1568             end.
     1569             run diasize_position-resize-button in this-procedure .
     1570           end.
     1571           assign
     1572             v-diasize-change-size = false
     1573           .
     1574           leave move_block .
     1575         end.
     1576       end.
     1577       assign
     1578         v-diasize-need-full-display = true
     1579       .
     1580       if v-diasize-change-size = false
     1581       then do:
     1582         assign
     1583           v-diasize-change-size = true
     1584         .
     1585       end.
     1586       else do:
     1587         return .
     1588       end.
     1589       assign
     1590         v-frame-height = frame Dialog-Frame :height
     1591         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1592         v-browse-height = v-diasize-browse-handle :height
     1593       .
     1594       for each buf_temp-browse-handle
     1595         where buf_temp-browse-handle.browse-type = 'height':u
     1596       :
     1597         assign
     1598           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1599         .
     1600       end.
     1601       for each buf_temp-diasize-handle
     1602       :
     1603         delete buf_temp-diasize-handle .
     1604       end.
     1605       assign
     1606         v-field-group-handle = frame Dialog-Frame :first-child
     1607       .
     1608       do while valid-handle(v-field-group-handle)
     1609       :
     1610         assign
     1611           v-object-handle = v-field-group-handle :first-child
     1612         .
     1613         do while valid-handle(v-object-handle)
     1614         :
     1615           if  v-object-handle <> v-diasize-browse-handle :handle
     1616           and can-query(v-object-handle, "row")
     1617           and can-query(v-object-handle, "height")
     1618           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1619           then do:
     1620             find first buf_temp-browse-handle
     1621               where buf_temp-browse-handle.browse-type   = 'height':u
     1622                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1623               no-error .
     1624             if available buf_temp-browse-handle
     1625             then do:
     1626             end.
     1627             else do:
     1628               create buf_temp-diasize-handle .
     1629               assign
     1630                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1631                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1632               .
     1633             end.
     1634           end.
     1635           assign
     1636             v-object-handle = v-object-handle :next-sibling
     1637           .
     1638         end.
     1639         assign
     1640           v-field-group-handle = v-field-group-handle :next-sibling
     1641         .
     1642       end.
     1643       do with frame Dialog-Frame
     1644       :
     1645         hide v-diasize-resize-button .
     1646         assign
     1647           v-diasize-resize-button :row    = 1
     1648           v-diasize-resize-button :column = 1
     1649         .
     1650       end.
     1651       if p-change-value > 0
     1652       then do:
     1653         if frame Dialog-Frame :scrollable = true
     1654         then do:
     1655           assign
     1656             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1657             no-error .
     1658           if error-status :error
     1659           or error-status :get-message(1) <> ""
     1660           then do:
     1661             undo move_block, retry move_block .
     1662           end.
     1663         end.
     1664         assign
     1665           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1666           no-error .
     1667         if error-status :error
     1668         or error-status :get-message(1) <> ""
     1669         then do:
     1670           undo move_block, retry move_block .
     1671         end.
     1672         assign
     1673           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1674           no-error .
     1675         if error-status :error
     1676         or error-status :get-message(1) <> ""
     1677         then do:
     1678           undo move_block, retry move_block .
     1679         end.
     1680         for each buf_temp-browse-handle
     1681           where buf_temp-browse-handle.browse-type = 'height':u
     1682         on error undo move_block, retry move_block
     1683         :
     1684           assign
     1685             buf_temp-browse-handle.browse-handle :height
     1686               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1687             no-error .
     1688           if error-status :error
     1689           or error-status :get-message(1) <> ""
     1690           then do:
     1691             undo move_block, retry move_block .
     1692           end.
     1693         end.
     1694         for each buf_temp-diasize-handle
     1695         on error undo move_block, retry move_block
     1696         :
     1697           assign
     1698             v-object-handle = buf_temp-diasize-handle.handle-value
     1699           .
     1700           if v-object-handle <> v-diasize-resize-button
     1701           then do:
     1702             assign
     1703               v-object-handle :row = v-object-handle :row + p-change-value
     1704               no-error .
     1705             if error-status :error
     1706             or error-status :get-message(1) <> ""
     1707             then do:
     1708               undo move_block, retry move_block .
     1709             end.
     1710           end.
     1711         end.
     1712       end.
     1713       else do:
     1714         for each buf_temp-diasize-handle
     1715         on error undo move_block, retry move_block
     1716         :
     1717           assign
     1718             v-object-handle = buf_temp-diasize-handle.handle-value
     1719           .
     1720           if v-object-handle <> v-diasize-resize-button
     1721           then do:
     1722             assign
     1723               v-object-handle :row = v-object-handle :row + p-change-value
     1724               no-error .
     1725             if error-status :error
     1726             or error-status :get-message(1) <> ""
     1727             then do:
     1728               undo move_block, retry move_block .
     1729             end.
     1730           end.
     1731         end.
     1732         assign
     1733           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1734           no-error .
     1735         if error-status :error
     1736         or error-status :get-message(1) <> ""
     1737         then do:
     1738           undo move_block, retry move_block .
     1739         end.
     1740         for each buf_temp-browse-handle
     1741           where buf_temp-browse-handle.browse-type = 'height':u
     1742         on error undo move_block, retry move_block
     1743         :
     1744           assign
     1745             buf_temp-browse-handle.browse-handle :height
     1746               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1747             no-error .
     1748           if error-status :error
     1749           or error-status :get-message(1) <> ""
     1750           then do:
     1751             undo move_block, retry move_block .
     1752           end.
     1753         end.
     1754         assign
     1755           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1756           no-error .
     1757         if error-status :error
     1758         or error-status :get-message(1) <> ""
     1759         then do:
     1760           undo move_block, retry move_block .
     1761         end.
     1762         if frame Dialog-Frame :scrollable = true
     1763         then do:
     1764           assign
     1765             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1766             no-error .
     1767           if error-status :error
     1768           or error-status :get-message(1) <> ""
     1769           then do:
     1770             undo move_block, retry move_block .
     1771           end.
     1772         end.
     1773       end.
     1774       if p-move-resize = true
     1775       then do:
     1776         run diasize_position-resize-button in this-procedure .
     1777       end.
     1778       if v-diasize-wndstore = true
     1779       then do:
     1780         if connected("ub") = true
     1781         then do:
     1782           define variable v-cntxt-db-num        as integer   no-undo .
     1783           define variable v-cntxt-userid        as character no-undo .
     1784           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1785                                             , OUTPUT v-cntxt-userid
     1786                                             ) .
     1787           run gbl/wndsizew.p
     1788             (input  v-cntxt-db-num
     1789             ,input  v-cntxt-userid
     1790             ,input  v-diasize-proc-name
     1791             ,input  'height':u
     1792             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1793             ) .
     1794         end.
     1795       end.
     1796     end.
     1797     assign
     1798       v-diasize-change-size = false
     1799     .
     1800   end procedure.
     1801   procedure diasize_set-height :
     1802     define input  parameter p-new-height  as decimal   no-undo .
     1803     define input  parameter p-move-resize as logical   no-undo .
     1804     do
     1805     on error undo, return error return-value
     1806     :
     1807       run diasize_change-height in this-procedure
     1808         (input  (p-new-height - frame Dialog-Frame :height)
     1809         ,input  p-move-resize
     1810         ) .
     1811     end.
     1812   end procedure.
     1813   procedure diasize_change-width :
     1814     define input  parameter p-change-value as decimal   no-undo .
     1815     define input  parameter p-move-resize  as logical   no-undo .
     1816     define variable v-field-group-handle   as handle    no-undo .
     1817     define variable v-object-handle        as handle    no-undo .
     1818     define variable v-frame-width          as decimal   no-undo .
     1819     define variable v-frame-virtual-width  as decimal   no-undo .
     1820     define variable v-browse-width         as decimal   no-undo .
     1821     define variable v-window-width         as decimal   no-undo .
     1822     define variable v-window-virtual-width as decimal   no-undo .
     1823     define variable v-change-sign          as integer   no-undo .
     1824     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1825     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1826     if p-change-value > 0
     1827     then do:
     1828       if frame Dialog-Frame :width + p-change-value >
     1829           session :width-chars
     1830       then do:
     1831         assign
     1832           p-change-value = session :width-chars - frame Dialog-Frame :width
     1833         .
     1834         if p-change-value <= 0
     1835         then do:
     1836           run diasize_position-resize-button in this-procedure .
     1837           return .
     1838         end.
     1839       end.
     1840     end.
     1841     if p-change-value < 0
     1842     then do:
     1843       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1844       then do:
     1845         assign
     1846           p-change-value = v-diasize-orig-frame-width
     1847                          - frame Dialog-Frame :width
     1848         .
     1849         if p-change-value >= 0
     1850         then do:
     1851           run diasize_position-resize-button in this-procedure .
     1852           return .
     1853         end.
     1854       end.
     1855     end.
     1856     if p-change-value >= 0
     1857     then do:
     1858       assign
     1859         v-change-sign = 1
     1860       .
     1861     end.
     1862     else do:
     1863       assign
     1864         v-change-sign = -1
     1865       .
     1866     end.
     1867     assign
     1868       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1869     .
     1870     if p-change-value = 0
     1871     then do:
     1872       run diasize_position-resize-button in this-procedure .
     1873       return .
     1874     end.
     1875     move_block:
     1876     do
     1877     on error undo move_block, leave move_block
     1878     :
     1879       if retry
     1880       then do:
     1881         do
     1882         on error undo move_block, leave move_block
     1883         :
     1884           if p-change-value > 0
     1885           then do:
     1886             for each buf_temp-diasize-handle
     1887             on error undo, next
     1888             :
     1889               assign
     1890                 v-object-handle = buf_temp-diasize-handle.handle-value
     1891               .
     1892               if v-object-handle <> v-diasize-resize-button
     1893               then do:
     1894                 assign
     1895                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1896                 .
     1897               end.
     1898             end.
     1899             assign
     1900               v-diasize-browse-handle :width = v-browse-width
     1901             .
     1902             for each buf_temp-browse-handle
     1903               where buf_temp-browse-handle.browse-type = 'width':u
     1904             on error undo, next
     1905             :
     1906               assign
     1907                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1908               .
     1909             end.
     1910             assign
     1911               frame Dialog-Frame :width = v-frame-width
     1912             .
     1913             if frame Dialog-Frame :scrollable = true
     1914             then do:
     1915               assign
     1916                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1917               .
     1918             end.
     1919             run diasize_position-resize-button in this-procedure .
     1920           end.
     1921           else do:
     1922             if frame Dialog-Frame :scrollable = true
     1923             then do:
     1924               assign
     1925                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1926               .
     1927             end.
     1928             assign
     1929               frame Dialog-Frame :width = v-frame-width
     1930             .
     1931             for each buf_temp-browse-handle
     1932               where buf_temp-browse-handle.browse-type = 'width':u
     1933             on error undo, next
     1934             :
     1935               assign
     1936                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1937               .
     1938             end.
     1939             assign
     1940               v-diasize-browse-handle :width = v-browse-width
     1941             .
     1942             for each buf_temp-diasize-handle
     1943             on error undo, next
     1944             :
     1945               assign
     1946                 v-object-handle = buf_temp-diasize-handle.handle-value
     1947               .
     1948               if v-object-handle <> v-diasize-resize-button
     1949               then do:
     1950                 assign
     1951                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1952                 .
     1953               end.
     1954             end.
     1955             run diasize_position-resize-button in this-procedure .
     1956           end.
     1957           assign
     1958             v-diasize-change-size = false
     1959           .
     1960           leave move_block .
     1961         end.
     1962       end.
     1963       assign
     1964         v-diasize-need-full-display = true
     1965       .
     1966       if v-diasize-change-size = false
     1967       then do:
     1968         assign
     1969           v-diasize-change-size = true
     1970         .
     1971       end.
     1972       else do:
     1973         return .
     1974       end.
     1975       assign
     1976         v-frame-width = frame Dialog-Frame :width
     1977         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1978         v-browse-width = v-diasize-browse-handle :width
     1979       .
     1980       for each buf_temp-browse-handle
     1981         where buf_temp-browse-handle.browse-type = 'width':u
     1982       :
     1983         assign
     1984           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1985         .
     1986       end.
     1987       for each buf_temp-diasize-handle
     1988       :
     1989         delete buf_temp-diasize-handle .
     1990       end.
     1991       assign
     1992         v-field-group-handle = frame Dialog-Frame :first-child
     1993       .
     1994       do while valid-handle(v-field-group-handle)
     1995       :
     1996         assign
     1997           v-object-handle = v-field-group-handle :first-child
     1998         .
     1999         do while valid-handle(v-object-handle)
     2000         :
     2001           if  v-object-handle <> v-diasize-browse-handle :handle
     2002           and v-object-handle <> v-diasize-resize-button
     2003           and can-query(v-object-handle, "row")
     2004           and can-query(v-object-handle, "height")
     2005           and ( v-object-handle :col + v-object-handle :width
     2006                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2007               )
     2008           then do:
     2009             find first buf_temp-browse-handle
     2010               where buf_temp-browse-handle.browse-type   = 'width':u
     2011                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2012               no-error .
     2013             if available buf_temp-browse-handle
     2014             then do:
     2015             end.
     2016             else do:
     2017               create buf_temp-diasize-handle .
     2018               assign
     2019                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2020                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2021               .
     2022             end.
     2023           end.
     2024           assign
     2025             v-object-handle = v-object-handle :next-sibling
     2026           .
     2027         end.
     2028         assign
     2029           v-field-group-handle = v-field-group-handle :next-sibling
     2030         .
     2031       end.
     2032       do with frame Dialog-Frame
     2033       :
     2034         hide v-diasize-resize-button .
     2035         v-diasize-resize-button :row = 1.
     2036         v-diasize-resize-button :column = 1.
     2037       end.
     2038       if p-change-value > 0
     2039       then do:
     2040         if frame Dialog-Frame :scrollable = true
     2041         then do:
     2042           assign
     2043             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2044             no-error .
     2045           if error-status :error
     2046           or error-status :get-message(1) <> ""
     2047           then do:
     2048             undo move_block, retry move_block.
     2049           end.
     2050         end.
     2051         assign
     2052           frame Dialog-Frame :width = v-frame-width + p-change-value
     2053           no-error .
     2054         if error-status :error
     2055         or error-status :get-message(1) <> ""
     2056         then do:
     2057           undo move_block, retry move_block.
     2058         end.
     2059         assign
     2060           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2061         no-error .
     2062         if error-status :error
     2063         or error-status :get-message(1) <> ""
     2064         then do:
     2065           undo move_block, retry move_block.
     2066         end.
     2067         for each buf_temp-browse-handle
     2068           where buf_temp-browse-handle.browse-type = 'width':u
     2069         on error undo move_block, retry move_block
     2070         :
     2071           assign
     2072             buf_temp-browse-handle.browse-handle :width
     2073               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2074             no-error .
     2075           if error-status :error
     2076           or error-status :get-message(1) <> ""
     2077           then do:
     2078             undo move_block, retry move_block .
     2079           end.
     2080         end.
     2081         for each buf_temp-diasize-handle
     2082         on error undo move_block, retry move_block
     2083         :
     2084           assign
     2085             v-object-handle = buf_temp-diasize-handle.handle-value
     2086           .
     2087           if v-object-handle <> v-diasize-resize-button
     2088           then do:
     2089             assign
     2090               v-object-handle :col = v-object-handle :col + p-change-value
     2091               no-error .
     2092             if error-status :error
     2093             or error-status :get-message(1) <> ""
     2094             then do:
     2095               undo move_block, retry move_block .
     2096             end.
     2097           end.
     2098         end.
     2099       end.
     2100       else do:
     2101         for each buf_temp-diasize-handle
     2102         on error undo move_block, retry move_block
     2103         :
     2104           assign
     2105             v-object-handle = buf_temp-diasize-handle.handle-value
     2106           .
     2107           if v-object-handle <> v-diasize-resize-button
     2108           then do:
     2109             assign
     2110               v-object-handle :col = v-object-handle :col + p-change-value
     2111               no-error .
     2112             if error-status :error
     2113             or error-status :get-message(1) <> ""
     2114             then do:
     2115               undo move_block, retry move_block .
     2116             end.
     2117           end.
     2118         end.
     2119         for each buf_temp-browse-handle
     2120           where buf_temp-browse-handle.browse-type = 'width':u
     2121         on error undo move_block, retry move_block
     2122         :
     2123           assign
     2124             buf_temp-browse-handle.browse-handle :width
     2125               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2126             no-error .
     2127           if error-status :error
     2128           or error-status :get-message(1) <> ""
     2129           then do:
     2130             undo move_block, retry move_block .
     2131           end.
     2132         end.
     2133         assign
     2134           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2135           no-error .
     2136         if error-status :error
     2137         or error-status :get-message(1) <> ""
     2138         then do:
     2139           undo move_block, retry move_block.
     2140         end.
     2141         assign
     2142           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2143         no-error .
     2144         if error-status :error
     2145         or error-status :get-message(1) <> ""
     2146         then do:
     2147           undo move_block, retry move_block.
     2148         end.
     2149         if frame Dialog-Frame :scrollable = true
     2150         then do:
     2151           assign
     2152             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2153           no-error .
     2154           if error-status :error
     2155           or error-status :get-message(1) <> ""
     2156           then do:
     2157             undo move_block, retry move_block.
     2158           end.
     2159         end.
     2160       end.
     2161       if p-move-resize
     2162       then do:
     2163         run diasize_position-resize-button in this-procedure .
     2164       end.
     2165       if v-diasize-wndstore = true
     2166       then do:
     2167         if connected("ub") = true
     2168         then do:
     2169           define variable v-cntxt-db-num        as integer   no-undo .
     2170           define variable v-cntxt-userid        as character no-undo .
     2171           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2172                                             , OUTPUT v-cntxt-userid
     2173                                             ) .
     2174           run gbl/wndsizew.p
     2175             (input  v-cntxt-db-num
     2176             ,input  v-cntxt-userid
     2177             ,input  v-diasize-proc-name
     2178             ,input  'width':u
     2179             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2180             ) .
     2181         end.
     2182       end.
     2183     end.
     2184     assign
     2185       v-diasize-change-size = false
     2186     .
     2187   end procedure.
     2188   procedure diasize_set-width :
     2189     define input  parameter p-new-width  as decimal   no-undo .
     2190     define input  parameter p-move-resize as logical   no-undo .
     2191     do
     2192     on error undo, return error return-value
     2193     :
     2194       run diasize_change-width in this-procedure
     2195         (input  (p-new-width - frame Dialog-Frame :width)
     2196         ,input  p-move-resize
     2197         ) .
     2198     end.
     2199   end procedure.
     2200   procedure diasize_position-resize-button :
     2201     do with frame Dialog-Frame
     2202     :
     2203       hide v-diasize-resize-button .
     2204       assign
     2205         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2206                     - 1
     2207                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2208         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2209                     - 1
     2210                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2211       .
     2212       view v-diasize-resize-button .
     2213     end.
     2214   end procedure.
     2215   on alt-right anywhere
     2216   do:
     2217     run diasize_change-width in this-procedure
     2218       (input 1
     2219       ,input true
     2220       ) .
     2221     return no-apply .
     2222   end.
     2223   on alt-left anywhere
     2224   do:
     2225     run diasize_change-width in this-procedure
     2226       (input -1
     2227       ,input true
     2228       ) .
     2229     return no-apply .
     2230   end.
     2231   on alt-down anywhere
     2232   do:
     2233     run diasize_change-height in this-procedure
     2234       (input 1
     2235       ,input true
     2236       ) .
     2237     return no-apply .
     2238   end.
     2239   on alt-up anywhere
     2240   do:
     2241     run diasize_change-height in this-procedure
     2242       (input -1
     2243       ,input true
     2244       ) .
     2245     return no-apply .
     2246   end.
     2247   on alt-enter of frame Dialog-Frame
     2248   do:
     2249     run diasize_maximize in this-procedure
     2250       (input  ?
     2251       ).
     2252     return no-apply .
     2253   end.
     2254   procedure diasize_end-move :
     2255     do
     2256     on error undo, return error return-value
     2257     :
     2258       define variable v-row-delta as decimal   no-undo .
     2259       define variable v-col-delta as decimal   no-undo .
     2260       define variable v-new-row as decimal   no-undo .
     2261       define variable v-new-col as decimal   no-undo .
     2262       assign
     2263         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2264         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2265       .
     2266       assign
     2267         v-row-delta = v-new-row - frame Dialog-Frame :height
     2268         v-col-delta = v-new-col - frame Dialog-Frame :width
     2269       .
     2270       run diasize_change-height in this-procedure
     2271         (input v-row-delta
     2272         ,input true
     2273         ) .
     2274       run diasize_change-width in this-procedure
     2275         (input v-col-delta
     2276         ,input true
     2277         ) .
     2278     end.
     2279   end procedure.
     2280   procedure diasize_maximize :
     2281     define input  parameter p-action as logical   no-undo .
     2282     do
     2283     on error undo, return error return-value
     2284     :
     2285       if p-action = ?
     2286       then do:
     2287         if v-diasize-need-maximize = true
     2288         then do:
     2289           assign
     2290             p-action = true
     2291           .
     2292         end.
     2293         else do:
     2294           assign
     2295             p-action = false
     2296           .
     2297         end.
     2298       end.
     2299       if p-action = true
     2300       then do:
     2301         run diasize_change-height in this-procedure
     2302           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2303               - frame Dialog-Frame :height-chars
     2304           ,input true
     2305           ) .
     2306         run diasize_change-width in this-procedure
     2307           (input session :width-chars
     2308               - frame Dialog-Frame :width-chars
     2309           ,input true
     2310           ) .
     2311         assign
     2312           v-diasize-need-maximize = false
     2313         .
     2314       end.
     2315       else do:
     2316         run diasize_change-width in this-procedure
     2317           (input v-diasize-orig-frame-width
     2318               - frame Dialog-Frame :width-chars
     2319           ,input true
     2320           ) .
     2321         run diasize_change-height in this-procedure
     2322           (input v-diasize-orig-frame-height
     2323               - frame Dialog-Frame :height-chars
     2324           ,input true
     2325           ) .
     2326         assign
     2327           v-diasize-need-maximize = true
     2328         .
     2329       end.
     2330     end.
     2331   end procedure.
     2332   procedure diasize_restore-orig-size :
     2333     do
     2334     on error undo, return error return-value
     2335     :
     2336       assign
     2337         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2338         v-diasize-current-frame-height = frame Dialog-Frame :height
     2339       .
     2340       run diasize_set-height in this-procedure
     2341         (input  v-diasize-orig-frame-height
     2342         ,input  true
     2343         ) .
     2344       run diasize_set-width in this-procedure
     2345         (input  v-diasize-orig-frame-width
     2346         ,input  true
     2347         ) .
     2348     end.
     2349   end procedure.
     2350   procedure diasize_restore-current-size :
     2351     do
     2352     on error undo, return error return-value
     2353     :
     2354       run diasize_set-height in this-procedure
     2355         (input  v-diasize-current-frame-height
     2356         ,input  true
     2357         ) .
     2358       run diasize_set-width in this-procedure
     2359         (input  v-diasize-current-frame-width
     2360         ,input  true
     2361         ) .
     2362     end.
     2363   end procedure.
     2364   procedure diasize_set-browse-handle :
     2365     define input  parameter p-browse-handle as handle   no-undo .
     2366     define buffer buf_temp-browse-handle for temp-browse-handle .
     2367     do
     2368     on error undo, return error return-value
     2369     :
     2370       assign
     2371         v-diasize-browse-handle = p-browse-handle
     2372       .
     2373       for each buf_temp-browse-handle
     2374       on error undo, return error return-value
     2375       :
     2376         delete buf_temp-browse-handle .
     2377       end.
     2378     end.
     2379   end procedure.
     2380   procedure diasize_add_browse :
     2381     define input  parameter p-browse-type   as character no-undo .
     2382     define input  parameter p-browse-handle as handle    no-undo .
     2383     define buffer buf_temp-browse-handle for temp-browse-handle .
     2384     do
     2385     on error undo, return error return-value
     2386     :
     2387       assign
     2388         v-diasize-browse-number = v-diasize-browse-number + 1
     2389       .
     2390       create buf_temp-browse-handle .
     2391       assign
     2392         buf_temp-browse-handle.browse-type   = p-browse-type
     2393         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2394         buf_temp-browse-handle.browse-handle = p-browse-handle
     2395       .
     2396     end.
     2397   end procedure.
     2398   procedure diasize_init :
     2399     define variable v-default-value    as logical   no-undo .
     2400     define variable v-restore-saved    as logical   no-undo .
     2401     define variable v-resize-value-str as character no-undo .
     2402     do
     2403     on error undo, return error return-value
     2404     :
     2405       do with frame Dialog-Frame
     2406       :
     2407         assign
     2408           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2409           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2410           v-diasize-browse-handle     = browse BR-cash-counter :handle
     2411         .
     2412         create button v-diasize-resize-button
     2413         assign
     2414           parent        = frame Dialog-Frame :first-child
     2415           label         = "s"
     2416           height-pixels = 16
     2417           width-pixels  = 16
     2418           visible       = true
     2419           sensitive     = true
     2420           movable       = true
     2421           triggers:
     2422             on end-move persistent run diasize_end-move in this-procedure .
     2423           end triggers.
     2424         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2425         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2426         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2427         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2428         assign
     2429           v-diasize-wndmax = false
     2430         .
     2431         if connected("ub") = true
     2432         then do:
     2433           define variable v-cntxt-db-num        as integer   no-undo .
     2434           define variable v-cntxt-userid        as character no-undo .
     2435           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2436                                             , OUTPUT v-cntxt-userid
     2437                                             ) .
     2438           run gbl/wndpar_r.p
     2439             (input  v-cntxt-db-num
     2440             ,input  v-cntxt-userid
     2441             ,input  'wndmax':U
     2442             ,output v-diasize-wndmax
     2443             ,output v-default-value
     2444             ) .
     2445         end.
     2446         assign
     2447           v-diasize-wndstore = false
     2448         .
     2449         if connected("ub") = true
     2450         then do:
     2451           run gbl/wndpar_r.p
     2452             (input  v-cntxt-db-num
     2453             ,input  v-cntxt-userid
     2454             ,input  'wndstore':U
     2455             ,output v-diasize-wndstore
     2456             ,output v-default-value
     2457             ) .
     2458         end.
     2459         assign
     2460           v-diasize-proc-name = entry(1, program-name(2), '.')
     2461         .
     2462         if v-diasize-wndstore = true
     2463         then do:
     2464           assign
     2465             v-restore-saved = false
     2466           .
     2467           if connected("ub") = true
     2468           then do:
     2469             run gbl/wndsizer.p
     2470               (input  v-cntxt-db-num
     2471               ,input  v-cntxt-userid
     2472               ,input  v-diasize-proc-name
     2473               ,input  'height':u
     2474               ,output v-resize-value-str
     2475               ) .
     2476             if v-resize-value-str <> '':U
     2477             then do:
     2478               run diasize_change-height in this-procedure
     2479                 (input  integer(v-resize-value-str)
     2480                 ,input  true
     2481                 ) .
     2482               assign
     2483                 v-restore-saved = true
     2484               .
     2485             end.
     2486           end.
     2487           if connected("ub") = true
     2488           then do:
     2489             run gbl/wndsizer.p
     2490               (input  v-cntxt-db-num
     2491               ,input  v-cntxt-userid
     2492               ,input  v-diasize-proc-name
     2493               ,input  'width':u
     2494               ,output v-resize-value-str
     2495               ) .
     2496             if v-resize-value-str <> '':U
     2497             then do:
     2498               run diasize_change-width in this-procedure
     2499                 (input  integer(v-resize-value-str)
     2500                 ,input  true
     2501                 ) .
     2502               assign
     2503                 v-restore-saved = true
     2504               .
     2505             end.
     2506           end.
     2507           if v-restore-saved <> true
     2508           then do:
     2509             if v-diasize-wndmax = true
     2510             then do:
     2511               run diasize_maximize in this-procedure
     2512                 (input  true
     2513                 ) .
     2514             end.
     2515           end.
     2516         end.
     2517         else do:
     2518           if v-diasize-wndmax = true
     2519           then do:
     2520             run diasize_maximize in this-procedure
     2521               (input  true
     2522               ) .
     2523           end.
     2524         end.
     2525       end.
     2526     end.
     2527   end procedure.
     2528   procedure diasize_need-full-display :
     2529     define output parameter p-need-full-display as logical   no-undo .
     2530     do
     2531     on error undo, return error return-value
     2532     :
     2533       assign
     2534         p-need-full-display = v-diasize-need-full-display
     2535       .
     2536       assign
     2537         v-diasize-need-full-display = false
     2538       .
     2539     end.
     2540   end procedure.
     2541   procedure get-context :
     2542      define output parameter p-db-num as integer          no-undo.
     2543      define output parameter p-user-id as character        no-undo.
     2544      define variable v-login               as character    no-undo.
     2545      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2546      define buffer buf_user-login  for ub.user-login .
     2547      do
     2548      on error undo, return error
     2549      :
     2550            FIND FIRST buf_sys-ctrl no-lock.
     2551            ASSIGN
     2552               v-login = USERID("ub")
     2553               p-db-num = buf_sys-ctrl.db-num
     2554            .
     2555            FIND FIRST buf_user-login
     2556                 WHERE buf_user-login.db-num = p-db-num
     2557                   AND buf_user-login.user-login = v-login
     2558                 no-lock
     2559                 no-error
     2560                 .
     2561            IF AVAILABLE buf_user-login
     2562            THEN DO:
     2563               assign
     2564                  p-user-id = buf_user-login.user-id
     2565               .
     2566            END.
     2567      end.
     2568   end procedure.
     2569       run diasize_init in this-procedure .
     2570   MAIN-BLOCK:
     2571   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2572      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2573   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2574     run mainmenu_getcntxt in parparentproc
     2575       (output v-cntxt-db-num
     2576       ,output v-cntxt-userid
     2577       ,output v-cntxt-level
     2578       ,output v-cntxt-host-code-obj
     2579       ,output v-cntxt-obj-type
     2580       ,output v-cntxt-obj-code
     2581       ,output v-cntxt-db-num-obj
     2582       ,output v-cntxt-is-admin
     2583       ) .
     2584     if p-pos-type <> 'IBS-TH':U then do:
     2585       message
     2586       "Неверный тип POS "
     2587       view-as alert-box error .
     2588       undo, return error .
     2589     end.
     2590   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     2591   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     2592     (output v-curr-r-b
     2593     )  .
     2594     run Myenable IN THIS-PROCEDURE.
     2595     if p-rid-list <> "":U then do:
     2596       assign
     2597       rr = integer(p-rid-list) no-error .
     2598       .
     2599       if not error-status:error then do:
     2600         reposition br-cash-counter to recid rr no-error .
     2601       end.
     2602       APPLY "ENTRY" to br-cash-counter.
     2603     end.
     2604     WAIT-FOR GO OF FRAME Dialog-Frame.
     2605   END.
     2606   run disable_UI in this-procedure .
     2607   PROCEDURE control_load :
     2608   DEFINE VARIABLE UIB_S    AS LOGICAL    NO-UNDO.
     2609   DEFINE VARIABLE OCXFile  AS CHARACTER  NO-UNDO.
     2610   OCXFile = SEARCH( "exe\wrx\ref\cda-cc.wrx":U ).
     2611   IF OCXFile = ? THEN
     2612     OCXFile = SEARCH(SUBSTRING(THIS-PROCEDURE:FILE-NAME, 1,
     2613                        R-INDEX(THIS-PROCEDURE:FILE-NAME, ".":U), "CHARACTER":U) + "wrx":U).
     2614   IF OCXFile <> ? THEN
     2615   DO:
     2616     ASSIGN
     2617       chCtrlFrame = CtrlFrame:COM-HANDLE
     2618       UIB_S = chCtrlFrame:LoadControls( OCXFile, "CtrlFrame":U)
     2619       CtrlFrame:NAME = "CtrlFrame":U
     2620     .
     2621     RUN initialize-controls IN THIS-PROCEDURE NO-ERROR.
     2622   END.
     2623   ELSE MESSAGE "exe\wrx\ref\cda-cc.wrx":U SKIP(1)
     2624                "The binary control file could not be found. The controls cannot be loaded."
     2625                VIEW-AS ALERT-BOX TITLE "Controls Not Loaded".
     2626   END PROCEDURE.
     2627   PROCEDURE disable_UI :
     2628     HIDE FRAME Dialog-Frame.
     2629   END PROCEDURE.
     2630   PROCEDURE enable_UI :
     2631     RUN control_load.
     2632     DISPLAY f-total
     2633         WITH FRAME Dialog-Frame.
     2634     ENABLE b-quit B-Help BR-cash-counter
     2635         WITH FRAME Dialog-Frame.
     2636     VIEW FRAME Dialog-Frame.
     2637     OPEN QUERY BR-cash-counter FOR EACH X_inkas-pay-wth NO-LOCK where         X_inkas-pay-wth.obj-type = p-obj-type     AND X_inkas-pay-wth.obj-code = p-obj-code     AND X_inkas-pay-wth.pay-desk = p-cash-num     AND X_inkas-pay-wth.cashier = 0     AND X_inkas-pay-wth.pay-code > 0     AND X_inkas-pay-wth.wth-code = 0     AND X_inkas-pay-wth.par-code = 0 INDEXED-REPOSITION.
     2638   END PROCEDURE.
     2639   PROCEDURE init-proc :
     2640   find first locked_inkas-pay-wth no-lock where
     2641             locked_inkas-pay-wth.obj-type = p-obj-type
     2642          and locked_inkas-pay-wth.obj-code = p-obj-code
     2643          and locked_inkas-pay-wth.pay-desk = p-cash-num
     2644           and locked_inkas-pay-wth.pay-code = 0
     2645           and locked_inkas-pay-wth.curr-code = 0
     2646           and locked_inkas-pay-wth.wth-code = 0
     2647           and locked_inkas-pay-wth.par-code = 0
     2648           and locked_inkas-pay-wth.cashier = 0
     2649           and locked_inkas-pay-wth.chk-type = 0
     2650           no-error .
     2651   ASSIGN
     2652   f-total = (IF AVAILABLE LOCKED_inkas-pay-wth
     2653              THEN (if v-curr-r-b = 'rubl':U
     2654                   then LOCKED_inkas-pay-wth.tot-rubl
     2655                   else LOCKED_inkas-pay-wth.tot-base)
     2656              ELSE 0.0)
     2657   .
     2658   DISPlay
     2659   f-total
     2660   WITH FRAME Dialog-Frame.
     2661   OPEN QUERY BR-cash-counter FOR EACH X_inkas-pay-wth NO-LOCK where         X_inkas-pay-wth.obj-type = p-obj-type     AND X_inkas-pay-wth.obj-code = p-obj-code     AND X_inkas-pay-wth.pay-desk = p-cash-num     AND X_inkas-pay-wth.cashier = 0     AND X_inkas-pay-wth.pay-code > 0     AND X_inkas-pay-wth.wth-code = 0     AND X_inkas-pay-wth.par-code = 0 INDEXED-REPOSITION.
     2662   END PROCEDURE.
     2663   PROCEDURE MyEnable :
     2664   RUN control_load IN THIS-PROCEDURE.
     2665   ASSIGN
     2666   f-total:LABEL IN FRAME Dialog-Frame = substitute("Всего (в &1)", (IF v-curr-r-b = 'rubl':U THEN "нац.вал." ELSE "баз.вал. "))
     2667   chCtrlFrame:PSTimer:ENABLED  = (p-pos-type = 'IBS-TH':U
     2668                                  OR
     2669                                  p-pos-type = 'IBS-TH-MOB':U
     2670                                  )
     2671   chCtrlFrame:PSTimer:INTERVAL = IF NOT (p-pos-type = 'IBS-TH':U
     2672                                  OR
     2673                                  p-pos-type = 'IBS-TH-MOB':U
     2674                                  )
     2675                                   THEN 0
     2676                                   ELSE 3000
     2677   .
     2678   ASSIGN
     2679   FRAME Dialog-Frame:TITLE = SUBSTITUTE ("&1 &2&3"
     2680                                            , FRAME Dialog-Frame:TITLE
     2681                                           , p-obj-type
     2682                                           , p-obj-code ).
     2683   ENABLE
     2684   b-quit
     2685   B-Help
     2686   br-cash-counter
     2687   WITH FRAME Dialog-Frame.
     2688   VIEW FRAME Dialog-Frame.
     2689   RUN init-proc IN THIS-PROCEDURE NO-ERROR.
     2690   END PROCEDURE.
     2691   FUNCTION get-cdpay-name RETURNS CHARACTER
     2692     (
     2693     INPUT p-cdpay-code AS INTEGER
     2694     ,INPUT p-curr-code AS INTEGER ) :
     2695   DEFINE BUFFER buf_cash-pay FOR ub.cash-pay.
     2696   FIND FIRST buf_cash-pay NO-LOCK WHERE
     2697           buf_cash-pay.cdpay-code = p-cdpay-code
     2698          and buf_cash-pay.curr-code = p-curr-code NO-ERROR.
     2699   IF AVAILABLE buf_cash-pay THEN RETURN buf_cash-pay.obj-name.
     2700   RETURN "!!!Неизвестный тип кассового платежа".
     2701   END FUNCTION.
