      981   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      982   procedure cur-time :
      983      define output parameter p-today as date      no-undo .
      984      define output parameter p-time  as integer   no-undo .
      985     do
      986     on error undo, return error
      987     :
      988       define variable v-date1 as date      no-undo .
      989       define variable v-date2 as date      no-undo .
      990       define variable v-time  as integer   no-undo .
      991       assign
      992         v-date1 = today
      993         v-time  = time
      994         v-date2 = today
      995       .
      996       if v-date1 <> v-date2
      997       then do:
      998         assign
      999           v-date1 = today
     1000           v-time  = v-time
     1001         .
     1002       end.
     1003       assign
     1004         p-today = v-date1
     1005         p-time  = v-time
     1006       .
     1007     end.
     1008   end.
     1009   function cur-time-date returns character
     1010   :
     1011     return string(today, '99/99/9999':U) .
     1012   end.
     1013   function cur-time-mjd returns decimal
     1014   :
     1015     define variable v-date as date      no-undo .
     1016     define variable v-time as integer   no-undo .
     1017     run cur-time in this-procedure
     1018       (output v-date
     1019       ,output v-time
     1020       ) .
     1021     return integer(v-date) - 2400002 + (v-time / 86400) .
     1022   end.
     1023   function cur-time-get-ending-index returns integer
     1024   (input p-number as integer
     1025   )
     1026   :
     1027     if p-number < 0
     1028     or p-number = ?
     1029     then do:
     1030       return 1 .
     1031     end.
     1032     define variable v-rest as integer   no-undo .
     1033     assign
     1034       p-number = p-number modulo 100
     1035     .
     1036     if p-number < 20
     1037     then do:
     1038       assign
     1039         v-rest = p-number
     1040       .
     1041     end.
     1042     else do:
     1043       assign
     1044         v-rest = p-number modulo 10
     1045       .
     1046     end.
     1047     case v-rest :
     1048       when 1
     1049       then do:
     1050         return 2 .
     1051       end.
     1052       when 2 or
     1053       when 3 or
     1054       when 4
     1055       then do:
     1056         return 3 .
     1057       end.
     1058       otherwise do:
     1059         return 1 .
     1060       end.
     1061     end case .
     1062   end.
     1063   procedure cur-time-mjd-to-date :
     1064      define input  parameter i-mjd-diff as decimal no-undo.
     1065      define output parameter o-Date     as date    no-undo.
     1066      define output parameter o-Time     as integer no-undo.
     1067      define variable v-day-number as integer   no-undo .
     1068      if    i-mjd-diff < 0
     1069         or i-mjd-diff = ?
     1070      then do:
     1071         return "?" .
     1072      end.
     1073      assign
     1074         v-day-number = truncate(i-mjd-diff,0).
     1075         o-Date = date(v-day-number + 2400002).
     1076         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
     1077     .
     1078   end.
     1079   function cur-time-mjd-to-string returns character
     1080   (input p-mjd-diff as decimal
     1081   )
     1082   :
     1083     define variable v-day-number as integer   no-undo .
     1084     define variable v-seconds    as integer   no-undo .
     1085     define variable v-hour       as integer   no-undo .
     1086     define variable v-min        as integer   no-undo .
     1087     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
     1088     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
     1089     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
     1090     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
     1091     if p-mjd-diff < 0
     1092     or p-mjd-diff = ?
     1093     then do:
     1094       return "?" .
     1095     end.
     1096     assign
     1097       v-day-number = integer(truncate(p-mjd-diff,0))
     1098       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     1099     .
     1100     if v-seconds > 86400
     1101     then do:
     1102       assign
     1103         v-seconds = 86400 - 1
     1104       .
     1105     end.
     1106     if v-seconds < 0
     1107     then do:
     1108       assign
     1109         v-seconds = 0
     1110       .
     1111     end.
     1112     assign
     1113       v-hour = truncate(v-seconds / 3600, 0)
     1114     .
     1115     assign
     1116       v-seconds = v-seconds modulo 3600
     1117     .
     1118     assign
     1119       v-min = truncate(v-seconds / 60, 0)
     1120     .
     1121     assign
     1122       v-seconds = v-seconds modulo 60
     1123     .
     1124     return
     1125         (if v-day-number <> 0
     1126           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     1127           else ""
     1128         )
     1129       + (if v-day-number <> 0 or v-hour <> 0
     1130           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     1131           else ""
     1132         )
     1133       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     1134           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     1135           else ""
     1136         )
     1137       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     1138       .
     1139   end.
     1140   function cur-time-string returns character
     1141   :
     1142     define variable v-date as date      no-undo .
     1143     define variable v-time as integer   no-undo .
     1144     run cur-time in this-procedure
     1145       (output v-date
     1146       ,output v-time
     1147       ) .
     1148     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     1149   end.
     1150   function cur-time-string-sec returns character
     1151   :
     1152     define variable v-date as date      no-undo .
     1153     define variable v-time as integer   no-undo .
     1154     run cur-time in this-procedure
     1155       (output v-date
     1156       ,output v-time
     1157       ) .
     1158     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     1159   end.
     1160   function cur-time-custom  returns character
     1161   (input p-prefix as character
     1162   ,input p-date-format as character
     1163   ,input p-delimiter as character
     1164   ,input p-time-format as character
     1165   ,input p-suffix as character
     1166   )
     1167   :
     1168     define variable v-date as date      no-undo .
     1169     define variable v-time as integer   no-undo .
     1170     run cur-time in this-procedure
     1171       (output v-date
     1172       ,output v-time
     1173       ) .
     1174     return
     1175       p-prefix
     1176       + string(v-date, p-date-format)
     1177       + p-delimiter
     1178       + string(v-time, p-time-format)
     1179       + p-suffix
     1180       .
     1181   end.
     1182   function cur-time-print  returns character
     1183   :
     1184     define variable v-date as date      no-undo .
     1185     define variable v-time as integer   no-undo .
     1186     run cur-time in this-procedure
     1187       (output v-date
     1188       ,output v-time
     1189       ) .
     1190     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     1191   end.
     1192   function cur-time-datetime returns datetime
     1193   :
     1194     define variable v-char as character no-undo .
     1195     define variable v-datetime as datetime no-undo .
     1196     v-char = cur-time-string().
     1197     v-datetime = datetime(v-char).
     1198     return  v-datetime.
     1199   end.
     1200   function cur-time-string-msec returns character
     1201   :
     1202     define variable v-date as datetime  no-undo .
     1203     v-date = now.
     1204     return string(v-date) .
     1205   end.
     1206   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1207     define variable v-cntxt-db-num        as integer   no-undo .
     1208     define variable v-cntxt-userid        as character no-undo .
     1209     define variable v-cntxt-level         as character no-undo .
     1210     define variable v-cntxt-host-code-obj as integer   no-undo .
     1211     define variable v-cntxt-obj-type      as character no-undo .
     1212     define variable v-cntxt-obj-code      as integer   no-undo .
     1213     define variable v-cntxt-db-num-obj    as integer   no-undo .
     1214     define variable v-cntxt-is-admin      as logical   no-undo .
     1215   DEFINE VARIABLE v-obj-db-num AS INTEGER NO-UNDO.
     1216   DEFINE VARIABLE rr AS RECID NO-UNDO.
     1217   DEFINE VARIABLE v-curr-r-b AS CHARACTER NO-UNDO.
     1218   define buffer locked_inkas-pay-wth for ub.inkas-pay-wth.
     1219   FUNCTION get-cdpay-name RETURNS CHARACTER
     1220     (
     1221     INPUT p-cdpay-code AS INTEGER
     1222     ,INPUT p-curr-code AS INTEGER )  FORWARD.
     1223   DEFINE VARIABLE CtrlFrame AS WIDGET-HANDLE NO-UNDO.
     1224   DEFINE VARIABLE chCtrlFrame AS COMPONENT-HANDLE NO-UNDO.
     1225   DEFINE BUTTON B-Help
     1226        LABEL "Помо&щь"
     1227        SIZE 3 BY 1
     1228        BGCOLOR 8 .
     1229   DEFINE BUTTON b-quit
     1230        LABEL "&Выход"
     1231        SIZE 10 BY 1
     1232        BGCOLOR 8 .
     1233   DEFINE VARIABLE f-total AS DECIMAL FORMAT "->>>,>>>,>>9.99":U INITIAL 0
     1234        LABEL "Всего"
     1235        VIEW-AS FILL-IN NATIVE
     1236        SIZE 18 BY 1
     1237        FGCOLOR 4  NO-UNDO.
     1238   DEFINE QUERY BR-cash-counter FOR
     1239         X_inkas-pay-wth SCROLLING.
     1240   DEFINE BROWSE BR-cash-counter
     1241     QUERY BR-cash-counter NO-LOCK DISPLAY
     1242         get-cdpay-name(X_inkas-pay-wth.pay-code, X_inkas-pay-wth.curr-code) COLUMN-LABEL "Касс.платеж" FORMAT "X(30)"
     1243   X_inkas-pay-wth.curr-code COLUMN-LABEL "Код валюты"
     1244   X_inkas-pay-wth.tot-sum COLUMN-LABEL "Сумма в кассе" FORMAT "->>>,>>>,>>9.99":U
     1245   (if X_inkas-pay-wth.par-val = 0
     1246   then ''
     1247   else string(X_inkas-pay-wth.par-val, ">>,>>9":U)) COLUMN-LABEL  "Номинал" FORMAT "X(7)"
     1248   (if X_inkas-pay-wth.par-val = 0
     1249   then ''
     1250   else string(X_inkas-pay-wth.doc-qnty, "->>>,>>>,>>9.99":U)) COLUMN-LABEL "Кол-во" FORMAT "X(15)"
     1251       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 13.77 FIT-LAST-COLUMN.
     1252   DEFINE FRAME Dialog-Frame
     1253        b-quit AT ROW 1 COL 1
     1254        B-Help AT ROW 1 COL 95
     1255        f-total AT ROW 2.07 COL 20.5 WIDGET-ID 2
     1256        BR-cash-counter AT ROW 3.5 COL 1
     1257        SPACE(0.00) SKIP(0.60)
     1258       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1259            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1260            TITLE "Наличность в каcсе"
     1261            DEFAULT-BUTTON b-quit.
     1262   ASSIGN
     1263          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1264          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1265   CREATE CONTROL-FRAME CtrlFrame ASSIGN
     1266          FRAME           = FRAME Dialog-Frame:HANDLE
     1267          ROW             = 2.07
     1268          COLUMN          = 64.5
     1269          HEIGHT          = 1.07
     1270          WIDTH           = 3.5
     1271          WIDGET-ID       = 4
     1272          HIDDEN          = yes
     1273          SENSITIVE       = yes.
     1274         CtrlFrame:MOVE-AFTER(f-total:HANDLE IN FRAME Dialog-Frame).
     1275   ON END-ERROR OF FRAME Dialog-Frame
     1276   OR ENDKEY OF FRAME Dialog-Frame DO:
     1277      APPLY "GO" TO FRAME Dialog-Frame.
     1278   END.
     1279   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1280   DO:
     1281     APPLY "END-ERROR":U TO SELF.
     1282   END.
     1283   ON CHOOSE OF b-quit IN FRAME Dialog-Frame
     1284   DO:
     1285     APPLY "GO" TO FRAME Dialog-Frame.
     1286   END.
     1287   PROCEDURE CtrlFrame.PSTimer.Tick .
     1288   RUN init-proc IN THIS-PROCEDURE NO-ERROR.
     1289   END PROCEDURE.
     1290   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1291   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1292   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1293   on help of frame Dialog-Frame
     1294   do:
     1295     run gbl/app_help.p
     1296       (input this-procedure :file-name
     1297       ,input ''
     1298       ,input ?
     1299       ) no-error.
     1300     if error-status :error then do:
     1301       message
     1302         "Ошибка при вызове помощи"
     1303         error-status :get-message(1)
     1304         view-as alert-box .
     1305     end.
     1306   end.
     1307   run minbtn-set in this-procedure .
     1308   on choose of b-help in frame Dialog-Frame
     1309   do:
     1310     apply "help":u to frame Dialog-Frame .
     1311   end.
     1312   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1313   procedure minbtn-set :
     1314       do
     1315           on error undo, return error return-value
     1316           :
     1317           define variable ii              as integer       no-undo .
     1318           define variable fh              as widget-handle no-undo .
     1319           define variable hh              as widget-handle no-undo .
     1320           define variable v-h             as handle        extent 4 no-undo .
     1321           define variable v-name-button   as character     no-undo .
     1322           define variable v-help-old-x    as decimal       no-undo .
     1323           define variable v-help-old-y    as decimal       no-undo .
     1324           define variable v-help-old-size as decimal       no-undo .
     1325           define variable v-frame-width   as decimal       no-undo .
     1326           define variable jj              as integer       no-undo .
     1327           do
     1328               on error undo, return error
     1329               :
     1330               assign
     1331                   v-frame-width = frame Dialog-Frame:width - 0.3
     1332                   fh            = frame Dialog-Frame:first-child
     1333                   hh            = fh:first-child
     1334                   ii            = 1
     1335                   .
     1336               do while valid-handle(hh):
     1337                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1338                   do:
     1339                       case lc(hh:name) :
     1340                           when "b-help" then
     1341                               do:
     1342                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1343                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1344                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1345                                   hh:TOOLTIP = "Помощь" .
     1346                                   v-help-old-x = hh:column .
     1347                                   v-help-old-y = hh:row    .
     1348                                   v-help-old-size = hh:width .
     1349                                   hh:width-chars = 2.5 .
     1350                               end.
     1351                           when "b-print" then
     1352                               do:
     1353                                   hh:load-image("cmp/b-print.bmp":u) .
     1354                                   hh:TOOLTIP = "Печать" .
     1355                                   v-h[ii] = hh:handle .
     1356                                   ii = ii + 1 .
     1357                                   hh:width-chars = 3 .
     1358                               end.
     1359                           when "b-history" or
     1360                           when "b-hist" then
     1361                               do:
     1362                                   hh:load-image("cmp/b-hist.bmp":u) .
     1363                                   hh:TOOLTIP = "История" .
     1364                                   v-h[ii] = hh:handle .
     1365                                   ii = ii + 1 .
     1366                                   hh:width-chars = 3 .
     1367                               end.
     1368                           when "b-sch" then
     1369                               do:
     1370                                   hh:load-image("cmp/b-sch.bmp":u) .
     1371                                   hh:TOOLTIP = "Установка Фильтра" .
     1372                                   v-h[ii] = hh:handle .
     1373                                   ii = ii + 1 .
     1374                                   hh:width-chars = 3 .
     1375                               end.
     1376                           when "b-hist-user" then
     1377                               do:
     1378                                   hh:load-image("cmp/b-hist.bmp":u) .
     1379                                   hh:TOOLTIP = "История пользователя" .
     1380                                   ii = ii + 1 .
     1381                               end.
     1382                       end case.
     1383                   end.
     1384                   hh = hh:next-sibling.
     1385               end.
     1386               b-help:column = v-frame-width - b-help:width-chars.
     1387               jj = 0.
     1388               repeat ii = 4 to 1 by -1 :
     1389                   if valid-handle (v-h[ii] ) then
     1390                   do:
     1391                       jj  = jj + 1 .
     1392                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1393                       v-h[ii]:row    = v-help-old-y .
     1394                   end.
     1395               end.
     1396           end.
     1397       end.
     1398   end procedure.
