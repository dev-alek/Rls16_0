       87   def var vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       88   define temp-table temp-drt-prop no-undo like ub.drt-prop.
       89   procedure disrules-fill-properties:
       90   define input  parameter p-templ-rl-root as integer   no-undo .
       91   define buffer buf_drt-prop for ub.drt-prop.
       92   define buffer buf_temp-drt-prop for temp-drt-prop.
       93   do
       94   on error undo, return error return-value
       95   :
       96     for each buf_temp-drt-prop:
       97       delete buf_temp-drt-prop.
       98     end.
       99     for each buf_drt-prop where buf_drt-prop.templ-rl-root = p-templ-rl-root:
      100       create buf_temp-drt-prop.
      101       buffer-copy buf_drt-prop to buf_temp-drt-prop.
      102     end.
      103   end.
      104   end procedure.
      105   ~
      106   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      107   procedure discfgru-check :
      108   define input parameter p-table-name as character no-undo .
      109   define input parameter p-templ-rl-root as integer no-undo .
      110   define input parameter p-time-templ-rl-root as integer no-undo .
      111   define input parameter p-pos-type as character no-undo .
      112   define output parameter p-disnct-role as character no-undo .
      113   define buffer buf_dis-cfg-rule for ub.dis-cfg-rule.
      114     do
      115     on error undo, return error return-value
      116     :
      117       find first buf_dis-cfg-rule no-lock where
      118               buf_dis-cfg-rule.table-name = p-table-name
      119           and buf_dis-cfg-rule.templ-rl-root = p-templ-rl-root
      120           and (p-time-templ-rl-root = ? or  buf_dis-cfg-rule.time-templ-rl-root = p-time-templ-rl-root)
      121           and buf_dis-cfg-rule.pos-type = p-pos-type no-error.
      122       if not available buf_dis-cfg-rule
      123       or p-pos-type = "":U
      124       then do:
      125          return error substitute("Для места использования типа &1 не определен тип скидки с шаблоном &2 &3"
      126                                  ,entry (lookup (p-pos-type, 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,r-keeper,InfoKiosk,pricecheck-Servis+,Emulator-NKT-IBM,MARIA,-,bo,Autotank':U), 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,R-KEEPER,InfoKiosk,Прайс-чекер Servis+,Emulator-NKT-IBM,MARIA,Накладная,Бэкофис,Autotank':U)
      127                                  , p-templ-rl-root
      128                                  , (if p-time-templ-rl-root = ?
      129                                     then '':U
      130                                     else substitute("с расписанием типа &1", p-time-templ-rl-root)
      131                                     )
      132                                  ).
      133       end.
      134       assign
      135       p-disnct-role = buf_dis-cfg-rule.discnt-role
      136       .
      137     end.
      138   end procedure.
      139   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      140   FUNCTION get-region RETURNS CHARACTER
      141     ( input parhost-code as integer, input parobj-type as character, input parobj-code as integer ) :
      142     define variable par-region as character no-undo.
      143     if parhost-code = 0 and
      144          parobj-type = "":U and
      145          parobj-code = 0 then do:
      146          par-region = "Глобально".
      147          return par-region.
      148       end.
      149       if parobj-type = 'орг':U then do:
      150          par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(parhost-code).
      151          return par-region.
      152       end.
      153       if parobj-type = 'регион':U
      154       then do:
      155          par-region = fill(chr(32), 2) + "Регион" + chr(32) + string(parobj-code).
      156          return par-region.
      157       end.
      158       par-region = fill(chr(32), 4) + parobj-type + chr(32) + string(parobj-code).
      159       return par-region.
      160   END FUNCTION.
      161   FUNCTION get-objregion RETURNS CHARACTER
      162     (  input parobj-type as character, input parobj-code as integer ) :
      163     define variable par-region as character no-undo.
      164     if  parobj-type = "":U and
      165         parobj-code = 0
      166     then do:
      167        par-region = "Глобально".
      168     end.
      169     else if parobj-type = 'орг':U
      170     then do:
      171        par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(parobj-code).
      172     end.
      173     else if parobj-type = 'регион':U
      174     then do:
      175        par-region = fill(chr(32), 2) + "Регион" + chr(32) + string(parobj-code).
      176     end.
      177     else
      178        par-region = fill(chr(32), 4) + parobj-type + chr(32) + string(parobj-code).
      179     return par-region.
      180   END FUNCTION.
      181   procedure disgdsru-name :
      182   define buffer buf_dis-rule for ub.dis-rule.
      183   do
      184     on error undo, return error
      185     :
      186     define input  parameter p-templ-rl-root  as integer no-undo .
      187     define output parameter p-label          as character no-undo .
      188     find first buf_dis-rule no-lock where
      189               buf_dis-rule.rule-num = p-templ-rl-root no-error.
      190     if available buf_dis-rule
      191     then do:
      192       if buf_dis-rule.rule-num > 0 then
      193       p-label = buf_dis-rule.des.
      194     end.
      195     else do:
      196       p-label = substitute("Неизвестный тип правила скидки &1", p-templ-rl-root).
      197     end.
      198   end.
      199   end procedure.
      200   function disgdsru-get-disc-label returns character ( input p-templ-rl-root as integer):
      201   define variable v-rule-label as character no-undo .
      202   run disgdsru-name in this-procedure ( input p-templ-rl-root
      203                                        ,output v-rule-label) no-error.
      204   return v-rule-label.
      205   end function.
      206   function disgdsru-get-disc-role-label returns character ( input p-discnt-role as character):
      207   define variable v-rule-label as character no-undo .
      208   return entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u).
      209   end function.
      210   procedure disgdsru-write :
      211     do
      212     on error undo, return error
      213     :
      214       define input parameter p-obj-type       like ub.dis-gds-rule.obj-type   no-undo .
      215       define input parameter p-obj-code       like ub.dis-gds-rule.obj-code   no-undo .
      216       define input parameter p-gds-code       like ub.dis-gds-rule.gds-code   no-undo .
      217       define input parameter p-pos-type       like ub.dis-gds-rule.pos-type   no-undo .
      218       define input parameter p-discnt-role    like ub.dis-gds-rule.discnt-role no-undo .
      219       define input parameter p-templ-rl-root  like ub.dis-gds-rule.templ-rl-root  no-undo .
      220       define input parameter p-time-templ-rl-root  like ub.dis-gds-rule.time-templ-rl-root  no-undo .
      221       define input parameter p-rule-num       like ub.dis-gds-rule.rule-num    no-undo .
      222       define input parameter p-nonunique      like ub.dis-gds-rule.nonunique   no-undo .
      223       define buffer buf_dis-gds-rule for ub.dis-gds-rule .
      224       define buffer buf_dis-rule for ub.dis-rule.
      225       define buffer lock_dis-gds-rule for ub.dis-gds-rule .
      226       define variable v-label          as character no-undo .
      227       define variable v-discnt-role as character no-undo .
      228       run discfgru-check in this-procedure (
      229                                             input 'dis-gds-rule':U
      230                                            ,input p-templ-rl-root
      231                                            ,input p-time-templ-rl-root
      232                                            ,input p-pos-type
      233                                            ,output v-discnt-role
      234                                             ) no-error .
      235       if error-status :error then do:
      236         undo, return error return-value .
      237       end.
      238       if p-discnt-role = ? then do:
      239         p-discnt-role = v-discnt-role.
      240       end.
      241       if p-discnt-role <> v-discnt-role then do:
      242         undo, return error substitute("Товар &1 &2&3 место использ. &4 скидка типа &5&6не может быть по шаблону &7 и расписанию &8"
      243                                 ,p-gds-code
      244                                 ,p-obj-type
      245                                 ,p-obj-code
      246                                 ,p-pos-type
      247                                 ,entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u)
      248                                 ,chr(10)
      249                                 ,p-templ-rl-root
      250                                 ,p-rule-num).
      251       end.
      252       if p-pos-type = ? then do:
      253   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      254   define variable v-param-type4 as character no-undo .
      255   define variable v-value-date4 as date no-undo .
      256   define variable v-value-decimal4 as decimal no-undo .
      257   define variable v-value-integer4 as INTEGER no-undo .
      258   define variable v-value-logical4 AS LOGICAL no-undo .
      259   define variable v-tth4 as handle no-undo .
      260   run adm/shattri.p (
      261       input "get":U
      262       ,input  p-obj-type
      263       ,input  p-obj-code
      264       ,input  'cd-sending':U
      265       ,input  'dflt-cd':U
      266       ,output p-pos-type
      267       ,output v-value-date4
      268       ,output v-value-decimal4
      269       ,output v-value-integer4
      270       ,output v-value-logical4
      271       ,output v-param-type4
      272       ,INPUT-OUTPUT table-handle v-tth4
      273       )  .
      274   delete object v-tth4 no-error.
      275       end.
      276       find first buf_dis-rule no-lock where
      277                 buf_dis-rule.rule-num = p-rule-num no-error.
      278       if not available buf_Dis-rule then do:
      279         undo, return error substitute("Товар &1 &2&3 место использ. &4 скидка типа &5&6не найдено правило скидки &7"
      280                                 ,p-gds-code
      281                                 ,p-obj-type
      282                                 ,p-obj-code
      283                                 ,p-pos-type
      284                                 ,entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u)
      285                                 ,chr(10)
      286                                 ,p-rule-num).
      287       end.
      288       if buf_dis-rule.root <> yes then do:
      289         undo, return error substitute("Товар &1 &2&3 место использ. &4 скидка типа &5&6правило скидки &7 - некорневое"
      290                                 ,p-gds-code
      291                                 ,p-obj-type
      292                                 ,p-obj-code
      293                                 ,p-pos-type
      294                                 ,entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u)
      295                                 ,chr(10)
      296                                 ,p-rule-num).
      297       end.
      298       if not (p-obj-type = buf_dis-rule.obj-type
      299           and p-obj-code = buf_dis-rule.obj-code)
      300       and not ( (p-obj-type = 'маг':U or p-obj-type = 'скл':U )
      301                and
      302                (buf_dis-rule.obj-type = 'орг':U or buf_dis-rule.obj-type = ""))
      303        then do:
      304         undo, return error (substitute("Товар &1 &2&3 место использ. &4 скидка типа &5&6"
      305                                 ,p-gds-code
      306                                 ,p-obj-type
      307                                 ,p-obj-code
      308                                 ,p-pos-type
      309                                 ,entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u)
      310                                 ,chr(10)
      311                                 ) +
      312                             substitute("Правило скидки &1 определено для &2&3" +
      313                                        "а привязка к товару для &4"
      314                                        ,buf_dis-rule.rule-num
      315                                        ,get-objregion( buf_dis-rule.obj-type, buf_Dis-rule.obj-code)
      316                                        ,chr(10)
      317                                        ,get-objregion( p-obj-type, p-obj-code)
      318                                        ))
      319                                 .
      320       end.
      321       find first buf_dis-gds-rule exclusive-lock where
      322                  buf_dis-gds-rule.gds-code  = p-gds-code
      323              AND buf_dis-gds-rule.obj-type  = buf_dis-rule.obj-type
      324              AND buf_dis-gds-rule.obj-code  = buf_dis-rule.obj-code
      325              AND buf_dis-gds-rule.pos-type  = p-pos-type
      326              AND buf_dis-gds-rule.discnt-role = p-discnt-role
      327              and buf_dis-gds-rule.nonunique = p-nonunique
      328              no-error .
      329       if not available buf_dis-gds-rule then do:
      330         find first buf_dis-gds-rule exclusive-lock where
      331                   buf_dis-gds-rule.gds-code  = p-gds-code
      332               AND buf_dis-gds-rule.obj-type  = buf_dis-rule.obj-type
      333               AND buf_dis-gds-rule.obj-code  = buf_dis-rule.obj-code
      334               AND buf_dis-gds-rule.pos-type  = p-pos-type
      335               AND buf_dis-gds-rule.discnt-role = p-discnt-role
      336               no-error .
      337         if available buf_Dis-gds-rule then do:
      338           if p-nonunique = ''
      339           and available buf_dis-gds-rule
      340           then do:
      341             return error substitute("Скидка типа &1 на товар с кодом &2 &3&4 уже существует (детализ. &3)"
      342                                      , entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u)
      343                                      , p-gds-code
      344                                      , buf_Dis-rule.obj-type
      345                                      , buf_Dis-rule.obj-code
      346                                      , p-nonunique
      347                                     ).
      348           end.
      349           if available buf_dis-gds-rule
      350           and buf_dis-gds-rule.nonunique = ''
      351           and p-nonunique <> ''then do:
      352             return error substitute("Скидка типа &1 на товар с кодом &2 &3&4 уже существует"
      353                                      , entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u)
      354                                      , p-gds-code
      355                                      , buf_Dis-rule.obj-type
      356                                      , buf_Dis-rule.obj-code
      357                                     ).
      358           end.
      359         end.
      360         create buf_dis-gds-rule .
      361         assign
      362         buf_dis-gds-rule.gds-code  = p-gds-code
      363         buf_dis-gds-rule.obj-type  = buf_dis-rule.obj-type
      364         buf_dis-gds-rule.obj-code  = buf_dis-rule.obj-code
      365         buf_dis-gds-rule.pos-type = p-pos-type
      366         buf_dis-gds-rule.discnt-role = v-discnt-role
      367         buf_dis-gds-rule.rule-num = p-rule-num
      368         buf_dis-gds-rule.nonunique = p-nonunique
      369         no-error
      370         .
      371       end.
      372       ASSIGN
      373       buf_dis-gds-rule.rule-num = p-rule-num
      374       buf_dis-gds-rule.rl-root = buf_Dis-rule.rl-root
      375       buf_dis-gds-rule.time-templ-rl-root = p-time-templ-rl-root
      376       buf_dis-gds-rule.templ-rl-root = p-templ-rl-root
      377       buf_dis-gds-rule.nonunique = p-nonunique
      378       no-error.
      379     end.
      380   end procedure.
      381   PROCEDURE cmp-disgdsru-write :
      382   do
      383   on error undo, return error
      384   :
      385     define input parameter p-gds-code like ub.dis-gds-rule.gds-code   no-undo .
      386     define input parameter p-obj-type like ub.dis-gds-rule.obj-type   no-undo .
      387     define input parameter p-obj-code like ub.dis-gds-rule.obj-code   no-undo .
      388     define input parameter p-pos-type like ub.dis-gds-rule.pos-type   no-undo .
      389     define input parameter p-templ-rl-root     like ub.dis-gds-rule.templ-rl-root  no-undo .
      390     define input parameter p-time-templ-rl-root     like ub.dis-gds-rule.time-templ-rl-root  no-undo .
      391     define input parameter p-discnt-role like ub.dis-gds-rule.discnt-role no-undo .
      392     define input parameter p-rule-num    like ub.dis-gds-rule.rule-num no-undo .
      393     define input parameter p-nonunique like ub.dis-gds-rule.nonunique no-undo .
      394     define variable v-rule-label          as character no-undo .
      395     define buffer buf_tt0-dis-gds-rule for ub.dis-gds-rule .
      396     define buffer buf_dis-rule     for ub.dis-rule.
      397     run disgdsru-name in this-procedure (
      398                                         input  p-templ-rl-root
      399                                         ,output v-rule-label
      400                                         ) no-error .
      401     if error-status :error then do:
      402       undo, return error return-value .
      403     end.
      404     find first buf_tt0-dis-gds-rule exclusive-lock where
      405                 buf_tt0-dis-gds-rule.gds-code  = p-gds-code
      406             AND buf_tt0-dis-gds-rule.obj-type  = p-obj-type
      407             AND buf_tt0-dis-gds-rule.obj-code  = p-obj-code
      408             AND buf_tt0-dis-gds-rule.pos-type  = p-pos-type
      409             AND buf_tt0-dis-gds-rule.discnt-role = p-discnt-role
      410             AND buf_tt0-dis-gds-rule.nonunique = p-nonunique
      411             no-error .
      412     if not available buf_tt0-dis-gds-rule then do:
      413       create buf_tt0-dis-gds-rule .
      414       assign
      415       buf_tt0-dis-gds-rule.gds-code  = p-gds-code
      416       buf_tt0-dis-gds-rule.obj-type  = p-obj-type
      417       buf_tt0-dis-gds-rule.obj-code  = p-obj-code
      418       buf_tt0-dis-gds-rule.pos-type  = p-pos-type
      419       buf_tt0-dis-gds-rule.nonunique = p-nonunique
      420       buf_tt0-dis-gds-rule.discnt-role = p-discnt-role
      421       no-error
      422       .
      423     end.
      424     find first buf_dis-rule no-lock where
      425               buf_dis-rule.rule-num = p-rule-num.
      426     ASSIGN
      427     buf_tt0-dis-gds-rule.templ-rl-root = p-templ-rl-root
      428     buf_tt0-dis-gds-rule.rule-num = p-rule-num
      429     buf_tt0-dis-gds-rule.time-templ-rl-root = p-time-templ-rl-root
      430     buf_tt0-dis-gds-rule.nonunique = p-nonunique
      431     buf_tt0-dis-gds-rule.templ-rl-root = p-templ-rl-root
      432     buf_tt0-dis-gds-rule.rl-root = buf_Dis-rule.rl-root
      433     no-error.
      434     release buf_tt0-dis-gds-rule no-error .
      435     if error-status:error then do:
      436       undo, return error return-value .
      437     end.
      438   end.
      439   END PROCEDURE.
      440   define variable v-deleted as logical no-undo .
      441   define variable v-err-mess as character no-undo .
      442   define buffer buf_dis-gds-rule for ub.dis-gds-rule.
      443   define buffer buf_goods for ub.goods.
      444   _main:
      445   do
      446   on error undo, return error return-value
      447   :
      448     find first buf_goods no-lock where buf_goods.gds-code = p-gds-code no-error .
      449     if not available buf_goods then do:
      450       undo, return error substitute("&1 &2 &3&4Не найден товар с кодом &5"
      451                                    , vss-workfile
      452                                    , vss-revision
      453                                    , vss-description
      454                                    , chr(10)
      455                                    , p-gds-code).
      456     end.
      457     FOR EACH tt0-dis-gds-rule
      458     on error  undo _Main, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      459     on stop   undo _Main, return error substitute( "&1. stop", vss-workfile )
      460     on endkey undo _Main, return error substitute( "&1. endkey", vss-workfile )
      461     :
      462       if tt0-dis-gds-rule.obj-type = 'орг':U and g#db-num <> 0 then next.
      463       if tt0-dis-gds-rule.obj-type = '':U and g#db-num <> 0 then next.
      464       if (tt0-dis-gds-rule.obj-type = 'маг':U
      465           or
      466           tt0-dis-gds-rule.obj-type = 'скл':U )
      467       and ((tt0-dis-gds-rule.obj-type <> p-obj-type
      468             or tt0-dis-gds-rule.obj-code <> p-obj-code))  then next.
      469       if p-mode <> 'ДОБАВЛЕНИЕ':U then do:
      470         find FIRST buf_dis-gds-rule WHERE buf_dis-gds-rule.gds-code = p-gds-code
      471         AND buf_dis-gds-rule.obj-type = tt0-dis-gds-rule.obj-type
      472         AND buf_dis-gds-rule.obj-code = tt0-dis-gds-rule.obj-code
      473         AND buf_dis-gds-rule.pos-type = tt0-dis-gds-rule.pos-type
      474         AND buf_dis-gds-rule.discnt-role = tt0-dis-gds-rule.discnt-role
      475         and buf_dis-gds-rule.nonunique = tt0-dis-gds-rule.nonunique no-error.
      476       end.
      477       IF p-mode = 'ДОБАВЛЕНИЕ':U
      478       or not available buf_dis-gds-rule
      479       or buf_dis-gds-rule.rule-num <> tt0-dis-gds-rule.rule-num THEN DO:
      480         run disgdsru-write in this-procedure (
      481                                              INPUT tt0-dis-gds-rule.obj-type
      482                                             ,INPUT tt0-dis-gds-rule.obj-code
      483                                             ,input p-gds-code
      484                                             ,INPUT tt0-dis-gds-rule.pos-type
      485                                             ,INPUT tt0-dis-gds-rule.discnt-role
      486                                             ,INPUT tt0-dis-gds-rule.templ-rl-root
      487                                             ,INPUT tt0-dis-gds-rule.time-templ-rl-root
      488                                             ,INPUT tt0-dis-gds-rule.rule-num
      489                                             ,INPUT tt0-dis-gds-rule.nonunique
      490                                             ) NO-ERROR.
      491         IF ERROR-STATUS:ERROR THEN DO:
      492           assign
      493           v-err-mess = substitute("Ошибка при сохранении скидки товара &1 на объекте &2 POS &3 тип скидки &4:&5&6 &7"
      494                                   , p-gds-code
      495                                   , (tt0-dis-gds-rule.obj-type + string(tt0-dis-gds-rule.obj-code))
      496                                   , tt0-dis-gds-rule.pos-type
      497                                   , tt0-dis-gds-rule.discnt-role
      498                                   , chr(10)
      499                                   ,error-status:get-message(1)
      500                                   ,return-value).
      501           undo _main, return error v-err-mess.
      502         END.
      503       END.
      504     END.
      505     if p-mode <> 'ДОБАВЛЕНИЕ':U then do:
      506       FOR EACH buf_dis-gds-rule where
      507               buf_dis-gds-rule.gds-code = p-gds-code
      508       on error  undo _Main, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      509       on stop   undo _Main, return error substitute( "&1. stop", vss-workfile )
      510       on endkey undo _Main, return error substitute( "&1. endkey", vss-workfile )
      511       :
      512         if buf_dis-gds-rule.obj-type = 'орг':U and g#db-num <> 0 then next.
      513         if buf_dis-gds-rule.obj-type = '':U and g#db-num <> 0 then next.
      514         if (buf_dis-gds-rule.obj-type = 'маг':U
      515             or
      516             buf_dis-gds-rule.obj-type = 'скл':U )
      517         and ((buf_dis-gds-rule.obj-type <> p-obj-type
      518              or buf_dis-gds-rule.obj-code <> p-obj-code))  then next.
      519         if buf_dis-gds-rule.pos-type = '':U
      520         and buf_dis-gds-rule.discnt-role = '':U
      521         and buf_dis-gds-rule.nonunique = '':U
      522         then next.
      523         FIND FIRST tt0-dis-gds-rule NO-LOCK WHERE
      524               tt0-dis-gds-rule.gds-code = p-gds-code
      525           AND tt0-dis-gds-rule.obj-type = buf_dis-gds-rule.obj-type
      526           AND tt0-dis-gds-rule.obj-code = buf_dis-gds-rule.obj-code
      527           AND tt0-dis-gds-rule.pos-type = buf_dis-gds-rule.pos-type
      528           AND tt0-dis-gds-rule.discnt-role = buf_dis-gds-rule.discnt-role
      529           AND tt0-dis-gds-rule.nonunique = buf_dis-gds-rule.nonunique NO-ERROR.
      530         IF NOT AVAILABLE tt0-dis-gds-rule THEN DO:
      531           ASSIGN
      532           v-deleted = NO.
      533           delete buf_Dis-gds-rule no-error.
      534           IF  error-status:error
      535           THEN DO:
      536             assign
      537             v-err-mess = substitute("Ошибка при удалении скидки товара на объекте &1 &2 &3 тип скидки &4:&5&6 &7"
      538                                     , p-gds-code
      539                                     , (buf_dis-gds-rule.obj-type + string(buf_dis-gds-rule.obj-code))
      540                                     , buf_dis-gds-rule.pos-type
      541                                     ,buf_dis-gds-rule.discnt-role
      542                                     ,chr(10)
      543                                     ,error-status:get-message(1)
      544                                     ,return-value
      545                                     ).
      546             undo _main, return error v-err-mess.
      547           END.
      548         END.
      549       END.
      550     end.
      551   end.
