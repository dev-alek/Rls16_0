     1079   FUNCTION get-all-fields returns character (p-file-name as character ):
     1080   define variable v-dop as character no-undo .
     1081     find first _file no-lock where _file._file-name = p-file-name no-error .
     1082     if not available _file then return "":U.
     1083     for each _field no-lock where
     1084              _field._file-recid = recid(_file) :
     1085       assign
     1086       v-dop = v-dop + _field._field-name + chr(44)
     1087       .
     1088     end.
     1089     return trim(v-dop).
     1090   END FUNCTION.
     1091   PROCEDURE proc-full-temp-changes :
     1092     define input  parameter p-hst-handle as handle    no-undo .
     1093     define input  parameter p-main-table as character no-undo .
     1094     define input  parameter p-field-list as character no-undo .
     1095     define input  parameter p-label-form as character no-undo .
     1096     define variable h-new-buf         as handle    no-undo .
     1097     define variable h-main-buf        as handle    no-undo .
     1098     define variable h-for-comp        as handle    no-undo .
     1099     define variable v-inform          as character no-undo .
     1100     define variable v-ind             as integer   no-undo .
     1101     define variable v-idx-field-qnty  as integer   no-undo .
     1102     define variable v-num-entries     as integer   no-undo .
     1103     define variable fh                as handle    no-undo .
     1104     define variable fh-main           as handle    no-undo .
     1105     define variable fh-old            as handle    no-undo .
     1106     define variable fh-new            as handle    no-undo .
     1107     define variable v-field-name      as character no-undo .
     1108     define variable v-field-lvl       as character no-undo .
     1109     define variable v-field-form      as character no-undo .
     1110     define variable v-search-exp      as character no-undo .
     1111     define variable v-srch-main       as character no-undo .
     1112     define variable v-word-link       as character no-undo .
     1113     define variable v-av-chip-num     as logical   no-undo .
     1114     define variable v-main-pi-fld-lst as character no-undo .
     1115     define variable v-main-fld-lst    as character no-undo .
     1116     define variable v-delim-list      as character no-undo .
     1117     define variable v-label           as character no-undo .
     1118     define variable v-old-value       as character no-undo case-sensitive.
     1119     define variable v-new-value       as character no-undo case-sensitive.
     1120     define variable v-chg-fields as character no-undo.
     1121     for each temp-changes:
     1122       delete temp-changes.
     1123     end.
     1124     if not p-hst-handle:available then do:
     1125       return .
     1126     end.
     1127     create buffer h-new-buf  for table p-hst-handle .
     1128     create buffer h-main-buf for table p-main-table .
     1129     assign
     1130       v-inform = h-main-buf:index-information(1)
     1131       v-ind    = 2
     1132     .
     1133     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1134     on error undo, return error
     1135     :
     1136       assign
     1137         v-inform = h-main-buf:index-information( v-ind )
     1138         v-ind    = v-ind + 1
     1139       .
     1140     end.
     1141     if v-inform = ?
     1142       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1143       or entry( 3, v-inform, ",":U ) <> "1":U
     1144     then do:
     1145       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, h-main-buf:name ).
     1146     end.
     1147     assign
     1148       v-idx-field-qnty = num-entries( v-inform ) - 4
     1149     .
     1150     if v-idx-field-qnty < 2 then do:
     1151       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, h-main-buf:name ).
     1152     end.
     1153     assign
     1154       v-srch-main   = "where":U
     1155       v-word-link   = "":U
     1156       v-av-chip-num = false
     1157       v-delim-list  = "":U
     1158     .
     1159     do v-ind = 1 to v-idx-field-qnty by 2
     1160     on error undo, return error
     1161     :
     1162       assign
     1163         v-field-name      = entry( 4 + v-ind, v-inform, ",":U )
     1164         fh                = p-hst-handle:buffer-field( v-field-name )
     1165         fh-main           = h-main-buf:buffer-field( v-field-name )
     1166         v-srch-main       = substitute( "&1 &2 &3.&4 =", v-srch-main, v-word-link, fh-main:table, v-field-name )
     1167         v-main-pi-fld-lst = v-main-pi-fld-lst + v-delim-list + v-field-name
     1168       .
     1169       if fh:data-type ="character":U then do:
     1170         assign
     1171           v-srch-main = substitute( '&1 "&2"', v-srch-main, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
     1172         .
     1173       end.
     1174       else do:
     1175         assign
     1176           v-srch-main = substitute( "&1 &2", v-srch-main, fh:buffer-value() )
     1177         .
     1178       end.
     1179       if v-delim-list = "":U then do:
     1180         assign
     1181           v-delim-list = ",":U
     1182         .
     1183       end.
     1184       if v-word-link = "":U then do:
     1185         assign
     1186           v-word-link = "and":U
     1187         .
     1188       end.
     1189     end.
     1190     assign
     1191       v-delim-list  = "":U
     1192     .
     1193     do v-ind = 1 to h-main-buf:num-fields
     1194     on error undo, return error
     1195     :
     1196       assign
     1197         fh-main      = h-main-buf:buffer-field( v-ind )
     1198         v-field-name = fh-main:name
     1199       .
     1200         assign
     1201           v-main-fld-lst = v-main-fld-lst + v-delim-list + v-field-name
     1202         .
     1203         if v-delim-list = "":U then do:
     1204           assign
     1205             v-delim-list = ",":U
     1206           .
     1207         end.
     1208     end.
     1209     assign
     1210       v-inform = p-hst-handle:index-information(1)
     1211       v-ind    = 2
     1212     .
     1213     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1214     on error undo, return error
     1215     :
     1216       assign
     1217         v-inform = p-hst-handle:index-information( v-ind )
     1218         v-ind    = v-ind + 1
     1219       .
     1220     end.
     1221     if v-inform = ?
     1222       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1223       or entry( 3, v-inform, ",":U ) <> "1":U
     1224     then do:
     1225       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, p-hst-handle:name ).
     1226     end.
     1227     assign
     1228       v-idx-field-qnty = num-entries( v-inform ) - 4
     1229     .
     1230     if v-idx-field-qnty < 2 then do:
     1231       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, p-hst-handle:name ).
     1232     end.
     1233     assign
     1234       v-search-exp  = "where":U
     1235       v-word-link   = "":U
     1236       v-av-chip-num = false
     1237     .
     1238     do v-ind = 1 to v-idx-field-qnty by 2
     1239     on error undo, return error
     1240     :
     1241       assign
     1242         v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     1243         fh           = p-hst-handle:buffer-field( v-field-name )
     1244         v-search-exp = substitute( "&1 &2 &3.&4", v-search-exp, v-word-link, fh:table, v-field-name )
     1245       .
     1246       if v-field-name = "chip-num":U then do:
     1247         assign
     1248           v-search-exp  = substitute( "&1 >", v-search-exp )
     1249           v-av-chip-num = true
     1250         .
     1251       end.
     1252       else do:
     1253         assign
     1254           v-search-exp = substitute( "&1 =", v-search-exp )
     1255         .
     1256       end.
     1257       if fh:data-type ="character":U then do:
     1258         assign
     1259           v-search-exp = substitute( '&1 "&2"', v-search-exp, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
     1260         .
     1261       end.
     1262       else do:
     1263         assign
     1264           v-search-exp = substitute( '&1 &2', v-search-exp, fh:buffer-value() )
     1265         .
     1266       end.
     1267       if v-word-link = "":U then do:
     1268         assign
     1269           v-word-link = "and":U
     1270         .
     1271       end.
     1272     end.
     1273     if v-av-chip-num = false then do:
     1274       message
     1275         vss-workfile vss-revision vss-description skip
     1276         substitute( "Таблица &2 не содержит поля chip-num.", vss-workfile, p-hst-handle:name ) skip
     1277         "Использование данной процедуры невозможно!" skip
     1278         view-as alert-box error .
     1279       return error .
     1280     end.
     1281     h-new-buf:find-first( v-search-exp, no-lock ) no-error .
     1282     if not h-new-buf:available then do:
     1283       h-main-buf:find-first( v-srch-main, no-lock ) no-error .
     1284       if not h-main-buf:available then do:
     1285         assign
     1286           h-for-comp = ?
     1287         .
     1288       end.
     1289       else do:
     1290         assign
     1291           h-for-comp = h-main-buf
     1292         .
     1293       end.
     1294     end.
     1295     else do:
     1296       assign
     1297         h-for-comp = h-new-buf
     1298       .
     1299     end.
     1300     assign
     1301       v-num-entries = num-entries( v-main-fld-lst, ",":U )
     1302     .
     1303     do v-ind = 1 to v-num-entries
     1304     on error undo, return error return-value
     1305     :
     1306       assign
     1307         v-field-name = entry( v-ind, v-main-fld-lst )
     1308         fh-old       = p-hst-handle:buffer-field( v-field-name )
     1309         v-old-value  = fh-old:buffer-value()
     1310         v-label      = trim( fh-old:label )
     1311       .
     1312       if ( trim( p-field-list ) <> "":U
     1313            and lookup( v-field-name, p-field-list ) > 0
     1314          )
     1315          or trim( p-field-list ) = "":U
     1316       then do:
     1317         if h-for-comp <> ? then do:
     1318           assign
     1319             fh-new      = h-for-comp:buffer-field( v-field-name )
     1320             v-new-value = fh-new:buffer-value()
     1321           .
     1322         end.
     1323         else do:
     1324           assign
     1325             v-new-value = "":U
     1326           .
     1327         end.
     1328         if v-old-value <> v-new-value
     1329         then do:
     1330           create temp-changes.
     1331           assign
     1332             temp-changes.t_name = p-main-table
     1333             temp-changes.f_name = v-field-name
     1334             temp-changes.l_name = replace( v-label, "&":U, "":U )
     1335             temp-changes.v_old  = trim( v-old-value )
     1336             temp-changes.v_new  = trim( v-new-value )
     1337             temp-changes.num_   = 0
     1338             temp-changes.fNotChange = v-old-value eq v-new-value
     1339           .
     1340         end.
     1341       end.
     1342     end.
     1343     assign
     1344       v-num-entries = num-entries( p-label-form, chr(8) )
     1345     .
     1346     do v-ind = 1 to v-num-entries
     1347     on error undo, return error return-value
     1348     :
     1349       if num-entries( entry( v-ind, p-label-form, chr(8) ), chr(4) ) = 3 then do:
     1350         assign
     1351           v-field-name = entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1352           v-field-lvl  = entry( 2, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1353           v-field-form = entry( 3, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1354         .
     1355         find first temp-changes
     1356           where temp-changes.f_name = v-field-name
     1357           no-error .
     1358         if available temp-changes then do:
     1359           if trim( v-field-lvl ) <> "":U then do:
     1360             assign
     1361               temp-changes.l_name = v-field-lvl
     1362             .
     1363           end.
     1364           if trim( v-field-form ) <> "":U then do:
     1365             assign
     1366               temp-changes.v_old = dynamic-function( v-field-form, temp-changes.v_old )
     1367             .
     1368             if h-for-comp <> ? then do:
     1369               assign
     1370                 temp-changes.v_new = dynamic-function( v-field-form, temp-changes.v_new )
     1371               .
     1372             end.
     1373           end.
     1374         end.
     1375       end.
     1376       else do:
     1377         message
     1378           vss-workfile vss-revision vss-description skip
     1379           "Ошибка! Список должен содержать три поля с разделителем delim-par!" skip
     1380           substitute( "список для поля '&1': '&2'"
     1381                       ,entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1382                       ,entry( v-ind, p-label-form, chr(8) )
     1383                     ) skip
     1384           substitute( "полный список: &2", p-label-form ) skip
     1385           view-as alert-box error .
     1386       end.
     1387     end.
     1388     delete object h-new-buf .
     1389     delete object h-main-buf .
     1390   END PROCEDURE.
     1391   FUNCTION get-action RETURNS CHARACTER
     1392     ( p-action as integer )  FORWARD.
     1393   FUNCTION get-subject RETURNS CHARACTER
     1394     ( p-subject as character )  FORWARD.
     1395   DEFINE BUTTON B-Help
     1396        LABEL "Помо&щь"
     1397        SIZE 3 BY 1
     1398        BGCOLOR 8 .
     1399   DEFINE BUTTON B-lookup
     1400        LABEL "&Просмотр"
     1401        SIZE 10 BY 1.
     1402   DEFINE BUTTON B-mark
     1403        LABEL "&*"
     1404        SIZE 3 BY 1.
     1405   DEFINE BUTTON B-print
     1406        LABEL "Пе&чать"
     1407        SIZE 3 BY 1.
     1408   DEFINE BUTTON b-quit AUTO-END-KEY
     1409        LABEL "&Выход"
     1410        SIZE 10 BY 1
     1411        BGCOLOR 8 .
     1412   DEFINE BUTTON B-sch
     1413        LABEL "&Фильтр"
     1414        SIZE 3 BY 1.
     1415   DEFINE BUTTON b-sel AUTO-GO
     1416        LABEL "Вы&бор"
     1417        SIZE 10 BY 1
     1418        BGCOLOR 8 .
     1419   DEFINE VARIABLE mark-num AS CHARACTER FORMAT "X(256)":U
     1420         VIEW-AS TEXT
     1421        SIZE 6 BY 1
     1422        FGCOLOR 4  NO-UNDO.
     1423   DEFINE VARIABLE sch-corr-date AS DATE FORMAT "99/99/9999":U
     1424        LABEL "Дате изменения"
     1425        VIEW-AS FILL-IN
     1426        SIZE 11 BY 1 NO-UNDO.
     1427   DEFINE VARIABLE sch-corr-user-name AS CHARACTER FORMAT "X(9)":U
     1428        LABEL "пользователю"
     1429        VIEW-AS FILL-IN
     1430        SIZE 12 BY 1 TOOLTIP "Поиск первой записи - <ВВОД>; поиск следующей - <CTRL-J>" NO-UNDO.
     1431   DEFINE VARIABLE sch-nozzle-code AS INTEGER FORMAT ">>>>>>9":U INITIAL 0
     1432        LABEL "№ ТРК"
     1433        VIEW-AS FILL-IN
     1434        SIZE 8 BY 1 TOOLTIP "Поиск первой записи - <ВВОД>; поиск следующей - <CTRL-J>" NO-UNDO.
     1435   DEFINE QUERY BR-changes FOR
     1436         temp-changes SCROLLING.
     1437   DEFINE QUERY br-nzl-hist FOR
     1438         X_c-nzl-hist SCROLLING.
     1439   DEFINE BROWSE BR-changes
     1440     QUERY BR-changes DISPLAY
     1441         temp-changes.l_name COLUMn-LABEL "Изменилось" format "X(40)"
     1442   temp-changes.v_old COLUMn-LABEL "Было" format "X(70)"
     1443   temp-changes.v_new COLUMn-LABEL "Стало" format "X(70)"
     1444       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 7.25.
     1445   DEFINE BROWSE br-nzl-hist
     1446     QUERY br-nzl-hist NO-LOCK DISPLAY
     1447         mark-string(recid(X_c-nzl-hist), v-rid-list) COLUMN-LABEL "*" FORMAT "X(1)":U
     1448         X_c-nzl-hist.nozzle-code COLUMN-LABEL "№ пистолета" FORMAT ">9":U
     1449         X_c-nzl-hist.corr-date FORMAT "99/99/9999":U
     1450         string(X_c-nzl-hist.corr-time, "HH:MM:SS":U) COLUMN-LABEL "Время изм." FORMAT "X(8)":U
     1451         usrfulnf(X_c-nzl-hist.corr-user-name) FORMAT "X(18)":U
     1452         get-action(X_c-nzl-hist.action) COLUMN-LABEL "Действие" FORMAT "X(10)":U
     1453         X_c-nzl-hist.corr-user-db-num FORMAT ">>>>9":U
     1454         get-subject(X_c-nzl-hist.subject) COLUMN-LABEL "Предмет изменений" FORMAT "X(15)":U
     1455         X_c-nzl-hist.obj-type + string(X_c-nzl-hist.obj-code) COLUMN-LABEL "Объект" FORMAT "X(8)":U
     1456     ENABLE
     1457         X_c-nzl-hist.corr-date
     1458       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 11.46.
     1459   DEFINE FRAME Dialog-Frame
     1460        b-quit AT ROW 1 COL 1
     1461        B-mark AT ROW 1 COL 11
     1462        b-sel AT ROW 1 COL 21
     1463        B-print AT ROW 1 COL 89
     1464        B-sch AT ROW 1 COL 92
     1465        B-Help AT ROW 1 COL 95
     1466        B-lookup AT ROW 1.04 COL 45
     1467        br-nzl-hist AT ROW 2 COL 1
     1468        sch-corr-date AT ROW 13.63 COL 85.75 COLON-ALIGNED
     1469        sch-nozzle-code AT ROW 13.67 COL 56.13 COLON-ALIGNED
     1470        sch-corr-user-name AT ROW 13.71 COL 22.5 COLON-ALIGNED
     1471        BR-changes AT ROW 14.79 COL 1
     1472        mark-num AT ROW 1 COL 12.5 COLON-ALIGNED NO-LABEL
     1473        "ПОИСК ПО" VIEW-AS TEXT
     1474             SIZE 8.38 BY 1 AT ROW 13.63 COL 1.38
     1475             FGCOLOR 4
     1476        SPACE(89.48) SKIP(7.44)
     1477       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1478            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1479            TITLE "Полная истоия по ТРК"
     1480            CANCEL-BUTTON b-quit.
     1481   ASSIGN
     1482          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1483          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1484   ON GO OF FRAME Dialog-Frame
     1485   DO:
     1486     p-rid-list = v-rid-list.
     1487   END.
     1488   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1489   DO:
     1490     APPLY "END-ERROR":U TO SELF.
     1491   END.
     1492   ON CHOOSE OF B-lookup IN FRAME Dialog-Frame
     1493   DO:
     1494     DEFINE VARIABLE v-rec AS RECID NO-UNDO.
     1495     DEFINE BUFFER buf_c-pump FOR ub.c-pump.
     1496     DEFINE BUFFER buf_c-pl-gds-pump FOR ub.c-pl-gds-pump.
     1497     DEFINE BUFFER buf_c-pl-pump FOR ub.c-pl-pump.
     1498     DEFINE BUFFER buf_c-pl-pump-nozzle FOR ub.c-pl-pump-nozzle.
     1499     DEFINE BUFFER buf_c-pump-nozzle FOR ub.c-pl-pump-nozzle.
     1500       IF AVAILABLE X_c-nzl-hist THEN DO:
     1501       CASE X_c-nzl-hist.subject:
     1502       END CASE.
     1503     END.
     1504   END.
     1505   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
     1506   DO:
     1507   define variable loc#log as logical no-undo .
     1508     if available X_c-nzl-hist then do:
     1509   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1510   define variable v-str-recid14 as character no-undo .
     1511   define variable v-num-entry14 as integer   no-undo .
     1512   assign
     1513     v-str-recid14 = trim( string( recid( X_c-nzl-hist ) , "->>>>>>>>>>>9":U ) )
     1514     v-num-entry14 = lookup( v-str-recid14 , v-rid-list )
     1515   .
     1516   if v-num-entry14 > 0 then do:
     1517     assign
     1518       entry( v-num-entry14, v-rid-list ) = "":U
     1519       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1520     .
     1521   end.
     1522   else do:
     1523     assign
     1524       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid14
     1525     .
     1526   end.
     1527       loc#log = br-nzl-hist:refresh() .
     1528       if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
     1529           loc#log = br-nzl-hist:select-next-row ().
     1530           apply "VALUE-CHANGED" to br-nzl-hist in frame Dialog-Frame.
     1531       end.
     1532       if num-entries( v-rid-list ) = 0
     1533       then
     1534           hide mark-num in frame Dialog-Frame.
     1535       else
     1536           disp num-entries( v-rid-list ) @ mark-num with frame Dialog-Frame.
     1537     end.
     1538     apply "entry" to br-nzl-hist in frame Dialog-Frame.
     1539   END.
     1540   ON CHOOSE OF B-print IN FRAME Dialog-Frame
     1541   DO:
     1542       run proc-b-print in this-procedure no-error.
     1543     if error-status:error then return no-apply.
     1544   END.
     1545   ON CHOOSE OF B-sch IN FRAME Dialog-Frame
     1546   DO:
     1547       run proc-b-sch in this-procedure no-error.
     1548     if error-status:error then return no-apply.
     1549   END.
     1550   ON CHOOSE OF b-sel IN FRAME Dialog-Frame
     1551   DO:
     1552     if ( available X_c-nzl-hist ) then do:
     1553       if ( v-rid-list = "" ) or b-mark:sensitive = no
     1554       then
     1555       v-rid-list = string( recid( X_c-nzl-hist ) ) .
     1556     end.
     1557   END.
     1558   ON MOUSE-SELECT-DBLCLICK OF br-nzl-hist IN FRAME Dialog-Frame
     1559   DO:
     1560        run proc-br-nzl-hist in this-procedure no-error.
     1561     if error-status:error then return no-apply.
     1562   END.
     1563   ON RETURN OF br-nzl-hist IN FRAME Dialog-Frame
     1564   DO:
     1565       run proc-br-nzl-hist in this-procedure no-error.
     1566     if error-status:error then return no-apply.
     1567   END.
     1568   ON VALUE-CHANGED OF br-nzl-hist IN FRAME Dialog-Frame
     1569   DO:
     1570     run proc-view-changes in this-procedure no-error.
     1571   END.
     1572   ON CTRL-J OF sch-corr-date IN FRAME Dialog-Frame
     1573   DO:
     1574      run proc-find-corr-date in this-procedure(yes, input frame Dialog-Frame sch-corr-date) no-error.
     1575     if error-status:error then return no-apply.
     1576   END.
     1577   ON RETURN OF sch-corr-date IN FRAME Dialog-Frame
     1578   DO:
     1579     run proc-find-corr-date in this-procedure(no, input frame Dialog-Frame sch-corr-date) no-error.
     1580     if error-status:error then return no-apply.
     1581   END.
     1582   ON CTRL-J OF sch-corr-user-name IN FRAME Dialog-Frame
     1583   DO:
     1584     run proc-find-user in this-procedure(yes, input frame Dialog-Frame sch-corr-user-name) no-error.
     1585     if error-status:error then return no-apply.
     1586   END.
     1587   ON RETURN OF sch-corr-user-name IN FRAME Dialog-Frame
     1588   DO:
     1589     run proc-find-user in this-procedure(no, input frame Dialog-Frame sch-corr-user-name) no-error.
     1590     if error-status:error then return no-apply.
     1591   END.
     1592   ON CTRL-J OF sch-nozzle-code IN FRAME Dialog-Frame
     1593   DO:
     1594     run proc-find-nozzle-code in this-procedure(yes, input frame Dialog-Frame sch-nozzle-code) no-error.
     1595     if error-status:error then return no-apply.
     1596   END.
     1597   ON RETURN OF sch-nozzle-code IN FRAME Dialog-Frame
     1598   DO:
     1599     run proc-find-nozzle-code in this-procedure(no, input frame Dialog-Frame sch-nozzle-code) no-error.
     1600     if error-status:error then return no-apply.
     1601   END.
     1602   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1603   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1604   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1605   on help of frame Dialog-Frame
     1606   do:
     1607     run gbl/app_help.p
     1608       (input this-procedure :file-name
     1609       ,input ''
     1610       ,input ?
     1611       ) no-error.
     1612     if error-status :error then do:
     1613       message
     1614         "Ошибка при вызове помощи"
     1615         error-status :get-message(1)
     1616         view-as alert-box .
     1617     end.
     1618   end.
     1619   run minbtn-set in this-procedure .
     1620   on choose of b-help in frame Dialog-Frame
     1621   do:
     1622     apply "help":u to frame Dialog-Frame .
     1623   end.
     1624   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1625   procedure minbtn-set :
     1626       do
     1627           on error undo, return error return-value
     1628           :
     1629           define variable ii              as integer       no-undo .
     1630           define variable fh              as widget-handle no-undo .
     1631           define variable hh              as widget-handle no-undo .
     1632           define variable v-h             as handle        extent 4 no-undo .
     1633           define variable v-name-button   as character     no-undo .
     1634           define variable v-help-old-x    as decimal       no-undo .
     1635           define variable v-help-old-y    as decimal       no-undo .
     1636           define variable v-help-old-size as decimal       no-undo .
     1637           define variable v-frame-width   as decimal       no-undo .
     1638           define variable jj              as integer       no-undo .
     1639           do
     1640               on error undo, return error
     1641               :
     1642               assign
     1643                   v-frame-width = frame Dialog-Frame:width - 0.3
     1644                   fh            = frame Dialog-Frame:first-child
     1645                   hh            = fh:first-child
     1646                   ii            = 1
     1647                   .
     1648               do while valid-handle(hh):
     1649                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1650                   do:
     1651                       case lc(hh:name) :
     1652                           when "b-help" then
     1653                               do:
     1654                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1655                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1656                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1657                                   hh:TOOLTIP = "Помощь" .
     1658                                   v-help-old-x = hh:column .
     1659                                   v-help-old-y = hh:row    .
     1660                                   v-help-old-size = hh:width .
     1661                                   hh:width-chars = 2.5 .
     1662                               end.
     1663                           when "b-print" then
     1664                               do:
     1665                                   hh:load-image("cmp/b-print.bmp":u) .
     1666                                   hh:TOOLTIP = "Печать" .
     1667                                   v-h[ii] = hh:handle .
     1668                                   ii = ii + 1 .
     1669                                   hh:width-chars = 3 .
     1670                               end.
     1671                           when "b-history" or
     1672                           when "b-hist" then
     1673                               do:
     1674                                   hh:load-image("cmp/b-hist.bmp":u) .
     1675                                   hh:TOOLTIP = "История" .
     1676                                   v-h[ii] = hh:handle .
     1677                                   ii = ii + 1 .
     1678                                   hh:width-chars = 3 .
     1679                               end.
     1680                           when "b-sch" then
     1681                               do:
     1682                                   hh:load-image("cmp/b-sch.bmp":u) .
     1683                                   hh:TOOLTIP = "Установка Фильтра" .
     1684                                   v-h[ii] = hh:handle .
     1685                                   ii = ii + 1 .
     1686                                   hh:width-chars = 3 .
     1687                               end.
     1688                           when "b-hist-user" then
     1689                               do:
     1690                                   hh:load-image("cmp/b-hist.bmp":u) .
     1691                                   hh:TOOLTIP = "История пользователя" .
     1692                                   ii = ii + 1 .
     1693                               end.
     1694                       end case.
     1695                   end.
     1696                   hh = hh:next-sibling.
     1697               end.
     1698               b-help:column = v-frame-width - b-help:width-chars.
     1699               jj = 0.
     1700               repeat ii = 4 to 1 by -1 :
     1701                   if valid-handle (v-h[ii] ) then
     1702                   do:
     1703                       jj  = jj + 1 .
     1704                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1705                       v-h[ii]:row    = v-help-old-y .
     1706                   end.
     1707               end.
     1708           end.
     1709       end.
     1710   end procedure.
     1711   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1712   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1713   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1714   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1715   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1716   define variable v-diasize-current-frame-height as decimal   no-undo .
     1717   define variable v-diasize-change-size          as logical   no-undo .
     1718   define variable v-diasize-resize-button        as handle    no-undo .
     1719   define variable v-diasize-wndmax               as logical   no-undo .
     1720   define variable v-diasize-wndstore             as logical   no-undo .
     1721   define variable v-diasize-proc-name            as character no-undo .
     1722   define variable v-diasize-browse-handle        as handle    no-undo .
     1723   define variable v-diasize-browse-number        as integer   no-undo .
     1724   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1725   define temp-table temp-diasize-handle no-undo
     1726     field handle-value  as handle
     1727     field save-position as decimal
     1728     index xpk is primary unique handle-value
     1729     .
     1730   define temp-table temp-browse-handle no-undo
     1731     field browse-type   as character
     1732     field browse-number as integer
     1733     field browse-handle as handle
     1734     field original-size as decimal
     1735     index xpk is primary unique browse-type browse-number
     1736     index xie browse-type browse-handle
     1737   .
     1738   procedure diasize_change-height :
     1739     define input  parameter p-change-value  as decimal   no-undo .
     1740     define input  parameter p-move-resize   as logical   no-undo .
     1741     define variable v-field-group-handle    as handle    no-undo .
     1742     define variable v-object-handle         as handle    no-undo .
     1743     define variable v-frame-height          as decimal   no-undo .
     1744     define variable v-frame-virtual-height  as decimal   no-undo .
     1745     define variable v-browse-height         as decimal   no-undo .
     1746     define variable v-window-height         as decimal   no-undo .
     1747     define variable v-window-virtual-height as decimal   no-undo .
     1748     define variable v-change-sign           as integer   no-undo .
     1749     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1750     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1751     if p-change-value > 0
     1752     then do:
     1753       if frame Dialog-Frame :height + p-change-value
     1754           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1755       then do:
     1756         assign
     1757           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1758                           - (frame Dialog-Frame :height-chars)
     1759         .
     1760         if p-change-value <= 0
     1761         then do:
     1762           run diasize_position-resize-button in this-procedure .
     1763           return .
     1764         end.
     1765       end.
     1766     end.
     1767     if p-change-value < 0
     1768     then do:
     1769       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1770       then do:
     1771         assign
     1772           p-change-value = v-diasize-orig-frame-height
     1773                          - (frame Dialog-Frame :height-chars)
     1774         .
     1775         if p-change-value >= 0
     1776         then do:
     1777           run diasize_position-resize-button in this-procedure .
     1778           return .
     1779         end.
     1780       end.
     1781     end.
     1782     if p-change-value >= 0
     1783     then do:
     1784       assign
     1785         v-change-sign = 1
     1786       .
     1787     end.
     1788     else do:
     1789       assign
     1790         v-change-sign = -1
     1791       .
     1792     end.
     1793     assign
     1794       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1795     .
     1796     if p-change-value = 0
     1797     then do:
     1798       run diasize_position-resize-button in this-procedure .
     1799       return .
     1800     end.
     1801     move_block:
     1802     do
     1803     on error undo move_block, retry move_block
     1804     :
     1805       if retry
     1806       then do:
     1807         do
     1808         on error undo move_block, leave move_block
     1809         :
     1810           if p-change-value > 0
     1811           then do:
     1812             for each buf_temp-diasize-handle
     1813             on error undo, next
     1814             :
     1815               assign
     1816                 v-object-handle = buf_temp-diasize-handle.handle-value
     1817               .
     1818               if v-object-handle <> v-diasize-resize-button
     1819               then do:
     1820                 assign
     1821                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1822                 .
     1823               end.
     1824             end.
     1825             assign
     1826               v-diasize-browse-handle :height = v-browse-height
     1827             .
     1828             for each buf_temp-browse-handle
     1829               where buf_temp-browse-handle.browse-type = 'height':u
     1830             on error undo, next
     1831             :
     1832               assign
     1833                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1834               .
     1835             end.
     1836             assign
     1837               frame Dialog-Frame :height = v-frame-height
     1838             .
     1839             if frame Dialog-Frame :scrollable = true
     1840             then do:
     1841               assign
     1842                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1843               .
     1844             end.
     1845             run diasize_position-resize-button in this-procedure .
     1846           end.
     1847           else do:
     1848             if frame Dialog-Frame :scrollable = true
     1849             then do:
     1850               assign
     1851                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1852               .
     1853             end.
     1854             assign
     1855               frame Dialog-Frame :height = v-frame-height
     1856             .
     1857             assign
     1858               v-diasize-browse-handle :height = v-browse-height
     1859             .
     1860             for each buf_temp-browse-handle
     1861               where buf_temp-browse-handle.browse-type = 'height':u
     1862             on error undo, next
     1863             :
     1864               assign
     1865                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1866               .
     1867             end.
     1868             for each buf_temp-diasize-handle
     1869             on error undo, next
     1870             :
     1871               assign
     1872                 v-object-handle = buf_temp-diasize-handle.handle-value
     1873               .
     1874               if v-object-handle <> v-diasize-resize-button
     1875               then do:
     1876                 assign
     1877                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1878                 .
     1879               end.
     1880             end.
     1881             run diasize_position-resize-button in this-procedure .
     1882           end.
     1883           assign
     1884             v-diasize-change-size = false
     1885           .
     1886           leave move_block .
     1887         end.
     1888       end.
     1889       assign
     1890         v-diasize-need-full-display = true
     1891       .
     1892       if v-diasize-change-size = false
     1893       then do:
     1894         assign
     1895           v-diasize-change-size = true
     1896         .
     1897       end.
     1898       else do:
     1899         return .
     1900       end.
     1901       assign
     1902         v-frame-height = frame Dialog-Frame :height
     1903         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1904         v-browse-height = v-diasize-browse-handle :height
     1905       .
     1906       for each buf_temp-browse-handle
     1907         where buf_temp-browse-handle.browse-type = 'height':u
     1908       :
     1909         assign
     1910           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1911         .
     1912       end.
     1913       for each buf_temp-diasize-handle
     1914       :
     1915         delete buf_temp-diasize-handle .
     1916       end.
     1917       assign
     1918         v-field-group-handle = frame Dialog-Frame :first-child
     1919       .
     1920       do while valid-handle(v-field-group-handle)
     1921       :
     1922         assign
     1923           v-object-handle = v-field-group-handle :first-child
     1924         .
     1925         do while valid-handle(v-object-handle)
     1926         :
     1927           if  v-object-handle <> v-diasize-browse-handle :handle
     1928           and can-query(v-object-handle, "row")
     1929           and can-query(v-object-handle, "height")
     1930           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1931           then do:
     1932             find first buf_temp-browse-handle
     1933               where buf_temp-browse-handle.browse-type   = 'height':u
     1934                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1935               no-error .
     1936             if available buf_temp-browse-handle
     1937             then do:
     1938             end.
     1939             else do:
     1940               create buf_temp-diasize-handle .
     1941               assign
     1942                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1943                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1944               .
     1945             end.
     1946           end.
     1947           assign
     1948             v-object-handle = v-object-handle :next-sibling
     1949           .
     1950         end.
     1951         assign
     1952           v-field-group-handle = v-field-group-handle :next-sibling
     1953         .
     1954       end.
     1955       do with frame Dialog-Frame
     1956       :
     1957         hide v-diasize-resize-button .
     1958         assign
     1959           v-diasize-resize-button :row    = 1
     1960           v-diasize-resize-button :column = 1
     1961         .
     1962       end.
     1963       if p-change-value > 0
     1964       then do:
     1965         if frame Dialog-Frame :scrollable = true
     1966         then do:
     1967           assign
     1968             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1969             no-error .
     1970           if error-status :error
     1971           or error-status :get-message(1) <> ""
     1972           then do:
     1973             undo move_block, retry move_block .
     1974           end.
     1975         end.
     1976         assign
     1977           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1978           no-error .
     1979         if error-status :error
     1980         or error-status :get-message(1) <> ""
     1981         then do:
     1982           undo move_block, retry move_block .
     1983         end.
     1984         assign
     1985           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1986           no-error .
     1987         if error-status :error
     1988         or error-status :get-message(1) <> ""
     1989         then do:
     1990           undo move_block, retry move_block .
     1991         end.
     1992         for each buf_temp-browse-handle
     1993           where buf_temp-browse-handle.browse-type = 'height':u
     1994         on error undo move_block, retry move_block
     1995         :
     1996           assign
     1997             buf_temp-browse-handle.browse-handle :height
     1998               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1999             no-error .
     2000           if error-status :error
     2001           or error-status :get-message(1) <> ""
     2002           then do:
     2003             undo move_block, retry move_block .
     2004           end.
     2005         end.
     2006         for each buf_temp-diasize-handle
     2007         on error undo move_block, retry move_block
     2008         :
     2009           assign
     2010             v-object-handle = buf_temp-diasize-handle.handle-value
     2011           .
     2012           if v-object-handle <> v-diasize-resize-button
     2013           then do:
     2014             assign
     2015               v-object-handle :row = v-object-handle :row + p-change-value
     2016               no-error .
     2017             if error-status :error
     2018             or error-status :get-message(1) <> ""
     2019             then do:
     2020               undo move_block, retry move_block .
     2021             end.
     2022           end.
     2023         end.
     2024       end.
     2025       else do:
     2026         for each buf_temp-diasize-handle
     2027         on error undo move_block, retry move_block
     2028         :
     2029           assign
     2030             v-object-handle = buf_temp-diasize-handle.handle-value
     2031           .
     2032           if v-object-handle <> v-diasize-resize-button
     2033           then do:
     2034             assign
     2035               v-object-handle :row = v-object-handle :row + p-change-value
     2036               no-error .
     2037             if error-status :error
     2038             or error-status :get-message(1) <> ""
     2039             then do:
     2040               undo move_block, retry move_block .
     2041             end.
     2042           end.
     2043         end.
     2044         assign
     2045           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2046           no-error .
     2047         if error-status :error
     2048         or error-status :get-message(1) <> ""
     2049         then do:
     2050           undo move_block, retry move_block .
     2051         end.
     2052         for each buf_temp-browse-handle
     2053           where buf_temp-browse-handle.browse-type = 'height':u
     2054         on error undo move_block, retry move_block
     2055         :
     2056           assign
     2057             buf_temp-browse-handle.browse-handle :height
     2058               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2059             no-error .
     2060           if error-status :error
     2061           or error-status :get-message(1) <> ""
     2062           then do:
     2063             undo move_block, retry move_block .
     2064           end.
     2065         end.
     2066         assign
     2067           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2068           no-error .
     2069         if error-status :error
     2070         or error-status :get-message(1) <> ""
     2071         then do:
     2072           undo move_block, retry move_block .
     2073         end.
     2074         if frame Dialog-Frame :scrollable = true
     2075         then do:
     2076           assign
     2077             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2078             no-error .
     2079           if error-status :error
     2080           or error-status :get-message(1) <> ""
     2081           then do:
     2082             undo move_block, retry move_block .
     2083           end.
     2084         end.
     2085       end.
     2086       if p-move-resize = true
     2087       then do:
     2088         run diasize_position-resize-button in this-procedure .
     2089       end.
     2090       if v-diasize-wndstore = true
     2091       then do:
     2092         if connected("ub") = true
     2093         then do:
     2094           define variable v-cntxt-db-num        as integer   no-undo .
     2095           define variable v-cntxt-userid        as character no-undo .
     2096           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2097                                             , OUTPUT v-cntxt-userid
     2098                                             ) .
     2099           run gbl/wndsizew.p
     2100             (input  v-cntxt-db-num
     2101             ,input  v-cntxt-userid
     2102             ,input  v-diasize-proc-name
     2103             ,input  'height':u
     2104             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     2105             ) .
     2106         end.
     2107       end.
     2108     end.
     2109     assign
     2110       v-diasize-change-size = false
     2111     .
     2112   end procedure.
     2113   procedure diasize_set-height :
     2114     define input  parameter p-new-height  as decimal   no-undo .
     2115     define input  parameter p-move-resize as logical   no-undo .
     2116     do
     2117     on error undo, return error return-value
     2118     :
     2119       run diasize_change-height in this-procedure
     2120         (input  (p-new-height - frame Dialog-Frame :height)
     2121         ,input  p-move-resize
     2122         ) .
     2123     end.
     2124   end procedure.
     2125   procedure diasize_change-width :
     2126     define input  parameter p-change-value as decimal   no-undo .
     2127     define input  parameter p-move-resize  as logical   no-undo .
     2128     define variable v-field-group-handle   as handle    no-undo .
     2129     define variable v-object-handle        as handle    no-undo .
     2130     define variable v-frame-width          as decimal   no-undo .
     2131     define variable v-frame-virtual-width  as decimal   no-undo .
     2132     define variable v-browse-width         as decimal   no-undo .
     2133     define variable v-window-width         as decimal   no-undo .
     2134     define variable v-window-virtual-width as decimal   no-undo .
     2135     define variable v-change-sign          as integer   no-undo .
     2136     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2137     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2138     if p-change-value > 0
     2139     then do:
     2140       if frame Dialog-Frame :width + p-change-value >
     2141           session :width-chars
     2142       then do:
     2143         assign
     2144           p-change-value = session :width-chars - frame Dialog-Frame :width
     2145         .
     2146         if p-change-value <= 0
     2147         then do:
     2148           run diasize_position-resize-button in this-procedure .
     2149           return .
     2150         end.
     2151       end.
     2152     end.
     2153     if p-change-value < 0
     2154     then do:
     2155       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     2156       then do:
     2157         assign
     2158           p-change-value = v-diasize-orig-frame-width
     2159                          - frame Dialog-Frame :width
     2160         .
     2161         if p-change-value >= 0
     2162         then do:
     2163           run diasize_position-resize-button in this-procedure .
     2164           return .
     2165         end.
     2166       end.
     2167     end.
     2168     if p-change-value >= 0
     2169     then do:
     2170       assign
     2171         v-change-sign = 1
     2172       .
     2173     end.
     2174     else do:
     2175       assign
     2176         v-change-sign = -1
     2177       .
     2178     end.
     2179     assign
     2180       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2181     .
     2182     if p-change-value = 0
     2183     then do:
     2184       run diasize_position-resize-button in this-procedure .
     2185       return .
     2186     end.
     2187     move_block:
     2188     do
     2189     on error undo move_block, leave move_block
     2190     :
     2191       if retry
     2192       then do:
     2193         do
     2194         on error undo move_block, leave move_block
     2195         :
     2196           if p-change-value > 0
     2197           then do:
     2198             for each buf_temp-diasize-handle
     2199             on error undo, next
     2200             :
     2201               assign
     2202                 v-object-handle = buf_temp-diasize-handle.handle-value
     2203               .
     2204               if v-object-handle <> v-diasize-resize-button
     2205               then do:
     2206                 assign
     2207                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2208                 .
     2209               end.
     2210             end.
     2211             assign
     2212               v-diasize-browse-handle :width = v-browse-width
     2213             .
     2214             for each buf_temp-browse-handle
     2215               where buf_temp-browse-handle.browse-type = 'width':u
     2216             on error undo, next
     2217             :
     2218               assign
     2219                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2220               .
     2221             end.
     2222             assign
     2223               frame Dialog-Frame :width = v-frame-width
     2224             .
     2225             if frame Dialog-Frame :scrollable = true
     2226             then do:
     2227               assign
     2228                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2229               .
     2230             end.
     2231             run diasize_position-resize-button in this-procedure .
     2232           end.
     2233           else do:
     2234             if frame Dialog-Frame :scrollable = true
     2235             then do:
     2236               assign
     2237                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2238               .
     2239             end.
     2240             assign
     2241               frame Dialog-Frame :width = v-frame-width
     2242             .
     2243             for each buf_temp-browse-handle
     2244               where buf_temp-browse-handle.browse-type = 'width':u
     2245             on error undo, next
     2246             :
     2247               assign
     2248                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2249               .
     2250             end.
     2251             assign
     2252               v-diasize-browse-handle :width = v-browse-width
     2253             .
     2254             for each buf_temp-diasize-handle
     2255             on error undo, next
     2256             :
     2257               assign
     2258                 v-object-handle = buf_temp-diasize-handle.handle-value
     2259               .
     2260               if v-object-handle <> v-diasize-resize-button
     2261               then do:
     2262                 assign
     2263                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2264                 .
     2265               end.
     2266             end.
     2267             run diasize_position-resize-button in this-procedure .
     2268           end.
     2269           assign
     2270             v-diasize-change-size = false
     2271           .
     2272           leave move_block .
     2273         end.
     2274       end.
     2275       assign
     2276         v-diasize-need-full-display = true
     2277       .
     2278       if v-diasize-change-size = false
     2279       then do:
     2280         assign
     2281           v-diasize-change-size = true
     2282         .
     2283       end.
     2284       else do:
     2285         return .
     2286       end.
     2287       assign
     2288         v-frame-width = frame Dialog-Frame :width
     2289         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     2290         v-browse-width = v-diasize-browse-handle :width
     2291       .
     2292       for each buf_temp-browse-handle
     2293         where buf_temp-browse-handle.browse-type = 'width':u
     2294       :
     2295         assign
     2296           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2297         .
     2298       end.
     2299       for each buf_temp-diasize-handle
     2300       :
     2301         delete buf_temp-diasize-handle .
     2302       end.
     2303       assign
     2304         v-field-group-handle = frame Dialog-Frame :first-child
     2305       .
     2306       do while valid-handle(v-field-group-handle)
     2307       :
     2308         assign
     2309           v-object-handle = v-field-group-handle :first-child
     2310         .
     2311         do while valid-handle(v-object-handle)
     2312         :
     2313           if  v-object-handle <> v-diasize-browse-handle :handle
     2314           and v-object-handle <> v-diasize-resize-button
     2315           and can-query(v-object-handle, "row")
     2316           and can-query(v-object-handle, "height")
     2317           and ( v-object-handle :col + v-object-handle :width
     2318                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2319               )
     2320           then do:
     2321             find first buf_temp-browse-handle
     2322               where buf_temp-browse-handle.browse-type   = 'width':u
     2323                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2324               no-error .
     2325             if available buf_temp-browse-handle
     2326             then do:
     2327             end.
     2328             else do:
     2329               create buf_temp-diasize-handle .
     2330               assign
     2331                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2332                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2333               .
     2334             end.
     2335           end.
     2336           assign
     2337             v-object-handle = v-object-handle :next-sibling
     2338           .
     2339         end.
     2340         assign
     2341           v-field-group-handle = v-field-group-handle :next-sibling
     2342         .
     2343       end.
     2344       do with frame Dialog-Frame
     2345       :
     2346         hide v-diasize-resize-button .
     2347         v-diasize-resize-button :row = 1.
     2348         v-diasize-resize-button :column = 1.
     2349       end.
     2350       if p-change-value > 0
     2351       then do:
     2352         if frame Dialog-Frame :scrollable = true
     2353         then do:
     2354           assign
     2355             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2356             no-error .
     2357           if error-status :error
     2358           or error-status :get-message(1) <> ""
     2359           then do:
     2360             undo move_block, retry move_block.
     2361           end.
     2362         end.
     2363         assign
     2364           frame Dialog-Frame :width = v-frame-width + p-change-value
     2365           no-error .
     2366         if error-status :error
     2367         or error-status :get-message(1) <> ""
     2368         then do:
     2369           undo move_block, retry move_block.
     2370         end.
     2371         assign
     2372           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2373         no-error .
     2374         if error-status :error
     2375         or error-status :get-message(1) <> ""
     2376         then do:
     2377           undo move_block, retry move_block.
     2378         end.
     2379         for each buf_temp-browse-handle
     2380           where buf_temp-browse-handle.browse-type = 'width':u
     2381         on error undo move_block, retry move_block
     2382         :
     2383           assign
     2384             buf_temp-browse-handle.browse-handle :width
     2385               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2386             no-error .
     2387           if error-status :error
     2388           or error-status :get-message(1) <> ""
     2389           then do:
     2390             undo move_block, retry move_block .
     2391           end.
     2392         end.
     2393         for each buf_temp-diasize-handle
     2394         on error undo move_block, retry move_block
     2395         :
     2396           assign
     2397             v-object-handle = buf_temp-diasize-handle.handle-value
     2398           .
     2399           if v-object-handle <> v-diasize-resize-button
     2400           then do:
     2401             assign
     2402               v-object-handle :col = v-object-handle :col + p-change-value
     2403               no-error .
     2404             if error-status :error
     2405             or error-status :get-message(1) <> ""
     2406             then do:
     2407               undo move_block, retry move_block .
     2408             end.
     2409           end.
     2410         end.
     2411       end.
     2412       else do:
     2413         for each buf_temp-diasize-handle
     2414         on error undo move_block, retry move_block
     2415         :
     2416           assign
     2417             v-object-handle = buf_temp-diasize-handle.handle-value
     2418           .
     2419           if v-object-handle <> v-diasize-resize-button
     2420           then do:
     2421             assign
     2422               v-object-handle :col = v-object-handle :col + p-change-value
     2423               no-error .
     2424             if error-status :error
     2425             or error-status :get-message(1) <> ""
     2426             then do:
     2427               undo move_block, retry move_block .
     2428             end.
     2429           end.
     2430         end.
     2431         for each buf_temp-browse-handle
     2432           where buf_temp-browse-handle.browse-type = 'width':u
     2433         on error undo move_block, retry move_block
     2434         :
     2435           assign
     2436             buf_temp-browse-handle.browse-handle :width
     2437               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2438             no-error .
     2439           if error-status :error
     2440           or error-status :get-message(1) <> ""
     2441           then do:
     2442             undo move_block, retry move_block .
     2443           end.
     2444         end.
     2445         assign
     2446           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2447           no-error .
     2448         if error-status :error
     2449         or error-status :get-message(1) <> ""
     2450         then do:
     2451           undo move_block, retry move_block.
     2452         end.
     2453         assign
     2454           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2455         no-error .
     2456         if error-status :error
     2457         or error-status :get-message(1) <> ""
     2458         then do:
     2459           undo move_block, retry move_block.
     2460         end.
     2461         if frame Dialog-Frame :scrollable = true
     2462         then do:
     2463           assign
     2464             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2465           no-error .
     2466           if error-status :error
     2467           or error-status :get-message(1) <> ""
     2468           then do:
     2469             undo move_block, retry move_block.
     2470           end.
     2471         end.
     2472       end.
     2473       if p-move-resize
     2474       then do:
     2475         run diasize_position-resize-button in this-procedure .
     2476       end.
     2477       if v-diasize-wndstore = true
     2478       then do:
     2479         if connected("ub") = true
     2480         then do:
     2481           define variable v-cntxt-db-num        as integer   no-undo .
     2482           define variable v-cntxt-userid        as character no-undo .
     2483           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2484                                             , OUTPUT v-cntxt-userid
     2485                                             ) .
     2486           run gbl/wndsizew.p
     2487             (input  v-cntxt-db-num
     2488             ,input  v-cntxt-userid
     2489             ,input  v-diasize-proc-name
     2490             ,input  'width':u
     2491             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2492             ) .
     2493         end.
     2494       end.
     2495     end.
     2496     assign
     2497       v-diasize-change-size = false
     2498     .
     2499   end procedure.
     2500   procedure diasize_set-width :
     2501     define input  parameter p-new-width  as decimal   no-undo .
     2502     define input  parameter p-move-resize as logical   no-undo .
     2503     do
     2504     on error undo, return error return-value
     2505     :
     2506       run diasize_change-width in this-procedure
     2507         (input  (p-new-width - frame Dialog-Frame :width)
     2508         ,input  p-move-resize
     2509         ) .
     2510     end.
     2511   end procedure.
     2512   procedure diasize_position-resize-button :
     2513     do with frame Dialog-Frame
     2514     :
     2515       hide v-diasize-resize-button .
     2516       assign
     2517         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2518                     - 1
     2519                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2520         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2521                     - 1
     2522                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2523       .
     2524       view v-diasize-resize-button .
     2525     end.
     2526   end procedure.
     2527   on alt-right anywhere
     2528   do:
     2529     run diasize_change-width in this-procedure
     2530       (input 1
     2531       ,input true
     2532       ) .
     2533     return no-apply .
     2534   end.
     2535   on alt-left anywhere
     2536   do:
     2537     run diasize_change-width in this-procedure
     2538       (input -1
     2539       ,input true
     2540       ) .
     2541     return no-apply .
     2542   end.
     2543   on alt-down anywhere
     2544   do:
     2545     run diasize_change-height in this-procedure
     2546       (input 1
     2547       ,input true
     2548       ) .
     2549     return no-apply .
     2550   end.
     2551   on alt-up anywhere
     2552   do:
     2553     run diasize_change-height in this-procedure
     2554       (input -1
     2555       ,input true
     2556       ) .
     2557     return no-apply .
     2558   end.
     2559   on alt-enter of frame Dialog-Frame
     2560   do:
     2561     run diasize_maximize in this-procedure
     2562       (input  ?
     2563       ).
     2564     return no-apply .
     2565   end.
     2566   procedure diasize_end-move :
     2567     do
     2568     on error undo, return error return-value
     2569     :
     2570       define variable v-row-delta as decimal   no-undo .
     2571       define variable v-col-delta as decimal   no-undo .
     2572       define variable v-new-row as decimal   no-undo .
     2573       define variable v-new-col as decimal   no-undo .
     2574       assign
     2575         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2576         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2577       .
     2578       assign
     2579         v-row-delta = v-new-row - frame Dialog-Frame :height
     2580         v-col-delta = v-new-col - frame Dialog-Frame :width
     2581       .
     2582       run diasize_change-height in this-procedure
     2583         (input v-row-delta
     2584         ,input true
     2585         ) .
     2586       run diasize_change-width in this-procedure
     2587         (input v-col-delta
     2588         ,input true
     2589         ) .
     2590     end.
     2591   end procedure.
     2592   procedure diasize_maximize :
     2593     define input  parameter p-action as logical   no-undo .
     2594     do
     2595     on error undo, return error return-value
     2596     :
     2597       if p-action = ?
     2598       then do:
     2599         if v-diasize-need-maximize = true
     2600         then do:
     2601           assign
     2602             p-action = true
     2603           .
     2604         end.
     2605         else do:
     2606           assign
     2607             p-action = false
     2608           .
     2609         end.
     2610       end.
     2611       if p-action = true
     2612       then do:
     2613         run diasize_change-height in this-procedure
     2614           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2615               - frame Dialog-Frame :height-chars
     2616           ,input true
     2617           ) .
     2618         run diasize_change-width in this-procedure
     2619           (input session :width-chars
     2620               - frame Dialog-Frame :width-chars
     2621           ,input true
     2622           ) .
     2623         assign
     2624           v-diasize-need-maximize = false
     2625         .
     2626       end.
     2627       else do:
     2628         run diasize_change-width in this-procedure
     2629           (input v-diasize-orig-frame-width
     2630               - frame Dialog-Frame :width-chars
     2631           ,input true
     2632           ) .
     2633         run diasize_change-height in this-procedure
     2634           (input v-diasize-orig-frame-height
     2635               - frame Dialog-Frame :height-chars
     2636           ,input true
     2637           ) .
     2638         assign
     2639           v-diasize-need-maximize = true
     2640         .
     2641       end.
     2642     end.
     2643   end procedure.
     2644   procedure diasize_restore-orig-size :
     2645     do
     2646     on error undo, return error return-value
     2647     :
     2648       assign
     2649         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2650         v-diasize-current-frame-height = frame Dialog-Frame :height
     2651       .
     2652       run diasize_set-height in this-procedure
     2653         (input  v-diasize-orig-frame-height
     2654         ,input  true
     2655         ) .
     2656       run diasize_set-width in this-procedure
     2657         (input  v-diasize-orig-frame-width
     2658         ,input  true
     2659         ) .
     2660     end.
     2661   end procedure.
     2662   procedure diasize_restore-current-size :
     2663     do
     2664     on error undo, return error return-value
     2665     :
     2666       run diasize_set-height in this-procedure
     2667         (input  v-diasize-current-frame-height
     2668         ,input  true
     2669         ) .
     2670       run diasize_set-width in this-procedure
     2671         (input  v-diasize-current-frame-width
     2672         ,input  true
     2673         ) .
     2674     end.
     2675   end procedure.
     2676   procedure diasize_set-browse-handle :
     2677     define input  parameter p-browse-handle as handle   no-undo .
     2678     define buffer buf_temp-browse-handle for temp-browse-handle .
     2679     do
     2680     on error undo, return error return-value
     2681     :
     2682       assign
     2683         v-diasize-browse-handle = p-browse-handle
     2684       .
     2685       for each buf_temp-browse-handle
     2686       on error undo, return error return-value
     2687       :
     2688         delete buf_temp-browse-handle .
     2689       end.
     2690     end.
     2691   end procedure.
     2692   procedure diasize_add_browse :
     2693     define input  parameter p-browse-type   as character no-undo .
     2694     define input  parameter p-browse-handle as handle    no-undo .
     2695     define buffer buf_temp-browse-handle for temp-browse-handle .
     2696     do
     2697     on error undo, return error return-value
     2698     :
     2699       assign
     2700         v-diasize-browse-number = v-diasize-browse-number + 1
     2701       .
     2702       create buf_temp-browse-handle .
     2703       assign
     2704         buf_temp-browse-handle.browse-type   = p-browse-type
     2705         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2706         buf_temp-browse-handle.browse-handle = p-browse-handle
     2707       .
     2708     end.
     2709   end procedure.
     2710   procedure diasize_init :
     2711     define variable v-default-value    as logical   no-undo .
     2712     define variable v-restore-saved    as logical   no-undo .
     2713     define variable v-resize-value-str as character no-undo .
     2714     do
     2715     on error undo, return error return-value
     2716     :
     2717       do with frame Dialog-Frame
     2718       :
     2719         assign
     2720           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2721           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2722           v-diasize-browse-handle     = browse br-nzl-hist :handle
     2723         .
     2724         create button v-diasize-resize-button
     2725         assign
     2726           parent        = frame Dialog-Frame :first-child
     2727           label         = "s"
     2728           height-pixels = 16
     2729           width-pixels  = 16
     2730           visible       = true
     2731           sensitive     = true
     2732           movable       = true
     2733           triggers:
     2734             on end-move persistent run diasize_end-move in this-procedure .
     2735           end triggers.
     2736         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2737         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2738         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2739         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2740         assign
     2741           v-diasize-wndmax = false
     2742         .
     2743         if connected("ub") = true
     2744         then do:
     2745           define variable v-cntxt-db-num        as integer   no-undo .
     2746           define variable v-cntxt-userid        as character no-undo .
     2747           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2748                                             , OUTPUT v-cntxt-userid
     2749                                             ) .
     2750           run gbl/wndpar_r.p
     2751             (input  v-cntxt-db-num
     2752             ,input  v-cntxt-userid
     2753             ,input  'wndmax':U
     2754             ,output v-diasize-wndmax
     2755             ,output v-default-value
     2756             ) .
     2757         end.
     2758         assign
     2759           v-diasize-wndstore = false
     2760         .
     2761         if connected("ub") = true
     2762         then do:
     2763           run gbl/wndpar_r.p
     2764             (input  v-cntxt-db-num
     2765             ,input  v-cntxt-userid
     2766             ,input  'wndstore':U
     2767             ,output v-diasize-wndstore
     2768             ,output v-default-value
     2769             ) .
     2770         end.
     2771         assign
     2772           v-diasize-proc-name = entry(1, program-name(2), '.')
     2773         .
     2774         if v-diasize-wndstore = true
     2775         then do:
     2776           assign
     2777             v-restore-saved = false
     2778           .
     2779           if connected("ub") = true
     2780           then do:
     2781             run gbl/wndsizer.p
     2782               (input  v-cntxt-db-num
     2783               ,input  v-cntxt-userid
     2784               ,input  v-diasize-proc-name
     2785               ,input  'height':u
     2786               ,output v-resize-value-str
     2787               ) .
     2788             if v-resize-value-str <> '':U
     2789             then do:
     2790               run diasize_change-height in this-procedure
     2791                 (input  integer(v-resize-value-str)
     2792                 ,input  true
     2793                 ) .
     2794               assign
     2795                 v-restore-saved = true
     2796               .
     2797             end.
     2798           end.
     2799           if connected("ub") = true
     2800           then do:
     2801             run gbl/wndsizer.p
     2802               (input  v-cntxt-db-num
     2803               ,input  v-cntxt-userid
     2804               ,input  v-diasize-proc-name
     2805               ,input  'width':u
     2806               ,output v-resize-value-str
     2807               ) .
     2808             if v-resize-value-str <> '':U
     2809             then do:
     2810               run diasize_change-width in this-procedure
     2811                 (input  integer(v-resize-value-str)
     2812                 ,input  true
     2813                 ) .
     2814               assign
     2815                 v-restore-saved = true
     2816               .
     2817             end.
     2818           end.
     2819           if v-restore-saved <> true
     2820           then do:
     2821             if v-diasize-wndmax = true
     2822             then do:
     2823               run diasize_maximize in this-procedure
     2824                 (input  true
     2825                 ) .
     2826             end.
     2827           end.
     2828         end.
     2829         else do:
     2830           if v-diasize-wndmax = true
     2831           then do:
     2832             run diasize_maximize in this-procedure
     2833               (input  true
     2834               ) .
     2835           end.
     2836         end.
     2837       end.
     2838     end.
     2839   end procedure.
     2840   procedure diasize_need-full-display :
     2841     define output parameter p-need-full-display as logical   no-undo .
     2842     do
     2843     on error undo, return error return-value
     2844     :
     2845       assign
     2846         p-need-full-display = v-diasize-need-full-display
     2847       .
     2848       assign
     2849         v-diasize-need-full-display = false
     2850       .
