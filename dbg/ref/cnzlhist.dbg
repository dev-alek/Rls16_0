     4628   PROCEDURE proc-b-print :
     4629   define variable date_string     as      char    no-undo.
     4630   define variable Line                as      char    no-undo.
     4631   define variable for-time as char.
     4632   define variable accum-count as integer.
     4633   define variable v-doc-rec as recid no-undo.
     4634   define variable v-prod as character no-undo .
     4635   define variable v-subject-chr as character no-undo .
     4636   define variable v-upd-time as character no-undo .
     4637   define variable v-obj as character no-undo .
     4638   define variable v-action-chr as character no-undo .
     4639   DEFINE VARIABLE v-for-user-name AS CHARACTEr NO-UNDO.
     4640   DEFINE FRAME HistoryList
     4641   X_c-nzl-hist.nozzle-code COLUMn-LABEL "№ пистолета"
     4642   v-action-chr FORMAT "X(10)" COLUMN-LABEL "Действие"
     4643   v-subject-chr COLUMN-LABEL "Предмет изменений" FORMAT "X(20)"
     4644   X_c-nzl-hist.corr-date
     4645   v-upd-time COLUMN-LABEL "Время изм." FORMAT "X(8)"
     4646   v-for-user-name COLUMN-LABEL "Изменил" FORMAT "X(18)"
     4647   X_c-nzl-hist.corr-user-db-num
     4648   v-obj COLUMN-LABEL "Объект" FORMAT "X(8)"
     4649   HEADER  date_string AT 5 format "X(35)"
     4650   string( "Страница " ) format "X(9)" AT 115 PAGE-NUMBER(PrnLibStream) AT 125 FORMAT ">>9" SKIP
     4651   Line format "X(195)" AT 1
     4652   with width 232 down stream-io use-text    .
     4653   Line = fill("-", 195).
     4654   date_string = cur-time-print() .
     4655   assign
     4656   v-doc-rec = recid( X_c-nzl-hist ).
     4657   DO WHILE available X_c-nzl-hist :
     4658         GET prev br-nzl-hist.
     4659   END.
     4660   run prn-lib-open-stream  in this-procedure (
     4661                                                input parparentProc
     4662                                               ,input 43
     4663                                               ,input yes
     4664                                               ,input no
     4665                                               ).
     4666   PUT  STREAM PrnLibStream
     4667   SPACE(25) ( frame Dialog-Frame:title )
     4668   format "x(90)" SKIP(1) .
     4669   FORM HEADER
     4670   Line format "X(180)" AT 1 SKIP
     4671   "Продолжение - на следующей странице" AT 30 SKIP
     4672   with FRAME BottomFrame width 232 PAGE-BOTTOM NO-LABELS NO-BOX .
     4673   VIEW  STREAM PrnLibStream FRAME BottomFrame .
     4674   FORM with FRAME HistoryList  .
     4675   run waitfram-show in this-procedure ("Ждите...").
     4676     GET next br-nzl-hist.
     4677       DO WHILE available X_c-nzl-hist :
     4678         Display STREAM PrnLibStream
     4679         X_c-nzl-hist.nozzle-code
     4680         get-action(X_c-nzl-hist.action) @ v-action-chr
     4681         get-subject(X_c-nzl-hist.subject) @ v-subject-chr
     4682         X_c-nzl-hist.corr-date
     4683         string(X_c-nzl-hist.corr-time, "HH:MM:SS":U) @ v-upd-time
     4684         usrfulnf(X_c-nzl-hist.corr-user-name) @ v-for-user-name
     4685         X_c-nzl-hist.corr-user-db-num
     4686         X_c-nzl-hist.obj-type + string(X_c-nzl-hist.obj-code) @ v-obj
     4687         with FRAME HistoryList .
     4688     DOWN STREAM PrnLibStream 1 with FRAME HistoryList  .
     4689     assign
     4690     accum-count = accum-count + 1
     4691     .
     4692     GET next br-nzl-hist.
     4693   END.
     4694   UNDERLINE  STREAM PrnLibStream
     4695   X_c-nzl-hist.nozzle-code
     4696   v-action-chr
     4697   v-subject-chr
     4698   X_c-nzl-hist.corr-date
     4699   v-upd-time
     4700   v-for-user-name
     4701   X_c-nzl-hist.corr-user-db-num
     4702   v-obj
     4703   with FRAME HistoryList .
     4704   DISPLAY STREAM PrnLibStream
     4705   "ИТОГО"  @ X_c-nzl-hist.nozzle-code
     4706   string(accum-count)  @ v-action-chr
     4707   with frame HistoryList.
     4708   HIDE  STREAM PrnLibStream FRAME BottomFrame .
     4709   HIDE  STREAM PrnLibStream FRAME CheckList.
     4710   output  STREAM PrnLibStream CLOSE.
     4711   run waitfram-hide in this-procedure.
     4712   run prn-lib-prn-file in this-procedure (
     4713                                             input parparentproc
     4714                                             ,input 8
     4715                                             ).
     4716   reposition br-nzl-hist to recid v-doc-rec no-error.
     4717   apply "entry" to br-nzl-hist in frame Dialog-Frame.
     4718   END PROCEDURE.
     4719   PROCEDURE proc-b-sch :
     4720   assign
     4721     tbl = 'c-nzl-hist'
     4722     join-tbl = 'X_c-nzl-hist'
     4723     fld = ""
     4724     lab = ""
     4725     spr = ""
     4726     dim = '0'
     4727     .
     4728   run fltfield-add in this-procedure('obj-type*obj-code', 'Объект', '',
     4729   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4730   run fltfield-add in this-procedure('nozzle-code', '№ пистолета', '',
     4731   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4732   run fltfield-add in this-procedure('corr-date', '', '',
     4733   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4734   run fltfield-add in this-procedure('corr-time', 'Время корр.', 'time',
     4735   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4736   run fltfield-add in this-procedure('corr-user-db-num', '', '',
     4737   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4738   run fltfield-add in this-procedure('corr-user-name', 'Изменил', 'usr',
     4739   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4740   run fltfield-add in this-procedure('subject', 'Предмет изменения', 'pmp-hist-subject',
     4741   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4742   run fltfield-add in this-procedure('action', 'Действие', 'hist-action',
     4743   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4744   Filter-Block:
     4745   DO ON STOP    UNDO Filter-Block, LEAVE Filter-Block
     4746       ON ERROR   UNDO Filter-Block, LEAVE Filter-Block
     4747       ON END-KEY UNDO Filter-Block, LEAVE Filter-Block :
     4748     run gbl/filter.w ( INPUT parparentproc
     4749                       ,INPUT (filter-point + chr(4) + filter-label + chr(4) + 'yes':U)
     4750                       ,INPUT tbl
     4751                       ,INPUT join-tbl
     4752                       ,INPUT fld
     4753                       ,INPUT lab
     4754                       ,INPUT spr
     4755                       ,INPUT dim ).
     4756     RUN OpenBr in this-procedure ( input yes, input no, input '':U).
     4757   END.
     4758   END PROCEDURE.
     4759   PROCEDURE proc-br-nzl-hist :
     4760   define variable vss-include-info38 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4761   if b-sel:sensitive in frame Dialog-Frame then dO:
     4762       if b-mark:sensitive then do:
     4763           apply "choose" to b-mark in frame Dialog-Frame.
     4764       end.
     4765       else do:
     4766           apply "choose" to b-sel in frame Dialog-Frame.
     4767       end.
     4768   end.
     4769   else do:
     4770       if b-lookup:sensitive then
     4771       apply "choose" to b-lookup in frame Dialog-Frame.
     4772   end.
     4773   END PROCEDURE.
     4774   PROCEDURE proc-find-corr-date :
     4775   define input parameter p-next as logical no-undo.
     4776   define input parameter p-date like ub.fin-doc.doc-date no-undo.
     4777   define variable v-date-chr as character no-undo.
     4778   if p-date = ? then return .
     4779   display
     4780   0 @ sch-nozzle-code
     4781   "":U @ sch-corr-user-name
     4782   with frame Dialog-Frame.
     4783   assign
     4784   v-date-chr = string(day(p-date)) + chr(47) +
     4785                    string(month(p-date)) + chr(47) +
     4786                    string(year(p-date)).
     4787          run OpenBr in this-procedure
     4788           (input false
     4789           ,input true
     4790           ,input substitute("and X_c-nzl-hist.corr-date = &1 "
     4791             , v-date-chr)
     4792           ).
     4793         apply "entry":u to sch-corr-date in frame Dialog-Frame.
     4794   END PROCEDURE.
     4795   PROCEDURE proc-find-nozzle-code :
     4796   define input parameter p-next as logical no-undo.
     4797   define input parameter p-nozzle-code like ub.c-nzl-hist.nozzle-code no-undo.
     4798   define variable v-nozzle-code as character no-undo.
     4799   assign
     4800   sch-corr-date = ?.
     4801   display
     4802   "":U @ sch-corr-user-name
     4803   sch-corr-date
     4804   with frame Dialog-Frame.
     4805   assign
     4806   v-nozzle-code = string(p-nozzle-code).
     4807   run OpenBr in this-procedure
     4808       (input false
     4809       ,input p-next
     4810       ,input substitute("and X_c-nzl-hist.nozzle-code = &1 "
     4811         , v-nozzle-code)
     4812       ).
     4813   apply "entry":u to sch-nozzle-code in frame Dialog-Frame .
     4814   END PROCEDURE.
     4815   PROCEDURE proc-find-user :
     4816   define input parameter p-next as logical no-undo.
     4817   define input parameter p-user like ub.c-nzl-hist.corr-user-name no-undo.
     4818   assign
     4819   sch-corr-date = ?.
     4820   display
     4821   sch-corr-date
     4822   0 @ sch-nozzle-code
     4823   with frame Dialog-Frame.
     4824   p-user = chr(34) + p-user + chr(34).
     4825   run OpenBr in this-procedure
     4826       (input false
     4827       ,input p-next
     4828       ,input substitute("and X_c-nzl-hist.corr-user-name = &1 "
     4829         , p-user)
     4830       ).
     4831   apply "entry":u to sch-corr-user-name in frame Dialog-Frame .
     4832   END PROCEDURE.
     4833   PROCEDURE proc-view-changes :
     4834   define variable v-description as character no-undo .
     4835   for each temp-changes:
     4836       delete temp-changes.
     4837   END.
     4838   if not available X_c-nzl-hist then do:
     4839     Open QUery br-changes for each temp-changes.
     4840     return.
     4841   end.
     4842   run ref/cnzlhisv.p (
     4843                      input X_c-nzl-hist.obj-type
     4844                     ,input X_c-nzl-hist.obj-code
     4845                     ,input X_c-nzl-hist.nozzle-code
     4846                     ,input X_c-nzl-hist.chip-num
     4847                     ,input X_c-nzl-hist.corr-user-db-num
     4848                     ,input X_c-nzl-hist.subject
     4849                     ,input X_c-nzl-hist.action
     4850                     ,input no
     4851                     ,output v-description
     4852                  ) no-error .
     4853   Open QUery br-changes for each temp-changes.
     4854   assign
     4855   br-changes:title in frame Dialog-Frame = v-description
     4856   .
     4857   END PROCEDURE.
     4858   FUNCTION get-action RETURNS CHARACTER
     4859     ( p-action as integer ) :
     4860     define variable dops as character no-undo.
     4861   assign dops = entry (lookup (trim(string(p-action)), '99,1,2,3,4,9,51,79':U), 'Удаление,Создание,Изменение,Коррекция,Восстановление,Смена_кода,Смена_артик,Выключ.':U) no-error.
     4862   RETURN dops.
     4863   END FUNCTION.
     4864   FUNCTION get-subject RETURNS CHARACTER
     4865     ( p-subject as character ) :
     4866     RETURN entry (lookup (p-subject, 'nozzle,pl-pump-nozzle,pump-nozzle,nozzle-attr':U), 'Пистолет,Резервуар/ТРК/Пистолет,ТРК/Пистолет,Атрибут Пистолета':U).
     4867   END FUNCTION.
