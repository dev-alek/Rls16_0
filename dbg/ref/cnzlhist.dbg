     3543           "Ошибка при фильтрации / сортировке" skip
     3544           "Будут показаны записи без учета фильтра" skip
     3545           view-as alert-box .
     3546       end.
     3547       else do:
     3548           assign
     3549             l-query-was-opened = true
     3550           .
     3551       end.
     3552     end.
