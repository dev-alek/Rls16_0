      628   procedure fltfield-clear :
      629     define output parameter loc-fld as character no-undo.
      630     define output parameter loc-lab as character no-undo .
      631     define output parameter loc-spr as character no-undo .
      632     define output parameter loc-dim as character no-undo .
      633     assign
      634       loc-fld = ""
      635       loc-lab = ""
      636       loc-spr = ""
      637       loc-dim = "0"
      638     .
      639   end procedure .
      640   procedure fltfield-add :
      641     define input        parameter par-fld as character no-undo.
      642     define input        parameter par-lab as character no-undo .
      643     define input        parameter par-spr as character no-undo .
      644     define input-output parameter loc-fld as character no-undo.
      645     define input-output parameter loc-lab as character no-undo .
      646     define input-output parameter loc-spr as character no-undo .
      647     define input-output parameter loc-dim as character no-undo .
      648     do
      649     on error undo, return error
      650     :
      651       assign
      652       loc-fld = if loc-dim = '0'
      653                 then par-fld
      654                 else (loc-fld + chr(44) + par-fld)
      655       loc-lab = if loc-dim = '0'
      656                 then par-lab
      657                 else (loc-lab + chr(44) + par-lab)
      658       loc-spr = if loc-dim = '0'
      659                 then par-spr
      660                 else (loc-spr + chr(44) + par-spr)
      661       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
      662                 string(integer(if num-entries(loc-dim) > 1
      663                               then entry(2, loc-dim)
      664                               else entry(1, loc-dim)
      665                               ) + 1)
      666       no-error
      667       .
      668     end.
      669   end procedure.
