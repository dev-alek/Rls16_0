     3230   MAIN-BLOCK:
     3231   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     3232      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     3233      if p-mode <> 'все':U
     3234    and p-mode <> "one":U
     3235    and p-mode <> 'объект':U
     3236    and p-mode <> "subject":U
     3237    then dO:
     3238       message
     3239       vss-workfile vss-revision vss-description skip
     3240       "Неверное значение параметров вызова p-mode"
     3241       p-mode
     3242       view-as alert-box ERROR.
     3243       return.
     3244    end.
     3245    if p-mode = 'объект':U
     3246    or p-mode = "subject":U
     3247    then do:
     3248     find first X_clients no-lock where
     3249                   X_clients.obj-type = p-obj-type
     3250               and X_clients.obj-code = p-obj-code no-error.
     3251       if not available X_clients then do:
     3252           message
     3253           vss-workfile vss-revision vss-description skip
     3254           "Неверное значение параметра вызова p-obj-type/p-obj-code"
     3255           p-obj-type p-obj-code
     3256           view-as alert-box ERROR.
     3257           return.
     3258       end.
     3259   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3260   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     3261     (input  p-obj-type
     3262     ,input  p-obj-code
     3263     ,output v-host-code
     3264     )  .
     3265    end.
     3266    v-rid-list = p-rid-list.
     3267     if v-rid-list <> "" then do:
     3268         FIND FIRST find_c-nzl-hist No-LOCK where
     3269                    recid(find_c-nzl-hist) = integer(entry(1, v-rid-list)) No-ERROR.
     3270         if not avail find_c-nzl-hist then do:
     3271           message
     3272           vss-workfile vss-revision vss-description skip
     3273           "Неверное значение параметра вызова v-rid-list" v-rid-list
     3274           view-as alert-box error .
     3275           return error.
     3276         end.
     3277         v-doc-rec = integer(entry(1, v-rid-list)).
     3278       end.
     3279   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3280   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
     3281     (output v-db-num
     3282     )  .
     3283     if p-mode <> 'все':U then do:
     3284       assign
     3285       v-find = yes.
     3286     end.
     3287     RUN MyEnable.
     3288     RUn OpenBR in this-procedure ( input yes, input no, input '':U).
     3289     HIDE mark-num in frame Dialog-Frame .
     3290     if v-rid-list <> "":U then
     3291     REPOSITION br-nzl-hist to recid integer(entry(1, v-rid-list)) No-ERROR.
     3292   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3293   DEF VAR cur-clmn-numbr-nzl-hist as INT EXTENT 9 no-undo.
     3294   DEF VAR varmvibr-nzl-hist       as INT no-undo.
     3295   DEF VAR varmvjbr-nzl-hist       as INT no-undo.
     3296   DEF VAR varmvkbr-nzl-hist       as INT no-undo.
     3297   DEF VAR varmvlbr-nzl-hist       as INT no-undo.
     3298   DEF VAR move-elementbr-nzl-hist as INT no-undo.
     3299   def var jjbr-nzl-hist           as int no-undo.
     3300   do varmvibr-nzl-hist = 1 to EXTENT(cur-clmn-numbr-nzl-hist):
     3301     ASSIGN cur-clmn-numbr-nzl-hist[varmvibr-nzl-hist] = varmvibr-nzl-hist.
     3302   END.
     3303   RUN start-mv-clmnbr-nzl-hist.
     3304   PROCEDURE start-mv-clmnbr-nzl-hist:
     3305   def var old-session as logical no-undo.
     3306      old-session = SESSION:IMMEDIATE-DISPLAY.
     3307      IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     3308          IF  p-mode = 'все':U  THEN DO:
     3309      DO jjbr-nzl-hist = NUM-ENTRIES('9,1,2,3,4,5,6,7,8') TO 1 BY -1:
     3310        RUN re-move-clmnbr-nzl-hist ( cur-clmn-numbr-nzl-hist[INTEGER(ENTRY (jjbr-nzl-hist, '9,1,2,3,4,5,6,7,8'))] , 1).
     3311      END.
     3312          END.
     3313          IF  p-mode <> 'все':U  THEN DO:
     3314      DO jjbr-nzl-hist = NUM-ENTRIES('1,2,3,4,5,6,7,8,9') TO 1 BY -1:
     3315        RUN re-move-clmnbr-nzl-hist ( cur-clmn-numbr-nzl-hist[INTEGER(ENTRY (jjbr-nzl-hist, '1,2,3,4,5,6,7,8,9'))] , 1).
     3316      END.
     3317          END.
     3318      SESSION:IMMEDIATE-DISPLAY = old-session.
     3319   END.
     3320   ON ctrl-cursor-right OF BROWSE br-nzl-hist do:
     3321     RUN re-move-clmnbr-nzl-hist ( 1, 9).
     3322   END.
     3323   ON ctrl-cursor-left OF BROWSE br-nzl-hist do:
     3324     RUN re-move-clmnbr-nzl-hist (9, 1).
     3325   END.
     3326   PROCEDURE re-move-clmnbr-nzl-hist:
     3327     DEFINE INPUT PARAMETER source-column as INTEGER NO-UNDO.
     3328     DEFINE INPUT PARAMETER target-column as INTEGER NO-UNDO.
     3329     DO varmvibr-nzl-hist = 1 TO EXTENT(cur-clmn-numbr-nzl-hist):
     3330       if cur-clmn-numbr-nzl-hist[varmvibr-nzl-hist] = source-column THEN cur-clmn-numbr-nzl-hist[varmvibr-nzl-hist] = -1.
     3331     END.
     3332     if br-nzl-hist:MOVE-COLUMN(source-column, target-column) IN FRAME Dialog-Frame then.
     3333     if source-column > target-column THEN
     3334     DO varmvjbr-nzl-hist = source-column - 1 to target-column BY -1:
     3335       DO varmvibr-nzl-hist = 1 TO EXTENT(cur-clmn-numbr-nzl-hist):
     3336           if cur-clmn-numbr-nzl-hist[varmvibr-nzl-hist] = varmvjbr-nzl-hist THEN DO:
     3337             cur-clmn-numbr-nzl-hist[varmvibr-nzl-hist] = cur-clmn-numbr-nzl-hist[varmvibr-nzl-hist] + 1.
     3338           END.
     3339       END.
     3340     END.
     3341     ELSE
     3342     DO varmvjbr-nzl-hist = source-column + 1 to target-column:
     3343       DO varmvibr-nzl-hist = 1 TO EXTENT(cur-clmn-numbr-nzl-hist):
     3344         if cur-clmn-numbr-nzl-hist[varmvibr-nzl-hist] = varmvjbr-nzl-hist THEN DO:
     3345           cur-clmn-numbr-nzl-hist[varmvibr-nzl-hist] = cur-clmn-numbr-nzl-hist[varmvibr-nzl-hist] - 1.
     3346         END.
     3347       END.
     3348     END.
     3349     DO varmvibr-nzl-hist = 1 TO EXTENT(cur-clmn-numbr-nzl-hist):
     3350       if cur-clmn-numbr-nzl-hist[varmvibr-nzl-hist] = -1 THEN cur-clmn-numbr-nzl-hist[varmvibr-nzl-hist] = target-column.
     3351     END.
     3352   END PROCEDURE.
     3353   PROCEDURE ch-clmnbr-nzl-hist:
     3354     DEFINE INPUT PARAMETER cur-clmn-loc as INTEGER NO-UNDO.
     3355     if cur-clmn-loc <= 1 then do:
     3356       return .
     3357     end.
     3358     DO varmvibr-nzl-hist = 1 TO EXTENT(cur-clmn-numbr-nzl-hist):
     3359       if cur-clmn-numbr-nzl-hist[varmvibr-nzl-hist] = cur-clmn-loc THEN move-elementbr-nzl-hist = varmvibr-nzl-hist.
     3360     END.
     3361     RUN re-move-clmnbr-nzl-hist (cur-clmn-loc, 1).
     3362   END PROCEDURE.
     3363   PROCEDURE mv-brw-defaultbr-nzl-hist:
     3364   def var old-session as logical no-undo.
     3365     old-session = SESSION:IMMEDIATE-DISPLAY.
     3366     IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     3367     do varmvlbr-nzl-hist = 1 to EXTENT(cur-clmn-numbr-nzl-hist):
     3368       RUN re-move-clmnbr-nzl-hist (cur-clmn-numbr-nzl-hist[varmvlbr-nzl-hist], varmvlbr-nzl-hist).
     3369     END.
     3370     RUN start-mv-clmnbr-nzl-hist.
     3371     SESSION:IMMEDIATE-DISPLAY = old-session.
     3372   END PROCEDURE.
     3373   .
     3374     run diasize_add_browse in this-procedure
     3375       (input  'width':u
     3376       ,input  browse br-changes :handle
     3377       ) .
     3378     run diasize_init in this-procedure .
     3379     WAIT-FOR GO OF FRAME Dialog-Frame.
     3380   END.
     3381   RUN disable_UI.
     3382   PROCEDURE disable_UI :
     3383     HIDE FRAME Dialog-Frame.
     3384   END PROCEDURE.
     3385   PROCEDURE enable_UI :
     3386     DISPLAY sch-corr-date sch-nozzle-code sch-corr-user-name mark-num
     3387         WITH FRAME Dialog-Frame.
     3388     ENABLE b-quit B-mark b-sel B-print B-sch B-Help B-lookup br-nzl-hist
     3389            sch-corr-date sch-nozzle-code sch-corr-user-name BR-changes mark-num
     3390         WITH FRAME Dialog-Frame.
     3391     VIEW FRAME Dialog-Frame.
     3392   END PROCEDURE.
     3393   PROCEDURE MyEnable :
     3394   assign
     3395     br-nzl-hist:num-locked-columns in frame Dialog-Frame = 1
     3396     X_c-nzl-hist.corr-date:read-only in browse br-nzl-hist = yes
     3397     br-changes:title = "":U
     3398     temp-changes.l_name:resizable in browse br-changes = true
     3399     temp-changes.v_old:resizable in browse br-changes = true
     3400     temp-changes.v_new:resizable in browse br-changes = true
     3401     temp-changes.l_name:width in browse br-changes = 30
     3402     temp-changes.v_old:width in browse br-changes = 40
     3403     temp-changes.v_new:width in browse br-changes = 40
     3404     .
     3405     VIEW frame Dialog-Frame .
     3406     DISPLAY
     3407     sch-corr-date
     3408     sch-nozzle-code
     3409     sch-corr-user-name
     3410     mark-num
     3411     WITH FRAME Dialog-Frame .
     3412     ENABLE
     3413     b-quit
     3414     B-mark when lookup("b-mark":U, bttns) > 0
     3415     b-sel when lookup("b-sel":U, bttns) > 0
     3416     B-lookup
     3417     B-sch
     3418     B-Print
     3419     B-Help
     3420     br-nzl-hist
     3421     sch-corr-date
     3422     sch-nozzle-code when p-mode = 'все':U
     3423     sch-corr-user-name
     3424     BR-changes mark-num
     3425     WITH FRAME Dialog-Frame .
     3426     VIEW FRAME Dialog-Frame .
     3427     hide b-lookup sch-corr-user-name
     3428     in frame Dialog-Frame .
     3429   END PROCEDURE.
     3430   PROCEDURE OpenBr :
     3431   define input  parameter p-open-query     as logical   no-undo .
     3432   define input  parameter p-find-next      as logical   no-undo .
     3433   define input  parameter p-find-condition as character no-undo .
     3434   define variable l-query-was-opened as logical no-undo .
     3435   define variable v-title as character no-undo .
     3436   define variable title0 as character no-undo.
     3437   title0 = "История пистолета" + chr(32).
     3438   run waitfram-show in this-procedure ("Ждите...").
     3439   define variable sort-column-phrase as character no-undo .
     3440   case sort-column-name :
     3441     when "" then do:
     3442       assign
     3443         sort-column-phrase = ""
     3444       .
     3445     end.
     3446     otherwise do:
     3447       assign
     3448         sort-column-phrase = "by " + sort-column-name
