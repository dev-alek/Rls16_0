      717   procedure prn-lib-open-stream :
      718     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      719     define input parameter p-page-size    as integer no-undo .
      720     define input parameter p-is-stream    as logical no-undo .
      721     define input parameter p-append       as logical no-undo .
      722     define variable v-report-name as character no-undo .
      723     do
      724       on error undo, return error
      725       :
      726       run prn-lib-get-report-name  in this-procedure (
      727         input parParentProc
      728         ,output v-report-name
      729         ).
      730       if p-is-stream then
      731       do:
      732         if p-append then
      733         do:
      734           output stream PrnLibStream to value( v-report-name )
      735             page-size value(p-page-size) append .
      736         end.
      737         if not p-append then
      738         do:
      739           output stream PrnLibStream to value( v-report-name )
      740             page-size value(p-page-size) .
      741         end.
      742       end.
      743       if not p-is-stream then
      744       do:
      745         if p-append then
      746         do:
      747           output to value( v-report-name )
      748             page-size value(p-page-size) append .
      749         end.
      750         if not p-append then
      751         do:
      752           output to value( v-report-name )
      753             page-size value(p-page-size) .
      754         end.
      755       end.
      756     end.
      757   end procedure.
      758   procedure prn-lib-open-exp :
      759     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      760     define input parameter p-is-stream    as logical no-undo .
      761     define input parameter p-is-append    as logical no-undo .
      762     define output parameter p-ReportFileName as char init "report" no-undo.
      763     define output parameter p-process as logical no-undo .
      764     define variable glog as logical no-undo .
      765     do
      766       on error undo, return error
      767       :
      768       SYSTEM-DIALOG GET-FILE p-ReportFileName
      769         TITLE      "Укажите путь"
      770         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      771         ASK-OVERWRITE
      772         CREATE-TEST-FILE
      773         SAVE-AS
      774         USE-FILENAME
      775         DEFAULT-EXTENSION "txt"
      776         UPDATE glog
      777         .
      778       if not glog then  return.
      779       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      780       if p-is-stream then
      781       do:
      782         if p-is-append then
      783         do:
      784           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      785         end.
      786         else
      787         do:
      788           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      789         end.
      790       end.
      791       else
      792       do:
      793         if p-is-append then
      794         do:
      795           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      796         end.
      797         else
      798         do:
      799           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      800         end.
      801       end.
      802       p-process = yes.
      803     end.
      804   end procedure.
