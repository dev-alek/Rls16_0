     2853   procedure get-context :
     2854      define output parameter p-db-num as integer          no-undo.
     2855      define output parameter p-user-id as character        no-undo.
     2856      define variable v-login               as character    no-undo.
     2857      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2858      define buffer buf_user-login  for ub.user-login .
     2859      do
     2860      on error undo, return error
     2861      :
     2862            FIND FIRST buf_sys-ctrl no-lock.
     2863            ASSIGN
     2864               v-login = USERID("ub")
     2865               p-db-num = buf_sys-ctrl.db-num
     2866            .
     2867            FIND FIRST buf_user-login
     2868                 WHERE buf_user-login.db-num = p-db-num
     2869                   AND buf_user-login.user-login = v-login
     2870                 no-lock
     2871                 no-error
     2872                 .
     2873            IF AVAILABLE buf_user-login
     2874            THEN DO:
     2875               assign
     2876                  p-user-id = buf_user-login.user-id
     2877               .
     2878            END.
     2879      end.
     2880   end procedure.
