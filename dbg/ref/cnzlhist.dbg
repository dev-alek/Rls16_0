     3452   define variable l-open-query as logical   no-undo .
     3453   CASE p-mode :
     3454     WHEN 'все':U        THEN DO:
     3455     filter-point = filter-point0 + p-mode.
     3456     filter-label = substitute("&1", filter-label0).
     3457   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3458   define variable  l-disable-where-27  as logical   no-undo .
     3459   define variable  l-filter-open-27    as logical   .
