     3130   def var sort-labelbr-nzl-hist   as character no-undo .
     3131   def var sort-clmnbr-nzl-hist    as handle    no-undo .
     3132   def var cur-clmnbr-nzl-hist     as handle    no-undo .
     3133   def var cur-clmn-locbr-nzl-hist as integer   no-undo .
     3134   def var re-querybr-nzl-hist     as logical   initial no no-undo .
     3135   on start-search, ctrl-o of br-nzl-hist in frame Dialog-Frame do:
     3136      run sort-brbr-nzl-hist
     3137        (input (if available X_c-nzl-hist
     3138                then recid(X_c-nzl-hist)
     3139                else ?
     3140               )
     3141        ).
     3142   end.
     3143   PROCEDURE sort-brbr-nzl-hist :
     3144     define input parameter p-recid as recid no-undo .
     3145     if re-querybr-nzl-hist = no then do:
     3146       assign
     3147          cur-clmnbr-nzl-hist = br-nzl-hist:current-column in frame Dialog-Frame
     3148       .
     3149       if sort-clmnbr-nzl-hist <> ? then sort-clmnbr-nzl-hist:column-fgcolor = 0.
     3150       if cur-clmnbr-nzl-hist = sort-clmnbr-nzl-hist then do:
     3151         assign
     3152            sort-labelbr-nzl-hist = ""
     3153            sort-clmnbr-nzl-hist = ?
     3154         .
     3155        end.
     3156        else do:
     3157          assign
     3158            sort-labelbr-nzl-hist = cur-clmnbr-nzl-hist:label
     3159            sort-clmnbr-nzl-hist  = cur-clmnbr-nzl-hist
     3160            sort-clmnbr-nzl-hist:column-fgcolor = 4
     3161          .
     3162        end.
     3163      end.
     3164     assign
     3165       cur-clmn-locbr-nzl-hist = 1
     3166     .
     3167     def var column-handle as handle no-undo .
     3168     column-handle = br-nzl-hist:first-column.
     3169     do while valid-handle(column-handle) :
     3170       if column-handle = cur-clmnbr-nzl-hist then do:
     3171         leave .
     3172       end.
     3173       column-handle = column-handle:NEXT-COLUMN.
     3174       assign
     3175         cur-clmn-locbr-nzl-hist = cur-clmn-locbr-nzl-hist + 1
     3176       .
     3177     end.
     3178     case sort-labelbr-nzl-hist:
     3179           when X_c-nzl-hist.nozzle-code:label in browse br-nzl-hist then DO:    assign       sort-column-name = "X_c-nzl-hist.nozzle-code"     .     run OpenBr in this-procedure ( input yes, input no, input '':U).   . END.
     3180           when X_c-nzl-hist.corr-date:label in browse br-nzl-hist then DO:    assign       sort-column-name = "X_c-nzl-hist.corr-date"     .     run OpenBr in this-procedure ( input yes, input no, input '':U).   . END.
     3181           when X_c-nzl-hist.corr-user-db-num:label in browse br-nzl-hist then DO:    assign       sort-column-name = "X_c-nzl-hist.corr-user-db-num"     .     run OpenBr in this-procedure ( input yes, input no, input '':U).   . END.
     3182       otherwise do:
     3183         assign
     3184           sort-column-name = ""
     3185         .
     3186         run OpenBr in this-procedure ( input yes, input no, input '':U).
     3187           if can-do( this-procedure:internal-entries, 'mv-brw-defaultbr-nzl-hist') then do:
     3188             run mv-brw-defaultbr-nzl-hist.
     3189           end.
     3190         if sort-labelbr-nzl-hist <> "" then do:
     3191           assign
     3192             cur-clmnbr-nzl-hist:column-fgcolor = 0
     3193           .
     3194         end.
     3195         assign
     3196           cur-clmn-locbr-nzl-hist = ?
     3197         .
     3198       end.
     3199     end case.
     3200       if cur-clmn-locbr-nzl-hist <> ? then do:
     3201         if can-do( this-procedure:internal-entries, 'ch-clmnbr-nzl-hist') then do:
     3202           run ch-clmnbr-nzl-hist in this-procedure (cur-clmn-locbr-nzl-hist).
     3203         end.
     3204       end.
     3205     if p-recid <> ? then do:
     3206       reposition br-nzl-hist to recid p-recid no-error.
     3207       apply "value-changed" to br-nzl-hist in frame Dialog-Frame.
     3208     end.
     3209     apply "entry" to br-nzl-hist in frame Dialog-Frame.
     3210   END PROCEDURE.
     3211   procedure re-open-query-srt-clmnbr-nzl-hist:
     3212   if cur-clmnbr-nzl-hist = ? then do:
     3213      run OpenBr in this-procedure ( input yes, input no, input '':U).
     3214   end.
     3215   else do:
     3216      assign re-querybr-nzl-hist = yes.
     3217      run sort-brbr-nzl-hist
     3218        (input (if available X_c-nzl-hist
     3219                then recid(X_c-nzl-hist)
     3220                else ?
     3221               )
     3222        ).
     3223      assign re-querybr-nzl-hist = no.
     3224   end.
     3225   end.
     3226   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3227   do:
