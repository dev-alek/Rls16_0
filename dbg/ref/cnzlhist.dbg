     3474     ,output sort-phrase-27
     3475     ,output where-phrase-rus-27
     3476     ,output sort-phrase-rus-27
     3477     ).
     3478   if p-open-query then do:
     3479       run set-filter-name in this-procedure
     3480         (INPUT filter-name-27
     3481         ) no-error .
     3482     assign
     3483       l-filter-open-27 = false
     3484     .
     3485     if flt-rec-27 <> ?
     3486       or sort-column-phrase > ""
     3487     then do:
     3488       define variable  parameter-2-27 as character no-undo .
     3489       define variable  parameter-3-27 as character no-undo .
     3490       define variable  parameter-4-27 as character no-undo .
     3491       define variable  parameter-5-27 as character no-undo .
     3492       define variable  parameter-6-27 as character no-undo .
     3493       define variable  parameter-7-27 as character no-undo .
