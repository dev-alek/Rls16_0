     3592           v-fltopend-rowid[1] = ?
     3593         .
     3594       end.
     3595       else do:
     3596         assign
     3597         parameter-2-27 = (if p-find-next then "true":u else "false":u )
     3598         parameter-3-27 =  "FOR EACH X_c-nzl-hist"
     3599         parameter-4-27 =
     3600           (
     3601             if (" TRUE " + " " + where-phrase-27) <> ""
     3602             then " TRUE " + " " + where-phrase-27
     3603             else "true"
     3604           )
     3605         parameter-5-27 = (" " + "" + " " + "" + " " + p-find-condition)
     3606         parameter-6-27 = if sort-phrase-27 = ''
