     3630                             ,input parameter-6-27
     3631                             ,input parameter-7-27
     3632                             ,output v-fltopend-rowid
     3633                             ) no-error.
     3634         .
     3635         v-doc-rec = ?.
     3636       end.
     3637       assign
     3638         l-query-was-opened = true
     3639       .
     3640     end.
     3641   end.
     3642     run waitfram-hide in this-procedure .
     3643     END.
     3644     WHEN 'объект':U THEN DO:
