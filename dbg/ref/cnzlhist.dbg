     3573         assign
     3574         parameter-2-27 = (if p-find-next then "true":u else "false":u )
     3575         parameter-4-27 =
     3576           "where ":u + " TRUE " + " ":u + where-phrase-27 + " ":u + p-find-condition + " " + ""
     3577         parameter-5-27 = " use-index idate  "
     3578       .
     3579         run fltopend_fltfindd in this-procedure  (
     3580                             input this-procedure:handle
     3581                             ,input query br-nzl-hist:handle
     3582                             ,input rowid(X_c-nzl-hist)
     3583                             ,input logical(parameter-2-27)
