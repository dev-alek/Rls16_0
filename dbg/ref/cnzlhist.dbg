      874   define variable v-fltopend-rowid as rowid extent 18 no-undo .
      875   procedure fltopend_fltopend :
      876   define input parameter p-parent-handle as handle no-undo .
      877   define input parameter p-qh as handle no-undo .
      878   define input parameter p-flt-open-open-query  as character no-undo .
      879   define input parameter p-where-cond as character no-undo .
      880   define input parameter p-use-indFIRST-query-tail as character no-undo .
      881   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      882   define input parameter p-indexed-reposition as character no-undo .
      883     do
      884     on error undo, return error
      885     :
      886   define variable v-prepare-string as character no-undo .
      887   define variable glog as logical no-undo .
      888   assign
      889   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      890                      p-where-cond + chr(32)  +
      891                      p-use-indFIRST-query-tail + chr(32) +
      892                      p-use-ind-sort-clmn-by + chr(32) +
      893                      p-indexed-reposition
      894   .
      895   assign
      896   glog = p-qh:query-prepare(v-prepare-string) no-error .
      897   if not glog
      898   or error-status:error then do:
      899     message error-status:get-message(1) view-as alert-box .
      900     undo, return error .
      901   end.
      902   assign
      903   glog = p-qh:query-open no-error .
      904   if not glog
      905   or error-status:error then do:
      906     message error-status:get-message(1) view-as alert-box .
      907     undo, return error .
      908   end.
      909     end.
      910   end procedure.
      911   procedure fltopend_fltfindd :
      912   define input parameter p-parent-handle as handle no-undo .
      913   define input parameter p-qh as handle no-undo .
      914   define input parameter p-rowid as rowid no-undo .
      915   define input parameter p-next as logical no-undo .
      916   define input parameter p-lock as integer no-undo .
      917   define input parameter p-bh as handle no-undo .
      918   define input parameter p-where-cond as character no-undo .
      919   define input parameter p-use-index-phrase as character no-undo .
      920   define variable glog as logical no-undo .
      921   define variable v-qh as handle no-undo .
      922   define variable v-bh as handle no-undo .
      923   define variable v-recid as recid no-undo .
      924   define variable v-prepare-string as character no-undo .
      925   do
      926   on error undo, return error
      927   on stop undo, return error
      928   :
      929     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
      930     create buffer v-bh for table p-bh buffer-name p-bh:name.
      931     create query v-qh.
      932     v-qh:set-buffers(v-bh).
      933     v-prepare-string = substitute("for each &1 &2 &3"
      934                                     ,v-bh:name
      935                                     ,p-where-cond
      936                                     ,p-use-index-phrase).
      937     glog = v-qh:query-prepare(v-prepare-string) no-error.
      938     if not glog then do:
      939       delete object v-qh.
      940       delete object v-bh.
      941       undo, return error .
      942     end.
      943     glog = v-qh:query-open no-error .
      944     if not glog then do:
      945       delete object v-qh.
      946       delete object v-bh.
      947       undo, return error .
      948     end.
      949     if p-next then do:
      950       v-qh:reposition-to-rowid(p-rowid) no-error .
      951       glog = v-qh:get-next( p-lock) no-error .
      952       glog = v-qh:get-next( p-lock) no-error .
      953       if not glog or v-qh:query-off-end = yes then do:
      954         glog = v-qh:get-first( p-lock) no-error .
      955       end.
      956     end.
      957     else do:
      958       glog = v-qh:get-first( p-lock) no-error .
      959     end.
      960     v-recid = v-bh:recid no-error .
      961     delete object v-qh.
      962     delete object v-bh.
      963     return string(v-recid) .
      964   end.
      965   end procedure.
      966   procedure fltopend_fltfindq :
      967   define input parameter p-parent-handle as handle no-undo .
      968   define input parameter p-qh as handle no-undo .
      969   define input parameter p-next as logical no-undo .
      970   define input parameter p-lock as integer no-undo .
      971   define input parameter p-flt-open-open-query  as character no-undo .
      972   define input parameter p-where-cond as character no-undo .
      973   define input parameter p-use-indFIRST-query-tail as character no-undo .
      974   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      975   define input parameter p-indexed-reposition as character no-undo .
      976   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
      977   define variable glog as logical no-undo .
      978   define variable v-qh as handle no-undo .
      979   define variable v-bh as handle no-undo extent 18.
      980   define variable v-rowid as rowid no-undo extent 18.
      981   define variable v-ii as integer no-undo .
      982   define variable v-prepare-string as character no-undo .
      983   do
      984   on error undo, return error
      985   on stop undo, return error
      986   :
      987     create query v-qh.
      988     do v-ii = 1 to p-qh:num-buffers:
      989       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
      990       assign
      991       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
      992       no-error.
      993       v-qh:add-buffer(v-bh[v-ii]).
      994     end.
      995     assign
      996     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      997                       p-where-cond + chr(32)  +
      998                       p-use-indFIRST-query-tail + chr(32) +
      999                       p-use-ind-sort-clmn-by + chr(32) +
     1000                       p-indexed-reposition
     1001     .
     1002     glog = v-qh:query-prepare( v-prepare-string) no-error .
     1003     if not glog then do:
     1004       delete object v-qh.
     1005       do v-ii = 1 to p-qh:num-buffers:
     1006         delete object v-bh[v-ii].
     1007       end.
     1008       undo, return error .
     1009     end.
     1010     glog = v-qh:query-open no-error .
     1011     if not glog then do:
     1012       delete object v-qh.
     1013       do v-ii = 1 to p-qh:num-buffers:
     1014         delete object v-bh[v-ii].
     1015       end.
     1016       undo, return error .
     1017     end.
     1018     if p-next then do:
     1019       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
     1020       glog = v-qh:get-next( p-lock) no-error .
     1021       glog = v-qh:get-next( p-lock) no-error .
     1022       if not glog or v-qh:query-off-end = yes then do:
     1023         glog = v-qh:get-first( p-lock) no-error .
     1024       end.
     1025     end.
     1026     else do:
     1027       glog = v-qh:get-first( p-lock) no-error .
     1028     end.
     1029     do v-ii = 1 to p-qh:num-buffers:
     1030       assign
     1031       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
     1032       no-error.
     1033     end.
     1034     delete object v-qh.
     1035     do v-ii = 1 to p-qh:num-buffers:
     1036       delete object v-bh[v-ii].
     1037     end.
     1038   end.
     1039   end procedure.
