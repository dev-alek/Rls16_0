     3498           (
     3499             if (" TRUE " + " " + where-phrase-27) <> ""
     3500             then " TRUE " + " " + where-phrase-27
     3501             else "true"
     3502           )
     3503         parameter-5-27 = (" " + "" + " " + "")
     3504         parameter-6-27 = if sort-phrase-27 = ''
     3505                              then
     3506           (
     3507           " " + " use-index idate  " +
     3508             " " + sort-column-phrase +
     3509           " " + "  "
     3510           )
     3511                              else
     3512           (
     3513           " " + " use-index idate  " +
     3514             " " + sort-column-phrase +
     3515           " " + sort-phrase-27
     3516           )
     3517         parameter-7-27 =
     3518           " indexed-reposition  "
     3519       .
     3520       do
     3521       on stop undo, leave
