        1   define input parameter parparentproc as widget-handle no-undo .
        2   define input-output parameter p-line-rec as recid no-undo .
        3   define variable vss-revision    as character no-undo init "$Revision$":u .
        4   define variable vss-author      as character no-undo init "$Author$":u .
        5   define variable vss-date        as character no-undo init "$Date$":u .
        6   define variable vss-workfile    as character no-undo init "$Workfile$":u .
        7   define variable vss-archive     as character no-undo init "$Archive$":u .
        8   define variable vss-description as character no-undo init "Разбиение партий" .
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   define new global shared variable g#library  as handle no-undo .
       68   define new global shared variable g#library2 as handle no-undo .
       69   procedure proc-alt-shift-f2:
       70     if not ibs.th.gbl.gbl-var:rcode
       71   then
       72     run gbl\inidebug.p .
       73   end.
       74   procedure proc-alt-shift-f3:
       75     run gbl/prvssinf.p
       76       ( input this-procedure
       77       ) .
       78   end.
       79   define variable v-inform-launched as logical no-undo initial false .
       80   procedure proc-alt-shift-f4:
       81     define variable v-action as character no-undo .
       82     if v-inform-launched = false then do:
       83       assign
       84         v-inform-launched = true
       85       .
       86       run gbl/d-inform.w
       87         (  input self
       88         ,  input this-procedure
       89         , output v-action
       90         ) no-error .
       91       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       92       assign
       93         v-inform-launched = false
       94       .
       95     end.
       96   end.
       97   procedure proc-alt-f1:
       98     run gbl/corrhelp.p
       99       (input this-procedure
      100       ) .
      101   end .
      102   on alt-shift-f2 anywhere do:
      103     run proc-alt-shift-f2.
      104   end.
      105   on alt-shift-f3 anywhere do:
      106     run proc-alt-shift-f3 in this-procedure .
      107   end.
      108   on alt-shift-f4 anywhere do:
      109     run proc-alt-shift-f4 in this-procedure.
      110   end.
      111   on alt-f1 anywhere do:
      112     run proc-alt-f1 in this-procedure .
      113   end.
      114   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      115     define variable v-cntxt-db-num        as integer   no-undo .
      116     define variable v-cntxt-userid        as character no-undo .
      117     define variable v-cntxt-level         as character no-undo .
      118     define variable v-cntxt-host-code-obj as integer   no-undo .
      119     define variable v-cntxt-obj-type      as character no-undo .
      120     define variable v-cntxt-obj-code      as integer   no-undo .
      121     define variable v-cntxt-db-num-obj    as integer   no-undo .
      122     define variable v-cntxt-is-admin      as logical   no-undo .
      123   DEFINE TEMP-TABLE qnty-table NO-UNDO
      124   FIELD nn as integer
      125   FIELD qnty like ub.parts.qnty FORMAT ">>,>>>,>>9.999"
      126   INDEX PI IS UNIQUE PRIMARY nn
      127   .
      128   def buffer b-qnty-table for qnty-table.
      129   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      130   define temp-table temp-parts-qnty no-undo
      131     field qnty      like ub.parts.qnty
      132     field fact-qnty like ub.parts.fact-qnty
      133     field cli-qnty  like ub.parts.cli-qnty
      134     field pl-code   like ub.parts.pl-code
      135     field parts-part-code like ub.parts.part-code
      136     field parts-recid as recid
      137   .
      138   DEFINE BUTTON B-doc
      139        LABEL "П&Н"
      140        SIZE 10 BY 1.
      141   DEFINE BUTTON B-exit AUTO-END-KEY
      142        LABEL "&Выход"
      143        SIZE 10 BY 1
      144        BGCOLOR 8 .
      145   DEFINE BUTTON B-good
      146        LABEL "&Товар"
      147        SIZE 10 BY 1.
      148   DEFINE BUTTON B-Help
      149        LABEL "Помо&щь"
      150        SIZE 3 BY 1
      151        BGCOLOR 8 .
      152   DEFINE BUTTON B-part
      153        LABEL "&Партия"
      154        SIZE 10 BY 1.
      155   DEFINE BUTTON B-split AUTO-GO
      156        LABEL "&Разбить"
      157        SIZE 10 BY 1.
      158   DEFINE VARIABLE all-qnty AS DECIMAL FORMAT ">>,>>9.999":U INITIAL 0
      159        LABEL "Введено"
      160         VIEW-AS TEXT
      161        SIZE 18 BY 1 NO-UNDO.
      162   DEFINE VARIABLE all-qnty-cli AS DECIMAL FORMAT ">>,>>9.999":U INITIAL 0
      163        LABEL "Введено"
      164         VIEW-AS TEXT
      165        SIZE 18 BY 1 NO-UNDO.
      166   DEFINE VARIABLE for-goods AS CHARACTER FORMAT "X(256)":U
      167         VIEW-AS TEXT
      168        SIZE 93.1 BY 1
      169        FGCOLOR 4  NO-UNDO.
      170   DEFINE VARIABLE for-in-code AS CHARACTER FORMAT "X(256)":U
      171         VIEW-AS TEXT
      172        SIZE 24.1 BY 1 NO-UNDO.
      173   DEFINE VARIABLE for-max-rate AS DECIMAL FORMAT "->>,>>9.999" INITIAL 0
      174        LABEL "Макс. кол-во в штуке"
      175         VIEW-AS TEXT
      176        SIZE 17 BY 1
      177        FGCOLOR 4  NO-UNDO.
      178   DEFINE VARIABLE for-min-rate AS DECIMAL FORMAT "->>,>>9.999" INITIAL 0
      179        LABEL "Мин. кол-во в штуке"
      180         VIEW-AS TEXT
      181        SIZE 17 BY 1
      182        FGCOLOR 4  NO-UNDO.
      183   DEFINE VARIABLE for-parts AS CHARACTER FORMAT "X(256)":U
      184         VIEW-AS TEXT
      185        SIZE 35.4 BY 1 NO-UNDO.
      186   DEFINE VARIABLE for-qnty AS DECIMAL FORMAT ">>,>>9.999":U INITIAL 0
      187        VIEW-AS FILL-IN
      188        SIZE 18.4 BY 1 NO-UNDO.
      189   DEFINE VARIABLE part-cli-qnty AS DECIMAL FORMAT ">>,>>9.999":U INITIAL 0
      190        LABEL "Кол-во изделий"
      191         VIEW-AS TEXT
      192        SIZE 18 BY 1
      193        FGCOLOR 4  NO-UNDO.
      194   DEFINE VARIABLE part-qnty AS DECIMAL FORMAT ">>,>>9.999":U INITIAL 0
      195        LABEL "Вес изделий"
      196         VIEW-AS TEXT
      197        SIZE 18 BY 1
      198        FGCOLOR 4  NO-UNDO.
      199   DEFINE VARIABLE rest-qnty AS DECIMAL FORMAT "->>,>>9.999":U INITIAL 0
      200        LABEL "Осталось"
      201         VIEW-AS TEXT
      202        SIZE 18 BY 1
      203        FGCOLOR 4  NO-UNDO.
      204   DEFINE VARIABLE rest-qnty-cli AS DECIMAL FORMAT "->>,>>9.999":U INITIAL 0
      205        LABEL "Осталось"
      206         VIEW-AS TEXT
      207        SIZE 18 BY 1
      208        FGCOLOR 4  NO-UNDO.
      209   DEFINE RECTANGLE RECT-1
      210        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      211        SIZE 43.1 BY 2.87.
      212   DEFINE RECTANGLE RECT-2
      213        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      214        SIZE 35.5 BY 4.7.
      215   DEFINE RECTANGLE RECT-3
      216        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      217        SIZE 32.4 BY 4.7.
      218   DEFINE RECTANGLE RECT-4
      219        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      220        SIZE 97.4 BY 3.27.
      221   DEFINE QUERY BR-qnty FOR
      222         qnty-table SCROLLING.
      223   DEFINE QUERY Dialog-Frame FOR
      224         ub.goods SCROLLING.
      225   DEFINE BROWSE BR-qnty
      226     QUERY BR-qnty DISPLAY
      227         qnty-table.nn column-label "N"
      228         qnty-table.qnty column-label "Вес"
      229   ENABLE qnty-table.qnty
      230       WITH NO-ROW-MARKERS SEPARATORS SIZE 28.5 BY 15.77.
      231   DEFINE FRAME Dialog-Frame
      232        B-exit AT ROW 1 COL 1.1
      233        B-good AT ROW 1 COL 11
      234        B-doc AT ROW 1 COL 21
      235        B-split AT ROW 1 COL 31
      236        B-part AT ROW 1 COL 41
      237        B-Help AT ROW 1 COL 95
      238        for-qnty AT ROW 5.83 COL 2.1 NO-LABEL
      239        BR-qnty AT ROW 7.03 COL 1.9
      240        for-goods AT ROW 2.5 COL 2.4 COLON-ALIGNED NO-LABEL
      241        for-in-code AT ROW 3.93 COL 6.3 COLON-ALIGNED NO-LABEL
      242        for-parts AT ROW 3.93 COL 54.3 COLON-ALIGNED NO-LABEL
      243        for-min-rate AT ROW 6.37 COL 78.3 COLON-ALIGNED
      244        for-max-rate AT ROW 7.57 COL 78.1 COLON-ALIGNED
      245        part-qnty AT ROW 9.5 COL 42.5 COLON-ALIGNED
      246        part-cli-qnty AT ROW 9.53 COL 78.1 COLON-ALIGNED
      247        all-qnty AT ROW 10.87 COL 42.5 COLON-ALIGNED
      248        all-qnty-cli AT ROW 10.97 COL 78.1 COLON-ALIGNED
      249        rest-qnty AT ROW 12.3 COL 42.5 COLON-ALIGNED
      250        rest-qnty-cli AT ROW 12.37 COL 78.1 COLON-ALIGNED
      251        "ПН:" VIEW-AS TEXT
      252             SIZE 4.3 BY 1 AT ROW 3.93 COL 3.3
      253        "Партия:" VIEW-AS TEXT
      254             SIZE 8.4 BY 1 AT ROW 3.93 COL 46.8
      255        RECT-4 AT ROW 2.2 COL 2.1
      256        RECT-1 AT ROW 6.07 COL 56.4
      257        RECT-3 AT ROW 9.27 COL 30.9
      258        RECT-2 AT ROW 9.27 COL 63.9
      259        SPACE(0.72) SKIP(9.10)
      260       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      261            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      262            TITLE "Разбиение партий"
      263            DEFAULT-BUTTON B-exit.
      264   ASSIGN
      265          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      266          FRAME Dialog-Frame:HIDDEN           = TRUE.
      267   ASSIGN
      268          B-part:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      269   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      270   DO:
      271     APPLY "END-ERROR":U TO SELF.
      272   END.
      273   ON CHOOSE OF B-doc IN FRAME Dialog-Frame
      274   DO:
      275     run str/showdoc.p
      276       (input parparentproc
      277       ,input for-in-code
      278       ,input ub.goods.artic
      279       ,input ub.goods.prod-type
      280       ,input ub.goods.prod-code
      281       ,input true
      282       ) .
      283   END.
      284   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
      285   DO:
      286       p-line-rec = ?.
      287   END.
      288   ON CHOOSE OF B-good IN FRAME Dialog-Frame
      289   DO:
      290     define variable old-min-rate like ub.goods.min-rate no-undo.
      291     define variable old-max-rate like ub.goods.max-rate no-undo.
      292     define variable glog as logical no-undo .
      293     def buffer b1-qnty for qnty-table.
      294     assign
      295     old-min-rate = ub.goods.min-rate
      296     old-max-rate = ub.goods.max-rate
      297     .
      298     FIND FIRST ub.db WHERE ub.db.db-num = v-cntxt-db-num NO-LOCK .
      299     if not avail db then return no-apply.
      300   define variable vss-include-info2 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      301   do:
      302     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      303       (input  v-cntxt-db-num
      304       ,input  v-cntxt-userid
      305       ,input  0
      306       ,input  'actn_reference_update':U
      307       ,input  'global':U
      308       ,input  0
      309       ,input  '':U
      310       ,input  0
      311       ,input  0
      312       ,input  goods.grp-code
      313       ,input  0
      314       ,input  true
      315       ,output glog
      316       )  .
      317   end.
      318     if glog AND NOT goods.stts <> 0 AND db.add-goods AND NOT transaction
      319     then do:
      320       run str/showgds.p ( input parparentproc
      321                          ,input ?
      322                          ,input goods.gds-code
      323                          ,input 'ИЗМЕНЕНИЕ':U).
      324       FIND current goods No-LOCK No-ERROR.
      325       if old-min-rate <> goods.min-rate OR old-max-rate <> goods.max-rate then do:
      326           assign
      327           for-min-rate = goods.min-rate
      328           for-max-rate = goods.max-rate
      329           .
      330           display
      331           for-min-rate
      332           for-max-rate
      333           with frame Dialog-Frame.
      334           FOR EACh b1-qnty:
      335               run check-qnty(b1-qnty.qnty, 0, recid(b1-qnty)) no-error.
      336               if error-status:error then do:
      337                 REPOSITION br-qnty to recid recid(b1-qnty) NO-ERROR.
      338                 glog = br-qnty:select-focused-ROW( ).
      339                 APPLY "ENTRY" to br-qnty.
      340                 return no-apply.
      341               end.
      342           end.
      343       end.
      344     end.
      345     else
      346     run str/showgds.p ( input parparentproc
      347                        ,input ?
      348                        ,input goods.gds-code
      349                        ,input 'ПРОСМОТР':U) no-error.
      350   END.
      351   ON CHOOSE OF B-split IN FRAME Dialog-Frame
      352   DO:
      353   define variable glog as logical no-undo .
      354     glog = no.
      355     if can-find(first qnty-table) then do:
      356       message "Вы уверены, что хотите разбить партию " for-parts
      357               "по ПН " for-in-code " на указанные здесь количества?" skip
      358               "Общее количество изделий по партии" part-cli-qnty
      359               "Общий вес изделий по партии" part-qnty SKIP
      360               "Введено количесто изделий" all-qnty-cli "Общим весом" all-qnty SKIP
      361               "Осталось" rest-qnty-cli "с весом " rest-qnty
      362       view-as alert-box QUESTION buttons YES-NO update glog.
      363       if NOT glog then return no-apply.
      364       FOR EACH temp-parts-qnty:
      365           delete temp-parts-qnty.
      366       END.
      367       FOR EACH qnty-table:
      368           create temp-parts-qnty.
      369           assign
      370           temp-parts-qnty.cli-qnty = 1
      371           temp-parts-qnty.qnty = qnty-table.qnty
      372           temp-parts-qnty.fact-qnty = qnty-table.qnty
      373           .
      374       END.
      375       run trg/partsplt.p (
      376                      input ub.parts.obj-type,
      377                      input ub.parts.obj-code,
      378                      input ub.parts.artic,
      379                      input ub.parts.prod-type,
      380                      input ub.parts.prod-code,
      381                      input ub.parts.in-code,
      382                      input ub.parts.out-code,
      383                      input ub.parts.part-code,
      384                      input table temp-parts-qnty) no-error.
      385       if error-status:error then do:
      386           message "Не удалось разбить партию!" skip
      387              error-status:get-message(1)
      388              view-as alert-box ERROR.
      389           return no-apply.
      390       end.
      391     end.
      392     else do:
      393       message "Вы не ввели количества на которые Вы хотите разбить партию"
      394       view-as alert-box.
      395       return no-apply.
      396     end.
      397   END.
      398   ON DELETE-CHARACTER OF BR-qnty IN FRAME Dialog-Frame
      399   DO:
      400   define variable glog as logical no-undo .
      401     glog = yes.
      402     if avail qnty-table then do:
      403       message "Удалить изделие N " qnty-table.nn " с весом "
      404                qnty-table.qnty
      405       view-as alert-box question buttons OK-Cancel update glog.
      406       if glog <> true then return.
      407       run check-qnty(- qnty-table.qnty, - 1, ?) no-error.
      408       if error-status:error then return no-apply.
      409       _MAIN-d:
      410       DO on error undo _main-d, return no-apply:
      411           delete qnty-table.
      412           run update-br no-error.
      413         IF ERROR-STATUS:ERROR THEN UNDO _main-d, return no-apply.
      414       end.
      415     end.
      416   END.
      417   ON RETURN OF BR-qnty IN FRAME Dialog-Frame
      418   DO:
      419     APPLY "ENTRY" to qnty-table.qnty in browse br-qnty.
      420   END.
      421   ON ROW-LEAVE OF BR-qnty IN FRAME Dialog-Frame
      422   DO:
      423    define variable new-qnty as decimal no-undo.
      424      if avail qnty-table then do :
      425      new-qnty = decimal(qnty-table.qnty:screen-value in browse br-qnty).
      426      if new-qnty <> qnty-table.qnty then do:
      427         run check-qnty(new-qnty, 0, recid(qnty-table)) no-error.
      428         if error-status:error then do:
      429           display
      430           qnty-table.qnty
      431           with browse br-qnty.
      432           return no-apply.
      433         end.
      434         run update-br no-error.
      435       end.
      436       end.
      437   END.
      438   ON RETURN OF for-qnty IN FRAME Dialog-Frame
      439   DO:
      440   define variable max-nn as integer no-undo.
      441     assign
      442     for-qnty.
      443     if all-qnty-cli >= part-cli-qnty then do:
      444       message "Количество введенных изделий уже равно количеству изделий в партии"
      445       view-as alert-box.
      446       return no-apply.
      447     end.
      448       run check-qnty(for-qnty, 1, ?) no-error.
      449       if error-status:error then return no-apply.
      450       FIND LAST qnty-table No-LOCK NO-ERROR.
      451       IF avail qnty-table then
      452       max-nn = qnty-table.nn.
      453       _MAIN:
      454       DO on error undo _main, return no-apply:
      455         CREATE qnty-table.
      456         assign
      457         qnty-table.nn = max-nn + 1
      458         qnty-table.qnty = for-qnty.
      459         run update-br no-error.
      460         IF ERROR-STATUS:ERROR THEN UNDO _main, return no-apply.
      461       end.
      462   END.
      463   ON RETURN OF qnty-table.qnty IN BROWSE BR-qnty
      464   DO:
      465     if avail qnty-table then do:
      466     run check-qnty(decimal(qnty-table.qnty:screen-value in browse br-qnty), 0, recid(qnty-table)) no-error.
      467     if error-status:error then return no-apply.
      468     _Main-l:
      469     DO ON ERROR UNDO _main-l, return no-apply:
      470     FIND FIRST b-qnty-table where
      471               recid(b-qnty-table) = recid(qnty-table) No-ERROR.
      472     IF ERROR-STATUS:ERROR THEN UNDO _main-l, return no-apply.
      473     assign
      474     b-qnty-table.qnty = decimal(qnty-table.qnty:screen-value in browse br-qnty).
      475     run update-br no-error.
      476     IF ERROR-STATUS:ERROR THEN UNDO _main-l, return no-apply.
      477     END.
      478     end.
      479     APPLY "ENTRY" to for-qnty in frame Dialog-Frame.
      480     return NO-APPLY.
      481   END.
      482   ON END-ERROR, TAB OF qnty-table.qnty IN BROWSE BR-qnty
      483   DO:
      484       DISPLAY  qnty-table.qnty with browse br-qnty.
      485       APPLY "ENTRY" to for-qnty in frame Dialog-Frame.
      486       return NO-APPLY.
      487   END.
      488   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      489   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      490   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      491   on help of frame Dialog-Frame
      492   do:
      493     run gbl/app_help.p
      494       (input this-procedure :file-name
      495       ,input ''
      496       ,input ?
      497       ) no-error.
      498     if error-status :error then do:
      499       message
      500         "Ошибка при вызове помощи"
      501         error-status :get-message(1)
      502         view-as alert-box .
      503     end.
      504   end.
      505   run minbtn-set in this-procedure .
      506   on choose of b-help in frame Dialog-Frame
      507   do:
      508     apply "help":u to frame Dialog-Frame .
      509   end.
      510   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      511   procedure minbtn-set :
      512       do
      513           on error undo, return error return-value
      514           :
      515           define variable ii              as integer       no-undo .
      516           define variable fh              as widget-handle no-undo .
      517           define variable hh              as widget-handle no-undo .
      518           define variable v-h             as handle        extent 4 no-undo .
      519           define variable v-name-button   as character     no-undo .
      520           define variable v-help-old-x    as decimal       no-undo .
      521           define variable v-help-old-y    as decimal       no-undo .
      522           define variable v-help-old-size as decimal       no-undo .
      523           define variable v-frame-width   as decimal       no-undo .
      524           define variable jj              as integer       no-undo .
      525           do
      526               on error undo, return error
      527               :
      528               assign
      529                   v-frame-width = frame Dialog-Frame:width - 0.3
      530                   fh            = frame Dialog-Frame:first-child
      531                   hh            = fh:first-child
      532                   ii            = 1
      533                   .
      534               do while valid-handle(hh):
      535                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      536                   do:
      537                       case lc(hh:name) :
      538                           when "b-help" then
      539                               do:
      540                                   hh:load-image-up("cmp/b-help.bmp":u) .
      541                                   hh:load-image-down("cmp/b-help.bmp":u) .
      542                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      543                                   hh:TOOLTIP = "Помощь" .
      544                                   v-help-old-x = hh:column .
      545                                   v-help-old-y = hh:row    .
      546                                   v-help-old-size = hh:width .
      547                                   hh:width-chars = 2.5 .
      548                               end.
      549                           when "b-print" then
      550                               do:
      551                                   hh:load-image("cmp/b-print.bmp":u) .
      552                                   hh:TOOLTIP = "Печать" .
      553                                   v-h[ii] = hh:handle .
      554                                   ii = ii + 1 .
      555                                   hh:width-chars = 3 .
      556                               end.
      557                           when "b-history" or
      558                           when "b-hist" then
      559                               do:
      560                                   hh:load-image("cmp/b-hist.bmp":u) .
      561                                   hh:TOOLTIP = "История" .
      562                                   v-h[ii] = hh:handle .
      563                                   ii = ii + 1 .
      564                                   hh:width-chars = 3 .
      565                               end.
      566                           when "b-sch" then
      567                               do:
      568                                   hh:load-image("cmp/b-sch.bmp":u) .
      569                                   hh:TOOLTIP = "Установка Фильтра" .
      570                                   v-h[ii] = hh:handle .
      571                                   ii = ii + 1 .
      572                                   hh:width-chars = 3 .
      573                               end.
      574                           when "b-hist-user" then
      575                               do:
      576                                   hh:load-image("cmp/b-hist.bmp":u) .
      577                                   hh:TOOLTIP = "История пользователя" .
      578                                   ii = ii + 1 .
      579                               end.
      580                       end case.
      581                   end.
      582                   hh = hh:next-sibling.
      583               end.
      584               b-help:column = v-frame-width - b-help:width-chars.
      585               jj = 0.
      586               repeat ii = 4 to 1 by -1 :
      587                   if valid-handle (v-h[ii] ) then
      588                   do:
      589                       jj  = jj + 1 .
      590                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      591                       v-h[ii]:row    = v-help-old-y .
      592                   end.
      593               end.
      594           end.
      595       end.
      596   end procedure.
      597   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      598   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      599   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      600   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      601   define variable v-diasize-current-frame-width  as decimal   no-undo .
      602   define variable v-diasize-current-frame-height as decimal   no-undo .
      603   define variable v-diasize-change-size          as logical   no-undo .
      604   define variable v-diasize-resize-button        as handle    no-undo .
      605   define variable v-diasize-wndmax               as logical   no-undo .
      606   define variable v-diasize-wndstore             as logical   no-undo .
      607   define variable v-diasize-proc-name            as character no-undo .
      608   define variable v-diasize-browse-handle        as handle    no-undo .
      609   define variable v-diasize-browse-number        as integer   no-undo .
      610   define variable v-diasize-need-full-display    as logical   no-undo init false .
      611   define temp-table temp-diasize-handle no-undo
      612     field handle-value  as handle
      613     field save-position as decimal
      614     index xpk is primary unique handle-value
      615     .
      616   define temp-table temp-browse-handle no-undo
      617     field browse-type   as character
      618     field browse-number as integer
      619     field browse-handle as handle
      620     field original-size as decimal
      621     index xpk is primary unique browse-type browse-number
      622     index xie browse-type browse-handle
      623   .
      624   procedure diasize_change-height :
      625     define input  parameter p-change-value  as decimal   no-undo .
      626     define input  parameter p-move-resize   as logical   no-undo .
      627     define variable v-field-group-handle    as handle    no-undo .
      628     define variable v-object-handle         as handle    no-undo .
      629     define variable v-frame-height          as decimal   no-undo .
      630     define variable v-frame-virtual-height  as decimal   no-undo .
      631     define variable v-browse-height         as decimal   no-undo .
      632     define variable v-window-height         as decimal   no-undo .
      633     define variable v-window-virtual-height as decimal   no-undo .
      634     define variable v-change-sign           as integer   no-undo .
      635     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      636     define buffer buf_temp-browse-handle  for temp-browse-handle .
      637     if p-change-value > 0
      638     then do:
      639       if frame Dialog-Frame :height + p-change-value
      640           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      641       then do:
      642         assign
      643           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      644                           - (frame Dialog-Frame :height-chars)
      645         .
      646         if p-change-value <= 0
      647         then do:
      648           run diasize_position-resize-button in this-procedure .
      649           return .
      650         end.
      651       end.
      652     end.
      653     if p-change-value < 0
      654     then do:
      655       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      656       then do:
      657         assign
      658           p-change-value = v-diasize-orig-frame-height
      659                          - (frame Dialog-Frame :height-chars)
      660         .
      661         if p-change-value >= 0
      662         then do:
      663           run diasize_position-resize-button in this-procedure .
      664           return .
      665         end.
      666       end.
      667     end.
      668     if p-change-value >= 0
      669     then do:
      670       assign
      671         v-change-sign = 1
      672       .
      673     end.
      674     else do:
      675       assign
      676         v-change-sign = -1
      677       .
      678     end.
      679     assign
      680       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      681     .
      682     if p-change-value = 0
      683     then do:
      684       run diasize_position-resize-button in this-procedure .
      685       return .
      686     end.
      687     move_block:
      688     do
      689     on error undo move_block, retry move_block
      690     :
      691       if retry
      692       then do:
      693         do
      694         on error undo move_block, leave move_block
      695         :
      696           if p-change-value > 0
      697           then do:
      698             for each buf_temp-diasize-handle
      699             on error undo, next
      700             :
      701               assign
      702                 v-object-handle = buf_temp-diasize-handle.handle-value
      703               .
      704               if v-object-handle <> v-diasize-resize-button
      705               then do:
      706                 assign
      707                   v-object-handle :row = buf_temp-diasize-handle.save-position
      708                 .
      709               end.
      710             end.
      711             assign
      712               v-diasize-browse-handle :height = v-browse-height
      713             .
      714             for each buf_temp-browse-handle
      715               where buf_temp-browse-handle.browse-type = 'height':u
      716             on error undo, next
      717             :
      718               assign
      719                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      720               .
      721             end.
      722             assign
      723               frame Dialog-Frame :height = v-frame-height
      724             .
      725             if frame Dialog-Frame :scrollable = true
      726             then do:
      727               assign
      728                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      729               .
      730             end.
      731             run diasize_position-resize-button in this-procedure .
      732           end.
      733           else do:
      734             if frame Dialog-Frame :scrollable = true
      735             then do:
      736               assign
      737                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      738               .
      739             end.
      740             assign
      741               frame Dialog-Frame :height = v-frame-height
      742             .
      743             assign
      744               v-diasize-browse-handle :height = v-browse-height
      745             .
      746             for each buf_temp-browse-handle
      747               where buf_temp-browse-handle.browse-type = 'height':u
      748             on error undo, next
      749             :
      750               assign
      751                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      752               .
      753             end.
      754             for each buf_temp-diasize-handle
      755             on error undo, next
      756             :
      757               assign
      758                 v-object-handle = buf_temp-diasize-handle.handle-value
      759               .
      760               if v-object-handle <> v-diasize-resize-button
      761               then do:
      762                 assign
      763                   v-object-handle :row = buf_temp-diasize-handle.save-position
      764                 .
      765               end.
      766             end.
      767             run diasize_position-resize-button in this-procedure .
      768           end.
      769           assign
      770             v-diasize-change-size = false
      771           .
      772           leave move_block .
      773         end.
      774       end.
      775       assign
      776         v-diasize-need-full-display = true
      777       .
      778       if v-diasize-change-size = false
      779       then do:
      780         assign
      781           v-diasize-change-size = true
      782         .
      783       end.
      784       else do:
      785         return .
      786       end.
      787       assign
      788         v-frame-height = frame Dialog-Frame :height
      789         v-frame-virtual-height = frame Dialog-Frame :virtual-height
      790         v-browse-height = v-diasize-browse-handle :height
      791       .
      792       for each buf_temp-browse-handle
      793         where buf_temp-browse-handle.browse-type = 'height':u
      794       :
      795         assign
      796           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
      797         .
      798       end.
      799       for each buf_temp-diasize-handle
      800       :
      801         delete buf_temp-diasize-handle .
      802       end.
      803       assign
      804         v-field-group-handle = frame Dialog-Frame :first-child
      805       .
      806       do while valid-handle(v-field-group-handle)
      807       :
      808         assign
      809           v-object-handle = v-field-group-handle :first-child
      810         .
      811         do while valid-handle(v-object-handle)
      812         :
      813           if  v-object-handle <> v-diasize-browse-handle :handle
      814           and can-query(v-object-handle, "row")
      815           and can-query(v-object-handle, "height")
      816           and ( v-object-handle :row > v-diasize-browse-handle :row )
      817           then do:
      818             find first buf_temp-browse-handle
      819               where buf_temp-browse-handle.browse-type   = 'height':u
      820                 and buf_temp-browse-handle.browse-handle = v-object-handle
      821               no-error .
      822             if available buf_temp-browse-handle
      823             then do:
      824             end.
      825             else do:
      826               create buf_temp-diasize-handle .
      827               assign
      828                 buf_temp-diasize-handle.handle-value  = v-object-handle
      829                 buf_temp-diasize-handle.save-position = v-object-handle :row
      830               .
      831             end.
      832           end.
      833           assign
      834             v-object-handle = v-object-handle :next-sibling
      835           .
      836         end.
      837         assign
      838           v-field-group-handle = v-field-group-handle :next-sibling
      839         .
      840       end.
      841       do with frame Dialog-Frame
      842       :
      843         hide v-diasize-resize-button .
      844         assign
      845           v-diasize-resize-button :row    = 1
      846           v-diasize-resize-button :column = 1
      847         .
      848       end.
      849       if p-change-value > 0
      850       then do:
      851         if frame Dialog-Frame :scrollable = true
      852         then do:
      853           assign
      854             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      855             no-error .
      856           if error-status :error
      857           or error-status :get-message(1) <> ""
      858           then do:
      859             undo move_block, retry move_block .
      860           end.
      861         end.
      862         assign
      863           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      864           no-error .
      865         if error-status :error
      866         or error-status :get-message(1) <> ""
      867         then do:
      868           undo move_block, retry move_block .
      869         end.
      870         assign
      871           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      872           no-error .
      873         if error-status :error
      874         or error-status :get-message(1) <> ""
      875         then do:
      876           undo move_block, retry move_block .
      877         end.
      878         for each buf_temp-browse-handle
      879           where buf_temp-browse-handle.browse-type = 'height':u
      880         on error undo move_block, retry move_block
      881         :
      882           assign
      883             buf_temp-browse-handle.browse-handle :height
      884               = buf_temp-browse-handle.browse-handle :height + p-change-value
      885             no-error .
      886           if error-status :error
      887           or error-status :get-message(1) <> ""
      888           then do:
      889             undo move_block, retry move_block .
      890           end.
      891         end.
      892         for each buf_temp-diasize-handle
      893         on error undo move_block, retry move_block
      894         :
      895           assign
      896             v-object-handle = buf_temp-diasize-handle.handle-value
      897           .
      898           if v-object-handle <> v-diasize-resize-button
      899           then do:
      900             assign
      901               v-object-handle :row = v-object-handle :row + p-change-value
      902               no-error .
      903             if error-status :error
      904             or error-status :get-message(1) <> ""
      905             then do:
      906               undo move_block, retry move_block .
      907             end.
      908           end.
      909         end.
      910       end.
      911       else do:
      912         for each buf_temp-diasize-handle
      913         on error undo move_block, retry move_block
      914         :
      915           assign
      916             v-object-handle = buf_temp-diasize-handle.handle-value
      917           .
      918           if v-object-handle <> v-diasize-resize-button
      919           then do:
      920             assign
      921               v-object-handle :row = v-object-handle :row + p-change-value
      922               no-error .
      923             if error-status :error
      924             or error-status :get-message(1) <> ""
      925             then do:
      926               undo move_block, retry move_block .
      927             end.
      928           end.
      929         end.
      930         assign
      931           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      932           no-error .
      933         if error-status :error
      934         or error-status :get-message(1) <> ""
      935         then do:
      936           undo move_block, retry move_block .
      937         end.
      938         for each buf_temp-browse-handle
      939           where buf_temp-browse-handle.browse-type = 'height':u
      940         on error undo move_block, retry move_block
      941         :
      942           assign
      943             buf_temp-browse-handle.browse-handle :height
      944               = buf_temp-browse-handle.browse-handle :height + p-change-value
      945             no-error .
      946           if error-status :error
      947           or error-status :get-message(1) <> ""
      948           then do:
      949             undo move_block, retry move_block .
      950           end.
      951         end.
      952         assign
      953           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      954           no-error .
      955         if error-status :error
      956         or error-status :get-message(1) <> ""
      957         then do:
      958           undo move_block, retry move_block .
      959         end.
      960         if frame Dialog-Frame :scrollable = true
      961         then do:
      962           assign
      963             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      964             no-error .
      965           if error-status :error
      966           or error-status :get-message(1) <> ""
      967           then do:
      968             undo move_block, retry move_block .
      969           end.
      970         end.
      971       end.
      972       if p-move-resize = true
      973       then do:
      974         run diasize_position-resize-button in this-procedure .
      975       end.
      976       if v-diasize-wndstore = true
      977       then do:
      978         if connected("ub") = true
      979         then do:
      980           define variable v-cntxt-db-num        as integer   no-undo .
      981           define variable v-cntxt-userid        as character no-undo .
      982           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
      983                                             , OUTPUT v-cntxt-userid
      984                                             ) .
      985           run gbl/wndsizew.p
      986             (input  v-cntxt-db-num
      987             ,input  v-cntxt-userid
      988             ,input  v-diasize-proc-name
      989             ,input  'height':u
      990             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
      991             ) .
      992         end.
      993       end.
      994     end.
      995     assign
      996       v-diasize-change-size = false
      997     .
      998   end procedure.
      999   procedure diasize_set-height :
     1000     define input  parameter p-new-height  as decimal   no-undo .
     1001     define input  parameter p-move-resize as logical   no-undo .
     1002     do
     1003     on error undo, return error return-value
     1004     :
     1005       run diasize_change-height in this-procedure
     1006         (input  (p-new-height - frame Dialog-Frame :height)
     1007         ,input  p-move-resize
     1008         ) .
     1009     end.
     1010   end procedure.
     1011   procedure diasize_change-width :
     1012     define input  parameter p-change-value as decimal   no-undo .
     1013     define input  parameter p-move-resize  as logical   no-undo .
     1014     define variable v-field-group-handle   as handle    no-undo .
     1015     define variable v-object-handle        as handle    no-undo .
     1016     define variable v-frame-width          as decimal   no-undo .
     1017     define variable v-frame-virtual-width  as decimal   no-undo .
     1018     define variable v-browse-width         as decimal   no-undo .
     1019     define variable v-window-width         as decimal   no-undo .
     1020     define variable v-window-virtual-width as decimal   no-undo .
     1021     define variable v-change-sign          as integer   no-undo .
     1022     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1023     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1024     if p-change-value > 0
     1025     then do:
     1026       if frame Dialog-Frame :width + p-change-value >
     1027           session :width-chars
     1028       then do:
     1029         assign
     1030           p-change-value = session :width-chars - frame Dialog-Frame :width
     1031         .
     1032         if p-change-value <= 0
     1033         then do:
     1034           run diasize_position-resize-button in this-procedure .
     1035           return .
     1036         end.
     1037       end.
     1038     end.
     1039     if p-change-value < 0
     1040     then do:
     1041       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1042       then do:
     1043         assign
     1044           p-change-value = v-diasize-orig-frame-width
     1045                          - frame Dialog-Frame :width
     1046         .
     1047         if p-change-value >= 0
     1048         then do:
     1049           run diasize_position-resize-button in this-procedure .
     1050           return .
     1051         end.
     1052       end.
     1053     end.
     1054     if p-change-value >= 0
     1055     then do:
     1056       assign
     1057         v-change-sign = 1
     1058       .
     1059     end.
     1060     else do:
     1061       assign
     1062         v-change-sign = -1
     1063       .
     1064     end.
     1065     assign
     1066       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1067     .
     1068     if p-change-value = 0
     1069     then do:
     1070       run diasize_position-resize-button in this-procedure .
     1071       return .
     1072     end.
     1073     move_block:
     1074     do
     1075     on error undo move_block, leave move_block
     1076     :
     1077       if retry
     1078       then do:
     1079         do
     1080         on error undo move_block, leave move_block
     1081         :
     1082           if p-change-value > 0
     1083           then do:
     1084             for each buf_temp-diasize-handle
     1085             on error undo, next
     1086             :
     1087               assign
     1088                 v-object-handle = buf_temp-diasize-handle.handle-value
     1089               .
     1090               if v-object-handle <> v-diasize-resize-button
     1091               then do:
     1092                 assign
     1093                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1094                 .
     1095               end.
     1096             end.
     1097             assign
     1098               v-diasize-browse-handle :width = v-browse-width
     1099             .
     1100             for each buf_temp-browse-handle
     1101               where buf_temp-browse-handle.browse-type = 'width':u
     1102             on error undo, next
     1103             :
     1104               assign
     1105                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1106               .
     1107             end.
     1108             assign
     1109               frame Dialog-Frame :width = v-frame-width
     1110             .
     1111             if frame Dialog-Frame :scrollable = true
     1112             then do:
     1113               assign
     1114                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1115               .
     1116             end.
     1117             run diasize_position-resize-button in this-procedure .
     1118           end.
     1119           else do:
     1120             if frame Dialog-Frame :scrollable = true
     1121             then do:
     1122               assign
     1123                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1124               .
     1125             end.
     1126             assign
     1127               frame Dialog-Frame :width = v-frame-width
     1128             .
     1129             for each buf_temp-browse-handle
     1130               where buf_temp-browse-handle.browse-type = 'width':u
     1131             on error undo, next
     1132             :
     1133               assign
     1134                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1135               .
     1136             end.
     1137             assign
     1138               v-diasize-browse-handle :width = v-browse-width
     1139             .
     1140             for each buf_temp-diasize-handle
     1141             on error undo, next
     1142             :
     1143               assign
     1144                 v-object-handle = buf_temp-diasize-handle.handle-value
     1145               .
     1146               if v-object-handle <> v-diasize-resize-button
     1147               then do:
     1148                 assign
     1149                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1150                 .
     1151               end.
     1152             end.
     1153             run diasize_position-resize-button in this-procedure .
     1154           end.
     1155           assign
     1156             v-diasize-change-size = false
     1157           .
     1158           leave move_block .
     1159         end.
     1160       end.
     1161       assign
     1162         v-diasize-need-full-display = true
     1163       .
     1164       if v-diasize-change-size = false
     1165       then do:
     1166         assign
     1167           v-diasize-change-size = true
     1168         .
     1169       end.
     1170       else do:
     1171         return .
     1172       end.
     1173       assign
     1174         v-frame-width = frame Dialog-Frame :width
     1175         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1176         v-browse-width = v-diasize-browse-handle :width
     1177       .
     1178       for each buf_temp-browse-handle
     1179         where buf_temp-browse-handle.browse-type = 'width':u
     1180       :
     1181         assign
     1182           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1183         .
     1184       end.
     1185       for each buf_temp-diasize-handle
     1186       :
     1187         delete buf_temp-diasize-handle .
     1188       end.
     1189       assign
     1190         v-field-group-handle = frame Dialog-Frame :first-child
     1191       .
     1192       do while valid-handle(v-field-group-handle)
     1193       :
     1194         assign
     1195           v-object-handle = v-field-group-handle :first-child
     1196         .
     1197         do while valid-handle(v-object-handle)
     1198         :
     1199           if  v-object-handle <> v-diasize-browse-handle :handle
     1200           and v-object-handle <> v-diasize-resize-button
     1201           and can-query(v-object-handle, "row")
     1202           and can-query(v-object-handle, "height")
     1203           and ( v-object-handle :col + v-object-handle :width
     1204                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1205               )
     1206           then do:
     1207             find first buf_temp-browse-handle
     1208               where buf_temp-browse-handle.browse-type   = 'width':u
     1209                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1210               no-error .
     1211             if available buf_temp-browse-handle
     1212             then do:
     1213             end.
     1214             else do:
     1215               create buf_temp-diasize-handle .
     1216               assign
     1217                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1218                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1219               .
     1220             end.
     1221           end.
     1222           assign
     1223             v-object-handle = v-object-handle :next-sibling
     1224           .
     1225         end.
     1226         assign
     1227           v-field-group-handle = v-field-group-handle :next-sibling
     1228         .
     1229       end.
     1230       do with frame Dialog-Frame
     1231       :
     1232         hide v-diasize-resize-button .
     1233         v-diasize-resize-button :row = 1.
     1234         v-diasize-resize-button :column = 1.
     1235       end.
     1236       if p-change-value > 0
     1237       then do:
     1238         if frame Dialog-Frame :scrollable = true
     1239         then do:
     1240           assign
     1241             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1242             no-error .
     1243           if error-status :error
     1244           or error-status :get-message(1) <> ""
     1245           then do:
     1246             undo move_block, retry move_block.
     1247           end.
     1248         end.
     1249         assign
     1250           frame Dialog-Frame :width = v-frame-width + p-change-value
     1251           no-error .
     1252         if error-status :error
     1253         or error-status :get-message(1) <> ""
     1254         then do:
     1255           undo move_block, retry move_block.
     1256         end.
     1257         assign
     1258           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1259         no-error .
     1260         if error-status :error
     1261         or error-status :get-message(1) <> ""
     1262         then do:
     1263           undo move_block, retry move_block.
     1264         end.
     1265         for each buf_temp-browse-handle
     1266           where buf_temp-browse-handle.browse-type = 'width':u
     1267         on error undo move_block, retry move_block
     1268         :
     1269           assign
     1270             buf_temp-browse-handle.browse-handle :width
     1271               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1272             no-error .
     1273           if error-status :error
     1274           or error-status :get-message(1) <> ""
     1275           then do:
     1276             undo move_block, retry move_block .
     1277           end.
     1278         end.
     1279         for each buf_temp-diasize-handle
     1280         on error undo move_block, retry move_block
     1281         :
     1282           assign
     1283             v-object-handle = buf_temp-diasize-handle.handle-value
     1284           .
     1285           if v-object-handle <> v-diasize-resize-button
     1286           then do:
     1287             assign
     1288               v-object-handle :col = v-object-handle :col + p-change-value
     1289               no-error .
     1290             if error-status :error
     1291             or error-status :get-message(1) <> ""
     1292             then do:
     1293               undo move_block, retry move_block .
     1294             end.
     1295           end.
     1296         end.
     1297       end.
     1298       else do:
     1299         for each buf_temp-diasize-handle
     1300         on error undo move_block, retry move_block
     1301         :
     1302           assign
     1303             v-object-handle = buf_temp-diasize-handle.handle-value
     1304           .
     1305           if v-object-handle <> v-diasize-resize-button
     1306           then do:
     1307             assign
     1308               v-object-handle :col = v-object-handle :col + p-change-value
     1309               no-error .
     1310             if error-status :error
     1311             or error-status :get-message(1) <> ""
     1312             then do:
     1313               undo move_block, retry move_block .
     1314             end.
     1315           end.
     1316         end.
     1317         for each buf_temp-browse-handle
     1318           where buf_temp-browse-handle.browse-type = 'width':u
     1319         on error undo move_block, retry move_block
     1320         :
     1321           assign
     1322             buf_temp-browse-handle.browse-handle :width
     1323               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1324             no-error .
     1325           if error-status :error
     1326           or error-status :get-message(1) <> ""
     1327           then do:
     1328             undo move_block, retry move_block .
     1329           end.
     1330         end.
     1331         assign
     1332           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1333           no-error .
     1334         if error-status :error
     1335         or error-status :get-message(1) <> ""
     1336         then do:
     1337           undo move_block, retry move_block.
     1338         end.
     1339         assign
     1340           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1341         no-error .
     1342         if error-status :error
     1343         or error-status :get-message(1) <> ""
     1344         then do:
     1345           undo move_block, retry move_block.
     1346         end.
     1347         if frame Dialog-Frame :scrollable = true
     1348         then do:
     1349           assign
     1350             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1351           no-error .
     1352           if error-status :error
     1353           or error-status :get-message(1) <> ""
     1354           then do:
     1355             undo move_block, retry move_block.
     1356           end.
     1357         end.
     1358       end.
     1359       if p-move-resize
     1360       then do:
     1361         run diasize_position-resize-button in this-procedure .
     1362       end.
     1363       if v-diasize-wndstore = true
     1364       then do:
     1365         if connected("ub") = true
     1366         then do:
     1367           define variable v-cntxt-db-num        as integer   no-undo .
     1368           define variable v-cntxt-userid        as character no-undo .
     1369           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1370                                             , OUTPUT v-cntxt-userid
     1371                                             ) .
     1372           run gbl/wndsizew.p
     1373             (input  v-cntxt-db-num
     1374             ,input  v-cntxt-userid
     1375             ,input  v-diasize-proc-name
     1376             ,input  'width':u
     1377             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1378             ) .
     1379         end.
     1380       end.
     1381     end.
     1382     assign
     1383       v-diasize-change-size = false
     1384     .
     1385   end procedure.
     1386   procedure diasize_set-width :
     1387     define input  parameter p-new-width  as decimal   no-undo .
     1388     define input  parameter p-move-resize as logical   no-undo .
     1389     do
     1390     on error undo, return error return-value
     1391     :
     1392       run diasize_change-width in this-procedure
     1393         (input  (p-new-width - frame Dialog-Frame :width)
     1394         ,input  p-move-resize
     1395         ) .
     1396     end.
     1397   end procedure.
     1398   procedure diasize_position-resize-button :
     1399     do with frame Dialog-Frame
     1400     :
     1401       hide v-diasize-resize-button .
     1402       assign
     1403         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1404                     - 1
     1405                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1406         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1407                     - 1
     1408                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1409       .
     1410       view v-diasize-resize-button .
     1411     end.
     1412   end procedure.
     1413   on alt-right anywhere
     1414   do:
     1415     run diasize_change-width in this-procedure
     1416       (input 1
     1417       ,input true
     1418       ) .
     1419     return no-apply .
     1420   end.
     1421   on alt-left anywhere
     1422   do:
     1423     run diasize_change-width in this-procedure
     1424       (input -1
     1425       ,input true
     1426       ) .
     1427     return no-apply .
     1428   end.
     1429   on alt-down anywhere
     1430   do:
     1431     run diasize_change-height in this-procedure
     1432       (input 1
     1433       ,input true
     1434       ) .
     1435     return no-apply .
     1436   end.
     1437   on alt-up anywhere
     1438   do:
     1439     run diasize_change-height in this-procedure
     1440       (input -1
     1441       ,input true
     1442       ) .
     1443     return no-apply .
     1444   end.
     1445   on alt-enter of frame Dialog-Frame
     1446   do:
     1447     run diasize_maximize in this-procedure
     1448       (input  ?
     1449       ).
     1450     return no-apply .
     1451   end.
     1452   procedure diasize_end-move :
     1453     do
     1454     on error undo, return error return-value
     1455     :
     1456       define variable v-row-delta as decimal   no-undo .
     1457       define variable v-col-delta as decimal   no-undo .
     1458       define variable v-new-row as decimal   no-undo .
     1459       define variable v-new-col as decimal   no-undo .
     1460       assign
     1461         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1462         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1463       .
     1464       assign
     1465         v-row-delta = v-new-row - frame Dialog-Frame :height
     1466         v-col-delta = v-new-col - frame Dialog-Frame :width
     1467       .
     1468       run diasize_change-height in this-procedure
     1469         (input v-row-delta
     1470         ,input true
     1471         ) .
     1472       run diasize_change-width in this-procedure
     1473         (input v-col-delta
     1474         ,input true
     1475         ) .
     1476     end.
     1477   end procedure.
     1478   procedure diasize_maximize :
     1479     define input  parameter p-action as logical   no-undo .
     1480     do
     1481     on error undo, return error return-value
     1482     :
     1483       if p-action = ?
     1484       then do:
     1485         if v-diasize-need-maximize = true
     1486         then do:
     1487           assign
     1488             p-action = true
     1489           .
     1490         end.
     1491         else do:
     1492           assign
     1493             p-action = false
     1494           .
     1495         end.
     1496       end.
     1497       if p-action = true
     1498       then do:
     1499         run diasize_change-height in this-procedure
     1500           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1501               - frame Dialog-Frame :height-chars
     1502           ,input true
     1503           ) .
     1504         run diasize_change-width in this-procedure
     1505           (input session :width-chars
     1506               - frame Dialog-Frame :width-chars
     1507           ,input true
     1508           ) .
     1509         assign
     1510           v-diasize-need-maximize = false
     1511         .
     1512       end.
     1513       else do:
     1514         run diasize_change-width in this-procedure
     1515           (input v-diasize-orig-frame-width
     1516               - frame Dialog-Frame :width-chars
     1517           ,input true
     1518           ) .
     1519         run diasize_change-height in this-procedure
     1520           (input v-diasize-orig-frame-height
     1521               - frame Dialog-Frame :height-chars
     1522           ,input true
     1523           ) .
     1524         assign
     1525           v-diasize-need-maximize = true
     1526         .
     1527       end.
     1528     end.
     1529   end procedure.
     1530   procedure diasize_restore-orig-size :
     1531     do
     1532     on error undo, return error return-value
     1533     :
     1534       assign
     1535         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1536         v-diasize-current-frame-height = frame Dialog-Frame :height
     1537       .
     1538       run diasize_set-height in this-procedure
     1539         (input  v-diasize-orig-frame-height
     1540         ,input  true
     1541         ) .
     1542       run diasize_set-width in this-procedure
     1543         (input  v-diasize-orig-frame-width
     1544         ,input  true
     1545         ) .
     1546     end.
     1547   end procedure.
     1548   procedure diasize_restore-current-size :
     1549     do
     1550     on error undo, return error return-value
     1551     :
     1552       run diasize_set-height in this-procedure
     1553         (input  v-diasize-current-frame-height
     1554         ,input  true
     1555         ) .
     1556       run diasize_set-width in this-procedure
     1557         (input  v-diasize-current-frame-width
     1558         ,input  true
     1559         ) .
     1560     end.
     1561   end procedure.
     1562   procedure diasize_set-browse-handle :
     1563     define input  parameter p-browse-handle as handle   no-undo .
     1564     define buffer buf_temp-browse-handle for temp-browse-handle .
     1565     do
     1566     on error undo, return error return-value
     1567     :
     1568       assign
     1569         v-diasize-browse-handle = p-browse-handle
     1570       .
     1571       for each buf_temp-browse-handle
     1572       on error undo, return error return-value
     1573       :
     1574         delete buf_temp-browse-handle .
     1575       end.
     1576     end.
     1577   end procedure.
     1578   procedure diasize_add_browse :
     1579     define input  parameter p-browse-type   as character no-undo .
     1580     define input  parameter p-browse-handle as handle    no-undo .
     1581     define buffer buf_temp-browse-handle for temp-browse-handle .
     1582     do
     1583     on error undo, return error return-value
     1584     :
     1585       assign
     1586         v-diasize-browse-number = v-diasize-browse-number + 1
     1587       .
     1588       create buf_temp-browse-handle .
     1589       assign
     1590         buf_temp-browse-handle.browse-type   = p-browse-type
     1591         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1592         buf_temp-browse-handle.browse-handle = p-browse-handle
     1593       .
     1594     end.
     1595   end procedure.
     1596   procedure diasize_init :
     1597     define variable v-default-value    as logical   no-undo .
     1598     define variable v-restore-saved    as logical   no-undo .
     1599     define variable v-resize-value-str as character no-undo .
     1600     do
     1601     on error undo, return error return-value
     1602     :
     1603       do with frame Dialog-Frame
     1604       :
     1605         assign
     1606           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1607           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1608           v-diasize-browse-handle     = browse BR-qnty :handle
     1609         .
     1610         create button v-diasize-resize-button
     1611         assign
     1612           parent        = frame Dialog-Frame :first-child
     1613           label         = "s"
     1614           height-pixels = 16
     1615           width-pixels  = 16
     1616           visible       = true
     1617           sensitive     = true
     1618           movable       = true
     1619           triggers:
     1620             on end-move persistent run diasize_end-move in this-procedure .
     1621           end triggers.
     1622         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1623         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1624         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1625         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1626         assign
     1627           v-diasize-wndmax = false
     1628         .
     1629         if connected("ub") = true
     1630         then do:
     1631           define variable v-cntxt-db-num        as integer   no-undo .
     1632           define variable v-cntxt-userid        as character no-undo .
     1633           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1634                                             , OUTPUT v-cntxt-userid
     1635                                             ) .
     1636           run gbl/wndpar_r.p
     1637             (input  v-cntxt-db-num
     1638             ,input  v-cntxt-userid
     1639             ,input  'wndmax':U
     1640             ,output v-diasize-wndmax
     1641             ,output v-default-value
     1642             ) .
     1643         end.
     1644         assign
     1645           v-diasize-wndstore = false
     1646         .
     1647         if connected("ub") = true
     1648         then do:
     1649           run gbl/wndpar_r.p
     1650             (input  v-cntxt-db-num
     1651             ,input  v-cntxt-userid
     1652             ,input  'wndstore':U
     1653             ,output v-diasize-wndstore
     1654             ,output v-default-value
     1655             ) .
     1656         end.
     1657         assign
     1658           v-diasize-proc-name = entry(1, program-name(2), '.')
     1659         .
     1660         if v-diasize-wndstore = true
     1661         then do:
     1662           assign
     1663             v-restore-saved = false
     1664           .
     1665           if connected("ub") = true
     1666           then do:
     1667             run gbl/wndsizer.p
     1668               (input  v-cntxt-db-num
     1669               ,input  v-cntxt-userid
     1670               ,input  v-diasize-proc-name
     1671               ,input  'height':u
     1672               ,output v-resize-value-str
     1673               ) .
     1674             if v-resize-value-str <> '':U
     1675             then do:
     1676               run diasize_change-height in this-procedure
     1677                 (input  integer(v-resize-value-str)
     1678                 ,input  true
     1679                 ) .
     1680               assign
     1681                 v-restore-saved = true
     1682               .
     1683             end.
     1684           end.
     1685           if connected("ub") = true
     1686           then do:
     1687             run gbl/wndsizer.p
     1688               (input  v-cntxt-db-num
     1689               ,input  v-cntxt-userid
     1690               ,input  v-diasize-proc-name
     1691               ,input  'width':u
     1692               ,output v-resize-value-str
     1693               ) .
     1694             if v-resize-value-str <> '':U
     1695             then do:
     1696               run diasize_change-width in this-procedure
     1697                 (input  integer(v-resize-value-str)
     1698                 ,input  true
     1699                 ) .
     1700               assign
     1701                 v-restore-saved = true
     1702               .
     1703             end.
     1704           end.
     1705           if v-restore-saved <> true
     1706           then do:
     1707             if v-diasize-wndmax = true
     1708             then do:
     1709               run diasize_maximize in this-procedure
     1710                 (input  true
     1711                 ) .
     1712             end.
     1713           end.
     1714         end.
     1715         else do:
     1716           if v-diasize-wndmax = true
     1717           then do:
     1718             run diasize_maximize in this-procedure
     1719               (input  true
     1720               ) .
     1721           end.
     1722         end.
     1723       end.
     1724     end.
     1725   end procedure.
     1726   procedure diasize_need-full-display :
     1727     define output parameter p-need-full-display as logical   no-undo .
     1728     do
     1729     on error undo, return error return-value
     1730     :
     1731       assign
     1732         p-need-full-display = v-diasize-need-full-display
     1733       .
     1734       assign
     1735         v-diasize-need-full-display = false
     1736       .
     1737     end.
     1738   end procedure.
     1739   procedure get-context :
     1740      define output parameter p-db-num as integer          no-undo.
     1741      define output parameter p-user-id as character        no-undo.
     1742      define variable v-login               as character    no-undo.
     1743      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1744      define buffer buf_user-login  for ub.user-login .
     1745      do
     1746      on error undo, return error
     1747      :
     1748            FIND FIRST buf_sys-ctrl no-lock.
     1749            ASSIGN
     1750               v-login = USERID("ub")
     1751               p-db-num = buf_sys-ctrl.db-num
     1752            .
     1753            FIND FIRST buf_user-login
     1754                 WHERE buf_user-login.db-num = p-db-num
     1755                   AND buf_user-login.user-login = v-login
     1756                 no-lock
     1757                 no-error
     1758                 .
     1759            IF AVAILABLE buf_user-login
     1760            THEN DO:
     1761               assign
     1762                  p-user-id = buf_user-login.user-id
     1763               .
     1764            END.
     1765      end.
     1766   end procedure.
     1767       run diasize_init in this-procedure .
     1768   MAIN-BLOCK:
     1769   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1770      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1771   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1772     run mainmenu_getcntxt in parparentproc
     1773       (output v-cntxt-db-num
     1774       ,output v-cntxt-userid
     1775       ,output v-cntxt-level
     1776       ,output v-cntxt-host-code-obj
     1777       ,output v-cntxt-obj-type
     1778       ,output v-cntxt-obj-code
     1779       ,output v-cntxt-db-num-obj
     1780       ,output v-cntxt-is-admin
     1781       ) .
     1782     FIND FIRST parts No-LOCK WHERE recid(parts) = p-line-rec No-ERROR.
     1783     if not avail parts then do:
     1784         message
     1785         vss-workfile vss-revision vss-description skip
     1786         "Не найдена партия" skip
     1787         view-as alert-box error .
     1788       return "error".
     1789     end.
     1790     IF NOT parts.cli-qnty > 1 then do:
     1791         message
     1792         vss-workfile vss-revision vss-description skip
     1793         "Партия состоит из одной единицы товара или уже разбита" skip
     1794         view-as alert-box error .
     1795       return "error".
     1796     end.
     1797     FIND FIRST goods No-LOCK WHERE
     1798                goods.artic = parts.artic AND
     1799                goods.prod-type = parts.prod-type AND
     1800                goods.prod-code = parts.prod-code No-ERROR.
     1801     IF NOT AVAIL goods then do:
     1802         message
     1803         vss-workfile vss-revision vss-description skip
     1804         "Не найден товар " parts.artic parts.prod-type string(parts.prod-code) skip
     1805         view-as alert-box error .
     1806       return "error".
     1807     END.
     1808     assign
     1809     for-parts = parts.part-code
     1810     for-in-code = parts.in-code
     1811     part-cli-qnty = parts.cli-qnty
     1812     part-qnty = parts.fact-qnty
     1813     for-min-rate = goods.min-rate
     1814     for-max-rate = goods.max-rate
     1815     for-goods = goods.artic + " " + goods.prod-type + string(goods.prod-code) + " " +
     1816                 goods.gds-name.
     1817     RUN enable_UI.
     1818     APPLY "ENTRY" to for-qnty.
     1819     WAIT-FOR GO OF FRAME Dialog-Frame.
     1820   END.
     1821   RUN disable_UI.
     1822   PROCEDURE check-qnty :
     1823     define input parameter loc-for-qnty as decimal no-undo.
     1824     define input parameter loc-for-qnty-cli as decimal no-undo.
     1825     define input parameter curr-recid as recid no-undo.
     1826     define var loc-all-qnty as decimal no-undo.
     1827     define var loc-all-qnty-cli as decimal no-undo.
     1828     define var loc-rest-qnty as decimal no-undo.
     1829     define var loc-rest-qnty-cli as decimal no-undo.
     1830     if loc-for-qnty = ?
     1831     or loc-for-qnty = 0
     1832     then do:
     1833       message
     1834         "Неверно введен вес изделия" skip
     1835         view-as alert-box error.
     1836       return error.
     1837     end.
     1838     if loc-for-qnty-cli >= 0
     1839     then do:
     1840       if (loc-for-qnty < ub.goods.min-rate)
     1841       then do:
     1842         define variable v-ok as logical   no-undo .
     1843         message
     1844           substitute("Вес изделия &1 меньше, чем минимальный вес, заданный в карточке товара &2"
     1845                     ,loc-for-qnty
     1846                     ,goods.min-rate
     1847                     ) skip
     1848           "Продолжить?" skip
     1849           view-as alert-box question buttons yes-no update v-ok .
     1850         if v-ok <> true
     1851         then do:
     1852           return error.
     1853         end.
     1854       end.
     1855       if loc-for-qnty > goods.max-rate then do:
     1856         message
     1857           substitute("Вес изделия &1 больше, чем максимальный вес, заданный в карточке товара &2"
     1858                     ,loc-for-qnty
     1859                     ,goods.max-rate
     1860                     ) skip
     1861           "Продолжить?" skip
     1862           view-as alert-box question buttons yes-no update v-ok .
     1863         if v-ok <> true
     1864         then do:
     1865           return error.
     1866         end.
     1867       end.
     1868     end.
     1869     assign
     1870       loc-all-qnty = 0
     1871       loc-all-qnty-cli = 0
     1872     .
     1873     for each b-qnty-table no-lock
     1874     on error undo, return error return-value
     1875     :
     1876       if recid(b-qnty-table) <> curr-recid then do:
     1877         assign
     1878           loc-all-qnty = loc-all-qnty + b-qnty-table.qnty
     1879           loc-all-qnty-cli = loc-all-qnty-cli + 1
     1880         .
     1881       end.
     1882     end.
     1883     assign
     1884       loc-all-qnty = loc-all-qnty + loc-for-qnty
     1885       loc-all-qnty-cli = loc-all-qnty-cli + (if loc-for-qnty-cli = 0 then 1 else loc-for-qnty-cli)
     1886       loc-rest-qnty = part-qnty - loc-all-qnty
     1887       loc-rest-qnty-cli = part-cli-qnty - loc-all-qnty-cli
     1888     .
     1889     if loc-all-qnty-cli > part-cli-qnty
     1890     then do:
     1891       message
     1892         "Общее введенное количество изделий больше количества изделий в партии" skip
     1893         view-as alert-box error.
     1894       return error.
     1895     end.
     1896     if loc-all-qnty > part-qnty then do:
     1897       message
     1898         "Общий введенный вес больше веса в партии" skip
     1899         view-as alert-box error.
     1900       return error.
     1901     end.
     1902     if  loc-rest-qnty-cli = 1
     1903     and (loc-rest-qnty < goods.min-rate
     1904          or loc-rest-qnty > goods.max-rate
     1905          )
     1906     then do:
     1907       if loc-rest-qnty > goods.max-rate
     1908       then do:
     1909         message
     1910           substitute("Вес одного оставшегося изделия &1 больше, чем максимальный вес, заданный в карточке товара &2"
     1911                     ,loc-rest-qnty
     1912                     ,goods.max-rate
     1913                     ) skip
     1914           "Продолжить?" skip
     1915           view-as alert-box question buttons yes-no update v-ok .
     1916         if v-ok <> true
     1917         then do:
     1918           return error.
     1919         end.
     1920       end.
     1921       if loc-rest-qnty < goods.min-rate
     1922       then do:
     1923         message
     1924           substitute("Вес одного оставшегося изделия &1 меньше, чем минимальный вес, заданный в карточке товара &2"
     1925                     ,loc-rest-qnty
     1926                     ,goods.min-rate
     1927                     ) skip
     1928           "Продолжить?" skip
     1929           view-as alert-box question buttons yes-no update v-ok .
     1930         if v-ok <> true
     1931         then do:
     1932           return error.
     1933         end.
     1934       end.
     1935     end.
     1936     if  loc-rest-qnty-cli = 0
     1937     and loc-rest-qnty <> 0
     1938     then do:
     1939       message
     1940         "Общее введенное количество изделий равно количеству изделий в партии" skip
     1941         "но общий введенный вес не равен общему весу изделий в партии" skip
     1942         view-as alert-box ERROR.
     1943       return error.
     1944     end.
     1945    END PROCEDURE.
     1946   PROCEDURE disable_UI :
     1947     HIDE FRAME Dialog-Frame.
     1948   END PROCEDURE.
     1949   PROCEDURE enable_UI :
     1950     DISPLAY for-qnty for-goods for-in-code for-parts for-min-rate for-max-rate
     1951             part-qnty part-cli-qnty all-qnty all-qnty-cli rest-qnty rest-qnty-cli
     1952         WITH FRAME Dialog-Frame.
     1953     ENABLE B-exit B-good B-doc B-split B-Help RECT-4 RECT-1 RECT-3 RECT-2
     1954            for-qnty BR-qnty for-goods for-in-code for-parts for-min-rate
     1955            for-max-rate part-qnty part-cli-qnty all-qnty all-qnty-cli rest-qnty
     1956            rest-qnty-cli
     1957         WITH FRAME Dialog-Frame.
     1958     VIEW FRAME Dialog-Frame.
     1959     OPEN QUERY BR-qnty FOR EACH qnty-table SHARE-LOCK.
     1960   END PROCEDURE.
     1961   PROCEDURE update-br :
     1962   define variable ii as integer no-undo.
     1963         assign
     1964         ii = 1
     1965         all-qnty = 0
     1966         all-qnty-cli = 0
     1967         .
     1968         for each b-qnty-table use-index pi:
     1969           ASSIGN
     1970           all-qnty = all-qnty + b-qnty-table.qnty
     1971           all-qnty-cli = all-qnty-cli + 1
     1972           .
     1973           if b-qnty-table.nn <> ii then
     1974           assign
     1975           b-qnty-table.nn = ii.
     1976           ii = ii + 1.
     1977         end.
     1978         assign
     1979         rest-qnty = part-qnty - all-qnty
     1980         rest-qnty-cli = part-cli-qnty - all-qnty-cli
     1981         .
     1982         display
     1983         all-qnty
     1984         rest-qnty
     1985         all-qnty-cli
     1986         rest-qnty-cli
     1987         with frame Dialog-Frame.
     1988           OPEN QUERY br-qnty FOR EACH qnty-table SHARE-LOCK.
     1989           DISPLAY br-qnty
     1990           with frame Dialog-Frame.
     1991           APPLY "ENTRY" to for-qnty.
     1992   END PROCEDURE.
