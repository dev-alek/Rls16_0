     2296   procedure prn-lib-open-stream :
     2297     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     2298     define input parameter p-page-size    as integer no-undo .
     2299     define input parameter p-is-stream    as logical no-undo .
     2300     define input parameter p-append       as logical no-undo .
     2301     define variable v-report-name as character no-undo .
     2302     do
     2303       on error undo, return error
     2304       :
     2305       run prn-lib-get-report-name  in this-procedure (
     2306         input parParentProc
     2307         ,output v-report-name
     2308         ).
     2309       if p-is-stream then
     2310       do:
     2311         if p-append then
     2312         do:
     2313           output stream PrnLibStream to value( v-report-name )
     2314             page-size value(p-page-size) append .
     2315         end.
     2316         if not p-append then
     2317         do:
     2318           output stream PrnLibStream to value( v-report-name )
     2319             page-size value(p-page-size) .
     2320         end.
     2321       end.
     2322       if not p-is-stream then
     2323       do:
     2324         if p-append then
     2325         do:
     2326           output to value( v-report-name )
     2327             page-size value(p-page-size) append .
     2328         end.
     2329         if not p-append then
     2330         do:
     2331           output to value( v-report-name )
     2332             page-size value(p-page-size) .
     2333         end.
     2334       end.
     2335     end.
     2336   end procedure.
     2337   procedure prn-lib-open-exp :
     2338     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     2339     define input parameter p-is-stream    as logical no-undo .
     2340     define input parameter p-is-append    as logical no-undo .
     2341     define output parameter p-ReportFileName as char init "report" no-undo.
     2342     define output parameter p-process as logical no-undo .
     2343     define variable glog as logical no-undo .
     2344     do
     2345       on error undo, return error
     2346       :
     2347       SYSTEM-DIALOG GET-FILE p-ReportFileName
     2348         TITLE      "Укажите путь"
     2349         FILTERS "Текстовый файл (*.txt)"   "*.txt"
     2350         ASK-OVERWRITE
     2351         CREATE-TEST-FILE
     2352         SAVE-AS
     2353         USE-FILENAME
     2354         DEFAULT-EXTENSION "txt"
     2355         UPDATE glog
     2356         .
     2357       if not glog then  return.
     2358       p-ReportFileName = trim( string( p-ReportFileName ) ) .
     2359       if p-is-stream then
     2360       do:
     2361         if p-is-append then
     2362         do:
     2363           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     2364         end.
     2365         else
     2366         do:
     2367           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
     2368         end.
     2369       end.
     2370       else
     2371       do:
     2372         if p-is-append then
     2373         do:
     2374           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     2375         end.
     2376         else
     2377         do:
     2378           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
     2379         end.
     2380       end.
     2381       p-process = yes.
     2382     end.
     2383   end procedure.
