     4026   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dlg-grp:PARENT eq ?
     4027   THEN FRAME Dlg-grp:PARENT = ACTIVE-WINDOW.
     4028   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4029   on help of frame Dlg-grp
     4030   do:
     4031     run gbl/app_help.p
     4032       (input this-procedure :file-name
     4033       ,input ''
     4034       ,input ?
     4035       ) no-error.
     4036     if error-status :error then do:
     4037       message
     4038         "Ошибка при вызове помощи"
     4039         error-status :get-message(1)
     4040         view-as alert-box .
     4041     end.
     4042   end.
     4043   run minbtn-set in this-procedure .
     4044   on choose of b-help in frame Dlg-grp
     4045   do:
     4046     apply "help":u to frame Dlg-grp .
     4047   end.
     4048   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4049   procedure minbtn-set :
     4050       do
     4051           on error undo, return error return-value
     4052           :
     4053           define variable ii              as integer       no-undo .
     4054           define variable fh              as widget-handle no-undo .
     4055           define variable hh              as widget-handle no-undo .
     4056           define variable v-h             as handle        extent 4 no-undo .
     4057           define variable v-name-button   as character     no-undo .
     4058           define variable v-help-old-x    as decimal       no-undo .
     4059           define variable v-help-old-y    as decimal       no-undo .
     4060           define variable v-help-old-size as decimal       no-undo .
     4061           define variable v-frame-width   as decimal       no-undo .
     4062           define variable jj              as integer       no-undo .
     4063           do
     4064               on error undo, return error
     4065               :
     4066               assign
     4067                   v-frame-width = frame Dlg-grp:width - 0.3
     4068                   fh            = frame Dlg-grp:first-child
     4069                   hh            = fh:first-child
     4070                   ii            = 1
     4071                   .
     4072               do while valid-handle(hh):
     4073                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     4074                   do:
     4075                       case lc(hh:name) :
     4076                           when "b-help" then
     4077                               do:
     4078                                   hh:load-image-up("cmp/b-help.bmp":u) .
     4079                                   hh:load-image-down("cmp/b-help.bmp":u) .
     4080                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     4081                                   hh:TOOLTIP = "Помощь" .
     4082                                   v-help-old-x = hh:column .
     4083                                   v-help-old-y = hh:row    .
     4084                                   v-help-old-size = hh:width .
     4085                                   hh:width-chars = 2.5 .
     4086                               end.
     4087                           when "b-print" then
     4088                               do:
     4089                                   hh:load-image("cmp/b-print.bmp":u) .
     4090                                   hh:TOOLTIP = "Печать" .
     4091                                   v-h[ii] = hh:handle .
     4092                                   ii = ii + 1 .
     4093                                   hh:width-chars = 3 .
     4094                               end.
     4095                           when "b-history" or
     4096                           when "b-hist" then
     4097                               do:
     4098                                   hh:load-image("cmp/b-hist.bmp":u) .
     4099                                   hh:TOOLTIP = "История" .
     4100                                   v-h[ii] = hh:handle .
     4101                                   ii = ii + 1 .
     4102                                   hh:width-chars = 3 .
     4103                               end.
     4104                           when "b-sch" then
     4105                               do:
     4106                                   hh:load-image("cmp/b-sch.bmp":u) .
     4107                                   hh:TOOLTIP = "Установка Фильтра" .
     4108                                   v-h[ii] = hh:handle .
     4109                                   ii = ii + 1 .
     4110                                   hh:width-chars = 3 .
     4111                               end.
     4112                           when "b-hist-user" then
     4113                               do:
     4114                                   hh:load-image("cmp/b-hist.bmp":u) .
     4115                                   hh:TOOLTIP = "История пользователя" .
     4116                                   ii = ii + 1 .
     4117                               end.
     4118                       end case.
     4119                   end.
     4120                   hh = hh:next-sibling.
     4121               end.
     4122               b-help:column = v-frame-width - b-help:width-chars.
     4123               jj = 0.
     4124               repeat ii = 4 to 1 by -1 :
     4125                   if valid-handle (v-h[ii] ) then
     4126                   do:
     4127                       jj  = jj + 1 .
     4128                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     4129                       v-h[ii]:row    = v-help-old-y .
     4130                   end.
     4131               end.
     4132           end.
     4133       end.
     4134   end procedure.
     4135   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     4136   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     4137   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     4138   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     4139   define variable v-diasize-current-frame-width  as decimal   no-undo .
     4140   define variable v-diasize-current-frame-height as decimal   no-undo .
     4141   define variable v-diasize-change-size          as logical   no-undo .
     4142   define variable v-diasize-resize-button        as handle    no-undo .
     4143   define variable v-diasize-wndmax               as logical   no-undo .
     4144   define variable v-diasize-wndstore             as logical   no-undo .
     4145   define variable v-diasize-proc-name            as character no-undo .
     4146   define variable v-diasize-browse-handle        as handle    no-undo .
     4147   define variable v-diasize-browse-number        as integer   no-undo .
     4148   define variable v-diasize-need-full-display    as logical   no-undo init false .
     4149   define temp-table temp-diasize-handle no-undo
     4150     field handle-value  as handle
     4151     field save-position as decimal
     4152     index xpk is primary unique handle-value
     4153     .
     4154   define temp-table temp-browse-handle no-undo
     4155     field browse-type   as character
     4156     field browse-number as integer
     4157     field browse-handle as handle
     4158     field original-size as decimal
     4159     index xpk is primary unique browse-type browse-number
     4160     index xie browse-type browse-handle
     4161   .
     4162   procedure diasize_change-height :
     4163     define input  parameter p-change-value  as decimal   no-undo .
     4164     define input  parameter p-move-resize   as logical   no-undo .
     4165     define variable v-field-group-handle    as handle    no-undo .
     4166     define variable v-object-handle         as handle    no-undo .
     4167     define variable v-frame-height          as decimal   no-undo .
     4168     define variable v-frame-virtual-height  as decimal   no-undo .
     4169     define variable v-browse-height         as decimal   no-undo .
     4170     define variable v-window-height         as decimal   no-undo .
     4171     define variable v-window-virtual-height as decimal   no-undo .
     4172     define variable v-change-sign           as integer   no-undo .
     4173     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     4174     define buffer buf_temp-browse-handle  for temp-browse-handle .
     4175     if p-change-value > 0
     4176     then do:
     4177       if frame Dlg-grp :height + p-change-value
     4178           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     4179       then do:
     4180         assign
     4181           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     4182                           - (frame Dlg-grp :height-chars)
     4183         .
