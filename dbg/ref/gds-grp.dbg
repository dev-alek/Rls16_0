     1403   FIELD individual  like ub.tax.individual
     1404   FIELD tax-name    like ub.tax.tax-name format "X(12)" column-label "Налог"
     1405   field rate-code   like ub.tax-rate.rate-code
     1406   FIELD rate-name   like ub.tax-rate.rate-name FORMAT "X(12)"
     1407   FIELD tax-type    like ub.tax.tax-type
     1408   field rate-value  like ub.tax-rate-value.rate-value
     1409   FIELD tax-rate-gds-rc  as recid
     1410   FIELD to-cashdesk like ub.tax.to-cashdesk
     1411   FIELD fact-date like ub.tax-rate-value.fact-date
     1412   FIELD fact-order like ub.tax-rate-value.fact-order
     1413   FIELD next-order like ub.tax-rate-value.fact-order
     1414   FIELD corr-user-name like ub.tax-rate-gds.corr-user-name
     1415   FIELD corr-user-db-num   like ub.tax-rate-gds.corr-user-db-num
     1416   FIELD corr-date like ub.tax-rate-gds.corr-date
     1417   FIELD corr-time like ub.tax-rate-gds.corr-time
     1418   index tax-code is unique primary tax-code fact-order descending rate-code.
     1419   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1420   define new shared variable PrintCopiesCounter as integer   no-undo initial 1 .
     1421   define new shared variable RepPathName        as character no-undo .
     1422   define new shared variable PrintRubl          as logical   no-undo .
     1423   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1424   define variable v-waitfram-action01         as character   no-undo .
     1425   define variable v-waitfram-action02         as character   no-undo .
     1426   define variable v-waitfram-action03         as character   no-undo .
     1427   define variable mWaitFramTextBeg            as character   no-undo.
     1428   define variable mWaitFramTextEnd            as character   no-undo.
     1429   define variable mWaitFramView               as logical     no-undo.
     1430   define variable mWaitProcEvent              as logical     no-undo init yes.
     1431   define variable mWaitFramInterval           as integer     no-undo init 1 .
     1432   define variable mWaitFramStop               as logical     no-undo.
     1433   define variable mWaitFramStopUser           as logical     no-undo.
     1434   define variable mWaitFramStopTimeOut        as logical     no-undo.
     1435   define variable mWaitFramStartProc          as datetime-tz no-undo.
     1436   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
     1437   define button B-WaitFramStop auto-end-key
     1438        label "Стоп"
     1439        size 10 by 1 tooltip "Остоновить процесс".
     1440   define button B-viewProcInfo
     1441        label "Информация"
     1442        size 15 by 1 tooltip "Информация о процесс".
     1443   define frame waitfram
     1444     v-waitfram-action01 format "x(72)" no-label skip
     1445     v-waitfram-action02 format "x(72)" no-label skip
     1446     v-waitfram-action03 format "x(72)" no-label skip
     1447     B-viewProcInfo
     1448     B-WaitFramStop at row 4 col 30
     1449     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     1450     .
     1451   define new global shared variable mBatchMode as logical no-undo init ?.
     1452   define variable mFramBachModHandle as handle no-undo.
     1453   mFramBachModHandle = frame waitfram:handle.
     1454   define variable mFameOldVis as logical no-undo.
     1455   define variable mVisCUrentVin as logical no-undo.
     1456   if session:batch-mode
     1457   then
     1458      mBatchMode = yes.
     1459   if mBatchMode = ? then do:
     1460     mVisCUrentVin = current-window:visible.
     1461     mFameOldVis = mFramBachModHandle:visible.
     1462     mFramBachModHandle:visible  = yes.
     1463     mBatchMode = mFramBachModHandle:visible ne yes.
     1464     mFramBachModHandle:visible = mFameOldVis.
     1465     current-window:visible = mVisCUrentVin.
     1466   end.
     1467    if  log-manager:logfile-name ne ?
     1468     then DO:
     1469         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1470         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1471         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     1472     end.
     1473   on choose of B-WaitFramStop in frame waitfram
     1474   do:
     1475     mWaitFramStop = yes.
     1476     mWaitFramStopUser = yes.
     1477   end.
     1478   function waitfram-check-timeout returns logical():
     1479      define variable vtime as int64 no-undo.
     1480      if mWaitFramStopTimeOut
     1481      then
     1482         return yes.
     1483      vtime = ( now - mWaitFramStartProc ) / 1000 .
     1484      if     mWaitFramTimeOut ne ?
     1485         and mWaitFramTimeOut ne 0
     1486         and mWaitFramTimeOut lt vtime
     1487      then do:
     1488         mWaitFramStopTimeOut = yes.
     1489      end.
     1490      return mWaitFramStopTimeOut.
     1491   end.
     1492   procedure waitfram-hide :
     1493     if not session:batch-mode
     1494     then do
     1495     on error undo, return error return-value
     1496     :
     1497       pause 0 before-hide .
     1498       if not mBatchMode then
     1499         hide frame waitfram .
     1500     if     not mWaitFramView
     1501        and mWaitProcEvent
     1502     then
     1503       process events .
     1504     end.
     1505   end procedure.
     1506   procedure waitfram-show :
     1507     define input  parameter p-message as character no-undo .
     1508     define variable v-left-margin as integer   no-undo .
     1509     if not session:batch-mode
     1510     then do
     1511     on error undo, return error return-value
     1512     :
     1513       if length(p-message) <= 70 then do:
     1514         assign
     1515           v-left-margin = integer((70 - length(p-message)) / 2)
     1516         .
     1517         assign
     1518           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     1519         .
     1520         assign
     1521           v-waitfram-action01 = " "
     1522           v-waitfram-action02 = " "
     1523                                    + fill(" ", v-left-margin)
     1524                                    + p-message
     1525           v-waitfram-action03 = " "
     1526         .
     1527       end.
     1528       else do:
     1529         define variable vRindex1 as integer no-undo.
     1530         define variable vRindex2 as integer no-undo.
     1531         vRindex1 = r-index(p-message," ",70).
     1532         if vRindex1 = 0
     1533         then
     1534            vRindex1 = 70.
     1535         if length(p-message)  <= vRindex1 + 70 then do:
     1536           assign
     1537             v-waitfram-action01 = " "
     1538             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     1539             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     1540           .
     1541         end.
     1542         else do:
     1543           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     1544           if vRindex2 <= vRindex1
     1545           then
     1546              vRindex2 = vRindex1 + 70.
     1547           assign
     1548             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     1549             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     1550             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     1551           .
     1552         end.
     1553       end.
     1554       B-viewProcInfo:visible   in frame waitfram = no.
     1555       B-viewProcInfo:sensitive in frame waitfram = no.
     1556       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1557       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1558       if  (   mWaitFramView
     1559          or  mWaitProcEvent)
     1560          and not mBatchMode
     1561       then
     1562          display
     1563             v-waitfram-action01 skip
     1564             v-waitfram-action02 skip
     1565             v-waitfram-action03 skip
     1566          with frame waitfram .
     1567       if     mWaitFramView
     1568          then do:
     1569             if     mWaitFramInterval ne ?
     1570                and not mBatchMode
     1571             then
     1572                wait-for go of frame waitfram pause mWaitFramInterval.
     1573          end.
     1574          else
     1575             if     mWaitProcEvent
     1576                and not mBatchMode
     1577             then
     1578                process events .
     1579     end.
     1580   end procedure.
     1581      procedure waitfram-show-this:
     1582         define input  parameter iInterval as int64 no-undo.
     1583         define variable vtime as int64 no-undo.
     1584         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1585         mWaitFramInterval = iInterval.
     1586         run waitfram-show (substitute("&1&2 &3&4" ,
     1587                                       mWaitFramTextBeg ,
     1588                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1589                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1590                                       mWaitFramTextEnd
     1591                                      )
     1592                           ).
     1593      end.
     1594      procedure WaitFramRunPause:
     1595         define input  parameter iInterval as dec no-undo.
     1596         define variable vStart  as datetime-tz no-undo.
     1597         define variable vend    as datetime-tz no-undo.
     1598         define variable vint as int64 no-undo.
     1599         define variable vOk as logical no-undo.
     1600         vStart = now.
     1601         vend   = vStart.
     1602         publish "WaitFramPause" (iInterval,output vOk).
     1603         vend   =  now.
     1604         vint = vend - vStart.
     1605         vint = iInterval - vint / 1000.
     1606         if     not mWaitFramStop
     1607            and (   vint > 0
     1608                 or (    not vOk
     1609                     and iInterval eq ?
     1610                     )
     1611                 )
     1612         then
     1613            run waitfram-show-this (iInterval).
     1614         vend   =  now.
     1615         vint = vend - vStart.
     1616         vint = iInterval - vint / 1000.
     1617         if     not mWaitFramStop
     1618            and vint > 0
     1619         then do:
     1620            run gbl/pause.p (vint * 1000).
     1621         end.
     1622         if iInterval ne ?
     1623         then
     1624            publish "WaitFramStop".
     1625         waitfram-check-timeout().
     1626      end.
     1627      procedure WaitFramWaitFor:
     1628         define input  parameter iInterval as dec no-undo.
     1629         assign
     1630            mWaitFramStartProc   = now
     1631            mWaitFramStopUser    = no
     1632            mWaitFramStopTimeOut = no
     1633         .
     1634         block-wait:
     1635         do while not mWaitFramStop:
     1636            run WaitFramRunPause (iInterval).
     1637            if  waitfram-check-timeout()
     1638            then do:
     1639               leave block-wait.
     1640            end.
     1641         end.
     1642         run waitfram-hide.
     1643      end.
     1644   procedure waitfram-join :
     1645     define input  parameter p-line-1  as character no-undo .
     1646     define input  parameter p-line-2  as character no-undo .
     1647     define input  parameter p-line-3  as character no-undo .
     1648     define output parameter p-message as character no-undo .
     1649     do
     1650     on error undo, return error return-value
     1651     :
     1652       assign
     1653         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1654                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1655                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1656       .
     1657     end.
     1658   end procedure.
     1659   function waitfram-join-function returns character
     1660     (input p-line-1 as character
     1661     ,input p-line-2 as character
     1662     ,input p-line-3 as character
     1663     ).
     1664     define variable v-message as character no-undo .
     1665     run waitfram-join in this-procedure
     1666       (input  p-line-1
     1667       ,input  p-line-2
     1668       ,input  p-line-3
     1669       ,output v-message
     1670       ) .
     1671     return v-message .
     1672   end function .
     1673   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
