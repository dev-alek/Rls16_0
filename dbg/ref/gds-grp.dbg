        1   define input parameter parparentproc        as handle           no-undo.
        2   define input parameter p-button-list        as character        no-undo.
        3   define input parameter p-current-obj-type   as character        no-undo.
        4   define input parameter p-current-obj-code   as integer          no-undo.
        5   define input-output parameter p-recid-list  as character        no-undo.
        6   define variable vss-revision    as character no-undo init "$Revision$":U .
        7   define variable vss-author      as character no-undo init "$Author$":U .
        8   define variable vss-date        as character no-undo init "$Date$":U .
        9   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       10   define variable vss-archive     as character no-undo init "$Archive$":U .
       11   define variable vss-description as character no-undo init "Управление деревом групп".
       12   procedure vss-get-info :
       13     define output parameter p-vss-revision    like vss-revision    no-undo .
       14     define output parameter p-vss-author      like vss-author      no-undo .
       15     define output parameter p-vss-date        like vss-date        no-undo .
       16     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       17     define output parameter p-vss-archive     like vss-archive     no-undo .
       18     define output parameter p-vss-description like vss-description no-undo .
       19     assign
       20       p-vss-revision    = vss-revision
       21       p-vss-author      = vss-author
       22       p-vss-date        = vss-date
       23       p-vss-workfile    = vss-workfile
       24       p-vss-archive     = vss-archive
       25       p-vss-description = vss-description
       26     .
       27   end procedure.
       28   procedure vss-get-parameters :
       29     define output parameter p-vss-parameters as character no-undo .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define new global shared variable g#language as character no-undo .
       67   if g#language <> '' and g#language <> 'rus':U then do:
       68     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       69   end.
       70   define new global shared variable g#library  as handle no-undo .
       71   define new global shared variable g#library2 as handle no-undo .
       72   define   shared variable g#auto as logical no-undo.
       73   define   shared variable g#news as logical no-undo.
       74   define   shared variable g#oxml as logical no-undo.
       75   define   shared variable g#esys as logical no-undo.
       76   define   shared variable g#news-source-db as integer no-undo.
       77   define   shared variable g#esys-source-esys as integer no-undo.
       78   define   shared variable g#db-num as integer   no-undo .
       79   define   shared variable g#userid as character no-undo .
       80   define   shared variable g#passwd as character no-undo .
       81   procedure proc-alt-shift-f2:
       82     if not ibs.th.gbl.gbl-var:rcode
       83   then
       84     run gbl\inidebug.p .
       85   end.
       86   procedure proc-alt-shift-f3:
       87     run gbl/prvssinf.p
       88       ( input this-procedure
       89       ) .
       90   end.
       91   define variable v-inform-launched as logical no-undo initial false .
       92   procedure proc-alt-shift-f4:
       93     define variable v-action as character no-undo .
       94     if v-inform-launched = false then do:
       95       assign
       96         v-inform-launched = true
       97       .
       98       run gbl/d-inform.w
       99         (  input self
      100         ,  input this-procedure
      101         , output v-action
      102         ) no-error .
      103       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      104       assign
      105         v-inform-launched = false
      106       .
      107     end.
      108   end.
      109   procedure proc-alt-f1:
      110     run gbl/corrhelp.p
      111       (input this-procedure
      112       ) .
      113   end .
      114   on alt-shift-f2 anywhere do:
      115     run proc-alt-shift-f2.
      116   end.
      117   on alt-shift-f3 anywhere do:
      118     run proc-alt-shift-f3 in this-procedure .
      119   end.
      120   on alt-shift-f4 anywhere do:
      121     run proc-alt-shift-f4 in this-procedure.
      122   end.
      123   on alt-f1 anywhere do:
      124     run proc-alt-f1 in this-procedure .
      125   end.
      126   define variable vss-include-info0 as character format "X(65)" no-undo
      127   initial "@(#)$Workfile$ $Revision$".
      128   define temp-table temp_grplib_grp no-undo
      129       field sel           as character
      130       field nabor         as character
      131       field full-name     as character
      132       field print-code    as character
      133       field sort-name     as character
      134       field node-code     as integer
      135       field upper-code    as integer
      136       field calc-method   as character
      137       field round-method  as character
      138       field increase-pc   as decimal
      139       field min-marg      as character
      140       field max-marg      as character
      141       field cli-type      as character
      142       field cli-code      as integer
      143       field notcorr      as character
      144       field name          as character
      145       field level         as integer
      146       field mark          as character
      147       index pi is primary unique sort-name
      148       index fn full-name
      149       index nc is unique node-code
      150       index sl sel
      151       index uc upper-code
      152   .
      153   define temp-table temp_grplib_found-grp no-undo
      154       field full-name   as character
      155       field sort-name   as character
      156       field node-code   as integer
      157       field level       as integer
      158       field is-terminal as logical
      159       index pi is primary unique sort-name
      160       index fn full-name
      161       index lv level
      162       index it is-terminal
      163   .
      164   define temp-table temp_found-result-nodelist no-undo
      165       field node-code     as recid
      166       field processed     as logical
      167       field sort-name     as character
      168       field full-name     as character
      169       index pi is primary unique node-code
      170       index ps processed
      171   .
      172   define variable v-grplib-not-fill-extra-info        as logical      no-undo.
      173   define variable v-grplib-no-warning-grp-amount      as logical      no-undo.
      174   define variable v-grplib-grp-amount-for-load        as integer      no-undo.
      175   procedure grplib-get-parameters :
      176   define input parameter p-store-type     as character        no-undo.
      177   define input parameter p-store-code     as integer          no-undo.
      178   do
      179   on error undo, return error
      180   :
      181       assign
      182           v-grplib-not-fill-extra-info = no
      183       .
      184   end.
      185   end procedure.
      186   procedure grplib-get-sort-name :
      187   do
      188   on error undo, return error
      189   :
      190   define input parameter p-node-code  as integer      no-undo.
      191   define output parameter p-sort-name as character    no-undo.
      192       define variable v-upper-code    as integer           no-undo.
      193       define buffer buf_gds-grp       for ub.gds-grp.
      194       define buffer buf_upper_gds-grp for ub.gds-grp.
      195       find first buf_gds-grp no-lock
      196            where buf_gds-grp.node-code = p-node-code
      197       no-error.
      198       if not available buf_gds-grp
      199       then do:
      200           undo, return error "grplib-get-sort-name: Не найдена группа товаров с кодом " + string( p-node-code ).
      201       end.
      202       assign
      203           p-sort-name  = ""
      204           v-upper-code = 1
      205       .
      206       do while buf_gds-grp.upper-code <> 0
      207       on error undo, return error "grplib-get-sort-name: Ошибка составления полного имени группы"
      208       :
      209           assign
      210               p-sort-name  = buf_gds-grp.node-name
      211                            + (if p-sort-name <> "" then chr(2) else "")
      212                            + p-sort-name
      213               v-upper-code = buf_gds-grp.upper-code
      214           .
      215           find first buf_gds-grp no-lock
      216                where buf_gds-grp.node-code = v-upper-code
      217           no-error.
      218           if not available buf_gds-grp
      219           then do:
      220               undo, return error "grplib-get-sort-name: Не найдена группа товаров с кодом "
      221                                   + string( v-upper-code )
      222                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
      223           end.
      224       end.
      225   end.
      226   end procedure.
      227   define variable vss-include-info1 as character format "X(65)" no-undo
      228   initial "@(#)$Workfile$ $Revision$".
      229   procedure grplib-get-full-name :
      230      define input parameter p-node-code  as integer      no-undo.
      231      define output parameter p-full-name as character    no-undo.
      232      do
      233   on error undo, return error
      234   :
      235       define variable v-upper-code    as integer           no-undo.
      236       define buffer buf_gds-grp       for ub.gds-grp.
      237       define buffer buf_upper_gds-grp for ub.gds-grp.
      238       find first buf_gds-grp no-lock
      239            where buf_gds-grp.node-code = p-node-code
      240       no-error.
      241       if not available buf_gds-grp
      242       then do:
      243           undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
      244       end.
      245       assign
      246           p-full-name  = ""
      247           v-upper-code = 1
      248       .
      249       do while buf_gds-grp.upper-code <> 0
      250       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
      251       :
      252           assign
      253               p-full-name  = buf_gds-grp.node-name
      254                            + (if p-full-name <> "" then chr(47) else "")
      255                            + p-full-name
      256               v-upper-code = buf_gds-grp.upper-code
      257           .
      258           find first buf_gds-grp no-lock
      259                where buf_gds-grp.node-code = v-upper-code
      260           no-error.
      261           if not available buf_gds-grp
      262           then do:
      263               undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом "
      264                                   + string( v-upper-code )
      265                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
      266           end.
      267       end.
      268       assign
      269       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
      270       .
      271   end.
      272   end .
      273   procedure grplib-get-node-from-full-name :
      274   define input parameter p-full-name as character no-undo .
      275   define output parameter p-node-code as integer no-undo .
      276   define variable v-ii as integer no-undo .
      277   define variable v-upper-code as integer no-undo .
      278   define variable v-root-code as integer no-undo .
      279   define variable v-entry as character no-undo .
      280   define buffer buf_gds-grp       for ub.gds-grp.
      281   do
      282   on error undo, return error
      283   :
      284     find first buf_gds-grp no-lock
      285         where buf_gds-grp.upper-code = 0
      286     no-error .
      287     if not available buf_gds-grp
      288     then do:
      289         undo, return error substitute("Не найдена корневая группа товаров (upper-code = 0)").
      290     end.
      291     else do:
      292       assign
      293       v-root-code = buf_gds-grp.node-code
      294       .
      295     end.
      296     v-upper-code = v-root-code.
      297     do v-ii = 1 to num-entries(p-full-name, chr(47)):
      298       assign
      299       v-entry = entry(v-ii, p-full-name, chr(47)).
      300       if v-entry = '' then leave.
      301       find first buf_gds-grp no-lock where
      302                 buf_gds-grp.node-name = v-entry
      303             and buf_gds-grp.upper-code = v-upper-code
      304             no-error.
      305       if not available buf_gds-grp then do:
      306         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
      307       end.
      308       else do:
      309         p-node-code = buf_gds-grp.node-code.
      310         v-upper-code = buf_gds-grp.node-code.
      311       end.
      312     end.
      313   end.
      314   end .
      315   procedure grplib-get-root-code :
      316   do
      317   on error undo, return error
      318   :
      319   define output parameter p-root-code as integer      no-undo.
      320       define buffer buf_gds-grp       for ub.gds-grp.
      321       find first buf_gds-grp no-lock
      322           where buf_gds-grp.upper-code = 0
      323       no-error .
      324       if not available buf_gds-grp
      325       then do:
      326           undo, return error .
      327       end.
      328       else do:
      329           assign
      330               p-root-code = buf_gds-grp.node-code
      331           .
      332       end.
      333   end.
      334   end procedure.
      335   procedure grplib-find-grp-by-full-name :
      336   do
      337   on error undo, return error
      338   :
      339   define input parameter p-search-name  as character    no-undo.
      340   define input parameter p-fill-path    as logical      no-undo.
      341   define output parameter p-found       as logical      no-undo.
      342       define variable v-upper-code    as integer          no-undo.
      343       define variable v-counter       as integer           no-undo.
      344       define variable v-level         as integer           no-undo.
      345       define variable v-full-name     as character         no-undo.
      346       define variable v-sort-name     as character         no-undo.
      347       define buffer buf_gds-grp       for ub.gds-grp.
      348       assign
      349           p-search-name = replace( p-search-name, chr(47), chr(2) )
      350       .
      351       run grplib-get-root-code ( output v-upper-code ) no-error .
      352       if error-status :error
      353       then do:
      354           undo, return error "grplib-expand-name: Ошибка при поиске корневого узла".
      355       end.
      356       assign
      357           v-full-name  = ""
      358           v-level      = num-entries( p-search-name, chr(2) )
      359       .
      360       for each temp_grplib_found-grp
      361       :
      362           delete temp_grplib_found-grp.
      363       end.
      364       start-name-analyze:
      365       do v-counter = 1 to v-level
      366       :
      367           if v-counter < v-level
      368           then do:
      369               find first buf_gds-grp no-lock
      370                    where buf_gds-grp.upper-code = v-upper-code
      371                      and buf_gds-grp.node-name  = entry( v-counter, p-search-name, chr(2) )
      372               no-error .
      373               if not available buf_gds-grp
      374               then do:
      375                   assign
      376                       v-full-name  = p-search-name
      377                       v-sort-name  = p-search-name
      378                   .
      379                   return error "grplib-expand-name: не найдена группа " + entry( v-level, p-search-name, chr(2) ).
      380               end.
      381               else do:
      382                   assign
      383                       v-full-name = v-full-name + ( if v-full-name = "" then "" else chr(47) )        + buf_gds-grp.node-name
      384                       v-sort-name = v-sort-name + ( if v-sort-name = "" then "" else chr(2) ) + buf_gds-grp.node-name
      385                       v-upper-code = buf_gds-grp.node-code
      386                   .
      387                   if p-fill-path = yes
      388                   then do:
      389                       create temp_grplib_found-grp.
      390                       assign
      391                           temp_grplib_found-grp.full-name = v-full-name + chr(47)
      392                           temp_grplib_found-grp.sort-name = v-sort-name
      393                           temp_grplib_found-grp.node-code = v-upper-code
      394                           temp_grplib_found-grp.level     = v-counter
      395                       .
      396                   end.
      397               end.
      398           end.
      399           else do:
      400               for each buf_gds-grp no-lock
      401                  where buf_gds-grp.upper-code = v-upper-code
      402                    and buf_gds-grp.node-name begins entry( v-counter, p-search-name, chr(2) )
      403               :
      404                   assign
      405                       p-found = yes
      406                   .
      407                   create temp_grplib_found-grp.
      408                   assign
      409                       temp_grplib_found-grp.full-name = v-full-name
      410                                                           + (if v-full-name = "" then "" else chr(47) )
      411                                                           + buf_gds-grp.node-name + chr(47)
      412                       temp_grplib_found-grp.sort-name = v-sort-name
      413                                                           + ( if v-sort-name = "" then "" else chr(2) )
      414                                                           + buf_gds-grp.node-name
      415                       temp_grplib_found-grp.node-code = buf_gds-grp.node-code
      416                       temp_grplib_found-grp.level     = v-level
      417                   .
      418               end.
      419               if p-found = no
      420               then do:
      421                   assign
      422                       v-full-name  = p-search-name
      423                       v-sort-name  = p-search-name
      424                   .
      425                   for each temp_grplib_found-grp
      426                   :
      427                       delete temp_grplib_found-grp.
      428                   end.
      429                   assign
      430                       p-found = no
      431                   .
      432               end.
      433           end.
      434       end.
      435   end.
      436   end procedure.
      437   procedure grplib-find-all-subgroup :
      438   do
      439   on error undo, return error
      440   :
      441   define input parameter p-start-node-code    as integer      no-undo.
      442   define input parameter p-terminal-only      as logical      no-undo.
      443       define variable v-start-full-name   as character     no-undo.
      444       define variable v-start-sort-name   as character     no-undo.
      445       define variable v-not-found         as logical       no-undo.
      446       define variable v-is-terminal       as logical       no-undo.
      447       define buffer buf_gds-grp           for ub.gds-grp.
      448       create temp_found-result-nodelist.
      449       assign
      450           temp_found-result-nodelist.node-code = p-start-node-code
      451           temp_found-result-nodelist.processed = no
      452       .
      453       run grplib-get-full-name in this-procedure (
      454             input p-start-node-code
      455           , output v-start-full-name
      456       ).
      457       run grplib-get-full-name in this-procedure (
      458             input p-start-node-code
      459           , output v-start-sort-name
      460       ).
      461       process-nodes:
      462       do while yes
      463       :
      464           find first temp_found-result-nodelist
      465                where temp_found-result-nodelist.node-code = p-start-node-code
      466           .
      467           assign
      468               temp_found-result-nodelist.processed = yes
      469           .
      470           for each buf_gds-grp no-lock
      471              where buf_gds-grp.upper-code = p-start-node-code
      472           on error undo, return error
      473           :
      474               run grplib-is-terminal in this-procedure (
      475                     input buf_gds-grp.node-code
      476                   , output v-is-terminal
      477               ).
      478               if v-is-terminal = yes
      479               then do:
      480                   create temp_grplib_found-grp.
      481                   assign
      482                       temp_grplib_found-grp.full-name   = right-trim(v-start-full-name, chr(47)) +
      483                                                           chr(47) + buf_gds-grp.node-name + chr(47)
      484                       temp_grplib_found-grp.sort-name   = right-trim(v-start-sort-name, chr(2)) +
      485                                                           chr(2) + buf_gds-grp.node-name + chr(2)
      486                       temp_grplib_found-grp.node-code   = buf_gds-grp.node-code
      487                       temp_grplib_found-grp.is-terminal = yes
      488                   .
      489               end.
      490               else do:
      491                   create temp_found-result-nodelist.
      492                   assign
      493                       temp_found-result-nodelist.node-code = buf_gds-grp.node-code
      494                       temp_found-result-nodelist.full-name = right-trim(v-start-full-name, chr(47)) +
      495                                                              chr(47) + buf_gds-grp.node-name + chr(47)
      496                       temp_found-result-nodelist.sort-name = right-trim(v-start-sort-name, chr(2)) +
      497                                                              chr(2) + buf_gds-grp.node-name + chr(2)
      498                       temp_found-result-nodelist.processed = no
      499                   .
      500                   if p-terminal-only = no
      501                   then do:
      502                       create temp_grplib_found-grp.
      503                       assign
      504                           temp_grplib_found-grp.full-name   = right-trim(v-start-full-name, chr(47)) +
      505                                                               chr(47) + buf_gds-grp.node-name + chr(47)
      506                           temp_grplib_found-grp.sort-name   = right-trim(v-start-sort-name, chr(2)) +
      507                                                               chr(2) + buf_gds-grp.node-name + chr(2)
      508                           temp_grplib_found-grp.node-code   = buf_gds-grp.node-code
      509                           temp_grplib_found-grp.is-terminal = no
      510                       .
      511                   end.
      512               end.
      513           end.
      514           find first temp_found-result-nodelist
      515                where temp_found-result-nodelist.processed = no
      516           no-error.
      517           if not available temp_found-result-nodelist
      518           then do:
      519               leave process-nodes.
      520           end.
      521           else do:
      522               assign
      523                   p-start-node-code = temp_found-result-nodelist.node-code
      524                   v-start-full-name = temp_found-result-nodelist.full-name
      525                   v-start-sort-name = temp_found-result-nodelist.sort-name
      526               .
      527           end.
      528       end.
      529   end.
      530   end procedure.
      531   procedure grplib-expand-name :
      532   define input parameter p-start-name as character        no-undo.
      533   define output parameter p-end-name  as character        no-undo.
      534       define variable v-is-terminal   as logical      no-undo.
      535       define variable v-found         as character    no-undo.
      536       define buffer buf_temp_grplib_found-grp     for temp_grplib_found-grp.
      537   do
      538   for buf_temp_grplib_found-grp
      539   on error undo, return error
      540   :
      541       run grplib-find-grp-by-full-name in this-procedure (
      542             input p-start-name
      543           , input no
      544           , output v-found
      545       ) no-error.
      546       run grplib-get-max-substring in this-procedure (
      547                   input length( p-start-name )
      548                 , output p-end-name
      549       ) no-error .
      550       if error-status :error
      551       then do:
      552           assign
      553               p-end-name = ""
      554           .
      555       end.
      556       else do:
      557           find first temp_grplib_found-grp
      558               where temp_grplib_found-grp.full-name = p-end-name
      559           no-error.
      560           if available temp_grplib_found-grp
      561           then do:
      562               find first buf_temp_grplib_found-grp
      563                   where buf_temp_grplib_found-grp.full-name begins p-end-name
      564                   and recid( buf_temp_grplib_found-grp ) <> recid( temp_grplib_found-grp )
      565               no-error.
      566               if not available buf_temp_grplib_found-grp
      567               then do:
      568                   run grplib-is-terminal in this-procedure (
      569                       input temp_grplib_found-grp.node-code
      570                       , output v-is-terminal
      571                   ).
      572               end.
      573           end.
      574       end.
      575   end.
      576   end procedure.
      577   procedure grplib-get-max-substring :
      578   do
      579   on error undo, return error
      580   :
      581   define input parameter p-min-substring-length   as integer      no-undo.
      582   define output parameter p-substring             as character    no-undo.
      583           define variable v-char-counter  as integer           no-undo.
      584           define variable v-current-char  as character         no-undo.
      585           define variable v-names-counter  as integer           no-undo.
      586           define variable v-base-string   as character         no-undo.
      587           assign
      588               v-char-counter  = p-min-substring-length
      589           .
      590           find first temp_grplib_found-grp no-error.
      591           if not available temp_grplib_found-grp
      592           then do:
      593               undo, return error "grplib-get-max-substring: Нет строк для вычисления общей подстроки".
      594           end.
      595           else do:
      596               assign
      597                   v-base-string  = temp_grplib_found-grp.full-name
      598                   v-char-counter = 0
      599               .
      600               counter-block:
      601               do while yes
      602               on error undo, return error "grplib-get-max-substring: Ошибка вычисления продолжения имени группы."
      603               :
      604                   assign
      605                       v-char-counter  = v-char-counter + 1
      606                       v-current-char  = substring( v-base-string, v-char-counter, 1 )
      607                       v-names-counter = 0
      608                   .
      609                   compare-block:
      610                   for each temp_grplib_found-grp
      611                   :
      612                       assign
      613                           v-names-counter = v-names-counter + 1
      614                       .
      615                       if v-names-counter = 1
      616                       then do:
      617                           next compare-block.
      618                       end.
      619                       if substring( temp_grplib_found-grp.full-name, v-char-counter, 1 ) <> v-current-char
      620                       then do:
      621                           leave counter-block.
      622                       end.
      623                   end.
      624                   if v-names-counter = 1
      625                   then do:
      626                       assign
      627                           p-substring = v-base-string
      628                       .
      629                       return.
      630                   end.
      631               end.
      632               assign
      633                   p-substring = substring( v-base-string, 1, v-char-counter - 1 )
      634               .
      635           end.
      636   end.
      637   end procedure.
      638   procedure grplib-is-terminal :
      639   do
      640   on error undo, return error "Ошибка процедуры grplib-is-terminal"
      641   :
      642   define input parameter p-node-code      as integer      no-undo.
      643   define output parameter p-is-terminal   as logical      no-undo.
      644       define buffer buf_gds-grp       for ub.gds-grp.
      645       find first buf_gds-grp no-lock
      646           where buf_gds-grp.upper-code = p-node-code
      647       no-error .
      648       if not available buf_gds-grp
      649       then do:
      650           assign
      651               p-is-terminal = yes
      652           .
      653       end.
      654       else do:
      655           assign
      656               p-is-terminal = no
      657           .
      658       end.
      659   end.
      660   end procedure.
      661   procedure grplib-have-goods :
      662   do
      663   on error undo, return error
      664   :
      665   define input parameter p-node-code      as integer      no-undo.
      666   define output parameter p-have-goods   as logical      no-undo.
      667       define buffer buf_goods         for ub.goods.
      668       find first buf_goods no-lock
      669            where buf_goods.grp-code = p-node-code
      670       no-error .
      671       if available buf_goods
      672       then do:
      673           assign
      674               p-have-goods = yes
      675           .
      676       end.
      677       else do:
      678           assign
      679               p-have-goods = no
      680           .
      681       end.
      682   end.
      683   end procedure.
      684   procedure grplib-find-by-substring :
      685   do
      686   on error undo, return error
      687   :
      688   define input parameter p-start-code         as integer      no-undo.
      689   define input parameter p-full-search-string as character    no-undo.
      690   define output parameter p-found-code        as integer      no-undo.
      691   define output parameter p-full-name         as character    no-undo.
      692       define variable v-start-code     as integer           no-undo.
      693       define variable v-found          as logical  init no  no-undo.
      694       define buffer buf_gds-grp       for ub.gds-grp.
      695       search-grp:
      696       for each buf_gds-grp no-lock
      697           where buf_gds-grp.node-code > p-start-code
      698       :
      699           if index( buf_gds-grp.node-name, p-full-search-string ) <> 0
      700           then do:
      701               assign
      702                   p-found-code = buf_gds-grp.node-code
      703                   v-found      = yes
      704               .
      705               run grplib-get-full-name in this-procedure (
      706                     input p-found-code
      707                   , output p-full-name
      708               ) no-error .
      709               if error-status :error
      710               then do:
      711                   undo, return error "grplib-find-by-substring: Ошибка вычисления полного имени группы." + chr(10) + return-value.
      712               end.
      713               leave search-grp.
      714           end.
      715       end.
      716       if v-found = yes
      717       then do:
      718       end.
      719       else do:
      720           assign
      721               p-full-name  = ""
      722               p-found-code = 0
      723           .
      724       end.
      725   end.
      726   end procedure.
      727   procedure grplib-analyze-grp-name :
      728   do
      729   on error undo, return error
      730   :
      731   define input parameter p-grp-name       as character            no-undo.
      732   define input parameter p-upper-code     as integer              no-undo.
      733   define output parameter p-error-message as character init ""    no-undo.
      734       define variable v-char-list     as character    no-undo.
      735       define variable v-char-counter  as integer      no-undo.
      736       define variable v-full-name     as character    no-undo.
      737       if p-grp-name = "" then do:
      738           assign
      739               p-error-message = "Название группы не может быть пустым.".
      740           .
      741       end.
      742       else do:
      743           assign
      744               v-char-list = "47,92,58,63,34,60,62,171,187,183"
      745           .
      746           do v-char-counter = 1 to num-entries( v-char-list )
      747           :
      748               if index( p-grp-name, chr( integer( entry( v-char-counter, v-char-list ) ) ) ) <> 0
      749               then do:
      750                   assign
      751                       p-error-message = 'Название группы не может содержать символы /\:*?"<>|«»·'
      752                   .
      753                   return.
      754               end.
      755           end.
      756           if p-upper-code > 0
      757           then do:
      758               run grplib-get-full-name in this-procedure (
      759                     input p-upper-code
      760                   , output v-full-name
      761               ) no-error .
      762               if error-status :error
      763               then do:
      764                   undo, return error "grplib-analyze-grp-name: Не удалось вычислить полное имя группы." + chr(10) + return-value.
      765               end.
      766               if length( v-full-name ) + 1 + length( p-grp-name ) > 350
      767               then do:
      768                   assign
      769                       p-error-message = 'Полное название группы не может содержать более 350 символов.'
      770                   .
      771               end.
      772           end.
      773       end.
      774   end.
      775   end procedure.
      776   procedure grplib-get-lvl-num :
      777   define input parameter p-node-code  as integer      no-undo.
      778   define output parameter p-lvl-num   as integer      no-undo.
      779       define variable v-full-name    as character    no-undo.
      780   do
      781   on error undo, return error
      782   :
      783       run grplib-get-full-name in this-procedure (
      784             input p-node-code
      785           , output v-full-name
      786       ).
      787       assign
      788           p-lvl-num = num-entries( v-full-name, chr(47) ) - 1
      789       .
      790       if p-lvl-num = -1
      791       then do:
      792           assign
      793               p-lvl-num = 0
      794           .
      795       end.
      796   end.
      797   end procedure.
      798   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      799   procedure grp-obj-write :
      800   do
      801   on error undo, return error
      802   :
      803   define input parameter p-node-code  like ub.gds-grp-obj.node-code      no-undo.
      804   define input parameter p-host-code  as integer                          no-undo.
      805   define input parameter p-obj-type   like ub.clients.obj-type            no-undo.
      806   define input parameter p-obj-code   like ub.clients.obj-code            no-undo.
      807   define input parameter p-min-increase like ub.gds-grp-obj.min-increase  no-undo.
      808   define input parameter p-max-increase like ub.gds-grp-obj.max-increase  no-undo.
      809   define input parameter p-increase-pc like ub.gds-grp-obj.increase-pc  no-undo.
      810   define input parameter p-calc-method like ub.gds-grp-obj.calc-method no-undo .
      811   define input parameter p-round-method like ub.gds-grp-obj.round-method no-undo .
      812   define input parameter p-round-coef like ub.gds-grp-obj.round-coef no-undo .
      813   define input parameter p-cli-type   like ub.clients.obj-type            no-undo.
      814   define input parameter p-cli-code   like ub.clients.obj-code            no-undo.
      815   define buffer buf_gds-grp-obj for ub.gds-grp-obj.
      816       find first buf_gds-grp-obj exclusive-lock
      817            where buf_gds-grp-obj.node-code  = p-node-code
      818              and buf_gds-grp-obj.host-code  = p-host-code
      819              and buf_gds-grp-obj.obj-type   = p-obj-type
      820              and buf_gds-grp-obj.obj-code   = p-obj-code
      821       no-error.
      822       if not available buf_gds-grp-obj
      823       then do:
      824           create buf_gds-grp-obj.
      825           assign
      826                   buf_gds-grp-obj.node-code  = p-node-code
      827                   buf_gds-grp-obj.host-code  = p-host-code
      828                   buf_gds-grp-obj.obj-type   = p-obj-type
      829                   buf_gds-grp-obj.obj-code   = p-obj-code
      830           .
      831       end.
      832       assign
      833       buf_gds-grp-obj.min-increase = p-min-increase
      834       buf_gds-grp-obj.max-increase = p-max-increase
      835       buf_gds-grp-obj.increase-pc = p-increase-pc
      836       buf_gds-grp-obj.calc-method = p-calc-method
      837       buf_gds-grp-obj.round-method = p-round-method
      838       buf_gds-grp-obj.round-coef = p-round-coef
      839       buf_gds-grp-obj.cli-type   = p-cli-type
      840       buf_gds-grp-obj.cli-code   = p-cli-code
      841       .
      842   end.
      843   end procedure.
      844   procedure grp-obj-margin-value :
      845   do
      846   on error undo, return error
      847   :
      848   define input parameter p-node-code as integer      no-undo.
      849   define input parameter p-obj-type  as character    no-undo.
      850   define input parameter p-obj-code  as integer      no-undo.
      851   define output parameter p-min-value as decimal      no-undo init ?.
      852   define output parameter p-max-value as decimal      no-undo init ?.
      853   define output parameter p-increase-pc as decimal      no-undo init ?.
      854   define output parameter p-round-method as character no-undo init "":U.
      855   define output parameter p-base as decimal no-undo init ?.
      856   define output parameter p-range-margin     as integer      no-undo.
      857   define output parameter p-exists-margin    as logical      no-undo.
      858   define output parameter p-range-increase     as integer      no-undo.
      859   define output parameter p-exists-increase    as logical      no-undo.
      860   define output parameter p-range-rmethod     as integer no-undo .
      861   define output parameter p-exists-rmethod    as logical no-undo .
      862   define variable v-host-code as integer      no-undo.
      863   DEFINE VARIABLE v-found as logical no-undo .
      864   DEFINE VARIABLE v-exists as logical no-undo .
      865   DEFINE VARIABLE v-range as integer no-undo .
      866   DEFINE VARIABLE jj as integer no-undo .
      867   DEFINE VARIABLE v-margin-found as logical no-undo .
      868   DEFINE VARIABLE v-increase-found as logical no-undo .
      869   DEFINE VARIABLE v-min-value as decimal      no-undo.
      870   DEFINE VARIABLE v-max-value as decimal      no-undo.
      871   DEFINE VARIABLE v-increase-pc as decimal      no-undo.
      872   define variable v-round-method as character no-undo .
      873   define variable v-base as decimal no-undo .
      874   define variable v-print-code as character no-undo .
      875   define buffer buf_gds-grp for ub.gds-grp.
      876   find first buf_gds-grp no-lock where
      877              buf_gds-grp.node-code = p-node-code no-error .
      878   if not avail buf_gds-grp and p-node-code <> 0 then do:
      879     message
      880       vss-workfile vss-revision vss-description
      881       skip "Не удалось найти группу товаров с кодом" p-node-code
      882       view-as alert-box error .
      883     undo, return error .
      884   end.
      885   if p-obj-type <> '' then do:
      886   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      887   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      888     (input  p-obj-type
      889     ,input  p-obj-code
      890     ,output v-host-code
      891     ) no-error .
      892     if error-status :error
      893     then do:
      894         message
      895           vss-workfile vss-revision vss-description
      896           skip "Не удалось найти фирму объекта"
      897           skip p-obj-type p-obj-code
      898           skip return-value
      899           skip trim(error-status :get-message(1))
      900               trim(error-status :get-message(2))
      901               trim(error-status :get-message(3))
      902               trim(error-status :get-message(4))
      903               trim(error-status :get-message(5))
      904         view-as alert-box error.
      905         undo, return error .
      906     end.
      907   end.
      908   define buffer buf_gds-grp-obj      for ub.gds-grp-obj.
      909   do while v-found = no and jj < 2:
      910     if v-range <> 3 then do:
      911       find first buf_gds-grp-obj no-lock
      912           where buf_gds-grp-obj.node-code = p-node-code
      913             and buf_gds-grp-obj.host-code = v-host-code
      914             and buf_gds-grp-obj.obj-type  = p-obj-type
      915             and buf_gds-grp-obj.obj-code  = p-obj-code
      916       no-error .
      917     end.
      918     if v-range = 3 or not available buf_gds-grp-obj
      919     then do:
      920        if v-range <> 2 then do:
      921           find first buf_gds-grp-obj no-lock
      922               where buf_gds-grp-obj.node-code = p-node-code
      923                 and buf_gds-grp-obj.host-code = v-host-code
      924                 and buf_gds-grp-obj.obj-type  = ""
      925                 and buf_gds-grp-obj.obj-code  = 0
      926           no-error .
      927         end.
      928         if v-range = 2 or not available buf_gds-grp-obj
      929         then do:
      930             if v-range <> 1 then do:
      931               find first buf_gds-grp-obj no-lock
      932                   where buf_gds-grp-obj.node-code = p-node-code
      933                   and buf_gds-grp-obj.host-code = 0
      934                   and buf_gds-grp-obj.obj-type  = ""
      935                   and buf_gds-grp-obj.obj-code  = 0
      936               no-error .
      937             end.
      938             if v-range = 1 or not available buf_gds-grp-obj
      939             then do:
      940                 assign
      941                     v-exists = no
      942                 .
      943             end.
      944             else do:
      945                 assign
      946                     v-exists = yes
      947                     v-range = 1
      948                 .
      949             end.
      950         end.
      951         else do:
      952             assign
      953                 v-exists = yes
      954                 v-range  = 2
      955             .
      956         end.
      957     end.
      958     else do:
      959         assign
      960             v-exists = yes
      961             v-range  = 3
      962         .
      963     end.
      964     if available buf_gds-grp-obj
      965     then do:
      966       assign
      967       v-min-value    = buf_gds-grp-obj.min-increase
      968       v-max-value    = buf_gds-grp-obj.max-increase
      969       v-increase-pc  = buf_gds-grp-obj.increase-pc
      970       v-round-method = buf_gds-grp-obj.round-method
      971       v-base         = buf_gds-grp-obj.round-coef
      972       .
      973       assign
      974       p-exists-margin = (if v-min-value <> ? and v-max-value <> ? and p-min-value = ?
      975                           then yes
      976                           else p-exists-margin)
      977       p-range-margin = if p-exists-margin and p-min-value = ?
      978                         then v-range
      979                         else p-range-margin
      980       p-min-value   =  if p-exists-margin and  p-min-value = ?
      981                         then v-min-value
      982                         else p-min-value
      983       p-max-value   =  if p-exists-margin and  p-max-value = ?
      984                         then v-max-value
      985                         else p-max-value
      986       p-exists-increase = (if v-increase-pc <> ? and p-increase-pc = ?
      987                           then yes
      988                           else p-exists-increase)
      989       p-range-increase = if p-exists-increase and p-increase-pc = ?
      990                         then v-range
      991                         else p-range-increase
      992       p-increase-pc = (if p-exists-increase and p-increase-pc = ?
      993                         then v-increase-pc
      994                         else p-increase-pc)
      995       p-exists-rmethod = if v-round-method <> "":U and p-round-method = "":U
      996                           then yes
      997                           else p-exists-rmethod
      998       p-range-rmethod = (if p-exists-rmethod and p-round-method = "":U
      999                           then v-range
     1000                           else p-range-rmethod)
     1001       p-round-method  = (if p-exists-rmethod and p-round-method = "":U
     1002                           then v-round-method
     1003                           else p-round-method)
     1004       p-base          = (if p-exists-rmethod and p-base = ?
     1005                           then v-base
     1006                           else p-base)
     1007       v-found =  (p-exists-margin and p-exists-increase and p-exists-rmethod) or (v-range <= 1)
     1008       jj = jj + 1
     1009       .
     1010     end.
     1011     else do:
     1012       assign
     1013       v-found =  (p-exists-margin and p-exists-increase and p-exists-rmethod ) or (v-range <= 1)
     1014       jj = jj + 1
     1015       .
     1016     end.
     1017   end.
     1018   end.
     1019   end procedure.
     1020   procedure grp-obj-income-cli-value :
     1021   do
     1022   on error undo, return error
     1023   :
     1024   define input parameter p-node-code as integer      no-undo.
     1025   define input parameter p-obj-type  as character    no-undo.
     1026   define input parameter p-obj-code  as integer      no-undo.
     1027   define output parameter p-cli-type as character    no-undo init ?.
     1028   define output parameter p-cli-code as integer      no-undo init ?.
     1029   define output parameter p-range-income-cli     as integer      no-undo.
     1030   define output parameter p-exists-income-cli    as logical      no-undo.
     1031   define variable v-host-code as integer      no-undo.
     1032   DEFINE VARIABLE v-found as logical no-undo .
     1033   DEFINE VARIABLE v-exists as logical no-undo .
     1034   DEFINE VARIABLE v-range as integer no-undo .
     1035   DEFINE VARIABLE jj as integer no-undo .
     1036   DEFINE VARIABLE v-income-cli-found as logical no-undo .
     1037   DEFINE VARIABLE v-cli-type-value as char      no-undo.
     1038   DEFINE VARIABLE v-cli-code-value as int      no-undo.
     1039   define buffer buf_gds-grp for ub.gds-grp.
     1040   find first buf_gds-grp no-lock where
     1041              buf_gds-grp.node-code = p-node-code no-error .
     1042   if not avail buf_gds-grp and p-node-code <> 0 then do:
     1043     message
     1044       vss-workfile vss-revision vss-description
     1045       skip "Не удалось найти группу товаров с кодом" p-node-code
     1046       view-as alert-box error .
     1047     undo, return error .
     1048   end.
     1049   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1050   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1051     (input  p-obj-type
     1052     ,input  p-obj-code
     1053     ,output v-host-code
     1054     ) no-error .
     1055   if error-status :error
     1056   then do:
     1057       message
     1058         vss-workfile vss-revision vss-description
     1059         skip "Не удалось найти фирму объекта"
     1060         skip p-obj-type p-obj-code
     1061         skip return-value
     1062         skip trim(error-status :get-message(1))
     1063              trim(error-status :get-message(2))
     1064              trim(error-status :get-message(3))
     1065              trim(error-status :get-message(4))
     1066              trim(error-status :get-message(5))
     1067       view-as alert-box error.
     1068       undo, return error .
     1069   end.
     1070   define buffer buf_gds-grp-obj      for ub.gds-grp-obj.
     1071   do while v-found = no and jj < 2:
     1072     if v-range <> 3 then do:
     1073       find first buf_gds-grp-obj no-lock
     1074           where buf_gds-grp-obj.node-code = p-node-code
     1075             and buf_gds-grp-obj.host-code = v-host-code
     1076             and buf_gds-grp-obj.obj-type  = p-obj-type
     1077             and buf_gds-grp-obj.obj-code  = p-obj-code
     1078       no-error .
     1079     end.
     1080     if v-range = 3 or not available buf_gds-grp-obj
     1081     then do:
     1082        if v-range <> 2 then do:
     1083           find first buf_gds-grp-obj no-lock
     1084               where buf_gds-grp-obj.node-code = p-node-code
     1085                 and buf_gds-grp-obj.host-code = v-host-code
     1086                 and buf_gds-grp-obj.obj-type  = ""
     1087                 and buf_gds-grp-obj.obj-code  = 0
     1088           no-error .
     1089         end.
     1090         if v-range = 2 or not available buf_gds-grp-obj
     1091         then do:
     1092             if v-range <> 1 then do:
     1093               find first buf_gds-grp-obj no-lock
     1094                   where buf_gds-grp-obj.node-code = p-node-code
     1095                   and buf_gds-grp-obj.host-code = 0
     1096                   and buf_gds-grp-obj.obj-type  = ""
     1097                   and buf_gds-grp-obj.obj-code  = 0
     1098               no-error .
     1099             end.
     1100             if v-range = 1 or not available buf_gds-grp-obj
     1101             then do:
     1102                 assign
     1103                     v-exists = no
     1104                 .
     1105             end.
     1106             else do:
     1107                 assign
     1108                     v-exists = yes
     1109                     v-range = 1
     1110                 .
     1111             end.
     1112         end.
     1113         else do:
     1114             assign
     1115                 v-exists = yes
     1116                 v-range  = 2
     1117             .
     1118         end.
     1119     end.
     1120     else do:
     1121         assign
     1122             v-exists = yes
     1123             v-range  = 3
     1124         .
     1125     end.
     1126     if available buf_gds-grp-obj
     1127     then do:
     1128       assign
     1129       v-cli-type-value    = buf_gds-grp-obj.cli-type
     1130       v-cli-code-value    = buf_gds-grp-obj.cli-code
     1131       .
     1132       assign
     1133       p-exists-income-cli = (if v-cli-type-value <> ? and v-cli-code-value <> ? and p-cli-type = ?
     1134                           then yes
     1135                           else p-exists-income-cli)
     1136       p-range-income-cli = if p-exists-income-cli and p-cli-type = ?
     1137                         then v-range
     1138                         else p-range-income-cli
     1139       p-cli-type   =  if p-exists-income-cli and  p-cli-type = ?
     1140                         then v-cli-type-value
     1141                         else p-cli-type
     1142       p-cli-code   =  if p-exists-income-cli and  p-cli-code = ?
     1143                         then v-cli-code-value
     1144                         else p-cli-code
     1145       v-found =  (p-exists-income-cli ) or (v-range <= 1)
     1146       jj = jj + 1
     1147       .
     1148     end.
     1149     else do:
     1150       assign
     1151       v-found =  (p-exists-income-cli  ) or (v-range <= 1)
     1152       jj = jj + 1
     1153       .
     1154     end.
     1155   end.
     1156   end.
     1157   end procedure.
     1158   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1159   procedure cur-time :
     1160      define output parameter p-today as date      no-undo .
     1161      define output parameter p-time  as integer   no-undo .
     1162     do
     1163     on error undo, return error
     1164     :
     1165       define variable v-date1 as date      no-undo .
     1166       define variable v-date2 as date      no-undo .
     1167       define variable v-time  as integer   no-undo .
     1168       assign
     1169         v-date1 = today
     1170         v-time  = time
     1171         v-date2 = today
     1172       .
     1173       if v-date1 <> v-date2
     1174       then do:
     1175         assign
     1176           v-date1 = today
     1177           v-time  = v-time
     1178         .
     1179       end.
     1180       assign
     1181         p-today = v-date1
     1182         p-time  = v-time
     1183       .
     1184     end.
     1185   end.
     1186   function cur-time-date returns character
     1187   :
     1188     return string(today, '99/99/9999':U) .
     1189   end.
     1190   function cur-time-mjd returns decimal
     1191   :
     1192     define variable v-date as date      no-undo .
     1193     define variable v-time as integer   no-undo .
     1194     run cur-time in this-procedure
     1195       (output v-date
     1196       ,output v-time
     1197       ) .
     1198     return integer(v-date) - 2400002 + (v-time / 86400) .
     1199   end.
     1200   function cur-time-get-ending-index returns integer
     1201   (input p-number as integer
     1202   )
     1203   :
     1204     if p-number < 0
     1205     or p-number = ?
     1206     then do:
     1207       return 1 .
     1208     end.
     1209     define variable v-rest as integer   no-undo .
     1210     assign
     1211       p-number = p-number modulo 100
     1212     .
     1213     if p-number < 20
     1214     then do:
     1215       assign
     1216         v-rest = p-number
     1217       .
     1218     end.
     1219     else do:
     1220       assign
     1221         v-rest = p-number modulo 10
     1222       .
     1223     end.
     1224     case v-rest :
     1225       when 1
     1226       then do:
     1227         return 2 .
     1228       end.
     1229       when 2 or
     1230       when 3 or
     1231       when 4
     1232       then do:
     1233         return 3 .
     1234       end.
     1235       otherwise do:
     1236         return 1 .
     1237       end.
     1238     end case .
     1239   end.
     1240   procedure cur-time-mjd-to-date :
     1241      define input  parameter i-mjd-diff as decimal no-undo.
     1242      define output parameter o-Date     as date    no-undo.
     1243      define output parameter o-Time     as integer no-undo.
     1244      define variable v-day-number as integer   no-undo .
     1245      if    i-mjd-diff < 0
     1246         or i-mjd-diff = ?
     1247      then do:
     1248         return "?" .
     1249      end.
     1250      assign
     1251         v-day-number = truncate(i-mjd-diff,0).
     1252         o-Date = date(v-day-number + 2400002).
     1253         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
     1254     .
     1255   end.
     1256   function cur-time-mjd-to-string returns character
     1257   (input p-mjd-diff as decimal
     1258   )
     1259   :
     1260     define variable v-day-number as integer   no-undo .
     1261     define variable v-seconds    as integer   no-undo .
     1262     define variable v-hour       as integer   no-undo .
     1263     define variable v-min        as integer   no-undo .
     1264     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
     1265     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
     1266     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
     1267     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
     1268     if p-mjd-diff < 0
     1269     or p-mjd-diff = ?
     1270     then do:
     1271       return "?" .
     1272     end.
     1273     assign
     1274       v-day-number = integer(truncate(p-mjd-diff,0))
     1275       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     1276     .
     1277     if v-seconds > 86400
     1278     then do:
     1279       assign
     1280         v-seconds = 86400 - 1
     1281       .
     1282     end.
     1283     if v-seconds < 0
     1284     then do:
     1285       assign
     1286         v-seconds = 0
     1287       .
     1288     end.
     1289     assign
     1290       v-hour = truncate(v-seconds / 3600, 0)
     1291     .
     1292     assign
     1293       v-seconds = v-seconds modulo 3600
     1294     .
     1295     assign
     1296       v-min = truncate(v-seconds / 60, 0)
     1297     .
     1298     assign
     1299       v-seconds = v-seconds modulo 60
     1300     .
     1301     return
     1302         (if v-day-number <> 0
     1303           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     1304           else ""
     1305         )
     1306       + (if v-day-number <> 0 or v-hour <> 0
     1307           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     1308           else ""
     1309         )
     1310       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     1311           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     1312           else ""
     1313         )
     1314       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     1315       .
     1316   end.
     1317   function cur-time-string returns character
     1318   :
     1319     define variable v-date as date      no-undo .
     1320     define variable v-time as integer   no-undo .
     1321     run cur-time in this-procedure
     1322       (output v-date
     1323       ,output v-time
     1324       ) .
     1325     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     1326   end.
     1327   function cur-time-string-sec returns character
     1328   :
     1329     define variable v-date as date      no-undo .
     1330     define variable v-time as integer   no-undo .
     1331     run cur-time in this-procedure
     1332       (output v-date
     1333       ,output v-time
     1334       ) .
     1335     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     1336   end.
     1337   function cur-time-custom  returns character
     1338   (input p-prefix as character
     1339   ,input p-date-format as character
     1340   ,input p-delimiter as character
     1341   ,input p-time-format as character
     1342   ,input p-suffix as character
     1343   )
     1344   :
     1345     define variable v-date as date      no-undo .
     1346     define variable v-time as integer   no-undo .
     1347     run cur-time in this-procedure
     1348       (output v-date
     1349       ,output v-time
     1350       ) .
     1351     return
     1352       p-prefix
     1353       + string(v-date, p-date-format)
     1354       + p-delimiter
     1355       + string(v-time, p-time-format)
     1356       + p-suffix
     1357       .
     1358   end.
     1359   function cur-time-print  returns character
     1360   :
     1361     define variable v-date as date      no-undo .
     1362     define variable v-time as integer   no-undo .
     1363     run cur-time in this-procedure
     1364       (output v-date
     1365       ,output v-time
     1366       ) .
     1367     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     1368   end.
     1369   function cur-time-datetime returns datetime
     1370   :
     1371     define variable v-char as character no-undo .
     1372     define variable v-datetime as datetime no-undo .
     1373     v-char = cur-time-string().
     1374     v-datetime = datetime(v-char).
     1375     return  v-datetime.
     1376   end.
     1377   function cur-time-string-msec returns character
     1378   :
     1379     define variable v-date as datetime  no-undo .
     1380     v-date = now.
     1381     return string(v-date) .
     1382   end.
     1383     define NEW SHARED temp-table  tt-tax no-undo
