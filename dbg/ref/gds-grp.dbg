     3649                 skip "Не удалось раскрыть подуровни группы."
     3650                 skip return-value
     3651                 skip trim(error-status :get-message(1))
     3652                      trim(error-status :get-message(2))
     3653                      trim(error-status :get-message(3))
     3654                      trim(error-status :get-message(4))
     3655                      trim(error-status :get-message(5))
     3656               view-as alert-box error.
     3657               undo, return no-apply .
     3658           end.
     3659       end.
     3660   END.
     3661   ON - OF br-list IN FRAME Dlg-grp
     3662   DO:
     3663       if temp_grplib_grp.mark = "«"
     3664       then do:
     3665           run collapse-item in this-procedure ( input temp_grplib_grp.node-code, input yes ) no-error .
     3666           if error-status :error
     3667           then do:
     3668               message
     3669                 vss-workfile vss-revision vss-description
     3670                 skip "Не удалось закрыть подуровни группы."
     3671                 skip return-value
     3672                 skip trim(error-status :get-message(1))
     3673                      trim(error-status :get-message(2))
     3674                      trim(error-status :get-message(3))
     3675                      trim(error-status :get-message(4))
