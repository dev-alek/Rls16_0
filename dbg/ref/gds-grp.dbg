     2394   procedure prn-lib-reportviewer :
     2395     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     2396     define input parameter p-report-name-html as character no-undo .
     2397     define input parameter p-param        as character no-undo .
     2398     define variable v-excel           as character no-undo init 'TRUE' .
     2399     define variable v-value-character as character no-undo .
     2400     define variable v-value-integer   as character no-undo .
     2401     define variable v-value-date      as date      no-undo .
     2402     define variable v-value-decimal   as decimal   no-undo .
     2403     define variable rep-excel         as logical   no-undo .
     2404     define variable excel-string      as character no-undo .
     2405     define variable v-param-type      as character no-undo .
     2406     define variable v-tth             as handle    no-undo .
     2407     run adm/shattri.p (
     2408       input "get":U
     2409       ,input  ""
     2410       ,input  0
     2411       ,input  'report-glob':U
     2412       ,input  'rep-excel':U
     2413       ,output v-value-character
     2414       ,output v-value-date
     2415       ,output v-value-decimal
     2416       ,output v-value-integer
     2417       ,output rep-excel
     2418       ,output v-param-type
     2419       ,INPUT-OUTPUT table-handle v-tth
     2420       )  .
     2421     if rep-excel then v-excel = "TRUE" .
     2422     else v-excel = "FALSE" .
     2423     if p-param eq ""
     2424     then
     2425        p-param = "EXCEL:" + v-excel.
     2426     else
     2427        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
     2428     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
     2429   end procedure.
