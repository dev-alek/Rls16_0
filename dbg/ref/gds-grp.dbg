     3183           b-search :label = "Поиск"
     3184       .
     3185   END.
     3186   ON CHOOSE OF b-find-by-substring IN FRAME Dlg-grp
     3187   DO:
     3188       define variable v-new-name      as character    no-undo.
     3189       define variable v-new-code      as integer      no-undo.
     3190       define variable v-err-message   as character    no-undo.
     3191       if v-full-search-next = no
     3192       then do:
     3193           assign
     3194               v-full-search-string     = fi-search :screen-value
     3195               v-full-search-next       = yes
     3196               v-full-search-start-code = 0
     3197           .
     3198       end.
     3199       run grplib-analyze-grp-name in this-procedure (
     3200             input v-full-search-string
     3201           , input -1
     3202           , output v-err-message
     3203       ).
     3204       if v-err-message = "":U
     3205       then do:
     3206   if session :set-wait-state( "compiler" ) then.
     3207           run grplib-find-by-substring in this-procedure (
     3208               input v-full-search-start-code
     3209               , input v-full-search-string
     3210               , output v-new-code
     3211               , output v-new-name
     3212           ) no-error.
     3213           if error-status :error
     3214           then do:
     3215   if session :set-wait-state( "" ) then.
     3216               message return-value.
     3217               undo, return no-apply.
     3218           end.
     3219   if session :set-wait-state( "" ) then.
     3220           if v-new-code = 0
     3221           then do:
     3222               message
     3223                   skip "Не найдена строка '" v-full-search-string "' в имени группы."
     3224               view-as alert-box information
     3225               title "Поиск завершен".
     3226               assign
     3227                   v-new-name               = fi-search :screen-value
     3228                   v-full-search-string     = ""
     3229                   v-full-search-next       = no
     3230                   v-full-search-start-code = 0
     3231               .
     3232           end.
     3233           else do:
     3234               assign
     3235                   v-full-search-start-code = v-new-code
     3236               .
     3237           end.
     3238           assign
     3239               fi-search :screen-value  = right-trim( v-new-name, chr(47) )
     3240               fi-search :cursor-offset = length( v-new-name ) + 1
     3241           .
     3242       end.
     3243       else do:
     3244           message
     3245               v-err-message
     3246               skip(1)
     3247               "Поиск в названиях групп производится по подстроке,"
     3248               skip "введённой в поле названия группы."
     3249           view-as alert-box information.
     3250       end.
     3251   END.
