     4800         then do:
     4801           undo move_block, retry move_block.
     4802         end.
     4803         for each buf_temp-browse-handle
     4804           where buf_temp-browse-handle.browse-type = 'width':u
     4805         on error undo move_block, retry move_block
     4806         :
     4807           assign
     4808             buf_temp-browse-handle.browse-handle :width
     4809               = buf_temp-browse-handle.browse-handle :width + p-change-value
     4810             no-error .
     4811           if error-status :error
     4812           or error-status :get-message(1) <> ""
     4813           then do:
     4814             undo move_block, retry move_block .
     4815           end.
     4816         end.
     4817         for each buf_temp-diasize-handle
     4818         on error undo move_block, retry move_block
     4819         :
     4820           assign
     4821             v-object-handle = buf_temp-diasize-handle.handle-value
     4822           .
     4823           if v-object-handle <> v-diasize-resize-button
     4824           then do:
     4825             assign
     4826               v-object-handle :col = v-object-handle :col + p-change-value
     4827               no-error .
     4828             if error-status :error
     4829             or error-status :get-message(1) <> ""
     4830             then do:
     4831               undo move_block, retry move_block .
     4832             end.
     4833           end.
     4834         end.
     4835       end.
     4836       else do:
     4837         for each buf_temp-diasize-handle
     4838         on error undo move_block, retry move_block
     4839         :
     4840           assign
     4841             v-object-handle = buf_temp-diasize-handle.handle-value
     4842           .
     4843           if v-object-handle <> v-diasize-resize-button
     4844           then do:
     4845             assign
     4846               v-object-handle :col = v-object-handle :col + p-change-value
     4847               no-error .
     4848             if error-status :error
     4849             or error-status :get-message(1) <> ""
     4850             then do:
     4851               undo move_block, retry move_block .
     4852             end.
     4853           end.
     4854         end.
     4855         for each buf_temp-browse-handle
     4856           where buf_temp-browse-handle.browse-type = 'width':u
     4857         on error undo move_block, retry move_block
     4858         :
     4859           assign
     4860             buf_temp-browse-handle.browse-handle :width
     4861               = buf_temp-browse-handle.browse-handle :width + p-change-value
     4862             no-error .
     4863           if error-status :error
     4864           or error-status :get-message(1) <> ""
     4865           then do:
     4866             undo move_block, retry move_block .
     4867           end.
     4868         end.
     4869         assign
     4870           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     4871           no-error .
     4872         if error-status :error
     4873         or error-status :get-message(1) <> ""
     4874         then do:
     4875           undo move_block, retry move_block.
     4876         end.
     4877         assign
     4878           frame Dlg-grp :width = frame Dlg-grp :width + p-change-value
     4879         no-error .
     4880         if error-status :error
     4881         or error-status :get-message(1) <> ""
     4882         then do:
     4883           undo move_block, retry move_block.
     4884         end.
     4885         if frame Dlg-grp :scrollable = true
     4886         then do:
     4887           assign
     4888             frame Dlg-grp :virtual-width = frame Dlg-grp :virtual-width + p-change-value
     4889           no-error .
     4890           if error-status :error
     4891           or error-status :get-message(1) <> ""
     4892           then do:
     4893             undo move_block, retry move_block.
     4894           end.
     4895         end.
     4896       end.
     4897       if p-move-resize
     4898       then do:
     4899         run diasize_position-resize-button in this-procedure .
     4900       end.
     4901       if v-diasize-wndstore = true
     4902       then do:
     4903         if connected("ub") = true
     4904         then do:
     4905           define variable v-cntxt-db-num        as integer   no-undo .
     4906           define variable v-cntxt-userid        as character no-undo .
     4907           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     4908                                             , OUTPUT v-cntxt-userid
     4909                                             ) .
     4910           run gbl/wndsizew.p
     4911             (input  v-cntxt-db-num
     4912             ,input  v-cntxt-userid
     4913             ,input  v-diasize-proc-name
     4914             ,input  'width':u
     4915             ,input  string(frame Dlg-grp :width - v-diasize-orig-frame-width)
     4916             ) .
     4917         end.
     4918       end.
     4919     end.
     4920     assign
     4921       v-diasize-change-size = false
     4922     .
     4923   end procedure.
     4924   procedure diasize_set-width :
     4925     define input  parameter p-new-width  as decimal   no-undo .
     4926     define input  parameter p-move-resize as logical   no-undo .
     4927     do
     4928     on error undo, return error return-value
     4929     :
     4930       run diasize_change-width in this-procedure
     4931         (input  (p-new-width - frame Dlg-grp :width)
     4932         ,input  p-move-resize
     4933         ) .
     4934     end.
     4935   end procedure.
     4936   procedure diasize_position-resize-button :
     4937     do with frame Dlg-grp
     4938     :
     4939       hide v-diasize-resize-button .
     4940       assign
     4941         v-diasize-resize-button :row = frame Dlg-grp :height - v-diasize-resize-button :height
     4942                     - 1
     4943                     - (frame Dlg-grp :border-bottom-pixels / session :pixels-per-row)
     4944         v-diasize-resize-button :col = frame Dlg-grp :width - v-diasize-resize-button :width
     4945                     - 1
     4946                     - (frame Dlg-grp :border-right-pixels / session :pixels-per-column)
     4947       .
     4948       view v-diasize-resize-button .
     4949     end.
     4950   end procedure.
     4951   on alt-right anywhere
     4952   do:
     4953     run diasize_change-width in this-procedure
     4954       (input 1
     4955       ,input true
     4956       ) .
     4957     return no-apply .
     4958   end.
     4959   on alt-left anywhere
     4960   do:
     4961     run diasize_change-width in this-procedure
     4962       (input -1
     4963       ,input true
     4964       ) .
     4965     return no-apply .
     4966   end.
     4967   on alt-down anywhere
     4968   do:
     4969     run diasize_change-height in this-procedure
     4970       (input 1
     4971       ,input true
     4972       ) .
     4973     return no-apply .
     4974   end.
     4975   on alt-up anywhere
     4976   do:
     4977     run diasize_change-height in this-procedure
     4978       (input -1
     4979       ,input true
     4980       ) .
     4981     return no-apply .
     4982   end.
     4983   on alt-enter of frame Dlg-grp
     4984   do:
     4985     run diasize_maximize in this-procedure
     4986       (input  ?
     4987       ).
     4988     return no-apply .
     4989   end.
     4990   procedure diasize_end-move :
     4991     do
     4992     on error undo, return error return-value
     4993     :
     4994       define variable v-row-delta as decimal   no-undo .
     4995       define variable v-col-delta as decimal   no-undo .
     4996       define variable v-new-row as decimal   no-undo .
     4997       define variable v-new-col as decimal   no-undo .
     4998       assign
     4999         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     5000         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     5001       .
     5002       assign
     5003         v-row-delta = v-new-row - frame Dlg-grp :height
     5004         v-col-delta = v-new-col - frame Dlg-grp :width
     5005       .
     5006       run diasize_change-height in this-procedure
     5007         (input v-row-delta
     5008         ,input true
     5009         ) .
     5010       run diasize_change-width in this-procedure
     5011         (input v-col-delta
     5012         ,input true
     5013         ) .
     5014     end.
     5015   end procedure.
     5016   procedure diasize_maximize :
     5017     define input  parameter p-action as logical   no-undo .
     5018     do
     5019     on error undo, return error return-value
     5020     :
     5021       if p-action = ?
     5022       then do:
     5023         if v-diasize-need-maximize = true
     5024         then do:
     5025           assign
     5026             p-action = true
     5027           .
     5028         end.
     5029         else do:
     5030           assign
     5031             p-action = false
     5032           .
     5033         end.
     5034       end.
     5035       if p-action = true
     5036       then do:
     5037         run diasize_change-height in this-procedure
     5038           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     5039               - frame Dlg-grp :height-chars
     5040           ,input true
     5041           ) .
     5042         run diasize_change-width in this-procedure
     5043           (input session :width-chars
     5044               - frame Dlg-grp :width-chars
     5045           ,input true
     5046           ) .
     5047         assign
     5048           v-diasize-need-maximize = false
     5049         .
     5050       end.
     5051       else do:
     5052         run diasize_change-width in this-procedure
     5053           (input v-diasize-orig-frame-width
     5054               - frame Dlg-grp :width-chars
     5055           ,input true
     5056           ) .
     5057         run diasize_change-height in this-procedure
     5058           (input v-diasize-orig-frame-height
     5059               - frame Dlg-grp :height-chars
     5060           ,input true
     5061           ) .
     5062         assign
     5063           v-diasize-need-maximize = true
     5064         .
     5065       end.
     5066     end.
     5067   end procedure.
     5068   procedure diasize_restore-orig-size :
     5069     do
     5070     on error undo, return error return-value
     5071     :
     5072       assign
     5073         v-diasize-current-frame-width  = frame Dlg-grp :width
     5074         v-diasize-current-frame-height = frame Dlg-grp :height
     5075       .
     5076       run diasize_set-height in this-procedure
     5077         (input  v-diasize-orig-frame-height
     5078         ,input  true
     5079         ) .
     5080       run diasize_set-width in this-procedure
     5081         (input  v-diasize-orig-frame-width
     5082         ,input  true
     5083         ) .
     5084     end.
     5085   end procedure.
     5086   procedure diasize_restore-current-size :
     5087     do
     5088     on error undo, return error return-value
     5089     :
     5090       run diasize_set-height in this-procedure
     5091         (input  v-diasize-current-frame-height
     5092         ,input  true
     5093         ) .
     5094       run diasize_set-width in this-procedure
     5095         (input  v-diasize-current-frame-width
     5096         ,input  true
     5097         ) .
     5098     end.
     5099   end procedure.
     5100   procedure diasize_set-browse-handle :
     5101     define input  parameter p-browse-handle as handle   no-undo .
     5102     define buffer buf_temp-browse-handle for temp-browse-handle .
     5103     do
     5104     on error undo, return error return-value
     5105     :
     5106       assign
     5107         v-diasize-browse-handle = p-browse-handle
     5108       .
     5109       for each buf_temp-browse-handle
     5110       on error undo, return error return-value
     5111       :
     5112         delete buf_temp-browse-handle .
     5113       end.
     5114     end.
     5115   end procedure.
     5116   procedure diasize_add_browse :
     5117     define input  parameter p-browse-type   as character no-undo .
     5118     define input  parameter p-browse-handle as handle    no-undo .
     5119     define buffer buf_temp-browse-handle for temp-browse-handle .
     5120     do
     5121     on error undo, return error return-value
     5122     :
     5123       assign
     5124         v-diasize-browse-number = v-diasize-browse-number + 1
     5125       .
     5126       create buf_temp-browse-handle .
     5127       assign
     5128         buf_temp-browse-handle.browse-type   = p-browse-type
     5129         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     5130         buf_temp-browse-handle.browse-handle = p-browse-handle
     5131       .
     5132     end.
     5133   end procedure.
     5134   procedure diasize_init :
     5135     define variable v-default-value    as logical   no-undo .
     5136     define variable v-restore-saved    as logical   no-undo .
     5137     define variable v-resize-value-str as character no-undo .
     5138     do
     5139     on error undo, return error return-value
     5140     :
     5141       do with frame Dlg-grp
     5142       :
     5143         assign
     5144           v-diasize-orig-frame-height = frame Dlg-grp :height
     5145           v-diasize-orig-frame-width  = frame Dlg-grp :width
     5146           v-diasize-browse-handle     = browse br-list :handle
     5147         .
     5148         create button v-diasize-resize-button
     5149         assign
     5150           parent        = frame Dlg-grp :first-child
     5151           label         = "s"
     5152           height-pixels = 16
     5153           width-pixels  = 16
     5154           visible       = true
     5155           sensitive     = true
     5156           movable       = true
     5157           triggers:
     5158             on end-move persistent run diasize_end-move in this-procedure .
     5159           end triggers.
     5160         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     5161         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     5162         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     5163         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     5164         assign
     5165           v-diasize-wndmax = false
     5166         .
     5167         if connected("ub") = true
     5168         then do:
     5169           define variable v-cntxt-db-num        as integer   no-undo .
     5170           define variable v-cntxt-userid        as character no-undo .
     5171           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     5172                                             , OUTPUT v-cntxt-userid
     5173                                             ) .
     5174           run gbl/wndpar_r.p
     5175             (input  v-cntxt-db-num
     5176             ,input  v-cntxt-userid
     5177             ,input  'wndmax':U
     5178             ,output v-diasize-wndmax
     5179             ,output v-default-value
     5180             ) .
     5181         end.
     5182         assign
     5183           v-diasize-wndstore = false
     5184         .
     5185         if connected("ub") = true
     5186         then do:
     5187           run gbl/wndpar_r.p
     5188             (input  v-cntxt-db-num
     5189             ,input  v-cntxt-userid
     5190             ,input  'wndstore':U
     5191             ,output v-diasize-wndstore
     5192             ,output v-default-value
     5193             ) .
     5194         end.
     5195         assign
     5196           v-diasize-proc-name = entry(1, program-name(2), '.')
     5197         .
     5198         if v-diasize-wndstore = true
     5199         then do:
     5200           assign
     5201             v-restore-saved = false
     5202           .
     5203           if connected("ub") = true
     5204           then do:
     5205             run gbl/wndsizer.p
     5206               (input  v-cntxt-db-num
     5207               ,input  v-cntxt-userid
     5208               ,input  v-diasize-proc-name
     5209               ,input  'height':u
     5210               ,output v-resize-value-str
     5211               ) .
     5212             if v-resize-value-str <> '':U
     5213             then do:
     5214               run diasize_change-height in this-procedure
     5215                 (input  integer(v-resize-value-str)
     5216                 ,input  true
     5217                 ) .
     5218               assign
     5219                 v-restore-saved = true
     5220               .
     5221             end.
     5222           end.
     5223           if connected("ub") = true
     5224           then do:
     5225             run gbl/wndsizer.p
     5226               (input  v-cntxt-db-num
     5227               ,input  v-cntxt-userid
     5228               ,input  v-diasize-proc-name
     5229               ,input  'width':u
     5230               ,output v-resize-value-str
     5231               ) .
     5232             if v-resize-value-str <> '':U
     5233             then do:
     5234               run diasize_change-width in this-procedure
     5235                 (input  integer(v-resize-value-str)
     5236                 ,input  true
     5237                 ) .
     5238               assign
     5239                 v-restore-saved = true
     5240               .
     5241             end.
     5242           end.
     5243           if v-restore-saved <> true
     5244           then do:
     5245             if v-diasize-wndmax = true
     5246             then do:
     5247               run diasize_maximize in this-procedure
     5248                 (input  true
     5249                 ) .
     5250             end.
     5251           end.
     5252         end.
     5253         else do:
     5254           if v-diasize-wndmax = true
     5255           then do:
     5256             run diasize_maximize in this-procedure
     5257               (input  true
     5258               ) .
     5259           end.
     5260         end.
     5261       end.
     5262     end.
     5263   end procedure.
     5264   procedure diasize_need-full-display :
     5265     define output parameter p-need-full-display as logical   no-undo .
     5266     do
     5267     on error undo, return error return-value
     5268     :
     5269       assign
     5270         p-need-full-display = v-diasize-need-full-display
     5271       .
     5272       assign
     5273         v-diasize-need-full-display = false
     5274       .
     5275     end.
     5276   end procedure.
     5277   procedure get-context :
     5278      define output parameter p-db-num as integer          no-undo.
     5279      define output parameter p-user-id as character        no-undo.
     5280      define variable v-login               as character    no-undo.
     5281      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     5282      define buffer buf_user-login  for ub.user-login .
     5283      do
     5284      on error undo, return error
     5285      :
     5286            FIND FIRST buf_sys-ctrl no-lock.
     5287            ASSIGN
     5288               v-login = USERID("ub")
     5289               p-db-num = buf_sys-ctrl.db-num
     5290            .
     5291            FIND FIRST buf_user-login
     5292                 WHERE buf_user-login.db-num = p-db-num
     5293                   AND buf_user-login.user-login = v-login
     5294                 no-lock
     5295                 no-error
     5296                 .
     5297            IF AVAILABLE buf_user-login
     5298            THEN DO:
     5299               assign
     5300                  p-user-id = buf_user-login.user-id
     5301               .
     5302            END.
     5303      end.
     5304   end procedure.
     5305       run diasize_init in this-procedure .
     5306   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5307   PROCEDURE proc-b-tax:
     5308   define input parameter parparentproc    as handle           no-undo.
     5309   define input parameter p-host-code      as character        no-undo.
     5310   define input parameter p-obj-type       as character        no-undo.
     5311   define input parameter p-obj-code       as integer          no-undo.
     5312   define parameter buffer loc-gds-grp for ub.gds-grp.
     5313   define input parameter loc-mode as character no-undo .
     5314   DEFINE VARIABLE locfor-title as character no-undo .
     5315   DEFINE VARIABLE v-today as date no-undo .
     5316   DEFINE VARIABLE v-time as integer no-undo .
     5317   define buffer b_tt-tax for tt-tax.
     5318   if NOT can-find(first tt-tax No-LOCK ) then do:
     5319     bell.
     5320     return error.
     5321   end.
     5322   FOR EACH output-tax:
     5323     DELETE output-tax.
     5324   END.
     5325   locfor-title =  "Ставки налогов и их значения: " +
     5326                   (if loc-mode = 'ДОБАВЛЕНИЕ':U
     5327                    then frame Dlg-grp:title
     5328                    else ( "группа " + string(loc-gds-grp.node-name))
     5329                    ).
     5330   run ref/taxgtree.w (
     5331                  input table tt-tax,
     5332                  output table output-tax,
     5333                  input parparentproc,
     5334                  input loc-mode,
     5335                  input "GDS-GRP":U,
     5336                  input ?,
     5337                  input (if loc-mode = 'ДОБАВЛЕНИЕ':U
     5338                         then ? else
     5339                         loc-gds-grp.node-code),
     5340                  input p-host-code,
     5341                  input p-obj-type,
     5342                  input p-obj-code,
     5343                  input locfor-title) no-error .
     5344   if error-status:error then return error.
     5345   DO on error UNDO, return error:
     5346     FOR EACH tt-tax break by tt-tax.tax-code:
     5347       if first-of(tt-tax.tax-code) then do:
     5348         if tt-tax.individual then next.
     5349         for each output-tax where
     5350                 output-tax.tax-code = tt-tax.tax-code:
     5351           if output-tax.tax-rate-gds-rc <> ? then do:
     5352             find first b_tt-tax where
     5353                        b_tt-tax.tax-rate-gds-rc = output-tax.tax-rate-gds-rc .
     5354             buffer-copy
     5355             output-tax to b_tt-tax.
     5356           end.
     5357           run cur-time in this-procedure(output v-today, output v-time).
     5358           if output-tax.tax-rate-gds-rc = ? and output-tax.fact-date > v-today then do:
     5359             create b_tt-tax.
     5360             buffer-copy
     5361             output-tax to b_tt-tax.
     5362           end.
     5363         end.
     5364       end.
     5365     END.
     5366   END.
     5367   END PROCEDURE.
     5368   MAIN-BLOCK:
     5369   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     5370      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     5371   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5372     run mainmenu_getcntxt in parparentproc
     5373       (output v-cntxt-db-num
     5374       ,output v-cntxt-userid
     5375       ,output v-cntxt-level
     5376       ,output v-cntxt-host-code-obj
     5377       ,output v-cntxt-obj-type
     5378       ,output v-cntxt-obj-code
     5379       ,output v-cntxt-db-num-obj
     5380       ,output v-cntxt-is-admin
     5381       ) .
     5382       if p-current-obj-code = 0
     5383       then do:
     5384          assign
     5385          v-current-store-type = v-cntxt-obj-type
     5386          v-current-store-code = v-cntxt-obj-code
     5387          v-current-host-code = v-cntxt-host-code-obj
     5388          .
     5389       end.
     5390       else do:
     5391           assign
     5392               v-current-store-type = p-current-obj-type
     5393               v-current-store-code = p-current-obj-code
     5394           .
     5395   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5396   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     5397     (input  v-current-store-type
     5398     ,input  v-current-store-code
     5399     ,output v-current-host-code
     5400     )  .
     5401       end.
     5402       run grplib-get-parameters in this-procedure (
     5403             input v-current-store-type
     5404           , input v-current-store-code
     5405       ) no-error.
     5406       if error-status :error
     5407       then do:
     5408           message
     5409               "Ошибка чтения параметров для списка групп товаров."
     5410               skip (1)
     5411               "Для параметров списка будут приняты значения по умолчанию."
     5412           view-as alert-box warning.
     5413       end.
     5414       run UI-on in this-procedure no-error .
     5415       if error-status :error
     5416       then do:
     5417           message
     5418               vss-workfile vss-revision vss-description
     5419               skip "Ошибка при загрузке дерева групп."
     5420               skip return-value
     5421               skip trim(error-status :get-message(1))
     5422                   trim(error-status :get-message(2))
     5423                   trim(error-status :get-message(3))
     5424                   trim(error-status :get-message(4))
     5425                   trim(error-status :get-message(5))
     5426           view-as alert-box error.
     5427           undo, return error .
     5428       end.
     5429   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     5430     (input  'is-flora'
     5431     ,input  v-current-host-code
     5432     ,input  v-current-store-type
     5433     ,input  v-current-store-code
     5434     ,input  ''
     5435     ,input  ''
     5436     ,input  ''
     5437     ,input  no
     5438     ,output is-flora
     5439     ,output par-type
     5440     ) no-error .
     5441     .
     5442       if is-flora = 'no' then do:
     5443          hide b-nabor in frame Dlg-grp.
     5444       end.
     5445       apply "entry" to br-list.
     5446       WAIT-FOR GO OF FRAME Dlg-grp.
     5447   END.
     5448   RUN disable_UI.
     5449   PROCEDURE add-grp :
     5450   do
     5451   on error undo, return error
     5452   :
     5453   define input parameter p-node-code  as integer      no-undo.
     5454       define variable v-gds-grp-recid     as recid    no-undo.
     5455       define variable v-focused-row       as integer  no-undo.
     5456       define variable v-repositioned-row  as integer  no-undo.
     5457       define variable v-have-goods        as logical  no-undo.
     5458       define variable v-have-rights       as logical       no-undo.
     5459       define buffer buf_gds-grp           for ub.gds-grp.
     5460       define buffer buf_temp_grplib_grp   for temp_grplib_grp.
     5461       run check-rights-for-change-grp in this-procedure (  p-node-code
     5462           , output v-have-rights
     5463       ) no-error.
     5464       if error-status :error
     5465       or v-have-rights = no
     5466       then do:
     5467           message
     5468             vss-workfile vss-revision vss-description
     5469             skip "Нет прав на изменение справочника групп товаров."
     5470             skip "Удаление группы невозможно."
     5471             skip return-value
     5472             skip trim(error-status :get-message(1))
     5473                  trim(error-status :get-message(2))
     5474                  trim(error-status :get-message(3))
     5475           view-as alert-box error.
     5476           undo, return error .
     5477       end.
     5478       assign
     5479           v-focused-row      = br-list :focused-row in frame Dlg-grp.
     5480           v-repositioned-row = current-result-row( "br-list" )
     5481       .
     5482       run grplib-have-goods in this-procedure (
     5483             input p-node-code
     5484           , output v-have-goods
     5485       ) no-error .
     5486       if error-status :error
     5487       then do:
     5488           undo, return error "add-grp: Ошибка определения наличия товаров в группе." + chr(10) + return-value.
     5489       end.
     5490       if v-have-goods = yes
     5491       then do:
     5492           message "В данной группе есть товары. Добавить в нее подгруппу,"
     5493                   "включающую эти товары ?"
     5494           view-as alert-box question
     5495           buttons OK-Cancel
     5496           update v-yesno as logical.
     5497           if v-yesno = no
     5498           then do:
     5499               apply "entry" to br-list in frame Dlg-grp.
     5500               return no-apply.
     5501           end.
     5502       end.
     5503       find first buf_temp_grplib_grp
     5504            where buf_temp_grplib_grp.node-code = p-node-code
     5505       no-error .
     5506       if not available buf_temp_grplib_grp
     5507       then do:
     5508           undo, return error "add-grp: Не найдена группа в browse.".
     5509       end.
     5510       if buf_temp_grplib_grp.mark = "»"
     5511       then do:
     5512           run expand-item in this-procedure ( input p-node-code, input no ) no-error.
     5513           if error-status :error
     5514           then do:
     5515               undo, return error "add-grp: Не удается раскрыть группу.".
     5516           end.
     5517       end.
     5518       run ref/g-grp-f.w (
     5519             input parparentproc
     5520           , input v-current-store-type
     5521           , input v-current-store-code
     5522           , input 'ДОБАВЛЕНИЕ':U
     5523           , input p-node-code
     5524           , input-output v-gds-grp-recid
     5525       ) no-error .
     5526       if v-gds-grp-recid = ?
     5527       then do:
     5528           apply "entry" to br-list in frame Dlg-grp.
     5529           return no-apply.
     5530       end.
     5531       find first buf_gds-grp
     5532            where recid ( buf_gds-grp ) =  v-gds-grp-recid
     5533       no-error.
     5534       if not available buf_gds-grp
     5535       then do:
     5536           undo, return error "add-grp: Ошибка добавления группы.".
     5537       end.
     5538       assign
     5539               p-recid-list = string( recid( buf_gds-grp ) )
     5540               gds-grp-row  = recid( buf_gds-grp )
     5541           .
     5542       run ui-on in this-procedure no-error.
     5543       if error-status :error
     5544       then do:
     5545           undo, return error "add-grp: Ошибка при загрузке дерева групп.".
     5546       end.
     5547   end.
     5548   END PROCEDURE.
     5549   PROCEDURE b-mark-press :
     5550   do
     5551   on error undo, return error
     5552   :
     5553   define input parameter p-node-code as integer      no-undo.
     5554       define variable v-focused-row       as integer              no-undo.
     5555       define variable v-repositioned-row  as integer              no-undo.
     5556       define buffer buf_temp_grplib_grp       for temp_grplib_grp.
     5557       define buffer buf_upper_temp_grplib_grp for temp_grplib_grp.
     5558       find first buf_temp_grplib_grp
     5559            where buf_temp_grplib_grp.node-code = p-node-code
     5560       no-error .
     5561       if not available buf_temp_grplib_grp
     5562       then do:
     5563           undo, return error "b-mark-press: Ошибка поиска группы".
     5564       end.
     5565       assign
     5566           v-focused-row      = br-list :focused-row in frame Dlg-grp.
     5567           v-repositioned-row = current-result-row( "br-list" )
     5568       .
     5569       if buf_temp_grplib_grp.sel = "*"
     5570       or (p-button-list <> "b-sel,b-mark,b-actn-mark" and p-node-code = v-root-code)
     5571       then do:
     5572           assign
     5573               buf_temp_grplib_grp.sel = ""
     5574           .
     5575       end.
     5576       else do:
     5577           assign
     5578               buf_temp_grplib_grp.sel = "*"
     5579           .
     5580           for each buf_upper_temp_grplib_grp
     5581               where buf_upper_temp_grplib_grp.level < buf_temp_grplib_grp.level
     5582                 and buf_upper_temp_grplib_grp.full-name = substring( buf_temp_grplib_grp.full-name, 1
     5583                                                           , length( buf_upper_temp_grplib_grp.full-name ) )
     5584           :
     5585               assign
     5586                   buf_upper_temp_grplib_grp.sel = ""
     5587               .
     5588           end.
     5589           for each buf_upper_temp_grplib_grp
     5590               where buf_upper_temp_grplib_grp.node-code <> buf_temp_grplib_grp.node-code
     5591                 and buf_upper_temp_grplib_grp.full-name begins buf_temp_grplib_grp.full-name + chr(47)
     5592           :
     5593               assign
     5594                   buf_upper_temp_grplib_grp.sel = ""
     5595               .
     5596           end.
     5597       end.
     5598       OPEN QUERY br-list FOR EACH temp_grplib_grp NO-LOCK by temp_grplib_grp.sort-name.
     5599       if v-focused-row > br-list :height - 2
     5600       then do:
     5601           assign
     5602               v-repositioned-row  = v-repositioned-row + 1
     5603           .
     5604       end.
     5605       else do:
     5606           assign
     5607               v-focused-row       = v-focused-row + 1
     5608               v-repositioned-row  = v-repositioned-row + 1
     5609           .
     5610       end.
     5611       br-list :set-repositioned-row(v-focused-row, "ALWAYS") in frame Dlg-grp.
     5612       reposition br-list to row v-repositioned-row no-error.
     5613   end.
     5614   END PROCEDURE.
     5615   PROCEDURE bind-to-scales :
     5616   do
     5617   on error undo, return error
     5618   :
     5619   define input parameter p-node-code as integer      no-undo.
     5620       define variable v-is-terminal   as logical           no-undo.
     5621       run grplib-is-terminal (  input p-node-code
     5622                               , output v-is-terminal
     5623       ) no-error .
     5624       if error-status :error
     5625       then do:
     5626           message
     5627           vss-workfile vss-revision vss-description
     5628           skip "Ошибка при определении типа группы (терм/корн)"
     5629           skip return-value
     5630           skip trim(error-status :get-message(1))
     5631               trim(error-status :get-message(2))
     5632               trim(error-status :get-message(3))
     5633               trim(error-status :get-message(4))
     5634               trim(error-status :get-message(5))
     5635           view-as alert-box error.
     5636           undo, return error .
     5637       end.
     5638       if v-is-terminal = no
     5639       then do:
     5640           message
     5641               "Требуется выбрать самую подробную группу товаров,"
     5642               skip "в которой НЕТ других групп."
     5643           view-as alert-box information .
     5644           apply "entry" to br-list in frame Dlg-grp.
     5645           return no-apply.
     5646       end.
     5647       run ref/scal-grp.w (
     5648             input parparentproc
     5649           , input 'b-add'
     5650           , input v-current-store-type
     5651           , input v-current-store-code
     5652           , input ('db':U + chr(44) + 'gds-grp':U)
     5653           , input g#db-num
     5654           , input 0
     5655           , input p-node-code
     5656       ) no-error .
     5657       if error-status :error
     5658       then do:
     5659           undo, return error return-value.
     5660       end.
     5661   end.
     5662   END PROCEDURE.
     5663   PROCEDURE change-grp :
     5664   do
     5665   on error undo, return error
     5666   :
     5667   define input parameter p-node-code  as integer      no-undo.
     5668       define variable v-gds-grp-recid     as recid        no-undo.
     5669       define variable v-focused-row       as integer      no-undo.
     5670       define variable v-repositioned-row  as integer      no-undo.
     5671       define variable v-have-rights       as logical      no-undo.
     5672       define variable v-margins-range     as integer      no-undo.
     5673       define variable v-margins-exists    as logical      no-undo.
     5674       define variable v-increase-range     as integer     no-undo.
     5675       define variable v-increase-exists    as logical     no-undo.
     5676       define variable v-min-marg          as decimal      no-undo.
     5677       define variable v-max-marg          as decimal      no-undo.
     5678       define variable v-increase-pc       as decimal      no-undo.
     5679       define variable v-old-full-name     as character    no-undo.
     5680       define variable v-round-method      as character   no-undo .
     5681       define variable v-base              as decimal     no-undo .
     5682       define variable v-rmethod-range     as integer     no-undo.
     5683       define variable v-rmethod-exists    as logical     no-undo.
     5684       define variable  v-cli-type         as character no-undo .
     5685       define variable  v-notcorr         as character no-undo .
     5686       define variable  v-notcorr-range  as integer no-undo .
     5687       define variable  v-notcorr-exists as logical no-undo .
     5688       define variable  v-cli-code         as integer no-undo .
     5689       define variable  v-income-cli-range  as integer no-undo .
     5690       define variable  v-income-cli-exists as logical no-undo .
     5691       define buffer buf_gds-grp               for ub.gds-grp.
     5692       define buffer buf_temp_grplib_grp       for temp_grplib_grp.
     5693       define buffer buf_child_temp_grplib_grp for temp_grplib_grp.
     5694       run check-rights-for-change-grp in this-procedure (p-node-code,
     5695           output v-have-rights
     5696       ) no-error.
     5697       if error-status :error
     5698       or v-have-rights = no
     5699       then do:
     5700           message
     5701             vss-workfile vss-revision vss-description
     5702             skip "Нет прав на изменение справочника групп товаров."
     5703             skip "Удаление группы невозможно."
     5704             skip return-value
     5705             skip trim(error-status :get-message(1))
     5706                  trim(error-status :get-message(2))
     5707                  trim(error-status :get-message(3))
     5708           view-as alert-box error.
     5709           undo, return error .
     5710       end.
     5711       assign
     5712           v-focused-row      = br-list :focused-row in frame Dlg-grp.
     5713           v-repositioned-row = current-result-row( "br-list" )
     5714       .
     5715       find first buf_gds-grp no-lock
     5716            where buf_gds-grp.node-code = p-node-code
     5717       no-error.
     5718       if error-status :error
     5719       then do:
     5720           undo, return error "change-grp: Неверный выбор группы.".
     5721       end.
     5722       assign
     5723           v-gds-grp-recid = recid( buf_gds-grp )
     5724       .
     5725       run ref/g-grp-f.w (
     5726             input parparentproc
     5727           , input v-current-store-type
     5728           , input v-current-store-code
     5729           , input 'ИЗМЕНЕНИЕ':U
     5730           , input p-node-code
     5731           , input-output v-gds-grp-recid
     5732       ).
     5733       if v-gds-grp-recid = ?
     5734       then do:
     5735           find first buf_temp_grplib_grp
     5736               where buf_temp_grplib_grp.node-code = p-node-code
     5737           no-error.
     5738           if not available buf_temp_grplib_grp
     5739           then do:
     5740               undo, return error "change-grp: Ошибка поиска группы в списке.".
     5741           end.
     5742           if v-grplib-not-fill-extra-info = yes
     5743           then do:
     5744               assign
     5745                   v-margins-exists    = no
     5746                   v-increase-exists   = no
     5747                   v-rmethod-exists    = no
     5748               .
     5749           end.
     5750           else do:
     5751               run grp-obj-margin-value in this-procedure (
     5752                                     input p-node-code
     5753                                   , input v-current-store-type
     5754                                   , input v-current-store-code
     5755                                   , output v-min-marg
     5756                                   , output v-max-marg
     5757                                   , output v-increase-pc
     5758                                   , output v-round-method
     5759                                   , output v-base
     5760                                   , output v-margins-range
     5761                                   , output v-margins-exists
     5762                                   , output v-increase-range
     5763                                   , output v-increase-exists
     5764                                   , output v-rmethod-range
     5765                                   , output v-rmethod-exists
     5766               ) no-error .
     5767               if error-status :error
     5768               then do:
     5769                   undo, return error "create-new-line: Ошибка определения границ наценок и/или наценки по умолчанию для группы." + chr(10) + return-value.
     5770               end.
     5771               assign
     5772                   buf_temp_grplib_grp.min-marg = ( if v-margins-exists = yes then string( v-min-marg, "->>>>9.99" ) else "" )
     5773                   buf_temp_grplib_grp.max-marg = ( if v-margins-exists = yes then string( v-max-marg, "->>>>9.99" ) else "" )
     5774                   buf_temp_grplib_grp.increase-pc = ( if v-increase-exists = yes then  v-increase-pc else buf_temp_grplib_grp.increase-pc)
     5775                   buf_temp_grplib_grp.round-method = (if v-rmethod-exists = yes
     5776                                                       then (v-round-method  + chr(32) +
     5777                                                       (if lookup(v-round-method, 'Произвольно,Вверх,Коэффициент,9-99окончание':U) > 0
     5778                                                       then string(v-base, "->>>>9.99")
     5779                                                       else "":U
     5780                                                       )
     5781                                                       )
     5782                                                       else  "":U)
     5783               .
     5784               run grp-obj-income-cli-value in this-procedure (
     5785                                 input p-node-code
     5786                               , input v-current-store-type
     5787                               , input v-current-store-code
     5788                               , output v-cli-type
     5789                               , output v-cli-code
     5790                               , output v-income-cli-range
     5791                               , output v-income-cli-exists
     5792               ) no-error  .
     5793               if error-status :error
     5794               then do:
     5795                   undo, return error "change-grp: Ошибка определения внутреннего поставщика для корневой группы." + chr(10) + return-value.
     5796               end.
     5797               assign
     5798                   buf_temp_grplib_grp.cli-type = ( if v-income-cli-exists = yes then  v-cli-type else "" )
     5799                   buf_temp_grplib_grp.cli-code = ( if v-income-cli-exists = yes then  v-cli-code else 0 )
     5800               .
     5801               run grp-obj-notcorr-value in this-procedure (
     5802                                 input p-node-code
     5803                               , input v-current-store-type
     5804                               , input v-current-store-code
     5805                               , output v-notcorr
     5806                               , output v-notcorr-range
     5807                               , output v-notcorr-exists
     5808               ) no-error  .
     5809               if error-status :error
     5810               then do:
     5811                   undo, return error "change-grp: Ошибка определения ЗАПРЕТ КОР ОП." + chr(10) + return-value.
     5812               end.
     5813               assign
     5814                   buf_temp_grplib_grp.notcorr = ( if v-notcorr-exists = yes then  v-notcorr else "" )
     5815               .
     5816           end.
     5817           browse br-list:refresh().
     5818           apply "entry" to br-list in frame Dlg-grp.
     5819           return no-apply.
     5820       end.
     5821       find first buf_temp_grplib_grp
     5822            where buf_temp_grplib_grp.node-code = p-node-code
     5823       no-error.
     5824       if not available buf_temp_grplib_grp
     5825       then do:
     5826           undo, return error "change-grp: Ошибка поиска группы в списке.".
     5827       end.
     5828       find first buf_gds-grp no-lock
     5829            where buf_gds-grp.node-code = p-node-code
     5830       no-error.
     5831       if error-status :error
     5832       then do:
     5833           undo, return error "change-grp: Неверный выбор группы.".
     5834       end.
     5835       assign
     5836           p-recid-list = string( recid( buf_gds-grp ) )
     5837           gds-grp-row  = recid( buf_gds-grp )
     5838       .
     5839       if buf_temp_grplib_grp.level > 0
     5840       then do:
     5841           assign
     5842               buf_temp_grplib_grp.name    = substring( buf_temp_grplib_grp.name
     5843                                                       , 1
     5844                                                       , buf_temp_grplib_grp.level * 4 + 2 )
     5845                                               + buf_gds-grp.node-name
     5846           .
     5847       end.
     5848       else do:
     5849           assign
     5850               buf_temp_grplib_grp.name    = buf_gds-grp.node-name
     5851           .
     5852       end.
     5853       assign
     5854           buf_temp_grplib_grp.print-code  = buf_gds-grp.print-code
     5855           buf_temp_grplib_grp.increase-pc = buf_gds-grp.increase-pc
     5856           buf_temp_grplib_grp.calc-method = buf_gds-grp.calc-method
     5857           v-old-full-name                 = buf_temp_grplib_grp.full-name
     5858       .
     5859       run grplib-get-full-name in this-procedure (  input p-node-code
     5860                                                   , output buf_temp_grplib_grp.full-name
     5861       ) no-error .
     5862       if error-status :error
     5863       then do:
     5864           undo, return error "Ошибка вычисления полного имени группы в списке".
     5865       end.
     5866       buf_temp_grplib_grp.full-name = buf_temp_grplib_grp.full-name.
     5867       run grplib-get-sort-name in this-procedure (  input p-node-code
     5868                                                   , output buf_temp_grplib_grp.sort-name
     5869       ) no-error .
     5870       if error-status :error
     5871       then do:
     5872           undo, return error "Ошибка вычисления полного имени группы в списке".
     5873       end.
     5874       buf_temp_grplib_grp.sort-name = buf_temp_grplib_grp.sort-name.
     5875       if buf_temp_grplib_grp.level <> 0
     5876       then do:
     5877           assign
     5878               fi-search :screen-value = right-trim( buf_temp_grplib_grp.full-name, chr(47) )
     5879           .
     5880       end.
     5881       if v-grplib-not-fill-extra-info = yes
     5882       then do:
     5883           assign
     5884               v-margins-exists    = no
     5885               v-increase-exists   = no
     5886               v-rmethod-exists    = no
     5887           .
     5888       end.
     5889       else do:
     5890           run grp-obj-margin-value in this-procedure (
     5891                                     input p-node-code
     5892                                   , input v-current-store-type
     5893                                   , input v-current-store-code
     5894                                   , output v-min-marg
     5895                                   , output v-max-marg
     5896                                   , output v-increase-pc
     5897                                   , output v-round-method
     5898                                   , output v-base
     5899                                   , output v-margins-range
     5900                                   , output v-margins-exists
     5901                                   , output v-increase-range
     5902                                   , output v-increase-exists
     5903                                   , output v-rmethod-range
     5904                                   , output v-rmethod-exists
     5905           ) no-error .
     5906           if error-status :error
     5907           then do:
     5908               undo, return error "create-new-line: Ошибка определения границ наценок и/или наценки по умолчанию для группы." + chr(10) + return-value.
     5909           end.
     5910           assign
     5911               buf_temp_grplib_grp.min-marg = ( if v-margins-exists = yes then string( v-min-marg, "->>>>9.99" ) else "" )
     5912               buf_temp_grplib_grp.max-marg = ( if v-margins-exists = yes then string( v-max-marg, "->>>>9.99" ) else "" )
     5913               buf_temp_grplib_grp.increase-pc = ( if v-increase-exists = yes then  v-increase-pc else buf_temp_grplib_grp.increase-pc)
     5914               buf_temp_grplib_grp.round-method = (if v-rmethod-exists = yes
     5915                                                   then (v-round-method  + chr(32) +
     5916                                                   (if lookup(v-round-method, 'Произвольно,Вверх,Коэффициент,9-99окончание':U) > 0
     5917                                                       then string(v-base, "->>>>9.99")
     5918                                                       else "":U
     5919                                                       )
     5920                                                   )
     5921                                                   else  "":U)
     5922           .
     5923                   run grp-obj-income-cli-value in this-procedure (
     5924                                       input p-node-code
     5925                                       , input v-current-store-type
     5926                                       , input v-current-store-code
     5927                                       , output v-cli-type
     5928                                       , output v-cli-code
     5929                                       , output v-income-cli-range
     5930                                       , output v-income-cli-exists
     5931               ) no-error  .
     5932               if error-status :error
     5933               then do:
     5934                   undo, return error "change-grp: Ошибка определения внутреннего поставщика для корневой группы." + chr(10) + return-value.
     5935               end.
     5936               assign
     5937                   buf_temp_grplib_grp.cli-type = ( if v-income-cli-exists = yes then  v-cli-type else "" )
     5938                   buf_temp_grplib_grp.cli-code = ( if v-income-cli-exists = yes then  v-cli-code else 0 )
     5939               .
     5940               run grp-obj-notcorr-value in this-procedure (
     5941                                 input p-node-code
     5942                               , input v-current-store-type
     5943                               , input v-current-store-code
     5944                               , output v-notcorr
     5945                               , output v-notcorr-range
     5946                               , output v-notcorr-exists
     5947               ) no-error  .
     5948               if error-status :error
     5949               then do:
     5950                   undo, return error "change-grp: Ошибка определения ЗАПРЕТ КОР ОП." + chr(10) + return-value.
     5951               end.
     5952               assign
     5953                   buf_temp_grplib_grp.notcorr = ( if v-notcorr-exists = yes then  v-notcorr else "" )
     5954               .
     5955       end.
     5956       for each buf_child_temp_grplib_grp
     5957          where buf_child_temp_grplib_grp.full-name begins v-old-full-name
     5958            and buf_child_temp_grplib_grp.full-name <> v-old-full-name
     5959            and buf_child_temp_grplib_grp.level <> buf_temp_grplib_grp.level
     5960       :
     5961           run grplib-get-full-name in this-procedure (  input buf_child_temp_grplib_grp.node-code
     5962                                                       , output buf_child_temp_grplib_grp.full-name
     5963           ) no-error .
     5964           if error-status :error
     5965           then do:
     5966               undo, return error "Ошибка вычисления полного имени группы в списке".
     5967           end.
     5968           run grplib-get-sort-name in this-procedure (  input buf_child_temp_grplib_grp.node-code
     5969                                                       , output buf_child_temp_grplib_grp.sort-name
     5970           ) no-error .
     5971           if error-status :error
     5972           then do:
     5973               undo, return error "Ошибка вычисления полного имени группы в списке".
     5974           end.
     5975       end.
     5976       run UI-on in this-procedure no-error .
     5977       if error-status :error
     5978       then do:
     5979           undo, return error "chg-grp: Ошибка при загрузке дерева групп.".
     5980       end.
     5981   end.
     5982   END PROCEDURE.
     5983   PROCEDURE check-rights-for-change-grp :
     5984   do
     5985   on error undo, return error
     5986   :
     5987   define input  parameter p-node-code like ub.gds-grp.node-code no-undo.
     5988   define output parameter p-have-rights   as logical      no-undo.
     5989       define variable v-enable-change-grp as logical       no-undo.
     5990       if g#db-num <> 0
     5991       then do:
     5992           message
     5993             vss-workfile vss-revision vss-description
     5994             skip "Операция определена только в ГБД."
     5995             skip return-value
     5996             skip trim(error-status :get-message(1))
     5997                  trim(error-status :get-message(2))
     5998                  trim(error-status :get-message(3))
     5999           view-as alert-box error.
     6000           assign
     6001               p-have-rights = no
     6002           .
     6003       end.
     6004       else do:
     6005   define variable vss-include-info22 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6006   do:
     6007     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     6008       (input  v-cntxt-db-num
     6009       ,input  v-cntxt-userid
     6010       ,input  0
     6011       ,input  'actn_reference_groups-edit':U
     6012       ,input  'firm':U
     6013       ,input  v-cntxt-host-code-obj
     6014       ,input  '':U
     6015       ,input  0
     6016       ,input  0
     6017       ,input  p-node-code
     6018       ,input  0
     6019       ,input  no
     6020       ,output p-have-rights
     6021       )  .
     6022   end.
     6023       end.
     6024   end.
     6025   END PROCEDURE.
     6026   PROCEDURE collapse-all-on-first-level :
     6027   do
     6028   on error undo, return error
     6029   :
     6030       define buffer buf_gds-grp       for ub.gds-grp.
     6031       define buffer buf_temp_grplib_grp       for temp_grplib_grp.
     6032       for each buf_temp_grplib_grp no-lock
     6033          where buf_temp_grplib_grp.upper-code = v-root-code
     6034       :
     6035           run collapse-item in this-procedure (
     6036                 input buf_temp_grplib_grp.node-code
     6037               , input no
     6038           ) no-error .
     6039           if error-status :error
     6040           then do:
     6041               undo, return error "Не удалось закрыть подуровни группы "
     6042                                   + chr(10) + "'" + buf_temp_grplib_grp.full-name + "'"
     6043                                   + chr(10) + return-value.
     6044           end.
     6045       end.
     6046       OPEN QUERY br-list FOR EACH temp_grplib_grp NO-LOCK by temp_grplib_grp.sort-name.
     6047   end.
     6048   END PROCEDURE.
     6049   PROCEDURE collapse-item :
     6050   do
     6051   on error undo, return error
     6052   :
     6053   define input parameter p-node-code as integer      no-undo.
     6054   define input parameter p-refresh    as logical      no-undo.
     6055       define variable v-focused-row       as integer              no-undo.
     6056       define variable v-repositioned-row  as integer              no-undo.
     6057       define buffer buf_del_temp_grplib_grp   for temp_grplib_grp.
     6058       define buffer buf_temp_grplib_grp       for temp_grplib_grp.
     6059       find first buf_temp_grplib_grp
     6060            where buf_temp_grplib_grp.node-code = p-node-code
     6061       no-error.
     6062       if error-status :error
     6063       then do:
     6064           undo, return error "collapse-item: Неверно передан код группы. Нет группы с кодом " + string( p-node-code ).
     6065       end.
     6066       assign
     6067           v-focused-row      = br-list :focused-row in frame Dlg-grp.
     6068           v-repositioned-row = current-result-row( "br-list" )
     6069       .
     6070       for each buf_del_temp_grplib_grp
     6071          where buf_del_temp_grplib_grp.full-name begins buf_temp_grplib_grp.full-name
     6072            and buf_del_temp_grplib_grp.full-name <> buf_temp_grplib_grp.full-name
     6073            and buf_del_temp_grplib_grp.level     <> buf_temp_grplib_grp.level
     6074       :
     6075           delete buf_del_temp_grplib_grp.
     6076       end.
     6077       assign
     6078           buf_temp_grplib_grp.mark = "»"
     6079           buf_temp_grplib_grp.name = replace( buf_temp_grplib_grp.name
     6080                                           , "«"
     6081                                           , "»"
     6082                                           )
     6083       .
     6084       if p-refresh = yes
     6085       then do:
     6086           OPEN QUERY br-list FOR EACH temp_grplib_grp NO-LOCK by temp_grplib_grp.sort-name.
     6087           br-list :set-repositioned-row(v-focused-row, "ALWAYS") in frame Dlg-grp.
     6088           reposition br-list to row v-repositioned-row.
     6089       end.
     6090   end.
     6091   END PROCEDURE.
     6092   PROCEDURE create-new-line :
     6093   do
     6094   on error undo, return error
     6095   :
     6096   define input parameter p-node-code      as integer      no-undo.
     6097   define input parameter p-upper-code     as integer      no-undo.
     6098   define input parameter p-level          as integer      no-undo.
     6099   define input parameter p-is-terminal    as logical      no-undo.
     6100   define input parameter p-node-name      as character    no-undo.
     6101   define input parameter p-print-code     as character    no-undo .
     6102   define input parameter p-increase-pc    as decimal      no-undo.
     6103   define input parameter p-calc-method    as character    no-undo.
     6104   define input parameter p-full-name      as character    no-undo.
     6105   define input parameter p-sort-name      as character    no-undo.
     6106   define variable v-margins-range     as integer           no-undo.
     6107   define variable v-margins-exists    as logical           no-undo.
     6108   define variable v-increase-range    as integer          no-undo.
     6109   define variable v-increase-exists   as logical          no-undo.
     6110   define variable v-min-marg          as decimal           no-undo.
     6111   define variable v-max-marg          as decimal           no-undo.
     6112   define variable v-increase-pc       as decimal           no-undo.
     6113   define variable v-round-method      as character         no-undo .
     6114   define variable v-base              as decimal           no-undo .
     6115   define variable v-rmethod-range     as integer           no-undo.
     6116   define variable v-rmethod-exists    as logical           no-undo.
     6117   define variable  v-cli-type         as character no-undo .
     6118   define variable  v-cli-code         as integer no-undo .
     6119   define variable  v-income-cli-range  as integer no-undo .
     6120   define variable  v-income-cli-exists as logical no-undo .
     6121   define variable  v-notcorr         as character no-undo .
     6122   define variable  v-notcorr-range  as integer no-undo .
     6123   define variable  v-notcorr-exists as logical no-undo .
     6124   define buffer buf_temp_grplib_grp       for temp_grplib_grp.
     6125       create buf_temp_grplib_grp.
     6126       assign
     6127           buf_temp_grplib_grp.node-code   = p-node-code
     6128           buf_temp_grplib_grp.upper-code  = p-upper-code
     6129           buf_temp_grplib_grp.level       = p-level
     6130           buf_temp_grplib_grp.full-name   = p-full-name + (if p-full-name <> "" then chr(47)         else "") + p-node-name
     6131           buf_temp_grplib_grp.sort-name   = p-sort-name + (if p-full-name <> "" then chr(2)  else "") + p-node-name
     6132           buf_temp_grplib_grp.calc-method = p-calc-method
     6133           buf_temp_grplib_grp.increase-pc = p-increase-pc
     6134           buf_temp_grplib_grp.print-code  = p-print-code
     6135       .
     6136       run get-first-char in this-procedure (
     6137             input p-node-code
     6138           , input p-is-terminal
     6139           , input no
     6140           , output buf_temp_grplib_grp.mark
     6141       ) no-error.
     6142       if error-status :error
     6143       then do:
     6144           undo, return error "create-new-line: Ошибка вычисления первого символа для отображения группы." .
     6145       end.
     6146       assign
     6147           buf_temp_grplib_grp.name = fill( " ", 4 * p-level )
     6148                                           + buf_temp_grplib_grp.mark
     6149                                           + " "
     6150                                           + p-node-name
     6151       .
     6152       if v-grplib-not-fill-extra-info = yes
     6153       then do:
     6154           assign
     6155               v-margins-exists    = no
     6156               v-increase-exists   = no
     6157               v-rmethod-exists    = no
     6158           .
     6159       end.
     6160       else do:
     6161           run grp-obj-margin-value in this-procedure (
     6162                                     input p-node-code
     6163                                   , input v-current-store-type
     6164                                   , input v-current-store-code
     6165                                   , output v-min-marg
     6166                                   , output v-max-marg
     6167                                   , output v-increase-pc
     6168                                   , output v-round-method
     6169                                   , output v-base
     6170                                   , output v-margins-range
     6171                                   , output v-margins-exists
     6172                                   , output v-increase-range
     6173                                   , output v-increase-exists
     6174                                   , output v-rmethod-range
     6175                                   , output v-rmethod-exists
     6176           ) no-error .
     6177           if error-status :error
     6178           then do:
     6179               undo, return error "create-new-line: Ошибка определения границ наценок и/или наценки по умолчанию для группы." + chr(10) + return-value.
     6180           end.
     6181           assign
     6182               buf_temp_grplib_grp.min-marg = ( if v-margins-exists = yes then string( v-min-marg, "->>>>9.99" ) else "" )
     6183               buf_temp_grplib_grp.max-marg = ( if v-margins-exists = yes then string( v-max-marg, "->>>>9.99" ) else "" )
     6184               buf_temp_grplib_grp.increase-pc = ( if v-increase-exists = yes then  v-increase-pc else buf_temp_grplib_grp.increase-pc)
     6185               buf_temp_grplib_grp.round-method = (if v-rmethod-exists = yes
     6186                                                   then (v-round-method  + chr(32) +
     6187                                                       (if lookup(v-round-method, 'Произвольно,Вверх,Коэффициент,9-99окончание':U) > 0
     6188                                                       then string(v-base, "->>>>9.99")
     6189                                                       else "":U
     6190                                                       )
     6191                                                       )
     6192                                                   else  buf_temp_grplib_grp.round-method)
     6193           .
     6194           run grp-obj-income-cli-value in this-procedure (
     6195                                       input p-node-code
     6196                                       , input v-current-store-type
     6197                                       , input v-current-store-code
     6198                                       , output v-cli-type
     6199                                       , output v-cli-code
     6200                                       , output v-income-cli-range
     6201                                       , output v-income-cli-exists
     6202               ) no-error  .
     6203               if error-status :error
     6204               then do:
     6205                   undo, return error "create-new-line: Ошибка определения внутреннего поставщика для корневой группы." + chr(10) + return-value.
     6206               end.
     6207               assign
     6208                   buf_temp_grplib_grp.cli-type = ( if v-income-cli-exists = yes then  v-cli-type else "" )
     6209                   buf_temp_grplib_grp.cli-code = ( if v-income-cli-exists = yes then  v-cli-code else 0 )
     6210               .
     6211               run grp-obj-notcorr-value in this-procedure (
     6212                                 input p-node-code
     6213                               , input v-current-store-type
     6214                               , input v-current-store-code
     6215                               , output v-notcorr
     6216                               , output v-notcorr-range
     6217                               , output v-notcorr-exists
     6218               ) no-error  .
     6219               if error-status :error
     6220               then do:
     6221                   undo, return error "change-grp: Ошибка определения ЗАПРЕТ КОР ОП." + chr(10) + return-value.
     6222               end.
     6223               assign
     6224                   buf_temp_grplib_grp.notcorr = ( if v-notcorr-exists = yes then  v-notcorr else "" )
     6225               .
     6226           define variable v-value       as character  no-undo init "" .
     6227           define variable v-type        as character  no-undo.
     6228           run grp-attr-value (
     6229               input   buf_temp_grplib_grp.node-code
     6230               ,input   'gds-grp-nabor':U
     6231               ,input   0
     6232               ,input   ""
     6233               ,input   0
     6234               ,output  v-value
     6235               ,output  v-type       ) no-error .
     6236           if v-value = "yes" then  buf_temp_grplib_grp.nabor = "+".
     6237                               else  buf_temp_grplib_grp.nabor = "".
     6238       end.
     6239   end.
     6240   END PROCEDURE.
     6241   PROCEDURE delete-grp :
     6242   do
     6243   on error undo, return error
     6244   :
     6245   define input parameter p-node-code  as integer      no-undo.
     6246   define input parameter p-refresh    as logical      no-undo.
     6247       define variable v-gds-grp-recid     as recid    no-undo.
     6248       define variable v-focused-row       as integer  no-undo.
     6249       define variable v-repositioned-row  as integer  no-undo.
     6250       define variable v-upper-code        as integer  no-undo.
     6251       define variable v-answer            as logical  no-undo.
     6252       define variable v-is-terminal       as logical  no-undo.
     6253       define variable v-have-goods        as logical  no-undo.
     6254       define variable v-counter           as integer  no-undo.
     6255       define variable v-have-rights       as logical  no-undo.
     6256       define buffer buf_gds-grp           for ub.gds-grp.
     6257       define buffer buf_same_gds-grp      for ub.gds-grp.
     6258       define buffer buf_temp_grplib_grp   for temp_grplib_grp.
     6259       run check-rights-for-change-grp in this-procedure ( p-node-code
     6260           ,output v-have-rights
     6261       ) no-error.
     6262       if error-status :error
     6263       or v-have-rights = no
     6264       then do:
     6265           message
     6266             vss-workfile vss-revision vss-description
     6267             skip "Нет прав на изменение справочника групп товаров."
     6268             skip "Удаление группы невозможно."
     6269             skip return-value
     6270             skip trim(error-status :get-message(1))
     6271                  trim(error-status :get-message(2))
     6272                  trim(error-status :get-message(3))
     6273           view-as alert-box error.
     6274           undo, return error .
     6275       end.
     6276       assign
     6277           v-focused-row      = br-list :focused-row in frame Dlg-grp.
     6278           v-repositioned-row = current-result-row( "br-list" )
     6279       .
     6280       if p-node-code = v-root-code
     6281       then do:
     6282           message
     6283               "Нельзя удалить корневую группу."
     6284           view-as alert-box.
     6285           undo, return.
     6286       end.
     6287       find first buf_temp_grplib_grp
     6288            where buf_temp_grplib_grp.node-code = p-node-code
     6289       no-error .
     6290       if error-status :error
     6291       then do:
     6292           undo, return error "Неверно выбрана группа." .
     6293       end.
     6294       find first buf_gds-grp no-lock
     6295            where buf_gds-grp.node-code = p-node-code
     6296       no-error.
     6297       if error-status :error
     6298       then do:
     6299           undo, return error "change-grp: Нет группы БД, соответствующей значению в списке.".
     6300       end.
     6301       v-upper-code = buf_gds-grp.upper-code.
     6302       run waitfram-show in this-procedure ( input "Ждите..." ).
     6303       run ref/gdsgrp03.p ( input no
     6304                           ,input recid(buf_gds-grp)
     6305                           ,input "up"
     6306                           ,input "up"
     6307                           ) no-error.
     6308       if error-status :error
     6309       then do:
     6310          run waitfram-hide in this-procedure .
     6311           undo, return error return-value.
     6312       end.
     6313       run waitfram-hide in this-procedure .
     6314       if return-value = "no-apply"  then do:
     6315           apply "entry" to br-list in frame Dlg-grp.
     6316           return no-apply.
     6317       end.
     6318       if p-refresh = yes
     6319       then do:
     6320           find first buf_gds-grp no-lock
     6321                where buf_gds-grp.node-code = v-upper-code
     6322           no-error.
     6323           if not available buf_gds-grp
     6324           then do:
     6325               undo, return error "delete-grp: Не найдена группа в БД".
     6326           end.
     6327           assign
     6328               p-recid-list = string( recid( buf_gds-grp ) )
     6329               gds-grp-row  = recid( buf_gds-grp )
     6330           .
     6331           run UI-on in this-procedure no-error .
     6332           if error-status :error
     6333           then do:
     6334               undo, return error "delete-grp: Ошибка при загрузке дерева групп.".
     6335           end.
     6336       end.
     6337   end.
     6338   END PROCEDURE.
     6339   PROCEDURE disable_UI :
     6340     HIDE FRAME Dlg-grp.
     6341   END PROCEDURE.
     6342   PROCEDURE enable-button-marg :
     6343   do
     6344   on error undo, return error
     6345   :
     6346   define input parameter p-node-code as integer      no-undo.
     6347       define variable v-is-terminal     as logical           no-undo.
     6348       define buffer buf_upper_gds-grp for ub.gds-grp.
     6349       define buffer buf_node_gds-grp  for ub.gds-grp.
     6350       if not b-marg :visible in FRAME Dlg-grp
     6351       then do:
     6352       end.
     6353       else do:
     6354           run grplib-is-terminal in this-procedure ( input p-node-code, output v-is-terminal ) no-error.
     6355           if error-status :error
     6356           then do:
     6357               undo, return error "enable-button-marg: Не удается определить, корневая группа или терминальная." + chr(10) + return-value.
     6358           end.
     6359           if v-is-terminal = no
     6360           then do:
     6361               enable b-marg    with FRAME Dlg-grp.
     6362           end.
     6363           else do:
     6364               enable b-marg   with FRAME Dlg-grp.
     6365           end.
     6366       end.
     6367   end.
     6368   END PROCEDURE.
     6369   PROCEDURE enable_UI :
     6370     DISPLAY fi-search
     6371         WITH FRAME Dlg-grp.
     6372     ENABLE b-exit b-mark b-scales b-sel b-marg b-print B-history b-help b-add
     6373            b-chg b-del b-move b-arch b-tax B-gds B-nabor B-rum b-expand
     6374            b-expand-all fi-search b-find-by-full-name b-find-by-substring
     6375            b-search br-list
     6376         WITH FRAME Dlg-grp.
     6377     VIEW FRAME Dlg-grp.
     6378     OPEN QUERY br-list FOR EACH temp_grplib_grp NO-LOCK by temp_grplib_grp.sort-name.
     6379   END PROCEDURE.
     6380   PROCEDURE expand-all-from-current :
     6381   do
     6382   on error undo, return error
     6383   :
     6384   define input parameter p-node-code as integer      no-undo.
     6385       define variable v-full-name         as character    no-undo.
     6386       define variable v-focused-row       as integer      no-undo.
     6387       define variable v-repositioned-row  as integer      no-undo.
     6388       define variable v-grp-counter       as integer      no-undo.
     6389       define buffer buf_temp_grplib_grp       for temp_grplib_grp.
     6390       assign
     6391           v-grplib-no-warning-grp-amount = no
     6392       .
     6393       run expand-item in this-procedure (
     6394             input p-node-code
     6395           , input no
     6396       ) no-error .
     6397       if error-status :error
     6398       then do:
     6399           undo, return error "expand-all-from-current: Не удалось раскрыть подуровни группы.".
     6400       end.
     6401       assign
     6402           v-focused-row      = br-list :focused-row in frame Dlg-grp.
     6403           v-repositioned-row = current-result-row( "br-list" )
     6404       .
     6405       run grplib-get-full-name in this-procedure (
     6406             input p-node-code
     6407           , output v-full-name
     6408       ) no-error .
     6409       if error-status :error
     6410       then do:
     6411           undo, return error "expand-all-from-current: Ошибка вычисления полного имени группы".
     6412       end.
     6413       assign
     6414           v-grplib-grp-amount-for-load = 1
     6415       .
     6416       load-grp-list:
     6417       for each buf_temp_grplib_grp
     6418          where buf_temp_grplib_grp.full-name begins v-full-name
     6419       :
     6420           assign
     6421               v-grp-counter = v-grp-counter + 1
     6422           .
     6423           run expand-item in this-procedure (
     6424                 input buf_temp_grplib_grp.node-code
     6425               , input no
     6426           ) no-error .
     6427           if error-status :error
     6428           then do:
     6429               undo, return error "expand-all-from-current: Не удалось раскрыть подуровни группы.".
     6430           end.
     6431           if v-grp-counter > 1000
     6432           and v-grplib-grp-amount-for-load <> 0
     6433           then do:
     6434               define variable v-choice    as integer      no-undo.
     6435               run gbl/d-askw.w (
     6436                     input "Большой список групп"
     6437                   , input substitute( "В список добавлено более &2 групп&1&1Вы можете добавить следующие &2 групп,&1заполнить весь список&1или остановить создание списка.", chr(10), 1000 )
     6438                   , input "|^":U
     6439                   , input substitute( "Следующие &1|Заполнить все|Прервать", 1000 )
     6440                   , input substitute( "Загрузить список следующих &1 групп|Загрузить список всех групп|Не загружать список полностью", 1000 )
     6441                   , input 1
     6442                   , input 3
     6443                   , output v-choice
     6444               ).
     6445               case v-choice
     6446               :
     6447                   when 1
     6448                   then do:
     6449                       assign
     6450                           v-grplib-grp-amount-for-load    = 1
     6451                           v-grp-counter                   = 0
     6452                       .
     6453                   end.
     6454                   when 2
     6455                   then do:
     6456                       assign
     6457                           v-grplib-grp-amount-for-load    = 0
     6458                       .
     6459                   end.
     6460                   otherwise do:
     6461                       leave load-grp-list.
     6462                   end.
     6463               end case.
     6464           end.
     6465       end.
     6466       OPEN QUERY br-list FOR EACH temp_grplib_grp NO-LOCK by temp_grplib_grp.sort-name.
     6467       br-list :set-repositioned-row(v-focused-row, "ALWAYS") in frame Dlg-grp.
     6468       reposition br-list to row v-repositioned-row.
     6469   end.
     6470   END PROCEDURE.
     6471   PROCEDURE expand-item :
     6472   do
     6473   on error undo, return error
     6474   :
     6475   define input parameter p-node-code  as integer      no-undo.
     6476   define input parameter p-refresh    as logical      no-undo.
     6477       define variable v-focused-row       as integer              no-undo.
     6478       define variable v-repositioned-row  as integer              no-undo.
     6479       define buffer buf_gds-grp           for ub.gds-grp.
     6480       define buffer buf_temp_grplib_grp   for temp_grplib_grp.
     6481   if session :set-wait-state( "compiler" ) then.
     6482       assign
     6483           v-focused-row      = br-list :focused-row in frame Dlg-grp.
     6484           v-repositioned-row = current-result-row( "br-list" )
     6485       .
     6486       find first buf_temp_grplib_grp
     6487            where buf_temp_grplib_grp.node-code = p-node-code
     6488       no-error .
     6489       if not available buf_temp_grplib_grp
     6490       then do:
     6491           undo, return error "expand-item: Неверно задан код группы.".
     6492       end.
     6493       if buf_temp_grplib_grp.mark <> "»"
     6494       then do:
     6495       end.
     6496       else do:
     6497           for each buf_gds-grp no-lock
     6498              where buf_gds-grp.upper-code = p-node-code
     6499           on error undo, return error
     6500           :
     6501               run create-new-line in this-procedure (
     6502                     input buf_gds-grp.node-code
     6503                   , input buf_gds-grp.upper-code
     6504                   , input buf_temp_grplib_grp.level + 1
     6505                   , input buf_gds-grp.is-term
     6506                   , input buf_gds-grp.node-name
     6507                   , input buf_gds-grp.print-code
     6508                   , input buf_gds-grp.increase-pc
     6509                   , input buf_gds-grp.calc-method
     6510                   , input buf_temp_grplib_grp.full-name
     6511                   , input buf_temp_grplib_grp.sort-name
     6512               ) no-error .
     6513               if error-status :error
     6514               then do:
     6515                   message
     6516                   vss-workfile vss-revision vss-description
     6517                   skip "expand-item: Ошибка добавления строки в список групп."
     6518                   skip return-value
     6519                   skip trim(error-status :get-message(1))
     6520                       trim(error-status :get-message(2))
     6521                       trim(error-status :get-message(3))
     6522                       trim(error-status :get-message(4))
     6523                       trim(error-status :get-message(5))
     6524                   view-as alert-box error.
     6525   if session :set-wait-state( "" ) then.
     6526                   undo, return error .
     6527               end.
     6528           end.
     6529           assign
     6530               buf_temp_grplib_grp.mark = "«"
     6531               buf_temp_grplib_grp.name = replace( buf_temp_grplib_grp.name
     6532                                               , "»"
     6533                                               , "«"
     6534                                               )
     6535           .
     6536           if p-refresh = yes
     6537           then do:
     6538               OPEN QUERY br-list FOR EACH temp_grplib_grp NO-LOCK by temp_grplib_grp.sort-name.
     6539               if v-focused-row > br-list :height - 2
     6540               then do:
     6541                   assign
     6542                       v-focused-row       = br-list :height - 2
     6543                   .
     6544               end.
     6545               br-list :set-repositioned-row(v-focused-row, "ALWAYS") in frame Dlg-grp.
     6546               reposition br-list to row v-repositioned-row.
     6547           end.
     6548       end.
     6549   if session :set-wait-state( "" ) then.
     6550   end.
     6551   END PROCEDURE.
     6552   PROCEDURE expand-or-collapse-item :
     6553   do
     6554   on error undo, return error
     6555   :
     6556       case temp_grplib_grp.mark
     6557       :
     6558       when "»"
     6559       then do:
     6560           run expand-item in this-procedure ( input temp_grplib_grp.node-code, input yes ) no-error .
     6561           if error-status :error
     6562           then do:
     6563               undo, return error "Не удалось раскрыть подуровни группы.".
     6564           end.
     6565       end.
     6566       when "«"
     6567       then do:
     6568           run collapse-item in this-procedure ( input temp_grplib_grp.node-code, input yes ) no-error .
     6569           if error-status :error
     6570           then do:
     6571               undo, return error "Не удалось закрыть подуровни группы.".
     6572           end.
     6573       end.
     6574       end case.
     6575   end.
     6576   END PROCEDURE.
     6577   PROCEDURE expand-tree-for-grp :
     6578   do
     6579   on error undo, return error
     6580   :
     6581   define input parameter p-node-code              as integer          no-undo.
     6582   define output parameter p-focused-row           as integer          no-undo.
     6583   define output parameter p-reposition-row        as integer          no-undo.
     6584   define output parameter p-reposition-to-recid   as logical init no  no-undo.
     6585   define variable v-full-name     as character    no-undo.
     6586   define variable v-found         as logical      no-undo.
     6587   define buffer buf_temp_grplib_grp       for temp_grplib_grp.
     6588       run grplib-get-full-name in this-procedure ( input p-node-code, output v-full-name ) no-error .
     6589       if error-status :error
     6590       then do:
     6591       end.
     6592       else do:
     6593           run grplib-find-grp-by-full-name in this-procedure (
     6594                 input right-trim( v-full-name, chr(47) )
     6595               , input yes
     6596               , output v-found
     6597           ) no-error .
     6598           if v-found = no
     6599           then do:
     6600           end.
     6601           else do:
     6602               process-initial-grp:
     6603               for each temp_grplib_found-grp
     6604               break by temp_grplib_found-grp.level
     6605               on error undo, leave process-initial-grp :
     6606                   if last ( temp_grplib_found-grp.level )
     6607                   then do:
     6608                       assign
     6609                           p-focused-row       = integer( br-list :height in frame Dlg-grp / 2 ) + 1
     6610                       .
     6611                       find first buf_temp_grplib_grp
     6612                            where buf_temp_grplib_grp.node-code = temp_grplib_found-grp.node-code
     6613                       no-error .
     6614                       if error-status :error
     6615                       then do:
     6616                           leave process-initial-grp.
     6617                       end.
     6618                       assign
     6619                           p-reposition-row = recid( buf_temp_grplib_grp )
     6620                           p-reposition-to-recid = yes
     6621                       .
     6622                       leave process-initial-grp.
     6623                   end.
     6624                   else do:
     6625                       run expand-item in this-procedure ( input temp_grplib_found-grp.node-code, input no ) no-error .
     6626                       if error-status :error
     6627                       then do:
     6628                           leave process-initial-grp.
     6629                       end.
     6630                       find first buf_temp_grplib_grp
     6631                               where buf_temp_grplib_grp.node-code = temp_grplib_found-grp.node-code
     6632                       no-error .
     6633                       if error-status :error
     6634                       then do:
     6635                           leave process-initial-grp.
     6636                       end.
     6637                       assign
     6638                           p-reposition-row = recid( buf_temp_grplib_grp )
     6639                           p-reposition-to-recid = yes
     6640                       .
     6641                   end.
     6642               end.
     6643           end.
     6644       end.
     6645   end.
     6646   END PROCEDURE.
     6647   PROCEDURE fill-db :
     6648   do
     6649   on error undo, return error
     6650   :
     6651   define input parameter parnode-code like ub.gds-grp.node-code no-undo .
     6652   define input parameter parupper-code like ub.gds-grp.node-code no-undo .
     6653     run ref/dtaxgrpu.p (input parnode-code,
     6654                    input parupper-code,
     6655                    input yes,
     6656                    input v-current-host-code,
     6657                    v-current-store-type,
     6658                    v-current-store-code) no-error.
     6659   end.
     6660   END PROCEDURE.
     6661   PROCEDURE fill-marg :
     6662   do
     6663   on error undo, return error
     6664   :
     6665   define input parameter p-node-code as integer      no-undo.
     6666   define variable v-focused-row       as integer  no-undo.
     6667   define variable v-repositioned-row  as integer  no-undo.
     6668   define variable v-margins-range     as integer  no-undo.
     6669   define variable v-margins-exists    as logical  no-undo.
     6670   define variable v-increase-range     as integer  no-undo.
     6671   define variable v-increase-exists    as logical  no-undo.
     6672   define variable v-min-marg          as decimal  no-undo.
     6673   define variable v-max-marg          as decimal  no-undo.
     6674   define variable v-increase-pc          as decimal  no-undo.
     6675   define variable v-round-method      as character   no-undo .
     6676   define variable v-base              as decimal     no-undo .
     6677   define variable v-rmethod-range     as integer     no-undo.
     6678   define variable v-rmethod-exists    as logical     no-undo.
     6679   define variable v-cli-type           as character no-undo .
     6680   define variable v-cli-code           as integer no-undo .
     6681   define variable v-income-cli-range   as integer no-undo .
     6682   define variable v-income-cli-exists  as logical no-undo .
     6683   define variable  v-notcorr         as character no-undo .
     6684   define variable  v-notcorr-range  as integer no-undo .
     6685   define variable  v-notcorr-exists as logical no-undo .
     6686   define variable  v-have-rights    as logical no-undo .
     6687       define buffer buf_gds-grp           for ub.gds-grp.
     6688       define buffer buf_temp_grplib_grp   for temp_grplib_grp.
     6689       assign
     6690           v-focused-row      = br-list :focused-row in frame Dlg-grp.
     6691           v-repositioned-row = current-result-row( "br-list" )
     6692       .
     6693       run ref/pr-marg.w (
     6694             input parparentproc
     6695           , input p-node-code
     6696       ) no-error.
     6697       if error-status :error
     6698       then do:
     6699           undo, return error "fill-marg: Ошибка при установке диапазона торговых наценок." + chr(10) + return-value.
     6700       end.
     6701       find first buf_temp_grplib_grp
     6702            where buf_temp_grplib_grp.node-code = p-node-code
     6703       no-error .
     6704       if error-status :error
     6705       then do:
     6706           undo, return error "fill-marg: Неверно задан код группы.".
     6707       end.
     6708       if v-grplib-not-fill-extra-info = yes
     6709       then do:
     6710           assign
     6711               v-margins-exists    = no
     6712               v-increase-exists   = no
     6713               v-rmethod-exists    = no
     6714           .
     6715       end.
     6716       else do:
     6717           run grp-obj-margin-value in this-procedure (
     6718                                   input p-node-code
     6719                                   , input v-current-store-type
     6720                                   , input v-current-store-code
     6721                                   , output v-min-marg
     6722                                   , output v-max-marg
     6723                                   , output v-increase-pc
     6724                                   , output v-round-method
     6725                                   , output v-base
     6726                                   , output v-margins-range
     6727                                   , output v-margins-exists
     6728                                   , output v-increase-range
     6729                                   , output v-increase-exists
     6730                                   , output v-rmethod-range
     6731                                   , output v-rmethod-exists
     6732           ) no-error .
     6733           if error-status :error
     6734           then do:
     6735               undo, return error "fill-marg: Ошибка определения границ наценок для группы." + chr(10) + return-value.
     6736           end.
     6737           assign
     6738               buf_temp_grplib_grp.min-marg = ( if v-margins-exists = yes then string( v-min-marg, "->>>>9.99" ) else "" )
     6739               buf_temp_grplib_grp.max-marg = ( if v-margins-exists = yes then string( v-max-marg, "->>>>9.99" ) else "" )
     6740               buf_temp_grplib_grp.increase-pc = ( if v-increase-exists = yes then v-increase-pc else buf_temp_grplib_grp.increase-pc)
     6741               buf_temp_grplib_grp.round-method = if v-rmethod-exists
     6742                                               then (v-round-method + chr(32) +
     6743                                                       (if lookup(v-round-method, 'Произвольно,Вверх,Коэффициент,9-99окончание':U) > 0
     6744                                                       then string(v-base, "->>>,>9.99":U)
     6745                                                       else "":U))
     6746                                               else buf_temp_grplib_grp.round-method
     6747           .
     6748           run grp-obj-income-cli-value in this-procedure (
     6749                                   input p-node-code
     6750                                   , input v-current-store-type
     6751                                   , input v-current-store-code
     6752                                   , output v-cli-type
     6753                                   , output v-cli-code
     6754                                   , output v-income-cli-range
     6755                                   , output v-income-cli-exists
     6756           ) no-error .
     6757           if error-status :error
     6758           then do:
     6759               undo, return error "fill-marg: Ошибка определения внутр поставщика для группы." + chr(10) + return-value.
     6760           end.
     6761           assign
     6762               buf_temp_grplib_grp.cli-type = ( if v-income-cli-exists = yes then  v-cli-type  else "" )
     6763               buf_temp_grplib_grp.cli-code = ( if v-income-cli-exists = yes then  v-cli-code  else 0 )
     6764           .
     6765               run grp-obj-notcorr-value in this-procedure (
     6766                                 input p-node-code
     6767                               , input v-current-store-type
     6768                               , input v-current-store-code
     6769                               , output v-notcorr
     6770                               , output v-notcorr-range
     6771                               , output v-notcorr-exists
     6772               ) no-error  .
     6773               if error-status :error
     6774               then do:
     6775                   undo, return error "change-grp: Ошибка определения ЗАПРЕТ КОР ОП." + chr(10) + return-value.
     6776               end.
     6777               assign
     6778                   buf_temp_grplib_grp.notcorr = ( if v-notcorr-exists = yes then  v-notcorr else "" )
     6779               .
     6780       end.
     6781       OPEN QUERY br-list FOR EACH temp_grplib_grp NO-LOCK by temp_grplib_grp.sort-name.
     6782       br-list :set-repositioned-row( v-focused-row, "ALWAYS" ) in frame Dlg-grp.
     6783       reposition br-list to row v-repositioned-row.
     6784   end.
     6785   END PROCEDURE.
     6786   PROCEDURE fill-output-parameters-on-exit :
     6787   do
     6788   on error undo, return error
     6789   :
     6790   define input parameter p-node-code as integer      no-undo.
     6791       define variable v-selected      as logical  init no  no-undo.
     6792       define variable v-is-terminal    as logical           no-undo.
     6793       define buffer buf_gds-grp           for ub.gds-grp.
     6794       define buffer buf_temp_grplib_grp   for temp_grplib_grp.
     6795       run grplib-is-terminal in this-procedure ( input p-node-code, output v-is-terminal ) no-error.
     6796       if error-status :error
     6797       then do:
     6798           undo, return error "fill-output-parameters-on-exit: Не удается определить, корневая группа или терминальная." + chr(10) + return-value.
     6799       end.
     6800       if lookup ( 'терм':U, p-button-list ) <> 0 and v-is-terminal = no
     6801       then do:
     6802               message "Требуется выбрать группу товаров, в которой нет других групп.".
     6803               apply "entry" to br-list in frame Dlg-grp.
     6804               undo, return "no-term".
     6805       end.
     6806       assign
     6807           p-recid-list = ""
     6808       .
     6809       for each buf_temp_grplib_grp
     6810          where buf_temp_grplib_grp.sel = "*"
     6811       :
     6812           find first buf_gds-grp no-lock
     6813                where buf_gds-grp.node-code = buf_temp_grplib_grp.node-code
     6814           no-error .
     6815           if error-status :error
     6816           then do:
     6817               undo, return error "fill-output-parameters-on-exit: Не найдена запись выбранной группы '"
     6818                                   + "'" + buf_temp_grplib_grp.full-name + "'".
     6819           end.
     6820           assign
     6821               p-recid-list = p-recid-list + ( if p-recid-list = "" then "" else "," ) + string( recid( buf_gds-grp ) )
     6822               v-selected = yes
     6823           .
     6824       end.
     6825       if v-selected = no
     6826       then do:
     6827           find first buf_gds-grp no-lock
     6828                where buf_gds-grp.node-code = p-node-code
     6829           no-error .
     6830           if not available buf_gds-grp
     6831           then do:
     6832               find first buf_temp_grplib_grp
     6833                    where buf_temp_grplib_grp.node-code = p-node-code
     6834               no-error .
     6835               if not available buf_temp_grplib_grp
     6836               then do:
     6837                   undo, return error "fill-output-parameters-on-exit: Неверно выбрана группа с кодом "
     6838                                       + string( p-node-code ).
     6839               end.
     6840               undo, return error "fill-output-parameters-on-exit: Не найдена запись выбранной группы '"
     6841                               + buf_temp_grplib_grp.full-name + "'".
     6842           end.
     6843           assign
     6844               p-recid-list = string( recid( buf_gds-grp ) )
     6845           .
     6846       end.
     6847       assign
     6848           gds-grp-row  = integer( entry( 1, p-recid-list ) )
     6849       .
     6850   assign
     6851   v-uf-List_ = (if gds-grp-row = ? then chr(63) else string(gds-grp-row))
     6852   .
     6853   run uf-set in this-procedure(
     6854       input  'gds-grp-p':U
     6855       ,input  g#userid
     6856       ,input v-uf-List_
     6857       ,input v-uf-Naim
     6858       ,input v-uf-print-graft
     6859       ,input v-uf-sort-gr
     6860       ,input v-uf-type-price
     6861       ,input v-uf-type-val
     6862   )  no-error .
     6863   end.
     6864   END PROCEDURE.
     6865   PROCEDURE fill-tt :
     6866   do
     6867   on error undo, return error
     6868   :
     6869   define input parameter parnode-code like ub.gds-grp.node-code no-undo .
     6870   define input parameter parupper-code like ub.gds-grp.node-code no-undo .
     6871   run ref/dtaxgrps.p (parnode-code,
     6872                  parupper-code,
     6873                  v-current-host-code,
     6874                  v-current-store-type,
     6875                  v-current-store-code) no-error.
     6876   end.
     6877   END PROCEDURE.
     6878   PROCEDURE find-grp-in-browse :
     6879   do
     6880   on error undo, return error
     6881   :
     6882   define input parameter p-search-grp-full-name   as character        no-undo.
     6883   define output parameter p-found                 as logical          no-undo.
     6884       define variable v-focused-row       as integer      no-undo.
     6885       define variable v-repositioned-row  as integer      no-undo.
     6886       define variable v-counter           as integer      no-undo.
     6887       define variable v-level             as integer      no-undo.
     6888       define buffer buf_temp_grplib_grp       for temp_grplib_grp.
     6889       assign
     6890           v-focused-row      = br-list :focused-row in frame Dlg-grp.
     6891           v-repositioned-row = current-result-row( "br-list" )
     6892       .
     6893       assign
     6894       v-level = num-entries( right-trim(p-search-grp-full-name, chr(47) ) , chr(47))
     6895       .
     6896       if v-found-grp-num  <> 0
     6897       then do:
     6898           assign
     6899               v-counter = 0
     6900           .
     6901           find first temp_grplib_found-grp
     6902                where temp_grplib_found-grp.level = v-level
     6903           no-error .
     6904           if not available temp_grplib_found-grp
     6905           then do:
     6906               undo, return error "Не найдено ни одной группы уровня " + string( v-level ).
     6907           end.
     6908           do v-counter = 1 to v-found-grp-num
     6909           :
     6910               find next temp_grplib_found-grp
     6911                   where temp_grplib_found-grp.level = v-level
     6912               no-error .
     6913               if not available temp_grplib_found-grp
     6914               then do:
     6915                   undo, return error "Не найдена следующая группа уровня " + string( v-level ).
     6916               end.
     6917           end.
     6918           find first buf_temp_grplib_grp
     6919                   where buf_temp_grplib_grp.node-code = temp_grplib_found-grp.node-code
     6920           no-error .
     6921           if not available buf_temp_grplib_grp
     6922           then do:
     6923               undo, return error "Найденной группы нет в списке групп".
     6924           end.
     6925           OPEN QUERY br-list FOR EACH temp_grplib_grp NO-LOCK by temp_grplib_grp.sort-name.
     6926           br-list :set-repositioned-row(v-focused-row, "ALWAYS") in frame Dlg-grp.
     6927           reposition br-list to recid recid( buf_temp_grplib_grp ).
     6928       end.
     6929       else do:
     6930           run grplib-find-grp-by-full-name (
     6931                 input fi-search :screen-value in frame Dlg-grp
     6932               , input yes
     6933               , output p-found
     6934           ).
     6935           if p-found = yes
     6936           then do:
     6937               found-group:
     6938               for each temp_grplib_found-grp no-lock
     6939               by temp_grplib_found-grp.level
     6940               :
     6941                   if temp_grplib_found-grp.level = v-level
     6942                   then do:
     6943                       leave.
     6944                   end.
     6945                   run expand-item in this-procedure (
     6946                         input temp_grplib_found-grp.node-code
     6947                       , input no
     6948                   ).
     6949               end.
     6950               find first temp_grplib_found-grp
     6951                    where temp_grplib_found-grp.level = v-level
     6952               no-error .
     6953               if not available temp_grplib_found-grp
     6954               then do:
     6955                   undo, return error "Нет последней найденной группы для уровня " + string( v-level ).
     6956               end.
     6957               find first buf_temp_grplib_grp
     6958                    where buf_temp_grplib_grp.node-code = temp_grplib_found-grp.node-code
     6959               no-error .
     6960               if not available buf_temp_grplib_grp
     6961               then do:
     6962                   undo, return error "Найденной группы нет в списке групп".
     6963               end.
     6964               OPEN QUERY br-list FOR EACH temp_grplib_grp NO-LOCK by temp_grplib_grp.sort-name.
     6965               br-list :set-repositioned-row(v-focused-row, "ALWAYS") in frame Dlg-grp.
     6966               reposition br-list to recid recid( buf_temp_grplib_grp ).
     6967           end.
     6968       end.
     6969       find next temp_grplib_found-grp
     6970           where temp_grplib_found-grp.level = v-level
     6971       no-error .
     6972       if available temp_grplib_found-grp
     6973       then do:
     6974           assign
     6975               v-found-grp-num  = v-found-grp-num + 1
     6976               b-search :label = "Далее"
     6977           .
     6978       end.
     6979       else do:
     6980           assign
     6981               v-found-grp-num  = 0
     6982               b-search :label = "Поиск"
     6983           .
     6984       end.
     6985   end.
     6986   END PROCEDURE.
     6987   PROCEDURE gds-grp_rum-fill_cb :
     6988   DEFINE INPUT PARAMETER p-target-bh AS handle NO-UNDO.
     6989   define input parameter p-processed-bh as handle no-undo .
     6990   define variable v-start-node-code as integer no-undo .
     6991   define variable v-full-name as character no-undo .
     6992   define buffer buf_temp_grplib_grp for temp_grplib_grp.
     6993   define buffer buf_gds-grp for ub.gds-grp.
     6994   define buffer child_gds-grp for ub.gds-grp.
     6995   CASE rum-option:
     6996     WHEN "all" THEN DO:
     6997        FOR EACH buf_gds-grp:
     6998           p-target-bh:BUFFER-CREATE.
     6999           p-target-bh:BUFFER-COPY(BUFFER buf_gds-grp:HANDLE).
     7000           run grplib-get-full-name in this-procedure ( input buf_gds-grp.node-code, output v-full-name) no-error.
     7001           p-target-bh::full-name = v-full-name.
     7002           p-target-bh:BUFFER-RELEASE.
     7003        END.
     7004     END.
     7005     WHEN "current" THEN DO:
     7006       if available temp_grplib_grp then do:
     7007         find first buf_gds-grp no-lock
     7008               where buf_gds-grp.node-code = temp_grplib_grp.node-code
     7009         no-error .
     7010         if error-status :error
     7011         then do:
     7012             undo, return error "gds-grp_rum-fill_cb: Не найдена запись выбранной группы '"
     7013                                 + "'" + temp_grplib_grp.full-name + "'".
     7014         end.
     7015         p-target-bh:find-first ( substitute("where node-code = &1", buf_gds-grp.node-code)) no-error .
     7016         if not p-target-bh:available then do:
     7017           p-target-bh:BUFFER-CREATE.
     7018           p-target-bh:BUFFER-COPY(BUFFER buf_gds-grp:HANDLE).
     7019           run grplib-get-full-name in this-procedure ( input buf_gds-grp.node-code, output v-full-name) no-error.
     7020           p-target-bh::full-name = v-full-name.
     7021           p-target-bh:BUFFER-RELEASE.
     7022         end.
     7023       END.
     7024     END.
     7025     WHEN "current+childs" THEN DO:
     7026       if available temp_grplib_grp then do:
     7027         find first buf_gds-grp no-lock
     7028               where buf_gds-grp.node-code = temp_grplib_grp.node-code
     7029         no-error .
     7030         if error-status :error
     7031         then do:
     7032             undo, return error "gds-grp_rum-fill_cb: Не найдена запись выбранной группы '"
     7033                                 + "'" + temp_grplib_grp.full-name + "'".
     7034         end.
     7035         v-start-node-code = buf_gds-grp.node-code.
     7036         p-target-bh:find-first ( substitute("where node-code = &1", buf_gds-grp.node-code)) no-error .
     7037         if not p-target-bh:available then do:
     7038           p-target-bh:BUFFER-CREATE.
     7039           p-target-bh:BUFFER-COPY(BUFFER buf_gds-grp:HANDLE).
     7040           run grplib-get-full-name in this-procedure ( input buf_gds-grp.node-code, output v-full-name) no-error.
     7041           p-target-bh::full-name = v-full-name.
     7042           p-target-bh:BUFFER-RELEASE.
     7043           p-processed-bh:BUFFER-CREATE.
     7044           p-processed-bh::node-code = buf_gds-grp.node-code.
     7045           p-processed-bh:BUFFER-COPY(BUFFER buf_gds-grp:HANDLE).
     7046           p-processed-bh::processed = no.
     7047           p-processed-bh:BUFFER-RELEASE.
     7048         end.
     7049         process-nodes:
     7050         do while yes
     7051         :
     7052             p-processed-bh:find-first( substitute(" where node-code = &1", v-start-node-code)).
     7053             p-processed-bh::processed = yes.
     7054             for each child_gds-grp no-lock
     7055               where child_gds-grp.upper-code = v-start-node-code
     7056             on error undo, return error
     7057             :
     7058               p-target-bh:find-first ( substitute("where node-code = &1", child_gds-grp.node-code)) no-error .
     7059               if not p-target-bh:available then do:
     7060                 p-target-bh:BUFFER-CREATE.
     7061                 p-target-bh:BUFFER-COPY(BUFFER child_gds-grp:HANDLE).
     7062                 run grplib-get-full-name in this-procedure ( input child_gds-grp.node-code, output v-full-name) no-error.
     7063                 p-target-bh::full-name = v-full-name.
     7064                 p-target-bh:BUFFER-RELEASE.
     7065               end.
     7066               p-processed-bh:BUFFER-CREATE.
     7067               p-processed-bh::node-code = child_gds-grp.node-code.
     7068               p-processed-bh::processed = no.
     7069               p-processed-bh:BUFFER-RELEASE.
     7070             end.
     7071             p-processed-bh:find-first( "where processed = no") no-error.
     7072             if not p-processed-bh:available
     7073             then do:
     7074               leave process-nodes.
     7075             end.
     7076             else do:
     7077               assign
     7078               v-start-node-code = p-processed-bh::node-code
     7079               .
     7080             end.
     7081         end.
     7082       END.
     7083     END.
     7084     WHEN "selected" THEN DO:
     7085       FOR EACH buf_temp_grplib_grp
     7086          where buf_temp_grplib_grp.sel = "*"
     7087       :
     7088           find first buf_gds-grp no-lock
     7089                where buf_gds-grp.node-code = buf_temp_grplib_grp.node-code
     7090           no-error .
     7091           if error-status :error
     7092           then do:
     7093               undo, return error "gds-grp_rum-fill_cb: Не найдена запись выбранной группы '"
     7094                                   + "'" + buf_temp_grplib_grp.full-name + "'".
     7095           end.
     7096         p-target-bh:find-first ( substitute("where node-code = &1", buf_gds-grp.node-code)) no-error .
     7097         if not p-target-bh:available then do:
     7098            p-target-bh:BUFFER-CREATE.
     7099            p-target-bh:BUFFER-COPY(BUFFER buf_gds-grp:HANDLE).
     7100            run grplib-get-full-name in this-procedure ( input buf_gds-grp.node-code, output v-full-name) no-error.
     7101            p-target-bh::full-name = v-full-name.
     7102            p-target-bh:BUFFER-RELEASE.
     7103         end.
     7104       END.
     7105     END.
     7106     WHEN "selected+child" THEN DO:
     7107       FOR EACH buf_temp_grplib_grp
     7108          where buf_temp_grplib_grp.sel = "*"
     7109       :
     7110         find first buf_gds-grp no-lock
     7111               where buf_gds-grp.node-code = buf_temp_grplib_grp.node-code
     7112         no-error .
     7113         if error-status :error
     7114         then do:
     7115             undo, return error "gds-grp_rum-fill_cb: Не найдена запись выбранной группы '"
     7116                                 + "'" + buf_temp_grplib_grp.full-name + "'".
     7117         end.
     7118         p-target-bh:find-first ( substitute("where node-code = &1", buf_gds-grp.node-code)) no-error .
     7119         if not p-target-bh:available then do:
     7120           p-target-bh:BUFFER-CREATE.
     7121           p-target-bh:BUFFER-COPY(BUFFER buf_gds-grp:HANDLE).
     7122           run grplib-get-full-name in this-procedure ( input buf_gds-grp.node-code, output v-full-name) no-error.
     7123           p-target-bh::full-name = v-full-name.
     7124           p-target-bh:BUFFER-RELEASE.
     7125           p-processed-bh:BUFFER-CREATE.
     7126           p-processed-bh::node-code = buf_gds-grp.node-code.
     7127           p-processed-bh::processed = no.
     7128           p-processed-bh:BUFFER-RELEASE.
     7129         end.
     7130         process-nodes:
     7131         do while yes
     7132         :
     7133             p-processed-bh:find-first( substitute(" where node-code = &1", v-start-node-code)).
     7134             p-processed-bh::processed = yes.
     7135             for each child_gds-grp no-lock
     7136               where child_gds-grp.upper-code = v-start-node-code
     7137             on error undo, return error
     7138             :
     7139               p-target-bh:find-first ( substitute("where node-code = &1", child_gds-grp.node-code)) no-error .
     7140               if not p-target-bh:available then do:
     7141                 p-target-bh:BUFFER-CREATE.
     7142                 p-target-bh:BUFFER-COPY(BUFFER child_gds-grp:HANDLE).
     7143                 run grplib-get-full-name in this-procedure ( input child_gds-grp.node-code, output v-full-name) no-error.
     7144                 p-target-bh::full-name = v-full-name.
     7145                 p-target-bh:BUFFER-RELEASE.
     7146               end.
     7147               p-processed-bh:BUFFER-CREATE.
     7148               p-processed-bh::node-code = child_gds-grp.node-code.
     7149               p-processed-bh::processed = no.
     7150               p-processed-bh:BUFFER-RELEASE.
     7151             end.
     7152             p-processed-bh:find-first( "where processed = no") no-error.
     7153             if not p-processed-bh:available
     7154             then do:
     7155               leave process-nodes.
     7156             end.
     7157             else do:
     7158               assign
     7159               v-start-node-code = p-processed-bh::node-code
     7160               .
     7161             end.
     7162         end.
     7163       END.
     7164     END.
     7165   END CASE.
     7166   END PROCEDURE.
     7167   PROCEDURE get-current-recid :
     7168   do
     7169   on error undo, return error
     7170   :
     7171   define input parameter p-node-code as integer      no-undo.
     7172   define output parameter p-gds-grp-recid as recid   no-undo.
     7173       define buffer buf_gds-grp       for ub.gds-grp.
     7174       find first buf_gds-grp no-lock
     7175            where buf_gds-grp.node-code = p-node-code
     7176       no-error .
     7177       if not available buf_gds-grp
     7178       then do:
     7179           undo, return error "get-current-recid: Не найдена группа." .
     7180       end.
     7181       assign
     7182           p-gds-grp-recid = recid( buf_gds-grp )
     7183       .
     7184   end.
     7185   END PROCEDURE.
     7186   PROCEDURE get-first-char :
     7187   do
     7188   on error undo, return error
     7189   :
     7190   define input parameter p-node-code      as integer      no-undo.
     7191   define input parameter p-terminal       as logical      no-undo.
     7192   define input parameter p-calc-terminal  as logical      no-undo.
     7193   define output parameter p-prefix        as character    no-undo.
     7194   define variable v-name          as character    no-undo.
     7195   define variable v-is-terminal   as logical      no-undo.
     7196   define variable v-have-goods    as logical      no-undo.
     7197   define buffer buf_gds-grp               for ub.gds-grp.
     7198   define buffer buf_temp_grplib_grp       for temp_grplib_grp.
     7199   if p-calc-terminal = yes
     7200   then do:
     7201       run grplib-is-terminal in this-procedure (
     7202             input p-node-code
     7203           , output v-is-terminal
     7204       ) no-error .
     7205       if error-status :error
     7206       then do:
     7207           undo, return error "get-first-char: Ошибка при определении типа группы (терм/корн).".
     7208       end.
     7209   end.
     7210   else do:
     7211       assign
     7212           v-is-terminal = p-terminal
     7213       .
     7214   end.
     7215   if v-is-terminal = yes
     7216   then do:
     7217       run grplib-have-goods in this-procedure (
     7218             input p-node-code
     7219           , output v-have-goods
     7220       ) no-error .
     7221       if error-status :error
     7222       then do:
     7223           undo, return error "get-first-char: Ошибка определения наличия товаров в группе." + chr(10) + return-value.
     7224       end.
     7225       if v-have-goods = yes
     7226       then do:
     7227           assign
     7228               p-prefix = "•"
     7229           .
     7230       end.
     7231       else do:
     7232           assign
     7233               p-prefix = " "
     7234           .
     7235       end.
     7236   end.
     7237   else do:
     7238       find first buf_temp_grplib_grp no-lock
     7239            where buf_temp_grplib_grp.upper-code = p-node-code
     7240       no-error.
     7241       if available buf_temp_grplib_grp
     7242       then do:
     7243           assign
     7244               p-prefix = "«"
     7245           .
     7246       end.
     7247       else do:
     7248           assign
     7249               p-prefix = "»"
     7250           .
     7251       end.
     7252   end.
     7253   end.
     7254   END PROCEDURE.
     7255   PROCEDURE get-row-amount :
     7256   do
     7257   on error undo, return error
     7258   :
     7259   define output parameter p-row-amount as integer      no-undo.
     7260       define buffer buf_temp_grplib_grp       for temp_grplib_grp.
     7261       for each buf_temp_grplib_grp
     7262       :
     7263           assign
     7264               p-row-amount = p-row-amount + 1
     7265           .
     7266       end.
     7267   end.
     7268   END PROCEDURE.
     7269   PROCEDURE move-item :
     7270   do
     7271   on error undo, return error
     7272   :
     7273   define input parameter p-node-code  as integer      no-undo.
     7274   define input parameter p-upper-code as integer      no-undo.
     7275       define variable v-node-full-name    as character    no-undo.
     7276       define variable v-upper-full-name   as character    no-undo.
     7277       define variable v-focused-row       as integer      no-undo.
     7278       define variable v-repositioned-row  as integer      no-undo.
     7279       define variable v-have-goods        as logical      no-undo.
     7280       define buffer buf_gds-grp           for ub.gds-grp.
     7281       define buffer buf_upper_gds-grp     for ub.gds-grp.
     7282       define buffer buf_temp_grplib_grp   for temp_grplib_grp.
     7283   if session :set-wait-state( "compiler" ) then.
     7284       run grplib-have-goods in this-procedure (
     7285             input p-upper-code
     7286           , output v-have-goods
     7287       ) no-error .
     7288       if error-status :error
     7289       then do:
     7290           undo, return error "move-item: Ошибка определения наличия товаров в группе." + chr(10) + return-value.
     7291       end.
     7292       if v-have-goods = yes
     7293       then do:
     7294               message
     7295                   "В эту группу переместить нельзя, т.к. в одной группе"
     7296                   skip "не могут быть одновременно подгруппы и товары.".
     7297               apply "entry" to br-list in frame Dlg-grp.
     7298               return no-apply.
     7299       end.
     7300       run grplib-get-full-name in this-procedure (
     7301               input p-node-code
     7302               , output v-node-full-name
     7303       ) no-error .
     7304       if error-status :error
     7305       then do:
     7306           undo, return error "move-item: Ошибка вычисления полного имени перемещаемой группы".
     7307       end.
     7308       run grplib-get-full-name in this-procedure (
     7309               input p-upper-code
     7310               , output v-upper-full-name
     7311       ) no-error .
     7312       if error-status :error
     7313       then do:
     7314           undo, return error "move-item: Ошибка вычисления полного имени группы".
     7315       end.
     7316       if v-upper-full-name begins v-node-full-name
     7317       then do:
     7318           message
     7319           "Группу нельзя переместить в ее собственную подгруппу."
     7320           view-as alert-box.
     7321           undo, return.
     7322       end.
     7323       do transaction
     7324       on error undo, return error "move-item: Ошибка перемещения группы.".
     7325           find first buf_gds-grp exclusive-lock
     7326               where buf_gds-grp.node-code = p-node-code
     7327           no-error .
     7328           if not available buf_gds-grp
     7329           then do:
     7330               undo, return error "move-item: Не найдена группа для перемещения.".
     7331           end.
     7332           assign
     7333               buf_gds-grp.upper-code = p-upper-code
     7334           .
     7335       end.
     7336       assign
     7337           p-recid-list = string( recid( buf_gds-grp ) )
     7338           gds-grp-row  = recid( buf_gds-grp )
     7339       .
     7340       run UI-on in this-procedure no-error .
     7341       if error-status :error
     7342       then do:
     7343           undo, return error "move-item: Ошибка при загрузке дерева групп." + chr(10) + return-value.
     7344       end.
     7345   end.
     7346   END PROCEDURE.
     7347   PROCEDURE press-arch :
     7348   do
     7349   on error undo, return error
     7350   :
     7351   define input parameter p-node-code as integer      no-undo.
     7352   define variable v-allow-arch     as logical           no-undo.
     7353   define buffer buf_temp_grplib_grp   for temp_grplib_grp.
     7354   define buffer buf_gds-grp           for ub.gds-grp.
     7355   define buffer buf_goods             for ub.goods.
     7356       for each tt-goods:
     7357           delete tt-goods.
     7358       end.
     7359       for each tt-clients:
     7360           delete tt-clients.
     7361       end.
     7362       for each buf_goods
     7363          where buf_goods.grp-code = p-node-code
     7364       :
     7365           create tt-goods.
     7366           buffer-copy buf_goods to tt-goods.
     7367       end.
     7368       create tt-clients.
     7369       assign
     7370           tt-clients.obj-type = v-current-store-type
     7371           tt-clients.obj-code = v-current-store-code
     7372       .
     7373   define variable vss-include-info23 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7374   do:
     7375     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     7376       (input  v-cntxt-db-num
     7377       ,input  v-cntxt-userid
     7378       ,input  0
     7379       ,input  'actn_reference_archive':U
     7380       ,input  'firm':U
     7381       ,input  v-cntxt-host-code-obj
     7382       ,input  '':U
     7383       ,input  0
     7384       ,input  0
     7385       ,input  0
     7386       ,input  0
     7387       ,input  yes
     7388       ,output v-allow-arch
     7389       )  .
     7390   end.
     7391       if v-allow-arch = yes
     7392       then do:
     7393           run arc/gds_inf.w (input parparentproc, v-current-store-type, v-current-store-code) no-error .
     7394           if error-status :error
     7395           then do:
     7396               undo, return error "Ошибка при выводе архивной информации по товарам группы." + chr(10) + return-value.
     7397           end.
     7398       end.
     7399   end.
     7400   END PROCEDURE.
     7401   PROCEDURE print-browse :
     7402   define variable Line as character no-undo.
     7403   define variable v-vat-pc as decimal no-undo .
     7404   define variable v-slt-pc as decimal no-undo .
     7405   define variable date_string as character no-undo.
     7406   define buffer buf_temp_grplib_grp for temp_grplib_grp.
     7407   define buffer buf_tax-rate-gds-grp for ub.tax-rate-gds-grp.
     7408   DEFINE FRAME brFrame
     7409   buf_temp_grplib_grp.name          format "X(121)"     column-label " Наименование группы"
     7410   buf_temp_grplib_grp.calc-method   format "X(11)"      column-label " Исходная"
     7411   buf_temp_grplib_grp.increase-pc   format "->>>>9.99"  column-label " Наценка"
     7412   buf_temp_grplib_grp.min-marg      format "X(10)"  column-label " Мин.Нац."
     7413   buf_temp_grplib_grp.max-marg      format "X(10)"  column-label " Макс.Нац."
     7414   buf_temp_grplib_grp.round-method  format "X(22)"  column-label "Метод округл"
     7415   v-vat-pc                          format "99.99"  column-label "НДС"
     7416   v-slt-pc                          format "99.99"  column-label "НП"
     7417   HEADER  date_string AT 5 format "X(35)"
     7418   string( "Страница " ) format "X(9)" AT 85 PAGE-NUMBER(PrnLibStream) AT 95 FORMAT ">>9" SKIP
     7419   Line format "X(198)" AT 1
     7420   with width 232 down stream-io use-text    .
     7421   Line = fill("-", 198).
     7422   date_string = cur-time-print() .
     7423   run prn-lib-open-stream  in this-procedure (
     7424         input parparentproc
     7425       , input 43
     7426       , input yes
     7427       , input no
     7428   ).
     7429   PUT  STREAM PrnLibStream
     7430       SPACE(25) ( frame Dlg-grp:title )
     7431       format "x(90)" SKIP(1)
     7432   .
     7433   FORM HEADER
     7434   Line format "X(198)" AT 1 SKIP
     7435   "Продолжение - на следующей странице" AT 30 SKIP
     7436   with FRAME BottomFrame width 232 PAGE-BOTTOM NO-LABELS NO-BOX .
     7437   VIEW  STREAM PrnLibStream FRAME BottomFrame .
     7438   FORM with FRAME BrFrame  .
     7439   run waitfram-show in this-procedure ("Ждите...").
     7440   FOR EACH buf_temp_grplib_grp :
     7441     FIND LAST buf_tax-rate-gds-grp No-LOCK WHERE
     7442               buf_tax-rate-gds-grp.node-code = buf_temp_grplib_grp.node-code AND
     7443               buf_tax-rate-gds-grp.tax-code = integer('1':U) AND
     7444               buf_tax-rate-gds-grp.host-code = 0 AND
     7445               buf_tax-rate-gds-grp.obj-type = "" AND
     7446               buf_tax-rate-gds-grp.obj-code = 0 NO-ERROR.
     7447     if avail buf_tax-rate-gds-grp then do:
     7448   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7449   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftaxval in g#library
     7450     (input  ?
     7451     ,input  buf_tax-rate-gds-grp.tax-code
     7452     ,input  buf_tax-rate-gds-grp.rate-code
     7453     ,input  ?
     7454     ,input  v-current-host-code
     7455     ,input  v-current-store-type
     7456     ,input  v-current-store-code
     7457     ,output v-vat-pc
     7458     ) no-error .
     7459     end.
     7460     FIND LAST buf_tax-rate-gds-grp No-LOCK WHERE
     7461               buf_tax-rate-gds-grp.node-code = buf_temp_grplib_grp.node-code AND
     7462               buf_tax-rate-gds-grp.tax-code = integer('2':U) AND
     7463               buf_tax-rate-gds-grp.host-code = 0 AND
     7464               buf_tax-rate-gds-grp.obj-type = "" AND
     7465               buf_tax-rate-gds-grp.obj-code = 0 NO-ERROR.
     7466     if avail buf_tax-rate-gds-grp then do:
     7467   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7468   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftaxval in g#library
     7469     (input  ?
     7470     ,input  buf_tax-rate-gds-grp.tax-code
     7471     ,input  buf_tax-rate-gds-grp.rate-code
     7472     ,input  ?
     7473     ,input  v-current-host-code
     7474     ,input  v-current-store-type
     7475     ,input  v-current-store-code
     7476     ,output v-slt-pc
     7477     ) no-error .
     7478     end.
     7479     DISPLAY stream PrnLibStream
     7480     buf_temp_grplib_grp.name
     7481     buf_temp_grplib_grp.calc-method
     7482     buf_temp_grplib_grp.increase-pc
     7483     buf_temp_grplib_grp.min-marg
     7484     buf_temp_grplib_grp.max-marg
     7485     buf_temp_grplib_grp.round-method
     7486     v-vat-pc
     7487     v-slt-pc
     7488     with frame BrFrame.
     7489     down stream PrnLibStream
     7490     with frame BrFrame.
     7491   END.
     7492   HIDE  STREAM PrnLibStream FRAME BottomFrame .
     7493   HIDE  STREAM PrnLibStream FRAME BrFrame.
     7494   output  STREAM PrnLibStream CLOSE.
     7495   run waitfram-hide in this-procedure .
     7496   run prn-lib-prn-file in this-procedure (
     7497         input parparentproc
     7498       , input 8
     7499   ).
     7500   END PROCEDURE.
     7501   PROCEDURE print-grp :
     7502   do
     7503   on error undo, return error
     7504   :
     7505   define input parameter p-node-code as integer      no-undo.
     7506   define buffer buf_gds-grp       for ub.gds-grp.
     7507   if print-option = "":U then do:
     7508       run gbl/pop-up.p (b-print:handle in frame Dlg-grp, no) no-error.
     7509       if error-status:error then do:
     7510           assign print-option = "":U.
     7511           return no-apply.
     7512        end.
     7513   end.
     7514       find first buf_gds-grp no-lock
     7515           where buf_gds-grp.node-code = p-node-code
     7516       no-error.
     7517       if not available buf_gds-grp
     7518       then do:
     7519           undo, return error "Неверно выбрана группа.".
     7520       end.
     7521       if print-option = "browse":U then do:
     7522               run print-browse in this-procedure no-error.
     7523       end.
     7524           else do:
     7525       run rep/r-gdsgrp.p ( input parparentproc, input recid( buf_gds-grp ), input print-option ) no-error .
     7526       end.
     7527       if error-status :error
     7528       then do:
     7529           assign
     7530                   print-option = "":U
     7531                   .
     7532           undo, return error "Ошибка печати групп товаров.".
     7533       end.
     7534       apply "entry" to br-list in frame Dlg-grp.
     7535   end.
     7536   END PROCEDURE.
     7537   PROCEDURE proc-b-rum :
     7538   define input parameter p-rum-option as character no-undo .
     7539   define variable v-radio-button-parameter as character no-undo .
     7540   define variable v-node-code as integer no-undo .
     7541   define buffer buf_gds-grp for ub.gds-grp.
     7542   if available temp_grplib_grp then do:
     7543     v-node-code = temp_grplib_grp.node-code.
     7544   end.
     7545   if p-rum-option = 'xml-file-import':U then do:
     7546     v-radio-button-parameter = 'xml-file-import':U.
     7547   end.
     7548   else do:
     7549     v-radio-button-parameter = ('batchwork-export':U + chr(44) + 'batchwork-routing':U) .
     7550   end.
     7551   run str/diallog.w (
     7552         input parParentProc
     7553       , input this-procedure
     7554       , input "utl/thbjrumr.w":U
     7555       , input 'gds-grp':U + chr(4) + v-radio-button-parameter
     7556       , input no
     7557       , input "&Стоп"
     7558       , input substitute("Операции над группами товаров") )  no-error .
     7559   if p-rum-option = 'xml-file-import':U then do:
     7560     if v-node-code > 0 then do:
     7561       find first buf_gds-grp no-lock
     7562             where buf_gds-grp.node-code = v-node-code
     7563       no-error.
     7564     end.
     7565     else do:
     7566       find first buf_gds-grp no-lock.
     7567     end.
     7568     if not available buf_gds-grp
     7569     then do:
     7570         undo, return error "proc-b-rum: Не найдена группа в БД".
     7571     end.
     7572     assign
     7573     p-recid-list = string( recid( buf_gds-grp ) )
     7574     gds-grp-row  = recid( buf_gds-grp )
     7575     .
     7576     run UI-on in this-procedure no-error .
     7577     if error-status :error
     7578     then do:
     7579         undo, return error "proc-b-rum: Ошибка при загрузке дерева групп.".
     7580     end.
     7581   end.
     7582   END PROCEDURE.
     7583   PROCEDURE select-and-move-item :
     7584   do
     7585   on error undo, return error
     7586   :
     7587   define input parameter p-node-code as integer      no-undo.
     7588       define variable v-upper-code        as integer           no-undo.
     7589       define variable v-upper-recid-list  as character         no-undo.
     7590       define variable v-yesno             as logical           no-undo.
     7591       define variable v-node-full-name    as character         no-undo.
     7592       define variable v-upper-full-name   as character         no-undo.
     7593       define variable  v-have-rights    as logical no-undo .
     7594       define buffer buf_gds-grp       for ub.gds-grp.
     7595       run check-rights-for-change-grp in this-procedure (p-node-code,
     7596           output v-have-rights
     7597       ) no-error.
     7598       if error-status :error
     7599       or v-have-rights = no
     7600       then do:
     7601           message
     7602             vss-workfile vss-revision vss-description
     7603             skip "Нет прав на изменение справочника групп товаров."
     7604             skip "Удаление группы невозможно."
     7605             skip return-value
     7606             skip trim(error-status :get-message(1))
     7607                  trim(error-status :get-message(2))
     7608                  trim(error-status :get-message(3))
     7609           view-as alert-box error.
     7610           undo, return error .
     7611       end.
     7612       if p-node-code = v-root-code
     7613       then do:
     7614           message
     7615           "Корневую группу переместить невозможно."
     7616           view-as alert-box warning.
     7617           undo, return .
     7618       end.
     7619       find first buf_gds-grp no-lock
     7620            where buf_gds-grp.node-code = p-node-code
     7621       no-error .
     7622       if error-status :error
     7623       then do:
     7624           undo, return error "select-and-move-item: Группа не найдена в базе данных.".
     7625       end.
     7626       assign
     7627           v-upper-recid-list = string( recid( buf_gds-grp ) )
     7628       .
     7629       run ref/gds-grp.w (
     7630             input parparentproc
     7631           , input "buttons-for-move"
     7632           , input p-current-obj-type
     7633           , input p-current-obj-code
     7634           , input-output v-upper-recid-list
     7635       ) no-error .
     7636       if error-status :error
     7637       then do:
     7638           message
     7639             vss-workfile vss-revision vss-description
     7640             skip "Ошибка выбора группы для перемещения."
     7641             skip return-value
     7642             skip trim(error-status :get-message(1))
     7643                  trim(error-status :get-message(2))
     7644                  trim(error-status :get-message(3))
     7645                  trim(error-status :get-message(4))
     7646                  trim(error-status :get-message(5))
     7647           view-as alert-box error.
     7648           undo, return no-apply .
     7649       end.
     7650       find first buf_gds-grp no-lock
     7651            where recid( buf_gds-grp ) = integer( entry( 1, v-upper-recid-list ) )
     7652       no-error .
     7653       if error-status :error
     7654       then do:
     7655           undo, return error "Группа не найдена.".
     7656       end.
     7657       run grplib-get-full-name in this-procedure (  input p-node-code
     7658                                                   , output v-node-full-name
     7659       ) no-error .
     7660       if error-status :error
     7661       then do:
     7662           undo, return error "Ошибка вычисления полного имени перемещаемой группы.".
     7663       end.
     7664       run grplib-get-full-name in this-procedure (  input buf_gds-grp.node-code
     7665                                                   , output v-upper-full-name
     7666       ) no-error .
     7667       if error-status :error
     7668       then do:
     7669           undo, return error "Ошибка вычисления полного имени новой группы".
     7670       end.
     7671       message
     7672           "Переместить группу"
     7673           skip "    '" + v-node-full-name + "'"
     7674           skip "в группу"
     7675           skip "    '" + v-upper-full-name + "'"
     7676       view-as alert-box question
     7677       buttons yes-no
     7678       title "Перемещение группы"
     7679       update v-yesno.
     7680       if v-yesno = no
     7681       then do:
     7682       end.
     7683       else do:
     7684           run move-item in this-procedure ( input p-node-code
     7685                                           , input buf_gds-grp.node-code
     7686           ) no-error.
     7687           if error-status :error
     7688           then do:
     7689               message
     7690               vss-workfile vss-revision vss-description
     7691               skip "Ошибка перемещения группы."
     7692               skip return-value
     7693               skip trim(error-status :get-message(1))
     7694                   trim(error-status :get-message(2))
     7695                   trim(error-status :get-message(3))
     7696                   trim(error-status :get-message(4))
     7697                   trim(error-status :get-message(5))
     7698               view-as alert-box error.
     7699               undo, return no-apply .
     7700           end.
     7701       end.
     7702   end.
     7703   END PROCEDURE.
     7704   PROCEDURE UI-on :
     7705   do
     7706   on error undo, return error
     7707   :
     7708   define variable v-reposition-row        as integer          no-undo.
     7709   define variable v-focused-row           as integer          no-undo.
     7710   define variable v-reposition-to-recid   as logical init no  no-undo.
     7711   define variable v-enable-change-grp     as logical          no-undo.
     7712   define variable v-margins-range         as integer          no-undo.
     7713   define variable v-margins-exists        as logical          no-undo.
     7714   define variable v-increase-range         as integer          no-undo.
     7715   define variable v-increase-exists        as logical          no-undo.
     7716   define variable v-min-marg              as decimal          no-undo.
     7717   define variable v-max-marg              as decimal          no-undo.
     7718   define variable v-increase-pc              as decimal          no-undo.
     7719   define variable v-have-goods            as logical          no-undo.
     7720   define variable v-round-method      as character   no-undo .
     7721   define variable v-base                  as decimal no-undo .
     7722   define variable v-rmethod-range     as integer     no-undo.
     7723   define variable v-rmethod-exists    as logical     no-undo.
     7724   define variable v-cli-type          as character no-undo .
     7725   define variable v-cli-code          as integer     no-undo.
     7726   define variable v-income-cli-range    as integer  no-undo.
     7727   define variable v-income-cli-exists   as logical  no-undo.
     7728   define variable v-dop                   as character no-undo .
     7729   define variable v-full-name             as character    no-undo.
     7730   define variable v-sort-name             as character    no-undo.
     7731   define variable  v-notcorr         as character no-undo .
     7732   define variable  v-notcorr-range  as integer no-undo .
     7733   define variable  v-notcorr-exists as logical no-undo .
     7734   define buffer buf_gds-grp           for ub.gds-grp.
     7735   define buffer buf_temp_grplib_grp   for temp_grplib_grp.
     7736   define variable vss-include-info26 as character format "X(65)" no-undo
     7737   initial "@(#)$Workfile$ $Revision$".
     7738   do:
     7739     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run actn-grp in g#library2
     7740       ( output v-enable-change-grp
     7741       )  .
     7742   end.
     7743   IF NOT v-enable-change-grp then do:
     7744   define variable vss-include-info27 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7745   do:
     7746     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     7747       (input  v-cntxt-db-num
     7748       ,input  v-cntxt-userid
     7749       ,input  0
     7750       ,input  'actn_reference_groups-edit':U
     7751       ,input  'firm':U
     7752       ,input  v-cntxt-host-code-obj
     7753       ,input  '':U
     7754       ,input  0
     7755       ,input  0
     7756       ,input  0
     7757       ,input  0
     7758       ,input  no
     7759       ,output v-enable-change-grp
     7760       )  .
     7761   end.
     7762   end.
     7763   run grplib-get-root-code in this-procedure ( output v-root-code ) no-error.
     7764   if error-status :error
     7765   then do:
     7766       undo, return error "Не найден корневой узел." + chr(10) + return-value.
     7767   end.
     7768   if v-from-b-gds then do:
     7769     run uf-get in this-procedure(
     7770         input  'gds-grp-p':U
     7771         ,input  g#userid
     7772         ,output v-uf-List_
     7773         ,output v-uf-Naim
     7774         ,output v-uf-print-graft
     7775         ,output v-uf-sort-gr
     7776         ,output v-uf-type-price
     7777         ,output v-uf-type-val
     7778     )  no-error .
     7779     if not error-status:error then
     7780     assign
     7781     v-dop = string((if v-uf-List_ =  chr(63) then ? else integer(v-uf-LIst_)))
     7782     .
     7783     if v-dop = v-before-dop then do:
     7784       assign
     7785       gds-grp-row = v-old-recid
     7786       .
     7787     end.
     7788     else do:
     7789       assign
     7790       gds-grp-row = (if v-uf-List_ =  chr(63) then ? else integer(v-uf-LIst_))
     7791       .
     7792     end.
     7793     assign
     7794     v-from-b-gds = no
     7795     v-old-recid-list = "":U.
     7796   end.
     7797   else do:
     7798     if p-recid-list = '' then do:
     7799     run uf-get in this-procedure(
     7800         input  'gds-grp-p':U
     7801         ,input  g#userid
     7802         ,output v-uf-List_
     7803         ,output v-uf-Naim
     7804         ,output v-uf-print-graft
     7805         ,output v-uf-sort-gr
     7806         ,output v-uf-type-price
     7807         ,output v-uf-type-val
     7808     )  no-error .
     7809     if not error-status:error then
     7810     assign
     7811     gds-grp-row = (if v-uf-List_ =  chr(63) then ? else integer(v-uf-LIst_))
     7812     .
     7813   end.
     7814   end.
     7815   find first buf_gds-grp no-lock
     7816        where buf_gds-grp.node-code = v-root-code
     7817   no-error .
     7818   if error-status :error
     7819   then do:
     7820       message
     7821         vss-workfile vss-revision vss-description
     7822         skip "Не найдена запись корневого узла."
     7823         skip return-value
     7824         skip trim(error-status :get-message(1))
     7825              trim(error-status :get-message(2))
     7826              trim(error-status :get-message(3))
     7827              trim(error-status :get-message(4))
     7828              trim(error-status :get-message(5))
     7829       view-as alert-box error.
     7830       undo, return error .
     7831   end.
     7832   if buf_gds-grp.is-term = yes
     7833   then do:
     7834       run grplib-have-goods in this-procedure (
     7835             input buf_gds-grp.node-code
     7836           , output v-have-goods
     7837       ) no-error .
     7838       if error-status :error
     7839       then do:
     7840           undo, return error "move-item: Ошибка определения наличия товаров в группе." + chr(10) + return-value.
     7841       end.
     7842   end.
     7843   for each buf_temp_grplib_grp
     7844   :
     7845       delete buf_temp_grplib_grp.
     7846   end.
     7847   create buf_temp_grplib_grp.
     7848   assign
     7849       buf_temp_grplib_grp.node-code   = buf_gds-grp.node-code
     7850       buf_temp_grplib_grp.upper-code  = buf_gds-grp.upper-code
     7851       buf_temp_grplib_grp.level       = 0
     7852       buf_temp_grplib_grp.mark        = ( if v-have-goods = yes then "•" else " " )
     7853       buf_temp_grplib_grp.full-name   = chr(4)
     7854       buf_temp_grplib_grp.sort-name   = chr(4)
     7855       buf_temp_grplib_grp.name        = buf_gds-grp.node-name
     7856       buf_temp_grplib_grp.increase-pc = buf_gds-grp.increase-pc
     7857       buf_temp_grplib_grp.calc-method = buf_gds-grp.calc-method
     7858       buf_temp_grplib_grp.print-code  = buf_gds-grp.print-code
     7859   .
     7860   if v-grplib-not-fill-extra-info = yes
     7861   then do:
     7862       assign
     7863           v-margins-exists    = no
     7864           v-increase-exists   = no
     7865           v-rmethod-exists    = no
     7866       .
     7867   end.
     7868   else do:
     7869       run grp-obj-margin-value in this-procedure (
     7870                                 input 0
     7871                               , input v-current-store-type
     7872                               , input v-current-store-code
     7873                               , output v-min-marg
     7874                               , output v-max-marg
     7875                               , output v-increase-pc
     7876                               , output v-round-method
     7877                               , output v-base
     7878                               , output v-margins-range
     7879                               , output v-margins-exists
     7880                               , output v-increase-range
     7881                               , output v-increase-exists
     7882                               , output v-rmethod-range
     7883                               , output v-rmethod-exists
     7884       ) no-error  .
     7885       if error-status :error
     7886       then do:
     7887           undo, return error "UI-on: Ошибка определения наценок и/или границ наценок для корневой группы." + chr(10) + return-value.
     7888       end.
     7889       assign
     7890           buf_temp_grplib_grp.min-marg = ( if v-margins-exists = yes then string( v-min-marg, "->>>>9.99" ) else "" )
     7891           buf_temp_grplib_grp.max-marg = ( if v-margins-exists = yes then string( v-max-marg, "->>>>9.99" ) else "" )
     7892           buf_temp_grplib_grp.increase-pc = ( if v-increase-exists = yes then v-increase-pc else buf_temp_grplib_grp.increase-pc )
     7893       .
     7894       run grp-obj-income-cli-value in this-procedure (
     7895                               input 0
     7896                               , input v-current-store-type
     7897                               , input v-current-store-code
     7898                               , output v-cli-type
     7899                               , output v-cli-code
     7900                               , output v-income-cli-range
     7901                               , output v-income-cli-exists
     7902       ) no-error  .
     7903       if error-status :error
     7904       then do:
     7905           undo, return error "UI-on: Ошибка определения внутреннего поставщика для корневой группы." + chr(10) + return-value.
     7906       end.
     7907       assign
     7908           buf_temp_grplib_grp.cli-type = ( if v-income-cli-exists = yes then  v-cli-type else "" )
     7909           buf_temp_grplib_grp.cli-code = ( if v-income-cli-exists = yes then  v-cli-code else 0 )
     7910       .
     7911               run grp-obj-notcorr-value in this-procedure (
     7912                                 input 0
     7913                               , input v-current-store-type
     7914                               , input v-current-store-code
     7915                               , output v-notcorr
     7916                               , output v-notcorr-range
     7917                               , output v-notcorr-exists
     7918               ) no-error  .
     7919               if error-status :error
     7920               then do:
     7921                   undo, return error "change-grp: Ошибка определения ЗАПРЕТ КОР ОП." + chr(10) + return-value.
     7922               end.
     7923               assign
     7924                   buf_temp_grplib_grp.notcorr = ( if v-notcorr-exists = yes then  v-notcorr else "" )
     7925               .
     7926   end.
     7927   for each buf_gds-grp no-lock
     7928      where buf_gds-grp.upper-code = v-root-code
     7929   :
     7930       run grplib-get-full-name in this-procedure (
     7931             input buf_gds-grp.node-code
     7932           , output v-full-name
     7933       ) no-error .
     7934       if error-status :error
     7935       then do:
     7936           undo, return error "create-new-line: Ошибка вычисления полного имени группы." .
     7937       end.
     7938       run grplib-get-sort-name in this-procedure (
     7939             input buf_gds-grp.node-code
     7940           , output v-sort-name
     7941       ) no-error .
     7942       if error-status :error
     7943       then do:
     7944           undo, return error "create-new-line: Ошибка вычисления полного имени группы." .
     7945       end.
     7946       run create-new-line in this-procedure (
     7947             input buf_gds-grp.node-code
     7948           , input buf_gds-grp.upper-code
     7949           , input 1
     7950           , input buf_gds-grp.is-term
     7951           , input buf_gds-grp.node-name
     7952           , input buf_gds-grp.print-code
     7953           , input buf_gds-grp.increase-pc
     7954           , input buf_gds-grp.calc-method
     7955           , input "":U
     7956           , input "":U
     7957       ) no-error .
     7958       if error-status :error
     7959       then do:
     7960           message
     7961             vss-workfile vss-revision vss-description
     7962             skip "UI-on: Ошибка добавления строки в список групп."
     7963             skip return-value
     7964             skip trim(error-status :get-message(1))
     7965                  trim(error-status :get-message(2))
     7966                  trim(error-status :get-message(3))
     7967                  trim(error-status :get-message(4))
     7968                  trim(error-status :get-message(5))
     7969           view-as alert-box error.
     7970           undo, return error .
     7971       end.
     7972   end.
     7973   if p-recid-list <> "" and p-recid-list <> ?
     7974   then do:
     7975     if lookup("b-mark", p-button-list) > 0 then do:
     7976       define variable v-ii as integer no-undo .
     7977       assign
     7978       v-reposition-row = 1
     7979       v-focused-row    = 1
     7980       .
     7981       do v-ii = 1 to num-entries(p-recid-list):
     7982         find first buf_gds-grp no-lock
     7983             where recid( buf_gds-grp ) = integer( entry( v-ii, p-recid-list ) )
     7984         no-error .
     7985         if not available buf_gds-grp
     7986         then do:
     7987         end.
     7988         else do:
     7989           run expand-tree-for-grp in this-procedure (
     7990               input buf_gds-grp.node-code
     7991               , output v-focused-row
     7992               , output v-reposition-row
     7993               , output v-reposition-to-recid
     7994           ) no-error .
     7995           if error-status :error
     7996           then do:
     7997               undo, return error "UI-on: Не удалось раскрыть дерево групп." + chr(10) + return-value.
     7998           end.
     7999           run b-mark-press ( input buf_gds-grp.node-code ) no-error .
     8000         end.
     8001       end.
     8002     end.
     8003     else do:
     8004       assign
     8005           v-reposition-row = 1
     8006           v-focused-row    = 1
     8007       .
     8008       find first buf_gds-grp no-lock
     8009            where recid( buf_gds-grp ) = integer( entry( num-entries( p-recid-list ), p-recid-list ) )
     8010       no-error .
     8011       if not available buf_gds-grp
     8012       then do:
     8013       end.
     8014       else do:
     8015           run expand-tree-for-grp in this-procedure (
     8016               input buf_gds-grp.node-code
     8017               , output v-focused-row
     8018               , output v-reposition-row
     8019               , output v-reposition-to-recid
     8020           ) no-error .
     8021           if error-status :error
     8022           then do:
     8023               undo, return error "UI-on: Не удалось раскрыть дерево групп." + chr(10) + return-value.
     8024           end.
     8025       end.
     8026   end.
     8027   end.
     8028   ASSIGN
     8029   b-print:MENU-MOUSE in frame Dlg-grp =  1
     8030   b-rum:MENU-MOUSE in frame Dlg-grp =  1
     8031   .
     8032   run enable_UI.
     8033   if not valid-handle(parparentproc) then do:
     8034     disable
     8035     b-print
     8036     with frame Dlg-grp .
     8037   end.
     8038   hide    b-sel       in frame Dlg-grp
     8039           b-mark      in frame Dlg-grp
     8040           b-add       in frame Dlg-grp
     8041           b-chg       in frame Dlg-grp
     8042           b-del       in frame Dlg-grp
     8043           b-move      in frame Dlg-grp
     8044           b-scales    in frame Dlg-grp
     8045           b-marg      in frame Dlg-grp
     8046           b-nabor     in frame Dlg-grp
     8047        .
     8048   if v-grplib-not-fill-extra-info = yes
     8049   then do:
     8050       assign
     8051           temp_grplib_grp.min-marg       :visible in browse br-list = no
     8052           temp_grplib_grp.max-marg       :visible in browse br-list = no
     8053           v-cli-name                     :visible in browse br-list = no
     8054           temp_grplib_grp.increase-pc    :visible in browse br-list = no
     8055           temp_grplib_grp.round-method   :visible in browse br-list = no
     8056       .
     8057   end.
     8058   case p-button-list
     8059   :
     8060   when "buttons-for-move"
     8061   then do:
     8062       disable
     8063           b-exit    with frame Dlg-grp
     8064       .
     8065       view
     8066           b-sel    in frame Dlg-grp
     8067       .
     8068   end.
     8069   when "buttons-for-admin"
     8070   then do:
     8071       view
     8072           b-add    in frame Dlg-grp
     8073           b-chg in frame Dlg-grp
     8074           b-del in frame Dlg-grp
     8075           b-move   in frame Dlg-grp
     8076           b-arch   in frame Dlg-grp
     8077           b-tax    in frame Dlg-grp
     8078           b-marg   in frame Dlg-grp
     8079           b-nabor  in frame Dlg-grp
     8080       .
     8081       if v-enable-change-grp = no
     8082       then do:
     8083           disable
     8084               b-add
     8085               b-chg
     8086               b-del
     8087               b-move
     8088               b-nabor
     8089           with frame Dlg-grp.
     8090       end.
     8091   end.
     8092   when 'терм':U + ",b-scales"
     8093   then do:
     8094       view
     8095           b-scales
     8096       .
     8097       hide
     8098           b-arch
     8099           b-tax    in frame Dlg-grp
     8100           b-marg   in frame Dlg-grp
     8101       .
     8102   end.
     8103   when 'терм':U + ",b-sel" or when "b-sel"
     8104   then do:
     8105       view
     8106           b-sel    in frame Dlg-grp
     8107       .
     8108   end.
     8109   when "b-sel,b-mark" or when "b-sel,b-mark,b-actn-mark"
     8110   then do:
     8111       view
     8112           b-sel    in frame Dlg-grp
     8113           b-mark in frame Dlg-grp
     8114       .
     8115   end.
     8116   end case.
     8117   if (g#db-num <> 0) then do:
     8118       view
     8119           b-marg   in frame Dlg-grp
     8120       .
     8121   end.
     8122   if v-current-store-code = 0
     8123   or transaction
     8124   then do:
     8125     disable
     8126     b-tax
     8127     b-add
     8128     b-chg
     8129     b-del
     8130     b-move
     8131     with frame Dlg-grp .
     8132   end.
     8133   assign
     8134   menu-item m_selected:sensitive  in menu menu-b-rum = (b-mark:sensitive in frame Dlg-grp and b-mark:visible in frame Dlg-grp)
     8135   menu-item m_selected_plus_childs:sensitive  in menu menu-b-rum = (b-mark:sensitive in frame Dlg-grp and b-mark:visible in frame Dlg-grp)
     8136   .
     8137   br-list :set-repositioned-row( v-focused-row, "ALWAYS" ) in frame Dlg-grp.
     8138   if v-reposition-to-recid = no
     8139   then do:
     8140       reposition br-list to row v-reposition-row.
     8141   end.
     8142   else do:
     8143       reposition br-list to recid v-reposition-row.
     8144   end.
     8145   if b-marg :visible = yes
     8146   then do:
     8147       run enable-button-marg in this-procedure ( input temp_grplib_grp.node-code ) no-error.
     8148       if error-status :error
     8149       then do:
     8150           disable b-marg    with frame Dlg-grp.
     8151       end.
     8152   end.
     8153   end.
     8154   END PROCEDURE.
