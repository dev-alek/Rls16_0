     3801   ON VALUE-CHANGED OF br-list IN FRAME Dlg-grp
     3802   DO:
     3803       if temp_grplib_grp.level <> 0
     3804       then do:
     3805           assign
     3806               fi-search :screen-value = right-trim( temp_grplib_grp.full-name, chr(47) )
     3807           .
     3808       end.
     3809       run enable-button-marg in this-procedure ( input temp_grplib_grp.node-code ) no-error.
     3810       if error-status :error
     3811       then do:
     3812           DISABLE b-marg   with FRAME Dlg-grp.
     3813       end.
     3814   END.
     3815   ON CTRL-D OF fi-search IN FRAME Dlg-grp
     3816   DO:
     3817       define variable v-new-name as character no-undo.
     3818       run grplib-expand-name in this-procedure (
     3819           input fi-search :screen-value
     3820           , output v-new-name
     3821       ) no-error.
     3822       if error-status :error
     3823       then do:
     3824           message return-value.
     3825           undo, return no-apply.
     3826       end.
     3827       if v-new-name = ""
     3828       then do:
     3829           message
     3830               "Не найдена группа с полным именем, начинающимся на"
     3831               skip "'" + fi-search :screen-value + "'"
     3832           view-as alert-box information.
     3833           assign
     3834               v-new-name = fi-search :screen-value
     3835           .
     3836       end.
     3837       assign
     3838           fi-search :screen-value  = right-trim( v-new-name, chr(47) )
     3839           fi-search :cursor-offset = length( v-new-name ) + 1
     3840       .
     3841   END.
     3842   ON CTRL-S OF fi-search IN FRAME Dlg-grp
     3843   DO:
     3844       define variable v-new-name as character no-undo.
     3845       define variable v-new-code as integer   no-undo.
     3846       if v-full-search-next = no
     3847       then do:
     3848           assign
     3849               v-full-search-string     = fi-search :screen-value
     3850               v-full-search-next       = yes
     3851               v-full-search-start-code = 0
     3852           .
     3853       end.
     3854   if session :set-wait-state( "compiler" ) then.
     3855       run grplib-find-by-substring in this-procedure (
     3856                             input v-full-search-start-code
     3857                           , input v-full-search-string
     3858                           , output v-new-code
     3859                           , output v-new-name
     3860       ) no-error.
     3861       if error-status :error
     3862       then do:
     3863   if session :set-wait-state( "" ) then.
     3864           message return-value.
     3865           undo, return no-apply.
     3866       end.
     3867   if session :set-wait-state( "" ) then.
     3868       if v-new-code = 0
     3869       then do:
     3870           message
     3871               skip "Не найдена строка '" v-full-search-string "' в имени группы."
     3872           view-as alert-box information
     3873           title "Поиск завершен".
     3874           assign
     3875               v-new-name               = fi-search :screen-value
     3876               v-full-search-string     = ""
     3877               v-full-search-next       = no
     3878               v-full-search-start-code = 0
     3879           .
     3880       end.
     3881       else do:
     3882           assign
     3883               v-full-search-start-code = v-new-code
     3884           .
     3885       end.
     3886       assign
     3887           fi-search :screen-value  = right-trim( v-new-name, chr(47) )
     3888           fi-search :cursor-offset = length( v-new-name ) + 1
     3889       .
     3890   END.
     3891   ON LEAVE OF fi-search IN FRAME Dlg-grp
     3892   DO:
     3893       if fi-search :screen-value <> v-full-search-string
     3894       then do:
     3895           assign
     3896               v-full-search-string     = ""
     3897               v-full-search-next       = no
     3898               v-full-search-start-code = 0
     3899           .
     3900       end.
     3901   END.
     3902   ON RETURN OF fi-search IN FRAME Dlg-grp
     3903   DO:
     3904       define variable v-found    as logical      no-undo.
     3905       if fi-search :screen-value = ""
     3906       or fi-search :screen-value = ?
     3907       then do:
     3908           return no-apply.
     3909       end.
     3910       run find-grp-in-browse in this-procedure (
     3911             input fi-search :screen-value
     3912           , output v-found
     3913       ) no-error.
     3914       if error-status :error
     3915       then do:
     3916           message
     3917                    vss-workfile vss-revision vss-description
     3918               skip(1)
     3919               skip "Ошибка поиска группы."
     3920               skip return-value
     3921               skip trim(error-status :get-message(1))
     3922                    trim(error-status :get-message(2))
     3923                    trim(error-status :get-message(3))
     3924           view-as alert-box error.
     3925           undo, return no-apply .
     3926       end.
     3927       if v-found = no
     3928       then do:
     3929           message
     3930             skip "Группа не найдена."
     3931           view-as alert-box information.
     3932       end.
     3933       apply "ENTRY" to b-search in frame Dlg-grp.
     3934       return no-apply.
     3935   END.
