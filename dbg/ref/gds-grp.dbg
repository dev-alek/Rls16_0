     2638   define input parameter p-obj-code              as integer      no-undo.
     2639   define output parameter p-notcorr              as character    no-undo init ?.
     2640   define output parameter p-range-notcorr     as integer      no-undo.
     2641   define output parameter p-exists-notcorr    as logical      no-undo.
     2642   define variable v-host-code as integer      no-undo.
     2643   DEFINE VARIABLE v-found as logical no-undo .
     2644   DEFINE VARIABLE v-exists as logical no-undo .
     2645   DEFINE VARIABLE v-range as integer no-undo .
     2646   DEFINE VARIABLE jj as integer no-undo .
     2647   DEFINE VARIABLE v-notcorr-found as logical no-undo .
     2648   DEFINE VARIABLE v-notcorr-value as char      no-undo.
     2649   define buffer buf_gds-grp for ub.gds-grp.
     2650   define buffer buf_gds-grp-obj-attr for ub.gds-grp-obj-attr  .
     2651   find first buf_gds-grp no-lock where
     2652              buf_gds-grp.node-code = p-node-code no-error .
     2653   if not avail buf_gds-grp and p-node-code <> 0 then do:
     2654     message
     2655       vss-workfile vss-revision vss-description
     2656       skip "Не удалось найти группу товаров с кодом" p-node-code
     2657       view-as alert-box error .
     2658     undo, return error .
     2659   end.
     2660   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2661   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2662     (input  p-obj-type
     2663     ,input  p-obj-code
     2664     ,output v-host-code
     2665     ) no-error .
     2666   if error-status :error
     2667   then do:
     2668       message
     2669         vss-workfile vss-revision vss-description
     2670         skip "Не удалось найти фирму объекта"
     2671         skip p-obj-type p-obj-code
     2672         skip return-value
     2673         skip trim(error-status :get-message(1))
     2674       view-as alert-box error.
     2675       undo, return error .
     2676   end.
     2677   define buffer buf_gds-grp-obj      for ub.gds-grp-obj.
     2678   do while v-found = no and jj < 2:
     2679     if v-range <> 3 then do:
     2680       find first buf_gds-grp-obj no-lock
     2681           where buf_gds-grp-obj.node-code = p-node-code
     2682             and buf_gds-grp-obj.host-code = v-host-code
     2683             and buf_gds-grp-obj.obj-type  = p-obj-type
     2684             and buf_gds-grp-obj.obj-code  = p-obj-code
     2685       no-error .
     2686     end.
     2687     if v-range = 3 or not available buf_gds-grp-obj
     2688     then do:
     2689        if v-range <> 2 then do:
     2690           find first buf_gds-grp-obj no-lock
     2691               where buf_gds-grp-obj.node-code = p-node-code
     2692                 and buf_gds-grp-obj.host-code = v-host-code
     2693                 and buf_gds-grp-obj.obj-type  = ""
     2694                 and buf_gds-grp-obj.obj-code  = 0
     2695           no-error .
     2696         end.
     2697         if v-range = 2 or not available buf_gds-grp-obj
     2698         then do:
     2699             if v-range <> 1 then do:
     2700               find first buf_gds-grp-obj no-lock
     2701                   where buf_gds-grp-obj.node-code = p-node-code
     2702                   and buf_gds-grp-obj.host-code = 0
     2703                   and buf_gds-grp-obj.obj-type  = ""
     2704                   and buf_gds-grp-obj.obj-code  = 0
     2705               no-error .
     2706             end.
     2707             if v-range = 1 or not available buf_gds-grp-obj
     2708             then do:
     2709                 assign
     2710                     v-exists = no
     2711                 .
     2712             end.
     2713             else do:
     2714                 assign
     2715                     v-exists = yes
     2716                     v-range = 1
     2717                 .
     2718             end.
     2719         end.
     2720         else do:
     2721             assign
     2722                 v-exists = yes
     2723                 v-range  = 2
     2724             .
     2725         end.
     2726     end.
     2727     else do:
     2728         assign
     2729             v-exists = yes
     2730             v-range  = 3
     2731         .
     2732     end.
     2733     if available buf_gds-grp-obj
     2734     then do:
     2735       find first buf_gds-grp-obj-attr no-lock
     2736         where buf_gds-grp-obj-attr.node-code   = p-node-code
     2737           and buf_gds-grp-obj-attr.host-code   = buf_gds-grp-obj.host-code
     2738           and buf_gds-grp-obj-attr.obj-type    = buf_gds-grp-obj.obj-type
     2739           and buf_gds-grp-obj-attr.obj-code    = buf_gds-grp-obj.obj-code
     2740           and buf_gds-grp-obj-attr.attr-code   = 'NotCorrOP':U
     2741         no-error .
     2742       if available buf_gds-grp-obj-attr then do:
     2743         assign
     2744           v-notcorr-value = (if buf_gds-grp-obj-attr.attr-value = '' then ? else buf_gds-grp-obj-attr.attr-value)
     2745         .
     2746       end.
     2747       else do:
     2748         assign
     2749           v-notcorr-value = ?
     2750         .
     2751       end.
     2752       assign
     2753       p-exists-notcorr = (if v-notcorr-value <> ? and p-notcorr = ?
     2754                           then yes
     2755                           else p-exists-notcorr)
     2756       p-range-notcorr = if p-exists-notcorr and p-notcorr = ?
     2757                         then v-range
     2758                         else p-range-notcorr
     2759       p-notcorr   =  if p-exists-notcorr and  p-notcorr = ?
     2760                         then v-notcorr-value
     2761                         else p-notcorr
     2762       v-found =  (p-exists-notcorr ) or (v-range <= 1)
     2763       jj = jj + 1
     2764       .
     2765     end.
     2766     else do:
     2767       assign
     2768       v-found =  (p-exists-notcorr  ) or (v-range <= 1)
     2769       jj = jj + 1
     2770       .
     2771     end.
     2772   end.
     2773   end.
     2774   end procedure.
     2775   if p-button-list <> "buttons-for-move"
     2776   then do:
     2777       define new shared temp-table tt-goods no-undo like ub.goods.
     2778       define new shared temp-table tt-clients no-undo like ub.clients.
     2779   end.
     2780   define variable v-root-code                 as integer          no-undo.
     2781   define variable v-found-grp-num             as integer  init 0  no-undo.
     2782   define variable v-full-search-string        as character        no-undo.
     2783   define variable v-full-search-next          as logical  init no no-undo.
     2784   define variable v-full-search-start-code    as integer          no-undo.
     2785   define variable v-cli-name                  as character        no-undo.
     2786   define variable print-option as character no-undo.
     2787   define variable gds-grp-row as integer init 1 no-undo.
     2788   define variable v-from-b-gds as logical no-undo .
     2789   define variable v-old-recid-list as character no-undo .
     2790   define variable v-old-recid as recid no-undo .
     2791   define variable v-current-arm-code          as character    no-undo.
     2792   define variable v-current-store-type        as character    no-undo.
     2793   define variable v-current-store-code        as integer      no-undo.
     2794   define variable v-current-host-code         as integer      no-undo.
     2795   define variable is-flora     as character no-undo .
     2796   define variable par-type     as character no-undo.
     2797   define variable v-obj-host-code as integer   no-undo .
     2798   DEFINE VARIABLE rum-option   AS CHARACTER NO-UNDO.
     2799   define variable v-before-dop as character no-undo .
     2800   define variable v-button-sel-clicked as logical no-undo init false.
     2801   DEFINE MENU MENU-b-print
     2802          MENU-ITEM m_classificator LABEL "Классификатор"
     2803          MENU-ITEM m_browse       LABEL "Справочник"
     2804          MENU-ITEM m_term         LABEL "Содержимое терминальных групп".
     2805   DEFINE MENU MENU-B-rum
     2806          MENU-ITEM m_current      LABEL "Текущая"
     2807          MENU-ITEM m_current_plus_childs LABEL "Текущая (с группами нижних уровней)"
     2808          MENU-ITEM m_selected     LABEL "Выбранные"
     2809          MENU-ITEM m_selected_plus_childs LABEL "Выбранные (с группами нижних уровней)"
     2810          MENU-ITEM m_all          LABEL "Все"
     2811          RULE
     2812          MENU-ITEM m_xml-file-import LABEL "Импорт из XML-файла".
     2813   DEFINE BUTTON b-add
     2814        LABEL "&Добавить"
     2815        SIZE 10 BY 1 TOOLTIP "Добавить группу"
     2816        BGCOLOR 8 .
     2817   DEFINE BUTTON b-arch
     2818        LABEL "&Архив"
     2819        SIZE 10 BY 1 TOOLTIP "Информация по товарам группы"
     2820        BGCOLOR 8 .
     2821   DEFINE BUTTON b-chg
     2822        LABEL "&Изменить"
     2823        SIZE 10 BY 1 TOOLTIP "Изменить название и характеристики группы"
     2824        BGCOLOR 8 .
     2825   DEFINE BUTTON b-del
     2826        LABEL "&Удалить"
     2827        SIZE 11 BY 1 TOOLTIP "Удалить группу"
     2828        BGCOLOR 8 .
     2829   DEFINE BUTTON b-exit
     2830        LABEL "&Выход"
     2831        SIZE 10 BY 1 TOOLTIP "Выход"
     2832        BGCOLOR 8 .
     2833   DEFINE BUTTON b-expand
     2834        LABEL ">>"
     2835        SIZE 3.5 BY 1.13.
     2836   DEFINE BUTTON b-expand-all
     2837        LABEL ">>-->>"
     2838        SIZE 7.5 BY 1.13.
     2839   DEFINE BUTTON b-find-by-full-name
     2840        LABEL "+"
     2841        SIZE 3 BY 1 TOOLTIP "Продолжить до полного имени (CTRL-D)"
     2842        BGCOLOR 8 .
     2843   DEFINE BUTTON b-find-by-substring
     2844        LABEL "?"
     2845        SIZE 3 BY 1 TOOLTIP "Найти подстроку во всех группах (CTRL-S)"
     2846        BGCOLOR 8 .
     2847   DEFINE BUTTON B-gds
     2848        LABEL "&Товары"
     2849        SIZE 10 BY 1.
     2850   DEFINE BUTTON b-help
     2851        LABEL "&Помощь"
     2852        SIZE 10 BY 1 TOOLTIP "Помощь"
     2853        BGCOLOR 8 .
     2854   DEFINE BUTTON B-history
     2855        LABEL "Ис&тория"
     2856        SIZE 10 BY 1.
     2857   DEFINE BUTTON b-marg
     2858        LABEL "Па&раметры на объектах"
     2859        SIZE 32 BY 1 TOOLTIP "Диапазон наценок и наценка по умолчанию на группу товаров"
     2860        BGCOLOR 8 .
     2861   DEFINE BUTTON b-mark
     2862        LABEL "&*"
     2863        SIZE 3 BY 1.
     2864   DEFINE BUTTON b-move
     2865        LABEL "П&еренести"
     2866        SIZE 11 BY 1 TOOLTIP "Переместить группу"
     2867        BGCOLOR 8 .
     2868   DEFINE BUTTON B-nabor
     2869        LABEL "Н"
     2870        SIZE 3.8 BY 1 TOOLTIP "Отметить группу как набор или снять пометку".
     2871   DEFINE BUTTON b-print
     2872        LABEL "Пе&чать"
     2873        SIZE 10 BY 1 TOOLTIP "Печать списка групп".
     2874   DEFINE BUTTON B-rum
     2875        LABEL "&Операции над группами"
     2876        SIZE 30 BY 1.
     2877   DEFINE BUTTON b-scales
     2878        LABEL "В&есы"
     2879        SIZE 10 BY 1 TOOLTIP "Привязка группы к весам"
     2880        BGCOLOR 8 .
     2881   DEFINE BUTTON b-search
     2882        LABEL "Поиск"
     2883        SIZE 10 BY 1.03
     2884        BGCOLOR 8 .
     2885   DEFINE BUTTON b-sel
     2886        LABEL "Вы&бор"
     2887        SIZE 10 BY 1
     2888        BGCOLOR 8 .
     2889   DEFINE BUTTON b-tax
     2890        LABEL "&Налоги"
     2891        SIZE 10 BY 1 TOOLTIP "Налоги для группы товаров"
     2892        BGCOLOR 8 .
     2893   DEFINE VARIABLE fi-search AS CHARACTER FORMAT "X(256)":U
     2894        VIEW-AS FILL-IN
     2895        SIZE 69.8 BY 1
     2896        FGCOLOR 1  NO-UNDO.
     2897   DEFINE QUERY br-list FOR
     2898         temp_grplib_grp SCROLLING.
     2899   DEFINE BROWSE br-list
     2900     QUERY br-list DISPLAY
     2901         temp_grplib_grp.sel           format "X(1)" no-label
     2902         temp_grplib_grp.nabor         format "X(1)" label "Н"
     2903         temp_grplib_grp.name          format "X(71)"      label " Наименование группы"
     2904         temp_grplib_grp.print-code    format "X(20)"      label " Код"
     2905         temp_grplib_grp.calc-method   format "X(11)"      label " Исходная"
     2906         temp_grplib_grp.increase-pc   format "->>>>9.99"  label " Наценка"
     2907         temp_grplib_grp.min-marg      format "X(10)"  label " Мин.Нац."
     2908         temp_grplib_grp.max-marg      format "X(10)"  label " Макс.Нац."
     2909         temp_grplib_grp.round-method  format "X(22)"  label " Метод округления"
     2910         if temp_grplib_grp.notcorr = 'yes'  then "да" else ""  format "X(17)"  label "Запрет кор.заказ"
     2911         string(temp_grplib_grp.cli-type + ' ' + string(temp_grplib_grp.cli-code,">>>>>")) @ v-cli-name format "X(12)" label "Вн.Поставщик"
     2912         temp_grplib_grp.node-code     FORMAT ">>>>>>>>>>9" LABEL "Вн №"
     2913       WITH NO-ROW-MARKERS SEPARATORS SIZE 97.5 BY 16.63.
     2914   DEFINE FRAME Dlg-grp
     2915        b-exit AT ROW 1 COL 1
     2916        b-mark AT ROW 1 COL 11
     2917        b-scales AT ROW 1 COL 14
     2918        b-sel AT ROW 1 COL 24
     2919        b-marg AT ROW 1 COL 34
     2920        b-print AT ROW 1 COL 66
     2921        B-history AT ROW 1 COL 76
     2922        b-help AT ROW 1 COL 86
     2923        b-add AT ROW 2 COL 24
     2924        b-chg AT ROW 2 COL 34
     2925        b-del AT ROW 2 COL 44
     2926        b-move AT ROW 2 COL 55
     2927        b-arch AT ROW 2 COL 66
     2928        b-tax AT ROW 2 COL 76
     2929        B-gds AT ROW 2 COL 86
     2930        B-nabor AT ROW 2 COL 96.1
     2931        B-rum AT ROW 3 COL 66 WIDGET-ID 2
     2932        b-expand AT ROW 4.07 COL 1.6
     2933        b-expand-all AT ROW 4.07 COL 5.1
     2934        fi-search AT ROW 4.07 COL 13.4 NO-LABEL
     2935        b-find-by-full-name AT ROW 4.07 COL 83.4
     2936        b-find-by-substring AT ROW 4.07 COL 86.4
     2937        b-search AT ROW 4.07 COL 89.4
     2938        br-list AT ROW 5.37 COL 1.9
     2939        SPACE(0.59) SKIP(0.12)
     2940       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     2941            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     2942            TITLE "Группы товаров".
     2943   ASSIGN
     2944          FRAME Dlg-grp:SCROLLABLE       = FALSE
     2945          FRAME Dlg-grp:HIDDEN           = TRUE.
     2946   ASSIGN
     2947          b-print:POPUP-MENU IN FRAME Dlg-grp       = MENU MENU-b-print:HANDLE.
     2948   ASSIGN
     2949          B-rum:POPUP-MENU IN FRAME Dlg-grp       = MENU MENU-B-rum:HANDLE.
     2950   ON ENDKEY OF FRAME Dlg-grp
     2951   DO:
     2952       run gbl/markqwa.p (
     2953                              input b-mark:visible
     2954                             , input p-recid-list) no-error.
     2955       if error-status:error then return no-apply.
     2956   END.
     2957   ON WINDOW-CLOSE OF FRAME Dlg-grp
     2958   DO:
     2959     if not v-button-sel-clicked then
     2960       p-recid-list = "".
     2961     apply "end-error":U to self.
     2962   END.
     2963   ON CHOOSE OF b-add IN FRAME Dlg-grp
     2964   DO:
     2965       run add-grp in this-procedure (
     2966           input temp_grplib_grp.node-code
     2967       ) no-error .
     2968       if error-status :error
     2969       then do:
     2970           message
     2971           vss-workfile vss-revision vss-description
     2972           skip "Ошибка добавления группы товаров."
     2973           skip return-value
     2974           skip trim(error-status :get-message(1))
     2975           trim(error-status :get-message(2))
     2976           trim(error-status :get-message(3))
     2977           trim(error-status :get-message(4))
     2978           trim(error-status :get-message(5))
     2979           view-as alert-box error.
     2980           undo, return no-apply.
     2981       end.
     2982   END.
     2983   ON CHOOSE OF b-arch IN FRAME Dlg-grp
     2984   DO:
     2985       run press-arch ( input temp_grplib_grp.node-code ) no-error .
     2986       if error-status :error
     2987       then do:
     2988           message
     2989           vss-workfile vss-revision vss-description
     2990           skip "Ошибка получения архивной информации по группе."
     2991           skip return-value
     2992           skip trim(error-status :get-message(1))
     2993           trim(error-status :get-message(2))
     2994           trim(error-status :get-message(3))
     2995           trim(error-status :get-message(4))
     2996           trim(error-status :get-message(5))
     2997           view-as alert-box error.
     2998           undo, return no-apply .
     2999       end.
     3000       apply "entry" to br-list in frame Dlg-grp.
     3001   END.
     3002   ON CHOOSE OF b-chg IN FRAME Dlg-grp
     3003   DO:
     3004       run change-grp in this-procedure (
     3005           input temp_grplib_grp.node-code
     3006       ) no-error .
     3007       if error-status :error
     3008       then do:
     3009           message
     3010           vss-workfile vss-revision vss-description
     3011           skip "Ошибка изменения группы товаров."
     3012           skip return-value
     3013           skip trim(error-status :get-message(1))
     3014           trim(error-status :get-message(2))
     3015           trim(error-status :get-message(3))
     3016           trim(error-status :get-message(4))
     3017           trim(error-status :get-message(5))
     3018           view-as alert-box error.
     3019           undo, return no-apply .
     3020       end.
     3021   END.
     3022   ON CHOOSE OF b-del IN FRAME Dlg-grp
     3023   DO:
     3024       run delete-grp in this-procedure (
     3025             input temp_grplib_grp.node-code
     3026           , input yes
     3027       ) no-error .
     3028       if error-status :error
     3029       then do:
     3030           message
     3031           vss-workfile vss-revision vss-description
     3032           skip "Ошибка удаления группы товаров."
     3033           skip return-value
     3034           skip trim(error-status :get-message(1))
     3035           trim(error-status :get-message(2))
     3036           trim(error-status :get-message(3))
     3037           trim(error-status :get-message(4))
     3038           trim(error-status :get-message(5))
     3039           view-as alert-box error.
     3040           undo, return no-apply .
     3041       end.
     3042   END.
     3043   ON CHOOSE OF b-exit IN FRAME Dlg-grp
     3044   DO:
     3045       define variable v-gds-grp-recid     as recid             no-undo.
     3046       run get-current-recid in this-procedure (
     3047             input temp_grplib_grp.node-code
     3048           , output v-gds-grp-recid
     3049       ) no-error .
     3050       if error-status :error
     3051       then do:
     3052           message
     3053             vss-workfile vss-revision vss-description
     3054             skip "Не найдена группа для восстановления"
     3055             skip "предыдущего состояния справочника групп."
     3056             skip return-value
     3057             skip trim(error-status :get-message(1))
     3058                  trim(error-status :get-message(2))
     3059                  trim(error-status :get-message(3))
     3060                  trim(error-status :get-message(4))
     3061                  trim(error-status :get-message(5))
     3062           view-as alert-box error.
     3063           undo, return no-apply .
     3064       end.
     3065       run gbl/markqwa.p (
     3066                              input b-mark:visible
     3067                             , input p-recid-list) no-error.
     3068       if error-status:error then return no-apply.
     3069       assign
     3070           gds-grp-row  = v-gds-grp-recid
     3071           p-recid-list = ""
     3072       .
     3073       assign
     3074       v-uf-List_ = (if gds-grp-row = ? then chr(63) else string(gds-grp-row))
     3075       .
     3076       run uf-set in this-procedure(
     3077           input  'gds-grp-p':U
     3078           ,input  g#userid
     3079           ,input v-uf-List_
     3080           ,input v-uf-Naim
     3081           ,input v-uf-print-graft
     3082           ,input v-uf-sort-gr
     3083           ,input v-uf-type-price
     3084           ,input v-uf-type-val
     3085       )  no-error .
     3086       apply "WINDOW-CLOSE" TO FRAME Dlg-grp .
     3087   END.
     3088   ON CHOOSE OF b-expand IN FRAME Dlg-grp
     3089   DO:
     3090       if temp_grplib_grp.node-code = v-root-code
     3091       then do:
     3092           run collapse-all-on-first-level in this-procedure no-error .
     3093           if error-status :error
     3094           then do:
     3095               message
     3096               vss-workfile vss-revision vss-description
     3097               skip "Ошибка операции с деревом групп."
     3098               skip return-value
     3099               skip trim(error-status :get-message(1))
     3100                   trim(error-status :get-message(2))
     3101                   trim(error-status :get-message(3))
     3102                   trim(error-status :get-message(4))
     3103                   trim(error-status :get-message(5))
     3104               view-as alert-box error.
     3105               undo, return no-apply .
     3106           end.
     3107       end.
     3108       if temp_grplib_grp.mark <> "»"
     3109       and temp_grplib_grp.mark <> "«"
     3110       then do:
     3111           return no-apply.
     3112       end.
     3113       run expand-or-collapse-item in this-procedure no-error .
     3114       if error-status :error
     3115       then do:
     3116           message
     3117             vss-workfile vss-revision vss-description
     3118             skip "Ошибка операции с деревом групп."
     3119             skip return-value
     3120             skip trim(error-status :get-message(1))
     3121                  trim(error-status :get-message(2))
     3122                  trim(error-status :get-message(3))
     3123                  trim(error-status :get-message(4))
     3124                  trim(error-status :get-message(5))
     3125           view-as alert-box error.
     3126           undo, return no-apply .
     3127       end.
