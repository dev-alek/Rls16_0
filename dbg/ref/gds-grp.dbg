     1391   FIELD tax-rate-gds-rc  as recid
     1392   FIELD to-cashdesk like ub.tax.to-cashdesk
     1393   FIELD fact-date like ub.tax-rate-value.fact-date
     1394   FIELD fact-order like ub.tax-rate-value.fact-order
     1395   FIELD next-order like ub.tax-rate-value.fact-order
     1396   FIELD corr-user-name like ub.tax-rate-gds.corr-user-name
     1397   FIELD corr-user-db-num   like ub.tax-rate-gds.corr-user-db-num
     1398   FIELD corr-date like ub.tax-rate-gds.corr-date
     1399   FIELD corr-time like ub.tax-rate-gds.corr-time
     1400   index tax-code is unique primary tax-code fact-order descending rate-code.
     1401     define temp-table  output-tax no-undo
