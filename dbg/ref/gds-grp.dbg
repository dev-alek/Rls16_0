     1770                when 'UPD':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Настройки справочника Электронного документоборота"     p-tooltip = "Настройки справочника Электронного документоборота"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
     1771               when 'LK_RECEIPT':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Настройки справочника документов Вывода из оборота (ОСУ)"     p-tooltip = "Настройки справочника документов Вывода из оборота (ОСУ)"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
     1772         otherwise do:
     1773           undo, return error "неизвестная настройка пользователя usr-flt" + " " + p-code .
     1774         end.
     1775       end CASE.
     1776     end.
     1777   end procedure.
     1778   procedure uf-get :
     1779     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
     1780     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
     1781     define output parameter p-List_        like ubflt.usr-flt.List_        no-undo .
     1782     define output parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
     1783     define output parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
     1784     define output parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
     1785     define output parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
     1786     define output parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
     1787     do
     1788     on error undo, return error
     1789     :
     1790       define buffer buf_usr-flt for ubflt.usr-flt .
     1791       define variable v-use-List_     as logical   no-undo .
     1792       define variable v-type-List_     as character no-undo .
     1793       define variable v-format-List_   as character no-undo .
     1794       define variable v-use-Naim      as logical   no-undo .
     1795       define variable v-type-Naim      as character no-undo .
     1796       define variable v-format-Naim    as character no-undo .
     1797       define variable v-use-print-graft as logical   no-undo .
     1798       define variable v-use-sort-gr     as logical   no-undo .
     1799       define variable v-use-type-price  as logical   no-undo .
     1800       define variable v-use-type-val    as logical   no-undo .
     1801       define variable v-label          as character no-undo .
     1802       define variable v-tooltip        as character no-undo .
     1803       define variable v-user-can-edit  as logical   no-undo .
     1804       define variable v-output-display as logical   no-undo .
     1805       define variable v-other          as character no-undo .
     1806       run uf-name in this-procedure
     1807          (input  entry(1, p-code, chr(4))
     1808         ,output v-use-List_
     1809         ,output v-type-List_
     1810         ,output v-format-List_
     1811         ,output v-use-Naim
     1812         ,output v-type-Naim
     1813         ,output v-format-Naim
     1814         ,output v-use-print-graft
     1815         ,output v-use-sort-gr
     1816         ,output v-use-type-price
     1817         ,output v-use-type-val
     1818         ,output v-label
     1819         ,output v-tooltip
     1820         ,output v-user-can-edit
     1821         ,output v-output-display
     1822         ,output v-other
     1823         ) no-error .
     1824       if error-status :error then do:
     1825         undo, return error return-value .
     1826       end.
     1827       find first buf_usr-flt no-lock where
     1828                  buf_usr-flt.Call-point     = p-code AND
     1829                  buf_usr-flt.user-name       = p-user-name
     1830         no-error .
     1831       if avail buf_usr-flt then do:
     1832         assign
     1833         p-List_        = (if v-use-List_       then buf_usr-flt.List_       else ?)
     1834         p-Naim         = (if v-use-Naim        then buf_usr-flt.Naim        else ?)
     1835         p-print-graft  = (if v-use-print-graft then buf_usr-flt.print-graft else ?)
     1836         p-sort-gr      = (if v-use-sort-gr     then buf_usr-flt.sort-gr     else ?)
     1837         p-type-price   = (if v-use-type-price  then buf_usr-flt.type-price  else ?)
     1838         p-type-val     = (if v-use-List_       then buf_usr-flt.type-val    else ?)
     1839         .
     1840       end.
     1841       else do:
     1842         assign
     1843         p-List_        = (if v-use-List_       then "":U                    else ?)
     1844         p-Naim         = (if v-use-Naim        then "":U                    else ?)
     1845         p-print-graft  = (if v-use-print-graft then no                      else ?)
     1846         p-sort-gr      = (if v-use-sort-gr     then no                      else ?)
     1847         p-type-price   = (if v-use-type-price  then no                      else ?)
     1848         p-type-val     = (if v-use-List_       then no                      else ?)
     1849         .
     1850       end.
     1851     end.
     1852   end procedure.
     1853   procedure uf-set :
     1854     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
     1855     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
     1856     define input  parameter p-List_        like ubflt.usr-flt.List_        no-undo .
     1857     define input  parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
     1858     define input  parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
     1859     define input  parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
     1860     define input  parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
     1861     define input  parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
     1862     do
     1863     on error undo, return error
     1864     :
     1865       define buffer buf_usr-flt for ubflt.usr-flt .
     1866       define variable v-use-List_     as logical   no-undo .
     1867       define variable v-type-List_     as character no-undo .
     1868       define variable v-format-List_   as character no-undo .
     1869       define variable v-use-Naim      as logical   no-undo .
     1870       define variable v-type-Naim      as character no-undo .
     1871       define variable v-format-Naim    as character no-undo .
     1872       define variable v-use-print-graft as logical   no-undo .
     1873       define variable v-use-sort-gr   as logical   no-undo .
     1874       define variable v-use-type-price as logical   no-undo .
     1875       define variable v-use-type-val  as logical   no-undo .
     1876       define variable v-tooltip        as character no-undo .
     1877       define variable v-label          as character no-undo .
     1878       define variable v-user-can-edit  as logical   no-undo .
     1879       define variable v-output-display as logical   no-undo .
     1880       define variable v-other          as character no-undo .
     1881       run uf-name in this-procedure
     1882         (input  entry(1, p-code, chr(4))
     1883         ,output v-use-List_
     1884         ,output v-type-List_
     1885         ,output v-format-List_
     1886         ,output v-use-Naim
     1887         ,output v-type-Naim
     1888         ,output v-format-Naim
     1889         ,output v-use-print-graft
     1890         ,output v-use-sort-gr
     1891         ,output v-use-type-price
     1892         ,output v-use-type-val
     1893         ,output v-label
     1894         ,output v-tooltip
     1895         ,output v-user-can-edit
     1896         ,output v-output-display
     1897         ,output v-other
     1898         ) no-error .
     1899       if error-status :error then do:
     1900         undo, return error return-value .
     1901       end.
     1902       find first buf_usr-flt where
     1903                  buf_usr-flt.Call-point     = p-code AND
     1904                  buf_usr-flt.user-name       = p-user-name
     1905         no-error .
     1906       if not avail buf_usr-flt then do:
     1907           create buf_usr-flt .
     1908           assign
     1909           buf_usr-flt.call-point = p-code
     1910           buf_usr-flt.user-name  = p-user-name
     1911           .
     1912       end.
     1913       if avail buf_usr-flt then do:
     1914        assign
     1915        buf_usr-flt.List_       =  (if v-use-List_       then  p-List_        else ?)
     1916        buf_usr-flt.Naim        =  (if v-use-Naim        then  p-Naim         else ?)
     1917        buf_usr-flt.print-graft =  (if v-use-print-graft then  p-print-graft  else ?)
     1918        buf_usr-flt.sort-gr     =  (if v-use-sort-gr     then  p-sort-gr      else ?)
     1919        buf_usr-flt.type-price  =  (if v-use-type-price  then  p-type-price   else ?)
     1920        buf_usr-flt.type-val    =  (if v-use-List_       then  p-type-val     else ?)
     1921       .
     1922       release buf_usr-flt.
     1923       end.
     1924       else undo, return error ("Ошибка при записи usr-flt" + substitute(" call-point=&1, user-name=&2", p-code, p-user-name)).
     1925     end.
     1926   end procedure.
     1927   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1928   procedure grp-attr-name :
     1929   do
     1930     on error undo, return error
     1931     :
     1932     define input  parameter p-code           as character no-undo .
     1933     define output parameter p-type           as character no-undo .
     1934     define output parameter p-format         as character no-undo .
     1935     define output parameter p-label          as character no-undo .
     1936     define output parameter p-user-can-edit  as logical   no-undo .
     1937     define output parameter p-output-display as logical   no-undo .
     1938     define output parameter p-other          as character no-undo .
     1939       case p-code :
     1940               when 'gds-grp-nabor':U then do:     assign     p-label = "Набор"     p-type = 'L':U      p-format = "yes/no"     p-label = "Набор"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
     1941         otherwise do:
     1942           undo, return error "Неизвестный атрибут группы товаров на фирме" + " " + p-code .
     1943         end.
     1944       end.
     1945     end.
     1946   end procedure.
     1947   procedure grp-attr-tooltip :
     1948   do
     1949     on error undo, return error
     1950     :
     1951       define input  parameter p-code    as character no-undo .
     1952       define output parameter p-tooltip as character no-undo .
     1953       define output parameter p-label   as character no-undo .
     1954       case p-code :
     1955               when 'gds-grp-nabor':U then do:     assign     p-tooltip = "Набор - не товарные позиции"     p-label = "Набор" .   end.
     1956         otherwise do:
     1957               undo, return error "Неизвестный атрибут группы товаров на фирме" + " " + p-code .
     1958         end.
     1959       end.
     1960     end.
     1961   end procedure.
     1962   procedure grp-attr-value :
     1963   do
     1964   on error undo, return error
     1965   :
     1966   define input  parameter p-node-code   as integer    no-undo.
     1967   define input  parameter p-code        as character  no-undo.
     1968   define input  parameter p-host-code   as integer    no-undo.
     1969   define input  parameter p-obj-type    as character  no-undo.
     1970   define input  parameter p-obj-code    as integer    no-undo.
     1971   define output parameter p-value       as character  no-undo.
     1972   define output parameter p-type        as character  no-undo.
     1973       define variable v-format         as character no-undo .
     1974       define variable v-label          as character no-undo .
     1975       define variable v-user-can-edit  as logical   no-undo .
     1976       define variable v-output-display as logical   no-undo .
     1977       define variable v-other          as character no-undo .
     1978       define buffer buf_gds-grp-attr for ub.gds-grp-attr.
     1979       run grp-attr-name in this-procedure (
     1980             input  p-code
     1981           , output p-type
     1982           , output v-format
     1983           , output v-label
     1984           , output v-user-can-edit
     1985           , output v-output-display
     1986           , output v-other
     1987       ) no-error .
     1988       if error-status :error
     1989       then do:
     1990           undo, return error return-value .
     1991       end.
     1992       find first buf_gds-grp-attr no-lock
     1993            where buf_gds-grp-attr.node-code = p-node-code
     1994              and buf_gds-grp-attr.attr-code = p-code
     1995              and buf_gds-grp-attr.host-code = p-host-code
     1996              and buf_gds-grp-attr.obj-type  = p-obj-type
     1997              and buf_gds-grp-attr.obj-code  = p-obj-code
     1998       no-error .
     1999       if available buf_gds-grp-attr
     2000       then do:
     2001           assign
     2002               p-value = buf_gds-grp-attr.attr-value
     2003           .
     2004       end.
     2005       else do:
     2006           assign
     2007               p-value = if p-type = 'L':U then "no":U else ""
     2008           .
     2009       end.
     2010   end.
     2011   end procedure.
     2012   procedure grp-attr-write :
     2013   do
     2014   on error undo, return error
     2015   :
     2016   define input parameter p-node-code  like ub.gds-grp-attr.node-code      no-undo.
     2017   define input parameter p-code       like ub.gds-grp-attr.attr-code      no-undo.
     2018   define input parameter p-host-code  as integer                          no-undo.
     2019   define input parameter p-obj-type   like ub.clients.obj-type            no-undo.
     2020   define input parameter p-obj-code   like ub.clients.obj-code            no-undo.
     2021   define input parameter p-value      like ub.gds-grp-attr.attr-value     no-undo.
     2022       define variable v-type              as character                no-undo.
     2023       define variable v-format            as character                no-undo.
     2024       define variable v-label             as character                no-undo.
     2025       define variable v-user-can-edit     as logical                  no-undo.
     2026       define variable v-output-display    as logical                  no-undo.
     2027       define variable v-other             as character                no-undo.
     2028       define buffer buf_gds-grp-attr for ub.gds-grp-attr .
     2029       run grp-attr-name in this-procedure (
     2030                         input  p-code
     2031                       , output v-type
     2032                       , output v-format
     2033                       , output v-label
     2034                       , output v-user-can-edit
     2035                       , output v-output-display
     2036                       , output v-other
     2037       ) no-error.
     2038       if error-status :error
     2039       then do:
     2040           undo, return error return-value.
     2041       end.
     2042       find first buf_gds-grp-attr exclusive-lock
     2043            where buf_gds-grp-attr.node-code  = p-node-code
     2044              and buf_gds-grp-attr.attr-code  = p-code
     2045              and buf_gds-grp-attr.host-code  = p-host-code
     2046              and buf_gds-grp-attr.obj-type   = p-obj-type
     2047              and buf_gds-grp-attr.obj-code   = p-obj-code
     2048       no-error.
     2049       if not available buf_gds-grp-attr
     2050       then do:
     2051           create buf_gds-grp-attr.
     2052           assign
     2053                   buf_gds-grp-attr.node-code  = p-node-code
     2054                   buf_gds-grp-attr.attr-code  = p-code
     2055                   buf_gds-grp-attr.host-code  = p-host-code
     2056                   buf_gds-grp-attr.obj-type   = p-obj-type
     2057                   buf_gds-grp-attr.obj-code   = p-obj-code
     2058                   buf_gds-grp-attr.attr-value = p-value
     2059           .
     2060       end.
     2061       else do:
     2062           assign
     2063               buf_gds-grp-attr.attr-value = p-value
     2064           .
     2065       end.
     2066   end.
     2067   end procedure.
     2068   procedure grp-attr-delete :
     2069   do
     2070   on error undo, return error
     2071   :
     2072   define input parameter p-node-code  like ub.gds-grp-attr.node-code  no-undo.
     2073   define input parameter p-code       like ub.gds-grp-attr.attr-code  no-undo.
     2074   define input parameter p-host-code  as integer                      no-undo.
     2075   define input parameter p-obj-type   like ub.clients.obj-type        no-undo.
     2076   define input parameter p-obj-code   like ub.clients.obj-code        no-undo.
     2077   define output parameter p-deleted   as logical                      no-undo.
     2078       define buffer buf_gds-grp-attr for ub.gds-grp-attr .
     2079       define variable v-type              as character                no-undo.
     2080       define variable v-format            as character                no-undo.
     2081       define variable v-label             as character                no-undo.
     2082       define variable v-user-can-edit     as logical                  no-undo.
     2083       define variable v-output-display    as logical                  no-undo.
     2084       define variable v-other             as character                no-undo.
     2085       run grp-attr-name in this-procedure
     2086       ( input  p-code
     2087       , output v-type
     2088       , output v-format
     2089       , output v-label
     2090       , output v-user-can-edit
     2091       , output v-output-display
     2092       , output v-other
     2093       ) no-error .
     2094       if error-status :error then do:
     2095           undo, return error return-value .
     2096       end.
     2097       find first buf_gds-grp-attr exclusive-lock
     2098            where buf_gds-grp-attr.node-code  = p-node-code
     2099              and buf_gds-grp-attr.attr-code  = p-code
     2100              and buf_gds-grp-attr.host-code  = p-host-code
     2101              and buf_gds-grp-attr.obj-type   = p-obj-type
     2102              and buf_gds-grp-attr.obj-code   = p-obj-code
     2103       no-error.
     2104       if not available buf_gds-grp-attr
     2105       then do:
     2106           assign
     2107               p-deleted = no
     2108           .
     2109       end.
     2110       else do:
     2111          delete buf_gds-grp-attr.
     2112          assign
     2113               p-deleted = yes
     2114           .
     2115       end.
     2116   end.
     2117   end procedure.
     2118   procedure grp-attr-news :
     2119   do
     2120   on error undo, return error
     2121   :
     2122       define input  parameter p-code           as character no-undo .
     2123       define output parameter p-news           as logical   no-undo .
     2124       case p-code :
     2125               when 'gds-grp-nabor':U then do:     assign     p-news = true.   end.
     2126         otherwise do:
