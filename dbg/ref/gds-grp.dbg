     2136   define input parameter p-node-code as integer      no-undo.
     2137   define input parameter p-obj-type  as character    no-undo.
     2138   define input parameter p-obj-code  as integer      no-undo.
     2139   define input parameter p-attr-code as character    no-undo .
     2140   define output parameter p-attr-value     as character   no-undo.
     2141   define output parameter p-range     as integer      no-undo.
     2142   define output parameter p-exists    as logical      no-undo.
