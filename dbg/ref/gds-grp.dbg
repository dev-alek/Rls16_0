     3300     assign
     3301     v-before-dop = string((if v-uf-List_ =  chr(63) then ? else integer(v-uf-LIst_)))
     3302     .
     3303     run ref/gds-ref.p (
     3304                     input parparentproc
     3305                    ,input "":U
     3306                    ,input ?
     3307                    ,input 'группа':U
     3308                    ,input ?
     3309                    ,input ?
     3310                    ,input v-grp-list
     3311                    ,input ?
     3312                    ,input ?
     3313                    ,input v-current-store-type
     3314                    ,input v-current-store-code
     3315                    ,input ?
     3316                    ,output rec-list).
     3317     v-old-recid = ?.
     3318    END.
     3319   END.
