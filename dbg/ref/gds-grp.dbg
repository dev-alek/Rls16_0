     3386   ON CHOOSE OF B-nabor IN FRAME Dlg-grp
     3387   DO:
     3388       define buffer buf_gds-grp for ub.gds-grp.
     3389       find first buf_gds-grp no-lock
     3390            where buf_gds-grp.node-code = temp_grplib_grp.node-code
     3391       no-error.
     3392       if not available buf_gds-grp
     3393       then do:
     3394           message
     3395             vss-workfile vss-revision vss-description
     3396             skip "Неверно выбрана группа."
     3397             skip return-value
     3398             skip trim(error-status :get-message(1))
     3399                  trim(error-status :get-message(2))
     3400                  trim(error-status :get-message(3))
     3401                  trim(error-status :get-message(4))
     3402                  trim(error-status :get-message(5))
     3403           view-as alert-box error.
     3404           undo, return no-apply .
     3405       end.
     3406   define variable v-value       as character  no-undo.
     3407   define variable v-type        as character  no-undo.
     3408   define variable v-del as logical   no-undo .
     3409     run grp-attr-value (
     3410        input   temp_grplib_grp.node-code
     3411       ,input   'gds-grp-nabor':U
     3412       ,input   0
     3413       ,input   ""
     3414       ,input   0
     3415       ,output  v-value
     3416       ,output  v-type       ) .
     3417     if v-value = "yes" then  do:
     3418         message "Снять с группы: "  temp_grplib_grp.full-name skip "признак НАБОР ? "
     3419         view-as alert-box question buttons yes-no update v-ok as log.
     3420         if v-ok = false then do:
     3421            return .
     3422            end.
     3423         run waitfram-show ("Ждите...") .
     3424         temp_grplib_grp.nabor = "" .
     3425          run grp-attr-delete (
     3426          input   temp_grplib_grp.node-code
     3427         ,input   'gds-grp-nabor':U
     3428         ,input   0
     3429         ,input   ""
     3430         ,input   0
     3431         ,output  v-del ) .
     3432     end.
     3433     else do:
     3434         message "Проставить на группу: "  temp_grplib_grp.full-name skip "признак НАБОР ? "
     3435         view-as alert-box question buttons yes-no update v-ok1 as log.
     3436         if v-ok1 = false then do:
     3437           return .
     3438           end.
     3439         run waitfram-show ("Ждите...") .
     3440         temp_grplib_grp.nabor = "+".
     3441          run grp-attr-write (
     3442          input   temp_grplib_grp.node-code
     3443         ,input   'gds-grp-nabor':U
     3444         ,input   0
     3445         ,input   ""
     3446         ,input   0
     3447         ,input   "yes"   ) .
     3448     end.
     3449     browse br-list:refresh().
     3450     run waitfram-hide.
     3451   END.
