     2165   define buffer buf_gds-grp-attr      for ub.gds-grp-attr.
     2166   find first buf_gds-grp-attr no-lock
     2167        where buf_gds-grp-attr.node-code = p-node-code
     2168          and buf_gds-grp-attr.attr-code = p-attr-code
     2169          and buf_gds-grp-attr.host-code = v-host-code
     2170          and buf_gds-grp-attr.obj-type  = p-obj-type
     2171          and buf_gds-grp-attr.obj-code  = p-obj-code
     2172   no-error .
     2173   if not available buf_gds-grp-attr
     2174   then do:
     2175       find first buf_gds-grp-attr no-lock
     2176            where buf_gds-grp-attr.node-code = p-node-code
     2177              and buf_gds-grp-attr.attr-code = p-attr-code
     2178              and buf_gds-grp-attr.host-code = v-host-code
     2179              and buf_gds-grp-attr.obj-type  = ""
     2180              and buf_gds-grp-attr.obj-code  = 0
     2181       no-error .
     2182       if not available buf_gds-grp-attr
     2183       then do:
     2184           find first buf_gds-grp-attr no-lock
     2185               where buf_gds-grp-attr.node-code = p-node-code
     2186               and buf_gds-grp-attr.attr-code = p-attr-code
     2187               and buf_gds-grp-attr.host-code = 0
     2188               and buf_gds-grp-attr.obj-type  = ""
     2189               and buf_gds-grp-attr.obj-code  = 0
     2190           no-error .
     2191           if not available buf_gds-grp-attr
     2192           then do:
     2193               assign
     2194                   p-exists = no
     2195               .
     2196           end.
     2197           else do:
     2198               assign
     2199                   p-exists = yes
     2200                   p-range  = 1
     2201               .
     2202           end.
     2203       end.
     2204       else do:
     2205           assign
     2206               p-exists = yes
     2207               p-range  = 2
     2208           .
     2209       end.
     2210   end.
     2211   else do:
     2212       assign
     2213           p-exists = yes
     2214           p-range  = 3
     2215       .
     2216   end.
     2217   if available buf_gds-grp-attr
     2218   then do:
     2219     assign
     2220     p-attr-value = buf_gds-grp-attr.attr-value
     2221     .
     2222   end.
     2223   end.
     2224   end procedure.
     2225   procedure ver-gds-grp-nabor :
     2226   do
     2227   on error undo, return error return-value
     2228   :
     2229   define input  parameter p-gds-code as integer   no-undo .
     2230   define output parameter p-nabor as logical   no-undo .
     2231   define buffer buf_goods for ub.goods.
     2232   p-nabor = false .
     2233   find first  buf_goods no-lock where buf_goods.gds-code = p-gds-code no-error .
     2234   if error-status :error then return error .
     2235   define variable v-value       as character  no-undo.
     2236   define variable v-type        as character  no-undo.
     2237     run grp-attr-value (
     2238        input   buf_goods.grp-code
     2239       ,input   'gds-grp-nabor':U
     2240       ,input   0
     2241       ,input   ""
     2242       ,input   0
     2243       ,output  v-value
     2244       ,output  v-type       ) no-error .
     2245       if error-status :error then return error .
     2246     if v-value = "yes" then p-nabor = true  .
     2247   end.
     2248   end procedure.
