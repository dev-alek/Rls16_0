     3152   ON CHOOSE OF b-find-by-full-name IN FRAME Dlg-grp
     3153   DO:
     3154       define variable v-new-name as character no-undo.
     3155       run grplib-expand-name in this-procedure (
     3156             input fi-search :screen-value
     3157           , output v-new-name
     3158       ) no-error.
     3159       if error-status :error
     3160       then do:
     3161           message return-value.
     3162           undo, return no-apply.
     3163       end.
     3164       if v-new-name = ""
     3165       then do:
     3166           message
     3167               "Не найдена группа с полным именем, начинающимся на"
     3168               skip "'" + fi-search :screen-value + "'"
     3169           view-as alert-box information.
     3170           assign
     3171               v-new-name = fi-search :screen-value
     3172           .
     3173       end.
     3174       assign
     3175           fi-search :screen-value  = right-trim( v-new-name, chr(47) )
     3176           fi-search :cursor-offset = length( v-new-name ) + 1
     3177       .
     3178   END.
