     3714             vss-workfile vss-revision vss-description
     3715             skip "Ошибка при подсчете строк списка групп."
     3716             skip return-value
     3717             skip trim(error-status :get-message(1))
     3718                  trim(error-status :get-message(2))
     3719                  trim(error-status :get-message(3))
     3720                  trim(error-status :get-message(4))
     3721                  trim(error-status :get-message(5))
     3722           view-as alert-box error.
     3723           undo, return no-apply .
