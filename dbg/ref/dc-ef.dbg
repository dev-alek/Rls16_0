     1369   FUNCTION get-ef-petrol-code RETURNS INTEGER
     1370     ( INPUT p-b-code AS INTEGER ) :
     1371   DEFINE VARIABLE v-ef-petrol-code AS INTEGER NO-UNDO.
     1372   define variable v-key-rec as character no-undo .
     1373   DEFINE buffer buf_goods FOR ub.goods.
     1374   DEFINE buffer buf_ext-classif FOR ub.ext-classif.
     1375   FIND FIRST buf_goods NO-LOCK WHERE
     1376           buf_goods.gds-code = p-b-code .
     1377   run gen-key-rec in THIS-PROCEDURE ( INPUT 'goods':U
     1378                                     ,INPUT (buffer buf_goods:HANDLE)
     1379                                       ,OUTPUT v-key-rec).
     1380    FIND FIRST buf_ext-classif NO-LOCK WHERE
     1381               buf_Ext-classif.classif-subject = 'goods':U
     1382            AND buf_Ext-classif.classif-name = 'exp-easyfuel-talon-gds-code':U
     1383         AND buf_ext-classif.uniq-key-rec = v-key-rec NO-ERROR.
     1384    IF AVAILABLE buf_ext-classif THEN DO:
     1385      ASSIGN
     1386      v-ef-petrol-code = buf_ext-classif.key#_one.
     1387    END.
     1388    RETURN v-ef-petrol-code.
     1389   END FUNCTION.
     1390   FUNCTION get-petrol-gds-code RETURNS INTEGER
     1391     ( INPUT p-ef-petrol-code AS INTEGER ) :
     1392   define variable v-tbl-row as rowid no-undo .
     1393   define variable v-tbl-name as character no-undo .
     1394   define variable v-key-rec as character no-undo .
     1395   DEFINE buffer buf_goods FOR ub.goods.
     1396   DEFINE buffer buf_ext-classif FOR ub.ext-classif.
     1397    FIND FIRST buf_ext-classif NO-LOCK WHERE
     1398               buf_Ext-classif.classif-subject = 'goods':U
     1399            AND buf_Ext-classif.classif-name = 'exp-easyfuel-talon-gds-code':U
     1400         AND buf_ext-classif.key#_one = p-ef-petrol-code NO-ERROR.
     1401    IF AVAILABLE buf_ext-classif THEN DO:
     1402      run gen-row-keyr in this-procedure (
     1403                                           input  buf_ext-classif.uniq-key-rec
     1404                                          ,input ?
     1405                                          ,input "ub"
     1406                                          ,input ?
     1407                                          ,input no-lock
     1408                                          ,output v-tbl-row
     1409                                          ,output v-tbl-name) no-error.
     1410      if not error-status:error then do:
     1411        find first buf_goods no-lock where
     1412                 rowid(buf_goods) = v-tbl-row.
     1413        return buf_goods.gds-code.
     1414      end.
     1415    END.
     1416    RETURN 0.
     1417   END FUNCTION.
     1418   procedure fill-main-table :
     1419   define input parameter p-d-card as character no-undo .
     1420   define parameter buffer buf_dis-card for ub.dis-card.
     1421   define buffer buf_temp-dis-card-property for temp-dis-card-property.
     1422   define buffer buf_temp-ef for temp-ef.
     1423   do
     1424   on error undo, return error
     1425   :
     1426     for each buf_temp-ef:
     1427       delete buf_temp-ef.
     1428     end.
     1429     create buf_temp-ef.
     1430     buf_temp-ef.ef-format = 1.
     1431     if available buf_dis-card then do:
     1432       buffer-copy buf_dis-card
     1433       except d-card
     1434       to buf_temp-ef
     1435       assign
     1436       buf_temp-ef.d-card = p-d-card
     1437       .
     1438     end.
     1439     else do:
     1440       assign
     1441       buf_temp-ef.d-card = p-d-card.
     1442     end.
     1443    FOR EACH temp-dis-card-property where
     1444          temp-dis-card-property.d-card = p-d-card
     1445       and temp-dis-card-property.dtm-code = 25
     1446       :
     1447      CASE temp-dis-card-property.node-code:
     1448        WHEN 1 THEN DO:
     1449          buf_temp-ef.car-reg-number = temp-dis-card-property.property-value-character.
     1450        END.
     1451        WHEN 2 THEN DO:
     1452           buf_temp-ef.car-brand = temp-dis-card-property.property-value-character.
     1453        END.
     1454        WHEN 3 THEN DO:
     1455          buf_temp-ef.ef-format = temp-dis-card-property.property-value-integer.
     1456          IF ERROR-STATUS:ERROR THEN UNDO, RETURN ERROR.
     1457        END.
     1458        WHEN 4 THEN DO:
     1459          buf_temp-ef.access-key = temp-dis-card-property.property-value-character.
     1460        END.
     1461        WHEN 5 THEN DO:
     1462          buf_temp-ef.petrol-code-1 = temp-dis-card-property.property-value-integer.
     1463        END.
     1464        WHEN 6 THEN DO:
     1465          buf_temp-ef.petrol-code-2 = temp-dis-card-property.property-value-integer.
     1466        END.
     1467        WHEN 7 THEN DO:
     1468           buf_temp-ef.petrol-code-3 = temp-dis-card-property.property-value-integer.
     1469        END.
     1470        WHEN 8 THEN DO:
     1471          buf_temp-ef.petrol-code-4 = temp-dis-card-property.property-value-integer.
     1472        END.
     1473        WHEN 11 THEN DO:
     1474           buf_temp-ef.init-date-time = temp-dis-card-property.property-value-character.
     1475        END.
     1476        WHEN 12 THEN DO:
     1477           buf_temp-ef.init-operator = temp-dis-card-property.property-value-character.
     1478        END.
     1479        WHEN 13 THEN DO:
     1480           buf_temp-ef.issued-by = temp-dis-card-property.property-value-character.
     1481           buf_temp-ef.db-num = integer(entry(1, temp-dis-card-property.property-value-character, "-")).
     1482           buf_temp-ef.user-id = integer(entry(2, temp-dis-card-property.property-value-character, "-")).
     1483        END.
     1484      END CASE.
     1485    END.
     1486    RUN fill-tables IN THIS-PROCEDURE ( INPUT buf_temp-ef.ef-format, buffer buf_temp-ef) NO-ERROR.
     1487   end.
     1488   end procedure.
     1489   PROCEDURE fill-tables :
     1490   DEFINE INPUT PARAMETER p-ef-format AS INTEGER NO-UNDO.
     1491   define parameter buffer buf_temp-ef for temp-ef.
     1492   DEFINE VARIABLE v-ii AS INTEGER NO-UNDO.
     1493   DEFINE VARIABLE v-gds-code AS INTEGER NO-UNDO.
     1494   DEFINE BUFFER bufl_temp-dis-card-property FOR temp-dis-card-property.
     1495   DEFINE BUFFER buf_temp-dis-card-property FOR temp-dis-card-property.
     1496   CASE p-ef-format:
     1497     WHEN 1  THEN DO:
     1498       FOR EACH bufl_temp-dis-card-property NO-LOCK WHERE
     1499               bufl_temp-dis-card-property.d-card = buf_temp-ef.d-card
     1500            AND bufl_temp-dis-card-property.dtm-code = 24:
     1501         FIND FIRST temp-ef1 WHERE
     1502                   temp-ef1.d-card = buf_temp-ef.d-card
     1503               and temp-ef1.dt-code = bufl_temp-dis-card-property.dt-code NO-ERROR.
     1504         IF NOT AVAILABLE temp-ef1 THEN do:
     1505            CREATE temp-ef1.
     1506            ASSIGN
     1507            temp-ef1.d-card = buf_temp-ef.d-card
     1508            temp-ef1.sum-id = bufl_temp-dis-card-property.sum-id
     1509            temp-ef1.dt-code = bufl_temp-dis-card-property.dt-code
     1510            temp-ef1.dtm-code = bufl_temp-dis-card-property.dtm-code
     1511            .
     1512            v-gds-code = propreft-string-to-petrol( INPUT bufl_temp-dis-card-property.sum-id).
     1513            ASSIGN
     1514            temp-ef1.petrol-code  = v-gds-CODE
     1515            .
     1516            ASSIGN
     1517            temp-ef1.ef-petrol-code = get-ef-petrol-code ( temp-ef1.petrol-code)
     1518             .
     1519            DO v-ii = 1 TO 4:
     1520              IF temp-ef1.petrol-code = buffer buf_temp-ef:buffer-field( substitute("petrol-code-&1", v-ii)):buffer-value THEN DO:
     1521                temp-ef1.petrol-num = v-ii.
     1522              END.
     1523            END.
     1524         END.
     1525         CASE bufl_temp-dis-card-property.node-code:
     1526           WHEN 1 THEN DO:
     1527               ASSIGN
     1528               temp-ef1.month-limit = bufl_temp-dis-card-property.property-value-decimal
     1529               temp-ef1.unlim-month-limit = (temp-ef1.month-limit = ?)
     1530               .
     1531           END.
     1532           WHEN 2 THEN DO:
     1533               ASSIGN
     1534               temp-ef1.day-limit = bufl_temp-dis-card-property.property-value-decimal
     1535               temp-ef1.unlim-day-limit = (temp-ef1.day-limit = ?)
     1536               .
     1537           END.
     1538           WHEN 3 THEN DO:
     1539               ASSIGN
     1540               temp-ef1.standard-dose = bufl_temp-dis-card-property.property-value-decimal.
     1541           END.
     1542           WHEN 4 THEN DO:
     1543               ASSIGN
     1544               temp-ef1.common-limit = bufl_temp-dis-card-property.property-value-decimal
     1545               temp-ef1.unlim-common-limit = (temp-ef1.common-limit = ?)
     1546               .
     1547           END.
     1548         END CASE.
     1549      END.
     1550     END.
     1551     OTHERWISE DO:
     1552        MESSAGE
     1553        substitute("Формат данныx &1 для МБ в настоящий момент не поддерживается", p-ef-format)
     1554        VIEW-AS ALERT-BOX ERROR.
     1555        UNDO, RETURN ERROR.
     1556     END.
     1557   END CASE.
     1558   END PROCEDURE.
     1559   procedure fill-expenses :
     1560   DEFINE INPUT PARAMETER p-ef-format AS INTEGER NO-UNDO.
     1561   define parameter buffer buf_temp-ef for temp-ef.
     1562   define variable v-cd-petrol-code as character no-undo .
     1563   define buffer buf_cd-trans for ub.cd-trans.
     1564   define buffer bufe_cd-trans for ub.cd-trans.
     1565   define buffer buf_temp-ef1 for temp-ef1.
     1566   do
     1567   on error undo, return error
     1568   :
     1569     for each buf_temp-ef1 where
     1570           buf_temp-ef1.d-card = buf_temp-ef.d-card:
     1571       find last buf_cd-trans no-lock where
     1572               buf_cd-trans.trans-type  = integer('40':U)
     1573           and buf_cd-trans.charkey_one = buf_temp-ef.d-card
     1574           and buf_cd-trans.charkey_two = v-cd-petrol-code use-index ichkdate
     1575             no-error.
     1576       if available buf_cd-trans then do:
     1577         find first bufe_cd-trans no-lock where
     1578               bufe_cd-trans.trans-type  = integer('41':U)
     1579           and bufe_cd-trans.charkey_one = buf_temp-ef.d-card
     1580           and bufe_cd-trans.charkey_two = v-cd-petrol-code
     1581           and bufe_cd-trans.trans-id-chr = buf_cd-trans.trans-id-chr use-index ichkdate no-error .
     1582         if available bufe_cd-trans then do:
     1583           assign
     1584           buf_temp-ef1.common-expense = buf_cd-trans.deckey_one
     1585           buf_temp-ef1.month-expense = buf_cd-trans.deckey_two
     1586           buf_temp-ef1.day-expense = buf_cd-trans.deckey_three
     1587           buf_temp-ef1.last-date = buf_cd-trans.chk-date
     1588           .
     1589         end.
     1590         else do:
     1591           assign
     1592           buf_temp-ef1.last-date = string-to-date(buf_temp-ef.init-date-time)
     1593           .
     1594         end.
     1595       end.
     1596       else do:
     1597         assign
     1598         buf_temp-ef1.last-date = string-to-date(buf_temp-ef.init-date-time)
     1599         .
     1600       end.
     1601     end.
     1602   end.
     1603   end procedure.
     1604   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1605   function usrfulnf returns character ( input p-user-id as character):
     1606   define variable v-user-name as character no-undo .
     1607   define variable vss-include-info14 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1608   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run usrfulnm in g#library
     1609     (input  p-user-id
     1610     ,output v-user-name
     1611     ) no-error .
     1612   if error-status:error
     1613   or v-user-name = ""
     1614   then do:
     1615     return p-user-id.
     1616   end.
     1617   else do:
     1618     return v-user-name.
     1619   end.
     1620   end function.
     1621   define variable is-ef-chr as character no-undo .
     1622   define variable par-type as character no-undo .
     1623   define variable v-init-mode as logical no-undo .
     1624   define buffer buf_prop-head for ub.prop-head.
     1625   define buffer buf_prop-ref for ub.prop-ref.
     1626   DEFINE BUFFER buf_dis-card-type FOR ub.dis-card-type.
     1627   DEFINE VARIABLE v-petrol-code AS INTEGER NO-UNDO EXTENT 4.
     1628   FUNCTION get-gds-name RETURNS CHARACTER
     1629     ( INPUT p-gds-code AS INTEGER )  FORWARD.
     1630   DEFINE BUTTON b-add-limits
     1631        LABEL "Добавить лимиты"
     1632        SIZE 17 BY 1.
     1633   DEFINE BUTTON b-card
     1634        LABEL "Карта"
     1635        SIZE 10 BY 1.
     1636   DEFINE BUTTON b-cli
     1637        LABEL "Клиент"
     1638        SIZE 10 BY 1.
     1639   DEFINE BUTTON b-del-limits
     1640        LABEL "Удалить лимиты"
     1641        SIZE 17 BY 1.
     1642   DEFINE BUTTON B-exit AUTO-GO
     1643        LABEL "&Ввод"
     1644        SIZE 10 BY 1
     1645        BGCOLOR 8 .
     1646   DEFINE BUTTON B-Help
     1647        LABEL "Помо&щь"
     1648        SIZE 3 BY 1
     1649        BGCOLOR 8 .
     1650   DEFINE BUTTON b-initialize AUTO-GO
     1651        LABEL "Инициализация МБ"
     1652        SIZE 20 BY 1.
     1653   DEFINE BUTTON b-quit AUTO-END-KEY
     1654        LABEL "&Отмена"
     1655        SIZE 10 BY 1
     1656        BGCOLOR 8 .
     1657   DEFINE VARIABLE f-access-key AS CHARACTER FORMAT "X(8)":U
     1658        LABEL "Ключ доступа"
     1659        VIEW-AS FILL-IN NATIVE
     1660        SIZE 9 BY 1 NO-UNDO.
     1661   DEFINE VARIABLE f-car-brand AS CHARACTER FORMAT "X(256)":U
     1662        LABEL "Марка ТС"
     1663        VIEW-AS FILL-IN
     1664        SIZE 40 BY 1.07 NO-UNDO.
     1665   DEFINE VARIABLE f-car-reg-number AS CHARACTER FORMAT "X(10)":U
     1666        LABEL "Гос.рег.знак"
     1667        VIEW-AS FILL-IN
     1668        SIZE 11 BY 1 NO-UNDO.
     1669   DEFINE VARIABLE f-init-date-time AS CHARACTER FORMAT "X(19)":U
     1670        LABEL "Дата и время прошивки"
     1671        VIEW-AS FILL-IN NATIVE
     1672        SIZE 20 BY 1 NO-UNDO.
     1673   DEFINE VARIABLE f-init-operator-name AS CHARACTER FORMAT "X(20)":U
     1674        LABEL "Инициализировал"
     1675        VIEW-AS FILL-IN NATIVE
     1676        SIZE 19 BY 1 NO-UNDO.
     1677   DEFINE VARIABLE f-issued-by-name AS CHARACTER FORMAT "X(20)":U
     1678        LABEL "Выдал"
     1679        VIEW-AS FILL-IN NATIVE
     1680        SIZE 19 BY 1 NO-UNDO.
     1681   DEFINE VARIABLE l-ef-format AS CHARACTER FORMAT "X(256)":U INITIAL "Формат данных на МБ"
     1682         VIEW-AS TEXT
     1683        SIZE 20 BY .67 NO-UNDO.
     1684   DEFINE VARIABLE rs-ef-format AS INTEGER INITIAL 1
     1685        VIEW-AS RADIO-SET HORIZONTAL
     1686        RADIO-BUTTONS
     1687             "1", 1,
     1688   "2", 2
     1689        SIZE 7 BY 1 NO-UNDO.
     1690   DEFINE QUERY br-ef1 FOR
     1691         temp-ef1 SCROLLING.
     1692   DEFINE BROWSE br-ef1
     1693     QUERY br-ef1 DISPLAY
     1694         temp-ef1.petrol-num COLUMN-LABEL "№ топ.!на МБ" format "9"
     1695    temp-ef1.petrol-code COLUMN-LABEL "Код!топлива!(IBS TH)"
     1696    temp-ef1.ef-petrol-code COLUMN-LABEL "Код!топлива!EasyFuel"
     1697    get-gds-name(temp-ef1.petrol-code) COLUMN-LABEL "Название!топлива" FORMAT "X(10)"
     1698    temp-ef1.standard-dose COLUMN-LABEL "Стандартная!доза" FORMAT ">>,>>9"
     1699    temp-ef1.day-limit   COLUMN-LABEL "Дневной!лимит" FORMAT ">,>>>,>>9"
     1700    temp-ef1.unlim-day-limit COLUMN-LABEL  "Дневн!лимит!неогран" label-font 4 view-as toggle-box
     1701    temp-ef1.month-limit COLUMN-LABEL  "Месячный!лимит" FORMAT ">,>>>,>>9"
     1702    temp-ef1.unlim-month-limit COLUMN-LABEL  "Месячн!лимит!неогран" label-font 4 view-as toggle-box
     1703    temp-ef1.common-limit COLUMN-LABEL "Общий!лимит" FORMAT ">,>>>,>>9"
     1704    temp-ef1.unlim-common-limit COLUMN-LABEL  "Общий!лимит!неогран" label-font 4 view-as toggle-box
     1705    ENABLE
     1706    temp-ef1.petrol-num
     1707    temp-ef1.standard-dose
     1708    temp-ef1.day-limit
     1709    temp-ef1.month-limit
     1710    temp-ef1.common-limit
     1711    temp-ef1.unlim-day-limit
     1712    temp-ef1.unlim-month-limit
     1713    temp-ef1.unlim-common-limit
     1714       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 12.8 FIT-LAST-COLUMN.
     1715   DEFINE FRAME Dialog-Frame
     1716        B-exit AT ROW 1 COL 1
     1717        b-quit AT ROW 1 COL 11
     1718        b-card AT ROW 1 COL 38 WIDGET-ID 36
     1719        b-cli AT ROW 1 COL 48 WIDGET-ID 38
     1720        b-initialize AT ROW 1 COL 58 WIDGET-ID 34
     1721        B-Help AT ROW 1 COL 95
     1722        f-car-brand AT ROW 2.33 COL 14 COLON-ALIGNED
     1723        f-access-key AT ROW 2.33 COL 76 COLON-ALIGNED WIDGET-ID 30 PASSWORD-FIELD
     1724        f-car-reg-number AT ROW 3.93 COL 14 COLON-ALIGNED
     1725        rs-ef-format AT ROW 3.93 COL 48 NO-LABEL WIDGET-ID 22
     1726        f-init-date-time AT ROW 3.93 COL 76.5 COLON-ALIGNED WIDGET-ID 32
     1727        b-add-limits AT ROW 5.27 COL 1 WIDGET-ID 28
     1728        b-del-limits AT ROW 5.27 COL 18 WIDGET-ID 46
     1729        f-issued-by-name AT ROW 5.27 COL 41 COLON-ALIGNED WIDGET-ID 44
     1730        f-init-operator-name AT ROW 5.27 COL 77.5 COLON-ALIGNED WIDGET-ID 42
     1731        br-ef1 AT ROW 6.33 COL 1 WIDGET-ID 100
     1732        l-ef-format AT ROW 3.93 COL 26 COLON-ALIGNED NO-LABEL WIDGET-ID 26
     1733        SPACE(51.09) SKIP(14.59)
     1734       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1735            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1736            TITLE "Идентификаторы и лимиты EasyFuel"
     1737            DEFAULT-BUTTON B-exit CANCEL-BUTTON b-quit.
     1738   ASSIGN
     1739          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1740          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1741   ASSIGN
     1742          f-access-key:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
     1743   ON END-ERROR OF FRAME Dialog-Frame
     1744   DO:
     1745     RUN undo-proc IN THIS-PROCEDURE NO-ERROR.
     1746   END.
     1747   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1748   DO:
     1749     APPLY "END-ERROR":U TO SELF.
     1750   END.
     1751   ON CHOOSE OF b-add-limits IN FRAME Dialog-Frame
     1752   DO:
     1753     DEFINE VARIABLE v-rid-list AS CHARACTER NO-UNDO.
     1754     define VARIABLE v-tbl-row    as rowid     no-undo.
     1755     define variable v-tbl-name   as character no-undo.
     1756     define variable v-sum-id   as character no-undo.
     1757     DEFINE VARIABLE v-gds-code AS INTEGER NO-UNDO.
     1758     define variable v-recid as recid no-undo .
     1759     DEFINE BUFFER buf_goods FOR ub.goods.
     1760     DEFINE BUFFER buf_ext-classif FOR ub.ext-classif.
     1761     DEFINE BUFFER buf_temp-ef1 FOR temp-ef1.
     1762     DEFINE BUFFER buf_prop-ref FOR ub.prop-ref.
     1763     run ref/proprefs.w (
     1764                       input parparentproc
     1765                     ,input 'b-sel'
     1766                     ,input "dtm-code"
     1767                     ,input STRING(24)
     1768                     ,input '':U
     1769                     ,input buf_Dis-card-type.uniq-key-rec
     1770                     ,input-output  v-rid-list) no-error.
     1771       find first buf_prop-ref no-lock where
     1772                 recid(buf_prop-ref) = integer(v-rid-list) no-error .
     1773       if not available buf_prop-ref then return no-apply.
     1774     FIND FIRST buf_temp-ef1 NO-LOCK WHERE
     1775              buf_temp-ef1.d-card = p-d-card
     1776           and buf_temp-ef1.sum-id = buf_prop-ref.sum-id NO-ERROR.
     1777     IF AVAILABLE buf_temp-ef1 THEN DO:
     1778         MESSAGE
     1779         "Для данного МБ уже определены лимиты на данное топливо"
     1780         VIEW-AS ALERT-BOX ERROR.
     1781         RETURN NO-APPLY.
     1782     END.
     1783     CREATE buf_temp-ef1.
     1784     ASSIGN
     1785     buf_temp-ef1.sum-id = buf_prop-ref.sum-id
     1786     buf_temp-ef1.dt-code = buf_prop-ref.dt-code
     1787     buf_temp-ef1.dtm-code = buf_prop-ref.dtm-code
     1788     buf_temp-ef1.new_ = yes
     1789     buf_temp-ef1.d-card = p-d-card
     1790     .
     1791     v-gds-code = propreft-string-to-petrol(buf_prop-ref.sum-id).
     1792     ASSIGN
     1793     buf_temp-ef1.petrol-code = v-gds-code
     1794     .
     1795     ASSIGN
     1796     buf_temp-ef1.ef-petrol-code = get-ef-petrol-code( buf_temp-ef1.petrol-code)
     1797     buf_temp-ef1.petrol-num = 0
     1798     v-recid = recid(buf_temp-ef1)
     1799     .
     1800     OPEN QUERY br-ef1 FOR EACH temp-ef1 BY temp-ef1.petrol-code.
     1801     reposition  br-ef1 to recid v-recid no-error .
     1802     apply "ENTRY" to temp-ef1.petrol-num in browse br-ef1.
     1803   END.
     1804   ON CHOOSE OF b-card IN FRAME Dialog-Frame
     1805   DO:
     1806   DEFINE VARIABLE v-ri AS RECID NO-UNDO.
     1807     IF AVAILABLE X_dis-card THEN DO:
     1808         v-ri = RECID(X_dis-card).
     1809         run ref/dcardi.w ( INPUT parparentproc
     1810                           ,INPUT 'ПРОСМОТР':U
     1811                           ,INPUT X_dis-card.emitent-host-code
     1812                           ,INPUT v-cntxt-host-code-obj
     1813                           ,INPUT v-cntxt-obj-type
     1814                           ,INPUT v-cntxt-obj-code
     1815                           ,INPUT ?
     1816                           ,INPUT-OUTPUT v-ri) NO-ERROR.
     1817        IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1818     END.
     1819   END.
     1820   ON CHOOSE OF b-cli IN FRAME Dialog-Frame
     1821   DO:
     1822     IF AVAILABLE X_clients THEN DO:
     1823         run ref/showcli.p (
     1824          input parParentProc
     1825         ,input X_clients.obj-type
     1826         ,input X_clients.obj-code
     1827         ) NO-ERROR.
     1828      IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1829     END.
     1830   END.
     1831   ON CHOOSE OF b-del-limits IN FRAME Dialog-Frame
     1832   DO:
     1833   DEFINE BUFFER buf_temp-ef1 FOR temp-ef1.
     1834   DEFINE BUFFER del_dis-card-property FOR ub.dis-card-property.
     1835     IF NOT AVAILABLE temp-ef1 THEN RETURN NO-APPLY.
     1836     FIND FIRST buf_temp-ef1 WHERE recid(buf_temp-ef1) = RECID(temp-ef1).
     1837     FIND FIRST del_dis-card-property NO-LOCK WHERE
     1838               DEL_dis-card-property.d-card = buf_temp-ef1.d-card
     1839          AND  DEL_dis-card-property.dt-code = buf_temp-ef1.dt-code
     1840         AND DEL_dis-card-property.host-code = 0
     1841         AND DEL_dis-card-property.obj-type = ""
     1842         AND DEL_dis-card-property.obj-code = 0 NO-ERROR.
     1843     IF AVAILABLE DEL_dis-card-property THEN DO:
     1844         MESSAGE
     1845         "Нельзя удалить существующие лимиты"
     1846         VIEW-AS ALERT-BOX.
     1847         RETURN NO-APPLY.
     1848     END.
     1849     DELETE buf_temp-ef1.
     1850     OPEN QUERY br-ef1 FOR EACH temp-ef1 BY temp-ef1.petrol-code.
     1851     reposition  br-ef1 to ROW 1 no-error .
     1852     apply "ENTRY" to temp-ef1.petrol-num in browse br-ef1.
     1853   END.
     1854   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
     1855   DO:
     1856     RUN proc-save IN THIS-PROCEDURE NO-ERROR.
     1857     IF ERROR-STATUS:error THEN RETURN NO-APPLY.
     1858   END.
     1859   ON CHOOSE OF b-initialize IN FRAME Dialog-Frame
     1860   DO:
     1861    ASSIGN
     1862    p-setted = YES
     1863    .
     1864   END.
     1865   on value-changed of
     1866   temp-ef1.unlim-day-limit in browse br-ef1 do:
     1867   define variable old-unlim-day-limit as logical no-undo .
     1868   define buffer buf_temp-ef1 for temp-ef1.
     1869   if not avail temp-ef1 then return no-apply.
     1870   assign
     1871   old-unlim-day-limit = temp-ef1.unlim-day-limit
     1872   .
     1873   find first buf_temp-ef1 where
     1874            recid(buf_temp-ef1) = recid(temp-ef1).
     1875   case logical(temp-ef1.unlim-day-limit:screen-value in browse br-ef1):
     1876     when yes then do:
     1877       assign
     1878       buf_temp-ef1.day-limit = ?
     1879       buf_temp-ef1.unlim-day-limit = yes
     1880       .
     1881       temp-ef1.day-limit:read-only in browse br-ef1 = yes.
     1882     end.
     1883     when no then do:
     1884       if buf_temp-ef1.day-limit = ? then
     1885       assign
     1886       buf_temp-ef1.day-limit = 0
     1887       .
     1888       buf_temp-ef1.unlim-day-limit = no.
     1889       temp-ef1.day-limit:read-only in browse br-ef1 = no.
     1890     end.
     1891   end case.
     1892   release buf_temp-ef1.
     1893   display
     1894   temp-ef1.day-limit
     1895   temp-ef1.unlim-day-limit
     1896   with browse br-ef1.
     1897   end.
     1898   on value-changed of
     1899   temp-ef1.unlim-month-limit in browse br-ef1 do:
     1900   define variable old-unlim-month-limit as logical no-undo .
     1901   define buffer buf_temp-ef1 for temp-ef1.
     1902   if not avail temp-ef1 then return no-apply.
     1903   assign
     1904   old-unlim-month-limit = temp-ef1.unlim-month-limit
     1905   .
     1906   find first buf_temp-ef1 where
     1907            recid(buf_temp-ef1) = recid(temp-ef1).
     1908   case logical(temp-ef1.unlim-month-limit:screen-value in browse br-ef1):
     1909     when yes then do:
     1910       assign
     1911       buf_temp-ef1.month-limit = ?
     1912       buf_temp-ef1.unlim-month-limit = yes
     1913       .
     1914       temp-ef1.month-limit:read-only in browse br-ef1 = yes.
     1915     end.
     1916     when no then do:
     1917       if buf_temp-ef1.month-limit = ? then
     1918       assign
     1919       buf_temp-ef1.month-limit = 0
     1920       .
     1921       buf_temp-ef1.unlim-month-limit = no.
     1922       temp-ef1.month-limit:read-only in browse br-ef1 = no.
     1923     end.
     1924   end case.
     1925   release buf_temp-ef1.
     1926   display
     1927   temp-ef1.month-limit
     1928   temp-ef1.unlim-month-limit
     1929   with browse br-ef1.
     1930   end.
     1931   on value-changed of
     1932   temp-ef1.unlim-common-limit in browse br-ef1 do:
     1933   define variable old-unlim-common-limit as logical no-undo .
     1934   define buffer buf_temp-ef1 for temp-ef1.
     1935   if not avail temp-ef1 then return no-apply.
     1936   assign
     1937   old-unlim-common-limit = temp-ef1.unlim-common-limit
     1938   .
     1939   find first buf_temp-ef1 where
     1940            recid(buf_temp-ef1) = recid(temp-ef1).
     1941   case logical(temp-ef1.unlim-common-limit:screen-value in browse br-ef1):
     1942     when yes then do:
     1943       assign
     1944       buf_temp-ef1.common-limit = ?
     1945       buf_temp-ef1.unlim-common-limit = yes
     1946       .
     1947       temp-ef1.common-limit:read-only in browse br-ef1 = yes.
     1948     end.
     1949     when no then do:
     1950       if buf_temp-ef1.common-limit = ? then
     1951       assign
     1952       buf_temp-ef1.common-limit = 0
     1953       .
     1954       buf_temp-ef1.unlim-month-limit = no.
     1955       temp-ef1.common-limit:read-only in browse br-ef1 = no.
     1956     end.
     1957   end case.
     1958   release buf_temp-ef1.
     1959   display
     1960   temp-ef1.common-limit
     1961   temp-ef1.unlim-common-limit
     1962   with browse br-ef1.
     1963   end.
     1964   ON LEAVE OF
     1965   temp-ef1.petrol-num IN BROWSE br-ef1,
     1966   temp-ef1.month-limit in BROWSE br-ef1,
     1967   temp-ef1.day-limit in BROWSE br-ef1,
     1968   temp-ef1.standard-dose in BROWSE br-ef1,
     1969   temp-ef1.common-limit in BROWSE br-ef1 do:
     1970   define variable old-petrol-num as integer no-undo .
     1971   define variable old-month-limit as decimal no-undo .
     1972   define variable old-day-limit as decimal no-undo .
     1973   define variable old-standard-dose as decimal no-undo .
     1974   define variable old-common-limit as decimal no-undo .
     1975   define variable v-petrol-num as integer no-undo .
     1976   define buffer buf_temp-ef1 for temp-ef1.
     1977   if not avail temp-ef1 then return no-apply.
     1978   assign
     1979   old-petrol-num = temp-ef1.petrol-num
     1980   old-month-limit = temp-ef1.month-limit
     1981   old-day-limit = temp-ef1.day-limit
     1982   old-standard-dose = temp-ef1.standard-dose
     1983   old-common-limit = temp-ef1.common-limit
     1984   .
     1985   assign
     1986   v-petrol-num = integer(temp-ef1.petrol-num:screen-value in browse br-ef1)
     1987   .
     1988   if v-petrol-num > 4 then do:
     1989     message
     1990     "№ топлива на МБ EasyFuel не может быть больше 4!"
     1991     view-as alert-box error .
     1992     assign
     1993     temp-ef1.petrol-num:screen-value in browse br-ef1 = string(old-petrol-num)
     1994     .
     1995     return no-apply.
     1996   end.
     1997   find first buf_temp-ef1 where
     1998            buf_temp-ef1.d-card = p-d-card
     1999         and buf_temp-ef1.petrol-num = v-petrol-num
     2000         and v-petrol-num > 0
     2001         and recid(buf_temp-ef1) <> recid(temp-ef1) no-error.
     2002   if available buf_temp-ef1 then do:
     2003     message
     2004     "Уже есть такой № топлива на МБ EasyFuel!"
     2005     view-as alert-box error .
     2006     assign
     2007     temp-ef1.petrol-num:screen-value = string(old-petrol-num)
     2008     .
     2009     return no-apply.
     2010   end.
     2011   if decimal(temp-ef1.month-limit:screen-value in browse br-ef1) > 1000000 then do:
     2012     message
     2013     "Месячный лимит не может превышать 1000000"
     2014     view-as alert-box error.
     2015     assign
     2016     temp-ef1.month-limi:screen-value = string(old-month-limit)
     2017     .
     2018     return no-apply.
     2019   end.
     2020   if decimal(temp-ef1.day-limit:screen-value in browse br-ef1) > 32000 then do:
     2021     message
     2022     "Дневной лимит не может превышать 32000"
     2023     view-as alert-box error.
     2024     assign
     2025     temp-ef1.day-limit:screen-value = string(old-day-limit)
     2026     .
     2027     return no-apply.
     2028   end.
     2029   if decimal(temp-ef1.standard-dose:screen-value in browse br-ef1) > 32000 then do:
     2030     message
     2031     "Стандартная доза не может превышать 32000"
     2032     view-as alert-box error.
     2033     assign
     2034     temp-ef1.standard-dose:screen-value = string(old-standard-dose)
     2035     .
     2036     return no-apply.
     2037   end.
     2038   if decimal(temp-ef1.common-limit:screen-value in browse br-ef1) > 1000000 then do:
     2039     message
     2040     "Общий лимит не может превышать 1000000"
     2041     view-as alert-box error.
     2042     assign
     2043     temp-ef1.common-limi:screen-value = string(old-common-limit)
     2044     .
     2045     return no-apply.
     2046   end.
     2047   find first buf_temp-ef1 where recid(buf_temp-ef1) = recid(temp-ef1).
     2048   assign
     2049   buf_temp-ef1.petrol-num = integer(temp-ef1.petrol-num:screen-value in browse br-ef1)
     2050   buf_temp-ef1.month-limit = decimal(temp-ef1.month-limit:screen-value in browse br-ef1)
     2051   buf_temp-ef1.day-limit = decimal(temp-ef1.day-limit:screen-value in browse br-ef1)
     2052   buf_temp-ef1.standard-dose = decimal(temp-ef1.standard-dose:screen-value in browse br-ef1)
     2053   buf_temp-ef1.common-limit = decimal(temp-ef1.common-limit:screen-value in browse br-ef1)
     2054   .
     2055   END.
     2056   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     2057   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     2058   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2059   on help of frame Dialog-Frame
     2060   do:
     2061     run gbl/app_help.p
     2062       (input this-procedure :file-name
     2063       ,input ''
     2064       ,input ?
     2065       ) no-error.
     2066     if error-status :error then do:
     2067       message
     2068         "Ошибка при вызове помощи"
     2069         error-status :get-message(1)
     2070         view-as alert-box .
     2071     end.
     2072   end.
     2073   run minbtn-set in this-procedure .
     2074   on choose of b-help in frame Dialog-Frame
     2075   do:
     2076     apply "help":u to frame Dialog-Frame .
     2077   end.
     2078   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2079   procedure minbtn-set :
     2080       do
     2081           on error undo, return error return-value
     2082           :
     2083           define variable ii              as integer       no-undo .
     2084           define variable fh              as widget-handle no-undo .
     2085           define variable hh              as widget-handle no-undo .
     2086           define variable v-h             as handle        extent 4 no-undo .
     2087           define variable v-name-button   as character     no-undo .
     2088           define variable v-help-old-x    as decimal       no-undo .
     2089           define variable v-help-old-y    as decimal       no-undo .
     2090           define variable v-help-old-size as decimal       no-undo .
     2091           define variable v-frame-width   as decimal       no-undo .
     2092           define variable jj              as integer       no-undo .
     2093           do
     2094               on error undo, return error
     2095               :
     2096               assign
     2097                   v-frame-width = frame Dialog-Frame:width - 0.3
     2098                   fh            = frame Dialog-Frame:first-child
     2099                   hh            = fh:first-child
     2100                   ii            = 1
     2101                   .
     2102               do while valid-handle(hh):
     2103                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     2104                   do:
     2105                       case lc(hh:name) :
     2106                           when "b-help" then
     2107                               do:
     2108                                   hh:load-image-up("cmp/b-help.bmp":u) .
     2109                                   hh:load-image-down("cmp/b-help.bmp":u) .
     2110                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     2111                                   hh:TOOLTIP = "Помощь" .
     2112                                   v-help-old-x = hh:column .
     2113                                   v-help-old-y = hh:row    .
     2114                                   v-help-old-size = hh:width .
     2115                                   hh:width-chars = 2.5 .
     2116                               end.
     2117                           when "b-print" then
     2118                               do:
     2119                                   hh:load-image("cmp/b-print.bmp":u) .
     2120                                   hh:TOOLTIP = "Печать" .
     2121                                   v-h[ii] = hh:handle .
     2122                                   ii = ii + 1 .
     2123                                   hh:width-chars = 3 .
     2124                               end.
     2125                           when "b-history" or
     2126                           when "b-hist" then
     2127                               do:
     2128                                   hh:load-image("cmp/b-hist.bmp":u) .
     2129                                   hh:TOOLTIP = "История" .
     2130                                   v-h[ii] = hh:handle .
     2131                                   ii = ii + 1 .
     2132                                   hh:width-chars = 3 .
     2133                               end.
     2134                           when "b-sch" then
     2135                               do:
     2136                                   hh:load-image("cmp/b-sch.bmp":u) .
     2137                                   hh:TOOLTIP = "Установка Фильтра" .
     2138                                   v-h[ii] = hh:handle .
     2139                                   ii = ii + 1 .
     2140                                   hh:width-chars = 3 .
     2141                               end.
     2142                           when "b-hist-user" then
     2143                               do:
     2144                                   hh:load-image("cmp/b-hist.bmp":u) .
     2145                                   hh:TOOLTIP = "История пользователя" .
     2146                                   ii = ii + 1 .
     2147                               end.
     2148                       end case.
     2149                   end.
     2150                   hh = hh:next-sibling.
     2151               end.
     2152               b-help:column = v-frame-width - b-help:width-chars.
     2153               jj = 0.
     2154               repeat ii = 4 to 1 by -1 :
     2155                   if valid-handle (v-h[ii] ) then
     2156                   do:
     2157                       jj  = jj + 1 .
     2158                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     2159                       v-h[ii]:row    = v-help-old-y .
     2160                   end.
     2161               end.
     2162           end.
     2163       end.
     2164   end procedure.
     2165   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     2166   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     2167   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     2168   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     2169   define variable v-diasize-current-frame-width  as decimal   no-undo .
     2170   define variable v-diasize-current-frame-height as decimal   no-undo .
     2171   define variable v-diasize-change-size          as logical   no-undo .
     2172   define variable v-diasize-resize-button        as handle    no-undo .
     2173   define variable v-diasize-wndmax               as logical   no-undo .
     2174   define variable v-diasize-wndstore             as logical   no-undo .
     2175   define variable v-diasize-proc-name            as character no-undo .
     2176   define variable v-diasize-browse-handle        as handle    no-undo .
     2177   define variable v-diasize-browse-number        as integer   no-undo .
     2178   define variable v-diasize-need-full-display    as logical   no-undo init false .
     2179   define temp-table temp-diasize-handle no-undo
     2180     field handle-value  as handle
     2181     field save-position as decimal
     2182     index xpk is primary unique handle-value
     2183     .
     2184   define temp-table temp-browse-handle no-undo
     2185     field browse-type   as character
     2186     field browse-number as integer
     2187     field browse-handle as handle
     2188     field original-size as decimal
     2189     index xpk is primary unique browse-type browse-number
     2190     index xie browse-type browse-handle
     2191   .
     2192   procedure diasize_change-height :
     2193     define input  parameter p-change-value  as decimal   no-undo .
     2194     define input  parameter p-move-resize   as logical   no-undo .
     2195     define variable v-field-group-handle    as handle    no-undo .
     2196     define variable v-object-handle         as handle    no-undo .
     2197     define variable v-frame-height          as decimal   no-undo .
     2198     define variable v-frame-virtual-height  as decimal   no-undo .
     2199     define variable v-browse-height         as decimal   no-undo .
     2200     define variable v-window-height         as decimal   no-undo .
     2201     define variable v-window-virtual-height as decimal   no-undo .
     2202     define variable v-change-sign           as integer   no-undo .
     2203     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2204     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2205     if p-change-value > 0
     2206     then do:
     2207       if frame Dialog-Frame :height + p-change-value
     2208           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     2209       then do:
     2210         assign
     2211           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     2212                           - (frame Dialog-Frame :height-chars)
     2213         .
     2214         if p-change-value <= 0
     2215         then do:
     2216           run diasize_position-resize-button in this-procedure .
     2217           return .
     2218         end.
     2219       end.
     2220     end.
     2221     if p-change-value < 0
     2222     then do:
     2223       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     2224       then do:
     2225         assign
     2226           p-change-value = v-diasize-orig-frame-height
     2227                          - (frame Dialog-Frame :height-chars)
     2228         .
     2229         if p-change-value >= 0
     2230         then do:
     2231           run diasize_position-resize-button in this-procedure .
     2232           return .
     2233         end.
     2234       end.
     2235     end.
     2236     if p-change-value >= 0
     2237     then do:
     2238       assign
     2239         v-change-sign = 1
     2240       .
     2241     end.
     2242     else do:
     2243       assign
     2244         v-change-sign = -1
     2245       .
     2246     end.
     2247     assign
     2248       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2249     .
     2250     if p-change-value = 0
     2251     then do:
     2252       run diasize_position-resize-button in this-procedure .
     2253       return .
     2254     end.
     2255     move_block:
     2256     do
     2257     on error undo move_block, retry move_block
     2258     :
     2259       if retry
     2260       then do:
     2261         do
     2262         on error undo move_block, leave move_block
     2263         :
     2264           if p-change-value > 0
     2265           then do:
     2266             for each buf_temp-diasize-handle
     2267             on error undo, next
     2268             :
     2269               assign
     2270                 v-object-handle = buf_temp-diasize-handle.handle-value
     2271               .
     2272               if v-object-handle <> v-diasize-resize-button
     2273               then do:
     2274                 assign
     2275                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2276                 .
     2277               end.
     2278             end.
     2279             assign
     2280               v-diasize-browse-handle :height = v-browse-height
     2281             .
     2282             for each buf_temp-browse-handle
     2283               where buf_temp-browse-handle.browse-type = 'height':u
     2284             on error undo, next
     2285             :
     2286               assign
     2287                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2288               .
     2289             end.
     2290             assign
     2291               frame Dialog-Frame :height = v-frame-height
     2292             .
     2293             if frame Dialog-Frame :scrollable = true
     2294             then do:
     2295               assign
     2296                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     2297               .
     2298             end.
     2299             run diasize_position-resize-button in this-procedure .
     2300           end.
     2301           else do:
     2302             if frame Dialog-Frame :scrollable = true
     2303             then do:
     2304               assign
     2305                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     2306               .
     2307             end.
     2308             assign
     2309               frame Dialog-Frame :height = v-frame-height
     2310             .
     2311             assign
     2312               v-diasize-browse-handle :height = v-browse-height
     2313             .
     2314             for each buf_temp-browse-handle
     2315               where buf_temp-browse-handle.browse-type = 'height':u
     2316             on error undo, next
     2317             :
     2318               assign
     2319                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2320               .
     2321             end.
     2322             for each buf_temp-diasize-handle
     2323             on error undo, next
     2324             :
     2325               assign
     2326                 v-object-handle = buf_temp-diasize-handle.handle-value
     2327               .
     2328               if v-object-handle <> v-diasize-resize-button
     2329               then do:
     2330                 assign
     2331                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2332                 .
     2333               end.
     2334             end.
     2335             run diasize_position-resize-button in this-procedure .
     2336           end.
     2337           assign
     2338             v-diasize-change-size = false
     2339           .
     2340           leave move_block .
     2341         end.
     2342       end.
     2343       assign
     2344         v-diasize-need-full-display = true
     2345       .
     2346       if v-diasize-change-size = false
     2347       then do:
     2348         assign
     2349           v-diasize-change-size = true
     2350         .
     2351       end.
     2352       else do:
     2353         return .
     2354       end.
     2355       assign
     2356         v-frame-height = frame Dialog-Frame :height
     2357         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     2358         v-browse-height = v-diasize-browse-handle :height
     2359       .
     2360       for each buf_temp-browse-handle
     2361         where buf_temp-browse-handle.browse-type = 'height':u
     2362       :
     2363         assign
     2364           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     2365         .
     2366       end.
     2367       for each buf_temp-diasize-handle
     2368       :
     2369         delete buf_temp-diasize-handle .
     2370       end.
     2371       assign
     2372         v-field-group-handle = frame Dialog-Frame :first-child
     2373       .
     2374       do while valid-handle(v-field-group-handle)
     2375       :
     2376         assign
     2377           v-object-handle = v-field-group-handle :first-child
     2378         .
     2379         do while valid-handle(v-object-handle)
     2380         :
     2381           if  v-object-handle <> v-diasize-browse-handle :handle
     2382           and can-query(v-object-handle, "row")
     2383           and can-query(v-object-handle, "height")
     2384           and ( v-object-handle :row > v-diasize-browse-handle :row )
     2385           then do:
     2386             find first buf_temp-browse-handle
     2387               where buf_temp-browse-handle.browse-type   = 'height':u
     2388                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2389               no-error .
     2390             if available buf_temp-browse-handle
     2391             then do:
     2392             end.
     2393             else do:
     2394               create buf_temp-diasize-handle .
     2395               assign
     2396                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2397                 buf_temp-diasize-handle.save-position = v-object-handle :row
     2398               .
     2399             end.
     2400           end.
     2401           assign
     2402             v-object-handle = v-object-handle :next-sibling
     2403           .
     2404         end.
     2405         assign
     2406           v-field-group-handle = v-field-group-handle :next-sibling
     2407         .
     2408       end.
     2409       do with frame Dialog-Frame
     2410       :
     2411         hide v-diasize-resize-button .
     2412         assign
     2413           v-diasize-resize-button :row    = 1
     2414           v-diasize-resize-button :column = 1
     2415         .
     2416       end.
     2417       if p-change-value > 0
     2418       then do:
     2419         if frame Dialog-Frame :scrollable = true
     2420         then do:
     2421           assign
     2422             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2423             no-error .
     2424           if error-status :error
     2425           or error-status :get-message(1) <> ""
     2426           then do:
     2427             undo move_block, retry move_block .
     2428           end.
     2429         end.
     2430         assign
     2431           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2432           no-error .
     2433         if error-status :error
     2434         or error-status :get-message(1) <> ""
     2435         then do:
     2436           undo move_block, retry move_block .
     2437         end.
     2438         assign
     2439           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2440           no-error .
     2441         if error-status :error
     2442         or error-status :get-message(1) <> ""
     2443         then do:
     2444           undo move_block, retry move_block .
     2445         end.
     2446         for each buf_temp-browse-handle
     2447           where buf_temp-browse-handle.browse-type = 'height':u
     2448         on error undo move_block, retry move_block
     2449         :
     2450           assign
     2451             buf_temp-browse-handle.browse-handle :height
     2452               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2453             no-error .
     2454           if error-status :error
     2455           or error-status :get-message(1) <> ""
     2456           then do:
     2457             undo move_block, retry move_block .
     2458           end.
     2459         end.
     2460         for each buf_temp-diasize-handle
     2461         on error undo move_block, retry move_block
     2462         :
     2463           assign
     2464             v-object-handle = buf_temp-diasize-handle.handle-value
     2465           .
     2466           if v-object-handle <> v-diasize-resize-button
     2467           then do:
     2468             assign
     2469               v-object-handle :row = v-object-handle :row + p-change-value
     2470               no-error .
     2471             if error-status :error
     2472             or error-status :get-message(1) <> ""
     2473             then do:
     2474               undo move_block, retry move_block .
     2475             end.
     2476           end.
     2477         end.
     2478       end.
     2479       else do:
     2480         for each buf_temp-diasize-handle
     2481         on error undo move_block, retry move_block
     2482         :
     2483           assign
     2484             v-object-handle = buf_temp-diasize-handle.handle-value
     2485           .
     2486           if v-object-handle <> v-diasize-resize-button
     2487           then do:
     2488             assign
     2489               v-object-handle :row = v-object-handle :row + p-change-value
     2490               no-error .
     2491             if error-status :error
     2492             or error-status :get-message(1) <> ""
     2493             then do:
     2494               undo move_block, retry move_block .
     2495             end.
     2496           end.
     2497         end.
     2498         assign
     2499           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2500           no-error .
     2501         if error-status :error
     2502         or error-status :get-message(1) <> ""
     2503         then do:
     2504           undo move_block, retry move_block .
     2505         end.
     2506         for each buf_temp-browse-handle
     2507           where buf_temp-browse-handle.browse-type = 'height':u
     2508         on error undo move_block, retry move_block
     2509         :
     2510           assign
     2511             buf_temp-browse-handle.browse-handle :height
     2512               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2513             no-error .
     2514           if error-status :error
     2515           or error-status :get-message(1) <> ""
     2516           then do:
     2517             undo move_block, retry move_block .
     2518           end.
     2519         end.
     2520         assign
     2521           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2522           no-error .
     2523         if error-status :error
     2524         or error-status :get-message(1) <> ""
     2525         then do:
     2526           undo move_block, retry move_block .
     2527         end.
     2528         if frame Dialog-Frame :scrollable = true
     2529         then do:
     2530           assign
     2531             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2532             no-error .
     2533           if error-status :error
     2534           or error-status :get-message(1) <> ""
     2535           then do:
     2536             undo move_block, retry move_block .
     2537           end.
     2538         end.
     2539       end.
     2540       if p-move-resize = true
     2541       then do:
     2542         run diasize_position-resize-button in this-procedure .
     2543       end.
     2544       if v-diasize-wndstore = true
     2545       then do:
     2546         if connected("ub") = true
     2547         then do:
     2548           define variable v-cntxt-db-num        as integer   no-undo .
     2549           define variable v-cntxt-userid        as character no-undo .
     2550           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2551                                             , OUTPUT v-cntxt-userid
     2552                                             ) .
     2553           run gbl/wndsizew.p
     2554             (input  v-cntxt-db-num
     2555             ,input  v-cntxt-userid
     2556             ,input  v-diasize-proc-name
     2557             ,input  'height':u
     2558             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     2559             ) .
     2560         end.
     2561       end.
     2562     end.
     2563     assign
     2564       v-diasize-change-size = false
     2565     .
     2566   end procedure.
     2567   procedure diasize_set-height :
     2568     define input  parameter p-new-height  as decimal   no-undo .
     2569     define input  parameter p-move-resize as logical   no-undo .
     2570     do
     2571     on error undo, return error return-value
     2572     :
     2573       run diasize_change-height in this-procedure
     2574         (input  (p-new-height - frame Dialog-Frame :height)
     2575         ,input  p-move-resize
     2576         ) .
     2577     end.
     2578   end procedure.
     2579   procedure diasize_change-width :
     2580     define input  parameter p-change-value as decimal   no-undo .
     2581     define input  parameter p-move-resize  as logical   no-undo .
     2582     define variable v-field-group-handle   as handle    no-undo .
     2583     define variable v-object-handle        as handle    no-undo .
     2584     define variable v-frame-width          as decimal   no-undo .
     2585     define variable v-frame-virtual-width  as decimal   no-undo .
     2586     define variable v-browse-width         as decimal   no-undo .
     2587     define variable v-window-width         as decimal   no-undo .
     2588     define variable v-window-virtual-width as decimal   no-undo .
     2589     define variable v-change-sign          as integer   no-undo .
     2590     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2591     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2592     if p-change-value > 0
     2593     then do:
     2594       if frame Dialog-Frame :width + p-change-value >
     2595           session :width-chars
     2596       then do:
     2597         assign
     2598           p-change-value = session :width-chars - frame Dialog-Frame :width
     2599         .
     2600         if p-change-value <= 0
     2601         then do:
     2602           run diasize_position-resize-button in this-procedure .
     2603           return .
     2604         end.
     2605       end.
     2606     end.
     2607     if p-change-value < 0
     2608     then do:
     2609       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     2610       then do:
     2611         assign
     2612           p-change-value = v-diasize-orig-frame-width
     2613                          - frame Dialog-Frame :width
     2614         .
     2615         if p-change-value >= 0
     2616         then do:
     2617           run diasize_position-resize-button in this-procedure .
     2618           return .
     2619         end.
     2620       end.
     2621     end.
     2622     if p-change-value >= 0
     2623     then do:
     2624       assign
     2625         v-change-sign = 1
     2626       .
     2627     end.
     2628     else do:
     2629       assign
     2630         v-change-sign = -1
     2631       .
     2632     end.
     2633     assign
     2634       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2635     .
     2636     if p-change-value = 0
     2637     then do:
     2638       run diasize_position-resize-button in this-procedure .
     2639       return .
     2640     end.
     2641     move_block:
     2642     do
     2643     on error undo move_block, leave move_block
     2644     :
     2645       if retry
     2646       then do:
     2647         do
     2648         on error undo move_block, leave move_block
     2649         :
     2650           if p-change-value > 0
     2651           then do:
     2652             for each buf_temp-diasize-handle
     2653             on error undo, next
     2654             :
     2655               assign
     2656                 v-object-handle = buf_temp-diasize-handle.handle-value
     2657               .
     2658               if v-object-handle <> v-diasize-resize-button
     2659               then do:
     2660                 assign
     2661                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2662                 .
     2663               end.
     2664             end.
     2665             assign
     2666               v-diasize-browse-handle :width = v-browse-width
     2667             .
     2668             for each buf_temp-browse-handle
     2669               where buf_temp-browse-handle.browse-type = 'width':u
     2670             on error undo, next
     2671             :
     2672               assign
     2673                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2674               .
     2675             end.
     2676             assign
     2677               frame Dialog-Frame :width = v-frame-width
     2678             .
     2679             if frame Dialog-Frame :scrollable = true
     2680             then do:
     2681               assign
     2682                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2683               .
     2684             end.
     2685             run diasize_position-resize-button in this-procedure .
     2686           end.
     2687           else do:
     2688             if frame Dialog-Frame :scrollable = true
     2689             then do:
     2690               assign
     2691                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2692               .
     2693             end.
     2694             assign
     2695               frame Dialog-Frame :width = v-frame-width
     2696             .
     2697             for each buf_temp-browse-handle
     2698               where buf_temp-browse-handle.browse-type = 'width':u
     2699             on error undo, next
     2700             :
     2701               assign
     2702                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2703               .
     2704             end.
     2705             assign
     2706               v-diasize-browse-handle :width = v-browse-width
     2707             .
     2708             for each buf_temp-diasize-handle
     2709             on error undo, next
     2710             :
     2711               assign
     2712                 v-object-handle = buf_temp-diasize-handle.handle-value
     2713               .
     2714               if v-object-handle <> v-diasize-resize-button
     2715               then do:
     2716                 assign
     2717                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2718                 .
     2719               end.
     2720             end.
     2721             run diasize_position-resize-button in this-procedure .
     2722           end.
     2723           assign
     2724             v-diasize-change-size = false
     2725           .
     2726           leave move_block .
     2727         end.
     2728       end.
     2729       assign
     2730         v-diasize-need-full-display = true
     2731       .
     2732       if v-diasize-change-size = false
     2733       then do:
     2734         assign
     2735           v-diasize-change-size = true
     2736         .
     2737       end.
     2738       else do:
     2739         return .
     2740       end.
     2741       assign
     2742         v-frame-width = frame Dialog-Frame :width
     2743         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     2744         v-browse-width = v-diasize-browse-handle :width
     2745       .
     2746       for each buf_temp-browse-handle
     2747         where buf_temp-browse-handle.browse-type = 'width':u
     2748       :
     2749         assign
     2750           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2751         .
     2752       end.
     2753       for each buf_temp-diasize-handle
     2754       :
     2755         delete buf_temp-diasize-handle .
     2756       end.
     2757       assign
     2758         v-field-group-handle = frame Dialog-Frame :first-child
     2759       .
     2760       do while valid-handle(v-field-group-handle)
     2761       :
     2762         assign
     2763           v-object-handle = v-field-group-handle :first-child
     2764         .
     2765         do while valid-handle(v-object-handle)
     2766         :
     2767           if  v-object-handle <> v-diasize-browse-handle :handle
     2768           and v-object-handle <> v-diasize-resize-button
     2769           and can-query(v-object-handle, "row")
     2770           and can-query(v-object-handle, "height")
     2771           and ( v-object-handle :col + v-object-handle :width
     2772                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2773               )
     2774           then do:
     2775             find first buf_temp-browse-handle
     2776               where buf_temp-browse-handle.browse-type   = 'width':u
     2777                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2778               no-error .
     2779             if available buf_temp-browse-handle
     2780             then do:
     2781             end.
     2782             else do:
     2783               create buf_temp-diasize-handle .
     2784               assign
     2785                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2786                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2787               .
     2788             end.
     2789           end.
     2790           assign
     2791             v-object-handle = v-object-handle :next-sibling
     2792           .
     2793         end.
     2794         assign
     2795           v-field-group-handle = v-field-group-handle :next-sibling
     2796         .
     2797       end.
     2798       do with frame Dialog-Frame
     2799       :
     2800         hide v-diasize-resize-button .
     2801         v-diasize-resize-button :row = 1.
     2802         v-diasize-resize-button :column = 1.
     2803       end.
     2804       if p-change-value > 0
     2805       then do:
     2806         if frame Dialog-Frame :scrollable = true
     2807         then do:
     2808           assign
     2809             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2810             no-error .
     2811           if error-status :error
     2812           or error-status :get-message(1) <> ""
     2813           then do:
     2814             undo move_block, retry move_block.
     2815           end.
     2816         end.
     2817         assign
     2818           frame Dialog-Frame :width = v-frame-width + p-change-value
     2819           no-error .
     2820         if error-status :error
     2821         or error-status :get-message(1) <> ""
     2822         then do:
     2823           undo move_block, retry move_block.
     2824         end.
     2825         assign
     2826           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2827         no-error .
     2828         if error-status :error
     2829         or error-status :get-message(1) <> ""
     2830         then do:
     2831           undo move_block, retry move_block.
     2832         end.
     2833         for each buf_temp-browse-handle
     2834           where buf_temp-browse-handle.browse-type = 'width':u
     2835         on error undo move_block, retry move_block
     2836         :
     2837           assign
     2838             buf_temp-browse-handle.browse-handle :width
     2839               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2840             no-error .
     2841           if error-status :error
     2842           or error-status :get-message(1) <> ""
     2843           then do:
     2844             undo move_block, retry move_block .
     2845           end.
     2846         end.
     2847         for each buf_temp-diasize-handle
     2848         on error undo move_block, retry move_block
     2849         :
     2850           assign
     2851             v-object-handle = buf_temp-diasize-handle.handle-value
     2852           .
     2853           if v-object-handle <> v-diasize-resize-button
     2854           then do:
     2855             assign
     2856               v-object-handle :col = v-object-handle :col + p-change-value
     2857               no-error .
     2858             if error-status :error
     2859             or error-status :get-message(1) <> ""
     2860             then do:
     2861               undo move_block, retry move_block .
     2862             end.
     2863           end.
     2864         end.
     2865       end.
     2866       else do:
     2867         for each buf_temp-diasize-handle
     2868         on error undo move_block, retry move_block
     2869         :
     2870           assign
     2871             v-object-handle = buf_temp-diasize-handle.handle-value
     2872           .
     2873           if v-object-handle <> v-diasize-resize-button
     2874           then do:
     2875             assign
     2876               v-object-handle :col = v-object-handle :col + p-change-value
     2877               no-error .
     2878             if error-status :error
     2879             or error-status :get-message(1) <> ""
     2880             then do:
     2881               undo move_block, retry move_block .
     2882             end.
     2883           end.
     2884         end.
     2885         for each buf_temp-browse-handle
     2886           where buf_temp-browse-handle.browse-type = 'width':u
     2887         on error undo move_block, retry move_block
     2888         :
     2889           assign
     2890             buf_temp-browse-handle.browse-handle :width
     2891               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2892             no-error .
     2893           if error-status :error
     2894           or error-status :get-message(1) <> ""
     2895           then do:
     2896             undo move_block, retry move_block .
     2897           end.
     2898         end.
     2899         assign
     2900           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2901           no-error .
     2902         if error-status :error
     2903         or error-status :get-message(1) <> ""
     2904         then do:
     2905           undo move_block, retry move_block.
     2906         end.
     2907         assign
     2908           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2909         no-error .
     2910         if error-status :error
     2911         or error-status :get-message(1) <> ""
     2912         then do:
     2913           undo move_block, retry move_block.
     2914         end.
     2915         if frame Dialog-Frame :scrollable = true
     2916         then do:
     2917           assign
     2918             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2919           no-error .
     2920           if error-status :error
     2921           or error-status :get-message(1) <> ""
     2922           then do:
     2923             undo move_block, retry move_block.
     2924           end.
     2925         end.
     2926       end.
     2927       if p-move-resize
     2928       then do:
     2929         run diasize_position-resize-button in this-procedure .
     2930       end.
     2931       if v-diasize-wndstore = true
     2932       then do:
     2933         if connected("ub") = true
     2934         then do:
     2935           define variable v-cntxt-db-num        as integer   no-undo .
     2936           define variable v-cntxt-userid        as character no-undo .
     2937           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2938                                             , OUTPUT v-cntxt-userid
     2939                                             ) .
     2940           run gbl/wndsizew.p
     2941             (input  v-cntxt-db-num
     2942             ,input  v-cntxt-userid
     2943             ,input  v-diasize-proc-name
     2944             ,input  'width':u
     2945             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2946             ) .
     2947         end.
     2948       end.
     2949     end.
     2950     assign
     2951       v-diasize-change-size = false
     2952     .
     2953   end procedure.
     2954   procedure diasize_set-width :
     2955     define input  parameter p-new-width  as decimal   no-undo .
     2956     define input  parameter p-move-resize as logical   no-undo .
     2957     do
     2958     on error undo, return error return-value
     2959     :
     2960       run diasize_change-width in this-procedure
     2961         (input  (p-new-width - frame Dialog-Frame :width)
     2962         ,input  p-move-resize
     2963         ) .
     2964     end.
     2965   end procedure.
     2966   procedure diasize_position-resize-button :
     2967     do with frame Dialog-Frame
     2968     :
     2969       hide v-diasize-resize-button .
     2970       assign
     2971         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2972                     - 1
     2973                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2974         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2975                     - 1
     2976                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2977       .
     2978       view v-diasize-resize-button .
     2979     end.
     2980   end procedure.
     2981   on alt-right anywhere
     2982   do:
     2983     run diasize_change-width in this-procedure
     2984       (input 1
     2985       ,input true
     2986       ) .
     2987     return no-apply .
     2988   end.
     2989   on alt-left anywhere
     2990   do:
     2991     run diasize_change-width in this-procedure
     2992       (input -1
     2993       ,input true
     2994       ) .
     2995     return no-apply .
     2996   end.
     2997   on alt-down anywhere
     2998   do:
     2999     run diasize_change-height in this-procedure
     3000       (input 1
     3001       ,input true
     3002       ) .
     3003     return no-apply .
     3004   end.
     3005   on alt-up anywhere
     3006   do:
     3007     run diasize_change-height in this-procedure
     3008       (input -1
     3009       ,input true
     3010       ) .
     3011     return no-apply .
     3012   end.
     3013   on alt-enter of frame Dialog-Frame
     3014   do:
     3015     run diasize_maximize in this-procedure
     3016       (input  ?
     3017       ).
     3018     return no-apply .
     3019   end.
     3020   procedure diasize_end-move :
     3021     do
     3022     on error undo, return error return-value
     3023     :
     3024       define variable v-row-delta as decimal   no-undo .
     3025       define variable v-col-delta as decimal   no-undo .
     3026       define variable v-new-row as decimal   no-undo .
     3027       define variable v-new-col as decimal   no-undo .
     3028       assign
     3029         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     3030         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     3031       .
     3032       assign
     3033         v-row-delta = v-new-row - frame Dialog-Frame :height
     3034         v-col-delta = v-new-col - frame Dialog-Frame :width
     3035       .
     3036       run diasize_change-height in this-procedure
     3037         (input v-row-delta
     3038         ,input true
     3039         ) .
     3040       run diasize_change-width in this-procedure
     3041         (input v-col-delta
     3042         ,input true
     3043         ) .
     3044     end.
     3045   end procedure.
     3046   procedure diasize_maximize :
     3047     define input  parameter p-action as logical   no-undo .
     3048     do
     3049     on error undo, return error return-value
     3050     :
     3051       if p-action = ?
     3052       then do:
     3053         if v-diasize-need-maximize = true
     3054         then do:
     3055           assign
     3056             p-action = true
     3057           .
     3058         end.
     3059         else do:
     3060           assign
     3061             p-action = false
     3062           .
     3063         end.
     3064       end.
     3065       if p-action = true
     3066       then do:
     3067         run diasize_change-height in this-procedure
     3068           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     3069               - frame Dialog-Frame :height-chars
     3070           ,input true
     3071           ) .
     3072         run diasize_change-width in this-procedure
     3073           (input session :width-chars
     3074               - frame Dialog-Frame :width-chars
     3075           ,input true
     3076           ) .
     3077         assign
     3078           v-diasize-need-maximize = false
     3079         .
     3080       end.
     3081       else do:
     3082         run diasize_change-width in this-procedure
     3083           (input v-diasize-orig-frame-width
     3084               - frame Dialog-Frame :width-chars
     3085           ,input true
     3086           ) .
     3087         run diasize_change-height in this-procedure
     3088           (input v-diasize-orig-frame-height
     3089               - frame Dialog-Frame :height-chars
     3090           ,input true
     3091           ) .
     3092         assign
     3093           v-diasize-need-maximize = true
     3094         .
     3095       end.
     3096     end.
     3097   end procedure.
     3098   procedure diasize_restore-orig-size :
     3099     do
     3100     on error undo, return error return-value
     3101     :
     3102       assign
     3103         v-diasize-current-frame-width  = frame Dialog-Frame :width
     3104         v-diasize-current-frame-height = frame Dialog-Frame :height
     3105       .
     3106       run diasize_set-height in this-procedure
     3107         (input  v-diasize-orig-frame-height
     3108         ,input  true
     3109         ) .
     3110       run diasize_set-width in this-procedure
     3111         (input  v-diasize-orig-frame-width
     3112         ,input  true
     3113         ) .
     3114     end.
     3115   end procedure.
     3116   procedure diasize_restore-current-size :
     3117     do
     3118     on error undo, return error return-value
     3119     :
     3120       run diasize_set-height in this-procedure
     3121         (input  v-diasize-current-frame-height
     3122         ,input  true
     3123         ) .
     3124       run diasize_set-width in this-procedure
     3125         (input  v-diasize-current-frame-width
     3126         ,input  true
     3127         ) .
     3128     end.
     3129   end procedure.
     3130   procedure diasize_set-browse-handle :
     3131     define input  parameter p-browse-handle as handle   no-undo .
     3132     define buffer buf_temp-browse-handle for temp-browse-handle .
     3133     do
     3134     on error undo, return error return-value
     3135     :
     3136       assign
     3137         v-diasize-browse-handle = p-browse-handle
     3138       .
     3139       for each buf_temp-browse-handle
     3140       on error undo, return error return-value
     3141       :
     3142         delete buf_temp-browse-handle .
     3143       end.
     3144     end.
     3145   end procedure.
     3146   procedure diasize_add_browse :
     3147     define input  parameter p-browse-type   as character no-undo .
     3148     define input  parameter p-browse-handle as handle    no-undo .
     3149     define buffer buf_temp-browse-handle for temp-browse-handle .
     3150     do
     3151     on error undo, return error return-value
     3152     :
     3153       assign
     3154         v-diasize-browse-number = v-diasize-browse-number + 1
     3155       .
     3156       create buf_temp-browse-handle .
     3157       assign
     3158         buf_temp-browse-handle.browse-type   = p-browse-type
     3159         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     3160         buf_temp-browse-handle.browse-handle = p-browse-handle
     3161       .
     3162     end.
     3163   end procedure.
     3164   procedure diasize_init :
     3165     define variable v-default-value    as logical   no-undo .
     3166     define variable v-restore-saved    as logical   no-undo .
     3167     define variable v-resize-value-str as character no-undo .
     3168     do
     3169     on error undo, return error return-value
     3170     :
     3171       do with frame Dialog-Frame
     3172       :
     3173         assign
     3174           v-diasize-orig-frame-height = frame Dialog-Frame :height
     3175           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     3176           v-diasize-browse-handle     = browse br-ef1 :handle
     3177         .
     3178         create button v-diasize-resize-button
     3179         assign
     3180           parent        = frame Dialog-Frame :first-child
     3181           label         = "s"
     3182           height-pixels = 16
     3183           width-pixels  = 16
     3184           visible       = true
     3185           sensitive     = true
     3186           movable       = true
     3187           triggers:
     3188             on end-move persistent run diasize_end-move in this-procedure .
     3189           end triggers.
     3190         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     3191         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     3192         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     3193         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     3194         assign
     3195           v-diasize-wndmax = false
     3196         .
     3197         if connected("ub") = true
     3198         then do:
     3199           define variable v-cntxt-db-num        as integer   no-undo .
     3200           define variable v-cntxt-userid        as character no-undo .
     3201           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3202                                             , OUTPUT v-cntxt-userid
     3203                                             ) .
     3204           run gbl/wndpar_r.p
     3205             (input  v-cntxt-db-num
     3206             ,input  v-cntxt-userid
     3207             ,input  'wndmax':U
     3208             ,output v-diasize-wndmax
     3209             ,output v-default-value
     3210             ) .
     3211         end.
     3212         assign
     3213           v-diasize-wndstore = false
     3214         .
     3215         if connected("ub") = true
     3216         then do:
     3217           run gbl/wndpar_r.p
     3218             (input  v-cntxt-db-num
     3219             ,input  v-cntxt-userid
     3220             ,input  'wndstore':U
     3221             ,output v-diasize-wndstore
     3222             ,output v-default-value
     3223             ) .
     3224         end.
     3225         assign
     3226           v-diasize-proc-name = entry(1, program-name(2), '.')
     3227         .
     3228         if v-diasize-wndstore = true
     3229         then do:
     3230           assign
     3231             v-restore-saved = false
     3232           .
     3233           if connected("ub") = true
     3234           then do:
     3235             run gbl/wndsizer.p
     3236               (input  v-cntxt-db-num
     3237               ,input  v-cntxt-userid
     3238               ,input  v-diasize-proc-name
     3239               ,input  'height':u
     3240               ,output v-resize-value-str
     3241               ) .
     3242             if v-resize-value-str <> '':U
     3243             then do:
     3244               run diasize_change-height in this-procedure
     3245                 (input  integer(v-resize-value-str)
     3246                 ,input  true
     3247                 ) .
     3248               assign
     3249                 v-restore-saved = true
     3250               .
     3251             end.
     3252           end.
     3253           if connected("ub") = true
     3254           then do:
     3255             run gbl/wndsizer.p
     3256               (input  v-cntxt-db-num
     3257               ,input  v-cntxt-userid
     3258               ,input  v-diasize-proc-name
     3259               ,input  'width':u
     3260               ,output v-resize-value-str
     3261               ) .
     3262             if v-resize-value-str <> '':U
     3263             then do:
     3264               run diasize_change-width in this-procedure
     3265                 (input  integer(v-resize-value-str)
     3266                 ,input  true
     3267                 ) .
     3268               assign
     3269                 v-restore-saved = true
     3270               .
     3271             end.
     3272           end.
     3273           if v-restore-saved <> true
     3274           then do:
     3275             if v-diasize-wndmax = true
     3276             then do:
     3277               run diasize_maximize in this-procedure
     3278                 (input  true
     3279                 ) .
     3280             end.
     3281           end.
     3282         end.
     3283         else do:
     3284           if v-diasize-wndmax = true
     3285           then do:
     3286             run diasize_maximize in this-procedure
     3287               (input  true
     3288               ) .
     3289           end.
     3290         end.
     3291       end.
     3292     end.
     3293   end procedure.
     3294   procedure diasize_need-full-display :
     3295     define output parameter p-need-full-display as logical   no-undo .
     3296     do
     3297     on error undo, return error return-value
     3298     :
     3299       assign
     3300         p-need-full-display = v-diasize-need-full-display
     3301       .
     3302       assign
     3303         v-diasize-need-full-display = false
     3304       .
     3305     end.
     3306   end procedure.
     3307   procedure get-context :
     3308      define output parameter p-db-num as integer          no-undo.
     3309      define output parameter p-user-id as character        no-undo.
     3310      define variable v-login               as character    no-undo.
     3311      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     3312      define buffer buf_user-login  for ub.user-login .
     3313      do
     3314      on error undo, return error
     3315      :
     3316            FIND FIRST buf_sys-ctrl no-lock.
     3317            ASSIGN
     3318               v-login = USERID("ub")
     3319               p-db-num = buf_sys-ctrl.db-num
     3320            .
     3321            FIND FIRST buf_user-login
     3322                 WHERE buf_user-login.db-num = p-db-num
     3323                   AND buf_user-login.user-login = v-login
     3324                 no-lock
     3325                 no-error
     3326                 .
     3327            IF AVAILABLE buf_user-login
     3328            THEN DO:
     3329               assign
     3330                  p-user-id = buf_user-login.user-id
     3331               .
     3332            END.
     3333      end.
     3334   end procedure.
     3335       run diasize_init in this-procedure .
     3336   MAIN-BLOCK:
     3337   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     3338      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     3339   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3340     run mainmenu_getcntxt in parparentproc
     3341       (output v-cntxt-db-num
     3342       ,output v-cntxt-userid
     3343       ,output v-cntxt-level
     3344       ,output v-cntxt-host-code-obj
     3345       ,output v-cntxt-obj-type
     3346       ,output v-cntxt-obj-code
     3347       ,output v-cntxt-db-num-obj
     3348       ,output v-cntxt-is-admin
     3349       ) .
     3350       FIND FIRST buf_Dis-card-type NO-LOCK WHERE
     3351             buf_dis-card-type.emitent-host-code = p-emitent-host-code
     3352         AND   buf_dis-card-type.TYPE = p-type
     3353       AND buf_dis-card-type.host-code = 0
     3354       AND buf_Dis-card-type.obj-type = '':U
     3355       AND buf_Dis-card-type.obj-code = 0 NO-ERROR.
     3356       IF NOT AVAILABLE buf_dis-card-type THEN DO:
     3357         MESSAGE
     3358         "Не определен тип ДК" SKIP
     3359           "Невозможно задать свойство"
     3360           VIEW-AS ALERT-BOX ERROR.
     3361         UNDO, RETURN ERROR.
     3362       END.
     3363       IF NOT (buf_Dis-card-type.card-media = integer('5':U)) THEN DO:
     3364         MESSAGE
     3365         "Данное свойство можно задать ТОЛЬКО для карты типа EASY-FUEL"
     3366         VIEW-AS ALERT-BOX ERROR.
     3367       UNDO, RETURN ERROR.
     3368     END.
     3369    FOR EACH temp-ef1:
     3370       DELETE temp-ef1.
     3371     END.
     3372     FOR EACH temp-ef2:
     3373       DELETE temp-ef2.
     3374     END.
     3375     IF p-mode <> 'ДОБАВЛЕНИЕ':U
     3376     AND p-mode <> 'ИЗМЕНЕНИЕ':U
     3377     AND p-mode <> 'ПРОСМОТР':U
     3378     and p-mode <> 'ПРОСМОТР':U + chr(44) + "init"
     3379     THEN DO:
     3380       MESSAGE
     3381       substitute("Неверное значение параметра p-mode=&1", p-mode)
     3382       VIEW-AS ALERT-BOX ERROR.
     3383       UNDO, RETURN ERROR.
     3384     END.
     3385     assign
     3386     v-init-mode = (if num-entries(p-mode) > 1
     3387                    and entry(2, p-mode) = "init"
     3388                    then yes
     3389                    else no)
     3390     p-mode = entry(1, p-mode)
     3391     .
     3392   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     3393     (input  'is-ef'
     3394     ,input  ''
     3395     ,input  ''
     3396     ,input  0
     3397     ,input  ''
     3398     ,input  ''
     3399     ,input  ''
     3400     ,input  no
     3401     ,output is-ef-chr
     3402     ,output par-type
     3403     ) no-error .
     3404     if error-status:error
     3405     or logical(is-ef-chr) = no then do:
     3406       message
     3407       "В Вашей конфигурации нельзя работать с этим свойством ДК," skip
     3408       "так как не включен конфигурационный параметр is-ef"
     3409       view-as alert-box .
     3410       undo, return error .
     3411     end.
     3412     find first buf_prop-head no-lock where
     3413               buf_prop-head.dtm-code = p-dtm-code.
     3414     find first buf_prop-ref no-lock where
     3415             buf_prop-ref.dtm-code = p-dtm-code
     3416         and buf_prop-ref.dt-code = p-dt-code.
     3417     case p-dtm-code:
     3418       when 25 then do:
     3419       end.
     3420       when 24 then do:
     3421       end.
     3422     end case.
     3423     FIND FIRST X_dis-card NO-LOCK WHERE
     3424               X_dis-card.d-card = p-d-card NO-ERROR.
     3425     IF AVAILABLE X_dis-card THEN DO:
     3426         FIND FIRST X_clients NO-LOCK WHERE
     3427                   X_clients.obj-type = X_dis-card.cli-type
     3428              AND X_clients.obj-code = X_dis-card.cli-code NO-ERROR.
     3429     END.
     3430     RUN Myenable IN THIS-PROCEDURE.
     3431     WAIT-FOR GO OF FRAME Dialog-Frame.
     3432   END.
     3433   RUN disable_UI.
     3434   PROCEDURE disable_UI :
     3435     HIDE FRAME Dialog-Frame.
     3436   END PROCEDURE.
     3437   PROCEDURE enable_UI :
     3438     DISPLAY f-car-brand f-access-key f-car-reg-number rs-ef-format
     3439             f-init-date-time f-issued-by-name f-init-operator-name l-ef-format
     3440         WITH FRAME Dialog-Frame.
     3441     ENABLE B-exit b-quit b-card b-cli b-initialize B-Help f-car-brand
     3442            f-access-key f-car-reg-number rs-ef-format f-init-date-time
     3443            b-add-limits b-del-limits br-ef1 l-ef-format
     3444         WITH FRAME Dialog-Frame.
     3445     VIEW FRAME Dialog-Frame.
     3446     OPEN QUERY br-ef1 FOR EACH temp-ef1 BY temp-ef1.petrol-code.
     3447   END PROCEDURE.
     3448   PROCEDURE generate-access-key :
     3449   DEFINE output PARAMETER p-access-key AS CHARACTER NO-UNDO.
     3450   SECURITY-POLICY:SYMMETRIC-ENCRYPTION-KEY = GENERATE-PBE-KEY("sysadm").
     3451   define variable vss-include-info19 as character format "X(65)" no-undo
     3452   initial "@(#)$Workfile$ $Revision$".
     3453     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pencrypt in g#library2
     3454     (input  p-d-card
     3455     ,output p-access-key
     3456     )  .
     3457   END PROCEDURE.
     3458   PROCEDURE MyEnable :
     3459   define variable v-h as handle no-undo.
     3460   define buffer buf_dis-card for ub.dis-card.
     3461   define buffer buf_temp-ef for temp-ef.
     3462   find first buf_Dis-card no-lock where
     3463             buf_Dis-card.d-card = p-d-card no-error.
     3464   run fill-main-table in this-procedure ( input p-d-card, buffer buf_dis-card) no-error.
     3465   if error-status:error then do:
     3466     undo, return error .
     3467   end.
     3468   find first buf_temp-ef.
     3469   assign
     3470   f-car-reg-number = buf_temp-ef.car-reg-number
     3471   f-car-brand = buf_temp-ef.car-brand
     3472   rs-ef-format = buf_temp-ef.ef-format
     3473   f-access-key = buf_temp-ef.access-key
     3474   v-petrol-code[1]= buf_temp-ef.petrol-code-1
     3475   v-petrol-code[2]= buf_temp-ef.petrol-code-2
     3476   v-petrol-code[3]= buf_temp-ef.petrol-code-3
     3477   v-petrol-code[4]= buf_temp-ef.petrol-code-4
     3478   f-init-date-time =  buf_temp-ef.init-date-time
     3479   f-init-operator-name = usrfulnf(buf_temp-ef.init-operator)
     3480   f-issued-by-name = usrfulnf(buf_temp-ef.issued-by)
     3481   .
     3482   IF f-access-key = ""
     3483   OR trim(f-access-key, "*") = ""
     3484      THEN DO:
     3485    RUN  generate-access-key IN THIS-PROCEDURE ( OUTPUT f-access-key) NO-ERROR.
     3486    IF ERROR-STATUS:ERROR THEN DO:
     3487        MESSAGE
     3488        "Ошибка при генерации кода доступа"
     3489        VIEW-AS ALERT-BOX ERROR.
     3490        RUN undo-proc IN THIS-PROCEDURE .
     3491        UNDO, RETURN ERROR.
     3492    END.
     3493   END.
     3494   ASSIGN
     3495   v-h = br-ef1:FIRST-COLUMN IN FRAME Dialog-Frame
     3496   .
     3497   DO while valid-handle(v-h) :
     3498     if v-h:LABEL = "Название!топлива" then do:
     3499       v-h:RESIZABLE = YES.
     3500       leave.
     3501     end.
     3502     ELSE DO:
     3503       v-h = v-h:NEXT-COLUMN.
     3504     END.
     3505   END.
     3506   IF p-mode = 'ДОБАВЛЕНИЕ':U THEN DO:
     3507   END.
     3508   DISPLAY
     3509   f-car-brand
     3510   f-car-reg-number
     3511   rs-ef-format
     3512   l-ef-format
     3513   f-access-key
     3514   f-init-date-time
     3515   f-init-operator-name
     3516   f-issued-by-name
     3517   WITH FRAME Dialog-Frame.
     3518   IF p-mode = 'ПРОСМОТР':U THEN DO:
     3519       ASSIGN
     3520       temp-ef1.petrol-num:READ-ONLY in BROWSE br-ef1 = YES
     3521       temp-ef1.month-limit:READ-ONLY in BROWSE br-ef1 = YES
     3522       temp-ef1.day-limit:READ-ONLY in BROWSE br-ef1 = YES
     3523       temp-ef1.unlim-common-limit:READ-ONLY in BROWSE br-ef1 = YES
     3524       temp-ef1.unlim-month-limit:READ-ONLY in BROWSE br-ef1 = YES
     3525       temp-ef1.unlim-day-limit:READ-ONLY in BROWSE br-ef1 = YES
     3526       temp-ef1.standard-dose:READ-ONLY in BROWSE br-ef1 = YES
     3527       temp-ef1.common-limit:READ-ONLY in BROWSE br-ef1 = YES
     3528       .
     3529   END.
     3530   if p-dtm-code = 24 then do:
     3531     temp-ef1.petrol-num:READ-ONLY in BROWSE br-ef1 = YES.
     3532   end.
     3533   ENABLE
     3534   B-exit WHEN p-mode <> 'ПРОСМОТР':U
     3535   b-quit
     3536   B-Help
     3537   f-car-reg-number WHEN (p-mode <> 'ПРОСМОТР':U and p-dtm-code = 25)
     3538   f-car-brand WHEN (p-mode <> 'ПРОСМОТР':U and p-dtm-code = 25)
     3539   b-add-limits WHEN p-mode <> 'ПРОСМОТР':U
     3540   b-del-limits WHEN p-mode <> 'ПРОСМОТР':U
     3541   br-ef1
     3542   b-initialize WHEN (v-init-mode and p-dtm-code = 25)
     3543   b-card WHEN AVAILABLE X_dis-card
     3544   b-cli WHEN AVAILABLE X_dis-card
     3545   WITH FRAME Dialog-Frame.
     3546   VIEW FRAME Dialog-Frame.
     3547   IF p-mode = 'ПРОСМОТР':U  THEN DO:
     3548     ASSIGN
     3549     b-quit:LABEL = "&Выход"
     3550     b-quit:COLUMN = 1
     3551     .
     3552     HIDE
     3553     b-exit
     3554     IN FRAME Dialog-Frame.
     3555   END.
     3556   CASE rs-ef-format:
     3557     WHEN 1  THEN DO:
     3558        OPEN QUERY br-ef1 FOR EACH temp-ef1 BY temp-ef1.petrol-code.
     3559       define buffer buf_temp-ef1 for temp-ef1 .
     3560       if p-dtm-code = 24 then do:
     3561         find first buf_temp-ef1 where
     3562                   buf_temp-ef1.d-card = p-d-card
     3563               and buf_temp-ef1.dt-code = p-dt-code.
     3564         reposition br-ef1 to recid recid(buf_temp-ef1) no-error.
     3565         apply "ENTRY" to br-ef1.
     3566         case p-node-code:
     3567           when 1 then do:
     3568             apply "ENTRY" to temp-ef1.month-limit in browse br-ef1.
     3569           end.
     3570           when 2 then do:
     3571             apply "ENTRY" to temp-ef1.day-limit in browse br-ef1.
     3572           end.
     3573           when 3 then do:
     3574             apply "ENTRY" to temp-ef1.standard-dose in browse br-ef1.
     3575           end.
     3576           when 4 then do:
     3577             apply "ENTRY" to temp-ef1.common-limit in browse br-ef1.
     3578           end.
     3579           otherwise do:
     3580             apply "ENTRY" to br-ef1.
     3581           end.
     3582         end case.
     3583       end.
     3584       apply "value-changed" to temp-ef1.unlim-day-limit in browse br-ef1.
     3585       apply "value-changed" to temp-ef1.unlim-month-limit in browse br-ef1.
     3586       apply "value-changed" to temp-ef1.unlim-common-limit in browse br-ef1.
     3587     END.
     3588   END CASE.
     3589   ASSIGN
     3590   FRAME Dialog-Frame:TITLE = SUBSTITUTE("&1 для &2 ",  FRAME Dialog-Frame:TITLE, p-d-card).
     3591   END PROCEDURE.
     3592   PROCEDURE proc-save :
     3593   DEFINE BUFFER buf_prop-map FOR ub.prop-map.
     3594   DEFINE BUFFER bufl_prop-head FOR ub.prop-head.
     3595   DEFINE BUFFER buf_temp-ef1 FOR temp-ef1.
     3596   DEFINE BUFFER buf_temp-dis-card-property FOR temp-dis-card-property.
     3597   if p-dtm-code = 25 then do:
     3598     ASSIGN
     3599     FRAME Dialog-Frame
     3600     f-car-brand
     3601     f-car-reg-number
     3602     rs-ef-format
     3603     .
     3604   end.
     3605   FOR EACH buf_temp-ef1:
     3606     FOR FIRST bufl_prop-head no-lock WHERE
     3607               bufl_prop-head.dtm-code = 24,
     3608           EACH buf_prop-map NO-LOCK WHERE
     3609               buf_prop-map.dtm-code = bufl_prop-head.dtm-code
     3610            and buf_prop-map.node-code > 0:
     3611      IF buf_temp-ef1.month-limit = 0
     3612      OR buf_temp-ef1.day-limit = 0
     3613      OR buf_temp-ef1.standard-dose = 0
     3614      or buf_temp-ef1.common-limit = 0
     3615      THEN DO:
     3616        MESSAGE
     3617        substitute("Не заполнены лимиты для топлива с кодом &1", buf_temp-ef1.petrol-code)
     3618        VIEW-AS ALERT-BOX ERROR.
     3619        UNDO, RETURN ERROR.
     3620      END.
     3621      if buf_temp-ef1.petrol-num > 0 then do:
     3622        if get-ef-petrol-code(buf_temp-ef1.petrol-code) = 0 then do:
     3623         MESSAGE
     3624         substitute("Неопределен код топлива EASYFUEL для кода топлива IBS TH &1", buf_temp-ef1.petrol-code)
     3625         VIEW-AS ALERT-BOX ERROR.
     3626         UNDO, RETURN ERROR.
     3627        end.
     3628      end.
     3629     end.
     3630   end.
     3631   FOR EACH buf_temp-ef1:
     3632       FOR FIRST bufl_prop-head no-lock WHERE
     3633               bufl_prop-head.dtm-code = 24,
     3634           EACH buf_prop-map NO-LOCK WHERE
     3635               buf_prop-map.dtm-code = bufl_prop-head.dtm-code
     3636            and buf_prop-map.node-code > 0:
     3637      FIND FIRST buf_temp-dis-card-property WHERE
     3638               buf_temp-dis-card-property.d-card =  p-d-card
     3639          AND buf_temp-dis-card-property.dt-code = buf_temp-ef1.dt-code
     3640          AND buf_temp-dis-card-property.host-code = p-host-code
     3641          AND buf_temp-dis-card-property.obj-type = p-obj-type
     3642          AND buf_temp-dis-card-property.obj-code = p-obj-code
     3643          AND buf_temp-dis-card-property.obj-code = p-obj-code
     3644          AND buf_temp-dis-card-property.node-code = buf_prop-map.node-code NO-ERROR.
     3645      IF NOT AVAILABLE buf_temp-dis-card-property THEN DO:
     3646         CREATE buf_temp-dis-card-property.
     3647         ASSIGN
     3648         buf_temp-dis-card-property.d-card =  p-d-card
     3649         buf_temp-dis-card-property.dt-code = buf_temp-ef1.dt-code
     3650         buf_temp-dis-card-property.dtm-code = buf_temp-ef1.dtm-code
     3651         buf_temp-dis-card-property.sum-id = buf_temp-ef1.sum-id
     3652         buf_temp-dis-card-property.host-code = p-host-code
     3653         buf_temp-dis-card-property.obj-type = p-obj-type
     3654         buf_temp-dis-card-property.obj-code = p-obj-code
     3655         buf_temp-dis-card-property.obj-code = p-obj-code
     3656         buf_temp-dis-card-property.node-code = buf_prop-map.node-code
     3657         buf_temp-dis-card-property.node-label = buf_prop-map.node-label
     3658         buf_temp-dis-card-property.prop-label = bufl_prop-head.prop-label
     3659         buf_temp-dis-card-property.data-type = entry(1, buf_prop-map.node-value-type)
     3660         .
     3661      END.
     3662      IF VALID-HANDLE(BUFFER buf_temp-dis-card-property:BUFFER-FIELD(SUBSTITUTE("property-value-&1", entry(1, buf_prop-map.node-value-type))))
     3663      AND VALID-HANDLE(BUFFER buf_temp-ef1:BUFFER-FIELD(buf_prop-map.node-name)) THEN DO:
     3664          ASSIGN
     3665          BUFFER buf_temp-dis-card-property:BUFFER-FIELD(SUBSTITUTE("property-value-&1", entry(1, buf_prop-map.node-value-type))):BUFFER-VALUE =
     3666          BUFFER buf_temp-ef1:BUFFER-FIELD(buf_prop-map.node-name):BUFFER-VALUE.
     3667      END.
     3668      ELSE DO:
     3669          MESSAGE
     3670          SUBSTITUTE("Не могу сохранить поле temp-ef1.&1 в поле temp-dis-card-property.&1"
     3671                     ,buf_prop-map.node-label)
     3672          VIEW-AS ALERT-BOX ERROR.
     3673          UNDO, RETURN ERROR.
     3674      END.
     3675       END.
     3676   END.
     3677   if p-dtm-code = 25 then do:
     3678     FOR EACH buf_prop-map NO-LOCK WHERE
     3679             buf_prop-map.dtm-code = p-dtm-code
     3680         and buf_prop-map.node-code > 0:
     3681       FIND FIRST temp-dis-card-property WHERE
     3682                 temp-dis-card-property.d-card = p-d-card
     3683           AND   temp-dis-card-property.dt-code = p-dt-code
     3684           AND   temp-dis-card-property.node-code = buf_prop-map.node-code
     3685           AND   temp-dis-card-property.host-code = p-host-code
     3686           AND   temp-dis-card-property.obj-type = p-obj-type
     3687           AND   temp-dis-card-property.obj-code = p-obj-code NO-ERROR.
     3688       IF NOT AVAILABLE temp-dis-card-property THEN DO:
     3689         CREATE temp-dis-card-property.
     3690         ASSIGN
     3691         temp-dis-card-property.d-card = p-d-card
     3692         temp-dis-card-property.dt-code = p-dt-code
     3693         temp-dis-card-property.dtm-code = p-dtm-code
     3694         temp-dis-card-property.sum-id = p-sum-id
     3695         temp-dis-card-property.node-code = buf_prop-map.node-code
     3696         temp-dis-card-property.host-code = p-host-code
     3697         temp-dis-card-property.obj-type = p-obj-type
     3698         temp-dis-card-property.obj-code = p-obj-code
     3699         temp-dis-card-property.prop-label = buf_prop-head.prop-label
     3700         temp-dis-card-property.node-label = buf_prop-map.node-label
     3701         temp-dis-card-property.data-type = entry(1, buf_prop-map.node-value-type)
     3702         .
     3703       END.
     3704     END.
     3705     FOR EACH temp-dis-card-property
     3706       where temp-dis-card-property.d-card = p-d-card
     3707     and temp-dis-card-property.dtm-code = p-dtm-code
     3708     and temp-dis-card-property.dt-code = p-dt-code
     3709       :
     3710       CASE temp-dis-card-property.node-code:
     3711         WHEN 1 THEN DO:
     3712           temp-dis-card-property.property-value-character = f-car-reg-number.
     3713         END.
     3714         WHEN 2 THEN DO:
     3715           temp-dis-card-property.property-value-character = f-car-brand.
     3716         END.
     3717         WHEN 3 THEN DO:
     3718           temp-dis-card-property.property-value-integer = rs-ef-format.
     3719         END.
     3720         WHEN 4 THEN DO:
     3721           temp-dis-card-property.property-value-character = f-access-key.
     3722         END.
     3723         WHEN 11 THEN DO:
     3724         END.
     3725         WHEN 13 THEN DO:
     3726           temp-dis-card-property.property-value-character = v-cntxt-userid.
     3727         END.
     3728         WHEN 5 THEN DO:
     3729           FIND FIRST buf_temp-ef1 NO-LOCK WHERE
     3730                         buf_temp-ef1.d-card = p-d-card
     3731                     and buf_temp-ef1.petrol-num = 1 NO-ERROR.
     3732           IF AVAILABLE buf_temp-ef1 THEN DO:
     3733             temp-dis-card-property.property-value-integer = buf_temp-ef1.petrol-code.
     3734           END.
     3735         END.
     3736       WHEN 6 THEN DO:
     3737         FIND FIRST buf_temp-ef1 NO-LOCK WHERE
     3738                       buf_temp-ef1.d-card = p-d-card
     3739                   and buf_temp-ef1.petrol-num = 2 NO-ERROR.
     3740         IF AVAILABLE buf_temp-ef1 THEN DO:
     3741           temp-dis-card-property.property-value-integer = buf_temp-ef1.petrol-code.
     3742         END.
     3743       END.
     3744       WHEN 7 THEN DO:
     3745         FIND FIRST buf_temp-ef1 NO-LOCK WHERE
     3746                     buf_temp-ef1.d-card = p-d-card
     3747                  and  buf_temp-ef1.petrol-num = 3 NO-ERROR.
     3748         IF AVAILABLE buf_temp-ef1 THEN DO:
     3749           temp-dis-card-property.property-value-integer = buf_temp-ef1.petrol-code.
     3750         END.
     3751       END.
     3752       WHEN 8 THEN DO:
     3753         FIND FIRST buf_temp-ef1 NO-LOCK WHERE
     3754                   buf_temp-ef1.d-card = p-d-card
     3755                  and buf_temp-ef1.petrol-num = 4 NO-ERROR.
     3756         IF AVAILABLE buf_temp-ef1 THEN DO:
     3757           temp-dis-card-property.property-value-integer = buf_temp-ef1.petrol-code.
     3758         END.
     3759       END.
     3760       END CASE.
     3761     END.
     3762   end.
     3763   ASSIGN
     3764   p-setted = YES
     3765   .
     3766   END PROCEDURE.
     3767   PROCEDURE undo-proc :
     3768   DEFINE BUFFER buf_temp-ef1 FOR temp-ef1.
     3769   DEFINE BUFFER buf_temp-dis-card-property FOR temp-dis-card-property.
     3770   FOR EACH buf_temp-ef1 WHERE
     3771          buf_temp-ef1.d-card = p-d-card
     3772       and buf_temp-ef1.NEW_ = YES,
     3773       EACH buf_temp-dis-card-property WHERE
     3774           buf_temp-dis-card-property.dt-code = buf_temp-ef1.dt-code:
     3775      DELETE buf_temp-dis-card-property.
     3776   END.
     3777   END PROCEDURE.
     3778   FUNCTION get-gds-name RETURNS CHARACTER
     3779     ( INPUT p-gds-code AS INTEGER ) :
     3780   DEFINE buffer buf_goods FOR ub.goods.
     3781   FIND FIRST buf_goods NO-LOCK WHERE
     3782               buf_goods.gds-code = p-gds-code NO-ERROR.
     3783   IF AVAILABLE buf_goods THEN do:
     3784     IF buf_goods.chk-name <> '' THEN RETURN buf_goods.chk-name.
     3785     RETURN buf_goods.gds-name.
     3786   END.
     3787   RETURN "!!НЕИЗВЕСТНЫЙ ТОВАР".
     3788   END FUNCTION.
