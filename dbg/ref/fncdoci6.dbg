     1141   procedure proc-color-widgets :
     1142   define input parameter p-list as character no-undo .
     1143   define input parameter p-fg as logical no-undo .
     1144   define input parameter p-bg as logical no-undo .
     1145   define input parameter p-fgc as integer no-undo .
     1146   define input parameter p-bgc as integer no-undo .
     1147   define variable ii as integer no-undo .
     1148   define variable fh as widget-handle no-undo .
     1149   define variable hh as widget-handle no-undo .
     1150     do
     1151     on error undo, return error
     1152     :
     1153       assign
     1154       fh = frame Dialog-Frame:first-child
     1155       hh = fh:first-child
     1156       .
     1157       do while valid-handle(hh):
     1158         if LOOKUP(hh:name, p-list) > 0  then do:
     1159           assign
     1160           hh:fgcolor = (if p-fg then p-fgc else hh:fgcolor)
     1161           hh:bgcolor = (if p-bg then p-bgc else hh:bgcolor)
     1162           .
     1163         end.
     1164         hh = hh:next-sibling.
     1165       end.
     1166     end.
     1167   end procedure.
