     1503   f-contract-type
     1504   f-contract-curr-abbr
     1505   tt-c-fin-doc.contract-curr
     1506   b-payer-view
     1507   tt-c-fin-doc.payer-type
     1508   tt-c-fin-doc.payer-code
     1509   tt-c-fin-doc.payer-okpo
     1510   tt-c-fin-doc.payer-name
     1511   tt-c-fin-doc.str-podr-type
     1512   tt-c-fin-doc.str-podr-code
     1513   tt-c-fin-doc.str-podr-name
     1514   IN FRAME Dialog-Frame.
     1515   display
     1516   F-curr-abbr
     1517   with frame Dialog-Frame
     1518   .
     1519   IF AVAILABLE tt-c-fin-doc THEN
     1520     display
     1521     tt-c-fin-doc.fin-doc-code
     1522     tt-c-fin-doc.prn-doc-code
     1523     tt-c-fin-doc.doc-date
     1524     tt-c-fin-doc.user-name-doc
     1525     tt-c-fin-doc.obj-type
     1526     tt-c-fin-doc.obj-code
     1527     tt-c-fin-doc.sum-rubl
     1528     tt-c-fin-doc.curr-code
     1529     tt-c-fin-doc.sum-doc
     1530     tt-c-fin-doc.receiver-code
     1531     tt-c-fin-doc.receiver-type
     1532     tt-c-fin-doc.receiver-name
     1533     tt-c-fin-doc.naznach-plat
     1534     tt-c-fin-doc.PS
