      503   procedure uf-get :
      504     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
      505     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
      506     define output parameter p-List_        like ubflt.usr-flt.List_        no-undo .
      507     define output parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
      508     define output parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
      509     define output parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
      510     define output parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
      511     define output parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
      512     do
      513     on error undo, return error
      514     :
      515       define buffer buf_usr-flt for ubflt.usr-flt .
      516       define variable v-use-List_     as logical   no-undo .
      517       define variable v-type-List_     as character no-undo .
      518       define variable v-format-List_   as character no-undo .
      519       define variable v-use-Naim      as logical   no-undo .
      520       define variable v-type-Naim      as character no-undo .
      521       define variable v-format-Naim    as character no-undo .
      522       define variable v-use-print-graft as logical   no-undo .
      523       define variable v-use-sort-gr     as logical   no-undo .
      524       define variable v-use-type-price  as logical   no-undo .
      525       define variable v-use-type-val    as logical   no-undo .
      526       define variable v-label          as character no-undo .
      527       define variable v-tooltip        as character no-undo .
      528       define variable v-user-can-edit  as logical   no-undo .
      529       define variable v-output-display as logical   no-undo .
      530       define variable v-other          as character no-undo .
      531       run uf-name in this-procedure
      532          (input  entry(1, p-code, chr(4))
      533         ,output v-use-List_
      534         ,output v-type-List_
      535         ,output v-format-List_
      536         ,output v-use-Naim
      537         ,output v-type-Naim
      538         ,output v-format-Naim
      539         ,output v-use-print-graft
      540         ,output v-use-sort-gr
      541         ,output v-use-type-price
      542         ,output v-use-type-val
      543         ,output v-label
      544         ,output v-tooltip
      545         ,output v-user-can-edit
      546         ,output v-output-display
      547         ,output v-other
      548         ) no-error .
      549       if error-status :error then do:
      550         undo, return error return-value .
      551       end.
      552       find first buf_usr-flt no-lock where
      553                  buf_usr-flt.Call-point     = p-code AND
      554                  buf_usr-flt.user-name       = p-user-name
      555         no-error .
      556       if avail buf_usr-flt then do:
      557         assign
      558         p-List_        = (if v-use-List_       then buf_usr-flt.List_       else ?)
      559         p-Naim         = (if v-use-Naim        then buf_usr-flt.Naim        else ?)
      560         p-print-graft  = (if v-use-print-graft then buf_usr-flt.print-graft else ?)
      561         p-sort-gr      = (if v-use-sort-gr     then buf_usr-flt.sort-gr     else ?)
      562         p-type-price   = (if v-use-type-price  then buf_usr-flt.type-price  else ?)
      563         p-type-val     = (if v-use-List_       then buf_usr-flt.type-val    else ?)
      564         .
      565       end.
      566       else do:
      567         assign
      568         p-List_        = (if v-use-List_       then "":U                    else ?)
      569         p-Naim         = (if v-use-Naim        then "":U                    else ?)
      570         p-print-graft  = (if v-use-print-graft then no                      else ?)
      571         p-sort-gr      = (if v-use-sort-gr     then no                      else ?)
      572         p-type-price   = (if v-use-type-price  then no                      else ?)
      573         p-type-val     = (if v-use-List_       then no                      else ?)
      574         .
      575       end.
      576     end.
      577   end procedure.
      578   procedure uf-set :
      579     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
      580     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
      581     define input  parameter p-List_        like ubflt.usr-flt.List_        no-undo .
      582     define input  parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
      583     define input  parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
      584     define input  parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
      585     define input  parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
      586     define input  parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
      587     do
      588     on error undo, return error
      589     :
      590       define buffer buf_usr-flt for ubflt.usr-flt .
      591       define variable v-use-List_     as logical   no-undo .
      592       define variable v-type-List_     as character no-undo .
      593       define variable v-format-List_   as character no-undo .
      594       define variable v-use-Naim      as logical   no-undo .
      595       define variable v-type-Naim      as character no-undo .
      596       define variable v-format-Naim    as character no-undo .
      597       define variable v-use-print-graft as logical   no-undo .
      598       define variable v-use-sort-gr   as logical   no-undo .
      599       define variable v-use-type-price as logical   no-undo .
      600       define variable v-use-type-val  as logical   no-undo .
      601       define variable v-tooltip        as character no-undo .
      602       define variable v-label          as character no-undo .
      603       define variable v-user-can-edit  as logical   no-undo .
      604       define variable v-output-display as logical   no-undo .
      605       define variable v-other          as character no-undo .
      606       run uf-name in this-procedure
      607         (input  entry(1, p-code, chr(4))
      608         ,output v-use-List_
      609         ,output v-type-List_
      610         ,output v-format-List_
      611         ,output v-use-Naim
      612         ,output v-type-Naim
      613         ,output v-format-Naim
      614         ,output v-use-print-graft
      615         ,output v-use-sort-gr
      616         ,output v-use-type-price
      617         ,output v-use-type-val
      618         ,output v-label
      619         ,output v-tooltip
      620         ,output v-user-can-edit
      621         ,output v-output-display
      622         ,output v-other
      623         ) no-error .
      624       if error-status :error then do:
      625         undo, return error return-value .
      626       end.
      627       find first buf_usr-flt where
      628                  buf_usr-flt.Call-point     = p-code AND
      629                  buf_usr-flt.user-name       = p-user-name
      630         no-error .
      631       if not avail buf_usr-flt then do:
      632           create buf_usr-flt .
      633           assign
      634           buf_usr-flt.call-point = p-code
      635           buf_usr-flt.user-name  = p-user-name
      636           .
      637       end.
      638       if avail buf_usr-flt then do:
      639        assign
      640        buf_usr-flt.List_       =  (if v-use-List_       then  p-List_        else ?)
      641        buf_usr-flt.Naim        =  (if v-use-Naim        then  p-Naim         else ?)
      642        buf_usr-flt.print-graft =  (if v-use-print-graft then  p-print-graft  else ?)
      643        buf_usr-flt.sort-gr     =  (if v-use-sort-gr     then  p-sort-gr      else ?)
      644        buf_usr-flt.type-price  =  (if v-use-type-price  then  p-type-price   else ?)
      645        buf_usr-flt.type-val    =  (if v-use-List_       then  p-type-val     else ?)
      646       .
      647       release buf_usr-flt.
      648       end.
      649       else undo, return error ("Ошибка при записи usr-flt" + substitute(" call-point=&1, user-name=&2", p-code, p-user-name)).
      650     end.
      651   end procedure.
      652   function diff-list returns character (
      653     input parfirst-list  as character,
      654     input parsecond-list as character,
      655     input pardelim       as character).
      656     if pardelim = ""
      657     or pardelim = ?
      658     then do:
      659       assign
      660         pardelim = ","
      661       .
      662     end.
      663     def var ind as integer no-undo .
      664     def var v-elem as character no-undo .
      665     def var v-result-list as character no-undo init "".
      666     def var v-num-parfirst-list as integer no-undo .
      667     assign
      668       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      669     .
      670     do ind = 1 to v-num-parfirst-list
      671     :
      672       assign
      673         v-elem = entry(ind, parfirst-list, pardelim)
      674       .
      675       if lookup(v-elem, parsecond-list, pardelim) = 0 then do:
      676         assign
      677           v-result-list = v-result-list
      678                         + (if v-result-list > "" then pardelim else "")
      679                         + v-elem
      680         .
      681       end.
      682     end.
      683     return v-result-list .
      684   end function.
      685   function add-list returns character (
      686    input parfirst-list  as character,
      687    input parsecond-list as character,
      688    input pardelim       as character).
      689     if pardelim = ""
      690     or pardelim = ?
      691     then do:
      692       assign
      693         pardelim = ","
      694       .
      695     end.
      696     def var ind as integer no-undo .
      697     def var v-elem as character no-undo .
      698     def var v-result-list as character no-undo init "".
      699     def var v-num-parfirst-list as integer no-undo .
      700     assign
      701       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      702     .
      703     do ind = 1 to v-num-parfirst-list
      704     :
      705       assign
      706         v-elem = entry(ind, parfirst-list, pardelim)
      707       .
      708       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
      709         assign
      710           v-result-list = v-result-list
      711                         + (if v-result-list > "" then pardelim else "")
      712                         + v-elem
      713         .
      714       end.
      715     end.
      716     def var v-num-parsecond-list as integer no-undo .
      717     assign
      718       v-num-parsecond-list = num-entries(parsecond-list, pardelim)
      719     .
      720     do ind = 1 to v-num-parsecond-list
      721     :
      722       assign
      723         v-elem = entry(ind, parsecond-list, pardelim)
      724       .
      725       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
      726         assign
      727           v-result-list = v-result-list
      728                         + (if v-result-list > "" then pardelim else "")
      729                         + v-elem
      730         .
      731       end.
      732     end.
      733     return v-result-list .
      734   end function.
      735   function cross-list returns character (
      736    input parfirst-list  as character,
      737    input parsecond-list as character,
      738    input pardelim       as character).
      739     if pardelim = ""
      740     or pardelim = ?
      741     then do:
      742       assign
      743         pardelim = ","
      744       .
      745     end.
      746     def var ind as integer no-undo .
      747     def var v-elem as character no-undo .
      748     def var v-result-list as character no-undo init "".
      749     def var v-num-parfirst-list as integer no-undo .
      750     assign
      751       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      752     .
      753     do ind = 1 to v-num-parfirst-list
      754     :
      755       assign
      756         v-elem = entry(ind, parfirst-list, pardelim)
      757       .
      758       if lookup(v-elem, v-result-list, pardelim) = 0
      759       and lookup(v-elem, parsecond-list, pardelim) > 0
      760       then do:
      761         assign
      762           v-result-list = v-result-list
      763                         + (if v-result-list > "" then pardelim else "")
      764                         + v-elem
      765         .
      766       end.
      767     end.
      768     return v-result-list .
      769   end function.
      770   function radio-label returns character (
      771    input par-rs-value  as character,
      772    input par-rs-radio-buttons as character)
      773    .
      774    DEFINE variable v-result-label as character no-undo.
      775    assign
      776    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons) MODULO 2 = 0)
      777                              then (LOOKUP(par-rs-value, par-rs-radio-buttons) - 1)
      778                              else LOOKUP(par-rs-value, par-rs-radio-buttons)
      779                             ), par-rs-radio-buttons
      780                           )
      781    v-result-label = REPLACE(v-result-label, "&":U, "":U)
      782    .
      783   return v-result-label.
      784   end function.
      785   function m-radio-label returns character (
      786    input par-rs-value  as character,
      787    input par-rs-radio-buttons as character,
      788    input par-delim as character
      789    )
      790    .
      791    DEFINE variable v-result-label as character no-undo.
      792    assign
      793    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) MODULO 2 = 0)
      794                              then (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) - 1)
      795                              else LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim)
      796                             ), par-rs-radio-buttons, par-delim
      797                           )
      798    v-result-label = REPLACE(v-result-label, "&":U, "":U)
      799    .
      800   return v-result-label.
      801   end function.
      802   FUNCTION mixlist returns character
      803   (
      804    input parfirst-list  as character
      805    ,input parsecond-list as character
      806    ,input pardelim       as character
      807    ,input pardelim-result as character ) :
      808     if pardelim = ""
      809     or pardelim = ?
      810     then do:
      811       assign
      812         pardelim = ","
      813       .
      814     end.
      815     def var ind as integer no-undo .
      816     def var v-elem1 as character no-undo .
      817     def var v-elem2 as character no-undo .
      818     def var v-result-list as character no-undo init "".
      819     do ind = 1 to num-entries(parfirst-list, pardelim)
      820     :
      821       assign
      822         v-elem1 = entry(ind, parfirst-list, pardelim)
      823         v-elem2 = entry(ind, parsecond-list, pardelim)
      824       .
      825         assign
      826           v-result-list = v-result-list
      827                         + (if v-result-list > "" then pardelim-result else "")
      828                         + v-elem1 + pardelim-result + v-elem2
      829         .
      830     end.
      831     return v-result-list .
      832   END FUNCTION.
