        1   DEFINE BUFFER locked_c-fin-doc FOR ub.c-fin-doc.
        2   DEFINE TEMP-TABLE tt-c-fin-doc NO-UNDO LIKE ub.c-fin-doc.
        3   DEFINE TEMP-TABLE tt0-fin-doc-attr NO-UNDO LIKE ub.fin-doc-attr.
        4   DEFINE TEMP-TABLE tt0-fin-doc-tax NO-UNDO LIKE ub.fin-doc-tax.
        5   DEFINE BUFFER X_clients-host FOR ub.clients.
        6   DEFINE BUFFER X_firm FOR ub.firm.
        7   DEFINE BUFFER X_sysconf FOR ub.sysconf.
        8   DEFINE INPUT     PARAMETER parParentProc  AS WIDGET-HANDLE NO-UNDO.
        9   define input parameter p-curr-host-code like ub.sysconf.host-code no-undo.
       10   define input parameter p-mode as character no-undo.
       11   define input parameter p-host-code like ub.fin-doc.host-code no-undo.
       12   define input parameter p-fin-doc-code like ub.fin-doc.fin-doc-code no-undo.
       13   define input parameter p-fin-ext-doc-type like ub.fin-doc.fin-ext-doc-type no-undo.
       14   define input-output parameter p-doc-rec as recid no-undo.
       15   def var vss-revision    as character no-undo init "$Revision$":U .
       16   def var vss-author      as character no-undo init "$Author$":U .
       17   def var vss-date        as character no-undo init "$Date$":U .
       18   def var vss-workfile    as character no-undo init "$Workfile$":U .
       19   def var vss-archive     as character no-undo init "$Archive$":U .
       20   def var vss-description as character no-undo init "Карточка истории расходного АПЗ".
       21   procedure vss-get-info :
       22     define output parameter p-vss-revision    like vss-revision    no-undo .
       23     define output parameter p-vss-author      like vss-author      no-undo .
       24     define output parameter p-vss-date        like vss-date        no-undo .
       25     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       26     define output parameter p-vss-archive     like vss-archive     no-undo .
       27     define output parameter p-vss-description like vss-description no-undo .
       28     assign
       29       p-vss-revision    = vss-revision
       30       p-vss-author      = vss-author
       31       p-vss-date        = vss-date
       32       p-vss-workfile    = vss-workfile
       33       p-vss-archive     = vss-archive
       34       p-vss-description = vss-description
       35     .
       36   end procedure.
       37   procedure vss-get-parameters :
       38     define output parameter p-vss-parameters as character no-undo .
       39   end procedure.
       40   define new global shared variable g#vssrevis-logger as handle    no-undo .
       41   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       42   define variable v-vssrevis-logger                   as handle    no-undo .
       43   procedure vss-logevent :
       44     define input  parameter p-extra-paramters as character no-undo .
       45     define variable v-vssrevis-parameters as character no-undo .
       46     do
       47     on error undo, return error return-value
       48     :
       49       if  valid-handle(v-vssrevis-logger)
       50       and v-vssrevis-logger :get-signature("logevent") <> ""
       51       then do:
       52         run vss-get-parameters in this-procedure
       53           (output v-vssrevis-parameters
       54           ).
       55         run logevent in v-vssrevis-logger
       56           (input vss-workfile
       57           ,input vss-revision
       58           ,input v-vssrevis-parameters
       59           ,input p-extra-paramters
       60           ).
       61       end.
       62     end.
       63   end procedure.
       64   assign
       65     v-vssrevis-logger = g#vssrevis-logger
       66   .
       67   if  valid-handle(v-vssrevis-logger)
       68   and v-vssrevis-logger :get-signature("logevent") <> ""
       69   then do:
       70     assign
       71       v-vssrevis-logevent = true
       72     .
       73     run vss-logevent in this-procedure (input vss-description) .
       74   end.
       75   define variable v-db-num like ub.db.db-num no-undo.
       76   define variable v-view as character no-undo init "full":U.
       77   define variable v-not-uf-set as logical no-undo.
       78   define variable v-rubf          as logical no-undo .
       79   define variable v-exchf         as logical no-undo .
       80   define variable v-basef         as logical no-undo .
       81   define variable v-baseratef     as logical no-undo .
       82   define variable v-contractf     as logical no-undo .
       83   define variable v-contractratef as logical no-undo .
       84   define variable v-us            as logical no-undo .
       85   define buffer X_fin-code-cor-acc for ub.fin-code-cor-acc.
       86   define buffer X_fin-code-an-uchet for ub.fin-code-an-uchet.
       87   define buffer X_fin-code-cel-nazn for ub.fin-code-cel-nazn.
       88   define buffer X_fin-code-cor-acc1 for ub.fin-code-cor-acc.
       89   define buffer X_currency for ub.currency.
       90   DEFINE BUFFER X_receiver FOR ub.clients.
       91   DEFINE BUFFER X_payer FOR ub.clients.
       92   define buffer X_curr_sysconf for ub.sysconf.
       93   define buffer X_contract for ub.contract.
       94   define buffer X_fin-ob for ub.fin-ob.
       95   define variable v-base-code like ub.sysconf.host-code no-undo.
       96   define new global shared variable g#language as character no-undo .
       97   if g#language <> '' and g#language <> 'rus':U then do:
       98     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       99   end.
      100   define new global shared variable g#library  as handle no-undo .
      101   define new global shared variable g#library2 as handle no-undo .
      102   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      103   define variable v-waitfram-action01         as character   no-undo .
      104   define variable v-waitfram-action02         as character   no-undo .
      105   define variable v-waitfram-action03         as character   no-undo .
      106   define variable mWaitFramTextBeg            as character   no-undo.
      107   define variable mWaitFramTextEnd            as character   no-undo.
      108   define variable mWaitFramView               as logical     no-undo.
      109   define variable mWaitProcEvent              as logical     no-undo init yes.
      110   define variable mWaitFramInterval           as integer     no-undo init 1 .
      111   define variable mWaitFramStop               as logical     no-undo.
      112   define variable mWaitFramStopUser           as logical     no-undo.
      113   define variable mWaitFramStopTimeOut        as logical     no-undo.
      114   define variable mWaitFramStartProc          as datetime-tz no-undo.
      115   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      116   define button B-WaitFramStop auto-end-key
      117        label "Стоп"
      118        size 10 by 1 tooltip "Остоновить процесс".
      119   define button B-viewProcInfo
      120        label "Информация"
      121        size 15 by 1 tooltip "Информация о процесс".
      122   define frame waitfram
      123     v-waitfram-action01 format "x(72)" no-label skip
      124     v-waitfram-action02 format "x(72)" no-label skip
      125     v-waitfram-action03 format "x(72)" no-label skip
      126     B-viewProcInfo
      127     B-WaitFramStop at row 4 col 30
      128     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      129     .
      130   define new global shared variable mBatchMode as logical no-undo init ?.
      131   define variable mFramBachModHandle as handle no-undo.
      132   mFramBachModHandle = frame waitfram:handle.
      133   define variable mFameOldVis as logical no-undo.
      134   define variable mVisCUrentVin as logical no-undo.
      135   if session:batch-mode
      136   then
      137      mBatchMode = yes.
      138   if mBatchMode = ? then do:
      139     mVisCUrentVin = current-window:visible.
      140     mFameOldVis = mFramBachModHandle:visible.
      141     mFramBachModHandle:visible  = yes.
      142     mBatchMode = mFramBachModHandle:visible ne yes.
      143     mFramBachModHandle:visible = mFameOldVis.
      144     current-window:visible = mVisCUrentVin.
      145   end.
      146    if  log-manager:logfile-name ne ?
      147     then DO:
      148         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      149         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      150         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      151     end.
      152   on choose of B-WaitFramStop in frame waitfram
      153   do:
      154     mWaitFramStop = yes.
      155     mWaitFramStopUser = yes.
      156   end.
      157   function waitfram-check-timeout returns logical():
      158      define variable vtime as int64 no-undo.
      159      if mWaitFramStopTimeOut
      160      then
      161         return yes.
      162      vtime = ( now - mWaitFramStartProc ) / 1000 .
      163      if     mWaitFramTimeOut ne ?
      164         and mWaitFramTimeOut ne 0
      165         and mWaitFramTimeOut lt vtime
      166      then do:
      167         mWaitFramStopTimeOut = yes.
      168      end.
      169      return mWaitFramStopTimeOut.
      170   end.
      171   procedure waitfram-hide :
      172     if not session:batch-mode
      173     then do
      174     on error undo, return error return-value
      175     :
      176       pause 0 before-hide .
      177       if not mBatchMode then
      178         hide frame waitfram .
      179     if     not mWaitFramView
      180        and mWaitProcEvent
      181     then
      182       process events .
      183     end.
      184   end procedure.
      185   procedure waitfram-show :
      186     define input  parameter p-message as character no-undo .
      187     define variable v-left-margin as integer   no-undo .
      188     if not session:batch-mode
      189     then do
      190     on error undo, return error return-value
      191     :
      192       if length(p-message) <= 70 then do:
      193         assign
      194           v-left-margin = integer((70 - length(p-message)) / 2)
      195         .
      196         assign
      197           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      198         .
      199         assign
      200           v-waitfram-action01 = " "
      201           v-waitfram-action02 = " "
      202                                    + fill(" ", v-left-margin)
      203                                    + p-message
      204           v-waitfram-action03 = " "
      205         .
      206       end.
      207       else do:
      208         define variable vRindex1 as integer no-undo.
      209         define variable vRindex2 as integer no-undo.
      210         vRindex1 = r-index(p-message," ",70).
      211         if vRindex1 = 0
      212         then
      213            vRindex1 = 70.
      214         if length(p-message)  <= vRindex1 + 70 then do:
      215           assign
      216             v-waitfram-action01 = " "
      217             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      218             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      219           .
      220         end.
      221         else do:
      222           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      223           if vRindex2 <= vRindex1
      224           then
      225              vRindex2 = vRindex1 + 70.
      226           assign
      227             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      228             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      229             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      230           .
      231         end.
      232       end.
      233       B-viewProcInfo:visible   in frame waitfram = no.
      234       B-viewProcInfo:sensitive in frame waitfram = no.
      235       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      236       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      237       if  (   mWaitFramView
      238          or  mWaitProcEvent)
      239          and not mBatchMode
      240       then
      241          display
      242             v-waitfram-action01 skip
      243             v-waitfram-action02 skip
      244             v-waitfram-action03 skip
      245          with frame waitfram .
      246       if     mWaitFramView
      247          then do:
      248             if     mWaitFramInterval ne ?
      249                and not mBatchMode
      250             then
      251                wait-for go of frame waitfram pause mWaitFramInterval.
      252          end.
      253          else
      254             if     mWaitProcEvent
      255                and not mBatchMode
      256             then
      257                process events .
      258     end.
      259   end procedure.
      260      procedure waitfram-show-this:
      261         define input  parameter iInterval as int64 no-undo.
      262         define variable vtime as int64 no-undo.
      263         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      264         mWaitFramInterval = iInterval.
      265         run waitfram-show (substitute("&1&2 &3&4" ,
      266                                       mWaitFramTextBeg ,
      267                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      268                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      269                                       mWaitFramTextEnd
      270                                      )
      271                           ).
      272      end.
      273      procedure WaitFramRunPause:
      274         define input  parameter iInterval as dec no-undo.
      275         define variable vStart  as datetime-tz no-undo.
      276         define variable vend    as datetime-tz no-undo.
      277         define variable vint as int64 no-undo.
      278         define variable vOk as logical no-undo.
      279         vStart = now.
      280         vend   = vStart.
      281         publish "WaitFramPause" (iInterval,output vOk).
      282         vend   =  now.
      283         vint = vend - vStart.
      284         vint = iInterval - vint / 1000.
      285         if     not mWaitFramStop
      286            and (   vint > 0
      287                 or (    not vOk
      288                     and iInterval eq ?
      289                     )
      290                 )
      291         then
      292            run waitfram-show-this (iInterval).
      293         vend   =  now.
      294         vint = vend - vStart.
      295         vint = iInterval - vint / 1000.
      296         if     not mWaitFramStop
      297            and vint > 0
      298         then do:
      299            run gbl/pause.p (vint * 1000).
      300         end.
      301         if iInterval ne ?
      302         then
      303            publish "WaitFramStop".
      304         waitfram-check-timeout().
      305      end.
      306      procedure WaitFramWaitFor:
      307         define input  parameter iInterval as dec no-undo.
      308         assign
      309            mWaitFramStartProc   = now
      310            mWaitFramStopUser    = no
      311            mWaitFramStopTimeOut = no
      312         .
      313         block-wait:
      314         do while not mWaitFramStop:
      315            run WaitFramRunPause (iInterval).
      316            if  waitfram-check-timeout()
      317            then do:
      318               leave block-wait.
      319            end.
      320         end.
      321         run waitfram-hide.
      322      end.
      323   procedure waitfram-join :
      324     define input  parameter p-line-1  as character no-undo .
      325     define input  parameter p-line-2  as character no-undo .
      326     define input  parameter p-line-3  as character no-undo .
      327     define output parameter p-message as character no-undo .
      328     do
      329     on error undo, return error return-value
      330     :
      331       assign
      332         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      333                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      334                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      335       .
      336     end.
      337   end procedure.
      338   function waitfram-join-function returns character
      339     (input p-line-1 as character
      340     ,input p-line-2 as character
      341     ,input p-line-3 as character
      342     ).
      343     define variable v-message as character no-undo .
      344     run waitfram-join in this-procedure
      345       (input  p-line-1
      346       ,input  p-line-2
      347       ,input  p-line-3
      348       ,output v-message
      349       ) .
      350     return v-message .
      351   end function .
      352   procedure proc-alt-shift-f2:
      353     if not ibs.th.gbl.gbl-var:rcode
      354   then
      355     run gbl\inidebug.p .
      356   end.
      357   procedure proc-alt-shift-f3:
      358     run gbl/prvssinf.p
      359       ( input this-procedure
      360       ) .
      361   end.
      362   define variable v-inform-launched as logical no-undo initial false .
      363   procedure proc-alt-shift-f4:
      364     define variable v-action as character no-undo .
      365     if v-inform-launched = false then do:
      366       assign
      367         v-inform-launched = true
      368       .
      369       run gbl/d-inform.w
      370         (  input self
      371         ,  input this-procedure
      372         , output v-action
      373         ) no-error .
      374       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      375       assign
      376         v-inform-launched = false
      377       .
      378     end.
      379   end.
      380   procedure proc-alt-f1:
      381     run gbl/corrhelp.p
      382       (input this-procedure
      383       ) .
      384   end .
      385   on alt-shift-f2 anywhere do:
      386     run proc-alt-shift-f2.
      387   end.
      388   on alt-shift-f3 anywhere do:
      389     run proc-alt-shift-f3 in this-procedure .
      390   end.
      391   on alt-shift-f4 anywhere do:
      392     run proc-alt-shift-f4 in this-procedure.
      393   end.
      394   on alt-f1 anywhere do:
      395     run proc-alt-f1 in this-procedure .
      396   end.
      397   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      398   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      399   define variable v-uf-List_        like ubflt.usr-flt.List_        no-undo .
      400   define variable v-uf-Naim         like ubflt.usr-flt.Naim         no-undo .
      401   define variable v-uf-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
      402   define variable v-uf-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
      403   define variable v-uf-type-price   like ubflt.usr-flt.type-price   no-undo .
      404   define variable v-uf-type-val     like ubflt.usr-flt.type-val     no-undo .
      405   define temp-table usr-flt_custom-labels no-undo like ub.custom-labels.
      406   procedure uf-name :
      407     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
      408     define output parameter p-use-List_     as logical   no-undo .
      409     define output parameter p-type-List_     as character no-undo .
      410     define output parameter p-format-List_   as character no-undo .
      411     define output parameter p-use-Naim      as logical   no-undo .
      412     define output parameter p-type-Naim      as character no-undo .
      413     define output parameter p-format-Naim    as character no-undo .
      414     define output parameter p-use-print-graft as logical   no-undo .
      415     define output parameter p-use-sort-gr   as logical   no-undo .
      416     define output parameter p-use-type-price as logical   no-undo .
      417     define output parameter p-use-type-val  as logical   no-undo .
      418     define output parameter p-label          as character no-undo .
      419     define output parameter p-tooltip        as character no-undo .
      420     define output parameter p-user-can-edit  as logical   no-undo .
      421     define output parameter p-output-display as logical   no-undo .
      422     define output parameter p-other          as character no-undo .
      423     do
      424     on error undo, return error
      425     :
      426       case p-code :
      427               when 'cli-all-p':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = yes      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Параметры вызова справочника клиентов"     p-tooltip = "Параметры по умолчанию, используемые для вызова справочника клиентов"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
      428               when 'oldscode':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(1)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Настройки справочника неиспользуемых весовых кодов"     p-tooltip = "Настройки справочника неиспользуемых весовых кодов"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
      429               when 'gds-ref-p':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = yes      p-type-Naim = 'C':U      p-format-Naim = "X(8)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = yes      p-label = "Параметры вызова справочника товаров"     p-tooltip = "Параметры по умолчанию, используемые для вызова справочника товаров"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
      430               when 'gds-grp-p':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(1)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Параметры вызова справочника групп товаров"     p-tooltip = "Параметры по умолчанию, используемые для вызова справочника групп товаров"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
