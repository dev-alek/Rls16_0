     1343   end.
     1344   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1345   procedure minbtn-set :
     1346       do
     1347           on error undo, return error return-value
     1348           :
     1349           define variable ii              as integer       no-undo .
     1350           define variable fh              as widget-handle no-undo .
     1351           define variable hh              as widget-handle no-undo .
     1352           define variable v-h             as handle        extent 4 no-undo .
     1353           define variable v-name-button   as character     no-undo .
     1354           define variable v-help-old-x    as decimal       no-undo .
     1355           define variable v-help-old-y    as decimal       no-undo .
     1356           define variable v-help-old-size as decimal       no-undo .
     1357           define variable v-frame-width   as decimal       no-undo .
     1358           define variable jj              as integer       no-undo .
     1359           do
     1360               on error undo, return error
     1361               :
     1362               assign
     1363                   v-frame-width = frame Dialog-Frame:width - 0.3
     1364                   fh            = frame Dialog-Frame:first-child
     1365                   hh            = fh:first-child
     1366                   ii            = 1
     1367                   .
     1368               do while valid-handle(hh):
     1369                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1370                   do:
     1371                       case lc(hh:name) :
     1372                           when "b-help" then
     1373                               do:
     1374                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1375                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1376                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1377                                   hh:TOOLTIP = "Помощь" .
     1378                                   v-help-old-x = hh:column .
     1379                                   v-help-old-y = hh:row    .
     1380                                   v-help-old-size = hh:width .
     1381                                   hh:width-chars = 2.5 .
     1382                               end.
     1383                           when "b-print" then
     1384                               do:
     1385                                   hh:load-image("cmp/b-print.bmp":u) .
     1386                                   hh:TOOLTIP = "Печать" .
     1387                                   v-h[ii] = hh:handle .
     1388                                   ii = ii + 1 .
     1389                                   hh:width-chars = 3 .
     1390                               end.
     1391                           when "b-history" or
     1392                           when "b-hist" then
     1393                               do:
     1394                                   hh:load-image("cmp/b-hist.bmp":u) .
     1395                                   hh:TOOLTIP = "История" .
     1396                                   v-h[ii] = hh:handle .
     1397                                   ii = ii + 1 .
     1398                                   hh:width-chars = 3 .
     1399                               end.
     1400                           when "b-sch" then
     1401                               do:
     1402                                   hh:load-image("cmp/b-sch.bmp":u) .
     1403                                   hh:TOOLTIP = "Установка Фильтра" .
     1404                                   v-h[ii] = hh:handle .
     1405                                   ii = ii + 1 .
     1406                                   hh:width-chars = 3 .
     1407                               end.
     1408                           when "b-hist-user" then
     1409                               do:
     1410                                   hh:load-image("cmp/b-hist.bmp":u) .
     1411                                   hh:TOOLTIP = "История пользователя" .
     1412                                   ii = ii + 1 .
     1413                               end.
     1414                       end case.
     1415                   end.
     1416                   hh = hh:next-sibling.
     1417               end.
     1418               b-help:column = v-frame-width - b-help:width-chars.
     1419               jj = 0.
     1420               repeat ii = 4 to 1 by -1 :
     1421                   if valid-handle (v-h[ii] ) then
     1422                   do:
     1423                       jj  = jj + 1 .
     1424                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1425                       v-h[ii]:row    = v-help-old-y .
     1426                   end.
     1427               end.
     1428           end.
     1429       end.
     1430   end procedure.
