     1237   PROCEDURE fill-tables :
     1238   define buffer buf_c-fin-doc-tax for ub.c-fin-doc-tax.
     1239   define buffer buf_c-fin-doc-attr for ub.c-fin-doc-attr.
     1240   for each buf_c-fin-doc-tax no-lock where
     1241   buf_c-fin-doc-tax.host-code = tt-c-fin-doc.host-code
     1242   AND buf_c-fin-doc-tax.fin-doc-code = tt-c-fin-doc.fin-doc-code
     1243   AND buf_c-fin-doc-tax.chip-num = tt-c-fin-doc.chip-num
     1244    :
     1245       create tt0-fin-doc-tax.
     1246       buffer-copy buf_c-fin-doc-tax to tt0-fin-doc-tax.
     1247   end.
     1248   for each buf_c-fin-doc-attr no-lock where
     1249   buf_c-fin-doc-attr.host-code = tt-c-fin-doc.host-code
     1250   AND buf_c-fin-doc-attr.fin-doc-code = tt-c-fin-doc.fin-doc-code
     1251   AND buf_c-fin-doc-attr.chip-num = tt-c-fin-doc.chip-num
     1252   :
     1253       create tt0-fin-doc-attr.
     1254       buffer-copy buf_c-fin-doc-attr to tt0-fin-doc-attr.
     1255   end.
     1256   END PROCEDURE.
     1257   PROCEDURE hide-view-currency :
     1258   assign
     1259   v-rubf = no
     1260   v-exchf = no
     1261   v-basef = no
     1262   v-baseratef = no
     1263   v-contractf = no
     1264   v-contractratef = no
     1265   .
     1266   hide
     1267   tt-c-fin-doc.exch-rate in frame Dialog-Frame
     1268   tt-c-fin-doc.exch-scale
     1269   tt-c-fin-doc.sum-rubl
     1270   tt-c-fin-doc.sum-base
     1271   tt-c-fin-doc.base-rate
     1272   tt-c-fin-doc.base-scale
     1273   tt-c-fin-doc.sum-contr
     1274   tt-c-fin-doc.contract-rate
     1275   tt-c-fin-doc.contract-scale
     1276   in frame Dialog-Frame .
     1277   if tt-c-fin-doc.curr-code = 0
     1278   and v-base-code = 0
     1279   and
     1280   (tt-c-fin-doc.contract-code = 0
     1281   or tt-c-fin-doc.contract-curr = 0)
     1282   then do:
     1283       return.
     1284   end.
     1285   if tt-c-fin-doc.curr-code <> 0 then do:
     1286     if tt-c-fin-doc.curr-code:visible then
     1287     display
     1288     tt-c-fin-doc.exch-rate
     1289     tt-c-fin-doc.exch-scale
     1290     tt-c-fin-doc.sum-rubl
     1291     with frame Dialog-Frame.
     1292     assign
     1293     v-rubf = yes
     1294     v-exchf = yes
     1295     .
     1296   end.
     1297   if v-base-code <> 0 then do:
     1298     if tt-c-fin-doc.curr-code:visible then
     1299     display
     1300     tt-c-fin-doc.base-rate
     1301     tt-c-fin-doc.base-scale
     1302     tt-c-fin-doc.sum-base
     1303     with frame Dialog-Frame.
     1304     assign
     1305     v-basef = yes
     1306     v-baseratef = yes
     1307     .
     1308   end.
     1309   if tt-c-fin-doc.contract-code  <> 0 and
     1310     (tt-c-fin-doc.contract-curr <> 0  )
     1311     then do:
     1312       if tt-c-fin-doc.curr-code:visible then
     1313       display
     1314       tt-c-fin-doc.sum-contr
     1315       tt-c-fin-doc.contract-rate
     1316       tt-c-fin-doc.contract-scale
     1317       with frame Dialog-Frame.
     1318     assign
     1319     v-contractf = yes
     1320     v-contractratef = yes
     1321     .
     1322   end.
     1323   END PROCEDURE.
     1324   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1325   on help of frame Dialog-Frame
     1326   do:
     1327     run gbl/app_help.p
     1328       (input this-procedure :file-name
     1329       ,input ''
     1330       ,input ?
     1331       ) no-error.
     1332     if error-status :error then do:
     1333       message
     1334         "Ошибка при вызове помощи"
     1335         error-status :get-message(1)
     1336         view-as alert-box .
     1337     end.
     1338   end.
     1339   run minbtn-set in this-procedure .
