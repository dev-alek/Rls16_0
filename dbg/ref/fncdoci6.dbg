     1595       f-contract-prn-code when tt-c-fin-doc.contract-code <> 0
     1596       f-contract-type when tt-c-fin-doc.contract-code <> 0
     1597       f-contract-curr-abbr when tt-c-fin-doc.contract-code <> 0
     1598       tt-c-fin-doc.contract-curr when tt-c-fin-doc.contract-code <> 0
     1599       with frame Dialog-Frame
     1600       .
