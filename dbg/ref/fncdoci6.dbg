     1605   END CASE.
     1606   END PROCEDURE.
     1607   PROCEDURE disable_UI :
     1608     HIDE FRAME Dialog-Frame.
     1609   END PROCEDURE.
     1610   PROCEDURE enable_UI :
     1611     OPEN QUERY Dialog-Frame FOR EACH locked_c-fin-doc SHARE-LOCK.
     1612     GET FIRST Dialog-Frame.
     1613     DISPLAY RS-view f-cor-acc-descr f-an-uchet-descr f-contract-curr-abbr
     1614             f-contract-prn-code f-contract-date f-contract-type f-cor-acc1-descr
     1615             f-cel-nazn-descr F-curr-abbr F-debet F-credit
     1616         WITH FRAME Dialog-Frame.
     1617     IF AVAILABLE tt-c-fin-doc THEN
     1618       DISPLAY tt-c-fin-doc.user-name-doc tt-c-fin-doc.prn-doc-code
     1619             tt-c-fin-doc.fin-doc-code tt-c-fin-doc.perm-date tt-c-fin-doc.doc-date
     1620             tt-c-fin-doc.user-name-perm tt-c-fin-doc.obj-type
     1621             tt-c-fin-doc.obj-code tt-c-fin-doc.fact-date
     1622             tt-c-fin-doc.user-name-fact tt-c-fin-doc.payer-type
     1623             tt-c-fin-doc.payer-code tt-c-fin-doc.payer-okpo
     1624             tt-c-fin-doc.payer-name tt-c-fin-doc.str-podr-type
     1625             tt-c-fin-doc.str-podr-code tt-c-fin-doc.str-podr-name
     1626             tt-c-fin-doc.cor-acc-value tt-c-fin-doc.an-uchet-value
     1627             tt-c-fin-doc.contract-curr tt-c-fin-doc.cor-acc1-value
     1628             tt-c-fin-doc.cel-nazn-value tt-c-fin-doc.sum-doc
     1629             tt-c-fin-doc.curr-code tt-c-fin-doc.exch-rate tt-c-fin-doc.exch-scale
     1630             tt-c-fin-doc.sum-rubl tt-c-fin-doc.base-rate tt-c-fin-doc.base-scale
     1631             tt-c-fin-doc.sum-base tt-c-fin-doc.contract-rate
     1632             tt-c-fin-doc.contract-scale tt-c-fin-doc.sum-contr
     1633             tt-c-fin-doc.receiver-type tt-c-fin-doc.receiver-code
     1634             tt-c-fin-doc.receiver-name tt-c-fin-doc.naznach-plat tt-c-fin-doc.PS
     1635             tt-c-fin-doc.payer-sign1 tt-c-fin-doc.receiver-sign1
     1636         WITH FRAME Dialog-Frame.
     1637     ENABLE B-exit b-quit B-tax B-Help RS-view tt-c-fin-doc.user-name-doc
     1638            tt-c-fin-doc.prn-doc-code tt-c-fin-doc.doc-date tt-c-fin-doc.obj-type
     1639            tt-c-fin-doc.obj-code tt-c-fin-doc.payer-name B-payer-view
     1640            tt-c-fin-doc.str-podr-type tt-c-fin-doc.str-podr-code
     1641            tt-c-fin-doc.str-podr-name tt-c-fin-doc.cor-acc-value
     1642            tt-c-fin-doc.an-uchet-value f-contract-curr-abbr B-contract-view
     1643            tt-c-fin-doc.contract-curr tt-c-fin-doc.cor-acc1-value
     1644            tt-c-fin-doc.cel-nazn-value tt-c-fin-doc.sum-doc
     1645            tt-c-fin-doc.curr-code tt-c-fin-doc.exch-rate tt-c-fin-doc.exch-scale
     1646            tt-c-fin-doc.sum-base tt-c-fin-doc.contract-rate
     1647            tt-c-fin-doc.contract-scale tt-c-fin-doc.sum-contr
     1648            tt-c-fin-doc.receiver-type tt-c-fin-doc.receiver-code
     1649            tt-c-fin-doc.receiver-name B-receiver-view tt-c-fin-doc.naznach-plat
     1650            tt-c-fin-doc.PS tt-c-fin-doc.payer-sign1 tt-c-fin-doc.receiver-sign1
     1651         WITH FRAME Dialog-Frame.
     1652     VIEW FRAME Dialog-Frame.
     1653   END PROCEDURE.
     1654   PROCEDURE fill-main-table :
     1655   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1656   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
     1657     (output v-db-num
     1658     )  .
     1659   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1660   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     1661     (input  p-host-code
     1662     ,output v-base-code
     1663     )  .
     1664   find first X_curr_sysconf no-lock where
     1665                   X_curr_sysconf.host-code = p-curr-host-code.
     1666   find first X_sysconf no-lock where
     1667                 X_sysconf.host-code = p-host-code.
     1668   find first X_clients-host no-lock where
     1669               X_clients-host.obj-type = 'орг':U
     1670           AND   X_clients-host.obj-code = p-host-code  no-error.
     1671   if not available X_clients-host then do:
     1672     message
     1673     vss-workfile vss-revision vss-description skip
     1674     "Неверное значение параметра вызова p-host-code"  p-host-code
     1675     view-as alert-box ERROR.
     1676     undo, return error.
     1677   end.
     1678   find first X_firm no-lock where
     1679               X_firm.firm-code = p-host-code.
     1680   for each tt-c-fin-doc:
     1681     delete tt-c-fin-doc.
     1682   end.
     1683   for each tt0-fin-doc-attr:
     1684     delete tt0-fin-doc-attr.
     1685   end.
     1686   for each tt0-fin-doc-tax:
     1687    delete tt0-fin-doc-tax.
     1688   end.
     1689   find first locked_c-fin-doc no-lock where
     1690               recid(locked_c-fin-doc) = p-doc-rec no-error .
     1691   if not available locked_c-fin-doc then do:
     1692     find first locked_c-fin-doc no-lock where
     1693                 locked_c-fin-doc.host-code = p-host-code
     1694             AND locked_c-fin-doc.fin-doc-code = p-fin-doc-code no-error .
     1695   end.
     1696   if not available locked_c-fin-doc then do:
     1697   message
     1698   vss-workfile vss-revision vss-description skip
     1699   "Не найдена запись истории РАСХОДНОГО ОРДЕРА"
     1700   view-as alert-box error .
     1701   undo, return error.
     1702   end.
     1703   create tt-c-fin-doc.
     1704   buffer-copy locked_c-fin-doc to tt-c-fin-doc.
     1705   END PROCEDURE.
     1706   PROCEDURE Myenable :
     1707   define variable g-log as logical no-undo.
     1708   assign
     1709       tt-c-fin-doc.sum-rubl :label in frame Dialog-Frame = "Рубли"
     1710   .
     1711   run uf-get in this-procedure(
     1712       input  ('findoci-p':U + chr(4) + 'рко':U)
     1713       ,input  v-cntxt-userid
     1714       ,output v-uf-List_
     1715       ,output v-uf-Naim
     1716       ,output v-uf-print-graft
     1717       ,output v-uf-sort-gr
     1718       ,output v-uf-type-price
     1719       ,output v-uf-type-val
     1720   )  no-error.
     1721   if not error-status:error
     1722   and not v-uf-LIst_ = "":U
     1723   then do:
     1724       assign
     1725       v-view =  entry(1, v-uf-List_, chr(4))
     1726       .
     1727   end.
     1728   assign
     1729   frame Dialog-Frame:title = frame Dialog-Frame:title + chr(32) + x_clients-host.obj-name
     1730   tt-c-fin-doc.receiver-type:radio-buttons = "Орг" + chr(44) + 'орг':U + chr(44) +
     1731                                            "Чел" + chr(44) + 'чел':U
     1732   rs-view:radio-buttons = "&Полностью" + chr(44) + "full":U +  chr(44) +
     1733                                       "&Сокращ." + chr(44) + "brief":U + chr(44) +
     1734                                       "&Договор" + chr(44) + "contract":U
     1735   rs-view = v-view
     1736   tt-c-fin-doc.obj-type:radio-buttons = "Маг" + chr(44) + 'маг':U + chr(44) +
     1737                                         "Скл" + chr(44) + 'скл':U
     1738   .
     1739   if tt-c-fin-doc.contract-code = 0 then do:
     1740       assign
     1741       g-log = rs-view:disable(radio-label("contract":U, RS-view:radio-buttons))
     1742       .
     1743       if rs-view = "contract":U then
     1744       assign
     1745       rs-view = "full":U
     1746       v-not-uf-set = yes.
     1747   end.
     1748   find first X_currency no-lock where
     1749                 X_currency.curr-code = tt-c-fin-doc.curr-code.
     1750   assign
     1751   f-curr-abbr = X_Currency.curr-abbr.
     1752   if tt-c-fin-doc.contract-code <> 0 then do:
     1753     find first X_currency no-lock where
     1754                   X_currency.curr-code = tt-c-fin-doc.contract-curr.
     1755     assign
     1756     f-contract-curr-abbr = X_Currency.curr-abbr.
     1757   end.
     1758   assign
     1759   tt-c-fin-doc.payer-sign1:label  = tt-c-fin-doc.payer-sign1:label  + " - ":U +
     1760                             (if num-entries(tt-c-fin-doc.payer-sign1, chr(4)) > 1
     1761                             then entry(1, tt-c-fin-doc.payer-sign1, chr(4))
     1762                             else "":U)
     1763   tt-c-fin-doc.payer-sign1 =   (if num-entries(tt-c-fin-doc.payer-sign1, chr(4)) > 1
     1764                                     then entry(2, tt-c-fin-doc.payer-sign1, chr(4))
     1765                                     else entry(1, tt-c-fin-doc.payer-sign1, chr(4)))
     1766   .
     1767   find first X_receiver no-lock where
     1768             X_receiver.obj-type = tt-c-fin-doc.receiver-type
     1769         and X_receiver.obj-code = tt-c-fin-doc.receiver-code.
     1770   if tt-c-fin-doc.cor-acc1 <> 0 then do:
     1771       find first X_fin-code-cor-acc1 no-lock where
     1772                   X_fin-code-cor-acc1.fin-code  = tt-c-fin-doc.cor-acc1 no-error.
     1773       if available X_fin-code-cor-acc1 then do:
     1774         assign
     1775         f-cor-acc1-descr = X_fin-code-cor-acc1.descr.
     1776       end.
     1777       if not available X_fin-code-cor-acc1 then do:
     1778         assign
     1779         f-cor-acc1-descr = "!!!Код больше не существует".
     1780       end.
     1781   end.
     1782   if tt-c-fin-doc.cor-acc <> 0 then do:
     1783       find first X_fin-code-cor-acc no-lock where
     1784                   X_fin-code-cor-acc.fin-code  = tt-c-fin-doc.cor-acc no-error.
     1785       if available X_fin-code-cor-acc then do:
     1786         assign
     1787         f-cor-acc-descr = X_fin-code-cor-acc.descr.
     1788       end.
     1789       if not available X_fin-code-cor-acc then do:
     1790         assign
     1791         f-cor-acc-descr = "!!!Код больше не существует".
     1792       end.
     1793   end.
     1794   if tt-c-fin-doc.an-uchet-code <> 0 then do:
     1795     find first X_fin-code-an-uchet no-lock where
     1796                   X_fin-code-an-uchet.fin-code  = tt-c-fin-doc.an-uchet-code no-error.
     1797       if available X_fin-code-an-uchet then do:
     1798         assign
     1799         f-an-uchet-descr = X_fin-code-an-uchet.descr.
     1800       end.
     1801       if not available X_fin-code-an-uchet then do:
     1802         assign
     1803         f-an-uchet-descr = "!!!Код больше не существует".
     1804       end.
     1805   end.
     1806   if tt-c-fin-doc.cel-nazn-code <> 0 then do:
     1807     find first X_fin-code-cel-nazn no-lock where
     1808                   X_fin-code-cel-nazn.fin-code  = tt-c-fin-doc.cel-nazn-code no-error.
     1809       if available X_fin-code-cel-nazn then do:
     1810         assign
     1811         f-cel-nazn-descr = X_fin-code-cel-nazn.descr.
     1812       end.
     1813       if not available X_fin-code-cel-nazn then do:
     1814         assign
     1815         f-cel-nazn-descr = "!!!Код больше не существует".
     1816       end.
     1817   end.
     1818   run proc-color-widgets in this-procedure("f-an-uchet-descr,f-cel-nazn-descr,f-contract-curr-abbr,f-contract-date,f-contract-prn-code,f-contract-rate," +                         "f-contract-scale,f-contract-type,f-cor-acc1-descr,f-cor-acc-descr,base-rate,base-scale,curr-code,exch-rate,exch-scale," +                         "fact-date,fin-doc-code,receiver-code,receiver-type,perm-date,PS,payer-code,payer-type,sum-base,sum-rubl," +                         "user-name-doc,user-name-fact,user-name-perm", no, yes, ?, grey_color).
     1819   run proc-color-widgets in this-procedure("F-curr-abbr,an-uchet-value,cel-nazn-value,cor-acc1-value,cor-acc-value,doc-date," +                       "naznach-plat,receiver-name,prn-doc-code,payer-name,payer-okpo,receiver-passport,payer-sign1,receiver-sign1,sign3" +                       "str-podr-code,str-podr-name,str-podr-type,sum-doc", no, yes, ?, grey_color).
     1820   run change-view in this-procedure(rs-view).
     1821   VIEW FRAME Dialog-Frame.
     1822   END PROCEDURE.
