     1085         error-status :get-message(1)
     1086         view-as alert-box .
     1087     end.
     1088   end.
     1089   run minbtn-set in this-procedure .
     1090   on choose of b-help in frame f-c-p
     1091   do:
     1092     apply "help":u to frame f-c-p .
     1093   end.
     1094   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1095   procedure minbtn-set :
     1096       do
     1097           on error undo, return error return-value
     1098           :
     1099           define variable ii              as integer       no-undo .
     1100           define variable fh              as widget-handle no-undo .
     1101           define variable hh              as widget-handle no-undo .
     1102           define variable v-h             as handle        extent 4 no-undo .
     1103           define variable v-name-button   as character     no-undo .
     1104           define variable v-help-old-x    as decimal       no-undo .
     1105           define variable v-help-old-y    as decimal       no-undo .
     1106           define variable v-help-old-size as decimal       no-undo .
     1107           define variable v-frame-width   as decimal       no-undo .
     1108           define variable jj              as integer       no-undo .
     1109           do
     1110               on error undo, return error
     1111               :
     1112               assign
     1113                   v-frame-width = frame f-c-p:width - 0.3
     1114                   fh            = frame f-c-p:first-child
     1115                   hh            = fh:first-child
     1116                   ii            = 1
     1117                   .
     1118               do while valid-handle(hh):
     1119                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1120                   do:
     1121                       case lc(hh:name) :
     1122                           when "b-help" then
     1123                               do:
     1124                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1125                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1126                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1127                                   hh:TOOLTIP = "Помощь" .
     1128                                   v-help-old-x = hh:column .
     1129                                   v-help-old-y = hh:row    .
     1130                                   v-help-old-size = hh:width .
     1131                                   hh:width-chars = 2.5 .
     1132                               end.
     1133                           when "b-print" then
     1134                               do:
     1135                                   hh:load-image("cmp/b-print.bmp":u) .
     1136                                   hh:TOOLTIP = "Печать" .
     1137                                   v-h[ii] = hh:handle .
     1138                                   ii = ii + 1 .
     1139                                   hh:width-chars = 3 .
     1140                               end.
     1141                           when "b-history" or
     1142                           when "b-hist" then
     1143                               do:
     1144                                   hh:load-image("cmp/b-hist.bmp":u) .
     1145                                   hh:TOOLTIP = "История" .
     1146                                   v-h[ii] = hh:handle .
     1147                                   ii = ii + 1 .
     1148                                   hh:width-chars = 3 .
     1149                               end.
     1150                           when "b-sch" then
     1151                               do:
     1152                                   hh:load-image("cmp/b-sch.bmp":u) .
     1153                                   hh:TOOLTIP = "Установка Фильтра" .
     1154                                   v-h[ii] = hh:handle .
     1155                                   ii = ii + 1 .
     1156                                   hh:width-chars = 3 .
     1157                               end.
     1158                           when "b-hist-user" then
     1159                               do:
     1160                                   hh:load-image("cmp/b-hist.bmp":u) .
     1161                                   hh:TOOLTIP = "История пользователя" .
     1162                                   ii = ii + 1 .
     1163                               end.
     1164                       end case.
     1165                   end.
     1166                   hh = hh:next-sibling.
     1167               end.
     1168               b-help:column = v-frame-width - b-help:width-chars.
     1169               jj = 0.
     1170               repeat ii = 4 to 1 by -1 :
     1171                   if valid-handle (v-h[ii] ) then
     1172                   do:
     1173                       jj  = jj + 1 .
     1174                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1175                       v-h[ii]:row    = v-help-old-y .
     1176                   end.
     1177               end.
     1178           end.
     1179       end.
     1180   end procedure.
     1181   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1182   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1183   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1184   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1185   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1186   define variable v-diasize-current-frame-height as decimal   no-undo .
     1187   define variable v-diasize-change-size          as logical   no-undo .
     1188   define variable v-diasize-resize-button        as handle    no-undo .
     1189   define variable v-diasize-wndmax               as logical   no-undo .
     1190   define variable v-diasize-wndstore             as logical   no-undo .
     1191   define variable v-diasize-proc-name            as character no-undo .
     1192   define variable v-diasize-browse-handle        as handle    no-undo .
     1193   define variable v-diasize-browse-number        as integer   no-undo .
     1194   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1195   define temp-table temp-diasize-handle no-undo
     1196     field handle-value  as handle
     1197     field save-position as decimal
     1198     index xpk is primary unique handle-value
     1199     .
     1200   define temp-table temp-browse-handle no-undo
     1201     field browse-type   as character
     1202     field browse-number as integer
     1203     field browse-handle as handle
     1204     field original-size as decimal
     1205     index xpk is primary unique browse-type browse-number
     1206     index xie browse-type browse-handle
     1207   .
     1208   procedure diasize_change-height :
     1209     define input  parameter p-change-value  as decimal   no-undo .
     1210     define input  parameter p-move-resize   as logical   no-undo .
     1211     define variable v-field-group-handle    as handle    no-undo .
     1212     define variable v-object-handle         as handle    no-undo .
     1213     define variable v-frame-height          as decimal   no-undo .
     1214     define variable v-frame-virtual-height  as decimal   no-undo .
     1215     define variable v-browse-height         as decimal   no-undo .
     1216     define variable v-window-height         as decimal   no-undo .
     1217     define variable v-window-virtual-height as decimal   no-undo .
     1218     define variable v-change-sign           as integer   no-undo .
     1219     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1220     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1221     if p-change-value > 0
     1222     then do:
     1223       if frame f-c-p :height + p-change-value
     1224           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1225       then do:
     1226         assign
     1227           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1228                           - (frame f-c-p :height-chars)
     1229         .
     1230         if p-change-value <= 0
     1231         then do:
     1232           run diasize_position-resize-button in this-procedure .
     1233           return .
     1234         end.
     1235       end.
     1236     end.
     1237     if p-change-value < 0
     1238     then do:
     1239       if frame f-c-p :height + p-change-value < v-diasize-orig-frame-height
     1240       then do:
     1241         assign
     1242           p-change-value = v-diasize-orig-frame-height
     1243                          - (frame f-c-p :height-chars)
     1244         .
     1245         if p-change-value >= 0
     1246         then do:
     1247           run diasize_position-resize-button in this-procedure .
     1248           return .
     1249         end.
     1250       end.
     1251     end.
     1252     if p-change-value >= 0
     1253     then do:
     1254       assign
     1255         v-change-sign = 1
     1256       .
     1257     end.
     1258     else do:
     1259       assign
     1260         v-change-sign = -1
     1261       .
     1262     end.
     1263     assign
     1264       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1265     .
     1266     if p-change-value = 0
     1267     then do:
     1268       run diasize_position-resize-button in this-procedure .
     1269       return .
     1270     end.
     1271     move_block:
     1272     do
     1273     on error undo move_block, retry move_block
     1274     :
     1275       if retry
     1276       then do:
     1277         do
     1278         on error undo move_block, leave move_block
     1279         :
     1280           if p-change-value > 0
     1281           then do:
     1282             for each buf_temp-diasize-handle
     1283             on error undo, next
     1284             :
     1285               assign
     1286                 v-object-handle = buf_temp-diasize-handle.handle-value
     1287               .
     1288               if v-object-handle <> v-diasize-resize-button
     1289               then do:
     1290                 assign
     1291                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1292                 .
     1293               end.
     1294             end.
     1295             assign
     1296               v-diasize-browse-handle :height = v-browse-height
     1297             .
     1298             for each buf_temp-browse-handle
     1299               where buf_temp-browse-handle.browse-type = 'height':u
     1300             on error undo, next
     1301             :
     1302               assign
     1303                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1304               .
     1305             end.
     1306             assign
     1307               frame f-c-p :height = v-frame-height
     1308             .
     1309             if frame f-c-p :scrollable = true
     1310             then do:
     1311               assign
     1312                 frame f-c-p :virtual-height = v-frame-virtual-height
     1313               .
     1314             end.
     1315             run diasize_position-resize-button in this-procedure .
     1316           end.
     1317           else do:
     1318             if frame f-c-p :scrollable = true
     1319             then do:
     1320               assign
     1321                 frame f-c-p :virtual-height = v-frame-virtual-height
     1322               .
     1323             end.
     1324             assign
     1325               frame f-c-p :height = v-frame-height
     1326             .
     1327             assign
     1328               v-diasize-browse-handle :height = v-browse-height
     1329             .
     1330             for each buf_temp-browse-handle
     1331               where buf_temp-browse-handle.browse-type = 'height':u
     1332             on error undo, next
     1333             :
     1334               assign
     1335                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1336               .
     1337             end.
     1338             for each buf_temp-diasize-handle
     1339             on error undo, next
     1340             :
     1341               assign
     1342                 v-object-handle = buf_temp-diasize-handle.handle-value
     1343               .
     1344               if v-object-handle <> v-diasize-resize-button
     1345               then do:
     1346                 assign
     1347                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1348                 .
     1349               end.
     1350             end.
     1351             run diasize_position-resize-button in this-procedure .
     1352           end.
     1353           assign
     1354             v-diasize-change-size = false
     1355           .
     1356           leave move_block .
     1357         end.
     1358       end.
     1359       assign
     1360         v-diasize-need-full-display = true
     1361       .
     1362       if v-diasize-change-size = false
     1363       then do:
     1364         assign
     1365           v-diasize-change-size = true
     1366         .
     1367       end.
     1368       else do:
     1369         return .
     1370       end.
     1371       assign
     1372         v-frame-height = frame f-c-p :height
     1373         v-frame-virtual-height = frame f-c-p :virtual-height
     1374         v-browse-height = v-diasize-browse-handle :height
     1375       .
     1376       for each buf_temp-browse-handle
     1377         where buf_temp-browse-handle.browse-type = 'height':u
     1378       :
     1379         assign
     1380           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1381         .
     1382       end.
     1383       for each buf_temp-diasize-handle
     1384       :
     1385         delete buf_temp-diasize-handle .
     1386       end.
     1387       assign
     1388         v-field-group-handle = frame f-c-p :first-child
     1389       .
     1390       do while valid-handle(v-field-group-handle)
     1391       :
     1392         assign
     1393           v-object-handle = v-field-group-handle :first-child
     1394         .
     1395         do while valid-handle(v-object-handle)
     1396         :
     1397           if  v-object-handle <> v-diasize-browse-handle :handle
     1398           and can-query(v-object-handle, "row")
     1399           and can-query(v-object-handle, "height")
     1400           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1401           then do:
     1402             find first buf_temp-browse-handle
     1403               where buf_temp-browse-handle.browse-type   = 'height':u
     1404                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1405               no-error .
     1406             if available buf_temp-browse-handle
     1407             then do:
     1408             end.
     1409             else do:
     1410               create buf_temp-diasize-handle .
     1411               assign
     1412                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1413                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1414               .
     1415             end.
     1416           end.
     1417           assign
     1418             v-object-handle = v-object-handle :next-sibling
     1419           .
     1420         end.
     1421         assign
     1422           v-field-group-handle = v-field-group-handle :next-sibling
     1423         .
     1424       end.
     1425       do with frame f-c-p
     1426       :
     1427         hide v-diasize-resize-button .
     1428         assign
     1429           v-diasize-resize-button :row    = 1
     1430           v-diasize-resize-button :column = 1
     1431         .
     1432       end.
     1433       if p-change-value > 0
     1434       then do:
     1435         if frame f-c-p :scrollable = true
     1436         then do:
     1437           assign
     1438             frame f-c-p :virtual-height = frame f-c-p :virtual-height + p-change-value
     1439             no-error .
     1440           if error-status :error
     1441           or error-status :get-message(1) <> ""
     1442           then do:
     1443             undo move_block, retry move_block .
     1444           end.
     1445         end.
     1446         assign
     1447           frame f-c-p :height = frame f-c-p :height + p-change-value
     1448           no-error .
     1449         if error-status :error
     1450         or error-status :get-message(1) <> ""
     1451         then do:
     1452           undo move_block, retry move_block .
     1453         end.
     1454         assign
     1455           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1456           no-error .
     1457         if error-status :error
     1458         or error-status :get-message(1) <> ""
     1459         then do:
     1460           undo move_block, retry move_block .
     1461         end.
     1462         for each buf_temp-browse-handle
     1463           where buf_temp-browse-handle.browse-type = 'height':u
     1464         on error undo move_block, retry move_block
     1465         :
     1466           assign
     1467             buf_temp-browse-handle.browse-handle :height
     1468               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1469             no-error .
     1470           if error-status :error
     1471           or error-status :get-message(1) <> ""
     1472           then do:
     1473             undo move_block, retry move_block .
     1474           end.
     1475         end.
     1476         for each buf_temp-diasize-handle
     1477         on error undo move_block, retry move_block
     1478         :
     1479           assign
     1480             v-object-handle = buf_temp-diasize-handle.handle-value
     1481           .
     1482           if v-object-handle <> v-diasize-resize-button
     1483           then do:
     1484             assign
     1485               v-object-handle :row = v-object-handle :row + p-change-value
     1486               no-error .
     1487             if error-status :error
     1488             or error-status :get-message(1) <> ""
     1489             then do:
     1490               undo move_block, retry move_block .
     1491             end.
     1492           end.
     1493         end.
     1494       end.
     1495       else do:
     1496         for each buf_temp-diasize-handle
     1497         on error undo move_block, retry move_block
     1498         :
     1499           assign
     1500             v-object-handle = buf_temp-diasize-handle.handle-value
     1501           .
     1502           if v-object-handle <> v-diasize-resize-button
     1503           then do:
     1504             assign
     1505               v-object-handle :row = v-object-handle :row + p-change-value
     1506               no-error .
     1507             if error-status :error
     1508             or error-status :get-message(1) <> ""
     1509             then do:
     1510               undo move_block, retry move_block .
     1511             end.
     1512           end.
     1513         end.
     1514         assign
     1515           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1516           no-error .
     1517         if error-status :error
     1518         or error-status :get-message(1) <> ""
     1519         then do:
     1520           undo move_block, retry move_block .
     1521         end.
     1522         for each buf_temp-browse-handle
     1523           where buf_temp-browse-handle.browse-type = 'height':u
     1524         on error undo move_block, retry move_block
     1525         :
     1526           assign
     1527             buf_temp-browse-handle.browse-handle :height
     1528               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1529             no-error .
     1530           if error-status :error
     1531           or error-status :get-message(1) <> ""
     1532           then do:
     1533             undo move_block, retry move_block .
     1534           end.
     1535         end.
     1536         assign
     1537           frame f-c-p :height = frame f-c-p :height + p-change-value
     1538           no-error .
     1539         if error-status :error
     1540         or error-status :get-message(1) <> ""
     1541         then do:
     1542           undo move_block, retry move_block .
     1543         end.
     1544         if frame f-c-p :scrollable = true
     1545         then do:
     1546           assign
     1547             frame f-c-p :virtual-height = frame f-c-p :virtual-height + p-change-value
     1548             no-error .
     1549           if error-status :error
     1550           or error-status :get-message(1) <> ""
     1551           then do:
     1552             undo move_block, retry move_block .
     1553           end.
     1554         end.
     1555       end.
     1556       if p-move-resize = true
     1557       then do:
     1558         run diasize_position-resize-button in this-procedure .
     1559       end.
     1560       if v-diasize-wndstore = true
     1561       then do:
     1562         if connected("ub") = true
     1563         then do:
     1564           define variable v-cntxt-db-num        as integer   no-undo .
     1565           define variable v-cntxt-userid        as character no-undo .
     1566           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1567                                             , OUTPUT v-cntxt-userid
     1568                                             ) .
     1569           run gbl/wndsizew.p
     1570             (input  v-cntxt-db-num
     1571             ,input  v-cntxt-userid
     1572             ,input  v-diasize-proc-name
     1573             ,input  'height':u
     1574             ,input  string(frame f-c-p :height - v-diasize-orig-frame-height)
     1575             ) .
     1576         end.
     1577       end.
     1578     end.
     1579     assign
     1580       v-diasize-change-size = false
     1581     .
     1582   end procedure.
     1583   procedure diasize_set-height :
     1584     define input  parameter p-new-height  as decimal   no-undo .
     1585     define input  parameter p-move-resize as logical   no-undo .
     1586     do
     1587     on error undo, return error return-value
     1588     :
     1589       run diasize_change-height in this-procedure
     1590         (input  (p-new-height - frame f-c-p :height)
     1591         ,input  p-move-resize
     1592         ) .
     1593     end.
     1594   end procedure.
     1595   procedure diasize_change-width :
     1596     define input  parameter p-change-value as decimal   no-undo .
     1597     define input  parameter p-move-resize  as logical   no-undo .
     1598     define variable v-field-group-handle   as handle    no-undo .
     1599     define variable v-object-handle        as handle    no-undo .
     1600     define variable v-frame-width          as decimal   no-undo .
     1601     define variable v-frame-virtual-width  as decimal   no-undo .
     1602     define variable v-browse-width         as decimal   no-undo .
     1603     define variable v-window-width         as decimal   no-undo .
     1604     define variable v-window-virtual-width as decimal   no-undo .
     1605     define variable v-change-sign          as integer   no-undo .
     1606     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1607     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1608     if p-change-value > 0
     1609     then do:
     1610       if frame f-c-p :width + p-change-value >
     1611           session :width-chars
     1612       then do:
     1613         assign
     1614           p-change-value = session :width-chars - frame f-c-p :width
     1615         .
     1616         if p-change-value <= 0
     1617         then do:
     1618           run diasize_position-resize-button in this-procedure .
     1619           return .
     1620         end.
     1621       end.
     1622     end.
     1623     if p-change-value < 0
     1624     then do:
     1625       if frame f-c-p :width + p-change-value < v-diasize-orig-frame-width
     1626       then do:
     1627         assign
     1628           p-change-value = v-diasize-orig-frame-width
     1629                          - frame f-c-p :width
     1630         .
     1631         if p-change-value >= 0
     1632         then do:
     1633           run diasize_position-resize-button in this-procedure .
     1634           return .
     1635         end.
     1636       end.
     1637     end.
     1638     if p-change-value >= 0
     1639     then do:
     1640       assign
     1641         v-change-sign = 1
     1642       .
     1643     end.
     1644     else do:
     1645       assign
     1646         v-change-sign = -1
     1647       .
     1648     end.
     1649     assign
     1650       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1651     .
     1652     if p-change-value = 0
     1653     then do:
     1654       run diasize_position-resize-button in this-procedure .
     1655       return .
     1656     end.
     1657     move_block:
     1658     do
     1659     on error undo move_block, leave move_block
     1660     :
     1661       if retry
     1662       then do:
     1663         do
     1664         on error undo move_block, leave move_block
     1665         :
     1666           if p-change-value > 0
     1667           then do:
     1668             for each buf_temp-diasize-handle
     1669             on error undo, next
     1670             :
     1671               assign
     1672                 v-object-handle = buf_temp-diasize-handle.handle-value
     1673               .
     1674               if v-object-handle <> v-diasize-resize-button
     1675               then do:
     1676                 assign
     1677                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1678                 .
     1679               end.
     1680             end.
     1681             assign
     1682               v-diasize-browse-handle :width = v-browse-width
     1683             .
     1684             for each buf_temp-browse-handle
     1685               where buf_temp-browse-handle.browse-type = 'width':u
     1686             on error undo, next
     1687             :
     1688               assign
     1689                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1690               .
     1691             end.
     1692             assign
     1693               frame f-c-p :width = v-frame-width
     1694             .
     1695             if frame f-c-p :scrollable = true
     1696             then do:
     1697               assign
     1698                 frame f-c-p :virtual-width = v-frame-virtual-width
     1699               .
     1700             end.
     1701             run diasize_position-resize-button in this-procedure .
     1702           end.
     1703           else do:
     1704             if frame f-c-p :scrollable = true
     1705             then do:
     1706               assign
     1707                 frame f-c-p :virtual-width = v-frame-virtual-width
     1708               .
     1709             end.
     1710             assign
     1711               frame f-c-p :width = v-frame-width
     1712             .
     1713             for each buf_temp-browse-handle
     1714               where buf_temp-browse-handle.browse-type = 'width':u
     1715             on error undo, next
     1716             :
     1717               assign
     1718                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1719               .
     1720             end.
     1721             assign
     1722               v-diasize-browse-handle :width = v-browse-width
     1723             .
     1724             for each buf_temp-diasize-handle
     1725             on error undo, next
     1726             :
     1727               assign
     1728                 v-object-handle = buf_temp-diasize-handle.handle-value
     1729               .
     1730               if v-object-handle <> v-diasize-resize-button
     1731               then do:
     1732                 assign
     1733                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1734                 .
     1735               end.
     1736             end.
     1737             run diasize_position-resize-button in this-procedure .
     1738           end.
     1739           assign
     1740             v-diasize-change-size = false
     1741           .
     1742           leave move_block .
     1743         end.
     1744       end.
     1745       assign
     1746         v-diasize-need-full-display = true
     1747       .
     1748       if v-diasize-change-size = false
     1749       then do:
     1750         assign
     1751           v-diasize-change-size = true
     1752         .
     1753       end.
     1754       else do:
     1755         return .
     1756       end.
     1757       assign
     1758         v-frame-width = frame f-c-p :width
     1759         v-frame-virtual-width = frame f-c-p :virtual-width
     1760         v-browse-width = v-diasize-browse-handle :width
     1761       .
     1762       for each buf_temp-browse-handle
     1763         where buf_temp-browse-handle.browse-type = 'width':u
     1764       :
     1765         assign
     1766           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1767         .
     1768       end.
     1769       for each buf_temp-diasize-handle
     1770       :
     1771         delete buf_temp-diasize-handle .
     1772       end.
     1773       assign
     1774         v-field-group-handle = frame f-c-p :first-child
     1775       .
     1776       do while valid-handle(v-field-group-handle)
     1777       :
     1778         assign
     1779           v-object-handle = v-field-group-handle :first-child
     1780         .
     1781         do while valid-handle(v-object-handle)
     1782         :
     1783           if  v-object-handle <> v-diasize-browse-handle :handle
     1784           and v-object-handle <> v-diasize-resize-button
     1785           and can-query(v-object-handle, "row")
     1786           and can-query(v-object-handle, "height")
     1787           and ( v-object-handle :col + v-object-handle :width
     1788                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1789               )
     1790           then do:
     1791             find first buf_temp-browse-handle
     1792               where buf_temp-browse-handle.browse-type   = 'width':u
     1793                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1794               no-error .
     1795             if available buf_temp-browse-handle
     1796             then do:
     1797             end.
     1798             else do:
     1799               create buf_temp-diasize-handle .
     1800               assign
     1801                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1802                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1803               .
     1804             end.
     1805           end.
     1806           assign
     1807             v-object-handle = v-object-handle :next-sibling
     1808           .
     1809         end.
     1810         assign
     1811           v-field-group-handle = v-field-group-handle :next-sibling
     1812         .
     1813       end.
     1814       do with frame f-c-p
     1815       :
     1816         hide v-diasize-resize-button .
     1817         v-diasize-resize-button :row = 1.
     1818         v-diasize-resize-button :column = 1.
     1819       end.
     1820       if p-change-value > 0
     1821       then do:
     1822         if frame f-c-p :scrollable = true
     1823         then do:
     1824           assign
     1825             frame f-c-p :virtual-width = frame f-c-p :virtual-width + p-change-value
     1826             no-error .
     1827           if error-status :error
     1828           or error-status :get-message(1) <> ""
     1829           then do:
     1830             undo move_block, retry move_block.
     1831           end.
     1832         end.
     1833         assign
     1834           frame f-c-p :width = v-frame-width + p-change-value
     1835           no-error .
     1836         if error-status :error
     1837         or error-status :get-message(1) <> ""
     1838         then do:
     1839           undo move_block, retry move_block.
     1840         end.
     1841         assign
     1842           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1843         no-error .
     1844         if error-status :error
     1845         or error-status :get-message(1) <> ""
     1846         then do:
     1847           undo move_block, retry move_block.
     1848         end.
     1849         for each buf_temp-browse-handle
     1850           where buf_temp-browse-handle.browse-type = 'width':u
     1851         on error undo move_block, retry move_block
     1852         :
     1853           assign
     1854             buf_temp-browse-handle.browse-handle :width
     1855               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1856             no-error .
     1857           if error-status :error
     1858           or error-status :get-message(1) <> ""
     1859           then do:
     1860             undo move_block, retry move_block .
     1861           end.
     1862         end.
     1863         for each buf_temp-diasize-handle
     1864         on error undo move_block, retry move_block
     1865         :
     1866           assign
     1867             v-object-handle = buf_temp-diasize-handle.handle-value
     1868           .
     1869           if v-object-handle <> v-diasize-resize-button
     1870           then do:
     1871             assign
     1872               v-object-handle :col = v-object-handle :col + p-change-value
     1873               no-error .
     1874             if error-status :error
     1875             or error-status :get-message(1) <> ""
     1876             then do:
     1877               undo move_block, retry move_block .
     1878             end.
     1879           end.
     1880         end.
     1881       end.
     1882       else do:
     1883         for each buf_temp-diasize-handle
     1884         on error undo move_block, retry move_block
     1885         :
     1886           assign
     1887             v-object-handle = buf_temp-diasize-handle.handle-value
     1888           .
     1889           if v-object-handle <> v-diasize-resize-button
     1890           then do:
     1891             assign
     1892               v-object-handle :col = v-object-handle :col + p-change-value
     1893               no-error .
     1894             if error-status :error
     1895             or error-status :get-message(1) <> ""
     1896             then do:
     1897               undo move_block, retry move_block .
     1898             end.
     1899           end.
     1900         end.
     1901         for each buf_temp-browse-handle
     1902           where buf_temp-browse-handle.browse-type = 'width':u
     1903         on error undo move_block, retry move_block
     1904         :
     1905           assign
     1906             buf_temp-browse-handle.browse-handle :width
     1907               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1908             no-error .
     1909           if error-status :error
     1910           or error-status :get-message(1) <> ""
     1911           then do:
     1912             undo move_block, retry move_block .
     1913           end.
     1914         end.
     1915         assign
     1916           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1917           no-error .
     1918         if error-status :error
     1919         or error-status :get-message(1) <> ""
     1920         then do:
     1921           undo move_block, retry move_block.
     1922         end.
     1923         assign
     1924           frame f-c-p :width = frame f-c-p :width + p-change-value
     1925         no-error .
     1926         if error-status :error
     1927         or error-status :get-message(1) <> ""
     1928         then do:
     1929           undo move_block, retry move_block.
     1930         end.
     1931         if frame f-c-p :scrollable = true
     1932         then do:
     1933           assign
     1934             frame f-c-p :virtual-width = frame f-c-p :virtual-width + p-change-value
     1935           no-error .
     1936           if error-status :error
     1937           or error-status :get-message(1) <> ""
     1938           then do:
     1939             undo move_block, retry move_block.
     1940           end.
     1941         end.
     1942       end.
     1943       if p-move-resize
     1944       then do:
     1945         run diasize_position-resize-button in this-procedure .
     1946       end.
     1947       if v-diasize-wndstore = true
     1948       then do:
     1949         if connected("ub") = true
     1950         then do:
     1951           define variable v-cntxt-db-num        as integer   no-undo .
     1952           define variable v-cntxt-userid        as character no-undo .
     1953           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1954                                             , OUTPUT v-cntxt-userid
     1955                                             ) .
     1956           run gbl/wndsizew.p
     1957             (input  v-cntxt-db-num
     1958             ,input  v-cntxt-userid
     1959             ,input  v-diasize-proc-name
     1960             ,input  'width':u
     1961             ,input  string(frame f-c-p :width - v-diasize-orig-frame-width)
     1962             ) .
     1963         end.
     1964       end.
     1965     end.
     1966     assign
     1967       v-diasize-change-size = false
     1968     .
     1969   end procedure.
     1970   procedure diasize_set-width :
     1971     define input  parameter p-new-width  as decimal   no-undo .
     1972     define input  parameter p-move-resize as logical   no-undo .
     1973     do
     1974     on error undo, return error return-value
     1975     :
     1976       run diasize_change-width in this-procedure
     1977         (input  (p-new-width - frame f-c-p :width)
     1978         ,input  p-move-resize
     1979         ) .
     1980     end.
     1981   end procedure.
     1982   procedure diasize_position-resize-button :
     1983     do with frame f-c-p
     1984     :
     1985       hide v-diasize-resize-button .
     1986       assign
     1987         v-diasize-resize-button :row = frame f-c-p :height - v-diasize-resize-button :height
     1988                     - 1
     1989                     - (frame f-c-p :border-bottom-pixels / session :pixels-per-row)
     1990         v-diasize-resize-button :col = frame f-c-p :width - v-diasize-resize-button :width
     1991                     - 1
     1992                     - (frame f-c-p :border-right-pixels / session :pixels-per-column)
     1993       .
     1994       view v-diasize-resize-button .
     1995     end.
     1996   end procedure.
     1997   on alt-right anywhere
     1998   do:
     1999     run diasize_change-width in this-procedure
     2000       (input 1
     2001       ,input true
     2002       ) .
     2003     return no-apply .
     2004   end.
     2005   on alt-left anywhere
     2006   do:
     2007     run diasize_change-width in this-procedure
     2008       (input -1
     2009       ,input true
     2010       ) .
     2011     return no-apply .
     2012   end.
     2013   on alt-down anywhere
     2014   do:
     2015     run diasize_change-height in this-procedure
     2016       (input 1
     2017       ,input true
     2018       ) .
     2019     return no-apply .
     2020   end.
     2021   on alt-up anywhere
     2022   do:
     2023     run diasize_change-height in this-procedure
     2024       (input -1
     2025       ,input true
     2026       ) .
     2027     return no-apply .
     2028   end.
     2029   on alt-enter of frame f-c-p
     2030   do:
     2031     run diasize_maximize in this-procedure
     2032       (input  ?
     2033       ).
     2034     return no-apply .
     2035   end.
     2036   procedure diasize_end-move :
     2037     do
     2038     on error undo, return error return-value
     2039     :
     2040       define variable v-row-delta as decimal   no-undo .
     2041       define variable v-col-delta as decimal   no-undo .
     2042       define variable v-new-row as decimal   no-undo .
     2043       define variable v-new-col as decimal   no-undo .
     2044       assign
     2045         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2046         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2047       .
     2048       assign
     2049         v-row-delta = v-new-row - frame f-c-p :height
     2050         v-col-delta = v-new-col - frame f-c-p :width
     2051       .
     2052       run diasize_change-height in this-procedure
     2053         (input v-row-delta
     2054         ,input true
     2055         ) .
     2056       run diasize_change-width in this-procedure
     2057         (input v-col-delta
     2058         ,input true
     2059         ) .
     2060     end.
     2061   end procedure.
     2062   procedure diasize_maximize :
     2063     define input  parameter p-action as logical   no-undo .
     2064     do
     2065     on error undo, return error return-value
     2066     :
     2067       if p-action = ?
     2068       then do:
     2069         if v-diasize-need-maximize = true
     2070         then do:
     2071           assign
     2072             p-action = true
     2073           .
     2074         end.
     2075         else do:
     2076           assign
     2077             p-action = false
     2078           .
     2079         end.
     2080       end.
     2081       if p-action = true
     2082       then do:
     2083         run diasize_change-height in this-procedure
     2084           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2085               - frame f-c-p :height-chars
     2086           ,input true
     2087           ) .
     2088         run diasize_change-width in this-procedure
     2089           (input session :width-chars
     2090               - frame f-c-p :width-chars
     2091           ,input true
     2092           ) .
     2093         assign
     2094           v-diasize-need-maximize = false
     2095         .
     2096       end.
     2097       else do:
     2098         run diasize_change-width in this-procedure
     2099           (input v-diasize-orig-frame-width
     2100               - frame f-c-p :width-chars
     2101           ,input true
     2102           ) .
     2103         run diasize_change-height in this-procedure
     2104           (input v-diasize-orig-frame-height
     2105               - frame f-c-p :height-chars
     2106           ,input true
     2107           ) .
     2108         assign
     2109           v-diasize-need-maximize = true
     2110         .
     2111       end.
     2112     end.
     2113   end procedure.
     2114   procedure diasize_restore-orig-size :
     2115     do
     2116     on error undo, return error return-value
     2117     :
     2118       assign
     2119         v-diasize-current-frame-width  = frame f-c-p :width
     2120         v-diasize-current-frame-height = frame f-c-p :height
     2121       .
     2122       run diasize_set-height in this-procedure
     2123         (input  v-diasize-orig-frame-height
     2124         ,input  true
     2125         ) .
     2126       run diasize_set-width in this-procedure
     2127         (input  v-diasize-orig-frame-width
     2128         ,input  true
     2129         ) .
     2130     end.
     2131   end procedure.
     2132   procedure diasize_restore-current-size :
     2133     do
     2134     on error undo, return error return-value
     2135     :
     2136       run diasize_set-height in this-procedure
     2137         (input  v-diasize-current-frame-height
     2138         ,input  true
     2139         ) .
     2140       run diasize_set-width in this-procedure
     2141         (input  v-diasize-current-frame-width
     2142         ,input  true
     2143         ) .
     2144     end.
     2145   end procedure.
     2146   procedure diasize_set-browse-handle :
     2147     define input  parameter p-browse-handle as handle   no-undo .
     2148     define buffer buf_temp-browse-handle for temp-browse-handle .
     2149     do
     2150     on error undo, return error return-value
     2151     :
     2152       assign
     2153         v-diasize-browse-handle = p-browse-handle
     2154       .
     2155       for each buf_temp-browse-handle
     2156       on error undo, return error return-value
     2157       :
     2158         delete buf_temp-browse-handle .
     2159       end.
     2160     end.
     2161   end procedure.
     2162   procedure diasize_add_browse :
     2163     define input  parameter p-browse-type   as character no-undo .
     2164     define input  parameter p-browse-handle as handle    no-undo .
     2165     define buffer buf_temp-browse-handle for temp-browse-handle .
     2166     do
     2167     on error undo, return error return-value
     2168     :
     2169       assign
     2170         v-diasize-browse-number = v-diasize-browse-number + 1
     2171       .
     2172       create buf_temp-browse-handle .
     2173       assign
     2174         buf_temp-browse-handle.browse-type   = p-browse-type
     2175         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2176         buf_temp-browse-handle.browse-handle = p-browse-handle
     2177       .
     2178     end.
     2179   end procedure.
     2180   procedure diasize_init :
     2181     define variable v-default-value    as logical   no-undo .
     2182     define variable v-restore-saved    as logical   no-undo .
     2183     define variable v-resize-value-str as character no-undo .
     2184     do
     2185     on error undo, return error return-value
     2186     :
     2187       do with frame f-c-p
     2188       :
     2189         assign
     2190           v-diasize-orig-frame-height = frame f-c-p :height
     2191           v-diasize-orig-frame-width  = frame f-c-p :width
     2192           v-diasize-browse-handle     = browse BROWSE-Code :handle
     2193         .
     2194         create button v-diasize-resize-button
     2195         assign
     2196           parent        = frame f-c-p :first-child
     2197           label         = "s"
     2198           height-pixels = 16
     2199           width-pixels  = 16
     2200           visible       = true
     2201           sensitive     = true
     2202           movable       = true
     2203           triggers:
     2204             on end-move persistent run diasize_end-move in this-procedure .
     2205           end triggers.
     2206         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2207         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2208         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2209         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2210         assign
     2211           v-diasize-wndmax = false
     2212         .
     2213         if connected("ub") = true
     2214         then do:
     2215           define variable v-cntxt-db-num        as integer   no-undo .
     2216           define variable v-cntxt-userid        as character no-undo .
     2217           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2218                                             , OUTPUT v-cntxt-userid
     2219                                             ) .
     2220           run gbl/wndpar_r.p
     2221             (input  v-cntxt-db-num
     2222             ,input  v-cntxt-userid
     2223             ,input  'wndmax':U
     2224             ,output v-diasize-wndmax
     2225             ,output v-default-value
     2226             ) .
     2227         end.
     2228         assign
     2229           v-diasize-wndstore = false
     2230         .
     2231         if connected("ub") = true
     2232         then do:
     2233           run gbl/wndpar_r.p
     2234             (input  v-cntxt-db-num
     2235             ,input  v-cntxt-userid
     2236             ,input  'wndstore':U
     2237             ,output v-diasize-wndstore
     2238             ,output v-default-value
     2239             ) .
     2240         end.
     2241         assign
     2242           v-diasize-proc-name = entry(1, program-name(2), '.')
     2243         .
     2244         if v-diasize-wndstore = true
     2245         then do:
     2246           assign
     2247             v-restore-saved = false
     2248           .
     2249           if connected("ub") = true
     2250           then do:
     2251             run gbl/wndsizer.p
     2252               (input  v-cntxt-db-num
     2253               ,input  v-cntxt-userid
     2254               ,input  v-diasize-proc-name
     2255               ,input  'height':u
     2256               ,output v-resize-value-str
     2257               ) .
     2258             if v-resize-value-str <> '':U
     2259             then do:
     2260               run diasize_change-height in this-procedure
     2261                 (input  integer(v-resize-value-str)
     2262                 ,input  true
     2263                 ) .
     2264               assign
     2265                 v-restore-saved = true
     2266               .
     2267             end.
     2268           end.
     2269           if connected("ub") = true
     2270           then do:
     2271             run gbl/wndsizer.p
     2272               (input  v-cntxt-db-num
     2273               ,input  v-cntxt-userid
     2274               ,input  v-diasize-proc-name
     2275               ,input  'width':u
     2276               ,output v-resize-value-str
     2277               ) .
     2278             if v-resize-value-str <> '':U
     2279             then do:
     2280               run diasize_change-width in this-procedure
     2281                 (input  integer(v-resize-value-str)
     2282                 ,input  true
     2283                 ) .
     2284               assign
     2285                 v-restore-saved = true
     2286               .
     2287             end.
     2288           end.
     2289           if v-restore-saved <> true
     2290           then do:
     2291             if v-diasize-wndmax = true
     2292             then do:
     2293               run diasize_maximize in this-procedure
     2294                 (input  true
     2295                 ) .
     2296             end.
     2297           end.
     2298         end.
     2299         else do:
     2300           if v-diasize-wndmax = true
     2301           then do:
     2302             run diasize_maximize in this-procedure
     2303               (input  true
     2304               ) .
     2305           end.
     2306         end.
     2307       end.
     2308     end.
     2309   end procedure.
     2310   procedure diasize_need-full-display :
     2311     define output parameter p-need-full-display as logical   no-undo .
     2312     do
     2313     on error undo, return error return-value
     2314     :
     2315       assign
     2316         p-need-full-display = v-diasize-need-full-display
     2317       .
     2318       assign
     2319         v-diasize-need-full-display = false
     2320       .
     2321     end.
     2322   end procedure.
     2323   procedure get-context :
     2324      define output parameter p-db-num as integer          no-undo.
     2325      define output parameter p-user-id as character        no-undo.
     2326      define variable v-login               as character    no-undo.
     2327      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2328      define buffer buf_user-login  for ub.user-login .
     2329      do
     2330      on error undo, return error
     2331      :
     2332            FIND FIRST buf_sys-ctrl no-lock.
     2333            ASSIGN
     2334               v-login = USERID("ub")
     2335               p-db-num = buf_sys-ctrl.db-num
     2336            .
     2337            FIND FIRST buf_user-login
     2338                 WHERE buf_user-login.db-num = p-db-num
     2339                   AND buf_user-login.user-login = v-login
     2340                 no-lock
     2341                 no-error
     2342                 .
     2343            IF AVAILABLE buf_user-login
     2344            THEN DO:
     2345               assign
     2346                  p-user-id = buf_user-login.user-id
     2347               .
     2348            END.
     2349      end.
     2350   end procedure.
     2351       run diasize_init in this-procedure .
     2352   on window-close of frame f-c-p
     2353      apply "END-ERROR":U to self.
     2354   MAIN-BLOCK:
     2355   do on error   undo MAIN-BLOCK, leave MAIN-BLOCK
     2356      on end-key undo MAIN-BLOCK, leave MAIN-BLOCK:
     2357      if imode eq 'ВЫБОР':U
     2358      then
     2359         run rid-rest no-error.
     2360   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2361     run mainmenu_getcntxt in parparentproc
     2362       (output v-cntxt-db-num
     2363       ,output v-cntxt-userid
     2364       ,output v-cntxt-level
     2365       ,output v-cntxt-host-code-obj
     2366       ,output v-cntxt-obj-type
     2367       ,output v-cntxt-obj-code
     2368       ,output v-cntxt-db-num-obj
     2369       ,output v-cntxt-is-admin
     2370       ) .
     2371   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2372   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
     2373     (output v-db-num
     2374     )  .
     2375      run enable_UI in this-procedure .
     2376      buf-Code.misc1         :visible in browse BROWSE-Code = available b2-code and num-entries (b2-code.parent,chr(4)) eq 1  .
     2377      buf-Code.codename      :visible in browse BROWSE-Code = entry(3,iparent,chr(4)) ne "2"  .
     2378      fselect                :visible in browse BROWSE-Code = imode eq 'ВЫБОР':U.
     2379      apply "ENTRY" to BROWSE-Code.
     2380      wait-for go of frame f-c-p focus BROWSE-Code.
     2381      if imode eq 'ВЫБОР':U
     2382      then
     2383         run rid-keep no-error.
     2384   end.
     2385   run disable_UI in this-procedure .
     2386   procedure disable_UI :
     2387      hide frame f-c-p.
     2388   end procedure.
     2389   procedure enable_UI :
     2390      enable
     2391         mSearch
     2392         BROWSE-Code
     2393         b-exit
     2394         b-sel
     2395         when iMode eq 'ВЫБОР':U
     2396         b-add
     2397         when iMode eq 'ИЗМЕНЕНИЕ':U and v-db-num = 0
     2398         b-del
     2399         when iMode eq 'ИЗМЕНЕНИЕ':U and v-db-num = 0
     2400         b-upd
     2401         when iMode eq 'ИЗМЕНЕНИЕ':U and v-db-num = 0
     2402         b-help
     2403         b-hist
     2404         with frame f-c-p.
     2405      b-hist:POPUP-MENU in frame f-c-p = menu POPUP-MENU-b-hist:HANDLE.
     2406      b-hist:MENU-MOUSE = 1.
     2407      fselect                :visible in browse BROWSE-Code = imode eq 'ВЫБОР':U.
     2408      OPEN QUERY BROWSE-Code FOR EACH buf-code       where buf-code.parent eq b2-code.parent + chr(4) + b2-code.code NO-LOCK by buf-code.code INDEXED-REPOSITION.
     2409   end procedure.
     2410   function getStatus returns character
     2411      ( imisc as char, istatus as int   ):
     2412      define buffer code for ub.code.
     2413      if istatus eq 1
     2414      then
     2415         return "Необязательный".
     2416      else
     2417         return "Обязательный".
     2418   end.
