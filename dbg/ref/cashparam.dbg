      911                   buf-code.parent,
      912                   buf-code.code,
      913                   parparentproc,
      914                   0,
      915                   "",
      916                   0,
      917                   "",
      918                   "one",
      919                   ?,
      920                   "",
      921                   "" ,
      922                   v-cntxt-db-num,
      923                   ?,
      924                   input-output v-rid-list ) .
      925      end.
      926   end.
      927   on choose of menu-item mHistChiled
      928   do:
      929      define variable v-rid-list as character no-undo.
      930      if avail buf-code then
      931      do:
      932         run ref/ccode.w (
      933                   buf-code.parent,
      934                   buf-code.code,
      935                   parparentproc,
      936                   0,
      937                   "",
      938                   0,
      939                   "",
      940                   "parentBeg",
      941                   ?,
      942                   "",
      943                   "" ,
      944                   v-cntxt-db-num,
      945                   ?,
      946                   input-output v-rid-list ) .
      947      end.
      948   end.
      949   on go of frame f-c-p
      950      do:
      951      end.
      952   on choose of b-add in frame f-c-p
      953      do:
      954         define buffer b-code   for code.
      955         define buffer btt-code for code.
      956         define variable vRec as recid   no-undo.
      957         ri = ?.
      958         run value(mProcEdit) (
      959            input parparentproc
      960            , input 'ДОБАВЛЕНИЕ':U
      961            , input b2-code.parent + chr(4) + b2-code.code
      962            , input-output ri).
      963         if ri <> ? then
      964         do:
      965            OPEN QUERY BROWSE-Code FOR EACH buf-code       where buf-code.parent eq b2-code.parent + chr(4) + b2-code.code NO-LOCK by buf-code.code INDEXED-REPOSITION.
      966            reposition BROWSE-Code to recid ri no-error.
      967            apply "ENTRY" to BROWSE-Code.
      968         end.
      969      end.
      970   on choose of b-del in frame f-c-p
      971      do:
      972         define buffer b-code for code.
      973         define variable v-ok       as logical no-undo.
      974         define variable recid-code as integer no-undo .
      975         if not avail buf-code then return.
      976         recid-code = recid(buf-code) .
      977         message "Удалить запись :" buf-code.code  "?"
      978            view-as alert-box question
      979            buttons yes-no
      980            title "Удаление"
      981            update v-ok .
      982         if not v-ok then return no-apply.
      983         do on error undo, return
      984      on stop undo, return:
      985            find first b-code of buf-code exclusive-lock no-wait no-error.
      986            if locked b-code then
      987            do:
      988               message
      989                  vss-workfile vss-revision vss-description skip
      990                  "Запись занята"
      991                  view-as alert-box error .
      992               undo, return.
      993            end.
      994            if not available b-code then
      995            do:
      996               message
      997                  vss-workfile vss-revision vss-description skip
      998                  "Не найдена запись"
      999                  view-as alert-box error .
     1000               undo, return.
     1001            end.
     1002            delete b-code.
     1003            OPEN QUERY BROWSE-Code FOR EACH buf-code       where buf-code.parent eq b2-code.parent + chr(4) + b2-code.code NO-LOCK by buf-code.code INDEXED-REPOSITION.
     1004            apply "ENTRY" to BROWSE-Code.
     1005         end.
     1006      end.
     1007   on mouse-select-dblclick of BROWSE-Code in frame f-c-p
     1008   or return of b-del in frame f-c-p
     1009   do:
     1010      if     iMode eq 'ИЗМЕНЕНИЕ':U
     1011             and v-db-num = 0
     1012         and available buf-code
     1013      then
     1014         apply "choose" to b-upd in frame f-c-p.
     1015   end.
     1016   on choose of b-sel in frame f-c-p
     1017      do:
     1018         if not avail buf-code then return.
     1019         setSelect(buffer buf-code:handle).
     1020       BROWSE-Code:refresh ().
     1021      end.
     1022   on choose of b-upd in frame f-c-p
     1023      do:
     1024         define buffer b-code   for code.
     1025         define buffer btt-code for code.
     1026         define variable vRec as recid no-undo.
     1027         if not avail buf-code then return.
     1028         find first b-code of buf-code no-lock no-error.
     1029         if not avail b-code then
     1030         do:
     1031            message
     1032               vss-workfile vss-revision vss-description skip
     1033               "Не найден параметр"
     1034               view-as alert-box error .
     1035            return no-apply.
     1036         end.
     1037         vRec = recid(b-code).
     1038         run value(mProcEdit) (
     1039            input parparentproc
     1040            , input 'ИЗМЕНЕНИЕ':U
     1041            , input b2-code.parent + chr(4) + b2-code.code
     1042            , input-output vRec).
     1043         OPEN QUERY BROWSE-Code FOR EACH buf-code       where buf-code.parent eq b2-code.parent + chr(4) + b2-code.code NO-LOCK by buf-code.code INDEXED-REPOSITION.
     1044         reposition BROWSE-Code to recid vRec no-error .
     1045         apply "ENTRY" to BROWSE-Code.
     1046      end.
     1047   on ENTER of mSearch in frame f-c-p
     1048   do:
     1049         define buffer buf-code-search for ub.code.
     1050      assign
     1051        msearch
     1052      .
     1053      define variable vRec as recid no-undo init ?.
     1054      block-code:
     1055      for each buf-code-search where (buf-code-search.parent eq b2-code.parent + chr(4) + b2-code.code and buf-code-search.code     begins msearch)
     1056                                 or (buf-code-search.parent eq b2-code.parent + chr(4) + b2-code.code and buf-code-search.CodeName begins msearch)
     1057      no-lock:
     1058         vRec = recid(buf-code-search).
     1059         leave block-code.
     1060      end.
     1061         if vRec eq ?
     1062      then do:
     1063         message "Запись не найдена"
     1064         view-as alert-box.
     1065      end.
     1066      else do:
     1067         OPEN QUERY BROWSE-Code FOR EACH buf-code       where buf-code.parent eq b2-code.parent + chr(4) + b2-code.code NO-LOCK by buf-code.code INDEXED-REPOSITION.
     1068         reposition BROWSE-Code to recid vRec no-error .
     1069         apply "ENTRY" to BROWSE-Code.
     1070      end.
     1071   end.
     1072   if valid-handle(active-window) and frame f-c-p:PARENT eq ?
     1073      then frame f-c-p:PARENT = active-window.
     1074   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1075   on help of frame f-c-p
     1076   do:
     1077     run gbl/app_help.p
     1078       (input this-procedure :file-name
     1079       ,input ''
     1080       ,input ?
     1081       ) no-error.
     1082     if error-status :error then do:
     1083       message
