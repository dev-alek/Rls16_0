        1   block-level on error undo, throw.
        2   define input parameter p-recid as recid no-undo.
        3   define input-output parameter p-status_ as character no-undo .
        4   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        5   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        6   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile: finbank2.p $":U .
        8   define variable vss-archive     as character no-undo init "$Archive: ref/finbank2.p $":U .
        9   define variable vss-description as character no-undo init "Изменение статуса БАНКА".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   DEFINE VARIABLE loc#log as logical no-undo .
       69   DEFINE BUFFER bf_fin-bank for ub.fin-bank.
       70   define buffer buf_fin-schet for ub.fin-schet.
       71   DEFINE VARIABLE choice as logical no-undo .
       72   DEFINE VARIABLE varold-status_ like ub.fin-bank.status_ no-undo .
       73   do
       74   on error undo, return error
       75   :
       76   FIND FIRST bf_fin-bank WHERE
       77              recid(bf_fin-bank) = p-recid No-ERROR.
       78   if not avail bf_fin-bank then return error.
       79   varold-status_ = bf_fin-bank.status_.
       80   if p-status_ = ?
       81   or p-status_ = "":U
       82   then do:
       83     CASE varold-status_:
       84       when 'тек':U then do:
       85         assign
       86         p-status_ = 'удал':U.
       87       end.
       88       when 'удал':U then do:
       89         assign
       90         p-status_ = 'тек':U.
       91       end.
       92     END CASE.
       93   end.
       94   for each buf_fin-schet exclusive-lock where
       95            buf_fin-schet.host-code = bf_fin-bank.host-code
       96        AND buf_fin-schet.code-bank = bf_fin-bank.code-bank
       97   on error undo, return error
       98   on stop undo, return error:
       99     if buf_fin-schet.status_ <> 'удал':U
      100     and bf_fin-bank.status_ = 'тек':U
      101     then do:
      102       message
      103       "У банка имеются счета в статусе" buf_fin-schet.status_ skip
      104       "Удаление невозможно"
      105       view-as alert-box error.
      106       undo, return error .
      107     end.
      108   end.
      109   _main:
      110   do
      111   on error undo, return error
      112   :
      113   CASE p-status_:
      114     WHEN 'тек':U then do:
      115       if 'тек':U = bf_fin-bank.status_  then do:
      116         message "БАНК уже имеет статус ТЕКУЩИЙ!"
      117         view-as alert-box ERROR.
      118         p-status_ = "".
      119         return error.
      120       end.
      121       else do:
      122         message
      123         "Восстановить удаленный банк?"
      124         view-as alert-box question buttons yES-NO  update choice.
      125         if choice then
      126         assign
      127         bf_fin-bank.status_ = 'тек':U .
      128         end.
      129     end.
      130     WHEN 'удал':U then do:
      131       choice = FALSE .
      132       message "Удалить банк Вы уверены?" skip
      133       view-as alert-box WARNING
      134       buttons OK-Cancel update choice .
      135       if choice then  do:
      136         bf_fin-bank.status_ = 'удал':U .
      137       end.
      138     end.
      139   END CASE.
      140   release bf_fin-bank no-error .
      141   if error-status:error then do:
      142     message
      143     "Ошибка при сохранении записи БАНК" skip
      144     error-status:get-message(1) skip
      145     return-value
      146     view-as alert-box error .
      147     undo _main, return error .
      148   end.
      149   p-status_ = "".
      150   end.
      151   end.
