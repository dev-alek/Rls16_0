     4902   end.
     4903   run adm/shattri.p (
     4904       input "get":U
     4905     ,input  p-obj-type
     4906     ,input  p-obj-code
     4907     ,input  'scale-inf':U
     4908     ,input  "":U
     4909     , output v-value-character
     4910     , output v-value-date
     4911     , output v-value-decimal
     4912     , output v-value-integer
     4913     , output v-value-logical
     4914     , output v-param-type
     4915     , INPUT-OUTPUT table-handle v-tth
     4916     ) no-error .
     4917   IF error-status:error then do:
     4918       message
     4919       substitute("Ошибка при получении настроек, необъодимых для работы весов НА ОБЪЕКТЕ &1&2:&3&4 &5"
     4920               , p-obj-type
     4921               , p-obj-code
     4922               , chr(10)
     4923               , error-status:get-message(1)
     4924               , return-value )
     4925       view-as alert-box error .
     4926       undo, return error .
     4927   end.
     4928   assign
     4929   ini-progs = ?
     4930   ini-types = ?
     4931   .
     4932   for each thbjattr_thbj-attr where
     4933           thbjattr_thbj-attr.obj-type = p-obj-type
     4934       and thbjattr_thbj-attr.obj-code = p-obj-code
     4935       and thbjattr_thbj-attr.upper-prop-code = 'scale-inf':U
     4936   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     4937   :
     4938     case thbjattr_thbj-attr.prop-code:
     4939       when 'scales-type':U then do:
     4940         ini-types = thbjattr_thbj-attr.property-value-character.
     4941       end.
     4942       when 'scales-pr':U then do:
     4943         ini-progs = thbjattr_thbj-attr.property-value-character.
     4944       end.
     4945     end case.
     4946   end.
     4947   if ini-types = ? then do:
     4948     run write-log-and-file in p-log-handle (
     4949             input 1
     4950           , input log-file-name
     4951           , input 1
     4952           , input substitute( "!!!Ошибка! Не определены типы весов&1" +
     4953                              "АРМ Администратор, Список фирм (Справочник магазинов), Измен. параметры, Параметры работы с весами"
     4954                              , chr(10)
     4955                             )
     4956                                             ).
     4957     assign
     4958     v-view-log = yes.
     4959     return error .
     4960   end.
     4961   if ini-progs = ? then do:
