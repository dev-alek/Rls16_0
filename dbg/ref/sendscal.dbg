     4870     ,input  '':u
     4871     ,input  '':u
     4872     ,input  '':u
     4873     ,input  no
     4874     ,output varscales-pref
     4875     ,output varscales-pref-type32
     4876     ) no-error .
     4877   if varscales-pref = ? then do:
