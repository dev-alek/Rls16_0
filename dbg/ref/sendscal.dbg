     4007           scale-prog = SEARCH("exe/curl.exe").
     4008           if scale-prog = ? then do:
     4009             undo _zz, return error substitute("Не найден файл программы работы с весами &1", "exe/curl.exe").
     4010           end.
     4011         end.
     4012         otherwise do:
     4013          scale-prog = SEARCH(scale-prog).
     4014          if scale-prog = ? then do:
     4015            undo _zz, return error substitute("Не найден файл программы работы с весами &1", string(" N " + string(t-scales.scales-num) + " - " + t-scales.scales-name + " тип " + t-scales.scales-type)).
     4016          end.
     4017        end.
     4018       end.
     4019       if SendOption <> "selective":U then do:
     4020         run gbl/return_.p .
     4021         RUN b-msend-proc in this-procedure (
     4022                          buffer t-scales
     4023                         ,input scale-prog
     4024                         ,input v-file-name
     4025                         ,input v-mode
     4026                         ,input (if sendoption begins "purge"
     4027                                 then "Очищаются весы "
     4028                                 else "Отправляются товары на весы ")
     4029                         ,output res
     4030                         ,output err-scl-num-list
     4031                         ,output err-codes-list
     4032                         ) no-error.
     4033          if error-status:error or res > 0 then do:
     4034            undo _zz, return error substitute("Ошибка при пересылке данных на весы &1 и/или подчиненные весы&2&3&2&4&2&5"
     4035                                            , string(" N " + string(t-scales.scales-num) + " - " + t-scales.scales-name)
     4036                                            , chr(10)
     4037                                            , error-status:get-message(1)
     4038                                            , return-value
     4039                                           , (if not error-status:error and res > 0
     4040                                             then substitute("!!!Программа передачи данных на весы &1 вернула ошибку(-и) с кодом(-ми) &2"
     4041                                                             ,err-scl-num-list
     4042                                                             ,err-codes-list
     4043                                                             )
     4044                                             else '':U)
     4045                                            ).
     4046         end.
     4047       end.
     4048       else do:
     4049         if goods-lst <> "" then do:
     4050           run gbl/return_.p .
     4051           RUN b-msend-proc in this-procedure (
     4052                            buffer t-scales
     4053                           ,input scale-prog
     4054                           ,input v-file-name
     4055                           ,input v-mode
     4056                           ,input "Отправляются товары на весы "
     4057                           ,output res
     4058                           ,output err-scl-num-list
     4059                           ,output err-codes-list
     4060                           ) no-error.
     4061           if error-status:error or res > 0 then do:
     4062             undo _zz, return error substitute("Ошибка при пересылке данных на весы &1 и/или подчиненные весы&2&3&2&4&2&5"
     4063                                             , string(" N " + string(t-scales.scales-num) + " - " + t-scales.scales-name)
     4064                                             , chr(10)
     4065                                             , error-status:get-message(1)
     4066                                             , return-value
     4067                                             , (if not error-status:error and res > 0
     4068                                               then substitute("!!!Программа передачи данных на весы &1 вернула ошибку(-и) с кодом(-ми) &2"
     4069                                                               ,err-scl-num-list
     4070                                                               ,err-codes-list
     4071                                                               )
     4072                                               else '':U)
     4073                                             ).
     4074           end.
     4075        end.
     4076       end.
     4077       if sendoption begins "purge" then do:
     4078         FIND b-scales WHERE recid( b-scales ) = recid( t-scales ) EXCLUSIVE.
     4079         CASE sendOption:
     4080           when "purge-ALL":U then do:
     4081             assign
     4082             b-scales.max-plu = 0
     4083             b-scales.tot-gds = 0
     4084             b-scales.to-send = FALSE
     4085             .
     4086           end.
     4087           when "purge-selective":U then do:
     4088             if NOT can-find( FIRST buf_scales-gds WHERE
     4089                                     buf_scales-gds.scales-num = t-scales.scales-num AND
     4090                                     buf_scales-gds.db-num = t-scales.db-num AND
     4091                                     buf_scales-gds.to-send = TRUE ) then do:
     4092                 b-scales.to-send = FALSE.
     4093             end.
     4094             FIND LAST buf_scales-gds NO-LOCK WHERE
     4095                       buf_scales-gds.scales-num = t-scales.scales-num
     4096                   and buf_scales-gds.db-num = t-scales.db-num
     4097                       use-index pi no-error.
     4098             if avail buf_scales-gds then
     4099             assign
     4100             b-scales.max-plu = buf_scales-gds.plu-code
     4101             b-scales.tot-gds = b-scales.tot-gds - gds-amount
     4102             .
     4103             else
     4104             assign
     4105             b-scales.max-plu = 0
     4106             b-scales.tot-gds = 0
     4107             .
     4108           end.
     4109         END CASE.
     4110       end.
     4111     END.
     4112     IF NOT Error-status:error
     4113     and res = 0
     4114     and not (sendoption begins "purge")
     4115     then do:
     4116       for each buf_gdsolist
     4117       break
     4118       by buf_gdsolist.obj-type
     4119       by buf_gdsolist.obj-code:
     4120   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4121   find gds-list
     4122     where gds-list.prod-type = buf_gdsolist.prod-type
     4123       and gds-list.prod-code = buf_gdsolist.prod-code
     4124       and gds-list.artic     = buf_gdsolist.artic
     4125     no-error .
     4126   if available gds-list then do:
     4127     assign
     4128       gds-list.to-del = no
     4129     .
     4130   end.
     4131   else do:
     4132     define variable v-last29 as integer no-undo .
     4133     find last gds-list use-index oi no-error.
     4134     if available gds-list then do:
     4135       v-last29 = gds-list.order-num .
     4136     end.
     4137     else do:
     4138       v-last29 = 0 .
     4139     end.
     4140     create gds-list .
     4141     buffer-copy buf_gdsolist to gds-list
     4142     assign
     4143       gds-list.to-del = no
     4144       gds-list.order-num = v-last29 + 1
     4145     .
     4146     assign
     4147       lns-cnt = lns-cnt + 1
     4148       line-rec = recid (gds-list)
     4149     .
     4150   end.
     4151         assign
     4152         gds-list.qnty = - 1.
     4153         if last-of(buf_gdsolist.obj-code) then do:
     4154           run write-counter in p-log-handle ('':U).
     4155           run set-title in p-log-handle (
     4156                 input substitute("Отправка весовых товаров на кассы &1&2", buf_gdsolist.obj-type, buf_GDSOLIST.OBJ-CODE)
     4157                                         ).
     4158           run str/send-gds.p (
     4159                           input parparentproc
     4160                         ,input p-parent-handle
     4161                         ,input p-log-handle
     4162                         ,input (string(buf_gdsolist.obj-code) + chr(4) + "yes":U)
     4163                         ) no-error .
     4164           if error-status:error then
     4165           return error substitute( "ошибка при отправке товаров на кассу по магазину &1&2&3&2&4"
     4166                                   , abs(buf_gdsolist.obj-code)
     4167                                   , chr(10)
     4168                                   , error-status:get-message(1)
     4169                                   , return-value
     4170                                   ).
     4171         end.
     4172       end.
     4173     end.
     4174     if sendoption begins "purge" then do:
     4175       run write-log-and-file in p-log-handle (
     4176             input 1
     4177           , input log-file-name
     4178           , input 1
     4179           , input substitute("Очистка завершена."
     4180                             )).
     4181     end.
     4182   END.
     4183   END PROCEDURE.
     4184   PROCEDURE add-del-gds:
     4185   DEFINE INPUT-OUTPUT PARAMETER ii as integer no-undo.
     4186   define input parameter p-dec-delim as character no-undo .
     4187   DEFINE PARAMETER buffer loc-scales for ub.scales.
     4188   define buffer buf_scales-gds for ub.scales-gds.
     4189   define buffer buf_goods for ub.goods.
     4190   define buffer buf_gds-obj-attr for ub.gds-obj-attr .
     4191   define buffer buf_bar-code for ub.bar-code.
     4192   define buffer buf_prod-bc for ub.prod-bc.
     4193   do
     4194   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     4195   :
     4196     CASE loc-scales.scales-type :
     4197       when "DIGI-SM" then do :
     4198         FOR EACH buf_scales-gds WHERE
     4199                 buf_scales-gds.scales-num = loc-scales.scales-num AND
     4200                 buf_scales-gds.db-num = loc-scales.db-num AND
     4201                 buf_scales-gds.to-del = yes,
     4202           FIRST buf_bar-code WHERE
     4203                 buf_bar-code.b-code = buf_scales-gds.b-code NO-LOCK,
     4204           FIRST buf_goods WHERE
     4205                 buf_goods.gds-code = buf_bar-code.gds-code NO-LOCK ,
     4206           FIRST buf_gds-obj-attr WHERE
     4207                 buf_gds-obj-attr.gds-code = buf_bar-code.gds-code AND
     4208                 buf_gds-obj-attr.attr-code = 'scales-code':U AND
     4209                 buf_gds-obj-attr.obj-type = buf_scales-gds.obj-type AND
     4210                 buf_gds-obj-attr.obj-code = buf_scales-gds.obj-code
     4211                 No-LOCK,
     4212           FIRST buf_prod-bc WHERE
     4213                 buf_prod-bc.b-str = buf_gds-obj-attr.attr-value NO-LOCK
     4214                 :
     4215           ii = ii + 1.
     4216           if ( ii modulo 10 = 0) then do:
     4217               run show-counter in p-log-handle .
     4218               run write-counter in p-log-handle (substitute("Обработано: &1 товаров на весах № &2"
     4219                                                               , ii
     4220                                                               , loc-scales.scales-num)).
     4221           end.
     4222           PUT stream PrnLibStream unformatted
     4223              main-record-string  ( buffer buf_goods
     4224                           ,input 'удаление':U
     4225                           ,input loc-scales.db-num
     4226                           ,input loc-scales.scales-type
     4227                           ,input buf_scales-gds.scales-num
     4228                           ,input buf_scales-gds.plu-code
     4229                           ,input buf_scales-gds.plu-type
     4230                           ,input buf_prod-bc.b-str
     4231                           ,input 0.0
     4232                           ,input 0
     4233                           ,input ?
     4234                           ,input 0
     4235                           ,input 0.0
     4236                           ,input '':U
     4237                           ,input p-dec-delim
     4238                           )
     4239           (if loc-scales.scales-type = "CAS_lp-16x"                        or loc-scales.scales-type = "DIGI-SM"                          or loc-scales.scales-type = "CAS_CL5000j"                          or loc-scales.scales-type = "CAS_CL5000"                  then get-struct( input 0                                  , input 0                                   , input '':U                               , input loc-scales.scales-type                               , input loc-scales.db-num                               , input loc-scales.scales-num                               )                   else '':U)
     4240           skip .
     4241           delete buf_scales-gds no-error .
     4242           if error-status:error then do:
     4243             return error substitute("&1&2&3", error-status:get-message(1) , return-value ).
     4244           end.
     4245           FIND FIRST b-scales WHERE
     4246                       recid( b-scales ) = recid( loc-scales ) .
     4247           assign
     4248           b-scales.to-send = TRUE
     4249           b-scales.tot-gds  = b-scales.tot-gds - 1
     4250           .
     4251         end.
     4252       end.
     4253       otherwise do :
     4254     FOR EACH buf_scales-gds WHERE
     4255              buf_scales-gds.scales-num = loc-scales.scales-num AND
     4256              buf_scales-gds.db-num = loc-scales.db-num AND
     4257              buf_scales-gds.to-del = yes:
     4258                    FIND FIRST buf_bar-code WHERE
     4259                         buf_bar-code.b-code = buf_scales-gds.b-code NO-LOCK .
     4260               FIND FIRST buf_goods WHERE
     4261                         buf_goods.gds-code = buf_bar-code.gds-code NO-LOCK.
     4262               FIND FIRST buf_gds-obj-attr WHERE
     4263                           buf_gds-obj-attr.gds-code = buf_bar-code.gds-code AND
     4264                           buf_gds-obj-attr.attr-code = 'scales-code':U AND
     4265                           buf_gds-obj-attr.obj-type = buf_scales-gds.obj-type AND
     4266                           buf_gds-obj-attr.obj-code = buf_scales-gds.obj-code
     4267                           No-LOCK.
     4268               FIND FIRST buf_prod-bc WHERE
     4269                           buf_prod-bc.b-str = buf_gds-obj-attr.attr-value NO-LOCK.
     4270       ii = ii + 1.
     4271       if ( ii modulo 10 = 0) then do:
     4272           run show-counter in p-log-handle .
     4273           run write-counter in p-log-handle (substitute("Обработано: &1 товаров на весах № &2"
     4274                                                           , ii
     4275                                                           , loc-scales.scales-num)).
     4276       end.
     4277       PUT stream PrnLibStream unformatted
     4278       main-record-string  ( buffer buf_goods
     4279                           ,input 'удаление':U
     4280                           ,input loc-scales.db-num
     4281                           ,input loc-scales.scales-type
     4282                           ,input buf_scales-gds.scales-num
     4283                           ,input buf_scales-gds.plu-code
     4284                           ,input buf_scales-gds.plu-type
     4285                           ,input buf_prod-bc.b-str
     4286                           ,input 0.0
     4287                           ,input 0
     4288                           ,input ?
     4289                           ,input 0
     4290                           ,input 0.0
     4291                           ,input '':U
     4292                           ,input p-dec-delim
     4293                           )
     4294       (if loc-scales.scales-type = "CAS_lp-16x"                        or loc-scales.scales-type = "DIGI-SM"                          or loc-scales.scales-type = "CAS_CL5000j"                          or loc-scales.scales-type = "CAS_CL5000"                  then get-struct( input 0                                  , input 0                                   , input '':U                               , input loc-scales.scales-type                               , input loc-scales.db-num                               , input loc-scales.scales-num                               )                   else '':U)
     4295       skip .
     4296       delete buf_scales-gds no-error .
     4297       if error-status:error then do:
     4298         return error substitute("&1&2&3", error-status:get-message(1) , return-value ).
     4299       end.
     4300       FIND FIRST b-scales WHERE
     4301                   recid( b-scales ) = recid( loc-scales ) .
     4302       assign
     4303       b-scales.to-send = TRUE
     4304       b-scales.tot-gds  = b-scales.tot-gds - 1
     4305       .
     4306     end.
     4307       end.
     4308     end case.
     4309    END.
     4310   END.
     4311   PROCEDURE b-msend-proc:
     4312   DEFINE PARAMETER BUFFER p-scales for ub.scales.
     4313   DEFINE INPUT PARAMETER p-scale-prog as char no-undo.
     4314   define input parameter p-file-name as character no-undo .
     4315   define input parameter p-mode as character no-undo .
     4316   DEFINE INPUT PARAMETER p-message as char no-undo.
     4317   DEFINE OUTPUT PARAMETER p-res as integer no-undo.
     4318   define output parameter p-err-scl-num-list as character no-undo .
     4319   define output parameter p-err-codes-list as character no-undo .
     4320   define variable g#report-num as integer no-undo .
     4321   define variable v-cmd-line as character no-undo .
     4322   define variable r_e as character no-undo .
     4323   define variable com_ip as character no-undo .
     4324   define variable timeout_port as character no-undo .
     4325   define variable v-par as character no-undo.
     4326   run get-report-num  in parParentProc(output g#report-num).
     4327   DEFINE variable l-res as integer no-undo.
     4328   define variable chr-res as character no-undo .
     4329   DEFINE BUFFER slave_scales for ub.scales.
     4330   if p-scales.scales-type begins "BOLET"
     4331   then do:
     4332     run write-log-and-file in p-log-handle (
     4333           input 1
     4334         , input log-file-name
     4335         , input 1
     4336         , input substitute("&1 &2 (№ &3)"
     4337                           , p-message
     4338                           , p-scales.scales-name
     4339                           , p-scales.scales-num)
     4340                                              ).
     4341     run gbl/syn.p ( input p-scale-prog
     4342               ,input (string(p-scales.scales-num)  +
     4343                      out-dir + p-file-name
     4344                      )
     4345               ,input '':U
     4346               ,output l-res) no-error.
     4347     assign
     4348     p-res = p-res + ABS(l-res ) + (IF error-status:error then 1 else 0)
     4349     p-err-scl-num-list = p-err-scl-num-list + (if abs(l-res) <> 0 then string(p-scales.scales-num) else '':U) + chr(44)
     4350     p-err-codes-list   =  p-err-codes-list  + (if abs(l-res) <> 0 then string(l-res) else '':U) + chr(44)
     4351     .
     4352     FOR EACH slave_scales WHERE
     4353           slave_scales.master = p-scales.scales-num
     4354       AND slave_scales.db-num = p-scales.db-num
     4355           :
     4356       if slave_scales.sts =  integer('0':U)  then do:
     4357         run write-log-and-file in p-log-handle (
     4358                                                 input 1
     4359                                               , input log-file-name
     4360                                               , input 1
     4361                                               , input substitute("&1 - Подчиненные весы &2 (№ &3)"
     4362                                                                 , p-message
     4363                                                                 , slave_scales.scales-name
     4364                                                                 , slave_scales.scales-num)
     4365                                                                                   ).
     4366         run gbl/syn.p ( input p-scale-prog
     4367                   ,input (string(slave_scales.scales-num)  +
     4368                           out-dir + p-file-name)
     4369                   ,input '':U
     4370                   ,output l-res) no-error.
     4371         assign
     4372         p-res = p-res + ABS(l-res ) + (IF error-status:error then 1 else 0)
     4373         p-err-scl-num-list = p-err-scl-num-list + (if abs(l-res) <> 0 then string(slave_scales.scales-num) else '':U) + chr(44)
     4374         p-err-codes-list   =  p-err-codes-list  + (if abs(l-res) <> 0 then string(l-res) else '':U) + chr(44)
     4375         .
     4376       end.
     4377     END.
     4378   end.
     4379   else do:
     4380     run write-log-and-file in p-log-handle (
     4381                                             input 1
     4382                                           , input log-file-name
     4383                                           , input 1
     4384                                           , input  substitute("&1 &2 (№ &3)"
     4385                                                               ,p-message
     4386                                                               ,p-scales.scales-name
     4387                                                               ,p-scales.scales-num)
     4388                                                                               ).
     4389     CASE p-scales.scales-type:
     4390       when 'DIGI-SM' then do:
     4391       os-copy value(out-dir + p-file-name)
     4392               value(digi-out-dir + p-file-name).
     4393       assign
     4394       p-res = p-res + ABS(os-error) + (IF os-error > 0 then 1 else 0)
     4395       p-err-scl-num-list = p-err-scl-num-list + (if abs(os-error) <> 0 then string(p-scales.scales-num) else '':U) + chr(44)
     4396       p-err-codes-list   =  p-err-codes-list  + (if abs(os-error) <> 0 then string(os-error) else '':U) + chr(44)
     4397       .
     4398       FOR EACH slave_scales WHERE slave_scales.master = p-scales.scales-num:
     4399         run write-log-and-file in p-log-handle (
     4400                                                   input 1
     4401                                                 , input log-file-name
     4402                                                 , input 1
     4403                                                 , input  substitute("&1 Подчиненные весы &2 (№ &3)"
     4404                                                                     ,p-message
     4405                                                                     ,slave_scales.scales-name
     4406                                                                     ,slave_scales.scales-num)
     4407                                                                                     ).
     4408         os-copy value(out-dir + p-file-name)
     4409                 value(digi-out-dir + replace(p-file-name
     4410                       ,entry(4, p-scales.address, '.')
     4411                       ,entry(4, slave_scales.address, '.'))) .
     4412         if os-error <> 0 then do:
     4413           assign
     4414           p-res = p-res + ABS(os-error) + (IF os-error > 0 then 1 else 0)
     4415           p-err-scl-num-list = p-err-scl-num-list + (if abs(os-error) <> 0 then string(slave_scales.scales-num) else '':U) + chr(44)
     4416           p-err-codes-list   =  p-err-codes-list  + (if abs(os-error) <> 0 then string(os-error) else '':U) + chr(44)
     4417           .
     4418         end.
     4419       END.
     4420     end.
     4421     when 'TIGER-SPCT2'
     4422     or
     4423     when 'TIGER-SPCT1'
     4424     then do:
     4425         os-copy value(out-dir + p-file-name)
     4426                 value((if p-scales.scales-type = "TIGER-SPCT2"
     4427                        then tiger-spct2-out-dir
     4428                        else tiger-spct1-out-dir)
     4429                        + p-file-name).
     4430         assign
     4431         p-res = p-res + ABS(os-error) + (IF os-error > 0 then 1 else 0)
     4432         p-err-scl-num-list = p-err-scl-num-list + (if abs(os-error) <> 0 then string(p-scales.scales-num) else '':U) + chr(44)
     4433         p-err-codes-list   =  p-err-codes-list  + (if abs(os-error) <> 0 then string(os-error) else '':U) + chr(44)
     4434         .
     4435         FOR EACH slave_scales WHERE
     4436                 slave_scales.db-num = p-scales.db-num
     4437              and slave_scales.master = p-scales.scales-num:
     4438           run write-log-and-file in p-log-handle (
     4439                                                     input 1
     4440                                                   , input log-file-name
     4441                                                   , input 1
     4442                                                   , input  substitute("&1 Подчиненные весы &2 (№ &3)"
     4443                                                                       ,p-message
     4444                                                                       ,slave_scales.scales-name
     4445                                                                       ,slave_scales.scales-num)
     4446                                                                                       ).
     4447           os-copy value(out-dir + p-file-name)
     4448                   value(digi-out-dir + replace(p-file-name
     4449                         ,string(p-scales.scales-num)
     4450                         ,string(slave_scales.scales-num))) .
     4451           if os-error <> 0 then do:
     4452             assign
     4453             p-res = p-res + ABS(os-error) + (IF os-error > 0 then 1 else 0)
     4454             p-err-scl-num-list = p-err-scl-num-list + (if abs(os-error) <> 0 then string(slave_scales.scales-num) else '':U) + chr(44)
     4455             p-err-codes-list   =  p-err-codes-list  + (if abs(os-error) <> 0 then string(os-error) else '':U) + chr(44)
     4456             .
     4457           end.
     4458         END.
     4459         define variable v-current-dir as character no-undo .
     4460         DEFINE VARIABLE SetCurrentDirectoryAResult AS INTEGER NO-UNDO.
     4461         file-info:file-name = ".".
     4462         v-current-dir = file-info:full-pathname.
     4463         define variable v-install-dir as character no-undo .
     4464         file-info:file-name = (if p-scales.scales-type = "TIGER-SPCT2"
     4465                                 then tiger-spct2-install-dir
     4466                                 else tiger-spct1-install-dir).
     4467         v-install-dir = file-info:full-pathname.
     4468         v-install-dir = (if index(v-install-dir, chr(32)) > 0
     4469                          then substitute('"&1"', v-install-dir)
     4470                          else v-install-dir)
     4471                          .
     4472         define variable v-file-name as character no-undo .
     4473         file-info:file-name =  substitute("&1&2"
     4474                                           ,  (if p-scales.scales-type = "TIGER-SPCT2"
     4475                                               then tiger-spct2-install-dir
     4476                                               else tiger-spct1-install-dir)
     4477                                           , (if p-scales.scales-type = "TIGER-SPCT2"
     4478                                             then (if p-mode = 'ИЗМЕНЕНИЕ':U
     4479                                                 then "tigeru-spct2.exe":U
     4480                                                 else "tigerd-spct2.exe")
     4481                                             else (if p-mode = 'ИЗМЕНЕНИЕ':U
     4482                                             then "tigeru-spct1.exe":U
     4483                                             else "tigerd-spct1.exe")
     4484                                             )
     4485                                           ).
     4486         v-file-name = file-info:full-pathname.
     4487         v-file-name = (if index(v-file-name, chr(32)) > 0
     4488                          then substitute('"&1"', v-file-name)
     4489                          else v-file-name)
     4490                          .
     4491         tiger:
     4492         do
     4493         on error  undo tiger, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     4494         on stop   undo tiger, return error substitute( "&1. stop", vss-workfile )
     4495         on endkey undo tiger, return error substitute( "&1. endkey", vss-workfile )
     4496         :
     4497          run gbl/synd.p ( input v-install-dir
     4498                         ,input v-file-name
     4499                         ,input substitute("ibs&1.ini", p-scales.scales-num)
     4500                         ,input '':U
     4501                         ,output l-res
     4502                                                                     ) no-error .
     4503         end.
     4504         if l-res > 0 then do:
     4505           run write-log-and-file in p-log-handle (
     4506                                                     input 1
     4507                                                   , input log-file-name
     4508                                                   , input 1
     4509                                                   , input  substitute("&1Ошибка при передаче на весы &2 (№ &3) и подчиненные&1&4&1&5"
     4510                                                                       ,chr(10)
     4511                                                                       ,p-scales.scales-name
     4512                                                                       ,p-scales.scales-num
     4513                                                                       ,error-status:get-message(1)
     4514                                                                       ,return-value)
     4515                                                                                       ).
     4516         end.
     4517         p-res = p-res + l-res.
     4518       end.
     4519       otherwise do:
     4520         case p-scales.scales-type:
     4521           when "SHTRIH-M" then do:
     4522             assign
     4523             r_e = (if p-scales.address begins "COM" then "R" else "E")
     4524             com_ip = replace(entry(1, p-scales.address, ":"), "COM", "")
     4525             timeout_port = entry(2, p-scales.address, ":")
     4526             .
     4527             v-cmd-line = substitute('&1 &2 &3 &4 "&5&6"'
     4528                                     ,p-scale-prog
     4529                                     ,r_e
     4530                                     ,com_ip
     4531                                     ,timeout_port
     4532                                     ,out-dir
     4533                                     ,p-file-name).
     4534               run gbl/syn6.p
     4535                 (input v-cmd-line
     4536                 ,input out-dir + "log.txt"
     4537                 ,input "Ждите! Идет передача на весы..."
     4538                 ,output chr-res
     4539                 ) no-error .
     4540               if error-status:error
     4541               or chr-res > '':u then do:
     4542                 l-res = 1.
     4543               end.
     4544           end.
     4545           when "CAS_LP-15v1.6" then do:
     4546               if replace(ENTRY(LOOKUP("CAS_LP-15v1.6", ini-types), ini-progs), "\", "/") = "exe/CAScentre.exe" then do:
     4547                   if p-mode = 'ИЗМЕНЕНИЕ':U then do:
     4548                       com_ip = entry(1, p-scales.address, ":").
     4549                       timeout_port = entry(2, p-scales.address, ":").
     4550                       v-cmd-line = com_ip + " " + timeout_port + " 1 0 " + out-dir + p-file-name.
     4551                   end.
     4552                   else do:
     4553                       v-cmd-line = substitute(" -d &1 < &2&3"
     4554                                     ,p-scales.address
     4555                                     ,out-dir
     4556                                     ,p-file-name).
     4557                       p-scale-prog = ENTRY(LOOKUP("CAS_LP-15v1.6", 'CAS_LP-15,CAS_LP-6,HELMAC_net,HELMAC_model-Z,HELMAC_model-T,CAS_LP-485,BOLET_P-280,BZB-SC515,DIGI_SM-80,CAS_LP-15v1.6,TIGER,MIRA,TIGER2,CAS_LP-16x,DIGI-SM,TIGER-SPCT2,SHTRIH-M,CAS_LP-II,CAS_CL5000J,CAS_CL5000,DIGI_AW-4600_FX,TIGER-SPCT1':U), 'exe/lp15s.exe,exe/lp15s.exe,exe/hcns.exe,exe/hczs.exe,exe/hcts.exe,exe/lp485s.exe,exe/scalex.exe,exe/bzbs.exe,exe/digis.exe,exe/lp16s.exe,exe/metos.exe,exe/miras.exe,exe/meto2s.exe,exe/lp16xs.exe,,,exe/shtrih.exe,exe/lp16s.exe,exe/cl5000js.exe,exe/cl5000s.exe,,':U).
     4558                       p-scale-prog = search(p-scale-prog).
     4559                   end.
     4560                   run gbl/syn.p ( input p-scale-prog
     4561                       ,input v-cmd-line
     4562                       ,input '':u
     4563                       ,output l-res) no-error.
     4564               end.
     4565               else do:
     4566                   v-cmd-line = substitute(" -d &1 < &2&3"
     4567                                     ,p-scales.address
     4568                                     ,out-dir
     4569                                     ,p-file-name).
     4570                   run gbl/syn.p ( input p-scale-prog
     4571                       ,input v-cmd-line
     4572                       ,input '':u
     4573                       ,output l-res) no-error.
     4574               end.
     4575           end.
     4576           when "DIGI_AW-4600_FX":U then do:
     4577             os-copy value(out-dir + p-file-name)
     4578                     value(out-dir + "plu0d001.csv").
     4579             v-cmd-line = substitute(' -T "&1&2" ftp://anonymous:anonymous@&3'
     4580                                     ,out-dir
     4581                                     ,"plu0d001.csv"
     4582                                     ,p-scales.address
     4583                                     ).
     4584             run gbl/syn.p ( input p-scale-prog
     4585                       ,input v-cmd-line
     4586                       ,input '':u
     4587                       ,output l-res) no-error.
     4588           end.
     4589           otherwise do:
     4590             case p-scales.scales-type:
     4591               when "CAS_CL5000J"
     4592               then do:
     4593                 if p-mode <> 'ИЗМЕНЕНИЕ':U then do:
     4594                   p-scale-prog = replace(p-scale-prog, "cl5000js", "cl5000jd").
     4595                 end.
     4596               end.
     4597               when "CAS_CL5000"
     4598               then do:
     4599                 if p-mode <> 'ИЗМЕНЕНИЕ':U then do:
     4600                   p-scale-prog = replace(p-scale-prog, "cl5000s", "cl5000d").
     4601                 end.
     4602               end.
     4603             end case.
     4604             v-cmd-line = substitute(" -d &1 < &2&3"
     4605                                     ,p-scales.address
     4606                                     ,out-dir
     4607                                     ,p-file-name).
     4608             run gbl/syn.p ( input p-scale-prog
     4609                           ,input v-cmd-line
     4610                             ,input '':u
     4611                             ,output l-res) no-error.
     4612           end.
     4613         end case.
     4614         assign
     4615         p-res = p-res + ABS(l-res ) + (IF error-status:error then 1 else 0)
     4616         p-err-scl-num-list = p-err-scl-num-list + (if abs(l-res) <> 0 then string(p-scales.scales-num) else '':U) + chr(44)
     4617         p-err-codes-list   =  p-err-codes-list  + (if abs(l-res) <> 0 then string(l-res) else '':U) + chr(44)
     4618         .
     4619         FOR EACH slave_scales WHERE
     4620                 slave_scales.master = p-scales.scales-num
     4621             AND slave_scales.db-num = p-scales.db-num
     4622             and slave_scales.sts <> integer('1':U):
     4623           run write-log-and-file in p-log-handle (
     4624                                                     input 1
     4625                                                   , input log-file-name
     4626                                                   , input 1
     4627                                                   , input  substitute("&1 Подчиненные весы &2 (№ &3)"
     4628                                                                       ,p-message
     4629                                                                       ,slave_scales.scales-name
     4630                                                                       ,slave_scales.scales-num)
     4631                                                                                       ).
     4632           case slave_scales.scales-type:
     4633             when "SHTRIH-M" then do:
     4634               assign
     4635               r_e = (if slave_scales.address begins "COM" then "R" else "E")
     4636               com_ip = replace(entry(1, slave_scales.address, ":"), "COM", "")
     4637               timeout_port = entry(2, slave_scales.address, ":")
     4638               .
     4639               v-cmd-line = substitute('&1 &2 &3 &4 "&5&6"'
     4640                                       ,p-scale-prog
     4641                                       ,r_e
     4642                                       ,com_ip
     4643                                       ,timeout_port
     4644                                       ,out-dir
     4645                                       ,p-file-name).
     4646               run gbl/syn6.p
     4647                 (input v-cmd-line
     4648                 ,input out-dir + "log.txt"
     4649                 ,input "Ждите! Идет передача на весы..."
     4650                 ,output chr-res
     4651                 ) no-error .
     4652               if error-status:error
     4653               or chr-res > '':u then do:
     4654                 l-res = 1.
     4655               end.
     4656             end.
     4657             when "DIGI_AW-4600_FX":U then do:
     4658               v-cmd-line = substitute(' -T "&1&2" ftp://anonymous:anonymous@&3'
     4659                                       ,out-dir
     4660                                       ,"plu0d001.csv"
     4661                                       ,slave_scales.address
     4662                                       ).
     4663               run gbl/syn.p ( input p-scale-prog
     4664                         ,input v-cmd-line
     4665                         ,input '':u
     4666                         ,output l-res) no-error.
     4667             end.
     4668           when "CAS_LP-15v1.6" then do:
     4669               if replace(ENTRY(LOOKUP("CAS_LP-15v1.6", ini-types), ini-progs), "\", "/") = "exe/CAScentre.exe" then do:
     4670                   if p-mode = 'ИЗМЕНЕНИЕ':U then do:
     4671                       com_ip = entry(1, slave_scales.address, ":").
     4672                       timeout_port = entry(2, slave_scales.address, ":").
     4673                       v-cmd-line = com_ip + " " + timeout_port + " 1 0 " + out-dir + p-file-name.
     4674                   end.
     4675                   else do:
     4676                       v-cmd-line = substitute(" -d &1 < &2&3"
     4677                                     ,slave_scales.address
     4678                                     ,out-dir
     4679                                     ,p-file-name).
     4680                       p-scale-prog = ENTRY(LOOKUP("CAS_LP-15v1.6", 'CAS_LP-15,CAS_LP-6,HELMAC_net,HELMAC_model-Z,HELMAC_model-T,CAS_LP-485,BOLET_P-280,BZB-SC515,DIGI_SM-80,CAS_LP-15v1.6,TIGER,MIRA,TIGER2,CAS_LP-16x,DIGI-SM,TIGER-SPCT2,SHTRIH-M,CAS_LP-II,CAS_CL5000J,CAS_CL5000,DIGI_AW-4600_FX,TIGER-SPCT1':U), 'exe/lp15s.exe,exe/lp15s.exe,exe/hcns.exe,exe/hczs.exe,exe/hcts.exe,exe/lp485s.exe,exe/scalex.exe,exe/bzbs.exe,exe/digis.exe,exe/lp16s.exe,exe/metos.exe,exe/miras.exe,exe/meto2s.exe,exe/lp16xs.exe,,,exe/shtrih.exe,exe/lp16s.exe,exe/cl5000js.exe,exe/cl5000s.exe,,':U).
     4681                       p-scale-prog = search(p-scale-prog).
     4682                   end.
     4683                   run gbl/syn.p ( input p-scale-prog
     4684                       ,input v-cmd-line
     4685                       ,input '':u
     4686                       ,output l-res) no-error.
     4687               end.
     4688               else do:
     4689                   v-cmd-line = substitute(" -d &1 < &2&3"
     4690                                     ,slave_scales.address
     4691                                     ,out-dir
     4692                                     ,p-file-name).
     4693                   run gbl/syn.p ( input p-scale-prog
     4694                       ,input v-cmd-line
     4695                       ,input '':u
     4696                       ,output l-res) no-error.
     4697               end.
     4698           end.
     4699             otherwise do:
     4700               v-cmd-line = substitute(" -d &1 < &2&3"
     4701                                       ,slave_scales.address
     4702                                       ,out-dir
     4703                                       ,p-file-name).
     4704               run gbl/syn.p ( input p-scale-prog
     4705                               ,input v-cmd-line
     4706                               ,input '':u
     4707                               ,output l-res) no-error.
     4708             end.
     4709           end case.
     4710           assign
     4711           p-res = p-res + ABS(l-res ) + (IF error-status:error then 1 else 0)
     4712           p-err-scl-num-list = p-err-scl-num-list + (if abs(l-res) <> 0 then string(slave_scales.scales-num) else '':U) + chr(44)
     4713           p-err-codes-list   =  p-err-codes-list  + (if abs(l-res) <> 0 then string(l-res) else '':U) + chr(44)
     4714           .
     4715         END.
     4716       end.
     4717     END CASE.
     4718     if p-scales.scales-type = "DIGI_AW-4600_FX" then do:
     4719       os-delete value(out-dir + "plu0d001.csv").
     4720     end.
     4721   end.
     4722   END PROCEDURE.
     4723   PROCEDURE create-name-str:
     4724   define parameter buffer loc-goods for ub.goods.
     4725   define output parameter loc-name-buf1 as character no-undo .
     4726   define variable ff as integer no-undo .
     4727   define variable v-name as character no-undo .
     4728   define variable v-log as logical no-undo .
     4729     loc-name-buf1 = "" .
     4730     v-name = if loc-goods.label-name = "":U
     4731              then  loc-goods.gds-name
     4732              else loc-goods.label-name
     4733              .
     4734     DO ff = 1 TO num-entries( v-name, '"' ) :
     4735         loc-name-buf1 = loc-name-buf1 + entry( ff, v-name, '"' ) .
     4736     END .
     4737   END PROCEDURE.
     4738   PROCEDURE create-name-str-2:
     4739   define parameter buffer loc-goods for ub.goods.
     4740   define input parameter p-length as integer no-undo .
     4741   define output parameter loc-name-buf1 as character no-undo .
     4742   define output parameter loc-name-buf2 as character no-undo .
     4743   DEFINE VARIABLE loc-name-buf as character no-undo .
     4744   define variable ff as integer no-undo .
     4745   define variable v-name as character no-undo .
     4746   define variable v-log as logical no-undo .
     4747     loc-name-buf = "" .
     4748     loc-name-buf1 = "" .
     4749     loc-name-buf2 = "" .
     4750     v-name = if loc-goods.label-name = "":U
     4751              then  loc-goods.gds-name
     4752              else loc-goods.label-name
     4753              .
     4754     if p-length <= 0 then do:
     4755       if length(v-name) >= 50 then p-length = length(v-name) / 2.
     4756       else p-length = 30.
     4757     end.
     4758     DO ff = 1 TO num-entries( v-name, '"' ) :
     4759         loc-name-buf = loc-name-buf + entry( ff, v-name, '"' ) .
     4760     END .
     4761     DO ff = 1 TO num-entries( loc-name-buf, ' ' ) :
     4762         if length(loc-name-buf1) + length (entry( ff, loc-name-buf, ' ' ) ) <= p-length
     4763         and not v-log
     4764         then do:
     4765           loc-name-buf1 = loc-name-buf1 + " " + entry( ff, loc-name-buf, ' ' ) .
     4766         end.
     4767         else  do:
     4768          if ff = 1 then do:
     4769             assign
     4770             loc-name-buf1 = chr(32) + substring(loc-name-buf, 1, p-length)
     4771             v-log = yes
     4772             .
     4773           end.
     4774           else do:
     4775             assign
     4776             loc-name-buf2 = loc-name-buf2 + " " + entry( ff, loc-name-buf, ' ' )
     4777             v-log = yes
     4778             .
     4779           end.
     4780         end.
     4781     END .
     4782     if loc-name-buf1  = ""
     4783     then do:
     4784       if loc-name-buf2 = ""
     4785       then
     4786       loc-name-buf1 = chr(32) + substring(replace(loc-goods.gds-name, '"', '':U), 1, p-length) .
     4787       else do:
     4788         assign
     4789         loc-name-buf1 = loc-name-buf2
     4790         loc-name-buf2 = '':U.
     4791       end.
     4792     end.
     4793   END PROCEDURE.
     4794   procedure create-obj-record :
     4795   define parameter buffer buf_goods for ub.goods.
     4796   define input parameter p-obj-type like ub.scales-gds.obj-type no-undo .
     4797   define input parameter p-obj-code like ub.scales-gds.obj-code no-undo .
     4798   define buffer buf_gdsolist for gdsolist.
     4799     do
     4800     on error undo, return error
     4801     :
     4802       find first buf_gdsolist where
     4803                 buf_gdsolist.gds-code = buf_goods.gds-code
     4804             AND buf_gdsolist.obj-type = p-obj-type
     4805             and buf_gdsolist.obj-code = p-obj-code  no-error .
     4806       if not avail buf_gdsolist then do:
     4807         create buf_gdsolist.
     4808         buffer-copy buf_goods to buf_gdsolist
     4809         assign
     4810         buf_gdsolist.to-del = no
     4811         buf_gdsolist.obj-type = p-obj-type
     4812         buf_gdsolist.obj-code = p-obj-CODE
     4813         .
     4814       end.
     4815     end.
     4816   end procedure.
     4817   procedure check-write-scales-status :
     4818   define input parameter p-scales-num like ub.scales.scales-num no-undo .
     4819   define input parameter p-db-num     like ub.scales.db-num no-undo .
     4820   define input parameter p-recid-scales as recid no-undo .
     4821   define buffer buf_scales-gds for ub.scales-gds.
     4822   define buffer buf_scales for ub.scales.
     4823   do
     4824   on error undo, return error
     4825   :
     4826     if NOT can-find( FIRST buf_scales-gds WHERE
     4827                             buf_scales-gds.scales-num = p-scales-num AND
     4828                             buf_scales-gds.db-num = p-db-num AND
     4829                             buf_scales-gds.to-send = TRUE ) AND
     4830         NOT can-find( FIRST buf_scales-gds WHERE
     4831                             buf_scales-gds.scales-num = p-scales-num AND
     4832                             buf_scales-gds.db-num = p-db-num AND
     4833                             buf_scales-gds.to-del = TRUE ) then do:
     4834       FIND FIRST buf_scales WHERE
     4835                   recid( buf_scales ) = p-recid-scales.
     4836       assign
     4837       buf_scales.to-send = FALSE
     4838       .
     4839     end.
     4840   end.
     4841   end procedure.
     4842   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4843   define variable vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4844   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
