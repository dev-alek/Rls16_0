     5160   CASE sendoption:
     5161     when "changed":u then do:
     5162       FOR EACH buf_scales WHERE
     5163               buf_scales.db-num = v-cntxt-db-num
     5164         AND buf_scales.to-send = yes
     5165         AND buf_scales.master = 0
     5166         by buf_scales.scales-num
     5167      on error undo, next
     5168      on stop undo, next :
     5169         if rec-t-scales <> ? and rec-t-scales <> recid(buf_scales) then NEXT.
     5170         if buf_scales.sts = integer('1':U) then do:
     5171           if buf_scales.master = 0 then do:
     5172             run write-log-and-file in p-log-handle (
     5173                   input 1
     5174                 , input log-file-name
     5175                 , input 1
     5176                 , input substitute( "!!!Попытка пересылки товаров на весы №&1 &2,&4имеющие статус &3"
     5177                                   , buf_scales.scales-num
     5178                                   , buf_scales.scales-name
     5179                                   , entry (lookup (STRING(buf_scales.sts), '0,1,50,99':U), 'тек,удал,блок,удаление':U)
     5180                                   , chr(10)
     5181                                   )).
     5182             assign
     5183             v-view-log = yes
     5184             .
     5185           end.
     5186           next.
     5187         end.
     5188         if rec-t-scales = ? then do:
     5189           run set-title in p-log-handle (
     5190                 input substitute("Передача данных по измененным товарам (&1&2) на весы &3"
     5191                                 , p-obj-type
     5192                                 , p-obj-code
     5193                                 , buf_scales.scales-name)).
     5194         end.
