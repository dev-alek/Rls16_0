     4968                              , chr(10)
     4969                             )
     4970                                             ).
     4971     assign
     4972     v-view-log = yes.
     4973     return error .
     4974   end.
     4975   IF NUm-ENTRIES(ini-types) > NUm-ENTRIES(ini-progs) then do:
     4976     run write-log-and-file in p-log-handle (
     4977             input 1
     4978           , input log-file-name
     4979           , input 1
     4980           , input substitute( "!!!Ошибка! Не определены программы для работы с весами для некоторых типов весов&1" +
     4981                              "АРМ Администратор, Список фирм (Справочник магазинов), Измен. параметры, Параметры работы с весами"
     4982                              , chr(10)
     4983                             )
     4984                                             ).
     4985     assign
     4986     v-view-log = yes.
     4987     return error .
     4988   end.
