     1260   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1261   define  stream PrnLibStream.
     1262   procedure prn-lib-prn-file :
     1263     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1264     define input parameter p-DIsabledoptions as integer no-undo .
     1265     define variable v-report-name as character no-undo .
     1266     define variable v-user-action as character no-undo .
     1267     define variable v-printed     as logical   no-undo .
     1268     define variable v-exist       as logical   no-undo .
     1269     do
     1270       on error undo, return error
     1271       :
     1272       run prn-lib-get-report-name  in this-procedure (
     1273         input parParentProc
     1274         ,output v-report-name
     1275         ).
     1276   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1277   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
     1278     (input  v-report-name
     1279     ,input  2
     1280     ,output v-exist
     1281     )  .
     1282       if NOT v-exist then
     1283       DO:
     1284         Message
     1285           "Нет заданий на печать ! "
     1286           view-as alert-box .
     1287         Return  .
     1288       End.
     1289       run gbl/prnfilen.w
     1290         (input  ""
     1291         ,input  p-DisabledOptions
     1292         ,input  string(v-report-name )
     1293         ,input  7
     1294         ,output v-user-action
     1295         ,output v-printed
     1296         ) .
     1297       if v-printed then
     1298       do:
     1299         return "YES" .
     1300       end.
     1301       else
     1302       do:
     1303         return "NO" .
     1304       end.
     1305     end.
     1306   end procedure.
     1307   procedure prn-lib-open-stream :
     1308     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1309     define input parameter p-page-size    as integer no-undo .
     1310     define input parameter p-is-stream    as logical no-undo .
     1311     define input parameter p-append       as logical no-undo .
     1312     define variable v-report-name as character no-undo .
     1313     do
     1314       on error undo, return error
     1315       :
     1316       run prn-lib-get-report-name  in this-procedure (
     1317         input parParentProc
     1318         ,output v-report-name
     1319         ).
     1320       if p-is-stream then
     1321       do:
     1322         if p-append then
     1323         do:
     1324           output stream PrnLibStream to value( v-report-name )
     1325             page-size value(p-page-size) append .
     1326         end.
     1327         if not p-append then
     1328         do:
     1329           output stream PrnLibStream to value( v-report-name )
     1330             page-size value(p-page-size) .
     1331         end.
     1332       end.
     1333       if not p-is-stream then
     1334       do:
     1335         if p-append then
     1336         do:
     1337           output to value( v-report-name )
     1338             page-size value(p-page-size) append .
     1339         end.
     1340         if not p-append then
     1341         do:
     1342           output to value( v-report-name )
     1343             page-size value(p-page-size) .
     1344         end.
     1345       end.
     1346     end.
     1347   end procedure.
     1348   procedure prn-lib-open-exp :
     1349     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1350     define input parameter p-is-stream    as logical no-undo .
     1351     define input parameter p-is-append    as logical no-undo .
     1352     define output parameter p-ReportFileName as char init "report" no-undo.
     1353     define output parameter p-process as logical no-undo .
     1354     define variable glog as logical no-undo .
     1355     do
     1356       on error undo, return error
     1357       :
     1358       SYSTEM-DIALOG GET-FILE p-ReportFileName
     1359         TITLE      "Укажите путь"
     1360         FILTERS "Текстовый файл (*.txt)"   "*.txt"
     1361         ASK-OVERWRITE
     1362         CREATE-TEST-FILE
     1363         SAVE-AS
     1364         USE-FILENAME
     1365         DEFAULT-EXTENSION "txt"
     1366         UPDATE glog
     1367         .
     1368       if not glog then  return.
     1369       p-ReportFileName = trim( string( p-ReportFileName ) ) .
     1370       if p-is-stream then
     1371       do:
     1372         if p-is-append then
     1373         do:
     1374           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1375         end.
     1376         else
     1377         do:
     1378           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1379         end.
     1380       end.
     1381       else
     1382       do:
     1383         if p-is-append then
     1384         do:
     1385           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1386         end.
     1387         else
     1388         do:
     1389           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1390         end.
     1391       end.
     1392       p-process = yes.
     1393     end.
     1394   end procedure.
     1395   procedure prn-lib-get-report-name :
     1396     define input parameter parParentProc  as widget-handle no-undo.
     1397     define output parameter p-report-name as character no-undo .
     1398     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
     1399   end procedure.
     1400   procedure prn-lib-reportviewer-report-name :
     1401     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1402     define input parameter p-report-name-html as character no-undo .
     1403     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
     1404   end procedure.
     1405   procedure prn-lib-reportviewer :
     1406     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1407     define input parameter p-report-name-html as character no-undo .
     1408     define input parameter p-param        as character no-undo .
     1409     define variable v-excel           as character no-undo init 'TRUE' .
     1410     define variable v-value-character as character no-undo .
     1411     define variable v-value-integer   as character no-undo .
     1412     define variable v-value-date      as date      no-undo .
     1413     define variable v-value-decimal   as decimal   no-undo .
     1414     define variable rep-excel         as logical   no-undo .
     1415     define variable excel-string      as character no-undo .
     1416     define variable v-param-type      as character no-undo .
     1417     define variable v-tth             as handle    no-undo .
     1418     run adm/shattri.p (
     1419       input "get":U
     1420       ,input  ""
     1421       ,input  0
     1422       ,input  'report-glob':U
     1423       ,input  'rep-excel':U
     1424       ,output v-value-character
     1425       ,output v-value-date
     1426       ,output v-value-decimal
     1427       ,output v-value-integer
     1428       ,output rep-excel
     1429       ,output v-param-type
     1430       ,INPUT-OUTPUT table-handle v-tth
     1431       )  .
     1432     if rep-excel then v-excel = "TRUE" .
     1433     else v-excel = "FALSE" .
     1434     if p-param eq ""
     1435     then
     1436        p-param = "EXCEL:" + v-excel.
     1437     else
     1438        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
     1439     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
     1440   end procedure.
     1441   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1442   PROCEDURE verify-ini-entry:
     1443   DEFINE INPUT  PARAMETER ini-key-name     as character no-undo.
     1444   DEFINE INPUT  PARAMETER ini-section-name as character no-undo.
     1445   DEFINE INPUT  PARAMETER error-msg-text   as character no-undo.
     1446   DEFINE INPUT  PARAMETER silence          as logical no-undo.
     1447   DEFINE OUTPUT PARAMETER ini-entry-value  as character no-undo INIt ?.
     1448   define variable v-mess as character no-undo .
     1449   get-key-value section ini-section-name key ini-key-name value ini-entry-value.
     1450   if ini-entry-value = ? and ini-key-name begins "spl"
     1451   then
     1452   get-key-value section ini-section-name key "splall" value ini-entry-value.
     1453   if ini-entry-value = ? and ini-key-name begins "sav"
     1454   then
     1455   get-key-value section ini-section-name key "savall" value ini-entry-value.
     1456   if ini-entry-value = ? then do:
     1457     assign
     1458     v-mess = substitute("Ошибка ini - файла:&1Секция &2&1Ключ &3&1&4"
     1459                       , chr(10)
     1460                       , ini-section-name
     1461                       , ini-key-name
     1462                       , error-msg-text).
     1463       if not silence then do:
     1464         message
     1465         v-mess
     1466         view-as alert-box ERROR  .
     1467         return error.
     1468       end.
     1469       else do:
     1470         return error v-mess.
     1471       end.
     1472   end.
     1473   END PROCEDURE.
     1474   PROCEDURE verify-file:
     1475   DEFINE INPUT  PARAMETER filename       as character no-undo.
     1476   DEFINE INPUT  PARAMETER error-msg-text as character no-undo.
     1477   DEFINE INPUT  PARAMETER silence        as logical no-undo.
     1478   DEFINE OUTPUT PARAMETER found          as logical no-undo.
     1479   file-info:file-name = filename.
     1480   found = NOT (file-info:full-pathname = ?).
     1481   if NOT found  then do:
     1482     if not silence then do:
     1483       message error-msg-text
     1484       view-as alert-box ERROR.
     1485       return error.
     1486     end.
     1487     else return error error-msg-text.
     1488   end.
     1489   END PROCEDURE.
